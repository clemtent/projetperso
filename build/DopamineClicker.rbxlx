		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, -3),
		MaxTextSize = 22,
		ZIndex = 5,
		Parent = label,
	})
	local spindle = UIUtil.Create("Frame", {

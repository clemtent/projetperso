		BackgroundColor3 = WHITE,
		ZIndex = 4,
		Parent = vinyl,
	})
	UIUtil.Corner(label, UDim.new(1, 0))
	local labelGradient = UIUtil.Gradient(label, ColorSequence.new(PLAYER_ACCENT, Theme.Colors.Purple), 45)
	local icon = UIUtil.Label({
		Name = "Icon",

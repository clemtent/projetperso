	Roof: Color3,
	RoofDark: Color3,
	Trim: Color3,
	Left: number,
	Right: number,
	Top: number, -- haut des murs (plafond du dernier étage)
	Depth: number,
	Hall0: number,
	Hall1: number,
	DoorX: number,
	Built: Built,
	Garage: boolean, -- (v9.6) 🏎️ aile du garage (manoir)
	SideGarage: boolean, -- (v10) garage / abri attenant (autres styles)
}


	[10] = { Body = rgb(228, 40, 54), Accent = rgb(255, 208, 60), Stripe = rgb(255, 208, 60), Laces = rgb(255, 208, 60), Sole = rgb(58, 56, 74), Glow = rgb(255, 150, 40), Flame = 2, Trail = "Fire" },

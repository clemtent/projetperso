	local wrong = box({ Name = "WrongWay", Parent = root, Color = RED, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 166), Size = UDim2.fromOffset(330, 50),
		Radius = UDim.new(0, 14), Stroke = WHITE, Visible = false, ZIndex = 10 })

	local function nearestLane(x: number): number
		local best, bestDistance = 2, math.huge
		for index, laneX in ipairs(LANES) do
			local d = math.abs(x - laneX)
			if d < bestDistance then
				best, bestDistance = index, d
			end
		end
		return best
	end

	-- Vrai si la carte est affichée (le cadre et tous ses parents visibles).
	-- Le StimulusManager met déjà OnRender en pause quand le slot est caché
	-- (ctx.IsVisible / OnVisibilityChanged) : ceci n'est qu'un filet de sécurité.
	local function computeVisible(): boolean
		if type(ctx.IsVisible) == "function" then
			local ok, visible = pcall(ctx.IsVisible)
			if ok and visible == false then
				return false
			end
		end
		local node: Instance? = container
		while node do
			if node:IsA("GuiObject") and not (node :: GuiObject).Visible then
				return false
			end
			if node:IsA("ScreenGui") then
				return (node :: ScreenGui).Enabled
			end
			node = node.Parent
		end
		return false
	end

	if type(ctx.OnVisibilityChanged) == "function" then
		ctx.OnVisibilityChanged(function(visibility: string)
			st.Visible = visibility ~= "Hidden"
			st.VisibleCheck = 0.5
		end)
	end

	------------------------------------------------------------------
	-- Jour / nuit : couleurs recalculées 5 fois par seconde au plus
	------------------------------------------------------------------
	local function placeArc(t: number, disc1: Frame, disc2: Frame?, disc3: Frame?)
		local elevation = math.sin(math.pi * math.clamp(t, 0, 1))
		local x = SW * (0.1 + 0.8 * t)
		local y = HY + 8 * U - elevation * HY * 0.78
		local position = UDim2.fromOffset(x, y)
		disc1.Position = position
		if disc2 then
			disc2.Position = position
		end
		if disc3 then
			disc3.Position = position
		end
		return elevation
	end

	local function updateLighting(force: boolean?)
		local p = (st.DayTime / DAY_LENGTH) % 1
		local key = sampleSky(p)
		st.Night = key.Night

		-- Soleil : se lève à l'aube, se couche derrière la ville
		local sunT = ((p + 0.03) % 1) / 0.61
		local sunUp = sunT <= 1
		for _, f in ipairs({ sky.Sun, sky.SunGlowOuter }) do
			f.Visible = sunUp
		end
		if sunUp then
			local elevation = placeArc(sunT, sky.Sun, sky.SunGlowOuter)
			local warm = 1 - math.clamp(elevation * 1.6, 0, 1)
			sky.Sun.BackgroundColor3 = WHITE:Lerp(rgb(255, 196, 150), warm)
			sky.SunGlowOuter.BackgroundColor3 = rgb(255, 246, 200):Lerp(rgb(255, 140, 110), warm)
		end
		-- Lune la nuit
		local moonT = (p - 0.6) / 0.38
		local moonUp = moonT >= 0 and moonT <= 1
		sky.Moon.Visible = moonUp
		sky.MoonGlow.Visible = moonUp
		if moonUp then
			placeArc(moonT, sky.Moon, sky.MoonGlow)
		end
		-- Étoiles qui scintillent
		for _, star in ipairs(stars) do
			local twinkle = 0.55 + 0.45 * math.sin(st.Clock * 2.2 + star.Phase)
			star.Frame.BackgroundTransparency = 1 - key.Night * twinkle * 0.95
		end

		-- Le reste ne change que pendant les transitions
		local signature
		if p >= 0.07 and p <= 0.45 then
			signature = -1
		elseif p >= 0.62 and p <= 0.92 then
			signature = -2
		else
			signature = math.floor(p * 300)
		end
		if signature == st.LightSig and not force then
			return
		end
		st.LightSig = signature

		ambient = key.Amb
		for _, inst in ipairs(tintList) do
			local base = tintBase[inst]
			if base then
				inst.BackgroundColor3 = mulColor(base, ambient)
			end
		end
		skyGradient.Color = skySequence(key.Top, key.Mid, key.Low)
		fog.BackgroundColor3 = key.Fog
		city.Haze.BackgroundColor3 = key.Fog
		for _, cloud in ipairs(clouds) do
			for _, puff in ipairs(cloud.Puffs) do
				puff.BackgroundColor3 = key.Cloud
				puff.BackgroundTransparency = 0.04 + key.Night * 0.4
			end
		end
		for _, entry in ipairs(city.Far) do
			local color = key.Far:Lerp(WHITE, math.max(0, entry.Shade - 1) * 2):Lerp(BLACK, math.max(0, 1 - entry.Shade))
			entry.Frame.BackgroundColor3 = color
			if entry.Antenna then
				entry.Antenna.BackgroundColor3 = color
			end
		end
		local night = key.Night
		-- Monuments lointains : silhouettes le jour, lumières la nuit
		local landmark = key.Far:Lerp(BLACK, 0.06)
		for _, f in ipairs(city.Landmarks) do
			f.BackgroundColor3 = landmark
		end
		local wheel = city.Wheel
		wheel.RingStroke.Color = landmark:Lerp(rgb(255, 120, 210), smooth(night))
		for index, gondola in ipairs(wheel.Gondolas) do
			local lit = (index % 2 == 0) and rgb(255, 230, 120) or rgb(120, 230, 255)
			gondola.Frame.BackgroundColor3 = landmark:Lerp(lit, smooth(night))
		end
		for _, bird in ipairs(birds) do
			bird.Holder.Visible = night < 0.5
			for _, wing in ipairs(bird.Wings) do
				wing.Frame.BackgroundColor3 = rgb(70, 72, 96):Lerp(key.Far, 0.3)
			end
		end
		-- Pont : bande lumineuse la nuit ; trains : vitres allumées la nuit
		if night > 0.3 then
			glowColor(bridge.Stripe, rgb(255, 150, 90):Lerp(rgb(255, 200, 120), night))
		else
			tint(bridge.Stripe, rgb(255, 120, 60))
		end
		local trainGlass = rgb(52, 72, 116):Lerp(rgb(255, 222, 150), smooth(math.clamp((night - 0.3) / 0.5, 0, 1)))
		for _, train in ipairs(trains) do
			if night > 0.3 then
				quadGlow(train.Windows, trainGlass)
			else
				quadColor(train.Windows, trainGlass)
			end
		end
		local useNightMask = night > 0.5
		local maskChanged = useNightMask ~= st.NightMask
		st.NightMask = useNightMask
		local glass = mulColor(GLASS_DAY, ambient):Lerp(key.Fog, 0.2):Lerp(WINDOW_NIGHT, smooth(night))
		for _, building in ipairs(city.Mid) do
			local face = mulColor(building.Base, ambient):Lerp(key.Fog, 0.28)
			building.Body.BackgroundColor3 = face
			for _, extra in ipairs(building.Extras) do
				extra.BackgroundColor3 = face:Lerp(BLACK, 0.12)
			end
			for _, block in ipairs(building.Blocks) do
				block.Floors.BackgroundColor3 = face
				block.Windows.BackgroundColor3 = glass
				if maskChanged or force then
					block.Gradient.Color = useNightMask and block.NightMask or block.DayMask
				end
			end
		end
		-- Lampadaires et phares : plus forts la nuit
		for _, pole in ipairs(poles) do
			pole.Glow.BackgroundColor3 = rgb(206, 210, 222):Lerp(LAMP_LIGHT, night)
			pole.Pool.BackgroundTransparency = 1 - night * 0.22
		end
		for _, train in ipairs(trains) do
			if train.Extra <= 0 then
				train.Beam.BackgroundTransparency = 1 - night * 0.45
			end
		end
	end

	------------------------------------------------------------------
	-- Apparition des objets
	------------------------------------------------------------------
	local function firstFree(pool)
		for _, object in ipairs(pool) do
			if not object.Active then
				return object
			end
		end
		return nil
	end

	local function hideTrain(train)
		train.Active = false
		train.Body.Visible = false
		hideQuad(train.Side)
		hideQuad(train.Roof)
		hideQuad(train.Windows)
	end

	local function spawnTrain(lane: number, z: number, oncoming: boolean): boolean
		local train = firstFree(trains)
		if not train then
			return false
		end
		local livery = TRAIN_LIVERIES[random:NextInteger(1, #TRAIN_LIVERIES)]
		train.Active = true
		train.Lane = lane
		train.Z = z
		train.Extra = oncoming and ONCOMING_EXTRA or 0
		train.Passed = false
		tint(train.Body, livery.Body)
		tint(train.Cap, livery.Body:Lerp(BLACK, 0.3))
		tint(train.Pillar, livery.Body:Lerp(BLACK, 0.45))
		tint(train.Stripe, livery.Accent)
		quadColor(train.Side, livery.Body:Lerp(BLACK, 0.22))
		quadColor(train.Roof, livery.Body:Lerp(WHITE, 0.45):Lerp(rgb(150, 150, 170), 0.25))
		local lightColor = oncoming and rgb(255, 252, 214) or rgb(255, 222, 150)
		train.HeadL.BackgroundColor3 = lightColor
		train.HeadR.BackgroundColor3 = lightColor
		train.HeadL.BackgroundTransparency = oncoming and 0 or 0.3
		train.HeadR.BackgroundTransparency = oncoming and 0 or 0.3
		train.Beam.BackgroundTransparency = oncoming and 0.6 or (1 - st.Night * 0.45)
		train.Body.Visible = true
		return true
	end

	local function spawnObstacle(lane: number, z: number, kind: string): boolean
		local wanted = kind == "Cone" and "Cone" or "Board"
		local ob: any = nil
		for _, candidate in ipairs(obstacles) do
			if not candidate.Active and candidate.Type == wanted then
				ob = candidate
				break
			end
		end
		if not ob then
			-- plus de cônes libres : une barrière basse à la place
			return kind == "Cone" and spawnObstacle(lane, z, "Low") or false
		end
		ob.Active = true
		ob.Lane = lane
		ob.Z = z
		ob.Kind = kind
		ob.Handled = false
		ob.Fatal = false
		ob.Passed = false
		ob.Knock = 0
		ob.Phase = random:NextNumber(0, 6)
		if kind == "Cone" then
			ob.Bottom, ob.Top = 0, 30
			ob.Cones.Visible = true
			ob.Cones.Rotation = 0
		else
			if kind == "Low" then
				ob.Bottom, ob.Top = 20, 38
				ob.Gradient.Color = stripes(rgb(236, 40, 52), WHITE, 7)
			else
				ob.Bottom, ob.Top = 58, 78
				ob.Gradient.Color = stripes(rgb(255, 200, 20), rgb(34, 34, 44), 7)
			end
			local legScale = ob.Bottom / (ob.Top - ob.Bottom)
			for _, leg in ipairs(ob.Legs) do
				leg.Size = UDim2.fromScale(0.065, legScale)
			end
			ob.Shadow.Position = UDim2.fromScale(0.5, 1 + legScale)
			ob.Shadow.Size = UDim2.fromScale(1.02, 0.22 * (18 / (ob.Top - ob.Bottom)))
			ob.Light.Visible = kind == "High"
			ob.Board.Rotation = 0
			ob.Board.Visible = true
		end
		return true
	end

	local function spawnCoin(lane: number, z: number, height: number, air: boolean)
		local coin = firstFree(coinsPool)
		if not coin then
			return
		end
		coin.Active = true
		coin.Lane = lane
		coin.X = LANES[lane]
		coin.H = height
		coin.Z = z
		coin.Phase = z * 2.2
		coin.Air = air
		coin.Pulled = false
		coin.Frame.Visible = true
	end

	local function laneIsEmpty(lane: number): boolean
		for _, pool in ipairs({ trains, obstacles, coinsPool }) do
			for _, object in ipairs(pool) do
				if object.Active and object.Lane == lane then
					return false
				end
			end
		end
		return not (pickup.Active and pickup.Lane == lane)
	end

	local function anyTrain(): boolean
		for _, train in ipairs(trains) do
			if train.Active then
				return true
			end
		end
		return false
	end

	-- Une vague : une voie toujours libre, le reste trains / barrières / cônes / rien
	local function spawnWave(z: number)
		local trainsAllowed = st.JetTime <= 0 or st.JetTime > 3.5
		local free = random:NextInteger(1, 3)
		local kinds = { "None", "None", "None" }

		-- Parfois un train qui fonce vers nous (seul train à l'écran, voie vide)
		local oncoming: number? = nil
		if trainsAllowed and not anyTrain() and random:NextNumber() < 0.3 then
			local candidate = random:NextInteger(1, 3)
			if laneIsEmpty(candidate) then
				oncoming = candidate
				kinds[candidate] = "Oncoming"
				if free == candidate then
					free = candidate % 3 + 1
				end
			end
		end

		for lane = 1, 3 do
			if lane ~= free and kinds[lane] == "None" then
				local roll = random:NextNumber()
				if trainsAllowed and not oncoming and roll < 0.4 then
					kinds[lane] = "Train"
				elseif roll < 0.82 then
					local pick = random:NextNumber()
					kinds[lane] = (pick < 0.42) and "Low" or (pick < 0.7 and "Cone" or "High")
				end
			end
		end
		-- Jamais deux trains côte à côte : le coureur serait coincé
		if kinds[2] == "Train" and (kinds[1] == "Train" or kinds[3] == "Train") then
			kinds[2] = "Low"
		end

		for lane = 1, 3 do
			local kind = kinds[lane]
			if kind == "Train" or kind == "Oncoming" then
				if not spawnTrain(lane, z, kind == "Oncoming") then
					kinds[lane] = "None"
				end
			elseif kind ~= "None" then
				if not spawnObstacle(lane, z, kind) then
					kinds[lane] = "None"
				end
			end
		end

		-- Bonus sur la voie libre
		if st.PendingPower and not pickup.Active then
			local kind = st.PendingPower :: string
			local style = POWER_STYLE[kind]
			pickup.Active = true
			pickup.Kind = kind
			pickup.Lane = free
			pickup.Z = z + 1.3
			pickup.Icon.Text = style.Icon
			pickup.Text.Text = style.Text
			pickup.Halo.BackgroundColor3 = style.Color
			pickup.Stroke.Color = style.Color
			pickup.Bubble.BackgroundColor3 = WHITE:Lerp(style.Color, 0.25)
			pickup.Root.Visible = true
			st.PendingPower = nil
		end

		-- Pièces : sur la voie libre, ou en arc au-dessus d'un obstacle bas
		local coinLane = free
		if random:NextNumber() < 0.4 then
			local other = random:NextInteger(1, 3)
			local kind = kinds[other]
			if kind == "Low" or kind == "Cone" or kind == "High" or kind == "None" then
				coinLane = other
			end
		end
		local count = random:NextInteger(3, 5)
		local arc = kinds[coinLane] == "Low" or kinds[coinLane] == "Cone"
		for k = 0, count - 1 do
			local dz = (k - (count - 1) / 2) * 0.42
			local height = COIN_H
			if arc then
				height += 38 * math.max(0, 1 - (dz / 0.95) ^ 2)
			end
			spawnCoin(coinLane, z + dz, height, false)
		end
	end

	------------------------------------------------------------------
	-- Ramassage, événements
	------------------------------------------------------------------
	local function eventText(text: string, color: Color3)
		if st.EventCooldown > 0 then
			return
		end
		st.EventCooldown = 2.6
		popText(text, CX, HY - 8 * U + textDrop, color, 150 * U, 22 * U, true)
	end

	-- Pièce qui file vers le compteur (le compteur pulse à son arrivée)
	local function launchFlyer(x: number, y: number, size: number)
		if not effectsOn() then
			st.CoinPulse = 1
			return
		end
		local chosen = flyers[1]
		for _, flyer in ipairs(flyers) do
			if flyer.T >= 1 then
				chosen = flyer
				break
			end
			if flyer.T > chosen.T then
				chosen = flyer
			end
		end
		if chosen.T < 1 then
			st.CoinPulse = 1 -- pièce remplacée : elle "arrive" tout de suite
		end
		chosen.T = 0
		chosen.From = Vector2.new(x, y)
		chosen.Size = math.max(6 * U, size)
		chosen.Frame.Visible = true
	end

	-- Bulle d'émoji au-dessus de la tête
	local function showEmote(emoji: string, duration: number)
		if not effectsOn() then
			return
		end
		hero.EmoteLabel.Text = emoji
		hero.Emote.Visible = true
		st.EmoteT = 0
		st.EmoteDur = duration
	end

	-- Se retourne (visage visible) : "Smile" | "Wow" | "Happy" | "Dizzy"
	local function lookBack(expression: string, duration: number, direction: number?)
		st.Expression = expression
		st.LookT = 0
		st.LookDur = duration
		st.LookDir = direction or ((random:NextNumber() < 0.5) and -1 or 1)
		st.LookTimer = random:NextNumber(6, 11)
	end

	local function collectCoin(coin, px: number, py: number)
		coin.Active = false
		coin.Frame.Visible = false
		local gain = st.DoubleTime > 0 and 2 or 1
		st.Coins += gain
		launchFlyer(px, py, COIN_SIZE * U / math.max(coin.Z, 0.6))
		if st.Clock - st.LastCoin < COMBO_WINDOW then
			st.Combo += 1
			st.ComboPulse = 1
		else
			st.Combo = 1
		end
		st.LastCoin = st.Clock
		spawnSparkles(px, py, 2)
		local headY = sy(st.RunnerH + CHAR_H + 4, CHAR_Z)
		if st.Clock - st.LastCoinPop < 0.3 then
			return
		end
		st.LastCoinPop = st.Clock
		popText(gain == 2 and "+2" or "+1", px + random:NextNumber(4, 14) * U, math.min(py, headY), gain == 2 and rgb(255, 150, 60) or GOLD, 28 * U, 13 * U)
	end

	local function activatePower(kind: string, px: number, py: number)
		local popY = HY - 14 * U + textDrop -- au-dessus de la tête (bulle d'émoji)
		st.EventCooldown = math.max(st.EventCooldown, 1.2)
		if kind == "Jetpack" then
			st.JetTime = JET_TIME
			st.MagnetTime = 0
			st.AirLane = st.TargetLane
			st.AirCount = 0
			st.AirDistance = 0
			st.JumpT, st.SlideT = -1, -1
			popText(Locale.T("JETPACK!"), CX, popY, rgb(120, 220, 255), 130 * U, 26 * U, true)
			showEmote("😎", 1.6)
		elseif kind == "Double" then
			st.DoubleTime = DOUBLE_TIME
			popText(Locale.T("COINS x2!"), CX, popY, rgb(255, 196, 40), 140 * U, 26 * U, true)
			showEmote("🤑", 1.4)
		else
			st.MagnetTime = MAGNET_TIME
			st.JetTime = 0
			popText(Locale.T("MAGNET!"), CX, popY, rgb(255, 120, 190), 130 * U, 26 * U, true)
			showEmote("😍", 1.4)
		end
		lookBack("Happy", 0.9)
		spawnSparkles(px, py, 6)
	end

	------------------------------------------------------------------
	-- Baskets : niveau de l'amélioration "RunnerShoes" (0 à 10), visible
	-- sur le coureur, dans sa traînée et dans le badge du HUD ; mis à jour
	-- en direct à chaque achat (ctx.State.Changed)
	------------------------------------------------------------------
	local shoeTier = SHOE_TIERS[0]
	local shoeTrail: any = nil -- style de traînée lumineuse (nil = poussière seulement)

	local function readShoeLevel(): number
		local level = tonumber(ctx.GetLevel("RunnerShoes")) or 0
		return math.clamp(math.floor(level), 0, MAX_SHOE_LEVEL)
	end

	local function applyShoes(level: number)
		local tier = SHOE_TIERS[level] or SHOE_TIERS[0]
		shoeTier = tier
		st.ShoeLevel = level
		local glow = tier.Glow
		local flameLevel = tier.Flame or 0
		for _, shoe in ipairs(hero.Shoes) do
			tint(shoe.Upper, tier.Body)
			tint(shoe.Heel, tier.Accent)
			shoe.Stripe.Visible = tier.Stripe ~= nil
			if tier.Stripe then
				tint(shoe.Stripe, tier.Stripe)
			end
			shoe.Laces.Visible = tier.Laces ~= nil
			if tier.Laces then
				tint(shoe.Laces, tier.Laces)
			end
			-- semelle lumineuse (néon) : jamais assombrie la nuit
			if glow then
				glowColor(shoe.Sole, tier.Sole)
				shoe.Glow.BackgroundColor3 = glow
			else
				tint(shoe.Sole, tier.Sole)
			end
			shoe.Glow.Visible = glow ~= nil
			shoe.Wing.Visible = tier.Wings ~= nil
			if tier.Wings then
				for _, feather in ipairs(shoe.Feathers) do
					tint(feather, tier.Wings)
				end
			end
			shoe.Flame.Visible = flameLevel > 0
			shoe.Core.Visible = flameLevel > 1
			shoe.Nozzle.Visible = flameLevel > 0
			shoe.Root.Size = UDim2.fromScale(SHOE_W * (flameLevel > 1 and 1.06 or 1), SHOE_H * (tier.High and 1.3 or 1))
		end
		hero.UnderGlow.Visible = glow ~= nil
		if glow then
			hero.UnderGlow.BackgroundColor3 = glow
		end
		-- Traînée lumineuse (niveaux 5+) : couleurs de la tête à la queue
		shoeTrail = glow and SHOE_TRAILS[tier.Trail] or nil
		for _, ribbon in ipairs(ribbons) do
			for k, segment in ipairs(ribbon.Segments) do
				if shoeTrail and glow then
					local head = shoeTrail.HeadColor or glow
					local tail = shoeTrail.TailColor or glow
					local t0, t1 = (k - 1) / RIBBON_SEGMENTS, k / RIBBON_SEGMENTS
					local gradient = ribbon.Gradients[k]
					gradient.Color = ColorSequence.new(head:Lerp(tail, t0), head:Lerp(tail, t1))
					gradient.Transparency = NumberSequence.new(
						shoeTrail.Head + (shoeTrail.Tail - shoeTrail.Head) * t0,
						shoeTrail.Head + (shoeTrail.Tail - shoeTrail.Head) * t1
					)
				end
				show(segment, false)
			end
		end
		-- Lignes de vitesse teintées aux hauts niveaux
		for _, line in ipairs(speedLines) do
			line.Frame.BackgroundColor3 = glow and WHITE:Lerp(glow, 0.35) or WHITE
		end
		-- Badge du HUD
		hud.Shoe.Visible = level > 0
		if level > 0 then
			local color = SHOE_BADGE[level] or WHITE
			hud.ShoeLabel.Text = Locale.T("Lv. %s", tostring(level))
			hud.ShoeLabel.TextColor3 = level >= MAX_SHOE_LEVEL and rgb(255, 224, 110) or WHITE
			hud.ShoeShine.BackgroundColor3 = color
			if hud.ShoeStroke then
				hud.ShoeStroke.Color = color
				hud.ShoeStroke.Transparency = 0.05
				hud.ShoeStroke.Thickness = level >= MAX_SHOE_LEVEL and 2 or 1.5
			end
		end
	end

	-- Nouvelles baskets : texte, anneau aux pieds, étincelles, badge qui pulse
	local function celebrateShoes()
		local color = SHOE_BADGE[st.ShoeLevel] or WHITE
		st.ShoeFlash = 1
		st.ShoePulse = 1
		hero.ShoeRingStroke.Color = color
		hero.ShoeRing.Visible = true
		popText(Locale.T("NEW SHOES!"), CX, HY - 14 * U + textDrop, color, 160 * U, 24 * U, true)
		st.EventCooldown = math.max(st.EventCooldown, 1.6)
		showEmote("🤩", 1.6)
		lookBack("Happy", 1.1)
		spawnSparkles(sx(st.RunnerX, CHAR_Z), sy(6, CHAR_Z), 5)
	end

	local function refreshShoes()
		local level = readShoeLevel()
		if level == st.ShoeLevel then
			return
		end
		local upgraded = st.ShoeLevel >= 0 and level > st.ShoeLevel
		applyShoes(level)
		if upgraded then
			st.PendingCelebrate = true -- joué dès que la carte est visible
		end
	end

	------------------------------------------------------------------
	-- "IA" du coureur : choisit sa voie (évite les trains, vise les pièces)
	------------------------------------------------------------------

	-- Temps (s) avant qu'un train n'arrive sur le coureur dans cette voie
	local function laneDanger(lane: number): number
		local best = math.huge
		for _, train in ipairs(trains) do
			if train.Active and train.Lane == lane then
				local v = st.Speed + train.Extra
				local leave = (train.Z + TRAIN_LEN - CHAR_Z + 0.3) / v
				if leave > 0 then
					best = math.min(best, math.max(0, (train.Z - CHAR_Z - 0.3) / v))
				end
			end
		end
		return best
	end

	local function laneAppeal(lane: number): number
		local score = 0
		for _, coin in ipairs(coinsPool) do
			if coin.Active and coin.Lane == lane and coin.Z > CHAR_Z and coin.Z < CHAR_Z + 3.5 then
				score += 0.5
			end
		end
		for _, ob in ipairs(obstacles) do
			if ob.Active and ob.Lane == lane and ob.Z > CHAR_Z and ob.Z < CHAR_Z + 3 then
				-- fin de course programmée : il fonce (sans le savoir) vers l'obstacle
				score += (st.CrashPending and ob.Kind ~= "High") and 1.5 or -0.2
			end
		end
		if pickup.Active and pickup.Lane == lane and pickup.Z > CHAR_Z then
			score += 4
		end
		if lane == st.WishLane then
			score += 0.9
		end
		return score
	end

	local function setLane(lane: number)
		if lane ~= st.TargetLane then
			st.LeftLane = st.TargetLane
			st.LaneChangedAt = st.Clock
			st.TargetLane = lane
		end
	end

	local function chooseLane()
		local current = st.TargetLane
		local danger = { laneDanger(1), laneDanger(2), laneDanger(3) }
		local bestLane, bestScore = current, -math.huge
		for lane = 1, 3 do
			local score = laneAppeal(lane) - math.abs(lane - current) * 0.8
			if danger[lane] < 1.1 then
				score -= 100 - danger[lane] * 20 -- plus le train est proche, pire c'est
			end
			if math.abs(lane - current) == 2 and danger[2] < 0.9 then
				score -= 80 -- impossible de traverser la voie du milieu
			end
			if lane == current then
				score += 0.3
			end
			if score > bestScore then
				bestLane, bestScore = lane, score
			end
		end
		if bestLane ~= current then
			setLane(current + (bestLane > current and 1 or -1)) -- une voie à la fois
		end
	end

	------------------------------------------------------------------
	-- Début / fin de partie
	------------------------------------------------------------------
	local function resetRun()
		for _, train in ipairs(trains) do
			hideTrain(train)
		end
		for _, ob in ipairs(obstacles) do
			ob.Active = false
			ob.Visual.Visible = false
		end
		for _, coin in ipairs(coinsPool) do
			coin.Active = false
			coin.Frame.Visible = false
		end
		pickup.Active = false
		pickup.Root.Visible = false
		st.Mode, st.ModeT = "Run", 0
		st.ShownCombo = -1
		hud.ResultsBest.Rotation = 0
		st.RunTime = 0
		st.RunLength = random:NextNumber(80, 160)
		st.CrashPending = false
		st.Speed = BASE_SPEED
		st.WaveDistance = 0
		st.Distance = 0
		st.Coins = 0
		st.Combo = 0
		st.BestBeaten = false
		st.TargetLane, st.LeftLane = 2, 2
		st.RunnerX, st.RunnerH = 0, 0
		st.JumpT, st.SlideT, st.LandT = -1, -1, 0
		st.JetTime, st.MagnetTime, st.DoubleTime = 0, 0, 0
		st.PowerTimer = random:NextNumber(8, 12)
		st.PendingPower = nil
		st.LookT, st.Turn = -1, 0
		st.LookTimer = random:NextNumber(3, 6)
		st.Trick = 0
		st.RibbonReset = true
		hero.Root.Rotation = 0
		hud.Results.Visible = false
		hud.ReplayScale.Scale = 1
		spawnWave(Z_FAR - WAVE_GAP * 1.5)
		spawnWave(Z_FAR)
		popText(Locale.T("GO!"), CX, HY + 10 * U, rgb(120, 255, 160), 110 * U, 28 * U, true)
	end

	local function startCrash(ob)
		st.Mode, st.ModeT = "Crash", 0
		st.CrashPending = false
		st.JumpT, st.SlideT = -1, -1
		st.Combo = 0
		st.ShakeT = 0.35
		ob.Knock = 0.001
		local px, py = sx(st.RunnerX, CHAR_Z), sy(20, CHAR_Z)
		spawnSparkles(px, py, 6)
		for k = 1, 5 do
			spawnDust(px + (k - 3) * 5 * U, sy(0, CHAR_Z), (k - 3) * 22 * U, -random:NextNumber(10, 30) * U, 7 * U, 0.6)
		end
		popText(Locale.T("OUCH!"), CX, HY + 4 * U, rgb(255, 110, 100), 120 * U, 28 * U, true)
		-- sonné : il se retourne (yeux en croix), étoiles autour de la tête
		lookBack("Dizzy", 99, (random:NextNumber() < 0.5) and -1 or 1)
		showEmote("😵", 1.3)
		-- Résultats (affichés un peu plus tard)
		local meters = math.floor(st.Distance)
		local newBest = meters > sessionBest
		local previousBest = sessionBest
		if newBest then
			sessionBest = meters
		end
		hud.ResultsDistance.Text = withSpaces(meters) .. " m"
		hud.ResultsCoins.Text = "🪙 " .. withSpaces(st.Coins)
		st.NewBest = newBest and previousBest > 0
		if st.NewBest then
			hud.ResultsBest.Text = Locale.T("NEW BEST!")
			hud.ResultsBest.TextColor3 = rgb(255, 220, 90)
		else
			hud.ResultsBest.Text = Locale.T("Best: %s m", withSpaces(sessionBest))
			hud.ResultsBest.TextColor3 = rgb(200, 210, 240)
		end
	end

	------------------------------------------------------------------
	-- Mise en place : décor placé, deux vagues déjà en route
	------------------------------------------------------------------
	updateStatic()
	st.LastStaticCam = camX
	updateLighting(true)
	spawnWave(Z_FAR - WAVE_GAP * 1.5)
	spawnWave(Z_FAR)
	refreshShoes()
	ctx.Connect(ctx.State.Changed, refreshShoes)

	------------------------------------------------------------------
	-- Décor qui défile
	------------------------------------------------------------------
	-- Décor d'ambiance (30 images/s au plus) : nuages, oiseaux, grande
	-- roue, feu de la tour de télévision
	local function updateAmbient(dt: number)
		for _, cloud in ipairs(clouds) do
			cloud.X -= cloud.Speed * dt
			if cloud.X < -cloud.Width then
				cloud.X += SW + cloud.Width * 2
			end
			cloud.Frame.Position = UDim2.fromOffset(cloud.X - camX * cloud.Parallax * U, cloud.Y)
		end
		for _, bird in ipairs(birds) do
			if bird.Holder.Visible then
				bird.X += bird.Speed * dt
				if bird.X > SW + 14 * U then
					bird.X = -14 * U
					bird.Y = random:NextNumber(0.25, 0.6) * HY
				end
				local y = bird.Y + math.sin(st.Clock * 1.3 + bird.Phase) * 2 * U
				bird.Holder.Position = UDim2.fromOffset(bird.X - camX * 0.05 * U, y)
				-- ailes en "V" qui battent (bout intérieur collé au corps)
				local angle = 14 + math.sin(st.Clock * bird.Flap + bird.Phase) * 26
				local rad = math.rad(angle)
				local half = 2.3 * U
				for _, wing in ipairs(bird.Wings) do
					wing.Frame.Position = UDim2.fromOffset(4.5 * U + wing.Sign * math.cos(rad) * half, 3 * U - math.sin(rad) * half)
					wing.Frame.Rotation = -wing.Sign * angle
				end
			end
		end
		local wheel = city.Wheel
		wheel.Angle += dt * 0.22
		for _, spoke in ipairs(wheel.Spokes) do
			spoke.Frame.Rotation = spoke.Base + math.deg(wheel.Angle)
		end
		for _, gondola in ipairs(wheel.Gondolas) do
			local a = gondola.Base + wheel.Angle
			gondola.Frame.Position = UDim2.fromOffset(wheel.Center.X + math.cos(a) * wheel.Radius, wheel.Center.Y + math.sin(a) * wheel.Radius)
		end
		city.TowerLight.BackgroundTransparency = (st.Night > 0.3 and math.sin(st.Clock * 3.2) > 0.2) and 0 or 1
		-- reflet qui glisse sur le badge des baskets
		if hud.Shoe.Visible then
			hud.ShoeShineGradient.Offset = Vector2.new(math.sin(st.Clock * 1.6) * 0.5, 0)
		end
	end

	-- Pont : apparaît au loin de temps en temps et passe au-dessus du coureur
	local function hideBridge()
		bridge.Active = false
		bridge.Face.Visible = false
		bridge.Under.Visible = false
		bridge.Shadow.Visible = false
		for _, pillar in ipairs(bridge.Pillars) do
			pillar.Frame.Visible = false
		end
	end

	local function updateBridge(move: number)
		if not bridge.Active then
			if st.Mode == "Run" and st.Scroll >= st.BridgeNext then
				st.BridgeNext = st.Scroll + random:NextNumber(40, 64)
				bridge.Active = true
				bridge.Z = Z_FAR + 2.5
				bridge.Face.Visible = true
				bridge.Under.Visible = true
				bridge.Shadow.Visible = true
				for _, pillar in ipairs(bridge.Pillars) do
					pillar.Frame.Visible = true
				end
			else
				return
			end
		end
		bridge.Z -= move
		local z = bridge.Z
		if z + BRIDGE_DEPTH < 0.3 then
			hideBridge()
			return
		end
		local zf = math.max(z, 0.22)
		local zb = math.max(z + BRIDGE_DEPTH, 0.28)
		local zm = (zf + zb) / 2
		local left, right = -14 * U, SW + 14 * U
		local top, low = sy(BRIDGE_TOP, zf), sy(BRIDGE_LOW, zf)
		bridge.Face.Position = UDim2.fromOffset(left, top)
		bridge.Face.Size = UDim2.fromOffset(right - left, math.max(1, low - top))
		bridge.Face.ZIndex = depthZ(zf)
		local lowBack = sy(BRIDGE_LOW, zb)
		bridge.Under.Position = UDim2.fromOffset(left, low)
		bridge.Under.Size = UDim2.fromOffset(right - left, math.max(1, lowBack - low))
		bridge.Under.ZIndex = depthZ(zb)
		for _, pillar in ipairs(bridge.Pillars) do
			local pillarTop = sy(BRIDGE_LOW, zm)
			pillar.Frame.Position = UDim2.fromOffset(sx(pillar.Sign * BRIDGE_PILLAR_X, zm), pillarTop)
			pillar.Frame.Size = UDim2.fromOffset(math.max(1, 18 * U / zm), math.max(1, sy(WALL_H, zm) - pillarTop))
			pillar.Frame.ZIndex = depthZ(zm)
		end
		-- ombre sur la voie (entre les murs)
		local shadowTop, shadowBottom = sy(0, zb), sy(0, zf)
		local halfW = WALL_X * U / zf
		bridge.Shadow.Position = UDim2.fromOffset(sx(0, zf) - halfW, shadowTop)
		bridge.Shadow.Size = UDim2.fromOffset(halfW * 2, math.max(1, shadowBottom - shadowTop))
	end

	local function updateScenery(dt: number, move: number)
		updateBridge(move)
		city.FarHolder.Position = UDim2.fromOffset(-SKY_MARGIN - camX * 0.06 * U, 0)
		city.MidHolder.Position = UDim2.fromOffset(-SKY_MARGIN - camX * 0.15 * U, 0)

		local scroll = st.Scroll
		for _, tie in ipairs(ties) do
			local z = TIE_START + (tie.Offset - scroll) % TIE_CYCLE
			local top = sy(0, z + TIE_DEPTH)
			local f = tie.Frame
			f.Position = UDim2.fromOffset(sx(tie.X, z + TIE_DEPTH * 0.5), top)
			f.Size = UDim2.fromOffset(TIE_HALF * 2 * U / z, math.max(1, sy(0, z) - top))
			local alpha = fade(z, 3, 4.4)
			if alpha ~= tie.Alpha then
				tie.Alpha = alpha
				f.BackgroundTransparency = alpha
			end
		end

		for _, pole in ipairs(poles) do
			local z = 0.55 + (pole.Offset - scroll) % POLE_CYCLE
			local x = sx(pole.Sign * POLE_X, z)
			local topY = sy(POLE_H, z)
			local t = fade(z, 4.6, 5.9)
			local depth = depthZ(z)
			pole.Pole.Position = UDim2.fromOffset(x, sy(0, z))
			pole.Pole.Size = UDim2.fromOffset(math.max(1, 4 * U / z), POLE_H * U / z)
			pole.Arm.Position = UDim2.fromOffset(x, topY)
			pole.Arm.Size = UDim2.fromOffset(POLE_ARM * U / z, math.max(1, 3 * U / z))
			if depth ~= pole.Depth then
				pole.Depth = depth
				pole.Pole.ZIndex = depth
				pole.Arm.ZIndex = depth
				pole.Pool.ZIndex = depth - 1
			end
			if t ~= pole.Alpha then
				pole.Alpha = t
				pole.Pole.BackgroundTransparency = t
				pole.Arm.BackgroundTransparency = t
				pole.Glow.BackgroundTransparency = t
			end
			-- flaque de lumière sous la lampe (la nuit)
			local lampX = pole.Sign * (POLE_X - POLE_ARM)
			pole.Pool.Position = UDim2.fromOffset(sx(lampX, z), sy(0, z))
			pole.Pool.Size = UDim2.fromOffset(56 * U / z, 12 * U / z)
			show(pole.Pool, st.Night > 0.05 and t < 1)
		end

		for _, pillar in ipairs(pillars) do
			local z = 0.7 + (pillar.Offset - scroll) % PILLAR_CYCLE
			local f = pillar.Frame
			local x = sx(pillar.Sign * PILLAR_X, z)
			local originX = pillar.Sign < 0 and 0 or CX
			f.Position = UDim2.fromOffset(x - originX, sy(0, z))
			f.Size = UDim2.fromOffset(math.max(1, PILLAR_W * U / z), (WALL_H + 2) * U / z)
			local alpha = fade(z, 5.2, 6.4)
			if alpha ~= pillar.Alpha then
				pillar.Alpha = alpha
				f.BackgroundTransparency = alpha
			end
		end

		for _, tree in ipairs(trees) do
			local z = 1 + (tree.Offset - scroll) % TREE_CYCLE
			local originX = tree.Sign < 0 and 0 or CX
			local x = sx(tree.Sign * TREE_X, z) - originX
			local k = U / z * tree.Size
			tree.Trunk.Position = UDim2.fromOffset(x, sy(WALL_H - 4, z))
			tree.Trunk.Size = UDim2.fromOffset(math.max(1, 5 * k), 26 * k)
			tree.Crown.Position = UDim2.fromOffset(x, sy(WALL_H - 4, z) - 36 * k)
			tree.Crown.Size = UDim2.fromOffset(40 * k, 36 * k)
		end

		for _, panel in ipairs(panels) do
			panel.Z -= move
			if panel.Z + PANEL_LEN < 1 then
				panel.Z = random:NextNumber(8, 12)
				restylePanel(panel)
			end
			local f = panel.Frame
			if panel.Z > 8 then
				f.Visible = false
			else
				local s = panel.Side.Sign
				local xNear = sx(s * WALL_X, panel.Z)
				local xFar = sx(s * WALL_X, panel.Z + PANEL_LEN)
				local midZ = panel.Z + PANEL_LEN / 2
				local top = sy(54, midZ)
				local t = fade(panel.Z, 6.3, 8)
				f.Visible = true
				f.Position = UDim2.fromOffset(math.min(xNear, xFar) - panel.Side.Origin.X, top)
				f.Size = UDim2.fromOffset(math.abs(xNear - xFar), sy(16, midZ) - top)
				f.BackgroundTransparency = t
				panel.Label.TextTransparency = t
				panel.Label.TextStrokeTransparency = t
			end
		end
	end

	------------------------------------------------------------------
	-- Trains
	------------------------------------------------------------------
	local function updateTrains(dt: number, move: number)
		for _, train in ipairs(trains) do
			if train.Active then
				local previousZ = train.Z
				train.Z -= move + train.Extra * dt * (st.Mode == "Run" and 1 or 0)
				if previousZ >= CHAR_Z and train.Z < CHAR_Z and st.Mode == "Run" and not train.Passed then
					train.Passed = true
					-- Évité de justesse : train qui fonce à côté, ou voie quittée à temps
					local laneX = LANES[train.Lane]
					local dodged = st.Clock - st.LaneChangedAt < 1 and train.Lane == st.LeftLane
					if dodged or (train.Extra > 0 and math.abs(laneX - st.RunnerX) < 100 and st.JetTime <= 0) then
						eventText(Locale.T("CLOSE CALL!"), rgb(255, 150, 90))
						-- il se retourne, les yeux ronds, vers le train qui passe
						lookBack("Wow", 1.1, laneX < st.RunnerX and -1 or 1)
						showEmote("😮", 1.2)
					end
				end
				if train.Z < Z_NEAR then
					hideTrain(train)
				else
					local z = train.Z
					local back = z + TRAIN_LEN
					local laneX = LANES[train.Lane]
					local x = sx(laneX, z)
					local depth = depthZ(z)
					local body = train.Body
					body.Position = UDim2.fromOffset(x, sy(0, z))
					body.Size = UDim2.fromOffset(TRAIN_W * U / z, TRAIN_H * U / z)
					body.ZIndex = depth
					local halfW = TRAIN_W / 2
					-- Toit : trapèze entre l'avant et l'arrière
					setHQuad(
						train.Roof,
						sy(TRAIN_H, back),
						sx(laneX - halfW + 3, back),
						sx(laneX + halfW - 3, back),
						sy(TRAIN_H, z) + 1,
						sx(laneX - halfW + 3, z),
						sx(laneX + halfW - 3, z),
						depth - 1
					)
					-- Flanc tourné vers la caméra
					local offset = laneX - camX
					if math.abs(offset) > halfW then
						local sideX = offset > 0 and laneX - halfW or laneX + halfW
						setVQuad(
							train.Side,
							sx(sideX, z),
							sy(TRAIN_H - 4, z),
							sy(2, z),
							sx(sideX, back),
							sy(TRAIN_H - 4, back),
							sy(2, back),
							depth - 3
						)
						-- bande vitrée (du nez à l'arrière), inutile au loin
						if z < 7 then
							local winFront, winBack = z + 0.14, back - 0.12
							setVQuad(
								train.Windows,
								sx(sideX, winFront),
								sy(TRAIN_H - 17, winFront),
								sy(TRAIN_H - 40, winFront),
								sx(sideX, winBack),
								sy(TRAIN_H - 17, winBack),
								sy(TRAIN_H - 40, winBack),
								depth - 2
							)
						else
							hideQuad(train.Windows)
						end
					else
						hideQuad(train.Side)
						hideQuad(train.Windows)
					end
					if train.Extra > 0 then
						-- Phares qui clignotent : il fonce vers nous !
						local blink = (math.sin(st.Clock * 16) > 0) and 0 or 0.4
						train.HeadL.BackgroundTransparency = blink
						train.HeadR.BackgroundTransparency = 0.4 - blink
					end
				end
			end
		end
	end

	------------------------------------------------------------------
	-- Obstacles
	------------------------------------------------------------------
	local function updateObstacles(dt: number, move: number)
		for _, ob in ipairs(obstacles) do
			if ob.Active then
				local previousZ = ob.Z
				ob.Z -= move
				if ob.Knock > 0 and ob.Knock < 0.5 then
					ob.Z += dt * 2.6 -- percuté : l'obstacle est projeté devant le coureur
				end
				if ob.Fatal and st.Mode == "Run" and ob.Z <= CHAR_Z + 0.1 then
					ob.Fatal = false
					if ob.Lane == nearestLane(st.RunnerX) and st.RunnerH < ob.Top then
						startCrash(ob)
					end
				end
				if previousZ >= CHAR_Z and ob.Z < CHAR_Z and not ob.Passed and st.Mode == "Run" then
					ob.Passed = true
					if ob.Lane == nearestLane(st.RunnerX) and st.JetTime <= 0 then
						if ob.Kind == "High" then
							eventText(Locale.T("SLIDE!"), rgb(140, 220, 255))
						elseif st.RunnerH > 12 and random:NextNumber() < 0.7 then
							eventText(Locale.T("NICE JUMP!"), rgb(130, 255, 150))
						end
					end
				end
				if ob.Z < Z_NEAR then
					ob.Active = false
					ob.Visual.Visible = false
				else
					local z = ob.Z
					local x = sx(LANES[ob.Lane], z)
					local knock = 0
					if ob.Knock > 0 then
						ob.Knock += dt
						knock = math.min(1, ob.Knock * 3)
					end
					if ob.Kind == "Cone" then
						local cones = ob.Cones
						cones.Position = UDim2.fromOffset(x, sy(0, z) - knock * 10 * U)
						cones.Size = UDim2.fromOffset(BARRIER_W * U / z, ob.Top * U / z)
						cones.ZIndex = depthZ(z)
						cones.Rotation = knock * 28
					else
						local board = ob.Board
						board.Position = UDim2.fromOffset(x, sy(ob.Bottom, z) - knock * 8 * U)
						board.Size = UDim2.fromOffset(BARRIER_W * U / z, (ob.Top - ob.Bottom) * U / z)
						board.ZIndex = depthZ(z)
						board.Rotation = knock * 22
						if ob.Kind == "High" then
							local on = math.sin(st.Clock * 7 + ob.Phase) > 0
							ob.Light.BackgroundColor3 = on and rgb(255, 70, 60) or rgb(130, 30, 34)
						end
					end
				end
			end
		end
	end

	------------------------------------------------------------------
	-- Pièces (aimant, ramassage) et bonus
	------------------------------------------------------------------
	local function updateCoins(dt: number, move: number)
		local runnerX, runnerH = st.RunnerX, st.RunnerH
		for _, coin in ipairs(coinsPool) do
			if coin.Active then
				local previousZ = coin.Z
				local collected = false
				if st.MagnetTime > 0 and not coin.Pulled and coin.Z < CHAR_Z + 2.6 and coin.Z > CHAR_Z - 0.2 then
					coin.Pulled = true
				end
				if coin.Pulled then
					-- Aimant : la pièce file vers le coureur (au lieu de défiler)
					local k = math.min(1, dt * 10)
					coin.X += (runnerX - coin.X) * k
					coin.H += (runnerH + 30 - coin.H) * k
					coin.Z += (CHAR_Z - coin.Z) * math.min(1, dt * 8)
					collected = math.abs(coin.Z - CHAR_Z) < 0.15 and math.abs(coin.X - runnerX) < 16
				else
					coin.Z -= move
				end
				if collected then
					-- déjà ramassée par l'aimant
				elseif previousZ >= CHAR_Z and coin.Z < CHAR_Z and st.Mode == "Run" then
					collected = math.abs(coin.X - runnerX) < 30 and coin.H > runnerH - 12 and coin.H < runnerH + CHAR_H + 12
				end
				local z = math.max(coin.Z, 0.3)
				local px, py = sx(coin.X, z), sy(coin.H, z)
				if collected then
					collectCoin(coin, px, py)
				elseif coin.Z < Z_NEAR then
					coin.Active = false
					coin.Frame.Visible = false
				else
					coin.Phase += dt * 6
					local size = COIN_SIZE * U / z
					local spin = math.abs(math.cos(coin.Phase))
					local f = coin.Frame
					f.Position = UDim2.fromOffset(px, py)
					f.Size = UDim2.fromOffset(size * math.max(0.14, spin), size)
					f.ZIndex = depthZ(z)
					coin.Gradient.Offset = Vector2.new(math.sin(st.Clock * 2.4 + coin.Phase * 0.3) * 0.7, 0)
				end
			end
		end

		if pickup.Active then
			local previousZ = pickup.Z
			pickup.Z -= move
			local z = math.max(pickup.Z, 0.3)
			local height = 32 + math.sin(st.Clock * 4) * 5
			local px, py = sx(LANES[pickup.Lane], z), sy(height, z)
			if previousZ >= CHAR_Z and pickup.Z < CHAR_Z and math.abs(LANES[pickup.Lane] - runnerX) < 34 and st.Mode == "Run" then
				pickup.Active = false
				pickup.Root.Visible = false
				activatePower(pickup.Kind, px, py)
			elseif pickup.Z < Z_NEAR then
				pickup.Active = false
				pickup.Root.Visible = false
			else
				local size = 28 * U / z * (1 + math.sin(st.Clock * 6) * 0.05)
				pickup.Root.Position = UDim2.fromOffset(px, py)
				pickup.Root.Size = UDim2.fromOffset(size, size)
				pickup.Root.ZIndex = depthZ(z)
				pickup.Bubble.Rotation = math.sin(st.Clock * 3) * 10
				pickup.Halo.Size = UDim2.fromScale(1.55 + math.sin(st.Clock * 5) * 0.15, 1.55 + math.sin(st.Clock * 5) * 0.15)
				pickup.Stroke.Thickness = math.max(1, size * 0.07)
			end
		end
	end

	------------------------------------------------------------------
	-- Pose et animation du coureur
	------------------------------------------------------------------
	local legAngle = { 0, 0 }
	local armLen = { ARM_LEN, ARM_LEN }
	local armAngle = { 0, 0 }
	-- Position des talons à l'écran (étincelles, poussière) : x1, y1, x2, y2
	local heels = { 0, 0, 0, 0 }

	-- Visage : se retourne de temps en temps, cligne des yeux, expressions
	local function updateFace(dt: number)
		if st.Mode == "Run" and st.LookT < 0 then
			st.LookTimer -= dt
			if st.LookTimer <= 0 and st.JumpT < 0 and st.SlideT < 0 and st.JetTime <= 0 then
				lookBack("Smile", random:NextNumber(0.8, 1.2))
			end
		end
		local turnTarget = 0
		if st.LookT >= 0 then
			st.LookT += dt
			if st.LookT >= st.LookDur then
				st.LookT = -1
			else
				turnTarget = st.LookDir * 0.8
			end
		end
		st.Turn += (turnTarget - st.Turn) * math.min(1, dt * 11)
		st.BlinkTimer -= dt
		if st.BlinkTimer <= 0 then
			st.BlinkTimer = random:NextNumber(1.4, 3.4)
			st.BlinkT = 0.13
		end
		st.BlinkT = math.max(0, st.BlinkT - dt)

		local turn = st.Turn
		local a = math.abs(turn)
		local dir = turn >= 0 and 1 or -1
		local visible = a > 0.08
		show(hero.Face, visible)
		-- l'oreille du côté du visage passe derrière la joue ; la visière tourne
		show(hero.Ears[1], not (dir < 0 and a > 0.35))
		show(hero.Ears[2], not (dir > 0 and a > 0.35))
		hero.Visor.Position = UDim2.fromScale(0.5 - turn * 0.22, 0.53)
		if not visible then
			return
		end
		hero.Face.Position = UDim2.fromScale(0.5 + dir * (0.5 - 0.3 * a), 0.66)
		hero.Face.Size = UDim2.fromScale(0.3 + 0.36 * a, 0.62)
		local expression = st.Expression
		local expr = EXPRESSIONS[expression] or EXPRESSIONS.Smile
		local featureX = 0.5 + dir * 0.2
		local blink = (st.BlinkT > 0 and (expression == "Smile" or expression == "Wow")) and 0.16 or 1
		hero.Eye.Position = UDim2.fromScale(featureX, 0.36)
		hero.Eye.Size = UDim2.fromScale(expr.Eye.X, expr.Eye.Y * blink)
		hero.Eye.Rotation = expression == "Dizzy" and 45 or (expression == "Happy" and -dir * 16 or 0)
		show(hero.EyeX, expression == "Dizzy")
		hero.EyeX.Position = UDim2.fromScale(featureX, 0.36)
		hero.Brow.Position = UDim2.fromScale(featureX - dir * 0.02, expr.Brow)
		hero.Brow.Rotation = expression == "Wow" and -dir * 12 or dir * 8
		hero.Mouth.Position = UDim2.fromScale(0.5 + dir * 0.24, expression == "Wow" and 0.8 or 0.78)
		hero.Mouth.Size = UDim2.fromScale(expr.Mouth.X, expr.Mouth.Y)
		hero.Blush.Position = UDim2.fromScale(0.5 + dir * 0.04, 0.62)
	end

	local function updateHero(dt: number)
		local running = st.Mode == "Run"
		st.RunPhase += dt * (9 + st.Speed * 1.3)
		local sinP = math.sin(st.RunPhase)
		local liftL, liftR = math.max(0, sinP), math.max(0, -sinP)
		-- Bras opposés aux jambes : pied gauche levé derrière = bras gauche en
		-- avant (raccourci) et bras droit en arrière (coude écarté)
		armLen[1] = ARM_LEN * (1 - 0.3 * liftL + 0.04 * liftR)
		armLen[2] = ARM_LEN * (1 - 0.3 * liftR + 0.04 * liftL)
		armAngle[1] = 10 + 24 * liftR - 6 * liftL
		armAngle[2] = 10 + 24 * liftL - 6 * liftR
		legAngle[1], legAngle[2] = 0, 0
		local bob = math.abs(sinP) * 2.2 * U
		local strike = 1 - math.abs(sinP) -- 1 : un pied touche le sol
		local widthMul, heightMul = 1 + 0.03 * strike, 1 - 0.035 * strike
		local rotation = st.Lean + sinP * 2.5
		local torsoShift = sinP * 0.014 -- les épaules tournent un peu
		local jet = st.JetTime > 0
		local flying = jet or st.RunnerH > JUMP_H + 8
		local onGround = st.RunnerH < 2
		local runCycle = running and not flying and st.SlideT < 0 and st.JumpT < 0

		if not running then
			-- Chute : bascule en avant puis reste assis, sonné (il vacille)
			local k = math.min(1, st.ModeT * 3.2)
			liftL, liftR = 0.7 * k, 0.5 * k
			armLen[1], armLen[2] = ARM_LEN * 0.82, ARM_LEN * 0.82
			armAngle[1], armAngle[2] = 70 * k, 70 * k
			legAngle[1], legAngle[2] = 16 * k, 16 * k
			bob = -math.sin(math.min(1, st.ModeT * 2.4) * math.pi) * 12 * U
			heightMul = 1 - 0.3 * k
			widthMul = 1 + 0.08 * k
			rotation = -18 * k + math.sin(st.Clock * 3.4) * 4 * k
			torsoShift = 0
		elseif flying then
			-- Jetpack : jambes qui pendent, bras écartés
			local dangle = math.sin(st.Clock * 4) * 0.15
			liftL, liftR = 0.25 + dangle, 0.25 - dangle
			armLen[1], armLen[2] = ARM_LEN * 0.9, ARM_LEN * 0.9
			armAngle[1], armAngle[2] = 40, 40
			legAngle[1], legAngle[2] = 6 + dangle * 24, 6 - dangle * 24
			bob = math.sin(st.Clock * 5) * 1.5 * U
			rotation = st.Lean
			torsoShift = 0
		elseif st.SlideT >= 0 then
			-- Glissade : accroupi, bras écartés pour l'équilibre
			local k = math.sin(math.pi * math.min(1, st.SlideT * 1.15))
			widthMul, heightMul = 1 + 0.14 * k, 1 - 0.44 * k
			liftL, liftR = 0.75 * k, 0.75 * k
			armLen[1], armLen[2] = ARM_LEN * 0.88, ARM_LEN * 0.88
			armAngle[1], armAngle[2] = 66 * k, 66 * k
			legAngle[1], legAngle[2] = 12 * k, 12 * k
			bob = 0
			rotation = st.Lean * 0.5
			torsoShift = 0
		elseif st.JumpT >= 0 then
			-- Saut : étiré au décollage, puis une figure (groupé, vrille ou étoile)
			local t = st.JumpT
			bob = 0
			torsoShift = 0
			rotation = st.Lean
			if st.Trick == 2 then
				local k = math.sin(math.pi * math.min(1, t * 1.2))
				liftL, liftR = 0.15, 0.15
				armLen[1], armLen[2] = ARM_LEN, ARM_LEN
				armAngle[1], armAngle[2] = 30 + 100 * k, 30 + 100 * k
				legAngle[1], legAngle[2] = 28 * k, 28 * k
			else
				liftL, liftR = 0.55, 0.45
				armLen[1], armLen[2] = ARM_LEN * 0.86, ARM_LEN * 0.86
				armAngle[1], armAngle[2] = st.Trick == 1 and 24 or 128, st.Trick == 1 and 24 or 128
				if st.Trick == 1 then
					rotation = st.Lean + 360 * smooth((t - 0.08) / 0.78) * st.TrickDir
				end
			end
			if t < 0.2 then
				heightMul = 1 + 0.1 * math.sin(t / 0.2 * math.pi)
				widthMul = 1 - 0.06 * math.sin(t / 0.2 * math.pi)
			end
		end
		if st.LandT > 0 and running then
			-- Écrasement à l'atterrissage
			local k = st.LandT / 0.16
			heightMul *= 1 - 0.14 * k
			widthMul *= 1 + 0.1 * k
		end

		local rootW, rootH = CW * widthMul, CH * heightMul
		local tier = shoeTier
		local shoeH = SHOE_H * (tier.High and 1.3 or 1)
		for index, leg in ipairs(hero.Legs) do
			local lift = index == 1 and liftL or liftR
			local len = LEG_LEN * (1 - 0.42 * lift)
			local hipY = LEG_TOP - 0.03 * lift
			local hipX = leg.X + torsoShift * 0.4
			local rot = -leg.Side * legAngle[index]
			leg.Pivot.Position = UDim2.fromScale(hipX, hipY)
			leg.Pivot.Size = UDim2.fromScale(0.2, len * 2)
			leg.Pivot.Rotation = rot
			-- bout de la jambe (rotation en pixels, puis retour à l'échelle du cadre)
			local rad = math.rad(rot)
			local footX = hipX - math.sin(rad) * len * rootH / rootW
			local footY = hipY + math.cos(rad) * len
			local shoe = hero.Shoes[index]
			shoe.Lift = lift
			shoe.Root.Position = UDim2.fromScale(footX, footY + SHOE_H * 0.7 - shoeH * 0.5)
			shoe.Root.Rotation = rot + leg.Side * lift * 12
			-- pied qui part en arrière : on voit la semelle (néon aux niveaux 5+)
			shoe.Sole.Size = UDim2.fromScale(1.06, 0.28 + 0.6 * lift)
			heels[index * 2 - 1] = footX
			heels[index * 2] = footY + SHOE_H * 0.7
		end
		for index, arm in ipairs(hero.Arms) do
			arm.Pivot.Position = UDim2.fromScale(arm.X + torsoShift, 0.325)
			arm.Pivot.Size = UDim2.fromScale(0.17, armLen[index] * 2)
			arm.Pivot.Rotation = -arm.Side * armAngle[index]
		end
		hero.Torso.Position = UDim2.fromScale(0.5 + torsoShift, 0.265)
		hero.Head.Position = UDim2.fromScale(0.5 + torsoShift * 0.5, math.abs(sinP) * 0.008)
		-- la tête reste plus droite que le corps (sauf pendant une vrille)
		hero.Head.Rotation = (st.Trick == 1 and st.JumpT >= 0) and 0 or -(rotation - st.Lean) * 0.5 - st.Lean * 0.3

		-- Sac à dos et capuche : ressort (rebond à l'atterrissage, léger
		-- balancement pendant la course)
		st.PackV += (-260 * st.PackY - 13 * st.PackV) * dt
		st.PackY += st.PackV * dt
		local packOffset = math.clamp(st.PackY, -0.05, 0.05) + (runCycle and math.cos(st.RunPhase * 2 + 0.9) * 0.012 or 0)
		hero.Pack.Position = UDim2.fromScale(0.5 + torsoShift * 1.3, 0.355 + packOffset)
		hero.Hood.Position = UDim2.fromScale(0.5, -0.06 + packOffset * 0.7)
		-- Porte-clés : pendule (virages, foulées)
		local accel = (st.VX - st.LastVX) / dt
		st.LastVX = st.VX
		local drive = math.clamp(accel * 0.0025, -30, 30) + (runCycle and math.cos(st.RunPhase) * 5 or 0)
		st.CharmV += (-80 * st.CharmA - 4 * st.CharmV + drive) * dt
		st.CharmA = math.clamp(st.CharmA + st.CharmV * dt, -1.1, 1.1)
		hero.Charm.Rotation = math.deg(st.CharmA)
		-- mèche de cheveux : même principe, plus raide
		st.TuftV += (-140 * st.TuftA - 7 * st.TuftV + drive * 0.7 + (runCycle and math.sin(st.RunPhase) * 4 or 0)) * dt
		st.TuftA = math.clamp(st.TuftA + st.TuftV * dt, -0.7, 0.7)
		hero.Tuft.Rotation = math.deg(st.TuftA)

		local heroScreenX = sx(st.RunnerX, CHAR_Z)
		local heroY = sy(st.RunnerH, CHAR_Z) - bob
		local root = hero.Root
		root.Position = UDim2.fromOffset(heroScreenX, heroY)
		root.Size = UDim2.fromOffset(rootW, rootH)
		root.Rotation = rotation
		local top = heroY - rootH
		for i = 1, 2 do
			heels[i * 2 - 1] = heroScreenX + (heels[i * 2 - 1] - 0.5) * rootW
			heels[i * 2] = top + heels[i * 2] * rootH
		end

		local groundY = sy(0, CHAR_Z)
		local shadowScale = 1 - math.clamp(st.RunnerH / 150, 0, 0.6)
		hero.Shadow.Position = UDim2.fromOffset(heroScreenX, groundY)
		hero.Shadow.Size = UDim2.fromOffset(32 * U * shadowScale * widthMul, 7 * U * shadowScale)
		hero.Shadow.BackgroundTransparency = 0.6 + math.clamp(st.RunnerH / 100, 0, 1) * 0.25

		-- Baskets : halo, ailes qui battent, flammes qui vacillent
		if tier.Glow then
			local k = 1 - math.clamp(st.RunnerH / 90, 0, 0.75)
			hero.UnderGlow.Position = UDim2.fromOffset(heroScreenX, groundY)
			hero.UnderGlow.Size = UDim2.fromOffset(46 * U * k, 13 * U * k)
			hero.UnderGlow.BackgroundTransparency = 0.35 + 0.12 * math.sin(st.Clock * 5) + (1 - k) * 0.4
		end
		local flameLevel = tier.Flame or 0
		for index, shoe in ipairs(hero.Shoes) do
			if tier.Glow then
				shoe.Glow.BackgroundTransparency = 0.5 + 0.14 * math.sin(st.Clock * 7 + index * 2)
			end
			if tier.Wings then
				local flap = math.sin(st.Clock * (running and 17 or 5) + index * 1.3)
				shoe.Wing.Rotation = -shoe.Side * (6 + flap * 24)
			end
			if flameLevel > 0 then
				local boost = (not onGround or (shoe.Lift or 0) > 0.3) and 1.35 or 0.85
				local len = (flameLevel > 1 and 1.55 or 1.1) * boost * random:NextNumber(0.8, 1.15)
				shoe.Flame.Size = UDim2.fromScale(flameLevel > 1 and 0.8 or 0.62, len)
				if flameLevel > 1 then
					shoe.Core.Size = UDim2.fromScale(0.34, len * 0.55)
				end
			end
		end

		-- Jetpack : le sac devient un réacteur
		if jet ~= st.JetShown then
			st.JetShown = jet
			tint(hero.Pack, jet and JET or PACK)
			tint(hero.Pocket, jet and JET_DARK or PACK_DARK)
			tint(hero.Flap, jet and JET_DARK or PACK_DARK)
			for _, flame in ipairs(hero.Flames) do
				flame.Visible = jet
			end
		end
		if jet then
			for _, flame in ipairs(hero.Flames) do
				flame.Size = UDim2.fromScale(0.3, 0.55 + random:NextNumber() * 0.45)
			end
		end

		-- Aimant : halo qui pulse autour du coureur
		if st.MagnetTime > 0 and running then
			local size = CH * (1.25 + math.sin(st.Clock * 8) * 0.08)
			show(hero.Aura, true)
			hero.Aura.Position = UDim2.fromOffset(heroScreenX, heroY - CH * 0.5)
			hero.Aura.Size = UDim2.fromOffset(size, size)
			hero.AuraStroke.Transparency = st.MagnetTime < 1.5 and ((math.sin(st.Clock * 20) > 0) and 0.2 or 0.8) or 0.2
		else
			show(hero.Aura, false)
		end

		-- Anneau "nouvelles baskets" qui s'élargit autour des pieds
		if st.ShoeFlash > 0 then
			st.ShoeFlash = math.max(0, st.ShoeFlash - dt / 0.8)
			local k = 1 - st.ShoeFlash
			hero.ShoeRing.Visible = st.ShoeFlash > 0
			hero.ShoeRing.Position = UDim2.fromOffset(heroScreenX, groundY)
			hero.ShoeRing.Size = UDim2.fromOffset((18 + 80 * k) * U, (6 + 22 * k) * U)
			hero.ShoeRingStroke.Transparency = k * k
		end

		-- Bulle d'émoji (pop, flotte, disparaît)
		if hero.Emote.Visible then
			st.EmoteT += dt
			local t = st.EmoteT
			if t >= st.EmoteDur then
				hero.Emote.Visible = false
			else
				local scale = 1
				if t < 0.2 then
					scale = 0.3 + 0.7 * math.sin(t / 0.2 * math.pi * 0.5) + 0.25 * math.sin(t / 0.2 * math.pi)
				elseif t > st.EmoteDur - 0.15 then
					scale = (st.EmoteDur - t) / 0.15
				end
				hero.EmoteScale.Scale = math.max(0.05, scale)
				-- à gauche de la tête (les "+1" des pièces montent à droite)
				local sideSign = st.Turn > 0.1 and 1 or -1
				hero.Emote.Position = UDim2.fromOffset(heroScreenX + sideSign * 15 * U, top - 1 * U + math.sin(t * 5) * 1.2 * U)
			end
		end
		-- Étoiles qui tournent autour de la tête quand il est sonné
		local dizzy = not running and st.ModeT > 0.3
		for _, star in ipairs(hero.DizzyStars) do
			if star.Frame.Visible ~= dizzy then
				star.Frame.Visible = dizzy
			end
			if dizzy then
				local angle = st.Clock * 5 + star.Phase
				star.Frame.Position = UDim2.fromOffset(heroScreenX + math.cos(angle) * 12 * U, top + 2 * U + math.sin(angle) * 3.5 * U)
				star.Frame.Rotation = math.deg(angle) * 1.5
			end
		end

		updateFace(dt)

		-- Poussière (et étincelles des baskets) à chaque foulée ; en continu
		-- pendant une glissade
		if running and onGround and not flying then
			local level = math.max(0, st.ShoeLevel)
			if st.SlideT >= 0 then
				st.DustTimer -= dt
				if st.DustTimer <= 0 then
					st.DustTimer = 0.05
					spawnDust(heroScreenX + random:NextNumber(-8, 8) * U, groundY, random:NextNumber(-30, 30) * U, 18 * U, 6 * U, 0.45)
				end
			else
				local step = math.floor(st.RunPhase / math.pi)
				if step ~= st.LastStep then
					st.LastStep = step
					local side = (step % 2 == 0) and -1 or 1
					local size = (4 + level * 0.4) * U
					spawnDust(heroScreenX + side * 6 * U, groundY - 1 * U, side * (12 + level) * U, 14 * U, size, 0.35 + level * 0.012)
					if level >= 3 then
						spawnDust(heroScreenX - side * 3 * U, groundY, -side * 8 * U, 18 * U, size * 0.7, 0.3)
					end
					if tier.Glow then
						spawnDust(heroScreenX + side * 5 * U, groundY, side * 22 * U, 8 * U, size * 0.8, 0.3, tier.Glow)
					end
				end
			end
		end
	end

	------------------------------------------------------------------
	-- Effets (lignes de vitesse, poussière, étincelles, textes)
	------------------------------------------------------------------
	-- Traînée lumineuse des baskets : points posés au sol (ou en l'air) tous
	-- les RIBBON_DZ de défilement, qui se rapprochent de la caméra
	local function updateTrail(fxOn: boolean)
		local on = fxOn and shoeTrail ~= nil and st.Mode == "Run" and st.JetTime <= 0 and st.RunnerH < JUMP_H + 20
		if not on then
			if st.RibbonsShown then
				st.RibbonsShown = false
				for _, ribbon in ipairs(ribbons) do
					for _, segment in ipairs(ribbon.Segments) do
						show(segment, false)
					end
				end
			end
			st.RibbonReset = true
			return
		end
		local trail = shoeTrail
		local reset = st.RibbonReset
		st.RibbonReset = false
		local drop = st.Scroll - st.RibbonDrop >= RIBBON_DZ
		if drop or reset then
			st.RibbonDrop = st.Scroll
		end
		st.RibbonsShown = true
		local footH = math.max(0, st.RunnerH) + 3
		for index, ribbon in ipairs(ribbons) do
			local footX = st.RunnerX + (index == 1 and -7 or 7)
			local points = ribbon.Points
			if reset then
				for k = 0, RIBBON_SEGMENTS do
					local p = points[k]
					p.X, p.H, p.Scroll = footX, footH, st.Scroll
				end
			elseif drop then
				for k = RIBBON_SEGMENTS, 2, -1 do
					local p, q = points[k], points[k - 1]
					p.X, p.H, p.Scroll = q.X, q.H, q.Scroll
				end
				local p1 = points[1]
				p1.X, p1.H, p1.Scroll = footX, footH, st.Scroll
			end
			local p0 = points[0]
			p0.X, p0.H, p0.Scroll = footX, footH, st.Scroll
			for k, segment in ipairs(ribbon.Segments) do
				local a, b = points[k - 1], points[k]
				local za = math.max(0.5, CHAR_Z - (st.Scroll - a.Scroll))
				local zb = math.max(0.5, CHAR_Z - (st.Scroll - b.Scroll))
				local pa = Vector2.new(sx(a.X, za), sy(a.H, za))
				local pb = Vector2.new(sx(b.X, zb), sy(b.H, zb))
				if (pb - pa).Magnitude < 0.8 then
					show(segment, false)
				else
					show(segment, true)
					setLine(segment, pa, pb, math.max(1, trail.Width * U / ((za + zb) / 2)))
				end
			end
		end
	end

	-- Étincelles / plumes / braises qui s'échappent des talons (niveaux 5+)
	local function updateShoeFx(dt: number, fxOn: boolean)
		local tier = shoeTier
		local level = st.ShoeLevel
		if fxOn and st.Mode == "Run" and level >= 5 then
			local rate = level >= 10 and 16 or (level >= 9 and 12 or (level >= 7 and 6 or 3))
			st.ShoeFxTimer -= dt
			if st.ShoeFxTimer <= 0 then
				st.ShoeFxTimer = 1 / rate
				local i = random:NextInteger(1, 2)
				local x, y = heels[i * 2 - 1], heels[i * 2]
				local color, size, vx, vy, life
				if level >= 10 then
					color = (random:NextNumber() < 0.5) and rgb(255, 220, 90) or rgb(255, 110, 30)
					size, vx, vy, life = random:NextNumber(2, 3.5) * U, random:NextNumber(-25, 25) * U, random:NextNumber(20, 60) * U, 0.45
				elseif level >= 9 then
					color = (random:NextNumber() < 0.6) and rgb(170, 226, 255) or WHITE
					size, vx, vy, life = random:NextNumber(2, 3) * U, random:NextNumber(-20, 20) * U, random:NextNumber(30, 60) * U, 0.35
				elseif level >= 7 then
					-- plumes (niveaux 7-8) : tombent en tournoyant
					color = tier.Wings or WHITE
					size, vx, vy, life = random:NextNumber(2.5, 3.5) * U, random:NextNumber(-18, 18) * U, random:NextNumber(10, 26) * U, 0.7
				else
					color = tier.Glow or WHITE
					size, vx, vy, life = random:NextNumber(1.8, 2.8) * U, random:NextNumber(-16, 16) * U, random:NextNumber(12, 30) * U, 0.4
				end
				spawnShoeFx(x, y, color, size, vx, vy, life)
			end
		end
		for _, fx in ipairs(shoeFx) do
			if fx.Life > 0 then
				fx.Life -= dt
				local f = fx.Frame
				if fx.Life <= 0 then
					f.Visible = false
				else
					local t = fx.Life / fx.MaxLife
					fx.X += fx.VX * dt
					fx.Y += fx.VY * dt
					local size = fx.Size * (0.5 + 0.5 * t)
					f.Position = UDim2.fromOffset(fx.X, fx.Y)
					f.Size = UDim2.fromOffset(size, size * (level >= 7 and level <= 8 and 0.55 or 1))
					fx.Rot += fx.Spin * dt
					f.Rotation = fx.Rot
					f.BackgroundTransparency = 1 - t
				end
			end
		end
	end

	-- Pièces qui filent vers le compteur (arc, puis le compteur pulse)
	local function updateFlyers(dt: number)
		for _, flyer in ipairs(flyers) do
			if flyer.T < 1 then
				flyer.T = math.min(1, flyer.T + dt / 0.45)
				local t = flyer.T
				local e = t * t
				local p = flyer.From:Lerp(HUD_COIN, e) - Vector2.new(0, math.sin(t * math.pi) * 16 * U)
				local size = flyer.Size + (13 * U - flyer.Size) * e
				flyer.Frame.Position = UDim2.fromOffset(p.X, p.Y)
				flyer.Frame.Size = UDim2.fromOffset(size, size)
				if t >= 1 then
					flyer.Frame.Visible = false
					st.CoinPulse = 1
				end
			end
		end
	end

	local function updateFx(dt: number, fxOn: boolean)
		local wanted = 0
		if fxOn and st.Mode == "Run" then
			wanted = st.JetTime > 0 and 1 or math.clamp((st.Speed - 4.3) / 0.5, 0, 1) * 0.45
			-- les meilleures baskets donnent une impression de vitesse
			wanted = math.max(wanted, math.max(0, st.ShoeLevel - 4) * 0.055)
		end
		st.LineStrength += (wanted - st.LineStrength) * math.min(1, dt * 3)
		if st.LineStrength > 0.02 then
			st.LinesVisible = true
			for _, line in ipairs(speedLines) do
				line.R += line.Speed * dt * (st.JetTime > 0 and 1.4 or 1)
				if line.R > 210 * U then
					resetSpeedLine(line)
				end
				local length = 8 * U + line.R * 0.3
				local dirX, dirY = math.cos(line.Angle), math.sin(line.Angle)
				local r = line.R + length / 2
				local f = line.Frame
				f.Visible = true
				f.Position = UDim2.fromOffset(CX + dirX * r, HY + dirY * r)
				f.Size = UDim2.fromOffset(length, math.max(1, 1.5 * U))
				f.Rotation = math.deg(line.Angle)
				local appear = math.clamp((line.R - 14 * U) / (30 * U), 0, 1)
				f.BackgroundTransparency = 1 - st.LineStrength * appear * 0.7
			end
		elseif st.LinesVisible then
			st.LinesVisible = false
			for _, line in ipairs(speedLines) do
				line.Frame.Visible = false
			end
		end

		for _, dust in ipairs(dusts) do
			if dust.Life > 0 then
				dust.Life -= dt
				local f = dust.Frame
				if dust.Life <= 0 then
					f.Visible = false
				else
					local t = 1 - dust.Life / dust.MaxLife
					dust.X += dust.VX * dt
					dust.Y += dust.VY * dt
					local size = dust.Size * (0.6 + t * 1.4)
					f.Position = UDim2.fromOffset(dust.X, dust.Y)
					f.Size = UDim2.fromOffset(size, size * 0.8)
					f.BackgroundTransparency = 0.35 + t * 0.65
				end
			end
		end

		for _, sparkle in ipairs(sparkles) do
			if sparkle.Life > 0 then
				sparkle.Life -= dt
				local f = sparkle.Frame
				if sparkle.Life <= 0 then
					f.Visible = false
				else
					sparkle.VY += 140 * U * dt
					sparkle.X += sparkle.VX * dt
					sparkle.Y += sparkle.VY * dt
					local t = sparkle.Life / 0.45
					local size = 6 * U * (0.4 + 0.6 * t)
					f.Position = UDim2.fromOffset(sparkle.X, sparkle.Y)
					f.Size = UDim2.fromOffset(size, size)
					f.Rotation = 45 + (1 - t) * 180
					f.BackgroundTransparency = 1 - t
				end
			end
		end

		for _, pop in ipairs(pops) do
			if pop.Life > 0 then
				pop.Life -= dt
				local label = pop.Label
				if pop.Life <= 0 then
					label.Visible = false
				else
					pop.Y -= pop.Rise * U * dt
					local age = pop.MaxLife - pop.Life
					local grow = 1 + 0.45 * math.clamp(1 - age / 0.15, 0, 1)
					local t = pop.Life < 0.25 and (1 - pop.Life / 0.25) or 0
					label.Position = UDim2.fromOffset(pop.X, pop.Y)
					label.Size = UDim2.fromOffset(pop.W * grow, pop.H * grow)
					label.TextTransparency = t
					pop.Stroke.Transparency = t
				end
			end
		end
	end

	------------------------------------------------------------------
	-- HUD
	------------------------------------------------------------------
	local function setPower(slot, icon: string, color: Color3, ratio: number)
		slot.Pill.Visible = true
		slot.Icon.Text = icon
		slot.Fill.BackgroundColor3 = color
		slot.Fill.Size = UDim2.fromScale(math.clamp(ratio, 0, 1), 1)
	end

	local function updateHud(dt: number)
		if st.Coins ~= st.ShownCoins then
			st.ShownCoins = st.Coins
			hud.CoinLabel.Text = withSpaces(st.Coins)
		end
		local meters = math.floor(st.Distance)
		if meters ~= st.ShownDistance then
			st.ShownDistance = meters
			hud.DistLabel.Text = withSpaces(meters) .. " m"
			-- Record : celui de la session, ou la course en cours si elle le bat
			local best = st.BestBeaten and meters or sessionBest
			if best ~= st.ShownBest then
				st.ShownBest = best
				hud.BestLabel.Visible = best > 0
				hud.BestLabel.Text = Locale.T("BEST") .. " " .. withSpaces(best) .. " m"
			end
		end
		-- Nouveau record en pleine course
		if not st.BestBeaten and sessionBest > 0 and meters > sessionBest and st.Mode == "Run" then
			st.BestBeaten = true
			eventText(Locale.T("NEW BEST!"), rgb(255, 220, 90))
			hud.DistLabel.TextColor3 = rgb(255, 224, 110)
			if hud.DistStroke then
				hud.DistStroke.Color = GOLD
				hud.DistStroke.Transparency = 0.1
			end
		elseif not st.BestBeaten and hud.DistLabel.TextColor3 ~= WHITE then
			hud.DistLabel.TextColor3 = WHITE
			if hud.DistStroke then
				hud.DistStroke.Color = WHITE
				hud.DistStroke.Transparency = 0.6
			end
		end
		if st.CoinPulse > 0 then
			st.CoinPulse = math.max(0, st.CoinPulse - dt * 5)
			hud.CoinScale.Scale = hudBoost * (1 + 0.16 * st.CoinPulse)
		end
		hud.DoubleBadge.Visible = st.DoubleTime > 0
		-- Badge des baskets : rebondit quand le niveau change
		if st.ShoePulse > 0 then
			st.ShoePulse = math.max(0, st.ShoePulse - dt / 0.9)
			local k = 1 - st.ShoePulse
			hud.ShoeScale.Scale = hudBoost * (1 + 0.4 * math.sin(k * math.pi) * (1 - k * 0.5))
		end

		-- Combo (à partir de 5 pièces d'affilée)
		local comboOn = st.Combo >= 5 and st.Clock - st.LastCoin < COMBO_WINDOW + 0.4 and st.Mode == "Run"
		if comboOn then
			hud.ComboPill.Visible = true
			if st.Combo ~= st.ShownCombo then
				st.ShownCombo = st.Combo
				hud.ComboLabel.Text = Locale.T("COMBO x%d", st.Combo)
				hud.ComboLabel.TextColor3 = st.Combo >= 10 and rgb(255, 140, 60) or GOLD
			end
			st.ComboPulse = math.max(0, st.ComboPulse - dt * 4)
			hud.ComboScale.Scale = 1 + 0.18 * st.ComboPulse
		elseif hud.ComboPill.Visible then
			hud.ComboPill.Visible = false
		end

		-- Jauge du bonus en cours (jetpack, sinon aimant, sinon x2 ; le x2 a aussi son badge)
		if st.JetTime > 0 then
			setPower(hud.Power, "🚀", rgb(80, 200, 255), st.JetTime / JET_TIME)
		elseif st.MagnetTime > 0 then
			setPower(hud.Power, "🧲", rgb(255, 90, 170), st.MagnetTime / MAGNET_TIME)
		elseif st.DoubleTime > 0 then
			setPower(hud.Power, "x2", rgb(255, 196, 40), st.DoubleTime / DOUBLE_TIME)
		elseif hud.Power.Pill.Visible then
			hud.Power.Pill.Visible = false
		end
	end

	------------------------------------------------------------------
	-- Téléphone : la carte est très réduite (échelle du slot ~0,4) ; les
	-- pastilles principales (pièces, distance, baskets) sont agrandies pour
	-- rester lisibles, la ligne du dessous (bonus, combo, record) descend
	------------------------------------------------------------------
	local function applyHudBoost()
		if container:GetAttribute("SlotAnimating") then
			return -- apparition "pop" en cours : taille pas encore définitive
		end
		-- échelle réelle à l'écran (toile de l'interface x échelle du slot)
		local scale = screen.AbsoluteSize.X / math.max(1, SW)
		if scale <= 0 then
			return
		end
		local boost = math.clamp(0.55 / scale, 1, 1.3)
		if math.abs(boost - hudBoost) < 0.01 then
			return
		end
		hudBoost = boost
		hud.CoinScale.Scale = boost
		hud.DistScale.Scale = boost
		hud.ShoeScale.Scale = boost
		local row = (6 + 21 * boost + 4) * U -- sous les pastilles agrandies
		hud.Power.Pill.Position = UDim2.fromOffset(6 * U, row)
		hud.BestLabel.Position = UDim2.new(1, -10 * U, 0, row - 3 * U)
		hud.ComboPill.Position = boost > 1.05 and UDim2.new(0.5, 0, 0, row) or UDim2.new(0.5, 0, 0, 6 * U)
		textDrop = boost > 1.05 and 13 * U or 0
	end
	applyHudBoost()

	------------------------------------------------------------------
	-- Boucle principale
	------------------------------------------------------------------
	ctx.OnRender(function(rawDt: number)
		-- Pause quand la carte n'est pas visible (vérifié 2 fois par seconde)
		st.VisibleCheck -= rawDt
		if st.VisibleCheck <= 0 then
			st.VisibleCheck = 0.5
			st.Visible = computeVisible()
			applyHudBoost()
		end
		if not st.Visible then
			return
		end

		local dt = math.clamp(rawDt, 1 / 240, 1 / 20)
		st.Clock += dt
		st.DayTime += dt
		st.ModeT += dt
		st.EventCooldown = math.max(0, st.EventCooldown - dt)
		local fxOn = effectsOn()
		local running = st.Mode == "Run"

		st.LightTimer -= dt
		if st.LightTimer <= 0 then
			st.LightTimer = 0.2
			updateLighting()
		end

		-- Décor d'ambiance : 30 images/s au plus
		st.AmbientT += dt
		if st.AmbientT >= AMBIENT_STEP then
			updateAmbient(st.AmbientT)
			st.AmbientT = 0
		end

		-- Nouvelles baskets achetées pendant que la carte était cachée : fête maintenant
		if st.PendingCelebrate and running then
			st.PendingCelebrate = false
			celebrateShoes()
		end

		-- Vitesse (accélère doucement, plus vite en jetpack et avec de
		-- meilleures baskets, s'arrête après une chute)
		if running then
			st.RunTime += dt
			local shoeBoost = 1 + SHOE_SPEED * math.max(0, st.ShoeLevel)
			local baseSpeed = math.min(MAX_SPEED, BASE_SPEED + st.RunTime * SPEED_RAMP) * shoeBoost
			local wantedSpeed = st.JetTime > 0 and baseSpeed * 1.3 or baseSpeed
			st.Speed += (wantedSpeed - st.Speed) * math.min(1, dt * 2)
		else
			st.Speed += (0 - st.Speed) * math.min(1, dt * 7)
		end
		local move = st.Speed * dt
		st.Scroll += move
		if running then
			st.Distance += move * 6
		end

		-- Bonus
		st.JetTime = math.max(0, st.JetTime - dt)
		st.MagnetTime = math.max(0, st.MagnetTime - dt)
		st.DoubleTime = math.max(0, st.DoubleTime - dt)
		if running and st.JetTime <= 0 and st.MagnetTime <= 0 and not st.PendingPower and not pickup.Active then
			st.PowerTimer -= dt
			if st.PowerTimer <= 0 then
				local roll = random:NextNumber()
				st.PendingPower = (roll < 0.38) and "Magnet" or (roll < 0.72 and "Double" or "Jetpack")
				st.PowerTimer = random:NextNumber(14, 22)
			end
		end
		-- Au bout d'un moment, le coureur finira par rater un obstacle
		if running and not st.CrashPending and st.RunTime > st.RunLength and st.JetTime <= 0 then
			st.CrashPending = true
		end

		-- Nouvelles vagues
		if running then
			st.WaveDistance += move
			if st.WaveDistance >= WAVE_GAP then
				st.WaveDistance -= WAVE_GAP
				spawnWave(Z_FAR)
			end
			-- Pièces dans le ciel pendant le jetpack
			if st.JetTime > 1.6 then
				st.AirDistance += move
				if st.AirDistance >= 0.5 then
					st.AirDistance -= 0.5
					st.AirCount += 1
					if st.AirCount % 5 == 0 then
						st.AirLane = math.clamp(st.AirLane + ((random:NextNumber() < 0.5) and -1 or 1), 1, 3)
					end
					spawnCoin(st.AirLane, Z_FAR, JET_H + 28, true)
				end
			end
		end

		--------------------------------------------------------------
		-- Le coureur : voie, sauts, glissades
		--------------------------------------------------------------
		if running then
			st.WishTimer -= dt
			if st.WishTimer <= 0 then
				st.WishLane = random:NextInteger(1, 3)
				st.WishTimer = random:NextNumber(1.5, 3.5)
			end
			if st.JetTime > 0.9 then
				-- En vol : suit la traînée de pièces
				local nearest: any, nearestZ = nil, math.huge
				for _, coin in ipairs(coinsPool) do
					if coin.Active and coin.Air and coin.Z > CHAR_Z and coin.Z < nearestZ then
						nearest, nearestZ = coin, coin.Z
					end
				end
				if nearest then
					setLane(nearest.Lane)
				end
			elseif math.abs(st.RunnerX - LANES[st.TargetLane]) < 10 then
				chooseLane()
			end
		end

		local previousX = st.RunnerX
		st.RunnerX += (LANES[st.TargetLane] - st.RunnerX) * math.min(1, dt * 11)
		local vx = (st.RunnerX - previousX) / dt
		st.VX = vx
		st.Lean += (math.clamp(vx * 0.06, -15, 15) - st.Lean) * math.min(1, dt * 12)

		-- Sauts / glissades automatiques devant les obstacles
		if running and st.JetTime <= 0 and st.RunnerH < 60 then
			local myLane = nearestLane(st.RunnerX)
			for _, ob in ipairs(obstacles) do
				if ob.Active and not ob.Handled and ob.Lane == myLane then
					local timeTo = (ob.Z - CHAR_Z) / st.Speed
					if timeTo > 0 and timeTo < 0.27 then
						ob.Handled = true
						if st.CrashPending and ob.Kind ~= "High" and st.MagnetTime <= 0 then
							ob.Fatal = true -- raté !
						elseif ob.Kind == "High" then
							st.SlideT = 0
							st.JumpT = -1
						elseif st.JumpT < 0 then
							st.JumpT = 0
							st.SlideT = -1
							-- une figure de temps en temps (vrille, étoile)
							local roll = random:NextNumber()
							st.Trick = (roll < 0.55) and 0 or (roll < 0.8 and 1 or 2)
							st.TrickDir = (random:NextNumber() < 0.5) and -1 or 1
							st.PackV += 0.35
						end
					end
				end
			end
		end
		if st.JumpT >= 0 then
			st.JumpT += dt / JUMP_TIME
			if st.JumpT >= 1 then
				st.JumpT = -1
				st.LandT = 0.16
				st.PackV += 0.55 -- le sac retombe et rebondit
				local x, y = sx(st.RunnerX, CHAR_Z), sy(0, CHAR_Z)
				spawnDust(x - 6 * U, y, -26 * U, 6 * U, 6 * U, 0.4)
				spawnDust(x + 6 * U, y, 26 * U, 6 * U, 6 * U, 0.4)
			end
		end
		if st.SlideT >= 0 then
			st.SlideT += dt / SLIDE_TIME
			if st.SlideT >= 1 then
				st.SlideT = -1
			end
		end
		st.LandT = math.max(0, st.LandT - dt)

		local heightTarget = 0
		if st.JetTime > 0 then
			heightTarget = JET_H
		elseif st.JumpT >= 0 then
			heightTarget = 4 * JUMP_H * st.JumpT * (1 - st.JumpT)
		end
		local slow = st.JetTime > 0 or (st.JumpT < 0 and st.RunnerH > JUMP_H + 8)
		st.RunnerH += (heightTarget - st.RunnerH) * math.min(1, dt * (slow and 4 or 30))

		-- Caméra : suit un peu le coureur (parallaxe)
		camX += (st.RunnerX * 0.42 - camX) * math.min(1, dt * 5)
		if math.abs(camX - st.LastStaticCam) > 0.03 then
			st.LastStaticCam = camX
			updateStatic()
		end

		updateScenery(dt, move)
		updateTrains(dt, move)
		updateObstacles(dt, move)
		updateCoins(dt, move)
		updateHero(dt)
		updateTrail(fxOn)
		updateShoeFx(dt, fxOn)
		updateFx(dt, fxOn)
		updateFlyers(dt)
		updateHud(dt)

		-- Secousse lors d'une chute
		if st.ShakeT > 0 then
			st.ShakeT = math.max(0, st.ShakeT - dt)
			local k = st.ShakeT / 0.35 * 3 * U
			scene.Position = UDim2.fromOffset(random:NextNumber(-k, k), random:NextNumber(-k, k))
		elseif scene.Position ~= UDim2.new() then
			scene.Position = UDim2.new()
		end

		-- Fin de course : résultats, fondu, nouvelle partie
		if st.Mode == "Crash" then
			local t = st.ModeT
			if t >= 1.25 then
				hud.Results.Visible = true
				local k = math.clamp((t - 1.25) / 0.25, 0, 1)
				hud.ResultsScale.Scale = 0.6 + 0.4 * (1 + 2.2 * (k - 1) ^ 3 + 1.2 * (k - 1) ^ 2)
				if st.NewBest then
					hud.ResultsBest.Rotation = math.sin(st.Clock * 6) * 4
				end
				-- bouton "Rejouer" : respire, puis s'enfonce tout seul
				if t < 3.6 then
					hud.ReplayScale.Scale = 1 + 0.05 * math.sin(st.Clock * 7)
				elseif t < 3.75 then
					hud.ReplayScale.Scale = 0.86
				else
					hud.ReplayScale.Scale = 1.06
				end
			end
			if t >= 3.95 then
				st.FadeT = math.clamp((t - 3.95) / 0.3, 0, 1)
				if t >= 4.25 then
					resetRun()
					st.FadeT = 1
				end
			end
		elseif st.FadeT > 0 then
			st.FadeT = math.max(0, st.FadeT - dt / 0.35)
		end
		if st.FadeT > 0 then
			hud.Fade.Visible = true
			hud.Fade.BackgroundTransparency = 1 - st.FadeT
		elseif hud.Fade.Visible then
			hud.Fade.Visible = false
		end
	end)
end

function Runner.Stop(_ctx)
	-- Tout est dans ctx.Container (détruit par le StimulusManager)
end

return Runner
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="164">
          <Properties>
            <string name="Name">Seashell</string>
            <string name="Source"><![CDATA[--[[
	Seashell (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > Seashell

	🐚 Coquillage (gains x1,5, après 1 visite à l'océan) : une coquille
	Saint-Jacques nacrée ouverte (éventail de côtes arrondies rose pêche,
	bord festonné, charnière, lèvre avant) posée sur une petite flaque d'eau
	turquoise ; entre les deux valves, une perle qui brille doucement (halo
	qui respire, reflet, éclat qui passe). Des reflets d'eau ondulent sous la
	coquille et de petites bulles montent vers la surface.
	Calque Background, place donnée par Cosmos/Zones (de préférence en bas,
	« au fond de la mer »). ≤ 20 images/s, ~58 instances, bulles recyclées.
]]

local Cosmos = script.Parent:WaitForChild("Cosmos")
local Kit = require(Cosmos:WaitForChild("Kit"))
local Zones = require(Cosmos:WaitForChild("Zones"))

local Seashell = {}
Seashell.Slot = "Background"

local ID = "Seashell"
local BOX_W, BOX_H = 108, 104
local HINGE_X, HINGE_Y = 54, 74 -- charnière (centre de l'éventail)
local RIB_LENGTH = 52
local RIB_ANGLES = { -56, 56, -28, 28, 0 } -- côtés d'abord, celle du milieu par-dessus
local PEARL_Y = 67
local BUBBLES = 3

function Seashell.Start(ctx)
	Zones.Attach(ctx)
	local random = Random.new()
	local effects = Kit.Effects(ctx)
	local dark = Kit.IsDark(ctx)
	local piece = Kit.Piece(ctx.Container, "Seashell", BOX_W, BOX_H)

	local content: Frame? = nil
	local glows: { Frame } = {}
	local glint: Frame? = nil
	local highlight: Frame? = nil
	local shimmers: { { Frame: Frame, Phase: number, Base: Vector2 } } = {}
	type Bubble = { Frame: Frame, Stroke: UIStroke, P: number, X: number, Speed: number }
	local bubbles: { Bubble } = {}

	local function build()
		if content then
			content:Destroy()
		end
		table.clear(glows)
		table.clear(shimmers)
		table.clear(bubbles)
		local root = Kit.Box(piece.Frame, { Name = "Content", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 })
		content = root
		local outline = if dark then Kit.Rgb(255, 222, 228) else Kit.Rgb(214, 104, 128)
		local outlineAlpha = if dark then 0.45 else 0

		-- Flaque d'eau + reflets
		local pool = Kit.Ellipse(root, HINGE_X, 94, 104, 20, if dark then Kit.Rgb(90, 200, 255) else Kit.Rgb(110, 214, 226), if dark then 0.55 else 0.4, 1)
		pool.Name = "Pool"
		for index, spec in ipairs({ { 26, 93, 20 }, { 74, 97, 28 }, { 50, 90, 14 } }) do
			local line = Kit.Box(root, {
				Name = "Shimmer",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(spec[1], spec[2]),
				Size = UDim2.fromOffset(spec[3], 3),
				Color = Color3.new(1, 1, 1),
				Alpha = 0.4,
				ZIndex = 2,
			})
			Kit.Corner(line)
			table.insert(shimmers, { Frame = line, Phase = index * 2.1, Base = Vector2.new(spec[1], spec[2]) })
		end

		-- Halo nacré de la perle (derrière l'éventail)
		for index, spec in ipairs({ { 96, 0.86 }, { 68, 0.74 } }) do
			local glow = Kit.Circle(root, HINGE_X, PEARL_Y - 8, spec[1], Kit.Rgb(255, 214, 236), spec[2], 2 + index)
			glow.Name = "Glow"
			table.insert(glows, glow)
		end

		-- Éventail : côtes arrondies qui rayonnent depuis la charnière (bord
		-- festonné). Une rotation Roblox tourne autour du CENTRE du cadre :
		-- chaque côte est donc centrée à mi-longueur, dans sa direction.
		for index, angle in ipairs(RIB_ANGLES) do
			local middle = angle == 0
			local length = RIB_LENGTH - math.abs(angle) * 0.06
			local radians = math.rad(angle)
			local rib = Kit.Box(root, {
				Name = "Rib",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(HINGE_X + math.sin(radians) * length / 2, HINGE_Y - math.cos(radians) * length / 2),
				Size = UDim2.fromOffset(if middle then 26 else 24, length),
				Rotation = angle,
				Color = if index % 2 == 0 then Kit.Rgb(255, 176, 186) else Kit.Rgb(255, 204, 186),
				ZIndex = 5,
			})
			Kit.Corner(rib, 12)
			Kit.Gradient(rib, ColorSequence.new(Kit.Rgb(255, 250, 244), Kit.Rgb(236, 226, 232)), nil, 90)
			Kit.Stroke(rib, outline, 1.5, outlineAlpha)
		end
		-- Charnière (oreillettes)
		local hinge = Kit.Box(root, {
			Name = "Hinge",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(HINGE_X, HINGE_Y - 2),
			Size = UDim2.fromOffset(34, 12),
			Color = Kit.Rgb(255, 190, 176),
			ZIndex = 6,
		})
		Kit.Corner(hinge, 5)
		Kit.Stroke(hinge, outline, 1.5, outlineAlpha)

		-- Perle
		local pearl = Kit.Circle(root, HINGE_X, PEARL_Y, 24, Color3.new(1, 1, 1), 0, 7)
		pearl.Name = "Pearl"
		Kit.Gradient(pearl, ColorSequence.new(Color3.new(1, 1, 1), Kit.Rgb(232, 210, 255)), nil, 60)
		if not dark then
			Kit.Stroke(pearl, Kit.Rgb(206, 176, 230), 1, 0)
		end
		highlight = Kit.Circle(root, HINGE_X - 5, PEARL_Y - 6, 7, Color3.new(1, 1, 1), 0, 8)

		-- Lèvre avant (valve du bas, moitié basse d'une ellipse), devant la perle
		local lipClip = Kit.Box(root, {
			Name = "Lip",
			Position = UDim2.fromOffset(HINGE_X - 48, HINGE_Y),
			Size = UDim2.fromOffset(96, 20),
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			ZIndex = 9,
		})
		local lip = Kit.Ellipse(lipClip, 48, 0, 88, 32, Color3.new(1, 1, 1), 0, 9)
		Kit.Gradient(lip, ColorSequence.new(Kit.Rgb(255, 204, 190), Kit.Rgb(240, 138, 156)), nil, 90)
		Kit.Stroke(lip, outline, 1.5, outlineAlpha)

		-- Éclat qui passe sur la perle
		glint = Kit.Glint(root, HINGE_X + 7, PEARL_Y - 8, 14, Color3.new(1, 1, 1), 10)

		-- Bulles
		for _ = 1, BUBBLES do
			local size = random:NextInteger(5, 9)
			local frame = Kit.Box(root, {
				Name = "Bubble",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(size, size),
				Color = Color3.new(1, 1, 1),
				Alpha = 0.75,
				ZIndex = 10,
			})
			Kit.Corner(frame)
			local stroke = Kit.Stroke(frame, if dark then Kit.Rgb(200, 240, 255) else Kit.Rgb(80, 170, 200), 1, 0.2)
			table.insert(bubbles, { Frame = frame, Stroke = stroke, P = random:NextNumber(), X = random:NextNumber(26, 82), Speed = random:NextNumber(0.25, 0.4) })
		end
	end

	build()
	Kit.WatchTheme(ctx, function(isDark)
		dark = isDark
		build()
	end)

	Zones.Request(ID, {
		{ W = BOX_W, H = BOX_H, Anchor = Vector2.new(0.62, 0.97), MinScale = 0.4, MaxScale = 1.15, Gap = 4 },
	}, function(placements)
		Kit.Place(piece, placements[1])
	end)

	Kit.Loop(ctx, 20, function(dt, t)
		if not piece.Placed then
			return
		end
		-- La perle respire
		local breath = 0.5 + 0.5 * math.sin(t * 1.6)
		local outer, inner = glows[1], glows[2]
		if outer and inner then
			outer.BackgroundTransparency = 0.9 - breath * 0.08
			inner.BackgroundTransparency = 0.8 - breath * 0.14
			inner.Size = UDim2.fromOffset(66 + breath * 8, 66 + breath * 8)
		end
		local shine = highlight
		if shine then
			shine.BackgroundTransparency = 0.1 + 0.3 * (1 - breath)
		end
		-- Éclat : passe toutes les ~4 s
		local sparkle = glint
		if sparkle then
			local p = (t % 4) / 4
			local on = if p < 0.12 then math.sin(p / 0.12 * math.pi) else 0
			sparkle.Size = UDim2.fromOffset(4 + on * 14, 4 + on * 14)
			sparkle.Visible = on > 0.02
			sparkle.Rotation = p * 90
		end
		-- Reflets d'eau qui ondulent
		for _, s in ipairs(shimmers) do
			local wave = math.sin(t * 1.2 + s.Phase)
			s.Frame.Position = UDim2.fromOffset(s.Base.X + wave * 5, s.Base.Y)
			s.Frame.BackgroundTransparency = 0.35 + 0.4 * (0.5 + 0.5 * math.sin(t * 2 + s.Phase))
		end
		-- Bulles qui montent en zigzag
		if effects then
			for _, b in ipairs(bubbles) do
				b.P += dt * b.Speed
				if b.P >= 1 then
					b.P -= 1
					b.X = random:NextNumber(26, 82)
				end
				local y = 66 - b.P * 64
				b.Frame.Position = UDim2.fromOffset(b.X + math.sin(b.P * 12) * 3, y)
				local fade = if b.P < 0.15 then 1 - b.P / 0.15 elseif b.P > 0.75 then (b.P - 0.75) / 0.25 else 0
				b.Frame.BackgroundTransparency = 0.75 + fade * 0.25
				b.Stroke.Transparency = 0.2 + fade * 0.8
			end
		end
	end)
end

function Seashell.Stop(_ctx)
	Zones.Release(ID)
end

return Seashell
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="165">
          <Properties>
            <string name="Name">Singularity</string>
            <string name="Source"><![CDATA[--[[
	Singularity (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > Singularity

	🕳️ Singularité (gains x3, après 5 visites à l'océan) : un petit trou noir
	(disque noir, anneau de photons lumineux, halo violet) entouré d'un
	disque d'accrétion orange -> rose -> violet qui tourne (le dégradé
	glisse) ; la moitié avant du disque passe DEVANT le trou, comme sur les
	vraies images. De petites particules tombent en spirale et disparaissent
	dans le trou, des étoiles lointaines s'étirent vers lui, et deux jets
	fins sortent des pôles.
	Calque Background, place donnée par Cosmos/Zones. ≤ 20 images/s,
	~35 instances, particules recyclées.
]]

local Cosmos = script.Parent:WaitForChild("Cosmos")
local Kit = require(Cosmos:WaitForChild("Kit"))
local Zones = require(Cosmos:WaitForChild("Zones"))

local Singularity = {}
Singularity.Slot = "Background"

local ID = "Singularity"
local BOX_W, BOX_H = 112, 90
local CX, CY = 56, 45 -- centre du trou
local DISK_W, DISK_H = 106, 28
local PARTICLES = 12
local STREAKS = 4
local OUTER_R, INNER_R = 58, 20

local DISK_COLORS = {
	0,
	Color3.fromRGB(255, 176, 92),
	0.25,
	Color3.fromRGB(255, 104, 150),
	0.5,
	Color3.fromRGB(176, 96, 255),
	0.75,
	Color3.fromRGB(255, 120, 170),
	1,
	Color3.fromRGB(255, 176, 92),
}

function Singularity.Start(ctx)
	Zones.Attach(ctx)
	local random = Random.new()
	local effects = Kit.Effects(ctx)
	local dark = Kit.IsDark(ctx)
	local piece = Kit.Piece(ctx.Container, "BlackHole", BOX_W, BOX_H)

	local content: Frame? = nil
	local diskGradients: { UIGradient } = {}
	local halo: Frame? = nil
	local ring: UIStroke? = nil
	local jets: { UIGradient } = {}
	type Particle = { Frame: Frame, R: number, A: number, Speed: number }
	local particles: { Particle } = {}
	type Streak = { Frame: Frame, Angle: number, D: number }
	local streaks: { Streak } = {}

	local function spawnParticle(p: Particle, fresh: boolean)
		p.R = if fresh then random:NextNumber(INNER_R + 4, OUTER_R) else OUTER_R + random:NextNumber(0, 6)
		p.A = random:NextNumber(0, math.pi * 2)
		p.Speed = random:NextNumber(0.8, 1.3)
	end

	local function build()
		if content then
			content:Destroy()
		end
		table.clear(diskGradients)
		table.clear(jets)
		table.clear(particles)
		table.clear(streaks)
		local root = Kit.Box(piece.Frame, { Name = "Content", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 })
		content = root
		local diskSequence = Kit.Colors(DISK_COLORS)
		local diskFade = Kit.Fade({ 0, 1, 0.12, 0.35, 0.5, 0.05, 0.88, 0.35, 1, 1 })

		-- Halo violet (lentille gravitationnelle)
		halo = Kit.Circle(root, CX, CY, 92, Kit.Rgb(150, 90, 255), if dark then 0.8 else 0.84, 1)
		-- Jets polaires
		for _, dir in ipairs({ -1, 1 }) do
			local jet = Kit.Box(root, {
				Name = "Jet",
				AnchorPoint = Vector2.new(0.5, if dir < 0 then 1 else 0),
				Position = UDim2.fromOffset(CX, CY),
				Size = UDim2.fromOffset(4, 40),
				Color = Kit.Rgb(170, 220, 255),
				ZIndex = 2,
			})
			table.insert(jets, Kit.Gradient(jet, nil, if dir < 0 then Kit.Fade({ 0, 1, 1, 0.3 }) else Kit.Fade({ 0, 0.3, 1, 1 }), 90))
		end
		-- Disque arrière (derrière le trou)
		local back = Kit.Ellipse(root, CX, CY, DISK_W, DISK_H, Color3.new(1, 1, 1), 0, 3)
		table.insert(diskGradients, Kit.Gradient(back, diskSequence, diskFade, 0))
		-- Anneau de photons + trou
		local photon
		photon, ring = Kit.Ring(root, CX, CY, 44, Kit.Rgb(255, 226, 180), 2.5, 0.05, 5)
		photon.Name = "PhotonRing"
		local hole = Kit.Circle(root, CX, CY, 40, Kit.Rgb(6, 4, 14), 0, 6)
		hole.Name = "Hole"
		-- Disque avant : moitié basse du même disque, devant le trou
		local clip = Kit.Box(root, {
			Name = "FrontDisk",
			Position = UDim2.fromOffset(CX - DISK_W / 2 - 2, CY),
			Size = UDim2.fromOffset(DISK_W + 4, DISK_H / 2 + 2),
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			ZIndex = 8,
		})
		local front = Kit.Ellipse(clip, DISK_W / 2 + 2, 0, DISK_W, DISK_H, Color3.new(1, 1, 1), 0, 8)
		table.insert(diskGradients, Kit.Gradient(front, diskSequence, diskFade, 0))

		-- Particules qui tombent en spirale
		for index = 1, PARTICLES do
			local dot = Kit.Box(root, {
				Name = "Dust",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(3, 3),
				Rotation = 45,
				Color = if index % 3 == 0 then Kit.Rgb(255, 240, 210) elseif index % 3 == 1 then Kit.Rgb(255, 170, 110) else Kit.Rgb(255, 130, 190),
				ZIndex = 4,
			})
			local p: Particle = { Frame = dot, R = 0, A = 0, Speed = 1 }
			spawnParticle(p, true)
			table.insert(particles, p)
		end
		-- Étoiles lointaines étirées vers le trou
		for index = 1, STREAKS do
			local line = Kit.Box(root, {
				Name = "Streak",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(10, 2),
				Color = if dark then Kit.Rgb(230, 220, 255) else Kit.Rgb(140, 110, 230),
				ZIndex = 2,
			})
			table.insert(streaks, { Frame = line, Angle = (index - 1) * math.pi / 2 + 0.6, D = random:NextNumber(0, 1) })
		end
	end

	build()
	Kit.WatchTheme(ctx, function(isDark)
		dark = isDark
		build()
	end)

	Zones.Request(ID, {
		{ W = BOX_W, H = BOX_H, Anchor = Vector2.new(0.78, 0.58), MinScale = 0.4, MaxScale = 1.2, Gap = 4 },
	}, function(placements)
		Kit.Place(piece, placements[1])
	end)

	Kit.Loop(ctx, 20, function(dt, t)
		if not piece.Placed then
			return
		end
		-- Le disque tourne : le dégradé glisse (même phase devant / derrière)
		local offset = Vector2.new(((t * 0.22) % 1) - 0.5, 0)
		for _, gradient in ipairs(diskGradients) do
			gradient.Offset = offset
		end
		local glow = halo
		if glow then
			glow.BackgroundTransparency = (if dark then 0.8 else 0.84) + 0.05 * math.sin(t * 1.7)
		end
		local photon = ring
		if photon then
			photon.Transparency = 0.05 + 0.25 * (0.5 + 0.5 * math.sin(t * 3.1))
		end
		for index, jet in ipairs(jets) do
			jet.Offset = Vector2.new(0, (if index == 1 then 1 else -1) * (0.08 * math.sin(t * 4 + index)))
		end
		-- Particules : spirale vers l'intérieur (plus vite près du trou)
		local steps = if effects then #particles else math.floor(#particles / 2)
		for index = 1, steps do
			local p = particles[index]
			p.A += dt * p.Speed * (1.2 + 60 / p.R)
			p.R -= dt * p.Speed * (6 + 260 / p.R)
			if p.R <= INNER_R then
				spawnParticle(p, false)
			end
			local sin = math.sin(p.A)
			local frame = p.Frame
			frame.Position = UDim2.fromOffset(CX + math.cos(p.A) * p.R, CY + sin * p.R * 0.28)
			-- devant le trou quand la particule est dans la moitié basse du disque
			frame.ZIndex = if sin > 0 then 9 else 4
			frame.BackgroundTransparency = if p.R < INNER_R + 6 then 0.6 else 0
		end
		-- Traînées : glissent vers le trou puis réapparaissent au bord
		for _, s in ipairs(streaks) do
			s.D = (s.D + dt * 0.35) % 1
			local distance = 62 - s.D * 36
			local frame = s.Frame
			frame.Position = UDim2.fromOffset(CX + math.cos(s.Angle) * distance, CY + math.sin(s.Angle) * distance * 0.8)
			frame.Rotation = math.deg(math.atan2(math.sin(s.Angle) * 0.8, math.cos(s.Angle)))
			frame.Size = UDim2.fromOffset(6 + s.D * 12, 2)
			frame.BackgroundTransparency = if s.D < 0.2 then 1 - s.D / 0.2 else 0.2 + (s.D - 0.2) * 0.9
		end
	end)
end

function Singularity.Stop(_ctx)
	Zones.Release(ID)
end

return Singularity
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="166">
          <Properties>
            <string name="Name">SleepMode</string>
            <string name="Source"><![CDATA[--[[
	SleepMode (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > SleepMode

	😴 Mode veille (gains hors-ligne, 5 niveaux, conservé après l'océan) :
	un hublot de nuit (bulle bleu nuit) où dort une lune en croissant (œil
	fermé, joues roses, petit sourire), qui respire doucement ; des « z »
	s'envolent de sa tête et des étoiles scintillent autour.
	Chaque niveau ajoute quelque chose :
	  1 : lune + 4 étoiles + 1 « z »
	  2 : 6 étoiles, « zZ »
	  3 : un nuage-oreiller sous le hublot
	  4 : 9 étoiles, « zzZ », halo de lune plus fort
	  5 : 12 étoiles, bord doré et étoiles filantes
	Calque Background (sous les cartes), place donnée par Cosmos/Zones (de
	préférence en haut à droite ; en fin de partie, dans un espace libre).
	Clair / sombre : couleurs adaptées (reconstruit au changement de thème).
	Animation ≤ 20 images/s, ~50 instances au niveau 5, rien créé par image.
]]

local Cosmos = script.Parent:WaitForChild("Cosmos")
local Kit = require(Cosmos:WaitForChild("Kit"))
local Zones = require(Cosmos:WaitForChild("Zones"))

local SleepMode = {}
SleepMode.Slot = "Background"

local UPGRADE_ID = "SleepMode"
local BOX_W, BOX_H = 112, 130

-- Géométrie (pixels "design" dans la boîte 120 x 130)
local BUBBLE = { X = 56, Y = 76, D = 100 }
local MOON = { X = 50, Y = 78, D = 58 }
local BITE = { X = 70, Y = 64, D = 50 }

-- Étoiles dans le ciel du hublot (hors du croissant) : x, y, taille
local STARS = {
	{ 86, 48, 6 },
	{ 28, 55, 4 },
	{ 96, 72, 5 },
	{ 66, 50, 3 },
	{ 90, 98, 4 },
	{ 40, 36, 4 },
	{ 84, 76, 3 },
	{ 58, 33, 5 },
	{ 16, 78, 3 },
	{ 98, 88, 3 },
	{ 80, 110, 4 },
	{ 74, 39, 3 },
}

local function starCount(level: number): number
	return ({ 4, 6, 6, 9, 12 })[math.clamp(level, 1, 5)]
end

local function zCount(level: number): number
	return if level >= 4 then 3 elseif level >= 2 then 2 else 1
end

function SleepMode.Start(ctx)
	Zones.Attach(ctx)
	local random = Random.new()
	local piece = Kit.Piece(ctx.Container, "SleepMoon", BOX_W, BOX_H)
	local level = math.clamp(ctx.GetLevel(UPGRADE_ID), 1, 5)
	local dark = Kit.IsDark(ctx)

	-- Éléments animés (remplis par build)
	local content: Frame? = nil
	local stars: { { Frame: Frame, Phase: number, Speed: number } } = {}
	local zs: { { Label: TextLabel, Base: number, Offset: number } } = {}
	local moonGroup: Frame? = nil
	local halo: UIStroke? = nil
	local haloBase = 0.8
	local shooting: Frame? = nil
	local shootClock = 0
	local shootNext = 2.5

	local function build()
		if content then
			content:Destroy()
		end
		table.clear(stars)
		table.clear(zs)
		shooting = nil

		local ink = Kit.Ink(dark)
		local root = Kit.Box(piece.Frame, {
			Name = "Content",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
		})
		content = root

		-- Lueur de lune autour du hublot
		Kit.Circle(root, BUBBLE.X, BUBBLE.Y, BUBBLE.D + 8, Kit.Rgb(255, 232, 160), if dark then 0.78 else 0.7, 1)

		-- Hublot de nuit (dégradé bleu nuit -> violet)
		local skyTop = Kit.Rgb(30, 36, 92)
		local skyBottom = Kit.Rgb(72, 48, 132)
		local bubble = Kit.Circle(root, BUBBLE.X, BUBBLE.Y, BUBBLE.D, Color3.new(1, 1, 1), 0, 2)
		Kit.Gradient(bubble, ColorSequence.new(skyTop, skyBottom), nil, 90)
		local rimColor = if level >= 5 then Kit.Rgb(255, 208, 102) elseif dark then Kit.Rgb(196, 186, 255) else Kit.Rgb(150, 136, 226)
		Kit.Stroke(bubble, rimColor, if level >= 5 then 3 else 2, if dark then 0.15 else 0)

		-- Étoiles du hublot
		for index = 1, starCount(level) do
			local spec = STARS[index]
			local star = Kit.Diamond(root, spec[1], spec[2], spec[3], Kit.Rgb(255, 246, 204), 0, 3)
			table.insert(stars, { Frame = star, Phase = random:NextNumber(0, math.pi * 2), Speed = random:NextNumber(1.2, 2.6) })
		end

		-- Étoile filante (niveau 5)
		if level >= 5 then
			local streak = Kit.Box(root, {
				Name = "ShootingStar",
				AnchorPoint = Vector2.new(1, 0.5),
				Size = UDim2.fromOffset(26, 2),
				Rotation = 28,
				Color = Kit.Rgb(255, 250, 225),
				Alpha = 1,
				ZIndex = 3,
			})
			Kit.Gradient(streak, nil, Kit.Fade({ 0, 1, 0.8, 0.2, 1, 0 }), 0)
			shooting = streak
		end

		-- Lune (groupe qui "respire")
		local group = Kit.Box(root, {
			Name = "Moon",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			ZIndex = 4,
		})
		moonGroup = group
		local moon = Kit.Circle(group, MOON.X, MOON.Y, MOON.D, Color3.new(1, 1, 1), 0, 5)
		Kit.Gradient(moon, ColorSequence.new(Kit.Rgb(255, 244, 196), Kit.Rgb(255, 208, 110)), nil, 45)
		-- Lueur le long du croissant (la "morsure" cache la partie intérieure)
		haloBase = if level >= 4 then 0.35 else 0.5
		halo = Kit.Stroke(moon, Kit.Rgb(255, 238, 170), if level >= 4 then 4 else 3, haloBase)
		-- "Morsure" couleur du ciel : même dégradé que le hublot à cette hauteur
		local top = (BITE.Y - BITE.D / 2 - (BUBBLE.Y - BUBBLE.D / 2)) / BUBBLE.D
		local bottom = (BITE.Y + BITE.D / 2 - (BUBBLE.Y - BUBBLE.D / 2)) / BUBBLE.D
		local bite = Kit.Circle(group, BITE.X, BITE.Y, BITE.D, Color3.new(1, 1, 1), 0, 6)
		Kit.Gradient(bite, ColorSequence.new(skyTop:Lerp(skyBottom, top), skyTop:Lerp(skyBottom, bottom)), nil, 90)
		-- Visage endormi (sur la partie épaisse du croissant)
		local face = Kit.Rgb(122, 84, 60)
		Kit.Arc(group, 39, 80, 11, 8, face, 2, 7)
		Kit.Arc(group, 46, 91, 7, 5, face, 1.5, 7)
		Kit.Circle(group, 31, 91, 8, Kit.Rgb(255, 138, 160), 0.35, 7)

		-- Nuage-oreiller (niveau 3+)
		if level >= 3 then
			local cloud = if dark then Kit.Rgb(226, 222, 255) else Color3.new(1, 1, 1)
			for _, spec in ipairs({ { 36, 118, 30 }, { 58, 122, 36 }, { 82, 118, 28 } }) do
				local puff = Kit.Circle(root, spec[1], spec[2], spec[3], cloud, 0, 8)
				if not dark then
					Kit.Stroke(puff, Kit.Rgb(196, 188, 240), 1.5, 0)
				end
			end
		end

		-- « z » qui s'envolent
		local zColor = Kit.Rgb(240, 236, 255)
		for index = 1, zCount(level) do
			local label = Kit.Text(root, if index == 3 then "Z" else "z", 64, 44, 11 + index * 3, zColor, 9)
			local stroke = Instance.new("UIStroke")
			stroke.Color = if dark then Kit.Rgb(60, 48, 120) else ink
			stroke.Thickness = 1.5
			stroke.Parent = label
			label.TextTransparency = 1
			table.insert(zs, { Label = label, Base = 11 + index * 3, Offset = (index - 1) / 3 })
		end
	end

	build()
	Kit.WatchLevel(ctx, UPGRADE_ID, function(newLevel)
		level = math.clamp(newLevel, 1, 5)
		build()
		Kit.Bump(piece)
	end)
	Kit.WatchTheme(ctx, function(isDark)
		dark = isDark
		build()
	end)

	Zones.Request(UPGRADE_ID, {
		{ W = BOX_W, H = BOX_H, Anchor = Vector2.new(0.86, 0.2), MinScale = 0.4, MaxScale = 1.3, Gap = 4 },
	}, function(placements)
		Kit.Place(piece, placements[1])
	end)

	-- Animation (20 images/s)
	local effects = Kit.Effects(ctx)
	Kit.Loop(ctx, 20, function(dt, t)
		if not piece.Placed then
			return
		end
		-- Étoiles qui scintillent
		for _, star in ipairs(stars) do
			star.Frame.BackgroundTransparency = 0.15 + 0.6 * (0.5 + 0.5 * math.sin(t * star.Speed + star.Phase))
		end
		-- Respiration de la lune (bercement lent)
		local group = moonGroup
		if group then
			group.Position = UDim2.fromOffset(0, math.sin(t * 1.3) * 1.6)
		end
		local glow = halo
		if glow then
			glow.Transparency = haloBase + 0.15 * math.sin(t * 1.3)
		end
		-- « z » : montent en diagonale, grossissent, s'effacent
		for _, z in ipairs(zs) do
			local p = (t / 3.6 + z.Offset) % 1
			local label = z.Label
			label.Position = UDim2.fromOffset(60 + p * 48 + math.sin(p * 9) * 3, 46 - p * 42)
			label.TextSize = math.floor(z.Base * (0.75 + 0.45 * p) + 0.5)
			label.Rotation = -12 + math.sin(p * 7) * 10
			label.TextTransparency = if p < 0.15 then 1 - p / 0.15 elseif p > 0.7 then (p - 0.7) / 0.3 else 0
		end
		-- Étoile filante (niveau 5)
		local streak = shooting
		if streak and effects then
			shootClock += dt
			if shootClock >= shootNext then
				local p = (shootClock - shootNext) / 0.7
				if p >= 1 then
					shootClock = 0
					shootNext = random:NextNumber(3.5, 6)
					streak.BackgroundTransparency = 1
				else
					streak.Position = UDim2.fromOffset(34 + p * 52, 40 + p * 26)
					streak.BackgroundTransparency = if p < 0.2 then 1 - p / 0.2 elseif p > 0.7 then (p - 0.7) / 0.3 else 0
				end
			end
		end
	end)
end

function SleepMode.Stop(_ctx)
	Zones.Release(UPGRADE_ID)
end

return SleepMode
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="167">
          <Properties>
            <string name="Name">TimeWarp</string>
            <string name="Source"><![CDATA[--[[
	TimeWarp (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > TimeWarp

	⏳ Distorsion temporelle (gains x2, après 3 visites à l'océan) : une grande
	horloge translucide (cadran crème, bord doré, 12 graduations, aiguilles)
	dont les aiguilles tournent tranquillement... puis s'emballent en
	« vitesse lumière » quelques secondes (aiguilles fantômes qui traînent
	derrière), avant de ralentir. Des ondes du temps s'élargissent autour du
	cadran, et à chaque emballement une grande onde très pâle traverse tout
	le fond de l'écran (visible entre toutes les cartes).
	Calque Background : l'horloge est posée par Cosmos/Zones ; l'onde est un
	simple anneau agrandi (aucune création par image). ≤ 20 images/s.
]]

local Cosmos = script.Parent:WaitForChild("Cosmos")
local Kit = require(Cosmos:WaitForChild("Kit"))
local Zones = require(Cosmos:WaitForChild("Zones"))

local TimeWarp = {}
TimeWarp.Slot = "Background"

local ID = "TimeWarp"
local BOX = 108
local C = BOX / 2 -- centre du cadran
local FACE = 84
local RIPPLES = 3
local WARP_EVERY = 7 -- secondes entre deux emballements
local WARP_TIME = 1.8
local WAVE_TIME = 3.2

function TimeWarp.Start(ctx)
	Zones.Attach(ctx)
	local effects = Kit.Effects(ctx)
	local dark = Kit.IsDark(ctx)
	local piece = Kit.Piece(ctx.Container, "Clock", BOX, BOX)

	-- Grande onde (dans tout le conteneur, derrière l'horloge)
	local wave, waveStroke = Kit.Ring(ctx.Container, 0, 0, 10, Kit.Rgb(255, 214, 140), 2, 1, 1)
	wave.Name = "TimeWave"
	wave.Visible = false

	local content: Frame? = nil
	local hourHand: Frame? = nil
	local minuteHand: Frame? = nil
	local ghosts: { Frame } = {}
	local ghostBars: { Frame } = {}
	local ripples: { { Frame: Frame, Stroke: UIStroke, Offset: number } } = {}
	local face: Frame? = nil

	local function build()
		if content then
			content:Destroy()
		end
		table.clear(ghosts)
		table.clear(ghostBars)
		table.clear(ripples)
		local root = Kit.Box(piece.Frame, { Name = "Content", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 })
		content = root
		local gold = Kit.Rgb(232, 176, 82)
		local handColor = if dark then Kit.Rgb(255, 240, 214) else Kit.Rgb(110, 74, 40)

		-- Ondes du temps autour du cadran
		for index = 1, RIPPLES do
			local ring, stroke = Kit.Ring(root, C, C, FACE, gold, 2, 1, 1)
			ring.Name = "Ripple"
			table.insert(ripples, { Frame = ring, Stroke = stroke, Offset = (index - 1) / RIPPLES })
		end

		-- Cadran translucide
		local dial = Kit.Circle(root, C, C, FACE, Color3.new(1, 1, 1), if dark then 0.45 else 0.3, 2)
		dial.Name = "Face"
		Kit.Gradient(dial, ColorSequence.new(Kit.Rgb(255, 250, 232), Kit.Rgb(255, 222, 170)), nil, 45)
		Kit.Stroke(dial, gold, 3, 0)
		face = dial
		local inner = Kit.Ring(root, C, C, FACE - 18, gold, 1, 0.55, 3)
		inner.Name = "InnerRing"

		-- 12 graduations (4 grandes)
		for hour = 0, 11 do
			local angle = hour * math.pi / 6
			local major = hour % 3 == 0
			local radius = FACE / 2 - (if major then 8 else 6)
			Kit.Box(root, {
				Name = "Tick",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(C + math.sin(angle) * radius, C - math.cos(angle) * radius),
				Size = UDim2.fromOffset(if major then 3 else 2, if major then 9 else 5),
				Rotation = hour * 30,
				Color = if major then gold else handColor,
				Alpha = if major then 0 else 0.35,
				ZIndex = 3,
			})
		end

		-- Aiguille : une rotation Roblox tourne autour du CENTRE du cadre, donc
		-- chaque aiguille est dans un pivot carré centré sur le cadran (c'est
		-- le pivot qui tourne). Renvoie (pivot, aiguille).
		local function hand(name: string, width: number, length: number, color: Color3, alpha: number, z: number, radius: number?): (Frame, Frame)
			local pivot = Kit.Box(root, {
				Name = name,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(C, C),
				Size = UDim2.fromOffset(length * 2, length * 2),
				BackgroundTransparency = 1,
				ZIndex = z,
			})
			local bar = Kit.Box(pivot, {
				Name = "Bar",
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(width, length),
				Color = color,
				Alpha = alpha,
				ZIndex = z,
			})
			if radius then
				Kit.Corner(bar, radius)
			end
			return pivot, bar
		end
		-- Aiguilles fantômes (traînée pendant l'emballement)
		for index = 1, 2 do
			local pivot, bar = hand("Ghost", 3, 34, gold, 1, 4)
			ghosts[index] = pivot
			ghostBars[index] = bar
		end
		-- Aiguilles
		hourHand = hand("HourHand", 5, 23, handColor, 0, 5, 3)
		minuteHand = hand("MinuteHand", 3, 35, handColor, 0, 6, 2)
		Kit.Circle(root, C, C, 9, gold, 0, 7)
	end

	build()
	Kit.WatchTheme(ctx, function(isDark)
		dark = isDark
		build()
	end)

	-- Origine des ondes : l'horloge si elle a une place, sinon le compteur
	local centre: Vector2? = nil
	Zones.Request(ID, {
		{ W = BOX, H = BOX, Anchor = Vector2.new(0.2, 0.56), MinScale = 0.4, MaxScale = 1.15, Gap = 4 },
	}, function(placements)
		local placement = placements[1]
		Kit.Place(piece, placement)
		centre = if placement then Vector2.new(placement.X, placement.Y) else nil
	end)

	local minuteAngle, hourAngle = 40, 300
	local ghostAngles = { 40, 40 }
	local warpClock = 3
	local waveClock = -1
	Kit.Loop(ctx, 20, function(dt, t)
		-- Vitesse des aiguilles : calme, puis emballement (accélère / ralentit)
		warpClock += dt
		local warp = 0
		if warpClock >= WARP_EVERY then
			local p = (warpClock - WARP_EVERY) / WARP_TIME
			if p >= 1 then
				warpClock = 0
			else
				warp = math.sin(p * math.pi)
				if waveClock < 0 and p > 0.3 then
					waveClock = 0
				end
			end
		end
		local speed = 36 + warp * 900 -- degrés / seconde
		minuteAngle = (minuteAngle + speed * dt) % 360
		hourAngle = (hourAngle + speed * dt / 12) % 360
		local minute, hour = minuteHand, hourHand
		if minute and hour then
			minute.Rotation = minuteAngle
			hour.Rotation = hourAngle
		end
		-- Fantômes : suivent l'aiguille avec un retard (visibles pendant l'emballement)
		for index, ghost in ipairs(ghosts) do
			local lag = index * 0.045 * speed
			ghostAngles[index] = minuteAngle - lag
			ghost.Rotation = ghostAngles[index]
			local bar = ghostBars[index]
			if bar then
				bar.BackgroundTransparency = 1 - warp * (if index == 1 then 0.55 else 0.3)
			end
		end
		local dial = face
		if dial then
			dial.Rotation = warp * math.sin(t * 20) * 2
		end
		-- Ondes autour du cadran
		for _, ripple in ipairs(ripples) do
			local p = (t * (0.35 + warp * 0.9) + ripple.Offset) % 1
			local size = FACE + p * (BOX - FACE)
			ripple.Frame.Size = UDim2.fromOffset(size, size)
			ripple.Stroke.Transparency = 0.35 + p * 0.65
		end
		-- Grande onde qui traverse le fond
		if waveClock >= 0 and effects then
			waveClock += dt
			local p = waveClock / WAVE_TIME
			if p >= 1 then
				waveClock = -1
				wave.Visible = false
			else
				local canvas = Zones.GetCanvas()
				local size = 60 + p * canvas.Magnitude * 1.1
				local origin = centre or Zones.GetFocus()
				wave.Visible = true
				wave.Position = UDim2.fromOffset(origin.X, origin.Y)
				wave.Size = UDim2.fromOffset(size, size)
				waveStroke.Thickness = 2 + p * 6
				waveStroke.Transparency = 0.45 + p * 0.55
			end
		end
	end)
end

function TimeWarp.Stop(_ctx)
	Zones.Release(ID)
end

return TimeWarp
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="168">
          <Properties>
            <string name="Name">Weather</string>
            <string name="Source"><![CDATA[--[[
	Weather (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > Weather

	Orage "illustré" :
	  - ambiance (calque Background, sous les cartes des slots) : de gros
	    nuages duveteux faits de nombreuses bouffées rondes superposées
	    (chacune ombrée du haut clair vers le bas plus sombre, reflets
	    blancs, ombre portée), plus de petits nuages lointains, plus pâles,
	    qui dérivent moins vite (parallaxe, qui suit aussi un peu la
	    souris) ; pluie en traits dégradés qui s'écrasent en éclaboussures ;
	  - quand le SERVEUR envoie un Spawn "Lightning" : un nuage d'orage
	    sombre (lueurs internes qui clignotent) apparaît en (X, Y), un éclair
	    ramifié (halo, cœur lumineux, branches plus fines, colonne de
	    lumière) se dessine de haut en bas avec un stroboscope, flash de
	    l'écran et tonnerre ; le nuage d'ambiance le plus proche s'assombrit
	    et s'illumine de l'intérieur.
	Il faut cliquer sur l'éclair avant qu'il ne disparaisse (Lifetime) :
	ClaimSpawn, et le "+X" confirmé (OnBonus "Lightning") s'affiche à
	l'impact.

	v9 - CHASSEUR D'ORAGES (amélioration StormChaser, 8 niveaux, lue avec
	ctx.GetLevel("StormChaser"), mise à jour en direct) : une bande "orage"
	au-dessus du bandeau d'actu (dans la barre du haut de Roblox ; sur le
	bandeau lui-même s'il n'y a pas de barre) :
	  - nuages d'orage avec éclairs silencieux (plus fréquents et plus
	    nombreux à chaque niveau), pluie, petite route ;
	  - la camionnette du chasseur d'orages patrouille, s'arrête pour
	    scanner (radar qui balaie, ondes), fonce vers chaque éclair à
	    attraper et poursuit la tornade ; elle s'équipe au fil des niveaux :
	    radar et antenne (1), gyrophare (2), ondes radar + pluie (3), éclairs
	    de décor plus fréquents (4), TORNADE (5, plus grosse ensuite),
	    anémomètre (6), débris dans la tornade (7), livrée dorée (8) ;
	  - les éclairs à attraper sont plus grands, plus lumineux et plus
	    ramifiés, les nuages d'ambiance plus sombres et agités.
	Aucun son ajouté (les éclairs de décor sont silencieux).
]]

local Debris = game:GetService("Debris")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

local Weather = {}
Weather.Slot = "Overlay"

local Locale = require(game:GetService("ReplicatedStorage").Shared.Locale)

local MAX_BOLTS = 2
local DROPS_PER_CLOUD = 10
local DROPS_LOW_EFFECTS = 4
local SPLASHES_PER_CLOUD = 4
local RAIN_FALL = 74 -- distance de chute des gouttes sous le nuage (pixels "design")

local BOLT_W = 160
local BOLT_H = 244
local BOLT_TOP = 50 -- départ de l'éclair (sous le nuage d'orage)
local BOLT_IMPACT = 206 -- point d'impact dans le cadre de l'éclair
local BOLT_ANCHOR_Y = BOLT_IMPACT / BOLT_H
local STROBE_TIME = 0.45
local CHASER_STEP = 1 / 30 -- mise à jour de la bande "chasseur d'orages"
local VAN_SPEED = 95 -- pixels / seconde (en marche arrière : x 0.6)

-- Formes des nuages : bouffées { x, y, diamètre } de l'arrière vers l'avant,
-- base arrondie { x, y, largeur, hauteur }, reflets { x, y, diamètre }
local SHAPES = {
	Big = {
		W = 156,
		H = 78,
		Puffs = {
			{ 58, 0, 60 },
			{ 26, 16, 46 },
			{ 98, 12, 48 },
			{ 4, 36, 36 },
			{ 124, 32, 32 },
			{ 40, 34, 38 },
			{ 80, 32, 40 },
		},
		Base = { 8, 46, 142, 30 },
		Highlights = { { 70, 6, 26 }, { 36, 22, 16 }, { 106, 18, 16 } },
	},
	Small = {
		W = 96,
		H = 46,
		Puffs = {
			{ 32, 0, 38 },
			{ 12, 12, 28 },
			{ 58, 8, 30 },
			{ 0, 24, 22 },
			{ 72, 22, 22 },
		},
		Base = { 4, 28, 88, 18 },
		Highlights = {},
	},
	Storm = {
		W = 150,
		H = 70,
		Puffs = {
			{ 52, 0, 54 },
			{ 22, 14, 42 },
			{ 90, 10, 46 },
			{ 2, 32, 34 },
			{ 116, 30, 32 },
			{ 40, 28, 40 },
			{ 76, 28, 40 },
		},
		Base = { 6, 42, 138, 28 },
		Highlights = { { 62, 6, 20 }, { 98, 16, 14 } },
	},
}

local TAGS = {
	en = { "⚡ catch it!", "⚡ quick!", "⚡ zap?", "⚡ click!", "⚡ here!" },
	fr = { "⚡ attrape !", "⚡ vite !", "⚡ zap ?", "⚡ clique !", "⚡ ici !" },
}
local CHEERS = {
	en = { "ELECTRIFYING!", "ZAP!", "WHAT REFLEXES!", "SHOCKING!", "JOLT!", "100,000 VOLTS!" },
	fr = { "ÉLECTRISANT !", "ZAP !", "QUEL RÉFLEXE !", "FOUDROYANT !", "CHOC !", "100 000 VOLTS !" },
}

-- Tire une phrase au hasard dans la liste de la langue du joueur
local function pickLine(variants, random: Random): string
	local list = Locale.Pick(variants)
	return list[random:NextInteger(1, #list)]
end

function Weather.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local container: Frame = ctx.Container
	local random = Random.new()

	local white = Color3.new(1, 1, 1)
	local yellow = Theme.Colors.Yellow
	local boltCore = Color3.fromRGB(255, 253, 230)
	local boltEdge = Color3.fromRGB(255, 205, 50)
	local boltGlow = Color3.fromRGB(255, 232, 120)
	local cloudColor = Color3.fromRGB(236, 240, 248)
	local cloudStorm = Color3.fromRGB(128, 136, 158)
	local farColor = Color3.fromRGB(214, 222, 236)
	local stormColor = Color3.fromRGB(84, 90, 114)
	local rainColor = Color3.fromRGB(120, 175, 235)
	local innerLight = Color3.fromRGB(255, 246, 205)

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	local function circle(parent: Instance, x: number, y: number, diameter: number, color: Color3, zIndex: number, transparency: number?): Frame
		local frame = UIUtil.Create("Frame", {
			Size = UDim2.fromOffset(diameter, diameter),
			Position = UDim2.fromOffset(x, y),
			BackgroundColor3 = color,
			BackgroundTransparency = transparency or 0,
			BorderSizePixel = 0,
			ZIndex = zIndex,
			Parent = parent,
		})
		UIUtil.Corner(frame, UDim.new(1, 0))
		return frame
	end

	-- Segment de droite (cadre tourné) entre deux points
	local function line(parent: Instance, a: Vector2, b: Vector2, thickness: number, color: Color3, zIndex: number, transparency: number?): Frame
		local delta = b - a
		local middle = (a + b) / 2
		local frame = UIUtil.Create("Frame", {
			Size = UDim2.fromOffset(delta.Magnitude + thickness * 0.8, thickness),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(middle.X, middle.Y),
			Rotation = math.deg(math.atan2(delta.Y, delta.X)),
			BackgroundColor3 = color,
			BackgroundTransparency = transparency or 0,
			BorderSizePixel = 0,
			ZIndex = zIndex,
			Parent = parent,
		})
		UIUtil.Corner(frame, UDim.new(1, 0))
		return frame
	end

	-- Dégradé vertical "multiplicatif" : haut = couleur de fond, bas plus sombre
	local function shade(parent: Instance, bottom: Color3)
		UIUtil.Create("UIGradient", {
			Rotation = 90,
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, white),
				ColorSequenceKeypoint.new(0.55, white:Lerp(bottom, 0.4)),
				ColorSequenceKeypoint.new(1, bottom),
			}),
			Parent = parent,
		})
	end

	------------------------------------------------------------------
	-- Nuage duveteux
	------------------------------------------------------------------
	local function makeCloud(parent: Instance, shapeName: string, color: Color3, zIndex: number, options: { [string]: any }?)
		local shape = SHAPES[shapeName]
		local opts = options or {}
		local transparency = opts.Transparency or 0
		local bottomTint = opts.Bottom or Color3.fromRGB(176, 184, 204)
		local root = UIUtil.Create("Frame", {
			Name = "Cloud",
			Size = UDim2.fromOffset(shape.W, shape.H),
			BackgroundTransparency = 1,
			ZIndex = zIndex,
			Parent = parent,
		})

		-- Ombre portée (ellipse sombre sous le nuage)
		local shadow: Frame? = nil
		if opts.Shadow then
			local base = shape.Base
			shadow = circle(root, base[1] + 6, base[2] + 10, base[3] - 12, Color3.fromRGB(40, 50, 80), zIndex - 1, 0.82)
			local s = shadow :: Frame
			s.Size = UDim2.fromOffset(base[3] - 12, base[4])
		end

		local puffs: { Frame } = {}
		for _, puff in ipairs(shape.Puffs) do
			local frame = circle(root, puff[1], puff[2], puff[3], color, zIndex, transparency)
			shade(frame, bottomTint)
			table.insert(puffs, frame)
		end
		local base = shape.Base
		local baseFrame = UIUtil.Create("Frame", {
			Size = UDim2.fromOffset(base[3], base[4]),
			Position = UDim2.fromOffset(base[1], base[2]),
			BackgroundColor3 = color,
			BackgroundTransparency = transparency,
			BorderSizePixel = 0,
			ZIndex = zIndex,
			Parent = root,
		})
		UIUtil.Corner(baseFrame, UDim.new(1, 0))
		UIUtil.Create("UIGradient", {
			Rotation = 90,
			Color = ColorSequence.new(white:Lerp(bottomTint, 0.45), bottomTint),
			Parent = baseFrame,
		})
		table.insert(puffs, baseFrame)

		-- Reflets (bords éclairés par le dessus)
		for _, highlight in ipairs(shape.Highlights) do
			local frame = circle(root, highlight[1], highlight[2], highlight[3], white, zIndex + 1, opts.HighlightTransparency or 0.45)
			UIUtil.Create("UIGradient", {
				Rotation = 90,
				Transparency = NumberSequence.new(0, 1),
				Parent = frame,
			})
		end

		-- Lueur interne (orage) : invisible au repos
		local glow: Frame? = nil
		if opts.Glow then
			glow = circle(root, shape.W * 0.22, shape.H * 0.1, shape.W * 0.56, innerLight, zIndex + 2, 1)
			UIUtil.Create("UIGradient", {
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1),
					NumberSequenceKeypoint.new(0.5, 0.1),
					NumberSequenceKeypoint.new(1, 1),
				}),
				Parent = glow,
			})
		end

		return {
			Root = root,
			Shape = shape,
			Puffs = puffs,
			Glow = glow,
			Shadow = shadow,
			Color = color,
			Flash = 0, -- intensité de la lueur interne (0..1)
		}
	end

	local function setCloudColor(cloud, color: Color3)
		if cloud.Color == color then
			return
		end
		cloud.Color = color
		for _, puff in ipairs(cloud.Puffs) do
			puff.BackgroundColor3 = color
		end
	end

	------------------------------------------------------------------
	-- Ambiance : dans le calque Background (sous les cartes des slots) :
	-- les nuages et leur pluie ne cachent jamais la bourse (R1) ni le live
	-- (L1). Les éclairs, cliquables, restent dans ctx.Container (Overlay).
	------------------------------------------------------------------
	local ambientHolder = UIUtil.Create("Frame", {
		Name = "WeatherAmbient",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Active = false,
		ZIndex = 1000, -- au-dessus du fond NeonMode / du thème
		Parent = ctx.Interface.Layers.Background or container,
	})
	-- Détruit avec le conteneur (arrêt du stimulus, détox)
	container.Destroying:Connect(function()
		ambientHolder:Destroy()
	end)

	-- Nuages lointains (petits, pâles, lents)
	local farClouds = {}
	local farRanges = {
		{ Min = 0.1, Max = 0.24, Anchor = 0, Y = 64 },
		{ Min = 0.76, Max = 0.9, Anchor = 1, Y = 56 },
	}
	for index, range in ipairs(farRanges) do
		local cloud = makeCloud(ambientHolder, "Small", farColor, 2, { Transparency = 0.35, Bottom = Color3.fromRGB(190, 198, 216) })
		cloud.Root.AnchorPoint = Vector2.new(range.Anchor, 0)
		cloud.Range = range
		cloud.Phase = random:NextNumber(0, math.pi * 2) + index * 2
		table.insert(farClouds, cloud)
	end

	-- Gros nuages de pluie (à gauche et à droite de la colonne centrale)
	local ambient = {}
	local ranges = {
		{ Min = 0.012, Max = 0.16, Anchor = 0 },
		{ Min = 0.84, Max = 0.988, Anchor = 1 },
	}
	local dropCount = effectsOn() and DROPS_PER_CLOUD or DROPS_LOW_EFFECTS
	for index, range in ipairs(ranges) do
		local cloud = makeCloud(ambientHolder, "Big", cloudColor, 6, { Shadow = true, Glow = true })
		local shape = cloud.Shape
		cloud.Root.AnchorPoint = Vector2.new(range.Anchor, 0)
		cloud.Range = range
		cloud.Phase = random:NextNumber(0, math.pi * 2) + index
		cloud.StormUntil = 0
		cloud.Drops = {}
		cloud.Splashes = {}
		cloud.NextSplash = 1
		for _ = 1, dropCount do
			local drop = UIUtil.Create("Frame", {
				Size = UDim2.fromOffset(2, 13),
				AnchorPoint = Vector2.new(0.5, 1),
				Rotation = 14,
				BackgroundColor3 = rainColor,
				BorderSizePixel = 0,
				ZIndex = 4,
				Parent = cloud.Root,
			})
			UIUtil.Corner(drop, UDim.new(1, 0))
			UIUtil.Create("UIGradient", {
				Rotation = 90,
				Transparency = NumberSequence.new(1, 0.1),
				Parent = drop,
			})
			table.insert(cloud.Drops, {
				Frame = drop,
				X = random:NextNumber(16, shape.W - 16),
				Y = random:NextNumber(0, RAIN_FALL),
				Speed = random:NextNumber(110, 160),
			})
		end
		for _ = 1, SPLASHES_PER_CLOUD do
			local splash = UIUtil.Create("Frame", {
				Size = UDim2.fromOffset(8, 3),
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundTransparency = 1,
				Visible = false,
				ZIndex = 4,
				Parent = cloud.Root,
			})
			UIUtil.Corner(splash, UDim.new(1, 0))
			local stroke = UIUtil.Stroke(splash, rainColor, 1.2, 0.2)
			table.insert(cloud.Splashes, { Frame = splash, Stroke = stroke, Age = 1, Active = false })
		end
		table.insert(ambient, cloud)
	end

	local function splashAt(cloud, x: number)
		local splash = cloud.Splashes[cloud.NextSplash]
		cloud.NextSplash = cloud.NextSplash % #cloud.Splashes + 1
		if not splash then
			return
		end
		splash.Active = true
		splash.Age = 0
		splash.Frame.Position = UDim2.fromOffset(x, cloud.Shape.H - 6 + RAIN_FALL)
		splash.Frame.Visible = true
	end

	-- Niveau de StormChaser (0 = pas acheté) et réaction de la camionnette aux éclairs
	local chaserLevel = 0
	local onBoltSpawned: (x: number) -> () = function(_x: number) end

	------------------------------------------------------------------
	-- Éclairs
	------------------------------------------------------------------
	local bolts: { [string]: any } = {}
	local boltCount = 0
	local positions: { [string]: UDim2 } = {}
	local lastPosition = UDim2.fromScale(0.5, 0.5)

	local function fadeAll(root: Instance, duration: number)
		for _, item in ipairs(root:GetDescendants()) do
			if item:IsA("TextLabel") then
				UIUtil.Tween(item, duration, { TextTransparency = 1, BackgroundTransparency = 1 })
			elseif item:IsA("Frame") then
				UIUtil.Tween(item, duration, { BackgroundTransparency = 1 })
			elseif item:IsA("UIStroke") then
				UIUtil.Tween(item, duration, { Transparency = 1 })
			end
		end
	end

	local function removeBolt(bolt, claimed: boolean)
		if bolt.Done then
			return
		end
		bolt.Done = true
		bolts[bolt.Id] = nil
		boltCount -= 1
		if claimed then
			UIUtil.Tween(bolt.Scale, 0.3, { Scale = 1.3 }, Enum.EasingStyle.Quad)
		else
			UIUtil.Tween(bolt.Scale, 0.35, { Scale = 0.85 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end
		fadeAll(bolt.Root, 0.3)
		Debris:AddItem(bolt.Root, 0.4)
	end

	-- Le nuage d'ambiance le plus proche devient orageux et s'illumine
	local function stormNearestCloud(x: number)
		local best, bestDistance = nil, math.huge
		for _, cloud in ipairs(ambient) do
			local center = (cloud.Range.Min + cloud.Range.Max) / 2
			local distance = math.abs(center - x)
			if distance < bestDistance then
				best, bestDistance = cloud, distance
			end
		end
		if best then
			best.StormUntil = os.clock() + 1.6
			best.Flash = 1
		end
	end

	local function spawnBolt(info)
		if not ctx.IsAlive() or type(info) ~= "table" or type(info.Id) ~= "string" then
			return
		end
		if bolts[info.Id] or boltCount >= MAX_BOLTS then
			return
		end
		local x = math.clamp(tonumber(info.X) or 0.5, 0.06, 0.94)
		local y = math.clamp(tonumber(info.Y) or 0.5, 0.1, 0.92)
		local lifetime = math.max(1, tonumber(info.Lifetime) or 2.5)
		local variant = math.floor(tonumber(info.Variant) or 1)
		local shape = Random.new(variant) -- forme déterministe selon la variante

		-- Décalage pour que le nuage ne sorte pas par le haut
		local extra = math.max(0, BOLT_IMPACT + 34 - y * 720)
		local position = UDim2.new(x, 0, y, extra)

		local root = UIUtil.Create("TextButton", {
			Name = "Lightning",
			Size = UDim2.fromOffset(BOLT_W, BOLT_H),
			AnchorPoint = Vector2.new(0.5, BOLT_ANCHOR_Y),
			Position = position,
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Text = "",
			ZIndex = 30,
			Parent = container,
		})
		local scale = UIUtil.Create("UIScale", { Scale = 0.7, Parent = root })
		-- StormChaser : éclairs plus grands
		UIUtil.Tween(scale, 0.25, { Scale = 1 + 0.04 * chaserLevel }, Enum.EasingStyle.Back)

		-- Colonne de lumière derrière l'éclair
		local shaft = UIUtil.Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromOffset(BOLT_W / 2, BOLT_TOP - 10),
			Size = UDim2.fromOffset(70, BOLT_IMPACT - BOLT_TOP + 30),
			BackgroundColor3 = boltGlow,
			BackgroundTransparency = 0.8,
			BorderSizePixel = 0,
			ZIndex = 30,
			Parent = root,
		})
		UIUtil.Create("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.5, 0.3),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = shaft,
		})

		-- Points du zigzag principal
		local points = {}
		local steps = 8
		local side = (variant % 2 == 0) and 1 or -1
		for i = 0, steps do
			local py = BOLT_TOP + (BOLT_IMPACT - BOLT_TOP) * i / steps + (i > 0 and i < steps and shape:NextNumber(-4, 4) or 0)
			local px = BOLT_W / 2
			if i > 0 and i < steps then
				side = -side
				px += side * shape:NextNumber(6, 22)
			elseif i == steps then
				px += shape:NextNumber(-6, 6)
			end
			table.insert(points, Vector2.new(math.clamp(px, 20, BOLT_W - 20), py))
		end

		-- Segments : halo large + cœur lumineux (contour doré), révélés par groupe
		local groups: { { Frame } } = {}
		local cores: { Frame } = {}
		local glows: { Frame } = {}
		local function addSegment(group: { Frame }, a: Vector2, b: Vector2, width: number)
			local glow = line(root, a, b, width + 12, boltGlow, 31, 0.78)
			local core = line(root, a, b, width, boltCore, 33)
			UIUtil.Stroke(core, boltEdge, width >= 4 and 1.5 or 1, 0)
			glow.Visible, core.Visible = false, false
			table.insert(group, glow)
			table.insert(group, core)
			table.insert(cores, core)
			table.insert(glows, glow)
		end
		for i = 1, #points - 1 do
			local group = {}
			local width = 6 - (i / #points) * 2 -- plus fin vers le bas
			addSegment(group, points[i], points[i + 1], width)
			table.insert(groups, group)
		end
		-- Deux branches plus fines
		local branchFrom = { 2 + shape:NextInteger(0, 1), 4 + shape:NextInteger(0, 1) }
		-- StormChaser : éclairs plus ramifiés
		if chaserLevel >= 3 then
			table.insert(branchFrom, 6 + shape:NextInteger(0, 1))
		end
		if chaserLevel >= 6 then
			table.insert(branchFrom, 3)
		end
		for _, index in ipairs(branchFrom) do
			local from = points[index]
			local group = groups[index] or groups[#groups]
			local dir = (from.X >= BOLT_W / 2) and 1 or -1
			local mid = from + Vector2.new(dir * shape:NextNumber(18, 30), shape:NextNumber(14, 24))
			local tip = mid + Vector2.new(dir * shape:NextNumber(6, 16), shape:NextNumber(12, 20))
			addSegment(group, from, mid, 3)
			addSegment(group, mid, tip, 2)
		end

		-- Nuage d'orage sombre au sommet (lueurs internes)
		local storm = makeCloud(root, "Storm", stormColor, 36, {
			Glow = true,
			Bottom = Color3.fromRGB(120, 124, 140),
			HighlightTransparency = 0.8,
		})
		storm.Root.Position = UDim2.fromOffset((BOLT_W - storm.Shape.W) / 2, 0)

		-- Impact : halo + anneau qui pulse + trace au sol
		local impact = points[#points]
		local scorch = circle(root, impact.X - 20, impact.Y - 4, 40, Color3.fromRGB(60, 40, 10), 30, 0.7)
		scorch.Size = UDim2.fromOffset(40, 9)
		local impactGlow = circle(root, impact.X - 26, impact.Y - 26, 52, boltGlow, 32, 0.5)
		UIUtil.Create("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.5, 0),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = impactGlow,
		})
		local ring = UIUtil.Create("Frame", {
			Size = UDim2.fromOffset(64, 64),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(impact.X, impact.Y),
			BackgroundTransparency = 1,
			ZIndex = 32,
			Parent = root,
		})
		UIUtil.Corner(ring, UDim.new(1, 0))
		local ringStroke = UIUtil.Stroke(ring, yellow, 3, 0.1)
		local ringScale = UIUtil.Create("UIScale", { Parent = ring })

		-- Étiquette
		local tag = UIUtil.Label({
			Text = pickLine(TAGS, random),
			Font = Theme.Fonts.Title,
			TextColor3 = Theme.Colors.TextDark,
			BackgroundColor3 = yellow,
			BackgroundTransparency = 0,
			Size = UDim2.fromOffset(92, 22),
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromOffset(BOLT_W / 2, BOLT_IMPACT + 12),
			MaxTextSize = 15,
			ZIndex = 38,
			Parent = root,
		})
		UIUtil.Corner(tag, UDim.new(1, 0))
		UIUtil.Stroke(tag, Theme.Colors.Border, 1.5, 0.1)

		local bolt = {
			Id = info.Id,
			Root = root,
			Scale = scale,
			Cores = cores,
			Glows = glows,
			Shaft = shaft,
			ImpactGlow = impactGlow,
			RingScale = ringScale,
			RingStroke = ringStroke,
			Storm = storm,
			Base = position,
			Born = os.clock(),
			Lifetime = lifetime,
			Done = false,
		}
		bolts[info.Id] = bolt
		boltCount += 1

		-- Frappe : le zigzag se dessine de haut en bas (très vite)
		task.spawn(function()
			for _, group in ipairs(groups) do
				if bolt.Done or not root.Parent then
					return
				end
				for _, frame in ipairs(group) do
					frame.Visible = true
				end
				task.wait(0.015)
			end
		end)

		ctx.Sound.Play("Thunder", 0.8 + random:NextNumber() * 0.2)
		if effectsOn() then
			ctx.Effects.Flash(Color3.fromRGB(255, 250, 225), 0.32)
			task.delay(0.14, function()
				if ctx.IsAlive() then
					ctx.Effects.Flash(Color3.fromRGB(230, 240, 255), 0.18)
				end
			end)
		end
		storm.Flash = 1
		stormNearestCloud(x)
		onBoltSpawned(x)

		-- Clic : on attrape l'éclair
		ctx.Connect(root.Activated, function()
			if bolt.Done or not ctx.IsAlive() then
				return
			end
			local impactPosition = UDim2.new(x, 0, y, extra)
			positions[bolt.Id] = impactPosition
			lastPosition = impactPosition
			ctx.ClaimSpawn(bolt.Id)
			ctx.Sound.Play("Thunder", 1.5)
			if effectsOn() then
				ctx.Effects.Burst(container, impactPosition, yellow, 18)
				ctx.Effects.Burst(container, impactPosition, nil, 8)
			end
			removeBolt(bolt, true)
			local id = bolt.Id
			task.delay(6, function()
				positions[id] = nil
			end)
		end)
	end

	-- Lueur interne d'un nuage : éclairs aléatoires qui retombent
	local function updateGlow(cloud, dt: number, chance: number)
		if cloud.Glow == nil then
			return
		end
		if chance > 0 and random:NextNumber() < chance * dt then
			cloud.Flash = random:NextNumber(0.5, 1)
		end
		cloud.Flash = math.max(0, cloud.Flash - dt * 4)
		cloud.Glow.BackgroundTransparency = 1 - cloud.Flash * 0.85
	end

	------------------------------------------------------------------
	-- v9 : CHASSEUR D'ORAGES (StormChaser). Tout est créé une fois ; le
	-- niveau ne fait qu'afficher / cacher / agrandir des éléments.
	------------------------------------------------------------------
	local chaser = UIUtil.Create("Frame", {
		Name = "StormChaser",
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 5,
		Parent = container,
	})
	local stripHeight = 60
	local roadY = 58
	local canvasWidth = 1280
	local refreshSizes: () -> () = function() end -- (définie plus bas : tailles selon la bande et le niveau)

	-- Bande dans la barre du haut de Roblox (au-dessus de la zone sûre), ou
	-- sur le bandeau d'actu s'il n'y a pas de barre
	local function layoutStrip()
		local canvas = ctx.Interface.CanvasSize or Vector2.new(1280, 720)
		canvasWidth = canvas.X
		local scale = math.max(0.01, ctx.Interface.Scale or 1)
		local inset = 0
		pcall(function()
			local topLeft = GuiService:GetGuiInset()
			inset = topLeft.Y / scale
		end)
		if inset >= 34 then
			stripHeight = math.min(inset, 110)
			chaser.Position = UDim2.fromOffset(0, -stripHeight)
		else
			stripHeight = 40
			chaser.Position = UDim2.fromOffset(0, 0)
		end
		-- v9.1 (téléphone) : la bande ne passe pas sous les boutons Roblox de la barre du haut
		local left, right = 0, 0
		local tickerInsets = (ctx.Interface :: any).TickerInsets
		if type(tickerInsets) == "table" then
			left = tonumber(tickerInsets.Left) or 0
			right = tonumber(tickerInsets.Right) or 0
		end
		chaser.Position = UDim2.fromOffset(left, chaser.Position.Y.Offset)
		chaser.Size = UDim2.new(1, -(left + right), 0, stripHeight)
		roadY = stripHeight - 2
		refreshSizes()
	end
	layoutStrip()
	ctx.Connect(ctx.Interface.ScaleChanged, layoutStrip)

	local function box(props: { [string]: any }): Frame
		props.BorderSizePixel = 0
		return UIUtil.Create("Frame", props)
	end

	-- Lueur de la bande quand un éclair de décor frappe
	local skyFlash = box({
		Name = "SkyFlash",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(214, 226, 255),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = chaser,
	})
	local skyFlashLevel = 0

	-- Route (tirets jaunes)
	local road = box({
		Name = "Road",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 3),
		BackgroundColor3 = Color3.fromRGB(52, 54, 72),
		BackgroundTransparency = 0.1,
		ZIndex = 6,
		Parent = chaser,
	})
	for index = 1, 18 do
		box({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(index / 19, 0.5),
			Size = UDim2.fromOffset(9, 1),
			BackgroundColor3 = Color3.fromRGB(255, 212, 80),
			BackgroundTransparency = 0.15,
			ZIndex = 6,
			Parent = road,
		})
	end

	-- Nuages d'orage de la bande (plus nombreux avec le niveau)
	local STRIP_CLOUDS = { { X = 0.26, Level = 1 }, { X = 0.63, Level = 1 }, { X = 0.45, Level = 3 }, { X = 0.8, Level = 5 } }
	local stripClouds = {}
	for _, def in ipairs(STRIP_CLOUDS) do
		local cloud = makeCloud(chaser, "Storm", Color3.fromRGB(150, 158, 186), 7, {
			Glow = true,
			Bottom = Color3.fromRGB(96, 102, 130),
			HighlightTransparency = 0.6,
		})
		cloud.Root.AnchorPoint = Vector2.new(0.5, 0)
		cloud.Root.Visible = false
		cloud.Scaler = UIUtil.Create("UIScale", { Scale = 0.5, Parent = cloud.Root })
		cloud.Def = def
		cloud.Phase = random:NextNumber(0, math.pi * 2)
		cloud.X = def.X
		table.insert(stripClouds, cloud)
	end

	-- Pluie de la bande
	local stripRain = {}
	for index = 1, 14 do
		local drop = box({
			Name = "Drop",
			AnchorPoint = Vector2.new(0.5, 1),
			Size = UDim2.fromOffset(1.5, 7),

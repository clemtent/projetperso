	phase.Position = UDim2.new(0, 14, 0.46, 0)
	phase.Size = UDim2.new(1, -28, 0.26, 0)
	phase.Font = Enum.Font.GothamBold
	phase.TextScaled = true
	phase.TextColor3 = Color3.fromRGB(90, 60, 110)

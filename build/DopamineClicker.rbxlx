	{ "Furniture", 13, 58, furnitureZone, {} },
	{ "Garden", 42, 57, gardenZone, {} },
}

-- Clients qui poussent leur chariot (parcours fermés dans les allées)
local function shoppers(m: Market, parent: Instance, jobs: { () -> () })
	local routes = {
		{ { -20, 17.5 }, { -20, 45.5 }, { -12, 45.5 }, { -12, 17.5 } },
		{ { -36, 17.5 }, { 20.3, 17.5 }, { 20.3, 45.5 }, { -36, 45.5 } },
		{ { -44, 47 }, { 28, 47 }, { 28, 49.5 }, { -44, 49.5 } },
		{ { 35, 21 }, { 43.5, 21 }, { 43.5, 43 }, { 35, 43 } },
	}
	for i, route in ipairs(routes) do
		table.insert(jobs, function()
			shopper(m, parent, "full", 100 + i * 11, route, 2.4 + (i % 3) * 0.4)
		end)
	end
end

local function fullJobs(m: Market, parent: Instance): { () -> () }
	local jobs: { () -> () } = {}
	table.insert(jobs, function()
		shell(m, parent)
	end)
	for g = 1, #GONDOLA_X do
		table.insert(jobs, function()
			gondola(m, parent, g)
		end)
	end
	table.insert(jobs, function()
		priceTags(m, parent)
		aisleSigns(m, parent)
	end)
	for i = 1, #LANES do
		table.insert(jobs, function()
			Checkout().Lane(m, parent, i)
		end)
	end
	table.insert(jobs, function()
		Checkout().SelfCheckout(m, parent)
	end)
	table.insert(jobs, function()
		-- (v9.9) horloge de gare à deux faces au-dessus des caisses
		local H = m.Size.Y
		local at = m.F * CFrame.new(30.5, 10.4, 9.25)
		V99.addClock(m, parent, "full", at, 2.4, { Style = "Station", Numerals = "Arabic", Brand = "MegaDopa", MaxDistance = 160, Name = "StationClock" })
		box(parent, "ClockRod", at, -0.05, 0.05, 1.9, H - 10.4 - 0.4, 0.14, 0.24, DARKSTEEL, M.Metal)
	end)
	table.insert(jobs, function()
		entrance(m, parent)
	end)
	table.insert(jobs, function()
		robuxShell(m, parent)
	end)
	table.insert(jobs, function()
		cafeShell(m, parent)
	end)
	table.insert(jobs, function()
		produce(m, parent)
	end)
	table.insert(jobs, function()
		bakery(m, parent)
	end)
	table.insert(jobs, function()
		fridges(m, parent)
	end)
	table.insert(jobs, function()
		showroom(m, parent)
	end)
	table.insert(jobs, function()
		furnitureRooms(m, parent)
	end)
	table.insert(jobs, function()
		gardenDecor(m, parent)
	end)
	shoppers(m, parent, jobs)
	return jobs
end

----------------------------------------------------------------------
-- Construction par niveaux et par zones / destruction
----------------------------------------------------------------------

local function newBuilder(name: string): Builder
	return { Name = name, Folder = nil, Jobs = nil, Index = 1, Built = false }
end

local function startBuilder(b: Builder, parent: Instance, name: string, make: (Instance) -> { () -> () })
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	b.Folder = f
	b.Built = false
	b.Index = 1
	b.Jobs = make(f)
end

local function stopBuilder(b: Builder)
	if b.Folder then
		b.Folder:Destroy()
	end
	b.Folder = nil
	b.Jobs = nil
	b.Index = 1
	b.Built = false
end

-- Retire des listes tout ce qui appartient à `owner` (zone, "full", "outside")
local function purge(m: Market, owner: string)
	local function keep<T>(list: { T }, drop: ((T) -> ())?): { T }
		local out = {}
		for _, x in ipairs(list) do
			if (x :: any).Owner == owner then
				if drop then
					drop(x)
				end
			else
				table.insert(out, x)
			end
		end
		return out
	end
	m.Displays = keep(m.Displays)
	m.Actors = keep(m.Actors)
	m.Belts = keep(m.Belts)
	for _, belt in ipairs(m.Belts) do
		if belt.Cashier and belt.Cashier.Owner == owner then
			belt.Cashier = nil
		end
		belt.Customers = keep(belt.Customers)
	end
	local mm: any = m
	mm.Kiosks = keep(mm.Kiosks)
	mm.Clocks = keep(mm.Clocks)
	mm.Dates = keep(mm.Dates)
	for _, k in ipairs(mm.Kiosks) do
		if k.Customer and k.Customer.Owner == owner then
			k.Customer = nil
		end
	end
	m.Spinners = keep(m.Spinners)
	m.Robux = keep(m.Robux)
	m.Boards = keep(m.Boards, function(b: Board)
		b.Gui:Destroy()
	end)
end

local function recount()
	local parts, labels = 0, 0
	if folder then
		for _, x in ipairs(folder:GetDescendants()) do
			if x:IsA("BasePart") then
				parts += 1
			elseif x:IsA("SurfaceGui") and x.Name == "Print" then
				labels += 1
			end
		end
	end
	partCount, labelCount = parts, labels
	stats.Parts, stats.Labels = parts, labels
end

local function setBands(m: Market, zone: Zone, visible: boolean)
	for _, key in ipairs(zone.Hide) do
		for _, p in ipairs(m.Bands[key :: any] or {}) do
			if p.Parent then
				p.Transparency = visible and 0 or 1
			end
		end
	end
end

local function destroyZone(m: Market, zone: Zone)
	if not zone.B.Folder then
		return
	end
	purge(m, zone.Name)
	stopBuilder(zone.B)
	setBands(m, zone, true)
	stats.Destroyed += 1
end

local function destroyFull(m: Market)
	for _, zone in ipairs(m.Zones) do
		destroyZone(m, zone)
	end
	if m.Full.Folder then
		purge(m, "full")
		stopBuilder(m.Full)
		table.clear(m.Lights)
		table.clear(m.Checkouts)
		table.clear(m.Bands)
		table.clear(m.TVs)
		table.clear(cafeSeats)
		m.LightsOn = false
		local mm: any = m
		if mm.Night and mm.NightParent and mm.NightParent.Parent then
			mm.Night.Parent = mm.NightParent
		end
		stats.Destroyed += 1
		recount()
	end
end

local function destroyOutside(m: Market)
	if m.Outside.Folder then
		purge(m, "outside")
		local mm: any = m
		if mm.Night then
			mm.Night:Destroy()
		end
		mm.Night, mm.NightParent = nil, nil
		stopBuilder(m.Outside)
		stats.Destroyed += 1
		recount()
	end
end

local function updateLevel(m: Market)
	m.Level = (m.Full.Built and 2) or (m.Outside.Built and 1) or 0
	local tiers = (m :: any).Tiers
	tiers[1] = m.Outside.Folder
	tiers[2] = m.Full.Folder
end

----------------------------------------------------------------------
-- Portes coulissantes
----------------------------------------------------------------------

local function stepDoors(m: Market, positions: { Vector3 })
	local door = m.DoorCF.Position
	local near = false
	for _, p in ipairs(positions) do
		if (p - door).Magnitude < DOOR_RANGE then
			near = true
			break
		end
	end
	for _, d in ipairs(m.Doors) do
		if d.IsOpen ~= near then
			d.IsOpen = near
			local goal = near and d.Open or d.Closed
			local ok = pcall(function()
				TweenService:Create(d.Part, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = goal }):Play()
			end)
			if not ok then
				d.Part.CFrame = goal
			end
		end
	end
end

----------------------------------------------------------------------
-- Boucle
----------------------------------------------------------------------

local function characterPositions(): { Vector3 }
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			table.insert(list, root.Position)
		end
	end
	return list
end

local function localPosition(): Vector3?
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root.Position
	end
	return focus
end

local function flatDistance(a: Vector3, b: Vector3): number
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

-- Distance (à plat) au bâtiment (avec le parking si `withLot`) ; 0 dedans
local function boxDistance(m: Market, p: Vector3, withLot: boolean): number
	local rel = m.MCF:PointToObjectSpace(p)
	local hw = m.Size.X / 2 + 1
	local z0, z1 = withLot and -52 or 0, m.Size.Z + 2
	local dx = math.max(math.abs(rel.X) - hw, 0)
	local dz = rel.Z < z0 and z0 - rel.Z or (rel.Z > z1 and rel.Z - z1 or 0)
	return math.sqrt(dx * dx + dz * dz)
end

-- Dans le magasin (boîte intérieure, un peu élargie) ?
local function inside(m: Market, p: Vector3): boolean
	local rel = m.InteriorCF:PointToObjectSpace(p)
	local s = m.Size
	return math.abs(rel.X) < s.X / 2 + 0.5 and math.abs(rel.Z) < s.Z / 2 + 0.5 and rel.Y > -2 and rel.Y < s.Y + 2
end

-- Étiquettes : seulement dans le magasin, les MAX_TAGS plus proches (v9.6.1)
local function updateTags(m: Market, position: Vector3)
	local here = inside(m, position)
	local candidates: { { d: Display, dist: number } } = {}
	for _, d in ipairs(m.Displays) do
		local bb = d.Billboard
		if bb and bb.Parent and d.Tag then
			local dist = (d.Tag.Position - position).Magnitude
			if here and dist <= TAG_DISTANCE then
				table.insert(candidates, { d = d, dist = dist })
			else
				bb.Enabled = false
			end
		end
	end
	table.sort(candidates, function(a, b)
		return a.dist < b.dist
	end)
	for i, c in ipairs(candidates) do
		(c.d.Billboard :: BillboardGui).Enabled = i <= MAX_TAGS
	end
end

local function zoneCenter(m: Market, zone: Zone): Vector3
	return (m.F * CFrame.new(zone.X, 0, zone.Z)).Position
end

local function decide(m: Market, position: Vector3)
	local dOut = boxDistance(m, position, true)
	local dIn = boxDistance(m, position, false)
	local target = 0
	if dIn <= FULL_RANGE or (m.Full.Folder ~= nil and dIn <= FULL_DROP) then
		target = 2
	elseif dOut <= OUT_RANGE or (m.Outside.Folder ~= nil and dOut <= OUT_DROP) then
		target = 1
	end
	if target < 2 and m.Full.Folder then
		destroyFull(m)
	end
	if target < 1 and m.Outside.Folder then
		destroyOutside(m)
	end
	local root = folder :: Folder
	if target >= 1 and not m.Outside.Folder then
		startBuilder(m.Outside, root, "Market_Outside", function(f)
			return outsideJobs(m, f)
		end)
	end
	if target >= 2 and m.Outside.Built and not m.Full.Folder then
		startBuilder(m.Full, root, "Market_Full", function(f)
			return fullJobs(m, f)
		end)
	end
	-- détail par zone : dedans (ou sur le seuil), près de la zone
	local here = inside(m, position) or dIn <= 3
	if m.Full.Built and m.Full.Folder then
		for _, zone in ipairs(m.Zones) do
			local d = flatDistance(position, zoneCenter(m, zone))
			local want = here and (d <= ZONE_RANGE or (zone.B.Folder ~= nil and d <= ZONE_DROP))
			if want and not zone.B.Folder then
				startBuilder(zone.B, m.Full.Folder :: Folder, "Zone_" .. zone.Name, function(f)
					local jobs = {}
					zone.Build(m, f, jobs)
					return jobs
				end)
			elseif not want and zone.B.Folder then
				destroyZone(m, zone)
			end
		end
		-- zones les plus proches construites d'abord
		table.sort(m.Zones, function(a, b)
			return flatDistance(position, zoneCenter(m, a)) < flatDistance(position, zoneCenter(m, b))
		end)
	end
	-- (v9.9) vraies lumières allumées dès qu'on s'approche (≤ 20 studs du
	-- bâtiment), pas seulement une fois dedans : le magasin est éclairé avant d'entrer
	local on = m.Full.Folder ~= nil and (inside(m, position) or dIn <= 20)
	if on ~= m.LightsOn then
		m.LightsOn = on
		for _, light in ipairs(m.Lights) do
			light.Enabled = on
		end
	end
	updateLevel(m)
end

local function runJobs(m: Market): boolean
	local t0 = os.clock()
	local order: { Builder } = { m.Outside, m.Full }
	for _, zone in ipairs(m.Zones) do
		table.insert(order, zone.B)
	end
	local pending = false
	for _, b in ipairs(order) do
		local jobs = b.Jobs
		if jobs then
			pending = true
			repeat
				local job = jobs[b.Index]
				if job then
					local ok, err = pcall(job)
					if not ok then
						warn("[MarketInterior] " .. b.Name .. " : " .. tostring(err))
					end
				end
				b.Index += 1
			until b.Index > #jobs or os.clock() - t0 > STEP_BUDGET
			stats.Parts = partCount
			if b.Index > #jobs then
				b.Jobs = nil
				b.Built = true
				stats.Built += 1
				dirty = true
				boardsDirty = true
				if b == m.Full then
					for _, light in ipairs(m.Lights) do
						light.Enabled = m.LightsOn
					end
					-- (v9.9) l'intérieur complet a ses vraies lumières : la « lueur
					-- vue de dehors » (sols, murs, silhouettes) se retire
					local night = (m :: any).Night
					if night then
						night.Parent = nil
					end
				else
					for _, zone in ipairs(m.Zones) do
						if zone.B == b then
							setBands(m, zone, false)
							stats.ZonesBuilt += 1
						end
					end
				end
				updateLevel(m)
			end
			if os.clock() - t0 > STEP_BUDGET then
				return true
			end
		end
	end
	return pending
end

-- Point et direction (lissée aux virages) sur un parcours fermé
local function pathAt(path: { Vector3 }, s: number): (Vector3, Vector3)
	local n = #path
	for i = 1, n do
		local a, b = path[i], path[i % n + 1]
		local seg = (b - a).Magnitude
		if s <= seg or i == n then
			local dir = seg > 0 and (b - a) / seg or Vector3.new(0, 0, -1)
			local p = a + dir * math.min(s, seg)
			local turn = 1.2
			if seg - s < turn then
				local c = path[(i + 1) % n + 1]
				local nd = (c - b).Magnitude > 0 and (c - b).Unit or dir
				dir = dir:Lerp(nd, (turn - (seg - s)) / (turn * 2))
			elseif s < turn then
				local z = path[(i - 2) % n + 1]
				local pd = (a - z).Magnitude > 0 and (a - z).Unit or dir
				dir = dir:Lerp(pd, (turn - s) / (turn * 2))
			end
			if dir.Magnitude < 1e-3 then
				dir = Vector3.new(0, 0, -1)
			end
			return p, dir.Unit
		end
		s -= seg
	end
	return path[1], Vector3.new(0, 0, -1)
end

-- Animations (personnages, tapis, scanners, emblèmes, télés)
local function animate(m: Market, position: Vector3, now: number)
	if boxDistance(m, position, false) > ANIM_RANGE then
		return
	end
	local N = NPC()
	local count = 0
	for _, a in ipairs(m.Actors) do
		local path = a.Path
		if a.Custom then
			-- (caisses : animés par animateLane / animateKiosk)
			continue
		elseif path and a.Length and a.Speed then
			local s = ((now + a.Offset) * a.Speed) % a.Length
			local p, dir = pathAt(path, s)
			if (p - position).Magnitude <= 60 then
				local cf = CFrame.lookAt(p, p + Vector3.new(dir.X, 0, dir.Z))
				-- (racine du personnage placée directement, puis la pose : exact,
				-- jamais de PivotTo répété qui accumulerait des erreurs)
				local root = a.Model.PrimaryPart
				if root then
					root.CFrame = cf
				else
					a.Model:PivotTo(cf)
				end
				local cartParts, offsets = a.CartParts, a.CartOffsets
				if cartParts and offsets then
					local ccf = cf * CFrame.new(0, 0, -2.3)
					local frames = table.create(#cartParts)
					for i, o in ipairs(offsets) do
						frames[i] = ccf * o
					end
					workspace:BulkMoveTo(cartParts, frames, Enum.BulkMoveMode.FireCFrameChanged)
				end
				a.Pos = p
				if N then
					pcall(N.Animate, a.Model, a.Anim, now + a.Offset)
				end
				count += 1
			end
		elseif (a.Pos - position).Magnitude <= 60 and N then
			pcall(N.Animate, a.Model, a.Anim, now + a.Offset)
			count += 1
		end
	end
	stats.Animated = count
	-- caisses (v9.9) : tapis, articles, scanner, carrousel, écrans, file de clients
	for _, belt in ipairs(m.Belts) do
		if (belt.Pos - position).Magnitude <= 55 then
			Checkout().AnimateLane(belt, now)
		end
	end
	for _, k in ipairs((m :: any).Kiosks) do
		if (k.Pos - position).Magnitude <= 45 then
			Checkout().AnimateKiosk(k, now)
		end
	end
	for _, s in ipairs(m.Spinners) do
		if (s.Pos - position).Magnitude <= 60 then
			s.Part.CFrame = s.Base * CFrame.new(0, math.sin(now * 1.6 + s.Offset) * 0.15, 0) * CFrame.Angles(0, now * 1.2 + s.Offset, 0) * CFrame.Angles(math.rad(45), 0, math.rad(45))
		end
	end
	for i, g in ipairs(m.TVs) do
		g.Offset = Vector2.new(math.sin(now * 0.45 + i) * 0.35, 0)
	end
end

-- Écrans de classement (v9.9) : animations à 30 i/s de près (≤ 160 studs),
-- 2 i/s plus loin ; contenu relu toutes les 2 s ou au changement de page
local function stepBoards(m: Market, now: number, position: Vector3?)
	for _, board in ipairs(m.Boards) do
		if board.Gui.Parent then
			local d = position and (board.Pos - position).Magnitude or 0
			local b: any = board
			if d <= 160 or now - (b.LastStep or 0) >= 0.5 then
				b.LastStep = now
				local scope = boardScope(board, now)
				if boardsDirty or board.LastScope ~= scope or now - board.LastRefresh > 2 then
					board.LastScope = scope
					board.LastRefresh = now
					pcall(refreshBoard, board, now)
				end
				BoardKit.SetProgress(board.Kit, (now % PAGE_TIME) / PAGE_TIME)
				BoardKit.Step(board.Kit, now)
			end
		end
	end
	boardsDirty = false
end

local function refreshAll(m: Market)
	for _, d in ipairs(m.Displays) do
		if d.Tag then
			refreshDisplay(d)
		end
	end
	for _, r in ipairs(m.Robux) do
		refreshRobux(r)
	end
end

function MarketInterior.Step(position: Vector3?)
	if typeof(position) == "Vector3" then
		focus = position
	end
end

local function heartbeat(dt: number)
	local m = market
	if not started or not m then
		return
	end
	runJobs(m)
	local now = os.clock()
	animClock += dt
	if animClock >= ANIM_EVERY then
		animClock = 0
		local position = localPosition()
		if position and m.Level >= 2 then
			animate(m, position, now)
		end
	end
	boardClock += dt
	if boardClock >= 1 / 30 then
		boardClock = 0
		local position = localPosition()
		stepBoards(m, now, position)
		-- (v9.9) horloges : 30 i/s de près, 4 i/s plus loin ; date chaque minute
		V99.Timers.Clock += 1 / 30
		for _, c in ipairs((m :: any).Clocks) do
			local d = position and (c.Clock.Pos - position).Magnitude or 0
			if d <= 120 or V99.Timers.Clock >= 0.25 then
				ClockKit.Update(c.Clock)
			end
		end
		if V99.Timers.Clock >= 0.25 then
			V99.Timers.Clock = 0
		end
		V99.Timers.Date += 1 / 30
		if V99.Timers.Date >= 30 then
			V99.Timers.Date = 0
			for _, dte in ipairs((m :: any).Dates) do
				pcall(dte.Refresh)
			end
		end
	end
	clock += dt
	if clock < STEP_EVERY then
		return
	end
	clock = 0
	local position = localPosition()
	if position then
		decide(m, position)
		pcall(updateTags, m, position)
	end
	if m.Level >= 1 then
		stepDoors(m, characterPositions())
	end
	if dirty then
		dirty = false
		refreshAll(m)
	end
end

----------------------------------------------------------------------
-- Démarrer / arrêter
----------------------------------------------------------------------

local function discover(): Market?
	local town = workspace:FindFirstChild("DopamineTown")
	local container = town and town:FindFirstChild("Market")
	local model = container and container:FindFirstChild("Supermarket")
	if not model or not model:IsA("Model") then
		return nil
	end
	local mcf = model:GetAttribute("MarketCF")
	local icf = model:GetAttribute("InteriorCF")
	local size = model:GetAttribute("InteriorSize")
	local doorCF = model:GetAttribute("DoorCF")
	if typeof(mcf) ~= "CFrame" or typeof(icf) ~= "CFrame" or typeof(size) ~= "Vector3" or typeof(doorCF) ~= "CFrame" then
		return nil
	end
	local m: Market = {
		Model = model,
		MCF = mcf,
		F = icf * CFrame.new(0, 0, -size.Z / 2),
		Size = size,
		InteriorCF = icf,
		DoorCF = doorCF,
		Level = 0,
		Outside = newBuilder("Outside"),
		Full = newBuilder("Full"),
		Zones = {},
		Displays = {},
		Lights = {},
		LightsOn = false,
		Doors = {},
		Checkouts = {},
		Actors = {},
		Belts = {},
		Spinners = {},
		Kiosks = {},
		Clocks = {},
		Dates = {},
		Robux = {},
		Boards = {},
		TVs = {},
		Bands = {},
	}
	;(m :: any).Tiers = {}
	for _, spec in ipairs(ZONE_SPECS) do
		table.insert(m.Zones, { Name = spec[1], X = spec[2], Z = spec[3], Build = spec[4], B = newBuilder(spec[1]), Hide = spec[5] })
	end
	for _, child in ipairs(model:GetChildren()) do
		local slide = child:GetAttribute("SlideX")
		if child:IsA("BasePart") and child.Name == "DoorPanel" and type(slide) == "number" then
			local closed = child.CFrame
			table.insert(m.Doors, { Part = child, Closed = closed, Open = closed * CFrame.new(slide, 0, 0), IsOpen = false })
		end
	end
	return m
end

function MarketInterior.Start(options: { Toast: ((string, Color3?) -> ())? }?)
	if started then
		return
	end
	started = true
	toastFn = options and options.Toast or nil
	if options and options.Toast then
		ShopUI.SetToast(options.Toast)
	end
	local old = workspace:FindFirstChild(FOLDER_NAME)
	if old then
		old:Destroy()
	end
	local f = Instance.new("Folder")
	f.Name = FOLDER_NAME
	f.Parent = workspace
	folder = f
	partCount, labelCount = 0, 0
	market = discover()
	clock = STEP_EVERY
	boardsDirty = true
	table.insert(conns, RunService.Heartbeat:Connect(heartbeat))
	table.insert(conns, ClientState.Changed:Connect(function()
		dirty = true
	end))
	table.insert(conns, ClientState.LeaderboardChanged:Connect(function()
		boardsDirty = true
	end))
	table.insert(conns, ShopUI.Bought:Connect(function()
		dirty = true
	end))
	table.insert(conns, MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(who: Player, _passId: number, purchased: boolean)
		if who == Players.LocalPlayer and purchased then
			-- (le serveur confirme le pass : l'invite passera à « Déjà à toi »)
			toast("💎 " .. Locale.T("Thank you! Activating…"), rgb(150, 110, 220))
			dirty = true
		end
	end))
end

function MarketInterior.Stop()
	if not started then
		return
	end
	started = false
	for _, c in ipairs(conns) do
		c:Disconnect()
	end
	table.clear(conns)
	local m = market
	if m then
		destroyFull(m)
		destroyOutside(m)
		m.Level = 0
		for _, d in ipairs(m.Doors) do
			if d.Part.Parent then
				d.Part.CFrame = d.Closed
			end
		end
	end
	market = nil
	if folder then
		folder:Destroy()
		folder = nil
	end
	focus = nil
	toastFn = nil
end

function MarketInterior.Debug(): any
	return {
		Market = market,
		Stats = stats,
		Folder = folder,
		Decide = function(position: Vector3)
			if market then
				decide(market, position)
			end
		end,
		RunAll = function()
			local m = market
			for _ = 1, 20000 do
				if not m or not runJobs(m) then
					break
				end
			end
		end,
		-- (rendus) construit toutes les zones, où que soit l'avatar
		BuildZones = function()
			local m = market
			if not m or not m.Full.Built then
				return
			end
			for _, zone in ipairs(m.Zones) do
				if not zone.B.Folder then
					startBuilder(zone.B, m.Full.Folder :: Folder, "Zone_" .. zone.Name, function(f)
						local jobs = {}
						zone.Build(m, f, jobs)
						return jobs
					end)
				end
			end
			for _ = 1, 20000 do
				if not runJobs(m) then
					break
				end
			end
		end,
		Animate = function(position: Vector3, now: number)
			if market then
				animate(market, position, now)
				stepBoards(market, now, position)
			end
		end,
		Buy = function(index: number)
			local m = market
			local d = m and m.Displays[index]
			if d then
				buyDisplay(d)
			end
		end,
		PromptRobux = function(index: number)
			local m = market
			local r = m and m.Robux[index]
			if r then
				lastPrompt = 0
				robuxPrompt(r.Offer)
			end
		end,
		Inside = function(p: Vector3): boolean
			return market ~= nil and inside(market :: Market, p)
		end,
		Tags = function(p: Vector3)
			if market then
				updateTags(market, p)
			end
		end,
		BoardEntries = boardEntries,
		Parts = function(): number
			recount()
			return partCount
		end,
	}
end

return MarketInterior
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="212">
          <Properties>
            <string name="Name">MusicPose</string>
            <string name="Source"><![CDATA[--[[
	MusicPose (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > MusicPose

	🎵 Postures PROCÉDURALES des musiciens de la scène (v9.9, MUSIC99) :
	les animations ne peuvent pas être téléversées, on écrit donc chaque
	image les Motor6D.Transform du personnage (R15 ET R6), comme SitAnimator
	(SEAT98) dont on reprend les outils (IK à deux segments, repères des
	articulations) :
	  - assis SANS siège (piano, batterie) : le bassin descend jusqu'au banc
	    / au tabouret (racine abaissée), cuisses vers l'avant, pieds posés
	    au sol ou sur les pédales (IK des jambes) ;
	  - les MAINS visent des points du monde (touches, fûts, cordes,
	    platines) : IK épaule-coude-poignet ; en R6, le bras pointe vers le
	    point (pas de coude) ;
	  - buste penché, tête qui bat la mesure, pied de grosse caisse.
	Robuste : on n'écrit QUE Transform (jamais C0/C1), dans
	RunService.Stepped (après l'Animator) ; la pose se fond avec celle de
	l'Animator (poids 0..1) ; Release remet tout (l'Animator reprend la main).

	API :
	  MusicPose.Rig(character) -> Rig?
	  MusicPose.Solve(rig, spec, w)  spec = {
	      Seat: number?   (Y monde du dessus du banc ; nil = debout)
	      Feet: { R: Vector3?, L: Vector3? }? (chevilles, monde ; assis)
	      R: Vector3?, L: Vector3? (poignets, monde)
	      RPole: Vector3?, LPole: Vector3? (coudes, repère du buste)
	      Lean: number? (°, buste en avant), Twist: number? (°), Nod: number? (°), Look: number? (°)
	    }
	  MusicPose.Release(rig)
	  MusicPose.Hand(rig, side "R" | "L") -> CFrame? (main, dans le monde)
	  MusicPose.Torso(rig) -> BasePart?
]]

local MusicPose = {}

local IDENTITY = CFrame.identity
local rad = math.rad

local R15_JOINTS: { [string]: { string } } = {
	Root = { "LowerTorso", "Root" },
	Waist = { "UpperTorso", "Waist" },
	Neck = { "Head", "Neck" },
	RShoulder = { "RightUpperArm", "RightShoulder" },
	RElbow = { "RightLowerArm", "RightElbow" },
	RWrist = { "RightHand", "RightWrist" },
	LShoulder = { "LeftUpperArm", "LeftShoulder" },
	LElbow = { "LeftLowerArm", "LeftElbow" },
	LWrist = { "LeftHand", "LeftWrist" },
	RHip = { "RightUpperLeg", "RightHip" },
	RKnee = { "RightLowerLeg", "RightKnee" },
	RAnkle = { "RightFoot", "RightAnkle" },
	LHip = { "LeftUpperLeg", "LeftHip" },
	LKnee = { "LeftLowerLeg", "LeftKnee" },
	LAnkle = { "LeftFoot", "LeftAnkle" },
}
local R6_JOINTS: { [string]: { string } } = {
	Root = { "HumanoidRootPart", "RootJoint" },
	Neck = { "Torso", "Neck" },
	RShoulder = { "Torso", "Right Shoulder" },
	LShoulder = { "Torso", "Left Shoulder" },
	RHip = { "Torso", "Right Hip" },
	LHip = { "Torso", "Left Hip" },
}

type Joint = {
	Motor: Motor6D,
	C0: CFrame,
	C1: CFrame,
	C0r: CFrame,
	C0rInv: CFrame,
	Base: CFrame?,
	Written: CFrame?,
}
type Limb = { P: Vector3, L1: number, L2: number }
export type Rig = {
	Character: Model,
	Humanoid: Humanoid,
	R6: boolean,
	Root: BasePart,
	Joints: { [string]: Joint },
	Arms: { [string]: Limb },
	Legs: { [string]: Limb },
	Scale: number,
	Hands: { [string]: BasePart },
	Torso: BasePart?,
	LegLen: number,
}

local function sameCF(a: CFrame, b: CFrame): boolean
	return (a.Position - b.Position).Magnitude < 1e-4 and a.LookVector:Dot(b.LookVector) > 0.99999 and a.UpVector:Dot(b.UpVector) > 0.99999
end

local function limbOf(joints: { [string]: Joint }, a: string, b: string, c: string, r6: boolean, scale: number): Limb?
	local j1 = joints[a]
	if not j1 then
		return nil
	end
	if r6 then
		return { P = j1.C0.Position, L1 = 1.6 * scale, L2 = 0 }
	end
	local j2, j3 = joints[b], joints[c]
	if not j2 or not j3 then
		return nil
	end
	local l1 = (j1.C1.Position - j2.C0.Position).Magnitude
	local l2 = (j2.C1.Position - j3.C0.Position).Magnitude
	if l1 < 0.1 or l2 < 0.1 then
		return nil
	end
	return { P = j1.C0.Position, L1 = l1, L2 = l2 }
end

function MusicPose.Rig(character: Model?): Rig?
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or not root:IsA("BasePart") then
		return nil
	end
	local r6 = humanoid.RigType == Enum.HumanoidRigType.R6
	local joints: { [string]: Joint } = {}
	for key, spec in pairs(r6 and R6_JOINTS or R15_JOINTS) do
		local holder = character:FindFirstChild(spec[1])
		local motor = holder and holder:FindFirstChild(spec[2])
		if motor and motor:IsA("Motor6D") then
			local c0 = motor.C0
			joints[key] = { Motor = motor, C0 = c0, C1 = motor.C1, C0r = c0.Rotation, C0rInv = c0.Rotation:Inverse(), Base = nil, Written = nil }
		end
	end
	if not joints.Root or not joints.RShoulder or not joints.LShoulder then
		return nil
	end
	local torso = character:FindFirstChild(r6 and "Torso" or "UpperTorso")
	local scale = 1
	if torso and torso:IsA("BasePart") then
		scale = math.clamp(torso.Size.Y / (r6 and 2 or 1.6), 0.5, 2)
	end
	local hands: { [string]: BasePart } = {}
	for side, names in pairs({ R = { "RightHand", "Right Arm" }, L = { "LeftHand", "Left Arm" } }) do
		local hand = character:FindFirstChild(r6 and names[2] or names[1])
		if hand and hand:IsA("BasePart") then
			hands[side] = hand
		end
	end
	local rig: Rig = {
		Character = character,
		Humanoid = humanoid,
		R6 = r6,
		Root = root,
		Joints = joints,
		Arms = {},
		Legs = {},
		Scale = scale,
		Hands = hands,
		Torso = (torso and torso:IsA("BasePart")) and torso or nil,
		LegLen = r6 and 2 * scale or math.max(1, tonumber(humanoid.HipHeight) or 2),
	}
	rig.Arms.R = limbOf(joints, "RShoulder", "RElbow", "RWrist", r6, scale) :: any
	rig.Arms.L = limbOf(joints, "LShoulder", "LElbow", "LWrist", r6, scale) :: any
	rig.Legs.R = limbOf(joints, "RHip", "RKnee", "RAnkle", r6, scale) :: any
	rig.Legs.L = limbOf(joints, "LHip", "LKnee", "LAnkle", r6, scale) :: any
	if r6 then
		-- (jambe R6 : 2 studs, pas de genou)
		if rig.Legs.R then
			rig.Legs.R.L1 = 2 * scale
		end
		if rig.Legs.L then
			rig.Legs.L.L1 = 2 * scale
		end
	end
	return rig
end

----------------------------------------------------------------------
-- Géométrie (outils de SitAnimator)
----------------------------------------------------------------------

-- Orientation d'un segment : -Y le long de `dir`, "devant" (-Z) vers `front`
local function frameAlong(dir: Vector3, front: Vector3): CFrame
	local d = dir.Magnitude > 1e-4 and dir.Unit or Vector3.new(0, -1, 0)
	local y = -d
	local z = -(front - d * front:Dot(d))
	if z.Magnitude < 1e-3 then
		z = Vector3.new(0, 0, 1) - d * d.Z
		if z.Magnitude < 1e-3 then
			z = Vector3.new(1, 0, 0)
		end
	end
	z = z.Unit
	local x = y:Cross(z)
	return CFrame.fromMatrix(Vector3.zero, x, y, z)
end

-- IK à deux segments dans le repère du parent : le bout vise `target`,
-- l'articulation du milieu part vers `pole` ; bend = 1 (bras) ou -1 (jambe)
local function ik2(limb: Limb, target: Vector3, pole: Vector3, bend: number): (CFrame, number)
	local d = target - limb.P
	local dn = d.Magnitude > 1e-4 and d.Unit or Vector3.new(0, -1, 0)
	local l1, l2 = limb.L1, limb.L2
	local dist = math.clamp(d.Magnitude, math.abs(l1 - l2) + 0.05, l1 + l2 - 0.02)
	local cosA = math.clamp((l1 * l1 + dist * dist - l2 * l2) / (2 * l1 * dist), -1, 1)
	local a = math.acos(cosA)
	local perp = pole - dn * pole:Dot(dn)
	if perp.Magnitude < 1e-3 then
		perp = Vector3.new(0, 0, -1) - dn * (-dn.Z)
		if perp.Magnitude < 1e-3 then
			perp = Vector3.new(1, 0, 0)
		end
	end
	perp = perp.Unit
	local u = dn * math.cos(a) + perp * math.sin(a)
	local elbow = limb.P + u * l1
	local f = limb.P + dn * dist - elbow
	f = f.Magnitude > 1e-4 and f.Unit or u
	local flex = math.acos(math.clamp(u:Dot(f), -1, 1))
	local b = f - u * f:Dot(u)
	if b.Magnitude < 1e-3 then
		b = -perp
	else
		b = b.Unit
	end
	local y = -u
	local z = bend > 0 and -b or b
	local x = y:Cross(z)
	return CFrame.fromMatrix(Vector3.zero, x, y, z), flex
end

-- Transform d'un joint pour une orientation `r` du membre (repère du parent)
local function absT(joint: Joint, r: CFrame): CFrame
	return joint.C0rInv * r * joint.C0r
end

-- Transform d'une rotation / translation dans le repère "personnage" du parent
local function addT(joint: Joint, r: CFrame): CFrame
	return joint.C0rInv * r * joint.C0r
end

local function part1CF(parentCF: CFrame, joint: Joint, t: CFrame): CFrame
	return parentCF * joint.C0 * t * joint.C1:Inverse()
end

----------------------------------------------------------------------
-- Pose
----------------------------------------------------------------------

function MusicPose.Solve(rig: Rig, spec: any, w: number)
	if w <= 0.001 or not rig.Root.Parent then
		return
	end
	w = math.min(w, 1)
	local J = rig.Joints
	-- bases : pose de l'Animator (sans cumul si l'Animator n'a pas réécrit un joint)
	local base: { [string]: CFrame } = {}
	for key, joint in pairs(J) do
		local current = joint.Motor.Transform
		local b = current
		if joint.Written and joint.Base and sameCF(current, joint.Written) then
			b = joint.Base
		end
		joint.Base = b
		base[key] = b
	end
	local target: { [string]: CFrame } = {}
	local seated = type(spec.Seat) == "number"
	local rootJ = J.Root
	-- 1. assis : racine abaissée pour poser le bassin sur le banc
	if seated then
		local hip = J.RHip or J.LHip
		local standParent = part1CF(rig.Root.CFrame, rootJ, IDENTITY)
		local hipY = hip and (standParent * hip.C0).Position.Y or (rig.Root.Position.Y - rig.LegLen * 0.5)
		local want = spec.Seat + (rig.R6 and 0.5 or 0.36) * rig.Scale
		local drop = math.clamp(hipY - want, 0, 3.2)
		target.Root = addT(rootJ, CFrame.new(0, -drop, 0))
	end
	-- 2. buste / tête
	local lean, twist = spec.Lean or 0, spec.Twist or 0
	if J.Waist then
		target.Waist = addT(J.Waist, CFrame.Angles(rad(-lean), rad(twist), 0))
	elseif rig.R6 and (lean ~= 0 or twist ~= 0) then
		-- (R6 : pas de taille -> le corps entier tourne un peu, sans les jambes)
		local r = CFrame.Angles(rad(-lean * 0.6), rad(twist * 0.6), 0)
		target.Root = (target.Root or base.Root) * addT(rootJ, r)
	end
	if J.Neck then
		target.Neck = addT(J.Neck, CFrame.Angles(rad(-(spec.Nod or 0)), rad(spec.Look or 0), 0))
	end
	-- repères du monde après la racine / la taille (pour viser des points)
	-- (pondération : la racine réellement écrite est base:Lerp(cible, w))
	local rootT = base.Root:Lerp(target.Root or base.Root, w)
	local lowerCF = part1CF(rig.Root.CFrame, rootJ, rootT)
	local armParentCF = lowerCF
	if not rig.R6 and J.Waist then
		local waistT = base.Waist:Lerp(target.Waist or base.Waist, w)
		armParentCF = part1CF(lowerCF, J.Waist, waistT)
	end
	-- 3. jambes (assis) : chevilles vers les pieds voulus
	if seated then
		for _, side in ipairs({ "R", "L" }) do
			local limb = rig.Legs[side]
			local hipKey = side == "R" and "RHip" or "LHip"
			local hip = J[hipKey]
			if limb and hip then
				local foot = spec.Feet and spec.Feet[side]
				local t: Vector3
				if typeof(foot) == "Vector3" then
					t = lowerCF:PointToObjectSpace(foot)
				else
					t = limb.P + Vector3.new(0, -1.1, -1.05) * rig.Scale
				end
				if rig.R6 then
					target[hipKey] = absT(hip, frameAlong(t - limb.P, Vector3.new(0, 0, -1)))
				else
					local r, flex = ik2(limb, t, Vector3.new(side == "R" and 0.15 or -0.15, 1, -1), -1)
					target[hipKey] = absT(hip, r)
					local knee = J[side == "R" and "RKnee" or "LKnee"]
					if knee then
						target[side == "R" and "RKnee" or "LKnee"] = absT(knee, CFrame.Angles(-flex, 0, 0))
					end
					local ankle = J[side == "R" and "RAnkle" or "LAnkle"]
					if ankle then
						target[side == "R" and "RAnkle" or "LAnkle"] = IDENTITY
					end
				end
			end
		end
	end
	-- 4. bras : poignets vers les points voulus
	for _, side in ipairs({ "R", "L" }) do
		local want = spec[side]
		local limb = rig.Arms[side]
		local shoulderKey = side == "R" and "RShoulder" or "LShoulder"
		local shoulder = J[shoulderKey]
		if typeof(want) == "Vector3" and limb and shoulder then
			local t = armParentCF:PointToObjectSpace(want)
			if rig.R6 then
				target[shoulderKey] = absT(shoulder, frameAlong(t - limb.P, Vector3.new(0, 0, -1)))
			else
				local pole = spec[side .. "Pole"] or Vector3.new(side == "R" and 1 or -1, -0.6, 0.5)
				local r, flex = ik2(limb, t, pole, 1)
				target[shoulderKey] = absT(shoulder, r)
				local elbow = J[side == "R" and "RElbow" or "LElbow"]
				if elbow then
					target[side == "R" and "RElbow" or "LElbow"] = absT(elbow, CFrame.Angles(flex, 0, 0))
				end
				local wrist = J[side == "R" and "RWrist" or "LWrist"]
				if wrist then
					target[side == "R" and "RWrist" or "LWrist"] = IDENTITY
				end
			end
		end
	end
	-- 5. écriture (fondu avec la pose de l'Animator)
	for key, value in pairs(target) do
		local joint = J[key]
		if joint then
			local final = w >= 0.999 and value or base[key]:Lerp(value, w)
			joint.Motor.Transform = final
			joint.Written = final
		end
	end
end

function MusicPose.Release(rig: Rig)
	for _, joint in pairs(rig.Joints) do
		if joint.Written and joint.Motor.Parent then
			pcall(function()
				joint.Motor.Transform = joint.Base or IDENTITY
			end)
		end
		joint.Written = nil
		joint.Base = nil
	end
end

-- Main dans le monde (R6 : bas du bras)
function MusicPose.Hand(rig: Rig, side: string): CFrame?
	local hand = rig.Hands[side]
	if not hand or not hand.Parent then
		return nil
	end
	if rig.R6 then
		return hand.CFrame * CFrame.new(0, -0.85 * rig.Scale, 0)
	end
	return hand.CFrame
end

function MusicPose.Torso(rig: Rig): BasePart?
	return rig.Torso
end

-- (tests : cinématique directe d'une pose, sans moteur physique)
function MusicPose.Forward(rig: Rig): { [string]: CFrame }
	local out: { [string]: CFrame } = {}
	local J = rig.Joints
	local function cfOf(name: string): CFrame?
		return out[name]
	end
	out.HumanoidRootPart = rig.Root.CFrame
	local order = rig.R6 and { "Root", "Neck", "RShoulder", "LShoulder", "RHip", "LHip" }
		or { "Root", "Waist", "Neck", "RShoulder", "RElbow", "RWrist", "LShoulder", "LElbow", "LWrist", "RHip", "RKnee", "RAnkle", "LHip", "LKnee", "LAnkle" }
	for _, key in ipairs(order) do
		local joint = J[key]
		if joint then
			local motor = joint.Motor
			local p0 = motor.Part0
			local p1 = motor.Part1
			local parentCF = p0 and cfOf(p0.Name)
			if p1 and parentCF then
				out[p1.Name] = part1CF(parentCF, joint, motor.Transform)
			end
		end
	end
	return out
end

return MusicPose
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="213">
          <Properties>
            <string name="Name">MusicStage</string>
            <string name="Source"><![CDATA[--[[
	MusicStage (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > MusicStage

	🎵 SCÈNE MUSICALE de la place, côté CLIENT (v9.9, MUSIC99).
	Le serveur (TownMusic) pose le plancher, les invites "Jouer" (E), le
	juke-box (E : morceaux, F : radio), qui joue de quoi (attribut "Player")
	et le morceau en cours (SongId / SongStart). Ici :
	  - le DÉCOR complet (MusicStageBuild), en flux : construit à moins de
	    BUILD_R studs (x Détail), un morceau par image ; détruit au-delà de
	    DROP_R ;
	  - JOUER : l'invite "Jouer" -> le serveur réserve l'instrument ->
	    l'avatar est placé à son poste (assis au piano / à la batterie),
	    déplacements coupés, panneau de jeu (MusicUI) + touches du clavier
	    (ContextActionService, priorité haute : ZQSD ne fait pas bouger
	    l'avatar pendant qu'on joue ; Espace = se lever) ;
	  - les SONS (MusicSynth) : chaque note est jouée tout de suite chez soi,
	    puis envoyée par paquets (MusicData.SEND_EVERY) ; les voisins la
	    reçoivent (relais du serveur) et l'entendent / la voient jouer ;
	  - les MORCEAUX pré-enregistrés (MusicData) : joués par tous les
	    clients à partir de la même heure du serveur ; les instruments
	    jouent tout seuls (touches qui s'enfoncent, fûts qui vibrent,
	    cymbales qui oscillent, platines qui tournent) et les musiciens
	    présents jouent leur partie automatiquement ;
	  - la RADIO lofi (Config.Music.Playlist) en son 3D sur la scène ;
	  - les MUSICIENS animés (MusicPose : mains sur les touches, baguettes,
	    médiators, platines) pour TOUS les joueurs proches ;
	  - l'écran LED (titre, égaliseur, progression), les lyres
	    motorisées et leurs faisceaux (la nuit), les lueurs des projecteurs.

	API (TownClient, via optionalModule) :
	  MusicStage.Start(options?)   à l'entrée en ville
	  MusicStage.Step(dt)          à chaque image
	  MusicStage.Stop()            à la sortie (tout est détruit / remis)
	  MusicStage.Debug() -> table
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")

local Config = require(ReplicatedStorage.Shared.Config)
local Locale = require(ReplicatedStorage.Shared.Locale)
local MusicData = require(ReplicatedStorage.Shared.MusicData)
local GraphicsQuality = require(ReplicatedStorage.Shared.GraphicsQuality)
local MusicStageBuild = require(script.Parent.MusicStageBuild)
local MusicSynth = require(script.Parent.MusicSynth)
local MusicPose = require(script.Parent.MusicPose)
local MusicUI = require(script.Parent.MusicUI)

local MusicStage = {}

local LocalPlayer = Players.LocalPlayer

local BUILD_R = 210 -- (studs) on construit le décor…
local DROP_R = 290 -- …on le détruit au-delà
local POSE_R = 110 -- musiciens animés à moins de…
local VISUAL_STEP = 1 / 30
local LOOKAHEAD = 0.12 -- (s) notes des morceaux programmées d'avance
local ACTION = "DopamineStageKeys"
local UP = Vector3.new(0, 1, 0)
local TAU = math.pi * 2

local state: any = nil

local function T(text: string, ...): string
	return Locale.T(text, ...)
end

local function serverNow(): number
	return workspace:GetServerTimeNow()
end

-- Horloge locale de la scène (somme des dt de Step : suit les images)
local function clockNow(): number
	local s = state
	return s and s.Clock or 0
end

local function smooth(x: number): number
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end

----------------------------------------------------------------------
-- Claviers (disposition "tracker" : 2 rangées = 2 octaves + 5 notes)
----------------------------------------------------------------------

local K = Enum.KeyCode
local LOWER_ROW = { K.Z, K.S, K.X, K.D, K.C, K.V, K.G, K.B, K.H, K.N, K.J, K.M }
local UPPER_ROW = { K.Q, K.Two, K.W, K.Three, K.E, K.R, K.Five, K.T, K.Six, K.Y, K.Seven, K.U, K.I, K.Nine, K.O, K.Zero, K.P }
local KEY_SPAN = 29 -- demi-tons montrés (Do .. Mi + 2 octaves)

local DEFAULT_LOW: { [string]: number } = { Piano = 48, Synth = 60, Xylophone = 60 }
local LOW_RANGE: { [string]: { number } } = { Piano = { 24, 72 }, Synth = { 36, 72 }, Xylophone = { 48, 72 } }

-- Accords de la guitare (valeur = 1000 + index)
local CHORDS = { "C", "G", "Am", "F", "D", "Em", "E", "Dm" }
local CHORD_KEYS = { K.One, K.Two, K.Three, K.Four, K.Five, K.Six, K.Seven, K.Eight }
local CHORDS_FR: { [string]: string } = { C = "Do", G = "Sol", Am = "Lam", F = "Fa", D = "Ré", Em = "Mim", E = "Mi", Dm = "Rém" }
local SOLO = { 57, 60, 62, 64, 67, 69, 72, 74, 76 } -- pentatonique de La mineur
local SOLO_KEYS = { K.A, K.S, K.D, K.F, K.G, K.H, K.J, K.K, K.L }
local BASS_LOW = { 36, 38, 40, 41, 43, 45, 46, 47 }
local BASS_HIGH = { 48, 50, 52, 53, 55, 57, 58, 60 }
local BASS_LOW_KEYS = { K.A, K.S, K.D, K.F, K.G, K.H, K.J, K.K }
local BASS_HIGH_KEYS = { K.Q, K.W, K.E, K.R, K.T, K.Y, K.U, K.I }

local PAD = {
	Red = Color3.fromRGB(236, 96, 120),
	Blue = Color3.fromRGB(96, 150, 236),
	Gold = Color3.fromRGB(226, 172, 70),
	Lilac = Color3.fromRGB(160, 120, 226),
	Mint = Color3.fromRGB(80, 190, 150),
	Pink = Color3.fromRGB(236, 110, 170),
}


----------------------------------------------------------------------
-- Outils
----------------------------------------------------------------------

local function remote(): RemoteEvent?
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	local r = folder and folder:FindFirstChild("MusicEvent")
	return (r and r:IsA("RemoteEvent")) and r or nil
end

local function fire(...: any)
	local r = remote()
	if r then
		r:FireServer(...)
	end
end

local function rootOf(player: Player?): BasePart?
	local character = player and player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return (root and root:IsA("BasePart")) and root or nil
end

local function findStage(): Folder?
	local town = workspace:FindFirstChild("DopamineTown")
	if not town then
		return nil
	end
	local decor = town:FindFirstChild("Decor")
	local plaza = decor and decor:FindFirstChild("Plaza")
	local found = plaza and plaza:FindFirstChild("MusicStage")
	if not found then
		found = town:FindFirstChild("MusicStage", true)
	end
	return (found and found:IsA("Folder")) and found or nil
end

local atmosphere: any = nil
local function isNight(): boolean
	if atmosphere == nil then
		local module = script.Parent:FindFirstChild("TownAtmosphere")
		local ok, result = false, nil
		if module then
			ok, result = pcall(require, module)
		end
		atmosphere = ok and result or false
	end
	if atmosphere and type(atmosphere.LampsOn) == "function" then
		local ok, on = pcall(atmosphere.LampsOn)
		if ok then
			return on == true
		end
	end
	local clock = game:GetService("Lighting").ClockTime
	return clock < 6.3 or clock > 18
end

local controlsModule: any = nil
local function setControls(enabled: boolean)
	if controlsModule == nil then
		controlsModule = false
		pcall(function()
			local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
			local module = playerScripts and playerScripts:FindFirstChild("PlayerModule")
			if module and module:IsA("ModuleScript") then
				controlsModule = (require(module) :: any):GetControls()
			end
		end)
	end
	if controlsModule then
		pcall(function()
			if enabled then
				controlsModule:Enable()
			else
				controlsModule:Disable()
			end
		end)
	end
end

local function anchorOf(id: string): BasePart?
	local s = state
	local folder = s and s.Folder
	local a = folder and folder:FindFirstChild("Play_" .. id)
	return (a and a:IsA("BasePart")) and a or nil
end

local function occupant(id: string): number
	local a = anchorOf(id)
	local v = a and a:GetAttribute("Player")
	return type(v) == "number" and v or 0
end

----------------------------------------------------------------------
-- Visuels des coups (touches, fûts, cymbales, platines, écran)
----------------------------------------------------------------------

local ENERGY_BAND: { [string]: { number } } = {
	Bass = { 1, 5 },
	Drums = { 1, 24 },
	Piano = { 6, 16 },
	Synth = { 8, 20 },
	Guitar = { 6, 14 },
	Xylophone = { 14, 24 },
	DJ = { 1, 24 },
}

-- Touche la plus proche qui existe (même note à l'octave près)
local function keyFor(keys: any, n: number): any
	if not keys then
		return nil
	end
	local k = keys[n]
	local m = n
	for _ = 1, 6 do
		if k then
			return k
		end
		if m < 60 then
			m += 12
		else
			m -= 12
		end
		k = keys[m]
	end
	return k
end

local function pressKey(s: any, keys: any, n: number, depth: number)
	local key = keyFor(keys, n)
	if not key or not key.Part.Parent then
		return
	end
	key.Part.CFrame = key.CF * CFrame.new(0, -depth, 0.02) * CFrame.Angles(math.rad(-2.5), 0, 0)
	s.Pressed[key.Part] = { CF = key.CF, Until = clockNow() + 0.16 }
end

local function energize(s: any, inst: string, vel: number, n: number?)
	local band = ENERGY_BAND[inst] or { 1, 24 }
	local lo, hi = band[1], band[2]
	local center = n and (lo + (hi - lo) * math.clamp(((n % 48) / 48), 0, 1)) or math.random(lo, hi)
	for i = lo, hi do
		local d = math.abs(i - center)
		local add = vel * math.max(0, 1 - d / 5)
		s.Energy[i] = math.min(1, (s.Energy[i] or 0) + add * 0.7)
	end
	s.LastHit = clockNow()
end

----------------------------------------------------------------------
-- Mains des musiciens (points visés, mis à jour par les coups)
----------------------------------------------------------------------

local function handState(s: any, inst: string): any
	local hs = s.Hands[inst]
	if not hs then
		hs = { R = { HitT = -math.huge }, L = { HitT = -math.huge }, KickT = -math.huge, Note = 60, Chord = 0, Strum = 1, ScratchT = -math.huge, UpT = -math.huge }
		s.Hands[inst] = hs
	end
	return hs
end

-- Un coup sur un instrument : son + visuel + mains du musicien
local function hit(inst: string, n: number, vel: number, via: string?)
	local s = state
	if not s then
		return
	end
	local H = s.Build and s.Build.H
	local emitters = H and H.Emitters or {}
	local emitter = emitters[via or inst]
	local kind = inst
	if inst == "Drums" then
		s.Synth:Drum(n, vel, emitter)
	elseif inst == "DJ" then
		s.Synth:Pad(n, vel, emitter)
	else
		s.Synth:Note(inst, n, vel, emitter)
	end
	energize(s, inst, vel, (inst ~= "Drums" and inst ~= "DJ") and n or nil)
	if s.Playing == (via or inst) and s.UI then
		s.UI:Flash(n)
	end
	if via then
		-- (boucles du DJ : seules les platines réagissent)
		local hs = handState(s, via)
		if inst == "Drums" and n == MusicData.DRUM.Snare then
			hs.R.HitT = clockNow()
		end
		return
	end
	if not H then
		return
	end
	local hs = handState(s, kind)
	local now = clockNow()
	if inst == "Piano" or inst == "Synth" or inst == "Xylophone" then
		local keys = H.Keys[inst]
		pressKey(s, keys, n, inst == "Xylophone" and 0.02 or 0.04)
		local key = keyFor(keys, n)
		if key then
			local side = n < (inst == "Xylophone" and 78 or 60) and "L" or "R"
			if inst == "Xylophone" and now - hs[side].HitT < 0.09 then
				side = side == "L" and "R" or "L"
			end
			hs[side].HitT = now
			hs[side].Point = key.Top
			hs[side].Vel = vel
		end
	elseif inst == "Drums" then
		local piece = H.Drums and H.Drums[n]
		if n == MusicData.DRUM.Kick then
			hs.KickT = now
		end
		if piece then
			s.Wobble[n] = { T = now, A = vel }
			if n ~= MusicData.DRUM.Kick then
				local left = n == MusicData.DRUM.Snare or n == MusicData.DRUM.TomHigh or n == MusicData.DRUM.Crash
				local side = left and "L" or "R"
				hs[side].HitT = now
				hs[side].Point = piece.Hit
				hs[side].Vel = vel
			end
		end
	elseif inst == "Guitar" or inst == "Bass" then
		if now - hs.R.HitT > 0.08 then
			hs.Strum = -hs.Strum
			hs.R.HitT = now
		end
		hs.Note = n
	elseif inst == "DJ" then
		if n == 5 then
			hs.ScratchT = now
			s.Scratch = { T = now }
		else
			hs.UpT = now
		end
	end
end

----------------------------------------------------------------------
-- Jouer (joueur local)
----------------------------------------------------------------------

local function layoutFor(id: string): any
	local s = state
	local st = MusicData.STATIONS[id]
	if st.Kind == "keys" then
		local low = s.Octave[id] or DEFAULT_LOW[id] or 48
		local keys = {}
		for i, kc in ipairs(LOWER_ROW) do
			keys[low + i - 1] = kc
		end
		keys[low + 12] = K.Comma
		for i, kc in ipairs(UPPER_ROW) do
			keys[low + 11 + i] = kc
		end
		return { Kind = "keys", Low = low, Count = KEY_SPAN, Keys = keys }
	elseif id == "Drums" then
		local D = MusicData.DRUM
		return {
			Kind = "pads",
			Rows = {
				{ { Value = D.Crash, Label = "💥 " .. T("Crash"), KeyCode = K.Q, Color = PAD.Gold }, { Value = D.TomHigh, Label = T("Tom 1"), KeyCode = K.W, Color = PAD.Blue }, { Value = D.TomMid, Label = T("Tom 2"), KeyCode = K.E, Color = PAD.Blue }, { Value = D.Ride, Label = "🔔 " .. T("Ride"), KeyCode = K.R, Color = PAD.Gold } },
				{ { Value = D.HatOpen, Label = T("Open hi-hat"), KeyCode = K.A, Color = PAD.Gold }, { Value = D.HatClosed, Label = T("Hi-hat"), KeyCode = K.S, Color = PAD.Gold }, { Value = D.Snare, Label = "🥁 " .. T("Snare"), KeyCode = K.D, Color = PAD.Red }, { Value = D.TomFloor, Label = T("Floor tom"), KeyCode = K.F, Color = PAD.Blue } },
				{ { Value = D.Kick, Label = "🦶 " .. T("Bass drum"), KeyCode = K.X, Color = PAD.Lilac, Wide = 4 } },
			},
		}
	elseif id == "Guitar" then
		local row1, row2 = {}, {}
		for i, name in ipairs(CHORDS) do
			table.insert(row1, { Value = 1000 + i, Label = Locale.IsFrench() and (CHORDS_FR[name] or name) or name, KeyCode = CHORD_KEYS[i], Color = i % 2 == 0 and PAD.Red or PAD.Pink })
		end
		for i, n in ipairs(SOLO) do
			table.insert(row2, { Value = n, Label = MusicData.NoteName(n, Locale.IsFrench()), KeyCode = SOLO_KEYS[i], Color = PAD.Lilac })
		end
		return { Kind = "pads", Rows = { row1, row2 } }
	elseif id == "Bass" then
		local row1, row2 = {}, {}
		for i, n in ipairs(BASS_HIGH) do
			table.insert(row1, { Value = n, Label = MusicData.NoteName(n, Locale.IsFrench()), KeyCode = BASS_HIGH_KEYS[i], Color = PAD.Blue })
		end
		for i, n in ipairs(BASS_LOW) do
			table.insert(row2, { Value = n, Label = MusicData.NoteName(n, Locale.IsFrench()), KeyCode = BASS_LOW_KEYS[i], Color = PAD.Lilac })
		end
		return { Kind = "pads", Rows = { row1, row2 } }
	else -- DJ
		return {
			Kind = "pads",
			Rows = {
				{ { Value = 1, Label = "🥁 " .. T("Beat"), KeyCode = K.Q, Color = PAD.Blue }, { Value = 2, Label = "🏠 " .. T("House"), KeyCode = K.W, Color = PAD.Blue }, { Value = 3, Label = "🎤 " .. T("Hip-hop"), KeyCode = K.E, Color = PAD.Blue }, { Value = 4, Label = "☕ " .. T("Lo-fi"), KeyCode = K.R, Color = PAD.Blue } },
				{ { Value = 5, Label = "💿 " .. T("Scratch"), KeyCode = K.A, Color = PAD.Pink }, { Value = 6, Label = "📯 " .. T("Horn"), KeyCode = K.S, Color = PAD.Gold }, { Value = 7, Label = "🌊 " .. T("Riser"), KeyCode = K.D, Color = PAD.Mint }, { Value = 8, Label = "💥 " .. T("Drop"), KeyCode = K.F, Color = PAD.Red } },
			},
		}
	end
end

local function keyMap(layout: any): { [Enum.KeyCode]: number }
	local map = {}
	if layout.Kind == "keys" then
		for n, kc in pairs(layout.Keys) do
			map[kc] = n
		end
	else
		for _, row in ipairs(layout.Rows) do
			for _, pad in ipairs(row) do
				if pad.KeyCode then
					map[pad.KeyCode] = pad.Value
				end
			end
		end
		if state and state.Playing == "Drums" then
			map[K.C] = MusicData.DRUM.Kick
			map[K.V] = MusicData.DRUM.Kick
		end
	end
	return map
end

local function queue(n: number, vel: number)
	local s = state
	if not s or not s.Playing then
		return
	end
	local now = clockNow()
	if #s.Out == 0 then
		s.OutStart = now
	end
	if #s.Out >= MusicData.MAX_BATCH * 3 then
		return
	end
	table.insert(s.Out, n)
	table.insert(s.Out, math.floor(vel * 100 + 0.5))
	table.insert(s.Out, math.floor((now - s.OutStart) * 1000 + 0.5))
end

local function flush(force: boolean?)
	local s = state
	if not s or #s.Out == 0 then
		return
	end
	if not force and clockNow() - s.OutStart < MusicData.SEND_EVERY then
		return
	end
	local id = s.Playing
	if id then
		fire("notes", MusicData.INDEX[id], s.Out)
	end
	s.Out = {}
end

local function playLocal(value: number, vel: number)
	local s = state
	if not s or not s.Playing then
		return
	end
	local id = s.Playing
	s.LastInput = clockNow()
	if id == "DJ" then
		if value <= MusicData.DJ_LOOPS then
			local current = anchorOf("DJ")
			local loop = current and current:GetAttribute("Loop")
			fire("loop", (loop == value) and 0 or value)
			s.UI:Flash(value)
			return
		end
		hit("DJ", value, vel)
		queue(value, vel)
		return
	end
	if id == "Guitar" and value > 1000 then
		local name = CHORDS[value - 1000]
		local now = clockNow()
		local down = not (s.LastChord == value and now - (s.LastChordT or 0) < 0.4 and s.LastDown)
		s.LastChord, s.LastChordT, s.LastDown = value, now, down
		local root = MusicData.Root(name, 40) or 48
		local voicing = { root }
		for _, n in ipairs(MusicData.ChordNotes(name, 58)) do
			table.insert(voicing, n)
		end
		table.insert(voicing, (MusicData.ChordNotes(name, 66))[1] or root + 24)
		local count = down and #voicing or 3
		for k = 1, count do
			local n = down and voicing[k] or voicing[#voicing - k + 1]
			local delay = (k - 1) * 0.028
			task.delay(delay, function()
				if state == s then
					hit("Guitar", n, vel * (down and 0.9 or 0.7))
				end
			end)
			queue(n, vel * (down and 0.9 or 0.7))
			-- (décalage réel conservé pour les voisins)
			s.Out[#s.Out] = s.Out[#s.Out] + math.floor(delay * 1000)
		end
		s.UI:Flash(value)
		return
	end
	hit(id, value, vel)
	queue(value, vel)
end

local function refreshOctave()
	local s = state
	local id = s and s.Playing
	if not id or MusicData.STATIONS[id].Kind ~= "keys" then
		return
	end
	local low = s.Octave[id] or DEFAULT_LOW[id]
	s.UI:SetOctaveText(MusicData.NoteName(low, Locale.IsFrench()) .. " – " .. MusicData.NoteName(low + KEY_SPAN - 1, Locale.IsFrench()))
end

local exitLocal: (sendLeave: boolean) -> ()

local function bindKeys(layout: any)
	local s = state
	s.KeyMap = keyMap(layout)
	local list = {}
	for kc in pairs(s.KeyMap) do
		table.insert(list, kc)
	end
	table.insert(list, K.Space)
	table.insert(list, K.Left)
	table.insert(list, K.Right)
	pcall(function()
		ContextActionService:UnbindAction(ACTION)
	end)
	pcall(function()
		ContextActionService:BindActionAtPriority(ACTION, function(_name: string, inputState: Enum.UserInputState, input: InputObject)
			local cur = state
			if not cur or not cur.Playing then
				return Enum.ContextActionResult.Pass
			end
			if inputState == Enum.UserInputState.Begin then
				local kc = input.KeyCode
				if kc == K.Space then
					exitLocal(true)
				elseif kc == K.Left or kc == K.Right then
					cur.UICallbacks.Octave(kc == K.Left and -1 or 1)
				else
					local value = cur.KeyMap[kc]
					if value then
						playLocal(value, 0.85)
					end
				end
			end
			return Enum.ContextActionResult.Sink
		end, false, Enum.ContextActionPriority.High.Value + 50, table.unpack(list))
	end)
end

local function setStagePromptsHidden(hidden: boolean)
	local s = state
	local folder = s and s.Folder
	if not folder then
		return
	end
	for _, d in ipairs(folder:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			if hidden then
				d.Enabled = false
			else
				local host = d.Parent
				local who = host and host:GetAttribute("Player")
				d.Enabled = not (type(who) == "number" and who ~= 0)
			end
		end
	end
end

local function enterLocal(id: string)
	local s = state
	if not s or not s.Folder then
		return
	end
	local character = LocalPlayer.Character
	local root = rootOf(LocalPlayer)
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or not character then
		fire("leave")
		return
	end
	s.Playing = id
	s.LastInput = -math.huge
	-- l'avatar à son poste (pieds au sol du poste, regard vers l'instrument)
	local spot = MusicData.SpotCFrame(s.StageCF, id)
	local lift = humanoid.RigType == Enum.HumanoidRigType.R6 and 3 or ((tonumber(humanoid.HipHeight) or 2) + root.Size.Y / 2)
	pcall(function()
		root.AssemblyLinearVelocity = Vector3.zero
		character:PivotTo(spot * CFrame.new(0, lift + 0.05, 0))
	end)
	setControls(false)
	local layout = layoutFor(id)
	s.UI:Open(id, layout)
	refreshOctave()
	if id == "DJ" then
		local a = anchorOf("DJ")
		s.UI:SetLoop(a and a:GetAttribute("Loop") or 0)
	end
	bindKeys(layout)
	setStagePromptsHidden(true)
end

exitLocal = function(sendLeave: boolean)
	local s = state
	if not s or not s.Playing then
		return
	end
	flush(true)
	s.Playing = nil
	pcall(function()
		ContextActionService:UnbindAction(ACTION)
	end)
	setControls(true)
	s.UI:Close()
	s.UI:ClosePicker()
	setStagePromptsHidden(false)
	if sendLeave then
		fire("leave")
	end
end

local function openPicker()
	local s = state
	if not s or not s.Folder then
		return
	end
	s.UI:OpenPicker({ SongId = s.Folder:GetAttribute("SongId"), Radio = s.Folder:GetAttribute("Radio"), Chain = s.Chain })
end

----------------------------------------------------------------------
-- Réseau
----------------------------------------------------------------------

local function onEvent(kind: any, a: any, b: any, c: any)
	local s = state
	if not s or type(kind) ~= "string" then
		return
	end
	if kind == "open" and type(a) == "string" and MusicData.STATIONS[a] then
		if s.Playing then
			exitLocal(false)
		end
		enterLocal(a)
	elseif kind == "close" then
		exitLocal(false)
	elseif kind == "busy" and type(a) == "string" then
		local st = MusicData.STATIONS[a]
		if s.Toast and st then
			pcall(s.Toast, T("Someone is already playing the %s!", T(st.Name)), Color3.fromRGB(226, 80, 90))
		end
	elseif kind == "picker" then
		openPicker()
	elseif kind == "notes" and type(b) == "number" and type(c) == "table" then
		if a == LocalPlayer.UserId then
			return
		end
		local inst = MusicData.ORDER[b]
		if not inst then
			return
		end
		for i = 1, math.min(#c // 3, MusicData.MAX_BATCH) do
			local n, v, dt = c[i * 3 - 2], c[i * 3 - 1], c[i * 3]
			if type(n) == "number" and type(v) == "number" and type(dt) == "number" then
				task.delay(math.clamp(dt, 0, 400) / 1000, function()
					if state == s then
						hit(inst, n, math.clamp(v / 100, 0.05, 1))
					end
				end)
			end
		end
	end
end

----------------------------------------------------------------------
-- Morceaux, boucles du DJ, radio
----------------------------------------------------------------------

local function stepSong(s: any, now: number)
	local folder = s.Folder
	local id = folder:GetAttribute("SongId")
	local start = folder:GetAttribute("SongStart")
	if type(id) ~= "string" or id == "" or type(start) ~= "number" then
		s.Song = nil
		return
	end
	local song = s.Song
	if not song or song.Id ~= id or song.Start ~= start then
		local data = MusicData.Song(id)
		if not data then
			s.Song = nil
			return
		end
		-- (on arrive en cours de morceau : on reprend là où il en est)
		local ptr = 1
		while data.Events[ptr] and start + data.Events[ptr].T < now - 0.05 do
			ptr += 1
		end
		song = { Id = id, Start = start, Data = data, Ptr = ptr }
		s.Song = song
	end
	local events = song.Data.Events
	while events[song.Ptr] and song.Start + events[song.Ptr].T <= now + LOOKAHEAD do
		local ev = events[song.Ptr]
		song.Ptr += 1
		local at = song.Start + ev.T
		if at >= now - 0.25 then
			local delay = math.max(0, at - now)
			if delay < 0.01 then
				hit(ev.I, ev.N, ev.V)
			else
				task.delay(delay, function()
					if state == s then
						hit(ev.I, ev.N, ev.V)
					end
				end)
			end
		end
	end
end

local function stepLoop(s: any, now: number)
	local a = anchorOf("DJ")
	local loop = a and a:GetAttribute("Loop")
	local start = a and a:GetAttribute("LoopStart")
	if type(loop) ~= "number" or loop <= 0 or type(start) ~= "number" or occupant("DJ") == 0 then
		s.LoopCursor = nil
		s.LoopId = 0
		return
	end
	if s.LoopId ~= loop or s.LoopStart ~= start then
		s.LoopId, s.LoopStart = loop, start
		s.LoopCursor = math.max(now, start) - 1e-3
		if s.Playing == "DJ" then
			s.UI:SetLoop(loop)
		end
	end
	local bar = MusicData.LOOP_BAR
	local horizon = now + LOOKAHEAD
	local cursor = s.LoopCursor or now
	if horizon <= cursor then
		return
	end
	local events = MusicData.Loop(loop)
	local first = math.floor((cursor - start) / bar)
	local last = math.floor((horizon - start) / bar)
	for k = math.max(0, first), last do
		local barStart = start + k * bar
		for _, ev in ipairs(events) do
			local at = barStart + ev.T
			if at > cursor and at <= horizon then
				task.delay(math.max(0, at - now), function()
					if state == s then
						hit(ev.I, ev.N, ev.V, "DJ")
					end
				end)
			end
		end
	end
	s.LoopCursor = horizon
end

local function stepRadio(s: any, now: number)
	local folder = s.Folder
	local index = folder:GetAttribute("Radio")
	local start = folder:GetAttribute("RadioStart")
	local emitter = s.Build and s.Build.H.Radio
	local playlist = Config.Music and Config.Music.Playlist or {}
	local track = type(index) == "number" and index > 0 and playlist[index] or nil
	local radio = s.Radio
	if not track or not emitter or not emitter.Parent then
		if radio then
			pcall(function()
				radio.Sound:Destroy()
			end)
			s.Radio = nil
		end
		return
	end
	if not radio or radio.Index ~= index or radio.Start ~= start or not radio.Sound.Parent then
		if radio then
			pcall(function()
				radio.Sound:Destroy()
			end)
		end
		local c = Config.Instruments.Radio
		local sound = Instance.new("Sound")
		sound.Name = "StageRadio"
		sound.SoundId = track.Id
		sound.Looped = true
		sound.RollOffMode = Enum.RollOffMode.InverseTapered
		sound.RollOffMinDistance = c.RollOffMin
		sound.RollOffMaxDistance = c.RollOffMax
		sound.Volume = 0
		sound.Parent = emitter
		pcall(function()
			sound:Play()
		end)
		radio = { Sound = sound, Index = index, Start = start, Synced = false }
		s.Radio = radio
	end
	local sound = radio.Sound
	if not radio.Synced and sound.IsLoaded and sound.TimeLength > 1 then
		radio.Synced = true
		pcall(function()
			sound.TimePosition = (now - (tonumber(start) or now)) % sound.TimeLength
		end)
	end
	-- (volume : réglage de la scène x volume des effets du joueur)
	local user = s.Synth and s.Synth.Volume or 1
	sound.Volume = Config.Instruments.Radio.Volume * user
end

----------------------------------------------------------------------
-- Animation du décor (30 Hz, de près)
----------------------------------------------------------------------

local function musicActive(s: any): boolean
	return s.Song ~= nil or (s.Radio ~= nil) or (s.LoopId or 0) > 0 or clockNow() - (s.LastHit or -math.huge) < 2
end

local function stepVisuals(s: any, dt: number, now: number)
	local H = s.Build and s.Build.H
	if not H then
		return
	end
	local clock = clockNow()
	-- touches relâchées
	for part, info in pairs(s.Pressed) do
		if clock >= info.Until then
			if part.Parent then
				part.CFrame = info.CF
			end
			s.Pressed[part] = nil
		end
	end
	-- fûts qui vibrent, cymbales qui oscillent, batte de grosse caisse
	local pieces = H.Drums
	if pieces then
		local moved, cfs = {}, {}
		for n, w in pairs(s.Wobble) do
			local piece = pieces[n]
			local age = clock - w.T
			if not piece or age > 1.6 then
				if piece then
					for i, p in ipairs(piece.Parts) do
						table.insert(moved, p)
						table.insert(cfs, piece.CFs[i])
					end
				end
				s.Wobble[n] = nil
			else
				local offset: CFrame
				if piece.Kind == "cymbal" then
					local ang = math.rad(9) * w.A * math.exp(-age * 2.6) * math.sin(age * 15)
					local axis = piece.Axis:Cross(UP)
					if axis.Magnitude < 1e-3 then
						axis = Vector3.new(1, 0, 0)
					end
					offset = CFrame.new(piece.Center) * CFrame.fromAxisAngle(axis.Unit, ang) * CFrame.new(-piece.Center)
				else
					local d = 0.035 * w.A * math.exp(-age * 18) * math.cos(age * 40)
					offset = CFrame.new(-piece.Axis * d)
				end
				for i, p in ipairs(piece.Parts) do
					table.insert(moved, p)
					table.insert(cfs, offset * piece.CFs[i])
				end
			end
		end
		if #moved > 0 then
			pcall(function()
				workspace:BulkMoveTo(moved, cfs, Enum.BulkMoveMode.FireCFrameChanged)
			end)
		end
	end
	local beater = H.Beater
	if beater and beater.Part.Parent then
		local hs = s.Hands.Drums
		local age = hs and (clock - hs.KickT) or 99
		local swing = age < 0.25 and math.sin(math.clamp(age / 0.25, 0, 1) * math.pi) or 0
		local strike = age < 0.25 and (1 - age / 0.25) or 0
		beater.Part.CFrame = beater.Pivot * CFrame.Angles(math.rad(-25 + 30 * strike - 5 * swing), 0, 0) * CFrame.new(0, 0.4, 0)
	end
	-- platines du DJ
	local dj = H.DJ
	if dj then
		local spinning = (s.LoopId or 0) > 0 or s.Song ~= nil or occupant("DJ") ~= 0
		local scratch = s.Scratch and (clock - s.Scratch.T) < 0.5
		for i, platter in ipairs(dj.Platters) do
			local speed = spinning and TAU * 0.55 or 0
			if scratch and i == 2 then
				speed = TAU * 2.2 * math.sin((clock - s.Scratch.T) * 25)
			end
			platter.Angle = (platter.Angle + speed * dt) % TAU
			if speed ~= 0 then
				local rot = platter.Center * CFrame.Angles(0, platter.Angle, 0) * platter.Center:Inverse()
				local parts, cfs = {}, {}
				for k, p in ipairs(platter.Parts) do
					parts[k] = p
					cfs[k] = rot * platter.CFs[k]
				end
				pcall(function()
					workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
				end)
			end
		end
		if dj.Fader and dj.Fader.Parent then
			local x = scratch and 0.18 * math.sin((clock - s.Scratch.T) * 22) or 0
			dj.Fader.CFrame = dj.FaderCF * CFrame.new(x, 0, 0)
		end
		local level = 0
		for i = 1, 6 do
			level += (s.Energy[i] or 0)
		end
		level = math.clamp(level / 4, 0, 1)
		for k, led in ipairs(dj.Meters) do
			local row = (k - 1) % 6
			local on = level * 6 > row + 0.3
			local c = led:GetAttribute("OnColor")
			led.Color = on and (typeof(c) == "Color3" and c or Color3.new(0, 1, 0)) or Color3.fromRGB(40, 40, 40)
			led.Material = on and Enum.Material.Neon or Enum.Material.SmoothPlastic
		end
		for i, b in ipairs(dj.Bars) do
			local e = s.Energy[math.clamp(i * 24 // 16, 1, 24)] or 0
			b.Size = UDim2.fromScale(1 / 16 - 0.01, 0.05 + 0.6 * e)
		end
	end
	-- écran LED : égaliseur, titre, progression
	local screen = H.Screen
	if screen then
		for i, b in ipairs(screen.Bars) do
			local e = s.Energy[i] or 0
			b.Size = UDim2.fromScale(1 / 24 - 0.012, 0.06 + 0.94 * e)
		end
		local song = s.Song
		local title, sub, progress
		if song then
			local data = song.Data
			title = data.Icon .. " " .. T(data.Name)
			sub = "♪ " .. T(data.Author)
			progress = math.clamp((now - song.Start) / data.Duration, 0, 1)
		elseif s.Radio then
			local track = (Config.Music.Playlist or {})[s.Radio.Index]
			title = "📻 " .. tostring(track and track.Name or "Lo-fi")
			sub = T("Lo-fi radio on the stage")
			progress = 0
		else
			title = "🎵 DOPAMINE LIVE"
			sub = T("[E] Play an instrument · Jukebox: songs")
			progress = 0
		end
		if screen.Title.Text ~= title then
			screen.Title.Text = title
		end
		if screen.Sub.Text ~= sub then
			screen.Sub.Text = sub
		end
		screen.Progress.Size = UDim2.fromScale(0.88 * progress, 0.02)
		screen.Grad.Rotation = (screen.Grad.Rotation + dt * (musicActive(s) and 12 or 3)) % 360
	end
	for i = 1, 24 do
		s.Energy[i] = (s.Energy[i] or 0) * math.exp(-dt * 5)
	end
	-- lyres motorisées + faisceaux (la nuit, quand la musique joue)
	local active = musicActive(s)
	local night = isNight()
	for _, head in ipairs(H.Heads or {}) do
		if head.Head.Parent then
			local t = clock + head.Phase
			local yaw = active and math.rad(38) * math.sin(t * 0.8) or 0
			local pitch = active and math.rad(22 + 16 * math.sin(t * 1.1)) or math.rad(10)
			local yokeCF = head.Base * CFrame.new(0, -0.22, 0) * CFrame.Angles(0, yaw, 0)
			local pivot = yokeCF * CFrame.new(0, -0.5, 0) * CFrame.Angles(pitch, 0, 0)
			local lensCF = pivot * CFrame.new(0, -0.26, 0) * CFrame.Angles(0, 0, math.rad(90))
			pcall(function()
				workspace:BulkMoveTo({ head.Yoke, head.Arms[1], head.Arms[2], head.Head, head.Lens }, {
					yokeCF,
					yokeCF * CFrame.new(-0.36, -0.28, 0),
					yokeCF * CFrame.new(0.36, -0.28, 0),
					pivot,
					lensCF,
				}, Enum.BulkMoveMode.FireCFrameChanged)
			end)
			local dir = -pivot.UpVector
			local deckY = s.StageCF.Y + MusicData.DECK_TOP
			if dir.Y < -0.1 then
				local dist = (lensCF.Position.Y - deckY) / -dir.Y
				head.Target.CFrame = CFrame.new(lensCF.Position + dir * dist)
			end
			head.Beam.Enabled = active and night
		end
	end
	-- lueurs (projecteurs, rampe, juke-box) : la nuit ; pulsent avec la musique
	for _, p in ipairs(s.Glows) do
		if p.Parent then
			p.Material = night and Enum.Material.Neon or Enum.Material.SmoothPlastic
		end
	end
	-- écran du synthé
	if H.SynthLCD and s.Hands.Synth then
		local n = s.Hands.Synth.R.Point and s.Hands.Synth.Note or nil
		H.SynthLCD.Text = n and ("PAD 01  " .. MusicData.NoteName(n)) or "PAD 01"
	end
end

----------------------------------------------------------------------
-- Musiciens : poses (Stepped) et accessoires portés (Heartbeat)
----------------------------------------------------------------------

-- Point visé par une main : au coup (frappe) puis rebond vers le survol
local function handPoint(side: any, hover: Vector3, lift: Vector3, clock: number, default: Vector3): Vector3
	local point = side.Point or default
	local age = clock - (side.HitT or -math.huge)
	local up = 1
	if age < 0.05 then
		up = 0 -- (frappe : la main est en bas)
	elseif age < 0.22 then
		up = smooth((age - 0.05) / 0.17)
	end
	if age > 2.5 then
		point = default
	end
	return point + hover + lift * up
end

local function poseSpec(s: any, id: string, rig: any, clock: number): any
	local H = s.Build and s.Build.H
	if not H then
		return nil
	end
	local hs = handState(s, id)
	local spec: any = {}
	local st = MusicData.STATIONS[id]
	local spot = MusicData.SpotCFrame(s.StageCF, id)
	local toward = spot.LookVector -- (du musicien vers l'instrument)
	local beat = s.Song and (60 / (MusicData.SONGS[MusicData.SONG_INDEX[s.Song.Id] or 1].Bpm)) or 0.5
	spec.Nod = musicActive(s) and 5 * math.sin(clock * TAU / beat) or 0
	if id == "Piano" or id == "Synth" then
		local keys = H.Keys[id]
		local c3, g4 = keyFor(keys, 55), keyFor(keys, 67)
		local back = -toward * 0.12
		spec.L = handPoint(hs.L, back + UP * 0.12, UP * 0.2, clock, c3 and c3.Top or spot.Position)
		spec.R = handPoint(hs.R, back + UP * 0.12, UP * 0.2, clock, g4 and g4.Top or spot.Position)
		spec.Lean = id == "Piano" and 12 or 8
		if id == "Piano" then
			local pf = H.Frames.Piano
			spec.Seat = s.StageCF.Y + MusicData.DECK_TOP + 1.46
			spec.Feet = { R = (pf * CFrame.new(0.3, 0.3, -0.25)).Position, L = (pf * CFrame.new(-0.35, 0.3, -0.1)).Position }
		end
	elseif id == "Xylophone" then
		local keys = H.Keys.Xylophone
		local a, b = keyFor(keys, 67), keyFor(keys, 79)
		local hover = -toward * 0.9 + UP * 0.25
		spec.L = handPoint(hs.L, hover, UP * 0.4, clock, a and a.Top or spot.Position)
		spec.R = handPoint(hs.R, hover, UP * 0.4, clock, b and b.Top or spot.Position)
		spec.Lean = 10
	elseif id == "Drums" then
		local pieces = H.Drums
		local df = H.Frames.Drums
		local snare = pieces and pieces[MusicData.DRUM.Snare]
		local hat = pieces and pieces[MusicData.DRUM.HatClosed]
		local hover = -toward * 0.85 + UP * 0.25
		spec.L = handPoint(hs.L, hover, UP * 0.55, clock, snare and snare.Hit or spot.Position)
		spec.R = handPoint(hs.R, hover, UP * 0.55, clock, hat and hat.Hit or spot.Position)
		spec.Seat = s.StageCF.Y + MusicData.DECK_TOP + MusicData.RISERS.Drums.H + 1.5
		local kickAge = clock - hs.KickT
		local lift = kickAge < 0.2 and 0.28 * math.sin(math.clamp(kickAge / 0.2, 0, 1) * math.pi) or 0
		spec.Feet = { R = (df * CFrame.new(0.25, 0.32 + lift, 5.9)).Position, L = (df * CFrame.new(-0.9, 0.32, 5.85)).Position }
		spec.Lean = 8
	elseif id == "Guitar" or id == "Bass" then
		local inst = id == "Guitar" and H.Guitar or H.Bass
		local g = s.Worn[id]
		if g and inst then
			local u = math.clamp(((hs.Note or 60) % 24) / 24, 0, 1)
			local neckX = inst.NeckStart + inst.NeckLen * (0.2 + 0.45 * (1 - u))
			spec.L = (g * CFrame.new(neckX, -0.02, 0.2)).Position
			local age = clock - hs.R.HitT
			local strum = age < 0.12 and (1 - age / 0.12) * hs.Strum or 0
			spec.R = (g * CFrame.new(-0.12 * inst.K, 0.05 + 0.2 * strum, 0.22)).Position
			spec.LPole = Vector3.new(-1, -0.8, 0.3)
			spec.RPole = Vector3.new(1, -0.3, 0.6)
		end
		spec.Lean = 4
	elseif id == "DJ" then
		local dj = H.DJ
		local p = dj and dj.Platters[2]
		local center = p and p.Center.Position or spot.Position
		local sAge = clock - hs.ScratchT
		local wiggle = sAge < 0.5 and 0.18 * math.sin(sAge * 25) or 0.03 * math.sin(clock * 2)
		spec.R = center + UP * 0.12 - toward * 0.25 + spot.RightVector * wiggle
		spec.L = (dj and dj.FaderCF.Position or spot.Position) + UP * 0.15 - toward * 0.1
		if clock - hs.UpT < 0.7 then
			local e = math.sin(math.clamp((clock - hs.UpT) / 0.7, 0, 1) * math.pi)
			spec.L = spec.L:Lerp(spot.Position + UP * 7 - spot.RightVector * 0.8, e)
		end
		spec.Lean = 10
		spec.Nod = musicActive(s) and 9 * math.sin(clock * TAU / beat) or 0
	end
	if st.Seated and not spec.Seat then
		spec.Seat = spot.Y + 1.45
	end
	return spec
end

local function stepPoses(dt: number)
	local s = state
	if not s or not s.Folder or not s.Build then
		return
	end
	local clock = clockNow()
	local me = rootOf(LocalPlayer)
	local seen = {}
	for _, id in ipairs(MusicData.ORDER) do
		local userId = occupant(id)
		local player = userId ~= 0 and Players:GetPlayerByUserId(userId) or nil
		local character = player and player.Character
		local root = rootOf(player)
		if character and root and (not me or (root.Position - me.Position).Magnitude < POSE_R) then
			local entry = s.Rigs[character]
			if not entry or entry.Id ~= id then
				if entry then
					MusicPose.Release(entry.Rig)
				end
				local rig = MusicPose.Rig(character)
				entry = rig and { Rig = rig, Id = id, W = 0 } or nil
				s.Rigs[character] = entry
			end
			if entry then
				seen[character] = true
				entry.W = math.min(1, entry.W + dt / 0.35)
				local spec = poseSpec(s, id, entry.Rig, clock)
				if spec then
					local ok, err = pcall(MusicPose.Solve, entry.Rig, spec, smooth(entry.W))
					if not ok and not s.PoseWarned then
						s.PoseWarned = true
						warn("[MusicStage] pose : " .. tostring(err))
					end
				end
			end
		end
	end
	for character, entry in pairs(s.Rigs) do
		if not seen[character] then
			MusicPose.Release(entry.Rig)
			s.Rigs[character] = nil
		end
	end
end

-- Guitare / basse portées, baguettes, maillets : suivent les mains
local function stepProps()
	local s = state
	local H = s and s.Build and s.Build.H
	if not H then
		return
	end
	for _, id in ipairs({ "Guitar", "Bass" }) do
		local inst = id == "Guitar" and H.Guitar or H.Bass
		if inst then
			local userId = occupant(id)
			local player = userId ~= 0 and Players:GetPlayerByUserId(userId) or nil
			local entry = player and player.Character and s.Rigs[player.Character]
			local torso = entry and entry.Rig.Torso
			local frame: CFrame? = nil
			if torso and torso.Parent then
				-- manche vers la gauche du musicien, relevé de 22°, cordes vers l'avant
				local tcf = torso.CFrame
				local scale = entry.Rig.Scale
				local pos = tcf * Vector3.new(0.12 * scale, -0.55 * scale, -0.7 * scale)
				local x = (-tcf.RightVector * math.cos(math.rad(22)) + tcf.UpVector * math.sin(math.rad(22))).Unit
				local z = tcf.LookVector
				local y = z:Cross(x).Unit
				z = x:Cross(y).Unit
				frame = CFrame.fromMatrix(pos, x, y, z)
			end
			local target = frame or inst.Idle
			s.Worn[id] = frame
			-- (au repos : replacé une seule fois, puis plus rien à faire)
			if frame or not inst.AtIdle then
				inst.AtIdle = frame == nil
				local parts, cfs = {}, {}
				for k, p in ipairs(inst.Parts) do
					parts[k] = p
					cfs[k] = target * inst.Rel[k]
				end
				pcall(function()
					workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
				end)
			end
			-- sangle : du bas du corps à l'épaule gauche, puis à la corne
			local strapA, strapB = inst.Straps[1], inst.Straps[2]
			if frame and torso then
				local shoulder = torso.CFrame * Vector3.new(-0.55, 0.85, 0.35)
				local a = frame * Vector3.new(-0.85 * inst.K, 0, -0.08)
				local b = frame * Vector3.new(0.72 * inst.K, 0.32, -0.08)
				for _, pair in ipairs({ { strapA, a, shoulder }, { strapB, shoulder, b } }) do
					local p0, p1 = pair[2], pair[3]
					pair[1].Size = Vector3.new(0.16, 0.03, math.max(0.05, (p1 - p0).Magnitude))
					pair[1].CFrame = CFrame.lookAt((p0 + p1) / 2, p1)
					pair[1].Transparency = 0
				end
			else
				strapA.Transparency = 1
				strapB.Transparency = 1
			end
		end
	end
	-- baguettes (batterie) et maillets (xylophone)
	local function holdStick(part: BasePart, hand: CFrame?, tip: Vector3?, length: number, rest: CFrame)
		if hand and tip then
			local from = hand.Position
			local dir = tip - from
			if dir.Magnitude < 0.05 then
				dir = hand.LookVector
			end
			local to = from + dir.Unit * length
			local cf = CFrame.lookAt((from + to) / 2, to) * CFrame.Angles(0, math.rad(90), 0)
			part.CFrame = cf
		elseif part.CFrame ~= rest then
			part.CFrame = rest
		end
	end
	s.Rest = s.Rest or {}
	local drummer = occupant("Drums")
	local dPlayer = drummer ~= 0 and Players:GetPlayerByUserId(drummer) or nil
	local dEntry = dPlayer and dPlayer.Character and s.Rigs[dPlayer.Character]
	local hs = s.Hands.Drums
	for side, stick in pairs(H.Sticks or {}) do
		s.Rest[stick] = s.Rest[stick] or stick.CFrame
		local hand = dEntry and MusicPose.Hand(dEntry.Rig, side)
		local tip = hs and hs[side].Point or (H.Drums and H.Drums[MusicData.DRUM.Snare] and H.Drums[MusicData.DRUM.Snare].Hit)
		holdStick(stick, hand, hand and tip or nil, 1.35, s.Rest[stick])
	end
	local xylo = occupant("Xylophone")
	local xPlayer = xylo ~= 0 and Players:GetPlayerByUserId(xylo) or nil
	local xEntry = xPlayer and xPlayer.Character and s.Rigs[xPlayer.Character]
	local xs = s.Hands.Xylophone
	for side, mallet in pairs(H.Mallets or {}) do
		s.Rest[mallet.Handle] = s.Rest[mallet.Handle] or mallet.Handle.CFrame
		s.Rest[mallet.Head] = s.Rest[mallet.Head] or mallet.Head.CFrame
		local hand = xEntry and MusicPose.Hand(xEntry.Rig, side)
		local keys = H.Keys.Xylophone
		local default = keyFor(keys, side == "L" and 67 or 79)
		local tip = xs and xs[side].Point or (default and default.Top)
		holdStick(mallet.Handle, hand, hand and tip or nil, 1.05, s.Rest[mallet.Handle])
		if hand and tip then
			local from = hand.Position
			local dir = (tip - from)
			mallet.Head.CFrame = CFrame.new(from + (dir.Magnitude > 0.05 and dir.Unit or hand.LookVector) * 1.1)
		elseif mallet.Head.CFrame ~= s.Rest[mallet.Head] then
			mallet.Head.CFrame = s.Rest[mallet.Head]
		end
	end
end

----------------------------------------------------------------------
-- Construction en flux
----------------------------------------------------------------------

local function detail(): string
	local ok, q = pcall(GraphicsQuality.Get)
	return ok and type(q) == "table" and q.Detail or "Medium"
end

local function dropBuild(s: any)
	if s.Radio then
		pcall(function()
			s.Radio.Sound:Destroy()
		end)
		s.Radio = nil
	end
	for _, entry in pairs(s.Rigs) do
		MusicPose.Release(entry.Rig)
	end
	table.clear(s.Rigs)
	if s.Build then
		s.Build:Destroy()
		s.Build = nil
	end
	s.Synth:Destroy()
	s.Synth = MusicSynth.new()
	table.clear(s.Pressed)
	table.clear(s.Wobble)
	s.Glows = {}
	s.Rest = {}
end

local function localizePrompts(s: any)
	if not s.Folder then
		return
	end
	for _, d in ipairs(s.Folder:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			local action, object = d:GetAttribute("LocAction"), d:GetAttribute("LocObject")
			if type(action) == "string" then
				local text = T(action)
				if d.ActionText ~= text then
					d.ActionText = text
				end
			end
			if type(object) == "string" then
				local text = T(object)
				if d.ObjectText ~= text then
					d.ObjectText = text
				end
			end
		end
	end
	local H = s.Build and s.Build.H
	local juke = H and H.JukeText
	if juke then
		local key = juke:GetAttribute("LocText")
		if type(key) == "string" then
			juke.Text = T(key)
		end
	end
end

----------------------------------------------------------------------
-- API
----------------------------------------------------------------------

function MusicStage.Start(options: any?)
	if state then
		MusicStage.Stop()
	end
	local s: any = {
		Conns = {},
		Toast = options and options.Toast or nil,
		Folder = nil,
		StageCF = CFrame.identity,
		Build = nil,
		Synth = MusicSynth.new(),
		UI = nil,
		Playing = nil,
		Octave = {},
		Out = {},
		OutStart = 0,
		Song = nil,
		Radio = nil,
		LoopId = 0,
		Pressed = {},
		Wobble = {},
		Energy = {},
		Hands = {},
		Rigs = {},
		Worn = {},
		Glows = {},
		Clock = 0,
		VisualT = 0,
		SearchT = 99,
		LocT = 0,
		Chain = false,
		KeyMap = {},
	}
	state = s
	local callbacks = {
		Note = function(value: number, vel: number)
			playLocal(value, vel)
		end,
		Leave = function()
			exitLocal(true)
		end,
		Picker = function()
			openPicker()
		end,
		Song = function(id: string, mode: string)
			fire("song", id, mode)
		end,
		StopSong = function()
			fire("song", "", "one")
		end,
		Radio = function(index: number)
			fire("radio", index)
		end,
		Chain = function(on: boolean)
			s.Chain = on
		end,
		Octave = function(delta: number)
			local id = s.Playing
			if not id or MusicData.STATIONS[id].Kind ~= "keys" then
				return
			end
			local range = LOW_RANGE[id] or { 24, 72 }
			local low = math.clamp((s.Octave[id] or DEFAULT_LOW[id]) + 12 * delta, range[1], range[2])
			s.Octave[id] = low
			local layout = layoutFor(id)
			s.UI:Open(id, layout)
			refreshOctave()
			bindKeys(layout)
		end,
	}
	s.UICallbacks = callbacks
	s.UI = MusicUI.new(callbacks)
	local r = remote()
	if r then
		table.insert(s.Conns, r.OnClientEvent:Connect(function(...)
			local ok, err = pcall(onEvent, ...)
			if not ok then
				warn("[MusicStage] " .. tostring(err))
			end
		end))
	end
	table.insert(s.Conns, RunService.Stepped:Connect(function(_t: number, dt: number)
		if state == s and s.Build ~= nil and s.Build.Done then
			local ok, err = pcall(stepPoses, dt)
			if not ok and not s.PoseWarned then
				s.PoseWarned = true
				warn("[MusicStage] musiciens : " .. tostring(err))
			end
		end
	end))
	table.insert(s.Conns, RunService.Heartbeat:Connect(function()
		if state == s and s.Build and s.Build.Done then
			local ok, err = pcall(stepProps)
			if not ok and not s.PropWarned then
				s.PropWarned = true
				warn("[MusicStage] accessoires : " .. tostring(err))
			end
		end
	end))
end

function MusicStage.Step(dt: number)
	local s = state
	if not s then
		return
	end
	s.Clock += dt
	if not s.Folder or not s.Folder.Parent then
		s.SearchT += dt
		if s.SearchT < 2 then
			return
		end
		s.SearchT = 0
		s.Folder = findStage()
		if not s.Folder then
			return
		end
		local cf = s.Folder:GetAttribute("StageCF")
		s.StageCF = typeof(cf) == "CFrame" and cf or CFrame.identity
	end
	local root = rootOf(LocalPlayer)
	local camera = workspace.CurrentCamera
	local focus = root and root.Position or (camera and camera.CFrame.Position) or s.StageCF.Position
	local dist = (focus - s.StageCF.Position).Magnitude
	local scale = GraphicsQuality.DetailScale()
	if not s.Build and dist < BUILD_R * scale then
		local town = workspace:FindFirstChild("DopamineTown")
		s.Build = MusicStageBuild.new(s.StageCF, town or workspace, detail())
	elseif s.Build and dist > DROP_R * math.max(scale, 1) then
		if s.Playing then
			exitLocal(true)
		end
		dropBuild(s)
	end
	local build = s.Build
	if build and not build.Done then
		if build:Step() then
			for _, d in ipairs(build.Model:GetDescendants()) do
				if d:IsA("BasePart") and d:GetAttribute("MusicGlow") == true then
					table.insert(s.Glows, d)
				end
			end
		end
	end
	s.Synth:Step(dt)
	local now = serverNow()
	if dist < MusicData.HEAR_RADIUS + 20 then
		stepSong(s, now)
		stepLoop(s, now)
	else
		s.Song = nil
	end
	stepRadio(s, now)
	flush(false)
	-- quitter si l'avatar a été déplacé loin de son poste (téléportation…)
	if s.Playing and root then
		local spot = MusicData.SpotCFrame(s.StageCF, s.Playing)
		local flat = Vector3.new(root.Position.X - spot.Position.X, 0, root.Position.Z - spot.Position.Z).Magnitude
		if flat > MusicData.LEAVE_RANGE then
			exitLocal(true)
		end
	end
	s.VisualT += dt
	if build and dist < BUILD_R and s.VisualT >= VISUAL_STEP then
		local ok, err = pcall(stepVisuals, s, s.VisualT, now)
		if not ok and not s.VisualWarned then
			s.VisualWarned = true
			warn("[MusicStage] décor animé : " .. tostring(err))
		end
		s.VisualT = 0
	end
	s.LocT += dt
	if s.LocT > 1 then
		s.LocT = 0
		pcall(localizePrompts, s)
		if s.Playing then
			setStagePromptsHidden(true)
		end
	end
	-- pastille "en cours" (près de la scène)
	if s.UI then
		s.UI:Step()
		local song = s.Song
		if dist < 80 and song then
			local elapsed = math.max(0, now - song.Start)
			local total = song.Data.Duration
			s.UI:SetNowPlaying(string.format("%s %s · %d:%02d / %d:%02d", song.Data.Icon, T(song.Data.Name), elapsed // 60, math.floor(elapsed) % 60, total // 60, math.floor(total) % 60), elapsed / total)
		elseif dist < 80 and s.Radio then
			local track = (Config.Music.Playlist or {})[s.Radio.Index]
			s.UI:SetNowPlaying("📻 " .. T("Stage radio") .. " · " .. tostring(track and track.Name or ""), 0)
		else
			s.UI:SetNowPlaying(nil)
		end
	end
end

function MusicStage.Stop()
	local s = state
	if not s then
		return
	end
	if s.Playing then
		exitLocal(true)
	end
	for _, c in ipairs(s.Conns) do
		c:Disconnect()
	end
	dropBuild(s)
	s.Synth:Destroy()
	if s.UI then
		s.UI:Destroy()
		s.UI = nil
	end
	state = nil
end

function MusicStage.Debug(): any
	local s = state
	return {
		State = s,
		Hit = hit,
		PlayLocal = playLocal,
		OnEvent = onEvent,
		Flush = flush,
		Layout = layoutFor,
		StepPoses = stepPoses,
		StepProps = stepProps,
		PoseSpec = poseSpec,
	}
end

return MusicStage
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="214">
          <Properties>
            <string name="Name">MusicStageBuild</string>
            <string name="Source"><![CDATA[--[[
	MusicStageBuild (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > MusicStageBuild

	🎵 DÉCOR de la scène musicale de la place (v9.9, MUSIC99), construit par
	chaque client (MusicStage), EN FLUX : un morceau par image (Steps).
	Échelle réelle (avatar ≈ 5,2 studs ≈ 1,75 m -> 1 m ≈ 3 studs) :
	  - scène : plancher en bois sombre (serveur), jupe en tissu plissé,
	    nez de marche blancs, câbles, retours de scène, 3 pieds de micro ;
	  - portique d'éclairage en ALUMINIUM TRIANGULÉ (4 tours + grill),
	    toit à deux pans, bandeau "DOPAMINE LIVE", 6 PAR, 4 lyres
	    motorisées (faisceaux la nuit), rideau de fond plissé, ÉCRAN LED
	    (titre du morceau, égaliseur) ;
	  - sono : 2 piles (caisson + tête) au sol, 2 "line arrays" suspendus ;
	  - 🎹 piano à queue (caisse galbée, couvercle ouvert sur sa béquille,
	    table d'harmonie, cadre doré, cordes, 88 touches, lyre et pédales,
	    banquette capitonnée) ;
	  - 🥁 batterie (grosse caisse et pédale, caisse claire, 2 toms, tom
	    basse, charleston, crash, ride, tabouret, tapis) ;
	  - 🎸 guitare électrique + ampli combo, 🎸 basse + ampli "stack",
	    sur leurs stands ; 🎶 xylophone (37 lames, tubes résonateurs),
	    🎛️ synthé 49 touches sur stand en X ; 🎧 cabine DJ (2 platines,
	    table de mixage, ordinateur, casque, façade LED) ;
	  - 📻 juke-box au pied de la scène (E : morceaux, F : radio).
	Tout est ancré, sans collision (sauf quelques blocs invisibles "Block"
	pour ne pas traverser les instruments, côté client), sans vraie
	lumière (les 2 projecteurs sont côté serveur).

	API :
	  MusicStageBuild.new(stageCF, parent, detail) -> Build
	  build:Step() -> boolean (true = terminé)   un morceau par appel
	  build.H : poignées pour l'animation (touches, fûts, cymbales,
	    instruments portés, platines, écran, lyres, émetteurs de son…)
	  build:Destroy()
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MusicData = require(ReplicatedStorage.Shared.MusicData)

local MusicStageBuild = {}
MusicStageBuild.__index = MusicStageBuild

local M = Enum.Material
local BALL = Enum.PartType.Ball
local CYL = Enum.PartType.Cylinder
local rad = math.rad

local BLACK = Color3.fromRGB(24, 24, 28)
local LACQUER = Color3.fromRGB(14, 14, 18)
local FABRIC = Color3.fromRGB(30, 29, 34)
local FABRIC2 = Color3.fromRGB(38, 37, 43)
local CHROME = Color3.fromRGB(212, 214, 222)
local ALU = Color3.fromRGB(190, 194, 202)
local STEEL = Color3.fromRGB(70, 72, 80)
local BRASS = Color3.fromRGB(208, 170, 88)
local GOLD = Color3.fromRGB(214, 176, 96)
local IVORY = Color3.fromRGB(248, 245, 236)
local EBONY = Color3.fromRGB(20, 20, 24)
local WHITE = Color3.fromRGB(255, 255, 255)
local TAPE = Color3.fromRGB(236, 236, 228)
local SPRUCE = Color3.fromRGB(222, 188, 138)
local ROSEWOOD = Color3.fromRGB(74, 44, 34)
local MAPLE = Color3.fromRGB(232, 198, 146)
local SHELL = Color3.fromRGB(38, 76, 168) -- batterie : bleu pailleté
local HEAD = Color3.fromRGB(238, 234, 224)
local BRONZE = Color3.fromRGB(206, 164, 82)
local PINK = Color3.fromRGB(255, 132, 184)
local HOT = Color3.fromRGB(236, 72, 140)
local CYAN = Color3.fromRGB(110, 220, 255)
local LILAC = Color3.fromRGB(186, 150, 246)
local WALNUT = Color3.fromRGB(118, 70, 42)

export type Build = typeof(setmetatable(
	{} :: {
		CF: CFrame,
		Model: Model,
		Detail: string,
		H: any,
		Index: number,
		Group: Instance,
		Count: number,
		Done: boolean,
	},
	MusicStageBuild
))

----------------------------------------------------------------------
-- Fabrique de pièces
----------------------------------------------------------------------

local function newPart(self: any, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?, className: string?): BasePart
	local p = Instance.new((className or "Part") :: any) :: BasePart
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		(p :: Part).Shape = shape
	end
	p.Parent = self.Group
	self.Count += 1
	return p
end

-- Pièce en repère local de la scène
local function box(self: any, name: string, size: Vector3, lcf: CFrame, color: Color3, material: Enum.Material?): BasePart
	return newPart(self, name, size, self.CF * lcf, color, material)
end

-- Cylindre entre deux points (monde)
local function rodW(self: any, name: string, a: Vector3, b: Vector3, d: number, color: Color3, material: Enum.Material?): BasePart
	local len = (b - a).Magnitude
	local mid = (a + b) / 2
	local cf = CFrame.lookAt(mid, b) * CFrame.Angles(0, rad(90), 0)
	if len < 1e-3 then
		cf = CFrame.new(mid)
	end
	return newPart(self, name, Vector3.new(math.max(len, 0.02), d, d), cf, color, material, CYL)
end

-- Cylindre dont l'axe = `axis` (monde), centre `c`
local function cylW(self: any, name: string, c: Vector3, axis: Vector3, len: number, d: number, color: Color3, material: Enum.Material?): BasePart
	local a = axis.Unit
	local up = math.abs(a.Y) > 0.95 and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0)
	local cf = CFrame.lookAt(c, c + a, up) * CFrame.Angles(0, rad(90), 0)
	return newPart(self, name, Vector3.new(len, d, d), cf, color, material, CYL)
end

local function ballW(self: any, name: string, c: Vector3, d: number, color: Color3, material: Enum.Material?): BasePart
	return newPart(self, name, Vector3.new(d, d, d), CFrame.new(c), color, material, BALL)
end

-- Triangle rectangle (coin droit R, côtés d1·L1 et d2·L2), épaisseur `t`
-- verticale ; R, d1, d2 dans le repère `frame`
local function tri(self: any, name: string, frame: CFrame, R: Vector3, d1: Vector3, L1: number, d2: Vector3, L2: number, t: number, color: Color3, material: Enum.Material?): BasePart?
	if L1 < 0.02 or L2 < 0.02 then
		return nil
	end
	local y = frame:VectorToWorldSpace(d1.Unit)
	local z = -frame:VectorToWorldSpace(d2.Unit)
	local x = y:Cross(z)
	local center = frame:PointToWorldSpace(R + d1.Unit * (L1 / 2) + d2.Unit * (L2 / 2))
	return newPart(self, name, Vector3.new(t, L1, L2), CFrame.fromMatrix(center, x, y, z), color, material, nil, "WedgePart")
end

local function glow(p: BasePart, color: Color3): BasePart
	p.Color = color
	p:SetAttribute("MusicGlow", true)
	return p
end

local function surface(host: BasePart, face: Enum.NormalId, pps: number, lightInfluence: number?): SurfaceGui
	local g = Instance.new("SurfaceGui")
	g.Face = face
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = pps
	g.LightInfluence = lightInfluence or 0.3
	g.Brightness = 1
	g.MaxDistance = 220
	g.ClipsDescendants = true
	g.Parent = host
	return g
end

local function label(parent: Instance, name: string, text: string, pos: UDim2, size: UDim2, color: Color3, font: Enum.Font?): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundTransparency = 1
	l.Position = pos
	l.Size = size
	l.Font = font or Enum.Font.FredokaOne
	l.TextColor3 = color
	l.TextScaled = true
	l.Text = text
	l.Parent = parent
	return l
end

----------------------------------------------------------------------
-- Portique (treillis aluminium)
----------------------------------------------------------------------

-- Poutre treillis carrée de `a` à `b` (repère local), largeur w ; faces
-- triangulées : "all" ou { indices 1..4 } ; pas `s`
local function truss(self: any, a: Vector3, b: Vector3, w: number, faces: { number }, s: number)
	local A, B = self.CF:PointToWorldSpace(a), self.CF:PointToWorldSpace(b)
	local dir = (B - A).Unit
	local len = (B - A).Magnitude
	local u = math.abs(dir.Y) > 0.9 and self.CF.RightVector or self.CF.UpVector
	local v = dir:Cross(u).Unit
	u = v:Cross(dir).Unit
	local h = w / 2 - 0.07
	local corners = { u * h + v * h, -u * h + v * h, -u * h - v * h, u * h - v * h }
	for i, o in ipairs(corners) do
		rodW(self, "Chord" .. i, A + o, B + o, 0.13, ALU, M.Metal)
	end
	local n = math.max(1, math.floor(len / s + 0.5))
	local step = len / n
	for _, f in ipairs(faces) do
		local c1, c2 = corners[f], corners[f % 4 + 1]
		for i = 0, n - 1 do
			local p1 = A + dir * (i * step) + (i % 2 == 0 and c1 or c2)
			local p2 = A + dir * ((i + 1) * step) + (i % 2 == 0 and c2 or c1)
			rodW(self, "Lace", p1, p2, 0.06, ALU, M.Metal)
		end
	end
end

----------------------------------------------------------------------
-- Les étapes de construction
----------------------------------------------------------------------

local STEPS: { { string } } = {}
local BUILDERS: { [string]: (self: any) -> () } = {}

local function step(name: string, fn: (self: any) -> ())
	table.insert(STEPS, { name })
	BUILDERS[name] = fn
end

local D = MusicData.DECK
local TOP = MusicData.DECK_TOP

-- 1. Finitions de la scène : jupe plissée, nez de marche, bandes, câbles
step("Deck", function(self)
	local skirtH = TOP - 0.02 + 0.28 -- (du pavé jusque sous le plancher)
	local y = (TOP - 0.04 + -0.26) / 2
	local fold = self.Detail == "Low" and 2.4 or 1.1
	-- devant (de part et d'autre des marches), côtés, fond
	local function skirt(x0: number, x1: number, z: number, alongX: boolean, outward: number)
		local len = x1 - x0
		local n = math.max(1, math.floor(len / fold + 0.5))
		local w = len / n
		for i = 0, n - 1 do
			local c = x0 + (i + 0.5) * w
			local depth = (i % 2 == 0) and 0.07 or 0.1
			local off = z + outward * (0.03 + depth / 2)
			local color = (i % 2 == 0) and FABRIC or FABRIC2
			if alongX then
				box(self, "Skirt", Vector3.new(w + 0.02, skirtH, depth), CFrame.new(c, y, off), color, M.Fabric)
			else
				box(self, "Skirt", Vector3.new(depth, skirtH, w + 0.02), CFrame.new(off, y, c), color, M.Fabric)
			end
		end
	end
	local sx = MusicData.STEPS.X
	skirt(D.X0, -sx, D.Z0, true, -1)
	skirt(sx, D.X1, D.Z0, true, -1)
	skirt(D.Z0, D.Z1, D.X0, false, -1)
	skirt(D.Z0, D.Z1, D.X1, false, 1)
	-- bande blanche au bord du plancher (sécurité), nez de marche
	box(self, "EdgeTape", Vector3.new(D.X1 - D.X0 - 0.2, 0.06, 0.12), CFrame.new(0, TOP, D.Z0 + 0.12), TAPE, M.Fabric)
	local S = MusicData.STEPS
	for i = 1, S.Count do
		local stepTop = i * S.Rise
		local z0 = D.Z0 - (S.Count - i) * S.Depth - S.Depth
		box(self, "StepNose", Vector3.new(S.X * 2 - 0.2, 0.06, 0.12), CFrame.new(0, stepTop, z0 + 0.1), TAPE, M.Fabric)
		-- contremarche en tissu noir (légèrement devant la marche)
		box(self, "StepRiser", Vector3.new(S.X * 2 - 0.04, S.Rise - 0.06, 0.05), CFrame.new(0, stepTop - S.Rise / 2 - 0.03, z0 - 0.03), FABRIC, M.Fabric)
	end
	-- jupe des praticables + bord blanc
	for name, r in pairs(MusicData.RISERS) do
		local top = TOP + r.H
		local h = r.H - 0.04
		box(self, name .. "RiserSkirt", Vector3.new(r.X1 - r.X0 + 0.02, h, 0.06), CFrame.new((r.X0 + r.X1) / 2, TOP + h / 2 + 0.01, r.Z0 - 0.04), FABRIC, M.Fabric)
		box(self, name .. "RiserTape", Vector3.new(r.X1 - r.X0 - 0.2, 0.05, 0.1), CFrame.new((r.X0 + r.X1) / 2, top, r.Z0 + 0.1), TAPE, M.Fabric)
		if r.X0 > D.X0 + 0.1 then
			box(self, name .. "RiserSide", Vector3.new(0.06, h, r.Z1 - r.Z0 - 0.02), CFrame.new(r.X0 - 0.04, TOP + h / 2 + 0.01, (r.Z0 + r.Z1) / 2), FABRIC, M.Fabric)
		end
		if r.X1 < D.X1 - 0.1 then
			box(self, name .. "RiserSide", Vector3.new(0.06, h, r.Z1 - r.Z0 - 0.02), CFrame.new(r.X1 + 0.04, TOP + h / 2 + 0.01, (r.Z0 + r.Z1) / 2), FABRIC, M.Fabric)
		end
	end
	-- câbles noirs au sol (des instruments vers le boîtier de scène au fond)
	local snake = Vector3.new(-9.2, TOP, 7.0)
	box(self, "SnakeBox", Vector3.new(0.9, 0.5, 0.6), CFrame.new(snake.X, TOP + 0.22, snake.Z), BLACK, M.Metal)
	if self.Detail ~= "Low" then
		for _, p in ipairs({ Vector3.new(-1.6, TOP, -2.2), Vector3.new(4.0, TOP, -2.0), Vector3.new(-0.2, TOP, -2.0), Vector3.new(4.3, TOP, 2.6), Vector3.new(-2.9, TOP, -3.0) }) do
			local mid = Vector3.new(p.X, TOP, 6.6)
			rodW(self, "Cable", self.CF:PointToWorldSpace(p + Vector3.new(0, 0.02, 0)), self.CF:PointToWorldSpace(mid + Vector3.new(0, 0.02, 0)), 0.07, BLACK, M.Rubber)
			rodW(self, "Cable", self.CF:PointToWorldSpace(mid + Vector3.new(0, 0.02, 0)), self.CF:PointToWorldSpace(snake + Vector3.new(0.3, 0.02, -0.2)), 0.07, BLACK, M.Rubber)
		end
	end
	-- petites lampes de rampe (lueur la nuit)
	for _, xf in ipairs({ -9.4, -6.2, 6.2, 9.4 }) do
		do
			local x = xf
			box(self, "FootlightBody", Vector3.new(0.5, 0.26, 0.34), CFrame.new(x, TOP + 0.13, D.Z0 + 0.4) * CFrame.Angles(rad(20), 0, 0), BLACK, M.Metal)
			local lens = box(self, "FootlightLens", Vector3.new(0.38, 0.16, 0.04), CFrame.new(x, TOP + 0.17, D.Z0 + 0.58) * CFrame.Angles(rad(20), 0, 0), Color3.fromRGB(255, 226, 170), M.SmoothPlastic)
			glow(lens, Color3.fromRGB(255, 226, 170))
		end
	end
end)

-- 2. Tours du portique
step("Towers", function(self)
	local w = MusicData.TOWER_SIZE
	local s = self.Detail == "High" and 1.35 or (self.Detail == "Medium" and 1.8 or 2.6)
	local faces = self.Detail == "Low" and { 1, 3 } or { 1, 2, 3, 4 }
	for _, p in ipairs(MusicData.TRUSS_TOWERS) do
		truss(self, Vector3.new(p.X, MusicData.GROUND + 0.12, p.Z), Vector3.new(p.X, MusicData.TRUSS_H, p.Z), w, faces, s)
		-- platine au sol (lestée) et manchon en haut
		box(self, "BasePlate", Vector3.new(1.7, 0.12, 1.7), CFrame.new(p.X, MusicData.GROUND + 0.04, p.Z), STEEL, M.DiamondPlate)
		box(self, "Sleeve", Vector3.new(w + 0.12, 0.9, w + 0.12), CFrame.new(p.X, MusicData.TRUSS_H + 0.45, p.Z), ALU, M.Metal)
	end
end)

-- 3. Grill (poutres hautes) + toit + bandeau
step("Grid", function(self)
	local w = MusicData.TOWER_SIZE
	local y = MusicData.TRUSS_H + 0.45
	local T = MusicData.TRUSS_TOWERS
	local s = self.Detail == "High" and 1.4 or 2
	local faces = self.Detail == "Low" and { 3 } or { 2, 3 }
	local half = w / 2 + 0.06
	truss(self, Vector3.new(T[1].X + half, y, T[1].Z), Vector3.new(T[2].X - half, y, T[2].Z), w, faces, s)
	truss(self, Vector3.new(T[3].X + half, y, T[3].Z), Vector3.new(T[4].X - half, y, T[4].Z), w, faces, s)
	truss(self, Vector3.new(T[1].X, y, T[1].Z + half), Vector3.new(T[3].X, y, T[3].Z - half), w, faces, s)
	truss(self, Vector3.new(T[2].X, y, T[2].Z + half), Vector3.new(T[4].X, y, T[4].Z - half), w, faces, s)
	-- toit à deux pans (membrane grise), bordures
	local roofY = MusicData.TRUSS_H + 0.95
	local rise = 1.45
	local roofC = Color3.fromRGB(64, 64, 72)
	newPart(self, "RoofFront", Vector3.new(24, rise, 6), self.CF * CFrame.new(0, roofY + rise / 2, -1), roofC, M.Fabric, nil, "WedgePart")
	newPart(self, "RoofBack", Vector3.new(24, rise, 6), self.CF * CFrame.new(0, roofY + rise / 2, 5) * CFrame.Angles(0, math.pi, 0), roofC, M.Fabric, nil, "WedgePart")
	box(self, "RoofRidge", Vector3.new(24.2, 0.16, 0.36), CFrame.new(0, roofY + rise + 0.02, 2), Color3.fromRGB(210, 210, 216), M.Metal)
	box(self, "FasciaFront", Vector3.new(24.2, 0.3, 0.12), CFrame.new(0, roofY + 0.1, -4.07), PINK, M.SmoothPlastic)
	box(self, "FasciaBack", Vector3.new(24.2, 0.3, 0.12), CFrame.new(0, roofY + 0.1, 8.07), PINK, M.SmoothPlastic)
	box(self, "RoofUnder", Vector3.new(23.6, 0.1, 11.6), CFrame.new(0, roofY - 0.04, 2), Color3.fromRGB(34, 34, 40), M.Fabric)
	-- bandeau "DOPAMINE LIVE" sous le grill avant
	local banner = box(self, "Banner", Vector3.new(15, 1.3, 0.08), CFrame.new(0, MusicData.TRUSS_H - 0.72, T[1].Z - 0.5), BLACK, M.Fabric)
	local g = surface(banner, Enum.NormalId.Front, 40, 0.4)
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.fromRGB(20, 16, 30)
	bg.BorderSizePixel = 0
	bg.Parent = g
	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new(Color3.fromRGB(60, 20, 70), Color3.fromRGB(20, 30, 70))
	grad.Parent = bg
	label(bg, "Title", "🎵 DOPAMINE LIVE 🎵", UDim2.fromScale(0.05, 0.1), UDim2.fromScale(0.9, 0.8), Color3.fromRGB(255, 220, 240))
	for _, x in ipairs({ -6.5, 6.5 }) do
		rodW(self, "BannerTie", self.CF:PointToWorldSpace(Vector3.new(x, MusicData.TRUSS_H - 0.08, T[1].Z - 0.5)), self.CF:PointToWorldSpace(Vector3.new(x, MusicData.TRUSS_H + 0.05, T[1].Z)), 0.05, BLACK)
	end
	-- bannières verticales sur les tours de devant
	for i, p in ipairs({ T[1], T[2] }) do
		local side = box(self, "TowerBanner", Vector3.new(1.3, 5.2, 0.06), CFrame.new(p.X, 8.2, p.Z - 0.55), HOT, M.Fabric)
		local sg = surface(side, Enum.NormalId.Front, 40, 0.5)
		local fr = Instance.new("Frame")
		fr.Size = UDim2.fromScale(1, 1)
		fr.BackgroundColor3 = HOT
		fr.BorderSizePixel = 0
		fr.Parent = sg
		label(fr, "T", "🎸\n🎹\n🥁", UDim2.fromScale(0.1, 0.05), UDim2.fromScale(0.8, 0.9), WHITE)
	end
end)

-- 4. Rideau de fond plissé + écran LED
step("Backdrop", function(self)
	local h = MusicData.TRUSS_H - 0.2
	local z = 7.85
	local n = self.Detail == "Low" and 8 or 17
	local w = (D.X1 - D.X0) / n
	for i = 0, n - 1 do
		local depth = (i % 2 == 0) and 0.1 or 0.2
		local front = (i % 2 == 0) and z or z - 0.05
		box(self, "Drape", Vector3.new(w + 0.02, h, depth), CFrame.new(D.X0 + (i + 0.5) * w, 0.02 + h / 2, front + depth / 2), (i % 2 == 0) and FABRIC or FABRIC2, M.Fabric)
	end
	-- écran LED 16:9 (12,8 x 7,2) dans un cadre
	local sy = 6.9
	box(self, "ScreenFrame", Vector3.new(13.3, 7.7, 0.3), CFrame.new(0, sy, 7.72), BLACK, M.Metal)
	local panel = box(self, "Screen", Vector3.new(12.8, 7.2, 0.05), CFrame.new(0, sy, 7.55), Color3.fromRGB(6, 6, 10), M.Glass)
	for _, x in ipairs({ -5.6, 5.6 }) do
		rodW(self, "ScreenHang", self.CF:PointToWorldSpace(Vector3.new(x, sy + 3.85, 7.72)), self.CF:PointToWorldSpace(Vector3.new(x, MusicData.TRUSS_H + 0.1, 7.3)), 0.06, STEEL, M.Metal)
	end
	local g = surface(panel, Enum.NormalId.Front, 40, 0)
	local bg = Instance.new("Frame")
	bg.Name = "Bg"
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.fromRGB(12, 8, 26)
	bg.BorderSizePixel = 0
	bg.Parent = g
	local grad = Instance.new("UIGradient")
	grad.Name = "Grad"
	grad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(70, 20, 90)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(20, 16, 60)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(10, 50, 90)),
	})
	grad.Rotation = 30
	grad.Parent = bg
	local title = label(bg, "Title", "🎵 DOPAMINE LIVE", UDim2.fromScale(0.06, 0.1), UDim2.fromScale(0.88, 0.2), WHITE)
	local sub = label(bg, "Sub", "", UDim2.fromScale(0.1, 0.32), UDim2.fromScale(0.8, 0.1), Color3.fromRGB(255, 200, 235), Enum.Font.GothamBold)
	local barsHolder = Instance.new("Frame")
	barsHolder.Name = "Bars"
	barsHolder.BackgroundTransparency = 1
	barsHolder.Position = UDim2.fromScale(0.06, 0.46)
	barsHolder.Size = UDim2.fromScale(0.88, 0.42)
	barsHolder.Parent = bg
	local bars = {}
	local count = 24
	for i = 1, count do
		local b = Instance.new("Frame")
		b.Name = "Bar"
		b.AnchorPoint = Vector2.new(0, 1)
		b.Position = UDim2.fromScale((i - 1) / count + 0.006, 1)
		b.Size = UDim2.fromScale(1 / count - 0.012, 0.06)
		b.BorderSizePixel = 0
		b.BackgroundColor3 = Color3.fromHSV(0.85 - 0.5 * (i - 1) / count, 0.6, 1)
		b.Parent = barsHolder
		bars[i] = b
	end
	local progress = Instance.new("Frame")
	progress.Name = "Progress"
	progress.Position = UDim2.fromScale(0.06, 0.92)
	progress.Size = UDim2.fromScale(0, 0.02)
	progress.BorderSizePixel = 0
	progress.BackgroundColor3 = PINK
	progress.Parent = bg
	-- trame des modules LED (fines lignes)
	for i = 1, 7 do
		local line = Instance.new("Frame")
		line.Size = UDim2.new(0, 1, 1, 0)
		line.Position = UDim2.fromScale(i / 8, 0)
		line.BackgroundColor3 = Color3.new(0, 0, 0)
		line.BackgroundTransparency = 0.55
		line.BorderSizePixel = 0
		line.Parent = bg
	end
	for i = 1, 3 do
		local line = Instance.new("Frame")
		line.Size = UDim2.new(1, 0, 0, 1)
		line.Position = UDim2.fromScale(0, i / 4)
		line.BackgroundColor3 = Color3.new(0, 0, 0)
		line.BackgroundTransparency = 0.55
		line.BorderSizePixel = 0
		line.Parent = bg
	end
	self.H.Screen = { Part = panel, Title = title, Sub = sub, Bars = bars, Progress = progress, Grad = grad }
end)

-- 5. Sono : piles au sol + line arrays suspendus
step("PA", function(self)
	for i, p in ipairs(MusicData.PA) do
		local s = i == 1 and 1 or -1 -- (tourne un peu vers le centre)
		local base = self.CF * CFrame.new(p.X, MusicData.GROUND, p.Z) * CFrame.Angles(0, rad(-12 * s), 0)
		newPart(self, "Sub", Vector3.new(2.2, 1.9, 1.9), base * CFrame.new(0, 0.95, 0), BLACK, M.Fabric).CastShadow = true
		for k = -1, 1, 2 do
			cylW(self, "Woofer", (base * CFrame.new(k * 0.52, 0.95, -0.95)).Position, base.LookVector, 0.06, 0.86, Color3.fromRGB(44, 44, 50), M.Rubber)
			cylW(self, "Cone", (base * CFrame.new(k * 0.52, 0.95, -0.99)).Position, base.LookVector, 0.04, 0.62, Color3.fromRGB(58, 58, 64), M.SmoothPlastic)
			ballW(self, "DustCap", (base * CFrame.new(k * 0.52, 0.95, -0.99)).Position, 0.22, Color3.fromRGB(30, 30, 34), M.SmoothPlastic)
		end
		local top = base * CFrame.new(0, 1.9 + 1.2 + 0.01, 0.1)
		newPart(self, "Top", Vector3.new(1.6, 2.4, 1.4), top, BLACK, M.Fabric).CastShadow = true
		newPart(self, "Grill", Vector3.new(1.46, 2.26, 0.04), top * CFrame.new(0, 0, -0.71), Color3.fromRGB(40, 40, 46), M.DiamondPlate)
		newPart(self, "Horn", Vector3.new(1.0, 0.5, 0.05), top * CFrame.new(0, 0.62, -0.74), Color3.fromRGB(22, 22, 26), M.SmoothPlastic)
		cylW(self, "TopWoofer", (top * CFrame.new(0, -0.35, -0.74)).Position, base.LookVector, 0.04, 1.0, Color3.fromRGB(28, 28, 32), M.Rubber)
		local logo = newPart(self, "Logo", Vector3.new(0.5, 0.12, 0.03), top * CFrame.new(0, -1.02, -0.745), CHROME, M.Metal)
		logo.Name = "Logo"
	end
	-- line arrays accrochés au grill avant (courbe en J)
	for _, x in ipairs({ -9.6, 9.6 }) do
		local zc = MusicData.TRUSS_TOWERS[1].Z
		local hang = self.CF * CFrame.new(x, MusicData.TRUSS_H - 0.35, zc - 0.15)
		newPart(self, "ArrayFrame", Vector3.new(1.9, 0.14, 1.1), hang, STEEL, M.Metal)
		for k = -1, 1, 2 do
			rodW(self, "ArrayChain", (hang * CFrame.new(k * 0.8, 0, 0)).Position, (self.CF * CFrame.new(x + k * 0.8, MusicData.TRUSS_H, zc)).Position, 0.05, STEEL, M.Metal)
		end
		local cf = hang * CFrame.new(0, -0.1, 0)
		for k = 1, 4 do
			local tilt = rad(2 + 3.5 * k)
			cf = cf * CFrame.Angles(tilt * 0.5, 0, 0) * CFrame.new(0, -0.3, 0)
			local cab = cf * CFrame.new(0, 0, 0.02)
			newPart(self, "ArrayBox", Vector3.new(1.9, 0.55, 1.05), cab, BLACK, M.Fabric)
			newPart(self, "ArrayGrill", Vector3.new(1.8, 0.46, 0.04), cab * CFrame.new(0, 0, -0.53), Color3.fromRGB(42, 42, 48), M.DiamondPlate)
			cf = cf * CFrame.Angles(tilt * 0.5, 0, 0) * CFrame.new(0, -0.3, 0)
		end
	end
	-- émetteur de la radio (centre, en hauteur)
	local radio = newPart(self, "RadioEmitter", Vector3.new(0.4, 0.4, 0.4), self.CF * CFrame.new(0, 9, -3.4), WHITE)
	radio.Transparency = 1
	self.H.Radio = radio
end)

-- 6. Éclairage : PAR sur le grill avant, lyres motorisées sur le grill arrière
step("Lights", function(self)
	local T = MusicData.TRUSS_TOWERS
	local pars = {}
	local colors = { PINK, CYAN, Color3.fromRGB(255, 214, 120), LILAC, Color3.fromRGB(255, 214, 120), CYAN }
	for i, x in ipairs({ -8, -5, -2, 2, 5, 8 }) do
		local clampCF = self.CF * CFrame.new(x, MusicData.TRUSS_H - 0.08, T[1].Z)
		newPart(self, "ParClamp", Vector3.new(0.18, 0.3, 0.3), clampCF, STEEL, M.Metal)
		local aim = clampCF * CFrame.new(0, -0.55, 0) * CFrame.Angles(rad(-35), 0, 0)
		newPart(self, "ParYoke", Vector3.new(0.72, 0.08, 0.1), clampCF * CFrame.new(0, -0.2, 0), STEEL, M.Metal)
		cylW(self, "ParCan", aim.Position, -aim.UpVector, 0.85, 0.5, BLACK, M.Metal)
		local lens = cylW(self, "ParLens", (aim * CFrame.new(0, -0.45, 0)).Position, -aim.UpVector, 0.03, 0.4, colors[i], M.Glass)
		glow(lens, colors[i])
		table.insert(pars, lens)
	end
	self.H.Pars = pars
	local heads = {}
	for i, x in ipairs({ -7.5, -2.5, 2.5, 7.5 }) do
		local baseCF = self.CF * CFrame.new(x, MusicData.TRUSS_H - 0.1, T[3].Z - 0.2)
		newPart(self, "HeadBase", Vector3.new(0.7, 0.3, 0.7), baseCF, BLACK, M.Metal)
		local yoke = newPart(self, "HeadYoke", Vector3.new(0.78, 0.1, 0.24), baseCF * CFrame.new(0, -0.22, 0), BLACK, M.Metal)
		local armL = newPart(self, "HeadArm", Vector3.new(0.08, 0.6, 0.22), baseCF * CFrame.new(-0.36, -0.5, 0), BLACK, M.Metal)
		local armR = newPart(self, "HeadArm", Vector3.new(0.08, 0.6, 0.22), baseCF * CFrame.new(0.36, -0.5, 0), BLACK, M.Metal)
		local head = newPart(self, "Head", Vector3.new(0.62, 0.5, 0.5), baseCF * CFrame.new(0, -0.72, 0), Color3.fromRGB(34, 34, 40), M.Metal)
		local lens = newPart(self, "HeadLens", Vector3.new(0.04, 0.36, 0.36), baseCF * CFrame.new(0, -0.98, 0) * CFrame.Angles(0, 0, rad(90)), colors[i + 1], M.Glass, CYL)
		glow(lens, colors[i + 1])
		-- faisceau (Beam) : visible la nuit quand la musique joue
		local a0 = Instance.new("Attachment")
		a0.Name = "BeamFrom"
		a0.CFrame = CFrame.new()
		a0.Parent = lens
		local target = newPart(self, "BeamTarget", Vector3.new(0.2, 0.2, 0.2), self.CF * CFrame.new(x * 0.6, TOP, 1), WHITE)
		target.Transparency = 1
		local a1 = Instance.new("Attachment")
		a1.Name = "BeamTo"
		a1.CFrame = CFrame.new()
		a1.Parent = target
		local beam = Instance.new("Beam")
		beam.Attachment0 = a0
		beam.Attachment1 = a1
		beam.Width0 = 0.35
		beam.Width1 = 2.6
		beam.FaceCamera = true
		beam.LightEmission = 1
		beam.LightInfluence = 0
		beam.Color = ColorSequence.new(colors[i + 1])
		beam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 0.95) })
		beam.Segments = 1
		beam.Enabled = false
		beam.Parent = lens
		table.insert(heads, { Base = baseCF, Yoke = yoke, Arms = { armL, armR }, Head = head, Lens = lens, Beam = beam, Target = target, X = x, Phase = i * 1.3 })
	end
	self.H.Heads = heads
end)

-- 7. Retours de scène + pieds de micro
local function micStand(self: any, base: Vector3, mouth: Vector3)
	local B = self.CF:PointToWorldSpace(base)
	local hubY = 0.55
	for k = 0, 2 do
		local a = rad(k * 120 + 30)
		rodW(self, "MicLeg", B + Vector3.new(0, hubY, 0), self.CF:PointToWorldSpace(base + Vector3.new(math.cos(a) * 0.55, 0.03, math.sin(a) * 0.55)), 0.05, BLACK, M.Metal)
	end
	local top = base + Vector3.new(0, 3.55, 0)
	rodW(self, "MicPole", B + Vector3.new(0, hubY - 0.05, 0), self.CF:PointToWorldSpace(top), 0.08, BLACK, M.Metal)
	ballW(self, "MicClutch", self.CF:PointToWorldSpace(top), 0.14, BLACK, M.Metal)
	local M0 = self.CF:PointToWorldSpace(mouth)
	local T0 = self.CF:PointToWorldSpace(top)
	local dir = (M0 - T0).Unit
	local tip = M0 - dir * 0.35
	rodW(self, "MicBoom", T0, tip - dir * 0.2, 0.06, BLACK, M.Metal)
	cylW(self, "Mic", tip - dir * 0.02, dir, 0.42, 0.13, BLACK, M.SmoothPlastic)
	ballW(self, "MicGrille", tip + dir * 0.22, 0.22, Color3.fromRGB(178, 180, 188), M.DiamondPlate)
	rodW(self, "MicCable", tip - dir * 0.22, B + Vector3.new(0.05, 0.1, 0.05), 0.035, Color3.fromRGB(16, 16, 18), M.Rubber)
end

step("Monitors", function(self)
	for _, x in ipairs({ -2.9, 1.3, 8.0 }) do
		-- retour "wedge" : la pente regarde les musiciens (+Z)
		local cf = self.CF * CFrame.new(x, TOP + 0.4, -3.1) * CFrame.Angles(0, math.pi, 0)
		newPart(self, "Wedge", Vector3.new(1.4, 0.8, 0.8), cf, BLACK, M.Fabric, nil, "WedgePart")
		newPart(self, "WedgeGrill", Vector3.new(1.2, 0.04, 0.72), cf * CFrame.new(0, 0.025, -0.025) * CFrame.Angles(-math.atan2(0.8, 0.8), 0, 0), Color3.fromRGB(44, 44, 50), M.DiamondPlate)
	end
	micStand(self, Vector3.new(-0.2, TOP, -2.45), Vector3.new(-0.2, TOP + 4.45, -1.6))
	micStand(self, Vector3.new(-1.6, TOP, -2.55), Vector3.new(-1.6, TOP + 4.45, -2.0))
	micStand(self, Vector3.new(5.5, TOP, 0.6), Vector3.new(4.3, TOP + 4.45, 1.2))
end)

-- 8. Juke-box (au sol, devant la scène)
step("Jukebox", function(self)
	local kf = self.CF * MusicData.JUKEBOX * CFrame.new(0, MusicData.GROUND, 0)
	local body = newPart(self, "JukeBody", Vector3.new(2.4, 2.1, 1.2), kf * CFrame.new(0, 1.05, 0), WALNUT, M.Wood)
	body.CastShadow = true
	local arch = newPart(self, "JukeArch", Vector3.new(1.2, 2.4, 2.4), kf * CFrame.new(0, 2.1, 0) * CFrame.Angles(0, rad(90), 0), WALNUT, M.Wood, CYL)
	arch.CastShadow = true
	local window = newPart(self, "JukeWindow", Vector3.new(0.04, 1.7, 1.7), kf * CFrame.new(0, 2.3, -0.68) * CFrame.Angles(0, rad(90), 0), Color3.fromRGB(150, 200, 230), M.Glass, CYL)
	window.Transparency = 0.35
	newPart(self, "JukeRecord", Vector3.new(0.03, 1.0, 1.0), kf * CFrame.new(0, 2.3, -0.615) * CFrame.Angles(0, rad(90), 0), EBONY, M.SmoothPlastic, CYL)
	newPart(self, "JukeLabel", Vector3.new(0.02, 0.34, 0.34), kf * CFrame.new(0, 2.3, -0.645) * CFrame.Angles(0, rad(90), 0), PINK, M.SmoothPlastic, CYL)
	-- tube néon en arc autour de la vitre
	local n = 9
	for i = 0, n - 1 do
		local a0 = rad(180 * i / n)
		local a1 = rad(180 * (i + 1) / n)
		local r = 1.08
		local p0 = (kf * CFrame.new(math.cos(a0) * r, 2.1 + math.sin(a0) * r, -0.69)).Position
		local p1 = (kf * CFrame.new(math.cos(a1) * r, 2.1 + math.sin(a1) * r, -0.69)).Position
		glow(rodW(self, "JukeNeon", p0, p1, 0.1, i % 2 == 0 and PINK or CYAN, M.SmoothPlastic), i % 2 == 0 and PINK or CYAN)
	end
	-- colonnes à bulles
	for _, x in ipairs({ -1.12, 1.12 }) do
		local tube = newPart(self, "JukeTube", Vector3.new(1.9, 0.3, 0.3), kf * CFrame.new(x, 1.05, -0.5) * CFrame.Angles(0, 0, rad(90)), LILAC, M.Glass, CYL)
		tube.Transparency = 0.25
		glow(tube, LILAC)
	end
	-- panneau des choix (texte), grille du haut-parleur, fente à pièces
	local panel = newPart(self, "JukePanel", Vector3.new(1.7, 0.5, 0.06), kf * CFrame.new(0, 1.05, -0.64) * CFrame.Angles(rad(-12), 0, 0), Color3.fromRGB(255, 244, 226), M.SmoothPlastic)
	local g = surface(panel, Enum.NormalId.Front, 60, 0.4)
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.fromRGB(255, 244, 226)
	bg.BorderSizePixel = 0
	bg.Parent = g
	local l = label(bg, "Text", "🎵 [E] Songs  ·  📻 [F] Radio", UDim2.fromScale(0.04, 0.1), UDim2.fromScale(0.92, 0.8), Color3.fromRGB(120, 60, 90))
	l:SetAttribute("LocText", "🎵 [E] Songs  ·  📻 [F] Radio")
	self.H.JukeText = l
	newPart(self, "JukeGrill", Vector3.new(1.8, 0.55, 0.05), kf * CFrame.new(0, 0.45, -0.62), Color3.fromRGB(200, 186, 160), M.DiamondPlate)
	newPart(self, "JukeChrome", Vector3.new(2.3, 0.08, 0.08), kf * CFrame.new(0, 1.38, -0.62), CHROME, M.Metal)
	newPart(self, "JukeBase", Vector3.new(2.5, 0.14, 1.3), kf * CFrame.new(0, 0.04, 0), CHROME, M.Metal)
	self.H.Emitters = self.H.Emitters or {}
end)

----------------------------------------------------------------------
-- 🎹 Piano à queue
----------------------------------------------------------------------

-- Contour du côté droit (aigus, vers le public) de la caisse : (x, z), z vers la queue
local OUTLINE = {
	{ 2.2, -0.6 },
	{ 2.2, -1.9 },
	{ 2.08, -2.55 },
	{ 1.75, -3.2 },
	{ 1.2, -3.85 },
	{ 0.55, -4.45 },
	{ -0.15, -4.95 },
	{ -0.8, -5.35 },
	{ -1.45, -5.58 },
	{ -1.95, -5.62 },
	{ -2.2, -5.45 },
}
local LEFT_X = -2.2
local KW = 3.64 -- clavier de 88 touches
local PITCH = KW / 52

MusicStageBuild.PIANO_KEY_TOP = 2.2

local function isBlack(n: number): boolean
	local pc = n % 12
	return pc == 1 or pc == 3 or pc == 6 or pc == 8 or pc == 10
end
MusicStageBuild.IsBlack = isBlack

-- Nombre de touches blanches strictement sous `n` à partir de `low`
local function whiteIndex(n: number, low: number): number
	local count = 0
	for k = low, n - 1 do
		if not isBlack(k) then
			count += 1
		end
	end
	return count
end

-- Remplit la forme de la caisse (bord gauche droit, côté droit en courbe)
-- à la hauteur y, épaisseur t, mise à l'échelle (s) autour du centre
local function fillCase(self: any, frame: CFrame, y: number, t: number, s: number, color: Color3, material: Enum.Material, name: string, zCut: number?)
	local cx, cz = 0, -3.1
	local function P(x: number, z: number): (number, number)
		return cx + (x - cx) * s, cz + (z - cz) * s
	end
	local left = cx + (LEFT_X - cx) * s
	for i = 1, #OUTLINE - 1 do
		local x1, z1 = P(OUTLINE[i][1], OUTLINE[i][2])
		local x2, z2 = P(OUTLINE[i + 1][1], OUTLINE[i + 1][2])
		if zCut and z1 > zCut then
			-- (morceau coupé devant : couvercle qui ne couvre pas le clavier)
			if z2 >= zCut then
				continue
			end
			local k = (zCut - z1) / (z2 - z1)
			x1, z1 = x1 + (x2 - x1) * k, zCut
		end
		local xmin = math.min(x1, x2)
		if xmin - left > 0.02 and z1 - z2 > 0.02 then
			newPart(self, name, Vector3.new(xmin - left, t, z1 - z2), frame * CFrame.new((left + xmin) / 2, y, (z1 + z2) / 2), color, material)
		end
		if x1 > x2 then
			tri(self, name, frame, Vector3.new(x2, y, z1), Vector3.new(1, 0, 0), x1 - x2, Vector3.new(0, 0, -1), z1 - z2, t, color, material)
		elseif x2 > x1 then
			tri(self, name, frame, Vector3.new(x1, y, z2), Vector3.new(1, 0, 0), x2 - x1, Vector3.new(0, 0, 1), z1 - z2, t, color, material)
		end
	end
end

step("PianoCase", function(self)
	-- repère du piano : origine au sol sous le bord des touches, -Z = vers la
	-- queue (le pianiste regarde -Z), +X = aigus (vers le public)
	local st = MusicData.STATIONS.Piano
	local spot = st.Spot.Position
	local pf = self.CF * CFrame.new(spot.X - 1.2, TOP, spot.Z) * CFrame.Angles(0, rad(90), 0)
	self.H.Frames.Piano = pf
	local refl = self.Detail == "High" and 0.12 or 0.06
	-- éclisse (bord vertical de la caisse)
	local ring = { { LEFT_X, -0.6 } }
	for i = #OUTLINE, 1, -1 do
		table.insert(ring, OUTLINE[i])
	end
	for i = 1, #ring - 1 do
		local a = Vector3.new(ring[i][1], 2.475, ring[i][2])
		local b = Vector3.new(ring[i + 1][1], 2.475, ring[i + 1][2])
		local len = (b - a).Magnitude
		local mid = (a + b) / 2
		local cf = pf * CFrame.lookAt(mid, b)
		local rim = newPart(self, "Rim", Vector3.new(0.14, 0.95, len + 0.02), cf, LACQUER, M.SmoothPlastic)
		rim.Reflectance = refl
		rim.CastShadow = true
		local joint = newPart(self, "RimJoint", Vector3.new(0.95, 0.14, 0.14), pf * CFrame.new(b) * CFrame.Angles(0, 0, rad(90)), LACQUER, M.SmoothPlastic, CYL)
		joint.Reflectance = refl
	end
	-- fond, table d'harmonie (épicéa), cadre doré, cordes
	fillCase(self, pf, 2.04, 0.08, 1, LACQUER, M.SmoothPlastic, "CaseBottom")
	fillCase(self, pf, 2.55, 0.05, 0.955, SPRUCE, M.Wood, "Soundboard")
	fillCase(self, pf, 2.63, 0.05, 0.84, GOLD, M.Metal, "Plate")
	for _, h in ipairs({ { -0.9, -1.6 }, { 0.3, -2.2 }, { -0.5, -3.4 }, { -1.3, -4.3 } }) do
		newPart(self, "PlateHole", Vector3.new(0.04, 0.36, 0.36), pf * CFrame.new(h[1], 2.66, h[2]) * CFrame.Angles(0, 0, rad(90)), Color3.fromRGB(150, 116, 60), M.Metal, CYL)
	end
	if self.Detail ~= "Low" then
		local n = self.Detail == "High" and 20 or 12
		for i = 0, n - 1 do
			local x = -1.95 + i * (3.6 / (n - 1))
			-- longueur : jusqu'au contour (moins une marge)
			local zEnd = -5.3
			for k = 1, #OUTLINE - 1 do
				local a, b = OUTLINE[k], OUTLINE[k + 1]
				if (x <= a[1] and x >= b[1]) and a[1] ~= b[1] then
					zEnd = a[2] + (b[2] - a[2]) * (a[1] - x) / (a[1] - b[1]) + 0.45
				end
			end
			local z0 = -1.0
			local len = math.max(0.5, z0 - zEnd)
			local copper = i < n * 0.35
			newPart(self, "String", Vector3.new(0.018, 0.018, len), pf * CFrame.new(x, 2.68, z0 - len / 2), copper and Color3.fromRGB(196, 130, 80) or Color3.fromRGB(220, 222, 230), M.Metal)
		end
	end
	-- couvercle ouvert (charnière côté gauche, béquille côté public)
	local angle = rad(34)
	local lidFrame = pf * CFrame.new(LEFT_X, 2.99, 0) * CFrame.Angles(0, 0, angle) * CFrame.new(-LEFT_X, 0, 0)
	fillCase(self, lidFrame, 0, 0.07, 1.0, LACQUER, M.SmoothPlastic, "Lid", -1.25)
	for _, d in ipairs(self.Group:GetChildren()) do
		if d.Name == "Lid" and d:IsA("BasePart") then
			d.Reflectance = refl
			d.CastShadow = true
		end
	end
	local r = 3.25
	local stickTop = Vector3.new(LEFT_X + r * math.cos(angle) + 0.02, 2.99 + r * math.sin(angle) - 0.06, -2.6)
	rodW(self, "LidProp", pf:PointToWorldSpace(Vector3.new(1.95, 2.96, -2.6)), pf:PointToWorldSpace(stickTop), 0.07, LACQUER, M.SmoothPlastic)
	-- pieds (3) avec roulettes laiton, lyre et pédales
	for _, p in ipairs({ { -1.9, -0.95 }, { 1.9, -0.95 }, { -1.25, -4.85 } }) do
		local x, z = p[1], p[2]
		newPart(self, "LegTop", Vector3.new(0.46, 0.22, 0.46), pf * CFrame.new(x, 1.9, z), LACQUER, M.SmoothPlastic)
		newPart(self, "Leg", Vector3.new(0.3, 1.5, 0.3), pf * CFrame.new(x, 1.04, z), LACQUER, M.SmoothPlastic).Reflectance = refl
		newPart(self, "LegFoot", Vector3.new(0.36, 0.14, 0.36), pf * CFrame.new(x, 0.26, z), LACQUER, M.SmoothPlastic)
		newPart(self, "Caster", Vector3.new(0.14, 0.2, 0.2), pf * CFrame.new(x, 0.1, z) * CFrame.Angles(0, rad(90), 0), BRASS, M.Metal, CYL)
	end
	newPart(self, "PedalBox", Vector3.new(1.0, 0.2, 0.36), pf * CFrame.new(0, 0.24, -0.8), LACQUER, M.SmoothPlastic)
	for _, x in ipairs({ -0.3, 0.3 }) do
		newPart(self, "Lyre", Vector3.new(0.08, 1.68, 0.24), pf * CFrame.new(x, 1.18, -0.8), LACQUER, M.SmoothPlastic)
	end
	for _, x in ipairs({ -0.2, 0, 0.2 }) do
		newPart(self, "Pedal", Vector3.new(0.09, 0.05, 0.36), pf * CFrame.new(x, 0.27, -0.45), BRASS, M.Metal)
	end
	-- banquette capitonnée
	local bench = pf * CFrame.new(0, 0, 1.2)
	newPart(self, "BenchSeat", Vector3.new(1.9, 0.22, 0.64), bench * CFrame.new(0, 1.35, 0), BLACK, M.Leather)
	newPart(self, "BenchFrame", Vector3.new(1.98, 0.14, 0.7), bench * CFrame.new(0, 1.17, 0), LACQUER, M.SmoothPlastic)
	for _, x in ipairs({ -0.85, 0.85 }) do
		for _, z in ipairs({ -0.25, 0.25 }) do
			newPart(self, "BenchLeg", Vector3.new(0.12, 1.1, 0.12), bench * CFrame.new(x, 0.55, z), LACQUER, M.SmoothPlastic)
		end
		newPart(self, "BenchKnob", Vector3.new(0.1, 0.2, 0.2), bench * CFrame.new(x * 1.2, 1.17, 0), BRASS, M.Metal, CYL)
	end
	if self.Detail ~= "Low" then
		for _, x in ipairs({ -0.5, 0, 0.5 }) do
			ballW(self, "Tuft", (bench * CFrame.new(x, 1.46, 0)).Position, 0.05, Color3.fromRGB(40, 40, 46), M.Leather)
		end
	end
end)

step("PianoKeys", function(self)
	local pf = self.H.Frames.Piano
	local keys = {}
	local top = MusicStageBuild.PIANO_KEY_TOP
	-- lit du clavier, joues, barre de devant, pupitre et partition
	newPart(self, "KeyBed", Vector3.new(KW, 0.16, 0.62), pf * CFrame.new(0, top - 0.17, -0.31), EBONY, M.SmoothPlastic)
	newPart(self, "KeySlip", Vector3.new(KW + 0.02, 0.14, 0.05), pf * CFrame.new(0, top - 0.12, 0.03), LACQUER, M.SmoothPlastic)
	for _, s in ipairs({ -1, 1 }) do
		newPart(self, "Cheek", Vector3.new(0.38, 0.34, 0.66), pf * CFrame.new(s * (KW / 2 + 0.19), top - 0.03, -0.33), LACQUER, M.SmoothPlastic).Reflectance = 0.08
	end
	local fall = newPart(self, "Fallboard", Vector3.new(KW, 0.34, 0.06), pf * CFrame.new(0, top + 0.21, -0.53), LACQUER, M.SmoothPlastic)
	local g = surface(fall, Enum.NormalId.Back, 80, 0.6)
	label(g, "Brand", "Dopamine & Sons", UDim2.fromScale(0.35, 0.3), UDim2.fromScale(0.3, 0.4), GOLD, Enum.Font.Fantasy)
	local desk = pf * CFrame.new(0, top + 0.72, -0.74) * CFrame.Angles(rad(12), 0, 0)
	newPart(self, "MusicDesk", Vector3.new(2.3, 0.76, 0.06), desk, LACQUER, M.SmoothPlastic)
	local sheet = newPart(self, "Sheet", Vector3.new(1.3, 0.56, 0.02), desk * CFrame.new(0, 0.02, 0.045), IVORY, M.SmoothPlastic)
	local sg = surface(sheet, Enum.NormalId.Back, 80, 0.6)
	for i = 1, 4 do
		local line = Instance.new("Frame")
		line.Size = UDim2.new(0.9, 0, 0, 1)
		line.Position = UDim2.fromScale(0.05, i * 0.2)
		line.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
		line.BorderSizePixel = 0
		line.Parent = sg
	end
	-- 88 touches (La0 21 .. Do8 108)
	for n = 21, 108 do
		local cf: CFrame
		local part: BasePart
		if isBlack(n) then
			local x = -KW / 2 + whiteIndex(n, 21) * PITCH
			cf = pf * CFrame.new(x, top + 0.01, -0.31)
			part = newPart(self, "Key", Vector3.new(0.04, 0.1, 0.3), cf, EBONY, M.SmoothPlastic)
		else
			local x = -KW / 2 + (whiteIndex(n, 21) + 0.5) * PITCH
			cf = pf * CFrame.new(x, top - 0.045, -0.25)
			part = newPart(self, "Key", Vector3.new(PITCH - 0.007, 0.09, 0.5), cf, IVORY, M.SmoothPlastic)
		end
		keys[n] = { Part = part, CF = cf, Top = (cf * CFrame.new(0, 0.06, 0.1)).Position }
	end
	self.H.Keys.Piano = keys
	local emitter = newPart(self, "PianoEmitter", Vector3.new(0.3, 0.3, 0.3), pf * CFrame.new(0, 3, -2.5), WHITE)
	emitter.Transparency = 1
	self.H.Emitters.Piano = emitter
	-- bloc de collision local (on ne traverse pas le piano)
	local block = newPart(self, "Block", Vector3.new(4.4, 1.3, 5.0), pf * CFrame.new(0, 2.5, -3.1), WHITE)
	block.Transparency = 1
	block.CanCollide = true
end)

----------------------------------------------------------------------
-- 🥁 Batterie
----------------------------------------------------------------------

-- Fût : coque + cercles chromés + peaux ; axe = `axis` (monde), `top` =
-- sens de la peau de frappe ; renvoie les pièces (pour la vibration)
local function drum(self: any, name: string, c: Vector3, axis: Vector3, depth: number, dia: number, lugs: number): { BasePart }
	local list = {}
	local a = axis.Unit
	local shell = cylW(self, name .. "Shell", c, a, depth, dia, SHELL, M.SmoothPlastic)
	shell.Reflectance = self.Detail == "High" and 0.16 or 0.08
	table.insert(list, shell)
	for _, s in ipairs({ -1, 1 }) do
		table.insert(list, cylW(self, name .. "Hoop", c + a * s * (depth / 2 + 0.01), a, 0.07, dia + 0.06, CHROME, M.Metal))
		table.insert(list, cylW(self, name .. "Head", c + a * s * (depth / 2 + 0.07), a, 0.012, dia - 0.02, HEAD, M.SmoothPlastic))
	end
	if self.Detail ~= "Low" then
		local up = math.abs(a.Y) > 0.9 and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0)
		local u = a:Cross(up).Unit
		local v = a:Cross(u).Unit
		for k = 0, lugs - 1 do
			local ang = (k + 0.5) * math.pi * 2 / lugs
			local dir = u * math.cos(ang) + v * math.sin(ang)
			local p = c + dir * (dia / 2 + 0.025)
			local cf = CFrame.fromMatrix(p, dir, a, dir:Cross(a))
			table.insert(list, newPart(self, name .. "Lug", Vector3.new(0.05, math.min(depth * 0.36, 0.26), 0.07), cf, CHROME, M.Metal))
		end
	end
	return list
end

local function cymbal(self: any, name: string, c: Vector3, normal: Vector3, dia: number, standBase: Vector3?): { BasePart }
	local list = {}
	local n = normal.Unit
	local disc = cylW(self, name, c, n, 0.035, dia, BRONZE, M.Metal)
	disc.Reflectance = 0.22
	table.insert(list, disc)
	table.insert(list, cylW(self, name .. "Bell", c + n * 0.05, n, 0.07, dia * 0.28, BRONZE, M.Metal))
	if standBase then
		rodW(self, name .. "Stand", standBase + Vector3.new(0, 0.5, 0), c - n * 0.05, 0.07, CHROME, M.Metal)
		for k = 0, 2 do
			local ang = rad(k * 120 + 15)
			rodW(self, name .. "Leg", standBase + Vector3.new(0, 0.5, 0), standBase + Vector3.new(math.cos(ang) * 0.6, 0.02, math.sin(ang) * 0.6), 0.05, CHROME, M.Metal)
		end
	end
	return list
end

step("Drums", function(self)
	local y0 = TOP + MusicData.RISERS.Drums.H
	local df = self.CF * CFrame.new(0, y0, 0)
	self.H.Frames.Drums = df
	local W = function(x: number, y: number, z: number): Vector3
		return df:PointToWorldSpace(Vector3.new(x, y, z))
	end
	local fwd = df:VectorToWorldSpace(Vector3.new(0, 0, -1))
	local up = df:VectorToWorldSpace(Vector3.new(0, 1, 0))
	local pieces: { [number]: any } = {}
	-- tapis
	newPart(self, "DrumRug", Vector3.new(5.2, 0.04, 3.8), df * CFrame.new(0.2, 0, 5.4), Color3.fromRGB(128, 44, 58), M.Fabric)
	newPart(self, "DrumRugBorder", Vector3.new(4.8, 0.09, 3.4), df * CFrame.new(0.2, 0, 5.4), Color3.fromRGB(176, 120, 70), M.Fabric)
	newPart(self, "DrumRugCenter", Vector3.new(4.4, 0.14, 3.0), df * CFrame.new(0.2, 0, 5.4), Color3.fromRGB(110, 36, 50), M.Fabric)
	-- grosse caisse (peau avant noire avec logo)
	local kc = W(0.25, 0.86, 4.75)
	local kick = drum(self, "Kick", kc, fwd, 1.2, 1.66, 8)
	local front = cylW(self, "KickLogo", kc + fwd * 0.7, fwd, 0.012, 1.5, EBONY, M.SmoothPlastic)
	local g = surface(front, Enum.NormalId.Right, 60, 0.6)
	local logo = Instance.new("Frame")
	logo.AnchorPoint = Vector2.new(0.5, 0.5)
	logo.Position = UDim2.fromScale(0.5, 0.5)
	logo.Size = UDim2.fromScale(0.62, 0.62)
	logo.BackgroundColor3 = PINK
	logo.BorderSizePixel = 0
	logo.Parent = g
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = logo
	label(logo, "T", "🧠\nDopamine", UDim2.fromScale(0.12, 0.18), UDim2.fromScale(0.76, 0.64), WHITE)
	for _, s in ipairs({ -1, 1 }) do
		rodW(self, "KickSpur", W(0.25 + s * 0.7, 0.35, 4.3), W(0.25 + s * 1.0, 0.02, 4.1), 0.06, CHROME, M.Metal)
	end
	pieces[MusicData.DRUM.Kick] = { Parts = kick, Hit = W(0.25, 0.86, 5.4), Kind = "kick", Axis = fwd }
	-- pédale et batte
	newPart(self, "KickPedal", Vector3.new(0.34, 0.06, 0.9), df * CFrame.new(0.25, 0.1, 5.85) * CFrame.Angles(rad(8), 0, 0), CHROME, M.Metal)
	local beaterPivot = df * CFrame.new(0.25, 0.3, 5.45)
	local beater = newPart(self, "Beater", Vector3.new(0.06, 0.8, 0.06), beaterPivot * CFrame.Angles(rad(-25), 0, 0) * CFrame.new(0, 0.4, 0), CHROME, M.Metal)
	self.H.Beater = { Part = beater, Pivot = beaterPivot }
	-- caisse claire (sur son pied), toms, tom basse
	local snareC = W(-0.72, 1.72, 5.55)
	local tiltToDrummer = (up * math.cos(rad(8)) - fwd * math.sin(rad(8))).Unit
	local snare = drum(self, "Snare", snareC, tiltToDrummer, 0.42, 1.04, 6)
	snare[1].Color = CHROME
	rodW(self, "SnareStand", W(-0.72, 0.45, 5.55), snareC - tiltToDrummer * 0.25, 0.07, CHROME, M.Metal)
	for k = 0, 2 do
		local ang = rad(k * 120 + 90)
		rodW(self, "SnareLeg", W(-0.72, 0.45, 5.55), W(-0.72 + math.cos(ang) * 0.55, 0.02, 5.55 + math.sin(ang) * 0.55), 0.05, CHROME, M.Metal)
	end
	pieces[MusicData.DRUM.Snare] = { Parts = snare, Hit = snareC + tiltToDrummer * 0.25, Kind = "drum", Axis = tiltToDrummer }
	local tomTilt = (up * math.cos(rad(24)) - fwd * math.sin(rad(24))).Unit
	local tom1C = W(-0.42, 2.55, 4.85)
	local tom2C = W(0.78, 2.6, 4.85)
	pieces[MusicData.DRUM.TomHigh] = { Parts = drum(self, "TomHigh", tom1C, tomTilt, 0.6, 0.78, 6), Hit = tom1C + tomTilt * 0.33, Kind = "drum", Axis = tomTilt }
	pieces[MusicData.DRUM.TomMid] = { Parts = drum(self, "TomMid", tom2C, tomTilt, 0.66, 0.9, 6), Hit = tom2C + tomTilt * 0.36, Kind = "drum", Axis = tomTilt }
	rodW(self, "TomMount", W(0.25, 1.62, 4.75), tom1C - tomTilt * 0.25, 0.07, CHROME, M.Metal)
	rodW(self, "TomMount", W(0.25, 1.62, 4.75), tom2C - tomTilt * 0.25, 0.07, CHROME, M.Metal)
	local floorC = W(1.2, 1.35, 5.9)
	pieces[MusicData.DRUM.TomFloor] = { Parts = drum(self, "TomFloor", floorC, up, 1.1, 1.2, 8), Hit = floorC + up * 0.56, Kind = "drum", Axis = up }
	for k = 0, 2 do
		local ang = rad(k * 120 + 30)
		rodW(self, "FloorLeg", floorC + Vector3.new(0, -0.1, 0) + df:VectorToWorldSpace(Vector3.new(math.cos(ang) * 0.66, 0, math.sin(ang) * 0.66)), W(1.2 + math.cos(ang) * 0.8, 0.02, 5.9 + math.sin(ang) * 0.8), 0.05, CHROME, M.Metal)
	end
	-- charleston, crash, ride
	local hatC = W(-1.5, 2.72, 5.3)
	local hat = cymbal(self, "HatTop", hatC + up * 0.07, up, 1.0, W(-1.5, 0, 5.3))
	for _, p in ipairs(cymbal(self, "HatBottom", hatC - up * 0.02, up, 1.0, nil)) do
		table.insert(hat, p)
	end
	newPart(self, "HatPedal", Vector3.new(0.3, 0.05, 0.7), df * CFrame.new(-1.5, 0.1, 5.8) * CFrame.Angles(rad(10), 0, 0), CHROME, M.Metal)
	pieces[MusicData.DRUM.HatClosed] = { Parts = hat, Hit = hatC + up * 0.1 + df:VectorToWorldSpace(Vector3.new(0.2, 0, 0.35)), Kind = "cymbal", Axis = up }
	pieces[MusicData.DRUM.HatOpen] = pieces[MusicData.DRUM.HatClosed]
	local crashN = (up * math.cos(rad(18)) - fwd * math.sin(rad(18))).Unit
	local crashC = W(-1.3, 3.55, 4.35)
	pieces[MusicData.DRUM.Crash] = { Parts = cymbal(self, "Crash", crashC, crashN, 1.36, W(-1.6, 0, 4.0)), Hit = crashC + df:VectorToWorldSpace(Vector3.new(0.2, 0, 0.5)), Kind = "cymbal", Axis = crashN }
	local rideN = (up * math.cos(rad(12)) - fwd * math.sin(rad(12))).Unit
	local rideC = W(1.75, 3.2, 4.7)
	pieces[MusicData.DRUM.Ride] = { Parts = cymbal(self, "Ride", rideC, rideN, 1.5, W(2.2, 0, 4.4)), Hit = rideC + df:VectorToWorldSpace(Vector3.new(-0.3, 0, 0.45)), Kind = "cymbal", Axis = rideN }
	for _, piece in pairs(pieces) do
		local cfs = {}
		for i, p in ipairs(piece.Parts) do
			cfs[i] = p.CFrame
		end
		piece.CFs = cfs
		piece.Center = piece.Parts[1].Position
	end
	-- tabouret
	local seatC = W(0, 1.35, 6.45)
	newPart(self, "ThroneSeat", Vector3.new(0.3, 1.1, 1.1), CFrame.new(seatC) * df.Rotation * CFrame.Angles(0, 0, rad(90)), BLACK, M.Leather, CYL)
	rodW(self, "ThronePost", W(0, 0.4, 6.45), W(0, 1.2, 6.45), 0.12, CHROME, M.Metal)
	for k = 0, 2 do
		local ang = rad(k * 120 + 90)
		rodW(self, "ThroneLeg", W(0, 0.4, 6.45), W(math.cos(ang) * 0.6, 0.02, 6.45 + math.sin(ang) * 0.6), 0.06, CHROME, M.Metal)
	end
	-- baguettes (posées sur la caisse claire au repos)
	local sticks = {}
	for i, s in ipairs({ -1, 1 }) do
		local a = snareC + tiltToDrummer * 0.27 + df:VectorToWorldSpace(Vector3.new(s * 0.08 - 0.3, 0, 0.1 * i))
		local b = a + df:VectorToWorldSpace(Vector3.new(0.9, 0, -0.4 + 0.1 * s))
		sticks[s > 0 and "R" or "L"] = rodW(self, "Stick", a, b, 0.05, Color3.fromRGB(226, 196, 140), M.Wood)
	end
	self.H.Sticks = sticks
	self.H.Drums = pieces
	local emitter = newPart(self, "DrumsEmitter", Vector3.new(0.3, 0.3, 0.3), df * CFrame.new(0, 2.5, 5), WHITE)
	emitter.Transparency = 1
	self.H.Emitters.Drums = emitter
	local block = newPart(self, "Block", Vector3.new(4.2, 2.6, 2.2), df * CFrame.new(0.1, 1.3, 4.5), WHITE)
	block.Transparency = 1
	block.CanCollide = true
end)

----------------------------------------------------------------------
-- 🎸 Guitare, basse (portables), amplis
----------------------------------------------------------------------

-- Construit un instrument à cordes dans son repère (X = vers la tête,
-- Z = face des cordes) ; renvoie { Parts, Rel }
local function stringed(self: any, bass: boolean, idleCF: CFrame): any
	local parts, rel = {}, {}
	local function add(name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?): BasePart
		local p = newPart(self, name, size, idleCF * cf, color, material, shape)
		table.insert(parts, p)
		table.insert(rel, cf)
		return p
	end
	local k = bass and 1.12 or 1
	local bodyC = bass and Color3.fromRGB(70, 34, 20) or Color3.fromRGB(196, 30, 46)
	local th = 0.14
	local lower = add("BodyLower", Vector3.new(th, 1.02 * k, 1.02 * k), CFrame.new(-0.3 * k, 0, 0) * CFrame.Angles(0, rad(90), 0), bodyC, M.SmoothPlastic, CYL)
	lower.Reflectance = 0.14
	add("BodyUpper", Vector3.new(th, 0.82 * k, 0.82 * k), CFrame.new(0.25 * k, 0.02, 0) * CFrame.Angles(0, rad(90), 0), bodyC, M.SmoothPlastic, CYL).Reflectance = 0.14
	add("BodyWaist", Vector3.new(0.6 * k, 0.7 * k, th), CFrame.new(0, 0, 0), bodyC, M.SmoothPlastic).Reflectance = 0.14
	add("HornUpper", Vector3.new(th, 0.3, 0.3), CFrame.new(0.66 * k, 0.3 * k, 0) * CFrame.Angles(0, rad(90), 0), bodyC, M.SmoothPlastic, CYL)
	add("HornLower", Vector3.new(th, 0.26, 0.26), CFrame.new(0.56 * k, -0.28 * k, 0) * CFrame.Angles(0, rad(90), 0), bodyC, M.SmoothPlastic, CYL)
	if bass then
		-- dégradé "sunburst" : cœur ambré
		add("Burst", Vector3.new(0.012, 0.7, 0.7), CFrame.new(-0.3 * k, 0, 0.085) * CFrame.Angles(0, rad(90), 0), Color3.fromRGB(206, 120, 44), M.SmoothPlastic, CYL)
	end
	add("Pickguard", Vector3.new(0.012, 0.66, 0.66), CFrame.new(0.02, -0.08, bass and 0.105 or 0.095) * CFrame.Angles(0, rad(90), 0), bass and EBONY or WHITE, M.SmoothPlastic, CYL)
	for i, x in ipairs(bass and { -0.05 } or { -0.12, 0.14 }) do
		add("Pickup" .. i, Vector3.new(0.12, 0.34, 0.04), CFrame.new(x, 0, 0.1), EBONY, M.SmoothPlastic)
	end
	add("Bridge", Vector3.new(0.14, 0.34, 0.05), CFrame.new(-0.45 * k, 0, 0.1), CHROME, M.Metal)
	for i, p in ipairs({ { -0.5, -0.3 }, { -0.32, -0.38 } }) do
		add("Knob" .. i, Vector3.new(0.06, 0.09, 0.09), CFrame.new(p[1] * k, p[2] * k, 0.1) * CFrame.Angles(0, rad(90), 0), CHROME, M.Metal, CYL)
	end
	local neckLen = bass and 1.75 or 1.3
	local n0 = 0.55 * k
	add("Neck", Vector3.new(neckLen, 0.16, 0.1), CFrame.new(n0 + neckLen / 2, 0, 0.02), MAPLE, M.Wood)
	add("Fretboard", Vector3.new(neckLen, 0.17, 0.03), CFrame.new(n0 + neckLen / 2, 0, 0.085), ROSEWOOD, M.Wood)
	if self.Detail ~= "Low" then
		for f = 1, 8 do
			local x = n0 + neckLen * (1 - 0.5 ^ (f / 6)) * 1.25
			if x < n0 + neckLen - 0.03 then
				add("Fret", Vector3.new(0.014, 0.17, 0.034), CFrame.new(x, 0, 0.088), CHROME, M.Metal)
			end
		end
	end
	add("Nut", Vector3.new(0.03, 0.17, 0.05), CFrame.new(n0 + neckLen, 0, 0.09), IVORY, M.SmoothPlastic)
	local head = n0 + neckLen + 0.27
	add("Headstock", Vector3.new(0.52, 0.28, 0.06), CFrame.new(head, 0.03, 0.0), bass and bodyC or MAPLE, M.Wood)
	local tuners = bass and 4 or 6
	for t = 1, tuners do
		add("Tuner", Vector3.new(0.08, 0.06, 0.06), CFrame.new(head - 0.2 + (t - 1) * (0.42 / tuners), 0.14, 0.05) * CFrame.Angles(0, 0, rad(90)), CHROME, M.Metal, CYL)
	end
	local strings = bass and 4 or 6
	local sLen = n0 + neckLen + 0.45 * k
	for s = 1, strings do
		local y = -0.06 + (s - 1) * (0.12 / (strings - 1))
		add("String", Vector3.new(sLen, 0.012, 0.012), CFrame.new(-0.45 * k + sLen / 2, y, 0.115), Color3.fromRGB(226, 226, 232), M.Metal)
	end
	-- sangle (visible quand l'instrument est porté)
	local strapA = newPart(self, "Strap", Vector3.new(0.9, 0.16, 0.03), idleCF, Color3.fromRGB(40, 30, 30), M.Leather)
	strapA.Transparency = 1
	local strapB = newPart(self, "Strap", Vector3.new(0.9, 0.16, 0.03), idleCF, Color3.fromRGB(40, 30, 30), M.Leather)
	strapB.Transparency = 1
	return { Parts = parts, Rel = rel, Idle = idleCF, Straps = { strapA, strapB }, Bass = bass, NeckStart = n0, NeckLen = neckLen, K = k }
end

local function guitarStand(self: any, pos: Vector3)
	local base = self.CF * CFrame.new(pos)
	for _, s in ipairs({ -1, 1 }) do
		rodW(self, "StandLeg", (base * CFrame.new(s * 0.35, 0.02, -0.35)).Position, (base * CFrame.new(0, 0.4, 0)).Position, 0.06, BLACK, M.Metal)
	end
	rodW(self, "StandBack", (base * CFrame.new(0, 0.02, 0.5)).Position, (base * CFrame.new(0, 2.1, 0.12)).Position, 0.06, BLACK, M.Metal)
	newPart(self, "StandCradle", Vector3.new(0.8, 0.08, 0.22), base * CFrame.new(0, 0.34, 0), BLACK, M.Rubber)
	newPart(self, "StandYoke", Vector3.new(0.3, 0.06, 0.12), base * CFrame.new(0, 2.1, 0.12), BLACK, M.Rubber)
end

local function amp(self: any, name: string, cf: CFrame, size: Vector3, face: Color3, panel: boolean)
	local body = newPart(self, name, size, cf, BLACK, M.Leather)
	body.CastShadow = true
	local grill = newPart(self, name .. "Grill", Vector3.new(size.X - 0.2, size.Y - (panel and 0.5 or 0.2), 0.04), cf * CFrame.new(0, panel and -0.15 or 0, -size.Z / 2 - 0.02), face, M.Fabric)
	local g = surface(grill, Enum.NormalId.Front, 50, 0.7)
	label(g, "Logo", "Dopa", UDim2.fromScale(0.3, 0.05), UDim2.fromScale(0.4, 0.2), WHITE, Enum.Font.Fantasy)
	if panel then
		newPart(self, name .. "Panel", Vector3.new(size.X - 0.2, 0.26, 0.04), cf * CFrame.new(0, size.Y / 2 - 0.18, -size.Z / 2 - 0.02), GOLD, M.Metal)
		for i = 0, 5 do
			newPart(self, name .. "Knob", Vector3.new(0.06, 0.1, 0.1), cf * CFrame.new(-0.55 + i * 0.22, size.Y / 2 - 0.18, -size.Z / 2 - 0.06) * CFrame.Angles(0, rad(90), 0), EBONY, M.SmoothPlastic, CYL)
		end
		glow(newPart(self, name .. "Pilot", Vector3.new(0.06, 0.06, 0.03), cf * CFrame.new(size.X / 2 - 0.25, size.Y / 2 - 0.18, -size.Z / 2 - 0.05), Color3.fromRGB(255, 60, 60), M.SmoothPlastic), Color3.fromRGB(255, 60, 60))
	end
	newPart(self, name .. "Handle", Vector3.new(0.7, 0.06, 0.14), cf * CFrame.new(0, size.Y / 2 + 0.03, 0), EBONY, M.Leather)
	if self.Detail == "High" then
		for _, sx in ipairs({ -1, 1 }) do
			for _, sy in ipairs({ -1, 1 }) do
				newPart(self, name .. "Corner", Vector3.new(0.18, 0.18, 0.18), cf * CFrame.new(sx * (size.X / 2 - 0.07), sy * (size.Y / 2 - 0.07), -size.Z / 2 + 0.07), CHROME, M.Metal)
			end
		end
	end
end

step("Guitars", function(self)
	-- ampli combo de la guitare, "stack" de la basse (tournés vers le public)
	amp(self, "GuitarAmp", self.CF * CFrame.new(-1.8, TOP + 0.86, 1.8), Vector3.new(2.0, 1.7, 1.0), Color3.fromRGB(84, 74, 64), true)
	amp(self, "BassCab", self.CF * CFrame.new(4.4, TOP + 1.2, 4.25), Vector3.new(2.0, 2.4, 1.1), Color3.fromRGB(46, 46, 52), false)
	amp(self, "BassHead", self.CF * CFrame.new(4.4, TOP + 2.4 + 0.38, 4.3), Vector3.new(2.0, 0.74, 0.95), Color3.fromRGB(46, 46, 52), true)
	-- stands (guitare à droite de son ampli, basse près des toms)
	local gPos = Vector3.new(-0.3, TOP, 1.5)
	local bPos = Vector3.new(2.75, TOP, 1.0)
	guitarStand(self, gPos)
	guitarStand(self, bPos)
	-- instrument debout : tête en haut, face vers le public
	local function idle(pos: Vector3, bass: boolean): CFrame
		local lift = bass and 1.3 or 1.2
		return self.CF * CFrame.fromMatrix(pos + Vector3.new(0, lift, 0), Vector3.new(0, 1, 0), Vector3.new(1, 0, 0), Vector3.new(0, 0, -1))
	end
	self.H.Guitar = stringed(self, false, idle(gPos, false))
	self.H.Bass = stringed(self, true, idle(bPos, true))
	local ge = newPart(self, "GuitarEmitter", Vector3.new(0.3, 0.3, 0.3), self.CF * CFrame.new(-1.8, TOP + 1.2, 1.3), WHITE)
	ge.Transparency = 1
	self.H.Emitters.Guitar = ge
	local be = newPart(self, "BassEmitter", Vector3.new(0.3, 0.3, 0.3), self.CF * CFrame.new(4.4, TOP + 1.5, 3.6), WHITE)
	be.Transparency = 1
	self.H.Emitters.Bass = be
	for _, spec in ipairs({ { Vector3.new(-1.8, TOP + 0.86, 1.8), Vector3.new(2.0, 1.7, 1.0) }, { Vector3.new(4.4, TOP + 1.6, 4.25), Vector3.new(2.0, 3.2, 1.1) } }) do
		local block = newPart(self, "Block", spec[2], self.CF * CFrame.new(spec[1]), WHITE)
		block.Transparency = 1
		block.CanCollide = true
	end
end)

----------------------------------------------------------------------
-- 🎶 Xylophone
----------------------------------------------------------------------

MusicStageBuild.XYLO_LOW = 60
MusicStageBuild.XYLO_HIGH = 96

step("Xylophone", function(self)
	local st = MusicData.STATIONS.Xylophone
	local xf = self.CF * CFrame.new(st.Spot.Position.X, TOP, st.Spot.Position.Z - 1.05)
	self.H.Frames.Xylophone = xf
	local low, high = MusicStageBuild.XYLO_LOW, MusicStageBuild.XYLO_HIGH
	local whites = whiteIndex(high + 1, low)
	local width = 4.1
	local pitch = width / whites
	local keys = {}
	local topY = 2.72
	for n = low, high do
		local black = isBlack(n)
		local u = (n - low) / (high - low)
		local len = 0.95 - 0.4 * u
		local x: number
		local z: number
		local y: number
		if black then
			x = -width / 2 + whiteIndex(n, low) * pitch
			z = -0.62
			y = topY + 0.06
		else
			x = -width / 2 + (whiteIndex(n, low) + 0.5) * pitch
			z = 0.0
			y = topY
		end
		local cf = xf * CFrame.new(x, y - 0.035, z)
		local shade = 0.9 + 0.1 * math.sin(n * 1.7)
		local p = newPart(self, "Bar", Vector3.new(pitch * (black and 0.82 or 0.88), 0.07, len * (black and 0.8 or 1)), cf, Color3.fromRGB(math.floor(150 * shade), math.floor(72 * shade), math.floor(46 * shade)), M.Wood)
		keys[n] = { Part = p, CF = cf, Top = (cf * CFrame.new(0, 0.05, 0)).Position }
		if not black and self.Detail ~= "Low" and (self.Detail == "High" or n % 2 == 0) then
			local tube = 1.35 - 0.95 * u
			newPart(self, "Tube", Vector3.new(tube, 0.13, 0.13), xf * CFrame.new(x, topY - 0.2 - tube / 2, z) * CFrame.Angles(0, 0, rad(90)), ALU, M.Metal, CYL)
		end
	end
	-- rails, flasques, pieds à roulettes, barre
	for _, z in ipairs({ -0.62, 0.0 }) do
		for _, dz in ipairs({ -0.3, 0.3 }) do
			newPart(self, "Rail", Vector3.new(width + 0.3, 0.1, 0.06), xf * CFrame.new(0, topY - 0.12 + (z < 0 and 0.06 or 0), z + dz * (z < 0 and 0.8 or 1)), Color3.fromRGB(60, 40, 30), M.Wood)
		end
	end
	for _, s in ipairs({ -1, 1 }) do
		local x = s * (width / 2 + 0.2)
		newPart(self, "EndBoard", Vector3.new(0.1, 0.34, 1.35), xf * CFrame.new(x, topY - 0.2, -0.3), Color3.fromRGB(60, 40, 30), M.Wood)
		for _, z in ipairs({ -0.85, 0.3 }) do
			newPart(self, "XyloLeg", Vector3.new(0.1, topY - 0.45, 0.1), xf * CFrame.new(x, (topY - 0.45) / 2 + 0.12, z), BLACK, M.Metal)
			ballW(self, "Wheel", (xf * CFrame.new(x, 0.1, z)).Position, 0.2, EBONY, M.Rubber)
		end
		newPart(self, "XyloFoot", Vector3.new(0.12, 0.08, 1.35), xf * CFrame.new(x, 0.26, -0.28), BLACK, M.Metal)
	end
	newPart(self, "XyloBrace", Vector3.new(width + 0.3, 0.08, 0.08), xf * CFrame.new(0, 0.9, -0.28), BLACK, M.Metal)
	-- baguettes (posées sur le bord)
	local mallets = {}
	for _, s in ipairs({ -1, 1 }) do
		local a = (xf * CFrame.new(s * 0.25 + 1.2, topY + 0.04, 0.55)).Position
		local b = (xf * CFrame.new(s * 0.25 + 1.8, topY + 0.04, -0.4)).Position
		local handle = rodW(self, "MalletHandle", a, b, 0.05, Color3.fromRGB(214, 180, 120), M.Wood)
		local headPart = ballW(self, "MalletHead", b, 0.17, s > 0 and PINK or LILAC, M.Fabric)
		mallets[s > 0 and "R" or "L"] = { Handle = handle, Head = headPart }
	end
	self.H.Mallets = mallets
	self.H.Keys.Xylophone = keys
	local emitter = newPart(self, "XyloEmitter", Vector3.new(0.3, 0.3, 0.3), xf * CFrame.new(0, 3, 0), WHITE)
	emitter.Transparency = 1
	self.H.Emitters.Xylophone = emitter
	local block = newPart(self, "Block", Vector3.new(4.6, 2.6, 1.5), xf * CFrame.new(0, 1.3, -0.3), WHITE)
	block.Transparency = 1
	block.CanCollide = true
end)

----------------------------------------------------------------------
-- 🎛️ Synthé
----------------------------------------------------------------------

MusicStageBuild.SYNTH_LOW = 48
MusicStageBuild.SYNTH_HIGH = 96

step("Synth", function(self)
	local st = MusicData.STATIONS.Synth
	local sf = self.CF * CFrame.new(st.Spot.Position.X, TOP, st.Spot.Position.Z - 1.0)
	self.H.Frames.Synth = sf
	local low, high = MusicStageBuild.SYNTH_LOW, MusicStageBuild.SYNTH_HIGH
	local whites = whiteIndex(high + 1, low)
	local pitch = 0.08
	local kw = whites * pitch
	local keyTop = 2.86
	local body = Color3.fromRGB(46, 48, 56)
	local width = kw + 0.75
	local left = -width / 2
	local kx0 = left + 0.55 -- (molettes à gauche)
	newPart(self, "SynthPanel", Vector3.new(width, 0.24, 0.5), sf * CFrame.new(0, keyTop - 0.02, -0.28), body, M.Metal).CastShadow = true
	newPart(self, "SynthBed", Vector3.new(width, 0.12, 0.52), sf * CFrame.new(0, keyTop - 0.15, 0.23), body, M.Metal)
	for _, x in ipairs({ left + 0.1, width / 2 - 0.1 }) do
		newPart(self, "SynthCheek", Vector3.new(0.2, 0.22, 0.52), sf * CFrame.new(x, keyTop - 0.06, 0.23), Color3.fromRGB(150, 100, 70), M.Wood)
	end
	-- molettes (pitch / modulation)
	for i = 0, 1 do
		newPart(self, "Wheel", Vector3.new(0.06, 0.3, 0.3), sf * CFrame.new(left + 0.28 + i * 0.12, keyTop - 0.02, 0.22), EBONY, M.Rubber, CYL)
	end
	-- écran, boutons, curseurs
	local screen = newPart(self, "SynthScreen", Vector3.new(0.6, 0.04, 0.24), sf * CFrame.new(-0.2, keyTop + 0.115, -0.3), Color3.fromRGB(20, 60, 60), M.Glass)
	local g = surface(screen, Enum.NormalId.Top, 100, 0)
	local lcd = Instance.new("Frame")
	lcd.Size = UDim2.fromScale(1, 1)
	lcd.BackgroundColor3 = Color3.fromRGB(40, 200, 190)
	lcd.BorderSizePixel = 0
	lcd.Parent = g
	local lcdText = label(lcd, "Text", "PAD 01", UDim2.fromScale(0.05, 0.1), UDim2.fromScale(0.9, 0.8), Color3.fromRGB(10, 40, 40), Enum.Font.Code)
	self.H.SynthLCD = lcdText
	if self.Detail ~= "Low" then
		for i = 0, 7 do
			newPart(self, "SynthKnob", Vector3.new(0.08, 0.12, 0.12), sf * CFrame.new(0.3 + i * 0.16, keyTop + 0.14, -0.35) * CFrame.Angles(0, 0, rad(90)), i % 3 == 0 and PINK or CHROME, M.SmoothPlastic, CYL)
		end
		for i = 0, 3 do
			newPart(self, "SynthSlider", Vector3.new(0.06, 0.05, 0.14), sf * CFrame.new(-1.0 + i * 0.14, keyTop + 0.11, -0.28 + (i % 2) * 0.05), WHITE, M.SmoothPlastic)
		end
	end
	local keys = {}
	for n = low, high do
		local cf: CFrame
		local part: BasePart
		if isBlack(n) then
			local x = kx0 + whiteIndex(n, low) * pitch
			cf = sf * CFrame.new(x, keyTop + 0.02, 0.14)
			part = newPart(self, "Key", Vector3.new(0.045, 0.09, 0.3), cf, EBONY, M.SmoothPlastic)
		else
			local x = kx0 + (whiteIndex(n, low) + 0.5) * pitch
			cf = sf * CFrame.new(x, keyTop - 0.045, 0.24)
			part = newPart(self, "Key", Vector3.new(pitch - 0.008, 0.09, 0.5), cf, WHITE, M.SmoothPlastic)
		end
		keys[n] = { Part = part, CF = cf, Top = (cf * CFrame.new(0, 0.06, 0.12)).Position }
	end
	self.H.Keys.Synth = keys
	-- stand en X
	for _, x in ipairs({ -0.8, 0.8 }) do
		for _, s in ipairs({ -1, 1 }) do
			rodW(self, "StandTube", (sf * CFrame.new(x, 0.05, s * 0.55)).Position, (sf * CFrame.new(x, keyTop - 0.3, -s * 0.45)).Position, 0.09, BLACK, M.Metal)
		end
		newPart(self, "StandArm", Vector3.new(0.08, 0.08, 1.1), sf * CFrame.new(x, keyTop - 0.26, 0), BLACK, M.Metal)
	end
	newPart(self, "StandBolt", Vector3.new(1.7, 0.08, 0.08), sf * CFrame.new(0, (keyTop - 0.25) / 2, 0.05) * CFrame.Angles(0, 0, 0), CHROME, M.Metal)
	local emitter = newPart(self, "SynthEmitter", Vector3.new(0.3, 0.3, 0.3), sf * CFrame.new(0, 3, 0), WHITE)
	emitter.Transparency = 1
	self.H.Emitters.Synth = emitter
	local block = newPart(self, "Block", Vector3.new(width, 2.9, 1.0), sf * CFrame.new(0, 1.45, 0), WHITE)
	block.Transparency = 1
	block.CanCollide = true
end)

----------------------------------------------------------------------
-- 🎧 Cabine DJ
----------------------------------------------------------------------

step("DJ", function(self)
	local st = MusicData.STATIONS.DJ
	local y0 = TOP + MusicData.RISERS.DJ.H
	local jf = self.CF * CFrame.new(st.Spot.Position.X, y0, st.Spot.Position.Z - 1.75)
	self.H.Frames.DJ = jf
	local top = 2.96
	local facade = newPart(self, "BoothFront", Vector3.new(4.2, top - 0.1, 0.1), jf * CFrame.new(0, (top - 0.1) / 2, -0.55), Color3.fromRGB(18, 18, 22), M.SmoothPlastic)
	facade.CastShadow = true
	for _, x in ipairs({ -2.05, 2.05 }) do
		newPart(self, "BoothSide", Vector3.new(0.1, top - 0.1, 1.2), jf * CFrame.new(x, (top - 0.1) / 2, 0), Color3.fromRGB(18, 18, 22), M.SmoothPlastic)
	end
	newPart(self, "BoothTop", Vector3.new(4.4, 0.12, 1.3), jf * CFrame.new(0, top - 0.06, 0), Color3.fromRGB(230, 230, 236), M.SmoothPlastic)
	-- façade LED (égaliseur)
	local led = newPart(self, "BoothLED", Vector3.new(3.8, 2.2, 0.04), jf * CFrame.new(0, 1.45, -0.62), Color3.fromRGB(8, 8, 12), M.Glass)
	local g = surface(led, Enum.NormalId.Front, 40, 0)
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.fromRGB(10, 8, 20)
	bg.BorderSizePixel = 0
	bg.Parent = g
	local djLabel = label(bg, "Title", "DJ DOPA", UDim2.fromScale(0.1, 0.05), UDim2.fromScale(0.8, 0.28), PINK)
	local bars = {}
	for i = 1, 16 do
		local b = Instance.new("Frame")
		b.AnchorPoint = Vector2.new(0, 1)
		b.Position = UDim2.fromScale((i - 1) / 16 + 0.005, 0.95)
		b.Size = UDim2.fromScale(1 / 16 - 0.01, 0.05)
		b.BorderSizePixel = 0
		b.BackgroundColor3 = Color3.fromHSV(0.55 + 0.3 * (i - 1) / 16, 0.7, 1)
		b.Parent = bg
		bars[i] = b
	end
	-- platines
	local platters = {}
	for i, x in ipairs({ -1.3, 1.3 }) do
		newPart(self, "DeckBase", Vector3.new(1.3, 0.14, 1.0), jf * CFrame.new(x, top + 0.07, 0), Color3.fromRGB(40, 40, 46), M.Metal)
		local center = jf * CFrame.new(x - 0.08, top + 0.17, 0.02)
		newPart(self, "Platter", Vector3.new(0.06, 0.9, 0.9), center * CFrame.Angles(0, 0, rad(90)), CHROME, M.Metal, CYL)
		local record = newPart(self, "Record", Vector3.new(0.02, 0.86, 0.86), center * CFrame.new(0, 0.04, 0) * CFrame.Angles(0, 0, rad(90)), EBONY, M.SmoothPlastic, CYL)
		local lab = newPart(self, "RecordLabel", Vector3.new(0.03, 0.3, 0.3), center * CFrame.new(0, 0.065, 0) * CFrame.Angles(0, 0, rad(90)), i == 1 and PINK or CYAN, M.SmoothPlastic, CYL)
		local mark = newPart(self, "RecordMark", Vector3.new(0.1, 0.012, 0.04), center * CFrame.new(0.3, 0.062, 0), WHITE, M.SmoothPlastic)
		rodW(self, "Tonearm", (jf * CFrame.new(x + 0.5, top + 0.24, -0.35)).Position, (jf * CFrame.new(x + 0.15, top + 0.24, 0.25)).Position, 0.035, CHROME, M.Metal)
		newPart(self, "Cartridge", Vector3.new(0.08, 0.05, 0.12), jf * CFrame.new(x + 0.13, top + 0.23, 0.29), EBONY, M.SmoothPlastic)
		table.insert(platters, { Parts = { record, lab, mark }, Center = center, CFs = { record.CFrame, lab.CFrame, mark.CFrame }, Angle = 0 })
	end
	-- table de mixage
	newPart(self, "Mixer", Vector3.new(0.9, 0.16, 1.0), jf * CFrame.new(0, top + 0.08, 0), Color3.fromRGB(30, 30, 36), M.Metal)
	for row = 0, 2 do
		for col = 0, 1 do
			newPart(self, "MixKnob", Vector3.new(0.06, 0.08, 0.08), jf * CFrame.new(-0.2 + col * 0.4, top + 0.18, -0.35 + row * 0.18) * CFrame.Angles(0, 0, rad(90)), CHROME, M.SmoothPlastic, CYL)
		end
	end
	local meters = {}
	for col = 0, 1 do
		for k = 0, 5 do
			local c = k < 4 and Color3.fromRGB(90, 230, 120) or (k < 5 and Color3.fromRGB(255, 210, 80) or Color3.fromRGB(255, 70, 70))
			local led2 = newPart(self, "Meter", Vector3.new(0.05, 0.03, 0.05), jf * CFrame.new(-0.06 + col * 0.12, top + 0.175, 0.05 - k * 0.07), Color3.fromRGB(40, 40, 40), M.SmoothPlastic)
			led2:SetAttribute("OnColor", c)
			table.insert(meters, led2)
		end
	end
	local faderCF = jf * CFrame.new(0, top + 0.19, 0.4)
	newPart(self, "FaderSlot", Vector3.new(0.5, 0.012, 0.04), jf * CFrame.new(0, top + 0.162, 0.4), EBONY, M.SmoothPlastic)
	local fader = newPart(self, "Crossfader", Vector3.new(0.08, 0.06, 0.12), faderCF, WHITE, M.SmoothPlastic)
	-- ordinateur portable + casque
	local lap = jf * CFrame.new(0, top + 0.35, -0.45)
	newPart(self, "LaptopStand", Vector3.new(0.5, 0.3, 0.3), jf * CFrame.new(0, top + 0.15, -0.45), CHROME, M.Metal)
	newPart(self, "Laptop", Vector3.new(0.8, 0.03, 0.55), lap, Color3.fromRGB(196, 198, 206), M.Metal)
	local scr = newPart(self, "LaptopScreen", Vector3.new(0.8, 0.52, 0.03), lap * CFrame.new(0, 0.24, -0.3) * CFrame.Angles(rad(-12), 0, 0), Color3.fromRGB(196, 198, 206), M.Metal)
	local sg = surface(scr, Enum.NormalId.Back, 120, 0)
	local wave = Instance.new("Frame")
	wave.Size = UDim2.fromScale(0.94, 0.9)
	wave.Position = UDim2.fromScale(0.03, 0.05)
	wave.BackgroundColor3 = Color3.fromRGB(16, 18, 30)
	wave.BorderSizePixel = 0
	wave.Parent = sg
	for i = 1, 2 do
		local w = Instance.new("Frame")
		w.Size = UDim2.fromScale(0.9, 0.12)
		w.Position = UDim2.fromScale(0.05, 0.2 + (i - 1) * 0.4)
		w.BackgroundColor3 = i == 1 and PINK or CYAN
		w.BorderSizePixel = 0
		w.Parent = wave
	end
	local phones = jf * CFrame.new(1.75, top + 0.1, 0.35)
	for _, s in ipairs({ -1, 1 }) do
		newPart(self, "EarCup", Vector3.new(0.1, 0.26, 0.26), phones * CFrame.new(s * 0.18, 0.03, 0) * CFrame.Angles(0, 0, rad(90)), EBONY, M.Leather, CYL)
	end
	newPart(self, "HeadBand", Vector3.new(0.42, 0.04, 0.08), phones * CFrame.new(0, 0.1, 0), EBONY, M.SmoothPlastic)
	self.H.DJ = { Platters = platters, Meters = meters, Fader = fader, FaderCF = faderCF, Bars = bars, Label = djLabel }
	local emitter = newPart(self, "DJEmitter", Vector3.new(0.3, 0.3, 0.3), jf * CFrame.new(0, 3.2, 0), WHITE)
	emitter.Transparency = 1
	self.H.Emitters.DJ = emitter
	local block = newPart(self, "Block", Vector3.new(4.4, 3.0, 1.3), jf * CFrame.new(0, 1.5, 0), WHITE)
	block.Transparency = 1
	block.CanCollide = true
end)

----------------------------------------------------------------------
-- Construction pas à pas
----------------------------------------------------------------------

function MusicStageBuild.new(stageCF: CFrame, parent: Instance, detail: string?): Build
	local model = Instance.new("Model")
	model.Name = "MusicStageFx"
	model.Parent = parent
	local self = setmetatable({
		CF = stageCF,
		Model = model,
		Detail = detail or "Medium",
		H = { Keys = {}, Frames = {}, Emitters = {} },
		Index = 0,
		Group = model,
		Count = 0,
		Done = false,
	}, MusicStageBuild)
	return self
end

MusicStageBuild.STEP_NAMES = STEPS

-- Un morceau ; true quand tout est construit
function MusicStageBuild.Step(self: Build): boolean
	if self.Done then
		return true
	end
	self.Index += 1
	local entry = STEPS[self.Index]
	if not entry then
		self.Done = true
		return true
	end
	local group = Instance.new("Model")
	group.Name = entry[1]
	group.Parent = self.Model
	self.Group = group
	local ok, err = pcall(BUILDERS[entry[1]], self)
	if not ok then
		warn("[MusicStage] décor " .. entry[1] .. " : " .. tostring(err))
	end
	if self.Index >= #STEPS then
		self.Done = true
	end
	return self.Done
end

function MusicStageBuild.Destroy(self: Build)
	self.Done = true
	if self.Model then
		self.Model:Destroy()
	end
end

return MusicStageBuild
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="215">
          <Properties>
            <string name="Name">MusicSynth</string>
            <string name="Source"><![CDATA[--[[
	MusicSynth (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > MusicSynth

	🎵 Moteur de SON des instruments de la scène (v9.9, MUSIC99), côté
	client. "Avec de vrais sons" sans nouvel identifiant non vérifiable :
	chaque note est un Sound qui rejoue l'échantillon de son instrument
	(Config.Instruments : SampleId, BaseNote…) à la bonne HAUTEUR :
	    PlaybackSpeed = 2^((note - BaseNote) / 12)   (1 demi-ton = x1,0595)
	  - timbres : couches (octave, quinte) + effets par instrument dans un
	    SoundGroup (réverbération du piano, chorus du synthé, distorsion de
	    la guitare, basses renforcées de la basse…) ;
	  - enveloppe : chaque note s'éteint en fondu (Decay), calculé à chaque
	    image (Step) ; polyphonie : 10 voix par échantillon et par émetteur
	    (la plus ancienne est reprise) ;
	  - son 3D : les Sound sont posés sur l'instrument (émetteur), on ne
	    les entend que de près (RollOffMin / RollOffMax) ;
	  - volume : Config.Instruments.Volume x instrument x vélocité, x le
	    volume des effets du joueur (⚙️, SoundManager : lecture seule) ;
	    rien si les sons sont coupés.
	Aucun son existant n'est modifié (Config.Sounds n'est pas lu ici).

	API :
	  MusicSynth.new() -> synth
	  synth:Note(inst, note, vel, emitter)   instruments mélodiques
	  synth:Drum(piece, vel, emitter)        batterie (1..9, MusicData.DRUMS)
	  synth:Pad(pad, vel, emitter)           effets du DJ (5..8)
	  synth:Step(dt)                         enveloppes
	  synth:Destroy()
	  MusicSynth.Speed(inst, note) -> number (pur : tests)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage.Shared.Config)
local MusicData = require(ReplicatedStorage.Shared.MusicData)

local MusicSynth = {}
MusicSynth.__index = MusicSynth

local VOICES = 10
local MIN_VOLUME = 0.004

local soundManager: any = nil
local function userVolume(): number
	if soundManager == nil then
		local ok, result = pcall(function()
			local client = script.Parent.Parent
			return require(client:WaitForChild("SoundManager", 2) :: any)
		end)
		soundManager = ok and result or false
	end
	local sm = soundManager
	if not sm then
		return 1
	end
	local ok, enabled = pcall(sm.IsSoundEnabled)
	if ok and enabled == false then
		return 0
	end
	local okV, volume = pcall(sm.GetEffectsVolume)
	if okV and type(volume) == "number" then
		-- (la scène reste audible même avec des effets discrets)
		return math.clamp(0.35 + volume * 0.8, 0, 1)
	end
	return 1
end

local function cfg(): any
	return Config.Instruments or {}
end

-- Vitesse de lecture d'une note (repliée à l'octave dans [MinSpeed, MaxSpeed])
function MusicSynth.Speed(inst: string, note: number): number
	local c = cfg()[inst] or {}
	local base = tonumber(c.BaseNote) or 76
	local speed = 2 ^ ((note - base) / 12)
	local lo, hi = tonumber(c.MinSpeed) or 0.25, tonumber(c.MaxSpeed) or 4
	for _ = 1, 6 do
		if speed < lo then
			speed *= 2
		elseif speed > hi then
			speed /= 2
		else
			break
		end
	end
	return speed
end

type Voice = { Sound: Sound, Start: number, Decay: number, V0: number, Busy: boolean }

function MusicSynth.new()
	local self = setmetatable({
		Pools = {} :: { [Instance]: { [string]: { List: { Voice }, Next: number } } },
		Groups = {} :: { [string]: SoundGroup },
		Active = {} :: { Voice },
		Clock = 0,
		Played = 0,
		Volume = 1,
		VolumeAt = -math.huge,
	}, MusicSynth)
	return self
end

-- SoundGroup + effets d'un instrument (créé à la première note)
function MusicSynth.Group(self: any, inst: string): SoundGroup?
	local g = self.Groups[inst]
	if g and g.Parent then
		return g
	end
	local ok, result = pcall(function()
		local group = Instance.new("SoundGroup")
		group.Name = "DopamineStage_" .. inst
		group.Volume = 1
		local function fx(className: string, props: { [string]: any })
			local e = Instance.new(className :: any)
			for k, v in pairs(props) do
				(e :: any)[k] = v
			end
			e.Parent = group
		end
		if inst == "Piano" then
			fx("EqualizerSoundEffect", { LowGain = 3, MidGain = 0, HighGain = -3 })
			fx("ReverbSoundEffect", { DecayTime = 1.6, Density = 0.8, Diffusion = 0.8, WetLevel = -10, DryLevel = 0 })
		elseif inst == "Synth" then
			fx("ChorusSoundEffect", { Depth = 0.25, Mix = 0.5, Rate = 1.2 })
			fx("ReverbSoundEffect", { DecayTime = 2.2, WetLevel = -8, DryLevel = 0 })
		elseif inst == "Guitar" then
			fx("DistortionSoundEffect", { Level = tonumber(cfg().Guitar and cfg().Guitar.Distortion) or 0.35 })
			fx("EqualizerSoundEffect", { LowGain = 2, MidGain = 3, HighGain = -6 })
		elseif inst == "Bass" then
			fx("EqualizerSoundEffect", { LowGain = 8, MidGain = -2, HighGain = -12 })
			fx("CompressorSoundEffect", { Threshold = -14, Ratio = 3 })
		elseif inst == "Xylophone" then
			fx("EqualizerSoundEffect", { LowGain = -4, MidGain = 1, HighGain = 3 })
			fx("ReverbSoundEffect", { DecayTime = 1.0, WetLevel = -14, DryLevel = 0 })
		elseif inst == "Drums" then
			fx("CompressorSoundEffect", { Threshold = -12, Ratio = 3 })
			fx("EqualizerSoundEffect", { LowGain = 4, MidGain = 0, HighGain = 1 })
		else
			fx("ReverbSoundEffect", { DecayTime = 1.2, WetLevel = -12, DryLevel = 0 })
		end
		group.Parent = SoundService
		return group
	end)
	if ok then
		self.Groups[inst] = result
		return result
	end
	return nil
end

local function voiceFor(self: any, emitter: Instance, sampleId: string, inst: string): Voice?
	local byEmitter = self.Pools[emitter]
	if not byEmitter then
		byEmitter = {}
		self.Pools[emitter] = byEmitter
	end
	local pool = byEmitter[sampleId]
	if not pool then
		pool = { List = {}, Next = 1 }
		byEmitter[sampleId] = pool
	end
	local voice = pool.List[pool.Next]
	if not voice or not voice.Sound.Parent then
		local c = cfg()
		local sound = Instance.new("Sound")
		sound.Name = "StageVoice"
		sound.SoundId = sampleId
		sound.RollOffMode = Enum.RollOffMode.InverseTapered
		sound.RollOffMinDistance = tonumber(c.RollOffMin) or 14
		sound.RollOffMaxDistance = tonumber(c.RollOffMax) or 120
		sound.Volume = 0
		local group = MusicSynth.Group(self, inst)
		if group then
			sound.SoundGroup = group
		end
		sound.Parent = emitter
		voice = { Sound = sound, Start = 0, Decay = 1, V0 = 0, Busy = false }
		pool.List[pool.Next] = voice
	end
	pool.Next = pool.Next % VOICES + 1
	return voice
end

local function master(self: any): number
	-- (volume du joueur relu au plus toutes les 0,5 s)
	if self.Clock - self.VolumeAt > 0.5 then
		self.VolumeAt = self.Clock
		self.Volume = userVolume()
	end
	return self.Volume * (tonumber(cfg().Volume) or 0.8)
end

local function fire(self: any, emitter: Instance?, inst: string, sampleId: string, speed: number, volume: number, decay: number, delay: number?)
	if not emitter or not emitter.Parent or type(sampleId) ~= "string" or sampleId == "" or volume <= MIN_VOLUME then
		return
	end
	local function go()
		if not emitter.Parent then
			return
		end
		local voice = voiceFor(self, emitter, sampleId, inst)
		if not voice then
			return
		end
		local sound = voice.Sound
		pcall(function()
			sound:Stop()
			sound.PlaybackSpeed = math.clamp(speed, 0.05, 20)
			sound.Volume = volume
			sound.TimePosition = 0
			sound:Play()
		end)
		voice.Start = self.Clock
		voice.Decay = math.max(0.05, decay)
		voice.V0 = volume
		if not voice.Busy then
			voice.Busy = true
			table.insert(self.Active, voice)
		end
		self.Played += 1
	end
	if delay and delay > 0.005 then
		task.delay(delay, go)
	else
		go()
	end
end

-- Note d'un instrument mélodique
function MusicSynth.Note(self: any, inst: string, note: number, vel: number, emitter: Instance?)
	local c = cfg()[inst]
	if type(c) ~= "table" then
		return
	end
	local m = master(self)
	if m <= 0 then
		return
	end
	local speed = MusicSynth.Speed(inst, note)
	local base = (tonumber(c.Volume) or 0.6) * math.clamp(vel, 0.05, 1) * m
	local layers = type(c.Layers) == "table" and c.Layers or { { 0, 1 } }
	for _, layer in ipairs(layers) do
		local semis, vol = tonumber(layer[1]) or 0, tonumber(layer[2]) or 1
		fire(self, emitter, inst, c.SampleId, speed * 2 ^ (semis / 12), base * vol, tonumber(c.Decay) or 1, nil)
	end
end

local function layers(self: any, inst: string, list: any, vel: number, emitter: Instance?, groupVolume: number)
	if type(list) ~= "table" then
		return
	end
	local m = master(self)
	if m <= 0 then
		return
	end
	for _, layer in ipairs(list) do
		local id, speed, vol, decay, delay = layer[1], tonumber(layer[2]) or 1, tonumber(layer[3]) or 1, tonumber(layer[4]) or 0.3, tonumber(layer[5])
		fire(self, emitter, inst, id, speed, vol * groupVolume * math.clamp(vel, 0.05, 1) * m, decay, delay)
	end
end

function MusicSynth.Drum(self: any, piece: number, vel: number, emitter: Instance?)
	local name = MusicData.DRUMS[piece]
	local d = cfg().Drums
	if not name or type(d) ~= "table" then
		return
	end
	layers(self, "Drums", d[name], vel, emitter, tonumber(d.Volume) or 0.75)
end

function MusicSynth.Pad(self: any, pad: number, vel: number, emitter: Instance?)
	local name = MusicData.DJ_PADS[pad]
	local d = cfg().DJ
	if not name or type(d) ~= "table" then
		return
	end
	layers(self, "DJ", d[name], vel, emitter, tonumber(d.Volume) or 0.8)
end

-- Enveloppes (fondu de sortie de chaque voix)
function MusicSynth.Step(self: any, dt: number)
	self.Clock += dt
	local keep = {}
	for _, voice in ipairs(self.Active) do
		local age = self.Clock - voice.Start
		local sound = voice.Sound
		if not sound.Parent or age >= voice.Decay then
			voice.Busy = false
			if sound.Parent then
				pcall(function()
					sound.Volume = 0
					sound:Stop()
				end)
			end
		else
			-- (courbe douce : forte attaque puis extinction)
			local u = age / voice.Decay
			sound.Volume = voice.V0 * (1 - u) * (1 - u)
			table.insert(keep, voice)
		end
	end
	self.Active = keep
end

function MusicSynth.Destroy(self: any)
	for _, byEmitter in pairs(self.Pools) do
		for _, pool in pairs(byEmitter) do
			for _, voice in ipairs(pool.List) do
				pcall(function()
					voice.Sound:Destroy()
				end)
			end
		end
	end
	table.clear(self.Pools)
	table.clear(self.Active)
	for _, g in pairs(self.Groups) do
		pcall(function()
			g:Destroy()
		end)
	end
	table.clear(self.Groups)
end

return MusicSynth
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="216">
          <Properties>
            <string name="Name">MusicUI</string>
            <string name="Source"><![CDATA[--[[
	MusicUI (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > MusicUI

	🎵 Interface de la scène musicale (v9.9, MUSIC99) : ScreenGui
	"MusicStageGui" (TownClient : KEEP_GUIS).
	  - PANNEAU D'INSTRUMENT (en bas, PC et téléphone) : clavier (piano,
	    synthé, xylophone : 2 octaves + 5 notes, touches noires par-dessus),
	    pads de batterie, accords + notes de solo (guitare), notes de basse,
	    boucles et effets (DJ). Chaque touche montre sa touche du clavier
	    (UserInputService:GetStringForKeyCode : AZERTY / QWERTY justes) ;
	    au doigt : on touche (InputBegan : aucune latence). Barre du haut :
	    instrument, "🎵 Jouer une musique", octave ◀ ▶, "✖ Se lever".
	  - CHOIX DES MORCEAUX (carte au centre) : les 8 morceaux (▶), "🔁
	    Enchaîner", "⏹ Stop", et la 📻 radio lofi (Config.Music) sur la scène.
	  - PASTILLE "en cours" (en haut) : titre + barre de progression.

	API :
	  MusicUI.new(callbacks) -> ui     callbacks = { Note(value, vel),
	    Leave(), Picker(), Song(id, mode), StopSong(), Radio(index),
	    Octave(delta), Chain(on) }
	  ui:Open(stationId, layout) / ui:Close() / ui:IsOpen()
	  ui:Flash(value) / ui:SetLoop(index) / ui:SetOctaveText(text)
	  ui:OpenPicker(state) / ui:ClosePicker() / ui:IsPickerOpen()
	  ui:SetNowPlaying(text?, progress?)
	  ui:Destroy()
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Client = script.Parent.Parent
local UIUtil = require(Client.UIUtil)
local Config = require(ReplicatedStorage.Shared.Config)
local Locale = require(ReplicatedStorage.Shared.Locale)
local MusicData = require(ReplicatedStorage.Shared.MusicData)

local MusicUI = {}
MusicUI.__index = MusicUI

local PINK = Color3.fromRGB(255, 132, 184)
local HOT = Color3.fromRGB(236, 72, 140)
local INK = Color3.fromRGB(70, 44, 82)
local CARD = Color3.fromRGB(255, 250, 253)
local WHITE = Color3.fromRGB(255, 255, 255)
local DARK = Color3.fromRGB(34, 30, 44)
local MINT = Color3.fromRGB(110, 210, 170)

local function T(text: string, ...): string
	return Locale.T(text, ...)
end

local function keyLabel(kc: Enum.KeyCode?): string
	if not kc then
		return ""
	end
	local ok, s = pcall(function()
		return UserInputService:GetStringForKeyCode(kc)
	end)
	if ok and type(s) == "string" and s ~= "" then
		return string.upper(s)
	end
	local name = kc.Name
	local digits = { Zero = "0", One = "1", Two = "2", Three = "3", Four = "4", Five = "5", Six = "6", Seven = "7", Eight = "8", Nine = "9", Comma = "," }
	return digits[name] or name
end

local function corner(p: Instance, r: number)
	UIUtil.Corner(p, UDim.new(0, r))
end

local function text(parent: Instance, name: string, value: string, pos: UDim2, size: UDim2, color: Color3, font: Enum.Font?, scaled: boolean?): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundTransparency = 1
	l.Position = pos
	l.Size = size
	l.Font = font or Enum.Font.FredokaOne
	l.TextColor3 = color
	l.TextScaled = scaled ~= false
	l.Text = value
	l.Parent = parent
	return l
end

local function button(parent: Instance, name: string, label: string, color: Color3, textColor: Color3?): TextButton
	local b = Instance.new("TextButton")
	b.Name = name
	b.AutoButtonColor = false
	b.BackgroundColor3 = color
	b.Font = Enum.Font.FredokaOne
	b.TextColor3 = textColor or WHITE
	b.TextScaled = true
	b.Text = label
	b.Parent = parent
	corner(b, 10)
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 6)
	pad.PaddingRight = UDim.new(0, 6)
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingBottom = UDim.new(0, 4)
	pad.Parent = b
	return b
end

-- Appui immédiat (souris ou doigt) : InputBegan, pas Activated
local function onPress(self: any, b: GuiObject, fn: () -> ())
	table.insert(self.Conns, b.InputBegan:Connect(function(input: InputObject)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
			fn()
		end
	end))
end

function MusicUI.new(callbacks: any)
	local playerGui = Players.LocalPlayer and Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")
	local screen = Instance.new("ScreenGui")
	screen.Name = "MusicStageGui"
	screen.ResetOnSpawn = false
	screen.IgnoreGuiInset = false
	screen.DisplayOrder = 24
	screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screen.Parent = playerGui
	local self = setmetatable({
		Screen = screen,
		Cb = callbacks,
		Conns = {} :: { RBXScriptConnection },
		PanelConns = {} :: { RBXScriptConnection },
		Buttons = {} :: { [number]: { GuiObject } },
		Flashes = {} :: { [GuiObject]: number },
		Panel = nil :: Frame?,
		Picker = nil :: Frame?,
		Station = nil :: string?,
		Loop = 0,
		PickerState = nil :: any,
	}, MusicUI)
	-- pastille "en cours"
	local chip = Instance.new("Frame")
	chip.Name = "NowPlaying"
	chip.AnchorPoint = Vector2.new(0.5, 0)
	chip.Position = UDim2.new(0.5, 0, 0, 58)
	chip.Size = UDim2.fromOffset(330, 44)
	chip.BackgroundColor3 = DARK
	chip.BackgroundTransparency = 0.12
	chip.Visible = false
	chip.Parent = screen
	corner(chip, 22)
	UIUtil.Stroke(chip, PINK, 2, 0)
	local chipText = text(chip, "Text", "", UDim2.fromOffset(14, 5), UDim2.new(1, -28, 0, 24), WHITE, Enum.Font.GothamBold)
	local bar = Instance.new("Frame")
	bar.Name = "Track"
	bar.Position = UDim2.new(0, 16, 1, -11)
	bar.Size = UDim2.new(1, -32, 0, 4)
	bar.BackgroundColor3 = Color3.fromRGB(80, 70, 96)
	bar.BorderSizePixel = 0
	bar.Parent = chip
	corner(bar, 2)
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = PINK
	fill.BorderSizePixel = 0
	fill.Parent = bar
	corner(fill, 2)
	self.Chip = { Frame = chip, Text = chipText, Fill = fill }
	return self
end

function MusicUI.IsOpen(self: any): boolean
	return self.Panel ~= nil
end

function MusicUI.IsPickerOpen(self: any): boolean
	return self.Picker ~= nil
end

local function phone(self: any): boolean
	local size = self.Screen.AbsoluteSize
	return size.X < 820 or size.Y < 500 or UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

----------------------------------------------------------------------
-- Panneau d'instrument
----------------------------------------------------------------------

-- layout = { Kind = "keys", Low, Count, Keys = { [note] = KeyCode } }
--        | { Kind = "pads", Rows = { { { Value, Label, KeyCode, Color?, Wide? } } } }
function MusicUI.Open(self: any, station: string, layout: any)
	self:Close()
	self.Station = station
	local st = MusicData.STATIONS[station]
	local small = phone(self)
	local screenSize = self.Screen.AbsoluteSize
	local width = math.clamp(screenSize.X - 16, 320, 1000)
	local height = small and math.clamp(screenSize.Y * 0.46, 170, 300) or 262
	local panel = Instance.new("Frame")
	panel.Name = "InstrumentPanel"
	panel.AnchorPoint = Vector2.new(0.5, 1)
	panel.Position = UDim2.new(0.5, 0, 1, small and -6 or -24)
	panel.Size = UDim2.fromOffset(width, height)
	panel.BackgroundColor3 = CARD
	panel.BackgroundTransparency = 0.04
	panel.Parent = self.Screen
	corner(panel, 18)
	UIUtil.Stroke(panel, PINK, 3, 0)
	UIUtil.SinkClicks(panel)
	self.Panel = panel
	-- barre du haut
	local barH = small and 34 or 40
	local title = text(panel, "Title", st.Icon .. " " .. T(st.Name), UDim2.fromOffset(14, 6), UDim2.new(0.34, -14, 0, barH - 6), HOT)
	title.TextXAlignment = Enum.TextXAlignment.Left
	local leave = button(panel, "Leave", T("✖ Stand up"), Color3.fromRGB(226, 90, 110))
	leave.AnchorPoint = Vector2.new(1, 0)
	leave.Position = UDim2.new(1, -10, 0, 6)
	leave.Size = UDim2.new(0.2, 0, 0, barH - 6)
	onPress(self, leave, function()
		self.Cb.Leave()
	end)
	local songs = button(panel, "Songs", T("▶️ Play a song"), PINK)
	songs.AnchorPoint = Vector2.new(1, 0)
	songs.Position = UDim2.new(0.8, -18, 0, 6)
	songs.Size = UDim2.new(0.24, 0, 0, barH - 6)
	onPress(self, songs, function()
		self.Cb.Picker()
	end)
	if layout.Kind == "keys" then
		local down = button(panel, "OctDown", "◀", Color3.fromRGB(150, 120, 200))
		down.Position = UDim2.new(0.34, 4, 0, 6)
		down.Size = UDim2.fromOffset(barH, barH - 6)
		local oct = text(panel, "Octave", "", UDim2.new(0.34, barH + 8, 0, 8), UDim2.fromOffset(small and 70 or 96, barH - 10), INK, Enum.Font.GothamBold)
		local up = button(panel, "OctUp", "▶", Color3.fromRGB(150, 120, 200))
		up.Position = UDim2.new(0.34, barH + (small and 82 or 108), 0, 6)
		up.Size = UDim2.fromOffset(barH, barH - 6)
		onPress(self, down, function()
			self.Cb.Octave(-1)
		end)
		onPress(self, up, function()
			self.Cb.Octave(1)
		end)
		self.OctaveLabel = oct
	end
	local body = Instance.new("Frame")
	body.Name = "Body"
	body.BackgroundTransparency = 1
	body.Position = UDim2.fromOffset(10, barH + 6)
	body.Size = UDim2.new(1, -20, 1, -(barH + 14))
	body.Parent = panel
	self.Buttons = {}
	if layout.Kind == "keys" then
		self:BuildKeys(body, layout)
	else
		self:BuildPads(body, layout)
	end
	if not small then
		local hint = text(panel, "Hint", T("Keyboard keys play too · Space = stand up"), UDim2.new(0, 0, 1, 2), UDim2.new(1, 0, 0, 16), INK, Enum.Font.GothamBold)
		hint.TextTransparency = 0.25
	end
	UIUtil.Pop(panel, 0.9, 0.18)
end

function MusicUI.BuildKeys(self: any, body: Frame, layout: any)
	local low, count = layout.Low, layout.Count
	local whites = {}
	for n = low, low + count - 1 do
		local pc = n % 12
		if not (pc == 1 or pc == 3 or pc == 6 or pc == 8 or pc == 10) then
			table.insert(whites, n)
		end
	end
	local nw = #whites
	local index = {}
	for i, n in ipairs(whites) do
		index[n] = i
	end
	for i, n in ipairs(whites) do
		local k = Instance.new("TextButton")
		k.Name = "White"
		k.AutoButtonColor = false
		k.BackgroundColor3 = WHITE
		k.Position = UDim2.new((i - 1) / nw, 1, 0, 0)
		k.Size = UDim2.new(1 / nw, -2, 1, 0)
		k.Text = ""
		k.ZIndex = 2
		k.Parent = body
		corner(k, 6)
		UIUtil.Stroke(k, Color3.fromRGB(200, 190, 210), 1, 0)
		local name = MusicData.NoteName(n, Locale.IsFrench())
		local lab = text(k, "Note", (n % 12 == 0) and name or string.gsub(name, "%-?%d+$", ""), UDim2.new(0, 2, 1, -38), UDim2.new(1, -4, 0, 16), Color3.fromRGB(150, 130, 160), Enum.Font.GothamBold)
		lab.ZIndex = 3
		local key = text(k, "Key", keyLabel(layout.Keys and layout.Keys[n]), UDim2.new(0, 2, 1, -20), UDim2.new(1, -4, 0, 16), HOT, Enum.Font.GothamBold)
		key.ZIndex = 3
		k:SetAttribute("Base", WHITE)
		self.Buttons[n] = { k }
		onPress(self, k, function()
			self.Cb.Note(n, 0.85)
		end)
	end
	for n = low, low + count - 1 do
		local pc = n % 12
		if pc == 1 or pc == 3 or pc == 6 or pc == 8 or pc == 10 then
			local left = index[n - 1]
			if left then
				local k = Instance.new("TextButton")
				k.Name = "Black"
				k.AutoButtonColor = false
				k.BackgroundColor3 = Color3.fromRGB(30, 26, 38)
				k.AnchorPoint = Vector2.new(0.5, 0)
				k.Position = UDim2.new(left / nw, 0, 0, 0)
				k.Size = UDim2.new(0.62 / nw, 0, 0.6, 0)
				k.Text = ""
				k.ZIndex = 4
				k.Parent = body
				corner(k, 5)
				local key = text(k, "Key", keyLabel(layout.Keys and layout.Keys[n]), UDim2.new(0, 1, 1, -18), UDim2.new(1, -2, 0, 14), PINK, Enum.Font.GothamBold)
				key.ZIndex = 5
				k:SetAttribute("Base", Color3.fromRGB(30, 26, 38))
				self.Buttons[n] = { k }
				onPress(self, k, function()
					self.Cb.Note(n, 0.85)
				end)
			end
		end
	end
end

function MusicUI.BuildPads(self: any, body: Frame, layout: any)
	local rows = layout.Rows
	local nRows = #rows
	for r, row in ipairs(rows) do
		local total = 0
		for _, pad in ipairs(row) do
			total += pad.Wide or 1
		end
		local x = 0
		for _, pad in ipairs(row) do
			local w = (pad.Wide or 1) / total
			local color = pad.Color or Color3.fromRGB(150, 120, 220)
			local b = button(body, "Pad", "", color)
			b.Position = UDim2.new(x, 3, (r - 1) / nRows, 3)
			b.Size = UDim2.new(w, -6, 1 / nRows, -6)
			UIUtil.Stroke(b, WHITE, 2, 0.3)
			local main = text(b, "Label", pad.Label, UDim2.fromScale(0, 0), UDim2.fromScale(1, 0.66), WHITE)
			main.ZIndex = 2
			local key = text(b, "Key", keyLabel(pad.KeyCode), UDim2.fromScale(0, 0.66), UDim2.fromScale(1, 0.32), Color3.fromRGB(255, 240, 250), Enum.Font.GothamBold)
			key.ZIndex = 2
			key.TextTransparency = 0.15
			b:SetAttribute("Base", color)
			local list = self.Buttons[pad.Value] or {}
			table.insert(list, b)
			self.Buttons[pad.Value] = list
			onPress(self, b, function()
				self.Cb.Note(pad.Value, 0.9)
			end)
			x += w
		end
	end
end

function MusicUI.Close(self: any)
	if self.Panel then
		self.Panel:Destroy()
		self.Panel = nil
	end
	self.OctaveLabel = nil
	self.Station = nil
	self.Buttons = {}
	table.clear(self.Flashes)
end

function MusicUI.SetOctaveText(self: any, value: string)
	if self.OctaveLabel then
		self.OctaveLabel.Text = value
	end
end

-- Touche / pad qui s'allume (retour visuel de chaque note)
function MusicUI.Flash(self: any, value: number)
	local list = self.Buttons[value]
	if not list then
		return
	end
	for _, b in ipairs(list) do
		b.BackgroundColor3 = PINK
		self.Flashes[b] = os.clock()
	end
end

function MusicUI.SetLoop(self: any, index: number)
	self.Loop = index
	for i = 1, MusicData.DJ_LOOPS do
		for _, b in ipairs(self.Buttons[i] or {}) do
			local stroke = b:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Color = i == index and Color3.fromRGB(255, 240, 120) or WHITE
				stroke.Thickness = i == index and 4 or 2
			end
		end
	end
end

-- (appelé à chaque image : les touches reprennent leur couleur)
function MusicUI.Step(self: any)
	local t = os.clock()
	for b, at in pairs(self.Flashes) do
		if t - at > 0.14 then
			local base = b:GetAttribute("Base")
			if typeof(base) == "Color3" then
				b.BackgroundColor3 = base
			end
			self.Flashes[b] = nil
		end
	end
end

----------------------------------------------------------------------
-- Choix des morceaux + radio
----------------------------------------------------------------------

function MusicUI.OpenPicker(self: any, state: any)
	self:ClosePicker()
	self.PickerState = state
	local small = phone(self)
	local screenSize = self.Screen.AbsoluteSize
	local w = math.clamp(screenSize.X - 24, 300, 560)
	local h = math.clamp(screenSize.Y - (small and 40 or 120), 260, 520)
	local dim = Instance.new("TextButton")
	dim.Name = "PickerDim"
	dim.Size = UDim2.fromScale(1, 1)
	dim.BackgroundColor3 = Color3.new(0, 0, 0)
	dim.BackgroundTransparency = 0.5
	dim.AutoButtonColor = false
	dim.Text = ""
	dim.ZIndex = 20
	dim.Parent = self.Screen
	local card = Instance.new("Frame")
	card.Name = "Picker"
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	card.Position = UDim2.fromScale(0.5, 0.5)
	card.Size = UDim2.fromOffset(w, h)
	card.BackgroundColor3 = CARD
	card.ZIndex = 21
	card.Parent = dim
	corner(card, 22)
	UIUtil.Stroke(card, PINK, 3, 0)
	UIUtil.SinkClicks(card)
	table.insert(self.Conns, dim.Activated:Connect(function()
		self:ClosePicker()
	end))
	local title = text(card, "Title", T("🎵 Stage music"), UDim2.fromOffset(18, 12), UDim2.new(1, -80, 0, 34), HOT)
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.ZIndex = 22
	local close = UIUtil.CloseButton({ Name = "ClosePicker", Size = 36, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 12), ZIndex = 23 })
	close.Parent = card
	table.insert(self.Conns, close.Activated:Connect(function()
		self:ClosePicker()
	end))
	local sub = text(card, "Sub", T("Everyone near the stage hears it. The instruments play by themselves!"), UDim2.fromOffset(18, 48), UDim2.new(1, -36, 0, 18), INK, Enum.Font.GothamBold)
	sub.TextXAlignment = Enum.TextXAlignment.Left
	sub.ZIndex = 22
	local list = Instance.new("ScrollingFrame")
	list.Name = "Songs"
	list.Position = UDim2.fromOffset(12, 74)
	local bh = small and 32 or 42
	list.Size = UDim2.new(1, -24, 1, -74 - (bh * 2 + 28))
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 6
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.CanvasSize = UDim2.new()
	list.ZIndex = 22
	list.Parent = card
	local layoutList = Instance.new("UIListLayout")
	layoutList.Padding = UDim.new(0, 6)
	layoutList.SortOrder = Enum.SortOrder.LayoutOrder
	layoutList.Parent = list
	for i, song in ipairs(MusicData.SONGS) do
		local playing = state.SongId == song.Id
		local row = Instance.new("TextButton")
		row.Name = song.Id
		row.LayoutOrder = i
		row.AutoButtonColor = true
		row.Text = ""
		row.Size = UDim2.new(1, -8, 0, small and 44 or 50)
		row.BackgroundColor3 = playing and Color3.fromRGB(255, 226, 240) or WHITE
		row.ZIndex = 22
		row.Parent = list
		corner(row, 12)
		UIUtil.Stroke(row, playing and HOT or Color3.fromRGB(236, 210, 226), 2, 0)
		local icon = text(row, "Icon", song.Icon, UDim2.fromOffset(8, 6), UDim2.new(0, 34, 1, -12), INK)
		icon.ZIndex = 23
		local name = text(row, "Name", T(song.Name), UDim2.fromOffset(50, 4), UDim2.new(1, -140, 0.55, -2), INK)
		name.TextXAlignment = Enum.TextXAlignment.Left
		name.ZIndex = 23
		local secs = math.floor(MusicData.Duration(song.Id) + 0.5)
		local meta = text(row, "Meta", T(song.Author) .. " · " .. string.format("%d:%02d", secs // 60, secs % 60), UDim2.new(0, 50, 0.55, 0), UDim2.new(1, -140, 0.4, -2), Color3.fromRGB(140, 110, 150), Enum.Font.GothamBold)
		meta.TextXAlignment = Enum.TextXAlignment.Left
		meta.ZIndex = 23
		local play = text(row, "Play", playing and "🔊" or "▶️", UDim2.new(1, -60, 0, 6), UDim2.new(0, 50, 1, -12), HOT)
		play.ZIndex = 23
		table.insert(self.Conns, row.Activated:Connect(function()
			self.Cb.Song(song.Id, self.PickerState and self.PickerState.Chain and "all" or "one")
			self:ClosePicker()
		end))
	end
	-- ligne du bas : enchaîner / stop ; radio
	local bottom = Instance.new("Frame")
	bottom.Name = "Bottom"
	bottom.BackgroundTransparency = 1
	bottom.AnchorPoint = Vector2.new(0, 1)
	bottom.Position = UDim2.new(0, 12, 1, -10)
	bottom.Size = UDim2.new(1, -24, 0, bh * 2 + 12)
	bottom.ZIndex = 22
	bottom.Parent = card
	local chain = button(bottom, "Chain", "", Color3.fromRGB(150, 120, 220))
	chain.Size = UDim2.new(0.5, -4, 0, bh)
	chain.ZIndex = 23
	local function refreshChain()
		chain.Text = (self.PickerState.Chain and "🔁 " or "➡️ ") .. (self.PickerState.Chain and T("Play all: on") or T("Play all: off"))
		chain.BackgroundColor3 = self.PickerState.Chain and MINT or Color3.fromRGB(150, 120, 220)
	end
	refreshChain()
	table.insert(self.Conns, chain.Activated:Connect(function()
		self.PickerState.Chain = not self.PickerState.Chain
		refreshChain()
		if self.Cb.Chain then
			self.Cb.Chain(self.PickerState.Chain)
		end
	end))
	local stop = button(bottom, "Stop", T("⏹ Stop"), Color3.fromRGB(226, 90, 110))
	stop.Position = UDim2.new(0.5, 4, 0, 0)
	stop.Size = UDim2.new(0.5, -4, 0, bh)
	stop.ZIndex = 23
	table.insert(self.Conns, stop.Activated:Connect(function()
		self.Cb.StopSong()
		self:ClosePicker()
	end))
	local playlist = Config.Music and Config.Music.Playlist or {}
	local radioOn = type(state.Radio) == "number" and state.Radio > 0
	local track = radioOn and playlist[state.Radio] or nil
	local radio = button(bottom, "Radio", "", radioOn and MINT or Color3.fromRGB(96, 150, 230))
	radio.Position = UDim2.fromOffset(0, bh + 8)
	radio.Size = UDim2.new(1, 0, 0, bh + 2)
	radio.ZIndex = 23
	radio.Text = radioOn and ("📻 " .. T("Stage radio: %s (tap: next)", tostring(track and track.Name or "?"))) or ("📻 " .. T("Stage radio: lo-fi on the speakers"))
	table.insert(self.Conns, radio.Activated:Connect(function()
		local count = #playlist
		if count == 0 then
			return
		end
		local nextIndex = radioOn and (state.Radio % count + 1) or math.random(1, count)
		self.Cb.Radio(nextIndex)
		self:ClosePicker()
	end))
	if radioOn then
		local off = button(bottom, "RadioOff", T("Off"), Color3.fromRGB(226, 90, 110))
		off.AnchorPoint = Vector2.new(1, 0)
		off.Position = UDim2.new(1, -6, 0, bh + 12)
		off.Size = UDim2.fromOffset(70, bh - 8)
		off.ZIndex = 24
		table.insert(self.Conns, off.Activated:Connect(function()
			self.Cb.Radio(0)
			self:ClosePicker()
		end))
	end
	self.Picker = dim
	UIUtil.Pop(card, 0.9, 0.18)
end

function MusicUI.ClosePicker(self: any)
	if self.Picker then
		self.Picker:Destroy()
		self.Picker = nil
	end
end

function MusicUI.SetNowPlaying(self: any, value: string?, progress: number?)
	local chip = self.Chip
	if not value then
		chip.Frame.Visible = false
		return
	end
	chip.Frame.Visible = true
	chip.Text.Text = value
	chip.Fill.Size = UDim2.fromScale(math.clamp(progress or 0, 0, 1), 1)
end

function MusicUI.Destroy(self: any)
	self:Close()
	self:ClosePicker()
	UIUtil.DisconnectAll(self.Conns)
	if self.Screen then
		self.Screen:Destroy()
	end
end

return MusicUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="217">
          <Properties>
            <string name="Name">ParkPlay</string>
            <string name="Source"><![CDATA[--[[
	ParkPlay (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > ParkPlay

	🛝 L'AIRE DE JEUX de Dopamine Town, côté CLIENT (v9.9, PARK99).
	"Rien ne fonctionne" (v9.8) -> ici TOUT se fait pour de vrai, avec une
	animation :
	  - 🎠 3 BALANÇOIRES (portique en acier, vraies chaînes à maillons,
	    sangles en caoutchouc) : E -> on s'assoit, la balançoire part en
	    PENDULE (ω = √(g/L) à l'échelle réelle), l'amplitude monte quand on
	    pompe (jambes tendues à l'aller, repliées au retour), les mains
	    tiennent les chaînes ;
	  - 🛝 TOBOGGAN : E au pied de l'échelle -> l'avatar grimpe barreau par
	    barreau (mains / pieds alternés), s'assoit en haut et GLISSE (vitesse
	    calculée : gravité, frottement, profil courbe), sort en bas et se
	    relève ; mur d'escalade grimpable (TrussPart du serveur) ;
	  - ⚖️ TAPE-CUL (2 places : seul, la bascule se fait avec le poids ; à
	    deux, chacun pousse à son tour) ; 🌀 TOURNIQUET (4 places, il prend de
	    la vitesse et ralentit tout seul) ; 🐴🦆 JEUX À RESSORT (tangage,
	    roulis, rebond ; le ressort se tord) ;
	  - 🐒 BARRES DE SINGE : E à un bout -> on monte, on se suspend, on
	    avance barre après barre (bras alternés, corps qui balance) et on
	    saute à l'autre bout ;
	  - 🏖️ BAC À SABLE : E -> à genoux, la pelle creuse (trou + tas qui
	    grossit, grains qui volent), un château de sable apparaît ;
	  - 🪑 2 bancs des parents (SitAnimator : pose et attentes du banc).
	Les jeux qui bougent le font d'après l'heure du SERVEUR et 4 attributs
	(ParkMotion) : tout le monde voit la même chose. Les sièges du serveur
	(invisibles) sont déplacés localement avec le décor : un avatar assis
	suit sa balançoire sans à-coup (RenderStepped). Les poses (Motor6D
	.Transform, R15 et R6, IK à 2 os pour les bras) sont écrites dans
	Stepped, après l'Animator, pour nous ET pour les autres joueurs proches
	(assis, sur la glissière, sur l'échelle ou suspendus aux barres).

	Construit par TownGreenery quand l'avatar approche (NearDetail
	"Playground") : ParkPlay.Build(g, parent, serverModel). Détruit avec le
	dossier de TownGreenery : tout est remis (pose, PlatformStand).
	Aucun son, aucune lumière, rien sur le serveur.

	API :
	  ParkPlay.Build(g: CFrame, parent: Instance, server: Instance?) -> park
	  ParkPlay.Debug() -> table   (tests / rendus)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Locale = require(ReplicatedStorage.Shared.Locale)
local ParkMotion = require(ReplicatedStorage.Shared.ParkMotion)

local ParkPlay = {}

local M = Enum.Material
local rgb = Color3.fromRGB
local rad = math.rad
local TAU = math.pi * 2
local CYL = Enum.PartType.Cylinder
local BALL = Enum.PartType.Ball
local I = CFrame.identity
local UP = Vector3.new(0, 1, 0)

local ANIM_R = 170 -- (studs) jeux animés en deçà
local POSE_R = 90 -- (studs) avatars des autres posés en deçà
local STEP_BUILD = 1 -- morceaux construits par image

-- Couleurs (aire de jeux moderne : acier thermolaqué, PEHD, bois, caoutchouc)
local GREEN = rgb(46, 118, 92)
local GREEN_D = rgb(34, 92, 72)
local RED = rgb(206, 64, 58)
local BLUE = rgb(48, 110, 186)
local BLUE_D = rgb(36, 84, 150)
local YELLOW = rgb(246, 196, 52)
local ORANGE = rgb(244, 138, 52)
local STEEL = rgb(176, 182, 190)
local STEEL_D = rgb(112, 118, 128)
local RUBBER_B = rgb(38, 38, 42)
local WOOD = rgb(168, 118, 76)
local WOOD_L = rgb(196, 150, 104)
local WHITE = rgb(248, 248, 244)
local SAND = rgb(232, 206, 156)
local SAND_D = rgb(200, 172, 124)
local INK = rgb(40, 34, 40)
local IRON = rgb(52, 50, 58)

----------------------------------------------------------------------
-- Petites fabriques (pièces locales, ancrées, sans collision ni requête)
----------------------------------------------------------------------

local function newPart(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?, shadow: boolean?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = shadow == true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		p.Shape = shape
	end
	p.Parent = parent
	return p
end

local function egg(parent: Instance, name: string, cf: CFrame, size: Vector3, color: Color3, material: Enum.Material?): Part
	local p = newPart(parent, name, size, cf, color, material)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

local function ball(parent: Instance, name: string, center: Vector3, d: number, color: Color3, material: Enum.Material?): Part
	return newPart(parent, name, Vector3.new(d, d, d), CFrame.new(center), color, material, BALL)
end

-- Repère d'un cylindre de a à b (axe X de la pièce = a -> b)
local function rodCF(a: Vector3, b: Vector3): CFrame
	local dir = b - a
	local len = dir.Magnitude
	if len < 1e-4 then
		return CFrame.new(a)
	end
	dir = dir / len
	local up = math.abs(dir.Y) > 0.95 and Vector3.new(1, 0, 0) or UP
	local z = dir:Cross(up).Unit
	local y = z:Cross(dir).Unit
	return CFrame.fromMatrix((a + b) / 2, dir, y, z)
end

local function rod(parent: Instance, name: string, a: Vector3, b: Vector3, d: number, color: Color3, material: Enum.Material?, shadow: boolean?): Part
	return newPart(parent, name, Vector3.new((b - a).Magnitude, d, d), rodCF(a, b), color, material or M.Metal, CYL, shadow)
end

-- Disque à axe vertical, dessus à `top` (dans le repère `cf`)
local function disc(parent: Instance, name: string, cf: CFrame, top: number, radius: number, thickness: number, color: Color3, material: Enum.Material?, shadow: boolean?): Part
	return newPart(parent, name, Vector3.new(thickness, radius * 2, radius * 2), cf * CFrame.new(0, top - thickness / 2, 0) * CFrame.Angles(0, 0, math.pi / 2), color, material, CYL, shadow)
end

-- Bloc entre deux points (section w x h)
local function slab(parent: Instance, name: string, a: Vector3, b: Vector3, w: number, h: number, color: Color3, material: Enum.Material?, shadow: boolean?): Part
	local dir = b - a
	local up = math.abs(dir.Unit.Y) > 0.95 and Vector3.new(1, 0, 0) or UP
	return newPart(parent, name, Vector3.new(w, h, dir.Magnitude), CFrame.lookAt((a + b) / 2, b, up), color, material, nil, shadow)
end

local function label(p: BasePart, text: string, color: Color3, bg: Color3, face: Enum.NormalId?)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "ParkSign"
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0.6
	gui.MaxDistance = 140
	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = bg
	frame.BorderSizePixel = 0
	frame.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.18, 0)
	corner.Parent = frame
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Position = UDim2.fromScale(0.05, 0.12)
	t.Size = UDim2.fromScale(0.9, 0.76)
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.TextColor3 = color
	t.Text = text
	t.Parent = frame
	gui.Parent = p
end

----------------------------------------------------------------------
-- Groupes mobiles (pièces + décalages figés par rapport au repère du jeu)
----------------------------------------------------------------------

type Group = { Parts: { BasePart }, Locals: { CFrame }, Frames: { CFrame }, Rest: CFrame }

local function newGroup(rest: CFrame): Group
	return { Parts = {}, Locals = {}, Frames = {}, Rest = rest }
end

-- Toutes les pièces de `folder` construites au repos (repère `rest`) -> groupe
local function adopt(group: Group, folder: Instance)
	for _, d in ipairs(folder:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(group.Parts, d)
			table.insert(group.Locals, group.Rest:ToObjectSpace(d.CFrame))
			table.insert(group.Frames, d.CFrame)
		end
	end
end

local function moveGroup(group: Group, frame: CFrame)
	local frames, locals = group.Frames, group.Locals
	for i = 1, #frames do
		frames[i] = frame * locals[i]
	end
	if #frames > 0 then
		workspace:BulkMoveTo(group.Parts, frames, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

----------------------------------------------------------------------
-- Types
----------------------------------------------------------------------

type Piece = {
	Kind: string, -- "Swing" | "Seesaw" | "Merry" | "Spring"
	Index: number,
	Groups: { Group },
	Server: Instance?, -- Model du serveur (attributs On / T0 / A0 / W0 + sièges)
	Seats: { [number]: Seat }, -- siège du serveur par place
	Settled: boolean,
	Extra: any,
}

type Park = {
	G: CFrame,
	Parent: Instance,
	Folder: Model,
	Server: Instance?,
	Queue: { () -> () },
	Pieces: { Piece },
	Prompts: { ProximityPrompt },
	Conns: { RBXScriptConnection },
	Scan: number,
	Sand: { any },
	Dead: boolean,
}

local parks: { Park } = {}
local conns: { RBXScriptConnection } = {}
local running = false
local failed = false
local clock = 0

----------------------------------------------------------------------
-- 🧍 Poses : Motor6D.Transform (R15 / R6), IK à 2 os pour les bras
----------------------------------------------------------------------

local R15: { [string]: { string } } = {
	Root = { "LowerTorso", "Root" }, Waist = { "UpperTorso", "Waist" }, Neck = { "Head", "Neck" },
	RShoulder = { "RightUpperArm", "RightShoulder" }, RElbow = { "RightLowerArm", "RightElbow" }, RWrist = { "RightHand", "RightWrist" },
	LShoulder = { "LeftUpperArm", "LeftShoulder" }, LElbow = { "LeftLowerArm", "LeftElbow" }, LWrist = { "LeftHand", "LeftWrist" },
	RHip = { "RightUpperLeg", "RightHip" }, RKnee = { "RightLowerLeg", "RightKnee" }, RAnkle = { "RightFoot", "RightAnkle" },
	LHip = { "LeftUpperLeg", "LeftHip" }, LKnee = { "LeftLowerLeg", "LeftKnee" }, LAnkle = { "LeftFoot", "LeftAnkle" },
}
local R6: { [string]: { string } } = {
	Root = { "HumanoidRootPart", "RootJoint" }, Neck = { "Torso", "Neck" },
	RShoulder = { "Torso", "Right Shoulder" }, LShoulder = { "Torso", "Left Shoulder" },
	RHip = { "Torso", "Right Hip" }, LHip = { "Torso", "Left Hip" },
}

type Rig = { R6: boolean, M: { [string]: Motor6D }, Root: BasePart, Humanoid: Humanoid, Character: Model }

local rigs: { [Model]: Rig } = {}

local function rigOf(character: Model): Rig?
	local cached = rigs[character]
	if cached and cached.Root.Parent == character and cached.M.Root and cached.M.Root.Parent then
		return cached
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or not root:IsA("BasePart") then
		return nil
	end
	local r6 = humanoid.RigType == Enum.HumanoidRigType.R6
	local map = r6 and R6 or R15
	local motors: { [string]: Motor6D } = {}
	for key, spec in pairs(map) do
		local part = character:FindFirstChild(spec[1])
		local m = part and part:FindFirstChild(spec[2])
		if m and m:IsA("Motor6D") then
			motors[key] = m
		end
	end
	if r6 and not motors.Root then
		-- (R6 : RootJoint parfois rangé dans le Torso)
		local torso = character:FindFirstChild("Torso")
		local m = torso and torso:FindFirstChild("RootJoint")
		if m and m:IsA("Motor6D") then
			motors.Root = m
		end
	end
	if not motors.Root or not motors.RShoulder or not motors.LShoulder or not motors.RHip or not motors.LHip then
		return nil
	end
	if not r6 and (not motors.Waist or not motors.RElbow or not motors.LElbow) then
		return nil
	end
	local rig: Rig = { R6 = r6, M = motors, Root = root, Humanoid = humanoid, Character = character }
	rigs[character] = rig
	return rig
end

-- rotation `r` exprimée dans le repère de la pièce parente, au pivot
local function conj(m: Motor6D, r: CFrame): CFrame
	local c = m.C0.Rotation
	return c:Inverse() * r * c
end

-- Repère orthonormé : X = a, Y = partie de f perpendiculaire à a
local function basis(a: Vector3, f: Vector3): CFrame
	local x = a.Unit
	local y = f - x * f:Dot(x)
	if y.Magnitude < 1e-4 then
		y = math.abs(x.Y) < 0.9 and UP - x * x.Y or Vector3.new(0, 0, 1) - x * x.Z
	end
	y = y.Unit
	return CFrame.fromMatrix(Vector3.zero, x, y, x:Cross(y))
end

local FRONT = Vector3.new(0, 0, -1)

-- Bras R15 : épaule + coude pour poser la main en `target` (repère du HRP),
-- coude poussé vers `pole`
local function ik15(sh: Motor6D, el: Motor6D, wr: Motor6D?, parent: CFrame, target: Vector3, pole: Vector3)
	local J = parent * sh.C0
	local S = J.Position
	local ua = el.C0.Position - sh.C1.Position
	local la = (wr and (wr.C0.Position - el.C1.Position) or Vector3.new(0, -0.7, 0)) + Vector3.new(0, -0.14, 0)
	local d1, d2 = ua.Magnitude, la.Magnitude
	local toT = target - S
	local dist = math.clamp(toT.Magnitude, math.abs(d1 - d2) + 0.05, d1 + d2 - 0.02)
	local u = toT.Magnitude > 1e-4 and toT.Unit or Vector3.new(0, -1, 0)
	local p = pole - u * pole:Dot(u)
	if p.Magnitude < 1e-4 then
		p = basis(u, UP).UpVector
	end
	p = p.Unit
	local cosA = math.clamp((d1 * d1 + dist * dist - d2 * d2) / (2 * d1 * dist), -1, 1)
	local sinA = math.sqrt(math.max(0, 1 - cosA * cosA))
	local E = S + u * (d1 * cosA) + p * (d1 * sinA)
	local H = S + u * dist
	local b = (E - S).Unit
	local f2 = (H - E).Unit
	local front = f2 - b * f2:Dot(b)
	if front.Magnitude < 1e-3 then
		front = -p
	end
	local Rua = basis(b, front) * basis(ua.Unit, FRONT):Inverse()
	sh.Transform = J.Rotation:Inverse() * Rua * sh.C1.Rotation
	local UA = J * sh.Transform * sh.C1:Inverse()
	local J2 = UA * el.C0
	local back = -b
	local front2 = back - f2 * back:Dot(f2)
	if front2.Magnitude < 1e-3 then
		front2 = -p
	end
	local Rla = basis(f2, front2) * basis(la.Unit, FRONT):Inverse()
	el.Transform = J2.Rotation:Inverse() * Rla * el.C1.Rotation
	if wr then
		wr.Transform = I
	end
end

-- Bras R6 (une seule pièce) : le bras vise la cible
local function ik6(sh: Motor6D, parent: CFrame, target: Vector3)
	local J = parent * sh.C0
	local v = Vector3.new(0, -0.85, 0) - sh.C1.Position
	local toT = target - J.Position
	if toT.Magnitude < 1e-3 then
		return
	end
	local u = toT.Unit
	local front = Vector3.new(0, -u.Z, u.Y)
	if front.Magnitude < 1e-3 then
		front = FRONT
	end
	local R = basis(u, front) * basis(v.Unit, FRONT):Inverse()
	sh.Transform = J.Rotation:Inverse() * R * sh.C1.Rotation
end

type Pose = {
	Root: CFrame?, -- (repère du HRP : décalage / bascule du bassin)
	Waist: CFrame?,
	Neck: CFrame?,
	RHip: CFrame?,
	LHip: CFrame?,
	RKnee: CFrame?,
	LKnee: CFrame?,
	RAnkle: CFrame?,
	LAnkle: CFrame?,
	RHand: Vector3?, -- cibles des mains (MONDE)
	LHand: Vector3?,
	RPole: Vector3?, -- direction du coude (MONDE)
	LPole: Vector3?,
	RArm: CFrame?, -- sinon : rotation de l'épaule
	LArm: CFrame?,
}

local posed: { [Model]: boolean } = {}

local function applyPose(rig: Rig, pose: Pose)
	local m = rig.M
	local root = rig.Root
	m.Root.Transform = conj(m.Root, pose.Root or I)
	if m.Neck then
		m.Neck.Transform = conj(m.Neck, pose.Neck or I)
	end
	m.RHip.Transform = conj(m.RHip, pose.RHip or I)
	m.LHip.Transform = conj(m.LHip, pose.LHip or I)
	local rootCF = root.CFrame
	if rig.R6 then
		local torso = m.Root.C0 * m.Root.Transform * m.Root.C1:Inverse()
		for _, side in ipairs({ "R", "L" }) do
			local sh = m[side .. "Shoulder"]
			local target: Vector3? = if side == "R" then pose.RHand else pose.LHand
			if target then
				ik6(sh, torso, rootCF:PointToObjectSpace(target))
			else
				sh.Transform = conj(sh, (if side == "R" then pose.RArm else pose.LArm) or I)
			end
		end
	else
		for _, key in ipairs({ "RKnee", "LKnee", "RAnkle", "LAnkle" }) do
			local motor = m[key]
			if motor then
				motor.Transform = conj(motor, (pose :: any)[key] or I)
			end
		end
		m.Waist.Transform = conj(m.Waist, pose.Waist or I)
		local lt = m.Root.C0 * m.Root.Transform * m.Root.C1:Inverse()
		local ut = lt * m.Waist.C0 * m.Waist.Transform * m.Waist.C1:Inverse()
		for _, side in ipairs({ "R", "L" }) do
			local sh, el, wr = m[side .. "Shoulder"], m[side .. "Elbow"], m[side .. "Wrist"]
			local target: Vector3? = if side == "R" then pose.RHand else pose.LHand
			if target then
				local pole: Vector3 = (if side == "R" then pose.RPole else pose.LPole) or (rootCF.RightVector * (side == "R" and 1 or -1) - rootCF.UpVector * 0.4)
				ik15(sh, el, wr, ut, rootCF:PointToObjectSpace(target), rootCF:VectorToObjectSpace(pole))
			else
				sh.Transform = conj(sh, (if side == "R" then pose.RArm else pose.LArm) or I)
				el.Transform = I
				if wr then
					wr.Transform = I
				end
			end
		end
	end
	posed[rig.Character] = true
end

-- Fin de pose : joints remis à zéro (l'Animator reprend la main)
local function releasePose(character: Model)
	posed[character] = nil
	local rig = rigs[character]
	if not rig then
		return
	end
	for _, motor in pairs(rig.M) do
		if motor.Parent then
			motor.Transform = I
		end
	end
end

local function Rx(deg: number): CFrame
	return CFrame.Angles(rad(deg), 0, 0)
end

----------------------------------------------------------------------
-- Poses des jeux
----------------------------------------------------------------------

-- Assis, jambes pendantes (base), avec `hip` / `knee` en degrés
local function seatedLegs(pose: Pose, hip: number, knee: number, splay: number?, ankle: number?)
	local s = splay or 4
	pose.RHip = Rx(hip) * CFrame.Angles(0, 0, rad(-s))
	pose.LHip = Rx(hip) * CFrame.Angles(0, 0, rad(s))
	pose.RKnee = Rx(-knee)
	pose.LKnee = Rx(-knee)
	pose.RAnkle = Rx(ankle or 0)
	pose.LAnkle = Rx(ankle or 0)
end

local function swingPose(seatCF: CFrame, angle: number, phase: number, env: number): Pose
	local pose: Pose = {}
	-- on pompe : jambes tendues en allant vers l'avant, repliées au retour
	local c = math.cos(phase) * env
	seatedLegs(pose, 78 + 14 * c, 70 - 52 * c, 3, 10 * c)
	pose.Waist = Rx(4 + 12 * c)
	pose.Neck = Rx(-6 - 6 * c)
	-- mains sur les chaînes (gaine), un peu au-dessus des épaules
	pose.RHand = (seatCF * CFrame.new(0.9, 2.55, 0.05)).Position
	pose.LHand = (seatCF * CFrame.new(-0.9, 2.55, 0.05)).Position
	pose.RPole = (seatCF.RightVector * 0.6 + seatCF.LookVector * -0.5 - seatCF.UpVector * 0.4)
	pose.LPole = (seatCF.RightVector * -0.6 + seatCF.LookVector * -0.5 - seatCF.UpVector * 0.4)
	local _ = angle
	return pose
end

local function handleBarPose(seatCF: CFrame, grip: Vector3, hip: number, knee: number, lean: number): Pose
	local pose: Pose = {}
	seatedLegs(pose, hip, knee, 6, 0)
	pose.Waist = Rx(-lean)
	pose.Neck = Rx(lean * 0.4)
	pose.RHand = (seatCF * CFrame.new(grip.X, grip.Y, grip.Z)).Position
	pose.LHand = (seatCF * CFrame.new(-grip.X, grip.Y, grip.Z)).Position
	pose.RPole = seatCF.RightVector - seatCF.UpVector * 0.8
	pose.LPole = -seatCF.RightVector - seatCF.UpVector * 0.8
	return pose
end

----------------------------------------------------------------------
-- Construction du décor (un morceau par image)
----------------------------------------------------------------------

local function at(park: Park, x: number, y: number, z: number): Vector3
	return park.G * Vector3.new(x, y, z)
end

-- Clôture en bois peint (poteaux à boule, 2 lisses, lattes) + portillon ouvert
local function buildFence(park: Park)
	local f = Instance.new("Model")
	f.Name = "Fence"
	local g = park.G
	local hw, hd = ParkMotion.W / 2 + 0.6, ParkMotion.D / 2 + 0.6
	local gate = ParkMotion.GATE
	local runs = {
		{ Vector3.new(-hw, 0, hd), Vector3.new(hw, 0, hd) },
		{ Vector3.new(-hw, 0, -hd), Vector3.new(-hw, 0, hd) },
		{ Vector3.new(hw, 0, -hd), Vector3.new(hw, 0, hd) },
		{ Vector3.new(-hw, 0, -hd), Vector3.new(-gate - 0.3, 0, -hd) },
		{ Vector3.new(gate + 0.3, 0, -hd), Vector3.new(hw, 0, -hd) },
	}
	local posts: { [string]: boolean } = {}
	for ri, r in ipairs(runs) do
		local a, b = r[1], r[2]
		local len = (b - a).Magnitude
		local dir = (b - a).Unit
		local n = math.max(1, math.floor(len / 4.2 + 0.5))
		for k = 0, n do
			local p = a:Lerp(b, k / n)
			local key = string.format("%.1f_%.1f", p.X, p.Z)
			-- (pas de poteau là où se dresse un pilier du portillon)
			local atGate = math.abs(math.abs(p.X) - (gate + 0.3)) < 0.05 and math.abs(p.Z + hd) < 0.05
			if not posts[key] and not atGate then
				posts[key] = true
				newPart(f, "FencePost", Vector3.new(0.36, 2.9, 0.36), g * CFrame.new(p + Vector3.new(0, 1.45, 0)), WHITE, M.Wood, nil, true)
				ball(f, "PostCap", g * (p + Vector3.new(0, 3.0, 0)), 0.42, WHITE, M.SmoothPlastic)
			end
		end
		-- 2 lisses (derrière les lattes, côté intérieur)
		local inward = Vector3.new(-dir.Z, 0, dir.X)
		if (inward):Dot(-a) < 0 then
			inward = -inward
		end
		for _, y in ipairs({ 0.75, 2.05 }) do
			slab(f, "FenceRail", g * (a + inward * 0.16 + Vector3.new(0, y, 0)), g * (b + inward * 0.16 + Vector3.new(0, y, 0)), 0.14, 0.26, rgb(236, 236, 230), M.Wood)
		end
		-- lattes à bout arrondi, régulières entre les poteaux
		local count = math.floor(len / 1.3)
		for k = 1, count do
			local t = (k - 0.5) / count
			local p = a:Lerp(b, t)
			-- (pas de latte dans un poteau)
			local along = t * len
			local spacing = len / n
			local nearPost = math.abs(along - math.floor(along / spacing + 0.5) * spacing) < 0.45
			if not nearPost then
				local cf = g * CFrame.lookAt(p + Vector3.new(0, 1.3, 0), p + Vector3.new(0, 1.3, 0) + inward)
				newPart(f, "Picket", Vector3.new(0.42, 2.3, 0.1), cf, WHITE, M.Wood)
			end
		end
		local _ = ri
	end
	-- piliers du portillon + arche "Aire de jeux"
	for _, sx in ipairs({ -1, 1 }) do
		local p = Vector3.new(sx * (gate + 0.3), 0, -hd)
		newPart(f, "GatePillar", Vector3.new(0.6, 3.6, 0.6), g * CFrame.new(p + Vector3.new(0, 1.8, 0)), BLUE, M.Metal, nil, true)
		ball(f, "GateBall", g * (p + Vector3.new(0, 3.85, 0)), 0.7, YELLOW, M.SmoothPlastic)
		rod(f, "ArchPost", g * (p + Vector3.new(0, 3.6, 0)), g * (p + Vector3.new(0, 6.4, 0)), 0.22, BLUE, M.Metal)
	end
	local board = newPart(f, "GateSign", Vector3.new(gate * 2 + 1.2, 1.3, 0.2), g * CFrame.new(0, 6.1, -hd) * CFrame.Angles(0, math.pi, 0), YELLOW, M.SmoothPlastic, nil, true)
	-- (lisible des deux côtés : en arrivant de la place et depuis l'aire)
	label(board, "🛝 " .. Locale.T("Playground"), rgb(120, 60, 40), rgb(255, 232, 150), Enum.NormalId.Front)
	label(board, "🛝 " .. Locale.T("Playground"), rgb(120, 60, 40), rgb(255, 232, 150), Enum.NormalId.Back)
	-- battant ouvert vers l'extérieur (3 lattes + traverses)
	local hinge = g * CFrame.new(-gate - 0.3, 0, -hd) * CFrame.Angles(0, rad(-100), 0)
	for k = 0, 2 do
		newPart(f, "GateSlat", Vector3.new(0.42, 2.0, 0.1), hinge * CFrame.new(0.5 + k * 0.72, 1.25, 0), WHITE, M.Wood)
	end
	for _, y in ipairs({ 0.65, 1.85 }) do
		newPart(f, "GateBar", Vector3.new(2.1, 0.2, 0.12), hinge * CFrame.new(1.2, y, 0.11), rgb(236, 236, 230), M.Wood)
	end
	f.Parent = park.Folder
end

-- Sol : zones amortissantes en couleurs, marelle, bordure du bac, panneau
local function buildGround(park: Park)
	local f = Instance.new("Model")
	f.Name = "Ground"
	local g = park.G
	local T = ParkMotion.FLOOR_TOP
	-- (chaque dalle à sa hauteur : jamais deux dessus confondus)
	local function mat(name: string, cx: number, cz: number, w: number, d: number, color: Color3, lift: number)
		newPart(f, name, Vector3.new(w, 0.06, d), g * CFrame.new(cx, T + lift - 0.03, cz), color, M.Rubber)
	end
	local S = ParkMotion.SWING
	mat("SwingMat", S.Center.X, S.Center.Z, 11.2, 9.6, rgb(70, 124, 190), 0.035)
	local sd = ParkMotion.SEESAW
	mat("SeesawMat", sd.Center.X, sd.Center.Z, 10.4, 3.6, rgb(120, 180, 90), 0.035)
	local sl = ParkMotion.SLIDE
	mat("SlideMat", sl.Tower.X, sl.Tower.Z + 6.2, 5, 11.6, rgb(236, 170, 70), 0.035)
	local mg = ParkMotion.MERRY
	disc(f, "MerryMat", g * CFrame.new(mg.Center), T + 0.065, mg.Radius + 2.1, 0.06, rgb(96, 170, 140), M.Rubber)
	for i = 1, #ParkMotion.SPRINGS do
		disc(f, "SpringMat", g * ParkMotion.SpringBase(i), T + 0.035, 2.2, 0.06, rgb(186, 120, 200), M.Rubber)
	end
	local mk = ParkMotion.MONKEY
	mat("MonkeyMat", (mk.X0 + mk.X1) / 2, mk.Z, mk.X1 - mk.X0 + 4, 4.2, rgb(214, 96, 96), 0.035)
	-- marelle peinte dans l'allée du portillon (1-2-3, 4|5, 6, 7|8, CIEL)
	local cells = { { 0, -13.6 }, { 0, -12.3 }, { -0.62, -11.0 }, { 0.62, -11.0 }, { 0, -9.7 }, { -0.62, -8.4 }, { 0.62, -8.4 }, { 0, -7.1 } }
	for i, c in ipairs(cells) do
		local w = (c[1] ~= 0) and 1.12 or 1.2
		newPart(f, "Hopscotch", Vector3.new(w, 0.04, 1.2), g * CFrame.new(c[1], T + 0.035, c[2]), i % 2 == 0 and rgb(255, 255, 255) or rgb(255, 214, 90), M.SmoothPlastic)
	end
	disc(f, "HopSky", g * CFrame.new(0, 0, -5.9), T + 0.09, 0.8, 0.04, rgb(130, 200, 255), M.SmoothPlastic)
	f.Parent = park.Folder
end

-- 🎠 portique des balançoires (fixe) + 3 balançoires (mobiles)
local function buildSwings(park: Park)
	local g = park.G
	local S = ParkMotion.SWING
	local c = S.Center
	local f = Instance.new("Model")
	f.Name = "SwingFrame"
	local topY = S.PivotY + 0.3
	local half = 5.3
	rod(f, "SwingBeam", at(park, c.X - half - 0.2, topY, c.Z), at(park, c.X + half + 0.2, topY, c.Z), 0.52, GREEN, M.Metal, true)
	for _, sx in ipairs({ -1, 1 }) do
		local x = c.X + sx * half
		ball(f, "BeamCap", at(park, x + sx * 0.25, topY, c.Z), 0.56, GREEN_D, M.SmoothPlastic)
		newPart(f, "Clamp", Vector3.new(0.7, 0.9, 0.9), g * CFrame.new(x, topY - 0.1, c.Z), GREEN_D, M.Metal, nil, true)
		for _, sz in ipairs({ -1, 1 }) do
			local foot = Vector3.new(x + sx * 0.45, ParkMotion.FLOOR_TOP, c.Z + sz * 2.7)
			rod(f, "SwingLeg", at(park, x, topY - 0.2, c.Z + sz * 0.2), g * foot, 0.42, GREEN, M.Metal, true)
			disc(f, "LegFoot", g * CFrame.new(foot), ParkMotion.FLOOR_TOP + 0.08, 0.36, 0.1, STEEL_D, M.Metal)
		end
		-- entretoise (barre en A)
		rod(f, "SwingBrace", at(park, x + sx * 0.3, 2.6, c.Z - 1.85), at(park, x + sx * 0.3, 2.6, c.Z + 1.85), 0.26, GREEN_D, M.Metal)
	end
	f.Parent = park.Folder
	-- balançoires : chaînes à maillons + sangle
	for i, dx in ipairs(S.Xs) do
		local pivot = g * ParkMotion.SwingPivot(i)
		local m = Instance.new("Model")
		m.Name = "Swing" .. i
		for _, sx in ipairs({ -1, 1 }) do
			local x = sx * 0.93
			-- crochet (étrier sous la poutre)
			newPart(m, "Hanger", Vector3.new(0.18, 0.34, 0.3), pivot * CFrame.new(x, 0.12, 0), STEEL_D, M.Metal)
			local links = 11
			local top, bottom = -0.05, -(S.L - 0.28)
			local step = (top - bottom) / links
			for k = 0, links - 1 do
				local y = top - (k + 0.5) * step
				local turn = (k % 2 == 0) and I or CFrame.Angles(0, math.pi / 2, 0)
				egg(m, "ChainLink", pivot * CFrame.new(x, y, 0) * turn, Vector3.new(0.13, step + 0.14, 0.05), STEEL, M.Metal)
			end
			-- gaine plastique là où l'on tient la chaîne
			rod(m, "ChainGrip", (pivot * CFrame.new(x, -S.L + 2.0, 0)).Position, (pivot * CFrame.new(x, -S.L + 3.4, 0)).Position, 0.2, i == 2 and YELLOW or BLUE, M.SmoothPlastic)
			-- attache de la sangle
			newPart(m, "SeatClamp", Vector3.new(0.2, 0.3, 0.36), pivot * CFrame.new(x, -S.L + 0.18, 0), STEEL_D, M.Metal)
		end
		-- sangle en caoutchouc (creux au milieu, bords relevés)
		local seat = pivot * CFrame.new(0, -S.L, 0)
		newPart(m, "BeltSeat", Vector3.new(1.3, 0.14, 0.95), seat * CFrame.new(0, -0.07, 0), RUBBER_B, M.Rubber, nil, true)
		for _, sx in ipairs({ -1, 1 }) do
			newPart(m, "BeltEnd", Vector3.new(0.34, 0.14, 0.92), seat * CFrame.new(sx * 0.78, 0.0, 0) * CFrame.Angles(0, 0, sx * rad(24)), RUBBER_B, M.Rubber)
		end
		m.Parent = park.Folder
		local group = newGroup(pivot)
		adopt(group, m)
		local piece: Piece = { Kind = "Swing", Index = i, Groups = { group }, Server = nil, Seats = {}, Settled = false, Extra = nil }
		table.insert(park.Pieces, piece)
		local _ = dx
	end
end

-- 🛝 tour + toit + échelle + mur d'escalade + glissière
local function buildSlide(park: Park)
	local g = park.G
	local S = ParkMotion.SLIDE
	local tower = g * ParkMotion.SlideTower()
	local f = Instance.new("Model")
	f.Name = "SlideTower"
	local deckTop = S.DeckTop
	local h = S.Deck / 2 - 0.15
	for _, x in ipairs({ -h, h }) do
		for _, z in ipairs({ -h, h }) do
			rod(f, "TowerPost", (tower * CFrame.new(x, ParkMotion.FLOOR_TOP, z)).Position, (tower * CFrame.new(x, 8.7, z)).Position, 0.42, BLUE, M.Metal, true)
			disc(f, "PostFoot", tower * CFrame.new(x, 0, z), ParkMotion.FLOOR_TOP + 0.08, 0.34, 0.1, STEEL_D, M.Metal)
		end
	end
	-- plancher (tôle antidérapante) + palier du mur d'escalade
	newPart(f, "Deck", Vector3.new(S.Deck, 0.24, S.Deck), tower * CFrame.new(0, deckTop - 0.12, 0), rgb(72, 84, 92), M.DiamondPlate, nil, true)
	newPart(f, "Landing", Vector3.new(2.0, 0.22, S.Deck - 0.4), tower * CFrame.new(-S.Deck / 2 - 1.0, deckTop - 0.13, 0), rgb(72, 84, 92), M.DiamondPlate, nil, true)
	newPart(f, "DeckBeam", Vector3.new(S.Deck + 0.1, 0.4, 0.3), tower * CFrame.new(0, deckTop - 0.44, -S.Deck / 2 + 0.15), BLUE_D, M.Metal)
	newPart(f, "DeckBeam", Vector3.new(S.Deck + 0.1, 0.4, 0.3), tower * CFrame.new(0, deckTop - 0.44, S.Deck / 2 - 0.15), BLUE_D, M.Metal)
	-- garde-corps +X : panneau PEHD avec volant de bateau
	local panel = newPart(f, "SidePanel", Vector3.new(0.16, 2.3, S.Deck - 0.6), tower * CFrame.new(h + 0.02, deckTop + 1.25, 0), RED, M.SmoothPlastic, nil, true)
	local wheelCF = tower * CFrame.new(h - 0.2, deckTop + 1.45, 0) * CFrame.Angles(0, 0, 0)
	newPart(f, "WheelRim", Vector3.new(0.12, 1.3, 1.3), wheelCF, YELLOW, M.SmoothPlastic, CYL)
	newPart(f, "WheelInner", Vector3.new(0.1, 0.9, 0.9), wheelCF * CFrame.new(-0.035, 0, 0), RED, M.SmoothPlastic, CYL)
	for k = 0, 2 do
		newPart(f, "WheelSpoke", Vector3.new(0.06, 1.5, 0.12), wheelCF * CFrame.new(-0.14, 0, 0) * CFrame.Angles(rad(k * 60), 0, 0), YELLOW, M.SmoothPlastic)
	end
	ball(f, "WheelHub", (wheelCF * CFrame.new(-0.18, 0, 0)).Position, 0.34, BLUE, M.SmoothPlastic)
	local _ = panel
	-- mains courantes (côté échelle : 2 poignées ; côté glissière : barre d'appui)
	for _, sx in ipairs({ -1, 1 }) do
		rod(f, "LadderGrip", (tower * CFrame.new(sx * 0.8, deckTop, -h - 0.05)).Position, (tower * CFrame.new(sx * 0.8, deckTop + 1.6, -h - 0.05)).Position, 0.16, YELLOW, M.Metal)
		rod(f, "LadderGripTop", (tower * CFrame.new(sx * 0.8, deckTop + 1.6, -h - 0.05)).Position, (tower * CFrame.new(sx * h, deckTop + 1.6, -h + 0.05)).Position, 0.16, YELLOW, M.Metal)
	end
	rod(f, "SlideBar", (tower * CFrame.new(-h, deckTop + 2.2, h - 0.1)).Position, (tower * CFrame.new(h, deckTop + 2.2, h - 0.1)).Position, 0.16, YELLOW, M.Metal)
	-- capot du départ de la glissière
	for _, sx in ipairs({ -1, 1 }) do
		newPart(f, "Hood", Vector3.new(0.14, 1.5, 1.2), tower * CFrame.new(sx * 1.12, deckTop + 0.75, S.Deck / 2 + 0.45), YELLOW, M.SmoothPlastic, nil, true)
	end
	-- toit à deux pans + faîtière
	for _, sz in ipairs({ -1, 1 }) do
		newPart(f, "Roof", Vector3.new(S.Deck + 1.1, 0.16, 2.35), tower * CFrame.new(0, 9.05, sz * 1.02) * CFrame.Angles(sz * rad(26), 0, 0), RED, M.SmoothPlastic, nil, true)
	end
	rod(f, "RoofRidge", (tower * CFrame.new(-S.Deck / 2 - 0.55, 9.6, 0)).Position, (tower * CFrame.new(S.Deck / 2 + 0.55, 9.6, 0)).Position, 0.24, YELLOW, M.SmoothPlastic)
	-- échelle (-Z) inclinée : 2 montants + barreaux ronds
	local lean = math.tan(S.LadderLean)
	local function ladderZ(y: number): number
		return S.LadderZ - (deckTop - y) * lean
	end
	for _, sx in ipairs({ -0.78, 0.78 }) do
		rod(f, "LadderRail", (tower * CFrame.new(sx, ParkMotion.FLOOR_TOP, ladderZ(ParkMotion.FLOOR_TOP))).Position, (tower * CFrame.new(sx, deckTop + 0.05, ladderZ(deckTop))).Position, 0.24, BLUE, M.Metal, true)
	end
	for k = 1, 5 do
		local y = k * 0.85
		rod(f, "LadderRung", (tower * CFrame.new(-0.78, y, ladderZ(y))).Position, (tower * CFrame.new(0.78, y, ladderZ(y))).Position, 0.18, STEEL, M.Metal)
	end
	-- mur d'escalade (-X) : panneau + prises de couleur
	local wx = -S.Deck / 2 - 2.05
	newPart(f, "ClimbWall", Vector3.new(0.2, deckTop - 0.1, S.Deck - 0.4), tower * CFrame.new(wx, (deckTop + ParkMotion.FLOOR_TOP) / 2, 0), YELLOW, M.SmoothPlastic, nil, true)
	local holds = { RED, BLUE, GREEN, ORANGE, rgb(170, 90, 200) }
	for k = 1, 11 do
		local y = 0.7 + (k - 1) * 0.36
		local z = math.sin(k * 2.3) * 1.1
		egg(f, "ClimbHold", tower * CFrame.new(wx - 0.14, y, z) * CFrame.Angles(0, 0, rad(k * 37)), Vector3.new(0.22, 0.34, 0.3), holds[(k - 1) % #holds + 1], M.SmoothPlastic)
	end
	-- glissière : fond + 2 flancs + boudins, segment par segment (profil lissé)
	local samples = { 1.7, 2.3, 2.75, 3.3, 7.3, 8.05, 8.7, 9.4, S.Profile[#S.Profile][1] }
	local chute = rgb(250, 206, 60)
	for k = 1, #samples - 1 do
		local z0, z1 = samples[k], samples[k + 1]
		local y0 = ParkMotion.SlideSurface(z0)
		local y1 = ParkMotion.SlideSurface(z1)
		local a = (tower * CFrame.new(0, y0 - 0.09, z0 - 0.02)).Position
		local b = (tower * CFrame.new(0, y1 - 0.09, z1 + 0.02)).Position
		local bottom = slab(f, "ChuteBed", a, b, 1.9, 0.18, chute, M.SmoothPlastic, true)
		for _, sx in ipairs({ -1, 1 }) do
			local o = bottom.CFrame.RightVector * (sx * 1.03)
			local up = bottom.CFrame.UpVector
			slab(f, "ChuteWall", a + o + up * 0.3, b + o + up * 0.3, 0.16, 0.66, rgb(244, 186, 40), M.SmoothPlastic, true)
			rod(f, "ChuteRim", a + o + up * 0.66, b + o + up * 0.66, 0.24, chute, M.SmoothPlastic)
		end
	end
	local zEnd = S.Profile[#S.Profile][1]
	local yEnd = ParkMotion.SlideSurface(zEnd)
	rod(f, "ChuteLip", (tower * CFrame.new(-1.05, yEnd - 0.12, zEnd + 0.02)).Position, (tower * CFrame.new(1.05, yEnd - 0.12, zEnd + 0.02)).Position, 0.24, chute, M.SmoothPlastic)
	-- pieds de la glissière
	for _, z in ipairs({ 5.6, 9.4 }) do
		local y = ParkMotion.SlideSurface(z)
		for _, sx in ipairs({ -0.7, 0.7 }) do
			rod(f, "ChuteLeg", (tower * CFrame.new(sx, ParkMotion.FLOOR_TOP, z)).Position, (tower * CFrame.new(sx, y - 0.2, z)).Position, 0.22, BLUE, M.Metal)
		end
	end
	f.Parent = park.Folder
end

-- 🌀 tourniquet : socle fixe + plateau mobile (sièges, guidons, mât)
local function buildMerry(park: Park)
	local g = park.G
	local m = ParkMotion.MERRY
	local base = g * CFrame.new(m.Center)
	local fixed = Instance.new("Model")
	fixed.Name = "MerryBase"
	disc(fixed, "MerryBearing", base, m.DeckTop - 0.35, 0.9, m.DeckTop - 0.35 - ParkMotion.FLOOR_TOP + 0.02, STEEL_D, M.Metal)
	fixed.Parent = park.Folder
	local r = Instance.new("Model")
	r.Name = "MerryTop"
	disc(r, "MerryDeck", base, m.DeckTop, m.Radius, 0.3, RED, M.DiamondPlate, true)
	disc(r, "MerryRim", base, m.DeckTop - 0.1, m.Radius + 0.08, 0.14, YELLOW, M.Metal)
	for k = 0, 3 do
		-- secteurs antidérapants (plaques un peu au-dessus du plateau)
		local a = k * math.pi / 2 + math.pi / 4
		newPart(r, "DeckPad", Vector3.new(0.9, 0.05, 1.5), base * CFrame.Angles(0, a, 0) * CFrame.new(0, m.DeckTop + 0.02, 1.35), k % 2 == 0 and BLUE or YELLOW, M.Rubber)
	end
	rod(r, "MerryPole", (base * CFrame.new(0, m.DeckTop, 0)).Position, (base * CFrame.new(0, 3.9, 0)).Position, 0.42, STEEL, M.Metal, true)
	ball(r, "PoleCap", (base * CFrame.new(0, 3.95, 0)).Position, 0.62, YELLOW, M.SmoothPlastic)
	for k = 1, m.Seats do
		local a = (k - 0.5) / m.Seats * TAU
		local seatCF = base * CFrame.Angles(0, a, 0) * CFrame.new(0, m.SeatTop, m.SeatR)
		-- siège moulé (assise + dossier) sur son pied
		newPart(r, "SeatPan", Vector3.new(1.25, 0.2, 1.0), seatCF * CFrame.new(0, -0.1, 0.05), BLUE, M.SmoothPlastic, nil, true)
		newPart(r, "SeatBack", Vector3.new(1.25, 1.1, 0.16), seatCF * CFrame.new(0, 0.5, 0.58) * CFrame.Angles(rad(-10), 0, 0), BLUE, M.SmoothPlastic, nil, true)
		rod(r, "SeatPost", (seatCF * CFrame.new(0, -0.2, 0.05)).Position, (base * CFrame.Angles(0, a, 0) * CFrame.new(0, m.DeckTop, m.SeatR + 0.05)).Position, 0.3, STEEL_D, M.Metal)
		-- guidon en U devant le siège
		local barCF = base * CFrame.Angles(0, a, 0) * CFrame.new(0, m.SeatTop + 1.15, m.SeatR - 0.85)
		rod(r, "HandleBar", (barCF * CFrame.new(-0.62, 0, 0)).Position, (barCF * CFrame.new(0.62, 0, 0)).Position, 0.18, YELLOW, M.Metal)
		for _, sx in ipairs({ -0.62, 0.62 }) do
			rod(r, "HandlePost", (barCF * CFrame.new(sx, 0, 0)).Position, (base * CFrame.Angles(0, a, 0) * CFrame.new(sx, m.DeckTop, m.SeatR - 0.85)).Position, 0.18, YELLOW, M.Metal)
		end
		-- rayon vers le mât
		rod(r, "Spoke", (barCF * CFrame.new(0, 0, 0)).Position, (base * CFrame.new(0, m.SeatTop + 1.15, 0)).Position, 0.14, STEEL, M.Metal)
	end
	r.Parent = park.Folder
	local group = newGroup(base)
	adopt(group, r)
	table.insert(park.Pieces, { Kind = "Merry", Index = 1, Groups = { group }, Server = nil, Seats = {}, Settled = false, Extra = nil })
end

-- ⚖️ tape-cul : chevalet + pneus (fixes), planche + sièges + poignées (mobiles)
local function buildSeesaw(park: Park)
	local g = park.G
	local S = ParkMotion.SEESAW
	local c = S.Center
	local f = Instance.new("Model")
	f.Name = "SeesawBase"
	for _, sz in ipairs({ -1, 1 }) do
		rod(f, "SeesawStand", at(park, c.X - 0.5, ParkMotion.FLOOR_TOP, c.Z + sz * 0.62), at(park, c.X, S.PivotY, c.Z + sz * 0.62), 0.24, GREEN, M.Metal, true)
		rod(f, "SeesawStand", at(park, c.X + 0.5, ParkMotion.FLOOR_TOP, c.Z + sz * 0.62), at(park, c.X, S.PivotY, c.Z + sz * 0.62), 0.24, GREEN, M.Metal, true)
	end
	rod(f, "SeesawAxle", at(park, c.X, S.PivotY, c.Z - 0.78), at(park, c.X, S.PivotY, c.Z + 0.78), 0.28, STEEL, M.Metal)
	newPart(f, "SeesawPlate", Vector3.new(1.4, 0.1, 1.6), g * CFrame.new(c.X, ParkMotion.FLOOR_TOP + 0.04, c.Z), STEEL_D, M.Metal)
	for _, sx in ipairs({ -1, 1 }) do
		-- demi-pneu enterré sous chaque bout (amortisseur)
		newPart(f, "Tyre", Vector3.new(0.7, 1.1, 1.1), g * CFrame.new(c.X + sx * (S.Half - 0.4), ParkMotion.FLOOR_TOP + 0.02, c.Z) * CFrame.Angles(0, math.pi / 2, 0), RUBBER_B, M.Rubber, CYL)
	end
	f.Parent = park.Folder
	local rest = g * ParkMotion.SeesawPivot(0)
	local m = Instance.new("Model")
	m.Name = "SeesawPlank"
	newPart(m, "Plank", Vector3.new(S.Half * 2, 0.22, 0.8), rest * CFrame.new(0, 0.25, 0), WOOD, M.WoodPlanks, nil, true)
	newPart(m, "PlankHub", Vector3.new(1.0, 0.36, 0.95), rest * CFrame.new(0, 0.1, 0), GREEN_D, M.Metal)
	for k = 1, 2 do
		local sx = k == 1 and -1 or 1
		local seat = rest * CFrame.new(sx * S.SeatX, S.SeatUp, 0)
		newPart(m, "SeesawSeat", Vector3.new(1.2, 0.16, 0.95), seat * CFrame.new(0, -0.08, 0), RED, M.SmoothPlastic, nil, true)
		newPart(m, "SeesawBack", Vector3.new(0.16, 0.6, 0.95), seat * CFrame.new(sx * 0.6, 0.25, 0), RED, M.SmoothPlastic)
		-- poignée en T devant le siège (vers le pivot)
		local hx = sx * (S.SeatX - 0.85)
		rod(m, "HandlePost", (rest * CFrame.new(hx, 0.36, 0)).Position, (rest * CFrame.new(hx, S.SeatUp + 1.0, 0)).Position, 0.2, YELLOW, M.Metal)
		rod(m, "HandleGrip", (rest * CFrame.new(hx, S.SeatUp + 1.0, -0.55)).Position, (rest * CFrame.new(hx, S.SeatUp + 1.0, 0.55)).Position, 0.2, BLUE, M.Rubber)
	end
	m.Parent = park.Folder
	local group = newGroup(rest)
	adopt(group, m)
	table.insert(park.Pieces, { Kind = "Seesaw", Index = 1, Groups = { group }, Server = nil, Seats = {}, Settled = false, Extra = nil })
end

-- 🐴🦆 jeux à ressort : socle (fixe), ressort (tordu à chaque image), animal (mobile)
local function buildSprings(park: Park)
	local g = park.G
	for i, def in ipairs(ParkMotion.SPRINGS) do
		local base = g * ParkMotion.SpringBase(i)
		local f = Instance.new("Model")
		f.Name = "SpringBase" .. i
		disc(f, "SpringPad", base, ParkMotion.SPRING.PivotY, 0.75, 0.32, STEEL_D, M.Metal)
		for k = 0, 3 do
			local a = k * math.pi / 2 + math.pi / 4
			ball(f, "Bolt", (base * CFrame.new(math.cos(a) * 0.55, ParkMotion.SPRING.PivotY + 0.02, math.sin(a) * 0.55)).Position, 0.12, STEEL, M.Metal)
		end
		f.Parent = park.Folder
		-- ressort : 5 spires en 20 segments (repositionnés à chaque image)
		local coil = Instance.new("Model")
		coil.Name = "Coil" .. i
		local coilParts = {}
		for _ = 1, 20 do
			table.insert(coilParts, newPart(coil, "Coil", Vector3.new(0.5, 0.13, 0.13), base, rgb(236, 90, 70), M.Metal, CYL))
		end
		coil.Parent = park.Folder
		-- animal (repère du corps au repos)
		local rest = g * ParkMotion.SpringBody(i, 0, 0)
		local m = Instance.new("Model")
		m.Name = "Rider" .. i
		if def.Kind == "Horse" then
			local coat = rgb(236, 180, 120)
			local mane = rgb(140, 80, 48)
			egg(m, "Body", rest * CFrame.new(0, 1.0, 0.1), Vector3.new(1.15, 1.2, 2.5), coat, M.SmoothPlastic)
			egg(m, "Neck", rest * CFrame.new(0, 1.62, -0.95) * CFrame.Angles(rad(-35), 0, 0), Vector3.new(0.75, 1.3, 0.8), coat, M.SmoothPlastic)
			egg(m, "Head", rest * CFrame.new(0, 2.2, -1.45) * CFrame.Angles(rad(35), 0, 0), Vector3.new(0.7, 0.72, 1.2), coat, M.SmoothPlastic)
			egg(m, "Muzzle", rest * CFrame.new(0, 2.0, -1.9) * CFrame.Angles(rad(35), 0, 0), Vector3.new(0.58, 0.5, 0.52), rgb(250, 214, 176), M.SmoothPlastic)
			for _, sx in ipairs({ -1, 1 }) do
				egg(m, "Ear", rest * CFrame.new(sx * 0.2, 2.62, -1.3) * CFrame.Angles(rad(-10), 0, sx * rad(-12)), Vector3.new(0.16, 0.42, 0.2), coat, M.SmoothPlastic)
				ball(m, "Eye", (rest * CFrame.new(sx * 0.3, 2.34, -1.6)).Position, 0.2, INK, M.SmoothPlastic)
				ball(m, "EyeShine", (rest * CFrame.new(sx * 0.36, 2.39, -1.66)).Position, 0.07, WHITE, M.SmoothPlastic)
				ball(m, "Nostril", (rest * CFrame.new(sx * 0.13, 1.96, -2.12)).Position, 0.09, rgb(120, 70, 50), M.SmoothPlastic)
				-- repose-pieds
				rod(m, "FootPeg", (rest * CFrame.new(sx * 0.45, 0.62, -0.2)).Position, (rest * CFrame.new(sx * 0.95, 0.62, -0.2)).Position, 0.16, STEEL, M.Metal)
			end
			egg(m, "Mane", rest * CFrame.new(0, 2.0, -0.95) * CFrame.Angles(rad(-35), 0, 0), Vector3.new(0.22, 1.35, 0.7), mane, M.SmoothPlastic)
			egg(m, "Tail", rest * CFrame.new(0, 1.05, 1.35) * CFrame.Angles(rad(35), 0, 0), Vector3.new(0.24, 1.0, 0.3), mane, M.SmoothPlastic)
			egg(m, "Saddle", rest * CFrame.new(0, ParkMotion.SPRING.SeatUp - 0.1, 0.15), Vector3.new(1.05, 0.3, 1.1), RED, M.Leather)
			-- poignées sur l'encolure
			rod(m, "Handle", (rest * CFrame.new(-0.5, 1.9, -0.95)).Position, (rest * CFrame.new(0.5, 1.9, -0.95)).Position, 0.15, YELLOW, M.Metal)
		else
			local fur = rgb(255, 216, 60)
			egg(m, "Body", rest * CFrame.new(0, 1.0, 0.15), Vector3.new(1.3, 1.15, 2.3), fur, M.SmoothPlastic)
			ball(m, "Head", (rest * CFrame.new(0, 2.25, -1.05)).Position, 1.05, fur, M.SmoothPlastic)
			egg(m, "Beak", rest * CFrame.new(0, 2.1, -1.68), Vector3.new(0.5, 0.2, 0.62), ORANGE, M.SmoothPlastic)
			egg(m, "Tail", rest * CFrame.new(0, 1.55, 1.3) * CFrame.Angles(rad(40), 0, 0), Vector3.new(0.5, 0.7, 0.3), fur, M.SmoothPlastic)
			for _, sx in ipairs({ -1, 1 }) do
				egg(m, "Wing", rest * CFrame.new(sx * 0.62, 1.1, 0.25) * CFrame.Angles(0, 0, sx * rad(-12)), Vector3.new(0.22, 0.7, 1.3), rgb(250, 196, 40), M.SmoothPlastic)
				ball(m, "Eye", (rest * CFrame.new(sx * 0.3, 2.42, -1.47)).Position, 0.2, INK, M.SmoothPlastic)
				ball(m, "EyeShine", (rest * CFrame.new(sx * 0.35, 2.47, -1.54)).Position, 0.07, WHITE, M.SmoothPlastic)
				rod(m, "FootPeg", (rest * CFrame.new(sx * 0.5, 0.62, -0.2)).Position, (rest * CFrame.new(sx * 1.0, 0.62, -0.2)).Position, 0.16, STEEL, M.Metal)
			end
			egg(m, "Saddle", rest * CFrame.new(0, ParkMotion.SPRING.SeatUp - 0.1, 0.15), Vector3.new(1.1, 0.3, 1.1), BLUE, M.Leather)
			rod(m, "Handle", (rest * CFrame.new(-0.5, 1.95, -0.62)).Position, (rest * CFrame.new(0.5, 1.95, -0.62)).Position, 0.15, RED, M.Metal)
		end
		m.Parent = park.Folder
		local group = newGroup(rest)
		adopt(group, m)
		table.insert(park.Pieces, { Kind = "Spring", Index = i, Groups = { group }, Server = nil, Seats = {}, Settled = false, Extra = { Coil = coilParts, Base = base } })
	end
end

-- 🐒 barres de singe : 2 échelles aux bouts, 2 longerons, barreaux
local function buildMonkey(park: Park)
	local g = park.G
	local Mk = ParkMotion.MONKEY
	local f = Instance.new("Model")
	f.Name = "MonkeyBars"
	local hw = Mk.Width / 2
	for _, x in ipairs({ Mk.X0, Mk.X1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			rod(f, "MonkeyPost", at(park, x, ParkMotion.FLOOR_TOP, Mk.Z + sz * hw), at(park, x, Mk.BarY + 0.1, Mk.Z + sz * hw), 0.34, ORANGE, M.Metal, true)
			ball(f, "PostCap", at(park, x, Mk.BarY + 0.2, Mk.Z + sz * hw), 0.4, YELLOW, M.SmoothPlastic)
			disc(f, "PostFoot", g * CFrame.new(x, 0, Mk.Z + sz * hw), ParkMotion.FLOOR_TOP + 0.08, 0.3, 0.1, STEEL_D, M.Metal)
		end
		for k = 1, 5 do
			local y = k * 0.95
			rod(f, "EndRung", at(park, x, y, Mk.Z - hw), at(park, x, y, Mk.Z + hw), 0.18, STEEL, M.Metal)
		end
	end
	for _, sz in ipairs({ -1, 1 }) do
		rod(f, "MonkeyRail", at(park, Mk.X0, Mk.BarY, Mk.Z + sz * hw), at(park, Mk.X1, Mk.BarY, Mk.Z + sz * hw), 0.3, ORANGE, M.Metal, true)
	end
	for k = 1, Mk.Rungs do
		local x = Mk.X0 + (Mk.X1 - Mk.X0) * k / (Mk.Rungs + 1)
		rod(f, "MonkeyRung", at(park, x, Mk.BarY + 0.02, Mk.Z - hw), at(park, x, Mk.BarY + 0.02, Mk.Z + hw), 0.2, STEEL, M.Metal)
	end
	f.Parent = park.Folder
end

-- 🏖️ bac à sable : cadre en rondins, sable, jouets
local function buildSandbox(park: Park)
	local g = park.G
	local S = ParkMotion.SAND
	local box = g * CFrame.new(S.Center)
	local f = Instance.new("Model")
	f.Name = "Sandbox"
	local half = S.Inner / 2
	newPart(f, "Sand", Vector3.new(S.Inner, 0.4, S.Inner), box * CFrame.new(0, 0.35, 0), SAND, M.Sand)
	for k = 1, 3 do
		egg(f, "SandBump", box * CFrame.new(math.cos(k * 2.1) * 1.8, 0.52, math.sin(k * 2.1) * 1.6), Vector3.new(1.6, 0.26, 1.2), SAND:Lerp(SAND_D, 0.3), M.Sand)
	end
	for _, s in ipairs({ -1, 1 }) do
		newPart(f, "Border", Vector3.new(S.Inner + 1.0, 0.8, 0.5), box * CFrame.new(0, 0.44, s * (half + 0.25)), WOOD, M.Wood, nil, true)
		newPart(f, "Border", Vector3.new(0.5, 0.78, S.Inner), box * CFrame.new(s * (half + 0.25), 0.43, 0), WOOD, M.Wood, nil, true)
		newPart(f, "BorderCap", Vector3.new(S.Inner + 1.1, 0.12, 0.62), box * CFrame.new(0, 0.9, s * (half + 0.25)), WOOD_L, M.WoodPlanks)
		newPart(f, "BorderCap", Vector3.new(0.62, 0.1, S.Inner - 0.04), box * CFrame.new(s * (half + 0.25), 0.88, 0), WOOD_L, M.WoodPlanks)
	end
	-- jouets : seau + anse, pelle, château, ballon
	local sandTop = 0.55
	local bucket = box * CFrame.new(1.6, sandTop, 1.2)
	newPart(f, "Bucket", Vector3.new(0.8, 0.85, 0.85), bucket * CFrame.new(0, 0.4, 0) * CFrame.Angles(0, 0, math.pi / 2), rgb(236, 72, 90), M.SmoothPlastic, CYL)
	newPart(f, "BucketRim", Vector3.new(0.1, 0.95, 0.95), bucket * CFrame.new(0, 0.84, 0) * CFrame.Angles(0, 0, math.pi / 2), rgb(250, 110, 120), M.SmoothPlastic, CYL)
	rod(f, "BucketHandle", (bucket * CFrame.new(-0.44, 0.95, 0)).Position, (bucket * CFrame.new(0, 1.2, 0)).Position, 0.06, INK, M.SmoothPlastic)
	rod(f, "BucketHandle", (bucket * CFrame.new(0, 1.2, 0)).Position, (bucket * CFrame.new(0.44, 0.95, 0)).Position, 0.06, INK, M.SmoothPlastic)
	rod(f, "Spade", (box * CFrame.new(-1.3, sandTop + 0.08, 1.7)).Position, (box * CFrame.new(-0.3, sandTop + 0.8, 1.2)).Position, 0.12, BLUE, M.SmoothPlastic)
	newPart(f, "SpadeBlade", Vector3.new(0.5, 0.06, 0.6), box * CFrame.new(-1.55, sandTop + 0.05, 1.82) * CFrame.Angles(0, rad(25), 0), BLUE, M.SmoothPlastic)
	local castle = box * CFrame.new(-1.2, sandTop, -1.3)
	newPart(f, "Castle", Vector3.new(1.3, 1.5, 1.5), castle * CFrame.new(0, 0.6, 0) * CFrame.Angles(0, 0, math.pi / 2), SAND:Lerp(SAND_D, 0.2), M.Sand, CYL)
	for k = 0, 3 do
		local a = k * math.pi / 2
		newPart(f, "Turret", Vector3.new(0.9, 0.5, 0.5), castle * CFrame.new(math.cos(a) * 0.95, 0.45, math.sin(a) * 0.95) * CFrame.Angles(0, 0, math.pi / 2), SAND:Lerp(SAND_D, 0.35), M.Sand, CYL)
	end
	ball(f, "Ball", (g * CFrame.new(7.6, ParkMotion.FLOOR_TOP + 0.62, 3.2)).Position, 1.2, rgb(255, 110, 140), M.SmoothPlastic)
	f.Parent = park.Folder
end

-- 🪑 bancs des parents (fonte + lattes, assise à 1,45)
local function buildBenches(park: Park)
	local g = park.G
	local B = ParkMotion.BENCH
	for b = 1, #ParkMotion.BENCHES do
		local cf = g * ParkMotion.BenchFrame(b)
		local f = Instance.new("Model")
		f.Name = "ParkBench" .. b
		local H = B.SeatTop
		local L = B.Length
		for k = 0, 2 do
			local z = -0.55 + k * 0.5
			newPart(f, "SeatSlat", Vector3.new(L, 0.14, 0.42), cf * CFrame.new(0, H - 0.07, z), WOOD, M.Wood, nil, true)
		end
		local back = cf * CFrame.new(0, H + 0.05, 0.62) * CFrame.Angles(rad(12), 0, 0)
		for _, y in ipairs({ 0.55, 1.15 }) do
			newPart(f, "BackSlat", Vector3.new(L, 0.42, 0.12), back * CFrame.new(0, y, 0), WOOD, M.Wood, nil, true)
		end
		for _, sx in ipairs({ -1, 1 }) do
			local x = sx * (L / 2 - 0.35)
			newPart(f, "FrontLeg", Vector3.new(0.18, H + 0.62, 0.18), cf * CFrame.new(x, (H + 0.62) / 2, -0.62), IRON, M.Metal)
			newPart(f, "RearLeg", Vector3.new(0.18, H, 0.18), cf * CFrame.new(x, H / 2, 0.55), IRON, M.Metal)
			newPart(f, "BackPost", Vector3.new(0.16, 1.55, 0.14), back * CFrame.new(x, 0.75, -0.13), IRON, M.Metal)
			newPart(f, "SeatRail", Vector3.new(0.16, 0.16, 1.4), cf * CFrame.new(x, H - 0.22, -0.02), IRON, M.Metal)
			newPart(f, "ArmRest", Vector3.new(0.24, 0.12, 1.3), cf * CFrame.new(sx * (L / 2 - 0.3), H + 0.68, -0.08), IRON, M.Metal)
		end
		f.Parent = park.Folder
	end
end

----------------------------------------------------------------------
-- Sièges du serveur, invites (traduites), activités
----------------------------------------------------------------------

local LOCAL_KINDS = { Slide = true, SlideTop = true, MonkeyA = true, MonkeyB = true, Dig = true }

local startActivity: (park: Park, action: string) -> ()

local function hookServer(park: Park)
	local server = park.Server
	if not server or not server.Parent then
		return
	end
	-- sièges par jeu
	for _, piece in ipairs(park.Pieces) do
		if not piece.Server or not piece.Server.Parent then
			local name = piece.Kind == "Merry" and "Merry" or (piece.Kind == "Seesaw" and "Seesaw" or piece.Kind .. piece.Index)
			local model = server:FindFirstChild(name)
			if model then
				piece.Server = model
				piece.Settled = false
				table.clear(piece.Seats)
				for _, d in ipairs(model:GetChildren()) do
					local slot = d:GetAttribute("ParkSlot")
					if d:IsA("Seat") and type(slot) == "number" then
						piece.Seats[slot] = d
					end
				end
			end
		end
	end
	-- invites : textes traduits ; celles des activités -> ici
	for _, d in ipairs(server:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d.Name == "ParkPrompt" and not table.find(park.Prompts, d) then
			table.insert(park.Prompts, d)
			local action = d:GetAttribute("LocAction")
			local object = d:GetAttribute("LocObject")
			if type(action) == "string" then
				d.ActionText = Locale.T(action)
			end
			if type(object) == "string" then
				d.ObjectText = Locale.T(object)
			end
			local kind = d:GetAttribute("ParkAction")
			if type(kind) == "string" and LOCAL_KINDS[kind] then
				table.insert(park.Conns, d.Triggered:Connect(function(player: Player)
					if player == Players.LocalPlayer then
						startActivity(park, kind)
					end
				end))
			end
		end
	end
end

----------------------------------------------------------------------
-- Mouvement des jeux (heure du serveur)
----------------------------------------------------------------------

local function serverNow(): number
	return workspace:GetServerTimeNow()
end

local seatFrames: { CFrame } = {}
local seatList: { BasePart } = {}

-- Pose courante d'un jeu -> pièces mobiles + sièges du serveur (localement)
local function stepPiece(park: Park, piece: Piece, t: number)
	local s = ParkMotion.StateOf(piece.Server)
	local g = park.G
	local kind = piece.Kind
	if kind == "Merry" then
		local angle, w = ParkMotion.Merry(s, t)
		if not s.On and math.abs(w) < 1e-3 and piece.Settled then
			return
		end
		piece.Settled = not s.On and math.abs(w) < 1e-3
		moveGroup(piece.Groups[1], g * ParkMotion.MerryFrame(angle))
		table.clear(seatFrames)
		table.clear(seatList)
		for k, seat in pairs(piece.Seats) do
			table.insert(seatList, seat)
			table.insert(seatFrames, g * ParkMotion.MerrySeat(k, angle) * CFrame.new(0, -seat.Size.Y / 2, 0))
		end
	else
		local env = ParkMotion.EnvOf(kind, s, t)
		if not s.On and env < 1e-3 and piece.Settled then
			return
		end
		piece.Settled = not s.On and env < 1e-3
		if piece.Settled then
			env = 0
		end
		table.clear(seatFrames)
		table.clear(seatList)
		if kind == "Swing" then
			local angle = ParkMotion.SwingAngle(env, t, piece.Index)
			moveGroup(piece.Groups[1], g * ParkMotion.SwingPivot(piece.Index) * CFrame.Angles(angle, 0, 0))
			local seat = piece.Seats[1]
			if seat then
				table.insert(seatList, seat)
				table.insert(seatFrames, g * ParkMotion.SwingSeat(piece.Index, angle) * CFrame.new(0, -seat.Size.Y / 2, 0))
			end
		elseif kind == "Seesaw" then
			local angle = ParkMotion.SeesawAngle(env, t)
			moveGroup(piece.Groups[1], g * ParkMotion.SeesawPivot(angle))
			for k, seat in pairs(piece.Seats) do
				table.insert(seatList, seat)
				table.insert(seatFrames, g * ParkMotion.SeesawSeat(k, angle) * CFrame.new(0, -seat.Size.Y / 2, 0))
			end
		elseif kind == "Spring" then
			local body = g * ParkMotion.SpringBody(piece.Index, env, t)
			moveGroup(piece.Groups[1], body)
			-- ressort : chaque spire entre le socle et le corps (hélice qui se tord)
			local extra = piece.Extra
			local coil = extra.Coil
			local base: CFrame = extra.Base * CFrame.new(0, ParkMotion.SPRING.PivotY, 0)
			local top: CFrame = body * CFrame.new(0, 0.62, 0)
			local frames = {}
			local n = #coil
			for k = 1, n do
				local u = (k - 1) / n
				local ring = base:Lerp(top, u)
				local a = (k - 1) * TAU / 4
				local p0 = ring * Vector3.new(math.cos(a) * 0.3, 0, math.sin(a) * 0.3)
				local a1 = a + TAU / 4
				local ring1 = base:Lerp(top, u + 1 / n)
				local p1 = ring1 * Vector3.new(math.cos(a1) * 0.3, 0, math.sin(a1) * 0.3)
				frames[k] = rodCF(p0, p1)
			end
			workspace:BulkMoveTo(coil, frames, Enum.BulkMoveMode.FireCFrameChanged)
			local seat = piece.Seats[1]
			if seat then
				table.insert(seatList, seat)
				table.insert(seatFrames, g * ParkMotion.SpringSeat(piece.Index, env, t) * CFrame.new(0, -seat.Size.Y / 2, 0))
			end
		end
	end
	if #seatList > 0 then
		workspace:BulkMoveTo(seatList, seatFrames, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

-- Pose de l'enfant assis sur la place `slot` du jeu `piece`
local function riderPose(park: Park, piece: Piece, slot: number, seat: BasePart, t: number): Pose?
	local s = ParkMotion.StateOf(piece.Server)
	local top = seat.CFrame * CFrame.new(0, seat.Size.Y / 2, 0)
	local kind = piece.Kind
	if kind == "Swing" then
		local env = ParkMotion.EnvOf(kind, s, t)
		local angle, phase = ParkMotion.SwingAngle(env, t, piece.Index)
		return swingPose(top, angle, phase, env)
	elseif kind == "Seesaw" then
		local env = ParkMotion.EnvOf(kind, s, t)
		local angle = ParkMotion.SeesawAngle(env, t)
		-- (bout bas : genoux pliés, pieds au sol ; bout haut : jambes pendantes)
		local low = (slot == 1 and angle > 0 or slot == 2 and angle < 0) and math.abs(angle) / ParkMotion.SEESAW.Tilt or 0
		return handleBarPose(top, Vector3.new(0.42, 1.02, -0.85), 70 + 25 * low, 45 + 55 * low, 4 + 6 * low)
	elseif kind == "Merry" then
		local _, w = ParkMotion.Merry(s, t)
		local p = handleBarPose(top, Vector3.new(0.5, 1.15, -0.85), 84, 92, 6)
		-- (ça tourne : on se penche un peu vers l'extérieur, la tête suit)
		p.Root = CFrame.Angles(0, 0, rad(-6 * math.clamp(w / ParkMotion.MERRY.Wmax, -1, 1)))
		return p
	elseif kind == "Spring" then
		local horse = (ParkMotion.SPRINGS[piece.Index] or ParkMotion.SPRINGS[1]).Kind == "Horse"
		local p = handleBarPose(top, horse and Vector3.new(0.5, 0.45, -1.1) or Vector3.new(0.5, 0.5, -0.77), 62, 72, 8)
		p.RHip = Rx(62) * CFrame.Angles(0, 0, rad(-22))
		p.LHip = Rx(62) * CFrame.Angles(0, 0, rad(22))
		return p
	end
	local _ = park
	return nil
end

----------------------------------------------------------------------
-- 🏃 Activités du joueur local (toboggan, barres de singe, bac à sable)
----------------------------------------------------------------------

type Activity = {
	Kind: string,
	Park: Park,
	Phase: string,
	T: number, -- (s) dans la phase
	Total: number,
	Z: number, -- toboggan : abscisse sur la glissière
	V: number, -- toboggan : vitesse
	From: CFrame?,
	Dir: number, -- barres : sens (+1 / -1)
	Scoops: number,
	Props: { BasePart },
}

local activity: Activity? = nil
local castles = 0

local function localRig(): (Rig?, Humanoid?)
	local character = Players.LocalPlayer and Players.LocalPlayer.Character
	if not character then
		return nil, nil
	end
	local rig = rigOf(character)
	return rig, rig and rig.Humanoid or nil
end

local function setPrompts(park: Park, on: boolean)
	for _, p in ipairs(park.Prompts) do
		if p.Parent then
			p.Enabled = on
		end
	end
end

local function endActivity()
	local a = activity
	activity = nil
	if not a then
		return
	end
	local rig, humanoid = localRig()
	if rig and humanoid then
		pcall(function()
			if a.Kind ~= "Dig" then
				humanoid.PlatformStand = false
				rig.Root.AssemblyLinearVelocity = Vector3.zero
				humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			end
		end)
		releasePose(rig.Character)
	end
	for _, p in ipairs(a.Props) do
		if p:GetAttribute("Keep") ~= true then
			p:Destroy()
		end
	end
	setPrompts(a.Park, true)
end

startActivity = function(park: Park, action: string)
	if activity or failed then
		return
	end
	local rig, humanoid = localRig()
	if not rig or not humanoid or humanoid.Health <= 0 or humanoid.SeatPart ~= nil then
		return
	end
	local kind = (action == "Slide" or action == "SlideTop") and "Slide" or ((action == "MonkeyA" or action == "MonkeyB") and "Monkey" or "Dig")
	local a: Activity = {
		Kind = kind,
		Park = park,
		Phase = if action == "SlideTop" then "walk" elseif kind == "Slide" then "approach" elseif kind == "Monkey" then "approach" else "kneel",
		T = 0,
		Total = 0,
		Z = 0,
		V = 0,
		From = rig.Root.CFrame,
		Dir = action == "MonkeyB" and -1 or 1,
		Scoops = 0,
		Props = {},
	}
	if kind ~= "Dig" then
		humanoid.PlatformStand = true
	else
		-- à genoux face au milieu du bac
		local center = park.G * ParkMotion.SAND.Center
		local pos = rig.Root.Position
		local flat = Vector3.new(center.X - pos.X, 0, center.Z - pos.Z)
		if flat.Magnitude > 0.5 then
			rig.Root.CFrame = CFrame.lookAt(pos, pos + flat.Unit)
		end
	end
	setPrompts(park, false)
	activity = a
end

-- Repères utiles (monde)
local function towerCF(park: Park): CFrame
	return park.G * ParkMotion.SlideTower()
end

local HRP_SIT = 1.5 -- (studs) centre du HRP au-dessus de ce sur quoi on est assis
local HRP_STAND = 3.0 -- … et au-dessus du sol, debout

local function smooth(x: number): number
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end

-- Position du HRP pendant l'activité (+ vitesse), et fin éventuelle
local function activityFrame(a: Activity, dt: number): (CFrame?, Vector3)
	local park = a.Park
	local g = park.G
	a.T += dt
	a.Total += dt
	if a.Kind == "Slide" then
		local S = ParkMotion.SLIDE
		local tower = towerCF(park)
		local lean = math.tan(S.LadderLean)
		local footZ = S.LadderZ - (S.DeckTop - 0.2) * lean
		local floorY = ParkMotion.FLOOR_TOP
		local bottom = tower * CFrame.new(0, floorY + HRP_STAND, footZ - 1.05)
		local face = CFrame.Angles(0, math.pi, 0) -- (tourné vers +Z : vers l'échelle / la glissière)
		if a.Phase == "approach" then
			local from = a.From or bottom
			local dur = 0.3 + math.min(0.6, (from.Position - bottom.Position).Magnitude / 12)
			local u = smooth(a.T / dur)
			local cf = from:Lerp(bottom * face, u)
			if a.T >= dur then
				a.Phase, a.T = "climb", 0
			end
			return cf, Vector3.zero
		elseif a.Phase == "climb" then
			-- barreau par barreau (0,85 stud) : petites montées avec pause
			local rungs = 6
			local per = 0.42
			local k = math.min(a.T / per, rungs)
			local whole = math.floor(k)
			local frac = k - whole
			local rise = (whole + smooth(frac * 1.4)) * 0.85
			local y = floorY + HRP_STAND + math.min(rise, S.DeckTop + 0.1 - floorY)
			local z = S.LadderZ - (S.DeckTop - (y - 1.0)) * lean - 1.0
			local cf = tower * CFrame.new(0, y, math.min(z, S.LadderZ - 0.9)) * face
			if k >= rungs then
				a.Phase, a.T = "over", 0
			end
			return cf, Vector3.new(0, 0.85 / per, 0)
		elseif a.Phase == "over" or a.Phase == "walk" then
			-- on passe sur le plancher et on va au départ de la glissière
			local topCF = tower * CFrame.new(0, S.DeckTop + HRP_STAND, -0.4) * face
			local startCF = tower * CFrame.new(0, S.DeckTop + HRP_STAND, 1.2) * face
			if a.Phase == "over" then
				local from = tower * CFrame.new(0, floorY + HRP_STAND + S.DeckTop + 0.1 - floorY, S.LadderZ - 0.9) * face
				local u = smooth(a.T / 0.5)
				if a.T >= 0.5 then
					a.Phase, a.T = "walk", 0
					a.From = topCF
				end
				local cf = from:Lerp(topCF, u)
				return cf + Vector3.new(0, math.sin(u * math.pi) * 0.25, 0), Vector3.zero
			end
			local from = a.From or topCF
			local u = smooth(a.T / 0.6)
			if a.T >= 0.6 then
				a.Phase, a.T = "sitdown", 0
			end
			return from:Lerp(startCF, u), Vector3.zero
		elseif a.Phase == "sitdown" then
			local startCF = tower * CFrame.new(0, S.DeckTop + HRP_STAND, 1.2) * face
			local y0 = ParkMotion.SlideSurface(1.9)
			local seatCF = tower * CFrame.new(0, y0 + HRP_SIT, 1.9) * face
			local u = smooth(a.T / 0.4)
			if a.T >= 0.4 then
				a.Phase, a.T, a.Z, a.V = "slide", 0, 1.9, 1.2
			end
			return startCF:Lerp(seatCF, u), Vector3.zero
		elseif a.Phase == "slide" then
			-- glissade : gravité le long de la pente, frottement, traînée
			local G = ParkMotion.G
			local y, dy = ParkMotion.SlideSurface(a.Z)
			local n = math.sqrt(1 + dy * dy)
			local sinA, cosA = -dy / n, 1 / n
			local acc = G * (sinA - 0.26 * cosA) - 0.03 * a.V * a.V
			a.V = math.max(0.8, a.V + acc * dt)
			a.Z += a.V * cosA * dt
			y, dy = ParkMotion.SlideSurface(a.Z)
			local pitch = -math.atan(dy) * 0.55
			local cf = tower * CFrame.new(0, y + HRP_SIT, a.Z) * face * CFrame.Angles(pitch, 0, 0)
			local vel = tower:VectorToWorldSpace(Vector3.new(0, a.V * dy / n, a.V / n))
			if a.Z >= ParkMotion.SLIDE_END - 0.05 then
				a.Phase, a.T = "out", 0
				a.From = cf
			end
			return cf, vel
		elseif a.Phase == "out" then
			-- sortie : on glisse encore un peu et on se relève
			local zEnd = ParkMotion.SLIDE_END
			local dz = math.min(a.V, 4) * 0.45
			local from = a.From or (tower * CFrame.new(0, 1 + HRP_SIT, zEnd) * face)
			local to = tower * CFrame.new(0, floorY + HRP_STAND, zEnd + 0.9 + dz) * face
			local u = smooth(a.T / 0.55)
			if a.T >= 0.55 then
				return nil, Vector3.zero
			end
			return from:Lerp(to, u), Vector3.zero
		end
	elseif a.Kind == "Monkey" then
		local Mk = ParkMotion.MONKEY
		local x0 = a.Dir > 0 and Mk.X0 or Mk.X1
		local x1 = a.Dir > 0 and Mk.X1 or Mk.X0
		local look = CFrame.Angles(0, a.Dir > 0 and -math.pi / 2 or math.pi / 2, 0) -- (regard vers le bout d'arrivée)
		local hang = Mk.BarY - 2.35
		local first = x0 + (x1 - x0) / (Mk.Rungs + 1)
		if a.Phase == "approach" then
			local stand = g * CFrame.new(x0 - a.Dir * 0.9, ParkMotion.FLOOR_TOP + HRP_STAND, Mk.Z) * look
			local u = smooth(a.T / 0.4)
			if a.T >= 0.4 then
				a.Phase, a.T = "up", 0
			end
			return (a.From or stand):Lerp(stand, u), Vector3.zero
		elseif a.Phase == "up" then
			-- 3 barreaux de l'échelle du bout, puis on attrape la 1re barre
			local stand = g * CFrame.new(x0 - a.Dir * 0.9, ParkMotion.FLOOR_TOP + HRP_STAND, Mk.Z) * look
			local grab = g * CFrame.new(first, hang, Mk.Z) * look
			local u = smooth(a.T / 1.1)
			if a.T >= 1.1 then
				a.Phase, a.T = "cross", 0
			end
			return stand:Lerp(grab, u) + Vector3.new(0, math.sin(u * math.pi) * 0.5, 0), Vector3.zero
		elseif a.Phase == "cross" then
			local per = 0.62
			local spacing = (x1 - x0) / (Mk.Rungs + 1)
			local k = a.T / per
			local n = Mk.Rungs - 1
			if k >= n then
				a.Phase, a.T = "drop", 0
				k = n
			end
			local whole = math.floor(k)
			local frac = k - whole
			local x = first + (whole + smooth(frac)) * spacing
			-- le corps balance d'avant en arrière à chaque prise
			local swing = math.sin(k * math.pi) * rad(10)
			local cf = g * CFrame.new(x, hang - 0.12 * math.sin(frac * math.pi), Mk.Z) * look * CFrame.Angles(swing, 0, 0)
			return cf, Vector3.new(0, 0, 0)
		elseif a.Phase == "drop" then
			local last = x0 + (x1 - x0) * Mk.Rungs / (Mk.Rungs + 1)
			local from = g * CFrame.new(last, hang, Mk.Z) * look
			local land = g * CFrame.new(x1 + a.Dir * 0.9, ParkMotion.FLOOR_TOP + HRP_STAND - 0.35, Mk.Z) * look
			local u = math.clamp(a.T / 0.55, 0, 1)
			if a.T >= 0.75 then
				return nil, Vector3.zero
			end
			local pos = from.Position:Lerp(land.Position, u) + Vector3.new(0, math.sin(u * math.pi) * 0.4 - u * u * 0.0, 0)
			return CFrame.new(pos) * from.Rotation, Vector3.zero
		end
	end
	return nil, Vector3.zero
end

-- Pose de l'activité
local function activityPose(a: Activity, rig: Rig): Pose
	local pose: Pose = {}
	local root = rig.Root.CFrame
	local park = a.Park
	if a.Kind == "Slide" then
		local S = ParkMotion.SLIDE
		local tower = towerCF(park)
		if a.Phase == "climb" or a.Phase == "approach" then
			-- mains sur les barreaux du dessus (en alternance), pieds sur les barreaux
			local lean = math.tan(S.LadderLean)
			local hy = root.Position.Y - tower.Position.Y
			local k = a.T / 0.42
			local function rungAt(y: number): Vector3
				local ry = math.clamp(math.floor(y / 0.85 + 0.5), 1, 7) * 0.85
				return (tower * CFrame.new(0, ry, S.LadderZ - (S.DeckTop - ry) * lean)).Position
			end
			local rOff = (math.floor(k) % 2 == 0) and 0.85 or 0
			pose.RHand = rungAt(hy + 1.2 + rOff) + tower.RightVector * 0.45
			pose.LHand = rungAt(hy + 2.05 - rOff) - tower.RightVector * 0.45
			pose.RPole = -tower.RightVector * -0.8 - tower.LookVector * 0.5 - UP * 0.5
			pose.LPole = tower.RightVector * -0.8 - tower.LookVector * 0.5 - UP * 0.5
			local step = math.sin(k * math.pi)
			pose.RHip = Rx(35 + 30 * step)
			pose.LHip = Rx(35 + 30 * (1 - step))
			pose.RKnee = Rx(-(50 + 30 * step))
			pose.LKnee = Rx(-(50 + 30 * (1 - step)))
			pose.Waist = Rx(-6)
		elseif a.Phase == "sitdown" or a.Phase == "slide" then
			local w = a.Phase == "slide" and 1 or smooth(a.T / 0.4)
			pose.RHip = Rx(84 * w)
			pose.LHip = Rx(84 * w)
			pose.RKnee = Rx(-18 * w)
			pose.LKnee = Rx(-18 * w)
			pose.RAnkle = Rx(20 * w)
			pose.LAnkle = Rx(20 * w)
			pose.Waist = Rx(10 * w)
			pose.Neck = Rx(-12 * w)
			-- mains sur les boudins de la glissière (ou en l'air : youpi !)
			local joy = a.Phase == "slide" and a.V > 5
			if joy then
				pose.RHand = (root * CFrame.new(1.1, 2.9, -0.2)).Position
				pose.LHand = (root * CFrame.new(-1.1, 2.9, -0.2)).Position
			else
				pose.RHand = (root * CFrame.new(1.05, -0.75, -0.25)).Position
				pose.LHand = (root * CFrame.new(-1.05, -0.75, -0.25)).Position
			end
		elseif a.Phase == "out" then
			local w = 1 - smooth(a.T / 0.55)
			pose.RHip = Rx(84 * w)
			pose.LHip = Rx(84 * w)
			pose.RKnee = Rx(-40 * w)
			pose.LKnee = Rx(-40 * w)
			pose.Waist = Rx(-8 * w)
		end
	elseif a.Kind == "Monkey" then
		local Mk = ParkMotion.MONKEY
		local g = park.G
		local x0 = a.Dir > 0 and Mk.X0 or Mk.X1
		local x1 = a.Dir > 0 and Mk.X1 or Mk.X0
		local spacing = (x1 - x0) / (Mk.Rungs + 1)
		local function bar(i: number, side: number): Vector3
			local x = x0 + math.clamp(i, 1, Mk.Rungs) * spacing
			return g * Vector3.new(x, Mk.BarY + 0.02, Mk.Z + side * 0.42)
		end
		if a.Phase == "cross" then
			local k = a.T / 0.62
			local whole = math.floor(k)
			local frac = k - whole
			-- une main tient la barre, l'autre passe à la suivante
			local lead, trail = whole + 2, whole + 1
			local reach = bar(trail, 0):Lerp(bar(lead, 0), smooth(frac)) + Vector3.new(0, math.sin(frac * math.pi) * 0.35, 0)
			local r, l
			if whole % 2 == 0 then
				r, l = reach + (bar(1, 1) - bar(1, 0)), bar(trail, -1)
			else
				r, l = bar(trail, 1), reach + (bar(1, -1) - bar(1, 0))
			end
			pose.RHand, pose.LHand = r, l
			local sway = math.sin(k * math.pi)
			pose.RHip = Rx(12 * sway)
			pose.LHip = Rx(-8 * sway + 10)
			pose.RKnee = Rx(-25)
			pose.LKnee = Rx(-35)
		elseif a.Phase == "up" then
			local u = smooth(a.T / 1.1)
			pose.RHand = (root * CFrame.new(0.45, 1.3 + 1.2 * u, -0.6)).Position:Lerp(bar(1, 1), u)
			pose.LHand = (root * CFrame.new(-0.45, 1.0 + 1.2 * u, -0.6)).Position:Lerp(bar(1, -1), u)
			pose.RHip = Rx(40 * (1 - u))
			pose.LHip = Rx(15 * (1 - u))
			pose.RKnee = Rx(-60 * (1 - u))
			pose.LKnee = Rx(-20 * (1 - u))
		elseif a.Phase == "drop" then
			local u = smooth(a.T / 0.75)
			local crouch = math.sin(math.clamp((a.T - 0.45) / 0.3, 0, 1) * math.pi)
			pose.RHip = Rx(55 * crouch)
			pose.LHip = Rx(55 * crouch)
			pose.RKnee = Rx(-80 * crouch)
			pose.LKnee = Rx(-80 * crouch)
			pose.Root = CFrame.new(0, -0.5 * crouch, 0)
			pose.RArm = CFrame.Angles(0, 0, rad(40 * (1 - u)))
			pose.LArm = CFrame.Angles(0, 0, rad(-40 * (1 - u)))
		end
	elseif a.Kind == "Dig" then
		-- à genoux (genou gauche au sol), la pelle creuse devant
		local w = smooth(a.Total / 0.5)
		pose.Root = CFrame.new(0, -0.8 * w, 0.1 * w)
		pose.RHip = Rx(85 * w)
		pose.RKnee = Rx(-95 * w)
		pose.LHip = Rx(-5 * w)
		pose.LKnee = Rx(-95 * w)
		pose.LAnkle = Rx(40 * w)
		local cyc = (a.Total % 1.2) / 1.2
		local scoop = math.sin(cyc * TAU)
		pose.Waist = Rx(-(22 + 10 * scoop) * w)
		pose.Neck = Rx(-18 * w)
		local sandY = park.G.Position.Y + 0.6
		local front = root * CFrame.new(0.35, 0, -1.7 - 0.3 * scoop)
		local hand = Vector3.new(front.Position.X, sandY + 0.5 + 0.55 * math.max(0, scoop), front.Position.Z)
		pose.RHand = rig.Root.Position:Lerp(hand, w) + (1 - w) * Vector3.new(0, -1, 0)
		pose.LHand = (root * CFrame.new(-0.45, -1.55 * w, -1.0)).Position
	end
	return pose
end

-- Sable qui vole + tas + trou + château (local, discret)
local function stepDig(a: Activity, rig: Rig, dt: number)
	local park = a.Park
	local root = rig.Root.CFrame
	local sandY = park.G.Position.Y + 0.55
	-- pelle dans la main droite
	local spade = a.Props[1]
	if not spade then
		local f = park.Folder
		spade = newPart(f, "HeldSpade", Vector3.new(0.12, 1.1, 0.12), root, BLUE, M.SmoothPlastic)
		local blade = newPart(f, "HeldBlade", Vector3.new(0.5, 0.06, 0.55), root, BLUE, M.SmoothPlastic)
		local hole = newPart(f, "DigHole", Vector3.new(0.05, 1.2, 1.2), CFrame.new(), SAND_D, M.Sand, CYL)
		local heap = egg(f, "DigHeap", CFrame.new(), Vector3.new(0.4, 0.1, 0.4), SAND:Lerp(SAND_D, 0.15), M.Sand)
		table.insert(a.Props, spade)
		table.insert(a.Props, blade)
		table.insert(a.Props, hole)
		table.insert(a.Props, heap)
		local spot = root * CFrame.new(0.35, 0, -1.8)
		hole.CFrame = CFrame.new(spot.Position.X, sandY + 0.02, spot.Position.Z) * CFrame.Angles(0, 0, math.pi / 2)
		heap:SetAttribute("Grow", 0)
		heap.CFrame = CFrame.new((root * CFrame.new(1.4, 0, -1.3)).Position.X, sandY, (root * CFrame.new(1.4, 0, -1.3)).Position.Z)
	end
	local hand = rig.Character:FindFirstChild("RightHand") or rig.Character:FindFirstChild("Right Arm")
	if hand and hand:IsA("BasePart") then
		local grip = hand.CFrame * CFrame.new(0, hand.Name == "Right Arm" and -0.9 or -0.1, 0)
		local shaft = grip * CFrame.Angles(rad(-70), 0, 0) * CFrame.new(0, -0.4, 0)
		spade.CFrame = shaft
		a.Props[2].CFrame = shaft * CFrame.new(0, -0.62, 0) * CFrame.Angles(rad(15), 0, 0)
	end
	-- chaque pelletée : le tas grossit, quelques grains volent
	local before = a.Scoops
	a.Scoops = math.floor(a.Total / 1.2)
	local heap = a.Props[4]
	if a.Scoops > before and heap then
		local grow = math.min(1, a.Scoops / 6)
		heap.Size = Vector3.new(0.4 + 1.3 * grow, 0.1 + 0.55 * grow, 0.4 + 1.1 * grow)
		local hole = a.Props[3]
		hole.Size = Vector3.new(0.05, 0.6 + 0.9 * grow, 0.6 + 0.9 * grow)
		hole.Color = SAND_D:Lerp(rgb(150, 120, 80), grow * 0.6)
		for k = 1, 4 do
			local grain = ball(park.Folder, "SandGrain", heap.Position + Vector3.new(math.cos(k * 1.7) * 0.3, 0.5 + k * 0.08, math.sin(k * 1.7) * 0.3), 0.14 + (k % 2) * 0.06, SAND, M.Sand)
			grain:SetAttribute("Born", clock)
			table.insert(a.Props, grain)
		end
		-- au bout de 5 pelletées : un petit château de sable (reste, 3 au plus)
		if a.Scoops == 5 and castles < 3 then
			castles += 1
			local c = root * CFrame.new(-1.2, 0, -1.6)
			local base = CFrame.new(c.Position.X, sandY, c.Position.Z)
			local keep = newPart(park.Folder, "SandCastle", Vector3.new(0.9, 1.0, 1.0), base * CFrame.new(0, 0.42, 0) * CFrame.Angles(0, 0, math.pi / 2), SAND:Lerp(SAND_D, 0.25), M.Sand, CYL)
			keep:SetAttribute("Keep", true)
			for q = 0, 3 do
				local ang = q * math.pi / 2
				local tur = newPart(park.Folder, "SandTurret", Vector3.new(0.6, 0.34, 0.34), base * CFrame.new(math.cos(ang) * 0.62, 0.3, math.sin(ang) * 0.62) * CFrame.Angles(0, 0, math.pi / 2), SAND:Lerp(SAND_D, 0.4), M.Sand, CYL)
				tur:SetAttribute("Keep", true)
			end
		end
	end
	-- grains : montent puis retombent, disparaissent
	for i = #a.Props, 5, -1 do
		local p = a.Props[i]
		local born = p:GetAttribute("Born")
		if type(born) == "number" then
			local age = clock - born
			if age > 0.7 then
				p:Destroy()
				table.remove(a.Props, i)
			else
				p.CFrame = p.CFrame + Vector3.new(0.4 * dt, (1.8 - 9 * age) * dt, 0)
			end
		end
	end
	local _ = dt
end

----------------------------------------------------------------------
-- Autres joueurs : glissière, échelle, barres (pose d'après la position)
----------------------------------------------------------------------

local function remoteActivityPose(park: Park, rig: Rig): Pose?
	local root = rig.Root.CFrame
	local S = ParkMotion.SLIDE
	local lp = towerCF(park):PointToObjectSpace(root.Position)
	if math.abs(lp.X) < 1.2 and lp.Z > 1.6 and lp.Z < ParkMotion.SLIDE_END + 0.3 then
		local y = ParkMotion.SlideSurface(lp.Z)
		if lp.Y - y > 0.9 and lp.Y - y < 2.2 then
			return activityPose({ Kind = "Slide", Park = park, Phase = "slide", T = 1, Total = 1, Z = lp.Z, V = 3, Dir = 1, Scoops = 0, Props = {} }, rig)
		end
	end
	if math.abs(lp.X) < 1.1 and lp.Z < S.LadderZ - 0.4 and lp.Z > S.LadderZ - 2.6 and lp.Y > ParkMotion.FLOOR_TOP + HRP_STAND + 0.4 and lp.Y < S.DeckTop + HRP_STAND then
		return activityPose({ Kind = "Slide", Park = park, Phase = "climb", T = (lp.Y % 0.85) / 0.85 * 0.42 + math.floor(lp.Y / 0.85) * 0.42, Total = 1, Z = 0, V = 0, Dir = 1, Scoops = 0, Props = {} }, rig)
	end
	local Mk = ParkMotion.MONKEY
	local mp = park.G:PointToObjectSpace(root.Position)
	if mp.X > Mk.X0 and mp.X < Mk.X1 and math.abs(mp.Z - Mk.Z) < 1 and mp.Y > Mk.BarY - 3.2 and mp.Y < Mk.BarY - 1.4 then
		local dir = root.LookVector:Dot(park.G.RightVector) < 0 and -1 or 1
		local x0 = dir > 0 and Mk.X0 or Mk.X1
		local spacing = (Mk.X1 - Mk.X0) / (Mk.Rungs + 1)
		local k = math.max(0, (mp.X - x0) * dir / spacing - 1)
		return activityPose({ Kind = "Monkey", Park = park, Phase = "cross", T = k * 0.62, Total = 1, Z = 0, V = 0, Dir = dir, Scoops = 0, Props = {} }, rig)
	end
	return nil
end

----------------------------------------------------------------------
-- Boucles
----------------------------------------------------------------------

local function destroyPark(park: Park)
	park.Dead = true
	for _, c in ipairs(park.Conns) do
		c:Disconnect()
	end
	table.clear(park.Conns)
	if activity and activity.Park == park then
		endActivity()
	end
	-- sièges du serveur : remis à leur place de repos (plus personne ne les bouge)
	for _, piece in ipairs(park.Pieces) do
		for _, seat in pairs(piece.Seats) do
			if seat.Parent then
				pcall(function()
					local slot = seat:GetAttribute("ParkSlot") :: number
					local g = park.G
					local rest: CFrame? = nil
					if piece.Kind == "Swing" then
						rest = g * ParkMotion.SwingSeat(piece.Index, 0)
					elseif piece.Kind == "Seesaw" then
						rest = g * ParkMotion.SeesawSeat(slot, ParkMotion.SeesawAngle(0, 0))
					elseif piece.Kind == "Merry" then
						rest = g * ParkMotion.MerrySeat(slot, 0)
					elseif piece.Kind == "Spring" then
						rest = g * ParkMotion.SpringSeat(piece.Index, 0, 0)
					end
					if rest then
						seat.CFrame = rest * CFrame.new(0, -seat.Size.Y / 2, 0)
					end
				end)
			end
		end
	end
	for character in pairs(posed) do
		releasePose(character)
	end
	local index = table.find(parks, park)
	if index then
		table.remove(parks, index)
	end
end

local function cameraPos(): Vector3?
	local cam = workspace.CurrentCamera
	return cam and cam.CFrame.Position or nil
end

local function renderStep(dt: number)
	clock += dt
	local t = serverNow()
	local camPos = cameraPos()
	for i = #parks, 1, -1 do
		local park = parks[i]
		if not park.Parent.Parent or not park.Folder.Parent then
			destroyPark(park)
		else
			-- construction étalée
			for _ = 1, STEP_BUILD do
				local job = table.remove(park.Queue, 1)
				if job then
					job()
				end
			end
			park.Scan -= dt
			if park.Scan <= 0 then
				park.Scan = 1
				hookServer(park)
			end
			if #park.Queue == 0 and camPos and (camPos - park.G.Position).Magnitude < ANIM_R then
				for _, piece in ipairs(park.Pieces) do
					stepPiece(park, piece, t)
				end
			end
		end
	end
	-- activité du joueur local : position du HRP (image par image)
	local a = activity
	if a then
		local rig, humanoid = localRig()
		if not rig or not humanoid or humanoid.Health <= 0 or a.Park.Dead then
			endActivity()
			return
		end
		if a.Kind == "Dig" then
			a.T += dt
			a.Total += dt
			-- on bouge ou on saute : on se relève
			if a.Total > 0.6 and (humanoid.MoveDirection.Magnitude > 0.1 or humanoid.Jump) then
				endActivity()
				return
			end
			stepDig(a, rig, dt)
		else
			local cf, vel = activityFrame(a, dt)
			if not cf then
				endActivity()
				return
			end
			rig.Root.CFrame = cf
			rig.Root.AssemblyLinearVelocity = vel
			rig.Root.AssemblyAngularVelocity = Vector3.zero
		end
	end
end

local function stepped(_time: number, _dt: number)
	local t = serverNow()
	local camPos = cameraPos()
	local seen: { [Model]: boolean } = {}
	-- enfants assis sur les jeux (nous et les autres)
	for _, park in ipairs(parks) do
		if #park.Queue == 0 and camPos and (camPos - park.G.Position).Magnitude < POSE_R + 40 then
			for _, piece in ipairs(park.Pieces) do
				for slot, seat in pairs(piece.Seats) do
					local occupant = seat.Occupant
					local character = occupant and occupant.Parent
					if character and character:IsA("Model") and seat:GetAttribute("ParkPose") == true then
						local rig = rigOf(character)
						if rig then
							local pose = riderPose(park, piece, slot, seat, t)
							if pose then
								applyPose(rig, pose)
								seen[character] = true
							end
						end
					end
				end
			end
			-- autres joueurs sur la glissière / l'échelle / les barres
			for _, player in ipairs(Players:GetPlayers()) do
				local character = player.Character
				if player ~= Players.LocalPlayer and character and not seen[character] then
					local rig = rigOf(character)
					if rig and rig.Humanoid.SeatPart == nil and (rig.Root.Position - park.G.Position).Magnitude < 30 then
						local pose = remoteActivityPose(park, rig)
						if pose then
							applyPose(rig, pose)
							seen[character] = true
						end
					end
				end
			end
		end
	end
	-- nous : activité en cours
	local a = activity
	if a then
		local rig = localRig()
		if rig then
			applyPose(rig, activityPose(a, rig))
			seen[rig.Character] = true
		end
	end
	for character in pairs(posed) do
		if not seen[character] then
			releasePose(character)
		end
	end
end

local function guard(fn: (...any) -> ()): (...any) -> ()
	return function(...)
		if failed then
			return
		end
		local ok, err = pcall(fn, ...)
		if not ok then
			failed = true
			warn("[ParkPlay] " .. tostring(err))
			pcall(endActivity)
			for character in pairs(posed) do
				pcall(releasePose, character)
			end
		end
	end
end

local function ensureRunning()
	if running then
		return
	end
	running = true
	table.insert(conns, RunService.RenderStepped:Connect(guard(renderStep)))
	table.insert(conns, RunService.Stepped:Connect(guard(stepped)))
end

local function stopIfIdle()
	if #parks > 0 or not running then
		return
	end
	running = false
	for _, c in ipairs(conns) do
		c:Disconnect()
	end
	table.clear(conns)
	for character in pairs(posed) do
		releasePose(character)
	end
	table.clear(rigs)
end

----------------------------------------------------------------------
-- API
----------------------------------------------------------------------

function ParkPlay.Build(g: CFrame, parent: Instance, server: Instance?): any
	local folder = Instance.new("Model")
	folder.Name = "ParkPlay"
	folder.Parent = parent
	local park: Park = {
		G = g,
		Parent = parent,
		Folder = folder,
		Server = server,
		Queue = {},
		Pieces = {},
		Prompts = {},
		Conns = {},
		Scan = 0,
		Sand = {},
		Dead = false,
	}
	for _, job in ipairs({ buildGround, buildFence, buildSwings, buildSlide, buildMerry, buildSeesaw, buildSprings, buildMonkey, buildSandbox, buildBenches }) do
		table.insert(park.Queue, function()
			job(park)
		end)
	end
	table.insert(park.Queue, function()
		hookServer(park)
	end)
	table.insert(parks, park)
	-- (le parc disparaît avec son parent : la boucle le voit et nettoie)
	table.insert(park.Conns, folder.AncestryChanged:Connect(function()
		if not folder:IsDescendantOf(game) then
			task.defer(function()
				if not park.Dead then
					destroyPark(park)
				end
				stopIfIdle()
			end)
		end
	end))
	failed = false
	ensureRunning()
	return park
end

function ParkPlay.Debug(): any
	local parts, pieces = 0, 0
	for _, park in ipairs(parks) do
		for _, d in ipairs(park.Folder:GetDescendants()) do
			if d:IsA("BasePart") then
				parts += 1
			end
		end
		pieces += #park.Pieces
	end
	local a = activity
	return {
		Parks = #parks,
		Parts = parts,
		Pieces = pieces,
		Running = running,
		Failed = failed,
		Activity = a and a.Kind or nil,
		Phase = a and a.Phase or nil,
		ActivityZ = a and a.Z or nil,
		ActivityV = a and a.V or nil,
		Posed = (function()
			local n = 0
			for _ in pairs(posed) do
				n += 1
			end
			return n
		end)(),
		Park = parks[1],
		Start = function(action: string)
			local park = parks[1]
			if park then
				startActivity(park, action)
			end
		end,
		Stop = endActivity,
		PoseOf = riderPose,
	}
end

return ParkPlay
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="218">
          <Properties>
            <string name="Name">PetRoam</string>
            <string name="Source"><![CDATA[--[[
	PetRoam (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > PetRoam

	🐾 Dopamine Town (v9.8, GARDEN98) : les animaux achetés (Config.House,
	catégorie Pets, espèces de House3DCritters.ROAMERS) SE PROMÈNENT dans la
	maison et dans le jardin, comme de vrais animaux :
	  - chien, chat, chaton, renard, dragon : marche / trot (pattes en
	    diagonale), la queue remue (chien) ou se balance levée (chat), la tête
	    regarde autour, s'assoit, se couche, fait la sieste (yeux fermés),
	    renifle le sol ; le lapin avance par petits bonds ; le hérisson
	    trottine ; la tortue rampe ; poussin et caneton se dandinent ; le
	    manchot se balance d'un pied sur l'autre ; la chouette tourne la tête
	    et vole d'un point à l'autre ;
	  - chemins DANS la pièce (grille + A*, lissés) en évitant les meubles
	    posés ; parfois (animaux du rez-de-chaussée) une SORTIE au jardin :
	    pièces voisines par les passages, cage d'escalier, porte de derrière
	    (WorldLayout.BackDoorX, HOUSE98) ou porte d'entrée, marches, pelouse,
	    quelques pas en évitant les objets du jardin (GardenSnapshot), puis
	    retour à sa place ;
	  - DÉTERMINISTE : tout dépend de l'heure du serveur
	    (workspace:GetServerTimeNow) et d'une graine (propriétaire, pièce,
	    objet) -> chaque client voit le même animal au même endroit ; cycles
	    de 50 s qui partent de sa place et y reviennent ;
	  - CÔTÉ CLIENT seulement, plafonné : au plus 12 animaux animés (les plus
	    proches de la caméra, à moins de 70 studs), 30 Hz, BulkMoveTo ; au loin
	    rien n'est construit ;
	  - l'animal posé dans la pièce (modèle de la pièce, attribut Pet) est
	    CACHÉ tant que son double se promène ; il revient en pause
	    (SetPaused : mode édition des meubles), à l'arrêt (Stop) ou quand le
	    double est retiré ; un double n'est visible que dehors, dans la cage
	    d'escalier ou dans une pièce CONSTRUITE (pièces en flux).
	Modèles : House3DRecipes.BuildItem (les mêmes que dans la pièce : taille,
	couleur, miroir) ; articulations "Joint_<nom>" / pièces "J_<nom>_..."
	(House3DCritters, animaux réalistes articulés). AUCUN son.

	API (branchée par TownClient) :
	  PetRoam.Start(ctx)  ctx = { GetHouses = () -> { [userId] = house } }
	  PetRoam.Step(dt)    (chaque image : l'animation se limite à 30 Hz)
	  PetRoam.Stop()
	  PetRoam.SetPaused(paused)
	  PetRoam.Debug() -> état (tests)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local WorldLayout = require(ReplicatedStorage.Shared.WorldLayout)
local GardenSnapshot = require(ReplicatedStorage.Shared.GardenSnapshot)

local HouseFolder = script.Parent.Parent.Components.House

local PetRoam = {}

local MAX_ANIMATED = 12
local RANGE = 70 -- (studs) animaux animés autour de la caméra
local FAR = 95 -- au-delà : modèle retiré
local HZ = 1 / 30
local CYCLE = 50 -- (s) un cycle part de la place de l'animal et y revient
local CELL = 0.75 -- (studs) grille des pièces
local WALL_MARGIN = 0.7
local LAWN = 0.45

-- Allures et habitudes (vitesse en studs / s ; Outdoor / Nap = chances par cycle)
local SPECIES: { [string]: any } = {
	Puppy = { Gait = "Quad", Speed = 4.6, Stride = 1.4, Outdoor = 0.45, Nap = 0.12, Wag = 9, Idle = { "Sit", "Sniff", "Look", "Sit" } },
	Kitten = { Gait = "Quad", Speed = 3.6, Stride = 1.0, Outdoor = 0.3, Nap = 0.3, Cat = true, Idle = { "Sit", "Groom", "Look", "Sit" } },
	SleepyCat = { Gait = "Quad", Speed = 3, Stride = 1.1, Outdoor = 0.2, Nap = 0.55, Cat = true, Idle = { "Sit", "Groom", "Sleep" } },
	Fox = { Gait = "Quad", Speed = 4.8, Stride = 1.5, Outdoor = 0.5, Nap = 0.15, Wag = 2.4, Idle = { "Sit", "Sniff", "Look" } },
	Dragon = { Gait = "Quad", Speed = 4, Stride = 1.5, Outdoor = 0.45, Nap = 0.15, Wag = 1.4, Wings = true, Idle = { "Sit", "Look", "Flap" } },
	Bunny = { Gait = "Hop", Speed = 3.2, Stride = 1.2, Outdoor = 0.45, Nap = 0.15, Idle = { "Sniff", "Sit", "Look" } },
	Hedgehog = { Gait = "Scurry", Speed = 2, Stride = 0.45, Outdoor = 0.4, Nap = 0.25, Idle = { "Sniff", "Look" } },
	Turtle = { Gait = "Crawl", Speed = 0.7, Stride = 0.55, Outdoor = 0.3, Nap = 0.3, Idle = { "Look", "Sleep" } },
	Chick = { Gait = "Bird", Speed = 2, Stride = 0.42, Outdoor = 0.45, Nap = 0.15, Idle = { "Peck", "Look", "Flap" } },
	Duckling = { Gait = "Bird", Speed = 2.2, Stride = 0.48, Outdoor = 0.55, Nap = 0.15, Idle = { "Peck", "Look", "Flap" } },
	Penguin = { Gait = "Waddle", Speed = 1.8, Stride = 0.55, Outdoor = 0.35, Nap = 0.15, Idle = { "Look", "Flap" } },
	Owl = { Gait = "Owl", Speed = 6, Stride = 1, Outdoor = 0.3, Nap = 0.45, Idle = { "Look", "Look", "Flap" } },
}
PetRoam.SPECIES = SPECIES

----------------------------------------------------------------------
-- État
----------------------------------------------------------------------

type Pet = {
	Key: string,
	House: any,
	UserId: number,
	ItemId: string,
	Entry: any,
	EntryIndex: number,
	Slot: number,
	Info: any,
	Seed: number,
	Home: Vector3, -- (x, y du sol, d) repère de la maison
	HomeYaw: number,
	Nav: any?,
	Model: Model?,
	Rig: any?,
	Plan: any?,
	PlanCycle: number,
	Visible: boolean,
	Pos: Vector3?, -- dernière position (monde)
	Hidden: { [BasePart]: number }, -- original caché (transparences d'origine)
	Original: Model?,
	Routes: any?, -- sorties vers le jardin { Front, Back }
	Perch: boolean?, -- posé SUR un meuble (canapé, lit...) : il reste là (poses seulement)
	PerchCF: CFrame?, -- pivot du modèle de la pièce
}

local ctx: any = {}
local started = false
local paused = false
local folder: Folder? = nil
local pets: { [string]: Pet } = {}
local active: { Pet } = {}
local clock = 0
local refreshClock = 999
local selectClock = 999
local navCache: { [any]: any } = {}
local footprintCache: { [string]: any } = {}
local Recipes: any = nil
local recipesTried = false
local Surfaces: any = nil
local surfacesTried = false

-- (HouseSurfaces : un objet posé SUR un meuble ?)
local function surfaces(): any
	if not surfacesTried then
		surfacesTried = true
		local module = HouseFolder:FindFirstChild("HouseSurfaces")
		if module then
			local ok, result = pcall(require, module)
			if ok and type(result) == "table" then
				Surfaces = result
			end
		end
	end
	return Surfaces
end

local function onFurniture(entry: any, list: { any }, size: any): boolean
	local S = surfaces()
	if not S or type(S.SupportOf) ~= "function" then
		return false
	end
	local ok, support = pcall(S.SupportOf, entry, list, WorldLayout.RoomWidthPx(size), WorldLayout.ROOM_HEIGHT_PX)
	return ok and type(support) == "table" and support.Entry ~= nil and support.Entry ~= entry
end

local function recipes(): any
	if not recipesTried then
		recipesTried = true
		local module = HouseFolder:FindFirstChild("House3DRecipes")
		if module then
			local ok, result = pcall(require, module)
			if ok and type(result) == "table" then
				Recipes = result
			end
		end
	end
	return Recipes
end

local function serverNow(): number
	local ok, value = pcall(function()
		return workspace:GetServerTimeNow()
	end)
	if ok and type(value) == "number" and value == value then
		return value
	end
	return os.clock()
end

-- Graine stable d'un texte
local function hash(text: string): number
	local h = 5381
	for i = 1, #text do
		h = (h * 33 + string.byte(text, i)) % 2147483647
	end
	return h
end

local function wrapAngle(a: number): number
	return (a + math.pi) % (2 * math.pi) - math.pi
end

----------------------------------------------------------------------
-- Géométrie de la maison : pièces, grille, meubles
----------------------------------------------------------------------

local function sizeOf(house: any): any
	local snapshot = house.Snapshot or {}
	local byId: any = Config.HouseSizesById
	return (type(snapshot.Size) == "string" and byId and byId[snapshot.Size]) or house.Size
end

-- Empreinte (studs) d'un objet posé (modèle construit une fois, en cache)
local function footprintOf(itemId: string, scale: number): any
	local key = itemId .. "|" .. string.format("%.2f", scale)
	local cached = footprintCache[key]
	if cached ~= nil then
		return cached or nil
	end
	local result: any = false
	local R = recipes()
	if R and type(R.BuildModel) == "function" then
		local ok, model, data = pcall(R.BuildModel, itemId, { I = itemId, X = 0.5, Y = 0.8, S = scale, Z = 0 }, { Scale = WorldLayout.PX, Collide = false, Query = false })
		if ok and model and type(data) == "table" then
			result = { FW = tonumber(data.FW) or 1, FD = tonumber(data.FD) or 1, Flat = data.Info and data.Info.Flat == true, Wall = data.Info and data.Info.Wall == true }
			model:Destroy()
		elseif ok and model then
			model:Destroy()
		end
	end
	if not result then
		local item = Config.HouseItemsById[itemId]
		local w = (tonumber(item and item.Size) or 80) * scale * WorldLayout.PX
		result = { FW = w * 0.85, FD = w * 0.6, Flat = false, Wall = false }
	end
	footprintCache[key] = result
	return result
end

type Room = {
	Slot: number,
	Floor: number,
	X0: number, X1: number, D0: number, D1: number, Y: number,
	NX: number, ND: number,
	Blocked: { [number]: boolean },
}

local function cellIndex(room: Room, i: number, j: number): number
	return j * room.NX + i
end

local function cellOf(room: Room, x: number, d: number): (number, number)
	return math.floor((x - room.X0) / CELL), math.floor((d - room.D0) / CELL)
end

local function cellCenter(room: Room, i: number, j: number): (number, number)
	return room.X0 + (i + 0.5) * CELL, room.D0 + (j + 0.5) * CELL
end

local function isFree(room: Room, i: number, j: number): boolean
	if i < 0 or j < 0 or i >= room.NX or j >= room.ND then
		return false
	end
	return not room.Blocked[cellIndex(room, i, j)]
end

local function freeAt(room: Room, x: number, d: number): boolean
	local i, j = cellOf(room, x, d)
	return isFree(room, i, j)
end

-- Ligne droite libre (échantillons tous les 0,15 stud : aucun coin de meuble rogné)
local function clearLine(room: Room, x0: number, d0: number, x1: number, d1: number): boolean
	local length = math.sqrt((x1 - x0) ^ 2 + (d1 - d0) ^ 2)
	local steps = math.max(1, math.ceil(length / 0.15))
	for k = 0, steps do
		local t = k / steps
		if not freeAt(room, x0 + (x1 - x0) * t, d0 + (d1 - d0) * t) then
			return false
		end
	end
	return true
end

-- Pièce : intérieur + cases bloquées (meubles posés au sol, sauf l'animal lui-même)
local function buildRoom(house: any, size: any, slot: number, roomData: any, skipIndex: { [number]: boolean }?): Room
	local x0, x1, yFloor, d0, d1 = WorldLayout.RoomInterior(size, slot)
	local floor = WorldLayout.SlotCell(size, slot)
	local room: Room = {
		Slot = slot,
		Floor = floor,
		X0 = x0 + WALL_MARGIN,
		X1 = x1 - WALL_MARGIN,
		D0 = d0 + WALL_MARGIN,
		D1 = d1 - WALL_MARGIN,
		Y = yFloor,
		NX = 0,
		ND = 0,
		Blocked = {},
	}
	room.NX = math.max(1, math.floor((room.X1 - room.X0) / CELL))
	room.ND = math.max(1, math.floor((room.D1 - room.D0) / CELL))
	if type(roomData) ~= "table" or type(roomData.Placed) ~= "table" then
		return room
	end
	local dims = WorldLayout.RoomDims(size, Config.House.WallRatio)
	local xc = (x0 + x1) / 2
	local floorMinY = (tonumber(Config.House.WallRatio) or 0.46) * 0.85
	local pad = 0.55
	for index, entry in ipairs(roomData.Placed) do
		local item = type(entry) == "table" and Config.HouseItemsById[entry.I] or nil
		if item and item.Placement ~= "Wall" and not (skipIndex and skipIndex[index]) and not SPECIES[entry.I] then
			local Y = tonumber(entry.Y) or 0.8
			if Y >= floorMinY then
				local s = math.clamp(tonumber(entry.S) or 1, 0.2, 3)
				local fp = footprintOf(entry.I, s)
				if fp and not fp.Flat then
					local fw, fd = fp.FW, fp.FD
					local r = tonumber(entry.R) or 0
					if math.abs(math.sin(math.rad(r))) > 0.5 then
						fw, fd = fd, fw
					end
					local ok, rx, rz = pcall(WorldLayout.FloorForward, dims, tonumber(entry.X) or 0.5, Y, fw, fd, fp.Wall)
					if ok then
						local cx, cd = xc + rx, d1 - rz
						local i0, j0 = cellOf(room, cx - fw / 2 - pad, cd - fd / 2 - pad)
						local i1, j1 = cellOf(room, cx + fw / 2 + pad, cd + fd / 2 + pad)
						for i = math.max(0, i0), math.min(room.NX - 1, i1) do
							for j = math.max(0, j0), math.min(room.ND - 1, j1) do
								room.Blocked[cellIndex(room, i, j)] = true
							end
						end
					end
				end
			end
		end
	end
	return room
end

-- A* sur la grille (8 voisins) -> points (x, d) lissés ; nil si impossible
local function findPath(room: Room, ax: number, ad: number, bx: number, bd: number): { Vector2 }?
	if clearLine(room, ax, ad, bx, bd) then
		return { Vector2.new(ax, ad), Vector2.new(bx, bd) }
	end
	local si, sj = cellOf(room, ax, ad)
	local gi, gj = cellOf(room, bx, bd)
	if not isFree(room, gi, gj) then
		return nil
	end
	si, sj = math.clamp(si, 0, room.NX - 1), math.clamp(sj, 0, room.ND - 1)
	local start, goal = cellIndex(room, si, sj), cellIndex(room, gi, gj)
	local g: { [number]: number } = { [start] = 0 }
	local came: { [number]: number } = {}
	local closed: { [number]: boolean } = {}
	-- tas binaire (f, index)
	local heapF, heapN = {}, {}
	local function push(f: number, n: number)
		table.insert(heapF, f)
		table.insert(heapN, n)
		local k = #heapF
		while k > 1 do
			local parent = k // 2
			if heapF[parent] <= heapF[k] then
				break
			end
			heapF[parent], heapF[k] = heapF[k], heapF[parent]
			heapN[parent], heapN[k] = heapN[k], heapN[parent]
			k = parent
		end
	end
	local function pop(): number
		local top = heapN[1]
		local lastF, lastN = table.remove(heapF), table.remove(heapN)
		if #heapF > 0 then
			heapF[1], heapN[1] = lastF, lastN
			local k = 1
			while true do
				local l, r = k * 2, k * 2 + 1
				local m = k
				if l <= #heapF and heapF[l] < heapF[m] then
					m = l
				end
				if r <= #heapF and heapF[r] < heapF[m] then
					m = r
				end
				if m == k then
					break
				end
				heapF[m], heapF[k] = heapF[k], heapF[m]
				heapN[m], heapN[k] = heapN[k], heapN[m]
				k = m
			end
		end
		return top
	end
	local function h(n: number): number
		local i, j = n % room.NX, n // room.NX
		local di, dj = math.abs(i - gi), math.abs(j - gj)
		return math.max(di, dj) + 0.414 * math.min(di, dj)
	end
	push(h(start), start)
	local found = false
	local expanded = 0
	while #heapF > 0 and expanded < 6000 do
		local n = pop()
		if n == goal then
			found = true
			break
		end
		if not closed[n] then
			closed[n] = true
			expanded += 1
			local i, j = n % room.NX, n // room.NX
			for di = -1, 1 do
				for dj = -1, 1 do
					if di ~= 0 or dj ~= 0 then
						local ni, nj = i + di, j + dj
						-- (pas de coin coupé à travers un meuble)
						if isFree(room, ni, nj) and (di == 0 or dj == 0 or (isFree(room, i + di, j) and isFree(room, i, j + dj))) then
							local m = cellIndex(room, ni, nj)
							local cost = g[n] + ((di ~= 0 and dj ~= 0) and 1.414 or 1)
							if not closed[m] and (g[m] == nil or cost < g[m]) then
								g[m] = cost
								came[m] = n
								push(cost + h(m), m)
							end
						end
					end
				end
			end
		end
	end
	if not found then
		return nil
	end
	local cells = {}
	local n = goal
	while n ~= nil do
		table.insert(cells, 1, n)
		if n == start then
			break
		end
		n = came[n]
	end
	local raw = { Vector2.new(ax, ad) }
	for index = 2, #cells - 1 do
		local cx, cd = cellCenter(room, cells[index] % room.NX, cells[index] // room.NX)
		table.insert(raw, Vector2.new(cx, cd))
	end
	table.insert(raw, Vector2.new(bx, bd))
	-- lissage : on saute les points visibles en ligne droite
	local smooth = { raw[1] }
	local k = 1
	while k < #raw do
		local far = k + 1
		for m = #raw, k + 1, -1 do
			if clearLine(room, raw[k].X, raw[k].Y, raw[m].X, raw[m].Y) then
				far = m
				break
			end
		end
		table.insert(smooth, raw[far])
		k = far
	end
	return smooth
end

-- Hauteur du sol (repère de la maison) sous un point, par un rayon (perron, marches)
local function groundY(house: any, x: number, d: number, fallback: number): number
	local ok, y = pcall(function()
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Include
		params.FilterDescendantsInstances = { house.Exterior or house.Model }
		local from = house.HouseCF * Vector3.new(x, 8, -d)
		local result = workspace:Raycast(from, house.HouseCF.UpVector * -12, params)
		if result then
			local localY = house.HouseCF:PointToObjectSpace(result.Position).Y
			if localY > -0.5 and localY < 6 then
				return localY
			end
		end
		return nil
	end)
	if ok and type(y) == "number" then
		return y
	end
	return fallback
end

-- Navigation d'une maison (en cache tant que ses pièces ne changent pas)
local function roomsKey(house: any): string
	local snapshot = house.Snapshot or {}
	local parts = { tostring(snapshot.Size) }
	for _, room in ipairs(snapshot.Rooms or {}) do
		table.insert(parts, tostring(room.Id) .. "@" .. tostring(room.Slot))
		for _, entry in ipairs(room.Placed or {}) do
			table.insert(parts, string.format("%s:%.3f:%.3f:%.2f:%s", tostring(entry.I), tonumber(entry.X) or 0, tonumber(entry.Y) or 0, tonumber(entry.S) or 1, tostring(entry.R)))
		end
	end
	local garden = snapshot.DopamineGarden
	if type(garden) == "table" and type(garden.Layout) == "table" then
		local keys = {}
		for key, e in pairs(garden.Layout) do
			if type(e) == "table" then
				table.insert(keys, string.format("%s:%.1f:%.1f", key, tonumber(e.X) or 0, tonumber(e.D) or 0))
			end
		end
		table.sort(keys)
		table.insert(parts, table.concat(keys, ","))
	end
	return table.concat(parts, "|")
end

local function navFor(house: any): any
	local key = roomsKey(house)
	local cached = navCache[house]
	if cached and cached.Key == key then
		return cached
	end
	local size = sizeOf(house)
	local snapshot = house.Snapshot or {}
	local dims = WorldLayout.Dims(size)
	local bySlot = {}
	for _, room in ipairs(snapshot.Rooms or {}) do
		local slot = tonumber(room.Slot)
		if slot then
			bySlot[slot] = room
		end
	end
	local hall0, hall1 = WorldLayout.HallSpan(size)
	local doorX = WorldLayout.DoorX(size)
	local nav: any = {
		Key = key,
		Size = size,
		Dims = dims,
		BySlot = bySlot,
		Rooms = {},
		Hall0 = hall0,
		Hall1 = hall1,
		DoorX = doorX,
		Floor1 = WorldLayout.FloorY(1),
		HallAfter = WorldLayout.HallAfter(size),
	}
	-- porte de derrière (HOUSE98) : facultative
	local okBack, backX = pcall(function()
		return (WorldLayout :: any).BackDoorX(size)
	end)
	local okBackD, backD = pcall(function()
		return (WorldLayout :: any).BackDoorD(size)
	end)
	local okSteps, stepsD = pcall(function()
		return (WorldLayout :: any).BackStepsD(size)
	end)
	if okBack and type(backX) == "number" and okBackD and type(backD) == "number" and okSteps and type(stepsD) == "number" then
		nav.BackX, nav.BackD, nav.StepsD = backX, backD, stepsD
	end
	-- objets du jardin (empreintes) : pour les promenades dehors
	local gardenState = GardenSnapshot.Sanitize(snapshot.DopamineGarden)
	nav.GardenItems = {}
	for _, entry in ipairs(GardenSnapshot.Arrange(gardenState)) do
		if not entry.Flat then
			local hx, hd = GardenSnapshot.HalfExtents(entry.W, entry.Dp, entry.R)
			table.insert(nav.GardenItems, { entry.X - hx - 0.7, entry.X + hx + 0.7, entry.D - hd - 0.7, entry.D + hd + 0.7 })
		end
	end
	navCache[house] = nav
	return nav
end

local function roomOf(nav: any, house: any, slot: number): Room
	local room = nav.Rooms[slot]
	if not room then
		room = buildRoom(house, nav.Size, slot, nav.BySlot[slot], nil)
		nav.Rooms[slot] = room
	end
	return room
end

-- Point (x, d) dehors libre ? (objets du jardin + parcelle)
local function yardFree(nav: any, x: number, d: number): boolean
	if math.abs(x) > 84 or d > 51 or d < -27 then
		return false
	end
	-- (pas dans la maison)
	if d > -1.5 and d < nav.Dims.Depth + 1.5 and x > nav.Dims.Left - 1.5 and x < nav.Dims.Left + nav.Dims.Width + 1.5 then
		return false
	end
	for _, box in ipairs(nav.GardenItems) do
		if x > box[1] and x < box[2] and d > box[3] and d < box[4] then
			return false
		end
	end
	return true
end

local function yardLine(nav: any, x0: number, d0: number, x1: number, d1: number): boolean
	local length = math.sqrt((x1 - x0) ^ 2 + (d1 - d0) ^ 2)
	local steps = math.max(1, math.ceil(length / 0.5))
	for k = 1, steps do
		local t = k / steps
		if not yardFree(nav, x0 + (x1 - x0) * t, d0 + (d1 - d0) * t) then
			return false
		end
	end
	return true
end

----------------------------------------------------------------------
-- Chemins du rez-de-chaussée vers dehors (pièces voisines, cage, porte)
----------------------------------------------------------------------

-- Case libre du bord d'une pièce la plus proche de `d` dans la largeur d'un passage
local function passableD(room: Room, x: number, d: number): number?
	local half = (WorldLayout.PASS_W or 5) / 2 - 0.9
	local best: number? = nil
	for k = 0, math.floor(half / CELL) do
		for _, sign in ipairs({ 1, -1 }) do
			local dd = d + sign * k * CELL
			if not best and math.abs(dd - d) <= half and freeAt(room, x, dd) then
				best = dd
			end
		end
	end
	return best
end

-- Sortie de la pièce `slot` (rez-de-chaussée) jusqu'au jardin : points
-- { x, y, d, Door? } depuis `home` ; nil si impossible
local function exitRoute(pet: Pet, nav: any, back: boolean): { any }?
	local house = pet.House
	local size = nav.Size
	local floor, column = WorldLayout.SlotCell(size, pet.Slot)
	if floor ~= 1 then
		return nil
	end
	local y1 = nav.Floor1
	-- (v9.9) profondeur du passage : propre à chaque mur (manoir : passage du fond)
	local passD = WorldLayout.WALL_T + WorldLayout.DEPTH / 2
	local points: { any } = {}
	local function add(x: number, d: number, y: number?, door: boolean?)
		table.insert(points, { X = x, Y = y or y1, D = d, Door = door })
	end
	local curX, curD = pet.Home.X, pet.Home.Z
	add(curX, curD)
	local hallAfter = nav.HallAfter
	local columns = nav.Dims.Columns
	local step = column <= hallAfter and 1 or -1
	local c = column
	while true do
		local slot = (floor - 1) * columns + c
		local room = roomOf(nav, house, slot)
		local cx0, cx1 = WorldLayout.ColumnSpan(size, c)
		-- sortie de cette pièce du côté de la cage : case libre du bord, dans
		-- la largeur du passage (une lampe peut en gêner le milieu)
		local exitX = step > 0 and (room.X0 + (room.NX - 0.5) * CELL) or (room.X0 + 0.5 * CELL)
		local passA, passB = WorldLayout.PassageSpan(size, c, step > 0 and "Right" or "Left")
		passD = (passA + passB) / 2
		local exitD = passableD(room, exitX, passD)
		if not exitD then
			return nil
		end
		local path = findPath(room, curX, curD, exitX, exitD)
		if not path then
			return nil
		end
		for index = 2, #path do
			add(path[index].X, path[index].Y)
		end
		-- traverse le mur (passage)
		local wallX = step > 0 and cx1 or cx0
		add(wallX + step * 0.9, exitD)
		curX, curD = wallX + step * 0.9, exitD
		local nextColumn = c + step
		local reachedHall = (step > 0 and c == hallAfter) or (step < 0 and nextColumn == hallAfter)
		if reachedHall or nextColumn < 1 or nextColumn > columns then
			break
		end
		c = nextColumn
		-- pièce voisine : on entre juste après le mur
		local nextRoom = roomOf(nav, house, (floor - 1) * columns + c)
		local entryX = step > 0 and (nextRoom.X0 + 0.5 * CELL) or (nextRoom.X0 + (nextRoom.NX - 0.5) * CELL)
		local entryD = passableD(nextRoom, entryX, curD)
		if not entryD then
			return nil
		end
		curX, curD = entryX, entryD
		add(curX, curD)
	end
	-- cage d'escalier : couloir le long de l'escalier
	-- (v9.9 HOUSE99) couloir libre le long de la cage, à l'écart de l'escalier, de la console et de la table
	local corridorX = WorldLayout.CorridorX(size) + 1.6
	add(corridorX, passD)
	local doorX = nav.DoorX
	if back and nav.BackX then
		add(corridorX, nav.Dims.Depth - 2.2)
		add(nav.BackX, nav.BackD - 1.2)
		add(nav.BackX, nav.BackD + 0.4, nil, true)
		local landingY = groundY(house, nav.BackX, nav.BackD + 1.6, y1)
		add(nav.BackX, nav.BackD + 1.6, landingY)
		add(nav.BackX, nav.StepsD + 1, groundY(house, nav.BackX, nav.StepsD + 1, LAWN))
	else
		add(corridorX, 2.4)
		add(doorX, 1.6)
		add(doorX, -0.6, nil, true)
		for d = -2, -12, -2 do
			add(doorX, d, groundY(house, doorX, d, LAWN))
		end
	end
	return points
end

----------------------------------------------------------------------
-- Plans (cycles) : marche, poses
----------------------------------------------------------------------

local function polylineLength(points: { any }): number
	local total = 0
	for index = 2, #points do
		local a, b = points[index - 1], points[index]
		total += math.sqrt((b.X - a.X) ^ 2 + (b.D - a.D) ^ 2 + (b.Y - a.Y) ^ 2 * 0.25)
	end
	return total
end

local function reversed(points: { any }): { any }
	local out = {}
	for index = #points, 1, -1 do
		table.insert(out, points[index])
	end
	return out
end

local function yawAlong(a: any, b: any): number
	return math.atan2(-(b.X - a.X), -(-(b.D - a.D)))
end

local function planCycle(pet: Pet, cycle: number): any
	local rng = Random.new((pet.Seed * 7919 + cycle * 104729) % 2147483647)
	local info = pet.Info
	local nav = pet.Nav
	local segs: { any } = {}
	local t = 0
	local home = { X = pet.Home.X, Y = pet.Home.Y, D = pet.Home.Z }
	local yaw = pet.HomeYaw
	local function pose(kind: string, duration: number, at: any)
		if duration <= 0.05 then
			return
		end
		table.insert(segs, { K = "Pose", Pose = kind, At = at, Yaw = yaw, T0 = t, T1 = t + duration })
		t += duration
	end
	local function walk(points: { any }): boolean
		if #points < 2 then
			return true
		end
		local length = polylineLength(points)
		local duration = length / info.Speed + (info.Gait == "Owl" and 0.6 or 0)
		if t + duration > CYCLE - 1.5 then
			return false
		end
		table.insert(segs, { K = "Walk", Pts = points, Len = length, YawIn = yaw, T0 = t, T1 = t + duration })
		t += duration
		local last, before = points[#points], points[#points - 1]
		yaw = yawAlong(before, last)
		return true
	end
	local room = nav and nav.Rooms[pet.Slot]
	local roll = rng:NextNumber()
	local idle = info.Idle
	if pet.Perch then
		-- posé sur un meuble : sieste, assis, regarde autour (sans descendre)
		while t < CYCLE - 0.5 do
			local kind = roll < 0.5 and "Sleep" or idle[rng:NextInteger(1, #idle)]
			pose(kind, math.min(CYCLE - t, rng:NextNumber(8, 20)), home)
			roll = rng:NextNumber()
		end
		return { Segs = segs, Cycle = cycle }
	end
	if roll < info.Nap or not room then
		pose("Sleep", CYCLE, home)
		return { Segs = segs, Cycle = cycle }
	end
	local cur = home
	-- sortie au jardin ?
	if roll < info.Nap + info.Outdoor then
		local back = nav.BackX ~= nil and rng:NextNumber() < 0.7
		local route = pet.Routes and pet.Routes[back and "Back" or "Front"]
		if route and #route >= 2 then
			local outside = route[#route]
			local planned = { outside }
			for _ = 1, 2 do
				local from = planned[#planned]
				for _ = 1, 12 do
					local dx = rng:NextNumber(-14, 14)
					local dd = back and rng:NextNumber(2, 14) or rng:NextNumber(-10, -2)
					local x, d = from.X + dx * 0.6, (back and (outside.D + dd) or (outside.D + dd))
					if yardFree(nav, x, d) and yardLine(nav, from.X, from.D, x, d) then
						table.insert(planned, { X = x, Y = LAWN, D = d })
						break
					end
				end
			end
			local saved = { t, yaw, #segs }
			local ok = walk(route)
			for index = 2, #planned do
				ok = ok and walk({ planned[index - 1], planned[index] })
				if ok then
					pose(idle[rng:NextInteger(1, #idle)], rng:NextNumber(2.5, 5), planned[index])
				end
			end
			if ok then
				local backPts = reversed(planned)
				ok = walk(backPts) and walk(reversed(route))
			end
			if ok then
				pose("Sit", CYCLE - t, home)
				return { Segs = segs, Cycle = cycle }
			end
			-- trop long : on oublie la sortie
			t, yaw = saved[1], saved[2]
			while #segs > saved[3] do
				table.remove(segs)
			end
		end
	end
	-- promenade dans la pièce : 2 ou 3 étapes puis retour à sa place
	local stops = rng:NextInteger(2, 3)
	pose(idle[rng:NextInteger(1, #idle)], rng:NextNumber(1.5, 4), cur)
	for _ = 1, stops do
		local target: any = nil
		local path: { Vector2 }? = nil
		for _ = 1, 14 do
			local i, j = rng:NextInteger(0, room.NX - 1), rng:NextInteger(0, room.ND - 1)
			if isFree(room, i, j) then
				local x, d = cellCenter(room, i, j)
				if (x - cur.X) ^ 2 + (d - cur.D) ^ 2 > 6 then
					local p = if info.Gait == "Owl" then { Vector2.new(cur.X, cur.D), Vector2.new(x, d) } else findPath(room, cur.X, cur.D, x, d)
					if p then
						target, path = { X = x, Y = room.Y, D = d }, p
						break
					end
				end
			end
		end
		if not target or not path then
			break
		end
		local points = {}
		for _, v in ipairs(path) do
			table.insert(points, { X = v.X, Y = room.Y, D = v.Y })
		end
		-- (il faut pouvoir revenir : on garde du temps)
		local homePath = if info.Gait == "Owl" then { Vector2.new(target.X, target.D), Vector2.new(home.X, home.D) } else findPath(room, target.X, target.D, home.X, home.D)
		local backLen = 0
		if homePath then
			for index = 2, #homePath do
				backLen += (homePath[index] - homePath[index - 1]).Magnitude
			end
		end
		if not homePath or t + polylineLength(points) / info.Speed + backLen / info.Speed + 5 > CYCLE then
			break
		end
		if not walk(points) then
			break
		end
		cur = target
		pose(idle[rng:NextInteger(1, #idle)], rng:NextNumber(2.5, 7), cur)
	end
	-- retour
	if cur ~= home then
		local p = if info.Gait == "Owl" then { Vector2.new(cur.X, cur.D), Vector2.new(home.X, home.D) } else findPath(room, cur.X, cur.D, home.X, home.D)
		local points = {}
		for _, v in ipairs(p or { Vector2.new(cur.X, cur.D), Vector2.new(home.X, home.D) }) do
			table.insert(points, { X = v.X, Y = room.Y, D = v.Y })
		end
		-- (toujours revenir, même si le cycle déborde un peu : durée recalculée)
		local length = polylineLength(points)
		local duration = length / info.Speed + (info.Gait == "Owl" and 0.6 or 0)
		table.insert(segs, { K = "Walk", Pts = points, Len = length, YawIn = yaw, T0 = t, T1 = math.min(CYCLE - 0.5, t + duration) })
		t = math.min(CYCLE - 0.5, t + duration)
		if #points >= 2 then
			yaw = yawAlong(points[#points - 1], points[#points])
		end
	end
	pose("Sit", CYCLE - t, home)
	return { Segs = segs, Cycle = cycle }
end

-- État de l'animal à l'heure `now` : position (repère maison), cap, allure, pose
local function sample(pet: Pet, now: number): any
	local offset = pet.Seed % CYCLE
	local cycleT = now + offset
	local cycle = math.floor(cycleT / CYCLE)
	if pet.PlanCycle ~= cycle or not pet.Plan then
		pet.Plan = planCycle(pet, cycle)
		pet.PlanCycle = cycle
	end
	local t = cycleT - cycle * CYCLE
	local plan = pet.Plan
	local seg = plan.Segs[#plan.Segs]
	for _, s in ipairs(plan.Segs) do
		if t >= s.T0 and t < s.T1 then
			seg = s
			break
		end
	end
	if not seg then
		return { X = pet.Home.X, Y = pet.Home.Y, D = pet.Home.Z, Yaw = pet.HomeYaw, Move = 0, Dist = 0, Pose = "Sit", W = 1, Hidden = false, Fly = 0 }
	end
	if seg.K == "Pose" then
		local dur = seg.T1 - seg.T0
		local u = t - seg.T0
		local w = math.clamp(math.min(u, dur - u) / 0.6, 0, 1)
		return { X = seg.At.X, Y = seg.At.Y, D = seg.At.D, Yaw = seg.Yaw, Move = 0, Dist = 0, Pose = seg.Pose, W = w, Hidden = false, Fly = 0, U = u }
	end
	-- marche : distance parcourue le long de la ligne brisée
	local dur = math.max(0.05, seg.T1 - seg.T0)
	local u = math.clamp((t - seg.T0) / dur, 0, 1)
	local target = u * seg.Len
	local pts = seg.Pts
	local acc = 0
	local x, y, d, yaw = pts[1].X, pts[1].Y, pts[1].D, seg.YawIn
	local hidden = false
	for index = 2, #pts do
		local a, b = pts[index - 1], pts[index]
		local len = math.sqrt((b.X - a.X) ^ 2 + (b.D - a.D) ^ 2 + (b.Y - a.Y) ^ 2 * 0.25)
		if acc + len >= target or index == #pts then
			local k = len > 1e-4 and math.clamp((target - acc) / len, 0, 1) or 1
			x = a.X + (b.X - a.X) * k
			y = a.Y + (b.Y - a.Y) * k
			d = a.D + (b.D - a.D) * k
			if len > 1e-3 then
				yaw = yawAlong(a, b)
			end
			-- passage d'une porte : caché un instant (la chatière !)
			if (a.Door and k < 0.35) or (b.Door and k > 0.65) then
				hidden = true
			end
			break
		end
		acc += len
	end
	-- tourne en douceur au départ
	local turnIn = math.clamp((t - seg.T0) / 0.35, 0, 1)
	local finalYaw = seg.YawIn + wrapAngle(yaw - seg.YawIn) * turnIn
	local fly = 0
	if pet.Info.Gait == "Owl" then
		fly = math.sin(u * math.pi) * 3
	end
	local move = math.clamp(math.min(t - seg.T0, seg.T1 - t) / 0.3, 0, 1)
	return { X = x, Y = y, D = d, Yaw = finalYaw, Move = move, Dist = target, Pose = "Stand", W = 0, Hidden = hidden, Fly = fly }
end

----------------------------------------------------------------------
-- Modèles articulés
----------------------------------------------------------------------

local SKIP = { Root = true, Hitbox = true, SeatPart = true }

local function buildRig(pet: Pet): boolean
	local R = recipes()
	if not R or type(R.BuildItem) ~= "function" then
		return false
	end
	local entry = table.clone(pet.Entry)
	local model = R.BuildItem(pet.ItemId, entry, { Scale = WorldLayout.PX, Collide = false, Query = false })
	if not model then
		return false
	end
	model.Name = "Roaming_" .. pet.ItemId
	local pivot = model:GetPivot()
	local joints: { [string]: CFrame } = { Body = CFrame.identity }
	local markers = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local jointName = string.match(d.Name, "^Joint_(%w+)$")
			if jointName then
				joints[jointName] = CFrame.new(pivot:PointToObjectSpace(d.Position))
				table.insert(markers, d)
			end
		end
	end
	for _, m in ipairs(markers) do
		m:Destroy()
	end
	local parts, rel, jointOf, isEye = {}, {}, {}, {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			if SKIP[d.Name] then
				d:Destroy()
			else
				local jointName = string.match(d.Name, "^J_(%w+)_") or "Body"
				if not joints[jointName] then
					jointName = "Body"
				end
				d.Anchored = true
				d.CanCollide = false
				d.CanQuery = false
				d.CanTouch = false
				table.insert(parts, d)
				table.insert(jointOf, jointName)
				table.insert(rel, joints[jointName]:Inverse() * pivot:ToObjectSpace(d.CFrame))
				table.insert(isEye, string.find(d.Name, "_Eye", 1, true) ~= nil)
			end
		end
	end
	if #parts == 0 then
		model:Destroy()
		return false
	end
	-- (encombrement mesuré sur les pièces : haut, longueur)
	local top, zMin, zMax = 0.5, 0, 0
	for index, part in ipairs(parts) do
		local p = (joints[jointOf[index]] * rel[index]).Position
		top = math.max(top, p.Y + part.Size.Y / 2)
		zMin = math.min(zMin, p.Z - part.Size.Z / 2)
		zMax = math.max(zMax, p.Z + part.Size.Z / 2)
	end
	local extents = Vector3.new(0, top, zMax - zMin)
	pet.Model = model
	pet.Rig = {
		Parts = parts,
		Rel = rel,
		Joint = jointOf,
		Eye = isEye,
		Joints = joints,
		Height = math.max(0.5, extents.Y),
		Length = math.max(0.5, extents.Z),
		CFrames = table.create(#parts, CFrame.identity),
		HipY = joints.LegBL and joints.LegBL.Position.Y or extents.Y * 0.4,
		HipZ = joints.LegBL and joints.LegBL.Position.Z or extents.Z * 0.3,
	}
	return true
end

local function destroyRig(pet: Pet)
	if pet.Model then
		pet.Model:Destroy()
	end
	pet.Model = nil
	pet.Rig = nil
	pet.Visible = false
end

-- Articulations d'une allure / d'une pose (repère du modèle : devant -Z ;
-- Rx(+) lève l'avant / avance une patte ; Ry(+) tourne vers la gauche)
local function animate(pet: Pet, s: any, t: number): (CFrame, { [string]: CFrame }, boolean)
	local info = pet.Info
	local rig = pet.Rig
	local gait = info.Gait
	local h = rig.Height
	local rot: { [string]: CFrame } = {}
	local phase = (s.Dist / math.max(0.1, info.Stride)) * math.pi * 2
	local move = s.Move
	local seed = pet.Seed % 1000
	local rootOff = CFrame.identity
	local eyesClosed = false
	local w = s.W
	local poseName = s.Pose
	-- tête qui regarde autour (au repos)
	local lookYaw = math.sin(t * 0.55 + seed) * 0.45 + math.sin(t * 1.3 + seed * 2) * 0.15
	local lookPitch = math.sin(t * 0.8 + seed) * 0.08
	if gait == "Quad" or gait == "Scurry" or gait == "Crawl" or gait == "Hop" then
		local amp = (gait == "Scurry" and 0.75 or (gait == "Crawl" and 0.45 or 0.55)) * move
		local a = math.sin(phase) * amp
		if gait == "Hop" then
			local up = math.max(0, math.sin(phase))
			rootOff = CFrame.new(0, up * h * 0.28 * move, 0) * CFrame.Angles(math.cos(phase) * 0.18 * move, 0, 0)
			rot.LegBL = CFrame.Angles(-0.7 * up * move, 0, 0)
			rot.LegBR = rot.LegBL
			rot.LegFL = CFrame.Angles(0.5 * math.sin(phase) * move, 0, 0)
			rot.LegFR = rot.LegFL
		else
			rot.LegFL = CFrame.Angles(a, 0, 0)
			rot.LegBR = CFrame.Angles(a, 0, 0)
			rot.LegFR = CFrame.Angles(-a, 0, 0)
			rot.LegBL = CFrame.Angles(-a, 0, 0)
			rootOff = CFrame.new(0, math.abs(math.sin(phase)) * h * 0.025 * move, 0)
		end
		local headPitch = math.sin(phase * 2) * 0.05 * move
		local headYaw = lookYaw * (1 - move)
		-- queue
		if info.Cat then
			rot.Tail = CFrame.Angles(0.25 + math.sin(t * 1.1 + seed) * 0.1, math.sin(t * 1.6 + seed) * 0.35, 0)
		elseif info.Wag then
			rot.Tail = CFrame.Angles(0.15, math.sin(t * info.Wag + seed) * 0.45, 0)
		else
			rot.Tail = CFrame.Angles(0, math.sin(t * 2 + seed) * 0.15, 0)
		end
		-- poses
		if poseName == "Sit" then
			local hip = CFrame.new(0, rig.HipY, rig.HipZ)
			rootOff = rootOff:Lerp(CFrame.new(0, -rig.HipY * 0.45, 0) * hip * CFrame.Angles(0.5, 0, 0) * hip:Inverse(), w)
			rot.LegBL = (rot.LegBL :: CFrame):Lerp(CFrame.Angles(1.25, 0, 0), w)
			rot.LegBR = rot.LegBL
			rot.LegFL = (rot.LegFL :: CFrame):Lerp(CFrame.Angles(-0.45, 0, 0), w)
			rot.LegFR = rot.LegFL
			headPitch -= 0.35 * w
		elseif poseName == "Sleep" then
			rootOff = rootOff:Lerp(CFrame.new(0, -rig.HipY * 0.82, 0), w)
			rot.LegFL = (rot.LegFL :: CFrame):Lerp(CFrame.Angles(1.35, 0.25, 0), w)
			rot.LegFR = (rot.LegFR :: CFrame):Lerp(CFrame.Angles(1.35, -0.25, 0), w)
			rot.LegBL = (rot.LegBL :: CFrame):Lerp(CFrame.Angles(-1.3, 0, 0), w)
			rot.LegBR = (rot.LegBR :: CFrame):Lerp(CFrame.Angles(-1.3, 0, 0), w)
			rot.Tail = (rot.Tail :: CFrame):Lerp(CFrame.Angles(-0.2, 1.1, 0), w)
			headPitch = headPitch * (1 - w) - 0.45 * w + math.sin(t * 1.2) * 0.02 * w
			headYaw = headYaw * (1 - w) + 0.5 * w
			eyesClosed = w > 0.5
		elseif poseName == "Sniff" or poseName == "Peck" then
			headPitch -= (0.5 + math.sin(t * 11) * 0.06) * w
			headYaw *= 0.4
		elseif poseName == "Groom" then
			headPitch -= 0.3 * w
			headYaw = headYaw * (1 - w) + (0.9 + math.sin(t * 6) * 0.1) * w
		end
		rot.Head = CFrame.Angles(headPitch + lookPitch * (1 - move), headYaw, 0)
		if info.Wings then
			local open = poseName == "Flap" and w or 0
			local flap = math.sin(t * 9) * 0.5 * open
			rot.WingL = CFrame.Angles(0, 0, -(0.1 + 0.6 * open + flap))
			rot.WingR = CFrame.Angles(0, 0, 0.1 + 0.6 * open + flap)
		end
	else
		-- oiseaux : dandinement, pas alternés, ailes
		local roll = (gait == "Waddle" and 0.2 or 0.1) * math.sin(phase) * move
		local legA = math.sin(phase) * 0.6 * move
		rot.LegL = CFrame.Angles(legA, 0, 0)
		rot.LegR = CFrame.Angles(-legA, 0, 0)
		local wingOpen = gait == "Waddle" and 0.35 * move or 0.05
		local flap = 0
		if gait == "Owl" and s.Fly > 0.01 then
			flap = 0.5 + math.sin(t * 14) * 0.9
			rot.LegL = CFrame.Angles(0.9, 0, 0)
			rot.LegR = rot.LegL
		elseif poseName == "Flap" then
			flap = (0.4 + math.sin(t * 16) * 0.6) * w
		end
		rot.WingL = CFrame.Angles(0, 0, -(wingOpen + flap))
		rot.WingR = CFrame.Angles(0, 0, wingOpen + flap)
		rootOff = CFrame.new(0, s.Fly + math.abs(math.sin(phase)) * h * 0.03 * move, 0) * CFrame.Angles(0, 0, roll)
		local headPitch = math.sin(phase * 2) * 0.12 * move
		local headYaw = lookYaw * (1 - move)
		if gait == "Owl" then
			headYaw = math.sin(t * 0.35 + seed) * 1.6 * (1 - move)
		end
		if poseName == "Peck" or poseName == "Sniff" then
			headPitch -= (0.55 + math.max(0, math.sin(t * 7)) * 0.35) * w
		elseif poseName == "Sleep" then
			rootOff = rootOff:Lerp(CFrame.new(0, -h * 0.12, 0), w)
			headPitch -= 0.4 * w
			eyesClosed = w > 0.5
		elseif poseName == "Sit" then
			rootOff = rootOff:Lerp(CFrame.new(0, -h * 0.08, 0), w)
		end
		rot.Head = CFrame.Angles(headPitch, headYaw, 0)
	end
	-- clignement des yeux (toutes les ~4 s)
	if not eyesClosed and ((t + seed) % 4.2) < 0.12 then
		eyesClosed = true
	end
	return rootOff, rot, eyesClosed
end

local function place(pet: Pet, s: any, t: number)
	local rig = pet.Rig
	if not rig then
		return
	end
	local house = pet.House
	local base = house.HouseCF * Vector3.new(s.X, s.Y, -s.D)
	-- cap : yaw (repère maison) -> monde
	local heading = house.HouseCF:VectorToWorldSpace(Vector3.new(-math.sin(s.Yaw), 0, -math.cos(s.Yaw)))
	local ground = CFrame.lookAt(base, base + heading)
	if pet.Perch and pet.PerchCF then
		ground = pet.PerchCF
		base = ground.Position
	end
	local rootOff, rot, eyesClosed = animate(pet, s, t)
	local modelCF = ground * rootOff
	local cfs = rig.CFrames
	local jointCF: { [string]: CFrame } = {}
	for name, rest in pairs(rig.Joints) do
		local r = rot[name]
		jointCF[name] = if r then modelCF * rest * r else modelCF * rest
	end
	for index, part in ipairs(rig.Parts) do
		local cf = jointCF[rig.Joint[index]] * rig.Rel[index]
		if eyesClosed and rig.Eye[index] then
			cf = cf * CFrame.new(0, 0, part.Size.Z * 0.9)
		end
		cfs[index] = cf
	end
	local ok = pcall(function()
		workspace:BulkMoveTo(rig.Parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
	end)
	if not ok then
		for index, part in ipairs(rig.Parts) do
			part.CFrame = cfs[index]
		end
	end
	pet.Pos = base
end

----------------------------------------------------------------------
-- Originaux (modèles posés dans les pièces) : cachés / rendus
----------------------------------------------------------------------

local function findOriginal(pet: Pet): Model?
	local house = pet.House
	local state = house.Rooms and house.Rooms[pet.Slot]
	if not state or state.State ~= "Built" then
		return nil
	end
	for _, model in ipairs(state.Items or {}) do
		if model.Parent and tonumber(model:GetAttribute("EntryIndex")) == pet.EntryIndex and model:GetAttribute("ItemId") == pet.ItemId then
			return model
		end
	end
	return nil
end

local function restoreOriginal(pet: Pet)
	for part, transparency in pairs(pet.Hidden) do
		if part.Parent then
			part.Transparency = transparency
		end
	end
	table.clear(pet.Hidden)
	pet.Original = nil
end

local function hideOriginal(pet: Pet)
	local original = findOriginal(pet)
	if original ~= pet.Original then
		restoreOriginal(pet)
		pet.Original = original
		if original and pet.Perch then
			pet.PerchCF = original:GetPivot()
		end
		if original then
			for _, d in ipairs(original:GetDescendants()) do
				if d:IsA("BasePart") and d.Transparency < 1 then
					pet.Hidden[d] = d.Transparency
					d.Transparency = 1
				end
			end
		end
	end
end

----------------------------------------------------------------------
-- Inventaire des animaux (instantanés des maisons)
----------------------------------------------------------------------

local function houses(): { [any]: any }
	local fn = ctx.GetHouses
	if type(fn) ~= "function" then
		return {}
	end
	local ok, result = pcall(fn)
	return ok and type(result) == "table" and result or {}
end

local function removePet(key: string)
	local pet = pets[key]
	if not pet then
		return
	end
	restoreOriginal(pet)
	destroyRig(pet)
	pets[key] = nil
end

local function refresh()
	local seen = {}
	for userId, house in pairs(houses()) do
		local snapshot = type(house) == "table" and house.Snapshot or nil
		if snapshot and house.HouseCF and not house.Destroyed then
			local size = sizeOf(house)
			local nav = nil
			for _, roomData in ipairs(snapshot.Rooms or {}) do
				local slot = tonumber(roomData.Slot)
				for index, entry in ipairs(type(roomData.Placed) == "table" and roomData.Placed or {}) do
					local info = type(entry) == "table" and SPECIES[entry.I] or nil
					if info and slot then
						local key = string.format("%s|%s|%d|%s|%.3f|%.3f|%.2f|%s", tostring(userId), tostring(roomData.Id), index, entry.I, tonumber(entry.X) or 0.5,
							tonumber(entry.Y) or 0.8, tonumber(entry.S) or 1, tostring(entry.F))
						seen[key] = true
						nav = nav or navFor(house)
						local pet = pets[key]
						if pet and pet.Nav ~= nav then
							-- (meubles / jardin changés : chemins recalculés)
							pet.Nav = nav
							pet.Plan = nil
							pet.PlanCycle = -1
							pet.Routes = nil
						end
						if not pet then
							local room = roomOf(nav, house, slot)
							local dims = WorldLayout.RoomDims(size, Config.House.WallRatio)
							local item = Config.HouseItemsById[entry.I]
							local s = math.clamp(tonumber(entry.S) or 1, 0.2, 3)
							local box = (tonumber(item and item.Size) or 60) * s * WorldLayout.PX
							local okHome, rx, rz = pcall(WorldLayout.FloorForward, dims, tonumber(entry.X) or 0.5, tonumber(entry.Y) or 0.8, box * 0.45, box * 0.9, false)
							local x0, x1, yFloor, _, d1 = WorldLayout.RoomInterior(size, slot)
							local hx, hd = (x0 + x1) / 2 + (okHome and rx or 0), d1 - (okHome and rz or 12)
							hx = math.clamp(hx, room.X0 + 0.2, room.X1 - 0.2)
							hd = math.clamp(hd, room.D0 + 0.2, room.D1 - 0.2)
							-- (sa place doit être libre : sinon la case libre la plus proche)
							if not freeAt(room, hx, hd) then
								local best, bestD = nil, math.huge
								for i = 0, room.NX - 1 do
									for j = 0, room.ND - 1 do
										if isFree(room, i, j) then
											local cx, cd = cellCenter(room, i, j)
											local dist = (cx - hx) ^ 2 + (cd - hd) ^ 2
											if dist < bestD then
												best, bestD = { cx, cd }, dist
											end
										end
									end
								end
								if best then
									hx, hd = best[1], best[2]
								end
							end
							pet = {
								Key = key,
								House = house,
								UserId = tonumber(userId) or 0,
								ItemId = entry.I,
								Entry = entry,
								EntryIndex = index,
								Slot = slot,
								Info = info,
								Seed = hash(key),
								Home = Vector3.new(hx, yFloor, hd),
								HomeYaw = math.pi, -- (regarde la rue, comme dans la pièce)
								Nav = nav,
								PlanCycle = -1,
								Visible = false,
								Hidden = {},
								Perch = onFurniture(entry, roomData.Placed, size),
							} :: any
							pets[key] = pet
						end
						local p = pet :: any
						if p and p.Routes == nil and not p.Perch then
							p.Routes = {}
							local okF, front = pcall(exitRoute, p, nav, false)
							p.Routes.Front = okF and front or nil
							local okB, back = pcall(exitRoute, p, nav, true)
							p.Routes.Back = okB and back or nil
						end
					end
				end
			end
		end
	end
	for key in pairs(pets) do
		if not seen[key] then
			removePet(key)
		end
	end
	-- maisons disparues : caches oubliés
	local alive = houses()
	for house in pairs(navCache) do
		local found = false
		for _, h in pairs(alive) do
			if h == house then
				found = true
				break
			end
		end
		if not found then
			navCache[house] = nil
		end
	end
end

----------------------------------------------------------------------
-- Boucle
----------------------------------------------------------------------

local function focus(): Vector3?
	local camera = workspace.CurrentCamera
	return camera and camera.CFrame.Position or nil
end

-- Le double est-il visible à cet endroit ? (dehors, cage, pièce construite)
local function visibleAt(pet: Pet, s: any): boolean
	if s.Hidden or (pet.Perch and not pet.PerchCF) then
		return false
	end
	local slot = WorldLayout.SlotAt(sizeOf(pet.House), s.X, s.Y + 1, s.D)
	if not slot then
		return true
	end
	local state = pet.House.Rooms and pet.House.Rooms[slot]
	return state ~= nil and state.State == "Built"
end

local function select(now: number)
	local cam = focus()
	local list = {}
	for _, pet in pairs(pets) do
		local s = sample(pet, now)
		local world = pet.House.HouseCF * Vector3.new(s.X, s.Y, -s.D)
		local dist = cam and (world - cam).Magnitude or math.huge
		pet.Pos = world
		table.insert(list, { Pet = pet, Dist = dist })
	end
	table.sort(list, function(a, b)
		return a.Dist < b.Dist
	end)
	table.clear(active)
	local built = 0
	for index, rec in ipairs(list) do
		local pet = rec.Pet
		if not paused and index <= MAX_ANIMATED and rec.Dist < RANGE then
			if not pet.Model and built < 1 then
				built += 1
				local ok, result = pcall(buildRig, pet)
				if not ok then
					warn("[PetRoam] " .. tostring(pet.ItemId) .. " : " .. tostring(result))
				end
			end
			if pet.Model then
				table.insert(active, pet)
				hideOriginal(pet)
			end
		else
			restoreOriginal(pet)
			if pet.Model and (paused or rec.Dist > FAR or index > MAX_ANIMATED) then
				destroyRig(pet)
			elseif pet.Model then
				pet.Model.Parent = nil
				pet.Visible = false
			end
		end
	end
end

function PetRoam.Start(context: any?)
	ctx = type(context) == "table" and context or {}
	started = true
	paused = false
	clock, refreshClock, selectClock = 0, 999, 999
	if not folder or not folder.Parent then
		local f = Instance.new("Folder")
		f.Name = "RoamingPets"
		f.Parent = workspace
		folder = f
	end
end

function PetRoam.Step(dt: number?)
	if not started then
		return
	end
	local step = dt or HZ
	refreshClock += step
	selectClock += step
	clock += step
	if refreshClock >= 1 then
		refreshClock = 0
		local ok, err = pcall(refresh)
		if not ok then
			warn("[PetRoam] " .. tostring(err))
		end
	end
	local now = serverNow()
	if selectClock >= 0.5 then
		selectClock = 0
		local ok, err = pcall(select, now)
		if not ok then
			warn("[PetRoam] " .. tostring(err))
		end
	end
	if clock < HZ or paused then
		return
	end
	clock = 0
	for _, pet in ipairs(active) do
		local model = pet.Model
		if model and pet.Rig then
			local ok, s = pcall(sample, pet, now)
			if ok then
				local show = visibleAt(pet, s)
				if show then
					place(pet, s, now)
					if not pet.Visible then
						model.Parent = folder
						pet.Visible = true
					end
				elseif pet.Visible then
					model.Parent = nil
					pet.Visible = false
				end
			end
		end
	end
end

function PetRoam.SetPaused(value: boolean)
	-- (appelable à chaque image : ne fait rien si rien ne change)
	if (value == true) == paused then
		return
	end
	paused = value == true
	if paused then
		for _, pet in pairs(pets) do
			restoreOriginal(pet)
			destroyRig(pet)
		end
		table.clear(active)
	else
		selectClock = 999
	end
end

function PetRoam.Stop()
	for key in pairs(pets) do
		removePet(key)
	end
	table.clear(pets)
	table.clear(active)
	table.clear(navCache)
	started = false
	if folder then
		folder:Destroy()
		folder = nil
	end
end

-- (tests) état interne
function PetRoam.Debug(): any
	return { Pets = pets, Active = active, Sample = sample, Plan = planCycle, Nav = navFor, Route = exitRoute, Visible = visibleAt, Refresh = refresh,
		FindPath = findPath, FreeAt = freeAt, RoomOf = roomOf }
end

return PetRoam
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="219">
          <Properties>
            <string name="Name">RaceClient</string>
            <string name="Source"><![CDATA[--[[
	RaceClient (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > RaceClient

	🏁 Courses de rue, côté client (v10, RACE10). Le serveur (RaceService)
	décide de tout ; ici on MONTRE :
	  - le QG des courses (zone "RaceMeet") en flux : stand, comptoir avec
	    invite E "Courses de rue" (ouvre le menu), tableau des records mis à
	    jour en direct (meilleurs tours du serveur, par parcours) ;
	  - les portiques de départ (feux synchronisés sur l'heure du serveur :
	    5 rouges qui s'allument, puis VERT au GO), cases de grille, arche
	    d'arrivée du sprint, en flux (< 420 studs) ;
	  - les PILOTES IA : voiture CarModels ("Mid" + conducteur NPCModels de
	    près, "Low" plus loin, rien au-delà de 700 studs), roues qui tournent
	    et braquent, caisse qui s'incline, position lissée entre deux
	    instantanés du serveur (5 fois / s) ; boîte de collision SOLIDE
	    (groupe "DopamineCars", étiquette "DopamineMover" + ClientMover pour
	    PHYS10) : on ne traverse pas une IA ;
	  - SA course : arches des 3 prochaines portes (la prochaine brille),
	    HUD (place, tour, chrono, écart, meilleur tour, flèche + distance de
	    la porte, mini-carte), 3-2-1-GO, "mauvais sens", porte franchie,
	    touche F / bouton 🔄 = retour à la dernière porte, 🏳️ abandon ;
	    course de NUIT : la ville passe en nuit pendant la course ;
	  - RÉSULTATS : podium animé + récompense (RaceHud).
	Aucune lumière réelle, aucun son.

	Crochets TownClient (via optionalModule, comme FairFx / MusicStage) :
	  RaceClient.Start({ Toast = toast })  à l'entrée en ville
	  RaceClient.Step(dt)                   chaque image
	  RaceClient.Stop()                     à la sortie
	  RaceClient.Debug() -> table (tests)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local CollectionService = game:GetService("CollectionService")

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local Locale = require(ReplicatedStorage.Shared.Locale)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local WorldLayout = require(ReplicatedStorage.Shared.WorldLayout)
local CarModels = require(ReplicatedStorage.Shared.CarModels)
local NPCModels = require(ReplicatedStorage.Shared.NPCModels)
local RaceRules = require(ReplicatedStorage.Shared.RaceRules)
local RaceRoutes = require(ReplicatedStorage.Shared.RaceRoutes)
local RaceProps = require(script.Parent.RaceProps)
local RaceHud = require(script.Parent.RaceHud)

local LocalPlayer = Players.LocalPlayer

local RaceClient = {}

RaceClient.FOLDER_NAME = "RaceClient"
RaceClient.HQ_IN, RaceClient.HQ_OUT = 450, 520
RaceClient.GANTRY_IN, RaceClient.GANTRY_OUT = 420, 500
RaceClient.AI_MID, RaceClient.AI_FAR = 170, 700
RaceClient.MOVER_TAG = "DopamineMover"
RaceClient.CAR_GROUP = "DopamineCars"

type AICar = {
	Key: string,
	Kind: string,
	Model: Model?,
	Lod: number, -- 2 = Mid (+ pilote), 1 = Low, 0 = rien
	Rig: any?,
	Extra: { BasePart },
	ExtraOff: { CFrame },
	D: number,
	V: number,
	Lane: number,
	Spin: number,
	Steer: number,
	Heading: Vector3?,
	Pitch: number,
	Roll: number,
	Seen: number,
	Name: string,
	Color: string,
	Seed: number,
}

type RaceView = {
	Snap: any,
	At: number, -- heure (client) de réception
	ServerAt: number,
	Route: any,
	Ai: { [string]: AICar },
}

local started = false
local folder: Folder? = nil
local opts: { [string]: any } = {}
local conns: { RBXScriptConnection } = {}
local count = 4
local lobbies: { [string]: any } = {}
local board: { [string]: any } = {}
local me: { [string]: any } = { Rewarded = 0, Daily = 8, Best = {} }
local views: { [string]: RaceView } = {}
local hq: { Model: Model?, Parts: any?, Prompt: ProximityPrompt? } = {}
local gantries: { [string]: { Model: Model, Lights: any, Finish: Model? } } = {}
local joined: { Route: string?, RaceId: number? } = {}
local mine: { [string]: any } = {} -- ma course (HUD local)
local gates: { [number]: Model } = {}
local streamClock = 0
local hudClock = 0
local menuClock = 0
local lastCountdown: string? = nil
local nightForced = false
local boardDirty = true
local previews: { [string]: { { number } } } = {}
local resultsShownFor: number? = nil

----------------------------------------------------------------------
-- Outils
----------------------------------------------------------------------

local function T(text: string, ...): string
	return Locale.T(text, ...)
end

local function now(): number
	local ok, t = pcall(function()
		return workspace:GetServerTimeNow()
	end)
	if ok and type(t) == "number" then
		return t
	end
	return os.clock()
end

local function toast(text: string?)
	if text and text ~= "" and type(opts.Toast) == "function" then
		pcall(opts.Toast, text)
	end
end

local function send(kind: string, arg: any?)
	pcall(function()
		Net.Event("RaceEvent"):FireServer(kind, arg)
	end)
end

local function routeOf(id: string): any?
	return RaceRoutes.Get(id, count)
end

local function rootPart(): BasePart?
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

-- Ma voiture (si je conduis) : racine de la voiture
local function myCarRoot(): BasePart?
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local seat = humanoid and humanoid.SeatPart
	if seat and seat:IsA("VehicleSeat") then
		local model = seat:FindFirstAncestorOfClass("Model")
		local root = model and (model.PrimaryPart or model:FindFirstChild("Root"))
		if root and root:IsA("BasePart") then
			return root
		end
	end
	return nil
end

local function isDriving(): boolean
	return myCarRoot() ~= nil
end

local function focus(): Vector3?
	local car = myCarRoot()
	if car then
		return car.Position
	end
	local root = rootPart()
	if root then
		return root.Position
	end
	local camera = workspace.CurrentCamera
	return camera and camera.CFrame.Position or nil
end

local function lineS(route: any, d: number): number
	if route.Closed then
		return d % route.Total
	end
	return route.StartS + d
end

----------------------------------------------------------------------
-- QG des courses : tableau des records
----------------------------------------------------------------------

local function fillBoard()
	local parts = hq.Parts
	if not parts or not parts.BoardGui then
		return
	end
	local sg: SurfaceGui = parts.BoardGui
	for _, child in ipairs(sg:GetChildren()) do
		child:Destroy()
	end
	local bg = Instance.new("Frame")
	bg.Name = "Bg"
	bg.BorderSizePixel = 0
	bg.BackgroundColor3 = Color3.fromRGB(22, 20, 38)
	bg.Size = UDim2.fromScale(1, 1)
	bg.Parent = sg
	-- (tailles fixes : toile de 32 px / stud, ~640 x 350 px)
	local function text(parent: Instance, value: string, x: number, y: number, w: number, h: number, color: Color3, font: Enum.Font?, align: Enum.TextXAlignment?, size: number?): TextLabel
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Text = value
		l.TextSize = size or 18
		l.TextTruncate = Enum.TextTruncate.AtEnd
		l.Font = font or Enum.Font.GothamBold
		l.TextColor3 = color
		l.TextXAlignment = align or Enum.TextXAlignment.Left
		l.Position = UDim2.fromScale(x, y)
		l.Size = UDim2.fromScale(w, h)
		l.Parent = parent
		return l
	end
	text(bg, T("🏆 Best laps on this server"), 0.03, 0.02, 0.94, 0.12, Color3.fromRGB(255, 214, 90), Enum.Font.GothamBlack, Enum.TextXAlignment.Center, 30)
	local list = (Config.Race and Config.Race.Routes) or {}
	for k, def in ipairs(list) do
		local col = (k - 1) % 2
		local row = (k - 1) // 2
		local x0 = 0.03 + col * 0.49
		local y0 = 0.17 + row * 0.41
		local card = Instance.new("Frame")
		card.Name = "Route_" .. def.Id
		card.BorderSizePixel = 0
		card.BackgroundColor3 = Color3.fromRGB(40, 34, 62)
		card.Position = UDim2.fromScale(x0, y0)
		card.Size = UDim2.fromScale(0.46, 0.38)
		card.Parent = bg
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 12)
		corner.Parent = card
		text(card, def.Icon .. " " .. T(def.Name), 0.05, 0.03, 0.9, 0.24, Color3.fromRGB(255, 255, 255), Enum.Font.GothamBlack, nil, 20)
		local rows = board[def.Id] or {}
		for i = 1, 3 do
			local r = rows[i]
			local medal = ({ "🥇", "🥈", "🥉" })[i]
			local y = 0.3 + (i - 1) * 0.22
			if r then
				text(card, medal .. " " .. tostring(r.Name), 0.05, y, 0.58, 0.2, Color3.fromRGB(236, 226, 255), nil, nil, 17)
				text(card, RaceRules.FormatTime(r.Time), 0.62, y, 0.34, 0.2, Color3.fromRGB(130, 236, 190), Enum.Font.GothamBold, Enum.TextXAlignment.Right, 17)
			elseif i == 1 then
				text(card, T("No record yet: be the first!"), 0.05, y, 0.9, 0.2, Color3.fromRGB(190, 176, 214), Enum.Font.Gotham, nil, 15)
			end
		end
	end
	-- état des salles d'attente (écran du comptoir)
	local screen = parts.Screen
	if screen then
		local label = screen:FindFirstChild("T")
		if label and label:IsA("TextLabel") then
			local waiting = 0
			for _, lobby in pairs(lobbies) do
				if lobby.Phase == "Lobby" then
					waiting += lobby.Count or 0
				end
			end
			label.Text = if waiting > 0 then T("🏁 %d waiting!", waiting) else "🏁 3 · 2 · 1 · GO"
		end
	end
end

----------------------------------------------------------------------
-- Menu
----------------------------------------------------------------------

local function statusOf(id: string): (string, Color3, boolean)
	local lobby = lobbies[id]
	if not lobby then
		return T("Open: start a race!"), Color3.fromRGB(130, 236, 190), true
	end
	if lobby.Phase == "Lobby" then
		local left = math.max(0, math.ceil((lobby.EndsAt or 0) - now()))
		return T("%d waiting · starts in %d s", lobby.Count or 0, left), Color3.fromRGB(255, 214, 90), true
	elseif lobby.Phase == "Results" then
		return T("Finishing…"), Color3.fromRGB(214, 196, 236), false
	end
	return T("Race in progress…"), Color3.fromRGB(255, 140, 150), false
end

local function preview(route: any): { { number } }
	local key = route.Id
	if previews[key] then
		return previews[key]
	end
	local line = route.Line
	local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
	for i = 1, line.N do
		minX, maxX = math.min(minX, line.X[i]), math.max(maxX, line.X[i])
		minZ, maxZ = math.min(minZ, line.Z[i]), math.max(maxZ, line.Z[i])
	end
	local span = math.max(maxX - minX, maxZ - minZ, 1)
	local cx, cz = (minX + maxX) / 2, (minZ + maxZ) / 2
	local pts = {}
	local n = math.clamp(math.floor(line.N / 8), 12, 90)
	for k = 0, n - 1 do
		local x, z = RaceRules.PointAt(line, line.Total * k / n)
		table.insert(pts, { 0.5 + (x - cx) / span, 0.5 + (z - cz) / span })
	end
	if not route.Closed then
		local x, z = RaceRules.PointAt(line, line.Total)
		table.insert(pts, { 0.5 + (x - cx) / span, 0.5 + (z - cz) / span })
	end
	previews[key] = pts
	route.MiniBox = { cx, cz, span }
	return pts
end

local function nearHQ(): boolean
	local p = rootPart()
	if not p then
		return false
	end
	local meet = RaceRoutes.MeetCFrame(count).Position
	local flat = Vector3.new(p.Position.X - meet.X, 0, p.Position.Z - meet.Z)
	return flat.Magnitude <= ((Config.Race and Config.Race.JoinRange) or 45) - 2
end

local function refreshMenu()
	if not RaceHud.IsMenuOpen() then
		return
	end
	local cards = {}
	local can = nearHQ() or isDriving()
	for _, def in ipairs((Config.Race and Config.Race.Routes) or {}) do
		local route = routeOf(def.Id)
		if route then
			local status, color, open = statusOf(def.Id)
			local km = route.RaceDistance * 0.28 / 1000
			local rows = board[def.Id] or {}
			local rec = rows[1]
			local myBest = me.Best and me.Best[def.Id]
			local lapsText = if route.Closed and route.Laps > 1 then T("%d laps", route.Laps) elseif route.Closed then T("1 lap") else T("Sprint")
			local isMine = joined.Route == def.Id
			table.insert(cards, {
				Id = def.Id,
				Icon = def.Icon,
				Name = T(def.Name),
				Info = string.format("%s · %.1f km\n%s", lapsText, km, T(def.Desc or "")),
				Record = if rec then string.format("🏆 %s %s", tostring(rec.Name), RaceRules.FormatTime(rec.Time)) else T("🏆 No record yet"),
				Best = if myBest then T("⏱️ Your best: %s", RaceRules.FormatTime(myBest)) else "",
				Status = if isMine then T("✅ You are signed up!") else status,
				StatusColor = if isMine then Color3.fromRGB(130, 236, 190) else color,
				CanJoin = open and (can or isMine),
				Joined = isMine,
				Preview = preview(route),
				PreviewKey = route.Id .. ":" .. count,
				Closed = route.Closed,
			})
		end
	end
	local r = Config.Race and Config.Race.Rewards or {}
	local secs = r.Seconds or { 120, 80, 55 }
	RaceHud.SetMenu(true, cards, {
		Sub = T("Win Dopamine: 🥇 %d s · 🥈 %d s · 🥉 %d s of production · rewarded today: %d/%d", secs[1], secs[2], secs[3], me.Rewarded or 0, me.Daily or 8),
		Foot = if can then T("AI racers fill the grid. Pass every checkpoint in order, stay on the road. F or 🔄 = back to the last checkpoint.")
			else T("Sign up at the 🏁 Race HQ (on foot, E) or from your car."),
	})
end

local function openMenu(open: boolean)
	if open then
		RaceHud.SetMenu(true, {}, nil)
		refreshMenu()
		send("sync")
	else
		RaceHud.SetMenu(false)
	end
end

----------------------------------------------------------------------
-- Décor en flux : QG + portiques
----------------------------------------------------------------------

local function destroyHQ()
	if hq.Model then
		hq.Model:Destroy()
	end
	hq.Model, hq.Parts, hq.Prompt = nil, nil, nil
end

local function buildHQ()
	local f = folder
	if not f then
		return
	end
	local zoneW, zoneD = 64, 44
	local okZone, zone = pcall(function()
		return (WorldLayout :: any).Facility(count, "RaceMeet")
	end)
	if okZone and type(zone) == "table" then
		zoneW, zoneD = tonumber(zone.W) or zoneW, tonumber(zone.D) or zoneD
	end
	local cf = RaceRoutes.MeetCFrame(count)
	local model, parts = RaceProps.BuildHQ(cf, zoneW, zoneD)
	model.Parent = f
	hq.Model, hq.Parts = model, parts
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "RacePrompt"
	prompt.ActionText = T("Street races")
	prompt.ObjectText = T("🏁 Race HQ")
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = parts.Prompt
	prompt.Triggered:Connect(function()
		openMenu(true)
	end)
	hq.Prompt = prompt
	fillBoard()
end

local function buildGantry(route: any): { Model: Model, Lights: any, Finish: Model? }
	local f = folder :: Folder
	local cf = RaceRoutes.CFrameAtD(route, 0)
	local model, info = RaceProps.BuildGantry(cf, math.max(route.Width, 16) + 2, route.Def.Icon .. " " .. T(route.Def.Name), false)
	local cfs = {}
	for slot = 1, #route.Grid do
		table.insert(cfs, RaceRoutes.GridCFrame(route, slot))
	end
	RaceProps.GridMarks(model, cfs)
	model.Parent = f
	local finishModel = nil
	if not route.Closed then
		local fcf = RaceRoutes.CFrameAtD(route, route.RaceDistance)
		local fm = RaceProps.BuildGantry(fcf, math.max(route.Width, 16) + 2, "", true)
		fm.Parent = f
		finishModel = fm
	end
	RaceProps.SetLights(info.Lights, 0)
	return { Model = model, Lights = info.Lights, Finish = finishModel }
end

local function stream()
	local p = focus()
	if not p or not folder then
		return
	end
	-- QG
	local meet = RaceRoutes.MeetCFrame(count).Position
	local dHQ = (Vector3.new(p.X, 0, p.Z) - Vector3.new(meet.X, 0, meet.Z)).Magnitude
	if not hq.Model and dHQ < RaceClient.HQ_IN then
		local ok, err = pcall(buildHQ)
		if not ok then
			warn("[RaceClient] QG : " .. tostring(err))
			destroyHQ()
		end
	elseif hq.Model and dHQ > RaceClient.HQ_OUT then
		destroyHQ()
	end
	-- portiques (départ ; arrivée du sprint)
	for _, def in ipairs((Config.Race and Config.Race.Routes) or {}) do
		local route = routeOf(def.Id)
		if route then
			local start = RaceRoutes.CFrameAtD(route, 0).Position
			local d = (Vector3.new(p.X, 0, p.Z) - Vector3.new(start.X, 0, start.Z)).Magnitude
			if not route.Closed then
				local fin = RaceRoutes.CFrameAtD(route, route.RaceDistance).Position
				d = math.min(d, (Vector3.new(p.X, 0, p.Z) - Vector3.new(fin.X, 0, fin.Z)).Magnitude)
			end
			local g = gantries[def.Id]
			if not g and d < RaceClient.GANTRY_IN then
				local ok, result = pcall(buildGantry, route)
				if ok then
					gantries[def.Id] = result
				else
					warn("[RaceClient] Portique : " .. tostring(result))
				end
			elseif g and d > RaceClient.GANTRY_OUT then
				g.Model:Destroy()
				if g.Finish then
					g.Finish:Destroy()
				end
				gantries[def.Id] = nil
			end
		end
	end
	if boardDirty and hq.Model then
		boardDirty = false
		pcall(fillBoard)
	end
end

----------------------------------------------------------------------
-- Pilotes IA
----------------------------------------------------------------------

local function destroyAI(ai: AICar)
	if ai.Model then
		ai.Model:Destroy()
	end
	ai.Model = nil
	ai.Rig = nil
	ai.Lod = 0
	table.clear(ai.Extra)
	table.clear(ai.ExtraOff)
end

local function buildAI(ai: AICar, lod: number)
	destroyAI(ai)
	local detail = if lod >= 2 then "Mid" else "Low"
	local model = CarModels.Build(ai.Kind, ai.Color ~= "" and ai.Color or nil, { Detail = detail, Plate = "RACE" })
	model.Name = "RaceAI_" .. ai.Key
	-- boîte de collision solide (la voiture du joueur rebondit dessus)
	local root = model.PrimaryPart
	if root then
		root.CanCollide = true
		root.CanQuery = true
		pcall(function()
			root.CollisionGroup = RaceClient.CAR_GROUP
		end)
	end
	model:SetAttribute("ClientMover", true)
	model:SetAttribute("OwnerId", 0)
	pcall(CollectionService.AddTag, CollectionService, model, RaceClient.MOVER_TAG)
	model:PivotTo(CFrame.new(0, -500, 0))
	model.Parent = folder
	ai.Model = model
	ai.Lod = lod
	if lod >= 2 then
		local okRig, rig = pcall(CarModels.WheelRig, model)
		if okRig then
			ai.Rig = rig
		end
		-- pilote (casque de course : couleur de la voiture)
		local okNpc, npc = pcall(NPCModels.Build, "jogger", { Seed = ai.Seed, Solid = false, Look = false, Name = "Driver" })
		if okNpc and npc then
			local seatCF = model:GetAttribute("SeatCF")
			local seat = if typeof(seatCF) == "CFrame" then seatCF else CFrame.new(-0.9, 1.2, 0.4)
			pcall(NPCModels.SetSeated, npc, 1.05)
			local pivot = CFrame.new(0, -500, 0)
			local npcCF = pivot * seat * CFrame.new(0, -1.05, 0)
			pcall(NPCModels.Place, npc, npcCF)
			pcall(NPCModels.Animate, npc, "sit", 0)
			npc.Parent = model
			for _, d in ipairs(npc:GetDescendants()) do
				if d:IsA("BasePart") then
					d.CanCollide = false
					d.CanQuery = false
					d.CanTouch = false
					table.insert(ai.Extra, d)
					table.insert(ai.ExtraOff, pivot:ToObjectSpace(d.CFrame))
				end
			end
		end
	end
end

-- Pose d'une IA (distance de course, file) : CFrame du pivot au sol
local function aiPivot(route: any, ai: AICar, dt: number): CFrame
	local s = lineS(route, ai.D)
	local x, z, tx, tz, y = RaceRules.PointAt(route.Line, s)
	-- cap lissé (anticipe un peu : regarde 3 studs devant)
	local x2, z2 = RaceRules.PointAt(route.Line, s + 3)
	local dir = Vector3.new(x2 - x, 0, z2 - z)
	if dir.Magnitude < 1e-3 then
		dir = Vector3.new(tx, 0, tz)
	end
	dir = dir.Unit
	local prev = ai.Heading or dir
	local blend = math.clamp(dt * 10, 0, 1)
	local heading = prev:Lerp(dir, blend)
	if heading.Magnitude < 1e-3 then
		heading = dir
	end
	heading = heading.Unit
	-- braquage + roulis selon le changement de cap
	local turn = math.asin(math.clamp(prev:Cross(heading).Y, -1, 1)) / math.max(dt, 1 / 120)
	ai.Heading = heading
	ai.Steer += (math.clamp(-turn * 0.5, -0.5, 0.5) - ai.Steer) * math.clamp(dt * 6, 0, 1)
	ai.Roll += (math.clamp(turn * ai.V * 0.0025, -0.06, 0.06) - ai.Roll) * math.clamp(dt * 4, 0, 1)
	local right = Vector3.new(-heading.Z, 0, heading.X)
	local p = RaceRoutes.ToWorld(x, z, y) + right * ai.Lane
	return CFrame.lookAt(p, p + heading) * CFrame.Angles(ai.Pitch, 0, ai.Roll)
end

local function poseAI(route: any, ai: AICar, dt: number)
	local model = ai.Model
	if not model then
		return
	end
	local pivot = aiPivot(route, ai, dt)
	local radius = tonumber(model:GetAttribute("WheelRadius")) or 1
	ai.Spin = (ai.Spin + ai.V * dt / math.max(radius, 0.3)) % (math.pi * 2)
	if ai.Rig then
		local okPose, bparts, frames = pcall(CarModels.PoseRig, ai.Rig, pivot, ai.Spin, ai.Steer, nil)
		if okPose then
			local allParts = table.clone(bparts)
			local allFrames = table.clone(frames)
			for i, part in ipairs(ai.Extra) do
				table.insert(allParts, part)
				table.insert(allFrames, pivot * ai.ExtraOff[i])
			end
			workspace:BulkMoveTo(allParts, allFrames, Enum.BulkMoveMode.FireCFrameChanged)
			return
		end
	end
	model:PivotTo(pivot)
end

local function stepAI(view: RaceView, dt: number, p: Vector3?)
	local snap = view.Snap
	local route = view.Route
	local t = now()
	local seen: { [string]: boolean } = {}
	local racing = snap.Phase == "Racing"
	for _, row in ipairs(snap.Racers) do
		if row.AI then
			seen[row.K] = true
			local ai = view.Ai[row.K]
			if not ai then
				ai = {
					Key = row.K,
					Kind = tostring(row.C or "CityCar"),
					Model = nil,
					Lod = 0,
					Rig = nil,
					Extra = {},
					ExtraOff = {},
					D = row.D,
					V = row.V,
					Lane = row.L or 0,
					Spin = 0,
					Steer = 0,
					Heading = nil,
					Pitch = 0,
					Roll = 0,
					Seen = t,
					Name = tostring(row.N or ""),
					Color = tostring(row.Col or ""),
					Seed = #tostring(row.K) * 131 + (snap.Id or 1) * 17,
				}
				view.Ai[row.K] = ai
			end
			-- position visée : l'instantané + ce qui a été roulé depuis
			local age = math.clamp(t - view.ServerAt, 0, 0.6)
			local target = row.D + (if racing and not row.F then row.V * age else 0)
			local err = target - ai.D
			if math.abs(err) > 40 or not racing then
				ai.D = target
			else
				ai.D += (if racing and not row.F then row.V * dt else 0) + err * math.clamp(dt * 3, 0, 1)
			end
			local oldV = ai.V
			ai.V += ((if racing and not row.F then row.V else 0) - ai.V) * math.clamp(dt * 4, 0, 1)
			ai.Pitch += (math.clamp(-(ai.V - oldV) / math.max(dt, 1 / 120) * 0.0015, -0.03, 0.03) - ai.Pitch) * math.clamp(dt * 3, 0, 1)
			ai.Lane += ((row.L or 0) - ai.Lane) * math.clamp(dt * 3, 0, 1)
			-- niveau de détail selon la distance
			local lod = 0
			if p then
				local s = lineS(route, ai.D)
				local x, z = RaceRules.PointAt(route.Line, s)
				local world = RaceRoutes.ToWorld(x, z, 0)
				local d = (Vector3.new(world.X - p.X, 0, world.Z - p.Z)).Magnitude
				if d < RaceClient.AI_MID then
					lod = 2
				elseif d < RaceClient.AI_FAR then
					lod = 1
				end
				-- hystérésis
				if ai.Lod == 2 and lod == 1 and d < RaceClient.AI_MID + 25 then
					lod = 2
				end
			end
			if lod ~= ai.Lod then
				if lod == 0 then
					destroyAI(ai)
				else
					local ok, err2 = pcall(buildAI, ai, lod)
					if not ok then
						warn("[RaceClient] IA : " .. tostring(err2))
						destroyAI(ai)
					end
				end
			end
			if ai.Model then
				poseAI(route, ai, dt)
			end
		end
	end
	for key, ai in pairs(view.Ai) do
		if not seen[key] then
			destroyAI(ai)
			view.Ai[key] = nil
		end
	end
end

local function dropView(id: string)
	local view = views[id]
	if view then
		for _, ai in pairs(view.Ai) do
			destroyAI(ai)
		end
		views[id] = nil
	end
end

----------------------------------------------------------------------
-- Ma course : portes, HUD
----------------------------------------------------------------------

local function clearGates()
	for _, g in pairs(gates) do
		g:Destroy()
	end
	table.clear(gates)
end

local function restoreNight()
	if nightForced then
		nightForced = false
		pcall(function()
			local atmo = require(script.Parent:FindFirstChild("TownAtmosphere") :: ModuleScript) :: any
			atmo.SetNight(ClientState.IsUserDarkMode())
		end)
	end
end

local function endMyRace()
	clearGates()
	table.clear(mine)
	lastCountdown = nil
	RaceHud.SetRace(nil)
	restoreNight()
end

local function syncGates(route: any, nextIndex: number)
	local cps = route.Checkpoints
	local want: { [number]: boolean } = {}
	for k = nextIndex, math.min(#cps, nextIndex + 2) do
		want[k] = true
	end
	for k, model in pairs(gates) do
		if not want[k] then
			model:Destroy()
			gates[k] = nil
		end
	end
	for k in pairs(want) do
		local cp = cps[k]
		if not gates[k] then
			local ok, model = pcall(function()
				local _, _, _, _, y = RaceRules.PointAt(route.Line, cp.S)
				local p = RaceRoutes.ToWorld(cp.X, cp.Z, y)
				local cf = CFrame.lookAt(p, p + Vector3.new(cp.TX, 0, cp.TZ))
				local m = RaceProps.BuildArch(cf, cp.W, if cp.Finish then 0 else k)
				if cp.Finish then
					-- l'arrivée d'une boucle : c'est le portique ; l'arche marque juste la ligne
					m.Name = "RaceGate_Finish"
				end
				m.Parent = folder
				return m
			end)
			if ok and model then
				gates[k] = model
			end
		end
		if gates[k] then
			RaceProps.SetGateState(gates[k], if k == nextIndex then "next" else "later")
		end
	end
end

-- Ma progression locale (même calcul que le serveur, pour un HUD fluide)
local function localProgress(route: any): (number?, number, Vector3?)
	local car = myCarRoot()
	if not car then
		return nil, 0, nil
	end
	local o = WorldLayout.Origin()
	local x, z = car.Position.X - o.X, car.Position.Z - o.Z
	local hint = mine.S or lineS(route, mine.D or 0)
	local s, lat = RaceRules.Project(route.Line, x, z, hint, 220)
	local d = mine.D or 0
	if route.Closed then
		local delta = s - hint
		local half = route.Total / 2
		if delta > half then
			delta -= route.Total
		elseif delta < -half then
			delta += route.Total
		end
		d += delta
	else
		d = s - route.StartS
	end
	mine.S = s
	mine.D = d
	local _ = lat
	return d, car.AssemblyLinearVelocity.Magnitude, car.CFrame.LookVector
end

local function stepMine(dt: number)
	local id = joined.Route
	local view = id and views[id]
	if not id or not view or view.Snap.Id ~= joined.RaceId then
		return
	end
	local snap = view.Snap
	local route = view.Route
	if snap.Phase == "Lobby" then
		return
	end
	local myRow = nil
	for _, row in ipairs(snap.Racers) do
		if row.U == LocalPlayer.UserId and not row.AI then
			myRow = row
		end
	end
	if not myRow then
		return
	end
	local t = now()
	-- course de nuit : la ville passe en nuit
	if route.Def.Night and not nightForced then
		nightForced = true
		pcall(function()
			local atmo = require(script.Parent:FindFirstChild("TownAtmosphere") :: ModuleScript) :: any
			atmo.SetNight(true)
		end)
	end
	-- 3-2-1-GO
	local remain = (snap.GoAt or 0) - t
	local cd: string? = nil
	if remain > 0 and remain <= 3 then
		cd = tostring(math.ceil(remain))
	elseif remain <= 0 and remain > -1.2 then
		cd = "GO"
	end
	if cd and cd ~= lastCountdown then
		lastCountdown = cd
		if cd == "GO" then
			RaceHud.Countdown(T("GO!"), Color3.fromRGB(110, 255, 140))
		else
			RaceHud.Countdown(cd, Color3.fromRGB(255, 90, 90))
		end
	end
	-- progression locale
	if mine.D == nil then
		mine.D = myRow.D
		mine.S = lineS(route, myRow.D)
	end
	local running = snap.Phase == "Racing" and not myRow.F and not myRow.X
	local speed, look = 0, nil
	if running then
		local d, v, lk = localProgress(route)
		if d then
			speed, look = v, lk
			-- le serveur a remis la voiture à une porte : on se recale
			if math.abs(d - myRow.D) > 120 then
				mine.D = myRow.D
				mine.S = lineS(route, myRow.D)
			end
		end
	else
		mine.D = myRow.D
	end
	local myD = mine.D or myRow.D
	-- portes (la prochaine selon le serveur)
	local nextIndex = myRow.Nx or 1
	if mine.Next and nextIndex > mine.Next and nextIndex - 1 >= 1 then
		local cp = route.Checkpoints[nextIndex - 1]
		if cp and not cp.Finish then
			RaceHud.Flash(T("Checkpoint %d/%d ✓", nextIndex - 1, #route.Checkpoints))
		end
	end
	mine.Next = nextIndex
	if running then
		syncGates(route, nextIndex)
	else
		clearGates()
	end
	-- mauvais sens
	local wrong = false
	if running and look and speed > 6 then
		local _, _, tx, tz = RaceRules.PointAt(route.Line, lineS(route, myD))
		if look.X * tx + look.Z * tz < -0.4 then
			mine.WrongFor = (mine.WrongFor or 0) + dt
		else
			mine.WrongFor = 0
		end
		wrong = (mine.WrongFor or 0) > 1.2
	end
	hudClock += dt
	if hudClock < 1 / 15 then
		return
	end
	hudClock = 0
	-- classement (mon D local à la place du mien)
	local list = {}
	for _, row in ipairs(snap.Racers) do
		local isMe = row == myRow
		local d = if isMe then myD else (if row.AI and view.Ai[row.K] then view.Ai[row.K].D else row.D)
		table.insert(list, { Key = row.K, Row = row, Finished = row.F, FinishTime = row.T, Progress = d, Dnf = row.X, Me = isMe })
	end
	local ranked = RaceRules.Standings(list)
	local place, ahead, behind = 1, nil, nil
	for i, r in ipairs(ranked) do
		if r.Me then
			place = i
			ahead = ranked[i - 1]
			behind = ranked[i + 1]
		end
	end
	local elapsed = if myRow.F and myRow.T then myRow.T elseif snap.Phase == "Racing" then math.max(0, t - (snap.GoAt or t)) else 0
	local gapText = ""
	local refSpeed = math.max(speed, 25)
	if ahead and not myRow.F then
		gapText = T("%s ahead: +%.1f s", tostring(ahead.Row.N), math.max(0, (ahead.Progress - myD) / refSpeed))
	elseif behind and not myRow.F then
		gapText = T("Lead: %.1f s", math.max(0, (myD - behind.Progress) / refSpeed))
	elseif myRow.F then
		gapText = T("🏁 Finished!")
	end
	-- flèche vers la prochaine porte (relative à la caméra)
	local cpText, arrow, dist = nil, 0, 0
	local cp = route.Checkpoints[math.clamp(nextIndex, 1, #route.Checkpoints)]
	local camera = workspace.CurrentCamera
	local car = myCarRoot()
	if running and cp and camera and car then
		local target = RaceRoutes.ToWorld(cp.X, cp.Z, 0)
		local to = Vector3.new(target.X - car.Position.X, 0, target.Z - car.Position.Z)
		dist = to.Magnitude
		local cl = camera.CFrame.LookVector
		local fwd = Vector3.new(cl.X, 0, cl.Z)
		if fwd.Magnitude > 1e-3 and dist > 1e-3 then
			fwd = fwd.Unit
			local dir = to.Unit
			arrow = math.deg(math.atan2(fwd:Cross(dir).Y * -1, fwd:Dot(dir)))
		end
		cpText = if cp.Finish then T("🏁 Finish · %d m", math.floor(dist * 0.28 + 0.5))
			else T("Gate %d/%d · %d m", nextIndex, #route.Checkpoints, math.floor(dist * 0.28 + 0.5))
	end
	local lap = if route.Closed then math.floor(math.max(myD, 0) / route.Total) + 1 else 1
	RaceHud.SetRace({
		Place = place,
		Count = #snap.Racers,
		Lap = math.min(lap, route.Laps),
		Laps = route.Laps,
		Time = RaceRules.FormatTime(elapsed),
		Gap = gapText,
		Best = if myRow.B then T("Best lap: %s", RaceRules.FormatTime(myRow.B)) else "",
		Cp = cpText,
		Arrow = arrow,
		Wrong = wrong,
		Running = running,
	})
	-- mini-carte
	if not mine.MiniDrawn then
		mine.MiniDrawn = true
		RaceHud.SetMinimap(preview(route), nil, route.Closed)
	end
	local box = route.MiniBox
	if box then
		local dots = {}
		for _, r in ipairs(ranked) do
			local d = r.Progress
			local x, z = RaceRules.PointAt(route.Line, lineS(route, d))
			local color = if r.Me then Color3.fromRGB(255, 214, 90) elseif r.Row.AI then Color3.fromRGB(214, 196, 236) else Color3.fromRGB(90, 220, 240)
			table.insert(dots, { 0.5 + (x - box[1]) / box[3], 0.5 + (z - box[2]) / box[3], color, r.Me })
		end
		RaceHud.SetMinimap(nil, dots)
	end
end

----------------------------------------------------------------------
-- Réseau
----------------------------------------------------------------------

local function showResults(payload: any)
	local route = routeOf(tostring(payload.Route))
	local def = route and route.Def or Config.RaceRoutesById[tostring(payload.Route)]
	local rows = {}
	local others = {}
	for _, row in ipairs(payload.Rows or {}) do
		local timeText = if row.Finished and row.Time then RaceRules.FormatTime(row.Time) elseif row.Dnf then T("Out") else T("Did not finish")
		table.insert(rows, { Place = row.Place, Name = row.Name, UserId = row.UserId, AI = row.AI, TimeText = timeText })
		if (row.Place or 0) > 3 then
			table.insert(others, string.format("%d. %s  %s", row.Place, tostring(row.Name), timeText))
		end
	end
	local m = payload.Mine or {}
	local place = tonumber(m.Place) or 0
	local suffix = if Locale.IsFrench() then (if place == 1 then "er" else "e") else (if place == 1 then "st" elseif place == 2 then "nd" elseif place == 3 then "rd" else "th")
	local mineText
	if m.Suspicious then
		mineText = T("No reward: the race was not valid")
	elseif (m.Reward or 0) > 0 then
		mineText = T("You finished %d%s · +%s Dopamine!", place, suffix, NumberFormatter.Format(m.Reward))
	elseif m.Capped then
		mineText = T("You finished %d%s · daily race rewards reached", place, suffix)
	else
		mineText = T("You finished %d%s", place, suffix)
	end
	RaceHud.ShowResults({
		Title = (def and def.Icon or "🏁") .. " " .. T("Results") .. " · " .. (if def then T(def.Name) else ""),
		Rows = rows,
		Others = table.concat(others, "   "),
		Mine = mineText,
	})
end

local function onEvent(kind: string, payload: any)
	if kind == "Lobbies" then
		lobbies = if type(payload) == "table" then payload else {}
		boardDirty = true
		-- plus inscrit ? (salle fermée sans moi)
		if joined.Route and not mine.D then
			local lobby = lobbies[joined.Route]
			if not lobby then
				joined.Route, joined.RaceId = nil, nil
			end
		end
		refreshMenu()
	elseif kind == "Board" then
		board = if type(payload) == "table" then payload else {}
		boardDirty = true
		refreshMenu()
	elseif kind == "Me" then
		if type(payload) == "table" then
			me = payload
		end
		refreshMenu()
	elseif kind == "Joined" then
		joined.Route = payload.Route
		joined.RaceId = payload.RaceId
		table.clear(mine)
		refreshMenu()
		local def = Config.RaceRoutesById[tostring(payload.Route)]
		toast(T("🏁 Signed up: %s", def and T(def.Name) or ""))
	elseif kind == "Left" then
		if joined.Route == payload.Route then
			joined.Route, joined.RaceId = nil, nil
			endMyRace()
		end
		refreshMenu()
	elseif kind == "Grid" then
		joined.Route = payload.Route
		joined.RaceId = payload.RaceId
		RaceHud.SetMenu(false)
		RaceHud.Flash(T("On the grid: slot %d", tonumber(payload.Slot) or 1), Color3.fromRGB(255, 214, 90))
	elseif kind == "State" then
		if type(payload) ~= "table" then
			return
		end
		local seenIds: { [string]: boolean } = {}
		for _, snap in ipairs(payload) do
			local id = tostring(snap.Route)
			local route = routeOf(id)
			if route then
				seenIds[id] = true
				local view = views[id]
				if view and view.Snap.Id ~= snap.Id then
					dropView(id)
					view = nil
				end
				if not view then
					view = { Snap = snap, At = os.clock(), ServerAt = now(), Route = route, Ai = {} }
					views[id] = view
				end
				view.Snap = snap
				view.At = os.clock()
				view.ServerAt = tonumber(snap.Now) or now()
			end
		end
		for id in pairs(views) do
			if not seenIds[id] then
				dropView(id)
			end
		end
	elseif kind == "Finished" then
		RaceHud.Countdown(T("FINISH!"), Color3.fromRGB(255, 214, 90))
		RaceHud.Flash(RaceRules.FormatTime(tonumber(payload.Time) or 0), Color3.fromRGB(130, 236, 190))
	elseif kind == "Result" then
		if resultsShownFor ~= payload.RaceId then
			resultsShownFor = payload.RaceId
			endMyRace()
			joined.Route, joined.RaceId = nil, nil
			pcall(showResults, payload)
		end
	elseif kind == "Reset" then
		mine.D = tonumber(payload.D) or mine.D
		local route = joined.Route and routeOf(joined.Route)
		if route and mine.D then
			mine.S = lineS(route, mine.D)
		end
		RaceHud.Flash(T("Back to the last checkpoint"), Color3.fromRGB(90, 220, 240))
	elseif kind == "Toast" then
		toast(tostring(payload))
	end
end

----------------------------------------------------------------------
-- Cycle de vie
----------------------------------------------------------------------

function RaceClient.Start(options: any?)
	if started then
		RaceClient.Stop()
	end
	started = true
	opts = if type(options) == "table" then options else {}
	count = WorldLayout.PlotCount(Players.MaxPlayers)
	local f = Instance.new("Folder")
	f.Name = RaceClient.FOLDER_NAME
	f.Parent = workspace
	folder = f
	RaceHud.Build({
		Join = function(routeId: string, isJoined: boolean?)
			if isJoined then
				send("leave")
			else
				send("join", routeId)
			end
		end,
		Leave = function()
			send("leave")
		end,
		Reset = function()
			send("reset")
		end,
		Menu = openMenu,
	})
	table.insert(conns, Net.Event("RaceEvent").OnClientEvent:Connect(function(kind: any, payload: any)
		if type(kind) ~= "string" then
			return
		end
		local ok, err = pcall(onEvent, kind, payload)
		if not ok then
			warn("[RaceClient] " .. kind .. " : " .. tostring(err))
		end
	end))
	-- F = retour à la dernière porte (pendant SA course)
	table.insert(conns, UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.F and joined.Route and mine.D ~= nil then
			send("reset")
		end
	end))
	-- parcours calculés d'avance (une fois par nombre de parcelles, en cache)
	task.spawn(function()
		pcall(RaceRoutes.All, count)
	end)
	send("sync")
end

function RaceClient.Step(dt: number)
	if not started then
		return
	end
	streamClock += dt
	if streamClock >= 0.25 then
		streamClock = 0
		local ok, err = pcall(stream)
		if not ok then
			warn("[RaceClient] flux : " .. tostring(err))
		end
	end
	local p = focus()
	local t = now()
	for id, view in pairs(views) do
		-- feux du portique (synchronisés sur l'heure du serveur)
		local g = gantries[id]
		if g then
			local remain = (view.Snap.GoAt or 0) - t
			local stage = 0
			if view.Snap.Phase == "Grid" or view.Snap.Phase == "Countdown" or view.Snap.Phase == "Racing" then
				if remain > 3 then
					stage = 0
				elseif remain > 0 then
					stage = math.clamp(math.floor((3 - remain) / 0.6) + 1, 1, 5)
				elseif remain > -4 then
					stage = 6
				end
			end
			if g.Stage ~= stage then
				g.Stage = stage
				RaceProps.SetLights(g.Lights, stage)
			end
		end
		local ok, err = pcall(stepAI, view, dt, p)
		if not ok then
			warn("[RaceClient] IA : " .. tostring(err))
			dropView(id)
		end
	end
	local okMine, errMine = pcall(stepMine, dt)
	if not okMine then
		warn("[RaceClient] course : " .. tostring(errMine))
	end
	-- bouton 🏁 au volant (hors course), menu rafraîchi 2 fois / s
	local inRace = joined.Route ~= nil and mine.D ~= nil
	RaceHud.SetRaceButton(isDriving() and not inRace)
	menuClock += dt
	if menuClock >= 0.5 then
		menuClock = 0
		refreshMenu()
		local lobby = joined.Route and lobbies[joined.Route]
		if lobby and lobby.Phase == "Lobby" then
			local def = Config.RaceRoutesById[joined.Route]
			RaceHud.SetLobby({
				Text = T("%s %s · %d racers · start in %d s", def.Icon, T(def.Name), lobby.Count or 1, math.max(0, math.ceil((lobby.EndsAt or t) - t))),
			})
		else
			RaceHud.SetLobby(nil)
		end
	end
end

function RaceClient.Stop()
	if not started then
		return
	end
	started = false
	if joined.Route then
		send("leave")
	end
	for _, c in ipairs(conns) do
		c:Disconnect()
	end
	table.clear(conns)
	for id in pairs(views) do
		dropView(id)
	end
	endMyRace()
	destroyHQ()
	for _, g in pairs(gantries) do
		g.Model:Destroy()
		if g.Finish then
			g.Finish:Destroy()
		end
	end
	table.clear(gantries)
	RaceHud.Destroy()
	if folder then
		folder:Destroy()
		folder = nil
	end
	joined.Route, joined.RaceId = nil, nil
	table.clear(lobbies)
end

function RaceClient.Debug(): any
	return {
		Views = views,
		Gantries = gantries,
		HQ = hq,
		Joined = joined,
		Mine = mine,
		Gates = gates,
		Lobbies = function()
			return lobbies
		end,
		Board = function()
			return board
		end,
		OnEvent = onEvent,
		Stream = stream,
		OpenMenu = openMenu,
		Hud = RaceHud,
		Count = function()
			return count
		end,
	}
end

return RaceClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="220">
          <Properties>
            <string name="Name">RaceHud</string>
            <string name="Source"><![CDATA[--[[
	RaceHud (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > RaceHud

	🏁 Interface des courses de rue (v10, RACE10) : ScreenGui "RaceGui"
	(gardée visible en ville : KEEP_GUIS), piloté par RaceClient.
	  - bouton rond 🏁 au volant (hors course) : ouvre le MENU ;
	  - MENU "🏁 Courses de rue" : 4 cartes (aperçu du tracé, tours,
	    longueur, record du serveur, ton meilleur temps, état : libre /
	    N inscrits + départ dans X s / course en cours), bouton S'inscrire,
	    courses récompensées aujourd'hui ;
	  - SALLE D'ATTENTE (bandeau en haut) : parcours, inscrits, départ dans
	    X s, bouton Quitter ;
	  - EN COURSE : place (grand), tour, chrono, écart avec la voiture de
	    devant, meilleur tour ; FLÈCHE vers la prochaine porte (+ porte n / N,
	    distance) ; MINI-CARTE (tracé + points des coureurs) ; boutons 🔄 porte
	    (F) et 🏳️ abandon ; 3-2-1-GO géant, "MAUVAIS SENS", flash des portes ;
	  - RÉSULTATS : podium animé (colonnes qui montent l'une après l'autre,
	    photos, temps), classement complet, ta récompense, confettis.
	Ordinateur + téléphone (UIScale, disposition resserrée sur téléphone).

	API (RaceClient) :
	  RaceHud.Build(callbacks)  { Join(routeId), Leave(), Reset(), Menu(open) }
	  RaceHud.Destroy()
	  RaceHud.SetRaceButton(visible)
	  RaceHud.SetMenu(open, cards?, info?)   cards = { { Id, Name, Icon, Desc, Laps, Km, Record, Best, Status, StatusColor, CanJoin, Joined, Preview } }
	  RaceHud.SetLobby(info?)                { Title, Text }
	  RaceHud.SetRace(info?)                 { Place, Count, Lap, Laps, Time, Gap, Best, Cp, Cps, Arrow (deg), Dist, Wrong }
	  RaceHud.SetMinimap(points?, dots?)     points = { { u, v } } (0..1) ; dots = { { u, v, color, me } }
	  RaceHud.Countdown(text, color?)        gros texte qui "pop"
	  RaceHud.Flash(text, color?)
	  RaceHud.ShowResults(res) / RaceHud.HideResults()
	  RaceHud.IsMenuOpen() / RaceHud.Debug()
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Client = script.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local Locale = require(game:GetService("ReplicatedStorage").Shared.Locale)

local RaceHud = {}

RaceHud.GUI_NAME = "RaceGui"

local rgb = Color3.fromRGB
local INK = rgb(34, 26, 44)
local PANEL = rgb(40, 30, 56)
local PANEL2 = rgb(58, 44, 80)
local WHITE = rgb(255, 255, 255)
local PINK = rgb(255, 110, 170)
local PINK_DEEP = rgb(236, 72, 140)
local GOLD = rgb(255, 204, 60)
local SILVER = rgb(206, 212, 224)
local BRONZE = rgb(222, 152, 96)
local MINT = rgb(110, 226, 170)
local CYAN = rgb(90, 220, 240)
local RED = rgb(240, 70, 80)
local SOFT = rgb(214, 196, 236)

local gui: ScreenGui? = nil
local parts: { [string]: any } = {}
local callbacks: { [string]: any } = {}
local conns: { RBXScriptConnection } = {}
local phone = false
local menuOpen = false
local countdownTween: Tween? = nil
local flashToken = 0
local resultsToken = 0

local function T(text: string, ...): string
	return Locale.T(text, ...)
end

local function label(props: { [string]: any }): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.BorderSizePixel = 0
	l.Font = props.Font or Theme.Fonts.Title
	l.TextColor3 = props.Color or WHITE
	l.TextSize = props.TextSize or 18
	l.TextWrapped = props.Wrap == true
	l.TextXAlignment = props.XAlign or Enum.TextXAlignment.Center
	l.TextYAlignment = props.YAlign or Enum.TextYAlignment.Center
	l.Text = props.Text or ""
	l.Name = props.Name or "Label"
	l.Size = props.Size or UDim2.fromScale(1, 1)
	l.Position = props.Position or UDim2.new()
	l.AnchorPoint = props.AnchorPoint or Vector2.zero
	l.ZIndex = props.ZIndex or 2
	l.RichText = props.Rich == true
	if props.Scaled then
		l.TextScaled = true
		UIUtil.Create("UITextSizeConstraint", { MaxTextSize = props.TextSize or 18, MinTextSize = 8, Parent = l })
	end
	l.Parent = props.Parent
	return l
end

local function box(props: { [string]: any }): Frame
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.Name = props.Name or "Box"
	f.BackgroundColor3 = props.Color or PANEL
	f.BackgroundTransparency = props.Transparency or 0
	f.Size = props.Size or UDim2.fromScale(1, 1)
	f.Position = props.Position or UDim2.new()
	f.AnchorPoint = props.AnchorPoint or Vector2.zero
	f.ZIndex = props.ZIndex or 1
	f.Visible = props.Visible ~= false
	f.ClipsDescendants = props.Clip == true
	if props.Radius then
		UIUtil.Corner(f, props.Radius)
	end
	if props.Stroke then
		UIUtil.Stroke(f, props.Stroke, props.StrokeThickness or 2)
	end
	f.Parent = props.Parent
	return f
end

local function button(props: { [string]: any }): TextButton
	local b = Instance.new("TextButton")
	b.Name = props.Name or "Button"
	b.AutoButtonColor = true
	b.BorderSizePixel = 0
	b.BackgroundColor3 = props.Color or PINK_DEEP
	b.Size = props.Size or UDim2.fromOffset(120, 40)
	b.Position = props.Position or UDim2.new()
	b.AnchorPoint = props.AnchorPoint or Vector2.zero
	b.Font = Theme.Fonts.Title
	b.TextColor3 = props.TextColor or WHITE
	b.TextSize = props.TextSize or 18
	b.Text = props.Text or ""
	b.ZIndex = props.ZIndex or 3
	b.Visible = props.Visible ~= false
	UIUtil.Corner(b, props.Radius or UDim.new(0, 12))
	if props.Stroke ~= false then
		UIUtil.Stroke(b, props.StrokeColor or WHITE, 2, 0.35)
	end
	b.Parent = props.Parent
	pcall(UIUtil.AnimateButton, b)
	return b
end

-- Damier (bandeau décoratif)
local function checker(parent: Instance, cols: number, rows: number, z: number)
	for i = 0, cols - 1 do
		for j = 0, rows - 1 do
			box({ Name = "Sq", Parent = parent, Color = if (i + j) % 2 == 0 then INK else WHITE, Size = UDim2.fromScale(1 / cols, 1 / rows),
				Position = UDim2.fromScale(i / cols, j / rows), ZIndex = z })
		end
	end
end

-- Ligne brisée dessinée avec des Frames (points en 0..1 dans `holder`)
local function drawLine(holder: Frame, points: { { number } }, color: Color3, thickness: number, z: number, closed: boolean?)
	for _, child in ipairs(holder:GetChildren()) do
		if child.Name == "Seg" then
			child:Destroy()
		end
	end
	-- (tailles en pixels "design" : le support a une taille fixe en offset)
	local w = math.max(4, holder.Size.X.Offset)
	local h = math.max(4, holder.Size.Y.Offset)
	local n = #points
	local last = if closed then n else n - 1
	for i = 1, last do
		local a = points[i]
		local b = points[(i % n) + 1]
		local ax, ay = a[1] * w, a[2] * h
		local bx, by = b[1] * w, b[2] * h
		local len = math.sqrt((bx - ax) ^ 2 + (by - ay) ^ 2)
		if len > 0.5 then
			local seg = box({ Name = "Seg", Parent = holder, Color = color, AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(len + thickness * 0.6, thickness), Position = UDim2.fromOffset((ax + bx) / 2, (ay + by) / 2), ZIndex = z })
			seg.Rotation = math.deg(math.atan2(by - ay, bx - ax))
			UIUtil.Corner(seg, UDim.new(1, 0))
		end
	end
	-- départ : drapeau à damier
	local start = holder:FindFirstChild("Start")
	if not start then
		start = label({ Name = "Start", Parent = holder, Text = "🏁", TextSize = 14, AnchorPoint = Vector2.new(0.5, 1), Size = UDim2.fromOffset(18, 18), ZIndex = z + 1 })
	end
	if points[1] then
		start.Position = UDim2.fromOffset(points[1][1] * w + 5, points[1][2] * h)
	end
end
RaceHud.DrawLine = drawLine

----------------------------------------------------------------------
-- Construction
----------------------------------------------------------------------

local function buildMenu(root: Frame)
	local dim = box({ Name = "MenuDim", Parent = root, Color = rgb(0, 0, 0), Transparency = 0.45, Visible = false, ZIndex = 20 })
	UIUtil.SinkClicks(dim)
	local panel = box({ Name = "Menu", Parent = dim, Color = PANEL, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(800, 470), Radius = UDim.new(0, 22), Stroke = PINK, StrokeThickness = 3, ZIndex = 21 })
	panel.BackgroundColor3 = WHITE
	UIUtil.Gradient(panel, ColorSequence.new(PANEL2, PANEL), 90)
	local band = box({ Name = "Band", Parent = panel, Transparency = 1, Size = UDim2.new(1, -44, 0, 10), Position = UDim2.fromOffset(22, 8), ZIndex = 22, Clip = true })
	checker(band, 60, 2, 22)
	label({ Name = "Title", Parent = panel, Text = T("🏁 Street races"), TextSize = 32, Size = UDim2.new(1, -120, 0, 40), Position = UDim2.fromOffset(24, 22),
		XAlign = Enum.TextXAlignment.Left, ZIndex = 22 })
	local sub = label({ Name = "Sub", Parent = panel, Text = "", Font = Theme.Fonts.Body, TextSize = 16, Color = SOFT, Size = UDim2.new(1, -120, 0, 22),
		Position = UDim2.fromOffset(26, 62), XAlign = Enum.TextXAlignment.Left, ZIndex = 22 })
	local close = UIUtil.CloseButton({ Name = "CloseRace", Size = 40, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 20), ZIndex = 24 })
	close.Parent = panel
	close.Activated:Connect(function()
		if callbacks.Menu then
			callbacks.Menu(false)
		end
	end)
	local list = box({ Name = "Cards", Parent = panel, Transparency = 1, Size = UDim2.new(1, -32, 1, -150), Position = UDim2.fromOffset(16, 96), ZIndex = 22 })
	local grid = UIUtil.Create("UIGridLayout", { CellSize = UDim2.fromOffset(183, 306), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = list })
	local foot = label({ Name = "Foot", Parent = panel, Text = "", Font = Theme.Fonts.Body, TextSize = 15, Color = SOFT, Size = UDim2.new(1, -40, 0, 34),
		Position = UDim2.new(0, 20, 1, -46), Wrap = true, ZIndex = 22 })
	parts.MenuDim = dim
	parts.Menu = panel
	parts.MenuSub = sub
	parts.Cards = list
	parts.CardGrid = grid
	parts.MenuFoot = foot
	parts.CardList = {}
end

local function buildCard(parent: Instance, order: number): { [string]: any }
	local card = box({ Name = "Card" .. order, Parent = parent, Color = rgb(28, 22, 40), Radius = UDim.new(0, 16), Stroke = rgb(120, 90, 160), ZIndex = 23 })
	card.LayoutOrder = order
	local map = box({ Name = "Map", Parent = card, Color = rgb(52, 70, 60), Size = UDim2.new(1, -20, 0, 96), Position = UDim2.fromOffset(10, 10), Radius = UDim.new(0, 10), ZIndex = 24, Clip = true })
	map.BackgroundColor3 = WHITE
	UIUtil.Gradient(map, ColorSequence.new(rgb(74, 108, 86), rgb(46, 66, 58)), 90)
	local lineHolder = box({ Name = "Line", Parent = map, Transparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(80, 80),
		Position = UDim2.fromScale(0.5, 0.5), ZIndex = 25 })
	local icon = label({ Name = "Icon", Parent = card, Text = "", TextSize = 30, Size = UDim2.fromOffset(40, 36), Position = UDim2.fromOffset(8, 112), ZIndex = 24 })
	local name = label({ Name = "Name", Parent = card, Text = "", TextSize = 18, Size = UDim2.new(1, -54, 0, 36), Position = UDim2.fromOffset(48, 112), XAlign = Enum.TextXAlignment.Left,
		Scaled = true, ZIndex = 24 })
	local info = label({ Name = "Info", Parent = card, Text = "", Font = Theme.Fonts.Body, TextSize = 14, Color = SOFT, Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 148),
		Wrap = true, Scaled = true, XAlign = Enum.TextXAlignment.Left, YAlign = Enum.TextYAlignment.Top, ZIndex = 24 })
	local record = label({ Name = "Record", Parent = card, Text = "", Font = Theme.Fonts.Body, TextSize = 14, Color = GOLD, Size = UDim2.new(1, -20, 0, 20), Position = UDim2.fromOffset(10, 184),
		XAlign = Enum.TextXAlignment.Left, Scaled = true, ZIndex = 24 })
	local best = label({ Name = "Best", Parent = card, Text = "", Font = Theme.Fonts.Body, TextSize = 14, Color = MINT, Size = UDim2.new(1, -20, 0, 20), Position = UDim2.fromOffset(10, 204),
		XAlign = Enum.TextXAlignment.Left, Scaled = true, ZIndex = 24 })
	local status = label({ Name = "Status", Parent = card, Text = "", Font = Theme.Fonts.Title, TextSize = 14, Color = WHITE, Size = UDim2.new(1, -20, 0, 20), Position = UDim2.fromOffset(10, 228),
		Scaled = true, ZIndex = 24 })
	local join = button({ Name = "Join", Parent = card, Text = T("Join"), Size = UDim2.new(1, -20, 0, 40), Position = UDim2.new(0, 10, 1, -50), ZIndex = 25 })
	return { Card = card, Map = map, Line = lineHolder, Icon = icon, Name = name, Info = info, Record = record, Best = best, Status = status, Join = join, Id = "" }
end

local function buildRaceHud(root: Frame)
	-- place / tour / chrono (en haut à gauche)
	local panel = box({ Name = "RacePanel", Parent = root, Color = PANEL, Transparency = 0.12, Size = UDim2.fromOffset(250, 100), Position = UDim2.fromOffset(12, 104),
		Radius = UDim.new(0, 18), Stroke = PINK, Visible = false, ZIndex = 5 })
	local place = label({ Name = "Place", Parent = panel, Text = "1", Font = Theme.Fonts.Number, TextSize = 56, Size = UDim2.fromOffset(70, 60), Position = UDim2.fromOffset(8, 2), ZIndex = 6 })
	UIUtil.Create("UIStroke", { Color = INK, Thickness = 2, Parent = place })
	local count = label({ Name = "Count", Parent = panel, Text = "/4", Font = Theme.Fonts.Number, TextSize = 24, Color = SOFT, Size = UDim2.fromOffset(46, 30),
		Position = UDim2.fromOffset(70, 30), XAlign = Enum.TextXAlignment.Left, ZIndex = 6 })
	local lap = label({ Name = "Lap", Parent = panel, Text = "", TextSize = 18, Size = UDim2.fromOffset(120, 24), Position = UDim2.fromOffset(122, 6), XAlign = Enum.TextXAlignment.Left, ZIndex = 6 })
	local time = label({ Name = "Time", Parent = panel, Text = "0:00.00", Font = Theme.Fonts.Number, TextSize = 26, Color = GOLD, Size = UDim2.fromOffset(124, 30),
		Position = UDim2.fromOffset(120, 28), XAlign = Enum.TextXAlignment.Left, ZIndex = 6 })
	local gap = label({ Name = "Gap", Parent = panel, Text = "", Font = Theme.Fonts.Body, TextSize = 15, Color = SOFT, Size = UDim2.new(1, -20, 0, 20),
		Position = UDim2.fromOffset(12, 58), XAlign = Enum.TextXAlignment.Left, Scaled = true, ZIndex = 6 })
	local bestLap = label({ Name = "BestLap", Parent = panel, Text = "", Font = Theme.Fonts.Body, TextSize = 15, Color = MINT, Size = UDim2.new(1, -20, 0, 20),
		Position = UDim2.fromOffset(12, 77), XAlign = Enum.TextXAlignment.Left, ZIndex = 6 })
	-- flèche vers la prochaine porte (en haut au milieu, sous le compteur)
	local arrowBox = box({ Name = "Arrow", Parent = root, Color = PANEL, Transparency = 0.15, AnchorPoint = Vector2.new(0.5, 0), Size = UDim2.fromOffset(230, 44),
		Position = UDim2.new(0.5, 0, 0, 112), Radius = UDim.new(1, 0), Stroke = CYAN, Visible = false, ZIndex = 5 })
	local dial = box({ Name = "Dial", Parent = arrowBox, Transparency = 1, Size = UDim2.fromOffset(40, 40), Position = UDim2.fromOffset(4, 2), ZIndex = 6 })
	local needle = UIUtil.Icon("Up", { Size = 28, Color = CYAN, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 7, Parent = dial })
	local cpText = label({ Name = "Cp", Parent = arrowBox, Text = "", TextSize = 16, Size = UDim2.new(1, -52, 1, 0), Position = UDim2.fromOffset(48, 0), XAlign = Enum.TextXAlignment.Left, ZIndex = 6 })
	-- mini-carte (en haut à droite)
	local mini = box({ Name = "Minimap", Parent = root, Color = rgb(40, 56, 50), Transparency = 0.1, AnchorPoint = Vector2.new(1, 1), Size = UDim2.fromOffset(150, 150),
		Position = UDim2.new(1, -12, 1, -12), Radius = UDim.new(0, 18), Stroke = WHITE, Visible = false, ZIndex = 5, Clip = true })
	local miniLine = box({ Name = "Line", Parent = mini, Transparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(126, 126), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 6 })
	local miniDots = box({ Name = "Dots", Parent = mini, Transparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(126, 126), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 8 })
	-- boutons 🔄 (F) et 🏳️

-- Indicateurs Robux, de chaque côté du bouton (hors de la pile : ils ne
-- poussent jamais la barre d'améliorations sur les emplacements du bas).
--   gauche : 👑 VIP, 💎 bonus des Game Passes ; droite (après "🏠") : ⏱️ boost + minuteur.
-- `buttonCenterX` / `buttonCenterY` : centre du bouton dans la colonne.
local function buildStatus(column: Frame, buttonCenterX: number, buttonCenterY: number)
	statusLeft = UIUtil.Create("Frame", {
		Name = "StatusLeft",
		Size = UDim2.fromOffset(70, 56),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromOffset(buttonCenterX - BUTTON_SIZE.X / 2 - 8, buttonCenterY),
		BackgroundTransparency = 1,
		Parent = column,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 4),
		Parent = statusLeft,
	})
	local function chip(name: string, text: string, color: Color3, textColor: Color3, chipOrder: number): Frame
		local frame = UIUtil.Chip({
			Name = name,
			Text = text,
			Color = color,
			TextColor3 = textColor,
			Height = 22,
			TextSize = 13,
			LayoutOrder = chipOrder,
			Visible = false,
			Parent = statusLeft,
		})
		UIUtil.Gradient(frame, ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(225, 225, 225)), 90)
		UIUtil.Create("UIScale", { Name = "PopScale", Parent = frame })
		return frame
	end
	vipChip = chip("VIP", "👑 VIP", Theme.Colors.Premium, Theme.Colors.TextDark, 1)
	bonusChip = chip("Bonus", "💎 x1", Theme.Colors.Purple, Theme.Colors.TextLight, 2)

	-- Carte du boost : "⏱️ x2" + minuteur (à droite du bouton "🏠")
	boostCard = UIUtil.Create("Frame", {
		Name = "Boost",
		Size = UDim2.fromOffset(62, 50),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromOffset(buttonCenterX + BUTTON_SIZE.X / 2 + HOUSE_GAP + HOUSE_BUTTON_SIZE + 14, buttonCenterY),
		BackgroundColor3 = Theme.Colors.Boost,
		Visible = false,
		Parent = column,
	})
	UIUtil.Corner(boostCard, Theme.Radius.M)
	UIUtil.Stroke(boostCard, Theme.Colors.Border, 1.5, 0.3)
	UIUtil.Gradient(boostCard, ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(215, 215, 215)), 90)
	UIUtil.Create("UIScale", { Name = "PopScale", Parent = boostCard })
	UIUtil.Shadow(boostCard, 3, 0.85, 2)
	boostTitle = UIUtil.Label({
		Text = "⏱️ x2",
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.TextLight,
		Size = UDim2.new(1, -8, 0, 20),
		Position = UDim2.fromOffset(4, 5),
		MaxTextSize = 16,
		ZIndex = 2,
		Parent = boostCard,
	})
	boostTimer = UIUtil.Label({
		Text = "0:00",
		Font = Theme.Fonts.Number,
		TextColor3 = Theme.Colors.TextLight,
		Size = UDim2.new(1, -8, 0, 18),
		Position = UDim2.fromOffset(4, 26),
		MaxTextSize = 15,
		ZIndex = 2,
		Parent = boostCard,
	})
	for _, label in ipairs({ boostTitle, boostTimer }) do
		local stroke = UIUtil.Stroke(label, Color3.fromRGB(120, 40, 0), 1, 0.5)
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	end
end

local function chipText(frame: Frame, text: string)
	local label = frame:FindFirstChild("Label") :: TextLabel?
	if label and label.Text ~= text then
		label.Text = text
	end
end

-- Montre / cache un indicateur (avec un petit "pop" à l'apparition)
local function setChipVisible(frame: GuiObject, visible: boolean)
	if frame.Visible == visible then
		return
	end
	frame.Visible = visible
	if visible then
		UIUtil.Pop(frame, 0.3, 0.4)
	end
end

-- Mise à jour des indicateurs + animation du robot (à chaque image)
local function updateStatus(dt: number)
	local data = ClientState.Data
	if not data then
		return
	end

	setChipVisible(vipChip, ClientState.IsVIP())

	local passMultiplier = ClientState.GetPassMultiplier()
	setChipVisible(bonusChip, passMultiplier > 1.001)
	if bonusChip.Visible then
		chipText(bonusChip, "💎 " .. NumberFormatter.Multiplier(passMultiplier))
	end

	local boostMultiplier, remaining = ClientState.GetBoost()
	setChipVisible(boostCard, remaining > 0)
	if remaining > 0 then
		local title = "⏱️ " .. NumberFormatter.Multiplier(boostMultiplier)
		if boostTitle.Text ~= title then
			boostTitle.Text = title
		end
		local clock = UIUtil.FormatClock(remaining)
		if boostTimer.Text ~= clock then
			boostTimer.Text = clock
		end
		-- Pulsation douce (plus rapide dans la dernière minute)
		local speed = remaining < 60 and 9 or 3
		boostCard.Rotation = math.sin(os.clock() * speed) * 3
	end

	-- Auto-clic (Game Pass) : petit robot qui tape le coin du bouton
	local hasAuto = ClientState.HasPass("AutoClick")
	if robotLabel.Visible ~= hasAuto then
		robotLabel.Visible = hasAuto
		if hasAuto then
			UIUtil.Pop(robotLabel, 0.2, 0.5)
		end
	end
	if hasAuto then
		local autoPass = Config.GamePassesById.AutoClick
		local rate = (autoPass and tonumber(autoPass.AutoClicksPerSecond)) or 1
		robotClock += dt * rate
		-- Petit coup de tête à chaque "clic" du robot
		local phase = robotClock % 1
		robotLabel.Rotation = phase < 0.35 and 18 * math.sin(phase / 0.35 * math.pi) or 0
		-- Toutes les secondes : "+X" discret (gain approximatif des clics auto)
		robotFloatClock += dt
		if robotFloatClock >= 1 then
			robotFloatClock = 0
			local gain = (tonumber(data.ClickValue) or 0) * rate
			if gain > 0 and effectsLayer then
				local center = Interface.GetCanvasCenter(robotLabel)
				Effects.FloatingText(effectsLayer, UDim2.fromOffset(center.X - 6, center.Y - 16), "+" .. formatAmount(gain), Theme.Colors.Cyan, 18)
			end
		end
	end
end

-- Gros gain (bonus, jackpot, achat...) : le compteur grossit et brille
local function counterCelebrate(strength: number)
	counterScale.Scale = 1 + 0.08 * strength
	UIUtil.Tween(counterScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Elastic)
	counterFlashUntil = os.clock() + 0.8
end

----------------------------------------------------------------------
-- Mises à jour
----------------------------------------------------------------------

local function applyDarkMode(dark: boolean)
	local textColor = dark and Theme.DarkColors.Text or Theme.Colors.Text
	local dimColor = dark and Theme.DarkColors.TextDim or Theme.Colors.TextDim
	counterLabel.TextColor3 = textColor
	unitLabel.TextColor3 = dimColor
	perSecondLabel.TextColor3 = dimColor
	for _, label in ipairs({ counterLabel, unitLabel }) do
		local counterStroke = label:FindFirstChild("DarkStroke") :: UIStroke?
		if counterStroke then
			counterStroke.Enabled = dark
		end
	end
	local perSecondStroke = perSecondLabel:FindFirstChild("DarkStroke") :: UIStroke?
	if perSecondStroke then
		perSecondStroke.Enabled = dark
	end
end

local function refreshPills(instant: boolean?)
	local skipPop = instant == true
	for _, pill in pairs(pills) do
		local feature = pill.Def.Feature
		local shouldShow = (feature == nil or ClientState.HasFeature(feature))
			and (pill.Def.Visible == nil or pill.Def.Visible())
		if shouldShow and not pill.Holder.Visible then
			pill.Holder.Visible = true
			local scale = pill.Holder:FindFirstChild("PopScale") :: UIScale?
			if scale and not skipPop then
				scale.Scale = 0.2
				UIUtil.Tween(scale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
			end
		elseif not shouldShow and pill.Holder.Visible then
			pill.Holder.Visible = false
			if PanelManager.IsOpen(pill.Def.Panel) then
				PanelManager.Close()
			end
		end
	end
end

local function refreshBadges()
	local data = ClientState.Data
	if not data then
		return
	end

	-- Boutique : objets pas encore possédés qu'on peut se payer
	local shop = pills.ItemShop
	if shop then
		local owned = (data.Cosmetics and data.Cosmetics.Owned) or {}
		local dopamine = ClientState.GetConfirmedDopamine()
		local affordable = 0
		for _, cosmetic in ipairs(Config.Cosmetics) do
			if not owned[cosmetic.Id] and dopamine >= cosmetic.Cost then
				affordable += 1
			end
		end
		UIUtil.SetBadge(shop.Badge, affordable)
	end

	-- Succès : débloqués depuis la dernière ouverture du menu
	local achievements = pills.Achievements
	if achievements then
		local count = countTrue(data.Achievements)
		if seenAchievements == nil or PanelManager.IsOpen("Achievements") then
			seenAchievements = count
		end
		UIUtil.SetBadge(achievements.Badge, math.max(0, count - (seenAchievements or count)))
	end

	-- Cadeau : disponible ?
	local daily = pills.Daily
	if daily then
		UIUtil.SetBadge(daily.Badge, (data.Daily and data.Daily.Available) and "!" or "")
	end

	-- Classement : couronne quand tu es 1er du serveur (au moins 2 joueurs)
	local leaderboard = pills.Leaderboard
	if leaderboard then
		local rank, count = ClientState.GetServerRank()
		UIUtil.SetBadge(leaderboard.Badge, (rank == 1 and count >= 2) and "👑" or "")
	end

	-- Maison : nouveaux objets abordables
	refreshHouseBadge(data)

	-- Thèmes : thèmes achetables en Dopamine, pas encore possédés, qu'on peut se payer
	local themes = pills.Themes
	if themes then
		local owned = (type(data.Themes) == "table" and data.Themes.Owned) or {}
		local dopamine = ClientState.GetConfirmedDopamine()
		local affordable = 0
		for _, theme in ipairs(Config.Themes) do
			local cost = tonumber(theme.Cost)
			if cost and cost > 0 and not owned[theme.Id] and dopamine >= cost then
				affordable += 1
			end
		end
		UIUtil.SetBadge(themes.Badge, affordable)
	end
end

local function onState(data)
	perSecondLabel.Text = Locale.T("%s Dopamine per second", formatAmount(data.PerSecond or 0))
	comboBar.Visible = data.ComboEnabled == true
	local equipped = data.Cosmetics and data.Cosmetics.Equipped
	applySkin((equipped and equipped.Skin) or "")
	applyHat((equipped and equipped.Hat) or "")
	refreshBadges()
end

----------------------------------------------------------------------
-- API
----------------------------------------------------------------------

-- `parent` = calque Main ; `floatingLayer` = calque au-dessus des stimuli
-- (infobulle) ; `fxLayer` = calque des effets
function CenterColumn.Build(parent: Frame, floatingLayer: Frame, fxLayer: Frame)
	effectsLayer = fxLayer

	local column = UIUtil.Create("Frame", {
		Name = "CenterColumn",
		Size = UDim2.fromOffset(700, 410),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 24),
		BackgroundTransparency = 1,
		Parent = parent,
	})

	buildButton(column)
	buildHouseButton(column, 350, 40 + BUTTON_SIZE.Y / 2)
	buildStatus(column, 350, 40 + BUTTON_SIZE.Y / 2)

	-- Pile verticale sous le bouton (les éléments cachés ne prennent pas de place)
	local stack = UIUtil.Create("Frame", {
		Name = "Stack",
		Size = UDim2.new(1, 0, 1, -(40 + BUTTON_SIZE.Y + 4)),
		Position = UDim2.fromOffset(0, 40 + BUTTON_SIZE.Y + 4),
		BackgroundTransparency = 1,
		Parent = column,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 3), -- tout doit tenir au-dessus des emplacements du bas (y <= 425)
		Parent = stack,
	})

	-- Compteur : gros nombre + unité plus discrète, alignés sur la même ligne
	counterRow = UIUtil.Create("Frame", {
		Name = "Counter",
		Size = UDim2.fromOffset(620, 46),
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = stack,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		Parent = counterRow,
	})
	counterScale = UIUtil.Create("UIScale", { Parent = counterRow })
	counterLabel = UIUtil.Create("TextLabel", {
		Name = "Number",
		Size = UDim2.fromOffset(0, 46),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Number,
		Text = "0",
		TextColor3 = Theme.Colors.Text,
		TextSize = Theme.TextSize.Display,
		TextYAlignment = Enum.TextYAlignment.Bottom,
		LayoutOrder = 1,
		Parent = counterRow,
	})
	unitLabel = UIUtil.Create("TextLabel", {
		Name = "Unit",
		Size = UDim2.fromOffset(0, 40),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = "Dopamine",
		TextColor3 = Theme.Colors.TextDim,
		TextSize = 24,
		TextYAlignment = Enum.TextYAlignment.Bottom,
		LayoutOrder = 2,
		Parent = counterRow,
	})
	for _, label in ipairs({ counterLabel, unitLabel }) do
		local counterStroke = UIUtil.Stroke(label, Theme.Colors.TextDark, 2, 0.3)
		counterStroke.Name = "DarkStroke"
		counterStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		counterStroke.Enabled = false
	end

	perSecondLabel = UIUtil.Label({
		Name = "PerSecond",
		Text = Locale.T("%s Dopamine per second", "0"),
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.fromOffset(320, 22),
		LayoutOrder = 2,
		MaxTextSize = 21,
		Parent = stack,
	})
	local perSecondStroke = UIUtil.Stroke(perSecondLabel, Theme.Colors.TextDark, 1.5, 0.4)
	perSecondStroke.Name = "DarkStroke"
	perSecondStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	perSecondStroke.Enabled = false

	buildRush(perSecondLabel)
	pillsStack = stack
	buildPills(stack, 5)
	buildCombo(stack, 6)
	local upgradeBar = UpgradeBar.Build(stack, floatingLayer)
	upgradeBar.LayoutOrder = 7

	-- Signaux
	ClientState.Changed:Connect(onState)
	ClientState.NotifyReceived:Connect(function(payload)
		local kind = payload.Type
		if kind == "Purchase" or kind == "Jackpot" then
			counterCelebrate(2)
		elseif kind == "Bonus" or kind == "Quest" or kind == "Achievement" then
			counterCelebrate(1)
		end
	end)
	ClientState.FeaturesChanged:Connect(function()
		refreshPills()
	end)
	ClientState.DarkModeChanged:Connect(applyDarkMode)
	applyDarkMode(ClientState.DarkMode)
	PanelManager.Opened:Connect(function(name: string)
		if name == "House" and ClientState.Data then
			refreshHouseBadge(ClientState.Data)
		end
		if name == "Achievements" and ClientState.Data then
			seenAchievements = countTrue(ClientState.Data.Achievements)
			local pill = pills.Achievements
			if pill then
				UIUtil.SetBadge(pill.Badge, 0)
			end
		end
	end)

	-- Compteur lissé, jauge de combo, Rush : à chaque image
	local badgeClock = 0
	RunService.RenderStepped:Connect(function(dt: number)
		counterLabel.Text = formatAmount(ClientState.UpdateDisplay(dt))
		-- Gros gain : le nombre brille en doré un instant
		local flashing = os.clock() < counterFlashUntil
		if flashing or counterFlashing then
			local base = ClientState.DarkMode and Theme.DarkColors.Text or Theme.Colors.Text
			local t = flashing and math.clamp((counterFlashUntil - os.clock()) / 0.8, 0, 1) or 0
			counterLabel.TextColor3 = base:Lerp(Theme.Colors.Gold, t)
			counterFlashing = flashing
		end

		updateStatus(dt)

		if comboBar.Visible then
			local meter = ClientState.GetComboMeter()
			comboFill.Size = UDim2.fromScale(meter / 100, 1)
			comboLabel.Text = Locale.T("COMBO %s", NumberFormatter.Multiplier(Formulas.GetComboMultiplier(meter)))
			comboBar.Rotation = meter >= 99.5 and math.sin(os.clock() * 30) * 1.5 or 0
		end

		local rush = ClientState.Rush
		local remaining = (rush.EndsAt or 0) - workspace:GetServerTimeNow()
		local active = rush.Active == true and remaining > 0
		if rushBanner.Visible ~= active then
			rushBanner.Visible = active
		end
		if active then
			rushLabel.Text = string.format(
				"⚡ %s x%s — %ds",
				Locale.T(tostring(rush.Name or "RUSH")),
				tostring(rush.Multiplier or 2),
				math.ceil(remaining)
			)
			rushBanner.Rotation = math.sin(os.clock() * 8) * 1.5
		end

		-- Bouton "🏠" : petit sautillement quand un nouvel objet est abordable
		if houseBadgeCount > 0 and os.clock() >= houseWiggleAt then
			houseWiggleAt = os.clock() + 4
			houseButton.Rotation = -12
			UIUtil.Tween(houseButton, 0.6, { Rotation = 0 }, Enum.EasingStyle.Elastic)
		end

		-- Badges (4 fois par seconde : la Dopamine monte en continu)
		badgeClock += dt
		if badgeClock >= 0.25 then
			badgeClock = 0
			refreshBadges()
		end
	end)

	-- Petit rappel tant que le joueur n'a jamais cliqué
	task.spawn(function()
		while buttonHolder.Parent do
			local data = ClientState.Data
			if data and data.Stats and (data.Stats.TotalClicks or 0) == 0 then
				UIUtil.Tween(buttonHolder, 0.25, { Rotation = 5 }, Enum.EasingStyle.Sine)
				task.wait(0.25)
				UIUtil.Tween(buttonHolder, 0.25, { Rotation = -5 }, Enum.EasingStyle.Sine)
				task.wait(0.25)
				UIUtil.Tween(buttonHolder, 0.25, { Rotation = 0 }, Enum.EasingStyle.Sine)
			end
			task.wait(2)
		end
	end)

	-- Écran qui change (téléphone <-> tablette, rotation) : pastilles et largeurs
	local function relayout()
		if Interface.Device ~= pillsDevice then
			buildPills(pillsStack, 5)
			refreshPills(true)
			refreshBadges()
		elseif pillsRow and pillsRow:IsA("ScrollingFrame") then
			local row = pillsRow :: ScrollingFrame
			row.Size = UDim2.fromOffset(pillsRowWidth(), row.Size.Y.Offset)
		end
	end
	Interface.DeviceChanged:Connect(relayout)
	Slots.Changed:Connect(relayout)

	if ClientState.Data then
		onState(ClientState.Data)
		refreshPills()
	end
	return column
end

return CenterColumn
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">DebugTools</string>
            <string name="Source"><![CDATA[--[[
	DebugTools (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > DebugTools

	Outils de TEST, actifs UNIQUEMENT dans Roblox Studio :
	  - DebugTools.Run(commande, argument) : appelle la RemoteFunction
	    "DebugCommand" (le serveur refuse tout hors de Studio) et renvoie
	    (succès, message). Utilisé par le panneau "🛠️ Test".
	  - DebugTools.RegisterChatCommands() : déclare des TextChatCommand
	    CÔTÉ CLIENT (/give, /unlockall, /spawn...) : leur événement Triggered
	    se déclenche de façon fiable côté client, puis appelle la même
	    RemoteFunction. Le résultat s'affiche dans le chat (message système)
	    et en bandeau. Les commandes identiques déclarées par le serveur sont
	    désactivées localement (pas de doublon ; le serveur ignore de toute
	    façon une commande reçue deux fois dans la même seconde).
	  - /test ouvre le panneau de test ; /aide liste les commandes.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")

local Client = script.Parent.Parent
local Theme = require(Client.Theme)
local Signal = require(ReplicatedStorage.Shared.Signal)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Notifications = require(script.Parent.Notifications)

local DebugTools = {}

DebugTools.Enabled = RunService:IsStudio()
DebugTools.Ran = Signal.new() -- (commande, argument, succès, message) après chaque commande

-- Appelé par /test (branché par ClientMain : ouvre le panneau de test)
DebugTools.OpenPanel = nil :: (() -> ())?

local REMOTE_TIMEOUT = 5
local FOLDER_NAME = "DopamineClientCommands"

-- Commandes de chat : alias -> commande envoyée au serveur
-- ("/help" est déjà pris par Roblox : on utilise "/aide")
local CHAT_COMMANDS = {
	{ Alias = "give", Command = "give", Help = "/give 1e6" },
	{ Alias = "rush", Command = "rush", Help = "/rush" },
	{ Alias = "daily", Command = "daily", Help = "/daily" },
	{ Alias = "save", Command = "save", Help = "/save" },
	{ Alias = "corner", Command = "corner", Help = "/corner" },
	{ Alias = "unlockall", Command = "unlockall", Help = "/unlockall" },
	{ Alias = "spawn", Command = "spawn", Help = "/spawn golden" },
	{ Alias = "golden", Command = "golden", Help = "/golden" },
	{ Alias = "detox", Command = "detox", Help = "/detox" },
	{ Alias = "chest", Command = "chest", Help = "/chest 3" },
	{ Alias = "reset", Command = "reset", Help = "/reset" },
	{ Alias = "pass", Command = "pass", Help = "/pass vip" },
	{ Alias = "boost", Command = "boost", Help = "/boost 5 60" },
	{ Alias = "theme", Command = "theme", Help = "/theme kawaii" },
	{ Alias = "offline", Command = "offline", Help = "/offline 7200" },
	{ Alias = "aide", Command = "help", Help = "/aide" },
}

local registered = false
local lastDuplicate = false -- la dernière commande était un doublon (déjà exécutée)
local myCommands: { [TextChatCommand]: boolean } = {}
local myAliases: { [string]: boolean } = {} -- "/give" -> true

-- Texte d'aide (liste des commandes de chat)
function DebugTools.HelpText(): string
	local list = {}
	for _, entry in ipairs(CHAT_COMMANDS) do
		table.insert(list, entry.Help)
	end
	table.insert(list, "/test")
	return table.concat(list, "  ")
end

-- RemoteFunction "DebugCommand" (sans attente infinie si le serveur ne l'a pas)
local function getRemote(): RemoteFunction?
	local folder = ReplicatedStorage:WaitForChild("Remotes", REMOTE_TIMEOUT)
	if not folder then
		return nil
	end
	local remote = folder:WaitForChild("DebugCommand", REMOTE_TIMEOUT)
	if remote and remote:IsA("RemoteFunction") then
		return remote
	end
	return nil
end

-- Lance une commande de test sur le serveur (bloque le thread appelant).
-- Renvoie (succès, message).
function DebugTools.Run(command: string, argument: string?): (boolean, string)
	if not DebugTools.Enabled then
		return false, Locale.T("Test commands are only available in Studio")
	end
	local remote = getRemote()
	if not remote then
		return false, Locale.T("DebugCommand RemoteFunction not found (server out of date?)")
	end
	local ok, success, message, duplicate = pcall(function()
		return remote:InvokeServer(command, argument or "")
	end)
	local result: boolean
	local text: string
	if not ok then
		result, text = false, Locale.T("Network error: %s", tostring(success))
	else
		result = success == true
		text = message ~= nil and tostring(message) or (result and "OK" or Locale.T("Refused"))
		-- 3e valeur du serveur : commande déjà exécutée (doublon du chat)
		if duplicate == true then
			lastDuplicate = true
		end
	end
	DebugTools.Ran:Fire(command, argument or "", result, text)
	return result, text
end

----------------------------------------------------------------------
-- Commandes de chat (client)
----------------------------------------------------------------------

-- Affiche un message système dans la fenêtre de chat (si possible)
local function systemMessage(text: string)
	pcall(function()
		local channels = TextChatService:FindFirstChild("TextChannels")
		local channel = channels and channels:FindFirstChild("RBXSystem")
		if channel and channel:IsA("TextChannel") then
			channel:DisplaySystemMessage(text)
		end
	end)
end

-- Désactive (localement) une commande déclarée ailleurs avec un de nos alias
local function disableDuplicate(instance: Instance)
	if not instance:IsA("TextChatCommand") or myCommands[instance] then
		return
	end
	local primary = string.lower(instance.PrimaryAlias)
	local secondary = string.lower(instance.SecondaryAlias)
	if myAliases[primary] or myAliases[secondary] then
		pcall(function()
			instance.Enabled = false
		end)
	end
end

local function onTriggered(entry, text: string)
	-- "/give 1e6" -> argument "1e6" ; "/boost 5 60" -> "5 60"
	local argument = string.match(text, "^%s*/%S+%s*(.-)%s*$") or ""
	task.spawn(function()
		lastDuplicate = false
		local ok, message = DebugTools.Run(entry.Command, argument)
		if lastDuplicate or message == "(already run)" or message == "(déjà exécutée)" then
			return
		end
		systemMessage((ok and "🛠️ " or "❌ ") .. message)
		if not ok then
			Notifications.Toast(message, Theme.Colors.Red, 4, Locale.T("Command /%s", entry.Alias), false, "🛠️")
		end
	end)
end

function DebugTools.RegisterChatCommands()
	if not DebugTools.Enabled or registered then
		return
	end
	registered = true
	-- Les TextChatCommand ne marchent qu'avec le nouveau chat (TextChatService)
	local okVersion, isNewChat = pcall(function()
		return TextChatService.ChatVersion == Enum.ChatVersion.TextChatService
	end)
	if not okVersion or not isNewChat then
		return
	end

	local ok, err = pcall(function()
		local old = TextChatService:FindFirstChild(FOLDER_NAME)
		if old then
			old:Destroy()
		end
		local folder = Instance.new("Folder")
		folder.Name = FOLDER_NAME

		local function add(alias: string, callback: (text: string) -> ())
			local command = Instance.new("TextChatCommand")
			command.Name = "ClientDebug_" .. alias
			command.PrimaryAlias = "/" .. alias
			myCommands[command] = true
			myAliases["/" .. alias] = true
			command.Triggered:Connect(function(_source: TextSource, text: string)
				callback(text)
			end)
			command.Parent = folder
		end

		for _, entry in ipairs(CHAT_COMMANDS) do
			add(entry.Alias, function(text: string)
				onTriggered(entry, text)
			end)
		end
		add("test", function()
			local open = DebugTools.OpenPanel
			if open then
				open()
			end
		end)
		folder.Parent = TextChatService
	end)
	if not ok then
		warn("[DebugTools] Impossible de déclarer les commandes de chat : " .. tostring(err))
		return
	end

	-- Commandes du serveur avec le même alias : désactivées ici (une seule exécution)
	for _, descendant in ipairs(TextChatService:GetDescendants()) do
		disableDuplicate(descendant)
	end
	TextChatService.DescendantAdded:Connect(disableDuplicate)
end

return DebugTools
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="8">
          <Properties>
            <string name="Name">House</string>
          </Properties>
          <Item class="ModuleScript" referent="9">
            <Properties>
              <string name="Name">HouseCommon</string>
              <string name="Source"><![CDATA[--[[
	HouseCommon (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > HouseCommon

	Outils partagés de "🏠 Ma maison" côté client :
	  - accès typé à Config.House (tailles, papiers peints, sols, objets) ;
	  - lecture de ClientState.Data.House (avec valeurs par défaut) ;
	  - prix (Formulas.GetHouseItemPrice), exemplaires possédés / posés,
	    confort et bonus (mêmes formules que le serveur) ;
	  - bornes des zones "Wall" (haut) / "Floor" (bas) de la pièce ;
	  - appel du serveur : Net.Function("House"):InvokeServer(action, arg)
	    protégé par pcall ;
	  - palette kawaii (roses, lilas, menthe) utilisée par tous les modules
	    de la maison.
	Aucune interface ici (utilisé aussi par la colonne centrale pour son badge).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent.Parent
local ClientState = require(Client.ClientState)
local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Net = require(ReplicatedStorage.Shared.Net)
local Locale = require(ReplicatedStorage.Shared.Locale)

export type Item = {
	Id: string,
	Name: string,
	Icon: string,
	Category: string,
	Placement: string, -- "Floor" | "Wall"
	Size: number,
	Cost: number,
	CostGrowth: number,
	Comfort: number,
	MaxOwned: number?,
	Order: number?,
}

export type SizeDef = {
	Id: string,
	Name: string,
	Icon: string,
	Cost: number,
	Width: number,
	MaxItems: number,
	Order: number?,
}

export type Style = {
	Id: string,
	Name: string,
	Icon: string?,
	Cost: number,
	Pattern: string,
	A: Color3,
	B: Color3,
	Order: number?,
}

export type Category = { Id: string, Name: string, Icon: string, Order: number? }

-- Un objet posé (format du serveur)
export type Placed = { I: string, X: number, Y: number, S: number, Z: number }

export type HouseData = {
	Size: string,
	Wallpaper: string,
	Floor: string,
	OwnedSizes: { [string]: boolean },
	OwnedWallpapers: { [string]: boolean },
	OwnedFloors: { [string]: boolean },
	Items: { [string]: number },
	Placed: { Placed },
}

export type HouseConfig = {
	ComfortBonusPerPoint: number,
	MaxComfortBonus: number,
	WallRatio: number,
	Sizes: { SizeDef },
	Wallpapers: { Style },
	Floors: { Style },
	Categories: { Category },
	Items: { Item },
}

local HouseCommon = {}

-- Config typée (le tableau de Config.luau mélange des objets avec / sans MaxOwned)
local rawConfig = (Config :: any).House
local EMPTY_CONFIG: HouseConfig = {
	ComfortBonusPerPoint = 0,
	MaxComfortBonus = 0,
	WallRatio = 0.46,
	Sizes = { { Id = "Studio", Name = "Cozy studio", Icon = "🏠", Cost = 0, Width = 1, MaxItems = 25 } },
	Wallpapers = {},
	Floors = {},
	Categories = {},
	Items = {},
}
HouseCommon.Config = (type(rawConfig) == "table" and rawConfig or EMPTY_CONFIG) :: HouseConfig

HouseCommon.ItemsById = ((Config :: any).HouseItemsById or {}) :: { [string]: Item }
HouseCommon.SizesById = ((Config :: any).HouseSizesById or {}) :: { [string]: SizeDef }
HouseCommon.WallpapersById = ((Config :: any).HouseWallpapersById or {}) :: { [string]: Style }
HouseCommon.FloorsById = ((Config :: any).HouseFloorsById or {}) :: { [string]: Style }
HouseCommon.CategoriesById = ((Config :: any).HouseCategoriesById or {}) :: { [string]: Category }

-- Échelle des objets posés (bornes du serveur) et pas des boutons ➕ / ➖
HouseCommon.MIN_SCALE = 0.6
HouseCommon.MAX_SCALE = 1.6
HouseCommon.SCALE_STEP = 0.1
-- Couche de départ d'un objet posé (Z) : de la place pour "reculer" (0..999)
HouseCommon.DEFAULT_Z = 100
HouseCommon.MAX_Z = 999

-- Palette kawaii
HouseCommon.Colors = {
	Pink = Color3.fromRGB(255, 126, 182),
	PinkDeep = Color3.fromRGB(236, 72, 140),
	PinkSoft = Color3.fromRGB(255, 214, 232),
	PinkMist = Color3.fromRGB(255, 240, 247),
	Lilac = Color3.fromRGB(183, 148, 246),
	LilacSoft = Color3.fromRGB(236, 224, 255),
	Mint = Color3.fromRGB(110, 214, 176),
	MintSoft = Color3.fromRGB(214, 247, 234),
	Cream = Color3.fromRGB(255, 247, 236),
	Peach = Color3.fromRGB(255, 190, 160),
	Sky = Color3.fromRGB(150, 205, 255),
	Butter = Color3.fromRGB(255, 226, 130),
	Heart = Color3.fromRGB(255, 79, 139),
	Wood = Color3.fromRGB(214, 164, 120),
	WoodDark = Color3.fromRGB(160, 110, 78),
	Ink = Color3.fromRGB(92, 58, 96), -- texte "chocolat-prune" sur fond pastel
}

-- Fond pastel de la vignette d'un objet, selon sa catégorie
local CATEGORY_TINTS: { [string]: Color3 } = {
	Furniture = Color3.fromRGB(255, 228, 206),
	Decor = Color3.fromRGB(255, 222, 238),
	Toys = Color3.fromRGB(255, 240, 200),
	Plants = Color3.fromRGB(216, 245, 222),
	Electronics = Color3.fromRGB(214, 232, 255),
	Kitchen = Color3.fromRGB(255, 226, 222),
	Doors = Color3.fromRGB(236, 224, 210),
	Windows = Color3.fromRGB(214, 240, 255),
	Lights = Color3.fromRGB(255, 244, 196),
}

function HouseCommon.CategoryTint(categoryId: string): Color3
	return CATEGORY_TINTS[categoryId] or HouseCommon.Colors.PinkSoft
end

----------------------------------------------------------------------
-- Données
----------------------------------------------------------------------

local function mapOf(value): { [string]: any }
	if type(value) == "table" then
		return value
	end
	return {}
end

-- Maison du joueur (jamais nil : valeurs par défaut avant le premier état)
function HouseCommon.GetHouse(data: any): HouseData
	local house = type(data) == "table" and data.House or nil
	local config = HouseCommon.Config
	local firstSize = config.Sizes[1]
	local firstWallpaper = config.Wallpapers[1]
	local firstFloor = config.Floors[1]
	if type(house) ~= "table" then
		house = {}
	end
	local placed = {}
	if type(house.Placed) == "table" then
		for _, entry in ipairs(house.Placed) do
			if type(entry) == "table" and type(entry.I) == "string" then
				table.insert(placed, {
					I = entry.I,
					X = tonumber(entry.X) or 0.5,
					Y = tonumber(entry.Y) or 0.8,
					S = tonumber(entry.S) or 1,
					Z = tonumber(entry.Z) or 0,
				})
			end
		end
	end
	return {
		Size = type(house.Size) == "string" and house.Size or (firstSize and firstSize.Id or "Studio"),
		Wallpaper = type(house.Wallpaper) == "string" and house.Wallpaper or (firstWallpaper and firstWallpaper.Id or ""),
		Floor = type(house.Floor) == "string" and house.Floor or (firstFloor and firstFloor.Id or ""),
		OwnedSizes = mapOf(house.OwnedSizes),
		OwnedWallpapers = mapOf(house.OwnedWallpapers),
		OwnedFloors = mapOf(house.OwnedFloors),
		Items = mapOf(house.Items),
		Placed = placed,
	}
end

function HouseCommon.GetSize(house: HouseData): SizeDef
	return HouseCommon.SizesById[house.Size] or HouseCommon.Config.Sizes[1]
end

function HouseCommon.GetWallpaper(house: HouseData): Style?
	return HouseCommon.WallpapersById[house.Wallpaper] or HouseCommon.Config.Wallpapers[1]
end

function HouseCommon.GetFloor(house: HouseData): Style?
	return HouseCommon.FloorsById[house.Floor] or HouseCommon.Config.Floors[1]
end

-- Exemplaires possédés d'un objet
function HouseCommon.Owned(house: HouseData, itemId: string): number
	return math.max(0, math.floor(tonumber(house.Items[itemId]) or 0))
end

-- Exemplaires posés d'un objet dans une disposition
function HouseCommon.PlacedCount(placed: { Placed }, itemId: string): number
	local count = 0
	for _, entry in ipairs(placed) do
		if entry.I == itemId then
			count += 1
		end
	end
	return count
end

-- Prix du prochain exemplaire
function HouseCommon.Price(item: Item, owned: number): number
	return Formulas.GetHouseItemPrice(item, owned)
end

-- Vrai si on ne peut plus en acheter (MaxOwned atteint)
function HouseCommon.IsMaxed(item: Item, owned: number): boolean
	return item.MaxOwned ~= nil and owned >= (item.MaxOwned :: number)
end

-- Dopamine sûre (sans l'extrapolation des gains passifs)
function HouseCommon.Dopamine(): number
	local ok, value = pcall(ClientState.GetConfirmedDopamine)
	if ok and type(value) == "number" then
		return value
	end
	return 0
end

-- Confort d'une disposition (même calcul que le serveur : objets possédés,
-- au plus MaxItems de la taille)
function HouseCommon.Comfort(house: HouseData, placed: { Placed }): number
	local ok, value = pcall(Formulas.GetHouseComfort, {
		House = { Size = house.Size, Items = house.Items, Placed = placed },
	})
	if ok and type(value) == "number" then
		return value
	end
	return 0
end

-- Bonus en % sur tous les gains (ex. 17 pour +17 %)
function HouseCommon.BonusPercent(comfort: number): number
	local ok, multiplier = pcall(Formulas.GetHouseBonus, comfort)
	if ok and type(multiplier) == "number" then
		return math.max(0, (multiplier - 1) * 100)
	end
	return 0
end

-- "17" / "2.5" : pourcentage lisible
function HouseCommon.FormatPercent(value: number): string
	if value >= 10 or math.abs(value - math.floor(value)) < 0.05 then
		return tostring(math.floor(value + 0.5))
	end
	return string.format("%.1f", value)
end

-- Objets jamais achetés qu'on peut se payer maintenant (badges)
function HouseCommon.AffordableNew(data: any, dopamine: number): { string }
	local result = {}
	if type(data) ~= "table" then
		return result
	end
	local house = HouseCommon.GetHouse(data)
	for _, item in ipairs(HouseCommon.Config.Items) do
		if HouseCommon.Owned(house, item.Id) == 0 and dopamine >= HouseCommon.Price(item, 0) then
			table.insert(result, item.Id)
		end
	end
	return result
end

-- Nom traduit d'un objet / d'une entrée de config
function HouseCommon.Name(entry: { Name: string }): string
	return Locale.T(entry.Name)
end

----------------------------------------------------------------------
-- Zones de la pièce
----------------------------------------------------------------------

-- Bornes (Y) de la zone d'un objet : "Wall" = haut, "Floor" = bas
-- (un peu plus serrées que celles du serveur : l'objet reste bien dans sa zone)
function HouseCommon.ZoneBounds(placement: string): (number, number)
	local ratio = HouseCommon.Config.WallRatio
	if placement == "Wall" then
		return 0.1, ratio - 0.03
	end
	return ratio + 0.035, 0.985
end

-- Position corrigée d'un objet : dans sa zone, sans sortir de la pièce.
-- `roomWidth` / `roomHeight` : taille de la pièce en px de maquette.
function HouseCommon.ClampPosition(item: Item, x: number, y: number, scale: number, roomWidth: number, roomHeight: number): (number, number)
	local half = (item.Size * scale * 0.38) / math.max(1, roomWidth)
	half = math.clamp(half, 0.015, 0.2)
	local minY, maxY = HouseCommon.ZoneBounds(item.Placement)
	local ratio = HouseCommon.Config.WallRatio
	local sizeY = (item.Size * scale) / math.max(1, roomHeight)
	if item.Placement == "Wall" then
		-- Objet centré sur Y : il reste (presque) entier sur le mur, sans
		-- passer sous le plafond ni trop descendre sur le sol
		local halfY = sizeY * 0.4
		minY = math.max(minY, halfY + 0.02)
		maxY = math.max(0.1, math.min(maxY, ratio - halfY * 0.7))
		if minY > maxY then
			-- Objet plus haut que le mur : centré sur le mur
			minY = math.min(maxY, ratio / 2 + 0.02)
			maxY = minY
		end
	else
		-- Objet posé par ses pieds : sa tête ne traverse pas le plafond
		minY = math.min(maxY, math.max(minY, sizeY * 0.92 - 0.02))
	end
	return math.clamp(x, half, 1 - half), math.clamp(y, minY, maxY)
end

----------------------------------------------------------------------
-- Serveur
----------------------------------------------------------------------

-- Appel protégé : (succès, message?)
function HouseCommon.Invoke(action: string, argument: any): (boolean, string?)
	local ok, success, message = pcall(function()
		return Net.Function("House"):InvokeServer(action, argument)
	end)
	if not ok then
		return false, Locale.T("Network error, try again.")
	end
	return success == true, message ~= nil and tostring(message) or nil
end

-- Petit hachage déterministe d'un texte (détails "aléatoires" mais stables)
function HouseCommon.Hash(text: string): number
	local hash = 5381
	for index = 1, #text do
		hash = (hash * 33 + string.byte(text, index)) % 2147483647
	end
	return hash
end

return HouseCommon
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="10">
            <Properties>
              <string name="Name">HouseEditor</string>
              <string name="Source"><![CDATA[--[[
	HouseEditor (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > HouseEditor

	Disposition des objets de la maison (côté client) :
	  - copie locale de data.House.Placed + un "autocollant" par objet
	    (HouseRoom.CreateSticker), triés en profondeur : objets muraux
	    derrière, tapis à plat, puis objets au sol (couche Z, puis Y : plus
	    bas = devant) ;
	  - MODE ÉDITION : glisser-déposer fluide à la souris ET au doigt
	    (InputBegan sur l'objet, InputChanged / InputEnded globaux,
	    conversion écran -> pièce), l'objet reste dans sa zone (mur / sol),
	    zone valide mise en valeur, petit "plop" à la pose ;
	  - sélection + barre d'outils flottante : ➖ plus petit, ➕ plus grand,
	    ⏫ devant, ⏬ derrière, 📦 ranger dans l'inventaire (raccourcis
	    clavier : + / - / Suppr) ;
	  - pose depuis l'inventaire (Place) à un endroit libre ;
	  - sauvegarde automatique "saveLayout" ~1,5 s après la dernière
	    modification (nouvel essai si le serveur refuse, puis resynchro) ;
	  - hors édition : toucher un objet le fait rebondir (petits cœurs).
	Le serveur revérifie tout (objets possédés, nombre max, zones).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Client = script.Parent.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local Interface = require(Client.Interface)
local Effects = require(Client.Effects)
local SoundManager = require(Client.SoundManager)
local Signal = require(ReplicatedStorage.Shared.Signal)
local Locale = require(ReplicatedStorage.Shared.Locale)
local HouseCommon = require(script.Parent.HouseCommon)
local HouseRoom = require(script.Parent.HouseRoom)

type Placed = HouseCommon.Placed
type HouseData = HouseCommon.HouseData
type Item = HouseCommon.Item
type Room = HouseRoom.Room
type Sticker = HouseRoom.Sticker

local HouseEditor = {}

local SAVE_DELAY = 1.5 -- (s) après la dernière modification
local RETRY_DELAY = 1.2 -- (s) nouvel essai si le serveur refuse
local SYNC_BLOCK = 2.5 -- (s) après une sauvegarde : on ignore les anciens états du serveur
local DRAG_THRESHOLD = 6 -- (px écran) en dessous : c'est un simple toucher
local DRAG_SMOOTHING = 24 -- vitesse de rattrapage du doigt (plus = plus collé)
local LIFT_SCALE = 1.1

local C = HouseCommon.Colors
local WHITE = Color3.new(1, 1, 1)

export type SaveStatus = "idle" | "dirty" | "saving" | "saved" | "error"

export type Editor = {
	Changed: any, -- Signal () : disposition modifiée (confort, inventaire)
	SaveStatusChanged: any, -- Signal (status: SaveStatus)
	SelectionChanged: any, -- Signal (entry: Placed?)
	SetEditing: (editing: boolean) -> (),
	IsEditing: () -> boolean,
	SetActive: (active: boolean) -> (),
	Sync: (house: HouseData, force: boolean?) -> (),
	GetLayout: () -> { Placed },
	Available: (itemId: string) -> number,
	CanPlace: (itemId: string) -> (boolean, string?),
	Place: (itemId: string) -> boolean,
	Deselect: () -> (),
	Flush: () -> (),
	IsBusy: () -> boolean,
	Update: (dt: number) -> (),
}

type Drag = {
	Entry: Placed,
	Input: InputObject,
	Offset: Vector2,
	Target: Vector2,
	Start: Vector2,
	Moved: boolean,
}

-- Rang de la zone : muraux derrière, objets à plat (tapis), puis le sol
local function zoneRank(sticker: Sticker): number
	if sticker.Item.Placement == "Wall" then
		return 0
	elseif sticker.Flat then
		return 1
	end
	return 2
end

-- Texte d'un nombre avec ses décimales utiles (sauvegarde plus légère)
local function roundTo(value: number, step: number): number
	return math.floor(value / step + 0.5) * step
end

local function signature(list: { Placed }): string
	local parts = table.create(#list)
	for index, entry in ipairs(list) do
		parts[index] = string.format("%s:%.4f:%.4f:%.3f:%d", entry.I, entry.X, entry.Y, entry.S, math.floor(entry.Z))
	end
	return table.concat(parts, ";")
end

function HouseEditor.new(room: Room, notify: (text: string, color: Color3?) -> ()): Editor
	local editor: Editor
	local house: HouseData = HouseCommon.GetHouse(nil)
	local layout: { Placed } = {}
	local stickers: { [Placed]: Sticker } = {}
	local selected: Placed? = nil
	local drag: Drag? = nil
	local editing = false
	local active = false
	local dirty = false
	local saving = false
	local saveAt = 0
	local failures = 0
	local blockUntil = 0
	local lastSignature = ""
	local clock = 0

	local changed = Signal.new()
	local saveStatusChanged = Signal.new()
	local selectionChanged = Signal.new()

	----------------------------------------------------------------------
	-- Barre d'outils de sélection
	----------------------------------------------------------------------

	local toolbar = UIUtil.Create("Frame", {
		Name = "Toolbar",
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 20,
		Parent = room.Overlay,
	})
	local toolbarScale = UIUtil.Create("UIScale", { Parent = toolbar })
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 4),
		Parent = toolbar,
	})
	local nameChip = UIUtil.Chip({
		Name = "NameChip",
		Text = "",
		Color = C.PinkDeep,
		TextColor3 = WHITE,
		Height = 24,
		TextSize = 14,
		LayoutOrder = 1,
		ZIndex = 21,
		Parent = toolbar,
	})
	local bar = UIUtil.Create("Frame", {
		Name = "Bar",
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundColor3 = WHITE,
		LayoutOrder = 2,
		ZIndex = 21,
		Parent = toolbar,
	})
	UIUtil.Corner(bar, UDim.new(1, 0))
	UIUtil.Stroke(bar, C.Pink, 2, 0.1)
	UIUtil.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 6),
		PaddingRight = UDim.new(0, 6),
		PaddingTop = UDim.new(0, 5),
		PaddingBottom = UDim.new(0, 5),
		Parent = bar,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 5),
		Parent = bar,
	})

	local toolButtons: { TextButton } = {}
	local function toolButton(order: number, icon: string, caption: string, color: Color3): TextButton
		local size = Interface.IsTouch() and Theme.TouchTarget or 40
		local button = UIUtil.Create("TextButton", {
			Name = caption,
			Size = UDim2.fromOffset(size + 8, size + 12),
			BackgroundColor3 = color,
			AutoButtonColor = false,
			Text = "",
			LayoutOrder = order,
			ZIndex = 22,
			Parent = bar,
		})
		UIUtil.Corner(button, 14)
		UIUtil.Gradient(button, ColorSequence.new(WHITE, Color3.fromRGB(228, 228, 228)), 90)
		UIUtil.Create("TextLabel", {
			Name = "Icon",
			Size = UDim2.new(1, 0, 1, -14),
			BackgroundTransparency = 1,
			Font = Theme.Fonts.Title,
			Text = icon,
			TextColor3 = C.Ink,
			TextSize = math.floor(size * 0.52),
			ZIndex = 23,
			Parent = button,
		})
		UIUtil.Create("TextLabel", {
			Name = "Caption",
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 0, 1, -2),
			Size = UDim2.new(1, 0, 0, 12),
			BackgroundTransparency = 1,
			Font = Theme.Fonts.Title,
			Text = Locale.T(caption),
			TextColor3 = C.Ink,
			TextScaled = true,
			ZIndex = 23,
			Parent = button,
		})
		UIUtil.AnimateButton(button, 1.08, 0.9)
		table.insert(toolButtons, button)
		return button
	end
	local smallerButton = toolButton(1, "➖", "Smaller", C.LilacSoft)
	local biggerButton = toolButton(2, "➕", "Bigger", C.LilacSoft)
	local backButton = toolButton(3, "⏬", "Back", C.MintSoft)
	local frontButton = toolButton(4, "⏫", "Front", C.MintSoft)
	local storeButton = toolButton(5, "📦", "Store", C.PinkSoft)

	-- Pastille "+2 ❤️" etc. au-dessus d'un objet (calque des effets)
	local function floatAt(sticker: Sticker, text: string, color: Color3)
		local layer = Effects.GetLayer()
		if not layer or not sticker.Frame.Parent then
			return
		end
		local center = Interface.GetCanvasCenter(sticker.Body)
		Effects.FloatingText(layer, UDim2.fromOffset(center.X, center.Y - 20), text, color, 26)
	end

	local function burstAt(sticker: Sticker, color: Color3?, count: number?)
		local layer = Effects.GetLayer()
		if not layer or not sticker.Frame.Parent then
			return
		end
		local center = Interface.GetCanvasCenter(sticker.Body)
		Effects.Burst(layer, UDim2.fromOffset(center.X, center.Y), color, count or 8)
	end

	----------------------------------------------------------------------
	-- Profondeur et barre d'outils
	----------------------------------------------------------------------

	-- Clé de tri : (zone, couche Z, Y, X)
	local function sortedEntries(): { Placed }
		local list = table.clone(layout)
		table.sort(list, function(a, b)
			local sa, sb = stickers[a], stickers[b]
			local ra = sa and zoneRank(sa) or 2
			local rb = sb and zoneRank(sb) or 2
			if ra ~= rb then
				return ra < rb
			end
			if a.Z ~= b.Z then
				return a.Z < b.Z
			end
			if a.Y ~= b.Y then
				return a.Y < b.Y
			end
			return a.X < b.X
		end)
		return list
	end

	local function resort()
		for index, entry in ipairs(sortedEntries()) do
			local sticker = stickers[entry]
			if sticker then
				local dragged = drag ~= nil and (drag :: Drag).Entry == entry and (drag :: Drag).Moved
				sticker.Frame.ZIndex = dragged and 5000 or index + 10
			end
		end
	end

	-- Rectangle d'un objet dans la pièce (px de maquette) : (gauche, haut, droite, bas)
	local function rectOf(entry: Placed): (number, number, number, number)
		local sticker = stickers[entry]
		local item = sticker and sticker.Item or HouseCommon.ItemsById[entry.I]
		local size = (item and item.Size or 80) * entry.S
		local cx = entry.X * room.Width
		local halfW = size * (sticker and sticker.Flat and 0.7 or 0.4)
		if item and item.Placement == "Wall" then
			local cy = entry.Y * room.Height
			return cx - halfW, cy - size * 0.42, cx + halfW, cy + size * 0.42
		end
		local bottom = entry.Y * room.Height
		local top = bottom - size * (sticker and sticker.Flat and 0.4 or 0.9)
		return cx - halfW, top, cx + halfW, bottom
	end

	local function overlaps(a: Placed, b: Placed): boolean
		local al, at, ar, ab = rectOf(a)
		local bl, bt, br, bb = rectOf(b)
		return al < br and bl < ar and at < bb and bt < ab
	end

	local function positionToolbar()
		local entry = selected
		if not entry or not editing or (drag ~= nil and (drag :: Drag).Moved) then
			toolbar.Visible = false
			return
		end
		local sticker = stickers[entry]
		if not sticker then
			toolbar.Visible = false
			return
		end
		local scale = math.max(0.2, room.Scale)
		toolbarScale.Scale = 1 / scale
		local _, top, _, bottom = rectOf(entry)
		local toolbarSize = toolbar.AbsoluteSize
		local pixelRatio = room.Frame.AbsoluteSize.X / math.max(1, room.Width)
		local heightInRoom = pixelRatio > 0 and toolbarSize.Y / pixelRatio or 110 / scale
		local widthInRoom = pixelRatio > 0 and toolbarSize.X / pixelRatio or 300 / scale
		local x = math.clamp(entry.X * room.Width, widthInRoom / 2 - 10, room.Width - widthInRoom / 2 + 10)
		if top - heightInRoom - 8 >= -14 then
			toolbar.AnchorPoint = Vector2.new(0.5, 1)
			toolbar.Position = UDim2.fromOffset(x, top - 6)
		else
			toolbar.AnchorPoint = Vector2.new(0.5, 0)
			toolbar.Position = UDim2.fromOffset(x, math.min(bottom + 6, room.Height - heightInRoom + 10))
		end
		toolbar.Visible = true
	end

	local function refreshToolbarText()
		local entry = selected
		local item = entry and HouseCommon.ItemsById[entry.I]
		if not item then
			return
		end
		local label = nameChip:FindFirstChild("Label") :: TextLabel?
		if label then
			label.Text = string.format("%s %s  ❤️+%d", item.Icon, HouseCommon.Name(item), item.Comfort)
		end
		local s = (entry :: Placed).S
		smallerButton.BackgroundTransparency = s <= HouseCommon.MIN_SCALE + 1e-3 and 0.5 or 0
		biggerButton.BackgroundTransparency = s >= HouseCommon.MAX_SCALE - 1e-3 and 0.5 or 0
	end

	local function setSelected(entry: Placed?)
		if selected == entry then
			positionToolbar()
			return
		end
		local previous = selected
		if previous and stickers[previous] then
			room.ShowRing(stickers[previous], false)
		end
		selected = entry
		if entry and stickers[entry] then
			local sticker = stickers[entry]
			room.ShowRing(sticker, editing)
			refreshToolbarText()
			if editing then
				UIUtil.Pop(bar, 0.6, 0.3)
			end
		end
		positionToolbar()
		-- (taille réelle de la barre connue à l'image suivante)
		task.defer(positionToolbar)
		selectionChanged:Fire(entry)
	end

	----------------------------------------------------------------------
	-- Sauvegarde automatique
	----------------------------------------------------------------------

	local doSave: () -> ()

	local function markDirty()
		dirty = true
		saveAt = os.clock() + SAVE_DELAY
		saveStatusChanged:Fire("dirty")
		changed:Fire()
	end

	doSave = function()
		if saving or not dirty then
			return
		end
		saving = true
		dirty = false
		local payload = table.create(#layout)
		for index, entry in ipairs(layout) do
			-- Mêmes arrondis que le serveur : la disposition renvoyée sera identique
			if not (drag ~= nil and (drag :: Drag).Entry == entry) then
				entry.X = roundTo(entry.X, 0.0001)
				entry.Y = roundTo(entry.Y, 0.0001)
				entry.S = roundTo(entry.S, 0.001)
				entry.Z = math.clamp(math.floor(entry.Z), 0, HouseCommon.MAX_Z)
			end
			payload[index] = {
				I = entry.I,
				X = roundTo(entry.X, 0.0001),
				Y = roundTo(entry.Y, 0.0001),
				S = roundTo(entry.S, 0.001),
				Z = math.clamp(math.floor(entry.Z), 0, HouseCommon.MAX_Z),
			}
		end
		saveStatusChanged:Fire("saving")
		task.spawn(function()
			local ok, message = HouseCommon.Invoke("saveLayout", payload)
			saving = false
			if ok then
				failures = 0
				blockUntil = os.clock() + SYNC_BLOCK
				lastSignature = signature(layout)
				if dirty then
					saveAt = math.max(saveAt, os.clock() + 0.6)
					saveStatusChanged:Fire("dirty")
				else
					saveStatusChanged:Fire("saved")
				end
				return
			end
			failures += 1
			if failures <= 2 then
				-- Refus passager (trop rapide, réseau) : on réessaie un peu plus tard
				dirty = true
				saveAt = os.clock() + RETRY_DELAY * failures
				saveStatusChanged:Fire("dirty")
				return
			end
			failures = 0
			saveStatusChanged:Fire("error")
			notify(message or Locale.T("Couldn't save your room, try again."), Theme.Colors.Red)
			-- On revient à la dernière disposition connue du serveur
			blockUntil = 0
			editor.Sync(house, true)
		end)
	end

	----------------------------------------------------------------------
	-- Autocollants
	----------------------------------------------------------------------

	local endDrag: () -> ()

	local function wiggle(sticker: Sticker)
		local body = sticker.Body
		body.Rotation = -10
		UIUtil.Tween(body, 0.5, { Rotation = 0 }, Enum.EasingStyle.Elastic)
		sticker.Pop.Scale = 1.15
		UIUtil.Tween(sticker.Pop, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	end

	local function beginDrag(entry: Placed, input: InputObject)
		local pointer = room.ScreenToRoom(Vector2.new(input.Position.X, input.Position.Y))
		drag = {
			Entry = entry,
			Input = input,
			Offset = Vector2.new(entry.X, entry.Y) - pointer,
			Target = Vector2.new(entry.X, entry.Y),
			Start = Vector2.new(input.Position.X, input.Position.Y),
			Moved = false,
		}
	end

	local function attachSticker(entry: Placed): Sticker?
		local item = HouseCommon.ItemsById[entry.I]
		if not item then
			return nil
		end
		local sticker = room.CreateSticker(item, entry)
		stickers[entry] = sticker
		sticker.Hit.InputBegan:Connect(function(input: InputObject)
			local kind = input.UserInputType
			if kind ~= Enum.UserInputType.MouseButton1 and kind ~= Enum.UserInputType.Touch then
				return
			end
			if not editing then
				wiggle(sticker)
				burstAt(sticker, C.Pink, 6)
				SoundManager.Play("Pop", 0.9 + math.random() * 0.3)
				return
			end
			local current = drag
			if current then
				-- Ancien glissement dont la fin a été perdue (bouton relâché hors de la fenêtre)
				if current.Input.UserInputState == Enum.UserInputState.End or current.Input.UserInputState == Enum.UserInputState.Cancel then
					endDrag()
				else
					return
				end
			end
			setSelected(entry)
			beginDrag(entry, input)
		end)
		sticker.Hit.MouseEnter:Connect(function()
			if editing and not drag then
				UIUtil.Tween(sticker.Pop, 0.12, { Scale = 1.05 }, Enum.EasingStyle.Back)
			end
		end)
		sticker.Hit.MouseLeave:Connect(function()
			if not drag or (drag :: Drag).Entry ~= entry then
				UIUtil.Tween(sticker.Pop, 0.12, { Scale = 1 })
			end
		end)
		return sticker
	end

	local function clearStickers()
		for _, sticker in pairs(stickers) do
			room.DestroySticker(sticker)
		end
		table.clear(stickers)
	end

	local function rebuildFrom(list: { Placed })
		local keepIndex: number? = nil
		if selected then
			keepIndex = table.find(layout, selected :: Placed)
		end
		drag = nil
		room.SetZoneHint(nil)
		clearStickers()
		layout = {}
		for _, entry in ipairs(list) do
			local copy = { I = entry.I, X = entry.X, Y = entry.Y, S = entry.S, Z = entry.Z }
			if attachSticker(copy) then
				table.insert(layout, copy)
			end
		end
		selected = nil
		-- Même objet toujours là (même place dans la liste) : il reste sélectionné
		if keepIndex and layout[keepIndex] then
			setSelected(layout[keepIndex])
		else
			setSelected(nil)
		end
		resort()
		lastSignature = signature(layout)
		changed:Fire()
	end

	----------------------------------------------------------------------
	-- Actions de la barre d'outils
	----------------------------------------------------------------------

	local function refuse(button: GuiObject, text: string?)
		SoundManager.Play("Error", 0.8)
		UIUtil.Shake(button)
		if text then
			notify(text, Theme.Colors.Orange)
		end
	end

	local function resize(delta: number, button: GuiObject)
		local entry = selected
		local sticker = entry and stickers[entry]
		if not entry or not sticker then
			return
		end
		local newScale = math.clamp(roundTo(entry.S + delta, 0.01), HouseCommon.MIN_SCALE, HouseCommon.MAX_SCALE)
		if math.abs(newScale - entry.S) < 1e-3 then
			refuse(button)
			return
		end
		entry.S = newScale
		-- Plus grand : l'objet doit rester dans sa zone
		entry.X, entry.Y = HouseCommon.ClampPosition(sticker.Item, entry.X, entry.Y, entry.S, room.Width, room.Height)
		sticker.Frame.Position = UDim2.fromScale(entry.X, entry.Y)
		UIUtil.Tween(sticker.Scale, 0.2, { Scale = sticker.Item.Size * newScale / 100 }, Enum.EasingStyle.Back)
		local ringStroke = sticker.RingStroke
		if ringStroke then
			ringStroke.Thickness = 3 / math.max(0.2, sticker.Item.Size * newScale / 100)
		end
		SoundManager.Play("Click", delta > 0 and 1.2 or 0.85)
		refreshToolbarText()
		task.delay(0.21, positionToolbar)
		markDirty()
	end

	-- Devant / derrière : passe devant (ou derrière) TOUS les objets qui le chevauchent
	local function restack(forward: boolean, button: GuiObject)
		local entry = selected
		local sticker = entry and stickers[entry]
		if not entry or not sticker then
			return
		end
		local order = sortedEntries()
		local myIndex = table.find(order, entry) or 0
		local rank = zoneRank(sticker)
		local targetZ: number? = nil
		for index, other in ipairs(order) do
			local otherSticker = stickers[other]
			if other ~= entry and otherSticker and zoneRank(otherSticker) == rank and overlaps(entry, other) then
				if forward and index > myIndex then
					targetZ = math.max(targetZ or -math.huge, other.Z + 1)
				elseif not forward and index < myIndex then
					targetZ = math.min(targetZ or math.huge, other.Z - 1)
				end
			end
		end
		if targetZ == nil then
			refuse(button, forward and Locale.T("Already in front!") or Locale.T("Already at the back!"))
			return
		end
		entry.Z = math.clamp(targetZ :: number, 0, HouseCommon.MAX_Z)
		resort()
		wiggle(sticker)
		SoundManager.Play("Click", forward and 1.15 or 0.9)
		markDirty()
	end

	local function store(entry: Placed)
		local sticker = stickers[entry]
		local index = table.find(layout, entry)
		if not index then
			return
		end
		table.remove(layout, index)
		stickers[entry] = nil
		setSelected(nil)
		if sticker then
			burstAt(sticker, C.Lilac, 8)
			UIUtil.Tween(sticker.Pop, 0.18, { Scale = 0.1 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			task.delay(0.19, function()
				room.DestroySticker(sticker)
			end)
		end
		SoundManager.Play("Pop", 0.7)
		resort()
		markDirty()
	end

	smallerButton.Activated:Connect(function()
		resize(-HouseCommon.SCALE_STEP, smallerButton)
	end)
	biggerButton.Activated:Connect(function()
		resize(HouseCommon.SCALE_STEP, biggerButton)
	end)
	frontButton.Activated:Connect(function()
		restack(true, frontButton)
	end)
	backButton.Activated:Connect(function()
		restack(false, backButton)
	end)
	storeButton.Activated:Connect(function()
		local entry = selected
		if entry then
			store(entry)
		end
	end)

	room.BackgroundHit.Activated:Connect(function()
		if not drag then
			setSelected(nil)
		end
	end)
	room.Changed:Connect(positionToolbar)

	----------------------------------------------------------------------
	-- Glisser-déposer (souris + tactile)
	----------------------------------------------------------------------

	endDrag = function()
		local current = drag
		if not current then
			return
		end
		drag = nil
		local entry = current.Entry
		local sticker = stickers[entry]
		room.SetZoneHint(nil)
		if not sticker then
			return
		end
		if current.Moved then
			entry.X, entry.Y = current.Target.X, current.Target.Y
			sticker.Frame.Position = UDim2.fromScale(entry.X, entry.Y)
			-- "Plop" : l'objet se pose avec un petit rebond
			UIUtil.Tween(sticker.Body, 0.16, { Position = UDim2.fromOffset(0, 0), Rotation = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			sticker.Pop.Scale = 0.92
			UIUtil.Tween(sticker.Pop, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
			SoundManager.Play("Pop", 1.05 + math.random() * 0.15)
			resort()
			markDirty()
		else
			UIUtil.Tween(sticker.Pop, 0.12, { Scale = 1 })
			sticker.Body.Rotation = 0
		end
		positionToolbar()
	end

	UserInputService.InputChanged:Connect(function(input: InputObject)
		local current = drag
		if not current or not active then
			return
		end
		local kind = input.UserInputType
		local startedWithMouse = current.Input.UserInputType == Enum.UserInputType.MouseButton1
		local matches = (kind == Enum.UserInputType.MouseMovement and startedWithMouse)
			or (kind == Enum.UserInputType.Touch and input == current.Input)
		if not matches then
			return
		end
		local position = Vector2.new(input.Position.X, input.Position.Y)
		if not current.Moved then
			if (position - current.Start).Magnitude < DRAG_THRESHOLD then
				return
			end
			current.Moved = true
			local sticker = stickers[current.Entry]
			if sticker then
				UIUtil.Tween(sticker.Pop, 0.15, { Scale = LIFT_SCALE }, Enum.EasingStyle.Back)
				UIUtil.Tween(sticker.Body, 0.15, { Position = UDim2.fromOffset(0, -8) })
				room.SetZoneHint(sticker.Item.Placement)
				SoundManager.Play("Click", 1.3)
			end
			resort()
			toolbar.Visible = false
		end
		local sticker = stickers[current.Entry]
		if not sticker then
			return
		end
		local pointer = room.ScreenToRoom(position) + current.Offset
		local x, y = HouseCommon.ClampPosition(sticker.Item, pointer.X, pointer.Y, current.Entry.S, room.Width, room.Height)
		current.Target = Vector2.new(x, y)
	end)

	UserInputService.InputEnded:Connect(function(input: InputObject)
		local current = drag
		if not current then
			return
		end
		local kind = input.UserInputType
		local startedWithMouse = current.Input.UserInputType == Enum.UserInputType.MouseButton1
		if (kind == Enum.UserInputType.MouseButton1 and startedWithMouse) or (kind == Enum.UserInputType.Touch and input == current.Input) then
			endDrag()
		end
	end)

	-- Raccourcis clavier (PC) : + / - / Suppr
	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed or not active or not editing or not selected or input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		local key = input.KeyCode
		if key == Enum.KeyCode.Delete or key == Enum.KeyCode.Backspace then
			store(selected :: Placed)
		elseif key == Enum.KeyCode.Equals or key == Enum.KeyCode.KeypadPlus then
			resize(HouseCommon.SCALE_STEP, biggerButton)
		elseif key == Enum.KeyCode.Minus or key == Enum.KeyCode.KeypadMinus then
			resize(-HouseCommon.SCALE_STEP, smallerButton)
		elseif key == Enum.KeyCode.PageUp then
			restack(true, frontButton)
		elseif key == Enum.KeyCode.PageDown then
			restack(false, backButton)
		end
	end)

	-- Taille des boutons (tactile : zones de 44 px)
	Interface.DeviceChanged:Connect(function()
		local size = Interface.IsTouch() and Theme.TouchTarget or 40
		for _, button in ipairs(toolButtons) do
			button.Size = UDim2.fromOffset(size + 8, size + 12)
			local icon = button:FindFirstChild("Icon") :: TextLabel?
			if icon then
				icon.TextSize = math.floor(size * 0.52)
			end
		end
	end)

	----------------------------------------------------------------------
	-- Pose depuis l'inventaire
	----------------------------------------------------------------------

	local function available(itemId: string): number
		return math.max(0, HouseCommon.Owned(house, itemId) - HouseCommon.PlacedCount(layout, itemId))
	end

	local function canPlace(itemId: string): (boolean, string?)
		local item = HouseCommon.ItemsById[itemId]
		if not item then
			return false, nil
		end
		if available(itemId) <= 0 then
			return false, Locale.T("Buy one in the shop first!")
		end
		local maxItems = HouseCommon.GetSize(house).MaxItems
		if #layout >= maxItems then
			return false, Locale.T("Your house is full (%d items)! Move into a bigger one 🏡", maxItems)
		end
		return true, nil
	end

	-- Endroit libre (peu de chevauchements) dans la zone de l'objet
	local function freeSpot(item: Item): (number, number)
		local minY, maxY = HouseCommon.ZoneBounds(item.Placement)
		local best: Vector2? = nil
		local bestScore = math.huge
		local probe: Placed = { I = item.Id, X = 0.5, Y = (minY + maxY) / 2, S = 1, Z = HouseCommon.DEFAULT_Z }
		for attempt = 1, 14 do
			local x = 0.14 + math.random() * 0.72
			local y
			if item.Placement == "Wall" then
				y = minY + (maxY - minY) * (0.25 + math.random() * 0.5)
			else
				y = minY + (maxY - minY) * (0.35 + math.random() * 0.55)
			end
			probe.X, probe.Y = HouseCommon.ClampPosition(item, x, y, 1, room.Width, room.Height)
			local score = 0
			for _, other in ipairs(layout) do
				if overlaps(probe, other) then
					score += 1
				end
			end
			-- Un peu de préférence pour le centre (on voit l'objet arriver)
			score += math.abs(probe.X - 0.5) * 0.4 + attempt * 0.001
			if score < bestScore then
				bestScore = score
				best = Vector2.new(probe.X, probe.Y)
			end
		end
		local spot = best or Vector2.new(0.5, (minY + maxY) / 2)
		return spot.X, spot.Y
	end

	local function place(itemId: string): boolean
		local ok, reason = canPlace(itemId)
		if not ok then
			if reason then
				notify(reason, Theme.Colors.Orange)
			end
			SoundManager.Play("Error", 0.8)
			return false
		end
		local item = HouseCommon.ItemsById[itemId]
		local x, y = freeSpot(item)
		-- Nouvelle couche au-dessus des objets qu'il chevauche
		local entry: Placed = { I = itemId, X = x, Y = y, S = 1, Z = HouseCommon.DEFAULT_Z }
		for _, other in ipairs(layout) do
			if overlaps(entry, other) then
				entry.Z = math.max(entry.Z, other.Z)
			end
		end
		table.insert(layout, entry)
		local sticker = attachSticker(entry)
		if sticker then
			-- Arrivée : tombe du haut avec un rebond
			sticker.Pop.Scale = 0.2
			UIUtil.Tween(sticker.Pop, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
			sticker.Body.Position = UDim2.fromOffset(0, -40)
			UIUtil.Tween(sticker.Body, 0.45, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Bounce)
			task.delay(0.3, function()
				burstAt(sticker, C.Pink, 10)
				floatAt(sticker, string.format("+%d ❤️", item.Comfort), C.PinkDeep)
			end)
		end
		SoundManager.Play("Pop", 1.1)
		resort()
		if editing then
			setSelected(entry)
		end
		markDirty()
		return true
	end

	----------------------------------------------------------------------
	-- API
	----------------------------------------------------------------------

	editor = {
		Changed = changed,
		SaveStatusChanged = saveStatusChanged,
		SelectionChanged = selectionChanged,
		SetEditing = function(value: boolean)
			if editing == value then
				return
			end
			editing = value
			if not value then
				if drag then
					endDrag()
				end
				setSelected(nil)
			end
			local current = selected
			if current and stickers[current] then
				room.ShowRing(stickers[current], value)
			end
			positionToolbar()
		end,
		IsEditing = function(): boolean
			return editing
		end,
		SetActive = function(value: boolean)
			active = value
			if not value and drag then
				endDrag()
			end
		end,
		Sync = function(newHouse: HouseData, force: boolean?)
			house = newHouse
			if force ~= true and (dirty or saving or drag ~= nil or os.clock() < blockUntil) then
				return
			end
			local serverSignature = signature(newHouse.Placed)
			if serverSignature == lastSignature and force ~= true then
				return
			end
			if force == true then
				dirty = false
			end
			rebuildFrom(newHouse.Placed)
		end,
		GetLayout = function(): { Placed }
			return layout
		end,
		Available = available,
		CanPlace = canPlace,
		Place = place,
		Deselect = function()
			setSelected(nil)
		end,
		Flush = function()
			if drag then
				endDrag()
			end
			if dirty then
				doSave()
			end
		end,
		IsBusy = function(): boolean
			return dirty or saving
		end,
		Update = function(dt: number)
			clock += dt
			local current = drag
			if current and current.Moved then
				local entry = current.Entry
				local sticker = stickers[entry]
				if sticker then
					local alpha = 1 - math.exp(-DRAG_SMOOTHING * dt)
					entry.X += (current.Target.X - entry.X) * alpha
					entry.Y += (current.Target.Y - entry.Y) * alpha
					sticker.Frame.Position = UDim2.fromScale(entry.X, entry.Y)
					-- Petit balancement pendant le transport
					sticker.Body.Rotation = math.sin(clock * 9) * 4
				end
			end
			-- Contour de sélection qui "respire"
			local entry = selected
			if entry and editing and stickers[entry] then
				local ring = stickers[entry].Ring
				local ringStroke = stickers[entry].RingStroke
				if ring and ringStroke then
					ring.BackgroundTransparency = 0.84 + 0.08 * math.sin(clock * 4)
					ringStroke.Transparency = 0.1 + 0.25 * (0.5 + 0.5 * math.sin(clock * 4))
				end
			end
			-- Sauvegarde automatique
			if dirty and not saving and os.clock() >= saveAt then
				doSave()
			end
		end,
	}

	return editor
end

return HouseEditor
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="11">
            <Properties>
              <string name="Name">HousePatterns</string>
              <string name="Source"><![CDATA[--[[
	HousePatterns (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > HousePatterns

	Dessine les motifs des papiers peints et des sols UNIQUEMENT avec des
	Frames (pas d'image à importer) :
	  Murs : Plain (lambris), Stripes, Checker (vichy), Dots, Hearts, Stars
	         (étincelles), Clouds, Bricks, Wood (lambris de bois), Waves
	         (écailles / vaguelettes).
	  Sols : Plain, Checker, Wood, Tiles, Carpet, Marble, Herringbone
	         (parquet) — en PERSPECTIVE : les rangées grandissent vers
	         l'avant et les colonnes s'écartent depuis le centre (lignes de
	         fuite), sans aucune rotation.
	Le conteneur doit couper son contenu (ClipsDescendants) ; son fond
	prend la couleur A. `unit` agrandit / réduit le motif (1 dans la pièce,
	plus petit dans les aperçus de la boutique).
	Nombre de Frames limité (≈ 60 à 300 selon le motif et la largeur).

	API :
	  HousePatterns.BuildWall(container, largeur, hauteur, style, unit?)
	  HousePatterns.BuildFloor(container, largeur, hauteur, style, unit?)
	  (style = { Pattern, A, B } ; les anciens motifs sont remplacés)
]]

local HousePatterns = {}

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local SQRT2 = math.sqrt(2)

type Style = { Pattern: string, A: Color3, B: Color3 }

----------------------------------------------------------------------
-- Formes de base
----------------------------------------------------------------------

local function box(parent: Instance, x: number, y: number, w: number, h: number, color: Color3, transparency: number?, z: number?): Frame
	local frame = Instance.new("Frame")
	frame.BorderSizePixel = 0
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = transparency or 0
	frame.Position = UDim2.fromOffset(x, y)
	frame.Size = UDim2.fromOffset(w, h)
	frame.ZIndex = z or 1
	frame.Parent = parent
	return frame
end

local function roundify(frame: Frame, radius: UDim?)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = radius or UDim.new(1, 0)
	corner.Parent = frame
end

-- Cercle (ou ovale) centré
local function circle(parent: Instance, cx: number, cy: number, w: number, h: number, color: Color3, transparency: number?, z: number?): Frame
	local frame = box(parent, cx - w / 2, cy - h / 2, w, h, color, transparency, z)
	roundify(frame)
	return frame
end

-- Carré tourné de 45° (losange) centré
local function diamond(parent: Instance, cx: number, cy: number, side: number, color: Color3, transparency: number?, z: number?): Frame
	local frame = box(parent, 0, 0, side, side, color, transparency, z)
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromOffset(cx, cy)
	frame.Rotation = 45
	return frame
end

-- Cœur (2 cercles + un losange) centré, de largeur `width`
local function heart(parent: Instance, cx: number, cy: number, width: number, color: Color3, transparency: number?, z: number?)
	local a = width / (1 + 1 / SQRT2)
	local shift = a * 0.073 -- recentre la forme verticalement
	local centerY = cy + shift
	local offset = a / (2 * SQRT2)
	diamond(parent, cx, centerY, a, color, transparency, z)
	circle(parent, cx - offset, centerY - offset, a, a, color, transparency, z)
	circle(parent, cx + offset, centerY - offset, a, a, color, transparency, z)
end

-- Étincelle à 4 branches (losange + 2 bâtonnets arrondis)
local function sparkle(parent: Instance, cx: number, cy: number, size: number, color: Color3, transparency: number?, z: number?)
	diamond(parent, cx, cy, size * 0.36, color, transparency, z)
	local thin = math.max(1, size * 0.13)
	local vertical = box(parent, cx - thin / 2, cy - size / 2, thin, size, color, transparency, z)
	roundify(vertical)
	local horizontal = box(parent, cx - size / 2, cy - thin / 2, size, thin, color, transparency, z)
	roundify(horizontal)
end

-- Nuage (base arrondie + 2 bosses), `cy` = bas du nuage
local function cloud(parent: Instance, cx: number, cy: number, width: number, color: Color3, transparency: number?, z: number?)
	local baseH = width * 0.34
	local base = box(parent, cx - width / 2, cy - baseH, width, baseH, color, transparency, z)
	roundify(base)
	circle(parent, cx - width * 0.14, cy - baseH, width * 0.5, width * 0.5, color, transparency, z)
	circle(parent, cx + width * 0.2, cy - baseH * 0.9, width * 0.36, width * 0.36, color, transparency, z)
end

-- Pseudo-aléatoire stable (même dessin à chaque reconstruction)
local function noise(a: number, b: number): number
	local value = math.sin(a * 12.9898 + b * 78.233) * 43758.5453
	return value - math.floor(value)
end

local function clear(container: GuiObject): Frame
	local old = container:FindFirstChild("Pattern")
	if old then
		old:Destroy()
	end
	local holder = Instance.new("Frame")
	holder.Name = "Pattern"
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.Size = UDim2.fromScale(1, 1)
	holder.ZIndex = 1
	return holder
end

----------------------------------------------------------------------
-- Murs
----------------------------------------------------------------------

local WALL: { [string]: (holder: Frame, w: number, h: number, a: Color3, b: Color3, u: number) -> () } = {}

-- Uni : lambris en bas (couleur B), moulure claire et petits panneaux
WALL.Plain = function(holder, w, h, a, b, u)
	local bandTop = h * 0.64
	box(holder, 0, bandTop, w, h - bandTop, b)
	box(holder, 0, bandTop - 3 * u, w, 5 * u, a:Lerp(WHITE, 0.6))
	box(holder, 0, bandTop + 2 * u, w, 1.5 * u, b:Lerp(BLACK, 0.12), 0.4)
	local panel = 96 * u
	local x = panel * 0.5
	while x < w do
		local frame = box(holder, x - panel * 0.36, bandTop + 12 * u, panel * 0.72, (h - bandTop) - 22 * u, b:Lerp(WHITE, 0.25), 0.35)
		roundify(frame, UDim.new(0, 4 * u))
		x += panel
	end
	-- Petits motifs discrets sur le haut du mur
	local step = 58 * u
	local row = 0
	local y = 26 * u
	while y < bandTop - 16 * u do
		local offset = (row % 2) * step / 2
		local cx = step / 2 + offset
		while cx < w do
			diamond(holder, cx, y, 5 * u, b, 0.35)
			cx += step
		end
		y += step * 0.7
		row += 1
	end
end

-- Rayures verticales (+ fines rayures au milieu des bandes claires)
WALL.Stripes = function(holder, w, _h, _a, b, u)
	local stripe = 24 * u
	local x = 0
	while x < w do
		local frame = box(holder, x + stripe, 0, stripe, 10000, b)
		frame.Size = UDim2.new(0, stripe, 1, 0)
		local pin = box(holder, x + stripe / 2 - u, 0, 2 * u, 10000, b, 0.45)
		pin.Size = UDim2.new(0, 2 * u, 1, 0)
		x += stripe * 2
	end
end

-- Vichy : bandes semi-transparentes dans les deux sens (carreaux plus foncés aux croisements)
WALL.Checker = function(holder, w, h, _a, b, u)
	local cell = 26 * u
	local x = 0
	while x < w do
		local frame = box(holder, x, 0, cell, h, b, 0.35)
		frame.Size = UDim2.new(0, cell, 1, 0)
		x += cell * 2
	end
	local y = 0
	while y < h do
		local frame = box(holder, 0, y, w, cell, b, 0.35)
		frame.Size = UDim2.new(1, 0, 0, cell)
		y += cell * 2
	end
end

-- Pois en quinconce
WALL.Dots = function(holder, w, h, _a, b, u)
	local step = 60 * u
	local diameter = 16 * u
	local row = 0
	local y = step * 0.4
	while y < h + diameter do
		local cx = (row % 2) * step / 2 + step * 0.3
		while cx < w + diameter do
			circle(holder, cx, y, diameter, diameter, b)
			cx += step
		end
		y += step * 0.72
		row += 1
	end
end

-- Cœurs en quinconce (deux teintes)
WALL.Hearts = function(holder, w, h, _a, b, u)
	local step = 88 * u
	local size = 24 * u
	local light = b:Lerp(WHITE, 0.35)
	local row = 0
	local y = step * 0.45
	while y < h - size * 0.4 do
		local cx = (row % 2) * step / 2 + step * 0.35
		local index = 0
		while cx < w - size * 0.4 do
			local sizeHere = size * (0.8 + 0.4 * noise(cx, y))
			heart(holder, cx, y, sizeHere, (index + row) % 3 == 0 and light or b)
			cx += step
			index += 1
		end
		y += step * 0.62
		row += 1
	end
end

-- Étincelles (tailles variées) + petits points
WALL.Stars = function(holder, w, h, a, b, u)
	local step = 90 * u
	local row = 0
	local y = step * 0.4
	while y < h do
		local cx = (row % 2) * step / 2 + step * 0.3
		local index = 0
		while cx < w do
			local n = noise(cx, y)
			local size = (16 + 20 * n) * u
			sparkle(holder, cx + (n - 0.5) * 16 * u, y + (noise(y, cx) - 0.5) * 12 * u, size, b, n > 0.7 and 0 or 0.15)
			if index % 2 == 0 then
				circle(holder, cx + step * 0.5, y + step * 0.28, 4 * u, 4 * u, b:Lerp(a, 0.2), 0.2)
			end
			cx += step
			index += 1
		end
		y += step * 0.66
		row += 1
	end
end

-- Nuages moelleux
WALL.Clouds = function(holder, w, h, a, b, u)
	local step = 150 * u
	local rows = math.max(1, math.floor(h / (86 * u)))
	for row = 0, rows - 1 do
		local y = (row + 0.72) * (h / rows)
		local cx = (row % 2) * step / 2 + step * 0.35
		while cx < w + step do
			local n = noise(cx, row)
			local width = (60 + 30 * n) * u
			cloud(holder, cx, y, width, b, 0.05 + n * 0.15)
			-- Petite étoile entre deux nuages
			sparkle(holder, cx + step * 0.5, y - 40 * u * (0.5 + n), 9 * u, b:Lerp(a, 0.1), 0.25)
			cx += step
		end
	end
end

-- Briques (joints clairs couleur A, briques couleur B en nuances)
WALL.Bricks = function(holder, w, h, a, b, u)
	local brickW = 70 * u
	local brickH = 28 * u
	local mortar = 4 * u
	local row = 0
	local y = mortar
	while y < h do
		local x = (row % 2 == 0) and -brickW / 2 or 0
		while x < w do
			local n = noise(x + 3, y + 7)
			local tone = b:Lerp(a, n * 0.35)
			local brick = box(holder, x + mortar / 2, y, brickW - mortar, brickH, tone)
			if n > 0.72 then
				-- Petit reflet sur quelques briques
				box(brick, 4 * u, 3 * u, (brickW - mortar) * 0.4, 2 * u, WHITE, 0.55)
			end
			x += brickW
		end
		y += brickH + mortar
		row += 1
	end
end

-- Lambris de bois vertical (planches, joints, nœuds)
WALL.Wood = function(holder, w, h, a, b, u)
	local plank = 46 * u
	local seam = b:Lerp(BLACK, 0.18)
	local index = 0
	local x = 0
	while x < w do
		if index % 2 == 1 then
			local tone = box(holder, x, 0, plank, h, b, 0.55)
			tone.Size = UDim2.new(0, plank, 1, 0)
		end
		local line = box(holder, x, 0, 3 * u, h, seam, 0.15)
		line.Size = UDim2.new(0, 3 * u, 1, 0)
		local n = noise(index, 1)
		if n > 0.45 then
			circle(holder, x + plank * (0.3 + 0.4 * n), h * (0.2 + 0.6 * noise(index, 2)), 11 * u, 6 * u, seam, 0.45)
		end
		-- Veine du bois
		local grain = box(holder, x + plank * (0.25 + 0.5 * noise(index, 3)), 0, 1.5 * u, h, a:Lerp(b, 0.7), 0.5)
		grain.Size = UDim2.new(0, 1.5 * u, 1, 0)
		x += plank
		index += 1
	end
end

-- Écailles / vaguelettes : rangées de cercles qui se chevauchent
WALL.Waves = function(holder, w, h, a, b, u)
	local diameter = 74 * u
	local stepX = 66 * u
	local stepY = 40 * u
	local tones = { b, a:Lerp(b, 0.5), b:Lerp(WHITE, 0.3) }
	local row = 0
	local y = -diameter * 0.3
	while y < h + diameter * 0.2 do
		local offset = (row % 2) * stepX / 2 - stepX / 2
		local x = offset
		local color = tones[row % #tones + 1]
		while x < w + stepX do
			circle(holder, x + stepX / 2, y + diameter / 2, diameter, diameter, color, 0, row + 1)
			x += stepX
		end
		y += stepY
		row += 1
	end
end

----------------------------------------------------------------------
-- Sols (perspective)
----------------------------------------------------------------------

type Row = { Y: number, H: number, K: number }

-- Rangées de plus en plus hautes vers l'avant. K = hauteur / hauteur de la rangée avant.
local function perspectiveRows(h: number, count: number, ratio: number): { Row }
	local rows = {}
	local total = 0
	for index = 0, count - 1 do
		total += ratio ^ index
	end
	local first = h / total
	local y = 0
	local front = first * ratio ^ (count - 1)
	for index = 0, count - 1 do
		local height = first * ratio ^ index
		table.insert(rows, { Y = y, H = height, K = height / front })
		y += height
	end
	return rows
end

-- Largeur des cases d'une rangée : les colonnes s'écartent vers l'avant, mais
-- doucement (une perspective trop forte ferait des "escaliers" sur les côtés)
local function cellWidth(front: number, k: number): number
	return front * (0.62 + 0.38 * k)
end

-- Colonnes d'une rangée (bords gauche) : centrées sur le milieu, largeur `cellW`
local function columns(w: number, cellW: number, phase: number?): (number, number)
	local center = w / 2 + (phase or 0) * cellW
	local first = -math.ceil(center / cellW) - 1
	local last = math.ceil((w - center) / cellW) + 1
	return first, last
end

local FLOOR: { [string]: (holder: Frame, w: number, h: number, a: Color3, b: Color3, u: number) -> () } = {}

-- Uni : quelques reflets doux en perspective
FLOOR.Plain = function(holder, w, h, a, b, u)
	local rows = perspectiveRows(h, 5, 1.3)
	for index, row in ipairs(rows) do
		if index % 2 == 0 then
			box(holder, 0, row.Y, w, row.H, b, 0.55)
		end
	end
	for index = 1, 4 do
		local cx = w * (index / 5)
		circle(holder, cx, h * 0.55, 110 * u, 18 * u, a:Lerp(WHITE, 0.6), 0.55)
	end
end

-- Damier en perspective
FLOOR.Checker = function(holder, w, h, _a, b, u)
	local rows = perspectiveRows(h, 7, 1.17)
	local frontW = rows[#rows].H * 1.6
	for index, row in ipairs(rows) do
		local cellW = cellWidth(frontW, row.K)
		local center = w / 2
		local first, last = columns(w, cellW)
		for j = first, last do
			if (index + j) % 2 == 0 then
				box(holder, center + j * cellW, row.Y, cellW, row.H + 0.5, b)
			end
		end
	end
	-- Léger reflet
	box(holder, 0, 0, w, h * 0.35, WHITE, 0.88)
	local _ = u
end

-- Parquet de planches (joints décalés d'une rangée à l'autre)
FLOOR.Wood = function(holder, w, h, a, b, u)
	local rows = perspectiveRows(h, 6, 1.2)
	local frontL = rows[#rows].H * 4.2
	local seam = b:Lerp(BLACK, 0.2)
	for index, row in ipairs(rows) do
		local length = cellWidth(frontL, row.K)
		local phase = noise(index, 5)
		local first, last = columns(w, length, phase)
		local center = w / 2 + phase * length
		for j = first, last do
			local x = center + j * length
			if (j + index) % 2 == 0 then
				box(holder, x, row.Y, length, row.H, b, 0.5)
			end
			box(holder, x, row.Y, math.max(1, 2 * u * row.K + 0.6), row.H, seam, 0.25)
			if noise(j, index) > 0.6 then
				box(holder, x + length * 0.2, row.Y + row.H * 0.45, length * 0.35, math.max(1, 1.2 * u), a:Lerp(b, 0.8), 0.45)
			end
		end
		box(holder, 0, row.Y, w, math.max(1, 2 * u * row.K + 0.4), seam, 0.3)
	end
end

-- Carrelage (joints couleur B)
FLOOR.Tiles = function(holder, w, h, a, b, u)
	local rows = perspectiveRows(h, 6, 1.2)
	local frontW = rows[#rows].H * 1.5
	for index, row in ipairs(rows) do
		local cellW = cellWidth(frontW, row.K)
		local grout = math.max(1, 3 * u * row.K + 0.5)
		local first, last = columns(w, cellW)
		local center = w / 2
		for j = first, last do
			local x = center + j * cellW
			box(holder, x - grout / 2, row.Y, grout, row.H, b)
			if (index + j) % 3 == 0 then
				-- Reflet dans le coin de quelques carreaux
				box(holder, x + cellW * 0.12, row.Y + row.H * 0.15, cellW * 0.22, math.max(1, row.H * 0.1), WHITE, 0.45)
			end
		end
		box(holder, 0, row.Y, w, grout, b)
	end
	local _ = a
end

-- Moquette : bandes douces + petites touffes
FLOOR.Carpet = function(holder, w, h, a, b, u)
	local rows = perspectiveRows(h, 9, 1.12)
	for index, row in ipairs(rows) do
		if index % 2 == 0 then
			box(holder, 0, row.Y, w, row.H, b, 0.35)
		end
		if index % 2 == 1 then
			local step = 90 * u * row.K + 30 * u
			local x = noise(index, 9) * step
			while x < w do
				local size = (3 + 4 * row.K) * u
				circle(holder, x, row.Y + row.H * 0.5, size * 1.8, size, a:Lerp(WHITE, 0.45), 0.35)
				x += step * (0.8 + noise(x, index) * 0.6)
			end
		end
	end
end

-- Marbre : grandes dalles + veines fines (tournées, loin des bords)
FLOOR.Marble = function(holder, w, h, a, b, u)
	local rows = perspectiveRows(h, 4, 1.3)
	local frontW = rows[#rows].H * 2
	local vein = b:Lerp(BLACK, 0.12)
	for index, row in ipairs(rows) do
		local cellW = cellWidth(frontW, row.K)
		local first, last = columns(w, cellW)
		local center = w / 2
		for j = first, last do
			local x = center + j * cellW
			if (index + j) % 2 == 0 then
				box(holder, x, row.Y, cellW, row.H, b, 0.7)
			end
			box(holder, x, row.Y, math.max(1, 1.5 * u), row.H, vein, 0.45)
			local n = noise(j + 11, index)
			if x > 0 and x + cellW < w then
				local length = cellW * (0.35 + 0.3 * n)
				local veinFrame = box(holder, 0, 0, length, math.max(1, 1.4 * u), vein, 0.35)
				veinFrame.AnchorPoint = Vector2.new(0.5, 0.5)
				veinFrame.Position = UDim2.fromOffset(x + cellW * (0.35 + 0.3 * n), row.Y + row.H * (0.35 + 0.3 * noise(index, j)))
				veinFrame.Rotation = (n - 0.5) * 50 * row.K
			end
		end
		box(holder, 0, row.Y, w, math.max(1, 1.5 * u), vein, 0.45)
	end
	box(holder, 0, 0, w, h * 0.3, a:Lerp(WHITE, 0.8), 0.6)
end

-- Parquet "bâtons rompus" : blocs de 2 lames, alternés horizontal / vertical
FLOOR.Herringbone = function(holder, w, h, a, b, u)
	local rows = perspectiveRows(h, 6, 1.2)
	local frontW = rows[#rows].H * 1.8
	local seam = b:Lerp(BLACK, 0.25)
	local alt = a:Lerp(b, 0.55)
	for index, row in ipairs(rows) do
		local cellW = cellWidth(frontW, row.K)
		local gap = math.max(1, 1.5 * u * row.K + 0.4)
		local first, last = columns(w, cellW)
		local center = w / 2
		for j = first, last do
			local x = center + j * cellW
			local horizontal = (index + j) % 2 == 0
			local cell = box(holder, x + gap / 2, row.Y + gap / 2, cellW - gap, row.H - gap, horizontal and a or alt)
			if horizontal then
				box(cell, 0, (row.H - gap) / 2 - gap / 2, cellW - gap, gap, seam, 0.3)
			else
				box(cell, (cellW - gap) / 2 - gap / 2, 0, gap, row.H - gap, seam, 0.3)
			end
		end
	end
	local _ = u
end

----------------------------------------------------------------------
-- API
----------------------------------------------------------------------

local function build(set, container: GuiObject, width: number, height: number, style: Style?, unit: number?)
	local holder = clear(container)
	local u = unit or 1
	if style then
		container.BackgroundColor3 = style.A
		local painter = set[style.Pattern] or set.Plain
		local ok, err = pcall(painter, holder, width, height, style.A, style.B, u)
		if not ok then
			warn("[HousePatterns] Motif " .. tostring(style.Pattern) .. " : " .. tostring(err))
		end
	end
	holder.Parent = container
end

-- Papier peint dans `container` (taille width x height, px de maquette)
function HousePatterns.BuildWall(container: GuiObject, width: number, height: number, style: Style?, unit: number?)
	build(WALL, container, width, height, style, unit)
end

-- Sol en perspective dans `container`
function HousePatterns.BuildFloor(container: GuiObject, width: number, height: number, style: Style?, unit: number?)
	build(FLOOR, container, width, height, style, unit)
end

-- Formes réutilisées par la pièce (détails dessinés à la main)
HousePatterns.Box = box
HousePatterns.Circle = circle
HousePatterns.Heart = heart
HousePatterns.Sparkle = sparkle
HousePatterns.Cloud = cloud
HousePatterns.Diamond = diamond
HousePatterns.Round = roundify

return HousePatterns
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="12">
            <Properties>
              <string name="Name">HouseRoom</string>
              <string name="Source"><![CDATA[--[[
	HouseRoom (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > HouseRoom

	Dessin de la pièce kawaii "en coupe" (maison de poupée) :
	  - coque arrondie (plafond, côtés, dalle du sol) avec ombre douce et
	    festons sous le plafond ;
	  - mur du fond avec le papier peint (HousePatterns), murs de côté en
	    perspective (plus sombres), arêtes, plinthe et moulure ;
	  - sol en perspective (HousePatterns) avec ombre au pied du mur ;
	  - fenêtre à rideaux + tache de lumière sur le sol, prise électrique
	    rigolote, lumière douce du coin haut-gauche, vignettage ;
	  - mode nuit (mode sombre) : voile bleu nuit, lune et étoiles dans la
	    fenêtre, les lumières (catégorie "Lights") brillent davantage.
	  - objets = gros emojis "autocollants" (ombre portée, halo pour les
	    lumières, détails dessinés à la main pour certains objets : tapis,
	    guirlande, fenêtres, portes, cheminée, aquarium, frigo...).

	Coordonnées : la pièce fait (BASE_WIDTH x Width de la taille) x HEIGHT px
	de "maquette" ; un UIScale l'adapte à la place disponible (Stage).
	Un objet posé a X, Y entre 0 et 1 (fraction de la pièce) : objets "Floor"
	ancrés par le bas (leurs pieds), objets "Wall" par le centre.
	La pièce ignore l'habillage sombre automatique (DarkSkinIgnore) : elle
	gère elle-même son mode nuit.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local Signal = require(ReplicatedStorage.Shared.Signal)
local HouseCommon = require(script.Parent.HouseCommon)
local HousePatterns = require(script.Parent.HousePatterns)

type Item = HouseCommon.Item
type Placed = HouseCommon.Placed
type Style = HouseCommon.Style
type SizeDef = HouseCommon.SizeDef

local HouseRoom = {}

HouseRoom.BASE_WIDTH = 760 -- largeur de la plus petite maison (px de maquette)
HouseRoom.HEIGHT = 440
local SIDE = 42 -- profondeur apparente des murs de côté
local SHELL = 12 -- épaisseur de la coque (côtés, dalle du sol)
local CEIL = 20 -- épaisseur du plafond
local STICKER_BASE = 100 -- taille de base d'un autocollant (avant UIScale)

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local C = HouseCommon.Colors
local Box = HousePatterns.Box
local Circle = HousePatterns.Circle
local Round = HousePatterns.Round

export type Sticker = {
	Entry: Placed,
	Item: Item,
	Frame: Frame,
	Scale: UIScale,
	Body: Frame,
	Pop: UIScale,
	Shadow: Frame,
	Ring: Frame?, -- contour de sélection (créé à la première sélection)
	RingStroke: UIStroke?,
	Hit: TextButton,
	Glow: Frame?,
	Bulbs: { Frame },
	Flat: boolean,
}

export type Room = {
	Stage: Frame,
	Frame: Frame,
	Items: Frame,
	Overlay: Frame,
	BackgroundHit: TextButton,
	Width: number,
	Height: number,
	WallHeight: number,
	Scale: number,
	Changed: any, -- Signal () : taille / échelle changée
	SetStyle: (size: SizeDef, wallpaper: Style?, floor: Style?) -> (),
	SetDark: (dark: boolean) -> (),
	IsDark: () -> boolean,
	ScreenToRoom: (position: Vector2) -> Vector2,
	CreateSticker: (item: Item, entry: Placed) -> Sticker,
	ApplySticker: (sticker: Sticker) -> (),
	ShowRing: (sticker: Sticker, visible: boolean) -> (),
	DestroySticker: (sticker: Sticker) -> (),
	SetZoneHint: (placement: string?) -> (),
	Update: (dt: number) -> (),
	Refit: () -> (),
}

----------------------------------------------------------------------
-- Détails dessinés à la main (par Id d'objet)
----------------------------------------------------------------------

type DetailResult = {
	HideEmoji: boolean?,
	EmojiScale: number?,
	EmojiY: number?, -- centre vertical de l'emoji (0..1 de la boîte)
	Flat: boolean?,
	Glow: Color3?,
	Bulbs: { Frame }?,
	WallShadow: Vector2?, -- taille de l'ombre d'un objet mural (fraction de la boîte)
}

-- Rideaux roses de part et d'autre d'une fenêtre (boîte 100 x 100)
local function curtains(body: Frame, top: number, height: number, left: number, right: number)
	local rod = Box(body, left - 10, top - 6, right - left + 20, 4, C.WoodDark, 0, 5)
	Round(rod)
	Circle(body, left - 10, top - 4, 7, 7, C.WoodDark, 0, 5)
	Circle(body, right + 10, top - 4, 7, 7, C.WoodDark, 0, 5)
	for _, x in ipairs({ left - 7, right - 11 }) do
		local curtain = Box(body, x, top - 3, 18, height, C.Pink, 0, 5)
		Round(curtain, UDim.new(0, 6))
		UIUtil.Gradient(curtain, ColorSequence.new(WHITE, Color3.fromRGB(225, 205, 215)), 0)
		local tie = Box(body, x - 1, top + height * 0.55, 20, 5, C.PinkDeep, 0, 6)
		Round(tie)
	end
end

-- Fenêtre (cadre + ciel + croisillon + rebord), l'emoji sert de "vue"
local function windowDetail(skyTop: Color3, skyBottom: Color3): (Frame, Item) -> DetailResult
	return function(body: Frame, _item: Item): DetailResult
		local frame = Box(body, 12, 8, 76, 78, C.Cream, 0, 2)
		Round(frame, UDim.new(0, 8))
		UIUtil.Stroke(frame, C.WoodDark, 2, 0.35)
		local glass = Box(body, 18, 14, 64, 66, WHITE, 0, 2)
		Round(glass, UDim.new(0, 5))
		UIUtil.Gradient(glass, ColorSequence.new(skyTop, skyBottom), 90)
		glass.ZIndex = 3
		-- Croisillon (semi-transparent : on voit la vue derrière)
		Box(body, 48, 14, 4, 66, C.Cream, 0.15, 5)
		Box(body, 18, 45, 64, 4, C.Cream, 0.15, 5)
		local shine = Box(body, 22, 18, 14, 4, WHITE, 0.4, 5)
		Round(shine)
		local sill = Box(body, 6, 84, 88, 8, C.Cream, 0, 5)
		Round(sill, UDim.new(0, 3))
		UIUtil.Stroke(sill, C.WoodDark, 1.5, 0.5)
		curtains(body, 10, 70, 12, 88)
		return { EmojiScale = 0.5, EmojiY = 0.49, WallShadow = Vector2.new(0.9, 0.9) }
	end
end

-- Porte (corps coloré arrondi, poignée dorée) ; l'emoji décore la porte
local function doorDetail(color: Color3, emojiScale: number): (Frame, Item) -> DetailResult
	return function(body: Frame, _item: Item): DetailResult
		local door = Box(body, 22, 4, 56, 96, color, 0, 2)
		Round(door, UDim.new(0, 14))
		UIUtil.Stroke(door, color:Lerp(BLACK, 0.35), 2.5, 0.2)
		UIUtil.Gradient(door, ColorSequence.new(WHITE, Color3.fromRGB(215, 215, 215)), 0)
		local panelTop = Box(body, 30, 16, 40, 30, color:Lerp(WHITE, 0.25), 0, 3)
		Round(panelTop, UDim.new(0, 8))
		local panelBottom = Box(body, 30, 54, 40, 34, color:Lerp(WHITE, 0.25), 0, 3)
		Round(panelBottom, UDim.new(0, 8))
		Circle(body, 70, 56, 8, 8, C.Butter, 0, 5)
		return { EmojiScale = emojiScale, EmojiY = 0.32 }
	end
end

-- Halo de lumière (catégorie "Lights" et quelques objets lumineux)
local LIGHT_COLORS: { [string]: Color3 } = {
	ScentedCandle = Color3.fromRGB(255, 200, 120),
	HangingBulb = Color3.fromRGB(255, 236, 150),
	PaperLantern = Color3.fromRGB(255, 140, 120),
	OilLamp = Color3.fromRGB(255, 196, 110),
	StarNightLight = Color3.fromRGB(255, 232, 140),
	SparklerLights = Color3.fromRGB(255, 220, 160),
	NeonHeart = Color3.fromRGB(255, 90, 170),
	MoonLamp = Color3.fromRGB(255, 244, 200),
	RainbowProjector = Color3.fromRGB(200, 160, 255),
	LavaLamp = Color3.fromRGB(255, 120, 90),
	UFOLamp = Color3.fromRGB(150, 255, 200),
	CrystalChandelier = Color3.fromRGB(190, 230, 255),
	PocketSun = Color3.fromRGB(255, 214, 90),
	Fireplace = Color3.fromRGB(255, 150, 80),
	GlowStars = Color3.fromRGB(255, 244, 170),
	CrystalBall = Color3.fromRGB(210, 170, 255),
	DreamPortal = Color3.fromRGB(190, 140, 255),
	Aquarium = Color3.fromRGB(140, 210, 255),
	FloatingPlanet = Color3.fromRGB(255, 210, 160),
}

-- Fil vertical qui pend du plafond (ampoule, lanterne, lustre)
local function cord(body: Frame, length: number, color: Color3?)
	Box(body, 49, -length, 2, length + 12, color or Color3.fromRGB(90, 70, 80), 0.1, 1)
end

local BULB_COLORS = {
	Color3.fromRGB(255, 120, 180),
	Color3.fromRGB(255, 220, 110),
	Color3.fromRGB(130, 230, 190),
	Color3.fromRGB(180, 150, 255),
	Color3.fromRGB(255, 170, 130),
	Color3.fromRGB(140, 200, 255),
}

local DETAILS: { [string]: (Frame, Item) -> DetailResult } = {}

-- Tapis tricoté : ovale à anneaux posé à plat, pelote au milieu
DETAILS.KnittedRug = function(body: Frame, _item: Item): DetailResult
	local rings = { C.PinkDeep, C.Cream, C.Pink, C.PinkSoft, C.Lilac }
	for index, color in ipairs(rings) do
		local k = 1 - (index - 1) * 0.17
		Circle(body, 50, 84, 150 * k, 40 * k, color, 0, 2)
	end
	return { EmojiScale = 0.42, EmojiY = 0.72, Flat = true }
end

-- Guirlande lumineuse : ampoules colorées sur un fil qui pend en arc
DETAILS.FairyLights = function(body: Frame, _item: Item): DetailResult
	local bulbs = {}
	local count = 9
	local previous: Vector2? = nil
	for index = 0, count - 1 do
		local t = index / (count - 1)
		local x = -30 + t * 160
		local y = 30 + math.sin(t * math.pi) * 34
		local point = Vector2.new(x, y)
		if previous then
			local delta = point - previous
			local wire = Box(body, 0, 0, delta.Magnitude + 1, 2, Color3.fromRGB(80, 110, 90), 0, 1)
			wire.AnchorPoint = Vector2.new(0.5, 0.5)
			wire.Position = UDim2.fromOffset((point.X + previous.X) / 2, (point.Y + previous.Y) / 2)
			wire.Rotation = math.deg(math.atan2(delta.Y, delta.X))
		end
		previous = point
		local color = BULB_COLORS[index % #BULB_COLORS + 1]
		local halo = Circle(body, x, y + 7, 26, 26, color, 0.8, 1)
		halo.Name = "Halo"
		local bulb = Circle(body, x, y + 7, 10, 13, color, 0, 3)
		bulb:SetAttribute("Phase", index * 0.9)
		table.insert(bulbs, bulb)
		table.insert(bulbs, halo)
	end
	return { HideEmoji = true, Bulbs = bulbs, WallShadow = Vector2.new(0, 0) }
end

DETAILS.HangingBulb = function(body: Frame, _item: Item): DetailResult
	cord(body, 60)
	return { EmojiScale = 0.9 }
end

DETAILS.PaperLantern = function(body: Frame, _item: Item): DetailResult
	cord(body, 50, C.PinkDeep)
	return { EmojiScale = 0.9 }
end

DETAILS.CrystalChandelier = function(body: Frame, _item: Item): DetailResult
	cord(body, 40, Color3.fromRGB(200, 170, 90))
	return { EmojiScale = 0.95 }
end

-- Poster : feuille blanche légèrement penchée, scotch rose
DETAILS.MapPoster = function(body: Frame, _item: Item): DetailResult
	local paper = Box(body, 6, 10, 88, 80, WHITE, 0, 2)
	paper.Rotation = -3
	Round(paper, UDim.new(0, 4))
	UIUtil.Stroke(paper, Color3.fromRGB(220, 200, 210), 1.5, 0.2)
	for _, x in ipairs({ 4, 80 }) do
		local tape = Box(body, x, 4, 18, 8, C.Pink, 0.25, 4)
		tape.Rotation = x < 50 and -25 or 25
	end
	return { EmojiScale = 0.72, WallShadow = Vector2.new(0.9, 0.82) }
end

-- Miroir cœur : grand cœur rose derrière le miroir
DETAILS.HeartMirror = function(body: Frame, _item: Item): DetailResult
	HousePatterns.Heart(body, 50, 50, 104, C.PinkDeep, 0, 2)
	HousePatterns.Heart(body, 50, 51, 90, C.PinkSoft, 0, 2)
	return { EmojiScale = 0.6, EmojiY = 0.47, WallShadow = Vector2.new(0.6, 0.55) }
end

-- Cheminée en briques, le feu dans le foyer
DETAILS.Fireplace = function(body: Frame, _item: Item): DetailResult
	local mantle = Box(body, 2, 18, 96, 12, C.Cream, 0, 2)
	Round(mantle, UDim.new(0, 4))
	local bricks = Box(body, 8, 28, 84, 72, Color3.fromRGB(214, 120, 120), 0, 2)
	UIUtil.Stroke(bricks, Color3.fromRGB(150, 70, 80), 2, 0.3)
	for row = 0, 4 do
		Box(bricks, 0, 12 + row * 13, 84, 2, Color3.fromRGB(250, 214, 200), 0.2, 3)
	end
	local hearth = Box(body, 24, 50, 52, 50, Color3.fromRGB(60, 36, 50), 0, 4)
	Round(hearth, UDim.new(0, 20))
	return { EmojiScale = 0.48, EmojiY = 0.76, Glow = LIGHT_COLORS.Fireplace }
end

-- Aquarium : bac d'eau, bulles et poisson
DETAILS.Aquarium = function(body: Frame, _item: Item): DetailResult
	local tank = Box(body, 4, 26, 92, 70, Color3.fromRGB(170, 225, 255), 0.15, 2)
	Round(tank, UDim.new(0, 8))
	UIUtil.Stroke(tank, WHITE, 3, 0.1)
	UIUtil.Gradient(tank, ColorSequence.new(Color3.fromRGB(235, 250, 255), Color3.fromRGB(150, 205, 245)), 90)
	Box(body, 8, 86, 84, 8, Color3.fromRGB(255, 225, 170), 0, 3)
	for index, point in ipairs({ Vector2.new(24, 44), Vector2.new(30, 60), Vector2.new(78, 40) }) do
		local bubble = Circle(body, point.X, point.Y, 7 - index, 7 - index, WHITE, 0.3, 4)
		UIUtil.Stroke(bubble, Color3.fromRGB(120, 180, 230), 1, 0.4)
	end
	Box(body, 0, 96, 100, 4, C.WoodDark, 0, 3)
	return { EmojiScale = 0.46, EmojiY = 0.62 }
end

-- Climatiseur : boîtier blanc avec grille
DETAILS.AirConditioner = function(body: Frame, _item: Item): DetailResult
	local unit = Box(body, 2, 28, 96, 44, WHITE, 0, 2)
	Round(unit, UDim.new(0, 10))
	UIUtil.Stroke(unit, Color3.fromRGB(190, 200, 215), 2, 0.1)
	UIUtil.Gradient(unit, ColorSequence.new(WHITE, Color3.fromRGB(225, 232, 242)), 90)
	for index = 0, 3 do
		Box(body, 12, 58 + index * 3.2, 76, 1.5, Color3.fromRGB(170, 185, 205), 0.2, 3)
	end
	Circle(body, 86, 38, 5, 5, C.Mint, 0, 3)
	return { EmojiScale = 0.26, EmojiY = 0.42, WallShadow = Vector2.new(0.95, 0.5) }
end

-- Frigo pastel
DETAILS.Fridge = function(body: Frame, _item: Item): DetailResult

local PILLS = {
	{ Id = "ScreenTime", Text = "⏱️ Screen Time", Color = Theme.Colors.Dark, Feature = "ScreenTime", Panel = "ScreenTime" },
	{ Id = "ItemShop", Text = "🛒 Shop", Color = Theme.Colors.Green, Feature = "ItemShop", Panel = "ItemShop" },
	{ Id = "Achievements", Text = "🏆 Achievements", Color = Theme.Colors.Purple, Feature = "Achievements", Panel = "Achievements" },
	{ Id = "Quests", Text = "📜 Quests", Color = Theme.Colors.Orange, Feature = "Quests", Panel = "Quests" },
	-- 🕹️ Arcade : panneau écrit à part (enregistré par ClientMain s'il existe)
	{ Id = "Arcade", Text = "🕹️ Arcade", Color = Color3.fromRGB(255, 70, 160), Feature = "Minigames", Panel = "Arcade", Visible = arcadeVisible },
	{ Id = "Leaderboard", Text = "🥇 Leaderboard", Color = Theme.Colors.Blue, Feature = nil, Panel = "Leaderboard" },
	-- 🚶 Dopamine Town : pas une fenêtre, Action = entrer dans la ville
	{ Id = "Town", Text = "🚶 Town", Color = Color3.fromRGB(96, 200, 150), Feature = nil, Panel = "Town", Visible = townVisible, Action = enterTown },
	{ Id = "Daily", Text = "🎁 Gift", Color = Theme.Colors.Pink, Feature = "Daily", Panel = "Daily" },
	{ Id = "Themes", Text = "🎨 Themes", Color = Theme.Colors.Cyan, Feature = nil, Panel = "Themes" },
	{ Id = "RobuxShop", Text = "💎 Robux", Color = Theme.Colors.Robux, Feature = nil, Panel = "RobuxShop", Visible = robuxShopVisible },
	{ Id = "Settings", Text = "⚙️", Color = Theme.Colors.ButtonBottom, Feature = nil, Panel = "Settings", Round = true },
	-- (outil de test : pastille ronde, icône seule, pour ne pas prendre de place)
	{ Id = "Debug", Text = "🛠️ Test", Color = Theme.Colors.Red, Feature = nil, Panel = "Debug", Visible = debugVisible, Round = true },
}

local BUTTON_SIZE = Vector2.new(184, 62)
local PILL_HEIGHT = 36
-- Téléphone : pastilles rondes plus grosses (≈ 34 px réels à l'écran, zone
-- tactile correcte) avec moins de marge verticale autour (la rangée ne
-- grandit que de 2 px "design")
local PHONE_PILL_HEIGHT = 52
local HOUSE_BUTTON_SIZE = 54 -- bouton "🏠" (zone tactile >= 44 px)
-- Colonne des indicateurs Robux (à gauche du bouton) : 2 pastilles + carte du
-- boost ; remontée de STATUS_LIFT px pour finir au-dessus du compteur
local STATUS_HEIGHT = 90
local STATUS_LIFT = 12
local HOUSE_GAP = 6 -- écart entre "Click me" et "🏠" (le badge "99+" reste loin du slot CR)

local random = Random.new()
local effectsLayer: Frame

local buttonHolder: Frame
local clickButton: TextButton
local clickLabel: TextLabel
local buttonGradient: UIGradient
local hatLabel: TextLabel
local robotLabel: TextLabel
local counterRow: Frame
local counterLabel: TextLabel -- le nombre
local unitLabel: TextLabel -- "Dopamine"
local counterScale: UIScale
local perSecondLabel: TextLabel
local statusLeft: Frame
local vipChip: Frame
local bonusChip: Frame
local boostCard: Frame
local foodBadge -- (v9.8) badge 🍩 du boost de nourriture (FoodBoostBadge)
local boostTitle: TextLabel
local boostTimer: TextLabel
local rushBanner: Frame
local rushLabel: TextLabel
local comboBar: Frame
local comboFill: Frame
local comboLabel: TextLabel
local pills = {} -- [Id] = { Button, Holder, Badge, Def }
local pillsStack: Frame -- pile verticale qui contient la rangée des pastilles
local pillsRow: GuiObject? = nil
local pillsDevice = "" -- profil pour lequel la rangée a été construite
local houseButton: TextButton
local houseBadge: TextLabel
local houseTip: Frame
local houseSeen: { [string]: boolean } = {} -- objets abordables déjà vus (badge "🏠")
local houseBadgeCount = 0
local houseWiggleAt = 0

local seenAchievements: number? = nil -- succès déjà vus (badge "Succès")
local counterFlashUntil = 0 -- le compteur brille en doré (gros gain) jusqu'à cette heure
local counterFlashing = false
local perSecondTarget = 0 -- Dopamine / s du serveur
local perSecondShown = 0 -- valeur affichée (glisse vers la cible)
local perSecondText = ""
local perSecondDrawn = -1
local perSecondFlashUntil = 0
local perSecondFlashing = false
local perSecondScale: UIScale
local counterText = ""
local robotClock = 0
local robotFloatClock = 0
local currentSkin = ""
local currentHat = ""

----------------------------------------------------------------------
-- Utilitaires
----------------------------------------------------------------------

-- "12 345" sous le million, "1.23M" au-delà, "2.5" pour les petites décimales
local function formatAmount(value: number): string
	if value >= 1e6 then
		return NumberFormatter.Format(value)
	elseif value < 10 and value % 1 ~= 0 then
		return NumberFormatter.Format(value)
	end
	return NumberFormatter.WithSpaces(value)
end

local function countTrue(map): number
	local count = 0
	if type(map) == "table" then
		for _, value in pairs(map) do
			if value then
				count += 1
			end
		end
	end
	return count
end

----------------------------------------------------------------------
-- Cosmétiques (chapeau + couleur du bouton)
----------------------------------------------------------------------

local function applySkin(skinId: string)
	if skinId == currentSkin then
		return
	end
	currentSkin = skinId
	local skin = Config.CosmeticsById[skinId]
	if skin and skin.Top and skin.Bottom then
		buttonGradient.Color = ColorSequence.new(skin.Top, skin.Bottom)
		clickLabel.TextColor3 = Theme.ContrastText(skin.Top:Lerp(skin.Bottom, 0.5))
	else
		buttonGradient.Color = ColorSequence.new(Theme.Colors.Button, Theme.Colors.ButtonBottom)
		clickLabel.TextColor3 = Theme.Colors.Text
	end
	CosmeticArt.ApplySkin(clickButton, skin, 12, 2) -- (v9.2) motif (nil = retiré)
end

local function applyHat(hatId: string)
	if hatId == currentHat then
		return
	end
	currentHat = hatId
	local hat = Config.CosmeticsById[hatId]
	if hat then
		CosmeticArt.ApplyHat(hatLabel, hat) -- (v9.2) dessin, sinon l'emoji
		hatLabel.Visible = true
		local scale = hatLabel:FindFirstChildOfClass("UIScale")
		if scale then
			scale.Scale = 0.2
			UIUtil.Tween(scale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
		end
	else
		CosmeticArt.ApplyHat(hatLabel, nil)
		hatLabel.Visible = false
	end
end

----------------------------------------------------------------------
-- Clic sur le gros bouton
----------------------------------------------------------------------

local function onClick()
	local gain = ClientState.Click()
	if not gain then
		return
	end
	UpgradeBar.HideTooltip()

	-- Squish : on écrase le bouton puis il rebondit
	clickButton.Size = UDim2.fromScale(1.08, 0.84)
	UIUtil.Tween(clickButton, 0.4, { Size = UDim2.fromScale(1, 1) }, Enum.EasingStyle.Elastic)

	-- Le chapeau saute un peu
	if hatLabel.Visible then
		hatLabel.Position = UDim2.new(0.5, 0, 0, 6)
		UIUtil.Tween(hatLabel, 0.35, { Position = UDim2.new(0.5, 0, 0, 18) }, Enum.EasingStyle.Bounce)
	end

	-- "+X" qui s'envole près du bouton : couleur / style selon la taille du gain
	-- (combo) ; au-delà de x2,5 la valeur d'un clic : style "critique" doré
	local ratio = ClientState.GetComboMeter() / 100
	local base = tonumber(ClientState.Data and ClientState.Data.ClickValue) or gain
	local color, style = Effects.AmountStyle(gain, base, ClientState.DarkMode)
	local center = Interface.GetCanvasCenter(clickButton)
	-- De part et d'autre du bouton, montée courte : les chiffres ne passent ni
	-- sur le compteur ni sur le bandeau d'actualités
	local side = random:NextNumber() < 0.5 and -1 or 1
	local halfWidth = clickButton.AbsoluteSize.X / math.max(Interface.Scale, 0.01) / 2
	local position = UDim2.fromOffset(
		center.X + side * (halfWidth + random:NextNumber(4, 54)),
		center.Y + 2 + random:NextNumber(-10, 10)
	)
	Effects.Pop(effectsLayer, position, "+" .. formatAmount(gain), { Color = color, Size = 28 + ratio * 10, Style = style, Rise = 36 })
	Effects.Burst(effectsLayer, UDim2.fromOffset(center.X + random:NextNumber(-40, 40), center.Y), nil, 3)

	-- Son de clic choisi dans les paramètres ; il monte dans les aigus avec le combo
	SoundManager.PlayClick(0.95 + ratio * 0.6 + random:NextNumber(0, 0.08))

	counterScale.Scale = 1.08
	UIUtil.Tween(counterScale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)
end

----------------------------------------------------------------------
-- Construction
----------------------------------------------------------------------

local function buildButton(column: Frame)
	buttonHolder = UIUtil.Create("Frame", {
		Name = "ClickerHolder",
		Size = UDim2.fromOffset(BUTTON_SIZE.X, BUTTON_SIZE.Y),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 40),
		BackgroundTransparency = 1,
		Parent = column,
	})

	clickButton = UIUtil.Create("TextButton", {
		Name = "ClickButton",
		Size = UDim2.fromScale(1, 1),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1), -- couleurs données par le dégradé
		AutoButtonColor = false,
		Text = "",
		ZIndex = 2,
		Parent = buttonHolder,
	})
	UIUtil.Corner(clickButton, 12)
	UIUtil.Stroke(clickButton, Theme.Colors.Border, 1.5)
	buttonGradient = UIUtil.Gradient(clickButton, ColorSequence.new(Theme.Colors.Button, Theme.Colors.ButtonBottom), 90)
	UIUtil.Shadow(clickButton, 4, 0.8, 3)

	clickLabel = UIUtil.Label({
		Text = Locale.T("Click me"),
		Font = Theme.Fonts.Body,
		Size = UDim2.new(1, -20, 1, -16),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		ZIndex = 3,
		MaxTextSize = 28,
		Parent = clickButton,
	})

	-- Chapeau posé sur le bouton
	hatLabel = UIUtil.Label({
		Name = "Hat",
		Text = "",
		Size = UDim2.fromOffset(60, 60),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0, 18),
		Rotation = -8,
		ZIndex = 4,
		MaxTextSize = 56,
		Visible = false,
		Parent = buttonHolder,
	})
	UIUtil.Create("UIScale", { Parent = hatLabel })

	-- Petit robot (Game Pass "Auto-clic") posé sur le coin haut-gauche du bouton
	robotLabel = UIUtil.Label({
		Name = "Robot",
		Text = "🤖",
		Size = UDim2.fromOffset(34, 34),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 10, 0, 4),
		Rotation = 0,
		ZIndex = 5,
		MaxTextSize = 30,
		Visible = false,
		Parent = buttonHolder,
	})

	-- Souris ET tactile (multi-touch compris)
	clickButton.InputBegan:Connect(function(input: InputObject)
		local inputType = input.UserInputType
		if inputType == Enum.UserInputType.MouseButton1 or inputType == Enum.UserInputType.Touch then
			onClick()
		end
	end)
	-- Survol : léger grossissement
	local hoverScale = UIUtil.Create("UIScale", { Parent = buttonHolder })
	clickButton.MouseEnter:Connect(function()
		UIUtil.Tween(hoverScale, 0.15, { Scale = 1.04 }, Enum.EasingStyle.Back)
	end)
	clickButton.MouseLeave:Connect(function()
		UIUtil.Tween(hoverScale, 0.15, { Scale = 1 })
	end)
end

-- Bouton rond "🏠 Ma maison", à droite du bouton "Click me".
-- `buttonCenterX` / `buttonCenterY` : centre du bouton "Click me" dans la colonne.
local function buildHouseButton(column: Frame, buttonCenterX: number, buttonCenterY: number)
	local holder = UIUtil.Create("Frame", {
		Name = "HouseHolder",
		Size = UDim2.fromOffset(HOUSE_BUTTON_SIZE, HOUSE_BUTTON_SIZE),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromOffset(buttonCenterX + BUTTON_SIZE.X / 2 + HOUSE_GAP, buttonCenterY),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = column,
	})
	houseButton = UIUtil.PillButton({
		Name = "HouseButton",
		Text = "🏠",
		Color = HouseCommon.Colors.Pink,
		TextColor3 = Theme.Colors.TextDark,
		Height = HOUSE_BUTTON_SIZE,
		TextSize = 30,
		Round = true,
		ZIndex = 3,
		Parent = holder,
	})
	-- (v9 : bouton rose en relief avec reflet, contour rose foncé, ombre : voir UIUtil)
	houseBadge = UIUtil.Badge(houseButton, 22)
	houseBadge.Position = UDim2.new(1, -8, 0, 2)

	-- Petite bulle "Ma maison" au survol (au-dessus du bouton)
	houseTip = UIUtil.Chip({
		Name = "HouseTip",
		Text = Locale.T("🏠 My house"),
		Color = Theme.Colors.Dark,
		TextColor3 = Theme.Colors.TextLight,
		Height = 24,
		TextSize = 13,
		ZIndex = 6,
		Visible = false,
		Parent = holder,
	})
	houseTip.AnchorPoint = Vector2.new(0.5, 1)
	houseTip.Position = UDim2.new(0.5, 0, 0, -4)
	houseButton.MouseEnter:Connect(function()
		if not Interface.IsTouch() then
			houseTip.Visible = true
			UIUtil.Pop(houseTip, 0.6, 0.25)
		end
	end)
	houseButton.MouseLeave:Connect(function()
		houseTip.Visible = false
	end)

	houseButton.Activated:Connect(function()
		houseTip.Visible = false
		if not PanelManager.IsRegistered("House") then
			SoundManager.Play("Error", 0.8)
			UIUtil.Shake(houseButton)
			return
		end
		PanelManager.Toggle("House")
	end)
end

-- Badge "🏠" : objets de maison jamais achetés devenus abordables, pas encore vus
local function refreshHouseBadge(data)
	if not houseBadge then
		return
	end
	local isOpen = PanelManager.IsOpen("House")
	local count = 0
	for _, id in ipairs(HouseCommon.AffordableNew(data, ClientState.GetConfirmedDopamine())) do
		if isOpen then
			houseSeen[id] = true
		elseif not houseSeen[id] then
			count += 1
		end
	end
	houseBadgeCount = count
	UIUtil.SetBadge(houseBadge, count)
end

-- Largeur max de la rangée des pastilles (téléphone : entre les slots de côté)
local function pillsRowWidth(): number
	if Interface.IsPhone() then
		return math.clamp(Slots.GetCenterClearWidth(), 360, 664)
	end
	return 664
end

-- "🛒 Boutique" -> ("🛒", "Boutique") ; sans emoji : (nil, texte)
local function splitIcon(text: string): (string?, string)
	local first, rest = string.match(text, "^(%S+)%s+(.+)$")
	if first and rest and not string.find(first, "%w") then
		return first, rest
	end
	if not string.find(text, "%w") then
		return text, ""
	end
	return nil, text
end

--[[
	Pastille de menu v9 ("premium") : corps coloré en relief (dégradé, lèvre
	sombre en bas, reflet, contour teinté, ombre), icône dans une puce
	blanche givrée à gauche, texte bordé, badge rouge DANS la pastille à
	droite du texte (la pastille s'élargit quand il apparaît : il ne
	recouvre jamais la voisine). Ronde (icône seule) sur téléphone et pour ⚙️.
	Renvoie (bouton, badge).
]]
local function buildMenuPill(holder: Frame, def, icon: string?, label: string, height: number, round: boolean, tablet: boolean, y: number): (TextButton, TextLabel)
	local lightBody = Theme.Luminance(def.Color) > 0.75
	local textColor = lightBody and Theme.Colors.Text or Theme.Colors.TextLight
	local button = UIUtil.Create("TextButton", {
		Name = "Button",
		Size = UDim2.fromOffset(height, height),
		AutomaticSize = round and Enum.AutomaticSize.None or Enum.AutomaticSize.X,
		BackgroundColor3 = def.Color,
		AutoButtonColor = false,
		Font = Theme.Fonts.Title,
		Text = round and (icon or label) or "",
		TextColor3 = textColor,
		TextSize = math.floor(height * 0.52),
		Position = UDim2.fromOffset(0, y),
		ZIndex = 1,
		Parent = holder,
	})
	UIUtil.Corner(button, UDim.new(1, 0))
	UIUtil.DressButton(button, def.Color, { StrokeThickness = 1.5 })

	local badge: TextLabel
	if round then
		badge = UIUtil.Badge(button, 22)
	else
		button.Size = UDim2.fromOffset(0, height)
		-- (tablette : un peu plus serré pour que tout tienne sur deux lignes)
		UIUtil.Create("UIPadding", {
			PaddingLeft = UDim.new(0, tablet and 3 or 4),
			PaddingRight = UDim.new(0, tablet and 10 or 12),
			Parent = button,
		})
		-- Contenu dans son propre cadre (la liste ne doit pas placer le reflet)
		local content = UIUtil.Create("Frame", {
			Name = "Content",
			Size = UDim2.fromOffset(0, height),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundTransparency = 1,
			ZIndex = 2,
			Parent = button,
		})
		UIUtil.Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, tablet and 3 or 4),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = content,
		})
		-- Puce d'icône (disque blanc givré)
		local chipSize = height - (tablet and 16 or 12)
		local chip = UIUtil.Create("Frame", {
			Name = "IconChip",
			Size = UDim2.fromOffset(chipSize, chipSize),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = lightBody and 0.35 or 0.1,
			LayoutOrder = 1,
			ZIndex = 2,
			Parent = content,
		})
		chip:SetAttribute("DarkSkinIgnore", true)
		UIUtil.Corner(chip, UDim.new(1, 0))
		UIUtil.Stroke(chip, Color3.new(1, 1, 1), 1.5, 0.35)
		UIUtil.Gradient(chip, ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(226, 228, 236)), 90)
		UIUtil.Create("TextLabel", {
			Name = "Icon",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Font = Theme.Fonts.Body,
			Text = icon or "•",
			TextColor3 = Theme.Colors.Text,
			TextSize = math.floor(chipSize * 0.62),
			ZIndex = 3,
			Parent = chip,
		})
		local text = UIUtil.Create("TextLabel", {
			Name = "Label",
			Size = UDim2.fromOffset(0, height),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundTransparency = 1,
			Font = Theme.Fonts.Title,
			Text = label,
			TextColor3 = textColor,
			TextSize = tablet and 16 or math.floor(height * 0.45),
			LayoutOrder = 2,
			ZIndex = 2,
			Parent = content,
		})
		-- Contour du texte : lisible sur toutes les couleurs
		local stroke = UIUtil.Create("UIStroke", {
			Name = "TextStroke",
			Color = def.Color:Lerp(Color3.new(0, 0, 0), 0.55),
			Thickness = 1.2,
			Transparency = lightBody and 1 or 0.35,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
			Parent = text,
		})
		stroke:SetAttribute("DarkSkinIgnore", true)
		-- Badge rouge DANS la pastille, après le texte (la pastille s'élargit)
		badge = UIUtil.Badge(content, tablet and 16 or 18)
		badge.LayoutOrder = 3
	end
	-- Ombre portée : dans le support, même largeur que la pastille (largeur en
	-- échelle : ne change jamais la taille automatique du support)
	local shadow = UIUtil.Create("Frame", {
		Name = "PillShadow",
		Size = UDim2.new(1, 0, 0, height),
		Position = UDim2.fromOffset(0, y + 3),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.8,
		BorderSizePixel = 0,
		ZIndex = 0,
		Parent = holder,
	})
	UIUtil.Corner(shadow, UDim.new(1, 0))
	return button, badge
end

-- (Re)construit la rangée des pastilles selon l'appareil :
--   PC / tablette : lignes qui passent à la ligne (Wraps) ;
--   téléphone : UNE ligne qui défile horizontalement.
local function buildPills(parent: Frame, order: number)
	if pillsRow then
		pillsRow:Destroy()
		pillsRow = nil
	end
	table.clear(pills)
	local phone = Interface.IsPhone()
	local height = phone and PHONE_PILL_HEIGHT or (Interface.IsTouch() and Theme.TouchTarget or PILL_HEIGHT)
	-- Marge verticale du support (4 px d'air entre deux lignes de pastilles sur PC)
	local holderPad = phone and 6 or 4
	local buttonY = phone and 3 or 2
	pillsDevice = Interface.Device

	local row: GuiObject
	if phone then
		row = UIUtil.Create("ScrollingFrame", {
			Name = "Pills",
			Size = UDim2.fromOffset(pillsRowWidth(), height + holderPad),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollingDirection = Enum.ScrollingDirection.X,
			AutomaticCanvasSize = Enum.AutomaticSize.X,
			CanvasSize = UDim2.new(),
			ScrollBarThickness = 0,
			ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
			LayoutOrder = order,
			Parent = parent,
		})
		UIUtil.Create("UIPadding", {
			PaddingLeft = UDim.new(0, 6),
			PaddingRight = UDim.new(0, 6),
			Parent = row,
		})
	else
		row = UIUtil.Create("Frame", {
			Name = "Pills",
			Size = UDim2.fromOffset(664, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = order,
			Parent = parent,
		})
		if Interface.Device == "Desktop" then
			-- PC : la 1re ligne passe sous les slots CL / CR (bas à y = 210) :
			-- 8 px d'air pour qu'aucune pastille ne touche ces cartes
			UIUtil.Create("UIPadding", { PaddingTop = UDim.new(0, 8), Parent = row })
		end
	end
	pillsRow = row
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Wraps = not phone,
		Padding = UDim.new(0, phone and 10 or 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = row,
	})

	for index, def in ipairs(PILLS) do
		-- Téléphone : pastilles rondes avec l'icône seule, pour que TOUTES
		-- tiennent sur une ligne (le texte long ne tenait pas : pastille coupée
		-- au bord de la rangée). Le titre complet s'affiche dans la fenêtre.
		local round = def.Round == true or phone
		local icon, label = splitIcon(Locale.T(def.Text))
		-- Support (marge verticale entre deux lignes de pastilles)
		local holder = UIUtil.Create("Frame", {
			Name = def.Id,
			Size = UDim2.fromOffset(round and height or 0, height + holderPad),
			AutomaticSize = round and Enum.AutomaticSize.None or Enum.AutomaticSize.X,
			BackgroundTransparency = 1,
			LayoutOrder = index,
			Visible = def.Feature == nil and (def.Visible == nil or def.Visible()),
			Parent = row,
		})
		-- Tablette : texte et marges un peu plus serrés (pastilles tactiles de 44 px)
		-- pour que les 10 pastilles tiennent sur DEUX lignes (sinon la barre
		-- d'améliorations descendrait sur les emplacements du bas)
		local tablet = Interface.Device == "Tablet"
		local button, badge = buildMenuPill(holder, def, icon, label, height, round, tablet, buttonY)
		if round then
			badge.Position = UDim2.new(1, phone and -6 or -2, 0, phone and 12 or 2)
		end
		UIUtil.Create("UIScale", { Name = "PopScale", Parent = holder })

		button.Activated:Connect(function()
			if def.Action then
				def.Action()
				return
			end
			if not PanelManager.IsRegistered(def.Panel) then
				SoundManager.Play("Error", 0.8)
				UIUtil.Shake(button)
				return
			end
			PanelManager.Toggle(def.Panel)
		end)
		pills[def.Id] = { Button = button, Holder = holder, Badge = badge, Def = def }
	end
	return row
end

-- Le bandeau Rush se superpose à la ligne "par seconde" (hors de la pile) :
-- il ne pousse pas la barre d'améliorations sur les emplacements du bas
local function buildRush(parent: GuiObject)
	rushBanner = UIUtil.Create("Frame", {
		Name = "RushBanner",
		Size = UDim2.fromOffset(330, 28),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundColor3 = Theme.Colors.Yellow,
		ZIndex = 2,
		Visible = false,
		Parent = parent,
	})
	UIUtil.Corner(rushBanner, UDim.new(1, 0))
	UIUtil.Stroke(rushBanner, Theme.Colors.Border, 1.5)
	UIUtil.Shadow(rushBanner, 3, 0.84, 2)
	rushLabel = UIUtil.Label({
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.TextDark,
		Size = UDim2.new(1, -16, 1, -6),
		Position = UDim2.fromOffset(8, 3),
		MaxTextSize = 18,
		Parent = rushBanner,
	})
end

local function buildCombo(parent: Frame, order: number)
	comboBar = UIUtil.Create("Frame", {
		Name = "ComboBar",
		Size = UDim2.fromOffset(300, 20),
		BackgroundColor3 = Theme.Colors.PanelLight,
		LayoutOrder = order,
		ClipsDescendants = true,
		Visible = false,
		Parent = parent,
	})
	UIUtil.Corner(comboBar, UDim.new(1, 0))
	UIUtil.Stroke(comboBar, Theme.Colors.Border, 1.5)
	comboFill = UIUtil.Create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = comboBar,
	})
	UIUtil.Corner(comboFill, UDim.new(1, 0))
	UIUtil.Gradient(comboFill, ColorSequence.new({
		ColorSequenceKeypoint.new(0, Theme.Colors.Yellow),
		ColorSequenceKeypoint.new(0.5, Theme.Colors.Orange),
		ColorSequenceKeypoint.new(1, Theme.Colors.Red),
	}), 0)
	comboLabel = UIUtil.Label({
		Text = Locale.T("COMBO %s", "x1"),
		Font = Theme.Fonts.Title,
		Size = UDim2.new(1, -10, 1, -4),
		Position = UDim2.fromOffset(5, 2),
		ZIndex = 2,
		MaxTextSize = 14,
		Parent = comboBar,
	})
end

-- Indicateurs Robux, à GAUCHE du bouton (hors de la pile : ils ne poussent
-- jamais la barre d'améliorations sur les emplacements du bas) :
-- 👑 VIP, 💎 bonus des Game Passes, puis ⏱️ boost + minuteur (petite carte).
-- Tout tient dans une colonne de 70 px entre le slot CL et le bouton, sous le
-- bandeau d'actualités et au-dessus du compteur : rien ne recouvre les slots
-- CL / CR (à droite, le bouton "🏠" touche déjà presque le slot CR).
-- `buttonCenterX` / `buttonCenterY` : centre du bouton dans la colonne.
local function buildStatus(column: Frame, buttonCenterX: number, buttonCenterY: number)
	statusLeft = UIUtil.Create("Frame", {
		Name = "StatusLeft",
		Size = UDim2.fromOffset(70, STATUS_HEIGHT),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromOffset(buttonCenterX - BUTTON_SIZE.X / 2 - 8, buttonCenterY - STATUS_LIFT),
		BackgroundTransparency = 1,
		Parent = column,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 3),
		Parent = statusLeft,
	})
	local function chip(name: string, text: string, color: Color3, textColor: Color3, chipOrder: number): Frame
		local frame = UIUtil.Chip({
			Name = name,
			Text = text,
			Color = color,
			TextColor3 = textColor,
			Height = 20,
			TextSize = 12,
			LayoutOrder = chipOrder,
			Visible = false,
			Parent = statusLeft,
		})
		-- (relief : dégradé déjà posé par UIUtil.Chip)
		UIUtil.Create("UIScale", { Name = "PopScale", Parent = frame })
		return frame
	end
	vipChip = chip("VIP", "👑 VIP", Theme.Colors.Premium, Theme.Colors.TextDark, 1)
	bonusChip = chip("Bonus", "💎 x1", Theme.Colors.Purple, Theme.Colors.TextLight, 2)

	-- Carte du boost : "⏱️ x2" + minuteur (sous les pastilles, dans la même colonne)
	boostCard = UIUtil.Create("Frame", {
		Name = "Boost",
		Size = UDim2.fromOffset(62, 38),
		BackgroundColor3 = Theme.Colors.Boost,
		LayoutOrder = 3,
		Visible = false,
		Parent = statusLeft,
	})
	UIUtil.Corner(boostCard, Theme.Radius.S)
	UIUtil.Stroke(boostCard, Theme.Colors.Border, 1.5, 0.3)
	UIUtil.Gradient(boostCard, ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(215, 215, 215)), 90)
	UIUtil.Create("UIScale", { Name = "PopScale", Parent = boostCard })
	boostTitle = UIUtil.Label({
		Text = "⏱️ x2",
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.TextLight,
		Size = UDim2.new(1, -8, 0, 17),
		Position = UDim2.fromOffset(4, 3),
		MaxTextSize = 14,
		ZIndex = 2,
		Parent = boostCard,
	})
	boostTimer = UIUtil.Label({
		Text = "0:00",
		Font = Theme.Fonts.Number,
		TextColor3 = Theme.Colors.TextLight,
		Size = UDim2.new(1, -8, 0, 15),
		Position = UDim2.fromOffset(4, 20),
		MaxTextSize = 13,
		ZIndex = 2,
		Parent = boostCard,
	})
	for _, label in ipairs({ boostTitle, boostTimer }) do
		local stroke = UIUtil.Stroke(label, Color3.fromRGB(120, 40, 0), 1, 0.5)
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	end
	foodBadge = FoodBoostBadge.Create(statusLeft, 4)
end

local function chipText(frame: Frame, text: string)
	local label = frame:FindFirstChild("Label") :: TextLabel?
	if label and label.Text ~= text then
		label.Text = text
	end
end

-- Montre / cache un indicateur (avec un petit "pop" à l'apparition)
local function setChipVisible(frame: GuiObject, visible: boolean)
	if frame.Visible == visible then
		return
	end
	frame.Visible = visible
	if visible then
		UIUtil.Pop(frame, 0.3, 0.4)
	end
end

-- Mise à jour des indicateurs + animation du robot (à chaque image)
local function updateStatus(dt: number)
	local data = ClientState.Data
	if not data then
		return
	end

	setChipVisible(vipChip, ClientState.IsVIP())

	local passMultiplier = ClientState.GetPassMultiplier()
	setChipVisible(bonusChip, passMultiplier > 1.001)
	if bonusChip.Visible then
		chipText(bonusChip, "💎 " .. NumberFormatter.Multiplier(passMultiplier))
	end

	local boostMultiplier, remaining = ClientState.GetBoost()
	setChipVisible(boostCard, remaining > 0)
	if remaining > 0 then
		local title = "⏱️ " .. NumberFormatter.Multiplier(boostMultiplier)
		if boostTitle.Text ~= title then
			boostTitle.Text = title
		end
		local clock = UIUtil.FormatClock(remaining)
		if boostTimer.Text ~= clock then
			boostTimer.Text = clock
		end
		-- Pulsation douce (plus rapide dans la dernière minute)
		local speed = remaining < 60 and 9 or 3
		boostCard.Rotation = math.sin(os.clock() * speed) * 3
	end
	FoodBoostBadge.Update(foodBadge)

	-- Auto-clic (Game Pass) : petit robot qui tape le coin du bouton
	local hasAuto = ClientState.HasPass("AutoClick")
	if robotLabel.Visible ~= hasAuto then
		robotLabel.Visible = hasAuto
		if hasAuto then
			UIUtil.Pop(robotLabel, 0.2, 0.5)
		end
	end
	if hasAuto then
		local autoPass = Config.GamePassesById.AutoClick
		local rate = (autoPass and tonumber(autoPass.AutoClicksPerSecond)) or 1
		robotClock += dt * rate
		-- Petit coup de tête à chaque "clic" du robot
		local phase = robotClock % 1
		robotLabel.Rotation = phase < 0.35 and 18 * math.sin(phase / 0.35 * math.pi) or 0
		-- Toutes les secondes : "+X" discret (gain approximatif des clics auto)
		robotFloatClock += dt
		if robotFloatClock >= 1 then
			robotFloatClock = 0
			local gain = (tonumber(data.ClickValue) or 0) * rate
			if gain > 0 and effectsLayer then
				local center = Interface.GetCanvasCenter(robotLabel)
				Effects.FloatingText(effectsLayer, UDim2.fromOffset(center.X - 6, center.Y - 16), "+" .. formatAmount(gain), Theme.Colors.Cyan, 18)
			end
		end
	end
end

-- Gros gain (bonus, jackpot, achat...) : le compteur grossit et brille
local function counterCelebrate(strength: number)
	counterScale.Scale = 1 + 0.08 * strength
	UIUtil.Tween(counterScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Elastic)
	counterFlashUntil = os.clock() + 0.8
end

----------------------------------------------------------------------
-- Mises à jour
----------------------------------------------------------------------

local function applyDarkMode(dark: boolean)
	local textColor = dark and Theme.DarkColors.Text or Theme.Colors.Text
	local dimColor = dark and Theme.DarkColors.TextDim or Theme.Colors.TextDim
	counterLabel.TextColor3 = textColor
	unitLabel.TextColor3 = dimColor
	perSecondLabel.TextColor3 = dimColor
	for _, label in ipairs({ counterLabel, unitLabel }) do
		local counterStroke = label:FindFirstChild("DarkStroke") :: UIStroke?
		if counterStroke then
			counterStroke.Enabled = dark
		end
	end
	local perSecondStroke = perSecondLabel:FindFirstChild("DarkStroke") :: UIStroke?
	if perSecondStroke then
		perSecondStroke.Enabled = dark
	end
end

local function refreshPills(instant: boolean?)
	local skipPop = instant == true
	for _, pill in pairs(pills) do
		local feature = pill.Def.Feature
		local shouldShow = (feature == nil or ClientState.HasFeature(feature))
			and (pill.Def.Visible == nil or pill.Def.Visible())
		if shouldShow and not pill.Holder.Visible then
			pill.Holder.Visible = true
			local scale = pill.Holder:FindFirstChild("PopScale") :: UIScale?
			if scale and not skipPop then
				scale.Scale = 0.2
				UIUtil.Tween(scale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
			end
		elseif not shouldShow and pill.Holder.Visible then
			pill.Holder.Visible = false
			if PanelManager.IsOpen(pill.Def.Panel) then
				PanelManager.Close()
			end
		end
	end
end

local function refreshBadges()
	local data = ClientState.Data
	if not data then
		return
	end

	-- Boutique : objets pas encore possédés qu'on peut se payer
	local shop = pills.ItemShop
	if shop then
		local owned = (data.Cosmetics and data.Cosmetics.Owned) or {}
		local dopamine = ClientState.GetConfirmedDopamine()
		local affordable = 0
		for _, cosmetic in ipairs(Config.Cosmetics) do
			local unlocked = (tonumber(cosmetic.RequiresRebirths) or 0) <= (tonumber(data.Rebirths) or 0)
			if unlocked and not owned[cosmetic.Id] and dopamine >= cosmetic.Cost then
				affordable += 1
			end
		end
		UIUtil.SetBadge(shop.Badge, affordable)
	end

	-- Succès : débloqués depuis la dernière ouverture du menu
	local achievements = pills.Achievements
	if achievements then
		local count = countTrue(data.Achievements)
		if seenAchievements == nil or PanelManager.IsOpen("Achievements") then
			seenAchievements = count
		end
		UIUtil.SetBadge(achievements.Badge, math.max(0, count - (seenAchievements or count)))
	end

	-- Cadeau : disponible ?
	local daily = pills.Daily
	if daily then
		UIUtil.SetBadge(daily.Badge, (data.Daily and data.Daily.Available) and "!" or "")
	end

	-- Classement : couronne quand tu es 1er du serveur (au moins 2 joueurs)
	local leaderboard = pills.Leaderboard
	if leaderboard then
		local rank, count = ClientState.GetServerRank()
		UIUtil.SetBadge(leaderboard.Badge, (rank == 1 and count >= 2) and "👑" or "")
	end

	-- Maison : nouveaux objets abordables
	refreshHouseBadge(data)

	-- Thèmes : thèmes achetables en Dopamine, pas encore possédés, qu'on peut se payer
	local themes = pills.Themes
	if themes then
		local owned = (type(data.Themes) == "table" and data.Themes.Owned) or {}
		local dopamine = ClientState.GetConfirmedDopamine()
		local affordable = 0
		for _, theme in ipairs(Config.Themes) do
			local cost = tonumber(theme.Cost)
			if cost and cost > 0 and not owned[theme.Id] and dopamine >= cost then
				affordable += 1
			end
		end
		UIUtil.SetBadge(themes.Badge, affordable)
	end
end

local function onState(data)
	-- Dopamine / s : la ligne glisse vers la nouvelle valeur (voir RenderStepped)
	local perSecond = tonumber(data.PerSecond) or 0
	if perSecond > perSecondTarget * 1.0005 and perSecondTarget > 0 then
		perSecondFlashUntil = os.clock() + 0.9 -- hausse : la ligne passe au vert un instant
		perSecondScale.Scale = 1.08
		UIUtil.Tween(perSecondScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	if perSecondTarget <= 0 or perSecond < perSecondTarget then
		perSecondShown = perSecond -- baisse (océan) ou 1er état : tout de suite
	end
	perSecondTarget = perSecond
	comboBar.Visible = data.ComboEnabled == true
	local equipped = data.Cosmetics and data.Cosmetics.Equipped
	applySkin((equipped and equipped.Skin) or "")
	applyHat((equipped and equipped.Hat) or "")
	refreshBadges()
end

----------------------------------------------------------------------
-- API
----------------------------------------------------------------------

-- `parent` = calque Main ; `floatingLayer` = calque au-dessus des stimuli
-- (infobulle) ; `fxLayer` = calque des effets
function CenterColumn.Build(parent: Frame, floatingLayer: Frame, fxLayer: Frame)
	effectsLayer = fxLayer

	local column = UIUtil.Create("Frame", {
		Name = "CenterColumn",
		Size = UDim2.fromOffset(700, 410),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 24),
		BackgroundTransparency = 1,
		Parent = parent,
	})

	buildButton(column)
	buildHouseButton(column, 350, 40 + BUTTON_SIZE.Y / 2)
	buildStatus(column, 350, 40 + BUTTON_SIZE.Y / 2)

	-- Pile verticale sous le bouton (les éléments cachés ne prennent pas de place)
	local stack = UIUtil.Create("Frame", {
		Name = "Stack",
		Size = UDim2.new(1, 0, 1, -(40 + BUTTON_SIZE.Y + 4)),
		Position = UDim2.fromOffset(0, 40 + BUTTON_SIZE.Y + 4),
		BackgroundTransparency = 1,
		Parent = column,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 3), -- tout doit tenir au-dessus des emplacements du bas (y <= 425)
		Parent = stack,
	})

	-- Compteur : gros nombre + unité plus discrète, alignés sur la même ligne
	counterRow = UIUtil.Create("Frame", {
		Name = "Counter",
		Size = UDim2.fromOffset(620, 46),
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = stack,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		Parent = counterRow,
	})
	counterScale = UIUtil.Create("UIScale", { Parent = counterRow })
	counterLabel = UIUtil.Create("TextLabel", {
		Name = "Number",
		Size = UDim2.fromOffset(0, 46),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Number,
		Text = "0",
		TextColor3 = Theme.Colors.Text,
		TextSize = Theme.TextSize.Display,
		TextYAlignment = Enum.TextYAlignment.Bottom,
		LayoutOrder = 1,
		Parent = counterRow,
	})
	unitLabel = UIUtil.Create("TextLabel", {
		Name = "Unit",
		Size = UDim2.fromOffset(0, 40),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = "Dopamine",
		TextColor3 = Theme.Colors.TextDim,
		TextSize = 24,
		TextYAlignment = Enum.TextYAlignment.Bottom,
		LayoutOrder = 2,
		Parent = counterRow,
	})
	for _, label in ipairs({ counterLabel, unitLabel }) do
		local counterStroke = UIUtil.Stroke(label, Theme.Colors.TextDark, 2, 0.3)
		counterStroke.Name = "DarkStroke"
		counterStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		counterStroke.Enabled = false
	end

	perSecondLabel = UIUtil.Label({
		Name = "PerSecond",
		Text = Locale.T("%s Dopamine per second", "0"),
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.fromOffset(320, 22),
		LayoutOrder = 2,
		MaxTextSize = 21,
		Parent = stack,
	})
	perSecondScale = UIUtil.Create("UIScale", { Parent = perSecondLabel })
	local perSecondStroke = UIUtil.Stroke(perSecondLabel, Theme.Colors.TextDark, 1.5, 0.4)
	perSecondStroke.Name = "DarkStroke"
	perSecondStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	perSecondStroke.Enabled = false

	buildRush(perSecondLabel)
	pillsStack = stack
	buildPills(stack, 5)
	buildCombo(stack, 6)
	local upgradeBar = UpgradeBar.Build(stack, floatingLayer)
	upgradeBar.LayoutOrder = 7

	-- Signaux
	ClientState.Changed:Connect(onState)
	ClientState.NotifyReceived:Connect(function(payload)
		local kind = payload.Type
		if kind == "Purchase" or kind == "Jackpot" then
			counterCelebrate(2)
		elseif kind == "Bonus" or kind == "Quest" or kind == "Achievement" then
			counterCelebrate(1)
		end
	end)
	ClientState.FeaturesChanged:Connect(function()
		refreshPills()
	end)
	ClientState.DarkModeChanged:Connect(applyDarkMode)
	applyDarkMode(ClientState.DarkMode)
	PanelManager.Opened:Connect(function(name: string)
		if name == "House" and ClientState.Data then
			refreshHouseBadge(ClientState.Data)
		end
		if name == "Achievements" and ClientState.Data then
			seenAchievements = countTrue(ClientState.Data.Achievements)
			local pill = pills.Achievements
			if pill then
				UIUtil.SetBadge(pill.Badge, 0)
			end
		end
	end)

	-- Compteur lissé, jauge de combo, Rush : à chaque image
	local badgeClock = 0
	RunService.RenderStepped:Connect(function(dt: number)
		local shownText = formatAmount(ClientState.UpdateDisplay(dt))
		if shownText ~= counterText then
			counterText = shownText
			counterLabel.Text = shownText
		end
		-- Ligne "par seconde" : glisse vers la nouvelle valeur (texte changé seulement si besoin)
		if perSecondShown ~= perSecondTarget then
			perSecondShown += (perSecondTarget - perSecondShown) * (1 - math.exp(-8 * dt))
			if math.abs(perSecondTarget - perSecondShown) <= math.max(0.01, perSecondTarget * 0.001) then
				perSecondShown = perSecondTarget
			end
		end
		if perSecondShown ~= perSecondDrawn then
			perSecondDrawn = perSecondShown
			local rateText = Locale.T("%s Dopamine per second", formatAmount(perSecondShown))
			if rateText ~= perSecondText then
				perSecondText = rateText
				perSecondLabel.Text = rateText
			end
		end
		local rateFlash = os.clock() < perSecondFlashUntil
		if rateFlash or perSecondFlashing then
			local dim = ClientState.DarkMode and Theme.DarkColors.TextDim or Theme.Colors.TextDim
			local k = rateFlash and math.clamp((perSecondFlashUntil - os.clock()) / 0.9, 0, 1) or 0
			perSecondLabel.TextColor3 = dim:Lerp(Theme.Colors.RobuxDark, k)
			perSecondFlashing = rateFlash
		end
		-- Gros gain : le nombre brille en doré un instant
		local flashing = os.clock() < counterFlashUntil
		if flashing or counterFlashing then
			local base = ClientState.DarkMode and Theme.DarkColors.Text or Theme.Colors.Text
			local t = flashing and math.clamp((counterFlashUntil - os.clock()) / 0.8, 0, 1) or 0
			counterLabel.TextColor3 = base:Lerp(Theme.Colors.Gold, t)
			counterFlashing = flashing
		end

		updateStatus(dt)

		if comboBar.Visible then
			local meter = ClientState.GetComboMeter()
			comboFill.Size = UDim2.fromScale(meter / 100, 1)
			comboLabel.Text = Locale.T("COMBO %s", NumberFormatter.Multiplier(Formulas.GetComboMultiplier(meter)))
			comboBar.Rotation = meter >= 99.5 and math.sin(os.clock() * 30) * 1.5 or 0
		end

		local rush = ClientState.Rush
		local remaining = (rush.EndsAt or 0) - workspace:GetServerTimeNow()
		local active = rush.Active == true and remaining > 0
		if rushBanner.Visible ~= active then
			rushBanner.Visible = active
		end
		if active then
			rushLabel.Text = string.format(
				"⚡ %s x%s — %ds",
				Locale.T(tostring(rush.Name or "RUSH")),
				tostring(rush.Multiplier or 2),
				math.ceil(remaining)
			)
			rushBanner.Rotation = math.sin(os.clock() * 8) * 1.5
		end

		-- Bouton "🏠" : petit sautillement quand un nouvel objet est abordable
		if houseBadgeCount > 0 and os.clock() >= houseWiggleAt then
			houseWiggleAt = os.clock() + 4
			houseButton.Rotation = -12
			UIUtil.Tween(houseButton, 0.6, { Rotation = 0 }, Enum.EasingStyle.Elastic)
		end

		-- Badges (4 fois par seconde : la Dopamine monte en continu)
		badgeClock += dt
		if badgeClock >= 0.25 then
			badgeClock = 0
			refreshBadges()
		end
	end)

	-- Petit rappel tant que le joueur n'a jamais cliqué
	task.spawn(function()
		while buttonHolder.Parent do
			local data = ClientState.Data
			if data and data.Stats and (data.Stats.TotalClicks or 0) == 0 then
				UIUtil.Tween(buttonHolder, 0.25, { Rotation = 5 }, Enum.EasingStyle.Sine)
				task.wait(0.25)
				UIUtil.Tween(buttonHolder, 0.25, { Rotation = -5 }, Enum.EasingStyle.Sine)
				task.wait(0.25)
				UIUtil.Tween(buttonHolder, 0.25, { Rotation = 0 }, Enum.EasingStyle.Sine)
			end
			task.wait(2)
		end
	end)

	-- Écran qui change (téléphone <-> tablette, rotation) : pastilles et largeurs
	local function relayout()
		if Interface.Device ~= pillsDevice then
			buildPills(pillsStack, 5)
			refreshPills(true)
			refreshBadges()
		elseif pillsRow and pillsRow:IsA("ScrollingFrame") then
			local row = pillsRow :: ScrollingFrame
			row.Size = UDim2.fromOffset(pillsRowWidth(), row.Size.Y.Offset)
		end
	end
	Interface.DeviceChanged:Connect(relayout)
	Slots.Changed:Connect(relayout)

	if ClientState.Data then
		onState(ClientState.Data)
		refreshPills()
	end
	return column
end

return CenterColumn
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">CosmeticArt</string>
            <string name="Source"><![CDATA[--[[
	CosmeticArt (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > CosmeticArt

	(v9.2) Dessins des chapeaux et des motifs de boutons "cool" de la
	boutique d'objets (Config.Cosmetics) — uniquement des Frames, même style
	"autocollant" que la maison (boîte à outils de HouseArt) :
	  - chapeaux : casquette à l'envers, bandeau de ninja, casque gamer,
	    chapeau de pirate, casque de course, casque de viking, capuche de
	    dino, visière de robot (les autres chapeaux gardent leur emoji) ;
	  - motifs de boutons (cosmetic.Pattern) posés par-dessus le dégradé
	    Top -> Bottom : Carbon, Camo, Basketball, Controller, Flames, Lava,
	    Galaxy, Circuit. Positions en fractions : le motif s'adapte à la
	    taille du bouton (gros bouton, aperçu, pastille de la boutique).
	Rien n'est animé (aucune boucle) : quelques dizaines de Frames au plus.

	API :
	  CosmeticArt.HasHat(id) -> boolean
	  CosmeticArt.ApplyHat(label, cosmetic?) -> boolean
	      dessine le chapeau dans `label` (TextLabel carré du chapeau) et
	      vide son texte ; sinon remet l'emoji (cosmetic.Icon, "" si nil)
	  CosmeticArt.ApplySkin(button, cosmetic?, radius?, zIndex?)
	      pose (ou retire) le motif du bouton (enfant "SkinArt" découpé aux
	      coins arrondis du bouton, sous son texte)
]]

local Components = script.Parent
local HouseArt = require(Components:WaitForChild("House"):WaitForChild("HouseArt"))

local CosmeticArt = {}

local rgb = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)
local DARK = rgb(44, 46, 64)
local DARKER = rgb(30, 32, 46)
local CYAN = rgb(60, 222, 255)
local MAGENTA = rgb(255, 84, 196)
local LIME = rgb(140, 240, 110)
local RED = rgb(236, 66, 76)
local ORANGE = rgb(255, 152, 56)
local YELLOW = rgb(255, 214, 80)
local STEEL = rgb(176, 186, 206)
local GOLD = rgb(245, 190, 60)

----------------------------------------------------------------------
-- Chapeaux (boîte 100 x 100, le bas du chapeau vers y = 92)
----------------------------------------------------------------------

local HATS: { [string]: (body: Frame, kit: any) -> () } = {}

-- Casquette portée à l'envers (visière vers l'arrière, fermeture devant)
HATS.Snapback = function(body, kit)
	local navy = rgb(60, 80, 150)
	kit.Part(body, 60, 70, 36, 12, RED, { Radius = 6, Z = 1, Rotation = 10, Shine = true }) -- visière (derrière)
	local dome = kit.Part(body, 14, 36, 70, 54, navy, { Radius = 28, Z = 2, Shine = true })
	kit.Box(dome, 34, 4, 2, 48, kit.Lighten(navy, 0.25), 0.3, 2) -- couture
	kit.Circle(dome, 35, 3, 8, 6, RED, 0, 3) -- bouton
	-- ouverture réglable à l'avant
	local gap = kit.Part(body, 22, 72, 22, 14, rgb(255, 220, 196), { Radius = 7, Z = 3 })
	kit.Box(gap, 3, 2, 16, 3, WHITE, 0, 2)
	kit.Part(body, 10, 84, 80, 8, kit.Darken(navy, 0.2), { Radius = 4, Z = 3 })
	kit.Sparkle(dome, 50, 22, 12, YELLOW, 0, 3)
end

-- Bandeau de ninja (plaque en métal + rubans qui flottent)
HATS.NinjaBand = function(body, kit)
	for index, spec in ipairs({ { 70, 66, 28, -24 }, { 72, 76, 24, 16 } }) do
		kit.Part(body, spec[1], spec[2], spec[3], 9, RED, { Radius = 4, Z = 1, Rotation = spec[4] })
		local _ = index
	end
	local band = kit.Part(body, 6, 64, 88, 22, RED, { Radius = 11, Z = 2, Shine = true })
	kit.Box(band, 6, 16, 76, 2, kit.Darken(RED, 0.25), 0.2, 2)
	local plate = kit.Part(body, 30, 60, 40, 30, STEEL, { Radius = 6, Z = 3, Shine = true })
	-- étoile de ninja gravée
	kit.Diamond(plate, 20, 15, 10, DARK, 0, 2)
	kit.Box(plate, 11, 13.5, 18, 3, DARK, 0, 2)
	kit.Box(plate, 18.5, 6, 3, 18, DARK, 0, 2)
	kit.Circle(plate, 20, 15, 4, 4, STEEL, 0, 3)
	for _, x in ipairs({ 4, 36 }) do
		kit.Circle(plate, x, 5, 3, 3, DARK, 0.2, 2)
		kit.Circle(plate, x, 25, 3, 3, DARK, 0.2, 2)
	end
end

-- Casque gamer (arceau, oreillettes RGB, micro)
HATS.GamerHeadset = function(body, kit)
	local clip = kit.Group(body, 8, 20, 84, 50, 1, true)
	-- arceau clair (lisible sur les boutons sombres) + coussinet
	kit.Part(clip, 4, 4, 76, 90, WHITE, { Radius = -1, T = 1, Outline = rgb(230, 236, 250), Thickness = 9, Shade = false })
	local pad = kit.Part(body, 30, 20, 40, 12, MAGENTA, { Radius = 6, Z = 2, Shine = true })
	kit.Box(pad, 8, 4, 24, 3, CYAN, 0.1, 2)
	for index, side in ipairs({ -1, 1 }) do
		local cx = 50 + side * 38
		local color = index == 1 and CYAN or MAGENTA
		kit.Blob(body, cx, 70, 30, 38, color, { Z = 2, Outline = false, Shade = false, T = 0.55 })
		local cup = kit.Blob(body, cx, 70, 24, 32, rgb(236, 240, 250), { Z = 3, Shine = true })
		kit.Blob(cup, 12, 16, 14, 20, DARKER, { Z = 2, Outline = color, Thickness = 2.5, Shade = false })
	end
	kit.Line(body, 16, 80, 34, 92, 3, DARK, 0, 4)
	kit.Blob(body, 36, 92, 9, 7, DARKER, { Z = 5 })
	kit.Circle(body, 36, 92, 4, 4, LIME, 0, 6)
end

-- Chapeau de pirate (tricorne noir, galon doré, tête de mort mignonne, plume)
HATS.PirateHat = function(body, kit)
	local black = rgb(46, 42, 58)
	kit.Part(body, 60, 18, 12, 40, rgb(240, 90, 110), { Radius = 6, Z = 1, Rotation = 30 }) -- plume
	local crown = kit.Part(body, 22, 30, 56, 44, black, { Radius = 20, Z = 2, Shine = true })
	local _ = crown
	local brim = kit.Part(body, 2, 62, 96, 26, black, { Radius = 13, Z = 3, Shine = true })
	kit.Stroke(brim, GOLD, 3, 0)
	for _, side in ipairs({ -1, 1 }) do
		kit.Part(body, 50 + side * 38 - 9, 50, 18, 26, black, { Radius = 9, Z = 3, Rotation = side * 30 })
	end
	local skull = kit.Blob(body, 50, 56, 22, 20, WHITE, { Z = 4 })
	kit.Circle(skull, 7, 9, 5, 5, black, 0, 2)
	kit.Circle(skull, 15, 9, 5, 5, black, 0, 2)
	kit.Box(skull, 8, 15, 6, 2, black, 0, 2)
	kit.Line(body, 38, 70, 62, 78, 3, WHITE, 0, 4)
	kit.Line(body, 62, 70, 38, 78, 3, WHITE, 0, 4)
end

-- Casque de course (intégral rouge, bandes blanches, visière fumée)
HATS.RacingHelmet = function(body, kit)
	local helmet = kit.Part(body, 10, 18, 80, 74, RED, { Radius = 36, Z = 1, Shine = true })
	kit.Box(helmet, 34, 2, 5, 70, WHITE, 0, 2)
	kit.Box(helmet, 42, 2, 5, 70, WHITE, 0, 2)
	local visor = kit.Part(body, 36, 42, 54, 26, DARKER, { Radius = 12, Z = 2 })
	kit.Gradient(visor, rgb(90, 110, 180), rgb(20, 20, 40), 90)
	kit.Shine(visor, 8, 5, 20, 5, 3, 0.35)
	kit.Part(body, 14, 80, 72, 12, DARKER, { Radius = 6, Z = 3 })
	local plate = kit.Blob(body, 26, 50, 22, 18, WHITE, { Z = 3 })
	kit.Text(plate, "7", 11, 9, 14, RED, 2)
end

-- Casque de viking (dôme gris, bandeau doré à rivets, cornes)
HATS.VikingHelmet = function(body, kit)
	local horn = rgb(250, 240, 214)
	local hornDark = rgb(226, 206, 170)
	for _, side in ipairs({ -1, 1 }) do
		-- corne qui s'affine en remontant vers l'extérieur
		kit.Blob(body, 50 + side * 34, 62, 22, 18, horn, { Z = 1, Rotation = side * 20 })
		kit.Blob(body, 50 + side * 42, 48, 16, 20, horn, { Z = 1, Rotation = side * 25 })
		kit.Blob(body, 50 + side * 45, 35, 11, 16, horn, { Z = 1, Rotation = side * 15 })
		kit.Triangle(body, 50 + side * 45, 18, 10, 14, horn, 1)
		kit.Box(body, 50 + side * 36 - 6, 56, 12, 3, hornDark, 0.2, 2)
	end
	local dome = kit.Part(body, 14, 30, 72, 60, STEEL, { Radius = 32, Z = 2, Shine = true })
	kit.Box(dome, 33, 4, 6, 54, GOLD, 0, 2)
	local band = kit.Part(body, 10, 76, 80, 14, GOLD, { Radius = 5, Z = 3, Shine = true })
	for index = 0, 5 do
		kit.Circle(band, 8 + index * 12.8, 7, 4, 4, rgb(200, 150, 50), 0, 2)
	end
	kit.Part(body, 45, 76, 10, 20, STEEL, { Radius = 3, Z = 4 }) -- nasal
end

-- Capuche de dino (verte, piques orange, dents, yeux)
HATS.DinoHood = function(body, kit)
	local green = rgb(120, 200, 110)
	for index = 0, 3 do
		kit.Triangle(body, 30 + index * 13, 10 + math.abs(index - 1.5) * 5, 14, 16, ORANGE, 1)
	end
	local hood = kit.Part(body, 12, 22, 76, 66, green, { Radius = 32, Z = 2, Shine = true })
	kit.Face(hood, 38, 26, 30, { Eyes = "big", Mouth = "none", Z = 3 })
	for index = 0, 6 do
		kit.TriangleDown(body, 20 + index * 10, 80, 8, 8, WHITE, 3) -- dents
	end
	kit.Part(body, 12, 78, 76, 6, kit.Darken(green, 0.2), { Radius = 3, Z = 3 })
	for _, x in ipairs({ 24, 76 }) do
		kit.Circle(body, x, 60, 8, 6, kit.Darken(green, 0.15), 0.2, 3) -- écailles
	end
end

-- Visière de robot (bandeau métal, visière lumineuse, antenne)
HATS.RobotVisor = function(body, kit)
	kit.Line(body, 50, 44, 50, 16, 3, STEEL, 0, 1)
	kit.Circle(body, 50, 14, 12, 12, RED, 0.5, 1)
	kit.Circle(body, 50, 14, 8, 8, RED, 0, 2)
	local band = kit.Part(body, 6, 44, 88, 44, STEEL, { Radius = 16, Z = 2, Shine = true })
	local visor = kit.Part(band, 8, 12, 72, 16, DARKER, { Radius = 8, Z = 2 })
	local glow = kit.Box(visor, 6, 5, 60, 6, CYAN, 0, 2)
	kit.Round(glow)
	for _, x in ipairs({ 22, 50 }) do
		kit.Box(visor, x, 4, 8, 8, WHITE, 0.2, 3)
	end
	for _, x in ipairs({ 4, 80 }) do
		kit.Circle(band, x, 22, 6, 6, DARK, 0, 3)
	end
	kit.Box(band, 10, 34, 68, 2, DARK, 0.4, 2)
end

function CosmeticArt.HasHat(id: string): boolean
	return HATS[id] ~= nil
end

-- Dessine le chapeau dans `label` (ou remet l'emoji) ; renvoie true si dessiné
function CosmeticArt.ApplyHat(label: GuiObject, cosmetic: any?): boolean
	local old = label:FindFirstChild("HatArt")
	if old then
		old:Destroy()
	end
	local painter = cosmetic and HATS[cosmetic.Id]
	local textLabel = label:IsA("TextLabel") and label or nil
	if not painter then
		if textLabel then
			textLabel.Text = cosmetic and tostring(cosmetic.Icon or "") or ""
		end
		return false
	end
	if textLabel then
		textLabel.Text = ""
	end
	local size = math.min(label.Size.X.Offset, label.Size.Y.Offset)
	if size <= 0 then
		size = math.min(label.AbsoluteSize.X, label.AbsoluteSize.Y)
	end
	if size <= 0 then
		size = 60
	end
	local body = Instance.new("Frame")
	body.Name = "HatArt"
	body.BackgroundTransparency = 1
	body.AnchorPoint = Vector2.new(0.5, 0.5)
	body.Position = UDim2.fromScale(0.5, 0.5)
	body.Size = UDim2.fromOffset(100, 100)
	body.ZIndex = label.ZIndex
	local scale = Instance.new("UIScale")
	scale.Scale = size / 100 * 1.2 -- (un peu plus grand qu'un emoji : les dessins ont des marges)
	scale.Parent = body
	local kit = HouseArt.NewKit(true)
	local ok, err = pcall(painter, body, kit)
	if not ok then
		warn("[CosmeticArt] Chapeau " .. tostring(cosmetic.Id) .. " : " .. tostring(err))
		body:Destroy()
		if textLabel then
			textLabel.Text = tostring(cosmetic.Icon or "")
		end
		return false
	end
	body.Parent = label
	return true
end

----------------------------------------------------------------------
-- Motifs des boutons (fractions de la taille du bouton)
----------------------------------------------------------------------

local function frame(parent: Instance, x: number, y: number, w: number, h: number, color: Color3, t: number?, z: number?): Frame
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.BackgroundColor3 = color
	f.BackgroundTransparency = t or 0
	f.Position = UDim2.fromScale(x, y)
	f.Size = UDim2.fromScale(w, h)
	f.ZIndex = z or 1
	f.Parent = parent
	return f
end

local function roundify(f: GuiObject, radius: UDim?)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = radius or UDim.new(1, 0)
	corner.Parent = f
end

-- Ovale centré (cx, cy), tourné
local function oval(parent: Instance, cx: number, cy: number, w: number, h: number, color: Color3, t: number?, rotation: number?, z: number?): Frame
	local f = frame(parent, cx, cy, w, h, color, t, z)
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Rotation = rotation or 0
	roundify(f)
	return f
end

-- Petit disque qui reste rond (largeur = hauteur en px)
local function dot(parent: Instance, cx: number, cy: number, h: number, color: Color3, t: number?, z: number?): Frame
	local f = frame(parent, cx, cy, h, h, color, t, z)
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.SizeConstraint = Enum.SizeConstraint.RelativeYY
	roundify(f)
	return f
end

local function ringOval(parent: Instance, cx: number, cy: number, w: number, h: number, color: Color3, thick: number, t: number?): Frame
	local f = oval(parent, cx, cy, w, h, color, 1)
	local line = Instance.new("UIStroke")
	line.Color = color
	line.Thickness = thick
	line.Transparency = t or 0
	line.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	line.Parent = f
	return f
end

local WEAVE = (function()
	local points = {}
	for index = 0, 18 do
		table.insert(points, NumberSequenceKeypoint.new(index / 18, index % 2 == 0 and 0.35 or 0.9))
	end
	return NumberSequence.new(points)
end)()

local SKINS: { [string]: (holder: Frame) -> () } = {}

SKINS.Carbon = function(holder)
	local rows = 7
	for row = 0, rows - 1 do
		for col = 0, 2 do
			local offset = (row % 2) * 0.03
			local strip = frame(holder, col / 3 - offset, row / rows, 1 / 3 + 0.01, 1 / rows, rgb(150, 156, 176), 0, 1)
			local weave = Instance.new("UIGradient")
			weave.Transparency = WEAVE
			weave.Parent = strip
		end
	end
	local gloss = frame(holder, 0.18, -0.4, 0.14, 1.8, WHITE, 0.82, 2)
	gloss.Rotation = 24
end

SKINS.Camo = function(holder)
	local tones = { rgb(70, 92, 56), rgb(122, 146, 90), rgb(176, 186, 130), rgb(90, 76, 60) }
	local spots = {
		{ 0.08, 0.2, 0.26, 0.5, -20 }, { 0.3, 0.75, 0.3, 0.45, 15 }, { 0.5, 0.2, 0.24, 0.5, 30 },
		{ 0.72, 0.7, 0.3, 0.5, -10 }, { 0.92, 0.25, 0.22, 0.6, 20 }, { 0.2, 0.5, 0.14, 0.4, 50 },
		{ 0.62, 0.45, 0.16, 0.35, -40 }, { 0.84, 0.95, 0.2, 0.4, 0 }, { 0.02, 0.9, 0.18, 0.4, 10 },
		{ 0.42, 1, 0.2, 0.4, 25 }, { 0.4, -0.05, 0.2, 0.35, 0 },
	}
	for index, s in ipairs(spots) do
		oval(holder, s[1], s[2], s[3], s[4], tones[index % #tones + 1], 0, s[5], 1)
	end
end

SKINS.Basketball = function(holder)
	local seam = rgb(90, 40, 20)
	frame(holder, 0.5, 0, 0.012, 1, seam, 0, 2).AnchorPoint = Vector2.new(0.5, 0)
	frame(holder, 0, 0.5, 1, 0.04, seam, 0, 2).AnchorPoint = Vector2.new(0, 0.5)
	ringOval(holder, 0.02, 0.5, 0.5, 1.6, seam, 2.5, 0)
	ringOval(holder, 0.98, 0.5, 0.5, 1.6, seam, 2.5, 0)
	for index = 1, 14 do
		local x = ((index * 0.37) % 1)
		local y = ((index * 0.61) % 1)
		dot(holder, x, y, 0.08, rgb(200, 90, 30), 0.5, 1)
	end
	local shine = oval(holder, 0.3, 0.2, 0.3, 0.18, WHITE, 0.7, -8, 3)
	local _ = shine
end

SKINS.Controller = function(holder)
	-- croix directionnelle à gauche, boutons à droite, sticks aux coins
	frame(holder, 0.06, 0.44, 0.14, 0.12, WHITE, 0.25, 2)
	frame(holder, 0.105, 0.26, 0.05, 0.48, WHITE, 0.25, 2)
	for index, spec in ipairs({ { 0.87, 0.3, YELLOW }, { 0.93, 0.5, RED }, { 0.81, 0.5, CYAN }, { 0.87, 0.7, LIME } }) do
		dot(holder, spec[1], spec[2], 0.2, spec[3], 0, 2)
		local _ = index
	end
	for _, x in ipairs({ 0.26, 0.74 }) do
		dot(holder, x, 0.82, 0.26, DARKER, 0.2, 2)
		dot(holder, x, 0.82, 0.14, rgb(90, 90, 120), 0, 3)
	end
	local led = frame(holder, 0.42, 0.08, 0.16, 0.06, CYAN, 0, 2)
	roundify(led)
end

-- Langue de flamme : base ronde + pointe (ovale étiré tourné)
local function flameTongue(holder: Instance, cx: number, h: number, w: number, color: Color3, z: number)
	oval(holder, cx, 1 - h * 0.18, w, h * 0.5, color, 0, 0, z)
	oval(holder, cx + w * 0.08, 1 - h * 0.55, w * 0.55, h * 0.8, color, 0, 12, z)
end

SKINS.Flames = function(holder)
	for index = 0, 6 do
		local cx = 0.04 + index * 0.155
		local h = 0.7 + ((index * 37) % 5) * 0.08
		flameTongue(holder, cx, h, 0.2, RED, 1)
		flameTongue(holder, cx, h * 0.8, 0.15, ORANGE, 2)
		flameTongue(holder, cx, h * 0.5, 0.09, YELLOW, 3)
	end
end

SKINS.Lava = function(holder)
	local rock = { rgb(70, 50, 54), rgb(96, 66, 66), rgb(60, 40, 46) }
	for index, spec in ipairs({ { 0.12, 0.3, 0.3, 0.7 }, { 0.42, 0.7, 0.34, 0.8 }, { 0.72, 0.28, 0.32, 0.7 }, { 0.95, 0.78, 0.26, 0.8 }, { 0.15, 0.95, 0.26, 0.5 } }) do
		oval(holder, spec[1], spec[2], spec[3], spec[4], rock[index % #rock + 1], 0, (index - 2) * 12, 1)
	end
	-- fissures lumineuses
	for index, spec in ipairs({ { 0.28, 0.5, 0.3, 30 }, { 0.58, 0.45, 0.28, -40 }, { 0.84, 0.55, 0.26, 55 }, { 0.3, 0.1, 0.2, -10 }, { 0.62, 0.95, 0.24, 10 } }) do
		local crack = frame(holder, spec[1], spec[2], spec[3], 0.06, rgb(255, 130, 50), 0, 2)
		crack.AnchorPoint = Vector2.new(0.5, 0.5)
		crack.Rotation = spec[4]
		roundify(crack)
		local glow = oval(holder, spec[1], spec[2], spec[3] * 1.1, 0.3, rgb(255, 170, 60), 0.7, spec[4], 2)
		local _ = glow
		local _i = index
	end
	dot(holder, 0.5, 0.2, 0.14, YELLOW, 0.2, 3)
	dot(holder, 0.1, 0.62, 0.1, YELLOW, 0.3, 3)
end

SKINS.Galaxy = function(holder)
	oval(holder, 0.5, 0.5, 0.9, 0.7, rgb(255, 120, 220), 0.7, -12, 1)
	oval(holder, 0.45, 0.5, 0.6, 0.35, rgb(120, 220, 255), 0.65, -12, 2)
	oval(holder, 0.5, 0.5, 0.25, 0.3, WHITE, 0.55, 0, 3)
	for index = 1, 16 do
		local x = (index * 0.618) % 1
		local y = (index * 0.377 + 0.1) % 1
		dot(holder, x, y, index % 4 == 0 and 0.1 or 0.05, WHITE, index % 3 == 0 and 0 or 0.3, 4)
	end
	local planet = dot(holder, 0.86, 0.3, 0.3, rgb(255, 180, 110), 0, 4)
	local ringBand = frame(planet, 0.5, 0.55, 1.8, 0.14, rgb(255, 230, 170), 0.1, 2)
	ringBand.AnchorPoint = Vector2.new(0.5, 0.5)
	ringBand.Rotation = -18
	roundify(ringBand)
end

SKINS.Circuit = function(holder)
	local traces = {
		{ 0, 0.25, 0.3, 0.035 }, { 0.3, 0.25, 0.012, 0.3 }, { 0.3, 0.55, 0.2, 0.035 },
		{ 0.7, 0.2, 0.3, 0.035 }, { 0.7, 0.2, 0.012, 0.45 }, { 0.62, 0.65, 0.09, 0.035 },
		{ 0, 0.8, 0.18, 0.035 }, { 0.18, 0.8, 0.012, 0.2 }, { 0.85, 0.82, 0.15, 0.035 }, { 0.85, 0.65, 0.012, 0.2 },
	}
	for index, t in ipairs(traces) do
		frame(holder, t[1], t[2], t[3], t[4], index % 2 == 0 and CYAN or LIME, 0.15, 1)
	end
	for _, n in ipairs({ { 0.5, 0.565 }, { 0.3, 0.255 }, { 0.62, 0.665 }, { 0.18, 0.99 }, { 0.855, 0.655 }, { 0.705, 0.215 } }) do
		dot(holder, n[1], n[2], 0.16, CYAN, 0, 2)
		dot(holder, n[1], n[2], 0.07, WHITE, 0, 3)
	end
	local chip = frame(holder, 0.42, 0.08, 0.16, 0.3, DARKER, 0, 2)
	roundify(chip, UDim.new(0, 3))
	local stroke = Instance.new("UIStroke")
	stroke.Color = MAGENTA
	stroke.Thickness = 1.5
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = chip
end

-- Pose (ou retire) le motif du bouton
function CosmeticArt.ApplySkin(button: GuiObject, cosmetic: any?, radius: number?, zIndex: number?)
	local old = button:FindFirstChild("SkinArt")
	if old then
		old:Destroy()
	end
	local pattern = cosmetic and cosmetic.Pattern
	local painter = type(pattern) == "string" and SKINS[pattern] or nil
	if not painter then
		return
	end
	-- CanvasGroup : le motif est découpé aux coins arrondis du bouton
	local holder = Instance.new("CanvasGroup")
	holder.Name = "SkinArt"
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.Size = UDim2.fromScale(1, 1)
	holder.ZIndex = zIndex or button.ZIndex
	holder.GroupTransparency = 0.12
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 12)
	corner.Parent = holder
	local ok, err = pcall(painter, holder)
	if not ok then
		warn("[CosmeticArt] Motif " .. tostring(pattern) .. " : " .. tostring(err))
		holder:Destroy()
		return
	end
	holder.Parent = button
end

return CosmeticArt
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">DebugTools</string>
            <string name="Source"><![CDATA[--[[
	DebugTools (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > DebugTools

	Outils de TEST, actifs UNIQUEMENT dans Roblox Studio :
	  - DebugTools.Run(commande, argument) : appelle la RemoteFunction
	    "DebugCommand" (le serveur refuse tout hors de Studio) et renvoie
	    (succès, message). Utilisé par le panneau "🛠️ Test".
	  - DebugTools.RegisterChatCommands() : déclare des TextChatCommand
	    CÔTÉ CLIENT (/give, /unlockall, /spawn...) : leur événement Triggered
	    se déclenche de façon fiable côté client, puis appelle la même
	    RemoteFunction. Le résultat s'affiche dans le chat (message système)
	    et en bandeau. Les commandes identiques déclarées par le serveur sont
	    désactivées localement (pas de doublon ; le serveur ignore de toute
	    façon une commande reçue deux fois dans la même seconde).
	  - /test ouvre le panneau de test ; /aide liste les commandes.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")

local Client = script.Parent.Parent
local Theme = require(Client.Theme)
local Signal = require(ReplicatedStorage.Shared.Signal)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Notifications = require(script.Parent.Notifications)

local DebugTools = {}

DebugTools.Enabled = RunService:IsStudio()
DebugTools.Ran = Signal.new() -- (commande, argument, succès, message) après chaque commande

-- Appelé par /test (branché par ClientMain : ouvre le panneau de test)
DebugTools.OpenPanel = nil :: (() -> ())?

local REMOTE_TIMEOUT = 5
local FOLDER_NAME = "DopamineClientCommands"

-- Commandes de chat : alias -> commande envoyée au serveur
-- ("/help" est déjà pris par Roblox : on utilise "/aide")
local CHAT_COMMANDS = {
	{ Alias = "give", Command = "give", Help = "/give 1e6" },
	{ Alias = "rush", Command = "rush", Help = "/rush" },
	{ Alias = "daily", Command = "daily", Help = "/daily" },
	{ Alias = "save", Command = "save", Help = "/save" },
	{ Alias = "corner", Command = "corner", Help = "/corner" },
	{ Alias = "unlockall", Command = "unlockall", Help = "/unlockall" },
	{ Alias = "spawn", Command = "spawn", Help = "/spawn golden" },
	{ Alias = "golden", Command = "golden", Help = "/golden" },
	{ Alias = "detox", Command = "detox", Help = "/detox" },
	{ Alias = "chest", Command = "chest", Help = "/chest 3" },
	{ Alias = "reset", Command = "reset", Help = "/reset" },
	{ Alias = "pass", Command = "pass", Help = "/pass vip" },
	{ Alias = "boost", Command = "boost", Help = "/boost 5 60" },
	{ Alias = "theme", Command = "theme", Help = "/theme kawaii" },
	{ Alias = "offline", Command = "offline", Help = "/offline 7200" },
	{ Alias = "aide", Command = "help", Help = "/aide" },
}

local registered = false
local lastDuplicate = false -- la dernière commande était un doublon (déjà exécutée)
local myCommands: { [TextChatCommand]: boolean } = {}
local myAliases: { [string]: boolean } = {} -- "/give" -> true

-- Texte d'aide (liste des commandes de chat)
function DebugTools.HelpText(): string
	local list = {}
	for _, entry in ipairs(CHAT_COMMANDS) do
		table.insert(list, entry.Help)
	end
	table.insert(list, "/test")
	return table.concat(list, "  ")
end

-- RemoteFunction "DebugCommand" (sans attente infinie si le serveur ne l'a pas)
local function getRemote(): RemoteFunction?
	local folder = ReplicatedStorage:WaitForChild("Remotes", REMOTE_TIMEOUT)
	if not folder then
		return nil
	end
	local remote = folder:WaitForChild("DebugCommand", REMOTE_TIMEOUT)
	if remote and remote:IsA("RemoteFunction") then
		return remote
	end
	return nil
end

-- Lance une commande de test sur le serveur (bloque le thread appelant).
-- Renvoie (succès, message).
function DebugTools.Run(command: string, argument: string?): (boolean, string)
	if not DebugTools.Enabled then
		return false, Locale.T("Test commands are only available in Studio")
	end
	local remote = getRemote()
	if not remote then
		return false, Locale.T("DebugCommand RemoteFunction not found (server out of date?)")
	end
	local ok, success, message, duplicate = pcall(function()
		return remote:InvokeServer(command, argument or "")
	end)
	local result: boolean
	local text: string
	if not ok then
		result, text = false, Locale.T("Network error: %s", tostring(success))
	else
		result = success == true
		text = message ~= nil and tostring(message) or (result and "OK" or Locale.T("Refused"))
		-- 3e valeur du serveur : commande déjà exécutée (doublon du chat)
		if duplicate == true then
			lastDuplicate = true
		end
	end
	DebugTools.Ran:Fire(command, argument or "", result, text)
	return result, text
end

----------------------------------------------------------------------
-- Commandes de chat (client)
----------------------------------------------------------------------

-- Affiche un message système dans la fenêtre de chat (si possible)
local function systemMessage(text: string)
	pcall(function()
		local channels = TextChatService:FindFirstChild("TextChannels")
		local channel = channels and channels:FindFirstChild("RBXSystem")
		if channel and channel:IsA("TextChannel") then
			channel:DisplaySystemMessage(text)
		end
	end)
end

-- Désactive (localement) une commande déclarée ailleurs avec un de nos alias
local function disableDuplicate(instance: Instance)
	if not instance:IsA("TextChatCommand") or myCommands[instance] then
		return
	end
	local primary = string.lower(instance.PrimaryAlias)
	local secondary = string.lower(instance.SecondaryAlias)
	if myAliases[primary] or myAliases[secondary] then
		pcall(function()
			instance.Enabled = false
		end)
	end
end

local function onTriggered(entry, text: string)
	-- "/give 1e6" -> argument "1e6" ; "/boost 5 60" -> "5 60"
	local argument = string.match(text, "^%s*/%S+%s*(.-)%s*$") or ""
	task.spawn(function()
		lastDuplicate = false
		local ok, message = DebugTools.Run(entry.Command, argument)
		if lastDuplicate or message == "(already run)" or message == "(déjà exécutée)" then
			return
		end
		systemMessage((ok and "🛠️ " or "❌ ") .. message)
		if not ok then
			Notifications.Toast(message, Theme.Colors.Red, 4, Locale.T("Command /%s", entry.Alias), false, "🛠️")
		end
	end)
end

function DebugTools.RegisterChatCommands()
	if not DebugTools.Enabled or registered then
		return
	end
	registered = true
	-- Les TextChatCommand ne marchent qu'avec le nouveau chat (TextChatService)
	local okVersion, isNewChat = pcall(function()
		return TextChatService.ChatVersion == Enum.ChatVersion.TextChatService
	end)
	if not okVersion or not isNewChat then
		return
	end

	local ok, err = pcall(function()
		local old = TextChatService:FindFirstChild(FOLDER_NAME)
		if old then
			old:Destroy()
		end
		local folder = Instance.new("Folder")
		folder.Name = FOLDER_NAME

		local function add(alias: string, callback: (text: string) -> ())
			local command = Instance.new("TextChatCommand")
			command.Name = "ClientDebug_" .. alias
			command.PrimaryAlias = "/" .. alias
			myCommands[command] = true
			myAliases["/" .. alias] = true
			command.Triggered:Connect(function(_source: TextSource, text: string)
				callback(text)
			end)
			command.Parent = folder
		end

		for _, entry in ipairs(CHAT_COMMANDS) do
			add(entry.Alias, function(text: string)
				onTriggered(entry, text)
			end)
		end
		add("test", function()
			local open = DebugTools.OpenPanel
			if open then
				open()
			end
		end)
		folder.Parent = TextChatService
	end)
	if not ok then
		warn("[DebugTools] Impossible de déclarer les commandes de chat : " .. tostring(err))
		return
	end

	-- Commandes du serveur avec le même alias : désactivées ici (une seule exécution)
	for _, descendant in ipairs(TextChatService:GetDescendants()) do
		disableDuplicate(descendant)
	end
	TextChatService.DescendantAdded:Connect(disableDuplicate)
end

return DebugTools
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">FoodBoostBadge</string>
            <string name="Source"><![CDATA[--[[
	FoodBoostBadge (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > FoodBoostBadge

	🍦 Petite carte du BOOST NOURRITURE (v9.8, FAIR98) pour le HUD du
	clicker, à côté de la carte du boost Robux ("⏱️ x2") : "🍦 x1,5" +
	minuteur "1:42". Lit ClientState.Data.FoodBoost (envoyé par le serveur :
	FoodService:GetClientState) ; compte à rebours fluide entre deux états.
	Cachée quand aucun boost nourriture n'est actif.

	API (CenterColumn, 2 lignes) :
	  local card = FoodBoostBadge.Create(parent, layoutOrder)   -- à la construction
	  FoodBoostBadge.Update(card)                                -- à chaque image (updateStatus)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent
local UIUtil = require(Client.UIUtil)
local Theme = require(Client.Theme)
local ClientState = require(Client.ClientState)
local Config = require(ReplicatedStorage.Shared.Config)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)

local FoodBoostBadge = {}

local PINK = Color3.fromRGB(236, 72, 140)

-- fin du boost (os.clock) mémorisée par carte, recalée quand l'état change
type Card = { Frame: Frame, Title: TextLabel, Timer: TextLabel, EndsAt: number, Mult: number, Icon: string, Seen: any }

function FoodBoostBadge.Create(parent: Instance, layoutOrder: number?): Card
	local frame = UIUtil.Create("Frame", {
		Name = "FoodBoost",
		Size = UDim2.fromOffset(62, 38),
		BackgroundColor3 = PINK,
		LayoutOrder = layoutOrder or 4,
		Visible = false,
		Parent = parent,
	})
	UIUtil.Corner(frame, Theme.Radius.S)
	UIUtil.Stroke(frame, Theme.Colors.Border, 1.5, 0.3)
	UIUtil.Gradient(frame, ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(215, 215, 215)), 90)
	UIUtil.Create("UIScale", { Name = "PopScale", Parent = frame })
	local title = UIUtil.Label({
		Text = "🍦 x1.5",
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.TextLight,
		Size = UDim2.new(1, -8, 0, 17),
		Position = UDim2.fromOffset(4, 3),
		MaxTextSize = 14,
		ZIndex = 2,
		Parent = frame,
	})
	local timer = UIUtil.Label({
		Text = "0:00",
		Font = Theme.Fonts.Number,
		TextColor3 = Theme.Colors.TextLight,
		Size = UDim2.new(1, -8, 0, 15),
		Position = UDim2.fromOffset(4, 20),
		MaxTextSize = 13,
		ZIndex = 2,
		Parent = frame,
	})
	for _, label in ipairs({ title, timer }) do
		local stroke = UIUtil.Stroke(label, Color3.fromRGB(120, 20, 70), 1, 0.5)
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	end
	return { Frame = frame, Title = title, Timer = timer, EndsAt = 0, Mult = 1, Icon = "🍦", Seen = nil }
end

function FoodBoostBadge.Update(card: Card?)
	if not card then
		return
	end
	local data = ClientState.Data
	local boost = type(data) == "table" and data.FoodBoost or nil
	-- nouvel état reçu : on recale la fin (écarts < 1 s ignorés)
	if boost ~= card.Seen then
		card.Seen = boost
		local remaining = type(boost) == "table" and tonumber(boost.Remaining) or 0
		local m = type(boost) == "table" and tonumber(boost.Multiplier) or 1
		if remaining and remaining > 0 and m and m > 1 then
			local newEnd = os.clock() + remaining
			if math.abs(newEnd - card.EndsAt) > 1 then
				card.EndsAt = newEnd
			end
			card.Mult = m
			local food = Config.FoodById[boost.Food or ""]
			card.Icon = food and food.Icon or "🍦"
		else
			card.EndsAt = 0
		end
	end
	local left = card.EndsAt - os.clock()
	local visible = left > 0
	if card.Frame.Visible ~= visible then
		card.Frame.Visible = visible
		if visible then
			UIUtil.Pop(card.Frame, 0.3, 0.4)
		end
	end
	if visible then
		local title = card.Icon .. " " .. NumberFormatter.Multiplier(card.Mult)
		if card.Title.Text ~= title then
			card.Title.Text = title
		end
		local clock = UIUtil.FormatClock(left)
		if card.Timer.Text ~= clock then
			card.Timer.Text = clock
		end
		card.Frame.Rotation = math.sin(os.clock() * (if left < 30 then 9 else 3)) * 3
	end
end

return FoodBoostBadge
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">GraphicsControls</string>
            <string name="Source"><![CDATA[--[[
	GraphicsControls (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > GraphicsControls

	v9.8 (REALISM98) 🎨 lignes de réglages "Graphismes / Mode réaliste",
	même allure que la fenêtre ⚙️ Paramètres (pastille d'icône, titre,
	sous-titre, interrupteur animé ou onglets à droite ; sous le titre quand
	c'est étroit, ex. téléphone). Utilisées par Panels/Settings (section
	"Graphismes") et par World/TownGraphics (fenêtre ouverte en ville).
	  - ✨ Mode réaliste (ON / OFF ; "Auto" = selon l'appareil) : c'est un
	    préréglage, il remet les réglages détaillés sur "Auto" ;
	  - 🪞 Reflets : Off / Miroirs / Tout ;
	  - 🌦️ Météo : On / Off (+ le temps qu'il fait en ville maintenant) ;
	  - 🌧️ Pluie : Faible / Moyenne / Forte ;
	  - 🌗 Ombres : Basses / Hautes ;
	  - 🌟 Effets (halo, rayons de soleil, flou lointain) : On / Off ;
	  - 🏙️ Détail (distance d'affichage du décor de la ville) : Bas / Moyen / Élevé ;
	  - (v9.9 REALISM99) 🕐 Heure du jour : Auto (l'heure de la ville) / Jour /
	    Coucher de soleil / Nuit : pour ce joueur seulement (Lighting local,
	    TownAtmosphere), gardée quand on bascule le Mode réaliste ;
	  - ↺ "Tout en automatique".
	Chaque choix s'applique TOUT DE SUITE (GraphicsQuality.SetLocal) puis
	est sauvegardé côté serveur (SetSetting, 3 essais ; sinon retour en
	arrière + message).

	API :
	  GraphicsControls.Build(parent, opts) -> { Refresh: () -> (), Destroy: () -> () }
	    parent : cadre avec un UIListLayout (les lignes y sont ajoutées)
	    opts = { Order: number?, Accent: Color3?, Toast: ((text, color) -> ())? }
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local Net = require(ReplicatedStorage.Shared.Net)
local Locale = require(ReplicatedStorage.Shared.Locale)
local GraphicsQuality = require(ReplicatedStorage.Shared.GraphicsQuality)

local GraphicsControls = {}

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local ROW_HOVER = Theme.Colors.Surface or Theme.Colors.PanelLight
local ROW_BORDER = Theme.Colors.Divider or Theme.Colors.Disabled
local ON_COLOR = Theme.Colors.Green
local OFF_COLOR = Theme.Colors.Disabled
local NARROW = 500 -- (px) en dessous : contrôle sous le titre

local WEATHER_ICON = { Clear = "☀️", Cloudy = "☁️", Showers = "🌦️", Rain = "🌧️", Storm = "⛈️" }
local WEATHER_TEXT = { Clear = "Clear", Cloudy = "Cloudy", Showers = "Showers", Rain = "Rain", Storm = "Storm" }

type ToggleUI = { Button: TextButton, Knob: Frame, Stroke: UIStroke, OnIcon: Frame, OffIcon: Frame }
type Row = { Frame: Frame, Title: TextLabel, Subtitle: TextLabel, Control: GuiObject, Tall: number, Dim: Frame? }

local function paintToggle(ui: ToggleUI, value: boolean, animate: boolean)
	local duration = animate and 0.22 or 0
	UIUtil.Tween(ui.Knob, duration, {
		Position = value and UDim2.new(1, -3, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
		AnchorPoint = value and Vector2.new(1, 0.5) or Vector2.new(0, 0.5),
	}, Enum.EasingStyle.Back)
	UIUtil.Tween(ui.Button, duration, { BackgroundColor3 = value and ON_COLOR or OFF_COLOR })
	UIUtil.Tween(ui.Stroke, duration, { Color = (value and ON_COLOR or OFF_COLOR):Lerp(BLACK, 0.25) })
	ui.OnIcon.Visible = value
	ui.OffIcon.Visible = not value
	UIUtil.SetIconColor(value and ui.OnIcon or ui.OffIcon, (value and ON_COLOR or OFF_COLOR):Lerp(BLACK, 0.2))
end

-- Interrupteur ON / OFF (même dessin que les Paramètres)
local function buildToggle(parent: Instance, onActivated: () -> ()): ToggleUI
	local button = UIUtil.Create("TextButton", {
		Name = "Toggle",
		Size = UDim2.fromOffset(60, 32),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 14),
		BackgroundColor3 = ON_COLOR,
		AutoButtonColor = false,
		Text = "",
		Parent = parent,
	})
	UIUtil.Corner(button, UDim.new(1, 0))
	local stroke = UIUtil.Stroke(button, ON_COLOR:Lerp(BLACK, 0.25), 1.5, 0.2)
	UIUtil.Create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(WHITE, Color3.fromRGB(215, 215, 215)),
		Parent = button,
	})
	local knob = UIUtil.Create("Frame", {
		Name = "Knob",
		Size = UDim2.fromOffset(26, 26),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -3, 0.5, 0),
		BackgroundColor3 = WHITE,
		ZIndex = 2,
		Parent = button,
	})
	UIUtil.Corner(knob, UDim.new(1, 0))
	UIUtil.Stroke(knob, BLACK, 1, 0.8)
	local onIcon = UIUtil.Icon("Check", { Name = "OnIcon", Size = 13, Thickness = 3, Color = ON_COLOR, ZIndex = 3, Parent = knob })
	local offIcon = UIUtil.Icon("Cross", { Name = "OffIcon", Size = 10, Thickness = 3, Color = OFF_COLOR, ZIndex = 3, Parent = knob })
	UIUtil.AnimateButton(button, 1.06, 0.93)
	button.Activated:Connect(onActivated)
	local hitbox = UIUtil.Create("TextButton", {
		Name = "Hitbox",
		Size = UDim2.new(1, 20, 1, 20),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 4,
		Parent = button,
	})
	hitbox.Activated:Connect(onActivated)
	return { Button = button, Knob = knob, Stroke = stroke, OnIcon = onIcon, OffIcon = offIcon }
end

-- Ligne : pastille d'icône, titre, sous-titre (fond au survol)
local function buildRow(parent: Instance, name: string, order: number, icon: string, title: string, accent: Color3): Row
	local row = UIUtil.Create("Frame", {
		Name = name,
		Size = UDim2.new(1, 0, 0, 60),
		BackgroundColor3 = ROW_HOVER,
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	})
	UIUtil.Corner(row, Theme.Radius.M)
	row.MouseEnter:Connect(function()
		UIUtil.Tween(row, 0.15, { BackgroundTransparency = 0 })
	end)
	row.MouseLeave:Connect(function()
		UIUtil.Tween(row, 0.2, { BackgroundTransparency = 1 })
	end)
	local bubble = UIUtil.Create("Frame", {
		Name = "Icon",
		Size = UDim2.fromOffset(36, 36),
		Position = UDim2.fromOffset(8, 12),
		BackgroundColor3 = accent:Lerp(WHITE, 0.85),
		Parent = row,
	})
	UIUtil.Corner(bubble, UDim.new(1, 0))
	UIUtil.Stroke(bubble, accent, 1, 0.6)
	UIUtil.Label({
		Text = icon,
		Size = UDim2.new(1, -10, 1, -10),
		Position = UDim2.fromOffset(5, 5),
		MaxTextSize = 20,
		Parent = bubble,
	})
	local titleLabel = UIUtil.Label({
		Name = "Title",
		Text = title,
		Font = Theme.Fonts.Title,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -150, 0, 20),
		Position = UDim2.fromOffset(56, 10),
		MaxTextSize = 17,
		Parent = row,
	})
	local subtitle = UIUtil.Create("TextLabel", {
		Name = "Subtitle",
		Size = UDim2.new(1, -150, 0, 17),
		Position = UDim2.fromOffset(56, 31),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		Text = "",
		TextColor3 = Theme.Colors.TextDim,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = row,
	})
	return { Frame = row, Title = titleLabel, Subtitle = subtitle, Control = row, Tall = 60, Dim = nil }
end

local function divider(parent: Instance, order: number)
	UIUtil.Create("Frame", {
		Name = "Divider",
		Size = UDim2.new(1, -16, 0, 1),
		BackgroundColor3 = ROW_BORDER,
		BorderSizePixel = 0,
		LayoutOrder = order,
		Parent = parent,
	})
end

-- Onglets à droite (large) ou sous le titre (étroit)
local function layoutTabs(row: Row, width: number)
	local tabsFrame = row.Control
	local wide = width >= NARROW
	if wide then
		row.Frame.Size = UDim2.new(1, 0, 0, 60)
		tabsFrame.AnchorPoint = Vector2.new(1, 0)
		tabsFrame.Size = UDim2.fromOffset(math.min(300, math.floor(width * 0.46)), Theme.TouchTarget - 4)
		tabsFrame.Position = UDim2.new(1, -10, 0, 10)
		local titleW = -(math.min(300, math.floor(width * 0.46)) + 76)
		row.Title.Size = UDim2.new(1, titleW, 0, 20)
		row.Subtitle.Size = UDim2.new(1, titleW, 0, 17)
	else
		row.Frame.Size = UDim2.new(1, 0, 0, 106)
		tabsFrame.AnchorPoint = Vector2.new(0, 0)
		tabsFrame.Size = UDim2.new(1, -20, 0, Theme.TouchTarget - 4)
		tabsFrame.Position = UDim2.fromOffset(10, 58)
		row.Title.Size = UDim2.new(1, -66, 0, 20)
		row.Subtitle.Size = UDim2.new(1, -66, 0, 17)
	end
end

-- Envoie un réglage au serveur (3 essais) ; échec -> valeur d'avant + message
local saveTokens: { [string]: number } = {}
local function save(key: string, value: string, previous: string, toast: ((string, Color3?) -> ())?)
	saveTokens[key] = (saveTokens[key] or 0) + 1
	local token = saveTokens[key]
	GraphicsQuality.SetLocal(key, value)
	task.spawn(function()
		for attempt = 1, 3 do
			if saveTokens[key] ~= token then
				return -- un choix plus récent a pris le relais
			end
			local ok, success = pcall(function()
				return Net.Function("SetSetting"):InvokeServer(key, value)
			end)
			if ok and success == true then
				return
			end
			if attempt < 3 then
				task.wait(0.3)
			end
		end
		if saveTokens[key] == token then
			GraphicsQuality.SetLocal(key, previous)
			if toast then
				toast(Locale.T("Couldn't save the graphics setting, try again."), Theme.Colors.Red)
			end
		end
	end)
end

function GraphicsControls.Build(parent: Instance, opts: { [string]: any }?): { Refresh: () -> (), Destroy: () -> () }
	local o = opts or {}
	local base = tonumber(o.Order) or 1
	local accent: Color3 = o.Accent or Theme.Colors.Cyan
	local toast = o.Toast
	local connections: { any } = {}
	local tabRows: { { Row: Row, Tabs: UIUtil.Tabs, Key: string } } = {}
	local toggles: { [string]: ToggleUI } = {}
	local rows: { [string]: Row } = {}

	local function setKey(key: string, value: string)
		local previous = GraphicsQuality.GetSaved(key)
		if previous == value then
			return
		end
		save(key, value, previous, toast)
	end

	-- ✨ Mode réaliste (préréglage : les réglages détaillés repassent en "Auto")
	local realRow = buildRow(parent, "GfxRealisticRow", base, "✨", Locale.T("Realistic mode"), accent)
	rows.GfxRealistic = realRow
	local autoChip = UIUtil.Chip({
		Name = "AutoChip",
		Text = Locale.T("Auto"),
		Color = accent,
		TextColor3 = Theme.Colors.TextLight,
		Height = 20,
		TextSize = 12,
		Parent = realRow.Frame,
	})
	autoChip.AnchorPoint = Vector2.new(1, 0)
	autoChip.Position = UDim2.new(1, -84, 0, 20)
	toggles.GfxRealistic = buildToggle(realRow.Frame, function()
		local on = not GraphicsQuality.Get().Realistic
		setKey("GfxRealistic", on and "On" or "Off")
		for _, key in ipairs(GraphicsQuality.ORDER) do
			if key ~= "GfxRealistic" and not GraphicsQuality.NOT_PRESET[key] then
				setKey(key, "Auto")
			end
		end
	end)
	divider(parent, base + 1)

	local function tabsRow(key: string, name: string, order: number, icon: string, title: string, subtitle: string, choices: { { Id: string, Text: string } })
		local row = buildRow(parent, name, order, icon, title, accent)
		row.Subtitle.Text = subtitle
		local tabs = UIUtil.Tabs({
			Name = "Choice",
			Parent = row.Frame,
			Tabs = choices,
			Color = accent,
			Size = UDim2.fromOffset(260, Theme.TouchTarget - 4),
			TextSize = 15,
			Selected = choices[1].Id,
			OnSelect = function(id: string)
				setKey(key, id)
			end,
		})
		row.Control = tabs.Frame
		rows[key] = row
		table.insert(tabRows, { Row = row, Tabs = tabs, Key = key })
	end

	-- (v9.9) 🕐 heure du jour (juste après le Mode réaliste : bien visible)
	tabsRow("GfxTime", "GfxTimeRow", base + 2, "🕐", Locale.T("Time of day"), Locale.T("Just for you · Auto = the town"), {
		{ Id = "Auto", Text = Locale.T("Auto") },
		{ Id = "Day", Text = Locale.T("Day") },
		{ Id = "Sunset", Text = Locale.T("Dusk") },
		{ Id = "Night", Text = Locale.T("Night") },
	})

	tabsRow("GfxReflections", "GfxReflectionsRow", base + 3, "🪞", Locale.T("Reflections"), Locale.T("Real mirrors, glossy screens and floors"), {
		{ Id = "Off", Text = Locale.T("None") },
		{ Id = "Mirrors", Text = Locale.T("Mirrors") },
		{ Id = "All", Text = Locale.T("All") },
	})

	-- 🌦️ Météo + temps actuel en ville
	local weatherRow = buildRow(parent, "GfxWeatherRow", base + 4, "🌦️", Locale.T("Weather in town"), accent)
	rows.GfxWeather = weatherRow
	toggles.GfxWeather = buildToggle(weatherRow.Frame, function()
		setKey("GfxWeather", GraphicsQuality.Get().Weather and "Off" or "On")
	end)

	tabsRow("GfxRain", "GfxRainRow", base + 5, "🌧️", Locale.T("Rain"), Locale.T("How heavy the rain looks"), {
		{ Id = "Low", Text = Locale.T("Light") },
		{ Id = "Medium", Text = Locale.T("Moderate") },
		{ Id = "High", Text = Locale.T("Heavy") },
	})
	tabsRow("GfxShadows", "GfxShadowsRow", base + 6, "🌗", Locale.T("Shadows"), Locale.T("Simple = smoother on small devices"), {
		{ Id = "Low", Text = Locale.T("Simple") },
		{ Id = "High", Text = Locale.T("Detailed") },
	})

	local fxRow = buildRow(parent, "GfxEffectsRow", base + 7, "🌟", Locale.T("Light effects"), accent)
	fxRow.Subtitle.Text = Locale.T("Soft glow, sun rays, distant blur")
	rows.GfxEffects = fxRow
	toggles.GfxEffects = buildToggle(fxRow.Frame, function()
		setKey("GfxEffects", GraphicsQuality.Get().Effects and "Off" or "On")
	end)

	tabsRow("GfxDetail", "GfxDetailRow", base + 8, "🏙️", Locale.T("Detail"), Locale.T("How far the town decor is shown"), {
		{ Id = "Low", Text = Locale.T("Low") },
		{ Id = "Medium", Text = Locale.T("Medium") },
		{ Id = "High", Text = Locale.T("High") },
	})

	-- ↺ tout en automatique
	local footer = UIUtil.Create("Frame", {
		Name = "GfxFooter",
		Size = UDim2.new(1, 0, 0, 46),
		BackgroundTransparency = 1,
		LayoutOrder = base + 9,
		Parent = parent,
	})
	local reset = UIUtil.PillButton({
		Name = "GfxAuto",
		Text = Locale.T("↺ All automatic"),
		Color = WHITE,
		TextColor3 = Theme.Colors.Text,
		Height = 36,
		TextSize = 15,
		Parent = footer,
	})
	reset.AnchorPoint = Vector2.new(1, 0.5)
	reset.Position = UDim2.new(1, -8, 0.5, 0)
	reset.Activated:Connect(function()
		for _, key in ipairs(GraphicsQuality.ORDER) do
			setKey(key, "Auto")
		end
	end)
	local hint = UIUtil.Create("TextLabel", {
		Name = "Hint",
		Size = UDim2.new(1, -200, 1, 0),
		Position = UDim2.fromOffset(10, 0),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		Text = Locale.T("Applied right away in Dopamine Town"),
		TextColor3 = Theme.Colors.TextDim,
		TextSize = 13,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = footer,
	})

	-- Temps qu'il fait en ville maintenant (même calcul que Weather3D)
	local function weatherNow(): string
		local world = Client:FindFirstChild("World")
		local module = world and world:FindFirstChild("Weather3D")
		if not module then
			return ""
		end
		local ok, text = pcall(function()
			local Weather3D = require(module) :: any
			local s = Weather3D.At(workspace:GetServerTimeNow())
			local kind = s.Kind
			if kind ~= "Clear" and s.Rain < 0.05 and s.Cloud < 0.6 then
				kind = s.Rainbow > 0.05 and "Clear" or "Cloudy"
			end
			return Locale.T("Now in town: %s", WEATHER_ICON[kind] .. " " .. Locale.T(WEATHER_TEXT[kind]))
		end)
		return ok and text or ""
	end

	local function refresh(animate: boolean)
		local q = GraphicsQuality.Get()
		local mode = GraphicsQuality.GetSaved("GfxRealistic")
		paintToggle(toggles.GfxRealistic, q.Realistic, animate)
		autoChip.Visible = mode == "Auto"
		realRow.Subtitle.Text = q.Realistic and Locale.T("Live mirrors, puddles, glossy floors") or Locale.T("Lighter look, smoother on small devices")
		paintToggle(toggles.GfxWeather, q.Weather, animate)
		local now = weatherNow()
		weatherRow.Subtitle.Text = q.Weather and (now ~= "" and now or Locale.T("Rain, storms and rainbows (same for everyone)"))
			or Locale.T("Always sunny")
		paintToggle(toggles.GfxEffects, q.Effects, animate)
		local values = { GfxReflections = q.Reflections, GfxRain = q.Rain, GfxShadows = q.Shadows, GfxDetail = q.Detail, GfxTime = q.TimeOfDay }
		for _, entry in ipairs(tabRows) do
			local value = values[entry.Key]
			if value and entry.Tabs.GetSelected() ~= value then
				entry.Tabs.Select(value, true)
			end
		end
		-- pluie grisée quand la météo est coupée
		local rainRow = rows.GfxRain
		if rainRow then
			rainRow.Frame.BackgroundTransparency = 1
			rainRow.Title.TextTransparency = q.Weather and 0 or 0.5
			rainRow.Subtitle.TextTransparency = q.Weather and 0 or 0.5
		end
		local anyManual = false
		for _, key in ipairs(GraphicsQuality.ORDER) do
			if GraphicsQuality.GetSaved(key) ~= "Auto" then
				anyManual = true
			end
		end
		reset.Visible = anyManual
		hint.Size = anyManual and UDim2.new(1, -200, 1, 0) or UDim2.new(1, -20, 1, 0)
	end

	-- Mise en page selon la largeur disponible
	local lastWidth = -1
	local function layout()
		local width = 0
		if parent:IsA("GuiObject") then
			width = (parent :: GuiObject).AbsoluteSize.X
		end
		if width <= 0 or width == lastWidth then
			return
		end
		lastWidth = width
		for _, entry in ipairs(tabRows) do
			layoutTabs(entry.Row, width)
		end
	end
	if parent:IsA("GuiObject") then
		table.insert(connections, (parent :: GuiObject):GetPropertyChangedSignal("AbsoluteSize"):Connect(layout))
	end
	layout()
	task.defer(layout)

	table.insert(connections, GraphicsQuality.Changed:Connect(function()
		refresh(true)
	end))
	refresh(false)

	return {
		Refresh = function()
			refresh(false)
			layout()
		end,
		Destroy = function()
			UIUtil.DisconnectAll(connections)
		end,
	}
end

return GraphicsControls
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="11">
          <Properties>
            <string name="Name">House</string>
          </Properties>
          <Item class="Folder" referent="12">
            <Properties>
              <string name="Name">Art</string>
            </Properties>
            <Item class="ModuleScript" referent="13">
              <Properties>
                <string name="Name">Cool92Adventure</string>
                <string name="Source"><![CDATA[--[[
	Cool92Adventure (ModuleScript) — (v9.2) aventure 🚀🦖🏴 : dinos, espace,
	robots, pirates, ninjas, super-héros (affiches maison, aucune marque),
	aquarium à requins, lampes néon
	Emplacement : ReplicatedStorage > Client > Components > House > Art > Cool92Adventure
	Contrat : voir HouseArt (boîte 100 x 100, pieds en bas pour les objets au
	sol, centrés pour les objets muraux).
]]

local Art = {}

local rgb = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)
local NAVY = rgb(52, 60, 100)
local DARK = rgb(44, 46, 64)
local DARKER = rgb(30, 32, 46)
local CYAN = rgb(60, 222, 255)
local RED = rgb(236, 66, 76)
local ORANGE = rgb(255, 152, 56)
local STEEL = rgb(176, 186, 206)
local CHROME = rgb(214, 222, 236)
local BLUE = rgb(80, 150, 255)
local DINO = rgb(120, 200, 110)
local BONE = rgb(246, 238, 220)
local LAVA = rgb(255, 110, 50)

-- Éclair (3 segments) dans la zone (x, y) de hauteur h
local function bolt(kit, parent, x, y, h, color, z, thick)
	local g = kit.Group(parent, x, y, h * 0.7, h, z)
	local t = thick or h * 0.16
	kit.Line(g, h * 0.55, 0, h * 0.16, h * 0.52, t, color, 0, 1)
	kit.Line(g, h * 0.16, h * 0.52, h * 0.54, h * 0.48, t, color, 0, 1)
	kit.Line(g, h * 0.54, h * 0.48, h * 0.14, h, t, color, 0, 1)
	return g
end

-- Bulles qui montent (aquarium, lampe à lave)
local function bubbles(kit, parent, list, z)
	for index, b in ipairs(list) do
		local bubble = kit.Circle(parent, b[1], b[2], b[3], b[3], WHITE, 0.45, z)
		kit.Stroke(bubble, WHITE, 1, 0.3)
		kit.Animate(bubble, "Bob", 3, 1.4, index * 0.9)
	end
end

----------------------------------------------------------------------
-- 🧸 Peluches
----------------------------------------------------------------------

-- T-rex en peluche (grosse tête, petits bras, dents, piques)
Art.TRexPlush = function(body, kit, _item)
	local C = kit.C
	local dark = kit.Darken(DINO, 0.2)
	-- queue + piques du dos
	kit.Blob(body, 20, 76, 40, 22, DINO, { Z = 1, Rotation = -20 })
	for index = 0, 3 do
		kit.Triangle(body, 30 + index * 9, 30 + index * 9, 10, 10, C.Butter, 1)
	end
	-- corps + ventre
	local belly = kit.Blob(body, 52, 70, 50, 50, DINO, { Z = 2, Shine = true })
	kit.Blob(belly, 28, 30, 30, 34, rgb(236, 246, 200), { Z = 2, Outline = false })
	for index = 0, 2 do
		kit.Box(belly, 18, 20 + index * 8, 20, 1.5, kit.Darken(DINO, 0.1), 0.4, 3)
	end
	-- pattes
	for _, x in ipairs({ 40, 64 }) do
		kit.Blob(body, x, 94, 18, 12, dark, { Z = 3 })
	end
	-- petits bras
	kit.Blob(body, 72, 58, 12, 7, DINO, { Z = 4, Rotation = 30 })
	-- tête
	local head = kit.Part(body, 44, 12, 50, 36, DINO, { Radius = 16, Z = 5, Shine = true })
	kit.Face(head, 28, 14, 20, { Eyes = "big", Mouth = "none", Z = 3 })
	kit.Part(head, 8, 24, 40, 8, rgb(255, 170, 190), { Radius = 4, Z = 2, Outline = false }) -- bouche
	for index = 0, 4 do
		kit.TriangleDown(head, 12 + index * 7, 24, 5, 5, WHITE, 3) -- dents
	end
	kit.Circle(head, 44, 8, 3, 3, dark, 0, 3) -- narine
	return nil
end

-- Ninja en peluche (capuche noire, bandeau rouge qui flotte, étoile en tissu)
Art.NinjaPlush = function(body, kit, _item)
	local C = kit.C
	-- rubans du bandeau (flottent)
	local tails = kit.Pivot(body, 22, 34, 1)
	kit.Part(tails, -20, -4, 22, 7, RED, { Radius = 3, Z = 1, Rotation = -18 })
	kit.Part(tails, -18, 4, 18, 6, RED, { Radius = 3, Z = 1, Rotation = 14 })
	kit.Animate(tails, "Sway", 8, 2.4, 0)
	-- corps
	local suit = kit.Blob(body, 50, 76, 50, 42, DARK, { Z = 2, Shine = true })
	kit.Box(suit, 6, 18, 38, 5, RED, 0, 2) -- ceinture
	for _, x in ipairs({ 38, 62 }) do
		kit.Blob(body, x, 95, 16, 10, DARKER, { Z = 3 })
	end
	-- tête
	local head = kit.Blob(body, 50, 38, 56, 50, DARK, { Z = 4, Shine = true })
	local slit = kit.Part(head, 8, 16, 40, 18, rgb(255, 220, 196), { Radius = 8, Z = 2, Outline = false })
	kit.Face(slit, 20, 10, 20, { Eyes = "happy", Mouth = "none", Z = 3 })
	kit.Box(head, 2, 10, 52, 5, RED, 0, 3) -- bandeau
	-- étoile en tissu dans la main
	local star = kit.Group(body, 70, 62, 20, 20, 6)
	kit.Diamond(star, 10, 10, 11, STEEL, 0, 1)
	kit.Box(star, 1, 8.5, 18, 3, STEEL, 0, 1)
	kit.Box(star, 8.5, 1, 3, 18, STEEL, 0, 1)
	kit.Circle(star, 10, 10, 4, 4, DARKER, 0, 2)
	kit.Animate(star, "Sway", 12, 1.5, 0)
	kit.Sparkle(body, 86, 22, 9, C.Butter, 0, 7)
	return nil
end

----------------------------------------------------------------------
-- 🖼️ Affiches, aquarium
----------------------------------------------------------------------

-- Affiche de super-héros (héros maison "éclair", cape, ville au loin)
Art.HeroPoster = function(body, kit, _item)
	local C = kit.C
	local poster = kit.Part(body, 12, 4, 76, 92, WHITE, { Radius = 3, Z = 1 })
	local art = kit.Group(poster, 4, 4, 68, 84, 2, true)
	local sky = kit.Box(art, 0, 0, 68, 84, WHITE, 0, 1)
	kit.Gradient(sky, rgb(90, 130, 240), rgb(255, 180, 120), 90)
	for index = 0, 4 do
		kit.Box(art, index * 14, 58 - (index % 3) * 8, 12, 40, rgb(60, 70, 130), 0.1, 2) -- ville
	end
	kit.Circle(art, 52, 18, 16, 16, C.Butter, 0.2, 2)
	-- cape qui flotte
	local cape = kit.Pivot(art, 34, 34, 3)
	kit.Part(cape, -18, 0, 36, 34, RED, { Radius = 10, Z = 1 })
	kit.Animate(cape, "Sway", 4, 1.6, 0)
	-- héros
	local suit = kit.Part(art, 22, 34, 24, 26, BLUE, { Radius = 8, Z = 4, Shine = true })
	bolt(kit, suit, 7, 4, 16, C.Butter, 3)
	kit.Part(art, 10, 34, 12, 7, BLUE, { Radius = 3, Z = 4, Rotation = -40 }) -- bras levé
	kit.Blob(art, 10, 30, 8, 8, RED, { Z = 5 }) -- poing
	local head = kit.Blob(art, 34, 26, 20, 18, rgb(255, 220, 196), { Z = 5, Shine = true })
	kit.Part(head, 1, 5, 18, 5, RED, { Radius = 2, Z = 2, Outline = false }) -- masque
	kit.Face(head, 10, 9, 12, { Eyes = "dot", Mouth = "smile", Blush = false, Z = 3 })
	kit.Text(art, "HERO!", 34, 74, 14, C.Butter, 6).TextStrokeTransparency = 0
	return { WallShadow = Vector2.new(76, 92) }
end

-- Affiche de BD "POW!" (explosion, points de trame, traits de vitesse)
Art.ComicPoster = function(body, kit, _item)
	local C = kit.C
	local poster = kit.Part(body, 8, 6, 84, 88, rgb(80, 200, 255), { Radius = 3, Z = 1, Shine = true })
	for row = 0, 7 do
		for col = 0, 7 do
			kit.Circle(poster, 6 + col * 10.5, 6 + row * 10.5, 3, 3, WHITE, 0.55, 2) -- trame
		end
	end
	-- explosion (carrés tournés)
	local burst = kit.Group(body, 14, 16, 72, 66, 3)
	for index = 0, 5 do
		local ray = kit.Box(burst, 6, 26, 60, 16, C.Butter, 0, 1)
		ray.Rotation = index * 30
		kit.Stroke(ray, RED, 2, 0)
	end
	kit.Blob(burst, 36, 34, 52, 40, C.Butter, { Z = 2, Outline = RED, Thickness = 2 })
	local word = kit.Text(burst, "POW!", 36, 34, 22, RED, 3)
	word.TextStrokeColor3 = WHITE
	word.TextStrokeTransparency = 0
	word.Rotation = -8
	kit.Animate(word, "Breathe", 0.06, 2, 0)
	for index = 0, 2 do
		kit.Line(body, 12, 80 + index * 4, 30 - index * 4, 80 + index * 4, 2, WHITE, 0.2, 4)
	end
	return { WallShadow = Vector2.new(84, 88) }
end

-- Grand aquarium à requins (deux requins mignons, corail, coffre, bulles)
Art.SharkTank = function(body, kit, _item)
	local C = kit.C
	kit.Part(body, 4, 76, 92, 22, DARK, { Radius = 5, Z = 1, Shine = true })
	for index = 0, 1 do
		kit.Part(body, 8 + index * 44, 80, 40, 14, NAVY, { Radius = 3, Z = 2 })
	end
	local tank = kit.Part(body, 2, 8, 96, 70, rgb(120, 200, 245), { Radius = 6, Z = 3, Outline = STEEL, Thickness = 2.5 })
	kit.Gradient(tank, rgb(150, 225, 255), rgb(40, 110, 200), 90)
	local water = kit.Group(tank, 3, 3, 90, 64, 2, true)
	kit.Box(water, 0, 54, 90, 10, rgb(240, 214, 170), 0, 1) -- sable
	for index, x in ipairs({ 10, 18, 78 }) do
		kit.Part(water, x, 34 + index * 3, 5, 24, index == 3 and rgb(255, 150, 120) or rgb(110, 200, 120), { Radius = 3, Z = 1, Outline = false })
	end
	local chest = kit.Part(water, 60, 46, 16, 10, rgb(170, 110, 70), { Radius = 3, Z = 2 })
	kit.Box(chest, 0, 3, 16, 2, C.Gold, 0, 2)
	-- requins (corps gris-bleu, ventre blanc, aileron)
	local function shark(x, y, scale, phase)
		local g = kit.Group(water, x, y, 40 * scale, 20 * scale, 4)
		local s = kit.Blob(g, 20 * scale, 10 * scale, 34 * scale, 14 * scale, rgb(130, 150, 190), { Z = 2, Shine = true })
		kit.Blob(s, 16 * scale, 10 * scale, 24 * scale, 6 * scale, WHITE, { Z = 1, Outline = false, Shade = false })
		kit.Triangle(g, 20 * scale, 0, 10 * scale, 7 * scale, rgb(130, 150, 190), 1)
		kit.Triangle(g, 2 * scale, 4 * scale, 10 * scale, 12 * scale, rgb(130, 150, 190), 1)
		kit.Face(s, 26 * scale, 6 * scale, 10 * scale, { Eyes = "happy", Mouth = "cat", Z = 3 })
		kit.Animate(g, "Drift", 12, 0.6, phase)
		return g
	end
	shark(16, 8, 1, 0)
	shark(40, 30, 0.8, 2)
	bubbles(kit, water, { { 80, 14, 5 }, { 84, 26, 3 }, { 8, 20, 4 } }, 5)
	-- couvercle + lampe
	kit.Part(body, 0, 4, 100, 7, DARK, { Radius = 3, Z = 4 })
	local lamp = kit.Box(body, 20, 10, 60, 2, CYAN, 0.2, 5)
	kit.Animate(lamp, "Pulse", 0.4, 1, 0)
	return { Glow = rgb(120, 210, 255) }
end

----------------------------------------------------------------------
-- 💡 Lumières
----------------------------------------------------------------------

-- Enseigne néon éclair (jaune) sur panneau sombre
Art.LightningNeon = function(body, kit, _item)
	local C = kit.C
	local halo = kit.Part(body, 10, 6, 80, 88, C.Butter, { Radius = 18, Z = 1, Outline = false, Shade = false, T = 0.75 })
	kit.Animate(halo, "Pulse", 0.2, 1.1, 0)
	local board = kit.Part(body, 14, 10, 72, 80, DARKER, { Radius = 14, Z = 2 })
	kit.Stroke(board, CYAN, 2, 0.3)
	local glow = bolt(kit, board, 16, 8, 64, rgb(255, 240, 150), 2, 12)
	local _ = glow
	local core = bolt(kit, board, 16, 8, 64, WHITE, 3, 5)
	kit.Animate(core, "Pulse", 0.5, 3, 0)
	return { Glow = C.Butter, WallShadow = Vector2.new(72, 80) }
end

-- Lampe œuf de dino (coquille fêlée qui brille, bébé dino qui regarde)
Art.DinoEggLamp = function(body, kit, _item)
	local C = kit.C
	kit.Blob(body, 50, 94, 58, 12, rgb(170, 120, 86), { Z = 1, Shine = true }) -- nid
	local glow = kit.Blob(body, 50, 56, 70, 78, C.Butter, { Z = 1, Outline = false, Shade = false, T = 0.7 })
	kit.Animate(glow, "Pulse", 0.2, 1.2, 0)
	local egg = kit.Blob(body, 50, 60, 50, 66, rgb(250, 244, 220), { Z = 2, Shine = true })
	for _, spot in ipairs({ { 12, 20, 8 }, { 34, 44, 10 }, { 16, 50, 6 } }) do
		kit.Circle(egg, spot[1], spot[2], spot[3], spot[3], DINO, 0.3, 2)
	end
	-- fêlure en zigzag + lumière
	for index = 0, 4 do
		kit.Line(egg, 4 + index * 9, 20 + (index % 2) * 6, 13 + index * 9, 20 + ((index + 1) % 2) * 6, 2, C.Gold, 0, 3)
	end
	-- bébé dino qui sort la tête
	local head = kit.Blob(body, 50, 30, 30, 24, DINO, { Z = 3, Shine = true })
	kit.Face(head, 15, 12, 18, { Eyes = "big", Mouth = "smile", Z = 3 })
	kit.Animate(head, "Bob", 1.5, 1, 0)
	return { Glow = rgb(255, 230, 150) }
end

-- Lampe à lave en forme de fusée (bulles de lave qui montent et descendent)
Art.RocketLavaLamp = function(body, kit, _item)
	local C = kit.C
	for _, side in ipairs({ -1, 1 }) do
		kit.Part(body, 50 + side * 20 - 7, 72, 14, 24, RED, { Radius = 4, Z = 1, Rotation = side * 18 })
	end
	kit.Part(body, 32, 80, 36, 18, CHROME, { Radius = 6, Z = 3, Shine = true })
	local glass = kit.Part(body, 34, 22, 32, 60, rgb(110, 60, 160), { Radius = 16, Z = 2 })
	kit.Gradient(glass, rgb(160, 100, 220), rgb(60, 30, 110), 90)
	for index, b in ipairs({ { 14, 44, 12 }, { 20, 26, 9 }, { 10, 14, 7 } }) do
		local blob = kit.Blob(glass, b[1], b[2], b[3], b[3] * 1.2, LAVA, { Z = 2, Outline = false })
		kit.Animate(blob, "Bob", 6, 0.6, index * 1.4)
	end
	kit.Shine(glass, 5, 6, 5, 30, 4, 0.5)
	kit.Triangle(body, 50, 4, 30, 20, CHROME, 3) -- nez
	local window = kit.Blob(body, 50, 36, 12, 12, CYAN, { Z = 4, Outline = CHROME, Thickness = 2 })
	local _ = window
	kit.Sparkle(body, 82, 20, 9, C.Butter, 0, 6)
	return { Glow = LAVA }
end

----------------------------------------------------------------------
-- 🚀 Aventure
----------------------------------------------------------------------

-- Parchemin ninja (rouleau suspendu : lune, bambou, chat ninja, étoile)
Art.NinjaBanner = function(body, kit, _item)
	local C = kit.C
	kit.Line(body, 30, 4, 50, -4, 1.5, DARK, 0, 1)
	kit.Line(body, 70, 4, 50, -4, 1.5, DARK, 0, 1)
	local scroll = kit.Part(body, 22, 6, 56, 86, rgb(250, 240, 214), { Radius = 2, Z = 2, Shine = true })
	kit.Part(body, 16, 2, 68, 7, rgb(150, 96, 60), { Radius = 3, Z = 3 })
	kit.Part(body, 16, 90, 68, 7, rgb(150, 96, 60), { Radius = 3, Z = 3 })
	kit.Circle(scroll, 36, 22, 22, 22, RED, 0, 2) -- soleil rouge
	for index = 0, 2 do
		kit.Part(scroll, 6 + index * 4, 34 + index * 6, 3, 48, rgb(110, 170, 110), { Radius = 1, Z = 3, Outline = false })
	end
	-- chat ninja
	local cat = kit.Blob(scroll, 32, 62, 28, 24, DARK, { Z = 4 })
	for _, side in ipairs({ -1, 1 }) do
		kit.Part(scroll, 32 + side * 9 - 4, 46, 8, 8, DARK, { Radius = 2, Z = 3, Rotation = 45 })
	end
	local mask = kit.Part(cat, 4, 6, 20, 8, rgb(255, 230, 210), { Radius = 4, Z = 2, Outline = false })
	kit.Face(mask, 10, 5, 14, { Eyes = "happy", Mouth = "none", Blush = false, Z = 3 })
	kit.Box(cat, 0, 3, 28, 3, RED, 0, 3)
	local star = kit.Group(scroll, 38, 72, 14, 14, 5)
	kit.Diamond(star, 7, 7, 8, STEEL, 0, 1)
	kit.Box(star, 0, 6, 14, 2, STEEL, 0, 1)
	kit.Box(star, 6, 0, 2, 14, STEEL, 0, 1)
	kit.Animate(star, "Spin", 1, 0.5, 0)
	kit.Sparkle(body, 86, 60, 8, C.Butter, 0, 4)
	return { WallShadow = Vector2.new(60, 90) }
end

-- Maquette de volcan (lave qui coule, fumée qui monte)
Art.VolcanoModel = function(body, kit, _item)
	local C = kit.C
	kit.Part(body, 4, 88, 92, 10, rgb(110, 190, 110), { Radius = 4, Z = 1, Shine = true })
	local mountain = kit.Triangle(body, 50, 30, 84, 62, rgb(150, 100, 80), 2)
	local _ = mountain
	kit.Triangle(body, 50, 30, 60, 44, rgb(170, 118, 92), 3)
	kit.Blob(body, 50, 32, 22, 8, DARKER, { Z = 4 })
	-- lave
	kit.Blob(body, 50, 34, 18, 8, LAVA, { Z = 5 })
	kit.Line(body, 46, 36, 36, 60, 5, LAVA, 0, 5)
	kit.Line(body, 54, 36, 62, 70, 5, ORANGE, 0, 5)
	kit.Line(body, 36, 60, 30, 78, 4, LAVA, 0, 5)
	-- fumée
	for index = 0, 2 do
		local puff = kit.Blob(body, 44 + index * 8, 18 - index * 7, 16 - index * 2, 14 - index * 2, rgb(220, 220, 230), { Z = 6, Outline = false })
		kit.Animate(puff, "Bob", 3, 1, index)
	end
	-- petit panneau "science"
	local sign = kit.Part(body, 72, 70, 20, 12, WHITE, { Radius = 2, Z = 6 })
	kit.Text(sign, "!", 10, 6, 10, RED, 2)
	kit.Line(body, 82, 82, 82, 90, 2, rgb(150, 96, 60), 0, 5)
	local _c = C
	return { Glow = LAVA }
end

-- Mobile du système solaire (soleil, planètes qui se balancent)
Art.PlanetMobile = function(body, kit, _item)
	local C = kit.C
	kit.Line(body, 50, 0, 50, 14, 1.5, DARK, 0, 1)
	kit.Part(body, 8, 12, 84, 4, rgb(170, 120, 86), { Radius = 2, Z = 2 })
	local specs = {
		{ 12, 40, 12, rgb(255, 180, 120) },
		{ 30, 58, 16, rgb(100, 170, 255) },
		{ 70, 54, 18, rgb(255, 120, 110) },
		{ 88, 38, 12, rgb(170, 140, 255) },
	}
	for index, p in ipairs(specs) do
		local swing = kit.Pivot(body, p[1], 14, 3)
		kit.Line(swing, 0, 0, 0, p[2] - 14, 1, DARK, 0.2, 1)
		local planet = kit.Blob(swing, 0, p[2] - 14, p[3], p[3], p[4], { Z = 2, Shine = true })
		if index == 3 then
			local ring = kit.Box(swing, -p[3] * 0.9, p[2] - 15, p[3] * 1.8, 3, C.Butter, 0, 3)
			ring.Rotation = -18
			kit.Round(ring)
		end
		local _ = planet
		kit.Animate(swing, "Sway", 6, 0.8, index)
	end
	-- soleil au centre
	local sunSwing = kit.Pivot(body, 50, 14, 4)
	kit.Line(sunSwing, 0, 0, 0, 26, 1, DARK, 0.2, 1)
	local sun = kit.Blob(sunSwing, 0, 44, 30, 30, C.Butter, { Z = 2, Shine = true })
	kit.Face(sun, 15, 16, 18, { Eyes = "happy", Mouth = "smile", Z = 3 })
	kit.Animate(sunSwing, "Sway", 3, 0.6, 0)
	return { WallShadow = Vector2.new(0, 0) }
end

-- Maquette de bateau pirate (voiles, drapeau à tête de mort mignonne)
Art.PirateShip = function(body, kit, _item)
	local C = kit.C
	kit.Part(body, 30, 88, 40, 10, rgb(150, 96, 60), { Radius = 3, Z = 1, Shine = true })
	kit.Part(body, 46, 76, 8, 14, rgb(120, 80, 50), { Radius = 2, Z = 1 })
	local ship = kit.Group(body, 0, 0, 100, 100, 2)
	kit.Animate(ship, "Sway", 3, 0.9, 0)
	local sail = rgb(250, 244, 228)
	-- mâts
	kit.Part(ship, 49, 10, 4, 62, rgb(120, 80, 50), { Radius = 2, Z = 1 })
	kit.Part(ship, 24, 30, 3, 42, rgb(120, 80, 50), { Radius = 2, Z = 1 })
	-- voiles gonflées (rayées de rouge) + foc triangulaire
	local top = kit.Part(ship, 36, 16, 30, 20, sail, { Radius = 9, Z = 2, Shine = true })
	kit.Box(top, 0, 8, 30, 4, RED, 0.1, 2)
	local main = kit.Part(ship, 30, 38, 42, 26, sail, { Radius = 12, Z = 2, Shine = true })
	kit.Box(main, 0, 8, 42, 4, RED, 0.1, 2)
	kit.Box(main, 0, 16, 42, 4, RED, 0.1, 2)
	local back = kit.Part(ship, 12, 38, 24, 22, sail, { Radius = 9, Z = 2 })
	kit.Box(back, 0, 9, 24, 4, RED, 0.1, 2)
	kit.Triangle(ship, 84, 30, 22, 34, sail, 2)
	kit.Line(ship, 51, 14, 92, 62, 1, rgb(120, 80, 50), 0.2, 1)
	-- drapeau pirate (tête de mort mignonne) en haut du grand mât
	local flag = kit.Part(ship, 53, 6, 20, 13, DARKER, { Radius = 2, Z = 3 })
	local skull = kit.Blob(flag, 10, 5.5, 8, 7, WHITE, { Z = 2, Outline = false })
	kit.Circle(skull, 2.5, 3, 2, 2, DARKER, 0, 2)
	kit.Circle(skull, 5.5, 3, 2, 2, DARKER, 0, 2)
	kit.Line(flag, 5, 10, 15, 12, 1.2, WHITE, 0, 2)
	kit.Line(flag, 15, 10, 5, 12, 1.2, WHITE, 0, 2)
	-- coque (proue relevée)
	kit.Triangle(ship, 90, 58, 14, 14, rgb(150, 96, 60), 3)
	local hull = kit.Part(ship, 6, 62, 86, 18, rgb(150, 96, 60), { Radius = 9, Z = 4, Shine = true })
	kit.Box(hull, 4, 4, 78, 3, C.Gold, 0, 2)
	for index = 0, 3 do
		kit.Circle(hull, 18 + index * 16, 11, 5, 5, DARKER, 0, 2) -- hublots
	end
	kit.Part(ship, 2, 56, 18, 10, rgb(150, 96, 60), { Radius = 3, Z = 3 }) -- château arrière
	return nil
end

-- Coffre au trésor ouvert (pièces d'or, gemmes, étincelles)
Art.PirateChest = function(body, kit, _item)
	local C = kit.C
	local wood = rgb(170, 110, 70)
	-- couvercle ouvert (derrière)
	local lid = kit.Part(body, 10, 18, 80, 28, wood, { Radius = 14, Z = 1, Shine = true })
	kit.Box(lid, 36, 0, 8, 28, C.Gold, 0, 2)
	-- trésor
	for index = 0, 6 do
		local coin = kit.Blob(body, 18 + index * 11, 48 - (index % 3) * 4, 14, 12, C.Gold, { Z = 2, Shine = true })
		kit.Text(coin, "$", 7, 6, 7, rgb(180, 130, 40), 2)
	end
	kit.Diamond(body, 36, 40, 10, RED, 0, 3)
	kit.Diamond(body, 62, 38, 9, CYAN, 0, 3)
	kit.Blob(body, 50, 34, 12, 12, rgb(160, 255, 170), { Z = 3, Shine = true })
	-- caisse
	local chest = kit.Part(body, 8, 50, 84, 46, wood, { Radius = 8, Z = 4, Shine = true })
	for _, x in ipairs({ 8, 68 }) do
		kit.Box(chest, x, 0, 8, 46, C.Gold, 0, 2)
	end
	kit.Box(chest, 0, 18, 84, 4, kit.Darken(wood, 0.25), 0, 2)
	local lock = kit.Part(chest, 34, 8, 16, 16, C.Gold, { Radius = 4, Z = 3, Shine = true })
	kit.Circle(lock, 8, 7, 4, 4, DARKER, 0, 2)
	kit.Box(lock, 7, 8, 2, 5, DARKER, 0, 2)
	for index, p in ipairs({ { 20, 22 }, { 80, 26 }, { 52, 14 } }) do
		local s = kit.Sparkle(body, p[1], p[2], 10, C.Butter, 0, 6)
		kit.Animate(s, "Pulse", 0.7, 1.5, index)
	end
	return { Glow = C.Butter }
end

-- Maquette de fusée sur sa tour de lancement (fumée au décollage)
Art.RocketModel = function(body, kit, _item)
	local C = kit.C
	-- tour de lancement
	kit.Part(body, 72, 12, 8, 80, RED, { Radius = 2, Z = 1 })
	for index = 0, 5 do
		kit.Line(body, 72, 16 + index * 12, 80, 26 + index * 12, 1.5, kit.Darken(RED, 0.3), 0, 2)
	end
	kit.Part(body, 58, 36, 16, 4, STEEL, { Radius = 2, Z = 2 })
	kit.Part(body, 10, 88, 80, 10, STEEL, { Radius = 4, Z = 1, Shine = true })
	-- fumée
	for index, p in ipairs({ { 30, 88, 20 }, { 54, 90, 18 }, { 42, 94, 24 } }) do
		local puff = kit.Blob(body, p[1], p[2], p[3], p[3] * 0.7, WHITE, { Z = 5, Outline = rgb(220, 220, 232) })
		kit.Animate(puff, "Breathe", 0.08, 2, index)
	end
	-- fusée
	for _, side in ipairs({ -1, 1 }) do
		kit.Part(body, 42 + side * 14 - 6, 64, 12, 22, RED, { Radius = 4, Z = 2, Rotation = side * 16 })
	end
	local rocket = kit.Part(body, 32, 20, 24, 64, WHITE, { Radius = 12, Z = 3, Shine = true })
	kit.Box(rocket, 0, 40, 24, 5, RED, 0, 2)
	local window = kit.Blob(rocket, 12, 20, 12, 12, CYAN, { Z = 3, Outline = STEEL, Thickness = 2 })
	kit.Shine(window, 2, 2, 4, 3, 2, 0.3)
	kit.Triangle(body, 44, 4, 22, 22, RED, 4)
	local flame = kit.Blob(body, 44, 88, 10, 12, ORANGE, { Z = 4, Outline = false })
	kit.Animate(flame, "Flicker", 0.4, 1, 0)
	kit.Sparkle(body, 16, 20, 10, C.Butter, 0, 6)
	return nil
end

-- Télescope d'observatoire (gros tube blanc, pied, chercheur, cadrans)
Art.Observatory = function(body, kit, _item)
	local C = kit.C
	kit.Part(body, 26, 86, 48, 12, DARK, { Radius = 5, Z = 1, Shine = true })
	kit.Part(body, 44, 50, 12, 40, STEEL, { Radius = 4, Z = 2, Shine = true })
	kit.Blob(body, 50, 50, 22, 22, DARK, { Z = 3 })
	local tube = kit.Part(body, 6, 26, 84, 26, WHITE, { Radius = 12, Z = 4, Shine = true, Rotation = -28 })
	kit.Box(tube, 22, 0, 6, 26, NAVY, 0, 2)
	kit.Box(tube, 60, 0, 6, 26, NAVY, 0, 2)
	kit.Part(body, 78, 0, 18, 32, DARK, { Radius = 6, Z = 5, Rotation = -28 }) -- pare-soleil
	kit.Part(body, 22, 16, 30, 7, STEEL, { Radius = 3, Z = 5, Rotation = -28 }) -- chercheur
	local dial = kit.Circle(body, 50, 50, 10, 10, C.Gold, 0, 6)
	kit.Box(dial, 4.4, 1, 1.2, 4, DARKER, 0, 2)
	for index, p in ipairs({ { 14, 8 }, { 88, 46 }, { 30, 70 } }) do
		local s = kit.Sparkle(body, p[1], p[2], 10, index == 2 and CYAN or C.Butter, 0, 7)
		kit.Animate(s, "Pulse", 0.7, 1, index)
	end
	return nil
end

-- Statue d'astronaute sur un rocher lunaire (salue, drapeau étoile)
Art.AstronautStatue = function(body, kit, _item)
	local C = kit.C
	kit.Blob(body, 50, 90, 92, 20, rgb(200, 196, 220), { Z = 1, Shine = true })
	kit.Circle(body, 30, 90, 12, 5, rgb(170, 166, 196), 0, 2)
	-- drapeau
	kit.Line(body, 84, 84, 84, 26, 2, STEEL, 0, 2)
	local flag = kit.Part(body, 84, 26, 16, 12, BLUE, { Radius = 2, Z = 2 })
	kit.Sparkle(flag, 8, 6, 8, WHITE, 0, 2)
	kit.Animate(flag, "Sway", 3, 1.5, 0)
	-- sac à dos, corps, jambes
	kit.Part(body, 28, 42, 44, 34, CHROME, { Radius = 8, Z = 3 })
	local suit = kit.Part(body, 32, 44, 36, 36, WHITE, { Radius = 12, Z = 4, Shine = true })
	local panel = kit.Part(suit, 10, 10, 16, 10, NAVY, { Radius = 3, Z = 2 })
	for index, color in ipairs({ RED, C.Butter, CYAN }) do
		kit.Circle(panel, 3 + (index - 1) * 5, 5, 3, 3, color, 0, 2)
	end
	for _, x in ipairs({ 36, 52 }) do
		kit.Part(body, x, 74, 12, 16, WHITE, { Radius = 5, Z = 3 })
		kit.Part(body, x - 1, 86, 14, 6, STEEL, { Radius = 3, Z = 4 })
	end
	-- bras qui salue
	local arm = kit.Pivot(body, 66, 50, 5)
	kit.Part(arm, 0, -22, 10, 24, WHITE, { Radius = 5, Z = 1 })
	kit.Blob(arm, 5, -24, 12, 12, STEEL, { Z = 2 })
	kit.Animate(arm, "Sway", 12, 1.6, 0)
	kit.Part(body, 22, 50, 12, 22, WHITE, { Radius = 5, Z = 3, Rotation = 12 })
	-- casque
	local helmet = kit.Blob(body, 50, 30, 40, 36, WHITE, { Z = 6, Shine = true })
	local visor = kit.Part(helmet, 6, 8, 28, 20, rgb(40, 50, 100), { Radius = 10, Z = 2 })
	kit.Gradient(visor, rgb(90, 120, 220), rgb(30, 30, 80), 90)
	kit.Face(visor, 14, 11, 16, { Eyes = "happy", Mouth = "smile", Color = WHITE, Blush = false, Z = 3 })
	kit.Shine(visor, 3, 2, 8, 4, 4, 0.4)
	return nil
end

-- Squelette de T-rex (musée : os crème sur un socle avec plaque)
Art.DinoSkeleton = function(body, kit, _item)
	local C = kit.C
	kit.Part(body, 4, 88, 92, 10, DARK, { Radius = 4, Z = 1, Shine = true })
	local plaque = kit.Part(body, 38, 90, 24, 6, C.Gold, { Radius = 2, Z = 2 })
	local _ = plaque
	-- supports
	kit.Line(body, 40, 88, 42, 56, 2, STEEL, 0, 1)
	kit.Line(body, 70, 88, 64, 50, 2, STEEL, 0, 1)
	-- colonne vertébrale (queue -> cou)
	local spine = { { 4, 70 }, { 16, 62 }, { 28, 56 }, { 40, 52 }, { 52, 50 }, { 62, 46 }, { 70, 38 }, { 74, 30 } }
	for index = 1, #spine - 1 do
		kit.Line(body, spine[index][1], spine[index][2], spine[index + 1][1], spine[index + 1][2], 3, BONE, 0, 3)
		kit.Blob(body, spine[index][1], spine[index][2], 7, 6, BONE, { Z = 4, Thickness = 1.1 })
	end
	-- côtes
	for index = 0, 3 do
		local x = 44 + index * 6
		kit.Blob(body, x, 62, 6, 22 - index * 2, BONE, { Z = 2, T = 1, Outline = BONE, Thickness = 2.2, Shade = false })
	end
	-- pattes
	kit.Line(body, 46, 58, 40, 76, 4, BONE, 0, 3)
	kit.Line(body, 40, 76, 44, 88, 3.5, BONE, 0, 3)
	kit.Line(body, 58, 56, 60, 76, 4, BONE, 0, 3)
	kit.Line(body, 60, 76, 56, 88, 3.5, BONE, 0, 3)
	kit.Line(body, 68, 44, 74, 52, 2, BONE, 0, 3) -- petit bras
	kit.Line(body, 74, 30, 72, 26, 3, BONE, 0, 3) -- cou
	-- crâne
	local skull = kit.Part(body, 64, 12, 34, 20, BONE, { Radius = 8, Z = 5, Shine = true })
	kit.Circle(skull, 12, 8, 7, 7, DARK, 0, 2)
	kit.Part(skull, 10, 14, 24, 5, DARK, { Radius = 2, Z = 2, Outline = false })
	for index = 0, 3 do
		kit.TriangleDown(skull, 14 + index * 5, 14, 3.5, 4, WHITE, 3)
	end
	local jaw = kit.Part(body, 68, 32, 28, 6, BONE, { Radius = 3, Z = 5 })
	kit.Animate(jaw, "Bob", 1, 1.4, 0)
	return nil
end

-- Robot géant (mech bleu et blanc, visière lumineuse, cœur d'énergie)
Art.MechRobot = function(body, kit, _item)
	local C = kit.C
	local white = rgb(240, 244, 252)
	-- jambes
	for _, x in ipairs({ 30, 56 }) do
		kit.Part(body, x, 64, 14, 26, STEEL, { Radius = 4, Z = 1 })
		kit.Part(body, x - 4, 86, 22, 12, BLUE, { Radius = 5, Z = 2, Shine = true })
	end
	-- bras
	for index, side in ipairs({ -1, 1 }) do
		local arm = kit.Pivot(body, 50 + side * 30, 36, 3)
		kit.Part(arm, -8, 0, 16, 34, white, { Radius = 7, Z = 1, Shine = true })
		kit.Blob(arm, 0, 38, 18, 16, BLUE, { Z = 2 })
		kit.Animate(arm, "Sway", 5, 1, index * 1.5)
		kit.Blob(body, 50 + side * 30, 36, 20, 20, BLUE, { Z = 4, Shine = true }) -- épaule
	end
	-- torse + cœur d'énergie
	local torso = kit.Part(body, 26, 30, 48, 40, white, { Radius = 10, Z = 5, Shine = true })
	kit.Box(torso, 0, 30, 48, 4, BLUE, 0, 2)
	local core = kit.Circle(torso, 24, 16, 16, 16, CYAN, 0, 3)
	kit.Stroke(core, BLUE, 2, 0)
	kit.Animate(core, "Pulse", 0.5, 1.6, 0)
	kit.Circle(torso, 24, 16, 7, 7, WHITE, 0.1, 4)
	-- tête + visière + antenne
	kit.Line(body, 50, 12, 50, 2, 2, STEEL, 0, 5)
	local tip = kit.Circle(body, 50, 2, 6, 6, RED, 0, 6)
	kit.Animate(tip, "Pulse", 0.6, 2, 0)
	local head = kit.Part(body, 34, 8, 32, 24, white, { Radius = 8, Z = 6, Shine = true })
	local visor = kit.Part(head, 4, 7, 24, 10, DARKER, { Radius = 5, Z = 2 })
	for _, x in ipairs({ 7, 17 }) do
		local eye = kit.Box(visor, x - 3, 3, 6, 4, CYAN, 0, 2)
		kit.Round(eye, 2)
		kit.Animate(eye, "Pulse", 0.4, 1.2, x)
	end
	kit.Sparkle(body, 12, 16, 10, C.Butter, 0, 7)
	return { Glow = CYAN }
end

return Art
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="14">
              <Properties>
                <string name="Name">Cool92Gaming</string>
                <string name="Source"><![CDATA[--[[
	Cool92Gaming (ModuleScript) — (v9.2) coin gamer 🎮 + meubles "cool"
	(chaise de course, bureau gamer, pouf, casier, table de briques, lits
	superposés, lit voiture de course)
	Emplacement : ReplicatedStorage > Client > Components > House > Art > Cool92Gaming
	Contrat : voir HouseArt (boîte 100 x 100, pieds en bas pour les objets au sol).

	Style : même rendu "autocollant" que le reste (contours doux, reflets),
	mais en couleurs de gamer : bleu nuit, néons cyan / magenta / vert,
	rouge course. Les dessus des tables, sièges et lits sont déclarés dans
	House/HouseSurfaces (mêmes coordonnées).
]]

local Art = {}

local rgb = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)
local NAVY = rgb(52, 60, 100)
local DARK = rgb(44, 46, 64)
local DARKER = rgb(30, 32, 46)
local CYAN = rgb(60, 222, 255)
local MAGENTA = rgb(255, 84, 196)
local LIME = rgb(140, 240, 110)
local RED = rgb(236, 66, 76)
local ORANGE = rgb(255, 152, 56)
local STEEL = rgb(176, 186, 206)
local SCREEN = rgb(36, 40, 78)

----------------------------------------------------------------------
-- Petits outils
----------------------------------------------------------------------

-- Manette (vue de face) centrée en (cx, cy), largeur w
local function controller(kit, parent, cx, cy, w, color, z)
	local C = kit.C
	local zz = z or 3
	for _, side in ipairs({ -1, 1 }) do
		kit.Blob(parent, cx + side * w * 0.3, cy + w * 0.14, w * 0.34, w * 0.4, color, { Z = zz, Thickness = 1.2 })
	end
	local pad = kit.Part(parent, cx - w / 2, cy - w * 0.2, w, w * 0.38, color, { Radius = math.floor(w * 0.16), Z = zz + 1, Shine = true, Thickness = 1.3 })
	-- croix directionnelle
	local s = w * 0.06
	kit.Box(pad, w * 0.2 - s * 1.5, w * 0.19 - s / 2, s * 3, s, WHITE, 0.1, 3)
	kit.Box(pad, w * 0.2 - s / 2, w * 0.19 - s * 1.5, s, s * 3, WHITE, 0.1, 3)
	-- boutons
	for index, spec in ipairs({ { 0.8, 0.1, C.Butter }, { 0.88, 0.19, RED }, { 0.72, 0.19, CYAN }, { 0.8, 0.28, LIME } }) do
		kit.Circle(pad, w * spec[1], w * spec[2], s * 1.3, s * 1.3, spec[3], 0, 3)
		local _ = index
	end
	-- sticks
	kit.Circle(pad, w * 0.38, w * 0.27, s * 1.7, s * 1.7, DARKER, 0, 3)
	kit.Circle(pad, w * 0.62, w * 0.27, s * 1.7, s * 1.7, DARKER, 0, 3)
	return pad
end

-- Bande de LED qui respire (cyan -> magenta), ancrée en (x, y)
local function ledStrip(kit, parent, x, y, w, h, z)
	local strip = kit.Box(parent, x, y, w, h, WHITE, 0, z)
	kit.Round(strip)
	kit.Gradient(strip, CYAN, MAGENTA, 0)
	local glow = kit.Box(parent, x - 2, y - 2, w + 4, h + 4, CYAN, 0.7, (z or 2) - 1)
	kit.Round(glow)
	kit.Animate(glow, "Pulse", 0.25, 1.4, x)
	return strip
end

-- Ventilateur RGB (anneau lumineux + pales qui tournent)
local function fan(kit, parent, cx, cy, size, color, z, phase)
	local ring = kit.Circle(parent, cx, cy, size, size, DARKER, 0, z)
	kit.Stroke(ring, color, 2, 0)
	local halo = kit.Circle(parent, cx, cy, size + 4, size + 4, color, 0.75, z - 1)
	kit.Animate(halo, "Pulse", 0.2, 1.2, phase or 0)
	local rotor = kit.Pivot(ring, size / 2, size / 2, 2)
	for index = 0, 2 do
		-- une pale par pivot tourné (les enfants tournent autour du pivot)
		local arm = kit.Pivot(rotor, 0, 0, 1)
		arm.Rotation = index * 120
		local blade = kit.Box(arm, -size * 0.07, -size * 0.42, size * 0.14, size * 0.36, kit.Lighten(color, 0.3), 0.15, 1)
		kit.Round(blade)
	end
	kit.Circle(ring, size / 2, size / 2, size * 0.26, size * 0.26, color, 0, 3)
	kit.Animate(rotor, "Spin", 1, 0.8, phase or 0)
	return ring
end

----------------------------------------------------------------------
-- 🎮 Jeux vidéo
----------------------------------------------------------------------

-- Casque gamer sur son support (oreillettes RGB, micro)
Art.RGBHeadset = function(body, kit, _item)
	kit.Blob(body, 50, 94, 58, 12, DARK, { Z = 1, Shine = true })
	kit.Part(body, 46, 34, 8, 60, STEEL, { Radius = 4, Z = 2, Shine = true })
	kit.Blob(body, 50, 34, 30, 10, STEEL, { Z = 3 })
	-- arceau (moitié haute d'un anneau)
	local clip = kit.Group(body, 14, 8, 72, 40, 4, true)
	local band = kit.Part(clip, 3, 3, 66, 66, DARK, { Radius = -1, T = 1, Outline = DARK, Thickness = 8, Shade = false })
	local _ = band
	local pad = kit.Part(body, 32, 8, 36, 10, NAVY, { Radius = 5, Z = 5, Shine = true })
	kit.Box(pad, 8, 3, 20, 3, CYAN, 0.2, 3)
	-- oreillettes
	for index, side in ipairs({ -1, 1 }) do
		local cx = 50 + side * 34
		local halo = kit.Blob(body, cx, 60, 30, 38, index == 1 and CYAN or MAGENTA, { Z = 5, Outline = false, Shade = false, T = 0.55 })
		kit.Animate(halo, "Pulse", 0.35, 1.6, index * 1.7)
		local cup = kit.Blob(body, cx, 60, 24, 32, DARK, { Z = 6, Shine = true })
		local ring = kit.Blob(cup, 12, 16, 14, 20, DARKER, { Z = 2, Outline = index == 1 and CYAN or MAGENTA, Thickness = 2.5, Shade = false })
		kit.Diamond(ring, 7, 10, 5, index == 1 and CYAN or MAGENTA, 0, 2)
		kit.Line(body, cx, 26, cx, 44, 5, DARK, 0, 4)
	end
	-- micro
	kit.Line(body, 20, 70, 36, 84, 3, DARK, 0, 7)
	kit.Blob(body, 38, 85, 9, 7, DARKER, { Z = 8 })
	local tip = kit.Circle(body, 38, 85, 4, 4, LIME, 0, 9)
	kit.Animate(tip, "Pulse", 0.6, 1.2, 0)
	return { Glow = CYAN }
end

-- Console de salon + deux manettes
Art.ConsoleSet = function(body, kit, _item)
	local C = kit.C
	-- console (boîtier noir, bande lumineuse)
	local console = kit.Part(body, 14, 34, 72, 34, DARK, { Radius = 8, Z = 1, Shine = true })
	kit.Part(console, 4, 4, 64, 10, NAVY, { Radius = 4, Z = 2, Outline = false })
	local light = kit.Box(console, 8, 18, 40, 3, CYAN, 0, 3)
	kit.Round(light)
	kit.Animate(light, "Pulse", 0.5, 1.2, 0)
	kit.Box(console, 52, 18, 10, 3, WHITE, 0.3, 3)
	kit.Circle(console, 62, 26, 6, 6, LIME, 0, 3) -- bouton marche
	for index = 0, 4 do
		kit.Box(console, 8 + index * 6, 26, 3, 4, DARKER, 0, 3) -- aérations
	end
	-- câble
	kit.Line(body, 86, 60, 94, 84, 2, DARKER, 0, 1)
	-- deux manettes posées devant
	local red = controller(kit, body, 30, 82, 38, RED, 4)
	local blue = controller(kit, body, 70, 86, 38, rgb(80, 150, 255), 6)
	blue.Rotation = 8
	red.Rotation = -6
	kit.Sparkle(body, 90, 28, 10, C.Butter, 0, 8)
	return nil
end

-- Enseigne néon "GG" (bon match !) sur panneau sombre
Art.NeonGG = function(body, kit, _item)
	local C = kit.C
	local halo = kit.Part(body, 4, 18, 92, 64, MAGENTA, { Radius = 16, Z = 1, Outline = false, Shade = false, T = 0.72 })
	kit.Animate(halo, "Pulse", 0.2, 1.3, 0)
	local board = kit.Part(body, 8, 22, 84, 56, DARKER, { Radius = 12, Z = 2 })
	kit.Stroke(board, MAGENTA, 2.5, 0.1)
	for index = 0, 1 do
		kit.Circle(board, 8 + index * 68, 8, 4, 4, STEEL, 0, 2) -- vis
	end
	-- néon : lettres claires + halo cyan (copie floue derrière)
	local halo2 = kit.Text(board, "GG", 42, 28, 42, CYAN, 3)
	halo2.TextTransparency = 0.55
	local text = kit.Text(board, "GG", 42, 28, 38, rgb(210, 250, 255), 4)
	text.TextStrokeColor3 = CYAN
	text.TextStrokeTransparency = 0
	kit.Animate(halo2, "Bob", 1, 1.5, 0)
	kit.Animate(text, "Bob", 1, 1.5, 0)
	-- petite manette + étincelles néon
	local pad = controller(kit, body, 50, 76, 22, MAGENTA, 5)
	local _ = pad
	kit.Sparkle(body, 16, 30, 10, C.Butter, 0, 6)
	kit.Sparkle(body, 86, 72, 8, CYAN, 0, 6)
	return { Glow = CYAN, WallShadow = Vector2.new(84, 56) }
end

-- PC gamer : écran avec jeu, tour vitrée à ventilateurs RGB, clavier lumineux
Art.GamerPC = function(body, kit, _item)
	local C = kit.C
	-- tour
	local tower = kit.Part(body, 66, 20, 30, 76, DARK, { Radius = 6, Z = 1, Shine = true })
	local glass = kit.Part(tower, 4, 6, 22, 58, rgb(20, 24, 44), { Radius = 4, Z = 2, Outline = CYAN, Thickness = 1.2 })
	fan(kit, glass, 11, 14, 16, CYAN, 3, 0)
	fan(kit, glass, 11, 34, 16, MAGENTA, 3, 1.3)
	kit.Box(glass, 3, 46, 16, 6, LIME, 0.2, 3) -- carte graphique
	kit.Shine(glass, 2, 2, 4, 30, 5, 0.6)
	kit.Circle(tower, 15, 70, 5, 5, LIME, 0, 3)
	-- écran
	kit.Part(body, 34, 58, 8, 22, STEEL, { Radius = 3, Z = 2 })
	kit.Blob(body, 38, 84, 30, 8, STEEL, { Z = 3 })
	local monitor = kit.Part(body, 2, 14, 64, 46, DARKER, { Radius = 6, Z = 4 })
	local screen = kit.Part(monitor, 4, 4, 56, 36, SCREEN, { Radius = 4, Z = 2, Outline = false })
	kit.Gradient(screen, rgb(120, 170, 255), rgb(255, 150, 200), 90)
	-- jeu : montagnes, héros, pièce
	kit.Triangle(screen, 16, 16, 26, 20, rgb(90, 90, 170), 2)
	kit.Triangle(screen, 38, 12, 30, 24, rgb(110, 100, 190), 2)
	kit.Box(screen, 0, 30, 56, 6, LIME, 0, 3)
	local hero = kit.Part(screen, 22, 20, 8, 10, RED, { Radius = 3, Z = 4, Thickness = 1 })
	kit.Animate(hero, "Bob", 2, 2, 0)
	local coin = kit.Circle(screen, 40, 14, 6, 6, C.Butter, 0, 4)
	kit.Animate(coin, "Bob", 1.5, 2.5, 1)
	kit.Text(screen, "x99", 10, 6, 7, WHITE, 5)
	-- clavier lumineux + souris
	ledStrip(kit, body, 6, 94, 56, 2, 5)
	local keyboard = kit.Part(body, 4, 84, 60, 11, DARK, { Radius = 3, Z = 6 })
	for index = 0, 9 do
		local key = kit.Box(keyboard, 3 + index * 5.6, 3, 4, 4, index % 2 == 0 and CYAN or MAGENTA, 0.15, 2)
		kit.Round(key, 1)
	end
	local mouse = kit.Blob(body, 60, 90, 10, 12, DARK, { Z = 7 })
	kit.Box(mouse, 4.5, 2, 1, 4, LIME, 0, 2)
	return { Glow = CYAN }
end

-- Télé géante (au mur) : jeu de course à l'écran, barre de son
Art.BigScreenTV = function(body, kit, _item)
	local C = kit.C
	local frame = kit.Part(body, 2, 18, 96, 58, DARKER, { Radius = 5, Z = 1 })
	local screen = kit.Group(frame, 3, 3, 90, 50, 2, true)
	local sky = kit.Box(screen, 0, 0, 90, 50, WHITE, 0, 1)
	kit.Gradient(sky, rgb(90, 150, 255), rgb(255, 176, 150), 90)
	kit.Circle(screen, 70, 16, 14, 14, C.Butter, 0, 2) -- soleil
	kit.Triangle(screen, 20, 12, 40, 16, rgb(120, 110, 200), 2)
	kit.Triangle(screen, 72, 14, 50, 14, rgb(100, 100, 190), 2)
	kit.Box(screen, 0, 26, 90, 24, rgb(110, 200, 110), 0, 3)
	-- route en perspective + bandes blanches qui défilent
	kit.Triangle(screen, 45, 22, 70, 28, rgb(80, 84, 100), 4, 0, 14)
	for index = 0, 2 do
		local dash = kit.Box(screen, 44, 28 + index * 7, 2 + index, 4 + index, WHITE, 0.1, 5)
		kit.Animate(dash, "Pulse", 0.8, 3, index * 0.8)
	end
	-- voiture du joueur
	local car = kit.Part(screen, 36, 38, 18, 9, RED, { Radius = 4, Z = 6, Thickness = 1 })
	kit.Box(car, 4, 1, 10, 3, CYAN, 0.2, 2)
	kit.Animate(car, "Drift", 2, 1.2, 0)
	-- compteur
	local hud = kit.Part(screen, 4, 4, 24, 11, DARKER, { Radius = 3, Z = 7, T = 0.25, Outline = false })
	kit.Text(hud, "1ST", 12, 5.5, 8, C.Butter, 3)
	local speed = kit.Part(screen, 62, 4, 24, 11, DARKER, { Radius = 3, Z = 7, T = 0.25, Outline = false })
	kit.Text(speed, "240", 12, 5.5, 8, CYAN, 3)
	-- pied mural + barre de son
	kit.Part(body, 22, 78, 56, 7, DARK, { Radius = 3, Z = 2 })
	for index = 0, 6 do
		kit.Circle(body, 28 + index * 7.4, 81.5, 3, 3, DARKER, 0, 3)
	end
	local led = kit.Circle(body, 92, 72, 3, 3, LIME, 0, 3)
	kit.Animate(led, "Pulse", 0.6, 1, 0)
	return { Glow = rgb(150, 200, 255), WallShadow = Vector2.new(96, 64) }
end

-- Borne d'arcade néon (fronton lumineux, envahisseur à l'écran, joystick)
Art.NeonArcade = function(body, kit, _item)
	local C = kit.C
	local cabinet = kit.Part(body, 14, 6, 72, 94, DARKER, { Radius = 8, Z = 1, Shine = true })
	for _, x in ipairs({ 14, 82 }) do
		kit.Box(body, x, 12, 4, 86, x < 50 and CYAN or MAGENTA, 0.1, 2) -- flancs néon
	end
	local _ = cabinet
	-- fronton
	local marquee = kit.Part(body, 18, 8, 64, 16, NAVY, { Radius = 5, Z = 3 })
	kit.Gradient(marquee, rgb(255, 120, 220), rgb(120, 140, 255), 0)
	local title = kit.Text(marquee, "ARCADE", 32, 8, 11, WHITE, 3)
	title.TextStrokeColor3 = MAGENTA
	title.TextStrokeTransparency = 0
	local bulbs = {}
	for index = 0, 4 do
		local color = index % 2 == 0 and CYAN or C.Butter
		local halo = kit.Circle(body, 22 + index * 14, 27, 8, 8, color, 0.6, 4)
		local bulb = kit.Circle(body, 22 + index * 14, 27, 4, 4, color, 0, 5)
		bulb:SetAttribute("Phase", index * 0.8)
		table.insert(bulbs, bulb)
		table.insert(bulbs, halo)
	end
	-- écran : envahisseur en pixels + score
	local screen = kit.Part(body, 22, 32, 56, 34, rgb(16, 20, 40), { Radius = 5, Z = 3, Outline = CYAN, Thickness = 1.5 })
	local invader = kit.Group(screen, 18, 8, 22, 16, 2)
	local pixels = { "0100010", "0011100", "0111110", "1101011", "1111111", "1010101" }
	for row, line in ipairs(pixels) do
		for col = 1, #line do
			if string.sub(line, col, col) == "1" then
				kit.Box(invader, (col - 1) * 3, (row - 1) * 2.6, 3, 2.6, LIME, 0, 1)
			end
		end
	end
	kit.Animate(invader, "Drift", 8, 1.2, 0)
	kit.Text(screen, "HI 9990", 28, 5, 6, C.Butter, 4)
	kit.Box(screen, 24, 28, 8, 3, CYAN, 0, 3) -- vaisseau
	-- tableau de commandes
	local panel = kit.Part(body, 16, 66, 68, 12, NAVY, { Radius = 4, Z = 4, Shine = true })
	kit.Line(panel, 16, 6, 14, -4, 2.5, STEEL, 0, 2)
	kit.Circle(panel, 14, -5, 7, 7, RED, 0, 3)
	for index, color in ipairs({ CYAN, MAGENTA, LIME, C.Butter }) do
		kit.Circle(panel, 34 + index * 7, 6, 5.5, 5.5, color, 0, 3)
	end
	-- trappe à pièces lumineuse
	local door = kit.Part(body, 36, 82, 28, 14, DARK, { Radius = 3, Z = 3 })
	for index = 0, 1 do
		local slot = kit.Box(door, 7 + index * 10, 4, 4, 6, ORANGE, 0, 2)
		kit.Animate(slot, "Pulse", 0.5, 1.5, index)
	end
	return { Bulbs = bulbs, Glow = MAGENTA }
end

-- Casque de réalité virtuelle pro sur présentoir, deux manettes anneaux
Art.VRHeadset = function(body, kit, _item)
	local C = kit.C
	-- présentoir
	kit.Part(body, 24, 64, 52, 30, WHITE, { Radius = 6, Z = 1, Shine = true })
	kit.Box(body, 24, 88, 52, 6, STEEL, 0, 2)
	kit.Blob(body, 50, 64, 56, 10, rgb(236, 240, 250), { Z = 2 })
	-- casque
	local strap = kit.Part(body, 22, 24, 56, 40, DARK, { Radius = 18, Z = 3, T = 1, Outline = DARK, Thickness = 5, Shade = false })
	local _ = strap
	local visor = kit.Part(body, 14, 30, 72, 30, WHITE, { Radius = 14, Z = 4, Shine = true })
	local glass = kit.Part(visor, 6, 5, 60, 18, DARKER, { Radius = 9, Z = 2 })
	kit.Gradient(glass, rgb(60, 80, 150), rgb(20, 24, 50), 90)
	local stripe = kit.Box(glass, 6, 7, 48, 3, CYAN, 0, 3)
	kit.Round(stripe)
	kit.Animate(stripe, "Pulse", 0.6, 1.3, 0)
	kit.Shine(glass, 6, 2, 16, 3, 4, 0.4)
	for _, x in ipairs({ 16, 44 }) do
		kit.Circle(glass, x, 13, 3, 3, MAGENTA, 0.2, 3)
	end
	-- manettes anneaux
	for index, side in ipairs({ -1, 1 }) do
		local cx = 50 + side * 40
		local ring = kit.Blob(body, cx, 78, 20, 20, WHITE, { Z = 5, T = 1, Outline = STEEL, Thickness = 3, Shade = false })
		local _r = ring
		kit.Part(body, cx - 4, 78, 8, 20, DARK, { Radius = 4, Z = 6, Shine = true })
		local led = kit.Circle(body, cx, 70, 4, 4, index == 1 and CYAN or MAGENTA, 0, 7)
		kit.Animate(led, "Pulse", 0.5, 1.5, index)
	end
	kit.Sparkle(body, 88, 22, 12, C.Butter, 0, 8)
	kit.Sparkle(body, 12, 20, 8, CYAN, 0, 8)
	return nil
end

-- Simulateur de course : siège baquet, volant, pédalier, écran
Art.RacingRig = function(body, kit, _item)
	local C = kit.C
	-- châssis
	kit.Part(body, 2, 90, 96, 8, DARK, { Radius = 3, Z = 1, Shine = true })
	kit.Part(body, 60, 44, 6, 48, STEEL, { Radius = 2, Z = 2 })
	-- écran au-dessus
	kit.Part(body, 76, 22, 4, 30, STEEL, { Radius = 2, Z = 1 })
	local screen = kit.Part(body, 56, 4, 42, 26, DARKER, { Radius = 4, Z = 2 })
	local view = kit.Group(screen, 3, 3, 36, 20, 2, true)
	local sky = kit.Box(view, 0, 0, 36, 20, WHITE, 0, 1)
	kit.Gradient(sky, rgb(100, 160, 255), rgb(255, 190, 150), 90)
	kit.Triangle(view, 18, 8, 34, 12, rgb(80, 84, 100), 2, 0, 8)
	kit.Box(view, 17, 12, 2, 3, WHITE, 0, 3)
	kit.Box(view, 16.5, 16, 3, 4, WHITE, 0, 3)
	-- siège baquet (rouge et noir)
	local seat = kit.Part(body, 6, 24, 38, 60, DARKER, { Radius = 14, Z = 3, Shine = true })
	kit.Part(seat, 8, 4, 22, 14, RED, { Radius = 6, Z = 2 })
	kit.Box(seat, 10, 22, 4, 34, RED, 0, 2)
	kit.Box(seat, 24, 22, 4, 34, RED, 0, 2)
	kit.Circle(seat, 19, 10, 5, 5, WHITE, 0.2, 3)
	kit.Part(body, 8, 70, 50, 16, DARK, { Radius = 7, Z = 4, Shine = true }) -- assise
	kit.Box(body, 14, 72, 38, 3, RED, 0, 5)
	-- volant sur sa colonne
	kit.Line(body, 63, 48, 54, 52, 5, STEEL, 0, 5)
	local wheel = kit.Blob(body, 52, 52, 22, 22, WHITE, { Z = 6, T = 1, Outline = DARKER, Thickness = 4, Shade = false })
	local hub = kit.Blob(wheel, 11, 11, 9, 9, DARKER, { Z = 2 })
	kit.Circle(hub, 4.5, 4.5, 3, 3, RED, 0, 2)
	kit.Animate(wheel, "Sway", 8, 1.2, 0)
	-- pédalier
	kit.Part(body, 76, 76, 16, 14, DARK, { Radius = 3, Z = 3 })
	for index = 0, 1 do
		kit.Part(body, 78 + index * 7, 70, 5, 10, STEEL, { Radius = 2, Z = 4, Rotation = -12 })
	end
	kit.Sparkle(body, 48, 16, 9, C.Butter, 0, 7)
	return nil
end

----------------------------------------------------------------------
-- 🛋️ Meubles cool (tables, sièges, lits)
----------------------------------------------------------------------

-- Pouf gamer (gris anthracite, liseré néon, logo manette)
Art.GamerBeanbag = function(body, kit, _item)
	local base = rgb(76, 72, 112)
	kit.Blob(body, 50, 96, 84, 12, DARKER, { Z = 1, Outline = false, Shade = false, T = 0.6 })
	local bag = kit.Blob(body, 50, 74, 92, 50, base, { Z = 2, Shine = true })
	kit.Blob(body, 56, 48, 64, 34, kit.Lighten(base, 0.1), { Z = 3, Shine = true }) -- dossier
	local seam = kit.Blob(bag, 46, 30, 76, 14, base, { Z = 2, T = 1, Outline = CYAN, Thickness = 2, Shade = false })
	local _ = seam
	kit.Animate(seam, "Pulse", 0.4, 1.2, 0)
	local logo = controller(kit, body, 50, 80, 26, MAGENTA, 4)
	local _l = logo
	return nil
end

-- Casier de vestiaire (2 portes, aérations, numéro, autocollants)
Art.LockerCabinet = function(body, kit, _item)
	local C = kit.C
	local blue = rgb(80, 130, 220)
	kit.Part(body, 6, 8, 88, 90, blue, { Radius = 5, Z = 1, Shine = true })
	kit.Box(body, 6, 94, 88, 6, kit.Darken(blue, 0.35), 0, 2)
	for index = 0, 1 do
		local door = kit.Part(body, 10 + index * 42, 12, 38, 80, kit.Lighten(blue, 0.08), { Radius = 3, Z = 2 })
		for vent = 0, 3 do
			kit.Box(door, 8, 6 + vent * 5, 22, 2.5, kit.Darken(blue, 0.3), 0, 2)
		end
		kit.Part(door, index == 0 and 30 or 4, 38, 4, 12, STEEL, { Radius = 2, Z = 3 })
		local plate = kit.Part(door, 11, 58, 16, 10, WHITE, { Radius = 2, Z = 3 })
		kit.Text(plate, index == 0 and "23" or "7", 8, 5, 8, C.Ink, 2)
	end
	-- autocollants : éclair et étoile
	local bolt = kit.Group(body, 18, 44, 18, 16, 4)
	kit.Line(bolt, 12, 0, 6, 8, 3, C.Butter, 0, 1)
	kit.Line(bolt, 6, 8, 12, 8, 3, C.Butter, 0, 1)
	kit.Line(bolt, 12, 8, 6, 16, 3, C.Butter, 0, 1)
	kit.Sparkle(body, 72, 48, 12, WHITE, 0, 4)
	return nil
end

-- Table de briques à construire (plateau vert à picots, pieds en briques)
Art.BrickTable = function(body, kit, _item)
	local C = kit.C
	local green = rgb(96, 196, 110)
	-- pieds : piles de briques de couleur
	for _, spec in ipairs({ { 6, RED, C.Butter }, { 80, rgb(80, 150, 255), ORANGE } }) do
		for level = 0, 2 do
			local color = level % 2 == 0 and spec[2] or spec[3]
			local brick = kit.Part(body, spec[1], 52 + level * 16, 14, 16, color, { Radius = 2, Z = 1 + level, Thickness = 1.2 })
			kit.Box(brick, 2, 2, 10, 2, WHITE, 0.6, 2)
		end
	end
	-- plateau (vu un peu de dessus) : chant + dessus plat
	kit.Part(body, 2, 42, 96, 12, kit.Darken(green, 0.2), { Radius = 3, Z = 5 })
	local top = kit.Part(body, 2, 36, 96, 10, green, { Radius = 3, Z = 6, Shine = true })
	for index = 0, 11 do
		kit.Circle(top, 5 + index * 7.8, 5, 4, 3, kit.Lighten(green, 0.3), 0, 2)
	end
	-- briques rangées dans le bac du dessous
	kit.Part(body, 22, 80, 56, 16, rgb(240, 240, 250), { Radius = 4, Z = 2 })
	for index, color in ipairs({ RED, C.Butter, rgb(80, 150, 255), green, ORANGE }) do
		kit.Part(body, 25 + (index - 1) * 10, 74 + (index % 2) * 3, 9, 8, color, { Radius = 2, Z = 3, Thickness = 1 })
	end
	return nil
end

-- Chaise gamer de course (de face) : baquet rouge et noir, roulettes
Art.GamerChair = function(body, kit, _item)
	-- piètement étoile + roulettes
	kit.Part(body, 46, 70, 8, 18, STEEL, { Radius = 3, Z = 1 })
	kit.Part(body, 16, 86, 68, 6, DARK, { Radius = 3, Z = 2 })
	for _, x in ipairs({ 18, 50, 82 }) do
		kit.Blob(body, x, 94, 11, 9, DARKER, { Z = 3 })
	end
	-- dossier baquet avec ailes
	local back = kit.Part(body, 22, 6, 56, 64, DARKER, { Radius = 16, Z = 2, Shine = true })
	kit.Part(back, 14, 8, 28, 50, RED, { Radius = 10, Z = 2 })
	kit.Box(back, 26, 8, 4, 50, WHITE, 0.2, 3)
	for index = 0, 1 do
		kit.Part(back, 4 + index * 44, 20, 8, 38, RED, { Radius = 4, Z = 2 })
	end
	local pillow = kit.Part(back, 16, 4, 24, 10, DARK, { Radius = 5, Z = 4, Shine = true })
	kit.Circle(pillow, 12, 5, 4, 4, RED, 0, 2)
	-- accoudoirs
	for _, x in ipairs({ 12, 78 }) do
		kit.Part(body, x, 54, 10, 18, DARK, { Radius = 3, Z = 3 })
		kit.Part(body, x - 3, 50, 16, 6, DARKER, { Radius = 3, Z = 4 })
	end
	-- assise
	local seat = kit.Part(body, 20, 60, 60, 16, DARKER, { Radius = 7, Z = 4, Shine = true })
	kit.Box(seat, 20, 3, 20, 4, RED, 0, 2)
	return nil
end

-- Bureau gamer : plateau noir avec bande LED, pieds rouges en Z, range-câbles
Art.GamingDesk = function(body, kit, _item)
	-- pieds en Z
	for _, x in ipairs({ 8, 80 }) do
		kit.Part(body, x, 46, 12, 44, RED, { Radius = 3, Z = 1, Shine = true })
		kit.Part(body, x - 4, 90, 20, 8, DARK, { Radius = 3, Z = 2 })
	end
	kit.Box(body, 20, 50, 60, 3, DARKER, 0, 1) -- barre de renfort
	-- range-câbles
	local tray = kit.Part(body, 26, 50, 48, 8, DARK, { Radius = 2, Z = 2 })
	kit.Line(tray, 6, 4, 42, 6, 1.5, CYAN, 0.3, 2)
	-- plateau (chant + dessus)
	local edge = kit.Part(body, 2, 38, 96, 10, DARKER, { Radius = 3, Z = 3 })
	ledStrip(kit, edge, 4, 5, 88, 2.5, 3)
	local top = kit.Part(body, 2, 34, 96, 8, DARK, { Radius = 3, Z = 4, Shine = true })
	kit.Box(top, 6, 2, 84, 1.5, WHITE, 0.8, 2)
	return nil
end

-- Lits superposés (bleu nuit et rouge, échelle, étoiles)
Art.BunkBed = function(body, kit, _item)
	local C = kit.C
	local frameColor = rgb(96, 120, 190)
	for _, x in ipairs({ 4, 90 }) do
		kit.Part(body, x, 8, 7, 92, frameColor, { Radius = 3, Z = 6, Shine = true })
	end
	-- lit du haut
	kit.Part(body, 2, 38, 96, 8, kit.Darken(frameColor, 0.2), { Radius = 3, Z = 4 })
	kit.Part(body, 10, 26, 70, 12, WHITE, { Radius = 5, Z = 2 })
	local topBlanket = kit.Part(body, 34, 22, 46, 16, NAVY, { Radius = 6, Z = 3, Shine = true })
	for index = 0, 2 do
		kit.Sparkle(topBlanket, 8 + index * 14, 8, 7, C.Butter, 0, 2)
	end
	kit.Blob(body, 22, 26, 20, 11, rgb(210, 226, 255), { Z = 3, Shine = true })
	kit.Part(body, 4, 16, 44, 5, frameColor, { Radius = 2, Z = 7 }) -- garde-corps
	for _, x in ipairs({ 20, 34 }) do
		kit.Part(body, x, 20, 4, 18, frameColor, { Radius = 2, Z = 7 })
	end
	-- lit du bas
	kit.Part(body, 2, 84, 96, 9, kit.Darken(frameColor, 0.2), { Radius = 3, Z = 4 })
	kit.Part(body, 10, 70, 80, 14, WHITE, { Radius = 5, Z = 2 })
	local lowBlanket = kit.Part(body, 36, 66, 54, 18, RED, { Radius = 6, Z = 3, Shine = true })
	for index = 0, 2 do
		kit.Box(lowBlanket, 6 + index * 16, 2, 5, 14, WHITE, 0.55, 2)
	end
	kit.Blob(body, 24, 70, 22, 12, rgb(255, 226, 214), { Z = 3, Shine = true })
	-- échelle
	for _, x in ipairs({ 80, 92 }) do
		kit.Part(body, x, 36, 4, 50, rgb(210, 170, 120), { Radius = 2, Z = 8 })
	end
	for _, y in ipairs({ 48, 60, 72 }) do
		kit.Part(body, 80, y, 16, 4, rgb(236, 196, 150), { Radius = 2, Z = 8 })
	end
	return nil
end

-- Lit voiture de course (rouge, numéro 1, aileron, phares)
Art.RaceCarBed = function(body, kit, _item)
	local C = kit.C
	-- carrosserie
	local car = kit.Part(body, 2, 50, 96, 36, RED, { Radius = 14, Z = 3, Shine = true })
	kit.Box(car, 4, 22, 88, 4, WHITE, 0.2, 2) -- bande
	kit.Box(car, 4, 27, 88, 3, DARKER, 0.3, 2)
	local plate = kit.Blob(car, 70, 14, 20, 16, WHITE, { Z = 3 })
	kit.Text(plate, "1", 10, 8, 12, C.Ink, 2)
	kit.Circle(car, 92, 10, 6, 6, C.Butter, 0, 3) -- phare
	-- capot avant bombé + aileron arrière
	kit.Part(body, 70, 42, 28, 14, RED, { Radius = 8, Z = 2 })
	kit.Part(body, 0, 30, 8, 26, DARKER, { Radius = 3, Z = 2 })
	kit.Part(body, -2, 28, 22, 6, RED, { Radius = 3, Z = 4, Shine = true })
	-- matelas, oreiller, couette à damier
	kit.Part(body, 16, 40, 60, 14, WHITE, { Radius = 6, Z = 1 })
	kit.Blob(body, 26, 42, 20, 11, rgb(226, 236, 255), { Z = 2, Shine = true })
	local blanket = kit.Part(body, 40, 38, 36, 16, DARK, { Radius = 6, Z = 2 })
	for row = 0, 1 do
		for col = 0, 5 do
			if (row + col) % 2 == 0 then
				kit.Box(blanket, 3 + col * 5, 3 + row * 5, 5, 5, WHITE, 0.1, 2)
			end
		end
	end
	-- roues
	for _, x in ipairs({ 22, 78 }) do
		local wheel = kit.Blob(body, x, 86, 24, 24, DARKER, { Z = 5 })
		kit.Circle(wheel, 12, 12, 12, 12, STEEL, 0, 2)
		local spokes = kit.Pivot(wheel, 12, 12, 3)
		for index = 0, 2 do
			local spoke = kit.Box(spokes, -1, -5, 2, 10, DARK, 0, 1)
			spoke.Rotation = index * 60
		end
		kit.Animate(spokes, "Spin", 1, 0.3, x)
	end
	return nil
end

return Art
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="15">
              <Properties>
                <string name="Name">Cool92Music</string>
                <string name="Source"><![CDATA[--[[
	Cool92Music (ModuleScript) — (v9.2) musique rock 🎸 (ampli, guitare
	électrique à flammes, batterie, cabine de DJ)
	Emplacement : ReplicatedStorage > Client > Components > House > Art > Cool92Music
	Contrat : voir HouseArt (boîte 100 x 100, pieds en bas pour les objets au sol).
]]

local Art = {}

local rgb = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)
local DARK = rgb(44, 46, 64)
local DARKER = rgb(30, 32, 46)
local CYAN = rgb(60, 222, 255)
local MAGENTA = rgb(255, 84, 196)
local LIME = rgb(140, 240, 110)
local RED = rgb(236, 66, 76)
local ORANGE = rgb(255, 152, 56)
local STEEL = rgb(176, 186, 206)
local CHROME = rgb(214, 222, 236)

-- Petit éclair (logo) dans la zone (x, y) de hauteur h
local function bolt(kit, parent, x, y, h, color, z)
	local g = kit.Group(parent, x, y, h * 0.7, h, z)
	kit.Line(g, h * 0.55, 0, h * 0.18, h * 0.5, h * 0.16, color, 0, 1)
	kit.Line(g, h * 0.18, h * 0.5, h * 0.52, h * 0.5, h * 0.16, color, 0, 1)
	kit.Line(g, h * 0.52, h * 0.5, h * 0.15, h, h * 0.16, color, 0, 1)
	return g
end

-- Note de musique qui flotte
local function note(kit, parent, x, y, color, phase)
	local label = kit.Text(parent, "🎵", x, y, 14, color, 8)
	kit.Animate(label, "Bob", 3, 1.2, phase)
	return label
end

-- Ampli de guitare (grille, boutons, logo éclair, câble)
Art.GuitarAmp = function(body, kit, _item)
	local C = kit.C
	local amp = kit.Part(body, 8, 22, 84, 76, DARKER, { Radius = 8, Z = 1, Shine = true })
	kit.Part(body, 32, 16, 36, 8, DARK, { Radius = 4, Z = 0 }) -- poignée
	local panel = kit.Part(amp, 4, 4, 76, 16, C.Gold, { Radius = 4, Z = 2 })
	for index = 0, 4 do
		local knob = kit.Circle(panel, 10 + index * 12, 8, 8, 8, DARKER, 0, 2)
		kit.Box(knob, 3.4, 1, 1.2, 3.5, WHITE, 0, 2)
	end
	local led = kit.Circle(panel, 70, 8, 5, 5, RED, 0, 2)
	kit.Animate(led, "Pulse", 0.6, 1.5, 0)
	local grille = kit.Part(amp, 6, 24, 72, 46, rgb(70, 64, 80), { Radius = 5, Z = 2 })
	for row = 0, 7 do
		kit.Box(grille, 3, 3 + row * 5.5, 66, 1.4, rgb(96, 90, 110), 0, 2)
	end
	local cone = kit.Circle(grille, 36, 23, 30, 30, DARKER, 0.2, 3)
	kit.Animate(cone, "Breathe", 0.05, 3, 0)
	bolt(kit, grille, 30, 12, 20, C.Butter, 4)
	-- câble jack
	kit.Line(body, 90, 80, 98, 96, 2.5, DARKER, 0, 2)
	note(kit, body, 90, 14, CYAN, 0)
	return nil
end

-- Guitare électrique à flammes sur son support
Art.ElectricGuitar = function(body, kit, _item)
	local C = kit.C
	-- support en A
	kit.Line(body, 34, 98, 50, 70, 3, DARK, 0, 1)
	kit.Line(body, 66, 98, 50, 70, 3, DARK, 0, 1)
	-- manche + tête
	kit.Part(body, 46, 6, 8, 56, rgb(150, 96, 60), { Radius = 3, Z = 2 })
	for index = 0, 5 do
		kit.Box(body, 46, 12 + index * 8, 8, 1, CHROME, 0, 3) -- frettes
	end
	local head = kit.Part(body, 42, 0, 16, 12, DARKER, { Radius = 4, Z = 3 })
	for index = 0, 2 do
		kit.Circle(head, 2, 3 + index * 3.5, 3, 3, CHROME, 0, 2)
		kit.Circle(head, 14, 3 + index * 3.5, 3, 3, CHROME, 0, 2)
	end
	-- corps (double pointe) rouge + flammes
	kit.Part(body, 22, 52, 18, 20, RED, { Radius = 8, Z = 3, Rotation = -30 })
	kit.Part(body, 60, 50, 18, 20, RED, { Radius = 8, Z = 3, Rotation = 30 })
	local guitarBody = kit.Blob(body, 50, 76, 52, 40, RED, { Z = 4, Shine = true })
	for k = 0, 2 do
		local cx = 14 + k * 12
		kit.Circle(guitarBody, cx, 32, 14, 10, ORANGE, 0, 2)
		kit.Triangle(guitarBody, cx, 16 - (k == 1 and 6 or 0), 12, 18 + (k == 1 and 6 or 0), ORANGE, 2, 0, 8)
		kit.Triangle(guitarBody, cx, 24, 6, 10, C.Butter, 3, 0, 6)
	end
	-- micros, chevalet, cordes
	for index = 0, 1 do
		kit.Part(guitarBody, 16, 8 + index * 9, 20, 5, DARKER, { Radius = 2, Z = 4 })
	end
	kit.Part(guitarBody, 18, 28, 16, 4, CHROME, { Radius = 2, Z = 4 })
	for index = 0, 3 do
		kit.Box(body, 47.5 + index * 1.6, 12, 0.6, 76, WHITE, 0.3, 5)
	end
	kit.Circle(guitarBody, 44, 30, 5, 5, C.Gold, 0, 4)
	note(kit, body, 86, 30, MAGENTA, 1)
	return nil
end

-- Batterie rock (grosse caisse à éclair, toms, caisse claire, cymbales)
Art.DrumKit = function(body, kit, _item)
	local C = kit.C
	local shell = rgb(80, 110, 230)
	-- cymbales sur pieds
	for index, spec in ipairs({ { 12, 26 }, { 88, 18 } }) do
		kit.Line(body, spec[1], spec[2], spec[1], 96, 2, STEEL, 0, 1)
		local cymbal = kit.Part(body, spec[1] - 14, spec[2] - 3, 28, 6, C.Gold, { Radius = -1, Z = 2, Shine = true })
		kit.Animate(cymbal, "Sway", 4, 2, index)
	end
	-- toms
	for _, x in ipairs({ 30, 58 }) do
		local tom = kit.Part(body, x, 26, 20, 16, shell, { Radius = 5, Z = 3, Shine = true })
		kit.Box(tom, 0, 0, 20, 3, WHITE, 0.1, 2)
	end
	-- caisse claire + tom basse
	kit.Line(body, 14, 60, 14, 96, 2, STEEL, 0, 2)
	local snare = kit.Part(body, 4, 52, 24, 12, CHROME, { Radius = 4, Z = 4, Shine = true })
	kit.Box(snare, 0, 0, 24, 3, WHITE, 0, 2)
	local floor = kit.Part(body, 74, 50, 24, 36, shell, { Radius = 6, Z = 3, Shine = true })
	kit.Box(floor, 0, 0, 24, 3, WHITE, 0.1, 2)
	-- grosse caisse
	local kick = kit.Blob(body, 50, 72, 50, 50, shell, { Z = 5, Shine = true })
	kit.Circle(kick, 25, 25, 42, 42, rgb(244, 246, 255), 0, 2)
	bolt(kit, kick, 18, 12, 26, C.Butter, 3)
	for index = 0, 5 do
		local a = index / 6 * math.pi * 2
		kit.Circle(kick, 25 + math.cos(a) * 23, 25 + math.sin(a) * 23, 3.5, 3.5, CHROME, 0, 3)
	end
	kit.Animate(kick, "Breathe", 0.02, 4, 0)
	-- baguettes croisées
	kit.Line(body, 34, 16, 50, 30, 2.5, rgb(236, 196, 150), 0, 6)
	kit.Line(body, 66, 16, 50, 30, 2.5, rgb(236, 196, 150), 0, 6)
	note(kit, body, 94, 44, CYAN, 0.5)
	return nil
end

-- Cabine de DJ : platines qui tournent, table de mixage, façade à égaliseur
Art.DJBooth = function(body, kit, _item)
	local C = kit.C
	-- façade lumineuse
	local front = kit.Part(body, 6, 44, 88, 54, DARKER, { Radius = 8, Z = 2 })
	for col = 0, 9 do
		local height = 6 + ((col * 7) % 5) * 6
		local bar = kit.Box(front, 6 + col * 7.8, 44 - height, 5.5, height, col % 3 == 0 and MAGENTA or (col % 3 == 1 and CYAN or LIME), 0, 2)
		kit.Round(bar, 2)
		kit.Animate(bar, "Pulse", 0.6, 2.2, col * 0.7)
	end
	kit.Text(front, "DJ", 44, 10, 14, WHITE, 3)
	-- plateau + platines
	kit.Part(body, 2, 34, 96, 12, DARK, { Radius = 4, Z = 3, Shine = true })
	for index, x in ipairs({ 22, 78 }) do
		local deck = kit.Blob(body, x, 36, 30, 12, DARKER, { Z = 4 })
		local record = kit.Blob(deck, 15, 6, 22, 8, rgb(20, 20, 26), { Z = 2, Outline = false })
		local label = kit.Circle(record, 11, 4, 7, 3.5, index == 1 and MAGENTA or CYAN, 0, 2)
		kit.Animate(label, "Drift", 3, 3, index)
	end
	-- table de mixage
	local mixer = kit.Part(body, 40, 28, 20, 10, rgb(60, 62, 84), { Radius = 3, Z = 5 })
	for index = 0, 2 do
		kit.Box(mixer, 3 + index * 6, 3, 2, 5, C.Butter, 0, 2)
	end
	-- casque posé + ordinateur portable
	local laptop = kit.Part(body, 60, 12, 26, 18, STEEL, { Radius = 3, Z = 2, Shine = true })
	kit.Part(laptop, 3, 3, 20, 12, rgb(40, 44, 90), { Radius = 2, Z = 2, Outline = false })
	kit.Blob(body, 24, 24, 20, 14, DARK, { Z = 2, T = 1, Outline = DARK, Thickness = 3, Shade = false })
	kit.Blob(body, 16, 30, 8, 10, RED, { Z = 3 })
	kit.Blob(body, 32, 30, 8, 10, RED, { Z = 3 })
	note(kit, body, 50, 8, MAGENTA, 0)
	return { Glow = MAGENTA }
end

return Art
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="16">
              <Properties>
                <string name="Name">Cool92Sports</string>
                <string name="Source"><![CDATA[--[[
	Cool92Sports (ModuleScript) — (v9.2) sport 🏀 et véhicules 🏎️
	(haltères, panier de ballons, skates, panier de basket, cage de foot,
	maillot encadré, sac de frappe, surf, BMX, étagère à trophées, voiture
	télécommandée, garage à petites voitures, tapis circuit, moto chromée)
	Emplacement : ReplicatedStorage > Client > Components > House > Art > Cool92Sports
	Contrat : voir HouseArt (boîte 100 x 100, pieds en bas pour les objets au sol).
]]

local Art = {}

local rgb = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)
local NAVY = rgb(52, 60, 100)
local DARK = rgb(44, 46, 64)
local DARKER = rgb(30, 32, 46)
local CYAN = rgb(60, 222, 255)
local RED = rgb(236, 66, 76)
local ORANGE = rgb(255, 152, 56)
local BALL = rgb(250, 140, 60)
local STEEL = rgb(176, 186, 206)
local CHROME = rgb(214, 222, 236)
local BLUE = rgb(80, 150, 255)
local GREEN = rgb(96, 196, 110)

----------------------------------------------------------------------
-- Petits outils
----------------------------------------------------------------------

-- Ballon de basket (coutures noires)
local function basketball(kit, parent, cx, cy, d, z)
	local ball = kit.Blob(parent, cx, cy, d, d, BALL, { Z = z, Shine = true })
	local seam = kit.Darken(BALL, 0.55)
	kit.Box(ball, d / 2 - 0.6, 1, 1.2, d - 2, seam, 0, 2)
	kit.Box(ball, 1, d / 2 - 0.6, d - 2, 1.2, seam, 0, 2)
	local arc = kit.Blob(ball, d * 0.08, d / 2, d * 0.5, d * 0.9, BALL, { Z = 2, T = 1, Outline = seam, Thickness = 1.1, Shade = false })
	local arc2 = kit.Blob(ball, d * 0.92, d / 2, d * 0.5, d * 0.9, BALL, { Z = 2, T = 1, Outline = seam, Thickness = 1.1, Shade = false })
	local _ = arc
	local _2 = arc2
	return ball
end

-- Ballon de foot (blanc à pentagones)
local function football(kit, parent, cx, cy, d, z)
	local ball = kit.Blob(parent, cx, cy, d, d, WHITE, { Z = z, Shine = true })
	kit.Diamond(ball, d / 2, d / 2, d * 0.26, DARK, 0, 2)
	for _, p in ipairs({ { 0.16, 0.3 }, { 0.84, 0.3 }, { 0.28, 0.86 }, { 0.72, 0.86 }, { 0.5, 0.06 } }) do
		kit.Circle(ball, d * p[1], d * p[2], d * 0.2, d * 0.2, DARK, 0, 2)
	end
	return ball
end

-- Roue à rayons qui tourne ; (cx, cy) centre, d diamètre
local function wheel(kit, parent, cx, cy, d, tire, rim, z, speed)
	local w = kit.Blob(parent, cx, cy, d, d, tire, { Z = z })
	kit.Circle(w, d / 2, d / 2, d * 0.72, d * 0.72, rim, 0, 2)
	kit.Circle(w, d / 2, d / 2, d * 0.56, d * 0.56, kit.Darken(rim, 0.25), 0.4, 3)
	local spokes = kit.Pivot(w, d / 2, d / 2, 4)
	for index = 0, 3 do
		local spoke = kit.Box(spokes, -0.6, -d * 0.34, 1.2, d * 0.68, rim, 0, 1)
		spoke.Rotation = index * 45
	end
	kit.Circle(w, d / 2, d / 2, d * 0.18, d * 0.18, CHROME, 0, 5)
	kit.Animate(spokes, "Spin", 1, speed or 0.4, cx)
	return w
end

-- Rangée de flammes (langues orange + cœur jaune) dans la zone (x, y, w, h)
local function flames(kit, parent, x, y, w, h, z)
	local C = kit.C
	local n = 3
	local step = w / n
	for k = 0, n - 1 do
		local cx = x + step * (k + 0.5)
		local th = h * (k == 1 and 1 or 0.74)
		kit.Circle(parent, cx, y + h - step * 0.35, step * 1.15, step * 0.85, ORANGE, 0, z)
		kit.Triangle(parent, cx, y + h - th, step * 1.05, th - step * 0.3, ORANGE, z, 0, 8)
		kit.Circle(parent, cx, y + h - step * 0.3, step * 0.6, step * 0.5, C.Butter, 0, z + 1)
		kit.Triangle(parent, cx, y + h - th * 0.58, step * 0.55, th * 0.5, C.Butter, z + 1, 0, 6)
	end
end

----------------------------------------------------------------------
-- 🏀 Sport
----------------------------------------------------------------------

-- Deux haltères (poids bleus et orange, poignée chromée)
Art.Dumbbells = function(body, kit, _item)
	local function dumbbell(cx, cy, w, color, z)
		kit.Part(body, cx - w * 0.3, cy - 3, w * 0.6, 6, CHROME, { Radius = 3, Z = z })
		for _, side in ipairs({ -1, 1 }) do
			kit.Part(body, cx + side * w * 0.36 - w * 0.08, cy - w * 0.2, w * 0.16, w * 0.4, color, { Radius = 4, Z = z + 1, Shine = true })
			kit.Part(body, cx + side * w * 0.48 - w * 0.05, cy - w * 0.14, w * 0.1, w * 0.28, kit.Darken(color, 0.15), { Radius = 3, Z = z + 1 })
		end
	end
	dumbbell(46, 86, 70, BLUE, 2)
	dumbbell(54, 62, 62, ORANGE, 5)
	kit.Sparkle(body, 86, 46, 10, CYAN, 0, 8)
	return nil
end

-- Panier en fil de fer plein de ballons (basket, foot, tennis, rugby)
Art.SportsBallBin = function(body, kit, _item)
	local C = kit.C
	basketball(kit, body, 32, 40, 30, 1)
	football(kit, body, 64, 38, 28, 1)
	local tennis = kit.Blob(body, 48, 30, 18, 18, rgb(210, 240, 90), { Z = 2, Shine = true })
	kit.Blob(tennis, 2, 9, 12, 16, rgb(210, 240, 90), { Z = 2, T = 1, Outline = WHITE, Thickness = 1.2, Shade = false })
	local rugby = kit.Blob(body, 80, 44, 26, 16, rgb(170, 100, 70), { Z = 2, Shine = true, Rotation = -30 })
	kit.Box(rugby, 8, 7, 10, 1.5, WHITE, 0, 2)
	-- panier grillagé
	local basket = kit.Part(body, 12, 48, 76, 50, STEEL, { Radius = 8, Z = 3, T = 0.35 })
	for index = 1, 6 do
		kit.Box(basket, index * 10.8, 2, 1.5, 46, CHROME, 0, 2)
	end
	for index = 1, 3 do
		kit.Box(basket, 2, index * 12, 72, 1.5, CHROME, 0, 2)
	end
	kit.Part(body, 8, 44, 84, 8, CHROME, { Radius = 4, Z = 4, Shine = true })
	for _, x in ipairs({ 18, 76 }) do
		kit.Blob(body, x, 97, 10, 6, DARK, { Z = 4 })
	end
	local _ = C
	return nil
end

-- Présentoir mural à skateboards (3 planches décorées)
Art.SkateRack = function(body, kit, _item)
	local C = kit.C
	kit.Part(body, 4, 44, 92, 10, rgb(170, 120, 86), { Radius = 3, Z = 1, Shine = true })
	for index = 0, 2 do
		local x = 12 + index * 28
		kit.Part(body, x + 7, 42, 4, 14, STEEL, { Radius = 2, Z = 5 }) -- crochet
		local deck = kit.Part(body, x, 8, 20, 84, ({ DARK, RED, BLUE })[index + 1], { Radius = 10, Z = 3, Shine = true })
		if index == 0 then
			-- flammes
			kit.Box(deck, 0, 74, 20, 10, ORANGE, 0, 2)
			flames(kit, deck, 1, 46, 18, 30, 2)
		elseif index == 1 then
			-- étoiles
			for k = 0, 2 do
				kit.Sparkle(deck, 10, 18 + k * 22, 12, WHITE, 0, 2)
			end
		else
			-- bandes
			for k = 0, 3 do
				kit.Box(deck, 0, 16 + k * 16, 20, 5, CYAN, 0.1, 2)
			end
		end
		-- roues (vues de dos)
		for _, y in ipairs({ 16, 66 }) do
			kit.Box(deck, 2, y, 16, 2.5, STEEL, 0, 4)
			kit.Circle(deck, 1, y + 1, 5, 5, C.Butter, 0, 5)
			kit.Circle(deck, 19, y + 1, 5, 5, C.Butter, 0, 5)
		end
	end
	return { WallShadow = Vector2.new(92, 86) }
end

-- Panier de basket sur pied (panneau, cercle orange, filet, ballon qui rebondit)
Art.BasketHoop = function(body, kit, _item)
	local C = kit.C
	kit.Part(body, 22, 84, 44, 14, DARK, { Radius = 7, Z = 1, Shine = true }) -- lest
	kit.Part(body, 38, 20, 7, 68, STEEL, { Radius = 3, Z = 2, Shine = true })
	kit.Line(body, 44, 26, 58, 18, 5, STEEL, 0, 2)
	-- panneau
	local board = kit.Part(body, 50, 2, 48, 34, WHITE, { Radius = 4, Z = 3, Shine = true })
	kit.Stroke(board, NAVY, 2, 0)
	local square = kit.Part(board, 15, 14, 18, 14, WHITE, { Radius = 1, Z = 2, Outline = RED, Thickness = 2, Shade = false })
	local _ = square
	-- cercle + filet
	kit.Part(body, 60, 32, 28, 4, ORANGE, { Radius = 2, Z = 5 })
	for index = 0, 4 do
		local x = 62 + index * 6
		kit.Line(body, x, 36, 64 + index * 5, 52, 1.2, WHITE, 0.1, 4)
	end
	kit.Line(body, 63, 44, 85, 44, 1.2, WHITE, 0.1, 4)
	kit.Line(body, 64, 51, 84, 51, 1.2, WHITE, 0.1, 4)
	-- ballon qui rebondit
	local bouncer = kit.Group(body, 0, 0, 100, 100, 6)
	basketball(kit, bouncer, 78, 78, 20, 1)
	kit.Animate(bouncer, "Bob", 4, 2.2, 0)
	kit.Blob(body, 78, 97, 16, 4, DARKER, { Z = 1, Outline = false, Shade = false, T = 0.6 })
	local _c = C
	return nil
end

-- Mini cage de foot (poteaux blancs, filet, ballon)
Art.FootballGoal = function(body, kit, _item)
	local net = kit.Group(body, 10, 20, 80, 76, 1)
	for index = 0, 8 do
		kit.Box(net, index * 10, 0, 1.2, 76, WHITE, 0.35, 1)
	end
	for index = 0, 7 do
		kit.Box(net, 0, index * 10, 80, 1.2, WHITE, 0.35, 1)
	end
	kit.Part(body, 6, 16, 88, 7, WHITE, { Radius = 3, Z = 3, Shine = true, Outline = STEEL })
	for _, x in ipairs({ 6, 87 }) do
		kit.Part(body, x, 16, 7, 84, WHITE, { Radius = 3, Z = 3, Shine = true, Outline = STEEL })
	end
	for index = 0, 3 do
		kit.Box(body, 7, 26 + index * 18, 5, 6, RED, 0, 4) -- bandes rouges
		kit.Box(body, 88, 26 + index * 18, 5, 6, RED, 0, 4)
	end
	local ball = kit.Group(body, 0, 0, 100, 100, 5)
	football(kit, ball, 50, 86, 22, 1)
	kit.Animate(ball, "Drift", 3, 1, 0)
	kit.Blob(body, 50, 98, 20, 4, DARKER, { Z = 2, Outline = false, Shade = false, T = 0.6 })
	return nil
end

-- Maillot encadré (numéro 10, bandes)
Art.JerseyFrame = function(body, kit, _item)
	local C = kit.C
	local frame = kit.Part(body, 8, 6, 84, 88, DARK, { Radius = 4, Z = 1, Shine = true })
	kit.Part(frame, 5, 5, 74, 78, rgb(236, 240, 248), { Radius = 2, Z = 2, Outline = false })
	-- maillot : manches, corps, col
	for _, side in ipairs({ -1, 1 }) do
		kit.Part(body, 50 + side * 28 - 10, 22, 20, 18, BLUE, { Radius = 5, Z = 3, Rotation = side * 30 })
	end
	local shirt = kit.Part(body, 28, 18, 44, 62, BLUE, { Radius = 8, Z = 4, Shine = true })
	kit.Box(shirt, 0, 44, 44, 5, WHITE, 0, 2)
	kit.Box(shirt, 0, 51, 44, 3, RED, 0, 2)
	kit.Blob(shirt, 22, 2, 16, 10, rgb(236, 240, 248), { Z = 3 })
	kit.Text(shirt, "10", 22, 24, 22, WHITE, 3)
	kit.Sparkle(body, 22, 84, 8, C.Butter, 0, 5)
	-- petite plaque dorée
	kit.Part(body, 38, 84, 24, 5, C.Gold, { Radius = 2, Z = 5 })
	return { WallShadow = Vector2.new(84, 88) }
end

-- Sac de frappe sur potence (se balance), gants
Art.BoxingBag = function(body, kit, _item)
	local C = kit.C
	kit.Part(body, 8, 8, 8, 90, DARK, { Radius = 3, Z = 1, Shine = true })
	kit.Part(body, 2, 92, 30, 8, DARKER, { Radius = 3, Z = 2 })
	kit.Part(body, 8, 8, 64, 7, DARK, { Radius = 3, Z = 1 })
	local swing = kit.Pivot(body, 60, 14, 3)
	kit.Line(swing, 0, 0, -6, 12, 1.5, STEEL, 0, 1)
	kit.Line(swing, 0, 0, 6, 12, 1.5, STEEL, 0, 1)
	local bag = kit.Part(swing, -16, 12, 32, 66, RED, { Radius = 14, Z = 2, Shine = true })
	kit.Box(bag, 0, 12, 32, 5, DARKER, 0, 2)
	kit.Box(bag, 0, 50, 32, 5, DARKER, 0, 2)
	kit.Sparkle(bag, 16, 32, 12, WHITE, 0.1, 3)
	kit.Animate(swing, "Sway", 4, 1.2, 0)
	-- gants accrochés au poteau
	for index = 0, 1 do
		local glove = kit.Blob(body, 18 + index * 9, 52 + index * 6, 14, 16, BLUE, { Z = 4 + index, Shine = true })
		kit.Box(glove, 2, 11, 10, 4, WHITE, 0, 2)
	end
	local _ = C
	return nil
end

-- Planche de surf sur son support (vague, aileron)
Art.Surfboard = function(body, kit, _item)
	local C = kit.C
	kit.Part(body, 26, 84, 48, 12, rgb(170, 120, 86), { Radius = 4, Z = 1, Shine = true })
	local board = kit.Part(body, 34, 4, 32, 90, WHITE, { Radius = 16, Z = 2, Shine = true, Rotation = 6 })
	kit.Box(board, 14.5, 4, 3, 82, rgb(170, 120, 86), 0.3, 2) -- latte centrale
	local wave = kit.Part(board, 0, 36, 32, 22, CYAN, { Radius = 0, Z = 3, Outline = false })
	for index = 0, 2 do
		kit.Circle(wave, 5 + index * 11, 0, 12, 10, WHITE, 0, 2)
	end
	kit.Box(board, 0, 62, 32, 6, ORANGE, 0, 3)
	kit.Circle(board, 16, 20, 12, 12, C.Butter, 0, 3) -- soleil
	kit.Triangle(body, 50, 84, 12, 10, NAVY, 3) -- aileron
	return nil
end

-- BMX (roues qui tournent, cadre vert néon, guidon)
Art.BMXBike = function(body, kit, _item)
	local frameColor = rgb(120, 230, 120)
	wheel(kit, body, 22, 72, 40, DARKER, STEEL, 1)
	wheel(kit, body, 78, 72, 40, DARKER, STEEL, 1)
	-- cadre
	kit.Line(body, 22, 72, 46, 72, 4, frameColor, 0, 3)
	kit.Line(body, 46, 72, 38, 46, 4, frameColor, 0, 3)
	kit.Line(body, 38, 46, 70, 46, 4, frameColor, 0, 3)
	kit.Line(body, 46, 72, 70, 46, 4, frameColor, 0, 3)
	kit.Line(body, 70, 46, 78, 72, 4, frameColor, 0, 3)
	kit.Line(body, 22, 72, 38, 46, 3, frameColor, 0, 3)
	-- selle, guidon, pédalier, repose-pieds
	kit.Line(body, 38, 46, 36, 38, 3, STEEL, 0, 3)
	kit.Part(body, 26, 32, 20, 7, DARK, { Radius = 3, Z = 4, Shine = true })
	kit.Line(body, 70, 46, 66, 26, 3, STEEL, 0, 4)
	kit.Line(body, 58, 26, 76, 22, 4, DARK, 0, 5)
	kit.Blob(body, 46, 72, 12, 12, CHROME, { Z = 4 })
	kit.Line(body, 46, 72, 52, 84, 2.5, STEEL, 0, 4)
	kit.Part(body, 50, 82, 10, 4, DARK, { Radius = 2, Z = 5 })
	kit.Part(body, 76, 68, 10, 6, STEEL, { Radius = 2, Z = 5 }) -- repose-pied
	return nil
end

-- Étagère à trophées (coupe d'or, médaille, ballon doré, plaque étoile)
Art.TrophyShelf = function(body, kit, _item)
	local C = kit.C
	local wood = rgb(160, 110, 78)
	kit.Part(body, 4, 66, 92, 8, wood, { Radius = 3, Z = 1, Shine = true })
	for _, x in ipairs({ 12, 80 }) do
		kit.Triangle(body, x + 4, 74, 8, 12, kit.Darken(wood, 0.2), 1) -- équerres
	end
	-- coupe d'or
	kit.Part(body, 12, 56, 26, 10, DARK, { Radius = 2, Z = 2 })
	kit.Part(body, 21, 44, 8, 14, C.Gold, { Radius = 3, Z = 2 })
	local cup = kit.Part(body, 10, 16, 30, 30, C.Gold, { Radius = 12, Z = 3, Shine = true })
	kit.Text(cup, "1", 15, 14, 16, rgb(160, 110, 40), 2)
	for _, side in ipairs({ -1, 1 }) do
		kit.Blob(body, 25 + side * 17, 26, 10, 14, C.Gold, { Z = 2, T = 1, Outline = C.Gold, Thickness = 3, Shade = false })
	end
	-- ballon doré sur socle
	kit.Part(body, 44, 58, 20, 8, DARK, { Radius = 2, Z = 2 })
	local ball = kit.Blob(body, 54, 46, 20, 20, C.Gold, { Z = 3, Shine = true })
	kit.Box(ball, 9.4, 1, 1.2, 18, rgb(180, 130, 40), 0, 2)
	kit.Box(ball, 1, 9.4, 18, 1.2, rgb(180, 130, 40), 0, 2)
	-- médaille d'argent sur ruban
	kit.Line(body, 76, 30, 82, 46, 4, RED, 0, 2)
	kit.Line(body, 88, 30, 82, 46, 4, BLUE, 0, 2)
	local medal = kit.Blob(body, 82, 52, 16, 16, CHROME, { Z = 3, Shine = true })
	kit.Sparkle(medal, 8, 8, 9, WHITE, 0, 2)
	-- étincelles
	for index, p in ipairs({ { 8, 12 }, { 46, 30 }, { 94, 20 } }) do
		local s = kit.Sparkle(body, p[1], p[2], 8, C.Butter, 0, 5)
		kit.Animate(s, "Pulse", 0.6, 1.2, index)
	end
	return { WallShadow = Vector2.new(92, 20) }
end

----------------------------------------------------------------------
-- 🏎️ Véhicules
----------------------------------------------------------------------

-- Monster truck télécommandé (grosses roues) + sa télécommande
Art.RCCar = function(body, kit, _item)
	local C = kit.C
	-- télécommande (derrière)
	local remote = kit.Part(body, 70, 34, 26, 30, DARK, { Radius = 6, Z = 1, Shine = true })
	kit.Line(body, 90, 34, 96, 8, 2, STEEL, 0, 1)
	kit.Circle(body, 96, 8, 4, 4, RED, 0, 1)
	kit.Circle(remote, 8, 12, 8, 8, DARKER, 0, 2)
	kit.Circle(remote, 18, 20, 8, 8, DARKER, 0, 2)
	-- carrosserie
	local cab = kit.Part(body, 22, 36, 38, 22, ORANGE, { Radius = 8, Z = 3, Shine = true })
	kit.Part(cab, 6, 4, 26, 10, rgb(170, 220, 255), { Radius = 4, Z = 2 })
	local car = kit.Part(body, 6, 50, 70, 22, ORANGE, { Radius = 8, Z = 4, Shine = true })
	flames(kit, car, 30, 2, 24, 16, 2)
	kit.Circle(car, 66, 8, 6, 6, C.Butter, 0, 3) -- phare
	-- grosses roues
	for _, x in ipairs({ 20, 62 }) do
		local w = kit.Blob(body, x, 80, 28, 28, DARKER, { Z = 5 })
		for k = 0, 5 do
			local a = k / 6 * math.pi * 2
			kit.Box(w, 14 + math.cos(a) * 12 - 2, 14 + math.sin(a) * 12 - 2, 4, 4, DARK, 0, 2)
		end
		local hub = kit.Circle(w, 14, 14, 12, 12, STEEL, 0, 3)
		local _ = hub
	end
	return nil
end

-- Garage à petites voitures (2 étages, rampe, ascenseur, voitures)
Art.ToyGarage = function(body, kit, _item)
	local C = kit.C
	local base = kit.Part(body, 4, 84, 92, 14, rgb(90, 96, 116), { Radius = 5, Z = 1, Shine = true })
	for index = 0, 3 do
		kit.Box(base, 10 + index * 22, 6, 10, 2, WHITE, 0.2, 2) -- marquage
	end
	-- étage + piliers
	for _, x in ipairs({ 10, 84 }) do
		kit.Part(body, x, 44, 6, 42, RED, { Radius = 2, Z = 2 })
	end
	kit.Part(body, 6, 40, 70, 8, rgb(236, 240, 248), { Radius = 3, Z = 3, Shine = true })
	-- rampe
	kit.Part(body, 50, 60, 52, 7, BLUE, { Radius = 3, Z = 4, Rotation = -22 })
	-- tour + ascenseur + panneau
	kit.Part(body, 76, 8, 16, 78, rgb(236, 240, 248), { Radius = 4, Z = 2 })
	local lift = kit.Part(body, 78, 30, 12, 10, C.Butter, { Radius = 2, Z = 3 })
	kit.Animate(lift, "Bob", 10, 0.8, 0)
	local sign = kit.Part(body, 8, 16, 58, 18, NAVY, { Radius = 5, Z = 3, Shine = true })
	kit.Text(sign, "GARAGE", 29, 9, 11, C.Butter, 2)
	-- voitures
	for _, spec in ipairs({ { 18, 32, RED, 4 }, { 40, 76, rgb(120, 220, 120), 5 }, { 60, 50, BLUE, 5 } }) do
		local car = kit.Part(body, spec[1], spec[2], 18, 8, spec[3], { Radius = 3, Z = spec[4], Shine = true, Thickness = 1.2 })
		kit.Box(car, 5, 1, 8, 3, rgb(200, 235, 255), 0, 2)
		kit.Circle(body, spec[1] + 4, spec[2] + 8, 5, 5, DARKER, 0, spec[4] + 1)
		kit.Circle(body, spec[1] + 14, spec[2] + 8, 5, 5, DARKER, 0, spec[4] + 1)
	end
	return nil
end

-- Tapis circuit (piste grise, ligne de départ à damier, petite voiture)
Art.RaceTrackRug = function(body, kit, _item)
	local C = kit.C
	local rug = kit.Blob(body, 50, 82, 98, 34, GREEN, { Z = 1, Shine = true })
	local track = kit.Blob(rug, 49, 17, 82, 26, rgb(96, 100, 116), { Z = 2, Outline = WHITE, Thickness = 2, Shade = false })
	kit.Blob(track, 41, 13, 46, 10, GREEN, { Z = 2, Outline = WHITE, Thickness = 1.5, Shade = false })
	-- tirets au milieu
	for index = 0, 3 do
		kit.Box(track, 20 + index * 12, 2.5, 6, 1.2, C.Butter, 0, 3)
		kit.Box(track, 20 + index * 12, 22.5, 6, 1.2, C.Butter, 0, 3)
	end
	-- ligne de départ à damier
	for row = 0, 2 do
		for col = 0, 1 do
			kit.Box(track, 68 + col * 2.5, 18 + row * 2.4, 2.5, 2.4, (row + col) % 2 == 0 and WHITE or DARKER, 0, 4)
		end
	end
	local car = kit.Part(rug, 20, 23, 12, 6, RED, { Radius = 3, Z = 5, Thickness = 1 })
	kit.Animate(car, "Drift", 6, 0.8, 0)
	kit.Triangle(rug, 88, 8, 8, 10, C.Butter, 4) -- petit cône
	return { Flat = true }
end

-- Moto chromée (réservoir rouge à flammes, moteur chromé, phare)
Art.Motorbike = function(body, kit, _item)
	local C = kit.C
	wheel(kit, body, 18, 76, 36, DARKER, CHROME, 1, 0.3)
	wheel(kit, body, 82, 76, 36, DARKER, CHROME, 1, 0.3)
	-- fourche + bras oscillant
	kit.Line(body, 82, 76, 70, 34, 4, CHROME, 0, 3)
	kit.Line(body, 18, 76, 44, 66, 4, DARK, 0, 3)
	-- moteur chromé + échappement
	local engine = kit.Part(body, 36, 54, 28, 22, CHROME, { Radius = 6, Z = 4, Shine = true })
	for index = 0, 2 do
		kit.Box(engine, 3, 4 + index * 5, 22, 2, STEEL, 0, 2)
	end
	kit.Line(body, 40, 76, 6, 70, 5, CHROME, 0, 2)
	kit.Blob(body, 6, 70, 8, 8, DARK, { Z = 3 })
	-- réservoir, selle, garde-boue
	local tank = kit.Part(body, 40, 36, 32, 20, RED, { Radius = 10, Z = 5, Shine = true })
	flames(kit, tank, 4, 4, 22, 14, 2)
	kit.Line(body, 18, 76, 28, 48, 4, DARK, 0, 3)
	kit.Part(body, 16, 42, 30, 10, DARKER, { Radius = 5, Z = 5, Shine = true })
	kit.Part(body, 4, 50, 22, 6, RED, { Radius = 3, Z = 2 })
	kit.Part(body, 72, 52, 22, 6, RED, { Radius = 3, Z = 2 })
	-- guidon + phare
	kit.Line(body, 70, 34, 60, 22, 3, CHROME, 0, 6)
	kit.Part(body, 56, 18, 10, 5, DARKER, { Radius = 2, Z = 7 })
	local lamp = kit.Blob(body, 78, 38, 14, 14, CHROME, { Z = 6, Shine = true })
	kit.Circle(lamp, 7, 7, 9, 9, C.Butter, 0, 2)
	return { Glow = rgb(255, 236, 170) }
end

return Art
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="17">
              <Properties>
                <string name="Name">Cozy91</string>
                <string name="Source"><![CDATA[--[[
	Cozy91 (ModuleScript) — (v9.1) nouveaux meubles et déco 🛋️🖼️
	Emplacement : ReplicatedStorage > Client > Components > House > Art > Cozy91
	Contrat : voir HouseArt (boîte 100 x 100, pieds en bas pour les objets au
	sol, objets muraux centrés). Les dessus où l'on pose des objets sont
	déclarés dans HouseSurfaces (coffre, étagère échelle, kotatsu, fauteuil
	cœur, canapé chat, hamac...).
]]

local Art = {}

local WHITE = Color3.new(1, 1, 1)

-- Petits pieds ronds en bois
local function feet(body, kit, xs, y, h, color)
	for _, x in ipairs(xs) do
		kit.Part(body, x - 4, y, 8, h, color, { Radius = 3, Z = 1 })
	end
end

-- Coffre à jouets : coffre rose à rayures, couvercle bombé entrouvert, jouets qui dépassent
Art.ToyChest = function(body, kit, _item)
	local C = kit.C
	local pink = Color3.fromRGB(255, 176, 206)
	feet(body, kit, { 18, 82 }, 90, 10, C.WoodDark)
	-- jouets qui dépassent
	kit.Blob(body, 30, 36, 18, 18, C.Sky, { Z = 1, Shine = true }) -- ballon
	kit.Box(body, 29, 27, 2, 18, WHITE, 0.3, 2)
	local bear = kit.Blob(body, 66, 34, 20, 18, C.Wood, { Z = 1 })
	kit.Face(bear, 10, 10, 12, { Z = 3 })
	kit.Circle(body, 58, 26, 8, 8, C.Wood, 0, 1)
	kit.Circle(body, 74, 26, 8, 8, C.Wood, 0, 1)
	local chest = kit.Part(body, 8, 44, 84, 48, pink, { Radius = 10, Z = 3, Shine = true })
	for index = 0, 3 do
		kit.Box(chest, 8 + index * 20, 0, 8, 48, WHITE, 0.55, 2)
	end
	kit.Part(body, 4, 32, 92, 16, kit.Darken(pink, 0.08), { Radius = 8, Z = 4 }) -- couvercle
	kit.Part(body, 42, 52, 16, 14, C.Butter, { Radius = 4, Z = 5 }) -- serrure
	kit.Heart(body, 50, 58, 8, C.PinkDeep, 0, 6)
	kit.Face(body, 50, 76, 22, { Eyes = "happy", Z = 6 })
	return nil
end

-- Pouf tout doux (rond, capitonné, petit pompon)
Art.Pouf = function(body, kit, _item)
	local C = kit.C
	local lilac = Color3.fromRGB(214, 190, 255)
	kit.Blob(body, 50, 76, 76, 44, lilac, { Z = 2, Shine = true, Shade = 0.16 })
	kit.Blob(body, 50, 60, 72, 22, kit.Lighten(lilac, 0.25), { Z = 3 })
	for _, x in ipairs({ 32, 50, 68 }) do
		kit.Circle(body, x, 80, 4, 4, kit.OutlineOf(lilac), 0.4, 4)
	end
	kit.Circle(body, 50, 56, 7, 7, C.Pink, 0, 4)
	kit.Face(body, 50, 78, 20, { Eyes = "closed", Z = 5 })
	return nil
end

-- Étagère échelle (3 tablettes : on y pose des objets)
Art.LadderShelf = function(body, kit, _item)
	local C = kit.C
	local wood = C.WoodLight
	kit.Line(body, 34, 4, 14, 99, 5, C.WoodDark, 0, 1)
	kit.Line(body, 66, 4, 86, 99, 5, C.WoodDark, 0, 1)
	for index, spot in ipairs({ { 26, 74, 12 }, { 18, 82, 42 }, { 10, 90, 72 } }) do
		local shelf = kit.Part(body, spot[1] - 2, spot[3], spot[2] - spot[1] + 4, 6, wood, { Radius = 2, Z = 2 })
		local _ = shelf
		-- petits pompons de décor sous les tablettes
		kit.Circle(body, spot[1] + 4, spot[3] + 9, 4, 4, index == 2 and C.Pink or C.Mint, 0, 2)
	end
	kit.Heart(body, 50, 92, 10, C.Pink, 0, 3)
	return nil
end

-- Table kotatsu (couette à carreaux, plateau en bois, clémentines)
Art.KotatsuTable = function(body, kit, _item)
	local C = kit.C
	local quilt = Color3.fromRGB(255, 196, 150)
	kit.Part(body, 2, 42, 96, 8, C.Wood, { Radius = 3, Z = 3, Shine = true }) -- plateau
	local blanket = kit.Part(body, 6, 48, 88, 48, quilt, { Radius = 12, Z = 2, Shade = 0.18 })
	for index = 0, 3 do
		kit.Box(blanket, 0, 8 + index * 11, 88, 3, C.Red, 0.55, 2)
	end
	for index = 0, 4 do
		kit.Box(blanket, 8 + index * 18, 0, 3, 48, C.Red, 0.55, 2)
	end
	kit.Blob(body, 12, 94, 18, 10, quilt, { Z = 2 }) -- coin qui retombe
	kit.Blob(body, 88, 94, 18, 10, quilt, { Z = 2 })
	kit.Face(body, 50, 72, 22, { Eyes = "closed", Z = 4 })
	return nil
end

-- Fauteuil cœur (dossier en cœur rose, coussin, pieds dorés)
Art.HeartArmchair = function(body, kit, _item)
	local C = kit.C
	local pink = Color3.fromRGB(255, 140, 186)
	feet(body, kit, { 22, 78 }, 88, 12, C.Gold)
	kit.Heart(body, 50, 38, 84, kit.OutlineOf(pink), 0, 1)
	kit.Heart(body, 50, 38, 78, pink, 0, 2)
	kit.Shine(body, 24, 18, 14, 6, 3, 0.4)
	local seat = kit.Part(body, 14, 62, 72, 28, kit.Lighten(pink, 0.15), { Radius = 12, Z = 4, Shine = true })
	kit.Part(seat, 6, 2, 60, 10, kit.Lighten(pink, 0.45), { Radius = -1, Z = 2 })
	for _, x in ipairs({ 6, 76 }) do
		kit.Part(body, x, 50, 18, 40, kit.Darken(pink, 0.06), { Radius = 9, Z = 5 })
	end
	kit.Heart(body, 50, 76, 12, WHITE, 0, 5)
	return nil
end

-- Hamac à rayures entre deux poteaux, qui se balance doucement
Art.Hammock = function(body, kit, _item)
	local C = kit.C
	kit.Part(body, 6, 20, 8, 80, C.WoodDark, { Radius = 3, Z = 1 })
	kit.Part(body, 86, 20, 8, 80, C.WoodDark, { Radius = 3, Z = 1 })
	kit.Blob(body, 10, 18, 12, 8, C.Leaf, { Z = 2 })
	kit.Blob(body, 90, 18, 12, 8, C.Leaf, { Z = 2 })
	local swing = kit.Pivot(body, 50, 28, 3)
	kit.Animate(swing, "Sway", 3, 0.5, 0.2)
	kit.Line(swing, -40, 0, -26, 30, 2, C.Brown, 0, 1)
	kit.Line(swing, 40, 0, 26, 30, 2, C.Brown, 0, 1)
	local bed = kit.Part(swing, -34, 24, 68, 24, C.Mint, { Radius = 12, Z = 2, Shade = 0.2 })
	for index = 0, 3 do
		kit.Box(bed, 4 + index * 16, 0, 7, 24, C.Butter, 0.25, 2)
	end
	kit.Blob(swing, -20, 30, 18, 12, C.PinkSoft, { Z = 3, Shine = true }) -- coussin
	kit.Heart(swing, -20, 30, 8, C.Pink, 0, 4)
	return nil
end

-- Canapé chat (oreilles, moustaches, pattes, queue)
Art.CatSofa = function(body, kit, _item)
	local C = kit.C
	local fur = Color3.fromRGB(255, 214, 180)
	feet(body, kit, { 16, 84 }, 90, 10, C.WoodDark)
	-- oreilles
	for _, side in ipairs({ -1, 1 }) do
		local ear = kit.Part(body, 50 + side * 26 - 10, 6, 20, 20, fur, { Radius = 5, Z = 1, Rotation = 45 })
		kit.Part(ear, 5, 5, 10, 10, C.Pink, { Radius = 3, Z = 2, Outline = false, Shade = false })
	end
	local back = kit.Part(body, 10, 16, 80, 54, fur, { Radius = 28, Z = 2, Shine = true })
	kit.Face(back, 40, 22, 26, { Mouth = "cat", Z = 3 })
	for _, side in ipairs({ -1, 1 }) do
		for k = 0, 1 do
			kit.Line(back, 40 + side * 16, 26 + k * 4, 40 + side * 30, 24 + k * 7, 1.2, kit.OutlineOf(fur), 0.2, 3)
		end
	end
	local seat = kit.Part(body, 8, 62, 84, 28, kit.Lighten(fur, 0.2), { Radius = 12, Z = 4, Shine = true })
	local _ = seat
	-- pattes (accoudoirs)
	for _, x in ipairs({ 2, 78 }) do
		local paw = kit.Part(body, x, 50, 20, 40, fur, { Radius = 10, Z = 5 })
		for toe = 0, 2 do
			kit.Circle(paw, 5 + toe * 5, 34, 4, 4, C.Pink, 0.2, 2)
		end
	end
	local tail = kit.Pivot(body, 90, 70, 0)
	kit.Blob(tail, 4, -14, 10, 30, fur, { Rotation = 20 })
	kit.Animate(tail, "Sway", 8, 0.6, 0.5)
	return nil
end

-- Trône de cristal (dossier en éventail de cristaux, coussin royal)
Art.CrystalThrone = function(body, kit, _item)
	local C = kit.C
	local crystal = Color3.fromRGB(196, 226, 255)
	local lilac = Color3.fromRGB(214, 190, 255)
	for index = -3, 3 do
		local h = 60 - math.abs(index) * 8
		local shard = kit.Part(body, 50 + index * 11 - 6, 64 - h, 12, h, index % 2 == 0 and crystal or lilac, { Radius = 5, Z = 1 + (3 - math.abs(index)), Shine = true })
		local _ = shard
		kit.Diamond(body, 50 + index * 11, 64 - h, 12, index % 2 == 0 and crystal or lilac, 0, 1 + (3 - math.abs(index)))
	end
	kit.Part(body, 16, 58, 68, 30, C.Gold, { Radius = 10, Z = 6, Shine = true })
	kit.Part(body, 20, 54, 60, 16, C.PinkSoft, { Radius = -1, Z = 7, Shine = true })
	for _, x in ipairs({ 10, 74 }) do
		kit.Part(body, x, 50, 16, 40, crystal, { Radius = 8, Z = 8, Shine = true })
	end
	feet(body, kit, { 22, 78 }, 88, 12, C.Gold)
	kit.Heart(body, 50, 76, 12, C.Heart, 0, 8)
	for index, spot in ipairs({ { 20, 10 }, { 82, 16 }, { 50, 2 } }) do
		local sparkle = kit.Sparkle(body, spot[1], spot[2], 12, WHITE, 0, 9)
		kit.Animate(sparkle, "Pulse", 0.7, 1.3, index)
	end
	return { Glow = Color3.fromRGB(200, 220, 255) }
end

-- Tapis cœur (à plat, bordure festonnée)
Art.HeartRug = function(body, kit, _item)
	local C = kit.C
	local flat = kit.Group(body, 0, 60, 100, 40, 1)
	kit.Blob(flat, 50, 20, 96, 38, C.Pink, { Z = 1, Shade = false })
	kit.Blob(flat, 50, 20, 84, 30, C.PinkSoft, { Z = 2, Outline = false, Shade = false })
	kit.Heart(flat, 50, 20, 26, C.Heart, 0, 3)
	for index = 0, 6 do
		kit.Circle(flat, 14 + index * 12, 36, 6, 4, WHITE, 0.2, 3)
	end
	return { Flat = true }
end

-- Guirlande d'étoiles (fil qui ondule, étoiles qui scintillent)
Art.StarGarland = function(body, kit, _item)
	local C = kit.C
	local bulbs = {}
	local colors = { C.Butter, C.Pink, C.Sky, C.Lilac, C.Mint }
	for index = 0, 6 do
		local x = 6 + index * 14.6
		local y = 38 + math.sin(index / 6 * math.pi) * 18
		if index > 0 then
			local px = 6 + (index - 1) * 14.6
			local py = 38 + math.sin((index - 1) / 6 * math.pi) * 18
			kit.Line(body, px, py, x, y, 1.5, C.GreyDark, 0, 1)
		end
		local color = colors[index % #colors + 1]
		local halo = kit.Circle(body, x, y + 10, 20, 20, color, 0.6, 1)
		local star = kit.Sparkle(body, x, y + 10, 16, color, 0, 2)
		kit.Diamond(body, x, y + 10, 8, WHITE, 0.3, 3)
		star:SetAttribute("Phase", index * 1.1)
		local core = star:FindFirstChildWhichIsA("Frame")
		if core then
			core:SetAttribute("Phase", index * 1.1)
			table.insert(bulbs, core)
			table.insert(bulbs, halo)
		end
	end
	return { Bulbs = bulbs, WallShadow = Vector2.new(0, 0) }
end

-- Horloge chat (tête de chat, yeux qui suivent le balancier-queue)
Art.KittyClock = function(body, kit, _item)
	local C = kit.C
	local black = Color3.fromRGB(96, 84, 120)
	for _, side in ipairs({ -1, 1 }) do
		local ear = kit.Part(body, 50 + side * 20 - 9, 10, 18, 18, black, { Radius = 4, Z = 1, Rotation = 45 })
		kit.Part(ear, 4, 4, 10, 10, C.Pink, { Radius = 3, Z = 2, Outline = false, Shade = false })
	end
	local head = kit.Blob(body, 50, 38, 60, 50, black, { Z = 2, Shine = true })
	local dial = kit.Blob(head, 30, 28, 34, 34, C.Cream, { Z = 2 })
	for index = 0, 3 do
		local a = index * math.pi / 2
		kit.Circle(dial, 17 + math.sin(a) * 12, 17 - math.cos(a) * 12, 3, 3, C.Ink, 0, 3)
	end
	local hands = kit.Pivot(dial, 17, 17, 4)
	kit.Box(hands, -1, -11, 2, 11, C.Ink, 0, 1)
	kit.Box(hands, -1, -1, 8, 2, C.Ink, 0, 1)
	kit.Animate(hands, "Spin", 1, 0.05, 0)
	kit.Circle(dial, 17, 17, 4, 4, C.Pink, 0, 5)
	kit.Face(head, 30, 12, 26, { Mouth = "none", Color = C.Butter, Z = 4 })
	local tail = kit.Pivot(body, 50, 60, 1)
	kit.Blob(tail, 0, 18, 10, 36, black, { Z = 1 })
	kit.Circle(tail, 0, 34, 12, 12, C.Pink, 0, 2)
	kit.Animate(tail, "Sway", 14, 1.4, 0)
	return { WallShadow = Vector2.new(0.6, 0.7) }
end

-- Tapisserie arc-en-ciel (tissage à franges sur un bâton)
Art.Tapestry = function(body, kit, _item)
	local C = kit.C
	kit.Line(body, 14, 14, 86, 14, 5, C.WoodDark, 0, 3)
	kit.Line(body, 40, 14, 50, 4, 1.5, C.Brown, 0, 1)
	kit.Line(body, 60, 14, 50, 4, 1.5, C.Brown, 0, 1)
	local cloth = kit.Part(body, 20, 14, 60, 62, C.Cream, { Radius = 4, Z = 2 })
	local colors = { C.Red, C.Orange, C.Yellow, C.Leaf, C.Sky, C.Lilac }
	for index, color in ipairs(colors) do
		local arc = kit.Circle(cloth, 30, 56, 56 - index * 7, 56 - index * 7, color, 1, 2)
		kit.Stroke(arc, color, 3.2, 0)
	end
	kit.Box(cloth, 0, 56, 60, 6, C.Cream, 0, 3)
	kit.Cloud(cloth, 12, 58, 18, WHITE, 0, 4)
	kit.Cloud(cloth, 48, 58, 18, WHITE, 0, 4)
	for index = 0, 9 do
		kit.Line(body, 23 + index * 6, 76, 23 + index * 6, 88 + (index % 2) * 3, 2, colors[index % #colors + 1], 0, 1)
	end
	return { WallShadow = Vector2.new(0.6, 0.75) }
end

-- Papillons encadrés (cadre doré, trois papillons qui battent des ailes)
Art.ButterflyFrame = function(body, kit, _item)
	local C = kit.C
	local frame = kit.Part(body, 12, 16, 76, 68, C.Gold, { Radius = 8, Z = 1, Shine = true })
	kit.Part(frame, 6, 6, 64, 56, C.MintSoft, { Radius = 5, Z = 2, Outline = false })
	for index, b in ipairs({ { 34, 36, C.Pink }, { 62, 30, C.Sky }, { 50, 60, C.Butter } }) do
		local fly = kit.Pivot(body, b[1], b[2], 3)
		for _, side in ipairs({ -1, 1 }) do
			local wing = kit.Blob(fly, side * 6, -3, 12, 14, b[3], { Z = 1, Thickness = 1.2 })
			kit.Circle(wing, 6, 6, 4, 4, WHITE, 0.3, 2)
			kit.Blob(fly, side * 5, 6, 8, 8, kit.Darken(b[3], 0.1), { Z = 1, Thickness = 1.2 })
		end
		kit.Part(fly, -1.5, -8, 3, 18, C.Ink, { Radius = 1, Z = 2, Outline = false, Shade = false })
		kit.Animate(fly, "Breathe", 0.08, 2, index)
	end
	return { WallShadow = Vector2.new(0.76, 0.7) }
end

-- Tapis nuage (à plat, tout doux, petites étoiles)
Art.CloudRug = function(body, kit, _item)
	local C = kit.C
	local flat = kit.Group(body, 0, 58, 100, 42, 1)
	local sky = Color3.fromRGB(214, 236, 255)
	for _, b in ipairs({ { 24, 24, 40 }, { 50, 18, 50 }, { 76, 24, 40 }, { 50, 28, 90 } }) do
		kit.Blob(flat, b[1], b[2], b[3], b[3] * 0.5, sky, { Z = 1, Shade = false, Thickness = 1.4 })
	end
	for _, b in ipairs({ { 24, 24, 34 }, { 50, 18, 44 }, { 76, 24, 34 }, { 50, 28, 82 } }) do
		kit.Blob(flat, b[1], b[2], b[3], b[3] * 0.44, WHITE, { Z = 2, Outline = false, Shade = false })
	end
	for index, x in ipairs({ 30, 52, 72 }) do
		kit.Sparkle(flat, x, 24 + (index % 2) * 4, 8, C.Butter, 0, 3)
	end
	return { Flat = true }
end

-- Mannequin de couture (robe rose en cours, mètre ruban, épingles)
Art.Mannequin = function(body, kit, _item)
	local C = kit.C
	kit.Line(body, 50, 70, 50, 94, 3, C.WoodDark, 0, 1)
	for _, side in ipairs({ -1, 1 }) do
		kit.Line(body, 50, 92, 50 + side * 18, 99, 3, C.WoodDark, 0, 1)
	end
	kit.Blob(body, 50, 6, 10, 8, C.WoodDark, { Z = 1 })
	local torso = kit.Part(body, 32, 8, 36, 40, C.Cream, { Radius = 14, Z = 2, Shine = true })
	local _ = torso
	-- robe
	kit.Part(body, 34, 26, 32, 18, C.Pink, { Radius = 6, Z = 3 })
	kit.Triangle(body, 50, 38, 56, 38, C.Pink, 3)
	for index = 0, 3 do
		kit.Circle(body, 30 + index * 13, 76, 12, 8, C.PinkSoft, 0, 4)
	end
	kit.Heart(body, 50, 32, 10, WHITE, 0, 4)
	-- mètre ruban
	kit.Line(body, 34, 14, 56, 44, 2.5, C.Butter, 0, 5)
	kit.Line(body, 56, 44, 60, 60, 2.5, C.Butter, 0, 5)
	for index = 0, 2 do
		kit.Circle(body, 60 + index * 4, 18 + index * 3, 3, 3, C.Red, 0, 5)
	end
	return nil
end

-- Harpe dorée (cordes qui vibrent, notes de musique)
Art.Harp = function(body, kit, _item)
	local C = kit.C
	kit.Part(body, 22, 88, 56, 12, C.Gold, { Radius = 5, Z = 1 })
	kit.Line(body, 26, 90, 26, 22, 7, C.Gold, 0, 2)
	kit.Line(body, 26, 22, 78, 40, 7, C.Gold, 0, 2)
	kit.Line(body, 78, 40, 72, 90, 8, kit.Darken(C.Gold, 0.1), 0, 2)
	kit.Blob(body, 26, 18, 14, 14, C.Gold, { Z = 3, Shine = true })
	kit.Heart(body, 26, 18, 8, C.Pink, 0, 4)
	for index = 0, 6 do
		local x = 32 + index * 6
		local top = 24 + index * 2.4
		local string = kit.Line(body, x, top, x, 86, 1.4, Color3.fromRGB(255, 236, 190), 0, 1)
		kit.Animate(string, "Drift", 0.6, 3, index)
	end
	for index, note in ipairs({ { 86, 24 }, { 12, 44 } }) do
		local label = kit.Text(body, index == 1 and "🎵" or "🎶", note[1], note[2], 14, C.PinkDeep, 5)
		kit.Animate(label, "Bob", 3, 0.8, index)
	end
	return { Glow = Color3.fromRGB(255, 230, 160) }
end

-- Statue de cygne (marbre, couronne, sur un socle)
Art.SwanStatue = function(body, kit, _item)
	local C = kit.C
	local marble = Color3.fromRGB(250, 248, 255)
	kit.Part(body, 18, 84, 64, 16, Color3.fromRGB(226, 220, 244), { Radius = 5, Z = 1, Shine = true })
	kit.Blob(body, 56, 68, 56, 30, marble, { Z = 2, Shine = true })
	kit.Blob(body, 66, 60, 34, 22, kit.Darken(marble, 0.04), { Z = 3, Rotation = -20 }) -- aile
	kit.Line(body, 34, 64, 32, 30, 9, marble, 0, 3)
	kit.Blob(body, 36, 26, 18, 14, marble, { Z = 4, Shine = true })
	kit.Circle(body, 38, 24, 3, 3, C.Ink, 0, 5)
	kit.Part(body, 22, 26, 10, 6, C.Orange, { Radius = 3, Z = 5, Rotation = -12 })
	kit.Circle(body, 42, 28, 5, 3, C.Blush, 0.3, 5)
	for index = -1, 1 do
		kit.Diamond(body, 36 + index * 5, 16, 5, C.Gold, 0, 5)
	end
	local sparkle = kit.Sparkle(body, 80, 40, 12, C.Butter, 0, 6)
	kit.Animate(sparkle, "Pulse", 0.6, 1, 0.4)
	return nil
end

-- Couronne sur un coussin de velours (brille)
Art.CrownCushion = function(body, kit, _item)
	local C = kit.C
	local velvet = Color3.fromRGB(200, 110, 190)
	kit.Blob(body, 50, 84, 84, 30, velvet, { Z = 1, Shine = true })
	for _, x in ipairs({ 10, 90 }) do
		kit.Circle(body, x, 90, 10, 10, C.Gold, 0, 2) -- glands
	end
	local crown = kit.Group(body, 0, 0, 100, 100, 3)
	kit.Animate(crown, "Bob", 1.5, 0.8, 0)
	kit.Part(crown, 24, 52, 52, 20, C.Gold, { Radius = 4, Z = 1, Shine = true })
	for index = 0, 2 do
		kit.Triangle(crown, 30 + index * 20, 32, 18, 24, C.Gold, 1)
		kit.Circle(crown, 30 + index * 20, 32, 7, 7, index == 1 and C.Pink or C.Sky, 0, 2)
	end
	for index, color in ipairs({ C.Red, C.Sky, C.Mint }) do
		kit.Diamond(crown, 34 + (index - 1) * 16, 62, 8, color, 0, 2)
	end
	for index, spot in ipairs({ { 16, 30 }, { 86, 40 } }) do
		local sparkle = kit.Sparkle(body, spot[1], spot[2], 12, WHITE, 0, 5)
		kit.Animate(sparkle, "Pulse", 0.7, 1.2, index)
	end
	return { Glow = Color3.fromRGB(255, 226, 150) }
end

return Art
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="18">
              <Properties>
                <string name="Name">Critters</string>
                <string name="Source"><![CDATA[--[[
	Critters (ModuleScript) — nouveaux animaux 🐾 (v9) : chaton calico, hérisson
	Emplacement : ReplicatedStorage > Client > Components > House > Art > Critters
	Contrat : voir HouseArt et Art/Pets : les parties "animal" sont dans des
	groupes dont le nom commence par "Pet" (le reste = sa maison : coussin,
	tas de feuilles) ; "PetWalk" (caché) = pose debout pour marcher.
	Petits : on peut les poser sur le lit, le canapé, une chaise... (ils y
	font la sieste, sautent en bas, se promènent et y reviennent).
]]

local Art = {}

-- Conteneur qui respire : UIScale autour du bas-centre (les pattes restent au sol)
local function breather(parent, kit, x, y, w, h, z)
	local g = kit.Group(parent, x, y, w, h, z)
	g.AnchorPoint = Vector2.new(0.5, 1)
	g.Position = UDim2.fromOffset(x + w / 2, y + h)
	return g
end

-- Oreille pointue (carré arrondi tourné) avec intérieur rose
local function ear(parent, kit, cx, cy, size, color, inner, tilt, z)
	local frame = kit.Part(parent, cx - size / 2, cy - size / 2, size, size, color, {
		Radius = size * 0.24,
		Rotation = 45 + tilt,
		Z = z,
		Shade = false,
	})
	kit.Part(frame, size * 0.2, size * 0.2, size * 0.46, size * 0.46, inner, {
		Radius = size * 0.14,
		Z = 2,
		Outline = false,
		Shade = false,
	})
	return frame
end

-- Chaton calico roulé en boule sur son coussin cœur (se réveille pour se promener)
Art.Kitten = function(body, kit, _item)
	local C = kit.C
	local fur = Color3.fromRGB(255, 250, 246)
	local orange = Color3.fromRGB(255, 176, 108)
	local dark = Color3.fromRGB(120, 96, 110)
	-- coussin cœur (sa maison)
	kit.Heart(body, 50, 74, 64, kit.Darken(C.Pink, 0.12), 0, 1)
	kit.Blob(body, 50, 86, 92, 24, C.PinkSoft, { Z = 2, Shine = true })
	for index = 0, 4 do
		kit.Circle(body, 18 + index * 16, 97, 8, 5, C.White, 0.1, 2)
	end
	-- chaton endormi
	local cat = breather(body, kit, 0, 0, 100, 84, 3)
	cat.Name = "Pet"
	kit.Blob(cat, 58, 66, 56, 30, fur, { Z = 2, Shine = true })
	kit.Blob(cat, 66, 60, 20, 14, orange, { Z = 3, Outline = false, Shade = false })
	kit.Blob(cat, 50, 72, 14, 9, dark, { Z = 3, Outline = false, Shade = false })
	ear(cat, kit, 22, 50, 12, fur, C.Pink, -22, 1)
	ear(cat, kit, 40, 47, 12, orange, C.Pink, 10, 1)
	local head = kit.Blob(cat, 32, 63, 34, 28, fur, { Z = 4, Shine = true })
	kit.Blob(head, 24, 7, 12, 9, orange, { Z = 2, Outline = false, Shade = false })
	kit.Blob(head, 7, 9, 9, 7, dark, { Z = 2, Outline = false, Shade = false })
	kit.Face(cat, 32, 65, 22, { Eyes = "closed", Mouth = "cat", Z = 6 })
	kit.Animate(cat, "Breathe", 0.035, 0.6, 0.4)
	-- pattes et queue devant le coussin
	local front = kit.Group(body, 0, 0, 100, 100, 7)
	front.Name = "PetFront"
	for _, x in ipairs({ 30, 41 }) do
		kit.Blob(front, x, 76, 9, 6, C.White, { Z = 2, Thickness = 1.2 })
	end
	local tail = kit.Pivot(front, 84, 72, 2)
	tail.Name = "Tail"
	kit.Blob(tail, 2, 8, 8, 20, orange, { Rotation = -14, Thickness = 1.4 })
	kit.Animate(tail, "Sway", 6, 0.5, 1.1)
	local zzz = kit.Text(front, "z", 64, 36, 12, C.Lilac, 3)
	kit.Animate(zzz, "Bob", 2, 0.6, 0.3)
	-- pose debout (cachée) tournée vers la droite
	local walk = kit.Group(body, 0, 0, 100, 100, 9)
	walk.Name = "PetWalk"
	walk.Visible = false
	local wtail = kit.Pivot(walk, 30, 70, 1)
	kit.Blob(wtail, -5, -13, 8, 28, orange, { Rotation = -20, Thickness = 1.4 })
	kit.Animate(wtail, "Sway", 10, 1, 0.2)
	for index, x in ipairs({ 36, 45, 60, 69 }) do
		local leg = kit.Part(walk, x - 4.5, 82, 9, 16, index == 2 and orange or fur, { Radius = 4, Z = 1, Thickness = 1.3 })
		kit.Blob(leg, 4.5, 14, 10, 5, C.White, { Z = 2, Thickness = 1, Shade = false })
	end
	kit.Blob(walk, 52, 76, 48, 26, fur, { Z = 2, Shine = true })
	kit.Blob(walk, 44, 70, 16, 12, orange, { Z = 3, Outline = false, Shade = false })
	kit.Blob(walk, 58, 82, 12, 8, dark, { Z = 3, Outline = false, Shade = false })
	ear(walk, kit, 64, 46, 12, fur, C.Pink, -16, 3)
	ear(walk, kit, 84, 47, 12, orange, C.Pink, 18, 3)
	local whead = kit.Blob(walk, 74, 60, 32, 28, fur, { Z = 4, Shine = true })
	kit.Blob(whead, 24, 8, 12, 9, orange, { Z = 2, Outline = false, Shade = false })
	kit.Face(walk, 76, 62, 22, { Mouth = "cat", Z = 6 })
	kit.Animate(walk, "Breathe", 0.02, 1.2, 0.2)
	return nil
end

-- Hérisson sur son petit tas de feuilles (il trottine, renifle, mange)
Art.Hedgehog = function(root, kit, _item)
	local C = kit.C
	-- tas de feuilles (sa maison)
	for index, leaf in ipairs({ { 22, 92, -24, C.Orange }, { 44, 94, 8, C.Butter }, { 66, 92, 26, C.Red }, { 80, 95, -10, C.Leaf } }) do
		kit.Blob(root, leaf[1], leaf[2], 26, 11, leaf[4], { Z = 1, Rotation = leaf[3], Thickness = 1.2 })
		kit.Line(root, leaf[1] - 8, leaf[2], leaf[1] + 8, leaf[2], 1.2, kit.Darken(leaf[4], 0.3), 0.3, 2)
		if index == 2 then
			kit.Circle(root, 60, 86, 9, 9, C.Red, 0, 3) -- petite pomme
		end
	end
	local body = kit.Group(root, 0, 0, 100, 100, 3)
	body.Name = "Pet"
	local spines = Color3.fromRGB(150, 110, 86)
	local cream = Color3.fromRGB(255, 232, 206)
	local hog = breather(body, kit, 0, 0, 100, 96, 1)
	-- piquants (losanges en couronne)
	for index = 0, 9 do
		local a = math.pi * (0.1 + index * 0.09)
		local x = 58 - math.cos(a) * 30
		local y = 70 - math.sin(a) * 30
		kit.Diamond(hog, x, y, 14, index % 2 == 0 and spines or kit.Darken(spines, 0.15), 0, 1)
	end
	kit.Blob(hog, 58, 70, 60, 44, spines, { Z = 2, Shine = true })
	-- visage (tourné vers la gauche)
	local face = kit.Blob(hog, 34, 72, 38, 32, cream, { Z = 3, Shine = true })
	kit.Blob(hog, 16, 76, 12, 9, cream, { Z = 4, Thickness = 1.2 }) -- museau
	kit.Circle(hog, 11, 75, 6, 5, C.Ink, 0, 5) -- truffe
	kit.Circle(face, 17, 12, 5, 6, C.Ink, 0, 3)
	kit.Circle(face, 16, 10.5, 2, 2, C.White, 0, 4)
	kit.Circle(face, 22, 20, 8, 5, C.Blush, 0.35, 3)
	ear(hog, kit, 44, 56, 10, cream, C.PinkSoft, 0, 2)
	for _, x in ipairs({ 36, 64 }) do
		kit.Blob(hog, x, 94, 11, 7, cream, { Z = 4, Thickness = 1.2 })
	end
	kit.Animate(hog, "Breathe", 0.03, 1, 0.8)
	return nil
end

return Art
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="19">
              <Properties>
                <string name="Name">Decor</string>
                <string name="Source"><![CDATA[--[[
	Decor (ModuleScript) — dessins 🖼️ déco
	Emplacement : ReplicatedStorage > Client > Components > House > Art > Decor
	Contrat : voir HouseArt (boîte 100 x 100, pieds en bas pour les objets au sol).
]]

local Art = {}

----------------------------------------------------------------------
-- Petits outils partagés
----------------------------------------------------------------------

-- Étoile dodue à 5 branches (5 pilules + un rond) ; renvoie son conteneur
local function star(kit, parent, cx, cy, r, color, z, t)
	local holder = kit.Group(parent, cx - r, cy - r, r * 2, r * 2, z)
	local th = r * 0.42
	local len = r - th / 2
	for i = 0, 4 do
		local a = math.rad(-90 + i * 72)
		kit.Line(holder, r, r, r + math.cos(a) * len, r + math.sin(a) * len, th, color, t, 1)
	end
	kit.Circle(holder, r, r, r * 0.95, r * 0.95, color, t, 1)
	return holder
end

-- Étoile avec contour (une étoile foncée un peu plus grande derrière)
local function outlinedStar(kit, parent, cx, cy, r, color, z)
	local holder = kit.Group(parent, cx - r - 2, cy - r - 2, r * 2 + 4, r * 2 + 4, z)
	star(kit, holder, r + 2, r + 2, r + 1.6, kit.OutlineOf(color), 1)
	star(kit, holder, r + 2, r + 2, r, color, 2)
	return holder
end

-- Croissant de lune (pilules qui s'affinent le long d'un arc, ouvert vers la droite)
local function crescent(kit, parent, cx, cy, r, color, z, count)
	local holder = kit.Group(parent, cx - r, cy - r, r * 2, r * 2, z)
	local n = count or 12
	for i = 0, n - 1 do
		local k0, k1 = i / n * 2 - 1, (i + 1) / n * 2 - 1
		local km = (k0 + k1) / 2
		local th = r * (0.84 - 0.68 * math.abs(km) ^ 1.5)
		local dist = r - th / 2 -- tangent au bord extérieur
		local a0, a1 = math.rad(k0 * 148), math.rad(k1 * 148)
		kit.Line(holder, r - math.cos(a0) * dist, r + math.sin(a0) * dist, r - math.cos(a1) * dist, r + math.sin(a1) * dist, th, color, 0, 1)
	end
	return holder
end

-- Triangle rectangle net (carré tourné dans un cadre qui découpe) ;
-- `corner` = coin de l'angle droit rempli : "TL", "TR", "BL", "BR"
local function wedge(kit, parent, x, y, w, h, corner, color, t, z)
	local clip = kit.Group(parent, x, y, w, h, z, true)
	local rx = if corner == "TL" or corner == "BL" then 0 else w
	local ry = if corner == "TL" or corner == "TR" then 0 else h
	local x1, y1 = w - rx, ry
	local x2, y2 = rx, h - ry
	local mx, my = (x1 + x2) / 2, (y1 + y2) / 2
	local len = math.sqrt((x2 - x1) ^ 2 + (y2 - y1) ^ 2)
	local dx, dy = (x2 - x1) / len, (y2 - y1) / len
	local nx, ny = -dy, dx
	if nx * (rx - mx) + ny * (ry - my) < 0 then
		nx, ny = -nx, -ny
	end
	local s = (w + h) * 2
	local square = kit.Box(clip, 0, 0, s, s, color, t, 1)
	square.AnchorPoint = Vector2.new(0.5, 0.5)
	square.Position = UDim2.fromOffset(mx + nx * s / 2, my + ny * s / 2)
	square.Rotation = math.deg(math.atan2(dy, dx))
	return clip
end

-- Fanion pointe en bas, bords nets (2 demi-triangles)
local function pennant(kit, parent, cx, top, w, h, color, z)
	local holder = kit.Group(parent, cx - w / 2, top, w, h, z)
	wedge(kit, holder, 0, 0, w / 2 + 0.3, h, "TR", color, 0, 1)
	wedge(kit, holder, w / 2 - 0.3, 0, w / 2 + 0.3, h, "TL", color, 0, 1)
	return holder
end

-- Petit nœud (2 boucles + nœud central)
local function bow(kit, parent, cx, cy, w, color, z)
	local holder = kit.Group(parent, cx - w / 2, cy - w / 2, w, w, z)
	kit.Blob(holder, w * 0.27, w * 0.5, w * 0.5, w * 0.42, color, { Rotation = -12, Z = 1, Thickness = 1.2 })
	kit.Blob(holder, w * 0.73, w * 0.5, w * 0.5, w * 0.42, color, { Rotation = 12, Z = 1, Thickness = 1.2 })
	kit.Blob(holder, w * 0.5, w * 0.5, w * 0.26, w * 0.3, kit.Darken(color, 0.08), { Z = 2, Thickness = 1.2 })
	return holder
end

-- Clou + ficelle en V pour accrocher un cadre
local function hanger(kit, parent, cx, nailY, x1, x2, attachY, z)
	local C = kit.C
	kit.Line(parent, x1, attachY, cx, nailY, 1.2, C.WoodDark, 0, z)
	kit.Line(parent, cx, nailY, x2, attachY, 1.2, C.WoodDark, 0, z)
	kit.Circle(parent, cx, nailY, 4.5, 4.5, C.GreyDark, 0, (z or 1) + 1)
end

-- Fil qui pend en arc (segments) ; renvoie la fonction y(x)
local function sagString(kit, parent, x1, x2, y0, sag, segments, color, thick, z)
	local function yAt(x)
		local k = (x - x1) / (x2 - x1)
		return y0 + math.sin(k * math.pi) * sag
	end
	local step = (x2 - x1) / segments
	for i = 0, segments - 1 do
		local a = x1 + i * step
		local b = a + step
		kit.Line(parent, a, yAt(a), b, yAt(b), thick, color, 0, z)
	end
	return yAt
end

----------------------------------------------------------------------
-- Dessins
----------------------------------------------------------------------

-- Tapis tricoté : ovale à anneaux pastel, points de tricot, franges et pelote
Art.KnittedRug = function(body, kit, _item)
	local C = kit.C
	local rose = Color3.fromRGB(255, 160, 196)
	-- franges aux deux bouts
	for _, side in ipairs({ -1, 1 }) do
		for i = -2, 2 do
			local a = math.rad(i * 14)
			local x = 50 + side * 49 * math.cos(a)
			local y = 84 + 15 * math.sin(a)
			kit.Line(body, x, y, x + side * 6, y + 1, 2, C.Cream, 0, 1)
		end
	end
	kit.Blob(body, 50, 84, 100, 30, rose, { Z = 2, Shade = 0.08 })
	kit.Blob(body, 50, 84, 82, 23, C.Cream, { Z = 3, Outline = false, Shade = false })
	kit.Blob(body, 50, 84, 66, 18, Color3.fromRGB(170, 230, 205), { Z = 4, Outline = false, Shade = false })
	kit.Blob(body, 50, 84, 46, 12, Color3.fromRGB(210, 190, 250), { Z = 5, Outline = false, Shade = false })
	kit.Blob(body, 50, 84, 26, 6.5, C.PinkSoft, { Z = 6, Outline = false, Shade = false })
	-- points de tricot sur l'anneau extérieur
	for i = 0, 13 do
		local a = i / 14 * math.pi * 2
		kit.Circle(body, 50 + math.cos(a) * 45.5, 84 + math.sin(a) * 13.3, 3, 1.8, C.White, 0.35, 3)
	end
	-- pelote de laine et aiguilles
	kit.Line(body, 70, 84, 80, 78, 1.2, C.PinkDeep, 0.2, 7)
	kit.Line(body, 76, 64, 92, 76, 1.6, C.WoodLight, 0, 7)
	kit.Line(body, 90, 63, 78, 78, 1.6, C.WoodLight, 0, 7)
	local ball = kit.Blob(body, 84, 76, 17, 15, C.Pink, { Z = 8, Shine = true })
	kit.Line(ball, 3, 5, 12, 12, 1.2, C.PinkDeep, 0.3, 2)
	kit.Line(ball, 6, 2, 15, 9, 1.2, C.PinkDeep, 0.3, 2)
	kit.Circle(body, 76, 64, 3.5, 3.5, C.Pink, 0, 7)
	kit.Circle(body, 90, 63, 3.5, 3.5, C.Mint, 0, 7)
	return { Flat = true }
end

-- Autocollant cœur : bord blanc découpé, cœur brillant avec un petit visage
Art.HeartSticker = function(body, kit, _item)
	local C = kit.C
	kit.Heart(body, 50, 52, 92, kit.OutlineOf(C.Pink), 0, 2)
	kit.Heart(body, 50, 52, 88, C.White, 0, 3)
	kit.Heart(body, 50, 52, 74, C.Pink, 0, 4)
	kit.Heart(body, 47, 49, 52, Color3.fromRGB(255, 160, 200), 0.35, 5)
	kit.Shine(body, 22, 30, 14, 7, 7, 0.2).Rotation = -40
	kit.Circle(body, 34, 42, 4, 4, C.White, 0.2, 7)
	kit.Face(body, 50, 58, 34, { Eyes = "big", Mouth = "cat", Z = 8 })
	kit.Sparkle(body, 86, 20, 12, C.Butter, 0, 9)
	kit.Sparkle(body, 12, 82, 9, C.White, 0, 9)
	return { WallShadow = Vector2.new(0.85, 0.8) }
end

-- Nœud géant : deux grandes boucles à pois, rubans qui pendent
Art.GiantBow = function(body, kit, _item)
	local C = kit.C
	local pink = Color3.fromRGB(255, 150, 196)
	local deep = kit.Darken(pink, 0.12)
	kit.Part(body, 30, 50, 14, 42, deep, { Radius = 5, Z = 2, Rotation = 22 })
	kit.Part(body, 56, 50, 14, 42, deep, { Radius = 5, Z = 2, Rotation = -22 })
	for _, side in ipairs({ -1, 1 }) do
		local loop = kit.Blob(body, 50 + side * 24, 40, 46, 36, pink, { Z = 3, Rotation = side * 14, Shine = side < 0 })
		kit.Blob(loop, 23 - side * 9, 18, 14, 16, deep, { Z = 2, Outline = false, Shade = false, T = 0.2 })
		for _, dot in ipairs({ { 12, 10 }, { 30, 25 }, { 34, 8 } }) do
			local dx = if side < 0 then dot[1] else 46 - dot[1]
			kit.Circle(loop, dx, dot[2], 5, 5, C.White, 0.1, 3)
		end
	end
	local knot = kit.Part(body, 40, 29, 20, 23, deep, { Radius = 8, Z = 5, Shine = true })
	kit.Heart(knot, 10, 12, 8, C.White, 0.1, 3)
	return { WallShadow = Vector2.new(0.9, 0.7) }
end

-- Calendrier mural : spirale, bandeau du mois EN COURS (français), grille
-- des jours qui commence le lundi, aujourd'hui en cœur (v9.9 SCALE99)
local MONTHS_SHORT = { "JANV.", "FÉVR.", "MARS", "AVRIL", "MAI", "JUIN", "JUIL.", "AOÛT", "SEPT.", "OCT.", "NOV.", "DÉC." }
local function today(): (number, number, number)
	local ok, t = pcall(function()
		return os.date("*t")
	end)
	if ok and type(t) == "table" and tonumber(t.year) then
		return tonumber(t.year) or 2026, tonumber(t.month) or 1, tonumber(t.day) or 1
	end
	return 2026, 1, 1
end
Art.WallCalendar = function(body, kit, _item)
	local C = kit.C
	hanger(kit, body, 50, 6, 32, 68, 20, 1)
	local page = kit.Part(body, 18, 18, 64, 72, C.White, { Radius = 6, Z = 2 })
	kit.Part(body, 22, 88, 58, 5, kit.Darken(C.Cream, 0.04), { Radius = 3, Z = 1 })
	local year, month, day = today()
	local head = kit.Part(page, 0, 0, 64, 20, C.Pink, { Radius = 6, Z = 2, Shade = 0.1 })
	kit.Text(head, MONTHS_SHORT[month] or "", 32, 11.5, 9, C.White, 3)
	for index = 0, 6 do
		kit.Part(page, 5 + index * 9, -5, 3, 9, C.GreyDark, { Radius = -1, Z = 4, Outline = false, Shade = false })
	end
	-- premier jour du mois (Sakamoto : 1 = lundi .. 7 = dimanche) et nombre de jours
	local offsets = { 0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4 }
	local y = month < 3 and year - 1 or year
	local first = (y + y // 4 - y // 100 + y // 400 + offsets[month] + 1) % 7
	first = first == 0 and 7 or first
	local leap = (year % 4 == 0 and year % 100 ~= 0) or year % 400 == 0
	local days = ({ 31, leap and 29 or 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 })[month] or 30
	for d = 1, days do
		local slot = first - 1 + d - 1
		local col, row = slot % 7, slot // 7
		local x = 4 + col * 8.2
		local cy = 25 + row * 7.6
		if d == day then
			kit.Heart(page, x + 3, cy + 3, 8, C.Heart, 0, 4)
		else
			local tint = if col == 6 then C.PinkMist elseif d < day then kit.Darken(C.Cream, 0.02) else C.MintSoft
			local cell = kit.Box(page, x, cy, 6, 5.6, tint, 0, 3)
			kit.Round(cell, 1.5)
		end
	end
	return { WallShadow = Vector2.new(0.66, 0.72) }
end

-- Tableau encadré : cadre doré, paysage (ciel, soleil souriant, collines, nuage)
Art.FramedPicture = function(body, kit, _item)
	local C = kit.C
	hanger(kit, body, 50, 2, 26, 74, 16, 1)
	local frame = kit.Part(body, 6, 14, 88, 74, C.Gold, { Radius = 6, Z = 2, Shine = true, Thickness = 2 })
	kit.Part(frame, 7, 7, 74, 60, C.Cream, { Radius = 3, Z = 2, Shade = false })
	local view = kit.Group(frame, 11, 11, 66, 52, 3, true)
	local sky = kit.Box(view, 0, 0, 66, 52, C.Sky, 0, 1)
	kit.Gradient(sky, Color3.fromRGB(190, 225, 255), Color3.fromRGB(255, 225, 240))
	local sun = kit.Circle(view, 48, 16, 16, 16, C.Butter, 0, 2)
	kit.Face(sun, 8, 8.5, 12, { Eyes = "happy", Mouth = "none", Z = 3 })
	kit.Cloud(view, 20, 22, 20, C.White, 0.05, 2)
	kit.Blob(view, 14, 54, 64, 36, C.Mint, { Z = 3, Outline = false, Shade = 0.1 })
	kit.Blob(view, 56, 58, 66, 34, C.Leaf, { Z = 4, Outline = false, Shade = 0.1 })
	kit.Circle(view, 14, 42, 4, 4, C.Pink, 0, 5)
	kit.Circle(view, 40, 46, 3.5, 3.5, C.White, 0, 5)
	kit.Circle(view, 52, 44, 3.5, 3.5, C.Pink, 0, 5)
	for _, p in ipairs({ { 4, 4 }, { 84, 4 }, { 4, 70 }, { 84, 70 } }) do
		kit.Circle(frame, p[1], p[2], 5, 5, kit.Lighten(C.Gold, 0.4), 0, 4)
	end
	return { WallShadow = Vector2.new(0.88, 0.76) }
end

-- Bouquet de ballons : 3 ballons ronds + 1 cœur, ficelles nouées par un nœud
Art.Balloons = function(body, kit, _item)
	local C = kit.C
	local tieX, tieY = 50, 90
	local specs = {
		{ x = 28, y = 36, color = C.Pink, face = true, z = 4 },
		{ x = 54, y = 22, color = C.Sky, z = 2 },
		{ x = 76, y = 42, color = C.Butter, z = 3 },
	}
	for index, s in ipairs(specs) do
		local p = kit.Pivot(body, tieX, tieY, s.z)
		local bx, by = s.x - tieX, s.y - tieY
		kit.Line(p, 0, 0, bx, by + 18, 1, C.Ink, 0.45, 1)
		kit.Diamond(p, bx, by + 18, 5, kit.Darken(s.color, 0.1), 0, 2)
		local balloon = kit.Blob(p, bx, by, 32, 37, s.color, { Z = 3, Shine = true })
		kit.Circle(balloon, 24, 11, 3, 3, C.White, 0.3, 3)
		if s.face then
			kit.Face(balloon, 16, 21, 18, { Eyes = "happy", Mouth = "smile", Z = 4 })
		end
		kit.Animate(p, "Sway", 3, 0.7, index * 1.7)
	end
	local hp = kit.Pivot(body, tieX, tieY, 5)
	kit.Line(hp, 0, 0, 12, -26, 1, C.Ink, 0.45, 1)
	kit.Heart(hp, 13, -34, 18, C.Heart, 0, 2)
	kit.Shine(hp, 7, -40, 4, 3, 3, 0.3)
	kit.Animate(hp, "Sway", 4, 0.9, 4.2)
	bow(kit, body, tieX, tieY, 13, C.PinkDeep, 8)
	return { WallShadow = Vector2.new(0, 0) }
end

-- Pendule de cheminée : boîtier en bois arrondi, cadran crème, aiguilles
Art.MantelClock = function(body, kit, _item)
	local C = kit.C
	for _, x in ipairs({ 22, 72 }) do
		kit.Blob(body, x + 3, 96, 10, 8, C.Gold, { Z = 1 })
	end
	kit.Part(body, 12, 82, 76, 13, C.WoodDark, { Radius = 5, Z = 2 })
	kit.Part(body, 18, 44, 64, 42, C.Wood, { Radius = 8, Z = 3 })
	kit.Blob(body, 50, 46, 64, 50, C.Wood, { Z = 2, Shine = true })
	kit.Circle(body, 50, 19, 7, 7, C.Gold, 0, 4)
	local dial = kit.Blob(body, 50, 52, 38, 38, C.Cream, { Z = 5, Outline = C.Gold, Thickness = 3 })
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2
		local r = if i % 3 == 0 then 3 else 1.8
		kit.Circle(dial, 19 + math.sin(a) * 14, 19 - math.cos(a) * 14, r, r, C.Ink, 0.1, 2)
	end
	kit.Line(dial, 19, 19, 19, 9, 2.2, C.Ink, 0, 3)
	local minute = kit.Pivot(dial, 19, 19, 3)
	kit.Line(minute, 0, 0, 9, 5, 1.6, C.PinkDeep, 0, 1)
	kit.Animate(minute, "Spin", 0, 0.02, 0)
	kit.Circle(dial, 19, 19, 4, 4, C.Gold, 0, 4)
	kit.Heart(body, 50, 88.5, 7, C.Butter, 0, 4)
	return nil
end

-- Poster carte du monde : papier penché, océan, continents, trajet en pointillés
Art.MapPoster = function(body, kit, _item)
	local C = kit.C
	local paper = kit.Part(body, 6, 12, 88, 74, C.Cream, { Radius = 4, Z = 2, Rotation = -3 })
	local sea = kit.Part(paper, 5, 5, 78, 64, Color3.fromRGB(175, 222, 255), { Radius = 3, Z = 2, Outline = Color3.fromRGB(140, 190, 230), Thickness = 1, Shade = 0.08 })
	kit.Box(sea, 2, 21, 74, 1, C.White, 0.5, 2)
	kit.Box(sea, 2, 43, 74, 1, C.White, 0.5, 2)
	local land = Color3.fromRGB(150, 215, 140)
	local sand = Color3.fromRGB(250, 220, 150)
	local opts = { Z = 3, Thickness = 1, Outline = C.LeafDark }
	kit.Blob(sea, 15, 18, 20, 16, land, opts) -- Amérique du Nord
	kit.Blob(sea, 21, 42, 11, 20, land, { Z = 3, Thickness = 1, Outline = C.LeafDark, Rotation = -15 })
	kit.Blob(sea, 39, 17, 10, 9, land, opts) -- Europe
	kit.Blob(sea, 40, 36, 14, 20, sand, { Z = 3, Thickness = 1, Outline = C.WoodDark }) -- Afrique
	kit.Blob(sea, 57, 19, 28, 17, land, opts) -- Asie
	kit.Blob(sea, 64, 48, 13, 9, sand, { Z = 3, Thickness = 1, Outline = C.WoodDark }) -- Australie
	-- trajet en pointillés vers un cœur
	for i = 0, 6 do
		local k = i / 6
		kit.Circle(sea, 17 + k * 44, 22 - math.sin(k * math.pi) * 12 + k * 4, 2, 2, C.PinkDeep, 0, 4)
	end
	kit.Heart(sea, 64, 26, 9, C.Heart, 0, 5)
	kit.Sparkle(sea, 8, 58, 9, C.Butter, 0, 4)
	for _, x in ipairs({ 2, 80 }) do
		local tape = kit.Box(body, x, 7, 18, 8, C.Pink, 0.3, 4)
		tape.Rotation = if x < 50 then -30 else 30
	end
	return { WallShadow = Vector2.new(0.9, 0.78) }
end

-- Guirlande de fanions : fil qui pend, fanions pastel avec pois et repli
Art.PartyBunting = function(body, kit, _item)
	local C = kit.C
	local colors = { C.Pink, C.Butter, C.Mint, C.Sky, C.Lilac, Color3.fromRGB(255, 180, 140), C.Pink }
	local yAt = sagString(kit, body, -2, 102, 30, 16, 6, C.Ink, 1.4, 3)
	kit.Circle(body, -2, 30, 4, 4, C.GreyDark, 0, 4)
	kit.Circle(body, 102, 30, 4, 4, C.GreyDark, 0, 4)
	for i = 1, #colors do
		local x = -2 + (i - 0.5) / #colors * 104
		local y = yAt(x) - 1
		local color = colors[i]
		local flag = pennant(kit, body, x, y, 13, 20, color, 2)
		kit.Box(flag, 0, 0, 13, 3, kit.Darken(color, 0.12), 0, 2)
		kit.Circle(flag, 6.5, 8, 3.5, 3.5, C.White, 0.2, 3)
	end
	return { WallShadow = Vector2.new(0, 0) }
end

-- Miroir cœur : cadre cœur rose, verre bleuté avec reflets, petit nœud
Art.HeartMirror = function(body, kit, _item)
	local C = kit.C
	kit.Heart(body, 50, 54, 96, kit.OutlineOf(C.Pink), 0, 2)
	kit.Heart(body, 50, 54, 92, C.Pink, 0, 3)
	kit.Heart(body, 50, 54.5, 78, C.PinkSoft, 0, 4)
	kit.Heart(body, 50, 55, 70, Color3.fromRGB(205, 232, 255), 0, 5)
	kit.Heart(body, 50, 57, 50, Color3.fromRGB(225, 242, 255), 0, 6)
	kit.Line(body, 28, 50, 40, 38, 5, C.White, 0.3, 7)
	kit.Line(body, 32, 60, 50, 42, 3, C.White, 0.45, 7)
	local glint = kit.Sparkle(body, 64, 42, 10, C.White, 0, 8)
	kit.Animate(glint, "Breathe", 0.25, 1.2, 0)
	bow(kit, body, 50, 20, 20, C.PinkDeep, 9)
	kit.Heart(body, 50, 83, 7, C.PinkDeep, 0, 8)
	return { WallShadow = Vector2.new(0.9, 0.85) }
end

-- Pile de cadeaux : 3 paquets pastel avec rubans et nœuds
Art.GiftPile = function(body, kit, _item)
	local C = kit.C
	local function gift(x, y, w, h, color, ribbon, z, dots)
		local box = kit.Part(body, x, y, w, h, color, { Radius = 4, Z = z })
		if dots then
			for _, d in ipairs({ { 0.2, 0.3 }, { 0.78, 0.25 }, { 0.25, 0.75 }, { 0.8, 0.72 } }) do
				kit.Circle(box, d[1] * w, d[2] * h + 3, 3.5, 3.5, C.White, 0.3, 2)
			end
		end
		kit.Box(box, w / 2 - 3, 0, 6, h, ribbon, 0, 3)
		kit.Part(body, x - 2, y - 2, w + 4, 9, kit.Lighten(color, 0.15), { Radius = 3, Z = z + 1, Shine = true })
		kit.Box(body, x + w / 2 - 3, y - 2, 6, 9, ribbon, 0, z + 2)
		bow(kit, body, x + w / 2, y - 6, 16, ribbon, z + 3)
	end
	gift(10, 58, 50, 40, C.Pink, C.Mint, 2, true)
	gift(58, 70, 32, 28, C.Lilac, C.Butter, 2)
	gift(20, 30, 30, 26, C.MintSoft, C.PinkDeep, 6)
	kit.Sparkle(body, 80, 50, 10, C.Butter, 0, 9)
	return nil
end

-- Amphore : panse ronde, col, anses, frise grecque et pied
Art.Vase = function(body, kit, _item)
	local C = kit.C
	local clay = Color3.fromRGB(245, 170, 140)
	local band = C.Cream
	for _, side in ipairs({ -1, 1 }) do
		kit.Part(body, 50 + side * 17 - 7, 20, 14, 26, clay, { Radius = -1, Z = 1, T = 1, Thickness = 3.5, Outline = kit.Darken(clay, 0.12), Shade = false })
	end
	kit.Part(body, 36, 90, 28, 8, kit.Darken(clay, 0.1), { Radius = 3, Z = 2 })
	kit.Part(body, 42, 84, 16, 8, clay, { Radius = 2, Z = 3 })
	kit.Blob(body, 50, 60, 56, 50, clay, { Z = 4, Shine = true })
	kit.Part(body, 40, 16, 20, 26, clay, { Radius = 4, Z = 3 })
	kit.Part(body, 34, 12, 32, 8, kit.Lighten(clay, 0.1), { Radius = -1, Z = 5 })
	local stripe = kit.Part(body, 23, 54, 54, 12, band, { Radius = 3, Z = 5, Thickness = 1.2, Shade = false })
	for i = 0, 5 do
		kit.Diamond(stripe, 5 + i * 8.8, 6, 4.5, if i % 2 == 0 then C.PinkDeep else clay, 0, 2)
	end
	kit.Box(body, 28, 72, 44, 2, kit.Darken(clay, 0.15), 0.3, 5)
	kit.Box(body, 29, 44, 42, 2, kit.Darken(clay, 0.15), 0.3, 5)
	return nil
end

-- Étoiles phosphorescentes : grande étoile souriante, petites étoiles, lune
Art.GlowStars = function(body, kit, _item)
	local C = kit.C
	local glow = Color3.fromRGB(236, 255, 190)
	local halo = kit.Circle(body, 42, 48, 60, 60, glow, 0.75, 1)
	kit.Animate(halo, "Pulse", 0.2, 0.8, 0)
	kit.Circle(halo, 30, 30, 40, 40, glow, 0.5, 1)
	local big = outlinedStar(kit, body, 42, 50, 24, glow, 3)
	kit.Face(big, 26, 28, 18, { Eyes = "happy", Mouth = "smile", Z = 4 })
	local moon = crescent(kit, body, 78, 24, 16, Color3.fromRGB(255, 245, 180), 3, 10)
	kit.Animate(moon, "Bob", 1.5, 0.8, 1)
	for index, s in ipairs({ { 14, 18, 8 }, { 82, 70, 10 }, { 22, 84, 7 } }) do
		local small = star(kit, body, s[1], s[2], s[3], if index % 2 == 0 then glow else Color3.fromRGB(210, 250, 230), 2)
		kit.Animate(small, "Breathe", 0.08, 1.3, index * 1.1)
	end
	kit.Sparkle(body, 90, 44, 8, C.White, 0, 3)
	return { Glow = glow, WallShadow = Vector2.new(0, 0) }
end

-- Attrape-rêves : cercle rose, toile étoilée, perles et plumes qui se balancent
Art.DreamCatcher = function(body, kit, _item)
	local C = kit.C
	local cx, cy, r = 50, 34, 25
	kit.Line(body, cx, cy - r, cx, -2, 1.2, C.WoodDark, 0, 1)
	kit.Circle(body, cx, -2, 4.5, 4.5, C.GreyDark, 0, 2)
	-- toile (octogramme)
	local pts = {}
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2 - math.pi / 2
		pts[i] = { cx + math.cos(a) * (r - 1), cy + math.sin(a) * (r - 1) }
	end
	for i = 0, 7 do
		local a, b = pts[i], pts[(i + 3) % 8]
		kit.Line(body, a[1], a[2], b[1], b[2], 1, C.White, 0.15, 3)
	end
	kit.Part(body, cx - r, cy - r, r * 2, r * 2, C.White, { Radius = -1, T = 1, Outline = kit.OutlineOf(C.Pink), Thickness = 6, Shade = false, Z = 4 })
	kit.Part(body, cx - r, cy - r, r * 2, r * 2, C.White, { Radius = -1, T = 1, Outline = C.Pink, Thickness = 3.4, Shade = false, Z = 5 })
	kit.Heart(body, cx, cy, 9, C.PinkDeep, 0, 6)
	for _, b in ipairs({ { cx - r, cy, C.Mint }, { cx + r, cy, C.Butter } }) do
		kit.Circle(body, b[1], b[2], 6, 6, b[3], 0, 6)
	end
	-- plumes suspendues
	local feathers = {
		{ a = 130, len = 12, color = C.Lilac, tilt = 8 },
		{ a = 90, len = 18, color = C.Pink, tilt = 0 },
		{ a = 50, len = 12, color = C.Mint, tilt = -8 },
	}
	for index, f in ipairs(feathers) do
		local a = math.rad(f.a)
		local p = kit.Pivot(body, cx + math.cos(a) * r, cy + math.sin(a) * r, 3)
		kit.Line(p, 0, 0, 0, f.len, 1, C.WoodDark, 0, 1)
		kit.Circle(p, 0, f.len - 3, 5, 5, C.Butter, 0, 3)
		local feather = kit.Blob(p, 0, f.len + 12, 10, 26, f.color, { Z = 2, Shine = true, Rotation = f.tilt })
		kit.Line(feather, 5, 3, 5, 26, 1, kit.OutlineOf(f.color), 0.3, 2)
		kit.Line(feather, 5, 12, 9, 9, 1, C.White, 0.3, 2)
		kit.Line(feather, 5, 18, 1, 15, 1, C.White, 0.3, 2)
		kit.Animate(p, "Sway", 6, 0.9, index * 1.3)
	end
	return { WallShadow = Vector2.new(0, 0) }
end

-- Coucou : chalet en bois, toit en planches, oiseau à la porte, balancier et pommes de pin
Art.CuckooClock = function(body, kit, _item)
	local C = kit.C
	-- chaînes et poids
	for _, w in ipairs({ { 37, 84 }, { 63, 90 } }) do
		kit.Line(body, w[1], 70, w[1], w[2] - 6, 1.2, C.GreyDark, 0, 1)
		local cone = kit.Blob(body, w[1], w[2], 8, 13, C.Brown, { Z = 2 })
		kit.Line(cone, 1, 4, 7, 4, 1, kit.Darken(C.Brown, 0.25), 0.2, 2)
		kit.Line(cone, 1, 8, 7, 8, 1, kit.Darken(C.Brown, 0.25), 0.2, 2)
	end
	-- balancier
	local pendulum = kit.Pivot(body, 50, 70, 1)
	kit.Line(pendulum, 0, 0, 0, 20, 2, C.Gold, 0, 1)
	local bob = kit.Blob(pendulum, 0, 22, 11, 11, C.Gold, { Z = 2, Shine = true })
	kit.Heart(bob, 5.5, 5.8, 5, C.White, 0.2, 3)
	kit.Animate(pendulum, "Sway", 12, 1.3, 0)
	-- corps + pignon
	kit.Part(body, 26, 32, 48, 42, C.Wood, { Radius = 5, Z = 3 })
	kit.Triangle(body, 50, 12, 50, 24, C.WoodLight, 3, nil, 10)
	local left = kit.Line(body, 16, 38, 51, 9, 9, C.Brown, 0, 4)
	kit.Stroke(left, kit.OutlineOf(C.Brown), 1.4)
	local right = kit.Line(body, 49, 9, 84, 38, 9, C.Brown, 0, 4)
	kit.Stroke(right, kit.OutlineOf(C.Brown), 1.4)
	kit.Blob(body, 44, 7, 10, 6, C.Leaf, { Z = 5, Rotation = -25 })
	kit.Blob(body, 56, 7, 10, 6, C.Leaf, { Z = 5, Rotation = 25 })
	kit.Circle(body, 50, 8, 5, 5, C.Heart, 0, 6)
	-- porte et oiseau
	kit.Part(body, 43, 18, 14, 15, C.Ink, { Radius = 6, Z = 5, Outline = C.WoodDark })
	local bird = kit.Group(body, 40, 16, 20, 20, 6)
	local head = kit.Blob(bird, 10, 11, 12, 11, C.Butter, { Z = 1 })
	kit.Circle(head, 3.5, 4.5, 2.2, 2.6, C.Ink, 0, 2)
	kit.Circle(head, 8.5, 4.5, 2.2, 2.6, C.Ink, 0, 2)
	kit.Circle(head, 2.5, 7.5, 2.5, 1.6, C.Blush, 0.3, 2)
	kit.Circle(head, 9.5, 7.5, 2.5, 1.6, C.Blush, 0.3, 2)
	kit.Diamond(bird, 10, 14, 3.5, C.Orange, 0, 2)
	kit.Animate(bird, "Bob", 1.2, 0.9, 0)
	-- cadran
	local dial = kit.Blob(body, 50, 54, 28, 28, C.Cream, { Z = 5, Outline = C.WoodDark, Thickness = 2 })
	for i = 0, 3 do
		local a = i / 4 * math.pi * 2
		kit.Circle(dial, 14 + math.sin(a) * 10, 14 - math.cos(a) * 10, 2.4, 2.4, C.Ink, 0.1, 2)
	end
	kit.Line(dial, 14, 14, 14, 6, 1.8, C.Ink, 0, 3)
	kit.Line(dial, 14, 14, 20, 16, 1.6, C.PinkDeep, 0, 3)
	kit.Circle(dial, 14, 14, 3, 3, C.Gold, 0, 4)
	return { WallShadow = Vector2.new(0.7, 0.7) }
end

-- Globe de bureau : sphère bleue et continents, anneau doré, pied en bois
Art.DeskGlobe = function(body, kit, _item)
	local C = kit.C
	kit.Blob(body, 50, 94, 44, 10, C.WoodDark, { Z = 1 })
	kit.Part(body, 36, 84, 28, 10, C.Wood, { Radius = 4, Z = 2, Shine = true })
	kit.Part(body, 46, 72, 8, 14, C.Gold, { Radius = 2, Z = 1 })
	kit.Part(body, 17, 11, 66, 66, C.White, { Radius = -1, T = 1, Outline = kit.OutlineOf(C.Gold), Thickness = 5, Shade = false, Z = 2 })
	kit.Part(body, 17, 11, 66, 66, C.White, { Radius = -1, T = 1, Outline = C.Gold, Thickness = 3, Shade = false, Z = 3 })
	local globe = kit.Blob(body, 50, 44, 56, 56, Color3.fromRGB(150, 205, 250), { Z = 4 })
	local lands = kit.Group(globe, 0, 0, 56, 56, 2)
	local land = Color3.fromRGB(140, 215, 140)
	local o = { Z = 1, Thickness = 1.2, Outline = C.LeafDark, Shade = false }
	kit.Blob(lands, 18, 17, 18, 13, land, o)
	kit.Blob(lands, 20, 34, 10, 16, land, { Z = 1, Thickness = 1.2, Outline = C.LeafDark, Shade = false, Rotation = -20 })
	kit.Blob(lands, 38, 20, 16, 12, land, o)
	kit.Blob(lands, 38, 38, 12, 12, Color3.fromRGB(250, 220, 150), { Z = 1, Thickness = 1.2, Outline = C.WoodDark, Shade = false })
	kit.Animate(lands, "Drift", 1.5, 0.4, 0)
	kit.Cloud(globe, 42, 50, 12, C.White, 0.3, 3)
	kit.Shine(globe, 10, 9, 12, 6, 4, 0.3).Rotation = -35
	kit.Circle(body, 50, 11, 6, 6, C.Gold, 0, 5)
	kit.Circle(body, 50, 77, 6, 6, C.Gold, 0, 5)
	return nil
end

-- Guirlande de polaroïds : fil qui pend, 4 photos tenues par des pinces
Art.PhotoString = function(body, kit, _item)
	local C = kit.C
	local yAt = sagString(kit, body, -2, 102, 24, 12, 6, C.WoodDark, 1.2, 2)
	kit.Circle(body, -2, 24, 4, 4, C.GreyDark, 0, 3)
	kit.Circle(body, 102, 24, 4, 4, C.GreyDark, 0, 3)
	local xs = { 13, 38, 62, 87 }
	local tilts = { -8, 5, -4, 9 }
	local pins = { C.Pink, C.Mint, C.Butter, C.Lilac }
	for i, x in ipairs(xs) do
		local p = kit.Pivot(body, x, yAt(x), 3)
		local card = kit.Part(p, -11, 1, 22, 27, C.White, { Radius = 2, Z = 1, Rotation = tilts[i], Outline = C.Grey, Thickness = 1.2, Shade = 0.06 })
		if i == 1 then
			local photo = kit.Box(card, 3, 3, 16, 16, C.PinkSoft, 0, 2)
			kit.Heart(photo, 8, 8.5, 11, C.Heart, 0, 2)
		elseif i == 2 then
			local photo = kit.Box(card, 3, 3, 16, 16, C.Sky, 0, 2)
			kit.Circle(photo, 11, 5, 6, 6, C.Butter, 0, 2)
			kit.Box(photo, 0, 11, 16, 5, C.Leaf, 0, 3)
			kit.Circle(photo, 5, 12, 10, 6, C.Leaf, 0, 3)
		elseif i == 3 then
			local photo = kit.Box(card, 3, 3, 16, 16, C.LilacSoft, 0, 2)
			local cat = kit.Circle(photo, 8, 10, 12, 10, C.Butter, 0, 3)
			kit.Diamond(photo, 3.5, 5.5, 4, C.Butter, 0, 2)
			kit.Diamond(photo, 12.5, 5.5, 4, C.Butter, 0, 2)
			kit.Face(cat, 6, 5.5, 9, { Eyes = "happy", Mouth = "cat", Z = 2 })
		else
			local photo = kit.Box(card, 3, 3, 16, 16, C.Navy, 0, 2)
			star(kit, photo, 8, 9, 5, C.Butter, 2)
			kit.Circle(photo, 3.5, 3.5, 2, 2, C.White, 0, 2)
			kit.Circle(photo, 13, 13.5, 1.6, 1.6, C.White, 0, 2)
		end
		kit.Line(card, 4, 23, 12, 23, 1.2, C.Grey, 0, 2)
		kit.Part(p, -2.5, -3, 5, 9, pins[i], { Radius = 2, Z = 3, Thickness = 1.2 })
		kit.Animate(p, "Sway", 3, 0.8, i * 1.4)
	end
	return { WallShadow = Vector2.new(0, 0) }
end

-- Étagère murale : planche avec dentelle, livres, plante, lapin et bocal de bonbons
Art.WallShelf = function(body, kit, _item)
	local C = kit.C
	for i = 0, 8 do
		kit.Circle(body, 12 + i * 9.5, 70, 8, 8, C.Pink, 0.15, 1)
		kit.Circle(body, 12 + i * 9.5, 71, 3, 3, C.White, 0.2, 2)
	end
	kit.Part(body, 4, 60, 92, 9, C.Wood, { Radius = 3, Z = 3, Shine = true })
	for _, x in ipairs({ 16, 78 }) do
		kit.Part(body, x, 66, 6, 14, C.WoodDark, { Radius = 2, Z = 2 })
	end
	-- livres
	kit.Part(body, 8, 34, 7, 26, C.Pink, { Radius = 2, Z = 2 })
	kit.Part(body, 15, 38, 7, 22, C.Sky, { Radius = 2, Z = 2 })
	kit.Part(body, 23, 36, 7, 25, C.Mint, { Radius = 2, Z = 1, Rotation = 14 })
	for _, x in ipairs({ 8, 15 }) do
		kit.Box(body, x + 1, 44, 5, 2, C.White, 0.3, 3)
	end
	-- plante en pot
	kit.Blob(body, 40, 36, 8, 16, C.Leaf, { Z = 2, Rotation = -30 })
	kit.Blob(body, 52, 34, 8, 16, C.Leaf, { Z = 2, Rotation = 30 })
	kit.Blob(body, 46, 32, 8, 18, C.LeafDark, { Z = 2 })
	local pot = kit.Part(body, 38, 45, 16, 15, C.Peach, { Radius = 4, Z = 3 })
	kit.Heart(pot, 8, 9, 6, C.PinkDeep, 0, 2)
	-- lapin
	kit.Part(body, 60, 30, 5, 14, C.White, { Radius = -1, Z = 2, Rotation = -10 })
	kit.Part(body, 69, 30, 5, 14, C.White, { Radius = -1, Z = 2, Rotation = 10 })
	local bunny = kit.Blob(body, 66, 50, 20, 20, C.White, { Z = 3 })
	kit.Face(bunny, 10, 9, 13, { Eyes = "dot", Mouth = "cat", Z = 2 })
	-- bocal de bonbons
	local jar = kit.Part(body, 78, 42, 15, 18, C.Glass, { Radius = 4, Z = 3, T = 0.25, Shine = true })
	kit.Circle(jar, 4.5, 12, 5, 5, C.Pink, 0, 2)
	kit.Circle(jar, 10, 13, 5, 5, C.Butter, 0, 2)
	kit.Circle(jar, 7, 8, 5, 5, C.Mint, 0, 2)
	kit.Part(body, 77, 38, 17, 6, C.PinkDeep, { Radius = 2, Z = 4 })
	return { WallShadow = Vector2.new(0.92, 0.5) }
end

-- Carillon (fūrin) : cloche de verre peinte, papier à vœux qui se balance
Art.WindChime = function(body, kit, _item)
	local C = kit.C
	local pv = kit.Pivot(body, 50, -6, 2)
	kit.Line(pv, 0, 0, 0, 18, 1.2, C.PinkDeep, 0, 1)
	kit.Line(pv, 0, 30, 0, 64, 1, C.Ink, 0.4, 1)
	-- papier
	local strip = kit.Pivot(pv, 0, 62, 1)
	local paper = kit.Part(strip, -7, 0, 14, 34, C.PinkSoft, { Radius = 2, Z = 1, Shine = true })
	kit.Box(paper, 0, 26, 14, 3, C.Pink, 0, 2)
	kit.Heart(paper, 7, 15, 7, C.Heart, 0, 2)
	kit.Animate(strip, "Sway", 9, 1.1, 0.5)
	-- cloche
	local bell = kit.Part(pv, -19, 16, 38, 32, C.Glass, { Radius = 16, Z = 3, T = 0.2, Shine = true })
	kit.Circle(bell, 19, 26, 5, 5, C.Mint, 0, 2)
	local fish = kit.Blob(bell, 13, 18, 10, 7, C.Red, { Z = 2, Outline = false, Shade = false })
	kit.Circle(fish, 7, 3, 1.6, 1.6, C.White, 0, 2)
	kit.Diamond(bell, 7, 18, 5, C.Red, 0, 2)
	kit.Circle(bell, 27, 12, 4, 4, C.Pink, 0, 2)
	kit.Circle(bell, 31, 17, 3, 3, C.Pink, 0, 2)
	kit.Circle(bell, 25, 20, 2.5, 2.5, C.Blush, 0, 2)
	kit.Part(pv, -20, 43, 40, 6, kit.Lighten(C.Glass, 0.2), { Radius = 3, Z = 4, T = 0.1 })
	kit.Circle(pv, 0, 17, 9, 5, C.PinkDeep, 0, 4)
	kit.Animate(pv, "Sway", 3, 0.8, 0)
	return { WallShadow = Vector2.new(0, 0) }
end

-- Guirlande de lunes : fil, lunes (une qui dort), étoiles et nuage qui pendent
Art.MoonGarland = function(body, kit, _item)
	local C = kit.C
	local yAt = sagString(kit, body, -2, 102, 12, 8, 4, C.WoodDark, 1.2, 1)
	local moon = Color3.fromRGB(255, 232, 150)
	local items = {
		{ x = 8, len = 18, kind = "star", color = C.Lilac },
		{ x = 24, len = 30, kind = "moon", r = 11 },
		{ x = 50, len = 14, kind = "bigmoon", r = 20 },
		{ x = 80, len = 46, kind = "cloud" },
		{ x = 94, len = 14, kind = "star", color = C.Pink },
	}
	for index, it in ipairs(items) do
		local p = kit.Pivot(body, it.x, yAt(it.x), 2)
		kit.Line(p, 0, 0, 0, it.len, 1, C.Ink, 0.4, 1)
		if it.kind == "star" then
			star(kit, p, 0, it.len + 8, 9, it.color, 2)
		elseif it.kind == "moon" then
			crescent(kit, p, 3, it.len + it.r - 2, it.r, moon, 2, 8)
		elseif it.kind == "bigmoon" then
			local m = crescent(kit, p, 12, it.len + it.r - 3, it.r, moon, 2, 12)
			kit.Face(m, it.r * 0.5, it.r * 1.0, 13, { Eyes = "closed", Mouth = "smile", Z = 3, Color = C.WoodDark })
		else
			kit.Cloud(p, 0, it.len + 12, 20, C.White, 0, 2)
		end
		kit.Animate(p, "Sway", 5, 0.7, index * 1.3)
	end
	return { WallShadow = Vector2.new(0, 0) }
end

-- Carpes koinobori : mât, 3 carpes à écailles qui flottent au vent
Art.CarpStreamer = function(body, kit, _item)
	local C = kit.C
	kit.Part(body, 11, 6, 5, 92, C.WoodLight, { Radius = 2, Z = 1 })
	kit.Circle(body, 13.5, 6, 10, 10, C.Gold, 0, 2)
	local carps = {
		{ y = 22, len = 80, h = 20, color = Color3.fromRGB(110, 130, 200) },
		{ y = 48, len = 70, h = 18, color = C.Pink },
		{ y = 72, len = 58, h = 15, color = C.Sky },
	}
	for index, c in ipairs(carps) do
		local p = kit.Pivot(body, 16, c.y, 3 + index)
		local len, h = c.len, c.h
		local light = kit.Lighten(c.color, 0.45)
		for _, side in ipairs({ -1, 1 }) do
			kit.Blob(p, len - 8, side * h * 0.28, 16, h * 0.42, kit.Darken(c.color, 0.06), { Z = 1, Rotation = side * 30 })
		end
		local fish = kit.Part(p, 0, -h / 2, len - 10, h, c.color, { Radius = -1, Z = 2, Shine = true })
		kit.Box(fish, 6, h * 0.62, len - 26, h * 0.2, light, 0.2, 2)
		for i = 0, 3 do
			local sx = 18 + i * (len - 38) / 3
			kit.Circle(fish, sx, h * 0.34, h * 0.36, h * 0.36, light, 0.45, 2)
		end
		kit.Part(p, -2, -h / 2 + 1, 6, h - 2, C.White, { Radius = -1, Z = 3, Thickness = 1.2 })
		local eye = kit.Circle(fish, 11, h * 0.42, h * 0.42, h * 0.42, C.White, 0, 3)
		kit.Circle(eye, h * 0.21, h * 0.21, h * 0.24, h * 0.24, C.Ink, 0, 2)
		kit.Animate(p, "Sway", 3, 0.9, index * 0.9)
	end
	return { WallShadow = Vector2.new(0, 0) }
end

-- Aquarium : bac d'eau sur un meuble, algues, poissons kawaii, bulles
Art.Aquarium = function(body, kit, _item)
	local C = kit.C
	-- meuble
	local stand = kit.Part(body, 8, 80, 84, 20, C.WoodLight, { Radius = 5, Z = 1 })
	kit.Part(stand, 5, 5, 35, 11, kit.Lighten(C.WoodLight, 0.2), { Radius = 3, Z = 2, Thickness = 1.2 })
	kit.Part(stand, 44, 5, 35, 11, kit.Lighten(C.WoodLight, 0.2), { Radius = 3, Z = 2, Thickness = 1.2 })
	kit.Circle(stand, 37, 10.5, 3, 3, C.Gold, 0, 3)
	kit.Circle(stand, 47, 10.5, 3, 3, C.Gold, 0, 3)
	-- bac
	local tank = kit.Part(body, 6, 22, 88, 60, C.Glass, { Radius = 5, Z = 2, Outline = Color3.fromRGB(120, 175, 220), Thickness = 2.2, Shade = false })
	kit.Gradient(tank, Color3.fromRGB(215, 242, 255), Color3.fromRGB(140, 200, 245))
	local view = kit.Group(tank, 0, 5, 88, 55, 2, true)
	kit.Box(view, 0, 0, 88, 2, C.White, 0.3, 1)
	kit.Blob(view, 44, 56, 104, 18, C.Butter, { Z = 4, Outline = false, Shade = 0.1 })
	kit.Circle(view, 20, 50, 4, 3, C.Pink, 0, 5)
	kit.Circle(view, 60, 51, 5, 3.5, C.Lilac, 0, 5)
	-- algues
	for index, a in ipairs({ { 12, 50, 26 }, { 76, 50, 30 }, { 83, 51, 20 } }) do
		local p = kit.Pivot(view, a[1], a[2], 3)
		kit.Line(p, 0, 0, -2, -a[3], 5, if index == 2 then C.LeafDark else C.Leaf, 0, 1)
		kit.Line(p, 0, 0, 5, -a[3] * 0.6, 4, C.Leaf, 0, 1)
		kit.Animate(p, "Sway", 6, 0.6, index * 1.5)
	end
	-- petit château
	local castle = kit.Part(view, 56, 34, 18, 18, C.LilacSoft, { Z = 3, Radius = 2, Thickness = 1.2 })
	kit.Part(castle, 6, 8, 6, 10, C.Purple, { Radius = 3, Z = 2, Outline = false, Shade = false })
	for _, x in ipairs({ 52, 72 }) do
		kit.Part(view, x, 29, 7, 23, C.LilacSoft, { Z = 3, Radius = 2, Thickness = 1.2 })
		kit.Triangle(view, x + 3.5, 21, 9, 8, C.Pink, 4, nil, 5)
	end
	-- poissons
	local function fish(x, y, w, color, stripes, phase)
		local g = kit.Group(view, x - w / 2, y - w * 0.35, w * 1.3, w * 0.7, 6)
		kit.Blob(g, w * 0.12, w * 0.35, w * 0.35, w * 0.45, kit.Darken(color, 0.05), { Z = 1, Thickness = 1.2 })
		local b = kit.Blob(g, w * 0.7, w * 0.35, w, w * 0.7, color, { Z = 2, Thickness = 1.2, Shine = true })
		if stripes then
			kit.Box(b, w * 0.42, 0, w * 0.12, w * 0.7, C.White, 0, 2)
		end
		kit.Circle(b, w * 0.75, w * 0.3, w * 0.16, w * 0.18, C.Ink, 0, 3)
		kit.Circle(b, w * 0.7, w * 0.47, w * 0.16, w * 0.09, C.Blush, 0.3, 3)
		kit.Animate(g, "Drift", 7, 0.35 + phase * 0.05, phase)
	end
	fish(30, 18, 16, C.Orange, true, 0)
	fish(60, 30, 13, C.Pink, false, 2)
	fish(26, 38, 10, C.Sky, false, 4)
	-- bulles
	for index, b in ipairs({ { 50, 12, 4 }, { 54, 20, 3 }, { 18, 26, 3.5 }, { 74, 14, 2.5 } }) do
		local bubble = kit.Circle(view, b[1], b[2], b[3], b[3], C.White, 0.35, 7)
		kit.Stroke(bubble, C.White, 1, 0.2)
		kit.Animate(bubble, "Bob", 2, 0.8, index * 1.1)
	end
	-- reflets sur la vitre + couvercle
	kit.Line(body, 14, 64, 26, 32, 3, C.White, 0.55, 4)
	kit.Line(body, 20, 70, 28, 50, 2, C.White, 0.65, 4)
	kit.Part(body, 3, 17, 94, 8, C.Mint, { Radius = 4, Z = 5, Shine = true })
	return { Glow = Color3.fromRGB(150, 215, 255) }
end

-- Piñata lama : bandes de papier pastel à franges, tête avec visage et fleur, corde
Art.Pinata = function(body, kit, _item)
	local C = kit.C
	local p = kit.Pivot(body, 56, -10, 2)
	kit.Line(p, 0, 0, 0, 56, 1.4, C.WoodDark, 0, 1)
	local colors = { C.Pink, C.Butter, C.Mint, C.Sky, C.Lilac }
	local function stripes(x, y, w, h, n, z, offset, fringe)
		local sh = h / n
		for i = 0, n - 1 do
			local color = colors[(i + offset) % #colors + 1]
			local s = kit.Part(p, x, y + i * sh, w, sh + 0.8, color, { Radius = 3, Z = z, Thickness = 1.2, Shade = false })
			if fringe then
				kit.Box(s, 2, sh - 2, w - 4, 1.4, kit.Darken(color, 0.14), 0.1, 2)
			end
		end
	end
	for i, x in ipairs({ -24, -13, 8, 19 }) do
		stripes(x, 76, 8, 22, 2, 1, i + 1, false) -- pattes
	end
	kit.Blob(p, 32, 62, 10, 14, C.Heart, { Z = 1, Rotation = 35 }) -- queue
	stripes(-28, 54, 60, 28, 4, 2, 0, true) -- corps
	stripes(-38, 32, 16, 26, 3, 3, 3, true) -- cou
	-- tête
	kit.Part(p, -40, 8, 7, 14, C.Pink, { Radius = -1, Z = 3, Rotation = -14 })
	kit.Part(p, -27, 8, 7, 14, C.Pink, { Radius = -1, Z = 3, Rotation = 14 })
	local head = kit.Part(p, -46, 15, 30, 22, C.Pink, { Radius = 9, Z = 4, Shine = true })
	kit.Blob(head, 15, 16, 16, 9, C.PinkSoft, { Z = 2, Outline = false, Shade = false })
	kit.Face(head, 15, 11, 17, { Eyes = "dot", Mouth = "smile", Z = 3 })
	for i = 0, 3 do
		local a = i / 4 * math.pi * 2
		kit.Circle(p, -22 + math.cos(a) * 3, 13 + math.sin(a) * 3, 5, 5, C.Butter, 0, 5)
	end
	kit.Circle(p, -22, 13, 3.5, 3.5, C.Orange, 0, 6)
	kit.Animate(p, "Sway", 4, 0.8, 0)
	return { WallShadow = Vector2.new(0.75, 0.7) }
end

-- Trophée doré : coupe à anses, étoile, socle en bois avec plaque
Art.GoldenTrophy = function(body, kit, _item)
	local C = kit.C
	kit.Part(body, 24, 84, 52, 14, C.WoodDark, { Radius = 3, Z = 1 })
	kit.Part(body, 38, 88, 24, 6, C.Butter, { Radius = 2, Z = 2, Thickness = 1 })
	kit.Part(body, 32, 76, 36, 10, C.Gold, { Radius = 3, Z = 2, Shine = true })
	kit.Part(body, 45, 56, 10, 22, C.Gold, { Radius = 2, Z = 2 })
	kit.Blob(body, 50, 64, 18, 7, C.Gold, { Z = 3 })
	for _, x in ipairs({ 10, 68 }) do
		kit.Part(body, x, 18, 22, 24, C.Gold, { Radius = -1, T = 1, Thickness = 5, Outline = kit.OutlineOf(C.Gold), Shade = false, Z = 2 })
		kit.Part(body, x, 18, 22, 24, C.Gold, { Radius = -1, T = 1, Thickness = 3, Outline = C.Gold, Shade = false, Z = 3 })
	end
	kit.Blob(body, 50, 50, 30, 20, C.Gold, { Z = 3 })
	local cup = kit.Part(body, 24, 12, 52, 44, C.Gold, { Radius = 20, Z = 4, Shade = 0.2 })
	kit.Line(cup, 9, 12, 8, 26, 4, C.White, 0.4, 3)
	kit.Part(body, 20, 10, 60, 8, kit.Lighten(C.Gold, 0.25), { Radius = -1, Z = 5 })
	outlinedStar(kit, body, 50, 34, 10, C.Butter, 6)
	for index, s in ipairs({ { 14, 10, 10 }, { 88, 50, 8 }, { 84, 8, 6 } }) do
		local sp = kit.Sparkle(body, s[1], s[2], s[3], if index == 2 then C.White else C.Butter, 0, 7)
		kit.Animate(sp, "Breathe", 0.2, 1.4, index)
	end
	return nil
end

-- Boule de cristal : sphère lilas avec brume qui tourne, étoiles, socle doré
Art.CrystalBall = function(body, kit, _item)
	local C = kit.C
	kit.Part(body, 26, 84, 48, 13, C.Purple, { Radius = 6, Z = 1, Shine = true })
	local ball = kit.Blob(body, 50, 48, 60, 60, C.White, { Z = 2, Shade = false, T = 0.05, Outline = C.Purple, Thickness = 2 })
	kit.Gradient(ball, Color3.fromRGB(245, 235, 255), Color3.fromRGB(190, 160, 250))
	local mist = kit.Group(ball, 0, 0, 60, 60, 2)
	kit.Circle(mist, 22, 26, 24, 16, C.Pink, 0.55, 1)
	kit.Circle(mist, 38, 38, 22, 14, C.Sky, 0.55, 1)
	kit.Circle(mist, 36, 20, 14, 10, C.White, 0.5, 1)
	kit.Animate(mist, "Spin", 0, 0.06, 0)
	for index, s in ipairs({ { 22, 36, 8 }, { 40, 24, 10 }, { 32, 46, 5 } }) do
		local sp = kit.Sparkle(ball, s[1], s[2], s[3], C.White, 0, 4)
		kit.Animate(sp, "Breathe", 0.25, 1.1, index * 1.7)
	end
	kit.Shine(ball, 11, 10, 16, 8, 5, 0.2).Rotation = -40
	kit.Circle(ball, 12, 22, 4, 4, C.White, 0.2, 5)
	kit.Part(body, 28, 74, 44, 12, C.Gold, { Radius = -1, Z = 3, Shine = true })
	for _, x in ipairs({ 34, 50, 66 }) do
		kit.Diamond(body, x, 80, 4, C.PinkDeep, 0, 4)
	end
	return { Glow = Color3.fromRGB(200, 160, 255) }
end

-- Statue moaï : grosse tête de pierre qui fait la sieste, chapeau, mousse et fleur
Art.MoaiStatue = function(body, kit, _item)
	local C = kit.C
	local stone = Color3.fromRGB(196, 190, 212)
	local dark = kit.Darken(stone, 0.14)
	kit.Part(body, 6, 88, 88, 11, kit.Darken(stone, 0.2), { Radius = 4, Z = 1 })
	for _, g in ipairs({ { 10, 88 }, { 16, 86 }, { 86, 88 }, { 80, 87 } }) do
		kit.Blob(body, g[1], g[2], 6, 10, C.Leaf, { Z = 2, Thickness = 1 })
	end
	local torso = kit.Part(body, 18, 62, 64, 28, stone, { Radius = 12, Z = 2 })
	kit.Line(torso, 8, 12, 24, 22, 2, dark, 0.2, 2)
	kit.Line(torso, 56, 12, 40, 22, 2, dark, 0.2, 2)
	for _, x in ipairs({ 22, 70 }) do
		kit.Part(body, x, 30, 8, 26, stone, { Radius = 4, Z = 3 })
	end
	local head = kit.Part(body, 27, 12, 46, 58, stone, { Radius = 12, Z = 4, Shine = true })
	kit.Part(body, 31, 3, 38, 13, Color3.fromRGB(235, 160, 150), { Radius = 5, Z = 5, Shine = true })
	kit.Part(head, 3, 15, 40, 8, dark, { Radius = 4, Z = 2, Shade = false })
	kit.Face(head, 23, 28, 34, { Eyes = "closed", Mouth = "none", Z = 3 })
	local nose = kit.Part(head, 17, 18, 12, 28, kit.Lighten(stone, 0.12), { Radius = 5, Z = 4 })
	kit.Circle(nose, 3.5, 24, 3, 2.5, dark, 0, 2)
	kit.Circle(nose, 8.5, 24, 3, 2.5, dark, 0, 2)
	kit.Part(head, 13, 49, 20, 5, dark, { Radius = 2.5, Z = 4, Shade = false })
	kit.Blob(head, 8, 6, 12, 7, C.Leaf, { Z = 3, Outline = false, T = 0.15 })
	-- fleur derrière l'oreille
	for i = 0, 4 do
		local a = i / 5 * math.pi * 2
		kit.Circle(body, 74 + math.cos(a) * 3.5, 30 + math.sin(a) * 3.5, 6, 6, C.Pink, 0, 6)
	end
	kit.Circle(body, 74, 30, 4, 4, C.Yellow, 0, 7)
	return nil
end

-- Fontaine d'intérieur : trois vasques, jets d'eau, gouttes et petit canard
Art.Fountain = function(body, kit, _item)
	local C = kit.C
	local stone = Color3.fromRGB(238, 232, 250)
	local rim = kit.Lighten(stone, 0.5)
	local water = Color3.fromRGB(160, 215, 255)
	-- bassin
	local basin = kit.Part(body, 4, 72, 92, 26, stone, { Radius = 10, Z = 2 })
	kit.Box(basin, 2, 13, 88, 4, C.PinkSoft, 0, 2)
	for _, x in ipairs({ 22, 46, 70 }) do
		kit.Heart(basin, x, 15, 7, C.Pink, 0, 3)
	end
	kit.Blob(body, 50, 72, 96, 18, rim, { Z = 3 })
	local pool = kit.Blob(body, 50, 73, 82, 11, water, { Z = 4, Outline = false })
	kit.Circle(pool, 20, 5, 3, 2, C.Gold, 0, 2)
	kit.Circle(pool, 60, 7, 3, 2, C.Gold, 0, 2)
	local ripple = kit.Blob(pool, 41, 5.5, 28, 5, C.White, { Z = 2, T = 0.6, Outline = false, Shade = false })
	kit.Animate(ripple, "Pulse", 0.35, 0.9, 0)
	-- colonne + vasque du milieu
	kit.Part(body, 43, 44, 14, 30, stone, { Radius = 3, Z = 5 })
	kit.Blob(body, 50, 47, 54, 18, stone, { Z = 6 })
	kit.Blob(body, 50, 42, 58, 10, rim, { Z = 7 })
	kit.Blob(body, 50, 42, 46, 5, water, { Z = 8, Outline = false })
	-- colonne + vasque du haut
	kit.Part(body, 47, 22, 6, 20, stone, { Radius = 2, Z = 9 })
	kit.Blob(body, 50, 25, 32, 10, stone, { Z = 10 })
	kit.Blob(body, 50, 21, 34, 6, rim, { Z = 11 })
	kit.Blob(body, 50, 21, 26, 3, water, { Z = 12, Outline = false })
	kit.Circle(body, 50, 15, 7, 7, stone, 0, 12)
	-- jets et rideaux d'eau
	kit.Line(body, 50, 13, 50, 1, 4, water, 0.2, 13)
	kit.Circle(body, 50, 1, 7, 5, C.White, 0.2, 13)
	for _, side in ipairs({ -1, 1 }) do
		kit.Line(body, 50 + side * 16, 22, 50 + side * 19, 40, 3, water, 0.3, 7)
		kit.Line(body, 50 + side * 28, 43, 50 + side * 33, 72, 4, water, 0.3, 4)
		kit.Line(body, 50 + side * 2, 4, 50 + side * 10, 14, 2, water, 0.3, 13)
	end
	for index, d in ipairs({ { 38, 8 }, { 62, 10 }, { 22, 58 }, { 80, 60 } }) do
		local drop = kit.Circle(body, d[1], d[2], 3, 4, water, 0.1, 13)
		kit.Animate(drop, "Bob", 2, 1.2, index * 1.3)
	end
	-- canard
	local duck = kit.Group(body, 62, 60, 20, 16, 9)
	kit.Blob(duck, 9, 12, 14, 8, C.Yellow, { Z = 1, Thickness = 1.2 })
	local head = kit.Blob(duck, 13, 5.5, 8, 8, C.Yellow, { Z = 2, Thickness = 1.2 })
	kit.Circle(head, 5, 3.2, 1.6, 1.8, C.Ink, 0, 2)
	kit.Blob(duck, 18, 6.5, 4, 2.5, C.Orange, { Z = 3, Outline = false })
	kit.Animate(duck, "Drift", 4, 0.3, 0)
	return nil
end

-- Gemme géante : diamant rose à facettes qui flotte sur un coussin de velours
Art.GiantGem = function(body, kit, _item)
	local C = kit.C
	local velvet = Color3.fromRGB(190, 130, 230)
	kit.Part(body, 14, 80, 72, 16, velvet, { Radius = 8, Z = 1 })
	kit.Blob(body, 50, 82, 68, 12, kit.Lighten(velvet, 0.15), { Z = 2, Shine = true })
	for _, x in ipairs({ 14, 86 }) do
		kit.Circle(body, x, 94, 6, 7, C.Gold, 0, 3)
	end
	local gem = kit.Group(body, 0, 0, 100, 100, 4)
	local ink = Color3.fromRGB(190, 80, 140)
	local light = Color3.fromRGB(255, 220, 238)
	local mid = Color3.fromRGB(255, 165, 206)
	local deep = Color3.fromRGB(240, 115, 175)
	-- contour
	kit.Box(gem, 33, 17.5, 34, 22, ink, 0, 1)
	wedge(kit, gem, 15, 17.5, 18.4, 21.5, "BR", ink, 0, 1)
	wedge(kit, gem, 66.6, 17.5, 18.4, 21.5, "BL", ink, 0, 1)
	wedge(kit, gem, 15, 38, 35.4, 44, "TR", ink, 0, 1)
	wedge(kit, gem, 49.6, 38, 35.4, 44, "TL", ink, 0, 1)
	-- couronne
	kit.Box(gem, 35, 20, 30, 18.5, light, 0, 2)
	wedge(kit, gem, 18, 20, 17.4, 18.5, "BR", mid, 0, 2)
	wedge(kit, gem, 64.6, 20, 17.4, 18.5, "BL", deep, 0, 2)
	-- pavillon
	wedge(kit, gem, 18, 38, 32.3, 40, "TR", mid, 0, 2)
	wedge(kit, gem, 49.7, 38, 32.3, 40, "TL", deep, 0, 2)
	wedge(kit, gem, 36, 38, 14.3, 40, "TR", light, 0, 3)
	wedge(kit, gem, 49.7, 38, 14.3, 40, "TL", mid, 0, 3)
	kit.Box(gem, 18, 37, 64, 2.5, C.White, 0.3, 4)
	kit.Line(gem, 36, 21, 42, 37, 1.2, C.White, 0.4, 4)
	kit.Line(gem, 64, 21, 58, 37, 1.2, C.White, 0.4, 4)
	kit.Shine(gem, 38, 23, 12, 4, 5, 0.25)
	kit.Face(gem, 50, 50, 20, { Eyes = "big", Mouth = "cat", Z = 6 })
	kit.Animate(gem, "Bob", 2, 0.8, 0)
	for index, s in ipairs({ { 14, 14, 12 }, { 88, 28, 9 }, { 84, 64, 7 }, { 12, 52, 7 } }) do
		local sp = kit.Sparkle(body, s[1], s[2], s[3], if index % 2 == 0 then C.White else C.PinkSoft, 0, 8)
		kit.Animate(sp, "Breathe", 0.25, 1.2, index * 1.4)
	end
	return { Glow = Color3.fromRGB(255, 170, 220) }
end

-- Planète flottante : sphère lilas souriante, anneau doré, petite lune, étoiles
Art.FloatingPlanet = function(body, kit, _item)
	local C = kit.C
	local g = kit.Group(body, 0, 0, 100, 100, 2)
	local ringA = C.Butter
	local ringB = C.Peach
	local function ring(parent, cx, cy, z)
		kit.Part(parent, cx - 51, cy - 11, 102, 22, C.White, { Radius = -1, T = 1, Outline = kit.OutlineOf(ringA), Thickness = 5.5, Shade = false, Z = z })
		kit.Part(parent, cx - 51, cy - 11, 102, 22, C.White, { Radius = -1, T = 1, Outline = ringA, Thickness = 3.5, Shade = false, Z = z + 1 })
		kit.Part(parent, cx - 43, cy - 7.5, 86, 15, C.White, { Radius = -1, T = 1, Outline = ringB, Thickness = 2, Shade = false, Z = z + 1 })
	end
	ring(g, 50, 54, 1)
	local planet = kit.Blob(g, 50, 50, 56, 56, Color3.fromRGB(200, 172, 255), { Z = 4, Shine = true })
	kit.Blob(planet, 28, 16, 44, 7, C.PinkSoft, { Z = 2, Outline = false, Shade = false, T = 0.3 })
	kit.Blob(planet, 28, 42, 48, 8, C.Pink, { Z = 2, Outline = false, Shade = false, T = 0.5 })
	kit.Face(planet, 28, 30, 24, { Eyes = "big", Mouth = "smile", Z = 3 })
	local front = kit.Group(g, 0, 54, 100, 20, 6, true)
	ring(front, 50, 0, 1)
	kit.Animate(g, "Bob", 3, 0.6, 0)
	local moon = kit.Blob(body, 88, 16, 13, 13, C.Cream, { Z = 3 })
	kit.Circle(moon, 4, 5, 3, 3, C.Grey, 0.3, 2)
	kit.Circle(moon, 8.5, 8.5, 2, 2, C.Grey, 0.3, 2)
	kit.Animate(moon, "Bob", 2, 0.9, 2)
	for index, s in ipairs({ { 12, 18, 10 }, { 14, 84, 8 }, { 86, 86, 9 } }) do
		local sp = kit.Sparkle(body, s[1], s[2], s[3], if index == 2 then C.Butter else C.White, 0, 3)
		kit.Animate(sp, "Breathe", 0.2, 1.2, index)
	end
	return { Glow = Color3.fromRGB(210, 180, 255), WallShadow = Vector2.new(0, 0) }
end

return Art
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="20">
              <Properties>
                <string name="Name">Doors</string>
                <string name="Source"><![CDATA[--[[
	Doors (ModuleScript) — dessins 🚪 Portes
	Emplacement : ReplicatedStorage > Client > Components > House > Art > Doors
	Contrat : voir HouseArt (boîte 100 x 100, pieds en bas pour les objets au sol).
	Les portes sont posées au sol (y = 100), contre le mur.
]]

local Art = {}

local WHITE = Color3.new(1, 1, 1)

----------------------------------------------------------------------
-- Aides partagées
----------------------------------------------------------------------

-- Forme en arche posée au sol : coins arrondis en haut seulement (le bas est
-- coupé net à y = 100). Renvoie la forme (ses enfants se placent dedans).
local function arch(parent, kit, x, y, w, color, radius, z, options)
	local pad = 3
	local g = kit.Group(parent, x - pad, y - pad, w + pad * 2, 100 - y + pad, z, true)
	local opts = options or {}
	opts.Radius = radius
	opts.Z = 1
	return kit.Part(g, pad, pad, w, 100 - y + radius + 4, color, opts)
end

-- Poignée ronde dorée avec reflet
local function knob(parent, kit, cx, cy, size, color)
	local k = kit.Blob(parent, cx, cy, size, size, color or kit.C.Gold, { Z = 6 })
	kit.Circle(k, size * 0.34, size * 0.32, size * 0.3, size * 0.3, WHITE, 0.3, 2)
	return k
end

-- Paillasson devant la porte
local function doormat(parent, kit, cx, w, color)
	local mat = kit.Part(parent, cx - w / 2, 95, w, 5, color, { Radius = 2, Z = 7, Shade = 0.1 })
	for i = 0, math.floor(w / 6) - 1 do
		kit.Box(mat, 2 + i * 6, 0.5, 1.2, 4, kit.Lighten(color, 0.3), 0.3, 2)
	end
	return mat
end

----------------------------------------------------------------------
-- Dessins
----------------------------------------------------------------------

-- Porte en bois classique : chambranle, 4 panneaux, couronne de feuilles, poignée dorée
Art.WoodenDoor = function(body, kit, _item)
	local C = kit.C
	arch(body, kit, 16, 2, 68, C.WoodDark, 10, 1, { Shade = 0.15 })
	local door = arch(body, kit, 22, 8, 56, C.Wood, 6, 2, { Shade = 0.18 })
	for _, x in ipairs({ 16, 38 }) do
		kit.Box(door, x, 0, 1, 92, C.WoodDark, 0.8, 2) -- veines du bois
	end
	for _, p in ipairs({ { 5, 8, 21, 32 }, { 30, 8, 21, 32 }, { 5, 48, 21, 38 }, { 30, 48, 21, 38 } }) do
		local panel = kit.Part(door, p[1], p[2], p[3], p[4], C.WoodLight, { Radius = 4, Z = 2, Shade = 0.2 })
		kit.Box(panel, 2, 2, p[3] - 4, 2, WHITE, 0.6, 2)
	end
	-- charnières
	for _, y in ipairs({ 18, 76 }) do
		kit.Part(body, 20, y, 5, 8, C.GreyDark, { Radius = 1, Z = 4 })
	end
	-- couronne de feuilles
	local wreath = kit.Group(body, 30, 10, 40, 40, 5)
	kit.Line(wreath, 20, 0, 20, 8, 1.4, C.Red, 0, 1) -- ruban
	for i = 0, 11 do
		local a = math.rad(i * 30)
		local leaf = kit.Blob(wreath, 20 + math.cos(a) * 10, 20 + math.sin(a) * 10, 10, 7, i % 2 == 0 and C.Leaf or C.LeafDark, { Z = 2, Rotation = i * 30 + 90, Thickness = 1.2 })
		leaf.ZIndex = 2 + i % 2
	end
	for _, b in ipairs({ { 12, 13 }, { 29, 15 }, { 26, 28 } }) do
		kit.Circle(wreath, b[1], b[2], 4, 4, C.Red, 0, 4)
	end
	kit.Blob(wreath, 15, 31, 9, 7, C.Pink, { Z = 5, Rotation = -20 })
	kit.Blob(wreath, 25, 31, 9, 7, C.Pink, { Z = 5, Rotation = 20 })
	kit.Circle(wreath, 20, 31, 4.5, 4.5, C.PinkDeep, 0, 6)
	-- poignée et serrure
	local plate = kit.Part(body, 66, 54, 7, 16, C.Butter, { Radius = 3, Z = 5 })
	kit.Circle(plate, 3.5, 11, 2.2, 2.2, C.Ink, 0, 2)
	kit.Box(plate, 3, 11, 1, 3, C.Ink, 0, 2)
	knob(body, kit, 69.5, 60, 8)
	doormat(body, kit, 50, 50, C.Blush)
	kit.Heart(body, 50, 97.5, 4, WHITE, 0, 8)
	return nil
end

-- Trou de souris : arche en bois, souris qui pointe le museau, morceau de fromage
Art.MouseHole = function(body, kit, _item)
	local C = kit.C
	arch(body, kit, 10, 20, 80, C.WoodLight, 40, 1, { Shade = 0.15 })
	local hole = arch(body, kit, 18, 28, 64, Color3.fromRGB(78, 52, 72), 32, 2, { Outline = C.WoodDark, Shade = false })
	kit.Gradient(hole, Color3.fromRGB(150, 150, 150), WHITE, 90)
	-- souris qui dépasse
	local mouse = kit.Group(body, 20, 50, 50, 50, 3)
	kit.Animate(mouse, "Bob", 1.5, 0.8, 0)
	for _, x in ipairs({ 12, 36 }) do
		local ear = kit.Blob(mouse, x, 18, 18, 18, C.Grey, { Z = 1 })
		kit.Circle(ear, 9, 9, 11, 11, C.PinkSoft, 0, 2)
	end
	local head = kit.Blob(mouse, 24, 34, 34, 30, C.Grey, { Z = 2, Shine = true })
	kit.Face(head, 17, 14, 22, { Eyes = "big", Mouth = "cat", Z = 3 })
	kit.Circle(head, 17, 19, 4, 3, C.Pink, 0, 4) -- nez
	for _, side in ipairs({ -1, 1 }) do
		kit.Line(mouse, 24 + side * 10, 38, 24 + side * 20, 36, 1, C.GreyDark, 0.2, 4)
		kit.Line(mouse, 24 + side * 10, 40, 24 + side * 20, 42, 1, C.GreyDark, 0.2, 4)
		kit.Blob(mouse, 24 + side * 8, 48, 8, 5, C.PinkSoft, { Z = 5 }) -- pattes
	end
	-- fromage
	local cheese = kit.Part(body, 72, 84, 24, 14, C.Butter, { Radius = 3, Z = 5, Outline = C.Gold, Shade = 0.15 })
	kit.Part(body, 72, 80, 24, 6, kit.Lighten(C.Butter, 0.3), { Radius = 3, Z = 4, Outline = C.Gold, Rotation = -6 })
	for _, h in ipairs({ { 5, 5, 4 }, { 14, 8, 3 }, { 19, 3, 2.5 } }) do
		kit.Circle(cheese, h[1], h[2], h[3], h[3], C.Gold, 0.2, 2)
	end
	kit.Heart(body, 50, 12, 10, C.Pink, 0, 4)
	return nil
end

-- Porte de jardin : arche verte, vitre avec ciel, vigne fleurie, pot de fleurs
Art.GardenDoor = function(body, kit, _item)
	local C = kit.C
	local sage = Color3.fromRGB(150, 206, 168)
	arch(body, kit, 16, 2, 68, C.Cream, 34, 1, { Shade = 0.12 })
	local door = arch(body, kit, 22, 8, 56, sage, 28, 2, { Shade = 0.18 })
	-- fenêtre en arche
	local glass = kit.Part(door, 8, 6, 40, 38, C.Glass, { Radius = 20, Z = 2, Outline = C.Cream, Thickness = 2.5, Shade = false })
	kit.Gradient(glass, C.Sky, WHITE, 90)
	kit.Cloud(glass, 14, 26, 14, WHITE, 0.1, 2)
	kit.Circle(glass, 30, 10, 7, 7, C.Butter, 0, 2)
	kit.Box(glass, 19, 0, 2.4, 38, C.Cream, 0, 3)
	kit.Box(glass, 0, 22, 40, 2.4, C.Cream, 0, 3)
	kit.Shine(glass, 5, 10, 3, 10, 4, 0.4)
	-- panneau bas avec tulipe
	local panel = kit.Part(door, 10, 52, 36, 32, kit.Lighten(sage, 0.3), { Radius = 5, Z = 2, Shade = 0.15 })
	kit.Line(panel, 18, 26, 18, 14, 1.6, C.LeafDark, 0, 2)
	kit.Blob(panel, 13, 21, 8, 4, C.Leaf, { Z = 2, Rotation = -30, Outline = false, Shade = false })
	kit.Blob(panel, 18, 11, 9, 10, C.Pink, { Z = 3, Outline = false, Shade = false })
	knob(body, kit, 70, 62, 8, C.Gold)
	-- vigne fleurie sur le chambranle
	local leaves = { { 16, 84 }, { 20, 70 }, { 15, 56 }, { 19, 42 }, { 23, 28 }, { 31, 16 }, { 44, 8 }, { 58, 6 } }
	for i, p in ipairs(leaves) do
		kit.Blob(body, p[1], p[2], 9, 6, i % 2 == 0 and C.Leaf or C.LeafDark, { Z = 5, Rotation = i * 40, Thickness = 1.2 })
	end
	for i, p in ipairs({ { 18, 62 }, { 22, 36 }, { 38, 10 }, { 64, 8 }, { 17, 92 } }) do
		local color = ({ C.Pink, C.Butter, C.Lilac, C.Pink, C.Butter })[i]
		local f = kit.Circle(body, p[1], p[2], 7, 7, color, 0, 6)
		kit.Stroke(f, kit.OutlineOf(color), 1)
		kit.Circle(f, 3.5, 3.5, 2.6, 2.6, i % 2 == 0 and C.Orange or C.Yellow, 0, 2)
	end
	-- pot de fleurs
	kit.Part(body, 80, 84, 16, 15, C.Orange, { Radius = 3, Z = 6, Shade = 0.2, Shine = true })
	kit.Part(body, 78, 82, 20, 5, kit.Lighten(C.Orange, 0.2), { Radius = 2, Z = 7 })
	kit.Blob(body, 84, 76, 8, 12, C.Leaf, { Z = 5, Rotation = -25 })
	kit.Blob(body, 93, 76, 8, 12, C.LeafDark, { Z = 5, Rotation = 25 })
	local bloom = kit.Blob(body, 88, 68, 12, 12, C.Pink, { Z = 6 })
	kit.Circle(bloom, 6, 6, 5, 5, C.Butter, 0, 2)
	kit.Animate(bloom, "Sway", 6, 0.8, 0)
	return nil
end

-- Porte cœur : rose, grande fenêtre en cœur, poignée cœur, guirlande de petits cœurs
Art.HeartDoor = function(body, kit, _item)
	local C = kit.C
	local pink = Color3.fromRGB(255, 168, 206)
	arch(body, kit, 16, 6, 68, C.PinkDeep, 14, 1, { Shade = 0.15 })
	local door = arch(body, kit, 22, 12, 56, pink, 10, 2, { Shade = 0.2 })
	-- fenêtre cœur
	kit.Heart(door, 28, 24, 38, C.PinkMist, 0, 2)
	local glass = kit.Heart(door, 28, 24.5, 33, C.Glass, 0, 3)
	for _, child in ipairs(glass:GetChildren()) do
		kit.Gradient(child, WHITE, C.PinkSoft, 90)
	end
	kit.Heart(door, 28, 25, 12, C.Heart, 0.15, 4)
	kit.Shine(door, 16, 14, 7, 3, 5, 0.3)
	-- panneau bas
	local panel = kit.Part(door, 9, 50, 38, 32, kit.Lighten(pink, 0.3), { Radius = 8, Z = 2, Shade = 0.15 })
	for i = 0, 2 do
		kit.Heart(panel, 9 + i * 10, 16, 6, C.PinkDeep, 0.3, 2)
	end
	-- poignée cœur
	kit.Heart(body, 70, 60, 9, C.Gold, 0, 6)
	kit.Circle(body, 68.5, 58, 2.4, 2.4, WHITE, 0.3, 7)
	-- cœur au fronton + petits cœurs
	kit.Heart(body, 50, 6, 17, kit.OutlineOf(C.Heart), 0, 4)
	local top = kit.Heart(body, 50, 6.3, 14, C.Heart, 0, 5)
	kit.Animate(top, "Breathe", 0.06, 1.6, 0)
	for i, x in ipairs({ 36, 64 }) do
		local h = kit.Heart(body, x, 5, 7, C.Lilac, 0, 4)
		kit.Animate(h, "Bob", 1.5, 1, i * 1.5)
	end
	doormat(body, kit, 50, 48, C.PinkDeep)
	return nil
end

-- Porte shoji coulissante : treillis de bois, papier crème, branche de sakura, entrouverte
Art.ShojiDoor = function(body, kit, _item)
	local C = kit.C
	local wood = Color3.fromRGB(200, 146, 106)
	local paper = Color3.fromRGB(255, 250, 238)
	kit.Part(body, 8, 2, 84, 98, C.WoodDark, { Radius = 3, Z = 1, Shade = 0.1 })
	-- lumière chaude dans l'entrebâillement
	local light = kit.Box(body, 13, 7, 14, 90, C.Butter, 0, 2)
	kit.Gradient(light, kit.Lighten(C.Butter, 0.4), C.Peach, 90)
	kit.Animate(light, "Pulse", 0.15, 0.6, 0)
	local function panel(x, z)
		local p = kit.Part(body, x, 7, 38, 91, wood, { Radius = 2, Z = z, Shade = 0.12 })
		local sheet = kit.Part(p, 4, 4, 30, 79, paper, { Radius = 0, Z = 2, Outline = false, Shade = 0.05 })
		for i = 1, 2 do
			kit.Box(sheet, i * 10 - 0.8, 0, 1.6, 79, wood, 0, 4)
		end
		for i = 1, 5 do
			kit.Box(sheet, 0, i * 13.2 - 0.8, 30, 1.6, wood, 0, 4)
		end
		kit.Box(p, 4, 84, 30, 1.4, kit.OutlineOf(wood), 0.5, 3)
		return p, sheet
	end
	local left = panel(26, 3)
	local right, sheet = panel(50, 4)
	kit.Circle(left, 5, 46, 4, 7, C.WoodDark, 0.3, 3) -- poignée creuse
	kit.Circle(right, 33, 46, 4, 7, C.WoodDark, 0.3, 3)
	-- branche de sakura peinte
	kit.Line(sheet, 30, 12, 14, 26, 2, C.Brown, 0.1, 3)
	kit.Line(sheet, 20, 21, 12, 14, 1.4, C.Brown, 0.1, 3)
	kit.Line(sheet, 16, 24, 6, 32, 1.4, C.Brown, 0.1, 3)
	for i, p in ipairs({ { 24, 17 }, { 12, 13 }, { 16, 27 }, { 6, 32 }, { 28, 11 } }) do
		local b = kit.Circle(sheet, p[1], p[2], 6 - (i % 2), 6 - (i % 2), C.Pink, 0.05, 5)
		kit.Circle(b, (6 - (i % 2)) / 2, (6 - (i % 2)) / 2, 2, 2, C.PinkDeep, 0, 2)
	end
	-- pétales qui tombent
	for i, p in ipairs({ { 20, 60 }, { 84, 70 } }) do
		local petal = kit.Blob(body, p[1], p[2], 5, 3.5, C.PinkSoft, { Z = 7, Rotation = 30 * i, Thickness = 1 })
		kit.Animate(petal, "Bob", 3, 0.7, i * 1.5)
	end
	return nil
end

-- Portique torii vermillon : linteau relevé, plaque, corde shimenawa et clochette
Art.ToriiGate = function(body, kit, _item)
	local C = kit.C
	local red = Color3.fromRGB(250, 112, 102)
	local black = Color3.fromRGB(84, 58, 84)
	-- piliers
	for _, x in ipairs({ 22, 70 }) do
		kit.Part(body, x, 26, 9, 68, red, { Radius = 2, Z = 2, Shade = 0.2 })
		kit.Part(body, x - 2, 88, 13, 12, black, { Radius = 2, Z = 3 })
		kit.Box(body, x + 2, 30, 2, 56, WHITE, 0.7, 3)
	end
	-- nuki (traverse basse)
	kit.Part(body, 10, 36, 80, 7, red, { Radius = 2, Z = 4, Shade = 0.15 })
	-- plaque centrale
	kit.Part(body, 46, 22, 8, 16, red, { Radius = 1, Z = 3 })
	local plaque = kit.Part(body, 42, 21, 16, 14, black, { Radius = 2, Z = 5, Outline = C.Gold, Thickness = 1.6 })
	kit.Heart(plaque, 8, 7, 7, C.Gold, 0, 2)
	-- shimaki + kasagi (linteau aux bouts relevés)
	kit.Part(body, 8, 17, 84, 7, red, { Radius = 2, Z = 4, Shade = 0.15 })
	kit.Part(body, 10, 8, 80, 10, black, { Radius = 3, Z = 5, Shine = true })
	kit.Part(body, -1, 5, 24, 9, black, { Radius = 4, Z = 4, Rotation = 9 })
	kit.Part(body, 77, 5, 24, 9, black, { Radius = 4, Z = 4, Rotation = -9 })
	-- corde sacrée avec papiers zigzag
	local rope = kit.Part(body, 24, 45, 52, 6, C.Butter, { Radius = -1, Z = 5, Outline = C.Gold })
	for i = 0, 5 do
		kit.Line(rope, 4 + i * 8, 1, 8 + i * 8, 5, 1.2, C.Gold, 0.2, 2)
	end
	for _, x in ipairs({ 32, 68 }) do
		local paper = kit.Group(body, x - 4, 50, 8, 16, 5)
		for k = 0, 3 do
			kit.Part(paper, (k % 2) * 3, k * 4, 5, 4.4, WHITE, { Radius = 0.5, Z = 1, Outline = C.Grey, Thickness = 1, Shade = false })
		end
		kit.Animate(paper, "Sway", 5, 0.8, x)
	end
	-- clochette qui se balance
	local bell = kit.Pivot(body, 50, 50, 6)
	kit.Line(bell, 0, 0, 0, 10, 1.2, C.Red, 0, 1)
	local b = kit.Blob(bell, 0, 15, 11, 11, C.Gold, { Z = 2, Shine = true })
	kit.Box(b, 2, 6.5, 7, 1.2, kit.OutlineOf(C.Gold), 0.3, 2)
	kit.Animate(bell, "Sway", 10, 0.9, 0)
	-- pétales
	for i, p in ipairs({ { 40, 70 }, { 60, 80 }, { 86, 60 } }) do
		local petal = kit.Blob(body, p[1], p[2], 5, 3.5, C.PinkSoft, { Z = 7, Rotation = 40 * i, Thickness = 1 })
		kit.Animate(petal, "Drift", 3, 0.6, i)
	end
	return nil
end

-- Bibliothèque secrète : étagères de livres, un livre-levier penché, clé suspendue, rai de lumière
Art.SecretDoor = function(body, kit, _item)
	local C = kit.C
	-- rai de lumière derrière (porte entrouverte)
	local ray = kit.Box(body, 84, 4, 6, 96, C.Butter, 0, 1)
	kit.Gradient(ray, C.Butter, C.Orange, 90)
	kit.Animate(ray, "Pulse", 0.35, 0.7, 0)
	kit.Part(body, 10, 2, 76, 98, C.WoodDark, { Radius = 4, Z = 2, Shade = 0.12 })
	local back = kit.Part(body, 15, 7, 66, 88, Color3.fromRGB(120, 78, 64), { Radius = 2, Z = 3, Outline = false })
	kit.Gradient(back, Color3.fromRGB(170, 170, 170), WHITE, 90)
	for _, y in ipairs({ 27, 49, 71 }) do
		kit.Part(body, 13, y, 70, 4, C.Wood, { Radius = 1, Z = 5, Shade = false })
	end
	kit.Part(body, 13, 93, 70, 7, C.Wood, { Radius = 1, Z = 5 })
	-- livres (largeur, hauteur, couleur) posés sur chaque planche
	local P = { C.Pink, C.Mint, C.Lilac, C.Sky, C.Butter, C.Peach, C.PinkDeep, C.Blue, C.Leaf }
	local shelves = {
		{ y = 27, books = { { 6, 16, 1 }, { 5, 14, 4 }, { 7, 17, 3 }, { 5, 12, 5 }, { 6, 15, 2 } } },
		{ y = 49, books = { { 6, 16, 8 }, { 7, 14, 6 }, { 5, 15, 9 }, { 6, 13, 1 } } },
		{ y = 71, books = { { 5, 15, 2 }, { 6, 17, 7 }, { 5, 13, 4 }, { 7, 16, 3 }, { 5, 14, 5 }, { 6, 15, 6 } } },
		{ y = 93, books = { { 8, 18, 3 }, { 7, 16, 1 }, { 6, 17, 4 }, { 8, 15, 5 } } },
	}
	for s, shelf in ipairs(shelves) do
		local x = s == 1 and 30 or 17
		for i, bk in ipairs(shelf.books) do
			local color = P[bk[3]]
			local book = kit.Part(body, x, shelf.y - bk[2], bk[1], bk[2], color, { Radius = 1.5, Z = 4, Thickness = 1.2, Shade = 0.15 })
			if (i + s) % 3 == 0 then
				kit.Box(book, 0, 3, bk[1], 1.6, kit.Lighten(color, 0.5), 0, 2)
			end
			x += bk[1] + 1
		end
	end
	-- livre-levier penché (étagère 2)
	local lever = kit.Part(body, 48, 33, 6, 16, C.Red, { Radius = 1.5, Z = 4, Rotation = 18, Thickness = 1.2 })
	kit.Box(lever, 0, 3, 6, 1.6, C.Gold, 0, 2)
	-- petite plante (étagère 1)
	kit.Part(body, 18, 19, 10, 8, C.Orange, { Radius = 2, Z = 4 })
	kit.Blob(body, 20, 15, 6, 9, C.Leaf, { Z = 3, Rotation = -20 })
	kit.Blob(body, 26, 15, 6, 9, C.LeafDark, { Z = 3, Rotation = 20 })
	-- boîte à cœur (étagère 3)
	local box = kit.Part(body, 60, 61, 16, 10, C.PinkSoft, { Radius = 2, Z = 4 })
	kit.Heart(box, 8, 5, 6, C.Heart, 0, 2)
	-- globe (étagère 4)
	kit.Part(body, 63, 88, 12, 5, C.Gold, { Radius = 2, Z = 4 })
	local globe = kit.Blob(body, 69, 80, 14, 14, C.Sky, { Z = 4, Shine = true })
	kit.Blob(globe, 5, 6, 6, 5, C.Leaf, { Z = 2, Outline = false, Shade = false })
	-- clé suspendue
	local key = kit.Pivot(body, 76, 9, 7)
	kit.Circle(key, 0, 0, 2.4, 2.4, C.GreyDark, 0, 1)
	local ring = kit.Part(key, -3.5, 1, 7, 7, WHITE, { T = 1, Radius = -1, Outline = C.Gold, Thickness = 2, Shade = false })
	ring.ZIndex = 2
	kit.Box(key, -0.9, 8, 1.8, 11, C.Gold, 0, 2)
	kit.Box(key, 0.9, 14, 3, 1.6, C.Gold, 0, 2)
	kit.Box(key, 0.9, 17, 2.4, 1.6, C.Gold, 0, 2)
	kit.Animate(key, "Sway", 8, 0.8, 0)
	return nil
end

-- Ascenseur privé : cadre doré, portes argentées au cœur, cadran à aiguille, boutons d'appel
Art.Elevator = function(body, kit, _item)
	local C = kit.C
	local silver = Color3.fromRGB(226, 224, 242)
	kit.Part(body, 10, 2, 80, 98, C.Butter, { Radius = 6, Z = 1, Outline = C.Gold, Shade = 0.15 })
	kit.Part(body, 17, 26, 66, 74, Color3.fromRGB(150, 140, 180), { Radius = 3, Z = 2 })
	-- portes
	for i = 0, 1 do
		local d = kit.Part(body, 19 + i * 31.5, 28, 30.5, 72, silver, { Radius = 1, Z = 3, Outline = Color3.fromRGB(170, 166, 200), Thickness = 1.2, Shade = false })
		kit.Gradient(d, i == 0 and WHITE or Color3.fromRGB(215, 212, 232), i == 0 and Color3.fromRGB(215, 212, 232) or WHITE, 0)
		local inset = kit.Part(d, 4, 6, 22.5, 60, silver, { Radius = 2, Z = 2, Outline = Color3.fromRGB(190, 186, 214), Thickness = 1, Shade = false })
		inset.BackgroundTransparency = 1
		kit.Shine(d, 6 + i * 12, 8, 3, 30, 4, 0.5)
	end
	kit.Heart(body, 50, 56, 22, C.PinkSoft, 0, 4)
	kit.Heart(body, 50, 56.5, 14, C.Pink, 0, 5)
	kit.Box(body, 49.4, 28, 1.2, 72, Color3.fromRGB(150, 140, 180), 0, 6) -- jointure
	-- cadran d'étage
	local dialGroup = kit.Group(body, 32, 4, 36, 21, 3, true)
	kit.Part(dialGroup, 3, 3, 30, 30, C.Cream, { Radius = -1, Outline = C.Gold, Thickness = 2 })
	for i = 0, 4 do
		local a = math.rad(180 + i * 45)
		kit.Circle(body, 50 + math.cos(a) * 11, 22 + math.sin(a) * 11, 2.4, 2.4, i == 2 and C.Heart or C.GreyDark, 0, 5)
	end
	local needle = kit.Pivot(body, 50, 22, 6)
	kit.Line(needle, 0, 0, 0, -10, 1.8, C.Red, 0, 1)
	needle.Rotation = -30
	kit.Animate(needle, "Sway", 55, 0.3, 0)
	kit.Circle(body, 50, 22, 4, 4, C.Gold, 0, 7)
	-- boutons d'appel
	local panel = kit.Part(body, 86, 48, 10, 22, C.Gold, { Radius = 3, Z = 6, Shine = true })
	kit.Circle(panel, 5, 6, 5, 5, C.Cream, 0, 2)
	local lit = kit.Circle(panel, 5, 15, 5, 5, C.Heart, 0, 2)
	kit.Animate(lit, "Pulse", 0.5, 1.5, 0)
	kit.Sparkle(body, 16, 12, 8, WHITE, 0, 6)
	kit.Sparkle(body, 84, 16, 6, WHITE, 0, 6)
	return nil
end

-- Porte en bonbons : tablette de chocolat, glaçage coulant, sucres d'orge, sucettes, bonbon-poignée
Art.CandyDoor = function(body, kit, _item)
	local C = kit.C
	local choco = Color3.fromRGB(160, 104, 86)
	-- porte chocolat
	local door = arch(body, kit, 24, 14, 52, choco, 8, 2, { Shade = 0.15 })
	for row = 0, 3 do
		for col = 0, 1 do
			kit.Part(door, 5 + col * 22, 10 + row * 19, 20, 16, kit.Lighten(choco, 0.12), { Radius = 3, Z = 2, Shade = 0.3, Thickness = 1.2 })
		end
	end
	-- glaçage rose coulant
	kit.Part(body, 20, 8, 60, 12, C.PinkSoft, { Radius = 6, Z = 4, Shade = 0.08 })
	for _, d in ipairs({ { 28, 12 }, { 41, 8 }, { 55, 14 }, { 68, 9 } }) do
		kit.Part(body, d[1], 14, 6, d[2], C.PinkSoft, { Radius = -1, Z = 3, Shade = false })
	end
	for i, s in ipairs({ { 26, 11, 30 }, { 35, 14, -40 }, { 46, 10, 10 }, { 57, 13, 60 }, { 66, 10, -20 }, { 74, 13, 45 } }) do
		local color = ({ C.Mint, C.Butter, C.Sky, C.Lilac, C.Heart, C.Orange })[i]
		kit.Part(body, s[1] - 2, s[2] - 0.8, 4, 1.8, color, { Radius = -1, Z = 5, Outline = false, Shade = false, Rotation = s[3] })
	end
	-- poignée bonbon emballé
	kit.Diamond(body, 63, 60, 6, C.Mint, 0, 5)
	kit.Diamond(body, 75, 60, 6, C.Mint, 0, 5)
	local candy = kit.Blob(body, 69, 60, 10, 8, C.Mint, { Z = 6, Shine = true })
	kit.Box(candy, 3, 0, 1.6, 8, WHITE, 0.3, 2)
	-- sucres d'orge (montants rayés)
	for _, x in ipairs({ 12, 78 }) do
		local post = kit.Part(body, x, 26, 10, 74, WHITE, { Radius = 3, Z = 3, Shade = 0.15, Outline = kit.OutlineOf(C.Pink) })
		local stripes = kit.Group(post, 0, 0, 10, 74, 2, true)
		for i = 0, 7 do
			kit.Box(stripes, -4, 2 + i * 9.5, 18, 3.2, C.Pink, 0, 1).Rotation = -35
		end
		-- sucette au sommet
		local pop = kit.Blob(body, x + 5, 20, 20, 20, C.Pink, { Z = 4, Outline = kit.OutlineOf(C.Pink) })
		kit.Circle(pop, 10, 10, 14, 14, WHITE, 0, 2)
		kit.Circle(pop, 10, 10, 9, 9, x < 50 and C.Mint or C.Lilac, 0, 3)
		kit.Circle(pop, 10, 10, 4, 4, WHITE, 0, 4)
		kit.Circle(pop, 6, 5, 4, 3, WHITE, 0.4, 5)
		kit.Animate(pop, "Spin", 1, x < 50 and 0.12 or -0.12, 0)
	end
	-- boules de gomme au sol
	for i, g in ipairs({ { 28, C.Mint }, { 38, C.Butter }, { 72, C.Lilac } }) do
		local drop = kit.Part(body, g[1] - 5, 91, 10, 9, g[2], { Radius = 4, Z = 7, Shine = true })
		kit.Round(drop, 5)
		if i == 2 then
			kit.Animate(drop, "Bob", 0.8, 1, 0)
		end
	end
	kit.Heart(body, 50, 46, 12, C.Heart, 0, 5)
	return nil
end

-- Portail des rêves : arche nacrée, tourbillon étoilé qui tourne, cœur lumineux, nuages
Art.DreamPortal = function(body, kit, _item)
	local C = kit.C
	local frame = arch(body, kit, 10, 4, 80, C.LilacSoft, 40, 1, { Outline = C.Gold, Thickness = 2.2, Shade = 0.12 })
	kit.Gradient(frame, WHITE, C.PinkSoft, 90)
	local portal = arch(body, kit, 19, 13, 62, C.Purple, 31, 2, { Outline = kit.Lighten(C.Gold, 0.3), Thickness = 2, Shade = false })
	kit.Gradient(portal, Color3.fromRGB(110, 70, 200), Color3.fromRGB(255, 130, 200), 90)
	-- tourbillon (bras en spirale) qui tourne
	local swirl = kit.Pivot(body, 50, 56, 3)
	local colors = { C.PinkSoft, kit.Lighten(C.Sky, 0.3), C.LilacSoft, kit.Lighten(C.Pink, 0.3), kit.Lighten(C.Mint, 0.4) }
	for i = 0, 4 do
		local a0 = math.rad(i * 72)
		local pts = {}
		for k = 0, 3 do
			local r = 5 + k * 7.5
			local a = a0 + math.rad(k * 42)
			table.insert(pts, { math.cos(a) * r, math.sin(a) * r })
		end
		for k = 1, 3 do
			kit.Line(swirl, pts[k][1], pts[k][2], pts[k + 1][1], pts[k + 1][2], 6.5 - k * 1.4, colors[i + 1], 0, 1)
		end
	end
	kit.Animate(swirl, "Spin", 1, 0.18, 0)
	local halo = kit.Circle(body, 50, 56, 26, 26, C.PinkSoft, 0.55, 4)
	kit.Animate(halo, "Pulse", 0.3, 1.2, 0)
	local core = kit.Circle(body, 50, 56, 14, 14, WHITE, 0.1, 5)
	kit.Animate(core, "Breathe", 0.1, 1.5, 0)
	kit.Heart(body, 50, 56, 8, C.Heart, 0, 6)
	-- étoiles dans le portail
	for i, s in ipairs({ { 34, 30, 6 }, { 64, 78, 7 } }) do
		local star = kit.Sparkle(body, s[1], s[2], s[3], WHITE, 0, 5)
		kit.Animate(star, "Bob", 2, 0.9, i * 1.3)
	end
	-- lune sur la clé de voûte
	kit.Circle(body, 50, 6, 14, 14, C.Butter, 0, 6)
	kit.Circle(body, 54, 4, 11, 11, C.LilacSoft, 0, 7)
	-- étoiles autour de l'arche
	for i, s in ipairs({ { 6, 20, 9, C.Butter }, { 94, 30, 8, C.Pink }, { 96, 8, 6, C.Sky }, { 4, 52, 6, C.Lilac } }) do
		local star = kit.Sparkle(body, s[1], s[2], s[3], s[4], 0, 6)
		kit.Animate(star, "Breathe", 0.2, 1.3, i)
	end
	-- nuages au pied
	kit.Cloud(body, 14, 101, 30, WHITE, 0, 8)
	kit.Cloud(body, 86, 101, 28, WHITE, 0, 8)
	kit.Cloud(body, 50, 102, 22, C.PinkMist, 0, 8)
	return { Glow = Color3.fromRGB(190, 140, 255) }
end

return Art
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="21">
              <Properties>
                <string name="Name">Electronics</string>
                <string name="Source"><![CDATA[--[[
	Electronics (ModuleScript) — dessins 📺 Électronique
	Emplacement : ReplicatedStorage > Client > Components > House > Art > Electronics
	Contrat : voir HouseArt (boîte 100 x 100, pieds en bas pour les objets au sol).
]]

local Art = {}

local WHITE = Color3.new(1, 1, 1)

----------------------------------------------------------------------
-- Aides partagées
----------------------------------------------------------------------

-- Petits pixels : lignes de "x" / "." regroupées en bandes (peu de Frames)
local function pixels(parent, kit, x, y, size, rows, color, z)
	for r, row in ipairs(rows) do
		local start = nil
		for c = 1, #row + 1 do
			local on = c <= #row and row:sub(c, c) == "x"
			if on and not start then
				start = c
			elseif not on and start then
				kit.Box(parent, x + (start - 1) * size, y + (r - 1) * size, (c - start) * size, size, color, 0, z)
				start = nil
			end
		end
	end
end

local PIXEL_HEART = {
	".xx.xx.",
	"xxxxxxx",
	"xxxxxxx",
	".xxxxx.",
	"..xxx..",
	"...x...",
}

local PIXEL_INVADER = {
	"..x.....x..",
	"...x...x...",
	"..xxxxxxx..",
	".xx.xxx.xx.",
	"xxxxxxxxxxx",
	"x.xxxxxxx.x",
	"x.x.....x.x",
	"...xx.xx...",
}

-- Écran lumineux : dégradé, voile qui pulse doucement, reflet de verre
local function screen(parent, kit, x, y, w, h, top, bottom, z, radius, phase)
	local s = kit.Part(parent, x, y, w, h, WHITE, {
		Radius = radius or 4,
		Z = z,
		Outline = kit.C.Ink,
		Thickness = 1.2,
		Shade = false,
	})
	kit.Gradient(s, top, bottom, 90)
	local veil = kit.Box(s, 0, 0, w, h, WHITE, 0.82, 7)
	kit.Round(veil, radius or 4)
	kit.Animate(veil, "Pulse", 0.18, 1, phase or 0)
	kit.Shine(s, w * 0.08, h * 0.08, w * 0.3, math.max(1.5, h * 0.06), 8, 0.45)
	return s
end

-- Note de musique (tête ovale + hampe + crochet) ; renvoie son conteneur
local function note(parent, kit, cx, cy, s, color, z)
	local g = kit.Group(parent, cx - s / 2, cy - s / 2, s, s, z)
	kit.Blob(g, s * 0.35, s * 0.8, s * 0.46, s * 0.36, color, { Rotation = -20, Outline = false, Shade = false, Z = 2 })
	kit.Box(g, s * 0.52, s * 0.08, math.max(1.2, s * 0.12), s * 0.74, color, 0, 2)
	kit.Line(g, s * 0.58, s * 0.12, s * 0.9, s * 0.36, math.max(1.2, s * 0.12), color, 0, 2)
	return g
end

-- Bobine / disque qui tourne : pivot centré, renvoie le pivot
local function reel(parent, kit, cx, cy, d, color, z, speed, phase)
	local p = kit.Pivot(parent, cx, cy, z)
	kit.Blob(p, 0, 0, d, d, color, { Z = 1 })
	local hub = kit.OutlineOf(color)
	for i = 0, 2 do
		local a = math.rad(i * 120 - 90)
		kit.Circle(p, math.cos(a) * d * 0.26, math.sin(a) * d * 0.26, d * 0.26, d * 0.26, kit.Lighten(color, 0.55), 0, 2)
	end
	kit.Circle(p, 0, 0, d * 0.18, d * 0.18, hub, 0, 3)
	kit.Animate(p, "Spin", 1, speed or 0.25, phase or 0)
	return p
end

----------------------------------------------------------------------
-- Dessins
----------------------------------------------------------------------

-- Téléphone à cadran rose : combiné sur son support, cadran crème, cordon bouclé
Art.RotaryPhone = function(body, kit, _item)
	local C = kit.C
	local pink = Color3.fromRGB(255, 160, 196)
	-- cordon en tire-bouchon (côté gauche)
	for i = 0, 4 do
		local y = 44 + i * 9
		kit.Line(body, 9, y, 5, y + 4.5, 2, kit.OutlineOf(pink), 0, 1)
		kit.Line(body, 5, y + 4.5, 9, y + 9, 2, kit.OutlineOf(pink), 0, 1)
	end
	kit.Part(body, 22, 40, 56, 22, pink, { Radius = 10, Z = 2 }) -- haut du socle
	kit.Part(body, 12, 52, 76, 46, pink, { Radius = 16, Z = 3, Shade = 0.2, Shine = true }) -- socle
	for _, x in ipairs({ 28, 72 }) do
		kit.Part(body, x - 4, 32, 8, 12, kit.Darken(pink, 0.06), { Radius = 3, Z = 1 }) -- fourches
	end
	-- combiné
	kit.Blob(body, 17, 36, 22, 15, pink, { Z = 4 })
	kit.Blob(body, 83, 36, 22, 15, pink, { Z = 4 })
	kit.Part(body, 12, 22, 76, 13, pink, { Radius = -1, Z = 5, Shine = true })
	-- cadran
	local dial = kit.Blob(body, 50, 76, 36, 36, C.Cream, { Z = 5 })
	for i = 0, 8 do
		local a = math.rad(-70 + i * 32)
		local hole = kit.Circle(dial, 18 + math.cos(a) * 12.5, 18 + math.sin(a) * 12.5, 5.4, 5.4, C.PinkSoft, 0, 2)
		kit.Stroke(hole, kit.OutlineOf(C.PinkSoft), 1)
	end
	kit.Circle(dial, 18, 18, 12, 12, pink, 0, 3)
	kit.Heart(dial, 18, 18, 7.5, C.PinkDeep, 0, 4)
	kit.Line(dial, 30, 26, 33, 30, 2, C.GreyDark, 0, 4) -- butée
	return nil
end

-- Radio rétro menthe : poignée, antenne, grille à cœur, cadran de fréquence
Art.RetroRadio = function(body, kit, _item)
	local C = kit.C
	local mint = kit.Lighten(C.Mint, 0.3)
	kit.Part(body, 26, 24, 48, 34, WHITE, { T = 1, Radius = 12, Thickness = 4, Outline = C.WoodDark, Z = 1 }) -- poignée
	kit.Line(body, 78, 44, 92, 10, 2.2, C.GreyDark, 0, 1) -- antenne
	kit.Circle(body, 92, 10, 5.5, 5.5, C.Pink, 0, 1)
	for _, x in ipairs({ 16, 76 }) do
		kit.Part(body, x, 92, 8, 8, C.WoodDark, { Radius = 2, Z = 1 })
	end
	local radio = kit.Part(body, 6, 40, 88, 56, mint, { Radius = 14, Z = 2, Shade = 0.18, Shine = true })
	kit.Box(radio, 0, 9, 88, 3, WHITE, 0.4, 2) -- liseré
	-- haut-parleur à cœur
	local grille = kit.Blob(body, 31, 71, 36, 36, C.Cream, { Z = 3 })
	for i = 0, 3 do
		kit.Box(grille, 7, 8 + i * 6, 22, 1.6, kit.OutlineOf(C.Cream), 0.55, 2)
	end
	kit.Heart(grille, 18, 18, 16, C.Pink, 0, 3)
	kit.Animate(grille, "Breathe", 0.03, 1.4, 0.3)
	-- cadran de fréquence
	local tuner = kit.Part(body, 56, 50, 32, 16, C.Butter, { Radius = 4, Z = 3, Outline = kit.OutlineOf(C.Butter) })
	for i = 0, 5 do
		kit.Box(tuner, 4 + i * 4.8, 3, 1.2, i % 2 == 0 and 5 or 3, kit.OutlineOf(C.Butter), 0.2, 2)
	end
	local needle = kit.Box(tuner, 14, 2, 1.8, 12, C.Red, 0, 3)
	kit.Animate(needle, "Drift", 5, 0.4, 0)
	-- boutons
	for index, color in ipairs({ C.Pink, C.Lilac }) do
		local knob = kit.Blob(body, 62 + (index - 1) * 20, 80, 13, 13, color, { Z = 3, Shine = true })
		kit.Box(knob, 5.6, 1.5, 1.8, 5, kit.OutlineOf(color), 0, 4)
	end
	local n = note(body, kit, 12, 28, 11, C.PinkDeep, 6)
	kit.Animate(n, "Bob", 2.5, 1, 0.5)
	return nil
end

-- Smartphone à coque lapin : écran avec icônes d'applis et cœur "like"
Art.Smartphone = function(body, kit, _item)
	local C = kit.C
	local pink = Color3.fromRGB(255, 176, 206)
	for _, x in ipairs({ 39, 61 }) do
		local ear = kit.Blob(body, x, 16, 11, 22, pink, { Z = 1 })
		kit.Blob(ear, 5.5, 12, 5, 14, C.PinkSoft, { Z = 2, Outline = false, Shade = false })
	end
	kit.Part(body, 26, 16, 48, 84, pink, { Radius = 12, Z = 2, Shade = 0.15 })
	local s = screen(body, kit, 30, 21, 40, 74, C.LilacSoft, C.PinkSoft, 3, 8, 0.2)
	kit.Part(s, 14, 3, 12, 3.5, C.Ink, { Radius = -1, Z = 9, Outline = false, Shade = false }) -- encoche
	-- bulle de notification
	local bubble = kit.Part(s, 5, 10, 30, 12, WHITE, { Radius = 5, Z = 3, Thickness = 1, Shade = false })
	kit.Heart(bubble, 7, 6, 7, C.Heart, 0, 2)
	kit.Box(bubble, 13, 3.4, 13, 1.8, C.Grey, 0, 2)
	kit.Box(bubble, 13, 6.6, 9, 1.8, C.Grey, 0, 2)
	-- gros cœur qui bat
	local big = kit.Heart(s, 20, 34, 16, C.Heart, 0, 3)
	kit.Animate(big, "Breathe", 0.08, 2.2, 0)
	-- icônes d'applis
	local colors = { C.Mint, C.Butter, C.Sky, C.Lilac, C.Peach, C.Pink }
	for i, color in ipairs(colors) do
		local col = (i - 1) % 3
		local row = math.floor((i - 1) / 3)
		kit.Part(s, 5 + col * 11, 48 + row * 10.5, 8, 8, color, { Radius = 3, Z = 3, Thickness = 1, Shade = false })
	end
	kit.Part(s, 13, 69, 14, 2, WHITE, { Radius = -1, Z = 3, Outline = false, Shade = false })
	return { Glow = C.PinkSoft }
end

-- Appareil photo instantané bleu ciel : gros objectif, bande arc-en-ciel, photo qui sort
Art.InstantCamera = function(body, kit, _item)
	local C = kit.C
	local sky = Color3.fromRGB(176, 220, 255)
	-- photo qui sort par le haut
	local photo = kit.Part(body, 56, 8, 30, 34, WHITE, { Radius = 2, Z = 1, Rotation = 10, Thickness = 1.2 })
	local pic = kit.Box(photo, 3, 3, 24, 20, C.Sky, 0, 2)
	kit.Gradient(pic, C.Sky, C.PinkSoft, 90)
	kit.Heart(pic, 12, 10, 10, C.Heart, 0, 3)
	kit.Part(body, 14, 28, 66, 20, sky, { Radius = 8, Z = 2 }) -- dessus
	local cam = kit.Part(body, 6, 38, 88, 60, sky, { Radius = 14, Z = 3, Shade = 0.18, Shine = true })
	-- bande arc-en-ciel
	for i, color in ipairs({ C.Red, C.Orange, C.Yellow, C.Mint, C.Blue }) do
		kit.Box(cam, 18 + i * 3, 0, 3, 60, color, 0.15, 2)
	end
	kit.Part(body, 16, 31, 18, 11, C.Cream, { Radius = 3, Z = 2 }) -- flash
	kit.Box(body, 18, 33, 14, 7, C.Butter, 0.2, 2)
	kit.Part(body, 64, 43, 16, 11, C.Navy, { Radius = 3, Z = 4 }) -- viseur
	kit.Shine(body, 66, 45, 5, 2.5, 5)
	kit.Blob(body, 74, 34, 9, 6, C.Red, { Z = 2 }) -- déclencheur
	-- objectif
	kit.Blob(body, 50, 72, 44, 44, C.Cream, { Z = 5 })
	kit.Blob(body, 50, 72, 32, 32, C.GreyDark, { Z = 6 })
	local lens = kit.Blob(body, 50, 72, 22, 22, C.Navy, { Z = 7 })
	kit.Gradient(lens, C.Lilac, C.Navy, 45)
	kit.Circle(lens, 7, 7, 6, 6, WHITE, 0.2, 2)
	kit.Circle(lens, 15, 15, 3, 3, WHITE, 0.5, 2)
	kit.Heart(body, 84, 88, 8, C.PinkDeep, 0, 5)
	return nil
end

-- Ordinateur portable lilas : écran avec visage souriant, clavier et pavé tactile
Art.Laptop = function(body, kit, _item)
	local C = kit.C
	local lilac = Color3.fromRGB(214, 196, 255)
	kit.Part(body, 12, 18, 76, 58, lilac, { Radius = 8, Z = 2, Shade = 0.12 }) -- capot
	local s = screen(body, kit, 17, 23, 66, 46, C.Sky, C.LilacSoft, 3, 5, 0.6)
	kit.Face(s, 33, 24, 28, { Eyes = "big", Mouth = "cat", Z = 3 })
	for i, pos in ipairs({ { 9, 10 }, { 57, 12 }, { 54, 35 } }) do
		local h = kit.Heart(s, pos[1], pos[2], 7 - i, C.Heart, 0.1, 3)
		kit.Animate(h, "Bob", 1.5, 1, i)
	end
	kit.Sparkle(s, 11, 36, 7, WHITE, 0, 3)
	kit.Circle(body, 50, 20.5, 2, 2, C.Ink, 0, 4) -- webcam
	-- base / clavier
	local base = kit.Part(body, 4, 74, 92, 22, kit.Lighten(lilac, 0.2), { Radius = 6, Z = 4, Shade = 0.2 })
	for row = 0, 2 do
		kit.Box(base, 12 + row * 2, 3 + row * 4, 68 - row * 4, 2.4, kit.OutlineOf(lilac), 0.45, 2)
	end
	kit.Part(base, 36, 15, 20, 5, kit.Lighten(lilac, 0.5), { Radius = 2, Z = 2, Thickness = 1, Shade = false })
	kit.Heart(base, 80, 15, 7, C.Pink, 0, 3) -- autocollant
	kit.Part(body, 2, 94, 96, 5, kit.Darken(lilac, 0.05), { Radius = -1, Z = 3 })
	return { Glow = C.Sky }
end

-- Console de poche : écran vert à cœur en pixels, croix, boutons A/B
Art.RetroHandheld = function(body, kit, _item)
	local C = kit.C
	local shell = Color3.fromRGB(236, 226, 255)
	local g = kit.Part(body, 20, 6, 60, 92, shell, { Radius = 10, Z = 2, Shade = 0.16, Shine = true })
	kit.Box(g, 0, 5, 60, 1.4, kit.OutlineOf(shell), 0.6, 2)
	local bezel = kit.Part(body, 26, 14, 48, 38, Color3.fromRGB(120, 110, 150), { Radius = 5, Z = 3 })
	kit.Circle(bezel, 4, 19, 3, 3, C.Red, 0, 3) -- voyant
	local s = screen(body, kit, 33, 18, 34, 28, Color3.fromRGB(200, 240, 190), Color3.fromRGB(160, 214, 160), 4, 2, 0.1)
	local heart = kit.Group(s, 10, 6, 14, 12, 3)
	pixels(heart, kit, 0, 0, 2, PIXEL_HEART, C.LeafDark, 2)
	kit.Animate(heart, "Bob", 1, 1.3, 0)
	kit.Box(s, 4, 22, 26, 1.6, C.LeafDark, 0.5, 3)
	-- croix directionnelle
	kit.Part(body, 26, 66, 18, 6, C.Ink, { Radius = 2, Z = 3, Outline = false })
	kit.Part(body, 32, 60, 6, 18, C.Ink, { Radius = 2, Z = 3, Outline = false })
	-- boutons A / B
	kit.Blob(body, 60, 72, 10, 10, C.Pink, { Z = 3, Shine = true })
	kit.Blob(body, 70, 64, 10, 10, C.PinkDeep, { Z = 3, Shine = true })
	-- start / select
	for _, x in ipairs({ 42, 54 }) do
		kit.Part(body, x, 82, 9, 3, C.GreyDark, { Radius = -1, Z = 3, Outline = false, Rotation = -25 })
	end
	-- grille de haut-parleur
	for i = 0, 3 do
		kit.Line(body, 60 + i * 4, 94, 66 + i * 4, 86, 1.6, kit.OutlineOf(shell), 0.3, 3)
	end
	return nil
end

-- Télé rétro en bois : écran bombé avec un visage, antennes lapin, boutons
Art.RetroTV = function(body, kit, _item)
	local C = kit.C
	local wood = Color3.fromRGB(240, 186, 160)
	kit.Line(body, 26, 84, 20, 99, 4.5, C.WoodDark, 0, 1)
	kit.Line(body, 74, 84, 80, 99, 4.5, C.WoodDark, 0, 1)
	kit.Line(body, 50, 22, 30, 3, 2.2, C.GreyDark, 0, 1)
	kit.Line(body, 50, 22, 72, 1, 2.2, C.GreyDark, 0, 1)
	kit.Circle(body, 30, 3, 5.5, 5.5, C.Pink, 0, 1)
	kit.Circle(body, 72, 1, 5.5, 5.5, C.Mint, 0, 1)
	kit.Blob(body, 50, 24, 18, 10, C.GreyDark, { Z = 1 })
	local cab = kit.Part(body, 6, 22, 88, 66, wood, { Radius = 16, Z = 2, Shade = 0.18, Shine = true })
	kit.Box(cab, 0, 58, 88, 2, kit.OutlineOf(wood), 0.7, 2)
	kit.Part(body, 12, 28, 58, 52, C.Cream, { Radius = 14, Z = 3 })
	local s = screen(body, kit, 16, 32, 50, 44, C.MintSoft, C.Sky, 4, 12, 0.4)
	kit.Face(s, 25, 22, 30, { Eyes = "big", Mouth = "smile", Z = 3 })
	kit.Sparkle(s, 42, 10, 7, WHITE, 0, 3)
	-- boutons et haut-parleur
	for i, color in ipairs({ C.Pink, C.Butter }) do
		local knob = kit.Blob(body, 82, 36 + (i - 1) * 15, 11, 11, color, { Z = 3, Shine = true })
		kit.Box(knob, 4.6, 1.2, 1.8, 4.5, kit.OutlineOf(color), 0, 4)
	end
	for i = 0, 3 do
		kit.Part(body, 75, 60 + i * 4.5, 14, 2, kit.OutlineOf(wood), { Radius = -1, Z = 3, Outline = false, Shade = false, T = 0.35 })
	end
	return { Glow = C.MintSoft }
end

-- Tourne-disque en valise : couvercle ouvert, vinyle qui tourne, bras de lecture
Art.RecordPlayer = function(body, kit, _item)
	local C = kit.C
	local pink = Color3.fromRGB(255, 176, 200)
	local lid = kit.Part(body, 8, 12, 84, 42, kit.Darken(pink, 0.06), { Radius = 10, Z = 1 })
	kit.Part(lid, 5, 5, 74, 32, kit.Lighten(pink, 0.4), { Radius = 7, Z = 2, Outline = false, Shade = false })
	kit.Heart(lid, 42, 20, 14, C.PinkDeep, 0.2, 3)
	local base = kit.Part(body, 4, 44, 92, 54, pink, { Radius = 12, Z = 2, Shade = 0.2, Shine = true })
	kit.Part(base, 5, 5, 82, 38, kit.Lighten(pink, 0.3), { Radius = 8, Z = 2, Shade = false })
	kit.Box(base, 0, 45, 92, 1.6, kit.OutlineOf(pink), 0.5, 2)
	-- vinyle
	local disc = kit.Pivot(body, 38, 67, 3)
	kit.Blob(disc, 0, 0, 38, 38, Color3.fromRGB(70, 60, 90), { Z = 1 })
	kit.Line(disc, -12, -8, -5, -14, 2, WHITE, 0.6, 3) -- reflet qui tourne
	kit.Animate(disc, "Spin", 1, 0.33, 0)
	for _, d in ipairs({ 30, 22 }) do
		local ring = kit.Circle(disc, 0, 0, d, d, WHITE, 1, 2)
		kit.Stroke(ring, Color3.fromRGB(120, 105, 140), 1, 0.2)
	end
	local label = kit.Circle(disc, 0, 0, 13, 13, C.Pink, 0, 4)
	kit.Heart(label, 6.5, 6, 6, WHITE, 0, 2)
	kit.Shine(body, 25, 55, 10, 3, 6, 0.55)
	-- bras de lecture
	kit.Blob(body, 80, 56, 11, 11, C.Grey, { Z = 5, Shine = true })
	kit.Line(body, 80, 56, 76, 76, 2.6, C.Grey, 0, 5)
	kit.Line(body, 76, 76, 64, 82, 2.6, C.Grey, 0, 5)
	kit.Part(body, 58, 79, 9, 6, C.GreyDark, { Radius = 2, Z = 6, Rotation = -25 })
	-- boutons
	kit.Blob(body, 84, 89, 7, 7, C.Mint, { Z = 4 })
	kit.Blob(body, 74, 89, 7, 7, C.Butter, { Z = 4 })
	for i, pos in ipairs({ { 10, 26 }, { 90, 16 } }) do
		local n = note(body, kit, pos[1], pos[2], 11 - i, i == 1 and C.PinkDeep or C.Purple, 7)
		kit.Animate(n, "Bob", 2.5, 1, i * 1.7)
	end
	return nil
end

-- Casque à oreilles de chat : arceau rose, oreillettes avec coussinets de patte
Art.CatHeadphones = function(body, kit, _item)
	local C = kit.C
	local pink = Color3.fromRGB(255, 170, 204)
	-- oreilles de chat (derrière l'arceau)
	-- (carrés arrondis tournés : la moitié basse est cachée par l'arceau)
	local ears = kit.Group(body, 0, -10, 100, 32, 1, true)
	for _, side in ipairs({ -1, 1 }) do
		local ear = kit.Part(ears, 50 + side * 18 - 13, 12, 26, 26, pink, { Radius = 5, Z = 1, Rotation = 45 + side * 15, Shade = false })
		kit.Part(ear, 4, 4, 12, 12, C.PinkSoft, { Radius = 4, Z = 2, Outline = false, Shade = false })
	end
	-- arceau (moitié haute d'un anneau)
	local band = kit.Group(body, 4, 6, 92, 50, 2, true)
	kit.Part(band, 10, 10, 72, 80, WHITE, { T = 1, Radius = -1, Thickness = 10, Outline = kit.OutlineOf(pink) })
	kit.Part(band, 10, 10, 72, 80, WHITE, { T = 1, Radius = -1, Thickness = 7, Outline = pink })
	kit.Line(body, 16, 50, 16, 62, 7, pink, 0, 2)
	kit.Line(body, 84, 50, 84, 62, 7, pink, 0, 2)
	-- oreillettes
	for _, side in ipairs({ -1, 1 }) do
		local cx = 50 + side * 32
		kit.Part(body, cx - 12, 56, 24, 42, C.PinkSoft, { Radius = 12, Z = 3 }) -- coussin
		local cup = kit.Blob(body, cx - side * 6, 77, 28, 40, pink, { Z = 4, Shade = 0.18, Shine = true })
		-- coussinet de patte
		kit.Circle(cup, 14, 23, 11, 9, C.PinkSoft, 0, 3)
		for i = -1, 1 do
			kit.Circle(cup, 14 + i * 5, i == 0 and 12.5 or 15.5, 5, 5, C.PinkSoft, 0, 3)
		end
	end
	for i, pos in ipairs({ { 46, 40 }, { 58, 30 } }) do
		local n = note(body, kit, pos[1], pos[2] + 4, 11 - i * 2, i == 1 and C.PinkDeep or C.Purple, 6)
		kit.Animate(n, "Bob", 2, 1, i * 1.3)
	end
	return nil
end

-- Enceinte basse : caisson lilas, tweeter, gros woofer qui pulse, notes
Art.Speaker = function(body, kit, _item)
	local C = kit.C
	local lilac = Color3.fromRGB(200, 176, 250)
	for _, x in ipairs({ 24, 68 }) do
		kit.Part(body, x, 94, 8, 6, C.Ink, { Radius = 2, Z = 1, Outline = false })
	end
	local cab = kit.Part(body, 18, 8, 64, 88, lilac, { Radius = 12, Z = 2, Shade = 0.18, Shine = true })
	kit.Circle(cab, 56, 7, 3.5, 3.5, C.Mint, 0, 3) -- voyant
	-- tweeter
	kit.Blob(body, 50, 28, 22, 22, C.Cream, { Z = 3 })
	local tw = kit.Blob(body, 50, 28, 13, 13, C.GreyDark, { Z = 4 })
	kit.Circle(tw, 4.5, 4, 3.5, 3.5, WHITE, 0.4, 2)
	-- woofer
	kit.Blob(body, 50, 68, 46, 46, C.Cream, { Z = 3 })
	local cone = kit.Blob(body, 50, 68, 36, 36, Color3.fromRGB(110, 96, 140), { Z = 4 })
	kit.Gradient(cone, Color3.fromRGB(170, 150, 200), Color3.fromRGB(110, 96, 140), 45)
	local cap = kit.Circle(cone, 18, 18, 14, 14, C.Pink, 0, 2)
	kit.Heart(cap, 7, 7, 7, WHITE, 0.2, 2)
	kit.Animate(cone, "Breathe", 0.05, 3, 0)
	-- notes et ondes
	for i, pos in ipairs({ { 10, 30 }, { 90, 44 }, { 88, 16 } }) do
		local n = note(body, kit, pos[1], pos[2], 12 - i, i == 2 and C.Purple or C.PinkDeep, 6)
		kit.Animate(n, "Bob", 2.5, 1.2, i * 1.1)
	end
	return nil
end

-- Robot aspirateur : disque blanc avec visage, capteur, nœud rose ; il se promène
Art.RobotVacuum = function(body, kit, _item)
	local C = kit.C
	local g = kit.Group(body, 0, 0, 100, 100, 2)
	kit.Animate(g, "Drift", 5, 0.5, 0)
	for _, x in ipairs({ 24, 76 }) do
		kit.Blob(g, x, 96, 12, 7, C.Ink, { Z = 1, Outline = false })
	end
	kit.Part(g, 6, 70, 88, 26, Color3.fromRGB(236, 232, 248), { Radius = 12, Z = 2, Shade = 0.2 }) -- flanc
	local top = kit.Blob(g, 50, 70, 88, 22, WHITE, { Z = 3, Shade = 0.08 })
	kit.Blob(top, 44, 11, 40, 10, C.MintSoft, { Z = 2, Outline = kit.Lighten(C.Mint, 0.2), Thickness = 1, Shade = false })
	kit.Shine(top, 10, 4, 18, 3, 3)
	kit.Part(g, 42, 60, 16, 6, C.Mint, { Radius = -1, Z = 4 }) -- capteur
	kit.Part(g, 6, 76, 88, 3, C.Lilac, { Radius = 0, Z = 3, Outline = false, Shade = false, T = 0.4 })
	kit.Face(g, 50, 86, 28, { Eyes = "dot", Mouth = "smile", Z = 5 })
	-- nœud
	kit.Blob(g, 72, 60, 11, 8, C.Pink, { Z = 5, Rotation = -20 })
	kit.Blob(g, 82, 60, 11, 8, C.Pink, { Z = 5, Rotation = 20 })
	kit.Circle(g, 77, 60, 5, 5, C.PinkDeep, 0, 6)
	-- brosse latérale
	local brush = kit.Pivot(g, 10, 94, 6)
	for i = 0, 2 do
		local a = math.rad(i * 120)
		kit.Line(brush, 0, 0, math.cos(a) * 7, math.sin(a) * 3, 1.4, C.GreyDark, 0, 1)
	end
	kit.Animate(brush, "Spin", 1, 1.5, 0)
	kit.Sparkle(body, 94, 58, 8, C.Butter, 0, 3)
	kit.Sparkle(body, 4, 62, 6, C.Sky, 0, 3)
	return nil
end

-- Climatiseur mural kawaii : visage endormi, volet, souffle frais et flocons
Art.AirConditioner = function(body, kit, _item)
	local C = kit.C
	local unit = kit.Part(body, 4, 24, 92, 42, WHITE, { Radius = 14, Z = 2, Outline = Color3.fromRGB(170, 176, 206), Shade = 0.14, Shine = true })
	kit.Box(unit, 6, 8, 80, 1.2, C.Grey, 0.4, 2)
	kit.Part(body, 10, 54, 80, 8, Color3.fromRGB(150, 150, 180), { Radius = 3, Z = 3 }) -- sortie d'air
	for i = 0, 2 do
		kit.Box(body, 14, 55.5 + i * 2, 72, 1, Color3.fromRGB(120, 120, 150), 0, 4)
	end
	kit.Part(body, 12, 60, 76, 4, WHITE, { Radius = -1, Z = 5, Rotation = 3 }) -- volet
	kit.Face(body, 30, 40, 26, { Eyes = "closed", Mouth = "cat", Z = 4 })
	local screenBox = kit.Part(body, 66, 32, 22, 11, C.Navy, { Radius = 3, Z = 3 })
	kit.Box(screenBox, 3, 3, 6, 5, C.Sky, 0, 2)
	kit.Box(screenBox, 11, 3, 6, 5, C.Sky, 0, 2)
	kit.Circle(body, 84, 48, 3.5, 3.5, C.Mint, 0, 4)
	-- souffle d'air frais
	for i = 0, 2 do
		local wave = kit.Group(body, 18 + i * 22, 68, 20, 18, 3)
		for j = 0, 2 do
			local x0 = 2 + j * 2
			kit.Line(wave, x0 + (j % 2) * 4, j * 5, x0 + ((j + 1) % 2) * 4, j * 5 + 5, 1.8, C.Sky, 0.2, 1)
		end
		kit.Animate(wave, "Bob", 2, 1.2, i * 0.9)
	end
	for i, pos in ipairs({ { 12, 84 }, { 58, 92 }, { 90, 80 } }) do
		local flake = kit.Sparkle(body, pos[1], pos[2], 8 - i, i == 2 and C.Sky or WHITE, 0, 4)
		kit.Animate(flake, "Bob", 2, 0.9, i)
	end
	return { WallShadow = Vector2.new(0.92, 0.44) }
end

-- Ordinateur de bureau : écran avec fenêtre et cœur en pixels, tour à LED, clavier, souris
Art.DesktopPC = function(body, kit, _item)
	local C = kit.C
	local cream = Color3.fromRGB(250, 246, 255)
	-- tour
	local tower = kit.Part(body, 74, 34, 22, 64, Color3.fromRGB(214, 196, 255), { Radius = 5, Z = 1, Shade = 0.2, Shine = true })
	local led = kit.Box(tower, 3, 6, 3, 52, WHITE, 0, 2)
	kit.Round(led, -1)
	kit.Gradient(led, C.Pink, C.Sky, 90)
	kit.Animate(led, "Pulse", 0.4, 1.5, 0)
	local fan = kit.Blob(tower, 13, 18, 12, 12, C.Navy, { Z = 2 })
	kit.Heart(fan, 6, 6, 6, C.Pink, 0, 2)
	kit.Circle(tower, 13, 50, 5, 5, C.Mint, 0, 2)
	-- écran
	kit.Part(body, 36, 60, 12, 14, C.Grey, { Radius = 2, Z = 2 })
	kit.Part(body, 26, 70, 32, 7, C.Grey, { Radius = -1, Z = 3 })
	kit.Part(body, 6, 8, 72, 54, cream, { Radius = 8, Z = 3, Shade = 0.12 })
	local s = screen(body, kit, 10, 12, 64, 44, C.Sky, C.LilacSoft, 4, 4, 0.8)
	kit.Cloud(s, 12, 40, 16, WHITE, 0.2, 2)
	kit.Cloud(s, 56, 16, 12, WHITE, 0.3, 2)
	local win = kit.Part(s, 16, 6, 34, 30, WHITE, { Radius = 3, Z = 3, Thickness = 1, Shade = false })
	kit.Box(win, 0, 0, 34, 6, C.PinkSoft, 0, 2)
	for i, color in ipairs({ C.Red, C.Butter, C.Mint }) do
		kit.Circle(win, 4 + (i - 1) * 4, 3, 2.6, 2.6, color, 0, 3)
	end
	local ph = kit.Group(win, 10, 10, 14, 12, 3)
	pixels(ph, kit, 0, 0, 2, PIXEL_HEART, C.Heart, 2)
	kit.Animate(ph, "Breathe", 0.06, 2, 0)
	kit.Line(s, 54, 28, 54, 36, 1.6, C.Ink, 0, 4) -- curseur
	kit.Line(s, 54, 28, 59, 33, 1.6, C.Ink, 0, 4)
	kit.Circle(body, 42, 58.5, 2.5, 2.5, C.Mint, 0, 5)
	-- clavier
	local kb = kit.Part(body, 4, 84, 62, 13, WHITE, { Radius = 4, Z = 5, Shade = 0.18 })
	for row = 0, 1 do
		for col = 0, 4 do
			kit.Part(kb, 4 + col * 10.8 + row * 3, 2.5 + row * 4.5, 9, 3.4, col == 2 and C.PinkSoft or C.LilacSoft, { Radius = 1, Z = 2, Outline = false, Shade = false })
		end
	end
	-- souris
	local mouse = kit.Blob(body, 76, 92, 11, 13, C.Pink, { Z = 6, Shine = true })
	kit.Box(mouse, 5, 0, 1, 5, kit.OutlineOf(C.Pink), 0, 2)
	return { Glow = C.Sky }
end

-- Console de salon rétro : cartouche rose, boîtier crème, manette reliée par un fil
Art.GameConsole = function(body, kit, _item)
	local C = kit.C
	local cream = Color3.fromRGB(246, 242, 255)
	local cart = kit.Part(body, 32, 18, 36, 26, C.Pink, { Radius = 4, Z = 1, Shade = 0.15 })
	local label = kit.Part(cart, 5, 4, 26, 12, C.Butter, { Radius = 2, Z = 2, Thickness = 1, Shade = false })
	kit.Heart(label, 13, 6, 8, C.Heart, 0, 2)
	kit.Part(body, 26, 34, 48, 10, C.Lilac, { Radius = 4, Z = 2 })
	local console = kit.Part(body, 8, 38, 84, 30, cream, { Radius = 12, Z = 3, Shade = 0.18, Shine = true })
	kit.Box(console, 0, 20, 84, 1.4, C.Grey, 0.2, 2)
	for i = 0, 1 do
		kit.Part(body, 16 + i * 10, 58, 7, 5, C.GreyDark, { Radius = 2, Z = 4, Outline = false })
	end
	kit.Part(body, 60, 55, 10, 6, C.Pink, { Radius = 2, Z = 4 }) -- power
	kit.Part(body, 74, 55, 10, 6, C.Lilac, { Radius = 2, Z = 4 }) -- reset
	kit.Circle(body, 50, 58, 3.5, 3.5, C.Mint, 0, 4)
	-- fil
	kit.Line(body, 19, 63, 16, 74, 1.8, C.GreyDark, 0, 4)
	kit.Line(body, 16, 74, 26, 80, 1.8, C.GreyDark, 0, 4)
	-- manette
	local pad = Color3.fromRGB(190, 170, 250)
	kit.Blob(body, 32, 88, 22, 20, pad, { Z = 5 })
	kit.Blob(body, 68, 88, 22, 20, pad, { Z = 5 })
	kit.Part(body, 22, 72, 56, 20, pad, { Radius = 10, Z = 6, Shade = 0.15, Shine = true })
	kit.Box(body, 27.5, 79, 11, 3.6, C.Ink, 0, 7)
	kit.Box(body, 31.2, 75.3, 3.6, 11, C.Ink, 0, 7)
	for i, pos in ipairs({ { 66, 77 }, { 72, 82 }, { 60, 82 }, { 66, 87 } }) do
		kit.Circle(body, pos[1], pos[2], 5, 5, ({ C.Pink, C.Mint, C.Sky, C.Butter })[i], 0, 7)
	end
	kit.Part(body, 44, 83, 5, 2.4, C.GreyDark, { Radius = -1, Z = 7, Outline = false })
	kit.Part(body, 51, 83, 5, 2.4, C.GreyDark, { Radius = -1, Z = 7, Outline = false })
	return nil
end

-- Micro de karaoké qui chante : tête rose avec visage, bague dorée, socle, notes
Art.KaraokeMic = function(body, kit, _item)
	local C = kit.C
	kit.Blob(body, 50, 94, 46, 11, C.Lilac, { Z = 1 })
	kit.Part(body, 47, 72, 6, 20, C.Grey, { Radius = 2, Z = 1 })
	local handle = kit.Part(body, 40, 44, 20, 36, WHITE, { Radius = 8, Z = 2, Shade = 0.2 })
	kit.Gradient(handle, C.LilacSoft, C.Lilac, 0)
	local ledRing = kit.Box(handle, 2, 16, 16, 3, C.Pink, 0, 2)
	kit.Gradient(ledRing, C.Pink, C.Sky, 0)
	kit.Animate(ledRing, "Pulse", 0.6, 2, 0)
	kit.Sparkle(handle, 10, 28, 5, WHITE, 0, 2)
	kit.Part(body, 36, 40, 28, 8, C.Gold, { Radius = 3, Z = 3, Shine = true })
	local head = kit.Blob(body, 50, 25, 42, 40, C.Pink, { Z = 4, Shade = 0.18, Shine = true })
	kit.Box(head, 3, 29, 36, 1.6, kit.OutlineOf(C.Pink), 0.6, 2)
	kit.Face(head, 21, 24, 24, { Eyes = "happy", Mouth = "o", Z = 3 })
	for i, pos in ipairs({ { 12, 18 }, { 88, 28 }, { 84, 6 } }) do
		local n = note(body, kit, pos[1], pos[2], 12 - i * 1.5, i == 2 and C.Purple or C.PinkDeep, 6)
		kit.Animate(n, "Bob", 2.5, 1, i * 1.4)
	end
	kit.Sparkle(body, 16, 50, 7, C.Butter, 0, 6)
	return nil
end

-- Borne d'arcade : fronton lumineux, écran avec envahisseur en pixels, joystick, boutons
Art.ArcadeMachine = function(body, kit, _item)
	local C = kit.C
	local lilac = Color3.fromRGB(186, 160, 250)
	kit.Part(body, 20, 94, 60, 6, C.Ink, { Radius = 2, Z = 1, Outline = false })
	local cab = kit.Part(body, 16, 4, 68, 92, lilac, { Radius = 8, Z = 2, Shade = 0.2, Shine = true })
	for _, x in ipairs({ 3, 61 }) do
		kit.Box(cab, x, 20, 4, 70, kit.Lighten(lilac, 0.35), 0, 2) -- liserés
	end
	-- fronton
	local marquee = kit.Part(body, 20, 8, 60, 16, C.PinkSoft, { Radius = 4, Z = 3 })
	kit.Gradient(marquee, C.PinkSoft, C.Pink, 90)
	local lit = kit.Box(marquee, 0, 0, 60, 16, WHITE, 0.6, 2)
	kit.Round(lit, 4)
	kit.Animate(lit, "Pulse", 0.4, 1.6, 0)
	for i = 0, 2 do
		kit.Heart(marquee, 18 + i * 12, 8, i == 1 and 10 or 7, i == 1 and C.Heart or WHITE, 0, 3)
	end
	-- écran
	kit.Part(body, 22, 27, 56, 36, C.Navy, { Radius = 5, Z = 3 })
	local s = screen(body, kit, 26, 30, 48, 30, Color3.fromRGB(60, 50, 120), Color3.fromRGB(30, 30, 70), 4, 3, 0.3)
	local inv = kit.Group(s, 13, 5, 22, 16, 3)
	pixels(inv, kit, 0, 0, 2, PIXEL_INVADER, C.Mint, 2)
	kit.Animate(inv, "Drift", 4, 0.8, 0)
	for i = 0, 3 do
		kit.Box(s, 6 + i * 11, 25, 6, 1.6, C.Butter, 0.2, 3)
	end
	kit.Sparkle(s, 6, 8, 5, C.Butter, 0, 3)
	-- panneau de commande
	kit.Part(body, 10, 64, 80, 13, C.Pink, { Radius = 4, Z = 5, Shade = 0.2 })
	kit.Line(body, 30, 70, 30, 60, 2.4, C.GreyDark, 0, 6)
	kit.Blob(body, 30, 59, 9, 9, C.Red, { Z = 7, Shine = true })
	for i, color in ipairs({ C.Butter, C.Mint, C.Sky }) do
		kit.Blob(body, 50 + (i - 1) * 10, 70, 7, 5, color, { Z = 6 })
	end
	-- portillon à pièces
	local door = kit.Part(body, 38, 80, 24, 14, kit.Darken(lilac, 0.08), { Radius = 3, Z = 3 })
	for i = 0, 1 do
		local slot = kit.Box(door, 5 + i * 9, 4, 5, 6, C.Orange, 0, 2)
		kit.Round(slot, 1)
		kit.Box(slot, 2, 1, 1, 4, C.Ink, 0, 2)
	end
	return { Glow = C.Pink }
end

-- Projecteur de cinéma vintage : deux bobines qui tournent, objectif, faisceau
Art.Projector = function(body, kit, _item)
	local C = kit.C
	local grey = Color3.fromRGB(196, 190, 226)
	-- faisceau
	local beam = kit.Triangle(body, 96, 46, 30, 26, C.Butter, 1, 0.55, 10)
	beam.Rotation = -90
	for _, child in ipairs(beam:GetChildren()) do
		kit.Animate(child, "Pulse", 0.3, 1.2, 0)
	end
	-- pied
	kit.Part(body, 10, 88, 64, 10, C.WoodDark, { Radius = 4, Z = 1 })
	kit.Part(body, 36, 80, 12, 10, C.GreyDark, { Radius = 2, Z = 1 })
	-- bras des bobines
	kit.Line(body, 28, 34, 38, 54, 3, C.GreyDark, 0, 1)
	kit.Line(body, 62, 30, 52, 54, 3, C.GreyDark, 0, 1)
	reel(body, kit, 28, 32, 30, C.Pink, 2, 0.3, 0)
	reel(body, kit, 64, 28, 30, C.Mint, 2, 0.3, 1.3)
	kit.Line(body, 14, 34, 18, 56, 1.8, C.Ink, 0, 1) -- pellicule
	-- corps
	local main = kit.Part(body, 10, 50, 62, 32, grey, { Radius = 8, Z = 3, Shade = 0.18, Shine = true })
	kit.Box(main, 4, 20, 54, 1.4, kit.OutlineOf(grey), 0.5, 2)
	for i = 0, 2 do
		kit.Box(main, 34 + i * 6, 6, 3, 10, kit.OutlineOf(grey), 0.5, 2)
	end
	kit.Blob(body, 22, 72, 7, 7, C.Pink, { Z = 4 })
	kit.Blob(body, 32, 72, 7, 7, C.Butter, { Z = 4 })
	-- objectif
	kit.Part(body, 70, 57, 16, 18, C.GreyDark, { Radius = 3, Z = 2 })
	local lens = kit.Blob(body, 86, 66, 9, 22, C.Glass, { Z = 3 })
	kit.Gradient(lens, WHITE, C.Butter, 0)
	return { Glow = C.Butter }
end

-- Piano à queue rose et crème : couvercle relevé, pupitre avec partition, clavier
Art.GrandPiano = function(body, kit, _item)
	local C = kit.C
	local pink = Color3.fromRGB(255, 196, 216)
	-- couvercle relevé et béquille
	kit.Line(body, 82, 48, 80, 23, 2, C.Gold, 0, 1)
	kit.Part(body, 6, 28.5, 86, 7, pink, { Radius = 3, Z = 2, Rotation = -16, Shine = true })
	kit.Part(body, 8, 38, 82, 12, kit.Darken(pink, 0.1), { Radius = 4, Z = 1 }) -- intérieur
	-- pupitre et partition
	local sheet = kit.Part(body, 34, 30, 32, 17, WHITE, { Radius = 2, Z = 3, Thickness = 1.2 })
	for i = 0, 2 do
		kit.Box(sheet, 3, 4 + i * 3.5, 26, 0.8, C.Grey, 0, 2)
	end
	note(sheet, kit, 10, 7, 8, C.Ink, 3)
	note(sheet, kit, 22, 9, 7, C.PinkDeep, 3)
	kit.Part(body, 30, 44, 40, 4, C.WoodDark, { Radius = 2, Z = 4 })
	-- caisse
	local case = kit.Part(body, 4, 46, 92, 20, pink, { Radius = 6, Z = 3, Shade = 0.2, Shine = true })
	kit.Box(case, 0, 17, 92, 1.4, C.Gold, 0.2, 2)
	-- clavier
	local keys = kit.Part(body, 10, 58, 80, 12, WHITE, { Radius = 2, Z = 5, Outline = C.GreyDark, Thickness = 1.2, Shade = 0.1 })
	local keyW = 80 / 14
	for i = 1, 13 do
		kit.Box(keys, i * keyW - 0.4, 6, 0.8, 6, C.Grey, 0, 2)
	end
	for i = 0, 13 do
		local k = i % 7
		if k ~= 2 and k ~= 6 and i < 13 then
			kit.Part(keys, (i + 1) * keyW - 1.8, 0, 3.6, 7, C.Ink, { Radius = 1, Z = 3, Outline = false, Shade = false })
		end
	end
	-- pieds, lyre et pédales
	for _, x in ipairs({ 10, 82 }) do
		kit.Part(body, x, 66, 8, 30, pink, { Radius = 3, Z = 2 })
		kit.Blob(body, x + 4, 96, 10, 6, C.Gold, { Z = 3 })
	end
	kit.Part(body, 46, 66, 8, 24, kit.Darken(pink, 0.05), { Radius = 3, Z = 2 })
	kit.Part(body, 38, 88, 24, 6, pink, { Radius = 2, Z = 3 })
	for i = 0, 2 do
		kit.Part(body, 41 + i * 7, 93, 4, 4, C.Gold, { Radius = 1, Z = 4 })
	end
	local n = note(body, kit, 90, 10, 11, C.PinkDeep, 6)
	kit.Animate(n, "Bob", 2.5, 1, 0)
	local n2 = note(body, kit, 10, 16, 9, C.Purple, 6)
	kit.Animate(n2, "Bob", 2.5, 1, 1.6)
	return nil
end

-- Télescope à étoiles : tube lilas à bagues dorées sur trépied, étoiles scintillantes
Art.Telescope = function(body, kit, _item)
	local C = kit.C
	local lilac = Color3.fromRGB(190, 170, 250)
	-- trépied
	kit.Line(body, 50, 60, 50, 97, 4, C.WoodDark, 0, 1)
	kit.Line(body, 50, 60, 24, 98, 4.5, C.Wood, 0, 2)
	kit.Line(body, 50, 60, 76, 98, 4.5, C.Wood, 0, 2)
	kit.Blob(body, 50, 60, 14, 12, C.GreyDark, { Z = 3 })
	kit.Line(body, 34, 80, 66, 80, 2, C.WoodDark, 0, 2)
	-- tube incliné
	local angle = -28
	local ux, uy = math.cos(math.rad(angle)), math.sin(math.rad(angle))
	local cx, cy = 48, 44
	local function along(t, n)
		return cx + ux * t - uy * n, cy + uy * t + ux * n
	end
	local fx, fy = along(0, -14)
	kit.Part(body, fx - 12, fy - 3.5, 24, 7, C.Navy, { Radius = 3, Z = 3, Rotation = angle }) -- chercheur
	local tube = kit.Part(body, cx - 36, cy - 10, 72, 20, lilac, { Radius = 8, Z = 4, Rotation = angle, Shade = 0.2, Shine = true })
	kit.Sparkle(tube, 40, 10, 9, WHITE, 0.1, 3)
	for _, t in ipairs({ -18, 18 }) do
		local bx, by = along(t, 0)
		kit.Part(body, bx - 2.5, by - 11, 5, 22, C.Gold, { Radius = 2, Z = 5, Rotation = angle })
	end
	local lx, ly = along(38, 0)
	kit.Part(body, lx - 4, ly - 13, 8, 26, kit.Darken(lilac, 0.1), { Radius = 3, Z = 5, Rotation = angle })
	local glass = kit.Part(body, lx - 1.5, ly - 10, 5, 20, C.Glass, { Radius = -1, Z = 6, Rotation = angle })
	kit.Gradient(glass, WHITE, C.Sky, 90)
	local ex, ey = along(-40, 0)
	kit.Part(body, ex - 5, ey - 4, 10, 8, C.GreyDark, { Radius = 2, Z = 3, Rotation = angle })
	-- étoiles
	for i, s in ipairs({ { 86, 6, 11, C.Butter }, { 94, 26, 7, C.Pink }, { 70, 4, 6, C.Sky }, { 12, 14, 7, C.Butter } }) do
		local star = kit.Sparkle(body, s[1], s[2], s[3], s[4], 0, 7)
		kit.Animate(star, "Breathe", 0.15, 1.5, i * 1.1)
	end
	return nil
end

-- Mini machine à sous : dôme à ampoules, trois rouleaux (jackpot cœurs), levier, pièces
Art.SlotMachine = function(body, kit, _item)
	local C = kit.C
	local pink = Color3.fromRGB(255, 150, 190)
	-- levier
	kit.Line(body, 88, 58, 94, 24, 3, C.Grey, 0, 1)
	kit.Blob(body, 94, 22, 11, 11, C.Red, { Z = 2, Shine = true })
	kit.Part(body, 82, 52, 10, 12, C.GreyDark, { Radius = 3, Z = 1 })
	-- dôme à ampoules
	local dome = kit.Blob(body, 50, 26, 62, 36, C.Butter, { Z = 1, Shade = 0.15 })
	kit.Gradient(dome, C.Butter, C.Gold, 90)
	for i = 0, 6 do
		local a = math.rad(180 + i * 30)
		local bulb = kit.Circle(body, 50 + math.cos(a) * 25, 28 + math.sin(a) * 13, 5, 5, i % 2 == 0 and WHITE or C.PinkSoft, 0, 2)
		kit.Animate(bulb, "Pulse", 0.6, 3, i % 2 * 1.3)
	end
	kit.Heart(body, 50, 20, 11, C.Heart, 0, 2)
	-- caisse
	local cab = kit.Part(body, 12, 28, 76, 62, pink, { Radius = 12, Z = 3, Shade = 0.2, Shine = true })
	kit.Box(cab, 0, 40, 76, 1.4, kit.OutlineOf(pink), 0.5, 2)
	local frame = kit.Part(body, 18, 36, 64, 30, C.Gold, { Radius = 6, Z = 4 })
	for i = 0, 2 do
		local r = kit.Part(frame, 4 + i * 19.5, 4, 17, 22, WHITE, { Radius = 3, Z = 2, Thickness = 1, Shade = false })
		kit.Gradient(r, WHITE, C.LilacSoft, 90)
		kit.Box(r, 0, 0, 17, 4, C.Grey, 0.5, 2)
		kit.Box(r, 0, 18, 17, 4, C.Grey, 0.5, 2)
		kit.Heart(r, 8.5, 11, 12, ({ C.Heart, C.Pink, C.PinkDeep })[i + 1], 0, 3)
	end
	kit.Box(frame, 2, 14.5, 60, 1.2, C.Red, 0.4, 3) -- ligne de gain
	kit.Sparkle(body, 80, 36, 8, WHITE, 0, 6)
	-- boutons
	for i, color in ipairs({ C.Mint, C.Sky, C.Red }) do
		kit.Part(body, 26 + (i - 1) * 17, 69, 12, 5, color, { Radius = -1, Z = 4 })
	end
	-- plateau à pièces
	kit.Part(body, 22, 78, 56, 10, C.Navy, { Radius = 3, Z = 4 })
	for i, pos in ipairs({ { 36, 80 }, { 44, 81 }, { 52, 79 }, { 60, 81 } }) do
		local coin = kit.Blob(body, pos[1], pos[2], 8, 7, C.Yellow, { Z = 5, Outline = C.Gold })
		kit.Box(coin, 3.2, 1.5, 1.4, 4, C.Gold, 0, 2)
		if i == 3 then
			kit.Animate(coin, "Bob", 1, 1.5, 0)
		end
	end
	kit.Part(body, 8, 88, 84, 10, kit.Darken(pink, 0.12), { Radius = 5, Z = 2 })
	return { Glow = C.Butter }
end

-- Parabole murale : support, antenne blanche au visage, ondes qui s'échappent
Art.SatelliteDish = function(body, kit, _item)
	local C = kit.C
	local plate = kit.Part(body, 8, 58, 16, 28, C.Grey, { Radius = 3, Z = 1 })
	kit.Circle(plate, 8, 5, 3, 3, C.GreyDark, 0, 2)
	kit.Circle(plate, 8, 23, 3, 3, C.GreyDark, 0, 2)
	kit.Line(body, 16, 72, 42, 62, 5, C.GreyDark, 0, 1)
	local dish = kit.Blob(body, 48, 48, 50, 66, WHITE, { Z = 3, Rotation = -32, Shade = 0.18, Outline = Color3.fromRGB(170, 170, 200) })
	kit.Blob(dish, 27, 33, 38, 54, C.LilacSoft, { Z = 2, Outline = false, Shade = 0.1 })
	kit.Face(body, 42, 56, 22, { Eyes = "happy", Mouth = "smile", Z = 4 })
	kit.Circle(body, 54, 42, 5, 5, C.GreyDark, 0, 4)
	kit.Line(body, 54, 42, 72, 29, 2.4, C.GreyDark, 0, 4)
	kit.Part(body, 68, 22, 12, 10, C.Pink, { Radius = 3, Z = 5, Rotation = -40, Shine = true })
	-- ondes (quarts de cercle)
	local waves = kit.Group(body, 78, 0, 24, 24, 6, true)
	for i, r in ipairs({ 8, 14, 20 }) do
		local ring = kit.Part(waves, -r, 24 - r, r * 2, r * 2, WHITE, { T = 1, Radius = -1, Thickness = 2, Outline = i % 2 == 0 and C.Pink or C.Sky, Shade = false })
		kit.Animate(ring, "Breathe", 0.08, 1.8, i * 0.7)
	end
	kit.Sparkle(body, 90, 34, 7, C.Butter, 0, 6)
	return { WallShadow = Vector2.new(0.62, 0.66) }
end

-- Casque de réalité virtuelle : visière blanche, écran aux yeux lumineux, sangle
Art.VRGoggles = function(body, kit, _item)
	local C = kit.C
	local strap = kit.Part(body, 10, 34, 80, 56, WHITE, { T = 1, Radius = 24, Thickness = 7, Outline = C.Lilac, Z = 1 })
	strap.Rotation = 0
	kit.Part(body, 36, 28, 28, 10, C.Lilac, { Radius = -1, Z = 1 })
	local visor = kit.Part(body, 8, 42, 84, 46, WHITE, { Radius = 18, Z = 2, Shade = 0.2, Shine = true, Outline = Color3.fromRGB(170, 160, 210) })
	kit.Box(visor, 40, 40, 4, 6, C.Grey, 0.3, 2)
	local s = screen(body, kit, 16, 48, 68, 32, Color3.fromRGB(70, 60, 130), Color3.fromRGB(40, 36, 90), 3, 13, 0.5)
	-- yeux lumineux ^ ^
	for _, x in ipairs({ 22, 46 }) do
		kit.Line(s, x - 6, 18, x, 11, 3, C.Mint, 0, 3)
		kit.Line(s, x, 11, x + 6, 18, 3, C.Mint, 0, 3)
	end
	kit.Circle(s, 14, 23, 7, 3.5, C.Pink, 0.3, 3)
	kit.Circle(s, 54, 23, 7, 3.5, C.Pink, 0.3, 3)
	kit.Heart(s, 34, 22, 6, C.Pink, 0, 3)
	for i, pos in ipairs({ { 10, 30 }, { 92, 36 } }) do
		local sp = kit.Sparkle(body, pos[1], pos[2], 8, i == 1 and C.Butter or C.Sky, 0, 6)
		kit.Animate(sp, "Breathe", 0.15, 1.5, i)
	end
	return { Glow = C.Mint }
end

-- Home cinéma : grand écran (film de nuit étoilée), enceintes colonnes, meuble, pop-corn
Art.HomeCinema = function(body, kit, _item)
	local C = kit.C
	local dark = Color3.fromRGB(96, 84, 130)
	-- écran
	kit.Part(body, 12, 4, 76, 50, dark, { Radius = 6, Z = 2, Shade = 0.1 })
	local s = screen(body, kit, 15, 7, 70, 44, Color3.fromRGB(120, 110, 220), Color3.fromRGB(255, 170, 200), 3, 3, 0.2)
	kit.Circle(s, 52, 12, 11, 11, C.Butter, 0, 2) -- lune
	kit.Circle(s, 55, 10, 9, 9, Color3.fromRGB(150, 130, 220), 0, 2)
	kit.Blob(s, 18, 44, 50, 24, C.Mint, { Z = 3, Outline = false, Shade = false })
	kit.Blob(s, 52, 46, 50, 22, C.Leaf, { Z = 3, Outline = false, Shade = false })
	kit.Cloud(s, 26, 18, 16, WHITE, 0.2, 2)
	for i, pos in ipairs({ { 10, 8 }, { 36, 6 }, { 64, 22 } }) do
		local sp = kit.Sparkle(s, pos[1], pos[2], 5, WHITE, 0, 2)
		kit.Animate(sp, "Breathe", 0.2, 1.4, i)
	end
	-- barre de son
	local bar = kit.Part(body, 24, 56, 52, 6, dark, { Radius = -1, Z = 3 })
	kit.Box(bar, 6, 2, 40, 1.4, C.Grey, 0.4, 2)
	-- meuble TV
	local cab = kit.Part(body, 12, 64, 76, 30, C.WoodLight, { Radius = 6, Z = 2, Shade = 0.18, Shine = true })
	for i = 0, 1 do
		local d = kit.Part(cab, 4 + i * 35, 4, 33, 22, C.Wood, { Radius = 4, Z = 2, Shade = false, Thickness = 1.2 })
		kit.Circle(d, i == 0 and 28 or 5, 11, 3, 3, C.Gold, 0, 2)
	end
	kit.Part(body, 16, 93, 6, 6, C.WoodDark, { Radius = 2, Z = 1 })
	kit.Part(body, 78, 93, 6, 6, C.WoodDark, { Radius = 2, Z = 1 })
	-- enceintes colonnes
	for _, x in ipairs({ 1, 85 }) do
		local sp = kit.Part(body, x, 34, 14, 64, dark, { Radius = 5, Z = 3, Shade = 0.15, Shine = true })
		kit.Circle(sp, 7, 10, 7, 7, C.Grey, 0, 2)
		local w = kit.Circle(sp, 7, 28, 10, 10, C.Grey, 0, 2)
		kit.Circle(w, 5, 5, 4, 4, C.Pink, 0, 2)
		local w2 = kit.Circle(sp, 7, 46, 10, 10, C.Grey, 0, 2)
		kit.Circle(w2, 5, 5, 4, 4, C.Pink, 0, 2)
		kit.Animate(w, "Breathe", 0.06, 3, x)
		kit.Animate(w2, "Breathe", 0.06, 3, x + 1)
	end
	-- pop-corn
	for i, pos in ipairs({ { 58, 76 }, { 64, 73 }, { 70, 76 }, { 61, 70 }, { 67, 69 } }) do
		kit.Blob(body, pos[1], pos[2], 8, 7, i % 2 == 0 and C.Cream or C.Butter, { Z = 5, Thickness = 1 })
	end
	local bucket = kit.Part(body, 56, 76, 16, 22, WHITE, { Radius = 3, Z = 6, Thickness = 1.2 })
	for i = 0, 2 do
		kit.Box(bucket, 1.5 + i * 5, 0, 2.6, 22, C.Red, 0.1, 2)
	end
	return { Glow = C.LilacSoft }
end

return Art
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="22">
              <Properties>
                <string name="Name">Fun91</string>
                <string name="Source"><![CDATA[--[[
	Fun91 (ModuleScript) — (v9.1) nouveaux jouets, électronique, cuisine 🧸📺🍰
	Emplacement : ReplicatedStorage > Client > Components > House > Art > Fun91
	Contrat : voir HouseArt (boîte 100 x 100, pieds en bas).
]]

local Art = {}

local WHITE = Color3.new(1, 1, 1)

-- Cubes de l'alphabet (A B C empilés)
Art.ToyBlocks = function(body, kit, _item)
	local C = kit.C
	for index, b in ipairs({ { 8, 64, C.Pink, "A" }, { 52, 64, C.Sky, "B" }, { 30, 28, C.Butter, "C" } }) do
		local block = kit.Part(body, b[1], b[2], 36, 36, b[3], { Radius = 6, Z = index, Shine = true })
		kit.Part(block, 5, 5, 26, 26, kit.Lighten(b[3], 0.5), { Radius = 4, Z = 2, Outline = false, Shade = false })
		kit.Text(block, b[4], 18, 19, 20, kit.Darken(b[3], 0.35), 3)
	end
	return nil
end

-- Xylophone (lames arc-en-ciel, maillets, notes)
Art.Xylophone = function(body, kit, _item)
	local C = kit.C
	local colors = { C.Red, C.Orange, C.Yellow, C.Leaf, C.Sky, C.Lilac }
	kit.Line(body, 8, 66, 92, 58, 5, C.WoodDark, 0, 1)
	kit.Line(body, 8, 90, 92, 82, 5, C.WoodDark, 0, 1)
	for index, color in ipairs(colors) do
		local h = 40 - index * 3
		local x = 8 + (index - 1) * 14
		local bar = kit.Part(body, x, 78 - h / 2 - index * 1.4, 12, h, color, { Radius = 4, Z = 2, Shine = true })
		kit.Circle(bar, 6, 5, 3, 3, WHITE, 0.2, 2)
		kit.Circle(bar, 6, h - 5, 3, 3, WHITE, 0.2, 2)
	end
	local mallet = kit.Pivot(body, 70, 40, 4)
	kit.Line(mallet, 0, 0, 16, -22, 2.5, C.WoodLight, 0, 1)
	kit.Blob(mallet, 0, 0, 10, 10, C.Pink, { Z = 2 })
	kit.Animate(mallet, "Sway", 10, 2, 0)
	local note = kit.Text(body, "🎵", 88, 26, 14, C.PinkDeep, 5)
	kit.Animate(note, "Bob", 3, 1, 0.3)
	return nil
end

-- Diable en boîte (ressort qui rebondit, clown souriant)
Art.JackInTheBox = function(body, kit, _item)
	local C = kit.C
	local box = kit.Part(body, 16, 56, 68, 44, C.Sky, { Radius = 8, Z = 3, Shine = true })
	for index = 0, 2 do
		kit.Diamond(box, 14 + index * 20, 22, 10, index == 1 and C.Butter or C.Pink, 0, 2)
	end
	kit.Part(body, 84, 70, 10, 6, C.Gold, { Radius = 3, Z = 2 }) -- manivelle
	kit.Line(body, 94, 73, 94, 62, 3, C.Gold, 0, 2)
	kit.Part(body, 12, 50, 50, 8, C.Pink, { Radius = 4, Z = 4, Rotation = -28 }) -- couvercle ouvert
	local jack = kit.Group(body, 0, 0, 100, 100, 2)
	kit.Animate(jack, "Bob", 4, 2.2, 0)
	for index = 0, 3 do
		kit.Part(jack, 42, 40 + index * 5, 16, 4, C.GreyDark, { Radius = 2, Z = 1, Outline = false })
	end
	local head = kit.Blob(jack, 50, 28, 30, 28, C.Cream, { Z = 2, Shine = true })
	kit.Face(head, 15, 16, 20, { Eyes = "happy", Mouth = "o", Z = 3 })
	kit.Circle(jack, 50, 32, 7, 7, C.Red, 0, 4)
	kit.Triangle(jack, 50, 0, 26, 18, C.Lilac, 3)
	kit.Circle(jack, 50, 2, 7, 7, C.Butter, 0, 4)
	return nil
end

-- Petite voiture rose (roues, phares, drapeau)
Art.ToyCar = function(body, kit, _item)
	local C = kit.C
	local pink = Color3.fromRGB(255, 150, 196)
	kit.Part(body, 26, 38, 44, 28, kit.Lighten(pink, 0.15), { Radius = 12, Z = 1 })
	kit.Part(body, 32, 44, 32, 16, C.Glass, { Radius = 6, Z = 2 })
	kit.Box(body, 47, 44, 2, 16, WHITE, 0.2, 3)
	local car = kit.Part(body, 6, 56, 88, 30, pink, { Radius = 12, Z = 3, Shine = true })
	kit.Circle(car, 82, 12, 8, 8, C.Butter, 0, 2)
	kit.Heart(car, 44, 14, 12, WHITE, 0, 2)
	for _, x in ipairs({ 26, 74 }) do
		local wheel = kit.Blob(body, x, 88, 22, 22, C.Ink, { Z = 4 })
		kit.Circle(wheel, 11, 11, 10, 10, C.Grey, 0, 2)
		kit.Animate(wheel, "Spin", 1, 0.2, 0)
	end
	kit.Line(body, 28, 38, 28, 16, 2, C.GreyDark, 0, 0)
	local flag = kit.Part(body, 28, 14, 16, 10, C.Butter, { Radius = 2, Z = 0 })
	kit.Animate(flag, "Sway", 6, 2, 0)
	return nil
end

-- Pile de peluches (ours, lapin, chat empilés)
Art.PlushPile = function(body, kit, _item)
	local C = kit.C
	local function plush(cx, cy, w, color, earKind, z)
		if earKind == "bunny" then
			for _, side in ipairs({ -1, 1 }) do
				kit.Blob(body, cx + side * w * 0.2, cy - w * 0.62, w * 0.22, w * 0.5, color, { Z = z })
			end
		elseif earKind == "cat" then
			for _, side in ipairs({ -1, 1 }) do
				kit.Part(body, cx + side * w * 0.26 - w * 0.12, cy - w * 0.46, w * 0.24, w * 0.24, color, { Radius = 3, Z = z, Rotation = 45 })
			end
		else
			for _, side in ipairs({ -1, 1 }) do
				kit.Circle(body, cx + side * w * 0.34, cy - w * 0.36, w * 0.28, w * 0.28, color, 0, z)
			end
		end
		local head = kit.Blob(body, cx, cy, w, w * 0.86, color, { Z = z + 1, Shine = true })
		kit.Face(head, w / 2, w * 0.46, w * 0.6, { Mouth = earKind == "cat" and "cat" or "smile", Z = 3 })
	end
	kit.Blob(body, 50, 86, 90, 28, C.Wood, { Z = 1 }) -- corps de l'ours du bas
	plush(28, 74, 40, C.Wood, "bear", 2)
	plush(72, 74, 38, C.PinkSoft, "bunny", 2)
	plush(50, 40, 36, C.Butter, "cat", 5)
	kit.Heart(body, 50, 96, 12, C.Pink, 0, 8)
	return nil
end

-- Ordinateur rétro (écran vert qui défile, disquette)
Art.RetroComputer = function(body, kit, _item)
	local C = kit.C
	local beige = Color3.fromRGB(246, 236, 214)
	kit.Part(body, 10, 80, 80, 18, beige, { Radius = 5, Z = 1, Shine = true }) -- clavier
	for row = 0, 1 do
		for col = 0, 7 do
			kit.Box(body, 16 + col * 9, 84 + row * 6, 7, 4, kit.Darken(beige, 0.15), 0, 2)
		end
	end
	local case = kit.Part(body, 16, 10, 68, 64, beige, { Radius = 10, Z = 2, Shine = true })
	local screen = kit.Part(case, 8, 8, 52, 38, Color3.fromRGB(60, 80, 90), { Radius = 8, Z = 2 })
	for index = 0, 3 do
		local line = kit.Box(screen, 6, 6 + index * 7, 20 + (index * 13) % 22, 3, C.Mint, 0.1, 2)
		kit.Animate(line, "Pulse", 0.5, 1.5, index)
	end
	kit.Heart(screen, 42, 28, 10, C.Pink, 0, 3)
	kit.Box(case, 20, 52, 26, 4, kit.Darken(beige, 0.2), 0, 3) -- fente disquette
	kit.Part(body, 70, 62, 16, 16, C.Lilac, { Radius = 2, Z = 3, Rotation = 12 })
	return nil
end

-- Juke-box (arche lumineuse, disques, bulles de couleur)
Art.Jukebox = function(body, kit, _item)
	local C = kit.C
	local wood = Color3.fromRGB(200, 120, 110)
	local cabinet = kit.Part(body, 12, 18, 76, 82, wood, { Radius = 30, Z = 1, Shine = true })
	local _ = cabinet
	local arch = kit.Part(body, 18, 22, 64, 30, C.Butter, { Radius = 26, Z = 2 })
	local bulbs = {}
	for index = 0, 5 do
		local a = math.pi * (index / 5)
		local color = ({ C.Pink, C.Sky, C.Mint })[index % 3 + 1]
		local halo = kit.Circle(arch, 32 - math.cos(a) * 24, 26 - math.sin(a) * 18, 13, 13, color, 0.6, 2)
		local bulb = kit.Circle(arch, 32 - math.cos(a) * 24, 26 - math.sin(a) * 18, 7, 7, color, 0, 3)
		bulb:SetAttribute("Phase", index * 0.9)
		table.insert(bulbs, bulb)
		table.insert(bulbs, halo)
	end
	local window = kit.Part(body, 26, 46, 48, 24, C.Glass, { Radius = 6, Z = 3 })
	local record = kit.Blob(window, 24, 14, 26, 26, C.Ink, { Z = 2 })
	kit.Circle(record, 13, 13, 9, 9, C.Pink, 0, 2)
	kit.Animate(record, "Spin", 1, 0.5, 0)
	local speaker = kit.Part(body, 26, 74, 48, 20, kit.Darken(wood, 0.2), { Radius = 6, Z = 3 })
	for index = 0, 3 do
		kit.Box(speaker, 4, 3 + index * 4, 40, 2, C.Gold, 0.2, 2)
	end
	local note = kit.Text(body, "🎶", 90, 30, 14, C.PinkDeep, 5)
	kit.Animate(note, "Bob", 3, 1, 0)
	return { Bulbs = bulbs, Glow = Color3.fromRGB(255, 220, 150) }
end

-- Flipper (plateau incliné, bille qui file, lumières)
Art.PinballMachine = function(body, kit, _item)
	local C = kit.C
	local purple = Color3.fromRGB(170, 120, 230)
	for _, x in ipairs({ 16, 80 }) do
		kit.Part(body, x, 64, 6, 36, C.GreyDark, { Radius = 2, Z = 1 })
	end
	local table_ = kit.Part(body, 8, 48, 84, 22, purple, { Radius = 8, Z = 2, Shine = true })
	kit.Box(table_, 6, 4, 72, 12, C.Navy, 0.2, 2)
	local ball = kit.Circle(table_, 30, 10, 6, 6, WHITE, 0, 3)
	kit.Animate(ball, "Drift", 20, 1.2, 0)
	local head = kit.Part(body, 56, 6, 38, 50, purple, { Radius = 8, Z = 3, Shine = true })
	local screen = kit.Part(head, 5, 6, 28, 26, C.Navy, { Radius = 5, Z = 2 })
	kit.Text(screen, "⭐", 14, 13, 16, C.Butter, 3)
	local bulbs = {}
	for index = 0, 2 do
		local color = ({ C.Pink, C.Butter, C.Mint })[index + 1]
		local halo = kit.Circle(head, 10 + index * 9, 40, 11, 11, color, 0.6, 2)
		local bulb = kit.Circle(head, 10 + index * 9, 40, 6, 6, color, 0, 3)
		bulb:SetAttribute("Phase", index * 1.4)
		table.insert(bulbs, bulb)
		table.insert(bulbs, halo)
	end
	return { Bulbs = bulbs }
end

-- Projecteur d'hologrammes (base ronde, faisceau, planète qui tourne)
Art.Hologram = function(body, kit, _item)
	local C = kit.C
	kit.Blob(body, 50, 90, 60, 18, C.GreyDark, { Z = 1, Shine = true })
	kit.Blob(body, 50, 84, 40, 10, C.Sky, { Z = 2, Outline = false })
	local beam = kit.Triangle(body, 50, 20, 60, 66, C.Sky, 1, 0.75, 10)
	local _ = beam
	local holo = kit.Group(body, 0, 0, 100, 100, 3)
	kit.Animate(holo, "Bob", 3, 1, 0)
	local planet = kit.Blob(holo, 50, 36, 30, 30, C.Mint, { Z = 1, T = 0.25, Outline = C.Sky })
	kit.Circle(planet, 10, 10, 8, 6, WHITE, 0.4, 2)
	local ring = kit.Part(holo, 30, 34, 40, 6, C.Sky, { Radius = 3, Z = 2, T = 0.3, Rotation = -14, Shade = false })
	kit.Animate(ring, "Pulse", 0.4, 1.5, 0)
	for index, spot in ipairs({ { 24, 20 }, { 78, 26 }, { 70, 56 } }) do
		local sparkle = kit.Sparkle(holo, spot[1], spot[2], 8, C.Sky, 0.1, 3)
		kit.Animate(sparkle, "Pulse", 0.7, 1.4, index)
	end
	return { Glow = Color3.fromRGB(150, 220, 255) }
end

-- Trois glaces à l'eau dans un verre
Art.Popsicles = function(body, kit, _item)
	local C = kit.C
	for index, p in ipairs({ { 30, C.Pink, -14 }, { 50, C.Butter, 0 }, { 70, C.Mint, 14 } }) do
		local stick = kit.Pivot(body, p[1], 70, index)
		stick.Rotation = p[3]
		kit.Part(stick, -3, -12, 6, 24, C.WoodLight, { Radius = 2, Z = 1 })
		local ice = kit.Part(stick, -11, -48, 22, 38, p[2], { Radius = 10, Z = 2, Shine = true })
		kit.Box(ice, 0, 22, 22, 5, kit.Darken(p[2], 0.12), 0, 2)
		kit.Face(ice, 11, 14, 14, { Z = 3 })
	end
	kit.Part(body, 26, 64, 48, 36, C.Glass, { Radius = 8, Z = 5, T = 0.3 })
	kit.Shine(body, 30, 68, 5, 20, 6, 0.3)
	return nil
end

-- Gaufrier (ouvert : gaufre dorée en cœur)
Art.WaffleMaker = function(body, kit, _item)
	local C = kit.C
	local shell = Color3.fromRGB(255, 190, 210)
	kit.Part(body, 10, 34, 80, 26, shell, { Radius = 12, Z = 1, Rotation = -8 }) -- couvercle ouvert
	local base = kit.Part(body, 8, 64, 84, 34, shell, { Radius = 12, Z = 2, Shine = true })
	local waffle = kit.Heart(base, 42, 12, 36, C.Butter, 0, 2)
	local _ = waffle
	for index = 0, 2 do
		kit.Box(base, 30 + index * 8, 2, 2, 18, kit.Darken(C.Butter, 0.25), 0.3, 3)
		kit.Box(base, 28, 4 + index * 6, 28, 2, kit.Darken(C.Butter, 0.25), 0.3, 3)
	end
	kit.Circle(base, 72, 22, 6, 6, C.Mint, 0, 3)
	local steam = kit.Text(body, "~", 50, 26, 16, WHITE, 4)
	kit.Animate(steam, "Bob", 2, 1, 0)
	return nil
end

-- Panier vapeur en bambou (raviolis qui fument)
Art.DumplingSteamer = function(body, kit, _item)
	local C = kit.C
	local bamboo = Color3.fromRGB(226, 190, 130)
	kit.Part(body, 8, 66, 84, 32, bamboo, { Radius = 10, Z = 1, Shine = true })
	kit.Box(body, 8, 76, 84, 3, kit.Darken(bamboo, 0.2), 0.3, 2)
	for index, x in ipairs({ 26, 50, 74 }) do
		local dumpling = kit.Blob(body, x, 60, 24, 20, C.Cream, { Z = 3, Shine = true })
		kit.Face(dumpling, 12, 12, 12, { Eyes = index == 2 and "happy" or "dot", Z = 2 })
		kit.Line(body, x - 5, 51, x + 5, 51, 1.5, kit.OutlineOf(C.Cream), 0.3, 4)
	end
	for index = 0, 2 do
		local steam = kit.Blob(body, 30 + index * 20, 30, 10, 18, WHITE, { Z = 4, T = 0.4, Outline = false, Shade = false })
		kit.Animate(steam, "Bob", 3, 1, index)
	end
	return nil
end

-- Évier de cuisine (plan de travail : on y pose des choses, robinet, bulles)
Art.KitchenSink = function(body, kit, _item)
	local C = kit.C
	local cabinet = kit.Part(body, 4, 44, 92, 56, C.MintSoft, { Radius = 8, Z = 1, Shine = true })
	for _, x in ipairs({ 8, 50 }) do
		kit.Part(cabinet, x, 10, 38, 40, WHITE, { Radius = 5, Z = 2, T = 0.2 })
		kit.Circle(cabinet, x + (x < 40 and 34 or 4), 30, 4, 4, C.Gold, 0, 3)
	end
	kit.Part(body, 2, 38, 96, 8, WHITE, { Radius = 3, Z = 2 }) -- plan de travail
	kit.Part(body, 30, 36, 40, 6, C.Grey, { Radius = 3, Z = 3 }) -- cuve
	kit.Line(body, 50, 38, 50, 18, 4, C.GreyDark, 0, 3)
	kit.Line(body, 50, 18, 38, 22, 4, C.GreyDark, 0, 3)
	local drop = kit.Circle(body, 38, 28, 4, 5, C.Sky, 0, 4)
	kit.Animate(drop, "Bob", 3, 2, 0)
	for index = 0, 2 do
		local bubble = kit.Circle(body, 32 + index * 8, 30 - index * 4, 7, 7, WHITE, 0.3, 4)
		kit.Animate(bubble, "Bob", 2, 1, index)
	end
	return nil
end

-- Maison en pain d'épices (glaçage, bonbons, fumée sucrée)
Art.GingerbreadHouse = function(body, kit, _item)
	local C = kit.C
	local ginger = Color3.fromRGB(196, 130, 80)
	kit.Blob(body, 50, 94, 90, 12, WHITE, { Z = 1, Outline = false })
	local house = kit.Part(body, 18, 48, 64, 48, ginger, { Radius = 6, Z = 2, Shine = true })
	kit.Part(house, 24, 22, 16, 26, kit.Darken(ginger, 0.25), { Radius = 7, Z = 2 })
	kit.Heart(house, 32, 30, 8, C.Pink, 0, 3)
	for _, x in ipairs({ 6, 46 }) do
		local win = kit.Part(house, x, 8, 12, 12, C.Butter, { Radius = 3, Z = 2 })
		kit.Box(win, 5, 0, 2, 12, WHITE, 0, 2)
	end
	kit.Triangle(body, 50, 14, 84, 38, kit.Darken(ginger, 0.1), 3)
	for index = 0, 6 do
		kit.Circle(body, 12 + index * 12.7, 51, 9, 7, WHITE, 0, 4) -- glaçage
	end
	for index, color in ipairs({ C.Red, C.Mint, C.Pink, C.Sky }) do
		kit.Circle(body, 30 + (index - 1) * 13, 38 - (index % 2) * 8, 6, 6, color, 0, 4)
	end
	kit.Part(body, 66, 18, 10, 16, C.Pink, { Radius = 2, Z = 2 })
	local smoke = kit.Circle(body, 71, 12, 8, 8, WHITE, 0.3, 2)
	kit.Animate(smoke, "Bob", 3, 0.8, 0)
	return nil
end

return Art
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="23">
              <Properties>
                <string name="Name">Furniture</string>
                <string name="Source"><![CDATA[--[[
	Furniture (ModuleScript) — dessins des meubles 🛋️
	Emplacement : ReplicatedStorage > Client > Components > House > Art > Furniture
	Contrat : voir HouseArt (boîte 100 x 100, pieds en bas pour les objets au sol).
]]

local Art = {}

----------------------------------------------------------------------
-- Petits outils partagés
----------------------------------------------------------------------

-- Flamme (goutte : ovale en bas + pointe arrondie) ; `bottom` = y du bas ; vacille
local function flame(kit, parent, cx, bottom, w, h, color, z, phase)
	local holder = kit.Group(parent, cx - w / 2, bottom - h, w, h, z)
	local bulbH = math.min(h * 0.62, w * 1.05)
	kit.Circle(holder, w / 2, h - bulbH / 2, w, bulbH, color, 0, 1)
	local side = w * 0.62
	local tip = kit.Box(holder, 0, 0, side, side, color, 0, 1)
	tip.AnchorPoint = Vector2.new(0.5, 0.5)
	tip.Position = UDim2.fromOffset(w / 2, side * 0.71)
	tip.Rotation = 45
	kit.Round(tip, side * 0.22)
	local stretch = h - bulbH / 2 - side * 0.71
	if stretch > side * 0.5 then
		-- flamme haute : on relie la pointe au bas par un ovale étroit
		kit.Circle(holder, w / 2, (side * 0.71 + h - bulbH / 2) / 2, side * 0.95, stretch + side * 0.4, color, 0, 1)
	end
	kit.Animate(holder, "Flicker", 0, 1, phase)
	return holder
end

-- Canard en plastique (regarde à droite) ; (cx, bottom) = milieu du bas
local function duck(kit, parent, cx, bottom, size, z)
	local C = kit.C
	local s = size / 20
	local holder = kit.Group(parent, cx - 10 * s, bottom - 18 * s, 20 * s, 18 * s, z)
	kit.Blob(holder, 9 * s, 12.5 * s, 18 * s, 11 * s, C.Yellow, { Z = 1 })
	kit.Blob(holder, 13 * s, 5.5 * s, 10 * s, 10 * s, C.Yellow, { Z = 2, Shine = true })
	kit.Blob(holder, 19 * s, 7 * s, 5 * s, 3 * s, C.Orange, { Z = 3, Thickness = 1 })
	kit.Circle(holder, 14.5 * s, 4.5 * s, 2 * s, 2.2 * s, C.Ink, 0, 3)
	kit.Blob(holder, 6.5 * s, 11 * s, 7 * s, 4.5 * s, kit.Lighten(C.Yellow, 0.35), { Z = 2, Outline = false, Shade = false })
	return holder
end

-- Paire de pieds de meuble
local function feet(kit, body, xs, top, w, h, color, z)
	for _, x in ipairs(xs) do
		kit.Part(body, x, top, w, h, color, { Radius = 2, Z = z or 1 })
	end
end

----------------------------------------------------------------------
-- Meubles
----------------------------------------------------------------------

-- Chaise en bois : dossier à barreaux avec un cœur, coussin rose
Art.WoodenChair = function(body, kit, _item)
	local C = kit.C
	feet(kit, body, { 28, 66 }, 64, 6, 34, C.WoodDark, 1) -- pieds arrière
	for _, x in ipairs({ 20, 72 }) do
		kit.Part(body, x, 10, 8, 56, C.Wood, { Radius = 3, Z = 2 }) -- montants
	end
	for _, x in ipairs({ 36, 47, 58 }) do
		kit.Part(body, x, 20, 6, 34, C.WoodLight, { Radius = 3, Z = 2 }) -- barreaux
	end
	local top = kit.Part(body, 15, 5, 70, 17, C.WoodLight, { Radius = 8, Z = 3, Shine = true })
	kit.Heart(top, 35, 9, 10, C.Pink, 0, 4)
	kit.Part(body, 10, 58, 80, 11, C.WoodLight, { Radius = 5, Z = 4 }) -- assise
	local cushion = kit.Part(body, 15, 50, 70, 12, C.PinkSoft, { Radius = -1, Z = 5, Shine = true })
	for _, x in ipairs({ 22, 35, 48 }) do
		kit.Circle(cushion, x, 6, 2.2, 2.2, C.Pink, 0.2, 4) -- points de couture
	end
	kit.Part(body, 22, 84, 56, 4, C.WoodDark, { Radius = 2, Z = 2 }) -- barreau bas
	feet(kit, body, { 13, 79 }, 66, 8, 34, C.Wood, 3) -- pieds avant
	return nil
end

-- Carton de rangement ouvert : rabats, jouets qui dépassent, petit visage
Art.StorageBox = function(body, kit, _item)
	local C = kit.C
	local kraft = Color3.fromRGB(236, 190, 140)
	kit.Part(body, 0, 36, 34, 12, kit.Darken(kraft, 0.06), { Radius = 3, Z = 1, Rotation = -22 })
	kit.Part(body, 66, 36, 34, 12, kit.Darken(kraft, 0.06), { Radius = 3, Z = 1, Rotation = 22 })
	kit.Part(body, 12, 38, 76, 14, kit.Darken(kraft, 0.3), { Radius = 3, Z = 1, Shade = false }) -- intérieur
	kit.Blob(body, 34, 40, 22, 22, C.Pink, { Z = 2, Shine = true }) -- balle
	local block = kit.Part(body, 54, 30, 18, 18, C.Sky, { Radius = 4, Z = 2, Rotation = 12 })
	kit.Text(block, "A", 9, 9, 11, C.White, 3)
	kit.Line(body, 76, 46, 82, 24, 3, C.Lilac, 0, 2) -- baguette
	kit.Sparkle(body, 83, 22, 12, C.Yellow, 0, 3)
	local front = kit.Part(body, 8, 46, 84, 52, kraft, { Radius = 6, Z = 4, Shade = 0.16, Shine = true })
	kit.Box(front, 36, 0, 12, 52, kit.Lighten(kraft, 0.35), 0.1, 2) -- scotch
	kit.Face(front, 42, 28, 30, { Eyes = "dot", Mouth = "cat", Z = 4 })
	kit.Heart(front, 72, 40, 9, C.PinkDeep, 0, 3)
	return nil
end

-- Échelle en bois avec un plaid rayé posé sur un barreau
Art.Ladder = function(body, kit, _item)
	local C = kit.C
	local function leftX(y)
		return 30 + (99 - y) / 96 * 9
	end
	local function rightX(y)
		return 70 - (99 - y) / 96 * 9
	end
	for _, y in ipairs({ 16, 38, 60, 82 }) do
		local x1, x2 = leftX(y), rightX(y)
		kit.Part(body, x1, y - 3, x2 - x1, 6, C.WoodLight, { Radius = 3, Z = 1 })
	end
	for _, rail in ipairs({ { 30, 39 }, { 70, 61 } }) do
		local frame = kit.Line(body, rail[1], 97, rail[2], 4, 7, C.Wood, 0, 2)
		kit.Stroke(frame, kit.OutlineOf(C.Wood), 1.6)
		kit.Gradient(frame, C.White, Color3.new(0.88, 0.88, 0.88), 0)
		kit.Part(body, rail[1] - 4.5, 94, 9, 6, C.WoodDark, { Radius = 2, Z = 3 }) -- patins
	end
	-- plaid
	local blanket = kit.Part(body, 32, 34, 36, 40, C.PinkSoft, { Radius = 5, Z = 4, Shine = true })
	for _, y in ipairs({ 14, 26 }) do
		kit.Box(blanket, 0, y, 36, 4, C.Pink, 0.1, 2)
	end
	for index = 0, 4 do
		kit.Line(body, 36 + index * 7, 74, 36 + index * 7, 79, 2, C.Pink, 0, 3) -- franges
	end
	local fold = kit.Part(body, 30, 31, 40, 9, kit.Lighten(C.PinkSoft, 0.3), { Radius = -1, Z = 5 })
	kit.Heart(fold, 20, 4.5, 6, C.PinkDeep, 0, 3)
	return nil
end

-- Table de chevet lilas : tiroir à lune, veilleuse lune endormie
Art.Nightstand = function(body, kit, _item)
	local C = kit.C
	local lilac = Color3.fromRGB(214, 196, 250)
	feet(kit, body, { 18, 76 }, 88, 6, 12, C.WoodDark, 1)
	local cabinet = kit.Part(body, 14, 50, 72, 42, lilac, { Radius = 6, Z = 2 })
	for index, y in ipairs({ 6, 23 }) do
		local drawer = kit.Part(cabinet, 6, y, 60, 14, kit.Lighten(lilac, 0.45), { Radius = 4, Z = 2 })
		if index == 1 then
			kit.Circle(drawer, 30, 7, 9, 9, C.Butter, 0, 2) -- lune (croissant)
			kit.Circle(drawer, 33, 5.5, 8, 8, kit.Lighten(lilac, 0.45), 0, 3)
		else
			kit.Blob(drawer, 30, 7, 10, 5, C.Gold, { Z = 2, Thickness = 1 })
		end
	end
	kit.Part(body, 8, 44, 84, 9, C.WoodLight, { Radius = 4, Z = 3, Shine = true }) -- plateau
	-- veilleuse
	kit.Part(body, 43, 38, 14, 7, C.Wood, { Radius = 3, Z = 2 })
	local moon = kit.Blob(body, 50, 24, 28, 28, C.Butter, { Z = 3, Shine = true })
	kit.Circle(moon, 21, 18, 5, 5, kit.Darken(C.Butter, 0.08), 0, 2)
	kit.Circle(moon, 7, 20, 3, 3, kit.Darken(C.Butter, 0.08), 0, 2)
	kit.Face(moon, 14, 15, 16, { Eyes = "closed", Mouth = "smile", Z = 3 })
	kit.Sparkle(body, 76, 22, 9, C.Butter, 0, 4)
	kit.Sparkle(body, 24, 30, 6, C.White, 0, 4)
	return { Glow = C.Butter }
end

-- Valise de voyage menthe : poignée, sangles, autocollants, roulettes
Art.Suitcase = function(body, kit, _item)
	local C = kit.C
	local mint = Color3.fromRGB(150, 222, 196)
	kit.Part(body, 38, 14, 24, 18, C.Brown, { Radius = 7, Z = 1, T = 1, Outline = C.Brown, Thickness = 4, Shade = false })
	for _, x in ipairs({ 24, 72 }) do
		kit.Circle(body, x, 95, 8, 8, C.GreyDark, 0, 1)
	end
	local case = kit.Part(body, 14, 26, 72, 68, mint, { Radius = 12, Z = 2, Shine = true, Shade = 0.16 })
	kit.Box(case, 0, 30, 72, 3, kit.Darken(mint, 0.15), 0, 2) -- fermeture
	for _, x in ipairs({ 13, 52 }) do
		local strap = kit.Part(case, x, -1, 7, 70, C.Brown, { Radius = 2, Z = 3 })
		kit.Part(strap, -1, 36, 9, 7, C.Gold, { Radius = 2, Z = 2, Thickness = 1 })
	end
	local sticker = kit.Blob(case, 36, 17, 18, 18, C.PinkSoft, { Z = 4, Thickness = 1.2 })
	kit.Heart(sticker, 9, 9, 10, C.Pink, 0, 2)
	local star = kit.Part(case, 25, 44, 18, 13, C.Butter, { Radius = 3, Z = 4, Thickness = 1.2, Rotation = -10 })
	kit.Sparkle(star, 9, 6.5, 10, C.Orange, 0, 2)
	kit.Circle(case, 36, 63, 6, 4, C.White, 0.5, 4)
	return nil
end

-- Toilettes royales : couronne dorée, lunette rose, petit visage
Art.Toilet = function(body, kit, _item)
	local C = kit.C
	local porcelain = Color3.fromRGB(250, 250, 255)
	local tank = kit.Part(body, 26, 20, 48, 34, porcelain, { Radius = 7, Z = 1, Shine = true })
	kit.Blob(tank, 36, 12, 7, 7, C.Gold, { Z = 2, Thickness = 1 }) -- bouton chasse
	kit.Heart(tank, 24, 20, 9, C.Pink, 0, 2)
	kit.Part(body, 22, 16, 56, 8, porcelain, { Radius = 4, Z = 2 }) -- couvercle
	-- couronne
	for _, x in ipairs({ 40, 50, 60 }) do
		kit.Part(body, x - 4.5, 5, 9, 9, C.Gold, { Radius = 2, Z = 2, Rotation = 45, Thickness = 1.2 })
		kit.Circle(body, x, 3, 4, 4, C.Butter, 0, 3)
	end
	local band = kit.Part(body, 35, 10, 30, 7, C.Gold, { Radius = 2, Z = 3, Thickness = 1.2 })
	kit.Diamond(band, 15, 3.5, 3.5, C.Heart, 0, 2)
	-- cuvette + pied
	kit.Part(body, 36, 76, 28, 20, porcelain, { Radius = 6, Z = 3 })
	local bowl = kit.Part(body, 14, 58, 72, 26, porcelain, { Radius = 13, Z = 4 })
	kit.Face(bowl, 36, 12, 22, { Eyes = "happy", Mouth = "smile", Z = 3 })
	kit.Blob(body, 50, 58, 82, 14, C.PinkSoft, { Z = 5, Shine = true }) -- lunette
	kit.Part(body, 30, 93, 40, 7, C.Gold, { Radius = 3, Z = 4, Thickness = 1.2, Shine = true }) -- socle doré
	return nil
end

-- Commode aux tiroirs pastel arc-en-ciel, cactus et cadre photo
Art.DrawerCabinet = function(body, kit, _item)
	local C = kit.C
	feet(kit, body, { 16, 78 }, 90, 6, 10, C.WoodDark, 1)
	local cabinet = kit.Part(body, 10, 28, 80, 64, C.Cream, { Radius = 6, Z = 2 })
	local colors = { C.PinkSoft, Color3.fromRGB(255, 236, 180), C.MintSoft, C.LilacSoft }
	for index, color in ipairs(colors) do
		local drawer = kit.Part(cabinet, 5, 4 + (index - 1) * 15, 70, 12, color, { Radius = 4, Z = 2, Thickness = 1.3 })
		kit.Blob(drawer, 35, 6, 9, 5, kit.Darken(color, 0.2), { Z = 2, Thickness = 1 })
	end
	kit.Part(body, 6, 24, 88, 8, C.WoodLight, { Radius = 4, Z = 3, Shine = true }) -- plateau
	-- cactus
	local cactus = kit.Blob(body, 26, 12, 12, 20, C.Leaf, { Z = 4 })
	kit.Face(cactus, 6, 8, 10, { Eyes = "dot", Mouth = "none", Z = 3 })
	kit.Blob(body, 19, 12, 5, 9, C.Leaf, { Z = 3 })
	kit.Circle(body, 26, 2.5, 4, 4, C.Pink, 0, 5)
	kit.Part(body, 18, 17, 16, 9, C.Orange, { Radius = 2, Z = 5 })
	-- cadre photo
	local frame = kit.Part(body, 56, 4, 24, 21, C.Wood, { Radius = 3, Z = 4, Rotation = 4 })
	local photo = kit.Part(frame, 3.5, 3.5, 17, 14, C.Sky, { Radius = 2, Z = 2, Outline = false, Shade = false })
	kit.Heart(photo, 8.5, 7, 8, C.Pink, 0, 2)
	return nil
end

-- Lit mezzanine : lit en hauteur, échelle, guirlande et petit bureau dessous
Art.LoftBed = function(body, kit, _item)
	local C = kit.C
	local frameColor = Color3.fromRGB(245, 235, 250)
	for _, x in ipairs({ 5, 87 }) do
		kit.Part(body, x, 6, 8, 94, frameColor, { Radius = 3, Z = 5 }) -- montants
	end
	kit.Part(body, 2, 42, 96, 9, C.WoodLight, { Radius = 3, Z = 4 }) -- sommier
	kit.Part(body, 10, 32, 80, 12, C.White, { Radius = 5, Z = 2 }) -- matelas
	local blanket = kit.Part(body, 36, 27, 54, 17, C.Lilac, { Radius = 6, Z = 3, Shine = true })
	for _, p in ipairs({ { 14, 10 }, { 28, 7 }, { 42, 11 } }) do
		kit.Heart(blanket, p[1], p[2], 6, C.LilacSoft, 0, 2)
	end
	local pillow = kit.Blob(body, 24, 29, 24, 13, C.PinkSoft, { Z = 3, Shine = true })
	kit.Heart(pillow, 16, 7, 5, C.Pink, 0, 2)
	-- garde-corps
	kit.Part(body, 5, 18, 50, 5, frameColor, { Radius = 2, Z = 6 })
	for _, x in ipairs({ 36, 51 }) do
		kit.Part(body, x, 22, 4, 22, frameColor, { Radius = 2, Z = 6 })
	end
	-- guirlande lumineuse sous le lit
	kit.Line(body, 14, 54, 86, 54, 1.2, C.GreyDark, 0.3, 2)
	local bulbs = { C.Butter, C.Pink, C.Mint, C.Sky, C.Butter, C.Pink }
	for index, color in ipairs(bulbs) do
		local bulb = kit.Circle(body, 18 + (index - 1) * 12, 57, 5, 6, color, 0, 3)
		kit.Animate(bulb, "Pulse", 0.4, 1, index * 1.3)
	end
	-- petit bureau
	kit.Part(body, 16, 74, 42, 5, C.Wood, { Radius = 2, Z = 3 })
	feet(kit, body, { 19, 51 }, 78, 4, 22, C.WoodDark, 2)
	local screen = kit.Part(body, 22, 63, 17, 11, C.Sky, { Radius = 2, Z = 3 }) -- écran
	kit.Heart(screen, 8.5, 5.5, 6, C.White, 0, 2)
	kit.Part(body, 28, 70, 4, 5, C.GreyDark, { Radius = 1, Z = 2, Outline = false })
	kit.Blob(body, 49, 70, 8, 8, C.Pink, { Z = 3 }) -- tasse
	-- échelle
	for _, x in ipairs({ 66, 80 }) do
		kit.Part(body, x, 44, 4, 56, C.Wood, { Radius = 2, Z = 7 })
	end
	for _, y in ipairs({ 58, 72, 86 }) do
		kit.Part(body, 67, y, 16, 4, C.WoodLight, { Radius = 2, Z = 6 })
	end
	return nil
end

-- Bureau d'étude : lampe articulée, livres, pot à crayons, pomme
Art.StudyDesk = function(body, kit, _item)
	local C = kit.C
	-- caisson + pied
	local pedestal = kit.Part(body, 8, 54, 32, 44, C.Cream, { Radius = 4, Z = 1 })
	for _, y in ipairs({ 5, 23 }) do
		local drawer = kit.Part(pedestal, 4, y, 24, 15, C.MintSoft, { Radius = 3, Z = 2, Thickness = 1.3 })
		kit.Blob(drawer, 12, 7.5, 8, 4, C.Mint, { Z = 2, Thickness = 1 })
	end
	kit.Part(body, 83, 54, 7, 44, C.Wood, { Radius = 2, Z = 1 })
	kit.Part(body, 40, 60, 44, 4, C.WoodDark, { Radius = 2, Z = 1 })
	kit.Part(body, 3, 48, 94, 8, C.WoodLight, { Radius = 3, Z = 3, Shine = true }) -- plateau
	-- lampe
	kit.Blob(body, 17, 46, 16, 6, C.Mint, { Z = 2 })
	kit.Line(body, 17, 45, 12, 26, 3, C.GreyDark, 0, 1)
	kit.Line(body, 12, 26, 26, 14, 3, C.GreyDark, 0, 1)
	kit.Circle(body, 12, 26, 5, 5, C.Mint, 0, 2)
	local shade = kit.Part(body, 22, 10, 22, 12, C.Mint, { Radius = 6, Z = 3, Rotation = 24, Shine = true })
	kit.Circle(shade, 11, 12, 8, 6, C.Butter, 0, 2)
	-- livres
	local books = { { 44, 40, 30, C.Pink }, { 46, 34, 26, C.Sky }, { 43, 29, 28, C.Butter } }
	for _, b in ipairs(books) do
		local book = kit.Part(body, b[1], b[2], b[3], 6, b[4], { Radius = 2, Z = 4, Thickness = 1.3 })
		kit.Box(book, b[3] - 5, 1.5, 3, 3, C.White, 0.2, 2)
	end
	kit.Blob(body, 58, 24, 9, 9, C.Red, { Z = 4, Shine = true }) -- pomme
	kit.Blob(body, 61, 18.5, 5, 3, C.Leaf, { Z = 5, Thickness = 1, Rotation = -20 })
	-- pot à crayons
	for index, color in ipairs({ C.Yellow, C.Pink, C.Sky }) do
		local x = 80 + (index - 2) * 4
		kit.Line(body, x, 42, x + (index - 2) * 3, 24, 3, color, 0, 4)
	end
	local cup = kit.Part(body, 74, 32, 16, 17, C.Lilac, { Radius = 4, Z = 5, Shine = true })
	kit.Heart(cup, 8, 10, 7, C.White, 0, 2)
	return nil
end

-- Bibliothèque garnie : livres de toutes les couleurs, plante, bocal à cœurs
Art.Bookshelf = function(body, kit, _item)
	local C = kit.C
	feet(kit, body, { 14, 80 }, 94, 6, 6, C.WoodDark, 1)
	kit.Part(body, 8, 10, 84, 86, C.Wood, { Radius = 6, Z = 2 })
	kit.Part(body, 13, 15, 74, 76, kit.Darken(C.Wood, 0.28), { Radius = 3, Z = 3, Outline = false })
	for _, y in ipairs({ 38, 64 }) do
		kit.Part(body, 10, y, 80, 5, C.WoodLight, { Radius = 2, Z = 5 })
	end
	local palette = { C.Pink, C.Sky, C.Butter, C.Mint, C.Lilac, C.Peach, C.PinkSoft }
	local function book(x, bottom, w, h, color, rot)
		return kit.Part(body, x, bottom - h, w, h, color, { Radius = 2, Z = 4, Thickness = 1.2, Rotation = rot })
	end
	-- rayon du haut
	local shelf1 = { { 16, 8, 19 }, { 24, 7, 16 }, { 31, 9, 20 }, { 40, 7, 17 } }
	for index, b in ipairs(shelf1) do
		book(b[1], 38, b[2], b[3], palette[index], nil)
	end
	book(49, 38, 7, 18, palette[5], 14)
	-- bocal à cœurs
	local jar = kit.Part(body, 66, 23, 16, 15, C.Glass, { Radius = 5, Z = 4, T = 0.2, Shine = true })
	kit.Heart(jar, 5, 9, 6, C.Pink, 0, 2)
	kit.Heart(jar, 11, 8, 5, C.PinkDeep, 0, 2)
	kit.Part(body, 67, 20, 14, 4, C.Pink, { Radius = 2, Z = 5, Thickness = 1 })
	-- rayon du milieu : pile couchée + livres debout
	for index, b in ipairs({ { 16, 26, C.Mint }, { 18, 22, C.Pink }, { 17, 20, C.Butter } }) do
		kit.Part(body, b[1], 64 - index * 6, b[2], 6, b[3], { Radius = 2, Z = 4, Thickness = 1.2 })
	end
	local shelf2 = { { 48, 8, 20 }, { 56, 7, 18 }, { 63, 9, 21 }, { 72, 7, 17 } }
	for index, b in ipairs(shelf2) do
		book(b[1], 64, b[2], b[3], palette[index + 3], nil)
	end
	-- rayon du bas
	local shelf3 = { { 16, 9, 21 }, { 25, 7, 18 }, { 32, 8, 20 }, { 60, 8, 19 }, { 68, 9, 21 }, { 77, 7, 17 } }
	for index, b in ipairs(shelf3) do
		book(b[1], 90, b[2], b[3], palette[(index % #palette) + 1], nil)
	end
	local ball = kit.Blob(body, 50, 83, 14, 14, C.PinkSoft, { Z = 4, Shine = true })
	kit.Face(ball, 7, 7.5, 12, { Eyes = "dot", Mouth = "smile", Z = 3 })
	-- plante sur le dessus
	kit.Part(body, 66, 0, 14, 11, C.Peach, { Radius = 3, Z = 6 })
	for _, leaf in ipairs({ { 68, -4, -30 }, { 76, -5, 30 }, { 62, 6, -70 } }) do
		kit.Blob(body, leaf[1], leaf[2], 8, 12, C.Leaf, { Z = 5, Rotation = leaf[3], Thickness = 1.2 })
	end
	return nil
end

-- Canapé moelleux rose : dossier, 2 coussins, accoudoirs ronds, petits pieds
Art.Sofa = function(body, kit, _item)
	local C = kit.C
	local pink = Color3.fromRGB(255, 170, 200)
	for _, x in ipairs({ 12, 82 }) do
		kit.Part(body, x, 88, 6, 12, C.WoodDark, { Radius = 2, Z = 2 })
	end
	kit.Part(body, 8, 30, 84, 44, pink, { Radius = 18, Z = 2 }) -- dossier
	kit.Part(body, 4, 62, 92, 30, pink, { Radius = 12, Z = 3, Shade = 0.18 }) -- assise
	for _, x in ipairs({ 16, 51 }) do
		local cushion = kit.Part(body, x, 38, 33, 30, kit.Lighten(pink, 0.35), { Radius = 12, Z = 4, Shine = true })
		kit.Circle(cushion, 16.5, 15, 3, 3, kit.OutlineOf(pink), 0.3, 3) -- bouton capitonné
	end
	for _, x in ipairs({ 0, 80 }) do
		kit.Part(body, x, 48, 20, 42, kit.Darken(pink, 0.04), { Radius = 10, Z = 5, Shine = true }) -- accoudoirs
	end
	kit.Heart(body, 50, 80, 10, C.PinkDeep, 0, 6)
	-- petit coussin menthe
	local pillow = kit.Part(body, 60, 44, 20, 18, C.MintSoft, { Radius = 7, Z = 6, Rotation = 12, Shine = true })
	kit.Face(pillow, 10, 10, 13, { Eyes = "happy", Mouth = "smile", Z = 3 })
	return nil
end

-- Pouf pêche : grosse pêche moelleuse avec sa feuille et un visage
Art.Beanbag = function(body, kit, _item)
	local C = kit.C
	local peach = Color3.fromRGB(255, 186, 160)
	local bag = kit.Blob(body, 50, 64, 92, 70, peach, { Z = 2, Shade = 0.14, Shine = true })
	kit.Gradient(bag, Color3.fromRGB(255, 236, 210), Color3.fromRGB(255, 200, 215), 90)
	kit.Blob(bag, 64, 30, 34, 30, C.Pink, { Z = 1, T = 0.6, Outline = false, Shade = false }) -- joue rosée
	kit.Line(bag, 46, 4, 42, 24, 2.4, kit.OutlineOf(peach), 0.35, 2) -- sillon
	kit.Blob(body, 50, 34, 30, 7, kit.Darken(peach, 0.08), { Z = 3, Outline = false, Shade = false, T = 0.3 }) -- creux
	kit.Line(body, 50, 30, 52, 22, 3, C.Brown, 0, 3)
	kit.Blob(body, 62, 23, 20, 10, C.Leaf, { Z = 4, Rotation = -18, Shine = true })
	kit.Blob(body, 40, 25, 14, 8, C.LeafDark, { Z = 3, Rotation = 24 })
	kit.Face(body, 50, 70, 30, { Eyes = "happy", Mouth = "cat", Z = 5 })
	return nil
end

-- Coiffeuse : miroir cœur avec ampoules, flacons de parfum, rouge à lèvres
Art.VanityTable = function(body, kit, _item)
	local C = kit.C
	-- miroir
	kit.Part(body, 46, 46, 8, 12, C.Gold, { Radius = 2, Z = 1 })
	kit.Heart(body, 50, 30, 60, kit.OutlineOf(C.Pink), 0, 2)
	kit.Heart(body, 50, 30, 56, C.Pink, 0, 3)
	local glass = kit.Heart(body, 50, 30.5, 44, C.Glass, 0, 4)
	kit.Gradient(glass, C.White, Color3.fromRGB(200, 210, 255), 90)
	kit.Line(body, 37, 25, 43, 19, 3, C.White, 0.2, 5)
	kit.Line(body, 38, 32, 40, 30, 3, C.White, 0.2, 5)
	for index, p in ipairs({ { 30, 10 }, { 50, 12 }, { 70, 10 }, { 24, 30 }, { 76, 30 } }) do
		local bulb = kit.Circle(body, p[1], p[2], 6, 6, C.Butter, 0, 6)
		kit.Stroke(bulb, C.Gold, 1)
		kit.Animate(bulb, "Pulse", 0.35, 0.8, index * 1.7)
	end
	-- table
	kit.Part(body, 4, 56, 92, 8, C.Cream, { Radius = 4, Z = 3, Shine = true })
	local apron = kit.Part(body, 9, 63, 82, 13, C.PinkSoft, { Radius = 4, Z = 2 })
	kit.Blob(apron, 41, 6.5, 10, 5, C.Gold, { Z = 2, Thickness = 1 })
	for _, x in ipairs({ 11, 83 }) do
		kit.Part(body, x, 72, 6, 26, C.Cream, { Radius = 3, Z = 1 })
		kit.Blob(body, x + 3, 98, 9, 5, C.Gold, { Z = 2, Thickness = 1 })
	end
	-- parfums et rouge à lèvres
	local bottle = kit.Part(body, 12, 44, 14, 14, C.LilacSoft, { Radius = 5, Z = 5, Shine = true, T = 0.1 })
	kit.Circle(bottle, 7, 9, 7, 5, C.Lilac, 0.2, 2)
	kit.Blob(body, 19, 41, 7, 6, C.Gold, { Z = 6, Thickness = 1 })
	kit.Part(body, 78, 48, 7, 10, C.Gold, { Radius = 2, Z = 5, Thickness = 1 })
	kit.Part(body, 79, 41, 5, 9, C.Red, { Radius = 2, Z = 4, Thickness = 1 })
	kit.Blob(body, 88, 54, 10, 7, C.MintSoft, { Z = 5 })
	return nil
end

-- Armoire pastel : une porte ouverte sur une robe rose, carton à chapeau
Art.Wardrobe = function(body, kit, _item)
	local C = kit.C
	local lilac = Color3.fromRGB(222, 206, 252)
	feet(kit, body, { 14, 80 }, 92, 6, 8, C.WoodDark, 1)
	local cabinet = kit.Part(body, 8, 16, 84, 78, lilac, { Radius = 6, Z = 2 })
	kit.Part(body, 4, 10, 92, 9, kit.Lighten(lilac, 0.4), { Radius = 4, Z = 3, Shine = true }) -- corniche
	-- porte gauche (fermée)
	local door = kit.Part(cabinet, 4, 5, 37, 56, kit.Lighten(lilac, 0.3), { Radius = 4, Z = 2 })
	local panel = kit.Part(door, 5, 5, 27, 46, kit.Lighten(lilac, 0.55), { Radius = 8, Z = 2, Thickness = 1.2 })
	kit.Heart(panel, 13.5, 20, 11, C.Pink, 0, 2)
	kit.Circle(door, 33, 30, 4, 4, C.Gold, 0, 3)
	-- intérieur + penderie
	local inside = kit.Part(cabinet, 43, 5, 37, 56, kit.Darken(lilac, 0.28), { Radius = 3, Z = 2, Outline = false })
	kit.Line(inside, 3, 6, 34, 6, 2, C.GreyDark, 0, 2)
	kit.Line(inside, 12, 6, 12, 11, 1.5, C.GreyDark, 0, 2)
	kit.Part(inside, 7, 10, 10, 10, C.Pink, { Radius = 3, Z = 3 }) -- haut de la robe
	kit.Triangle(inside, 12, 16, 22, 28, C.Pink, 3, 0, 8) -- jupe
	kit.Heart(inside, 12, 25, 6, C.White, 0, 4)
	kit.Line(inside, 27, 6, 27, 11, 1.5, C.GreyDark, 0, 2)
	kit.Part(inside, 21, 10, 12, 26, C.Mint, { Radius = 3, Z = 3 }) -- chemise
	-- porte ouverte (vue de profil)
	kit.Part(body, 91, 20, 8, 58, kit.Lighten(lilac, 0.3), { Radius = 3, Z = 4 })
	-- tiroir du bas
	local drawer = kit.Part(cabinet, 4, 63, 76, 11, kit.Lighten(lilac, 0.3), { Radius = 3, Z = 2 })
	kit.Blob(drawer, 38, 5.5, 10, 4, C.Gold, { Z = 2, Thickness = 1 })
	-- carton à chapeau
	local hatbox = kit.Part(body, 16, -2, 30, 13, C.PinkSoft, { Radius = 4, Z = 4 })
	kit.Box(hatbox, 13, 0, 4, 13, C.Pink, 0, 2)
	kit.Part(body, 14, -5, 34, 5, C.Pink, { Radius = 2, Z = 5 })
	kit.Heart(body, 31, -7, 8, C.PinkDeep, 0, 6)
	return nil
end

-- Fauteuil gamer rose à oreilles de chat, sur roulettes
Art.GamingChair = function(body, kit, _item)
	local C = kit.C
	local pink = Color3.fromRGB(255, 160, 200)
	-- piètement
	kit.Line(body, 20, 93, 80, 93, 5, C.GreyDark, 0, 1)
	kit.Line(body, 34, 90, 66, 90, 5, C.GreyDark, 0, 1)
	for _, x in ipairs({ 20, 80, 36, 64 }) do
		kit.Circle(body, x, 97, 6, 6, C.Ink, 0, 2)
	end
	kit.Part(body, 46, 74, 8, 18, C.Grey, { Radius = 2, Z = 1 })
	-- oreilles
	for _, x in ipairs({ 33, 67 }) do
		local ear = kit.Part(body, x - 8, 6, 16, 16, pink, { Radius = 4, Z = 2, Rotation = 45 })
		kit.Part(ear, 2.5, 2.5, 8, 8, C.PinkSoft, { Radius = 3, Z = 2, Outline = false, Shade = false })
	end
	-- dossier
	local back = kit.Part(body, 22, 10, 56, 58, pink, { Radius = 16, Z = 3, Shade = 0.16 })
	local stripe = kit.Part(back, 15, 8, 26, 44, C.White, { Radius = 10, Z = 2, Shine = true })
	kit.Face(stripe, 13, 22, 20, { Eyes = "big", Mouth = "cat", Z = 3 })
	kit.Heart(stripe, 13, 5, 7, C.Pink, 0, 3)
	-- assise + accoudoirs
	kit.Part(body, 16, 62, 68, 14, pink, { Radius = 7, Z = 4, Shine = true })
	for _, x in ipairs({ 8, 80 }) do
		kit.Part(body, x + 4, 56, 4, 14, C.GreyDark, { Radius = 2, Z = 4 })
		kit.Part(body, x, 51, 12, 7, C.White, { Radius = 3, Z = 5 })
	end
	return nil
end

-- Douche à l'italienne : carrelage menthe, pommeau, gouttes, rideau, canard
Art.Shower = function(body, kit, _item)
	local C = kit.C
	local wall = kit.Part(body, 8, 8, 84, 86, C.MintSoft, { Radius = 5, Z = 1 })
	for index = 1, 4 do
		kit.Box(wall, index * 16.8, 0, 1.5, 86, C.White, 0.1, 2)
	end
	for index = 1, 4 do
		kit.Box(wall, 0, index * 17, 84, 1.5, C.White, 0.1, 2)
	end
	-- tuyau + pommeau
	kit.Line(body, 78, 64, 78, 14, 3.5, C.Grey, 0, 2)
	kit.Line(body, 78, 14, 60, 14, 3.5, C.Grey, 0, 2)
	local head = kit.Part(body, 48, 14, 24, 10, C.Grey, { Radius = 5, Z = 3, Shine = true })
	for index = 0, 3 do
		kit.Circle(head, 5 + index * 4.7, 7.5, 2, 2, C.GreyDark, 0, 2)
	end
	kit.Circle(body, 72, 64, 7, 7, C.Pink, 0, 3)
	kit.Circle(body, 84, 64, 7, 7, C.Sky, 0, 3)
	-- gouttes qui tombent
	for index, p in ipairs({ { 52, 32 }, { 58, 44 }, { 64, 30 }, { 55, 58 }, { 67, 50 }, { 61, 70 } }) do
		local drop = kit.Line(body, p[1], p[2], p[1] - 1, p[2] + 6, 2.4, C.Sky, 0.1, 4)
		kit.Animate(drop, "Bob", 2.5, 1.6, index * 0.9)
	end
	-- receveur
	kit.Part(body, 2, 90, 96, 10, C.White, { Radius = 4, Z = 5, Shine = true })
	-- rideau + tringle
	kit.Line(body, 4, 6, 96, 6, 3, C.Gold, 0, 6)
	local curtain = kit.Part(body, 6, 6, 26, 82, C.PinkSoft, { Radius = 6, Z = 5 })
	for _, x in ipairs({ 7, 14, 20 }) do
		kit.Box(curtain, x, 4, 2, 76, C.Pink, 0.5, 2)
	end
	kit.Heart(curtain, 11, 40, 7, C.Pink, 0, 3)
	for _, x in ipairs({ 10, 18, 26 }) do
		kit.Circle(body, x, 6, 5, 5, C.Gold, 0, 7)
	end
	duck(kit, body, 80, 92, 16, 6)
	return nil
end

-- Baignoire à pieds dorés débordant de mousse, canard et bulles
Art.Bathtub = function(body, kit, _item)
	local C = kit.C
	for _, x in ipairs({ 20, 80 }) do
		kit.Blob(body, x, 94, 14, 12, C.Gold, { Z = 1, Shine = true })
	end
	-- robinet
	kit.Line(body, 12, 48, 12, 30, 4, C.Gold, 0, 1)
	kit.Line(body, 12, 30, 22, 30, 4, C.Gold, 0, 1)
	kit.Line(body, 22, 30, 22, 35, 4, C.Gold, 0, 1)
	kit.Circle(body, 7, 40, 5, 5, C.Pink, 0, 2)
	-- mousse
	local foam = { { 22, 44, 18 }, { 36, 40, 20 }, { 52, 39, 22 }, { 68, 42, 18 }, { 80, 45, 14 }, { 44, 46, 14 }, { 60, 47, 12 } }
	for _, f in ipairs(foam) do
		kit.Blob(body, f[1], f[2], f[3], f[3], C.White, { Z = 2, Outline = C.Sky, Thickness = 1.3, Shade = 0.06 })
	end
	duck(kit, body, 64, 36, 16, 3)
	local tub = kit.Part(body, 6, 50, 88, 40, C.White, { Radius = 18, Z = 4, Shade = 0.14 })
	kit.Gradient(tub, C.White, Color3.fromRGB(255, 220, 236), 90)
	kit.Box(tub, 0, 14, 88, 4, C.Pink, 0.3, 2)
	kit.Heart(tub, 44, 26, 10, C.Pink, 0, 3)
	kit.Part(body, 2, 46, 96, 9, C.White, { Radius = -1, Z = 5, Shine = true }) -- rebord
	-- bulles qui flottent
	for index, b in ipairs({ { 30, 22, 8 }, { 84, 26, 6 }, { 44, 12, 5 }, { 74, 10, 7 } }) do
		local bubble = kit.Blob(body, b[1], b[2], b[3], b[3], C.Glass, { Z = 6, T = 0.5, Outline = C.Sky, Thickness = 1, Shade = false })
		kit.Circle(bubble, b[3] * 0.32, b[3] * 0.32, b[3] * 0.3, b[3] * 0.3, C.White, 0.1, 2)
		kit.Animate(bubble, "Bob", 2, 0.8, index * 1.4)
	end
	return nil
end

-- Cheminée en briques roses : feu qui crépite, bûches, bougies sur le manteau
Art.Fireplace = function(body, kit, _item)
	local C = kit.C
	local brick = Color3.fromRGB(240, 164, 164)
	local wall = kit.Part(body, 6, 20, 88, 76, brick, { Radius = 5, Z = 1 })
	local mortar = kit.Lighten(brick, 0.35)
	for _, b in ipairs({ { 4, 8 }, { 60, 6 }, { 10, 22 }, { 66, 20 }, { 2, 38 }, { 68, 36 }, { 8, 54 }, { 62, 52 } }) do
		kit.Part(wall, b[1], b[2], 16, 7, mortar, { Radius = 2, Z = 2, Outline = false, Shade = false, T = 0.3 })
	end
	-- foyer
	local hearth = kit.Part(body, 24, 40, 52, 58, Color3.fromRGB(70, 40, 58), { Radius = 24, Z = 2, Thickness = 2.5, Outline = C.Cream })
	local glow = kit.Box(hearth, 0, 20, 52, 38, C.Orange, 0.2, 1)
	kit.Round(glow, 20)
	kit.Fade(glow, 1, 0, 90)
	kit.Animate(glow, "Pulse", 0.35, 1.2, 0)
	-- flammes
	flame(kit, hearth, 26, 50, 30, 40, C.Orange, 3, 0)
	flame(kit, hearth, 15, 50, 16, 24, C.Orange, 3, 1.7)
	flame(kit, hearth, 37, 50, 15, 26, C.Orange, 3, 3.1)
	flame(kit, hearth, 26, 51, 20, 28, C.Yellow, 4, 0.8)
	flame(kit, hearth, 26, 51, 10, 16, C.Cream, 5, 2.2)
	-- bûches
	kit.Part(hearth, 8, 47, 36, 7, C.Brown, { Radius = -1, Z = 6, Rotation = 8 })
	kit.Part(hearth, 8, 47, 36, 7, kit.Darken(C.Brown, 0.1), { Radius = -1, Z = 6, Rotation = -8 })
	for index, p in ipairs({ { 12, 18 }, { 40, 22 }, { 32, 8 } }) do
		local ember = kit.Circle(hearth, p[1], p[2], 3, 3, C.Butter, 0, 7)
		kit.Animate(ember, "Bob", 1.5, 1.3, index * 2.1)
	end
	-- dalle + manteau
	kit.Part(body, 2, 94, 96, 6, C.Cream, { Radius = 3, Z = 3 })
	kit.Part(body, 0, 14, 100, 10, C.Cream, { Radius = 4, Z = 3, Shine = true })
	-- guirlande de cœurs sous le manteau
	kit.Line(body, 10, 27, 90, 27, 1.2, C.White, 0.3, 4)
	for index = 0, 2 do
		kit.Heart(body, 18 + index * 32, 30, 8, C.PinkDeep, 0, 4)
	end
	-- déco du manteau : bougies, cadre, plante
	for index, x in ipairs({ 12, 20 }) do
		local h = if index == 1 then 12 else 9
		kit.Part(body, x - 3, 14 - h, 6, h, C.PinkMist, { Radius = 2, Z = 2 })
		local wick = kit.Blob(body, x, 14 - h - 3, 4, 6, C.Orange, { Z = 2, Outline = false, Shade = false })
		kit.Animate(wick, "Flicker", 0.3, 1, index * 1.9)
	end
	local frame = kit.Part(body, 40, -2, 22, 16, C.Gold, { Radius = 3, Z = 2 })
	local picture = kit.Part(frame, 3, 3, 16, 10, C.Sky, { Radius = 2, Z = 2, Outline = false, Shade = false })
	kit.Heart(picture, 8, 5, 7, C.Pink, 0, 2)
	kit.Part(body, 78, 6, 12, 9, C.Peach, { Radius = 2, Z = 2 })
	kit.Blob(body, 80, 2, 7, 10, C.Leaf, { Z = 1, Rotation = -25 })
	kit.Blob(body, 88, 2, 7, 10, C.Leaf, { Z = 1, Rotation = 25 })
	return { Glow = C.Orange }
end

-- Lit à baldaquin de princesse : couronne, voilages noués, tête de lit cœur
Art.CanopyBed = function(body, kit, _item)
	local C = kit.C
	local gold = C.Gold
	-- montants
	for _, x in ipairs({ 5, 89 }) do
		kit.Part(body, x, 12, 6, 86, C.Cream, { Radius = 3, Z = 1 })
	end
	-- tête de lit
	local headboard = kit.Part(body, 18, 34, 64, 40, C.PinkSoft, { Radius = 20, Z = 2 })
	for _, p in ipairs({ { 14, 14 }, { 50, 14 }, { 32, 26 } }) do
		kit.Circle(headboard, p[1], p[2], 3, 3, C.Pink, 0.2, 2)
	end
	kit.Heart(body, 50, 30, 18, gold, 0, 3)
	kit.Heart(body, 50, 30, 12, C.PinkDeep, 0, 4)
	-- matelas, oreillers, couverture
	kit.Part(body, 12, 64, 76, 14, C.White, { Radius = 6, Z = 3 })
	for _, x in ipairs({ 36, 64 }) do
		local pillow = kit.Blob(body, x, 63, 28, 14, C.PinkMist, { Z = 4, Shine = true })
		kit.Heart(pillow, 18, 8, 6, C.Pink, 0, 2)
	end
	local blanket = kit.Part(body, 10, 70, 80, 18, C.Pink, { Radius = 6, Z = 5, Shine = true })
	kit.Gradient(blanket, C.White, Color3.fromRGB(255, 200, 225), 90)
	for index = 0, 6 do
		kit.Circle(blanket, 6 + index * 11.3, 18, 9, 7, C.PinkSoft, 0, 2) -- volants
	end
	kit.Heart(blanket, 40, 8, 8, C.White, 0, 3)
	-- pied de lit
	kit.Part(body, 6, 86, 88, 9, C.Cream, { Radius = 4, Z = 6 })
	feet(kit, body, { 8, 86 }, 94, 6, 6, gold, 5)
	-- baldaquin
	kit.Part(body, 0, 6, 100, 9, C.Cream, { Radius = 4, Z = 7, Shine = true })
	for index = 0, 6 do
		kit.Circle(body, 7 + index * 14.3, 16, 15, 11, C.Pink, 0, 6) -- festons
	end
	-- voilages noués
	for _, side in ipairs({ -1, 1 }) do
		local x = if side < 0 then 1 else 83
		local drape = kit.Part(body, x, 12, 16, 48, C.PinkSoft, { Radius = 8, Z = 8, T = 0.15, Rotation = side * 4 })
		kit.Box(drape, 7, 4, 2, 40, C.White, 0.4, 2)
		kit.Part(body, x + 2, 58, 12, 32, C.PinkSoft, { Radius = 6, Z = 8, T = 0.15, Rotation = -side * 5 })
		kit.Heart(body, x + 8, 59, 11, C.PinkDeep, 0, 9) -- nœud
	end
	-- couronne
	for _, x in ipairs({ 40, 50, 60 }) do
		kit.Part(body, x - 4.5, -3, 9, 9, gold, { Radius = 2, Z = 8, Rotation = 45, Thickness = 1.2 })
		kit.Circle(body, x, -5, 4, 4, C.Butter, 0, 9)
	end
	local band = kit.Part(body, 36, 1, 28, 7, gold, { Radius = 2, Z = 9, Thickness = 1.2 })
	kit.Diamond(band, 14, 3.5, 3.5, C.Heart, 0, 2)
	return nil
end

-- Lit nuage : gros nuage moelleux, oreiller endormi, couette étoilée, rêves
Art.CloudBed = function(body, kit, _item)
	local C = kit.C
	local bed = kit.Group(body, 0, 0, 100, 100, 2)
	kit.Animate(bed, "Bob", 1.5, 0.6, 0)
	local line = Color3.fromRGB(190, 170, 235)
	local function puffs(list, color, z)
		for _, p in ipairs(list) do
			kit.Circle(bed, p[1], p[2], p[3] + 3.2, p[3] * p[4] + 3.2, line, 0, z) -- contour
		end
		for _, p in ipairs(list) do
			local puff = kit.Circle(bed, p[1], p[2], p[3], p[3] * p[4], color, 0, z + 1)
			kit.Gradient(puff, C.White, Color3.fromRGB(236, 226, 255), 90)
		end
	end
	-- tête de lit nuage
	puffs({ { 14, 48, 24, 1 }, { 26, 38, 26, 1 }, { 12, 64, 20, 1 } }, C.White, 1)
	-- nuage du lit
	puffs({
		{ 14, 80, 26, 0.8 },
		{ 32, 74, 30, 0.8 },
		{ 52, 72, 30, 0.8 },
		{ 72, 74, 30, 0.8 },
		{ 88, 80, 22, 0.9 },
		{ 50, 86, 84, 0.26 },
	}, C.White, 3)
	-- oreiller endormi
	local pillow = kit.Blob(bed, 26, 60, 28, 16, C.PinkSoft, { Z = 6, Shine = true })
	kit.Face(pillow, 14, 8, 16, { Eyes = "closed", Mouth = "smile", Z = 3 })
	-- couette étoilée
	local quilt = kit.Part(bed, 38, 57, 58, 18, C.Lilac, { Radius = 9, Z = 7, Shine = true })
	kit.Gradient(quilt, C.White, Color3.fromRGB(215, 200, 255), 90)
	for _, p in ipairs({ { 14, 10, 6 }, { 30, 7, 5 }, { 44, 11, 6 } }) do
		kit.Sparkle(quilt, p[1], p[2], p[3], C.Butter, 0, 3)
	end
	kit.Circle(quilt, 22, 13, 2, 2, C.White, 0, 3)
	kit.Circle(quilt, 50, 5, 2, 2, C.White, 0, 3)
	-- lune et étoiles
	local moon = kit.Blob(bed, 76, 22, 20, 20, C.Butter, { Z = 5, Shine = true })
	kit.Face(moon, 10, 11, 13, { Eyes = "closed", Mouth = "none", Z = 3 })
	for index, s in ipairs({ { 52, 30, 10 }, { 92, 42, 8 }, { 44, 14, 7 }, { 62, 46, 6 } }) do
		local star = kit.Sparkle(bed, s[1], s[2], s[3], if index % 2 == 0 then C.Pink else C.Butter, 0, 6)
		kit.Animate(star, "Bob", 1.5, 1.1, index * 1.3)
	end
	for index, z in ipairs({ { 40, 44, 9 }, { 46, 36, 7 } }) do
		local label = kit.Text(bed, "z", z[1], z[2], z[3], C.Purple, 8)
		kit.Animate(label, "Bob", 2, 0.9, index * 0.8)
	end
	return { Glow = Color3.fromRGB(215, 195, 255) }
end

-- Source chaude : bassin de pierres, capybara au yuzu, vapeur qui ondule
Art.HotSpring = function(body, kit, _item)
	local C = kit.C
	local stone = Color3.fromRGB(196, 190, 204)
	-- panneau ♨
	kit.Part(body, 85, 22, 4, 40, C.WoodDark, { Radius = 2, Z = 1 })
	local sign = kit.Part(body, 75, 16, 24, 16, C.WoodLight, { Radius = 4, Z = 2, Shine = true })
	kit.Text(sign, "♨️", 12, 8.5, 12, C.Red, 3)
	-- pierres du fond
	for _, s in ipairs({ { 9, 64, 20, 16 }, { 27, 58, 22, 14 }, { 50, 56, 26, 14 }, { 73, 58, 22, 14 }, { 91, 64, 20, 16 } }) do
		kit.Blob(body, s[1], s[2], s[3], s[4], stone, { Z = 3 })
	end
	-- eau
	local water = kit.Blob(body, 50, 75, 96, 32, C.Sky, { Z = 4, Outline = kit.Darken(C.Sky, 0.25) })
	kit.Gradient(water, Color3.fromRGB(215, 255, 245), Color3.fromRGB(150, 205, 250), 90)
	kit.Blob(water, 72, 12, 18, 3.5, C.White, { Z = 2, T = 0.3, Outline = false, Shade = false })
	kit.Blob(water, 20, 20, 12, 3, C.White, { Z = 2, T = 0.3, Outline = false, Shade = false })
	-- capybara (coupé à la surface de l'eau)
	local bath = kit.Group(body, 0, 0, 100, 77, 5, true)
	local fur = Color3.fromRGB(205, 150, 105)
	for _, x in ipairs({ 30, 52 }) do
		kit.Blob(bath, x, 55, 8, 7, kit.Darken(fur, 0.1), { Z = 1 })
	end
	local head = kit.Blob(bath, 41, 70, 36, 32, fur, { Z = 2, Shine = true })
	kit.Blob(head, 18, 20, 22, 13, kit.Lighten(fur, 0.4), { Z = 2, Outline = false, Shade = false })
	kit.Face(head, 18, 13, 26, { Eyes = "closed", Mouth = "none", Z = 3 })
	kit.Blob(head, 18, 18.5, 7, 4, C.Ink, { Z = 4, Outline = false, Shade = false })
	kit.Blob(bath, 41, 52, 14, 13, C.Orange, { Z = 3, Shine = true }) -- yuzu
	kit.Blob(bath, 46, 46, 8, 4.5, C.Leaf, { Z = 4, Rotation = -25, Thickness = 1 })
	kit.Line(body, 24, 77, 32, 77, 1.6, C.White, 0.2, 6) -- ronds dans l'eau
	kit.Line(body, 50, 77, 58, 77, 1.6, C.White, 0.2, 6)
	-- pierres de devant
	for _, s in ipairs({ { 8, 90, 20, 16 }, { 27, 94, 22, 12 }, { 50, 95, 26, 10 }, { 73, 94, 22, 12 }, { 92, 90, 20, 16 } }) do
		kit.Blob(body, s[1], s[2], s[3], s[4], stone, { Z = 7, Shine = true })
	end
	kit.Blob(body, 27, 90, 8, 3.5, C.Leaf, { Z = 8, Outline = false, Shade = false, T = 0.2 }) -- mousse
	kit.Blob(body, 76, 91, 6, 3, C.Leaf, { Z = 8, Outline = false, Shade = false, T = 0.2 })
	-- serviette pliée + seau
	local towel = kit.Part(body, 82, 76, 18, 9, C.PinkSoft, { Radius = 3, Z = 8, Shine = true })
	kit.Box(towel, 0, 5, 18, 2, C.Pink, 0.2, 2)
	local bucket = kit.Part(body, 1, 72, 14, 13, C.WoodLight, { Radius = 3, Z = 8 })
	kit.Box(bucket, 0, 3, 14, 2, C.WoodDark, 0.2, 2)
	kit.Box(bucket, 0, 9, 14, 2, C.WoodDark, 0.2, 2)
	-- vapeur
	for index, w in ipairs({ { 18, 50 }, { 64, 44 }, { 82, 54 } }) do
		local wisp = kit.Group(body, w[1] - 10, w[2] - 30, 20, 34, 9)
		kit.Circle(wisp, 10, 26, 14, 12, C.White, 0.35, 1)
		kit.Circle(wisp, 12, 16, 11, 10, C.White, 0.45, 1)
		kit.Circle(wisp, 9, 7, 8, 8, C.White, 0.55, 1)
		kit.Animate(wisp, "Bob", 3, 0.7, index * 1.6)
	end
	return nil
end

return Art
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="24">
              <Properties>
                <string name="Name">Kitchen</string>
                <string name="Source"><![CDATA[--[[
	Kitchen (ModuleScript) — dessins 🍰 de la cuisine
	Emplacement : ReplicatedStorage > Client > Components > House > Art > Kitchen
	Contrat : voir HouseArt (boîte 100 x 100, pieds en bas pour les objets au sol).
]]

local Art = {}

local WHITE = Color3.new(1, 1, 1)

----------------------------------------------------------------------
-- Petits outils partagés
----------------------------------------------------------------------

-- Volute de vapeur (3 traits blancs en zigzag) qui monte et descend
local function steam(body, kit, x, bottom, h, phase)
	local g = kit.Group(body, x - 6, bottom - h, 12, h, 8)
	local pts = { { 6, h }, { 3, h * 0.66 }, { 8.5, h * 0.33 }, { 5, 0 } }
	for i = 1, 3 do
		local a, b = pts[i], pts[i + 1]
		kit.Line(g, a[1], a[2], b[1], b[2], 2.6, WHITE, 0.15 + i * 0.15, 1)
	end
	kit.Animate(g, "Bob", 1.5, 0.8, phase)
	return g
end

-- Fraise (ovale rouge, pépins, collerette verte)
local function strawberry(parent, kit, cx, cy, s, z)
	local C = kit.C
	local berry = kit.Blob(parent, cx, cy, s, s * 1.08, C.Red, { Z = z, Thickness = 1.2 })
	for _, p in ipairs({ { 0.3, 0.42 }, { 0.66, 0.5 }, { 0.46, 0.74 } }) do
		kit.Circle(berry, s * p[1], s * 1.08 * p[2], math.max(1.2, s * 0.1), math.max(1.4, s * 0.13), C.Butter, 0, 2)
	end
	kit.Shine(berry, s * 0.18, s * 0.16, s * 0.2, s * 0.14, 3, 0.3)
	kit.Blob(parent, cx, cy - s * 0.5, s * 0.72, s * 0.3, C.Leaf, { Z = (z or 2) + 1, Thickness = 1.1, Shade = false })
	return berry
end

-- Anneau (anse de tasse, de théière...) : contour foncé + couleur + bord intérieur
local function ring(parent, kit, x, y, w, h, color, thick, z)
	local ink = kit.OutlineOf(color)
	kit.Part(parent, x, y, w, h, color, { Radius = -1, T = 1, Outline = ink, Thickness = thick + 3, Shade = false, Z = z })
	kit.Part(parent, x, y, w, h, color, { Radius = -1, T = 1, Outline = color, Thickness = thick, Shade = false, Z = z })
	kit.Part(parent, x + 1.4, y + 1.4, w - 2.8, h - 2.8, color, { Radius = -1, T = 1, Outline = ink, Thickness = 1.4, Shade = false, Z = z })
end

-- Formes unies avec un seul contour (sous-couche foncée puis remplissage)
local function union(parent, kit, shapes, color, z, thickness)
	local ink = kit.OutlineOf(color)
	local t = thickness or 1.6
	local fills = {}
	for _, s in ipairs(shapes) do
		local r = if s[5] < 0 then -1 else s[5] + t
		kit.Part(parent, s[1] - t, s[2] - t, s[3] + 2 * t, s[4] + 2 * t, ink, { Radius = r, Z = z, Outline = false, Shade = false })
	end
	for _, s in ipairs(shapes) do
		table.insert(fills, kit.Part(parent, s[1], s[2], s[3], s[4], color, { Radius = s[5], Z = z + 1, Outline = false, Shade = false }))
	end
	return fills
end

-- Coulure (pilule verticale arrondie)
local function drip(parent, kit, x, y, w, h, color, z, outline)
	return kit.Part(parent, x - w / 2, y, w, h, color, { Radius = -1, Z = z, Outline = outline or false, Shade = false, Thickness = 1.2 })
end

-- Cupcake : caissette rayée, crème en tourbillon, cerise
local function cupcake(parent, kit, cx, bottom, s, frost, wrap, z)
	local C = kit.C
	local cup = kit.Part(parent, cx - s * 0.34, bottom - s * 0.44, s * 0.68, s * 0.44, wrap, { Radius = 3, Z = z })
	for _, k in ipairs({ 0.33, 0.66 }) do
		kit.Box(cup, s * 0.68 * k - 0.6, 2, 1.2, s * 0.44 - 4, kit.OutlineOf(wrap), 0.55, 2)
	end
	kit.Blob(parent, cx, bottom - s * 0.46, s * 0.86, s * 0.28, frost, { Z = z + 1 })
	kit.Blob(parent, cx, bottom - s * 0.65, s * 0.62, s * 0.24, frost, { Z = z + 2, Shine = true })
	kit.Blob(parent, cx, bottom - s * 0.8, s * 0.32, s * 0.18, frost, { Z = z + 3 })
	kit.Blob(parent, cx, bottom - s * 0.93, s * 0.2, s * 0.2, C.Red, { Z = z + 4, Thickness = 1.1, Shine = true })
	return cup
end

-- Onigiri : triangle arrondi (losange + base), nori, visage
local function onigiri(parent, kit, cx, bottom, w, z, eyes)
	local rice = Color3.fromRGB(255, 253, 248)
	local ink = kit.OutlineOf(Color3.fromRGB(225, 215, 215))
	local h = w * 0.95
	local s = w * 0.62
	local cyD = bottom - h * 0.46
	kit.Part(parent, cx - (s + 3.2) / 2, cyD - (s + 3.2) / 2, s + 3.2, s + 3.2, ink, { Rotation = 45, Radius = s * 0.3 + 1.6, Outline = false, Shade = false, Z = z })
	kit.Part(parent, cx - w / 2, bottom - h * 0.5, w, h * 0.5, rice, { Radius = w * 0.22, Z = z + 1, Outline = ink })
	kit.Part(parent, cx - s / 2, cyD - s / 2, s, s, rice, { Rotation = 45, Radius = s * 0.3, Outline = false, Shade = false, Z = z + 2 })
	kit.Part(parent, cx - w * 0.2, bottom - h * 0.3, w * 0.4, h * 0.3, Color3.fromRGB(60, 80, 70), { Radius = 2, Z = z + 3 })
	kit.Face(parent, cx, bottom - h * 0.47, w * 0.5, { Eyes = eyes, Mouth = "smile", Z = z + 3 })
	kit.Shine(parent, cx - w * 0.3, bottom - h * 0.52, w * 0.12, w * 0.07, z + 3, 0.2)
	return nil
end

-- Donut vu de biais : pâte, glaçage, trou, vermicelles
local function donut(parent, kit, cx, cy, w, icing, sprinkles, z, rot)
	local g = kit.Group(parent, cx - w / 2, cy - w * 0.42, w, w * 0.84, z)
	g.Rotation = rot or 0
	local h = w * 0.84
	kit.Blob(g, w / 2, h / 2, w, h, Color3.fromRGB(235, 175, 105), { Z = 1 })
	local top = kit.Blob(g, w / 2, h * 0.45, w * 0.88, h * 0.72, icing, { Z = 2, Shine = true })
	kit.Blob(g, w / 2, h * 0.4, w * 0.22, h * 0.14, Color3.fromRGB(190, 125, 85), { Z = 3, Outline = false, Shade = false })
	for i, p in ipairs({ { 0.2, 0.55, 30 }, { 0.72, 0.3, -40 }, { 0.8, 0.62, 70 } }) do
		local sp = kit.Box(top, w * 0.88 * p[1], h * 0.72 * p[2], w * 0.1, 1.6, sprinkles[(i - 1) % #sprinkles + 1], 0, 4)
		sp.Rotation = p[3]
		kit.Round(sp)
	end
	return g
end


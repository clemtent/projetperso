			Card = card,
			Button = button,
			Stroke = stroke,
			Count = count,
			Favs = favs,
			More = more,
			Preview = preview,
			Lock = nil,
		}
		table.insert(roomCards, entry)
		fitFavorites(entry)
		button.Activated:Connect(function()
			buyRoomType(entry)
		end)
	end

	-- Silhouette d'un bâtiment (dessinée à taille "naturelle" puis réduite
	-- par un UIScale pour tenir dans la vignette) : cellules = pièces
	local CELL_W, CELL_H, CELL_GAP, FACADE_PAD = 24, 20, 4, 5
	local EXTERIORS: { [string]: { Facade: Color3, Edge: Color3, Roof: Color3, RoofDark: Color3 } } = {
		Cottage = {
			Facade = Color3.fromRGB(255, 244, 230),
			Edge = Color3.fromRGB(226, 186, 160),
			Roof = C.Pink,
			RoofDark = C.PinkDeep,
		},
		Townhouse = {
			Facade = Color3.fromRGB(238, 228, 255),
			Edge = Color3.fromRGB(176, 150, 230),
			Roof = Color3.fromRGB(150, 118, 212),
			RoofDark = Color3.fromRGB(118, 90, 180),
		},
		Loft = {
			Facade = Color3.fromRGB(232, 150, 128),
			Edge = Color3.fromRGB(176, 98, 86),
			Roof = Color3.fromRGB(118, 96, 110),
			RoofDark = Color3.fromRGB(92, 72, 88),
		},
		Mansion = {
			Facade = Color3.fromRGB(255, 248, 238),
			Edge = Color3.fromRGB(230, 196, 170),
			Roof = C.Pink,
			RoofDark = C.PinkDeep,
		},
	}

	local function drawBuilding(tile: Frame, size: SizeDef): ({ [number]: MiniCell }, UIScale, Vector2)
		local style = EXTERIORS[size.Exterior] or EXTERIORS.Cottage
		local cols, floors = math.max(1, size.Columns), math.max(1, size.Floors)
		local bodyW = cols * CELL_W + (cols - 1) * CELL_GAP + 2 * FACADE_PAD
		local bodyH = floors * CELL_H + (floors - 1) * CELL_GAP + 2 * FACADE_PAD
		local isMansion = size.Exterior == "Mansion"
		local towerW = isMansion and 18 or 0
		local roofH = if size.Exterior == "Loft" then 18 elseif isMansion then 26 else 22
		local groundH = 8
		local totalW = bodyW + 2 * towerW + 8
		local totalH = roofH + bodyH + groundH
		local holder = UIUtil.Create("Frame", {
			Name = "Building",
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -4),
			Size = UDim2.fromOffset(totalW, totalH),
			BackgroundTransparency = 1,
			ZIndex = 36,
			Parent = tile,
		})
		local scale = UIUtil.Create("UIScale", { Parent = holder })
		local left = towerW + 4
		local top = roofH
		-- Sol / jardin
		box(holder, 0, totalH - groundH, totalW, groundH, C.Mint, { Name = "Ground", Radius = 4, ZIndex = 37 })
		if isMansion then
			-- Haies rondes au pied des tours
			for _, x in ipairs({ 0, 9, totalW - 17, totalW - 8 }) do
				box(holder, x, totalH - groundH - 6, 9, 9, Color3.fromRGB(96, 196, 150), { Name = "Hedge", Radius = 5, ZIndex = 39 })
			end
		end
		-- Tours (manoir) : corps lilas + toit pointu en gradins + drapeau
		if isMansion then
			for _, x in ipairs({ 2, totalW - towerW - 2 }) do
				local towerTop = top - 6
				box(holder, x, towerTop, towerW, totalH - groundH - towerTop, C.LilacSoft, {
					Name = "Tower", Radius = 3, Stroke = style.Edge, StrokeThickness = 1, ZIndex = 37,
				})
				box(holder, x + 5, towerTop + 10, towerW - 10, 10, C.Sky, { Name = "TowerWindow", Radius = 4, ZIndex = 38 })
				box(holder, x - 2, towerTop - 6, towerW + 4, 7, C.Lilac, { Name = "TowerRoof", Radius = 3, ZIndex = 38 })
				box(holder, x + 2, towerTop - 12, towerW - 4, 7, C.Lilac, { Name = "TowerRoof", Radius = 3, ZIndex = 38 })
				box(holder, x + 6, towerTop - 18, towerW - 12, 7, C.Lilac, { Name = "TowerRoof", Radius = 3, ZIndex = 38 })
				box(holder, x + towerW / 2 - 0.5, towerTop - 26, 1.5, 9, style.Edge, { Name = "Pole", ZIndex = 38 })
				box(holder, x + towerW / 2 + 1, towerTop - 26, 7, 5, C.Heart, { Name = "Flag", Radius = 2, ZIndex = 38 })
			end
		end
		-- Toit
		if size.Exterior == "Loft" then
			-- Toit plat, château d'eau et petite plante
			box(holder, left - 3, top - 5, bodyW + 6, 6, style.RoofDark, { Name = "Roof", Radius = 2, ZIndex = 38 })
			box(holder, left + bodyW - 22, top - 17, 13, 9, C.Wood, { Name = "WaterTower", Radius = 3, ZIndex = 38 })
			box(holder, left + bodyW - 21, top - 8, 2, 4, C.WoodDark, { Name = "Leg", ZIndex = 38 })
			box(holder, left + bodyW - 12, top - 8, 2, 4, C.WoodDark, { Name = "Leg", ZIndex = 38 })
			box(holder, left + 6, top - 14, 10, 10, C.Mint, { Name = "Plant", Radius = 5, ZIndex = 38 })
			box(holder, left + 8, top - 7, 6, 4, C.WoodDark, { Name = "Pot", Radius = 1, ZIndex = 38 })
		elseif size.Exterior == "Townhouse" then
			-- Toit mansardé + lucarnes
			box(holder, left - 4, top - 6, bodyW + 8, 7, style.RoofDark, { Name = "Roof", Radius = 3, ZIndex = 38 })
			box(holder, left + 3, top - 16, bodyW - 6, 11, style.Roof, { Name = "Roof", Radius = 4, ZIndex = 38 })
			box(holder, left + bodyW / 2 - 12, top - 14, 8, 7, C.Butter, { Name = "Dormer", Radius = 2, ZIndex = 39 })
			box(holder, left + bodyW / 2 + 4, top - 14, 8, 7, C.Butter, { Name = "Dormer", Radius = 2, ZIndex = 39 })
			box(holder, left + bodyW - 14, top - 22, 6, 9, C.WoodDark, { Name = "Chimney", Radius = 1, ZIndex = 37 })
		else
			-- Toit en gradins arrondis (chaumière, fronton du manoir)
			local steps = isMansion and 4 or 3
			local stepH = math.floor((roofH - 2) / steps)
			for index = 1, steps do
				local inset = (index - 1) * (bodyW / (steps * 2 + 1))
				local color = index == 1 and style.RoofDark or style.Roof
				box(holder, left - 4 + inset, top - index * stepH, bodyW + 8 - inset * 2, stepH + 1, color, {
					Name = "Roof", Radius = 3, ZIndex = 38 + index,
				})
			end
			if isMansion then
				box(holder, left + bodyW / 2 - 4, top - steps * stepH - 7, 8, 7, C.Heart, { Name = "Heart", Radius = 4, ZIndex = 43 })
			else
				box(holder, left + bodyW - 16, top - roofH + 1, 6, 10, Color3.fromRGB(214, 120, 128), {
					Name = "Chimney", Radius = 1, ZIndex = 37,
				})
			end
		end
		-- Façade
		local facade = box(holder, left, top, bodyW, bodyH, style.Facade, {
			Name = "Facade", Radius = 4, Stroke = style.Edge, StrokeThickness = 1, ZIndex = 37,
		})
		-- Cellules = pièces (étage 1 en bas)
		local cells: { [number]: MiniCell } = {}
		for slot = 1, cols * floors do
			local floorIndex, column = HouseCommon.SlotCell(size, slot)
			local x = FACADE_PAD + (column - 1) * (CELL_W + CELL_GAP)
			local y = bodyH - FACADE_PAD - floorIndex * CELL_H - (floorIndex - 1) * CELL_GAP
			local cell = box(facade, x, y, CELL_W, CELL_H, C.Cream, {
				Name = "Cell" .. slot, Radius = 3, Stroke = style.Edge, StrokeThickness = 1, ZIndex = 38,
			})
			local floorStrip = box(cell, 0, CELL_H - 7, CELL_W, 7, C.Wood, { Name = "FloorStrip", Radius = 3, ZIndex = 39 })
			local label = UIUtil.Create("TextLabel", {
				Name = "Icon",
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Font = Theme.Fonts.Body,
				Text = "",
				TextSize = 13,
				ZIndex = 40,
				Parent = cell,
			})
			cells[slot] = { Frame = cell, Floor = floorStrip, Label = label }
		end
		-- Balcons entre les étages (maison de ville) / fleurs (chaumière)
		if size.Exterior == "Townhouse" then
			for floorIndex = 2, floors do
				local y = bodyH - FACADE_PAD - (floorIndex - 1) * (CELL_H + CELL_GAP) - CELL_H - 1
				box(facade, FACADE_PAD - 2, y + CELL_H - 1, bodyW - 2 * FACADE_PAD + 4, 2, style.Edge, { Name = "Balcony", ZIndex = 41 })
			end
		elseif size.Exterior == "Cottage" then
			for column = 1, cols do
				local x = FACADE_PAD + (column - 1) * (CELL_W + CELL_GAP)
				box(facade, x + 3, bodyH - 4, CELL_W - 6, 3, C.Mint, { Name = "FlowerBox", Radius = 1, ZIndex = 41 })
			end
		end
		return cells, scale, Vector2.new(totalW, totalH)
	end

	-- Aspect des cellules : pièces du joueur (maison actuelle) ou fenêtres
	local function paintCells(row: SizeRow, house: HouseData, current: boolean)
		local key = "other"
		if current then
			local parts = {}
			for _, room in ipairs(sortedRooms(house)) do
				table.insert(parts, room.Slot .. ":" .. room.Type .. ":" .. room.Wallpaper .. ":" .. room.Floor)
			end
			key = table.concat(parts, "|")
		end
		if row.CellKey == key then
			return
		end
		row.CellKey = key
		for slot, cell in pairs(row.Cells) do
			local room = current and HouseCommon.RoomAtSlot(house, slot) or nil
			if room then
				local wallpaper = HouseCommon.GetRoomWallpaper(room)
				local floor = HouseCommon.GetRoomFloor(room)
				local roomType = HouseCommon.GetRoomType(room)
				cell.Frame.BackgroundColor3 = wallpaper and wallpaper.A or C.Cream
				cell.Frame.BackgroundTransparency = 0
				cell.Floor.Visible = true
				cell.Floor.BackgroundColor3 = floor and floor.A or C.Wood
				cell.Label.Text = roomType and roomType.Icon or ""
			elseif current then
				-- Emplacement libre de la maison actuelle
				cell.Frame.BackgroundColor3 = WHITE
				cell.Frame.BackgroundTransparency = 0.25
				cell.Floor.Visible = false
				cell.Label.Text = ""
			else
				-- Autre maison : fenêtres éclairées
				cell.Frame.BackgroundColor3 = Color3.fromRGB(255, 244, 206)
				cell.Frame.BackgroundTransparency = 0
				cell.Floor.Visible = false
				cell.Label.Text = ""
			end
		end
	end

	-- Vignette plus large quand le tiroir l'est (le manoir reste lisible)
	layoutSizeRow = function(row: SizeRow)
		local tileW = width >= 400 and 132 or 104
		local tileH = SIZE_ROW_HEIGHT - 16
		row.Tile.Size = UDim2.fromOffset(tileW, tileH)
		row.Scale.Scale = math.min((tileW - 10) / row.Natural.X, (tileH - 8) / row.Natural.Y, 1.5)
		local textLeft = 8 + tileW + 10
		for _, object in ipairs(row.Texts) do
			object.Position = UDim2.new(0, textLeft, object.Position.Y.Scale, object.Position.Y.Offset)
			object.Size = UDim2.new(1, -(textLeft + 8), object.Size.Y.Scale, object.Size.Y.Offset)
		end
	end

	local function buildSizeRow(size: SizeDef)
		local row = UIUtil.Create("Frame", {
			Name = size.Id,
			Size = UDim2.new(1, 0, 0, SIZE_ROW_HEIGHT),
			BackgroundColor3 = WHITE,
			LayoutOrder = size.Order or 0,
			ZIndex = 34,
			Parent = sizesList,
		})
		UIUtil.Corner(row, 16)
		local stroke = UIUtil.Stroke(row, SOFT_STROKE, 1.5, 0)
		local tile = UIUtil.Create("Frame", {
			Name = "Preview",
			Position = UDim2.fromOffset(8, 8),
			Size = UDim2.fromOffset(104, SIZE_ROW_HEIGHT - 16),
			BackgroundColor3 = WHITE,
			ZIndex = 35,
			Parent = row,
		})
		tile:SetAttribute("DarkSkinIgnore", true)
		UIUtil.Corner(tile, 14)
		UIUtil.Stroke(tile, SOFT_STROKE, 1, 0)
		UIUtil.Gradient(tile, ColorSequence.new(Color3.fromRGB(206, 232, 255), Color3.fromRGB(255, 232, 242)), 90)
		local cells, scale, natural = drawBuilding(tile, size)
		local name = textLine(row, "Name", {
			Position = UDim2.fromOffset(0, 8),
			Size = UDim2.new(1, 0, 0, 20),
			Font = Theme.Fonts.Title,
			Text = size.Icon .. " " .. HouseCommon.Name(size),
			TextColor3 = Theme.Colors.Text,
			TextSize = 16,
		})
		local grid = textLine(row, "Grid", {
			Position = UDim2.fromOffset(0, 30),
			Size = UDim2.new(1, 0, 0, 16),
			Text = size.Floors == 1 and Locale.T("🏢 1 floor × %d rooms", size.Columns)
				or Locale.T("🏢 %d floors × %d rooms", size.Floors, size.Columns),
			TextSize = 12,
		})
		local items = textLine(row, "Items", {
			Position = UDim2.fromOffset(0, 47),
			Size = UDim2.new(1, 0, 0, 16),
			Text = Locale.T("🛋️ up to %d items / room", size.RoomItems),
			TextSize = 12,
		})
		local status = textLine(row, "Status", {
			Position = UDim2.fromOffset(0, 65),
			Size = UDim2.new(1, 0, 0, 18),
			TextColor3 = C.PinkDeep,
			TextSize = 13,
		})
		local button = actionButton(row, {
			Size = UDim2.new(1, 0, 0, 34),
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 0, 1, -8),
			ZIndex = 35,
		})
		local entry: SizeRow = {
			Size = size,
			Row = row,
			Tile = tile,
			Scale = scale,
			Natural = natural,
			Texts = { name, grid, items, status, button },
			Button = button,
			Stroke = stroke,
			Status = status,
			Cells = cells,
			CellKey = "",
			Lock = nil,
		}
		layoutSizeRow(entry)
		table.insert(sizeRows, entry)
		button.Activated:Connect(function()
			sizeAction(entry)
		end)
	end

	-- Pastilles de catégories
	local categoryButtons: { [string]: TextButton } = {}
	local function paintCategories()
		for id, button in pairs(categoryButtons) do
			local selected = id == category
			button:SetAttribute("BaseColor", selected and C.PinkDeep or WHITE)
			button.BackgroundColor3 = selected and C.PinkDeep or WHITE
			button.TextColor3 = selected and WHITE or C.Ink
		end
	end
	-- Dessins des vignettes : peints à la demande (cartes visibles), quelques-uns
	-- par image pour ne pas figer l'écran à l'ouverture de la boutique
	local paintQueue: { ItemCard } = {}
	local painting = false
	local function paintArt(card: ItemCard)
		if card.Painted then
			return
		end
		card.Painted = true
		if HouseArt.Has(card.Item.Id) then
			HouseArt.Thumbnail(card.Tile, card.Item, 78, 37)
			card.Emoji.Visible = false
		end
	end
	local function queueArt(card: ItemCard)
		if card.Painted then
			return
		end
		table.insert(paintQueue, card)
		if painting then
			return
		end
		painting = true
		task.spawn(function()
			while #paintQueue > 0 do
				for _ = 1, 6 do
					local next = table.remove(paintQueue, 1)
					if not next then
						break
					end
					if next.Cell.Visible then
						paintArt(next)
					end
				end
				task.wait()
			end
			painting = false
		end)
	end

	local function applyFilter()
		table.clear(paintQueue)
		local house = HouseCommon.GetHouse(ClientState.Data)
		local room = currentRoom(house)
		for _, card in ipairs(itemCards) do
			local visible
			if category == "New91" then
				-- (v9.1) les nouveautés de la boutique
				visible = (card.Item.Order or 0) >= NEW_FROM
			elseif category == "Favorites" then
				visible = room ~= nil and HouseCommon.IsFavorite(room, card.Item)
			elseif category == "TablesSeats" then
				-- (v9) tables vides et sièges qu'on range autour
				visible = HouseSurfaces.IsTable(card.Item.Id) or HouseSurfaces.IsSeat(card.Item.Id)
			elseif category == "Tabletop" then
				-- (v9) tout ce qu'on peut poser SUR un meuble
				visible = HouseCommon.CanGoOnFurniture(card.Item)
			else
				visible = category == "All" or card.Item.Category == category
			end
			card.Cell.Visible = visible
		end
		-- Dans l'ordre d'affichage (les premières cartes d'abord)
		local ordered = {}
		for _, card in ipairs(itemCards) do
			if card.Cell.Visible and not card.Painted then
				table.insert(ordered, card)
			end
		end
		table.sort(ordered, function(a, b)
			return a.Cell.LayoutOrder < b.Cell.LayoutOrder
		end)
		for _, card in ipairs(ordered) do
			queueArt(card)
		end
		itemsList.CanvasPosition = Vector2.zero
	end
	local function categoryPill(id: string, text: string, order: number)
		local height = Interface.IsTouch() and 34 or 30
		local button = UIUtil.PillButton({
			Name = id,
			Text = text,
			Color = WHITE,
			TextColor3 = C.Ink,
			Height = height,
			TextSize = 13,
			LayoutOrder = order,
			ZIndex = 33,
			StrokeColor = C.Pink,
			Parent = categoryRow,
		})
		categoryButtons[id] = button
		button.Activated:Connect(function()
			if category == id then
				return
			end
			category = id
			SoundManager.Play("Click", 1.1)
			paintCategories()
			applyFilter()
			refresh()
		end)
	end
	categoryPill("All", Locale.T("✨ All"), 0)
	categoryPill("New91", Locale.T("🆕 New!"), 1)
	-- Préférés de la pièce ouverte (cachée dans la vue de la maison)
	categoryPill("Favorites", "", 2)
	local favoritesPill = categoryButtons.Favorites
	favoritesPill.Visible = false
	categoryPill("TablesSeats", Locale.T("🍽️ Tables & chairs"), 3)
	categoryPill("Tabletop", Locale.T("🧁 On furniture"), 4)
	for index, entry in ipairs(HouseCommon.Config.Categories) do
		-- (v9.5) "🖥️ Dopamine Setup" juste après "✨ Tout" (les stimuli en vrai)
		categoryPill(entry.Id, entry.Icon .. " " .. HouseCommon.Name(entry), if entry.Id == "Setup" then -1 else index + 4)
	end
	if categoryButtons.All then
		categoryButtons.All.LayoutOrder = -2
	end
	paintCategories()
	task.defer(refreshMoreHint)

	-- Pastille "préférés" et filtre selon la pièce ouverte
	local function syncFavoriteRoom(house: HouseData)
		local room = currentRoom(house)
		local roomType = room and HouseCommon.GetRoomType(room)
		local key = roomType and roomType.Id or ""
		if key == favRoomKey then
			return
		end
		favRoomKey = key
		favoritesPill.Visible = roomType ~= nil
		if roomType then
			favoritesPill.Text = Locale.T("%s Favourites", roomType.Icon)
		end
		if category == "Favorites" and not roomType then
			category = "All"
			paintCategories()
		end
		if built.Items then
			applyFilter()
		end
		task.defer(refreshMoreHint)
	end

	-- Construction paresseuse d'une section (par paquets)
	local function buildSection(name: string)
		if built[name] then
			return
		end
		built[name] = true
		if name == "Items" then
			local items = table.clone(HouseCommon.Config.Items)
			table.sort(items, function(a, b)
				if a.Cost ~= b.Cost then
					return a.Cost < b.Cost
				end
				return (a.Order or 0) < (b.Order or 0)
			end)
			task.spawn(function()
				for rank, item in ipairs(items) do
					buildItemCard(item, rank)
					if rank % 24 == 0 then
						applyFilter()
						refresh()
						task.wait()
					end
				end
				applyFilter()
				refresh()
			end)
		elseif name == "Wallpapers" then
			for _, style in ipairs(HouseCommon.Config.Wallpapers) do
				buildStyleCard("Wallpaper", style, wallpapersList)
			end
		elseif name == "Floors" then
			for _, style in ipairs(HouseCommon.Config.Floors) do
				buildStyleCard("Floor", style, floorsList)
			end
		elseif lookLists[name] then
			-- (v9.1) boiseries, ambiances, vues, façades, toits, motifs, jardin
			local def = HouseCommon.LookKinds[KIND_OF[name]]
			if def then
				for _, entry in ipairs(def.List) do
					buildStyleCard(def.Kind, entry :: any, lookLists[name])
				end
			end
		elseif name == "Rooms" then
			task.spawn(function()
				for index, roomType in ipairs(HouseCommon.Config.RoomTypes) do
					buildRoomCard(roomType)
					if index % 4 == 0 then
						refresh()
						task.wait()
					end
				end
				refresh()
			end)
		elseif name == "Sizes" then
			for _, size in ipairs(HouseCommon.Config.Sizes) do
				buildSizeRow(size)
			end
		end
	end

	----------------------------------------------------------------------
	-- Bandeau de la pièce (Murs / Sols)
	----------------------------------------------------------------------

	local function refreshRoomBar(house: HouseData)
		local room, locked = targetRoom(house)
		local kind = KIND_OF[section] or "Wallpaper"
		-- L'essai en cours visait une autre pièce : on l'arrête
		local roomId = room and room.Id or nil
		if roomId ~= previewRoomId then
			previewRoomId = roomId
			if stickyPreview or hoverPreview then
				endPreviews()
			end
		end
		local labels = roomLabels(house)
		-- Pièce ouverte : une ligne "🎨 Murs de cette pièce : [🛏️ Chambre]" ;
		-- vue de la maison : consigne + choix parmi toutes les pièces
		local barHeight = locked and 42 or 66
		roomHint.Visible = not locked
		roomHint.Text = Locale.T("🏠 Open a room, or pick one here:")
		roomBar.Size = UDim2.new(1, 0, 0, barHeight)
		roomBar.Position = UDim2.fromOffset(0, 44)
		roomChips.Position = UDim2.fromOffset(0, locked and 3 or 26)
		setListTop(wallpapersList, 44 + barHeight + 6)
		setListTop(floorsList, 44 + barHeight + 6)
		for name, list in pairs(lookLists) do
			if ROOM_SECTIONS[name] then
				setListTop(list, 44 + barHeight + 6)
			end
		end
		-- Pastilles des pièces (reconstruites si la liste change)
		local parts = { locked and ("L" .. kind) or "U", roomId or "" }
		for _, entry in ipairs(sortedRooms(house)) do
			table.insert(parts, entry.Id .. "=" .. (labels[entry.Id] or ""))
		end
		local key = table.concat(parts, "|")
		if key == roomChipsKey then
			return
		end
		roomChipsKey = key
		for _, child in ipairs(roomChips:GetChildren()) do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		if locked then
			UIUtil.Create("TextLabel", {
				Name = "Lead",
				Size = UDim2.fromOffset(0, 30),
				AutomaticSize = Enum.AutomaticSize.X,
				BackgroundTransparency = 1,
				Font = Theme.Fonts.Body,
				Text = if kind == "Wallpaper" then Locale.T("🎨 Walls of this room:")
					elseif kind == "Floor" then Locale.T("🟫 Floor of this room:")
					elseif kind == "Trim" then Locale.T("🎀 Trim of this room:")
					elseif kind == "Mood" then Locale.T("💡 Lighting of this room:")
					else Locale.T("🪟 Window of this room:"),
				TextColor3 = C.Ink,
				TextSize = 13,
				LayoutOrder = 0,
				ZIndex = 34,
				Parent = roomChips,
			})
		end
		local height = Interface.IsTouch() and 32 or 28
		local selectedChip: GuiObject? = nil
		for order, entry in ipairs(sortedRooms(house)) do
			if not locked or entry.Id == roomId then
				local selected = entry.Id == roomId
				local chip = UIUtil.PillButton({
					Name = entry.Id,
					Text = labels[entry.Id] or entry.Id,
					Color = selected and C.PinkDeep or WHITE,
					TextColor3 = selected and WHITE or C.Ink,
					Height = height,
					TextSize = 13,
					LayoutOrder = order,
					ZIndex = 34,
					StrokeColor = C.Pink,
					Parent = roomChips,
				})
				if selected then
					selectedChip = chip
				end
				local chosenId = entry.Id
				chip.Activated:Connect(function()
					if locked or chosenId == chosenRoomId then
						UIUtil.Pop(chip, 1.06, 0.2)
						return
					end
					chosenRoomId = chosenId
					SoundManager.Play("Click", 1.1)
					refresh()
				end)
			end
		end
		-- La pièce choisie reste visible dans la rangée (défilement, une fois
		-- les pastilles placées par le UIListLayout)
		task.delay(0.1, function()
			local chip = selectedChip
			if not chip or not chip.Parent then
				return
			end
			-- (positions absolues = px d'écran : ramenées en px de maquette)
			local k = chip.AbsoluteSize.Y / height
			if k <= 0 then
				return
			end
			local window = roomChips.AbsoluteWindowSize.X / k
			local left = (chip.AbsolutePosition.X - roomChips.AbsolutePosition.X) / k + roomChips.CanvasPosition.X
			local right = left + chip.AbsoluteSize.X / k
			local canvasX = roomChips.CanvasPosition.X
			if right > canvasX + window - 8 then
				canvasX = right - window + 16
			elseif left < canvasX + 8 then
				canvasX = math.max(0, left - 16)
			end
			roomChips.CanvasPosition = Vector2.new(canvasX, 0)
		end)
	end

	----------------------------------------------------------------------
	-- Mise à jour des cartes
	----------------------------------------------------------------------

	refresh = function()
		local data = ClientState.Data
		local house = HouseCommon.GetHouse(data)
		local dopamine = HouseCommon.Dopamine()
		setChipText(wallet, "💧 " .. NumberFormatter.Format(dopamine))
		if not isOpen then
			return
		end

		if section == "Items" then
			syncFavoriteRoom(house)
			local room = currentRoom(house)
			for _, card in ipairs(itemCards) do
				if card.Cell.Visible then
					local item = card.Item
					local owned = HouseCommon.Owned(house, item.Id)
					local maxed = HouseCommon.IsMaxed(item, owned)
					local price = HouseCommon.Price(item, owned)
					local affordable = dopamine >= price
					local favorite = room ~= nil and HouseCommon.IsFavorite(room, item)
					local locked = owned == 0 and not HouseCommon.IsUnlocked(data, item)
					if locked and not card.Lock then
						card.Lock = lockOverlay(card.Tile, true)
					end
					local lock = card.Lock
					if lock then
						lock.Visible = locked
						if locked then
							-- (v9.5) visites à l'océan OU amélioration du clicker à débloquer
							local kind, reason, upgrade = HouseCommon.LockReason(data, item)
							setItemLock(lock, kind, reason, upgrade)
						end
					end
					card.Owned.Visible = owned > 0
					if owned > 0 then
						local free = handlers.GetAvailable(item.Id)
						setChipText(card.Owned, free > 0 and string.format("x%d • 📦%d", owned, free) or ("x" .. owned))
					end
					card.New.Visible = owned == 0 and affordable and not locked
					card.Fav.Visible = favorite
					if favorite then
						setText(card.Comfort, Locale.T("✨ +%s comfort", formatComfort(HouseCommon.PlacedComfort(room, item))), C.Lilac:Lerp(C.Ink, 0.3))
					else
						setText(card.Comfort, Locale.T("❤️ +%d comfort", item.Comfort), C.PinkDeep)
					end
					if maxed then
						paintButton(card.Button, Locale.T("MAX ✅"), Theme.Colors.ButtonBottom, true, Theme.Colors.Text)
					elseif locked then
						paintButton(card.Button, "🔒 💧 " .. NumberFormatter.Format(price), LOCKED_COLOR, true, WHITE)
					else
						paintButton(card.Button, "💧 " .. NumberFormatter.Format(price), BUY_COLOR, affordable, Theme.Colors.TextDark)
					end
					if locked then
						card.Stroke.Color = C.Lilac
						card.Stroke.Thickness = 1.5
					elseif owned == 0 and affordable then
						card.Stroke.Color = C.Butter:Lerp(C.PinkDeep, 0.2)
						card.Stroke.Thickness = 2.5
					elseif favorite then
						card.Stroke.Color = C.Lilac
						card.Stroke.Thickness = 2
					else
						card.Stroke.Color = SOFT_STROKE
						card.Stroke.Thickness = 1.5
					end
				end
			end
		elseif KIND_OF[section] then
			-- Murs, sols (v9.1 : + boiseries, ambiances, vues, façade, toit, motif, jardin)
			local sectionKind = KIND_OF[section]
			local room: Room? = nil
			if ROOM_SECTIONS[section] then
				refreshRoomBar(house)
				room = targetRoom(house)
			else
				local text
				if sectionKind == "Garden" then
					text = Locale.T("🌷 Garden: %d/%d spots used • tap to put out / away", #house.Garden, HouseCommon.GardenSlotsFor())
				else
					text = Locale.T("🏡 Whole house • hover or tap a picture to try it")
				end
				if outsideHint.Text ~= text then
					outsideHint.Text = text
				end
			end
			for _, card in ipairs(styleCards) do
				if card.Kind == sectionKind then
					local cost = tonumber(card.Style.Cost) or 0
					local isOwned, equipped = lookState(house, room, card.Kind, card.Style.Id, cost)
					local locked = not isOwned and not HouseCommon.IsUnlocked(data, card.Style)
					if locked and not card.Lock then
						card.Lock = lockOverlay(card.Preview, true)
					end
					local lock = card.Lock
					if lock then
						lock.Visible = locked
						if locked then
							setLock(lock, HouseCommon.RequiredRebirths(card.Style))
						end
					end
					card.Check.Visible = equipped
					if equipped then
						if sectionKind == "Garden" then
							paintButton(card.Button, Locale.T("✅ In the garden"), Theme.Colors.ButtonBottom, true, Theme.Colors.Text)
						else
							paintButton(card.Button, Locale.T("✅ Applied"), Theme.Colors.ButtonBottom, true, Theme.Colors.Text)
						end
						card.Stroke.Color = Theme.Colors.Green
						card.Stroke.Thickness = 3
					elseif isOwned then
						paintButton(card.Button, sectionKind == "Garden" and Locale.T("🌷 Put out") or Locale.T("Apply"), Theme.Colors.Blue, true, WHITE)
						card.Stroke.Color = SOFT_STROKE
						card.Stroke.Thickness = 1.5
					elseif locked then
						paintButton(card.Button, "🔒 💧 " .. NumberFormatter.Format(cost), LOCKED_COLOR, true, WHITE)
						card.Stroke.Color = C.Lilac
						card.Stroke.Thickness = 1.5
					else
						local affordable = dopamine >= cost
						paintButton(card.Button, "💧 " .. NumberFormatter.Format(cost), BUY_COLOR, affordable, Theme.Colors.TextDark)
						card.Stroke.Color = SOFT_STROKE
						card.Stroke.Thickness = 1.5
					end
				end
			end
		elseif section == "Rooms" then
			local size = HouseCommon.GetSize(house)
			local count = #house.Rooms
			local full = count >= size.MaxRooms
			local price = HouseCommon.RoomCost(house)
			local affordable = dopamine >= price
			setText(roomsCounter, Locale.T("%s %s  •  %d/%d rooms", size.Icon, HouseCommon.Name(size), count, size.MaxRooms))
			if full then
				setText(roomsNext, Locale.T("🏠 Full house! Move to a bigger one 🏡"), Theme.Colors.Orange)
			else
				setText(roomsNext, Locale.T("Next room: %s", "💧 " .. NumberFormatter.Format(price)), C.PinkDeep)
			end
			local perType: { [string]: number } = {}
			for _, room in ipairs(house.Rooms) do
				perType[room.Type] = (perType[room.Type] or 0) + 1
			end
			for _, card in ipairs(roomCards) do
				local have = perType[card.Type.Id] or 0
				card.Count.Visible = have > 0
				if have > 0 then
					setChipText(card.Count, "x" .. have)
				end
				-- v9.3 : verrou des visites à l'océan (comme les objets)
				local locked = have == 0 and not HouseCommon.IsUnlocked(data, card.Type)
				if locked and not card.Lock then
					card.Lock = lockOverlay(card.Preview, true)
				end
				local lock = card.Lock
				if lock then
					lock.Visible = locked
					if locked then
						setLock(lock, HouseCommon.RequiredRebirths(card.Type))
					end
				end
				if locked then
					paintButton(card.Button, "🔒 " .. lockText(HouseCommon.RequiredRebirths(card.Type)), LOCKED_COLOR, true, WHITE)
				elseif full then
					paintButton(card.Button, Locale.T("🏡 Bigger house"), Theme.Colors.Blue, true, WHITE)
				else
					paintButton(card.Button, "💧 " .. NumberFormatter.Format(price), BUY_COLOR, affordable, Theme.Colors.TextDark)
				end
				card.Stroke.Color = (have > 0 or locked) and C.Lilac or SOFT_STROKE
				card.Stroke.Thickness = have > 0 and 2 or 1.5
			end
		elseif section == "Sizes" then
			local roomCount = #house.Rooms
			for _, row in ipairs(sizeRows) do
				local size = row.Size
				local current = house.Size == size.Id
				local isOwned = house.OwnedSizes[size.Id] == true or size.Cost <= 0
				paintCells(row, house, current)
				if current then
					paintButton(row.Button, Locale.T("✅ Home"), Theme.Colors.ButtonBottom, true, Theme.Colors.Text)
					setText(row.Status, Locale.T("🏠 Home • %d/%d rooms", roomCount, size.MaxRooms), C.PinkDeep)
					row.Stroke.Color = Theme.Colors.Green
					row.Stroke.Thickness = 3
				elseif isOwned then
					local tooSmall = roomCount > size.MaxRooms
					paintButton(row.Button, Locale.T("Move in"), Theme.Colors.Blue, not tooSmall, WHITE)
					if tooSmall then
						setText(row.Status, Locale.T("⚠️ Too many rooms (max %d)", size.MaxRooms), Theme.Colors.Orange)
					else
						setText(row.Status, Locale.T("✅ Owned"), C.PinkDeep)
					end
					row.Stroke.Color = SOFT_STROKE
					row.Stroke.Thickness = 1.5
				elseif not HouseCommon.IsUnlocked(data, size) then
					local required = HouseCommon.RequiredRebirths(size)
					paintButton(row.Button, "🔒 💧 " .. NumberFormatter.Format(size.Cost), LOCKED_COLOR, true, WHITE)
					setText(row.Status, "🔒 🌊 " .. lockText(required), Color3.fromRGB(128, 92, 196))
					row.Stroke.Color = C.Lilac
					row.Stroke.Thickness = 1.5
				else
					local affordable = dopamine >= size.Cost
					paintButton(row.Button, "💧 " .. NumberFormatter.Format(size.Cost), BUY_COLOR, affordable, Theme.Colors.TextDark)
					setText(row.Status, affordable and Locale.T("You can afford it!") or Locale.T("Not enough Dopamine yet"), C.PinkDeep)
					row.Stroke.Color = SOFT_STROKE
					row.Stroke.Thickness = 1.5
				end
				local lockedRow = not current and not isOwned and not HouseCommon.IsUnlocked(data, size)
				if lockedRow and not row.Lock then
					row.Lock = lockOverlay(row.Tile, true)
				end
				local rowLock = row.Lock
				if rowLock then
					rowLock.Visible = lockedRow
					if lockedRow then
						setLock(rowLock, HouseCommon.RequiredRebirths(size))
					end
				end
			end
		end
	end

	----------------------------------------------------------------------
	-- Ouverture / fermeture
	----------------------------------------------------------------------

	local sections: { [string]: GuiObject } = {
		Items = itemsList,
		Wallpapers = wallpapersList,
		Floors = floorsList,
		Rooms = roomsList,
		Sizes = sizesList,
	}
	for name, list in pairs(lookLists) do
		sections[name] = list
	end

	-- (v9.1) Pastilles des sous-onglets du groupe affiché
	local function paintSubRow(group: string, target: string)
		if group ~= subGroup then
			subGroup = group
			for _, button in pairs(subButtons) do
				button:Destroy()
			end
			table.clear(subButtons)
			for order, id in ipairs(GROUPS[group] or {}) do
				local button = UIUtil.PillButton({
					Name = id,
					Text = Locale.T(SUB_LABELS[id] or id),
					Color = WHITE,
					TextColor3 = C.Ink,
					Height = Interface.IsTouch() and 34 or 30,
					TextSize = 13,
					LayoutOrder = order,
					ZIndex = 33,
					StrokeColor = C.Pink,
					Parent = subRow,
				})
				subButtons[id] = button
				button.Activated:Connect(function()
					if section ~= id then
						SoundManager.Play("Click", 1.1)
						shop.Open(id)
					end
				end)
			end
		end
		for id, button in pairs(subButtons) do
			local selected = id == target
			button:SetAttribute("BaseColor", selected and C.PinkDeep or WHITE)
			button.BackgroundColor3 = selected and C.PinkDeep or WHITE
			button.TextColor3 = selected and WHITE or C.Ink
		end
		-- la pastille choisie reste visible (rangée qui défile)
		task.delay(0.05, function()
			local chosen = subButtons[target]
			if not chosen or not chosen.Parent then
				return
			end
			local left = chosen.AbsolutePosition.X - subRow.AbsolutePosition.X + subRow.CanvasPosition.X
			local window = subRow.AbsoluteWindowSize.X
			if left + chosen.AbsoluteSize.X > subRow.CanvasPosition.X + window or left < subRow.CanvasPosition.X then
				subRow.CanvasPosition = Vector2.new(math.max(0, left - 20), 0)
			end
		end)
	end

	local function showSection(name: string)
		local target = SECTION_ALIASES[name] or name
		if GROUPS[target] then
			-- onglet de groupe : le dernier sous-onglet ouvert
			target = lastSub[target] or GROUPS[target][1]
		end
		if not sections[target] then
			target = "Items"
		end
		local changed = target ~= section
		section = target
		for id, frame in pairs(sections) do
			frame.Visible = id == target
		end
		local group = GROUP_OF[target]
		if group then
			lastSub[group] = target
			paintSubRow(group, target)
		end
		categoryRow.Visible = target == "Items"
		subRow.Visible = group ~= nil
		roomBar.Visible = ROOM_SECTIONS[target] == true
		outsideBar.Visible = group == "Outside"
		if group == "Outside" then
			setListTop(sections[target] :: ScrollingFrame, 44 + 30 + 6)
		end
		local newTab = group or target
		changed = changed or newTab ~= selectedTab
		selectedTab = newTab
		layoutTabs(changed)
		-- Changer d'onglet arrête l'essai en cours
		if stickyPreview or hoverPreview then
			endPreviews()
		end
		buildSection(target)
		relayoutGrids()
		refresh()
	end

	layoutTabs(false)

	shop = {
		Frame = drawer,
		Open = function(newSection: string?)
			local target = newSection or section
			if not isOpen then
				isOpen = true
				openToken += 1
				drawer.Visible = true
				drawer.Position = UDim2.new(1, width + 40, 0, 0)
				UIUtil.Tween(drawer, 0.32, { Position = UDim2.new(1, 0, 0, 0) }, Enum.EasingStyle.Quint)
				SoundManager.Play("Open", 1.15)
			end
			showSection(target)
		end,
		Close = function()
			if not isOpen then
				return
			end
			isOpen = false
			openToken += 1
			local token = openToken
			endPreviews()
			UIUtil.Tween(drawer, 0.22, { Position = UDim2.new(1, width + 40, 0, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(0.23, function()
				if token == openToken then
					drawer.Visible = false
				end
			end)
		end,
		IsOpen = function(): boolean
			return isOpen
		end,
		Refresh = function()
			refresh()
		end,
		SetWidth = function(newWidth: number)
			width = newWidth
			drawer.Size = UDim2.new(0, newWidth, 1, 0)
			if not isOpen then
				drawer.Position = UDim2.new(1, newWidth + 40, 0, 0)
			end
			layoutTabs(false)
			relayoutGrids()
		end,
	}
	return shop
end

return HouseShop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="69">
            <Properties>
              <string name="Name">HouseSurfaces</string>
              <string name="Source"><![CDATA[--[[
	HouseSurfaces (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > HouseSurfaces

	"On peut poser des objets SUR les meubles" + les chaises à table + les
	places des animaux :
	  - SURFACES : dessus des meubles (tables vides, bureaux, commodes,
	    étagères, lits, canapé, fauteuils, chaises, plan de travail, frigo,
	    étagère MURALE...) en unités de la boîte de dessin 100 x 100
	    (x0, x1, y) ; un petit objet (Formulas.CanGoOnFurniture : déco,
	    plantes, nourriture, lampes, jouets, peluches, coussins, animaux...)
	    peut s'y poser (le serveur accepte alors Y >= TabletopMinY) ;
	  - SIÈGES et TABLES : une chaise / un tabouret / un banc glissé près
	    d'une table se range sur un de ses côtés (tournée vers elle), derrière
	    (le dossier dépasse du plateau) ou devant ; elle suit ensuite la
	    table quand on la déplace (Dependents) et passe devant / derrière
	    elle au bon moment (Order) ;
	  - PET_SPOTS : où les animaux vont dormir / manger / boire / jouer /
	    griffer / se percher / se cacher (niche, arbre à chat, gamelle...) ;
	  - support d'un objet posé (le meuble sous ses pieds) et table d'une
	    chaise, déduits de la géométrie seule (rien de plus n'est sauvegardé,
	    à part F = chaise retournée vers la table) ;
	  - ORDRE D'AFFICHAGE : muraux, tapis, puis le sol (couche Z, puis Y) ;
	    un objet posé sur un meuble passe juste devant son meuble, une chaise
	    derrière / à côté d'une table juste derrière elle, une chaise devant
	    juste devant (après ce qui est posé sur la table).
	Coordonnées d'un objet posé : X, Y = fraction de la pièce (pieds pour
	les objets au sol, centre pour les objets muraux), taille à l'écran =
	item.Size x S px de maquette.
	Aucune interface ici (utilisé par l'éditeur, les animaux et les
	mini-pièces de la vue d'ensemble).
]]

local HouseCommon = require(script.Parent.HouseCommon)

type Item = HouseCommon.Item
type Placed = HouseCommon.Placed

local HouseSurfaces = {}

-- Dessus des meubles : { x0, x1, y, z?, gap? } (boîte 100 x 100)
--   x0 / x1 = bords, y = hauteur du dessus (0 = haut de la boîte) ;
--   (v9.6) z = profondeur du milieu du dessus en 3D (fraction de la
--   profondeur du modèle : -0,5 = fond, +0,5 = devant ; 0 par défaut) ;
--   gap = hauteur libre au-dessus (étagère fermée : le rayon du dessus),
--   nil = pas de limite. Un meuble peut avoir PLUSIEURS dessus (niveaux) :
--   l'index d'un dessus = l'index du "Top" de la recette 3D (House3DRecipes).
local SURFACES: { [string]: { { number } } } = {
	-- meubles d'origine
	WoodenChair = { { 16, 84, 52 } },
	StorageBox = { { 14, 86, 47 } },
	Nightstand = { { 8, 92, 44 } },
	DrawerCabinet = { { 8, 94, 24 } },
	StudyDesk = { { 4, 96, 48 } },
	-- (v9.6) bibliothèque : le dessus + ses 3 rayons (devant les livres)
	Bookshelf = { { 8, 92, 9 }, { 12, 88, 38, 0.3, 23 }, { 12, 88, 64, 0.3, 21 }, { 12, 88, 90, 0.3, 21 } },
	VanityTable = { { 4, 96, 55 } },
	Wardrobe = { { 6, 94, 11 } },
	Fireplace = { { 2, 98, 14 } },
	LoftBed = { { 12, 86, 23 }, { 16, 56, 73 } },
	CanopyBed = { { 20, 80, 64 } },
	CloudBed = { { 12, 88, 55 } },
	Sofa = { { 24, 76, 62 } },
	GamingChair = { { 20, 80, 63 } },
	Bathtub = { { 4, 96, 46 } },
	Aquarium = { { 5, 95, 16 } },
	RetroTV = { { 10, 90, 23 } },
	Stove = { { 6, 94, 38 } },
	Fridge = { { 24, 76, 4 } },
	SundaeBar = { { 5, 95, 54 } },
	Toilet = { { 26, 74, 18 } },
	-- v9 : tables et meubles à dessus vide (Art/Tables)
	SideTable = { { 8, 92, 38 } },
	CafeTable = { { 6, 94, 30 } },
	CoffeeTable = { { 3, 97, 51 } },
	DiningTable = { { 2, 98, 35 } },
	BarTable = { { 12, 88, 16 } },
	Dresser = { { 4, 96, 37 } },
	TVStand = { { 2, 98, 53 } },
	KitchenIsland = { { 2, 98, 37 } },
	PicnicTable = { { 4, 96, 39 }, { 2, 98, 71 } },
	BigDesk = { { 2, 98, 37 } },
	-- v9 : sièges (un chat sur la chaise, une peluche dans le fauteuil...)
	MushroomStool = { { 24, 76, 15 } },
	FloorCushion = { { 18, 82, 49 } },
	DiningChair = { { 32, 82, 52 } },
	BarStool = { { 26, 74, 26 } },
	Armchair = { { 22, 78, 63 } },
	GardenBench = { { 8, 92, 59 } },
	RockingChair = { { 26, 80, 57 } },
	DoubleBed = { { 10, 90, 58 } },
	EggChair = { { 50, 78, 61 } },
	-- v9 : étagère MURALE (objet mural : boîte centrée sur son Y)
	FloatingShelf = { { 6, 94, 34 }, { 6, 94, 72, 0, 34 } },
	-- (v9.6) étagère murale "mignonne" et étagère à trophées : leur planche
	WallShelf = { { 4, 96, 60 } },
	TrophyShelf = { { 4, 96, 66 } },
	-- v9.1 : nouveaux meubles (Art/Cozy91, Art/Fun91)
	ToyChest = { { 8, 92, 32 } },
	Pouf = { { 20, 80, 52 } },
	LadderShelf = { { 26, 74, 12 }, { 18, 82, 42 }, { 10, 90, 72 } },
	KotatsuTable = { { 4, 96, 42 } },
	HeartArmchair = { { 22, 78, 64 } },
	Hammock = { { 24, 76, 56 } },
	CatSofa = { { 20, 80, 64 } },
	CrystalThrone = { { 24, 76, 56 } },
	KitchenSink = { { 4, 28, 38 }, { 72, 96, 38 } },
	-- v9.2 : meubles "cool" (Art/Cool92Gaming)
	GamerBeanbag = { { 24, 76, 54 } },
	LockerCabinet = { { 8, 92, 9 } },
	BrickTable = { { 3, 97, 37 } },
	GamerChair = { { 22, 78, 61 } },
	GamingDesk = { { 3, 97, 35 } },
	BunkBed = { { 10, 76, 27 }, { 10, 78, 71 } },
	RaceCarBed = { { 18, 72, 41 } },
	-- v9.5 : "Dopamine Setup" (Art/Setup95) : clavier, souris, petite télé,
	-- plantes... se posent sur les bureaux gamer, le meuble télé et la table à
	-- papier bulle (mêmes hauteurs que les modèles 3D : House3DSetup)
	SetupDeskSolo = { { 4, 96, 50 } },
	SetupDeskDuo = { { 4, 96, 50 } },
	SetupDeskTrio = { { 4, 96, 50 } },
	SetupDeskUltra = { { 4, 96, 50 } },
	SetupTVStand = { { 3, 97, 55 } },
	SetupBubbleWrap = { { 6, 94, 52 } },
	-- v9.8 HOUSE98 : meubles qui avaient un dessus en 3D (recette : Top) mais
	-- pas en 2D -> on ne pouvait rien y poser (mêmes cotes que la recette)
	Beanbag = { { 26, 74, 50 } },
	HomeCinema = { { 15, 85, 82, 0.1 } },
	-- v9.8 CATALOG98 (Art/Modern98, Art/Luxe98 ; mêmes hauteurs que les
	-- modèles 3D de House3DLuxe) : tables, bureaux, étagères, lits, sièges
	SimpleChair = { { 18, 82, 56 } },
	BarrelTable = { { 12, 88, 27 } },
	ModernBarStool = { { 28, 72, 25 } },
	OakDesk = { { 2, 98, 41 } },
	MediaConsole = { { 2, 98, 58 } },
	GlassCoffeeTable = { { 2, 98, 61 } },
	LoftShelf = { { 6, 94, 8 }, { 8, 92, 34, 0.2, 22 }, { 8, 92, 60, 0.2, 22 }, { 8, 92, 86, 0.2, 22 } },
	PlatformBed = { { 10, 94, 69 } },
	Workbench = { { 2, 98, 39 } },
	SectionalSofa = { { 8, 92, 61 } },
	Chesterfield = { { 14, 86, 59 } },
	BookshelfWall = { { 3, 97, 3 }, { 6, 94, 28, 0.25, 20 }, { 6, 94, 52, 0.25, 20 }, { 6, 94, 76, 0.25, 20 } },
	MarbleIsland = { { 2, 98, 39 } },
	SteelFridge = { { 10, 90, 3 } },
	PingPongTable = { { 4, 46, 50 } },
	PoolTable = { { 8, 92, 39 } },
	VelvetChaise = { { 12, 94, 59 } },
	KingBed = { { 10, 96, 59 } },
	CinemaRecliners = { { 6, 94, 59 } },
	GoldThrone = { { 26, 74, 57 } },
}

-- Meubles "lits" : les animaux grimpeurs y font la sieste
local BEDS: { [string]: boolean } = {
	LoftBed = true,
	CanopyBed = true,
	CloudBed = true,
	Sofa = true,
	DoubleBed = true,
	Armchair = true,
	EggChair = true,
	FloorCushion = true,
	GardenBench = true,
	HeartArmchair = true,
	CatSofa = true,
	Hammock = true,
	Pouf = true,
	GamerBeanbag = true,
	BunkBed = true,
	RaceCarBed = true,
	-- v9.8 CATALOG98
	PlatformBed = true,
	KingBed = true,
	SectionalSofa = true,
	Chesterfield = true,
	VelvetChaise = true,
	CinemaRecliners = true,
}

-- Sièges : View = "Side" (dessin de profil qui regarde à droite : retourné
-- pour regarder vers la gauche), "Front" (de face) ou "Round" (tabouret,
-- coussin : pareil de tous les côtés) ; Half = demi-largeur visible
-- (fraction de la taille) ; Front = distance centre -> bord avant (profil)
export type SeatInfo = { View: string, Half: number, Front: number? }
local SEATS: { [string]: SeatInfo } = {
	WoodenChair = { View = "Front", Half = 0.4 },
	GamingChair = { View = "Front", Half = 0.34 },
	DiningChair = { View = "Side", Half = 0.33, Front = 0.34 },
	RockingChair = { View = "Side", Half = 0.4, Front = 0.3 },
	MushroomStool = { View = "Round", Half = 0.42 },
	FloorCushion = { View = "Round", Half = 0.46 },
	BarStool = { View = "Round", Half = 0.3 },
	Armchair = { View = "Front", Half = 0.48 },
	GardenBench = { View = "Front", Half = 0.46 },
	Beanbag = { View = "Round", Half = 0.46 },
	Sofa = { View = "Front", Half = 0.48 }, -- (canapé derrière la table basse)
	Pouf = { View = "Round", Half = 0.4 },
	HeartArmchair = { View = "Front", Half = 0.46 },
	CatSofa = { View = "Front", Half = 0.48 },
	GamerChair = { View = "Front", Half = 0.32 },
	GamerBeanbag = { View = "Round", Half = 0.46 },
	-- v9.8 CATALOG98
	SimpleChair = { View = "Front", Half = 0.4 },
	ModernBarStool = { View = "Round", Half = 0.28 },
	SectionalSofa = { View = "Front", Half = 0.48 },
	Chesterfield = { View = "Front", Half = 0.48 },
}

-- Tables "où l'on s'assoit" (chaises rangées autour)
local TABLES: { [string]: boolean } = {
	DiningTable = true,
	CafeTable = true,
	CoffeeTable = true,
	SideTable = true,
	BarTable = true,
	KitchenIsland = true,
	PicnicTable = true,
	BigDesk = true,
	StudyDesk = true,
	VanityTable = true,
	KotatsuTable = true,
	GamingDesk = true,
	BrickTable = true,
	-- v9.8 CATALOG98
	OakDesk = true,
	GlassCoffeeTable = true,
	Workbench = true,
	MarbleIsland = true,
	BarrelTable = true,
}

export type Spot = {
	X: number, -- boîte 100 x 100 (pieds de l'animal)
	Y: number,
	Act: string, -- "Sleep" | "Eat" | "Drink" | "Play" | "Scratch" | "Perch" | "Sit" | "Enter"
	Place: string?, -- "Behind" (derrière le meuble) | "Beside" (à côté) | nil = devant / dessus
	High: boolean?, -- place en hauteur (il faut sauter / voler)
	Birds: boolean?, -- réservée aux oiseaux
}

-- Places des animaux dans leurs affaires
local PET_SPOTS: { [string]: { Spot } } = {
	PetBowl = { { X = 50, Y = 64, Act = "Eat", Place = "Behind" } },
	PetFountain = { { X = 50, Y = 72, Act = "Drink", Place = "Behind" } },
	PetToys = { { X = 50, Y = 98, Act = "Play", Place = "Beside" } },
	PetBed = { { X = 50, Y = 86, Act = "Sleep" } },
	ScratchingPost = { { X = 50, Y = 98, Act = "Scratch", Place = "Beside" }, { X = 50, Y = 10, Act = "Perch", High = true } },
	DogHouse = { { X = 50, Y = 98, Act = "Enter" } },
	BirdCage = { { X = 50, Y = 12, Act = "Perch", High = true, Birds = true } },
	CatTree = {
		{ X = 36, Y = 12, Act = "Sleep", High = true },
		{ X = 74, Y = 57, Act = "Sit", High = true },
		{ X = 27, Y = 86, Act = "Enter" },
	},
}

local SNAP_UP = 0.1 -- (fraction de la hauteur) on "attrape" une surface un peu au-dessus...
local SNAP_DOWN = 0.07 -- ...ou un peu en dessous des pieds
local SNAP_SIDE = 0.012 -- débord gauche / droite accepté
local SUPPORT_EPS = 0.006 -- tolérance pour retrouver le meuble sous un objet

-- Chaises autour d'une table (fractions de la hauteur de la pièce)
local SIDE_DY = 0.006 -- côté : juste derrière la table (le plateau passe devant l'assise)
local BEHIND_DY = 0.03 -- derrière : au moins ça...
local BEHIND_MAX = 0.085 -- ...au plus ça (grande table, petite chaise)
local BEHIND_PEEK = 0.03 -- le dossier dépasse du plateau d'environ ça
local FRONT_DY = 0.03 -- devant
local TUCK = 0.12 -- (fraction de la taille) l'avant d'une chaise de profil glisse sous le plateau
local SEAT_EPS_Y = 0.007
local SEAT_EPS_X = 0.035
local SEAT_SNAP_X = 0.1 -- (fraction de la largeur) distance d'aimantation autour d'une place
local SEAT_SNAP_Y = 0.075

export type Surface = {
	Entry: Placed,
	L: number, -- bords (fraction de la largeur de la pièce)
	R: number,
	Y: number, -- hauteur du dessus (fraction de la hauteur)
	Base: number, -- bas du meuble (pieds d'un meuble au sol, bas d'une étagère murale)
	Index: number, -- n° du dessus (meuble à plusieurs dessus)
	Depth: number, -- (v9.6) profondeur 3D du milieu (fraction de la profondeur du modèle)
	Gap: number?, -- (v9.6) hauteur libre au-dessus (fraction de la hauteur), nil = pas de limite
}

-- Place d'une chaise à une table
export type SeatSpot = {
	Table: Placed,
	Kind: string, -- "Left" | "Right" | "Behind" | "Front"
	X: number,
	Y: number,
	F: boolean?, -- la chaise doit être retournée (regarde à gauche)
	L: number, -- bornes du plateau (pour les indices visuels)
	R: number,
	Top: number,
}

----------------------------------------------------------------------
-- Données
----------------------------------------------------------------------

function HouseSurfaces.Has(itemId: string): boolean
	return SURFACES[itemId] ~= nil
end

function HouseSurfaces.IsBed(itemId: string): boolean
	return BEDS[itemId] == true
end

function HouseSurfaces.Spots(itemId: string): { Spot }?
	return PET_SPOTS[itemId]
end

-- Données brutes (outils de rendu / tests)
function HouseSurfaces.Raw(itemId: string): { { number } }?
	return SURFACES[itemId]
end

function HouseSurfaces.IsSeat(itemId: string): boolean
	return SEATS[itemId] ~= nil
end

function HouseSurfaces.Seat(itemId: string): SeatInfo?
	return SEATS[itemId]
end

function HouseSurfaces.IsTable(itemId: string): boolean
	return TABLES[itemId] == true and SURFACES[itemId] ~= nil
end

-- Petit objet qu'on peut poser sur un meuble (même règle que le serveur)
function HouseSurfaces.CanStandOn(item: Item?): boolean
	return HouseCommon.CanGoOnFurniture(item)
end

function HouseSurfaces.MinY(): number
	return tonumber((HouseCommon.Config :: any).TabletopMinY) or 0.12
end

-- Boîte 100 x 100 d'un objet posé -> pièce (fractions). Objet au sol : ses
-- pieds (y = 100) sont en entry.Y ; objet mural : son centre (y = 50).
-- Objet retourné (F) : la boîte est lue en miroir (x -> 100 - x).
function HouseSurfaces.BoxToRoom(entry: Placed, item: Item, bx: number, by: number, roomW: number, roomH: number): (number, number)
	local k = item.Size * entry.S / 100
	local anchor = item.Placement == "Wall" and 50 or 100
	if entry.F == true then
		bx = 100 - bx
	end
	return (entry.X * roomW + (bx - 50) * k) / roomW, (entry.Y * roomH - (anchor - by) * k) / roomH
end

-- Pièce (fractions) -> boîte 100 x 100 d'un objet posé
function HouseSurfaces.RoomToBox(entry: Placed, item: Item, x: number, y: number, roomW: number, roomH: number): (number, number)
	local k = math.max(1e-3, item.Size * entry.S / 100)
	local anchor = item.Placement == "Wall" and 50 or 100
	local bx = 50 + (x - entry.X) * roomW / k
	if entry.F == true then
		bx = 100 - bx
	end
	return bx, anchor - (entry.Y - y) * roomH / k
end

-- Bas d'un objet posé (fraction de la hauteur)
local function baseOf(entry: Placed, item: Item, roomH: number): number
	if item.Placement == "Wall" then
		return entry.Y + item.Size * entry.S * 0.5 / math.max(1, roomH)
	end
	return entry.Y
end

-- Surfaces d'un objet posé (fractions de la pièce)
function HouseSurfaces.Of(entry: Placed, roomW: number, roomH: number): { Surface }
	local result: { Surface } = {}
	local item = HouseCommon.ItemsById[entry.I]
	local list = SURFACES[entry.I]
	if not item or not list then
		return result
	end
	local base = baseOf(entry, item, roomH)
	local k = item.Size * entry.S / 100
	for index, s in ipairs(list) do
		local a, y = HouseSurfaces.BoxToRoom(entry, item, s[1], s[3], roomW, roomH)
		local b = HouseSurfaces.BoxToRoom(entry, item, s[2], s[3], roomW, roomH)
		local gap = tonumber(s[5])
		-- (objet retourné : les bords s'inversent)
		table.insert(result, { Entry = entry, L = math.min(a, b), R = math.max(a, b), Y = y, Base = base, Index = index,
			Depth = tonumber(s[4]) or 0, Gap = if gap then gap * k / math.max(1, roomH) else nil })
	end
	return result
end

-- (v9.6) Un objet de hauteur `height` (fraction de la hauteur de la pièce,
-- = sa boîte) tient-il sur ce dessus ? Rayon fermé : le dessin (2D) / le
-- modèle (3D) remplit ~75 % de sa boîte -> boîte <= place libre x 1,3.
-- MÊME règle en 2D (éditeur) et en 3D (FurnitureEdit) : un objet trop haut
-- ne "voit" pas ce rayon (il va sur un autre niveau qui lui convient).
local GAP_SLACK = 1.3
function HouseSurfaces.Fits(surface: Surface, height: number): boolean
	local gap = surface.Gap
	return gap == nil or height <= gap * GAP_SLACK
end

-- Objets qui ne doivent pas servir de support (l'objet lui-même et ce qu'il porte)
local function excluded(entry: Placed, skip: { [Placed]: boolean }?): boolean
	return skip ~= nil and skip[entry] == true
end

-- Surface la plus proche d'un point (pieds d'un objet qu'on déplace) ;
-- nil si aucune. `height` = hauteur de l'objet (fraction) : sa tête ne doit
-- pas traverser le plafond.
function HouseSurfaces.Find(list: { Placed }, x: number, y: number, height: number, roomW: number, roomH: number, skip: { [Placed]: boolean }?): Surface?
	local best: Surface? = nil
	local bestScore = math.huge
	local minY = HouseSurfaces.MinY()
	for _, other in ipairs(list) do
		if not excluded(other, skip) and SURFACES[other.I] then
			for _, surface in ipairs(HouseSurfaces.Of(other, roomW, roomH)) do
				local down = math.min(SNAP_DOWN, math.max(0.015, (surface.Base - surface.Y) * 0.55))
				-- (v9.6) rayon d'une étagère fermée : on ne vise que la place
				-- entre ce rayon et celui du dessus
				local gap = surface.Gap
				local up = if gap then math.min(SNAP_UP, gap * 0.9 + 0.01) else SNAP_UP
				if x >= surface.L - SNAP_SIDE and x <= surface.R + SNAP_SIDE
					and y >= surface.Y - up and y <= surface.Y + down
					and surface.Y >= minY and surface.Y - height * 0.92 > -0.02 and HouseSurfaces.Fits(surface, height) then
					-- (le plus proche en hauteur ; à égalité, le meuble le plus en avant)
					local score = math.abs(y - surface.Y) - surface.Base * 0.001
					if score < bestScore then
						bestScore = score
						best = surface
					end
				end
			end
		end
	end
	return best
end

-- Toutes les surfaces où cet objet peut aller (indices pendant un glissement)
function HouseSurfaces.All(list: { Placed }, height: number, roomW: number, roomH: number, skip: { [Placed]: boolean }?): { Surface }
	local result: { Surface } = {}
	local minY = HouseSurfaces.MinY()
	for _, other in ipairs(list) do
		if not excluded(other, skip) and SURFACES[other.I] then
			for _, surface in ipairs(HouseSurfaces.Of(other, roomW, roomH)) do
				if surface.Y >= minY and surface.Y - height * 0.92 > -0.02 and surface.R - surface.L > 0.01 and HouseSurfaces.Fits(surface, height) then
					table.insert(result, surface)
				end
			end
		end
	end
	return result
end

-- Meuble sur lequel un objet est posé (nil = au sol / au mur)
function HouseSurfaces.SupportOf(entry: Placed, list: { Placed }, roomW: number, roomH: number): Surface?
	local item = HouseCommon.ItemsById[entry.I]
	if not item or item.Placement ~= "Floor" or not HouseCommon.CanGoOnFurniture(item) then
		return nil
	end
	local best: Surface? = nil
	local bestScore = math.huge
	for _, other in ipairs(list) do
		if other ~= entry and SURFACES[other.I] then
			for _, surface in ipairs(HouseSurfaces.Of(other, roomW, roomH)) do
				local dy = math.abs(surface.Y - entry.Y)
				if dy <= SUPPORT_EPS and surface.Base > entry.Y + 0.002 and entry.X >= surface.L - 0.01 and entry.X <= surface.R + 0.01
					and dy < bestScore then
					bestScore = dy
					best = surface
				end
			end
		end
	end
	return best
end

-- (v9.6) Demi-largeur visible d'un petit objet posé (fraction de la largeur)
local SIDE_HALF = 0.3
function HouseSurfaces.HalfWidth(item: Item, scale: number, roomW: number): number
	return item.Size * scale * SIDE_HALF / math.max(1, roomW)
end

-- (v9.6) Objets posés sur CE dessus (même meuble, même niveau)
function HouseSurfaces.OnSurface(surface: Surface, list: { Placed }, roomW: number, roomH: number, skip: { [Placed]: boolean }?): { Placed }
	local result: { Placed } = {}
	for _, other in ipairs(list) do
		if other ~= surface.Entry and not excluded(other, skip) and math.abs(other.Y - surface.Y) <= SUPPORT_EPS then
			local support = HouseSurfaces.SupportOf(other, list, roomW, roomH)
			if support and support.Entry == surface.Entry and support.Index == surface.Index then
				table.insert(result, other)
			end
		end
	end
	return result
end

-- (v9.6) Plusieurs objets côte à côte sur un même rayon, sans se chevaucher :
-- x voulu -> x libre le plus proche le long du dessus [L, R] (x inchangé
-- s'il n'y a plus de place). `skip` = l'objet déplacé et ce qu'il porte.
function HouseSurfaces.FreeX(surface: Surface, list: { Placed }, item: Item, scale: number, x: number, roomW: number, roomH: number, skip: { [Placed]: boolean }?): number
	local half = HouseSurfaces.HalfWidth(item, scale, roomW)
	local blocks: { { number } } = {}
	for _, other in ipairs(HouseSurfaces.OnSurface(surface, list, roomW, roomH, skip)) do
		local otherItem = HouseCommon.ItemsById[other.I]
		if otherItem then
			local reach = half + HouseSurfaces.HalfWidth(otherItem, other.S, roomW)
			table.insert(blocks, { other.X - reach, other.X + reach })
		end
	end
	local function free(value: number): boolean
		for _, block in ipairs(blocks) do
			if value > block[1] + 1e-6 and value < block[2] - 1e-6 then
				return false
			end
		end
		return true
	end
	-- rayon fermé (étagère) : l'objet reste ENTIER entre ses montants
	local low, high = surface.L, surface.R
	if surface.Gap and surface.R - surface.L > half * 2 then
		low, high = surface.L + half, surface.R - half
	end
	local target = math.clamp(x, low, high)
	if free(target) then
		return target
	end
	local best, bestDistance = nil, math.huge
	for _, block in ipairs(blocks) do
		for _, candidate in ipairs({ block[1], block[2] }) do
			if candidate >= low - 1e-6 and candidate <= high + 1e-6 and free(candidate) then
				local distance = math.abs(candidate - target)
				if distance < bestDistance then
					best, bestDistance = candidate, distance
				end
			end
		end
	end
	return best or target
end

----------------------------------------------------------------------
-- Chaises à table
----------------------------------------------------------------------

-- Plateau d'une table (1er dessus) : (gauche, droite, haut) en fractions
local function tableTop(tableEntry: Placed, roomW: number, roomH: number): (number?, number?, number?)
	local surfaces = HouseSurfaces.Of(tableEntry, roomW, roomH)
	local top = surfaces[1]
	if not top then
		return nil, nil, nil
	end
	return top.L, top.R, top.Y
end

-- Demi-largeur visible d'une chaise (fraction de la largeur de la pièce)
local function seatHalf(info: SeatInfo, item: Item, scale: number, roomW: number): number
	return item.Size * scale * info.Half / math.max(1, roomW)
end

-- Places possibles d'une chaise autour d'une table. `px` = x voulu (pour
-- derrière / devant : la chaise glisse le long de la table)
function HouseSurfaces.SeatSpots(tableEntry: Placed, seatItem: Item, seatScale: number, px: number, roomW: number, roomH: number): { SeatSpot }
	local spots: { SeatSpot } = {}
	local info = SEATS[seatItem.Id]
	if not info or not HouseSurfaces.IsTable(tableEntry.I) then
		return spots
	end
	local l, r, top = tableTop(tableEntry, roomW, roomH)
	if not l or not r or not top then
		return spots
	end
	local size = seatItem.Size * seatScale / math.max(1, roomW)
	local half = seatHalf(info, seatItem, seatScale, roomW)
	local reach
	if info.View == "Side" then
		-- l'avant de la chaise (profil) glisse un peu sous le plateau
		reach = ((info.Front or half) - TUCK) * seatItem.Size * seatScale / math.max(1, roomW)
	else
		reach = half * 0.8
	end
	local sideY = tableEntry.Y - SIDE_DY
	table.insert(spots, { Table = tableEntry, Kind = "Left", X = l - reach, Y = sideY, F = nil, L = l, R = r, Top = top })
	table.insert(spots, { Table = tableEntry, Kind = "Right", X = r + reach, Y = sideY, F = info.View == "Side" or nil, L = l, R = r, Top = top })
	-- derrière / devant : le long du plateau (si la chaise tient dessous)
	local inner = math.max(0, (r - l) / 2 - half * 0.7)
	local mid = (l + r) / 2
	local x = math.clamp(px, mid - inner, mid + inner)
	if r - l >= size * 0.5 then
		-- derrière : assez loin pour que le dossier dépasse un peu du plateau
		local tableTopHeight = tableEntry.Y - top
		local seatHeight = seatItem.Size * seatScale * 0.9 / math.max(1, roomH)
		local behind = math.clamp(tableTopHeight - seatHeight + BEHIND_PEEK, BEHIND_DY, BEHIND_MAX)
		table.insert(spots, { Table = tableEntry, Kind = "Behind", X = x, Y = tableEntry.Y - behind, F = nil, L = l, R = r, Top = top })
		table.insert(spots, { Table = tableEntry, Kind = "Front", X = x, Y = tableEntry.Y + FRONT_DY, F = nil, L = l, R = r, Top = top })
	end
	return spots
end

-- Place la plus proche d'une chaise qu'on déplace (pieds en x, y) : nil si
-- aucune table n'est assez près
function HouseSurfaces.FindSeat(list: { Placed }, seatEntry: Placed, x: number, y: number, roomW: number, roomH: number, skip: { [Placed]: boolean }?): SeatSpot?
	local item = HouseCommon.ItemsById[seatEntry.I]
	if not item or not SEATS[item.Id] then
		return nil
	end
	local best: SeatSpot? = nil
	local bestScore = math.huge
	for _, other in ipairs(list) do
		if other ~= seatEntry and not excluded(other, skip) and HouseSurfaces.IsTable(other.I) then
			for _, spot in ipairs(HouseSurfaces.SeatSpots(other, item, seatEntry.S, x, roomW, roomH)) do
				local dx = math.abs(x - spot.X) / SEAT_SNAP_X
				local dy = math.abs(y - spot.Y) / SEAT_SNAP_Y
				if dx <= 1 and dy <= 1 then
					local score = dx * dx + dy * dy
					if score < bestScore then
						bestScore = score
						best = spot
					end
				end
			end
		end
	end
	return best
end

-- Table à laquelle une chaise est rangée (et la place) ; nil sinon
function HouseSurfaces.SeatedAt(seatEntry: Placed, list: { Placed }, roomW: number, roomH: number): SeatSpot?
	local item = HouseCommon.ItemsById[seatEntry.I]
	if not item or not SEATS[item.Id] then
		return nil
	end
	local best: SeatSpot? = nil
	local bestScore = math.huge
	for _, other in ipairs(list) do
		if other ~= seatEntry and HouseSurfaces.IsTable(other.I) then
			for _, spot in ipairs(HouseSurfaces.SeatSpots(other, item, seatEntry.S, seatEntry.X, roomW, roomH)) do
				local dy = math.abs(seatEntry.Y - spot.Y)
				local dx = math.abs(seatEntry.X - spot.X)
				if dy <= SEAT_EPS_Y and dx <= SEAT_EPS_X then
					local score = dy * 4 + dx
					if score < bestScore then
						bestScore = score
						best = spot
					end
				end
			end
		end
	end
	return best
end

----------------------------------------------------------------------
-- Ce qui suit un meuble
----------------------------------------------------------------------

-- Objets posés (directement ou non) sur `entry`, et chaises rangées à cette
-- table (avec ce qui est posé dessus) : ils bougent avec elle. 2e valeur :
-- le parent direct de chacun (meuble porteur ou table de la chaise).
function HouseSurfaces.Dependents(entry: Placed, list: { Placed }, roomW: number, roomH: number): ({ Placed }, { [Placed]: Placed })
	local result: { Placed } = {}
	if not SURFACES[entry.I] then
		return result, {}
	end
	-- (une seule passe pour connaître le support / la table de chacun)
	local parentOf: { [Placed]: Placed } = {}
	for _, other in ipairs(list) do
		if other ~= entry then
			local support = HouseSurfaces.SupportOf(other, list, roomW, roomH)
			if support then
				parentOf[other] = support.Entry
			else
				local seat = HouseSurfaces.SeatedAt(other, list, roomW, roomH)
				if seat then
					parentOf[other] = seat.Table
				end
			end
		end
	end
	local seen: { [Placed]: boolean } = { [entry] = true }
	local queue = { entry }
	while #queue > 0 do
		local current = table.remove(queue, 1) :: Placed
		for _, other in ipairs(list) do
			if not seen[other] and parentOf[other] == current then
				seen[other] = true
				table.insert(result, other)
				table.insert(queue, other)
			end
		end
	end
	return result, parentOf
end

-- Préférence d'un petit objet pour un meuble quand on le pose depuis
-- l'inventaire : 2 = idéal (nourriture sur une table, coussin sur un lit...),
-- 1 = possible, 0 = à éviter (le joueur peut quand même l'y mettre)
local SOFT_ITEMS: { [string]: boolean } = {
	HeartPillow = true,
	MoonPillow = true,
	BlanketStack = true,
}
function HouseSurfaces.Preference(item: Item, furnitureId: string): number
	local bed = BEDS[furnitureId] == true
	local seat = SEATS[furnitureId] ~= nil
	if item.Category == "Kitchen" then
		return (bed or seat) and 0 or (TABLES[furnitureId] and 2 or 1)
	elseif SOFT_ITEMS[item.Id] or item.Category == "Toys" or item.Category == "Pets" then
		return bed and 2 or 1
	end
	return (bed or seat) and 0 or 1
end

----------------------------------------------------------------------
-- Ordre d'affichage
----------------------------------------------------------------------

-- Rang de zone : 0 = mural, 1 = à plat (tapis), 2 = au sol
export type RankOf = (entry: Placed) -> number

local function defaultRank(entry: Placed): number
	local item = HouseCommon.ItemsById[entry.I]
	if item and item.Placement == "Wall" then
		return 0
	end
	return 2
end

-- Liste triée de l'arrière vers l'avant : un objet posé sur un meuble est
-- dessiné juste devant ce meuble (et ce qui est devant le meuble reste
-- devant lui) ; une chaise rangée à côté / derrière une table juste avant
-- elle, une chaise devant la table juste après ce qui est posé dessus.
function HouseSurfaces.Order(list: { Placed }, roomW: number, roomH: number, rankOf: RankOf?): { Placed }
	local rank = rankOf or defaultRank
	-- Parent direct (meuble porteur ou table) et niveau relatif à lui
	local parentOf: { [Placed]: Placed } = {}
	local stepOf: { [Placed]: number } = {}
	for _, entry in ipairs(list) do
		local support = HouseSurfaces.SupportOf(entry, list, roomW, roomH)
		if support then
			parentOf[entry] = support.Entry
			stepOf[entry] = 1
		else
			local seat = HouseSurfaces.SeatedAt(entry, list, roomW, roomH)
			if seat then
				parentOf[entry] = seat.Table
				stepOf[entry] = seat.Kind == "Front" and 10 or -20
			end
		end
	end
	local rootOf: { [Placed]: Placed } = {}
	local levelOf: { [Placed]: number } = {}
	for _, entry in ipairs(list) do
		local root = entry
		local level = 0
		local depth = 0
		-- (chaîne courte : une tasse sur un livre sur une table ; un chat sur une chaise à table)
		while parentOf[root] and depth < 5 do
			level += stepOf[root] or 1
			root = parentOf[root]
			depth += 1
		end
		rootOf[entry] = root
		levelOf[entry] = level
	end
	local indexOf: { [Placed]: number } = {}
	for index, entry in ipairs(list) do
		indexOf[entry] = index
	end
	local sorted = table.clone(list)
	table.sort(sorted, function(a, b)
		local ra, rb = rootOf[a], rootOf[b]
		local za, zb = rank(ra), rank(rb)
		if za ~= zb then
			return za < zb
		end
		if ra ~= rb then
			if ra.Z ~= rb.Z then
				return ra.Z < rb.Z
			end
			if ra.Y ~= rb.Y then
				return ra.Y < rb.Y
			end
			if ra.X ~= rb.X then
				return ra.X < rb.X
			end
			return (indexOf[ra] or 0) < (indexOf[rb] or 0)
		end
		local la, lb = levelOf[a], levelOf[b]
		if la ~= lb then
			return la < lb
		end
		if a.Z ~= b.Z then
			return a.Z < b.Z
		end
		if a.Y ~= b.Y then
			return a.Y < b.Y
		end
		if a.X ~= b.X then
			return a.X < b.X
		end
		return (indexOf[a] or 0) < (indexOf[b] or 0)
	end)
	return sorted
end

return HouseSurfaces
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="70">
            <Properties>
              <string name="Name">HouseTints</string>
              <string name="Source"><![CDATA[--[[
	HouseTints (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > HouseTints

	(v9.1) Couleurs des objets posés (entry.C = id de Config.House.Tints) :
	la couleur PRINCIPALE du dessin (le groupe de teintes qui couvre le plus
	de surface : le tissu du canapé, la coque de la radio...) prend la
	couleur choisie ; ses ombres, reflets et contours suivent (même écart de
	teinte, saturation et luminosité à l'échelle). Le reste (pieds en bois,
	feuilles, blancs, gris, yeux) ne bouge pas.
	Aucune image : on recolore les Frames / UIStroke / UIGradient / textes
	d'un dessin déjà peint (HouseArt.Paint).

	API :
	  HouseTints.Get(tintId) -> Look?            entrée de la config (nil = d'origine)
	  HouseTints.Apply(root, tintId?)            recolore le dessin peint dans `root`
	  HouseTints.Mapper(itemId, tintId?) -> (Color3) -> Color3
	      transforme n'importe quelle couleur de la palette de l'objet (3D)
]]

local HouseCommon = require(script.Parent.HouseCommon)

local HouseTints = {}

type Stats = { H: number, S: number, V: number }

local MIN_SAT = 0.14 -- en dessous : blanc / gris (jamais recoloré)
local HUE_WINDOW = 0.085 -- écart de teinte du groupe principal
local STROKE_WINDOW = 0.16 -- contours (couleur tirée vers l'encre) : plus large
local BINS = 24

function HouseTints.Get(tintId: string?): HouseCommon.Look?
	if type(tintId) ~= "string" then
		return nil
	end
	return HouseCommon.TintsById[tintId]
end

local function hueDistance(a: number, b: number): number
	local d = math.abs(a - b) % 1
	return math.min(d, 1 - d)
end

-- Teinte principale d'un dessin : surfaces colorées regroupées par teinte
local function measure(root: Instance): Stats?
	local weights = table.create(BINS, 0)
	local samples: { { number } } = {}
	for _, object in ipairs(root:GetDescendants()) do
		if object:IsA("Frame") and object.BackgroundTransparency < 0.85 then
			local h, s, v = object.BackgroundColor3:ToHSV()
			if s >= MIN_SAT and v >= 0.2 then
				local size = object.Size
				local w = math.abs(size.X.Offset) + size.X.Scale * 100
				local hh = math.abs(size.Y.Offset) + size.Y.Scale * 100
				local area = math.clamp(w * hh, 4, 6000) * (1 - object.BackgroundTransparency)
				local bin = math.floor(h * BINS) % BINS + 1
				weights[bin] += area
				table.insert(samples, { h, s, v, area })
			end
		end
	end
	local best, bestWeight = 0, 0
	for bin = 1, BINS do
		-- (un groupe peut chevaucher deux cases : on les additionne avec leurs voisines)
		local left = weights[(bin - 2) % BINS + 1]
		local right = weights[bin % BINS + 1]
		local total = weights[bin] + (left + right) * 0.5
		if total > bestWeight then
			best, bestWeight = bin, total
		end
	end
	if best == 0 then
		return nil
	end
	local center = (best - 0.5) / BINS
	-- Moyenne pondérée du groupe (teinte circulaire autour du centre)
	local sumH, sumS, sumV, sumW = 0, 0, 0, 0
	for _, sample in ipairs(samples) do
		local d = sample[1] - center
		d = (d + 0.5) % 1 - 0.5
		if math.abs(d) <= 1.5 / BINS then
			sumH += d * sample[4]
			sumS += sample[2] * sample[4]
			sumV += sample[3] * sample[4]
			sumW += sample[4]
		end
	end
	if sumW <= 0 then
		return nil
	end
	return { H = (center + sumH / sumW) % 1, S = sumS / sumW, V = sumV / sumW }
end

-- Transforme une couleur du groupe principal vers la couleur choisie
local function remap(color: Color3, main: Stats, target: Stats, window: number): Color3
	local h, s, v = color:ToHSV()
	if s < MIN_SAT * 0.8 or hueDistance(h, main.H) > window then
		return color
	end
	local d = (h - main.H + 0.5) % 1 - 0.5
	local newH = (target.H + d) % 1
	local newS = math.clamp(s * target.S / math.max(0.05, main.S), 0, 1)
	-- luminosité : la couleur principale arrive pile sur la cible, les ombres
	-- (plus foncées) et les reflets (plus clairs) gardent leur écart
	local newV
	if v <= main.V then
		newV = v * target.V / math.max(0.05, main.V)
	else
		newV = target.V + (v - main.V) * (1 - target.V) / math.max(0.01, 1 - main.V)
	end
	newV = math.clamp(newV, 0, 1)
	return Color3.fromHSV(newH, newS, newV)
end

local function targetOf(tintId: string?): Stats?
	local tint = HouseTints.Get(tintId)
	local color = tint and tint.Color
	if not color then
		return nil
	end
	local h, s, v = color:ToHSV()
	return { H = h, S = s, V = v }
end

local function remapSequence(sequence: ColorSequence, main: Stats, target: Stats): ColorSequence
	local points = {}
	for _, point in ipairs(sequence.Keypoints) do
		table.insert(points, ColorSequenceKeypoint.new(point.Time, remap(point.Value, main, target, HUE_WINDOW)))
	end
	return ColorSequence.new(points)
end

-- Recolore un dessin déjà peint (rien si tintId est nil / inconnu)
function HouseTints.Apply(root: Instance, tintId: string?)
	local target = targetOf(tintId)
	if not target then
		return
	end
	local main = measure(root)
	if not main then
		return
	end
	for _, object in ipairs(root:GetDescendants()) do
		if object:IsA("Frame") then
			object.BackgroundColor3 = remap(object.BackgroundColor3, main, target, HUE_WINDOW)
		elseif object:IsA("UIStroke") then
			object.Color = remap(object.Color, main, target, STROKE_WINDOW)
		elseif object:IsA("UIGradient") then
			object.Color = remapSequence(object.Color, main, target)
		elseif object:IsA("TextLabel") then
			object.TextColor3 = remap(object.TextColor3, main, target, HUE_WINDOW)
		end
	end
end

-- Teinte principale de chaque objet (dessin peint une fois, hors écran)
local mainCache: { [string]: Stats | false } = {}
local function mainOf(itemId: string): Stats?
	local cached = mainCache[itemId]
	if cached ~= nil then
		return if cached == false then nil else cached
	end
	local item = HouseCommon.ItemsById[itemId]
	local result: Stats? = nil
	if item then
		local HouseArt = require(script.Parent.HouseArt) :: any
		local body = Instance.new("Frame")
		body.Size = UDim2.fromOffset(100, 100)
		local ok = pcall(HouseArt.Paint, body, item, true)
		if ok then
			result = measure(body)
		end
		body:Destroy()
	end
	mainCache[itemId] = result or false
	return result
end

-- Fonction de couleur pour un objet (identité si pas de couleur choisie)
function HouseTints.Mapper(itemId: string, tintId: string?): (Color3) -> Color3
	local target = targetOf(tintId)
	local main = target and mainOf(itemId) or nil
	if not target or not main then
		return function(color: Color3): Color3
			return color
		end
	end
	local t, m = target :: Stats, main :: Stats
	return function(color: Color3): Color3
		return remap(color, m, t, STROKE_WINDOW)
	end
end

return HouseTints
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">HouseViews</string>
              <string name="Source"><![CDATA[--[[
	HouseViews (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > HouseViews

	(v9.1) Ce qu'on voit par la fenêtre de la pièce (Config.House.Views,
	room.View) : jardin ensoleillé, coucher de soleil rose, ville, plage,
	sapins sous la neige, collines de cerisiers, lac de montagne, récif de
	corail, pays des bonbons, espace, ciel arc-en-ciel ; (v9.2) skatepark,
	stade, circuit, lancement de fusée, vallée des dinos, île volcanique. Uniquement des
	Frames (≈ 15 à 40 par vue). La nuit (mode sombre) : ciel bleu nuit,
	étoiles, lune, fenêtres de la ville allumées.
	Utilisé par la pièce (fenêtre fixe), la boutique (aperçus) et la vue 3D
	(SurfaceGui de la vitre).

	API :
	  HouseViews.Paint(container, w, h, view, dark?)
	      efface puis dessine la vue dans `container` (qui doit couper son
	      contenu : ClipsDescendants) ; `view` = entrée de Config.House.Views
]]

local HousePatterns = require(script.Parent.HousePatterns)

local HouseViews = {}

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local NIGHT = Color3.fromRGB(34, 30, 88)
local Box = HousePatterns.Box
local Circle = HousePatterns.Circle
local Cloud = HousePatterns.Cloud
local Sparkle = HousePatterns.Sparkle
local Heart = HousePatterns.Heart
local Round = HousePatterns.Round

type View = { Kind: string?, Sky: Color3?, Horizon: Color3?, Ground: Color3? }
type Painter = (holder: Frame, w: number, h: number, view: View, dark: boolean) -> ()

local function noise(a: number, b: number): number
	local value = math.sin(a * 12.9898 + b * 78.233) * 43758.5453
	return value - math.floor(value)
end

-- Couleur de nuit (voile bleu) si `dark`
local function nightly(color: Color3, dark: boolean, amount: number?): Color3
	if not dark then
		return color
	end
	return color:Lerp(NIGHT, amount or 0.55)
end

-- Dégradé vertical du ciel sur tout le conteneur
local function sky(holder: Frame, w: number, h: number, top: Color3, bottom: Color3, dark: boolean)
	local frame = Box(holder, 0, 0, w, h, WHITE, 0, 1)
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 90
	gradient.Color = ColorSequence.new(nightly(top, dark, 0.75), nightly(bottom, dark, 0.6))
	gradient.Parent = frame
end

-- Colline arrondie (grand ovale coupé par le bas du conteneur)
local function hill(holder: Frame, cx: number, top: number, w: number, color: Color3, z: number?)
	return Circle(holder, cx, top + w * 0.3, w, w * 0.6, color, 0, z or 3)
end

-- Soleil (jour) ou lune + étoiles (nuit)
local function sunOrMoon(holder: Frame, x: number, y: number, size: number, dark: boolean, sunColor: Color3?)
	if dark then
		local moon = Circle(holder, x, y, size, size, Color3.fromRGB(255, 244, 200), 0, 2)
		Circle(moon, size * 0.72, size * 0.3, size * 0.8, size * 0.8, NIGHT:Lerp(Color3.fromRGB(80, 70, 150), 0.4), 0, 2)
	else
		Circle(holder, x, y, size * 1.7, size * 1.7, sunColor or Color3.fromRGB(255, 240, 170), 0.6, 2)
		Circle(holder, x, y, size, size, sunColor or Color3.fromRGB(255, 226, 120), 0, 2)
	end
end

local function stars(holder: Frame, w: number, h: number, count: number, seed: number)
	for index = 1, count do
		local x = noise(index, seed) * w
		local y = noise(seed, index) * h * 0.55
		local s = 3 + noise(index + seed, 3) * 5
		if index % 3 == 0 then
			Sparkle(holder, x, y, s * 1.4, WHITE, 0.1, 2)
		else
			Circle(holder, x, y, s * 0.5, s * 0.5, WHITE, 0.15, 2)
		end
	end
end

local VIEWS: { [string]: Painter } = {}

-- ░ Jardin ensoleillé : ciel, nuages, soleil, collines, arbre rond, fleurs
VIEWS.Garden = function(holder, w, h, view, dark)
	sky(holder, w, h, view.Sky or Color3.fromRGB(150, 214, 255), view.Horizon or Color3.fromRGB(255, 226, 240), dark)
	sunOrMoon(holder, w * 0.76, h * 0.22, h * 0.2, dark)
	if dark then
		stars(holder, w, h, 7, 3)
	else
		Cloud(holder, w * 0.3, h * 0.36, w * 0.36, WHITE, 0.05, 3)
	end
	local ground = view.Ground or Color3.fromRGB(150, 222, 150)
	hill(holder, w * 0.2, h * 0.62, w * 0.9, nightly(ground:Lerp(WHITE, 0.25), dark), 3)
	hill(holder, w * 0.85, h * 0.68, w * 0.8, nightly(ground, dark), 4)
	-- arbre rond
	Box(holder, w * 0.26 - 2, h * 0.58, 4, h * 0.16, nightly(Color3.fromRGB(176, 124, 96), dark), 0, 5)
	Circle(holder, w * 0.26, h * 0.54, h * 0.24, h * 0.22, nightly(Color3.fromRGB(110, 196, 120), dark), 0, 6)
	for index = 1, 4 do
		local fx = w * (0.5 + index * 0.1)
		Circle(holder, fx, h * (0.84 + (index % 2) * 0.05), 5, 5, nightly(index % 2 == 0 and WHITE or Color3.fromRGB(255, 150, 190), dark), 0, 6)
	end
end

-- ░ Coucher de soleil rose : grand soleil qui se couche, oiseaux, collines violettes
VIEWS.Sunset = function(holder, w, h, view, dark)
	sky(holder, w, h, view.Sky or Color3.fromRGB(255, 150, 190), view.Horizon or Color3.fromRGB(255, 214, 150), dark)
	if dark then
		stars(holder, w, h, 8, 5)
		sunOrMoon(holder, w * 0.3, h * 0.25, h * 0.2, true)
	else
		Circle(holder, w * 0.5, h * 0.62, h * 0.56, h * 0.56, Color3.fromRGB(255, 236, 170), 0.35, 2)
		Circle(holder, w * 0.5, h * 0.62, h * 0.36, h * 0.36, Color3.fromRGB(255, 190, 110), 0, 2)
		for index = 0, 2 do
			Box(holder, 0, h * (0.5 + index * 0.07), w, 2, Color3.fromRGB(255, 170, 190), 0.3, 3)
		end
		-- oiseaux (deux petits "v")
		for index = 0, 1 do
			local bx, by = w * (0.2 + index * 0.14), h * (0.22 + index * 0.08)
			for _, side in ipairs({ -1, 1 }) do
				local wing = Box(holder, bx + side * 3, by, 7, 1.6, Color3.fromRGB(120, 70, 110), 0, 4)
				wing.AnchorPoint = Vector2.new(0.5, 0.5)
				wing.Rotation = side * 25
			end
		end
	end
	local ground = view.Ground or Color3.fromRGB(190, 120, 170)
	hill(holder, w * 0.15, h * 0.66, w * 0.8, nightly(ground:Lerp(WHITE, 0.2), dark), 4)
	hill(holder, w * 0.9, h * 0.7, w * 0.8, nightly(ground, dark), 5)
end

-- ░ Ville : immeubles pastel, fenêtres (allumées la nuit)
VIEWS.City = function(holder, w, h, view, dark)
	sky(holder, w, h, view.Sky or Color3.fromRGB(170, 200, 255), view.Horizon or Color3.fromRGB(240, 220, 255), dark)
	sunOrMoon(holder, w * 0.18, h * 0.2, h * 0.16, dark)
	if dark then
		stars(holder, w, h, 6, 7)
	else
		Cloud(holder, w * 0.72, h * 0.28, w * 0.3, WHITE, 0.1, 2)
	end
	local tones = { Color3.fromRGB(255, 190, 214), Color3.fromRGB(196, 180, 250), Color3.fromRGB(170, 214, 250), Color3.fromRGB(255, 220, 170), Color3.fromRGB(180, 230, 210) }
	local x = -w * 0.04
	local index = 0
	while x < w do
		index += 1
		local bw = w * (0.14 + noise(index, 1) * 0.1)
		local bh = h * (0.34 + noise(index, 2) * 0.36)
		local color = nightly(tones[index % #tones + 1], dark, 0.5)
		local building = Box(holder, x, h - bh, bw, bh + 2, color, 0, 3 + index % 2)
		Round(building, UDim.new(0, 3))
		-- fenêtres
		local lit = Color3.fromRGB(255, 226, 140)
		for row = 0, math.floor(bh / 12) - 1 do
			for col = 0, math.max(0, math.floor(bw / 10) - 1) do
				local n = noise(index * 7 + row, col)
				local on = dark and n > 0.35
				Box(building, 4 + col * 9, 6 + row * 12, 4, 5, on and lit or color:Lerp(WHITE, 0.45), on and 0 or 0.2, 2)
			end
		end
		x += bw + w * 0.01
	end
end

-- ░ Plage : mer, vagues, sable, parasol, palmier
VIEWS.Beach = function(holder, w, h, view, dark)
	sky(holder, w, h, view.Sky or Color3.fromRGB(140, 214, 255), Color3.fromRGB(226, 246, 255), dark)
	sunOrMoon(holder, w * 0.78, h * 0.18, h * 0.18, dark)
	if dark then
		stars(holder, w, h, 6, 9)
	end
	local sea = nightly(view.Horizon or Color3.fromRGB(110, 200, 230), dark)
	Box(holder, 0, h * 0.46, w, h * 0.3, sea, 0, 3)
	for index = 0, 3 do
		local wave = Box(holder, w * (index * 0.26 + 0.04), h * (0.52 + (index % 2) * 0.1), w * 0.14, 2, WHITE, 0.3, 4)
		Round(wave)
	end
	-- sable
	local sand = nightly(view.Ground or Color3.fromRGB(255, 228, 170), dark)
	hill(holder, w * 0.5, h * 0.72, w * 1.6, sand, 5)
	-- parasol
	Box(holder, w * 0.3, h * 0.6, 2, h * 0.3, nightly(WHITE, dark), 0, 6)
	local umbrella = Circle(holder, w * 0.3 + 1, h * 0.62, w * 0.3, h * 0.2, nightly(Color3.fromRGB(255, 130, 170), dark), 0, 7)
	Box(umbrella, 0, h * 0.1, w * 0.3, h * 0.1, sand, 0, 2)
	-- palmier
	Box(holder, w * 0.82, h * 0.44, 4, h * 0.4, nightly(Color3.fromRGB(190, 140, 100), dark), 0, 6).Rotation = 8
	for index = 0, 3 do
		local leaf = Circle(holder, w * 0.84, h * 0.44, w * 0.18, 6, nightly(Color3.fromRGB(100, 190, 120), dark), 0, 7)
		leaf.Rotation = -40 + index * 30
	end
end

-- ░ Sapins sous la neige : flocons, sapins blancs, bonhomme
VIEWS.Snow = function(holder, w, h, view, dark)
	sky(holder, w, h, view.Sky or Color3.fromRGB(196, 214, 255), view.Horizon or Color3.fromRGB(236, 240, 255), dark)
	if dark then
		sunOrMoon(holder, w * 0.75, h * 0.2, h * 0.16, true)
	end
	local snow = nightly(view.Ground or Color3.fromRGB(250, 252, 255), dark, 0.35)
	hill(holder, w * 0.3, h * 0.66, w * 1.1, snow, 4)
	hill(holder, w * 0.9, h * 0.72, w * 0.9, snow:Lerp(Color3.fromRGB(200, 214, 250), 0.25), 5)
	for index = 0, 2 do
		local tx = w * (0.18 + index * 0.3)
		local th = h * (0.3 + (index % 2) * 0.1)
		local ty = h * 0.7 - th
		for layer = 0, 2 do
			local lw = w * (0.1 + layer * 0.05)
			local frame = Box(holder, tx - lw / 2, ty + layer * th * 0.28, lw, th * 0.36, nightly(Color3.fromRGB(96, 170, 130), dark), 0, 6)
			Round(frame, UDim.new(0.4, 0))
			Box(frame, 2, 0, lw - 4, 4, snow, 0, 2)
		end
	end
	for index = 1, 12 do
		Circle(holder, noise(index, 4) * w, noise(4, index) * h * 0.9, 3, 3, WHITE, 0.1, 8)
	end
end

-- ░ Collines de cerisiers : arbres roses, pétales, torii au loin
VIEWS.Sakura = function(holder, w, h, view, dark)
	sky(holder, w, h, view.Sky or Color3.fromRGB(190, 220, 255), view.Horizon or Color3.fromRGB(255, 226, 238), dark)
	sunOrMoon(holder, w * 0.2, h * 0.2, h * 0.16, dark)
	-- mont (Fuji) enneigé
	local mountain = Circle(holder, w * 0.62, h * 0.62, w * 0.9, h * 0.8, nightly(Color3.fromRGB(170, 170, 220), dark), 0, 2)
	mountain.Rotation = 0
	Circle(holder, w * 0.62, h * 0.3, w * 0.3, h * 0.16, nightly(WHITE, dark, 0.3), 0, 3)
	local ground = view.Ground or Color3.fromRGB(170, 226, 160)
	hill(holder, w * 0.4, h * 0.72, w * 1.3, nightly(ground, dark), 4)
	for index = 0, 1 do
		local tx = w * (0.18 + index * 0.62)
		Box(holder, tx - 2, h * 0.56, 4, h * 0.22, nightly(Color3.fromRGB(150, 100, 90), dark), 0, 5)
		Circle(holder, tx, h * 0.52, w * 0.26, h * 0.26, nightly(Color3.fromRGB(255, 186, 214), dark), 0, 6)
		Circle(holder, tx + 6, h * 0.48, w * 0.14, h * 0.14, nightly(Color3.fromRGB(255, 214, 230), dark), 0, 7)
	end
	for index = 1, 8 do
		Heart(holder, noise(index, 6) * w, noise(6, index) * h * 0.8, 5, nightly(Color3.fromRGB(255, 170, 200), dark), 0.1, 8)
	end
end

-- ░ Lac de montagne : sommets enneigés, sapins, reflet
VIEWS.Mountains = function(holder, w, h, view, dark)
	sky(holder, w, h, view.Sky or Color3.fromRGB(150, 200, 255), view.Horizon or Color3.fromRGB(226, 240, 255), dark)
	sunOrMoon(holder, w * 0.8, h * 0.18, h * 0.14, dark)
	for index, peak in ipairs({ { 0.3, 0.26, 0.7 }, { 0.72, 0.18, 0.8 } }) do
		local cx, top, size = w * peak[1], h * peak[2], w * peak[3]
		local rock = HousePatterns.Diamond(holder, cx, top + size * 0.5, size * 0.72, nightly(index == 1 and Color3.fromRGB(150, 150, 200) or Color3.fromRGB(130, 136, 190), dark), 0, 2)
		local _ = rock
		HousePatterns.Diamond(holder, cx, top + size * 0.13, size * 0.2, nightly(WHITE, dark, 0.3), 0, 3)
	end
	local lake = nightly(view.Ground or Color3.fromRGB(120, 196, 220), dark)
	Box(holder, 0, h * 0.66, w, h * 0.34, lake, 0, 4)
	for index = 0, 2 do
		local ripple = Box(holder, w * (0.15 + index * 0.3), h * (0.76 + (index % 2) * 0.08), w * 0.16, 2, WHITE, 0.4, 5)
		Round(ripple)
	end
	for index = 0, 4 do
		local tx = w * (0.05 + index * 0.22)
		local tree = Box(holder, tx - 4, h * 0.52, 8, h * 0.16, nightly(Color3.fromRGB(80, 150, 110), dark), 0, 5)
		Round(tree, UDim.new(0.5, 0))
	end
end

-- ░ Récif de corail : eau turquoise, rayons, poissons, coraux, bulles
VIEWS.Underwater = function(holder, w, h, view, dark)
	sky(holder, w, h, view.Horizon or Color3.fromRGB(120, 220, 230), view.Sky or Color3.fromRGB(70, 170, 220), dark)
	for index = 0, 2 do
		local ray = Box(holder, w * (0.15 + index * 0.3), -h * 0.1, w * 0.1, h * 0.9, WHITE, 0.82, 2)
		ray.Rotation = 16
	end
	local sand = nightly(view.Ground or Color3.fromRGB(240, 214, 170), dark)
	hill(holder, w * 0.5, h * 0.8, w * 1.6, sand, 4)
	for index, coral in ipairs({ { 0.16, Color3.fromRGB(255, 120, 150) }, { 0.5, Color3.fromRGB(255, 170, 90) }, { 0.84, Color3.fromRGB(190, 120, 240) } }) do
		for branch = -1, 1 do
			local piece = Box(holder, w * coral[1] + branch * 6, h * 0.62, 5, h * 0.24, nightly(coral[2], dark), 0, 5)
			piece.Rotation = branch * 18
			Round(piece)
		end
		local _ = index
	end
	for index, fish in ipairs({ { 0.3, 0.3, Color3.fromRGB(255, 200, 80) }, { 0.7, 0.44, Color3.fromRGB(255, 140, 180) } }) do
		local body = Circle(holder, w * fish[1], h * fish[2], 16, 10, nightly(fish[3], dark), 0, 6)
		local tail = Box(holder, w * fish[1] + 6, h * fish[2] - 4, 8, 8, nightly(fish[3], dark), 0, 6)
		tail.Rotation = 45
		Circle(body, 4, 3, 3, 3, Color3.fromRGB(60, 40, 70), 0, 2)
		local _ = index
	end
	for index = 1, 6 do
		Circle(holder, noise(index, 8) * w, noise(8, index) * h * 0.7, 5, 5, WHITE, 0.45, 7)
	end
end

-- ░ Pays des bonbons : collines roses, sucettes, nuages de barbe à papa
VIEWS.Candy = function(holder, w, h, view, dark)
	sky(holder, w, h, view.Sky or Color3.fromRGB(255, 200, 236), view.Horizon or Color3.fromRGB(255, 240, 200), dark)
	sunOrMoon(holder, w * 0.8, h * 0.2, h * 0.16, dark, Color3.fromRGB(255, 214, 120))
	Cloud(holder, w * 0.28, h * 0.34, w * 0.34, nightly(Color3.fromRGB(255, 220, 244), dark, 0.4), 0, 3)
	local ground = view.Ground or Color3.fromRGB(255, 170, 210)
	hill(holder, w * 0.2, h * 0.66, w * 0.9, nightly(ground:Lerp(WHITE, 0.3), dark), 4)
	hill(holder, w * 0.85, h * 0.7, w * 0.8, nightly(ground, dark), 5)
	for index, pop in ipairs({ { 0.34, Color3.fromRGB(120, 200, 255) }, { 0.66, Color3.fromRGB(255, 120, 160) } }) do
		local px = w * pop[1]
		Box(holder, px - 1.5, h * 0.54, 3, h * 0.3, nightly(WHITE, dark), 0, 6)
		local candy = Circle(holder, px, h * 0.5, h * 0.2, h * 0.2, nightly(pop[2], dark), 0, 7)
		Circle(candy, h * 0.1, h * 0.1, h * 0.12, h * 0.12, nightly(WHITE, dark), 0.2, 2)
		Circle(candy, h * 0.1, h * 0.1, h * 0.05, h * 0.05, nightly(pop[2], dark), 0, 3)
		local _ = index
	end
	for index = 1, 5 do
		Sparkle(holder, noise(index, 9) * w, noise(9, index) * h * 0.5, 6, WHITE, 0.2, 8)
	end
end

-- ░ Espace : étoiles, planète à anneaux, fusée
VIEWS.Space = function(holder, w, h, view, dark)
	sky(holder, w, h, view.Sky or Color3.fromRGB(30, 24, 70), view.Horizon or Color3.fromRGB(90, 50, 140), false)
	stars(holder, w, h * 1.6, 14, 11)
	local planet = Circle(holder, w * 0.66, h * 0.44, h * 0.34, h * 0.34, Color3.fromRGB(255, 170, 200), 0, 4)
	Circle(planet, h * 0.1, h * 0.1, h * 0.12, h * 0.08, WHITE, 0.6, 2)
	local ring = Box(holder, 0, 0, h * 0.62, h * 0.08, Color3.fromRGB(255, 226, 150), 0.1, 5)
	ring.AnchorPoint = Vector2.new(0.5, 0.5)
	ring.Position = UDim2.fromOffset(w * 0.66, h * 0.46)
	ring.Rotation = -18
	Round(ring)
	Circle(holder, w * 0.2, h * 0.3, h * 0.12, h * 0.12, Color3.fromRGB(170, 220, 255), 0, 4)
	-- sol lunaire
	local ground = view.Ground or Color3.fromRGB(200, 196, 220)
	hill(holder, w * 0.5, h * 0.84, w * 1.6, ground:Lerp(BLACK, dark and 0.3 or 0), 5)
	Circle(holder, w * 0.3, h * 0.92, 12, 4, ground:Lerp(BLACK, 0.2), 0, 6)
	Circle(holder, w * 0.7, h * 0.94, 16, 5, ground:Lerp(BLACK, 0.2), 0, 6)
end

-- ░ Ciel arc-en-ciel : arc-en-ciel, nuages, cœurs
VIEWS.Rainbow = function(holder, w, h, view, dark)
	sky(holder, w, h, view.Sky or Color3.fromRGB(170, 220, 255), view.Horizon or Color3.fromRGB(255, 240, 250), dark)
	if dark then
		stars(holder, w, h, 6, 13)
	end
	local colors = { Color3.fromRGB(255, 120, 150), Color3.fromRGB(255, 180, 100), Color3.fromRGB(255, 226, 110),
		Color3.fromRGB(140, 220, 150), Color3.fromRGB(130, 190, 255), Color3.fromRGB(190, 150, 250) }
	local base = h * 1.3
	for index, color in ipairs(colors) do
		local size = base - (index - 1) * h * 0.1
		Circle(holder, w * 0.5, h * 0.95, size * 1.2, size, nightly(color, dark, 0.35), 0, 2 + index)
	end
	Circle(holder, w * 0.5, h * 0.95, (base - 6 * h * 0.1) * 1.2, base - 6 * h * 0.1, nightly(view.Horizon or Color3.fromRGB(255, 240, 250), dark, 0.6), 0, 9)
	Cloud(holder, w * 0.16, h * 0.98, w * 0.42, nightly(WHITE, dark, 0.3), 0, 10)
	Cloud(holder, w * 0.84, h * 0.98, w * 0.42, nightly(WHITE, dark, 0.3), 0, 10)
	Heart(holder, w * 0.5, h * 0.62, h * 0.14, nightly(Color3.fromRGB(255, 120, 170), dark, 0.3), 0, 11)
end

-- (v9.2) Trait (segment arrondi) entre deux points
local function segment(holder: Frame, x1: number, y1: number, x2: number, y2: number, thick: number, color: Color3, z: number)
	local dx, dy = x2 - x1, y2 - y1
	local frame = Box(holder, 0, 0, math.sqrt(dx * dx + dy * dy) + thick, thick, color, 0, z)
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2)
	frame.Rotation = math.deg(math.atan2(dy, dx))
	Round(frame)
	return frame
end

-- ░ (v9.2) Skatepark : immeubles au loin, rampe en U, rails, skateur
VIEWS.SkatePark = function(holder, w, h, view, dark)
	sky(holder, w, h, view.Sky or Color3.fromRGB(140, 206, 255), view.Horizon or Color3.fromRGB(230, 244, 255), dark)
	sunOrMoon(holder, w * 0.82, h * 0.18, h * 0.14, dark)
	if dark then
		stars(holder, w, h, 6, 21)
	end
	for index = 0, 4 do
		local bh = h * (0.2 + noise(index, 21) * 0.2)
		local b = Box(holder, w * (index * 0.21 - 0.02), h * 0.62 - bh, w * 0.16, bh + 4, nightly(Color3.fromRGB(170, 180, 214), dark, 0.5), 0, 2)
		Round(b, UDim.new(0, 3))
	end
	local ground = nightly(view.Ground or Color3.fromRGB(196, 200, 210), dark, 0.45)
	Box(holder, 0, h * 0.62, w, h * 0.38, ground, 0, 3)
	-- rampe en U (un grand ovale coupé)
	local ramp = Circle(holder, w * 0.45, h * 0.62, w * 0.62, h * 0.56, nightly(Color3.fromRGB(150, 160, 186), dark, 0.45), 0, 4)
	Circle(ramp, w * 0.31, h * 0.22, w * 0.5, h * 0.42, ground, 0, 2)
	Box(holder, w * 0.12, h * 0.6, w * 0.66, 3, nightly(Color3.fromRGB(255, 120, 60), dark, 0.3), 0, 5)
	-- rail
	Box(holder, w * 0.72, h * 0.8, w * 0.24, 3, nightly(Color3.fromRGB(230, 236, 246), dark, 0.3), 0, 6)
	for _, x in ipairs({ 0.74, 0.93 }) do
		Box(holder, w * x, h * 0.8, 2, h * 0.1, nightly(Color3.fromRGB(230, 236, 246), dark, 0.3), 0, 6)
	end
	-- skateur (petit bonhomme en l'air)
	local sx, sy = w * 0.2, h * 0.36
	Circle(holder, sx, sy - 8, 8, 8, nightly(Color3.fromRGB(255, 220, 196), dark, 0.3), 0, 7)
	Box(holder, sx - 3, sy - 4, 6, 9, nightly(Color3.fromRGB(80, 150, 255), dark, 0.3), 0, 7)
	local board = Box(holder, sx - 8, sy + 6, 16, 3, nightly(Color3.fromRGB(236, 66, 76), dark, 0.3), 0, 7)
	board.Rotation = -20
	Round(board)
end

-- ░ (v9.2) Stade : gradins colorés, toit, projecteurs, pelouse rayée, cage
VIEWS.Stadium = function(holder, w, h, view, dark)
	sky(holder, w, h, view.Sky or Color3.fromRGB(120, 180, 250), view.Horizon or Color3.fromRGB(220, 236, 255), dark)
	if dark then
		stars(holder, w, h * 0.5, 5, 23)
	end
	-- gradins (bandes de spectateurs)
	local stands = Box(holder, 0, h * 0.24, w, h * 0.34, nightly(Color3.fromRGB(90, 100, 150), dark, 0.4), 0, 2)
	local crowd = { Color3.fromRGB(255, 110, 110), Color3.fromRGB(255, 220, 90), Color3.fromRGB(110, 190, 255), WHITE }
	for row = 0, 3 do
		for col = 0, math.floor(w / 8) do
			if noise(row + 1, col) > 0.3 then
				Circle(stands, col * 8 + (row % 2) * 4, 6 + row * 9, 5, 5, nightly(crowd[(row + col) % #crowd + 1], dark, 0.35), 0, 2)
			end
		end
	end
	Box(holder, 0, h * 0.2, w, h * 0.06, nightly(Color3.fromRGB(230, 236, 250), dark, 0.4), 0, 3) -- toit
	-- projecteurs
	for _, x in ipairs({ 0.1, 0.9 }) do
		Box(holder, w * x - 1.5, 0, 3, h * 0.24, nightly(Color3.fromRGB(200, 206, 220), dark, 0.3), 0, 3)
		local lamp = Box(holder, w * x - 10, h * 0.02, 20, 10, Color3.fromRGB(255, 250, 220), 0, 4)
		Round(lamp, UDim.new(0, 3))
		if dark then
			local beam = Box(holder, w * x - w * 0.08, h * 0.08, w * 0.16, h * 0.9, WHITE, 0.85, 3)
			beam.Rotation = x < 0.5 and -20 or 20
		end
	end
	-- pelouse rayée
	local grass = view.Ground or Color3.fromRGB(90, 180, 90)
	Box(holder, 0, h * 0.58, w, h * 0.42, nightly(grass, dark, 0.4), 0, 4)
	for index = 0, 5 do
		if index % 2 == 0 then
			Box(holder, index * w / 6, h * 0.58, w / 6, h * 0.42, nightly(grass:Lerp(WHITE, 0.15), dark, 0.4), 0, 4)
		end
	end
	Box(holder, 0, h * 0.7, w, 2, WHITE, 0.2, 5)
	local goal = Box(holder, w * 0.4, h * 0.6, w * 0.2, h * 0.12, WHITE, 1, 5)
	local stroke = Instance.new("UIStroke")
	stroke.Color = WHITE
	stroke.Thickness = 2
	stroke.Parent = goal
	Circle(holder, w * 0.62, h * 0.88, 7, 7, WHITE, 0, 6)
end

-- ░ (v9.2) Circuit automobile : tribune, piste courbe, voitures, drapeau à damier
VIEWS.Racetrack = function(holder, w, h, view, dark)
	sky(holder, w, h, view.Sky or Color3.fromRGB(150, 210, 255), view.Horizon or Color3.fromRGB(236, 246, 255), dark)
	sunOrMoon(holder, w * 0.2, h * 0.18, h * 0.14, dark)
	if dark then
		stars(holder, w, h, 6, 25)
	else
		Cloud(holder, w * 0.72, h * 0.3, w * 0.3, WHITE, 0.1, 2)
	end
	local grass = nightly(view.Ground or Color3.fromRGB(120, 196, 110), dark)
	hill(holder, w * 0.5, h * 0.5, w * 1.8, grass, 3)
	-- piste (grand ovale gris + bordures rouges et blanches)
	local track = Circle(holder, w * 0.5, h * 0.82, w * 1.3, h * 0.44, nightly(Color3.fromRGB(96, 100, 116), dark, 0.35), 0, 4)
	Circle(track, w * 0.65, h * 0.3, w * 0.9, h * 0.22, grass, 0, 2)
	for index = 0, 9 do
		Box(holder, index * w * 0.1, h * 0.6 + math.abs(index - 4.5) * 1.2, w * 0.05, 3, index % 2 == 0 and Color3.fromRGB(236, 66, 76) or WHITE, 0, 5)
	end
	-- voitures
	for index, spec in ipairs({ { 0.3, 0.86, Color3.fromRGB(236, 66, 76) }, { 0.62, 0.9, Color3.fromRGB(80, 150, 255) } }) do
		local car = Box(holder, w * spec[1], h * spec[2] - 6, 22, 8, nightly(spec[3], dark, 0.3), 0, 6)
		Round(car, UDim.new(0, 3))
		Circle(holder, w * spec[1] + 5, h * spec[2] + 2, 6, 6, Color3.fromRGB(30, 32, 46), 0, 7)
		Circle(holder, w * spec[1] + 17, h * spec[2] + 2, 6, 6, Color3.fromRGB(30, 32, 46), 0, 7)
		local _ = index
	end
	-- drapeau à damier
	Box(holder, w * 0.86, h * 0.36, 2, h * 0.26, nightly(WHITE, dark, 0.3), 0, 5)
	for row = 0, 2 do
		for col = 0, 3 do
			Box(holder, w * 0.86 + 2 + col * 5, h * 0.36 + row * 5, 5, 5, (row + col) % 2 == 0 and WHITE or Color3.fromRGB(30, 32, 46), 0, 6)
		end
	end
end

-- ░ (v9.2) Lancement de fusée : pas de tir, fusée qui décolle, fumée
VIEWS.Launch = function(holder, w, h, view, dark)
	sky(holder, w, h, view.Sky or Color3.fromRGB(110, 170, 240), view.Horizon or Color3.fromRGB(255, 214, 170), dark)
	if dark then
		stars(holder, w, h, 9, 27)
	end
	local ground = nightly(view.Ground or Color3.fromRGB(200, 190, 170), dark)
	hill(holder, w * 0.5, h * 0.78, w * 1.7, ground, 3)
	-- tour
	Box(holder, w * 0.66, h * 0.3, 6, h * 0.5, nightly(Color3.fromRGB(236, 66, 76), dark, 0.3), 0, 4)
	for index = 0, 4 do
		segment(holder, w * 0.66, h * (0.32 + index * 0.1), w * 0.66 + 6, h * (0.4 + index * 0.1), 1.5, nightly(Color3.fromRGB(180, 50, 60), dark, 0.3), 5)
	end
	-- fumée
	for index = 0, 4 do
		Cloud(holder, w * (0.3 + index * 0.1), h * (0.86 + (index % 2) * 0.04), w * 0.2, nightly(WHITE, dark, 0.25), 0.05, 7)
	end
	-- fusée qui monte + flamme
	local rx, ry = w * 0.5, h * 0.26
	local flame = Circle(holder, rx, ry + h * 0.3, 12, h * 0.2, Color3.fromRGB(255, 170, 60), 0, 5)
	Circle(flame, 6 - 3.5, h * 0.03, 7, h * 0.12, Color3.fromRGB(255, 236, 140), 0, 2)
	local body = Box(holder, rx - 8, ry, 16, h * 0.28, nightly(WHITE, dark, 0.2), 0, 6)
	Round(body, UDim.new(0, 8))
	Circle(body, 8, h * 0.08, 8, 8, Color3.fromRGB(90, 200, 255), 0, 2)
	Box(body, 0, h * 0.18, 16, 3, Color3.fromRGB(236, 66, 76), 0, 2)
	HousePatterns.Diamond(holder, rx, ry + 2, 12, nightly(Color3.fromRGB(236, 66, 76), dark, 0.2), 0, 5)
	for _, side in ipairs({ -1, 1 }) do
		local fin = Box(holder, rx + side * 9 - 3, ry + h * 0.2, 6, h * 0.08, nightly(Color3.fromRGB(236, 66, 76), dark, 0.2), 0, 5)
		fin.Rotation = side * 18
	end
end

-- ░ (v9.2) Vallée des dinos : volcan au loin, fougères, long cou, ptérodactyle
VIEWS.Dino = function(holder, w, h, view, dark)
	sky(holder, w, h, view.Sky or Color3.fromRGB(160, 214, 250), view.Horizon or Color3.fromRGB(255, 236, 196), dark)
	sunOrMoon(holder, w * 0.18, h * 0.2, h * 0.14, dark)
	local volcano = HousePatterns.Diamond(holder, w * 0.72, h * 0.62, w * 0.5, nightly(Color3.fromRGB(150, 110, 100), dark, 0.4), 0, 2)
	local _ = volcano
	Circle(holder, w * 0.72, h * 0.28, w * 0.1, h * 0.08, Color3.fromRGB(255, 130, 60), 0, 3)
	Cloud(holder, w * 0.76, h * 0.2, w * 0.18, nightly(Color3.fromRGB(220, 220, 230), dark, 0.4), 0.1, 3)
	local ground = view.Ground or Color3.fromRGB(110, 180, 96)
	hill(holder, w * 0.35, h * 0.64, w * 1.2, nightly(ground, dark), 4)
	-- dinosaure à long cou
	local dino = nightly(Color3.fromRGB(120, 200, 150), dark, 0.4)
	Circle(holder, w * 0.34, h * 0.74, w * 0.3, h * 0.2, dino, 0, 5)
	segment(holder, w * 0.44, h * 0.72, w * 0.56, h * 0.36, 7, dino, 5)
	Circle(holder, w * 0.58, h * 0.35, 14, 10, dino, 0, 6)
	Circle(holder, w * 0.6, h * 0.34, 3, 3, Color3.fromRGB(40, 40, 60), 0, 7)
	segment(holder, w * 0.2, h * 0.76, w * 0.06, h * 0.84, 6, dino, 5)
	for _, x in ipairs({ 0.26, 0.4 }) do
		Box(holder, w * x, h * 0.78, 7, h * 0.12, dino, 0, 5)
	end
	-- fougères
	for index = 0, 3 do
		local fx = w * (0.08 + index * 0.3)
		for leaf = -1, 1 do
			local frond = Circle(holder, fx + leaf * 8, h * 0.9, 8, h * 0.22, nightly(Color3.fromRGB(70, 150, 90), dark), 0, 8)
			frond.Rotation = leaf * 30
		end
	end
	-- ptérodactyle
	local px, py = w * 0.4, h * 0.2
	segment(holder, px - 14, py - 4, px, py + 2, 3, nightly(Color3.fromRGB(150, 110, 180), dark, 0.4), 6)
	segment(holder, px, py + 2, px + 14, py - 4, 3, nightly(Color3.fromRGB(150, 110, 180), dark, 0.4), 6)
end

-- ░ (v9.2) Île volcanique : volcan qui fume, coulée de lave, mer sombre
VIEWS.Volcano = function(holder, w, h, view, dark)
	sky(holder, w, h, view.Sky or Color3.fromRGB(90, 60, 90), view.Horizon or Color3.fromRGB(255, 140, 90), dark)
	stars(holder, w, h * 0.6, 5, 29)
	local rock = nightly(view.Ground or Color3.fromRGB(70, 60, 66), dark, 0.3)
	local mountain = HousePatterns.Diamond(holder, w * 0.5, h * 0.78, w * 0.7, rock, 0, 3)
	local _ = mountain
	Circle(holder, w * 0.5, h * 0.3, w * 0.16, h * 0.08, Color3.fromRGB(255, 120, 40), 0, 4)
	Circle(holder, w * 0.5, h * 0.24, w * 0.3, h * 0.2, Color3.fromRGB(255, 160, 80), 0.6, 2)
	-- coulées de lave
	segment(holder, w * 0.47, h * 0.32, w * 0.36, h * 0.66, 5, Color3.fromRGB(255, 110, 40), 5)
	segment(holder, w * 0.54, h * 0.32, w * 0.66, h * 0.72, 4, Color3.fromRGB(255, 170, 60), 5)
	-- fumée
	for index = 0, 2 do
		Cloud(holder, w * (0.44 + index * 0.08), h * (0.24 - index * 0.07), w * (0.2 - index * 0.03), Color3.fromRGB(150, 130, 140), 0.25, 6)
	end
	-- mer + palmiers en silhouette
	Box(holder, 0, h * 0.8, w, h * 0.2, nightly(Color3.fromRGB(60, 80, 130), dark, 0.3), 0, 6)
	for index = 0, 2 do
		local ripple = Box(holder, w * (0.1 + index * 0.32), h * (0.86 + (index % 2) * 0.06), w * 0.14, 2, Color3.fromRGB(255, 150, 90), 0.4, 7)
		Round(ripple)
	end
	for _, x in ipairs({ 0.08, 0.9 }) do
		Box(holder, w * x, h * 0.56, 4, h * 0.26, Color3.fromRGB(40, 30, 40), 0, 7)
		for leaf = 0, 3 do
			local frond = Circle(holder, w * x + 2, h * 0.56, w * 0.14, 5, Color3.fromRGB(40, 30, 40), 0, 8)
			frond.Rotation = -40 + leaf * 28
		end
	end
end

-- Efface puis dessine la vue (nil / inconnue : jardin)
function HouseViews.Paint(container: GuiObject, w: number, h: number, view: View?, dark: boolean?)
	local old = container:FindFirstChild("View")
	if old then
		old:Destroy()
	end
	local holder = Instance.new("Frame")
	holder.Name = "View"
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.Size = UDim2.fromScale(1, 1)
	holder.ZIndex = 1
	holder.ClipsDescendants = true
	local entry: View = view or {}
	local painter = VIEWS[entry.Kind or "Garden"] or VIEWS.Garden
	local ok, err = pcall(painter, holder, w, h, entry, dark == true)
	if not ok then
		warn("[HouseViews] " .. tostring(entry.Kind) .. " : " .. tostring(err))
	end
	holder.Parent = container
	return holder
end

return HouseViews
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">LoadingScreen</string>
            <string name="Source"><![CDATA[--[[
	LoadingScreen (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > LoadingScreen

	Écran d'intro affiché pendant le chargement : logo "DOPAMINE CLICKER"
	avec le cerveau 🧠 qui pulse, dégradé doux qui tourne, points animés,
	barre de progression et petites astuces. Il couvre tout l'écran (même
	sous l'encoche) dans sa propre ScreenGui, au-dessus du jeu.
	Il disparaît en fondu au premier état reçu du serveur
	(ClientState.Loaded), ou au bout de 8 secondes au plus tard.

	API : LoadingScreen.Show() puis LoadingScreen.Hide() (appelé tout seul).
	v5 : textes traduits (Locale ; mis à jour si la langue est choisie
	pendant le chargement), toile à la taille de l'écran (téléphone), mode
	sombre (DarkSkin).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Client = script.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local Interface = require(Client.Interface)
local ClientState = require(Client.ClientState)
local DarkSkin = require(Client.DarkSkin)
local Locale = require(ReplicatedStorage.Shared.Locale)

local LoadingScreen = {}

local TIMEOUT = 8 -- secondes max d'affichage
local MIN_TIME = 1.2 -- durée minimale (pour que l'animation se voie)
local FADE_TIME = 0.6

-- Astuces (une liste par langue, même nombre d'éléments)
local TIPS = {
	en = {
		"Tip: every upgrade adds something new to the screen.",
		"Tip: click fast to fill the combo meter 🔥",
		"Tip: the DVD logo hitting a corner is the jackpot 📀",
		"Tip: the ocean 🌊 resets everything… but multiplies your gains.",
		"Tip: change the background in 🎨 Themes.",
		"Preparing your dose of dopamine…",
	},
	fr = {
		"Astuce : chaque amélioration ajoute quelque chose à l'écran.",
		"Astuce : clique vite pour remplir la jauge de combo 🔥",
		"Astuce : le logo DVD qui touche un coin, c'est le jackpot 📀",
		"Astuce : l'océan 🌊 remet tout à zéro… mais multiplie tes gains.",
		"Astuce : change de fond dans 🎨 Thèmes.",
		"Préparation de ta dose de dopamine…",
	},
}

local function getTips(): { string }
	return Locale.Pick(TIPS)
end

local gui: ScreenGui? = nil
local renderConnection: RBXScriptConnection? = nil
local hiding = false
local shownAt = 0
local loaded = false

-- Fondu de tous les éléments visibles d'un cadre
local function fadeOut(root: Instance, duration: number)
	for _, item in ipairs(root:GetDescendants()) do
		if item:IsA("TextLabel") or item:IsA("TextButton") then
			UIUtil.Tween(item, duration, { TextTransparency = 1, BackgroundTransparency = 1 })
		elseif item:IsA("Frame") then
			UIUtil.Tween(item, duration, { BackgroundTransparency = 1 })
		elseif item:IsA("UIStroke") then
			UIUtil.Tween(item, duration, { Transparency = 1 })
		end
	end
end

function LoadingScreen.Show()
	if gui then
		return
	end
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local old = playerGui:FindFirstChild("DopamineLoading")
	if old then
		old:Destroy()
	end
	hiding = false
	loaded = false
	shownAt = os.clock()

	local screen = UIUtil.Create("ScreenGui", {
		Name = "DopamineLoading",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 50,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	}) :: ScreenGui
	-- v9.1 : plein écran, y compris sous l'encoche (sinon le monde 3D se voit sur les côtés)
	screen.ScreenInsets = Enum.ScreenInsets.None
	screen.SafeAreaCompatibility = Enum.SafeAreaCompatibility.None
	screen.ClipToDeviceSafeArea = false
	gui = screen

	-- Fond : dégradé doux qui tourne lentement (bloque les clics)
	local background = UIUtil.Create("TextButton", {
		Name = "Background",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		AutoButtonColor = false,
		Text = "",
		BorderSizePixel = 0,
		Parent = screen,
	})
	local gradient = UIUtil.Gradient(background, ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
		ColorSequenceKeypoint.new(0.55, Color3.fromRGB(246, 240, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 232, 244)),
	}), 90)

	-- Toile centrée à la taille de celle du jeu, mise à l'échelle comme lui
	local canvasSize = Interface.CanvasSize
	local canvas = UIUtil.Create("Frame", {
		Name = "Canvas",
		Size = UDim2.fromOffset(canvasSize.X, canvasSize.Y),
		-- Même place que la toile du jeu (sur téléphone, elle n'est pas centrée)
		AnchorPoint = Vector2.zero,
		Position = Interface.Root and Interface.Root.Position or UDim2.new(),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = screen,
	})
	local canvasScale = UIUtil.Create("UIScale", { Scale = Interface.Scale, Parent = canvas })
	local scaleConnection = Interface.ScaleChanged:Connect(function(scale: number, size: Vector2)
		canvasScale.Scale = scale
		canvas.Size = UDim2.fromOffset(size.X, size.Y)
		if Interface.Root then
			canvas.Position = Interface.Root.Position
		end
	end)
	screen.Destroying:Connect(function()
		scaleConnection:Disconnect()
	end)

	-- Halo coloré derrière le logo
	local halo = UIUtil.Create("Frame", {
		Name = "Halo",
		Size = UDim2.fromOffset(260, 260),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, -70),
		BackgroundColor3 = Theme.Colors.Pink,
		BackgroundTransparency = 0.88,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = canvas,
	})
	UIUtil.Corner(halo, UDim.new(1, 0))
	UIUtil.Gradient(halo, ColorSequence.new(Theme.Colors.Pink, Theme.Colors.Purple), 45)

	-- Cerveau dans une pastille blanche avec ombre
	local brainHolder = UIUtil.Create("Frame", {
		Name = "BrainHolder",
		Size = UDim2.fromOffset(132, 132),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, -70),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = canvas,
	})
	local brainScale = UIUtil.Create("UIScale", { Scale = 0.4, Parent = brainHolder })
	local brainCircle = UIUtil.Create("Frame", {
		Name = "Circle",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 4,
		Parent = brainHolder,
	})
	UIUtil.Corner(brainCircle, UDim.new(1, 0))
	UIUtil.Stroke(brainCircle, Theme.Colors.Border, 2)
	UIUtil.Shadow(brainCircle, 6, 0.8, 4)
	local brain = UIUtil.Label({
		Text = "🧠",
		Size = UDim2.new(1, -30, 1, -30),
		Position = UDim2.fromOffset(15, 15),
		MaxTextSize = 84,
		ZIndex = 5,
		Parent = brainCircle,
	})

	-- Logo
	local title = UIUtil.Label({
		Name = "Title",
		Text = "DOPAMINE",
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.Text,
		Size = UDim2.fromOffset(640, 76),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.5, 14),
		MaxTextSize = 72,
		ZIndex = 3,
		Parent = canvas,
	})
	local titleGradient = UIUtil.Gradient(title, ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 62, 138)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(139, 50, 224)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 170, 220)),
	}), 0)
	title.TextColor3 = Color3.new(1, 1, 1) -- couleurs données par le dégradé
	local subtitle = UIUtil.Label({
		Name = "Subtitle",
		Text = "C  L  I  C  K  E  R",
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.fromOffset(400, 30),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.5, 88),
		MaxTextSize = 26,
		ZIndex = 3,
		Parent = canvas,
	})

	-- Barre de progression
	local bar = UIUtil.Create("Frame", {
		Name = "Bar",
		Size = UDim2.fromOffset(300, 10),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.5, 142),
		BackgroundColor3 = Color3.fromRGB(232, 228, 240),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 3,
		Parent = canvas,
	})
	UIUtil.Corner(bar, UDim.new(1, 0))
	local fill = UIUtil.Create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 4,
		Parent = bar,
	})
	UIUtil.Corner(fill, UDim.new(1, 0))
	UIUtil.Gradient(fill, ColorSequence.new(Theme.Colors.Pink, Theme.Colors.Purple), 0)

	local status = UIUtil.Label({
		Name = "Status",
		Text = Locale.T("Loading"),
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.fromOffset(300, 22),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.5, 160),
		MaxTextSize = 17,
		ZIndex = 3,
		Parent = canvas,
	})
	local tip = UIUtil.Label({
		Name = "Tip",
		Text = getTips()[1],
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.fromOffset(620, 22),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -40),
		MaxTextSize = 16,
		ZIndex = 3,
		Parent = canvas,
	})

	-- Entrée : le cerveau rebondit, le titre glisse
	UIUtil.Tween(brainScale, 0.7, { Scale = 1 }, Enum.EasingStyle.Elastic)
	title.Position = UDim2.new(0.5, 0, 0.5, 40)
	title.TextTransparency = 1
	UIUtil.Tween(title, 0.6, { Position = UDim2.new(0.5, 0, 0.5, 14), TextTransparency = 0 }, Enum.EasingStyle.Quint)
	subtitle.TextTransparency = 1
	task.delay(0.2, function()
		if subtitle.Parent and not hiding then
			UIUtil.Tween(subtitle, 0.6, { TextTransparency = 0 })
		end
	end)

	-- Animation continue
	local progress = 0
	local elapsed = 0
	local tipClock = 0
	local tipIndex = math.random(1, #getTips())
	tip.Text = getTips()[tipIndex]
	-- Langue choisie pendant le chargement : l'astuce change tout de suite
	Locale.OnChanged(function()
		if tip.Parent and not hiding then
			local tips = getTips()
			tipIndex = math.clamp(tipIndex, 1, #tips)
			tip.Text = tips[tipIndex]
		end
	end)
	DarkSkin.Register(screen)
	renderConnection = RunService.RenderStepped:Connect(function(dt: number)
		elapsed += dt
		gradient.Rotation = 90 + math.sin(elapsed * 0.6) * 25
		titleGradient.Offset = Vector2.new(math.sin(elapsed * 1.2) * 0.25, 0)
		brain.Rotation = math.sin(elapsed * 2.2) * 6
		halo.Size = UDim2.fromOffset(250 + math.sin(elapsed * 2) * 14, 250 + math.sin(elapsed * 2) * 14)

		-- Progression "réaliste" : file vers 90 % puis 100 % une fois chargé
		local target = loaded and 1 or 0.9
		local speed = loaded and 6 or 0.55
		progress += (target - progress) * math.min(1, dt * speed)
		fill.Size = UDim2.fromScale(progress, 1)

		if not hiding then
			local dots = string.rep(".", math.floor(elapsed * 3) % 4)
			status.Text = (loaded and Locale.T("Let's go") or Locale.T("Loading")) .. dots
		end

		tipClock += dt
		if tipClock > 2.6 and not hiding then
			tipClock = 0
			local tips = getTips()
			tipIndex = tipIndex % #tips + 1
			tip.Text = tips[tipIndex]
		end
	end)

	-- Fermeture : premier état reçu ou délai dépassé
	if ClientState.IsLoaded then
		task.delay(MIN_TIME, LoadingScreen.Hide)
	else
		local connection
		connection = ClientState.Loaded:Connect(function()
			connection:Disconnect()
			local remaining = math.max(0, MIN_TIME - (os.clock() - shownAt))
			task.delay(remaining, LoadingScreen.Hide)
		end)
	end
	task.delay(TIMEOUT, LoadingScreen.Hide)
end

function LoadingScreen.Hide()
	local screen = gui
	if not screen or hiding then
		return
	end
	hiding = true
	loaded = true
	-- On laisse la barre se remplir un instant, puis fondu général
	task.delay(0.35, function()
		if not screen.Parent then
			return
		end
		local canvas = screen:FindFirstChild("Canvas")
		local canvasScale = canvas and canvas:FindFirstChildOfClass("UIScale")
		if canvasScale then
			UIUtil.Tween(canvasScale, FADE_TIME, { Scale = canvasScale.Scale * 1.06 }, Enum.EasingStyle.Quad)
		end
		fadeOut(screen, FADE_TIME)
		local background = screen:FindFirstChild("Background")
		if background and background:IsA("GuiObject") then
			UIUtil.Tween(background, FADE_TIME, { BackgroundTransparency = 1 })
			if background:IsA("GuiButton") then
				background.Active = false
			end
		end
		task.delay(FADE_TIME + 0.05, function()
			if renderConnection then
				renderConnection:Disconnect()
				renderConnection = nil
			end
			screen:Destroy()
			if gui == screen then
				gui = nil
			end
		end)
	end)
end

-- Vrai tant que l'écran de chargement est affiché
function LoadingScreen.IsVisible(): boolean
	return gui ~= nil and not hiding
end

return LoadingScreen
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">NeedDopamine</string>
            <string name="Source"><![CDATA[--[[
	NeedDopamine (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > NeedDopamine

	Fenêtre "Pas assez de Dopamine !" quand un achat est trop cher
	(améliorations, "Aller à l'océan", maison 🏠, thèmes, boutique d'objets) :
	  - bandeau coloré avec une grosse goutte 💧 (et un "!" qui sautille) ;
	  - ce qu'on essayait d'acheter (optionnel : icône + nom) ;
	  - combien il manque + jauge "tu as / il faut" qui se remplit EN DIRECT
	    (la production continue pendant que la fenêtre est ouverte) ;
	  - conseil honnête : le plus petit pack de Dopamine qui suffit (selon ta
	    production actuelle), ou "attends ~X" si ta production y arrive
	    vite toute seule ;
	  - bouton "💎 Get Dopamine" : ouvre la boutique Robux directement sur
	    l'onglet "💧 Dopamine" (packs de Dopamine) ;
	  - "Later", ✕ ou clic À CÔTÉ de la carte : ferme. Un clic DANS la carte
	    (zone vide) ne ferme rien (UIUtil.SinkClicks).
	Elle s'affiche À CHAQUE achat refusé faute de Dopamine (plus de pause
	après "Later"), refus du serveur compris (NeedDopamine.OfferRefusal).
	Une seule fenêtre à la fois (jamais empilée, ni sur la fenêtre "Bon
	retour !"). S'il n'y a aucun pack de Dopamine à vendre (IDs à 0 hors
	Studio), on affiche juste la bulle (fallback).
	La fenêtre vit dans le calque Toasts (au-dessus des panneaux).
	Signaux (v8, utilisés par OfferPopup / UpgradeBar) : Shown (fenêtre
	ouverte), Refused(manque) ("Later", ✕ ou clic à côté).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Client = script.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local SoundManager = require(Client.SoundManager)
local ClientState = require(Client.ClientState)
local Interface = require(Client.Interface)
local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Signal = require(ReplicatedStorage.Shared.Signal)
local Locale = require(ReplicatedStorage.Shared.Locale)

local NeedDopamine = {}

NeedDopamine.Shown = Signal.new() -- () : la fenêtre vient de s'ouvrir
NeedDopamine.Refused = Signal.new() -- (manque) : "Later", ✕ ou clic à côté

-- Ce qu'on essayait d'acheter (tout est optionnel)
export type Context = {
	Icon: string?, -- emoji
	Name: string?, -- nom DÉJÀ traduit
	Color: Color3?, -- couleur de l'objet (pastille)
	Have: number?, -- Dopamine "vue par le serveur" (refus du serveur)
}

local CARD_WIDTH = 440
local HEADER_HEIGHT = 92
local WAIT_HINT = 45 -- (s) si la production comble le manque avant : on le dit
local LIVE_REFRESH = 0.25 -- (s) jauge en direct : 4 mises à jour par seconde au plus

local WHITE = Color3.new(1, 1, 1)
local INK = Color3.fromRGB(34, 22, 64)
local VIOLET = Color3.fromRGB(124, 58, 237)
local PINK = Color3.fromRGB(236, 72, 153)
local BUY = Theme.Colors.Robux

local layer: Frame? = nil
local current: Frame? = nil
local liveConnection: any = nil
local loopTweens: { Tween } = {}

function NeedDopamine.Build(parent: Frame)
	layer = parent
end

-- Pack de Dopamine achetable ?
local function packOnSale(product): boolean
	return product.Kind == "Dopamine" and ((tonumber(product.ProductId) or 0) ~= 0 or RunService:IsStudio())
end

-- Au moins un pack de Dopamine achetable ?
local function hasDopaminePacks(): boolean
	for _, product in ipairs(Config.Monetization.Products) do
		if packOnSale(product) then
			return true
		end
	end
	return false
end

-- Production actuelle (pour estimer les packs et le temps d'attente)
local function currentStats(): { PerSecond: number, ClickValue: number }
	local data = ClientState.Data
	return {
		PerSecond = tonumber(data and data.PerSecond) or 0,
		ClickValue = tonumber(data and data.ClickValue) or 0,
	}
end

-- Le plus petit pack qui couvre `missing` : (pack, montant) ; sinon le plus gros
local function suggestPack(missing: number): (any?, number)
	local stats = currentStats()
	local best, bestAmount, biggest, biggestAmount = nil, 0, nil, 0
	for _, product in ipairs(Config.Monetization.Products) do
		if packOnSale(product) then
			local amount = Formulas.ScaledReward(stats, tonumber(product.Seconds) or 0, tonumber(product.Minimum) or 0)
			if amount >= missing and (best == nil or amount < bestAmount) then
				best, bestAmount = product, amount
			end
			if amount > biggestAmount then
				biggest, biggestAmount = product, amount
			end
		end
	end
	if best then
		return best, bestAmount
	end
	return biggest, biggestAmount
end

-- Module chargé à la demande (évite les require circulaires au démarrage)
local function lazy(name: string, sub: string?): any
	local folder: Instance? = script.Parent
	if sub and folder then
		folder = folder:FindFirstChild(sub)
	end
	local module = folder and folder:FindFirstChild(name)
	if not module or not module:IsA("ModuleScript") then
		return nil
	end
	local ok, result = pcall(require, module)
	return ok and result or nil
end

local function stopLoops()
	for _, tween in ipairs(loopTweens) do
		tween:Cancel()
	end
	table.clear(loopTweens)
	if liveConnection then
		liveConnection:Disconnect()
		liveConnection = nil
	end
end

-- Petite animation en boucle (aller-retour), arrêtée à la fermeture
local function loop(instance: Instance, duration: number, props: { [string]: any }, delay: number?, reverses: boolean?)
	local tween = TweenService:Create(
		instance,
		TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, reverses ~= false, delay or 0),
		props
	)
	tween:Play()
	table.insert(loopTweens, tween)
end

local function close()
	local window = current
	if not window then
		return
	end
	current = nil
	stopLoops()
	local card = window:FindFirstChild("Card") :: Frame?
	local dimmer = window:FindFirstChild("Dimmer") :: GuiObject?
	if dimmer then
		UIUtil.Tween(dimmer, 0.2, { BackgroundTransparency = 1 })
	end
	if card then
		local scale = card:FindFirstChild("PopScale") :: UIScale?
		if scale then
			UIUtil.Tween(scale, 0.2, { Scale = 0.85 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		end
	end
	task.delay(0.22, function()
		window:Destroy()
	end)
end

local function refuse(missing: number)
	if not current then
		return
	end
	close()
	NeedDopamine.Refused:Fire(missing)
end

local function openShop()
	close()
	local PanelManager = lazy("PanelManager")
	if not PanelManager or not PanelManager.IsRegistered("RobuxShop") then
		return
	end
	PanelManager.Open("RobuxShop")
	local shop = lazy("RobuxShop", "Panels")
	if type(shop) == "table" and type(shop.ShowTab) == "function" then
		pcall(shop.ShowTab, "Dopamine")
	end
end

-- Texte qui garde sa taille (réduit si traduit plus long)
local function text(parent: Instance, props: { [string]: any }): TextLabel
	local maxSize = props.MaxTextSize or props.TextSize or 16
	local label = UIUtil.Create("TextLabel", {
		Name = props.Name,
		AnchorPoint = props.AnchorPoint or Vector2.new(0.5, 0),
		Position = props.Position,
		Size = props.Size,
		BackgroundTransparency = 1,
		Font = props.Font or Theme.Fonts.Body,
		Text = props.Text or "",
		TextColor3 = props.TextColor3 or Theme.Colors.Text,
		TextSize = maxSize,
		TextScaled = true,
		TextWrapped = props.TextWrapped == true,
		RichText = props.RichText == true,
		ZIndex = props.ZIndex or 4,
		Parent = parent,
	})
	UIUtil.Create("UITextSizeConstraint", { MaxTextSize = maxSize, MinTextSize = props.MinTextSize or 10, Parent = label })
	return label
end

-- Bandeau du haut : dégradé violet -> rose, bulles, grosse goutte + "!"
local function buildHeader(card: Frame)
	local header = UIUtil.Create("Frame", {
		Name = "Header",
		Size = UDim2.new(1, -12, 0, HEADER_HEIGHT),
		Position = UDim2.fromOffset(6, 6),
		BackgroundColor3 = WHITE,
		ClipsDescendants = true,
		ZIndex = 3,
		Parent = card,
	})
	UIUtil.Corner(header, 18)
	UIUtil.Gradient(header, ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(139, 92, 246)),
		ColorSequenceKeypoint.new(0.55, Color3.fromRGB(192, 88, 220)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(244, 114, 182)),
	}), 20)
	header:SetAttribute("DarkSkinIgnore", true)

	-- Bulles décoratives (quelques cercles blancs translucides)
	local bubbles = {
		{ 0.08, 0.3, 26, 0.8 },
		{ 0.18, 0.78, 14, 0.75 },
		{ 0.83, 0.22, 20, 0.8 },
		{ 0.93, 0.7, 30, 0.84 },
		{ 0.7, 0.85, 10, 0.7 },
		{ 0.3, 0.12, 9, 0.7 },
	}
	for index, spec in ipairs(bubbles) do
		local bubble = UIUtil.Create("Frame", {
			Name = "Bubble" .. index,
			Size = UDim2.fromOffset(spec[3], spec[3]),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(spec[1], spec[2]),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = spec[4],
			BorderSizePixel = 0,
			ZIndex = 3,
			Parent = header,
		})
		UIUtil.Corner(bubble, UDim.new(1, 0))
		loop(bubble, 1.6 + index * 0.35, { Position = UDim2.new(spec[1], 0, spec[2], -6) }, index * 0.2)
	end
	-- Étincelles
	for index, spec in ipairs({ { 0.24, 0.42, 16 }, { 0.76, 0.5, 18 }, { 0.62, 0.18, 12 } }) do
		local sparkle = UIUtil.Create("TextLabel", {
			Name = "Sparkle" .. index,
			Size = UDim2.fromOffset(spec[3] + 6, spec[3] + 6),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(spec[1], spec[2]),
			BackgroundTransparency = 1,
			Font = Theme.Fonts.Body,
			Text = "✨",
			TextSize = spec[3],
			TextTransparency = 0.2,
			ZIndex = 4,
			Parent = header,
		})
		loop(sparkle, 0.9 + index * 0.25, { TextTransparency = 0.85 }, index * 0.3)
	end

	-- Grosse goutte dans un médaillon blanc (qui flotte doucement)
	local medal = UIUtil.Create("Frame", {
		Name = "Medal",
		Size = UDim2.fromOffset(70, 70),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 6 + HEADER_HEIGHT / 2),
		BackgroundColor3 = WHITE,
		ZIndex = 5,
		Parent = card,
	})
	medal:SetAttribute("DarkSkinIgnore", true)
	UIUtil.Corner(medal, UDim.new(1, 0))
	UIUtil.Stroke(medal, WHITE, 3, 0.35)
	UIUtil.Gradient(medal, ColorSequence.new(WHITE, Color3.fromRGB(233, 222, 255)), 90)
	local drop = UIUtil.Create("TextLabel", {
		Name = "Drop",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		Text = "💧",
		TextSize = 40,
		ZIndex = 6,
		Parent = medal,
	})
	-- "!" rouge qui sautille
	local alert = UIUtil.Create("TextLabel", {
		Name = "Alert",
		Size = UDim2.fromOffset(26, 26),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -6, 0, 8),
		BackgroundColor3 = Theme.Colors.Red,
		Font = Theme.Fonts.Title,
		Text = "!",
		TextColor3 = WHITE,
		TextSize = 18,
		ZIndex = 7,
		Parent = medal,
	})
	UIUtil.Corner(alert, UDim.new(1, 0))
	UIUtil.Stroke(alert, WHITE, 2, 0)
	loop(medal, 1.3, { Position = UDim2.new(0.5, 0, 0, 2 + HEADER_HEIGHT / 2) })
	loop(alert, 0.45, { Rotation = 14 })
	-- Petite secousse "il en manque !" à l'ouverture
	task.spawn(function()
		for index = 1, 6 do
			if not drop.Parent then
				return
			end
			drop.Rotation = index % 2 == 0 and -12 or 12
			task.wait(0.06)
		end
		drop.Rotation = 0
	end)
end

-- Jauge "tu as / il faut" (brillante), renvoie une fonction de mise à jour
local function buildGauge(card: Frame, y: number): (have: number, need: number, animate: boolean) -> ()
	local track = UIUtil.Create("Frame", {
		Name = "Progress",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, y),
		Size = UDim2.new(1, -56, 0, 26),
		BackgroundColor3 = Color3.fromRGB(236, 232, 248),
		ClipsDescendants = true,
		ZIndex = 4,
		Parent = card,
	})
	UIUtil.Corner(track, UDim.new(1, 0))
	UIUtil.Stroke(track, Color3.fromRGB(196, 181, 253), 1.5, 0)
	UIUtil.Gradient(track, ColorSequence.new(Color3.fromRGB(222, 222, 222), WHITE), 90)
	local fill = UIUtil.Create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = track,
	})
	fill:SetAttribute("DarkSkinIgnore", true)
	UIUtil.Corner(fill, UDim.new(1, 0))
	UIUtil.Gradient(fill, ColorSequence.new(VIOLET, PINK), 0)
	-- Reflet sur le haut du remplissage
	UIUtil.Create("Frame", {
		Name = "Shine",
		Size = UDim2.new(1, -8, 0.42, 0),
		Position = UDim2.fromOffset(4, 2),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		ZIndex = 6,
		Parent = fill,
	}, { UIUtil.Create("UICorner", { CornerRadius = UDim.new(1, 0) }) })
	-- (texte blanc bordé de foncé : lisible sur le remplissage comme sur le rail,
	-- en mode clair comme en mode sombre)
	local amounts = UIUtil.Create("TextLabel", {
		Name = "Amounts",
		Size = UDim2.new(1, -20, 1, 0),
		Position = UDim2.fromOffset(10, 0),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Number,
		Text = "",
		TextColor3 = WHITE,
		TextSize = 14,
		ZIndex = 7,
		Parent = track,
	})
	local amountsStroke = UIUtil.Stroke(amounts, INK, 1.5, 0.3)
	amountsStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	amounts:SetAttribute("DarkSkinIgnore", true)

	return function(have: number, need: number, animate: boolean)
		local ratio = need > 0 and math.clamp(have / need, 0, 1) or 0
		local target = UDim2.fromScale(math.max(ratio, 0.04), 1)
		if animate then
			UIUtil.Tween(fill, 0.6, { Size = target }, Enum.EasingStyle.Quint)
		else
			fill.Size = target
		end
		amounts.Text = string.format(
			"💧 %s / %s  •  %s%%",
			NumberFormatter.Format(math.max(0, have)),
			NumberFormatter.Format(need),
			tostring(math.floor(ratio * 100))
		)
	end
end

-- Conseil honnête : attendre un peu, ou le plus petit pack qui suffit
local function hintFor(missing: number): string
	if missing <= 0 then
		return Locale.T("✨ You have enough now: try again!")
	end
	local production = currentStats().PerSecond
	local seconds = production > 0 and missing / production or math.huge
	if seconds <= WAIT_HINT then
		return Locale.T("⏳ Or just wait ~%s: your production gets there.", NumberFormatter.Time(math.ceil(seconds)))
	end
	local pack, amount = suggestPack(missing)
	if pack then
		return Locale.T("💡 %s gives ~%s Dopamine", pack.Icon .. " " .. Locale.T(tostring(pack.Name)), NumberFormatter.Format(amount))
	end
	return ""
end

local function build(missing: number, context: Context?)
	local parent = layer
	if not parent then
		return
	end
	if current then
		stopLoops()
		current:Destroy()
		current = nil
	end
	-- Dopamine de départ : celle vue par le serveur (refus) ou la confirmée
	local serverView = context ~= nil and context.Have ~= nil
	local function readHave(): number
		if serverView then
			local data = ClientState.Data
			return math.max(0, tonumber(data and data.Dopamine) or 0)
		end
		return math.max(0, ClientState.GetConfirmedDopamine())
	end
	local have = (context and tonumber(context.Have)) or readHave()
	local need = have + missing

	local window = UIUtil.Create("Frame", {
		Name = "NeedDopamine",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 45,
		Parent = parent,
	})
	current = window

	-- Fond assombri : un clic À CÔTÉ de la carte ferme (= "Later").
	-- (plus léger si une fenêtre est déjà ouverte dessous : pas de double voile)
	local PanelManager = lazy("PanelManager")
	local panelOpen = PanelManager ~= nil and PanelManager.IsOpen()
	local dimmer = UIUtil.Create("TextButton", {
		Name = "Dimmer",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(12, 10, 30),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 1,
		Parent = window,
	})
	UIUtil.Tween(dimmer, 0.25, { BackgroundTransparency = panelOpen and 0.72 or 0.45 })
	dimmer.Activated:Connect(function()
		refuse(missing)
	end)

	local hasContext = context ~= nil and type(context.Name) == "string" and context.Name ~= ""
	local cardHeight = HEADER_HEIGHT + (hasContext and 262 or 232)
	local card = UIUtil.Create("Frame", {
		Name = "Card",
		Size = UDim2.fromOffset(CARD_WIDTH, cardHeight),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundColor3 = WHITE,
		Active = true,
		ZIndex = 2,
		Parent = window,
	})
	UIUtil.Corner(card, Theme.Radius.XL)
	UIUtil.SinkClicks(card) -- clic dans la carte (zone vide) : ne ferme pas
	UIUtil.Stroke(card, Color3.fromRGB(167, 139, 250), 2, 0.1)
	UIUtil.Gradient(card, ColorSequence.new(WHITE, Color3.fromRGB(246, 241, 255)), 90)
	UIUtil.Shadow(card, 8, 0.7, 5)
	-- Tient toujours à l'écran (téléphone) + petit "pop" d'entrée
	local canvas = Interface.CanvasSize
	local fit = math.min(1, (canvas.X - 24) / CARD_WIDTH, (canvas.Y - 24) / cardHeight)
	local scale = UIUtil.Create("UIScale", { Name = "PopScale", Scale = 0.8 * fit, Parent = card })
	UIUtil.Tween(scale, 0.32, { Scale = fit }, Enum.EasingStyle.Back)

	buildHeader(card)

	-- ✕ (même effet que "Later" ou un clic à côté)
	UIUtil.CloseButton({
		Name = "Close",
		Size = 34,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 14),
		ZIndex = 8,
		Hitbox = Interface.IsTouch() and 48 or 0,
		Shadow = false,
		Parent = card,
		OnClose = function()
			SoundManager.Play("Click", 1.1)
			refuse(missing)
		end,
	})

	local y = HEADER_HEIGHT + 16
	text(card, {
		Name = "Title",
		Position = UDim2.new(0.5, 0, 0, y),
		Size = UDim2.new(1, -40, 0, 32),
		Font = Theme.Fonts.Title,
		Text = Locale.T("Not enough Dopamine!"),
		TextColor3 = Theme.Colors.Text,
		TextSize = 27,
		ZIndex = 4,
	})
	y += 36

	-- Ce qu'on voulait acheter (pastille)
	if hasContext and context then
		local color = context.Color or VIOLET
		local chip = UIUtil.Chip({
			Name = "Target",
			Text = Locale.T("To buy: %s", ((context.Icon and context.Icon .. " ") or "") .. tostring(context.Name)),
			Color = color:Lerp(WHITE, 0.84),
			TextColor3 = color:Lerp(INK, 0.55),
			StrokeColor = color,
			Height = 26,
			TextSize = 14,
			ZIndex = 4,
			Parent = card,
		})
		chip.AnchorPoint = Vector2.new(0.5, 0)
		chip.Position = UDim2.new(0.5, 0, 0, y)
		y += 32
	end

	local needLabel = text(card, {
		Name = "Text",
		Position = UDim2.new(0.5, 0, 0, y),
		Size = UDim2.new(1, -48, 0, 22),
		Text = "",
		TextColor3 = Theme.Colors.TextDim,
		TextSize = 17,
		RichText = true,
		ZIndex = 4,
	})
	y += 30

	local setGauge = buildGauge(card, y)
	y += 36

	local hintLabel = text(card, {
		Name = "Hint",
		Position = UDim2.new(0.5, 0, 0, y),
		Size = UDim2.new(1, -48, 0, 34),
		Text = "",
		TextColor3 = Color3.fromRGB(95, 60, 150),
		TextSize = 15,
		TextWrapped = true,
		ZIndex = 4,
	})

	local function paint(currentHave: number, animate: boolean)
		local left = math.max(0, need - currentHave)
		if left > 0 then
			needLabel.Text = Locale.T("You need <b>%s</b> more Dopamine.", NumberFormatter.Format(left))
		else
			needLabel.Text = Locale.T("<b>You can afford it now!</b>")
		end
		setGauge(currentHave, need, animate)
		hintLabel.Text = hintFor(left)
	end
	paint(have, true)

	-- Deux boutons côte à côte : "Later" (neutre) + "💎 Get Dopamine" (achat)
	local margin, gap = 24, 12
	local laterWidth = math.floor((CARD_WIDTH - margin * 2 - gap) * 0.36)
	local getWidth = CARD_WIDTH - margin * 2 - gap - laterWidth
	local later = UIUtil.BasicButton({
		Name = "Later",
		Text = Locale.T("Later"),
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.TextDim,
		TextSize = 19,
		Size = UDim2.fromOffset(laterWidth, 50),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, margin, 1, -20),
		CornerRadius = UDim.new(1, 0),
		ZIndex = 5,
		Parent = card,
	})
	local get = UIUtil.NeonButton({
		Name = "GetDopamine",
		Text = Locale.T("💎 Get Dopamine"),
		Color = BUY,
		TextColor3 = WHITE,
		Size = UDim2.fromOffset(getWidth, 50),
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -margin, 1, -20),
		CornerRadius = UDim.new(1, 0),
		MaxTextSize = 20,
		ZIndex = 5,
		Parent = card,
	})
	-- Reflet qui traverse le bouton d'achat (boucle douce, pas de code par image)
	get.ClipsDescendants = true
	local shine = UIUtil.Create("Frame", {
		Name = "Shine",
		Size = UDim2.new(0, 34, 1, 24),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(-0.3, 0, 0.5, 0),
		Rotation = 18,
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		ZIndex = 6,
		Parent = get,
	})
	shine:SetAttribute("DarkSkinIgnore", true)
	loop(shine, 1.1, { Position = UDim2.new(1.3, 0, 0.5, 0) }, 1.4, false)

	later.Activated:Connect(function()
		SoundManager.Play("Click", 1.1)
		refuse(missing)
	end)
	get.Activated:Connect(function()
		SoundManager.Play("Click", 1.3)
		openShop()
	end)

	-- Jauge en direct (la production continue pendant que la fenêtre est ouverte)
	local lastPaint = os.clock()
	local dopamineChanged = (ClientState :: any).DopamineChanged
	if type(dopamineChanged) == "table" and type(dopamineChanged.Connect) == "function" then
		liveConnection = dopamineChanged:Connect(function()
			if current ~= window or os.clock() - lastPaint < LIVE_REFRESH then
				return
			end
			lastPaint = os.clock()
			paint(readHave(), true)
		end)
	end
	NeedDopamine.Shown:Fire()
end

--[[
	À appeler quand un achat est refusé faute de Dopamine (à CHAQUE fois).
	missing = combien il manque ; fallback = fonction qui affiche la bulle
	habituelle (utilisée s'il n'y a pas de pack à vendre ou si une autre
	fenêtre bloque) ; context (optionnel) = { Icon, Name (traduit), Color }
	de ce qu'on voulait acheter.
	Renvoie true si la fenêtre est (déjà) ouverte.
]]
function NeedDopamine.Offer(missing: number, fallback: (() -> ())?, context: Context?): boolean
	missing = math.max(0, tonumber(missing) or 0)
	if missing > 0 and missing < 1 then
		missing = 1 -- (jamais "il te manque 0")
	end
	-- La fenêtre "Bon retour !" est à l'écran : on n'empile pas
	local offline = lazy("OfflinePopup")
	local offlineOpen = offline ~= nil and type(offline.IsVisible) == "function" and offline.IsVisible()
	if not layer or not hasDopaminePacks() or offlineOpen then
		if fallback then
			fallback()
		end
		return false
	end
	SoundManager.Play("Error", 0.7)
	-- Déjà ouverte : on la remplace (le manque a pu changer), jamais deux fenêtres
	build(missing, context)
	return true
end

-- Le message de refus du serveur veut-il dire "pas assez de Dopamine" ?
-- (texte traduit côté serveur : on compare avec toutes les langues)
function NeedDopamine.IsRefusal(message: any): boolean
	if type(message) ~= "string" or message == "" then
		return false
	end
	local currency = tostring(Config.Game.CurrencyName or "Dopamine")
	for _, lang in ipairs(Locale.Languages) do
		if message == Locale.TFor(lang, "Not enough %s", currency) then
			return true
		end
	end
	local lower = string.lower(message)
	return (string.find(lower, "not enough", 1, true) ~= nil or string.find(lower, "pas assez", 1, true) ~= nil)
		and string.find(lower, string.lower(currency), 1, true) ~= nil
end

--[[
	Refus du SERVEUR (le client croyait pouvoir payer : clics prédits pas
	encore comptés...) : si `message` veut dire "pas assez de Dopamine",
	ouvre la fenêtre avec le VRAI manque (prix - Dopamine connue du serveur,
	1 au minimum) et renvoie true ; sinon renvoie false (autre refus).
]]
function NeedDopamine.OfferRefusal(message: any, cost: number?, fallback: (() -> ())?, context: Context?): boolean
	if not NeedDopamine.IsRefusal(message) then
		return false
	end
	local data = ClientState.Data
	local serverHave = math.max(0, tonumber(data and data.Dopamine) or ClientState.GetConfirmedDopamine())
	local missing = math.max(1, math.ceil((tonumber(cost) or 0) - serverHave))
	local fullContext: Context = {
		Icon = context and context.Icon,
		Name = context and context.Name,
		Color = context and context.Color,
		Have = serverHave,
	}
	NeedDopamine.Offer(missing, fallback, fullContext)
	return true
end

function NeedDopamine.IsVisible(): boolean
	return current ~= nil
end

-- Ferme la fenêtre (sans compter comme un refus)
function NeedDopamine.Close()
	close()
end

return NeedDopamine
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">NeedTickets</string>
            <string name="Source"><![CDATA[--[[
	NeedTickets (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > NeedTickets

	Fenêtre "Pas assez de tickets !" (🕹️ Arcade : boutique à tickets et tout
	ce qui coûte des 🎟️ tickets) :
	  - bandeau doré animé (rayons qui tournent, gros ticket qui tremble) ;
	  - combien il manque + jauge "tu as / il faut" ;
	  - le plus petit pack de tickets de la boutique Robux qui suffit ;
	  - rappel honnête : les tickets se gagnent aussi en jouant (gratuit) ;
	  - "🎟️ Buy tickets" : ouvre la boutique Robux sur l'onglet 🎟️ Tickets
	    (le pack conseillé est mis en avant) ;
	  - "Later" ou clic à côté : ferme. Un clic DANS la carte ne ferme rien
	    (UIUtil.SinkClicks).
	Elle s'affiche À CHAQUE refus faute de tickets (aucune pause). S'il n'y a
	aucun pack de tickets à vendre (IDs à 0 hors Studio), options.Fallback
	est appelé à la place (bulle habituelle).
	Les 🏆 trophées (mises des duels) ne s'achètent JAMAIS : cette fenêtre ne
	concerne que les tickets.
	Calque Toasts (au-dessus des fenêtres), trouvé tout seul (Interface.Layers).

	API :
	  NeedTickets.Offer(missing, options?) -> boolean (true = fenêtre ouverte)
	    options = { Have = solde (sinon ClientState), Item = "nom affiché",
	                Fallback = function() ... end }
	  NeedTickets.IsVisible(), NeedTickets.Close()
	  NeedTickets.Shown (Signal), NeedTickets.Refused (Signal : manque)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Client = script.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local Interface = require(Client.Interface)
local SoundManager = require(Client.SoundManager)
local ClientState = require(Client.ClientState)
local Config = require(ReplicatedStorage.Shared.Config)
local ArcadeConfig = require(ReplicatedStorage.Shared.ArcadeConfig)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Signal = require(ReplicatedStorage.Shared.Signal)
local Locale = require(ReplicatedStorage.Shared.Locale)

local NeedTickets = {}

NeedTickets.Shown = Signal.new() -- () : la fenêtre vient de s'ouvrir
NeedTickets.Refused = Signal.new() -- (manque) : "Later" ou clic à côté

local CARD_SIZE = Vector2.new(440, 330)
local HEADER_HEIGHT = 92
local TICKET = ArcadeConfig.Tickets.Icon
local WHITE = Color3.new(1, 1, 1)
local GOLD = Color3.fromRGB(255, 196, 40)
local ORANGE = Color3.fromRGB(255, 128, 48)
local PINK = Color3.fromRGB(255, 84, 160)
local INK = Color3.fromRGB(92, 52, 16) -- texte chaud sur fond doré

local current: Frame? = nil
local loops: { Tween } = {} -- animations en boucle (rayons, reflet) : arrêtées à la fermeture

----------------------------------------------------------------------
-- Packs de tickets (Config.Monetization.Products, Kind "Tickets")
----------------------------------------------------------------------

local function packOnSale(product): boolean
	return product.Kind == "Tickets"
		and product.ComingSoon ~= true
		and ((tonumber(product.ProductId) or 0) ~= 0 or RunService:IsStudio())
end

-- Packs en vente (dans l'ordre de la config)
function NeedTickets.GetPacks(): { any }
	local packs = {}
	for _, product in ipairs(Config.Monetization.Products) do
		if packOnSale(product) then
			table.insert(packs, product)
		end
	end
	return packs
end

----------------------------------------------------------------------
-- Fenêtre
----------------------------------------------------------------------

local function layer(): Frame?
	local layers = Interface.Layers
	return layers and layers.Toasts or nil
end

-- Animation en boucle (aucun code par image), arrêtée à la fermeture
local function loop(instance: Instance, info: TweenInfo, goal: { [string]: any })
	local tween = TweenService:Create(instance, info, goal)
	table.insert(loops, tween)
	tween:Play()
end

local function stopSpin()
	for _, tween in ipairs(loops) do
		tween:Cancel()
	end
	table.clear(loops)
end

local function close()
	local window = current
	if not window then
		return
	end
	current = nil
	stopSpin()
	local card = window:FindFirstChild("Card") :: Frame?
	local dimmer = window:FindFirstChild("Dimmer") :: GuiObject?
	if dimmer then
		UIUtil.Tween(dimmer, 0.2, { BackgroundTransparency = 1 })
	end
	if card then
		local scale = card:FindFirstChild("FitScale") :: UIScale?
		if scale then
			UIUtil.Tween(scale, 0.2, { Scale = 0.85 * scale.Scale }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		end
	end
	task.delay(0.22, function()
		window:Destroy()
	end)
end

local function refuse(missing: number)
	close()
	NeedTickets.Refused:Fire(missing)
end

-- Ouvre la boutique Robux sur l'onglet 🎟️ Tickets (pack conseillé mis en avant)
local function openShop(packId: string?)
	close()
	-- Chargés à la demande (évite les require circulaires au démarrage)
	local components = script.Parent
	local PanelManager = require(components:WaitForChild("PanelManager")) :: any
	if not PanelManager.IsRegistered("RobuxShop") then
		return
	end
	PanelManager.Open("RobuxShop")
	local ok, shop = pcall(require, components:WaitForChild("Panels"):WaitForChild("RobuxShop"))
	if ok and type(shop) == "table" then
		local api = shop :: any
		if type(api.ShowTab) == "function" then
			api.ShowTab("Tickets")
		end
		if packId and type(api.Spotlight) == "function" then
			api.Spotlight(packId)
		end
	end
end

-- Bandeau doré : dégradé, rayons (rotation par Tween en boucle : aucun code
-- par image), gros ticket qui tremble, petites étincelles
local function buildHeader(card: Frame)
	local header = UIUtil.Create("Frame", {
		Name = "Header",
		Size = UDim2.new(1, -12, 0, HEADER_HEIGHT),
		Position = UDim2.fromOffset(6, 6),
		BackgroundColor3 = WHITE,
		ClipsDescendants = true,
		ZIndex = 3,
		Parent = card,
	})
	UIUtil.Corner(header, Theme.Radius.L)
	UIUtil.Gradient(header, ColorSequence.new({
		ColorSequenceKeypoint.new(0, GOLD),
		ColorSequenceKeypoint.new(0.55, ORANGE),
		ColorSequenceKeypoint.new(1, PINK),
	}), 20)
	local rays = UIUtil.Rays(header, WHITE, 8, 300, UDim2.fromScale(0.5, 0.62), 3)
	loop(rays, TweenInfo.new(24, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1), { Rotation = 360 })
	-- Halo + gros ticket
	local halo = UIUtil.Create("Frame", {
		Name = "Halo",
		Size = UDim2.fromOffset(78, 78),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.72,
		ZIndex = 4,
		Parent = header,
	})
	UIUtil.Corner(halo, UDim.new(1, 0))
	UIUtil.Stroke(halo, WHITE, 2, 0.45)
	local icon = UIUtil.Create("TextLabel", {
		Name = "Icon",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(72, 64),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		Text = TICKET,
		TextSize = 50,
		ZIndex = 5,
		Parent = header,
	})
	-- Le ticket "tremble" : il en manque !
	task.spawn(function()
		for index = 1, 6 do
			if not icon.Parent then
				return
			end
			UIUtil.Tween(icon, 0.07, { Rotation = index % 2 == 0 and -12 or 12 })
			task.wait(0.07)
		end
		UIUtil.Tween(icon, 0.12, { Rotation = -6 })
	end)
	local sparkles = { { 0.2, 0.3, 16 }, { 0.8, 0.26, 13 }, { 0.3, 0.76, 11 }, { 0.72, 0.74, 15 }, { 0.1, 0.62, 9 }, { 0.9, 0.58, 10 } }
	for index, spec in ipairs(sparkles) do
		local star = UIUtil.Create("TextLabel", {
			Name = "Sparkle" .. index,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(spec[1], spec[2]),
			Size = UDim2.fromOffset(20, 20),
			BackgroundTransparency = 1,
			Font = Theme.Fonts.Title,
			Text = index % 2 == 0 and "✨" or "•",
			TextColor3 = WHITE,
			TextSize = spec[3],
			TextTransparency = 0.15,
			ZIndex = 4,
			Parent = header,
		})
		UIUtil.Tween(star, 0.9 + index * 0.15, { TextTransparency = 0.7 }, Enum.EasingStyle.Sine)
	end
	return header
end

local function build(missing: number, have: number, item: string?)
	local parent = layer()
	if not parent then
		return false
	end
	if current then
		stopSpin()
		current:Destroy()
		current = nil
	end
	local need = have + missing

	local window = UIUtil.Create("Frame", {
		Name = "NeedTickets",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 46,
		Parent = parent,
	})
	current = window

	-- Fond sombre : un clic dehors ferme
	local dimmer = UIUtil.Create("TextButton", {
		Name = "Dimmer",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(20, 10, 30),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 1,
		Parent = window,
	})
	UIUtil.Tween(dimmer, 0.25, { BackgroundTransparency = 0.45 })
	dimmer.Activated:Connect(function()
		refuse(missing)
	end)

	local card = UIUtil.Create("Frame", {
		Name = "Card",
		Size = UDim2.fromOffset(CARD_SIZE.X, CARD_SIZE.Y),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundColor3 = WHITE,
		Active = true,
		ZIndex = 2,
		Parent = window,
	})
	UIUtil.Corner(card, Theme.Radius.XL)
	UIUtil.SinkClicks(card) -- clic dans la carte : ne ferme pas
	UIUtil.Stroke(card, ORANGE, 2.5, 0.15)
	UIUtil.Gradient(card, ColorSequence.new(WHITE, Color3.fromRGB(255, 244, 226)), 90)
	UIUtil.Shadow(card, 6, 0.75, 4)
	-- Tient toujours à l'écran (téléphone) + petit "pop" d'entrée
	local canvas = Interface.CanvasSize
	local fit = math.min(1, (canvas.X - 24) / CARD_SIZE.X, (canvas.Y - 24) / CARD_SIZE.Y)
	local scale = UIUtil.Create("UIScale", { Name = "FitScale", Scale = 0.8 * fit, Parent = card })
	UIUtil.Tween(scale, 0.3, { Scale = fit }, Enum.EasingStyle.Back)

	buildHeader(card)

	-- ✕ (même effet que "Later" ou un clic à côté), comme les autres fenêtres
	UIUtil.CloseButton({
		Name = "Close",
		Size = 34,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 14),
		ZIndex = 8,
		Hitbox = Interface.IsTouch() and 48 or 0,
		Shadow = false,
		Parent = card,
		OnClose = function()
			SoundManager.Play("Click", 1.1)
			refuse(missing)
		end,
	})

	-- Pastille "-N 🎟️" sur le bandeau (en haut à gauche : la croix est à droite)
	local chip = UIUtil.Chip({
		Name = "Missing",
		Text = "-" .. NumberFormatter.Format(missing) .. " " .. TICKET,
		Color = WHITE,
		TextColor3 = Color3.fromRGB(200, 50, 60),
		Height = 24,
		TextSize = 14,
		ZIndex = 8,
		StrokeColor = WHITE,
		Parent = card,
	})
	chip.Position = UDim2.fromOffset(18, 18)

	local top = HEADER_HEIGHT + 12
	UIUtil.Create("TextLabel", {
		Name = "Title",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, top),
		Size = UDim2.new(1, -40, 0, 28),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = Locale.T("Not enough tickets!"),
		TextColor3 = Theme.Colors.Text,
		TextScaled = true,
		ZIndex = 4,
		Parent = card,
	})
	local message = item and item ~= "" and Locale.T("You need %s more tickets for %s.", NumberFormatter.Format(missing), item)
		or Locale.T("You need %s more tickets.", NumberFormatter.Format(missing))
	local text = UIUtil.Create("TextLabel", {
		Name = "Text",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, top + 30),
		Size = UDim2.new(1, -48, 0, 20),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		Text = message,
		TextColor3 = Theme.Colors.TextDim,
		TextSize = 16,
		TextScaled = true,
		ZIndex = 4,
		Parent = card,
	})
	UIUtil.Create("UITextSizeConstraint", { MaxTextSize = 16, MinTextSize = 11, Parent = text })

	-- Jauge "tu as / il faut"
	local track = UIUtil.Create("Frame", {
		Name = "Progress",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, top + 58),
		Size = UDim2.new(1, -60, 0, 22),
		BackgroundColor3 = Color3.fromRGB(250, 234, 206),
		ClipsDescendants = true,
		ZIndex = 4,
		Parent = card,
	})
	UIUtil.Corner(track, UDim.new(1, 0))
	UIUtil.Stroke(track, ORANGE, 1, 0.55)
	local ratio = need > 0 and math.clamp(have / need, 0, 1) or 0
	local fill = UIUtil.Create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = track,
	})
	UIUtil.Corner(fill, UDim.new(1, 0))
	UIUtil.Gradient(fill, ColorSequence.new(GOLD, ORANGE), 0)
	UIUtil.Tween(fill, 0.6, { Size = UDim2.fromScale(ratio, 1) }, Enum.EasingStyle.Quint)
	local amounts = UIUtil.Create("TextLabel", {
		Name = "Amounts",
		Size = UDim2.new(1, -16, 1, 0),
		Position = UDim2.fromOffset(8, 0),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Number,
		Text = string.format("%s %s / %s", TICKET, NumberFormatter.Format(have), NumberFormatter.Format(need)),
		TextColor3 = INK,
		TextSize = 14,
		ZIndex = 6,
		Parent = track,
	})
	local amountsStroke = UIUtil.Stroke(amounts, WHITE, 1.5, 0.2)
	amountsStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual

	-- Pack conseillé : le plus petit qui suffit (sinon le plus gros)
	local pack = ArcadeConfig.Logic.PickTicketPack(missing, NeedTickets.GetPacks())
	local tip = UIUtil.Create("Frame", {
		Name = "Tip",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, top + 90),
		Size = UDim2.new(1, -48, 0, 40),
		BackgroundColor3 = Color3.fromRGB(255, 248, 232),
		ZIndex = 4,
		Parent = card,
	})
	UIUtil.Corner(tip, Theme.Radius.M)
	UIUtil.Stroke(tip, GOLD, 1.5, 0.35)
	UIUtil.Create("TextLabel", {
		Name = "PackIcon",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 8, 0.5, 0),
		Size = UDim2.fromOffset(30, 30),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		Text = pack and tostring(pack.Icon) or "💡",
		TextSize = 24,
		ZIndex = 5,
		Parent = tip,
	})
	local tipText = pack
			and Locale.T("Best fit: %s • +%s tickets", Locale.T(tostring(pack.Name)), NumberFormatter.Format(tonumber(pack.Tickets) or 0))
		or Locale.T("🕹️ Win arcade games to earn tickets!")
	local tipLabel = UIUtil.Create("TextLabel", {
		Name = "PackText",
		Position = UDim2.fromOffset(44, 0),
		Size = UDim2.new(1, -52, 1, 0),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = tipText,
		TextColor3 = INK,
		TextSize = 15,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 5,
		Parent = tip,
	})
	UIUtil.Create("UITextSizeConstraint", { MaxTextSize = 15, MinTextSize = 10, Parent = tipLabel })

	-- Rappel honnête : les tickets se gagnent aussi gratuitement
	local free = UIUtil.Create("TextLabel", {
		Name = "Free",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, top + 136),
		Size = UDim2.new(1, -48, 0, 18),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		Text = Locale.T("🕹️ Or win arcade games: tickets are free to earn."),
		TextColor3 = Theme.Colors.TextDim,
		TextSize = 14,
		TextScaled = true,
		ZIndex = 4,
		Parent = card,
	})
	UIUtil.Create("UITextSizeConstraint", { MaxTextSize = 14, MinTextSize = 10, Parent = free })

	-- Deux boutons côte à côte (style v9 partagé) : "Later" (neutre) + "🎟️ Buy tickets" (achat)
	local margin, gap = 24, 12
	local laterWidth = math.floor((CARD_SIZE.X - margin * 2 - gap) * 0.36)
	local buyWidth = CARD_SIZE.X - margin * 2 - gap - laterWidth
	local later = UIUtil.BasicButton({
		Name = "Later",
		Text = Locale.T("Later"),
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.TextDim,
		TextSize = 19,
		Size = UDim2.fromOffset(laterWidth, 50),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, margin, 1, -20),
		CornerRadius = UDim.new(1, 0),
		ZIndex = 5,
		Parent = card,
	})
	local buy = UIUtil.NeonButton({
		Name = "BuyTickets",
		Text = Locale.T("🎟️ Buy tickets"),
		Color = GOLD,
		TextColor3 = INK,
		Size = UDim2.fromOffset(buyWidth, 50),
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -margin, 1, -20),
		CornerRadius = UDim.new(1, 0),
		MaxTextSize = 20,
		ZIndex = 5,
		Parent = card,
	})
	-- Reflet qui traverse le bouton d'achat (boucle douce, arrêtée à la fermeture)
	buy.ClipsDescendants = true
	local shine = UIUtil.Create("Frame", {
		Name = "Shine",
		Size = UDim2.new(0, 34, 1, 24),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(-0.3, 0, 0.5, 0),
		Rotation = 18,
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		ZIndex = 6,
		Parent = buy,
	})
	shine:SetAttribute("DarkSkinIgnore", true)
	loop(shine, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut, -1, false, 1.4), { Position = UDim2.new(1.3, 0, 0.5, 0) })
	later.Activated:Connect(function()
		SoundManager.Play("Click", 1.1)
		refuse(missing)
	end)
	buy.Activated:Connect(function()
		SoundManager.Play("Click", 1.3)
		openShop(pack and pack.Id or nil)
	end)
	NeedTickets.Shown:Fire()
	return true
end

--[[
	À appeler À CHAQUE fois qu'une dépense en tickets est refusée (contrôle du
	client ou refus du serveur). missing = tickets manquants.
	Renvoie true si la fenêtre s'est ouverte (sinon options.Fallback est appelé).
]]
function NeedTickets.Offer(missing: number, options: { [string]: any }?): boolean
	local opts = options or {}
	local count = math.max(1, math.ceil(tonumber(missing) or 1))
	local fallback = opts.Fallback
	if #NeedTickets.GetPacks() == 0 or not layer() then
		if type(fallback) == "function" then
			fallback()
		end
		return false
	end
	local data = ClientState.Data
	local have = tonumber(opts.Have) or tonumber(data and data.Tickets) or 0
	SoundManager.Play("Error", 0.7)
	return build(count, math.max(0, math.floor(have)), type(opts.Item) == "string" and opts.Item or nil)
end

function NeedTickets.IsVisible(): boolean
	return current ~= nil
end

-- Ferme la fenêtre (sans compter comme un refus)
function NeedTickets.Close()
	close()
end

return NeedTickets
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">Notifications</string>
            <string name="Source"><![CDATA[--[[
	Notifications (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > Notifications

	Bandeaux ("toasts") en bas au centre (jamais sur le bandeau d'actualités
	ni sur le bouton / compteur du haut), style clair et soigné :
	  - liseré + badge d'icône colorés (emoji) à gauche ;
	  - titre en gras + texte, ou texte seul ;
	  - barre de temps restant (couleur du type) en bas de la carte ;
	  - empilés (3 au maximum, 2 sur téléphone : le plus ancien part en fondu) ;
	  - doublons regroupés : pastille "x2", "x3"... et le minuteur repart ;
	  - apparition en glissant + fondu, disparition en glissant sur le côté
	    (la place se referme en douceur).
	Un clic ferme le bandeau.

	Réagit aux notifications du serveur : Info, Error, Achievement, Quest,
	Rush, Jackpot, Unlock, Detox, Purchase, Offline (fenêtre "Bon retour !"
	de OfflinePopup), Achievement (grande fenêtre avec médaillon de
	AchievementPopup) et les bonus "Follow" / "Donation" du live.
	Les autres notifications "Bonus" sont montrées par les stimuli
	(StimulusManager).

	API :
	  Notifications.Toast(texte, couleur?, durée?, titre?, fête?, icône?)
	  Notifications.Show({ Text, Title, Color, Duration, Icon, Celebrate })

	v5 : textes du client traduits (Locale) ; les textes envoyés par le
	serveur arrivent déjà dans la langue du joueur. Bandeaux un peu réduits
	sur téléphone ; mode sombre via DarkSkin (calque Toasts).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local Effects = require(Client.Effects)
local SoundManager = require(Client.SoundManager)
local ClientState = require(Client.ClientState)
local OfflinePopup = require(script.Parent.OfflinePopup)
local AchievementPopup = require(script.Parent.AchievementPopup)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Interface = require(Client.Interface)

local Notifications = {}

local container: Frame? = nil
local MAX_TOASTS = 3 -- bandeaux visibles en même temps (2 sur téléphone)
local TOAST_WIDTH = 410
local MARGIN = 8 -- marge autour de la carte (place pour l'ombre dans le CanvasGroup)
local order = 0

type Toast = {
	Key: string,
	Group: CanvasGroup,
	Card: TextButton,
	Count: number,
	CountChip: Frame,
	CountLabel: TextLabel,
	Timer: Frame,
	Lifetime: number,
	Token: number,
	Closing: boolean,
	Close: () -> (),
}

local live: { Toast } = {} -- bandeaux affichés (du plus ancien au plus récent)

-- Icône par défaut selon la couleur d'accent (quand le texte n'en a pas)
local function defaultIcon(color: Color3): string
	if color == Theme.Colors.Red then
		return "⚠️"
	elseif color == Theme.Colors.Green or color == Theme.Colors.Robux then
		return "✅"
	elseif color == Theme.Colors.Gold or color == Theme.Colors.Yellow then
		return "⭐"
	end
	return "💬"
end

-- "🏆 Succès débloqué" -> ("🏆", "Succès débloqué") ; "Bonjour" -> (nil, "Bonjour")
local function splitIcon(text: string): (string?, string)
	local first, rest = string.match(text, "^(%S+)%s+(.+)$")
	if first and rest and not string.find(first, "[%w%p]") then
		return first, rest
	end
	return nil, text
end

local function maxToasts(): number
	return Interface.IsPhone() and 2 or MAX_TOASTS
end

function Notifications.Build(parent: Frame)
	local frame = UIUtil.Create("Frame", {
		Name = "Toasts",
		Size = UDim2.fromOffset(TOAST_WIDTH + MARGIN * 2, 300),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	-- Téléphone : bandeaux un peu plus petits (la toile est agrandie) pour ne
	-- pas cacher tout le bas de l'écran
	local scale = UIUtil.Create("UIScale", { Parent = frame })
	local function applyDevice()
		scale.Scale = Interface.IsPhone() and 0.88 or 1
	end
	Interface.DeviceChanged:Connect(applyDevice)
	applyDevice()
	UIUtil.Create("UIListLayout", {
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, -8), -- les marges des CanvasGroup se chevauchent : ~8 px entre deux cartes
		Parent = frame,
	})
	container = frame
end

-- Relance la barre de temps et la fermeture automatique d'un bandeau
local function arm(toast: Toast)
	toast.Token += 1
	local token = toast.Token
	toast.Timer.Size = UDim2.fromScale(1, 1)
	UIUtil.Tween(toast.Timer, toast.Lifetime, { Size = UDim2.fromScale(0, 1) }, Enum.EasingStyle.Linear)
	task.delay(toast.Lifetime, function()
		if toast.Token == token then
			toast.Close()
		end
	end)
end

-- Même bandeau déjà affiché : "x2", "x3"... au lieu d'en empiler un nouveau
local function bump(toast: Toast)
	toast.Count += 1
	toast.CountLabel.Text = "x" .. tostring(toast.Count)
	if not toast.CountChip.Visible then
		toast.CountChip.Visible = true
	end
	UIUtil.Pop(toast.CountChip, 1.6, 0.35)
	UIUtil.Pop(toast.Card, 1.04, 0.25)
	arm(toast)
end

-- Affiche un bandeau. options : Text, Title?, Color?, Duration?, Icon?, Celebrate?
function Notifications.Show(options: { [string]: any })
	local target = container
	local rawText = tostring(options.Text or "")
	local rawTitle = options.Title and tostring(options.Title) or nil
	if not target or (rawText == "" and not rawTitle) then
		return
	end

	-- Doublon d'un bandeau encore affiché : on le regroupe ("x3")
	local key = (rawTitle or "") .. "\0" .. rawText
	for _, toast in ipairs(live) do
		if toast.Key == key and not toast.Closing then
			bump(toast)
			return
		end
	end

	-- Trop de bandeaux : le plus ancien s'en va (en fondu)
	local limit = maxToasts()
	local open = {}
	for _, toast in ipairs(live) do
		if not toast.Closing then
			table.insert(open, toast)
		end
	end
	for index = 1, #open - limit + 1 do
		open[index].Close()
	end

	local accent: Color3 = options.Color or Theme.Colors.Blue
	local celebrate = options.Celebrate == true
	local lifetime = tonumber(options.Duration) or 3.5

	-- Icône : donnée, sinon 1er emoji du titre (ou du texte), sinon selon la couleur
	local icon: string? = options.Icon
	local title = rawTitle
	local text = rawText
	if title then
		local titleIcon, titleRest = splitIcon(title)
		if titleIcon then
			icon = icon or titleIcon
			title = titleRest
		end
	end
	-- Emoji en tête du texte : devient l'icône (ou disparaît s'il la répète)
	local textIcon, textRest = splitIcon(text)
	if textIcon and (not icon or textIcon == icon) then
		icon = icon or textIcon
		text = textRest
	end
	local finalIcon = icon or defaultIcon(accent)
	local hasTitle = title ~= nil and title ~= ""
	local twoLines = hasTitle and text ~= ""
	local height = twoLines and 62 or 50

	order += 1

	-- CanvasGroup : tout le bandeau (ombre comprise) apparaît / disparaît en fondu
	local group = UIUtil.Create("CanvasGroup", {
		Name = "Toast",
		Size = UDim2.fromOffset(TOAST_WIDTH + MARGIN * 2, height + MARGIN * 2),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		LayoutOrder = order,
		Parent = target,
	})

	-- TextButton (et non Frame) : le bandeau capte les clics au lieu de les laisser
	-- passer aux cartes / boutons en dessous ; un clic le ferme
	local card = UIUtil.Create("TextButton", {
		Name = "Card",
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromOffset(TOAST_WIDTH, height),
		Position = UDim2.fromOffset(MARGIN, MARGIN + 14),
		BackgroundColor3 = Theme.Colors.Card,
		ClipsDescendants = true,
		ZIndex = 2,
		Parent = group,
	})
	UIUtil.Corner(card, 14)
	UIUtil.Stroke(card, celebrate and Theme.Colors.Premium or Theme.Colors.CardBorder, celebrate and 2 or 1, celebrate and 0 or 0.8)
	UIUtil.Shadow(card, 3, 0.84, 2)
	if celebrate then
		UIUtil.Gradient(card, ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 252, 235)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 236, 180)),
		}), 0)
	else
		-- Très léger voile de la couleur du type sur la gauche
		local tint = UIUtil.Create("Frame", {
			Name = "Tint",
			Size = UDim2.new(0.6, 0, 1, 0),
			BackgroundColor3 = accent,
			BackgroundTransparency = 0.88,
			BorderSizePixel = 0,
			ZIndex = 2,
			Parent = card,
		})
		UIUtil.Create("UIGradient", {
			Transparency = NumberSequence.new(0, 1),
			Parent = tint,
		})
	end
	-- Liseré de couleur à gauche
	UIUtil.Create("Frame", {
		Name = "Accent",
		Size = UDim2.new(0, 5, 1, 0),
		BackgroundColor3 = celebrate and Theme.Colors.Premium or accent,
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = card,
	})

	-- Badge d'icône (carré arrondi coloré)
	local bubbleSize = twoLines and 42 or 34
	local bubble = UIUtil.Create("Frame", {
		Name = "Icon",
		Size = UDim2.fromOffset(bubbleSize, bubbleSize),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 14, 0.5, -1),
		BackgroundColor3 = accent,
		ZIndex = 3,
		Parent = card,
	})
	UIUtil.Corner(bubble, UDim.new(0, math.floor(bubbleSize * 0.32)))
	UIUtil.Stroke(bubble, accent:Lerp(Color3.new(0, 0, 0), 0.3), 1.5, 0.15)
	UIUtil.Gradient(bubble, ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(196, 196, 196)), 90)
	UIUtil.Create("TextLabel", {
		Name = "Emoji",
		Text = finalIcon,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		TextSize = math.floor(bubbleSize * 0.56),
		ZIndex = 4,
		Parent = bubble,
	})
	local bubbleScale = UIUtil.Create("UIScale", { Scale = 0.4, Parent = bubble })

	-- Pastille "x3" (doublons regroupés), à droite
	local countChip = UIUtil.Create("Frame", {
		Name = "Count",
		Size = UDim2.fromOffset(0, 24),
		AutomaticSize = Enum.AutomaticSize.X,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, celebrate and -44 or -12, 0.5, -1),
		BackgroundColor3 = accent,
		Visible = false,
		ZIndex = 5,
		Parent = card,
	})
	UIUtil.Corner(countChip, UDim.new(1, 0))
	UIUtil.Stroke(countChip, Color3.new(1, 1, 1), 1.5, 0)
	UIUtil.Create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = countChip })
	local countLabel = UIUtil.Create("TextLabel", {
		Name = "Label",
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Number,
		Text = "x1",
		TextSize = 15,
		TextColor3 = Theme.ContrastText(accent),
		ZIndex = 6,
		Parent = countChip,
	})

	-- Textes (place réservée à droite pour la pastille "x3")
	local left = 14 + bubbleSize + 12
	local right = (celebrate and 46 or 16) + 44
	if hasTitle then
		UIUtil.Label({
			Name = "Title",
			Text = title,
			Font = Theme.Fonts.Title,
			TextColor3 = Theme.Colors.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, -(left + right), 0, 21),
			Position = UDim2.fromOffset(left, text ~= "" and 9 or 13),
			MaxTextSize = 17,
			ZIndex = 3,
			Parent = card,
		})
		if text ~= "" then
			local body = UIUtil.Create("TextLabel", {
				Name = "Text",
				Text = text,
				Font = Theme.Fonts.Body,
				TextColor3 = Theme.Colors.TextDim,
				TextSize = 14,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, -(left + right), 0, 30),
				Position = UDim2.fromOffset(left, 30),
				ZIndex = 3,
				Parent = card,
			})
			body.TextTruncate = Enum.TextTruncate.AtEnd
		end
	else
		local body = UIUtil.Create("TextLabel", {
			Name = "Text",
			Text = text,
			Font = Theme.Fonts.Title,
			TextColor3 = Theme.Colors.Text,
			TextSize = 16,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -(left + right), 1, -10),
			Position = UDim2.fromOffset(left, 4),
			ZIndex = 3,
			Parent = card,
		})
		body.TextTruncate = Enum.TextTruncate.AtEnd
	end

	-- Étincelle qui tourne (style festif)
	if celebrate then
		local sparkle = UIUtil.Label({
			Text = "✨",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, -24, 0.5, 0),
			Size = UDim2.fromOffset(30, 30),
			MaxTextSize = 26,
			ZIndex = 3,
			Parent = card,
		})
		UIUtil.Tween(sparkle, lifetime, { Rotation = 360 }, Enum.EasingStyle.Linear)
	end

	-- Barre de temps restant (tout en bas de la carte)
	local track = UIUtil.Create("Frame", {
		Name = "TimerTrack",
		Size = UDim2.new(1, 0, 0, 3),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		BackgroundColor3 = accent,
		BackgroundTransparency = 0.85,
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = card,
	})
	local timer = UIUtil.Create("Frame", {
		Name = "Timer",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = celebrate and Theme.Colors.Premium or accent,
		BorderSizePixel = 0,
		ZIndex = 4,
		Parent = track,
	})

	-- Apparition : glissement vers le haut + fondu, l'icône "pop"
	UIUtil.Tween(group, 0.25, { GroupTransparency = 0 })
	UIUtil.Tween(card, 0.4, { Position = UDim2.fromOffset(MARGIN, MARGIN) }, Enum.EasingStyle.Quint)
	UIUtil.Tween(bubbleScale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)

	-- Survol : léger soulèvement
	card.MouseEnter:Connect(function()
		UIUtil.Tween(card, 0.15, { Position = UDim2.fromOffset(MARGIN, MARGIN - 2) })
	end)
	card.MouseLeave:Connect(function()
		UIUtil.Tween(card, 0.15, { Position = UDim2.fromOffset(MARGIN, MARGIN) })
	end)

	local toast: Toast
	local function close()
		if toast.Closing or not group.Parent then
			return
		end
		toast.Closing = true
		local index = table.find(live, toast)
		if index then
			table.remove(live, index)
		end
		UIUtil.Tween(group, 0.22, { GroupTransparency = 1 })
		UIUtil.Tween(card, 0.25, { Position = UDim2.fromOffset(MARGIN + 60, MARGIN) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		-- La place se referme en douceur (les autres bandeaux glissent)
		UIUtil.Tween(group, 0.25, { Size = UDim2.fromOffset(TOAST_WIDTH + MARGIN * 2, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(0.27, function()
			group:Destroy()
		end)
	end
	toast = {
		Key = key,
		Group = group,
		Card = card,
		Count = 1,
		CountChip = countChip,
		CountLabel = countLabel,
		Timer = timer,
		Lifetime = lifetime,
		Token = 0,
		Closing = false,
		Close = close,
	}
	table.insert(live, toast)
	card.Activated:Connect(close)
	arm(toast)
end

-- Affiche un bandeau temporaire (API historique).
-- `celebrate` = true : style festif (fond doré, étincelle) pour les achats.
function Notifications.Toast(text: string, color: Color3?, duration: number?, title: string?, celebrate: boolean?, icon: string?)
	Notifications.Show({
		Text = text,
		Color = color,
		Duration = duration,
		Title = title,
		Celebrate = celebrate,
		Icon = icon,
	})
end

-- Petite explosion au centre (vers le bouton) pour les déblocages
local function centerBurst(color: Color3?)
	local layer = Effects.GetLayer()
	if layer then
		Effects.Burst(layer, UDim2.new(0.5, 0, 0, 140), color, 16)
	end
end

-- Achat Robux confirmé : grosse fête
local function celebratePurchase(payload)
	SoundManager.Play("Jackpot", 0.9)
	task.delay(0.12, SoundManager.Play, "Jackpot", 1.2)
	task.delay(0.24, SoundManager.Play, "Achievement", 1.5)
	Effects.Flash(Theme.Colors.Premium, 0.35)
	Effects.Confetti(120)
	centerBurst(Theme.Colors.Premium)
	Effects.BigMessage(Locale.T("💎 THANK YOU! 💎"), Theme.Colors.Premium, 2.2)
	Notifications.Show({
		Text = tostring(payload.Text or Locale.T("Your purchase has arrived!")),
		Title = payload.Title or Locale.T("PURCHASE CONFIRMED"),
		Icon = "💎",
		Color = Theme.Colors.Robux,
		Duration = 6,
		Celebrate = true,
	})
end

-- Bonus du live (abonnement, dons) : en plus du texte flottant du stimulus
local function liveBonus(payload)
	local amount = tonumber(payload.Amount) or 0
	local gain = amount > 0 and ("+" .. NumberFormatter.Format(amount) .. " Dopamine") or ""
	if payload.Source == "Follow" then
		SoundManager.Play("Achievement", 1.25)
		Notifications.Show({
			Title = Locale.T("You followed the stream!"),
			Text = gain ~= "" and Locale.T("%s • donations are about to start 💸", gain) or Locale.T("Donations are about to start 💸"),
			Icon = "💜",
			Color = Theme.Colors.Pink,
			Duration = 4.5,
		})
	elseif payload.Source == "Donation" then
		Notifications.Show({
			Title = Locale.T("Donation received!"),
			Text = gain ~= "" and Locale.T("%s • thanks, viewers", gain) or Locale.T("Thanks, viewers"),
			Icon = "💸",
			Color = Theme.Colors.Robux,
			Duration = 3.5,
		})
	end
end

-- Réagit à une notification envoyée par le serveur
function Notifications.Handle(payload)
	local kind = payload.Type
	local text = payload.Text and tostring(payload.Text) or nil

	if kind == "Achievement" then
		-- Les succès ne se montrent qu'une fois le menu "Succès" débloqué
		if not ClientState.HasFeature("Achievements") then
			return
		end
		-- Grande fenêtre de fête avec le médaillon (+ badge Roblox éventuel)
		AchievementPopup.Show(payload)
	elseif kind == "Quest" then
		SoundManager.Play("Bonus", 1.2)
		Effects.Flash(Theme.Colors.Orange, 0.15)
		Notifications.Show({
			Title = payload.Title or Locale.T("QUEST COMPLETE!"),
			Text = text or "",
			Icon = "📜",
			Color = Theme.Colors.Orange,
			Duration = 4,
		})
	elseif kind == "Jackpot" then
		SoundManager.Play("Jackpot", 0.8)
		task.delay(0.15, SoundManager.Play, "Jackpot", 1.2)
		task.delay(0.3, SoundManager.Play, "Jackpot", 1.6)
		Effects.Flash(Color3.new(1, 1, 1), 0.9)
		Effects.Confetti(150)
		Effects.BigMessage(Locale.T("JACKPOT!!!\nPERFECT CORNER"), Theme.Colors.Yellow, 3.5)
		Notifications.Show({
			Title = Locale.T("THE LOGO HIT THE CORNER!"),
			Text = text or "",
			Icon = "📀",
			Color = Theme.Colors.Gold,
			Duration = 6,
			Celebrate = true,
		})
	elseif kind == "Rush" then
		SoundManager.Play("Rush", 1)
		Effects.Flash(Theme.Colors.Yellow, 0.4)
		Effects.BigMessage("⚡ DOPAMINE RUSH ⚡", Theme.Colors.Yellow, 2)
		Notifications.Show({ Text = text or "", Icon = "⚡", Color = Theme.Colors.Orange, Duration = 5 })
	elseif kind == "Unlock" then
		SoundManager.Play("Achievement", 1.3)
		centerBurst(nil)
		Notifications.Show({ Text = text or Locale.T("✨ New!"), Icon = "✨", Color = Theme.Colors.Green, Duration = 4 })
	elseif kind == "Purchase" then
		celebratePurchase(payload)
	elseif kind == "Offline" then
		OfflinePopup.Show(payload)
	elseif kind == "Detox" then
		-- La cinématique de l'océan (et son son) est jouée par StimulusManager ; le message arrive après
		local multiplier = tonumber(payload.Multiplier) or 1
		task.delay(6.5, function()
			Notifications.Show({
				Title = Locale.T("Welcome back (visit #%s)", tostring(payload.Rebirths or 1)),
				Text = Locale.T(
					"Your gains are now multiplied by %s forever.",
					tostring(math.floor(multiplier * 100 + 0.5) / 100)
				),
				Icon = "🌊",
				Color = Theme.Colors.Cyan,
				Duration = 6,
			})
		end)
	elseif kind == "Error" then
		SoundManager.Play("Error", 0.7)
		Notifications.Show({ Text = text or Locale.T("Error"), Color = Theme.Colors.Red, Duration = 5 })
	elseif kind == "Bonus" then
		-- Texte flottant géré par StimulusManager ; le live a aussi son bandeau
		if payload.Source == "Follow" or payload.Source == "Donation" then
			liveBonus(payload)
		end
		return
	else
		Notifications.Show({ Text = text or "", Title = payload.Title, Color = Theme.Colors.Blue })
	end
end

return Notifications
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">OfferPopup</string>
            <string name="Source"><![CDATA[--[[
	OfferPopup (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > OfferPopup

	Petite fenêtre "offre" Robux, discrète et HONNÊTE, construite sur
	Config.Monetization.Offers :
	  - au plus MaxPerSession offres par session, au moins Interval secondes
	    entre deux, la première après FirstDelay secondes de jeu ;
	  - jamais par-dessus une fenêtre (PanelManager), "Bon retour !",
	    "Pas assez de Dopamine", un succès ou l'écran de chargement ;
	    si une fenêtre s'ouvre pendant l'offre, l'offre se ferme ;
	  - toujours fermable (✕, "Non merci", clic à côté) ;
	  - prix clair (vrai prix Roblox, sinon Config PriceHint), pas de faux
	    compte à rebours ni de fausse rareté ; une offre déjà montrée n'est
	    pas reproposée dans la session, un pass possédé jamais.
	Offre choisie selon le moment :
	  - fin d'un Dopamine Rush ou d'un boost -> Boost (x2 15 min...) ;
	  - un peu après un refus de "Pas assez de Dopamine" -> pack de Dopamine
	    (le plus petit qui couvrait le manque) ;
	  - nouveau joueur (aucune visite à l'océan) -> pass x2 ;
	  - gros cliqueur -> pass Auto-clic ; joueur avancé -> pass x10 ;
	  - sinon, la liste Offers.Products dans l'ordre.
	Achat : MarketplaceService:PromptProductPurchase / PromptGamePassPurchase
	(comme la boutique Robux) ; le SERVEUR vérifie et donne l'achat.
	La fenêtre vit dans le calque Toasts.
	API : Build(calque), IsVisible(), Close(), Preview(genre) (Studio / tests :
	"Boost" | "Pass" | "Dopamine", sans les règles de fréquence).
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Client = script.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local Interface = require(Client.Interface)
local ClientState = require(Client.ClientState)
local SoundManager = require(Client.SoundManager)
local PanelManager = require(script.Parent.PanelManager)
local NeedDopamine = require(script.Parent.NeedDopamine)
local OfflinePopup = require(script.Parent.OfflinePopup)
local AchievementPopup = require(script.Parent.AchievementPopup)
local Notifications = require(script.Parent.Notifications)
local LoadingScreen = require(script.Parent.LoadingScreen)
local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Locale = require(ReplicatedStorage.Shared.Locale)

local OfferPopup = {}

local CARD_SIZE = Vector2.new(440, 318)
local SHOWCASE_HEIGHT = 112
local CHECK_EVERY = 2 -- (s) surveillance (fin de boost, conditions)
local PERIODIC_EVERY = 15 -- (s) essai d'une offre "normale"
local AFTER_EVENT_DELAY = 3 -- (s) après la fin d'un rush / boost (le temps de lire le message)
local REFUSAL_COOLDOWN = 150 -- (s) après un "Plus tard" de NeedDopamine avant de proposer un pack
local INTENT_TTL = 90 -- (s) une occasion (fin de rush...) n'est plus valable après
local DETOX_QUIET = 25 -- (s) pas d'offre pendant / juste après la cinématique de l'océan
local CLICKER_CLICKS = 1500 -- clics avant de proposer l'auto-clic
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)

local PASS_COLORS = {
	X10 = Theme.Colors.Purple,
	X2 = Theme.Colors.Blue,
	AutoClick = Theme.Colors.Cyan,
	VIP = Theme.Colors.Premium,
}
local PRODUCT_COLORS = {
	Dopamine = Theme.Colors.Cyan,
	Boost = Theme.Colors.Boost,
	ServerRush = Theme.Colors.Pink,
}

type Offer = {
	Def: any,
	IsPass: boolean,
	Id: number,
	Reason: string, -- phrase (anglais) qui dit POURQUOI on la propose maintenant
}
type Intent = { Kind: string, At: number, Missing: number? }

local player = Players.LocalPlayer
local layer: Frame? = nil
local current: Frame? = nil
local currentOffer: Offer? = nil
local animation: RBXScriptConnection? = nil
local sessionStart = os.clock()
local lastShown = -math.huge
local shownCount = 0
local shownIds: { [string]: boolean } = {}
local intent: Intent? = nil
local quietUntil = 0
local priceCache: { [string]: number } = {}
local fetching: { [string]: boolean } = {}

----------------------------------------------------------------------
-- Offres disponibles
----------------------------------------------------------------------

local function settings()
	return (Config.Monetization and Config.Monetization.Offers) or {}
end

local function selling(): boolean
	return Config.IsSellingForRobux == true or RunService:IsStudio()
end

-- Offre construite depuis Config (nil si elle n'est pas en vente ou déjà possédée)
local function makeOffer(id: string, isPass: boolean, reason: string): Offer?
	local def = isPass and Config.GamePassesById[id] or Config.ProductsById[id]
	if not def then
		return nil
	end
	local robloxId = tonumber(isPass and def.GamePassId or def.ProductId) or 0
	if robloxId == 0 and not RunService:IsStudio() then
		return nil
	end
	if isPass and ClientState.HasPass(def.Id) then
		return nil
	end
	return { Def = def, IsPass = isPass, Id = robloxId, Reason = reason }
end

local function listed(list: { string }?, id: string): boolean
	return type(list) == "table" and table.find(list, id) ~= nil
end

-- Pack de Dopamine le plus petit qui couvre `missing` (liste Offers.Products)
local function packFor(missing: number?): string?
	local data = ClientState.Data
	local stats = { PerSecond = tonumber(data and data.PerSecond) or 0, ClickValue = tonumber(data and data.ClickValue) or 0 }
	local best, bestAmount, fallback = nil, math.huge, nil
	for _, id in ipairs(settings().Products or {}) do
		local def = Config.ProductsById[id]
		if def and def.Kind == "Dopamine" and not shownIds[id] then
			fallback = fallback or id
			local amount = Formulas.ScaledReward(stats, tonumber(def.Seconds) or 0, tonumber(def.Minimum) or 0)
			if amount >= (missing or 0) and amount < bestAmount then
				best, bestAmount = id, amount
			end
		end
	end
	return best or fallback
end

-- Premier boost de la liste pas encore montré
local function boostOffer(reason: string): Offer?
	for _, id in ipairs(settings().Products or {}) do
		local def = Config.ProductsById[id]
		if def and def.Kind == "Boost" and not shownIds[id] then
			local offer = makeOffer(id, false, reason)
			if offer then
				return offer
			end
		end
	end
	return nil
end

-- Offre selon le moment (occasion en attente, profil du joueur, liste)
local function chooseOffer(): Offer?
	local offers = settings()
	local now = os.clock()
	local pending = intent
	if pending and now - pending.At <= INTENT_TTL + (pending.Kind == "Refused" and REFUSAL_COOLDOWN or 0) then
		if pending.Kind == "RushEnded" then
			local offer = boostOffer("The Dopamine Rush is over. Want to keep that pace a little longer?")
			if offer then
				return offer
			end
		elseif pending.Kind == "BoostEnded" then
			local offer = boostOffer("Your boost just ended.")
			if offer then
				return offer
			end
		elseif pending.Kind == "Refused" and now - pending.At >= REFUSAL_COOLDOWN then
			local id = packFor(pending.Missing)
			local offer = id and makeOffer(id, false, "Short on Dopamine earlier? A pack gets you there right away.")
			if offer then
				return offer
			end
		end
	end

	local data = ClientState.Data
	local rebirths = tonumber(data and data.Rebirths) or 0
	local clicks = tonumber(data and data.Stats and data.Stats.TotalClicks) or 0
	local passes = offers.GamePasses
	local candidates: { { string } } = {}
	if rebirths == 0 and not ClientState.HasPass("X10") then
		table.insert(candidates, { "X2", "New here? Double all your gains, forever." })
	end
	if clicks >= CLICKER_CLICKS then
		table.insert(candidates, { "AutoClick", "You click a lot! Let a little robot help your finger." })
	end
	if rebirths >= 1 then
		table.insert(candidates, { "X10", "For long runs: all your gains x10, forever." })
	end
	for _, candidate in ipairs(candidates) do
		local id = candidate[1]
		if listed(passes, id) and not shownIds[id] then
			local offer = makeOffer(id, true, candidate[2])
			if offer then
				return offer
			end
		end
	end
	for _, id in ipairs(offers.Products or {}) do
		if not shownIds[id] then
			local def = Config.ProductsById[id]
			local reason = def and def.Kind == "Dopamine" and "A little extra Dopamine, right now." or "A short boost for your session."
			local offer = makeOffer(id, false, reason)
			if offer then
				return offer
			end
		end
	end
	return nil
end

----------------------------------------------------------------------
-- Règles (fréquence, rien d'ouvert)
----------------------------------------------------------------------

local function somethingOpen(): boolean
	if PanelManager.IsOpen() or NeedDopamine.IsVisible() or OfflinePopup.IsVisible() then
		return true
	end
	if type(AchievementPopup.IsShowing) == "function" and AchievementPopup.IsShowing() then
		return true
	end
	return LoadingScreen.IsVisible()
end

local function allowed(): boolean
	local offers = settings()
	local now = os.clock()
	if current or not selling() or not ClientState.Data then
		return false
	end
	if shownCount >= (tonumber(offers.MaxPerSession) or 0) then
		return false
	end
	if now - sessionStart < (tonumber(offers.FirstDelay) or 300) then
		return false
	end
	if now - lastShown < (tonumber(offers.Interval) or 720) then
		return false
	end
	if now < quietUntil then
		return false
	end
	return not somethingOpen()
end

----------------------------------------------------------------------
-- Prix (MarketplaceService, jamais sur le thread de rendu)
----------------------------------------------------------------------

local function cacheKey(offer: Offer): string
	return (offer.IsPass and "Pass:" or "Product:") .. tostring(offer.Id)
end

local function priceOf(offer: Offer): number
	return priceCache[cacheKey(offer)] or tonumber(offer.Def.PriceHint) or 0
end

local function fetchPrice(offer: Offer, onReady: () -> ())
	local key = cacheKey(offer)
	if offer.Id == 0 or priceCache[key] or fetching[key] then
		return
	end
	fetching[key] = true
	task.spawn(function()
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfo(offer.Id, offer.IsPass and Enum.InfoType.GamePass or Enum.InfoType.Product)
		end)
		fetching[key] = nil
		local price = ok and type(info) == "table" and tonumber(info.PriceInRobux) or nil
		if price then
			priceCache[key] = price
			onReady()
		end
	end)
end

----------------------------------------------------------------------
-- Fenêtre
----------------------------------------------------------------------

local function close()
	local window = current
	if not window then
		return
	end
	current = nil
	currentOffer = nil
	if animation then
		animation:Disconnect()
		animation = nil
	end
	local card = window:FindFirstChild("Card") :: Frame?
	local dimmer = window:FindFirstChild("Dimmer") :: GuiObject?
	if dimmer then
		UIUtil.Tween(dimmer, 0.2, { BackgroundTransparency = 1 })
	end
	if card then
		local scale = card:FindFirstChildOfClass("UIScale")
		if scale then
			UIUtil.Tween(scale, 0.2, { Scale = 0.88 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		end
	end
	task.delay(0.22, function()
		window:Destroy()
	end)
end

local function buyOffer(offer: Offer, buyButton: TextButton)
	if offer.Id == 0 then
		SoundManager.Play("Error", 0.8)
		UIUtil.Shake(buyButton)
		Notifications.Toast(
			Locale.T("Paste the ID of “%s” in Config.Monetization to sell it.", Locale.T(tostring(offer.Def.Name))),
			Theme.Colors.Orange,
			5,
			Locale.T("Studio preview"),
			false,
			"🛠️"
		)
		return
	end
	SoundManager.Play("Click", 1.2)
	close()
	local ok, err = pcall(function()
		if offer.IsPass then
			MarketplaceService:PromptGamePassPurchase(player, offer.Id)
		else
			MarketplaceService:PromptProductPurchase(player, offer.Id)
		end
	end)
	if not ok then
		warn("[OfferPopup] Impossible d'ouvrir l'achat : " .. tostring(err))
		Notifications.Toast(Locale.T("Can't buy right now, try again."), Theme.Colors.Red)
	end
end

-- Ligne "ce que tu obtiens" (concrète, chiffrée)
local function benefitText(offer: Offer): string
	local def = offer.Def
	if offer.IsPass then
		if def.Multiplier then
			return Locale.T("📈 Gains %s forever", NumberFormatter.Multiplier(def.Multiplier))
		elseif def.AutoClicksPerSecond then
			return Locale.T("🤖 %s clicks / second", tostring(def.AutoClicksPerSecond))
		end
		return Locale.T(tostring(def.Description or ""))
	end
	if def.Kind == "Dopamine" then
		local data = ClientState.Data
		local stats = { PerSecond = tonumber(data and data.PerSecond) or 0, ClickValue = tonumber(data and data.ClickValue) or 0 }
		local amount = Formulas.ScaledReward(stats, tonumber(def.Seconds) or 0, tonumber(def.Minimum) or 0)
		return "💧 ~ +" .. NumberFormatter.Format(amount) .. " Dopamine"
	elseif def.Kind == "Boost" then
		local seconds = tonumber(def.Duration) or 0
		local duration = seconds % 60 == 0 and string.format("%d min", seconds // 60) or NumberFormatter.Time(seconds)
		return Locale.T("⏱️ Gains %s for %s", NumberFormatter.Multiplier(tonumber(def.Multiplier) or 2), duration)
	end
	return Locale.T(tostring(def.Description or ""))
end

local function pillButton(parent: Instance, name: string, text: string, color: Color3, textColor: Color3, position: UDim2, width: number): TextButton
	local node = UIUtil.Create("TextButton", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = position,
		Size = UDim2.fromOffset(width, 48),
		BackgroundColor3 = color,
		AutoButtonColor = false,
		Font = Theme.Fonts.Title,
		Text = text,
		TextColor3 = textColor,
		TextSize = 20,
		TextScaled = true,
		ZIndex = 6,
		Parent = parent,
	})
	UIUtil.Create("UITextSizeConstraint", { MaxTextSize = 20, MinTextSize = 12, Parent = node })
	UIUtil.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 14),
		PaddingRight = UDim.new(0, 14),
		PaddingTop = UDim.new(0, 11),
		PaddingBottom = UDim.new(0, 11),
		Parent = node,
	})
	UIUtil.Corner(node, UDim.new(1, 0))
	-- v9 : bouton en relief (dégradé, reflet, contour teinté) + ombre
	UIUtil.DressButton(node, color, { StrokeThickness = 2 })
	UIUtil.ButtonShadow(node, 3, 0.8)
	return node
end

local function show(offer: Offer)
	local parent = layer
	if not parent then
		return
	end
	if current then
		current:Destroy()
		current = nil
	end
	local def = offer.Def
	local color: Color3 = offer.IsPass and (PASS_COLORS[def.Id] or Theme.Colors.Purple) or (PRODUCT_COLORS[def.Kind] or Theme.Colors.Cyan)

	local window = UIUtil.Create("Frame", {
		Name = "OfferPopup",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 44,
		Parent = parent,
	})
	current = window
	currentOffer = offer

	-- Fond légèrement assombri : un clic à côté ferme
	local dimmer = UIUtil.Create("TextButton", {
		Name = "Dimmer",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(12, 10, 30),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 1,
		Parent = window,
	})
	UIUtil.Tween(dimmer, 0.25, { BackgroundTransparency = 0.55 })
	dimmer.Activated:Connect(close)

	local card = UIUtil.Create("Frame", {
		Name = "Card",
		Size = UDim2.fromOffset(CARD_SIZE.X, CARD_SIZE.Y),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundColor3 = WHITE,
		Active = true,
		ZIndex = 2,
		Parent = window,
	})
	UIUtil.Corner(card, Theme.Radius.XL)
	UIUtil.SinkClicks(card) -- clic dans la carte : ne ferme pas
	UIUtil.Stroke(card, color:Lerp(BLACK, 0.25), 2, 0.25)
	UIUtil.Shadow(card, 6, 0.75, 4)
	local fitScale = math.min(1, (Interface.CanvasSize.X - 24) / CARD_SIZE.X, (Interface.CanvasSize.Y - 24) / CARD_SIZE.Y)
	local scale = UIUtil.Create("UIScale", { Scale = 0.85 * fitScale, Parent = card })
	UIUtil.Tween(scale, 0.35, { Scale = fitScale }, Enum.EasingStyle.Back)

	-- Vitrine (dégradé de l'offre, rayons, icône)
	local showcase = UIUtil.Create("Frame", {
		Name = "Showcase",
		Size = UDim2.new(1, -12, 0, SHOWCASE_HEIGHT),
		Position = UDim2.fromOffset(6, 6),
		BackgroundColor3 = WHITE,
		ClipsDescendants = true,
		ZIndex = 3,
		Parent = card,
	})
	UIUtil.Corner(showcase, Theme.Radius.L)
	UIUtil.SoftGradient(showcase, color, 90)
	local rays = UIUtil.Rays(showcase, WHITE, 8, 260, UDim2.fromScale(0.5, 0.55), 3)
	local glow = UIUtil.Create("Frame", {
		Name = "Glow",
		Size = UDim2.fromOffset(84, 84),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.55),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.5,
		ZIndex = 3,
		Parent = showcase,
	})
	UIUtil.Corner(glow, UDim.new(1, 0))
	local icon = UIUtil.Create("TextLabel", {
		Name = "Icon",
		Size = UDim2.fromOffset(76, 76),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.56),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		Text = tostring(def.Icon or "💎"),
		TextSize = 56,
		ZIndex = 4,
		Parent = showcase,
	})
	local kindChip = UIUtil.Chip({
		Name = "Kind",
		Text = offer.IsPass and Locale.T("♾️ FOREVER") or Locale.T("🔁 REBUYABLE"),
		Color = WHITE,
		TextColor3 = color:Lerp(BLACK, 0.45),
		Height = 22,
		TextSize = 12,
		ZIndex = 5,
		StrokeColor = WHITE,
		Parent = showcase,
	})
	kindChip.Position = UDim2.fromOffset(10, 10)

	-- ✕ commun (toujours visible) + zone tactile agrandie autour
	UIUtil.CloseButton({
		Name = "Close",
		Size = 36,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 12),
		ZIndex = 7,
		Hitbox = 52,
		Shadow = false,
		Parent = card,
		OnClose = close,
	})

	-- Textes
	local top = SHOWCASE_HEIGHT + 14
	UIUtil.Label({
		Name = "OfferName",
		Text = Locale.T(tostring(def.Name)),
		Font = Theme.Fonts.Title,
		Size = UDim2.new(1, -40, 0, 28),
		Position = UDim2.fromOffset(20, top),
		MaxTextSize = 26,
		ZIndex = 4,
		Parent = card,
	})
	local reason = UIUtil.Create("TextLabel", {
		Name = "Reason",
		Text = Locale.T(offer.Reason),
		Font = Theme.Fonts.Body,
		TextSize = 16,
		TextColor3 = Theme.Colors.TextDim,
		TextWrapped = true,
		TextScaled = true,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -48, 0, 38),
		Position = UDim2.fromOffset(24, top + 30),
		ZIndex = 4,
		Parent = card,
	})
	UIUtil.Create("UITextSizeConstraint", { MaxTextSize = 16, MinTextSize = 10, Parent = reason })
	local benefit = UIUtil.Chip({
		Name = "Benefit",
		Text = benefitText(offer),
		Color = color:Lerp(WHITE, 0.82),
		TextColor3 = color:Lerp(BLACK, 0.55),
		Height = 28,
		TextSize = 15,
		ZIndex = 4,
		StrokeColor = color,
		Parent = card,
	})
	benefit.AnchorPoint = Vector2.new(0.5, 0)
	benefit.Position = UDim2.new(0.5, 0, 0, top + 72)

	-- Boutons : "Non merci" + prix (R$)
	local margin, gap = 22, 12
	local noWidth = math.floor((CARD_SIZE.X - margin * 2 - gap) * 0.4)
	local buyWidth = CARD_SIZE.X - margin * 2 - gap - noWidth
	local no = pillButton(card, "NoThanks", Locale.T("No thanks"), Color3.fromRGB(238, 236, 244), Theme.Colors.TextDim, UDim2.new(0, margin + noWidth / 2, 1, -30), noWidth)
	local buyButton = pillButton(
		card,
		"Buy",
		"",
		Theme.Colors.Robux,
		Theme.Colors.TextLight,
		UDim2.new(1, -(margin + buyWidth / 2), 1, -30),
		buyWidth
	)
	local function paintPrice()
		if buyButton.Parent then
			buyButton.Text = Locale.T("Buy • R$ %s", NumberFormatter.WithSpaces(priceOf(offer)))
		end
	end
	paintPrice()
	fetchPrice(offer, paintPrice)
	no.Activated:Connect(function()
		SoundManager.Play("Click", 1.05)
		close()
	end)
	buyButton.Activated:Connect(function()
		buyOffer(offer, buyButton)
	end)
	UIUtil.Label({
		Name = "Footer",
		Text = Locale.T("🔒 Secure Roblox payment"),
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, -40, 0, 14),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -8),
		MaxTextSize = 12,
		ZIndex = 4,
		Parent = card,
	})

	-- Animation douce (seulement fenêtre ouverte) : rayons + icône qui flotte
	local started = os.clock()
	animation = RunService.RenderStepped:Connect(function(dt: number)
		local t = os.clock() - started
		rays.Rotation = (rays.Rotation + dt * 16) % 360
		icon.Position = UDim2.new(0.5, 0, 0.56, math.sin(t * 2) * 3)
		icon.Rotation = math.sin(t * 1.3) * 5
	end)
end

-- Montre une offre si les règles le permettent
local function tryShow(): boolean
	if not allowed() then
		return false
	end
	local offer = chooseOffer()
	if not offer then
		return false
	end
	shownCount += 1
	lastShown = os.clock()
	shownIds[offer.Def.Id] = true
	intent = nil
	show(offer)
	return true
end

----------------------------------------------------------------------
-- API
----------------------------------------------------------------------

function OfferPopup.Build(parent: Frame)
	layer = parent
	sessionStart = os.clock()

	-- Une fenêtre s'ouvre (ou "Pas assez de Dopamine") : l'offre s'efface
	PanelManager.Opened:Connect(close)
	NeedDopamine.Shown:Connect(close)
	NeedDopamine.Refused:Connect(function(missing: number)
		intent = { Kind = "Refused", At = os.clock(), Missing = missing }
	end)
	ClientState.NotifyReceived:Connect(function(payload)
		if type(payload) == "table" and payload.Type == "Detox" then
			quietUntil = os.clock() + DETOX_QUIET
			close()
		end
	end)

	-- Surveillance légère : fin de rush / de boost, puis essai périodique
	task.spawn(function()
		local rushWasActive = false
		local boostWasActive = false
		local periodic = 0
		while layer do
			task.wait(CHECK_EVERY)
			local rush = ClientState.Rush
			local rushActive = rush ~= nil and rush.Active == true and (tonumber(rush.EndsAt) or 0) > workspace:GetServerTimeNow()
			if rushWasActive and not rushActive then
				intent = { Kind = "RushEnded", At = os.clock() }
				task.delay(AFTER_EVENT_DELAY, tryShow)
			end
			rushWasActive = rushActive
			local _, remaining = ClientState.GetBoost()
			local boostActive = remaining > 0
			if boostWasActive and not boostActive then
				intent = { Kind = "BoostEnded", At = os.clock() }
				task.delay(AFTER_EVENT_DELAY, tryShow)
			end
			boostWasActive = boostActive
			periodic += CHECK_EVERY
			if periodic >= PERIODIC_EVERY then
				periodic = 0
				tryShow()
			end
		end
	end)
end

function OfferPopup.IsVisible(): boolean
	return current ~= nil
end

function OfferPopup.Close()
	close()
end

-- Aperçu (Studio / tests) : montre une offre du genre demandé SANS les règles
-- de fréquence ; "Boost" | "Pass" | "Dopamine"
function OfferPopup.Preview(kind: string?)
	local offer: Offer?
	if kind == "Pass" then
		offer = makeOffer("X2", true, "New here? Double all your gains, forever.")
	elseif kind == "Dopamine" then
		offer = makeOffer(packFor(0) or "PackM", false, "Short on Dopamine earlier? A pack gets you there right away.")
	else
		offer = makeOffer("Boost2", false, "The Dopamine Rush is over. Want to keep that pace a little longer?")
	end
	if offer then
		show(offer)
	end
end

-- Offre affichée (nil si aucune) — pour les tests
function OfferPopup.GetCurrent(): any
	return currentOffer and currentOffer.Def or nil
end

return OfferPopup
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">OfflinePopup</string>
            <string name="Source"><![CDATA[--[[
	OfflinePopup (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > OfflinePopup

	Fenêtre "Bon retour !" affichée quand le serveur envoie
	Notify { Type = "Offline", Amount, Seconds, Rate, MaxSeconds } :
	  - petite scène de nuit animée (lune, étoiles, "Zzz") ;
	  - durée de l'absence, gain (compteur qui défile), taux et durée max ;
	  - jauge "temps comptabilisé" (plafond atteint ou non) ;
	  - astuce "Améliore Mode veille 😴" (si ce n'est pas déjà au maximum) ;
	  - gros bouton "Récupérer" (le gain est DÉJÀ donné par le serveur : le
	    bouton ferme juste la fenêtre, avec des confettis).
	Attend que l'écran de chargement ait disparu avant de s'ouvrir.
	La fenêtre vit dans le calque Toasts (au-dessus des panneaux, sous les
	effets pour que les confettis passent devant).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Client = script.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local ClientState = require(Client.ClientState)
local Effects = require(Client.Effects)
local SoundManager = require(Client.SoundManager)
local Interface = require(Client.Interface)
local LoadingScreen = require(script.Parent.LoadingScreen)
local Config = require(ReplicatedStorage.Shared.Config)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Signal = require(ReplicatedStorage.Shared.Signal)
local Locale = require(ReplicatedStorage.Shared.Locale)

local OfflinePopup = {}

OfflinePopup.Closed = Signal.new() -- () : la fenêtre vient de se fermer

local CARD_SIZE = Vector2.new(470, 470)
local SKY_HEIGHT = 150
local NIGHT_TOP = Color3.fromRGB(38, 40, 92)
local NIGHT_BOTTOM = Color3.fromRGB(112, 82, 170)
local MOON = Color3.fromRGB(255, 236, 170)

local layer: Frame? = nil
local current: Frame? = nil -- fenêtre affichée
local renderConnection: RBXScriptConnection? = nil
local showToken = 0

-- Amélioration "Mode veille" (Effect = "Offline")
local function sleepUpgrade()
	for _, upgrade in ipairs(Config.Upgrades) do
		if upgrade.Effect == "Offline" then
			return upgrade
		end
	end
	return nil
end

local function stopAnimation()
	local connection = renderConnection
	if connection then
		connection:Disconnect()
		renderConnection = nil
	end
end

function OfflinePopup.Build(parent: Frame)
	layer = parent
end

function OfflinePopup.IsVisible(): boolean
	return current ~= nil
end

-- Ferme la fenêtre (avec ou sans fête)
local function close(celebrate: boolean)
	local window = current
	if not window then
		return
	end
	current = nil
	stopAnimation()
	local card = window:FindFirstChild("Card") :: Frame?
	local dimmer = window:FindFirstChild("Dimmer") :: GuiObject?
	if celebrate then
		SoundManager.Play("Jackpot", 1)
		task.delay(0.1, SoundManager.Play, "Cash", 1.2)
		Effects.Confetti(110)
		local effects = Effects.GetLayer()
		if effects and card then
			local center = Interface.GetCanvasCenter(card)
			Effects.Burst(effects, UDim2.fromOffset(center.X, center.Y + 150), Theme.Colors.Gold, 20)
		end
	else
		SoundManager.Play("Open", 0.9)
	end
	if dimmer then
		UIUtil.Tween(dimmer, 0.25, { BackgroundTransparency = 1 })
	end
	if card then
		local scale = card:FindFirstChildOfClass("UIScale")
		if scale then
			UIUtil.Tween(scale, 0.25, { Scale = 0.85 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		end
		local group = card:FindFirstChild("Fade") :: CanvasGroup?
		if group then
			UIUtil.Tween(group, 0.25, { GroupTransparency = 1 })
		end
	end
	task.delay(0.3, function()
		window:Destroy()
	end)
	OfflinePopup.Closed:Fire()
end

-- Petite étiquette arrondie "icône + texte" (taux, durée max, niveau)
local function infoChip(parent: Instance, icon: string, title: string, value: string, color: Color3, order: number)
	local chip = UIUtil.Create("Frame", {
		Name = "Info" .. order,
		Size = UDim2.new(1 / 3, -8, 1, 0),
		BackgroundColor3 = color:Lerp(Color3.new(1, 1, 1), 0.88),
		LayoutOrder = order,
		Parent = parent,
	})
	UIUtil.Corner(chip, Theme.Radius.M)
	UIUtil.Stroke(chip, color, 1.5, 0.55)
	UIUtil.Label({
		Text = icon .. " " .. title,
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, -12, 0, 16),
		Position = UDim2.fromOffset(6, 7),
		MaxTextSize = 13,
		Parent = chip,
	})
	UIUtil.Label({
		Text = value,
		Font = Theme.Fonts.Number,
		TextColor3 = color:Lerp(Color3.new(0, 0, 0), 0.35),
		Size = UDim2.new(1, -12, 0, 22),
		Position = UDim2.fromOffset(6, 24),
		MaxTextSize = 20,
		Parent = chip,
	})
end

-- Scène de nuit : dégradé, lune en croissant, étoiles qui scintillent, "Zzz"
local function buildSky(card: Frame): { twinkle: { TextLabel }, zzz: { TextLabel }, moon: Frame }
	local sky = UIUtil.Create("Frame", {
		Name = "Sky",
		Size = UDim2.new(1, 0, 0, SKY_HEIGHT),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ClipsDescendants = true,
		ZIndex = 2,
		Parent = card,
	})
	UIUtil.Corner(sky, 26)
	UIUtil.Gradient(sky, ColorSequence.new(NIGHT_TOP, NIGHT_BOTTOM), 90)
	-- Bas du ciel à angles droits (seuls les coins du haut sont arrondis)
	UIUtil.Create("Frame", {
		Name = "Filler",
		Size = UDim2.new(1, 0, 0, 30),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		BackgroundColor3 = NIGHT_BOTTOM,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = sky,
	})

	-- Collines douces en bas de la scène
	for index, info in ipairs({
		{ X = 0.15, W = 300, Color = Color3.fromRGB(80, 60, 140) },
		{ X = 0.8, W = 340, Color = Color3.fromRGB(70, 52, 128) },
	}) do
		local hill = UIUtil.Create("Frame", {
			Name = "Hill" .. index,
			Size = UDim2.fromOffset(info.W, 120),
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(info.X, 0, 1, -34 - index * 4),
			BackgroundColor3 = info.Color,
			BorderSizePixel = 0,
			ZIndex = 3,
			Parent = sky,
		})
		UIUtil.Corner(hill, UDim.new(0.5, 0))
	end

	-- Lune (croissant : un disque clair "mordu" par un disque couleur ciel)
	local moon = UIUtil.Create("Frame", {
		Name = "Moon",
		Size = UDim2.fromOffset(70, 70),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 66),
		BackgroundColor3 = MOON,
		ZIndex = 4,
		Parent = sky,
	})
	UIUtil.Corner(moon, UDim.new(1, 0))
	UIUtil.Gradient(moon, ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(230, 220, 200)), 45)
	local glow = UIUtil.Create("Frame", {
		Name = "Glow",
		Size = UDim2.fromOffset(130, 130),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundColor3 = MOON,
		BackgroundTransparency = 0.82,
		ZIndex = 3,
		Parent = moon,
	})
	UIUtil.Corner(glow, UDim.new(1, 0))
	local bite = UIUtil.Create("Frame", {
		Name = "Bite",
		Size = UDim2.fromOffset(58, 58),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 20, 0.5, -12),
		BackgroundColor3 = NIGHT_TOP:Lerp(NIGHT_BOTTOM, 0.35),
		ZIndex = 5,
		Parent = moon,
	})
	UIUtil.Corner(bite, UDim.new(1, 0))
	-- Petits cratères
	for _, crater in ipairs({ { 0.3, 0.35, 9 }, { 0.22, 0.62, 6 }, { 0.42, 0.78, 7 } }) do
		local dot = UIUtil.Create("Frame", {
			Size = UDim2.fromOffset(crater[3], crater[3]),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(crater[1], crater[2]),
			BackgroundColor3 = Color3.fromRGB(230, 205, 140),
			BackgroundTransparency = 0.25,
			ZIndex = 5,
			Parent = moon,
		})
		UIUtil.Corner(dot, UDim.new(1, 0))
	end

	-- Étoiles
	local random = Random.new(7)
	local twinkle = {}
	for index = 1, 14 do
		local star = UIUtil.Label({
			Name = "Star" .. index,
			Text = index % 4 == 0 and "⭐" or "•",
			TextColor3 = Color3.fromRGB(255, 250, 220),
			Size = UDim2.fromOffset(16, 16),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(random:NextNumber(0.04, 0.96), 0, 0, random:NextInteger(10, 100)),
			MaxTextSize = index % 4 == 0 and 16 or 12,
			ZIndex = 3,
			Parent = sky,
		})
		star:SetAttribute("Phase", random:NextNumber(0, math.pi * 2))
		table.insert(twinkle, star)
	end

	-- "Zzz" qui s'envolent de la lune
	local zzz = {}
	for index = 1, 3 do
		local label = UIUtil.Label({
			Name = "Z" .. index,
			Text = "z",
			Font = Theme.Fonts.Title,
			TextColor3 = Color3.new(1, 1, 1),
			Size = UDim2.fromOffset(24, 24),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 44, 0, 50),
			MaxTextSize = 22,
			ZIndex = 6,
			Parent = sky,
		})
		label:SetAttribute("Phase", (index - 1) / 3)
		table.insert(zzz, label)
	end
	return { twinkle = twinkle, zzz = zzz, moon = moon }
end

-- Construit et affiche la fenêtre
local function build(payload)
	local parent = layer
	if not parent then
		return
	end
	-- Une seule fenêtre : la nouvelle remplace l'ancienne
	if current then
		local old = current
		current = nil
		stopAnimation()
		old:Destroy()
	end

	local amount = math.max(0, tonumber(payload.Amount) or 0)
	local seconds = math.max(0, tonumber(payload.Seconds) or 0)
	local offlineState = ClientState.Data and ClientState.Data.Offline
	local rate = tonumber(payload.Rate) or (type(offlineState) == "table" and tonumber(offlineState.Rate)) or Config.Offline.BaseRate
	local maxSeconds = tonumber(payload.MaxSeconds)
		or (type(offlineState) == "table" and tonumber(offlineState.MaxSeconds))
		or Config.Offline.BaseMaxHours * 3600
	maxSeconds = math.max(1, maxSeconds)
	local counted = math.min(seconds, maxSeconds)
	local capped = seconds > maxSeconds

	local window = UIUtil.Create("Frame", {
		Name = "OfflinePopup",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 40,
		Parent = parent,
	})
	current = window

	-- Fond assombri (un clic dehors = Récupérer aussi)
	local dimmer = UIUtil.Create("TextButton", {
		Name = "Dimmer",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(12, 10, 30),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 1,
		Parent = window,
	})
	UIUtil.Tween(dimmer, 0.3, { BackgroundTransparency = 0.4 })

	local card = UIUtil.Create("Frame", {
		Name = "Card",
		Size = UDim2.fromOffset(CARD_SIZE.X, CARD_SIZE.Y),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = window,
	})
	-- Tient dans 94 % de l'écran (téléphone)
	local canvas = Interface.CanvasSize
	local fit = math.min(1, canvas.X * 0.94 / CARD_SIZE.X, canvas.Y * 0.94 / CARD_SIZE.Y)
	local cardScale = UIUtil.Create("UIScale", { Scale = 0.7 * fit, Parent = card })
	UIUtil.Tween(cardScale, 0.45, { Scale = fit }, Enum.EasingStyle.Back)

	-- Tout le contenu dans un CanvasGroup (fondu d'ensemble à la fermeture)
	local fade = UIUtil.Create("CanvasGroup", {
		Name = "Fade",
		Size = UDim2.new(1, 24, 1, 24),
		Position = UDim2.fromOffset(-12, -12),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = card,
	})
	local body = UIUtil.Create("Frame", {
		Name = "Body",
		Size = UDim2.new(1, -24, 1, -24),
		Position = UDim2.fromOffset(12, 10),
		BackgroundColor3 = Theme.Colors.Panel,
		Active = true,
		ZIndex = 2,
		Parent = fade,
	})
	UIUtil.Corner(body, 26)
	UIUtil.SinkClicks(body) -- clic dans la carte : ne ferme pas
	UIUtil.Stroke(body, Theme.Colors.CardBorder, 1.5, 0.3)
	UIUtil.Shadow(body, 6, 0.8, 3)

	local sky = buildSky(body)

	-- Titre et durée
	UIUtil.Label({
		Name = "Title",
		Text = Locale.T("Welcome back!"),
		Font = Theme.Fonts.Title,
		Size = UDim2.new(1, -40, 0, 34),
		Position = UDim2.fromOffset(20, SKY_HEIGHT + 12),
		MaxTextSize = 30,
		ZIndex = 3,
		Parent = body,
	})
	UIUtil.Label({
		Name = "Away",
		Text = Locale.T("You were away for %s", NumberFormatter.Time(seconds)),
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, -40, 0, 20),
		Position = UDim2.fromOffset(20, SKY_HEIGHT + 46),
		MaxTextSize = 16,
		ZIndex = 3,
		Parent = body,
	})

	-- Gain (compteur qui défile)
	local amountRow = UIUtil.Create("Frame", {
		Name = "AmountRow",
		Size = UDim2.new(1, -40, 0, 50),
		Position = UDim2.fromOffset(20, SKY_HEIGHT + 70),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = body,
	})
	local amountLabel = UIUtil.Label({
		Name = "Amount",
		Text = "+0",
		Font = Theme.Fonts.Number,
		TextColor3 = Color3.new(1, 1, 1),
		Size = UDim2.new(1, 0, 0, 44),
		MaxTextSize = 44,
		ZIndex = 4,
		Parent = amountRow,
	})
	UIUtil.Gradient(amountLabel, ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 200, 40)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(235, 120, 20)),
	}), 90)
	local amountStroke = UIUtil.Stroke(amountLabel, Color3.fromRGB(120, 60, 0), 1.5, 0.55)
	amountStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	UIUtil.Label({
		Name = "Unit",
		Text = Locale.T("%s earned while you were away 💧", Locale.T(Config.Game.CurrencyName)),
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, -40, 0, 18),
		Position = UDim2.fromOffset(20, SKY_HEIGHT + 118),
		MaxTextSize = 15,
		ZIndex = 3,
		Parent = body,
	})

	-- Taux / durée max / niveau du Mode veille
	local upgrade = sleepUpgrade()
	local level = upgrade and ClientState.GetLevel(upgrade.Id) or 0
	local maxLevel = upgrade and upgrade.MaxLevel or nil
	local chips = UIUtil.Create("Frame", {
		Name = "Chips",
		Size = UDim2.new(1, -40, 0, 50),
		Position = UDim2.fromOffset(20, SKY_HEIGHT + 144),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = body,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = chips,
	})
	local sleepName = Locale.T(upgrade and upgrade.Name or "Sleep Mode")
	infoChip(chips, "⚡", Locale.T("Rate"), tostring(math.floor(rate * 100 + 0.5)) .. " %", Theme.Colors.Orange, 1)
	infoChip(chips, "⏳", Locale.T("Max duration"), NumberFormatter.Time(maxSeconds), Theme.Colors.Blue, 2)
	infoChip(chips, upgrade and upgrade.Icon or "😴", sleepName, Locale.T("Lv. %s", tostring(level)), Theme.Colors.Purple, 3)

	-- Jauge : temps comptabilisé / durée max
	-- (v9 : un peu remonté : l'astuce ne passe plus sous le bouton "Récupérer")
	local gaugeY = SKY_HEIGHT + 198
	UIUtil.Label({
		Name = "GaugeText",
		Text = Locale.T(
			capped and "⚠️ Limit reached: %s / %s" or "Time counted: %s / %s",
			NumberFormatter.Time(counted),
			NumberFormatter.Time(maxSeconds)
		),
		TextColor3 = capped and Theme.Colors.Red or Theme.Colors.TextDim,
		Font = Theme.Fonts.Title,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -40, 0, 16),
		Position = UDim2.fromOffset(20, gaugeY),
		MaxTextSize = 13,
		ZIndex = 3,
		Parent = body,
	})
	local gauge = UIUtil.Create("Frame", {
		Name = "Gauge",
		Size = UDim2.new(1, -40, 0, 10),
		Position = UDim2.fromOffset(20, gaugeY + 20),
		BackgroundColor3 = Theme.Colors.PanelLight,
		ZIndex = 3,
		Parent = body,
	})
	UIUtil.Corner(gauge, UDim.new(1, 0))
	UIUtil.Stroke(gauge, Theme.Colors.Divider, 1)
	local fill = UIUtil.Create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 4,
		Parent = gauge,
	})
	UIUtil.Corner(fill, UDim.new(1, 0))
	UIUtil.Gradient(fill, ColorSequence.new(Theme.Colors.Purple, capped and Theme.Colors.Red or Theme.Colors.Cyan), 0)
	UIUtil.Tween(fill, 1.2, { Size = UDim2.fromScale(math.clamp(counted / maxSeconds, 0.02, 1), 1) }, Enum.EasingStyle.Quint)

	-- Astuce (cachée si Mode veille est au max)
	local canUpgrade = upgrade ~= nil and (maxLevel == nil or level < maxLevel)
	if canUpgrade then
		UIUtil.Label({
			Name = "Hint",
			Text = Locale.T("💡 Upgrade %s 😴 to earn more while you're away", sleepName),
			TextColor3 = Theme.Colors.Purple,
			Font = Theme.Fonts.Title,
			Size = UDim2.new(1, -40, 0, 16),
			Position = UDim2.fromOffset(20, gaugeY + 35),
			MaxTextSize = 14,
			ZIndex = 3,
			Parent = body,
		})
	end

	-- Bouton "Récupérer"
	local button = UIUtil.NeonButton({
		Name = "Collect",
		Text = Locale.T("Collect"),
		Color = Theme.Colors.Green,
		TextColor3 = Theme.Colors.TextDark,
		Size = UDim2.new(1, -80, 0, 48),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -18),
		CornerRadius = 24,
		MaxTextSize = 24,
		ZIndex = 4,
		Parent = body,
	})
	local shine = UIUtil.Create("Frame", {
		Name = "Shine",
		Size = UDim2.new(0, 36, 1, 20),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(-0.2, 0, 0.5, 0),
		Rotation = 20,
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.55,
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = button,
	})
	button.ClipsDescendants = true

	local collected = false
	local function collect()
		if collected or current ~= window then
			return
		end
		collected = true
		close(true)
	end
	button.Activated:Connect(collect)
	dimmer.Activated:Connect(collect)

	SoundManager.Play("Achievement", 0.9)

	-- Animations : compteur, étoiles, "Zzz", lune, reflet du bouton
	local started = os.clock()
	local lastShown = ""
	stopAnimation()
	renderConnection = RunService.RenderStepped:Connect(function()
		if not window.Parent then
			stopAnimation()
			return
		end
		local t = os.clock() - started
		-- Compteur (ease-out sur 1,3 s)
		local progress = math.clamp(t / 1.3, 0, 1)
		local eased = 1 - (1 - progress) ^ 3
		local text = "+" .. NumberFormatter.Format(amount * eased)
		if text ~= lastShown then
			lastShown = text
			amountLabel.Text = text
		end
		for _, star in ipairs(sky.twinkle) do
			local phase = star:GetAttribute("Phase") or 0
			star.TextTransparency = 0.35 + 0.45 * (0.5 + 0.5 * math.sin(t * 2.2 + phase))
		end
		for _, label in ipairs(sky.zzz) do
			local phase = ((label:GetAttribute("Phase") or 0) + t * 0.35) % 1
			label.Position = UDim2.new(0.5, 44 + phase * 46, 0, 48 - phase * 44)
			label.TextTransparency = phase < 0.15 and (1 - phase / 0.15) or math.clamp((phase - 0.6) / 0.4, 0, 1)
			label.Rotation = math.sin(phase * math.pi * 2) * 12
		end
		sky.moon.Position = UDim2.new(0.5, 0, 0, 66 + math.sin(t * 1.3) * 4)
		-- Reflet qui traverse le bouton toutes les 2,5 s
		local sweep = (t % 2.5) / 0.9
		shine.Position = UDim2.new(-0.2 + math.clamp(sweep, 0, 1) * 1.4, 0, 0.5, 0)
	end)
end

-- Affiche la fenêtre pour une notification "Offline" (après l'écran de chargement)
function OfflinePopup.Show(payload)
	if type(payload) ~= "table" or (tonumber(payload.Amount) or 0) <= 0 then
		return
	end
	showToken += 1
	local token = showToken
	task.spawn(function()
		local waited = 0
		while LoadingScreen.IsVisible() and waited < 20 do
			waited += task.wait(0.2)
		end
		-- (laisse l'écran de chargement finir son fondu)
		if waited > 0 then
			task.wait(0.5)
		end
		if token ~= showToken then
			return -- une notification plus récente a pris le relais
		end
		build(payload)
	end)
end

return OfflinePopup
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">PanelManager</string>
            <string name="Source"><![CDATA[--[[
	PanelManager (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > PanelManager

	Fenêtres "pop-up" (boutique, succès, quêtes, classement...). Une seule
	ouverte à la fois, avec fond assombri (clic dehors = fermer) et
	transitions douces (fondu du fond + glissement / zoom de la fenêtre).
	Style clair : fenêtre blanche, contour fin, ombre douce, en-tête avec
	pastille d'icône colorée, titre, sous-titre optionnel et bouton ✕.

	Chaque panneau est un module dans Components > Panels avec :
	  Title, Color, Build(content), Update(data) (optionnel),
	  RefreshOnTick (optionnel : true = Update aussi sur les petites mises à jour,
	  2 fois par seconde au plus, quand la fenêtre est ouverte),
	  OnOpen() / OnClose() (optionnels), Size (Vector2, optionnel),
	  Icon (optionnel : sinon le 1er emoji du titre), Subtitle (optionnel).
	v5 : Title / Subtitle sont écrits en ANGLAIS dans les modules et traduits
	ici (Locale.T) à l'ouverture. La fenêtre tient toujours dans 94 % de
	l'écran (ex. téléphone) : un peu réduite (jusqu'à 90 %), puis moins
	haute ; le contenu est alors raccourci (ses listes défilent déjà) ou,
	pour un panneau à mise en page fixe (Module.FixedLayout = true), il
	défile dans la fenêtre. Le mode sombre est appliqué par DarkSkin.
	Maison : un panneau peut donner sa taille selon l'écran avec
	Module.GetSize() (Vector2, relu à l'ouverture et quand l'écran change).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local Interface = require(Client.Interface)
local ClientState = require(Client.ClientState)
local SoundManager = require(Client.SoundManager)
local Signal = require(ReplicatedStorage.Shared.Signal)
local Locale = require(ReplicatedStorage.Shared.Locale)

local PanelManager = {}

PanelManager.Opened = Signal.new() -- (name)
PanelManager.Closed = Signal.new() -- (name)

local DEFAULT_SIZE = Vector2.new(640, 500)
local HEADER_HEIGHT = 66
local VIEWPORT_MARGIN = 3 -- (px) marge autour du contenu : contours des cartes au bord jamais coupés
local DIM_TRANSPARENCY = 0.45
local SCREEN_FIT = 0.94 -- la fenêtre occupe au plus 94 % de l'écran
local MIN_FIT_SCALE = 0.9 -- réduction max avant de raccourcir la fenêtre

local overlay: Frame
local dimmer: TextButton
local holder: Frame -- support (taille de la fenêtre) : porte l'ombre et l'animation
local holderScale: UIScale
local window: Frame
local iconBadge: Frame
local iconLabel: TextLabel
local titleLabel: TextLabel
local subtitleLabel: TextLabel
local accentLine: Frame
local panels = {} -- [nom] = { Module, Content, Viewport }
local openName: string? = nil
local closeToken = 0
local fitScale = 1 -- réduction pour tenir dans l'écran (1 = taille normale)
local currentSize = DEFAULT_SIZE

-- Place de la fenêtre dans 94 % de la toile : (échelle, hauteur visible).
-- Trop large : on réduit (UIScale). Trop haute : petite réduction si l'écart
-- est faible, sinon la fenêtre est moins haute et son contenu défile.
local function computeFit(size: Vector2): (number, number)
	local canvas = Interface.CanvasSize
	if canvas.X < 1 or canvas.Y < 1 then
		return 1, size.Y
	end
	local scale = math.min(1, canvas.X * SCREEN_FIT / size.X)
	local ratio = canvas.Y * SCREEN_FIT / (size.Y * scale)
	if ratio >= 1 then
		return scale, size.Y
	end
	scale *= math.max(ratio, MIN_FIT_SCALE)
	return scale, math.min(size.Y, math.floor(canvas.Y * SCREEN_FIT / scale))
end

-- Taille de la fenêtre + zone de défilement du contenu du panneau `name`
local function applyFit(name: string?)
	local visibleHeight
	fitScale, visibleHeight = computeFit(currentSize)
	holder.Size = UDim2.fromOffset(currentSize.X, visibleHeight)
	local panel = name and panels[name]
	if panel then
		local shortened = visibleHeight < currentSize.Y
		-- Mise en page fixe : le contenu garde sa hauteur et défile ;
		-- sinon il est raccourci (ses propres listes défilent)
		local scrolls = shortened and panel.Module.FixedLayout == true
		local contentHeight = (scrolls and currentSize.Y or visibleHeight) - (HEADER_HEIGHT + 22)
		panel.Content.Size = UDim2.new(1, 0, 0, contentHeight)
		local viewport = panel.Viewport :: ScrollingFrame
		viewport.CanvasSize = UDim2.fromOffset(0, contentHeight + VIEWPORT_MARGIN * 2)
		viewport.ScrollingEnabled = scrolls
		viewport.ScrollBarThickness = scrolls and 6 or 0
		if not scrolls then
			viewport.CanvasPosition = Vector2.zero
		end
	end
end

-- Taille voulue d'un panneau : GetSize() (selon l'écran) sinon Size
local function moduleSize(module): Vector2
	if type(module.GetSize) == "function" then
		local ok, size = pcall(module.GetSize)
		if ok and typeof(size) == "Vector2" then
			return size
		end
	end
	return module.Size or DEFAULT_SIZE
end

local function callOnClose(name: string)
	local panel = panels[name]
	if panel and panel.Module.OnClose then
		pcall(panel.Module.OnClose)
	end
end

-- "🏆 Succès" -> ("🏆", "Succès") ; "Classement" -> (nil, "Classement")
local function splitTitle(title: string): (string?, string)
	local first, rest = string.match(title, "^(%S+)%s+(.+)$")
	if first and rest and not string.find(first, "%w") then
		return first, rest
	end
	return nil, title
end

-- Met l'en-tête aux couleurs du panneau
local function applyHeader(module, name: string)
	local icon, text = splitTitle(Locale.T(tostring(module.Title or name)))
	icon = module.Icon or icon
	local color: Color3 = module.Color or Theme.Colors.Blue

	iconBadge.Visible = icon ~= nil
	iconLabel.Text = icon or ""
	iconBadge.BackgroundColor3 = color
	local badgeStroke = iconBadge:FindFirstChild("BadgeStroke")
	if badgeStroke and badgeStroke:IsA("UIStroke") then
		badgeStroke.Color = UIUtil.EdgeColor(color)
	end
	titleLabel.Text = text

	local left = icon and 76 or 26
	local subtitle = module.Subtitle
	if type(subtitle) == "string" and subtitle ~= "" then
		subtitleLabel.Visible = true
		subtitleLabel.Text = Locale.T(subtitle)
		titleLabel.Position = UDim2.fromOffset(left, 12)
		titleLabel.Size = UDim2.new(1, -(left + 70), 0, 28)
		subtitleLabel.Position = UDim2.fromOffset(left, 40)
		subtitleLabel.Size = UDim2.new(1, -(left + 70), 0, 18)
	else
		subtitleLabel.Visible = false
		titleLabel.Position = UDim2.fromOffset(left, 17)
		titleLabel.Size = UDim2.new(1, -(left + 70), 0, 32)
	end

	-- Liseré sous l'en-tête : couleur du panneau qui s'estompe sur les côtés
	accentLine.BackgroundColor3 = color
end

function PanelManager.Build(layer: Frame)
	overlay = UIUtil.Create("Frame", {
		Name = "PanelOverlay",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 10,
		Parent = layer,
	})

	-- Fond sombre plein écran (bouton : un clic dehors ferme la fenêtre)
	dimmer = UIUtil.Create("TextButton", {
		Name = "Dimmer",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(10, 10, 20),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 1,
		Parent = overlay,
	})
	dimmer.Activated:Connect(function()
		PanelManager.Close()
	end)

	holder = UIUtil.Create("Frame", {
		Name = "WindowHolder",
		Size = UDim2.fromOffset(DEFAULT_SIZE.X, DEFAULT_SIZE.Y),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = overlay,
	})
	holderScale = UIUtil.Create("UIScale", { Parent = holder })

	window = UIUtil.Create("Frame", {
		Name = "Window",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Colors.Panel,
		Active = true, -- bloque les clics pour qu'ils n'atteignent pas le fond sombre
		ZIndex = 3,
		Parent = holder,
	})
	UIUtil.Corner(window, Theme.Radius.XL)
	UIUtil.Stroke(window, Theme.Colors.CardBorder, 1.5, 0.1)
	UIUtil.Shadow(window, 10, 0.72, 6)
	-- Un clic sur une zone vide de la fenêtre ne ferme plus rien (seul un clic dehors ferme)
	UIUtil.SinkClicks(window)

	-- En-tête : pastille d'icône, titre, sous-titre
	iconBadge = UIUtil.Create("Frame", {
		Name = "IconBadge",
		Size = UDim2.fromOffset(42, 42),
		Position = UDim2.fromOffset(22, 12),
		BackgroundColor3 = Theme.Colors.Blue,
		ZIndex = 4,
		Parent = window,
	})
	UIUtil.Corner(iconBadge, Theme.Radius.M)
	-- v9 : pastille en relief (dégradé, reflet, contour teinté)
	local badgeStroke = UIUtil.Stroke(iconBadge, UIUtil.EdgeColor(Theme.Colors.Blue), 1.5, 0)
	badgeStroke.Name = "BadgeStroke"
	UIUtil.Gradient(iconBadge, UIUtil.ButtonShading, 90)
	UIUtil.Gloss(iconBadge, 0.5)
	iconLabel = UIUtil.Label({
		Size = UDim2.new(1, -8, 1, -8),
		Position = UDim2.fromOffset(4, 4),
		MaxTextSize = 26,
		ZIndex = 5,
		Parent = iconBadge,
	})

	titleLabel = UIUtil.Label({
		Name = "Title",
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.Text,
		Size = UDim2.new(1, -146, 0, 32),
		Position = UDim2.fromOffset(76, 17),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = Theme.TextSize.Title,
		ZIndex = 4,
		Parent = window,
	})
	subtitleLabel = UIUtil.Label({
		Name = "Subtitle",
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, -146, 0, 18),
		Position = UDim2.fromOffset(76, 40),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = Theme.TextSize.Caption + 1,
		Visible = false,
		ZIndex = 4,
		Parent = window,
	})

	-- ✕ commun (UIUtil.CloseButton) + zone tactile agrandie (téléphone / tablette)
	UIUtil.CloseButton({
		Name = "Close",
		Size = 40,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 13),
		ZIndex = 4,
		Hitbox = 64,
		Parent = window,
		OnClose = function()
			PanelManager.Close()
		end,
	})
	local closeHitbox = window:FindFirstChild("CloseHitbox") :: GuiObject?
	if closeHitbox then
		closeHitbox.Visible = Interface.IsTouch()
	end

	-- L'écran change (rotation, fenêtre redimensionnée) : la fenêtre ouverte se réajuste
	Interface.ScaleChanged:Connect(function()
		if closeHitbox then
			closeHitbox.Visible = Interface.IsTouch()
		end
		if openName then
			local panel = panels[openName]
			if panel then
				currentSize = moduleSize(panel.Module)
			end
			applyFit(openName)
			holderScale.Scale = fitScale
		end
	end)

	-- Séparateur + liseré de couleur
	UIUtil.Create("Frame", {
		Name = "Divider",
		Size = UDim2.new(1, -40, 0, 1),
		Position = UDim2.fromOffset(20, HEADER_HEIGHT),
		BackgroundColor3 = Theme.Colors.Divider,
		BorderSizePixel = 0,
		ZIndex = 4,
		Parent = window,
	})
	accentLine = UIUtil.Create("Frame", {
		Name = "Accent",
		Size = UDim2.new(0, 120, 0, 3),
		Position = UDim2.fromOffset(22, HEADER_HEIGHT - 1),
		BackgroundColor3 = Theme.Colors.Blue,
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = window,
	})
	UIUtil.Corner(accentLine, 2)
	UIUtil.Create("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.6, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = accentLine,
	})

	ClientState.Changed:Connect(function(data)
		for name, panel in pairs(panels) do
			if panel.Module.Update then
				local ok, err = pcall(panel.Module.Update, data)
				if not ok then
					warn("[PanelManager] Erreur dans " .. name .. ".Update : " .. tostring(err))
				end
			end
		end
	end)

	-- Entre deux états complets, le serveur n'envoie que de petites mises à
	-- jour (Dopamine, progression des quêtes...). La fenêtre OUVERTE qui le
	-- demande (Module.RefreshOnTick = true) est rafraîchie 2 fois par seconde au plus.
	local tickSignal = (ClientState :: any).TickReceived
	if tickSignal then
		local lastRefresh = 0
		tickSignal:Connect(function()
			local name = openName
			local panel = name and panels[name]
			if not panel or panel.Module.RefreshOnTick ~= true or not panel.Module.Update or not ClientState.Data then
				return
			end
			local now = os.clock()
			if now - lastRefresh < 0.5 then
				return
			end
			lastRefresh = now
			local ok, err = pcall(panel.Module.Update, ClientState.Data)
			if not ok then
				warn("[PanelManager] Erreur dans " .. tostring(name) .. ".Update : " .. tostring(err))
			end
		end)
	end
end

function PanelManager.Register(name: string, module)
	if type(module) ~= "table" or type(module.Build) ~= "function" then
		warn("[PanelManager] Panneau invalide : " .. tostring(name))
		return
	end
	-- Zone de défilement (utile seulement quand la fenêtre est moins haute
	-- que prévu, ex. téléphone) ; le contenu garde sa taille normale
	local size: Vector2 = module.Size or DEFAULT_SIZE
	-- (zone agrandie de VIEWPORT_MARGIN px de chaque côté + UIPadding : le contenu
	-- garde sa place, mais les contours des cartes collées au bord ne sont plus coupés)
	local viewport = UIUtil.Create("ScrollingFrame", {
		Name = name .. "Viewport",
		Size = UDim2.new(1, -40 + VIEWPORT_MARGIN * 2, 1, -(HEADER_HEIGHT + 22) + VIEWPORT_MARGIN * 2),
		Position = UDim2.fromOffset(20 - VIEWPORT_MARGIN, HEADER_HEIGHT + 10 - VIEWPORT_MARGIN),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollingEnabled = false,
		ScrollBarThickness = 0,
		ScrollBarImageColor3 = Theme.Colors.Dark,
		CanvasSize = UDim2.fromOffset(0, size.Y - (HEADER_HEIGHT + 22) + VIEWPORT_MARGIN * 2),
		ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
		Visible = false,
		ZIndex = 4,
		Parent = window,
	})
	UIUtil.Padding(viewport, VIEWPORT_MARGIN)
	local content = UIUtil.Create("Frame", {
		Name = name,
		Size = UDim2.new(1, 0, 0, size.Y - (HEADER_HEIGHT + 22)),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 4,
		Parent = viewport,
	})
	local ok, err = pcall(module.Build, content)
	if not ok then
		warn("[PanelManager] Erreur dans " .. name .. ".Build : " .. tostring(err))
	end
	panels[name] = { Module = module, Content = content, Viewport = viewport }
	-- Première mise à jour si l'état est déjà là
	if module.Update and ClientState.Data then
		pcall(module.Update, ClientState.Data)
	end
end

function PanelManager.IsRegistered(name: string): boolean
	return panels[name] ~= nil
end

function PanelManager.IsOpen(name: string?): boolean
	if name then
		return openName == name
	end
	return openName ~= nil
end

function PanelManager.Open(name: string)
	local panel = panels[name]
	if not panel then
		return
	end
	local previous = openName
	local wasVisible = overlay.Visible and previous ~= nil
	for otherName, other in pairs(panels) do
		other.Content.Visible = otherName == name
		other.Viewport.Visible = otherName == name
	end
	openName = name
	closeToken += 1
	applyHeader(panel.Module, name)
	currentSize = moduleSize(panel.Module)
	applyFit(name)
	panel.Viewport.CanvasPosition = Vector2.zero

	if panel.Module.Update and ClientState.Data then
		pcall(panel.Module.Update, ClientState.Data)
	end
	if panel.Module.OnOpen then
		pcall(panel.Module.OnOpen)
	end

	overlay.Visible = true
	if wasVisible then
		-- Changement de panneau : petit "pop" seulement
		holderScale.Scale = 0.97 * fitScale
		UIUtil.Tween(holderScale, 0.2, { Scale = fitScale }, Enum.EasingStyle.Back)
	else
		dimmer.BackgroundTransparency = 1
		UIUtil.Tween(dimmer, 0.25, { BackgroundTransparency = DIM_TRANSPARENCY })
		holderScale.Scale = 0.88 * fitScale
		holder.Position = UDim2.new(0.5, 0, 0.5, 26)
		UIUtil.Tween(holderScale, 0.32, { Scale = fitScale }, Enum.EasingStyle.Back)
		UIUtil.Tween(holder, 0.32, { Position = UDim2.fromScale(0.5, 0.5) }, Enum.EasingStyle.Quint)
	end
	SoundManager.Play("Open", 1)
	if previous and previous ~= name then
		callOnClose(previous)
		PanelManager.Closed:Fire(previous)
	end
	PanelManager.Opened:Fire(name)
end

function PanelManager.Close()
	local name = openName
	if not name then
		return
	end
	openName = nil
	callOnClose(name)
	closeToken += 1
	local token = closeToken
	UIUtil.Tween(dimmer, 0.18, { BackgroundTransparency = 1 })
	UIUtil.Tween(holderScale, 0.18, { Scale = 0.9 * fitScale }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	UIUtil.Tween(holder, 0.18, { Position = UDim2.new(0.5, 0, 0.5, 18) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(0.19, function()
		-- Rouvert entre-temps : on ne cache rien
		if token == closeToken and not openName then
			overlay.Visible = false
		end
	end)
	PanelManager.Closed:Fire(name)
end

-- Échelle actuelle de la fenêtre (1 = taille normale ; < 1 si réduite pour tenir à l'écran)
function PanelManager.GetFitScale(): number
	return fitScale
end

function PanelManager.Toggle(name: string)
	if openName == name then
		PanelManager.Close()
	else
		PanelManager.Open(name)
	end
end

return PanelManager
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="79">
          <Properties>
            <string name="Name">Panels</string>
          </Properties>
          <Item class="ModuleScript" referent="80">
            <Properties>
              <string name="Name">Achievements</string>
              <string name="Source"><![CDATA[--[[
	Achievements (ModuleScript) — panneau des succès
	Emplacement : ReplicatedStorage > Client > Components > Panels > Achievements

	Chaque succès est un MÉDAILLON (palier bronze / argent / or / diamant
	selon la taille de l'objectif, voir AchievementPopup.Tier) :
	  - débloqué : médaillon en couleur, "✔ Débloqué" et la récompense ;
	  - verrouillé : médaillon gris avec icône fantôme et cadenas, barre de
	    progression (valeur / objectif) ;
	  - pastille "🏅 Badge Roblox" quand le succès donne un vrai badge
	    (Config.Achievements[].BadgeId ~= 0).
	En-tête : progression globale, bonus permanent, nombre de badges.
	Onglets : Tous / Débloqués / À faire.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local AchievementPopup = require(script.Parent.Parent.AchievementPopup)
local Config = require(ReplicatedStorage.Shared.Config)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Locale = require(ReplicatedStorage.Shared.Locale)

-- Title / Subtitle en anglais : traduits par PanelManager
local Achievements = {
	Title = "🏆 Achievements",
	Subtitle = "Every achievement gives a permanent bonus",
	Color = Theme.Colors.Purple,
	Size = Vector2.new(760, 590),
}

type Item = {
	Achievement: any,
	Cell: Frame,
	Card: Frame,
	Stroke: UIStroke,
	Medallion: AchievementPopup.Medallion,
	Name: TextLabel,
	Status: TextLabel,
	Track: Frame,
	Fill: Frame,
	Done: boolean?,
}

local items: { Item } = {}
local filter = "All"
local summaryLabel: TextLabel
local progressFill: Frame
local bonusChip: Frame
local badgeChip: Frame

local function statValue(data, statName: string): number
	local value = data.Stats and data.Stats[statName]
	if value == nil then
		value = data[statName]
	end
	return (type(value) == "number") and value or 0
end

local function hasBadge(achievement): boolean
	return (tonumber(achievement.BadgeId) or 0) > 0
end

local function setChipText(chip: Frame, text: string)
	local label = chip:FindFirstChild("Label") :: TextLabel?
	if label then
		label.Text = text
	end
end

local function applyFilter()
	for _, item in ipairs(items) do
		local done = item.Done == true
		item.Cell.Visible = filter == "All" or (filter == "Done" and done) or (filter == "Todo" and not done)
	end
end

----------------------------------------------------------------------
-- Construction
----------------------------------------------------------------------

local function buildHeader(content: Frame)
	local header = UIUtil.Create("Frame", {
		Name = "Summary",
		Size = UDim2.new(1, 0, 0, 64),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = content,
	})
	UIUtil.Corner(header, Theme.Radius.L)
	UIUtil.Stroke(header, Theme.Colors.Purple, 1.5, 0.55)
	UIUtil.Gradient(header, ColorSequence.new(Color3.fromRGB(250, 244, 255), Color3.fromRGB(236, 222, 255)), 0)

	local trophy = UIUtil.Create("Frame", {
		Size = UDim2.fromOffset(44, 44),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		BackgroundColor3 = Theme.Colors.Purple,
		Parent = header,
	})
	UIUtil.Corner(trophy, UDim.new(1, 0))
	UIUtil.Gradient(trophy, ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(205, 205, 205)), 90)
	UIUtil.Label({
		Text = "🏆",
		Size = UDim2.new(1, -12, 1, -12),
		Position = UDim2.fromOffset(6, 6),
		MaxTextSize = 24,
		Parent = trophy,
	})

	summaryLabel = UIUtil.Label({
		Name = "Count",
		Font = Theme.Fonts.Title,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(0.5, -70, 0, 22),
		Position = UDim2.fromOffset(68, 10),
		MaxTextSize = 19,
		Parent = header,
	})
	local track = UIUtil.Create("Frame", {
		Name = "Progress",
		Size = UDim2.new(0.5, -70, 0, 10),
		Position = UDim2.fromOffset(68, 40),
		BackgroundColor3 = Color3.fromRGB(225, 215, 240),
		Parent = header,
	})
	UIUtil.Corner(track, UDim.new(1, 0))
	progressFill = UIUtil.Create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = track,
	})
	UIUtil.Corner(progressFill, UDim.new(1, 0))
	UIUtil.Gradient(progressFill, ColorSequence.new(Theme.Colors.Pink, Theme.Colors.Purple), 0)

	local chips = UIUtil.Create("Frame", {
		Name = "Chips",
		Size = UDim2.new(0.5, -12, 0, 26),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		BackgroundTransparency = 1,
		Parent = header,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = chips,
	})
	bonusChip = UIUtil.Chip({
		Text = "",
		Color = Theme.Colors.Purple,
		TextColor3 = Theme.Colors.TextLight,
		Height = 26,
		TextSize = 13,
		LayoutOrder = 1,
		Parent = chips,
	})
	badgeChip = UIUtil.Chip({
		Text = "",
		Color = Theme.Colors.Robux,
		TextColor3 = Theme.Colors.TextLight,
		Height = 26,
		TextSize = 13,
		LayoutOrder = 2,
		Visible = false,
		Parent = chips,
	})
end

local function buildItem(grid: ScrollingFrame, achievement, order: number)
	local tier = AchievementPopup.Tier(achievement)
	local cell = UIUtil.Create("Frame", {
		Name = tostring(achievement.Id),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = grid,
	})
	local card = UIUtil.Create("Frame", {
		Name = "Card",
		Size = UDim2.new(1, 0, 1, -4),
		Position = UDim2.fromOffset(0, 2),
		BackgroundColor3 = Theme.Colors.Card,
		ZIndex = 2,
		Parent = cell,
	})
	UIUtil.Corner(card, Theme.Radius.L)
	local stroke = UIUtil.Stroke(card, Theme.Colors.Divider, 1.5)

	-- Médaille SOUS les pastilles du haut (palier, badge Roblox) : rien ne se chevauche
	local medallion = AchievementPopup.Medallion(card, 56, achievement)
	medallion.Frame.AnchorPoint = Vector2.new(0.5, 0)
	medallion.Frame.Position = UDim2.new(0.5, 0, 0, 25)
	medallion.Frame.ZIndex = 3

	if hasBadge(achievement) then
		local badge = UIUtil.Chip({
			Name = "Badge",
			Text = Locale.T("🏅 Roblox Badge"),
			Color = Theme.Colors.Robux,
			TextColor3 = Theme.Colors.TextLight,
			Height = 18,
			TextSize = 10,
			ZIndex = 5,
			Parent = card,
		})
		badge.AnchorPoint = Vector2.new(1, 0)
		badge.Position = UDim2.new(1, -6, 0, 6)
	end
	local tierChip = UIUtil.Chip({
		Name = "Tier",
		Text = Locale.T(tier.Name),
		Color = tier.Bottom,
		TextColor3 = Theme.ContrastText(tier.Bottom),
		Height = 16,
		TextSize = 10,
		ZIndex = 5,
		Parent = card,
	})
	tierChip.Position = UDim2.fromOffset(6, 6)

	local name = UIUtil.Label({
		Name = "AchievementName",
		Text = Locale.T(tostring(achievement.Name)),
		Font = Theme.Fonts.Title,
		Size = UDim2.new(1, -12, 0, 20),
		Position = UDim2.fromOffset(6, 90),
		MaxTextSize = 15,
		ZIndex = 3,
		Parent = card,
	})
	local status = UIUtil.Label({
		Name = "Status",
		Text = "",
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, -12, 0, 15),
		Position = UDim2.fromOffset(6, 111),
		MaxTextSize = 12,
		ZIndex = 3,
		Parent = card,
	})
	local track = UIUtil.Create("Frame", {
		Name = "Track",
		Size = UDim2.new(1, -24, 0, 6),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		BackgroundColor3 = Theme.Colors.PanelLight,
		ZIndex = 3,
		Parent = card,
	})
	UIUtil.Corner(track, UDim.new(1, 0))
	local fill = UIUtil.Create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = tier.Bottom,
		BorderSizePixel = 0,
		ZIndex = 4,
		Parent = track,
	})
	UIUtil.Corner(fill, UDim.new(1, 0))

	-- Survol : léger soulèvement
	card.MouseEnter:Connect(function()
		UIUtil.Tween(card, 0.15, { Position = UDim2.fromOffset(0, -1) })
	end)
	card.MouseLeave:Connect(function()
		UIUtil.Tween(card, 0.15, { Position = UDim2.fromOffset(0, 2) })
	end)

	table.insert(items, {
		Achievement = achievement,
		Cell = cell,
		Card = card,
		Stroke = stroke,
		Medallion = medallion,
		Name = name,
		Status = status,
		Track = track,
		Fill = fill,
		Done = nil,
	})
end

function Achievements.Build(content: Frame)
	buildHeader(content)

	UIUtil.Tabs({
		Parent = content,
		Tabs = {
			{ Id = "All", Text = Locale.T("🏆 All") },
			{ Id = "Done", Text = Locale.T("✅ Unlocked") },
			{ Id = "Todo", Text = Locale.T("🎯 To do") },
		},
		Color = Theme.Colors.Purple,
		Size = UDim2.new(1, 0, 0, 34),
		Position = UDim2.fromOffset(0, 72),
		Selected = filter,
		OnSelect = function(id: string)
			filter = id
			applyFilter()
		end,
	})

	local grid = UIUtil.Create("ScrollingFrame", {
		Name = "List",
		Size = UDim2.new(1, 0, 1, -114),
		Position = UDim2.fromOffset(0, 114),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = Theme.Colors.Purple,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = content,
	})
	UIUtil.Create("UIPadding", {
		PaddingTop = UDim.new(0, 2),
		PaddingLeft = UDim.new(0, 2),
		PaddingRight = UDim.new(0, 12),
		PaddingBottom = UDim.new(0, 6),
		Parent = grid,
	})
	UIUtil.Create("UIGridLayout", {
		CellSize = UDim2.new(0.25, -8, 0, 150),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})

	for index, achievement in ipairs(Config.Achievements) do
		buildItem(grid, achievement, index)
	end
end

function Achievements.Update(data)
	local unlocked = 0
	local badges, badgesTotal = 0, 0
	local unlockedMap = data.Achievements or {}
	for _, item in ipairs(items) do
		local achievement = item.Achievement
		local done = unlockedMap[achievement.Id] == true
		if done then
			unlocked += 1
		end
		if hasBadge(achievement) then
			badgesTotal += 1
			if done then
				badges += 1
			end
		end
		if item.Done ~= done then
			local wasLocked = item.Done == false
			item.Done = done
			item.Medallion.Set(done)
			if done and wasLocked then
				UIUtil.Pop(item.Card, 1.12, 0.45)
			end
		end
		local tier = AchievementPopup.Tier(achievement)
		if done then
			item.Stroke.Color = tier.Ring
			item.Stroke.Transparency = 0.2
			item.Card.BackgroundColor3 = tier.Top:Lerp(Color3.new(1, 1, 1), 0.75)
			item.Name.TextColor3 = Theme.Colors.Text
			item.Status.Text = Locale.T("✅ Unlocked  •  🎁 +%s", NumberFormatter.Format(tonumber(achievement.Reward) or 0))
			item.Status.TextColor3 = tier.Ring
			item.Track.Visible = false
		else
			item.Stroke.Color = Theme.Colors.Divider
			item.Stroke.Transparency = 0
			item.Card.BackgroundColor3 = Theme.Colors.Card
			item.Name.TextColor3 = Theme.Colors.TextDim
			local goal = math.max(1, tonumber(achievement.Goal) or 1)
			local value = math.min(statValue(data, achievement.Stat), goal)
			item.Status.Text = NumberFormatter.Format(value) .. " / " .. NumberFormatter.Format(goal)
			item.Status.TextColor3 = Theme.Colors.TextDim
			item.Track.Visible = true
			item.Fill.Size = UDim2.fromScale(math.clamp(value / goal, 0, 1), 1)
		end
	end
	applyFilter()

	local total = #Config.Achievements
	summaryLabel.Text = Locale.T("%d / %d achievements unlocked", unlocked, total)
	progressFill.Size = UDim2.fromScale(total > 0 and unlocked / total or 0, 1)
	setChipText(bonusChip, Locale.T("📈 Bonus +%d%%", math.floor(unlocked * Config.AchievementBonus * 100 + 0.5)))
	badgeChip.Visible = badgesTotal > 0
	if badgesTotal > 0 then
		setChipText(badgeChip, Locale.T("🏅 %d / %d badges", badges, badgesTotal))
	end
end

return Achievements
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="81">
            <Properties>
              <string name="Name">Arcade</string>
              <string name="Source"><![CDATA[--[[
	Arcade (ModuleScript) — 🕹️ salle d'arcade
	Emplacement : ReplicatedStorage > Client > Components > Panels > Arcade

	Fenêtre "néon kawaii" (débloquée par l'amélioration "Arcade", Feature
	"Minigames") :
	  - en-tête : onglets Jeux / Duels / Boutique à tickets / Records +
	    portefeuille : 🎟️ tickets (= boutique, bouton "+" pour en acheter) et
	    🏆 trophées (= mises des duels, gagnés seulement en jouant) ; le
	    sous-titre de la fenêtre l'explique en une ligne ;
	  - Jeux : cartes illustrées (solo et duels) ; un jeu solo se charge à la
	    demande (Client > Minigames > Solo_<Id>) dans une grande zone de jeu
	    avec bouton retour ;
	  - Duels : choix du jeu et de la mise (en 🏆 trophées, jamais en tickets :
	    ils s'achètent en Robux), joueurs du serveur qui ont l'arcade,
	    invitations envoyées / reçues ;
	  - duel en cours : bandeau "toi VS adversaire" (scores, pot, temps),
	    plateau (Client > Minigames > Duel_<Id>), écran de résultat ;
	  - Boutique à tickets : petits boosts, Dopamine, badges d'arcade. Pas
	    assez de tickets -> fenêtre NeedTickets À CHAQUE fois (propose un pack
	    de la boutique Robux, onglet 🎟️ Tickets) ;
	  - Records : meilleurs scores, victoires, derniers duels.
	Les invitations arrivent même fenêtre fermée : petite carte "défi" (calque
	Toasts) avec Accepter / Refuser, et bandeaux Notifications.Show.
	API : ShowTab(id) ("Games" | "Duels" | "Shop" | "Records").

	Contrat d'un module de jeu (Client > Minigames) :
	  { Id, Kind = "Solo" | "Duel", Build = function(container, api) -> { Destroy } }
	  api = { Invoke(action, arg) -> (ok, result), OnEvent(callback(kind, payload)) -> connexion,
	          Close(), T = Locale.T, Colors, Sounds = { Play(name, pitch?) }, Notify(text, color?),
	          Game (entrée d'ArcadeConfig), Tickets() -> solde, UserId,
	          -- duels : Duel (état de départ), Seat (1 | 2), Move(coup) -> (ok, résultat) }
	  Pour un jeu solo, Invoke ajoute le préfixe "solo:" s'il manque.
	Le serveur (MinigameService) décide de TOUT : le client affiche et demande.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local Client = script.Parent.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local Interface = require(Client.Interface)
local ClientState = require(Client.ClientState)
local Effects = require(Client.Effects)
local SoundManager = require(Client.SoundManager)
local Notifications = require(script.Parent.Parent.Notifications)
local PanelManager = require(script.Parent.Parent.PanelManager)
local Signal = require(ReplicatedStorage.Shared.Signal)
local Net = require(ReplicatedStorage.Shared.Net)
local Locale = require(ReplicatedStorage.Shared.Locale)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local ArcadeConfig = require(ReplicatedStorage.Shared.ArcadeConfig)

-- Fenêtre "Pas assez de tickets" (chargée prudemment : son absence ne casse pas l'arcade)
local NeedTickets: any = nil
do
	local module = script.Parent.Parent:FindFirstChild("NeedTickets")
	if module and module:IsA("ModuleScript") then
		local ok, result = pcall(require, module)
		if ok and type(result) == "table" then
			NeedTickets = result
		else
			warn("[Arcade] NeedTickets : " .. tostring(result))
		end
	end
end


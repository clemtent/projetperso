        <Item class="ModuleScript" referent="296">
          <Properties>
            <string name="Name">FR_V92_Shop</string>
            <string name="Source"><![CDATA[--[[
	FR_V92_Shop (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > Lang > FR_V92_Shop


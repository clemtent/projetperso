----------------------------------------------------------------------
-- Mises à jour
----------------------------------------------------------------------

local function setCardState(card: Card, state: string, text: string)
	local previous = card.State
	if previous == state then
		-- Même état (mise à jour fréquente) : seul le montant peut changer
		card.Amount.Text = text
		return
	end
	card.State = state
	local today = state == "today"
	local claimed = state == "claimed"
	local tomorrow = state == "tomorrow"
	local locked = state == "locked"
	local art = card.Art

	card.Card.Position = UDim2.new()
	art.Frame.Rotation = 0
	art.Lid.Position = art.LidBase
	art.Lid.Rotation = 0
	paintArt(art, (locked and "grey") or (tomorrow and "soft") or "color")

	card.Card.BackgroundColor3 = (today or tomorrow) and WHITE or Theme.Colors.Surface
	local tint = Theme.Colors.PanelLight
	if today then
		tint = Theme.Colors.Pink:Lerp(WHITE, 0.8)
	elseif card.Big and not claimed then
		tint = Theme.Colors.Purple:Lerp(WHITE, 0.84)
	elseif tomorrow then
		tint = Theme.Colors.Blue:Lerp(WHITE, 0.88)
	end
	card.Fill.Color = ColorSequence.new(WHITE, tint)

	card.Stroke.Color = (today and GOLD) or (tomorrow and Theme.Colors.Blue) or Theme.Colors.Divider
	card.Stroke.Thickness = today and 3 or 1.5
	card.Stroke.Transparency = tomorrow and 0.35 or 0
	card.Shimmer.Enabled = today
	card.Glow.Visible = today or (card.Big and not claimed)
	card.Glow.BackgroundColor3 = today and GOLD or Theme.Colors.Purple
	card.Glow.BackgroundTransparency = today and 0.5 or 0.78

	card.Dim.Visible = claimed
	card.Dim.BackgroundTransparency = 0.38
	card.Stamp.Visible = claimed
	card.Stamp.Rotation = -14
	card.StampScale.Scale = 1
	card.Lock.Visible = locked or tomorrow
	card.LockLabel.Text = tomorrow and "⏳" or "🔒"
	card.Ribbon.Visible = today or tomorrow
	card.Ribbon.BackgroundColor3 = today and Theme.Colors.Pink or Theme.Colors.Blue
	card.RibbonLabel.Text = today and Locale.T("TODAY") or Locale.T("TOMORROW")
	card.Title.TextColor3 = today and PINK_DARK or Theme.Colors.TextDim

	card.Pill.BackgroundColor3 = (today and Theme.Colors.Pink)
		or (claimed and Theme.Colors.Green:Lerp(WHITE, 0.72))
		or Theme.Colors.PanelLight
	card.Amount.TextColor3 = (today and WHITE) or (claimed and GREEN_DARK) or Theme.Colors.TextDim
	card.Amount.Text = text

	if card.Rays then
		card.Rays.Visible = not claimed
	end
	local diamond, base = art.Diamond, art.DiamondBase
	if diamond and base then
		diamond.Position = base
		diamond.Rotation = 0
		diamond.TextTransparency = locked and 0.2 or 0
	end
	-- Nouveau "jour actuel" (ex. minuit passé fenêtre ouverte) : petit pop
	if today and previous ~= "" and previous ~= state then
		UIUtil.Pop(card.Card, 0.85, 0.4)
	end
end

local function setMeter(claimedCount: number, activeStreak: number, todayIsLast: boolean)
	local ratio = math.clamp(claimedCount / DAYS, 0, 1)
	if ratio ~= meterRatio then
		meterRatio = ratio
		UIUtil.Tween(meterFill, 0.5, { Size = UDim2.fromScale(ratio, 1) }, Enum.EasingStyle.Quint)
		UIUtil.Tween(flameTip, 0.5, { Position = UDim2.fromScale(ratio, 0.5) }, Enum.EasingStyle.Quint)
	end
	flameTip.TextTransparency = claimedCount > 0 and 0 or 0.45
	streakLabel.Text = Locale.T("Streak: %d day%s", activeStreak, pluralS(activeStreak))
	local left = DAYS - claimedCount
	if left <= 0 then
		goalLabel.Text = Locale.T("💎 MAX!")
	elseif todayIsLast then
		goalLabel.Text = Locale.T("💎 today!")
	else
		goalLabel.Text = Locale.T("💎 in %d d", left)
	end
end

local function setButton(mode: string)
	if mode == "ready" then
		UIUtil.SetButtonEnabled(button, true)
		buttonLabel.Text = Locale.T("🎁  CLAIM")
		buttonLabel.TextTransparency = 0
	elseif mode == "busy" then
		button:SetAttribute("Enabled", false)
		buttonLabel.Text = Locale.T("OPENING…")
		buttonLabel.TextTransparency = 0
	elseif mode == "party" then
		button:SetAttribute("Enabled", false)
		buttonLabel.Text = Locale.T("🎉  WELL DONE!")
		buttonLabel.TextTransparency = 0
	elseif mode == "claimed" then
		UIUtil.SetButtonEnabled(button, false)
		buttonLabel.Text = Locale.T("✔  ALREADY CLAIMED")
		buttonLabel.TextTransparency = 0.1
	else
		UIUtil.SetButtonEnabled(button, false)
		buttonLabel.Text = Locale.T("Loading…")
		buttonLabel.TextTransparency = 0.2
	end
end

-- Anneau : chenillard doré si le cadeau est prêt, sinon la part de la
-- journée écoulée (le segment de tête clignote)
local function refreshRing(t: number)
	local info = currentInfo
	if not info then
		for _, segment in ipairs(segments) do
			segment.BackgroundColor3 = WHITE
			segment.BackgroundTransparency = 0.75
		end
		return
	end
	if info.Available == true then
		for index, segment in ipairs(segments) do
			local wave = 0.5 + 0.5 * math.sin(t * 7 - index * (math.pi * 4 / RING_SEGMENTS))
			segment.BackgroundColor3 = WHITE:Lerp(GOLD_LIGHT, wave)
			segment.BackgroundTransparency = 0.05 + 0.3 * (1 - wave)
		end
		return
	end
	local elapsed = math.clamp(1 - remainingSeconds() / SECONDS_PER_DAY, 0, 1)
	local lit = math.floor(elapsed * RING_SEGMENTS + 0.5)
	for index, segment in ipairs(segments) do
		segment.BackgroundColor3 = WHITE
		if index < lit then
			segment.BackgroundTransparency = 0.05
		elseif index == lit then
			segment.BackgroundTransparency = 0.05 + 0.5 * (0.5 + 0.5 * math.sin(t * 6))
		else
			segment.BackgroundTransparency = 0.72
		end
	end
end

-- Textes qui dépendent du temps (anneau, astuce)
local function refreshTimers()
	local info = currentInfo
	if not info then
		ringTime.Text = "…"
		ringCaption.Text = Locale.T("loading")
		return
	end
	if info.Available == true then
		ringTime.Text = Locale.T("READY!")
		ringCaption.Text = Locale.T("open it quick")
		return
	end
	local remaining = remainingSeconds()
	ringTime.Text = UIUtil.FormatClock(remaining)
	if remaining <= 0 then
		ringCaption.Text = Locale.T("almost here…")
		hintLabel.Text = Locale.T("⏳ Your next gift is on its way…")
	else
		ringCaption.Text = Locale.T("next gift")
		hintLabel.Text = Locale.T("⏳ Next gift in %s", NumberFormatter.Time(remaining)) .. tomorrowText
	end
end

-- Applique un état serveur à tout le panneau
local function apply(data)
	if not built then
		return
	end
	local info = data and data.Daily
	if type(info) ~= "table" then
		-- Pas encore d'état (ou calendrier absent) : squelette propre
		currentInfo = nil
		heroStatus.Text = Locale.T("Loading the calendar...")
		setChipText(streakChip, Locale.T("🔥 Streak: –"))
		rewardChip.Visible = false
		for _, card in ipairs(cards) do
			setCardState(card, "locked", "…")
		end
		setMeter(0, 0, false)
		amountCaption.Text = Locale.T("TODAY'S REWARD")
		amountLabel.Text = "…"
		amountLabel.TextColor3 = Theme.Colors.TextDim
		setButton("loading")
		hintLabel.Text = Locale.T("Loading...")
		refreshTimers()
		return
	end

	currentInfo = info
	lastInfoClock = os.clock()
	local available = info.Available == true
	local streak = math.max(0, math.floor(tonumber(info.Streak) or 0))
	local reward = tonumber(info.Reward) or 0
	-- Série de jours déjà faits (le jour du cadeau disponible n'est pas compté)
	local activeStreak = available and math.max(0, streak - 1) or streak
	local todayIndex = available and math.clamp(streak, 1, DAYS) or nil
	local claimedCount = if todayIndex then todayIndex - 1 else math.min(streak, DAYS)
	local reference = math.max(1, todayIndex or claimedCount)

	for day, card in ipairs(cards) do
		local state = "locked"
		if day <= claimedCount then
			state = "claimed"
		elseif day == todayIndex then
			state = "today"
		elseif not available and day == claimedCount + 1 then
			state = "tomorrow"
		end
		local text
		if state == "claimed" then
			text = Locale.T("✔ Claimed")
		elseif state == "today" then
			text = formatReward(reward)
		else
			local estimate = estimateReward(data, day)
			if estimate then
				text = "≈ " .. formatReward(estimate)
			else
				local ratio = rewardSeconds(day) / rewardSeconds(reference)
				text = NumberFormatter.Multiplier(math.floor(ratio * 10 + 0.5) / 10)
			end
		end
		setCardState(card, state, text)
	end

	-- Estimation de demain (pour l'astuce du compte à rebours)
	tomorrowText = ""
	if not available then
		local tomorrow = estimateReward(data, streak + 1)
		if tomorrow then
			tomorrowText = Locale.T("  •  tomorrow ≈ %s", formatReward(tomorrow))
		end
	end

	-- En-tête
	if available then
		heroStatus.Text = streak > 1 and Locale.T("Day %d of your streak: your gift is waiting!", streak)
			or Locale.T("Your daily gift is waiting!")
		setChipText(rewardChip, "🎁 " .. formatReward(reward))
	else
		heroStatus.Text = streak >= DAYS and Locale.T("Max streak! A 💎 chest awaits you every day.")
			or Locale.T("Well done! Come back tomorrow for day %d.", claimedCount + 1)
		setChipText(rewardChip, Locale.T("✔ Claimed today"))
	end
	rewardChip.Visible = true
	setChipText(streakChip, Locale.T("🔥 Streak: %d day%s", activeStreak, pluralS(activeStreak)))

	setMeter(claimedCount, activeStreak, todayIndex == DAYS)

	-- Montant + bouton
	if available then
		amountCaption.Text = Locale.T("DAY %d REWARD", todayIndex or 1)
		amountLabel.Text = formatReward(reward)
		amountLabel.TextColor3 = PINK_DARK
		setButton("ready")
		hintLabel.Text = Locale.T("Come back every day: the reward grows with your streak 🔥")
	else
		amountCaption.Text = Locale.T("✔ CLAIMED TODAY")
		amountLabel.Text = formatReward(reward)
		amountLabel.TextColor3 = GREEN_DARK
		setButton("claimed")
	end
	refreshTimers()
end

----------------------------------------------------------------------
-- Séquence de récupération
----------------------------------------------------------------------

-- Onde de lumière qui s'élargit
local function lightBurst(origin: UDim2)
	local wave = UIUtil.Create("Frame", {
		Name = "LightBurst",
		Size = UDim2.fromOffset(20, 20),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = origin,
		BackgroundColor3 = GOLD_LIGHT,
		BackgroundTransparency = 0.15,
		ZIndex = 55,
		Parent = contentFrame,
	})
	round(wave)
	UIUtil.Tween(wave, 0.5, { Size = UDim2.fromOffset(220, 220), BackgroundTransparency = 1 }, Enum.EasingStyle.Quart)
	task.delay(0.55, function()
		wave:Destroy()
	end)
end

-- Gouttes de Dopamine qui jaillissent du paquet, montent puis retombent
local function flyDrops(origin: UDim2, count: number)
	for index = 1, count do
		task.delay((index - 1) * 0.03, function()
			if not contentFrame.Parent then
				return
			end
			local drop = UIUtil.Label({
				Name = "Drop",
				Text = ICON,
				Size = UDim2.fromOffset(26, 26),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = origin,
				Rotation = random:NextNumber(-25, 25),
				MaxTextSize = 24,
				ZIndex = 60,
				Parent = contentFrame,
			})
			local scale = UIUtil.Create("UIScale", { Scale = 0.3, Parent = drop })
			UIUtil.Tween(scale, 0.25, { Scale = random:NextNumber(0.9, 1.25) }, Enum.EasingStyle.Back)
			local apex = origin + UDim2.fromOffset(random:NextNumber(-130, 130), random:NextNumber(-170, -90))
			UIUtil.Tween(drop, 0.5, { Position = apex }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			task.delay(0.5, function()
				if not drop.Parent then
					return
				end
				UIUtil.Tween(drop, 0.45, {
					Position = apex + UDim2.fromOffset(random:NextNumber(-20, 20), 50),
					Rotation = drop.Rotation + random:NextNumber(-60, 60),
					TextTransparency = 1,
				}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				task.delay(0.5, function()
					drop:Destroy()
				end)
			end)
		end)
	end
end

-- Le montant défile de 0 à `amount` (avec petits "tintements")
local function countUp(amount: number, duration: number)
	local start = os.clock()
	local lastTick = 0
	amountLabel.TextColor3 = GREEN_DARK
	while true do
		local k = math.clamp((os.clock() - start) / duration, 0, 1)
		local eased = 1 - (1 - k) ^ 3
		amountLabel.Text = formatReward(amount * eased)
		if k >= 1 then
			break
		end
		if os.clock() - lastTick > 0.11 then
			lastTick = os.clock()
			SoundManager.Play("Cash", 0.9 + 0.6 * k)
			UIUtil.Pop(amountLabel, 1.08, 0.12)
		end
		task.wait()
	end
	UIUtil.Pop(amountLabel, 1.35, 0.4)
end

-- Tampon "✔" qui s'écrase sur la carte du jour
local function stampCard(card: Card)
	card.Dim.Visible = true
	card.Dim.BackgroundTransparency = 1
	UIUtil.Tween(card.Dim, 0.3, { BackgroundTransparency = 0.38 })
	card.Stamp.Visible = true
	card.Stamp.Rotation = -40
	card.StampScale.Scale = 2.6
	UIUtil.Tween(card.StampScale, 0.28, { Scale = 1 }, Enum.EasingStyle.Back)
	UIUtil.Tween(card.Stamp, 0.28, { Rotation = -14 }, Enum.EasingStyle.Back)
	card.Ribbon.Visible = false
	card.Glow.Visible = false
	card.Shimmer.Enabled = false
	card.Stroke.Color = Theme.Colors.Divider
	card.Stroke.Thickness = 1.5
	card.Pill.BackgroundColor3 = Theme.Colors.Green:Lerp(WHITE, 0.72)
	card.Amount.Text = Locale.T("✔ Claimed")
	card.Amount.TextColor3 = GREEN_DARK
	task.delay(0.2, function()
		if not card.Card.Parent then
			return
		end
		SoundManager.Play("Pop", 0.85)
		UIUtil.Shake(card.Card)
		Effects.Burst(contentFrame, toContent(card.Stamp, 0.5, 0.5), Theme.Colors.Green, 10)
	end)
end

local function claimSequence(card: Card?, amount: number, message: string)
	setButton("party")
	if card then
		card.Busy = true
		card.Card.Position = UDim2.new()
	end

	-- 1. Suspense : le paquet tremble de plus en plus fort
	SoundManager.Play("Chest", 1)
	local start = os.clock()
	while os.clock() - start < 0.5 do
		local k = (os.clock() - start) / 0.5
		local angle = math.sin(os.clock() * 55) * (3 + 12 * k)
		heroGift.Frame.Rotation = angle
		if card then
			card.Art.Frame.Rotation = angle
		end
		task.wait()
	end
	heroGift.Frame.Rotation = 0

	-- 2. Ouverture : couvercle qui saute, flash, confettis, gouttes
	openLid(heroGift, -1)
	local origin = UDim2.fromScale(0.5, 0.35)
	if card then
		card.Art.Frame.Rotation = 0
		openLid(card.Art, 1)
		origin = toContent(card.Art.Frame, 0.5, 0.45)
	end
	SoundManager.Play("Jackpot", 1.1)
	Effects.Flash(Theme.Colors.Pink, 0.25)
	Effects.Confetti(90)
	lightBurst(origin)
	Effects.Burst(contentFrame, origin, GOLD, 16)
	flyDrops(origin, 16)
	Effects.FloatingText(contentFrame, origin + UDim2.fromOffset(0, -40), formatReward(amount), GOLD, 30)

	-- 3. Le montant défile
	amountCaption.Text = Locale.T("🎉 GIFT CLAIMED!")
	countUp(amount, 1)

	-- 4. Tampon sur la carte + notification
	if card then
		stampCard(card)
	end
	Notifications.Toast(tostring(message or ""), Theme.Colors.Pink, 5, Locale.T("🎁 Gift claimed!"))
	task.wait(0.9)
	closeLid(heroGift)
	if card then
		closeLid(card.Art)
	end
	task.wait(0.35)
end

local function onClaim()
	if claiming or celebrating then
		return
	end
	if not button:GetAttribute("Enabled") then
		SoundManager.Play("Error", 0.7)
		UIUtil.Shake(button)
		-- Petit rappel (pas plus d'une fois toutes les 3 s)
		if currentInfo and not isAvailable() and os.clock() - lastRefusal > 3 then
			lastRefusal = os.clock()
			Notifications.Toast(
				Locale.T("Already claimed today! Next gift in %s.", NumberFormatter.Time(remainingSeconds())),
				Theme.Colors.Orange,
				3
			)
		end
		return
	end

	-- Carte et montant du jour AVANT l'appel (l'état change pendant)
	local info = currentInfo
	local todayIndex = math.clamp(math.floor(tonumber(info and info.Streak) or 1), 1, DAYS)
	local card = cards[todayIndex]
	local expected = tonumber(info and info.Reward) or 0

	claiming = true
	setButton("busy")
	SoundManager.Play("Click", 1.1)
	local ok, success, message = pcall(function()
		return Net.Function("ClaimDaily"):InvokeServer()
	end)

	if ok and success then
		celebrating = true
		claiming = false
		-- Montant exact : état reçu après la récupération (même série, mêmes stats)
		local after = latestData and latestData.Daily
		local amount = expected
		if type(after) == "table" and after.Available ~= true and tonumber(after.Reward) then
			amount = tonumber(after.Reward) :: number
		end
		task.spawn(function()
			local done, err = pcall(claimSequence, card, amount, tostring(message or ""))
			if not done then
				warn("[Daily] Erreur pendant l'animation : " .. tostring(err))
			end
			-- Remise à zéro (même si l'animation a été interrompue)
			heroGift.Lid.Position = heroGift.LidBase
			heroGift.Lid.Rotation = 0
			heroGift.Frame.Rotation = 0
			if card then
				card.Busy = false
				card.State = "" -- force le redessin complet de la carte
			end
			celebrating = false
			apply(latestData or ClientState.Data)
		end)
	else
		claiming = false
		SoundManager.Play("Error", 0.7)
		Notifications.Toast(
			ok and tostring(message or Locale.T("Not possible right now.")) or Locale.T("Network error, try again."),
			Theme.Colors.Red
		)
		apply(latestData or ClientState.Data)
	end
end

----------------------------------------------------------------------
-- Animations (fenêtre ouverte seulement)
----------------------------------------------------------------------

local function stopAnimation()
	local connection = animation
	if connection then
		connection:Disconnect()
		animation = nil
	end
end

local function resetButtonPulse()
	if buttonPulsing then
		buttonPulsing = false
		button.Size = UDim2.fromOffset(BUTTON_SIZE.X, BUTTON_SIZE.Y)
		buttonGlow.Visible = false
		shine.Visible = false
	end
end

local function animate(dt: number)
	if not contentFrame.Parent then
		stopAnimation()
		return
	end
	local t = os.clock() - animStart
	local available = isAvailable()

	-- En-tête
	heroRays.Rotation = (heroRays.Rotation + dt * (available and 24 or 8)) % 360
	heroHalo.BackgroundTransparency = available and (0.7 + 0.12 * math.sin(t * 4)) or 0.84
	for _, star in ipairs(sparkles) do
		local phase = star:GetAttribute("Phase") or 0
		star.TextTransparency = 0.15 + 0.7 * (0.5 + 0.5 * math.sin(t * 2.5 + phase))
	end
	if not celebrating then
		local gift = heroGift.Frame
		if available then
			gift.Rotation = wiggle(t)
			gift.Position = HERO_GIFT_POS + UDim2.fromOffset(0, -math.abs(math.sin(t * 3)) * 5)
		else
			gift.Rotation = math.sin(t * 1.4) * 3
			gift.Position = HERO_GIFT_POS + UDim2.fromOffset(0, math.sin(t * 2) * 3)
		end
	end
	refreshRing(t)

	-- Cartes
	for _, card in ipairs(cards) do
		local rays = card.Rays
		if rays and rays.Visible then
			rays.Rotation = (rays.Rotation + dt * 25) % 360
		end
		if not card.Busy then
			local diamond, base = card.Art.Diamond, card.Art.DiamondBase
			if diamond and base then
				diamond.Position = base + UDim2.fromOffset(0, math.sin(t * 2.2) * 3)
				diamond.Rotation = math.sin(t * 1.6) * 6
			end
			if card.State == "today" then
				card.Card.Position = UDim2.fromOffset(0, -math.abs(math.sin(t * 3.2)) * 6)
				card.Art.Frame.Rotation = wiggle(t + 0.35)
				card.Glow.BackgroundTransparency = 0.3 + 0.35 * (0.5 + 0.5 * math.sin(t * 4))
				card.Shimmer.Rotation = (t * 140) % 360
			elseif card.Big and card.State ~= "claimed" then
				card.Glow.BackgroundTransparency = 0.74 + 0.12 * math.sin(t * 2)
			end
		end
	end

	-- Flamme de la jauge
	flameTip.Rotation = math.sin(t * 9) * 8
	flameScale.Scale = 1 + 0.1 * math.sin(t * 13)

	-- Bouton : pulsation, halo et reflet qui balaie
	if available and not claiming and not celebrating then
		buttonPulsing = true
		local pulse = 1 + 0.03 * math.sin(t * 4.5)
		button.Size = UDim2.fromOffset(BUTTON_SIZE.X * pulse, BUTTON_SIZE.Y * pulse)
		buttonGlow.Visible = true
		buttonGlow.BackgroundTransparency = 0.6 + 0.25 * math.sin(t * 4.5)
		local sweep = (t % 2.6) / 0.75
		shine.Visible = sweep < 1
		shine.Position = UDim2.fromScale(-0.2 + 1.4 * math.min(sweep, 1), 0.5)
	else
		resetButtonPulse()
	end

	-- Textes du compte à rebours (4 fois par seconde)
	textClock += dt
	if textClock >= 0.25 then
		textClock = 0
		if not celebrating then
			refreshTimers()
		end
	end
end

----------------------------------------------------------------------
-- API du panneau
----------------------------------------------------------------------

function Daily.Build(content: Frame)
	contentFrame = content
	buildHero(content)

	local row = UIUtil.Create("Frame", {
		Name = "Days",
		Size = UDim2.new(1, 0, 0, CARD_HEIGHT),
		Position = UDim2.fromOffset(0, CARDS_Y),
		BackgroundTransparency = 1,
		Parent = content,
	})
	for day = 1, DAYS do
		cards[day] = buildCard(row, day)
	end

	buildMeter(content)

	amountCaption = UIUtil.Label({
		Name = "AmountCaption",
		Text = "",
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, 0, 0, 16),
		Position = UDim2.fromOffset(0, AMOUNT_Y),
		MaxTextSize = 13,
		Parent = content,
	})
	amountLabel = UIUtil.Label({
		Name = "Amount",
		Text = "",
		Font = Theme.Fonts.Number,
		TextColor3 = PINK_DARK,
		Size = UDim2.new(1, 0, 0, 36),
		Position = UDim2.fromOffset(0, AMOUNT_Y + 16),
		MaxTextSize = 34,
		Parent = content,
	})

	buildButton(content)
	button.Activated:Connect(onClaim)

	hintLabel = UIUtil.Label({
		Name = "Hint",
		Text = "",
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, 0, 0, 20),
		Position = UDim2.fromOffset(0, HINT_Y),
		MaxTextSize = 14,
		Parent = content,
	})

	built = true
	latestData = ClientState.Data
	apply(latestData)
end

function Daily.Update(data)
	latestData = data
	-- Pendant l'appel serveur / l'animation, on garde l'affichage : l'état
	-- le plus récent est appliqué à la fin de la séquence
	if claiming or celebrating then
		return
	end
	apply(data)
end

function Daily.OnOpen()
	if not built then
		return
	end
	stopAnimation()
	animStart = os.clock()
	textClock = 0
	refreshTimers()
	animation = RunService.RenderStepped:Connect(animate)
end

function Daily.OnClose()
	stopAnimation()
	if built then
		resetButtonPulse()
	end
end

return Daily
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="69">
            <Properties>
              <string name="Name">Debug</string>
              <string name="Source"><![CDATA[--[[
	Debug (ModuleScript) — "🛠️ Test" (UNIQUEMENT dans Studio)
	Emplacement : ReplicatedStorage > Client > Components > Panels > Debug

	Gros boutons pour tester le jeu sans attendre : Dopamine, tout
	débloquer, Rush, apparitions (étoile, éclair, notif, mail, don), océan,
	coffres, Game Passes de test (activer / désactiver), boost, thème,
	gain hors-ligne simulé, remise à zéro...
	Chaque bouton appelle la RemoteFunction "DebugCommand" (via DebugTools)
	et affiche le message renvoyé par le serveur dans la barre du haut.
	Les mêmes commandes existent dans le chat (/give, /unlockall, /aide...).
	Le panneau n'est enregistré que dans Studio (voir ClientMain).
	v5 : section "🌐 Langue & écran" : 🌐 EN/FR (réglage Language, effectif
	au prochain passage), 🌙 mode sombre, 📱 profil d'appareil forcé
	(Téléphone / Tablette / PC) pour tester l'interface responsive.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local ClientState = require(Client.ClientState)
local SoundManager = require(Client.SoundManager)
local Interface = require(Client.Interface)
local DebugTools = require(script.Parent.Parent.DebugTools)
local Net = require(ReplicatedStorage.Shared.Net)
local Locale = require(ReplicatedStorage.Shared.Locale)

-- Title / Subtitle en anglais : traduits par PanelManager
local Debug = {
	Title = "🛠️ Test tools",
	Subtitle = "Studio only: never visible in the published game",
	Color = Theme.Colors.Red,
	Size = Vector2.new(740, 580),
}

type Action = {
	Text: string,
	Icon: string,
	Command: string,
	Arg: string?,
	Color: Color3,
	Confirm: boolean?,
	Pass: string?, -- Id du Game Pass (affiche ON / OFF)
	Run: (() -> (boolean, string))?, -- action locale (sans commande serveur)
}

-- Actions locales de la section "Langue & écran"
local DEVICE_CYCLE = { "Auto", "Phone", "Tablet", "Desktop" }
local deviceIndex = 1

local function toggleLanguage(): (boolean, string)
	local target = Locale.GetLanguage() == "fr" and "en" or "fr"
	local ok, success = pcall(function()
		return Net.Function("SetSetting"):InvokeServer("Language", target)
	end)
	if not ok or success ~= true then
		return false, Locale.T("Couldn't save the language, try again.")
	end
	local data = ClientState.Data
	if data and type(data.Settings) == "table" then
		data.Settings.Language = target
	end
	return true, Locale.TFor(target, "Language will change after rejoining") .. " (" .. string.upper(target) .. ")"
end

local function toggleDarkMode(): (boolean, string)
	local enabled = not ClientState.IsUserDarkMode()
	ClientState.SetUserDarkMode(enabled)
	pcall(function()
		Net.Function("SetSetting"):InvokeServer("DarkMode", enabled)
	end)
	return true, enabled and Locale.T("Dark mode on") or Locale.T("Dark mode off")
end

local function cycleDevice(): (boolean, string)
	deviceIndex = deviceIndex % #DEVICE_CYCLE + 1
	local device = DEVICE_CYCLE[deviceIndex]
	Interface.SetDeviceOverride(device ~= "Auto" and device or nil)
	return true, Locale.T("Screen profile: %s", Interface.Device .. (device == "Auto" and " (auto)" or ""))
end

-- Textes en anglais, traduits à la construction
local SECTIONS = {
	{
		Title = "🌐 Language & screen",
		Color = Theme.Colors.Blue,
		Actions = {
			{ Text = "EN/FR", Icon = "🌐", Command = "language", Color = Theme.Colors.Blue, Run = toggleLanguage },
			{ Text = "Dark mode", Icon = "🌙", Command = "darkmode", Color = Theme.Colors.Dark, Run = toggleDarkMode },
			{ Text = "Phone/Tablet/PC", Icon = "📱", Command = "device", Color = Theme.Colors.Cyan, Run = cycleDevice },
		},
	},
	{
		Title = "💧 Dopamine",
		Color = Theme.Colors.Cyan,
		Actions = {
			{ Text = "+1 M", Icon = "💧", Command = "give", Arg = "1e6", Color = Theme.Colors.Cyan },
			{ Text = "+1 B", Icon = "💦", Command = "give", Arg = "1e9", Color = Theme.Colors.Blue },
			{ Text = "+1 T", Icon = "🌊", Command = "give", Arg = "1e12", Color = Theme.Colors.Purple },
			{ Text = "+1 Qa", Icon = "🧠", Command = "give", Arg = "1e15", Color = Theme.Colors.Pink },
		},
	},
	{
		Title = "🚀 Progression",
		Color = Theme.Colors.Green,
		Actions = {
			{ Text = "Unlock all", Icon = "🔓", Command = "unlockall", Color = Theme.Colors.Green },
			{ Text = "Rush", Icon = "⚡", Command = "rush", Color = Theme.Colors.Yellow },
			{ Text = "Ocean", Icon = "🌊", Command = "detox", Color = Theme.Colors.Cyan },
			{ Text = "+3 chests", Icon = "📦", Command = "chest", Arg = "3", Color = Theme.Colors.Orange },
			{ Text = "Gift ready", Icon = "🎁", Command = "daily", Color = Theme.Colors.Pink },
			{ Text = "DVD corner", Icon = "📀", Command = "corner", Color = Theme.Colors.Purple },
			{ Text = "Save", Icon = "💾", Command = "save", Color = Theme.Colors.Dark },
		},
	},
	{
		Title = "✨ Spawns",
		Color = Theme.Colors.Gold,
		Actions = {
			{ Text = "Star", Icon = "🌟", Command = "spawn", Arg = "golden", Color = Theme.Colors.Gold },
			{ Text = "Lightning", Icon = "⚡", Command = "spawn", Arg = "lightning", Color = Theme.Colors.Yellow },
			{ Text = "Notif", Icon = "🔔", Command = "spawn", Arg = "notif", Color = Theme.Colors.Blue },
			{ Text = "Mail", Icon = "✉️", Command = "spawn", Arg = "email", Color = Theme.Colors.Orange },
			{ Text = "Donation (live)", Icon = "💸", Command = "spawn", Arg = "donation", Color = Theme.Colors.Robux },
		},
	},
	{
		Title = "💎 Robux (simulated)",
		Color = Theme.Colors.Robux,
		Actions = {
			{ Text = "Pass x10", Icon = "🚀", Command = "pass", Arg = "x10", Color = Theme.Colors.Purple, Pass = "X10" },
			{ Text = "Pass x2", Icon = "⚡", Command = "pass", Arg = "x2", Color = Theme.Colors.Blue, Pass = "X2" },
			{ Text = "Auto-click", Icon = "🤖", Command = "pass", Arg = "autoclick", Color = Theme.Colors.Cyan, Pass = "AutoClick" },
			{ Text = "VIP", Icon = "👑", Command = "pass", Arg = "vip", Color = Theme.Colors.Premium, Pass = "VIP" },
			{ Text = "Boost x5 60 s", Icon = "🔥", Command = "boost", Arg = "5 60", Color = Theme.Colors.Boost },
			{ Text = "Kawaii theme", Icon = "🌸", Command = "theme", Arg = "kawaii", Color = Theme.Colors.Pink },
		},
	},
	{
		Title = "😴 Offline",
		Color = Theme.Colors.Purple,
		Actions = {
			{ Text = "Away 2 h", Icon = "🌙", Command = "offline", Arg = "7200", Color = Theme.Colors.Purple },
			{ Text = "Away 12 h", Icon = "🛌", Command = "offline", Arg = "43200", Color = Theme.Colors.Blue },
		},
	},
	{
		Title = "⚠️ Danger",
		Color = Theme.Colors.Red,
		Actions = {
			{ Text = "Reset everything", Icon = "🧨", Command = "reset", Color = Theme.Colors.Red, Confirm = true },
		},
	},
}

local CONFIRM_TIME = 3 -- secondes pour confirmer une action dangereuse

type Tile = { Action: Action, Button: TextButton, Label: TextLabel, State: Frame? }

local tiles: { Tile } = {}
local statusBar: Frame
local statusIcon: TextLabel
local statusText: TextLabel
local busyCount = 0

----------------------------------------------------------------------
-- Barre de résultat
----------------------------------------------------------------------

local function setStatus(ok: boolean?, text: string)
	if not statusBar then
		return
	end
	local color = ok == nil and Theme.Colors.Blue or (ok and Theme.Colors.Robux or Theme.Colors.Red)
	statusIcon.Text = ok == nil and "⏳" or (ok and "✅" or "❌")
	statusText.Text = text
	statusText.TextColor3 = color:Lerp(Color3.new(0, 0, 0), 0.35)
	statusBar.BackgroundColor3 = color:Lerp(Color3.new(1, 1, 1), 0.88)
	local stroke = statusBar:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = color
	end
	UIUtil.Pop(statusBar, 1.03, 0.25)
end

----------------------------------------------------------------------
-- Tuiles
----------------------------------------------------------------------

local function refreshPasses()
	for _, tile in ipairs(tiles) do
		local passId = tile.Action.Pass
		local state = tile.State
		if passId and state then
			local owned = ClientState.HasPass(passId)
			local label = state:FindFirstChild("Label") :: TextLabel?
			if label then
				label.Text = owned and "ON" or "OFF"
			end
			state.BackgroundColor3 = owned and Theme.Colors.Green or Theme.Colors.Disabled
		end
	end
end

local function run(tile: Tile)
	local action = tile.Action
	-- Action dangereuse : deuxième clic pour confirmer
	if action.Confirm and not tile.Button:GetAttribute("Armed") then
		tile.Button:SetAttribute("Armed", true)
		tile.Label.Text = Locale.T("Sure? Click again!")
		SoundManager.Play("Error", 1)
		UIUtil.Shake(tile.Button)
		task.delay(CONFIRM_TIME, function()
			if tile.Button:GetAttribute("Armed") then
				tile.Button:SetAttribute("Armed", nil)
				tile.Label.Text = Locale.T(action.Text)
			end
		end)
		return
	end
	tile.Button:SetAttribute("Armed", nil)
	tile.Label.Text = Locale.T(action.Text)

	SoundManager.Play("Click", 1.2)
	-- Action locale (langue, mode sombre, profil d'écran)
	local localRun = action.Run
	if localRun then
		busyCount += 1
		task.spawn(function()
			local ok, message = localRun()
			busyCount -= 1
			setStatus(ok, message)
			SoundManager.Play(ok and "Bonus" or "Error", ok and 1.3 or 0.8)
		end)
		return
	end
	busyCount += 1
	setStatus(nil, "/" .. action.Command .. (action.Arg and (" " .. action.Arg) or "") .. " ...")
	task.spawn(function()
		local ok, message = DebugTools.Run(action.Command, action.Arg)
		busyCount -= 1
		setStatus(ok, message)
		if ok then
			SoundManager.Play("Bonus", 1.3)
		else
			SoundManager.Play("Error", 0.8)
			if tile.Button.Parent then
				UIUtil.Shake(tile.Button)
			end
		end
	end)
end

local function buildTile(grid: Frame, action: Action, order: number)
	local button = UIUtil.Create("TextButton", {
		Name = action.Command .. (action.Arg or ""),
		BackgroundColor3 = Color3.new(1, 1, 1),
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = order,
		Parent = grid,
	})
	UIUtil.Corner(button, Theme.Radius.M)
	UIUtil.Stroke(button, action.Color:Lerp(Color3.new(0, 0, 0), 0.3), 1.5, 0.2)
	UIUtil.SoftGradient(button, action.Color, 90)
	UIUtil.AnimateButton(button, 1.04, 0.94)

	local icon = UIUtil.Create("Frame", {
		Name = "Icon",
		Size = UDim2.fromOffset(34, 34),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 8, 0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.2,
		ZIndex = 2,
		Parent = button,
	})
	UIUtil.Corner(icon, UDim.new(1, 0))
	UIUtil.Label({
		Text = action.Icon,
		Size = UDim2.new(1, -8, 1, -8),
		Position = UDim2.fromOffset(4, 4),
		MaxTextSize = 20,
		ZIndex = 3,
		Parent = icon,
	})
	local label = UIUtil.Label({
		Name = "Text",
		Text = Locale.T(action.Text),
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.ContrastText(action.Color),
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, action.Pass and -96 or -54, 0, 22),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 48, 0.5, 0),
		MaxTextSize = 16,
		ZIndex = 2,
		Parent = button,
	})
	local contrast = Theme.ContrastText(action.Color)
	if contrast == Theme.Colors.TextLight then
		local stroke = UIUtil.Stroke(label, Theme.Colors.TextDark, 1, 0.6)
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	end

	local state: Frame? = nil
	if action.Pass then
		local chip = UIUtil.Chip({
			Name = "State",
			Text = "OFF",
			Color = Theme.Colors.Disabled,
			TextColor3 = Theme.Colors.TextLight,
			Height = 20,
			TextSize = 12,
			ZIndex = 3,
			Parent = button,
		})
		chip.AnchorPoint = Vector2.new(1, 0.5)
		chip.Position = UDim2.new(1, -8, 0.5, 0)
		state = chip
	end

	local tile: Tile = { Action = action, Button = button, Label = label, State = state }
	button.Activated:Connect(function()
		run(tile)
	end)
	table.insert(tiles, tile)
end

----------------------------------------------------------------------
-- API du panneau
----------------------------------------------------------------------

function Debug.Build(content: Frame)
	-- Barre de résultat
	statusBar = UIUtil.Create("Frame", {
		Name = "Status",
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundColor3 = Theme.Colors.Surface,
		Parent = content,
	})
	UIUtil.Corner(statusBar, Theme.Radius.M)
	UIUtil.Stroke(statusBar, Theme.Colors.Divider, 1.5)
	statusIcon = UIUtil.Label({
		Text = "🛠️",
		Size = UDim2.fromOffset(28, 28),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		MaxTextSize = 20,
		Parent = statusBar,
	})
	statusText = UIUtil.Label({
		Text = Locale.T("Click a button: the server's message shows up here."),
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -56, 1, -10),
		Position = UDim2.fromOffset(44, 5),
		MaxTextSize = 15,
		Parent = statusBar,
	})

	local list = UIUtil.Create("ScrollingFrame", {
		Name = "Actions",
		Size = UDim2.new(1, 0, 1, -(48 + 30)),
		Position = UDim2.fromOffset(0, 48),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = Theme.Colors.Red,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = content,
	})
	UIUtil.Create("UIPadding", {
		PaddingTop = UDim.new(0, 2),
		PaddingLeft = UDim.new(0, 2),
		PaddingRight = UDim.new(0, 12),
		PaddingBottom = UDim.new(0, 6),
		Parent = list,
	})
	UIUtil.Create("UIListLayout", {
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = list,
	})

	local order = 0
	for _, section in ipairs(SECTIONS) do
		order += 1
		UIUtil.SectionHeader(list, Locale.T(section.Title), order, section.Color)
		order += 1
		local grid = UIUtil.Create("Frame", {
			Name = "Grid",
			Size = UDim2.fromScale(1, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = order,
			Parent = list,
		})
		UIUtil.Create("UIGridLayout", {
			CellSize = UDim2.new(0.25, -8, 0, 50),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = grid,
		})
		for index, action in ipairs(section.Actions) do
			buildTile(grid, action :: Action, index)
		end
	end

	-- Aide : commandes de chat
	local help = UIUtil.Create("TextLabel", {
		Name = "ChatHelp",
		Text = Locale.T("💬 In chat: %s", DebugTools.HelpText()),
		Font = Theme.Fonts.Body,
		TextSize = 13,
		TextColor3 = Theme.Colors.TextDim,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 28),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Parent = content,
	})
	help.TextTruncate = Enum.TextTruncate.AtEnd

	-- Résultat des commandes lancées depuis le chat aussi
	DebugTools.Ran:Connect(function(command: string, argument: string, ok: boolean, message: string)
		if busyCount == 0 then
			setStatus(ok, "/" .. command .. (argument ~= "" and (" " .. argument) or "") .. " → " .. message)
		end
	end)
	refreshPasses()
end

function Debug.Update(_data)
	refreshPasses()
end

function Debug.OnOpen()
	refreshPasses()
end

return Debug
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="70">
            <Properties>
              <string name="Name">House</string>
              <string name="Source"><![CDATA[--[[
	House (ModuleScript) — "🏠 Ma maison"
	Emplacement : ReplicatedStorage > Client > Components > Panels > House

	Grande fenêtre (presque plein écran, s'adapte au téléphone / à la
	tablette) avec deux vues :
	  - VUE D'ENSEMBLE (à l'ouverture, House/HouseOverview) : l'immeuble
	    (studio, appart, loft, manoir) en coupe, chaque pièce dessinée en
	    petit ; clic = zoom dans la pièce ; case vide = "➕ Nouvelle pièce"
	    (choix du type, House/HousePicker) ; "↔ Ranger" = glisser les
	    pièces pour les échanger, "⋯" = ouvrir / changer de type ;
	  - VUE PIÈCE : la pièce kawaii (House/HouseRoom) de la pièce choisie,
	    bouton "⬅ Maison" + onglets des pièces dans le bandeau, type de la
	    pièce (cliquable = changer de type), confort de la pièce ✨ ;
	    mode édition (House/HouseEditor) : glisser, barre d'outils
	    "bonbons" (près de l'objet ; sur téléphone elle prend la place de
	    l'inventaire), annuler / rétablir, aimant 🧲, envoyer dans une autre
	    pièce, dupliquer, retourner, objets posés SUR les meubles, chaises
	    rangées aux tables ; inventaire en bas (toucher un objet rangé = le
	    poser ; ✨ = préféré de cette pièce) ;
	  - "🧊 3D" : aperçu 3D de la pièce (House/House3D, chargé à la demande
	    avec pcall : absent -> petit message "bientôt").
	Les clics dans les cadres (barre, inventaire, tiroir, fenêtres de choix)
	ne traversent jamais jusqu'à la pièce / la maison derrière.
	Bandeau : immeuble et nombre de pièces, confort ❤️ + bonus "+X % de
	Dopamine" (en direct pendant l'édition), boutons "↔ Ranger" /
	"✏️ Modifier" et "🛍️ Boutique" (badge) : rien ne se chevauche sur
	téléphone, tablette ou PC. Tiroir de la boutique (House/HouseShop) à
	droite : la maison se décale pour rester visible.
	Textes en anglais (Locale.T), français dans Lang/FR_HouseUI et
	Lang/FR_HouseRooms.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")

local Client = script.Parent.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local Interface = require(Client.Interface)
local ClientState = require(Client.ClientState)
local SoundManager = require(Client.SoundManager)
local Notifications = require(script.Parent.Parent.Notifications)
local NeedDopamine = require(script.Parent.Parent.NeedDopamine)
local HouseFolder = script.Parent.Parent:WaitForChild("House")
local HouseCommon = require(HouseFolder:WaitForChild("HouseCommon"))
local HouseRoom = require(HouseFolder:WaitForChild("HouseRoom"))
local HouseEditor = require(HouseFolder:WaitForChild("HouseEditor"))
local HouseShop = require(HouseFolder:WaitForChild("HouseShop"))
local HouseArt = require(HouseFolder:WaitForChild("HouseArt"))
local HouseOverview = require(HouseFolder:WaitForChild("HouseOverview"))
local HousePicker = require(HouseFolder:WaitForChild("HousePicker"))
local HouseButtons = require(HouseFolder:WaitForChild("HouseButtons"))
local Locale = require(ReplicatedStorage.Shared.Locale)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)

type HouseData = HouseCommon.HouseData
type Placed = HouseCommon.Placed

-- Title / Subtitle en anglais : traduits par PanelManager
local House = {
	Title = "🏠 My House",
	Subtitle = "Decorate your cozy room: comfort boosts ALL your gains",
	Color = HouseCommon.Colors.Pink,
	Size = Vector2.new(1180, 690),
}

local C = HouseCommon.Colors
local WHITE = Color3.new(1, 1, 1)
local TOP_BAR = 46
local PENDING_PLACE_TIME = 6 -- (s) un objet acheté attend l'état du serveur pour être posé
local FADE_TIME = 0.28

local content: Frame
local main: Frame
local left: Frame
local overviewHolder: Frame
local stage: Frame
local stageFade: Frame
local tray: Frame
local toolDock: Frame -- téléphone : la barre d'outils de l'objet choisi prend la place de l'inventaire
local trayList: ScrollingFrame
local trayEmpty: TextLabel
local emptyHint: Frame
local editHint: Frame
local leftGroup: Frame
local rightGroup: Frame
local backButton: TextButton
local tabsScroller: ScrollingFrame
local houseChip: Frame
local comfortPill: Frame
local comfortLabel: TextLabel
local bonusLabel: TextLabel
local savedChip: Frame
local roomBar: Frame
local typeButton: TextButton
local statsChip: Frame
local dock: TextButton
local undoButton: TextButton
local redoButton: TextButton
local snapButton: TextButton
local arrangeButton: TextButton
local editButton: TextButton
local shopButton: TextButton
local view3DButton: TextButton
local shopBadge: TextLabel
local previewChip: Frame

local room: HouseRoom.Room? = nil
local editor: HouseEditor.Editor? = nil
local shop: HouseShop.Shop? = nil
local overview: HouseOverview.Overview? = nil
local picker: HousePicker.Picker? = nil

local latestHouse: HouseData = HouseCommon.GetHouse(nil)
local isOpen = false
local view = "overview" -- "overview" | "room"
local currentRoomId: string? = nil
local lastRoomId: string? = nil
local forceSync = false
local renderConnection: RBXScriptConnection? = nil
local previewWallpaper: string? = nil
local previewFloor: string? = nil
-- (v9.1) essais de la boutique : boiseries / ambiance / vue (pièce ouverte),
-- façade / toit / motif du toit / déco du jardin (vue de la maison)
local previewLooks: { [string]: string? } = {}
local ROOM_LOOKS = { Trim = true, Mood = true, View = true }
local pendingPlace: { { Id: string, Until: number } } = {}
local pendingPulse: { [string]: number } = {} -- pièces à faire "rebondir" dès qu'elles existent
local pendingSlotPulse: { [number]: number } = {}
local lastComfort: number? = nil
local traySignature = ""
local tabsSignature = ""
local tabsContentWidth = 300
local savedToken = 0
local refreshClock = 0
local closeWatcher = 0
local hasSelection = false
local transitioning = false

----------------------------------------------------------------------
-- Outils
----------------------------------------------------------------------

local function notify(text: string, color: Color3?, title: string?)
	Notifications.Toast(text, color or C.Pink, 3.2, title)
end

local function setChip(chip: Frame, text: string)
	local label = chip:FindFirstChild("Label") :: TextLabel?
	if label and label.Text ~= text then
		label.Text = text
	end
end

local function isPhone(): boolean
	return Interface.IsPhone()
end

local function isEditing(): boolean
	return editor ~= nil and (editor :: HouseEditor.Editor).IsEditing()
end

local function isShopOpen(): boolean
	return shop ~= nil and (shop :: HouseShop.Shop).IsOpen()
end

local function isArranging(): boolean
	return overview ~= nil and (overview :: HouseOverview.Overview).IsArranging()
end

-- Largeur de la zone de contenu (px de maquette)
local function contentWidth(): number
	local size = House.GetSize()
	return size.X - 40
end

local function drawerWidth(): number
	local width = contentWidth()
	if isPhone() then
		return math.floor(math.clamp(width * 0.56, 300, 460))
	end
	return math.floor(math.clamp(width * 0.36, 360, 430))
end

local function overrides(): HouseCommon.Overrides?
	local currentEditor = editor
	return currentEditor and currentEditor.Overrides() or nil
end

local function sortedRooms(): { HouseCommon.Room }
	local rooms = table.clone(latestHouse.Rooms)
	table.sort(rooms, function(a, b)
		return a.Slot < b.Slot
	end)
	return rooms
end

local function currentRoom(): HouseCommon.Room?
	return HouseCommon.GetRoom(latestHouse, currentRoomId)
end

local function roomLabel(roomData: HouseCommon.Room): string
	local roomType = HouseCommon.GetRoomType(roomData)
	return roomType.Icon .. " " .. HouseCommon.Name(roomType)
end

local function currentLayout(): { Placed }
	local currentEditor = editor
	if currentEditor and currentRoomId then
		return currentEditor.GetLayout()
	end
	local roomData = currentRoom()
	return roomData and roomData.Placed or {}
end

----------------------------------------------------------------------
-- Bandeau du haut
----------------------------------------------------------------------

local function refreshHeader()
	local size = HouseCommon.GetSize(latestHouse)
	local roomCount = #latestHouse.Rooms
	if isPhone() then
		setChip(houseChip, string.format("%s %d/%d", size.Icon, roomCount, size.MaxRooms))
	else
		setChip(houseChip, string.format("%s %s  •  %s", size.Icon, HouseCommon.Name(size), Locale.T("%d/%d rooms", roomCount, size.MaxRooms)))
	end
	local comfort = HouseCommon.Comfort(latestHouse, overrides())
	local percent = HouseCommon.BonusPercent(comfort)
	if Interface.Device == "Desktop" then
		comfortLabel.Text = Locale.T("❤️ %d comfort", comfort)
		bonusLabel.Text = Locale.T("+%s%% Dopamine", HouseCommon.FormatPercent(percent))
	else
		comfortLabel.Text = string.format("❤️ %d", comfort)
		bonusLabel.Text = Locale.T("+%s%%", HouseCommon.FormatPercent(percent))
	end
	if lastComfort ~= nil and comfort ~= lastComfort then
		UIUtil.Pop(comfortPill, comfort > (lastComfort :: number) and 1.15 or 0.9, 0.4)
	end
	lastComfort = comfort

	-- Pièce ouverte : type (cliquable), confort de la pièce, harmonie, place
	local roomData = currentRoom()
	if roomData then
		local layout = currentLayout()
		local roomComfort = HouseCommon.RoomComfort(latestHouse, roomData, layout)
		local favorites = 0
		for _, entry in ipairs(layout) do
			local item = HouseCommon.ItemsById[entry.I]
			if item and HouseCommon.IsFavorite(roomData, item) then
				favorites += 1
			end
		end
		local typeText = roomLabel(roomData) .. "  ▾"
		if typeButton.Text ~= typeText then
			typeButton.Text = typeText
		end
		local stats = string.format("❤️ %s", HouseCommon.FormatPercent(roomComfort))
		if favorites > 0 then
			stats ..= string.format("   ✨ %d", favorites)
		end
		stats ..= string.format("   📦 %d/%d", #layout, size.RoomItems)
		setChip(statsChip, stats)
	end
end

local function refreshShopBadge()
	local data = ClientState.Data
	local count = #HouseCommon.AffordableNew(data, HouseCommon.Dopamine())
	UIUtil.SetBadge(shopBadge, count)
end

local function showSaved(status: string)
	savedToken += 1
	local token = savedToken
	local label = savedChip:FindFirstChild("Label") :: TextLabel?
	if status == "idle" then
		savedChip.Visible = false
		return
	end
	savedChip.Visible = view == "room"
	if status == "dirty" then
		setChip(savedChip, Locale.T("✏️ Changes…"))
		savedChip.BackgroundColor3 = C.Cream
	elseif status == "saving" then
		setChip(savedChip, Locale.T("💾 Saving…"))
		savedChip.BackgroundColor3 = C.LilacSoft
	elseif status == "saved" then
		setChip(savedChip, Locale.T("Saved ✓"))
		savedChip.BackgroundColor3 = C.MintSoft
		UIUtil.Pop(savedChip, 1.2, 0.35)
		task.delay(2.2, function()
			if token == savedToken then
				savedChip.Visible = false
			end
		end)
	elseif status == "error" then
		setChip(savedChip, Locale.T("⚠️ Not saved"))
		savedChip.BackgroundColor3 = Color3.fromRGB(255, 214, 214)
	end
	if label then
		label.TextColor3 = C.Ink
	end
end

-- Largeur d'un texte (px de maquette)
local function textWidth(text: string, size: number, font: Enum.Font): number
	local ok, bounds = pcall(function()
		return TextService:GetTextSize(text, size, font, Vector2.new(2000, 100))
	end)
	if ok and typeof(bounds) == "Vector2" then
		return bounds.X
	end
	return #text * size * 0.55
end

-- Largeur d'une pastille-bouton du bandeau
local function pillWidth(button: TextButton): number
	local padding = button:FindFirstChildOfClass("UIPadding")
	local pads = padding and (padding.PaddingLeft.Offset + padding.PaddingRight.Offset) or 32
	return textWidth(button.Text, button.TextSize, button.Font) + pads + 4
end

-- Largeurs du bandeau (px de maquette) : rien ne se chevauche
local function layoutHeader()
	local inRoom = view == "room"
	arrangeButton.Visible = not inRoom
	editButton.Visible = inRoom
	view3DButton.Visible = inRoom
	backButton.Visible = inRoom
	tabsScroller.Visible = inRoom
	houseChip.Visible = not inRoom
	local buttonsWidth = 0
	local gap = 8
	for _, button in ipairs({ arrangeButton, view3DButton, editButton, shopButton }) do
		if button.Visible then
			buttonsWidth += pillWidth(button) + gap
		end
	end
	buttonsWidth = math.max(buttonsWidth + 4, 200)
	rightGroup.Size = UDim2.new(0, buttonsWidth, 1, 0)
	local leftWidth = contentWidth() - buttonsWidth - 10
	leftGroup.Size = UDim2.new(0, leftWidth, 1, 0)
	local backText = isPhone() and "⬅" or Locale.T("⬅ House")
	if backButton.Text ~= backText then
		backButton.Text = backText
	end
	if inRoom then
		local backWidth = pillWidth(backButton)
		local comfortWidth = 28 + 10 + textWidth(comfortLabel.Text, comfortLabel.TextSize, comfortLabel.Font)
			+ textWidth(bonusLabel.Text, bonusLabel.TextSize, bonusLabel.Font)
		local tabsWidth = leftWidth - backWidth - comfortWidth - gap * 2 - 8
		comfortPill.Visible = tabsWidth >= 140
		if not comfortPill.Visible then
			tabsWidth = leftWidth - backWidth - gap - 4
		end
		tabsScroller.Size = UDim2.new(0, math.clamp(tabsContentWidth, 80, math.max(80, tabsWidth)), 1, 0)
	else
		comfortPill.Visible = true
	end
end

-- Dock d'édition : à droite de la barre de la pièce, ou dessous si la
-- place manque (téléphone, boutique ouverte)
local function layoutStageChips()
	local factor = Interface.Scale > 0 and Interface.Scale or 1
	local stageWidth = stage.AbsoluteSize.X / factor
	if stageWidth <= 0 then
		return
	end
	local statsLabel = statsChip:FindFirstChild("Label") :: TextLabel?
	local barWidth = pillWidth(typeButton) + 6 + (statsLabel and textWidth(statsLabel.Text, statsLabel.TextSize, statsLabel.Font) + 26 or 120)
	if savedChip.Visible then
		barWidth += 130
	end
	local dockWidth = 12
	for _, button in ipairs({ undoButton, redoButton, snapButton }) do
		dockWidth += pillWidth(button) + 5
	end
	local rowHeight = (Interface.IsTouch() and Theme.TouchTarget or 34) + 8
	local below = 20 + barWidth + 10 + dockWidth > stageWidth
	dock.Position = UDim2.new(1, -10, 0, below and 8 + rowHeight or 8)
end

----------------------------------------------------------------------
-- Onglets des pièces (vue pièce)
----------------------------------------------------------------------

local openRoom: (roomId: string, instant: boolean?, after: (() -> ())?) -> ()
local open3D: () -> ()

local function refreshTabs()
	local rooms = sortedRooms()
	local parts = { currentRoomId or "", isPhone() and "p" or "d" }
	for _, roomData in ipairs(rooms) do
		table.insert(parts, roomData.Id .. ":" .. roomData.Type)
	end
	local signatureText = table.concat(parts, ",")
	if signatureText == tabsSignature then
		return
	end
	tabsSignature = signatureText
	for _, child in ipairs(tabsScroller:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local height = Interface.IsTouch() and 40 or 34
	local currentButton: TextButton? = nil
	local total = 6
	for index, roomData in ipairs(rooms) do
		local roomType = HouseCommon.GetRoomType(roomData)
		local isCurrent = roomData.Id == currentRoomId
		local named = isCurrent and Interface.Device == "Desktop"
		-- (bonbon rond pour les autres pièces, pastille nommée pour la pièce ouverte)
		local tab = UIUtil.PillButton({
			Name = "Tab_" .. roomData.Id,
			Text = named and roomLabel(roomData) or roomType.Icon,
			Color = isCurrent and C.PinkDeep or WHITE,
			TextColor3 = isCurrent and WHITE or C.Ink,
			Height = height,
			TextSize = named and 15 or 20,
			Round = not named,
			LayoutOrder = index,
			ZIndex = 7,
			StrokeColor = isCurrent and WHITE or nil,
			StrokeThickness = isCurrent and 2 or 1.5,
		})
		tab.Parent = tabsScroller
		if isCurrent then
			currentButton = tab
		end
		total += (named and textWidth(tab.Text, tab.TextSize, tab.Font) + math.floor(height * 0.45) * 2 + 4 or height) + 5
		tab.Activated:Connect(function()
			if roomData.Id ~= currentRoomId then
				SoundManager.Play("Click", 1.2)
				openRoom(roomData.Id, true)
			end
		end)
	end
	tabsContentWidth = total
	task.defer(layoutHeader)
	-- L'onglet courant reste visible
	local current = currentButton
	if current then
		task.defer(function()
			local offset = current.AbsolutePosition.X - tabsScroller.AbsolutePosition.X + tabsScroller.CanvasPosition.X
			local visible = tabsScroller.AbsoluteSize.X
			if offset + current.AbsoluteSize.X > tabsScroller.CanvasPosition.X + visible or offset < tabsScroller.CanvasPosition.X then
				tabsScroller.CanvasPosition = Vector2.new(math.max(0, offset - visible / 2), 0)
			end
		end)
	end
end

----------------------------------------------------------------------
-- Pièce : style (taille, papier peint, sol, aperçus)
----------------------------------------------------------------------

local function applyRoomStyle()
	local currentRoomView = room
	local roomData = currentRoom()
	if not currentRoomView or not roomData then
		return
	end
	local size = HouseCommon.GetSize(latestHouse)
	local wallpaper = (previewWallpaper and HouseCommon.WallpapersById[previewWallpaper]) or HouseCommon.GetRoomWallpaper(roomData)
	local floor = (previewFloor and HouseCommon.FloorsById[previewFloor]) or HouseCommon.GetRoomFloor(roomData)
	currentRoomView.SetStyle(size, wallpaper, floor)
	currentRoomView.SetLooks(
		HouseCommon.Look("Trim", previewLooks.Trim or roomData.Trim),
		HouseCommon.Look("View", previewLooks.View or roomData.View),
		HouseCommon.Look("Mood", previewLooks.Mood or roomData.Mood)
	)
	currentRoomView.SetExterior(size.Exterior)
	local lookPreview = previewLooks.Trim ~= nil or previewLooks.View ~= nil or previewLooks.Mood ~= nil
	previewChip.Visible = view == "room" and (previewWallpaper ~= nil or previewFloor ~= nil or lookPreview)
end

----------------------------------------------------------------------
-- Inventaire (objets possédés pas encore posés)
----------------------------------------------------------------------

local function refreshTray()
	local currentEditor = editor
	if not currentEditor then
		return
	end
	local roomData = currentRoom()
	local entries = {}
	local parts = { currentRoomId or "" }
	for _, item in ipairs(HouseCommon.Config.Items) do
		local free = currentEditor.Available(item.Id)
		if free > 0 then
			local favorite = HouseCommon.IsFavorite(roomData, item)
			table.insert(entries, { Item = item, Free = free, Favorite = favorite, Order = #entries })
			table.insert(parts, item.Id .. "=" .. free)
		end
	end
	-- Les préférés de la pièce d'abord (bonus d'harmonie ✨)
	table.sort(entries, function(a, b)
		if a.Favorite ~= b.Favorite then
			return a.Favorite
		end
		return a.Order < b.Order
	end)
	local signatureText = table.concat(parts, ",") .. (isPhone() and "|p" or "")
	if signatureText == traySignature then
		return
	end
	traySignature = signatureText
	for _, child in ipairs(trayList:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	trayEmpty.Visible = #entries == 0
	local tileSize = isPhone() and 52 or 58
	for index, entry in ipairs(entries) do
		local item = entry.Item
		local holder = UIUtil.Create("Frame", {
			Name = item.Id,
			Size = UDim2.fromOffset(tileSize + 6, tileSize + 8),
			BackgroundTransparency = 1,
			LayoutOrder = index,
			ZIndex = 12,
			Parent = trayList,
		})
		local tile = UIUtil.Create("TextButton", {
			Name = "Tile",
			Size = UDim2.fromOffset(tileSize, tileSize),
			Position = UDim2.fromOffset(0, 6),
			BackgroundColor3 = HouseCommon.CategoryTint(item.Category),
			AutoButtonColor = false,
			Font = Theme.Fonts.Body,
			Text = HouseArt.Has(item.Id) and "" or item.Icon,
			TextSize = math.floor(tileSize * 0.6),
			ZIndex = 13,
			Parent = holder,
		})
		UIUtil.Corner(tile, 14)
		if HouseArt.Has(item.Id) then
			HouseArt.Thumbnail(tile, item, tileSize - 2, 1)
		end
		UIUtil.Stroke(tile, entry.Favorite and C.Butter:Lerp(C.Peach, 0.5) or C.Pink, entry.Favorite and 2.5 or 1.5, 0.2)
		UIUtil.AnimateButton(tile, 1.08, 0.9)
		local badge = UIUtil.Badge(tile, 20)
		badge.BackgroundColor3 = C.PinkDeep
		-- (un peu rentré : le badge et son contour restent dans la rangée qui découpe)
		badge.Position = UDim2.new(1, -5, 0, 6)
		badge.Text = "x" .. entry.Free
		badge.ZIndex = 20
		badge.Visible = true
		if entry.Favorite then
			UIUtil.Create("TextLabel", {
				Name = "Favorite",
				Size = UDim2.fromOffset(20, 20),
				Position = UDim2.fromOffset(2, 2),
				BackgroundTransparency = 1,
				Font = Theme.Fonts.Body,
				Text = "✨",
				TextSize = 15,
				ZIndex = 20,
				Parent = tile,
			})
		end
		tile.Activated:Connect(function()
			local current = editor
			if current then
				current.Place(item.Id)
			end
		end)
	end
end

----------------------------------------------------------------------
-- Mode édition, tiroir de la boutique, dock (annuler / aimant)
----------------------------------------------------------------------

local function refreshDock()
	local currentEditor = editor
	if not currentEditor then
		return
	end
	local canUndo, canRedo = currentEditor.CanUndo(), currentEditor.CanRedo()
	undoButton.BackgroundColor3 = canUndo and WHITE or Color3.fromRGB(236, 232, 238)
	undoButton.TextTransparency = canUndo and 0 or 0.55
	redoButton.BackgroundColor3 = canRedo and WHITE or Color3.fromRGB(236, 232, 238)
	redoButton.TextTransparency = canRedo and 0 or 0.55
	local snap = currentEditor.GetSnap()
	snapButton.BackgroundColor3 = snap and C.Mint or WHITE
	snapButton.TextColor3 = snap and WHITE or C.Ink
	local phone = isPhone()
	undoButton.Text = phone and "↩️" or Locale.T("↩️ Undo")
	redoButton.Text = phone and "↪️" or Locale.T("↪️ Redo")
	snapButton.Text = phone and "🧲" or (snap and Locale.T("🧲 Snap: on") or Locale.T("🧲 Snap: off"))
end

local function layoutLeft(animate: boolean)
	local shopOpen = isShopOpen()
	local editing = isEditing() and view == "room"
	local rightGap = shopOpen and (drawerWidth() + 10) or 0
	local target = UDim2.new(1, -rightGap, 1, 0)
	if animate then
		UIUtil.Tween(left, 0.3, { Size = target }, Enum.EasingStyle.Quint)
	else
		left.Size = target
	end
	local trayHeight = isPhone() and 70 or 82
	tray.Size = UDim2.new(1, 0, 0, trayHeight)
	tray.Visible = editing
	toolDock.Size = UDim2.new(1, 0, 0, trayHeight + 8)
	if not editing then
		toolDock.Visible = false
	end
	local stageTarget = UDim2.new(1, 0, 1, editing and -(trayHeight + 8) or 0)
	if animate then
		UIUtil.Tween(stage, 0.3, { Size = stageTarget }, Enum.EasingStyle.Quint)
	else
		stage.Size = stageTarget
	end
	task.defer(layoutStageChips)
	task.delay(0.32, layoutStageChips)
end

local function refreshEditUi()
	local inRoom = view == "room"
	local editing = isEditing()
	editButton.Text = editing and Locale.T("✅ Done") or Locale.T("✏️ Edit")
	editButton:SetAttribute("BaseColor", editing and Theme.Colors.Green or C.Lilac)
	editButton.BackgroundColor3 = editing and Theme.Colors.Green or C.Lilac
	local arranging = isArranging()
	arrangeButton.Text = arranging and Locale.T("✅ Done") or Locale.T("↔️ Arrange")
	arrangeButton:SetAttribute("BaseColor", arranging and Theme.Colors.Green or C.Lilac)
	arrangeButton.BackgroundColor3 = arranging and Theme.Colors.Green or C.Lilac
	local empty = #currentLayout() == 0
	local shopOpen = isShopOpen()
	emptyHint.Visible = inRoom and empty and not editing and not shopOpen
	editHint.Visible = inRoom and editing and not hasSelection and not shopOpen
	dock.Visible = inRoom and editing
	refreshDock()
	task.defer(layoutHeader)
	task.defer(layoutStageChips)
end

local function setEditing(value: boolean)
	local currentEditor = editor
	if not currentEditor or currentEditor.IsEditing() == value then
		return
	end
	currentEditor.SetEditing(value)
	if value then
		traySignature = ""
		refreshTray()
		SoundManager.Play("Open", 1.3)
	else
		currentEditor.Flush()
		SoundManager.Play("Click", 0.9)
	end
	layoutLeft(true)
	refreshEditUi()
end

local function openShop(section: string?)
	local currentShop = shop
	if not currentShop then
		return
	end
	currentShop.SetWidth(drawerWidth())
	currentShop.Open(section)
	layoutLeft(true)
	refreshEditUi()
end

local function tryPendingPlacements()
	local currentEditor = editor
	if not currentEditor or #pendingPlace == 0 or view ~= "room" then
		return
	end
	local now = os.clock()
	for index = #pendingPlace, 1, -1 do
		local pending = pendingPlace[index]
		if now > pending.Until then
			table.remove(pendingPlace, index)
		elseif currentEditor.Available(pending.Id) > 0 then
			table.remove(pendingPlace, index)
			local ok = currentEditor.CanPlace(pending.Id)
			if ok then
				if not currentEditor.IsEditing() then
					setEditing(true)
				end
				currentEditor.Place(pending.Id)
			else
				notify(Locale.T("This room is full! The new item waits in your inventory 📦"), C.Lilac)
			end
		end
	end
end

----------------------------------------------------------------------
-- Vues : vue d'ensemble <-> pièce
----------------------------------------------------------------------

local function refreshOverview()
	local currentOverview = overview
	if currentOverview and view == "overview" then
		currentOverview.SetHouse(latestHouse, overrides(), previewLooks)
		for roomId, untilTime in pairs(pendingPulse) do
			if os.clock() > untilTime then
				pendingPulse[roomId] = nil
			elseif HouseCommon.GetRoom(latestHouse, roomId) then
				pendingPulse[roomId] = nil
				currentOverview.Pulse(roomId)
			end
		end
		for slot, untilTime in pairs(pendingSlotPulse) do
			local roomAt = HouseCommon.RoomAtSlot(latestHouse, slot)
			if os.clock() > untilTime then
				pendingSlotPulse[slot] = nil
			elseif roomAt then
				pendingSlotPulse[slot] = nil
				currentOverview.Pulse(roomAt.Id)
			end
		end
	end
end

local function setView(newView: string)
	view = newView
	local inRoom = newView == "room"
	overviewHolder.Visible = not inRoom
	stage.Visible = inRoom
	roomBar.Visible = inRoom
	-- Les animaux ne vivent que quand la pièce est affichée
	local currentEditor = editor
	if currentEditor then
		currentEditor.SetLive(inRoom)
	end
	if not inRoom then
		savedChip.Visible = false
		previewChip.Visible = false
		local currentOverview = overview
		if currentOverview then
			currentOverview.SetArranging(false)
		end
	end
	layoutLeft(false)
	refreshHeader()
	refreshEditUi()
	layoutHeader()
end

local function showRoomNow(roomId: string)
	local currentEditor = editor :: HouseEditor.Editor
	local currentRoomView = room :: HouseRoom.Room
	currentRoomId = roomId
	lastRoomId = roomId
	previewWallpaper, previewFloor = nil, nil
	table.clear(previewLooks)
	currentEditor.SetRoom(roomId)
	setView("room")
	applyRoomStyle()
	refreshTabs()
	traySignature = ""
	refreshTray()
	refreshHeader()
	refreshEditUi()
	task.defer(currentRoomView.Refit)
	local currentShop = shop
	if currentShop and currentShop.IsOpen() then
		currentShop.Refresh()
	end
end

openRoom = function(roomId: string, instant: boolean?, after: (() -> ())?)
	if transitioning or not HouseCommon.GetRoom(latestHouse, roomId) then
		return
	end
	local currentOverview = overview
	local function finish()
		transitioning = false
		showRoomNow(roomId)
		-- Fondu d'arrivée dans la pièce
		stageFade.Visible = true
		stageFade.BackgroundTransparency = 0
		UIUtil.Tween(stageFade, FADE_TIME, { BackgroundTransparency = 1 })
		task.delay(FADE_TIME, function()
			stageFade.Visible = false
		end)
		tryPendingPlacements()
		if after then
			after()
		end
	end
	if view == "overview" and not instant and currentOverview then
		transitioning = true
		currentOverview.ZoomIn(roomId, finish)
	else
		finish()
	end
end

local function backToOverview()
	if view ~= "room" or transitioning then
		return
	end
	local currentEditor = editor
	if currentEditor then
		if currentEditor.IsEditing() then
			setEditing(false)
		end
		currentEditor.Flush()
	end
	previewWallpaper, previewFloor = nil, nil
	table.clear(previewLooks)
	local leaving = currentRoomId
	currentRoomId = nil
	setView("overview")
	refreshOverview()
	local currentOverview = overview
	if currentOverview then
		currentOverview.ZoomOut(leaving)
	end
	local currentShop = shop
	if currentShop and currentShop.IsOpen() then
		currentShop.Refresh()
	end
	SoundManager.Play("Click", 0.9)
end

----------------------------------------------------------------------
-- Pièces : achat, type, rangement, envoi d'objets
----------------------------------------------------------------------

local function invoke(action: string, argument: any, onDone: ((ok: boolean, message: string?) -> ())?)
	task.spawn(function()
		local ok, message = HouseCommon.Invoke(action, argument)
		if onDone then
			onDone(ok, message)
		end
	end)
end

local function harmonyText(): string
	return HouseCommon.FormatPercent((HouseCommon.Config.HarmonyBonus or 0) * 100)
end

local function buyRoomAt(slot: number)
	local currentPicker = picker
	if not currentPicker then
		return
	end
	local size = HouseCommon.GetSize(latestHouse)
	local cost = HouseCommon.RoomCost(latestHouse)
	currentPicker.ShowRoomTypes({
		Title = Locale.T("🏗️ New room  •  💧 %s", NumberFormatter.Format(cost)),
		Subtitle = Locale.T("Room %d/%d — its favourite items give ✨ +%s%% comfort", #latestHouse.Rooms + 1, size.MaxRooms, harmonyText()),
		OnPick = function(typeId: string)
			local price = HouseCommon.RoomCost(latestHouse)
			local dopamine = HouseCommon.Dopamine()
			local roomType = HouseCommon.RoomTypesById[typeId]
			-- (ce qu'on achète, montré dans la fenêtre "pas assez de Dopamine")
			local context = roomType and { Icon = roomType.Icon, Name = HouseCommon.Name(roomType), Color = C.Mint } or nil
			if dopamine < price then
				local missing = price - dopamine
				NeedDopamine.Offer(missing, function()
					notify(Locale.T("You need %s more Dopamine", NumberFormatter.Format(missing)), Theme.Colors.Red)
				end, context)
				return
			end
			invoke("buyRoom", { Type = typeId, Slot = slot }, function(ok: boolean, message: string?)
				if ok then
					SoundManager.Play("Buy", 1.1)
					notify(message or Locale.T("New room!"), Theme.Colors.Green, Locale.T("🏠 New room"))
					pendingSlotPulse[slot] = os.clock() + PENDING_PLACE_TIME
					refreshOverview()
				else
					SoundManager.Play("Error", 0.8)
					-- Refus du serveur "pas assez de Dopamine" : la fenêtre, à chaque fois
					local okOffer, shown = pcall(NeedDopamine.OfferRefusal, message, price, nil, context)
					if not (okOffer and shown == true) then
						notify(message or Locale.T("Network error, try again."), Theme.Colors.Red)
					end
				end
			end)
		end,
	})
end

local function changeRoomType(roomId: string)
	local currentPicker = picker
	local roomData = HouseCommon.GetRoom(latestHouse, roomId)
	if not currentPicker or not roomData then
		return
	end
	currentPicker.ShowRoomTypes({
		Title = Locale.T("🔄 Change room type"),
		Subtitle = Locale.T("Free! Items stay where they are  •  favourites give ✨ +%s%% comfort", harmonyText()),
		Current = roomData.Type,
		OnPick = function(typeId: string)
			invoke("setRoomType", { Room = roomId, Type = typeId }, function(ok: boolean, message: string?)
				notify(message or "", ok and Theme.Colors.Green or Theme.Colors.Red)
				if ok then
					pendingPulse[roomId] = os.clock() + PENDING_PLACE_TIME
				end
			end)
		end,
	})
end

local function roomMenu(roomId: string)
	local currentPicker = picker
	local roomData = HouseCommon.GetRoom(latestHouse, roomId)
	if not currentPicker or not roomData then
		return
	end
	currentPicker.ShowMenu({
		Title = roomLabel(roomData),
		Subtitle = Locale.T("Drag the room onto another spot to move it"),
		Buttons = {
			{ Text = Locale.T("🚪 Go inside"), Color = C.MintSoft, OnClick = function()
				local currentOverview = overview
				if currentOverview then
					currentOverview.SetArranging(false)
				end
				refreshEditUi()
				openRoom(roomId)
			end },
			{ Text = Locale.T("🔄 Change type"), Color = C.LilacSoft, OnClick = function()
				task.delay(0.16, function()
					changeRoomType(roomId)
				end)
			end },
			{ Text = Locale.T("🧊 3D"), Color = Color3.fromRGB(214, 236, 255), OnClick = function()
				local currentOverview = overview
				if currentOverview then
					currentOverview.SetArranging(false)
				end
				refreshEditUi()
				openRoom(roomId, false, function()
					open3D()
				end)
			end },
		},
	})
end

local function moveRoom(roomId: string, slot: number)
	invoke("moveRoom", { Room = roomId, Slot = slot }, function(ok: boolean, message: string?)
		if not ok then
			local currentOverview = overview
			if currentOverview then
				currentOverview.CancelMoves()
			end
			SoundManager.Play("Error", 0.8)
			notify(message or Locale.T("Network error, try again."), Theme.Colors.Red)
		end
	end)
end

local function askSendTarget(entry: Placed)
	local currentPicker = picker
	local currentEditor = editor
	local item = HouseCommon.ItemsById[entry.I]
	if not currentPicker or not currentEditor or not item then
		return
	end
	local counts: { [string]: number } = {}
	local current = currentEditor.Overrides()
	for _, roomData in ipairs(latestHouse.Rooms) do
		counts[roomData.Id] = #(current[roomData.Id] or roomData.Placed)
	end
	currentPicker.ShowRooms({
		Title = Locale.T("🚪 Send %s to…", item.Icon .. " " .. HouseCommon.Name(item)),
		Subtitle = Locale.T("It lands on a free spot of that room"),
		House = latestHouse,
		ExcludeId = currentRoomId,
		Item = item,
		Counts = counts,
		OnPick = function(targetId: string)
			local active = editor
			if active then
				active.SendTo(targetId)
			end
		end,
	})
end

----------------------------------------------------------------------
-- 🧊 Aperçu 3D (House/House3D, écrit à part : chargé à la demande et
-- protégé par pcall ; absent -> petit message "bientôt")
----------------------------------------------------------------------

local house3D: any = nil

local function loadHouse3D(): any
	if house3D then
		return house3D
	end
	local moduleScript = HouseFolder:FindFirstChild("House3D")
	if not moduleScript or not moduleScript:IsA("ModuleScript") then
		return nil
	end
	local ok, result = pcall(require, moduleScript)
	if ok and type(result) == "table" and type(result.Open) == "function" then
		house3D = result
		return result
	end
	warn("[House] House3D : " .. tostring(result))
	return nil
end

local function is3DOpen(): boolean
	local module = house3D
	if not module or type(module.IsOpen) ~= "function" then
		return false
	end
	local ok, value = pcall(module.IsOpen)
	return ok and value == true
end

open3D = function()
	local roomData = currentRoom()
	if view ~= "room" or not roomData then
		return
	end
	local module = loadHouse3D()
	if not module then
		SoundManager.Play("Click", 1.1)
		UIUtil.Shake(view3DButton)
		notify(Locale.T("🧊 3D view: coming soon!"), C.Lilac)
		return
	end
	local currentEditor = editor
	if currentEditor then
		-- (la disposition en cours part tout de suite au serveur)
		currentEditor.Flush()
	end
	-- Pièce telle qu'on la voit (disposition locale comprise)
	local placed = {}
	for _, entry in ipairs(currentLayout()) do
		table.insert(placed, { I = entry.I, X = entry.X, Y = entry.Y, S = entry.S, Z = entry.Z, F = entry.F == true or nil, C = entry.C })
	end
	-- (v9.1) boiseries, ambiance et vue de la fenêtre : aussi en 3D
	local record = {
		Id = roomData.Id,
		Type = roomData.Type,
		Slot = roomData.Slot,
		Wallpaper = roomData.Wallpaper,
		Floor = roomData.Floor,
		Trim = roomData.Trim,
		Mood = roomData.Mood,
		View = roomData.View,
		Placed = placed,
	}
	SoundManager.Play("Open", 1.2)
	local ok, opened = pcall(module.Open, {
		Room = record,
		House = latestHouse,
		SizeId = latestHouse.Size,
		Title = roomLabel(roomData),
		OnClose = function()
			SoundManager.Play("Click", 0.9)
		end,
	})
	-- (Open renvoie false si la vue n'a pas pu se construire)
	if not ok or opened == false then
		if not ok then
			warn("[House] House3D.Open : " .. tostring(opened))
		end
		notify(Locale.T("🧊 3D view: coming soon!"), C.Lilac)
	end
end

----------------------------------------------------------------------
-- Construction (à la première ouverture)
----------------------------------------------------------------------

local function ensureBuilt()
	if room then
		return
	end
	local newRoom = HouseRoom.new(stage)
	room = newRoom
	newRoom.SetDark(ClientState.DarkMode)

	local newEditor = HouseEditor.new(newRoom, function(text: string, color: Color3?)
		notify(text, color)
	end)
	editor = newEditor
	newEditor.Changed:Connect(function()
		refreshHeader()
		refreshTray()
		refreshEditUi()
		local currentShop = shop
		if currentShop then
			currentShop.Refresh()
		end
	end)
	newEditor.SaveStatusChanged:Connect(showSaved)
	newEditor.SelectionChanged:Connect(function(entry)
		hasSelection = entry ~= nil
		refreshEditUi()
	end)
	newEditor.HistoryChanged:Connect(refreshDock)
	newEditor.SetSendHandler(askSendTarget)
	newEditor.SetDockHost(toolDock)

	picker = HousePicker.new(content)

	local newOverview = HouseOverview.new(overviewHolder, {
		OnOpenRoom = function(roomId: string)
			openRoom(roomId)
		end,
		OnEmptySlot = buyRoomAt,
		OnMoveRoom = moveRoom,
		OnRoomMenu = roomMenu,
	})
	overview = newOverview
	newOverview.SetDark(ClientState.DarkMode)

	-- Contrat B (HouseShop) : handlers passés tels quels (champs ajoutés en parallèle)
	local handlers = {
		Notify = notify,
		OnItemBought = function(itemId: string)
			if view == "room" then
				table.insert(pendingPlace, { Id = itemId, Until = os.clock() + PENDING_PLACE_TIME })
				tryPendingPlacements()
			end
		end,
		OnPlaceRequest = function(itemId: string)
			local function place()
				local current = editor
				if not current then
					return
				end
				if not current.IsEditing() then
					setEditing(true)
				end
				current.Place(itemId)
			end
			if view == "room" then
				place()
			else
				local target = lastRoomId and HouseCommon.GetRoom(latestHouse, lastRoomId) or sortedRooms()[1]
				if target then
					openRoom(target.Id, false, place)
				end
			end
		end,
		OnPreview = function(kind: string, id: string?)
			if kind ~= "Wallpaper" and kind ~= "Floor" and not ROOM_LOOKS[kind] then
				-- (v9.1) extérieur : essayé sur la façade (vue de la maison)
				if previewLooks[kind] == id then
					return
				end
				previewLooks[kind] = id
				refreshOverview()
				return
			end
			if view ~= "room" then
				return
			end
			if kind == "Wallpaper" then
				previewWallpaper = id
			elseif kind == "Floor" then
				previewFloor = id
			else
				previewLooks[kind] = id
			end
			applyRoomStyle()
		end,
		OnHouseChanged = function()
			forceSync = not newEditor.IsBusy()
		end,
		BeforeHouseChange = function()
			newEditor.Flush()
		end,
		GetAvailable = function(itemId: string): number
			return newEditor.Available(itemId)
		end,
		GetCurrentRoom = function(): string?
			return view == "room" and currentRoomId or nil
		end,
		OnRoomBought = function(roomId: string)
			pendingPulse[roomId] = os.clock() + PENDING_PLACE_TIME
			refreshOverview()
		end,
		OnSizeChanged = function()
			forceSync = true
			refreshOverview()
			refreshHeader()
		end,
	}
	shop = HouseShop.new(main, handlers :: any)
	local drawerFrame = (shop :: HouseShop.Shop).Frame
	drawerFrame:GetPropertyChangedSignal("Visible"):Connect(function()
		if not drawerFrame.Visible then
			previewWallpaper, previewFloor = nil, nil
			table.clear(previewLooks)
			applyRoomStyle()
			refreshOverview()
			layoutLeft(true)
			refreshEditUi()
		end
	end)

	newEditor.Sync(latestHouse, true)
	setView("overview")
end

----------------------------------------------------------------------
-- Construction de la fenêtre
----------------------------------------------------------------------

-- Pastille-bouton du bandeau
local function barButton(name: string, text: string, color: Color3, order: number): TextButton
	local height = Interface.IsTouch() and Theme.TouchTarget or 36
	local button = UIUtil.PillButton({
		Name = name,
		Text = text,
		Color = color,
		TextColor3 = WHITE,
		Height = height,
		TextSize = 16,
		LayoutOrder = order,
		ZIndex = 6,
	})
	local stroke = UIUtil.Create("UIStroke", {
		Color = Theme.Colors.TextDark,
		Thickness = 1,
		Transparency = 0.6,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
	})
	stroke.Parent = button
	return button
end

-- Petit bouton blanc du dock / de la barre de la pièce
local function smallButton(name: string, text: string, order: number, parent: Instance): TextButton
	local height = Interface.IsTouch() and Theme.TouchTarget or 34
	local button = UIUtil.PillButton({
		Name = name,
		Text = text,
		Color = WHITE,
		TextColor3 = C.Ink,
		Height = height,
		TextSize = 15,
		LayoutOrder = order,
		ZIndex = 21,
		StrokeColor = C.Pink,
		StrokeTransparency = 0.3,
	})
	button.Parent = parent
	return button
end

function House.GetSize(): Vector2
	local canvas = Interface.CanvasSize
	local width = math.clamp(canvas.X * 0.94, 640, 1240)
	local height = math.clamp(canvas.Y * 0.94, 420, 720)
	return Vector2.new(math.floor(width), math.floor(height))
end

function House.Build(frame: Frame)
	content = frame

	-- Bandeau du haut
	local topBar = UIUtil.Create("Frame", {
		Name = "TopBar",
		Size = UDim2.new(1, 0, 0, TOP_BAR),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = content,
	})
	leftGroup = UIUtil.Create("Frame", {
		Name = "Info",
		Size = UDim2.new(1, -360, 1, 0),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		ZIndex = 5,
		Parent = topBar,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		Parent = leftGroup,
	})
	UIUtil.Create("UIPadding", { PaddingLeft = UDim.new(0, 2), Parent = leftGroup })

	-- Vue pièce : retour + onglets des pièces
	backButton = barButton("Back", Locale.T("⬅ House"), C.PinkDeep, 1)
	backButton.Parent = leftGroup
	backButton.Visible = false
	tabsScroller = UIUtil.Create("ScrollingFrame", {
		Name = "Tabs",
		Size = UDim2.new(0, 300, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollingDirection = Enum.ScrollingDirection.X,
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 0,
		LayoutOrder = 2,
		Visible = false,
		ZIndex = 6,
		Parent = leftGroup,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 5),
		Parent = tabsScroller,
	})
	-- (marges : les contours des onglets ne sont pas coupés)
	UIUtil.Create("UIPadding", { PaddingLeft = UDim.new(0, 3), PaddingRight = UDim.new(0, 3), Parent = tabsScroller })

	houseChip = UIUtil.Chip({
		Name = "HouseChip",
		Text = "🏠",
		Color = C.PinkMist,
		TextColor3 = C.Ink,
		Height = 32,
		TextSize = 15,
		LayoutOrder = 3,
		ZIndex = 6,
		Parent = leftGroup,
	})

	-- Confort + bonus (pilule rose)
	comfortPill = UIUtil.Create("Frame", {
		Name = "Comfort",
		Size = UDim2.fromOffset(0, 36),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = C.Pink,
		LayoutOrder = 4,
		ZIndex = 6,
		Parent = leftGroup,
	})
	UIUtil.Corner(comfortPill, UDim.new(1, 0))
	UIUtil.Stroke(comfortPill, WHITE, 2, 0.2)
	UIUtil.Gradient(comfortPill, ColorSequence.new(C.Pink:Lerp(WHITE, 0.15), C.PinkDeep), 0)
	UIUtil.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 14),
		PaddingRight = UDim.new(0, 14),
		Parent = comfortPill,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 10),
		Parent = comfortPill,
	})
	comfortLabel = UIUtil.Create("TextLabel", {
		Name = "Comfort",
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = "",
		TextColor3 = WHITE,
		TextSize = 17,
		LayoutOrder = 1,
		ZIndex = 7,
		Parent = comfortPill,
	})
	bonusLabel = UIUtil.Create("TextLabel", {
		Name = "Bonus",
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		Text = "",
		TextColor3 = C.PinkMist,
		TextSize = 15,
		LayoutOrder = 2,
		ZIndex = 7,
		Parent = comfortPill,
	})
	for _, label in ipairs({ comfortLabel, bonusLabel }) do
		UIUtil.Create("UIStroke", {
			Color = C.PinkDeep:Lerp(Color3.new(0, 0, 0), 0.4),
			Thickness = 1,
			Transparency = 0.5,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
			Parent = label,
		})
	end

	-- Boutons (à droite)
	rightGroup = UIUtil.Create("Frame", {
		Name = "Buttons",
		Size = UDim2.new(0, 350, 1, 0),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = topBar,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		Parent = rightGroup,
	})
	arrangeButton = barButton("Arrange", Locale.T("↔️ Arrange"), C.Lilac, 1)
	arrangeButton.Parent = rightGroup
	-- Aperçu 3D de la pièce (House/House3D, chargé à la demande)
	view3DButton = barButton("View3D", Locale.T("🧊 3D"), Color3.fromRGB(92, 172, 238), 2)
	view3DButton.Parent = rightGroup
	view3DButton.Visible = false
	HouseButtons.Tip(view3DButton, function()
		return Locale.T("See this room in 3D")
	end)
	editButton = barButton("Edit", Locale.T("✏️ Edit"), C.Lilac, 3)
	editButton.Parent = rightGroup
	editButton.Visible = false
	shopButton = barButton("Shop", Locale.T("🛍️ Shop"), C.PinkDeep, 4)
	shopButton.Parent = rightGroup
	-- Badge DANS la pastille, à droite du texte (ne cache plus "Boutique" et ne
	-- déborde pas du bord de la fenêtre) : la pastille s'élargit quand il est là
	shopBadge = UIUtil.Badge(shopButton, 20)
	shopBadge.AnchorPoint = Vector2.new(1, 0.5)
	do
		local padding = shopButton:FindFirstChildOfClass("UIPadding")
		local basePad = padding and padding.PaddingRight.Offset or 16
		local function placeBadge()
			local right = shopBadge.Visible and basePad + 30 or basePad
			if padding then
				padding.PaddingRight = UDim.new(0, right)
			end
			shopBadge.Position = UDim2.new(1, right - 6, 0.5, 0)
			task.defer(layoutHeader)
		end
		shopBadge:GetPropertyChangedSignal("Visible"):Connect(placeBadge)
		placeBadge()
	end

	-- Zone principale : maison / pièce (+ inventaire) à gauche, tiroir de la boutique à droite
	main = UIUtil.Create("Frame", {
		Name = "Main",
		Size = UDim2.new(1, 0, 1, -(TOP_BAR + 6)),
		Position = UDim2.fromOffset(0, TOP_BAR + 6),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = content,
	})
	left = UIUtil.Create("Frame", {
		Name = "Left",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = main,
	})
	overviewHolder = UIUtil.Create("Frame", {
		Name = "OverviewHolder",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = left,
	})
	stage = UIUtil.Create("Frame", {
		Name = "Stage",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.PinkMist,
		Visible = false,
		ZIndex = 5,
		Parent = left,
	})
	UIUtil.Corner(stage, 20)
	UIUtil.Gradient(stage, ColorSequence.new(WHITE, Color3.fromRGB(236, 236, 240)), 90)
	stage:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		layoutStageChips()
	end)
	stageFade = UIUtil.Create("Frame", {
		Name = "Fade",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 40,
		Parent = stage,
	})
	UIUtil.Corner(stageFade, 20)

	-- Barre de la pièce (en haut à gauche) : type (cliquable), confort, sauvegarde
	roomBar = UIUtil.Create("Frame", {
		Name = "RoomBar",
		Size = UDim2.new(1, -20, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Position = UDim2.fromOffset(10, 8),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 20,
		Parent = stage,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6),
		Parent = roomBar,
	})
	typeButton = smallButton("RoomType", "", 1, roomBar)
	typeButton.BackgroundColor3 = WHITE
	statsChip = UIUtil.Chip({
		Name = "RoomStats",
		Text = "",
		Color = WHITE,
		TextColor3 = C.Ink,
		Height = 28,
		TextSize = 14,
		LayoutOrder = 2,
		ZIndex = 21,
		Parent = roomBar,
	})
	statsChip.BackgroundTransparency = 0.1
	HouseButtons.Sink(statsChip)
	savedChip = UIUtil.Chip({
		Name = "Saved",
		Text = "",
		Color = C.MintSoft,
		TextColor3 = C.Ink,
		Height = 26,
		TextSize = 13,
		LayoutOrder = 3,
		ZIndex = 21,
		Visible = false,
		Parent = roomBar,
	})
	HouseButtons.Sink(savedChip)

	-- Dock d'édition (en haut à droite) : annuler / rétablir / aimant
	-- (bouton sans action : un clic entre deux boutons ne traverse pas)
	dock = HouseButtons.Container({
		Name = "Dock",
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 8),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.15,
		Visible = false,
		ZIndex = 22,
		Parent = stage,
	})
	UIUtil.Corner(dock, UDim.new(1, 0))
	UIUtil.Stroke(dock, C.Pink, 1.5, 0.3)
	UIUtil.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 5),
		PaddingRight = UDim.new(0, 5),
		PaddingTop = UDim.new(0, 4),
		PaddingBottom = UDim.new(0, 4),
		Parent = dock,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 5),
		Parent = dock,
	})
	undoButton = smallButton("Undo", "↩️", 1, dock)
	redoButton = smallButton("Redo", "↪️", 2, dock)
	snapButton = smallButton("Snap", "🧲", 3, dock)
	HouseButtons.Tip(undoButton, function()
		return HouseButtons.TipText("Undo", "( Ctrl+Z )")
	end)
	HouseButtons.Tip(redoButton, function()
		return HouseButtons.TipText("Redo", "( Ctrl+Y )")
	end)
	HouseButtons.Tip(snapButton, function()
		return HouseButtons.TipText("Snap to grid", "( G )")
	end)

	-- "Aperçu" (essai d'un papier peint / sol)
	previewChip = UIUtil.Chip({
		Name = "PreviewChip",
		Text = Locale.T("👀 Preview"),
		Color = C.Butter,
		TextColor3 = C.Ink,
		Height = 26,
		TextSize = 14,
		ZIndex = 20,
		Visible = false,
		Parent = stage,
	})
	previewChip.AnchorPoint = Vector2.new(0.5, 1)
	previewChip.Position = UDim2.new(0.5, 0, 1, -38)
	HouseButtons.Sink(previewChip)

	-- Astuce en mode édition
	editHint = UIUtil.Chip({
		Name = "EditHint",
		Text = Locale.T("✋ Drag to move  •  🧁 small items go ON furniture  •  🪑 chairs snap to tables"),
		Color = WHITE,
		TextColor3 = C.Ink,
		Height = 24,
		TextSize = 13,
		ZIndex = 20,
		Visible = false,
		Parent = stage,
	})
	editHint.AnchorPoint = Vector2.new(0.5, 1)
	editHint.Position = UDim2.new(0.5, 0, 1, -6)
	HouseButtons.Sink(editHint)

	-- Pièce vide : invitation à ouvrir la boutique
	emptyHint = UIUtil.Create("Frame", {
		Name = "EmptyHint",
		Size = UDim2.fromOffset(340, 132),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.56),
		BackgroundColor3 = WHITE,
		Visible = false,
		ZIndex = 20,
		Parent = stage,
	})
	UIUtil.Corner(emptyHint, 20)
	UIUtil.Stroke(emptyHint, C.Pink, 2, 0.2)
	UIUtil.SinkClicks(emptyHint)
	UIUtil.Label({
		Name = "Text",
		Size = UDim2.new(1, -24, 0, 62),
		Position = UDim2.fromOffset(12, 10),
		Font = Theme.Fonts.Title,
		Text = Locale.T("This room is empty! 🥺\nPlace cute furniture to make it cozy."),
		TextColor3 = C.Ink,
		TextWrapped = true,
		MaxTextSize = 17,
		ZIndex = 21,
		Parent = emptyHint,
	})
	local emptyButton = UIUtil.NeonButton({
		Name = "Decorate",
		Text = Locale.T("✏️ Decorate"),
		Size = UDim2.new(0.5, -18, 0, 40),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 12, 1, -12),
		Color = C.Lilac,
		TextColor3 = WHITE,
		CornerRadius = 20,
		MaxTextSize = 17,
		ZIndex = 21,
		Parent = emptyHint,
	})
	local emptyShopButton = UIUtil.NeonButton({
		Name = "OpenShop",
		Text = Locale.T("🛍️ Shop"),
		Size = UDim2.new(0.5, -18, 0, 40),
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -12, 1, -12),
		Color = C.PinkDeep,
		TextColor3 = WHITE,
		CornerRadius = 20,
		MaxTextSize = 17,
		ZIndex = 21,
		Parent = emptyHint,
	})

	-- Inventaire (mode édition)
	tray = UIUtil.Create("Frame", {
		Name = "Inventory",
		Size = UDim2.new(1, 0, 0, 82),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = WHITE,
		Visible = false,
		ZIndex = 10,
		Parent = left,
	})
	UIUtil.Corner(tray, 18)
	UIUtil.Stroke(tray, C.Pink, 1.5, 0.3)
	UIUtil.SinkClicks(tray)
	-- (téléphone) barre d'outils de l'objet choisi, par-dessus l'inventaire
	toolDock = UIUtil.Create("Frame", {
		Name = "ToolDock",
		Size = UDim2.new(1, 0, 0, 90),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = C.PinkMist,
		Visible = false,
		ZIndex = 26,
		Parent = left,
	})
	UIUtil.Corner(toolDock, 18)
	UIUtil.Stroke(toolDock, C.Pink, 1.5, 0.2)
	UIUtil.Gradient(toolDock, ColorSequence.new(WHITE, Color3.fromRGB(255, 232, 244)), 90)
	UIUtil.SinkClicks(toolDock)
	UIUtil.Create("TextLabel", {
		Name = "Title",
		Size = UDim2.new(0, 104, 1, -12),
		Position = UDim2.fromOffset(12, 6),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = Locale.T("📦 Inventory\ntap to place"),
		TextColor3 = C.Ink,
		TextSize = 14,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 11,
		Parent = tray,
	})
	trayList = UIUtil.Create("ScrollingFrame", {
		Name = "List",
		Size = UDim2.new(1, -128, 1, -4),
		Position = UDim2.fromOffset(120, 2),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollingDirection = Enum.ScrollingDirection.X,
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = C.Pink,
		ZIndex = 11,
		Parent = tray,
	})
	-- Marge à gauche : le contour de la première tuile n'est pas coupé
	UIUtil.Create("UIPadding", { PaddingLeft = UDim.new(0, 3), PaddingRight = UDim.new(0, 3), Parent = trayList })
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6),
		Parent = trayList,
	})
	trayEmpty = UIUtil.Create("TextLabel", {
		Name = "Empty",
		Size = UDim2.new(1, -140, 1, 0),
		Position = UDim2.fromOffset(124, 0),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		Text = Locale.T("Everything is placed! Buy more cute stuff in the 🛍️ Shop."),
		TextColor3 = Theme.Colors.TextDim,
		TextSize = 14,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 11,
		Parent = tray,
	})

	-- Boutons
	editButton.Activated:Connect(function()
		ensureBuilt()
		local currentEditor = editor
		if currentEditor and view == "room" then
			setEditing(not currentEditor.IsEditing())
		end
	end)
	arrangeButton.Activated:Connect(function()
		ensureBuilt()
		local currentOverview = overview
		if currentOverview and view == "overview" then
			currentOverview.SetArranging(not currentOverview.IsArranging())
			SoundManager.Play(currentOverview.IsArranging() and "Open" or "Click", 1.2)
			refreshEditUi()
		end
	end)
	shopButton.Activated:Connect(function()
		ensureBuilt()
		local currentShop = shop
		if currentShop and currentShop.IsOpen() then
			currentShop.Close()
		else
			openShop(nil)
		end
	end)
	backButton.Activated:Connect(backToOverview)
	view3DButton.Activated:Connect(open3D)
	typeButton.Activated:Connect(function()
		if currentRoomId then
			changeRoomType(currentRoomId :: string)
		end
	end)
	undoButton.Activated:Connect(function()
		local currentEditor = editor
		if currentEditor then
			currentEditor.Undo()
		end
	end)
	redoButton.Activated:Connect(function()
		local currentEditor = editor
		if currentEditor then
			currentEditor.Redo()
		end
	end)
	snapButton.Activated:Connect(function()
		local currentEditor = editor
		if currentEditor then
			currentEditor.SetSnap(not currentEditor.GetSnap())
			notify(currentEditor.GetSnap() and Locale.T("🧲 Items now snap to the grid") or Locale.T("🧲 Free placement"), C.Lilac)
		end
	end)
	emptyButton.Activated:Connect(function()
		setEditing(true)
	end)
	emptyShopButton.Activated:Connect(function()
		ensureBuilt()
		openShop("Items")
	end)

	-- Mode sombre : la maison et la pièce passent en mode nuit
	-- Dopamine qui change (petits ticks du serveur) : prix abordables et
	-- badge de la boutique à jour, 4 fois par seconde au plus
	if ClientState.DopamineChanged then
		local pending = false
		local lastRefresh = 0
		ClientState.DopamineChanged:Connect(function()
			if not isOpen or pending then
				return
			end
			pending = true
			task.delay(math.max(0, 0.25 - (os.clock() - lastRefresh)), function()
				pending = false
				lastRefresh = os.clock()
				if not isOpen then
					return
				end
				refreshShopBadge()
				local currentShop = shop
				if currentShop and currentShop.IsOpen() then
					currentShop.Refresh()
				end
			end)
		end)
	end

	ClientState.DarkModeChanged:Connect(function(dark: boolean)
		local currentRoomView = room
		if currentRoomView then
			currentRoomView.SetDark(dark)
		end
		local currentOverview = overview
		if currentOverview then
			currentOverview.SetDark(dark)
		end
	end)
	-- Écran qui change : tiroir, inventaire, bandeau
	Interface.DeviceChanged:Connect(function()
		local currentShop = shop
		if currentShop then
			currentShop.SetWidth(drawerWidth())
		end
		traySignature = ""
		tabsSignature = ""
		refreshTray()
		refreshTabs()
		refreshHeader()
		refreshEditUi()
		if room then
			layoutLeft(false)
		end
	end)

	refreshHeader()
	refreshEditUi()
end

function House.Update(data)
	local previousSize = latestHouse.Size
	latestHouse = HouseCommon.GetHouse(data)
	-- Nouvelle taille de maison : le serveur a recalé les objets, on reprend
	-- sa disposition telle quelle
	if previousSize ~= latestHouse.Size then
		forceSync = true
	end
	-- La pièce ouverte n'existe plus (ne devrait pas arriver) : retour à la maison
	if view == "room" and not currentRoom() then
		backToOverview()
	end
	local currentEditor = editor
	if currentEditor then
		local force = forceSync
		forceSync = false
		currentEditor.Sync(latestHouse, force)
		applyRoomStyle()
		tryPendingPlacements()
		refreshTray()
		if view == "room" then
			refreshTabs()
		end
		refreshEditUi()
	end
	if isOpen then
		refreshOverview()
	end
	refreshHeader()
	refreshShopBadge()
	if isOpen and shop then
		(shop :: HouseShop.Shop).Refresh()
	end
end

function House.OnOpen()
	isOpen = true
	closeWatcher += 1
	ensureBuilt()
	local currentEditor = editor :: HouseEditor.Editor
	local currentRoomView = room :: HouseRoom.Room
	local currentOverview = overview :: HouseOverview.Overview
	currentEditor.SetActive(true)
	if not currentEditor.IsBusy() then
		currentEditor.Sync(latestHouse, false)
	end
	-- "🏠 Ma maison" s'ouvre sur la vue d'ensemble
	currentRoomId = nil
	setView("overview")
	currentRoomView.SetDark(ClientState.DarkMode)
	currentOverview.SetDark(ClientState.DarkMode)
	refreshOverview()
	currentOverview.ZoomOut(nil)
	refreshShopBadge()
	task.defer(function()
		currentOverview.Refit()
		layoutHeader()
	end)

	if renderConnection then
		renderConnection:Disconnect()
	end
	renderConnection = RunService.RenderStepped:Connect(function(dt: number)
		local step = math.min(dt, 0.1)
		-- (aperçu 3D ouvert par-dessus : la maison est cachée, on ne l'anime pas)
		if house3D and is3DOpen() then
			return
		end
		currentEditor.Update(step)
		if view == "room" then
			currentRoomView.Update(step)
		else
			currentOverview.Update(step)
		end
		refreshClock += step
		-- (sans DopamineChanged : on vérifie les prix toutes les 0,5 s)
		if refreshClock >= 0.5 and not ClientState.DopamineChanged then
			refreshClock = 0
			refreshShopBadge()
			local currentShop = shop
			if currentShop and currentShop.IsOpen() then
				currentShop.Refresh()
			end
		end
	end)
end

function House.OnClose()
	isOpen = false
	local connection = renderConnection
	if connection then
		connection:Disconnect()
		renderConnection = nil
	end
	local currentShop = shop
	if currentShop then
		currentShop.Close()
	end
	local currentPicker = picker
	if currentPicker then
		currentPicker.Close()
	end
	local currentOverview = overview
	if currentOverview then
		currentOverview.SetArranging(false)
	end
	local currentEditor = editor
	if not currentEditor then
		return
	end
	currentEditor.SetActive(false)
	if currentEditor.IsEditing() then
		currentEditor.SetEditing(false)
		if tray then
			layoutLeft(false)
		end
		refreshEditUi()
	end
	currentEditor.Flush()
	-- Sauvegarde encore en attente (nouvel essai) : on continue en arrière-plan
	closeWatcher += 1
	local token = closeWatcher
	task.spawn(function()
		local started = os.clock()
		while token == closeWatcher and currentEditor.IsBusy() and os.clock() - started < 12 do
			task.wait(0.25)
			currentEditor.Update(0.25)
		end
	end)
end

return House
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">ItemShop</string>
              <string name="Source"><![CDATA[--[[
	ItemShop (ModuleScript) — boutique d'objets cosmétiques
	Emplacement : ReplicatedStorage > Client > Components > Panels > ItemShop

	Chapeaux (posés sur le bouton "Clique-moi") et couleurs du bouton.
	Présentation "premium" :
	  - bannière avec un aperçu EN DIRECT de ton bouton (survole une carte
	    pour l'essayer), ta collection et ton bonus ;
	  - onglets Tout / Chapeaux / Couleurs ;
	  - grandes cartes illustrées : vitrine au dégradé de la rareté avec
	    rayons lumineux, pastille de rareté, ruban "ÉQUIPÉ" / "POSSÉDÉ",
	    soulèvement au survol, prix en Dopamine, confettis à l'achat.
	Achat / équipement / retrait via la RemoteFunction "ItemShop".
	Chaque objet possédé donne un petit bonus permanent (Config.CosmeticBonus).
	Débloqué par l'amélioration "Boutique d'objets" (Feature "ItemShop").
	v8 : nouveaux objets triés par prix ; ceux qui demandent des visites à
	l'océan (RequiresRebirths) sont montrés VERROUILLÉS (voile, cadenas,
	"🔒 après N visites à l'océan", prix visible) ; trop cher -> NeedDopamine ;
	prix à jour avec les ticks de Dopamine pendant que la boutique est ouverte.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Client = script.Parent.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local Interface = require(Client.Interface)
local ClientState = require(Client.ClientState)
local Effects = require(Client.Effects)
local SoundManager = require(Client.SoundManager)
local Notifications = require(script.Parent.Parent.Notifications)
local CosmeticArt = require(script.Parent.Parent.CosmeticArt)
local NeedDopamine = require(script.Parent.Parent.NeedDopamine)
local Config = require(ReplicatedStorage.Shared.Config)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Net = require(ReplicatedStorage.Shared.Net)
local Locale = require(ReplicatedStorage.Shared.Locale)

-- Title / Subtitle en anglais : traduits par PanelManager
local ItemShop = {
	Title = "🛒 Shop",
	Subtitle = "Hats and colors for your button",
	Color = Theme.Colors.Green,
	Size = Vector2.new(780, 600),
	-- v9 : prix "abordable / il manque X" rafraîchis en direct quand la boutique est ouverte
	RefreshOnTick = true,
}

-- Noms des emplacements (anglais, traduits à l'affichage)
local SLOT_NAMES = { Hat = "Hat", Skin = "Button color" }

local function slotName(slot: string?): string
	local name = slot and SLOT_NAMES[slot]
	return name and Locale.T(name) or ""
end
local HERO_TOP = Color3.fromRGB(40, 190, 120)
local HERO_BOTTOM = Color3.fromRGB(0, 160, 190)
local WHITE = Color3.new(1, 1, 1)

-- Rareté (d'après le prix)
local RARITIES = {
	{ Max = 1e5, Name = "Common", Color = Color3.fromRGB(120, 200, 140) },
	{ Max = 1e6, Name = "Rare", Color = Color3.fromRGB(60, 150, 255) },
	{ Max = 1e7, Name = "Epic", Color = Color3.fromRGB(170, 90, 240) },
	{ Max = 1e8, Name = "Legendary", Color = Color3.fromRGB(255, 170, 20) },
	{ Max = math.huge, Name = "Mythic", Color = Color3.fromRGB(255, 70, 150) },
}

type Rarity = { Max: number, Name: string, Color: Color3 }

type Card = {
	Cosmetic: any,
	Rarity: Rarity,
	Cell: Frame,
	Card: Frame,
	Stroke: UIStroke,
	Button: TextButton,
	Status: TextLabel,
	Ribbon: Frame,
	Rays: Frame,
	Showcase: Frame,
	LockBadge: Frame,
	Visual: GuiObject?,
	Hovered: boolean,
}

local cards: { [string]: Card } = {}
local cardList: { Card } = {}
local busy = false
local filter = "All"
local visible = false
local animation: RBXScriptConnection? = nil
local tickConnection: any = nil -- ClientState.DopamineChanged (ticks légers)
local lastTickRefresh = 0
local hoverId: string? = nil

-- Bannière
local previewButton: Frame
local previewGradient: UIGradient
local previewLabel: TextLabel
local previewHat: TextLabel
local previewCaption: TextLabel
local collectionChip: Frame
local bonusChip: Frame
local walletChip: Frame
local collectionBar: Frame

----------------------------------------------------------------------
-- Outils
----------------------------------------------------------------------

local function getCosmetics(data)
	local cosmetics = data and data.Cosmetics
	local owned = (cosmetics and cosmetics.Owned) or {}
	local equipped = (cosmetics and cosmetics.Equipped) or {}
	return owned, equipped
end

local function rarityOf(cost: number): Rarity
	for _, rarity in ipairs(RARITIES) do
		if cost < rarity.Max then
			return rarity
		end
	end
	return RARITIES[#RARITIES]
end

-- Visites à l'océan nécessaires (0 = libre) / visites du joueur
local function requiredRebirths(cosmetic): number
	return tonumber(cosmetic.RequiresRebirths) or 0
end

local function playerRebirths(): number
	local data = ClientState.Data
	return tonumber(data and data.Rebirths) or 0
end

local function isLocked(cosmetic): boolean
	return requiredRebirths(cosmetic) > playerRebirths()
end

local function lockText(cosmetic): string
	local needed = requiredRebirths(cosmetic)
	return needed == 1 and Locale.T("🔒 after 1 ocean visit") or Locale.T("🔒 after %d ocean visits", needed)
end

local function setChipText(chip: Frame, text: string)
	local label = chip:FindFirstChild("Label") :: TextLabel?
	if label and label.Text ~= text then
		label.Text = text
	end
end

local function getDopamine(): number
	local ok, value = pcall(ClientState.GetConfirmedDopamine)
	if ok and type(value) == "number" then
		return value
	end
	local data = ClientState.Data
	return (data and data.Dopamine) or 0
end

----------------------------------------------------------------------
-- Aperçu du bouton (bannière)
----------------------------------------------------------------------

-- Montre le bouton avec la couleur `skinId` et le chapeau `hatId`
local function showPreview(skinId: string, hatId: string, caption: string)
	local skin = Config.CosmeticsById[skinId]
	if skin and skin.Top and skin.Bottom then
		previewGradient.Color = ColorSequence.new(skin.Top, skin.Bottom)
		previewLabel.TextColor3 = Theme.ContrastText(skin.Top:Lerp(skin.Bottom, 0.5))
	else
		previewGradient.Color = ColorSequence.new(Theme.Colors.Button, Theme.Colors.ButtonBottom)
		previewLabel.TextColor3 = Theme.Colors.Text
	end
	-- (v9.2) motif dessiné des boutons "cool" (carbone, flammes...)
	CosmeticArt.ApplySkin(previewButton, skin, 10, 4)
	local hat = Config.CosmeticsById[hatId]
	local hatKey = hat and hat.Id or ""
	if previewHat:GetAttribute("HatId") ~= hatKey then
		previewHat:SetAttribute("HatId", hatKey)
		-- chapeaux dessinés (v9.2) ou emoji
		CosmeticArt.ApplyHat(previewHat, hat)
		if hat then
			UIUtil.Pop(previewHat, 0.4, 0.35)
		end
	end
	previewCaption.Text = caption
end

-- Aperçu : l'objet survolé par-dessus ce que tu portes
local function refreshPreview()
	if not previewButton then
		return
	end
	local _, equipped = getCosmetics(ClientState.Data)
	local skinId = equipped.Skin or ""
	local hatId = equipped.Hat or ""
	local caption = Locale.T("Your button")
	local hovered = hoverId and Config.CosmeticsById[hoverId]
	if hovered then
		if hovered.Slot == "Skin" then
			skinId = hovered.Id
		else
			hatId = hovered.Id
		end
		caption = Locale.T("Trying: %s", Locale.T(tostring(hovered.Name)))
	end
	showPreview(skinId, hatId, caption)
end

----------------------------------------------------------------------
-- Achat / équipement
----------------------------------------------------------------------

local function celebrate(ui: Card)
	Effects.Confetti(70)
	local layer = Effects.GetLayer()
	if layer then
		local center = Interface.GetCanvasCenter(ui.Card)
		Effects.Burst(layer, UDim2.fromOffset(center.X, center.Y), ui.Rarity.Color, 18)
	end
end

-- Envoie une action au serveur ("buy" | "equip" | "unequip")
local function request(action: string, cosmetic)
	if busy then
		return
	end
	busy = true
	local ui = cards[cosmetic.Id]
	if ui and action == "buy" then
		ui.Button.Text = "…"
	end
	local ok, success, message = pcall(function()
		return Net.Function("ItemShop"):InvokeServer(action, cosmetic.Id)
	end)
	busy = false

	if ok and success then
		if action == "buy" then
			SoundManager.Play("Buy", 1.1)
			task.delay(0.1, SoundManager.Play, "Achievement", 1.4)
			if ui then
				celebrate(ui)
			end
			Notifications.Show({
				Title = Locale.T("%s: it's yours!", Locale.T(cosmetic.Name)),
				Text = Locale.T("+%s%% gains forever • equipped automatically", tostring(math.floor(Config.CosmeticBonus * 100 + 0.5))),
				Icon = cosmetic.Icon,
				Color = Theme.Colors.Green,
				Duration = 4,
			})
		else
			SoundManager.Play("Open", action == "equip" and 1.2 or 0.9)
		end
		if ui then
			UIUtil.Pop(ui.Card, action == "buy" and 1.12 or 1.06, 0.35)
		end
	else
		SoundManager.Play("Error", 0.7)
		if ui then
			UIUtil.Shake(ui.Button)
		end
		-- Refus "pas assez de Dopamine" du serveur : on propose d'en avoir (vrai manque)
		local context = { Icon = cosmetic.Icon, Name = Locale.T(cosmetic.Name) }
		if not (ok and action == "buy" and NeedDopamine.OfferRefusal(message, tonumber(cosmetic.Cost), nil, context)) then
			local text = ok and tostring(message or Locale.T("Not possible right now.")) or Locale.T("Network error, try again.")
			Notifications.Toast(text, Theme.Colors.Red)
		end
	end
	if ClientState.Data then
		ItemShop.Update(ClientState.Data)
	end
end

----------------------------------------------------------------------
-- Construction
----------------------------------------------------------------------

local function buildHero(content: Frame)
	local hero = UIUtil.Create("Frame", {
		Name = "Hero",
		Size = UDim2.new(1, 0, 0, 106),
		BackgroundColor3 = WHITE,
		ClipsDescendants = true,
		Parent = content,
	})
	UIUtil.Corner(hero, Theme.Radius.L)
	UIUtil.Stroke(hero, HERO_BOTTOM:Lerp(Color3.new(0, 0, 0), 0.3), 1.5, 0.4)
	UIUtil.Gradient(hero, ColorSequence.new(HERO_TOP, HERO_BOTTOM), 20)

	-- Décor : grosses bulles translucides
	for index, info in ipairs({ { 0.92, 0.1, 120 }, { 0.78, 1.05, 90 }, { 0.62, -0.2, 60 }, { 0.99, 0.95, 50 } }) do
		local bubble = UIUtil.Create("Frame", {
			Name = "Bubble" .. index,
			Size = UDim2.fromOffset(info[3], info[3]),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(info[1], info[2]),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.86,
			ZIndex = 2,
			Parent = hero,
		})
		UIUtil.Corner(bubble, UDim.new(1, 0))
	end
	for index, info in ipairs({ { "🎩", 0.9, 0.3, 30 }, { "👑", 0.76, 0.72, 26 }, { "🍬", 0.97, 0.78, 22 } }) do
		UIUtil.Label({
			Name = "Deco" .. index,
			Text = info[1],
			Size = UDim2.fromOffset(info[4] + 6, info[4] + 6),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(info[2], info[3]),
			Rotation = (index % 2 == 0) and 12 or -14,
			TextTransparency = 0.25,
			MaxTextSize = info[4],
			ZIndex = 2,
			Parent = hero,
		})
	end

	-- Scène d'aperçu (à gauche)
	local stage = UIUtil.Create("Frame", {
		Name = "Stage",
		Size = UDim2.fromOffset(170, 86),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.1,
		ZIndex = 3,
		Parent = hero,
	})
	UIUtil.Corner(stage, Theme.Radius.M)
	UIUtil.Stroke(stage, WHITE, 2, 0.2)
	UIUtil.Gradient(stage, ColorSequence.new(WHITE, Color3.fromRGB(226, 236, 232)), 90)

	previewButton = UIUtil.Create("Frame", {
		Name = "PreviewButton",
		Size = UDim2.fromOffset(112, 38),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 48),
		BackgroundColor3 = WHITE,
		ZIndex = 4,
		Parent = stage,
	})
	UIUtil.Corner(previewButton, 10)
	UIUtil.Stroke(previewButton, Theme.Colors.Border, 1.5)
	previewGradient = UIUtil.Gradient(previewButton, ColorSequence.new(Theme.Colors.Button, Theme.Colors.ButtonBottom), 90)
	previewLabel = UIUtil.Label({
		Text = Locale.T("Click me"),
		Size = UDim2.new(1, -12, 1, -10),
		Position = UDim2.fromOffset(6, 5),
		MaxTextSize = 17,
		ZIndex = 5,
		Parent = previewButton,
	})
	previewHat = UIUtil.Label({
		Name = "Hat",
		Text = "",
		Size = UDim2.fromOffset(34, 34),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0, 10),
		Rotation = -8,
		MaxTextSize = 30,
		ZIndex = 6,
		Parent = previewButton,
	})
	previewCaption = UIUtil.Label({
		Name = "Caption",
		Text = Locale.T("Your button"),
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, -12, 0, 14),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -4),
		MaxTextSize = 12,
		ZIndex = 4,
		Parent = stage,
	})

	-- Titre, sous-titre et statistiques (à droite)
	local title = UIUtil.Label({
		Name = "HeroTitle",
		Text = Locale.T("Item Shop"),
		Font = Theme.Fonts.Title,
		TextColor3 = WHITE,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -210, 0, 28),
		Position = UDim2.fromOffset(196, 10),
		MaxTextSize = 24,
		ZIndex = 3,
		Parent = hero,
	})
	local titleStroke = UIUtil.Stroke(title, Color3.fromRGB(0, 90, 80), 1.5, 0.5)
	titleStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	UIUtil.Label({
		Name = "HeroSubtitle",
		Text = Locale.T("Each item owned: +%d%% gains forever", math.floor(Config.CosmeticBonus * 100 + 0.5)),
		TextColor3 = WHITE,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -210, 0, 16),
		Position = UDim2.fromOffset(196, 38),
		MaxTextSize = 14,
		ZIndex = 3,
		Parent = hero,
	})

	local chips = UIUtil.Create("Frame", {
		Name = "Chips",
		Size = UDim2.new(1, -210, 0, 26),
		Position = UDim2.fromOffset(196, 60),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = hero,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Parent = chips,
	})
	local function heroChip(order: number): Frame
		return UIUtil.Chip({
			Text = "",
			Color = WHITE,
			TextColor3 = Theme.Colors.TextDark,
			Height = 24,
			TextSize = 13,
			LayoutOrder = order,
			ZIndex = 4,
			StrokeColor = WHITE,
			Parent = chips,
		})
	end
	collectionChip = heroChip(1)
	bonusChip = heroChip(2)
	walletChip = heroChip(3)

	-- Barre de collection (bas de la bannière)
	local track = UIUtil.Create("Frame", {
		Name = "Collection",
		Size = UDim2.new(1, -210, 0, 6),
		Position = UDim2.fromOffset(196, 92),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = hero,
	})
	UIUtil.Corner(track, UDim.new(1, 0))
	collectionBar = UIUtil.Create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 4,
		Parent = track,
	})
	UIUtil.Corner(collectionBar, UDim.new(1, 0))
end

local function buildCard(grid: ScrollingFrame, cosmetic, layoutOrder: number)
	local rarity = rarityOf(tonumber(cosmetic.Cost) or 0)
	local cell = UIUtil.Create("Frame", {
		Name = cosmetic.Id,
		BackgroundTransparency = 1,
		LayoutOrder = layoutOrder,
		Parent = grid,
	})
	local card = UIUtil.Create("Frame", {
		Name = "Card",
		Size = UDim2.new(1, 0, 1, -6),
		Position = UDim2.fromOffset(0, 5),
		BackgroundColor3 = Theme.Colors.Card,
		ZIndex = 2,
		Parent = cell,
	})
	UIUtil.Corner(card, Theme.Radius.L)
	local stroke = UIUtil.Stroke(card, rarity.Color:Lerp(Color3.new(0, 0, 0), 0.2), 1.5, 0.35)
	UIUtil.Shadow(card, 3, 0.86, 2)

	-- Vitrine : dégradé de la rareté + rayons + objet
	local showcase = UIUtil.Create("Frame", {
		Name = "Showcase",
		Size = UDim2.new(1, -10, 0, 100),
		Position = UDim2.fromOffset(5, 5),
		BackgroundColor3 = WHITE,
		ClipsDescendants = true,
		ZIndex = 3,
		Parent = card,
	})
	UIUtil.Corner(showcase, Theme.Radius.M)
	UIUtil.SoftGradient(showcase, rarity.Color, 90)
	local rays = UIUtil.Rays(showcase, WHITE, 6, 170, UDim2.fromScale(0.5, 0.55), 3)
	local glow = UIUtil.Create("Frame", {
		Name = "Glow",
		Size = UDim2.fromOffset(70, 70),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.55),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.6,
		ZIndex = 3,
		Parent = showcase,
	})
	UIUtil.Corner(glow, UDim.new(1, 0))

	local visual: GuiObject? = nil
	if cosmetic.Slot == "Skin" and cosmetic.Top and cosmetic.Bottom then
		local swatch = UIUtil.Create("Frame", {
			Name = "Swatch",
			Size = UDim2.fromOffset(96, 36),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.58),
			BackgroundColor3 = WHITE,
			ZIndex = 4,
			Parent = showcase,
		})
		UIUtil.Corner(swatch, 9)
		UIUtil.Stroke(swatch, Theme.Colors.Border, 1.5)
		UIUtil.Gradient(swatch, ColorSequence.new(cosmetic.Top, cosmetic.Bottom), 90)
		CosmeticArt.ApplySkin(swatch, cosmetic, 9, 4) -- (v9.2) motif dessiné
		visual = swatch
		UIUtil.Label({
			Text = Locale.T("Click me"),
			TextColor3 = Theme.ContrastText(cosmetic.Top:Lerp(cosmetic.Bottom, 0.5)),
			Size = UDim2.new(1, -8, 1, -8),
			Position = UDim2.fromOffset(4, 4),
			MaxTextSize = 15,
			ZIndex = 5,
			Parent = swatch,
		})
	else
		visual = UIUtil.Label({
			Name = "Icon",
			Text = cosmetic.Icon,
			Size = UDim2.fromOffset(64, 64),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.56),
			MaxTextSize = 54,
			ZIndex = 4,
			Parent = showcase,
		})
		-- (v9.2) chapeau dessiné (sinon l'emoji reste)
		CosmeticArt.ApplyHat(visual :: GuiObject, cosmetic)
	end

	-- Pastille de rareté
	local rarityChip = UIUtil.Chip({
		Name = "Rarity",
		Text = Locale.T(rarity.Name),
		Color = rarity.Color:Lerp(Color3.new(0, 0, 0), 0.1),
		TextColor3 = WHITE,
		Height = 18,
		TextSize = 11,
		ZIndex = 5,
		StrokeColor = WHITE,
		Parent = showcase,
	})
	rarityChip.Position = UDim2.fromOffset(6, 6)

	-- Pastille ronde "✔" (verte = équipé, blanche = possédé) : à côté d'une
	-- rareté longue ("Légendaire"), un ruban "✔ POSSÉDÉ" ne tenait pas sur la
	-- ligne et chevauchait la rareté ; la ligne d'état le dit en toutes lettres
	local ribbon = UIUtil.Chip({
		Name = "Ribbon",
		Text = "✔",
		Color = Theme.Colors.Green,
		TextColor3 = Theme.Colors.TextDark,
		Height = 18,
		TextSize = 11,
		ZIndex = 5,
		Visible = false,
		Parent = showcase,
	})
	ribbon.AnchorPoint = Vector2.new(1, 0)
	ribbon.Position = UDim2.new(1, -6, 0, 6)

	-- Verrou (objet débloqué par les visites à l'océan) : voile + cadenas
	local lockBadge = UIUtil.Create("Frame", {
		Name = "Lock",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(40, 50, 70),
		BackgroundTransparency = 0.55,
		Visible = false,
		ZIndex = 6,
		Parent = showcase,
	})
	UIUtil.Corner(lockBadge, Theme.Radius.M)
	local lockPlate = UIUtil.Create("Frame", {
		Name = "Plate",
		Size = UDim2.fromOffset(34, 34),
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -6, 1, -6),
		BackgroundColor3 = WHITE,
		ZIndex = 7,
		Parent = lockBadge,
	})
	UIUtil.Corner(lockPlate, UDim.new(1, 0))
	UIUtil.Stroke(lockPlate, Color3.fromRGB(0, 120, 180), 2, 0.1)
	UIUtil.Gradient(lockPlate, ColorSequence.new(WHITE, Color3.fromRGB(200, 230, 245)), 90)
	UIUtil.Create("TextLabel", {
		Name = "Icon",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		Text = "🔒",
		TextSize = 18,
		ZIndex = 8,
		Parent = lockPlate,
	})
	local oceanChip = UIUtil.Chip({
		Name = "Ocean",
		Text = "🌊",
		Color = Color3.fromRGB(0, 140, 200),
		TextColor3 = WHITE,
		Height = 18,
		TextSize = 11,
		ZIndex = 8,
		StrokeColor = WHITE,
		Parent = lockBadge,
	})
	oceanChip.AnchorPoint = Vector2.new(1, 0)
	oceanChip.Position = UDim2.new(1, -6, 0, 6)
	setChipText(oceanChip, "🌊 " .. tostring(requiredRebirths(cosmetic)))

	UIUtil.Label({
		Name = "ItemName",
		Text = Locale.T(cosmetic.Name),
		Font = Theme.Fonts.Title,
		Size = UDim2.new(1, -14, 0, 20),
		Position = UDim2.fromOffset(7, 110),
		MaxTextSize = 16,
		ZIndex = 3,
		Parent = card,
	})
	local status = UIUtil.Label({
		Name = "Status",
		Text = SLOT_NAMES[cosmetic.Slot] or "",
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, -14, 0, 15),
		Position = UDim2.fromOffset(7, 131),
		MaxTextSize = 13,
		ZIndex = 3,
		Parent = card,
	})

	local button = UIUtil.NeonButton({
		Name = "Action",
		Text = "",
		Size = UDim2.new(1, -18, 0, 34),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -9),
		Color = Theme.Colors.Green,
		CornerRadius = 17,
		MaxTextSize = 16,
		ZIndex = 4,
		Parent = card,
	})

	local ui: Card = {
		Cosmetic = cosmetic,
		Rarity = rarity,
		Cell = cell,
		Card = card,
		Stroke = stroke,
		Button = button,
		Status = status,
		Ribbon = ribbon,
		Rays = rays,
		Showcase = showcase,
		LockBadge = lockBadge,
		Visual = visual,
		Hovered = false,
	}

	button.Activated:Connect(function()
		local data = ClientState.Data
		if not data or busy then
			return
		end
		local owned, equipped = getCosmetics(data)
		if not owned[cosmetic.Id] and isLocked(cosmetic) then
			-- Verrouillé : on explique comment le débloquer (le serveur refuserait)
			SoundManager.Play("Error", 0.7)
			UIUtil.Shake(button)
			local remaining = requiredRebirths(cosmetic) - playerRebirths()
			Notifications.Show({
				Title = Locale.T("%s is locked", Locale.T(cosmetic.Name)),
				Text = remaining == 1 and Locale.T("Visit the ocean 1 more time to unlock it.")
					or Locale.T("Visit the ocean %d more times to unlock it.", remaining),
				Icon = "🔒",
				Color = Color3.fromRGB(0, 140, 200),
				Duration = 4,
			})
			return
		end
		if not owned[cosmetic.Id] then
			-- Trop cher (calculé à l'instant, pas d'après l'état du bouton) :
			-- fenêtre "Pas assez de Dopamine" à CHAQUE clic
			local missing = (tonumber(cosmetic.Cost) or 0) - getDopamine()
			if missing > 0 then
				SoundManager.Play("Error", 0.7)
				UIUtil.Shake(button)
				NeedDopamine.Offer(missing, nil, { Icon = cosmetic.Icon, Name = Locale.T(cosmetic.Name), Color = ui.Rarity and ui.Rarity.Color or nil })
				return
			end
			task.spawn(request, "buy", cosmetic)
		elseif equipped[cosmetic.Slot] == cosmetic.Id then
			task.spawn(request, "unequip", cosmetic)
		else
			task.spawn(request, "equip", cosmetic)
		end
	end)

	-- Survol : la carte se soulève et l'objet s'essaie sur l'aperçu
	local function hover(on: boolean)
		ui.Hovered = on
		UIUtil.Tween(card, 0.18, { Position = UDim2.fromOffset(0, on and 0 or 5) }, Enum.EasingStyle.Quad)
		stroke.Transparency = on and 0 or 0.35
		if on then
			hoverId = cosmetic.Id
		elseif hoverId == cosmetic.Id then
			hoverId = nil
		end
		refreshPreview()
	end
	card.MouseEnter:Connect(function()
		hover(true)
	end)
	card.MouseLeave:Connect(function()
		hover(false)
	end)

	cards[cosmetic.Id] = ui
	table.insert(cardList, ui)
end

local function applyFilter()
	for _, ui in ipairs(cardList) do
		ui.Cell.Visible = filter == "All" or ui.Cosmetic.Slot == filter
	end
end

function ItemShop.Build(content: Frame)
	buildHero(content)

	UIUtil.Tabs({
		Parent = content,
		Tabs = {
			{ Id = "All", Text = Locale.T("✨ All") },
			{ Id = "Hat", Text = Locale.T("🎩 Hats") },
			{ Id = "Skin", Text = Locale.T("🎨 Colors") },
		},
		Color = Theme.Colors.Green,
		Size = UDim2.new(1, 0, 0, 36),
		Position = UDim2.fromOffset(0, 116),
		Selected = filter,
		OnSelect = function(id: string)
			filter = id
			applyFilter()
			SoundManager.Play("Click", 1.3)
		end,
	})

	local grid = UIUtil.Create("ScrollingFrame", {
		Name = "Items",
		Size = UDim2.new(1, 0, 1, -160),
		Position = UDim2.fromOffset(0, 160),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = Theme.Colors.Green,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = content,
	})
	UIUtil.Create("UIPadding", {
		PaddingTop = UDim.new(0, 2),
		PaddingLeft = UDim.new(0, 4),
		PaddingRight = UDim.new(0, 12),
		PaddingBottom = UDim.new(0, 10),
		Parent = grid,
	})
	UIUtil.Create("UIGridLayout", {
		CellSize = UDim2.new(0.25, -9, 0, 202),
		CellPadding = UDim2.fromOffset(9, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})

	-- Du moins cher au plus cher (les objets verrouillés, très chers, en fin de liste)
	local sorted = table.clone(Config.Cosmetics)
	table.sort(sorted, function(a, b)
		local ra, rb = requiredRebirths(a), requiredRebirths(b)
		if (ra > 0) ~= (rb > 0) then
			return rb > 0
		end
		return (tonumber(a.Cost) or 0) < (tonumber(b.Cost) or 0)
	end)
	for index, cosmetic in ipairs(sorted) do
		buildCard(grid, cosmetic, index)
	end
	applyFilter()
	refreshPreview()
end

function ItemShop.Update(data)
	local owned, equipped = getCosmetics(data)
	local dopamine = getDopamine()
	local ownedCount = 0

	for id, ui in pairs(cards) do
		local cosmetic = ui.Cosmetic
		local isOwned = owned[id] == true
		local isEquipped = isOwned and equipped[cosmetic.Slot] == id
		if isOwned then
			ownedCount += 1
		end

		local locked = not isOwned and isLocked(cosmetic)
		ui.LockBadge.Visible = locked
		if ui.Visual then
			local visual = ui.Visual :: GuiObject
			if visual:IsA("TextLabel") then
				visual.TextTransparency = locked and 0.45 or 0
			end
		end
		local ribbonLabel = ui.Ribbon:FindFirstChild("Label") :: TextLabel?
		if isEquipped then
			ui.Button.Text = Locale.T("Remove")
			ui.Button:SetAttribute("BaseColor", Theme.Colors.ButtonBottom)
			UIUtil.SetButtonEnabled(ui.Button, true)
			ui.Button.TextColor3 = Theme.Colors.Text
			ui.Status.Text = Locale.T("✔ On your button")
			ui.Status.TextColor3 = Theme.Colors.Green:Lerp(Color3.new(0, 0, 0), 0.35)
			ui.Ribbon.Visible = true
			ui.Ribbon.BackgroundColor3 = Theme.Colors.Green
			if ribbonLabel then
				ribbonLabel.Text = "✔"
			end
		elseif isOwned then
			ui.Button.Text = Locale.T("Equip")
			ui.Button:SetAttribute("BaseColor", Theme.Colors.Blue)
			UIUtil.SetButtonEnabled(ui.Button, true)
			ui.Button.TextColor3 = Theme.Colors.TextLight
			ui.Status.Text = Locale.T("Owned • %s", slotName(cosmetic.Slot))
			ui.Status.TextColor3 = Theme.Colors.TextDim
			ui.Ribbon.Visible = true
			ui.Ribbon.BackgroundColor3 = WHITE
			if ribbonLabel then
				ribbonLabel.Text = "✔"
			end
		elseif isLocked(cosmetic) then
			ui.Button.Text = lockText(cosmetic)
			ui.Button:SetAttribute("BaseColor", Color3.fromRGB(214, 232, 244))
			UIUtil.SetButtonEnabled(ui.Button, true)
			ui.Button.TextColor3 = Color3.fromRGB(0, 90, 140)
			ui.Status.Text = Locale.T("Price: %s", "💧 " .. NumberFormatter.Format(tonumber(cosmetic.Cost) or 0))
			ui.Status.TextColor3 = Theme.Colors.TextDim
			ui.Ribbon.Visible = false
		else
			local cost = tonumber(cosmetic.Cost) or 0
			local affordable = dopamine >= cost
			ui.Button.Text = "💧 " .. NumberFormatter.Format(cost)
			ui.Button:SetAttribute("BaseColor", Theme.Colors.Green)
			UIUtil.SetButtonEnabled(ui.Button, affordable)
			ui.Button.TextColor3 = Theme.Colors.TextDark
			if affordable then
				ui.Status.Text = slotName(cosmetic.Slot)
				ui.Status.TextColor3 = Theme.Colors.TextDim
			else
				ui.Status.Text = Locale.T("%s short", NumberFormatter.Format(cost - dopamine))
				ui.Status.TextColor3 = Theme.Colors.Red
			end
			ui.Ribbon.Visible = false
		end
	end

	-- Bannière
	if collectionChip then
		local total = #Config.Cosmetics
		setChipText(collectionChip, string.format("🎒 %d / %d", ownedCount, total))
		setChipText(bonusChip, Locale.T("📈 +%d%%", math.floor(ownedCount * Config.CosmeticBonus * 100 + 0.5)))
		setChipText(walletChip, "💧 " .. NumberFormatter.Format(dopamine))
		collectionBar.Size = UDim2.fromScale(total > 0 and ownedCount / total or 0, 1)
		refreshPreview()
	end
end

function ItemShop.OnOpen()
	visible = true
	-- Dopamine qui monte (ticks légers) : prix / boutons à jour, 4 fois par seconde au plus
	if not tickConnection then
		local dopamineChanged = (ClientState :: any).DopamineChanged
		if type(dopamineChanged) == "table" and type(dopamineChanged.Connect) == "function" then
			tickConnection = dopamineChanged:Connect(function()
				local now = os.clock()
				if not visible or now - lastTickRefresh < 0.25 or not ClientState.Data then
					return
				end
				lastTickRefresh = now
				ItemShop.Update(ClientState.Data)
			end)
		end
	end
	hoverId = nil
	refreshPreview()
	-- Rayons des vitrines qui tournent doucement (seulement fenêtre ouverte)
	if animation then
		animation:Disconnect()
	end
	animation = RunService.RenderStepped:Connect(function(dt: number)
		for _, ui in ipairs(cardList) do
			if ui.Cell.Visible then
				ui.Rays.Rotation = (ui.Rays.Rotation + dt * (ui.Hovered and 60 or 12)) % 360
			end
		end
	end)
end

function ItemShop.OnClose()
	visible = false
	hoverId = nil
	local connection = animation
	if connection then
		connection:Disconnect()
		animation = nil
	end
end

-- Vrai si la boutique est ouverte
function ItemShop.IsOpen(): boolean
	return visible
end

return ItemShop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="72">
            <Properties>
              <string name="Name">Leaderboard</string>
              <string name="Source"><![CDATA[--[[
	Leaderboard (ModuleScript) — classement complet (disponible dès le début)
	Emplacement : ReplicatedStorage > Client > Components > Panels > Leaderboard

	Deux classements (onglets du haut) :
	  - "💧 Dopamine"     : serveur = Dopamine actuelle ; monde = Dopamine
	    gagnée depuis toujours ;
	  - "♻️ Renaissances" : nombre de renaissances (visites à l'océan).
	Et pour chacun, deux portées (petit sélecteur à droite) :
	  - "🏠 Serveur" : les joueurs de ce serveur EN DIRECT (mis à jour toutes
	    les 2 s par le serveur), triés par Dopamine OU par renaissances
	    selon l'onglet du haut ;
	  - "🌍 Monde"   : le top de tous les serveurs (mis à jour chaque minute).
	Chaque joueur affiche son avatar, son nom, sa Dopamine ET ses
	renaissances (quand le serveur les connaît pour le top mondial).
	Podium illustré pour les 3 premiers (rayons, couronne, socles), liste
	pour la suite, et en bas "Ta place" (+ ce qu'il manque pour dépasser le
	joueur juste devant) avec tes propres compteurs. Toi : surligné.

	Données : ClientState.ServerLeaderboard / ClientState.Leaderboard /
	ClientState.RebirthLeaderboard (format { Global, GlobalRebirths, Server },
	anciens formats acceptés, voir ClientState).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Client = script.Parent.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local ClientState = require(Client.ClientState)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Locale = require(ReplicatedStorage.Shared.Locale)

-- Title / Subtitle en anglais : traduits par PanelManager
local Leaderboard = {
	Title = "🥇 Leaderboard",
	Subtitle = "Who has the biggest brain? And who went the furthest?",
	Color = Theme.Colors.Blue,
	Size = Vector2.new(700, 600),
}

-- Entrée normalisée d'un classement
type Entry = {
	UserId: number,
	Name: string,
	Primary: number, -- valeur classée (Dopamine ou renaissances)
	Dopamine: number?, -- Dopamine actuelle (serveur) ou gagnée depuis toujours (monde)
	Rebirths: number?, -- renaissances (nil = inconnues)
	Lifetime: number?, -- Dopamine gagnée depuis toujours (serveur)
	Rank: number?, -- rang envoyé par le serveur (monde)
}

type Avatar = { Frame: Frame, Image: ImageLabel, Initial: TextLabel }

type Row = {
	Holder: Frame,
	Card: Frame,
	Stroke: UIStroke,
	RankBubble: Frame,
	Rank: TextLabel,
	Avatar: Avatar,
	Name: TextLabel,
	Detail: TextLabel,
	Value: TextLabel,
	IsMe: boolean,
	Hovered: boolean,
}

type Podium = {
	Holder: Frame,
	Avatar: Avatar,
	Ring: UIStroke,
	Name: TextLabel,
	Value: TextLabel,
	Secondary: TextLabel,
	Me: Frame,
}

-- Couleurs d'un classement
type Palette = { Accent: Color3, Soft: Color3, Deep: Color3 }

local MEDALS = { "🥇", "🥈", "🥉" }
local MEDAL_COLORS = {
	Color3.fromRGB(255, 196, 40),
	Color3.fromRGB(176, 186, 204),
	Color3.fromRGB(214, 140, 84),
}
local REBIRTH_COLOR = Theme.Colors.Robux or Color3.fromRGB(0, 168, 107)
local PALETTES: { [string]: Palette } = {
	Dopamine = {
		Accent = Theme.Colors.Blue,
		Soft = Color3.fromRGB(230, 242, 255),
		Deep = Theme.Colors.Blue:Lerp(Color3.new(0, 0, 0), 0.3),
	},
	Rebirths = {
		Accent = REBIRTH_COLOR,
		Soft = Color3.fromRGB(224, 248, 237),
		Deep = REBIRTH_COLOR:Lerp(Color3.new(0, 0, 0), 0.3),
	},
}
local WHITE = Color3.new(1, 1, 1)

-- Mise en page (contenu d'environ 660 x 512)
local TOP_HEIGHT = 38
local INFO_Y = 46
local PODIUM_Y = 70
local PODIUM_HEIGHT = 172
local PODIUM_PADDING_TOP = 22 -- place pour la couronne du 1er
local LIST_Y = PODIUM_Y + PODIUM_HEIGHT + 8
local FOOTER_HEIGHT = 56
local ROW_HEIGHT = 50

local player = Players.LocalPlayer
local board = "Dopamine" -- "Dopamine" | "Rebirths"
local scope = "Server" -- "Server" | "World"
local visible = false
local dirty = true

local boardTabs: UIUtil.Tabs
local scopeTabs: UIUtil.Tabs
local liveDot: Frame
local infoLabel: TextLabel
local podiumCard: Frame
local podiumGradient: UIGradient
local podiumStroke: UIStroke
local rays: Frame
local raysConnection: RBXScriptConnection? = nil
local podiums: { Podium } = {}
local list: ScrollingFrame
local rows: { Row } = {}
local hintLabel: TextLabel
local emptyFrame: Frame
local emptyIcon: TextLabel
local emptyTitle: TextLabel
local emptyBody: TextLabel
local footer: Frame
local footerGradient: UIGradient
local footerStroke: UIStroke
local footerRing: UIStroke
local footerLabel: TextLabel
local footerDetail: TextLabel
local footerAvatar: Avatar
local myDopamineChip: Frame
local myRebirthChip: Frame

----------------------------------------------------------------------
-- Outils
----------------------------------------------------------------------

-- Nombre fiable (NaN / infini / texte -> `default`)
local function num(value: any, default: number?): number?
	local number = tonumber(value)
	if number == nil or number ~= number or number == math.huge or number == -math.huge then
		return default
	end
	return number
end

local function formatValue(value: number): string
	if value < 1e6 then
		return NumberFormatter.WithSpaces(value)
	end
	return NumberFormatter.Format(value)
end

-- "rebirth" / "rebirths" (pluriel dès 2 en français, sauf 1 en anglais)
local function rebirthWord(count: number): string
	local plural = if Locale.IsFrench() then count >= 2 else count ~= 1
	return plural and Locale.T("rebirths") or Locale.T("rebirth")
end

-- "1st", "2nd", "3rd"... / "1er", "2e", "3e"...
local function ordinal(rank: number): string
	if Locale.IsFrench() then
		return rank == 1 and "1er" or (tostring(rank) .. "e")
	end
	local lastTwo = rank % 100
	local suffix = "th"
	if lastTwo < 11 or lastTwo > 13 then
		local last = rank % 10
		suffix = last == 1 and "st" or (last == 2 and "nd" or (last == 3 and "rd" or "th"))
	end
	return tostring(rank) .. suffix
end

local function palette(): Palette
	return PALETTES[board] or PALETTES.Dopamine
end

-- Valeur principale mise en forme ("1.2M 💧" / "3 ♻️")
local function primaryText(value: number): string
	if board == "Rebirths" then
		return formatValue(math.floor(value)) .. " ♻️"
	end
	return formatValue(value) .. " 💧"
end

local function setChipText(chip: Frame, text: string)
	local label = chip:FindFirstChild("Label") :: TextLabel?
	if label then
		label.Text = text
	end
end

-- Avatar rond (photo du joueur, ou initiale si indisponible)
local function buildAvatar(parent: Instance, size: number, zIndex: number): Avatar
	local frame = UIUtil.Create("Frame", {
		Name = "Avatar",
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = Theme.Colors.PanelLight,
		ZIndex = zIndex,
		Parent = parent,
	})
	UIUtil.Corner(frame, UDim.new(1, 0))
	local initial = UIUtil.Label({
		Name = "Initial",
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.fromScale(0.7, 0.7),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		MaxTextSize = math.floor(size * 0.5),
		ZIndex = zIndex + 1,
		Parent = frame,
	})
	local image = UIUtil.Create("ImageLabel", {
		Name = "Image",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Image = "",
		ZIndex = zIndex + 2,
		Parent = frame,
	})
	UIUtil.Corner(image, UDim.new(1, 0))
	return { Frame = frame, Image = image, Initial = initial }
end

local function setAvatar(avatar: Avatar, userId: number, name: string, background: Color3?)
	-- (les joueurs de test de Studio ont un UserId négatif : pas de photo)
	local url = userId > 0 and UIUtil.HeadshotUrl(userId, 48) or ""
	if avatar.Image.Image ~= url then
		avatar.Image.Image = url
	end
	avatar.Initial.Text = string.upper(string.sub(name, 1, 1))
	if background then
		avatar.Frame.BackgroundColor3 = background
	end
end

-- Petite étiquette "TOI"
local function meChip(parent: Instance, zIndex: number): Frame
	return UIUtil.Chip({
		Name = "Me",
		Text = Locale.T("YOU"),
		Color = Theme.Colors.Blue,
		TextColor3 = Theme.Colors.TextLight,
		Height = 18,
		TextSize = 11,
		ZIndex = zIndex,
		Visible = false,
		Parent = parent,
	})
end

----------------------------------------------------------------------
-- Données
----------------------------------------------------------------------

-- Mes compteurs actuels (Dopamine, gagnée depuis toujours, renaissances)
local function myStats(): (number, number, number)
	local data = ClientState.Data
	if type(data) ~= "table" then
		return 0, 0, 0
	end
	local stats = type(data.Stats) == "table" and data.Stats or {}
	local dopamine = num(data.Dopamine, 0) :: number
	return dopamine, num(stats.LifetimeDopamine, 0) :: number, math.floor(num(data.Rebirths, 0) :: number)
end

local function sortEntries(result: { Entry })
	table.sort(result, function(a: Entry, b: Entry)
		if a.Rank and b.Rank and a.Rank ~= b.Rank then
			return a.Rank < b.Rank
		end
		if a.Primary ~= b.Primary then
			return a.Primary > b.Primary
		end
		-- Égalité : la Dopamine gagnée départage (utile pour les renaissances)
		local lifetimeA = a.Lifetime or a.Dopamine or 0
		local lifetimeB = b.Lifetime or b.Dopamine or 0
		if lifetimeA ~= lifetimeB then
			return lifetimeA > lifetimeB
		end
		return a.UserId < b.UserId
	end)
end

-- Classement du serveur (en direct), trié selon l'onglet du haut
local function getServerEntries(): { Entry }
	local result: { Entry } = {}
	local myDopamine, myLifetime, myRebirths = myStats()
	local source = ClientState.ServerLeaderboard
	local foundMe = false
	if type(source) == "table" then
		for _, raw in ipairs(source) do
			if type(raw) == "table" then
				local userId = num(raw.UserId, 0) :: number
				local dopamine = num(raw.Dopamine, nil) or num(raw.Value, 0) :: number
				local rebirths = math.floor(num(raw.Rebirths, 0) :: number)
				local lifetime = num(raw.Lifetime, nil)
				if userId == player.UserId and ClientState.Data then
					-- Ta ligne suit tes compteurs en direct (entre deux envois du serveur)
					foundMe = true
					dopamine = myDopamine
					rebirths = myRebirths
					lifetime = math.max(lifetime or 0, myLifetime)
				end
				table.insert(result, {
					UserId = userId,
					Name = tostring(raw.Name or "?"),
					Primary = board == "Rebirths" and rebirths or dopamine,
					Dopamine = dopamine,
					Rebirths = rebirths,
					Lifetime = lifetime,
				})
			end
		end
	end
	-- Classement du serveur pas encore reçu : au moins toi
	if not foundMe and #result == 0 and ClientState.Data then
		table.insert(result, {
			UserId = player.UserId,
			Name = player.DisplayName,
			Primary = board == "Rebirths" and myRebirths or myDopamine,
			Dopamine = myDopamine,
			Rebirths = myRebirths,
			Lifetime = myLifetime,
		})
	end
	sortEntries(result)
	return result
end

-- Top mondial (Dopamine gagnée ou renaissances), dans l'ordre du serveur
local function getWorldEntries(): { Entry }
	local result: { Entry } = {}
	local _, myLifetime, myRebirths = myStats()
	local source = board == "Rebirths" and ClientState.RebirthLeaderboard or ClientState.Leaderboard
	if type(source) ~= "table" then
		return result
	end
	for _, raw in ipairs(source) do
		if type(raw) == "table" then
			local userId = num(raw.UserId, 0) :: number
			local isMe = userId == player.UserId and ClientState.Data ~= nil
			local entry: Entry
			if board == "Rebirths" then
				local value = math.floor(num(raw.Value, nil) or num(raw.Rebirths, 0) :: number)
				entry = {
					UserId = userId,
					Name = tostring(raw.Name or "?"),
					Primary = value,
					Rebirths = value,
					Dopamine = isMe and myLifetime or num(raw.Dopamine, nil),
					Rank = num(raw.Rank, nil),
				}
			else
				local value = num(raw.Value, nil) or num(raw.Lifetime, 0) :: number
				local rebirths = num(raw.Rebirths, nil)
				entry = {
					UserId = userId,
					Name = tostring(raw.Name or "?"),
					Primary = value,
					Dopamine = value,
					Rebirths = isMe and myRebirths or (rebirths and math.floor(rebirths) or nil),
					Rank = num(raw.Rank, nil),
				}
			end
			table.insert(result, entry)
		end
	end
	sortEntries(result)
	return result
end

local function getEntries(): { Entry }
	if scope == "Server" then
		return getServerEntries()
	end
	return getWorldEntries()
end

----------------------------------------------------------------------
-- Affichage
----------------------------------------------------------------------

-- Ligne secondaire d'un joueur (l'AUTRE compteur + le total)
local function detailText(entry: Entry): string
	local parts = {}
	if board == "Dopamine" then
		if entry.Rebirths then
			table.insert(parts, "♻️ " .. formatValue(entry.Rebirths) .. " " .. rebirthWord(entry.Rebirths))
		end
		if scope == "Server" and entry.Lifetime then
			table.insert(parts, Locale.T("Total %s", NumberFormatter.Format(entry.Lifetime)))
		end
		if #parts == 0 then
			return Locale.T("Total Dopamine earned")
		end
	else
		if entry.Dopamine then
			local amount = NumberFormatter.Format(entry.Dopamine)
			table.insert(parts, "💧 " .. (scope == "Server" and amount or Locale.T("%s earned", amount)))
		end
		if scope == "Server" and entry.Lifetime then
			table.insert(parts, Locale.T("Total %s", NumberFormatter.Format(entry.Lifetime)))
		end
		if #parts == 0 then
			return Locale.T("Ocean visits")
		end
	end
	return table.concat(parts, "  •  ")
end

-- Petit texte sous la valeur du podium (l'autre compteur)
local function podiumSecondary(entry: Entry): string
	if board == "Dopamine" then
		return entry.Rebirths and ("♻️ " .. formatValue(entry.Rebirths)) or ""
	end
	return entry.Dopamine and ("💧 " .. NumberFormatter.Format(entry.Dopamine)) or ""
end

local function refreshPodium(entries: { Entry })
	local colors = palette()
	for rank, podium in ipairs(podiums) do
		local entry = entries[rank]
		podium.Holder.Visible = entry ~= nil
		if entry then
			local isMe = entry.UserId == player.UserId
			setAvatar(podium.Avatar, entry.UserId, entry.Name, MEDAL_COLORS[rank]:Lerp(WHITE, 0.7))
			podium.Name.Text = entry.Name
			podium.Name.TextColor3 = isMe and colors.Deep or Theme.Colors.Text
			podium.Value.Text = primaryText(entry.Primary)
			podium.Secondary.Text = podiumSecondary(entry)
			podium.Me.Visible = isMe
			podium.Me.BackgroundColor3 = colors.Accent
			podium.Ring.Thickness = isMe and 4 or 3
		end
	end
	rays.Visible = entries[1] ~= nil
end

-- Contour d'une ligne (toi / survol / normal)
local function paintRowStroke(row: Row)
	local colors = palette()
	if row.IsMe then
		row.Stroke.Color = colors.Accent
		row.Stroke.Transparency = 0
	elseif row.Hovered then
		row.Stroke.Color = colors.Accent
		row.Stroke.Transparency = 0.45
	else
		row.Stroke.Color = Theme.Colors.Divider
		row.Stroke.Transparency = 0
	end
end

local function ensureRow(index: number): Row
	local existing = rows[index]
	if existing then
		return existing
	end
	-- Support transparent (dans la liste) + carte (animée à l'intérieur)
	local holder = UIUtil.Create("Frame", {
		Name = "Row" .. index,
		Size = UDim2.new(1, -8, 0, ROW_HEIGHT),
		BackgroundTransparency = 1,
		LayoutOrder = index,
		Parent = list,
	})
	local card = UIUtil.Create("Frame", {
		Name = "Card",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Colors.Card,
		Parent = holder,
	})
	UIUtil.Corner(card, Theme.Radius.M)
	local stroke = UIUtil.Stroke(card, Theme.Colors.Divider, 1.5)

	local bubble = UIUtil.Create("Frame", {
		Name = "RankBubble",
		Size = UDim2.fromOffset(32, 32),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		BackgroundColor3 = Theme.Colors.Surface,
		Parent = card,
	})
	UIUtil.Corner(bubble, UDim.new(1, 0))
	UIUtil.Stroke(bubble, Theme.Colors.Divider, 1)
	local rank = UIUtil.Label({
		Name = "Rank",
		Font = Theme.Fonts.Number,
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, -6, 1, -8),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		MaxTextSize = 15,
		Parent = bubble,
	})

	local avatar = buildAvatar(card, 36, 2)
	avatar.Frame.AnchorPoint = Vector2.new(0, 0.5)
	avatar.Frame.Position = UDim2.new(0, 52, 0.5, 0)
	local name = UIUtil.Label({
		Name = "PlayerName",
		Font = Theme.Fonts.Title,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(0.6, -98, 0, 20),
		Position = UDim2.fromOffset(98, 6),
		MaxTextSize = 17,
		Parent = card,
	})
	local detail = UIUtil.Label({
		Name = "Detail",
		TextColor3 = Theme.Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(0.66, -98, 0, 15),
		Position = UDim2.fromOffset(98, 28),
		MaxTextSize = 13,
		Parent = card,
	})
	local value = UIUtil.Label({
		Name = "Value",
		Font = Theme.Fonts.Number,
		TextXAlignment = Enum.TextXAlignment.Right,
		Size = UDim2.new(0.34, -20, 0, 24),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		MaxTextSize = 18,
		Parent = card,
	})

	local row: Row = {
		Holder = holder,
		Card = card,
		Stroke = stroke,
		RankBubble = bubble,
		Rank = rank,
		Avatar = avatar,
		Name = name,
		Detail = detail,
		Value = value,
		IsMe = false,
		Hovered = false,
	}
	-- Survol : contour de la couleur du classement
	card.MouseEnter:Connect(function()
		row.Hovered = true
		paintRowStroke(row)
	end)
	card.MouseLeave:Connect(function()
		row.Hovered = false
		paintRowStroke(row)
	end)
	rows[index] = row
	return row
end

local function refreshFooter(entries: { Entry })
	local colors = palette()
	local myDopamine, myLifetime, myRebirths = myStats()
	setAvatar(footerAvatar, player.UserId, player.DisplayName, colors.Soft)
	footerRing.Color = colors.Accent
	footerStroke.Color = colors.Accent
	footerGradient.Color = ColorSequence.new(colors.Soft, WHITE)
	footerLabel.TextColor3 = colors.Deep
	setChipText(myDopamineChip, "💧 " .. NumberFormatter.Format(scope == "World" and myLifetime or myDopamine))
	setChipText(myRebirthChip, "♻️ " .. formatValue(myRebirths))

	local myIndex: number? = nil
	for index, entry in ipairs(entries) do
		if entry.UserId == player.UserId then
			myIndex = index
			break
		end
	end

	if scope == "Server" then
		if myIndex then
			local me = entries[myIndex]
			footerLabel.Text = Locale.T("Your rank: %s of %d", ordinal(myIndex), #entries)
			if myIndex == 1 then
				if #entries <= 1 then
					footerDetail.Text = Locale.T("Alone on the server: invite your friends!")
				elseif board == "Rebirths" then
					footerDetail.Text = Locale.T("♻️ You're the greatest traveler on the server!")
				else
					footerDetail.Text = Locale.T("👑 You have the biggest brain on the server!")
				end
			else
				local ahead = entries[myIndex - 1]
				local gap = math.max(0, ahead.Primary - me.Primary)
				if board == "Rebirths" then
					local needed = math.floor(gap) + 1
					footerDetail.Text = Locale.T("%d more %s to pass %s", needed, rebirthWord(needed), ahead.Name)
				else
					footerDetail.Text = Locale.T("%s more 💧 to pass %s", formatValue(gap + 1), ahead.Name)
				end
			end
		else
			footerLabel.Text = Locale.T("Your rank: ...")
			footerDetail.Text = Locale.T("Loading the server leaderboard")
		end
		return
	end

	-- Monde
	if myIndex then
		footerLabel.Text = Locale.T("Your rank: %s in the world!", ordinal(myIndex))
		footerDetail.Text = myIndex == 1 and Locale.T("👑 Nobody has done better, anywhere.") or Locale.T("You're one of the legends 🌍")
		return
	end
	local size = math.max(#entries, 10)
	footerLabel.Text = Locale.T("Not in the top %s yet", tostring(size))
	local last = entries[#entries]
	if board == "Rebirths" then
		if last and #entries >= size then
			local needed = math.max(0, math.floor(last.Primary) - myRebirths) + 1
			footerDetail.Text = Locale.T("%d more %s to get in", needed, rebirthWord(needed))
		elseif myRebirths <= 0 then
			footerDetail.Text = Locale.T("Go to the ocean 🌊 for your first rebirth!")
		else
			footerDetail.Text = Locale.T("Your rank shows up at the next update")
		end
	else
		if last then
			footerDetail.Text = Locale.T("%s more 💧 earned to get in", formatValue(math.max(0, last.Primary - myLifetime) + 1))
		else
			footerDetail.Text = Locale.T("Keep clicking!")
		end
	end
end

-- Couleurs qui dépendent du classement choisi
local function applyPalette()
	local colors = palette()
	podiumGradient.Color = ColorSequence.new(colors.Soft, WHITE)
	podiumStroke.Color = colors.Accent
	list.ScrollBarImageColor3 = colors.Accent
end

local function refreshInfo()
	local live = scope == "Server"
	liveDot.Visible = live
	infoLabel.Position = UDim2.fromOffset(live and 16 or 0, INFO_Y)
	infoLabel.Size = UDim2.new(1, live and -16 or 0, 0, 18)
	if live then
		infoLabel.Text = board == "Rebirths" and Locale.T("Live  •  ranked by rebirths (ocean visits)")
			or Locale.T("Live  •  ranked by current Dopamine")
	else
		infoLabel.Text = board == "Rebirths" and Locale.T("🌍 Rebirths across all servers  •  updated every minute")
			or Locale.T("🌍 All-time Dopamine earned  •  updated every minute")
	end
end

local function refresh()
	if not list then
		return
	end
	dirty = false
	local colors = palette()
	local entries = getEntries()

	refreshInfo()
	applyPalette()

	local isEmpty = #entries == 0
	emptyFrame.Visible = isEmpty
	podiumCard.Visible = not isEmpty
	list.Visible = not isEmpty
	if isEmpty then
		if scope == "Server" then
			emptyIcon.Text = "⏳"
			emptyTitle.Text = Locale.T("Loading...")
			emptyBody.Text = Locale.T("The server leaderboard will be here in a moment.")
		elseif board == "Rebirths" then
			emptyIcon.Text = "🌊"
			emptyTitle.Text = Locale.T("No rebirths yet")
			emptyBody.Text = RunService:IsStudio()
					and Locale.T("In Studio, the world leaderboard only works if API access (DataStore) is enabled in the game settings.")
				or Locale.T("Go to the ocean to be the first in the world! (updated every minute)")
		else
			emptyIcon.Text = "🌍"
			emptyTitle.Text = Locale.T("World leaderboard loading...")
			emptyBody.Text = RunService:IsStudio()
					and Locale.T("In Studio, the world leaderboard only works if API access (DataStore) is enabled in the game settings.")
				or Locale.T("Come back in a minute: the world's top is on its way!")
		end
	end

	refreshPodium(entries)

	-- Liste à partir de la 4e place
	local shown = 0
	for index = 4, #entries do
		local entry = entries[index]
		shown += 1
		local row = ensureRow(shown)
		local isMe = entry.UserId == player.UserId
		row.IsMe = isMe
		row.Holder.Visible = true
		row.Card.BackgroundColor3 = isMe and colors.Soft or Theme.Colors.Card
		paintRowStroke(row)
		row.Rank.Text = tostring(index)
		row.RankBubble.BackgroundColor3 = isMe and colors.Accent or Theme.Colors.Surface
		row.Rank.TextColor3 = isMe and Theme.Colors.TextLight or Theme.Colors.TextDim
		setAvatar(row.Avatar, entry.UserId, entry.Name)
		row.Name.Text = isMe and Locale.T("%s  (you)", entry.Name) or entry.Name
		row.Name.TextColor3 = isMe and colors.Deep or Theme.Colors.Text
		row.Detail.Text = detailText(entry)
		row.Value.Text = primaryText(entry.Primary)
		row.Value.TextColor3 = isMe and colors.Deep or Theme.Colors.Text
	end
	for index = shown + 1, #rows do
		rows[index].Holder.Visible = false
	end
	-- Pas de 4e place : petit message à la place de la liste
	hintLabel.Visible = shown == 0
	hintLabel.Text = scope == "Server" and Locale.T("The more players, the funnier it gets 👀")
		or Locale.T("The rest of the top arrives with new players 🌍")

	refreshFooter(entries)
end

-- Petite entrée animée (changement d'onglet / ouverture)
local function animateIn()
	for rank, podium in ipairs(podiums) do
		if podium.Holder.Visible then
			UIUtil.Pop(podium.Avatar.Frame, 0.6, 0.35 + rank * 0.05)
		end
	end
	for index, row in ipairs(rows) do
		local card = row.Card
		if row.Holder.Visible and index <= 8 then
			card.Position = UDim2.fromOffset(18, 0)
			card.BackgroundTransparency = 0.4
			task.delay(index * 0.03, function()
				UIUtil.Tween(card, 0.28, { Position = UDim2.new(), BackgroundTransparency = 0 }, Enum.EasingStyle.Quint)
			end)
		end
	end
end

----------------------------------------------------------------------
-- Construction
----------------------------------------------------------------------

local function buildPodium(parent: Frame, rank: number, x: number, blockHeight: number)
	local color = MEDAL_COLORS[rank]
	local holder = UIUtil.Create("Frame", {
		Name = "Podium" .. rank,
		Size = UDim2.new(1 / 3, -10, 1, 0),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(x, 0, 0, 0),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 2,
		Parent = parent,
	})

	-- Socle (bloc au dégradé de la médaille)
	local block = UIUtil.Create("Frame", {
		Name = "Block",
		Size = UDim2.new(1, -30, 0, blockHeight),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 0),
		BackgroundColor3 = WHITE,
		ZIndex = 3,
		Parent = holder,
	})
	UIUtil.Corner(block, Theme.Radius.M)
	UIUtil.Stroke(block, color:Lerp(Color3.new(0, 0, 0), 0.3), 1.5, 0.3)
	UIUtil.SoftGradient(block, color, 90)
	UIUtil.Label({
		Name = "Medal",
		Text = MEDALS[rank],
		Size = UDim2.new(1, 0, 0, math.min(28, blockHeight - 6)),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		MaxTextSize = 26,
		ZIndex = 4,
		Parent = block,
	})

	-- Au-dessus du socle : l'autre compteur, la valeur, le nom, puis l'avatar
	local secondary = UIUtil.Label({
		Name = "Secondary",
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, -8, 0, 14),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -(blockHeight + 3)),
		MaxTextSize = 13,
		ZIndex = 3,
		Parent = holder,
	})
	local value = UIUtil.Label({
		Name = "Value",
		Font = Theme.Fonts.Number,
		TextColor3 = Theme.Colors.Text,
		Size = UDim2.new(1, -8, 0, 18),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -(blockHeight + 17)),
		MaxTextSize = 17,
		ZIndex = 3,
		Parent = holder,
	})
	local name = UIUtil.Label({
		Name = "PlayerName",
		Font = Theme.Fonts.Title,
		Size = UDim2.new(1, -8, 0, 17),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -(blockHeight + 35)),
		MaxTextSize = 15,
		ZIndex = 3,
		Parent = holder,
	})
	local avatarSize = rank == 1 and 52 or 44
	local avatarBottom = blockHeight + 54
	local avatar = buildAvatar(holder, avatarSize, 4)
	avatar.Frame.AnchorPoint = Vector2.new(0.5, 1)
	avatar.Frame.Position = UDim2.new(0.5, 0, 1, -avatarBottom)
	local ring = UIUtil.Stroke(avatar.Frame, color, 3, 0)
	if rank == 1 then
		-- Rayons dorés qui tournent derrière le 1er
		rays = UIUtil.Rays(holder, color, 8, 150, UDim2.new(0.5, 0, 1, -(avatarBottom + avatarSize / 2)), 2)
		UIUtil.Label({
			Name = "Crown",
			Text = "👑",
			Size = UDim2.fromOffset(28, 28),
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 0, 8),
			Rotation = -12,
			MaxTextSize = 24,
			ZIndex = 8,
			Parent = avatar.Frame,
		})
	end
	local me = meChip(avatar.Frame, 9)
	me.AnchorPoint = Vector2.new(0.5, 0.5)
	-- (sur le bas de l'anneau, sans descendre sur le nom du joueur)
	me.Position = UDim2.new(0.5, 0, 1, -7)

	podiums[rank] = {
		Holder = holder,
		Avatar = avatar,
		Ring = ring,
		Name = name,
		Value = value,
		Secondary = secondary,
		Me = me,
	}
end

local function buildFooter(content: Frame)
	footer = UIUtil.Create("Frame", {
		Name = "Footer",
		Size = UDim2.new(1, 0, 0, FOOTER_HEIGHT),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		BackgroundColor3 = WHITE,
		Parent = content,
	})
	UIUtil.Corner(footer, Theme.Radius.L)
	footerStroke = UIUtil.Stroke(footer, Theme.Colors.Blue, 1.5, 0.35)
	footerGradient = UIUtil.Gradient(footer, ColorSequence.new(PALETTES.Dopamine.Soft, WHITE), 0)
	footerAvatar = buildAvatar(footer, 40, 2)
	footerAvatar.Frame.AnchorPoint = Vector2.new(0, 0.5)
	footerAvatar.Frame.Position = UDim2.new(0, 10, 0.5, 0)
	footerRing = UIUtil.Stroke(footerAvatar.Frame, Theme.Colors.Blue, 2, 0)
	footerLabel = UIUtil.Label({
		Name = "Place",
		Font = Theme.Fonts.Title,
		TextColor3 = PALETTES.Dopamine.Deep,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -250, 0, 20),
		Position = UDim2.fromOffset(62, 8),
		MaxTextSize = 17,
		Parent = footer,
	})
	footerDetail = UIUtil.Label({
		Name = "Detail",
		TextColor3 = Theme.Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -250, 0, 16),
		Position = UDim2.fromOffset(62, 30),
		MaxTextSize = 14,
		Parent = footer,
	})

	-- Tes compteurs (Dopamine et renaissances), à droite
	local chips = UIUtil.Create("Frame", {
		Name = "MyStats",
		Size = UDim2.new(0, 176, 0, 28),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		BackgroundTransparency = 1,
		Parent = footer,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = chips,
	})
	myDopamineChip = UIUtil.Chip({
		Name = "Dopamine",
		Text = "💧 0",
		Color = Theme.Colors.Blue,
		TextColor3 = Theme.Colors.TextLight,
		Height = 26,
		TextSize = 13,
		LayoutOrder = 1,
		Parent = chips,
	})
	myRebirthChip = UIUtil.Chip({
		Name = "Rebirths",
		Text = "♻️ 0",
		Color = REBIRTH_COLOR,
		TextColor3 = Theme.Colors.TextLight,
		Height = 26,
		TextSize = 13,
		LayoutOrder = 2,
		Parent = chips,
	})
end

local function buildEmpty(content: Frame)
	emptyFrame = UIUtil.Create("Frame", {
		Name = "Empty",
		Size = UDim2.new(1, 0, 1, -(PODIUM_Y + FOOTER_HEIGHT + 8)),
		Position = UDim2.fromOffset(0, PODIUM_Y),
		BackgroundColor3 = Theme.Colors.Surface,
		Visible = false,
		Parent = content,
	})
	UIUtil.Corner(emptyFrame, Theme.Radius.L)
	UIUtil.Stroke(emptyFrame, Theme.Colors.Divider, 1.5)
	local bubble = UIUtil.Create("Frame", {
		Size = UDim2.fromOffset(92, 92),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 40),
		BackgroundColor3 = WHITE,
		Parent = emptyFrame,
	})
	UIUtil.Corner(bubble, UDim.new(1, 0))
	UIUtil.Stroke(bubble, Theme.Colors.Divider, 2)
	emptyIcon = UIUtil.Label({
		Text = "🌍",
		Size = UDim2.new(1, -24, 1, -24),
		Position = UDim2.fromOffset(12, 12),
		MaxTextSize = 50,
		Parent = bubble,
	})
	emptyTitle = UIUtil.Label({
		Font = Theme.Fonts.Title,
		Size = UDim2.new(1, -40, 0, 28),
		Position = UDim2.fromOffset(20, 148),
		MaxTextSize = 22,
		Parent = emptyFrame,
	})
	emptyBody = UIUtil.Create("TextLabel", {
		Font = Theme.Fonts.Body,
		TextSize = 15,
		TextColor3 = Theme.Colors.TextDim,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -100, 0, 60),
		Position = UDim2.fromOffset(50, 184),
		Parent = emptyFrame,
	})
end

function Leaderboard.Build(content: Frame)
	-- Onglets du haut : le classement (Dopamine / renaissances)
	boardTabs = UIUtil.Tabs({
		Parent = content,
		Tabs = {
			{ Id = "Dopamine", Text = "💧 Dopamine" },
			{ Id = "Rebirths", Text = Locale.T("♻️ Rebirths") },
		},
		Color = Theme.Colors.Blue,
		Size = UDim2.new(1, -236, 0, TOP_HEIGHT),
		Selected = board,
		OnSelect = function(id: string)
			board = id
			refresh()
			animateIn()
		end,
	})
	-- Sélecteur de portée (serveur / monde)
	scopeTabs = UIUtil.Tabs({
		Parent = content,
		Tabs = {
			{ Id = "Server", Text = Locale.T("🏠 Server") },
			{ Id = "World", Text = Locale.T("🌍 World") },
		},
		Color = Theme.Colors.Dark,
		Size = UDim2.new(0, 224, 0, TOP_HEIGHT),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		TextSize = 15,
		Selected = scope,
		OnSelect = function(id: string)
			scope = id
			refresh()
			animateIn()
		end,
	})

	-- Ligne d'info (point rouge qui pulse quand c'est en direct)
	liveDot = UIUtil.Create("Frame", {
		Name = "LiveDot",
		Size = UDim2.fromOffset(9, 9),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromOffset(2, INFO_Y + 9),
		BackgroundColor3 = Theme.Colors.Red,
		Parent = content,
	})
	UIUtil.Corner(liveDot, UDim.new(1, 0))
	TweenService:Create(
		liveDot,
		TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ BackgroundTransparency = 0.75 }
	):Play()
	infoLabel = UIUtil.Label({
		Name = "Info",
		TextColor3 = Theme.Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -16, 0, 18),
		Position = UDim2.fromOffset(16, INFO_Y),
		MaxTextSize = 14,
		Parent = content,
	})

	-- Carte du podium : 2e à gauche, 1er au centre (plus haut), 3e à droite
	podiumCard = UIUtil.Create("Frame", {
		Name = "PodiumCard",
		Size = UDim2.new(1, 0, 0, PODIUM_HEIGHT),
		Position = UDim2.fromOffset(0, PODIUM_Y),
		BackgroundColor3 = WHITE,
		ClipsDescendants = false,
		Parent = content,
	})
	UIUtil.Corner(podiumCard, Theme.Radius.L)
	podiumStroke = UIUtil.Stroke(podiumCard, Theme.Colors.Blue, 1.5, 0.6)
	podiumGradient = UIUtil.Gradient(podiumCard, ColorSequence.new(PALETTES.Dopamine.Soft, WHITE), 90)
	local podiumArea = UIUtil.Create("Frame", {
		Name = "Podium",
		Size = UDim2.new(1, -40, 1, -PODIUM_PADDING_TOP),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 1),
		BackgroundTransparency = 1,
		Parent = podiumCard,
	})
	buildPodium(podiumArea, 2, 1 / 6, 32)
	buildPodium(podiumArea, 1, 0.5, 42)
	buildPodium(podiumArea, 3, 5 / 6, 22)
	-- Les rayons restent dans la carte (sinon ils débordent sur les onglets)
	podiumCard.ClipsDescendants = true

	list = UIUtil.Create("ScrollingFrame", {
		Name = "List",
		Size = UDim2.new(1, 0, 1, -(LIST_Y + FOOTER_HEIGHT + 8)),
		Position = UDim2.fromOffset(0, LIST_Y),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = Theme.Colors.Blue,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = content,
	})
	UIUtil.Create("UIPadding", {
		PaddingTop = UDim.new(0, 2),
		PaddingLeft = UDim.new(0, 2),
		PaddingBottom = UDim.new(0, 4),
		Parent = list,
	})
	UIUtil.Create("UIListLayout", {
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = list,
	})
	hintLabel = UIUtil.Label({
		Name = "Hint",
		Text = "",
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, -8, 0, 30),
		LayoutOrder = 10000,
		MaxTextSize = 14,
		Visible = false,
		Parent = list,
	})

	buildEmpty(content)
	buildFooter(content)

	ClientState.LeaderboardChanged:Connect(function()
		dirty = true
		if visible then
			refresh()
		end
	end)
	refresh()
end

function Leaderboard.OnOpen()
	visible = true
	boardTabs.Select(board, true)
	scopeTabs.Select(scope, true)
	refresh()
	animateIn()
	-- Rayons du 1er : rotation lente, seulement quand la fenêtre est ouverte
	if not raysConnection then
		raysConnection = RunService.Heartbeat:Connect(function(dt: number)
			if rays and rays.Visible then
				rays.Rotation = (rays.Rotation + dt * 14) % 360
			end
		end)
	end
end

function Leaderboard.OnClose()
	visible = false
	local connection = raysConnection
	if connection then
		connection:Disconnect()
		raysConnection = nil
	end
end

-- Nouvel état : ta ligne suit tes compteurs (seulement si ouvert)
function Leaderboard.Update(_data)
	if visible then
		refresh()
	else
		dirty = true
	end
end

-- Vrai si la liste doit être recalculée à la prochaine ouverture (debug)
function Leaderboard.IsDirty(): boolean
	return dirty
end

return Leaderboard
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="73">
            <Properties>
              <string name="Name">Quests</string>
              <string name="Source"><![CDATA[--[[
	Quests (ModuleScript) — panneau des quêtes
	Emplacement : ReplicatedStorage > Client > Components > Panels > Quests

	Les quêtes actives (une quête finie est remplacée tout de suite).
	v5 : le texte d'une quête est rendu ici dans la langue du joueur à
	partir de Config.Quests.Pool (même Type) + objectif ; à défaut, le
	texte envoyé par le serveur (quest.Text).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Config = require(ReplicatedStorage.Shared.Config)
local Locale = require(ReplicatedStorage.Shared.Locale)

-- Title / Subtitle en anglais : traduits par PanelManager
local Quests = {
	Title = "📜 Quests",
	Subtitle = "Current goals",
	Color = Theme.Colors.Orange,
}

-- Modèles de quêtes par Type (Config.Quests.Pool)
local templatesByType: { [string]: any } = {}
for _, template in ipairs(Config.Quests.Pool) do
	if type(template.Type) == "string" then
		templatesByType[template.Type] = template
	end
end

-- Texte d'une quête dans la langue du joueur ("Click 50 times" / "Fais 50 clics")
local function questText(quest): string
	local template = type(quest.Type) == "string" and templatesByType[quest.Type] or nil
	local goal = tonumber(quest.Goal)
	if template and type(template.Text) == "string" and goal then
		return Locale.T(template.Text, NumberFormatter.Format(goal))
	end
	return tostring(quest.Text or "")
end

local cards = {}
local emptyLabel: TextLabel

-- Progression / prix qui bougent avec la Dopamine : rafraîchi aussi entre deux états complets
Quests.RefreshOnTick = true

function Quests.Build(content: Frame)
	UIUtil.Create("UIListLayout", {
		Padding = UDim.new(0, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = content,
	})

	UIUtil.Label({
		Text = Locale.T("Complete quests to earn bonuses! A new quest replaces each finished one."),
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, 0, 0, 36),
		LayoutOrder = 0,
		MaxTextSize = 16,
		Parent = content,
	})

	for index = 1, Config.Quests.ActiveCount do
		local card = UIUtil.Create("Frame", {
			Size = UDim2.new(1, 0, 0, 100),
			BackgroundColor3 = Theme.Colors.Card,
			LayoutOrder = index,
			Parent = content,
		})
		UIUtil.Corner(card, 14)
		UIUtil.Stroke(card, Theme.Colors.CardBorder, 1.5)

		local text = UIUtil.Label({
			Font = Theme.Fonts.Title,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, -30, 0, 28),
			Position = UDim2.fromOffset(15, 10),
			MaxTextSize = 20,
			Parent = card,
		})
		local reward = UIUtil.Label({
			TextColor3 = Theme.Colors.TextDim,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, -30, 0, 20),
			Position = UDim2.fromOffset(15, 40),
			MaxTextSize = 16,
			Parent = card,
		})

		local bar = UIUtil.Create("Frame", {
			Size = UDim2.new(1, -30, 0, 22),
			Position = UDim2.fromOffset(15, 66),
			BackgroundColor3 = Theme.Colors.PanelLight,
			ClipsDescendants = true,
			Parent = card,
		})
		UIUtil.Corner(bar, 11)
		UIUtil.Stroke(bar, Theme.Colors.CardBorder, 1, 0.5)
		local fill = UIUtil.Create("Frame", {
			Size = UDim2.fromScale(0, 1),
			BackgroundColor3 = Color3.new(1, 1, 1),
			Parent = bar,
		})
		UIUtil.Corner(fill, 11)
		UIUtil.Gradient(fill, ColorSequence.new(Theme.Colors.Yellow, Theme.Colors.Orange), 0)
		local progress = UIUtil.Label({
			Font = Theme.Fonts.Title,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 2,
			MaxTextSize = 15,
			Parent = bar,
		})

		cards[index] = { Card = card, Text = text, Reward = reward, Fill = fill, Progress = progress }
	end

	emptyLabel = UIUtil.Label({
		Text = Locale.T("No quests for now..."),
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, 0, 0, 30),
		LayoutOrder = 99,
		Visible = false,
		MaxTextSize = 18,
		Parent = content,
	})
end

function Quests.Update(data)
	local quests = data.Quests or {}
	for index, ui in ipairs(cards) do
		local quest = quests[index]
		ui.Card.Visible = quest ~= nil
		if quest then
			ui.Text.Text = questText(quest)
			ui.Reward.Text = Locale.T("🎁 Reward: +%s Dopamine", NumberFormatter.Format(quest.Reward or 0))
			local goal = math.max(1, quest.Goal or 1)
			local ratio = math.clamp((quest.Progress or 0) / goal, 0, 1)
			UIUtil.Tween(ui.Fill, 0.25, { Size = UDim2.fromScale(ratio, 1) })
			ui.Progress.Text = NumberFormatter.Format(quest.Progress or 0) .. " / " .. NumberFormatter.Format(goal)
		end
	end
	emptyLabel.Visible = #quests == 0
end

return Quests
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="74">
            <Properties>
              <string name="Name">RobuxShop</string>
              <string name="Source"><![CDATA[--[[
	RobuxShop (ModuleScript) — "💎 Boutique Robux"
	Emplacement : ReplicatedStorage > Client > Components > Panels > RobuxShop

	Présentation "premium" construite depuis Config.Monetization :
	  - bannière violette animée (diamant, rayons, étincelles) avec ton état :
	    VIP, bonus des Game Passes, boost en cours (compte à rebours) ;
	  - onglets Tout / Passes / Dopamine / Boosts / 🎟️ Tickets / 🔜 Bientôt ;
	  - offres rangées en SECTIONS (titre + grille) : grandes cartes illustrées
	    (passes, Dopamine, boosts, combos) et cartes compactes (packs de tickets
	    avec éventail de tickets et "×25", objets stylés) ; rubans ("MEILLEURE
	    OFFRE", "POPULAIRE"...), bouton prix R$ (vrai prix Roblox), "✔ Acheté"
	    pour les passes possédés ;
	  - 🎟️ Tickets : packs de tickets d'arcade (économie par ticket calculée
	    avec les VRAIS prix Roblox seulement), ton solde, rappel honnête "les
	    🏆 trophées des duels ne s'achètent pas", bouton "🕹️ Arcade" ;
	  - 🔜 Bientôt : combos (tickets + Dopamine) et objets stylés marqués
	    ComingSoon = true (ou d'un type que le serveur ne sait pas encore
	    donner, voir Config.Monetization.ReadyKinds) : ruban "BIENTÔT"
	    brillant, bouton désactivé, JAMAIS de fenêtre d'achat.
	Les offres dont l'ID vaut 0 sont cachées dans le jeu publié (sauf les
	"Bientôt", toujours montrées). Dans Studio, elles restent visibles en
	APERÇU (bouton "ID à configurer") pour que le propriétaire voie la
	boutique ; s'il n'y a rien à vendre dans le jeu publié : "Bientôt disponible".

	API : ShowTab(id) ("All" | "Passes" | "Dopamine" | "Boosts" | "Tickets" |
	"Soon"), Spotlight(offerId) (défile jusqu'à l'offre et la met en avant,
	ex. pack conseillé par NeedTickets), HasOffers(), IsOpen().

	Le vrai prix vient de MarketplaceService:GetProductInfo (dans un thread
	séparé, protégé par pcall, mis en cache) ; en attendant ou en cas
	d'erreur, on affiche Config PriceHint.
	L'achat ouvre la fenêtre Roblox (PromptGamePassPurchase /
	PromptProductPurchase). Le SERVEUR vérifie et donne l'achat, puis
	envoie Notify { Type = "Purchase" } (fête + confettis gérés par Notifications).
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Client = script.Parent.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local ClientState = require(Client.ClientState)
local SoundManager = require(Client.SoundManager)
local Notifications = require(script.Parent.Parent.Notifications)
local PanelManager = require(script.Parent.Parent.PanelManager)
local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Locale = require(ReplicatedStorage.Shared.Locale)
local ArcadeConfig = require(ReplicatedStorage.Shared.ArcadeConfig)

-- Title / Subtitle en anglais : traduits par PanelManager
local RobuxShop = {
	Title = "💎 Robux Shop",
	Subtitle = "Thanks for supporting the game 💖",
	Color = Theme.Colors.Robux,
	Size = Vector2.new(800, 600),
}

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local HERO_TOP = Color3.fromRGB(64, 28, 140)
local HERO_BOTTOM = Color3.fromRGB(200, 50, 160)
local TICKET_GOLD = Color3.fromRGB(255, 176, 32)
local TICKET_INK = Color3.fromRGB(110, 60, 10)
local SOON_PINK = Color3.fromRGB(255, 60, 140)
local SOON_BUTTON = Color3.fromRGB(232, 226, 246)
local SOON_TEXT = Color3.fromRGB(120, 96, 170)
local TICKET = ArcadeConfig.Tickets.Icon
local TROPHY = ArcadeConfig.Trophies.Icon

local PASS_COLORS = {
	X10 = Theme.Colors.Purple,
	X2 = Theme.Colors.Blue,
	AutoClick = Theme.Colors.Cyan,
	VIP = Theme.Colors.Premium,
}
local PRODUCT_COLORS = {
	Dopamine = Theme.Colors.Cyan,
	Boost = Theme.Colors.Boost,
	ServerRush = Theme.Colors.Pink,
	Tickets = TICKET_GOLD,
	Combo = Color3.fromRGB(255, 96, 128),
	Stylish = Color3.fromRGB(150, 90, 255),
}
-- Rubans de mise en avant (Id de l'offre -> texte anglais, traduit à
-- l'affichage) ; les nouvelles offres utilisent le champ Tag de la config
local HIGHLIGHTS = {
	X10 = "🔥 BEST DEAL",
	VIP = "⭐ POPULAR",
	PackL = "💰 BEST VALUE",
	Boost5 = "⚡ POWERFUL",
}

-- Sections (dans l'ordre d'affichage). Style "Big" = 3 grandes cartes par
-- ligne ; "Compact" = 5 petites cartes par ligne.
local SECTIONS = {
	{ Id = "Passes", Title = "♾️ Game Passes", Note = "Bought once, yours forever", Color = Theme.Colors.Purple, Style = "Big" },
	{ Id = "Dopamine", Title = "💧 Dopamine packs", Note = "Instant Dopamine, scaled to your production", Color = Theme.Colors.Cyan, Style = "Big" },
	{ Id = "Boosts", Title = "⚡ Boosts", Note = "Earn more for a little while", Color = Theme.Colors.Boost, Style = "Big" },
	{ Id = "Tickets", Title = "🎟️ Arcade tickets", Note = "", Color = TICKET_GOLD, Style = "Compact" },
	{ Id = "Combos", Title = "🎁 Combos", Note = "Tickets + Dopamine in one pack", Color = PRODUCT_COLORS.Combo, Style = "Big" },
	{ Id = "Stylish", Title = "✨ Stylish items", Note = "Cosmetics: just for the look", Color = PRODUCT_COLORS.Stylish, Style = "Compact" },
}
local STYLES = {
	Big = { Columns = 3, CellHeight = 246, Gap = 10, RowGap = 6 },
	Compact = { Columns = 5, CellHeight = 218, Gap = 8, RowGap = 6 },
}
local SECTION_HEADER = 32 -- titre de section
local SECTION_GAP = 12 -- entre deux sections
local FOOTER_HEIGHT = 50 -- bandeau d'infos sous les tickets
local LIST_PADDING_TOP = 2
local LIST_PADDING_BOTTOM = 10

local PENDING_TIMEOUT = 20 -- secondes d'attente max de l'activation d'un pass acheté
local PROMPT_COOLDOWN = 1
local RETRY_DELAY = 30 -- nouvel essai de GetProductInfo après une erreur
local ANIM_STEP = 1 / 30 -- animations d'ambiance à 30 images/s au plus

type Offer = {
	Def: any,
	IsPass: boolean,
	Id: number,
	Section: string, -- Id de SECTIONS
	Soon: boolean, -- "Bientôt" : jamais d'achat
	Compact: boolean,
	Color: Color3,
	Cell: Frame,
	Card: Frame,
	Stroke: UIStroke,
	Button: TextButton,
	Extra: TextLabel?,
	Owned: Frame?,
	Kind: Frame?, -- pastille "Pour toujours" / "Rachetable"
	Spot: Frame?, -- pastille "👉 Conseillé" (Spotlight)
	Rays: Frame,
	Hovered: boolean,
	Spotlit: number, -- os.clock() de fin de mise en avant
}

type Section = {
	Def: any,
	Frame: Frame,
	Grid: Frame,
	Note: TextLabel,
	Footer: Frame?,
	Offers: { Offer },
	Columns: number,
	CellHeight: number,
	RowGap: number,
}

local player = Players.LocalPlayer
local offers: { Offer } = {}
local offersById: { [string]: Offer } = {}
local sections: { Section } = {}
local sectionsById: { [string]: Section } = {}
local priceCache: { [string]: { Price: number?, ForSale: boolean } } = {}
local fetching: { [string]: boolean } = {}
local lastFailure: { [string]: number } = {}
local pendingPasses: { [number]: number } = {} -- [GamePassId] = os.clock() de l'achat
local lastPrompt = 0
local visible = false
local filter = "All"
local filterTabs: UIUtil.Tabs? = nil
local tabIds: { [string]: boolean } = {}
local animation: RBXScriptConnection? = nil
local refreshClock = 0
local animClock = 0
local list: ScrollingFrame? = nil
local shineTweens: { Tween } = {} -- reflets des rubans "BIENTÔT" (joués seulement boutique ouverte)

local heroStatus: TextLabel
local heroChips: { VIP: Frame, Bonus: Frame, Boost: Frame } = {} :: any
local heroDiamond: TextLabel
local heroRays: Frame
local sparkles: { TextLabel } = {}
local filterEmpty: TextLabel
local arcadeButton: TextButton? = nil

----------------------------------------------------------------------
-- Classement des offres
----------------------------------------------------------------------

-- Section d'une offre de la config
local function sectionOf(def, isPass: boolean): string
	if isPass then
		return "Passes"
	end
	local kind = def.Kind
	if kind == "Dopamine" then
		return "Dopamine"
	elseif kind == "Tickets" then
		return "Tickets"
	elseif kind == "Combo" then
		return "Combos"
	elseif kind == "Stylish" then
		return "Stylish"
	end
	return "Boosts"
end

-- Packs de tickets : utiles seulement avec l'🕹️ Arcade débloquée (sinon on
-- ne les vend pas encore : cadenas "🔒 Arcade")
local function ticketsLocked(def): boolean
	return def.Kind == "Tickets" and not ClientState.HasFeature(ArcadeConfig.Feature)
end

-- "Bientôt" : marquée ComingSoon, ou d'un type que le serveur ne sait pas donner
local function isComingSoon(def, isPass: boolean): boolean
	if def.ComingSoon == true then
		return true
	end
	if isPass then
		return false
	end
	local ready = Config.Monetization.ReadyKinds
	return type(ready) == "table" and ready[def.Kind] ~= true
end

-- L'offre est-elle montrée avec l'onglet `tab` ?
local function cellVisible(offer: Offer, tab: string): boolean
	if tab == "All" then
		return true
	elseif tab == "Soon" then
		return offer.Soon
	end
	if offer.Section == "Combos" and not offer.Soon then
		-- Combo en vente : il contient des tickets ET de la Dopamine
		return tab == "Tickets" or tab == "Dopamine"
	end
	return offer.Section == tab
end

----------------------------------------------------------------------
-- Prix (MarketplaceService, jamais sur le thread de rendu)
----------------------------------------------------------------------

local function cacheKey(isPass: boolean, id: number): string
	return (isPass and "Pass:" or "Product:") .. tostring(id)
end

local refreshOffer: (offer: Offer) -> () -- défini plus bas
local refreshExtra: (offer: Offer, data: any) -> () -- défini plus bas

local function fetchPrice(offer: Offer)
	if offer.Id == 0 or offer.Soon then
		return
	end
	local key = cacheKey(offer.IsPass, offer.Id)
	if priceCache[key] or fetching[key] then
		return
	end
	if lastFailure[key] and os.clock() - lastFailure[key] < RETRY_DELAY then
		return
	end
	fetching[key] = true
	task.spawn(function()
		local infoType = offer.IsPass and Enum.InfoType.GamePass or Enum.InfoType.Product
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfo(offer.Id, infoType)
		end)
		fetching[key] = nil
		if ok and type(info) == "table" then
			local price = tonumber(info.PriceInRobux)
			local forSale = info.IsForSale ~= false and price ~= nil
			if not offer.IsPass then
				-- Les Developer Products n'ont pas toujours IsForSale : le prix suffit
				forSale = price ~= nil
			end
			priceCache[key] = { Price = price, ForSale = forSale }
		else
			lastFailure[key] = os.clock()
			warn("[RobuxShop] Prix introuvable pour " .. key .. " : " .. tostring(info))
		end
		if offer.Card.Parent then
			refreshOffer(offer)
			-- (l'économie des packs de tickets dépend des prix des autres packs)
			for _, other in ipairs(offers) do
				if other.Section == "Tickets" then
					refreshExtra(other, ClientState.Data)
				end
			end
		end
	end)
end

-- (texte du prix, en vente ?)
local function priceText(offer: Offer): (string, boolean)
	if offer.Id == 0 then
		return "R$ " .. NumberFormatter.WithSpaces(tonumber(offer.Def.PriceHint) or 0), false
	end
	local cached = priceCache[cacheKey(offer.IsPass, offer.Id)]
	if cached then
		if not cached.ForSale or not cached.Price then
			return Locale.T("Unavailable"), false
		end
		return "R$ " .. NumberFormatter.WithSpaces(cached.Price), true
	end
	return "R$ " .. NumberFormatter.WithSpaces(tonumber(offer.Def.PriceHint) or 0), true
end

-- VRAI prix Roblox (cache), sinon nil (jamais le PriceHint)
local function realPrice(offer: Offer): number?
	if offer.Id == 0 then
		return nil
	end
	local cached = priceCache[cacheKey(offer.IsPass, offer.Id)]
	if cached and cached.ForSale and cached.Price and cached.Price > 0 then
		return cached.Price
	end
	return nil
end

----------------------------------------------------------------------
-- Achat
----------------------------------------------------------------------

local function prompt(offer: Offer)
	if os.clock() - lastPrompt < PROMPT_COOLDOWN then
		return
	end
	lastPrompt = os.clock()
	if offer.Soon then
		-- "Bientôt" : jamais de fenêtre d'achat
		SoundManager.Play("Error", 0.9)
		UIUtil.Shake(offer.Button)
		Notifications.Toast(Locale.T("Coming soon!"), Theme.Colors.Purple, 3, nil, false, "🔜")
		return
	end
	if offer.Id == 0 then
		SoundManager.Play("Error", 0.8)
		UIUtil.Shake(offer.Button)
		Notifications.Toast(
			Locale.T("Paste the ID of “%s” in Config.Monetization to sell it.", Locale.T(tostring(offer.Def.Name))),
			Theme.Colors.Orange,
			5,
			Locale.T("Studio preview"),
			false,
			"🛠️"
		)
		return
	end
	if offer.IsPass and ClientState.HasPass(offer.Def.Id) then
		SoundManager.Play("Error", 0.8)
		return
	end
	if ticketsLocked(offer.Def) then
		SoundManager.Play("Error", 0.8)
		UIUtil.Shake(offer.Button)
		Notifications.Toast(Locale.T("Unlock the 🕹️ Arcade first: tickets are spent there."), Theme.Colors.Purple, 4, nil, false, "🔒")
		return
	end
	local _, forSale = priceText(offer)
	if not forSale then
		SoundManager.Play("Error", 0.7)
		UIUtil.Shake(offer.Button)
		Notifications.Toast(Locale.T("This offer isn't on sale right now."), Theme.Colors.Red)
		return
	end
	SoundManager.Play("Click", 1.2)
	UIUtil.Pop(offer.Card, 1.05, 0.3)
	local ok, err = pcall(function()
		if offer.IsPass then
			MarketplaceService:PromptGamePassPurchase(player, offer.Id)
		else
			MarketplaceService:PromptProductPurchase(player, offer.Id)
		end
	end)
	if not ok then
		warn("[RobuxShop] Impossible d'ouvrir l'achat : " .. tostring(err))
		Notifications.Toast(Locale.T("Can't buy right now, try again."), Theme.Colors.Red)
	end
end

----------------------------------------------------------------------
-- Affichage d'une offre
----------------------------------------------------------------------

-- Bouton d'achat : pièce "R$" + prix (coin = false : texte seul, ex. "✔ Acheté")
local function styleButton(button: TextButton, text: string, background: Color3, textColor: Color3, enabled: boolean, coin: boolean?)
	local label = button:FindFirstChild("PriceLabel") :: TextLabel?
	local coinFrame = button:FindFirstChild("Coin") :: Frame?
	local coinWidth = coinFrame and coinFrame.Size.X.Offset + 6 or 30
	if label then
		if label.Text ~= text then
			label.Text = text
		end
		label.TextColor3 = textColor
		label.Position = UDim2.fromOffset(coin and coinWidth or 0, 0)
		label.Size = UDim2.new(1, coin and -coinWidth or 0, 1, 0)
		-- Contour du texte seulement sur le vert "achat" (sur fond clair, texte net)
		local textStroke = label:FindFirstChildOfClass("UIStroke")
		if textStroke then
			textStroke.Transparency = enabled and 0.35 or 1
		end
	elseif button.Text ~= text then
		button.Text = text
	end
	if coinFrame then
		coinFrame.Visible = coin == true
	end
	-- Contour (style v9 : teinte plus sombre du fond) et reflet : actif = net,
	-- désactivé = contour doux et sans reflet
	local buttonStroke = button:FindFirstChildOfClass("UIStroke")
	if buttonStroke then
		buttonStroke.Color = enabled and UIUtil.EdgeColor(background) or background:Lerp(BLACK, 0.3)
		buttonStroke.Transparency = enabled and 0 or 0.35
	end
	local gloss = button:FindFirstChild("Gloss")
	if gloss and gloss:IsA("GuiObject") then
		gloss.Visible = enabled
	end
	button:SetAttribute("BaseColor", background)
	button.BackgroundColor3 = background
	button.TextColor3 = textColor
	button.TextTransparency = 0
	button:SetAttribute("Enabled", enabled)
end

-- Prix Robux affichable (nombre) ou nil
local function priceValue(offer: Offer): number?
	local cached = offer.Id ~= 0 and priceCache[cacheKey(offer.IsPass, offer.Id)]
	if cached then
		return cached.Price
	end
	return tonumber(offer.Def.PriceHint)
end

function refreshOffer(offer: Offer)
	local def = offer.Def
	local owned = offer.IsPass and ClientState.HasPass(def.Id)
	if offer.Owned then
		offer.Owned.Visible = owned
		-- (le tampon "✔ ACHETÉ" prend la place de la pastille "Pour toujours")
		if offer.Kind then
			offer.Kind.Visible = not owned
		end
	end
	local spotlit = offer.Spotlit > os.clock()
	if offer.Spot then
		offer.Spot.Visible = spotlit
	end
	if owned then
		pendingPasses[offer.Id] = nil
		styleButton(offer.Button, Locale.T("✔ Purchased"), Color3.fromRGB(222, 247, 232), Theme.Colors.RobuxDark, false)
		offer.Stroke.Color = Theme.Colors.Robux
		offer.Stroke.Thickness = 2
		offer.Stroke.Transparency = 0
		return
	end
	if spotlit then
		offer.Stroke.Color = TICKET_GOLD
		offer.Stroke.Thickness = 3
		offer.Stroke.Transparency = 0
	else
		offer.Stroke.Color = offer.Color:Lerp(BLACK, 0.2)
		offer.Stroke.Thickness = offer.Hovered and 2 or 1.5
		offer.Stroke.Transparency = offer.Hovered and 0 or 0.35
	end
	if offer.Soon then
		styleButton(offer.Button, Locale.T("🔜 Coming soon"), SOON_BUTTON, SOON_TEXT, false)
		local buttonStroke = offer.Button:FindFirstChildOfClass("UIStroke")
		if buttonStroke then
			buttonStroke.Color = SOON_TEXT
			buttonStroke.Transparency = 0.45
		end
		return
	end
	local pendingSince = offer.IsPass and pendingPasses[offer.Id]
	if pendingSince and os.clock() - pendingSince < PENDING_TIMEOUT then
		styleButton(offer.Button, Locale.T("⏳ Activating…"), Theme.Colors.PanelLight, Theme.Colors.TextDim, false)
		return
	end
	if offer.Id == 0 then
		styleButton(offer.Button, Locale.T("🛠️ ID to set up"), Theme.Colors.PanelLight, Theme.Colors.TextDim, false)
		return
	end
	if ticketsLocked(def) then
		styleButton(offer.Button, Locale.T("🔒 Arcade"), Theme.Colors.PanelLight, Theme.Colors.TextDim, false)
		return
	end
	local text, forSale = priceText(offer)
	local price = priceValue(offer)
	if forSale and price then
		styleButton(offer.Button, NumberFormatter.WithSpaces(price), Theme.Colors.Robux, Theme.Colors.TextLight, true, true)
	elseif forSale then
		styleButton(offer.Button, text, Theme.Colors.Robux, Theme.Colors.TextLight, true)
	else
		styleButton(offer.Button, text, Theme.Colors.Disabled, Theme.Colors.TextDim, false)
	end
end

-- Économie par ticket d'un pack par rapport au plus petit pack (VRAIS prix
-- Roblox des deux packs, sinon nil : jamais d'économie inventée)
local function ticketSavings(offer: Offer): number?
	local price = realPrice(offer)
	local amount = tonumber(offer.Def.Tickets) or 0
	if not price or amount <= 0 then
		return nil
	end
	local base: Offer? = nil
	for _, other in ipairs(offers) do
		local otherAmount = tonumber(other.Def.Tickets) or 0
		if other.Section == "Tickets" and not other.Soon and otherAmount > 0
			and (base == nil or otherAmount < (tonumber(base.Def.Tickets) or 0)) then
			base = other
		end
	end
	if not base or base == offer then
		return nil
	end
	local basePrice = realPrice(base)
	local baseAmount = tonumber(base.Def.Tickets) or 0
	if not basePrice or baseAmount <= 0 then
		return nil
	end
	local saving = 1 - (price / amount) / (basePrice / baseAmount)
	if saving < 0.05 then
		return nil
	end
	return math.floor(saving * 100 + 0.5)
end

-- Ligne "extra" : estimation du gain / boost actif / effet
function refreshExtra(offer: Offer, data)
	local extra = offer.Extra
	if not extra then
		return
	end
	local def = offer.Def
	local text = ""
	local color = Theme.Colors.TextDim
	local stats = { PerSecond = tonumber(data and data.PerSecond) or 0, ClickValue = tonumber(data and data.ClickValue) or 0 }
	if offer.IsPass then
		if def.Multiplier then
			text = Locale.T("📈 Gains %s forever", NumberFormatter.Multiplier(def.Multiplier))
			color = offer.Color:Lerp(BLACK, 0.35)
		elseif def.AutoClicksPerSecond then
			text = Locale.T("🤖 %s clicks / second", tostring(def.AutoClicksPerSecond))
			color = offer.Color:Lerp(BLACK, 0.35)
		end
		if def.UnlockPremiumThemes then
			text = (text ~= "" and (text .. " • ") or "") .. Locale.T("🎨 Premium themes")
		end
	elseif def.Kind == "Dopamine" then
		local amount = Formulas.ScaledReward(stats, tonumber(def.Seconds) or 0, tonumber(def.Minimum) or 0)
		text = "≈ +" .. NumberFormatter.Format(amount) .. " Dopamine"
		color = Theme.Colors.Blue
	elseif def.Kind == "Boost" then
		local multiplier, remaining = ClientState.GetBoost()
		if remaining > 0 then
			text = Locale.T("⏱️ Active: %s • %s", NumberFormatter.Multiplier(multiplier), UIUtil.FormatClock(remaining))
			color = Theme.Colors.Boost
		else
			text = Locale.T("⏱️ Duration: %s", NumberFormatter.Time(tonumber(def.Duration) or 0))
		end
	elseif def.Kind == "ServerRush" then
		text = Locale.T("🎉 The whole server benefits")
		color = Theme.Colors.Pink
	elseif def.Kind == "Tickets" then
		local saving = ticketSavings(offer)
		if saving then
			text = Locale.T("💸 −%s%% per ticket", tostring(saving))
			color = Theme.Colors.RobuxDark
		else
			text = Locale.T("🕹️ For the arcade")
			color = TICKET_INK
		end
	elseif def.Kind == "Combo" then
		local amount = Formulas.ScaledReward(stats, tonumber(def.Seconds) or 0, tonumber(def.Minimum) or 0)
		text = string.format("%s %s + ≈ %s 🧠", TICKET, NumberFormatter.Format(tonumber(def.Tickets) or 0), NumberFormatter.Format(amount))
		color = offer.Color:Lerp(BLACK, 0.35)
	elseif def.Kind == "Stylish" then
		text = Locale.T("✨ Just for style")
		color = offer.Color:Lerp(BLACK, 0.3)
	end
	if extra.Text ~= text then
		extra.Text = text
	end
	extra.TextColor3 = color
end

----------------------------------------------------------------------
-- Bannière
----------------------------------------------------------------------

local function setChip(chip: Frame, show: boolean, text: string?)
	if chip.Visible ~= show then
		chip.Visible = show
		if show then
			UIUtil.Pop(chip, 0.4, 0.35)
		end
	end
	if show and text then
		local label = chip:FindFirstChild("Label") :: TextLabel?
		if label and label.Text ~= text then
			label.Text = text
		end
	end
end

local function refreshStatus(data)
	if not heroStatus then
		return
	end
	local multiplier, remaining = ClientState.GetBoost()
	local vip = ClientState.IsVIP()
	if remaining > 0 then
		heroStatus.Text = Locale.T("🔥 Your boost is active: enjoy it!")
	elseif vip then
		heroStatus.Text = Locale.T("👑 You're VIP — thanks for your support!")
	else
		heroStatus.Text = Locale.T("Purchases are tied to your account and kept forever.")
	end
	local bonus = tonumber(data and data.BonusMultiplier) or ClientState.GetPassMultiplier()
	setChip(heroChips.VIP, vip, "👑 VIP")
	setChip(heroChips.Bonus, bonus > 1.001, "💎 Bonus " .. NumberFormatter.Multiplier(bonus))
	setChip(heroChips.Boost, remaining > 0, string.format("⏱️ %s • %s", NumberFormatter.Multiplier(multiplier), UIUtil.FormatClock(remaining)))
end

local function buildHero(content: Frame)
	local hero = UIUtil.Create("Frame", {
		Name = "Hero",
		Size = UDim2.new(1, 0, 0, 110),
		BackgroundColor3 = WHITE,
		ClipsDescendants = true,
		Parent = content,
	})
	UIUtil.Corner(hero, Theme.Radius.L)
	UIUtil.Stroke(hero, HERO_TOP, 1.5, 0.3)
	UIUtil.Gradient(hero, ColorSequence.new(HERO_TOP, HERO_BOTTOM), 15)

	-- Étincelles
	local random = Random.new(42)
	for index = 1, 12 do
		local star = UIUtil.Label({
			Name = "Sparkle" .. index,
			Text = index % 3 == 0 and "✦" or "•",
			TextColor3 = WHITE,
			Size = UDim2.fromOffset(14, 14),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(random:NextNumber(0.35, 0.98), random:NextNumber(0.08, 0.92)),
			MaxTextSize = index % 3 == 0 and 14 or 10,
			ZIndex = 2,
			Parent = hero,
		})
		star:SetAttribute("Phase", random:NextNumber(0, math.pi * 2))
		table.insert(sparkles, star)
	end

	-- Gros diamant à droite, devant des rayons
	heroRays = UIUtil.Rays(hero, WHITE, 8, 220, UDim2.new(1, -80, 0.5, 0), 2)
	local halo = UIUtil.Create("Frame", {
		Name = "Halo",
		Size = UDim2.fromOffset(92, 92),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -80, 0.5, 0),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.8,
		ZIndex = 2,
		Parent = hero,
	})
	UIUtil.Corner(halo, UDim.new(1, 0))
	heroDiamond = UIUtil.Label({
		Name = "Diamond",
		Text = "💎",
		Size = UDim2.fromOffset(76, 76),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -80, 0.5, 0),
		MaxTextSize = 64,
		ZIndex = 3,
		Parent = hero,
	})

	local title = UIUtil.Label({
		Name = "HeroTitle",
		Text = Locale.T("Robux Shop"),
		Font = Theme.Fonts.Title,
		TextColor3 = WHITE,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -200, 0, 30),
		Position = UDim2.fromOffset(18, 12),
		MaxTextSize = 26,
		ZIndex = 3,
		Parent = hero,
	})
	local stroke = UIUtil.Stroke(title, Color3.fromRGB(40, 10, 80), 1.5, 0.4)
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	heroStatus = UIUtil.Label({
		Name = "Status",
		Text = "",
		TextColor3 = WHITE,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -200, 0, 18),
		Position = UDim2.fromOffset(18, 44),
		MaxTextSize = 15,
		ZIndex = 3,
		Parent = hero,
	})

	local chips = UIUtil.Create("Frame", {
		Name = "Chips",
		Size = UDim2.new(1, -200, 0, 26),
		Position = UDim2.fromOffset(18, 72),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = hero,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Parent = chips,
	})
	local function chip(order: number, color: Color3, textColor: Color3): Frame
		return UIUtil.Chip({
			Text = "",
			Color = color,
			TextColor3 = textColor,
			Height = 24,
			TextSize = 13,
			LayoutOrder = order,
			ZIndex = 4,
			StrokeColor = WHITE,
			Visible = false,
			Parent = chips,
		})
	end
	heroChips = {
		VIP = chip(1, Theme.Colors.Premium, Theme.Colors.TextDark),
		Bonus = chip(2, WHITE, HERO_TOP),
		Boost = chip(3, Theme.Colors.Boost, Theme.Colors.TextLight),
	}
	-- Toujours visible : rappel "achat sécurisé"
	local safe = chip(4, WHITE, Theme.Colors.RobuxDark)
	safe.Visible = true
	setChip(safe, true, Locale.T("🔒 Secure Roblox payment"))
end

----------------------------------------------------------------------
-- Morceaux de cartes
----------------------------------------------------------------------

-- Ruban diagonal "BIENTÔT" (coin haut droit de la vitrine). Il croise les
-- bords droits de la vitrine (pas le coin arrondi) ; son reflet est un
-- dégradé qui glisse (Tween en boucle : aucun code par image, joué
-- seulement quand la boutique est ouverte).
local function comingSoonRibbon(showcase: Frame, inset: number, zIndex: number)
	local ribbon = UIUtil.Create("Frame", {
		Name = "SoonRibbon",
		Size = UDim2.fromOffset(inset * 4 + 40, 22),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -inset, 0, inset),
		Rotation = 45,
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = zIndex,
		Parent = showcase,
	})
	UIUtil.Stroke(ribbon, WHITE, 1.5, 0.15)
	local shine = UIUtil.Create("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, SOON_PINK),
			ColorSequenceKeypoint.new(0.4, SOON_PINK),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 214, 236)),
			ColorSequenceKeypoint.new(0.6, Color3.fromRGB(255, 120, 60)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 120, 60)),
		}),
		Offset = Vector2.new(-0.6, 0),
		Parent = ribbon,
	})
	table.insert(shineTweens, TweenService:Create(shine, TweenInfo.new(1.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, false, 2.2), {
		Offset = Vector2.new(0.6, 0),
	}))
	local label = UIUtil.Create("TextLabel", {
		Name = "Label",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = Locale.T("COMING SOON"),
		TextColor3 = WHITE,
		TextSize = 11,
		ZIndex = zIndex + 1,
		Parent = ribbon,
	})
	local labelStroke = UIUtil.Stroke(label, Color3.fromRGB(150, 20, 70), 1, 0.35)
	labelStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	return ribbon
end

-- Petits tickets en arc de cercle derrière l'icône (plus le pack est gros, plus il y en a)
local function ticketFan(showcase: Frame, amount: number, zIndex: number)
	local count = amount >= 100 and 5 or (amount >= 50 and 4 or (amount >= 25 and 3 or (amount >= 10 and 2 or 1)))
	for index = 1, count do
		local t = count == 1 and 0.5 or (index - 1) / (count - 1)
		local angle = math.rad(200 + t * 140) -- de 200° à 340° : arc au-dessus de l'icône
		local radius = 34
		UIUtil.Create("TextLabel", {
			Name = "FanTicket" .. index,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, math.cos(angle) * radius * 1.3, 0.56, math.sin(angle) * radius * 0.75),
			Size = UDim2.fromOffset(24, 24),
			Rotation = (t - 0.5) * 50,
			BackgroundTransparency = 1,
			Font = Theme.Fonts.Body,
			Text = TICKET,
			TextSize = 18,
			ZIndex = zIndex,
			Parent = showcase,
		})
	end
end

-- Chip de mise en avant (ruban de la config ou HIGHLIGHTS)
local function tagChip(parent: Instance, text: string, zIndex: number, anchorRight: boolean): Frame
	local ribbon = UIUtil.Chip({
		Name = "Highlight",
		Text = Locale.T(text),
		Color = Theme.Colors.Premium,
		TextColor3 = Theme.Colors.TextDark,
		Height = 18,
		TextSize = 10,
		ZIndex = zIndex,
		Parent = parent,
	})
	if anchorRight then
		ribbon.AnchorPoint = Vector2.new(1, 0)
		ribbon.Position = UDim2.new(1, -6, 0, 6)
	else
		ribbon.Position = UDim2.fromOffset(6, 6)
	end
	return ribbon
end

-- Bouton prix : pièce "R$" + prix (le texte du bouton lui-même reste vide)
local function priceButton(card: Frame, height: number, bottom: number, coinSize: number): TextButton
	local button = UIUtil.NeonButton({
		Name = "Price",
		Text = "",
		Color = Theme.Colors.Robux,
		TextColor3 = Theme.Colors.TextLight,
		Size = UDim2.new(1, -16, 0, height),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -bottom),
		CornerRadius = math.floor(height / 2),
		MaxTextSize = 17,
		ZIndex = 4,
		Parent = card,
	})
	local coin = UIUtil.Create("Frame", {
		Name = "Coin",
		Size = UDim2.fromOffset(coinSize, coinSize),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 2, 0.5, 0),
		BackgroundColor3 = WHITE,
		Visible = false,
		ZIndex = 5,
		Parent = button,
	})
	UIUtil.Corner(coin, UDim.new(1, 0))
	UIUtil.Stroke(coin, Theme.Colors.RobuxDark, 1.5, 0.1)
	UIUtil.Create("TextLabel", {
		Name = "Symbol",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = "R$",
		TextSize = coinSize >= 24 and 11 or 10,
		TextColor3 = Theme.Colors.RobuxDark,
		ZIndex = 6,
		Parent = coin,
	})
	local priceLabel = UIUtil.Create("TextLabel", {
		Name = "PriceLabel",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = "",
		TextScaled = true,
		TextColor3 = Theme.Colors.TextLight,
		ZIndex = 5,
		Parent = button,
	})
	UIUtil.Create("UITextSizeConstraint", { MaxTextSize = height >= 38 and 19 or 16, MinTextSize = 9, Parent = priceLabel })
	local priceStroke = UIUtil.Stroke(priceLabel, Theme.Colors.RobuxDark, 1, 0.35)
	priceStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	return button
end

----------------------------------------------------------------------
-- Construction des cartes
----------------------------------------------------------------------

local function buildCard(section: Section, def, isPass: boolean, order: number)
	local sectionId = section.Def.Id
	local compact = section.Def.Style == "Compact"
	local soon = isComingSoon(def, isPass)
	local color: Color3 = isPass and (PASS_COLORS[def.Id] or Theme.Colors.Purple)
		or (PRODUCT_COLORS[def.Kind] or Theme.Colors.Cyan)

	local cell = UIUtil.Create("Frame", {
		Name = tostring(def.Id),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = section.Grid,
	})
	local card = UIUtil.Create("Frame", {
		Name = "Card",
		Size = UDim2.new(1, 0, 1, -6),
		Position = UDim2.fromOffset(0, 5),
		BackgroundColor3 = Theme.Colors.Card,
		ZIndex = 2,
		Parent = cell,
	})
	UIUtil.Corner(card, Theme.Radius.L)
	local stroke = UIUtil.Stroke(card, color:Lerp(BLACK, 0.2), 1.5, 0.35)
	UIUtil.Shadow(card, 3, 0.86, 2)

	-- Vitrine
	local showcaseHeight = compact and 88 or 104
	local showcase = UIUtil.Create("Frame", {
		Name = "Showcase",
		Size = UDim2.new(1, -10, 0, showcaseHeight),
		Position = UDim2.fromOffset(5, 5),
		BackgroundColor3 = WHITE,
		ClipsDescendants = true,
		ZIndex = 3,
		Parent = card,
	})
	UIUtil.Corner(showcase, Theme.Radius.M)
	if def.Kind == "Tickets" then
		-- Vitrine "fête foraine" : dégradé doré chaud
		UIUtil.Gradient(showcase, ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 236, 170)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 170, 70)),
		}), 90)
	else
		UIUtil.SoftGradient(showcase, color, 90)
	end
	local iconY = compact and 0.56 or 0.55
	local rays = UIUtil.Rays(showcase, WHITE, 6, compact and 170 or 190, UDim2.fromScale(0.5, iconY), 3)
	local glow = UIUtil.Create("Frame", {
		Name = "Glow",
		Size = UDim2.fromOffset(compact and 60 or 74, compact and 60 or 74),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, iconY),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.55,
		ZIndex = 3,
		Parent = showcase,
	})
	UIUtil.Corner(glow, UDim.new(1, 0))
	if def.Kind == "Tickets" then
		ticketFan(showcase, tonumber(def.Tickets) or 0, 4)
	end
	UIUtil.Label({
		Name = "Icon",
		Text = tostring(def.Icon or (isPass and "♾️" or "💧")),
		Size = UDim2.fromOffset(compact and 50 or 64, compact and 50 or 64),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, iconY + 0.01),
		MaxTextSize = compact and 42 or 54,
		ZIndex = 5,
		Parent = showcase,
	})
	-- "×25" : nombre de tickets du pack, en gros
	if def.Kind == "Tickets" then
		local count = UIUtil.Create("TextLabel", {
			Name = "Amount",
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -6, 1, -2),
			Size = UDim2.fromOffset(70, 28),
			BackgroundTransparency = 1,
			Font = Theme.Fonts.Number,
			Text = "×" .. tostring(def.Tickets or 0),
			TextColor3 = WHITE,
			TextSize = 24,
			TextXAlignment = Enum.TextXAlignment.Right,
			ZIndex = 6,
			Parent = showcase,
		})
		local countStroke = UIUtil.Stroke(count, Color3.fromRGB(170, 70, 0), 2, 0)
		countStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	end

	-- "Pour toujours" / "Rachetable" (grandes cartes seulement)
	local kindChip: Frame? = nil
	local highlight = def.Tag or HIGHLIGHTS[def.Id]
	if not compact then
		local chip = UIUtil.Chip({
			Name = "Kind",
			Text = isPass and Locale.T("♾️ FOREVER") or Locale.T("🔁 REBUYABLE"),
			Color = WHITE,
			TextColor3 = color:Lerp(BLACK, 0.45),
			Height = 18,
			TextSize = 10,
			ZIndex = 5,
			StrokeColor = WHITE,
			Parent = showcase,
		})
		chip.Position = UDim2.fromOffset(6, 6)
		kindChip = chip
		if highlight or soon then
			-- Deux pastilles ne tiennent pas sur une ligne : "Pour toujours" se
			-- réduit à son icône (la ligne "Extra" le redit en toutes lettres)
			local kindLabel = chip:FindFirstChild("Label") :: TextLabel?
			if kindLabel then
				kindLabel.Text = isPass and "♾️" or "🔁"
			end
		end
	end
	-- Ruban de mise en avant (à droite ; à gauche sur les cartes "Bientôt"
	-- et compactes, pour laisser la place au ruban diagonal)
	if highlight then
		if compact then
			tagChip(showcase, highlight, 6, false)
		elseif soon then
			local ribbon = tagChip(showcase, highlight, 6, false)
			ribbon.Position = UDim2.fromOffset(32, 6)
		else
			tagChip(showcase, highlight, 5, true)
		end
	end
	if soon then
		comingSoonRibbon(showcase, compact and 36 or 42, 7)
	end

	-- Ruban "✔ ACHETÉ" (passes possédés)
	local owned: Frame? = nil
	if isPass then
		-- En haut à gauche, à la place de "Pour toujours" : ne cache pas l'icône
		local ownedChip = UIUtil.Chip({
			Name = "Owned",
			Text = Locale.T("✔ PURCHASED"),
			Color = Theme.Colors.Robux,
			TextColor3 = WHITE,
			Height = 18,
			TextSize = 10,
			ZIndex = 6,
			Visible = false,
			StrokeColor = WHITE,
			Parent = showcase,
		})
		ownedChip.Position = UDim2.fromOffset(6, 6)
		owned = ownedChip
	end

	-- Pastille "👉 Conseillé" (Spotlight, ex. pack proposé par NeedTickets)
	local spot = UIUtil.Chip({
		Name = "Spot",
		Text = Locale.T("👉 Best fit"),
		Color = TICKET_GOLD,
		TextColor3 = TICKET_INK,
		Height = 20,
		TextSize = 11,
		ZIndex = 8,
		Visible = false,
		StrokeColor = WHITE,
		Parent = card,
	})
	-- (à cheval sur le haut de la carte : ne cache ni l'icône ni le nom)
	spot.AnchorPoint = Vector2.new(0.5, 0.5)
	spot.Position = UDim2.new(0.5, 0, 0, 1)

	-- Textes
	local nameTop = showcaseHeight + (compact and 10 or 9)
	UIUtil.Label({
		Name = "OfferName",
		Text = Locale.T(tostring(def.Name)),
		Font = Theme.Fonts.Title,
		Size = UDim2.new(1, -14, 0, compact and 19 or 22),
		Position = UDim2.fromOffset(7, nameTop),
		MaxTextSize = compact and 15 or 18,
		ZIndex = 3,
		Parent = card,
	})
	local desc = UIUtil.Create("TextLabel", {
		Name = "Description",
		Text = Locale.T(tostring(def.Description or "")),
		Font = Theme.Fonts.Body,
		TextSize = compact and 12 or 14,
		TextColor3 = Theme.Colors.TextDim,
		TextWrapped = true,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, compact and -14 or -20, 0, compact and 28 or 32),
		Position = UDim2.fromOffset(compact and 7 or 10, nameTop + (compact and 20 or 23)),
		ZIndex = 3,
		Parent = card,
	})
	desc.TextTruncate = Enum.TextTruncate.AtEnd
	if compact then
		-- Petite carte : le texte rétrécit pour tenir sur 2 lignes (jamais de débordement)
		desc.TextYAlignment = Enum.TextYAlignment.Top
		desc.TextScaled = true
		UIUtil.Create("UITextSizeConstraint", { MaxTextSize = 12, MinTextSize = 8, Parent = desc })
	end
	local extra = UIUtil.Label({
		Name = "Extra",
		Text = "",
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, -14, 0, compact and 14 or 16),
		Position = UDim2.fromOffset(7, nameTop + (compact and 50 or 57)),
		MaxTextSize = compact and 12 or 13,
		ZIndex = 3,
		Parent = card,
	})

	local button = priceButton(card, compact and 34 or 38, compact and 8 or 9, compact and 20 or 24)

	local offer: Offer = {
		Def = def,
		IsPass = isPass,
		Id = tonumber(isPass and def.GamePassId or def.ProductId) or 0,
		Section = sectionId,
		Soon = soon,
		Compact = compact,
		Color = color,
		Cell = cell,
		Card = card,
		Stroke = stroke,
		Button = button,
		Extra = extra,
		Owned = owned,
		Kind = kindChip,
		Spot = spot,
		Rays = rays,
		Hovered = false,
		Spotlit = 0,
	}
	button.Activated:Connect(function()
		prompt(offer)
	end)
	local function hover(on: boolean)
		offer.Hovered = on
		UIUtil.Tween(card, 0.18, { Position = UDim2.fromOffset(0, on and 0 or 5) }, Enum.EasingStyle.Quad)
		refreshOffer(offer)
	end
	card.MouseEnter:Connect(function()
		hover(true)
	end)
	card.MouseLeave:Connect(function()
		hover(false)
	end)
	table.insert(offers, offer)
	table.insert(section.Offers, offer)
	offersById[tostring(def.Id)] = offer
	refreshOffer(offer)
	refreshExtra(offer, ClientState.Data)
end

----------------------------------------------------------------------
-- Sections
----------------------------------------------------------------------

-- Ouvre l'arcade (onglet boutique à tickets) depuis l'onglet 🎟️ Tickets
local function openArcade()
	if not PanelManager.IsRegistered("Arcade") then
		return
	end
	SoundManager.Play("Click", 1.2)
	PanelManager.Open("Arcade")
	local panels = script.Parent
	local module = panels:FindFirstChild("Arcade")
	if module and module:IsA("ModuleScript") then
		local ok, arcade = pcall(require, module)
		if ok and type(arcade) == "table" and type((arcade :: any).ShowTab) == "function" then
			(arcade :: any).ShowTab("Shop")
		end
	end
end

-- Bandeau sous les packs de tickets : rappel honnête + retour à l'arcade
local function buildTicketFooter(section: Section)
	local footer = UIUtil.Create("Frame", {
		Name = "Footer",
		Size = UDim2.new(1, 0, 0, FOOTER_HEIGHT - 8),
		BackgroundColor3 = Color3.fromRGB(255, 247, 228),
		ZIndex = 2,
		Parent = section.Frame,
	})
	UIUtil.Corner(footer, Theme.Radius.M)
	UIUtil.Stroke(footer, TICKET_GOLD, 1, 0.45)
	local info = UIUtil.Create("TextLabel", {
		Name = "Info",
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -176, 1, 0),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		Text = Locale.T("🎟️ Tickets buy treats, boosts and badges in the arcade. %s Duel trophies can't be bought: they're earned only by playing.", TROPHY),
		TextColor3 = TICKET_INK,
		TextSize = 13,
		TextWrapped = true,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 3,
		Parent = footer,
	})
	UIUtil.Create("UITextSizeConstraint", { MaxTextSize = 13, MinTextSize = 9, Parent = info })
	local button = UIUtil.PillButton({
		Name = "OpenArcade",
		Text = Locale.T("🕹️ Arcade"),
		Color = Color3.fromRGB(166, 90, 255),
		TextColor3 = WHITE,
		Height = 32,
		TextSize = 15,
		ZIndex = 4,
		Parent = footer,
	})
	button.AnchorPoint = Vector2.new(1, 0.5)
	button.Position = UDim2.new(1, -10, 0.5, 0)
	button.Activated:Connect(openArcade)
	arcadeButton = button
	section.Footer = footer
end

local function buildSection(parent: ScrollingFrame, def, order: number): Section
	local style = STYLES[def.Style] or STYLES.Big
	local frame = UIUtil.Create("Frame", {
		Name = "Section_" .. def.Id,
		Size = UDim2.new(1, 0, 0, SECTION_HEADER),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	})
	-- Titre : barre de couleur, titre, note à droite
	local header = UIUtil.Create("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, SECTION_HEADER - 4),
		BackgroundTransparency = 1,
		Parent = frame,
	})
	local bar = UIUtil.Create("Frame", {
		Name = "Accent",
		Size = UDim2.fromOffset(5, 18),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 2, 0.5, 0),
		BackgroundColor3 = def.Color,
		BorderSizePixel = 0,
		Parent = header,
	})
	UIUtil.Corner(bar, 3)
	UIUtil.Label({
		Name = "Title",
		Text = Locale.T(def.Title),
		Font = Theme.Fonts.Title,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(0.5, -14, 0, 22),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 14, 0.5, 0),
		MaxTextSize = 18,
		Parent = header,
	})
	local note = UIUtil.Label({
		Name = "Note",
		Text = def.Note ~= "" and Locale.T(def.Note) or "",
		TextColor3 = Theme.Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Right,
		Size = UDim2.new(0.5, -6, 0, 18),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -4, 0.5, 0),
		MaxTextSize = 13,
		Parent = header,
	})
	local grid = UIUtil.Create("Frame", {
		Name = "Grid",
		Size = UDim2.new(1, 0, 0, 0),
		Position = UDim2.fromOffset(0, SECTION_HEADER),
		BackgroundTransparency = 1,
		Parent = frame,
	})
	UIUtil.Create("UIGridLayout", {
		CellSize = UDim2.new(1 / style.Columns, -math.ceil(style.Gap * (style.Columns - 1) / style.Columns), 0, style.CellHeight),
		CellPadding = UDim2.fromOffset(style.Gap, style.RowGap),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})
	local section: Section = {
		Def = def,
		Frame = frame,
		Grid = grid,
		Note = note,
		Footer = nil,
		Offers = {},
		Columns = style.Columns,
		CellHeight = style.CellHeight,
		RowGap = style.RowGap,
	}
	table.insert(sections, section)
	sectionsById[def.Id] = section
	return section
end

-- Place les sections selon l'onglet : cartes visibles, hauteurs, défilement
local function applyFilter()
	local total = LIST_PADDING_TOP + LIST_PADDING_BOTTOM
	local shownSections = 0
	local shownOffers = 0
	for _, section in ipairs(sections) do
		local count = 0
		for _, offer in ipairs(section.Offers) do
			local show = cellVisible(offer, filter)
			offer.Cell.Visible = show
			if show then
				count += 1
			end
		end
		local rows = math.ceil(count / section.Columns)
		local gridHeight = rows > 0 and (rows * section.CellHeight + (rows - 1) * section.RowGap) or 0
		section.Grid.Size = UDim2.new(1, 0, 0, gridHeight)
		local height = SECTION_HEADER + gridHeight
		local footer = section.Footer
		if footer then
			footer.Position = UDim2.fromOffset(0, height + 6)
			height += FOOTER_HEIGHT
		end
		section.Frame.Size = UDim2.new(1, 0, 0, height)
		section.Frame.Visible = count > 0
		if count > 0 then
			total += height + (shownSections > 0 and SECTION_GAP or 0)
			shownSections += 1
			shownOffers += count
		end
	end
	local scroll = list
	if scroll then
		scroll.CanvasSize = UDim2.fromOffset(0, total)
	end
	if filterEmpty then
		filterEmpty.Visible = shownOffers == 0 and #offers > 0
	end
end

-- Solde de tickets (titre de la section 🎟️) + bouton Arcade
local function refreshTicketNote(data)
	local section = sectionsById.Tickets
	if not section then
		return
	end
	local tickets = tonumber(data and data.Tickets)
	local text
	if not ClientState.HasFeature(ArcadeConfig.Feature) then
		text = Locale.T("🔒 Unlock the 🕹️ Arcade to use tickets")
	elseif tickets then
		text = Locale.T("You have %s %s", NumberFormatter.Format(tickets), TICKET)
	else
		text = Locale.T("For the 🕹️ arcade ticket shop")
	end
	if section.Note.Text ~= text then
		section.Note.Text = text
	end
	local button = arcadeButton
	if button then
		button.Visible = PanelManager.IsRegistered("Arcade") and ClientState.HasFeature(ArcadeConfig.Feature)
	end
end

----------------------------------------------------------------------
-- API du panneau
----------------------------------------------------------------------

function RobuxShop.Build(content: Frame)
	local studio = RunService:IsStudio()
	buildHero(content)

	-- Offres affichées : configurées (ID ~= 0), "Bientôt" (toujours), et
	-- dans Studio aussi les autres (aperçu)
	local chosen: { { Def: any, IsPass: boolean } } = {}
	local hidden = 0
	local hasSoon = false
	for _, pass in ipairs(Config.Monetization.GamePasses) do
		local id = tonumber(pass.GamePassId) or 0
		local soon = isComingSoon(pass, true)
		if id ~= 0 or soon or studio then
			table.insert(chosen, { Def = pass, IsPass = true })
		end
		if id == 0 and not soon then
			hidden += 1
		end
		hasSoon = hasSoon or soon
	end
	for _, product in ipairs(Config.Monetization.Products) do
		local id = tonumber(product.ProductId) or 0
		local soon = isComingSoon(product, false)
		if id ~= 0 or soon or studio then
			table.insert(chosen, { Def = product, IsPass = false })
		end
		if id == 0 and not soon then
			hidden += 1
		end
		hasSoon = hasSoon or soon
	end

	-- Onglets (🔜 seulement s'il y a des offres "Bientôt")
	local tabList = {
		{ Id = "All", Text = Locale.T("⭐ All") },
		{ Id = "Passes", Text = Locale.T("♾️ Passes") },
		{ Id = "Dopamine", Text = Locale.T("💧 Dopamine") },
		{ Id = "Boosts", Text = Locale.T("⚡ Boosts") },
		{ Id = "Tickets", Text = Locale.T("🎟️ Tickets") },
	}
	if hasSoon then
		table.insert(tabList, { Id = "Soon", Text = Locale.T("🔜 Soon") })
	end
	for _, tab in ipairs(tabList) do
		tabIds[tab.Id] = true
	end
	filterTabs = UIUtil.Tabs({
		Parent = content,
		Tabs = tabList,
		Color = Theme.Colors.Purple,
		Size = UDim2.new(1, 0, 0, 36),
		Position = UDim2.fromOffset(0, 118),
		Selected = filter,
		TextSize = 15,
		OnSelect = function(id: string)
			filter = id
			applyFilter()
			local scroll = list
			if scroll then
				scroll.CanvasPosition = Vector2.zero
			end
			SoundManager.Play("Click", 1.3)
		end,
	})

	local top = 162
	if studio and hidden > 0 then
		-- Bandeau d'aide pour le propriétaire (Studio uniquement)
		local notice = UIUtil.Create("Frame", {
			Name = "StudioNotice",
			Size = UDim2.new(1, 0, 0, 26),
			Position = UDim2.fromOffset(0, top),
			BackgroundColor3 = Color3.fromRGB(255, 244, 220),
			Parent = content,
		})
		UIUtil.Corner(notice, Theme.Radius.S)
		UIUtil.Stroke(notice, Theme.Colors.Orange, 1, 0.5)
		UIUtil.Label({
			Text = Locale.T(
				"🛠️ Studio preview: %d offer(s) without an ID (0) — hidden in the published game. Paste your IDs in Config.Monetization.",
				hidden
			),
			TextColor3 = Color3.fromRGB(150, 80, 0),
			Size = UDim2.new(1, -16, 1, -8),
			Position = UDim2.fromOffset(8, 4),
			MaxTextSize = 13,
			Parent = notice,
		})
		top += 32
	end

	local scroll = UIUtil.Create("ScrollingFrame", {
		Name = "Offers",
		Size = UDim2.new(1, 0, 1, -top),
		Position = UDim2.fromOffset(0, top),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = Theme.Colors.Purple,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = content,
	})
	UIUtil.Create("UIPadding", {
		PaddingTop = UDim.new(0, LIST_PADDING_TOP),
		PaddingLeft = UDim.new(0, 4),
		PaddingRight = UDim.new(0, 12),
		PaddingBottom = UDim.new(0, LIST_PADDING_BOTTOM),
		Parent = scroll,
	})
	UIUtil.Create("UIListLayout", {
		Padding = UDim.new(0, SECTION_GAP),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = scroll,
	})
	list = scroll

	-- Sections, puis cartes dans l'ordre de la config
	for index, def in ipairs(SECTIONS) do
		buildSection(scroll, def, index)
	end
	local orderInSection: { [string]: number } = {}
	for _, entry in ipairs(chosen) do
		local sectionId = sectionOf(entry.Def, entry.IsPass)
		local section = sectionsById[sectionId]
		if section then
			orderInSection[sectionId] = (orderInSection[sectionId] or 0) + 1
			buildCard(section, entry.Def, entry.IsPass, orderInSection[sectionId])
		end
	end
	local ticketSection = sectionsById.Tickets
	if ticketSection and #ticketSection.Offers > 0 then
		buildTicketFooter(ticketSection)
	end

	filterEmpty = UIUtil.Label({
		Name = "FilterEmpty",
		Text = Locale.T("Nothing in this category for now."),
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, 0, 0, 30),
		Position = UDim2.fromOffset(0, top + 40),
		MaxTextSize = 16,
		Visible = false,
		Parent = content,
	})

	-- Rien à vendre (jeu publié) : état vide propre
	if #offers == 0 then
		local empty = UIUtil.Create("Frame", {
			Name = "Empty",
			Size = UDim2.new(1, 0, 1, -top),
			Position = UDim2.fromOffset(0, top),
			BackgroundTransparency = 1,
			Parent = content,
		})
		local bubble = UIUtil.Create("Frame", {
			Size = UDim2.fromOffset(110, 110),
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 30),
			BackgroundColor3 = Theme.Colors.Surface,
			Parent = empty,
		})
		UIUtil.Corner(bubble, UDim.new(1, 0))
		UIUtil.Stroke(bubble, Theme.Colors.Divider, 2)
		UIUtil.Label({
			Text = "💎",
			Size = UDim2.new(1, -24, 1, -24),
			Position = UDim2.fromOffset(12, 12),
			MaxTextSize = 60,
			Parent = bubble,
		})
		UIUtil.Label({
			Text = Locale.T("Coming soon"),
			Font = Theme.Fonts.Title,
			Size = UDim2.new(1, -40, 0, 30),
			Position = UDim2.fromOffset(20, 156),
			MaxTextSize = 24,
			Parent = empty,
		})
		UIUtil.Label({
			Text = Locale.T("The shop opens very soon. Come back and see us! 💖"),
			TextColor3 = Theme.Colors.TextDim,
			Size = UDim2.new(1, -80, 0, 22),
			Position = UDim2.fromOffset(40, 192),
			MaxTextSize = 16,
			Parent = empty,
		})
	end
	applyFilter()
	refreshTicketNote(ClientState.Data)

	-- Pass acheté : "⏳ Activation…" jusqu'à la confirmation du serveur
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(who: Player, passId: number, purchased: boolean)
		if who ~= player or not purchased then
			return
		end
		pendingPasses[passId] = os.clock()
		for _, offer in ipairs(offers) do
			if offer.IsPass and offer.Id == passId then
				refreshOffer(offer)
			end
		end
	end)

	refreshStatus(ClientState.Data)
end

-- Ouvre directement un onglet ("Dopamine" quand il en manque pour un achat,
-- "Tickets" quand il manque des tickets à l'arcade, "Soon"...)
function RobuxShop.ShowTab(id: string)
	if not tabIds[id] then
		return
	end
	filter = id
	local tabs = filterTabs
	if tabs then
		tabs.Select(id, true)
	end
	applyFilter()
	local scroll = list
	if scroll then
		scroll.CanvasPosition = Vector2.zero
	end
end

-- Met une offre en avant (ex. le pack de tickets conseillé) : son onglet est
-- affiché, la liste défile jusqu'à elle, contour doré + "👉 Conseillé"
function RobuxShop.Spotlight(offerId: string)
	local offer = offersById[tostring(offerId)]
	if not offer then
		return
	end
	if not cellVisible(offer, filter) then
		RobuxShop.ShowTab(offer.Soon and "Soon" or (offer.Section == "Combos" and "Tickets" or offer.Section))
	end
	-- Position de la carte dans la liste (sections visibles au-dessus + rang)
	local y = LIST_PADDING_TOP
	local found = false
	for _, section in ipairs(sections) do
		if section.Frame.Visible then
			local index = 0
			for _, other in ipairs(section.Offers) do
				if other == offer then
					found = true
					break
				end
				if other.Cell.Visible then
					index += 1
				end
			end
			if found then
				y += SECTION_HEADER + math.floor(index / section.Columns) * (section.CellHeight + section.RowGap)
				break
			end
			y += section.Frame.Size.Y.Offset + SECTION_GAP
		end
	end
	local scroll = list
	if scroll and found then
		local target = Vector2.new(0, math.max(0, y - SECTION_HEADER - 4))
		TweenService:Create(scroll, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { CanvasPosition = target }):Play()
	end
	offer.Spotlit = os.clock() + 4
	refreshOffer(offer)
	UIUtil.Pop(offer.Card, 1.08, 0.5)
	task.delay(4.1, function()
		if offer.Card.Parent then
			refreshOffer(offer)
		end
	end)
end

function RobuxShop.OnOpen()
	visible = true
	-- Vrais prix (threads séparés : ne bloque jamais l'interface)
	for _, offer in ipairs(offers) do
		fetchPrice(offer)
	end
	refreshStatus(ClientState.Data)
	refreshTicketNote(ClientState.Data)
	for _, tween in ipairs(shineTweens) do
		tween:Play()
	end

	-- Animations (seulement fenêtre ouverte, 30 images/s au plus) : rayons,
	-- diamant, étincelles, et comptes à rebours (boost, activation) 2 fois par seconde
	if animation then
		animation:Disconnect()
	end
	local started = os.clock()
	animClock = 0
	animation = RunService.RenderStepped:Connect(function(dt: number)
		animClock += dt
		refreshClock += dt
		if animClock >= ANIM_STEP then
			local step = animClock
			animClock = 0
			local t = os.clock() - started
			heroRays.Rotation = (heroRays.Rotation + step * 14) % 360
			heroDiamond.Position = UDim2.new(1, -80, 0.5, math.sin(t * 2) * 4)
			heroDiamond.Rotation = math.sin(t * 1.3) * 6
			for _, star in ipairs(sparkles) do
				local phase = star:GetAttribute("Phase") or 0
				star.TextTransparency = 0.2 + 0.6 * (0.5 + 0.5 * math.sin(t * 2.5 + phase))
			end
			for _, offer in ipairs(offers) do
				if offer.Cell.Visible then
					offer.Rays.Rotation = (offer.Rays.Rotation + step * (offer.Hovered and 60 or 12)) % 360
				end
			end
		end
		if refreshClock >= 0.5 then
			refreshClock = 0
			local data = ClientState.Data
			refreshStatus(data)
			for _, offer in ipairs(offers) do
				if offer.Def.Kind == "Boost" then
					refreshExtra(offer, data)
				end
				if offer.IsPass and pendingPasses[offer.Id] then
					refreshOffer(offer)
				end
			end
		end
	end)
end

function RobuxShop.OnClose()
	visible = false
	local connection = animation
	if connection then
		connection:Disconnect()
		animation = nil
	end
	for _, tween in ipairs(shineTweens) do
		tween:Pause()
	end
end

function RobuxShop.Update(data)
	for _, offer in ipairs(offers) do
		refreshOffer(offer)
		refreshExtra(offer, data)
	end
	refreshStatus(data)
	refreshTicketNote(data)
end

-- Vrai si au moins une offre Robux est configurée (utilisé par la colonne centrale)
function RobuxShop.HasOffers(): boolean
	return Config.IsSellingForRobux == true
end

-- Vrai si la boutique est ouverte
function RobuxShop.IsOpen(): boolean
	return visible
end

return RobuxShop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="75">
            <Properties>
              <string name="Name">ScreenTime</string>
              <string name="Source"><![CDATA[--[[
	ScreenTime (ModuleScript) — "Temps d'écran"
	Emplacement : ReplicatedStorage > Client > Components > Panels > ScreenTime

	Combien de temps le joueur a passé ici :
	  - trois cartes (session, aujourd'hui, depuis toujours) avec icône et
	    petite comparaison rigolote ; les compteurs défilent EN DIRECT ;
	  - une pastille de commentaire (pas très tendre) selon aujourd'hui ;
	  - un graphique des derniers jours : barres en dégradé qui poussent à
	    l'ouverture, valeur au-dessus de chaque barre, ligne de moyenne,
	    aujourd'hui mis en valeur.
	Débloqué par l'amélioration "Temps d'écran" (Feature "ScreenTime").
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local ClientState = require(Client.ClientState)
local Config = require(ReplicatedStorage.Shared.Config)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Locale = require(ReplicatedStorage.Shared.Locale)

-- Title / Subtitle en anglais : traduits par PanelManager
local ScreenTime = {
	Title = "⏱️ Screen Time",
	Subtitle = "Time spent here (no judgment… well, a little)",
	Color = Theme.Colors.Dark,
	Size = Vector2.new(660, 540),
}

-- index = wday (1 = dimanche)
local DAY_NAMES = {
	en = { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" },
	fr = { "Dim", "Lun", "Mar", "Mer", "Jeu", "Ven", "Sam" },
}
local MAX_EXTRAPOLATION = 30 -- secondes ajoutées localement entre deux mises à jour
local PLOT_TOP = 30 -- place au-dessus des barres (valeurs)
local BAR_AREA = 0.78 -- part de la hauteur utile occupée par la plus grande barre

-- Commentaires selon le temps passé aujourd'hui (secondes) ; Text en anglais, traduit à l'affichage
local COMMENTS = {
	{ Limit = 10 * 60, Icon = "🙂", Text = "That's reasonable.", Color = Theme.Colors.Green },
	{ Limit = 30 * 60, Icon = "🤔", Text = "It's starting to add up...", Color = Theme.Colors.Orange },
	{ Limit = 60 * 60, Icon = "🌳", Text = "Maybe go outside for a bit...", Color = Theme.Colors.Orange },
	{ Limit = 3 * 3600, Icon = "👀", Text = "Your eyes are not thanking you.", Color = Theme.Colors.Red },
	{ Limit = math.huge, Icon = "🚨", Text = "You have a problem.", Color = Theme.Colors.Red },
}

type Stat = { Value: TextLabel, Sub: TextLabel }
type Bar = { Column: Frame, Bar: Frame, Gradient: UIGradient, Value: TextLabel, Day: TextLabel, Ratio: number }

local stats: { [string]: Stat } = {} -- Session / Today / Total
local commentChip: Frame
local commentIcon: TextLabel
local commentText: TextLabel
local liveDot: Frame
local bars: { Bar } = {}
local plot: Frame
local averageLine: Frame
local averageLabel: TextLabel
local base = { Session = 0, Today = 0, Total = 0 }
local lastUpdateClock = os.clock()
local lastComment = ""
local visible = false

----------------------------------------------------------------------
-- Construction
----------------------------------------------------------------------

local function statCard(parent: Frame, order: number, icon: string, title: string, color: Color3): Stat
	local card = UIUtil.Create("Frame", {
		Name = "Stat" .. order,
		Size = UDim2.new(1 / 3, -8, 1, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		LayoutOrder = order,
		Parent = parent,
	})
	UIUtil.Corner(card, Theme.Radius.L)
	UIUtil.Stroke(card, color, 1.5, 0.55)
	UIUtil.Gradient(card, ColorSequence.new(Color3.new(1, 1, 1), color:Lerp(Color3.new(1, 1, 1), 0.86)), 90)

	local bubble = UIUtil.Create("Frame", {
		Name = "Icon",
		Size = UDim2.fromOffset(40, 40),
		Position = UDim2.fromOffset(12, 12),
		BackgroundColor3 = color,
		Parent = card,
	})
	UIUtil.Corner(bubble, UDim.new(1, 0))
	UIUtil.Stroke(bubble, color:Lerp(Color3.new(0, 0, 0), 0.25), 1.5, 0.3)
	UIUtil.Gradient(bubble, ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(205, 205, 205)), 90)
	UIUtil.Label({
		Text = icon,
		Size = UDim2.new(1, -10, 1, -10),
		Position = UDim2.fromOffset(5, 5),
		MaxTextSize = 22,
		Parent = bubble,
	})
	UIUtil.Label({
		Text = title,
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -66, 0, 18),
		Position = UDim2.fromOffset(60, 12),
		MaxTextSize = 14,
		Parent = card,
	})
	local value = UIUtil.Label({
		Name = "Value",
		Text = "0s",
		Font = Theme.Fonts.Number,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -66, 0, 28),
		Position = UDim2.fromOffset(60, 30),
		MaxTextSize = 26,
		Parent = card,
	})
	local sub = UIUtil.Label({
		Name = "Sub",
		Text = "",
		TextColor3 = color:Lerp(Color3.new(0, 0, 0), 0.35),
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -24, 0, 16),
		Position = UDim2.fromOffset(12, 64),
		MaxTextSize = 13,
		Parent = card,
	})
	return { Value = value, Sub = sub }
end

----------------------------------------------------------------------
-- Mises à jour
----------------------------------------------------------------------

local function commentFor(today: number)
	for _, comment in ipairs(COMMENTS) do
		if today < comment.Limit then
			return comment
		end
	end
	return COMMENTS[#COMMENTS]
end

-- Comparaisons rigolotes sous les compteurs
local function funnyTotal(seconds: number): string
	local films = seconds / (2 * 3600)
	if films >= 1 then
		return Locale.T("≈ %s two-hour movie%s 🎬", NumberFormatter.Format(films, 1), films >= 2 and "s" or "")
	end
	local episodes = seconds / (22 * 60)
	if episodes >= 1 then
		return Locale.T("≈ %s TV episode%s 📺", NumberFormatter.Format(episodes, 1), episodes >= 2 and "s" or "")
	end
	return Locale.T("≈ %s three-second videos 📱", tostring(math.floor(seconds / 3 + 0.5)))
end

local function refreshTimes()
	local extra = math.min(os.clock() - lastUpdateClock, MAX_EXTRAPOLATION)
	local session = base.Session + extra
	local today = base.Today + extra
	local total = base.Total + extra
	stats.Session.Value.Text = NumberFormatter.Time(session)
	stats.Today.Value.Text = NumberFormatter.Time(today)
	stats.Total.Value.Text = NumberFormatter.Time(total)
	stats.Session.Sub.Text = Locale.T("● live since you arrived")
	stats.Today.Sub.Text = Locale.T("%.1f%% of your day", today / 864)
	stats.Total.Sub.Text = funnyTotal(total)

	local comment = commentFor(today)
	commentIcon.Text = comment.Icon
	commentText.Text = Locale.T(comment.Text)
	commentText.TextColor3 = comment.Color:Lerp(Color3.new(0, 0, 0), 0.35)
	commentChip.BackgroundColor3 = comment.Color:Lerp(Color3.new(1, 1, 1), 0.85)
	local stroke = commentChip:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = comment.Color
	end
	if comment.Text ~= lastComment then
		lastComment = comment.Text
		UIUtil.Pop(commentChip, 1.15, 0.4)
	end
end

-- Fait pousser les barres (à l'ouverture)
local function growBars()
	for index, ui in ipairs(bars) do
		ui.Bar.Size = UDim2.new(0.62, 0, 0, 0)
		task.delay((index - 1) * 0.04, function()
			UIUtil.Tween(ui.Bar, 0.5, { Size = UDim2.new(0.62, 0, ui.Ratio * BAR_AREA, 0) }, Enum.EasingStyle.Back)
		end)
	end
end

----------------------------------------------------------------------
-- API du panneau
----------------------------------------------------------------------

function ScreenTime.Build(content: Frame)
	local row = UIUtil.Create("Frame", {
		Name = "Stats",
		Size = UDim2.new(1, 0, 0, 90),
		BackgroundTransparency = 1,
		Parent = content,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = row,
	})
	stats.Session = statCard(row, 1, "⏳", Locale.T("This session"), Theme.Colors.Blue)
	stats.Today = statCard(row, 2, "📅", Locale.T("Today"), Theme.Colors.Orange)
	stats.Total = statCard(row, 3, "♾️", Locale.T("All time"), Theme.Colors.Purple)

	-- Point "en direct" qui pulse sur la carte Session
	local sessionCard = row:FindFirstChild("Stat1") :: Frame?
	if sessionCard then
		liveDot = UIUtil.Create("Frame", {
			Name = "Live",
			Size = UDim2.fromOffset(8, 8),
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -12, 0, 14),
			BackgroundColor3 = Theme.Colors.Red,
			Parent = sessionCard,
		})
		UIUtil.Corner(liveDot, UDim.new(1, 0))
	end

	-- Pastille de commentaire
	commentChip = UIUtil.Create("Frame", {
		Name = "Comment",
		Size = UDim2.fromOffset(0, 36),
		AutomaticSize = Enum.AutomaticSize.X,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 102),
		BackgroundColor3 = Theme.Colors.PanelLight,
		Parent = content,
	})
	UIUtil.Corner(commentChip, UDim.new(1, 0))
	UIUtil.Stroke(commentChip, Theme.Colors.Green, 1.5, 0.3)
	UIUtil.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 16),
		Parent = commentChip,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = commentChip,
	})
	commentIcon = UIUtil.Create("TextLabel", {
		Name = "Icon",
		Size = UDim2.fromOffset(26, 26),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		Text = "🙂",
		TextSize = 20,
		LayoutOrder = 1,
		Parent = commentChip,
	})
	commentText = UIUtil.Create("TextLabel", {
		Name = "Text",
		Size = UDim2.fromOffset(0, 26),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = "",
		TextColor3 = Theme.Colors.Text,
		TextSize = 18,
		LayoutOrder = 2,
		Parent = commentChip,
	})

	-- Graphique en barres des derniers jours
	local chart = UIUtil.Create("Frame", {
		Name = "Chart",
		Size = UDim2.new(1, 0, 1, -150),
		Position = UDim2.fromOffset(0, 150),
		BackgroundColor3 = Theme.Colors.Surface,
		Parent = content,
	})
	UIUtil.Corner(chart, Theme.Radius.L)
	UIUtil.Stroke(chart, Theme.Colors.Divider, 1.5)
	UIUtil.Label({
		Text = Locale.T("📊 Last %s days", tostring(Config.ScreenTime.DaysKept)),
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(0.6, 0, 0, 20),
		Position = UDim2.fromOffset(14, 10),
		MaxTextSize = 16,
		Parent = chart,
	})

	plot = UIUtil.Create("Frame", {
		Name = "Plot",
		Size = UDim2.new(1, -28, 1, -(36 + 26)),
		Position = UDim2.fromOffset(14, 36),
		BackgroundTransparency = 1,
		Parent = chart,
	})
	-- Lignes de repère discrètes
	for k = 1, 3 do
		UIUtil.Create("Frame", {
			Name = "Guide" .. k,
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromScale(0, 1 - BAR_AREA * k / 3),
			Size = UDim2.new(1, 0, 0, 1),
			BackgroundColor3 = Theme.Colors.Divider,
			BorderSizePixel = 0,
			Parent = plot,
		})
	end
	-- Ligne de moyenne (pointillés) + étiquette
	averageLine = UIUtil.Create("Frame", {
		Name = "Average",
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.new(1, 0, 0, 2),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = plot,
	})
	for k = 0, 39 do
		UIUtil.Create("Frame", {
			Position = UDim2.fromScale(k / 40, 0),
			Size = UDim2.new(1 / 80, 0, 1, 0),
			BackgroundColor3 = Theme.Colors.Purple,
			BackgroundTransparency = 0.2,
			BorderSizePixel = 0,
			ZIndex = 3,
			Parent = averageLine,
		})
	end
	-- Étiquette de la moyenne : en haut à droite du graphique (légende), jamais
	-- sur les valeurs des barres (la ligne peut passer à leur hauteur)
	averageLabel = UIUtil.Create("TextLabel", {
		Name = "AverageLabel",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 11),
		Size = UDim2.fromOffset(0, 18),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Theme.Colors.Purple,
		Font = Theme.Fonts.Title,
		Text = "",
		TextColor3 = Theme.Colors.TextLight,
		TextSize = 12,
		ZIndex = 4,
		Visible = false,
		Parent = chart,
	})
	UIUtil.Corner(averageLabel, UDim.new(1, 0))
	UIUtil.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 6),
		PaddingRight = UDim.new(0, 6),
		Parent = averageLabel,
	})

	local columns = UIUtil.Create("Frame", {
		Name = "Columns",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = plot,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = columns,
	})

	local count = Config.ScreenTime.DaysKept
	for index = 1, count do
		local column = UIUtil.Create("Frame", {
			Name = "Day" .. index,
			Size = UDim2.new(1 / count, -8, 1, 0),
			BackgroundTransparency = 1,
			LayoutOrder = index,
			ZIndex = 2,
			Parent = columns,
		})
		local isToday = index == count
		local color = isToday and Theme.Colors.Pink or Theme.Colors.Blue
		local bar = UIUtil.Create("Frame", {
			Name = "Bar",
			Size = UDim2.new(0.62, 0, 0, 0),
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromScale(0.5, 1),
			BackgroundColor3 = Color3.new(1, 1, 1),
			ZIndex = 2,
			Parent = column,
		})
		UIUtil.Corner(bar, 8)
		local gradient = UIUtil.Gradient(bar, ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.35), color), 90)
		local value = UIUtil.Create("TextLabel", {
			Name = "Value",
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 0, -3),
			Size = UDim2.fromOffset(80, 14),
			BackgroundTransparency = 1,
			Font = Theme.Fonts.Title,
			Text = "",
			TextColor3 = isToday and Theme.Colors.Pink:Lerp(Color3.new(0, 0, 0), 0.3) or Theme.Colors.TextDim,
			TextSize = 12,
			ZIndex = 3,
			Parent = bar,
		})
		local day = UIUtil.Label({
			Name = "DayName",
			Text = "",
			Font = Theme.Fonts.Title,
			TextColor3 = isToday and Theme.Colors.Pink:Lerp(Color3.new(0, 0, 0), 0.3) or Theme.Colors.TextDim,
			Size = UDim2.new(1, 0, 0, 18),
			AnchorPoint = Vector2.new(0, 0),
			Position = UDim2.new(0, 0, 1, 4),
			MaxTextSize = 13,
			ZIndex = 2,
			Parent = column,
		})
		bars[index] = { Column = column, Bar = bar, Gradient = gradient, Value = value, Day = day, Ratio = 0 }
	end
	-- (la zone des barres laisse la place aux valeurs au-dessus)
	plot.Size = UDim2.new(1, -28, 1, -(36 + 26 + PLOT_TOP))
	plot.Position = UDim2.fromOffset(14, 36 + PLOT_TOP)

	-- Le temps défile pendant que la fenêtre est ouverte (+ point "en direct")
	task.spawn(function()
		local blink = false
		while content.Parent do
			if visible and content.Visible then
				refreshTimes()
				blink = not blink
				if liveDot then
					UIUtil.Tween(liveDot, 0.4, { BackgroundTransparency = blink and 0 or 0.7 })
				end
			end
			task.wait(1)
		end
	end)
end

function ScreenTime.OnOpen()
	visible = true
	if stats.Session then
		refreshTimes()
		growBars()
	end
end

function ScreenTime.Update(data)
	local info = data.ScreenTime
	if type(info) ~= "table" or not stats.Session then
		return
	end
	base.Session = tonumber(info.Session) or 0
	base.Today = tonumber(info.Today) or 0
	base.Total = tonumber(info.Total) or 0
	lastUpdateClock = os.clock()
	refreshTimes()

	-- Barres (plus ancien -> aujourd'hui)
	local days = type(info.Days) == "table" and info.Days or {}
	local count = #bars
	local values = {}
	local maxValue = 60
	local sum, nonZero = 0, 0
	for i = 1, count do
		local value = tonumber(days[#days - count + i]) or 0
		if i == count then
			value = math.max(value, base.Today)
		end
		values[i] = value
		maxValue = math.max(maxValue, value)
		if value > 0 then
			sum += value
			nonZero += 1
		end
	end
	local todayWday = (os.date("!*t") :: any).wday or 1
	for i, ui in ipairs(bars) do
		local value = values[i]
		local ratio = math.clamp(value / maxValue, 0, 1)
		if value > 0 then
			ratio = math.max(ratio, 0.03)
		end
		ui.Ratio = ratio
		-- Mise à jour douce (sauf pendant l'animation d'ouverture)
		ui.Bar.Size = UDim2.new(0.62, 0, ratio * BAR_AREA, 0)
		ui.Value.Text = value > 0 and NumberFormatter.Time(value) or ""
		local offset = count - i -- jours avant aujourd'hui
		local wday = ((todayWday - 1 - offset) % 7) + 1
		ui.Day.Text = offset == 0 and Locale.T("Today") or Locale.Pick(DAY_NAMES)[wday]
	end

	-- Moyenne des jours joués
	local average = nonZero > 0 and sum / nonZero or 0
	averageLine.Visible = average > 0
	averageLabel.Visible = average > 0
	if average > 0 then
		averageLine.Position = UDim2.fromScale(0, 1 - math.clamp(average / maxValue, 0, 1) * BAR_AREA)
		averageLabel.Text = Locale.T("Average %s", NumberFormatter.Time(average))
	end
end

-- Appelé par PanelManager quand la fenêtre se ferme (pour ne plus rafraîchir)
function ScreenTime.OnClose()
	visible = false
end

-- Accès direct (debug)
function ScreenTime.GetToday(): number
	local data = ClientState.Data
	local info = data and data.ScreenTime
	return (info and info.Today) or 0
end

return ScreenTime
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="76">
            <Properties>
              <string name="Name">Settings</string>
              <string name="Source"><![CDATA[--[[
	Settings (ModuleScript) — paramètres (son, musique, son du clic, effets)
	Emplacement : ReplicatedStorage > Client > Components > Panels > Settings

	Présentation "premium" en cartes de section (icône, titre, sous-titre) :
	  - 🔊 Audio : Effets sonores / Musique lofi (interrupteur animé +
	    curseur de volume à halo lumineux), puis le choix du son du clic
	    (▶ pour écouter, clic pour choisir) ;
	  - 🖥️ Affichage : particules et confettis ;
	  - 🎮 Jeu : musique en cours (égaliseur animé, ⏭ morceau suivant),
	    crédits et version.

	Comportements (inchangés) :
	- Interrupteurs Son / Musique / Particules : sauvegardés côté serveur
	  avec la progression (RemoteFunction "SetSetting", booléens), 3 essais
	  puis retour en arrière si le serveur refuse.
	- Son du clic (v4) : liste de Config.ClickSounds, sauvegardé avec
	  SetSetting("ClickSound", id) et joué par SoundManager.PlayClick sur le
	  gros bouton.
	- Curseurs de volume (musique, effets) : gardés en mémoire pour la
	  session (SoundManager.SetMusicVolume / SetEffectsVolume). Ils se
	  glissent à la souris ET au doigt (écran tactile).
	La musique ne joue que si le réglage est actif ET que "Lofi Beats" est
	débloqué (voir SoundManager.SetMusicAllowed).

	v5 :
	- 🌙 Mode sombre (section Affichage) : SetSetting("DarkMode", bool),
	  appliqué tout de suite (ClientState.SetUserDarkMode -> DarkSkin).
	- 🌐 Langue : Auto / English / Français, SetSetting("Language", valeur)
	  ; la langue change au prochain passage dans le jeu (pas de
	  reconstruction en direct) : un bandeau le rappelle.
	- Textes en anglais traduits (Locale) ; zones tactiles agrandies.

	v8 — 🎧 lecteur de musique (section "Musique lofi") :
	- carte "platine" : vinyle qui tourne, titre du morceau, état (en cours,
	  en pause, verrouillé), petit visualiseur animé (volume réel du morceau
	  via PlaybackLoudness quand il est disponible), boutons ⏮ ⏯ ⏭
	  (⏯ = réglage "Musique" sauvegardé) ;
	- interrupteur + volume de la musique (inchangés) ;
	- liste des morceaux (Config.Music.Playlist) : « 🔀 Aléatoire » ou un
	  morceau précis (joué en boucle), ✓ sur le choix actuel. Le choix est
	  appliqué et sauvegardé par SoundManager.SetMusicTrack
	  (SetSetting "MusicTrack") ;
	- animations seulement quand la fenêtre est ouverte (30 images/s max).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Client = script.Parent.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local SoundManager = require(Client.SoundManager)
local Effects = require(Client.Effects)
local ClientState = require(Client.ClientState)
local Net = require(ReplicatedStorage.Shared.Net)
local Config = require(ReplicatedStorage.Shared.Config)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Notifications = require(script.Parent.Parent.Notifications)

-- Title / Subtitle en anglais : traduits par PanelManager
local Settings = {
	Title = "⚙️ Settings",
	Subtitle = "Sound, music, display and language",
	Color = Theme.Colors.Dark,
	Size = Vector2.new(680, 600),
}

local VERSION = "v8"
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local ROW_HOVER = Theme.Colors.Surface or Theme.Colors.PanelLight
local ROW_BORDER = Theme.Colors.Divider or Theme.Colors.Disabled
local ON_COLOR = Theme.Colors.Green
local OFF_COLOR = Theme.Colors.Disabled
local SELECTED_SOFT = Color3.fromRGB(230, 242, 255)

local SECTION_AUDIO = Theme.Colors.Blue
local SECTION_DISPLAY = Theme.Colors.Purple
local SECTION_GAME = Theme.Colors.Orange

type Toggle = { Button: TextButton, Knob: Frame, Stroke: UIStroke, Glyph: TextLabel }
type Slider = { Set: (value: number) -> (), SetEnabled: (enabled: boolean) -> () }

local toggles: { [string]: Toggle } = {} -- [clé] = interrupteur
local sliders: { [string]: Slider } = {} -- [clé du réglage lié] = curseur
local current = { Sound = true, Music = true, Effects = true, DarkMode = false }

-- Langue : onglets Auto / English / Français
local LANGUAGE_OPTIONS = { "Auto", "en", "fr" }
local languageTabs: UIUtil.Tabs? = nil
local languageSaveToken = 0
local languageSaving = false
local languageChosen: string? = nil -- choix local (en attente de sauvegarde)

local musicInfo: TextLabel? = nil -- sous-titre de la ligne "Musique lofi"
local equalizerConnection: RBXScriptConnection? = nil

-- Lecteur de musique (v8)
type Player = {
	Card: Frame,
	Vinyl: Frame,
	VinylLabel: Frame,
	VinylGradient: UIGradient,
	VinylIcon: TextLabel,
	Arm: Frame,
	Status: TextLabel,
	StatusDot: Frame,
	Title: TextLabel,
	Meta: TextLabel,
	Bars: { Frame },
	Play: TextButton,
	Prev: TextButton,
	Next: TextButton,
}
type TrackRow = {
	Key: string,
	Card: TextButton,
	Stroke: UIStroke,
	Check: Frame,
	Name: TextLabel,
	Sub: TextLabel,
	Eq: { Frame },
	Hovered: boolean,
}
local player: Player? = nil
local trackRows: { TrackRow } = {}
local lockBanner: Frame? = nil
local vinylAngle = 0
local barLevels: { number } = {}
local animClock = 0

-- Pochettes des morceaux (par Key ; les autres ont une pochette générique)
local TRACK_ART = {
	Lofi1 = { Icon = "🌧️", A = Color3.fromRGB(96, 140, 220), B = Color3.fromRGB(58, 70, 140) },
	Lofi2 = { Icon = "📚", A = Color3.fromRGB(255, 176, 92), B = Color3.fromRGB(170, 84, 60) },
	Lofi3 = { Icon = "☕", A = Color3.fromRGB(214, 170, 130), B = Color3.fromRGB(120, 84, 70) },
	Lofi4 = { Icon = "🐱", A = Color3.fromRGB(255, 170, 200), B = Color3.fromRGB(170, 90, 170) },
	Lofi5 = { Icon = "🌅", A = Color3.fromRGB(255, 150, 120), B = Color3.fromRGB(200, 70, 130) },
	Lofi6 = { Icon = "🚆", A = Color3.fromRGB(110, 110, 200), B = Color3.fromRGB(34, 36, 90) },
	Lofi7 = { Icon = "🧣", A = Color3.fromRGB(240, 120, 110), B = Color3.fromRGB(140, 60, 90) },
	Lofi8 = { Icon = "✨", A = Color3.fromRGB(150, 110, 255), B = Color3.fromRGB(40, 30, 110) },
}
local SHUFFLE_ART = { Icon = "🔀", A = Color3.fromRGB(255, 120, 200), B = Color3.fromRGB(120, 70, 230) }
local PLAYER_TOP = Color3.fromRGB(46, 28, 86)
local PLAYER_BOTTOM = Color3.fromRGB(22, 18, 48)
local PLAYER_ACCENT = Color3.fromRGB(255, 120, 200)
local PLAYER_ACCENT2 = Color3.fromRGB(110, 220, 255)
local LAVENDER = Color3.fromRGB(200, 188, 240)
local MUSIC_SOFT = Color3.fromRGB(245, 238, 255)
local BAR_COUNT = 18

local function artFor(key: string?, index: number?)
	if key and TRACK_ART[key] then
		return TRACK_ART[key]
	end
	local keys = { "Lofi1", "Lofi2", "Lofi3", "Lofi4", "Lofi5", "Lofi6", "Lofi7", "Lofi8" }
	local fallback = TRACK_ART[keys[((index or 1) - 1) % #keys + 1]]
	return { Icon = "🎵", A = fallback.A, B = fallback.B }
end

-- Son du clic
type ClickOption = { Id: string, Card: TextButton, Stroke: UIStroke, Check: Frame, Name: TextLabel, Hovered: boolean }
local clickOptions: { ClickOption } = {}
local clickSaveToken = 0 -- change à chaque choix (annule les sauvegardes périmées)
local clickSaving = false -- une sauvegarde est en cours (on ne recale pas sur l'état serveur)

----------------------------------------------------------------------
-- Réglages
----------------------------------------------------------------------

-- Majuscules qui gardent les accents (string.upper ne touche pas à "é")
local ACCENTS = { ["é"] = "É", ["è"] = "È", ["ê"] = "Ê", ["ë"] = "Ë", ["à"] = "À", ["â"] = "Â", ["ç"] = "Ç",
	["î"] = "Î", ["ï"] = "Ï", ["ô"] = "Ô", ["ù"] = "Ù", ["û"] = "Û" }
local function upper(text: string): string
	local result = string.upper(text)
	for small, big in pairs(ACCENTS) do
		result = string.gsub(result, small, big)
	end
	return result
end

-- Infos du lecteur (fonction de repli si SoundManager n'a pas GetMusicInfo)
local function getMusicInfo(): { [string]: any }?
	if type(SoundManager.GetMusicInfo) == "function" then
		return SoundManager.GetMusicInfo()
	end
	return nil
end

local function getMusicMode(): string
	if type(SoundManager.GetMusicMode) == "function" then
		return SoundManager.GetMusicMode()
	end
	return "Shuffle"
end

-- Coche / survol de la liste des morceaux
local function paintTracks()
	local mode = getMusicMode()
	local info = getMusicInfo()
	local playingKey = info and info.Playing and info.Key or nil
	for _, row in ipairs(trackRows) do
		local selected = row.Key == mode
		local isPlaying = row.Key ~= "Shuffle" and row.Key == playingKey
		row.Card.BackgroundColor3 = selected and MUSIC_SOFT or (row.Hovered and ROW_HOVER or Theme.Colors.Card)
		row.Stroke.Color = (selected or row.Hovered) and Theme.Colors.Purple or ROW_BORDER
		row.Stroke.Thickness = selected and 2 or 1.5
		row.Stroke.Transparency = (row.Hovered and not selected) and 0.45 or 0
		row.Name.TextColor3 = selected and Theme.Colors.Purple:Lerp(BLACK, 0.25) or Theme.Colors.Text
		if row.Check.Visible ~= selected then
			row.Check.Visible = selected
			if selected then
				UIUtil.Pop(row.Check, 0.3, 0.35)
			end
		end
		local showEq = isPlaying and not selected
		for _, bar in ipairs(row.Eq) do
			bar.Visible = isPlaying
		end
		-- (morceau choisi ET en cours : la coche reste, l'égaliseur passe à côté)
		if row.Eq[1] then
			local holder = row.Eq[1].Parent :: GuiObject
			holder.Position = showEq and UDim2.new(1, -14, 0.5, 0) or UDim2.new(1, -46, 0.5, 0)
		end
	end
end

-- Textes de la musique : morceau en cours, verrou Lofi, playlist vide...
local function refreshMusicInfo()
	local info = getMusicInfo()
	local name = info and info.Name or SoundManager.GetCurrentTrack()
	local playing = SoundManager.IsMusicPlaying()
	local locked = not ClientState.HasFeature("Lofi")
	local text
	local status
	if locked then
		text = Locale.T("🔒 Unlocks with 🎧 %s", Locale.T("Lofi Beats"))
		status = Locale.T("Locked")
	elseif not SoundManager.HasPlaylist() then
		text = RunService:IsStudio() and Locale.T("⚠️ Add music IDs in Config.Music") or Locale.T("No music for now")
		status = Locale.T("Empty playlist")
	elseif not current.Music then
		text = Locale.T("Music off")
		status = Locale.T("Paused")
	elseif playing and name then
		text = "♫ " .. name
		status = Locale.T("♫ Now playing")
	else
		text = Locale.T("Loading...")
		status = Locale.T("Loading")
	end
	local label = musicInfo
	if label then
		label.Text = text
	end
	local ui = player
	if ui then
		ui.Status.Text = upper(status)
		local live = playing and current.Music and not locked
		ui.StatusDot.BackgroundColor3 = live and Color3.fromRGB(90, 240, 150) or (locked and Theme.Colors.Orange or LAVENDER)
		-- Titre : morceau en cours, sinon le choix (ou le message)
		local mode = getMusicMode()
		local title = name
		if not title and mode ~= "Shuffle" and type(SoundManager.GetPlaylist) == "function" then
			for _, track in ipairs(SoundManager.GetPlaylist()) do
				if track.Key == mode then
					title = track.Name
				end
			end
		end
		if locked then
			ui.Title.Text = Locale.T("Unlocks with 🎧 %s", Locale.T("Lofi Beats"))
		else
			ui.Title.Text = title or text
		end
		local count = info and info.Count or 0
		local index = info and info.Index or 0
		local modeText = mode == "Shuffle" and Locale.T("🔀 Shuffle") or Locale.T("🔁 Loop")
		if count > 0 and index > 0 then
			ui.Meta.Text = Locale.T("Track %d of %d", index, count) .. "  •  " .. modeText
		else
			ui.Meta.Text = modeText
		end
		local art = mode == "Shuffle" and not (info and info.Key) and SHUFFLE_ART or artFor(info and info.Key or mode, index)
		ui.VinylGradient.Color = ColorSequence.new(art.A, art.B)
		ui.VinylIcon.Text = locked and "🔒" or art.Icon
		ui.Play.Text = (current.Music and not locked) and "❚❚" or "►"
		local canSkip = not locked and SoundManager.HasPlaylist()
		for _, button in ipairs({ ui.Prev, ui.Next }) do
			button.TextTransparency = canSkip and 0 or 0.6
			button.BackgroundTransparency = canSkip and 0.82 or 0.92
		end
		ui.Play.TextTransparency = locked and 0.5 or 0
		UIUtil.Tween(ui.Arm, 0.5, { Rotation = live and 28 or 8 }, Enum.EasingStyle.Sine)
	end
	local banner = lockBanner
	if banner then
		banner.Visible = locked
	end
	paintTracks()
end

-- Dessine un interrupteur (animé) selon sa valeur
local function paintToggle(ui: Toggle, value: boolean, animate: boolean)
	local duration = animate and 0.22 or 0
	UIUtil.Tween(ui.Knob, duration, {
		Position = value and UDim2.new(1, -3, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
		AnchorPoint = value and Vector2.new(1, 0.5) or Vector2.new(0, 0.5),
	}, Enum.EasingStyle.Back)
	UIUtil.Tween(ui.Button, duration, { BackgroundColor3 = value and ON_COLOR or OFF_COLOR })
	UIUtil.Tween(ui.Stroke, duration, { Color = (value and ON_COLOR or OFF_COLOR):Lerp(BLACK, 0.25) })
	ui.Glyph.Text = value and "✓" or "✕"
	ui.Glyph.TextColor3 = (value and ON_COLOR or OFF_COLOR):Lerp(BLACK, 0.2)
end

-- Applique un réglage localement (son / musique / effets)
function Settings.Apply(key: string, value: boolean)
	current[key] = value
	if key == "Sound" then
		SoundManager.SetSoundEnabled(value)
	elseif key == "Music" then
		SoundManager.SetMusicEnabled(value)
	elseif key == "Effects" then
		Effects.SetEnabled(value)
	elseif key == "DarkMode" then
		ClientState.SetUserDarkMode(value)
	end

	local ui = toggles[key]
	if ui then
		paintToggle(ui, value, true)
	end
	local slider = sliders[key]
	if slider then
		slider.SetEnabled(value)
	end
	if key == "Music" then
		refreshMusicInfo()
	end
end

function Settings.Get(key: string): boolean
	return current[key] ~= false
end

-- Envoie un réglage au serveur (avec quelques essais), sinon on revient en arrière
local function saveSetting(key: string, newValue: boolean)
	task.spawn(function()
		for attempt = 1, 3 do
			if current[key] ~= newValue then
				return -- un clic plus récent a pris le relais
			end
			local ok, success = pcall(function()
				return Net.Function("SetSetting"):InvokeServer(key, newValue)
			end)
			if ok and success == true then
				return
			end
			if attempt < 3 then
				task.wait(0.3)
			end
		end
		if current[key] == newValue then
			Settings.Apply(key, not newValue)
		end
	end)
end

----------------------------------------------------------------------
-- Son du clic
----------------------------------------------------------------------

-- Met en valeur l'option choisie (et celle survolée)
local function paintClickOptions()
	local selected = SoundManager.GetClickSound()
	for _, option in ipairs(clickOptions) do
		local isSelected = option.Id == selected
		option.Card.BackgroundColor3 = isSelected and SELECTED_SOFT or (option.Hovered and ROW_HOVER or Theme.Colors.Card)
		option.Stroke.Color = (isSelected or option.Hovered) and Theme.Colors.Blue or ROW_BORDER
		option.Stroke.Transparency = (option.Hovered and not isSelected) and 0.5 or 0
		option.Stroke.Thickness = isSelected and 2 or 1.5
		option.Name.TextColor3 = isSelected and Theme.Colors.Blue:Lerp(BLACK, 0.3) or Theme.Colors.Text
		if option.Check.Visible ~= isSelected then
			option.Check.Visible = isSelected
			if isSelected then
				UIUtil.Pop(option.Check, 0.3, 0.35)
			end
		end
	end
end

-- Choisit un son de clic : appliqué tout de suite, puis sauvegardé (3 essais)
local function chooseClickSound(id: string)
	local previous = SoundManager.GetClickSound()
	SoundManager.SetClickSound(id)
	SoundManager.PreviewClickSound(id)
	paintClickOptions()
	if previous == SoundManager.GetClickSound() then
		return
	end
	clickSaveToken += 1
	local token = clickSaveToken
	clickSaving = true
	task.spawn(function()
		for attempt = 1, 3 do
			if token ~= clickSaveToken then
				return -- un choix plus récent a pris le relais
			end
			local ok, success = pcall(function()
				return Net.Function("SetSetting"):InvokeServer("ClickSound", id)
			end)
			if ok and success == true then
				if token == clickSaveToken then
					clickSaving = false
				end
				return
			end
			if attempt < 3 then
				task.wait(0.3)
			end
		end
		if token == clickSaveToken then
			clickSaving = false
			-- Refusé : on revient au choix précédent
			SoundManager.SetClickSound(previous)
			paintClickOptions()
		end
	end)
end

local function buildClickOption(grid: Frame, entry, order: number)
	local card = UIUtil.Create("TextButton", {
		Name = tostring(entry.Id),
		BackgroundColor3 = Theme.Colors.Card,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = order,
		Parent = grid,
	})
	UIUtil.Corner(card, Theme.Radius.M)
	local stroke = UIUtil.Stroke(card, ROW_BORDER, 1.5)
	UIUtil.AnimateButton(card, 1.03, 0.96)

	-- Bouton ▶ (écouter sans choisir)
	local play = UIUtil.Create("TextButton", {
		Name = "Preview",
		Size = UDim2.fromOffset(34, 34),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		BackgroundColor3 = WHITE,
		AutoButtonColor = false,
		Font = Theme.Fonts.Title,
		Text = "▶",
		TextColor3 = Theme.Colors.TextLight,
		TextSize = 14,
		ZIndex = 2,
		Parent = card,
	})
	UIUtil.Corner(play, UDim.new(1, 0))
	UIUtil.Gradient(play, ColorSequence.new(Theme.Colors.Blue:Lerp(WHITE, 0.2), Theme.Colors.Blue:Lerp(BLACK, 0.2)), 90)
	UIUtil.AnimateButton(play, 1.12, 0.9)
	local previewToken = 0
	play.Activated:Connect(function()
		SoundManager.PreviewClickSound(entry.Id)
		UIUtil.Pop(play, 1.25, 0.3)
		-- Petite note pendant l'écoute
		previewToken += 1
		local token = previewToken
		play.Text = "♪"
		task.delay(0.45, function()
			if token == previewToken then
				play.Text = "▶"
			end
		end)
	end)

	local isKeyboard = string.find(string.lower(tostring(entry.Id)), "keyboard") ~= nil
	local name = UIUtil.Label({
		Name = "SoundName",
		Text = Locale.T(tostring(entry.Name or entry.Id)),
		Font = Theme.Fonts.Title,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -86, 0, 20),
		Position = UDim2.fromOffset(52, 9),
		MaxTextSize = 16,
		ZIndex = 2,
		Parent = card,
	})
	UIUtil.Label({
		Name = "Kind",
		Text = isKeyboard and Locale.T("⌨️ Keyboard") or Locale.T("🖱️ Click"),
		TextColor3 = Theme.Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -86, 0, 15),
		Position = UDim2.fromOffset(52, 30),
		MaxTextSize = 13,
		ZIndex = 2,
		Parent = card,
	})

	-- Coche "choisi"
	local check = UIUtil.Create("Frame", {
		Name = "Check",
		Size = UDim2.fromOffset(24, 24),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		BackgroundColor3 = Theme.Colors.Blue,
		Visible = false,
		ZIndex = 2,
		Parent = card,
	})
	UIUtil.Corner(check, UDim.new(1, 0))
	UIUtil.Label({
		Text = "✔",
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.TextLight,
		Size = UDim2.new(1, -6, 1, -6),
		Position = UDim2.fromOffset(3, 3),
		MaxTextSize = 14,
		ZIndex = 3,
		Parent = check,
	})

	local option: ClickOption = { Id = entry.Id, Card = card, Stroke = stroke, Check = check, Name = name, Hovered = false }
	card.MouseEnter:Connect(function()
		option.Hovered = true
		paintClickOptions()
	end)
	card.MouseLeave:Connect(function()
		option.Hovered = false
		paintClickOptions()
	end)
	card.Activated:Connect(function()
		chooseClickSound(entry.Id)
	end)
	table.insert(clickOptions, option)
end

----------------------------------------------------------------------
-- Composants
----------------------------------------------------------------------

-- Carte de section (icône colorée, titre, sous-titre). Renvoie la carte :
-- ses lignes s'empilent en dessous (LayoutOrder >= 1).
local function buildSection(content: Instance, order: number, icon: string, title: string, subtitle: string, accent: Color3): Frame
	local card = UIUtil.Create("Frame", {
		Name = "Section" .. order,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = WHITE,
		LayoutOrder = order,
		Parent = content,
	})
	UIUtil.Corner(card, Theme.Radius.L)
	UIUtil.Stroke(card, ROW_BORDER, 1.5)
	-- Léger voile de la couleur de la section en haut de la carte
	UIUtil.Create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, accent:Lerp(WHITE, 0.9)),
			ColorSequenceKeypoint.new(0.3, WHITE),
			ColorSequenceKeypoint.new(1, WHITE),
		}),
		Parent = card,
	})
	UIUtil.Create("UIPadding", {
		PaddingTop = UDim.new(0, 12),
		PaddingBottom = UDim.new(0, 12),
		PaddingLeft = UDim.new(0, 12),
		PaddingRight = UDim.new(0, 12),
		Parent = card,
	})
	UIUtil.Create("UIListLayout", {
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = card,
	})

	local header = UIUtil.Create("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundTransparency = 1,
		LayoutOrder = 0,
		Parent = card,
	})
	local badge = UIUtil.Create("Frame", {
		Name = "Icon",
		Size = UDim2.fromOffset(40, 40),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 2, 0.5, 0),
		BackgroundColor3 = WHITE,
		Parent = header,
	})
	UIUtil.Corner(badge, Theme.Radius.M)
	UIUtil.Stroke(badge, accent:Lerp(BLACK, 0.25), 1.5, 0.35)
	UIUtil.SoftGradient(badge, accent, 90)
	UIUtil.Label({
		Text = icon,
		Size = UDim2.new(1, -12, 1, -12),
		Position = UDim2.fromOffset(6, 6),
		MaxTextSize = 22,
		Parent = badge,
	})
	UIUtil.Label({
		Name = "Title",
		Text = title,
		Font = Theme.Fonts.Title,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -60, 0, 22),
		Position = UDim2.fromOffset(54, 2),
		MaxTextSize = Theme.TextSize.Heading,
		Parent = header,
	})
	UIUtil.Label({
		Name = "Subtitle",
		Text = subtitle,
		TextColor3 = Theme.Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -60, 0, 16),
		Position = UDim2.fromOffset(54, 25),
		MaxTextSize = Theme.TextSize.Caption,
		Parent = header,
	})
	return card
end

-- Fine ligne de séparation dans une section
local function divider(section: Frame, order: number)
	UIUtil.Create("Frame", {
		Name = "Divider",
		Size = UDim2.new(1, -16, 0, 1),
		BackgroundColor3 = ROW_BORDER,
		BorderSizePixel = 0,
		LayoutOrder = order,
		Parent = section,
	})
end

-- Ligne d'une section : pastille d'icône, titre, sous-titre (fond au survol)
local function buildRow(section: Frame, order: number, height: number, icon: string, title: string, accent: Color3): (Frame, TextLabel)
	local row = UIUtil.Create("Frame", {
		Name = "Row" .. order,
		Size = UDim2.new(1, 0, 0, height),
		BackgroundColor3 = ROW_HOVER,
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = section,
	})
	UIUtil.Corner(row, Theme.Radius.M)
	row.MouseEnter:Connect(function()
		UIUtil.Tween(row, 0.15, { BackgroundTransparency = 0 })
	end)
	row.MouseLeave:Connect(function()
		UIUtil.Tween(row, 0.2, { BackgroundTransparency = 1 })
	end)

	local bubble = UIUtil.Create("Frame", {
		Name = "Icon",
		Size = UDim2.fromOffset(36, 36),
		Position = UDim2.fromOffset(8, 12),
		BackgroundColor3 = accent:Lerp(WHITE, 0.85),
		Parent = row,
	})
	UIUtil.Corner(bubble, UDim.new(1, 0))
	UIUtil.Stroke(bubble, accent, 1, 0.6)
	UIUtil.Label({
		Text = icon,
		Size = UDim2.new(1, -10, 1, -10),
		Position = UDim2.fromOffset(5, 5),
		MaxTextSize = 20,
		Parent = bubble,
	})
	UIUtil.Label({
		Name = "Title",
		Text = title,
		Font = Theme.Fonts.Title,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -150, 0, 20),
		Position = UDim2.fromOffset(56, 10),
		MaxTextSize = 17,
		Parent = row,
	})
	local subtitle = UIUtil.Create("TextLabel", {
		Name = "Subtitle",
		Size = UDim2.new(1, -150, 0, 17),
		Position = UDim2.fromOffset(56, 31),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		Text = "",
		TextColor3 = Theme.Colors.TextDim,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = row,
	})
	return row, subtitle
end

-- Interrupteur ON/OFF animé (en haut à droite de la ligne)
local function buildToggle(row: Frame, key: string)
	local button = UIUtil.Create("TextButton", {
		Name = "Toggle",
		Size = UDim2.fromOffset(60, 32),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 14),
		BackgroundColor3 = ON_COLOR,
		AutoButtonColor = false,
		Text = "",
		Parent = row,
	})
	UIUtil.Corner(button, UDim.new(1, 0))
	local stroke = UIUtil.Stroke(button, ON_COLOR:Lerp(BLACK, 0.25), 1.5, 0.2)
	-- Reflet (haut plus clair)
	UIUtil.Create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(WHITE, Color3.fromRGB(215, 215, 215)),
		Parent = button,
	})
	local knob = UIUtil.Create("Frame", {
		Name = "Knob",
		Size = UDim2.fromOffset(26, 26),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -3, 0.5, 0),
		BackgroundColor3 = WHITE,
		ZIndex = 2,
		Parent = button,
	})
	UIUtil.Corner(knob, UDim.new(1, 0))
	UIUtil.Stroke(knob, BLACK, 1, 0.8)
	local glyph = UIUtil.Label({
		Name = "Glyph",
		Text = "✓",
		Font = Theme.Fonts.Title,
		TextColor3 = ON_COLOR,
		Size = UDim2.new(1, -10, 1, -10),
		Position = UDim2.fromOffset(5, 5),
		MaxTextSize = 13,
		ZIndex = 3,
		Parent = knob,
	})
	UIUtil.AnimateButton(button, 1.06, 0.93)
	local ui: Toggle = { Button = button, Knob = knob, Stroke = stroke, Glyph = glyph }
	toggles[key] = ui
	paintToggle(ui, current[key] == true, false)

	local function onActivated()
		local newValue = not current[key]
		Settings.Apply(key, newValue)
		SoundManager.Play("Open", newValue and 1.3 or 0.8)
		saveSetting(key, newValue)
	end
	button.Activated:Connect(onActivated)
	-- Zone tactile plus grande que l'interrupteur (au moins 44 px de haut)
	local hitbox = UIUtil.Create("TextButton", {
		Name = "Hitbox",
		Size = UDim2.new(1, 20, 1, 20),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 4,
		Parent = button,
	})
	hitbox.Activated:Connect(onActivated)
end

-- Icône de volume selon le niveau
local function volumeIcon(value: number): string
	if value <= 0.001 then
		return "🔇"
	elseif value < 0.34 then
		return "🔈"
	elseif value < 0.67 then
		return "🔉"
	end
	return "🔊"
end

-- Curseur de volume 0..100 % (souris + tactile), halo lumineux autour du
-- bouton (survol / glissement). `onChanged(valeur, relâché)`
local function buildSlider(row: Frame, initial: number, color: Color3, onChanged: (value: number, released: boolean) -> ()): Slider
	local value = math.clamp(initial, 0, 1)
	local enabled = true
	local hovering = false

	local icon = UIUtil.Label({
		Name = "VolumeIcon",
		Size = UDim2.fromOffset(24, 24),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 56, 1, -9),
		MaxTextSize = 18,
		Parent = row,
	})

	-- Zone de saisie plus haute que la piste (plus facile au doigt).
	-- Marges : le bouton rond (et son halo) ne touche jamais l'icône ni le "100 %"
	local hit = UIUtil.Create("TextButton", {
		Name = "Slider",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 100, 1, -6),
		Size = UDim2.new(1, -198, 0, 30),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		Parent = row,
	})
	local track = UIUtil.Create("Frame", {
		Name = "Track",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.new(1, 0, 0, 8),
		BackgroundColor3 = Color3.fromRGB(226, 226, 230),
		BorderSizePixel = 0,
		Parent = hit,
	})
	UIUtil.Corner(track, UDim.new(1, 0))
	local fill = UIUtil.Create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(value, 1),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		Parent = track,
	})
	UIUtil.Corner(fill, UDim.new(1, 0))
	local fillGradient = UIUtil.Gradient(fill, ColorSequence.new(color:Lerp(WHITE, 0.35), color), 0)

	-- Halo (derrière le bouton)
	local glow = UIUtil.Create("Frame", {
		Name = "Glow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(value, 0.5),
		Size = UDim2.fromOffset(32, 32),
		BackgroundColor3 = color,
		BackgroundTransparency = 0.88,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = hit,
	})
	UIUtil.Corner(glow, UDim.new(1, 0))
	local knob = UIUtil.Create("Frame", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(value, 0.5),
		Size = UDim2.fromOffset(22, 22),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = hit,
	})
	UIUtil.Corner(knob, UDim.new(1, 0))
	local knobStroke = UIUtil.Stroke(knob, color, 2.5, 0)
	local knobScale = UIUtil.Create("UIScale", { Parent = knob })

	local percent = UIUtil.Create("TextLabel", {
		Name = "Percent",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -12, 1, -9),
		Size = UDim2.fromOffset(60, 24),
		BackgroundColor3 = WHITE,
		Font = Theme.Fonts.Number,
		Text = "",
		TextColor3 = Theme.Colors.Text,
		TextSize = 15,
		Parent = row,
	})
	UIUtil.Corner(percent, UDim.new(1, 0))
	UIUtil.Stroke(percent, ROW_BORDER, 1.5)

	local function render()
		fill.Size = UDim2.fromScale(value, 1)
		knob.Position = UDim2.fromScale(value, 0.5)
		glow.Position = UDim2.fromScale(value, 0.5)
		percent.Text = tostring(math.floor(value * 100 + 0.5)) .. " %"
		icon.Text = enabled and volumeIcon(value) or "🔇"
	end
	render()

	-- Halo : 0 = repos, 1 = survol, 2 = glissement
	local function setGlow(level: number)
		local size = level == 2 and 46 or (level == 1 and 40 or 32)
		local transparency = level == 2 and 0.62 or (level == 1 and 0.74 or 0.88)
		UIUtil.Tween(glow, 0.15, { Size = UDim2.fromOffset(size, size), BackgroundTransparency = transparency })
		UIUtil.Tween(knobScale, 0.15, { Scale = level == 2 and 1.2 or (level == 1 and 1.1 or 1) }, Enum.EasingStyle.Back)
	end

	local dragInput: InputObject? = nil
	local function setFromX(x: number, released: boolean)
		local width = track.AbsoluteSize.X
		if width <= 0 then
			return
		end
		value = math.clamp((x - track.AbsolutePosition.X) / width, 0, 1)
		render()
		onChanged(value, released)
	end

	hit.InputBegan:Connect(function(input: InputObject)
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch then
			dragInput = input
			setGlow(2)
			setFromX(input.Position.X, false)
		end
	end)
	hit.MouseEnter:Connect(function()
		hovering = true
		if not dragInput then
			setGlow(1)
		end
	end)
	hit.MouseLeave:Connect(function()
		hovering = false
		if not dragInput then
			setGlow(0)
		end
	end)
	UserInputService.InputChanged:Connect(function(input: InputObject)
		local dragging = dragInput
		if not dragging then
			return
		end
		local kind = input.UserInputType
		if (kind == Enum.UserInputType.MouseMovement and dragging.UserInputType == Enum.UserInputType.MouseButton1)
			or (kind == Enum.UserInputType.Touch and input == dragging)
		then
			setFromX(input.Position.X, false)
		end
	end)
	UserInputService.InputEnded:Connect(function(input: InputObject)
		local dragging = dragInput
		if not dragging then
			return
		end
		local kind = input.UserInputType
		if (kind == Enum.UserInputType.MouseButton1 and dragging.UserInputType == Enum.UserInputType.MouseButton1)
			or (kind == Enum.UserInputType.Touch and input == dragging)
		then
			dragInput = nil
			setGlow(hovering and 1 or 0)
			onChanged(value, true)
		end
	end)

	local slider: Slider = {
		Set = function(newValue: number)
			value = math.clamp(newValue, 0, 1)
			render()
		end,
		SetEnabled = function(isEnabled: boolean)
			enabled = isEnabled
			local tint = isEnabled and color or Theme.Colors.Disabled
			fillGradient.Color = ColorSequence.new(tint:Lerp(WHITE, 0.35), tint)
			glow.BackgroundColor3 = tint
			knobStroke.Color = tint
			percent.TextTransparency = isEnabled and 0 or 0.5
			knob.BackgroundTransparency = isEnabled and 0 or 0.3
			render()
		end,
	}
	return slider
end

-- Animation du lecteur (vinyle, visualiseur, mini-égaliseurs de la liste) :
-- seulement fenêtre ouverte, 30 images/s max
local function stepPlayer(dt: number)
	animClock += dt
	if animClock < 1 / 30 then
		return
	end
	local step = math.min(animClock, 0.1)
	animClock = 0
	local ui = player
	if not ui then
		return
	end
	local live = SoundManager.IsMusicPlaying() and current.Music and ClientState.HasFeature("Lofi")
	-- Volume réel du morceau (0..1) quand Roblox le donne, sinon une vague douce
	local loudness = 0.55
	local _, sound = SoundManager.GetCurrentTrack()
	if sound then
		local ok, value = pcall(function()
			return (sound :: Sound).PlaybackLoudness
		end)
		if ok and type(value) == "number" and value > 0 then
			loudness = math.clamp(value / 420, 0.15, 1)
		end
	end
	if live then
		vinylAngle = (vinylAngle + step * 100) % 360 -- ~33 tours/min
		ui.Vinyl.Rotation = vinylAngle
	end
	local now = os.clock()
	for index, bar in ipairs(ui.Bars) do
		local target = 0.08
		if live then
			local w1 = math.sin(now * (4.2 + index * 0.37) + index * 1.9) * 0.5 + 0.5
			local w2 = math.sin(now * (1.7 + index * 0.21) + index * 0.6) * 0.5 + 0.5
			local shape = 1 - math.abs(index - BAR_COUNT * 0.4) / BAR_COUNT * 0.9 -- plus haut vers le milieu
			target = math.clamp((w1 * 0.65 + w2 * 0.35) * shape * (0.35 + loudness * 0.9), 0.08, 1)
		end
		local level = barLevels[index] or 0.08
		level += (target - level) * math.min(1, step * (target > level and 18 or 7))
		barLevels[index] = level
		bar.Size = UDim2.new(1 / BAR_COUNT, -3, level, 0)
	end
	-- Mini-égaliseur du morceau en cours dans la liste
	for _, row in ipairs(trackRows) do
		local first = row.Eq[1]
		if first and first.Visible then
			for index, bar in ipairs(row.Eq) do
				local wave = math.sin(now * (6 + index * 1.9) + index) * 0.5 + 0.5
				bar.Size = UDim2.fromOffset(3, live and (4 + math.floor(wave * 12)) or 4)
			end
		end
	end
end

----------------------------------------------------------------------
-- Construction
----------------------------------------------------------------------

local function buildAudio(content: Instance)
	local section = buildSection(content, 2, "🔊", Locale.T("Sounds"), Locale.T("Effects volume and click sound"), SECTION_AUDIO)

	-- Effets sonores : interrupteur + volume
	local soundRow, soundSubtitle = buildRow(section, 1, 96, "🔔", Locale.T("Sound effects"), SECTION_AUDIO)
	soundSubtitle.Text = Locale.T("Clicks, purchases, bonuses...")
	buildToggle(soundRow, "Sound")
	local lastPreview = 0
	sliders.Sound = buildSlider(soundRow, SoundManager.GetEffectsVolume(), Theme.Colors.Blue, function(value, released)
		SoundManager.SetEffectsVolume(value)
		-- Petit son d'essai (pas trop souvent pendant le glissement)
		local now = os.clock()
		if released or now - lastPreview > 0.15 then
			lastPreview = now
			SoundManager.Play("Click", 0.9 + value * 0.4)
		end
	end)

	divider(section, 4)

	-- Son du clic (gros bouton)
	local clickHeader = UIUtil.Create("Frame", {
		Name = "ClickHeader",
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 1,
		LayoutOrder = 5,
		Parent = section,
	})
	UIUtil.Label({
		Text = Locale.T("🖱️ Click sound"),
		Font = Theme.Fonts.Title,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -16, 0, 20),
		Position = UDim2.fromOffset(8, 2),
		MaxTextSize = 17,
		Parent = clickHeader,
	})
	UIUtil.Label({
		Text = Locale.T("▶ to listen, tap the card to choose"),
		TextColor3 = Theme.Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -16, 0, 15),
		Position = UDim2.fromOffset(8, 23),
		MaxTextSize = 13,
		Parent = clickHeader,
	})
	local clickGrid = UIUtil.Create("Frame", {
		Name = "ClickSounds",
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 6,
		Parent = section,
	})
	UIUtil.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 4),
		PaddingRight = UDim.new(0, 4),
		PaddingTop = UDim.new(0, 2),
		PaddingBottom = UDim.new(0, 2),
		Parent = clickGrid,
	})
	UIUtil.Create("UIGridLayout", {
		CellSize = UDim2.new(1 / 3, -7, 0, 54),
		CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = clickGrid,
	})
	for index, entry in ipairs(Config.ClickSounds or {}) do
		if type(entry) == "table" and type(entry.Id) == "string" then
			buildClickOption(clickGrid, entry, index)
		end
	end
	paintClickOptions()
	SoundManager.ClickSoundChanged:Connect(paintClickOptions)
end

local function buildDisplay(content: Instance)
	local section = buildSection(content, 3, "🖥️", Locale.T("Display"), Locale.T("What moves on screen"), SECTION_DISPLAY)
	local fxRow, fxSubtitle = buildRow(section, 1, 60, "✨", Locale.T("Particles and confetti"), SECTION_DISPLAY)
	fxSubtitle.Text = Locale.T("Turn off for a calmer screen")
	buildToggle(fxRow, "Effects")

	divider(section, 2)

	-- Mode sombre (appliqué tout de suite, sauvegardé avec la progression)
	local darkRow, darkSubtitle = buildRow(section, 3, 60, "🌙", Locale.T("Dark mode"), Theme.Colors.Dark)
	darkSubtitle.Text = Locale.T("Easier on the eyes at night")
	current.DarkMode = ClientState.IsUserDarkMode()
	buildToggle(darkRow, "DarkMode")
end

-- Sauvegarde de la langue (3 essais) ; la langue change au prochain passage
local function chooseLanguage(value: string)
	if table.find(LANGUAGE_OPTIONS, value) == nil then
		return
	end
	languageChosen = value
	languageSaveToken += 1
	local token = languageSaveToken
	languageSaving = true
	SoundManager.Play("Open", 1.1)
	-- Message dans la langue choisie (Auto : langue Roblox du joueur)
	local player = game:GetService("Players").LocalPlayer
	local target = Locale.Resolve(value, player and player.LocaleId or nil)
	if target == Locale.GetLanguage() then
		Notifications.Toast(Locale.TFor(target, "Language saved"), Theme.Colors.Blue, 3.5, nil, false, "🌐")
	else
		Notifications.Toast(Locale.TFor(target, "Language will change after rejoining"), Theme.Colors.Blue, 5, nil, false, "🌐")
	end
	task.spawn(function()
		for attempt = 1, 3 do
			if token ~= languageSaveToken then
				return
			end
			local ok, success = pcall(function()
				return Net.Function("SetSetting"):InvokeServer("Language", value)
			end)
			if ok and success == true then
				if token == languageSaveToken then
					languageSaving = false
				end
				return
			end
			if attempt < 3 then
				task.wait(0.3)
			end
		end
		if token == languageSaveToken then
			languageSaving = false
			languageChosen = nil
			Notifications.Toast(Locale.T("Couldn't save the language, try again."), Theme.Colors.Red)
			local tabs = languageTabs
			if tabs then
				tabs.Select(ClientState.GetLanguageSetting(), true)
			end
		end
	end)
end

local function buildLanguage(content: Instance)
	local section = buildSection(content, 4, "🌐", Locale.T("Language"), Locale.T("Applied the next time you join"), Theme.Colors.Cyan)
	local holder = UIUtil.Create("Frame", {
		Name = "LanguageRow",
		Size = UDim2.new(1, 0, 0, 52),
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = section,
	})
	languageTabs = UIUtil.Tabs({
		Parent = holder,
		Tabs = {
			{ Id = "Auto", Text = Locale.T("🌐 Auto") },
			{ Id = "en", Text = "🇬🇧 English" },
			{ Id = "fr", Text = "🇫🇷 Français" },
		},
		Color = Theme.Colors.Cyan,
		Size = UDim2.new(1, -8, 0, Theme.TouchTarget),
		Position = UDim2.fromOffset(4, 4),
		TextSize = 16,
		Selected = ClientState.GetLanguageSetting(),
		OnSelect = chooseLanguage,
	})
end

----------------------------------------------------------------------
-- 🎧 Lecteur de musique (v8)

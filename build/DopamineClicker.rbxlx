-- "Prince de Pixelie" -> "prince.de.pixelie"
local ACCENTS = {
	{ "[éèêë]", "e" },
	{ "[àâä]", "a" },
	{ "[ôö]", "o" },
	{ "[ùûü]", "u" },
	{ "[îï]", "i" },
	{ "ç", "c" },
	{ "É", "e" },
}
local function slug(text: string): string
	local result = string.lower(text)
	for _, pair in ipairs(ACCENTS) do
		-- Les accents UTF-8 font 2 octets : on remplace mot à mot
		local chars = pair[1]
		if string.sub(chars, 1, 1) == "[" then
			local inner = string.sub(chars, 2, -2)
			for _, code in utf8.codes(inner) do
				result = string.gsub(result, utf8.char(code), pair[2])
			end
		else
			result = string.gsub(result, chars, pair[2])
		end
	end
	result = string.gsub(result, "[^%a%d]+", ".")
	result = string.gsub(result, "^%.+", "")
	result = string.gsub(result, "%.+$", "")
	return result
end

local function pick(list: { any }, variant: any): any
	local v = math.floor(tonumber(variant) or 1)
	return list[(v - 1) % #list + 1]
end

-- Transforme une entrée compacte en mail complet
local function buildEmail(entry): { [string]: any }
	local style = TAGS[entry[1]] or TAGS.PERSO
	local tag = { Text = Locale.T(style.Text), Color = style.Color }
	local sender = entry[3]
	return {
		Tag = tag,
		Avatar = entry[2],
		Sender = sender,
		Address = slug(sender) .. Locale.T("@dopamail.com"),
		Subject = entry[4],
		Body = entry[5],
		Signature = entry[6] or sender,
		Attachment = entry[7],
	}
end

function Email.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local container: Frame = ctx.Container
	local random = Random.new()

	local white = Color3.new(1, 1, 1)
	local paper = Color3.fromRGB(255, 252, 244)
	local ink = Color3.fromRGB(28, 32, 44)
	local inkDim = Color3.fromRGB(110, 116, 132)
	local blue = Color3.fromRGB(40, 120, 240)
	local border = Color3.fromRGB(30, 34, 48)

	local envelopes: { [string]: any } = {}
	local envelopeCount = 0
	local missed = 0
	local positions: { [string]: UDim2 } = {}
	local lastPosition = UDim2.fromScale(0.5, 0.45)
	local popup: any = nil -- fenêtre de mail ouverte

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	local function frame(props: { [string]: any }): Frame
		props.BorderSizePixel = 0
		if props.BackgroundTransparency == nil and props.BackgroundColor3 == nil then
			props.BackgroundTransparency = 1
		end
		return UIUtil.Create("Frame", props)
	end

	local function text(props: { [string]: any }): TextLabel
		props.BackgroundTransparency = props.BackgroundTransparency or 1
		props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
		props.Font = props.Font or Theme.Fonts.Body
		props.TextColor3 = props.TextColor3 or ink
		return UIUtil.Create("TextLabel", props)
	end

	-- Avatar rond : dégradé de la couleur de l'étiquette + emoji
	local function avatar(parent: Instance, email, size: number, position: UDim2, zIndex: number): Frame
		local color = email.Tag.Color
		local circle = frame({
			Size = UDim2.fromOffset(size, size),
			Position = position,
			BackgroundColor3 = white,
			ZIndex = zIndex,
			Parent = parent,
		})
		UIUtil.Corner(circle, UDim.new(1, 0))
		UIUtil.Gradient(circle, ColorSequence.new(color:Lerp(white, 0.7), color:Lerp(white, 0.35)), 135)
		UIUtil.Stroke(circle, color, 1.5, 0.2)
		UIUtil.Label({
			Text = email.Avatar,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.52),
			Size = UDim2.fromScale(0.68, 0.68),
			MaxTextSize = math.floor(size * 0.6),
			ZIndex = zIndex + 1,
			Parent = circle,
		})
		return circle
	end

	-- Étiquette de priorité (largeur automatique)
	local function tagChip(parent: Instance, email, height: number, zIndex: number): Frame
		local tag = email.Tag
		local chip = frame({
			Size = UDim2.fromOffset(0, height),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = tag.Color,
			ZIndex = zIndex,
			Parent = parent,
		})
		UIUtil.Corner(chip, UDim.new(1, 0))
		UIUtil.Create("UIPadding", {
			PaddingLeft = UDim.new(0, 6),
			PaddingRight = UDim.new(0, 6),
			Parent = chip,
		})
		text({
			Name = "Label",
			Size = UDim2.fromScale(0, 1),
			AutomaticSize = Enum.AutomaticSize.X,
			Font = Theme.Fonts.Title,
			Text = tag.Text,
			TextColor3 = white,
			TextSize = math.floor(height * 0.62),
			ZIndex = zIndex + 1,
			Parent = chip,
		})
		return chip
	end

	------------------------------------------------------------------
	-- Compteur "📬 non lus" (dans le bandeau d'actu, à gauche du bloc
	-- horloge : hors de toute carte, il ne cache pas la bourse)
	------------------------------------------------------------------
	local counter = frame({
		Name = "Unread",
		Size = UDim2.fromOffset(0, 22),
		AutomaticSize = Enum.AutomaticSize.X,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -112, 0, 4),
		BackgroundColor3 = white,
		Visible = false,
		ZIndex = 40,
		Parent = container,
	})
	UIUtil.Corner(counter, UDim.new(1, 0))
	UIUtil.Stroke(counter, border, 1.5, 0.15)
	UIUtil.Gradient(counter, ColorSequence.new(white, Color3.fromRGB(226, 232, 244)), 90)
	UIUtil.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 4),
		PaddingRight = UDim.new(0, 9),
		Parent = counter,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 5),
		Parent = counter,
	})
	local counterBadge = text({
		Size = UDim2.fromOffset(0, 16),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = blue,
		BackgroundTransparency = 0,
		Font = Theme.Fonts.Number,
		Text = "0",
		TextColor3 = white,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 1,
		ZIndex = 41,
		Parent = counter,
	})
	UIUtil.Corner(counterBadge, UDim.new(1, 0))
	UIUtil.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 5),
		PaddingRight = UDim.new(0, 5),
		Parent = counterBadge,
	})
	local counterLabel = text({
		Size = UDim2.fromOffset(0, 18),
		AutomaticSize = Enum.AutomaticSize.X,
		Font = Theme.Fonts.Title,
		Text = "📬 " .. Locale.Pick(UNREAD).Many,
		TextSize = 13,
		LayoutOrder = 2,
		ZIndex = 41,
		Parent = counter,
	})
	local counterScale = UIUtil.Create("UIScale", { Parent = counter })

	local function refreshCounter()
		local unread = envelopeCount + missed
		counter.Visible = unread > 0
		local suffix = ""
		if unread >= 50 then
			suffix = " 😱"
		elseif unread >= 10 then
			suffix = " 😬"
		end
		counterBadge.Text = unread > 999 and "999+" or tostring(unread)
		counterBadge.BackgroundColor3 = unread >= 10 and Color3.fromRGB(226, 38, 52) or blue
		counterLabel.Text = "📬 " .. (unread > 1 and Locale.Pick(UNREAD).Many or Locale.Pick(UNREAD).One) .. suffix
		counterScale.Scale = 1.25
		UIUtil.Tween(counterScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	end

	------------------------------------------------------------------
	-- Fenêtre de mail
	------------------------------------------------------------------
	local function closePopup(target, trashed: boolean?)
		local current = target or popup
		if not current or current.Closed then
			return
		end
		current.Closed = true
		if popup == current then
			popup = nil
		end
		if trashed then
			-- Direction la corbeille : rétrécit en tournant vers le bas
			UIUtil.Tween(current.Root, 0.3, {
				Position = current.Root.Position + UDim2.fromOffset(60, 120),
				Rotation = 25,
			}, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			UIUtil.Tween(current.Scale, 0.3, { Scale = 0.2 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		else
			UIUtil.Tween(current.Scale, 0.2, { Scale = 0.6 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		end
		UIUtil.Tween(current.Group, 0.25, { GroupTransparency = 1 })
		UIUtil.Tween(current.Outline, 0.25, { Transparency = 1 })
		UIUtil.Tween(current.Shadow, 0.25, { BackgroundTransparency = 1 })
		Debris:AddItem(current.Root, 0.35)
	end

	local function makeButton(parent: Instance, label: string, filled: boolean, textColor: Color3, x: number, width: number): TextButton
		local button = UIUtil.Create("TextButton", {
			Size = UDim2.fromOffset(width, 28),
			Position = UDim2.new(0, x, 1, -38),
			BackgroundColor3 = filled and blue or white,
			AutoButtonColor = false,
			Font = Theme.Fonts.Title,
			Text = label,
			TextColor3 = textColor,
			TextSize = 14,
			ZIndex = 66,
			Parent = parent,
		})
		UIUtil.Corner(button, 9)
		UIUtil.Stroke(button, filled and Color3.fromRGB(20, 80, 180) or Color3.fromRGB(200, 206, 220), 1.2, 0)
		UIUtil.Gradient(button, ColorSequence.new(white, Color3.fromRGB(222, 226, 236)), 90)
		UIUtil.AnimateButton(button, 1.05, 0.93)
		return button
	end

	local function openPopup(email, sx: number, sy: number, from: UDim2)
		closePopup(nil)
		local ax = math.clamp(sx, 0.02, 0.98)
		local ay = math.clamp(sy, 0.06, 0.94)

		-- AnchorPoint = position : la fenêtre reste toujours dans l'écran.
		-- Racine = TextButton vide : elle absorbe les clics sur la fenêtre
		-- (sinon ils traversent jusqu'au bouton principal / aux cartes).
		local root = UIUtil.Create("TextButton", {
			Name = "MailWindow",
			Size = UDim2.fromOffset(POPUP_W, POPUP_H),
			AnchorPoint = Vector2.new(ax, ay),
			Position = from,
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			ZIndex = 60,
			Parent = container,
		})
		local scale = UIUtil.Create("UIScale", { Scale = 0.35, Parent = root })
		local shadow = frame({
			Size = UDim2.new(1, 8, 1, 8),
			Position = UDim2.fromOffset(-4, 4),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.8,
			ZIndex = 60,
			Parent = root,
		})
		UIUtil.Corner(shadow, 18)

		local group = UIUtil.Create("CanvasGroup", {
			Name = "Window",
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = white,
			BorderSizePixel = 0,
			GroupTransparency = 1,
			ZIndex = 61,
			Parent = root,
		})
		UIUtil.Corner(group, 14)

		-- Barre de titre (pastilles de fenêtre + nom de l'appli)
		local titleBar = frame({
			Size = UDim2.new(1, 0, 0, 30),
			BackgroundColor3 = white,
			ZIndex = 62,
			Parent = group,
		})
		UIUtil.Gradient(titleBar, ColorSequence.new(Color3.fromRGB(44, 60, 104), Color3.fromRGB(26, 36, 66)), 90)
		for index, color in ipairs({ Color3.fromRGB(255, 95, 86), Color3.fromRGB(255, 189, 46), Color3.fromRGB(39, 201, 63) }) do
			local light = frame({
				Size = UDim2.fromOffset(10, 10),
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 10 + (index - 1) * 15, 0.5, 0),
				BackgroundColor3 = color,
				ZIndex = 63,
				Parent = titleBar,
			})
			UIUtil.Corner(light, UDim.new(1, 0))
		end
		text({
			Size = UDim2.new(1, -110, 1, 0),
			Position = UDim2.fromOffset(60, 0),
			Font = Theme.Fonts.Title,
			Text = Locale.T("📥 Dopamail — Inbox"),
			TextColor3 = white,
			TextSize = 13,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 63,
			Parent = titleBar,
		})
		local closeButton = UIUtil.Create("TextButton", {
			Size = UDim2.fromOffset(24, 24),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -4, 0.5, 0),
			BackgroundColor3 = white,
			BackgroundTransparency = 0.85,
			AutoButtonColor = true,
			Font = Theme.Fonts.Title,
			Text = "✕",
			TextColor3 = white,
			TextSize = 14,
			ZIndex = 64,
			Parent = titleBar,
		})
		UIUtil.Corner(closeButton, UDim.new(1, 0))

		-- Objet + étiquette
		text({
			Size = UDim2.new(1, -24, 0, 20),
			Position = UDim2.fromOffset(12, 36),
			Font = Theme.Fonts.Title,
			Text = email.Subject,
			TextSize = 16,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 62,
			Parent = group,
		})

		-- Expéditeur
		avatar(group, email, 34, UDim2.fromOffset(12, 60), 62)
		text({
			Size = UDim2.new(1, -150, 0, 16),
			Position = UDim2.fromOffset(54, 60),
			Font = Theme.Fonts.Title,
			Text = email.Sender,
			TextSize = 14,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 62,
			Parent = group,
		})
		text({
			Size = UDim2.new(1, -66, 0, 14),
			Position = UDim2.fromOffset(54, 77),
			Text = Locale.T("<%s> · to me · just now", email.Address),
			TextColor3 = inkDim,
			TextSize = 11,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 62,
			Parent = group,
		})
		local chip = tagChip(group, email, 18, 63)
		chip.AnchorPoint = Vector2.new(1, 0)
		chip.Position = UDim2.new(1, -12, 0, 60)

		frame({
			Size = UDim2.new(1, -24, 0, 1),
			Position = UDim2.fromOffset(12, 99),
			BackgroundColor3 = Color3.fromRGB(226, 230, 238),
			ZIndex = 62,
			Parent = group,
		})

		-- Corps + signature (+ pièce jointe)
		local hasAttachment = type(email.Attachment) == "string"
		text({
			Size = UDim2.new(1, -24, 0, hasAttachment and 58 or 72),
			Position = UDim2.fromOffset(12, 106),
			Text = email.Body,
			TextSize = 13,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			ZIndex = 62,
			Parent = group,
		})
		local signature = text({
			Size = UDim2.new(1, -24, 0, 14),
			Position = UDim2.fromOffset(12, hasAttachment and 166 or 180),
			Text = "— " .. email.Signature,
			TextColor3 = inkDim,
			TextSize = 12,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 62,
			Parent = group,
		})
		signature.FontFace = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Medium, Enum.FontStyle.Italic)
		if hasAttachment then
			local attachment = text({
				Size = UDim2.fromOffset(0, 20),
				AutomaticSize = Enum.AutomaticSize.X,
				Position = UDim2.fromOffset(12, 186),
				BackgroundColor3 = Color3.fromRGB(240, 243, 250),
				BackgroundTransparency = 0,
				Font = Theme.Fonts.Title,
				Text = email.Attachment,
				TextColor3 = Color3.fromRGB(60, 70, 100),
				TextSize = 11,
				ZIndex = 62,
				Parent = group,
			})
			UIUtil.Corner(attachment, 6)
			UIUtil.Create("UIPadding", {
				PaddingLeft = UDim.new(0, 7),
				PaddingRight = UDim.new(0, 7),
				Parent = attachment,
			})
		end

		-- Boutons
		local buttonW = math.floor((POPUP_W - 24 - 12) / 3)
		local replyButton = makeButton(group, Locale.T("↩️ Reply"), true, white, 12, buttonW)
		local forwardButton = makeButton(group, Locale.T("➡️ Forward"), false, ink, 12 + buttonW + 6, buttonW)
		local deleteButton = makeButton(group, Locale.T("🗑️ Delete"), false, Color3.fromRGB(210, 40, 50), 12 + (buttonW + 6) * 2, buttonW)

		-- Contour (hors du CanvasGroup)
		local outline = frame({
			Size = UDim2.fromScale(1, 1),
			ZIndex = 67,
			Parent = root,
		})
		UIUtil.Corner(outline, 14)
		local outlineStroke = UIUtil.Stroke(outline, border, 1.5, 1)

		local current = {
			Root = root,
			Scale = scale,
			Group = group,
			Shadow = shadow,
			Outline = outlineStroke,
			Closed = false,
		}
		popup = current

		-- Ouverture : la fenêtre "sort" de l'enveloppe et s'agrandit
		UIUtil.Tween(root, 0.4, { Position = UDim2.fromScale(ax, ay) }, Enum.EasingStyle.Quint)
		UIUtil.Tween(scale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
		UIUtil.Tween(group, 0.25, { GroupTransparency = 0 })
		UIUtil.Tween(outlineStroke, 0.25, { Transparency = 0.1 })

		local function close()
			closePopup(current)
		end

		ctx.Connect(closeButton.Activated, close)
		ctx.Connect(deleteButton.Activated, function()
			if current.Closed then
				return
			end
			ctx.Sound.Play("Click", 0.8)
			closePopup(current, true)
		end)
		ctx.Connect(replyButton.Activated, function()
			if current.Closed then
				return
			end
			ctx.Sound.Play("Mail", 1.3)
			local replies = Locale.Pick(REPLIES)
			ctx.FloatText(container, UDim2.fromScale(ax, ay), replies[random:NextInteger(1, #replies)], blue, 30)
			close()
		end)
		ctx.Connect(forwardButton.Activated, function()
			if current.Closed then
				return
			end
			ctx.Sound.Play("Mail", 1.15)
			local forwards = Locale.Pick(FORWARDS)
			ctx.FloatText(container, UDim2.fromScale(ax, ay), forwards[random:NextInteger(1, #forwards)], Color3.fromRGB(140, 60, 220), 28)
			close()
		end)
		task.delay(POPUP_AUTO_CLOSE, function()
			if ctx.IsAlive() then
				close()
			end
		end)
	end

	------------------------------------------------------------------
	-- Cartes-enveloppes volantes
	------------------------------------------------------------------
	local function line(parent: Instance, a: Vector2, b: Vector2, thickness: number, color: Color3, zIndex: number, transparency: number?): Frame
		local delta = b - a
		local middle = (a + b) / 2
		return frame({
			Size = UDim2.fromOffset(delta.Magnitude + thickness * 0.5, thickness),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(middle.X, middle.Y),
			Rotation = math.deg(math.atan2(delta.Y, delta.X)),
			BackgroundColor3 = color,
			BackgroundTransparency = transparency or 0,
			ZIndex = zIndex,
			Parent = parent,
		})
	end

	local function fadeOut(root: Instance, duration: number)
		for _, item in ipairs(root:GetDescendants()) do
			if item:IsA("TextLabel") then
				UIUtil.Tween(item, duration, { TextTransparency = 1, BackgroundTransparency = 1 })
			elseif item:IsA("Frame") then
				UIUtil.Tween(item, duration, { BackgroundTransparency = 1 })
			elseif item:IsA("UIStroke") then
				UIUtil.Tween(item, duration, { Transparency = 1 })
			end
		end
	end

	local function removeEnvelope(envelope, opened: boolean)
		if envelope.Done then
			return
		end
		envelope.Done = true
		envelopes[envelope.Id] = nil
		envelopeCount -= 1
		local root = envelope.Root
		if opened then
			-- La lettre sort de l'enveloppe, puis la carte s'efface
			UIUtil.Tween(envelope.Letter, 0.2, { Position = UDim2.new(0.5, 0, 0, -26) }, Enum.EasingStyle.Back)
			task.delay(0.12, function()
				if root.Parent then
					UIUtil.Tween(envelope.Scale, 0.25, { Scale = 1.15 }, Enum.EasingStyle.Quad)
					fadeOut(root, 0.22)
				end
			end)
		else
			-- Ignorée : elle s'envole vers le haut à gauche
			missed += 1
			UIUtil.Tween(root, 0.8, {
				Position = root.Position + UDim2.new(-0.25, 0, -0.35, 0),
				Rotation = -40,
			}, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			UIUtil.Tween(envelope.Scale, 0.8, { Scale = 0.3 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end
		refreshCounter()
		Debris:AddItem(root, opened and 0.45 or 0.85)
	end

	local function spawnEmail(info)
		if not ctx.IsAlive() or type(info) ~= "table" or type(info.Id) ~= "string" then
			return
		end
		if envelopes[info.Id] or envelopeCount >= MAX_ENVELOPES then
			return
		end
		local email = buildEmail(pick(Locale.Pick(EMAILS), info.Variant))
		local x = math.clamp(tonumber(info.X) or 0.5, 0.1, 0.9)
		local y = math.clamp(tonumber(info.Y) or 0.5, 0.12, 0.88)
		local lifetime = math.max(2, tonumber(info.Lifetime) or 15)
		local target = UDim2.fromScale(x, y)
		local tagColor = email.Tag.Color

		local root = UIUtil.Create("TextButton", {
			Name = "Envelope",
			Size = UDim2.fromOffset(CARD_W, CARD_H),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(1.15, math.max(0.05, y - 0.2)),
			Rotation = 20,
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Text = "",
			ZIndex = 30,
			Parent = container,
		})
		local scale = UIUtil.Create("UIScale", { Scale = 0.6, Parent = root })

		-- Lettre (derrière la carte, elle en sort à l'ouverture)
		local letter = frame({
			Name = "Letter",
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 6),
			Size = UDim2.new(1, -30, 0, 50),
			BackgroundColor3 = white,
			ZIndex = 30,
			Parent = root,
		})
		UIUtil.Corner(letter, 4)
		UIUtil.Stroke(letter, Color3.fromRGB(210, 214, 226), 1, 0)

		-- Ombre douce
		local shadow = frame({
			Size = UDim2.new(1, 4, 1, 4),
			Position = UDim2.fromOffset(-2, 4),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.82,
			ZIndex = 29,
			Parent = root,
		})
		UIUtil.Corner(shadow, 14)

		-- Carte (papier d'enveloppe)
		local body = frame({
			Name = "Body",
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = paper,
			ZIndex = 31,
			Parent = root,
		})
		UIUtil.Corner(body, 12)
		UIUtil.Gradient(body, ColorSequence.new(white, Color3.fromRGB(236, 232, 222)), 90)
		local bodyStroke = UIUtil.Stroke(body, border, 1.5, 0.15)
		-- Liseré coloré à gauche (couleur de l'étiquette)
		local accent = frame({
			Size = UDim2.new(0, 4, 1, -20),
			Position = UDim2.fromOffset(0, 10),
			BackgroundColor3 = tagColor,
			ZIndex = 32,
			Parent = body,
		})
		UIUtil.Corner(accent, 2)

		-- Rabat en V (discret)
		local tip = Vector2.new(CARD_W / 2, 13)
		line(body, Vector2.new(8, 2), tip, 1.5, Color3.fromRGB(200, 190, 170), 32, 0.2)
		line(body, Vector2.new(CARD_W - 8, 2), tip, 1.5, Color3.fromRGB(200, 190, 170), 32, 0.2)

		-- Timbre (dépasse en haut à droite)
		local stamp = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, -14, 0, 6),
			Size = UDim2.fromOffset(22, 26),
			Rotation = 8,
			BackgroundColor3 = white,
			ZIndex = 36,
			Parent = body,
		})
		UIUtil.Stroke(stamp, Color3.fromRGB(190, 190, 200), 1, 0)
		local stampInner = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(1, -5, 1, -5),
			BackgroundColor3 = tagColor:Lerp(white, 0.55),
			ZIndex = 37,
			Parent = stamp,
		})
		UIUtil.Label({
			Text = email.Avatar,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.85, 0.85),
			MaxTextSize = 13,
			ZIndex = 38,
			Parent = stampInner,
		})

		-- Avatar + pastille "non lu"
		avatar(body, email, 40, UDim2.fromOffset(12, 18), 33)
		local dot = frame({
			Name = "UnreadDot",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(15, 21),
			Size = UDim2.fromOffset(12, 12),
			BackgroundColor3 = blue,
			ZIndex = 36,
			Parent = body,
		})
		UIUtil.Corner(dot, UDim.new(1, 0))
		UIUtil.Stroke(dot, white, 2, 0)

		-- Textes
		text({
			Size = UDim2.new(1, -150, 0, 16),
			Position = UDim2.fromOffset(60, 14),
			Font = Theme.Fonts.Title,
			Text = email.Sender,
			TextSize = 14,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 33,
			Parent = body,
		})
		text({
			Size = UDim2.new(1, -72, 0, 15),
			Position = UDim2.fromOffset(60, 31),
			Font = Theme.Fonts.Title,
			Text = email.Subject,
			TextColor3 = Color3.fromRGB(50, 56, 72),
			TextSize = 12,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 33,
			Parent = body,
		})
		text({
			Size = UDim2.new(1, -72, 0, 14),
			Position = UDim2.fromOffset(60, 47),
			Text = email.Body,
			TextColor3 = inkDim,
			TextSize = 11,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 33,
			Parent = body,
		})
		local chip = tagChip(body, email, 15, 34)
		chip.AnchorPoint = Vector2.new(1, 0)
		chip.Position = UDim2.new(1, -30, 0, 14)

		-- Barre de temps restant (en bas)
		local lifeBar = frame({
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 60, 1, -6),
			Size = UDim2.new(1, -72, 0, 3),
			BackgroundColor3 = tagColor,
			ZIndex = 33,
			Parent = body,
		})
		UIUtil.Corner(lifeBar, UDim.new(1, 0))

		local envelope = {
			Id = info.Id,
			Email = email,
			Root = root,
			Scale = scale,
			Body = body,
			BodyStroke = bodyStroke,
			Letter = letter,
			Dot = dot,
			Chip = chip,
			LifeBar = lifeBar,
			Target = target,
			X = x,
			Y = y,
			Born = os.clock(),
			Lifetime = lifetime,
			Phase = random:NextNumber(0, math.pi * 2),
			Hurry = false,
			Done = false,
		}
		envelopes[info.Id] = envelope
		envelopeCount += 1
		refreshCounter()

		-- Arrivée en vol plané
		UIUtil.Tween(root, 0.75, { Position = target, Rotation = 0 }, Enum.EasingStyle.Back)
		UIUtil.Tween(scale, 0.75, { Scale = 1 }, Enum.EasingStyle.Back)
		ctx.Sound.Play("Mail", 1 + random:NextNumber() * 0.15)

		-- Survol : la carte se soulève un peu
		ctx.Connect(root.MouseEnter, function()
			if not envelope.Done and os.clock() - envelope.Born > 0.8 then
				UIUtil.Tween(scale, 0.15, { Scale = 1.05 }, Enum.EasingStyle.Back)
				bodyStroke.Color = blue
			end
		end)
		ctx.Connect(root.MouseLeave, function()
			if not envelope.Done then
				UIUtil.Tween(scale, 0.15, { Scale = 1 })
				bodyStroke.Color = border
			end
		end)

		-- Clic : on ouvre le mail
		ctx.Connect(root.Activated, function()
			if envelope.Done or not ctx.IsAlive() then
				return
			end
			local position = root.Position
			positions[envelope.Id] = position
			lastPosition = position
			ctx.ClaimSpawn(envelope.Id)
			ctx.Sound.Play("Mail", 1.4)
			if effectsOn() then
				ctx.Effects.Burst(container, position, blue, 10)
				ctx.Effects.Burst(container, position, nil, 6)
			end
			removeEnvelope(envelope, true)
			local mail = envelope.Email
			task.delay(0.14, function()
				if ctx.IsAlive() then
					openPopup(mail, envelope.X, envelope.Y, position)
				end
			end)
			local id = envelope.Id
			task.delay(6, function()
				positions[id] = nil
			end)
		end)
	end

	-- Animation de toutes les cartes (une seule connexion)
	ctx.OnRender(function()
		if envelopeCount <= 0 then
			return
		end
		local now = os.clock()
		for _, envelope in pairs(envelopes) do
			local age = now - envelope.Born
			local left = envelope.Lifetime - age
			if left <= 0 then
				removeEnvelope(envelope, false)
			else
				local t = now + envelope.Phase
				envelope.LifeBar.Size = UDim2.new(math.clamp(left / envelope.Lifetime, 0, 1), -72, 0, 3)
				if left < HURRY_TIME then
					-- Pressée : elle s'agite, étiquette "Vite !" rouge
					if not envelope.Hurry then
						envelope.Hurry = true
						local label = envelope.Chip:FindFirstChild("Label")
						if label and label:IsA("TextLabel") then
							label.Text = Locale.T("⏰ QUICK, READ ME!")
						end
						envelope.Chip.BackgroundColor3 = Color3.fromRGB(226, 38, 52)
						envelope.LifeBar.BackgroundColor3 = Color3.fromRGB(226, 38, 52)
					end
					envelope.Body.Rotation = math.sin(t * 24) * 4
					local pulse = 12 + math.abs(math.sin(t * 10)) * 4
					envelope.Dot.Size = UDim2.fromOffset(pulse, pulse)
				else
					envelope.Body.Rotation = math.sin(t * 2.5) * 1.5
				end
				-- Flotte doucement une fois arrivée
				if age > 0.8 then
					envelope.Root.Position = envelope.Target + UDim2.fromOffset(0, math.sin(t * 2.2) * 4)
				end
			end
		end
	end)

	ctx.OnSpawn("Email", spawnEmail)

	-- Bonus confirmé : "+X" à côté du mail
	ctx.OnBonus("Email", function(payload)
		if not ctx.IsAlive() then
			return
		end
		local position = (payload.SpawnId and positions[payload.SpawnId]) or lastPosition
		ctx.FloatText(container, position, "+" .. ctx.Format.Format(tonumber(payload.Amount) or 0), blue, 40)
	end)
end

function Email.Stop(_ctx)
	-- Cartes, fenêtre et compteur vivent dans ctx.Container
	-- (détruit par le StimulusManager)
end

return Email
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">EmojiRain</string>
            <string name="Source"><![CDATA[--[[
	EmojiRain (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > EmojiRain

	Une pluie d'emojis variée et vivante, en décor derrière tout le reste :
	  - des thèmes qui changent toutes les ~25 s en fondu (fête, amour,
	    miam, espace, animaux, hype, nature, jackpot) ;
	  - plusieurs façons de tomber : balancement, toupie, feuille qui
	    virevolte, rebond sur le bas de l'écran puis disparition ;
	  - de la profondeur : petits emojis pâles et lents au loin, gros et
	    nets devant ;
	  - de temps en temps un emoji "héros" géant avec un halo, et une
	    explosion d'emojis (un gros qui gonfle puis éclate en morceaux).
	Uniquement des TextLabels non cliquables (Active = false) : on ne bloque
	jamais les boutons en dessous. Étiquettes recyclées (35 au maximum),
	beaucoup moins d'emojis si le réglage "Effets" est coupé.
]]

local EmojiRain = {}
EmojiRain.Slot = "Overlay"

local POOL_SIZE = 34 -- + 1 halo = 35 étiquettes au total
local MAX_ACTIVE = 26
local MAX_ACTIVE_LOW = 9 -- réglage "Effets" désactivé
local SPAWN_INTERVAL = 0.28
local SPAWN_INTERVAL_LOW = 0.95
local THEME_BLEND = 4 -- durée du fondu entre deux thèmes (s)
local DESIGN_H = 720 -- hauteur de la toile "design"
local GRAVITY = 1.5 -- (hauteur d'écran / s²) pour les rebonds et les éclats

local THEMES = {
	{ Emojis = { "🎉", "🥳", "🎊", "🎈", "✨", "🎁", "🍾" }, Hero = { "🥳", "🎉", "🎁" }, Glow = Color3.fromRGB(255, 214, 90) },
	{ Emojis = { "💖", "😍", "💕", "💘", "😘", "🌹", "💝" }, Hero = { "💖", "😍" }, Glow = Color3.fromRGB(255, 120, 176) },
	{ Emojis = { "🍕", "🍩", "🍔", "🍟", "🍓", "🧁", "🍪", "🍿" }, Hero = { "🍩", "🍕", "🍔" }, Glow = Color3.fromRGB(255, 172, 90) },
	{ Emojis = { "🚀", "⭐", "🌙", "👽", "🌍", "🛸", "💫", "🌟" }, Hero = { "🚀", "🛸", "🌍" }, Glow = Color3.fromRGB(140, 160, 255) },
	{ Emojis = { "🐶", "🐱", "🦊", "🐼", "🐸", "🐧", "🦄", "🐥" }, Hero = { "🦄", "🐼", "🐶" }, Glow = Color3.fromRGB(150, 226, 140) },
	{ Emojis = { "🔥", "💯", "🤯", "😂", "💀", "👀", "🤩", "😎" }, Hero = { "🔥", "💯", "🤯" }, Glow = Color3.fromRGB(255, 132, 60) },
	{ Emojis = { "🌸", "🍀", "🌈", "🌻", "🍁", "🌷", "🦋" }, Hero = { "🌈", "🦋", "🌻" }, Glow = Color3.fromRGB(140, 224, 176) },
	{ Emojis = { "💰", "💎", "🤑", "👑", "💵", "⭐" }, Hero = { "💎", "👑", "💰" }, Glow = Color3.fromRGB(255, 220, 60) },
}

-- Couches de profondeur : loin (petit, pâle, lent) -> près (gros, net, rapide)
local LAYERS = {
	{ Chance = 0.4, MinSize = 15, MaxSize = 22, Transparency = { 0.55, 0.7 }, Speed = { 0.045, 0.065 }, ZIndex = 1 },
	{ Chance = 0.35, MinSize = 25, MaxSize = 33, Transparency = { 0.3, 0.45 }, Speed = { 0.075, 0.1 }, ZIndex = 2 },
	{ Chance = 0.25, MinSize = 38, MaxSize = 50, Transparency = { 0.15, 0.28 }, Speed = { 0.11, 0.15 }, ZIndex = 3 },
}

-- Façons de tomber (probabilités cumulées plus bas)
local STYLES = {
	{ Name = "Sway", Weight = 0.38 },
	{ Name = "Spin", Weight = 0.2 },
	{ Name = "Flutter", Weight = 0.22 },
	{ Name = "Bounce", Weight = 0.2 },
}

function EmojiRain.Start(ctx)
	local container: Frame = ctx.Container
	-- Tout en dessous des autres stimuli du calque (notifications, mails...) :
	-- la pluie reste un décor et ne recouvre jamais un élément à lire / cliquer
	container.ZIndex = 0
	local UIUtil = ctx.UIUtil
	local random = Random.new()

	local pool: { any } = {}
	local activeCount = 0
	local spawnTimer = 0
	local clock = 0

	local themeIndex = random:NextInteger(1, #THEMES)
	local previousTheme = themeIndex
	local themeAge = THEME_BLEND -- pas de fondu au démarrage
	local themeDuration = random:NextNumber(20, 28)
	local burstTimer = random:NextNumber(6, 10)
	local heroTimer = random:NextNumber(8, 14)
	local heroDrop: any = nil -- l'emoji héros actuel (un seul à la fois)
	local rushLeft = 0 -- petite averse au changement de thème

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	-- Halo derrière l'emoji héros (une étiquette ronde sans texte)
	local glow = UIUtil.Create("TextLabel", {
		Name = "HeroGlow",
		Text = "",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = THEMES[themeIndex].Glow,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		Selectable = false,
		Visible = false,
		ZIndex = 4,
		Parent = container,
	})
	UIUtil.Corner(glow, UDim.new(1, 0))
	local glowStroke = UIUtil.Stroke(glow, THEMES[themeIndex].Glow, 8, 1)

	-- Crée toutes les étiquettes une fois pour toutes
	for _ = 1, POOL_SIZE do
		local label = UIUtil.Create("TextLabel", {
			Name = "Emoji",
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Font = ctx.Theme.Fonts.Body,
			Text = "",
			TextScaled = false,
			Active = false,
			Selectable = false,
			Visible = false,
			ZIndex = 1,
			Parent = container,
		})
		table.insert(pool, { Label = label, Active = false })
	end

	local function acquire()
		for _, drop in ipairs(pool) do
			if not drop.Active then
				return drop
			end
		end
		return nil
	end

	local function release(drop)
		if drop.Active then
			drop.Active = false
			activeCount -= 1
		end
		drop.Label.Visible = false
		if drop == heroDrop then
			heroDrop = nil
			glow.Visible = false
		end
	end

	-- Thème du moment (pendant le fondu : mélange avec l'ancien)
	local function currentTheme()
		if themeAge < THEME_BLEND and random:NextNumber() > themeAge / THEME_BLEND then
			return THEMES[previousTheme]
		end
		return THEMES[themeIndex]
	end

	local function pick(list: { string }): string
		return list[random:NextInteger(1, #list)]
	end

	local function setSize(drop, size: number)
		drop.Size = size
		drop.Label.TextSize = size
		drop.Label.Size = UDim2.fromOffset(size * 1.3, size * 1.3)
	end

	-- Prépare une goutte commune à tous les styles
	local function activate(drop, text: string, size: number, transparency: number, zIndex: number)
		local label: TextLabel = drop.Label
		label.Text = text
		label.TextTransparency = transparency
		label.ZIndex = zIndex
		label.Rotation = 0
		label.Visible = true
		setSize(drop, size)
		drop.Active = true
		drop.Alpha = transparency
		drop.Age = 0
		drop.Rot = 0
		drop.Spin = 0
		drop.VX = 0
		drop.VY = 0
		drop.Bounces = 0
		drop.Fade = -1 -- < 0 : pas encore en train de disparaître
		activeCount += 1
	end

	-- Une goutte "normale" qui tombe du haut
	local function spawnDrop()
		local drop = acquire()
		if not drop then
			return
		end
		local roll = random:NextNumber()
		local layer = LAYERS[#LAYERS]
		local acc = 0
		for _, candidate in ipairs(LAYERS) do
			acc += candidate.Chance
			if roll <= acc then
				layer = candidate
				break
			end
		end
		local styleRoll = random:NextNumber()
		local style = "Sway"
		acc = 0
		for _, candidate in ipairs(STYLES) do
			acc += candidate.Weight
			if styleRoll <= acc then
				style = candidate.Name
				break
			end
		end

		local size = random:NextInteger(layer.MinSize, layer.MaxSize)
		activate(drop, pick(currentTheme().Emojis), size, random:NextNumber(layer.Transparency[1], layer.Transparency[2]), layer.ZIndex)
		drop.Style = style
		drop.BaseX = random:NextNumber(0.02, 0.98)
		drop.X = drop.BaseX
		drop.Y = -0.06
		drop.Speed = random:NextNumber(layer.Speed[1], layer.Speed[2])
		drop.Phase = random:NextNumber(0, math.pi * 2)
		drop.SwayAmp = random:NextNumber(0.006, 0.02)
		drop.SwayFreq = random:NextNumber(1, 2.2)
		drop.Rot = random:NextNumber(-25, 25)

		if style == "Spin" then
			drop.Speed *= 1.25
			drop.Spin = random:NextNumber(140, 280) * ((random:NextNumber() < 0.5) and -1 or 1)
		elseif style == "Flutter" then
			drop.Speed *= 0.75
			drop.SwayAmp = random:NextNumber(0.025, 0.05)
			drop.SwayFreq = random:NextNumber(0.9, 1.5)
		elseif style == "Bounce" then
			drop.VY = drop.Speed
			drop.VX = random:NextNumber(-0.03, 0.03)
			drop.Spin = random:NextNumber(-90, 90)
		end
	end

	-- Emoji héros : géant, lent, avec un halo qui pulse
	local function spawnHero()
		local drop = acquire()
		if not drop then
			return
		end
		local theme = THEMES[themeIndex]
		activate(drop, pick(theme.Hero), random:NextInteger(64, 78), 0.15, 5)
		drop.Style = "Hero"
		drop.BaseX = random:NextNumber(0.08, 0.92)
		drop.X = drop.BaseX
		drop.Y = -0.12
		drop.Speed = random:NextNumber(0.06, 0.075)
		drop.Phase = random:NextNumber(0, math.pi * 2)
		drop.SwayAmp = 0.025
		drop.SwayFreq = 0.8
		heroDrop = drop
		glow.BackgroundColor3 = theme.Glow
		glowStroke.Color = theme.Glow
		glow.Visible = true
	end

	-- Explosion : un gros emoji gonfle puis éclate en morceaux
	local function spawnBurst()
		local drop = acquire()
		if not drop then
			return
		end
		activate(drop, pick(THEMES[themeIndex].Hero), 1, 0.05, 5)
		drop.Style = "Burst"
		drop.X = random:NextNumber(0.1, 0.9)
		drop.Y = random:NextNumber(0.18, 0.5)
		drop.Spin = random:NextNumber(-40, 40)
	end

	local function explode(x: number, y: number)
		local theme = THEMES[themeIndex]
		local pieces = random:NextInteger(6, 8)
		for i = 1, pieces do
			local drop = acquire()
			if not drop then
				return
			end
			activate(drop, pick(theme.Emojis), random:NextInteger(22, 36), 0.1, 4)
			drop.Style = "Piece"
			drop.X, drop.Y = x, y
			local angle = (i / pieces) * math.pi * 2 + random:NextNumber(-0.3, 0.3)
			local power = random:NextNumber(0.25, 0.45)
			-- Toile 16:9 : l'écart horizontal est "écrasé" pour rester rond
			drop.VX = math.cos(angle) * power * 0.5625
			drop.VY = math.sin(angle) * power - 0.25
			drop.Spin = random:NextNumber(-300, 300)
			drop.Life = random:NextNumber(0.9, 1.3)
		end
	end

	ctx.OnRender(function(rawDt: number)
		local dt = math.min(rawDt, 0.1)
		clock += dt
		local fx = effectsOn()

		-- Changement de thème (en fondu) + petite averse
		themeAge += dt
		if themeAge >= themeDuration then
			previousTheme = themeIndex
			local nextTheme = random:NextInteger(1, #THEMES - 1)
			if nextTheme >= themeIndex then
				nextTheme += 1
			end
			themeIndex = nextTheme
			themeAge = 0
			themeDuration = random:NextNumber(20, 28)
			rushLeft = fx and 6 or 0
		end

		-- Nouvelles gouttes
		local limit = fx and MAX_ACTIVE or MAX_ACTIVE_LOW
		spawnTimer -= dt
		if spawnTimer <= 0 then
			if rushLeft > 0 then
				rushLeft -= 1
				spawnTimer = 0.08
			else
				spawnTimer = (fx and SPAWN_INTERVAL or SPAWN_INTERVAL_LOW) * random:NextNumber(0.7, 1.3)
			end
			if activeCount < limit then
				spawnDrop()
			end
		end

		heroTimer -= dt
		if heroTimer <= 0 then
			heroTimer = random:NextNumber(10, 18) * (fx and 1 or 2)
			if not heroDrop and activeCount < limit then
				spawnHero()
			end
		end

		if fx then
			burstTimer -= dt
			if burstTimer <= 0 then
				burstTimer = random:NextNumber(9, 16)
				if activeCount <= POOL_SIZE - 9 then
					spawnBurst()
				end
			end
		end

		-- Petit vent qui change lentement de sens
		local wind = math.sin(clock * 0.23) * 0.012

		for _, drop in ipairs(pool) do
			if drop.Active then
				drop.Age += dt
				local label: TextLabel = drop.Label
				local style = drop.Style
				local x, y = drop.X, drop.Y
				local rotation = drop.Rot
				local transparency = drop.Alpha
				local remove = false
				local burstAt: Vector2? = nil

				if style == "Sway" or style == "Hero" then
					drop.Y += drop.Speed * dt
					drop.BaseX += wind * dt
					local wave = math.sin(clock * drop.SwayFreq + drop.Phase)
					x = drop.BaseX + wave * drop.SwayAmp
					y = drop.Y
					rotation = drop.Rot + wave * 14
					remove = y > 1.12
				elseif style == "Spin" then
					drop.Y += drop.Speed * dt
					drop.BaseX += wind * 1.4 * dt
					drop.Rot += drop.Spin * dt
					x = drop.BaseX + math.sin(clock * drop.SwayFreq + drop.Phase) * drop.SwayAmp * 0.5
					y = drop.Y
					rotation = drop.Rot
					remove = y > 1.1
				elseif style == "Flutter" then
					-- Feuille : zigzag large, penche dans le sens où elle glisse
					drop.Y += drop.Speed * dt * (0.75 + 0.25 * math.abs(math.cos(clock * drop.SwayFreq + drop.Phase)))
					drop.BaseX += wind * 1.8 * dt
					local wave = math.sin(clock * drop.SwayFreq + drop.Phase)
					x = drop.BaseX + wave * drop.SwayAmp
					y = drop.Y
					rotation = math.cos(clock * drop.SwayFreq + drop.Phase) * 38
					remove = y > 1.1
				elseif style == "Bounce" then
					-- Tombe, rebondit sur le bas de l'écran puis s'efface
					local floorY = 1 - (drop.Size * 0.5) / DESIGN_H
					if drop.Fade < 0 then
						drop.VY += GRAVITY * 0.35 * dt
						drop.Y += drop.VY * dt
						drop.X += (drop.VX + wind) * dt
						drop.Rot += drop.Spin * dt
						if drop.Y >= floorY and drop.VY > 0 then
							drop.Y = floorY
							drop.Bounces += 1
							drop.VY = -drop.VY * 0.5
							drop.Spin = -drop.Spin * 0.7
							if drop.Bounces >= 2 or math.abs(drop.VY) < 0.03 then
								drop.Fade = 0
							end
						end
					else
						-- Au sol : glisse un peu, s'aplatit et disparaît
						drop.Fade += dt
						drop.X += drop.VX * dt * 0.5
						drop.Y = floorY
						local t = math.clamp(drop.Fade / 0.6, 0, 1)
						transparency = drop.Alpha + (1 - drop.Alpha) * t
						remove = t >= 1
					end
					x, y = drop.X, drop.Y
					rotation = drop.Rot
				elseif style == "Burst" then
					-- Gonfle (avec rebond), tremble, puis éclate
					local age = drop.Age
					local grow = math.clamp(age / 0.35, 0, 1)
					local overshoot = 1 + math.sin(grow * math.pi) * 0.25
					local size = 60 * grow * overshoot
					if age > 0.55 then
						size = 60 * (1 + (age - 0.55) * 1.8)
						x = drop.X + random:NextNumber(-0.002, 0.002)
						y = drop.Y + random:NextNumber(-0.003, 0.003)
					end
					setSize(drop, math.max(1, size))
					rotation = math.sin(age * 30) * 8 * math.clamp((age - 0.4) * 4, 0, 1)
					if age > 0.8 then
						remove = true
						burstAt = Vector2.new(drop.X, drop.Y)
					end
				elseif style == "Piece" then
					drop.VY += GRAVITY * dt
					drop.X += drop.VX * dt
					drop.Y += drop.VY * dt
					drop.Rot += drop.Spin * dt
					x, y = drop.X, drop.Y
					rotation = drop.Rot
					local t = math.clamp(drop.Age / drop.Life, 0, 1)
					transparency = drop.Alpha + (1 - drop.Alpha) * t * t
					remove = t >= 1 or y > 1.1
				end

				if x < -0.08 or x > 1.08 then
					remove = true
				end

				if remove then
					release(drop)
					if burstAt then
						explode(burstAt.X, burstAt.Y) -- après la libération : l'étiquette peut servir d'éclat
					end
				else
					label.Position = UDim2.fromScale(x, y)
					label.Rotation = rotation
					label.TextTransparency = transparency
					if drop == heroDrop then
						local pulse = 1 + math.sin(clock * 3) * 0.08
						local glowSize = drop.Size * 1.5 * pulse
						glow.Position = label.Position
						glow.Size = UDim2.fromOffset(glowSize, glowSize)
						glow.BackgroundTransparency = 0.72 + math.sin(clock * 3) * 0.06
						glowStroke.Transparency = 0.8
					end
				end
			end
		end
	end)
end

function EmojiRain.Stop(_ctx)
	-- Les étiquettes sont dans ctx.Container (détruit par le StimulusManager)
end

return EmojiRain
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">GoldenStar</string>
            <string name="Source"><![CDATA[--[[
	GoldenStar (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > GoldenStar

	Étoiles dorées qui apparaissent au hasard (décidé par le SERVEUR via
	l'événement Spawn "Golden") : halo qui pulse, rayons qui tournent,
	petites étincelles en orbite... et elles s'en vont vite !
	Un clic = ClaimSpawn (le serveur vérifie puis envoie le bonus), et le
	bonus confirmé s'affiche en gros "+X" doré à l'endroit de l'étoile.
]]

local Debris = game:GetService("Debris")

local GoldenStar = {}
GoldenStar.Slot = "Overlay"

local Locale = require(game:GetService("ReplicatedStorage").Shared.Locale)

local MAX_STARS = 5
local RAY_COUNT = 6
local WARNING_TIME = 1.5 -- dernières secondes : l'étoile s'impatiente

local TAGS = {
	en = { "quick!!", "catch me", "click here ✨", "I'm shiny!", "it's me 🌟", "over here!" },
	fr = { "vite !!", "attrape-moi", "clique ici ✨", "je brille !", "c'est moi 🌟", "par ici !" },
}
local HURRY_TAGS = {
	en = { "too late?", "I'm leaving!", "bye bye...", "hurry up!" },
	fr = { "trop tard ?", "je pars !", "bye bye...", "dépêche !" },
}
local CHEERS = {
	en = { "SO LUCKY!", "STAR CAUGHT!", "GOLDEN!!!", "BRILLIANT!", "CAT-LIKE REFLEXES!" },
	fr = { "QUELLE CHANCE !", "ÉTOILE ATTRAPÉE !", "DORÉ !!!", "BRILLANT !", "RÉFLEXES DE CHAT !" },
}

-- Tire une phrase au hasard dans la liste de la langue du joueur
local function pickLine(variants, random: Random): string
	local list = Locale.Pick(variants)
	return list[random:NextInteger(1, #list)]
end

function GoldenStar.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local container: Frame = ctx.Container
	local random = Random.new()

	local stars = {} -- [id] = étoile active
	local count = 0
	local positions = {} -- [id] = UDim2 (pour placer le "+X" du bonus)
	local lastPosition = UDim2.fromScale(0.5, 0.45)

	local gold = Theme.Colors.Gold
	local orange = Theme.Colors.Orange

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	-- Fait disparaître tous les éléments visuels d'une étoile
	local function fadeAll(root: Instance, duration: number)
		for _, item in ipairs(root:GetDescendants()) do
			if item:IsA("TextLabel") then
				UIUtil.Tween(item, duration, { TextTransparency = 1, BackgroundTransparency = 1 })
			elseif item:IsA("Frame") then
				UIUtil.Tween(item, duration, { BackgroundTransparency = 1 })
			elseif item:IsA("UIStroke") then
				UIUtil.Tween(item, duration, { Transparency = 1 })
			end
		end
	end

	local function removeStar(star, popped: boolean)
		if star.Done then
			return
		end
		star.Done = true
		stars[star.Id] = nil
		count -= 1
		local scale = star.Scale
		if popped then
			UIUtil.Tween(scale, 0.3, { Scale = 1.8 }, Enum.EasingStyle.Quad)
			fadeAll(star.Button, 0.3)
		else
			UIUtil.Tween(scale, 0.35, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		end
		Debris:AddItem(star.Button, 0.4)
	end

	local function spawnStar(info)
		if not ctx.IsAlive() or type(info) ~= "table" or info.Id == nil then
			return
		end
		if stars[info.Id] or count >= MAX_STARS then
			return
		end
		local x = math.clamp(tonumber(info.X) or 0.5, 0.05, 0.95)
		local y = math.clamp(tonumber(info.Y) or 0.5, 0.08, 0.92)
		local lifetime = math.max(1, tonumber(info.Lifetime) or 6)
		local basePosition = UDim2.fromScale(x, y)

		-- Bouton principal (zone cliquable généreuse pour le tactile)
		local button = UIUtil.Create("TextButton", {
			Name = "GoldenStar",
			Size = UDim2.fromOffset(100, 100),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = basePosition,
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			ZIndex = 20,
			Parent = container,
		})
		local scale = UIUtil.Create("UIScale", { Scale = 0, Parent = button })

		-- Halo (cercles concentriques de plus en plus transparents)
		local halo = UIUtil.Create("Frame", {
			Name = "Halo",
			Size = UDim2.fromOffset(180, 180),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			BackgroundTransparency = 1,
			ZIndex = 20,
			Parent = button,
		})
		local haloScale = UIUtil.Create("UIScale", { Parent = halo })
		for i, spec in ipairs({ { 1, 0.88 }, { 0.75, 0.78 }, { 0.55, 0.62 } }) do
			local ring = UIUtil.Create("Frame", {
				Size = UDim2.fromScale(spec[1], spec[1]),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				BackgroundColor3 = i == 3 and Theme.Colors.Yellow or gold,
				BackgroundTransparency = spec[2],
				ZIndex = 20,
				Parent = halo,
			})
			UIUtil.Corner(ring, UDim.new(1, 0))
		end

		-- Rayons qui tournent
		local rays = {}
		for i = 1, RAY_COUNT do
			local ray = UIUtil.Create("Frame", {
				Size = UDim2.fromOffset(200, 8),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				BackgroundColor3 = Theme.Colors.Yellow,
				BackgroundTransparency = 0.2,
				Rotation = (i - 1) * (180 / RAY_COUNT),
				ZIndex = 21,
				Parent = button,
			})
			UIUtil.Corner(ray, UDim.new(1, 0))
			UIUtil.Create("UIGradient", {
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1),
					NumberSequenceKeypoint.new(0.35, 0.55),
					NumberSequenceKeypoint.new(0.5, 0.3),
					NumberSequenceKeypoint.new(0.65, 0.55),
					NumberSequenceKeypoint.new(1, 1),
				}),
				Parent = ray,
			})
			rays[i] = ray
		end

		-- Médaillon doré
		local disc = UIUtil.Create("Frame", {
			Name = "Disc",
			Size = UDim2.fromOffset(78, 78),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			BackgroundColor3 = Color3.new(1, 1, 1),
			ZIndex = 22,
			Parent = button,
		})
		UIUtil.Corner(disc, UDim.new(1, 0))
		local discStroke = UIUtil.Stroke(disc, Color3.new(1, 1, 1), 3, 0)
		local discGradient = UIUtil.Gradient(disc, ColorSequence.new({
			ColorSequenceKeypoint.new(0, Theme.Colors.Yellow),
			ColorSequenceKeypoint.new(0.5, gold),
			ColorSequenceKeypoint.new(1, orange),
		}), 45)
		UIUtil.Label({
			Text = "🌟",
			Size = UDim2.fromScale(0.78, 0.78),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			MaxTextSize = 56,
			ZIndex = 23,
			Parent = disc,
		})

		-- Étincelles en orbite
		local sparkles = {}
		for i = 1, 2 do
			sparkles[i] = UIUtil.Label({
				Text = "✨",
				Size = UDim2.fromOffset(26, 26),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				MaxTextSize = 24,
				ZIndex = 24,
				Parent = button,
			})
		end

		-- Petite étiquette "vite !!"
		local tag = UIUtil.Label({
			Text = pickLine(TAGS, random),
			Font = Theme.Fonts.Title,
			TextColor3 = Theme.Colors.TextDark,
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0,
			Size = UDim2.fromOffset(104, 24),
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 1, 4),
			MaxTextSize = 17,
			ZIndex = 25,
			Parent = button,
		})
		UIUtil.Corner(tag, UDim.new(1, 0))
		UIUtil.Stroke(tag, Theme.Colors.Border, 1.5, 0.1)

		local star = {
			Id = info.Id,
			Button = button,
			Scale = scale,
			HaloScale = haloScale,
			Rays = rays,
			Disc = disc,
			DiscStroke = discStroke,
			DiscGradient = discGradient,
			Sparkles = sparkles,
			Tag = tag,
			Base = basePosition,
			Born = os.clock(),
			Lifetime = lifetime,
			Phase = random:NextNumber(0, math.pi * 2),
			Hurry = false,
			Done = false,
		}
		stars[info.Id] = star
		count += 1

		-- Apparition
		UIUtil.Tween(scale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
		ctx.Sound.Play("Golden", 1.4)

		-- Clic : on réclame l'étoile au serveur
		ctx.Connect(button.Activated, function()
			if star.Done or not ctx.IsAlive() then
				return
			end
			local position = button.Position
			positions[star.Id] = position
			lastPosition = position
			ctx.ClaimSpawn(star.Id)
			ctx.Sound.Play("Golden", 1.8)
			if effectsOn() then
				ctx.Effects.Burst(container, position, gold, 24)
				ctx.Effects.Burst(container, position, nil, 12)
				ctx.Effects.Flash(Theme.Colors.Yellow, 0.2)
			end
			removeStar(star, true)
			-- On oublie la position après un moment
			task.delay(6, function()
				positions[star.Id] = nil
			end)
		end)
	end

	-- Animation de toutes les étoiles (une seule connexion)
	ctx.OnRender(function()
		local now = os.clock()
		for _, star in pairs(stars) do
			local age = now - star.Born
			local left = star.Lifetime - age
			if left <= 0 then
				removeStar(star, false)
			else
				local t = now + star.Phase
				-- Flotte doucement
				star.Button.Position = star.Base + UDim2.fromOffset(math.sin(t * 1.3) * 10, math.cos(t * 1.7) * 8)
				-- Halo qui respire
				star.HaloScale.Scale = 1 + math.sin(t * 5) * 0.1
				-- Rayons qui tournent
				local spin = t * 45
				for i, ray in ipairs(star.Rays) do
					ray.Rotation = spin + (i - 1) * (180 / RAY_COUNT)
				end
				star.DiscGradient.Rotation = (t * 120) % 360
				-- Étincelles en orbite
				for i, sparkle in ipairs(star.Sparkles) do
					local angle = t * 3 + i * math.pi
					sparkle.Position = UDim2.new(0.5, math.cos(angle) * 56, 0.5, math.sin(angle) * 48)
				end
				-- Pulsation (après l'apparition)
				if age > 0.45 then
					if left < WARNING_TIME then
						-- Pressée de partir : tremble et clignote
						if not star.Hurry then
							star.Hurry = true
							star.Tag.Text = pickLine(HURRY_TAGS, random)
							star.Tag.BackgroundColor3 = Theme.Colors.Red
							star.Tag.TextColor3 = Theme.Colors.TextLight
						end
						star.Scale.Scale = 1 + math.sin(t * 22) * 0.07
						star.Disc.Rotation = math.sin(t * 30) * 12
						star.DiscStroke.Color = (math.floor(now * 8) % 2 == 0) and Theme.Colors.Red or Color3.new(1, 1, 1)
					else
						star.Scale.Scale = 1 + math.sin(t * 9) * 0.06
						star.Disc.Rotation = math.sin(t * 3) * 12
					end
				end
			end
		end
	end)

	ctx.OnSpawn("Golden", spawnStar)

	-- Bonus confirmé : gros "+X" doré
	ctx.OnBonus("Golden", function(payload)
		if not ctx.IsAlive() then
			return
		end
		local position = (payload.SpawnId and positions[payload.SpawnId]) or lastPosition
		ctx.FloatText(container, position, "+" .. ctx.Format.Format(tonumber(payload.Amount) or 0), gold, 60)
		ctx.FloatText(container, position + UDim2.fromOffset(0, 50), pickLine(CHEERS, random), orange, 26)
	end)
end

function GoldenStar.Stop(_ctx)
	-- Les étoiles vivent dans ctx.Container (détruit par le StimulusManager)
end

return GoldenStar
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">LiveStream</string>
            <string name="Source"><![CDATA[--[[
	LiveStream (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > LiveStream

	Faux live "ASMR mukbang" (slot L3, 384x268, en bas à gauche), façon
	appli de streaming :
	  - en-tête : avatar dessiné, pseudo certifié, badge "● LIVE" qui pulse,
	    spectateurs (animés, montent avec l'amélioration "Abonnés"), likes ;
	  - la vidéo : une streameuse DESSINÉE en formes (cheveux, casque
	    lumineux, sweat, bras qui portent la nourriture à la bouche, yeux
	    qui clignent, joues roses, bouche qui mâche), un ring light, un
	    micro ASMR "moumoute" avec ondes sonores, une assiette d'aliments
	    mangés un par un ("CRUNCH !", miettes, cœurs qui montent) ;
	  - bouton "Suivre" : si ClientState.Data.LiveFollowed est faux,
	    Interact("Follow") (récompense unique par partie), puis "✔ Abonné"
	    et les dons commencent ;
	  - dons : OnSpawn("Donation") affiche une carte dorée (dans le chat ou
	    en haut de la vidéo), cliquable -> ClaimSpawn ; OnBonus("Donation" /
	    "Follow") fait flotter le gain ;
	  - Feature "LiveChat" : colonne de chat vivante (50 pseudos colorés,
	    rôles 🛡️ modo / 💎 abonné / 👑 VIP, 150+ messages, messages
	    d'emotes en gros, message épinglé, défilement fluide avec fondu en
	    haut, "raids" de temps en temps) qui réagit aux aliments mangés,
	    au beurre, aux dons, à l'abonnement et aux gros gains du joueur ;
	  - Feature "Butter" : un gros bloc de beurre brillant sur une coupelle.
	    Clic = son "Crunch", traces de dents, éclats (il se fait manger
	    petit à petit puis revient), "+X" = gain par clic x ClickFraction,
	    Interact("Butter") limité côté client à MaxPerSecond.
]]

local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

local Locale = require(game:GetService("ReplicatedStorage").Shared.Locale)

local LiveStream = {}
LiveStream.Slot = "L3"

----------------------------------------------------------------------
-- Disposition (pixels "design"). Tout découle de la taille du slot L3
-- (voir Client > Slots) : la carte est rentrée de 2 px, la vidéo et le
-- chat se calent sur la largeur de la carte (Scale), la scène de la vidéo
-- est placée depuis le haut de la vidéo.
----------------------------------------------------------------------
local SLOT_W, SLOT_H = 384, 268 -- = Slots.Definitions.L3
local CARD_W, CARD_H = SLOT_W - 4, SLOT_H - 4 -- 380 x 264
local PAD = 8 -- marge intérieure de la carte (côtés et bas)
local HEADER_H = 46 -- en-tête : avatar, pseudo, LIVE, Suivre
local HEADER_MID = HEADER_H / 2 -- ligne centrale de l'en-tête
local VIDEO_X, VIDEO_Y = PAD, HEADER_H
local VIDEO_H = CARD_H - VIDEO_Y - PAD -- 210
local CHAT_W = 138 -- colonne de chat (Feature "LiveChat")
local GAP = 6 -- espace entre la vidéo et le chat
local FOLLOW_W, FOLLOW_H = 100, 30 -- bouton "Suivre"
local LIVE_W, LIVE_H = 52, 20 -- badge "● LIVE"
local TABLE_Y = VIDEO_H - 60 -- haut de la table dans la vidéo (150)
local PLATE_Y = TABLE_Y + 13 -- centre de l'assiette
-- La streameuse est dessinée sur une grille de 80 x 80 puis agrandie
local STREAMER_SCALE = 1.4
local STREAMER_Y = TABLE_Y + 8 -- bas de la streameuse (caché par la table)
local MOUTH_Y = STREAMER_Y - 41 * STREAMER_SCALE -- bouche de la streameuse (vidéo)
local HEAD_Y = STREAMER_Y - 55 * STREAMER_SCALE -- centre du ring light (derrière la tête)
local BUTTER_X = 0.85 -- position (Scale) du beurre sur la table
local BUTTER_Y = TABLE_Y + 26 -- bas de la coupelle de beurre
local MIC_X = 0.12
local MAX_CHAT = 18 -- messages gardés (les plus vieux sont hors champ, en haut)
local MAX_HEARTS = 7
local BUTTER_BITES = 8 -- bouchées avant qu'il ne reste plus rien

local FOODS = { "🥪", "🍟", "🍔", "🌭", "🍕", "🥓", "🍗", "🌮", "🍩", "🥐", "🍪", "🌯", "🍙", "🧁" }
local FOOD_OFFSETS = { -29, -10, 10, 29 }

local CRUNCH_WORDS = {
	en = { "CRUNCH!", "YUM", "CHOMP!", "*crunch*", "SLURP", "CRACK!", "NOM NOM", "CRISP!", "MMMH", "SCRUNCH" },
	fr = { "CRUNCH !", "MIAM", "CROC !", "*crounch*", "SLURP", "CRAC !", "NOM NOM", "CRISP !", "MMMH", "SCROUNCH" },
}
local BUTTER_WORDS = {
	en = { "CRONCH!", "*CRONCH*", "CRACK!", "SCRONCH", "CRUNCH!!" },
	fr = { "CROUNCH !", "*CROUNCH*", "CRAC !", "SCRONCH", "CRUNCH !!" },
}
local POP_COLORS = {
	Color3.fromRGB(255, 214, 40),
	Color3.fromRGB(255, 90, 160),
	Color3.fromRGB(0, 210, 255),
	Color3.fromRGB(255, 255, 255),
	Color3.fromRGB(130, 255, 120),
}
local HEARTS = { "❤️", "💜", "💖", "😍", "🔥", "👏", "✨" }

local HOST = "MangeTout_ASMR"

----------------------------------------------------------------------
-- Chat : pseudos, rôles et messages (tout est inventé)
----------------------------------------------------------------------
local NAMES = {
	"Kevin_du_75", "xX_Nugget_Xx", "Mamie_Gaming", "LeChatDuVoisin", "BaguetteMan", "Tartiflette99",
	"MrPatate", "Choupette", "DarkSasuke42", "Poulet_Braisé", "Zinzin_78", "Croquette", "SushiLover",
	"Tonton_Jean", "Lulu_ASMR", "PatateDouce", "Bichon_Fou", "Crêpe_Party", "Moustache_Pro",
	"Raclette4Life", "Gratin2Pâtes", "Ninja_du_Dimanche", "Fromage_Fou", "LaTeteDansLeFrigo",
	"Pépito_Gamer", "Mimi_Chaussette", "Cornichon_Royal", "Tata_Brioche", "Loulou_Pixel", "CaptainKebab",
	"Nuage_Rose", "Petit_Pois", "Madeleine_Proust", "Framboise_Zen", "Cacahuète42", "Le_Roi_du_Gouda",
	"Pingouin_Timide", "Chocapic_Fan", "Sardine_Club", "Biscotte_Ninja", "Yaourt_Nature", "Mister_Frites",
	"Poney_Magique", "Tomate_Cerise", "Kiwi_Sauvage", "Doudou_77", "Licorne_Fatiguée", "Bretzel_Boss",
	"Céleri_Rave", "Nutella_Addict",
}
-- Modérateurs (badge 🛡️) : toujours les mêmes, comme sur un vrai live
local MODS = { Tonton_Jean = true, Lulu_ASMR = true, Moustache_Pro = true, Madeleine_Proust = true }
local NAME_COLORS = { "#FF6B9A", "#6BD5FF", "#FFD34D", "#9DFF6B", "#C38BFF", "#FF9F45", "#5CFFD1", "#FF7AF0", "#7AA2FF", "#FFB3C7" }

local MESSAGES = {
	en = {
		"W", "+1", "insane", "what is this stream", "that crunch was perfect", "again!!", "i'm hungry now",
		"she's eating at 3am??", "first", "quality ASMR", "YUM", "so satisfying",
		"watching this instead of studying", "lmao", "the sound 🤤", "hi mom if you see this",
		"she didn't even chew", "so good", "respect", "where's the sauce??", "GG",
		"who's been here since the start?", "dropped my snack", "5 stars", "my favorite part", "L",
		"is she gonna finish the plate??", "love the headset", "i'm on a diet 😭", "the mic 😳", "snack time",
		"we want fries!", "i can hear the crunch from here", "come eat at my place", "ratio", "falling asleep 😴",
		"the ring light 😍", "that hoodie is so cute", "has anyone seen my glasses?",
		"i was supposed to sleep 2h ago", "better than a movie", "pretty sure my teacher watches too",
		"how many of us are here?", "chat is wild tonight", "hello from Texas ☀️", "hi from London 👋",
		"greetings from Toronto ❄️", "love from Napa Valley 🍷", "eating chips at the same time",
		"can we get a cheese mukbang?", "next stream: fondue 🧀", "this is my nightly ritual",
		"she's so good at this", "how does her stomach not hurt??", "i want a fluffy mic too",
		"this is so relaxing", "my cat is watching with me 🐈", "i'm in class shh 🤫", "lol", "lmfao", "fr", "real",
		"i like every crunch", "who else eats in front of the screen?", "the sound is hypnotic",
		"staying till the end", "we vibing", "can't wait for tomorrow", "sharing this with my friends",

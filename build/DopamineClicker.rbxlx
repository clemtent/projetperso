	{ Avatar = "👵", Sender = "Mamie", Subject = "Fwd: Fwd: Fwd: TROP DRÔLE",
		Body = "REGARDE CE CHAT QUI FAIT DU SKI !!! BISOUS. PS : COMMENT ON ENLÈVE LES MAJUSCULES ?" },
	{ Avatar = "🔮", Sender = "Toi, dans le futur", Subject = "Ne clique pas sur...",
		Body = "...trop tard. Bon, puisque tu es là : bois un verre d'eau et pense à aller voir l'océan." },
	{ Avatar = "🙋", Sender = "Club des Cliqueurs Anonymes", Subject = "Réunion ce soir",
		Body = "« Bonjour, je m'appelle Kévin et j'ai cliqué 40 000 fois aujourd'hui. » (applaudissements)" },
	{ Avatar = "🎰", Sender = "Loterie Cosmique", Subject = "VOUS AVEZ GAGNÉ !!!",
		Body = "Félicitations ! Vous avez gagné... cet e-mail. Il est à vous. Profitez-en bien." },
	{ Avatar = "👔", Sender = "Le Boss", Subject = "Réunion demain à 8 h",
		Body = "Ordre du jour : parler de la réunion d'avant. Et prévoir celle d'après. Croissants non fournis." },
	{ Avatar = "🐦", Sender = "Pigeon Voyageur", Subject = "Désolé pour le retard",
		Body = "J'ai pris un raccourci par l'Islande. Le message était : « à ce soir ». C'était il y a deux semaines." },
	{ Avatar = "🌱", Sender = "Ta plante", Subject = "Lettre ouverte",
		Body = "Je vois le soleil par la fenêtre. Je le vois. Mais je ne l'ai pas. Réfléchis-y." },
	{ Avatar = "🧦", Sender = "Assurance Chaussettes", Subject = "Protégez vos chaussettes !",
		Body = "72 % des chaussettes disparaissent dans la machine à laver. Ne laissez pas la vôtre devenir une statistique." },
	{ Avatar = "🤖", Sender = "Robot Aspirateur", Subject = "Je suis coincé",
		Body = "Sous le canapé. Depuis mardi. J'ai trouvé 3 pièces, un bonbon et le sens de la vie." },
	{ Avatar = "🌊", Sender = "Agence Voyage Océan", Subject = "L'océan vous attend",
		Body = "Respirez. Détendez-vous. Oubliez les clics. Offre valable jusqu'à votre prochain clic." },
	{ Avatar = "🐱", Sender = "Le Chat", Subject = "Miaou",
		Body = "Miaou miaou. Miaou ? MIAOU. (Traduction : la gamelle est vide, c'est inadmissible.)" },
	{ Avatar = "😴", Sender = "Sieste Magazine", Subject = "Spécial été : 50 positions de sieste",
		Body = "Découvrez l'« étoile de mer », la « crêpe » et notre préférée : « encore 5 minutes »." },
	{ Avatar = "🚨", Sender = "Détecteur de fumée", Subject = "Bip.",
		Body = "Bip. Ma pile est faible. Je vais biper toutes les 30 secondes à 3 h du matin. Bip." },
	{ Avatar = "🏛️", Sender = "Mairie de Clicville", Subject = "Nouvelle loi sur les boutons",
		Body = "Il est désormais interdit de ne pas cliquer le mardi. Merci de votre compréhension." },
	{ Avatar = "⏳", Sender = "Toi, il y a une heure", Subject = "Juste 5 minutes",
		Body = "Je me suis dit « juste 5 minutes ». Si tu lis ceci, c'est que c'était un mensonge." },
	{ Avatar = "☀️", Sender = "Le Soleil", Subject = "Message d'absence",
		Body = "Je serai absent cette nuit. Pour toute urgence, merci de contacter la Lune." },
	{ Avatar = "📀", Sender = "Fan-club du Logo", Subject = "IL A PRESQUE TOUCHÉ LE COIN",
		Body = "Presque. PRESQUE. Nous nous réunissons ce soir pour en parler. Venez avec des mouchoirs." },
	{ Avatar = "🥖", Sender = "Boulangerie du Coin", Subject = "Votre baguette est prête",
		Body = "Elle vous attend depuis ce matin. Elle a un peu durci, mais elle reste positive." },
}

-- Réponses quand on clique sur "Répondre"
local REPLIES = {
	"Envoyé... à personne 📭",
	"Brouillon enregistré pour 2087",
	"Tu as répondu « ok ». Classique.",
	"Réponse : « mdr » 👍",
	"Message parti dans les spams 🗑️",
}

local function pick(list: { any }, variant: any): any
	local v = math.floor(tonumber(variant) or 1)
	return list[(v - 1) % #list + 1]
end

function Email.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local container: Frame = ctx.Container
	local random = Random.new()

	local cream = Color3.fromRGB(255, 249, 235)
	local creamDark = Color3.fromRGB(240, 225, 195)
	local blue = Theme.Colors.Blue
	local border = Theme.Colors.Border

	local envelopes: { [string]: any } = {}
	local envelopeCount = 0
	local missed = 0
	local positions: { [string]: UDim2 } = {}
	local lastPosition = UDim2.fromScale(0.5, 0.45)
	local popup: any = nil -- fenêtre de mail ouverte

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	------------------------------------------------------------------
	-- Compteur "📬 non lus" (en haut à droite, sous le fil d'actu)
	------------------------------------------------------------------
	local counter = UIUtil.Label({
		Name = "Unread",
		Text = "",
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.TextDark,
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0,
		Size = UDim2.fromOffset(128, 22),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 33),
		Visible = false,
		MaxTextSize = 15,
		ZIndex = 40,
		Parent = container,
	})
	UIUtil.Corner(counter, UDim.new(1, 0))
	UIUtil.Stroke(counter, border, 1.5, 0.1)
	local counterScale = UIUtil.Create("UIScale", { Parent = counter })

	local function refreshCounter()
		local unread = envelopeCount + missed
		counter.Visible = unread > 0
		local suffix = ""
		if unread >= 50 then
			suffix = " 😱"
		elseif unread >= 10 then
			suffix = " 😬"
		end
		counter.Text = "📬 " .. tostring(unread) .. (unread > 1 and " non lus" or " non lu") .. suffix
		counterScale.Scale = 1.25
		UIUtil.Tween(counterScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	end

	------------------------------------------------------------------
	-- Fenêtre de mail
	------------------------------------------------------------------
	local function closePopup(target)
		local current = target or popup
		if not current or current.Closed then
			return
		end
		current.Closed = true
		if popup == current then
			popup = nil
		end
		UIUtil.Tween(current.Scale, 0.2, { Scale = 0.5 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		UIUtil.Tween(current.Group, 0.2, { GroupTransparency = 1 })
		UIUtil.Tween(current.Outline, 0.2, { Transparency = 1 })
		UIUtil.Tween(current.Shadow, 0.2, { BackgroundTransparency = 1 })
		Debris:AddItem(current.Root, 0.25)
	end

	local function makeButton(parent: Instance, text: string, color: Color3, textColor: Color3, position: UDim2, width: number): TextButton
		local button = UIUtil.Create("TextButton", {
			Size = UDim2.fromOffset(width, 28),
			Position = position,
			BackgroundColor3 = color,
			AutoButtonColor = true,
			Font = Theme.Fonts.Title,
			Text = text,
			TextColor3 = textColor,
			TextSize = 15,
			ZIndex = 66,
			Parent = parent,
		})
		UIUtil.Corner(button, UDim.new(1, 0))
		UIUtil.Stroke(button, border, 1.5, 0.3)
		return button
	end

	local function openPopup(email, sx: number, sy: number)
		closePopup(nil)
		local ax = math.clamp(sx, 0.02, 0.98)
		local ay = math.clamp(sy, 0.05, 0.95)

		-- AnchorPoint = position : la fenêtre reste toujours dans l'écran
		local root = UIUtil.Create("Frame", {
			Name = "MailPopup",
			Size = UDim2.fromOffset(POPUP_W, POPUP_H),
			AnchorPoint = Vector2.new(ax, ay),
			Position = UDim2.fromScale(ax, ay),
			BackgroundTransparency = 1,
			ZIndex = 60,
			Parent = container,
		})
		local scale = UIUtil.Create("UIScale", { Scale = 0.5, Parent = root })
		local shadow = UIUtil.Create("Frame", {
			Size = UDim2.fromScale(1, 1),
			Position = UDim2.fromOffset(0, 6),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.8,
			BorderSizePixel = 0,
			ZIndex = 60,
			Parent = root,
		})
		UIUtil.Corner(shadow, 14)

		local group = UIUtil.Create("CanvasGroup", {
			Name = "Window",
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			GroupTransparency = 0,
			ZIndex = 61,
			Parent = root,
		})
		UIUtil.Corner(group, 14)

		-- Barre de titre
		local titleBar = UIUtil.Create("Frame", {
			Size = UDim2.new(1, 0, 0, 32),
			BackgroundColor3 = blue,
			BorderSizePixel = 0,
			ZIndex = 62,
			Parent = group,
		})
		UIUtil.Create("TextLabel", {
			Size = UDim2.new(1, -44, 1, 0),
			Position = UDim2.fromOffset(12, 0),
			BackgroundTransparency = 1,
			Font = Theme.Fonts.Title,
			Text = "📧 Nouveau message",
			TextColor3 = Color3.new(1, 1, 1),
			TextSize = 16,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 63,
			Parent = titleBar,
		})
		local closeButton = UIUtil.Create("TextButton", {
			Size = UDim2.fromOffset(26, 26),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -4, 0.5, 0),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.8,
			AutoButtonColor = true,
			Font = Theme.Fonts.Title,
			Text = "✕",
			TextColor3 = Color3.new(1, 1, 1),
			TextSize = 16,
			ZIndex = 64,
			Parent = titleBar,
		})
		UIUtil.Corner(closeButton, UDim.new(1, 0))

		-- Avatar + expéditeur + objet
		local avatar = UIUtil.Create("Frame", {
			Size = UDim2.fromOffset(40, 40),
			Position = UDim2.fromOffset(12, 40),
			BackgroundColor3 = Theme.Colors.PanelLight,
			BorderSizePixel = 0,
			ZIndex = 62,
			Parent = group,
		})
		UIUtil.Corner(avatar, UDim.new(1, 0))
		UIUtil.Stroke(avatar, border, 1.5, 0.5)
		UIUtil.Label({
			Text = email.Avatar,
			Size = UDim2.fromScale(0.7, 0.7),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			MaxTextSize = 26,
			ZIndex = 63,
			Parent = avatar,
		})
		UIUtil.Create("TextLabel", {
			Size = UDim2.new(1, -72, 0, 18),
			Position = UDim2.fromOffset(60, 40),
			BackgroundTransparency = 1,
			Font = Theme.Fonts.Body,
			Text = "De : " .. email.Sender,
			TextColor3 = Theme.Colors.TextDim,
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 62,
			Parent = group,
		})
		UIUtil.Create("TextLabel", {
			Size = UDim2.new(1, -72, 0, 22),
			Position = UDim2.fromOffset(60, 58),
			BackgroundTransparency = 1,
			Font = Theme.Fonts.Title,
			Text = email.Subject,
			TextColor3 = Theme.Colors.TextDark,
			TextSize = 16,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 62,
			Parent = group,
		})
		UIUtil.Create("Frame", {
			Size = UDim2.new(1, -24, 0, 1),
			Position = UDim2.fromOffset(12, 87),
			BackgroundColor3 = Theme.Colors.Disabled,
			BorderSizePixel = 0,
			ZIndex = 62,
			Parent = group,
		})
		UIUtil.Label({
			Text = email.Body,
			Font = Theme.Fonts.Body,
			TextColor3 = Theme.Colors.TextDark,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Size = UDim2.new(1, -24, 0, 56),
			Position = UDim2.fromOffset(12, 93),
			MaxTextSize = 15,
			ZIndex = 62,
			Parent = group,
		})

		-- Boutons
		local replyButton = makeButton(group, "↩️ Répondre", blue, Color3.new(1, 1, 1), UDim2.fromOffset(12, POPUP_H - 38), 136)
		local deleteButton = makeButton(group, "🗑️ Supprimer", Theme.Colors.PanelLight, Theme.Colors.TextDark, UDim2.fromOffset(POPUP_W - 12 - 136, POPUP_H - 38), 136)

		-- Contour (hors du CanvasGroup)
		local outline = UIUtil.Create("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			ZIndex = 67,
			Parent = root,
		})
		UIUtil.Corner(outline, 14)
		local outlineStroke = UIUtil.Stroke(outline, border, 2, 0)

		local current = {
			Root = root,
			Scale = scale,
			Group = group,
			Shadow = shadow,
			Outline = outlineStroke,
			Closed = false,
		}
		popup = current

		UIUtil.Tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)

		local function close()
			closePopup(current)
		end

		ctx.Connect(closeButton.Activated, close)
		ctx.Connect(deleteButton.Activated, function()
			ctx.Sound.Play("Click", 0.8)
			close()
		end)
		ctx.Connect(replyButton.Activated, function()
			if current.Closed then
				return
			end
			ctx.Sound.Play("Mail", 1.3)
			ctx.FloatText(container, UDim2.fromScale(ax, ay), REPLIES[random:NextInteger(1, #REPLIES)], blue, 30)
			close()
		end)
		task.delay(POPUP_AUTO_CLOSE, function()
			if ctx.IsAlive() then
				close()
			end
		end)
	end

	------------------------------------------------------------------
	-- Enveloppes volantes
	------------------------------------------------------------------
	local function line(parent: Instance, a: Vector2, b: Vector2, thickness: number, color: Color3, zIndex: number)
		local delta = b - a
		local middle = (a + b) / 2
		return UIUtil.Create("Frame", {
			Size = UDim2.fromOffset(delta.Magnitude + thickness * 0.5, thickness),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(middle.X, middle.Y),
			Rotation = math.deg(math.atan2(delta.Y, delta.X)),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			ZIndex = zIndex,
			Parent = parent,
		})
	end

	local function removeEnvelope(envelope, opened: boolean)
		if envelope.Done then
			return
		end
		envelope.Done = true
		envelopes[envelope.Id] = nil
		envelopeCount -= 1
		local root = envelope.Root
		if opened then
			UIUtil.Tween(envelope.Scale, 0.25, { Scale = 1.4 }, Enum.EasingStyle.Quad)
			for _, item in ipairs(root:GetDescendants()) do
				if item:IsA("TextLabel") then
					UIUtil.Tween(item, 0.25, { TextTransparency = 1, BackgroundTransparency = 1 })
				elseif item:IsA("Frame") then
					UIUtil.Tween(item, 0.25, { BackgroundTransparency = 1 })
				elseif item:IsA("UIStroke") then
					UIUtil.Tween(item, 0.25, { Transparency = 1 })
				end
			end
		else
			-- Ignorée : elle s'envole vers le haut à gauche
			missed += 1
			UIUtil.Tween(root, 0.8, {
				Position = root.Position + UDim2.new(-0.25, 0, -0.35, 0),
				Rotation = -40,
			}, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			UIUtil.Tween(envelope.Scale, 0.8, { Scale = 0.3 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end
		refreshCounter()
		Debris:AddItem(root, opened and 0.3 or 0.85)
	end

	local function spawnEmail(info)
		if not ctx.IsAlive() or type(info) ~= "table" or type(info.Id) ~= "string" then
			return
		end
		if envelopes[info.Id] or envelopeCount >= MAX_ENVELOPES then
			return
		end
		local email = pick(EMAILS, info.Variant)
		local x = math.clamp(tonumber(info.X) or 0.5, 0.05, 0.95)
		local y = math.clamp(tonumber(info.Y) or 0.5, 0.1, 0.9)
		local lifetime = math.max(2, tonumber(info.Lifetime) or 15)
		local target = UDim2.fromScale(x, y)

		local root = UIUtil.Create("TextButton", {
			Name = "Envelope",
			Size = UDim2.fromOffset(128, 100),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(1.12, math.max(0.05, y - 0.2)),
			Rotation = 25,
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Text = "",
			ZIndex = 30,
			Parent = container,
		})
		local scale = UIUtil.Create("UIScale", { Scale = 0.6, Parent = root })

		-- Corps de l'enveloppe
		local body = UIUtil.Create("Frame", {
			Name = "Body",
			Size = UDim2.fromOffset(ENVELOPE_W, ENVELOPE_H),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0, 40),
			BackgroundColor3 = cream,
			BorderSizePixel = 0,
			ZIndex = 31,
			Parent = root,
		})
		UIUtil.Corner(body, 7)
		UIUtil.Stroke(body, border, 2, 0)
		UIUtil.Gradient(body, ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(235, 235, 235)), 90)

		-- Rabat (un "V" + deux plis du bas)
		local center = Vector2.new(ENVELOPE_W / 2, ENVELOPE_H * 0.56)
		line(body, Vector2.new(3, 3), center, 2, border, 32)
		line(body, Vector2.new(ENVELOPE_W - 3, 3), center, 2, border, 32)
		line(body, Vector2.new(4, ENVELOPE_H - 4), Vector2.new(ENVELOPE_W * 0.38, ENVELOPE_H * 0.62), 1.5, creamDark, 32)
		line(body, Vector2.new(ENVELOPE_W - 4, ENVELOPE_H - 4), Vector2.new(ENVELOPE_W * 0.62, ENVELOPE_H * 0.62), 1.5, creamDark, 32)

		-- Cachet de cire
		local seal = UIUtil.Create("Frame", {
			Name = "Seal",
			Size = UDim2.fromOffset(20, 20),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(center.X, center.Y),
			BackgroundColor3 = Theme.Colors.Red,
			BorderSizePixel = 0,
			ZIndex = 33,
			Parent = body,
		})
		UIUtil.Corner(seal, UDim.new(1, 0))
		UIUtil.Label({
			Text = "@",
			Font = Theme.Fonts.Title,
			TextColor3 = Color3.new(1, 1, 1),
			Size = UDim2.fromScale(0.8, 0.8),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.45),
			MaxTextSize = 14,
			ZIndex = 34,
			Parent = seal,
		})

		-- Pastille rouge "non lu"
		local dot = UIUtil.Label({
			Name = "UnreadDot",
			Text = "1",
			Font = Theme.Fonts.Number,
			TextColor3 = Color3.new(1, 1, 1),
			BackgroundColor3 = Theme.Colors.Red,
			BackgroundTransparency = 0,
			Size = UDim2.fromOffset(22, 22),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, -2, 0, 2),
			MaxTextSize = 14,
			ZIndex = 35,
			Parent = body,
		})
		UIUtil.Corner(dot, UDim.new(1, 0))
		UIUtil.Stroke(dot, Color3.new(1, 1, 1), 2, 0)

		-- Étiquette sous l'enveloppe
		local tag = UIUtil.Label({
			Name = "Tag",
			Text = "📩 " .. email.Sender,
			Font = Theme.Fonts.Title,
			TextColor3 = Theme.Colors.TextDark,
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0,
			Size = UDim2.fromOffset(128, 22),
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 76),
			MaxTextSize = 13,
			ZIndex = 35,
			Parent = root,
		})
		UIUtil.Corner(tag, UDim.new(1, 0))
		UIUtil.Stroke(tag, border, 1.5, 0.2)
		UIUtil.Create("UIPadding", {
			PaddingLeft = UDim.new(0, 6),
			PaddingRight = UDim.new(0, 6),
			Parent = tag,
		})

		local envelope = {
			Id = info.Id,
			Email = email,
			Root = root,
			Scale = scale,
			Body = body,
			Dot = dot,
			Tag = tag,
			Target = target,
			X = x,
			Y = y,
			Born = os.clock(),
			Lifetime = lifetime,
			Phase = random:NextNumber(0, math.pi * 2),
			Hurry = false,
			Done = false,
		}
		envelopes[info.Id] = envelope
		envelopeCount += 1
		refreshCounter()

		-- Arrivée en vol plané
		UIUtil.Tween(root, 0.75, { Position = target, Rotation = 0 }, Enum.EasingStyle.Back)
		UIUtil.Tween(scale, 0.75, { Scale = 1 }, Enum.EasingStyle.Back)
		ctx.Sound.Play("Mail", 1 + random:NextNumber() * 0.15)

		-- Clic : on ouvre le mail
		ctx.Connect(root.Activated, function()
			if envelope.Done or not ctx.IsAlive() then
				return
			end
			local position = root.Position
			positions[envelope.Id] = position
			lastPosition = position
			ctx.ClaimSpawn(envelope.Id)
			ctx.Sound.Play("Mail", 1.4)
			if effectsOn() then
				ctx.Effects.Burst(container, position, blue, 10)
				ctx.Effects.Burst(container, position, nil, 6)
			end
			removeEnvelope(envelope, true)
			openPopup(envelope.Email, envelope.X, envelope.Y)
			local id = envelope.Id
			task.delay(6, function()
				positions[id] = nil
			end)
		end)
	end

	-- Animation de toutes les enveloppes (une seule connexion)
	ctx.OnRender(function()
		if envelopeCount <= 0 then
			return
		end
		local now = os.clock()
		for _, envelope in pairs(envelopes) do
			local age = now - envelope.Born
			local left = envelope.Lifetime - age
			if left <= 0 then
				removeEnvelope(envelope, false)
			else
				local t = now + envelope.Phase
				if left < HURRY_TIME then
					-- Pressée : elle s'agite et l'étiquette vire au rouge
					if not envelope.Hurry then
						envelope.Hurry = true
						envelope.Tag.Text = "📩 Vite, lis-moi !"
						envelope.Tag.BackgroundColor3 = Theme.Colors.Red
						envelope.Tag.TextColor3 = Color3.new(1, 1, 1)
					end
					envelope.Body.Rotation = math.sin(t * 24) * 10
					envelope.Dot.Size = UDim2.fromOffset(22, 22) + UDim2.fromOffset(math.sin(t * 16) * 4, math.sin(t * 16) * 4)
				else
					envelope.Body.Rotation = math.sin(t * 3) * 6
				end
				-- Flotte doucement une fois arrivée
				if age > 0.8 then
					envelope.Root.Position = envelope.Target + UDim2.fromOffset(0, math.sin(t * 2.2) * 5)
				end
			end
		end
	end)

	ctx.OnSpawn("Email", spawnEmail)

	-- Bonus confirmé : "+X" à côté du mail
	ctx.OnBonus("Email", function(payload)
		if not ctx.IsAlive() then
			return
		end
		local position = (payload.SpawnId and positions[payload.SpawnId]) or lastPosition
		ctx.FloatText(container, position, "+" .. ctx.Format.Format(tonumber(payload.Amount) or 0), blue, 40)
	end)
end

function Email.Stop(_ctx)
	-- Enveloppes, fenêtre et compteur vivent dans ctx.Container
	-- (détruit par le StimulusManager)
end

return Email
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">EmojiRain</string>
            <string name="Source"><![CDATA[--[[
	EmojiRain (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > EmojiRain

	Une pluie légère et continue d'emojis qui tombent en tournoyant,
	balancés par un petit vent. Discrète (semi-transparente) et non
	cliquable : on ne bloque jamais les boutons en dessous.
	Les étiquettes sont recyclées (25 maximum, 10 si "Effets" est coupé).
]]

local EmojiRain = {}
EmojiRain.Slot = "Overlay"

local MAX_DROPS = 25
local MAX_DROPS_LOW = 10 -- réglage "Effets" désactivé
local SPAWN_INTERVAL = 0.32
local SPAWN_INTERVAL_LOW = 0.9

local EMOJIS = { "😂", "🔥", "💯", "😍", "🤯", "🎉", "💀", "👀", "✨", "🥳", "🤩", "💖", "🍩", "⭐", "🎈", "😎" }
local RARE = { "🦄", "🌈", "👑", "💎" } -- de temps en temps, plus gros

function EmojiRain.Start(ctx)
	local container: Frame = ctx.Container
	local random = Random.new()

	local pool = {} -- toutes les gouttes (actives ou non)
	local activeCount = 0
	local spawnTimer = 0
	local clock = 0

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	-- Récupère une goutte libre (ou en crée une tant qu'on est sous la limite)
	local function acquire()
		for _, drop in ipairs(pool) do
			if not drop.Active then
				return drop
			end
		end
		if #pool >= MAX_DROPS then
			return nil
		end
		local label = ctx.UIUtil.Create("TextLabel", {
			Name = "Emoji",
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Font = ctx.Theme.Fonts.Body,
			Text = "",
			TextScaled = false,
			Active = false,
			Selectable = false,
			Visible = false,
			ZIndex = 1,
			Parent = container,
		})
		local drop = { Label = label, Active = false }
		table.insert(pool, drop)
		return drop
	end

	local function spawnDrop()
		local limit = effectsOn() and MAX_DROPS or MAX_DROPS_LOW
		if activeCount >= limit then
			return
		end
		local drop = acquire()
		if not drop then
			return
		end
		local rare = random:NextNumber() < 0.04
		local size = rare and random:NextInteger(46, 58) or random:NextInteger(20, 40)
		local label: TextLabel = drop.Label
		label.Text = rare and RARE[random:NextInteger(1, #RARE)] or EMOJIS[random:NextInteger(1, #EMOJIS)]
		label.TextSize = size
		label.Size = UDim2.fromOffset(size + 6, size + 6)
		label.TextTransparency = rare and 0.15 or random:NextNumber(0.2, 0.5)
		label.Rotation = random:NextNumber(-30, 30)
		label.Visible = true

		drop.Active = true
		drop.X = random:NextNumber(0.02, 0.98)
		drop.Y = -0.06
		-- Les gros tombent plus vite (effet de profondeur)
		drop.Speed = (0.05 + size / 400) * random:NextNumber(0.85, 1.15)
		drop.Spin = random:NextNumber(-80, 80)
		drop.SwayAmp = random:NextNumber(0.004, 0.018)
		drop.SwayFreq = random:NextNumber(1, 2.5)
		drop.Phase = random:NextNumber(0, math.pi * 2)
		activeCount += 1
	end

	ctx.OnRender(function(dt: number)
		dt = math.min(dt, 0.1)
		clock += dt

		-- Nouvelles gouttes
		spawnTimer -= dt
		if spawnTimer <= 0 then
			spawnTimer = effectsOn() and SPAWN_INTERVAL or SPAWN_INTERVAL_LOW
			spawnDrop()
		end

		-- Petit vent qui change lentement de sens
		local wind = math.sin(clock * 0.25) * 0.012

		for _, drop in ipairs(pool) do
			if drop.Active then
				drop.Y += drop.Speed * dt
				drop.X += wind * dt
				local label: TextLabel = drop.Label
				if drop.Y > 1.08 or drop.X < -0.05 or drop.X > 1.05 then
					drop.Active = false
					label.Visible = false
					activeCount -= 1
				else
					local sway = math.sin(clock * drop.SwayFreq + drop.Phase) * drop.SwayAmp
					label.Position = UDim2.fromScale(drop.X + sway, drop.Y)
					label.Rotation += drop.Spin * dt
				end
			end
		end
	end)
end

function EmojiRain.Stop(_ctx)
	-- Les étiquettes sont dans ctx.Container (détruit par le StimulusManager)
end

return EmojiRain
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">GoldenStar</string>
            <string name="Source"><![CDATA[--[[
	GoldenStar (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > GoldenStar

	Étoiles dorées qui apparaissent au hasard (décidé par le SERVEUR via
	l'événement Spawn "Golden") : halo qui pulse, rayons qui tournent,
	petites étincelles en orbite... et elles s'en vont vite !
	Un clic = ClaimSpawn (le serveur vérifie puis envoie le bonus), et le
	bonus confirmé s'affiche en gros "+X" doré à l'endroit de l'étoile.
]]

local Debris = game:GetService("Debris")

local GoldenStar = {}
GoldenStar.Slot = "Overlay"

local MAX_STARS = 5
local RAY_COUNT = 6
local WARNING_TIME = 1.5 -- dernières secondes : l'étoile s'impatiente

local TAGS = { "vite !!", "attrape-moi", "clique ici ✨", "je brille !", "c'est moi 🌟", "par ici !" }
local HURRY_TAGS = { "trop tard ?", "je pars !", "bye bye...", "dépêche !" }
local CHEERS = { "QUELLE CHANCE !", "ÉTOILE ATTRAPÉE !", "DORÉ !!!", "BRILLANT !", "RÉFLEXES DE CHAT !" }

function GoldenStar.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local container: Frame = ctx.Container
	local random = Random.new()

	local stars = {} -- [id] = étoile active
	local count = 0
	local positions = {} -- [id] = UDim2 (pour placer le "+X" du bonus)
	local lastPosition = UDim2.fromScale(0.5, 0.45)

	local gold = Theme.Colors.Gold
	local orange = Theme.Colors.Orange

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	-- Fait disparaître tous les éléments visuels d'une étoile
	local function fadeAll(root: Instance, duration: number)
		for _, item in ipairs(root:GetDescendants()) do
			if item:IsA("TextLabel") then
				UIUtil.Tween(item, duration, { TextTransparency = 1, BackgroundTransparency = 1 })
			elseif item:IsA("Frame") then
				UIUtil.Tween(item, duration, { BackgroundTransparency = 1 })
			elseif item:IsA("UIStroke") then
				UIUtil.Tween(item, duration, { Transparency = 1 })
			end
		end
	end

	local function removeStar(star, popped: boolean)
		if star.Done then
			return
		end
		star.Done = true
		stars[star.Id] = nil
		count -= 1
		local scale = star.Scale
		if popped then
			UIUtil.Tween(scale, 0.3, { Scale = 1.8 }, Enum.EasingStyle.Quad)
			fadeAll(star.Button, 0.3)
		else
			UIUtil.Tween(scale, 0.35, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		end
		Debris:AddItem(star.Button, 0.4)
	end

	local function spawnStar(info)
		if not ctx.IsAlive() or type(info) ~= "table" or info.Id == nil then
			return
		end
		if stars[info.Id] or count >= MAX_STARS then
			return
		end
		local x = math.clamp(tonumber(info.X) or 0.5, 0.05, 0.95)
		local y = math.clamp(tonumber(info.Y) or 0.5, 0.08, 0.92)
		local lifetime = math.max(1, tonumber(info.Lifetime) or 6)
		local basePosition = UDim2.fromScale(x, y)

		-- Bouton principal (zone cliquable généreuse pour le tactile)
		local button = UIUtil.Create("TextButton", {
			Name = "GoldenStar",
			Size = UDim2.fromOffset(100, 100),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = basePosition,
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			ZIndex = 20,
			Parent = container,
		})
		local scale = UIUtil.Create("UIScale", { Scale = 0, Parent = button })

		-- Halo (cercles concentriques de plus en plus transparents)
		local halo = UIUtil.Create("Frame", {
			Name = "Halo",
			Size = UDim2.fromOffset(180, 180),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			BackgroundTransparency = 1,
			ZIndex = 20,
			Parent = button,
		})
		local haloScale = UIUtil.Create("UIScale", { Parent = halo })
		for i, spec in ipairs({ { 1, 0.88 }, { 0.75, 0.78 }, { 0.55, 0.62 } }) do
			local ring = UIUtil.Create("Frame", {
				Size = UDim2.fromScale(spec[1], spec[1]),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				BackgroundColor3 = i == 3 and Theme.Colors.Yellow or gold,
				BackgroundTransparency = spec[2],
				ZIndex = 20,
				Parent = halo,
			})
			UIUtil.Corner(ring, UDim.new(1, 0))
		end

		-- Rayons qui tournent
		local rays = {}
		for i = 1, RAY_COUNT do
			local ray = UIUtil.Create("Frame", {
				Size = UDim2.fromOffset(200, 8),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				BackgroundColor3 = Theme.Colors.Yellow,
				BackgroundTransparency = 0.2,
				Rotation = (i - 1) * (180 / RAY_COUNT),
				ZIndex = 21,
				Parent = button,
			})
			UIUtil.Corner(ray, UDim.new(1, 0))
			UIUtil.Create("UIGradient", {
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1),
					NumberSequenceKeypoint.new(0.35, 0.55),
					NumberSequenceKeypoint.new(0.5, 0.3),
					NumberSequenceKeypoint.new(0.65, 0.55),
					NumberSequenceKeypoint.new(1, 1),
				}),
				Parent = ray,
			})
			rays[i] = ray
		end

		-- Médaillon doré
		local disc = UIUtil.Create("Frame", {
			Name = "Disc",
			Size = UDim2.fromOffset(78, 78),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			BackgroundColor3 = Color3.new(1, 1, 1),
			ZIndex = 22,
			Parent = button,
		})
		UIUtil.Corner(disc, UDim.new(1, 0))
		local discStroke = UIUtil.Stroke(disc, Color3.new(1, 1, 1), 3, 0)
		local discGradient = UIUtil.Gradient(disc, ColorSequence.new({
			ColorSequenceKeypoint.new(0, Theme.Colors.Yellow),
			ColorSequenceKeypoint.new(0.5, gold),
			ColorSequenceKeypoint.new(1, orange),
		}), 45)
		UIUtil.Label({
			Text = "🌟",
			Size = UDim2.fromScale(0.78, 0.78),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			MaxTextSize = 56,
			ZIndex = 23,
			Parent = disc,
		})

		-- Étincelles en orbite
		local sparkles = {}
		for i = 1, 2 do
			sparkles[i] = UIUtil.Label({
				Text = "✨",
				Size = UDim2.fromOffset(26, 26),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				MaxTextSize = 24,
				ZIndex = 24,
				Parent = button,
			})
		end

		-- Petite étiquette "vite !!"
		local tag = UIUtil.Label({
			Text = TAGS[random:NextInteger(1, #TAGS)],
			Font = Theme.Fonts.Title,
			TextColor3 = Theme.Colors.TextDark,
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0,
			Size = UDim2.fromOffset(104, 24),
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 1, 4),
			MaxTextSize = 17,
			ZIndex = 25,
			Parent = button,
		})
		UIUtil.Corner(tag, UDim.new(1, 0))
		UIUtil.Stroke(tag, Theme.Colors.Border, 1.5, 0.1)

		local star = {
			Id = info.Id,
			Button = button,
			Scale = scale,
			HaloScale = haloScale,
			Rays = rays,
			Disc = disc,
			DiscStroke = discStroke,
			DiscGradient = discGradient,
			Sparkles = sparkles,
			Tag = tag,
			Base = basePosition,
			Born = os.clock(),
			Lifetime = lifetime,
			Phase = random:NextNumber(0, math.pi * 2),
			Hurry = false,
			Done = false,
		}
		stars[info.Id] = star
		count += 1

		-- Apparition
		UIUtil.Tween(scale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
		ctx.Sound.Play("Golden", 1.4)

		-- Clic : on réclame l'étoile au serveur
		ctx.Connect(button.Activated, function()
			if star.Done or not ctx.IsAlive() then
				return
			end
			local position = button.Position
			positions[star.Id] = position
			lastPosition = position
			ctx.ClaimSpawn(star.Id)
			ctx.Sound.Play("Golden", 1.8)
			if effectsOn() then
				ctx.Effects.Burst(container, position, gold, 24)
				ctx.Effects.Burst(container, position, nil, 12)
				ctx.Effects.Flash(Theme.Colors.Yellow, 0.2)
			end
			removeStar(star, true)
			-- On oublie la position après un moment
			task.delay(6, function()
				positions[star.Id] = nil
			end)
		end)
	end

	-- Animation de toutes les étoiles (une seule connexion)
	ctx.OnRender(function()
		local now = os.clock()
		for _, star in pairs(stars) do
			local age = now - star.Born
			local left = star.Lifetime - age
			if left <= 0 then
				removeStar(star, false)
			else
				local t = now + star.Phase
				-- Flotte doucement
				star.Button.Position = star.Base + UDim2.fromOffset(math.sin(t * 1.3) * 10, math.cos(t * 1.7) * 8)
				-- Halo qui respire
				star.HaloScale.Scale = 1 + math.sin(t * 5) * 0.1
				-- Rayons qui tournent
				local spin = t * 45
				for i, ray in ipairs(star.Rays) do
					ray.Rotation = spin + (i - 1) * (180 / RAY_COUNT)
				end
				star.DiscGradient.Rotation = (t * 120) % 360
				-- Étincelles en orbite
				for i, sparkle in ipairs(star.Sparkles) do
					local angle = t * 3 + i * math.pi
					sparkle.Position = UDim2.new(0.5, math.cos(angle) * 56, 0.5, math.sin(angle) * 48)
				end
				-- Pulsation (après l'apparition)
				if age > 0.45 then
					if left < WARNING_TIME then
						-- Pressée de partir : tremble et clignote
						if not star.Hurry then
							star.Hurry = true
							star.Tag.Text = HURRY_TAGS[random:NextInteger(1, #HURRY_TAGS)]
							star.Tag.BackgroundColor3 = Theme.Colors.Red
							star.Tag.TextColor3 = Theme.Colors.TextLight
						end
						star.Scale.Scale = 1 + math.sin(t * 22) * 0.07
						star.Disc.Rotation = math.sin(t * 30) * 12
						star.DiscStroke.Color = (math.floor(now * 8) % 2 == 0) and Theme.Colors.Red or Color3.new(1, 1, 1)
					else
						star.Scale.Scale = 1 + math.sin(t * 9) * 0.06
						star.Disc.Rotation = math.sin(t * 3) * 12
					end
				end
			end
		end
	end)

	ctx.OnSpawn("Golden", spawnStar)

	-- Bonus confirmé : gros "+X" doré
	ctx.OnBonus("Golden", function(payload)
		if not ctx.IsAlive() then
			return
		end
		local position = (payload.SpawnId and positions[payload.SpawnId]) or lastPosition
		ctx.FloatText(container, position, "+" .. ctx.Format.Format(tonumber(payload.Amount) or 0), gold, 60)
		ctx.FloatText(container, position + UDim2.fromOffset(0, 50), CHEERS[random:NextInteger(1, #CHEERS)], orange, 26)
	end)
end

function GoldenStar.Stop(_ctx)
	-- Les étoiles vivent dans ctx.Container (détruit par le StimulusManager)
end

return GoldenStar
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">LiveStream</string>
            <string name="Source"><![CDATA[--[[
	LiveStream (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > LiveStream

	Faux live "ASMR mukbang" (slot L1, 288x190) : badge "🔴 EN DIRECT",
	compteur de spectateurs (qui grimpe avec l'amélioration "Abonnés"),
	un gourmand 😋 qui mange une assiette d'emojis un par un avec des
	"CRUNCH !" / "MIAM" qui éclatent, des miettes, des cœurs qui montent,
	et un bouton "Suivre" pour le plaisir.

	Avec la Feature "LiveChat", une colonne de chat apparaît à droite :
	pseudos rigolos, messages absurdes, dons... plus il y a d'abonnés,
	plus le chat s'emballe.

	Purement visuel : aucune récompense ici (la production est dans la
	Dopamine par seconde).
]]

local Debris = game:GetService("Debris")

local LiveStream = {}
LiveStream.Slot = "L1"

-- Disposition (pixels "design", carte rentrée de 2 px)
local CARD_W, CARD_H = 284, 186
local VIDEO_X, VIDEO_Y = 6, 6
local VIDEO_H = 146
local CHAT_W = 100
local GAP = 4
local TABLE_Y = 110 -- haut de la table dans la vidéo
local PLATE_Y = 116
local MOUTH_Y = 84
local MAX_CHAT = 10
local MAX_HEARTS = 6

local FOODS = { "🥪", "🍟", "🍔", "🌭", "🍕", "🥓", "🍗", "🌮", "🍩", "🥐", "🍪", "🌯" }
local FOOD_OFFSETS = { -44, -22, 0, 22, 44 }

local CRUNCH_WORDS = { "CRUNCH !", "MIAM", "CROC !", "*crounch*", "SLURP", "CRAC !", "NOM NOM", "CRISP !", "MMMH", "SCROUNCH" }
local CRUNCH_COLORS = {
	Color3.fromRGB(255, 214, 40),
	Color3.fromRGB(255, 80, 150),
	Color3.fromRGB(0, 210, 255),
	Color3.fromRGB(255, 255, 255),
	Color3.fromRGB(130, 255, 120),
}

local HEARTS = { "❤️", "💜", "💖", "😍", "🔥", "👏" }

local NAMES = {
	"Kevin_du_75", "xX_Nugget_Xx", "Mamie_Gaming", "LeChatDuVoisin", "BaguetteMan", "Tartiflette99",
	"MrPatate", "Choupette", "DarkSasuke42", "Poulet_Braisé", "Zinzin_78", "Croquette", "SushiLover",
	"Tonton_Jean", "Lulu_ASMR", "PatateDouce", "Bichon_Fou", "Crêpe_Party", "Moustache_Pro",
	"Raclette4Life", "Gratin2Pâtes", "Ninja_du_Dimanche", "Fromage_Fou", "LaTeteDansLeFrigo",
}
local NAME_COLORS = { "#FF6B9A", "#6BD5FF", "#FFD34D", "#9DFF6B", "#C38BFF", "#FF9F45", "#5CFFD1" }

local MESSAGES = {
	"W", "+1", "incroyable", "🔥🔥", "c'est quoi ce live", "le crunch était parfait", "encore !!",
	"j'ai faim maintenant", "il mange à 3h du mat ?", "premier", "ASMR de qualité", "MIAM",
	"c'est tellement satisfaisant", "je regarde au lieu de réviser", "mdr", "😭😭", "le son 🤤",
	"abonné !", "maman si tu vois ça coucou", "il a même pas mâché", "CRUNCH", "trop bien", "respect",
	"et la sauce ??", "GG", "🥪🥪🥪", "qui est là depuis le début ?", "j'ai lâché mon goûter",
	"5 étoiles", "mon moment préféré", "L", "il va finir l'assiette ??", "trop fort le monsieur",
	"je suis au régime 😭", "le micro 😳", "c'est l'heure du goûter", "on veut des frites !", "👀",
	"j'entends le crunch d'ici", "reviens manger chez moi", "ratio", "💯", "je m'endors 😴",
}
local REACTIONS = { "CRUNCH 🔥", "le son 🤤🤤", "OUIIII", "MIAM", "encore une !", "🔥🔥🔥", "W crunch" }
local DONATION_AMOUNTS = { 5, 10, 20, 50, 100, 500 }

function LiveStream.Start(ctx)
	local UI = ctx.UIUtil
	local Theme = ctx.Theme
	local Format = ctx.Format
	local random = Random.new()

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	local function followers(): number
		return ctx.GetLevel("Followers") or 0
	end

	local function hasChat(): boolean
		return ctx.HasFeature("LiveChat") == true
	end

	------------------------------------------------------------------
	-- Carte
	------------------------------------------------------------------
	local card = UI.Create("Frame", {
		Name = "Card",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -4, 1, -4),
		BackgroundColor3 = Color3.fromRGB(24, 21, 32),
		BorderSizePixel = 0,
		Parent = ctx.Container,
	})
	UI.Corner(card, 14)
	UI.Stroke(card, Theme.Colors.CardBorder, 2)

	local function videoWidth(chat: boolean): number
		if chat then
			return CARD_W - VIDEO_X * 2 - CHAT_W - GAP
		end
		return CARD_W - VIDEO_X * 2
	end

	------------------------------------------------------------------
	-- Vidéo
	------------------------------------------------------------------
	local video = UI.Create("Frame", {
		Name = "Video",
		Position = UDim2.fromOffset(VIDEO_X, VIDEO_Y),
		Size = UDim2.fromOffset(videoWidth(hasChat()), VIDEO_H),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = card,
	})
	UI.Corner(video, 10)
	UI.Gradient(video, ColorSequence.new(Color3.fromRGB(255, 222, 186), Color3.fromRGB(255, 160, 118)), 90)

	-- Guirlande lumineuse en haut du mur
	local bulbs: { Frame } = {}
	local BULB_COLORS = {
		Color3.fromRGB(255, 90, 120),
		Color3.fromRGB(255, 210, 60),
		Color3.fromRGB(90, 220, 255),
		Color3.fromRGB(150, 255, 120),
		Color3.fromRGB(200, 120, 255),
	}
	for i = 1, 9 do
		local x = (i - 0.5) / 9
		local bulb = UI.Create("Frame", {
			Name = "Bulb",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(x, 0, 0, 30 + math.sin(x * math.pi) * 6),
			Size = UDim2.fromOffset(6, 6),
			BackgroundColor3 = BULB_COLORS[(i - 1) % #BULB_COLORS + 1],
			BorderSizePixel = 0,
			ZIndex = 1,
			Parent = video,
		})
		UI.Corner(bulb, UDim.new(1, 0))
		table.insert(bulbs, bulb)
	end

	-- Enseigne néon "MIAM" sur le mur
	local neonSign = UI.Label({
		Name = "Neon",
		Text = "MIAM ✨",
		Font = Theme.Fonts.Title,
		TextColor3 = Color3.fromRGB(255, 70, 160),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 40),
		Size = UDim2.fromOffset(60, 16),
		MaxTextSize = 14,
		Rotation = 6,
		ZIndex = 1,
		Parent = video,
	})
	local neonStroke = UI.Stroke(neonSign, Color3.fromRGB(255, 190, 230), 1.5, 0.3)
	neonStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual

	-- Le gourmand (derrière la table)
	local face = UI.Create("TextLabel", {
		Name = "Face",
		Text = "😋",
		TextSize = 58,
		Font = Theme.Fonts.Body,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0, TABLE_Y + 16),
		Size = UDim2.fromOffset(70, 70),
		ZIndex = 2,
		Parent = video,
	})

	-- Table
	local tableFrame = UI.Create("Frame", {
		Name = "Table",
		Position = UDim2.fromOffset(0, TABLE_Y),
		Size = UDim2.new(1, 0, 0, VIDEO_H - TABLE_Y),
		BackgroundColor3 = Color3.fromRGB(150, 96, 62),
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = video,
	})
	UI.Create("Frame", {
		Name = "Edge",
		Size = UDim2.new(1, 0, 0, 4),
		BackgroundColor3 = Color3.fromRGB(186, 128, 84),
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = tableFrame,
	})

	-- Micro ASMR
	UI.Create("TextLabel", {
		Name = "Mic",
		Text = "🎙️",
		TextSize = 26,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.13, 0, 0, TABLE_Y + 8),
		Size = UDim2.fromOffset(30, 30),
		ZIndex = 5,
		Parent = video,
	})

	-- Assiette
	local plate = UI.Create("Frame", {
		Name = "Plate",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, PLATE_Y),
		Size = UDim2.fromOffset(122, 22),
		BackgroundColor3 = Color3.fromRGB(252, 252, 252),
		BorderSizePixel = 0,
		ZIndex = 4,
		Parent = video,
	})
	UI.Corner(plate, UDim.new(1, 0))
	UI.Stroke(plate, Color3.fromRGB(190, 190, 200), 1.5)
	local rim = UI.Create("Frame", {
		Name = "Rim",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -24, 1, -8),
		BackgroundColor3 = Color3.fromRGB(236, 236, 242),
		BorderSizePixel = 0,
		ZIndex = 4,
		Parent = plate,
	})
	UI.Corner(rim, UDim.new(1, 0))

	-- Aliments (réutilisés à chaque nouvelle assiette)
	local foods: { TextLabel } = {}
	local foodScales: { UIScale } = {}
	local function foodHome(index: number): UDim2
		return UDim2.new(0.5, FOOD_OFFSETS[index], 0, PLATE_Y - 6)
	end
	for i = 1, #FOOD_OFFSETS do
		local food = UI.Create("TextLabel", {
			Name = "Food",
			Text = FOODS[random:NextInteger(1, #FOODS)],
			TextSize = 26,
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = foodHome(i),
			Size = UDim2.fromOffset(30, 30),
			Rotation = random:NextNumber(-12, 12),
			ZIndex = 5 + i % 2,
			Parent = video,
		})
		foods[i] = food
		foodScales[i] = UI.Create("UIScale", { Parent = food })
	end

	-- Bandeau "EN DIRECT" + spectateurs
	local liveBadge = UI.Create("TextLabel", {
		Name = "Live",
		Text = "🔴 EN DIRECT",
		Font = Theme.Fonts.Title,
		TextSize = 11,
		TextColor3 = Color3.new(1, 1, 1),
		BackgroundColor3 = Color3.fromRGB(230, 30, 45),
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 18),
		Position = UDim2.fromOffset(6, 6),
		BorderSizePixel = 0,
		ZIndex = 8,
		Parent = video,
	})
	UI.Corner(liveBadge, 5)
	UI.Create("UIPadding", { PaddingLeft = UDim.new(0, 5), PaddingRight = UDim.new(0, 6), Parent = liveBadge })
	local liveScale = UI.Create("UIScale", { Parent = liveBadge })

	local viewersLabel = UI.Create("TextLabel", {
		Name = "Viewers",
		Text = "👁 0",
		Font = Theme.Fonts.Number,
		TextSize = 11,
		TextColor3 = Color3.new(1, 1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 18),
		Position = UDim2.fromOffset(94, 6),
		BorderSizePixel = 0,
		ZIndex = 8,
		Parent = video,
	})
	UI.Corner(viewersLabel, 5)
	UI.Create("UIPadding", { PaddingLeft = UDim.new(0, 5), PaddingRight = UDim.new(0, 6), Parent = viewersLabel })

	-- Réserve de mots "CRUNCH" (réutilisés)
	local popLabels: { TextLabel } = {}
	local popIndex = 0
	for i = 1, 3 do
		local label = UI.Create("TextLabel", {
			Name = "Pop" .. i,
			Text = "",
			Font = Theme.Fonts.Title,
			TextSize = 20,
			TextColor3 = Color3.new(1, 1, 1),
			TextTransparency = 1,
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(110, 26),
			ZIndex = 9,
			Parent = video,
		})
		local stroke = UI.Stroke(label, Color3.fromRGB(40, 20, 30), 2, 1)
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		UI.Create("UIScale", { Parent = label })
		popLabels[i] = label
	end

	local function popWord(text: string?)
		popIndex = popIndex % #popLabels + 1
		local label = popLabels[popIndex]
		local stroke = label:FindFirstChildOfClass("UIStroke")
		local scale = label:FindFirstChildOfClass("UIScale")
		local side = random:NextNumber() < 0.5 and -1 or 1
		local start = UDim2.new(0.5, side * random:NextInteger(28, 46), 0, MOUTH_Y - 8)
		label.Text = text or CRUNCH_WORDS[random:NextInteger(1, #CRUNCH_WORDS)]
		label.TextColor3 = CRUNCH_COLORS[random:NextInteger(1, #CRUNCH_COLORS)]
		label.Position = start
		label.Rotation = random:NextNumber(-16, 16)
		label.TextTransparency = 0
		if stroke then
			stroke.Transparency = 0
			UI.Tween(stroke, 0.5, { Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end
		if scale then
			scale.Scale = 0.3
			UI.Tween(scale, 0.22, { Scale = 1.15 }, Enum.EasingStyle.Back)
		end
		UI.Tween(label, 0.75, {
			Position = start + UDim2.fromOffset(side * 12, -26),
			TextTransparency = 1,
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end

	-- Miettes (petits carrés qui tombent, détruits automatiquement)
	local function crumbs()
		if not effectsOn() then
			return
		end
		for _ = 1, 4 do
			local size = random:NextInteger(3, 5)
			local crumb = UI.Create("Frame", {
				Name = "Crumb",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0.5, random:NextInteger(-8, 8), 0, MOUTH_Y + 4),
				Size = UDim2.fromOffset(size, size),
				BackgroundColor3 = Color3.fromRGB(220, 160, 80),
				BorderSizePixel = 0,
				Rotation = random:NextNumber(0, 90),
				ZIndex = 7,
				Parent = video,
			})
			UI.Tween(crumb, 0.55, {
				Position = UDim2.new(0.5, random:NextInteger(-36, 36), 0, PLATE_Y - 4),
				Rotation = random:NextNumber(90, 360),
				BackgroundTransparency = 0.3,
			}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			Debris:AddItem(crumb, 0.6)
		end
	end

	-- Cœurs qui montent (réserve réutilisée)
	local hearts: { { Label: TextLabel, Start: number, Life: number, X: number, Sway: number } } = {}
	for i = 1, MAX_HEARTS do
		local label = UI.Create("TextLabel", {
			Name = "Heart" .. i,
			Text = "❤️",
			TextSize = 16,
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(20, 20),
			Visible = false,
			ZIndex = 8,
			Parent = video,
		})
		hearts[i] = { Label = label, Start = -math.huge, Life = 1.6, X = 0, Sway = 0 }
	end
	local function spawnHeart(emoji: string?)
		for _, heart in ipairs(hearts) do
			if not heart.Label.Visible then
				heart.Label.Text = emoji or HEARTS[random:NextInteger(1, #HEARTS)]
				heart.Start = os.clock()
				heart.Life = random:NextNumber(1.3, 2)
				heart.X = random:NextNumber(-14, 4)
				heart.Sway = random:NextNumber(0, math.pi * 2)
				heart.Label.Visible = true
				return
			end
		end
	end

	------------------------------------------------------------------
	-- Barre d'infos sous la vidéo : avatar, pseudo, bouton "Suivre"
	------------------------------------------------------------------
	local infoBar = UI.Create("Frame", {
		Name = "Info",
		Position = UDim2.fromOffset(VIDEO_X, VIDEO_Y + VIDEO_H + 4),
		Size = UDim2.new(1, -VIDEO_X * 2, 0, CARD_H - VIDEO_Y - VIDEO_H - 8),
		BackgroundTransparency = 1,
		Parent = card,
	})
	local avatar = UI.Create("TextLabel", {
		Name = "Avatar",
		Text = "🍔",
		TextSize = 14,
		BackgroundColor3 = Color3.fromRGB(255, 200, 90),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(22, 22),
		BorderSizePixel = 0,
		Parent = infoBar,
	})
	UI.Corner(avatar, UDim.new(1, 0))
	UI.Stroke(avatar, Color3.fromRGB(145, 70, 255), 1.5)
	UI.Label({
		Name = "Streamer",
		Text = '<b>MangeTout_ASMR</b> <font color="#A8A2C0">· mukbang</font>',
		RichText = true,
		TextColor3 = Color3.new(1, 1, 1),
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(28, 2),
		Size = UDim2.new(1, -110, 1, -4),
		MaxTextSize = 12,
		Parent = infoBar,
	})
	local followButton = UI.Create("TextButton", {
		Name = "Follow",
		Text = "❤️ Suivre",
		Font = Theme.Fonts.Title,
		TextSize = 12,
		TextColor3 = Color3.new(1, 1, 1),
		BackgroundColor3 = Color3.fromRGB(145, 70, 255),
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.fromOffset(76, 20),
		BorderSizePixel = 0,
		Parent = infoBar,
	})
	UI.Corner(followButton, UDim.new(1, 0))
	UI.AnimateButton(followButton, 1.06, 0.9)

	------------------------------------------------------------------
	-- Chat (Feature "LiveChat")
	------------------------------------------------------------------
	local chat = UI.Create("Frame", {
		Name = "Chat",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -VIDEO_X, 0, VIDEO_Y),
		Size = UDim2.fromOffset(CHAT_W, VIDEO_H),
		BackgroundColor3 = Color3.fromRGB(34, 30, 46),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Visible = hasChat(),
		Parent = card,
	})
	UI.Corner(chat, 10)
	UI.Label({
		Name = "Header",
		Text = "💬 CHAT",
		Font = Theme.Fonts.Title,
		TextColor3 = Color3.fromRGB(200, 190, 230),
		Position = UDim2.fromOffset(0, 2),
		Size = UDim2.new(1, 0, 0, 14),
		MaxTextSize = 11,
		ZIndex = 3,
		Parent = chat,
	})
	UI.Create("Frame", {
		Name = "HeaderLine",
		Position = UDim2.fromOffset(6, 17),
		Size = UDim2.new(1, -12, 0, 1),
		BackgroundColor3 = Color3.fromRGB(80, 70, 110),
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = chat,
	})
	local chatList = UI.Create("Frame", {
		Name = "Messages",
		Position = UDim2.fromOffset(0, 19),
		Size = UDim2.new(1, 0, 1, -21),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Parent = chat,
	})
	UI.Create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		Padding = UDim.new(0, 2),
		Parent = chatList,
	})
	UI.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 4),
		PaddingRight = UDim.new(0, 3),
		PaddingBottom = UDim.new(0, 2),
		Parent = chatList,
	})

	local chatMessages: { TextLabel } = {}
	local chatOrder = 0

	local function escape(text: string): string
		text = string.gsub(text, "&", "&amp;")
		text = string.gsub(text, "<", "&lt;")
		text = string.gsub(text, ">", "&gt;")
		return text
	end

	local function pushChat(name: string, message: string, highlight: Color3?)
		if not chat.Visible then
			return
		end
		chatOrder += 1
		local color = NAME_COLORS[random:NextInteger(1, #NAME_COLORS)]
		local label = UI.Create("TextLabel", {
			Name = "Msg",
			Text = '<font color="' .. color .. '"><b>' .. escape(name) .. "</b></font> " .. escape(message),
			RichText = true,
			Font = Theme.Fonts.Body,
			TextSize = 11,
			TextColor3 = Color3.new(1, 1, 1),
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTransparency = 1,
			BackgroundColor3 = highlight or Color3.new(0, 0, 0),
			BackgroundTransparency = highlight and 0.55 or 1,
			BorderSizePixel = 0,
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.new(1, 0, 0, 0),
			LayoutOrder = chatOrder,
			Parent = chatList,
		})
		if highlight then
			UI.Corner(label, 4)
		end
		UI.Tween(label, 0.2, { TextTransparency = 0 })
		table.insert(chatMessages, label)
		while #chatMessages > MAX_CHAT do
			local old = table.remove(chatMessages, 1)
			if old then
				old:Destroy()
			end
		end
	end

	local function randomName(): string
		return NAMES[random:NextInteger(1, #NAMES)]
	end

	local function randomChat()
		local roll = random:NextNumber()
		if roll < 0.06 then
			local amount = DONATION_AMOUNTS[random:NextInteger(1, #DONATION_AMOUNTS)]
			pushChat("💸 " .. randomName(), "a donné " .. amount .. " Dopamine !", Color3.fromRGB(255, 190, 0))
			spawnHeart("💸")
		else
			pushChat(randomName(), MESSAGES[random:NextInteger(1, #MESSAGES)])
		end
	end

	-- Affiche / cache le chat quand la Feature change
	local chatShown = chat.Visible
	local function applyChatVisibility()
		local shown = hasChat()
		if shown == chatShown then
			return
		end
		chatShown = shown
		UI.Tween(video, 0.35, { Size = UDim2.fromOffset(videoWidth(shown), VIDEO_H) }, Enum.EasingStyle.Back)
		if shown then
			chat.Visible = true
			chat.Position = UDim2.new(1, CHAT_W, 0, VIDEO_Y)
			UI.Tween(chat, 0.35, { Position = UDim2.new(1, -VIDEO_X, 0, VIDEO_Y) }, Enum.EasingStyle.Back)
			pushChat("MangeTout_ASMR", "le chat est ouvert !! 🎉", Color3.fromRGB(145, 70, 255))
		else
			chat.Visible = false
		end
	end
	ctx.Connect(ctx.State.FeaturesChanged, applyChatVisibility)

	------------------------------------------------------------------
	-- Spectateurs : grimpent avec le niveau "Abonnés"
	------------------------------------------------------------------
	local function targetViewers(): number
		local base = 40 * (1.9 ^ followers())
		if hasChat() then
			base *= 1.5
		end
		return base
	end
	local viewers = targetViewers() * random:NextNumber(0.9, 1.1)
	local shownViewers = viewers

	local function formatViewers(value: number): string
		if value < 1e5 then
			return Format.WithSpaces(value)
		end
		return Format.Format(value)
	end

	------------------------------------------------------------------
	-- Bouton "Suivre" (juste pour le plaisir)
	------------------------------------------------------------------
	local followLock = false
	ctx.Connect(followButton.Activated, function()
		if followLock then
			return
		end
		followLock = true
		ctx.Sound.Play("Pop", 1.3)
		followButton.Text = "✅ Suivi !"
		followButton.BackgroundColor3 = Color3.fromRGB(70, 60, 90)
		for _ = 1, 4 do
			spawnHeart("💜")
		end
		viewers += 1
		pushChat("MangeTout_ASMR", "merci pour le follow !! 💜", Color3.fromRGB(145, 70, 255))
		task.delay(3, function()
			if ctx.IsAlive() and followButton.Parent then
				followButton.Text = "❤️ Suivre"
				followButton.BackgroundColor3 = Color3.fromRGB(145, 70, 255)
			end
			followLock = false
		end)
	end)

	------------------------------------------------------------------
	-- Animation continue
	------------------------------------------------------------------
	local clock = 0
	local chewUntil = 0
	local nextHeart = 0.5
	local viewersTimer = 0
	ctx.OnRender(function(dt: number)
		clock += dt
		local now = os.clock()

		-- Tête : balancement tranquille, ou mastication rapide
		local chewing = now < chewUntil
		if chewing then
			face.Position = UDim2.new(0.5, 0, 0, TABLE_Y + 16 + math.abs(math.sin(clock * 18)) * 3)
			face.Rotation = math.sin(clock * 14) * 6
		else
			face.Position = UDim2.new(0.5, 0, 0, TABLE_Y + 16 + math.sin(clock * 2) * 2)
			face.Rotation = math.sin(clock * 1.3) * 3
		end

		-- Badge "EN DIRECT" qui pulse, guirlande qui clignote, néon qui grésille
		liveScale.Scale = 1 + math.max(0, math.sin(clock * 4)) * 0.06
		for i, bulb in ipairs(bulbs) do
			bulb.BackgroundTransparency = 0.15 + 0.6 * (0.5 + 0.5 * math.sin(clock * 3 + i * 1.7))
		end
		neonSign.TextTransparency = (math.sin(clock * 23) > 0.93) and 0.6 or 0

		-- Cœurs
		for _, heart in ipairs(hearts) do
			local label = heart.Label
			if label.Visible then
				local t = (now - heart.Start) / heart.Life
				if t >= 1 then
					label.Visible = false
				else
					label.Position = UDim2.new(1, -18 + heart.X + math.sin(heart.Sway + t * 6) * 6, 0, TABLE_Y - 4 - t * 80)
					label.TextTransparency = t * t
					label.Rotation = math.sin(heart.Sway + t * 4) * 15
				end
			end
		end
		nextHeart -= dt
		if nextHeart <= 0 then
			nextHeart = random:NextNumber(0.5, 1.6) / (1 + followers() * 0.12)
			if effectsOn() or random:NextNumber() < 0.3 then
				spawnHeart()
			end
		end

		-- Spectateurs : marche aléatoire autour de la cible
		viewersTimer -= dt
		if viewersTimer <= 0 then
			viewersTimer = 0.6
			local target = targetViewers()
			viewers += (target - viewers) * 0.25 + target * random:NextNumber(-0.03, 0.03)
			viewers = math.max(1, viewers)
		end
		shownViewers += (viewers - shownViewers) * math.min(1, dt * 4)
		viewersLabel.Text = "👁 " .. formatViewers(math.floor(shownViewers + 0.5))
	end)

	------------------------------------------------------------------
	-- Boucle de repas : un aliment à la fois
	------------------------------------------------------------------
	local function refillPlate()
		for i, food in ipairs(foods) do
			food.Text = FOODS[random:NextInteger(1, #FOODS)]
			food.Rotation = random:NextNumber(-12, 12)
			foodScales[i].Scale = 1
			food.Position = foodHome(i) - UDim2.fromOffset(0, 70)
			food.Visible = true
			task.delay((i - 1) * 0.08, function()
				if ctx.IsAlive() and food.Parent then
					UI.Tween(food, 0.45, { Position = foodHome(i) }, Enum.EasingStyle.Bounce)
				end
			end)
		end
	end

	task.spawn(function()
		task.wait(1)
		while ctx.IsAlive() do
			task.wait(random:NextNumber(1.1, 1.9) / (1 + math.min(followers(), 15) * 0.02))
			if not ctx.IsAlive() then
				break
			end

			-- Prochain aliment encore dans l'assiette
			local index = nil
			for i, food in ipairs(foods) do
				if food.Visible then
					index = i
					break
				end
			end

			if not index then
				-- Assiette vide : on ressert !
				face.Text = "🥺"
				popWord("RESSERVI !")
				task.wait(0.5)
				if not ctx.IsAlive() then
					break
				end
				refillPlate()
				pushChat(randomName(), "IL RESSERT 😭🔥")
				task.wait(0.7)
				face.Text = "😋"
			else
				local food = foods[index]
				local scale = foodScales[index]
				-- Regard gourmand, bouche ouverte, puis croc !
				face.Text = "🤤"
				task.wait(0.35)
				if not ctx.IsAlive() then
					break
				end
				face.Text = "😮"
				UI.Tween(food, 0.25, { Position = UDim2.new(0.5, 0, 0, MOUTH_Y), Rotation = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				UI.Tween(scale, 0.25, { Scale = 0.35 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				task.wait(0.25)
				if not ctx.IsAlive() then
					break
				end
				food.Visible = false
				face.Text = "😋"
				chewUntil = os.clock() + 0.9
				popWord()
				crumbs()
				ctx.Sound.Play("Pop", random:NextNumber(0.55, 0.75))
				if random:NextNumber() < 0.5 then
					pushChat(randomName(), REACTIONS[random:NextInteger(1, #REACTIONS)])
				end
			end
		end
	end)

	------------------------------------------------------------------
	-- Boucle du chat : de plus en plus rapide avec les abonnés
	------------------------------------------------------------------
	task.spawn(function()
		while ctx.IsAlive() do
			local interval = math.clamp(1.4 / (1 + followers() * 0.15), 0.25, 1.4)
			task.wait(random:NextNumber(0.6, 1.3) * interval)
			if not ctx.IsAlive() then
				break
			end
			if chat.Visible then
				randomChat()
			end
		end
	end)
end

return LiveStream
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Lofi</string>
            <string name="Source"><![CDATA[--[[
	Lofi (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > Lofi

	Petite chambre "lofi" la nuit (slot R3, 384x268), entièrement dessinée
	en code : fenêtre avec ciel étoilé, lune, ville au loin et pluie qui
	tombe, un chat qui dort sur le rebord (avec ses "z z z"), une plante,
	un étudiant avec son casque 🎧 qui hoche la tête en rythme, une tasse
	fumante, une lampe de bureau dont la lueur respire, des post-it, une
	horloge (heure réelle), et en bas : "lofi beats 🎧 pour réviser", le
	nombre de personnes qui "révisent" et un égaliseur animé.

	Purement visuel (la musique est gérée ailleurs, par SoundManager).
]]

local Lofi = {}
Lofi.Slot = "R3"

-- Dimensions (pixels "design")
local SCENE_X, SCENE_Y = 6, 6
local SCENE_W, SCENE_H = 368, 204
local BAR_Y, BAR_H = 214, 42
local DESK_Y = 150 -- dessus du bureau (dans la scène)
local WINDOW_X, WINDOW_Y, WINDOW_W, WINDOW_H = 14, 10, 172, 114
local GLASS_W, GLASS_H = WINDOW_W - 12, WINDOW_H - 12
local SILL_Y = WINDOW_Y + WINDOW_H - 2
local LAMP_X = 330
local PERSON_X = 262
local EQ_BARS = 12
local BEAT = 60 / 78 -- une pulsation (78 BPM, tranquille)

local RAIN_COLOR = Color3.fromRGB(190, 210, 255)
local EQ_LOW = Color3.fromRGB(255, 120, 190)
local EQ_HIGH = Color3.fromRGB(100, 220, 255)

local TRACKS = {
	"pluie_de_minuit.mp3",
	"chat_qui_ronronne.wav",
	"cafe_froid_a_3h.mp3",
	"revisions_infinies.mp3",
	"nuages_en_pyjama.mp3",
	"le_controle_c_est_demain.mp3",
	"flemme_douce.wav",
	"encore_5_minutes.mp3",
}

function Lofi.Start(ctx)
	local UI = ctx.UIUtil
	local Theme = ctx.Theme
	local Format = ctx.Format
	local random = Random.new()

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	local function frame(props): Frame
		local finalProps = { BorderSizePixel = 0 }
		for key, value in pairs(props) do
			finalProps[key] = value
		end
		return UI.Create("Frame", finalProps)
	end

	local function circle(props): Frame
		local f = frame(props)
		UI.Corner(f, UDim.new(1, 0))
		return f
	end

	local function emoji(text: string, size: number, props): TextLabel
		local finalProps = {
			Text = text,
			TextSize = size,
			Font = Theme.Fonts.Body,
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(size + 6, size + 6),
		}
		for key, value in pairs(props) do
			finalProps[key] = value
		end
		return UI.Create("TextLabel", finalProps)
	end

	------------------------------------------------------------------
	-- Carte + scène
	------------------------------------------------------------------
	local card = frame({
		Name = "Card",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -4, 1, -4),
		BackgroundColor3 = Color3.fromRGB(28, 22, 44),
		Parent = ctx.Container,
	})
	UI.Corner(card, 16)
	UI.Stroke(card, Theme.Colors.CardBorder, 2)

	local scene = frame({
		Name = "Scene",
		Position = UDim2.fromOffset(SCENE_X, SCENE_Y),
		Size = UDim2.fromOffset(SCENE_W, SCENE_H),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ClipsDescendants = true,
		Parent = card,
	})
	UI.Corner(scene, 10)
	UI.Gradient(scene, ColorSequence.new(Color3.fromRGB(78, 58, 122), Color3.fromRGB(44, 34, 76)), 90)

	------------------------------------------------------------------
	-- Lueur de la lampe (derrière tout le reste du mur)
	------------------------------------------------------------------
	local glows: { Frame } = {}
	local GLOW_SIZES = { 190, 130, 80 }
	local GLOW_ALPHA = { 0.9, 0.84, 0.76 }
	for i, size in ipairs(GLOW_SIZES) do
		glows[i] = circle({
			Name = "Glow",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(LAMP_X - 6, 112),
			Size = UDim2.fromOffset(size, size),
			BackgroundColor3 = Color3.fromRGB(255, 196, 120),
			BackgroundTransparency = GLOW_ALPHA[i],
			ZIndex = 1,
			Parent = scene,
		})
	end

	------------------------------------------------------------------
	-- Fenêtre : ciel, lune, étoiles, ville, pluie
	------------------------------------------------------------------
	local windowFrame = frame({
		Name = "Window",
		Position = UDim2.fromOffset(WINDOW_X, WINDOW_Y),
		Size = UDim2.fromOffset(WINDOW_W, WINDOW_H),
		BackgroundColor3 = Color3.fromRGB(236, 214, 182),
		ZIndex = 2,
		Parent = scene,
	})
	UI.Corner(windowFrame, 6)

	local glass = frame({
		Name = "Glass",
		Position = UDim2.fromOffset(6, 6),
		Size = UDim2.fromOffset(GLASS_W, GLASS_H),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ClipsDescendants = true,
		ZIndex = 2,
		Parent = windowFrame,
	})
	UI.Gradient(glass, ColorSequence.new(Color3.fromRGB(16, 20, 62), Color3.fromRGB(86, 62, 138)), 90)

	-- Lune
	local moonGlow = circle({
		Name = "MoonGlow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(GLASS_W - 32, 24),
		Size = UDim2.fromOffset(46, 46),
		BackgroundColor3 = Color3.fromRGB(255, 244, 200),
		BackgroundTransparency = 0.82,
		ZIndex = 2,
		Parent = glass,
	})
	local moon = circle({
		Name = "Moon",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = moonGlow.Position,
		Size = UDim2.fromOffset(24, 24),
		BackgroundColor3 = Color3.fromRGB(252, 244, 206),
		ZIndex = 3,
		Parent = glass,
	})
	circle({
		Name = "Crater",
		Position = UDim2.fromOffset(5, 6),
		Size = UDim2.fromOffset(6, 6),
		BackgroundColor3 = Color3.fromRGB(226, 216, 176),
		ZIndex = 3,
		Parent = moon,
	})
	circle({
		Name = "Crater",
		Position = UDim2.fromOffset(13, 13),
		Size = UDim2.fromOffset(4, 4),
		BackgroundColor3 = Color3.fromRGB(226, 216, 176),
		ZIndex = 3,
		Parent = moon,
	})

	-- Étoiles qui scintillent
	local stars: { { Frame: Frame, Phase: number, Speed: number } } = {}
	for _ = 1, 7 do
		local size = random:NextInteger(2, 3)
		local star = circle({
			Name = "Star",
			Position = UDim2.fromOffset(random:NextInteger(6, GLASS_W - 60), random:NextInteger(4, 46)),
			Size = UDim2.fromOffset(size, size),
			BackgroundColor3 = Color3.fromRGB(255, 255, 230),
			ZIndex = 2,
			Parent = glass,
		})
		table.insert(stars, { Frame = star, Phase = random:NextNumber(0, math.pi * 2), Speed = random:NextNumber(1.5, 3.5) })
	end

	-- Étoile filante (une seule, réutilisée)
	local shootingStar = frame({
		Name = "ShootingStar",
		AnchorPoint = Vector2.new(1, 0.5),
		Size = UDim2.fromOffset(26, 2),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Rotation = 18,
		Visible = false,
		ZIndex = 2,
		Parent = glass,
	})
	UI.Create("UIGradient", {
		Transparency = NumberSequence.new(1, 0),
		Parent = shootingStar,
	})

	-- Ville au loin (immeubles + quelques fenêtres allumées)
	local litWindows: { Frame } = {}
	local buildingX = 0
	local BUILDINGS = { { 22, 34 }, { 18, 50 }, { 28, 28 }, { 20, 44 }, { 26, 36 }, { 22, 54 }, { 30, 30 } }
	for _, spec in ipairs(BUILDINGS) do
		local w, h = spec[1], spec[2]
		local building = frame({
			Name = "Building",
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromOffset(buildingX, GLASS_H),
			Size = UDim2.fromOffset(w, h),
			BackgroundColor3 = Color3.fromRGB(28, 24, 58),
			ZIndex = 3,
			Parent = glass,
		})
		if #litWindows < 9 and h >= 34 then
			for _ = 1, 2 do
				local lit = frame({
					Name = "Lit",
					Position = UDim2.fromOffset(random:NextInteger(3, w - 7), random:NextInteger(5, h - 12)),
					Size = UDim2.fromOffset(3, 4),
					BackgroundColor3 = Color3.fromRGB(255, 214, 110),
					ZIndex = 3,
					Parent = building,
				})
				table.insert(litWindows, lit)
			end
		end
		buildingX += w + 1
		if buildingX >= GLASS_W then
			break
		end
	end

	-- Pluie : réserve de traits recyclés (aucune création par image)
	local RAIN_ANGLE = math.rad(12)
	local RAIN_SPEED = 230
	local rainCount = effectsOn() and 24 or 10
	local drops: { { Frame: Frame, X: number, Y: number, Speed: number } } = {}
	for _ = 1, rainCount do
		local length = random:NextInteger(8, 14)
		local drop = frame({
			Name = "Rain",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(1.5, length),
			BackgroundColor3 = RAIN_COLOR,
			BackgroundTransparency = random:NextNumber(0.25, 0.55),
			Rotation = 12,
			ZIndex = 4,
			Parent = glass,
		})
		table.insert(drops, {
			Frame = drop,
			X = random:NextNumber(0, GLASS_W + 30),
			Y = random:NextNumber(-20, GLASS_H),
			Speed = RAIN_SPEED * random:NextNumber(0.8, 1.2),
		})
	end

	-- Gouttes qui glissent sur la vitre
	local beads: { { Frame: Frame, X: number, Y: number, Speed: number } } = {}
	for _ = 1, 3 do
		local bead = circle({
			Name = "Bead",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(4, 5),
			BackgroundColor3 = Color3.fromRGB(220, 235, 255),

DETAILS.CloudyWindow = windowDetail(Color3.fromRGB(150, 210, 255), Color3.fromRGB(220, 240, 255))
DETAILS.RainyWindow = windowDetail(Color3.fromRGB(130, 150, 185), Color3.fromRGB(190, 205, 225))

        <Item class="ModuleScript" referent="336">
          <Properties>
            <string name="Name">FR_V9_Mail</string>
            <string name="Source"><![CDATA[--[[
	Traductions françaises (v9) : Dopamail (Client > Stimuli > Email)
	Emplacement : ReplicatedStorage > Shared > Lang > FR_V9_Mail
	Les noms de dossiers, les correspondants et leurs réponses sont dans
	Email.luau (tables { en = ..., fr = ... }).
]]
return {
	fr = {
		-- Liste et lecture
		["Me"] = "Moi",
		["%d h"] = "%d h",
		["To: %s"] = "À : %s",
		["(no subject)"] = "(sans objet)",
		["🎁 NEW · +%s"] = "🎁 NOUVEAU · +%s",
		["No starred mail. Tap ⭐ on a mail to keep it here."] = "Aucun favori. Touche ⭐ sur un mail pour le garder ici.",
		["Nothing sent yet. Grandma is waiting for your news!"] = "Rien d'envoyé pour l'instant. Mamie attend de tes nouvelles !",
		["No spam here. Suspiciously clean."] = "Aucun spam ici. Étrangement propre.",
		["The trash is empty. Very tidy."] = "La corbeille est vide. Très bien rangé.",
		["No mail matches your search."] = "Aucun mail ne correspond à ta recherche.",
		["✅ All read"] = "✅ Tout lu",
		["🧹 Empty"] = "🧹 Vider",
		["✅ All caught up!"] = "✅ Tout est lu !",
		["🧹 Trash emptied (%d)"] = "🧹 Corbeille vidée (%d)",
		["🎁 +%s Dopamine collected!"] = "🎁 +%s Dopamine récupérée !",
		["🎁 Bonus on its way…"] = "🎁 Bonus en route…",
		["⌛ Opened too late: no bonus this time."] = "⌛ Ouvert trop tard : pas de bonus cette fois.",
		["to %s <%s> · %s"] = "à %s <%s> · %s",
		["<%s> · to me · %s"] = "<%s> · à moi · %s",
		["Pick a mail to read it"] = "Choisis un mail pour le lire",
		["💡 Flying mails give Dopamine if you open them before they fly away!"] = "💡 Les mails volants rapportent de la Dopamine si tu les ouvres avant qu'ils s'envolent !",
		["✏️ Write to…"] = "✏️ Écrire à…",
		["✏️ Write to %s"] = "✏️ Écrire à %s",
		["You wrote:"] = "Tu as écrit :",
		["📩 New mail from %s"] = "📩 Nouveau mail de %s",

		-- Actions
		["✅ Not spam"] = "✅ Pas un spam",
		["♻️ Restore"] = "♻️ Restaurer",
		["❌ Delete forever"] = "❌ Effacer pour toujours",
		["✅ Back in your inbox"] = "✅ De retour dans ta boîte de réception",
		["🗑️ Moved to the trash"] = "🗑️ Mis à la corbeille",
		["♻️ Restored to %s"] = "♻️ Restauré dans %s",
		["💨 Deleted forever"] = "💨 Effacé pour toujours",

		-- Rédaction
		["✏️ New message"] = "✏️ Nouveau message",
		["To:"] = "À :",
		["Subject"] = "Objet",
		["Write your message…"] = "Écris ton message…",
		["🛡️ Checked by the Roblox filter before sending"] = "🛡️ Vérifié par le filtre Roblox avant l'envoi",
		["🛡️ Checking your message…"] = "🛡️ Vérification de ton message…",
		["⏳ Sending…"] = "⏳ Envoi…",
		["✈️ Sent to %s!"] = "✈️ Envoyé à %s !",
		["Pick a recipient first 👆"] = "Choisis d'abord un destinataire 👆",
		["Write something first ✍️"] = "Écris d'abord quelque chose ✍️",
		["---------- Forwarded message ----------"] = "---------- Message transféré ----------",
		["From: %s"] = "De : %s",
		["Subject: %s"] = "Objet : %s",
	},
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="337">

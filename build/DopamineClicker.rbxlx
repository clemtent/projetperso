        <Item class="ModuleScript" referent="338">
          <Properties>
            <string name="Name">FR_V9_UX</string>
            <string name="Source"><![CDATA[--[[
	Traductions françaises (v9, interface : fenêtre "Pas assez de Dopamine",
	boutons, carte "nouveautés après l'océan", barre d'améliorations...)
]]
return {
	fr = {
		-- Fenêtre "Pas assez de Dopamine" (NeedDopamine)

R.AstronautStatue = function(b, _ctx)
	b.Cyl(0, 0, 0, 80, 10, rgb(200, 196, 220), M.Slate)
	for _, x in ipairs({ -8, 8 }) do
		b.Box(x, 10, 0, 12, 18, 14, WHITE, M.Fabric)
	end
	b.Box(0, 28, -8, 36, 32, 10, GREY, M.Metal) -- sac à dos
	b.Box(0, 28, 0, 30, 32, 20, WHITE, M.Fabric)
	b.Box(0, 40, 10.2, 12, 8, 0.6, NAVY)
	b.BoxR(CFrame.new(-20, 44, 0) * CFrame.Angles(0, 0, 0.3), 10, 24, 10, WHITE, M.Fabric)
	b.BoxR(CFrame.new(20, 64, 0) * CFrame.Angles(0, 0, -0.3), 10, 24, 10, WHITE, M.Fabric)
	b.Ball(0, 72, 0, 30, WHITE, M.SmoothPlastic)
	local visor = b.Ball(0, 72, 5, 22, rgb(40, 60, 130), M.Glass)
	visor.Reflectance = 0.2
	b.Cyl(36, 10, 10, 2, 60, GREY, M.Metal)
	b.Box(44, 58, 10, 16, 10, 0.6, rgb(80, 150, 255))
	b.Footprint(80, 40, 88)
end
R.PirateChest = function(b, _ctx)
	local wood = b.Map(rgb(170, 110, 70))
	b.Box(0, 0, 0, 84, 40, 50, wood, M.Wood)
	for _, x in ipairs({ -30, 30 }) do
		b.Box(x, 0, 0, 7, 40.4, 50.4, GOLD, M.Metal)
	end
	b.BoxR(CFrame.new(0, 58, -28) * CFrame.Angles(-1.1, 0, 0), 84, 30, 8, wood, M.Wood)
	for index = 0, 8 do
		b.Ball(-30 + (index % 5) * 15, 40 + (index > 4 and 5 or 0), -6 + (index % 3) * 8, 12, GOLD, M.Metal)
	end
	b.Ball(-10, 48, 4, 8, RACE_RED, M.Glass)
	b.Ball(12, 48, 0, 8, NEON_CYAN, M.Glass)
	b.Box(0, 22, 25.3, 14, 14, 1.2, GOLD, M.Metal)
	b.Footprint(84, 50, 60)
end
R.Motorbike = function(b, _ctx)
	for _, x in ipairs({ -34, 34 }) do
		wheel3D(b, x, 18, 0, 36, 8, CHROME)
	end
	local red = b.Map(RACE_RED)
	b.Box(-4, 28, 0, 34, 20, 14, CHROME, M.Metal) -- moteur
	b.Box(6, 46, 0, 32, 14, 18, red, M.SmoothPlastic) -- réservoir
	b.Box(-22, 50, 0, 28, 6, 16, INK, M.Leather) -- selle
	b.BoxR(CFrame.new(30, 40, 0) * CFrame.Angles(0, 0, -0.45), 5, 50, 5, CHROME, M.Metal)
	b.Box(22, 64, 0, 4, 4, 34, INK, M.Metal)
	local lamp = b.CylX(36, 56, 0, 10, 4, BUTTER)
	b.Neon(lamp)
	b.BoxR(CFrame.new(-30, 22, 8) * CFrame.Angles(0, 0, 0.15), 40, 5, 5, CHROME, M.Metal) -- échappement
	b.Footprint(100, 24, 70)
end
R.DinoSkeleton = function(b, _ctx)
	b.Box(0, 0, 0, 96, 8, 36, CARBON, M.Marble)
	local bone = rgb(246, 238, 220)
	local spine = { { -46, 36 }, { -30, 44 }, { -14, 48 }, { 2, 50 }, { 16, 54 }, { 26, 64 }, { 30, 74 } }
	for index, p in ipairs(spine) do
		b.Ball(p[1], p[2], 0, 7, bone, M.Marble)
		local next = spine[index + 1]
		if next then
			local dx, dy = next[1] - p[1], next[2] - p[2]
			b.BoxR(CFrame.new((p[1] + next[1]) / 2, (p[2] + next[2]) / 2, 0) * CFrame.Angles(0, 0, math.atan2(dy, dx)), math.sqrt(dx * dx + dy * dy), 3, 3, bone, M.Marble)
		end
	end
	for index = 0, 3 do
		b.Box(-8 + index * 6, 30, 0, 2, 18 - index * 2, 16, bone, M.Marble)
	end
	for _, x in ipairs({ -10, 10 }) do
		b.Box(x, 8, 0, 4, 42, 4, bone, M.Marble)
	end
	b.Box(36, 70, 0, 26, 14, 14, bone, M.Marble)
	b.Box(38, 64, 0, 22, 5, 12, bone, M.Marble)
	b.Box(0, 4, 18.3, 20, 5, 0.6, GOLD, M.Metal)
	b.Footprint(96, 36, 86)
end

----------------------------------------------------------------------
-- Familles par défaut (objets sans recette dédiée)
----------------------------------------------------------------------

local DOORS_AS_CARD: { [string]: boolean } = { DreamPortal = true, MouseHole = true, Elevator = false }

-- Objets qu'on colle contre le mur du fond (portes, grands rangements)
local AGAINST_WALL: { [string]: boolean } = {
	Wardrobe = true, Bookshelf = true, Fridge = true, Fireplace = true, Dresser = true, DrawerCabinet = true,
	HomeCinema = true, TVStand = true, KitchenIsland = false, Shower = true, ToriiGate = true, ArcadeMachine = true,
	SlotMachine = true, Speaker = true, VanityTable = true, Aquarium = true, Stove = true, Toilet = true,
	KitchenSink = true, Jukebox = true, PinballMachine = false, LadderShelf = true,
	-- v9.2
	LockerCabinet = true, NeonArcade = true, SharkTank = true, GuitarAmp = true,
}

function House3DRecipes.Has(itemId: string): boolean
	return R[itemId] ~= nil
end

-- Recette d'un objet (nil = carton découpé)
function House3DRecipes.For(item: any): (Recipe?, Info)
	local info: Info = { Wall = false, Flat = false, Glow = item.Category == "Lights" }
	if type(item) ~= "table" or type(item.Id) ~= "string" then
		return nil, info
	end
	local id = item.Id
	local recipe = R[id]
	if not recipe and item.Category == "Windows" and item.Placement == "Wall" then
		recipe = windowRecipe
	end
	if item.Category == "Doors" and item.Placement ~= "Wall" and not DOORS_AS_CARD[id] then
		info.Wall = true
		recipe = recipe or door
	end
	if id == "KnittedRug" or string.find(id, "Rug$") then
		info.Flat = true
		recipe = recipe or rug
	end
	if not recipe and item.Placement ~= "Wall" and item.Category == "Plants" then
		recipe = (tonumber(item.Size) or 60) >= 100 and tree(nil, true) or smallPlant(true)
	end
	if AGAINST_WALL[id] then
		info.Wall = true
	end
	return recipe, info
end

-- Contexte d'une recette (dessus de HouseSurfaces, couleur des moulures)
function House3DRecipes.Context(item: any, trim: Color3): Ctx
	local raw = nil
	local okRaw, value = pcall(HouseSurfaces.Raw, item.Id)
	if okRaw and type(value) == "table" then
		raw = value
	end
	local ctx: Ctx = {
		Item = item,
		Raw = raw,
		Trim = trim,
		TopY = function(index: number, default: number): number
			local surface = raw and raw[index]
			local y = surface and tonumber(surface[3])
			if y then
				return math.clamp(100 - y, 2, 100)
			end
			return default
		end,
		Span = function(index: number, default0: number, default1: number): (number, number)
			local surface = raw and raw[index]
			local x0 = surface and tonumber(surface[1])
			local x1 = surface and tonumber(surface[2])
			if x0 and x1 and x1 > x0 then
				return x0 - 50, x1 - 50
			end
			return default0, default1
		end,
	}
	return ctx
end

-- (pour les couleurs de secours ailleurs)
House3DRecipes.BLACK = BLACK

return House3DRecipes
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="39">
            <Properties>
              <string name="Name">House3DScene</string>
              <string name="Source"><![CDATA[--[[
	House3DScene (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > House3DScene

	Construit la "maison de poupée" 3D d'UNE pièce pour la vue 3D (House3D),
	loin du monde (autour de ORIGIN), dans un Folder du Workspace. v9.1 :
	TOUT est en vraie géométrie 3D, avec des Parts OPAQUES de taille
	normale (aucune pièce géante, aucune pièce invisible qui porte le
	décor) :
	  - studio : grande boîte pastel (Parts opaques) + pelouse sur un socle ;
	  - pièce : dalle, sol (couleur + matière du sol de la pièce), mur du
	    fond et murs de côté (coque + "peau" couleur du papier peint),
	    plinthes, moulures, poutre, fenêtre en relief (cadre, croisillon,
	    rebord, tringle, rideaux, vue dessinée sur la vitre), prise ;
	    les motifs (papier peint, sol) ne sont qu'une DÉCORATION facultative
	    (SurfaceGui de taille fixe sur la face d'une pièce normale) : la
	    couleur de la pièce suffit déjà ;
	  - objets : vrais modèles 3D (House3DRecipes) aux couleurs du dessin 2D
	    de l'objet (et de sa variante de couleur) ; sans recette = carton
	    découpé épais dessiné des deux côtés ; objets posés SUR le vrai
	    dessus 3D des meubles ; chaises tournées vers leur table ; F = miroir ;
	  - lumières : plafonnier, soleil de la fenêtre (SpotLight), lampes
	    (PointLight), ambiance de la pièce (Room.Mood : couleur, intensité,
	    petites particules) ; l'éclairage du lieu est réglé par House3D
	    (scene.Lighting) et remis à la fermeture.

	Champs de pièce lus (tous facultatifs, valeurs par défaut sinon) :
	  Wallpaper, Floor, Trim (Config.HouseTrimsById), Mood
	  (Config.HouseMoodsById), View (Config.HouseViewsById) ; objets :
	  { I, X, Y, S, Z, F, C } (C = variante de couleur, HouseTints).

	API :
	  House3DScene.new(room, sizeId, night) -> Scene   (décor construit tout de suite)
	  scene.BuildItems(alive, progress?)   objets, étalés sur plusieurs images (yield)
	  scene.SetNight(night)
	  scene.Lighting(night) -> { [propriété de Lighting]: valeur }
	  scene.UpdateWalls(eye)   baisse le mur de côté entre la caméra et la pièce
	  scene.Step(dt)           arrivée des objets, ambiance (appelé chaque image)
	  scene.Destroy()
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local HouseCommon = require(script.Parent.HouseCommon)
local HousePatterns = require(script.Parent.HousePatterns)
local HouseSurfaces = require(script.Parent.HouseSurfaces)
local House3DFloor = require(script.Parent.House3DFloor)
local House3DKit = require(script.Parent.House3DKit)
local House3DRecipes = require(script.Parent.House3DRecipes)

type Placed = HouseCommon.Placed
type Builder = House3DKit.Builder
type Painted = House3DKit.Painted

local House3DScene = {}

House3DScene.ORIGIN = Vector3.new(0, 5000, 0) -- loin du monde (au-dessus de tout)
House3DScene.FOLDER_NAME = "House3DPreview"

local PX = 0.05 -- studs par px de maquette de la pièce 2D
local ROOM_BASE_WIDTH = 760 -- (= HouseRoom.BASE_WIDTH)
local ROOM_HEIGHT = 440 -- (= HouseRoom.HEIGHT)
local SIDE_PX = 42 -- murs de côté en perspective de la pièce 2D (HouseRoom)
local DEPTH = 22 -- (studs) profondeur de la pièce
local DEPTH_PX = math.floor(DEPTH / PX)
local WALL_T = 0.8 -- épaisseur de la coque
local SKIN = 0.1 -- épaisseur de la "peau" papier peint
local SLAB = 1.2
local LAWN_SIDE = 4
local LAWN_FRONT = 5
local LAWN_BACK = 3
local DEPTH_CURVE = 1.35 -- (Y 2D -> profondeur) les objets du fond vont vraiment contre le mur
local MAX_LAMPS = 8 -- vraies lumières d'objets au plus
local DROP = 1.4 -- (studs) les objets tombent doucement à leur place
local DROP_TIME = 0.45
local BATCH_ITEMS = 4
local BATCH_TIME = 0.008

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local C = HouseCommon.Colors
local SHELL = Color3.fromRGB(252, 214, 232)
local BASE_PINK = Color3.fromRGB(242, 188, 216)
local GRASS = Color3.fromRGB(140, 214, 140)
local CREAM = Color3.fromRGB(255, 247, 236)
local M = Enum.Material

-- Studio (fond) : bandes du bas vers le haut (jour / nuit)
local SKY_DAY = { Color3.fromRGB(255, 236, 228), Color3.fromRGB(255, 222, 238), Color3.fromRGB(226, 226, 255), Color3.fromRGB(196, 222, 255), Color3.fromRGB(176, 212, 255) }
local SKY_NIGHT = { Color3.fromRGB(120, 84, 150), Color3.fromRGB(86, 62, 132), Color3.fromRGB(58, 46, 112), Color3.fromRGB(36, 32, 86), Color3.fromRGB(22, 20, 62) }

local DEFAULT_MOOD = { Tint = WHITE, Amount = 0, Light = Color3.fromRGB(255, 244, 230), Brightness = 1, Effect = "None" }

export type Scene = {
	Folder: Folder,
	Width: number,
	Depth: number,
	WallHeight: number,
	Focus: Vector3,
	BoundsMin: Vector3,
	BoundsMax: Vector3,
	FrontZ: number,
	ItemCount: number,
	BuildItems: (alive: () -> boolean, progress: ((done: number, total: number) -> ())?) -> (),
	SetNight: (night: boolean) -> (),
	Lighting: (night: boolean) -> { [string]: any },
	UpdateWalls: (eye: Vector3) -> (),
	Step: (dt: number) -> (),
	Destroy: () -> (),
}

type Build = {
	Entry: Placed,
	Item: any,
	Painted: Painted?,
	Recipe: House3DRecipes.Recipe?,
	Info: House3DRecipes.Info,
	Model: Builder?,
	K: number,
	Kind: string, -- "Wall" | "Flat" | "Floor"
	Parent: Build?,
	Relation: string?, -- "On" | "At"
	SeatKind: string?,
	SurfaceIndex: number,
	Surface: any?,
	Origin: CFrame,
	X: number,
	Z: number,
	FW: number, -- empreinte (studs) une fois tourné
	FD: number,
	Yaw: number,
	Placed: boolean,
	Order: number,
	Card: BasePart?,
	LightScore: number,
}

type SideWall = {
	Side: number,
	Shell: BasePart,
	Skin: BasePart,
	Crown: BasePart,
	Skirt: BasePart,
	Edge: BasePart,
	Gui: SurfaceGui?,
	Lowered: boolean,
}

type Arrival = { Parts: { BasePart }, Finals: { CFrame }, Delay: number, Clock: number }

----------------------------------------------------------------------
-- Outils
----------------------------------------------------------------------

local newPart = House3DKit.NewPart

local function noise(a: number, b: number): number
	local value = math.sin(a * 12.9898 + b * 78.233) * 43758.5453
	return value - math.floor(value)
end

local function finite(value: any, default: number): number
	local number = tonumber(value)
	if number == nil or number ~= number or number == math.huge or number == -math.huge then
		return default
	end
	return number
end

local function requireSibling(name: string): any
	local module = script.Parent:FindFirstChild(name)
	if not module or not module:IsA("ModuleScript") then
		return nil
	end
	local ok, result = pcall(require, module)
	if ok and type(result) == "table" then
		return result
	end
	return nil
end

local function configTable(name: string): { [string]: any }
	local okConfig, Config = pcall(function()
		return require(ReplicatedStorage.Shared.Config)
	end)
	if okConfig and type(Config) == "table" and type((Config :: any)[name]) == "table" then
		return (Config :: any)[name]
	end
	return {}
end

local function asColor(value: any, default: Color3): Color3
	if typeof(value) == "Color3" then
		return value
	end
	return default
end

-- Matière d'un mur / d'un sol selon son motif (la couleur suffit déjà)
local WALL_MATERIAL: { [string]: Enum.Material } = {
	Bricks = M.Brick,
	Wood = M.WoodPlanks,
}
local FLOOR_MATERIAL: { [string]: Enum.Material } = {
	Wood = M.WoodPlanks,
	Herringbone = M.WoodPlanks,
	Carpet = M.Fabric,
	Marble = M.Marble,
	Tiles = M.SmoothPlastic,
	Checker = M.SmoothPlastic,
	Grass = M.Grass,
	Terrazzo = M.Marble,
	Mosaic = M.SmoothPlastic,
	Clouds = M.Fabric,
	Starry = M.SmoothPlastic,
	Concrete = M.Concrete,
	Court = M.WoodPlanks,
	Turf = M.Grass,
	TreadPlate = M.DiamondPlate,
	Road = M.Asphalt,
	Lava = M.CrackedLava,
}

----------------------------------------------------------------------
-- Scène
----------------------------------------------------------------------

function House3DScene.new(room: any, sizeId: string?, startNight: boolean?): Scene
	local config = HouseCommon.Config
	local size = HouseCommon.SizesById[sizeId or ""] or config.Sizes[1]
	local widthFactor = tonumber(size and size.Width) or 1
	local roomWpx = math.floor(ROOM_BASE_WIDTH * widthFactor + 0.5)
	local roomHpx = ROOM_HEIGHT
	local wallRatio = tonumber(config.WallRatio) or 0.46
	local wallPx = math.floor(roomHpx * wallRatio + 0.5)
	local W = roomWpx * PX
	local WH = wallPx * PX
	local D = DEPTH
	local origin = House3DScene.ORIGIN
	local roomData = type(room) == "table" and room or {}
	local wallpaper = HouseCommon.GetRoomWallpaper(roomData)
	local floorStyle = HouseCommon.GetRoomFloor(roomData)
	local wallA = wallpaper and wallpaper.A or C.PinkSoft
	local floorA = floorStyle and floorStyle.A or C.Lilac
	local night = startNight == true
	local destroyed = false

	-- Personnalisation (v9.1) : moulures, ambiance, vue de la fenêtre
	local trimEntry = configTable("HouseTrimsById")[tostring(roomData.Trim or "Cream")]
	local trim = asColor(type(trimEntry) == "table" and trimEntry.Color, CREAM)
	local moodRaw = configTable("HouseMoodsById")[tostring(roomData.Mood or "Sunny")]
	local mood = {
		Tint = asColor(type(moodRaw) == "table" and moodRaw.Tint, DEFAULT_MOOD.Tint),
		Amount = math.clamp(finite(type(moodRaw) == "table" and moodRaw.Amount, 0), 0, 1),
		Light = asColor(type(moodRaw) == "table" and moodRaw.Light, DEFAULT_MOOD.Light),
		Brightness = math.clamp(finite(type(moodRaw) == "table" and moodRaw.Brightness, 1), 0.2, 2),
		Effect = type(moodRaw) == "table" and type(moodRaw.Effect) == "string" and moodRaw.Effect or "None",
	}
	local views = configTable("HouseViewsById")
	local viewEntry = views[tostring(roomData.View or "Garden")] or views.Garden
	local HouseViews = requireSibling("HouseViews")
	local HouseTints = requireSibling("HouseTints")

	local folder = Instance.new("Folder")
	folder.Name = House3DScene.FOLDER_NAME

	local function at(x: number, y: number, z: number): Vector3
		return origin + Vector3.new(x, y, z)
	end
	local X_AXIS = Vector3.new(1, 0, 0)
	local Y_AXIS = Vector3.new(0, 1, 0)
	local BACKWARD = Vector3.new(0, 0, -1)

	local function part(name: string, sizeV: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?, shadow: boolean?): BasePart
		local p = newPart("Part", name, sizeV, cframe, color, material)
		p.CastShadow = shadow == true
		p.Parent = folder
		return p
	end
	-- Pièce orientée (droite, haut) : la face Back (+Z local) regarde `right x up`
	local function facing(name: string, center: Vector3, right: Vector3, up: Vector3, w: number, h: number, t: number, color: Color3, material: Enum.Material?): BasePart
		local normal = right:Cross(up)
		return part(name, Vector3.new(w, h, t), CFrame.fromMatrix(center - normal * (t / 2), right, up), color, material)
	end

	-- Ce qui change la nuit / avec l'ambiance
	local skyBands: { { Part: BasePart, Index: number } } = {}
	local viewHolders: { Frame } = {}
	local itemLights: { { Light: PointLight, Base: number } } = {}
	local glowParts: { BasePart } = {}
	local ceilingLight: PointLight? = nil
	local fillLight: PointLight? = nil
	local sunLight: SpotLight? = nil
	local sideWalls: { SideWall } = {}
	local arrivals: { Arrival } = {}
	local effects: { ParticleEmitter } = {}
	local discoClock = 0
	local stormClock = 0

	------------------------------------------------------------------
	-- Studio : boîte pastel en bandes (Parts opaques, pas d'ombre)
	------------------------------------------------------------------
	local centerZ = D / 2
	local HX, HZ = 110, 110
	local yMin, yMax = -40, 110
	local bands = #SKY_DAY
	local bandH = (yMax - yMin) / bands
	for index = 1, bands do
		local y = yMin + (index - 0.5) * bandH
		for _, spec in ipairs({
			{ "Back", Vector3.new(0, y, centerZ - HZ), Vector3.new(HX * 2 + 2, bandH + 0.2, 1) },
			{ "Front", Vector3.new(0, y, centerZ + HZ), Vector3.new(HX * 2 + 2, bandH + 0.2, 1) },
			{ "Left", Vector3.new(-HX, y, centerZ), Vector3.new(1, bandH + 0.2, HZ * 2 + 2) },
			{ "Right", Vector3.new(HX, y, centerZ), Vector3.new(1, bandH + 0.2, HZ * 2 + 2) },
		}) do
			local p = part("Studio" .. spec[1] .. index, spec[3], CFrame.new(at(spec[2].X, spec[2].Y, spec[2].Z)), SKY_DAY[index], M.SmoothPlastic, false)
			table.insert(skyBands, { Part = p, Index = index })
		end
	end
	table.insert(skyBands, { Part = part("StudioTop", Vector3.new(HX * 2 + 2, 1, HZ * 2 + 2), CFrame.new(at(0, yMax, centerZ)), SKY_DAY[bands], M.SmoothPlastic, false), Index = bands })
	table.insert(skyBands, { Part = part("StudioBottom", Vector3.new(HX * 2 + 2, 1, HZ * 2 + 2), CFrame.new(at(0, yMin, centerZ)), SKY_DAY[1], M.SmoothPlastic, false), Index = 1 })
	-- Nuages (boules blanches, derrière la maison)
	for index = 1, 6 do
		local cx = -90 + index * 26 + (noise(index, 1) - 0.5) * 12
		local cy = -2 + noise(index, 2) * 8
		local cz = centerZ - HZ + 6 + noise(index, 3) * 8
		for puff = 0, 2 do
			local ball = part("Cloud", Vector3.new(1, 1, 1) * (5 + puff % 2 * 2), CFrame.new(at(cx + (puff - 1) * 4, cy + (puff % 2) * 1.5, cz)), WHITE, M.SmoothPlastic, false)
			;(ball :: Part).Shape = Enum.PartType.Ball
			table.insert(skyBands, { Part = ball, Index = 0 })
		end
	end

	------------------------------------------------------------------
	-- Socle : pelouse sur un gâteau rose
	------------------------------------------------------------------
	local lawnW = W + WALL_T * 2 + LAWN_SIDE * 2
	local lawnZ0 = -WALL_T - LAWN_BACK
	local lawnZ1 = D + LAWN_FRONT
	local lawnD = lawnZ1 - lawnZ0
	local lawnTop = -SLAB
	part("Lawn", Vector3.new(lawnW, 0.8, lawnD), CFrame.new(at(0, lawnTop - 0.4, (lawnZ0 + lawnZ1) / 2)), GRASS, M.Grass, false)
	part("Base", Vector3.new(lawnW - 0.9, 2.6, lawnD - 0.9), CFrame.new(at(0, lawnTop - 0.8 - 1.3, (lawnZ0 + lawnZ1) / 2)), BASE_PINK, M.SmoothPlastic, false)
	part("BaseTrim", Vector3.new(lawnW - 0.3, 0.35, lawnD - 0.3), CFrame.new(at(0, lawnTop - 0.8 - 2.5, (lawnZ0 + lawnZ1) / 2)), CREAM, M.SmoothPlastic, false)
	-- Petites fleurs et buissons sur la pelouse (autour de la maison)
	local flowerColors = { C.Pink, Color3.fromRGB(255, 226, 130), WHITE, C.Lilac }
	for index = 1, 26 do
		local side = index % 3
		local x, z
		if side == 0 then
			x = -lawnW / 2 + 1 + noise(index, 1) * (lawnW - 2)
			z = D + 1 + noise(index, 2) * (LAWN_FRONT - 2)
		elseif side == 1 then
			x = -W / 2 - WALL_T - 1 - noise(index, 3) * (LAWN_SIDE - 2)
			z = lawnZ0 + 1 + noise(index, 4) * (lawnD - 2)
		else
			x = W / 2 + WALL_T + 1 + noise(index, 5) * (LAWN_SIDE - 2)
			z = lawnZ0 + 1 + noise(index, 6) * (lawnD - 2)
		end
		if index % 4 == 0 then
			local bush = part("Bush", Vector3.new(1.6, 1.6, 1.6), CFrame.new(at(x, lawnTop + 0.5, z)), Color3.fromRGB(110, 190, 110), M.SmoothPlastic, true)
			;(bush :: Part).Shape = Enum.PartType.Ball
		else
			part("Stem", Vector3.new(0.12, 0.6, 0.12), CFrame.new(at(x, lawnTop + 0.3, z)), Color3.fromRGB(90, 170, 90), M.SmoothPlastic, false)
			local flower = part("Flower", Vector3.new(0.5, 0.5, 0.5), CFrame.new(at(x, lawnTop + 0.7, z)), flowerColors[index % #flowerColors + 1], M.SmoothPlastic, false)
			;(flower :: Part).Shape = Enum.PartType.Ball
		end
	end

	------------------------------------------------------------------
	-- Dalle, sol
	------------------------------------------------------------------
	-- (le dessus de la dalle reste sous le sol : pas de faces confondues)
	part("Slab", Vector3.new(W + WALL_T * 2, SLAB - 0.3, D + WALL_T), CFrame.new(at(0, -0.3 - (SLAB - 0.3) / 2, (D - WALL_T) / 2)), SHELL, M.SmoothPlastic, false)
	part("SlabTrim", Vector3.new(W + WALL_T * 2 + 0.1, 0.25, 0.25), CFrame.new(at(0, -0.12, D + 0.02)), trim, M.SmoothPlastic, false)
	do
		local pattern = floorStyle and floorStyle.Pattern or "Plain"
		-- (la "face du dessus" est la face Back d'une dalle tournée : le haut de la toile = le mur du fond)
		local floorPart = facing("Floor", at(0, 0, D / 2), X_AXIS, BACKWARD, W, D, 0.3, floorA, FLOOR_MATERIAL[pattern] or M.SmoothPlastic)
		local gui = House3DKit.Surface(floorPart, Enum.NormalId.Back, Vector2.new(roomWpx, DEPTH_PX), 1)
		local sheet = Instance.new("Frame")
		sheet.Name = "Floor"
		sheet.BackgroundTransparency = 1
		sheet.BorderSizePixel = 0
		sheet.Size = UDim2.fromScale(1, 1)
		sheet.ClipsDescendants = true
		sheet.Parent = gui
		local ok, err = pcall(House3DFloor.Paint, sheet, roomWpx, DEPTH_PX, floorStyle, 1)
		if not ok then
			warn("[House3D] Sol : " .. tostring(err))
		end
		-- (la couleur vient de la pièce : le fond de la toile reste transparent)
		sheet.BackgroundTransparency = 1
		if pattern == "Lava" then
			-- la lave éclaire la pièce par en dessous
			local glow = Instance.new("PointLight")
			glow.Color = Color3.fromRGB(255, 130, 60)
			glow.Range = 20
			glow.Brightness = 1.2
			glow.Shadows = false
			glow.Parent = floorPart
		end
		-- ombres douces au pied des murs
		local back = HousePatterns.Box(sheet, 0, 0, roomWpx, 40, BLACK, 0.75, 20)
		local fade = Instance.new("UIGradient")
		fade.Rotation = 90
		fade.Transparency = NumberSequence.new(0, 1)
		fade.Parent = back
	end

	------------------------------------------------------------------
	-- Murs : coque + peau (papier peint), plinthes, moulures, poutre
	------------------------------------------------------------------
	local function paper(gui: SurfaceGui, widthPx: number)
		local sheet = Instance.new("Frame")
		sheet.Name = "Paper"
		sheet.BackgroundTransparency = 1
		sheet.BorderSizePixel = 0
		sheet.Size = UDim2.fromScale(1, 1)
		sheet.ClipsDescendants = true
		sheet.Parent = gui
		local ok, err = pcall(HousePatterns.BuildWall, sheet, widthPx, wallPx, wallpaper, 1)
		if not ok then
			warn("[House3D] Papier peint : " .. tostring(err))
		end
		sheet.BackgroundTransparency = 1
		-- ombre au pied du mur
		local ao = HousePatterns.Box(sheet, 0, wallPx - 30, widthPx, 30, BLACK, 0.8, 20)
		local fade = Instance.new("UIGradient")
		fade.Rotation = 90
		fade.Transparency = NumberSequence.new(1, 0)
		fade.Parent = ao
	end
	local wallMaterial = WALL_MATERIAL[wallpaper and wallpaper.Pattern or ""] or M.SmoothPlastic
	-- Mur du fond
	part("WallBack", Vector3.new(W + WALL_T * 2, WH + 0.4, WALL_T), CFrame.new(at(0, (WH + 0.4) / 2 - 0.2, -WALL_T / 2 - SKIN)), SHELL, M.SmoothPlastic, false)
	do
		local skin = facing("WallBackPaper", at(0, WH / 2, 0), X_AXIS, Y_AXIS, W, WH, SKIN, wallA, wallMaterial)
		local gui = House3DKit.Surface(skin, Enum.NormalId.Back, Vector2.new(roomWpx, wallPx), 1)
		paper(gui, roomWpx)
	end
	-- Murs de côté (se baissent quand la caméra passe derrière eux)
	local crownH = 0.45
	for _, side in ipairs({ -1, 1 }) do
		local shellPart = part(side < 0 and "WallLeft" or "WallRight", Vector3.new(WALL_T, WH + 0.4, D + WALL_T + SKIN),
			CFrame.new(at(side * (W / 2 + SKIN + WALL_T / 2), (WH + 0.4) / 2 - 0.2, (D - WALL_T - SKIN) / 2)), SHELL, M.SmoothPlastic, false)
		local right = side < 0 and BACKWARD or -BACKWARD
		local skin = facing(side < 0 and "WallLeftPaper" or "WallRightPaper", at(side * W / 2, WH / 2, D / 2), right, Y_AXIS, D, WH, SKIN, wallA:Lerp(BLACK, 0.04), wallMaterial)
		local gui = House3DKit.Surface(skin, Enum.NormalId.Back, Vector2.new(DEPTH_PX, wallPx), 1)
		paper(gui, DEPTH_PX)
		local crown = part("TrimCrownSide", Vector3.new(0.36, crownH, D), CFrame.new(at(side * (W / 2 - 0.18), WH - crownH / 2, D / 2)), trim, M.SmoothPlastic, false)
		local skirt = part("TrimSkirtSide", Vector3.new(0.2, 0.6, D), CFrame.new(at(side * (W / 2 - 0.1), 0.3, D / 2)), trim, M.SmoothPlastic, false)
		-- chant avant du mur (liseré)
		local edge = part("TrimEdge", Vector3.new(WALL_T + SKIN + 0.1, WH + 0.4, 0.2), CFrame.new(at(side * (W / 2 + (WALL_T + SKIN) / 2), (WH + 0.4) / 2 - 0.2, D + 0.05)), trim, M.SmoothPlastic, false)
		table.insert(sideWalls, { Side = side, Shell = shellPart, Skin = skin, Crown = crown, Skirt = skirt, Edge = edge, Gui = gui, Lowered = false })
	end
	part("TrimSkirtBack", Vector3.new(W, 0.6, 0.2), CFrame.new(at(0, 0.3, 0.1)), trim, M.SmoothPlastic, false)
	part("TrimCrownBack", Vector3.new(W, crownH, 0.36), CFrame.new(at(0, WH - crownH / 2, 0.18)), trim, M.SmoothPlastic, false)
	-- Poutre du plafond (au-dessus du mur du fond) et petits corbeaux
	part("CeilingBeam", Vector3.new(W + WALL_T * 2 + 0.4, 0.7, 1.4), CFrame.new(at(0, WH + 0.35, 0.3)), trim:Lerp(Color3.fromRGB(160, 110, 78), 0.35), M.Wood, false)
	for index = -2, 2 do
		part("BeamBracket", Vector3.new(0.5, 0.5, 0.9), CFrame.new(at(index * W / 5, WH - 0.2, 0.9)), trim:Lerp(Color3.fromRGB(160, 110, 78), 0.35), M.Wood, false)
	end

	------------------------------------------------------------------
	-- Fenêtre fixe (à gauche, comme la pièce 2D) : vraie fenêtre en relief
	------------------------------------------------------------------
	local windowW, windowH, windowTop = 104 * PX, 92 * PX, 36 * PX
	local windowX2D = (SIDE_PX + roomWpx * 0.1) + 52
	local windowCX = ((windowX2D - SIDE_PX) / math.max(1, roomWpx - 2 * SIDE_PX) * roomWpx - roomWpx / 2) * PX
	local windowCY = WH - windowTop - windowH / 2
	do
		-- vue (panneau opaque derrière la vitre, dessiné par HouseViews)
		local view = facing("WindowView", at(windowCX, windowCY, 0.02), X_AXIS, Y_AXIS, windowW - 0.5, windowH - 0.5, 0.05, Color3.fromRGB(170, 214, 255), M.SmoothPlastic)
		view.Color = viewEntry and asColor(viewEntry.Sky, Color3.fromRGB(170, 214, 255)) or Color3.fromRGB(170, 214, 255)
		local gui = House3DKit.Surface(view, Enum.NormalId.Back, Vector2.new(200, 180), 0)
		local holder = Instance.new("Frame")
		holder.Name = "View"
		holder.BackgroundTransparency = 1
		holder.BorderSizePixel = 0
		holder.Size = UDim2.fromScale(1, 1)
		holder.ClipsDescendants = true
		holder.Parent = gui
		table.insert(viewHolders, holder)
		-- cadre (couleur des moulures), croisillon, rebord, tringle
		local fw = 0.32
		for _, spec in ipairs({
			{ 0, windowH / 2 + fw / 2, windowW + fw * 2, fw },
			{ 0, -windowH / 2 - fw / 2, windowW + fw * 2, fw },
			{ -windowW / 2 - fw / 2, 0, fw, windowH },
			{ windowW / 2 + fw / 2, 0, fw, windowH },
			{ 0, 0, 0.16, windowH },
			{ 0, 0, windowW, 0.16 },
		}) do
			part("WindowFrame", Vector3.new(spec[3], spec[4], 0.3), CFrame.new(at(windowCX + spec[1], windowCY + spec[2], 0.15)), trim, M.SmoothPlastic, true)
		end
		local glass = part("WindowGlass", Vector3.new(windowW, windowH, 0.05), CFrame.new(at(windowCX, windowCY, 0.1)), Color3.fromRGB(220, 240, 255), M.Glass, false)
		glass.Transparency = 0.8
		part("WindowSill", Vector3.new(windowW + 1, 0.3, 0.8), CFrame.new(at(windowCX, windowCY - windowH / 2 - 0.3, 0.4)), trim, M.SmoothPlastic, true)
		local rodY = windowCY + windowH / 2 + 0.5
		local rod = part("CurtainRod", Vector3.new(windowW + 2.4, 0.16, 0.16), CFrame.new(at(windowCX, rodY, 0.5)), Color3.fromRGB(160, 110, 78), M.Wood, false)
		;(rod :: Part).Shape = Enum.PartType.Cylinder
		for _, side in ipairs({ -1, 1 }) do
			local knob = part("CurtainKnob", Vector3.new(0.4, 0.4, 0.4), CFrame.new(at(windowCX + side * (windowW / 2 + 1.2), rodY, 0.5)), C.PinkDeep, M.SmoothPlastic, false)
			;(knob :: Part).Shape = Enum.PartType.Ball
			-- rideau (tissu) retenu par une embrasse
			local cx = windowCX + side * (windowW / 2 + 0.3)
			local curtain = C.Pink:Lerp(trim, 0.15)
			for fold = 0, 2 do
				part("Curtain", Vector3.new(0.42, windowH + 0.6, 0.3), CFrame.new(at(cx + side * (fold - 1) * 0.36, rodY - (windowH + 0.6) / 2 - 0.1, 0.42 + (fold % 2) * 0.12)),
					fold % 2 == 0 and curtain or curtain:Lerp(WHITE, 0.2), M.Fabric, true)
			end
			part("CurtainTie", Vector3.new(1.4, 0.3, 0.5), CFrame.new(at(cx, windowCY - windowH * 0.08, 0.62)), C.PinkDeep, M.Fabric, false)
		end
		-- soleil de la fenêtre
		local sunAnchor = newPart("Part", "WindowLight", Vector3.new(0.2, 0.2, 0.2), CFrame.lookAt(at(windowCX, windowCY, 0.9), at(windowCX + 4, 0, D * 0.6)), WHITE, nil, 1)
		sunAnchor.CastShadow = false
		sunAnchor.Parent = folder
		local spot = Instance.new("SpotLight")
		spot.Face = Enum.NormalId.Front
		spot.Angle = 70
		spot.Range = 30
		spot.Shadows = true
		spot.Parent = sunAnchor
		sunLight = spot
	end
	-- Prise électrique (à droite)
	do
		local ox = ((roomWpx - SIDE_PX - 70 + 11 - SIDE_PX) / math.max(1, roomWpx - 2 * SIDE_PX) * roomWpx - roomWpx / 2) * PX
		part("Outlet", Vector3.new(1.1, 1.3, 0.12), CFrame.new(at(ox, 1.6, 0.06)), WHITE, M.SmoothPlastic, false)
		for _, dx in ipairs({ -0.2, 0.2 }) do
			part("OutletHole", Vector3.new(0.12, 0.3, 0.05), CFrame.new(at(ox + dx, 1.7, 0.14)), Color3.fromRGB(90, 70, 90), M.SmoothPlastic, false)
		end
	end

	------------------------------------------------------------------
	-- Lumières de la pièce + ambiance
	------------------------------------------------------------------
	do
		local lamp = newPart("Part", "CeilingLight", Vector3.new(0.3, 0.3, 0.3), CFrame.new(at(0, WH - 0.6, D * 0.45)), WHITE, nil, 1)
		lamp.CastShadow = false
		lamp.Parent = folder
		local light = Instance.new("PointLight")
		light.Range = 36
		light.Shadows = false
		light.Parent = lamp
		ceilingLight = light
		local fill = Instance.new("PointLight")
		fill.Range = 40
		fill.Shadows = false
		fill.Parent = lamp
		fillLight = fill
	end
	-- Petites particules d'ambiance (Room.Mood.Effect), dans le volume de la pièce
	do
		local specs: { [string]: { Colors: { Color3 }, Rate: number, Size: number, Speed: number, Up: number, Life: number, Emission: number } } = {
			Neon = { Colors = { Color3.fromRGB(255, 80, 200), Color3.fromRGB(80, 230, 255) }, Rate = 8, Size = 0.3, Speed = 0.3, Up = 0.1, Life = 3, Emission = 1 },
			Floodlights = { Colors = { WHITE, Color3.fromRGB(230, 240, 255) }, Rate = 5, Size = 0.22, Speed = 0.2, Up = 0.05, Life = 5, Emission = 1 },
			RGB = { Colors = { Color3.fromRGB(255, 60, 90), Color3.fromRGB(90, 255, 120), Color3.fromRGB(80, 140, 255) }, Rate = 10, Size = 0.3, Speed = 0.8, Up = 0, Life = 2, Emission = 1 },
			Storm = { Colors = { Color3.fromRGB(170, 200, 255), Color3.fromRGB(120, 140, 200) }, Rate = 14, Size = 0.18, Speed = 3, Up = -6, Life = 1.2, Emission = 0.6 },
			Embers = { Colors = { Color3.fromRGB(255, 200, 80), Color3.fromRGB(255, 90, 30) }, Rate = 9, Size = 0.28, Speed = 0.6, Up = 0.8, Life = 3, Emission = 1 },
			Sparkles = { Colors = { Color3.fromRGB(255, 244, 190), WHITE }, Rate = 6, Size = 0.35, Speed = 0.3, Up = 0.2, Life = 3, Emission = 1 },
			Bubbles = { Colors = { Color3.fromRGB(190, 230, 255), WHITE }, Rate = 5, Size = 0.5, Speed = 0.6, Up = 0.5, Life = 5, Emission = 0.4 },
			Hearts = { Colors = { C.Pink, C.PinkDeep }, Rate = 5, Size = 0.45, Speed = 0.5, Up = 0.4, Life = 4, Emission = 0.7 },
			Disco = { Colors = { C.Pink, Color3.fromRGB(120, 220, 255), Color3.fromRGB(255, 226, 130), C.Lilac }, Rate = 14, Size = 0.3, Speed = 1.5, Up = 0, Life = 1.6, Emission = 1 },
			Aurora = { Colors = { Color3.fromRGB(120, 255, 200), Color3.fromRGB(170, 140, 255) }, Rate = 3, Size = 1.4, Speed = 0.2, Up = 0.1, Life = 6, Emission = 0.8 },
			Rays = { Colors = { Color3.fromRGB(255, 236, 170) }, Rate = 5, Size = 0.25, Speed = 0.15, Up = 0.05, Life = 5, Emission = 1 },
			Leaves = { Colors = { Color3.fromRGB(140, 210, 110), Color3.fromRGB(240, 190, 90) }, Rate = 4, Size = 0.45, Speed = 0.4, Up = -0.6, Life = 5, Emission = 0.2 },
			Rainbow = { Colors = { Color3.fromRGB(255, 120, 140), Color3.fromRGB(255, 210, 110), Color3.fromRGB(140, 230, 150), Color3.fromRGB(130, 190, 255), C.Lilac }, Rate = 8, Size = 0.35, Speed = 0.4, Up = 0.2, Life = 4, Emission = 1 },
		}
		local spec = specs[mood.Effect]
		if spec then
			local volume = newPart("Part", "MoodVolume", Vector3.new(W - 1, WH - 1.5, D - 2), CFrame.new(at(0, WH / 2 + 0.3, D / 2)), WHITE, nil, 1)
			volume.CastShadow = false
			volume.Parent = folder
			local emitter = Instance.new("ParticleEmitter")
			emitter.Name = "Mood" .. mood.Effect
			emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
			emitter.Shape = Enum.ParticleEmitterShape.Box
			emitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
			emitter.EmissionDirection = Enum.NormalId.Top
			emitter.Rate = spec.Rate
			emitter.Lifetime = NumberRange.new(spec.Life * 0.7, spec.Life)
			emitter.Speed = NumberRange.new(spec.Speed * 0.5, spec.Speed)
			emitter.SpreadAngle = Vector2.new(180, 180)
			emitter.Acceleration = Vector3.new(0, spec.Up, 0)
			emitter.LightEmission = spec.Emission
			emitter.LightInfluence = 0
			emitter.Size = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(0.2, spec.Size),
				NumberSequenceKeypoint.new(0.8, spec.Size),
				NumberSequenceKeypoint.new(1, 0),
			})
			emitter.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.2, 0.15),
				NumberSequenceKeypoint.new(0.8, 0.3),
				NumberSequenceKeypoint.new(1, 1),
			})
			local keys = {}
			local n = #spec.Colors
			for index, color in ipairs(spec.Colors) do
				table.insert(keys, ColorSequenceKeypoint.new(n == 1 and (index - 1) or (index - 1) / (n - 1), color))
			end
			if n == 1 then
				table.insert(keys, ColorSequenceKeypoint.new(1, spec.Colors[1]))
			end
			emitter.Color = ColorSequence.new(keys)
			emitter.RotSpeed = NumberRange.new(-60, 60)
			emitter.Parent = volume
			table.insert(effects, emitter)
		end
	end

	------------------------------------------------------------------
	-- Nuit / jour, ambiance
	------------------------------------------------------------------
	local function paintViews()
		for _, holder in ipairs(viewHolders) do
			for _, child in ipairs(holder:GetChildren()) do
				child:Destroy()
			end
			local painted = false
			if HouseViews and type(HouseViews.Paint) == "function" and type(viewEntry) == "table" then
				local ok, err = pcall(HouseViews.Paint, holder, 200, 180, viewEntry, night)
				painted = ok
				if not ok then
					warn("[House3D] Vue : " .. tostring(err))
				end
			end
			if not painted then
				-- ciel dégradé + soleil / lune + nuage
				local sky = HousePatterns.Box(holder, 0, 0, 200, 180, WHITE, 0, 1)
				local gradient = Instance.new("UIGradient")
				gradient.Rotation = 90
				gradient.Color = night and ColorSequence.new(Color3.fromRGB(24, 22, 70), Color3.fromRGB(80, 60, 150))
					or ColorSequence.new(Color3.fromRGB(150, 214, 255), Color3.fromRGB(255, 214, 236))
				gradient.Parent = sky
				HousePatterns.Circle(holder, 140, 46, 40, 40, night and Color3.fromRGB(255, 244, 200) or Color3.fromRGB(255, 230, 130), 0, 2)
				if not night then
					HousePatterns.Cloud(holder, 60, 130, 80, WHITE, 0.05, 3)
				end
				local hill = HousePatterns.Circle(holder, 100, 200, 300, 90, night and Color3.fromRGB(60, 90, 90) or Color3.fromRGB(140, 214, 140), 0, 2)
				hill.Name = "Hill"
			end
		end
	end

	local function applyNight()
		for _, band in ipairs(skyBands) do
			if band.Index == 0 then
				band.Part.Color = night and Color3.fromRGB(96, 82, 150) or WHITE
			else
				band.Part.Color = (night and SKY_NIGHT or SKY_DAY)[band.Index]
			end
		end
		paintViews()
		local lampBoost = night and 1.7 or 0.9
		for _, entry in ipairs(itemLights) do
			entry.Light.Brightness = entry.Base * lampBoost * mood.Brightness
			entry.Light.Color = entry.Light.Color
		end
		local ceiling = ceilingLight
		if ceiling then
			ceiling.Brightness = (night and 0.8 or 0.7) * mood.Brightness
			ceiling.Color = night and Color3.fromRGB(255, 214, 170):Lerp(mood.Light, 0.5) or mood.Light
		end
		local fill = fillLight
		if fill then
			fill.Enabled = mood.Amount > 0.01
			fill.Color = mood.Tint
			fill.Brightness = mood.Amount * 1.2
		end
		local spot = sunLight
		if spot then
			spot.Brightness = (night and 0.8 or 2) * math.max(0.4, mood.Brightness)
			spot.Color = night and Color3.fromRGB(150, 170, 255) or Color3.fromRGB(255, 236, 200)
		end
	end
	applyNight()
	folder.Parent = workspace

	------------------------------------------------------------------
	-- Objets
	------------------------------------------------------------------
	local entries: { Placed } = {}
	local roomPlaced = roomData.Placed
	if type(roomPlaced) == "table" then
		for _, raw in ipairs(roomPlaced) do
			if type(raw) == "table" and type(raw.I) == "string" and HouseCommon.ItemsById[raw.I] then
				local entry: any = {
					I = raw.I,
					X = math.clamp(finite(raw.X, 0.5), 0, 1),
					Y = math.clamp(finite(raw.Y, 0.8), 0, 1),
					S = math.clamp(finite(raw.S, 1), 0.2, 3),
					Z = finite(raw.Z, 0),
					F = raw.F == true or nil,
					C = type(raw.C) == "string" and raw.C or nil,
				}
				table.insert(entries, entry)
			end
		end
	end

	-- 2D (px de la pièce) -> 3D : les murs de côté 2D prennent SIDE_PX en perspective
	local function mapX(x: number, t: number, half: number): number
		local sidePx = SIDE_PX * (1 - math.clamp(t, 0, 1))
		local px = (x * roomWpx - sidePx) / math.max(1, roomWpx - 2 * sidePx) * roomWpx
		local studs = (px - roomWpx / 2) * PX
		local limit = math.max(0, W / 2 - half - 0.1)
		return math.clamp(studs, -limit, limit)
	end
	local function depthOf(y: number): number
		return math.clamp((y - wallRatio) / math.max(0.05, 1 - wallRatio), 0, 1)
	end

	local itemFolder = Instance.new("Folder")
	itemFolder.Name = "Items"
	itemFolder.Parent = folder
	local staging = Instance.new("Folder")
	staging.Name = "Staging"

	local function tintFor(entry: any): (((Color3) -> Color3)?, ((root: Instance) -> ())?)
		local tintId = entry.C
		if not HouseTints or type(tintId) ~= "string" then
			return nil, nil
		end
		local mapper = nil
		if type(HouseTints.Mapper) == "function" then
			local ok, result = pcall(HouseTints.Mapper, entry.I, tintId)
			if ok and type(result) == "function" then
				mapper = function(color: Color3): Color3
					local okMap, mapped = pcall(result, color)
					return okMap and typeof(mapped) == "Color3" and mapped or color
				end
			end
		end
		local apply = nil
		if type(HouseTints.Apply) == "function" then
			apply = function(root: Instance)
				HouseTints.Apply(root, tintId)
			end
		end
		return mapper, apply
	end

	-- 1. dessin 2D (palette / carton) + modèle 3D (hors écran, repère de l'objet)
	local function prepare(entry: any, order: number): Build
		local item = HouseCommon.ItemsById[entry.I]
		local recipe, info = House3DRecipes.For(item)
		local mapper, apply = tintFor(entry)
		local painted = House3DKit.Paint(item, entry, apply)
		local k = (tonumber(item.Size) or 80) * entry.S * PX / 100
		local wall = item.Placement == "Wall"
		if not recipe and painted.Flat and not wall then
			recipe = House3DRecipes.For({ Id = "KnittedRug", Category = "Decor" })
			info.Flat = true
		end
		local build: Build = {
			Entry = entry,
			Item = item,
			Painted = painted,
			Recipe = recipe,
			Info = info,
			Model = nil,
			K = k,
			Kind = wall and "Wall" or (info.Flat and "Flat" or "Floor"),
			Parent = nil,
			Relation = nil,
			SeatKind = nil,
			SurfaceIndex = 1,
			Surface = nil,
			Origin = CFrame.identity,
			X = 0,
			Z = 0,
			FW = 100 * k,
			FD = 0.3,
			Yaw = 0,
			Placed = false,
			Order = order,
			Card = nil,
			LightScore = 0,
		}
		if recipe then
			local b = House3DKit.Builder(staging, CFrame.identity, k, entry.F == true, mapper, painted.Colors)
			b.Painted = painted
			local ctx = House3DRecipes.Context(item, trim)
			local ok, err = pcall(recipe, b, ctx)
			if ok and #b.Parts > 0 then
				build.Model = b
				build.FW = b.Width * k
				build.FD = math.max(0.2, b.Depth * k)
				-- dessus déclarés par HouseSurfaces mais pas par la recette
				local raw = ctx.Raw
				if raw then
					for index, surface in ipairs(raw) do
						if not b.Tops[index] and type(surface) == "table" then
							local x0, x1, y = tonumber(surface[1]) or 10, tonumber(surface[2]) or 90, tonumber(surface[3]) or 50
							b.Tops[index] = { X = ((x0 + x1) / 2 - 50) * (entry.F and -1 or 1), Y = 100 - y, Z = 0, W = x1 - x0, D = b.Depth * 0.8 }
						end
					end
				end
			else
				if not ok then
					warn("[House3D] Recette " .. tostring(item.Id) .. " : " .. tostring(err))
				end
				for _, p in ipairs(b.Parts) do
					p:Destroy()
				end
				-- (le dessin a pu partir avec les pièces : on le refait pour le carton)
				build.Painted = House3DKit.Paint(item, entry, apply)
			end
		end
		return build
	end

	-- 2. relations, positions
	local function layout(builds: { Build })
		local byEntry: { [Placed]: Build } = {}
		local list: { Placed } = {}
		for _, build in ipairs(builds) do
			byEntry[build.Entry] = build
			table.insert(list, build.Entry)
		end
		local seatedAt = (HouseSurfaces :: any).SeatedAt
		for _, build in ipairs(builds) do
			if build.Kind ~= "Wall" then
				local okSupport, support = pcall(HouseSurfaces.SupportOf, build.Entry, list, roomWpx, roomHpx)
				local supportEntry = okSupport and type(support) == "table" and support.Entry or nil
				if supportEntry and byEntry[supportEntry] and supportEntry ~= build.Entry then
					build.Parent = byEntry[supportEntry]
					build.Relation = "On"
					build.Surface = support
					build.SurfaceIndex = tonumber(support.Index) or 1
					if build.Kind == "Flat" then
						build.Kind = "Floor"
					end
				elseif type(seatedAt) == "function" and build.Kind == "Floor" then
					local okSeat, seat = pcall(seatedAt, build.Entry, list, roomWpx, roomHpx)
					local tableEntry = okSeat and type(seat) == "table" and seat.Table or nil
					if tableEntry and byEntry[tableEntry] and tableEntry ~= build.Entry then
						build.Parent = byEntry[tableEntry]
						build.Relation = "At"
						build.SeatKind = tostring(seat.Kind)
					end
				end
			end
		end
		-- (boucles éventuelles coupées)
		for _, build in ipairs(builds) do
			local node = build
			local steps = 0
			while node.Parent and steps < 8 do
				node = node.Parent :: Build
				steps += 1
			end
			if steps >= 8 then
				build.Parent = nil
				build.Relation = nil
			end
		end

		-- Racines au sol : du fond vers l'avant ; on écarte ce qui se chevauche
		local roots: { Build } = {}
		for _, build in ipairs(builds) do
			if build.Parent == nil then
				table.insert(roots, build)
			end
		end
		table.sort(roots, function(a, b)
			if a.Entry.Y ~= b.Entry.Y then
				return a.Entry.Y < b.Entry.Y
			end
			return a.Order < b.Order
		end)
		local placedFloor: { Build } = {}
		local wallRank = 0
		for _, build in ipairs(roots) do
			local entry = build.Entry
			if build.Kind == "Wall" then
				local half = math.min(build.FW / 2, W / 2)
				build.X = mapX(entry.X, 0, half)
				local centerY = math.clamp((wallPx - entry.Y * roomHpx) * PX, 0.4, WH - 0.2)
				wallRank += 1
				build.Z = 0.02 + wallRank * 0.01
				build.Origin = CFrame.new(at(build.X, centerY - 50 * build.K, build.Z))
			else
				local t = depthOf(entry.Y)
				local seat = HouseSurfaces.Seat(entry.I)
				if build.Model and seat and seat.View == "Side" then
					-- (chaise de profil en 2D : un peu tournée vers où elle regarde)
					build.Yaw = entry.F and -math.rad(35) or math.rad(35)
				end
				local fw, fd = build.FW, build.FD
				local half = fw / 2
				build.X = mapX(entry.X, t, half)
				local zFront = (t ^ DEPTH_CURVE) * D
				local z
				if build.Info.Wall and t < 0.55 then
					z = fd / 2 + 0.08
				else
					z = math.clamp(zFront - fd / 2, fd / 2 + 0.08, math.max(fd / 2 + 0.08, D - fd / 2 - 0.1))
				end
				if build.Kind == "Floor" and build.Model then
					-- chevauchement avec un objet déjà posé : on avance un peu
					for _ = 1, 6 do
						local moved = false
						for _, other in ipairs(placedFloor) do
							local overlapX = math.abs(other.X - build.X) < (other.FW + fw) / 2 - 0.15
							local overlapZ = math.abs(other.Z - z) < (other.FD + fd) / 2
							if overlapX and overlapZ then
								local pushed = other.Z + (other.FD + fd) / 2 + 0.05
								if pushed + fd / 2 <= D + 0.5 then
									z = pushed
									moved = true
								end
							end
						end
						if not moved then
							break
						end
					end
					table.insert(placedFloor, build)
				elseif build.Kind == "Floor" then
					-- carton : juste devant ce qui est déjà là
					z = math.clamp(zFront, 0.6, D - 0.3)
					for _, other in ipairs(placedFloor) do
						if math.abs(other.X - build.X) < (other.FW + fw) * 0.4 and math.abs(other.Z - z) < other.FD / 2 + 0.3 then
							z = math.min(D - 0.3, other.Z + other.FD / 2 + 0.3)
						end
					end
					build.FD = 0.3
					table.insert(placedFloor, build)
				end
				build.Z = z
				local lift = build.Kind == "Flat" and 0.01 + (#placedFloor % 5) * 0.004 or 0
				build.Origin = CFrame.new(at(build.X, lift, z)) * CFrame.Angles(0, build.Yaw, 0)
			end
			build.Placed = true
		end

		-- Membres des groupes (posés sur / rangés à)
		local function place(build: Build, guard: number)
			if build.Placed or guard > 10 then
				return
			end
			local parent = build.Parent
			if not parent then
				build.Placed = true
				return
			end
			place(parent, guard + 1)
			local entry = build.Entry
			if build.Relation == "On" then
				local surface = build.Surface
				local centerX = surface and ((tonumber(surface.L) or entry.X) + (tonumber(surface.R) or entry.X)) / 2 or parent.Entry.X
				local dx = (entry.X - centerX) * roomWpx * PX
				local model = parent.Model
				local top = model and model.Tops[build.SurfaceIndex]
				local base: CFrame
				if model and top then
					local k = parent.K
					dx = math.clamp(dx, -top.W * k / 2, top.W * k / 2)
					base = parent.Origin * CFrame.new(top.X * k, top.Y * k, top.Z * k)
				else
					-- meuble en carton : hauteur d'après la 2D, juste devant le carton
					local heightStuds = surface and (parent.Entry.Y - (tonumber(surface.Y) or parent.Entry.Y)) * roomHpx * PX or 0
					if parent.Kind == "Wall" then
						heightStuds = (tonumber(surface and surface.Y) or 0)
						heightStuds = (wallPx - heightStuds * roomHpx) * PX - (parent.Origin.Y - origin.Y)
					end
					base = parent.Origin * CFrame.new(0, math.max(0, heightStuds), 0.35)
				end
				local world = base.Position + Vector3.new(dx, 0, 0)
				build.X = world.X - origin.X
				build.Z = world.Z - origin.Z
				build.Origin = CFrame.new(world)
			else
				-- chaise à une table : de côté (tournée vers elle), derrière ou devant
				local tableX, tableZ = parent.X, parent.Z
				local tw, td = parent.FW, parent.FD
				local cd = build.FD
				local tuck = math.min(cd * 0.3, 0.8)
				local kind = build.SeatKind or "Front"
				local x, z, yaw = tableX, tableZ, 0
				local dx = (entry.X - parent.Entry.X) * roomWpx * PX
				if kind == "Left" then
					x = tableX - tw / 2 - cd / 2 + tuck
					yaw = math.pi / 2
				elseif kind == "Right" then
					x = tableX + tw / 2 + cd / 2 - tuck
					yaw = -math.pi / 2
				elseif kind == "Behind" then
					x = tableX + math.clamp(dx, -tw / 2, tw / 2)
					z = tableZ - td / 2 - cd / 2 + tuck
					yaw = 0
				else
					x = tableX + math.clamp(dx, -tw / 2, tw / 2)
					z = tableZ + td / 2 + cd / 2 - tuck
					yaw = math.pi
				end
				x = math.clamp(x, -W / 2 + 0.3, W / 2 - 0.3)
				z = math.clamp(z, 0.3, D + 0.6)
				build.X, build.Z, build.Yaw = x, z, yaw
				build.Origin = CFrame.new(at(x, 0, z)) * CFrame.Angles(0, yaw, 0)
				if build.Model == nil then
					-- (carton : face à la caméra, juste à côté)
					build.Origin = CFrame.new(at(x, 0, z))
				end
			end
			build.Placed = true
		end
		for _, build in ipairs(builds) do
			place(build, 0)
		end
	end

	-- 3. montage dans la pièce (+ arrivée en douceur)
	local lampCount = 0
	local function mount(build: Build, delay: number)
		local model = build.Model
		local parts: { BasePart } = {}
		local finals: { CFrame } = {}
		local holder = Instance.new("Folder")
		holder.Name = "Item_" .. tostring(build.Item.Id)
		holder.Parent = itemFolder
		if model then
			for index, p in ipairs(model.Parts) do
				local final = build.Origin * model.Locals[index]
				p.CFrame = final
				p.Parent = holder
				table.insert(parts, p)
				table.insert(finals, final)
			end
			for _, glow in ipairs(model.Glows) do
				table.insert(glowParts, glow)
			end
			for _, light in ipairs(model.Lights) do
				lampCount += 1
				if lampCount > MAX_LAMPS then
					light.Enabled = false
				end
				table.insert(itemLights, { Light = light, Base = light.Brightness })
				light.Brightness = light.Brightness * (night and 1.7 or 0.9) * mood.Brightness
			end
			-- petit tapis : pas d'ombre
			if build.Kind == "Flat" then
				for _, p in ipairs(parts) do
					p.CastShadow = false
				end
			end
		else
			local painted = build.Painted
			if not painted then
				return
			end
			local twoSided = build.Kind ~= "Wall"
			local cf = build.Origin
			if build.Kind == "Wall" then
				cf = cf * CFrame.new(0, 50 * build.K, 0.08)
			end
			local card = House3DKit.Card(holder, cf, painted, build.K, twoSided, 0.6)
			build.Card = card
			table.insert(parts, card)
			table.insert(finals, card.CFrame)
			-- petit socle en bois sous les cartons posés au sol
			if build.Kind == "Floor" and build.Relation ~= "On" then
				local base = newPart("Part", "CardStand", Vector3.new(math.max(0.6, 60 * build.K), 0.18, 0.7), build.Origin * CFrame.new(0, 0.09, 0), Color3.fromRGB(214, 170, 130), M.Wood)
				base.Parent = holder
				table.insert(parts, base)
				table.insert(finals, base.CFrame)
			end
			if painted.Glow and lampCount < MAX_LAMPS then
				lampCount += 1
				local light = Instance.new("PointLight")
				light.Color = painted.Glow
				light.Range = math.clamp(4 + 100 * build.K * 1.4, 6, 16)
				light.Brightness = 0.8 * (night and 1.7 or 0.9) * mood.Brightness
				light.Shadows = false
				light.Parent = card
				table.insert(itemLights, { Light = light, Base = 0.8 })
			end
		end
		for index, p in ipairs(parts) do
			p.CFrame = finals[index] + Vector3.new(0, DROP, 0)
		end
		table.insert(arrivals, { Parts = parts, Finals = finals, Delay = delay, Clock = 0 })
	end

	------------------------------------------------------------------
	-- Scène (objet renvoyé)
	------------------------------------------------------------------
	local scene: Scene
	scene = {
		Folder = folder,
		Width = W,
		Depth = D,
		WallHeight = WH,
		Focus = at(0, WH * 0.36, D * 0.5),
		BoundsMin = at(-W / 2 - WALL_T, -SLAB, -WALL_T),
		BoundsMax = at(W / 2 + WALL_T, WH + 0.7, D + 0.3),
		FrontZ = origin.Z + D,
		ItemCount = #entries,
		BuildItems = function(alive: () -> boolean, progress: ((done: number, total: number) -> ())?)
			local total = #entries * 2
			local done = 0
			local builds: { Build } = {}
			local started = os.clock()
			local count = 0
			local function breathe(): boolean
				count += 1
				if count >= BATCH_ITEMS or os.clock() - started > BATCH_TIME then
					if progress then
						pcall(progress, done, total)
					end
					task.wait()
					started = os.clock()
					count = 0
				end
				return alive() and not destroyed
			end
			for index, entry in ipairs(entries) do
				local ok, result = pcall(prepare, entry, index)
				if ok then
					table.insert(builds, result)
				else
					warn("[House3D] Objet " .. tostring(entry.I) .. " : " .. tostring(result))
				end
				done += 1
				if not breathe() then
					return
				end
			end
			local okLayout, err = pcall(layout, builds)
			if not okLayout then
				warn("[House3D] Disposition : " .. tostring(err))
				for _, build in ipairs(builds) do
					if not build.Placed then
						local z = math.clamp(depthOf(build.Entry.Y) * D, 0.6, D - 0.3)
						build.Origin = CFrame.new(at(mapX(build.Entry.X, depthOf(build.Entry.Y), 0), 0, z))
					end
				end
			end
			if not alive() or destroyed then
				return
			end
			-- les plus grosses lampes d'abord (elles reçoivent une vraie lumière)
			local order = table.clone(builds)
			table.sort(order, function(a, b)
				if a.Entry.Y ~= b.Entry.Y then
					return a.Entry.Y < b.Entry.Y
				end
				return a.Order < b.Order
			end)
			for index, build in ipairs(order) do
				local ok, mountErr = pcall(mount, build, 0.05 + math.min(1.2, index * 0.04))
				if not ok then
					warn("[House3D] Objet " .. tostring(build.Entry.I) .. " : " .. tostring(mountErr))
				end
				done += 1
				if not breathe() then
					return
				end
			end
			applyNight()
			if progress then
				pcall(progress, total, total)
			end
		end,
		SetNight = function(value: boolean)
			if night == value then
				return
			end
			night = value
			applyNight()
		end,
		-- Éclairage du lieu pendant la vue (House3D le remet à la fermeture)
		Lighting = function(isNight: boolean): { [string]: any }
			local tint = mood.Tint
			local amount = mood.Amount
			local ambientDay = Color3.fromRGB(150, 140, 160):Lerp(tint, amount * 0.5)
			local ambientNight = Color3.fromRGB(64, 56, 110):Lerp(tint, amount * 0.4)
			local bright = mood.Brightness
			return {
				ClockTime = isNight and 0.5 or 14.5,
				Brightness = (isNight and 0.35 or 2.2) * math.clamp(bright, 0.5, 1.3),
				Ambient = isNight and ambientNight or ambientDay,
				OutdoorAmbient = isNight and Color3.fromRGB(70, 64, 120):Lerp(tint, amount * 0.4) or Color3.fromRGB(170, 164, 184):Lerp(tint, amount * 0.5),
				ColorShift_Top = isNight and Color3.fromRGB(40, 40, 90) or tint:Lerp(BLACK, 1 - amount * 0.35),
				ColorShift_Bottom = BLACK,
				EnvironmentDiffuseScale = 0.5,
				EnvironmentSpecularScale = 0.4,
				ExposureCompensation = isNight and 0.15 or 0,
				GlobalShadows = true,
				ShadowSoftness = 0.35,
				FogStart = 0,
				FogEnd = 100000,
				GeographicLatitude = 23,
			}
		end,
		UpdateWalls = function(eye: Vector3)
			local localX = eye.X - origin.X
			for _, wall in ipairs(sideWalls) do
				local outside = wall.Side * localX > W / 2 + 0.6
				local inside = wall.Side * localX < W / 2 - 1.2
				local lower = nil
				if outside and not wall.Lowered then
					lower = true
				elseif inside and wall.Lowered then
					lower = false
				end
				if lower ~= nil then
					wall.Lowered = lower
					local height = lower and 1.2 or WH
					local x = wall.Side * (W / 2 + SKIN + WALL_T / 2)
					wall.Shell.Size = Vector3.new(WALL_T, height + 0.4, D + WALL_T + SKIN)
					wall.Shell.CFrame = CFrame.new(at(x, (height + 0.4) / 2 - 0.2, (D - WALL_T - SKIN) / 2))
					local right = wall.Side < 0 and BACKWARD or -BACKWARD
					local normal = right:Cross(Y_AXIS)
					wall.Skin.Size = Vector3.new(D, height, SKIN)
					wall.Skin.CFrame = CFrame.fromMatrix(at(wall.Side * W / 2, height / 2, D / 2) - normal * (SKIN / 2), right, Y_AXIS)
					wall.Crown.CFrame = CFrame.new(at(wall.Side * (W / 2 - 0.18), height - crownH / 2, D / 2))
					wall.Edge.Size = Vector3.new(WALL_T + SKIN + 0.1, height + 0.4, 0.2)
					wall.Edge.CFrame = CFrame.new(at(wall.Side * (W / 2 + (WALL_T + SKIN) / 2), (height + 0.4) / 2 - 0.2, D + 0.05))
					local gui = wall.Gui
					if gui then
						gui.Enabled = not lower
					end
				end
			end
		end,
		Step = function(dt: number)
			if #arrivals > 0 then
				for index = #arrivals, 1, -1 do
					local arrival = arrivals[index]
					arrival.Clock += dt
					local t = math.clamp((arrival.Clock - arrival.Delay) / DROP_TIME, 0, 1)
					-- (petit rebond à l'arrivée)
					local s = 1.70158
					local eased = 1 + (s + 1) * (t - 1) ^ 3 + s * (t - 1) ^ 2
					local offset = Vector3.new(0, DROP * (1 - eased), 0)
					for i, p in ipairs(arrival.Parts) do
						p.CFrame = arrival.Finals[i] + offset
					end
					if t >= 1 then
						for i, p in ipairs(arrival.Parts) do
							p.CFrame = arrival.Finals[i]
						end
						table.remove(arrivals, index)
					end
				end
			end
			if mood.Effect == "Storm" then
				-- éclair de temps en temps (lumière de remplissage)
				stormClock += dt
				local fill = fillLight
				if fill then
					if stormClock > 6 then
						stormClock = 0
					end
					local flash = (stormClock < 0.12 or (stormClock > 0.25 and stormClock < 0.33)) and 3 or 0
					fill.Enabled = true
					fill.Color = Color3.fromRGB(210, 225, 255)
					fill.Brightness = mood.Amount * 1.2 + flash
				end
			end
			if mood.Effect == "Disco" or mood.Effect == "RGB" or mood.Effect == "Neon" then
				discoClock += dt
				local ceiling = ceilingLight
				if ceiling and discoClock > 0.25 then
					discoClock = 0
					ceiling.Color = Color3.fromHSV((os.clock() * 0.2) % 1, 0.5, 1)
				end
			end
		end,
		Destroy = function()
			destroyed = true
			for _, emitter in ipairs(effects) do
				pcall(function()
					emitter.Enabled = false
				end)
			end
			folder:Destroy()
			staging:Destroy()
		end,
	}
	return scene
end

return House3DScene
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">HouseArt</string>
              <string name="Source"><![CDATA[--[[
	HouseArt (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > HouseArt

	Dessins "autocollants kawaii" des objets de la maison, faits UNIQUEMENT
	avec des Frames (aucune image à importer) :
	  - une boîte à outils (Kit) : formes arrondies avec contour et ombrage,
	    ovales, traits, triangles, cœurs, étincelles, nuages, petits visages
	    kawaii, reflets, pivots de rotation et petites animations ;
	  - les dessins eux-mêmes, rangés par catégorie dans le dossier Art
	    (un ModuleScript par catégorie : { [Id d'objet] = peintre }).

	Contrat d'un peintre : function(body, kit, item) -> Result?
	  - `body` est une boîte de 100 x 100 px ("maquette") ; les objets posés
	    au sol ont leurs pieds en bas (y = 100), les objets muraux sont
	    centrés. On peut déborder un peu (fil d'une ampoule...).
	  - ZIndex relatifs (ZIndexBehavior = Sibling) : 1..9 entre frères.
	  - Result (tout est facultatif) :
	      Glow       = Color3 : halo de lumière (plus fort la nuit)
	      Flat       = true : objet posé à plat (tapis) -> pas d'ombre ovale
	      WallShadow = Vector2 : taille de l'ombre d'un objet mural (0 = aucune)
	      Bulbs      = { ampoule, halo, ampoule, halo... } : scintillement
	      ShowEmoji  = true : garde l'emoji de l'objet par-dessus (rare)
	      EmojiScale, EmojiY : taille / hauteur de cet emoji

	API :
	  HouseArt.Has(itemId) -> boolean
	  HouseArt.Paint(body, item, static?) -> (Result?, { Anim })
	      dessine l'objet dans `body` ; `static` = pas d'animation (vignettes)
	  HouseArt.Thumbnail(parent, item, size, zIndex?) -> Frame
	      vignette carrée de `size` px (dessin, ou emoji si pas de dessin)
	  HouseArt.PaintGarden(body, entry, static?) : (v9.1) déco du jardin
	      (dossier GardenArt, Config.House.GardenDecor)
	  HouseArt.NewKit(static?) -> (kit, anims) : (v9.2) la boîte à outils seule
	      (chapeaux et boutons dessinés : Components > CosmeticArt)
	  HouseArt.Step(anims, clock) : fait vivre les animations
	  HouseArt.Mirror(root, anims) : retourne le dessin gauche <-> droite
	      (les animaux qui se promènent regardent où ils vont) ; le refaire
	      remet le dessin à l'endroit
]]

local HouseArt = {}

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local SQRT2 = math.sqrt(2)
local FONT = Enum.Font.FredokaOne

-- Palette kawaii (mêmes teintes que HouseCommon.Colors + quelques couleurs)
local C = {
	White = WHITE,
	Black = BLACK,
	Ink = Color3.fromRGB(92, 58, 96), -- contours / yeux "chocolat-prune"
	Pink = Color3.fromRGB(255, 126, 182),
	PinkDeep = Color3.fromRGB(236, 72, 140),
	PinkSoft = Color3.fromRGB(255, 214, 232),
	PinkMist = Color3.fromRGB(255, 240, 247),
	Blush = Color3.fromRGB(255, 150, 170),
	Lilac = Color3.fromRGB(183, 148, 246),
	LilacSoft = Color3.fromRGB(236, 224, 255),
	Purple = Color3.fromRGB(150, 100, 220),
	Mint = Color3.fromRGB(110, 214, 176),
	MintSoft = Color3.fromRGB(214, 247, 234),
	Green = Color3.fromRGB(110, 190, 110),
	Leaf = Color3.fromRGB(120, 200, 120),
	LeafDark = Color3.fromRGB(70, 150, 90),
	Cream = Color3.fromRGB(255, 247, 236),
	Peach = Color3.fromRGB(255, 190, 160),
	Orange = Color3.fromRGB(255, 160, 90),
	Sky = Color3.fromRGB(150, 205, 255),
	Blue = Color3.fromRGB(100, 160, 240),
	Navy = Color3.fromRGB(60, 70, 130),
	Butter = Color3.fromRGB(255, 226, 130),
	Yellow = Color3.fromRGB(255, 210, 80),
	Gold = Color3.fromRGB(245, 190, 60),
	Red = Color3.fromRGB(240, 90, 100),
	Heart = Color3.fromRGB(255, 79, 139),
	Wood = Color3.fromRGB(214, 164, 120),
	WoodLight = Color3.fromRGB(236, 196, 150),
	WoodDark = Color3.fromRGB(160, 110, 78),
	Brown = Color3.fromRGB(150, 100, 80),
	Grey = Color3.fromRGB(200, 196, 210),
	GreyDark = Color3.fromRGB(120, 116, 136),
	Glass = Color3.fromRGB(200, 235, 255),
}
HouseArt.Colors = C

export type Result = {
	Glow: Color3?,
	Flat: boolean?,
	WallShadow: Vector2?,
	Bulbs: { Frame }?,
	ShowEmoji: boolean?,
	EmojiScale: number?,
	EmojiY: number?,
}

export type Anim = {
	Object: GuiObject,
	Kind: string,
	Amp: number,
	Speed: number,
	Phase: number,
	BaseRotation: number,
	BasePosition: UDim2,
	BaseTransparency: number,
	Scale: UIScale?,
}

type PartOptions = {
	Radius: number?, -- rayon des coins en px (défaut : 6) ; -1 = pilule / ovale
	Z: number?,
	T: number?, -- transparence du fond
	Outline: any?, -- false = sans contour ; Color3 = couleur ; défaut = teinte foncée
	Thickness: number?, -- épaisseur du contour (défaut 1.6)
	Shade: any?, -- false = sans ombrage ; nombre = force (défaut 0.12)
	Shine: boolean?, -- petit reflet blanc en haut à gauche
	Rotation: number?,
}

----------------------------------------------------------------------
-- Couleurs
----------------------------------------------------------------------

local function lighten(color: Color3, amount: number): Color3
	return color:Lerp(WHITE, amount)
end

local function darken(color: Color3, amount: number): Color3
	return color:Lerp(BLACK, amount)
end

-- Contour "kawaii" : la couleur tirée vers l'encre prune
local function outlineOf(color: Color3): Color3
	return color:Lerp(C.Ink, 0.55)
end

----------------------------------------------------------------------
-- Formes de base
----------------------------------------------------------------------

local function box(parent: Instance, x: number, y: number, w: number, h: number, color: Color3, transparency: number?, z: number?): Frame
	local frame = Instance.new("Frame")
	frame.BorderSizePixel = 0
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = transparency or 0
	frame.Position = UDim2.fromOffset(x, y)
	frame.Size = UDim2.fromOffset(w, h)
	frame.ZIndex = z or 2
	frame.Parent = parent
	return frame
end

local function round(frame: GuiObject, radius: number?)
	local corner = Instance.new("UICorner")
	if radius == nil or radius < 0 then
		corner.CornerRadius = UDim.new(1, 0)
	else
		corner.CornerRadius = UDim.new(0, radius)
	end
	corner.Parent = frame
	return corner
end

local function stroke(frame: GuiObject, color: Color3, thickness: number?, transparency: number?): UIStroke
	local line = Instance.new("UIStroke")
	line.Color = color
	line.Thickness = thickness or 1.6
	line.Transparency = transparency or 0
	line.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	line.LineJoinMode = Enum.LineJoinMode.Round
	line.Parent = frame
	return line
end

-- Dégradé de couleur (multiplie la couleur du fond) ; rotation 90 = haut -> bas
local function gradient(frame: GuiObject, top: Color3, bottom: Color3, rotation: number?): UIGradient
	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new(top, bottom)
	grad.Rotation = rotation or 90
	grad.Parent = frame
	return grad
end

-- Dégradé de transparence (fondu) ; rotation 90 = haut -> bas
local function fade(frame: GuiObject, from: number, to: number, rotation: number?): UIGradient
	local grad = Instance.new("UIGradient")
	grad.Transparency = NumberSequence.new(from, to)
	grad.Rotation = rotation or 90
	grad.Parent = frame
	return grad
end

local function circle(parent: Instance, cx: number, cy: number, w: number, h: number, color: Color3, transparency: number?, z: number?): Frame
	local frame = box(parent, cx - w / 2, cy - h / 2, w, h, color, transparency, z)
	round(frame)
	return frame
end

-- Forme "kawaii" : fond + contour foncé + ombrage vertical (+ reflet)
local function part(parent: Instance, x: number, y: number, w: number, h: number, color: Color3, options: PartOptions?): Frame
	local opts: PartOptions = options or {}
	local frame = box(parent, x, y, w, h, color, opts.T, opts.Z)
	local radius = opts.Radius
	if radius == nil then
		radius = 6
	end
	if radius ~= 0 then
		round(frame, radius)
	end
	if opts.Rotation then
		frame.Rotation = opts.Rotation
	end
	local outline = opts.Outline
	if outline ~= false then
		local lineColor = if typeof(outline) == "Color3" then outline else outlineOf(color)
		stroke(frame, lineColor, opts.Thickness or 1.6, 0)
	end
	local shade = opts.Shade
	if shade ~= false then
		local amount = if type(shade) == "number" then shade else 0.12
		gradient(frame, WHITE, Color3.new(1 - amount, 1 - amount, 1 - amount), 90)
	end
	if opts.Shine then
		local shine = box(frame, math.max(2, w * 0.14), math.max(2, h * 0.12), math.max(3, w * 0.26), math.max(2, math.min(6, h * 0.14)), WHITE, 0.35, 3)
		round(shine)
	end
	return frame
end

-- Ovale "kawaii" (même style que part)
local function blob(parent: Instance, cx: number, cy: number, w: number, h: number, color: Color3, options: PartOptions?): Frame
	local opts: PartOptions = options or {}
	local copy: PartOptions = {
		Radius = -1,
		Z = opts.Z,
		T = opts.T,
		Outline = opts.Outline,
		Thickness = opts.Thickness,
		Shade = opts.Shade,
		Shine = opts.Shine,
		Rotation = opts.Rotation,
	}
	return part(parent, cx - w / 2, cy - h / 2, w, h, color, copy)
end

-- Trait (segment arrondi) entre deux points
local function line(parent: Instance, x1: number, y1: number, x2: number, y2: number, thickness: number, color: Color3, transparency: number?, z: number?): Frame
	local dx, dy = x2 - x1, y2 - y1
	local length = math.sqrt(dx * dx + dy * dy)
	local frame = box(parent, 0, 0, length + thickness, thickness, color, transparency, z)
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2)
	frame.Rotation = math.deg(math.atan2(dy, dx))
	round(frame)
	return frame
end

-- Triangle pointe en haut (tranches horizontales) ; `top` = y de la pointe
local function triangle(parent: Instance, cx: number, top: number, w: number, h: number, color: Color3, z: number?, transparency: number?, slices: number?): Frame
	local holder = box(parent, cx - w / 2, top, w, h, color, 1, z)
	local count = slices or math.clamp(math.floor(h / 2), 4, 24)
	for index = 1, count do
		local k = index / count
		local sliceW = w * k
		box(holder, (w - sliceW) / 2, (index - 1) * h / count, sliceW, h / count + 0.6, color, transparency, 1)
	end
	return holder
end

-- Triangle pointe en bas ; `top` = y de la base
local function triangleDown(parent: Instance, cx: number, top: number, w: number, h: number, color: Color3, z: number?, transparency: number?, slices: number?): Frame
	local holder = box(parent, cx - w / 2, top, w, h, color, 1, z)
	local count = slices or math.clamp(math.floor(h / 2), 4, 24)
	for index = 1, count do
		local k = 1 - (index - 1) / count
		local sliceW = w * k
		box(holder, (w - sliceW) / 2, (index - 1) * h / count, sliceW, h / count + 0.6, color, transparency, 1)
	end
	return holder
end

local function diamond(parent: Instance, cx: number, cy: number, side: number, color: Color3, transparency: number?, z: number?): Frame
	local frame = box(parent, 0, 0, side, side, color, transparency, z)
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromOffset(cx, cy)
	frame.Rotation = 45
	return frame
end

-- Cœur (2 cercles + un losange) centré, de largeur `width` ; renvoie son conteneur
local function heart(parent: Instance, cx: number, cy: number, width: number, color: Color3, transparency: number?, z: number?): Frame
	local holder = box(parent, cx - width / 2, cy - width / 2, width, width, color, 1, z)
	local a = width / (1 + 1 / SQRT2)
	local centerY = width / 2 + a * 0.073
	local offset = a / (2 * SQRT2)
	diamond(holder, width / 2, centerY, a, color, transparency, 1)
	circle(holder, width / 2 - offset, centerY - offset, a, a, color, transparency, 1)
	circle(holder, width / 2 + offset, centerY - offset, a, a, color, transparency, 1)
	return holder
end

-- Étincelle à 4 branches ; renvoie son conteneur
local function sparkle(parent: Instance, cx: number, cy: number, size: number, color: Color3, transparency: number?, z: number?): Frame
	local holder = box(parent, cx - size / 2, cy - size / 2, size, size, color, 1, z)
	diamond(holder, size / 2, size / 2, size * 0.36, color, transparency, 1)
	local thin = math.max(1, size * 0.14)
	local vertical = box(holder, size / 2 - thin / 2, 0, thin, size, color, transparency, 1)
	round(vertical)
	local horizontal = box(holder, 0, size / 2 - thin / 2, size, thin, color, transparency, 1)
	round(horizontal)
	return holder
end

-- Nuage (base arrondie + 2 bosses), `cy` = bas du nuage ; renvoie son conteneur
local function cloud(parent: Instance, cx: number, cy: number, width: number, color: Color3, transparency: number?, z: number?): Frame
	local height = width * 0.62
	local holder = box(parent, cx - width / 2, cy - height, width, height, color, 1, z)
	local baseH = width * 0.34
	local base = box(holder, 0, height - baseH, width, baseH, color, transparency, 1)
	round(base)
	circle(holder, width * 0.36, height - baseH, width * 0.5, width * 0.5, color, transparency, 1)
	circle(holder, width * 0.7, height - baseH * 0.9, width * 0.36, width * 0.36, color, transparency, 1)
	return holder
end

-- Reflet blanc (pilule semi-transparente)
local function shine(parent: Instance, x: number, y: number, w: number, h: number, z: number?, transparency: number?): Frame
	local frame = box(parent, x, y, w, h, WHITE, transparency or 0.35, z or 5)
	round(frame)
	return frame
end

-- Texte / petit emoji d'accent (centré)
local function text(parent: Instance, value: string, cx: number, cy: number, size: number, color: Color3?, z: number?): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.fromOffset(cx, cy)
	label.Size = UDim2.fromOffset(size * 3, size * 1.3)
	label.Font = FONT
	label.Text = value
	label.TextSize = size
	label.TextColor3 = color or C.Ink
	label.ZIndex = z or 6
	label.Parent = parent
	return label
end

-- Conteneur transparent (pour grouper, découper avec clip = true)
local function group(parent: Instance, x: number, y: number, w: number, h: number, z: number?, clip: boolean?): Frame
	local frame = box(parent, x, y, w, h, WHITE, 1, z)
	frame.ClipsDescendants = clip == true
	return frame
end

-- Pivot : conteneur de taille nulle placé en (px, py). Ses enfants se placent
-- par rapport à ce point et tournent autour de lui (balancier, hélice...)
local function pivot(parent: Instance, px: number, py: number, z: number?): Frame
	local frame = box(parent, px, py, 0, 0, WHITE, 1, z)
	return frame
end

----------------------------------------------------------------------
-- Visage kawaii
----------------------------------------------------------------------

type FaceOptions = {
	Eyes: string?, -- "dot" (défaut) | "happy" (^ ^) | "closed" (endormi) | "big" (yeux brillants)
	Mouth: string?, -- "smile" (défaut) | "cat" (ω) | "o" | "none"
	Blush: boolean?, -- défaut true
	Color: Color3?, -- couleur des yeux / de la bouche
	Z: number?,
	Spacing: number?, -- écart entre les yeux (fraction de size, défaut 0.62)
}

-- Visage centré en (cx, cy), `size` ≈ largeur du visage ; renvoie son conteneur
-- (les yeux "dot" / "big" clignent tout seuls si le kit est animé)
local function makeFace(kit: any, parent: Instance, cx: number, cy: number, size: number, options: FaceOptions?): Frame
	local opts: FaceOptions = options or {}
	local ink = opts.Color or C.Ink
	local holder = group(parent, cx - size / 2, cy - size / 2, size, size, opts.Z or 6)
	local half = size / 2
	local gap = size * (opts.Spacing or 0.62) / 2
	local eyeY = half - size * 0.08
	local eyes = opts.Eyes or "dot"
	local eyeSize = math.max(2, size * 0.16)
	local eyeFrames = {}
	for _, side in ipairs({ -1, 1 }) do
		local ex = half + side * gap
		if eyes == "happy" then
			line(holder, ex - eyeSize * 0.55, eyeY + eyeSize * 0.25, ex, eyeY - eyeSize * 0.3, math.max(1, size * 0.06), ink, 0, 2)
			line(holder, ex, eyeY - eyeSize * 0.3, ex + eyeSize * 0.55, eyeY + eyeSize * 0.25, math.max(1, size * 0.06), ink, 0, 2)
		elseif eyes == "closed" then
			line(holder, ex - eyeSize * 0.6, eyeY, ex + eyeSize * 0.6, eyeY, math.max(1, size * 0.06), ink, 0, 2)
		else
			local big = eyes == "big"
			local w = big and eyeSize * 1.35 or eyeSize
			local h = big and eyeSize * 1.6 or eyeSize * 1.15
			local eye = circle(holder, ex, eyeY, w, h, ink, 0, 2)
			local dot = circle(eye, w * 0.32, h * 0.3, w * 0.42, w * 0.42, WHITE, 0, 2)
			dot.AnchorPoint = Vector2.new(0.5, 0.5)
			dot.Position = UDim2.fromOffset(w * 0.34, h * 0.3)
			table.insert(eyeFrames, eye)
		end
		if opts.Blush ~= false then
			circle(holder, ex + side * size * 0.1, eyeY + size * 0.16, size * 0.2, size * 0.11, C.Blush, 0.35, 1)
		end
	end
	local mouth = opts.Mouth or "smile"
	local my = eyeY + size * 0.12
	local mw = size * 0.12
	local thick = math.max(1, size * 0.055)
	if mouth == "smile" then
		line(holder, half - mw / 2, my - mw * 0.2, half, my + mw * 0.25, thick, ink, 0, 2)
		line(holder, half, my + mw * 0.25, half + mw / 2, my - mw * 0.2, thick, ink, 0, 2)
	elseif mouth == "cat" then
		for _, side in ipairs({ -1, 1 }) do
			local ox = half + side * mw * 0.45
			line(holder, ox - mw * 0.45, my - mw * 0.15, ox, my + mw * 0.25, thick, ink, 0, 2)
			line(holder, ox, my + mw * 0.25, ox + mw * 0.45, my - mw * 0.15, thick, ink, 0, 2)
		end
	elseif mouth == "o" then
		local o = circle(holder, half, my + mw * 0.2, mw * 1.1, mw * 1.3, ink, 0, 2)
		circle(o, mw * 0.55, mw * 0.95, mw * 0.7, mw * 0.5, C.Blush, 0, 2)
	end
	for index, eye in ipairs(eyeFrames) do
		kit.Animate(eye, "Blink", 1, 1, index * 0.001 + (cx + cy) * 0.37)
	end
	return holder
end

----------------------------------------------------------------------
-- Kit (une instance par dessin : elle collecte les animations)
----------------------------------------------------------------------

local function newKit(static: boolean)
	local anims: { Anim } = {}
	local kit: any = {
		C = C,
		Static = static,
		Lighten = lighten,
		Darken = darken,
		OutlineOf = outlineOf,
		Box = box,
		Round = round,
		Stroke = stroke,
		Gradient = gradient,
		Fade = fade,
		Circle = circle,
		Part = part,
		Blob = blob,
		Line = line,
		Triangle = triangle,
		TriangleDown = triangleDown,
		Diamond = diamond,
		Heart = heart,
		Sparkle = sparkle,
		Cloud = cloud,
		Shine = shine,
		Text = text,
		Group = group,
		Pivot = pivot,
	}

	-- Animation d'un objet :
	--   "Sway"    : balancement, Amp = degrés
	--   "Spin"    : rotation continue, Speed = tours par seconde (Amp ignoré)
	--   "Bob"     : monte et descend, Amp = px
	--   "Drift"   : glisse de gauche à droite, Amp = px
	--   "Pulse"   : la transparence du fond varie de Amp (lueur, écran)
	--   "Flicker" : petite flamme qui vacille (transparence irrégulière, Amp)
	--   "Breathe" : grossit / rétrécit un peu, Amp = fraction (0.04 = 4 %)
	--   "Blink"   : les yeux clignent de temps en temps (Amp ignoré)
	function kit.Animate(object: GuiObject, kind: string, amp: number?, speed: number?, phase: number?)
		if static then
			return
		end
		local anim: Anim = {
			Object = object,
			Kind = kind,
			Amp = amp or 1,
			Speed = speed or 1,
			Phase = phase or 0,
			BaseRotation = object.Rotation,
			BasePosition = object.Position,
			BaseTransparency = object.BackgroundTransparency,
			Scale = nil,
		}
		if kind == "Breathe" or kind == "Flicker" then
			local existing = object:FindFirstChildOfClass("UIScale")
			anim.Scale = existing or Instance.new("UIScale")
			if not existing then
				(anim.Scale :: UIScale).Parent = object
			end
		end
		table.insert(anims, anim)
	end

	function kit.Face(parent: Instance, cx: number, cy: number, size: number, options: FaceOptions?): Frame
		return makeFace(kit, parent, cx, cy, size, options)
	end

	return kit, anims
end

----------------------------------------------------------------------
-- Registre des dessins (dossier Art)
----------------------------------------------------------------------

type Painter = (Frame, any, any) -> Result?

local painters: { [string]: Painter } = {}

local artFolder = script.Parent:FindFirstChild("Art")
if artFolder then
	for _, moduleScript in ipairs(artFolder:GetChildren()) do
		if moduleScript:IsA("ModuleScript") then
			local ok, result = pcall(require, moduleScript)
			if ok and type(result) == "table" then
				for id, painter in pairs(result) do
					if type(id) == "string" and type(painter) == "function" then
						painters[id] = painter
					end
				end
			else
				warn("[HouseArt] Dessins " .. moduleScript.Name .. " : " .. tostring(result))
			end
		end
	end
end

-- (v9.1) Déco du jardin (Config.House.GardenDecor) : dossier GardenArt,
-- même contrat (boîte 100 x 100, pieds en bas)
local gardenPainters: { [string]: Painter } = {}
local gardenFolder = script.Parent:FindFirstChild("GardenArt")
if gardenFolder then
	for _, moduleScript in ipairs(gardenFolder:GetChildren()) do
		if moduleScript:IsA("ModuleScript") then
			local ok, result = pcall(require, moduleScript)
			if ok and type(result) == "table" then
				for id, painter in pairs(result) do
					if type(id) == "string" and type(painter) == "function" then
						gardenPainters[id] = painter
					end
				end
			else
				warn("[HouseArt] Jardin " .. moduleScript.Name .. " : " .. tostring(result))
			end
		end
	end
end

-- (v9.2) Boîte à outils de dessin pour d'autres modules (chapeaux et boutons
-- de la boutique d'objets : CosmeticArt) ; `static` = sans animation
function HouseArt.NewKit(static: boolean?): (any, { Anim })
	return newKit(static == true)
end

function HouseArt.HasGarden(decorId: string): boolean
	return gardenPainters[decorId] ~= nil
end

-- Dessine une déco du jardin dans `body` (100 x 100) ; sinon son emoji
function HouseArt.PaintGarden(body: Frame, entry: any, static: boolean?): (Result?, { Anim })
	local painter = gardenPainters[entry.Id]
	if painter then
		local kit, anims = newKit(static == true)
		local ok, result = pcall(painter, body, kit, entry)
		if ok then
			return (type(result) == "table" and result or {}) :: Result, anims
		end
		warn("[HouseArt] Jardin " .. tostring(entry.Id) .. " : " .. tostring(result))
		for _, child in ipairs(body:GetChildren()) do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
	end
	local label = text(body, tostring(entry.Icon or "🌷"), 50, 60, 60, WHITE, 2)
	label.Font = Enum.Font.BuilderSansMedium
	return nil, {}
end

function HouseArt.Has(itemId: string): boolean
	return painters[itemId] ~= nil
end

-- Dessine l'objet dans `body` (100 x 100) ; nil si l'objet n'a pas de dessin
function HouseArt.Paint(body: Frame, item: any, static: boolean?): (Result?, { Anim })
	local painter = painters[item.Id]
	if not painter then
		return nil, {}
	end
	local kit, anims = newKit(static == true)
	local ok, result = pcall(painter, body, kit, item)
	if not ok then
		warn("[HouseArt] Dessin " .. tostring(item.Id) .. " : " .. tostring(result))
		for _, child in ipairs(body:GetChildren()) do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		return nil, {}
	end
	return (type(result) == "table" and result or {}) :: Result, anims
end

-- Vignette carrée (boutique, inventaire) : le dessin réduit, sinon l'emoji
function HouseArt.Thumbnail(parent: Instance, item: any, size: number, zIndex: number?): Frame
	local holder = Instance.new("Frame")
	holder.Name = "Art"
	holder.BackgroundTransparency = 1
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.Position = UDim2.fromScale(0.5, 0.5)
	holder.Size = UDim2.fromOffset(size, size)
	holder.ZIndex = zIndex or 1
	local body = Instance.new("Frame")
	body.Name = "Body"
	body.BackgroundTransparency = 1
	body.AnchorPoint = Vector2.new(0.5, 0.5)
	body.Position = UDim2.fromScale(0.5, 0.5)
	body.Size = UDim2.fromOffset(100, 100)
	body.ZIndex = 1
	local scale = Instance.new("UIScale")
	-- Un peu de marge : certains dessins débordent de leur boîte
	scale.Scale = size / 100 * 0.84
	scale.Parent = body
	body.Parent = holder
	local result = HouseArt.Paint(body, item, true)
	if not result then
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = Enum.Font.BuilderSansMedium
		label.Text = tostring(item.Icon)
		label.TextSize = math.floor(size * 0.72)
		label.TextColor3 = WHITE
		label.ZIndex = 2
		label.Parent = body
		scale.Scale = size / 100
	end
	holder.Parent = parent
	return holder
end

-- Fait vivre les animations (clock = temps en secondes)
function HouseArt.Step(anims: { Anim }, clock: number)
	for _, anim in ipairs(anims) do
		local object = anim.Object
		local t = clock * anim.Speed + anim.Phase
		local kind = anim.Kind
		if kind == "Sway" then
			object.Rotation = anim.BaseRotation + math.sin(t * 2) * anim.Amp
		elseif kind == "Spin" then
			object.Rotation = anim.BaseRotation + (clock * anim.Speed * 360 + anim.Phase * 57) % 360
		elseif kind == "Bob" then
			local base = anim.BasePosition
			object.Position = base + UDim2.fromOffset(0, math.sin(t * 2.2) * anim.Amp)
		elseif kind == "Drift" then
			local base = anim.BasePosition
			object.Position = base + UDim2.fromOffset(math.sin(t * 1.3) * anim.Amp, 0)
		elseif kind == "Pulse" then
			object.BackgroundTransparency = math.clamp(anim.BaseTransparency + (0.5 + 0.5 * math.sin(t * 2.4)) * anim.Amp, 0, 1)
		elseif kind == "Flicker" then
			local wave = math.sin(t * 9) * 0.5 + math.sin(t * 13.7 + 1.3) * 0.3 + math.sin(t * 23.1) * 0.2
			object.BackgroundTransparency = math.clamp(anim.BaseTransparency + (0.5 + 0.5 * wave) * anim.Amp, 0, 1)
			local scale = anim.Scale
			if scale then
				scale.Scale = 1 + wave * 0.05
			end
		elseif kind == "Breathe" then
			local scale = anim.Scale
			if scale then
				scale.Scale = 1 + math.sin(t * 1.8) * anim.Amp
			end
		elseif kind == "Blink" then
			-- Un clignement rapide toutes les ~4 s (décalé par objet)
			local cycle = (clock + anim.Phase) % 4.2
			object.Visible = cycle < 4.05
		end
	end
end

-- Miroir gauche <-> droite d'un dessin déjà peint (Roblox n'a pas d'échelle
-- négative pour les GuiObjects) : chaque forme change de côté dans son
-- parent, les rotations et dégradés horizontaux s'inversent, les
-- animations suivent. Appliqué deux fois = dessin d'origine.
-- `axis` (facultatif) : x de l'axe de symétrie pour les enfants directs de
-- `root` (ex. les pieds d'un animal) ; par défaut le milieu de `root`.
function HouseArt.Mirror(root: GuiObject, anims: { Anim }, axis: number?)
	local byObject: { [Instance]: { Anim } } = {}
	for _, anim in ipairs(anims) do
		local list = byObject[anim.Object]
		if not list then
			list = {}
			byObject[anim.Object] = list
		end
		table.insert(list, anim)
	end
	local widths: { [Instance]: number } = {}
	local function widthOf(object: Instance): number
		local cached = widths[object]
		if cached then
			return cached
		end
		local width = 0
		if object == root then
			width = root.AbsoluteSize.X > 0 and root.Size.X.Offset <= 0 and root.AbsoluteSize.X or root.Size.X.Offset
		elseif object:IsA("GuiObject") then
			local parent = object.Parent
			local parentWidth = parent and widthOf(parent) or 0
			width = object.Size.X.Scale * parentWidth + object.Size.X.Offset
		end
		widths[object] = width
		return width
	end
	for _, object in ipairs(root:GetDescendants()) do
		if object:IsA("GuiObject") then
			local parent = object.Parent :: Instance
			local parentWidth = widthOf(parent)
			if parent == root and axis then
				parentWidth = axis * 2
			end
			local width = widthOf(object)
			local list = byObject[object]
			local first = list and list[1]
			local position = first and first.BasePosition or object.Position
			local left = position.X.Scale * parentWidth + position.X.Offset - object.AnchorPoint.X * width
			local newLeft = parentWidth - left - width
			local newPosition = UDim2.new(0, newLeft + object.AnchorPoint.X * width, position.Y.Scale, position.Y.Offset)
			local rotation = -(first and first.BaseRotation or object.Rotation)
			object.Position = newPosition
			object.Rotation = rotation
			if list then
				for _, anim in ipairs(list) do
					anim.BasePosition = newPosition
					anim.BaseRotation = rotation
					if anim.Kind == "Sway" or anim.Kind == "Drift" then
						anim.Amp = -anim.Amp
					elseif anim.Kind == "Spin" then
						anim.Speed = -anim.Speed
					end
				end
			end
		elseif object:IsA("UIGradient") then
			object.Rotation = (180 - object.Rotation) % 360
		end
	end
end

return HouseArt
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="41">
            <Properties>
              <string name="Name">HouseButtons</string>
              <string name="Source"><![CDATA[--[[
	HouseButtons (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > HouseButtons

	Boutons "bonbons" de la maison (plus de boutons plats basiques) :
	  - Candy : bouton-outil carré (barre d'outils de l'éditeur) : face
	    brillante en dégradé + reflet, "lèvre" plus foncée dessous (effet 3D
	    qui s'enfonce quand on appuie), icône + légende, survol qui soulève
	    le bouton, état désactivé grisé ;
	  - Tip : petite bulle sombre au survol (nom + raccourci clavier).
	Tout est construit une fois ; les animations sont de simples Tweens.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local Interface = require(Client.Interface)
local Locale = require(ReplicatedStorage.Shared.Locale)
local HouseCommon = require(script.Parent.HouseCommon)

local HouseButtons = {}

local WHITE = Color3.new(1, 1, 1)
local C = HouseCommon.Colors
local LIP = 4 -- (px) épaisseur de la "lèvre" sous la face

-- Couleurs des familles d'outils (face) : exposées pour l'éditeur / la fenêtre
HouseButtons.Palette = {
	Lilac = Color3.fromRGB(200, 176, 255),
	Mint = Color3.fromRGB(128, 222, 190),
	Sky = Color3.fromRGB(140, 200, 255),
	Butter = Color3.fromRGB(255, 214, 110),
	Peach = Color3.fromRGB(255, 176, 140),
	Pink = Color3.fromRGB(255, 132, 186),
	Red = Color3.fromRGB(255, 88, 118),
	White = Color3.fromRGB(255, 252, 254),
	Green = Color3.fromRGB(96, 206, 128),
}

local function lipOf(color: Color3): Color3
	return color:Lerp(C.Ink, 0.42)
end

local function outlineOf(color: Color3): Color3
	return color:Lerp(C.Ink, 0.55)
end

-- Texte clair ou foncé selon la face
local function inkFor(color: Color3): Color3
	local luminance = 0.3 * color.R + 0.59 * color.G + 0.11 * color.B
	return luminance > 0.72 and C.Ink or WHITE
end

----------------------------------------------------------------------
-- Bulle d'aide (une seule, déplacée de bouton en bouton)
----------------------------------------------------------------------

local tip: Frame? = nil
local tipLabel: TextLabel? = nil
local tipOwner: GuiObject? = nil

local function ensureTip(): (Frame, TextLabel)
	local frame = tip
	local label = tipLabel
	if frame and label then
		return frame, label
	end
	local newTip = UIUtil.Create("Frame", {
		Name = "HouseTip",
		AnchorPoint = Vector2.new(0.5, 1),
		Size = UDim2.fromOffset(0, 26),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = C.Ink,
		BackgroundTransparency = 0.04,
		Visible = false,
		ZIndex = 60,
	})
	UIUtil.Corner(newTip, UDim.new(0, 9))
	UIUtil.Stroke(newTip, WHITE, 1.5, 0.35)
	UIUtil.Create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), Parent = newTip })
	local newLabel = UIUtil.Create("TextLabel", {
		Name = "Label",
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = "",
		TextColor3 = WHITE,
		TextSize = 14,
		ZIndex = 62,
		Parent = newTip,
	})
	-- petite pointe
	local pointer = UIUtil.Create("Frame", {
		Name = "Pointer",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.fromOffset(10, 10),
		Rotation = 45,
		BackgroundColor3 = C.Ink,
		BackgroundTransparency = 0.04,
		BorderSizePixel = 0,
		ZIndex = 61,
		Parent = newTip,
	})
	pointer:SetAttribute("DarkSkinIgnore", true)
	newTip:SetAttribute("DarkSkinIgnore", true)
	tip = newTip
	tipLabel = newLabel
	return newTip, newLabel
end

-- Affiche la bulle au-dessus de `owner` (nil = cache)
function HouseButtons.ShowTip(owner: GuiObject?, text: string?)
	local frame, label = ensureTip()
	if not owner or not text or text == "" then
		tipOwner = nil
		frame.Visible = false
		frame.Parent = nil
		return
	end
	tipOwner = owner
	label.Text = text
	frame.Position = UDim2.new(0.5, 0, 0, -8)
	-- (bulle détruite avec un ancien bouton : on en refait une)
	if not pcall(function()
		frame.Parent = owner
	end) then
		tip, tipLabel = nil, nil
		frame, label = ensureTip()
		label.Text = text
		frame.Position = UDim2.new(0.5, 0, 0, -8)
		frame.Parent = owner
	end
	frame.Visible = true
	UIUtil.Pop(frame, 0.7, 0.2)
end

-- Bulle au survol (souris seulement) ; `getText` peut changer (état du bouton)
function HouseButtons.Tip(button: GuiButton, getText: () -> string)
	button.MouseEnter:Connect(function()
		if not Interface.IsTouch() then
			HouseButtons.ShowTip(button, getText())
		end
	end)
	button.MouseLeave:Connect(function()
		if tipOwner == button then
			HouseButtons.ShowTip(nil)
		end
	end)
	button.Activated:Connect(function()
		if tipOwner == button then
			-- (le texte peut changer après un clic : ex. aimant oui / non)
			task.defer(function()
				if tipOwner == button then
					HouseButtons.ShowTip(button, getText())
				end
			end)
		end
	end)
end

-- Cache la bulle si elle est sur ce bouton (bouton qui disparaît)
function HouseButtons.HideTipOf(owner: GuiObject)
	if tipOwner == owner or (tipOwner and tipOwner:IsDescendantOf(owner)) then
		HouseButtons.ShowTip(nil)
	end
end

----------------------------------------------------------------------
-- Bouton-outil "bonbon"
----------------------------------------------------------------------

export type Candy = {
	Button: TextButton,
	Face: Frame,
	Icon: TextLabel,
	Caption: TextLabel?,
	SetEnabled: (enabled: boolean) -> (),
	IsEnabled: () -> boolean,
	SetColor: (color: Color3) -> (),
	SetIcon: (text: string) -> (),
	SetCaption: (text: string) -> (),
	SetSize: (width: number, height: number) -> (),
}

-- props : Name, Icon, Caption?, Color, TextColor?, Width, Height, Radius?,
-- IconSize?, LayoutOrder?, ZIndex?, Parent?
function HouseButtons.Candy(props: { [string]: any }): Candy
	local color: Color3 = props.Color or HouseButtons.Palette.White
	local z = props.ZIndex or 1
	local radius = props.Radius or 14
	local enabled = true
	local hovering = false

	local button = UIUtil.Create("TextButton", {
		Name = props.Name or "Candy",
		Size = UDim2.fromOffset(props.Width or 48, props.Height or 52),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = z,
		Parent = props.Parent,
	})
	local lip = UIUtil.Create("Frame", {
		Name = "Lip",
		Position = UDim2.fromOffset(0, LIP),
		Size = UDim2.new(1, 0, 1, -LIP),
		BackgroundColor3 = lipOf(color),
		ZIndex = z,
		Parent = button,
	})
	UIUtil.Corner(lip, radius)
	local lipStroke = UIUtil.Stroke(lip, outlineOf(color), 1.5, 0.25)
	local face = UIUtil.Create("Frame", {
		Name = "Face",
		Size = UDim2.new(1, 0, 1, -LIP),
		BackgroundColor3 = color,
		ZIndex = z + 1,
		Parent = button,
	})
	UIUtil.Corner(face, radius)
	local faceStroke = UIUtil.Stroke(face, outlineOf(color), 1.5, 0.25)
	UIUtil.Gradient(face, ColorSequence.new(WHITE, Color3.fromRGB(226, 226, 232)), 90)
	local gloss = UIUtil.Create("Frame", {
		Name = "Gloss",
		Position = UDim2.new(0, 4, 0, 3),
		Size = UDim2.new(1, -8, 0.4, 0),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.35,
		ZIndex = z + 2,
		Parent = face,
	})
	UIUtil.Corner(gloss, math.max(4, radius - 4))
	UIUtil.Create("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new(0.25, 1),
		Parent = gloss,
	})
	local hasCaption = props.Caption ~= nil and props.Caption ~= ""
	local textColor = props.TextColor or inkFor(color)
	local icon = UIUtil.Create("TextLabel", {
		Name = "Icon",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = hasCaption and UDim2.new(0.5, 0, 0.38, 0) or UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, 0, hasCaption and 0.6 or 1, 0),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = props.Icon or "",
		TextColor3 = textColor,
		TextSize = props.IconSize or 22,
		ZIndex = z + 3,
		Parent = face,
	})
	local caption: TextLabel? = nil
	if hasCaption then
		local label = UIUtil.Create("TextLabel", {
			Name = "Caption",
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -3),
			Size = UDim2.new(1, -4, 0, 13),
			BackgroundTransparency = 1,
			Font = Theme.Fonts.Title,
			Text = props.Caption,
			TextColor3 = textColor,
			TextSize = 12,
			TextScaled = true,
			ZIndex = z + 3,
			Parent = face,
		})
		UIUtil.Create("UITextSizeConstraint", { MaxTextSize = 12, MinTextSize = 7, Parent = label })
		caption = label
	end

	local function setFace(offset: number, time: number)
		UIUtil.Tween(face, time, { Position = UDim2.fromOffset(0, offset) }, Enum.EasingStyle.Quad)
	end
	button.MouseEnter:Connect(function()
		hovering = true
		if enabled then
			setFace(-1.5, 0.1)
		end
	end)
	button.MouseLeave:Connect(function()
		hovering = false
		setFace(0, 0.12)
	end)
	button.MouseButton1Down:Connect(function()
		setFace(LIP - 1, 0.06)
	end)
	button.MouseButton1Up:Connect(function()
		setFace(hovering and enabled and -1.5 or 0, 0.14)
	end)

	local candy: Candy
	local function paint()
		local shown = enabled and color or color:Lerp(Color3.fromRGB(214, 210, 222), 0.65)
		face.BackgroundColor3 = shown
		lip.BackgroundColor3 = lipOf(shown)
		lipStroke.Color = outlineOf(shown)
		faceStroke.Color = outlineOf(shown)
		gloss.BackgroundTransparency = enabled and 0.35 or 0.6
		local ink = props.TextColor or inkFor(color)
		icon.TextColor3 = ink
		icon.TextTransparency = enabled and 0 or 0.5
		local label = candy and candy.Caption
		if label then
			label.TextColor3 = ink
			label.TextTransparency = enabled and 0 or 0.45
		end
	end
	candy = {
		Button = button,
		Face = face,
		Icon = icon,
		Caption = caption,
		SetEnabled = function(value: boolean)
			if enabled == value then
				return
			end
			enabled = value
			paint()
		end,
		IsEnabled = function(): boolean
			return enabled
		end,
		SetColor = function(value: Color3)
			color = value
			paint()
		end,
		SetIcon = function(text: string)
			if icon.Text ~= text then
				icon.Text = text
			end
		end,
		SetCaption = function(text: string)
			local label = caption
			if label and label.Text ~= text then
				label.Text = text
			end
		end,
		SetSize = function(width: number, height: number)
			button.Size = UDim2.fromOffset(width, height)
		end,
	}
	paint()
	return candy
end

----------------------------------------------------------------------
-- Cadres qui "avalent" les clics
----------------------------------------------------------------------

-- Conteneur visible (pastille, capsule, bandeau...) fait avec un TextButton
-- sans action : sur Roblox une Frame laisse passer le clic vers un bouton
-- placé derrière (la pièce désélectionnerait l'objet, une case de la maison
-- s'ouvrirait...). À utiliser à la place d'une Frame quand le cadre a un
-- UIListLayout / UIPadding (UIUtil.SinkClicks y ajouterait un enfant rangé
-- par la liste). props : mêmes propriétés qu'une Frame.
function HouseButtons.Container(props: { [string]: any }): TextButton
	local finalProps: { [string]: any } = {
		AutoButtonColor = false,
		Text = "",
		Selectable = false,
	}
	for key, value in pairs(props) do
		finalProps[key] = value
	end
	return UIUtil.Create("TextButton", finalProps)
end

-- Bouton invisible sous tout le contenu d'un cadre SANS liste (comme
-- UIUtil.SinkClicks) qui couvre aussi ses marges internes (UIPadding)
function HouseButtons.Sink(frame: GuiObject): TextButton
	local existing = frame:FindFirstChild("ClickSink")
	if existing and existing:IsA("TextButton") then
		return existing
	end
	local padding = frame:FindFirstChildOfClass("UIPadding")
	local padL = padding and padding.PaddingLeft.Offset or 0
	local padR = padding and padding.PaddingRight.Offset or 0
	local padT = padding and padding.PaddingTop.Offset or 0
	local padB = padding and padding.PaddingBottom.Offset or 0
	local sink = UIUtil.Create("TextButton", {
		Name = "ClickSink",
		Position = UDim2.fromOffset(-padL, -padT),
		Size = UDim2.new(1, padL + padR, 1, padT + padB),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		Selectable = false,
		ZIndex = 0,
		Parent = frame,
	})
	return sink
end

-- Texte localisé d'une bulle "Nom  (raccourci)"
function HouseButtons.TipText(name: string, shortcut: string?): string
	if shortcut and shortcut ~= "" and not Interface.IsTouch() then
		return Locale.T(name) .. "   " .. shortcut
	end
	return Locale.T(name)
end

return HouseButtons
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="42">
            <Properties>
              <string name="Name">HouseCommon</string>
              <string name="Source"><![CDATA[--[[
	HouseCommon (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > HouseCommon

	Outils partagés de "🏠 Ma maison" côté client :
	  - accès typé à Config.House (tailles, papiers peints, sols, objets) ;
	  - lecture de ClientState.Data.House (avec valeurs par défaut) : la
	    maison est une grille de pièces (Rooms), chacune avec son type, son
	    emplacement (Slot), son papier peint, son sol et ses objets ;
	  - prix (Formulas.GetHouseItemPrice), exemplaires possédés / posés,
	    confort et bonus (mêmes formules que le serveur) ;
	  - bornes des zones "Wall" (haut) / "Floor" (bas) de la pièce, et
	    règle "peut être posé SUR un meuble" (CanGoOnFurniture, même règle
	    que le serveur : Formulas.CanGoOnFurniture) ;
	  - objets posés { I, X, Y, S, Z, F? } : F = dessin retourné (miroir) ;
	  - appel du serveur : Net.Function("House"):InvokeServer(action, arg)
	    protégé par pcall ;
	  - palette kawaii (roses, lilas, menthe) utilisée par tous les modules
	    de la maison.
	Aucune interface ici (utilisé aussi par la colonne centrale pour son badge).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent.Parent
local ClientState = require(Client.ClientState)
local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Net = require(ReplicatedStorage.Shared.Net)
local Locale = require(ReplicatedStorage.Shared.Locale)

export type Item = {
	Id: string,
	Name: string,
	Icon: string,
	Category: string,
	Placement: string, -- "Floor" | "Wall"
	Size: number,
	Cost: number,
	CostGrowth: number,
	Comfort: number,
	MaxOwned: number?,
	Order: number?,
	Tabletop: boolean?, -- true / false : force "peut être posé sur un meuble"
}

export type SizeDef = {
	Id: string,
	Name: string,
	Icon: string,
	Cost: number,
	Floors: number, -- étages
	Columns: number, -- pièces par étage
	MaxRooms: number, -- Floors x Columns
	Width: number, -- largeur relative d'une pièce
	RoomItems: number, -- objets posés max par pièce
	Exterior: string, -- "Cottage" | "Townhouse" | "Loft" | "Mansion"
	Order: number?,
}

export type RoomTypeDef = {
	Id: string,
	Name: string,
	Icon: string,
	Wallpaper: string,
	Floor: string,
	Categories: { string },
	Items: { string },
	FavoriteCategories: { [string]: boolean },
	FavoriteItems: { [string]: boolean },
	Order: number?,
}

export type Style = {
	Id: string,
	Name: string,
	Icon: string?,
	Cost: number,
	Pattern: string,
	A: Color3,
	B: Color3,
	Order: number?,
}

export type Category = { Id: string, Name: string, Icon: string, Order: number? }

-- Un objet posé (format du serveur) ; F = dessin retourné (miroir) ;
-- C = couleur (Config.House.Tints, nil = couleurs d'origine)
export type Placed = { I: string, X: number, Y: number, S: number, Z: number, F: boolean?, C: string? }

-- Une pièce (format du serveur) ; Slot = (étage - 1) x Columns + colonne,
-- étage 1 = rez-de-chaussée
export type Room = {
	Id: string,
	Type: string,
	Slot: number,
	Wallpaper: string,
	Floor: string,
	Trim: string, -- (v9.1) boiseries (Config.House.Trims)
	Mood: string, -- (v9.1) ambiance / lumière (Config.House.Moods)
	View: string, -- (v9.1) vue par la fenêtre (Config.House.Views)
	Placed: { Placed },
}

-- (v9.1) Entrée de personnalisation (boiseries, ambiance, vue, façade, toit,
-- motif du toit, déco du jardin, couleur d'objet) : champs selon le genre
export type Look = {
	Id: string,
	Name: string,
	Icon: string,
	Cost: number?,
	RequiresRebirths: number?,
	Color: Color3?,
	Tint: Color3?,
	Tint2: Color3?,
	Amount: number?,
	Light: Color3?,
	Brightness: number?,
	Effect: string?,
	Kind: string?,
	Sky: Color3?,
	Horizon: Color3?,
	Ground: Color3?,
	Pattern: string?,
	Order: number?,
}

export type HouseData = {
	Size: string,
	OwnedSizes: { [string]: boolean },
	OwnedWallpapers: { [string]: boolean },
	OwnedFloors: { [string]: boolean },
	Items: { [string]: number },
	Rooms: { Room },
	-- (v9.1) personnalisation : possédés par genre ({ [id] = true }), extérieur
	Owned: { [string]: { [string]: boolean } },
	Facade: string,
	Roof: string,
	RoofStyle: string,
	Garden: { string },
}

export type HouseConfig = {
	ComfortBonusPerPoint: number,
	MaxComfortBonus: number,
	WallRatio: number,
	TabletopMaxSize: number?,
	TabletopMinY: number?,
	LegacyTabletopSize: number?,
	RoomCost: number,
	RoomCostGrowth: number,
	HarmonyBonus: number,
	Sizes: { SizeDef },
	RoomTypes: { RoomTypeDef },
	Wallpapers: { Style },
	Floors: { Style },
	Categories: { Category },
	Items: { Item },
}

local HouseCommon = {}

-- Config typée (le tableau de Config.luau mélange des objets avec / sans MaxOwned)
local rawConfig = (Config :: any).House
local EMPTY_CONFIG: HouseConfig = {
	ComfortBonusPerPoint = 0,
	MaxComfortBonus = 0,
	WallRatio = 0.46,
	RoomCost = 0,
	RoomCostGrowth = 1,
	HarmonyBonus = 0,
	Sizes = {
		{ Id = "Studio", Name = "Cozy studio", Icon = "🏠", Cost = 0, Floors = 1, Columns = 1, MaxRooms = 1, Width = 1,
			RoomItems = 25, Exterior = "Cottage" },
	},
	RoomTypes = {},
	Wallpapers = {},
	Floors = {},
	Categories = {},
	Items = {},
}
HouseCommon.Config = (type(rawConfig) == "table" and rawConfig or EMPTY_CONFIG) :: HouseConfig

HouseCommon.ItemsById = ((Config :: any).HouseItemsById or {}) :: { [string]: Item }
HouseCommon.SizesById = ((Config :: any).HouseSizesById or {}) :: { [string]: SizeDef }
HouseCommon.WallpapersById = ((Config :: any).HouseWallpapersById or {}) :: { [string]: Style }
HouseCommon.FloorsById = ((Config :: any).HouseFloorsById or {}) :: { [string]: Style }
HouseCommon.CategoriesById = ((Config :: any).HouseCategoriesById or {}) :: { [string]: Category }
HouseCommon.RoomTypesById = ((Config :: any).HouseRoomTypesById or {}) :: { [string]: RoomTypeDef }

-- Échelle des objets posés (bornes du serveur) et pas des boutons ➕ / ➖
HouseCommon.MIN_SCALE = 0.6
HouseCommon.MAX_SCALE = 1.6
HouseCommon.SCALE_STEP = 0.1
-- Couche de départ d'un objet posé (Z) : de la place pour "reculer" (0..999)
HouseCommon.DEFAULT_Z = 100
HouseCommon.MAX_Z = 999

-- Palette kawaii
HouseCommon.Colors = {
	Pink = Color3.fromRGB(255, 126, 182),
	PinkDeep = Color3.fromRGB(236, 72, 140),
	PinkSoft = Color3.fromRGB(255, 214, 232),
	PinkMist = Color3.fromRGB(255, 240, 247),
	Lilac = Color3.fromRGB(183, 148, 246),
	LilacSoft = Color3.fromRGB(236, 224, 255),
	Mint = Color3.fromRGB(110, 214, 176),
	MintSoft = Color3.fromRGB(214, 247, 234),
	Cream = Color3.fromRGB(255, 247, 236),
	Peach = Color3.fromRGB(255, 190, 160),
	Sky = Color3.fromRGB(150, 205, 255),
	Butter = Color3.fromRGB(255, 226, 130),
	Heart = Color3.fromRGB(255, 79, 139),
	Wood = Color3.fromRGB(214, 164, 120),
	WoodDark = Color3.fromRGB(160, 110, 78),
	Ink = Color3.fromRGB(92, 58, 96), -- texte "chocolat-prune" sur fond pastel
}

-- Fond pastel de la vignette d'un objet, selon sa catégorie
local CATEGORY_TINTS: { [string]: Color3 } = {
	Furniture = Color3.fromRGB(255, 228, 206),
	Decor = Color3.fromRGB(255, 222, 238),
	Toys = Color3.fromRGB(255, 240, 200),
	Plants = Color3.fromRGB(216, 245, 222),
	Electronics = Color3.fromRGB(214, 232, 255),
	Kitchen = Color3.fromRGB(255, 226, 222),
	Doors = Color3.fromRGB(236, 224, 210),
	Windows = Color3.fromRGB(214, 240, 255),
	Lights = Color3.fromRGB(255, 244, 196),
	Pets = Color3.fromRGB(255, 232, 214),
}

function HouseCommon.CategoryTint(categoryId: string): Color3
	-- (v9.2) les nouvelles catégories donnent leur teinte dans Config (Tint)
	local entry = Config.HouseCategoriesById[categoryId]
	local configured = entry and entry.Tint
	return CATEGORY_TINTS[categoryId] or (typeof(configured) == "Color3" and configured) or HouseCommon.Colors.PinkSoft
end

----------------------------------------------------------------------
-- Données
----------------------------------------------------------------------

local function mapOf(value): { [string]: any }
	if type(value) == "table" then
		return value
	end
	return {}
end

local function readPlaced(list: any): { Placed }
	local placed = {}
	if type(list) == "table" then
		for _, entry in ipairs(list) do
			if type(entry) == "table" and type(entry.I) == "string" then
				table.insert(placed, {
					I = entry.I,
					X = tonumber(entry.X) or 0.5,
					Y = tonumber(entry.Y) or 0.8,
					S = tonumber(entry.S) or 1,
					Z = tonumber(entry.Z) or 0,
					F = entry.F == true or nil,
					C = type(entry.C) == "string" and entry.C or nil,
				})
			end
		end
	end
	return placed
end

-- (v9.1) Genres de personnalisation (Config.HouseLookKinds)
export type LookKind = { Kind: string, List: { Look }, Owned: string, Scope: string, Field: string, ById: { [string]: Look } }
local LOOK_KINDS = ((Config :: any).HouseLookKinds or {}) :: { [string]: LookKind }
local LOOKS_BY_ID = ((Config :: any).HouseLooksById or {}) :: { [string]: { [string]: Look } }
HouseCommon.LookKinds = LOOK_KINDS
HouseCommon.TintsById = ((Config :: any).HouseTintsById or {}) :: { [string]: Look }
HouseCommon.Tints = ((Config.House :: any).Tints or {}) :: { Look }
HouseCommon.GardenSlots = tonumber((Config.House :: any).GardenSlots) or 6

-- Id valide d'un genre (sinon la 1re entrée de la liste)
local function lookId(kind: string, value: any): string
	local byId = LOOKS_BY_ID[kind]
	if type(value) == "string" and byId and byId[value] then
		return value
	end
	local def = LOOK_KINDS[kind]
	local first = def and def.List[1]
	return first and first.Id or ""
end

-- Entrée d'un genre par id (la 1re si inconnue)
function HouseCommon.Look(kind: string, id: string?): Look?
	local byId = LOOKS_BY_ID[kind]
	return byId and byId[lookId(kind, id)] or nil
end

-- Vrai si le joueur possède cette entrée (la 1re est gratuite, sauf jardin)
function HouseCommon.OwnsLook(house: HouseData, kind: string, id: string): boolean
	local map = house.Owned[kind]
	return map ~= nil and map[id] == true
end

-- Maison du joueur (jamais nil : valeurs par défaut avant le premier état ;
-- une ancienne maison à une seule pièce devient un salon)
function HouseCommon.GetHouse(data: any): HouseData
	local house = type(data) == "table" and data.House or nil
	local config = HouseCommon.Config
	local firstSize = config.Sizes[1]
	local firstWallpaper = config.Wallpapers[1]
	local firstFloor = config.Floors[1]
	local firstType = config.RoomTypes[1]
	if type(house) ~= "table" then
		house = {}
	end
	local rooms: { Room } = {}
	local ok, rawRooms = pcall(Formulas.GetHouseRooms, house)
	if ok and type(rawRooms) == "table" then
		for index, raw in ipairs(rawRooms) do
			if type(raw) == "table" then
				table.insert(rooms, {
					Id = type(raw.Id) == "string" and raw.Id or ("R" .. index),
					Type = type(raw.Type) == "string" and raw.Type or (firstType and firstType.Id or "Living"),
					Slot = tonumber(raw.Slot) or index,
					Wallpaper = type(raw.Wallpaper) == "string" and raw.Wallpaper
						or (type(house.Wallpaper) == "string" and house.Wallpaper)
						or (firstWallpaper and firstWallpaper.Id or ""),
					Floor = type(raw.Floor) == "string" and raw.Floor
						or (type(house.Floor) == "string" and house.Floor)
						or (firstFloor and firstFloor.Id or ""),
					Trim = lookId("Trim", raw.Trim),
					Mood = lookId("Mood", raw.Mood),
					View = lookId("View", raw.View),
					Placed = readPlaced(raw.Placed),
				})
			end
		end
	end
	if #rooms == 0 then
		table.insert(rooms, {
			Id = "R1",
			Type = firstType and firstType.Id or "Living",
			Slot = 1,
			Wallpaper = firstWallpaper and firstWallpaper.Id or "",
			Floor = firstFloor and firstFloor.Id or "",
			Trim = lookId("Trim", nil),
			Mood = lookId("Mood", nil),
			View = lookId("View", nil),
			Placed = {},
		})
	end
	-- (v9.1) personnalisation : possédés par genre (la 1re entrée est gratuite)
	local owned: { [string]: { [string]: boolean } } = {}
	for kind, def in pairs(LOOK_KINDS) do
		local map = table.clone(mapOf(house[def.Owned]))
		local first = def.List[1]
		if first and def.Scope ~= "Garden" then
			map[first.Id] = true
		end
		owned[kind] = map
	end
	local garden: { string } = {}
	if type(house.Garden) == "table" then
		for _, id in ipairs(house.Garden) do
			if type(id) == "string" and LOOKS_BY_ID.Garden and LOOKS_BY_ID.Garden[id] then
				table.insert(garden, id)
			end
		end
	end
	return {
		Owned = owned,
		Facade = lookId("Facade", house.Facade),
		Roof = lookId("Roof", house.Roof),
		RoofStyle = lookId("RoofStyle", house.RoofStyle),
		Garden = garden,
		Size = type(house.Size) == "string" and house.Size or (firstSize and firstSize.Id or "Studio"),
		OwnedSizes = mapOf(house.OwnedSizes),
		OwnedWallpapers = mapOf(house.OwnedWallpapers),
		OwnedFloors = mapOf(house.OwnedFloors),
		Items = mapOf(house.Items),
		Rooms = rooms,
	}
end

function HouseCommon.GetSize(house: HouseData): SizeDef
	return HouseCommon.SizesById[house.Size] or HouseCommon.Config.Sizes[1]
end

-- Pièce par Id (nil si elle n'existe pas)
function HouseCommon.GetRoom(house: HouseData, roomId: string?): Room?
	for _, room in ipairs(house.Rooms) do
		if room.Id == roomId then
			return room
		end
	end
	return nil
end

-- Pièce à un emplacement de la grille (nil si vide)
function HouseCommon.RoomAtSlot(house: HouseData, slot: number): Room?
	for _, room in ipairs(house.Rooms) do
		if room.Slot == slot then
			return room
		end
	end
	return nil
end

-- Emplacement -> (étage, colonne) ; étage 1 = rez-de-chaussée
function HouseCommon.SlotCell(size: SizeDef, slot: number): (number, number)
	return math.floor((slot - 1) / size.Columns) + 1, (slot - 1) % size.Columns + 1
end

function HouseCommon.CellSlot(size: SizeDef, floor: number, column: number): number
	return (floor - 1) * size.Columns + column
end

function HouseCommon.GetRoomType(room: Room?): RoomTypeDef
	local roomType = room and HouseCommon.RoomTypesById[room.Type]
	return roomType or HouseCommon.Config.RoomTypes[1]
end

function HouseCommon.GetRoomWallpaper(room: Room?): Style?
	return (room and HouseCommon.WallpapersById[room.Wallpaper]) or HouseCommon.Config.Wallpapers[1]
end

function HouseCommon.GetRoomFloor(room: Room?): Style?
	return (room and HouseCommon.FloorsById[room.Floor]) or HouseCommon.Config.Floors[1]
end

-- Vrai si l'objet est un "préféré" de la pièce (bonus d'harmonie)
function HouseCommon.IsFavorite(room: Room?, item: Item): boolean
	local ok, value = pcall(Formulas.IsRoomFavorite, HouseCommon.GetRoomType(room), item)
	return ok and value == true
end

-- Confort d'un objet dans une pièce (harmonie comprise)
function HouseCommon.PlacedComfort(room: Room?, item: Item): number
	local ok, value = pcall(Formulas.GetPlacedComfort, HouseCommon.GetRoomType(room), item)
	if ok and type(value) == "number" then
		return value
	end
	return item.Comfort
end

-- Prix de la prochaine pièce
function HouseCommon.RoomCost(house: HouseData): number
	local ok, value = pcall(Formulas.GetRoomCost, #house.Rooms)
	if ok and type(value) == "number" then
		return value
	end
	return math.huge
end

-- Anciennes fonctions (1re pièce) : pour le code qui ne connaît qu'une pièce
function HouseCommon.GetWallpaper(house: HouseData): Style?
	return HouseCommon.GetRoomWallpaper(house.Rooms[1])
end

function HouseCommon.GetFloor(house: HouseData): Style?
	return HouseCommon.GetRoomFloor(house.Rooms[1])
end

-- Exemplaires possédés d'un objet
function HouseCommon.Owned(house: HouseData, itemId: string): number
	return math.max(0, math.floor(tonumber(house.Items[itemId]) or 0))
end

-- Exemplaires posés d'un objet dans une disposition
function HouseCommon.PlacedCount(placed: { Placed }, itemId: string): number
	local count = 0
	for _, entry in ipairs(placed) do
		if entry.I == itemId then
			count += 1
		end
	end
	return count
end

-- Prix du prochain exemplaire
function HouseCommon.Price(item: Item, owned: number): number
	return Formulas.GetHouseItemPrice(item, owned)
end

-- Vrai si on ne peut plus en acheter (MaxOwned atteint)
function HouseCommon.IsMaxed(item: Item, owned: number): boolean
	return item.MaxOwned ~= nil and owned >= (item.MaxOwned :: number)
end

-- Dopamine sûre (sans l'extrapolation des gains passifs)
function HouseCommon.Dopamine(): number
	local ok, value = pcall(ClientState.GetConfirmedDopamine)
	if ok and type(value) == "number" then
		return value
	end
	return 0
end

-- Dispositions "en cours" : { [roomId] = objets posés } remplace celles du serveur
export type Overrides = { [string]: { Placed } }

local function layoutOf(room: Room, overrides: Overrides?): { Placed }
	return (overrides and overrides[room.Id]) or room.Placed
end

-- Exemplaires d'un objet posés dans TOUTES les pièces
function HouseCommon.PlacedTotal(house: HouseData, itemId: string, overrides: Overrides?): number
	local count = 0
	for _, room in ipairs(house.Rooms) do
		count += HouseCommon.PlacedCount(layoutOf(room, overrides), itemId)
	end
	return count
end

-- Exemplaires encore rangés (possédés - posés partout)
function HouseCommon.Available(house: HouseData, itemId: string, overrides: Overrides?): number
	return math.max(0, HouseCommon.Owned(house, itemId) - HouseCommon.PlacedTotal(house, itemId, overrides))
end

-- Confort total de la maison (même calcul que le serveur : objets possédés,
-- RoomItems par pièce, harmonie), avec des dispositions en cours éventuelles
function HouseCommon.Comfort(house: HouseData, overrides: Overrides?): number
	local rooms = {}
	for _, room in ipairs(house.Rooms) do
		table.insert(rooms, { Id = room.Id, Type = room.Type, Slot = room.Slot, Placed = layoutOf(room, overrides) })
	end
	local ok, value = pcall(Formulas.GetHouseComfort, {
		House = { Size = house.Size, Items = house.Items, Rooms = rooms },
	})
	if ok and type(value) == "number" then
		return value
	end
	return 0
end

-- Confort d'une seule pièce (sans tenir compte des autres pièces)
function HouseCommon.RoomComfort(house: HouseData, room: Room, placed: { Placed }?): number
	local ok, value = pcall(Formulas.GetHouseComfort, {
		House = {
			Size = house.Size,
			Items = house.Items,
			Rooms = { { Id = room.Id, Type = room.Type, Slot = 1, Placed = placed or room.Placed } },
		},
	})
	if ok and type(value) == "number" then
		return value
	end
	return 0
end

-- Bonus en % sur tous les gains (ex. 17 pour +17 %)
function HouseCommon.BonusPercent(comfort: number): number
	local ok, multiplier = pcall(Formulas.GetHouseBonus, comfort)
	if ok and type(multiplier) == "number" then
		return math.max(0, (multiplier - 1) * 100)
	end
	return 0
end

-- "17" / "2.5" : pourcentage lisible
function HouseCommon.FormatPercent(value: number): string
	if value >= 10 or math.abs(value - math.floor(value)) < 0.05 then
		return tostring(math.floor(value + 0.5))
	end
	return string.format("%.1f", value)
end

-- Visites à l'océan nécessaires pour une entrée (objet, style, maison)
function HouseCommon.RequiredRebirths(entry: any): number
	local ok, value = pcall(Formulas.GetHouseRequiredRebirths, entry)
	if ok and type(value) == "number" then
		return value
	end
	return 0
end

-- Vrai si l'entrée est débloquée pour ces données (visites à l'océan)
function HouseCommon.IsUnlocked(data: any, entry: any): boolean
	local ok, value = pcall(Formulas.IsHouseEntryUnlocked, data, entry)
	if ok and type(value) == "boolean" then
		return value
	end
	return true
end

-- Objets jamais achetés qu'on peut se payer maintenant (badges)
function HouseCommon.AffordableNew(data: any, dopamine: number): { string }
	local result = {}
	if type(data) ~= "table" then
		return result
	end
	local house = HouseCommon.GetHouse(data)
	for _, item in ipairs(HouseCommon.Config.Items) do
		if HouseCommon.Owned(house, item.Id) == 0 and dopamine >= HouseCommon.Price(item, 0) and HouseCommon.IsUnlocked(data, item) then
			table.insert(result, item.Id)
		end
	end
	return result
end

-- Nom traduit d'un objet / d'une entrée de config
function HouseCommon.Name(entry: { Name: string }): string
	return Locale.T(entry.Name)
end

----------------------------------------------------------------------
-- Zones de la pièce
----------------------------------------------------------------------

-- Vrai si l'objet peut être posé SUR un meuble (table, étagère, lit...) :
-- même règle que le serveur (Formulas.CanGoOnFurniture)
local tabletopCache: { [string]: boolean } = {}
function HouseCommon.CanGoOnFurniture(item: Item?): boolean
	if not item then
		return false
	end
	local cached = tabletopCache[item.Id]
	if cached ~= nil then
		return cached
	end
	local ok, value = pcall(Formulas.CanGoOnFurniture, item)
	local result = ok and value == true
	tabletopCache[item.Id] = result
	return result
end

-- Bornes (Y) de la zone d'un objet : "Wall" = haut, "Floor" = bas
-- (un peu plus serrées que celles du serveur : l'objet reste bien dans sa zone)
function HouseCommon.ZoneBounds(placement: string): (number, number)
	local ratio = HouseCommon.Config.WallRatio
	if placement == "Wall" then
		return 0.1, ratio - 0.03
	end
	return ratio + 0.035, 0.985
end

-- Position corrigée d'un objet : dans sa zone, sans sortir de la pièce.
-- `roomWidth` / `roomHeight` : taille de la pièce en px de maquette.
-- `onSurface` : petit objet posé SUR un meuble (peut monter jusqu'à
-- Config.House.TabletopMinY, comme le permet le serveur).
function HouseCommon.ClampPosition(item: Item, x: number, y: number, scale: number, roomWidth: number, roomHeight: number, onSurface: boolean?): (number, number)
	local half = (item.Size * scale * 0.38) / math.max(1, roomWidth)
	half = math.clamp(half, 0.015, 0.2)
	local minY, maxY = HouseCommon.ZoneBounds(item.Placement)
	local ratio = HouseCommon.Config.WallRatio
	local sizeY = (item.Size * scale) / math.max(1, roomHeight)
	if item.Placement == "Wall" then
		-- Objet centré sur Y : il reste (presque) entier sur le mur, sans
		-- passer sous le plafond ni trop descendre sur le sol
		local halfY = sizeY * 0.4
		minY = math.max(minY, halfY + 0.02)
		maxY = math.max(0.1, math.min(maxY, ratio - halfY * 0.7))
		if minY > maxY then
			-- Objet plus haut que le mur : centré sur le mur
			minY = math.min(maxY, ratio / 2 + 0.02)
			maxY = minY
		end
	else
		if onSurface == true and HouseCommon.CanGoOnFurniture(item) then
			minY = HouseCommon.Config.TabletopMinY or minY
		end
		-- Objet posé par ses pieds : sa tête ne traverse pas le plafond
		minY = math.min(maxY, math.max(minY, sizeY * 0.92 - 0.02))
	end
	return math.clamp(x, half, 1 - half), math.clamp(y, minY, maxY)
end

----------------------------------------------------------------------
-- Serveur
----------------------------------------------------------------------

-- Appel protégé : (succès, message?)
function HouseCommon.Invoke(action: string, argument: any): (boolean, string?)
	local ok, success, message = pcall(function()
		return Net.Function("House"):InvokeServer(action, argument)
	end)
	if not ok then
		return false, Locale.T("Network error, try again.")
	end
	return success == true, message ~= nil and tostring(message) or nil
end

-- Petit hachage déterministe d'un texte (détails "aléatoires" mais stables)
function HouseCommon.Hash(text: string): number
	local hash = 5381
	for index = 1, #text do
		hash = (hash * 33 + string.byte(text, index)) % 2147483647
	end
	return hash
end

return HouseCommon
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">HouseEditor</string>
              <string name="Source"><![CDATA[--[[
	HouseEditor (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > HouseEditor

	Disposition des objets d'UNE pièce de la maison (côté client) :
	  - copie locale de room.Placed + un "autocollant" par objet
	    (HouseRoom.CreateSticker), triés en profondeur : objets muraux
	    derrière, tapis à plat, puis objets au sol (couche Z, puis Y : plus
	    bas = devant) ; SetRoom change de pièce (la précédente est
	    sauvegardée tout de suite) ;
	  - MODE ÉDITION : glisser-déposer fluide à la souris ET au doigt,
	    l'objet reste dans sa zone (mur / sol), zone valide mise en valeur,
	    AIMANTATION à la grille (option 🧲, lignes visibles pendant le
	    glissement), petit "plop" à la pose ;
	  - sélection + BARRE D'OUTILS "bonbons" (House/HouseButtons) près de
	    l'objet (ou en bas de la scène sur téléphone) : vignette + nom +
	    confort + "📍 sur la table", taille ➖ 100 % ➕, ⏬ derrière /
	    ⏫ devant, ↔️ retourner (miroir), 🎨 couleur (v9.1 : la rangée des
	    couleurs remplace les outils ; touche C), 📑 copier, 🚪 envoyer
	    dans une autre pièce, 📦 ranger (rouge) ; bulle au survol (nom + raccourci) ;
	    les clics dans la barre ne désélectionnent jamais l'objet ;
	  - ANNULER / RÉTABLIR (30 étapes par pièce ; Ctrl+Z / Ctrl+Y) ;
	  - clavier : flèches = petit déplacement (Maj = plus grand), + / - =
	    taille, Page préc. / suiv. = couche, F = retourner, Suppr = ranger,
	    Ctrl+D = dupliquer, Échap = désélectionner, G = aimant ;
	  - pose depuis l'inventaire (Place) à un endroit libre : petite déco
	    directement SUR un meuble (nourriture sur une table, coussin sur le
	    lit...), chaise directement À UNE TABLE ;
	  - sauvegarde automatique "saveLayout" { Rooms = { [pièce] = ... } }
	    ~1,5 s après la dernière modification (les 2 pièces d'un envoi
	    partent dans le même appel) ; nouvel essai si le serveur refuse,
	    puis resynchro ;
	  - hors édition : toucher un objet le fait rebondir (petits cœurs) ;
	  - SUR LES MEUBLES (House/HouseSurfaces) : un petit objet glissé
	    au-dessus d'une table, d'un bureau, d'une étagère, d'un lit, d'un
	    canapé, d'une chaise... s'y pose : pendant le glissement, toutes les
	    places possibles s'allument, le dessus visé brille avec une étiquette
	    "✨ Poser sur : Table à manger" et le meuble est entouré ;
	  - CHAISES À TABLE : une chaise / un tabouret glissé près d'une table
	    se range à gauche ou à droite (tournée vers elle), derrière (le
	    dossier dépasse) ou devant ; déplacer / agrandir la table emporte ses
	    chaises et ce qui est posé dessus ; ranger la table fait tomber ce
	    qui était posé dessus (les chaises restent) ;
	  - ANIMAUX : hors édition, les animaux de la pièce se promènent et
	    utilisent leurs affaires (House/HousePets, visuel seulement).
	Les exemplaires sont comptés dans TOUTES les pièces (HouseCommon.Available
	avec la disposition locale). Le serveur revérifie tout.
]]


MusicData.SONG_INDEX = {} :: { [string]: number }
for i, song in ipairs(MusicData.SONGS) do
	MusicData.SONG_INDEX[song.Id] = i
end

-- Batterie : 16 doubles-croches par mesure de 4 temps (12 pour 3 temps)
-- "x" = coup, "o" = coup accentué, "." = rien
local GROOVES: { [string]: { [string]: string } } = {
	pop = { Kick = "x.....x.x.......", Snare = "....x.......x...", HatClosed = "x.x.x.x.x.x.x.x." },
	rock = { Kick = "x.......x.x.....", Snare = "....o.......o...", HatClosed = "x.x.x.x.x.x.x.x." },
	disco = { Kick = "x...x...x...x...", Snare = "....x.......x...", HatClosed = "x...x...x...x...", HatOpen = "..x...x...x...x." },
	boom = { Kick = "x.......x.x.....", Snare = "....x.......x..x", HatClosed = "x.x.x.xxx.x.x.x." },
	brush = { Kick = "x.......x.......", Snare = "....x.......x...", Ride = "x..xx..xx..xx..x" },
	house = { Kick = "x...x...x...x...", HatOpen = "..x...x...x...x.", Snare = "....x.......x..." },
	hiphop = { Kick = "x......xx.x.....", Snare = "....x.......x...", HatClosed = "x.x.x.x.x.x.x.xx" },
}

local function tokens(text: string): { string }
	local list = {}
	for token in string.gmatch(text, "%S+") do
		if token ~= "|" then
			table.insert(list, token)
		end
	end
	return list
end

-- "E4:1.5" -> ("E4", 1.5) ; durée par défaut `default`
local function split(token: string, default: number): (string, number)
	local head, dur = string.match(token, "^([^:]+):([%d%.]+)$")
	if head then
		return head, tonumber(dur) or default
	end
	return token, default
end

-- Mélodie -> { { beat, note|nil, beats } }
function MusicData.ParseNotes(text: string): { { number } }
	local out = {}
	local beat = 0
	for _, token in ipairs(tokens(text)) do
		local head, dur = split(token, 1)
		local n = head ~= "r" and MusicData.Note(head) or nil
		if n then
			table.insert(out, { beat, n, dur })
		end
		beat += dur
	end
	return out
end

-- Accords -> { { beat, name|"r", beats } } ; sans durée = une mesure
function MusicData.ParseChords(text: string, beatsPerBar: number): { any }
	local out = {}
	local beat = 0
	for _, token in ipairs(tokens(text)) do
		local head, dur = split(token, beatsPerBar)
		table.insert(out, { beat, head, dur })
		beat += dur
	end
	return out
end

local function melodyLength(list: { { number } }): number
	local last = list[#list]
	return last and (last[1] + last[3]) or 0
end

-- Compile un morceau en événements triés (T en secondes)
function MusicData.Compile(song: Song): { Events: { Event }, Duration: number, BeatSec: number }
	local beatSec = 60 / song.Bpm
	local barBeats = song.Beats
	local totalBeats = song.Bars * barBeats
	local events: { Event } = {}
	local function add(beat: number, inst: string, n: number, v: number, dur: number)
		if beat < -1e-6 or beat >= totalBeats - 1e-6 then
			return
		end
		table.insert(events, { T = beat * beatSec, I = inst, N = n, V = math.clamp(v, 0.05, 1), D = math.max(0.05, dur * beatSec) })
	end
	-- accords (en boucle sur tout le morceau)
	local chordList = MusicData.ParseChords(song.Chords, barBeats)
	local cycle = 0
	for _, c in ipairs(chordList) do
		cycle = math.max(cycle, c[1] + c[3])
	end
	local chords: { any } = {}
	if cycle > 0 then
		local offset = 0
		while offset < totalBeats do
			for _, c in ipairs(chordList) do
				if offset + c[1] < totalBeats then
					table.insert(chords, { offset + c[1], c[2], c[3] })
				end
			end
			offset += cycle
		end
	end
	local function inBars(part: any, beat: number): boolean
		local bar = math.floor(beat / barBeats + 1e-6) + 1
		return bar >= (part.FromBar or 1) and bar <= (part.ToBar or song.Bars)
	end
	local melodies: { [number]: { { number } } } = {}
	for index, part in ipairs(song.Parts) do
		local kind = part.Kind
		local vel = part.Vel or 0.85
		if kind == "Lead" then
			local list = MusicData.ParseNotes(part.Notes)
			local len = melodyLength(list)
			local full = {}
			for r = 0, (part.Repeat or 1) - 1 do
				for _, e in ipairs(list) do
					table.insert(full, { e[1] + r * len, e[2], e[3] })
				end
			end
			melodies[index] = full
			for _, e in ipairs(full) do
				if inBars(part, e[1]) then
					-- (petite respiration : accents sur les temps forts)
					local accent = (e[1] % barBeats) < 1e-6 and 1 or 0.88
					add(e[1], part.I, e[2] + 12 * (part.Octave or 0), vel * accent, e[3])
				end
			end
		elseif kind == "Echo" then
			local source = melodies[part.Of]
			for _, e in ipairs(source or {}) do
				local beat = e[1] + (part.Delay or 0)
				if inBars(part, beat) then
					add(beat, part.I, e[2] + 12 * (part.Octave or 0), vel, e[3])
				end
			end
		elseif kind == "Harmony" then
			local style = part.Style
			local octave = 12 * (part.Octave or 0)
			for _, c in ipairs(chords) do
				local start, name, dur = c[1], c[2], c[3]
				if name ~= "r" and inBars(part, start) then
					local notes = MusicData.ChordNotes(name, 62 + octave)
					if style == "block" then
						local step = math.min(2, dur)
						local b = 0
						while b < dur - 1e-6 do
							for _, n in ipairs(notes) do
								add(start + b, part.I, n, vel, math.min(step, dur - b))
							end
							b += step
						end
					elseif style == "pad" then
						for _, n in ipairs(notes) do
							add(start, part.I, n, vel, dur)
						end
					elseif style == "arp" then
						local seq = table.clone(notes)
						table.insert(seq, notes[1] + 12)
						for i = #notes - 1, 2, -1 do
							table.insert(seq, notes[i])
						end
						local b, i = 0, 0
						while b < dur - 1e-6 do
							add(start + b, part.I, seq[i % #seq + 1], vel * (i % 2 == 0 and 1 or 0.8), 0.5)
							b += 0.5
							i += 1
						end
					elseif style == "strum" then
						-- rythme "Bas, Bas-Haut, Haut-Bas-Haut" (croches) ; guitare : 5 cordes
						local root = MusicData.Root(name, 40) or 48
						local voicing = { root }
						for _, n in ipairs(MusicData.ChordNotes(name, 58)) do
							table.insert(voicing, n)
						end
						table.insert(voicing, (MusicData.ChordNotes(name, 66))[1] or root + 24)
						local pattern = { { 0, 1 }, { 1, 1 }, { 1.5, -1 }, { 2.5, -1 }, { 3, 1 }, { 3.5, -1 } }
						for _, hit in ipairs(pattern) do
							local b = hit[1]
							if b < dur - 1e-6 then
								local down = hit[2] > 0
								local count = down and #voicing or 3
								for k = 1, count do
									local n = down and voicing[k] or voicing[#voicing - k + 1]
									add(start + b + (k - 1) * 0.035, part.I, n, vel * (down and 0.9 or 0.65), 0.45)
								end
							end
						end
					elseif style == "stabs" then
						local b = 0.5
						while b < dur - 1e-6 do
							for _, n in ipairs(notes) do
								add(start + b, part.I, n, vel, 0.25)
							end
							b += 1
						end
					elseif style == "lofi" then
						-- accord égrené (main un peu en retard), rejoué au 3e temps
						for k, n in ipairs(notes) do
							add(start + (k - 1) * 0.06, part.I, n, vel, 2)
							if dur >= 3 then
								add(start + 2.5 + (k - 1) * 0.05, part.I, n, vel * 0.7, 1.4)
							end
						end
					elseif style == "broken" then
						-- main gauche de "Lettre à Élise" : fondamentale grave, quinte, octave
						local root = MusicData.Root(name, 45) or 45
						add(start, part.I, root, vel, 0.25)
						add(start + 0.25, part.I, root + 7, vel * 0.8, 0.25)
						add(start + 0.5, part.I, root + 12, vel * 0.8, 0.25)
					end
				end
			end
		elseif kind == "Bass" then
			for _, c in ipairs(chords) do
				local start, name, dur = c[1], c[2], c[3]
				local root = name ~= "r" and MusicData.Root(name, 36) or nil
				if root and inBars(part, start) then
					local style = part.Style
					if style == "whole" then
						add(start, part.I, root, vel, dur)
					elseif style == "half" then
						add(start, part.I, root, vel, math.min(2, dur))
						if dur > 2 then
							add(start + 2, part.I, root + 7, vel * 0.8, dur - 2)
						end
					elseif style == "octave" then
						local b, i = 0, 0
						while b < dur - 1e-6 do
							add(start + b, part.I, root + (i % 2 == 1 and 12 or 0), vel * (i % 2 == 1 and 0.75 or 1), 0.45)
							b += 0.5
							i += 1
						end
					else -- "root" : fondamentale au 1er temps, quinte au 3e
						add(start, part.I, root, vel, math.min(dur, 1.5))
						if dur >= 3 then
							add(start + 2, part.I, root + 7, vel * 0.8, 1)
							add(start + 3.5, part.I, root + 12, vel * 0.55, 0.5)
						end
					end
				end
			end
		elseif kind == "Drums" and part.Style ~= "none" then
			local groove = GROOVES[part.Style] or GROOVES.pop
			local steps = math.floor(barBeats * 4 + 0.5)
			for bar = 0, song.Bars - 1 do
				local barStart = bar * barBeats
				local last = bar == song.Bars - 1
				local fill = (bar % 4 == 3) and not last
				for pieceKey, pattern in pairs(groove) do
					local piece: string = pieceKey
					local hatSoft = piece == "HatClosed"
					local isKick = piece == "Kick"
					for s = 1, steps do
						local ch = string.sub(pattern, (s - 1) % #pattern + 1, (s - 1) % #pattern + 1)
						local beat = barStart + (s - 1) * 0.25
						local inFill = fill and s > steps - 4
						if (ch == "x" or ch == "o") and not (inFill and not isKick) and not last then
							local v = (ch == "o" and 1 or 0.8) * vel * (hatSoft and (s % 2 == 1 and 0.75 or 0.5) or 1)
							add(beat, "Drums", MusicData.DRUM[piece], v, 0.2)
						end
					end
				end
				if fill then
					-- roulement de toms sur le dernier temps
					for k, piece in ipairs({ "TomHigh", "TomHigh", "TomMid", "TomFloor" }) do
						add(barStart + barBeats - 1 + (k - 1) * 0.25, "Drums", MusicData.DRUM[piece], vel * (0.7 + 0.08 * k), 0.2)
					end
				end
				if bar % 4 == 0 then
					add(barStart, "Drums", MusicData.DRUM.Crash, vel * 0.8, 1)
				end
				if last then
					add(barStart, "Drums", MusicData.DRUM.Crash, vel, 2)
					add(barStart, "Drums", MusicData.DRUM.Kick, vel, 0.5)
				end
			end
		elseif kind == "DJ" then
			local style: string = tostring(part.Style)
			for bar = 0, song.Bars - 1 do
				local barStart = bar * barBeats
				if style == "scratch" and bar % 4 == 3 then
					add(barStart + barBeats - 1, "DJ", 5, 0.8, 0.5)
					add(barStart + barBeats - 0.5, "DJ", 5, 0.7, 0.5)
				elseif style == "vinyl" and bar % 8 == 7 then
					add(barStart + barBeats - 1, "DJ", 7, 0.5, 1)
				end
			end
		end
	end
	table.sort(events, function(a, b)
		if a.T ~= b.T then
			return a.T < b.T
		end
		return a.I < b.I
	end)
	return { Events = events, Duration = totalBeats * beatSec, BeatSec = beatSec }
end

local compiled: { [string]: any } = {}

-- Morceau compilé (mis en cache) ; nil si inconnu
function MusicData.Song(id: string): any
	local cached = compiled[id]
	if cached then
		return cached
	end
	local index = MusicData.SONG_INDEX[id]
	if not index then
		return nil
	end
	local song = MusicData.SONGS[index]
	local result = MusicData.Compile(song)
	result.Id = song.Id
	result.Name = song.Name
	result.Icon = song.Icon
	result.Author = song.Author
	compiled[id] = result
	return result
end

-- Durée d'un morceau (s), 0 si inconnu
function MusicData.Duration(id: string): number
	local song = MusicData.Song(id)
	return song and song.Duration or 0
end

----------------------------------------------------------------------
-- 5. Boucles du DJ (1 mesure à 120 BPM = 2 s, calées sur l'heure du serveur)
----------------------------------------------------------------------

MusicData.LOOP_BPM = 120
MusicData.LOOP_BAR = 4 * 60 / MusicData.LOOP_BPM

local LOOPS: { { Groove: string, Bass: { number } } } = {
	{ Groove = "rock", Bass = { 45, 0, 45, 0, 0, 0, 48, 0, 45, 0, 45, 0, 43, 0, 43, 0 } },
	{ Groove = "house", Bass = { 0, 0, 45, 0, 0, 0, 45, 0, 0, 0, 48, 0, 0, 0, 47, 0 } },
	{ Groove = "hiphop", Bass = { 45, 0, 0, 0, 0, 0, 0, 45, 45, 0, 43, 0, 0, 0, 0, 0 } },
	{ Groove = "boom", Bass = { 50, 0, 0, 0, 0, 0, 0, 0, 43, 0, 0, 0, 0, 0, 45, 0 } },
}

local loopCache: { [number]: { Event } } = {}

-- Événements d'une boucle (T dans [0, LOOP_BAR[) : batterie + basse
function MusicData.Loop(index: number): { Event }
	local cached = loopCache[index]
	if cached then
		return cached
	end
	local def = LOOPS[index]
	local events: { Event } = {}
	if def then
		local step = MusicData.LOOP_BAR / 16
		for piece, pattern in pairs(GROOVES[def.Groove] or {}) do
			for s = 1, 16 do
				local ch = string.sub(pattern, s, s)
				if ch == "x" or ch == "o" then
					table.insert(events, { T = (s - 1) * step, I = "Drums", N = MusicData.DRUM[piece], V = ch == "o" and 0.95 or 0.75, D = 0.2 })
				end
			end
		end
		for s, n in ipairs(def.Bass) do
			if n > 0 then
				table.insert(events, { T = (s - 1) * step, I = "Bass", N = n, V = 0.8, D = step * 2 })
			end
		end
		table.sort(events, function(a, b)
			return a.T < b.T
		end)
	end
	loopCache[index] = events
	return events
end

return MusicData
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="342">
        <Properties>
          <string name="Name">NPCModels</string>
          <string name="Source"><![CDATA[--[[
	NPCModels (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > NPCModels

	🧍 Personnages non joueurs de Dopamine Town, partagés par le serveur ET le
	client (v9.8 CITY98 ; v9.9 NPC99 : "20x plus réalistes").
	Styles : caissier·ère, boulanger·ère, client·e, vendeur·se, passant·e,
	joggeur·se, enfant, personne âgée, ouvrier·ère.

	v9.9 (NPC99) — un vrai corps humain, "mignon-réaliste" :
	  - PROPORTIONS d'adulte (≈ 6,3 têtes : tête 0,84 pour 5,3 studs), épaules
	    à 4,16, coudes à 3,32, hanches à 2,6, genoux à 1,5, chevilles à 0,34 ;
	    torse arrondi (buste + cage thoracique ovale + ventre + bassin +
	    fessiers), cou, membres CYLINDRIQUES avec rotules (épaule, coude,
	    genou) : ils plient sans trou ;
	  - VISAGE : crâne + mâchoire, yeux dessinés (SurfaceGui, que des Frame :
	    blanc en amande, iris coloré, pupille, reflet, ligne de cils),
	    paupières qui CLIGNENT, sourcils, nez, lèvres (SurfaceGui), oreilles ;
	    barbe / moustache pour certains hommes, lunettes, maquillage léger ;
	  - CHEVEUX en volume (calotte + nuque + mèches, 10 coiffures : courte,
	    raie, longue, carré, chignon, queue de cheval, bouclée, afro, rasée,
	    chauve) ;
	  - VÊTEMENTS : col (rond, polo, chemise, V), coutures (ourlet, patte de
	    boutonnage, poche), ceinture + boucle, ourlets de pantalon, manches
	    courtes (ourlet) ou longues (poignets), jupe évasée, chaussures avec
	    SEMELLE contrastée, bout arrondi et lacets ;
	  - MAINS : paume, doigts légèrement repliés, POUCE ;
	  - accessoires de métier (visière + badge, toque + tablier, costume +
	    cravate + pochette + tablette, gilet fluo + casque, bandeau, cartable)
	    et objets tenus (sac, téléphone, café, canne, tablette).
	  ~55 à 75 pièces, ANCRÉES, sans collision / requête / contact (sauf la
	  capsule de collision, voir SetSolid), sans ombre pour les petites.
	  Aucune lumière, aucun son, aucun script.

	ANIMATION (v9.9) : marche avec attaque du talon, genou qui plie pendant
	l'oscillation, déroulé du pied, bassin qui se balance et tourne, buste en
	contre-rotation, bras en opposition, rebond vertical ; respiration et
	transfert du poids au repos, clignements des yeux ; la tête se TOURNE
	doucement vers le joueur proche (automatique côté client, ou `look`).

	COLLISION (v9.9) : chaque PNJ reçoit une capsule invisible, ancrée,
	CanCollide (cylindre debout ; boîte quand il est assis) qui suit le
	personnage : le joueur ne le traverse plus. Jamais piégé : si l'avatar
	local se retrouve DANS la capsule (PNJ apparu sur lui), la capsule
	devient traversable jusqu'à ce qu'il en sorte.

	Repère : le PIVOT du modèle est entre les pieds, au sol ; le personnage
	regarde vers -Z (LookVector du pivot). On le place avec
	`m:PivotTo(solCF)`.

	API (compatible v9.8) :
	  NPCModels.Build(style, opts?) -> Model   (non parenté)
	    opts : { Seed, Skin, Shirt, Pants, Hair, Scale, Prop, Name,
	             SitHeight?, Solid? (défaut true), Look? (défaut true) }
	    (même Seed -> même personne sur tous les clients)
	  NPCModels.Place(model, cf)       LA façon de DÉPLACER un PNJ qui bouge
	    (à chaque image) : ne pose que la pièce racine ; Animate repose le reste
	  NPCModels.Animate(model, anim, t, look?)   (CLIENT, à chaque image, léger)
	    anim : "idle" | "walk" | "talk" | "wave" | "scan" | "push" | "sit" |
	           "type" | "clap" | "cheer"
	    t : temps en secondes (+ décalage propre au PNJ) ; `look` (facultatif) :
	    point du monde à regarder (sinon : l'avatar local s'il est proche).
	    La pose est relative au pivot ACTUEL (Place / PivotTo d'abord).
	  NPCModels.SetSolid(model, on)    capsule de collision (défaut : on)
	  NPCModels.SetSitHeight(model, h) dessus du siège (studs au-dessus du
	    pivot) pour "sit" et pour un PNJ ASSIS qui fait autre chose ;
	  NPCModels.SetSeated(model, h?)   h = nombre : assis (les jambes restent
	    assises quelle que soit l'anim : caissier·ère sur un tabouret qui
	    "scan", client qui "talk" en terrasse) ; nil : debout
	  NPCModels.Height (5,3), NPCModels.SitHeight (1,45 : dessus d'un banc /
	    d'une chaise v9.9), NPCModels.Styles, NPCModels.Anims,
	  NPCModels.PartCount(model)
]]

local NPCModels = {}

local M = Enum.Material
local rgb = Color3.fromRGB

NPCModels.Height = 5.3
-- (v9.9) dessus d'un siège "standard" (banc de la ville, chaise) : le bassin
-- s'y pose (articulation de la hanche ≈ 0,24 au-dessus, fessiers dessus)
NPCModels.SitHeight = 1.45
NPCModels.Styles = { "cashier", "baker", "shopper", "salesperson", "pedestrian", "jogger", "kid", "elder", "worker" }
NPCModels.Anims = { "idle", "walk", "talk", "wave", "scan", "push", "sit", "type", "clap", "cheer" }

-- Groupes articulés (attribut "NpcG" de chaque pièce)
local G_CHEST, G_HEAD = 1, 2
local G_LUP, G_LLO, G_RUP, G_RLO = 3, 4, 5, 6
local G_LTH, G_LSH, G_RTH, G_RSH = 7, 8, 9, 10
local G_PELVIS, G_LFT, G_RFT = 11, 12, 13
local G_LID, G_COL = 14, 15
local NGROUPS = 15

-- Articulations au repos (repère du pivot, échelle 1)
local J = {
	Pelvis = Vector3.new(0, 2.66, 0),
	Waist = Vector3.new(0, 3.05, 0),
	Neck = Vector3.new(0, 4.42, 0.02),
	ShoulderL = Vector3.new(-0.68, 4.14, 0),
	ShoulderR = Vector3.new(0.68, 4.14, 0),
	ElbowL = Vector3.new(-0.73, 3.32, 0.02),
	ElbowR = Vector3.new(0.73, 3.32, 0.02),
	HipL = Vector3.new(-0.27, 2.6, 0),
	HipR = Vector3.new(0.27, 2.6, 0),
	KneeL = Vector3.new(-0.27, 1.5, 0),
	KneeR = Vector3.new(0.27, 1.5, 0),
	AnkleL = Vector3.new(-0.27, 0.34, 0.03),
	AnkleR = Vector3.new(0.27, 0.34, 0.03),
}
local THIGH_LEN = 1.1 -- (hanche -> genou)
local KNEE_Y = 1.5 -- (genou -> sol, pied à plat)
local HIP_OVER_SEAT = 0.22 -- (articulation de la hanche au-dessus du siège)
NPCModels.Joints = J

-- Tête (centre du crâne) et visage
local HY = 4.84
local HEAD = Vector3.new(0.68, 0.84, 0.76) -- crâne (ovale)

----------------------------------------------------------------------
-- Palettes réalistes
----------------------------------------------------------------------

local SKINS = {
	rgb(255, 226, 204),
	rgb(246, 212, 184),
	rgb(236, 192, 156),
	rgb(222, 172, 132),
	rgb(200, 146, 106),
	rgb(170, 116, 82),
	rgb(134, 90, 64),
	rgb(100, 66, 48),
}
local HAIRS = {
	rgb(34, 26, 24), -- noir
	rgb(64, 44, 32), -- brun foncé
	rgb(104, 70, 46), -- châtain
	rgb(150, 104, 62), -- châtain clair
	rgb(214, 176, 116), -- blond
	rgb(168, 80, 46), -- roux
	rgb(52, 36, 30),
	rgb(230, 200, 146), -- blond clair
}
local GREYS = { rgb(208, 208, 208), rgb(180, 180, 184), rgb(236, 234, 230), rgb(150, 148, 150) }
local IRIS = { rgb(92, 60, 38), rgb(62, 40, 28), rgb(120, 96, 52), rgb(70, 116, 160), rgb(84, 120, 84), rgb(110, 124, 136) }
local SHIRTS = {
	rgb(66, 110, 170), -- bleu jean
	rgb(236, 236, 232), -- blanc cassé
	rgb(186, 60, 70), -- rouge
	rgb(84, 140, 110), -- vert sauge
	rgb(238, 190, 88), -- moutarde
	rgb(146, 110, 176), -- lilas
	rgb(52, 58, 72), -- anthracite
	rgb(246, 170, 188), -- rose
	rgb(120, 176, 216), -- ciel
	rgb(206, 116, 72), -- terracotta
	rgb(230, 220, 196), -- beige
	rgb(40, 106, 118), -- canard
	rgb(96, 74, 64), -- chocolat
	rgb(210, 214, 222), -- gris perle
}
local PANTS = {
	rgb(50, 68, 106), -- jean
	rgb(38, 42, 52), -- noir
	rgb(128, 108, 84), -- chino
	rgb(82, 88, 98), -- gris
	rgb(72, 94, 140), -- jean clair
	rgb(196, 178, 142), -- beige
	rgb(70, 78, 60), -- kaki
}
local SHOES = { rgb(38, 36, 38), rgb(240, 240, 238), rgb(108, 68, 42), rgb(58, 68, 108), rgb(186, 56, 64), rgb(150, 130, 110) }
local INK = rgb(30, 24, 26)
local WHITE = rgb(250, 250, 248)

local HAIR_F = { "long", "bob", "bun", "pony", "curly", "long", "afro", "part" }
local HAIR_M = { "short", "part", "buzz", "curly", "short", "afro", "part", "short" }

----------------------------------------------------------------------
-- Hasard déterministe (ENTIERS : identique sur tous les processeurs)
----------------------------------------------------------------------

local MODP = 2147483647
local function hash(a: number, b: number): number
	-- (Park-Miller : produits < 2^53, exacts en double partout)
	local x = (math.floor(a) * 7919 + math.floor(b) * 104729 + 12345) % MODP
	x = (x * 48271) % MODP
	x = (x * 48271) % MODP
	x = (x * 48271) % MODP
	return x / MODP
end
NPCModels.Hash = hash

local function pick<T>(list: { T }, seed: number, salt: number): T
	return list[math.floor(hash(seed, salt) * #list) % #list + 1]
end

-- légère variation d'une couleur (tissus : jamais deux fois exactement la même)
local function vary(c: Color3, seed: number, salt: number, amount: number?): Color3
	local k = ((hash(seed, salt) - 0.5) * 2) * (amount or 0.06)
	if k > 0 then
		return c:Lerp(WHITE, k)
	end
	return c:Lerp(INK, -k)
end

----------------------------------------------------------------------
-- Fabrique
----------------------------------------------------------------------

export type Opts = {
	Seed: number?,
	Skin: Color3?,
	Shirt: Color3?,
	Pants: Color3?,
	Hair: Color3?,
	Scale: number?,
	Prop: string?,
	Name: string?,
	SitHeight: number?,
	Solid: boolean?,
	Look: boolean?,
}

type Ctx = {
	Model: Model,
	S: number, -- échelle du corps
	HS: number, -- échelle en plus pour la tête (enfants : tête plus grosse)
	Count: number,
}

-- Pièce dans le groupe `g` : `cf` et `size` dans le repère de repos (échelle
-- 1). Les pièces de la tête sont agrandies autour du cou (HS).
local function add(ctx: Ctx, g: number, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: string?): BasePart
	local s = ctx.S
	local pos = cf.Position
	local sz = size
	if (g == G_HEAD or g == G_LID) and ctx.HS ~= 1 then
		pos = J.Neck + (pos - J.Neck) * ctx.HS
		sz = size * ctx.HS
	end
	local rest = CFrame.new(pos * s) * cf.Rotation
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = (name == "Chest" or name == "Pelvis" or name == "Thigh" or name == "Skull")
	p.Size = sz * s
	p.CFrame = rest
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape == "Ball" then
		(p :: Part).Shape = Enum.PartType.Ball
	elseif shape == "Cyl" then
		(p :: Part).Shape = Enum.PartType.Cylinder
	elseif shape == "Egg" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	p:SetAttribute("NpcG", g)
	p:SetAttribute("NpcRest", rest)
	p.Parent = ctx.Model
	ctx.Count += 1
	return p
end

local UPRIGHT = CFrame.Angles(0, 0, math.rad(90)) -- cylindre debout (axe X -> Y)
local function at(x: number, y: number, z: number): CFrame
	return CFrame.new(x, y, z)
end
-- cylindre debout centré en (x, y, z)
local function cylY(x: number, y: number, z: number): CFrame
	return CFrame.new(x, y, z) * UPRIGHT
end

-- Point de la surface du crâne (ovale) vu depuis l'avant, à (x, y) :
-- position + repère tourné pour suivre la courbure (plaques du visage)
local function onEgg(center: Vector3, size: Vector3, x: number, y: number, out: number): CFrame
	local a, b, c = size.X / 2, size.Y / 2, size.Z / 2
	local dx, dy = x - center.X, y - center.Y
	local k = 1 - (dx / a) ^ 2 - (dy / b) ^ 2
	local z = -c * math.sqrt(math.max(k, 0.02))
	-- normale (gradient de l'ovale)
	local n = Vector3.new(dx / (a * a), dy / (b * b), z / (c * c)).Unit
	local p = Vector3.new(x, y, center.Z + z) + n * out
	return CFrame.lookAt(p, p + n)
end
local function onSkull(x: number, y: number, out: number): CFrame
	return onEgg(Vector3.new(0, HY, 0), HEAD, x, y, out)
end

----------------------------------------------------------------------
-- Visage dessiné (SurfaceGui, uniquement des Frame arrondies)
----------------------------------------------------------------------

local function frame(parent: Instance, name: string, size: UDim2, pos: UDim2, color: Color3, round: number?, yy: boolean?): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Size = size
	f.Position = pos
	f.BackgroundColor3 = color
	f.BorderSizePixel = 0
	if yy then
		f.SizeConstraint = Enum.SizeConstraint.RelativeYY
	end
	if round then
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(round, 0)
		c.Parent = f
	end
	f.Parent = parent
	return f
end

local function faceGui(part: BasePart, name: string): SurfaceGui
	local gui = Instance.new("SurfaceGui")
	gui.Name = name
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 400
	gui.LightInfluence = 1
	gui.MaxDistance = 140
	gui.ClipsDescendants = true
	gui.Parent = part
	return gui
end

-- Œil : blanc en amande, iris, pupille, reflet, ligne de cils (côté `sx`)
local function eyeGui(part: BasePart, iris: Color3, lash: Color3, female: boolean, sx: number)
	local gui = faceGui(part, "EyeGui")
	local white = frame(gui, "White", UDim2.fromScale(0.94, 0.74), UDim2.fromScale(0.5, 0.55), rgb(246, 242, 238), 0.5)
	local ir = frame(white, "Iris", UDim2.fromScale(0.98, 0.98), UDim2.fromScale(0.5 - sx * 0.02, 0.48), iris, 1, true)
	frame(ir, "Ring", UDim2.fromScale(0.72, 0.72), UDim2.fromScale(0.5, 0.5), iris:Lerp(WHITE, 0.18), 1)
	frame(ir, "Pupil", UDim2.fromScale(0.44, 0.44), UDim2.fromScale(0.5, 0.5), rgb(16, 12, 14), 1)
	frame(ir, "Glint", UDim2.fromScale(0.24, 0.24), UDim2.fromScale(0.66, 0.32), WHITE, 1)
	frame(ir, "Glint2", UDim2.fromScale(0.1, 0.1), UDim2.fromScale(0.34, 0.68), WHITE, 1)
	-- paupière supérieure (ligne de cils), plus marquée chez les femmes
	frame(gui, "Lash", UDim2.fromScale(1, female and 0.26 or 0.16), UDim2.fromScale(0.5, female and 0.2 or 0.2), lash, 0.5)
	if female then
		-- petite aile de cils vers l'extérieur
		local wing = frame(gui, "Wing", UDim2.fromScale(0.22, 0.14), UDim2.fromScale(sx > 0 and 0.95 or 0.05, 0.16), lash, 0.5)
		wing.Rotation = sx * -22
	end
end

-- Lèvres : lèvre supérieure, lèvre inférieure, commissure, petit sourire
local function mouthGui(part: BasePart, lip: Color3, smile: number)
	local gui = faceGui(part, "MouthGui")
	frame(gui, "LowerLip", UDim2.fromScale(0.62, 0.5), UDim2.fromScale(0.5, 0.62), lip:Lerp(WHITE, 0.08), 0.5)
	frame(gui, "UpperLip", UDim2.fromScale(0.72, 0.36), UDim2.fromScale(0.5, 0.36), lip, 0.5)
	frame(gui, "Line", UDim2.fromScale(0.74, 0.1), UDim2.fromScale(0.5, 0.5), lip:Lerp(INK, 0.55), 0.5)
	for _, sx in ipairs({ -1, 1 }) do
		local c = frame(gui, "Corner", UDim2.fromScale(0.14, 0.09), UDim2.fromScale(0.5 + sx * 0.4, 0.45 - smile * 0.06), lip:Lerp(INK, 0.5), 0.5)
		c.Rotation = sx * -(18 + smile * 20)
	end
end

----------------------------------------------------------------------
-- Tête
----------------------------------------------------------------------

type Look = {
	Skin: Color3,
	Hair: Color3,
	HairStyle: string,
	Shirt: Color3,
	Pants: Color3,
	Shoe: Color3,
	Sole: Color3,
	Female: boolean,
	LongSleeve: boolean,
	Shorts: boolean,
	Skirt: boolean,
	Belt: boolean,
	Collar: string, -- "crew" | "polo" | "shirt" | "v" | "none"
	Beard: string, -- "none" | "stubble" | "beard" | "mustache"
	Glasses: boolean,
	Iris: Color3,
}

local function head(ctx: Ctx, look: Look, seed: number)
	local skin, hair = look.Skin, look.Hair
	local female = look.Female
	add(ctx, G_HEAD, "Skull", HEAD, at(0, HY, 0), skin, M.SmoothPlastic, "Egg")
	-- mâchoire / menton (plus carrée chez les hommes)
	local jawC, jawS = Vector3.new(0, HY - 0.21, -0.06), Vector3.new(female and 0.5 or 0.56, 0.46, 0.6)
	local function onJaw(x: number, y: number, out: number): CFrame
		return onEgg(jawC, jawS, x, y, out)
	end
	add(ctx, G_HEAD, "Jaw", jawS, CFrame.new(jawC), skin, M.SmoothPlastic, "Egg")
	-- oreilles
	for _, sx in ipairs({ -1, 1 }) do
		add(ctx, G_HEAD, "Ear", Vector3.new(0.08, 0.2, 0.15), at(sx * 0.33, HY - 0.02, 0.03) * CFrame.Angles(0, sx * -0.3, 0), skin:Lerp(rgb(200, 120, 110), 0.08), M.SmoothPlastic, "Egg")
	end
	-- nez (arête + bout)
	add(ctx, G_HEAD, "Nose", Vector3.new(0.1, 0.2, 0.12), onSkull(0, HY - 0.08, 0.0) * CFrame.Angles(math.rad(-10), 0, 0), skin:Lerp(rgb(210, 130, 110), 0.1), M.SmoothPlastic, "Egg")
	-- yeux (plaques dessinées) + paupières (clignent) + sourcils
	local lash = look.HairStyle == "bald" and INK or hair:Lerp(INK, 0.6)
	for _, sx in ipairs({ -1, 1 }) do
		local e = add(ctx, G_HEAD, "Eye", Vector3.new(0.15, 0.1, 0.01), onSkull(sx * 0.125, HY + 0.01, 0.006), WHITE, M.SmoothPlastic)
		e.Transparency = 1
		eyeGui(e, look.Iris, lash, female, sx)
		-- paupière : cachée DANS le crâne ; au clignement elle avance devant l'œil
		add(ctx, G_LID, "Lid", Vector3.new(0.17, 0.12, 0.03), onSkull(sx * 0.125, HY + 0.015, -0.045), skin:Lerp(INK, 0.04), M.SmoothPlastic, "Egg")
		local browColor = look.HairStyle == "bald" and GREYS[1]:Lerp(INK, 0.3) or hair:Lerp(INK, 0.25)
		add(ctx, G_HEAD, "Brow", Vector3.new(0.16, female and 0.03 or 0.042, 0.04), onSkull(sx * 0.13, HY + 0.11, 0.0) * CFrame.Angles(0, 0, sx * (female and -0.14 or -0.06)), browColor, M.SmoothPlastic)
	end
	-- bouche
	local lip = skin:Lerp(rgb(176, 84, 88), female and 0.45 or 0.28)
	if female and hash(seed, 70) < 0.35 then
		lip = pick({ rgb(190, 60, 80), rgb(200, 100, 110), rgb(160, 70, 70) }, seed, 71)
	end
	local mouth = add(ctx, G_HEAD, "Mouth", Vector3.new(0.2, 0.08, 0.01), onJaw(0, HY - 0.25, 0.008), WHITE, M.SmoothPlastic)
	mouth.Transparency = 1
	mouthGui(mouth, lip, hash(seed, 72))
	-- barbe / moustache
	local bc = hair:Lerp(INK, 0.1)
	if look.Beard == "beard" then
		-- (barbe du menton et des joues : derrière la bouche, devant le menton)
		add(ctx, G_HEAD, "Beard", Vector3.new(0.62, 0.34, 0.66), at(0, HY - 0.34, -0.04), bc, M.SmoothPlastic, "Egg")
		add(ctx, G_HEAD, "Mustache", Vector3.new(0.22, 0.05, 0.05), onJaw(0, HY - 0.195, 0.01), bc, M.SmoothPlastic)
	elseif look.Beard == "mustache" then
		add(ctx, G_HEAD, "Mustache", Vector3.new(0.24, 0.06, 0.05), onJaw(0, HY - 0.195, 0.01), bc, M.SmoothPlastic)
	end
	if look.Glasses then
		local frameC = pick({ rgb(40, 34, 34), rgb(120, 80, 50), rgb(180, 170, 160) }, seed, 73)
		for _, sx in ipairs({ -1, 1 }) do
			local lens = add(ctx, G_HEAD, "Glasses", Vector3.new(0.02, 0.15, 0.2), onSkull(sx * 0.125, HY + 0.005, 0.05) * CFrame.Angles(0, math.rad(90), 0), rgb(210, 226, 236), M.Glass, "Cyl")
			lens.Transparency = 0.55
			add(ctx, G_HEAD, "GlassesArm", Vector3.new(0.025, 0.025, 0.36), at(sx * 0.34, HY + 0.03, -0.13), frameC, M.SmoothPlastic)
		end
		add(ctx, G_HEAD, "GlassesBridge", Vector3.new(0.07, 0.025, 0.025), onSkull(0, HY + 0.03, 0.06), frameC, M.SmoothPlastic)
	end
	-- coiffure (volumes superposés, chacun à >= 0,03 des autres faces)
	local hs = look.HairStyle
	if hs == "none" then
		return
	end
	local hairM = M.SmoothPlastic
	if hs == "bald" then
		add(ctx, G_HEAD, "HairSide", Vector3.new(0.74, 0.3, 0.7), at(0, HY + 0.04, 0.1), hair, hairM, "Egg")
		return
	end
	local dark = hair:Lerp(INK, 0.12)
	if hs == "buzz" then
		add(ctx, G_HEAD, "Hair", Vector3.new(HEAD.X * 1.09, HEAD.Y * 0.9, HEAD.Z * 1.06), at(0, HY + 0.14, 0.07) * CFrame.Angles(math.rad(-15), 0, 0), hair, hairM, "Egg")
		return
	end
	-- calotte (inclinée : dégage le front) + nuque
	-- (ovale 1,04 x 0,9 x 1,1 du crâne, remonté de 0,14, reculé de 0,08, incliné
	-- de 15° : naissance des cheveux à ~0,23 au-dessus des yeux, tempes
	-- dégagées au-dessus des sourcils ; cherché numériquement)
	add(ctx, G_HEAD, "Hair", Vector3.new(HEAD.X * 1.09, HEAD.Y * 0.9, HEAD.Z * 1.1), at(0, HY + 0.14, 0.08) * CFrame.Angles(math.rad(-15), 0, 0), hair, hairM, "Egg")
	add(ctx, G_HEAD, "HairBack", Vector3.new(0.62, 0.62, 0.42), at(0, HY - 0.02, 0.2), dark, hairM, "Egg")
	if hs == "short" then
		add(ctx, G_HEAD, "Quiff", Vector3.new(0.56, 0.2, 0.34), at(0.03, HY + 0.4, -0.2) * CFrame.Angles(math.rad(-22), 0, 0), hair:Lerp(WHITE, 0.05), hairM, "Egg")
	elseif hs == "part" then
		-- raie sur le côté : mèche qui retombe
		add(ctx, G_HEAD, "Fringe", Vector3.new(0.62, 0.2, 0.4), at(0.07, HY + 0.33, -0.22) * CFrame.Angles(math.rad(-20), 0, -0.18), hair:Lerp(WHITE, 0.05), hairM, "Egg")
	elseif hs == "long" or hs == "bob" or hs == "pony" or hs == "bun" then
		for _, sx in ipairs({ -1, 1 }) do
			local len = hs == "long" and 0.95 or (hs == "bob" and 0.56 or 0.34)
			add(ctx, G_HEAD, "HairSideLock", Vector3.new(0.14, len, 0.36), at(sx * 0.34, HY + 0.2 - len / 2, 0.06) * CFrame.Angles(0, 0, sx * 0.05), hair, hairM, "Egg")
		end
		add(ctx, G_HEAD, "Fringe", Vector3.new(0.66, 0.22, 0.36), at(-0.05, HY + 0.32, -0.23) * CFrame.Angles(math.rad(-24), 0, 0.14), hair:Lerp(WHITE, 0.06), hairM, "Egg")
		if hs == "long" then
			add(ctx, G_HEAD, "HairLong", Vector3.new(0.72, 1.08, 0.3), at(0, HY - 0.34, 0.27) * CFrame.Angles(math.rad(8), 0, 0), dark, hairM, "Egg")
		elseif hs == "bob" then
			add(ctx, G_HEAD, "HairBob", Vector3.new(0.8, 0.46, 0.5), at(0, HY - 0.12, 0.16), dark, hairM, "Egg")
		elseif hs == "bun" then
			add(ctx, G_HEAD, "Bun", Vector3.new(0.32, 0.32, 0.32), at(0, HY + 0.34, 0.36), hair, hairM, "Ball")
		else
			add(ctx, G_HEAD, "Pony", Vector3.new(0.22, 0.72, 0.24), at(0, HY - 0.12, 0.5) * CFrame.Angles(math.rad(-16), 0, 0), dark, hairM, "Egg")
			add(ctx, G_HEAD, "Tie", Vector3.new(0.14, 0.09, 0.14), at(0, HY + 0.22, 0.43), pick({ rgb(236, 72, 140), rgb(90, 140, 230), rgb(250, 250, 250), rgb(40, 40, 44) }, seed, 22), M.SmoothPlastic, "Egg")
		end
	elseif hs == "curly" then
		for i = 0, 5 do
			local a = (i / 5 - 0.5) * 2.6
			add(ctx, G_HEAD, "Curl", Vector3.new(0.3, 0.3, 0.3), at(math.sin(a) * 0.3, HY + 0.3 + math.cos(a) * 0.1, 0.04 + math.abs(math.sin(a)) * 0.08 - (i % 2) * 0.1), i % 2 == 0 and hair or dark, hairM, "Ball")
		end
	elseif hs == "afro" then
		add(ctx, G_HEAD, "Afro", Vector3.new(0.98, 0.86, 0.96), at(0, HY + 0.24, 0.16), dark, M.Fabric, "Egg")
	end
end

----------------------------------------------------------------------
-- Corps
----------------------------------------------------------------------

-- Bras : épaule (deltoïde), bras, coude, avant-bras, main (paume, doigts,
-- POUCE) ; manches courtes (ourlet) ou longues (poignet)
local function arm(ctx: Ctx, sx: number, sleeve: Color3, skin: Color3, longSleeve: boolean, cuff: Color3?, bare: boolean?)
	local up = sx < 0 and G_LUP or G_RUP
	local lo = sx < 0 and G_LLO or G_RLO
	local x = sx * 0.73
	add(ctx, up, "Deltoid", Vector3.new(0.42, 0.42, 0.42), at(sx * 0.65, 4.1, 0), bare and skin or sleeve, bare and M.SmoothPlastic or M.Fabric, "Ball")
	add(ctx, up, "UpperArm", Vector3.new(0.84, 0.34, 0.34), cylY(sx * 0.72, 3.72, 0.01), (longSleeve and not bare) and sleeve or skin, (longSleeve and not bare) and M.Fabric or M.SmoothPlastic, "Cyl")
	if not longSleeve and not bare then
		-- manche courte : ourlet un peu plus large
		add(ctx, up, "Sleeve", Vector3.new(0.4, 0.42, 0.42), cylY(sx * 0.72, 3.9, 0.01), sleeve, M.Fabric, "Cyl")
		add(ctx, up, "SleeveHem", Vector3.new(0.05, 0.43, 0.43), cylY(sx * 0.72, 3.72, 0.01), sleeve:Lerp(INK, 0.12), M.Fabric, "Cyl")
	end
	add(ctx, lo, "Elbow", Vector3.new(0.33, 0.33, 0.33), at(x, 3.32, 0.02), longSleeve and sleeve or skin, longSleeve and M.Fabric or M.SmoothPlastic, "Ball")
	add(ctx, lo, "Forearm", Vector3.new(0.72, 0.3, 0.3), cylY(x, 2.97, 0.02), longSleeve and sleeve or skin, longSleeve and M.Fabric or M.SmoothPlastic, "Cyl")
	if longSleeve then
		add(ctx, lo, "Cuff", Vector3.new(0.12, 0.33, 0.33), cylY(x, 2.63, 0.02), cuff or sleeve:Lerp(INK, 0.1), M.Fabric, "Cyl")
	end
	-- main (paume face à la cuisse) : doigts un peu repliés, pouce devant
	local hx = sx * 0.745
	add(ctx, lo, "Palm", Vector3.new(0.12, 0.3, 0.25), at(hx, 2.46, 0.01), skin, M.SmoothPlastic)
	add(ctx, lo, "Fingers", Vector3.new(0.1, 0.24, 0.22), at(hx - sx * 0.02, 2.22, 0.0) * CFrame.Angles(0, 0, sx * 0.22), skin, M.SmoothPlastic)
	add(ctx, lo, "Thumb", Vector3.new(0.08, 0.2, 0.08), at(hx - sx * 0.035, 2.42, -0.14) * CFrame.Angles(math.rad(-18), 0, sx * 0.3), skin, M.SmoothPlastic)
end

-- Jambes : cuisse, genou, tibia, mollet, ourlet ; pied : chaussure, bout
-- arrondi, semelle, lacets
local function legs(ctx: Ctx, look: Look, pants: Color3, shorts: boolean, bareThigh: boolean?)
	local skin = look.Skin
	for _, sx in ipairs({ -1, 1 }) do
		local th = sx < 0 and G_LTH or G_RTH
		local sh = sx < 0 and G_LSH or G_RSH
		local ft = sx < 0 and G_LFT or G_RFT
		local x = sx * 0.27
		local thighC = bareThigh and skin or pants
		local thighM = bareThigh and M.SmoothPlastic or M.Fabric
		add(ctx, th, "Thigh", Vector3.new(1.2, 0.5, 0.5), cylY(x, 2.02, 0), thighC, thighM, "Cyl")
		if shorts and not bareThigh then
			add(ctx, th, "ShortsHem", Vector3.new(0.1, 0.54, 0.54), cylY(x, 1.66, 0), pants:Lerp(INK, 0.12), M.Fabric, "Cyl")
		end
		local legC = shorts and skin or pants
		local legM = shorts and M.SmoothPlastic or M.Fabric
		add(ctx, sh, "Knee", Vector3.new(0.42, 0.42, 0.42), at(x, 1.5, 0), (shorts or bareThigh) and skin or pants, (shorts or bareThigh) and M.SmoothPlastic or M.Fabric, "Ball")
		add(ctx, sh, "Shin", Vector3.new(1.1, 0.38, 0.38), cylY(x, 0.93, 0.02), legC, legM, "Cyl")
		add(ctx, sh, "Calf", Vector3.new(0.32, 0.6, 0.34), at(x, 1.14, 0.08), legC, legM, "Egg")
		if not shorts then
			add(ctx, sh, "Hem", Vector3.new(0.09, 0.43, 0.43), cylY(x, 0.395, 0.02), pants:Lerp(INK, 0.1), M.Fabric, "Cyl")
		else
			add(ctx, sh, "Sock", Vector3.new(0.14, 0.4, 0.4), cylY(x, 0.41, 0.02), WHITE, M.Fabric, "Cyl")
		end
		-- pied (tourne à la cheville)
		add(ctx, ft, "Shoe", Vector3.new(0.36, 0.26, 0.74), at(x, 0.2, -0.13), look.Shoe, M.SmoothPlastic)
		add(ctx, ft, "ToeCap", Vector3.new(0.33, 0.2, 0.34), at(x, 0.215, -0.47), look.Shoe, M.SmoothPlastic, "Egg")
		add(ctx, ft, "Sole", Vector3.new(0.4, 0.09, 0.9), at(x, 0.05, -0.18), look.Sole, M.Rubber)
		add(ctx, ft, "Laces", Vector3.new(0.18, 0.04, 0.3), at(x, 0.345, -0.28) * CFrame.Angles(math.rad(-12), 0, 0), look.Shoe:Lerp(WHITE, 0.55), M.Fabric)
	end
end

-- Buste + bassin + cou + col / coutures
local function torso(ctx: Ctx, look: Look, shirt: Color3, pants: Color3, skirt: boolean, style: string, seed: number)
	local skin = look.Skin
	local female = look.Female
	-- sections en "stade" (bloc + 2 cylindres debout) : torse arrondi, sans
	-- arêtes vives ni bosses ovales qui dépassent
	local function stadium(g: number, name: string, width: number, depth: number, y0: number, y1: number, color: Color3, z: number?)
		local h = y1 - y0
		local y = (y0 + y1) / 2
		local zz = z or 0
		add(ctx, g, name, Vector3.new(width - depth, h, depth), at(0, y, zz), color, M.Fabric)
		for _, sx in ipairs({ -1, 1 }) do
			add(ctx, g, name .. "Side", Vector3.new(h, depth, depth), cylY(sx * (width - depth) / 2, y, zz), color, M.Fabric, "Cyl")
		end
	end
	stadium(G_CHEST, "Chest", female and 1.06 or 1.16, female and 0.5 or 0.52, 3.36, 4.2, shirt)
	-- ligne des épaules (arrondie)
	add(ctx, G_CHEST, "Shoulders", Vector3.new(1.0, 0.44, 0.44), at(0, 4.14, 0.0), shirt, M.Fabric, "Cyl")
	if female then
		add(ctx, G_CHEST, "Bust", Vector3.new(0.5, 0.32, 0.32), at(0, 3.9, -0.12), shirt, M.Fabric, "Cyl")
	end
	stadium(G_CHEST, "Belly", female and 0.9 or 1.02, female and 0.46 or 0.48, 2.9, 3.4, shirt)
	add(ctx, G_CHEST, "Neck", Vector3.new(0.36, 0.3, 0.3), cylY(0, 4.44, 0.03), skin, M.SmoothPlastic, "Cyl")
	-- col
	local col = look.Collar
	if col == "crew" then
		add(ctx, G_CHEST, "Collar", Vector3.new(0.07, 0.4, 0.4), cylY(0, 4.36, 0.03), shirt:Lerp(INK, 0.1), M.Fabric, "Cyl")
	elseif col == "v" then
		for _, sx in ipairs({ -1, 1 }) do
			add(ctx, G_CHEST, "Collar", Vector3.new(0.05, 0.2, 0.04), at(sx * 0.06, 4.24, -0.29) * CFrame.Angles(0, 0, sx * 0.55), shirt:Lerp(INK, 0.14), M.Fabric)
		end
	elseif col == "polo" or col == "shirt" then
		local cc = col == "polo" and shirt:Lerp(WHITE, 0.12) or shirt
		for _, sx in ipairs({ -1, 1 }) do
			add(ctx, G_CHEST, "Collar", Vector3.new(0.2, 0.06, 0.24), at(sx * 0.13, 4.35, -0.14) * CFrame.Angles(math.rad(-22), sx * 0.4, sx * -0.3), cc, M.Fabric)
		end
		add(ctx, G_CHEST, "Placket", Vector3.new(0.1, col == "polo" and 0.36 or 1.0, 0.03), at(0, col == "polo" and 4.1 or 3.62, -0.3), shirt:Lerp(INK, 0.08), M.Fabric)
		for i = 0, (col == "polo" and 1 or 3) do
			add(ctx, G_CHEST, "Button", Vector3.new(0.05, 0.05, 0.03), at(0, 4.18 - i * 0.24, -0.325), shirt:Lerp(WHITE, 0.5), M.SmoothPlastic, "Ball")
		end
		if col == "shirt" and hash(seed, 80) < 0.6 then
			add(ctx, G_CHEST, "Pocket", Vector3.new(0.22, 0.24, 0.03), at(-0.26, 3.86, -0.3), shirt:Lerp(INK, 0.06), M.Fabric)
		end
	end
	-- bassin + fessiers (ou jupe)
	local hipW = female and 1.08 or 1.0
	local hipD = female and 0.54 or 0.52
	stadium(G_PELVIS, "Pelvis", hipW, hipD, 2.46, 2.94, pants)
	if skirt then
		-- jupe en corolle (s'arrête au-dessus du genou)
		add(ctx, G_PELVIS, "Skirt", Vector3.new(1.18, 1.1, 0.82), at(0, 2.32, 0.01), pants, M.Fabric, "Egg")
	else
		add(ctx, G_PELVIS, "Glutes", Vector3.new(hipW - 0.4, 0.42, 0.42), at(0, 2.6, 0.09), pants, M.Fabric, "Cyl")
		add(ctx, G_PELVIS, "Crotch", Vector3.new(0.4, 0.3, 0.44), at(0, 2.42, 0), pants, M.Fabric, "Egg")
	end
	if look.Belt and style ~= "baker" and not skirt then
		-- ceinture tout autour (même "stade", un peu plus large) + boucle
		local belt = rgb(56, 38, 28)
		add(ctx, G_PELVIS, "Belt", Vector3.new(hipW - hipD, 0.1, hipD + 0.06), at(0, 2.86, 0), belt, M.Leather)
		for _, sx in ipairs({ -1, 1 }) do
			add(ctx, G_PELVIS, "BeltSide", Vector3.new(0.1, hipD + 0.06, hipD + 0.06), cylY(sx * (hipW - hipD) / 2, 2.86, 0), belt, M.Leather, "Cyl")
		end
		add(ctx, G_PELVIS, "Buckle", Vector3.new(0.14, 0.1, 0.03), at(0, 2.86, -hipD / 2 - 0.045), rgb(196, 182, 150), M.Metal)
	end
	return skin
end

----------------------------------------------------------------------
-- Tenues par style
----------------------------------------------------------------------

local function baseLook(style: string, seed: number, opts: Opts): Look
	local female = hash(seed, 1) < 0.5
	local hairStyle = female and pick(HAIR_F, seed, 2) or pick(HAIR_M, seed, 2)
	local hair = pick(HAIRS, seed, 4)
	local skin = opts.Skin or pick(SKINS, seed, 7)
	-- (cheveux crépus / afro plus fréquents avec les peaux foncées, jamais imposés)
	if hairStyle == "afro" and hash(seed, 3) < 0.5 then
		hairStyle = female and "curly" or "short"
	end
	local beard = "none"
	if not female and style ~= "kid" then
		local b = hash(seed, 14)
		beard = b < 0.12 and "beard" or (b < 0.2 and "mustache" or "none")
	end
	local glasses = style ~= "kid" and hash(seed, 15) < 0.18
	if style == "elder" then
		hair = pick(GREYS, seed, 5)
		if not female and hash(seed, 6) < 0.45 then
			hairStyle = "bald"
		elseif female then
			hairStyle = hash(seed, 6) < 0.5 and "bun" or "bob"
		end
		glasses = hash(seed, 57) < 0.6
	end
	local collars = { "crew", "crew", "v", "shirt", "polo", "crew" }
	local sole = pick({ rgb(236, 232, 224), rgb(40, 36, 36), rgb(170, 120, 70) }, seed, 16)
	return {
		Skin = skin,
		Hair = opts.Hair or hair,
		HairStyle = hairStyle,
		Shirt = opts.Shirt or vary(pick(SHIRTS, seed, 8), seed, 17),
		Pants = opts.Pants or vary(pick(PANTS, seed, 9), seed, 18),
		Shoe = pick(SHOES, seed, 10),
		Sole = sole,
		Female = female,
		LongSleeve = hash(seed, 11) < 0.45,
		Shorts = false,
		Skirt = female and hash(seed, 12) < 0.3,
		Belt = hash(seed, 13) < 0.55,
		Collar = pick(collars, seed, 19),
		Beard = beard,
		Glasses = glasses,
		Iris = pick(IRIS, seed, 21),
	}
end

-- Main droite / gauche (repos) : pour les objets tenus
local HAND_R = Vector3.new(0.745, 2.3, 0.0)
local HAND_L = Vector3.new(-0.745, 2.3, 0.0)

-- Objet tenu (groupe avant-bras)
local function prop(ctx: Ctx, kind: string, seed: number)
	local h = HAND_R
	if kind == "bag" then
		local c = pick({ rgb(236, 72, 140), rgb(250, 250, 248), rgb(120, 190, 90), rgb(90, 140, 230), rgb(206, 166, 118) }, seed, 30)
		add(ctx, G_RLO, "Bag", Vector3.new(0.32, 0.84, 0.78), at(h.X + 0.12, h.Y - 0.72, 0), c, M.SmoothPlastic)
		add(ctx, G_RLO, "BagFold", Vector3.new(0.38, 0.1, 0.84), at(h.X + 0.12, h.Y - 0.4, 0), c:Lerp(INK, 0.15), M.SmoothPlastic)
		add(ctx, G_RLO, "BagHandle", Vector3.new(0.05, 0.36, 0.44), at(h.X + 0.1, h.Y - 0.1, 0), c:Lerp(INK, 0.35), M.SmoothPlastic)
	elseif kind == "phone" then
		add(ctx, G_RLO, "Phone", Vector3.new(0.06, 0.34, 0.18), at(h.X - 0.08, h.Y + 0.04, -0.12), rgb(28, 28, 34), M.SmoothPlastic)
		add(ctx, G_RLO, "PhoneScreen", Vector3.new(0.02, 0.3, 0.15), at(h.X - 0.115, h.Y + 0.04, -0.12), rgb(120, 180, 250), M.Glass)
	elseif kind == "coffee" then
		add(ctx, G_RLO, "Cup", Vector3.new(0.4, 0.24, 0.24), cylY(h.X - 0.02, h.Y + 0.08, -0.16), WHITE, M.SmoothPlastic, "Cyl")
		add(ctx, G_RLO, "CupSleeve", Vector3.new(0.16, 0.26, 0.26), cylY(h.X - 0.02, h.Y + 0.05, -0.16), rgb(170, 120, 80), M.Cardboard, "Cyl")
		add(ctx, G_RLO, "CupLid", Vector3.new(0.05, 0.27, 0.27), cylY(h.X - 0.02, h.Y + 0.3, -0.16), rgb(60, 50, 50), M.SmoothPlastic, "Cyl")
	elseif kind == "cane" then
		add(ctx, G_RLO, "Cane", Vector3.new(0.1, 2.1, 0.1), at(h.X + 0.02, h.Y - 1.05, -0.12), rgb(104, 66, 40), M.Wood)
		add(ctx, G_RLO, "CaneGrip", Vector3.new(0.34, 0.1, 0.1), cylY(h.X + 0.02, h.Y + 0.05, -0.2) * CFrame.Angles(0, math.rad(90), 0), rgb(104, 66, 40), M.Wood, "Cyl")
		add(ctx, G_RLO, "CaneTip", Vector3.new(0.12, 0.12, 0.12), cylY(h.X + 0.02, h.Y - 2.1, -0.12), rgb(30, 28, 28), M.Rubber, "Cyl")
	elseif kind == "tablet" then
		-- (main GAUCHE : la droite tape dessus)
		local l = HAND_L
		add(ctx, G_LLO, "Tablet", Vector3.new(0.06, 0.62, 0.86), at(l.X + 0.1, l.Y + 0.1, -0.3) * CFrame.Angles(0, 0, math.rad(8)), rgb(40, 40, 46), M.SmoothPlastic)
		add(ctx, G_LLO, "TabletScreen", Vector3.new(0.05, 0.54, 0.76), at(l.X + 0.145, l.Y + 0.1, -0.3) * CFrame.Angles(0, 0, math.rad(8)), rgb(150, 210, 255), M.Glass)
	end
end

----------------------------------------------------------------------
-- Build
----------------------------------------------------------------------

function NPCModels.Build(style: string, opts: Opts?): Model
	local o: Opts = opts or {}
	if not table.find(NPCModels.Styles, style) then
		style = "pedestrian"
	end
	local seed = o.Seed or 1
	local model = Instance.new("Model")
	model.Name = o.Name or ("NPC_" .. style)
	local scale = o.Scale or 1
	local hs = 1.06 -- (tête un peu plus grande : "mignon-réaliste")
	if style == "kid" and o.Scale == nil then
		scale = 0.6 + hash(seed, 40) * 0.1
		hs = 1.28
	elseif o.Scale == nil then
		-- tailles variées : 0,94 à 1,05
		scale = 0.94 + hash(seed, 41) * 0.11
	end
	local ctx: Ctx = { Model = model, S = scale, HS = hs, Count = 0 }
	local look = baseLook(style, seed, o)
	local shirt, pants = look.Shirt, look.Pants
	local sleeve = shirt
	local longSleeve = look.LongSleeve
	local skirt = look.Skirt
	local shorts = false
	local cuff: Color3? = nil
	local propKind = o.Prop
	local extras: { () -> () } = {}

	if style == "cashier" then
		shirt = o.Shirt or pick({ rgb(40, 150, 150), rgb(214, 60, 90), rgb(60, 110, 200) }, seed, 50)
		sleeve, longSleeve, skirt = shirt, false, false
		pants = o.Pants or rgb(44, 48, 60)
		look.Collar = "polo"
		look.Belt = true
		table.insert(extras, function()
			-- badge + cordon + visière
			add(ctx, G_CHEST, "Badge", Vector3.new(0.26, 0.16, 0.03), at(0.27, 3.86, -0.3), WHITE, M.SmoothPlastic)
			add(ctx, G_CHEST, "BadgeStripe", Vector3.new(0.26, 0.04, 0.03), at(0.27, 3.92, -0.315), shirt, M.SmoothPlastic)
			add(ctx, G_HEAD, "Visor", Vector3.new(0.8, 0.12, 0.88), at(0, HY + 0.25, 0.02), shirt, M.SmoothPlastic, "Egg")
			add(ctx, G_HEAD, "VisorBrim", Vector3.new(0.56, 0.04, 0.34), at(0, HY + 0.24, -0.46) * CFrame.Angles(math.rad(10), 0, 0), shirt:Lerp(INK, 0.15), M.SmoothPlastic)
		end)
	elseif style == "baker" then
		shirt = WHITE
		sleeve, longSleeve, skirt = WHITE, true, false
		pants = o.Pants or rgb(58, 58, 68)
		cuff = rgb(228, 228, 224)
		look.Collar = "none"
		table.insert(extras, function()
			-- veste croisée (2 rangées de boutons), col officier, tablier, toque plissée
			add(ctx, G_CHEST, "Collar", Vector3.new(0.12, 0.42, 0.42), cylY(0, 4.34, 0.03), rgb(236, 236, 232), M.Fabric, "Cyl")
			for i = 0, 2 do
				for _, bx in ipairs({ -0.2, 0.2 }) do
					add(ctx, G_CHEST, "Button", Vector3.new(0.06, 0.06, 0.04), at(bx, 4.02 - i * 0.26, -0.3), rgb(200, 200, 196), M.SmoothPlastic, "Ball")
				end
			end
			add(ctx, G_CHEST, "Apron", Vector3.new(0.9, 0.62, 0.04), at(0, 3.08, -0.28), rgb(232, 188, 128), M.Fabric)
			add(ctx, G_PELVIS, "ApronSkirt", Vector3.new(1.0, 1.1, 0.04), at(0, 2.3, -0.3), rgb(232, 188, 128), M.Fabric)
			add(ctx, G_PELVIS, "ApronTie", Vector3.new(1.02, 0.07, 0.68), at(0, 2.86, 0), rgb(214, 170, 112), M.Fabric)
			add(ctx, G_HEAD, "Toque", Vector3.new(0.5, 0.74, 0.74), cylY(0, HY + 0.52, 0.03), WHITE, M.Fabric, "Cyl")
			add(ctx, G_HEAD, "ToquePuff", Vector3.new(0.92, 0.46, 0.92), at(0, HY + 0.82, 0.03), WHITE, M.Fabric, "Egg")
			add(ctx, G_HEAD, "ToqueBand", Vector3.new(0.14, 0.77, 0.77), cylY(0, HY + 0.33, 0.03), rgb(236, 236, 232), M.Fabric, "Cyl")
		end)
	elseif style == "salesperson" then
		local jacket = o.Shirt or pick({ rgb(36, 44, 70), rgb(40, 40, 44), rgb(90, 90, 100), rgb(64, 50, 44) }, seed, 51)
		shirt, sleeve, longSleeve, skirt = jacket, jacket, true, false
		pants = o.Pants or jacket
		cuff = WHITE
		look.Collar = "none"
		look.Belt = false
		propKind = propKind or "tablet"
		table.insert(extras, function()
			-- chemise en V + cravate + revers + pochette + boutons
			local tieC = pick({ rgb(180, 36, 56), rgb(220, 70, 130), rgb(50, 96, 180), rgb(30, 30, 34) }, seed, 52)
			add(ctx, G_CHEST, "ShirtFront", Vector3.new(0.3, 0.5, 0.04), at(0, 4.04, -0.285), WHITE, M.Fabric)
			add(ctx, G_CHEST, "Tie", Vector3.new(0.1, 0.52, 0.03), at(0, 3.98, -0.31), tieC, M.Fabric)
			add(ctx, G_CHEST, "TieKnot", Vector3.new(0.12, 0.09, 0.05), at(0, 4.25, -0.3), tieC:Lerp(INK, 0.2), M.Fabric)
			for _, sx in ipairs({ -1, 1 }) do
				add(ctx, G_CHEST, "Lapel", Vector3.new(0.12, 0.62, 0.04), at(sx * 0.19, 4.0, -0.305) * CFrame.Angles(0, 0, sx * 0.34), jacket:Lerp(INK, 0.25), M.Fabric)
				add(ctx, G_CHEST, "ShirtCollar", Vector3.new(0.14, 0.06, 0.2), at(sx * 0.1, 4.33, -0.15) * CFrame.Angles(math.rad(-22), sx * 0.4, sx * -0.3), WHITE, M.Fabric)
			end
			add(ctx, G_CHEST, "Pocket", Vector3.new(0.18, 0.08, 0.04), at(-0.33, 3.95, -0.285), WHITE, M.SmoothPlastic)
			add(ctx, G_CHEST, "JacketButton", Vector3.new(0.06, 0.06, 0.04), at(0, 3.3, -0.26), rgb(30, 30, 30), M.SmoothPlastic, "Ball")
		end)
		look.Shoe = rgb(36, 26, 24)
		look.Sole = rgb(26, 22, 22)
	elseif style == "shopper" then
		propKind = propKind or "bag"
	elseif style == "jogger" then
		shirt = o.Shirt or pick({ rgb(255, 120, 60), rgb(80, 200, 160), rgb(236, 72, 140), rgb(90, 150, 240) }, seed, 53)
		sleeve, longSleeve, skirt, shorts = shirt, false, false, true
		pants = o.Pants or rgb(38, 42, 52)
		look.Shoe = pick({ rgb(250, 250, 250), rgb(255, 90, 90), rgb(90, 200, 255) }, seed, 54)
		look.Sole = WHITE
		look.Belt = false
		look.Collar = "crew"
		table.insert(extras, function()
			add(ctx, G_HEAD, "Headband", Vector3.new(0.12, 0.74, 0.8), cylY(0, HY + 0.17, 0.03) * CFrame.Angles(0, 0, math.rad(-14)), WHITE, M.Fabric, "Cyl")
			add(ctx, G_LLO, "Watch", Vector3.new(0.1, 0.32, 0.32), cylY(-0.73, 2.7, 0.02), rgb(40, 40, 46), M.SmoothPlastic, "Cyl")
		end)
	elseif style == "elder" then
		shirt = o.Shirt or pick({ rgb(150, 120, 100), rgb(120, 130, 150), rgb(160, 90, 90), rgb(110, 130, 100), rgb(200, 190, 170) }, seed, 55)
		sleeve, longSleeve = shirt, true
		look.Collar = "v"
		propKind = propKind or (hash(seed, 56) < 0.5 and "cane" or nil)
		table.insert(extras, function()
			-- gilet boutonné (cardigan)
			add(ctx, G_CHEST, "Placket", Vector3.new(0.1, 1.05, 0.03), at(0, 3.55, -0.3), shirt:Lerp(INK, 0.12), M.Fabric)
			for i = 0, 3 do
				add(ctx, G_CHEST, "Button", Vector3.new(0.06, 0.06, 0.04), at(0, 3.95 - i * 0.28, -0.32), rgb(226, 216, 196), M.SmoothPlastic, "Ball")
			end
			if not look.Female and hash(seed, 58) < 0.5 then
				-- casquette plate
				local cap = pick({ rgb(90, 80, 70), rgb(70, 76, 90), rgb(120, 100, 76) }, seed, 59)
				add(ctx, G_HEAD, "FlatCap", Vector3.new(0.8, 0.26, 0.9), at(0, HY + 0.34, 0.0) * CFrame.Angles(math.rad(-8), 0, 0), cap, M.Fabric, "Egg")
				add(ctx, G_HEAD, "CapBrim", Vector3.new(0.6, 0.06, 0.3), at(0, HY + 0.29, -0.4) * CFrame.Angles(math.rad(12), 0, 0), cap:Lerp(INK, 0.1), M.Fabric)
			end
		end)
	elseif style == "worker" then
		shirt = o.Shirt or rgb(70, 90, 130)
		sleeve, longSleeve, skirt = shirt, true, false
		pants = o.Pants or rgb(58, 68, 90)
		look.Shoe = rgb(96, 70, 44)
		look.Sole = rgb(40, 34, 30)
		look.HairStyle = "none" -- (le casque couvre les cheveux)
		look.Collar = "crew"
		look.Belt = true
		table.insert(extras, function()
			local vest = rgb(255, 146, 36)
			add(ctx, G_CHEST, "Vest", Vector3.new(1.14, 1.14, 0.64), at(0, 3.59, 0), vest, M.Fabric)
			for _, y in ipairs({ 3.3, 3.62 }) do
				add(ctx, G_CHEST, "VestStripe", Vector3.new(1.2, 0.09, 0.7), at(0, y, 0), rgb(226, 230, 222), M.Glass)
			end
			add(ctx, G_HEAD, "Helmet", Vector3.new(0.84, 0.54, 0.9), at(0, HY + 0.26, 0.02), rgb(255, 206, 36), M.SmoothPlastic, "Egg")
			add(ctx, G_HEAD, "HelmetBrim", Vector3.new(0.05, 0.94, 1.02), cylY(0, HY + 0.1, 0.0), rgb(250, 200, 30), M.SmoothPlastic, "Cyl")
			add(ctx, G_HEAD, "HelmetRidge", Vector3.new(0.12, 0.08, 0.8), at(0, HY + 0.52, 0.02), rgb(240, 192, 30), M.SmoothPlastic, "Egg")
			add(ctx, G_PELVIS, "ToolPouch", Vector3.new(0.14, 0.4, 0.34), at(0.56, 2.64, 0.02), rgb(110, 76, 44), M.Leather)
		end)
	elseif style == "kid" then
		shorts = hash(seed, 58) < 0.5 and not skirt
		longSleeve = false
		look.Belt = false
		look.Beard = "none"
		look.Collar = "crew"
		table.insert(extras, function()
			if hash(seed, 59) < 0.55 then
				-- cartable
				local c = pick({ rgb(255, 120, 160), rgb(90, 160, 240), rgb(255, 200, 60), rgb(120, 200, 120) }, seed, 60)
				add(ctx, G_CHEST, "Backpack", Vector3.new(0.86, 0.96, 0.36), at(0, 3.6, 0.47), c, M.Fabric)
				add(ctx, G_CHEST, "BackpackPocket", Vector3.new(0.6, 0.4, 0.12), at(0, 3.32, 0.7), c:Lerp(WHITE, 0.3), M.Fabric)
				for _, sx in ipairs({ -1, 1 }) do
					add(ctx, G_CHEST, "Strap", Vector3.new(0.12, 0.9, 0.05), at(sx * 0.3, 3.8, -0.305), c:Lerp(INK, 0.2), M.Fabric)
				end
			end
		end)
	elseif style == "pedestrian" then
		if hash(seed, 61) < 0.35 then
			-- veste ouverte par-dessus le t-shirt (le buste prend la couleur de
			-- la veste ; le t-shirt se voit devant)
			local jacket = pick({ rgb(60, 70, 90), rgb(120, 80, 60), rgb(180, 160, 130), rgb(70, 110, 90), rgb(150, 40, 60), rgb(40, 40, 44) }, seed, 62)
			local tee = shirt
			shirt = jacket
			sleeve, longSleeve = jacket, true
			look.Collar = "none"
			table.insert(extras, function()
				add(ctx, G_CHEST, "Tee", Vector3.new(0.34, 1.26, 0.04), at(0, 3.62, -0.265), tee, M.Fabric)
				add(ctx, G_CHEST, "TeeCollar", Vector3.new(0.07, 0.4, 0.4), cylY(0, 4.36, 0.03), tee:Lerp(INK, 0.1), M.Fabric, "Cyl")
				for _, sx in ipairs({ -1, 1 }) do
					add(ctx, G_CHEST, "JacketLapel", Vector3.new(0.1, 0.56, 0.04), at(sx * 0.21, 3.98, -0.285) * CFrame.Angles(0, 0, sx * 0.28), jacket:Lerp(INK, 0.18), M.Fabric)
					add(ctx, G_CHEST, "JacketEdge", Vector3.new(0.05, 0.8, 0.04), at(sx * 0.19, 3.25, -0.265), jacket:Lerp(INK, 0.12), M.Fabric)
					add(ctx, G_CHEST, "JacketPocket", Vector3.new(0.2, 0.04, 0.04), at(sx * 0.36, 3.12, -0.255), jacket:Lerp(INK, 0.22), M.Fabric)
				end
			end)
		elseif look.Female and hash(seed, 63) < 0.4 then
			-- écharpe
			local sc = pick({ rgb(200, 60, 80), rgb(236, 200, 120), rgb(120, 160, 210) }, seed, 64)
			table.insert(extras, function()
				add(ctx, G_CHEST, "Scarf", Vector3.new(0.16, 0.5, 0.5), cylY(0, 4.34, 0.03), sc, M.Fabric, "Cyl")
				add(ctx, G_CHEST, "ScarfEnd", Vector3.new(0.16, 0.56, 0.05), at(0.14, 3.98, -0.31), sc:Lerp(INK, 0.1), M.Fabric)
			end)
		end
	end
	if propKind == "none" then
		propKind = nil
	end

	torso(ctx, look, shirt, pants, skirt, style, seed)
	head(ctx, look, seed)
	arm(ctx, -1, sleeve, look.Skin, longSleeve, cuff)
	arm(ctx, 1, sleeve, look.Skin, longSleeve, cuff)
	legs(ctx, look, pants, shorts, skirt)
	for _, fn in ipairs(extras) do
		fn()
	end
	if propKind then
		prop(ctx, propKind, seed)
		model:SetAttribute("NpcProp", propKind)
	end
	-- pivot au sol (pièce racine invisible entre les pieds)
	local root = Instance.new("Part")
	root.Name = "NpcRoot"
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.CastShadow = false
	root.Transparency = 1
	root.Size = Vector3.new(0.2, 0.2, 0.2)
	root.CFrame = CFrame.new()
	root.Parent = model
	model.PrimaryPart = root
	model:SetAttribute("NpcStyle", style)
	model:SetAttribute("NpcScale", scale)
	model:SetAttribute("NpcHeadScale", hs)
	model:SetAttribute("NpcSeed", seed)
	if o.SitHeight then
		model:SetAttribute("NpcSitHeight", o.SitHeight)
	end
	if o.Look == false then
		model:SetAttribute("NpcNoLook", true)
	end
	model:SetAttribute("PartCount", ctx.Count + 1)
	if o.Solid ~= false then
		NPCModels.SetSolid(model, true)
	end
	return model
end

----------------------------------------------------------------------
-- Collision (capsule invisible)
----------------------------------------------------------------------

local COL_RADIUS = 0.78 -- (studs, échelle 1)
local COL_HEIGHT = 5.0

-- Repos de la capsule : debout (cylindre vertical) ou assis (boîte)
local function colliderRest(s: number, sitting: boolean, seatTop: number?): (Vector3, CFrame)
	if sitting then
		local top = seatTop or NPCModels.SitHeight
		local y0 = math.max(0.3, top - 1.2 * s)
		local y1 = top + 2.95 * s
		-- (buste au-dessus du siège + jambes vers l'avant)
		return Vector3.new(1.3 * s, y1 - y0, 1.9 * s), CFrame.new(0, (y0 + y1) / 2, -0.45 * s)
	end
	return Vector3.new(COL_HEIGHT * s, 2 * COL_RADIUS * s, 2 * COL_RADIUS * s), CFrame.new(0, 0.2 * s + COL_HEIGHT * s / 2, 0) * UPRIGHT
end

local rigs: { [Model]: any } = setmetatable({}, { __mode = "k" }) :: any

function NPCModels.SetSolid(model: Model, on: boolean)
	local old = model:FindFirstChild("NpcCollider")
	if not on then
		if old then
			old:Destroy()
		end
		model:SetAttribute("NpcSolid", false)
		rigs[model] = nil
		return
	end
	if old then
		return
	end
	local s = tonumber(model:GetAttribute("NpcScale")) or 1
	local size, rest = colliderRest(s, false, nil)
	local root = model.PrimaryPart
	local base = root and root.CFrame or CFrame.new()
	local c = Instance.new("Part")
	c.Name = "NpcCollider"
	c.Shape = Enum.PartType.Cylinder
	c.Anchored = true
	c.CanCollide = true
	c.CanTouch = false
	c.CastShadow = false
	c.Transparency = 1
	c.Size = size
	c.CFrame = base * rest
	c.Material = M.SmoothPlastic
	c:SetAttribute("NpcG", G_COL)
	c:SetAttribute("NpcRest", rest)
	c.Parent = model
	model:SetAttribute("NpcSolid", true)
	rigs[model] = nil
end

function NPCModels.SetSitHeight(model: Model, h: number)
	model:SetAttribute("NpcSitHeight", h)
end

-- h (nombre) : le PNJ est ASSIS sur un siège dont le dessus est à h ; nil : debout
function NPCModels.SetSeated(model: Model, h: number?)
	if h then
		model:SetAttribute("NpcSitHeight", h)
		model:SetAttribute("NpcSeated", true)
	else
		model:SetAttribute("NpcSeated", nil)
	end
end

----------------------------------------------------------------------
-- Animation procédurale (client)
----------------------------------------------------------------------

type Rig = {
	Root: BasePart,
	Parts: { BasePart },
	Rests: { CFrame },
	Groups: { number },
	Frames: { CFrame },
	S: number,
	HS: number,
	Prop: string?,
	Seed: number,
	Collider: BasePart?,
	ColIndex: number,
	ColSitting: boolean,
	ColSolid: boolean,
	LookYaw: number,
	LookPitch: number,
	LookW: number,
	Clock: number,
	NoLook: boolean,
	SitTop: number?,
	Anim: string?,
	From: any?, -- (pose au changement d'anim : fondu)
	FadeAt: number,
	Last: any?,
}

local function rigOf(model: Model): Rig?
	local rig = rigs[model]
	if rig and rig.Root.Parent == model then
		return rig
	end
	local root = model.PrimaryPart or model:FindFirstChild("NpcRoot")
	if not root or not root:IsA("BasePart") then
		return nil
	end
	local p = model:GetAttribute("NpcProp")
	local r: Rig = {
		Root = root,
		Parts = {},
		Rests = {},
		Groups = {},
		Frames = {},
		S = tonumber(model:GetAttribute("NpcScale")) or 1,
		HS = tonumber(model:GetAttribute("NpcHeadScale")) or 1,
		Prop = type(p) == "string" and p or nil,
		Seed = tonumber(model:GetAttribute("NpcSeed")) or 1,
		Collider = nil,
		ColIndex = 0,
		ColSitting = false,
		ColSolid = true,
		LookYaw = 0,
		LookPitch = 0,
		LookW = 0,
		Clock = os.clock(),
		NoLook = model:GetAttribute("NpcNoLook") == true,
		SitTop = nil,
		Anim = nil,
		From = nil,
		FadeAt = 0,
		Last = nil,
	}
	for _, d in ipairs(model:GetChildren()) do
		if d:IsA("BasePart") then
			local g = d:GetAttribute("NpcG")
			local rest = d:GetAttribute("NpcRest")
			if type(g) == "number" and typeof(rest) == "CFrame" then
				table.insert(r.Parts, d)
				table.insert(r.Rests, rest)
				table.insert(r.Groups, g)
				table.insert(r.Frames, rest)
				if g == G_COL then
					r.Collider = d
					r.ColIndex = #r.Parts
				end
			end
		end
	end
	rigs[model] = r
	return r
end

-- rotation `rot` autour du point `p` (repère du pivot, échelle appliquée)
local function about(p: Vector3, rot: CFrame): CFrame
	return CFrame.new(p) * rot * CFrame.new(-p)
end

local ANG = CFrame.Angles
local T: { CFrame } = table.create(NGROUPS, CFrame.new())
local sin, cos, max, min, abs = math.sin, math.cos, math.max, math.min, math.abs

-- Pose. Conventions (toutes en radians) :
--   membres : x > 0 = vers l'AVANT (bras levé devant, cuisse levée) ;
--   Knee / Elbow : flexion (> 0 : le tibia part vers l'arrière, l'avant-bras vers l'avant) ;
--   Foot : > 0 = pointe vers le HAUT ;
--   Lean > 0 = buste penché EN AVANT ; HeadPitch > 0 = regarde en BAS ;
--   Yaw > 0 = tourne vers la GAUCHE du personnage (-X local).
type Pose = {
	Bob: number,
	SwayX: number,
	PelvisYaw: number,
	PelvisRoll: number,
	Lean: number,
	Twist: number,
	Side: number,
	HeadYaw: number,
	HeadPitch: number,
	HeadRoll: number,
	LUp: CFrame,
	LLo: number,
	RUp: CFrame,
	RLo: number,
	LLoRot: CFrame?,
	RLoRot: CFrame?,
	LTh: number,
	LThRoll: number,
	LKnee: number,
	LFoot: number,
	RTh: number,
	RThRoll: number,
	RKnee: number,
	RFoot: number,
	Sit: boolean,
	Blink: number,
	LookW: number, -- (0..1) poids du regard vers le joueur
}

local function newPose(): Pose
	return {
		Bob = 0,
		SwayX = 0,
		PelvisYaw = 0,
		PelvisRoll = 0,
		Lean = 0,
		Twist = 0,
		Side = 0,
		HeadYaw = 0,
		HeadPitch = 0,
		HeadRoll = 0,
		LUp = CFrame.identity,
		LLo = 0.12,
		RUp = CFrame.identity,
		RLo = 0.12,
		LTh = 0,
		LThRoll = 0,
		LKnee = 0,
		LFoot = 0,
		RTh = 0,
		RThRoll = 0,
		RKnee = 0,
		RFoot = 0,
		Sit = false,
		Blink = 0,
		LookW = 1,
	}
end

local function smoothPulse(x: number): number
	-- 0 -> 1 -> 0 sur [0, 1] (cloche douce)
	if x <= 0 or x >= 1 then
		return 0
	end
	return sin(x * math.pi) ^ 2
end

-- Jambes assises : cuisses à l'horizontale (ou genoux qui remontent sur un
-- siège bas), tibias verticaux, pieds à plat ; siège haut : pieds qui pendent
local function sitLegs(P: Pose, t: number, seatTop: number, s: number)
	local yh = seatTop + HIP_OVER_SEAT * s
	local c = math.clamp((yh - KNEE_Y * s) / (THIGH_LEN * s), -0.55, 0.3)
	local th = math.acos(c) -- angle de la cuisse (0 = pendante, pi/2 = horizontale)
	local dangle = (yh - KNEE_Y * s) / (THIGH_LEN * s) > 0.3
	local swing = dangle and sin(t * 1.6) * 0.18 or 0
	P.LTh, P.RTh = th + 0.02, th - 0.02
	P.LThRoll, P.RThRoll = 0.06, -0.06
	-- tibias verticaux (ou qui se balancent)
	P.LKnee = th + 0.02 - 0.05 + swing
	P.RKnee = th - 0.02 - 0.05 - swing
	-- pieds à plat
	P.LFoot = -((th + 0.02) - P.LKnee)
	P.RFoot = -((th - 0.02) - P.RKnee)
	-- petit mouvement de pied de temps en temps
	P.RFoot += max(0, sin(t * 0.7)) ^ 8 * 0.35
	P.Sit = true
end

-- Point le plus bas d'une jambe sous la hanche (échelle 1) : cuisse (1,1),
-- tibia (1,16), pied (cheville à 0,34 du sol ; talon 0,24 derrière, pointe
-- 0,66 devant)
local HIP_Y = 2.6
local function legLow(th: number, knee: number, foot: number): number
	local phi = th - knee + foot
	local c, s2 = cos(phi), sin(phi)
	local heel = -0.34 * c - 0.24 * s2
	local toe = -0.34 * c + 0.66 * s2
	return -(1.1 * cos(th) + 1.16 * cos(th - knee)) + min(heel, toe)
end
local function groundBob(lth: number, lk: number, lf: number, rth: number, rk: number, rf: number): number
	return -min(legLow(lth, lk, lf), legLow(rth, rk, rf)) - HIP_Y
end

local function pose(anim: string, t: number, propKind: string?, seed: number, seated: boolean, seatTop: number, s: number): Pose
	local P = newPose()
	local breathe = sin(t * 1.55) -- (~15 respirations / min)
	-- clignement : toutes les 2,8 à 5 s, 0,14 s
	local period = 2.8 + (seed % 7) * 0.31
	P.Blink = smoothPulse(((t + seed * 0.37) % period) / 0.14)
	-- transfert du poids (repos) : lent, propre à chacun
	local shift = sin(t * 0.42 + seed)
	if anim == "walk" or anim == "push" then
		local w = t * math.pi * 2 * 0.95 -- (0,95 cycle / s à t normal : ~1,9 pas / s)
		local sl, sr = sin(w), sin(w + math.pi)
		local cl, cr = cos(w), cos(w + math.pi)
		local amp = anim == "push" and 0.34 or 0.42
		-- cuisses : avant / arrière
		P.LTh = sl * amp + 0.04
		P.RTh = sr * amp + 0.04
		-- genoux : grande flexion pendant l'oscillation (jambe qui revient),
		-- petite flexion à l'attaque du talon (amorti)
		P.LKnee = max(0, cl) ^ 1.6 * 1.05 + max(0, sin(w - 2.2)) * 0.16 + 0.05
		P.RKnee = max(0, cr) ^ 1.6 * 1.05 + max(0, sin(w + math.pi - 2.2)) * 0.16 + 0.05
		-- pieds : pointe relevée à l'attaque, poussée sur les orteils au départ
		P.LFoot = -0.15 * max(0, sl) + 0.14 * max(0, -cl) + 0.3 * max(0, cl)
		P.RFoot = -0.15 * max(0, sr) + 0.14 * max(0, -cr) + 0.3 * max(0, cr)
		-- bassin : rebond (2 par cycle), balancement latéral vers la jambe d'appui,
		-- rotation avec la jambe avant, léger roulis
		P.SwayX = cl * 0.045
		P.PelvisYaw = -sl * 0.1
		P.PelvisRoll = -cl * 0.045
		-- buste en contre-rotation, tête stable
		P.Twist = sl * 0.08
		P.Lean = anim == "push" and 0.2 or 0.05
		P.HeadYaw = -sl * 0.02
		P.HeadPitch = -0.03
		if anim == "push" then
			-- mains sur la poignée du chariot
			P.LUp = ANG(0.95, 0, 0.1)
			P.RUp = ANG(0.95, 0, -0.1)
			P.LLo, P.RLo = 0.6, 0.6
			P.LookW = 0.5
		else
			-- bras en opposition des jambes, coude qui plie en avant
			P.LUp = ANG(-sl * 0.4, 0, -0.07)
			P.RUp = ANG(-sr * 0.4, 0, 0.07)
			P.LLo = 0.22 + max(0, -sl) * 0.35
			P.RLo = 0.22 + max(0, -sr) * 0.35
		end
	else
		-- debout (ou assis) : respiration, poids d'une jambe sur l'autre
		P.Bob = breathe * 0.008
		P.SwayX = shift * 0.035
		P.PelvisRoll = shift * 0.035
		P.Side = -shift * 0.03
		local relaxL = max(0, -shift) -- (la jambe qui ne porte pas se plie un peu)
		local relaxR = max(0, shift)
		P.LKnee = relaxL * 0.18
		P.RKnee = relaxR * 0.18
		P.LTh = relaxL * 0.09
		P.RTh = relaxR * 0.09
		P.LFoot = -relaxL * 0.05
		P.RFoot = -relaxR * 0.05
		P.LThRoll = -shift * 0.03
		P.RThRoll = -shift * 0.03
		P.LUp = ANG(0.02 - breathe * 0.01, 0, -0.07)
		P.RUp = ANG(0.02 - breathe * 0.01, 0, 0.07)
		P.LLo, P.RLo = 0.14, 0.14
		P.HeadYaw = sin(t * 0.29 + seed) * 0.3 + sin(t * 0.83) * 0.08
		P.HeadPitch = sin(t * 0.41) * 0.05
		P.HeadRoll = sin(t * 0.23) * 0.03

		if anim == "sit" then
			P.Lean = -0.06
			-- mains posées sur les cuisses
			P.LUp = ANG(0.2, 0, 0.12)
			P.RUp = ANG(0.2, 0, -0.12)
			P.LLo, P.RLo = 0.72, 0.72
			P.HeadYaw = sin(t * 0.31 + seed) * 0.4
		elseif anim == "wave" then
			P.RUp = ANG(0.25, 0, 2.5)
			P.RLo = 0.4
			P.RLoRot = ANG(0, 0, sin(t * 7) * 0.45)
			P.HeadPitch = -0.06
			P.HeadYaw = 0.1
			P.HeadRoll = 0.08
		elseif anim == "scan" then
			-- caisse : les mains passent les articles devant le scanner (droite -> gauche)
			local cyc = (t * 0.8) % 1
			local sweep = sin(cyc * math.pi * 2)
			local lift = max(0, sin(cyc * math.pi * 2 + 1)) * 0.12
			P.Lean = 0.12
			P.Twist = -sweep * 0.14
			P.LUp = ANG(0.6 + lift, -sweep * 0.2, -0.05)
			P.RUp = ANG(0.7 + lift, -sweep * 0.3, 0.05)
			P.LLo, P.RLo = 1.1, 1.05
			P.HeadPitch = 0.32
			P.HeadYaw = -sweep * 0.18
			P.LookW = 0.45
		elseif anim == "type" then
			P.LUp = ANG(0.4, 0, 0.12)
			P.LLo = 1.25
			P.RUp = ANG(0.5, 0.2, -0.05)
			P.RLo = 1.1 + sin(t * 9) * 0.08
			P.RLoRot = ANG(0, 0, sin(t * 11) * 0.06)
			P.HeadPitch = 0.34
			P.Lean = 0.05
			P.LookW = 0.4
		elseif anim == "talk" then
			local g = sin(t * 2.2)
			P.HeadPitch = sin(t * 3.1) * 0.07
			P.HeadYaw = sin(t * 0.6) * 0.2
			P.HeadRoll = sin(t * 1.3) * 0.05
			P.RUp = ANG(0.35 + g * 0.12, 0.1, 0.1)
			P.RLo = 0.95 + sin(t * 3.3) * 0.25
			P.RLoRot = ANG(0, sin(t * 2.7) * 0.3, 0)
			P.LUp = ANG(0.08 + max(0, sin(t * 1.1)) * 0.3, 0, -0.08)
			P.LLo = 0.25 + max(0, sin(t * 1.1)) * 0.7
			P.Twist = g * 0.05
		elseif anim == "clap" then
			local c = abs(sin(t * 6))
			P.LUp = ANG(0.8, 0, 0.3 - c * 0.22)
			P.RUp = ANG(0.8, 0, -0.3 + c * 0.22)
			P.LLo, P.RLo = 1.2, 1.2
			P.HeadPitch = -0.08
			P.Bob += c * 0.01
		elseif anim == "cheer" then
			local c = sin(t * 5)
			P.LUp = ANG(0.2, 0, -2.5 - c * 0.15)
			P.RUp = ANG(0.2, 0, 2.5 + c * 0.15)
			P.LLo, P.RLo = 0.3, 0.3
			P.HeadPitch = -0.15
			P.Bob += max(0, c) * 0.06
		end
	end
	-- debout : le bassin se place pour que le pied le plus bas touche le sol
	-- (talon ou pointe selon l'inclinaison du pied) : aucun pied qui flotte
	-- ni qui s'enfonce, rebond naturel de la marche
	if anim ~= "sit" and not seated then
		P.Bob += groundBob(P.LTh, P.LKnee, P.LFoot, P.RTh, P.RKnee, P.RFoot)
	end
	-- assis (anim "sit" ou PNJ assis qui fait autre chose)
	if anim == "sit" or seated then
		P.Bob, P.SwayX, P.PelvisRoll, P.PelvisYaw = breathe * 0.006, 0, 0, 0
		P.Side = 0
		sitLegs(P, t + seed, seatTop, s)
	end
	-- objets tenus : le téléphone se regarde, le café se porte
	local handsBusy = (anim == "wave" or anim == "push" or anim == "scan" or anim == "clap" or anim == "cheer")
	local typing = (anim == "type")
	local casual = (anim == "walk" or anim == "idle" or anim == "sit")
	if propKind == "phone" and not handsBusy then
		P.RUp = ANG(0.42, 0.25, 0.1)
		P.RLo = 1.45
		P.RLoRot = ANG(0, 0.5, 0)
		P.HeadPitch = 0.42
		P.HeadYaw = 0.12
		P.LookW = 0.35
	elseif propKind == "coffee" and not handsBusy then
		P.RUp = ANG(0.25, 0, 0.08)
		P.RLo = 1.25
	elseif propKind == "tablet" and not typing then
		P.LUp = ANG(0.35, 0, 0.1)
		P.LLo = 1.25
	elseif propKind == "bag" and casual and not P.Sit then
		P.RUp = ANG(0.02, 0, 0.14)
		P.RLo = 0.08
	elseif propKind == "cane" and not handsBusy and not P.Sit then
		P.RUp = ANG(0.18, 0, 0.1)
		P.RLo = 0.35
	end
	return P
end

-- Fondu entre deux poses (changement d'anim : marche -> arrêt, etc.)
local FADE = 0.35
local function lerpPose(a: any, b: any, k: number): any
	local out = {}
	for key, vb in pairs(b) do
		local va = a[key]
		if type(vb) == "number" and type(va) == "number" then
			out[key] = va + (vb - va) * k
		elseif typeof(vb) == "CFrame" then
			out[key] = (typeof(va) == "CFrame" and va or CFrame.identity):Lerp(vb, k)
		else
			out[key] = vb
		end
	end
	for key, va in pairs(a) do
		if b[key] == nil and typeof(va) == "CFrame" then
			out[key] = va:Lerp(CFrame.identity, k)
		end
	end
	return out
end

-- Déplace un PNJ (pièce racine seulement ; Animate repose les autres)
function NPCModels.Place(model: Model, cf: CFrame)
	local root = model.PrimaryPart
	if root then
		root.CFrame = cf
	else
		model:PivotTo(cf)
	end
end

----------------------------------------------------------------------
-- Joueur local (regard + anti-piège de la capsule), mis en cache
----------------------------------------------------------------------

local focusAt = -1
local focusHead: Vector3? = nil
local focusRoot: Vector3? = nil
local function localFocus(): (Vector3?, Vector3?)
	local now = os.clock()
	if now - focusAt < 0.05 then
		return focusHead, focusRoot
	end
	focusAt = now
	focusHead, focusRoot = nil, nil
	local ok = pcall(function()
		local Players = game:GetService("Players")
		local player = Players.LocalPlayer
		local character = player and player.Character
		if character then
			local hrp = character:FindFirstChild("HumanoidRootPart")
			local headPart = character:FindFirstChild("Head")
			if hrp and hrp:IsA("BasePart") then
				focusRoot = hrp.Position
				focusHead = (headPart and headPart:IsA("BasePart")) and headPart.Position or hrp.Position + Vector3.new(0, 1.5, 0)
			end
		end
	end)
	if not ok then
		focusHead, focusRoot = nil, nil
	end
	return focusHead, focusRoot
end

-- Dessus du siège sous le PNJ assis : attribut, sinon rayon vers le bas (une fois)
local function seatTopOf(model: Model, rig: Rig): number
	local attr = tonumber(model:GetAttribute("NpcSitHeight"))
	if attr then
		return attr
	end
	if rig.SitTop then
		return rig.SitTop
	end
	local top = NPCModels.SitHeight
	pcall(function()
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { model }
		local pivot = rig.Root.CFrame
		local from = (pivot * CFrame.new(0, 3.2 * rig.S, 0.1 * rig.S)).Position
		local hit = workspace:Raycast(from, pivot.UpVector * -3.1 * rig.S, params)
		if hit then
			local h = pivot:PointToObjectSpace(hit.Position).Y
			if h > 0.6 * rig.S and h < 3.2 * rig.S then
				top = h
				return
			end
		end
		-- (sièges décoratifs sans CanQuery : on cherche, une seule fois, la pièce
		-- voisine sous le bassin dont le dessus est à hauteur d'assise)
		local parent = model.Parent
		if not parent then
			return
		end
		local hip = pivot * CFrame.new(0, 0, 0.1 * rig.S)
		local best = -1
		for _, d in ipairs(parent:GetDescendants()) do
			if d:IsA("BasePart") and not d:IsDescendantOf(model) then
				local rel = d.CFrame:PointToObjectSpace(hip.Position)
				local half = d.Size / 2
				if math.abs(rel.X) <= half.X and math.abs(rel.Z) <= half.Z then
					local topW = (d.CFrame * CFrame.new(0, half.Y, 0)).Position
					local h = pivot:PointToObjectSpace(topW).Y
					if h > 0.6 * rig.S and h < 2.8 * rig.S and h > best and d.CFrame.UpVector.Y > 0.9 then
						best = h
					end
				end
			end
		end
		if best > 0 then
			top = best
		end
	end)
	rig.SitTop = top
	return top
end

function NPCModels.Animate(model: Model, anim: string, t: number, look: Vector3?)
	local rig = rigOf(model)
	if not rig then
		return
	end
	-- (v10, PHYS10) réaction à une voiture : saut de côté / bousculade (décalage du corps entier)
	local react: CFrame? = nil
	local reactSolid = true
	if model:GetAttribute("NpcReactT") ~= nil then
		local okR, IR = pcall(require, script.Parent:FindFirstChild("ImpactRules") :: any)
		if okR and type(IR) == "table" then
			local okN, off, solidR, animR = pcall(IR.NpcReact, model, rig.Root.CFrame, os.clock())
			if okN and off then
				react = off
				reactSolid = solidR ~= false
				anim = animR or anim
			end
		end
	end
	local s = rig.S
	local seated = model:GetAttribute("NpcSeated") == true
	local sitting = anim == "sit" or seated
	local seatTop = sitting and seatTopOf(model, rig) or NPCModels.SitHeight
	local P = pose(anim, t, rig.Prop, rig.Seed, seated, seatTop, s)
	local pivot = if react then rig.Root.CFrame * react else rig.Root.CFrame
	local clock = os.clock()
	local dt = math.clamp(clock - rig.Clock, 0, 0.25)
	rig.Clock = clock
	-- fondu doux quand l'anim change (pas de saut de pose)
	if rig.Anim ~= anim then
		if rig.Anim ~= nil and rig.Last then
			rig.From = rig.Last
			rig.FadeAt = clock
		end
		rig.Anim = anim
	end
	if rig.From then
		local k = (clock - rig.FadeAt) / FADE
		if k >= 1 then
			rig.From = nil
		else
			k = k * k * (3 - 2 * k)
			P = lerpPose(rig.From, P, k) :: Pose
		end
	end
	rig.Last = P

	-- regard : vers `look`, sinon vers l'avatar local proche (≤ 14 studs, devant)
	local wantYaw, wantPitch, wantW = 0, 0, 0
	local headPos, rootPos = localFocus()
	local target = look
	if not target and not rig.NoLook and headPos then
		target = headPos
	end
	if target and P.LookW > 0 then
		local neckW = pivot * (J.Neck * s + Vector3.new(0, sitting and (seatTop + HIP_OVER_SEAT * s - J.HipL.Y * s) or 0, 0))
		local rel = pivot:VectorToObjectSpace(target - neckW)
		local flat = Vector3.new(rel.X, 0, rel.Z).Magnitude
		if flat < 14 * max(s, 0.8) and flat > 0.5 then
			local yaw = math.atan2(-rel.X, -rel.Z)
			if abs(yaw) < 2.0 then
				wantYaw = math.clamp(yaw, -1.2, 1.2)
				wantPitch = math.clamp(-math.atan2(rel.Y, flat), -0.45, 0.5)
				-- (poids : plein à moins de 9 studs, s'efface jusqu'à 14)
				wantW = math.clamp((14 * s - flat) / (5 * s), 0, 1) * P.LookW
			end
		end
	end
	local k = min(1, dt * 3.2) -- (lissage : ~0,3 s)
	rig.LookYaw += (wantYaw - rig.LookYaw) * k
	rig.LookPitch += (wantPitch - rig.LookPitch) * k
	rig.LookW += (wantW - rig.LookW) * k
	local lw = rig.LookW
	local headYaw = P.HeadYaw * (1 - lw) + rig.LookYaw * lw
	local headPitch = P.HeadPitch * (1 - lw) + rig.LookPitch * lw
	-- (au-delà de ~0,8 rad, le buste suit un peu)
	local chestFollow = math.clamp(rig.LookYaw - 0.8 * math.sign(rig.LookYaw), -0.35, 0.35)
	if abs(rig.LookYaw) < 0.8 then
		chestFollow = 0
	end
	local twist = P.Twist + chestFollow * lw
	headYaw -= chestFollow * lw

	-- assis : le bassin descend sur le siège (articulation de la hanche au-dessus)
	local drop = 0
	if sitting then
		drop = (seatTop + HIP_OVER_SEAT * s) - J.HipL.Y * s
	end
	local body = CFrame.new(P.SwayX * s, P.Bob * s + drop, 0)
	local pel = body * about(J.Pelvis * s, ANG(0, P.PelvisYaw, P.PelvisRoll))
	T[G_PELVIS] = pel
	local chest = pel * about(J.Waist * s, ANG(-P.Lean, twist - P.PelvisYaw * 0.4, P.Side - P.PelvisRoll * 0.6))
	T[G_CHEST] = chest
	local hd = chest * about(J.Neck * s, ANG(-headPitch, headYaw, P.HeadRoll))
	T[G_HEAD] = hd
	T[G_LID] = hd * CFrame.new(0, 0, -P.Blink * 0.06 * s * rig.HS)
	local lu = chest * about(J.ShoulderL * s, P.LUp)
	T[G_LUP] = lu
	T[G_LLO] = lu * about(J.ElbowL * s, ANG(P.LLo, 0, 0) * (P.LLoRot or CFrame.identity))
	local ru = chest * about(J.ShoulderR * s, P.RUp)
	T[G_RUP] = ru
	T[G_RLO] = ru * about(J.ElbowR * s, ANG(P.RLo, 0, 0) * (P.RLoRot or CFrame.identity))
	local lt = pel * about(J.HipL * s, ANG(P.LTh, 0, P.LThRoll))
	T[G_LTH] = lt
	local ls = lt * about(J.KneeL * s, ANG(-P.LKnee, 0, 0))
	T[G_LSH] = ls
	T[G_LFT] = ls * about(J.AnkleL * s, ANG(P.LFoot, 0, 0))
	local rt = pel * about(J.HipR * s, ANG(P.RTh, 0, P.RThRoll))
	T[G_RTH] = rt
	local rs = rt * about(J.KneeR * s, ANG(-P.RKnee, 0, 0))
	T[G_RSH] = rs
	T[G_RFT] = rs * about(J.AnkleR * s, ANG(P.RFoot, 0, 0))
	T[G_COL] = CFrame.identity

	-- capsule : forme (debout / assis) + anti-piège (avatar local dedans)
	local col = rig.Collider
	if col and rig.ColIndex > 0 then
		if rig.ColSitting ~= sitting then
			rig.ColSitting = sitting
			local size, rest = colliderRest(s, sitting, seatTop)
			col.Shape = sitting and Enum.PartType.Block or Enum.PartType.Cylinder
			col.Size = size
			rig.Rests[rig.ColIndex] = rest
		end
		if rootPos then
			local rel = pivot:PointToObjectSpace(rootPos)
			local inside
			if sitting then
				local size = col.Size
				local c = rig.Rests[rig.ColIndex].Position
				inside = abs(rel.X - c.X) < size.X / 2 + 0.3 and abs(rel.Z - c.Z) < size.Z / 2 + 0.3 and rel.Y > -1 and rel.Y < size.Y + 3
			else
				local d = Vector3.new(rel.X, 0, rel.Z).Magnitude
				local r = COL_RADIUS * s
				-- (hystérésis : on redevient solide une fois bien sorti)
				inside = d < r + (rig.ColSolid and 0.35 or 1.1) and rel.Y > -3 and rel.Y < COL_HEIGHT * s + 3
			end
			local solid = not inside and reactSolid
			if solid ~= rig.ColSolid then
				rig.ColSolid = solid
				col.CanCollide = solid
			end
		end
	end

	local frames = rig.Frames
	local groups = rig.Groups
	local rests = rig.Rests
	for i = 1, #rig.Parts do
		frames[i] = pivot * T[groups[i]] * rests[i]
	end
	workspace:BulkMoveTo(rig.Parts, frames, Enum.BulkMoveMode.FireCFrameChanged)
end

-- (tests / rendus) pièces d'un modèle
function NPCModels.PartCount(model: Model): number
	local n = 0
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			n += 1
		end
	end
	return n
end

return NPCModels
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="343">
        <Properties>
          <string name="Name">NPCSeats</string>
          <string name="Source"><![CDATA[--[[
	NPCSeats (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > NPCSeats

	v9.9 (NPC99) 🪑 Places des bancs de la ville occupées par des PNJ.
	Le MÊME calcul (entier, déterministe) sert :
	  - au client (TownPeople) pour asseoir les passants sur les places ;
	  - au serveur (NPCSeatGuard) pour qu'un joueur qui s'assoit sur ce banc
	    soit placé sur la place LIBRE, à côté du PNJ (jamais "dedans"), et
	    pour désactiver un banc déjà plein.

	Un banc (TownKit.Bench, 5,4 de long) = 2 places, à x = ±1,3 (repère du
	banc : avant = -Z, dossier = +Z). Le pivot d'un PNJ assis est au sol,
	sous le bassin, à z = SLOT_Z.

	API :
	  NPCSeats.BENCH_SLOTS = { -1.3, 1.3 }
	  NPCSeats.SLOT_Z = 0.3
	  NPCSeats.BenchPlan(seed) -> { Occupied = {bool, bool}, Mask = "10",
	      Npcs = { { Slot, Style, Seed, Prop } } }
	  NPCSeats.FreeSlots(seed) -> { number } (indices des places libres)
]]

local NPCSeats = {}

NPCSeats.BENCH_SLOTS = { -1.3, 1.3 }
NPCSeats.SLOT_Z = 0.3

local SIT_STYLES = { "elder", "pedestrian", "shopper", "pedestrian", "elder" }
local PROPS = { "none", "phone", "coffee", "none" }

-- (même hachage entier que NPCModels : identique sur tous les processeurs)
local MODP = 2147483647
local function hash(a: number, b: number): number
	local x = (math.floor(a) * 7919 + math.floor(b) * 104729 + 12345) % MODP
	x = (x * 48271) % MODP
	x = (x * 48271) % MODP
	x = (x * 48271) % MODP
	return x / MODP
end
NPCSeats.Hash = hash

export type Plan = {
	Occupied: { boolean },
	Mask: string,
	Npcs: { { Slot: number, Style: string, Seed: number, Prop: string } },
}

function NPCSeats.BenchPlan(seed: number): Plan
	local occupied = { false, false }
	local npcs = {}
	-- un banc sur deux environ a quelqu'un ; parfois deux (un couple qui discute)
	if hash(seed, 21) < 0.5 then
		local first = hash(seed, 22) < 0.5 and 1 or 2
		occupied[first] = true
		table.insert(npcs, {
			Slot = first,
			Style = SIT_STYLES[math.floor(hash(seed, 23) * #SIT_STYLES) + 1],
			Seed = seed * 7 + 3,
			Prop = PROPS[math.floor(hash(seed, 25) * #PROPS) + 1],
		})
		if hash(seed, 24) < 0.22 then
			local other = 3 - first
			occupied[other] = true
			table.insert(npcs, {
				Slot = other,
				Style = SIT_STYLES[math.floor(hash(seed, 26) * #SIT_STYLES) + 1],
				Seed = seed * 7 + 4,
				Prop = "none",
			})
		end
	end
	return {
		Occupied = occupied,
		Mask = (occupied[1] and "1" or "0") .. (occupied[2] and "1" or "0"),
		Npcs = npcs,
	}
end

function NPCSeats.FreeSlots(seed: number): { number }
	local plan = NPCSeats.BenchPlan(seed)
	local free = {}
	for i = 1, #NPCSeats.BENCH_SLOTS do
		if not plan.Occupied[i] then
			table.insert(free, i)
		end
	end
	return free
end

return NPCSeats
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="344">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--[[
	Net (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > Net

	Centralise les RemoteEvents / RemoteFunctions.
	- Le SERVEUR appelle Net.Setup() au démarrage : il crée automatiquement le
	  dossier ReplicatedStorage > Remotes et tous les remotes listés ci-dessous.
	  => Tu n'as RIEN à créer à la main.
	- Le CLIENT utilise Net.Event("Nom") / Net.Function("Nom") qui attendent
	  que le remote existe.

	Sens de communication :
	  C -> S : le client DEMANDE, le serveur valide TOUT.
	  S -> C : le serveur informe le client.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

Net.Events = {
	"ClientReady", -- C -> S () : l'interface est prête, envoie-moi tout
	"Click", -- C -> S () : un clic sur le bouton
	"StateUpdate", -- S -> C (state) : état complet du joueur
	"StateTick", -- S -> C (tick) : petite mise à jour fréquente (Dopamine, clics...) entre deux états complets
	"Notify", -- S -> C (payload) : succès, quêtes, bonus, jackpot, détox...
	"DVDSetup", -- S -> C ({ Logos = { params... } }) : trajectoires des logos DVD
	"DVDResize", -- C -> S (w, h) : taille d'un logo à l'écran (fraction de l'écran)
	"DVDClick", -- C -> S (index) : clic sur le logo numéro `index`
	"DVDCorner", -- C -> S (index, k) : le logo `index` a touché un coin au rebond k
	"Spawn", -- S -> C (info) : un objet à cliquer apparaît (étoile, éclair, notif, mail)
	"SpawnClick", -- C -> S (id) : le joueur a cliqué cet objet
	"Interact", -- C -> S (kind, arg) : papier bulle, moulin, titre du fil d'actu, presse
	"EventUpdate", -- S -> C (rush) : début / fin d'un Dopamine Rush
	"LeaderboardUpdate", -- S -> C (top) : top du classement
	"ArcadeEvent", -- S <-> C (kind, payload) : arcade en temps réel (invitations, coups des duels...)
	"FriendMailEvent", -- S -> C ("New", mail filtré) : un mail d'ami Roblox arrive (FriendMailService)
	"WorldEvent", -- S -> C (kind, payload) : 🚶 Dopamine Town (maisons, "j'aime", messages) (WorldService)
	"Impact", -- S <-> C (kind, ...) : 💥 renversé / titube / relevé (ImpactService + Knockdown, v10 PHYS10)
	"RaceEvent", -- C <-> S (kind, ...) : 🏁 courses de rue (inscription, instantanés, résultats) (RaceService, v10)
	"MusicEvent", -- C <-> S (kind, ...) : 🎵 scène musicale de la place (notes relayées aux voisins, morceaux, radio) (TownMusic, v9.9)
}

Net.Functions = {
	"BuyUpgrade", -- C -> S (upgradeId) -> (succès, message)
	"ClaimDaily", -- C -> S () -> (succès, message)
	"SetSetting", -- C -> S (nom, valeur) -> succès
	"CasinoSpin", -- C -> S () -> (succès, résultat | message) : tour GRATUIT (1 jeton) de la machine chanceuse
	"OpenChest", -- C -> S () -> (succès, résultat | message)
	"ItemShop", -- C -> S ("buy" | "equip" | "unequip", cosmeticId) -> (succès, message)
	"ThemeShop", -- C -> S ("buy" | "equip", themeId) -> (succès, message)
	"House", -- C -> S (action, argument) -> (succès, message) : maison (achats, papier peint, sol, disposition)
	"Garden", -- C -> S (action, argument) -> (succès, résultat | message) : jardin de Dopamine
	"Arcade", -- C -> S (action, argument) -> (succès, résultat | message) : mini-jeux, tickets, duels
	"FilterText", -- C -> S (purpose "Live" | "Mail", texte) -> (succès, { Text, Topics } | message) : texte tapé, filtré par Roblox
	"FriendMail", -- C -> S (action, argument) -> (succès, résultat | message, état?) : mails entre amis Roblox (FriendMailService)
	"World", -- C -> S (action, argument) -> (succès, résultat | message) : 🚶 Dopamine Town (entrer, visiter, s'asseoir, j'aime) (WorldService)
	"Car", -- C -> S (action, a, b) -> (succès, message, extra?) : 🚗 voitures (acheter, couleur, choisir, garage, conduire, klaxon) (CarService)
	"Food", -- C -> S ("buy", foodId, stallId | "bite") -> (succès, message, manquant?) : 🍦 nourriture de Dopamine Town (FoodService, v9.8)
	"DebugCommand", -- C -> S (commande, argument) -> (succès, message) : UNIQUEMENT dans Studio
}

local FOLDER_NAME = "Remotes"

-- Serveur uniquement : crée tous les remotes
function Net.Setup()
	assert(RunService:IsServer(), "Net.Setup() doit être appelé par le serveur")

	local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = FOLDER_NAME
		folder.Parent = ReplicatedStorage
	end

	for _, name in ipairs(Net.Events) do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end

	for _, name in ipairs(Net.Functions) do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = folder
		end
	end
end

local function getFolder(): Instance
	return ReplicatedStorage:WaitForChild(FOLDER_NAME)
end

function Net.Event(name: string): RemoteEvent
	return getFolder():WaitForChild(name) :: RemoteEvent
end

function Net.Function(name: string): RemoteFunction
	return getFolder():WaitForChild(name) :: RemoteFunction
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="345">
        <Properties>
          <string name="Name">NumberFormatter</string>
          <string name="Source"><![CDATA[--[[
	NumberFormatter (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > NumberFormatter

	Formate les grands nombres : 1 234 -> "1.23K", 5 600 000 -> "5.6M", etc.
]]

local NumberFormatter = {}

-- Suffixes : K = mille, M = million, B = milliard, T = billion, puis notation anglaise courte
local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc", "UDc", "DDc", "TDc", "QaDc", "QiDc", "SxDc", "SpDc", "OcDc", "NoDc", "Vg" }

-- Retire les zéros inutiles : "1.50" -> "1.5", "2.00" -> "2"
local function trimZeros(text: string): string
	if string.find(text, "%.") then
		text = string.gsub(text, "0+$", "")
		text = string.gsub(text, "%.$", "")
	end
	return text
end

-- Format court avec suffixe (ex. 1.23M)
function NumberFormatter.Format(value: number, decimals: number?): string
	decimals = decimals or 2
	if value ~= value then
		return "0" -- NaN
	end
	if value == math.huge then
		return "∞"
	end

	local sign = value < 0 and "-" or ""
	value = math.abs(value)

	if value < 1000 then
		-- Petits nombres : entier, ou une décimale si < 10 (ex. 2.5)
		if value < 10 and value % 1 ~= 0 then
			return sign .. trimZeros(string.format("%.1f", math.floor(value * 10) / 10))
		end
		return sign .. tostring(math.floor(value))
	end

	local tier = math.floor(math.log10(value) / 3)
	-- Corrige les petites erreurs d'arrondi de log10 (ex. 999.999...)
	if value / (10 ^ (tier * 3)) >= 1000 then
		tier += 1
	elseif value / (10 ^ (tier * 3)) < 1 then
		tier -= 1
	end
	if tier >= #SUFFIXES then
		-- Au-delà des suffixes connus : notation scientifique
		return sign .. string.format("%.2e", value)
	end

	local scaled = value / (10 ^ (tier * 3))
	-- On tronque (au lieu d'arrondir) pour ne jamais afficher plus que ce qu'on a
	local factor = 10 ^ (decimals :: number)
	-- (petite marge : 1e29 / 1e27 donne 99.9999999 en virgule flottante)
	scaled = math.floor(scaled * factor + 1e-6) / factor
	return sign .. trimZeros(string.format("%." .. tostring(decimals) .. "f", scaled)) .. SUFFIXES[tier + 1]
end

-- Format avec séparateurs de milliers (ex. 1 234 567), pour les petits nombres
function NumberFormatter.WithSpaces(value: number): string
	local text = tostring(math.floor(value))
	local result = string.reverse(text)
	result = string.gsub(result, "(%d%d%d)", "%1 ")
	result = string.reverse(result)
	return (string.gsub(result, "^%s+", ""))
end

-- Durée en secondes -> "1h 05m", "4m 12s", "9s"
function NumberFormatter.Time(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then
		return string.format("%dh %02dm", h, m)
	elseif m > 0 then
		return string.format("%dm %02ds", m, s)
	end
	return string.format("%ds", s)
end

-- Multiplicateur lisible : 2 -> "x2", 1.5 -> "x1.5"
function NumberFormatter.Multiplier(value: number): string
	if value >= 1000 then
		return "x" .. NumberFormatter.Format(value)
	end
	return "x" .. trimZeros(string.format("%.2f", value))
end

return NumberFormatter
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="346">
        <Properties>
          <string name="Name">ParkMotion</string>
          <string name="Source"><![CDATA[--[[
	ParkMotion (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > ParkMotion

	🛝 Aire de jeux de Dopamine Town (v9.9, PARK99) : plan ET mouvements,
	partagés par le serveur (TownPark : sièges, invites) et le client
	(ParkPlay : décor réaliste, animation, poses de l'avatar).

	Tout le mouvement est une FONCTION DE L'HEURE DU SERVEUR
	(workspace:GetServerTimeNow()) et de 4 attributs posés par le serveur sur
	chaque jeu quand quelqu'un monte ou descend :
	  On (bool) : au moins un enfant dessus ; T0 : heure du dernier changement ;
	  A0 : enveloppe (0..1) ou angle au moment T0 ; W0 : vitesse (tourniquet).
	Chaque client calcule donc EXACTEMENT la même pose, sans remote ni flux
	réseau : tout le monde voit la balançoire du voisin se balancer.

	Physique (à l'échelle réelle : ~3,06 studs par mètre, SCALE99) :
	  - balançoire : pendule simple, ω = √(g / L), g = 9,81 m/s² × 3,06 ;
	    l'amplitude monte quand on "pompe" (enveloppe 1 − e^(−t/τ)) puis
	    s'amortit quand on descend ;
	  - tape-cul : bascule à plateau (on reste un instant en bas : tanh) ;
	  - tourniquet : vitesse angulaire qui monte / retombe (intégrale exacte :
	    aucun à-coup de l'angle aux changements) ;
	  - jeux à ressort : tangage + roulis + petit rebond.

	Repère de l'aire (g) : centre au sol (dessus du pré), -Z vers la place
	(portillon), comme TownNature.
]]

local ParkMotion = {}

local rad = math.rad
local exp = math.exp
local sin = math.sin
local TAU = math.pi * 2

----------------------------------------------------------------------
-- Échelle et physique
----------------------------------------------------------------------

ParkMotion.STUDS_PER_METER = 3.06
ParkMotion.G = 9.81 * ParkMotion.STUDS_PER_METER -- (studs/s²) ≈ 30

----------------------------------------------------------------------
-- Plan (repère de l'aire)
----------------------------------------------------------------------

ParkMotion.W, ParkMotion.D = 38, 30 -- (aire) largeur x profondeur
ParkMotion.FLOOR_TOP = 0.2 -- dessus du sol souple (serveur)
ParkMotion.GATE = 2.4 -- demi-largeur du portillon (côté -Z)

-- Balançoires : portique le long de X, on se balance le long de Z
ParkMotion.SWING = {
	Center = Vector3.new(11, 0, -7),
	PivotY = 7.75, -- axe des crochets (sous la poutre)
	SeatTop = 1.5, -- dessus de l'assise au repos (SCALE99 : ~1,4-1,5)
	Xs = { -2.7, 0, 2.7 }, -- 3 places (2 sangles + 1 siège bébé)
	Amax = rad(34),
	Rise = 3.2, -- (s) on prend de l'élan…
	Fall = 5.0, -- …et on s'arrête doucement
}
ParkMotion.SWING.L = ParkMotion.SWING.PivotY - ParkMotion.SWING.SeatTop
ParkMotion.SWING.Omega = math.sqrt(ParkMotion.G / ParkMotion.SWING.L) -- (rad/s) période ≈ 2,9 s

-- Tape-cul : planche le long de X, pivot au centre
ParkMotion.SEESAW = {
	Center = Vector3.new(11.5, 0, 7),
	PivotY = 1.55,
	Half = 4.3, -- demi-longueur de la planche
	SeatX = 3.85, -- sièges à ±SeatX
	SeatUp = 0.52, -- dessus du siège au-dessus de l'axe
	Tilt = rad(13),
	Period = 2.6,
	Rise = 0.9,
	Fall = 1.6,
}

-- Tourniquet
ParkMotion.MERRY = {
	Center = Vector3.new(2, 0, 0.5),
	DeckTop = 0.9,
	Radius = 3.3,
	SeatR = 2.4,
	SeatTop = 1.45,
	Seats = 4,
	Wmax = 1.1, -- (rad/s) un tour en ~5,7 s
	Rise = 2.4,
	Fall = 5.5,
}

-- Jeux à ressort (cheval, canard)
ParkMotion.SPRINGS = {
	{ Pos = Vector3.new(-6, 0, -11.4), Yaw = rad(20), Kind = "Horse" },
	{ Pos = Vector3.new(-6.6, 0, -6.4), Yaw = rad(-25), Kind = "Duck" },
}
ParkMotion.SPRING = {
	PivotY = 0.45, -- haut du socle (le ressort part de là)
	SeatUp = 1.45, -- dessus de la selle au-dessus du pivot (selle à ~1,9)
	Pitch = rad(15),
	Roll = rad(4),
	Freq = 1.25,
	Rise = 0.8,
	Fall = 1.3,
}

-- Toboggan : tour, échelle (-Z), glissière (+Z), mur d'escalade (-X)
ParkMotion.SLIDE = {
	Tower = Vector3.new(-12, 0, 1.8),
	DeckTop = 4.6,
	Deck = 3.4,
	-- profil de la glissière (repère de la tour) : { z, dessus de la surface }
	Profile = { { 1.7, 4.62 }, { 2.3, 4.58 }, { 3.0, 4.25 }, { 7.8, 1.2 }, { 8.7, 0.78 }, { 10.2, 0.72 } },
	LadderZ = -2.05, -- plan des barreaux (devant la tour)
	LadderLean = rad(14),
}

-- Cage à grimper + échelle horizontale (barres de singe)
ParkMotion.MONKEY = {
	Z = 10.5,
	X0 = -5.2, -- échelle de départ (bout -X)
	X1 = 4.2, -- échelle d'arrivée (bout +X)
	BarY = 7.0, -- barreaux (centre)
	Rungs = 9,
	Width = 1.8,
}

-- Bac à sable
ParkMotion.SAND = { Center = Vector3.new(-13.5, 0, -10.5), Inner = 6.4 }

-- Bancs des parents (2 places chacun)
ParkMotion.BENCHES = {
	{ Pos = Vector3.new(15.9, 0, -1), Face = Vector3.new(-1, 0, 0) },
	{ Pos = Vector3.new(-17.4, 0, -4.3), Face = Vector3.new(1, 0, 0) },
}
ParkMotion.BENCH = { SeatTop = 1.45, Length = 4.8, Places = { -1.2, 1.2 } }

----------------------------------------------------------------------
-- Enveloppe (0 -> 1 en montant, 1 -> 0 en descendant), continue
----------------------------------------------------------------------

function ParkMotion.Env(on: boolean, t0: number, a0: number, t: number, rise: number, fall: number): number
	local dt = math.max(0, t - t0)
	if on then
		return 1 - (1 - math.clamp(a0, 0, 1)) * exp(-dt / rise)
	end
	return math.clamp(a0, 0, 1) * exp(-dt / fall)
end

-- État d'un jeu (attributs du serveur) ; valeurs sûres si absents
export type State = { On: boolean, T0: number, A0: number, W0: number }

function ParkMotion.StateOf(holder: Instance?): State
	local on, t0, a0, w0 = false, 0, 0, 0
	if holder then
		on = holder:GetAttribute("On") == true
		t0 = tonumber(holder:GetAttribute("T0")) or 0
		a0 = tonumber(holder:GetAttribute("A0")) or 0
		w0 = tonumber(holder:GetAttribute("W0")) or 0
	end
	if t0 ~= t0 then
		t0 = 0
	end
	if a0 ~= a0 then
		a0 = 0
	end
	if w0 ~= w0 then
		w0 = 0
	end
	return { On = on, T0 = t0, A0 = a0, W0 = w0 }
end

-- Réglages (montée / descente) par sorte de jeu
local RATES = {
	Swing = ParkMotion.SWING,
	Seesaw = ParkMotion.SEESAW,
	Spring = ParkMotion.SPRING,
}

-- Tourniquet : (angle, vitesse) à l'instant t
function ParkMotion.Merry(s: State, t: number): (number, number)
	local m = ParkMotion.MERRY
	local dt = math.max(0, t - s.T0)
	if s.On then
		local k = exp(-dt / m.Rise)
		local w = m.Wmax - (m.Wmax - s.W0) * k
		local a = s.A0 + m.Wmax * dt - (m.Wmax - s.W0) * m.Rise * (1 - k)
		return a, w
	end
	local k = exp(-dt / m.Fall)
	return s.A0 + s.W0 * m.Fall * (1 - k), s.W0 * k
end

-- Nouvel état quand le nombre d'enfants passe de 0 à 1 (on = true) ou de
-- 1 à 0 (on = false) : l'enveloppe / l'angle repartent de leur valeur
-- ACTUELLE (aucun saut)
function ParkMotion.Transition(kind: string, s: State, t: number, on: boolean): State
	if kind == "Merry" then
		local a, w = ParkMotion.Merry(s, t)
		return { On = on, T0 = t, A0 = a % TAU, W0 = w }
	end
	local r = RATES[kind] or ParkMotion.SWING
	local env = ParkMotion.Env(s.On, s.T0, s.A0, t, r.Rise, r.Fall)
	return { On = on, T0 = t, A0 = env, W0 = 0 }
end

function ParkMotion.EnvOf(kind: string, s: State, t: number): number
	local r = RATES[kind] or ParkMotion.SWING
	return ParkMotion.Env(s.On, s.T0, s.A0, t, r.Rise, r.Fall)
end

----------------------------------------------------------------------
-- Poses (repère de l'aire)
----------------------------------------------------------------------

-- Balançoire `i` : angle (rad, + = vers -Z) et phase (pour les jambes)
function ParkMotion.SwingAngle(env: number, t: number, i: number): (number, number)
	local S = ParkMotion.SWING
	local phase = S.Omega * t + i * 1.9
	return S.Amax * env * sin(phase), phase
end

-- Repère du pivot de la balançoire i (x le long de la poutre)
function ParkMotion.SwingPivot(i: number): CFrame
	local S = ParkMotion.SWING
	return CFrame.new(S.Center + Vector3.new(S.Xs[i] or 0, S.PivotY, 0))
end

-- Repère de l'assise (dessus, face -Z) pour un angle donné
function ParkMotion.SwingSeat(i: number, angle: number): CFrame
	local S = ParkMotion.SWING
	return ParkMotion.SwingPivot(i) * CFrame.Angles(angle, 0, 0) * CFrame.new(0, -S.L, 0)
end

-- Tape-cul : angle (+ = le bout +X monte)
function ParkMotion.SeesawAngle(env: number, t: number): number
	local S = ParkMotion.SEESAW
	-- au repos : le bout +X posé au sol ; en jeu : bascule "à plateau"
	local wave = math.tanh(2.4 * sin(TAU * t / S.Period)) / math.tanh(2.4)
	return -S.Tilt * (1 - env) + S.Tilt * env * wave
end

function ParkMotion.SeesawPivot(angle: number): CFrame
	local S = ParkMotion.SEESAW
	return CFrame.new(S.Center + Vector3.new(0, S.PivotY, 0)) * CFrame.Angles(0, 0, angle)
end

-- Siège k (1 = bout -X, face +X ; 2 = bout +X, face -X), dessus du siège
function ParkMotion.SeesawSeat(k: number, angle: number): CFrame
	local S = ParkMotion.SEESAW
	local x = k == 1 and -S.SeatX or S.SeatX
	local p = ParkMotion.SeesawPivot(angle) * CFrame.new(x, S.SeatUp, 0)
	-- (le siège reste dans le plan de la planche ; l'avatar regarde le pivot)
	local yaw = k == 1 and -math.pi / 2 or math.pi / 2
	return p * CFrame.Angles(0, yaw, 0)
end

function ParkMotion.MerryFrame(angle: number): CFrame
	local m = ParkMotion.MERRY
	return CFrame.new(m.Center) * CFrame.Angles(0, angle, 0)
end

-- Siège k du tourniquet (dessus, face au centre)
function ParkMotion.MerrySeat(k: number, angle: number): CFrame
	local m = ParkMotion.MERRY
	local a = (k - 0.5) / m.Seats * TAU
	return ParkMotion.MerryFrame(angle) * CFrame.Angles(0, a, 0) * CFrame.new(0, m.SeatTop, m.SeatR)
end

-- Jeu à ressort i : repère du socle, puis repère du corps (tangage / roulis)
function ParkMotion.SpringBase(i: number): CFrame
	local s = ParkMotion.SPRINGS[i] or ParkMotion.SPRINGS[1]
	return CFrame.new(s.Pos) * CFrame.Angles(0, s.Yaw, 0)
end

function ParkMotion.SpringBody(i: number, env: number, t: number): CFrame
	local S = ParkMotion.SPRING
	local w = TAU * S.Freq * t + i * 2.3
	local pitch = S.Pitch * env * sin(w)
	local roll = S.Roll * env * sin(w * 0.5 + 0.7)
	local bounce = 0.12 * env * math.abs(sin(w))
	return ParkMotion.SpringBase(i) * CFrame.new(0, S.PivotY + bounce, 0) * CFrame.Angles(pitch, 0, roll)
end

function ParkMotion.SpringSeat(i: number, env: number, t: number): CFrame
	return ParkMotion.SpringBody(i, env, t) * CFrame.new(0, ParkMotion.SPRING.SeatUp, 0.15)
end

-- Bancs : place k du banc b (dessus de l'assise, face `Face`)
function ParkMotion.BenchFrame(b: number): CFrame
	local B = ParkMotion.BENCHES[b] or ParkMotion.BENCHES[1]
	return CFrame.lookAt(B.Pos, B.Pos + B.Face)
end

function ParkMotion.BenchSeat(b: number, k: number): CFrame
	return ParkMotion.BenchFrame(b) * CFrame.new(ParkMotion.BENCH.Places[k] or 0, ParkMotion.BENCH.SeatTop, -0.05)
end

----------------------------------------------------------------------
-- Toboggan : point de la surface à l'abscisse z (repère de la tour)
----------------------------------------------------------------------

function ParkMotion.SlideTower(): CFrame
	return CFrame.new(ParkMotion.SLIDE.Tower)
end

-- (y, pente dy/dz) de la surface de glisse à l'abscisse z (profil lissé)
function ParkMotion.SlideSurface(z: number): (number, number)
	local P = ParkMotion.SLIDE.Profile
	if z <= P[1][1] then
		return P[1][2], 0
	end
	for i = 1, #P - 1 do
		local a, b = P[i], P[i + 1]
		if z <= b[1] then
			local u = (z - a[1]) / (b[1] - a[1])
			local slope = (b[2] - a[2]) / (b[1] - a[1])
			-- raccord doux avec les pentes voisines (Hermite)
			local s0 = i > 1 and (b[2] - P[i - 1][2]) / (b[1] - P[i - 1][1]) or slope
			local s1 = i < #P - 1 and (P[i + 2][2] - a[2]) / (P[i + 2][1] - a[1]) or slope
			local h = b[1] - a[1]
			local u2, u3 = u * u, u * u * u
			local y = (2 * u3 - 3 * u2 + 1) * a[2] + (u3 - 2 * u2 + u) * h * s0 + (-2 * u3 + 3 * u2) * b[2] + (u3 - u2) * h * s1
			local dy = ((6 * u2 - 6 * u) * a[2] + (3 * u2 - 4 * u + 1) * h * s0 + (-6 * u2 + 6 * u) * b[2] + (3 * u2 - 2 * u) * h * s1) / h
			return y, dy
		end
	end
	local last = P[#P]
	return last[2], 0
end

ParkMotion.SLIDE_END = ParkMotion.SLIDE.Profile[#ParkMotion.SLIDE.Profile][1]

return ParkMotion
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="347">
        <Properties>
          <string name="Name">RaceRoutes</string>
          <string name="Source"><![CDATA[--[[
	RaceRoutes (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > RaceRoutes

	🏁 Parcours des courses de rue (v10, RACE10), construits sur le GRAPHE
	DES RUES de la ville (WorldLayout.RoadGraph de LAYOUT10) : partagé par le
	serveur (RaceService) et les clients (RaceClient) -> exactement les mêmes
	parcours partout. Calcul pur (nombres), mis en cache par nombre de
	parcelles ; les CFrame ne sont faits qu'à la demande (jeu).

	Parcours (Config.Race.Routes) :
	  City      🏙️ circuit du centre-ville (2 tours) ;
	  Highway   🛣️ sprint sur l'autoroute (bretelle -> sortie) ;
	  Districts 🏘️ boucle par les quartiers résidentiels ;
	  Night     🌙 grand tour (ville + autoroute), course de nuit.
	Chaque parcours = points de passage (coins du centre, centres des
	quartiers, extrémités de la ville...) reliés par le plus court chemin
	dans le graphe (rues déjà prises pénalisées : pas de demi-tour), puis
	virages arrondis (trajectoire de course), rééchantillonné tous les 4
	studs. Ligne de départ sur une LIGNE DROITE (grille de 8 places
	derrière), portes tous les ~170 studs, arrivée (boucle : la ligne de
	départ ; sprint : le dernier point).
	Sans graphe (avant LAYOUT10), un graphe de secours est tiré de l'ancien
	boulevard circulaire + avenue : les courses marchent quand même.

	API :
	  RaceRoutes.Get(routeId, count) -> Route?     (cache)
	  RaceRoutes.All(count) -> { Route }
	  RaceRoutes.Graph(count) -> graphe normalisé (Nodes, Edges, Adj)
	  RaceRoutes.MeetPoint(count) -> (x, z, heading) (repère du centre)
	  RaceRoutes.MeetCFrame(count) -> CFrame (monde, au sol, regard = heading)
	  RaceRoutes.GridCFrame(route, slot) -> CFrame (monde, pivot au sol, avant = -Z)
	  RaceRoutes.ToWorld(x, z, y?) -> Vector3
	  RaceRoutes.BlockedEdgeKeys(count) -> { ["a|b"] = true } (courses en cours)
	  RaceRoutes.IsNearActiveRoute(position: Vector3, margin?) -> boolean
	Route = { Id, Def, Closed, Laps, Line (trajectoire, pas de 4), Total (un
	  tour / la ligne), StartS (sprint : ligne de départ), RaceDistance,
	  Width, Checkpoints = { { D, S, X, Z, TX, TZ, W, Finish? } } (D = distance
	  de course), Grid = { { X, Z, TX, TZ } }, EdgeKeys = { ["a|b"] = true },
	  Nodes = { id } }
]]

local Config = require(script.Parent.Config)
local WorldLayout = require(script.Parent.WorldLayout)
local RaceRules = require(script.Parent.RaceRules)

local RaceRoutes = {}

RaceRoutes.ACTIVE_ATTRIBUTE = "DopamineRaceRoutes" -- (Workspace) ids des parcours en course, séparés par des virgules
RaceRoutes.STEP = 4 -- pas de la trajectoire (studs)
RaceRoutes.GRID_SLOTS = 8
RaceRoutes.GRID_ROW = 13 -- studs entre deux rangées de la grille
RaceRoutes.GRID_FIRST = 9 -- 1re rangée derrière la ligne
RaceRoutes.GRID_SIDE = 4.2 -- décalage latéral des deux colonnes
RaceRoutes.STRAIGHT_BEFORE = 120 -- ligne droite demandée avant le départ
RaceRoutes.SPRINT_GRID = 70 -- sprint : la grille occupe les 70 premiers studs

export type Node = { Id: string, X: number, Z: number, Y: number }
export type Edge = { A: string, B: string, Len: number, Points: { { number } }, Highway: boolean, Ramp: boolean, Width: number, Speed: number, Off: number, EffWidth: number }
export type Graph = { Nodes: { [string]: Node }, Edges: { Edge }, Adj: { [string]: { { To: string, Edge: Edge, Fwd: boolean } } }, Fallback: boolean }

local cache: { [number]: { Graph: Graph?, Routes: { [string]: any } } } = {}
local despike: (points: { { number } }, closed: boolean) -> { { number } }

local function finite(v: any, d: number): number
	return RaceRules.Finite(v, d)
end

local function origin(): (number, number, number)
	local ok, o = pcall(WorldLayout.Origin)
	if ok and o then
		return o.X, o.Y, o.Z
	end
	return WorldLayout.ORIGIN_X or 0, WorldLayout.ORIGIN_Y or 0, WorldLayout.ORIGIN_Z or 0
end

local function cacheFor(count: number)
	local c = cache[count]
	if not c then
		c = { Graph = nil, Routes = {} }
		cache[count] = c
	end
	return c
end

-- (tests / LAYOUT10 : le graphe a changé) oublie les parcours calculés
function RaceRoutes.ClearCache()
	table.clear(cache)
end

----------------------------------------------------------------------
-- Graphe des rues : normalisation (formes souples) + secours
----------------------------------------------------------------------

-- Position d'un nœud ou d'un point : Vector3 (monde) ou nombres (repère du centre)
local function readPoint(p: any): (number?, number?, number?)
	if p == nil then
		return nil
	end
	local ox, oy, oz = origin()
	local t = typeof(p)
	if t == "Vector3" then
		return p.X - ox, p.Z - oz, p.Y - oy
	elseif t == "CFrame" then
		local q = p.Position
		return q.X - ox, q.Z - oz, q.Y - oy
	elseif t == "table" then
		if p.Position ~= nil then
			return readPoint(p.Position)
		elseif p.P ~= nil then
			return readPoint(p.P)
		elseif p.Pos ~= nil then
			return readPoint(p.Pos)
		elseif type(p.X) == "number" and type(p.Z) == "number" then
			return p.X, p.Z, finite(p.Y, 0)
		elseif type(p.x) == "number" and type(p.z) == "number" then
			return p.x, p.z, finite(p.y, 0)
		elseif type(p[1]) == "number" and type(p[2]) == "number" then
			if type(p[3]) == "number" then
				-- { x, y, z } (3 nombres)
				return p[1], p[3], p[2]
			end
			return p[1], p[2], 0
		end
	end
	return nil
end
RaceRoutes.ReadPoint = readPoint

local function edgeKey(a: string, b: string): string
	if a < b then
		return a .. "|" .. b
	end
	return b .. "|" .. a
end
RaceRoutes.EdgeKey = edgeKey

local function addEdge(g: Graph, a: string, b: string, pts: { { number } }?, info: any)
	local na, nb = g.Nodes[a], g.Nodes[b]
	if not na or not nb or a == b then
		return
	end
	local points: { { number } } = { { na.X, na.Z, na.Y } }
	for _, p in ipairs(pts or {}) do
		local x, z, y = readPoint(p)
		if x and z then
			table.insert(points, { x, z, y or 0 })
		end
	end
	table.insert(points, { nb.X, nb.Z, nb.Y })
	local len = 0
	for i = 2, #points do
		len += math.sqrt((points[i][1] - points[i - 1][1]) ^ 2 + (points[i][2] - points[i - 1][2]) ^ 2)
	end
	local lanes = finite(info and info.Lanes, 1)
	local width = finite(info and (info.Width or info.RoadWidth), math.max(12, lanes * 8))
	-- (autoroute : axe = terre-plein central) on court sur SA chaussée, à
	-- droite de l'axe : décalage = milieu des voies, largeur = les voies
	local off, effW = 0, width
	local offsets = info and info.LaneOffsets
	if lanes >= 2 and type(offsets) == "table" and #offsets >= 2 then
		local lo, hi = math.huge, -math.huge
		for _, o in ipairs(offsets) do
			local v = finite(o, 0)
			lo, hi = math.min(lo, v), math.max(hi, v)
		end
		off = (lo + hi) / 2
		effW = (hi - lo) + 11
	end
	local edge: Edge = {
		A = a,
		B = b,
		Len = math.max(len, 0.1),
		Points = points,
		Highway = info ~= nil and (info.Highway == true or info.Kind == "Highway"),
		Ramp = info ~= nil and (info.Ramp == true or info.Kind == "Ramp"),
		Width = width,
		Speed = finite(info and (info.Speed or info.SpeedLimit), 40),
		Off = off,
		EffWidth = effW,
	}
	table.insert(g.Edges, edge)
	g.Adj[a] = g.Adj[a] or {}
	g.Adj[b] = g.Adj[b] or {}
	table.insert(g.Adj[a], { To = b, Edge = edge, Fwd = true })
	-- sens unique ? (OneWay) : pas d'arête retour
	if not (info and info.OneWay == true) then
		table.insert(g.Adj[b], { To = a, Edge = edge, Fwd = false })
	end
end

-- Graphe brut de LAYOUT10 -> graphe normalisé (nil si inutilisable)
function RaceRoutes.Normalize(raw: any): Graph?
	if type(raw) ~= "table" then
		return nil
	end
	local g: Graph = { Nodes = {}, Edges = {}, Adj = {}, Fallback = false }
	local nodes = raw.Nodes or raw.nodes
	if type(nodes) ~= "table" then
		return nil
	end
	local count = 0
	local function addNode(key: any, node: any)
		local id = if type(node) == "table" and node.Id ~= nil then tostring(node.Id) else tostring(key)
		local x, z, y = readPoint(node)
		if x and z then
			g.Nodes[id] = { Id = id, X = x, Z = z, Y = y or 0 }
			count += 1
		end
	end
	if #nodes > 0 then
		for i, node in ipairs(nodes) do
			addNode(i, node)
		end
	else
		for key, node in pairs(nodes) do
			addNode(key, node)
		end
	end
	local edges = raw.Edges or raw.edges
	if count < 3 or type(edges) ~= "table" then
		return nil
	end
	for _, e in ipairs(edges) do
		if type(e) == "table" then
			local a = e.A or e.From or e.a or e[1]
			local b = e.B or e.To or e.b or e[2]
			if a ~= nil and b ~= nil then
				addEdge(g, tostring(a), tostring(b), e.Points or e.Path, e)
			end
		end
	end
	if #g.Edges < 3 then
		return nil
	end
	return g
end

-- Secours (pas de RoadGraph) : boulevard polygonal devant les parcelles +
-- avenue d'entrée (repère du centre de la ville)
local function fallbackGraph(count: number): Graph
	local g: Graph = { Nodes = {}, Edges = {}, Adj = {}, Fallback = true }
	local m = WorldLayout.PlotSlots(count)
	local ringR = WorldLayout.RingRoadRadius(count)
	local corner = ringR / math.cos(math.pi / m)
	local info = { Width = WorldLayout.ROAD_W, Lanes = 2, Speed = 40 }
	for k = 0, m - 1 do
		local a = (k + 0.5) / m * math.pi * 2
		g.Nodes["R" .. k] = { Id = "R" .. k, X = math.sin(a) * corner, Z = math.cos(a) * corner, Y = WorldLayout.ROAD_Y }
		local mid = k / m * math.pi * 2
		g.Nodes["M" .. k] = { Id = "M" .. k, X = math.sin(mid) * ringR, Z = math.cos(mid) * ringR, Y = WorldLayout.ROAD_Y }
	end
	for k = 0, m - 1 do
		local prev = (k - 1) % m
		addEdge(g, "R" .. prev, "M" .. k, nil, info)
		addEdge(g, "M" .. k, "R" .. k, nil, info)
	end
	-- avenue : de la place jusqu'au boulevard (emplacement 0 = entrée)
	local plazaZ = WorldLayout.PLAZA_R + WorldLayout.WALK_W + 10
	g.Nodes.P0 = { Id = "P0", X = 0, Z = plazaZ, Y = WorldLayout.ROAD_Y }
	addEdge(g, "P0", "M0", nil, { Width = WorldLayout.AVENUE_W, Lanes = 2, Speed = 30 })
	return g
end

-- Graphe de la ville (LAYOUT10 si possible, sinon secours), en cache
function RaceRoutes.Graph(count: number): Graph
	local c = cacheFor(count)
	if c.Graph then
		return c.Graph :: Graph
	end
	local g: Graph? = nil
	local fn = (WorldLayout :: any).RoadGraph
	if type(fn) == "function" then
		local ok, raw = pcall(fn, count)
		if ok then
			g = RaceRoutes.Normalize(raw)
		end
	end
	local graph = g or fallbackGraph(count)
	c.Graph = graph
	return graph
end

----------------------------------------------------------------------
-- Plus court chemin (Dijkstra, tas binaire)
----------------------------------------------------------------------

type CostFn = (edge: Edge) -> number

local function dijkstra(g: Graph, from: string, to: string, cost: CostFn): { { To: string, Edge: Edge, Fwd: boolean } }?
	if from == to then
		return {}
	end
	local dist: { [string]: number } = { [from] = 0 }
	local prev: { [string]: { From: string, Step: any } } = {}
	local heap: { { number | string } } = { { 0, from } }
	local function push(item)
		table.insert(heap, item)
		local i = #heap
		while i > 1 do
			local p = i // 2
			if (heap[p][1] :: number) <= (heap[i][1] :: number) then
				break
			end
			heap[p], heap[i] = heap[i], heap[p]
			i = p
		end
	end
	local function pop()
		local top = heap[1]
		local last = table.remove(heap)
		if #heap > 0 and last then
			heap[1] = last
			local i = 1
			while true do
				local l, r = i * 2, i * 2 + 1
				local s = i
				if l <= #heap and (heap[l][1] :: number) < (heap[s][1] :: number) then
					s = l
				end
				if r <= #heap and (heap[r][1] :: number) < (heap[s][1] :: number) then
					s = r
				end
				if s == i then
					break
				end
				heap[s], heap[i] = heap[i], heap[s]
				i = s
			end
		end
		return top
	end
	while #heap > 0 do
		local item = pop()
		local d, u = item[1] :: number, item[2] :: string
		if d > (dist[u] or math.huge) then
			continue
		end
		if u == to then
			break
		end
		for _, step in ipairs(g.Adj[u] or {}) do
			local c = cost(step.Edge)
			if c < math.huge then
				local nd = d + c
				if nd < (dist[step.To] or math.huge) then
					dist[step.To] = nd
					prev[step.To] = { From = u, Step = step }
					push({ nd, step.To })
				end
			end
		end
	end
	if not prev[to] then
		return nil
	end
	local path = {}
	local cur = to
	while cur ~= from do
		local p = prev[cur]
		table.insert(path, 1, p.Step)
		cur = p.From
	end
	return path
end

-- Nœud le plus proche de (x, z) (filtre facultatif)
local function nearestNode(g: Graph, x: number, z: number, filter: ((Node) -> boolean)?): string?
	local best, bestD = nil, math.huge
	for id, node in pairs(g.Nodes) do
		if (filter == nil or filter(node)) and g.Adj[id] and #g.Adj[id] > 0 then
			local d = (node.X - x) ^ 2 + (node.Z - z) ^ 2
			if d < bestD then
				best, bestD = id, d
			end
		end
	end
	return best
end

-- Nœuds touchés par des arêtes d'un type
local function nodeTypes(g: Graph): ({ [string]: boolean }, { [string]: boolean })
	local city, highway = {}, {}
	for _, e in ipairs(g.Edges) do
		if e.Highway or e.Ramp then
			highway[e.A] = true
			highway[e.B] = true
		else
			city[e.A] = true
			city[e.B] = true
		end
	end
	return city, highway
end

----------------------------------------------------------------------
-- Construction d'un parcours
----------------------------------------------------------------------

-- Boucle / chemin par les points de passage (ids de nœuds)
local function chain(g: Graph, via: { string }, closed: boolean, baseCost: CostFn): ({ { number } }?, { [string]: boolean }, number)
	local used: { [string]: number } = {}
	local keys: { [string]: boolean } = {}
	local points: { { number } } = {}
	local minWidth = math.huge
	local function cost(edge: Edge): number
		local c = baseCost(edge)
		local n = used[edgeKey(edge.A, edge.B)]
		if n then
			c *= 6 + n * 4 -- déjà prise : fortement pénalisée (pas de demi-tour)
		end
		return c
	end
	local legs = if closed then #via else #via - 1
	for k = 1, legs do
		local a = via[k]
		local b = via[(k % #via) + 1]
		local path = dijkstra(g, a, b, cost)
		if not path then
			return nil, keys, minWidth
		end
		for _, step in ipairs(path) do
			local e = step.Edge
			local key = edgeKey(e.A, e.B)
			used[key] = (used[key] or 0) + 1
			keys[key] = true
			minWidth = math.min(minWidth, e.EffWidth)
			local pts = e.Points
			local seq = {}
			if step.Fwd then
				for i = 1, #pts do
					table.insert(seq, pts[i])
				end
			else
				for i = #pts, 1, -1 do
					table.insert(seq, pts[i])
				end
			end
			if e.Off ~= 0 then
				-- décalage à droite du sens de marche (droite = (-tz, tx))
				local shifted = {}
				for i, p in ipairs(seq) do
					local pa = seq[math.max(1, i - 1)]
					local pb = seq[math.min(#seq, i + 1)]
					local dx, dz = pb[1] - pa[1], pb[2] - pa[2]
					local len = math.sqrt(dx * dx + dz * dz)
					if len > 1e-6 then
						dx, dz = dx / len, dz / len
					end
					table.insert(shifted, { p[1] - dz * e.Off, p[2] + dx * e.Off, p[3] })
				end
				seq = shifted
			end
			for _, p in ipairs(seq) do
				table.insert(points, p)
			end
		end
	end
	-- points en double + demi-tours (A -> B -> A) retirés
	local clean: { { number } } = {}
	for _, p in ipairs(points) do
		local n = #clean
		if n == 0 or (p[1] - clean[n][1]) ^ 2 + (p[2] - clean[n][2]) ^ 2 > 0.25 then
			if n >= 2 and (p[1] - clean[n - 1][1]) ^ 2 + (p[2] - clean[n - 1][2]) ^ 2 < 0.25 then
				table.remove(clean)
			else
				table.insert(clean, p)
			end
		end
	end
	return clean, keys, minWidth
end

-- Retire les "pointes" : un point où la ligne repart presque en arrière sur
-- un segment court (raccord bretelle -> chaussée décalée de l'autoroute)
despike = function(points: { { number } }, closed: boolean): { { number } }
	local pts = table.clone(points)
	for _ = 1, 40 do
		local changed = false
		local n = #pts
		local i = if closed then 1 else 2
		local last = if closed then n else n - 1
		while i <= last and #pts >= 4 do
			n = #pts
			local a = pts[if i == 1 then n else i - 1]
			local p = pts[i]
			local c = pts[if i == n then 1 else i + 1]
			local ux, uz = p[1] - a[1], p[2] - a[2]
			local vx, vz = c[1] - p[1], c[2] - p[2]
			local lu, lv = math.sqrt(ux * ux + uz * uz), math.sqrt(vx * vx + vz * vz)
			if lu > 1e-6 and lv > 1e-6 then
				local cosT = (ux * vx + uz * vz) / (lu * lv)
				if cosT < math.cos(math.rad(115)) and math.min(lu, lv) < 30 then
					table.remove(pts, i)
					changed = true
					last -= 1
					continue
				end
			end
			i += 1
		end
		if not changed then
			break
		end
	end
	return pts
end

-- Angle (radians) entre les caps à s0 et s1 (le long de la ligne)
local function headingChange(line: RaceRules.Line, s0: number, s1: number): number
	local worst = 0
	local _, _, tx0, tz0 = RaceRules.PointAt(line, s0)
	local s = s0
	while s <= s1 do
		local _, _, tx, tz = RaceRules.PointAt(line, s)
		local c = math.clamp(tx * tx0 + tz * tz0, -1, 1)
		worst = math.max(worst, math.acos(c))
		s += 8
	end
	return worst
end

-- Tourne une boucle pour qu'elle commence à s0
local function rotateLoop(line: RaceRules.Line, s0: number): RaceRules.Line
	local pts = {}
	local n = line.N
	local step = line.Total / n
	for k = 0, n - 1 do
		local x, z, _, _, y = RaceRules.PointAt(line, s0 + k * step)
		table.insert(pts, { x, z, y })
	end
	return RaceRules.Line(pts, true)
end

local function withCheckpoints(route: any)
	local line: RaceRules.Line = route.Line
	local spacing = (Config.Race and Config.Race.CheckpointSpacing) or 170
	local gateW = math.max(route.Width, 20) + 8
	local cps = {}
	local function gateAt(s: number, d: number, finish: boolean?)
		local x, z, tx, tz = RaceRules.PointAt(line, s)
		table.insert(cps, { D = d, S = s, X = x, Z = z, TX = tx, TZ = tz, W = gateW, Finish = finish == true })
	end
	if route.Closed then
		local per = math.max(2, math.floor(line.Total / spacing + 0.5))
		for lap = 0, route.Laps - 1 do
			for k = 1, per do
				local s = line.Total * k / per
				local d = lap * line.Total + s
				local isLast = k == per and lap == route.Laps - 1
				gateAt(s % line.Total, d, isLast)
			end
		end
	else
		local length = line.Total - route.StartS
		local per = math.max(2, math.floor(length / spacing + 0.5))
		for k = 1, per do
			local d = length * k / per
			gateAt(route.StartS + d, d, k == per)
		end
	end
	route.Checkpoints = cps
end

local function withGrid(route: any)
	local line: RaceRules.Line = route.Line
	local grid = {}
	for slot = 1, RaceRoutes.GRID_SLOTS do
		local row = (slot - 1) // 2
		local col = (slot - 1) % 2
		local back = RaceRoutes.GRID_FIRST + row * RaceRoutes.GRID_ROW + col * RaceRoutes.GRID_ROW * 0.5
		local s = route.StartS - back
		local x, z, tx, tz = RaceRules.PointAt(line, s)
		local side = if col == 0 then -RaceRoutes.GRID_SIDE else RaceRoutes.GRID_SIDE
		-- droite = (-tz, tx)
		table.insert(grid, { X = x - tz * side, Z = z + tx * side, TX = tx, TZ = tz, Back = back })
	end
	route.Grid = grid
end

-- Points de passage de chaque parcours
local function districtList(count: number): { any }
	local fn = (WorldLayout :: any).Districts
	if type(fn) ~= "function" then
		return {}
	end
	local ok, list = pcall(fn, count)
	if ok and type(list) == "table" then
		return list
	end
	return {}
end

local function boundsCenter(b: any): (number?, number?, number?, number?)
	-- Bounds : { Min, Max } | { X0, Z0, X1, Z1 } | { Center, Size }
	if type(b) ~= "table" then
		return nil
	end
	if b.Min ~= nil and b.Max ~= nil then
		local x0, z0 = readPoint(b.Min)
		local x1, z1 = readPoint(b.Max)
		if x0 and x1 and z0 and z1 then
			return (x0 + x1) / 2, (z0 + z1) / 2, math.abs(x1 - x0), math.abs(z1 - z0)
		end
	end
	if type(b.X) == "number" and type(b.Z) == "number" and type(b.W) == "number" and type(b.D) == "number" then
		return b.X, b.Z, b.W, b.D
	end
	if type(b.X0) == "number" and type(b.X1) == "number" and type(b.Z0) == "number" and type(b.Z1) == "number" then
		return (b.X0 + b.X1) / 2, (b.Z0 + b.Z1) / 2, math.abs(b.X1 - b.X0), math.abs(b.Z1 - b.Z0)
	end
	if b.Center ~= nil then
		local cx, cz = readPoint(b.Center)
		local sx, sz = 200, 200
		if typeof(b.Size) == "Vector3" then
			sx, sz = b.Size.X, b.Size.Z
		elseif type(b.Size) == "table" then
			sx, sz = finite(b.Size.X or b.Size[1], 200), finite(b.Size.Z or b.Size[2], 200)
		end
		if cx and cz then
			return cx, cz, sx, sz
		end
	end
	return nil
end

local function isResidential(d: any): boolean
	local id = string.lower(tostring(d.Id or d.Name or ""))
	return not (string.find(id, "down") or string.find(id, "center") or string.find(id, "centre") or string.find(id, "plaza"))
end

local function viaPoints(routeId: string, g: Graph, count: number): ({ string }, CostFn, boolean)
	local city, highway = nodeTypes(g)
	local function cityOnly(e: Edge): number
		if e.Highway or e.Ramp then
			return math.huge
		end
		return e.Len
	end
	local function mixed(e: Edge): number
		if e.Highway then
			return e.Len * 0.6
		end
		return e.Len
	end
	local function highwayFirst(e: Edge): number
		if e.Highway then
			return e.Len * 0.25
		elseif e.Ramp then
			return e.Len * 0.6
		end
		return e.Len * 3
	end
	local isCity = function(n: Node): boolean
		return city[n.Id] == true
	end
	local isHighway = function(n: Node): boolean
		return highway[n.Id] == true
	end
	local hasHighway = next(highway) ~= nil
	-- étendue des rues de la ville
	local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
	for id, n in pairs(g.Nodes) do
		if city[id] then
			minX, maxX = math.min(minX, n.X), math.max(maxX, n.X)
			minZ, maxZ = math.min(minZ, n.Z), math.max(maxZ, n.Z)
		end
	end
	local via: { string } = {}
	-- (v10, LAYOUT10) repères nommés des courses : WorldLayout.RaceAnchors
	local anchors: { [string]: string } = {}
	local fnA = (WorldLayout :: any).RaceAnchors
	if type(fnA) == "function" and not g.Fallback then
		local ok, list = pcall(fnA, count)
		if ok and type(list) == "table" then
			for name, id in pairs(list) do
				if g.Nodes[tostring(id)] then
					anchors[name] = tostring(id)
				end
			end
		end
	end
	local function fromAnchors(names: { string }): { string }?
		local out = {}
		for _, name in ipairs(names) do
			local id = anchors[name]
			if not id then
				return nil
			end
			table.insert(out, id)
		end
		return out
	end
	if routeId == "City" then
		local list = fromAnchors({ "DowntownSE", "DowntownSW", "DowntownNW", "DowntownNE" })
		if list then
			return list, cityOnly, true
		end
	elseif routeId == "Highway" then
		-- rond-point de l'entrée -> avenue -> bretelle sud -> autoroute (ouest puis nord)
		local list = fromAnchors({ "EntranceLoop", "RampSCity", "HighwayW", "HighwayN" })
			or fromAnchors({ "EntranceBoulevard", "RampSCity", "HighwayW", "HighwayN" })
		if list then
			return list, highwayFirst, false
		end
	elseif routeId == "Night" then
		-- grand tour : rue du marché -> avenue d'entrée -> autoroute sud-ouest
		-- -> sortie ouest -> ceinture -> rue des chalets -> rue du marché
		local list = fromAnchors({ "MarketStreetW", "RampSCity", "HighwayW", "RampWCity", "BeltW" })
			or fromAnchors({ "EntranceBoulevard", "RampSCity", "HighwayW", "RampWCity", "BeltW", "DowntownSW" })
		if list then
			return list, mixed, true
		end
	elseif routeId == "Districts" then
		-- la rue principale de chaque quartier (sauf les quartiers fermés),
		-- dans l'ordre des angles, chaque rue prise d'un bout à l'autre
		local ds = {}
		for _, d in ipairs(districtList(count)) do
			local st = type(d.Streets) == "table" and d.Streets[1] or nil
			if isResidential(d) and d.Gated ~= true and type(st) == "table" and type(st.X0) == "number" then
				local cx, cz = boundsCenter(d.Bounds)
				if cx and cz then
					table.insert(ds, { St = st, A = math.atan2(cx, cz) })
				end
			end
		end
		table.sort(ds, function(a, b)
			return a.A < b.A
		end)
		if #ds >= 3 then
			local lastX, lastZ = 0, 0
			for i, d in ipairs(ds) do
				local st = d.St
				local a = nearestNode(g, st.X0, st.Z0, isCity)
				local b = nearestNode(g, st.X1, st.Z1, isCity)
				if a and b and a ~= b then
					local na, nb = g.Nodes[a], g.Nodes[b]
					local da = (na.X - lastX) ^ 2 + (na.Z - lastZ) ^ 2
					local db = (nb.X - lastX) ^ 2 + (nb.Z - lastZ) ^ 2
					if i == 1 then
						-- 1re rue : du bout le plus proche du centre vers l'extérieur
						da, db = na.X ^ 2 + na.Z ^ 2, nb.X ^ 2 + nb.Z ^ 2
					end
					if db < da then
						a, b, na, nb = b, a, nb, na
					end
					if via[#via] ~= a then
						table.insert(via, a)
					end
					table.insert(via, b)
					lastX, lastZ = nb.X, nb.Z
				end
			end
			if #via >= 4 then
				if via[#via] == via[1] then
					table.remove(via)
				end
				return via, cityOnly, true
			end
			via = {}
		end
	end
	local function addVia(x: number, z: number, filter: ((Node) -> boolean)?)
		local id = nearestNode(g, x, z, filter)
		if id and via[#via] ~= id and via[1] ~= id then
			table.insert(via, id)
		end
	end
	if routeId == "City" then
		-- coins du centre-ville (quartier "Downtown") ; sinon 55 % de l'étendue
		local cx, cz, sx, sz = 0, 0, (maxX - minX) * 0.55, (maxZ - minZ) * 0.55
		for _, d in ipairs(districtList(count)) do
			if not isResidential(d) then
				local x, z, w, h = boundsCenter(d.Bounds)
				if x and z and w and h then
					cx, cz, sx, sz = x, z, w, h
				end
			end
		end
		for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } }) do
			addVia(cx + c[1] * sx / 2, cz + c[2] * sz / 2, isCity)
		end
		return via, cityOnly, true
	elseif routeId == "Districts" then
		local centers = {}
		for _, d in ipairs(districtList(count)) do
			if isResidential(d) then
				local x, z = boundsCenter(d.Bounds)
				if x and z then
					table.insert(centers, { x, z, math.atan2(x, z) })
				end
			end
		end
		if #centers < 3 then
			-- secours : 6 directions à 80 % de l'étendue
			centers = {}
			for k = 0, 5 do
				local a = k / 6 * math.pi * 2 + 0.3
				table.insert(centers, { math.sin(a) * (maxX - minX) * 0.4, math.cos(a) * (maxZ - minZ) * 0.4, a })
			end
		end
		table.sort(centers, function(a, b)
			return a[3] < b[3]
		end)
		for _, c in ipairs(centers) do
			addVia(c[1], c[2], isCity)
		end
		return via, cityOnly, true
	elseif routeId == "Highway" then
		-- sprint : de l'extrémité "nord-ouest" à l'extrémité "sud-est" de l'autoroute
		local hp = (WorldLayout :: any).HighwayPath
		if hasHighway then
			local pts = nil
			if type(hp) == "function" then
				local ok, list = pcall(hp, count)
				if ok and type(list) == "table" and #list >= 2 then
					pts = list
				end
			end
			if pts then
				local n = #pts
				local ax, az = readPoint(pts[1])
				local bx, bz = readPoint(pts[math.max(2, math.floor(n * 0.62))])
				if ax and az and bx and bz then
					addVia(ax, az, isHighway)
					addVia(bx, bz, isHighway)
				end
			end
			if #via < 2 then
				via = {}
				addVia(minX - 1e4, minZ - 1e4, isHighway)
				addVia(maxX + 1e4, maxZ + 1e4, isHighway)
			end
			return via, highwayFirst, false
		end
		-- pas d'autoroute (secours) : les 2/3 du boulevard
		addVia(maxX, 0, isCity)
		addVia(0, maxZ, isCity)
		addVia(minX, 0, isCity)
		return via, cityOnly, false
	else -- Night : grand tour (autoroute permise)
		addVia(0, minZ - 1e4)
		addVia(maxX + 1e4, 0)
		addVia(0, maxZ + 1e4)
		addVia(minX - 1e4, 0)
		return via, if hasHighway then mixed else cityOnly, true
	end
end

local function buildRoute(routeId: string, count: number): any?
	local def = Config.RaceRoutesById and Config.RaceRoutesById[routeId]
	if not def then
		return nil
	end
	local g = RaceRoutes.Graph(count)
	local via, cost, closed = viaPoints(routeId, g, count)
	if #via < 2 or (closed and #via < 3) then
		return nil
	end
	local points, keys, minWidth = chain(g, via, closed, cost)
	if not points or #points < 3 then
		return nil
	end
	if closed then
		-- le dernier point rejoint le premier : retiré
		local n = #points
		if n > 1 and (points[n][1] - points[1][1]) ^ 2 + (points[n][2] - points[1][2]) ^ 2 < 0.25 then
			table.remove(points)
		end
	end
	local width = if minWidth < math.huge then minWidth else 16
	points = despike(points, closed)
	-- (les virages de l'autoroute sont déjà des arcs dans le graphe)
	local radius = math.clamp(width * 0.9, 12, 22)
	local filleted = RaceRules.Fillet(points, closed, radius, 3)
	local line = RaceRules.Resample(RaceRules.Line(filleted, closed), RaceRoutes.STEP)
	if line.Total < 300 then
		return nil
	end
	local route: any = {
		Id = routeId,
		Def = def,
		Closed = closed,
		Laps = if closed then math.max(1, def.Laps or 1) else 1,
		Width = width,
		EdgeKeys = keys,
		Nodes = via,
		Fallback = g.Fallback,
	}
	if closed then
		-- départ : sur une ligne droite, le plus près du point de rendez-vous
		local mx, mz = RaceRoutes.MeetPoint(count)
		local bestS, bestScore = 0, math.huge
		local s = 0
		while s < line.Total do
			local change = headingChange(line, s - RaceRoutes.STRAIGHT_BEFORE, s + 30)
			if change < math.rad(7) then
				local x, z = RaceRules.PointAt(line, s)
				local score = (x - mx) ^ 2 + (z - mz) ^ 2
				if score < bestScore then
					bestS, bestScore = s, score
				end
			end
			s += 8
		end
		line = rotateLoop(line, bestS)
		route.Line = line
		route.StartS = 0
		route.Total = line.Total
		route.RaceDistance = line.Total * route.Laps
	else
		route.Line = line
		route.StartS = math.min(RaceRoutes.SPRINT_GRID + 20, line.Total * 0.2)
		route.Total = line.Total
		route.RaceDistance = line.Total - route.StartS
	end
	withCheckpoints(route)
	withGrid(route)
	return route
end

function RaceRoutes.Get(routeId: string, count: number): any?
	local c = cacheFor(count)
	local r = c.Routes[routeId]
	if r == nil then
		local ok, built = pcall(buildRoute, routeId, count)
		if not ok then
			warn("[RaceRoutes] " .. routeId .. " : " .. tostring(built))
			built = nil
		end
		r = built or false
		c.Routes[routeId] = r
	end
	return if r then r else nil
end

function RaceRoutes.All(count: number): { any }
	local list = {}
	for _, def in ipairs((Config.Race and Config.Race.Routes) or {}) do
		local r = RaceRoutes.Get(def.Id, count)
		if r then
			table.insert(list, r)
		end
	end
	return list
end

----------------------------------------------------------------------
-- Point de rendez-vous (QG des courses)
----------------------------------------------------------------------

-- Zone "RaceMeet" réservée par LAYOUT10 (WorldLayout.Facilities / Facility),
-- sinon à côté de la porte de la ville. -> x, z (repère du centre), cap (radians,
-- 0 = regard vers -Z)
function RaceRoutes.MeetPoint(count: number): (number, number, number)
	local W: any = WorldLayout
	local zone = nil
	if type(W.Facility) == "function" then
		-- (v10, LAYOUT10) WorldLayout.Facility(count, id) -> Zone { X, Z, W, D, Yaw, Y }
		local ok, z = pcall(W.Facility, count, "RaceMeet")
		if ok and type(z) == "table" then
			zone = z
		end
	end
	if zone == nil then
		for _, name in ipairs({ "Facilities", "FacilityZones", "Reserved", "Zones" }) do
			if zone == nil and type(W[name]) == "function" then
				local ok, list = pcall(W[name], count)
				if ok and type(list) == "table" then
					for key, z in pairs(list) do
						if type(z) == "table" and (z.Id == "RaceMeet" or key == "RaceMeet") then
							zone = z
						end
					end
				end
			end
		end
	end
	if type(zone) == "table" or typeof(zone) == "CFrame" then
		local cf = if typeof(zone) == "CFrame" then zone else zone.CFrame
		if typeof(cf) == "CFrame" then
			local ox, _, oz = origin()
			local look = cf.LookVector
			return cf.Position.X - ox, cf.Position.Z - oz, math.atan2(-look.X, -look.Z)
		end
		local x, z = readPoint(zone.Center or zone.Position or zone)
		if x and z then
			return x, z, finite(zone.Yaw or zone.Heading or zone.Angle, 0)
		end
	end
	-- secours : devant la porte, côté gauche de l'avenue (regard vers l'avenue)
	local gate = WorldLayout.GateDistance(count)
	return -44, gate - 40, -math.pi / 2
end

----------------------------------------------------------------------
-- Repères du monde (jeu)
----------------------------------------------------------------------

function RaceRoutes.ToWorld(x: number, z: number, y: number?): Vector3
	local ox, oy, oz = origin()
	return Vector3.new(ox + x, oy + (y or WorldLayout.ROAD_Y), oz + z)
end

function RaceRoutes.MeetCFrame(count: number): CFrame
	local x, z, heading = RaceRoutes.MeetPoint(count)
	local p = RaceRoutes.ToWorld(x, z, WorldLayout.WALK_Y)
	return CFrame.new(p) * CFrame.Angles(0, heading, 0)
end

-- Place `slot` de la grille (pivot au sol, avant = -Z du CFrame = sens de la course)
function RaceRoutes.GridCFrame(route: any, slot: number): CFrame
	local g = route.Grid[math.clamp(slot, 1, #route.Grid)]
	local _, _, _, _, y = RaceRules.PointAt(route.Line, route.StartS - g.Back)
	local p = RaceRoutes.ToWorld(g.X, g.Z, y ~= 0 and y or nil)
	return CFrame.lookAt(p, p + Vector3.new(g.TX, 0, g.TZ))
end

-- CFrame (monde) d'une distance de course d (porte, remise sur la route) ;
-- lateral = décalage à droite
function RaceRoutes.CFrameAtD(route: any, d: number, lateral: number?): CFrame
	local s = if route.Closed then d else route.StartS + d
	local x, z, tx, tz, y = RaceRules.PointAt(route.Line, s)
	local side = lateral or 0
	local p = RaceRoutes.ToWorld(x - tz * side, z + tx * side, y ~= 0 and y or nil)
	return CFrame.lookAt(p, p + Vector3.new(tx, 0, tz))
end

----------------------------------------------------------------------
-- Circulation pendant une course (TownTraffic)
----------------------------------------------------------------------

local function activeIds(): { string }
	local ids = {}
	local ok, value = pcall(function()
		return workspace:GetAttribute(RaceRoutes.ACTIVE_ATTRIBUTE)
	end)
	if ok and type(value) == "string" and value ~= "" then
		for id in string.gmatch(value, "[^,]+") do
			if Config.RaceRoutesById[id] then
				table.insert(ids, id)
			end
		end
	end
	return ids
end
RaceRoutes.ActiveIds = activeIds

-- Arêtes du graphe prises par les courses en cours ("a|b", les deux sens)
function RaceRoutes.BlockedEdgeKeys(count: number): { [string]: boolean }
	local out = {}
	for _, id in ipairs(activeIds()) do
		local r = RaceRoutes.Get(id, count)
		if r then
			for key in pairs(r.EdgeKeys) do
				out[key] = true
				local a, b = string.match(key, "^(.-)|(.*)$")
				if a and b then
					out[b .. "|" .. a] = true
				end
			end
		end
	end
	return out
end

-- Position (monde) à moins de `margin` studs d'un parcours en course ?
function RaceRoutes.IsNearActiveRoute(position: Vector3, margin: number?, count: number?): boolean
	local ids = activeIds()
	if #ids == 0 then
		return false
	end
	local n = count or WorldLayout.PlotCount(game:GetService("Players").MaxPlayers)
	local ox, _, oz = origin()
	for _, id in ipairs(ids) do
		local r = RaceRoutes.Get(id, n)
		if r then
			local _, lat, dist = RaceRules.Project(r.Line, position.X - ox, position.Z - oz)
			local _ = lat
			if dist <= r.Width / 2 + (margin or 6) then
				return true
			end
		end
	end
	return false
end

return RaceRoutes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="348">
        <Properties>
          <string name="Name">RaceRules</string>
          <string name="Source"><![CDATA[--[[
	RaceRules (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > RaceRules

	🏁 Règles PURES des courses de rue (v10, RACE10) : aucune Instance,
	aucun service, seulement Config. Partagé par le serveur (RaceService),
	le client (RaceClient) et les tests (tests/run_tests.py).
	  - lignes brisées en nombres (X / Z / S cumulée) : point à une
	    distance, projection d'une position, rééchantillonnage, virages
	    arrondis (congés) ;
	  - profil de vitesse de la trajectoire (virages -> vitesse max,
	    freinage anticipé) et pas de simulation d'un pilote IA, élastique
	    "juste" (léger, jamais au-delà de la vitesse de pointe, coupé dans le
	    final) ;
	  - classement, récompenses (secondes de production selon la place,
	    adversaires humains, plafond quotidien), données sauvegardées ;
	  - contrôles anti-triche (vitesse plausible, saut, temps minimal d'un
	    tronçon).

	Ligne : { X = { number }, Z = { number }, Y = { number }?, S = { number },
	          N = number, Total = number, Closed = boolean }
	  S[i] = distance cumulée au point i ; boucle (Closed) : le segment N -> 1
	  compte dans Total.
]]

local Config = require(script.Parent.Config)

local RaceRules = {}

export type Line = {
	X: { number },
	Z: { number },
	Y: { number }?,
	S: { number },
	N: number,
	Total: number,
	Closed: boolean,
}

local function finite(value: any, default: number): number
	if type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge then
		return value
	end
	return default
end
RaceRules.Finite = finite

local function cfg(): any
	return Config.Race or {}
end

----------------------------------------------------------------------
-- Lignes brisées
----------------------------------------------------------------------

-- points = { { x, z, y? } } (tableaux) -> Ligne. Les points en double sont retirés.
function RaceRules.Line(points: { { number } }, closed: boolean?): Line
	local X, Z, Y, S = {}, {}, {}, {}
	local total = 0
	for _, p in ipairs(points) do
		local x, z = finite(p[1], 0), finite(p[2], 0)
		local n = #X
		if n == 0 or (x - X[n]) ^ 2 + (z - Z[n]) ^ 2 > 1e-6 then
			if n > 0 then
				total += math.sqrt((x - X[n]) ^ 2 + (z - Z[n]) ^ 2)
			end
			table.insert(X, x)
			table.insert(Z, z)
			table.insert(Y, finite(p[3], 0))
			table.insert(S, total)
		end
	end
	local n = #X
	local isClosed = closed == true and n >= 3
	if isClosed and (X[1] - X[n]) ^ 2 + (Z[1] - Z[n]) ^ 2 < 1e-6 then
		-- dernier point = premier : retiré (la boucle se ferme toute seule)
		table.remove(X)
		table.remove(Z)
		table.remove(Y)
		table.remove(S)
		n -= 1
	end
	if isClosed then
		total = S[n] + math.sqrt((X[1] - X[n]) ^ 2 + (Z[1] - Z[n]) ^ 2)
	else
		total = S[n] or 0
	end
	return { X = X, Z = Z, Y = Y, S = S, N = n, Total = total, Closed = isClosed }
end

-- Distance ramenée dans la ligne (boucle : modulo ; sinon bornée)
function RaceRules.Wrap(line: Line, s: number): number
	if line.Total <= 0 then
		return 0
	end
	if line.Closed then
		return s % line.Total
	end
	return math.clamp(s, 0, line.Total)
end

-- Index i du segment [i, i+1] qui contient s (déjà ramené)
local function segmentAt(line: Line, s: number): number
	local S = line.S
	local lo, hi = 1, line.N
	while lo < hi do
		local mid = (lo + hi + 1) // 2
		if S[mid] <= s then
			lo = mid
		else
			hi = mid - 1
		end
	end
	if not line.Closed and lo >= line.N then
		lo = math.max(1, line.N - 1)
	end
	return lo
end

local function nextIndex(line: Line, i: number): number
	if i >= line.N then
		return if line.Closed then 1 else line.N
	end
	return i + 1
end

local function segEnd(line: Line, i: number): number
	if i >= line.N then
		return line.Total
	end
	return line.S[i + 1]
end

-- Point à la distance s : x, z, tangente (tx, tz unitaire), y
function RaceRules.PointAt(line: Line, s: number): (number, number, number, number, number)
	local n = line.N
	if n == 0 then
		return 0, 0, 0, -1, 0
	end
	if n == 1 then
		return line.X[1], line.Z[1], 0, -1, (line.Y and line.Y[1]) or 0
	end
	local w = RaceRules.Wrap(line, s)
	local i = segmentAt(line, w)
	local j = nextIndex(line, i)
	local s0, s1 = line.S[i], segEnd(line, i)
	local len = math.max(1e-6, s1 - s0)
	local t = math.clamp((w - s0) / len, 0, 1)
	local dx, dz = line.X[j] - line.X[i], line.Z[j] - line.Z[i]
	local d = math.max(1e-6, math.sqrt(dx * dx + dz * dz))
	local Y = line.Y
	local y = if Y then Y[i] + (Y[j] - Y[i]) * t else 0
	return line.X[i] + dx * t, line.Z[i] + dz * t, dx / d, dz / d, y
end

-- Projection de (x, z) sur la ligne. hint (distance attendue) + window :
-- on ne cherche que dans [hint - window, hint + window] (boucle : modulo).
-- -> s, décalage latéral (positif = à DROITE du sens de la course), distance
function RaceRules.Project(line: Line, x: number, z: number, hint: number?, window: number?): (number, number, number)
	local n = line.N
	if n < 2 then
		return 0, 0, if n == 1 then math.sqrt((x - line.X[1]) ^ 2 + (z - line.Z[1]) ^ 2) else 0
	end
	local segCount = if line.Closed then n else n - 1
	local first, count = 1, segCount
	if hint ~= nil and window ~= nil and window * 2 < line.Total then
		local from = RaceRules.Wrap(line, hint - window)
		if not line.Closed then
			from = math.max(0, hint - window)
		end
		first = segmentAt(line, from)
		-- nombre de segments couverts par la fenêtre (au moins 2)
		local k, covered, i = 0, 0, first
		while covered < window * 2 + (segEnd(line, first) - line.S[first]) and k < segCount do
			covered += segEnd(line, i) - line.S[i]
			k += 1
			i = if i >= segCount then 1 else i + 1
			if not line.Closed and i == 1 then
				break
			end
		end
		count = math.max(2, k)
	end
	local bestD2, bestS, bestLat = math.huge, 0, 0
	local i = first
	for _ = 1, count do
		local j = nextIndex(line, i)
		local ax, az = line.X[i], line.Z[i]
		local dx, dz = line.X[j] - ax, line.Z[j] - az
		local len2 = dx * dx + dz * dz
		local t = if len2 > 1e-9 then math.clamp(((x - ax) * dx + (z - az) * dz) / len2, 0, 1) else 0
		local qx, qz = ax + dx * t, az + dz * t
		local d2 = (x - qx) ^ 2 + (z - qz) ^ 2
		if d2 < bestD2 then
			bestD2 = d2
			local len = math.sqrt(math.max(len2, 1e-12))
			bestS = line.S[i] + t * len
			-- droite = (-tz, tx)
			bestLat = ((x - qx) * (-dz) + (z - qz) * dx) / len
		end
		i = if i >= segCount then 1 else i + 1
		if not line.Closed and i > segCount then
			break
		end
	end
	return bestS, bestLat, math.sqrt(bestD2)
end

-- Rééchantillonne à pas constant (~step studs), y compris le segment de fermeture
function RaceRules.Resample(line: Line, step: number): Line
	local total = line.Total
	if total <= 0 or line.N < 2 then
		return line
	end
	local count = math.max(2, math.floor(total / math.max(0.5, step) + 0.5))
	local pts = {}
	local last = if line.Closed then count - 1 else count
	for k = 0, last do
		local s = total * k / count
		local x, z, _, _, y = RaceRules.PointAt(line, s)
		table.insert(pts, { x, z, y })
	end
	return RaceRules.Line(pts, line.Closed)
end

-- Virages arrondis : chaque angle devient un arc de rayon `radius` (réduit si
-- les segments voisins sont trop courts). points = { { x, z, y? } }
function RaceRules.Fillet(points: { { number } }, closed: boolean, radius: number, arcStep: number?): { { number } }
	local n = #points
	if n < 3 then
		return points
	end
	local stepLen = arcStep or 4
	local out = {}
	local function at(i: number): { number }
		if closed then
			return points[((i - 1) % n) + 1]
		end
		return points[math.clamp(i, 1, n)]
	end
	for i = 1, n do
		local p = at(i)
		if not closed and (i == 1 or i == n) then
			table.insert(out, p)
			continue
		end
		local a, c = at(i - 1), at(i + 1)
		local ux, uz = p[1] - a[1], p[2] - a[2]
		local vx, vz = c[1] - p[1], c[2] - p[2]
		local lu, lv = math.sqrt(ux * ux + uz * uz), math.sqrt(vx * vx + vz * vz)
		if lu < 1e-6 or lv < 1e-6 then
			table.insert(out, p)
			continue
		end
		ux, uz, vx, vz = ux / lu, uz / lu, vx / lv, vz / lv
		local cosT = math.clamp(ux * vx + uz * vz, -1, 1)
		local theta = math.acos(cosT) -- angle de braquage (0 = tout droit)
		if theta < math.rad(4) then
			table.insert(out, p)
			continue
		end
		-- longueur des tangentes : r tan(θ/2), au plus 45 % des segments voisins
		local r = radius
		local tanHalf = math.tan(theta / 2)
		local t = r * tanHalf
		local limit = 0.45 * math.min(lu, lv)
		if t > limit then
			t = limit
			r = t / math.max(tanHalf, 1e-6)
		end
		local p0x, p0z = p[1] - ux * t, p[2] - uz * t
		local py = p[3] or 0
		local cross = ux * vz - uz * vx -- signe du virage
		-- centre de l'arc : perpendiculaire à u, côté intérieur
		local nx, nz = -uz, ux
		if cross < 0 then
			nx, nz = uz, -ux
		end
		local cx, cz = p0x + nx * r, p0z + nz * r
		local a0 = math.atan2(p0z - cz, p0x - cx)
		local sweep = if cross >= 0 then theta else -theta
		local steps = math.max(2, math.ceil(math.abs(sweep) * r / stepLen))
		for k = 0, steps do
			local ang = a0 + sweep * k / steps
			table.insert(out, { cx + math.cos(ang) * r, cz + math.sin(ang) * r, py })
		end
	end
	return out
end

-- Rayon de courbure au point i (points i-k, i, i+k ; ligne rééchantillonnée)
local function radiusAt(line: Line, i: number, k: number): number
	local n = line.N
	local function idx(j: number): number
		if line.Closed then
			return ((j - 1) % n) + 1
		end
		return math.clamp(j, 1, n)
	end
	local a, b, c = idx(i - k), idx(i), idx(i + k)
	if a == b or b == c then
		return math.huge
	end
	local ax, az = line.X[a], line.Z[a]
	local bx, bz = line.X[b], line.Z[b]
	local cx, cz = line.X[c], line.Z[c]
	local ab = math.sqrt((bx - ax) ^ 2 + (bz - az) ^ 2)
	local bc = math.sqrt((cx - bx) ^ 2 + (cz - bz) ^ 2)
	local ca = math.sqrt((ax - cx) ^ 2 + (az - cz) ^ 2)
	local area2 = math.abs((bx - ax) * (cz - az) - (bz - az) * (cx - ax))
	if area2 < 1e-6 then
		return math.huge
	end
	return ab * bc * ca / (2 * area2)
end
RaceRules.RadiusAt = radiusAt

-- Profil de vitesse (studs/s) à chaque point d'une ligne RÉÉCHANTILLONNÉE :
-- min(vmax, √(latAcc × R)), puis freinage anticipé (décélération `brake`).
function RaceRules.SpeedProfile(line: Line, vmax: number, latAcc: number?, brake: number?): { number }
	local ai = cfg().AI or {}
	local lat = latAcc or ai.LatAccel or 30
	local dec = brake or ai.Brake or 38
	local n = line.N
	local v = table.create(n, vmax)
	local step = if n > 1 then line.Total / (if line.Closed then n else n - 1) else 4
	local k = math.max(1, math.floor(10 / math.max(step, 0.5) + 0.5))
	for i = 1, n do
		local r = radiusAt(line, i, k)
		v[i] = math.min(vmax, math.sqrt(lat * r))
	end
	-- freinage : on parcourt la ligne à l'envers (2 tours pour une boucle)
	local passes = if line.Closed then 2 else 1
	for _ = 1, passes do
		for i = n - 1, 1, -1 do
			local ds = line.S[i + 1] - line.S[i]
			v[i] = math.min(v[i], math.sqrt(v[i + 1] ^ 2 + 2 * dec * ds))
		end
		if line.Closed and n > 1 then
			local ds = line.Total - line.S[n]
			v[n] = math.min(v[n], math.sqrt(v[1] ^ 2 + 2 * dec * ds))
		end
	end
	return v
end

-- Vitesse du profil à la distance s (interpolée)
function RaceRules.ProfileAt(line: Line, profile: { number }, s: number): number
	if line.N == 0 then
		return 0
	end
	local w = RaceRules.Wrap(line, s)
	local i = segmentAt(line, w)
	local j = nextIndex(line, i)
	local s0, s1 = line.S[i], segEnd(line, i)
	local t = math.clamp((w - s0) / math.max(1e-6, s1 - s0), 0, 1)
	return (profile[i] or 0) + ((profile[j] or 0) - (profile[i] or 0)) * t
end

----------------------------------------------------------------------
-- Pilotes IA
----------------------------------------------------------------------

-- Multiplicateur "élastique" de la vitesse visée d'une IA (juste : léger,
-- coupé dans le final). aiD = distance parcourue par l'IA, leadD = distance
-- du 1er HUMAIN, total = distance de la course.
function RaceRules.RubberBand(aiD: number, leadD: number?, total: number): number
	local ai = cfg().AI or {}
	if leadD == nil or total <= 0 then
		return 1
	end
	if aiD >= total * (1 - (ai.FairFinish or 0.12)) then
		return 1
	end
	local range = ai.RubberRange or 500
	local gap = leadD - aiD
	if gap > 0 then
		return 1 + (ai.RubberBoost or 0.06) * math.clamp(gap / range, 0, 1)
	end
	return 1 - (ai.RubberSlow or 0.1) * math.clamp(-gap / range, 0, 1)
end

-- Un pas de pilote IA : state = { D, V } ; target = vitesse visée (profil x
-- habileté x élastique), top = vitesse de pointe de SA voiture, accel =
-- accélération au départ (modèle de CarClient : a × (1 − 0,55 (v / top)²)).
function RaceRules.AIStep(state: { D: number, V: number }, dt: number, target: number, top: number, accel: number, brake: number?)
	local goal = math.clamp(target, 0, top)
	local v = state.V
	if v < goal then
		local a = accel * (1 - 0.55 * math.clamp(v / math.max(top, 1), 0, 1) ^ 2)
		v = math.min(goal, v + a * dt)
	else
		v = math.max(goal, v - (brake or 40) * dt)
	end
	state.V = v
	state.D += v * dt
end

----------------------------------------------------------------------
-- Classement
----------------------------------------------------------------------

-- racers = { { Finished, FinishTime, Progress, Dnf } } -> nouvelle liste triée
-- (arrivés par temps, puis en course par distance, abandons à la fin)
function RaceRules.Standings(racers: { any }): { any }
	local list = table.clone(racers)
	table.sort(list, function(a, b)
		local ra = if a.Dnf then 3 elseif a.Finished then 1 else 2
		local rb = if b.Dnf then 3 elseif b.Finished then 1 else 2
		if ra ~= rb then
			return ra < rb
		end
		if ra == 1 then
			local ta, tb = finite(a.FinishTime, math.huge), finite(b.FinishTime, math.huge)
			if ta ~= tb then
				return ta < tb
			end
		end
		local pa, pb = finite(a.Progress, 0), finite(b.Progress, 0)
		if pa ~= pb then
			return pa > pb
		end
		return tostring(a.Key or a.Name or "") < tostring(b.Key or b.Name or "")
	end)
	return list
end

-- Temps lisible : 1:02.35
function RaceRules.FormatTime(seconds: number?): string
	local s = finite(seconds, 0)
	if s < 0 then
		s = 0
	end
	local m = math.floor(s / 60)
	local rest = s - m * 60
	return string.format("%d:%05.2f", m, math.floor(rest * 100) / 100)
end

----------------------------------------------------------------------
-- Récompenses
----------------------------------------------------------------------

-- Secondes de production gagnées : place (1..), arrivé ?, nombre
-- d'adversaires HUMAINS. 0 si pas arrivé.
function RaceRules.RewardSeconds(place: number, finished: boolean, humanOpponents: number): number
	local r = cfg().Rewards or {}
	if not finished then
		return 0
	end
	local list = r.Seconds or { 120, 80, 55 }
	local base = list[place] or r.FinishSeconds or 35
	local opp = math.max(0, math.floor(finite(humanOpponents, 0)))
	local factor
	if opp == 0 then
		factor = r.SoloFactor or 0.75
	else
		factor = 1 + math.min(r.MaxHumanBonus or 0.3, (r.HumanBonus or 0.1) * opp)
	end
	return base * factor
end

-- Récompense en Dopamine (stats = Formulas.ComputeStats / GameService:GetStats).
-- rewardedToday = courses déjà payées aujourd'hui. -> (montant, secondes, plafonné?)
function RaceRules.Reward(stats: any, place: number, finished: boolean, humanOpponents: number, rewardedToday: number?): (number, number, boolean)
	local r = cfg().Rewards or {}
	local seconds = RaceRules.RewardSeconds(place, finished, humanOpponents)
	if seconds <= 0 then
		return 0, 0, false
	end
	if finite(rewardedToday, 0) >= (r.DailyRewarded or 8) then
		return 0, 0, true
	end
	local perSecond = finite(stats and stats.PerSecond, 0)
	local click = finite(stats and stats.ClickValue, 0)
	local cps = (Config.Rewards and Config.Rewards.EstimatedClicksPerSecond) or 3
	local production = math.max(0, perSecond + click * cps)
	local amount = math.floor(math.max(r.MinReward or 250, production * seconds))
	return amount, seconds, false
end

-- Gain net maximal (multiplicateur moyen de la production) pour un joueur
-- qui gagne toutes ses courses payées d'une journée de `sessionHours` h de
-- jeu (défaut 2 h) : borne utilisée par le test d'économie.
function RaceRules.MaxNetMultiplier(sessionHours: number?): number
	local r = cfg().Rewards or {}
	local best = ((r.Seconds or { 120 })[1] or 120) * (1 + (r.MaxHumanBonus or 0.3))
	local perDay = best * (r.DailyRewarded or 8)
	local hours = math.max(1, finite(sessionHours, 2))
	return 1 + perDay / (hours * 3600)
end

-- Jour (UTC) pour le plafond quotidien
function RaceRules.Today(now: number): number
	return math.floor(finite(now, 0) / 86400)
end

-- data.Race propre : { Day, Rewarded, Races, Wins, Podiums, Best = { [routeId] = s } }
function RaceRules.SanitizeData(raw: any, today: number): any
	local src = if type(raw) == "table" then raw else {}
	local function count(v: any): number
		return math.max(0, math.floor(finite(v, 0)))
	end
	local best = {}
	if type(src.Best) == "table" then
		for id, value in pairs(src.Best) do
			local t = finite(value, -1)
			if type(id) == "string" and Config.RaceRoutesById and Config.RaceRoutesById[id] and t >= 3 and t < 3600 then
				best[id] = t
			end
		end
	end
	local day = count(src.Day)
	local rewarded = count(src.Rewarded)
	if day ~= today then
		day = today
		rewarded = 0
	end
	return {
		Day = day,
		Rewarded = rewarded,
		Races = count(src.Races),
		Wins = count(src.Wins),
		Podiums = count(src.Podiums),
		Best = best,
	}
end

----------------------------------------------------------------------
-- Anti-triche
----------------------------------------------------------------------

-- Vitesse mesurée plausible ? dist (studs) parcourue en dt (s, fenêtre ~1 s),
-- top = vitesse de pointe de la voiture. -> "ok" | "fast" | "teleport"
function RaceRules.CheckMove(dist: number, dt: number, top: number): string
	local anti = cfg().Anti or {}
	local limit = finite(top, 60) * (anti.SpeedMargin or 1.3) + (anti.AbsSlack or 8)
	local d = finite(dist, 0)
	local t = math.max(finite(dt, 0), 0.05)
	if d > math.max(anti.TeleportStuds or 70, limit * t * 2.5) then
		return "teleport"
	end
	if t >= 0.5 and d / t > limit then
		return "fast"
	end
	return "ok"
end

-- Temps minimal (s) pour un tronçon de `length` studs
function RaceRules.MinSegmentTime(length: number, top: number): number
	local anti = cfg().Anti or {}
	return math.max(0, finite(length, 0)) / math.max(1, finite(top, 60) * (anti.SegmentFactor or 1.15))
end

return RaceRules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="349">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[--[[
	Signal (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > Signal

	Petit système d'événements (comme un BindableEvent, mais sans copier les
	tables passées en argument). Utilisé côté client pour prévenir l'interface
	qu'un nouvel état est arrivé.
]]

local Signal = {}
Signal.__index = Signal

export type Connection = { Disconnect: (self: Connection) -> () }

function Signal.new()
	return setmetatable({ _listeners = {} }, Signal)
end

-- Ajoute une fonction appelée à chaque :Fire(...)
function Signal:Connect(callback: (...any) -> ())
	local listeners = self._listeners
	local entry = { Callback = callback }
	table.insert(listeners, entry)

	return {
		Disconnect = function()
			local index = table.find(listeners, entry)
			if index then
				table.remove(listeners, index)
			end
		end,
	}
end

-- Appelle toutes les fonctions connectées (chacune dans son propre thread)
function Signal:Fire(...)
	for _, entry in ipairs(table.clone(self._listeners)) do
		task.spawn(entry.Callback, ...)
	end
end

return Signal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="350">
        <Properties>
          <string name="Name">VehicleModels</string>
          <string name="Source"><![CDATA[--[[
	VehicleModels (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > VehicleModels

	🚌 Les autres véhicules de Dopamine Town (v9.7, VEHICLES97), construits
	en pièces : utilisé par le SERVEUR (décor fixe : TownVehicles, TownKit)
	ET par le CLIENT (circulation d'ambiance : TownTraffic). Pur : que des
	Instances, aucun service, aucune lumière, aucun Neon, aucun son.

	  Bus(opts)          : vrai bus de ville (12 m) : face avant arrondie,
	                       grand pare-brise, girouette "DOPAMINE TOWN",
	                       2 portes doubles vitrées, vitres + sièges visibles,
	                       barres jaunes, roues dans leurs passages, rétros
	                       "oreilles de lapin", livrée blanche / rose ;
	  Bike(opts)         : vélo (cadre en losange, 2 roues à jante + rayons,
	                       guidon, selle, pédalier, garde-chaîne, garde-boue,
	                       porte-bagages / panier) ; Kind = "City" | "Sport" |
	                       "Kid" (petites roues + stabilisateurs) ;
	  KickScooter(opts)  : trottinette électrique ;
	  Scooter(opts)      : scooter (type Vespa) ;
	  BikeRack(opts)     : arceaux inox (vélos garés entre les arceaux) ;
	  DeliveryVan(opts)  : camion de livraison "📦 Dopa Express" ;
	  FoodTruck(opts)    : food truck "🌮 Taco Party" (passe-plat, auvent,
	                       menu, taco géant sur le toit).
	Repère de chaque modèle : pivot = centre du DESSOUS (au sol), avant vers
	-Z. PrimaryPart "Root" invisible (boîte englobante ; CanCollide selon
	opts.Solid). Attributs : Kind, Length, Width, Height, PartCount.
	opts communs : Detail = "Full" | "Light" (circulation : moins de
	pièces), Color (couleur principale), Solid (bool).
	Textes : clé anglaise en attribut "LocText" (TownClient la traduit) ;
	opts.T = fonction de traduction (client) pour les modèles hors ville.
]]

local VehicleModels = {}

local M = Enum.Material
local PI = math.pi

-- Couleurs
local WHITE = Color3.fromRGB(248, 247, 250)
local PINK = Color3.fromRGB(255, 118, 172)
local LILAC = Color3.fromRGB(186, 150, 246)
local TRIM = Color3.fromRGB(40, 40, 50)
local TYRE = Color3.fromRGB(32, 32, 38)
local STEEL = Color3.fromRGB(200, 204, 212)
local CHROME = Color3.fromRGB(222, 226, 232)
local GLASS = Color3.fromRGB(70, 96, 124)
local GLASS_DARK = Color3.fromRGB(46, 58, 76)
local LAMP = Color3.fromRGB(255, 250, 228)
local DRL = Color3.fromRGB(255, 252, 240)
local TAIL = Color3.fromRGB(214, 36, 56)
local AMBER = Color3.fromRGB(255, 170, 60)
local POLE = Color3.fromRGB(255, 206, 64)
local FLOOR = Color3.fromRGB(96, 98, 110)
local SEAT = Color3.fromRGB(168, 96, 170)
local SEAT_BACK = Color3.fromRGB(120, 72, 140)
local LED = Color3.fromRGB(255, 184, 64)

----------------------------------------------------------------------
-- Petit kit (repère local du modèle ; tout ancré, décor sans collision)
----------------------------------------------------------------------

type K = {
	Model: Model,
	Count: number,
	T: (string) -> string,
	WheelTag: number?, -- (v9.9) pièces de la roue n° (animation : TownTraffic / CarModels.WheelRig)
	Spin: boolean?, -- (v9.9) la pièce tourne avec la roue
	Door: number?, -- (v9.9) battant de porte (bus) : n° de porte
	Leaf: number?, -- (v9.9) sens d'ouverture du battant le long de z (-1 / 1)
}

local function newKit(name: string, opts: any): K
	local model = Instance.new("Model")
	model.Name = name
	local translate = type(opts) == "table" and type(opts.T) == "function" and opts.T or function(s: string): string
		return s
	end
	return { Model = model, Count = 0, T = translate }
end

local function newPart(k: K, className: string, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shadow: boolean?): BasePart
	local p = Instance.new(className :: any) :: BasePart
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = shadow == true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = Vector3.new(math.max(0.05, size.X), math.max(0.05, size.Y), math.max(0.05, size.Z))
	p.CFrame = cf
	p.Color = color
	p.Material = material or M.SmoothPlastic
	if k.WheelTag then
		p:SetAttribute("Wheel", k.WheelTag)
		if k.Spin then
			p:SetAttribute("Spin", true)
		end
	end
	if k.Door then
		p:SetAttribute("Door", k.Door)
		p:SetAttribute("Leaf", k.Leaf or 1)
	end
	p.Parent = k.Model
	k.Count += 1
	return p
end

-- Bloc aligné : bornes x0..x1, y0..y1, z0..z1
local function box(k: K, name: string, x0: number, x1: number, y0: number, y1: number, z0: number, z1: number, color: Color3, material: Enum.Material?, shadow: boolean?): BasePart
	return newPart(k, "Part", name, Vector3.new(math.abs(x1 - x0), math.abs(y1 - y0), math.abs(z1 - z0)),
		CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2), color, material, shadow)
end

-- Bloc centré, tourné autour de X (angle en rad) : jantes, arches
local function boxRotX(k: K, name: string, x: number, y: number, z: number, sx: number, sy: number, sz: number, angle: number, color: Color3, material: Enum.Material?): BasePart
	return newPart(k, "Part", name, Vector3.new(sx, sy, sz), CFrame.new(x, y, z) * CFrame.Angles(angle, 0, 0), color, material)
end

-- Coin : haut côté +Z si `highBack`, sinon côté -Z
local function wedge(k: K, name: string, x0: number, x1: number, y0: number, y1: number, z0: number, z1: number, highBack: boolean, color: Color3, material: Enum.Material?): BasePart
	local cf = CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2)
	if not highBack then
		cf *= CFrame.Angles(0, PI, 0)
	end
	return newPart(k, "WedgePart", name, Vector3.new(math.abs(x1 - x0), math.abs(y1 - y0), math.abs(z1 - z0)), cf, color, material)
end

-- Cylindre le long de X (roues), de Z, debout (Y)
local function cylX(k: K, name: string, x: number, y: number, z: number, length: number, diameter: number, color: Color3, material: Enum.Material?, shadow: boolean?): BasePart
	local p = newPart(k, "Part", name, Vector3.new(length, diameter, diameter), CFrame.new(x, y, z), color, material, shadow)
	;(p :: Part).Shape = Enum.PartType.Cylinder
	return p
end
local function cylZ(k: K, name: string, x: number, y: number, z: number, length: number, diameter: number, color: Color3, material: Enum.Material?): BasePart
	local p = newPart(k, "Part", name, Vector3.new(length, diameter, diameter), CFrame.new(x, y, z) * CFrame.Angles(0, PI / 2, 0), color, material)
	;(p :: Part).Shape = Enum.PartType.Cylinder
	return p
end
local function cylY(k: K, name: string, x: number, y0: number, y1: number, z: number, diameter: number, color: Color3, material: Enum.Material?, shadow: boolean?): BasePart
	local p = newPart(k, "Part", name, Vector3.new(math.abs(y1 - y0), diameter, diameter), CFrame.new(x, (y0 + y1) / 2, z) * CFrame.Angles(0, 0, PI / 2), color, material, shadow)
	;(p :: Part).Shape = Enum.PartType.Cylinder
	return p
end

-- Tube cylindrique entre deux points (cadres de vélo, barres, rétros)
local function rod(k: K, name: string, a: Vector3, b: Vector3, diameter: number, color: Color3, material: Enum.Material?): BasePart
	local len = (b - a).Magnitude
	local cf = CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, PI / 2, 0)
	local p = newPart(k, "Part", name, Vector3.new(math.max(0.05, len), diameter, diameter), cf, color, material)
	;(p :: Part).Shape = Enum.PartType.Cylinder
	return p
end

-- Plaque inclinée entre deux points (y, z) à l'abscisse x (pare-brise, dossiers)
local function slab(k: K, name: string, x: number, width: number, y0: number, z0: number, y1: number, z1: number, thick: number, color: Color3, material: Enum.Material?): BasePart
	local a = Vector3.new(x, y0, z0)
	local c = Vector3.new(x, y1, z1)
	return newPart(k, "Part", name, Vector3.new(width, thick, (c - a).Magnitude), CFrame.lookAt((a + c) / 2, c), color, material)
end

-- Anneau de `n` segments dans le plan YZ (roues de vélo) : centre (x, y, z), rayon r
local function ring(k: K, name: string, x: number, y: number, z: number, r: number, n: number, width: number, thick: number, color: Color3, material: Enum.Material?)
	local chord = 2 * r * math.sin(PI / n) + 0.02
	for i = 0, n - 1 do
		local a = (i + 0.5) / n * 2 * PI
		boxRotX(k, name, x, y + math.cos(a) * r, z + math.sin(a) * r, width, thick, chord, a, color, material)
	end
end

-- (v9.9) Coin dans le plan du flanc (x0..x1) : triangle rectangle entre la
-- corde (za, ya) -> (zb, yb) et l'horizontale y = max(ya, yb) (au-dessus)
local function chordWedge(k: K, name: string, x0: number, x1: number, za: number, ya: number, zb: number, yb: number, color: Color3, material: Enum.Material?)
	local ymax, ymin = math.max(ya, yb), math.min(ya, yb)
	if ymax - ymin < 0.02 or math.abs(zb - za) < 0.02 then
		return
	end
	local cf = CFrame.new((x0 + x1) / 2, (ya + yb) / 2, (za + zb) / 2)
	cf *= if yb > ya then CFrame.Angles(PI, 0, 0) else CFrame.Angles(0, 0, PI)
	newPart(k, "WedgePart", name, Vector3.new(math.abs(x1 - x0), ymax - ymin, math.abs(zb - za)), cf, color, material)
end

-- (v9.9) Panneau de flanc (x0..x1, y0..top) avec un passage de roue en ARC
-- (demi-cercle de rayon `ra` centré en (axle, cy)) : n segments bloc + coin
local function archPanel(k: K, name: string, x0: number, x1: number, axle: number, cy: number, ra: number, top: number, n: number, color: Color3, material: Enum.Material?)
	for i = 0, n - 1 do
		local a0 = -PI / 2 + i * PI / n
		local a1 = a0 + PI / n
		local za, ya = axle + ra * math.sin(a0), cy + ra * math.cos(a0)
		local zb, yb = axle + ra * math.sin(a1), cy + ra * math.cos(a1)
		local ymax = math.max(ya, yb)
		if top - ymax > 0.02 then
			box(k, name, math.min(x0, x1), math.max(x0, x1), ymax, top, za, zb, color, material)
		end
		chordWedge(k, name, x0, x1, za, ya, zb, yb, color, material)
	end
end

-- (v9.9) Roue de poids lourd : pneu + flanc, jante acier (voile, lèvre,
-- 8 goujons ou enjoliveur), moyeu ; pièces marquées "Wheel" / "Spin"
local function heavyWheel(k: K, index: number, x: number, y: number, z: number, side: number, d: number, width: number, full: boolean, rim: Color3?)
	k.WheelTag = index
	k.Spin = true
	cylX(k, "Tyre", x, y, z, width, d, TYRE, M.Rubber, true)
	local face = x + side * width / 2
	local function layer(name: string, out: number, thick: number, diameter: number, color: Color3, material: Enum.Material)
		cylX(k, name, face + side * (out - thick / 2), y, z, thick, diameter, color, material)
	end
	local rimColor = rim or STEEL
	if full then
		-- (couches espacées de ≥ 0,04 : aucun z-fighting)
		layer("Sidewall", 0.04, 0.1, d - 0.14, Color3.fromRGB(44, 44, 50), M.Rubber)
		layer("RimLip", 0.08, 0.1, d * 0.64, rimColor, M.Metal)
		layer("RimDish", 0.12, 0.1, d * 0.5, Color3.fromRGB(150, 154, 162), M.Metal)
		for i = 0, 7 do
			local a = i / 8 * 2 * PI
			local rr = d * 0.17
			cylX(k, "LugNut", face + side * 0.17, y + math.cos(a) * rr, z + math.sin(a) * rr, 0.08, d * 0.045, CHROME, M.Metal)
		end
		layer("Hub", 0.27, 0.12, d * 0.22, CHROME, M.Metal)
	else
		layer("Rim", 0.05, 0.1, d * 0.62, rimColor, M.Metal)
		layer("Hub", 0.1, 0.08, d * 0.22, CHROME, M.Metal)
	end
	k.WheelTag = nil
	k.Spin = nil
end

-- Panneau SurfaceGui + texte (clé anglaise "LocText" si `localize`)
local function sign(k: K, part: BasePart, face: Enum.NormalId, ppu: number, text: string, textColor: Color3, background: Color3?, font: Enum.Font?, localize: boolean?, light: number?)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Sign"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = ppu
	gui.LightInfluence = light or 0.5
	gui.MaxDistance = 220
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(0.94, 0.86)
	label.Position = UDim2.fromScale(0.03, 0.07)
	label.BackgroundTransparency = 1
	label.Font = font or Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = textColor
	label.Text = if localize then k.T(text) else text
	if localize then
		label:SetAttribute("LocText", text)
	end
	label.Parent = gui
	if background then
		local bg = Instance.new("Frame")
		bg.Name = "Back"
		bg.Size = UDim2.fromScale(1, 1)
		bg.BackgroundColor3 = background
		bg.BorderSizePixel = 0
		bg.ZIndex = 0
		bg.Parent = gui
		label.ZIndex = 2
	end
	gui.Parent = part
	return gui
end

-- Racine invisible (boîte englobante) + pivot au sol + attributs
local function finish(k: K, kind: string, x0: number, x1: number, y0: number, y1: number, z0: number, z1: number, solid: boolean): Model
	local root = box(k, "Root", x0, x1, y0, y1, z0, z1, WHITE, M.SmoothPlastic)
	root.Transparency = 1
	root.CanCollide = solid
	root.CanQuery = solid
	root.CastShadow = false
	local model = k.Model
	model.PrimaryPart = root
	root.PivotOffset = CFrame.new(0, -(y0 + y1) / 2, -(z0 + z1) / 2) * CFrame.new(-(x0 + x1) / 2, 0, 0)
	model:SetAttribute("Kind", kind)
	model:SetAttribute("Length", math.abs(z1 - z0))
	model:SetAttribute("Width", math.abs(x1 - x0))
	model:SetAttribute("Height", y1)
	model:SetAttribute("PartCount", k.Count)
	return model
end

----------------------------------------------------------------------
-- 🚌 Bus de ville
----------------------------------------------------------------------

VehicleModels.BUS = { L = 30, W = 7.6, H = 9.3, WheelD = 3.1, AxleF = -8.25, AxleR = 6.75 }

function VehicleModels.Bus(opts: any?): Model
	local o = type(opts) == "table" and opts or {}
	local full = o.Detail ~= "Light"
	local body = typeof(o.Color) == "Color3" and o.Color or WHITE
	local livery = typeof(o.Livery) == "Color3" and o.Livery or PINK
	local k = newKit("Bus", o)
	local B = VehicleModels.BUS
	local L, W = B.L, B.W
	local hw = W / 2
	local zF, zB = -L / 2, L / 2
	local yLow, floorY, sill, winTop, wallTop, roofTop = 0.7, 1.5, 3.9, 7.6, 8.4, 8.85
	local r = B.WheelD / 2
	local ra = r + 0.35 -- demi-ouverture des passages de roue
	local archTop = B.WheelD + 0.35
	local rc = 0.7 -- rayon des coins avant
	local rcb = 0.5 -- rayon des coins arrière
	local wall = 0.3
	-- portes (côté droit = +X, trottoir) : avant (devant l'essieu) et milieu
	local doorF0, doorF1 = zF + 1.5, zF + 4.6
	local doorM0, doorM1 = B.AxleF + ra + 1.2, B.AxleF + ra + 4.8
	local glassT = if full then 0.35 else 0.1
	local glassC = if full then GLASS else GLASS_DARK

	-- ░ châssis, plancher, passages de roue ░
	box(k, "Chassis", -hw + 1.25, hw - 1.25, yLow, floorY - 0.2, zF + 1, zB - 1, TRIM, M.SmoothPlastic)
	box(k, "Floor", -hw + wall, hw - wall, floorY - 0.2, floorY, zF + 0.4, zB - 0.3, FLOOR, M.Slate)
	local wheelIndex = 0
	for _, za in ipairs({ B.AxleF, B.AxleR }) do
		for _, sx in ipairs({ -1, 1 }) do
			local x0, x1 = sx * (hw - 1.3), sx * (hw - 0.34)
			box(k, "WheelHousing", math.min(x0, x1), math.max(x0, x1), yLow + 0.02, archTop, za - ra, za + ra, TRIM, M.SmoothPlastic)
			-- (v9.9) vraie roue de bus (jante acier, goujons) + passage de roue en ARC
			wheelIndex += 1
			heavyWheel(k, wheelIndex, sx * (hw - 0.55), r, za, sx, B.WheelD, 1.0, full, nil)
			archPanel(k, "ArchPanel", sx * (hw - wall), sx * hw, za, r, ra, sill, if full then 5 else 3, livery, M.SmoothPlastic)
			-- lèvre de caoutchouc noir autour de l'arche
			if full then
				local n = 5
				for i = 0, n - 1 do
					local a = -PI / 2 + (i + 0.5) * PI / n
					local rr = ra + 0.08
					local lx0, lx1 = sx * (hw - 0.1), sx * (hw + 0.05)
					boxRotX(k, "ArchLip", (lx0 + lx1) / 2, r + math.cos(a) * rr, za + math.sin(a) * rr, math.abs(lx1 - lx0), 0.16, 2 * rr * math.tan(PI / (2 * n)) + 0.03, a, TRIM, M.Rubber)
				end
			end
		end
	end

	-- ░ flancs : bas rose (jupe) + bande blanche sous les vitres, coupés
	-- aux passages de roue (et aux portes côté droit) ░
	local split = 2.4 -- hauteur de la jupe rose
	for _, sx in ipairs({ -1, 1 }) do
		local cuts = { { B.AxleF - ra, B.AxleF + ra }, { B.AxleR - ra, B.AxleR + ra } }
		if sx > 0 then
			table.insert(cuts, { doorF0, doorF1 })
			table.insert(cuts, { doorM0, doorM1 })
		end
		table.sort(cuts, function(a, b)
			return a[1] < b[1]
		end)
		local segs = {}
		local zs = zF + rc
		for _, c in ipairs(cuts) do
			if c[1] - zs > 0.05 then
				table.insert(segs, { zs, c[1] })
			end
			zs = c[2]
		end
		if zB - rcb - zs > 0.05 then
			table.insert(segs, { zs, zB - rcb })
		end
		local x0, x1 = sx * (hw - wall), sx * hw
		local lo, hi = math.min(x0, x1), math.max(x0, x1)
		for i, sg in ipairs(segs) do
			box(k, "Skirt", lo, hi, yLow, split, sg[1], sg[2], livery, M.SmoothPlastic, true)
			local band = box(k, "SideBand", lo, hi, split, sill, sg[1], sg[2], body, M.SmoothPlastic, true)
			-- logo "🧠 DOPAMINE TOWN" sur le plus long panneau
			local longest = true
			for _, other in ipairs(segs) do
				if other[2] - other[1] > sg[2] - sg[1] + 0.01 then
					longest = false
				end
			end
			if full and longest and i > 0 then
				sign(k, band, if sx > 0 then Enum.NormalId.Right else Enum.NormalId.Left, 24, "🧠 DOPAMINE TOWN", PINK, nil, Enum.Font.FredokaOne, false)
			end
		end
		-- vague rose qui monte vers l'arrière (livrée)
		local wz0, wz1 = B.AxleR + ra + 0.05, zB - rcb - 0.05
		local wx0, wx1 = sx * (hw - 0.05), sx * (hw + 0.03)
		wedge(k, "Swoosh", math.min(wx0, wx1), math.max(wx0, wx1), split, sill - 0.25, wz0, wz1, true, livery, M.SmoothPlastic)
		-- bande haute (au-dessus des vitres)
		box(k, "UpperWall", lo, hi, winTop, wallTop, zF + rc, zB - rcb, body, M.SmoothPlastic, true)
		-- joint noir sous les vitres
		local jx0, jx1 = sx * (hw - 0.1), sx * (hw + 0.03)
		box(k, "WindowSeal", math.min(jx0, jx1), math.max(jx0, jx1), sill - 0.06, sill + 0.08, zF + rc, zB - rcb, TRIM, M.Rubber)
		-- vitres (côté droit : interrompues par les portes)
		local gx0, gx1 = sx * (hw - 0.22), sx * (hw - 0.08)
		local glo, ghi = math.min(gx0, gx1), math.max(gx0, gx1)
		local runs = if sx > 0 then { { doorF1 + 0.08, doorM0 - 0.08 }, { doorM1 + 0.08, zB - 1.2 } } else { { zF + rc, zB - 1.2 } }
		for _, run in ipairs(runs) do
			box(k, "Window", glo, ghi, sill + 0.08, winTop, run[1], run[2], glassC, M.Glass).Transparency = glassT
			-- montants noirs tous les ~3,6 studs
			local n = math.max(1, math.floor((run[2] - run[1]) / 3.6 + 0.5))
			for j = 1, n - 1 do
				local z = run[1] + j * (run[2] - run[1]) / n
				local px0, px1 = sx * (hw - 0.12), sx * (hw + 0.04)
				box(k, "WindowPost", math.min(px0, px1), math.max(px0, px1), sill + 0.08, winTop, z - 0.16, z + 0.16, TRIM, M.SmoothPlastic)
			end
		end
		-- bout arrière vitré (bande arrière au-delà de la dernière vitre)
		box(k, "RearQuarter", lo, hi, sill, winTop, zB - 1.2, zB - rcb, body, M.SmoothPlastic)
	end

	-- ░ portes doubles vitrées (côté droit) + marches ░
	for doorIndex, d in ipairs({ { doorF0, doorF1 }, { doorM0, doorM1 } }) do
		local z0, z1 = d[1], d[2]
		local zc = (z0 + z1) / 2
		local x0, x1 = hw - 0.2, hw - 0.06
		box(k, "DoorStep", hw - 1.1, hw - 0.1, yLow + 0.04, floorY - 0.06, z0 + 0.1, z1 - 0.1, FLOOR, M.DiamondPlate)
		if full then
			-- (v9.9) 2 battants louvoyants (attributs Door / Leaf : TownTraffic
			-- les ouvre à l'arrêt : ils sortent puis glissent de chaque côté)
			for leafIndex, side in ipairs({ { z0 + 0.1, zc - 0.05 }, { zc + 0.05, z1 - 0.1 } }) do
				k.Door = doorIndex
				k.Leaf = if leafIndex == 1 then -1 else 1
				box(k, "DoorGlass", x0, x1, floorY + 0.9, winTop - 0.15, side[1], side[2], GLASS, M.Glass).Transparency = 0.3
				box(k, "DoorKick", x0 - 0.02, x1 + 0.02, floorY, floorY + 0.9, side[1], side[2], TRIM, M.SmoothPlastic)
				local sealZ = if leafIndex == 1 then side[2] else side[1]
				box(k, "DoorSeal", x0 - 0.04, hw + 0.05, floorY + 0.03, winTop - 0.16, sealZ - 0.05, sealZ + 0.05, TRIM, M.Rubber)
				k.Door = nil
				k.Leaf = nil
			end
			box(k, "DoorHeader", hw - 0.3, hw + 0.04, winTop - 0.15, winTop, z0, z1, TRIM, M.SmoothPlastic)
			for _, zz in ipairs({ z0, z1 }) do
				box(k, "DoorJamb", hw - 0.26, hw + 0.04, floorY, winTop - 0.02, zz - 0.1, zz + 0.1, TRIM, M.SmoothPlastic)
			end
		else
			for leafIndex, side in ipairs({ { z0 + 0.05, zc - 0.03 }, { zc + 0.03, z1 - 0.05 } }) do
				k.Door = doorIndex
				k.Leaf = if leafIndex == 1 then -1 else 1
				box(k, "DoorGlass", x0, x1, floorY, winTop, side[1], side[2], GLASS_DARK, M.Glass).Transparency = 0.1
				k.Door = nil
				k.Leaf = nil
			end
		end
	end

	-- ░ face avant arrondie : coins, tablier, pare-brise, girouette ░
	for _, sx in ipairs({ -1, 1 }) do
		cylY(k, "CornerLow", sx * (hw - rc), yLow + 0.04, sill, zF + rc, rc * 2, body, M.SmoothPlastic, true)
		cylY(k, "CornerHigh", sx * (hw - rc), sill, wallTop, zF + rc, rc * 2, TRIM, M.SmoothPlastic)
		cylY(k, "CornerRearLow", sx * (hw - rcb), yLow, split, zB - rcb, rcb * 2, livery, M.SmoothPlastic)
		cylY(k, "CornerRear", sx * (hw - rcb), split, wallTop, zB - rcb, rcb * 2, body, M.SmoothPlastic)
	end
	box(k, "FrontPanel", -hw + rc, hw - rc, yLow, 3.3, zF, zF + rc, body, M.SmoothPlastic, true)
	box(k, "FrontSkirt", -hw + rc, hw - rc, yLow + 0.08, 1.5, zF - 0.05, zF + 0.5, livery, M.SmoothPlastic)
	box(k, "Bumper", -hw + 0.3, hw - 0.3, yLow - 0.1, yLow + 0.55, zF - 0.25, zF + 0.4, TRIM, M.SmoothPlastic)
	-- pare-brise panoramique (léger fruit vers l'arrière)
	slab(k, "Windshield", 0, W - 2 * rc + 0.2, 3.3, zF + 0.3, 6.9, zF + 0.7, 0.16, glassC, M.Glass).Transparency = if full then 0.3 else 0.12
	box(k, "WindshieldBase", -hw + rc, hw - rc, 3.2, 3.42, zF + 0.1, zF + 0.6, TRIM, M.Rubber)
	-- girouette (panneau à LED) + bandeau au-dessus (sous le nez arrondi du toit)
	local dest = box(k, "DestinationSign", -hw + rc + 0.1, hw - rc - 0.1, 6.9, 7.85, zF + 0.5, zF + 0.95, Color3.fromRGB(24, 22, 30), M.SmoothPlastic)
	local destGui = sign(k, dest, Enum.NormalId.Front, 30, "DOPAMINE TOWN", LED, Color3.fromRGB(24, 22, 30), Enum.Font.Arcade, false, 0.3)
	local destText = destGui:FindFirstChild("Text") :: TextLabel?
	if destText then
		destText.Position = UDim2.fromScale(0.2, 0.12)
		destText.Size = UDim2.fromScale(0.77, 0.76)
	end
	local lineNo = Instance.new("TextLabel")
	lineNo.Name = "Line"
	lineNo.BackgroundColor3 = LED
	lineNo.BorderSizePixel = 0
	lineNo.Position = UDim2.fromScale(0.03, 0.1)
	lineNo.Size = UDim2.fromScale(0.13, 0.8)
	lineNo.Font = Enum.Font.GothamBlack
	lineNo.TextScaled = true
	lineNo.TextColor3 = Color3.fromRGB(24, 22, 30)
	lineNo.Text = "9"
	lineNo.ZIndex = 2
	lineNo.Parent = destGui
	box(k, "FrontHeader", -hw + rc, hw - rc, 7.85, wallTop, zF + 0.55, zF + 1.0, body, M.SmoothPlastic)
	-- toit arrondi, climatisation, trappe
	box(k, "Roof", -hw + 0.45, hw - 0.45, wallTop, roofTop, zF + 0.6, zB - 0.4, body, M.SmoothPlastic, true)
	for _, sx in ipairs({ -1, 1 }) do
		cylZ(k, "RoofEdge", sx * (hw - 0.45), wallTop, (zF + 0.6 + zB - 0.4) / 2, L - 1.0, 0.9, body, M.SmoothPlastic)
	end
	cylX(k, "RoofNose", 0, wallTop, zF + 0.6, W - 0.9, 0.9, body, M.SmoothPlastic)
	box(k, "AirCon", -2.1, 2.1, roofTop, roofTop + 0.7, 1.5, 7.5, Color3.fromRGB(226, 226, 234), M.SmoothPlastic, true)
	if full then
		for _, z in ipairs({ 3.2, 5.8 }) do
			cylY(k, "Fan", -0.9, roofTop + 0.7, roofTop + 0.76, z, 1.3, TRIM, M.Metal)
			cylY(k, "Fan", 0.9, roofTop + 0.7, roofTop + 0.76, z, 1.3, TRIM, M.Metal)
		end
		box(k, "RoofHatch", -1, 1, roofTop, roofTop + 0.18, -6.5, -4.7, Color3.fromRGB(210, 212, 222), M.SmoothPlastic)
	end
	-- (v9.9) masque avant noir laqué sur toute la largeur (bus moderne) +
	-- blocs optiques : boîtier, 2 modules ronds, bande LED, clignotant
	box(k, "FrontMask", -hw + rc - 0.05, hw - rc + 0.05, 1.55, 2.75, zF - 0.08, zF + 0.3, TRIM, M.SmoothPlastic).Reflectance = 0.15
	for _, sx in ipairs({ -1, 1 }) do
		local x0, x1 = sx * (hw - rc - 0.15), sx * (hw - rc - 1.75)
		box(k, "HeadlightHousing", math.min(x0, x1), math.max(x0, x1), 1.7, 2.6, zF - 0.14, zF + 0.3, Color3.fromRGB(56, 58, 66), M.Metal)
		for _, f in ipairs({ 0.3, 0.72 }) do
			cylZ(k, "Headlight", sx * (hw - rc - 0.15 - 1.6 * f), 2.22, zF - 0.17, 0.08, 0.6, LAMP, M.Glass)
		end
		if full then
			local l0, l1 = sx * (hw - rc - 0.25), sx * (hw - rc - 1.65)
			box(k, "HeadlightDRL", math.min(l0, l1), math.max(l0, l1), 1.76, 1.86, zF - 0.19, zF + 0.2, DRL, M.SmoothPlastic)
			local i0, i1 = sx * (hw - rc + 0.02), sx * (hw - rc - 0.12)
			box(k, "Indicator", math.min(i0, i1), math.max(i0, i1), 1.75, 2.55, zF - 0.12, zF + 0.3, AMBER, M.SmoothPlastic)
		end
	end
	local logo = box(k, "FrontLogo", -0.6, 0.6, 2.8, 3.2, zF - 0.04, zF + 0.02, body, M.SmoothPlastic)
	sign(k, logo, Enum.NormalId.Front, 30, "🧠", PINK, nil, Enum.Font.GothamBlack, false)
	box(k, "PlateFront", -1.1, 1.1, 0.9, 1.4, zF - 0.33, zF - 0.27, Color3.fromRGB(248, 248, 244), M.SmoothPlastic)
	-- essuie-glaces (posés à 0,04 devant la vitre)
	if full then
		for _, sx in ipairs({ -1, 1 }) do
			slab(k, "Wiper", sx * 1.1, 0.1, 3.5, zF + 0.2, 5.4, zF + 0.4, 0.08, TRIM, M.SmoothPlastic)
		end
	end
	-- rétroviseurs "oreilles de lapin"
	for _, sx in ipairs({ -1, 1 }) do
		local top = Vector3.new(sx * (hw - 0.3), 7.9, zF + 0.9)
		local out = Vector3.new(sx * (hw + 0.45), 7.7, zF - 0.9)
		local down = Vector3.new(sx * (hw + 0.45), 6.3, zF - 0.9)
		rod(k, "MirrorArm", top, out, 0.14, TRIM, M.Metal)
		if full then
			rod(k, "MirrorArm", out, down, 0.12, TRIM, M.Metal)
		end
		box(k, "Mirror", sx * (hw + 0.45) - 0.28, sx * (hw + 0.45) + 0.28, 5.0, 6.35, zF - 1.02, zF - 0.72, TRIM, M.SmoothPlastic)
	end

	-- ░ arrière : paroi, lunette, feux verticaux, grille moteur, pare-chocs ░
	local back = box(k, "RearWall", -hw + rcb, hw - rcb, yLow, wallTop, zB - 0.3, zB, body, M.SmoothPlastic, true)
	box(k, "RearSkirt", -hw + rcb, hw - rcb, yLow, split, zB - 0.25, zB + 0.03, livery, M.SmoothPlastic)
	box(k, "RearWindow", -hw + 1.2, hw - 1.2, 5.3, winTop, zB - 0.02, zB + 0.06, glassC, M.Glass).Transparency = glassT
	box(k, "EngineGrille", -2.2, 2.2, 1.5, 2.3, zB - 0.02, zB + 0.08, TRIM, M.SmoothPlastic)
	if full then
		for j = 0, 2 do
			local y = 1.66 + j * 0.25
			box(k, "Louver", -2.1, 2.1, y, y + 0.08, zB + 0.08, zB + 0.12, Color3.fromRGB(70, 70, 82), M.Metal)
		end
		local ad = box(k, "RearAd", -2.6, 2.6, 2.9, 4.9, zB - 0.02, zB + 0.05, Color3.fromRGB(255, 226, 240), M.SmoothPlastic)
		sign(k, ad, Enum.NormalId.Back, 24, "🧠 Click more!", PINK, nil, Enum.Font.FredokaOne, true)
	end
	for _, sx in ipairs({ -1, 1 }) do
		local x0, x1 = sx * (hw - rcb - 0.05), sx * (hw - rcb - 0.55)
		box(k, "Taillight", math.min(x0, x1), math.max(x0, x1), 2.8, 4.9, zB - 0.02, zB + 0.1, TAIL, M.Glass)
		if full then
			box(k, "RearIndicator", math.min(x0, x1), math.max(x0, x1), 5.0, 5.5, zB - 0.02, zB + 0.1, AMBER, M.SmoothPlastic)
			box(k, "ReverseLight", math.min(x0, x1), math.max(x0, x1), 2.3, 2.7, zB - 0.02, zB + 0.1, Color3.fromRGB(236, 236, 240), M.Glass)
		end
	end
	box(k, "RearBumper", -hw + 0.3, hw - 0.3, yLow - 0.1, yLow + 0.55, zB - 0.4, zB + 0.25, TRIM, M.SmoothPlastic)
	local routeBox = box(k, "RearRoute", -0.8, 0.8, 7.7, 8.25, zB - 0.02, zB + 0.06, Color3.fromRGB(24, 22, 30), M.SmoothPlastic)
	sign(k, routeBox, Enum.NormalId.Back, 30, "9", LED, Color3.fromRGB(24, 22, 30), Enum.Font.Arcade, false, 0.3)
	local _ = back

	-- ░ intérieur (vu par les vitres) : sièges, barres, poste de conduite ░
	if full then
		local function seatAt(x: number, z: number, raise: number, facing: number)
			local top = floorY + 1.5 + raise
			box(k, "Seat", x - 1.1, x + 1.1, top - 0.35, top, z - 0.65, z + 0.6, SEAT, M.Fabric)
			local backZ = z + facing * 0.75
			slab(k, "SeatBack", x, 2.2, top, backZ, top + 1.9, backZ + facing * 0.3, 0.3, SEAT_BACK, M.Fabric)
		end
		local seatX = hw - wall - 1.25
		-- rangée gauche (côté conducteur), du poste de conduite au fond
		local z = zF + 5.4
		while z < zB - 2.2 do
			local onWheel = math.abs(z - B.AxleF) < ra or math.abs(z - B.AxleR) < ra
			seatAt(-seatX, z, if onWheel then archTop - floorY - 1.1 else 0, 1)
			z += 2.6
		end
		-- rangée droite : hors des portes
		z = doorF1 + 1.2
		while z < zB - 2.2 do
			local inDoor = z + 0.8 > doorM0 - 0.3 and z - 0.8 < doorM1 + 0.3
			if not inDoor then
				local onWheel = math.abs(z - B.AxleF) < ra or math.abs(z - B.AxleR) < ra
				seatAt(seatX, z, if onWheel then archTop - floorY - 1.1 else 0, 1)
			end
			z += 2.6
		end
		-- banquette du fond
		box(k, "RearBench", -hw + wall + 0.1, hw - wall - 0.1, floorY + 1.15, floorY + 1.5, zB - 1.9, zB - 0.6, SEAT, M.Fabric)
		slab(k, "RearBenchBack", 0, W - 2 * wall - 0.2, floorY + 1.5, zB - 0.55, floorY + 3.4, zB - 0.4, 0.25, SEAT_BACK, M.Fabric)
		-- barres jaunes verticales (portes, allée) + mains courantes au plafond
		for _, pz in ipairs({ doorF1 + 0.3, doorM0 - 0.3, doorM1 + 0.3, -9.5, 0.8, 9.5 }) do
			cylY(k, "Pole", 0.9, floorY, wallTop - 0.05, pz, 0.18, POLE, M.Metal)
		end
		for _, sx in ipairs({ -1, 1 }) do
			rod(k, "Handrail", Vector3.new(sx * 1.6, 7.1, zF + 4.5), Vector3.new(sx * 1.6, 7.1, zB - 2), 0.14, POLE, M.Metal)
		end
		box(k, "CeilingLight", -0.5, 0.5, wallTop - 0.08, wallTop, zF + 3, zB - 2, Color3.fromRGB(252, 250, 244), M.SmoothPlastic)
		-- poste de conduite (à gauche) : siège, volant presque à plat, tableau de bord, valideur
		local dx = -hw + 1.7
		box(k, "DriverSeat", dx - 0.75, dx + 0.75, floorY + 1.1, floorY + 1.45, zF + 2.4, zF + 3.6, TRIM, M.Fabric)
		slab(k, "DriverBack", dx, 1.4, floorY + 1.45, zF + 3.65, floorY + 3.6, zF + 3.95, 0.3, TRIM, M.Fabric)
		box(k, "Dashboard", -hw + 0.4, hw - 2.2, 2.4, 3.25, zF + 0.75, zF + 1.7, Color3.fromRGB(60, 60, 72), M.SmoothPlastic)
		-- volant de bus : presque à plat, incliné vers le conducteur
		local wheelPart = newPart(k, "Part", "SteeringWheel", Vector3.new(0.1, 1.3, 1.3), CFrame.new(dx, 3.6, zF + 2.0) * CFrame.Angles(math.rad(35), 0, 0) * CFrame.Angles(0, 0, PI / 2), TRIM, M.SmoothPlastic)
		;(wheelPart :: Part).Shape = Enum.PartType.Cylinder
		rod(k, "SteeringColumn", Vector3.new(dx, 2.6, zF + 1.5), Vector3.new(dx, 3.55, zF + 1.95), 0.16, TRIM, M.SmoothPlastic)
		box(k, "TicketMachine", -0.55, -0.1, floorY, floorY + 3.3, zF + 3.2, zF + 3.6, Color3.fromRGB(90, 200, 170), M.SmoothPlastic)
	end

	local model = finish(k, "Bus", -hw, hw, yLow, roofTop + 0.7, zF - 0.3, zB + 0.3, o.Solid == true)
	model:SetAttribute("DoorSide", 1)
	return model
end

----------------------------------------------------------------------
-- 🚲 Vélos
----------------------------------------------------------------------

-- Roue de vélo : pneu en anneau, jante, rayons (barres croisées), moyeu
local function bikeWheel(k: K, y: number, z: number, d: number, rim: Color3, spokes: number, light: boolean)
	local r = d / 2
	ring(k, "Tyre", 0, y, z, r - 0.07, if light then 8 else 12, 0.13, 0.14, TYRE, M.Rubber)
	if not light then
		ring(k, "RimRing", 0, y, z, r - 0.19, 12, 0.08, 0.07, rim, M.Metal)
	end
	-- (v9.9) rayons croisés des deux côtés du moyeu (2 nappes décalées : on
	-- voit la roue "à rayons" de près), valve
	for i = 0, spokes - 1 do
		local a = i / spokes * PI
		boxRotX(k, "Spokes", -0.03, y, z, 0.02, 0.025, d - 0.36, a, STEEL, M.Metal)
		if not light then
			boxRotX(k, "Spokes", 0.03, y, z, 0.02, 0.025, d - 0.36, a + PI / spokes / 2, STEEL, M.Metal)
		end
	end
	cylX(k, "Hub", 0, y, z, 0.2, 0.18, STEEL, M.Metal)
	if not light then
		cylX(k, "HubFlange", 0, y, z, 0.12, 0.3, CHROME, M.Metal)
	end
end

function VehicleModels.Bike(opts: any?): Model
	local o = type(opts) == "table" and opts or {}
	local kind = if o.Kind == "Kid" or o.Kind == "Sport" then o.Kind else "City"
	local light = o.Detail == "Light"
	local color = typeof(o.Color) == "Color3" and o.Color or Color3.fromRGB(126, 196, 255)
	local k = newKit("Bike", o)
	local kid = kind == "Kid"
	local s = if kid then 0.62 else 1 -- échelle
	local d = (if kid then 1.4 else 2.2) -- diamètre des roues
	local r = d / 2
	local zR, zFr = 1.72 * s, -1.72 * s
	local P = function(y: number, z: number): Vector3
		return Vector3.new(0, y, z)
	end
	-- points du cadre (cadre en losange ; "City" : tube supérieur plongeant)
	local rear = P(r, zR)
	local bb = P(r - 0.12 * s, 0.3 * s)
	local seatTop = P(r + 1.45 * s, 0.72 * s)
	local headTop = P(r + (if kind == "City" then 1.55 else 1.6) * s, -1.0 * s)
	local headBot = P(r + 1.05 * s, -1.2 * s)
	local front = P(r, zFr)
	local tube = if kid then 0.14 else 0.13
	rod(k, "DownTube", bb, headBot, tube + 0.02, color, M.Metal)
	rod(k, "SeatTube", bb, seatTop, tube, color, M.Metal)
	if kind == "City" then
		-- cadre col-de-cygne : tube bas incliné du pédalier vers la douille
		rod(k, "TopTube", seatTop + Vector3.new(0, -0.55 * s, 0.05), headBot + Vector3.new(0, 0.3 * s, 0), tube, color, M.Metal)
	else
		rod(k, "TopTube", seatTop + Vector3.new(0, -0.08, 0), headTop + Vector3.new(0, -0.12, 0), tube, color, M.Metal)
	end
	rod(k, "HeadTube", headBot, headTop, tube + 0.05, color, M.Metal)
	for _, sx in ipairs({ -1, 1 }) do
		local off = Vector3.new(sx * 0.11, 0, 0)
		rod(k, "ChainStay", bb + off, rear + off, 0.08, color, M.Metal)
		rod(k, "SeatStay", seatTop + Vector3.new(0, -0.1, 0) + off * 0.6, rear + off, 0.07, color, M.Metal)
		rod(k, "Fork", headBot + off * 0.7, front + off, 0.09, if kind == "Sport" then TRIM else color, M.Metal)
	end
	-- roues
	local rimColor = if kind == "Sport" then TRIM else STEEL
	bikeWheel(k, r, zR, d, rimColor, if light then 2 else 6, light)
	bikeWheel(k, r, zFr, d, rimColor, if light then 2 else 6, light)
	-- selle + tige
	local post = seatTop + Vector3.new(0, 0.35 * s, 0.03)
	rod(k, "SeatPost", seatTop, post, 0.09, STEEL, M.Metal)
	box(k, "Saddle", -0.2, 0.2, post.Y, post.Y + 0.16, post.Z - 0.42 * s, post.Z + 0.3 * s, Color3.fromRGB(60, 44, 40), M.Leather)
	-- potence + cintre / guidon
	local stem = headTop + Vector3.new(0, 0.3 * s, (if kind == "Sport" then -0.25 else 0.05) * s)
	rod(k, "Stem", headTop, stem, 0.1, STEEL, M.Metal)
	local barW = (if kind == "Sport" then 0.55 else 0.8) * s + (if kid then 0.1 else 0)
	local barBack = if kind == "City" then 0.35 * s else 0
	rod(k, "Handlebar", stem + Vector3.new(-barW, 0, barBack), stem + Vector3.new(barW, 0, barBack), 0.08, STEEL, M.Metal)
	for _, sx in ipairs({ -1, 1 }) do
		cylX(k, "Grip", sx * (barW - 0.12), stem.Y, stem.Z + barBack, 0.26, 0.14, Color3.fromRGB(60, 44, 40), M.Rubber)
	end
	-- pédalier : plateau, manivelles, pédales ; garde-chaîne
	cylX(k, "Chainring", 0.2, bb.Y, bb.Z, 0.05, 0.75 * s + 0.1, STEEL, M.Metal)
	for _, sx in ipairs({ -1, 1 }) do
		local a = if sx > 0 then math.rad(25) else math.rad(205)
		local tip = bb + Vector3.new(sx * 0.3, -math.cos(a) * 0.5 * s, math.sin(a) * 0.5 * s)
		rod(k, "Crank", bb + Vector3.new(sx * 0.24, 0, 0), tip, 0.08, STEEL, M.Metal)
		box(k, "Pedal", tip.X + (if sx > 0 then 0.02 else -0.3), tip.X + (if sx > 0 then 0.3 else -0.02), tip.Y - 0.05, tip.Y + 0.05, tip.Z - 0.14, tip.Z + 0.14, TRIM, M.Rubber)
	end
	if not light and kind ~= "Sport" then
		-- garde-chaîne (le long de la base, côté droit)
		local g0 = bb + Vector3.new(0.26, 0.2 * s, 0)
		local g1 = rear + Vector3.new(0.26, 0.15 * s, -0.35 * s)
		rod(k, "ChainGuard", g0, g1, 0.2 * s + 0.06, color:Lerp(Color3.new(1, 1, 1), 0.35), M.SmoothPlastic)
	end
	if kind == "City" and not light then
		-- garde-boues + porte-bagages + panier en osier
		-- (arc de 2 plaques à r + 0,14 : jamais dans le pneu)
		local fr = r + 0.14
		local function fenderArc(z: number, angles: { number })
			for i = 1, #angles - 1 do
				local a, b = math.rad(angles[i]), math.rad(angles[i + 1])
				slab(k, "Fender", 0, 0.24, r + math.cos(a) * fr, z + math.sin(a) * fr, r + math.cos(b) * fr, z + math.sin(b) * fr, 0.05, color, M.SmoothPlastic)
			end
		end
		fenderArc(zR, { -20, 20, 62 })
		fenderArc(zFr, { -62, -20, 20 })
		box(k, "Rack", -0.26, 0.26, r + 1.3, r + 1.37, zR - 0.45, zR + 0.55, STEEL, M.Metal)
		for _, sx in ipairs({ -1, 1 }) do
			rod(k, "RackStay", Vector3.new(sx * 0.22, r + 1.3, zR + 0.5), Vector3.new(sx * 0.14, r, zR), 0.05, STEEL, M.Metal)
		end
		box(k, "Basket", -0.42, 0.42, stem.Y - 0.55, stem.Y + 0.02, stem.Z - 0.95, stem.Z - 0.2, Color3.fromRGB(206, 164, 110), M.Wood)
	end
	if not light then
		-- (v9.9) freins sur jante, câbles, phare, catadioptre, sonnette, béquille
		for _, zw in ipairs({ zR, zFr }) do
			for _, sx in ipairs({ -1, 1 }) do
				box(k, "BrakePad", sx * 0.1 - 0.03, sx * 0.1 + 0.03, r + (d / 2 - 0.2), r + (d / 2 - 0.08), zw + (if zw > 0 then -0.2 else 0.2) - 0.06, zw + (if zw > 0 then -0.2 else 0.2) + 0.06, TRIM, M.Rubber)
			end
		end
		rod(k, "BrakeCable", stem + Vector3.new(0.2, 0, barBack), headBot + Vector3.new(0.12, 0, -0.1), 0.03, TRIM, M.Rubber)
		cylZ(k, "BikeLight", 0, headTop.Y - 0.25, headTop.Z - 0.22, 0.2, 0.22, LAMP, M.Glass)
		box(k, "Reflector", -0.08, 0.08, seatTop.Y - 0.35, seatTop.Y - 0.2, seatTop.Z + 0.12, seatTop.Z + 0.16, TAIL, M.Glass)
		cylX(k, "Bell", -barW * 0.6, stem.Y + 0.07, stem.Z + barBack, 0.12, 0.16, CHROME, M.Metal)
		rod(k, "Kickstand", bb + Vector3.new(-0.18, -0.05, 0.25), Vector3.new(-0.55, 0.02, bb.Z + 0.75), 0.06, STEEL, M.Metal)
	end
	if kid then
		-- petites roues stabilisatrices + fanion
		for _, sx in ipairs({ -1, 1 }) do
			rod(k, "TrainerArm", rear + Vector3.new(sx * 0.12, 0, 0), Vector3.new(sx * 0.62, 0.3, zR + 0.12), 0.06, STEEL, M.Metal)
			cylX(k, "TrainerWheel", sx * 0.66, 0.26, zR + 0.12, 0.1, 0.52, TYRE, M.Rubber)
		end
		rod(k, "FlagPole", rear + Vector3.new(-0.1, 0, 0.1), rear + Vector3.new(-0.1, 2.6, 0.3), 0.04, STEEL, M.Metal)
		wedge(k, "Flag", -0.12, -0.08, rear.Y + 2.05, rear.Y + 2.55, zR + 0.3, zR + 0.9, false, Color3.fromRGB(255, 140, 60), M.Fabric)
	end
	local top = math.max(stem.Y, post.Y) + 0.2
	local half = math.max(0.8 * s + 0.1, if kid then 0.8 else 0)
	return finish(k, "Bike", -half, half, 0, top, zFr - r - 0.05, zR + r + 0.05, false)
end

-- 🛴 Trottinette électrique (béquille : légèrement penchée si opts.Lean)
function VehicleModels.KickScooter(opts: any?): Model
	local o = type(opts) == "table" and opts or {}
	local color = typeof(o.Color) == "Color3" and o.Color or Color3.fromRGB(64, 200, 170)
	local k = newKit("KickScooter", o)
	local d = 0.62
	cylX(k, "WheelF", 0, d / 2, -1.25, 0.16, d, TYRE, M.Rubber)
	cylX(k, "WheelR", 0, d / 2, 1.2, 0.16, d, TYRE, M.Rubber)
	cylX(k, "HubF", 0, d / 2, -1.25, 0.24, 0.26, STEEL, M.Metal)
	cylX(k, "HubR", 0, d / 2, 1.2, 0.24, 0.26, STEEL, M.Metal)
	box(k, "Deck", -0.3, 0.3, 0.32, 0.48, -0.9, 1.0, TRIM, M.SmoothPlastic)
	box(k, "DeckGrip", -0.26, 0.26, 0.48, 0.51, -0.8, 0.85, Color3.fromRGB(70, 70, 82), M.Sand)
	box(k, "Battery", -0.22, 0.22, 0.2, 0.32, -0.7, 0.7, color, M.SmoothPlastic)
	slab(k, "RearFender", 0, 0.28, 0.66, 0.95, 0.55, 1.52, 0.06, color, M.SmoothPlastic)
	rod(k, "Neck", Vector3.new(0, 0.46, -0.95), Vector3.new(0, d / 2, -1.25), 0.14, color, M.Metal)
	rod(k, "Stem", Vector3.new(0, 0.46, -0.95), Vector3.new(0, 3.6, -1.35), 0.16, color, M.Metal)
	rod(k, "Handlebar", Vector3.new(-0.75, 3.6, -1.35), Vector3.new(0.75, 3.6, -1.35), 0.1, TRIM, M.Metal)
	for _, sx in ipairs({ -1, 1 }) do
		cylX(k, "Grip", sx * 0.62, 3.6, -1.35, 0.28, 0.16, TRIM, M.Rubber)
	end
	box(k, "Display", -0.16, 0.16, 3.52, 3.72, -1.46, -1.28, Color3.fromRGB(44, 70, 104), M.Glass)
	cylZ(k, "FrontLight", 0, 2.9, -1.35, 0.14, 0.22, LAMP, M.Glass)
	box(k, "Stand", 0.18, 0.24, 0.02, 0.36, 0.3, 0.36, STEEL, M.Metal)
	local model = finish(k, "KickScooter", -0.85, 0.85, 0, 3.75, -1.6, 1.6, false)
	return model
end

-- 🛵 Scooter (type Vespa) : tablier avant, plancher, capot arrière arrondi,
-- selle, guidon avec phare, petites roues, top-case
function VehicleModels.Scooter(opts: any?): Model
	local o = type(opts) == "table" and opts or {}
	local color = typeof(o.Color) == "Color3" and o.Color or Color3.fromRGB(150, 220, 200)
	local light = o.Detail == "Light"
	local k = newKit("Scooter", o)
	local d = 1.25
	local r = d / 2
	cylX(k, "WheelF", 0, r, -1.9, 0.36, d, TYRE, M.Rubber)
	cylX(k, "WheelR", 0, r, 1.65, 0.4, d, TYRE, M.Rubber)
	cylX(k, "RimF", 0, r, -1.9, 0.44, d * 0.56, STEEL, M.Metal)
	cylX(k, "RimR", 0, r, 1.65, 0.48, d * 0.56, STEEL, M.Metal)
	if not light then
		-- (v9.9) jantes à 5 branches des deux côtés, disque de frein, étrier
		for _, w in ipairs({ { -1.9, 0.44 }, { 1.65, 0.48 } }) do
			for _, sx in ipairs({ -1, 1 }) do
				for i = 0, 4 do
					local a = i / 5 * 2 * PI
					boxRotX(k, "RimSpoke", sx * (w[2] / 2 + 0.02), r + math.cos(a) * d * 0.14, w[1] + math.sin(a) * d * 0.14, 0.04, 0.08, d * 0.26, a - PI / 2, TRIM, M.Metal)
				end
			end
		end
		cylX(k, "BrakeDisc", -0.28, r, -1.9, 0.05, d * 0.5, CHROME, M.Metal)
		box(k, "Caliper", -0.36, -0.28, r + 0.15, r + 0.35, -1.75, -1.5, Color3.fromRGB(212, 40, 52), M.Metal)
	end
	-- garde-boue avant + fourche
	slab(k, "FrontFender", 0, 0.5, r + 0.62, -2.35, r + 0.7, -1.5, 0.12, color, M.SmoothPlastic)
	rod(k, "ForkLeg", Vector3.new(0.14, r, -1.9), Vector3.new(0.14, 2.2, -1.62), 0.12, TRIM, M.Metal)
	-- tablier (bouclier) + plancher
	slab(k, "LegShield", 0, 1.2, 0.95, -1.25, 3.0, -1.55, 0.18, color, M.SmoothPlastic)
	box(k, "Floorboard", -0.55, 0.55, 0.7, 0.9, -1.25, 0.35, color, M.SmoothPlastic)
	box(k, "FloorMat", -0.48, 0.48, 0.9, 0.93, -1.15, 0.25, TRIM, M.Rubber)
	-- capot arrière arrondi (flancs bombés)
	box(k, "RearBody", -0.62, 0.62, 0.75, 1.95, 0.35, 2.25, color, M.SmoothPlastic, true)
	for _, sx in ipairs({ -1, 1 }) do
		cylZ(k, "Cowl", sx * 0.5, 1.45, 1.35, 1.9, 0.9, color, M.SmoothPlastic)
	end
	wedge(k, "Tail", -0.55, 0.55, 1.55, 1.95, 2.25, 2.7, false, color, M.SmoothPlastic)
	-- selle biplace
	box(k, "Seat", -0.5, 0.5, 1.95, 2.3, 0.4, 2.2, Color3.fromRGB(70, 50, 44), M.Leather)
	-- colonne + guidon + phare
	rod(k, "Column", Vector3.new(0, 1.9, -1.45), Vector3.new(0, 3.3, -1.25), 0.3, color, M.SmoothPlastic)
	box(k, "HandlebarCover", -0.5, 0.5, 3.25, 3.55, -1.5, -1.05, color, M.SmoothPlastic)
	rod(k, "Handlebar", Vector3.new(-0.95, 3.42, -1.15), Vector3.new(0.95, 3.42, -1.15), 0.1, TRIM, M.Metal)
	cylZ(k, "Headlight", 0, 3.4, -1.55, 0.1, 0.4, LAMP, M.Glass)
	box(k, "Taillight", -0.25, 0.25, 1.62, 1.82, 2.66, 2.74, TAIL, M.Glass)
	if not light then
		for _, sx in ipairs({ -1, 1 }) do
			cylX(k, "Grip", sx * 0.85, 3.42, -1.15, 0.3, 0.16, TRIM, M.Rubber)
			rod(k, "MirrorStem", Vector3.new(sx * 0.6, 3.5, -1.2), Vector3.new(sx * 0.75, 4.0, -1.25), 0.05, CHROME, M.Metal)
			cylZ(k, "Mirror", sx * 0.78, 4.08, -1.25, 0.06, 0.34, CHROME, M.Metal)
		end
		box(k, "TopCase", -0.5, 0.5, 2.0, 2.65, 2.1, 2.85, WHITE, M.SmoothPlastic)
		box(k, "Stand", -0.3, 0.3, 0.02, 0.2, 0.1, 0.3, STEEL, M.Metal)
	end
	return finish(k, "Scooter", -1.0, 1.0, 0, 4.2, -2.6, 2.8, false)
end

-- Arceaux à vélos (inox) : `count` arceaux en U renversé, espacés de `gap`
-- (le long de X, arceaux dans le plan YZ) ; opts.Plate = plaque au sol
function VehicleModels.BikeRack(opts: any?): Model
	local o = type(opts) == "table" and opts or {}
	local count = math.clamp(tonumber(o.Count) or 3, 1, 8)
	local gap = tonumber(o.Gap) or 2.2
	local k = newKit("BikeRack", o)
	local span = (count - 1) * gap
	for i = 0, count - 1 do
		local x = -span / 2 + i * gap
		for _, z in ipairs({ -0.85, 0.85 }) do
			cylY(k, "HoopLeg", x, 0, 2.3, z, 0.16, STEEL, M.Metal)
		end
		cylZ(k, "HoopTop", x, 2.4, 0, 1.7, 0.16, STEEL, M.Metal)
		-- coudes (petits coins arrondis ; opts.Bends = false : version serveur)
		for _, z in ipairs(if o.Bends == false then {} else { -0.85, 0.85 }) do
			local p = newPart(k, "Part", "HoopBend", Vector3.new(0.2, 0.2, 0.2), CFrame.new(x, 2.33, z), STEEL, M.Metal)
			;(p :: Part).Shape = Enum.PartType.Ball
		end
	end
	if o.Plate ~= false then
		box(k, "RackPlate", -span / 2 - 1.3, span / 2 + 1.3, 0, 0.06, -1.5, 1.5, Color3.fromRGB(150, 150, 164), M.DiamondPlate)
	end
	return finish(k, "BikeRack", -span / 2 - 1.3, span / 2 + 1.3, 0, 2.5, -1.5, 1.5, false)
end

----------------------------------------------------------------------
-- 🚚 Camion de livraison, 🌮 food truck (cabine commune)
----------------------------------------------------------------------

type Truck = { L: number, W: number, CabL: number, BoxH: number, WheelD: number }

-- (v9.9, CARS99) Cabine avancée réaliste + châssis + roues d'un petit
-- camion (avant vers -Z) : coins avant arrondis, capot court, pare-brise
-- encadré, vitres latérales, toit aux bords roulés, passage de roue avant
-- en ARC, calandre, optiques, pare-chocs, rétroviseurs de camion, portes,
-- marchepied ; à l'arrière : longerons, garde-boue noirs, barres
-- anti-encastrement ; roues marquées "Wheel" / "Spin".
-- Renvoie le début (z) de la caisse et la hauteur de son plancher.
local function truckBase(k: K, t: Truck, cabColor: Color3, full: boolean): (number, number)
	local hw = t.W / 2
	local zF, zB = -t.L / 2, t.L / 2
	local D = t.WheelD
	local r = D / 2
	local ra = r + 0.28
	local low, belt, roof = 0.85, 3.35, 5.7
	local hoodF = belt - 0.5
	local cabEnd = zF + t.CabL
	local axF, axR = zF + 2.75, zB - 2.7
	local tw = 0.9
	local rc = 0.6
	local archTop = r + ra
	local boxY = archTop + 0.15
	local wsBase, wsTop = zF + 1.25, zF + 2.15
	-- châssis : 2 longerons
	for _, sx in ipairs({ -1, 1 }) do
		local x0, x1 = sx * (hw - 1.9), sx * (hw - 1.45)
		box(k, "ChassisRail", math.min(x0, x1), math.max(x0, x1), 0.95, 1.55, cabEnd - 0.5, zB - 0.25, TRIM, M.Metal)
	end
	-- ░ cabine : coins arrondis, face avant, capot court ░
	for _, sx in ipairs({ -1, 1 }) do
		cylY(k, "CabCorner", sx * (hw - rc), low, hoodF, zF + rc + 0.05, rc * 2, cabColor, M.SmoothPlastic, true)
	end
	box(k, "CabFront", -hw + rc, hw - rc, low, hoodF, zF + 0.05, zF + rc + 0.05, cabColor, M.SmoothPlastic, true)
	wedge(k, "CabNose", -hw + 0.05, hw - 0.05, hoodF, belt, zF + 0.05, wsBase, true, cabColor, M.SmoothPlastic)
	box(k, "CabUpperLow", -hw, hw, archTop, belt, zF + rc + 0.05, cabEnd, cabColor, M.SmoothPlastic, true)
	-- bas de cabine découpé autour de la roue avant
	box(k, "CabCore", -hw + tw + 0.35, hw - tw - 0.35, low, archTop, zF + rc + 0.05, cabEnd, cabColor, M.SmoothPlastic)
	for _, sx in ipairs({ -1, 1 }) do
		local xo, xi = sx * hw, sx * (hw - 0.25)
		local lo, hi = math.min(xo, xi), math.max(xo, xi)
		if axF - ra - (zF + rc + 0.05) > 0.05 then
			box(k, "CabSide", lo, hi, low, archTop, zF + rc + 0.05, axF - ra, cabColor, M.SmoothPlastic)
		end
		archPanel(k, "CabArch", xo, xi, axF, r, ra, archTop, if full then 4 else 3, cabColor, M.SmoothPlastic)
		box(k, "CabSide", lo, hi, low, archTop, axF + ra, cabEnd, cabColor, M.SmoothPlastic)
		-- passage de roue sombre (toit + fond)
		local wx0, wx1 = sx * (hw - tw - 0.35), sx * (hw - 0.25)
		box(k, "WheelWell", math.min(wx0, wx1), math.max(wx0, wx1), archTop - 0.1, archTop - 0.02, axF - ra + 0.1, axF + ra - 0.1, TRIM, M.SmoothPlastic)
		cylX(k, "WheelWell", sx * (hw - tw - 0.3), r, axF, 0.08, ra * 2, TRIM, M.SmoothPlastic)
		-- lèvre noire autour de l'arche
		if full then
			for i = 0, 3 do
				local a = -PI / 2 + (i + 0.5) * PI / 4
				local rr = ra + 0.08
				local lx0, lx1 = sx * (hw - 0.1), sx * (hw + 0.05)
				boxRotX(k, "ArchLip", (lx0 + lx1) / 2, r + math.cos(a) * rr, axF + math.sin(a) * rr, math.abs(lx1 - lx0), 0.16, 2 * rr * math.tan(PI / 8) + 0.03, a, TRIM, M.Rubber)
			end
		end
	end
	-- ░ pare-brise encadré, vitres, montants, toit arrondi ░
	slab(k, "WindshieldFrame", 0, t.W - 0.4, belt - 0.02, wsBase - 0.05, roof - 0.05, wsTop + 0.02, 0.1, TRIM, M.SmoothPlastic)
	local ws = slab(k, "Windshield", 0, t.W - 0.7, belt + 0.05, wsBase - 0.08, roof - 0.15, wsTop - 0.04, 0.06, GLASS, M.Glass)
	ws.Transparency = 0.35
	ws.Reflectance = 0.15
	for _, sx in ipairs({ -1, 1 }) do
		local x0, x1 = sx * (hw - 0.02), sx * (hw - 0.12)
		box(k, "CabGlass", math.min(x0, x1), math.max(x0, x1), belt, roof - 0.12, wsTop, cabEnd - 0.35, GLASS, M.Glass).Transparency = 0.35
		rod(k, "PillarA", Vector3.new(sx * (hw - 0.2), belt, wsBase), Vector3.new(sx * (hw - 0.2), roof - 0.1, wsTop), 0.22, TRIM, M.SmoothPlastic)
		local px0, px1 = sx * (hw + 0.03), sx * (hw - 0.17)
		box(k, "PillarB", math.min(px0, px1), math.max(px0, px1), belt, roof - 0.1, cabEnd - 0.45, cabEnd - 0.2, TRIM, M.SmoothPlastic)
		box(k, "PillarB", math.min(px0, px1), math.max(px0, px1), belt, roof - 0.1, wsTop - 0.05, wsTop + 0.12, TRIM, M.SmoothPlastic)
	end
	box(k, "CabBack", -hw, hw, belt, roof - 0.1, cabEnd - 0.2, cabEnd, cabColor, M.SmoothPlastic)
	box(k, "CabRoof", -hw + 0.3, hw - 0.3, roof - 0.12, roof + 0.2, wsTop - 0.05, cabEnd, cabColor, M.SmoothPlastic, true)
	for _, sx in ipairs({ -1, 1 }) do
		cylZ(k, "RoofEdge", sx * (hw - 0.3), roof + 0.02, (wsTop - 0.05 + cabEnd) / 2, cabEnd - wsTop + 0.05, 0.36, cabColor, M.SmoothPlastic)
	end
	cylX(k, "RoofNose", 0, roof + 0.02, wsTop - 0.05, t.W - 0.6, 0.36, cabColor, M.SmoothPlastic)
	-- ░ face avant : calandre, optiques, pare-chocs ░
	local gy0, gy1 = low + 0.75, hoodF - 0.15
	box(k, "GrilleFrame", -hw * 0.44, hw * 0.44, gy0, gy1, zF - 0.03, zF + 0.2, CHROME, M.Metal)
	box(k, "Grille", -hw * 0.44 + 0.1, hw * 0.44 - 0.1, gy0 + 0.08, gy1 - 0.08, zF - 0.09, zF + 0.12, TRIM, M.DiamondPlate) -- (v10 : 0,06 devant le cadre, plus de z-fight)
	if full then
		for j = 1, 3 do
			local y = gy0 + j * (gy1 - gy0) / 4
			box(k, "GrilleBar", -hw * 0.44 + 0.12, hw * 0.44 - 0.12, y - 0.04, y + 0.04, zF - 0.15, zF - 0.1, CHROME, M.Metal)
		end
		cylZ(k, "Badge", 0, (gy0 + gy1) / 2, zF - 0.19, 0.06, 0.45, CHROME, M.Metal)
	end
	for _, sx in ipairs({ -1, 1 }) do
		local h0, h1 = sx * (hw * 0.5), sx * (hw - rc * 0.4)
		local lo, hi = math.min(h0, h1), math.max(h0, h1)
		box(k, "HeadlightHousing", lo, hi, gy0 + 0.05, gy1, zF - 0.04, zF + 0.15, TRIM, M.SmoothPlastic)
		box(k, "Headlight", lo + 0.06, hi - 0.06, gy0 + 0.25, gy1 - 0.06, zF - 0.07, zF - 0.01, LAMP, M.Glass)
		if full then
			box(k, "HeadlightDRL", lo + 0.06, hi - 0.06, gy0 + 0.1, gy0 + 0.18, zF - 0.08, zF - 0.02, DRL, M.SmoothPlastic)
			local i0, i1 = sx * (hw - rc * 0.4), sx * (hw - 0.02)
			box(k, "Indicator", math.min(i0, i1), math.max(i0, i1), gy0 + 0.25, gy1 - 0.06, zF + 0.1, zF + 0.35, AMBER, M.SmoothPlastic):SetAttribute("Side", sx)
		end
	end
	box(k, "Bumper", -hw - 0.05, hw + 0.05, 0.55, low + 0.6, zF - 0.15, zF + 0.55, TRIM, M.Plastic)
	box(k, "PlateFront", -1.0, 1.0, 0.75, 1.25, zF - 0.2, zF - 0.14, Color3.fromRGB(248, 248, 244), M.SmoothPlastic)
	if full then
		for _, sx in ipairs({ -1, 1 }) do
			cylZ(k, "FogLight", sx * (hw - 0.75), 1.0, zF - 0.16, 0.06, 0.34, LAMP, M.Glass)
		end
	end
	-- ░ rétroviseurs de camion, portes, marchepied ░
	for _, sx in ipairs({ -1, 1 }) do
		local base = Vector3.new(sx * (hw - 0.05), belt + 0.4, wsBase + 0.1)
		local tip = Vector3.new(sx * (hw + 0.55), belt + 0.7, wsBase - 0.2)
		rod(k, "MirrorArm", base, tip, 0.1, TRIM, M.Metal)
		box(k, "Mirror", tip.X - 0.16, tip.X + 0.16, belt + 0.35, belt + 1.45, tip.Z - 0.12, tip.Z + 0.12, TRIM, M.SmoothPlastic)
		if full then
			box(k, "MirrorGlass", tip.X - 0.12, tip.X + 0.12, belt + 0.42, belt + 1.38, tip.Z + 0.12, tip.Z + 0.15, CHROME, M.Glass)
			local sx0, sx1 = sx * (hw + 0.012), sx * (hw - 0.02)
			box(k, "DoorSeam", math.min(sx0, sx1), math.max(sx0, sx1), archTop + 0.05, belt, axF + ra + 0.15, axF + ra + 0.2, Color3.fromRGB(22, 22, 28), M.SmoothPlastic)
			local hx0, hx1 = sx * (hw - 0.02), sx * (hw + 0.07)
			box(k, "Handle", math.min(hx0, hx1), math.max(hx0, hx1), belt - 0.45, belt - 0.32, cabEnd - 1.1, cabEnd - 0.6, TRIM, M.SmoothPlastic)
			local st0, st1 = sx * (hw - 0.6), sx * (hw + 0.1)
			box(k, "CabStep", math.min(st0, st1), math.max(st0, st1), low - 0.25, low - 0.1, axF + ra + 0.15, cabEnd - 0.1, TRIM, M.DiamondPlate)
		end
	end
	-- ░ poste de conduite (vu par les vitres) ░
	if full then
		for _, sx in ipairs({ -1, 1 }) do
			local x = sx * hw * 0.4
			box(k, "CabSeat", x - 0.65, x + 0.65, belt - 0.95, belt - 0.6, cabEnd - 1.7, cabEnd - 0.55, Color3.fromRGB(60, 60, 70), M.Fabric)
			slab(k, "CabSeatBack", x, 1.2, belt - 0.6, cabEnd - 0.5, roof - 0.9, cabEnd - 0.35, 0.3, Color3.fromRGB(60, 60, 70), M.Fabric)
		end
		box(k, "CabDash", -hw + 0.3, hw - 0.3, belt - 0.5, belt + 0.1, wsBase + 0.15, wsBase + 0.9, Color3.fromRGB(50, 50, 60), M.SmoothPlastic)
		local sw = newPart(k, "Part", "SteeringWheel", Vector3.new(0.1, 1.1, 1.1), CFrame.new(-hw * 0.45, belt + 0.4, wsBase + 1.4) * CFrame.Angles(math.rad(-30), 0, 0) * CFrame.Angles(0, PI / 2, 0), TRIM, M.SmoothPlastic)
		;(sw :: Part).Shape = Enum.PartType.Cylinder
	end
	-- ░ arrière : garde-boue noirs, barres anti-encastrement, feux, pare-chocs ░
	for _, sx in ipairs({ -1, 1 }) do
		local x0, x1 = sx * (hw - tw - 0.25), sx * (hw + 0.06)
		local n = if full then 4 else 2
		for i = 0, n - 1 do
			local a = -PI / 2 + (i + 0.5) * PI / n
			local rr = ra - 0.05
			boxRotX(k, "Mudguard", (x0 + x1) / 2, r + math.cos(a) * rr, axR + math.sin(a) * rr, math.abs(x1 - x0), 0.1, 2 * rr * math.tan(PI / (2 * n)) + 0.03, a, TRIM, M.Plastic)
		end
		if full then
			local g0, g1 = sx * (hw - 0.25), sx * (hw - 0.1)
			for _, y in ipairs({ 1.15, 1.75 }) do
				box(k, "SideGuard", math.min(g0, g1), math.max(g0, g1), y - 0.08, y + 0.08, axF + ra + 1.4, axR - ra - 0.25, STEEL, M.Metal)
			end
		end
		local t0, t1 = sx * (hw - 0.15), sx * (hw - 0.75)
		box(k, "Taillight", math.min(t0, t1), math.max(t0, t1), boxY + 0.25, boxY + 1.05, zB - 0.02, zB + 0.1, TAIL, M.Glass)
		if full then
			box(k, "RearIndicator", math.min(t0, t1), math.max(t0, t1), boxY + 1.08, boxY + 1.35, zB - 0.02, zB + 0.1, AMBER, M.SmoothPlastic):SetAttribute("Side", sx)
		end
	end
	box(k, "RearBumper", -hw + 0.3, hw - 0.3, 0.75, 1.2, zB - 0.4, zB - 0.1, STEEL, M.Metal)
	box(k, "PlateRear", -0.9, 0.9, 1.25, 1.7, zB - 0.26, zB - 0.2, Color3.fromRGB(248, 248, 244), M.SmoothPlastic)
	-- ░ roues ░
	local index = 0
	for _, z in ipairs({ axF, axR }) do
		for _, sx in ipairs({ -1, 1 }) do
			index += 1
			heavyWheel(k, index, sx * (hw - tw / 2 - 0.08), r, z, sx, D, tw, full, nil)
		end
	end
	return cabEnd, boxY
end

function VehicleModels.DeliveryVan(opts: any?): Model
	local o = type(opts) == "table" and opts or {}
	local full = o.Detail ~= "Light"
	local color = typeof(o.Color) == "Color3" and o.Color or Color3.fromRGB(255, 214, 120)
	local k = newKit("DeliveryVan", o)
	local t: Truck = { L = 17, W = 6.6, CabL = 4.4, BoxH = 8.2, WheelD = 2.5 }
	local hw = t.W / 2
	local zB = t.L / 2
	local cabEnd, boxY = truckBase(k, t, color, full)
	-- caisse (fourgon, posée sur le châssis) + bande + logo
	local cargo = box(k, "CargoBox", -hw, hw, boxY, t.BoxH, cabEnd, zB, WHITE, M.SmoothPlastic, true)
	box(k, "CargoFloor", -hw + 0.05, hw - 0.05, boxY - 0.2, boxY, cabEnd + 0.05, zB - 0.02, Color3.fromRGB(70, 70, 80), M.Metal)
	for _, sx in ipairs({ -1, 1 }) do
		local x0, x1 = sx * (hw + 0.02), sx * (hw + 0.07)
		box(k, "CargoStripe", math.min(x0, x1), math.max(x0, x1), 3.0, 3.7, cabEnd + 0.3, zB - 0.3, color, M.SmoothPlastic)
	end
	for _, face in ipairs({ Enum.NormalId.Right, Enum.NormalId.Left }) do
		local g = sign(k, cargo, face, 22, "📦 Dopa Express", Color3.fromRGB(236, 72, 140), nil, Enum.Font.FredokaOne, false)
		local title = g:FindFirstChild("Text") :: TextLabel?
		if title then
			title.Size = UDim2.fromScale(0.94, 0.5)
			title.Position = UDim2.fromScale(0.03, 0.12)
		end
		local sub = Instance.new("TextLabel")
		sub.Name = "Slogan"
		sub.BackgroundTransparency = 1
		sub.Size = UDim2.fromScale(0.8, 0.2)
		sub.Position = UDim2.fromScale(0.1, 0.66)
		sub.Font = Enum.Font.GothamBold
		sub.TextScaled = true
		sub.TextColor3 = Color3.fromRGB(92, 58, 96)
		sub.Text = k.T("Fast delivery all over town 🚚")
		sub:SetAttribute("LocText", "Fast delivery all over town 🚚")
		sub.Parent = g
	end
	-- portes arrière (2 battants + poignées)
	for _, sx in ipairs({ -1, 1 }) do
		local x0, x1 = sx * 0.04, sx * (hw - 0.05)
		box(k, "RearDoor", math.min(x0, x1), math.max(x0, x1), boxY + 0.15, t.BoxH - 0.15, zB, zB + 0.06, Color3.fromRGB(236, 236, 240), M.SmoothPlastic)
		if full then
			box(k, "DoorHandle", sx * 0.25 - 0.06, sx * 0.25 + 0.06, 3.8, 4.8, zB + 0.06, zB + 0.12, TRIM, M.Metal)
		end
	end
	-- déflecteur au-dessus de la cabine
	wedge(k, "Deflector", -hw + 0.3, hw - 0.3, 5.92, t.BoxH - 0.2, cabEnd - 2.0, cabEnd, true, color, M.SmoothPlastic)
	return finish(k, "DeliveryVan", -hw - 0.5, hw + 0.5, 0.6, t.BoxH, -t.L / 2 - 0.1, zB + 0.12, o.Solid == true)
end

function VehicleModels.FoodTruck(opts: any?): Model
	local o = type(opts) == "table" and opts or {}
	local full = o.Detail ~= "Light"
	local color = typeof(o.Color) == "Color3" and o.Color or Color3.fromRGB(255, 214, 120)
	local k = newKit("FoodTruck", o)
	local t: Truck = { L = 16, W = 6.4, CabL = 4.2, BoxH = 7.8, WheelD = 2.4 }
	local hw = t.W / 2
	local zB = t.L / 2
	local cabEnd, boxY = truckBase(k, t, color, full)
	-- caisse avec passe-plat côté droit (+X) : bas, haut, montants
	local h0, h1 = math.max(3.4, boxY + 0.5), 6.2 -- ouverture du passe-plat
	local w0, w1 = cabEnd + 1.0, zB - 1.0
	box(k, "BoxLow", -hw, hw, boxY, h0, cabEnd, zB, color, M.SmoothPlastic, true)
	box(k, "BoxTop", -hw, hw, h1, t.BoxH, cabEnd, zB, color, M.SmoothPlastic, true)
	-- (niche de cuisine de 1,8 de profondeur derrière le passe-plat)
	box(k, "BoxLeft", -hw, hw - 1.8, h0, h1, cabEnd, zB, color, M.SmoothPlastic)
	box(k, "HatchPostF", hw - 1.8, hw, h0, h1, cabEnd, w0, color, M.SmoothPlastic)
	box(k, "HatchPostR", hw - 1.8, hw, h0, h1, w1, zB, color, M.SmoothPlastic)
	-- intérieur vu par le passe-plat : plan de travail inox, étagère, bocaux
	box(k, "Kitchen", hw - 1.75, hw - 0.45, h0, h0 + 0.9, w0, w1, Color3.fromRGB(210, 214, 222), M.Metal)
	box(k, "Shelf", hw - 1.8, hw - 1.45, h0 + 1.5, h0 + 1.6, w0, w1, STEEL, M.Metal)
	if full then
		for i = 0, 3 do
			local z = w0 + 0.8 + i * (w1 - w0 - 1.6) / 3
			cylY(k, "Jar", hw - 1.62, h0 + 1.6, h0 + 2.1, z, 0.34, ({ Color3.fromRGB(255, 140, 60), Color3.fromRGB(120, 200, 90), Color3.fromRGB(230, 70, 60), Color3.fromRGB(255, 214, 120) })[i + 1], M.Glass)
		end
	end
	-- comptoir extérieur + auvent rayé relevé
	box(k, "Counter", hw, hw + 0.9, h0 - 0.1, h0 + 0.05, w0, w1, Color3.fromRGB(206, 164, 110), M.Wood)
	local stripes = 6
	for i = 0, stripes - 1 do
		local z0 = w0 - 0.2 + i * (w1 - w0 + 0.4) / stripes
		local z1 = w0 - 0.2 + (i + 1) * (w1 - w0 + 0.4) / stripes
		local p = box(k, "Awning", hw, hw + 2.2, h1 + 0.1, h1 + 0.25, z0, z1, if i % 2 == 0 then Color3.fromRGB(255, 132, 184) else WHITE, M.Fabric)
		p.CFrame = CFrame.new(hw, h1 + 0.1, (z0 + z1) / 2) * CFrame.Angles(0, 0, math.rad(-16)) * CFrame.new(1.1, 0.075, 0)
	end
	-- menu (tableau noir) + enseigne sur le toit + taco géant
	local menu = box(k, "Menu", hw + 0.02, hw + 0.08, 4.0, 5.8, zB - 0.95, zB - 0.25, Color3.fromRGB(40, 44, 48), M.Slate)
	sign(k, menu, Enum.NormalId.Right, 30, "🌮 Tacos · 🌯 Burritos · 🥤 Drinks", WHITE, nil, Enum.Font.FredokaOne, true)
	local board = box(k, "TruckSign", -0.15, 0.15, t.BoxH + 0.1, t.BoxH + 1.6, cabEnd + 0.8, zB - 0.8, WHITE, M.SmoothPlastic)
	sign(k, board, Enum.NormalId.Right, 30, "🌮 Taco Party", Color3.fromRGB(236, 72, 140), nil, Enum.Font.FredokaOne, false)
	sign(k, board, Enum.NormalId.Left, 30, "🌮 Taco Party", Color3.fromRGB(236, 72, 140), nil, Enum.Font.FredokaOne, false)
	for _, z in ipairs({ cabEnd + 1.4, zB - 1.4 }) do
		box(k, "SignPost", -0.1, 0.1, t.BoxH, t.BoxH + 0.15, z - 0.1, z + 0.1, TRIM, M.Metal)
	end
	if full then
		-- guirlande de fanions sous l'auvent + marchepied
		for i = 0, 4 do
			local z = w0 + 0.4 + i * (w1 - w0 - 0.8) / 4
			wedge(k, "Bunting", hw + 1.3, hw + 1.36, h1 - 0.7, h1 - 0.25, z - 0.25, z + 0.25, i % 2 == 0, if i % 2 == 0 then LILAC else Color3.fromRGB(128, 222, 190), M.Fabric)
		end
		box(k, "Step", hw, hw + 0.8, 0.7, 0.85, w0 + 0.5, w0 + 2.0, STEEL, M.DiamondPlate)
	end
	return finish(k, "FoodTruck", -hw - 0.5, hw + 2.4, 0.6, t.BoxH + 2.8, -t.L / 2 - 0.1, zB + 0.1, o.Solid == true)
end

return VehicleModels
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="351">
        <Properties>
          <string name="Name">WorldLayout</string>
          <string name="Source"><![CDATA[--[[
	WorldLayout (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > WorldLayout

	🚶 Dopamine Town : géométrie PARTAGÉE serveur + client (+ tests), sans
	aucun service Roblox (sauf les petites fonctions CFrame, en jeu seulement).
	Le serveur s'en sert pour placer les parcelles, faire apparaître les
	personnages devant les portes et vérifier les sièges / les intrus ; le
	client pour construire les maisons au même endroit et pour convertir les
	déplacements de meubles 3D <-> positions 2D (X / Y de HouseCommon.Placed).
	Une seule source de vérité : la 2D.

	Repère d'une maison ("local") : x vers la DROITE d'un visiteur qui regarde
	la façade depuis la place, y vers le haut (0 = sol de la parcelle),
	d = profondeur depuis la façade (0 = face avant du mur de devant).
	Colonnes de la maison : [pièce 1] [pièce 2]... avec la cage d'escalier
	(HALL_W) là où la maison 2D dessine l'entrée (HallAfter : à droite, ou
	au milieu pour le manoir) ; étage 1 = rez-de-chaussée (comme
	HouseCommon.SlotCell), posé sur un soubassement de PLINTH studs.
	Chaque pièce = une coque House3DScene.BuildRoomShell (murs de WALL_T HORS
	de l'intérieur) dont les objets sont placés par House3DScene.PlaceItems.
	Correspondance 2D -> 3D d'une pièce (HouseRoom : X 0..1 de gauche à droite,
	Y 0..1 de haut en bas, WallRatio = limite mur / sol) : MÊME calcul que
	House3DLayout (perspective des murs de côté 2D, courbe de profondeur) ;
	FloorInverse / WallInverse le défont (déplacer un meuble avec l'avatar).
	Rotation (champ R facultatif d'un objet posé) : degrés entiers multiples de
	15 dans 15..345 ; nil / absent = 0 (anciennes sauvegardes).
]]

local WorldLayout = {}

----------------------------------------------------------------------
-- Dimensions (studs)
----------------------------------------------------------------------

WorldLayout.PX = 0.036 -- studs par px de maquette 2D (objets à taille d'avatar)
WorldLayout.ROOM_BASE_PX = 760 -- largeur 2D d'une pièce de largeur 1 (= HouseRoom.BASE_WIDTH)
WorldLayout.ROOM_HEIGHT_PX = 440 -- hauteur 2D d'une pièce (= HouseRoom.HEIGHT)
WorldLayout.DEPTH = 24 -- profondeur INTÉRIEURE d'une pièce (v9.4 : 24, place pour un vrai escalier)
WorldLayout.WALL_H = 12 -- hauteur sous plafond
WorldLayout.SLAB = 1 -- épaisseur d'un plancher
WorldLayout.PLINTH = 2 -- (v9.4) soubassement : le rez-de-chaussée est à PLINTH + SLAB (perron à marches)
WorldLayout.STORY = 13 -- WALL_H + SLAB
WorldLayout.HALL_W = 12 -- cage d'escalier (là où la maison 2D dessine l'entrée : voir HallAfter)
WorldLayout.WALL_T = 1 -- épaisseur des murs (= coque BuildRoomShell : murs HORS de l'intérieur)
WorldLayout.WALL_RATIO = 0.46 -- (valeur par défaut : Config.House.WallRatio)
WorldLayout.ROOF_H = 9
-- (= House3DLayout : murs de côté en perspective de la pièce 2D, courbe de profondeur)
WorldLayout.SIDE_PX = 42
WorldLayout.DEPTH_CURVE = 1.35

-- Parcelles
WorldLayout.PLOT_W = 176 -- largeur (le manoir 3 x 4 et ses tourelles tiennent dedans)
WorldLayout.PLOT_D = 84 -- profondeur
WorldLayout.GARDEN_D = 30 -- jardin entre la rue et la façade
WorldLayout.MIN_PLOTS = 4
WorldLayout.MAX_PLOTS = 50 -- (v10 LAYOUT10 : 12 -> 50, la grande ville ; voir Districts)
WorldLayout.PLAZA_R = 64 -- rayon de la place centrale
WorldLayout.SPAWN_FRONT = 7 -- (studs) apparition devant la porte
-- (v9.4) Rues de la ville : boulevard polygonal (un côté droit devant chaque
-- parcelle), avenue principale de l'entrée (+Z) à la place
WorldLayout.ROAD_W = 20 -- chaussée du boulevard (2 voies)
WorldLayout.WALK_W = 6 -- trottoirs
WorldLayout.AVENUE_W = 16 -- chaussée de l'avenue / des rues
WorldLayout.GROUND_Y = 0.4 -- dessus du pré et des pelouses (repère : Origin().Y)
WorldLayout.ROAD_Y = 0.5 -- dessus de la chaussée
WorldLayout.WALK_Y = 1 -- dessus des trottoirs et de la place (bordure de 0,5)
WorldLayout.GATE_BACK = 60 -- porte de la ville : distance depuis le bord des parcelles côté rue
WorldLayout.SPAWN_INSIDE = 12 -- apparition : juste à l'intérieur de la porte
WorldLayout.TOWN_MARGIN = 140 -- pré au-delà du fond des parcelles (murs invisibles) ; v9.8 : 80 -> 140 (MégaDopa agrandi)

-- Porte d'entrée (dans la cage d'escalier) et passages entre pièces
-- (v9.8 HOUSE98 : "la tête touche" -> toutes les portes font au moins
-- 6 x 9 studs : 6,5 x 9,5 ; la porte d'entrée devient une porte DOUBLE)
WorldLayout.DOOR_W = 6.5
WorldLayout.DOOR_H = 9.5
WorldLayout.PASS_W = 6.5 -- passage entre deux pièces / cage -> pièce (centré en profondeur)
WorldLayout.PASS_H = 9.5

-- Escalier (v9.9 HOUSE99 : "l'escalier est au milieu de l'entrée, ça n'a
-- aucun sens") : une volée droite par étage (étage k -> k+1) LE LONG DU MUR
-- DE DROITE de la cage (StairSpan : bande de STAIR_W), plus jamais face à la
-- porte. Le couloir d'entrée (CorridorSpan, ~7,4 studs) reste libre à gauche,
-- de la porte d'entrée jusqu'à la porte de derrière (vestibule meublé devant).
-- 18 contremarches de STORY / 18 (0,72 stud) ; bas de la volée à STAIR_D0
-- (le battant de la porte d'entrée s'ouvre devant), haut au palier du fond
-- (StairRun : STAIR_D1, ou MANSION_STAIR_D1 : dans le manoir, le passage vers
-- les pièces de DROITE est au fond de la cage, derrière le haut de la volée).
-- Giron = longueur / 17 : ~1,06 stud (pente ~34°) ; manoir ~0,91 (~38°).
-- Les volées des étages sont empilées dans la même bande (12 studs libres
-- entre deux volées). Trémie dans le plancher du dessus (StairHole) : là où
-- le nez des marches dépasse WALL_H - HEADROOM (>= 8,5 studs libres).
-- Collision : une rampe lisse invisible (pas de marche où l'avatar accroche).
-- Tout est dérivé de STORY / DEPTH / WALL_T : les pièces peuvent changer de taille.
WorldLayout.STAIR_W = 4.3 -- largeur de la bande (limon côté couloir compris)
WorldLayout.STAIR_RISERS = 18
WorldLayout.STAIR_STEPS = 18 -- (compat : = STAIR_RISERS)
WorldLayout.STAIR_RISE = WorldLayout.STORY / 18 -- 0,72
WorldLayout.STAIR_D0 = WorldLayout.WALL_T + 2.8 -- 3,8 : premier nez de marche (d)
WorldLayout.STAIR_D1 = WorldLayout.WALL_T + WorldLayout.DEPTH - 3.2 -- 21,8 : arrivée (palier du fond)
WorldLayout.MANSION_BACK_PASS = 5 -- (manoir) passage cage -> pièces de droite, au fond
WorldLayout.MANSION_STAIR_D1 = WorldLayout.WALL_T + WorldLayout.DEPTH - 0.4 - WorldLayout.MANSION_BACK_PASS - 0.3 -- 19,3
WorldLayout.STAIR_TREAD = (WorldLayout.STAIR_D1 - WorldLayout.STAIR_D0) / (WorldLayout.STAIR_RISERS - 1) -- 1,06
-- (v9.8 HOUSE98 : 7,5 -> 8,5 studs de hauteur libre)
WorldLayout.HEADROOM = 8.5
WorldLayout.STAIR_HOLE_D0 = WorldLayout.STAIR_D0
	+ (WorldLayout.WALL_H - WorldLayout.HEADROOM - WorldLayout.STAIR_RISE) / WorldLayout.STAIR_RISE * WorldLayout.STAIR_TREAD -- ~7,9

-- (v9.8 HOUSE98) Porte de DERRIÈRE (vers le jardin) : au rez-de-chaussée,
-- dans le mur du fond de la cage, derrière l'escalier (couloir du fond
-- STAIR_D1..DEPTH, toute la largeur de la cage), même taille que la porte
-- d'entrée ; dehors : palier + BACK_STEPS marches + rampe invisible.
WorldLayout.BACK_LANDING = 3 -- profondeur du palier (studs)
WorldLayout.BACK_STEPS = 3 -- contremarches jusqu'à la pelouse
WorldLayout.BACK_TREAD = 1.25 -- giron d'une marche
WorldLayout.BACK_WALL_OUT = 0.3 -- le mur du fond déborde de 0,3 derrière les pièces

export type SizeDef = { Floors: number, Columns: number, Width: number?, Exterior: string?, Id: string? }

-- Style extérieur (= HouseExterior 2D) d'une taille de maison
local STYLE_BY_SIZE = { Studio = "Cottage", Apartment = "Townhouse", Loft = "Loft", Mansion = "Mansion" }
function WorldLayout.StyleOf(size: SizeDef?): string
	if type(size) ~= "table" then
		return "Cottage"
	end
	local style = size.Exterior or (size.Id and STYLE_BY_SIZE[size.Id :: string])
	return type(style) == "string" and style or "Cottage"
end

local function finite(value: any, default: number): number
	if type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge then
		return value
	end
	return default
end

local function sizeOf(size: SizeDef?): (number, number, number)
	local floors = math.clamp(math.floor(finite(size and size.Floors, 1)), 1, 6)
	local columns = math.clamp(math.floor(finite(size and size.Columns, 1)), 1, 8)
	local width = math.clamp(finite(size and size.Width, 1), 0.5, 2)
	return floors, columns, width
end

local function sizeOfColumns(size: SizeDef?): number
	local _, columns = sizeOf(size)
	return columns
end

-- Largeur 2D (px de maquette) d'une pièce (pour HouseSurfaces / House3DLayout)
function WorldLayout.RoomWidthPx(size: SizeDef?): number
	local _, _, width = sizeOf(size)
	return math.floor(WorldLayout.ROOM_BASE_PX * width + 0.5)
end

-- Largeur INTÉRIEURE (studs) d'une pièce pour une taille de maison
function WorldLayout.RoomWidth(size: SizeDef?): number
	return WorldLayout.RoomWidthPx(size) * WorldLayout.PX
end

export type Dims = {
	Floors: number,
	Columns: number,
	RoomW: number, -- largeur intérieure d'une pièce
	Pitch: number, -- largeur d'une colonne (pièce + ses deux murs)
	Width: number, -- largeur totale (cage + colonnes)
	Depth: number, -- profondeur totale (pièce + murs avant / arrière)
	Height: number, -- jusqu'au plafond du dernier étage
	Left: number, -- x du bord gauche
}

function WorldLayout.Dims(size: SizeDef?): Dims
	local floors, columns = sizeOf(size)
	local roomW = WorldLayout.RoomWidth(size)
	local pitch = roomW + 2 * WorldLayout.WALL_T
	local width = WorldLayout.HALL_W + columns * pitch
	return {
		Floors = floors,
		Columns = columns,
		RoomW = roomW,
		Pitch = pitch,
		Width = width,
		Depth = WorldLayout.DEPTH + 2 * WorldLayout.WALL_T,
		Height = WorldLayout.PLINTH + floors * WorldLayout.STORY,
		Left = -width / 2,
	}
end

-- (v9.4) Nombre de colonnes de pièces À GAUCHE de la cage d'escalier : comme
-- la maison 2D (HouseExterior) — entrée à droite (chaumière, maison de ville,
-- loft), travée centrale pour le manoir
function WorldLayout.HallAfter(size: SizeDef?): number
	local _, columns = sizeOf(size)
	if WorldLayout.StyleOf(size) == "Mansion" then
		return math.floor(columns / 2)
	end
	return columns
end

-- Emplacement -> (étage, colonne) ; même règle que HouseCommon.SlotCell
function WorldLayout.SlotCell(size: SizeDef?, slot: number): (number, number)
	local _, columns = sizeOf(size)
	local s = math.max(1, math.floor(finite(slot, 1)))
	return math.floor((s - 1) / columns) + 1, (s - 1) % columns + 1
end

-- Hauteur (y) du DESSUS du plancher de l'étage `floor`
function WorldLayout.FloorY(floor: number): number
	return WorldLayout.PLINTH + (math.max(1, floor) - 1) * WorldLayout.STORY + WorldLayout.SLAB
end

-- Bords extérieurs (x gauche, x droite) d'une colonne de pièces (murs compris)
function WorldLayout.ColumnSpan(size: SizeDef?, column: number): (number, number)
	local dims = WorldLayout.Dims(size)
	local hall = column > WorldLayout.HallAfter(size) and WorldLayout.HALL_W or 0
	local x0 = dims.Left + hall + (column - 1) * dims.Pitch
	return x0, x0 + dims.Pitch
end

-- Bords de la cage d'escalier
function WorldLayout.HallSpan(size: SizeDef?): (number, number)
	local dims = WorldLayout.Dims(size)
	local x0 = dims.Left + WorldLayout.HallAfter(size) * dims.Pitch
	return x0, x0 + WorldLayout.HALL_W
end

-- Colonne de pièces qui contient x (repère local), nil = cage ou dehors
function WorldLayout.ColumnAt(size: SizeDef?, x: number): number?
	local dims = WorldLayout.Dims(size)
	local hall0, hall1 = WorldLayout.HallSpan(size)
	if x < dims.Left or x > dims.Left + dims.Width or (x > hall0 and x < hall1) then
		return nil
	end
	local rel = x - dims.Left - (x >= hall1 and WorldLayout.HALL_W or 0)
	return math.clamp(math.floor(rel / dims.Pitch) + 1, 1, dims.Columns)
end

-- x du milieu de la porte d'entrée = milieu de la cage (v9.9 : l'escalier
-- est le long du mur de droite, la porte donne sur le couloir d'entrée)
function WorldLayout.DoorX(size: SizeDef?): number
	local x0, x1 = WorldLayout.HallSpan(size)
	return (x0 + x1) / 2
end

-- (v9.9 HOUSE99) Épaisseur de la peau des murs intérieurs de la cage
WorldLayout.HALL_SKIN = 0.15

-- Bande de l'escalier (x gauche, x droite) : contre le mur de DROITE de la cage
-- (x gauche = limon côté couloir, x droite = face intérieure du mur)
function WorldLayout.StairSpan(size: SizeDef?): (number, number)
	local _, h1 = WorldLayout.HallSpan(size)
	local x1 = h1 - WorldLayout.HALL_SKIN
	return x1 - WorldLayout.STAIR_W, x1
end

-- (v9.9) Couloir d'entrée libre (x gauche, x droite) : de la face intérieure
-- du mur de gauche de la cage au limon de l'escalier
function WorldLayout.CorridorSpan(size: SizeDef?): (number, number)
	local h0 = WorldLayout.HallSpan(size)
	local s0 = WorldLayout.StairSpan(size)
	return h0 + WorldLayout.HALL_SKIN, s0
end

-- (v9.9) x du milieu du couloir (chemins des animaux, tests)
function WorldLayout.CorridorX(size: SizeDef?): number
	local x0, x1 = WorldLayout.CorridorSpan(size)
	return (x0 + x1) / 2
end

-- (v9.9) Une volée : premier nez de marche d0, arrivée d1 (d), giron, hauteur
-- de marche. Manoir : arrivée plus tôt (passage du fond vers la droite)
function WorldLayout.StairRun(size: SizeDef?): (number, number, number, number)
	local d0 = WorldLayout.STAIR_D0
	-- (pièces à DROITE de la cage = manoir : leur passage est au fond)
	local d1 = if WorldLayout.HallAfter(size) < sizeOfColumns(size) then WorldLayout.MANSION_STAIR_D1 else WorldLayout.STAIR_D1
	local tread = (d1 - d0) / (WorldLayout.STAIR_RISERS - 1)
	return d0, d1, tread, WorldLayout.STAIR_RISE
end

-- (v9.9) Trémie (d0, d1) dans le plancher de l'étage du dessus : là où le nez
-- des marches dépasse WALL_H - HEADROOM, jusqu'à l'arrivée
function WorldLayout.StairHole(size: SizeDef?): (number, number)
	local d0, d1, tread, rise = WorldLayout.StairRun(size)
	return d0 + (WorldLayout.WALL_H - WorldLayout.HEADROOM - rise) / rise * tread, d1
end

-- (v9.8 HOUSE98) Porte de derrière : x du milieu (repère local de la maison)
-- = milieu de la cage, comme la porte d'entrée (même largeur DOOR_W)
function WorldLayout.BackDoorX(size: SizeDef?): number
	return WorldLayout.DoorX(size)
end

-- d de la face EXTÉRIEURE du mur du fond (seuil de la porte de derrière,
-- au niveau du rez-de-chaussée FloorY(1))
function WorldLayout.BackDoorD(size: SizeDef?): number
	return WorldLayout.Dims(size).Depth + WorldLayout.BACK_WALL_OUT
end

-- d du pied des marches de derrière (sur la pelouse du jardin) : tout ce qui
-- est entre BackDoorD et ça, sur x = BackDoorX ± (DOOR_W / 2 + 1), doit
-- rester libre (palier, marches, rampe)
function WorldLayout.BackStepsD(size: SizeDef?): number
	return WorldLayout.BackDoorD(size) + WorldLayout.BACK_LANDING + WorldLayout.BACK_STEPS * WorldLayout.BACK_TREAD
end

-- Hauteur (au-dessus du sol de l'étage) de la rampe de collision à la
-- profondeur d (v9.9 : ligne du MILIEU des marches, parallèle aux nez : pieds
-- à ± une demi-marche des girons ; 0 avant d0 - giron / 2 ; au milieu de la
-- dernière marche, un bout plus raide rejoint le palier au ras, à d1)
function WorldLayout.StairHeight(d: number, size: SizeDef?): number
	local d0, d1, tread, rise = WorldLayout.StairRun(size)
	local knee = d1 - tread / 2
	local h
	if d <= knee then
		h = (d - d0 + tread / 2) / tread * rise
	else
		h = WorldLayout.STORY - rise + (d - knee) / (tread / 2) * rise
	end
	return math.clamp(h, 0, WorldLayout.STORY)
end

-- (v9.9) Hauteur du dessus du giron (nez de marche) sous d (0 avant la 1re marche)
function WorldLayout.StepTop(d: number, size: SizeDef?): number
	local d0, d1, tread, rise = WorldLayout.StairRun(size)
	if d < d0 then
		return 0
	elseif d >= d1 then
		return WorldLayout.STORY
	end
	return (math.floor((d - d0) / tread) + 1) * rise
end

-- Pente de la volée (degrés)
function WorldLayout.StairSlope(size: SizeDef?): number
	local _, _, tread, rise = WorldLayout.StairRun(size)
	return math.deg(math.atan2(rise, tread))
end

-- (v9.9 HOUSE99) Passage d'un côté d'une pièce (d0, d1 : profondeur, repère
-- local de la maison). Au milieu de la profondeur, sauf dans le manoir : le
-- passage de la cage vers les pièces de DROITE est au fond (derrière le haut
-- de la volée, qui longe ce mur). `side` = "Left" | "Right" (côté de la pièce)
function WorldLayout.PassageSpan(size: SizeDef?, column: number, side: string): (number, number)
	local T = WorldLayout.WALL_T
	local hall = WorldLayout.HallAfter(size)
	if side == "Left" and column == hall + 1 then
		local d1 = T + WorldLayout.DEPTH - 0.4
		return d1 - WorldLayout.MANSION_BACK_PASS, d1
	end
	local mid = T + WorldLayout.DEPTH / 2
	return mid - WorldLayout.PASS_W / 2, mid + WorldLayout.PASS_W / 2
end

-- (v9.9) Passages des murs de la cage : { Left = { d0, d1 }?, Right = { d0, d1 }? }
function WorldLayout.HallPassages(size: SizeDef?): { [string]: { number } }
	local hall = WorldLayout.HallAfter(size)
	local columns = sizeOfColumns(size)
	local out: { [string]: { number } } = {}
	if hall >= 1 then
		local a, b = WorldLayout.PassageSpan(size, hall, "Right")
		out.Left = { a, b }
	end
	if hall < columns then
		local a, b = WorldLayout.PassageSpan(size, hall + 1, "Left")
		out.Right = { a, b }
	end
	return out
end

-- Côtés d'une colonne qui ont un passage (voisin ou cage) : { "Left"?, "Right"? }
function WorldLayout.RoomDoors(size: SizeDef?, column: number): { string }
	local _, columns = sizeOf(size)
	local hall = WorldLayout.HallAfter(size)
	local doors = {}
	if column > 1 or hall == 0 then
		table.insert(doors, "Left")
	end
	if column < columns or hall == columns then
		table.insert(doors, "Right")
	end
	return doors
end

-- Intérieur d'une pièce (repère local) : xMin, xMax, yFloor, dMin, dMax
function WorldLayout.RoomInterior(size: SizeDef?, slot: number): (number, number, number, number, number)
	local floor, column = WorldLayout.SlotCell(size, slot)
	local x0, x1 = WorldLayout.ColumnSpan(size, column)
	local t = WorldLayout.WALL_T
	return x0 + t, x1 - t, WorldLayout.FloorY(floor), t, t + WorldLayout.DEPTH
end

-- (v9.8 HOUSE98) VRAIE fenêtre du mur du fond d'une pièce (côté jardin) :
-- même place et même largeur que la fenêtre de la pièce 2D (HouseRoom : à
-- gauche, 104 x 92 px, 36 px sous le haut du mur ; = House3DScene
-- windowRect), mais prolongée vers le haut jusqu'à BACK_WINDOW_TOP (la
-- partie du mur au-dessus de la 2D, où aucun objet mural ne va) : une
-- porte-fenêtre en hauteur. -> (x0, x1, y0, y1) par rapport au milieu de la
-- pièce (x) et au dessus de son sol (y)
WorldLayout.BACK_WINDOW_TOP = 9.6
function WorldLayout.BackWindowRect(size: SizeDef?, wallRatio: number?): (number, number, number, number)
	local roomWpx = WorldLayout.RoomWidthPx(size)
	local side = WorldLayout.SIDE_PX
	local wallPx = math.floor(WorldLayout.ROOM_HEIGHT_PX * math.clamp(finite(wallRatio, WorldLayout.WALL_RATIO), 0.1, 0.9) + 0.5)
	local k = roomWpx / math.max(1, roomWpx - 2 * side)
	local x2D = side + math.floor(roomWpx * 0.1) + 52
	local cx = ((x2D - side) * k - roomWpx / 2) * WorldLayout.PX
	local ww, wh = 104 * k * WorldLayout.PX, 92 * WorldLayout.PX
	local cy = (wallPx - 36) * WorldLayout.PX - wh / 2
	return cx - ww / 2, cx + ww / 2, cy - wh / 2, math.max(cy + wh / 2, WorldLayout.BACK_WINDOW_TOP)
end

-- Centre du dessus du sol d'une pièce (repère local) : x, y, d
function WorldLayout.RoomCenter(size: SizeDef?, slot: number): (number, number, number)
	local xMin, xMax, yFloor, dMin, dMax = WorldLayout.RoomInterior(size, slot)
	return (xMin + xMax) / 2, yFloor, (dMin + dMax) / 2
end

----------------------------------------------------------------------
-- 2D <-> 3D dans une pièce (même calcul que House3DLayout / PlaceItems)
----------------------------------------------------------------------
-- Repère de la pièce : x vers la droite (0 = milieu), z depuis la face
-- intérieure du mur du fond vers l'avant (0..D). Objet au sol : (x, z) =
-- CENTRE de son empreinte (profondeur fd). Objet mural : y = BAS de sa
-- boîte 2D (pivot du modèle), k = studs par unité (boîte 100 x 100).
-- (House3DLayout écarte aussi les objets qui se chevauchent et colle
-- certains meubles au mur : l'inverse retombe sur la même 2D à ces petits
-- écarts près.)

export type RoomDims = { PX: number, RoomWpx: number, RoomHpx: number, WallPx: number, WallRatio: number, W: number, D: number, WH: number }

function WorldLayout.RoomDims(size: SizeDef?, wallRatio: number?): RoomDims
	local ratio = math.clamp(finite(wallRatio, WorldLayout.WALL_RATIO), 0.1, 0.9)
	local roomWpx = WorldLayout.RoomWidthPx(size)
	return {
		PX = WorldLayout.PX,
		RoomWpx = roomWpx,
		RoomHpx = WorldLayout.ROOM_HEIGHT_PX,
		WallPx = math.floor(WorldLayout.ROOM_HEIGHT_PX * ratio + 0.5),
		WallRatio = ratio,
		W = roomWpx * WorldLayout.PX,
		D = WorldLayout.DEPTH,
		WH = WorldLayout.WALL_H,
	}
end

local function depthT(dims: RoomDims, Y: number): number
	return math.clamp((Y - dims.WallRatio) / math.max(0.05, 1 - dims.WallRatio), 0, 1)
end

-- X 2D -> x (studs, 0 = milieu) à la profondeur t (perspective de la 2D)
local function mapX(dims: RoomDims, X: number, t: number): number
	local sidePx = WorldLayout.SIDE_PX * (1 - math.clamp(t, 0, 1))
	local px = (X * dims.RoomWpx - sidePx) / math.max(1, dims.RoomWpx - 2 * sidePx) * dims.RoomWpx
	return (px - dims.RoomWpx / 2) * dims.PX
end

local function unmapX(dims: RoomDims, x: number, t: number): number
	local sidePx = WorldLayout.SIDE_PX * (1 - math.clamp(t, 0, 1))
	local px = x / dims.PX + dims.RoomWpx / 2
	return (px * math.max(1, dims.RoomWpx - 2 * sidePx) / dims.RoomWpx + sidePx) / dims.RoomWpx
end

-- (v9.6) Meuble "contre le mur" (House3DRecipes Info.Wall : armoire,
-- bibliothèque, frigo...) : collé au mur du fond tant que t < WALL_SNAP_T
-- (même règle que House3DLayout)
WorldLayout.WALL_SNAP_T = 0.55

-- Objet au sol : (X, Y) -> (x, z du centre) ; `fw` / `fd` = empreinte ;
-- `againstWall` = meuble collé au mur du fond (voir WALL_SNAP_T)
function WorldLayout.FloorForward(dims: RoomDims, X: number, Y: number, fw: number, fd: number, againstWall: boolean?): (number, number)
	local t = depthT(dims, finite(Y, 0.8))
	local limit = math.max(0, dims.W / 2 - fw / 2 - 0.1)
	local x = math.clamp(mapX(dims, finite(X, 0.5), t), -limit, limit)
	if againstWall == true and t < WorldLayout.WALL_SNAP_T then
		return x, fd / 2 + 0.08
	end
	local zFront = (t ^ WorldLayout.DEPTH_CURVE) * dims.D
	local z = math.clamp(zFront - fd / 2, fd / 2 + 0.08, math.max(fd / 2 + 0.08, dims.D - fd / 2 - 0.1))
	return x, z
end

-- Inverse : (x, z du centre) -> (X, Y) bornés à la zone du sol
function WorldLayout.FloorInverse(dims: RoomDims, x: number, z: number, fd: number): (number, number)
	local zFront = math.clamp(finite(z, 0) + fd / 2, 0, dims.D)
	local t = (zFront / dims.D) ^ (1 / WorldLayout.DEPTH_CURVE)
	local X = math.clamp(unmapX(dims, finite(x, 0), t), 0, 1)
	return X, math.clamp(dims.WallRatio + t * (1 - dims.WallRatio), dims.WallRatio, 1)
end

-- Objet mural : (X, Y) -> (x, y du pivot = bas de la boîte 2D) ; k = studs par unité
function WorldLayout.WallForward(dims: RoomDims, X: number, Y: number, fw: number, k: number): (number, number)
	local half = math.min(fw / 2, dims.W / 2)
	local limit = math.max(0, dims.W / 2 - half - 0.1)
	local x = math.clamp(mapX(dims, finite(X, 0.5), 0), -limit, limit)
	local centerY = math.clamp((dims.WallPx - finite(Y, 0.2) * dims.RoomHpx) * dims.PX, 0.4, dims.WH - 0.2)
	return x, centerY - 50 * k
end

function WorldLayout.WallInverse(dims: RoomDims, x: number, y: number, k: number): (number, number)
	local X = math.clamp(unmapX(dims, finite(x, 0), 0), 0, 1)
	local centerY = finite(y, 0) + 50 * k
	local Y = (dims.WallPx - centerY / dims.PX) / dims.RoomHpx
	return X, math.clamp(Y, 0, dims.WallRatio)
end

-- Arrondi comme le serveur (HouseService : X / Y à 0,0001)
function WorldLayout.Round4(value: number): number
	return math.floor(value / 0.0001 + 0.5) * 0.0001
end

----------------------------------------------------------------------
-- (v9.6) ZONE VALIDE d'un objet posé : UNE seule définition (fractions de
-- la pièce 2D), utilisée par l'éditeur 2D (HouseCommon.ClampPosition),
-- l'édition 3D de la ville (FurnitureEdit : le fantôme 3D est borné à ce qui
-- retombe DANS la pièce 2D) et le serveur (HouseService : vérification à la
-- sauvegarde et réparation des anciennes dispositions au chargement).
--   - X : l'objet reste (presque) entier dans la largeur de la pièce ;
--   - objet au sol : pieds dans la bande du sol, tête sous le plafond ;
--     `raisedMinY` = Y min d'un petit objet qui peut monter SUR un meuble ;
--   - objet mural : centre sur le mur, sans passer sous le plafond ni sur le sol.
----------------------------------------------------------------------
WorldLayout.AREA_HALF_W = 0.38 -- demi-largeur visible (fraction de la taille de l'objet)
WorldLayout.FLOOR_GAP = 0.035 -- haut de la bande du sol = WallRatio + ça
WorldLayout.FLOOR_MAX_Y = 0.985 -- pieds au plus bas
WorldLayout.WALL_MIN_Y = 0.1 -- centre d'un objet mural au plus haut
WorldLayout.WALL_GAP = 0.03 -- ... et au plus bas : WallRatio - ça

-- (x0, x1, y0, y1) ; `sizePx` = item.Size x S (px de maquette)
function WorldLayout.PlacementArea(placement: string?, sizePx: number, roomWpx: number, roomHpx: number, wallRatio: number?, raisedMinY: number?): (number, number, number, number)
	local ratio = math.clamp(finite(wallRatio, WorldLayout.WALL_RATIO), 0.1, 0.9)
	local size = math.max(0, finite(sizePx, 80))
	local half = math.clamp(size * WorldLayout.AREA_HALF_W / math.max(1, finite(roomWpx, WorldLayout.ROOM_BASE_PX)), 0.015, 0.2)
	local sizeY = size / math.max(1, finite(roomHpx, WorldLayout.ROOM_HEIGHT_PX))
	local minY, maxY
	if placement == "Wall" then
		-- sur le MUR DU FOND (entre les murs de côté en perspective de la 2D,
		-- SIDE_PX de chaque côté) : là où la 3D peut le montrer
		local wpx = math.max(1, finite(roomWpx, WorldLayout.ROOM_BASE_PX))
		local side = math.min(WorldLayout.SIDE_PX, wpx * 0.25)
		local inner = wpx - 2 * side
		local halfPx = math.min(size * WorldLayout.AREA_HALF_W, wpx * 0.5)
		local wx0 = (halfPx * inner / wpx + side) / wpx
		local wx1 = ((wpx - halfPx) * inner / wpx + side) / wpx
		if wx0 > wx1 then
			wx0, wx1 = 0.5, 0.5
		end
		half = wx0
		-- centré sur Y : (presque) entier sur le mur
		local halfY = sizeY * 0.4
		minY = math.max(WorldLayout.WALL_MIN_Y, halfY + 0.02)
		maxY = math.max(WorldLayout.WALL_MIN_Y, math.min(ratio - WorldLayout.WALL_GAP, ratio - halfY * 0.7))
		if minY > maxY then
			-- objet plus haut que le mur : centré sur le mur
			minY = math.min(maxY, ratio / 2 + 0.02)
			maxY = minY
		end
	else
		maxY = WorldLayout.FLOOR_MAX_Y
		minY = ratio + WorldLayout.FLOOR_GAP
		local raised = raisedMinY ~= nil and finite(raisedMinY, minY) or nil
		if raised then
			minY = raised
		end
		-- posé par ses pieds : la tête ne traverse pas le plafond
		minY = math.min(maxY, math.max(minY, sizeY * 0.92 - 0.02))
	end
	-- (zone symétrique : mur du fond comme sol)
	return half, 1 - half, minY, maxY
end

-- Valeur bornée puis arrondie à 0,0001 SANS ressortir des bornes
local function roundInside(value: number, low: number, high: number): number
	local r = WorldLayout.Round4(math.clamp(value, low, high))
	if r < low - 1e-9 then
		r += 0.0001
	elseif r > high + 1e-9 then
		r -= 0.0001
	end
	return r
end

-- Position bornée à la zone ET arrondie comme la sauvegarde
function WorldLayout.ClampToArea(X: number, Y: number, x0: number, x1: number, y0: number, y1: number): (number, number)
	return roundInside(finite(X, 0.5), x0, x1), roundInside(finite(Y, (y0 + y1) / 2), y0, y1)
end

-- Objet au sol visé en 3D (x, z du centre) -> position PERMISE : (x, z) à
-- montrer + (X, Y) à sauvegarder. Le fantôme est TOUJOURS l'image 2D -> 3D
-- de ce qui sera sauvé (même rendu qu'après un rechargement).
function WorldLayout.FloorClamp(dims: RoomDims, x: number, z: number, fw: number, fd: number, x0: number, x1: number, y0: number, y1: number, againstWall: boolean?): (number, number, number, number)
	local X, Y = WorldLayout.FloorInverse(dims, x, z, fd)
	X, Y = WorldLayout.ClampToArea(X, Y, x0, x1, y0, y1)
	local x2, z2 = WorldLayout.FloorForward(dims, X, Y, fw, fd, againstWall)
	return x2, z2, X, Y
end

-- Objet mural visé en 3D (x, y du pivot) -> (x, y) à montrer + (X, Y) à sauvegarder
function WorldLayout.WallClamp(dims: RoomDims, x: number, y: number, fw: number, k: number, x0: number, x1: number, y0: number, y1: number): (number, number, number, number)
	local X, Y = WorldLayout.WallInverse(dims, x, y, k)
	X, Y = WorldLayout.ClampToArea(X, Y, x0, x1, y0, y1)
	local x2, y2 = WorldLayout.WallForward(dims, X, Y, fw, k)
	return x2, y2, X, Y
end

-- Grille d'aimant (studs) : valeur arrondie au pas
function WorldLayout.Snap(value: number, step: number): number
	if step <= 0 then
		return value
	end
	return math.floor(value / step + 0.5) * step
end

----------------------------------------------------------------------
-- Rotation (champ R)
----------------------------------------------------------------------

WorldLayout.ROTATION_STEP = 15

-- Valeur sûre du champ R : entier multiple de 15 dans 15..345, nil pour 0
function WorldLayout.NormalizeRotation(value: any): number?
	if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
		return nil
	end
	local step = WorldLayout.ROTATION_STEP
	local r = (math.floor(value / step + 0.5) * step) % 360
	if r == 0 then
		return nil
	end
	return r
end

-- Tourne de `delta` degrés (ex. +45) : nouvelle valeur du champ R
function WorldLayout.Rotate(value: any, delta: number): number?
	local current = WorldLayout.NormalizeRotation(value) or 0
	return WorldLayout.NormalizeRotation(current + delta)
end

----------------------------------------------------------------------
-- (v10 LAYOUT10) LA GRANDE VILLE : centre-ville, quartiers, autoroute
----------------------------------------------------------------------
-- Repère "ville" (toutes les fonctions PURES ci-dessous) : x, z en studs
-- depuis le centre de la place (Origin), y depuis Origin().Y (sol des
-- pelouses GROUND_Y, chaussée ROAD_Y). +Z = vers l'entrée (sud), -Z =
-- mairie / fête foraine (nord). Les fonctions en CFrame (en jeu) sont plus
-- bas : WorldLayout.CityPoint / CityCFrame / PlotCFrame...
--
-- Plan : un QUADRILLAGE 3 x 3 de cases, séparées par des avenues (axes
-- x, z = ±DOWNTOWN_B et ±BeltR(count)) :
--   - case du milieu : le CENTRE-VILLE (place, mairie, boutiques, fête
--     foraine, lac et parc) dans le boulevard carré (±DOWNTOWN_B) ;
--   - case sud (0, +1) : l'ENTRÉE (porte, coin gourmand, MégaDopa,
--     concession, point de rendez-vous des courses) sur l'avenue d'entrée
--     (x = 0) qui file jusqu'à l'échangeur sud de l'autoroute ;
--   - cases des QUARTIERS (DISTRICT_DEFS) : chaumières à l'ouest, maisons de
--     ville à l'est, lofts au sud-est, manoirs sur la colline au nord,
--     quartier mixte au sud-ouest ;
--   - cases nord-ouest / nord-est : bois des collines et parc des sports ;
--   - tout autour, au-delà de l'avenue de ceinture (±BeltR), l'AUTOROUTE
--     (anneau carré aux coins arrondis, ±HighwayR(count), 2 x 2 voies) avec 4
--     échangeurs en losange (la route locale passe SUR l'autoroute par un
--     pont) ; celui du sud prolonge l'avenue d'entrée.
-- Chaque quartier : des rues de quartier (STREET_W) qui relient les deux
-- avenues de sa case, avec une rangée de parcelles de chaque côté (façades
-- sur la rue), rangées dos à dos entre deux rues. Le nombre de parcelles de
-- chaque quartier suit le nombre de joueurs (PlotCount) : les colonnes les
-- plus proches du centre d'abord ; les places vides d'une colonne entamée
-- sont des chantiers ("Lots"), le reste de la case est libre ("Free").

WorldLayout.DOWNTOWN_B = 250 -- axe du boulevard carré du centre-ville
WorldLayout.BELT_R = 860 -- axe de l'avenue de ceinture (carré) : AU PLUS (voir BeltR(count))
WorldLayout.BELT_MIN = 640 -- ... au moins (la case de l'entrée : MégaDopa, rendez-vous des courses)
WorldLayout.GRID_AXES = { -860, -250, 250, 860 } -- axes des avenues (x comme z)
WorldLayout.GRID_HALF = 16 -- demi-emprise d'une avenue (chaussée ROAD_W / 2 + trottoir WALK_W)
WorldLayout.STREET_W = 16 -- chaussée d'une rue de quartier (2 voies)
WorldLayout.STREET_HALF = 14 -- demi-emprise d'une rue de quartier (8 + trottoir 6)
WorldLayout.UNIT_D = 196 -- rangée (84) + rue (28) + rangée (84)
WorldLayout.PLOT_GAP = 12 -- entre deux parcelles voisines d'une rangée
WorldLayout.MANSION_GAP = 64 -- entre deux manoirs (murs de pierre, cyprès)
WorldLayout.MANSION_RISE = 5 -- (studs) la colline des manoirs : plateau surélevé
WorldLayout.MANSION_RAMP = 26 -- longueur des rampes d'accès au plateau
WorldLayout.HIGHWAY_R = 1110 -- axe de l'autoroute AU PLUS (voir HighwayR(count) = BeltR + HIGHWAY_GAP)
WorldLayout.HIGHWAY_GAP = 250 -- de l'axe de la ceinture à l'axe de l'autoroute
WorldLayout.HIGHWAY_W = 58 -- emprise des chaussées : 2 x (2 voies de 11 + BAU) + terre-plein central
WorldLayout.HIGHWAY_MEDIAN = 8 -- terre-plein central (largeur)
WorldLayout.HIGHWAY_LANES = { 10.5, 21.5 } -- décalage des voies depuis l'axe (à droite du sens de circulation)
WorldLayout.HIGHWAY_CORNER = 240 -- rayon des virages de l'anneau
WorldLayout.BRIDGE_Y = 18 -- dessus du tablier des ponts au-dessus de l'autoroute (hauteur libre ~16)
WorldLayout.BRIDGE_HALF = 38 -- demi-longueur du tablier (au-dessus de l'emprise + accotements)
WorldLayout.BRIDGE_RAMP = 150 -- longueur des rampes d'approche du pont
WorldLayout.RAMP_JUNCTION = 212 -- distance axe de l'autoroute -> carrefour des bretelles
WorldLayout.RAMP_T = 380 -- distance (le long de l'autoroute) du départ / de l'arrivée des bretelles
WorldLayout.RAMP_W = 12 -- chaussée d'une bretelle (1 voie + accotements)
WorldLayout.OUTSIDE_END = 250 -- bout de la route au-delà du pont (rond-point / aire)
-- Vitesses (studs / s) : rue de quartier, avenue, ceinture, autoroute, bretelle
WorldLayout.SPEED = { Street = 30, Avenue = 40, Belt = 48, Highway = 65, Ramp = 42, Downtown = 32 }
-- (v10) Case de l'entrée : la porte reste PIÉTONNE (place d'accueil) ; les
-- voitures arrivent par la route de l'entrée (x = 0) qui part du rond-point
-- du dépose-minute (derrière la porte, TownEntrance) vers la ceinture et
-- l'échangeur sud, et par la rue du marché (z = MARKET_STREET_Z) qui relie
-- les deux avenues x = ±DOWNTOWN_B au sud de MégaDopa et de la concession.
WorldLayout.ARRIVAL_LOOP = 66 -- centre du rond-point : porte + 66 (sur l'axe)
WorldLayout.ARRIVAL_LOOP_R = 14 -- rayon de la trajectoire des voitures dans le rond-point
WorldLayout.MARKET_STREET_Z = 480

-- Quartiers résidentiels (ordre = ordre des parcelles ; Cell = case du
-- quadrillage ; Axis = sens des rues ; Cap = parcelles au plus ; Weight =
-- part des parcelles quand il y a peu de joueurs ; K = parcelles par rangée)
export type DistrictDef = {
	Id: string,
	Name: string,
	Emoji: string,
	Styles: { string },
	Cell: { number },
	Axis: string,
	Cap: number,
	Weight: number,
	K: number,
	Gap: number,
	Margin: number, -- (studs) du bord de la case côté centre-ville à la 1re parcelle
	Rise: number,
	Gated: boolean,
}
WorldLayout.DISTRICT_DEFS = {
	{ Id = "Cottage", Name = "Cottage Village", Emoji = "🏡", Styles = { "Cottage" }, Cell = { -1, 0 }, Axis = "X", Cap = 12, Weight = 3.0, K = 3, Gap = 12, Margin = 13, Rise = 0, Gated = false },
	{ Id = "Townhouse", Name = "Townhouse Streets", Emoji = "🏘️", Styles = { "Townhouse" }, Cell = { 1, 0 }, Axis = "X", Cap = 12, Weight = 2.6, K = 3, Gap = 12, Margin = 13, Rise = 0, Gated = false },
	{ Id = "Loft", Name = "Loft District", Emoji = "🏭", Styles = { "Loft" }, Cell = { 1, 1 }, Axis = "X", Cap = 12, Weight = 2.2, K = 3, Gap = 12, Margin = 13, Rise = 0, Gated = false },
	{ Id = "Mansion", Name = "Mansion Hills", Emoji = "🏰", Styles = { "Mansion" }, Cell = { 0, -1 }, Axis = "Z", Cap = 8, Weight = 1.7, K = 2, Gap = 64, Margin = 40, Rise = 5, Gated = true },
	{ Id = "Mixed", Name = "Mixed Quarter", Emoji = "🏙️", Styles = {}, Cell = { -1, 1 }, Axis = "X", Cap = 12, Weight = 1.5, K = 3, Gap = 12, Margin = 13, Rise = 0, Gated = false },
} :: { DistrictDef }

-- (bornes d'une case du quadrillage, sans les emprises des avenues)
local function cellRect(i: number, j: number, beltR: number?): (number, number, number, number)
	local B, R, h = WorldLayout.DOWNTOWN_B, beltR or WorldLayout.BELT_R, WorldLayout.GRID_HALF
	local function span(k: number): (number, number)
		if k < 0 then
			return -R + h, -B - h
		elseif k > 0 then
			return B + h, R - h
		end
		return -B + h, B - h
	end
	local x0, x1 = span(i)
	local z0, z1 = span(j)
	return x0, x1, z0, z1
end
WorldLayout.CellRect = cellRect

-- Nombre de parcelles par quartier pour `count` parcelles (plus forte
-- moyenne pondérée d'abord, comme une répartition proportionnelle)
local allocCache: { [number]: { number } } = {}
local function allocation(count: number): { number }
	local cached = allocCache[count]
	if cached then
		return cached
	end
	local defs = WorldLayout.DISTRICT_DEFS
	local alloc = table.create(#defs, 0)
	for _ = 1, count do
		local best, bestScore = nil, math.huge
		for d, def in ipairs(defs) do
			if alloc[d] < def.Cap then
				local score = (alloc[d] + 1) / def.Weight
				if score < bestScore - 1e-9 then
					best, bestScore = d, score
				end
			end
		end
		if not best then
			break
		end
		alloc[best] += 1
	end
	allocCache[count] = alloc
	return alloc
end

-- Forme d'un quartier de `n` parcelles : rangées dos à dos (1 ou 2 rues),
-- colonnes utilisées (les plus proches du centre-ville d'abord)
local function districtShape(def: DistrictDef, n: number): (number, number)
	-- (2 rues dès 5 parcelles : la ville reste compacte, les colonnes
	-- s'ajoutent ensuite)
	local units = n > 4 and 2 or 1
	local kUsed = math.max(1, math.min(def.K, math.ceil(math.max(n, 1) / (units * 2))))
	return units, kUsed
end

-- (v10) La ville GRANDIT avec le nombre de joueurs : l'avenue de ceinture
-- (et l'autoroute, HIGHWAY_GAP plus loin) est juste assez loin pour les
-- colonnes de parcelles utilisées ; BELT_MIN..BELT_R
local beltCache: { [number]: number } = {}
function WorldLayout.BeltR(count: number?): number
	local n = WorldLayout.PlotCount(count)
	local cached = beltCache[n]
	if cached then
		return cached
	end
	local alloc = allocation(n)
	local B, h = WorldLayout.DOWNTOWN_B, WorldLayout.GRID_HALF
	local need = WorldLayout.BELT_MIN
	for d, def in ipairs(WorldLayout.DISTRICT_DEFS) do
		local units, kUsed = districtShape(def, alloc[d])
		local span = def.Margin + kUsed * WorldLayout.PLOT_W + (kUsed - 1) * def.Gap + def.Margin
		need = math.max(need, B + h + span + h)
		local vIdx = def.Axis == "X" and def.Cell[2] or def.Cell[1]
		if vIdx ~= 0 then
			need = math.max(need, B + h + units * WorldLayout.UNIT_D + 40 + h)
		end
	end
	local r = math.min(WorldLayout.BELT_R, math.ceil(need / 10) * 10)
	beltCache[n] = r
	return r
end

function WorldLayout.HighwayR(count: number?): number
	return WorldLayout.BeltR(count) + WorldLayout.HIGHWAY_GAP
end

-- Rectangle (centre x, z, largeur en x, profondeur en z) : repère ville ;
-- Y (facultatif) : hauteur du sol (plateau de la colline des manoirs)
export type Rect = { X: number, Z: number, W: number, D: number, Y: number? }
-- Emplacement d'une parcelle (repère ville) : centre au sol, Look = vers sa rue
export type PlotPlace = { Index: number, X: number, Y: number, Z: number, LookX: number, LookZ: number, Yaw: number, District: string, Slot: number, Street: number }
export type Lot = { X: number, Y: number, Z: number, LookX: number, LookZ: number, Yaw: number, W: number, D: number, District: string }
export type Street = { Id: string, X0: number, Z0: number, X1: number, Z1: number, Y: number, Width: number, Half: number }
export type District = {
	Id: string,
	Name: string,
	Emoji: string,
	Style: string,
	Styles: { string },
	Cell: { number },
	Bounds: Rect, -- toute la case du quartier
	Built: Rect, -- partie occupée (parcelles + rues)
	Rise: number, -- y du plateau (manoirs), 0 ailleurs
	Plateau: Rect?, -- (Rise > 0) le plateau surélevé (dessus à GROUND_Y + Rise)
	Gated: boolean,
	Capacity: number,
	Plots: { number }, -- index globaux des parcelles
	Lots: { Lot }, -- places vides (chantiers permanents)
	Free: { Rect }, -- zones libres pour les repères (ni parcelle, ni rue)
	Streets: { Street },
	Gates: { { X: number, Z: number, Yaw: number } }, -- entrées (quartier fermé)
}

local function yawOf(lx: number, lz: number): number
	-- angle (radians) tel que CFrame.Angles(0, yaw, 0).LookVector = (lx, 0, lz)
	return math.atan2(-lx, -lz)
end
WorldLayout.YawOf = yawOf

local cityCache: { [number]: any } = {}

-- Construit (une fois par nombre de parcelles) les quartiers et parcelles
local function buildCity(count: number): any
	local cached = cityCache[count]
	if cached then
		return cached
	end
	local alloc = allocation(count)
	local beltR = WorldLayout.BeltR(count)
	local districts: { District } = {}
	local plots: { PlotPlace } = {}
	local W, D = WorldLayout.PLOT_W, WorldLayout.PLOT_D
	local SH = WorldLayout.STREET_HALF
	for d, def in ipairs(WorldLayout.DISTRICT_DEFS) do
		local n = alloc[d]
		local x0, x1, z0, z1 = cellRect(def.Cell[1], def.Cell[2], beltR)
		-- u = le long des rues, v = en travers
		local alongX = def.Axis == "X"
		local u0, u1, v0, v1
		if alongX then
			u0, u1, v0, v1 = x0, x1, z0, z1
		else
			u0, u1, v0, v1 = z0, z1, x0, x1
		end
		-- côté du centre-ville : là où |u| est le plus petit
		local nearU, dirU
		if math.abs(u0) < math.abs(u1) then
			nearU, dirU = u0, 1
		else
			nearU, dirU = u1, -1
		end
		local gap = def.Gap
		local pitch = W + gap
		local margin = def.Margin
		local units, kUsed = districtShape(def, n)
		local vc = (v0 + v1) / 2
		local streetsV: { number } = {}
		if units == 1 then
			streetsV = { vc }
		else
			streetsV = { vc - WorldLayout.UNIT_D / 2, vc + WorldLayout.UNIT_D / 2 }
		end
		-- rangées : (v du centre de la parcelle, sens du regard en v, rue)
		local rowList: { { V: number, Look: number, Street: number } } = {}
		for s, sv in ipairs(streetsV) do
			table.insert(rowList, { V = sv - SH - D / 2, Look = 1, Street = s })
			table.insert(rowList, { V = sv + SH + D / 2, Look = -1, Street = s })
		end
		-- les rangées du milieu d'abord (plus près des autres rangées)
		table.sort(rowList, function(a, b)
			local da, db = math.abs(a.V - vc), math.abs(b.V - vc)
			if math.abs(da - db) > 1e-6 then
				return da < db
			end
			return a.V < b.V
		end)
		local rise = def.Rise
		local entry: District = {
			Id = def.Id,
			Name = def.Name,
			Emoji = def.Emoji,
			Style = def.Id,
			Styles = def.Styles,
			Cell = def.Cell,
			Bounds = { X = (x0 + x1) / 2, Z = (z0 + z1) / 2, W = x1 - x0, D = z1 - z0 },
			Built = { X = 0, Z = 0, W = 0, D = 0 },
			Rise = rise,
			Gated = def.Gated,
			Capacity = def.Cap,
			Plots = {},
			Lots = {},
			Free = {},
			Streets = {},
			Gates = {},
		}
		local function toXZ(u: number, v: number): (number, number)
			if alongX then
				return u, v
			end
			return v, u
		end
		local function rect(ua: number, ub: number, va: number, vb: number): Rect
			local xa, za = toXZ(math.min(ua, ub), math.min(va, vb))
			local xb, zb = toXZ(math.max(ua, ub), math.max(va, vb))
			return { X = (xa + xb) / 2, Z = (za + zb) / 2, W = math.abs(xb - xa), D = math.abs(zb - za) }
		end
		local placed = 0
		for c = 1, kUsed do
			local u = nearU + dirU * (margin + W / 2 + (c - 1) * pitch)
			for _, row in ipairs(rowList) do
				local x, z = toXZ(u, row.V)
				local lx, lz = toXZ(0, row.Look)
				if placed < n then
					placed += 1
					local index = #plots + 1
					local place: PlotPlace = {
						Index = index,
						X = x,
						Y = rise,
						Z = z,
						LookX = lx,
						LookZ = lz,
						Yaw = yawOf(lx, lz),
						District = def.Id,
						Slot = placed,
						Street = row.Street,
					}
					plots[index] = place
					table.insert(entry.Plots, index)
				else
					table.insert(entry.Lots, { X = x, Y = rise, Z = z, LookX = lx, LookZ = lz, Yaw = yawOf(lx, lz), W = W, D = D, District = def.Id })
				end
			end
		end
		-- rues : d'une avenue à l'autre (toute la case + les demi-emprises)
		local h = WorldLayout.GRID_HALF
		for s, sv in ipairs(streetsV) do
			local ax, az = toXZ(u0 - h, sv)
			local bx, bz = toXZ(u1 + h, sv)
			table.insert(entry.Streets, { Id = def.Id .. "_" .. s, X0 = ax, Z0 = az, X1 = bx, Z1 = bz, Y = rise, Width = WorldLayout.STREET_W, Half = SH })
			if def.Gated then
				-- portails aux deux bouts (au bord de la case, regard vers l'extérieur)
				local gx0, gz0 = toXZ(u0 + 3, sv)
				local gx1, gz1 = toXZ(u1 - 3, sv)
				local lx0, lz0 = toXZ(-1, 0)
				local lx1, lz1 = toXZ(1, 0)
				table.insert(entry.Gates, { X = gx0, Z = gz0, Yaw = yawOf(lx0, lz0) })
				table.insert(entry.Gates, { X = gx1, Z = gz1, Yaw = yawOf(lx1, lz1) })
			end
		end
		-- partie bâtie, zones libres
		local vMin = streetsV[1] - SH - D
		local vMax = streetsV[#streetsV] + SH + D
		local uEnd = nearU + dirU * (margin + kUsed * pitch - gap / 2)
		local uNear = nearU + dirU * math.max(0, margin - gap / 2)
		entry.Built = rect(uNear, uEnd, vMin, vMax)
		local farU = dirU > 0 and u1 or u0
		if math.abs(farU - uEnd) > 30 then
			table.insert(entry.Free, rect(uEnd + dirU * 2, farU - dirU * 2, vMin, vMax))
		end
		if math.abs(uNear - nearU) > 20 then
			-- (bande côté centre-ville : trottoir planté, entrée du quartier)
			table.insert(entry.Free, rect(nearU + dirU * 2, uNear - dirU * 1, vMin, vMax))
		end
		if vMin - v0 > 20 then
			table.insert(entry.Free, rect(u0 + 2, u1 - 2, v0 + 2, vMin - 2))
		end
		if v1 - vMax > 20 then
			table.insert(entry.Free, rect(u0 + 2, u1 - 2, vMax + 2, v1 - 2))
		end
		-- (bandes entre la rue et les rangées libres : déjà dans Free au-delà
		-- de uEnd ; les rues traversent Free -> rectangles coupés par les rues)
		local cutFree: { Rect } = {}
		for _, r in ipairs(entry.Free) do
			local pieces = { r }
			for _, st in ipairs(entry.Streets) do
				local nextPieces = {}
				for _, piece in ipairs(pieces) do
					-- rue le long de x (z constant) ou de z (x constant)
					local horizontal = math.abs(st.Z1 - st.Z0) < 1e-6
					if horizontal then
						local za, zb = piece.Z - piece.D / 2, piece.Z + piece.D / 2
						local s0, s1 = st.Z0 - st.Half - 1, st.Z0 + st.Half + 1
						if s1 <= za or s0 >= zb then
							table.insert(nextPieces, piece)
						else
							if s0 - za > 8 then
								table.insert(nextPieces, { X = piece.X, W = piece.W, Z = (za + s0) / 2, D = s0 - za })
							end
							if zb - s1 > 8 then
								table.insert(nextPieces, { X = piece.X, W = piece.W, Z = (s1 + zb) / 2, D = zb - s1 })
							end
						end
					else
						local xa, xb = piece.X - piece.W / 2, piece.X + piece.W / 2
						local s0, s1 = st.X0 - st.Half - 1, st.X0 + st.Half + 1
						if s1 <= xa or s0 >= xb then
							table.insert(nextPieces, piece)
						else
							if s0 - xa > 8 then
								table.insert(nextPieces, { Z = piece.Z, D = piece.D, X = (xa + s0) / 2, W = s0 - xa })
							end
							if xb - s1 > 8 then
								table.insert(nextPieces, { Z = piece.Z, D = piece.D, X = (s1 + xb) / 2, W = xb - s1 })
							end
						end
					end
				end
				pieces = nextPieces
			end
			for _, piece in ipairs(pieces) do
				table.insert(cutFree, piece)
			end
		end
		-- (colline des manoirs) plateau : du haut des rampes d'une avenue à
		-- l'autre, autour des rangées ; les zones libres sont coupées à son bord
		if rise > 0 then
			local top = WorldLayout.GRID_HALF + 2 + WorldLayout.MANSION_RAMP - WorldLayout.GRID_HALF
			local pv0, pv1 = math.max(v0, vMin - 8), math.min(v1, vMax + 8)
			local plateau = rect(u0 + top, u1 - top, pv0, pv1)
			plateau.Y = rise
			entry.Plateau = plateau
			local px0, px1 = plateau.X - plateau.W / 2, plateau.X + plateau.W / 2
			local pz0, pz1 = plateau.Z - plateau.D / 2, plateau.Z + plateau.D / 2
			local split: { Rect } = {}
			for _, r in ipairs(cutFree) do
				-- morceaux : dedans (Y = rise) / dehors (Y = 0), découpés en x puis en z
				local xs = { r.X - r.W / 2, r.X + r.W / 2 }
				for _, c in ipairs({ px0, px1 }) do
					if c > xs[1] + 8 and c < xs[#xs] - 8 then
						table.insert(xs, (#xs), c)
					end
				end
				table.sort(xs)
				local zs = { r.Z - r.D / 2, r.Z + r.D / 2 }
				for _, c in ipairs({ pz0, pz1 }) do
					if c > zs[1] + 8 and c < zs[#zs] - 8 then
						table.insert(zs, (#zs), c)
					end
				end
				table.sort(zs)
				for a = 1, #xs - 1 do
					for b = 1, #zs - 1 do
						local cx, cz = (xs[a] + xs[a + 1]) / 2, (zs[b] + zs[b + 1]) / 2
						local inside = cx > px0 and cx < px1 and cz > pz0 and cz < pz1
						table.insert(split, { X = cx, Z = cz, W = xs[a + 1] - xs[a], D = zs[b + 1] - zs[b], Y = inside and rise or 0 })
					end
				end
			end
			cutFree = split
		end
		entry.Free = cutFree
		table.insert(districts, entry)
	end
	local city = { Count = count, Districts = districts, Plots = plots }
	cityCache[count] = city
	return city
end

-- Nombre de parcelles : Players.MaxPlayers borné à MIN_PLOTS..MAX_PLOTS
-- (le serveur le lit une fois ; 8 par défaut)
function WorldLayout.PlotCount(maxPlayers: any): number
	return math.clamp(math.floor(finite(maxPlayers, 8)), WorldLayout.MIN_PLOTS, WorldLayout.MAX_PLOTS)
end

-- Quartiers (liste en lecture seule, en cache : ne pas modifier)
function WorldLayout.Districts(count: number): { District }
	return buildCity(WorldLayout.PlotCount(count)).Districts
end

-- Quartier par identifiant ("Cottage", "Townhouse", "Loft", "Mansion", "Mixed")
function WorldLayout.District(count: number, id: string): District?
	for _, d in ipairs(WorldLayout.Districts(count)) do
		if d.Id == id then
			return d
		end
	end
	return nil
end

-- Emplacement PUR d'une parcelle (repère ville), nil hors 1..count
function WorldLayout.PlotPlaceData(index: number, count: number): PlotPlace?
	return buildCity(WorldLayout.PlotCount(count)).Plots[index]
end

-- Quartier d'une parcelle
function WorldLayout.PlotDistrict(index: number, count: number): District?
	local place = WorldLayout.PlotPlaceData(index, count)
	if not place then
		return nil
	end
	return WorldLayout.District(count, place.District)
end

-- Taille d'une parcelle (la même partout ; les manoirs ont plus d'espace
-- ENTRE les parcelles, pas de plus grandes parcelles)
function WorldLayout.PlotSize(_index: number?, _count: number?): (number, number)
	return WorldLayout.PLOT_W, WorldLayout.PLOT_D
end

-- Places vides des quartiers (chantiers permanents) : { Lot } en repère ville
function WorldLayout.FillerLots(count: number): { Lot }
	local out = {}
	for _, d in ipairs(WorldLayout.Districts(count)) do
		for _, lot in ipairs(d.Lots) do
			table.insert(out, lot)
		end
	end
	return out
end

-- Quartier d'un style de maison (StyleOf) ; "Mixed" si aucun n'a ce style
function WorldLayout.DistrictForStyle(style: string?): string
	for _, def in ipairs(WorldLayout.DISTRICT_DEFS) do
		if table.find(def.Styles, style) then
			return def.Id
		end
	end
	return "Mixed"
end

-- Distance entre deux quartiers (centres de case) : repli vers le plus proche
local function districtCenter(id: string): (number, number)
	for _, def in ipairs(WorldLayout.DISTRICT_DEFS) do
		if def.Id == id then
			local x0, x1, z0, z1 = cellRect(def.Cell[1], def.Cell[2], WorldLayout.BELT_R)
			return (x0 + x1) / 2, (z0 + z1) / 2
		end
	end
	return 0, 0
end

-- Parcelle à donner à un joueur qui arrive : une parcelle LIBRE du quartier
-- de son style, sinon du quartier le plus proche qui en a une (puis la plus
-- proche du centre-ville dans ce quartier). `isFree(index)` dit si une
-- parcelle est libre. -> index ou nil (ville pleine)
function WorldLayout.PickPlot(count: number, style: string?, isFree: (number) -> boolean): number?
	local want = WorldLayout.DistrictForStyle(style)
	local wx, wz = districtCenter(want)
	local order: { District } = {}
	for _, d in ipairs(WorldLayout.Districts(count)) do
		table.insert(order, d)
	end
	table.sort(order, function(a, b)
		if a.Id == want then
			return b.Id ~= want
		elseif b.Id == want then
			return false
		end
		local ax, az = districtCenter(a.Id)
		local bx, bz = districtCenter(b.Id)
		local da = (ax - wx) ^ 2 + (az - wz) ^ 2
		local db = (bx - wx) ^ 2 + (bz - wz) ^ 2
		if math.abs(da - db) > 1e-6 then
			return da < db
		end
		return a.Id < b.Id
	end)
	for _, d in ipairs(order) do
		for _, index in ipairs(d.Plots) do
			if isFree(index) then
				return index
			end
		end
	end
	return nil
end

----------------------------------------------------------------------
-- (v10) Compat : anciennes fonctions de l'anneau (le centre-ville est un
-- carré : 4 "emplacements" = ses 4 côtés, 0 = entrée +Z, 1 = +X...)
----------------------------------------------------------------------

function WorldLayout.PlotSlots(_count: number?): number
	return 4
end

function WorldLayout.SlotAngle(slot: number, _count: number?): number
	return slot / 4 * math.pi * 2
end

-- Distance du centre au bord extérieur du boulevard du centre-ville
function WorldLayout.PlotFrontRadius(_count: number?): number
	return WorldLayout.DOWNTOWN_B + WorldLayout.ROAD_W / 2 + WorldLayout.WALK_W
end

function WorldLayout.PlotRadius(count: number?): number
	return WorldLayout.PlotFrontRadius(count) + WorldLayout.PLOT_D / 2
end

-- Axe du boulevard (carré) du centre-ville
function WorldLayout.RingRoadRadius(_count: number?): number
	return WorldLayout.DOWNTOWN_B
end

-- Bord intérieur du boulevard (trottoir intérieur compris)
function WorldLayout.RingInnerRadius(count: number?): number
	return WorldLayout.RingRoadRadius(count) - WorldLayout.ROAD_W / 2 - WorldLayout.WALK_W
end

-- Distance du centre à la porte de la ville (sur l'axe +Z)
function WorldLayout.GateDistance(count: number?): number
	return WorldLayout.PlotFrontRadius(count) + WorldLayout.GATE_BACK
end

-- Rayon des murs invisibles (bord du pré) : au-delà des bouts des échangeurs
function WorldLayout.TownRadius(count: number?): number
	local H = WorldLayout.HighwayR(count)
	-- (les murs sont un CERCLE : les virages de l'autoroute, aux coins, doivent
	-- rester dedans, bord extérieur de la chaussée compris)
	local corner = (H - WorldLayout.HIGHWAY_CORNER) * math.sqrt(2) + WorldLayout.HIGHWAY_CORNER + WorldLayout.HIGHWAY_W / 2 + 80
	return math.max(H + WorldLayout.OUTSIDE_END + 120, corner)
end

-- Parcelle `index` : centre (x, z) en repère ville et angle (radians) de sa
-- direction "vers l'extérieur" (le regard vers la rue = -(sin a, cos a))
function WorldLayout.PlotPlace(index: number, count: number): (number, number, number)
	local place = WorldLayout.PlotPlaceData(index, count)
	if not place then
		return 0, 0, 0
	end
	return place.X, place.Z, math.atan2(-place.LookX, -place.LookZ)
end

-- Distance (le long de la direction "vers la rue") entre le centre de la
-- parcelle et la façade de la maison
function WorldLayout.HouseFrontOffset(): number
	return WorldLayout.PLOT_D / 2 - WorldLayout.GARDEN_D
end

----------------------------------------------------------------------
-- (v10) Réseau routier : graphe PUR (en cache par nombre de parcelles)
----------------------------------------------------------------------
-- Nœud : { Id, X, Y, Z, Kind } (Y = dessus de la chaussée, repère ville)
-- Arête : { Id, A, B, Kind, Lanes, Width, Speed, OneWay, Highway, Ramp,
--   Bridge, Sidewalk, Points } ; Points = polyligne A -> B (axe de la
--   chaussée, {X, Y, Z}) ; Lanes = voies PAR SENS (OneWay : voies dans le
--   sens A -> B) ; voie k à droite du sens de circulation, décalage
--   LaneOffsets[k] depuis l'axe ; Sidewalk = largeur des trottoirs (0 = aucun).
-- Kind : "Downtown" | "Avenue" | "Belt" | "Street" | "Entrance" |
--   "Connector" | "Highway" | "Ramp" | "Outside" | "Roundabout".
export type RoadNode = { Id: string, X: number, Y: number, Z: number, Kind: string }
export type RoadPoint = { X: number, Y: number, Z: number }
export type RoadEdge = {
	Id: string,
	A: string,
	B: string,
	Kind: string,
	Lanes: number,
	LaneOffsets: { number },
	Width: number,
	Speed: number,
	OneWay: boolean,
	Highway: boolean,
	Ramp: boolean,
	Bridge: boolean,
	Sidewalk: number,
	Length: number,
	Points: { RoadPoint },
}
export type Crossing = { X: number, Y: number, Z: number, Yaw: number, Length: number, Width: number }
export type RoadGraph = {
	Nodes: { [string]: RoadNode },
	NodeList: { RoadNode },
	Edges: { RoadEdge },
	Adjacent: { [string]: { RoadEdge } },
	Crossings: { Crossing },
}

local graphCache: { [number]: RoadGraph } = {}

local function r2(v: number): number
	return math.floor(v * 2 + 0.5) / 2
end

local function polyLength(points: { RoadPoint }): number
	local len = 0
	for i = 2, #points do
		local a, b = points[i - 1], points[i]
		len += math.sqrt((b.X - a.X) ^ 2 + (b.Y - a.Y) ^ 2 + (b.Z - a.Z) ^ 2)
	end
	return len
end

-- Repère d'un échangeur : centre sur l'axe de l'autoroute, n = vers
-- l'extérieur, t = sens de la chaussée extérieure (circulation à droite)
local INTERCHANGES = {
	{ Id = "S", NX = 0, NZ = 1 },
	{ Id = "E", NX = 1, NZ = 0 },
	{ Id = "N", NX = 0, NZ = -1 },
	{ Id = "W", NX = -1, NZ = 0 },
}
WorldLayout.INTERCHANGES = INTERCHANGES

local function ixFrame(ix: any, H: number): (number, number, number, number, number, number)
	local nx, nz = ix.NX, ix.NZ
	local tx, tz = nz, -nx
	return nx * H, nz * H, nx, nz, tx, tz
end

-- Point de l'échangeur (t, n) -> repère ville
local function ixPoint(ix: any, H: number, t: number, n: number, y: number?): RoadPoint
	local cx, cz, nx, nz, tx, tz = ixFrame(ix, H)
	return { X = cx + tx * t + nx * n, Y = y or WorldLayout.ROAD_Y, Z = cz + tz * t + nz * n }
end

-- Axe de l'autoroute : anneau carré aux coins arrondis, dans le sens de la
-- chaussée EXTÉRIEURE (S : +X, E : -Z, N : -X, O : +Z), points tous les ~40
-- studs dans les virages. `closed` : le dernier point rejoint le premier.
local highwayCache: { [number]: { RoadPoint } } = {}
function WorldLayout.HighwayPath(count: number?): { RoadPoint }
	local key = WorldLayout.PlotCount(count)
	local cachedPath = highwayCache[key]
	if cachedPath then
		return cachedPath
	end
	local H, Rc = WorldLayout.HighwayR(key), WorldLayout.HIGHWAY_CORNER
	local y = WorldLayout.ROAD_Y
	local pts: { RoadPoint } = {}
	-- 4 coins (centre du virage), en partant du côté sud vers l'est
	local corners = {
		{ cx = H - Rc, cz = H - Rc, a0 = 0 }, -- sud-est : de (H-Rc, H) vers (H, H-Rc)
		{ cx = H - Rc, cz = -(H - Rc), a0 = 1 },
		{ cx = -(H - Rc), cz = -(H - Rc), a0 = 2 },
		{ cx = -(H - Rc), cz = H - Rc, a0 = 3 },
	}
	-- angle polaire (x = sin, z = cos) : sud = 0, est = pi/2, nord = pi, ouest = 3pi/2
	for k, c in ipairs(corners) do
		local start = (k - 1) * math.pi / 2
		local steps = 8
		for s = 0, steps do
			local a = start + s / steps * (math.pi / 2)
			table.insert(pts, { X = c.cx + math.sin(a) * Rc, Y = y, Z = c.cz + math.cos(a) * Rc })
		end
	end
	highwayCache[key] = pts
	return pts
end

-- Décalage des voies de l'autoroute depuis l'axe (à droite du sens)
function WorldLayout.HighwayLanes(): { number }
	return WorldLayout.HIGHWAY_LANES
end

-- Profil en long d'une route qui passe sur un pont au-dessus de
-- l'autoroute : y de la chaussée à la distance n (depuis l'axe de
-- l'autoroute, le long de la route)
function WorldLayout.BridgeProfile(n: number): number
	local a = math.abs(n)
	local half, ramp, top = WorldLayout.BRIDGE_HALF, WorldLayout.BRIDGE_RAMP, WorldLayout.BRIDGE_Y
	local base = WorldLayout.ROAD_Y
	if a <= half then
		return base + top
	elseif a >= half + ramp then
		return base
	end
	-- (raccord doux : cosinus)
	local f = (a - half) / ramp
	return base + top * (0.5 + 0.5 * math.cos(f * math.pi))
end

-- Stations (n, le long de la route depuis l'axe de l'autoroute) du profil
-- d'un pont : bouts au sol (±RAMP_JUNCTION), rampes en BRIDGE_RAMP_STEPS
-- tronçons, tablier plat. Le serveur (tablier) et le graphe (Points) se
-- servent des MÊMES stations : les voitures roulent sur le tablier.
WorldLayout.BRIDGE_RAMP_STEPS = 6
function WorldLayout.BridgeStations(): { number }
	local J, half, ramp = WorldLayout.RAMP_JUNCTION, WorldLayout.BRIDGE_HALF, WorldLayout.BRIDGE_RAMP
	local k = WorldLayout.BRIDGE_RAMP_STEPS
	local out = { -J }
	for i = 0, k do
		table.insert(out, -(half + ramp) + ramp * i / k)
	end
	for i = 0, k do
		table.insert(out, half + ramp * i / k)
	end
	table.insert(out, J)
	return out
end

local function buildGraph(count: number): RoadGraph
	local cachedGraph = graphCache[count]
	if cachedGraph then
		return cachedGraph
	end
	local city = buildCity(count)
	local nodes: { [string]: RoadNode } = {}
	local nodeList: { RoadNode } = {}
	local edges: { RoadEdge } = {}
	local crossings: { Crossing } = {}
	local y0 = WorldLayout.ROAD_Y
	local function node(x: number, z: number, y: number?, kind: string?): string
		local id = "n" .. r2(x) .. "_" .. r2(z)
		local existing = nodes[id]
		if not existing then
			local n: RoadNode = { Id = id, X = r2(x), Y = y or y0, Z = r2(z), Kind = kind or "Point" }
			nodes[id] = n
			table.insert(nodeList, n)
		elseif kind == "Junction" then
			existing.Kind = "Junction"
		end
		return id
	end
	local function addEdge(a: string, b: string, kind: string, opts: any): RoadEdge
		local na, nb = nodes[a], nodes[b]
		local points = opts.Points or { { X = na.X, Y = na.Y, Z = na.Z }, { X = nb.X, Y = nb.Y, Z = nb.Z } }
		local lanes = opts.Lanes or 1
		local offsets = opts.LaneOffsets
		if not offsets then
			offsets = {}
			local laneW = opts.LaneW or (opts.Width or 20) / (opts.OneWay and lanes or 2 * lanes)
			for k = 1, lanes do
				if opts.OneWay then
					table.insert(offsets, (k - 0.5 - lanes / 2) * laneW)
				else
					table.insert(offsets, (k - 0.5) * laneW)
				end
			end
		end
		local e: RoadEdge = {
			Id = "e" .. (#edges + 1),
			A = a,
			B = b,
			Kind = kind,
			Lanes = lanes,
			LaneOffsets = offsets,
			Width = opts.Width or 20,
			Speed = opts.Speed or WorldLayout.SPEED.Avenue,
			OneWay = opts.OneWay == true,
			Highway = opts.Highway == true,
			Ramp = opts.Ramp == true,
			Bridge = opts.Bridge == true,
			Sidewalk = opts.Sidewalk or 0,
			Length = polyLength(points),
			Points = points,
		}
		table.insert(edges, e)
		return e
	end
	-- Routes droites découpées à chaque carrefour : { A = {x, z}, B = {x, z}, cuts = {t...}, opts }
	local lines = {}
	local function line(ax: number, az: number, bx: number, bz: number, kind: string, opts: any)
		local l = { AX = ax, AZ = az, BX = bx, BZ = bz, Kind = kind, Opts = opts, Cuts = { 0, 1 }, Y = opts.Y or y0 }
		table.insert(lines, l)
		return l
	end
	local B, R = WorldLayout.DOWNTOWN_B, WorldLayout.BeltR(count)
	local H = WorldLayout.HighwayR(count)
	local avenueOpts = { Width = WorldLayout.ROAD_W, Lanes = 1, Speed = WorldLayout.SPEED.Avenue, Sidewalk = WorldLayout.WALK_W }
	local beltOpts = { Width = WorldLayout.ROAD_W, Lanes = 1, Speed = WorldLayout.SPEED.Belt, Sidewalk = WorldLayout.WALK_W }
	local downtownOpts = { Width = WorldLayout.ROAD_W, Lanes = 1, Speed = WorldLayout.SPEED.Downtown, Sidewalk = WorldLayout.WALK_W }
	-- quadrillage : x = ±B (de -R à R), z = ±B, ceinture x = ±R, z = ±R
	for _, a in ipairs({ -B, B }) do
		line(a, -R, a, R, "Avenue", avenueOpts)
		line(-R, a, R, a, "Avenue", avenueOpts)
	end
	for _, a in ipairs({ -R, R }) do
		line(a, -R, a, R, "Belt", beltOpts)
		line(-R, a, R, a, "Belt", beltOpts)
	end
	-- centre-ville : avenue d'entrée (x = 0) de la place au boulevard, puis
	-- l'entrée jusqu'à la ceinture ; rues latérales ±X de la place au boulevard
	local street0 = WorldLayout.PLAZA_R + 30
	line(0, street0, 0, B, "Downtown", { Width = WorldLayout.AVENUE_W, Lanes = 1, Speed = WorldLayout.SPEED.Downtown, Sidewalk = WorldLayout.WALK_W })
	-- route de l'entrée : du rond-point du dépose-minute à la ceinture
	local loopZ = WorldLayout.GateDistance(count) + WorldLayout.ARRIVAL_LOOP
	local loopR = WorldLayout.ARRIVAL_LOOP_R
	line(0, loopZ + loopR, 0, R, "Entrance", avenueOpts)
	-- rue du marché (au sud de MégaDopa et de la concession)
	line(-B, WorldLayout.MARKET_STREET_Z, B, WorldLayout.MARKET_STREET_Z, "Avenue", avenueOpts)
	line(street0, 0, B, 0, "Downtown", downtownOpts)
	line(-street0, 0, -B, 0, "Downtown", downtownOpts)
	-- rues des quartiers
	for _, d in ipairs(city.Districts) do
		for _, st in ipairs(d.Streets) do
			line(st.X0, st.Z0, st.X1, st.Z1, "Street", { Width = st.Width, Lanes = 1, Speed = WorldLayout.SPEED.Street, Sidewalk = WorldLayout.WALK_W, Y = st.Y, Rise = d.Rise })
		end
	end
	-- carrefours : intersections des lignes (axes parallèles à x ou z)
	local function param(l: any, x: number, z: number): number?
		local dx, dz = l.BX - l.AX, l.BZ - l.AZ
		local len2 = dx * dx + dz * dz
		local t = ((x - l.AX) * dx + (z - l.AZ) * dz) / len2
		local px, pz = l.AX + dx * t, l.AZ + dz * t
		if (px - x) ^ 2 + (pz - z) ^ 2 > 0.01 or t < -1e-6 or t > 1 + 1e-6 then
			return nil
		end
		return math.clamp(t, 0, 1)
	end
	local junctions: { { X: number, Z: number } } = {}
	for i = 1, #lines do
		for j = i + 1, #lines do
			local a, b = lines[i], lines[j]
			local aHoriz = math.abs(a.AZ - a.BZ) < 1e-6
			local bHoriz = math.abs(b.AZ - b.BZ) < 1e-6
			if aHoriz ~= bHoriz then
				local x = aHoriz and b.AX or a.AX
				local z = aHoriz and a.AZ or b.AZ
				local ta, tb = param(a, x, z), param(b, x, z)
				if ta and tb then
					table.insert(a.Cuts, ta)
					table.insert(b.Cuts, tb)
					table.insert(junctions, { X = x, Z = z })
				end
			end
		end
	end
	-- raccords des connecteurs d'échangeur à la ceinture (milieux des côtés)
	for _, ix in ipairs(INTERCHANGES) do
		local x, z = ix.NX * R, ix.NZ * R
		for _, l in ipairs(lines) do
			if l.Kind == "Belt" then
				local t = param(l, x, z)
				if t then
					table.insert(l.Cuts, t)
				end
			end
		end
	end
	for _, l in ipairs(lines) do
		table.sort(l.Cuts)
		local rise = l.Opts.Rise or 0
		local prev: string? = nil
		local prevT = -1
		for _, t in ipairs(l.Cuts) do
			if t - prevT > 1e-6 then
				local x, z = l.AX + (l.BX - l.AX) * t, l.AZ + (l.BZ - l.AZ) * t
				local id = node(x, z, y0, (t > 1e-6 and t < 1 - 1e-6) and "Junction" or "Junction")
				if prev then
					local na, nb = nodes[prev], nodes[id]
					local pts = { { X = na.X, Y = na.Y, Z = na.Z }, { X = nb.X, Y = nb.Y, Z = nb.Z } }
					if rise > 0 then
						-- (colline des manoirs : rampes aux deux bouts du plateau)
						local len = math.sqrt((nb.X - na.X) ^ 2 + (nb.Z - na.Z) ^ 2)
						local ramp = WorldLayout.MANSION_RAMP
						local startU = WorldLayout.GRID_HALF + 2
						pts = {}
						local stations = { 0, startU, startU + ramp, len - startU - ramp, len - startU, len }
						for _, s in ipairs(stations) do
							local f = s / len
							local yy = y0
							if s > startU + ramp - 1e-6 and s < len - startU - ramp + 1e-6 then
								yy = y0 + rise
							end
							table.insert(pts, { X = na.X + (nb.X - na.X) * f, Y = yy, Z = na.Z + (nb.Z - na.Z) * f })
						end
					end
					addEdge(prev, id, l.Kind, {
						Width = l.Opts.Width,
						Lanes = l.Opts.Lanes,
						Speed = l.Opts.Speed,
						Sidewalk = l.Opts.Sidewalk,
						Points = pts,
					})
				end
				prev = id
				prevT = t
			end
		end
	end
	-- rond-point du dépose-minute (derrière la porte) : 4 nœuds, sens unique
	do
		local cz = WorldLayout.GateDistance(count) + WorldLayout.ARRIVAL_LOOP
		local rr = WorldLayout.ARRIVAL_LOOP_R
		local ids = {}
		for q = 0, 3 do
			local a = q * math.pi / 2
			ids[q + 1] = node(math.sin(a) * rr, cz + math.cos(a) * rr, y0, "Roundabout")
		end
		-- (le bout de la route de l'entrée est un nœud du rond-point)
		nodes[ids[1]].Kind = "Roundabout"
		for q = 1, 4 do
			local a0 = (q - 1) * math.pi / 2
			local pts = {}
			for s2 = 0, 4 do
				local a = a0 + s2 / 4 * math.pi / 2
				table.insert(pts, { X = math.sin(a) * rr, Y = y0, Z = cz + math.cos(a) * rr })
			end
			addEdge(ids[q], ids[q % 4 + 1], "Roundabout", { Width = 10, Lanes = 1, OneWay = true, Speed = 16, Sidewalk = 0, LaneOffsets = { 0 }, Points = pts })
		end
	end
	-- passages piétons : sur chaque bras de chaque carrefour avec trottoirs
	local seen: { [string]: boolean } = {}
	for _, jn in ipairs(junctions) do
		local key = r2(jn.X) .. "_" .. r2(jn.Z)
		if not seen[key] then
			seen[key] = true
			local id = "n" .. key
			for _, e in ipairs(edges) do
				if (e.A == id or e.B == id) and e.Sidewalk > 0 then
					local from = e.A == id and e.Points[1] or e.Points[#e.Points]
					local to = e.A == id and e.Points[2] or e.Points[#e.Points - 1]
					local dx, dz = to.X - from.X, to.Z - from.Z
					local len = math.sqrt(dx * dx + dz * dz)
					if len > 60 then
						local ux, uz = dx / len, dz / len
						local back = WorldLayout.GRID_HALF + 5
						table.insert(crossings, {
							X = from.X + ux * back,
							Y = from.Y,
							Z = from.Z + uz * back,
							-- (la bande traverse la chaussée : regard le long de la route)
							Yaw = yawOf(ux, uz),
							Length = e.Width,
							Width = 5,
						})
					end
				end
			end
		end
	end
	-- AUTOROUTE : anneau (arêtes à double sens, 2 voies par sens), coupé aux
	-- départs / arrivées des bretelles
	local hw = WorldLayout.HighwayPath(count)
	local T = WorldLayout.RAMP_T
	local hwOpts = {
		Width = WorldLayout.HIGHWAY_W,
		Lanes = 2,
		LaneOffsets = WorldLayout.HIGHWAY_LANES,
		Speed = WorldLayout.SPEED.Highway,
		Highway = true,
		Sidewalk = 0,
	}
	-- points de coupe (sur les côtés droits) : (t = ±RAMP_T, n = 0) de chaque échangeur
	local cutPoints: { RoadPoint } = {}
	for _, ix in ipairs(INTERCHANGES) do
		for _, t in ipairs({ -T, T }) do
			table.insert(cutPoints, ixPoint(ix, H, t, 0))
		end
	end
	-- polyligne fermée + points de coupe insérés à leur place
	local ring: { RoadPoint } = {}
	for i = 1, #hw do
		table.insert(ring, hw[i])
		local a, b = hw[i], hw[i % #hw + 1]
		local inserts = {}
		for _, c in ipairs(cutPoints) do
			local dx, dz = b.X - a.X, b.Z - a.Z
			local len2 = dx * dx + dz * dz
			if len2 > 1 then
				local t = ((c.X - a.X) * dx + (c.Z - a.Z) * dz) / len2
				local px, pz = a.X + dx * t, a.Z + dz * t
				if t > 1e-6 and t < 1 - 1e-6 and (px - c.X) ^ 2 + (pz - c.Z) ^ 2 < 0.25 then
					table.insert(inserts, { T = t, P = c })
				end
			end
		end
		table.sort(inserts, function(p, q)
			return p.T < q.T
		end)
		for _, ins in ipairs(inserts) do
			local p = ins.P :: RoadPoint
			table.insert(ring, { X = p.X, Y = p.Y, Z = p.Z, Cut = true } :: any)
		end
	end
	-- premier point de coupe comme départ
	local startIdx = 1
	for i, p in ipairs(ring) do
		if (p :: any).Cut then
			startIdx = i
			break
		end
	end
	local nRing = #ring
	local segPts: { RoadPoint } = { ring[startIdx] }
	local segStart = node(ring[startIdx].X, ring[startIdx].Z, y0, "Highway")
	for k = 1, nRing do
		local p = ring[(startIdx + k - 1) % nRing + 1]
		table.insert(segPts, { X = p.X, Y = p.Y, Z = p.Z })
		if (p :: any).Cut then
			local id = node(p.X, p.Z, y0, "Highway")
			local opts = table.clone(hwOpts)
			opts.Points = segPts
			addEdge(segStart, id, "Highway", opts)
			segStart = id
			segPts = { { X = p.X, Y = p.Y, Z = p.Z } }
		end
	end
	-- ÉCHANGEURS en losange : connecteur de la ceinture au pont, pont,
	-- route au-delà (rond-point), 4 bretelles
	local J = WorldLayout.RAMP_JUNCTION
	local outEnd = WorldLayout.OUTSIDE_END
	local rampOpts = { Width = WorldLayout.RAMP_W, Lanes = 1, OneWay = true, Speed = WorldLayout.SPEED.Ramp, Ramp = true, Sidewalk = 0, LaneOffsets = { 0 } }
	for _, ix in ipairs(INTERCHANGES) do
		local beltN = -(H - R) -- n de la ceinture
		local pBelt = ixPoint(ix, H, 0, beltN)
		local pCity = ixPoint(ix, H, 0, -J)
		local pOut = ixPoint(ix, H, 0, J)
		local pEnd = ixPoint(ix, H, 0, outEnd)
		local nBelt = node(pBelt.X, pBelt.Z, y0, "Junction")
		local nCity = node(pCity.X, pCity.Z, y0, "Junction")
		local nOut = node(pOut.X, pOut.Z, y0, "Junction")
		local nEnd = node(pEnd.X, pEnd.Z, y0, "Roundabout")
		local connectorKind = ix.Id == "S" and "Entrance" or "Connector"
		addEdge(nBelt, nCity, connectorKind, { Width = WorldLayout.ROAD_W, Lanes = 1, Speed = WorldLayout.SPEED.Avenue, Sidewalk = WorldLayout.WALK_W })
		-- pont : profil en long (points tous les 15 studs)
		local bridgePts: { RoadPoint } = {}
		for _, n in ipairs(WorldLayout.BridgeStations()) do
			table.insert(bridgePts, ixPoint(ix, H, 0, n, WorldLayout.BridgeProfile(n)))
		end
		addEdge(nCity, nOut, "Connector", { Width = WorldLayout.ROAD_W, Lanes = 1, Speed = WorldLayout.SPEED.Avenue, Sidewalk = 3, Bridge = true, Points = bridgePts })
		addEdge(nOut, nEnd, "Outside", { Width = WorldLayout.ROAD_W, Lanes = 1, Speed = WorldLayout.SPEED.Avenue, Sidewalk = WorldLayout.WALK_W })
		-- petit rond-point au bout (demi-tour) : 4 nœuds autour de nEnd
		local rr = 22
		local ringIds = {}
		for q = 0, 3 do
			local a = q * math.pi / 2
			local p = ixPoint(ix, H, math.sin(a) * rr, outEnd + math.cos(a) * rr)
			ringIds[q + 1] = node(p.X, p.Z, y0, "Roundabout")
		end
		for q = 1, 4 do
			local a0 = (q - 1) * math.pi / 2
			local pts = {}
			for s = 0, 4 do
				local a = a0 + s / 4 * math.pi / 2
				table.insert(pts, ixPoint(ix, H, math.sin(a) * rr, outEnd + math.cos(a) * rr))
			end
			addEdge(ringIds[q], ringIds[q % 4 + 1], "Roundabout", { Width = 12, Lanes = 1, OneWay = true, Speed = 20, Sidewalk = 0, LaneOffsets = { 0 }, Points = pts })
		end
		-- le bout de la route rejoint le rond-point (côté ville du cercle : q = 3 -> angle pi)
		-- (nEnd est au centre : on remplace l'arête nOut -> nEnd par nOut -> bas du cercle)
		local last = edges[#edges - 4]
		local south = ringIds[3]
		last.B = south
		last.Points = { { X = nodes[nOut].X, Y = y0, Z = nodes[nOut].Z }, { X = nodes[south].X, Y = y0, Z = nodes[south].Z } }
		last.Length = polyLength(last.Points)
		nodes[nEnd] = nil
		for i2, nd in ipairs(nodeList) do
			if nd.Id == nEnd then
				table.remove(nodeList, i2)
				break
			end
		end
		-- bretelles (chaussée côté ville = sens -t, chaussée extérieure = sens +t)
		local hwIn = node(ixPoint(ix, H, T, 0).X, ixPoint(ix, H, T, 0).Z, y0, "Highway") -- +T
		local hwOut = node(ixPoint(ix, H, -T, 0).X, ixPoint(ix, H, -T, 0).Z, y0, "Highway") -- -T
		local edgeN = WorldLayout.HIGHWAY_W / 2
		local function rampPts(list: { { number } }): { RoadPoint }
			local out = {}
			for _, tn in ipairs(list) do
				table.insert(out, ixPoint(ix, H, tn[1], tn[2]))
			end
			return out
		end
		-- sortie côté ville (vient de +t, roule vers -t) : +T -> carrefour ville
		addEdge(hwIn, nCity, "Ramp", (function()
			local o = table.clone(rampOpts)
			o.Points = rampPts({ { T, -WorldLayout.HIGHWAY_LANES[2] }, { T - 70, -edgeN - 4 }, { T - 170, -edgeN - 30 }, { 110, -J + 60 }, { 24, -J + 6 }, { 0, -J } })
			return o
		end)())
		-- entrée côté ville : carrefour ville -> -T (roule vers -t)
		addEdge(nCity, hwOut, "Ramp", (function()
			local o = table.clone(rampOpts)
			o.Points = rampPts({ { 0, -J }, { -24, -J + 6 }, { -110, -J + 60 }, { -(T - 170), -edgeN - 30 }, { -(T - 70), -edgeN - 4 }, { -T, -WorldLayout.HIGHWAY_LANES[2] } })
			return o
		end)())
		-- sortie extérieure (vient de -t, roule vers +t) : -T -> carrefour extérieur
		addEdge(hwOut, nOut, "Ramp", (function()
			local o = table.clone(rampOpts)
			o.Points = rampPts({ { -T, WorldLayout.HIGHWAY_LANES[2] }, { -(T - 70), edgeN + 4 }, { -(T - 170), edgeN + 30 }, { -110, J - 60 }, { -24, J - 6 }, { 0, J } })
			return o
		end)())
		-- entrée extérieure : carrefour extérieur -> +T (roule vers +t)
		addEdge(nOut, hwIn, "Ramp", (function()
			local o = table.clone(rampOpts)
			o.Points = rampPts({ { 0, J }, { 24, J - 6 }, { 110, J - 60 }, { T - 170, edgeN + 30 }, { T - 70, edgeN + 4 }, { T, WorldLayout.HIGHWAY_LANES[2] } })
			return o
		end)())
	end
	-- voisins
	local adjacent: { [string]: { RoadEdge } } = {}
	for _, e in ipairs(edges) do
		adjacent[e.A] = adjacent[e.A] or {}
		table.insert(adjacent[e.A], e)
		if not e.OneWay then
			adjacent[e.B] = adjacent[e.B] or {}
			table.insert(adjacent[e.B], e)
		end
	end
	local graph: RoadGraph = { Nodes = nodes, NodeList = nodeList, Edges = edges, Adjacent = adjacent, Crossings = crossings }
	graphCache[count] = graph
	return graph
end

-- Graphe routier de la ville (en cache : ne pas modifier)
function WorldLayout.RoadGraph(count: number): RoadGraph
	return buildGraph(WorldLayout.PlotCount(count))
end

-- Polyligne d'une arête dans le sens `fromId` -> l'autre bout
function WorldLayout.EdgePoints(edge: RoadEdge, fromId: string?): { RoadPoint }
	if fromId == nil or fromId == edge.A then
		return edge.Points
	end
	local out = table.create(#edge.Points)
	for i = #edge.Points, 1, -1 do
		table.insert(out, edge.Points[i])
	end
	return out
end

-- Plus court chemin (Dijkstra, longueurs des arêtes, sens uniques
-- respectés) : liste d'arêtes + liste des nœuds, ou nil
function WorldLayout.RoutePath(count: number, fromId: string, toId: string): ({ RoadEdge }?, { string }?)
	local g = WorldLayout.RoadGraph(count)
	if not g.Nodes[fromId] or not g.Nodes[toId] then
		return nil, nil
	end
	local dist: { [string]: number } = { [fromId] = 0 }
	local via: { [string]: RoadEdge } = {}
	local done: { [string]: boolean } = {}
	while true do
		local best, bestD = nil, math.huge
		for id, dd in pairs(dist) do
			if not done[id] and dd < bestD then
				best, bestD = id, dd
			end
		end
		if not best or best == toId then
			break
		end
		done[best] = true
		for _, e in ipairs(g.Adjacent[best] or {}) do
			local other = e.A == best and e.B or e.A
			local nd = bestD + e.Length
			if nd < (dist[other] or math.huge) then
				dist[other] = nd
				via[other] = e
			end
		end
	end
	if not dist[toId] then
		return nil, nil
	end
	local pathEdges, pathNodes = {}, { toId }
	local cur = toId
	while cur ~= fromId do
		local e = via[cur]
		table.insert(pathEdges, 1, e)
		cur = e.A == cur and e.B or e.A
		table.insert(pathNodes, 1, cur)
	end
	return pathEdges, pathNodes
end

-- Nœud le plus proche d'un point (repère ville) ; `filter(node)` facultatif
function WorldLayout.NearestNode(count: number, x: number, z: number, filter: ((RoadNode) -> boolean)?): RoadNode?
	local best, bestD = nil, math.huge
	for _, n in ipairs(WorldLayout.RoadGraph(count).NodeList) do
		if not filter or filter(n) then
			local d = (n.X - x) ^ 2 + (n.Z - z) ^ 2
			if d < bestD then
				best, bestD = n, d
			end
		end
	end
	return best
end

-- Point le plus proche sur la chaussée : (arête, x, y, z, distance, t 0..1 le long de l'arête)
function WorldLayout.NearestRoad(count: number, x: number, z: number, filter: ((RoadEdge) -> boolean)?): (RoadEdge?, number, number, number, number, number)
	local bestE, bx, by, bz, bestD, bestT = nil, 0, 0, 0, math.huge, 0
	for _, e in ipairs(WorldLayout.RoadGraph(count).Edges) do
		if not filter or filter(e) then
			local acc = 0
			for i = 2, #e.Points do
				local a, b = e.Points[i - 1], e.Points[i]
				local dx, dz = b.X - a.X, b.Z - a.Z
				local len2 = dx * dx + dz * dz
				local seg = math.sqrt(len2 + (b.Y - a.Y) ^ 2)
				local t = len2 > 0 and math.clamp(((x - a.X) * dx + (z - a.Z) * dz) / len2, 0, 1) or 0
				local px, pz = a.X + dx * t, a.Z + dz * t
				local d = math.sqrt((px - x) ^ 2 + (pz - z) ^ 2)
				if d < bestD then
					bestE, bx, by, bz, bestD = e, px, a.Y + (b.Y - a.Y) * t, pz, d
					bestT = e.Length > 0 and (acc + seg * t) / e.Length or 0
				end
				acc += seg
			end
		end
	end
	return bestE, bx, by, bz, bestD, bestT
end

-- Point à la distance `s` le long d'une polyligne : x, y, z, direction (dx, dz)
function WorldLayout.PointAlong(points: { RoadPoint }, s: number): (number, number, number, number, number)
	local remain = math.max(0, s)
	for i = 2, #points do
		local a, b = points[i - 1], points[i]
		local seg = math.sqrt((b.X - a.X) ^ 2 + (b.Y - a.Y) ^ 2 + (b.Z - a.Z) ^ 2)
		if remain <= seg or i == #points then
			local t = seg > 0 and math.clamp(remain / seg, 0, 1) or 0
			local hl = math.sqrt((b.X - a.X) ^ 2 + (b.Z - a.Z) ^ 2)
			local dx, dz = 0, -1
			if hl > 1e-6 then
				dx, dz = (b.X - a.X) / hl, (b.Z - a.Z) / hl
			end
			return a.X + (b.X - a.X) * t, a.Y + (b.Y - a.Y) * t, a.Z + (b.Z - a.Z) * t, dx, dz
		end
		remain -= seg
	end
	local p = points[#points]
	return p.X, p.Y, p.Z, 0, -1
end

-- Nœuds nommés utiles aux courses (RACE10) : carrefours remarquables
function WorldLayout.RaceAnchors(count: number): { [string]: string }
	local B, R = WorldLayout.DOWNTOWN_B, WorldLayout.BeltR(count)
	local H = WorldLayout.HighwayR(count)
	local out: { [string]: string } = {}
	local g = WorldLayout.RoadGraph(count)
	local function id(x: number, z: number): string
		return "n" .. r2(x) .. "_" .. r2(z)
	end
	for name, p in pairs({
		DowntownSE = { B, B }, DowntownSW = { -B, B }, DowntownNE = { B, -B }, DowntownNW = { -B, -B },
		BeltSE = { R, R }, BeltSW = { -R, R }, BeltNE = { R, -R }, BeltNW = { -R, -R },
		BeltS = { 0, R }, BeltN = { 0, -R }, BeltE = { R, 0 }, BeltW = { -R, 0 },
		EntranceBoulevard = { 0, B },
		EntranceLoop = { 0, WorldLayout.GateDistance(count) + WorldLayout.ARRIVAL_LOOP + WorldLayout.ARRIVAL_LOOP_R },
		MarketStreetW = { -B, WorldLayout.MARKET_STREET_Z }, MarketStreetE = { B, WorldLayout.MARKET_STREET_Z },
	}) do
		local key = id(p[1], p[2])
		if g.Nodes[key] then
			out[name] = key
		end
	end
	for _, ix in ipairs(INTERCHANGES) do
		local pc = ixPoint(ix, H, 0, -WorldLayout.RAMP_JUNCTION)
		local po = ixPoint(ix, H, 0, WorldLayout.RAMP_JUNCTION)
		local ph = ixPoint(ix, H, WorldLayout.RAMP_T, 0)
		out["Ramp" .. ix.Id .. "City"] = id(pc.X, pc.Z)
		out["Ramp" .. ix.Id .. "Out"] = id(po.X, po.Z)
		out["Highway" .. ix.Id] = id(ph.X, ph.Z)
	end
	return out
end

----------------------------------------------------------------------
-- (v10) Lieux réservés (repère ville) : rectangles orientés
----------------------------------------------------------------------
-- { Id, Name, Kind, X, Z, W (largeur, x local), D (profondeur, z local),
--   Yaw (radians : CFrame.Angles(0, Yaw, 0)), Y }. Kind : "Downtown" |
--   "Facility" | "District" | "Nature" | "Highway". Un point est "dans" un
--   lieu s'il est dans son rectangle (repère local).
export type Zone = { Id: string, Name: string, Kind: string, X: number, Z: number, W: number, D: number, Yaw: number, Y: number }

-- (v10) point de rendez-vous des courses (RACE10) : à gauche de l'avenue
-- d'entrée (ligne droite de ~530 studs entre la porte et la ceinture)
WorldLayout.RACE_MEET_Z = 560
WorldLayout.RACE_MEET_W = 44 -- (x) profondeur depuis le trottoir
WorldLayout.RACE_MEET_D = 64 -- (z) le long de l'avenue

local zoneCache: { [number]: { Zone } } = {}
function WorldLayout.Facilities(count: number): { Zone }
	local n = WorldLayout.PlotCount(count)
	local cached = zoneCache[n]
	if cached then
		return cached
	end
	local B, R, H = WorldLayout.DOWNTOWN_B, WorldLayout.BeltR(n), WorldLayout.HighwayR(n)
	local gate = WorldLayout.GateDistance(n)
	local front = WorldLayout.PlotFrontRadius(n)
	local zones: { Zone } = {}
	local function add(id: string, name: string, kind: string, x: number, z: number, w: number, d: number, yaw: number?, y: number?)
		table.insert(zones, { Id = id, Name = name, Kind = kind, X = x, Z = z, W = w, D = d, Yaw = yaw or 0, Y = y or 0 })
	end
	local inner = B - WorldLayout.ROAD_W / 2 - WorldLayout.WALK_W
	add("Downtown", "Downtown", "Downtown", 0, 0, 2 * inner, 2 * inner)
	add("Plaza", "Main square", "Downtown", 0, 0, 2 * (WorldLayout.PLAZA_R + 30), 2 * (WorldLayout.PLAZA_R + 30))
	add("TownHall", "Town hall", "Downtown", 0, -(WorldLayout.PLAZA_R + 16), 60, 30)
	add("Fair", "Fun fair", "Facility", 0, -(WorldLayout.FAIR_NEAR + WorldLayout.FAIR_D / 2), WorldLayout.FAIR_W, WorldLayout.FAIR_D)
	add("MusicStage", "Music stage", "Downtown", math.sin(math.rad(225)) * 42, math.cos(math.rad(225)) * 42, 24, 16)
	add("FoodCorner", "Food corner", "Facility", 70, front + 9 + WorldLayout.FOOD_D / 2, WorldLayout.FOOD_W, WorldLayout.FOOD_D)
	add("Gate", "Town gate", "Facility", 0, gate, 64, 24)
	add("Market", "MégaDopa", "Facility", WorldLayout.MARKET_X + WorldLayout.MARKET_D / 2, gate + 20 + WorldLayout.MARKET_W / 2, WorldLayout.MARKET_D, WorldLayout.MARKET_W)
	add("MarketLot", "MégaDopa parking", "Facility", WorldLayout.MARKET_X - WorldLayout.MARKET_LOT / 2, gate + 20 + WorldLayout.MARKET_W / 2, WorldLayout.MARKET_LOT, WorldLayout.MARKET_W)
	add("Dealership", "Car dealer", "Facility", -(WorldLayout.DEALER_X + WorldLayout.DEALER_D / 2), gate + WorldLayout.DEALER_Z0 + WorldLayout.DEALER_W / 2, WorldLayout.DEALER_D, WorldLayout.DEALER_W)
	-- (W = le long de l'avenue, D = profondeur ; regard vers l'avenue, +X)
	add("RaceMeet", "Race meeting point", "Facility", -(WorldLayout.GRID_HALF + 4 + WorldLayout.RACE_MEET_W / 2), WorldLayout.RACE_MEET_Z, WorldLayout.RACE_MEET_D, WorldLayout.RACE_MEET_W, -math.pi / 2)
	-- case sud, au-delà du rendez-vous des courses : gare routière / parc relais (libre pour CITY10)
	local s0, s1 = gate + 20 + WorldLayout.MARKET_W + 16, R - WorldLayout.GRID_HALF - 4
	local sp0 = math.max(s0, WorldLayout.RACE_MEET_Z + WorldLayout.RACE_MEET_D / 2 + 8)
	if s1 - sp0 >= 30 then
		add("SouthPark", "South park", "Nature", 0, (sp0 + s1) / 2, 2 * (B - WorldLayout.GRID_HALF - 4), s1 - sp0)
	end
	-- cases nord-ouest / nord-est : bois des collines, parc des sports
	do
		local x0, x1, z0, z1 = cellRect(-1, -1, R)
		add("HillWoods", "Hill woods", "Nature", (x0 + x1) / 2, (z0 + z1) / 2, x1 - x0, z1 - z0)
		x0, x1, z0, z1 = cellRect(1, -1, R)
		add("SportsPark", "Sports park", "Nature", (x0 + x1) / 2, (z0 + z1) / 2, x1 - x0, z1 - z0)
	end
	for _, d in ipairs(WorldLayout.Districts(n)) do
		add("District_" .. d.Id, d.Name, "District", d.Bounds.X, d.Bounds.Z, d.Bounds.W, d.Bounds.D, 0, d.Rise)
	end
	-- échangeurs : aire de repos au sud, belvédères ailleurs (au bout de la route extérieure)
	for _, ix in ipairs(INTERCHANGES) do
		local p = ixPoint(ix, H, 0, WorldLayout.OUTSIDE_END)
		local yaw = yawOf(-ix.NX, -ix.NZ)
		add("Interchange_" .. ix.Id, "Interchange", "Highway", ix.NX * H, ix.NZ * H, (ix.NX ~= 0) and 2 * WorldLayout.RAMP_JUNCTION + 40 or 2 * WorldLayout.RAMP_T + 40, (ix.NX ~= 0) and 2 * WorldLayout.RAMP_T + 40 or 2 * WorldLayout.RAMP_JUNCTION + 40)
		add(ix.Id == "S" and "RestArea" or ("Lookout_" .. ix.Id), ix.Id == "S" and "Rest area" or "Lookout", "Highway", p.X + ix.NX * 40, p.Z + ix.NZ * 40, 70, 50, yaw)
	end
	zoneCache[n] = zones
	return zones
end

function WorldLayout.Facility(count: number, id: string): Zone?
	for _, z in ipairs(WorldLayout.Facilities(count)) do
		if z.Id == id then
			return z
		end
	end
	return nil
end

-- Point (x, z) dans un lieu (marge en studs, > 0 = plus large)
function WorldLayout.InZone(zone: Zone, x: number, z: number, margin: number?): boolean
	local c, s = math.cos(zone.Yaw), math.sin(zone.Yaw)
	local dx, dz = x - zone.X, z - zone.Z
	-- repère local : x = RightVector, z = -LookVector (CFrame.Angles(0, yaw, 0))
	local lx = dx * c - dz * s
	local lz = dx * s + dz * c
	local m = margin or 0
	return math.abs(lx) <= zone.W / 2 + m and math.abs(lz) <= zone.D / 2 + m
end

-- Distance (x, z) à l'axe d'une arête (polyligne), à plat
local function edgeDistance(e: RoadEdge, x: number, z: number): number
	local best = math.huge
	for i = 2, #e.Points do
		local a, b = e.Points[i - 1], e.Points[i]
		local dx, dz = b.X - a.X, b.Z - a.Z
		local len2 = dx * dx + dz * dz
		local t = len2 > 0 and math.clamp(((x - a.X) * dx + (z - a.Z) * dz) / len2, 0, 1) or 0
		best = math.min(best, math.sqrt((a.X + dx * t - x) ^ 2 + (a.Z + dz * t - z) ^ 2))
	end
	return best
end
WorldLayout.EdgeDistance = edgeDistance

-- Sur une route (chaussée + trottoirs + `margin`) ?
function WorldLayout.OnRoad(count: number, x: number, z: number, margin: number?): boolean
	local m = margin or 0
	for _, e in ipairs(WorldLayout.RoadGraph(count).Edges) do
		local half = e.Width / 2 + e.Sidewalk + m
		-- (boîte englobante d'abord)
		local p1, p2 = e.Points[1], e.Points[#e.Points]
		local minX, maxX = math.min(p1.X, p2.X), math.max(p1.X, p2.X)
		local minZ, maxZ = math.min(p1.Z, p2.Z), math.max(p1.Z, p2.Z)
		for _, p in ipairs(e.Points) do
			minX, maxX = math.min(minX, p.X), math.max(maxX, p.X)
			minZ, maxZ = math.min(minZ, p.Z), math.max(maxZ, p.Z)
		end
		if x >= minX - half and x <= maxX + half and z >= minZ - half and z <= maxZ + half then
			if edgeDistance(e, x, z) <= half then
				return true
			end
		end
	end
	return false
end

-- Sur une parcelle (ou une place vide de quartier) ? (marge en studs)
function WorldLayout.OnPlot(count: number, x: number, z: number, margin: number?): boolean
	local m = margin or 0
	local city = buildCity(WorldLayout.PlotCount(count))
	local W, D = WorldLayout.PLOT_W, WorldLayout.PLOT_D
	local function inside(p: any): boolean
		local dx, dz = x - p.X, z - p.Z
		-- largeur le long de la rue (perpendiculaire au regard)
		local along = math.abs(dx * p.LookZ - dz * p.LookX)
		local across = math.abs(dx * p.LookX + dz * p.LookZ)
		return along <= W / 2 + m and across <= D / 2 + m
	end
	for _, p in ipairs(city.Plots) do
		if inside(p) then
			return true
		end
	end
	for _, d in ipairs(city.Districts) do
		for _, lot in ipairs(d.Lots) do
			if inside(lot) then
				return true
			end
		end
	end
	return false
end

-- Place libre en ville (ni route, ni parcelle, ni lieu réservé sauf les
-- zones de type "Downtown" / "District" / "Nature", qui accueillent le décor)
-- pour un objet de rayon r
function WorldLayout.IsFreeAt(count: number, x: number, z: number, r: number): boolean
	if WorldLayout.OnRoad(count, x, z, r) or WorldLayout.OnPlot(count, x, z, r) then
		return false
	end
	for _, zone in ipairs(WorldLayout.Facilities(count)) do
		if (zone.Kind == "Facility" or zone.Kind == "Highway") and WorldLayout.InZone(zone, x, z, r) then
			return false
		end
	end
	if math.sqrt(x * x + z * z) < WorldLayout.PLAZA_R + 26 + r then
		return false
	end
	return math.max(math.abs(x), math.abs(z)) < WorldLayout.TownRadius(count) - 20 - r
end

----------------------------------------------------------------------
-- Repères Roblox (CFrame) : utilisés en jeu uniquement (pas dans les tests)
----------------------------------------------------------------------

-- Centre de la ville (loin de la Baseplate du lieu)
WorldLayout.ORIGIN_X, WorldLayout.ORIGIN_Y, WorldLayout.ORIGIN_Z = 0, 60, 2600

function WorldLayout.Origin(): Vector3
	return Vector3.new(WorldLayout.ORIGIN_X, WorldLayout.ORIGIN_Y, WorldLayout.ORIGIN_Z)
end

-- (v10) Point / repère en jeu depuis le repère ville (x, y, z depuis Origin)
function WorldLayout.CityPoint(x: number, y: number, z: number): Vector3
	return WorldLayout.Origin() + Vector3.new(x, y, z)
end

-- Repère au sol : position (x, y, z) ville, CFrame.Angles(0, yaw, 0)
function WorldLayout.CityCFrame(x: number, z: number, yaw: number?, y: number?): CFrame
	return CFrame.new(WorldLayout.CityPoint(x, y or 0, z)) * CFrame.Angles(0, yaw or 0, 0)
end

-- Parcelle : centre au niveau du sol (Origin().Y, + MANSION_RISE sur la
-- colline des manoirs), LookVector = vers SA RUE (v10 ; avant : vers la place)
function WorldLayout.PlotCFrame(index: number, count: number): CFrame
	local place = WorldLayout.PlotPlaceData(index, count)
	if not place then
		return CFrame.new(WorldLayout.Origin())
	end
	local center = WorldLayout.CityPoint(place.X, place.Y, place.Z)
	return CFrame.lookAt(center, center + Vector3.new(place.LookX, 0, place.LookZ))
end

-- (v10) Place vide d'un quartier (FillerLots) : même repère qu'une parcelle
function WorldLayout.LotCFrame(lot: Lot): CFrame
	local center = WorldLayout.CityPoint(lot.X, lot.Y, lot.Z)
	return CFrame.lookAt(center, center + Vector3.new(lot.LookX, 0, lot.LookZ))
end

-- (v10) Lieu réservé (Facilities) : centre au sol, CFrame.Angles(0, Yaw, 0)
function WorldLayout.ZoneCFrame(zone: Zone): CFrame
	return WorldLayout.CityCFrame(zone.X, zone.Z, zone.Yaw, zone.Y)
end

-- (v9.4) Porte de la ville : centre de l'arche au sol, LookVector = vers la place
function WorldLayout.GateCFrame(count: number): CFrame
	local p = WorldLayout.Origin() + Vector3.new(0, WorldLayout.WALK_Y, WorldLayout.GateDistance(count))
	return CFrame.lookAt(p, p - Vector3.new(0, 0, 1))
end

-- Apparition à l'entrée : pieds ~3 studs au-dessus du pavé, juste à
-- l'intérieur de la porte, regard vers l'avenue et la place
function WorldLayout.EntranceCFrame(count: number): CFrame
	local p = WorldLayout.Origin() + Vector3.new(0, WorldLayout.WALK_Y + 3, WorldLayout.GateDistance(count) - WorldLayout.SPAWN_INSIDE)
	return CFrame.lookAt(p, p - Vector3.new(0, 0, 1))
end

-- (v9.7, BUILDINGS97) 🛒 Supermarché, hors de la porte, à droite de la
-- route d'arrivée (en venant de la ville) : façade tournée vers la route
-- (-X monde), parking entre les deux. (v9.8, MARKET98) agrandi à 104 x 68,
-- reculé (+Z : l'entrée fait face au rond-point) ; tient dans les murs de
-- 4 à 12 parcelles (TOWN_MARGIN 140 ; coin le plus loin : x = 148,
-- z = porte + 124) sans toucher les parcelles, la route ni le rond-point.
WorldLayout.MARKET_W = 104 -- façade (le long de la route) ; v9.7 : 70
WorldLayout.MARKET_D = 68 -- profondeur ; v9.7 : 48
WorldLayout.MARKET_X = 74 -- distance de la façade à l'axe de la route
WorldLayout.MARKET_LOT = 42 -- profondeur du parking devant la façade (trottoir compris : +10)

-- Pied de la façade (milieu), LookVector vers la route ; volume derrière (+Z local)
function WorldLayout.MarketCFrame(count: number): CFrame
	local p = WorldLayout.Origin() + Vector3.new(WorldLayout.MARKET_X, WorldLayout.WALK_Y, WorldLayout.GateDistance(count) + 20 + WorldLayout.MARKET_W / 2)
	return CFrame.lookAt(p, p - Vector3.new(1, 0, 0))
end

-- (v9.8, CARS98) 🚗 CONCESSION AUTO, hors de la porte, à GAUCHE de la route
-- d'arrivée (le miroir du supermarché) : grand hall vitré DEALER_W (façade,
-- le long de la route) x DEALER_D (profondeur), façade tournée vers la route
-- (+X monde) ; parvis avec le plateau tournant entre le hall et la route.
-- Tout est relatif à la porte : tient de 4 à 12 parcelles (derrière le fond
-- des parcelles, avant le rond-point, dans les murs).
WorldLayout.DEALER_W = 70
WorldLayout.DEALER_D = 50
WorldLayout.DEALER_X = 60 -- distance de la façade à l'axe de la route
WorldLayout.DEALER_Z0 = 14 -- début du hall après la porte (le long de la route)

-- Pied de la façade (milieu), LookVector vers la route ; volume derrière (+Z local)
function WorldLayout.DealershipCFrame(count: number): CFrame
	local p = WorldLayout.Origin() + Vector3.new(-WorldLayout.DEALER_X, WorldLayout.WALK_Y, WorldLayout.GateDistance(count) + WorldLayout.DEALER_Z0 + WorldLayout.DEALER_W / 2)
	return CFrame.lookAt(p, p + Vector3.new(1, 0, 0))
end

-- (v9.8, FAIR98) 🎡 FÊTE FORAINE : derrière la mairie, dans le secteur
-- arrière de l'anneau (axe -Z), rectangle FAIR_W x FAIR_D dont le bord
-- avant est à FAIR_NEAR studs du centre. Tient de 4 à 12 parcelles (bord
-- du boulevard, lac, jardin, terrain de basket : vérifié). Repère : centre
-- du sol de la fête (FairRides.GROUND au-dessus du pré), LookVector vers
-- la place (l'entrée) ; x local ∈ [-FAIR_W/2, FAIR_W/2], z ∈ [-FAIR_D/2, FAIR_D/2].
WorldLayout.FAIR_W = 110
WorldLayout.FAIR_D = 72
WorldLayout.FAIR_NEAR = 104 -- (couloir de ~14 studs derrière la mairie)
WorldLayout.FAIR_GROUND = 0.15

function WorldLayout.FairCFrame(): CFrame
	local p = WorldLayout.Origin() + Vector3.new(0, WorldLayout.GROUND_Y + WorldLayout.FAIR_GROUND, -(WorldLayout.FAIR_NEAR + WorldLayout.FAIR_D / 2))
	return CFrame.lookAt(p, p + Vector3.new(0, 0, 1))
end

-- (v9.8, FAIR98) 🍦 Coin gourmand (ancienne place de la concession, à
-- droite de la place d'accueil) : centre au sol, LookVector vers le
-- boulevard (-Z monde) ; x local = x monde ; FOOD_W x FOOD_D
WorldLayout.FOOD_W = 40
WorldLayout.FOOD_D = 44
function WorldLayout.FoodCornerCFrame(count: number): CFrame
	local p = WorldLayout.Origin() + Vector3.new(70, WorldLayout.WALK_Y, WorldLayout.PlotFrontRadius(count) + 9 + WorldLayout.FOOD_D / 2)
	return CFrame.lookAt(p, p - Vector3.new(0, 0, 1))
end

-- Centre de la place, au sol (dessus du pavé)
function WorldLayout.PlazaCFrame(): CFrame
	return CFrame.new(WorldLayout.Origin() + Vector3.new(0, WorldLayout.WALK_Y, 0))
end

-- Maison : milieu de la façade au sol, regarde DANS la maison (RightVector =
-- droite du visiteur qui arrive de la place)
function WorldLayout.HouseCFrame(plotCF: CFrame): CFrame
	local front = plotCF.Position + plotCF.LookVector * WorldLayout.HouseFrontOffset()
	return CFrame.lookAt(front, front - plotCF.LookVector)
end

-- Point du repère local (x, y, d) -> monde
function WorldLayout.ToWorld(houseCF: CFrame, x: number, y: number, d: number): Vector3
	return houseCF * Vector3.new(x, y, -d)
end

-- Monde -> repère local (x, y, d)
function WorldLayout.ToLocal(houseCF: CFrame, point: Vector3): (number, number, number)
	local p = houseCF:PointToObjectSpace(point)
	return p.X, p.Y, -p.Z
end

-- Pivot de la coque d'une pièce (House3DScene.BuildRoomShell : centre du
-- dessus du sol, mur du fond vers -Z)
function WorldLayout.ShellPivot(houseCF: CFrame, size: SizeDef?, slot: number): CFrame
	local x, y, d = WorldLayout.RoomCenter(size, slot)
	return houseCF * CFrame.new(x, y, -d)
end

-- Repère de la pièce pour la 2D <-> 3D (face intérieure du mur du fond, +Z vers l'avant)
function WorldLayout.RoomFrame(houseCF: CFrame, size: SizeDef?, slot: number): CFrame
	return WorldLayout.ShellPivot(houseCF, size, slot) * CFrame.new(0, 0, -WorldLayout.DEPTH / 2)
end

-- Apparition devant la porte d'entrée (regarde la maison)
function WorldLayout.DoorSpawn(houseCF: CFrame, size: SizeDef?): CFrame
	local x = WorldLayout.DoorX(size)
	local position = WorldLayout.ToWorld(houseCF, x, 3.2, -WorldLayout.SPAWN_FRONT)
	local target = WorldLayout.ToWorld(houseCF, x, 3.2, 5)
	return CFrame.lookAt(position, target)
end

-- Centre d'une pièce (pour y apparaître)
function WorldLayout.RoomSpawn(houseCF: CFrame, size: SizeDef?, slot: number): CFrame
	local xMin, xMax, yFloor, dMin, dMax = WorldLayout.RoomInterior(size, slot)
	local x = (xMin + xMax) / 2
	local position = WorldLayout.ToWorld(houseCF, x, yFloor + 3.2, dMin + (dMax - dMin) * 0.35)
	return CFrame.lookAt(position, WorldLayout.ToWorld(houseCF, x, yFloor + 3.2, dMax))
end

----------------------------------------------------------------------
-- Accès / visites / "j'aime" (règles pures, testées)
----------------------------------------------------------------------

WorldLayout.OPEN_MODES = { "Everyone", "Friends", "Nobody" }
WorldLayout.DEFAULT_OPEN = "Everyone"
WorldLayout.LIKES_PER_DAY = 10 -- "j'aime" donnés par visiteur et par jour
WorldLayout.LIKE_REWARD_SECONDS = 20 -- visiteur : 20 s de sa production
WorldLayout.LIKED_REWARD_SECONDS = 60 -- propriétaire : 60 s de sa production
WorldLayout.LIKED_REWARDS_PER_DAY = 30 -- "j'aime" reçus récompensés par jour

function WorldLayout.NormalizeOpen(mode: any): string
	if type(mode) == "string" and table.find(WorldLayout.OPEN_MODES, mode) then
		return mode
	end
	return WorldLayout.DEFAULT_OPEN
end

-- Le visiteur peut-il entrer ? (le propriétaire toujours)
function WorldLayout.CanEnter(mode: any, isOwner: boolean, isFriend: boolean): boolean
	if isOwner then
		return true
	end
	local open = WorldLayout.NormalizeOpen(mode)
	if open == "Everyone" then
		return true
	elseif open == "Friends" then
		return isFriend == true
	end
	return false
end

function WorldLayout.DayNumber(now: number): number
	return math.floor(finite(now, 0) / 86400)
end

export type TownData = {
	Open: string,
	Likes: number,
	Visits: number,
	LikeDay: number,
	Liked: { [string]: boolean }, -- maisons aimées aujourd'hui (UserId en texte)
	LikesGiven: number, -- "j'aime" donnés aujourd'hui
	LikedRewards: number, -- "j'aime" reçus récompensés aujourd'hui
	RewardDay: number,
}

-- Données "Town" d'un joueur, réparées (sauvegardes abîmées, anciennes, nouveau jour)
function WorldLayout.SanitizeTown(raw: any, now: number): TownData
	local town = type(raw) == "table" and raw or {}
	local day = WorldLayout.DayNumber(now)
	local sameDay = math.floor(finite(town.LikeDay, -1)) == day
	local liked: { [string]: boolean } = {}
	local given = 0
	if sameDay then
		given = math.max(0, math.floor(finite(town.LikesGiven, 0)))
		if type(town.Liked) == "table" then
			local count = 0
			for key, value in pairs(town.Liked) do
				if type(key) == "string" and #key <= 20 and value == true and count < 200 then
					liked[key] = true
					count += 1
				end
			end
		end
	end
	local rewards = 0
	if math.floor(finite(town.RewardDay, -1)) == day then
		rewards = math.max(0, math.floor(finite(town.LikedRewards, 0)))
	end
	return {
		Open = WorldLayout.NormalizeOpen(town.Open),
		Likes = math.clamp(math.floor(finite(town.Likes, 0)), 0, 1e9),
		Visits = math.clamp(math.floor(finite(town.Visits, 0)), 0, 1e9),
		LikeDay = day,
		Liked = liked,
		LikesGiven = given,
		LikedRewards = rewards,
		RewardDay = day,
	}
end

-- Un "j'aime" de `likerId` pour la maison de `ownerId` est-il permis ?
-- -> (ok, raison) avec raison = "Self" | "Already" | "Limit"
function WorldLayout.CanLike(likerTown: TownData, likerId: number, ownerId: number): (boolean, string?)
	if likerId == ownerId then
		return false, "Self"
	end
	if likerTown.Liked[tostring(ownerId)] then
		return false, "Already"
	end
	if likerTown.LikesGiven >= WorldLayout.LIKES_PER_DAY then
		return false, "Limit"
	end
	return true, nil
end

-- Enregistre un "j'aime" (après CanLike) ; renvoie true si le propriétaire
-- reçoit encore sa récompense aujourd'hui
function WorldLayout.ApplyLike(likerTown: TownData, ownerTown: TownData, ownerId: number): boolean
	likerTown.Liked[tostring(ownerId)] = true
	likerTown.LikesGiven += 1
	ownerTown.Likes += 1
	if ownerTown.LikedRewards < WorldLayout.LIKED_REWARDS_PER_DAY then
		ownerTown.LikedRewards += 1
		return true
	end
	return false
end

-- Récompense (Dopamine) = secondes de production, jamais négative / infinie
function WorldLayout.RewardAmount(perSecond: any, seconds: number): number
	local rate = finite(perSecond, 0)
	if rate <= 0 then
		return 0
	end
	return math.min(rate * seconds, 1e300)
end

-- Point (repère local de la maison) dans la maison ? (marge en studs, < 0 = plus strict)
function WorldLayout.InsideHouse(size: SizeDef?, x: number, y: number, d: number, margin: number?): boolean
	local dims = WorldLayout.Dims(size)
	local m = margin or 0
	return x >= dims.Left - m and x <= dims.Left + dims.Width + m and d >= -m and d <= dims.Depth + m
		and y >= -2 and y <= dims.Height + WorldLayout.ROOF_H
end

-- Pièce (emplacement) qui contient un point local, sinon nil (cage / dehors)
function WorldLayout.SlotAt(size: SizeDef?, x: number, y: number, d: number): number?
	local dims = WorldLayout.Dims(size)
	if d < 0 or d > dims.Depth then
		return nil
	end
	local floor = math.floor((y - WorldLayout.PLINTH - WorldLayout.SLAB + 0.5) / WorldLayout.STORY) + 1
	if floor < 1 or floor > dims.Floors then
		return nil
	end
	-- (v9.4) la cage peut être à droite ou au milieu : WorldLayout.ColumnAt
	local column = WorldLayout.ColumnAt(size, x)
	if not column then
		return nil
	end
	return (floor - 1) * dims.Columns + column
end

return WorldLayout
]]></string>
        </Properties>
      </Item>
    </Item>

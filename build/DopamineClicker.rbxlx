<roblox version="4">
  <Item class="ReplicatedStorage" referent="0">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="1">
      <Properties>
        <string name="Name">Client</string>
      </Properties>
      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">ClientState</string>
          <string name="Source"><![CDATA[--[[
	ClientState (ModuleScript)
	Emplacement : ReplicatedStorage > Client > ClientState

	Mémorise le dernier état envoyé par le serveur et prévient l'interface
	(signaux). Gère aussi la "prédiction" des clics : on affiche le gain
	tout de suite, sans attendre le serveur, pour une sensation instantanée.
	Le serveur reste l'autorité : dès que sa réponse arrive, l'affichage se
	recale sur la vraie valeur.

	Garde aussi en mémoire : les "Features" débloquées, la bourse, les
	trajectoires des logos DVD, le mode sombre (néon / thème sombre), et
	relaie les événements "Spawn" et "Notify" aux modules qui les écoutent.

	v3 : Game Passes possédés (Data.Passes), boost temporaire (Data.Boost,
	compte à rebours prédit localement), VIP, signal "Loaded" (premier état).
	v4 : classement en deux parties (ClientState.Leaderboard = top mondial,
	ClientState.ServerLeaderboard = joueurs du serveur en direct), son de
	clic choisi (Data.Settings.ClickSound), Dopamine hors-ligne (Data.Offline).
	Classement complet : ClientState.RebirthLeaderboard = top mondial des
	renaissances (payload.GlobalRebirths). Les anciens formats restent acceptés.
	Le mode sombre est la combinaison (OU) de plusieurs "sources" : le thème
	équipé (SetDarkMode), les stimuli comme le mode néon (SetDarkSource).
	v5 : source "User" = réglage ⚙️ "Mode sombre" (Data.Settings.DarkMode),
	appliqué tout de suite (SetUserDarkMode) ; langue : Data.Settings.Language
	("Auto" | "en" | "fr") -> ClientState.ResolveLanguage().
	v8 (performances) : le serveur n'envoie l'état COMPLET (StateUpdate ->
	ClientState.Changed) que lorsqu'un changement "structurel" a lieu (achat,
	quête terminée, réglage...) ou toutes les ~10 s ; entre deux, de petits
	"StateTick" { Dopamine, ClickSeq, TotalClicks?, QuestProgress?, Chests? }
	mettent à jour ClientState.Data sur place et déclenchent :
	  - ClientState.DopamineChanged (dopamine confirmée) : ticks ET états complets ;
	  - ClientState.TickReceived (tick) : chaque petit tick (quêtes, coffre...).
	Changed ne se déclenche donc plus 5 fois par seconde : les affichages qui
	dépendent de la Dopamine (prix abordables) écoutent aussi DopamineChanged.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Net = require(ReplicatedStorage.Shared.Net)
local Signal = require(ReplicatedStorage.Shared.Signal)
local Locale = require(ReplicatedStorage.Shared.Locale)

local ClientState = {}

ClientState.Data = nil :: any -- dernier état serveur (nil tant que pas chargé)
ClientState.Changed = Signal.new() -- (data)
ClientState.Rush = { Active = false, EndsAt = 0, Name = "", Multiplier = 1 }
ClientState.RushChanged = Signal.new() -- (rush)
ClientState.Leaderboard = {} -- top mondial : { { Rank, UserId, Name, Value } }
ClientState.LeaderboardChanged = Signal.new() -- (topMondial, classementServeur, topRenaissances)
-- Ajout v4 : classement du serveur en direct { { UserId, Name, Dopamine, Lifetime, Rebirths } } (trié)
ClientState.ServerLeaderboard = {}
-- Top mondial des renaissances : { { Rank, UserId, Name, Value (renaissances), Dopamine? } }
ClientState.RebirthLeaderboard = {}

-- Ajouts v2
ClientState.FeaturesChanged = Signal.new() -- (features) : l'ensemble des Features a changé
ClientState.SpawnReceived = Signal.new() -- (info) : chaque événement "Spawn"
ClientState.DVDSetup = { Logos = {} }
ClientState.DVDSetupChanged = Signal.new() -- (setup)
ClientState.DarkMode = false
ClientState.DarkModeChanged = Signal.new() -- (enabled)
ClientState.NotifyReceived = Signal.new() -- (payload) : chaque "Notify" (après le traitement intégré)
ClientState.DarkSourcesChanged = Signal.new() -- () : une source du mode sombre a changé

-- Ajouts v3
ClientState.Loaded = Signal.new() -- () : premier état reçu (écran de chargement)
ClientState.IsLoaded = false

-- Ajouts v8 (petits ticks entre deux états complets)
ClientState.DopamineChanged = Signal.new() -- (dopamine confirmée : état serveur + clics prédits)
ClientState.TickReceived = Signal.new() -- (tick) : chaque StateTick, après mise à jour de Data
ClientState.Clicked = Signal.new() -- (gain prédit) : chaque clic accepté sur le gros bouton (v9 : visuels des améliorations de clic)

-- Prédiction des clics
local clickSeq = 0
local pending = {} -- { { Seq = number, Amount = number } }
local lastUpdateClock = os.clock()
local displayDopamine = 0

-- Combo local (même formule que le serveur, juste pour l'affichage)
local comboMeter = 0
local lastComboClick = 0
local lastLocalClick = 0

-- Features connues (pour détecter les changements)
local knownFeatures: { [string]: boolean }? = nil

-- Traitement "intégré" des Notify (branché par ClientMain)
local notifyHandler: ((payload: any) -> ())? = nil

-- Sources du mode sombre ([nom] = true) : le mode est actif si l'une l'est
local darkSources: { [string]: boolean } = {}

-- Boost temporaire : fin prévue (horloge locale os.clock)
local boostMultiplier = 1
local boostEndsClock = 0

-- Mode sombre du joueur changé localement : on ignore la valeur du serveur
-- quelques secondes (le temps qu'il enregistre le nouveau réglage)
local userDarkLocalUntil = 0
local applyUserDark: (data: any) -> () = function() end

local function sameSet(a: { [string]: boolean }, b: { [string]: boolean }): boolean
	for key, value in pairs(a) do
		if value and not b[key] then
			return false
		end
	end
	for key, value in pairs(b) do
		if value and not a[key] then
			return false
		end
	end
	return true
end

local function onState(data)
	if type(data) ~= "table" then
		return
	end
	-- Valeurs par défaut (au cas où le serveur n'envoie pas encore un champ)
	data.Features = data.Features or {}
	data.Upgrades = data.Upgrades or {}
	data.Settings = data.Settings or { Sound = true, Music = true, Effects = true }
	if type(data.Settings.ClickSound) ~= "string" then
		data.Settings.ClickSound = "Default"
	end
	data.Stats = data.Stats or {}
	data.Achievements = data.Achievements or {}
	data.Quests = data.Quests or {}
	data.ClickSeq = data.ClickSeq or 0
	data.Passes = data.Passes or {}
	data.Themes = data.Themes or { Owned = { Classic = true }, Equipped = "Classic" }
	data.Themes.Owned = data.Themes.Owned or { Classic = true }
	data.Boost = data.Boost or { Multiplier = 1, Remaining = 0 }

	ClientState.Data = data
	applyUserDark(data)
	lastUpdateClock = os.clock()
	-- Boost : on mémorise sa fin pour un compte à rebours fluide entre deux états
	local boost = data.Boost
	local remaining = tonumber(boost.Remaining) or 0
	boostMultiplier = tonumber(boost.Multiplier) or 1
	if boostMultiplier > 1 and remaining > 0 then
		local newEnd = os.clock() + remaining
		-- Petit filtre : on ignore les écarts < 1 s (arrondi du serveur)
		if math.abs(newEnd - boostEndsClock) > 1 then
			boostEndsClock = newEnd
		end
	else
		boostEndsClock = 0
	end
	-- On oublie les prédictions que le serveur a déjà traitées
	while pending[1] and pending[1].Seq <= data.ClickSeq do
		table.remove(pending, 1)
	end
	if not data.ComboEnabled then
		comboMeter = 0
	end

	local features = data.Features
	local changed = knownFeatures == nil or not sameSet(knownFeatures :: { [string]: boolean }, features)
	knownFeatures = table.clone(features)

	ClientState.Changed:Fire(data)
	if changed then
		ClientState.FeaturesChanged:Fire(features)
	end
	ClientState.DopamineChanged:Fire(ClientState.GetConfirmedDopamine())
	if not ClientState.IsLoaded then
		ClientState.IsLoaded = true
		ClientState.Loaded:Fire()
	end
end

-- Petit tick (StateTick) : valeurs fréquentes mises à jour SUR PLACE dans
-- ClientState.Data (même table : les modules qui la lisent voient la
-- nouvelle valeur), sans déclencher Changed.
local function onTick(tick)
	local data = ClientState.Data
	if type(tick) ~= "table" or type(data) ~= "table" then
		return -- avant le premier état complet : ignoré (il contient tout)
	end
	local dopamine = tonumber(tick.Dopamine)
	if dopamine and dopamine == dopamine then
		data.Dopamine = dopamine
	end
	local seq = tonumber(tick.ClickSeq)
	if seq then
		data.ClickSeq = seq
		while pending[1] and pending[1].Seq <= seq do
			table.remove(pending, 1)
		end
	end
	local clicks = tonumber(tick.TotalClicks)
	if clicks and type(data.Stats) == "table" then
		data.Stats.TotalClicks = clicks
	end
	if type(tick.QuestProgress) == "table" and type(data.Quests) == "table" then
		for index, progress in ipairs(tick.QuestProgress) do
			local quest = data.Quests[index]
			if type(quest) == "table" and type(progress) == "number" then
				quest.Progress = progress
			end
		end
	end
	local chests = tick.Chests
	if type(chests) == "table" then
		if type(data.Chests) ~= "table" then
			data.Chests = {}
		end
		data.Chests.Stored = tonumber(chests.Stored) or data.Chests.Stored
		data.Chests.Progress = tonumber(chests.Progress) or data.Chests.Progress
	end
	lastUpdateClock = os.clock()
	ClientState.DopamineChanged:Fire(ClientState.GetConfirmedDopamine())
	ClientState.TickReceived:Fire(tick)
end

function ClientState.Init()
	Net.Event("StateUpdate").OnClientEvent:Connect(onState)
	Net.Event("StateTick").OnClientEvent:Connect(onTick)

	Net.Event("EventUpdate").OnClientEvent:Connect(function(rush)
		ClientState.Rush = rush
		ClientState.RushChanged:Fire(rush)
	end)

	Net.Event("LeaderboardUpdate").OnClientEvent:Connect(function(payload)
		if type(payload) ~= "table" then
			return
		end
		if payload.Global ~= nil or payload.Server ~= nil or payload.GlobalRebirths ~= nil then
			-- Format v4 : { Global = {...}, GlobalRebirths = {...}, Server = {...} }
			-- (une partie absente = inchangée)
			if type(payload.Global) == "table" then
				ClientState.Leaderboard = payload.Global
			end
			if type(payload.GlobalRebirths) == "table" then
				ClientState.RebirthLeaderboard = payload.GlobalRebirths
			end
			if type(payload.Server) == "table" then
				ClientState.ServerLeaderboard = payload.Server
			end
		else
			-- Ancien format : un simple tableau (top mondial)
			ClientState.Leaderboard = payload
		end
		ClientState.LeaderboardChanged:Fire(
			ClientState.Leaderboard,
			ClientState.ServerLeaderboard,
			ClientState.RebirthLeaderboard
		)
	end)

	Net.Event("DVDSetup").OnClientEvent:Connect(function(setup)
		if type(setup) ~= "table" then
			return
		end
		setup.Logos = setup.Logos or {}
		ClientState.DVDSetup = setup
		ClientState.DVDSetupChanged:Fire(setup)
	end)

	Net.Event("Spawn").OnClientEvent:Connect(function(info)
		if type(info) == "table" then
			ClientState.SpawnReceived:Fire(info)
		end
	end)

	Net.Event("Notify").OnClientEvent:Connect(function(payload)
		if type(payload) ~= "table" then
			return
		end
		local handler = notifyHandler
		if handler then
			local ok, err = pcall(handler, payload)
			if not ok then
				warn("[ClientState] Erreur dans le traitement d'une notification :", err)
			end
		end
		ClientState.NotifyReceived:Fire(payload)
	end)
end

-- Branche le traitement "intégré" des notifications (toasts, stimuli...)
function ClientState.SetNotifyHandler(handler: (payload: any) -> ())
	notifyHandler = handler
end

-- Vrai si la Feature est débloquée (faux avant le premier état)
function ClientState.HasFeature(name: string): boolean
	local data = ClientState.Data
	return data ~= nil and data.Features ~= nil and data.Features[name] == true
end

-- Niveau d'une amélioration (0 avant le premier état)
function ClientState.GetLevel(upgradeId: string): number
	local data = ClientState.Data
	if not data or not data.Upgrades then
		return 0
	end
	return data.Upgrades[upgradeId] or 0
end

-- Recalcule le mode sombre effectif (OU de toutes les sources)
local function applyDarkSources()
	local enabled = false
	for _, value in pairs(darkSources) do
		if value then
			enabled = true
			break
		end
	end
	if ClientState.DarkMode == enabled then
		return
	end
	ClientState.DarkMode = enabled
	ClientState.DarkModeChanged:Fire(enabled)
end

-- Active / coupe une source du mode sombre (ex. "Stimuli" pour le mode néon)
function ClientState.SetDarkSource(source: string, enabled: boolean)
	local before = darkSources[source] == true
	if enabled == true then
		darkSources[source] = true
	else
		darkSources[source] = nil
	end
	applyDarkSources()
	if before ~= (enabled == true) then
		ClientState.DarkSourcesChanged:Fire()
	end
end

-- Vrai si la source du mode sombre `source` est active ("Main", "Stimuli", "User")
function ClientState.HasDarkSource(source: string): boolean
	return darkSources[source] == true
end

-- Réglage ⚙️ "Mode sombre" : appliqué tout de suite (la sauvegarde est
-- demandée au serveur par le panneau Paramètres)
function ClientState.SetUserDarkMode(enabled: boolean)
	userDarkLocalUntil = os.clock() + 4
	local data = ClientState.Data
	if data and type(data.Settings) == "table" then
		data.Settings.DarkMode = enabled == true
	end
	ClientState.SetDarkSource("User", enabled == true)
end

-- Vrai si le joueur a choisi le mode sombre
function ClientState.IsUserDarkMode(): boolean
	return darkSources.User == true
end

applyUserDark = function(data)
	if os.clock() < userDarkLocalUntil then
		-- Changement local récent : on garde notre valeur dans l'état reçu
		if type(data.Settings) == "table" then
			data.Settings.DarkMode = darkSources.User == true
		end
		return
	end
	local settings = data.Settings
	ClientState.SetDarkSource("User", type(settings) == "table" and settings.DarkMode == true)
end

----------------------------------------------------------------------
-- Langue
----------------------------------------------------------------------

-- Réglage de langue sauvegardé : "Auto" | "en" | "fr" ("Auto" avant le premier état)
function ClientState.GetLanguageSetting(): string
	local data = ClientState.Data
	local settings = data and data.Settings
	local value = type(settings) == "table" and settings.Language or nil
	if value == "en" or value == "fr" then
		return value
	end
	return "Auto"
end

-- Langue finale ("en" | "fr") : réglage sauvegardé, sinon langue Roblox du joueur
function ClientState.ResolveLanguage(): string
	local player = Players.LocalPlayer
	return Locale.Resolve(ClientState.GetLanguageSetting(), player and player.LocaleId or nil)
end

-- Mode sombre "principal" (thème équipé, fond...). Les stimuli (mode néon)
-- passent par une autre source : un thème sombre reste sombre même quand le
-- mode néon s'arrête, et inversement.
function ClientState.SetDarkMode(enabled: boolean)
	ClientState.SetDarkSource("Main", enabled)
end

----------------------------------------------------------------------
-- Robux : passes, boost, VIP
----------------------------------------------------------------------

-- Vrai si le joueur possède le Game Pass `passId` (Id de Config.Monetization.GamePasses)
function ClientState.HasPass(passId: string): boolean
	local data = ClientState.Data
	return data ~= nil and type(data.Passes) == "table" and data.Passes[passId] == true
end

-- Vrai si le joueur est VIP
function ClientState.IsVIP(): boolean
	local data = ClientState.Data
	return data ~= nil and (data.IsVIP == true or ClientState.HasPass("VIP"))
end

-- Multiplicateur permanent des Game Passes possédés (x10, x2, VIP...)
function ClientState.GetPassMultiplier(): number
	local multiplier = 1
	for _, pass in ipairs(Config.Monetization.GamePasses) do
		if pass.Multiplier and ClientState.HasPass(pass.Id) then
			multiplier *= pass.Multiplier
		end
	end
	return multiplier
end

-- Boost temporaire actif : (multiplicateur, secondes restantes) ; (1, 0) sinon
function ClientState.GetBoost(): (number, number)
	if boostMultiplier <= 1 or boostEndsClock <= 0 then
		return 1, 0
	end
	local remaining = boostEndsClock - os.clock()
	if remaining <= 0 then
		return 1, 0
	end
	return boostMultiplier, remaining
end

----------------------------------------------------------------------
-- Classement du serveur (v4)
----------------------------------------------------------------------

-- Place du joueur local dans le classement du serveur : (rang ou nil, nombre de joueurs)
function ClientState.GetServerRank(): (number?, number)
	local list = ClientState.ServerLeaderboard
	if type(list) ~= "table" then
		return nil, 0
	end
	local localId = Players.LocalPlayer and Players.LocalPlayer.UserId
	for index, entry in ipairs(list) do
		if type(entry) == "table" and entry.UserId == localId then
			return index, #list
		end
	end
	return nil, #list
end

-- Jauge de combo actuelle (avec la perte depuis le dernier clic)
function ClientState.GetComboMeter(): number
	local data = ClientState.Data
	if not data or not data.ComboEnabled then
		return 0
	end
	local elapsed = os.clock() - lastComboClick
	return math.max(0, comboMeter - Config.Combo.DecayPerSecond * elapsed)
end

function ClientState.GetComboMultiplier(): number
	return Formulas.GetComboMultiplier(ClientState.GetComboMeter())
end

-- Appelé à chaque clic sur le gros bouton. Renvoie le gain prédit (ou nil si
-- le clic est trop rapide, comme le serveur le refuserait).
function ClientState.Click(): number?
	local data = ClientState.Data
	if not data then
		return nil
	end
	local now = os.clock()
	-- Même limite que le serveur : inutile d'envoyer des clics qui seront refusés
	if now - lastLocalClick < 1 / Config.Game.MaxClicksPerSecond then
		return nil
	end
	lastLocalClick = now

	local gain = data.ClickValue or 0
	if data.ComboEnabled then
		comboMeter = Formulas.StepCombo(comboMeter, now - lastComboClick)
		lastComboClick = now
		gain *= Formulas.GetComboMultiplier(comboMeter)
	else
		comboMeter = 0
	end

	clickSeq += 1
	table.insert(pending, { Seq = clickSeq, Amount = gain })
	Net.Event("Click"):FireServer()
	ClientState.Clicked:Fire(gain)
	return gain
end

-- Valeur "cible" : état serveur + clics prédits + gains passifs depuis la dernière mise à jour
function ClientState.GetTargetDopamine(): number
	local data = ClientState.Data
	if not data then
		return 0
	end
	local total = data.Dopamine or 0
	for _, prediction in ipairs(pending) do
		total += prediction.Amount
	end
	local elapsed = math.min(os.clock() - lastUpdateClock, 0.5)
	return total + (data.PerSecond or 0) * elapsed
end

-- Valeur "confirmée" : état serveur + clics prédits, SANS l'extrapolation des
-- gains passifs (pour savoir si un achat sera accepté par le serveur)
function ClientState.GetConfirmedDopamine(): number
	local data = ClientState.Data
	if not data then
		return 0
	end
	local total = data.Dopamine or 0
	for _, prediction in ipairs(pending) do
		total += prediction.Amount
	end
	return total
end

-- Valeur affichée, lissée à chaque image (appelé UNE fois par image par la colonne centrale)
function ClientState.UpdateDisplay(dt: number): number
	local target = ClientState.GetTargetDopamine()
	local perSecond = (ClientState.Data and ClientState.Data.PerSecond) or 0
	if target < displayDopamine - perSecond * 0.6 - 1e-6 then
		displayDopamine = target -- vraie baisse (achat, détox) : on descend immédiatement
	elseif target <= displayDopamine then
		-- Petite baisse due au décalage entre ticks passifs et envois d'état :
		-- on garde la valeur affichée jusqu'à ce que la cible la rattrape
	else
		displayDopamine += (target - displayDopamine) * (1 - math.exp(-14 * dt))
		if target - displayDopamine < 0.01 then
			displayDopamine = target
		end
	end
	return displayDopamine
end

function ClientState.GetDisplayDopamine(): number
	return displayDopamine
end

return ClientState
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="3">
        <Properties>
          <string name="Name">Components</string>
        </Properties>
        <Item class="ModuleScript" referent="4">
          <Properties>
            <string name="Name">AchievementPopup</string>
            <string name="Source"><![CDATA[--[[
	AchievementPopup (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > AchievementPopup

	1) Médaillons de succès (utilisés aussi par le panneau des succès) :
	   AchievementPopup.Tier(succès)         -> palier { Name, Top, Bottom, Ring }
	   AchievementPopup.Medallion(parent, taille, succès) -> { Frame, Set(débloqué) }
	   Palier selon la taille de l'objectif : parmi les succès d'une même
	   statistique, le plus petit objectif est en bronze, puis argent, or,
	   diamant (un succès seul dans sa statistique : palier selon sa récompense).
	   Verrouillé : médaillon gris, icône fantôme et petit cadenas.
	   (Name du palier en anglais : afficher avec Locale.T(tier.Name).)

	2) Grande fenêtre de fête quand un succès est débloqué
	   (Notify { Type = "Achievement", Id, Name, Icon, Reward, BadgeAwarded }) :
	   médaillon qui tourne devant des rayons, titre, nom, récompense, et
	   "🏅 Badge Roblox obtenu !" si le serveur a donné un vrai badge.
	   Non bloquante (les clics passent au travers : on peut continuer à
	   cliquer le gros bouton), en haut de l'écran, avec une file d'attente
	   (les suivants s'enchaînent, au-delà de 3 : résumé). v9 : petit ✕ dans
	   le coin (hors du gros bouton) pour la fermer tout de suite.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Client = script.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local Effects = require(Client.Effects)
local SoundManager = require(Client.SoundManager)
local Config = require(ReplicatedStorage.Shared.Config)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Locale = require(ReplicatedStorage.Shared.Locale)

local AchievementPopup = {}

export type Tier = { Name: string, Top: Color3, Bottom: Color3, Ring: Color3 }
export type Medallion = { Frame: Frame, Set: (unlocked: boolean) -> () }

local TIERS: { Tier } = {
	{ Name = "Bronze", Top = Color3.fromRGB(245, 190, 130), Bottom = Color3.fromRGB(176, 106, 52), Ring = Color3.fromRGB(125, 68, 28) },
	{ Name = "Silver", Top = Color3.fromRGB(250, 252, 255), Bottom = Color3.fromRGB(160, 170, 188), Ring = Color3.fromRGB(105, 115, 132) },
	{ Name = "Gold", Top = Color3.fromRGB(255, 240, 150), Bottom = Color3.fromRGB(232, 162, 20), Ring = Color3.fromRGB(165, 105, 0) },
	{ Name = "Diamond", Top = Color3.fromRGB(210, 248, 255), Bottom = Color3.fromRGB(90, 165, 255), Ring = Color3.fromRGB(40, 105, 200) },
}
local LOCKED = { Top = Color3.fromRGB(236, 236, 240), Bottom = Color3.fromRGB(185, 185, 192), Ring = Color3.fromRGB(150, 150, 158) }

local SHOW_TIME = 3.6 -- secondes d'affichage d'un succès
local MAX_QUEUE = 3 -- au-delà : un seul bandeau résumé

local tierCache: { [string]: Tier } = {}
local layer: Frame? = nil
local queue: { any } = {}
local skipped = 0
local showing = false

----------------------------------------------------------------------
-- Paliers
----------------------------------------------------------------------

local function computeTiers()
	local groups: { [string]: { any } } = {}
	for _, achievement in ipairs(Config.Achievements) do
		local stat = tostring(achievement.Stat)
		groups[stat] = groups[stat] or {}
		table.insert(groups[stat], achievement)
	end
	for _, list in pairs(groups) do
		table.sort(list, function(a, b)
			return (tonumber(a.Goal) or 0) < (tonumber(b.Goal) or 0)
		end)
		for rank, achievement in ipairs(list) do
			local index: number
			if #list == 1 then
				-- Seul dans sa statistique : selon la récompense
				local reward = tonumber(achievement.Reward) or 0
				index = reward < 1e5 and 1 or (reward < 1e6 and 2 or (reward < 1e8 and 3 or 4))
			else
				index = math.min(rank, #TIERS)
			end
			tierCache[achievement.Id] = TIERS[index]
		end
	end
end

function AchievementPopup.Tier(achievement): Tier
	if next(tierCache) == nil then
		computeTiers()
	end
	return tierCache[achievement and achievement.Id or ""] or TIERS[1]
end

----------------------------------------------------------------------
-- Médaillon
----------------------------------------------------------------------

-- `tierOverride` (optionnel) : impose un palier (ex. résumé de plusieurs succès)
function AchievementPopup.Medallion(parent: Instance, size: number, achievement, tierOverride: Tier?): Medallion
	local tier = tierOverride or AchievementPopup.Tier(achievement)
	local holder = UIUtil.Create("Frame", {
		Name = "Medallion",
		Size = UDim2.fromOffset(size, math.floor(size * 1.2)),
		BackgroundTransparency = 1,
		Parent = parent,
	})

	-- Rubans sous le médaillon
	local ribbons = {}
	for side = -1, 1, 2 do
		local ribbon = UIUtil.Create("Frame", {
			Name = "Ribbon",
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, side * size * 0.16, 0, size * 0.62),
			Size = UDim2.fromOffset(math.floor(size * 0.24), math.floor(size * 0.52)),
			Rotation = side * 18,
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			ZIndex = 1,
			Parent = holder,
		})
		UIUtil.Corner(ribbon, 3)
		local gradient = UIUtil.Gradient(ribbon, ColorSequence.new(tier.Bottom, tier.Ring), 90)
		table.insert(ribbons, gradient)
	end

	local outer = UIUtil.Create("Frame", {
		Name = "Outer",
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 2,
		Parent = holder,
	})
	UIUtil.Corner(outer, UDim.new(1, 0))
	local outerStroke = UIUtil.Stroke(outer, tier.Ring, math.max(1.5, size / 40), 0)
	local outerGradient = UIUtil.Gradient(outer, ColorSequence.new(tier.Top, tier.Bottom), 45)

	local inner = UIUtil.Create("Frame", {
		Name = "Inner",
		Size = UDim2.fromScale(0.74, 0.74),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 3,
		Parent = outer,
	})
	UIUtil.Corner(inner, UDim.new(1, 0))
	UIUtil.Stroke(inner, Color3.new(1, 1, 1), math.max(1, size / 60), 0.4)
	local innerGradient = UIUtil.Gradient(inner, ColorSequence.new(tier.Bottom, tier.Top), 45)

	-- Reflet
	local shine = UIUtil.Create("Frame", {
		Name = "Shine",
		Size = UDim2.fromScale(0.34, 0.2),
		Position = UDim2.fromScale(0.14, 0.12),
		Rotation = -35,
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.45,
		ZIndex = 5,
		Parent = outer,
	})
	UIUtil.Corner(shine, UDim.new(1, 0))

	local icon = UIUtil.Label({
		Name = "Icon",
		Text = tostring(achievement and achievement.Icon or "🏆"),
		Size = UDim2.fromScale(0.6, 0.6),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		MaxTextSize = math.floor(size * 0.42),
		ZIndex = 4,
		Parent = outer,
	})

	local lock = UIUtil.Create("Frame", {
		Name = "Lock",
		Size = UDim2.fromOffset(math.floor(size * 0.34), math.floor(size * 0.34)),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.84, 0.84),
		BackgroundColor3 = Theme.Colors.Dark,
		ZIndex = 6,
		Visible = false,
		Parent = outer,
	})
	UIUtil.Corner(lock, UDim.new(1, 0))
	UIUtil.Stroke(lock, Color3.new(1, 1, 1), 1.5, 0)
	UIUtil.Label({
		Text = "🔒",
		Size = UDim2.fromScale(0.7, 0.7),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		MaxTextSize = math.floor(size * 0.2),
		ZIndex = 7,
		Parent = lock,
	})

	local medallion: Medallion = {
		Frame = holder,
		Set = function(unlocked: boolean)
			local colors = unlocked and tier or LOCKED
			outerGradient.Color = ColorSequence.new(colors.Top, colors.Bottom)
			innerGradient.Color = ColorSequence.new(colors.Bottom, colors.Top)
			outerStroke.Color = colors.Ring
			for _, gradient in ipairs(ribbons) do
				gradient.Color = ColorSequence.new(colors.Bottom, colors.Ring)
			end
			icon.TextTransparency = unlocked and 0 or 0.78
			shine.BackgroundTransparency = unlocked and 0.45 or 0.7
			lock.Visible = not unlocked
		end,
	}
	medallion.Set(true)
	return medallion
end

----------------------------------------------------------------------
-- Fenêtre de fête
----------------------------------------------------------------------

function AchievementPopup.Build(parent: Frame)
	layer = parent
end

local showNext: () -> ()

-- Affiche une carte ; `summary` = texte de résumé (plusieurs succès)
local function present(payload, summary: string?)
	local target = layer
	if not target then
		showing = false
		return
	end
	local achievement = payload.Id and Config.AchievementsById[payload.Id] or nil
	local fallback = {
		Id = tostring(payload.Id or ""),
		Icon = payload.Icon or "🏆",
		Stat = "",
		Goal = 1,
		Reward = tonumber(payload.Reward) or 0,
	}
	local info = achievement or fallback
	local tier = summary and TIERS[3] or AchievementPopup.Tier(info)
	local badge = payload.BadgeAwarded == true

	-- Support (non bloquant : les clics passent au travers)
	local holder = UIUtil.Create("Frame", {
		Name = "AchievementPopup",
		Size = UDim2.fromOffset(440, 136),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, -170),
		BackgroundTransparency = 1,
		ZIndex = 30,
		Parent = target,
	})
	local group = UIUtil.Create("CanvasGroup", {
		Name = "Fade",
		Size = UDim2.new(1, 24, 1, 24),
		Position = UDim2.fromOffset(-12, -12),
		BackgroundTransparency = 1,
		GroupTransparency = 0,
		ZIndex = 30,
		Parent = holder,
	})
	local card = UIUtil.Create("Frame", {
		Name = "Card",
		Size = UDim2.new(1, -24, 1, -24),
		Position = UDim2.fromOffset(12, 10),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 2,
		Parent = group,
	})
	UIUtil.Corner(card, 24)
	UIUtil.Stroke(card, tier.Ring, 2, 0.1)
	UIUtil.Shadow(card, 5, 0.8, 3)
	UIUtil.Gradient(card, ColorSequence.new(Color3.new(1, 1, 1), tier.Top:Lerp(Color3.new(1, 1, 1), 0.55)), 90)

	-- Zone du médaillon (rayons qui tournent + médaillon qui "pop")
	local stage = UIUtil.Create("Frame", {
		Name = "Stage",
		Size = UDim2.fromOffset(120, 120),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 6, 0.5, 0),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		ZIndex = 3,
		Parent = card,
	})
	local rays = UIUtil.Rays(stage, tier.Bottom, 8, 150, UDim2.fromScale(0.5, 0.5), 3)
	local medallion = AchievementPopup.Medallion(stage, 76, info, tier)
	medallion.Frame.AnchorPoint = Vector2.new(0.5, 0.5)
	medallion.Frame.Position = UDim2.fromScale(0.5, 0.56)
	medallion.Frame.ZIndex = 4 -- devant les rayons
	local medalScale = UIUtil.Create("UIScale", { Scale = 0.2, Parent = medallion.Frame })

	-- Textes
	UIUtil.Label({
		Name = "Title",
		Text = summary and Locale.T("ACHIEVEMENT SPREE!") or Locale.T("ACHIEVEMENT UNLOCKED!"),
		Font = Theme.Fonts.Title,
		TextColor3 = tier.Ring,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -180, 0, 20), -- (place pour le ✕)
		Position = UDim2.fromOffset(134, 14),
		MaxTextSize = 16,
		ZIndex = 4,
		Parent = card,
	})
	UIUtil.Label({
		Name = "AchievementName",
		-- Nom rendu depuis Config (traduit) ; sinon le texte envoyé par le serveur
		Text = summary
			or (achievement and Locale.T(achievement.Name))
			or tostring(payload.Name or payload.Text or ""),
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -150, 0, 30),
		Position = UDim2.fromOffset(134, 34),
		MaxTextSize = 26,
		ZIndex = 4,
		Parent = card,
	})
	local reward = summary and 0 or (tonumber(payload.Reward) or (achievement and tonumber(achievement.Reward)) or 0)
	UIUtil.Label({
		Name = "Reward",
		Text = (summary and Locale.T("Each achievement: ") or "")
			.. (reward > 0 and ("🎁 +" .. NumberFormatter.Format(reward) .. " Dopamine  •  ") or "")
			.. Locale.T("+%s%% forever", tostring(math.floor(Config.AchievementBonus * 100 + 0.5))),
		TextColor3 = Theme.Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -150, 0, 18),
		Position = UDim2.fromOffset(134, 66),
		MaxTextSize = 14,
		ZIndex = 4,
		Parent = card,
	})
	local chips = UIUtil.Create("Frame", {
		Name = "Chips",
		Size = UDim2.new(1, -150, 0, 22),
		Position = UDim2.fromOffset(134, 88),
		BackgroundTransparency = 1,
		ZIndex = 4,
		Parent = card,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = chips,
	})
	UIUtil.Chip({
		Text = Locale.T("%s tier", Locale.T(tier.Name)),
		Color = tier.Bottom,
		TextColor3 = Theme.ContrastText(tier.Bottom),
		Height = 22,
		TextSize = 12,
		LayoutOrder = 1,
		ZIndex = 5,
		Parent = chips,
	})
	if badge then
		UIUtil.Chip({
			Text = Locale.T("🏅 Roblox badge earned!"),
			Color = Theme.Colors.Robux,
			TextColor3 = Theme.Colors.TextLight,
			Height = 22,
			TextSize = 12,
			LayoutOrder = 2,
			ZIndex = 5,
			Parent = chips,
		})
	end

	-- Fête
	SoundManager.Play("Achievement", 1.1)
	task.delay(0.15, SoundManager.Play, "Bonus", 1.5)
	Effects.Confetti(badge and 70 or 45)

	-- Entrée : descend en rebondissant, le médaillon grossit
	UIUtil.Tween(holder, 0.55, { Position = UDim2.new(0.5, 0, 0, 36) }, Enum.EasingStyle.Back)
	task.delay(0.2, function()
		UIUtil.Tween(medalScale, 0.6, { Scale = 1 }, Enum.EasingStyle.Elastic)
	end)

	local started = os.clock()
	local connection = RunService.RenderStepped:Connect(function(dt: number)
		rays.Rotation = (rays.Rotation + dt * 40) % 360
		local t = os.clock() - started
		medallion.Frame.Rotation = math.sin(t * 3) * 6
	end)

	-- Sortie (fin du minuteur ou ✕) : une seule fois
	local leaving = false
	local function dismiss()
		if leaving then
			return
		end
		leaving = true
		UIUtil.Tween(holder, 0.35, { Position = UDim2.new(0.5, 0, 0, -170) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		UIUtil.Tween(group, 0.35, { GroupTransparency = 1 })
		task.delay(0.38, function()
			connection:Disconnect()
			holder:Destroy()
			showNext()
		end)
	end
	UIUtil.CloseButton({
		Name = "Close",
		Size = 26,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 8),
		ZIndex = 6,
		Shadow = false,
		Parent = card,
		OnClose = function()
			SoundManager.Play("Click", 1.1)
			dismiss()
		end,
	})
	task.delay(SHOW_TIME, dismiss)
end

showNext = function()
	local nextPayload = table.remove(queue, 1)
	if nextPayload then
		present(nextPayload)
		return
	end
	if skipped > 0 then
		local count = skipped
		skipped = 0
		present({ Icon = "🏆" }, Locale.T("+%d more achievements!", count))
		return
	end
	showing = false
end

-- Vrai pendant qu'une fenêtre de succès est à l'écran (OfferPopup attend)
function AchievementPopup.IsShowing(): boolean
	return showing
end

-- Nouveau succès débloqué (payload de Notify "Achievement")
function AchievementPopup.Show(payload)
	if type(payload) ~= "table" then
		return
	end
	if #queue >= MAX_QUEUE then
		skipped += 1
		return
	end
	table.insert(queue, payload)
	if not showing then
		showing = true
		showNext()
	end
end

return AchievementPopup
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">Background</string>
            <string name="Source"><![CDATA[--[[
	Background (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > Background

	Fond d'écran du jeu, piloté par le thème équipé (Config.Themes, état
	ClientState.Data.Themes.Equipped, "Classic" par défaut) :
	  - un dégradé vertical (Top -> Bottom du thème) ;
	  - une illustration animée en plusieurs PLANS (parallaxe : les plans
	    lointains bougent moins que les plans proches quand la souris bouge,
	    ou dérivent doucement sur mobile) selon theme.Decor :
	      "None"    : blanc / gris épuré (halos très discrets, reflet lent)
	      "Kawaii"  : arc-en-ciel pastel, nuages à bouille, ballons, collines
	                  fleuries, cœurs et paillettes
	      "Stars"   : aurore boréale, nébuleuses, lune, étoiles filantes,
	                  montagnes et ville en deux plans (fenêtres, antennes)
	      "Sunset"  : soleil couchant, bandes de lumière, mer scintillante,
	                  voilier, collines, palmiers, nuages, oiseaux
	      "Leaves"  : montagnes dans la brume, rayons, bokeh, bambous
	                  feuillus, feuilles qui tombent
	      "Bubbles" : reflets de surface, baleine au loin, méduses, algues,
	                  coraux, poissons et bulles
	      "Candy"   : glaçage qui coule, nuages barbe à papa, collines de
	                  bonbons, sucettes, bonbons gélifiés, vermicelles
	      "Grid"    : synthwave (soleil rayé, deux chaînes de montagnes néon,
	                  palmiers, grille qui défile)
	      (v9.2) "Street"  : skatepark en ville (immeubles, mur tagué, rampe,
	                  panier de basket, skateur qui passe)
	      "Gamer"   : setup RGB (pixels, envahisseurs qui flottent,
	                  manettes, écrans, bande LED arc-en-ciel)
	      "Station" : station spatiale (planète qui tourne, lune, satellite,
	                  astronaute, étoiles filantes, hublot)
	  - fondu enchaîné quand le thème change ;
	  - moins d'éléments si le joueur a coupé les effets (Settings.Effects).

	Mode sombre : actif si le thème est sombre (theme.Dark) OU si le joueur
	possède le mode néon (Feature "NeonMode") -> ClientState.SetDarkMode.
	Dopamine Rush : une lueur jaune pulse doucement en bas de l'écran
	(Background.SetRush).
	v5 : mode sombre du joueur (⚙️, source "User" de ClientState) : le thème
	Classique passe en version nuit (dégradé presque noir, halos discrets) ;
	les autres thèmes gardent leur décor.

	Background.BuildPreview(parent, themeId) : même illustration en
	miniature (panneau des thèmes), animée par l'appelant.

	Tout est dessiné en code (Frames, UIGradient, UICorner, UIStroke, emojis),
	et animé par UNE seule boucle (Heartbeat) sans créer d'objets à chaque image.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Client = script.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local ClientState = require(Client.ClientState)
local Config = require(ReplicatedStorage.Shared.Config)
local Signal = require(ReplicatedStorage.Shared.Signal)

local Background = {}

Background.ThemeChanged = Signal.new() -- (theme) : le thème affiché a changé

type Plane = { Frame: Frame, Depth: number }

type Layer = {
	Frame: Frame,
	Update: ((dt: number, t: number) -> ())?,
	Time: number,
	Planes: { Plane },
}

export type Preview = {
	Frame: Frame,
	Update: (dt: number) -> (),
	Destroy: () -> (),
}

local DEFAULT_THEME = "Classic"
local CROSSFADE_TIME = 0.9
local DESIGN = Vector2.new(1280, 720)
local PARALLAX_X = 22 -- décalage max (pixels "design") d'un plan de profondeur 1
local PARALLAX_Y = 12

local root: Frame? = nil
local glow: Frame? = nil
local rushActive = false
local currentThemeId: string? = nil
local currentReduced = false
local currentNight = false -- Classique en version sombre (mode sombre du joueur)
local layers: { Layer } = {} -- couches animées (actuelle + celles qui s'effacent)
local parallax = Vector2.zero -- décalage lissé (-1..1)
local buildingPlanes: { Plane }? = nil -- plans du décor en cours de construction

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)

----------------------------------------------------------------------
-- Outils de dessin
----------------------------------------------------------------------

local Create = UIUtil.Create

local function box(props: { [string]: any }): Frame
	props.BorderSizePixel = 0
	return Create("Frame", props)
end

local function circle(props: { [string]: any }): Frame
	local frame = box(props)
	UIUtil.Corner(frame, UDim.new(1, 0))
	return frame
end

local function emoji(text: string, size: number, props: { [string]: any }): TextLabel
	props.Text = text
	props.TextSize = size
	props.Font = Theme.Fonts.Body
	props.BackgroundTransparency = 1
	props.Size = UDim2.fromOffset(size + 8, size + 8)
	props.AnchorPoint = props.AnchorPoint or Vector2.new(0.5, 0.5)
	return Create("TextLabel", props)
end

local function fadeSequence(from: number, to: number): NumberSequence
	return NumberSequence.new({
		NumberSequenceKeypoint.new(0, from),
		NumberSequenceKeypoint.new(1, to),
	})
end

-- Transparence "fondue aux deux bouts" (bandes, rubans)
local function edgeFade(edge: number, middle: number): NumberSequence
	return NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(edge, middle),
		NumberSequenceKeypoint.new(1 - edge, middle),
		NumberSequenceKeypoint.new(1, 1),
	})
end

-- Dégradé vertical top -> bottom (le fond du parent passe en blanc pour
-- que les couleurs du dégradé s'affichent telles quelles)
local function vgradient(parent: GuiObject, top: Color3, bottom: Color3): UIGradient
	parent.BackgroundColor3 = WHITE
	return Create("UIGradient", { Rotation = 90, Color = ColorSequence.new(top, bottom), Parent = parent })
end

-- Plan de parallaxe (cadre plein écran un peu plus grand que l'écran, pour
-- que ses bords ne se voient jamais quand il glisse)
local function plane(parent: Instance, depth: number, z: number): Frame
	local frame = box({
		Name = "Plane" .. tostring(math.floor(depth * 100)),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1.06, 1.06),
		BackgroundTransparency = 1,
		ZIndex = z,
		Parent = parent,
	})
	local list = buildingPlanes
	if list then
		table.insert(list, { Frame = frame, Depth = depth })
	end
	return frame
end

-- Halo doux : 3 disques concentriques transparents (faux dégradé radial)
local function softGlow(parent: Instance, size: number, color: Color3, opacity: number, z: number): Frame
	local holder = box({
		Name = "Glow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
		ZIndex = z,
		Parent = parent,
	})
	for _, k in ipairs({ 1, 0.68, 0.4 }) do
		circle({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(k, k),
			BackgroundColor3 = color,
			BackgroundTransparency = 1 - opacity,
			ZIndex = z,
			Parent = holder,
		})
	end
	return holder
end

-- Nuage "dessiné" (disques qui se chevauchent). CanvasGroup : la
-- transparence s'applique au nuage entier (pas de zones plus foncées).
local function cloud(parent: Instance, width: number, color: Color3, transparency: number, z: number, shade: Color3?): CanvasGroup
	local height = math.floor(width * 0.5)
	local group = Create("CanvasGroup", {
		Name = "Cloud",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(width, height),
		BackgroundTransparency = 1,
		GroupTransparency = transparency,
		ZIndex = z,
		Parent = parent,
	})
	local base = box({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.fromScale(1, 0.46),
		BackgroundColor3 = color,
		Parent = group,
	})
	UIUtil.Corner(base, UDim.new(1, 0))
	local puffs = { { 0.3, 0.62, 0.5 }, { 0.55, 0.45, 0.78 }, { 0.76, 0.6, 0.52 } }
	for _, puff in ipairs(puffs) do
		local d = height * puff[3] * 1.6
		circle({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(puff[1], puff[2]),
			Size = UDim2.fromOffset(d, d),
			BackgroundColor3 = color,
			Parent = group,
		})
	end
	-- Ombrage en bas
	Create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(WHITE, shade or Color3.fromRGB(225, 225, 235)),
		Parent = group,
	})
	return group
end

-- Grand disque dont on ne voit que le haut (colline)
local function mound(parent: Instance, x: number, top: number, diameter: number, color: Color3, z: number): Frame
	return circle({
		Name = "Mound",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(x, top),
		Size = UDim2.fromOffset(diameter, diameter),
		BackgroundColor3 = color,
		ZIndex = z,
		Parent = parent,
	})
end

-- Sommet de montagne : carré tourné à 45° (le bas est caché par le plan suivant)
local function peak(parent: Instance, x: number, baseY: number, size: number, color: Color3, z: number): Frame
	return box({
		Name = "Peak",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(x, baseY),
		Size = UDim2.fromOffset(size, size),
		Rotation = 45,
		BackgroundColor3 = color,
		ZIndex = z,
		Parent = parent,
	})
end

-- Palmier en silhouette (tronc courbé + palmes). Renvoie le support (ancré en bas au centre).
local function palm(parent: Instance, x: number, baseY: number, height: number, lean: number, color: Color3, z: number): Frame
	local holder = box({
		Name = "Palm",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(x, baseY),
		Size = UDim2.fromOffset(height, height),
		BackgroundTransparency = 1,
		ZIndex = z,
		Parent = parent,
	})
	local segments = 7
	local topX, topY = height * 0.5, height
	for i = 0, segments - 1 do
		local p = i / segments
		local px = height * 0.5 + lean * height * 0.28 * p * p
		local py = height * (1 - p * 0.84)
		local width = math.max(6, height * (0.075 - p * 0.03))
		box({
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromOffset(px, py),
			Size = UDim2.fromOffset(width, height * 0.15),
			Rotation = lean * p * 12,
			BackgroundColor3 = color,
			ZIndex = z,
			Parent = holder,
		})
		topX, topY = px, py - height * 0.12
	end
	local length = height * 0.44
	for _, angle in ipairs({ -165, -135, -100, -65, -30, 8, 170, 40, 140 }) do
		local radians = math.rad(angle)
		local frond = box({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(topX + math.cos(radians) * length * 0.5, topY + math.sin(radians) * length * 0.5),
			Size = UDim2.fromOffset(length, math.max(6, height * 0.06)),
			Rotation = angle,
			BackgroundColor3 = color,
			ZIndex = z,
			Parent = holder,
		})
		UIUtil.Corner(frond, UDim.new(1, 0))
	end
	return holder
end

----------------------------------------------------------------------
-- Éléments qui flottent / tombent / montent (positions en fraction d'écran)
----------------------------------------------------------------------

type Floater = {
	Obj: GuiObject,
	X: number,
	Y: number,
	VX: number,
	VY: number,
	Amp: number,
	Freq: number,
	Phase: number,
	Rot: number,
	Spin: number,
	Wobble: number,
}

local function newFloater(obj: GuiObject, random: Random, params: { [string]: any }): Floater
	return {
		Obj = obj,
		X = params.X or random:NextNumber(0, 1),
		Y = params.Y or random:NextNumber(0, 1),
		VX = params.VX or 0,
		VY = params.VY or 0,
		Amp = params.Amp or 0,
		Freq = params.Freq or random:NextNumber(0.4, 1),
		Phase = random:NextNumber(0, math.pi * 2),
		Rot = params.Rot or 0,
		Spin = params.Spin or 0,
		Wobble = params.Wobble or 0,
	}
end

local function stepFloaters(list: { Floater }, dt: number, t: number)
	for _, f in ipairs(list) do
		f.X += f.VX * dt
		f.Y += f.VY * dt
		-- On fait le tour de l'écran (marge de 12 %)
		if f.Y < -0.12 then
			f.Y += 1.24
		elseif f.Y > 1.12 then
			f.Y -= 1.24
		end
		if f.X < -0.15 then
			f.X += 1.3
		elseif f.X > 1.15 then
			f.X -= 1.3
		end
		local sway = math.sin(t * f.Freq + f.Phase)
		f.Obj.Position = UDim2.fromScale(f.X + sway * f.Amp, f.Y)
		if f.Spin ~= 0 or f.Wobble ~= 0 then
			f.Obj.Rotation = (f.Rot + f.Spin * t) % 360 + sway * f.Wobble
		end
	end
end

-- Scintillement : { Obj, Property, Min, Max, Speed, Phase } (transparences, échelles)
type Twinkle = { Obj: Instance, Property: string, Min: number, Max: number, Speed: number, Phase: number }

local function stepTwinkles(list: { Twinkle }, t: number)
	for _, tw in ipairs(list) do
		local k = 0.5 + 0.5 * math.sin(t * tw.Speed + tw.Phase)
		local object: any = tw.Obj
		object[tw.Property] = tw.Min + (tw.Max - tw.Min) * k
	end
end

local function twinkle(list: { Twinkle }, obj: Instance, property: string, min: number, max: number, random: Random, speedMin: number?, speedMax: number?)
	table.insert(list, {
		Obj = obj,
		Property = property,
		Min = min,
		Max = max,
		Speed = random:NextNumber(speedMin or 1, speedMax or 3),
		Phase = random:NextNumber(0, math.pi * 2),
	})
end

-- Couleur du ciel (dégradé du thème) à la hauteur y (0 = haut, 1 = bas)
local function skyAt(theme, y: number): Color3
	return (theme.Top :: Color3):Lerp(theme.Bottom, math.clamp(y, 0, 1))
end

-- Étoile en croix (deux fines barres) qui "respire"
local function crossStar(parent: Instance, x: number, y: number, size: number, color: Color3, z: number): (Frame, UIScale)
	local holder = box({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(x, y),
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
		ZIndex = z,
		Parent = parent,
	})
	for _, rotation in ipairs({ 0, 90 }) do
		local bar = box({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(0, 2, 1, 0),
			Rotation = rotation,
			BackgroundColor3 = color,
			ZIndex = z,
			Parent = holder,
		})
		Create("UIGradient", { Rotation = 90, Transparency = edgeFade(0.3, 0), Parent = bar })
	end
	circle({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(4, 4),
		BackgroundColor3 = color,
		ZIndex = z,
		Parent = holder,
	})
	local scale = Create("UIScale", { Parent = holder })
	return holder, scale
end

----------------------------------------------------------------------
-- Décors (chaque fonction construit dans `frame` et renvoie Update / Layout)
----------------------------------------------------------------------

type DecorResult = { Update: ((dt: number, t: number) -> ())?, Layout: (() -> ())? }
type DecorBuilder = (frame: Frame, theme: any, reduced: boolean, random: Random) -> DecorResult

local Decors: { [string]: DecorBuilder } = {}

-- Classique : blanc / gris épuré, halos presque invisibles et reflet lent
-- (version nuit si theme.Night : halos bleutés très discrets)
Decors.None = function(frame, theme, reduced, random)
	local night = theme.Night == true
	local far = plane(frame, 0.25, 1)
	local blobs = {}
	local count = reduced and 3 or 5
	for i = 1, count do
		local color = (i % 2 == 0) and Color3.fromRGB(200, 200, 208) or WHITE
		local opacity = i % 2 == 0 and 0.05 or 0.35
		if night then
			color = (i % 2 == 0) and Color3.fromRGB(90, 70, 150) or Color3.fromRGB(60, 70, 120)
			opacity = i % 2 == 0 and 0.06 or 0.08
		end
		local blob = softGlow(far, random:NextInteger(280, 460), color, opacity, 1)
		table.insert(blobs, {
			Obj = blob,
			X = random:NextNumber(0.05, 0.95),
			Y = random:NextNumber(0.1, 0.9),
			RX = random:NextNumber(0.03, 0.07),
			RY = random:NextNumber(0.03, 0.06),
			Speed = random:NextNumber(0.05, 0.1),
			Phase = random:NextNumber(0, math.pi * 2),
		})
	end
	-- Reflet diagonal qui traverse très lentement l'écran
	local sheen = box({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.new(0, 260, 1.6, 0),
		Rotation = 25,
		BackgroundColor3 = WHITE,
		BackgroundTransparency = night and 0.94 or 0.55,
		ZIndex = 1,
		Parent = frame,
	})
	Create("UIGradient", { Transparency = edgeFade(0.45, 0.4), Parent = sheen })
	-- Légère ombre en bas (profondeur)
	local shade = box({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, 0.35),
		BackgroundColor3 = night and BLACK or Color3.fromRGB(190, 190, 196),
		ZIndex = 1,
		Parent = frame,
	})
	Create("UIGradient", { Rotation = 90, Transparency = fadeSequence(1, 0.7), Parent = shade })

	return {
		Update = function(_dt, t)
			for _, b in ipairs(blobs) do
				b.Obj.Position = UDim2.fromScale(
					b.X + math.sin(t * b.Speed + b.Phase) * b.RX,
					b.Y + math.cos(t * b.Speed * 0.8 + b.Phase) * b.RY
				)
			end
			local cycle = (t % 24) / 24
			sheen.Position = UDim2.fromScale(-0.3 + cycle * 1.6, 0.5)
		end,
	}
end

-- Kawaii : arc-en-ciel, nuages à bouille, ballons, collines fleuries, cœurs
Decors.Kawaii = function(frame, theme, reduced, random)
	local floaters: { Floater } = {}
	local twinkles: { Twinkle } = {}
	local accent: Color3 = theme.Accent

	-- Plan lointain : halos pastel + pois
	local far = plane(frame, 0.15, 1)
	for index, color in ipairs({ Color3.fromRGB(255, 190, 220), Color3.fromRGB(200, 190, 255), Color3.fromRGB(190, 240, 225) }) do
		local halo = softGlow(far, random:NextInteger(420, 560), color, 0.16, 1)
		halo.Position = UDim2.fromScale(({ 0.15, 0.85, 0.5 })[index], ({ 0.3, 0.2, 0.75 })[index])
	end
	for _ = 1, reduced and 10 or 18 do
		local d = random:NextInteger(6, 12)
		circle({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(random:NextNumber(0, 1), random:NextNumber(0, 1)),
			Size = UDim2.fromOffset(d, d),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = random:NextNumber(0.35, 0.6),
			ZIndex = 1,
			Parent = far,
		})
	end

	-- Arc-en-ciel pastel (haut droit) : anneaux coupés à mi-hauteur
	local RAINBOW = {
		Color3.fromRGB(255, 150, 170),
		Color3.fromRGB(255, 200, 150),
		Color3.fromRGB(255, 240, 160),
		Color3.fromRGB(170, 235, 190),
		Color3.fromRGB(160, 210, 255),
		Color3.fromRGB(200, 170, 255),
	}
	local rainbowPlane = plane(frame, 0.25, 2)
	local ARC = 420
	local clip = box({
		Name = "Rainbow",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.84, 0.46),
		Size = UDim2.fromOffset(ARC + 36, ARC / 2 + 18),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		ZIndex = 2,
		Parent = rainbowPlane,
	})
	for index, color in ipairs(RAINBOW) do
		local d = ARC - (index - 1) * 32
		local ring = circle({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 1, 0),
			Size = UDim2.fromOffset(d, d),
			BackgroundTransparency = 1,
			ZIndex = 2,
			Parent = clip,
		})
		UIUtil.Stroke(ring, color, 16, 0.3)
	end
	-- Petits nuages au pied de l'arc-en-ciel
	for _, x in ipairs({ 0.84 - ARC / 2 / 1280, 0.84 + ARC / 2 / 1280 }) do
		local c = cloud(rainbowPlane, 150, WHITE, 0.05, 3, Color3.fromRGB(240, 225, 245))
		c.Position = UDim2.fromScale(x, 0.45)
	end

	-- Plan du milieu : nuages (certains avec une petite bouille) qui dérivent
	local mid = plane(frame, 0.45, 3)
	for i = 1, reduced and 3 or 5 do
		local width = random:NextInteger(150, 240)
		local c = cloud(mid, width, WHITE, random:NextNumber(0.02, 0.18), 3, Color3.fromRGB(238, 226, 246))
		if i % 2 == 1 then
			-- Bouille : deux yeux, deux joues roses
			for side = -1, 1, 2 do
				circle({
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.new(0.5, side * width * 0.09, 0.62, 0),
					Size = UDim2.fromOffset(7, 9),
					BackgroundColor3 = Color3.fromRGB(80, 60, 90),
					Parent = c,
				})
				circle({
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.new(0.5, side * width * 0.16, 0.72, 0),
					Size = UDim2.fromOffset(14, 8),
					BackgroundColor3 = Color3.fromRGB(255, 150, 190),
					BackgroundTransparency = 0.3,
					Parent = c,
				})
			end
		end
		table.insert(floaters, newFloater(c, random, {
			X = (i - 1) / 4 + random:NextNumber(-0.05, 0.05),
			Y = random:NextNumber(0.1, 0.55),
			VX = random:NextNumber(0.005, 0.011),
			Amp = 0.004,
			Freq = random:NextNumber(0.2, 0.4),
		}))
	end

	-- Ballons qui montent doucement
	local BALLOONS = { Color3.fromRGB(255, 130, 180), Color3.fromRGB(150, 200, 255), Color3.fromRGB(255, 210, 110), Color3.fromRGB(180, 150, 255) }
	for i = 1, reduced and 2 or 4 do
		local color = BALLOONS[(i - 1) % #BALLOONS + 1]
		local balloon = box({
			Name = "Balloon",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(46, 110),
			BackgroundTransparency = 1,
			ZIndex = 3,
			Parent = mid,
		})
		local body = circle({
			Size = UDim2.fromOffset(46, 54),
			BackgroundColor3 = color,
			BackgroundTransparency = 0.08,
			ZIndex = 3,
			Parent = balloon,
		})
		vgradient(body, color:Lerp(WHITE, 0.35), color)
		circle({
			Position = UDim2.fromOffset(10, 9),
			Size = UDim2.fromOffset(10, 15),
			Rotation = 20,
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.35,
			ZIndex = 3,
			Parent = body,
		})
		box({
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromOffset(23, 52),
			Size = UDim2.fromOffset(8, 6),
			Rotation = 45,
			BackgroundColor3 = color:Lerp(BLACK, 0.1),
			ZIndex = 3,
			Parent = balloon,
		})
		box({
			Name = "Cord",
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromOffset(23, 57),
			Size = UDim2.fromOffset(1, 52),
			BackgroundColor3 = Color3.fromRGB(150, 130, 160),
			BackgroundTransparency = 0.3,
			ZIndex = 3,
			Parent = balloon,
		})
		table.insert(floaters, newFloater(balloon, random, {
			Y = random:NextNumber(0.2, 1),
			VY = -random:NextNumber(0.008, 0.014),
			Amp = random:NextNumber(0.006, 0.014),
			Freq = random:NextNumber(0.5, 0.9),
			Wobble = random:NextNumber(4, 8),
		}))
	end

	-- Collines fleuries en bas
	local hills = plane(frame, 0.7, 4)
	local HILLS = { { 0.12, 0.8, 760, Color3.fromRGB(205, 240, 215) }, { 0.9, 0.78, 820, Color3.fromRGB(255, 214, 232) }, { 0.52, 0.86, 900, Color3.fromRGB(226, 214, 255) } }
	for _, spec in ipairs(HILLS) do
		local hill = mound(hills, spec[1], spec[2], spec[3], spec[4], 4)
		vgradient(hill, spec[4]:Lerp(WHITE, 0.35), spec[4])
	end
	local FLOWERS = { "🌷", "🌼", "🌸", "🌷" }
	for i = 1, reduced and 4 or 8 do
		local flower = emoji(FLOWERS[(i - 1) % #FLOWERS + 1], random:NextInteger(16, 22), {
			Position = UDim2.fromScale(random:NextNumber(0.02, 0.98), random:NextNumber(0.83, 0.9)),
			ZIndex = 5,
			Parent = hills,
		})
		twinkle(twinkles, flower, "Rotation", -8, 8, random, 0.6, 1.2)
	end

	-- Plan proche : cœurs, étoiles, fleurs qui montent en se dandinant
	local near = plane(frame, 1, 5)
	local ICONS = { "💗", "💖", "⭐", "🌸", "💕", "🎀", "💗", "⭐" }
	for _ = 1, reduced and 6 or 12 do
		local size = random:NextInteger(18, 32)
		local label = emoji(ICONS[random:NextInteger(1, #ICONS)], size, {
			TextTransparency = random:NextNumber(0.15, 0.4),
			ZIndex = 5,
			Parent = near,
		})
		table.insert(floaters, newFloater(label, random, {
			VY = -random:NextNumber(0.012, 0.028),
			Amp = random:NextNumber(0.008, 0.02),
			Rot = random:NextNumber(-15, 15),
			Wobble = random:NextNumber(8, 16),
		}))
	end
	-- Paillettes qui scintillent
	for _ = 1, reduced and 5 or 10 do
		local label = emoji("✨", random:NextInteger(14, 24), {
			Position = UDim2.fromScale(random:NextNumber(0.02, 0.98), random:NextNumber(0.03, 0.97)),
			ZIndex = 5,
			Parent = near,
		})
		twinkle(twinkles, label, "TextTransparency", 0.05, 1, random, 1.2, 2.6)
	end

	-- Lueur pastel en bas
	local haze = box({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, 0.4),
		BackgroundColor3 = accent,
		ZIndex = 1,
		Parent = frame,
	})
	Create("UIGradient", { Rotation = 90, Transparency = fadeSequence(1, 0.85), Parent = haze })

	return {
		Update = function(dt, t)
			stepFloaters(floaters, dt, t)
			stepTwinkles(twinkles, t)
		end,
	}
end

-- Nuit lofi : aurore, nébuleuses, lune, étoiles filantes, montagnes, ville en deux plans
Decors.Stars = function(frame, theme, reduced, random)
	local twinkles: { Twinkle } = {}
	local accent: Color3 = theme.Accent
	local bottom: Color3 = theme.Bottom

	-- Plan lointain : nébuleuses + étoiles
	local far = plane(frame, 0.08, 1)
	for index, color in ipairs({ Color3.fromRGB(150, 90, 255), Color3.fromRGB(60, 200, 220), Color3.fromRGB(255, 120, 200) }) do
		local nebula = softGlow(far, random:NextInteger(380, 520), color, 0.06, 1)
		nebula.Position = UDim2.fromScale(({ 0.2, 0.62, 0.4 })[index], ({ 0.22, 0.12, 0.45 })[index])
	end
	for _ = 1, reduced and 18 or 40 do
		local d = random:NextInteger(2, 4)
		local star = circle({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(random:NextNumber(0, 1), random:NextNumber(0, 0.7)),
			Size = UDim2.fromOffset(d, d),
			BackgroundColor3 = random:NextNumber() < 0.3 and accent or WHITE,
			ZIndex = 1,
			Parent = far,
		})
		twinkle(twinkles, star, "BackgroundTransparency", 0.05, 0.85, random, 1, 3.2)
	end
	for _ = 1, reduced and 2 or 5 do
		local _, scale = crossStar(far, random:NextNumber(0.05, 0.95), random:NextNumber(0.05, 0.45), random:NextInteger(14, 22), WHITE, 2)
		twinkle(twinkles, scale, "Scale", 0.35, 1.1, random, 0.8, 1.6)
	end

	-- Aurore boréale : rubans colorés qui ondulent
	local aurora = plane(frame, 0.12, 1)
	local ribbons = {}
	local AURORA = {
		{ Color3.fromRGB(80, 255, 190), Color3.fromRGB(80, 170, 255), 0.2 },
		{ Color3.fromRGB(150, 110, 255), Color3.fromRGB(255, 120, 220), 0.3 },
		{ Color3.fromRGB(90, 230, 255), Color3.fromRGB(140, 255, 160), 0.26 },
	}
	for index = 1, reduced and 2 or 3 do
		local spec = AURORA[index]
		local ribbon = box({
			Name = "Aurora",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, spec[3]),
			Size = UDim2.new(1.4, 0, 0, 90 - index * 12),
			Rotation = -8 + index * 5,
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.72,
			ZIndex = 1,
			Parent = aurora,
		})
		Create("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, spec[1]),
				ColorSequenceKeypoint.new(0.5, spec[2]),
				ColorSequenceKeypoint.new(1, spec[1]),
			}),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.2, 0.35),
				NumberSequenceKeypoint.new(0.5, 0.15),
				NumberSequenceKeypoint.new(0.8, 0.4),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = ribbon,
		})
		UIUtil.Corner(ribbon, UDim.new(1, 0))
		table.insert(ribbons, { Frame = ribbon, Base = ribbon.Rotation, Y = spec[3], Phase = random:NextNumber(0, 6) })
	end

	-- Lune + halo + anneau
	local moonPlane = plane(frame, 0.18, 2)
	local moonGlow = softGlow(moonPlane, 280, accent, 0.07, 2)
	moonGlow.Position = UDim2.fromScale(0.86, 0.17)
	local halo = circle({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.86, 0.17),
		Size = UDim2.fromOffset(150, 150),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = moonPlane,
	})
	UIUtil.Stroke(halo, accent, 2, 0.75)
	local moon = circle({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.86, 0.17),
		Size = UDim2.fromOffset(88, 88),
		BackgroundColor3 = Color3.fromRGB(255, 246, 214),
		ZIndex = 3,
		Parent = moonPlane,
	})
	Create("UIGradient", {
		Rotation = 135,
		Color = ColorSequence.new(WHITE, Color3.fromRGB(236, 222, 180)),
		Parent = moon,
	})
	for _, crater in ipairs({ { 0.32, 0.36, 16 }, { 0.62, 0.58, 12 }, { 0.42, 0.72, 8 } }) do
		circle({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(crater[1], crater[2]),
			Size = UDim2.fromOffset(crater[3], crater[3]),
			BackgroundColor3 = Color3.fromRGB(226, 212, 170),
			BackgroundTransparency = 0.3,
			ZIndex = 3,
			Parent = moon,
		})
	end

	-- Nuages sombres qui passent devant la lune
	local wisps: { Floater } = {}
	for _ = 1, 2 do
		local wisp = box({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(random:NextInteger(220, 340), random:NextInteger(18, 28)),
			BackgroundColor3 = bottom:Lerp(BLACK, 0.2),
			BackgroundTransparency = 0.45,
			ZIndex = 4,
			Parent = moonPlane,
		})
		UIUtil.Corner(wisp, UDim.new(1, 0))
		Create("UIGradient", { Transparency = edgeFade(0.3, 0.2), Parent = wisp })
		table.insert(wisps, newFloater(wisp, random, {
			Y = random:NextNumber(0.14, 0.32),
			VX = random:NextNumber(0.004, 0.009),
		}))
	end

	-- Étoile filante (une seule, réutilisée)
	local shooting = box({
		AnchorPoint = Vector2.new(1, 0.5),
		Size = UDim2.fromOffset(140, 2),
		BackgroundColor3 = WHITE,
		Rotation = 20,
		Visible = false,
		ZIndex = 2,
		Parent = far,
	})
	Create("UIGradient", { Transparency = fadeSequence(1, 0), Parent = shooting })
	local shootTimer = random:NextNumber(3, 6)
	local shootProgress = -1
	local shootFrom, shootTo = Vector2.zero, Vector2.zero

	-- Montagnes lointaines (silhouettes bleutées)
	local mountains = plane(frame, 0.3, 4)
	local mountainColor = bottom:Lerp(BLACK, 0.3)
	for i = 0, 6 do
		local size = random:NextInteger(220, 360)
		local m = peak(mountains, i / 6 + random:NextNumber(-0.04, 0.04), 0.84, size, mountainColor:Lerp(bottom, random:NextNumber(0, 0.2)), 4)
		UIUtil.Stroke(m, accent, 1, 0.85)
	end
	local fog = box({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, 0.32),
		BackgroundColor3 = accent,
		ZIndex = 4,
		Parent = mountains,
	})
	Create("UIGradient", { Rotation = 90, Transparency = fadeSequence(1, 0.8), Parent = fog })

	-- Villes : un plan lointain (clair) puis un plan proche (sombre, plus haut)
	local lit: { Frame } = {}
	local beacons: { Frame } = {}
	local function city(parent: Instance, color: Color3, minH: number, maxH: number, z: number, windows: number, antennas: boolean)
		local x = -0.02
		while x < 1.02 do
			local w = random:NextNumber(0.035, 0.07)
			local h = random:NextInteger(minH, maxH)
			local building = box({
				AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.fromScale(x, 1),
				Size = UDim2.new(w, 1, 0, h),
				BackgroundColor3 = color:Lerp(BLACK, random:NextNumber(0, 0.2)),
				ZIndex = z,
				Parent = parent,
			})
			-- Toit : petit décroché ou antenne avec lumière rouge
			if antennas and random:NextNumber() < 0.35 then
				box({
					AnchorPoint = Vector2.new(0.5, 1),
					Position = UDim2.fromScale(random:NextNumber(0.3, 0.7), 0),
					Size = UDim2.fromOffset(2, random:NextInteger(14, 26)),
					BackgroundColor3 = building.BackgroundColor3,
					ZIndex = z,
					Parent = building,
				})
				if #beacons < 4 then
					local beacon = circle({
						AnchorPoint = Vector2.new(0.5, 0.5),
						Position = UDim2.new(0.5, 0, 0, -22),
						Size = UDim2.fromOffset(5, 5),
						BackgroundColor3 = Color3.fromRGB(255, 70, 90),
						ZIndex = z,
						Parent = building,
					})
					table.insert(beacons, beacon)
				end
			elseif random:NextNumber() < 0.3 then
				box({
					AnchorPoint = Vector2.new(0.5, 1),
					Position = UDim2.fromScale(0.5, 0),
					Size = UDim2.new(0.55, 0, 0, random:NextInteger(8, 16)),
					BackgroundColor3 = building.BackgroundColor3,
					ZIndex = z,
					Parent = building,
				})
			end
			if h > minH + 10 and #lit < windows then
				for _ = 1, random:NextInteger(1, 3) do
					local window = box({
						Position = UDim2.fromScale(random:NextNumber(0.15, 0.75), random:NextNumber(0.1, 0.8)),
						Size = UDim2.fromOffset(4, 6),
						BackgroundColor3 = accent,
						BackgroundTransparency = random:NextNumber() < 0.6 and 0.1 or 1,
						ZIndex = z,
						Parent = building,
					})
					table.insert(lit, window)
				end
			end
			x += w
		end
	end
	local farCity = plane(frame, 0.5, 5)
	city(farCity, bottom:Lerp(BLACK, 0.45), 60, 140, 5, reduced and 10 or 20, false)
	local cityHaze = box({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 160),
		BackgroundColor3 = accent,
		ZIndex = 5,
		Parent = farCity,
	})
	Create("UIGradient", { Rotation = 90, Transparency = fadeSequence(1, 0.82), Parent = cityHaze })
	local nearCity = plane(frame, 0.85, 6)
	city(nearCity, bottom:Lerp(BLACK, 0.7), 40, 110, 6, reduced and 18 or 36, true)

	local windowTimer = 0.6
	return {
		Update = function(dt, t)
			stepTwinkles(twinkles, t)
			stepFloaters(wisps, dt, t)
			moonGlow.Size = UDim2.fromOffset(280 + math.sin(t * 0.7) * 16, 280 + math.sin(t * 0.7) * 16)
			for _, ribbon in ipairs(ribbons) do
				local s = math.sin(t * 0.22 + ribbon.Phase)
				ribbon.Frame.Rotation = ribbon.Base + s * 3
				ribbon.Frame.Position = UDim2.fromScale(0.5 + math.sin(t * 0.13 + ribbon.Phase) * 0.05, ribbon.Y + s * 0.02)
				ribbon.Frame.BackgroundTransparency = 0.7 + 0.12 * math.sin(t * 0.5 + ribbon.Phase)
			end
			for index, beacon in ipairs(beacons) do
				beacon.BackgroundTransparency = ((t + index * 0.37) % 1.6) < 0.5 and 0 or 0.85
			end

			-- Étoile filante
			if not reduced then
				if shootProgress < 0 then
					shootTimer -= dt
					if shootTimer <= 0 then
						shootProgress = 0
						shootFrom = Vector2.new(random:NextNumber(0.05, 0.6), random:NextNumber(0.03, 0.3))
						shootTo = shootFrom + Vector2.new(random:NextNumber(0.22, 0.35), 0.18)
						shooting.Rotation = math.deg(math.atan2(0.18 * 720, (shootTo.X - shootFrom.X) * 1280))
						shooting.Visible = true
					end
				else
					shootProgress += dt / 0.9
					local p = math.min(1, shootProgress)
					local eased = 1 - (1 - p) ^ 2
					local pos = shootFrom:Lerp(shootTo, eased)
					shooting.Position = UDim2.fromScale(pos.X, pos.Y)
					shooting.BackgroundTransparency = p < 0.15 and (1 - p / 0.15) or (p - 0.15) / 0.85
					if p >= 1 then
						shooting.Visible = false
						shootProgress = -1
						shootTimer = random:NextNumber(4, 9)
					end
				end
			end

			-- Une fenêtre s'allume / s'éteint de temps en temps
			windowTimer -= dt
			if windowTimer <= 0 and #lit > 0 then
				windowTimer = random:NextNumber(0.3, 1.2)
				local window = lit[random:NextInteger(1, #lit)]
				window.BackgroundTransparency = window.BackgroundTransparency < 0.5 and 1 or 0.1
			end
		end,
	}
end

-- Coucher de soleil : soleil, bandes de lumière, mer, voilier, collines, palmiers
Decors.Sunset = function(frame, theme, reduced, random)
	local floaters: { Floater } = {}
	local accent: Color3 = theme.Accent
	local bottom: Color3 = theme.Bottom
	local SUN_Y = 0.6
	local SEA_Y = 0.68

	-- Rayons qui tournent lentement derrière le soleil
	local sky = plane(frame, 0.1, 1)
	local rays = box({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, SUN_Y),
		Size = UDim2.fromOffset(1400, 1400),
		BackgroundTransparency = 1,
		ZIndex = 1,
		Parent = sky,
	})
	local rayCount = reduced and 6 or 10
	for i = 1, rayCount do
		local ray = box({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(0, 70, 1, 0),
			Rotation = (i - 1) * (180 / rayCount),
			BackgroundColor3 = accent,
			BackgroundTransparency = 0.82,
			ZIndex = 1,
			Parent = rays,
		})
		Create("UIGradient", { Rotation = 90, Transparency = edgeFade(0.42, 0.4), Parent = ray })
	end
	-- Bandes de lumière horizontales près de l'horizon
	for index, spec in ipairs({ { 0.44, 26, 0.7 }, { 0.52, 16, 0.6 }, { 0.36, 12, 0.78 } }) do
		local band = box({
			Name = "Band" .. index,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, spec[1]),
			Size = UDim2.new(1.1, 0, 0, spec[2]),
			BackgroundColor3 = Color3.fromRGB(255, 225, 190),
			BackgroundTransparency = spec[3],
			ZIndex = 1,
			Parent = sky,
		})
		UIUtil.Corner(band, UDim.new(1, 0))
		Create("UIGradient", { Transparency = edgeFade(0.3, 0), Parent = band })
		table.insert(floaters, newFloater(band, random, {
			X = 0.5,
			Y = spec[1],
			VX = 0,
			Amp = 0.02,
			Freq = random:NextNumber(0.05, 0.1),
		}))
	end

	-- Soleil (derrière la mer)
	local sunPlane = plane(frame, 0.15, 2)
	local sunGlow = softGlow(sunPlane, 560, accent, 0.12, 2)
	sunGlow.Position = UDim2.fromScale(0.5, SUN_Y)
	local sun = circle({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, SUN_Y),
		Size = UDim2.fromOffset(230, 230),
		BackgroundColor3 = WHITE,
		ZIndex = 3,
		Parent = sunPlane,
	})
	vgradient(sun, accent, Color3.fromRGB(255, 140, 90))

	-- Nuages roses
	local cloudPlane = plane(frame, 0.3, 3)
	for i = 1, reduced and 3 or 5 do
		local c = cloud(cloudPlane, random:NextInteger(150, 260), Color3.fromRGB(255, 236, 236), random:NextNumber(0.2, 0.4), 3, Color3.fromRGB(255, 190, 200))
		table.insert(floaters, newFloater(c, random, {
			X = (i - 1) / 4 + random:NextNumber(-0.05, 0.05),
			Y = random:NextNumber(0.08, 0.4),
			VX = random:NextNumber(0.004, 0.01),
			Amp = 0.003,
		}))
	end

	-- Mer : dégradé + reflet du soleil qui scintille + voilier
	local seaPlane = plane(frame, 0.35, 4)
	local sea = box({
		Name = "Sea",
		Position = UDim2.fromScale(0, SEA_Y),
		Size = UDim2.fromScale(1, 1 - SEA_Y),
		BackgroundColor3 = WHITE,
		ZIndex = 4,
		Parent = seaPlane,
	})
	vgradient(sea, bottom:Lerp(Color3.fromRGB(255, 170, 150), 0.35), bottom:Lerp(Color3.fromRGB(120, 60, 130), 0.6))
	local horizon = box({
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, SEA_Y),
		Size = UDim2.new(1, 0, 0, 2),
		BackgroundColor3 = Color3.fromRGB(255, 240, 210),
		BackgroundTransparency = 0.3,
		ZIndex = 4,
		Parent = seaPlane,
	})
	Create("UIGradient", { Transparency = edgeFade(0.35, 0), Parent = horizon })
	local glints = {}
	for i = 1, reduced and 5 or 9 do
		local glint = box({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, SEA_Y + 0.02 + i * 0.028),
			Size = UDim2.fromOffset(160 - i * 8, 3),
			BackgroundColor3 = accent:Lerp(WHITE, 0.4),
			BackgroundTransparency = 0.25,
			ZIndex = 4,
			Parent = seaPlane,
		})
		UIUtil.Corner(glint, UDim.new(1, 0))
		Create("UIGradient", { Transparency = edgeFade(0.3, 0), Parent = glint })
		table.insert(glints, { Frame = glint, Base = 160 - i * 8, Phase = random:NextNumber(0, 6) })
	end
	-- Voilier en silhouette
	local boat = box({
		Name = "Boat",
		AnchorPoint = Vector2.new(0.5, 1),
		Size = UDim2.fromOffset(46, 44),
		BackgroundTransparency = 1,
		ZIndex = 4,
		Parent = seaPlane,
	})
	local boatColor = bottom:Lerp(BLACK, 0.6)
	local hull = box({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.fromOffset(44, 8),
		BackgroundColor3 = boatColor,
		ZIndex = 4,
		Parent = boat,
	})
	UIUtil.Corner(hull, UDim.new(0, 4))
	box({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -7),
		Size = UDim2.fromOffset(2, 34),
		BackgroundColor3 = boatColor,
		ZIndex = 4,
		Parent = boat,
	})
	box({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 9, 1, -24),
		Size = UDim2.fromOffset(18, 18),
		Rotation = 45,
		BackgroundColor3 = boatColor,
		ZIndex = 4,
		Parent = boat,
	})
	local boatX = random:NextNumber(0.1, 0.3)

	-- Oiseaux (deux ailes qui battent)
	local birds = {}
	if not reduced then
		for _ = 1, 4 do
			local bird = box({
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(22, 10),
				BackgroundTransparency = 1,
				ZIndex = 3,
				Parent = cloudPlane,
			})
			local wings = {}
			for side = -1, 1, 2 do
				wings[#wings + 1] = box({
					AnchorPoint = Vector2.new(side < 0 and 1 or 0, 0.5),
					Position = UDim2.fromScale(0.5, 0.5),
					Size = UDim2.fromOffset(11, 2),
					BackgroundColor3 = Color3.fromRGB(90, 50, 80),
					BackgroundTransparency = 0.2,
					ZIndex = 3,
					Parent = bird,
				})
			end
			table.insert(floaters, newFloater(bird, random, {
				Y = random:NextNumber(0.15, 0.4),
				VX = random:NextNumber(0.012, 0.02),
				Amp = 0,
			}))
			table.insert(birds, { Wings = wings, Phase = random:NextNumber(0, 6), Speed = random:NextNumber(5, 8) })
		end
	end

	-- Collines sur les côtés (le centre laisse voir la mer), puis palmiers
	local hillPlane = plane(frame, 0.6, 5)
	local HILLS = {
		{ 0.05, 0.74, 620, bottom:Lerp(Color3.fromRGB(150, 70, 140), 0.5) },
		{ 0.98, 0.72, 660, bottom:Lerp(Color3.fromRGB(150, 70, 140), 0.5) },
		{ -0.05, 0.82, 700, bottom:Lerp(Color3.fromRGB(90, 35, 95), 0.72) },
		{ 1.08, 0.8, 720, bottom:Lerp(Color3.fromRGB(90, 35, 95), 0.72) },
	}
	for _, spec in ipairs(HILLS) do
		local hill = mound(hillPlane, spec[1], spec[2], spec[3], spec[4], 5)
		vgradient(hill, spec[4]:Lerp(accent, 0.12), spec[4])
	end
	local palmPlane = plane(frame, 0.9, 6)
	local palmColor = bottom:Lerp(Color3.fromRGB(40, 15, 45), 0.8)
	local palms = {
		palm(palmPlane, 0.06, 0.9, 250, 1, palmColor, 6),
		palm(palmPlane, 0.94, 0.88, 280, -1, palmColor, 6),
	}
	if not reduced then
		table.insert(palms, palm(palmPlane, 0.13, 0.94, 180, 0.6, palmColor, 6))
	end

	return {
		Update = function(dt, t)
			stepFloaters(floaters, dt, t)
			rays.Rotation = (t * 2) % 360
			local pulse = math.sin(t * 0.6)
			sun.Size = UDim2.fromOffset(230 + pulse * 4, 230 + pulse * 4)
			sunGlow.Size = UDim2.fromOffset(560 + pulse * 30, 560 + pulse * 30)
			for _, glint in ipairs(glints) do
				local k = math.sin(t * 1.4 + glint.Phase)
				glint.Frame.Size = UDim2.fromOffset(glint.Base * (0.75 + 0.25 * k), 3)
				glint.Frame.BackgroundTransparency = 0.3 + 0.25 * k
			end
			boatX = (boatX + dt * 0.004) % 1.2
			boat.Position = UDim2.new(boatX - 0.1, 0, SEA_Y + 0.035, math.sin(t * 1.5) * 1.5)
			boat.Rotation = math.sin(t * 1.2) * 3
			for _, bird in ipairs(birds) do
				local flap = math.sin(t * bird.Speed + bird.Phase) * 28
				bird.Wings[1].Rotation = flap
				bird.Wings[2].Rotation = -flap
			end
			for index, tree in ipairs(palms) do
				tree.Rotation = math.sin(t * 0.7 + index) * 1.5
			end
		end,
	}
end

-- Matcha : montagnes dans la brume, rayons, bokeh, bambous feuillus, feuilles
Decors.Leaves = function(frame, theme, reduced, random)
	local floaters: { Floater } = {}
	local accent: Color3 = theme.Accent
	local top: Color3 = theme.Top

	-- Montagnes en couches, de plus en plus nettes, séparées par de la brume
	for layerIndex, spec in ipairs({ { 0.12, 0.6, 0.55 }, { 0.22, 0.7, 0.35 }, { 0.32, 0.8, 0.15 } }) do
		local mountains = plane(frame, spec[1], layerIndex)
		local color = accent:Lerp(top, spec[3])
		for i = 0, 5 do
			peak(mountains, i / 5 + random:NextNumber(-0.06, 0.06) + layerIndex * 0.05, spec[2] + 0.12, random:NextInteger(260, 420), color, layerIndex)
		end
		local mist = box({
			AnchorPoint = Vector2.new(0, 0),
			Position = UDim2.fromScale(0, spec[2] + 0.02),
			Size = UDim2.fromScale(1, 0.5),
			BackgroundColor3 = top:Lerp(WHITE, 0.4),
			ZIndex = layerIndex,
			Parent = mountains,
		})
		Create("UIGradient", { Rotation = 90, Transparency = fadeSequence(0.95, 0.1), Parent = mist })
	end

	-- Rayons de soleil venant du coin
	local light = plane(frame, 0.2, 4)
	for i = 1, 3 do
		local beam = box({
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.08 + i * 0.07, -0.1),
			Size = UDim2.new(0, 70 + i * 20, 1.4, 0),
			Rotation = -28,
			BackgroundColor3 = Color3.fromRGB(255, 255, 230),
			BackgroundTransparency = 0.82,
			ZIndex = 4,
			Parent = light,
		})
		Create("UIGradient", { Rotation = 90, Transparency = fadeSequence(0.3, 1), Parent = beam })
	end

	-- Bokeh : halos de lumière qui montent doucement
	local bokeh = plane(frame, 0.4, 4)
	for _ = 1, reduced and 4 or 8 do
		local g = softGlow(bokeh, random:NextInteger(50, 140), Color3.fromRGB(255, 255, 215), 0.14, 4)
		table.insert(floaters, newFloater(g, random, {
			VY = -random:NextNumber(0.002, 0.006),
			Amp = random:NextNumber(0.01, 0.03),
			Freq = random:NextNumber(0.1, 0.25),
		}))
	end

	-- Bambous sur les côtés (se balancent doucement) avec des feuilles
	local bamboo = plane(frame, 0.85, 5)
	local stalks = {}
	local STALKS = { { 0.02, 22 }, { 0.055, 16 }, { 0.09, 12 }, { 0.915, 12 }, { 0.95, 18 }, { 0.985, 22 } }
	for index, spec in ipairs(STALKS) do
		if reduced and index % 2 == 0 then
			continue
		end
		local color = accent:Lerp(WHITE, random:NextNumber(0.1, 0.3))
		local stalk = box({
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromScale(spec[1], 1.02),
			Size = UDim2.new(0, spec[2], 1.1, 0),
			BackgroundColor3 = color,
			BackgroundTransparency = 0.15,
			ZIndex = 5,
			Parent = bamboo,
		})
		UIUtil.Corner(stalk, UDim.new(0, 6))
		Create("UIGradient", {
			Color = ColorSequence.new(color:Lerp(WHITE, 0.3), color:Lerp(BLACK, 0.15)),
			Parent = stalk,
		})
		for k = 1, 7 do
			box({
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, k / 8),
				Size = UDim2.new(1, 4, 0, 3),
				BackgroundColor3 = color:Lerp(BLACK, 0.25),
				BackgroundTransparency = 0.2,
				ZIndex = 5,
				Parent = stalk,
			})
			-- Feuilles aux nœuds (une sur deux)
			if k % 2 == 0 then
				local side = (index + k) % 2 == 0 and 1 or -1
				local leaf = box({
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.new(0.5, side * 26, k / 8, -6),
					Size = UDim2.fromOffset(46, 12),
					Rotation = side * 25,
					BackgroundColor3 = accent:Lerp(BLACK, 0.05),
					ZIndex = 5,
					Parent = stalk,
				})
				UIUtil.Corner(leaf, UDim.new(1, 0))
				vgradient(leaf, accent:Lerp(WHITE, 0.3), accent:Lerp(BLACK, 0.1))
			end
		end
		table.insert(stalks, { Frame = stalk, Phase = random:NextNumber(0, 6), Speed = random:NextNumber(0.4, 0.7) })
	end

	-- Feuilles (formes dessinées + quelques emojis) qui tombent en tournoyant
	local near = plane(frame, 1, 6)
	local LEAF_COLORS = {
		accent,
		accent:Lerp(WHITE, 0.3),
		accent:Lerp(Color3.fromRGB(200, 220, 90), 0.5),
		accent:Lerp(BLACK, 0.15),
	}
	for i = 1, reduced and 9 or 18 do
		local obj: GuiObject
		if i % 5 == 0 then
			obj = emoji("🍃", random:NextInteger(20, 30), { TextTransparency = 0.15, ZIndex = 6, Parent = near })
		else
			local w = random:NextInteger(18, 30)
			local color = LEAF_COLORS[random:NextInteger(1, #LEAF_COLORS)]
			local leaf = box({
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(w, math.floor(w * 0.42)),
				BackgroundColor3 = color,
				BackgroundTransparency = 0.1,
				ZIndex = 6,
				Parent = near,
			})
			UIUtil.Corner(leaf, UDim.new(1, 0))
			vgradient(leaf, color:Lerp(WHITE, 0.25), color)
			box({
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.new(0.75, 0, 0, 1),
				BackgroundColor3 = color:Lerp(BLACK, 0.3),
				BackgroundTransparency = 0.35,
				ZIndex = 6,
				Parent = leaf,
			})
			obj = leaf
		end
		table.insert(floaters, newFloater(obj, random, {
			VY = random:NextNumber(0.025, 0.05),
			VX = random:NextNumber(0.002, 0.01),
			Amp = random:NextNumber(0.015, 0.035),
			Freq = random:NextNumber(0.8, 1.6),
			Rot = random:NextNumber(0, 360),
			Spin = random:NextNumber(-40, 40),
			Wobble = random:NextNumber(20, 45),
		}))
	end

	return {
		Update = function(dt, t)
			stepFloaters(floaters, dt, t)
			for _, stalk in ipairs(stalks) do
				stalk.Frame.Rotation = math.sin(t * stalk.Speed + stalk.Phase) * 1.4
			end
		end,
	}
end

-- Océan : reflets de surface, baleine, méduses, algues, coraux, poissons, bulles
Decors.Bubbles = function(frame, theme, reduced, random)
	local floaters: { Floater } = {}
	local bottom: Color3 = theme.Bottom

	-- Rayons de lumière depuis la surface
	local light = plane(frame, 0.1, 1)
	local rays = {}
	local rayCount = reduced and 4 or 6
	for i = 1, rayCount do
		local ray = box({
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale((i - 0.5) / rayCount + random:NextNumber(-0.04, 0.04), -0.08),
			Size = UDim2.new(0, random:NextInteger(60, 140), 1.3, 0),
			Rotation = random:NextNumber(-22, -10),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.78,
			ZIndex = 1,
			Parent = light,
		})
		Create("UIGradient", { Rotation = 90, Transparency = fadeSequence(0.2, 1), Parent = ray })
		table.insert(rays, { Frame = ray, Base = ray.Rotation, Phase = random:NextNumber(0, 6), Speed = random:NextNumber(0.2, 0.4) })
	end
	-- Reflets ondulants de la surface (caustiques)
	local surface = box({
		Size = UDim2.new(1, 0, 0, 100),
		BackgroundColor3 = WHITE,
		ZIndex = 1,
		Parent = light,
	})
	Create("UIGradient", { Rotation = 90, Transparency = fadeSequence(0.55, 1), Parent = surface })
	local caustics = {}
	for i = 1, reduced and 5 or 9 do
		local line = box({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(random:NextInteger(80, 170), 4),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.45,
			ZIndex = 1,
			Parent = light,
		})
		UIUtil.Corner(line, UDim.new(1, 0))
		Create("UIGradient", { Transparency = edgeFade(0.3, 0), Parent = line })
		table.insert(caustics, { Frame = line, X = (i - 0.5) / (reduced and 5 or 9), Y = random:NextNumber(0.03, 0.11), Phase = random:NextNumber(0, 6) })
	end

	-- Baleine au loin (silhouette qui traverse très lentement)
	local far = plane(frame, 0.2, 2)
	local whaleColor = bottom:Lerp(Color3.fromRGB(20, 60, 110), 0.5)
	local whale = box({
		Name = "Whale",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(330, 130),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = far,
	})
	local whaleBody = circle({
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.55),
		Size = UDim2.fromOffset(250, 90),
		BackgroundColor3 = whaleColor,
		BackgroundTransparency = 0.6,
		ZIndex = 2,
		Parent = whale,
	})
	whaleBody.Name = "Body"
	for _, spec in ipairs({ { 0.86, 0.42, -35 }, { 0.86, 0.68, 35 } }) do
		local fluke = circle({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(spec[1], spec[2]),
			Size = UDim2.fromOffset(80, 26),
			Rotation = spec[3],
			BackgroundColor3 = whaleColor,
			BackgroundTransparency = 0.6,
			ZIndex = 2,
			Parent = whale,
		})
		fluke.Name = "Fluke"
	end
	local whaleX = random:NextNumber(0, 1)

	-- Récif lointain
	local reef = plane(frame, 0.35, 3)
	for i = 0, 5 do
		local rock = mound(reef, i / 5 + random:NextNumber(-0.05, 0.05), 0.86 + random:NextNumber(-0.03, 0.03), random:NextInteger(260, 420), bottom:Lerp(BLACK, 0.3), 3)
		rock.BackgroundTransparency = 0.25
	end

	-- Méduses
	local mid = plane(frame, 0.55, 4)
	local jellies = {}
	for i = 1, reduced and 1 or 3 do
		local color = ({ Color3.fromRGB(255, 160, 220), Color3.fromRGB(190, 160, 255), Color3.fromRGB(150, 230, 255) })[i]
		local jelly = box({
			Name = "Jelly",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(60, 110),
			BackgroundTransparency = 1,
			ZIndex = 4,
			Parent = mid,
		})
		local domeClip = box({
			Size = UDim2.fromOffset(60, 32),
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			ZIndex = 4,
			Parent = jelly,
		})
		local dome = circle({
			Size = UDim2.fromOffset(60, 60),
			BackgroundColor3 = color,
			BackgroundTransparency = 0.3,
			ZIndex = 4,
			Parent = domeClip,
		})
		vgradient(dome, color:Lerp(WHITE, 0.5), color)
		local tentacles = {}
		for k = 1, 4 do
			local tentacle = box({
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.fromOffset(12 + (k - 1) * 12, 30),
				Size = UDim2.fromOffset(3, 44 + (k % 2) * 18),
				BackgroundColor3 = color,
				BackgroundTransparency = 0.3,
				ZIndex = 4,
				Parent = jelly,
			})
			Create("UIGradient", { Rotation = 90, Transparency = fadeSequence(0.1, 1), Parent = tentacle })
			table.insert(tentacles, tentacle)
		end
		local scale = Create("UIScale", { Parent = jelly })
		table.insert(jellies, { Scale = scale, Tentacles = tentacles, Phase = random:NextNumber(0, 6) })
		table.insert(floaters, newFloater(jelly, random, {
			Y = random:NextNumber(0.2, 0.9),
			VY = -random:NextNumber(0.006, 0.012),
			Amp = random:NextNumber(0.01, 0.02),
			Freq = random:NextNumber(0.3, 0.6),
			Wobble = 6,
		}))
	end

	-- Poissons
	local FISH = { "🐠", "🐟", "🐡" }
	for _ = 1, reduced and 1 or 3 do
		local fish = emoji(FISH[random:NextInteger(1, #FISH)], random:NextInteger(26, 40), {
			TextTransparency = 0.2,
			ZIndex = 4,
			Parent = mid,
		})
		table.insert(floaters, newFloater(fish, random, {
			Y = random:NextNumber(0.2, 0.8),
			VX = -random:NextNumber(0.015, 0.03),
			Amp = 0.004,
			Freq = random:NextNumber(1, 2),
			Wobble = 5,
		}))
	end

	-- Algues et coraux (premier plan, sur les côtés)
	local near = plane(frame, 0.9, 5)
	local kelps = {}
	local KELP_X = reduced and { 0.03, 0.97 } or { 0.02, 0.06, 0.1, 0.9, 0.94, 0.98 }
	for _, x in ipairs(KELP_X) do
		local segments = {}
		local color = Color3.fromRGB(60, 170, 120):Lerp(bottom, random:NextNumber(0.1, 0.35))
		local count = random:NextInteger(7, 10)
		for k = 1, count do
			local seg = circle({
				AnchorPoint = Vector2.new(0.5, 1),
				Size = UDim2.fromOffset(16, 36),
				BackgroundColor3 = color:Lerp(WHITE, k / count * 0.25),
				ZIndex = 5,
				Parent = near,
			})
			table.insert(segments, seg)
		end
		table.insert(kelps, { Segments = segments, X = x, Phase = random:NextNumber(0, 6) })
	end
	local CORAL = { Color3.fromRGB(255, 120, 140), Color3.fromRGB(255, 170, 90), Color3.fromRGB(200, 120, 255) }
	for i = 1, reduced and 2 or 4 do
		local x = ({ 0.14, 0.86, 0.2, 0.8 })[i]
		local color = CORAL[(i - 1) % #CORAL + 1]
		for k = 1, 4 do
			circle({
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.new(x, (k - 2.5) * 14, 1.02, 0),
				Size = UDim2.fromOffset(14, 40 + (k % 2) * 22),
				Rotation = (k - 2.5) * 12,
				BackgroundColor3 = color:Lerp(WHITE, k * 0.06),
				ZIndex = 5,
				Parent = near,
			})
		end
	end

	-- Bulles
	local bubbles = plane(frame, 1, 6)
	for _ = 1, reduced and 11 or 22 do
		local d = random:NextInteger(8, 30)
		local bubble = circle({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(d, d),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.85,
			ZIndex = 6,
			Parent = bubbles,
		})
		UIUtil.Stroke(bubble, WHITE, d > 16 and 2 or 1.5, 0.3)
		circle({
			Position = UDim2.fromScale(0.2, 0.18),
			Size = UDim2.fromScale(0.28, 0.28),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.25,
			ZIndex = 6,
			Parent = bubble,
		})
		table.insert(floaters, newFloater(bubble, random, {
			VY = -random:NextNumber(0.03, 0.07) * (0.6 + d / 40),
			Amp = random:NextNumber(0.004, 0.012),
			Freq = random:NextNumber(1.5, 3),
		}))
	end

	-- Fond plus sombre en bas (profondeur)
	local deep = box({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, 0.45),
		BackgroundColor3 = bottom:Lerp(BLACK, 0.35),
		ZIndex = 1,
		Parent = frame,
	})
	Create("UIGradient", { Rotation = 90, Transparency = fadeSequence(1, 0.55), Parent = deep })

	return {
		Update = function(dt, t)
			stepFloaters(floaters, dt, t)
			for _, ray in ipairs(rays) do
				local k = math.sin(t * ray.Speed + ray.Phase)
				ray.Frame.Rotation = ray.Base + k * 3
				ray.Frame.BackgroundTransparency = 0.8 + k * 0.08
			end
			for _, c in ipairs(caustics) do
				local k = math.sin(t * 0.9 + c.Phase)
				c.Frame.Position = UDim2.fromScale(c.X + k * 0.02, c.Y + math.cos(t * 0.7 + c.Phase) * 0.01)
				c.Frame.Rotation = k * 8
			end
			whaleX = (whaleX + dt * 0.006) % 1.6
			whale.Position = UDim2.fromScale(1.3 - whaleX, 0.34 + math.sin(t * 0.2) * 0.02)
			for _, jelly in ipairs(jellies) do
				local pulse = math.sin(t * 2 + jelly.Phase)
				jelly.Scale.Scale = 1 + pulse * 0.05
				for k, tentacle in ipairs(jelly.Tentacles) do
					tentacle.Rotation = math.sin(t * 2.2 + jelly.Phase + k) * 10
				end
			end
			for _, kelp in ipairs(kelps) do
				for k, seg in ipairs(kelp.Segments) do
					local sway = math.sin(t * 0.9 + kelp.Phase + k * 0.45) * k * 1.6
					seg.Position = UDim2.new(kelp.X, sway, 1.03, -(k - 1) * 30)
					seg.Rotation = sway * 0.8
				end
			end
		end,
	}
end

-- Bonbon : glaçage qui coule, barbe à papa, collines, sucettes, bonbons gélifiés
Decors.Candy = function(frame, theme, reduced, random)
	local floaters: { Floater } = {}
	local accent: Color3 = theme.Accent

	-- Rayures en diagonale qui défilent lentement
	local STRIPES = 14
	local stripes = {}
	for i = 1, STRIPES do
		local stripe = box({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0, 0.5),
			Size = UDim2.new(0, 46, 1.35, 0),
			Rotation = 35,
			BackgroundColor3 = i % 2 == 0 and accent or WHITE,
			BackgroundTransparency = i % 2 == 0 and 0.92 or 0.6,
			ZIndex = 1,
			Parent = frame,
		})
		table.insert(stripes, { Frame = stripe, Offset = (i - 1) / STRIPES })
	end

	-- Nuages barbe à papa
	local cloudPlane = plane(frame, 0.25, 2)
	local COTTON = { Color3.fromRGB(255, 200, 230), Color3.fromRGB(200, 225, 255), Color3.fromRGB(235, 210, 255) }
	for i = 1, reduced and 2 or 4 do
		local color = COTTON[(i - 1) % #COTTON + 1]
		local c = cloud(cloudPlane, random:NextInteger(170, 250), color, 0.1, 2, color:Lerp(accent, 0.3))
		table.insert(floaters, newFloater(c, random, {
			X = (i - 1) / 3.5 + random:NextNumber(-0.04, 0.04),
			Y = random:NextNumber(0.14, 0.45),
			VX = random:NextNumber(0.004, 0.009),
			Amp = 0.004,
			Freq = random:NextNumber(0.2, 0.4),
		}))
	end

	-- Collines de bonbon en bas, sucettes et bonbons gélifiés
	local hills = plane(frame, 0.6, 3)
	for _, spec in ipairs({
		{ 0.1, 0.8, 720, Color3.fromRGB(255, 205, 225) },
		{ 0.9, 0.78, 760, Color3.fromRGB(200, 240, 225) },
		{ 0.5, 0.88, 900, Color3.fromRGB(230, 215, 255) },
	}) do
		local hill = mound(hills, spec[1], spec[2], spec[3], spec[4], 3)
		vgradient(hill, spec[4]:Lerp(WHITE, 0.4), spec[4])
		UIUtil.Stroke(hill, WHITE, 3, 0.4)
	end
	local lollipops = {}
	local LOLLI = { Color3.fromRGB(255, 90, 170), Color3.fromRGB(80, 190, 255), Color3.fromRGB(255, 190, 60) }
	local LOLLI_X = reduced and { 0.08, 0.92 } or { 0.06, 0.16, 0.86, 0.95 }
	for index, x in ipairs(LOLLI_X) do
		local color = LOLLI[(index - 1) % #LOLLI + 1]
		local height = random:NextInteger(120, 170)
		local holder = box({
			Name = "Lollipop",
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromScale(x, 0.9),
			Size = UDim2.fromOffset(80, height),
			BackgroundTransparency = 1,
			ZIndex = 4,
			Parent = hills,
		})
		local stick = box({
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromScale(0.5, 1),
			Size = UDim2.new(0, 7, 1, -40),
			BackgroundColor3 = WHITE,
			ZIndex = 4,
			Parent = holder,
		})
		UIUtil.Corner(stick, UDim.new(1, 0))
		UIUtil.Stroke(stick, Color3.fromRGB(230, 200, 220), 1, 0.3)
		local disc = circle({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(40, 40),
			Size = UDim2.fromOffset(76, 76),
			BackgroundColor3 = WHITE,
			ZIndex = 5,
			Parent = holder,
		})
		UIUtil.Stroke(disc, color:Lerp(BLACK, 0.1), 3, 0.2)
		Create("UIGradient", {
			Rotation = 45,
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, color),
				ColorSequenceKeypoint.new(0.25, WHITE),
				ColorSequenceKeypoint.new(0.5, color),
				ColorSequenceKeypoint.new(0.75, WHITE),
				ColorSequenceKeypoint.new(1, color),
			}),
			Parent = disc,
		})
		for _, k in ipairs({ 0.66, 0.34 }) do
			local ring = circle({
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromScale(k, k),
				BackgroundTransparency = 1,
				ZIndex = 5,
				Parent = disc,
			})
			UIUtil.Stroke(ring, color, 3, 0.25)
		end
		circle({
			Position = UDim2.fromScale(0.18, 0.14),
			Size = UDim2.fromScale(0.22, 0.16),
			Rotation = -30,
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.2,
			ZIndex = 5,
			Parent = disc,
		})
		table.insert(lollipops, { Disc = disc, Speed = random:NextNumber(8, 16) * (index % 2 == 0 and 1 or -1) })
	end
	local GUMS = { Color3.fromRGB(255, 110, 130), Color3.fromRGB(120, 220, 140), Color3.fromRGB(255, 200, 80), Color3.fromRGB(170, 130, 255) }
	for i = 1, reduced and 3 or 6 do
		local color = GUMS[(i - 1) % #GUMS + 1]
		local gum = box({
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromScale(random:NextNumber(0.2, 0.8), random:NextNumber(0.9, 0.95)),
			Size = UDim2.fromOffset(34, 30),
			BackgroundColor3 = color,
			BackgroundTransparency = 0.05,
			ZIndex = 4,
			Parent = hills,
		})
		UIUtil.Corner(gum, UDim.new(0.5, 0))
		vgradient(gum, color:Lerp(WHITE, 0.35), color)
		circle({
			Position = UDim2.fromScale(0.2, 0.15),
			Size = UDim2.fromOffset(8, 6),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.25,
			ZIndex = 4,
			Parent = gum,
		})
	end

	-- Vermicelles colorés
	local near = plane(frame, 0.9, 5)
	local SPRINKLES = {
		Color3.fromRGB(255, 90, 170),
		Color3.fromRGB(255, 210, 60),
		Color3.fromRGB(80, 200, 255),
		Color3.fromRGB(140, 230, 110),
		Color3.fromRGB(180, 120, 255),
		Color3.fromRGB(255, 150, 80),
	}
	for _ = 1, reduced and 14 or 26 do
		local sprinkle = box({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(5, random:NextInteger(12, 18)),
			BackgroundColor3 = SPRINKLES[random:NextInteger(1, #SPRINKLES)],
			BackgroundTransparency = 0.1,
			ZIndex = 5,
			Parent = near,
		})
		UIUtil.Corner(sprinkle, UDim.new(1, 0))
		table.insert(floaters, newFloater(sprinkle, random, {
			VY = random:NextNumber(0.008, 0.02),
			Amp = random:NextNumber(0.002, 0.008),
			Rot = random:NextNumber(0, 360),
			Spin = random:NextNumber(-30, 30),
		}))
	end
	-- Bonbons qui flottent
	local CANDIES = { "🍭", "🍬", "🍩", "🧁", "🍓", "🍡" }
	for _ = 1, reduced and 3 or 6 do
		local label = emoji(CANDIES[random:NextInteger(1, #CANDIES)], random:NextInteger(26, 38), {
			TextTransparency = 0.12,
			ZIndex = 5,
			Parent = near,
		})
		table.insert(floaters, newFloater(label, random, {
			VY = -random:NextNumber(0.008, 0.018),
			Amp = random:NextNumber(0.01, 0.02),
			Rot = random:NextNumber(-20, 20),
			Wobble = random:NextNumber(10, 20),
		}))
	end

	-- Glaçage qui coule du haut de l'écran
	local icing = plane(frame, 0.05, 6)
	local icingColor = WHITE:Lerp(accent, 0.18)
	local band = box({
		Name = "Icing",
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundColor3 = icingColor,
		ZIndex = 6,
		Parent = icing,
	})
	vgradient(band, WHITE, icingColor)
	local drips = {}
	local x = 0.01
	while x < 1 do
		local length = random:NextInteger(20, 70)
		local drip = box({
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(x, 0, 0, 30),
			Size = UDim2.fromOffset(random:NextInteger(18, 30), length),
			BackgroundColor3 = icingColor,
			ZIndex = 6,
			Parent = icing,
		})
		UIUtil.Corner(drip, UDim.new(1, 0))
		table.insert(drips, { Frame = drip, Base = length, Phase = random:NextNumber(0, 6) })
		x += random:NextNumber(0.03, 0.06)
	end

	return {
		Update = function(dt, t)
			stepFloaters(floaters, dt, t)
			local scroll = (t * 0.012) % (1 / STRIPES * 2)
			for _, s in ipairs(stripes) do
				local sx = (s.Offset + scroll) % 1
				s.Frame.Position = UDim2.fromScale(-0.3 + sx * 1.6, 0.5)
			end
			for _, lolli in ipairs(lollipops) do
				lolli.Disc.Rotation = (t * lolli.Speed) % 360
			end
			for _, drip in ipairs(drips) do
				local width = drip.Frame.Size.X.Offset
				drip.Frame.Size = UDim2.fromOffset(width, drip.Base + math.sin(t * 0.5 + drip.Phase) * 6)
			end
		end,
	}
end

-- Synthwave : soleil rayé, deux chaînes de montagnes néon, palmiers, grille
Decors.Grid = function(frame, theme, reduced, random)
	local HORIZON = 0.62
	local twinkles: { Twinkle } = {}
	local accent: Color3 = theme.Accent
	local pink = Color3.fromRGB(255, 70, 170)

	-- Étoiles
	local far = plane(frame, 0.08, 1)
	for _ = 1, reduced and 12 or 26 do
		local d = random:NextInteger(2, 3)
		local star = circle({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(random:NextNumber(0, 1), random:NextNumber(0.02, HORIZON - 0.25)),
			Size = UDim2.fromOffset(d, d),
			BackgroundColor3 = WHITE,
			ZIndex = 1,
			Parent = far,
		})
		twinkle(twinkles, star, "BackgroundTransparency", 0.1, 0.9, random, 1, 3)
	end
	for _ = 1, reduced and 1 or 3 do
		local _, scale = crossStar(far, random:NextNumber(0.05, 0.95), random:NextNumber(0.05, 0.3), 16, accent, 1)
		twinkle(twinkles, scale, "Scale", 0.4, 1.1, random, 0.8, 1.5)
	end

	-- Soleil rayé : CanvasGroup arrondi (les bandes sont coupées au bord du
	-- disque) ; les bandes prennent la couleur du ciel derrière
	local SUN_SIZE = 300
	local sunCenterY = HORIZON - 0.08
	local sunPlane = plane(frame, 0.12, 2)
	local sunGlow = softGlow(sunPlane, 600, pink, 0.1, 2)
	sunGlow.Position = UDim2.fromScale(0.5, sunCenterY)
	local sun = Create("CanvasGroup", {
		Name = "Sun",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, sunCenterY),
		Size = UDim2.fromOffset(SUN_SIZE, SUN_SIZE),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = sunPlane,
	})
	UIUtil.Corner(sun, UDim.new(1, 0))
	local sunDisc = box({
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = WHITE,
		ZIndex = 1,
		Parent = sun,
	})
	Create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 236, 110)),
			ColorSequenceKeypoint.new(0.55, Color3.fromRGB(255, 130, 90)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 50, 150)),
		}),
		Parent = sunDisc,
	})
	local bands = {}
	for i = 1, 5 do
		local y = 0.5 + i * 0.085
		local band = box({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, y),
			Size = UDim2.new(1, 0, 0, 3 + i * 2),
			ZIndex = 2,
			Parent = sun,
		})
		table.insert(bands, { Frame = band, Y = y })
	end

	-- Deux chaînes de montagnes (arrière : violet clair, avant : sombre), contour néon
	local backRange = plane(frame, 0.2, 4)
	for i = 0, 7 do
		local m = peak(backRange, i / 7 + random:NextNumber(-0.03, 0.03), HORIZON + 0.02, random:NextInteger(140, 230), Color3.fromRGB(70, 20, 110), 4)
		vgradient(m, Color3.fromRGB(120, 40, 160), Color3.fromRGB(40, 8, 70))
		UIUtil.Stroke(m, pink, 1.5, 0.5)
	end
	local frontRange = plane(frame, 0.32, 4)
	for _, spec in ipairs({ { 0.08, 200 }, { 0.2, 140 }, { 0.32, 90 }, { 0.7, 110 }, { 0.82, 170 }, { 0.94, 220 } }) do
		local m = peak(frontRange, spec[1], HORIZON + 0.03, spec[2], Color3.fromRGB(28, 6, 52), 4)
		UIUtil.Stroke(m, accent, 2, 0.3)
	end

	-- Sol + grille
	local groundPlane = plane(frame, 0.5, 5)
	local ground = box({
		Name = "Ground",
		Position = UDim2.fromScale(0, HORIZON),
		Size = UDim2.fromScale(1, 1 - HORIZON),
		BackgroundColor3 = Color3.fromRGB(16, 2, 34),
		ClipsDescendants = true,
		ZIndex = 5,
		Parent = groundPlane,
	})
	vgradient(ground, Color3.fromRGB(60, 10, 90), Color3.fromRGB(12, 0, 28))
	local horizonLine = box({
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, HORIZON),
		Size = UDim2.new(1, 0, 0, 3),
		BackgroundColor3 = pink,
		ZIndex = 6,
		Parent = groundPlane,
	})
	Create("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.8),
			NumberSequenceKeypoint.new(0.5, 0),
			NumberSequenceKeypoint.new(1, 0.8),
		}),
		Parent = horizonLine,
	})
	local horizonGlow = box({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, HORIZON),
		Size = UDim2.new(1, 0, 0, 60),
		BackgroundColor3 = pink,
		ZIndex = 5,
		Parent = groundPlane,
	})
	Create("UIGradient", { Rotation = 90, Transparency = fadeSequence(1, 0.7), Parent = horizonGlow })

	local H_LINES = reduced and 7 or 10
	local hLines = {}
	for index = 1, H_LINES do
		hLines[index] = box({
			AnchorPoint = Vector2.new(0, 0.5),
			Size = UDim2.new(1, 0, 0, 2),
			BackgroundColor3 = accent,
			ZIndex = 6,
			Parent = ground,
		})
	end
	local vLines = {}
	for k = -7, 7 do
		local line = box({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.new(0, 2, 1, 0),
			BackgroundColor3 = accent,
			ZIndex = 6,
			Parent = ground,
		})
		Create("UIGradient", { Rotation = 90, Transparency = fadeSequence(0.9, 0.25), Parent = line })
		table.insert(vLines, { Frame = line, K = k })
	end

	-- Palmiers en silhouette sur les côtés
	local palmPlane = plane(frame, 0.9, 7)
	local palmColor = Color3.fromRGB(20, 4, 36)
	local palms = { palm(palmPlane, 0.05, 1.02, 300, 1, palmColor, 7), palm(palmPlane, 0.95, 1.02, 320, -1, palmColor, 7) }
	if not reduced then
		table.insert(palms, palm(palmPlane, 0.13, 1.02, 200, 0.7, palmColor, 7))
		table.insert(palms, palm(palmPlane, 0.87, 1.02, 210, -0.7, palmColor, 7))
	end

	-- Vignette sombre en haut
	local vignette = box({
		Size = UDim2.fromScale(1, 0.3),
		BackgroundColor3 = BLACK,
		ZIndex = 1,
		Parent = frame,
	})
	Create("UIGradient", { Rotation = 90, Transparency = fadeSequence(0.6, 1), Parent = vignette })

	-- Lignes fuyantes : partent du centre de l'horizon (dépend du format de l'écran)
	local function layout()
		local absolute = ground.AbsoluteSize
		if absolute.Y < 1 then
			return
		end
		local aspect = absolute.X / absolute.Y
		for _, entry in ipairs(vLines) do
			local dx = entry.K * aspect * 0.2
			entry.Frame.Size = UDim2.new(0, 2, math.sqrt(dx * dx + 1), 0)
			entry.Frame.Position = UDim2.fromScale((aspect / 2 + dx / 2) / aspect, 0.5)
			entry.Frame.Rotation = -math.deg(math.atan2(dx, 1))
		end
		-- Bandes du soleil : couleur du ciel à leur hauteur
		local canvas = frame.AbsoluteSize
		if canvas.Y > 0 then
			local scale = sun.AbsoluteSize.Y / SUN_SIZE
			for _, band in ipairs(bands) do
				local y = (sun.AbsolutePosition.Y - frame.AbsolutePosition.Y + band.Y * SUN_SIZE * scale) / canvas.Y
				band.Frame.BackgroundColor3 = skyAt(theme, y):Lerp(pink, 0.2) -- (+ la lueur du soleil)
			end
		end
	end

	local scroll = 0
	return {
		Layout = layout,
		Update = function(dt, t)
			stepTwinkles(twinkles, t)
			scroll = (scroll + dt * 0.2) % 1
			for index, line in ipairs(hLines) do
				local z = ((index - 1) / H_LINES + scroll) % 1
				line.Position = UDim2.fromScale(0, z ^ 2.1)
				line.BackgroundTransparency = 0.85 - z * 0.7
			end
			local pulse = math.sin(t * 0.8)
			sunGlow.Size = UDim2.fromOffset(600 + pulse * 30, 600 + pulse * 30)
			horizonGlow.BackgroundTransparency = 0.1 + 0.1 * pulse
			for index, tree in ipairs(palms) do
				tree.Rotation = math.sin(t * 0.8 + index) * 1.2
			end
		end,
	}
end

----------------------------------------------------------------------
-- (v9.2) Décors "cool" : Street (skatepark en ville), Gamer (setup RGB),
-- Station (station spatiale)
----------------------------------------------------------------------

-- Petit bloc de pixels (envahisseur) : `rows` = chaînes de 0 / 1
local function pixelSprite(parent: Instance, rows: { string }, pixel: number, color: Color3, z: number): Frame
	local width = #rows[1] * pixel
	local holder = box({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(width, #rows * pixel),
		BackgroundTransparency = 1,
		ZIndex = z,
		Parent = parent,
	})
	for rowIndex, line in ipairs(rows) do
		-- une Frame par suite de pixels allumés (moins de Frames)
		local col = 1
		while col <= #line do
			if string.sub(line, col, col) == "1" then
				local start = col
				while col <= #line and string.sub(line, col, col) == "1" do
					col += 1
				end
				box({
					Position = UDim2.fromOffset((start - 1) * pixel, (rowIndex - 1) * pixel),
					Size = UDim2.fromOffset((col - start) * pixel, pixel),
					BackgroundColor3 = color,
					ZIndex = z,
					Parent = holder,
				})
			else
				col += 1
			end
		end
	end
	return holder
end

-- Street : ciel de jour, immeubles, mur de briques tagué, rampe de skate,
-- panier de basket, nuages qui passent, skateur qui traverse l'écran
Decors.Street = function(frame, theme, reduced, random)
	local floaters: { Floater } = {}
	local twinkles: { Twinkle } = {}
	local accent: Color3 = theme.Accent

	-- Soleil + nuages
	local far = plane(frame, 0.1, 1)
	local sun = softGlow(far, 260, Color3.fromRGB(255, 240, 180), 0.35, 1)
	sun.Position = UDim2.fromScale(0.82, 0.16)
	circle({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.82, 0.16),
		Size = UDim2.fromOffset(86, 86),
		BackgroundColor3 = Color3.fromRGB(255, 230, 130),
		ZIndex = 2,
		Parent = far,
	})
	for i = 1, reduced and 2 or 4 do
		local c = cloud(far, random:NextInteger(160, 260), WHITE, 0.1, 2)
		table.insert(floaters, newFloater(c, random, { X = random:NextNumber(0, 1), Y = random:NextNumber(0.08, 0.3), VX = random:NextNumber(0.004, 0.01) }))
		local _ = i
	end

	-- Immeubles au loin (fenêtres)
	local city = plane(frame, 0.22, 2)
	local x = -0.02
	local index = 0
	while x < 1.04 do
		index += 1
		local w = random:NextNumber(0.06, 0.1)
		local h = random:NextNumber(0.22, 0.42)
		local building = box({
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(x, 0.7),
			Size = UDim2.fromScale(w, h),
			BackgroundColor3 = skyAt(theme, 0.4):Lerp(Color3.fromRGB(90, 110, 160), 0.45 + (index % 2) * 0.1),
			ZIndex = 2,
			Parent = city,
		})
		for row = 0, 5 do
			for col = 0, 2 do
				if random:NextNumber() < 0.55 then
					box({
						Position = UDim2.fromScale(0.14 + col * 0.28, 0.06 + row * 0.15),
						Size = UDim2.fromScale(0.16, 0.07),
						BackgroundColor3 = WHITE,
						BackgroundTransparency = 0.55,
						ZIndex = 2,
						Parent = building,
					})
				end
			end
		end
		x += w + 0.008
	end

	-- Mur de briques avec graffitis
	local wallPlane = plane(frame, 0.4, 3)
	local wall = box({
		Name = "Wall",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 0.86),
		Size = UDim2.fromScale(1, 0.2),
		BackgroundColor3 = Color3.fromRGB(196, 110, 90),
		ClipsDescendants = true,
		ZIndex = 3,
		Parent = wallPlane,
	})
	for row = 0, 5 do
		box({
			Position = UDim2.fromScale(0, row / 6),
			Size = UDim2.new(1, 0, 0, 2),
			BackgroundColor3 = Color3.fromRGB(150, 80, 70),
			ZIndex = 3,
			Parent = wall,
		})
		for col = 0, 16 do
			box({
				Position = UDim2.fromScale(col / 16 + (row % 2) / 32, row / 6),
				Size = UDim2.new(0, 2, 1 / 6, 0),
				BackgroundColor3 = Color3.fromRGB(150, 80, 70),
				ZIndex = 3,
				Parent = wall,
			})
		end
	end
	local tags = { { "SKATE", 0.18, Color3.fromRGB(80, 200, 255) }, { "GG", 0.5, accent }, { "COOL!", 0.82, Color3.fromRGB(140, 240, 110) } }
	for tagIndex, tag in ipairs(tags) do
		if not reduced or tagIndex ~= 3 then
			local splash = circle({
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(tag[2], 0.5),
				Size = UDim2.fromOffset(210, 90),
				BackgroundColor3 = WHITE,
				BackgroundTransparency = 0.55,
				ZIndex = 4,
				Parent = wall,
			})
			local _ = splash
			local label = Create("TextLabel", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(tag[2], 0.5),
				Size = UDim2.fromOffset(260, 90),
				BackgroundTransparency = 1,
				Font = Enum.Font.FredokaOne,
				Text = tag[1],
				TextSize = 58,
				TextColor3 = tag[3],
				TextStrokeColor3 = Color3.fromRGB(40, 36, 60),
				TextStrokeTransparency = 0,
				Rotation = -6 + tagIndex * 4,
				ZIndex = 5,
				Parent = wall,
			})
			twinkle(twinkles, label, "TextTransparency", 0, 0.12, random, 0.6, 1.2)
		end
	end
	-- Trottoir
	local ground = box({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1.02),
		Size = UDim2.fromScale(1, 0.17),
		BackgroundColor3 = WHITE,
		ZIndex = 4,
		Parent = wallPlane,
	})
	vgradient(ground, Color3.fromRGB(206, 210, 220), Color3.fromRGB(160, 166, 180))
	for col = 0, 8 do
		box({
			Position = UDim2.fromScale(col / 8, 0),
			Size = UDim2.new(0, 3, 1, 0),
			BackgroundColor3 = Color3.fromRGB(140, 146, 160),
			BackgroundTransparency = 0.4,
			ZIndex = 4,
			Parent = ground,
		})
	end

	-- Premier plan : rampe de skate (gauche) + panier de basket (droite)
	local near = plane(frame, 0.8, 6)
	local ramp = box({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(-0.02, 1.02),
		Size = UDim2.fromOffset(220, 130),
		BackgroundColor3 = Color3.fromRGB(190, 140, 100),
		ClipsDescendants = true,
		ZIndex = 6,
		Parent = near,
	})
	UIUtil.Corner(ramp, UDim.new(0, 6))
	circle({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, 20, 0, -10),
		Size = UDim2.fromOffset(300, 260),
		BackgroundColor3 = skyAt(theme, 0.9):Lerp(Color3.fromRGB(180, 190, 206), 0.6),
		ZIndex = 6,
		Parent = ramp,
	})
	box({
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.fromOffset(40, 8),
		BackgroundColor3 = Color3.fromRGB(200, 206, 220),
		ZIndex = 7,
		Parent = ramp,
	})
	local pole = box({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.9, 1.02),
		Size = UDim2.fromOffset(12, 250),
		BackgroundColor3 = Color3.fromRGB(120, 126, 146),
		ZIndex = 6,
		Parent = near,
	})
	local board = box({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(0.5, 16, 0, -10),
		Size = UDim2.fromOffset(110, 70),
		BackgroundColor3 = WHITE,
		ZIndex = 7,
		Parent = pole,
	})
	UIUtil.Corner(board, UDim.new(0, 6))
	UIUtil.Stroke(board, Color3.fromRGB(60, 80, 150), 3, 0)
	local rim = box({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, -8),
		Size = UDim2.fromOffset(52, 6),
		BackgroundColor3 = Color3.fromRGB(255, 130, 50),
		ZIndex = 8,
		Parent = board,
	})
	UIUtil.Corner(rim, UDim.new(1, 0))
	local ball = emoji("🏀", 34, { Position = UDim2.fromScale(0.86, 0.9), ZIndex = 8, Parent = near })

	-- Skateur qui traverse le trottoir de temps en temps
	local skater = emoji("🛹", 40, { Position = UDim2.fromScale(-0.2, 0.93), ZIndex = 7, Parent = near })

	return {
		Update = function(dt, t)
			stepFloaters(floaters, dt, t)
			stepTwinkles(twinkles, t)
			-- ballon qui rebondit sous le panier
			local bounce = math.abs(math.sin(t * 2.4))
			ball.Position = UDim2.fromScale(0.86, 0.95 - bounce * 0.12)
			local cycle = (t % 14) / 14
			skater.Position = UDim2.fromScale(-0.15 + cycle * 1.4, 0.93 - math.abs(math.sin(t * 6)) * 0.005)
			skater.Rotation = math.sin(t * 3) * 4
		end,
	}
end

-- Gamer : setup RGB dans le noir (grille de pixels, envahisseurs qui
-- flottent, manettes, écrans et bande LED arc-en-ciel)
Decors.Gamer = function(frame, theme, reduced, random)
	local floaters: { Floater } = {}
	local twinkles: { Twinkle } = {}
	local accent: Color3 = theme.Accent
	local magenta = Color3.fromRGB(255, 84, 196)

	-- Plan lointain : halos néon + grille de pixels qui scintillent
	local far = plane(frame, 0.08, 1)
	for i, color in ipairs({ accent, magenta, Color3.fromRGB(140, 110, 255) }) do
		local halo = softGlow(far, random:NextInteger(420, 560), color, 0.08, 1)
		halo.Position = UDim2.fromScale(({ 0.15, 0.85, 0.5 })[i], ({ 0.25, 0.3, 0.7 })[i])
	end
	for _ = 1, reduced and 16 or 34 do
		local size = random:NextInteger(4, 9)
		local pixel = box({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(random:NextNumber(0, 1), random:NextNumber(0, 0.75)),
			Size = UDim2.fromOffset(size, size),
			BackgroundColor3 = random:NextNumber() < 0.5 and accent or magenta,
			ZIndex = 1,
			Parent = far,
		})
		twinkle(twinkles, pixel, "BackgroundTransparency", 0.1, 0.95, random, 0.8, 2.5)
	end

	-- Envahisseurs en pixels qui flottent
	local mid = plane(frame, 0.3, 3)
	local invader = { "00100000100", "00010001000", "00111111100", "01101110110", "11111111111", "10111111101", "10100000101", "00011011000" }
	local ghost = { "0011100", "0111110", "1101011", "1111111", "1111111", "1010101" }
	local colors = { Color3.fromRGB(140, 240, 110), accent, magenta, Color3.fromRGB(255, 214, 80) }
	for i = 1, reduced and 3 or 6 do
		local sprite = pixelSprite(mid, i % 2 == 0 and ghost or invader, random:NextInteger(4, 6), colors[(i - 1) % #colors + 1], 3)
		table.insert(floaters, newFloater(sprite, random, {
			X = random:NextNumber(0, 1), Y = random:NextNumber(0.1, 0.7),
			VX = random:NextNumber(-0.012, 0.012), VY = random:NextNumber(-0.006, 0.006), Amp = 0.01, Wobble = 6,
		}))
	end
	for _ = 1, reduced and 2 or 4 do
		local pad = emoji("🎮", random:NextInteger(26, 36), { TextTransparency = 0.2, ZIndex = 3, Parent = mid })
		table.insert(floaters, newFloater(pad, random, { VY = -random:NextNumber(0.008, 0.016), Amp = 0.02, Wobble = 12 }))
	end

	-- Premier plan : deux écrans + bureau + bande LED arc-en-ciel
	local near = plane(frame, 0.7, 5)
	local screens = {}
	for i, x in ipairs({ 0.1, 0.9 }) do
		local monitor = box({
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromScale(x, 0.93),
			Size = UDim2.fromOffset(190, 118),
			BackgroundColor3 = Color3.fromRGB(20, 20, 34),
			ZIndex = 5,
			Parent = near,
		})
		UIUtil.Corner(monitor, UDim.new(0, 8))
		UIUtil.Stroke(monitor, i == 1 and accent or magenta, 2, 0.2)
		local screen = box({
			Position = UDim2.fromOffset(8, 8),
			Size = UDim2.new(1, -16, 1, -16),
			BackgroundColor3 = WHITE,
			ZIndex = 5,
			Parent = monitor,
		})
		UIUtil.Corner(screen, UDim.new(0, 4))
		vgradient(screen, i == 1 and Color3.fromRGB(40, 60, 140) or Color3.fromRGB(110, 30, 110), Color3.fromRGB(16, 16, 40))
		-- barres d'égaliseur / de vie qui bougent
		for bar = 0, 5 do
			local b = box({
				AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.fromScale(0.08 + bar * 0.15, 0.9),
				Size = UDim2.fromScale(0.1, 0.4),
				BackgroundColor3 = bar % 2 == 0 and accent or magenta,
				ZIndex = 6,
				Parent = screen,
			})
			table.insert(screens, { Frame = b, Phase = random:NextNumber(0, 6) })
		end
		box({
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 1, 0),
			Size = UDim2.fromOffset(16, 20),
			BackgroundColor3 = Color3.fromRGB(40, 40, 60),
			ZIndex = 5,
			Parent = monitor,
		})
	end
	local desk = box({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1.03),
		Size = UDim2.fromScale(1, 0.08),
		BackgroundColor3 = Color3.fromRGB(24, 24, 40),
		ZIndex = 6,
		Parent = near,
	})
	local led = box({
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.new(1, 0, 0, 5),
		BackgroundColor3 = WHITE,
		ZIndex = 7,
		Parent = desk,
	})
	local ledGradient = Create("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 120)),
			ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 200, 80)),
			ColorSequenceKeypoint.new(0.4, Color3.fromRGB(120, 240, 110)),
			ColorSequenceKeypoint.new(0.6, Color3.fromRGB(60, 222, 255)),
			ColorSequenceKeypoint.new(0.8, Color3.fromRGB(150, 110, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 80, 120)),
		}),
		Parent = led,
	})
	local ledGlow = box({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.new(1, 0, 0, 50),
		BackgroundColor3 = accent,
		ZIndex = 5,
		Parent = desk,
	})
	Create("UIGradient", { Rotation = 90, Transparency = fadeSequence(1, 0.6), Parent = ledGlow })

	return {
		Update = function(dt, t)
			stepFloaters(floaters, dt, t)
			stepTwinkles(twinkles, t)
			for _, s in ipairs(screens) do
				s.Frame.Size = UDim2.fromScale(0.1, 0.2 + 0.6 * (0.5 + 0.5 * math.sin(t * 3 + s.Phase)))
			end
			-- l'arc-en-ciel défile ; la lueur change de couleur
			ledGradient.Offset = Vector2.new(((t * 0.08) % 1) - 0.5, 0)
			ledGlow.BackgroundColor3 = Color3.fromHSV((t * 0.06) % 1, 0.7, 1)
		end,
	}
end

-- Station spatiale : étoiles, grande planète, lune, satellite, astronaute
-- qui flotte, étoiles filantes, hublot de la station sur les bords
Decors.Station = function(frame, theme, reduced, random)
	local floaters: { Floater } = {}
	local twinkles: { Twinkle } = {}
	local accent: Color3 = theme.Accent

	local far = plane(frame, 0.06, 1)
	for i, color in ipairs({ Color3.fromRGB(90, 70, 200), Color3.fromRGB(40, 150, 200) }) do
		local nebula = softGlow(far, random:NextInteger(420, 560), color, 0.08, 1)
		nebula.Position = UDim2.fromScale(({ 0.7, 0.25 })[i], ({ 0.25, 0.4 })[i])
	end
	for _ = 1, reduced and 22 or 50 do
		local d = random:NextInteger(2, 4)
		local star = circle({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(random:NextNumber(0, 1), random:NextNumber(0, 1)),
			Size = UDim2.fromOffset(d, d),
			BackgroundColor3 = random:NextNumber() < 0.25 and accent or WHITE,
			ZIndex = 1,
			Parent = far,
		})
		twinkle(twinkles, star, "BackgroundTransparency", 0.05, 0.85, random, 1, 3)
	end
	for _ = 1, reduced and 1 or 3 do
		local _, scale = crossStar(far, random:NextNumber(0.1, 0.9), random:NextNumber(0.05, 0.5), 18, WHITE, 2)
		twinkle(twinkles, scale, "Scale", 0.4, 1.1, random, 0.8, 1.6)
	end

	-- Grande planète (océans + continents + atmosphère) en bas à gauche
	local planetPlane = plane(frame, 0.15, 2)
	local atmosphere = softGlow(planetPlane, 700, Color3.fromRGB(110, 200, 255), 0.18, 2)
	atmosphere.Position = UDim2.fromScale(0.14, 1.05)
	local planet = Create("CanvasGroup", {
		Name = "Planet",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.14, 1.05),
		Size = UDim2.fromOffset(560, 560),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = planetPlane,
	})
	UIUtil.Corner(planet, UDim.new(1, 0))
	local ocean = box({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, ZIndex = 1, Parent = planet })
	vgradient(ocean, Color3.fromRGB(80, 170, 255), Color3.fromRGB(30, 70, 170))
	local land = {}
	for i, spec in ipairs({ { 0.3, 0.2, 0.32, 0.18 }, { 0.62, 0.36, 0.26, 0.22 }, { 0.4, 0.6, 0.3, 0.16 }, { 0.75, 0.12, 0.18, 0.1 } }) do
		local continent = circle({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(spec[1], spec[2]),
			Size = UDim2.fromScale(spec[3], spec[4]),
			BackgroundColor3 = Color3.fromRGB(110, 200, 120),
			Rotation = i * 20,
			ZIndex = 2,
			Parent = planet,
		})
		table.insert(land, { Frame = continent, X = spec[1] })
	end
	local shadow = circle({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.75, 0.65),
		Size = UDim2.fromScale(1.2, 1.2),
		BackgroundColor3 = Color3.fromRGB(4, 6, 24),
		BackgroundTransparency = 0.45,
		ZIndex = 3,
		Parent = planet,
	})
	local _ = shadow
	-- Lune
	local moon = circle({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.86, 0.2),
		Size = UDim2.fromOffset(70, 70),
		BackgroundColor3 = Color3.fromRGB(220, 222, 236),
		ZIndex = 2,
		Parent = planetPlane,
	})
	for _, crater in ipairs({ { 0.3, 0.35, 16 }, { 0.62, 0.6, 12 }, { 0.4, 0.72, 8 } }) do
		circle({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(crater[1], crater[2]),
			Size = UDim2.fromOffset(crater[3], crater[3]),
			BackgroundColor3 = Color3.fromRGB(180, 182, 200),
			ZIndex = 2,
			Parent = moon,
		})
	end

	-- Satellite, astronaute et étoile filante
	local mid = plane(frame, 0.35, 4)
	local satellite = emoji("🛰️", 42, { ZIndex = 4, Parent = mid })
	table.insert(floaters, newFloater(satellite, random, { X = 0.3, Y = 0.18, VX = 0.012, Amp = 0.01, Spin = 6, Wobble = 4 }))
	local astronaut = box({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(60, 70),
		BackgroundTransparency = 1,
		ZIndex = 4,
		Parent = mid,
	})
	local suit = box({ Position = UDim2.fromOffset(14, 30), Size = UDim2.fromOffset(32, 30), BackgroundColor3 = WHITE, ZIndex = 4, Parent = astronaut })
	UIUtil.Corner(suit, UDim.new(0, 10))
	local helmet = circle({ Position = UDim2.fromOffset(10, 0), Size = UDim2.fromOffset(40, 38), BackgroundColor3 = WHITE, ZIndex = 5, Parent = astronaut })
	local visor = circle({ Position = UDim2.fromOffset(7, 8), Size = UDim2.fromOffset(26, 20), BackgroundColor3 = Color3.fromRGB(40, 60, 130), ZIndex = 6, Parent = helmet })
	box({ Position = UDim2.fromOffset(5, 4), Size = UDim2.fromOffset(8, 4), BackgroundColor3 = WHITE, BackgroundTransparency = 0.4, ZIndex = 7, Parent = visor })
	for _, x in ipairs({ 2, 46 }) do
		local arm = box({ Position = UDim2.fromOffset(x, 34), Size = UDim2.fromOffset(12, 22), BackgroundColor3 = WHITE, ZIndex = 4, Parent = astronaut })
		UIUtil.Corner(arm, UDim.new(0, 6))
	end
	for _, x in ipairs({ 16, 32 }) do
		local leg = box({ Position = UDim2.fromOffset(x, 56), Size = UDim2.fromOffset(12, 14), BackgroundColor3 = Color3.fromRGB(220, 226, 240), ZIndex = 4, Parent = astronaut })
		UIUtil.Corner(leg, UDim.new(0, 5))
	end
	table.insert(floaters, newFloater(astronaut, random, { X = 0.72, Y = 0.62, VX = -0.006, VY = -0.004, Amp = 0.02, Spin = -8, Wobble = 10 }))
	local shooting = box({
		AnchorPoint = Vector2.new(1, 0.5),
		Size = UDim2.fromOffset(160, 3),
		Rotation = 20,
		BackgroundColor3 = WHITE,
		ZIndex = 3,
		Parent = mid,
	})
	Create("UIGradient", { Transparency = fadeSequence(1, 0), Parent = shooting })

	-- Hublot de la station : cadre métal arrondi sur les bords de l'écran
	local frameColor = Color3.fromRGB(40, 48, 80)
	local porthole = box({
		Name = "Porthole",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -24, 1, -24),
		BackgroundTransparency = 1,
		ZIndex = 8,
		Parent = frame,
	})
	UIUtil.Corner(porthole, UDim.new(0, 60))
	UIUtil.Stroke(porthole, frameColor, 18, 0)
	local rimLight = box({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -44, 1, -44),
		BackgroundTransparency = 1,
		ZIndex = 8,
		Parent = frame,
	})
	UIUtil.Corner(rimLight, UDim.new(0, 50))
	UIUtil.Stroke(rimLight, accent, 2, 0.5)
	for _, pos in ipairs({ { 0.02, 0.5 }, { 0.98, 0.5 }, { 0.5, 0.015 }, { 0.5, 0.985 } }) do
		local bolt = circle({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(pos[1], pos[2]),
			Size = UDim2.fromOffset(9, 9),
			BackgroundColor3 = Color3.fromRGB(150, 160, 196),
			ZIndex = 9,
			Parent = frame,
		})
		local _ = bolt
	end

	return {
		Update = function(dt, t)
			stepFloaters(floaters, dt, t)
			stepTwinkles(twinkles, t)
			-- la planète tourne (continents qui glissent)
			for _, entry in ipairs(land) do
				local x = ((entry.X + t * 0.004) % 1.3) - 0.15
				entry.Frame.Position = UDim2.fromScale(x, entry.Frame.Position.Y.Scale)
			end
			-- étoile filante toutes les ~9 s
			local cycle = t % 9
			if cycle < 1 then
				shooting.Visible = true
				shooting.Position = UDim2.fromScale(0.2 + cycle * 0.5, 0.1 + cycle * 0.18)
				shooting.BackgroundTransparency = cycle
			else
				shooting.Visible = false
			end
		end,
	}
end

----------------------------------------------------------------------
-- Thème courant
----------------------------------------------------------------------

local function getTheme(id: string?): any
	local theme = id and Config.ThemesById[id]
	if theme then
		return theme
	end
	return Config.ThemesById[DEFAULT_THEME] or Config.Themes[1]
end

-- Mode sombre du joueur sur le thème Classique -> version nuit
local function wantsNight(themeId: string?): boolean
	return ClientState.HasDarkSource("User") and (themeId or DEFAULT_THEME) == DEFAULT_THEME
end

-- Thème à dessiner : version nuit (copie modifiée) du Classique si besoin
local function displayTheme(theme, night: boolean): any
	if not night then
		return theme
	end
	local copy = table.clone(theme)
	copy.Top = Theme.DarkUI.Background
	copy.Bottom = Theme.DarkUI.BackgroundBottom
	copy.Night = true
	return copy
end

local function equippedId(): string
	local data = ClientState.Data
	local themes = data and data.Themes
	local id = themes and themes.Equipped
	if type(id) == "string" and Config.ThemesById[id] then
		return id
	end
	return DEFAULT_THEME
end

local function isReduced(): boolean
	local data = ClientState.Data
	return data ~= nil and data.Settings ~= nil and data.Settings.Effects == false
end

-- Mode sombre voulu : thème sombre OU mode néon possédé.
-- (source "principale" de ClientState ; le stimulus NeonMode a sa propre source)
local function desiredDark(): boolean
	local theme = getTheme(currentThemeId)
	return (theme and theme.Dark == true) or ClientState.HasFeature("NeonMode")
end

local function applyDark()
	ClientState.SetDarkMode(desiredDark())
end

-- Construit le décor d'un thème dans un nouveau cadre plein écran.
-- Renvoie (cadre, Update ou nil, Layout ou nil, plans de parallaxe)
local function buildDecor(theme, reduced: boolean, random: Random): (Frame, ((dt: number, t: number) -> ())?, (() -> ())?, { Plane })
	local frame = box({
		Name = "Theme_" .. tostring(theme.Id),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = WHITE,
		ClipsDescendants = true,
		ZIndex = 1,
	})
	UIUtil.Gradient(frame, ColorSequence.new(theme.Top, theme.Bottom), 90)

	local planes: { Plane } = {}
	buildingPlanes = planes
	local builder = Decors[theme.Decor] or Decors.None
	local ok, result = pcall(builder, frame, theme, reduced, random)
	buildingPlanes = nil
	if not ok then
		warn("[Background] Erreur dans le décor " .. tostring(theme.Decor) .. " : " .. tostring(result))
		return frame, nil, nil, planes
	end
	if type(result) ~= "table" then
		return frame, nil, nil, planes
	end
	return frame, result.Update, result.Layout, planes
end

-- Branche la mise en page (Layout) d'un décor sur la taille de son cadre
local function bindLayout(frame: Frame, layout: (() -> ())?)
	if not layout then
		return
	end
	local function safeLayout()
		local success, err = pcall(layout)
		if not success then
			warn("[Background] Erreur de mise en page : " .. tostring(err))
		end
	end
	frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(safeLayout)
	task.defer(safeLayout)
end

local function buildLayer(theme, reduced: boolean): Layer
	local target = root :: Frame
	local frame, update, layout, planes = buildDecor(theme, reduced, Random.new())
	frame.Parent = target
	bindLayout(frame, layout)
	local layer: Layer = { Frame = frame, Update = update, Time = 0, Planes = planes }
	table.insert(layers, layer)
	return layer
end

local function removeLayer(layer: Layer)
	local index = table.find(layers, layer)
	if index then
		table.remove(layers, index)
	end
	if layer.Frame.Parent then
		layer.Frame:Destroy()
	end
end

-- Affiche un thème (fondu enchaîné sauf `instant`)
local function showTheme(themeId: string, reduced: boolean, instant: boolean)
	if not root then
		return
	end
	local theme = getTheme(themeId)
	local changedTheme = currentThemeId ~= theme.Id
	currentThemeId = theme.Id
	currentReduced = reduced
	currentNight = wantsNight(theme.Id)

	local previous = layers[#layers]
	local layer = buildLayer(displayTheme(theme, currentNight), reduced)

	-- L'ancien décor passe AU-DESSUS du nouveau (dans un CanvasGroup) et s'efface
	if previous and previous ~= layer then
		if instant then
			removeLayer(previous)
		else
			local group = Create("CanvasGroup", {
				Name = "FadeOut",
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				GroupTransparency = 0,
				ZIndex = 2,
				Parent = root,
			})
			previous.Frame.Parent = group
			UIUtil.Tween(group, CROSSFADE_TIME, { GroupTransparency = 1 }, Enum.EasingStyle.Sine)
			task.delay(CROSSFADE_TIME + 0.05, function()
				removeLayer(previous)
				group:Destroy()
			end)
		end
	end
	-- Les couches plus anciennes encore visibles (changements rapides) disparaissent
	for i = #layers - 2, 1, -1 do
		local old = layers[i]
		if old ~= previous then
			local parent = old.Frame.Parent
			removeLayer(old)
			if parent and parent:IsA("CanvasGroup") then
				parent:Destroy()
			end
		end
	end

	if changedTheme then
		applyDark()
		Background.ThemeChanged:Fire(theme)
	end
end

local function refresh()
	local id = equippedId()
	local reduced = isReduced()
	if id ~= currentThemeId or reduced ~= currentReduced or wantsNight(id) ~= currentNight then
		showTheme(id, reduced, false)
	end
end

-- Cible de la parallaxe (-1..1) : position de la souris, ou dérive lente (tactile)
local function parallaxTarget(clock: number): Vector2
	if UserInputService.MouseEnabled then
		local camera = workspace.CurrentCamera
		local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
		if viewport.X > 1 and viewport.Y > 1 then
			local mouse = UserInputService:GetMouseLocation()
			return Vector2.new(
				math.clamp(mouse.X / viewport.X * 2 - 1, -1, 1),
				math.clamp(mouse.Y / viewport.Y * 2 - 1, -1, 1)
			)
		end
	end
	return Vector2.new(math.sin(clock * 0.11) * 0.6, math.sin(clock * 0.07) * 0.5)
end

----------------------------------------------------------------------
-- API
----------------------------------------------------------------------

-- `parent` = calque Background de l'Interface (ou la ScreenGui en secours)
function Background.Build(parent: Instance)
	local bg = box({
		Name = "ThemeBackground",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Colors.Background,
		ClipsDescendants = true,
		ZIndex = 0, -- sous les fonds des stimuli (ZIndex >= 1)
		Parent = parent,
	})
	root = bg

	-- Lueur du Rush (invisible par défaut, au-dessus du décor)
	local rushGlow = box({
		Name = "RushGlow",
		Size = UDim2.new(1, 0, 0.45, 0),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.Colors.Yellow,
		BackgroundTransparency = 1,
		ZIndex = 50,
		Parent = bg,
	})
	Create("UIGradient", { Rotation = 90, Transparency = fadeSequence(1, 0.3), Parent = rushGlow })
	glow = rushGlow

	showTheme(equippedId(), isReduced(), true)

	-- Une seule boucle anime tout (couche actuelle + celles qui s'effacent).
	-- v8 : 30 images/s quand une fenêtre est ouverte par-dessus (le fond est
	-- alors assombri), plans de parallaxe déplacés seulement s'ils bougent,
	-- plus de copie de la liste des couches à chaque image.
	local snapshot: { Layer } = {}
	local pending = 0
	local panelCheck = 0
	local panelOpen = false
	local lastParallax = Vector2.new(math.huge, math.huge)
	RunService.Heartbeat:Connect(function(frameDt: number)
		panelCheck += frameDt
		if panelCheck >= 0.25 then
			panelCheck = 0
			local panels = bg.Parent and bg.Parent.Parent and bg.Parent.Parent:FindFirstChild("Panels")
			local overlay = panels and panels:FindFirstChild("PanelOverlay")
			panelOpen = overlay ~= nil and overlay:IsA("GuiObject") and overlay.Visible
		end
		pending += frameDt
		if panelOpen and pending < 1 / 30 then
			return
		end
		local dt = math.min(pending, 0.1)
		pending = 0
		local speed = rushActive and 1.8 or 1
		local clock = os.clock()
		-- Parallaxe lissée (désactivée si les effets sont coupés)
		local target = currentReduced and Vector2.zero or parallaxTarget(clock)
		parallax += (target - parallax) * (1 - math.exp(-2.5 * dt))
		local moved = (parallax - lastParallax).Magnitude > 0.0005
		if moved then
			lastParallax = parallax
		end

		table.clear(snapshot)
		table.move(layers, 1, #layers, 1, snapshot)
		for _, layer in ipairs(snapshot) do
			local update = layer.Update
			if update then
				layer.Time += dt * speed
				local ok, err = pcall(update, dt * speed, layer.Time)
				if not ok then
					layer.Update = nil
					warn("[Background] Animation arrêtée : " .. tostring(err))
				end
			end
			if moved or layer.Time <= dt * speed + 1e-6 then
				for _, p in ipairs(layer.Planes) do
					p.Frame.Position = UDim2.new(0.5, -parallax.X * p.Depth * PARALLAX_X, 0.5, -parallax.Y * p.Depth * PARALLAX_Y)
				end
			end
		end

		local g = glow
		if g then
			if rushActive then
				g.BackgroundTransparency = 0.55 + math.sin(clock * 3) * 0.2
			elseif g.BackgroundTransparency < 1 then
				g.BackgroundTransparency = math.min(1, g.BackgroundTransparency + 0.02)
			end
		end
	end)

	ClientState.Changed:Connect(refresh)
	ClientState.DarkSourcesChanged:Connect(refresh)
	ClientState.FeaturesChanged:Connect(applyDark)
	applyDark()
	return bg
end

function Background.SetRush(active: boolean)
	rushActive = active == true
end

-- Thème actuellement affiché (table de Config.Themes)
function Background.GetTheme(): any
	return getTheme(currentThemeId)
end

-- Vrai si le fond demande le mode sombre (thème sombre ou mode néon)
function Background.IsDark(): boolean
	return desiredDark()
end

-- Vrai si le thème ÉQUIPÉ est sombre (sans compter le mode néon)
function Background.IsThemeDark(): boolean
	local theme = getTheme(currentThemeId)
	return theme ~= nil and theme.Dark == true
end

-- Miniature animée d'un thème (le vrai décor, réduit) dans `parent`.
-- L'appelant fait avancer l'animation avec preview.Update(dt) et la
-- détruit avec preview.Destroy(). Version allégée (moins d'éléments).
function Background.BuildPreview(parent: GuiObject, themeId: string): Preview
	local theme = getTheme(themeId)
	local holder = box({
		Name = "ThemePreview",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(DESIGN.X, DESIGN.Y),
		BackgroundTransparency = 1,
		ZIndex = 2,
	})
	-- La miniature garde les vraies couleurs du thème (pas d'habillage sombre)
	holder:SetAttribute("DarkSkinIgnore", true)
	local scale = Create("UIScale", { Scale = 0.12, Parent = holder })
	local frame, update, layout, _ = buildDecor(theme, true, Random.new(7))
	frame.Parent = holder
	holder.Parent = parent
	bindLayout(frame, layout)

	-- Mise à l'échelle "couvrante" : la miniature remplit le parent
	local connections = {}
	local function fit()
		local target = parent.AbsoluteSize
		local current = holder.AbsoluteSize
		if target.X < 1 or target.Y < 1 or current.X < 1 or current.Y < 1 then
			return
		end
		local factor = math.max(target.X / current.X, target.Y / current.Y)
		if math.abs(factor - 1) > 0.002 then
			scale.Scale = math.clamp(scale.Scale * factor, 0.02, 2)
		end
	end
	table.insert(connections, parent:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit))
	-- (la taille du support n'est connue qu'après la première mise en page)
	table.insert(connections, holder:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit))
	task.defer(fit)

	local time = 0
	local alive = true
	local preview: Preview = {
		Frame = holder,
		Update = function(dt: number)
			if not alive or not update then
				return
			end
			time += dt
			local ok, err = pcall(update, dt, time)
			if not ok then
				update = nil
				warn("[Background] Aperçu arrêté : " .. tostring(err))
			end
		end,
		Destroy = function()
			alive = false
			for _, connection in ipairs(connections) do
				connection:Disconnect()
			end
			holder:Destroy()
		end,
	}
	return preview
end

return Background
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">CenterColumn</string>
            <string name="Source"><![CDATA[--[[
	CenterColumn (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > CenterColumn

	La colonne centrale, volontairement toute simple (comme au début d'un
	certain "clicker de stimulation") :
	  - le chapeau équipé (emoji) posé sur le bouton ;
	  - le bouton gris "Clique-moi" (couleurs selon le cosmétique "Skin") ;
	  - "12 345 Dopamine" (gros chiffre + unité plus discrète) puis
	    "123 Dopamine par seconde" ;
	  - la bannière du Dopamine Rush (quand il est actif) ;
	  - les indicateurs Robux : 👑 VIP, 💎 bonus des passes, ⏱️ boost avec
	    compte à rebours, 🤖 auto-clic (+ petit robot qui tape le bouton) ;
	  - les pastilles des menus (Temps d'écran, Boutique, Succès, Quêtes,
	    Classement (toujours visible), Cadeau, 🎨 Thèmes, 💎 Robux, ⚙️, et
	    🛠️ Test UNIQUEMENT dans Studio) avec badges rouges ;
	  - la jauge de combo (si la Feature "Combo" est débloquée) ;
	  - la barre d'améliorations (UpgradeBar).
	Occupe x ∈ [centre-330, centre+330], y ∈ [28, ~430] de la toile.
	v5 : textes traduits (Locale) ; sur téléphone les pastilles des menus
	sont rondes (icône seule) et tiennent sur UNE ligne (zones tactiles de
	44 px ; la ligne peut encore défiler s'il y en a trop), la largeur est limitée par les slots de côté (Slots) et tout se
	réajuste si l'écran change (Interface.DeviceChanged).
	v9 : pastilles des menus "premium" (corps en relief avec reflet et
	contour teinté, puce d'icône blanche givrée, texte bordé, ombre, badge
	DANS la pastille) : toujours sur DEUX lignes max sur PC / tablette.
	Maison : bouton rond "🏠" juste à DROITE du bouton "Click me" (ouvre
	"Ma maison"), avec un badge quand un nouvel objet de maison devient
	abordable (remis à zéro à l'ouverture) ; la carte du boost ⏱️ est à
	gauche du bouton, sous les pastilles VIP / bonus (jamais sur un slot).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Client = script.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local Interface = require(Client.Interface)
local ClientState = require(Client.ClientState)
local Effects = require(Client.Effects)
local SoundManager = require(Client.SoundManager)
local PanelManager = require(script.Parent.PanelManager)
local UpgradeBar = require(script.Parent.UpgradeBar)
local Slots = require(Client.Slots)
local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Locale = require(ReplicatedStorage.Shared.Locale)
local HouseCommon = require(script.Parent:WaitForChild("House"):WaitForChild("HouseCommon"))
local CosmeticArt = require(script.Parent.CosmeticArt) -- (v9.2) chapeaux dessinés, motifs de boutons

local CenterColumn = {}

-- Le bouton "💎 Robux" n'apparaît que si une offre est configurée (ou dans Studio)
local function robuxShopVisible(): boolean
	return Config.IsSellingForRobux == true or RunService:IsStudio()
end

-- La pastille "🛠️ Test" (panneau de test) n'existe que dans Studio
local function debugVisible(): boolean
	return RunService:IsStudio()
end

-- La pastille "🕹️ Arcade" n'apparaît que si le panneau a bien été enregistré
local function arcadeVisible(): boolean
	return PanelManager.IsRegistered("Arcade")
end

-- Pastilles des menus (Feature = nil : toujours visible ; Visible = fonction optionnelle).
-- Text : anglais, traduit à la construction (Locale.T)
local PILLS = {
	{ Id = "ScreenTime", Text = "⏱️ Screen Time", Color = Theme.Colors.Dark, Feature = "ScreenTime", Panel = "ScreenTime" },
	{ Id = "ItemShop", Text = "🛒 Shop", Color = Theme.Colors.Green, Feature = "ItemShop", Panel = "ItemShop" },
	{ Id = "Achievements", Text = "🏆 Achievements", Color = Theme.Colors.Purple, Feature = "Achievements", Panel = "Achievements" },
	{ Id = "Quests", Text = "📜 Quests", Color = Theme.Colors.Orange, Feature = "Quests", Panel = "Quests" },
	-- 🕹️ Arcade : panneau écrit à part (enregistré par ClientMain s'il existe)
	{ Id = "Arcade", Text = "🕹️ Arcade", Color = Color3.fromRGB(255, 70, 160), Feature = "Minigames", Panel = "Arcade", Visible = arcadeVisible },
	{ Id = "Leaderboard", Text = "🥇 Leaderboard", Color = Theme.Colors.Blue, Feature = nil, Panel = "Leaderboard" },
	{ Id = "Daily", Text = "🎁 Gift", Color = Theme.Colors.Pink, Feature = "Daily", Panel = "Daily" },
	{ Id = "Themes", Text = "🎨 Themes", Color = Theme.Colors.Cyan, Feature = nil, Panel = "Themes" },
	{ Id = "RobuxShop", Text = "💎 Robux", Color = Theme.Colors.Robux, Feature = nil, Panel = "RobuxShop", Visible = robuxShopVisible },
	{ Id = "Settings", Text = "⚙️", Color = Theme.Colors.ButtonBottom, Feature = nil, Panel = "Settings", Round = true },
	-- (outil de test : pastille ronde, icône seule, pour ne pas prendre de place)
	{ Id = "Debug", Text = "🛠️ Test", Color = Theme.Colors.Red, Feature = nil, Panel = "Debug", Visible = debugVisible, Round = true },
}

local BUTTON_SIZE = Vector2.new(184, 62)
local PILL_HEIGHT = 36
-- Téléphone : pastilles rondes plus grosses (≈ 34 px réels à l'écran, zone
-- tactile correcte) avec moins de marge verticale autour (la rangée ne
-- grandit que de 2 px "design")
local PHONE_PILL_HEIGHT = 52
local HOUSE_BUTTON_SIZE = 54 -- bouton "🏠" (zone tactile >= 44 px)
-- Colonne des indicateurs Robux (à gauche du bouton) : 2 pastilles + carte du
-- boost ; remontée de STATUS_LIFT px pour finir au-dessus du compteur
local STATUS_HEIGHT = 90
local STATUS_LIFT = 12
local HOUSE_GAP = 6 -- écart entre "Click me" et "🏠" (le badge "99+" reste loin du slot CR)

local random = Random.new()
local effectsLayer: Frame

local buttonHolder: Frame
local clickButton: TextButton
local clickLabel: TextLabel
local buttonGradient: UIGradient
local hatLabel: TextLabel
local robotLabel: TextLabel
local counterRow: Frame
local counterLabel: TextLabel -- le nombre
local unitLabel: TextLabel -- "Dopamine"
local counterScale: UIScale
local perSecondLabel: TextLabel
local statusLeft: Frame
local vipChip: Frame
local bonusChip: Frame
local boostCard: Frame
local boostTitle: TextLabel
local boostTimer: TextLabel
local rushBanner: Frame
local rushLabel: TextLabel
local comboBar: Frame
local comboFill: Frame
local comboLabel: TextLabel
local pills = {} -- [Id] = { Button, Holder, Badge, Def }
local pillsStack: Frame -- pile verticale qui contient la rangée des pastilles
local pillsRow: GuiObject? = nil
local pillsDevice = "" -- profil pour lequel la rangée a été construite
local houseButton: TextButton
local houseBadge: TextLabel
local houseTip: Frame
local houseSeen: { [string]: boolean } = {} -- objets abordables déjà vus (badge "🏠")
local houseBadgeCount = 0
local houseWiggleAt = 0

local seenAchievements: number? = nil -- succès déjà vus (badge "Succès")
local counterFlashUntil = 0 -- le compteur brille en doré (gros gain) jusqu'à cette heure
local counterFlashing = false
local perSecondTarget = 0 -- Dopamine / s du serveur
local perSecondShown = 0 -- valeur affichée (glisse vers la cible)
local perSecondText = ""
local perSecondDrawn = -1
local perSecondFlashUntil = 0
local perSecondFlashing = false
local perSecondScale: UIScale
local counterText = ""
local robotClock = 0
local robotFloatClock = 0
local currentSkin = ""
local currentHat = ""

----------------------------------------------------------------------
-- Utilitaires
----------------------------------------------------------------------

-- "12 345" sous le million, "1.23M" au-delà, "2.5" pour les petites décimales
local function formatAmount(value: number): string
	if value >= 1e6 then
		return NumberFormatter.Format(value)
	elseif value < 10 and value % 1 ~= 0 then
		return NumberFormatter.Format(value)
	end
	return NumberFormatter.WithSpaces(value)
end

local function countTrue(map): number
	local count = 0
	if type(map) == "table" then
		for _, value in pairs(map) do
			if value then
				count += 1
			end
		end
	end
	return count
end

----------------------------------------------------------------------
-- Cosmétiques (chapeau + couleur du bouton)
----------------------------------------------------------------------

local function applySkin(skinId: string)
	if skinId == currentSkin then
		return
	end
	currentSkin = skinId
	local skin = Config.CosmeticsById[skinId]
	if skin and skin.Top and skin.Bottom then
		buttonGradient.Color = ColorSequence.new(skin.Top, skin.Bottom)
		clickLabel.TextColor3 = Theme.ContrastText(skin.Top:Lerp(skin.Bottom, 0.5))
	else
		buttonGradient.Color = ColorSequence.new(Theme.Colors.Button, Theme.Colors.ButtonBottom)
		clickLabel.TextColor3 = Theme.Colors.Text
	end
	CosmeticArt.ApplySkin(clickButton, skin, 12, 2) -- (v9.2) motif (nil = retiré)
end

local function applyHat(hatId: string)
	if hatId == currentHat then
		return
	end
	currentHat = hatId
	local hat = Config.CosmeticsById[hatId]
	if hat then
		CosmeticArt.ApplyHat(hatLabel, hat) -- (v9.2) dessin, sinon l'emoji
		hatLabel.Visible = true
		local scale = hatLabel:FindFirstChildOfClass("UIScale")
		if scale then
			scale.Scale = 0.2
			UIUtil.Tween(scale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
		end
	else
		CosmeticArt.ApplyHat(hatLabel, nil)
		hatLabel.Visible = false
	end
end

----------------------------------------------------------------------
-- Clic sur le gros bouton
----------------------------------------------------------------------

local function onClick()
	local gain = ClientState.Click()
	if not gain then
		return
	end
	UpgradeBar.HideTooltip()

	-- Squish : on écrase le bouton puis il rebondit
	clickButton.Size = UDim2.fromScale(1.08, 0.84)
	UIUtil.Tween(clickButton, 0.4, { Size = UDim2.fromScale(1, 1) }, Enum.EasingStyle.Elastic)

	-- Le chapeau saute un peu
	if hatLabel.Visible then
		hatLabel.Position = UDim2.new(0.5, 0, 0, 6)
		UIUtil.Tween(hatLabel, 0.35, { Position = UDim2.new(0.5, 0, 0, 18) }, Enum.EasingStyle.Bounce)
	end

	-- "+X" qui s'envole près du bouton : couleur / style selon la taille du gain
	-- (combo) ; au-delà de x2,5 la valeur d'un clic : style "critique" doré
	local ratio = ClientState.GetComboMeter() / 100
	local base = tonumber(ClientState.Data and ClientState.Data.ClickValue) or gain
	local color, style = Effects.AmountStyle(gain, base, ClientState.DarkMode)
	local center = Interface.GetCanvasCenter(clickButton)
	-- De part et d'autre du bouton, montée courte : les chiffres ne passent ni
	-- sur le compteur ni sur le bandeau d'actualités
	local side = random:NextNumber() < 0.5 and -1 or 1
	local halfWidth = clickButton.AbsoluteSize.X / math.max(Interface.Scale, 0.01) / 2
	local position = UDim2.fromOffset(
		center.X + side * (halfWidth + random:NextNumber(4, 54)),
		center.Y + 2 + random:NextNumber(-10, 10)
	)
	Effects.Pop(effectsLayer, position, "+" .. formatAmount(gain), { Color = color, Size = 28 + ratio * 10, Style = style, Rise = 36 })
	Effects.Burst(effectsLayer, UDim2.fromOffset(center.X + random:NextNumber(-40, 40), center.Y), nil, 3)

	-- Son de clic choisi dans les paramètres ; il monte dans les aigus avec le combo
	SoundManager.PlayClick(0.95 + ratio * 0.6 + random:NextNumber(0, 0.08))

	counterScale.Scale = 1.08
	UIUtil.Tween(counterScale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)
end

----------------------------------------------------------------------
-- Construction
----------------------------------------------------------------------

local function buildButton(column: Frame)
	buttonHolder = UIUtil.Create("Frame", {
		Name = "ClickerHolder",
		Size = UDim2.fromOffset(BUTTON_SIZE.X, BUTTON_SIZE.Y),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 40),
		BackgroundTransparency = 1,
		Parent = column,
	})

	clickButton = UIUtil.Create("TextButton", {
		Name = "ClickButton",
		Size = UDim2.fromScale(1, 1),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1), -- couleurs données par le dégradé
		AutoButtonColor = false,
		Text = "",
		ZIndex = 2,
		Parent = buttonHolder,
	})
	UIUtil.Corner(clickButton, 12)
	UIUtil.Stroke(clickButton, Theme.Colors.Border, 1.5)
	buttonGradient = UIUtil.Gradient(clickButton, ColorSequence.new(Theme.Colors.Button, Theme.Colors.ButtonBottom), 90)
	UIUtil.Shadow(clickButton, 4, 0.8, 3)

	clickLabel = UIUtil.Label({
		Text = Locale.T("Click me"),
		Font = Theme.Fonts.Body,
		Size = UDim2.new(1, -20, 1, -16),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		ZIndex = 3,
		MaxTextSize = 28,
		Parent = clickButton,
	})

	-- Chapeau posé sur le bouton
	hatLabel = UIUtil.Label({
		Name = "Hat",
		Text = "",
		Size = UDim2.fromOffset(60, 60),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0, 18),
		Rotation = -8,
		ZIndex = 4,
		MaxTextSize = 56,
		Visible = false,
		Parent = buttonHolder,
	})
	UIUtil.Create("UIScale", { Parent = hatLabel })

	-- Petit robot (Game Pass "Auto-clic") posé sur le coin haut-gauche du bouton
	robotLabel = UIUtil.Label({
		Name = "Robot",
		Text = "🤖",
		Size = UDim2.fromOffset(34, 34),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 10, 0, 4),
		Rotation = 0,
		ZIndex = 5,
		MaxTextSize = 30,
		Visible = false,
		Parent = buttonHolder,
	})

	-- Souris ET tactile (multi-touch compris)
	clickButton.InputBegan:Connect(function(input: InputObject)
		local inputType = input.UserInputType
		if inputType == Enum.UserInputType.MouseButton1 or inputType == Enum.UserInputType.Touch then
			onClick()
		end
	end)
	-- Survol : léger grossissement
	local hoverScale = UIUtil.Create("UIScale", { Parent = buttonHolder })
	clickButton.MouseEnter:Connect(function()
		UIUtil.Tween(hoverScale, 0.15, { Scale = 1.04 }, Enum.EasingStyle.Back)
	end)
	clickButton.MouseLeave:Connect(function()
		UIUtil.Tween(hoverScale, 0.15, { Scale = 1 })
	end)
end

-- Bouton rond "🏠 Ma maison", à droite du bouton "Click me".
-- `buttonCenterX` / `buttonCenterY` : centre du bouton "Click me" dans la colonne.
local function buildHouseButton(column: Frame, buttonCenterX: number, buttonCenterY: number)
	local holder = UIUtil.Create("Frame", {
		Name = "HouseHolder",
		Size = UDim2.fromOffset(HOUSE_BUTTON_SIZE, HOUSE_BUTTON_SIZE),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromOffset(buttonCenterX + BUTTON_SIZE.X / 2 + HOUSE_GAP, buttonCenterY),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = column,
	})
	houseButton = UIUtil.PillButton({
		Name = "HouseButton",
		Text = "🏠",
		Color = HouseCommon.Colors.Pink,
		TextColor3 = Theme.Colors.TextDark,
		Height = HOUSE_BUTTON_SIZE,
		TextSize = 30,
		Round = true,
		ZIndex = 3,
		Parent = holder,
	})
	-- (v9 : bouton rose en relief avec reflet, contour rose foncé, ombre : voir UIUtil)
	houseBadge = UIUtil.Badge(houseButton, 22)
	houseBadge.Position = UDim2.new(1, -8, 0, 2)

	-- Petite bulle "Ma maison" au survol (au-dessus du bouton)
	houseTip = UIUtil.Chip({
		Name = "HouseTip",
		Text = Locale.T("🏠 My house"),
		Color = Theme.Colors.Dark,
		TextColor3 = Theme.Colors.TextLight,
		Height = 24,
		TextSize = 13,
		ZIndex = 6,
		Visible = false,
		Parent = holder,
	})
	houseTip.AnchorPoint = Vector2.new(0.5, 1)
	houseTip.Position = UDim2.new(0.5, 0, 0, -4)
	houseButton.MouseEnter:Connect(function()
		if not Interface.IsTouch() then
			houseTip.Visible = true
			UIUtil.Pop(houseTip, 0.6, 0.25)
		end
	end)
	houseButton.MouseLeave:Connect(function()
		houseTip.Visible = false
	end)

	houseButton.Activated:Connect(function()
		houseTip.Visible = false
		if not PanelManager.IsRegistered("House") then
			SoundManager.Play("Error", 0.8)
			UIUtil.Shake(houseButton)
			return
		end
		PanelManager.Toggle("House")
	end)
end

-- Badge "🏠" : objets de maison jamais achetés devenus abordables, pas encore vus
local function refreshHouseBadge(data)
	if not houseBadge then
		return
	end
	local isOpen = PanelManager.IsOpen("House")
	local count = 0
	for _, id in ipairs(HouseCommon.AffordableNew(data, ClientState.GetConfirmedDopamine())) do
		if isOpen then
			houseSeen[id] = true
		elseif not houseSeen[id] then
			count += 1
		end
	end
	houseBadgeCount = count
	UIUtil.SetBadge(houseBadge, count)
end

-- Largeur max de la rangée des pastilles (téléphone : entre les slots de côté)
local function pillsRowWidth(): number
	if Interface.IsPhone() then
		return math.clamp(Slots.GetCenterClearWidth(), 360, 664)
	end
	return 664
end

-- "🛒 Boutique" -> ("🛒", "Boutique") ; sans emoji : (nil, texte)
local function splitIcon(text: string): (string?, string)
	local first, rest = string.match(text, "^(%S+)%s+(.+)$")
	if first and rest and not string.find(first, "%w") then
		return first, rest
	end
	if not string.find(text, "%w") then
		return text, ""
	end
	return nil, text
end

--[[
	Pastille de menu v9 ("premium") : corps coloré en relief (dégradé, lèvre
	sombre en bas, reflet, contour teinté, ombre), icône dans une puce
	blanche givrée à gauche, texte bordé, badge rouge DANS la pastille à
	droite du texte (la pastille s'élargit quand il apparaît : il ne
	recouvre jamais la voisine). Ronde (icône seule) sur téléphone et pour ⚙️.
	Renvoie (bouton, badge).
]]
local function buildMenuPill(holder: Frame, def, icon: string?, label: string, height: number, round: boolean, tablet: boolean, y: number): (TextButton, TextLabel)
	local lightBody = Theme.Luminance(def.Color) > 0.75
	local textColor = lightBody and Theme.Colors.Text or Theme.Colors.TextLight
	local button = UIUtil.Create("TextButton", {
		Name = "Button",
		Size = UDim2.fromOffset(height, height),
		AutomaticSize = round and Enum.AutomaticSize.None or Enum.AutomaticSize.X,
		BackgroundColor3 = def.Color,
		AutoButtonColor = false,
		Font = Theme.Fonts.Title,
		Text = round and (icon or label) or "",
		TextColor3 = textColor,
		TextSize = math.floor(height * 0.52),
		Position = UDim2.fromOffset(0, y),
		ZIndex = 1,
		Parent = holder,
	})
	UIUtil.Corner(button, UDim.new(1, 0))
	UIUtil.DressButton(button, def.Color, { StrokeThickness = 1.5 })

	local badge: TextLabel
	if round then
		badge = UIUtil.Badge(button, 22)
	else
		button.Size = UDim2.fromOffset(0, height)
		-- (tablette : un peu plus serré pour que tout tienne sur deux lignes)
		UIUtil.Create("UIPadding", {
			PaddingLeft = UDim.new(0, tablet and 3 or 4),
			PaddingRight = UDim.new(0, tablet and 10 or 12),
			Parent = button,
		})
		-- Contenu dans son propre cadre (la liste ne doit pas placer le reflet)
		local content = UIUtil.Create("Frame", {
			Name = "Content",
			Size = UDim2.fromOffset(0, height),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundTransparency = 1,
			ZIndex = 2,
			Parent = button,
		})
		UIUtil.Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, tablet and 3 or 4),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = content,
		})
		-- Puce d'icône (disque blanc givré)
		local chipSize = height - (tablet and 16 or 12)
		local chip = UIUtil.Create("Frame", {
			Name = "IconChip",
			Size = UDim2.fromOffset(chipSize, chipSize),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = lightBody and 0.35 or 0.1,
			LayoutOrder = 1,
			ZIndex = 2,
			Parent = content,
		})
		chip:SetAttribute("DarkSkinIgnore", true)
		UIUtil.Corner(chip, UDim.new(1, 0))
		UIUtil.Stroke(chip, Color3.new(1, 1, 1), 1.5, 0.35)
		UIUtil.Gradient(chip, ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(226, 228, 236)), 90)
		UIUtil.Create("TextLabel", {
			Name = "Icon",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Font = Theme.Fonts.Body,
			Text = icon or "•",
			TextColor3 = Theme.Colors.Text,
			TextSize = math.floor(chipSize * 0.62),
			ZIndex = 3,
			Parent = chip,
		})
		local text = UIUtil.Create("TextLabel", {
			Name = "Label",
			Size = UDim2.fromOffset(0, height),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundTransparency = 1,
			Font = Theme.Fonts.Title,
			Text = label,
			TextColor3 = textColor,
			TextSize = tablet and 16 or math.floor(height * 0.45),
			LayoutOrder = 2,
			ZIndex = 2,
			Parent = content,
		})
		-- Contour du texte : lisible sur toutes les couleurs
		local stroke = UIUtil.Create("UIStroke", {
			Name = "TextStroke",
			Color = def.Color:Lerp(Color3.new(0, 0, 0), 0.55),
			Thickness = 1.2,
			Transparency = lightBody and 1 or 0.35,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
			Parent = text,
		})
		stroke:SetAttribute("DarkSkinIgnore", true)
		-- Badge rouge DANS la pastille, après le texte (la pastille s'élargit)
		badge = UIUtil.Badge(content, tablet and 16 or 18)
		badge.LayoutOrder = 3
	end
	-- Ombre portée : dans le support, même largeur que la pastille (largeur en
	-- échelle : ne change jamais la taille automatique du support)
	local shadow = UIUtil.Create("Frame", {
		Name = "PillShadow",
		Size = UDim2.new(1, 0, 0, height),
		Position = UDim2.fromOffset(0, y + 3),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.8,
		BorderSizePixel = 0,
		ZIndex = 0,
		Parent = holder,
	})
	UIUtil.Corner(shadow, UDim.new(1, 0))
	return button, badge
end

-- (Re)construit la rangée des pastilles selon l'appareil :
--   PC / tablette : lignes qui passent à la ligne (Wraps) ;
--   téléphone : UNE ligne qui défile horizontalement.
local function buildPills(parent: Frame, order: number)
	if pillsRow then
		pillsRow:Destroy()
		pillsRow = nil
	end
	table.clear(pills)
	local phone = Interface.IsPhone()
	local height = phone and PHONE_PILL_HEIGHT or (Interface.IsTouch() and Theme.TouchTarget or PILL_HEIGHT)
	-- Marge verticale du support (4 px d'air entre deux lignes de pastilles sur PC)
	local holderPad = phone and 6 or 4
	local buttonY = phone and 3 or 2
	pillsDevice = Interface.Device

	local row: GuiObject
	if phone then
		row = UIUtil.Create("ScrollingFrame", {
			Name = "Pills",
			Size = UDim2.fromOffset(pillsRowWidth(), height + holderPad),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollingDirection = Enum.ScrollingDirection.X,
			AutomaticCanvasSize = Enum.AutomaticSize.X,
			CanvasSize = UDim2.new(),
			ScrollBarThickness = 0,
			ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
			LayoutOrder = order,
			Parent = parent,
		})
		UIUtil.Create("UIPadding", {
			PaddingLeft = UDim.new(0, 6),
			PaddingRight = UDim.new(0, 6),
			Parent = row,
		})
	else
		row = UIUtil.Create("Frame", {
			Name = "Pills",
			Size = UDim2.fromOffset(664, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = order,
			Parent = parent,
		})
		if Interface.Device == "Desktop" then
			-- PC : la 1re ligne passe sous les slots CL / CR (bas à y = 210) :
			-- 8 px d'air pour qu'aucune pastille ne touche ces cartes
			UIUtil.Create("UIPadding", { PaddingTop = UDim.new(0, 8), Parent = row })
		end
	end
	pillsRow = row
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Wraps = not phone,
		Padding = UDim.new(0, phone and 10 or 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = row,
	})

	for index, def in ipairs(PILLS) do
		-- Téléphone : pastilles rondes avec l'icône seule, pour que TOUTES
		-- tiennent sur une ligne (le texte long ne tenait pas : pastille coupée
		-- au bord de la rangée). Le titre complet s'affiche dans la fenêtre.
		local round = def.Round == true or phone
		local icon, label = splitIcon(Locale.T(def.Text))
		-- Support (marge verticale entre deux lignes de pastilles)
		local holder = UIUtil.Create("Frame", {
			Name = def.Id,
			Size = UDim2.fromOffset(round and height or 0, height + holderPad),
			AutomaticSize = round and Enum.AutomaticSize.None or Enum.AutomaticSize.X,
			BackgroundTransparency = 1,
			LayoutOrder = index,
			Visible = def.Feature == nil and (def.Visible == nil or def.Visible()),
			Parent = row,
		})
		-- Tablette : texte et marges un peu plus serrés (pastilles tactiles de 44 px)
		-- pour que les 10 pastilles tiennent sur DEUX lignes (sinon la barre
		-- d'améliorations descendrait sur les emplacements du bas)
		local tablet = Interface.Device == "Tablet"
		local button, badge = buildMenuPill(holder, def, icon, label, height, round, tablet, buttonY)
		if round then
			badge.Position = UDim2.new(1, phone and -6 or -2, 0, phone and 12 or 2)
		end
		UIUtil.Create("UIScale", { Name = "PopScale", Parent = holder })

		button.Activated:Connect(function()
			if not PanelManager.IsRegistered(def.Panel) then
				SoundManager.Play("Error", 0.8)
				UIUtil.Shake(button)
				return
			end
			PanelManager.Toggle(def.Panel)
		end)
		pills[def.Id] = { Button = button, Holder = holder, Badge = badge, Def = def }
	end
	return row
end

-- Le bandeau Rush se superpose à la ligne "par seconde" (hors de la pile) :
-- il ne pousse pas la barre d'améliorations sur les emplacements du bas
local function buildRush(parent: GuiObject)
	rushBanner = UIUtil.Create("Frame", {
		Name = "RushBanner",
		Size = UDim2.fromOffset(330, 28),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundColor3 = Theme.Colors.Yellow,
		ZIndex = 2,
		Visible = false,
		Parent = parent,
	})
	UIUtil.Corner(rushBanner, UDim.new(1, 0))
	UIUtil.Stroke(rushBanner, Theme.Colors.Border, 1.5)
	UIUtil.Shadow(rushBanner, 3, 0.84, 2)
	rushLabel = UIUtil.Label({
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.TextDark,
		Size = UDim2.new(1, -16, 1, -6),
		Position = UDim2.fromOffset(8, 3),
		MaxTextSize = 18,
		Parent = rushBanner,
	})
end

local function buildCombo(parent: Frame, order: number)
	comboBar = UIUtil.Create("Frame", {
		Name = "ComboBar",
		Size = UDim2.fromOffset(300, 20),
		BackgroundColor3 = Theme.Colors.PanelLight,
		LayoutOrder = order,
		ClipsDescendants = true,
		Visible = false,
		Parent = parent,
	})
	UIUtil.Corner(comboBar, UDim.new(1, 0))
	UIUtil.Stroke(comboBar, Theme.Colors.Border, 1.5)
	comboFill = UIUtil.Create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = comboBar,
	})
	UIUtil.Corner(comboFill, UDim.new(1, 0))
	UIUtil.Gradient(comboFill, ColorSequence.new({
		ColorSequenceKeypoint.new(0, Theme.Colors.Yellow),
		ColorSequenceKeypoint.new(0.5, Theme.Colors.Orange),
		ColorSequenceKeypoint.new(1, Theme.Colors.Red),
	}), 0)
	comboLabel = UIUtil.Label({
		Text = Locale.T("COMBO %s", "x1"),
		Font = Theme.Fonts.Title,
		Size = UDim2.new(1, -10, 1, -4),
		Position = UDim2.fromOffset(5, 2),
		ZIndex = 2,
		MaxTextSize = 14,
		Parent = comboBar,
	})
end

-- Indicateurs Robux, à GAUCHE du bouton (hors de la pile : ils ne poussent
-- jamais la barre d'améliorations sur les emplacements du bas) :
-- 👑 VIP, 💎 bonus des Game Passes, puis ⏱️ boost + minuteur (petite carte).
-- Tout tient dans une colonne de 70 px entre le slot CL et le bouton, sous le
-- bandeau d'actualités et au-dessus du compteur : rien ne recouvre les slots
-- CL / CR (à droite, le bouton "🏠" touche déjà presque le slot CR).
-- `buttonCenterX` / `buttonCenterY` : centre du bouton dans la colonne.
local function buildStatus(column: Frame, buttonCenterX: number, buttonCenterY: number)
	statusLeft = UIUtil.Create("Frame", {
		Name = "StatusLeft",
		Size = UDim2.fromOffset(70, STATUS_HEIGHT),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromOffset(buttonCenterX - BUTTON_SIZE.X / 2 - 8, buttonCenterY - STATUS_LIFT),
		BackgroundTransparency = 1,
		Parent = column,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 3),
		Parent = statusLeft,
	})
	local function chip(name: string, text: string, color: Color3, textColor: Color3, chipOrder: number): Frame
		local frame = UIUtil.Chip({
			Name = name,
			Text = text,
			Color = color,
			TextColor3 = textColor,
			Height = 20,
			TextSize = 12,
			LayoutOrder = chipOrder,
			Visible = false,
			Parent = statusLeft,
		})
		-- (relief : dégradé déjà posé par UIUtil.Chip)
		UIUtil.Create("UIScale", { Name = "PopScale", Parent = frame })
		return frame
	end
	vipChip = chip("VIP", "👑 VIP", Theme.Colors.Premium, Theme.Colors.TextDark, 1)
	bonusChip = chip("Bonus", "💎 x1", Theme.Colors.Purple, Theme.Colors.TextLight, 2)

	-- Carte du boost : "⏱️ x2" + minuteur (sous les pastilles, dans la même colonne)
	boostCard = UIUtil.Create("Frame", {
		Name = "Boost",
		Size = UDim2.fromOffset(62, 38),
		BackgroundColor3 = Theme.Colors.Boost,
		LayoutOrder = 3,
		Visible = false,
		Parent = statusLeft,
	})
	UIUtil.Corner(boostCard, Theme.Radius.S)
	UIUtil.Stroke(boostCard, Theme.Colors.Border, 1.5, 0.3)
	UIUtil.Gradient(boostCard, ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(215, 215, 215)), 90)
	UIUtil.Create("UIScale", { Name = "PopScale", Parent = boostCard })
	boostTitle = UIUtil.Label({
		Text = "⏱️ x2",
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.TextLight,
		Size = UDim2.new(1, -8, 0, 17),
		Position = UDim2.fromOffset(4, 3),
		MaxTextSize = 14,
		ZIndex = 2,
		Parent = boostCard,
	})
	boostTimer = UIUtil.Label({
		Text = "0:00",
		Font = Theme.Fonts.Number,
		TextColor3 = Theme.Colors.TextLight,
		Size = UDim2.new(1, -8, 0, 15),
		Position = UDim2.fromOffset(4, 20),
		MaxTextSize = 13,
		ZIndex = 2,
		Parent = boostCard,
	})
	for _, label in ipairs({ boostTitle, boostTimer }) do
		local stroke = UIUtil.Stroke(label, Color3.fromRGB(120, 40, 0), 1, 0.5)
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	end
end

local function chipText(frame: Frame, text: string)
	local label = frame:FindFirstChild("Label") :: TextLabel?
	if label and label.Text ~= text then
		label.Text = text
	end
end

-- Montre / cache un indicateur (avec un petit "pop" à l'apparition)
local function setChipVisible(frame: GuiObject, visible: boolean)
	if frame.Visible == visible then
		return
	end
	frame.Visible = visible
	if visible then
		UIUtil.Pop(frame, 0.3, 0.4)
	end
end

-- Mise à jour des indicateurs + animation du robot (à chaque image)
local function updateStatus(dt: number)
	local data = ClientState.Data
	if not data then
		return
	end

	setChipVisible(vipChip, ClientState.IsVIP())

	local passMultiplier = ClientState.GetPassMultiplier()
	setChipVisible(bonusChip, passMultiplier > 1.001)
	if bonusChip.Visible then
		chipText(bonusChip, "💎 " .. NumberFormatter.Multiplier(passMultiplier))
	end

	local boostMultiplier, remaining = ClientState.GetBoost()
	setChipVisible(boostCard, remaining > 0)
	if remaining > 0 then
		local title = "⏱️ " .. NumberFormatter.Multiplier(boostMultiplier)
		if boostTitle.Text ~= title then
			boostTitle.Text = title
		end
		local clock = UIUtil.FormatClock(remaining)
		if boostTimer.Text ~= clock then
			boostTimer.Text = clock
		end
		-- Pulsation douce (plus rapide dans la dernière minute)
		local speed = remaining < 60 and 9 or 3
		boostCard.Rotation = math.sin(os.clock() * speed) * 3
	end

	-- Auto-clic (Game Pass) : petit robot qui tape le coin du bouton
	local hasAuto = ClientState.HasPass("AutoClick")
	if robotLabel.Visible ~= hasAuto then
		robotLabel.Visible = hasAuto
		if hasAuto then
			UIUtil.Pop(robotLabel, 0.2, 0.5)
		end
	end
	if hasAuto then
		local autoPass = Config.GamePassesById.AutoClick
		local rate = (autoPass and tonumber(autoPass.AutoClicksPerSecond)) or 1
		robotClock += dt * rate
		-- Petit coup de tête à chaque "clic" du robot
		local phase = robotClock % 1
		robotLabel.Rotation = phase < 0.35 and 18 * math.sin(phase / 0.35 * math.pi) or 0
		-- Toutes les secondes : "+X" discret (gain approximatif des clics auto)
		robotFloatClock += dt
		if robotFloatClock >= 1 then
			robotFloatClock = 0
			local gain = (tonumber(data.ClickValue) or 0) * rate
			if gain > 0 and effectsLayer then
				local center = Interface.GetCanvasCenter(robotLabel)
				Effects.FloatingText(effectsLayer, UDim2.fromOffset(center.X - 6, center.Y - 16), "+" .. formatAmount(gain), Theme.Colors.Cyan, 18)
			end
		end
	end
end

-- Gros gain (bonus, jackpot, achat...) : le compteur grossit et brille
local function counterCelebrate(strength: number)
	counterScale.Scale = 1 + 0.08 * strength
	UIUtil.Tween(counterScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Elastic)
	counterFlashUntil = os.clock() + 0.8
end

----------------------------------------------------------------------
-- Mises à jour
----------------------------------------------------------------------

local function applyDarkMode(dark: boolean)
	local textColor = dark and Theme.DarkColors.Text or Theme.Colors.Text
	local dimColor = dark and Theme.DarkColors.TextDim or Theme.Colors.TextDim
	counterLabel.TextColor3 = textColor
	unitLabel.TextColor3 = dimColor
	perSecondLabel.TextColor3 = dimColor
	for _, label in ipairs({ counterLabel, unitLabel }) do
		local counterStroke = label:FindFirstChild("DarkStroke") :: UIStroke?
		if counterStroke then
			counterStroke.Enabled = dark
		end
	end
	local perSecondStroke = perSecondLabel:FindFirstChild("DarkStroke") :: UIStroke?
	if perSecondStroke then
		perSecondStroke.Enabled = dark
	end
end

local function refreshPills(instant: boolean?)
	local skipPop = instant == true
	for _, pill in pairs(pills) do
		local feature = pill.Def.Feature
		local shouldShow = (feature == nil or ClientState.HasFeature(feature))
			and (pill.Def.Visible == nil or pill.Def.Visible())
		if shouldShow and not pill.Holder.Visible then
			pill.Holder.Visible = true
			local scale = pill.Holder:FindFirstChild("PopScale") :: UIScale?
			if scale and not skipPop then
				scale.Scale = 0.2
				UIUtil.Tween(scale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
			end
		elseif not shouldShow and pill.Holder.Visible then
			pill.Holder.Visible = false
			if PanelManager.IsOpen(pill.Def.Panel) then
				PanelManager.Close()
			end
		end
	end
end

local function refreshBadges()
	local data = ClientState.Data
	if not data then
		return
	end

	-- Boutique : objets pas encore possédés qu'on peut se payer
	local shop = pills.ItemShop
	if shop then
		local owned = (data.Cosmetics and data.Cosmetics.Owned) or {}
		local dopamine = ClientState.GetConfirmedDopamine()
		local affordable = 0
		for _, cosmetic in ipairs(Config.Cosmetics) do
			local unlocked = (tonumber(cosmetic.RequiresRebirths) or 0) <= (tonumber(data.Rebirths) or 0)
			if unlocked and not owned[cosmetic.Id] and dopamine >= cosmetic.Cost then
				affordable += 1
			end
		end
		UIUtil.SetBadge(shop.Badge, affordable)
	end

	-- Succès : débloqués depuis la dernière ouverture du menu
	local achievements = pills.Achievements
	if achievements then
		local count = countTrue(data.Achievements)
		if seenAchievements == nil or PanelManager.IsOpen("Achievements") then
			seenAchievements = count
		end
		UIUtil.SetBadge(achievements.Badge, math.max(0, count - (seenAchievements or count)))
	end

	-- Cadeau : disponible ?
	local daily = pills.Daily
	if daily then
		UIUtil.SetBadge(daily.Badge, (data.Daily and data.Daily.Available) and "!" or "")
	end

	-- Classement : couronne quand tu es 1er du serveur (au moins 2 joueurs)
	local leaderboard = pills.Leaderboard
	if leaderboard then
		local rank, count = ClientState.GetServerRank()
		UIUtil.SetBadge(leaderboard.Badge, (rank == 1 and count >= 2) and "👑" or "")
	end

	-- Maison : nouveaux objets abordables
	refreshHouseBadge(data)

	-- Thèmes : thèmes achetables en Dopamine, pas encore possédés, qu'on peut se payer
	local themes = pills.Themes
	if themes then
		local owned = (type(data.Themes) == "table" and data.Themes.Owned) or {}
		local dopamine = ClientState.GetConfirmedDopamine()
		local affordable = 0
		for _, theme in ipairs(Config.Themes) do
			local cost = tonumber(theme.Cost)
			if cost and cost > 0 and not owned[theme.Id] and dopamine >= cost then
				affordable += 1
			end
		end
		UIUtil.SetBadge(themes.Badge, affordable)
	end
end

local function onState(data)
	-- Dopamine / s : la ligne glisse vers la nouvelle valeur (voir RenderStepped)
	local perSecond = tonumber(data.PerSecond) or 0
	if perSecond > perSecondTarget * 1.0005 and perSecondTarget > 0 then
		perSecondFlashUntil = os.clock() + 0.9 -- hausse : la ligne passe au vert un instant
		perSecondScale.Scale = 1.08
		UIUtil.Tween(perSecondScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	if perSecondTarget <= 0 or perSecond < perSecondTarget then
		perSecondShown = perSecond -- baisse (océan) ou 1er état : tout de suite
	end
	perSecondTarget = perSecond
	comboBar.Visible = data.ComboEnabled == true
	local equipped = data.Cosmetics and data.Cosmetics.Equipped
	applySkin((equipped and equipped.Skin) or "")
	applyHat((equipped and equipped.Hat) or "")
	refreshBadges()
end

----------------------------------------------------------------------
-- API
----------------------------------------------------------------------

-- `parent` = calque Main ; `floatingLayer` = calque au-dessus des stimuli
-- (infobulle) ; `fxLayer` = calque des effets
function CenterColumn.Build(parent: Frame, floatingLayer: Frame, fxLayer: Frame)
	effectsLayer = fxLayer

	local column = UIUtil.Create("Frame", {
		Name = "CenterColumn",
		Size = UDim2.fromOffset(700, 410),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 24),
		BackgroundTransparency = 1,
		Parent = parent,
	})

	buildButton(column)
	buildHouseButton(column, 350, 40 + BUTTON_SIZE.Y / 2)
	buildStatus(column, 350, 40 + BUTTON_SIZE.Y / 2)

	-- Pile verticale sous le bouton (les éléments cachés ne prennent pas de place)
	local stack = UIUtil.Create("Frame", {
		Name = "Stack",
		Size = UDim2.new(1, 0, 1, -(40 + BUTTON_SIZE.Y + 4)),
		Position = UDim2.fromOffset(0, 40 + BUTTON_SIZE.Y + 4),
		BackgroundTransparency = 1,
		Parent = column,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 3), -- tout doit tenir au-dessus des emplacements du bas (y <= 425)
		Parent = stack,
	})

	-- Compteur : gros nombre + unité plus discrète, alignés sur la même ligne
	counterRow = UIUtil.Create("Frame", {
		Name = "Counter",
		Size = UDim2.fromOffset(620, 46),
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = stack,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		Parent = counterRow,
	})
	counterScale = UIUtil.Create("UIScale", { Parent = counterRow })
	counterLabel = UIUtil.Create("TextLabel", {
		Name = "Number",
		Size = UDim2.fromOffset(0, 46),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Number,
		Text = "0",
		TextColor3 = Theme.Colors.Text,
		TextSize = Theme.TextSize.Display,
		TextYAlignment = Enum.TextYAlignment.Bottom,
		LayoutOrder = 1,
		Parent = counterRow,
	})
	unitLabel = UIUtil.Create("TextLabel", {
		Name = "Unit",
		Size = UDim2.fromOffset(0, 40),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = "Dopamine",
		TextColor3 = Theme.Colors.TextDim,
		TextSize = 24,
		TextYAlignment = Enum.TextYAlignment.Bottom,
		LayoutOrder = 2,
		Parent = counterRow,
	})
	for _, label in ipairs({ counterLabel, unitLabel }) do
		local counterStroke = UIUtil.Stroke(label, Theme.Colors.TextDark, 2, 0.3)
		counterStroke.Name = "DarkStroke"
		counterStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		counterStroke.Enabled = false
	end

	perSecondLabel = UIUtil.Label({
		Name = "PerSecond",
		Text = Locale.T("%s Dopamine per second", "0"),
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.fromOffset(320, 22),
		LayoutOrder = 2,
		MaxTextSize = 21,
		Parent = stack,
	})
	perSecondScale = UIUtil.Create("UIScale", { Parent = perSecondLabel })
	local perSecondStroke = UIUtil.Stroke(perSecondLabel, Theme.Colors.TextDark, 1.5, 0.4)
	perSecondStroke.Name = "DarkStroke"
	perSecondStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	perSecondStroke.Enabled = false

	buildRush(perSecondLabel)
	pillsStack = stack
	buildPills(stack, 5)
	buildCombo(stack, 6)
	local upgradeBar = UpgradeBar.Build(stack, floatingLayer)
	upgradeBar.LayoutOrder = 7

	-- Signaux
	ClientState.Changed:Connect(onState)
	ClientState.NotifyReceived:Connect(function(payload)
		local kind = payload.Type
		if kind == "Purchase" or kind == "Jackpot" then
			counterCelebrate(2)
		elseif kind == "Bonus" or kind == "Quest" or kind == "Achievement" then
			counterCelebrate(1)
		end
	end)
	ClientState.FeaturesChanged:Connect(function()
		refreshPills()
	end)
	ClientState.DarkModeChanged:Connect(applyDarkMode)
	applyDarkMode(ClientState.DarkMode)
	PanelManager.Opened:Connect(function(name: string)
		if name == "House" and ClientState.Data then
			refreshHouseBadge(ClientState.Data)
		end
		if name == "Achievements" and ClientState.Data then
			seenAchievements = countTrue(ClientState.Data.Achievements)
			local pill = pills.Achievements
			if pill then
				UIUtil.SetBadge(pill.Badge, 0)
			end
		end
	end)

	-- Compteur lissé, jauge de combo, Rush : à chaque image
	local badgeClock = 0
	RunService.RenderStepped:Connect(function(dt: number)
		local shownText = formatAmount(ClientState.UpdateDisplay(dt))
		if shownText ~= counterText then
			counterText = shownText
			counterLabel.Text = shownText
		end
		-- Ligne "par seconde" : glisse vers la nouvelle valeur (texte changé seulement si besoin)
		if perSecondShown ~= perSecondTarget then
			perSecondShown += (perSecondTarget - perSecondShown) * (1 - math.exp(-8 * dt))
			if math.abs(perSecondTarget - perSecondShown) <= math.max(0.01, perSecondTarget * 0.001) then
				perSecondShown = perSecondTarget
			end
		end
		if perSecondShown ~= perSecondDrawn then
			perSecondDrawn = perSecondShown
			local rateText = Locale.T("%s Dopamine per second", formatAmount(perSecondShown))
			if rateText ~= perSecondText then
				perSecondText = rateText
				perSecondLabel.Text = rateText
			end
		end
		local rateFlash = os.clock() < perSecondFlashUntil
		if rateFlash or perSecondFlashing then
			local dim = ClientState.DarkMode and Theme.DarkColors.TextDim or Theme.Colors.TextDim
			local k = rateFlash and math.clamp((perSecondFlashUntil - os.clock()) / 0.9, 0, 1) or 0
			perSecondLabel.TextColor3 = dim:Lerp(Theme.Colors.RobuxDark, k)
			perSecondFlashing = rateFlash
		end
		-- Gros gain : le nombre brille en doré un instant
		local flashing = os.clock() < counterFlashUntil
		if flashing or counterFlashing then
			local base = ClientState.DarkMode and Theme.DarkColors.Text or Theme.Colors.Text
			local t = flashing and math.clamp((counterFlashUntil - os.clock()) / 0.8, 0, 1) or 0
			counterLabel.TextColor3 = base:Lerp(Theme.Colors.Gold, t)
			counterFlashing = flashing
		end

		updateStatus(dt)

		if comboBar.Visible then
			local meter = ClientState.GetComboMeter()
			comboFill.Size = UDim2.fromScale(meter / 100, 1)
			comboLabel.Text = Locale.T("COMBO %s", NumberFormatter.Multiplier(Formulas.GetComboMultiplier(meter)))
			comboBar.Rotation = meter >= 99.5 and math.sin(os.clock() * 30) * 1.5 or 0
		end

		local rush = ClientState.Rush
		local remaining = (rush.EndsAt or 0) - workspace:GetServerTimeNow()
		local active = rush.Active == true and remaining > 0
		if rushBanner.Visible ~= active then
			rushBanner.Visible = active
		end
		if active then
			rushLabel.Text = string.format(
				"⚡ %s x%s — %ds",
				Locale.T(tostring(rush.Name or "RUSH")),
				tostring(rush.Multiplier or 2),
				math.ceil(remaining)
			)
			rushBanner.Rotation = math.sin(os.clock() * 8) * 1.5
		end

		-- Bouton "🏠" : petit sautillement quand un nouvel objet est abordable
		if houseBadgeCount > 0 and os.clock() >= houseWiggleAt then
			houseWiggleAt = os.clock() + 4
			houseButton.Rotation = -12
			UIUtil.Tween(houseButton, 0.6, { Rotation = 0 }, Enum.EasingStyle.Elastic)
		end

		-- Badges (4 fois par seconde : la Dopamine monte en continu)
		badgeClock += dt
		if badgeClock >= 0.25 then
			badgeClock = 0
			refreshBadges()
		end
	end)

	-- Petit rappel tant que le joueur n'a jamais cliqué
	task.spawn(function()
		while buttonHolder.Parent do
			local data = ClientState.Data
			if data and data.Stats and (data.Stats.TotalClicks or 0) == 0 then
				UIUtil.Tween(buttonHolder, 0.25, { Rotation = 5 }, Enum.EasingStyle.Sine)
				task.wait(0.25)
				UIUtil.Tween(buttonHolder, 0.25, { Rotation = -5 }, Enum.EasingStyle.Sine)
				task.wait(0.25)
				UIUtil.Tween(buttonHolder, 0.25, { Rotation = 0 }, Enum.EasingStyle.Sine)
			end
			task.wait(2)
		end
	end)

	-- Écran qui change (téléphone <-> tablette, rotation) : pastilles et largeurs
	local function relayout()
		if Interface.Device ~= pillsDevice then
			buildPills(pillsStack, 5)
			refreshPills(true)
			refreshBadges()
		elseif pillsRow and pillsRow:IsA("ScrollingFrame") then
			local row = pillsRow :: ScrollingFrame
			row.Size = UDim2.fromOffset(pillsRowWidth(), row.Size.Y.Offset)
		end
	end
	Interface.DeviceChanged:Connect(relayout)
	Slots.Changed:Connect(relayout)

	if ClientState.Data then
		onState(ClientState.Data)
		refreshPills()
	end
	return column
end

return CenterColumn
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">CosmeticArt</string>
            <string name="Source"><![CDATA[--[[
	CosmeticArt (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > CosmeticArt

	(v9.2) Dessins des chapeaux et des motifs de boutons "cool" de la
	boutique d'objets (Config.Cosmetics) — uniquement des Frames, même style
	"autocollant" que la maison (boîte à outils de HouseArt) :
	  - chapeaux : casquette à l'envers, bandeau de ninja, casque gamer,
	    chapeau de pirate, casque de course, casque de viking, capuche de
	    dino, visière de robot (les autres chapeaux gardent leur emoji) ;
	  - motifs de boutons (cosmetic.Pattern) posés par-dessus le dégradé
	    Top -> Bottom : Carbon, Camo, Basketball, Controller, Flames, Lava,
	    Galaxy, Circuit. Positions en fractions : le motif s'adapte à la
	    taille du bouton (gros bouton, aperçu, pastille de la boutique).
	Rien n'est animé (aucune boucle) : quelques dizaines de Frames au plus.

	API :
	  CosmeticArt.HasHat(id) -> boolean
	  CosmeticArt.ApplyHat(label, cosmetic?) -> boolean
	      dessine le chapeau dans `label` (TextLabel carré du chapeau) et
	      vide son texte ; sinon remet l'emoji (cosmetic.Icon, "" si nil)
	  CosmeticArt.ApplySkin(button, cosmetic?, radius?, zIndex?)
	      pose (ou retire) le motif du bouton (enfant "SkinArt" découpé aux
	      coins arrondis du bouton, sous son texte)
]]

local Components = script.Parent
local HouseArt = require(Components:WaitForChild("House"):WaitForChild("HouseArt"))

local CosmeticArt = {}

local rgb = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)
local DARK = rgb(44, 46, 64)
local DARKER = rgb(30, 32, 46)
local CYAN = rgb(60, 222, 255)
local MAGENTA = rgb(255, 84, 196)
local LIME = rgb(140, 240, 110)
local RED = rgb(236, 66, 76)
local ORANGE = rgb(255, 152, 56)
local YELLOW = rgb(255, 214, 80)
local STEEL = rgb(176, 186, 206)
local GOLD = rgb(245, 190, 60)

----------------------------------------------------------------------
-- Chapeaux (boîte 100 x 100, le bas du chapeau vers y = 92)
----------------------------------------------------------------------

local HATS: { [string]: (body: Frame, kit: any) -> () } = {}

-- Casquette portée à l'envers (visière vers l'arrière, fermeture devant)
HATS.Snapback = function(body, kit)
	local navy = rgb(60, 80, 150)
	kit.Part(body, 60, 70, 36, 12, RED, { Radius = 6, Z = 1, Rotation = 10, Shine = true }) -- visière (derrière)
	local dome = kit.Part(body, 14, 36, 70, 54, navy, { Radius = 28, Z = 2, Shine = true })
	kit.Box(dome, 34, 4, 2, 48, kit.Lighten(navy, 0.25), 0.3, 2) -- couture
	kit.Circle(dome, 35, 3, 8, 6, RED, 0, 3) -- bouton
	-- ouverture réglable à l'avant
	local gap = kit.Part(body, 22, 72, 22, 14, rgb(255, 220, 196), { Radius = 7, Z = 3 })
	kit.Box(gap, 3, 2, 16, 3, WHITE, 0, 2)
	kit.Part(body, 10, 84, 80, 8, kit.Darken(navy, 0.2), { Radius = 4, Z = 3 })
	kit.Sparkle(dome, 50, 22, 12, YELLOW, 0, 3)
end

-- Bandeau de ninja (plaque en métal + rubans qui flottent)
HATS.NinjaBand = function(body, kit)
	for index, spec in ipairs({ { 70, 66, 28, -24 }, { 72, 76, 24, 16 } }) do
		kit.Part(body, spec[1], spec[2], spec[3], 9, RED, { Radius = 4, Z = 1, Rotation = spec[4] })
		local _ = index
	end
	local band = kit.Part(body, 6, 64, 88, 22, RED, { Radius = 11, Z = 2, Shine = true })
	kit.Box(band, 6, 16, 76, 2, kit.Darken(RED, 0.25), 0.2, 2)
	local plate = kit.Part(body, 30, 60, 40, 30, STEEL, { Radius = 6, Z = 3, Shine = true })
	-- étoile de ninja gravée
	kit.Diamond(plate, 20, 15, 10, DARK, 0, 2)
	kit.Box(plate, 11, 13.5, 18, 3, DARK, 0, 2)
	kit.Box(plate, 18.5, 6, 3, 18, DARK, 0, 2)
	kit.Circle(plate, 20, 15, 4, 4, STEEL, 0, 3)
	for _, x in ipairs({ 4, 36 }) do
		kit.Circle(plate, x, 5, 3, 3, DARK, 0.2, 2)
		kit.Circle(plate, x, 25, 3, 3, DARK, 0.2, 2)
	end
end

-- Casque gamer (arceau, oreillettes RGB, micro)
HATS.GamerHeadset = function(body, kit)
	local clip = kit.Group(body, 8, 20, 84, 50, 1, true)
	-- arceau clair (lisible sur les boutons sombres) + coussinet
	kit.Part(clip, 4, 4, 76, 90, WHITE, { Radius = -1, T = 1, Outline = rgb(230, 236, 250), Thickness = 9, Shade = false })
	local pad = kit.Part(body, 30, 20, 40, 12, MAGENTA, { Radius = 6, Z = 2, Shine = true })
	kit.Box(pad, 8, 4, 24, 3, CYAN, 0.1, 2)
	for index, side in ipairs({ -1, 1 }) do
		local cx = 50 + side * 38
		local color = index == 1 and CYAN or MAGENTA
		kit.Blob(body, cx, 70, 30, 38, color, { Z = 2, Outline = false, Shade = false, T = 0.55 })
		local cup = kit.Blob(body, cx, 70, 24, 32, rgb(236, 240, 250), { Z = 3, Shine = true })
		kit.Blob(cup, 12, 16, 14, 20, DARKER, { Z = 2, Outline = color, Thickness = 2.5, Shade = false })
	end
	kit.Line(body, 16, 80, 34, 92, 3, DARK, 0, 4)
	kit.Blob(body, 36, 92, 9, 7, DARKER, { Z = 5 })
	kit.Circle(body, 36, 92, 4, 4, LIME, 0, 6)
end

-- Chapeau de pirate (tricorne noir, galon doré, tête de mort mignonne, plume)
HATS.PirateHat = function(body, kit)
	local black = rgb(46, 42, 58)
	kit.Part(body, 60, 18, 12, 40, rgb(240, 90, 110), { Radius = 6, Z = 1, Rotation = 30 }) -- plume
	local crown = kit.Part(body, 22, 30, 56, 44, black, { Radius = 20, Z = 2, Shine = true })
	local _ = crown
	local brim = kit.Part(body, 2, 62, 96, 26, black, { Radius = 13, Z = 3, Shine = true })
	kit.Stroke(brim, GOLD, 3, 0)
	for _, side in ipairs({ -1, 1 }) do
		kit.Part(body, 50 + side * 38 - 9, 50, 18, 26, black, { Radius = 9, Z = 3, Rotation = side * 30 })
	end
	local skull = kit.Blob(body, 50, 56, 22, 20, WHITE, { Z = 4 })
	kit.Circle(skull, 7, 9, 5, 5, black, 0, 2)
	kit.Circle(skull, 15, 9, 5, 5, black, 0, 2)
	kit.Box(skull, 8, 15, 6, 2, black, 0, 2)
	kit.Line(body, 38, 70, 62, 78, 3, WHITE, 0, 4)
	kit.Line(body, 62, 70, 38, 78, 3, WHITE, 0, 4)
end

-- Casque de course (intégral rouge, bandes blanches, visière fumée)
HATS.RacingHelmet = function(body, kit)
	local helmet = kit.Part(body, 10, 18, 80, 74, RED, { Radius = 36, Z = 1, Shine = true })
	kit.Box(helmet, 34, 2, 5, 70, WHITE, 0, 2)
	kit.Box(helmet, 42, 2, 5, 70, WHITE, 0, 2)
	local visor = kit.Part(body, 36, 42, 54, 26, DARKER, { Radius = 12, Z = 2 })
	kit.Gradient(visor, rgb(90, 110, 180), rgb(20, 20, 40), 90)
	kit.Shine(visor, 8, 5, 20, 5, 3, 0.35)
	kit.Part(body, 14, 80, 72, 12, DARKER, { Radius = 6, Z = 3 })
	local plate = kit.Blob(body, 26, 50, 22, 18, WHITE, { Z = 3 })
	kit.Text(plate, "7", 11, 9, 14, RED, 2)
end

-- Casque de viking (dôme gris, bandeau doré à rivets, cornes)
HATS.VikingHelmet = function(body, kit)
	local horn = rgb(250, 240, 214)
	local hornDark = rgb(226, 206, 170)
	for _, side in ipairs({ -1, 1 }) do
		-- corne qui s'affine en remontant vers l'extérieur
		kit.Blob(body, 50 + side * 34, 62, 22, 18, horn, { Z = 1, Rotation = side * 20 })
		kit.Blob(body, 50 + side * 42, 48, 16, 20, horn, { Z = 1, Rotation = side * 25 })
		kit.Blob(body, 50 + side * 45, 35, 11, 16, horn, { Z = 1, Rotation = side * 15 })
		kit.Triangle(body, 50 + side * 45, 18, 10, 14, horn, 1)
		kit.Box(body, 50 + side * 36 - 6, 56, 12, 3, hornDark, 0.2, 2)
	end
	local dome = kit.Part(body, 14, 30, 72, 60, STEEL, { Radius = 32, Z = 2, Shine = true })
	kit.Box(dome, 33, 4, 6, 54, GOLD, 0, 2)
	local band = kit.Part(body, 10, 76, 80, 14, GOLD, { Radius = 5, Z = 3, Shine = true })
	for index = 0, 5 do
		kit.Circle(band, 8 + index * 12.8, 7, 4, 4, rgb(200, 150, 50), 0, 2)
	end
	kit.Part(body, 45, 76, 10, 20, STEEL, { Radius = 3, Z = 4 }) -- nasal
end

-- Capuche de dino (verte, piques orange, dents, yeux)
HATS.DinoHood = function(body, kit)
	local green = rgb(120, 200, 110)
	for index = 0, 3 do
		kit.Triangle(body, 30 + index * 13, 10 + math.abs(index - 1.5) * 5, 14, 16, ORANGE, 1)
	end
	local hood = kit.Part(body, 12, 22, 76, 66, green, { Radius = 32, Z = 2, Shine = true })
	kit.Face(hood, 38, 26, 30, { Eyes = "big", Mouth = "none", Z = 3 })
	for index = 0, 6 do
		kit.TriangleDown(body, 20 + index * 10, 80, 8, 8, WHITE, 3) -- dents
	end
	kit.Part(body, 12, 78, 76, 6, kit.Darken(green, 0.2), { Radius = 3, Z = 3 })
	for _, x in ipairs({ 24, 76 }) do
		kit.Circle(body, x, 60, 8, 6, kit.Darken(green, 0.15), 0.2, 3) -- écailles
	end
end

-- Visière de robot (bandeau métal, visière lumineuse, antenne)
HATS.RobotVisor = function(body, kit)
	kit.Line(body, 50, 44, 50, 16, 3, STEEL, 0, 1)
	kit.Circle(body, 50, 14, 12, 12, RED, 0.5, 1)
	kit.Circle(body, 50, 14, 8, 8, RED, 0, 2)
	local band = kit.Part(body, 6, 44, 88, 44, STEEL, { Radius = 16, Z = 2, Shine = true })
	local visor = kit.Part(band, 8, 12, 72, 16, DARKER, { Radius = 8, Z = 2 })
	local glow = kit.Box(visor, 6, 5, 60, 6, CYAN, 0, 2)
	kit.Round(glow)
	for _, x in ipairs({ 22, 50 }) do
		kit.Box(visor, x, 4, 8, 8, WHITE, 0.2, 3)
	end
	for _, x in ipairs({ 4, 80 }) do
		kit.Circle(band, x, 22, 6, 6, DARK, 0, 3)
	end
	kit.Box(band, 10, 34, 68, 2, DARK, 0.4, 2)
end

function CosmeticArt.HasHat(id: string): boolean
	return HATS[id] ~= nil
end

-- Dessine le chapeau dans `label` (ou remet l'emoji) ; renvoie true si dessiné
function CosmeticArt.ApplyHat(label: GuiObject, cosmetic: any?): boolean
	local old = label:FindFirstChild("HatArt")
	if old then
		old:Destroy()
	end
	local painter = cosmetic and HATS[cosmetic.Id]
	local textLabel = label:IsA("TextLabel") and label or nil
	if not painter then
		if textLabel then
			textLabel.Text = cosmetic and tostring(cosmetic.Icon or "") or ""
		end
		return false
	end
	if textLabel then
		textLabel.Text = ""
	end
	local size = math.min(label.Size.X.Offset, label.Size.Y.Offset)
	if size <= 0 then
		size = math.min(label.AbsoluteSize.X, label.AbsoluteSize.Y)
	end
	if size <= 0 then
		size = 60
	end
	local body = Instance.new("Frame")
	body.Name = "HatArt"
	body.BackgroundTransparency = 1
	body.AnchorPoint = Vector2.new(0.5, 0.5)
	body.Position = UDim2.fromScale(0.5, 0.5)
	body.Size = UDim2.fromOffset(100, 100)
	body.ZIndex = label.ZIndex
	local scale = Instance.new("UIScale")
	scale.Scale = size / 100 * 1.2 -- (un peu plus grand qu'un emoji : les dessins ont des marges)
	scale.Parent = body
	local kit = HouseArt.NewKit(true)
	local ok, err = pcall(painter, body, kit)
	if not ok then
		warn("[CosmeticArt] Chapeau " .. tostring(cosmetic.Id) .. " : " .. tostring(err))
		body:Destroy()
		if textLabel then
			textLabel.Text = tostring(cosmetic.Icon or "")
		end
		return false
	end
	body.Parent = label
	return true
end

----------------------------------------------------------------------
-- Motifs des boutons (fractions de la taille du bouton)
----------------------------------------------------------------------

local function frame(parent: Instance, x: number, y: number, w: number, h: number, color: Color3, t: number?, z: number?): Frame
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.BackgroundColor3 = color
	f.BackgroundTransparency = t or 0
	f.Position = UDim2.fromScale(x, y)
	f.Size = UDim2.fromScale(w, h)
	f.ZIndex = z or 1
	f.Parent = parent
	return f
end

local function roundify(f: GuiObject, radius: UDim?)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = radius or UDim.new(1, 0)
	corner.Parent = f
end

-- Ovale centré (cx, cy), tourné
local function oval(parent: Instance, cx: number, cy: number, w: number, h: number, color: Color3, t: number?, rotation: number?, z: number?): Frame
	local f = frame(parent, cx, cy, w, h, color, t, z)
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Rotation = rotation or 0
	roundify(f)
	return f
end

-- Petit disque qui reste rond (largeur = hauteur en px)
local function dot(parent: Instance, cx: number, cy: number, h: number, color: Color3, t: number?, z: number?): Frame
	local f = frame(parent, cx, cy, h, h, color, t, z)
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.SizeConstraint = Enum.SizeConstraint.RelativeYY
	roundify(f)
	return f
end

local function ringOval(parent: Instance, cx: number, cy: number, w: number, h: number, color: Color3, thick: number, t: number?): Frame
	local f = oval(parent, cx, cy, w, h, color, 1)
	local line = Instance.new("UIStroke")
	line.Color = color
	line.Thickness = thick
	line.Transparency = t or 0
	line.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	line.Parent = f
	return f
end

local WEAVE = (function()
	local points = {}
	for index = 0, 18 do
		table.insert(points, NumberSequenceKeypoint.new(index / 18, index % 2 == 0 and 0.35 or 0.9))
	end
	return NumberSequence.new(points)
end)()

local SKINS: { [string]: (holder: Frame) -> () } = {}

SKINS.Carbon = function(holder)
	local rows = 7
	for row = 0, rows - 1 do
		for col = 0, 2 do
			local offset = (row % 2) * 0.03
			local strip = frame(holder, col / 3 - offset, row / rows, 1 / 3 + 0.01, 1 / rows, rgb(150, 156, 176), 0, 1)
			local weave = Instance.new("UIGradient")
			weave.Transparency = WEAVE
			weave.Parent = strip
		end
	end
	local gloss = frame(holder, 0.18, -0.4, 0.14, 1.8, WHITE, 0.82, 2)
	gloss.Rotation = 24
end

SKINS.Camo = function(holder)
	local tones = { rgb(70, 92, 56), rgb(122, 146, 90), rgb(176, 186, 130), rgb(90, 76, 60) }
	local spots = {
		{ 0.08, 0.2, 0.26, 0.5, -20 }, { 0.3, 0.75, 0.3, 0.45, 15 }, { 0.5, 0.2, 0.24, 0.5, 30 },
		{ 0.72, 0.7, 0.3, 0.5, -10 }, { 0.92, 0.25, 0.22, 0.6, 20 }, { 0.2, 0.5, 0.14, 0.4, 50 },
		{ 0.62, 0.45, 0.16, 0.35, -40 }, { 0.84, 0.95, 0.2, 0.4, 0 }, { 0.02, 0.9, 0.18, 0.4, 10 },
		{ 0.42, 1, 0.2, 0.4, 25 }, { 0.4, -0.05, 0.2, 0.35, 0 },
	}
	for index, s in ipairs(spots) do
		oval(holder, s[1], s[2], s[3], s[4], tones[index % #tones + 1], 0, s[5], 1)
	end
end

SKINS.Basketball = function(holder)
	local seam = rgb(90, 40, 20)
	frame(holder, 0.5, 0, 0.012, 1, seam, 0, 2).AnchorPoint = Vector2.new(0.5, 0)
	frame(holder, 0, 0.5, 1, 0.04, seam, 0, 2).AnchorPoint = Vector2.new(0, 0.5)
	ringOval(holder, 0.02, 0.5, 0.5, 1.6, seam, 2.5, 0)
	ringOval(holder, 0.98, 0.5, 0.5, 1.6, seam, 2.5, 0)
	for index = 1, 14 do
		local x = ((index * 0.37) % 1)
		local y = ((index * 0.61) % 1)
		dot(holder, x, y, 0.08, rgb(200, 90, 30), 0.5, 1)
	end
	local shine = oval(holder, 0.3, 0.2, 0.3, 0.18, WHITE, 0.7, -8, 3)
	local _ = shine
end

SKINS.Controller = function(holder)
	-- croix directionnelle à gauche, boutons à droite, sticks aux coins
	frame(holder, 0.06, 0.44, 0.14, 0.12, WHITE, 0.25, 2)
	frame(holder, 0.105, 0.26, 0.05, 0.48, WHITE, 0.25, 2)
	for index, spec in ipairs({ { 0.87, 0.3, YELLOW }, { 0.93, 0.5, RED }, { 0.81, 0.5, CYAN }, { 0.87, 0.7, LIME } }) do
		dot(holder, spec[1], spec[2], 0.2, spec[3], 0, 2)
		local _ = index
	end
	for _, x in ipairs({ 0.26, 0.74 }) do
		dot(holder, x, 0.82, 0.26, DARKER, 0.2, 2)
		dot(holder, x, 0.82, 0.14, rgb(90, 90, 120), 0, 3)
	end
	local led = frame(holder, 0.42, 0.08, 0.16, 0.06, CYAN, 0, 2)
	roundify(led)
end

-- Langue de flamme : base ronde + pointe (ovale étiré tourné)
local function flameTongue(holder: Instance, cx: number, h: number, w: number, color: Color3, z: number)
	oval(holder, cx, 1 - h * 0.18, w, h * 0.5, color, 0, 0, z)
	oval(holder, cx + w * 0.08, 1 - h * 0.55, w * 0.55, h * 0.8, color, 0, 12, z)
end

SKINS.Flames = function(holder)
	for index = 0, 6 do
		local cx = 0.04 + index * 0.155
		local h = 0.7 + ((index * 37) % 5) * 0.08
		flameTongue(holder, cx, h, 0.2, RED, 1)
		flameTongue(holder, cx, h * 0.8, 0.15, ORANGE, 2)
		flameTongue(holder, cx, h * 0.5, 0.09, YELLOW, 3)
	end
end

SKINS.Lava = function(holder)
	local rock = { rgb(70, 50, 54), rgb(96, 66, 66), rgb(60, 40, 46) }
	for index, spec in ipairs({ { 0.12, 0.3, 0.3, 0.7 }, { 0.42, 0.7, 0.34, 0.8 }, { 0.72, 0.28, 0.32, 0.7 }, { 0.95, 0.78, 0.26, 0.8 }, { 0.15, 0.95, 0.26, 0.5 } }) do
		oval(holder, spec[1], spec[2], spec[3], spec[4], rock[index % #rock + 1], 0, (index - 2) * 12, 1)
	end
	-- fissures lumineuses
	for index, spec in ipairs({ { 0.28, 0.5, 0.3, 30 }, { 0.58, 0.45, 0.28, -40 }, { 0.84, 0.55, 0.26, 55 }, { 0.3, 0.1, 0.2, -10 }, { 0.62, 0.95, 0.24, 10 } }) do
		local crack = frame(holder, spec[1], spec[2], spec[3], 0.06, rgb(255, 130, 50), 0, 2)
		crack.AnchorPoint = Vector2.new(0.5, 0.5)
		crack.Rotation = spec[4]
		roundify(crack)
		local glow = oval(holder, spec[1], spec[2], spec[3] * 1.1, 0.3, rgb(255, 170, 60), 0.7, spec[4], 2)
		local _ = glow
		local _i = index
	end
	dot(holder, 0.5, 0.2, 0.14, YELLOW, 0.2, 3)
	dot(holder, 0.1, 0.62, 0.1, YELLOW, 0.3, 3)
end

SKINS.Galaxy = function(holder)
	oval(holder, 0.5, 0.5, 0.9, 0.7, rgb(255, 120, 220), 0.7, -12, 1)
	oval(holder, 0.45, 0.5, 0.6, 0.35, rgb(120, 220, 255), 0.65, -12, 2)
	oval(holder, 0.5, 0.5, 0.25, 0.3, WHITE, 0.55, 0, 3)
	for index = 1, 16 do
		local x = (index * 0.618) % 1
		local y = (index * 0.377 + 0.1) % 1
		dot(holder, x, y, index % 4 == 0 and 0.1 or 0.05, WHITE, index % 3 == 0 and 0 or 0.3, 4)
	end
	local planet = dot(holder, 0.86, 0.3, 0.3, rgb(255, 180, 110), 0, 4)
	local ringBand = frame(planet, 0.5, 0.55, 1.8, 0.14, rgb(255, 230, 170), 0.1, 2)
	ringBand.AnchorPoint = Vector2.new(0.5, 0.5)
	ringBand.Rotation = -18
	roundify(ringBand)
end

SKINS.Circuit = function(holder)
	local traces = {
		{ 0, 0.25, 0.3, 0.035 }, { 0.3, 0.25, 0.012, 0.3 }, { 0.3, 0.55, 0.2, 0.035 },
		{ 0.7, 0.2, 0.3, 0.035 }, { 0.7, 0.2, 0.012, 0.45 }, { 0.62, 0.65, 0.09, 0.035 },
		{ 0, 0.8, 0.18, 0.035 }, { 0.18, 0.8, 0.012, 0.2 }, { 0.85, 0.82, 0.15, 0.035 }, { 0.85, 0.65, 0.012, 0.2 },
	}
	for index, t in ipairs(traces) do
		frame(holder, t[1], t[2], t[3], t[4], index % 2 == 0 and CYAN or LIME, 0.15, 1)
	end
	for _, n in ipairs({ { 0.5, 0.565 }, { 0.3, 0.255 }, { 0.62, 0.665 }, { 0.18, 0.99 }, { 0.855, 0.655 }, { 0.705, 0.215 } }) do
		dot(holder, n[1], n[2], 0.16, CYAN, 0, 2)
		dot(holder, n[1], n[2], 0.07, WHITE, 0, 3)
	end
	local chip = frame(holder, 0.42, 0.08, 0.16, 0.3, DARKER, 0, 2)
	roundify(chip, UDim.new(0, 3))
	local stroke = Instance.new("UIStroke")
	stroke.Color = MAGENTA
	stroke.Thickness = 1.5
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = chip
end

-- Pose (ou retire) le motif du bouton
function CosmeticArt.ApplySkin(button: GuiObject, cosmetic: any?, radius: number?, zIndex: number?)
	local old = button:FindFirstChild("SkinArt")
	if old then
		old:Destroy()
	end
	local pattern = cosmetic and cosmetic.Pattern
	local painter = type(pattern) == "string" and SKINS[pattern] or nil
	if not painter then
		return
	end
	-- CanvasGroup : le motif est découpé aux coins arrondis du bouton
	local holder = Instance.new("CanvasGroup")
	holder.Name = "SkinArt"
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.Size = UDim2.fromScale(1, 1)
	holder.ZIndex = zIndex or button.ZIndex
	holder.GroupTransparency = 0.12
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 12)
	corner.Parent = holder
	local ok, err = pcall(painter, holder)
	if not ok then
		warn("[CosmeticArt] Motif " .. tostring(pattern) .. " : " .. tostring(err))
		holder:Destroy()
		return
	end
	holder.Parent = button
end

return CosmeticArt
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">DebugTools</string>
            <string name="Source"><![CDATA[--[[
	DebugTools (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > DebugTools

	Outils de TEST, actifs UNIQUEMENT dans Roblox Studio :
	  - DebugTools.Run(commande, argument) : appelle la RemoteFunction
	    "DebugCommand" (le serveur refuse tout hors de Studio) et renvoie
	    (succès, message). Utilisé par le panneau "🛠️ Test".
	  - DebugTools.RegisterChatCommands() : déclare des TextChatCommand
	    CÔTÉ CLIENT (/give, /unlockall, /spawn...) : leur événement Triggered
	    se déclenche de façon fiable côté client, puis appelle la même
	    RemoteFunction. Le résultat s'affiche dans le chat (message système)
	    et en bandeau. Les commandes identiques déclarées par le serveur sont
	    désactivées localement (pas de doublon ; le serveur ignore de toute
	    façon une commande reçue deux fois dans la même seconde).
	  - /test ouvre le panneau de test ; /aide liste les commandes.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")

local Client = script.Parent.Parent
local Theme = require(Client.Theme)
local Signal = require(ReplicatedStorage.Shared.Signal)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Notifications = require(script.Parent.Notifications)

local DebugTools = {}

DebugTools.Enabled = RunService:IsStudio()
DebugTools.Ran = Signal.new() -- (commande, argument, succès, message) après chaque commande

-- Appelé par /test (branché par ClientMain : ouvre le panneau de test)
DebugTools.OpenPanel = nil :: (() -> ())?

local REMOTE_TIMEOUT = 5
local FOLDER_NAME = "DopamineClientCommands"

-- Commandes de chat : alias -> commande envoyée au serveur
-- ("/help" est déjà pris par Roblox : on utilise "/aide")
local CHAT_COMMANDS = {
	{ Alias = "give", Command = "give", Help = "/give 1e6" },
	{ Alias = "rush", Command = "rush", Help = "/rush" },
	{ Alias = "daily", Command = "daily", Help = "/daily" },
	{ Alias = "save", Command = "save", Help = "/save" },
	{ Alias = "corner", Command = "corner", Help = "/corner" },
	{ Alias = "unlockall", Command = "unlockall", Help = "/unlockall" },
	{ Alias = "spawn", Command = "spawn", Help = "/spawn golden" },
	{ Alias = "golden", Command = "golden", Help = "/golden" },
	{ Alias = "detox", Command = "detox", Help = "/detox" },
	{ Alias = "chest", Command = "chest", Help = "/chest 3" },
	{ Alias = "reset", Command = "reset", Help = "/reset" },
	{ Alias = "pass", Command = "pass", Help = "/pass vip" },
	{ Alias = "boost", Command = "boost", Help = "/boost 5 60" },
	{ Alias = "theme", Command = "theme", Help = "/theme kawaii" },
	{ Alias = "offline", Command = "offline", Help = "/offline 7200" },
	{ Alias = "aide", Command = "help", Help = "/aide" },
}

local registered = false
local lastDuplicate = false -- la dernière commande était un doublon (déjà exécutée)
local myCommands: { [TextChatCommand]: boolean } = {}
local myAliases: { [string]: boolean } = {} -- "/give" -> true

-- Texte d'aide (liste des commandes de chat)
function DebugTools.HelpText(): string
	local list = {}
	for _, entry in ipairs(CHAT_COMMANDS) do
		table.insert(list, entry.Help)
	end
	table.insert(list, "/test")
	return table.concat(list, "  ")
end

-- RemoteFunction "DebugCommand" (sans attente infinie si le serveur ne l'a pas)
local function getRemote(): RemoteFunction?
	local folder = ReplicatedStorage:WaitForChild("Remotes", REMOTE_TIMEOUT)
	if not folder then
		return nil
	end
	local remote = folder:WaitForChild("DebugCommand", REMOTE_TIMEOUT)
	if remote and remote:IsA("RemoteFunction") then
		return remote
	end
	return nil
end

-- Lance une commande de test sur le serveur (bloque le thread appelant).
-- Renvoie (succès, message).
function DebugTools.Run(command: string, argument: string?): (boolean, string)
	if not DebugTools.Enabled then
		return false, Locale.T("Test commands are only available in Studio")
	end
	local remote = getRemote()
	if not remote then
		return false, Locale.T("DebugCommand RemoteFunction not found (server out of date?)")
	end
	local ok, success, message, duplicate = pcall(function()
		return remote:InvokeServer(command, argument or "")
	end)
	local result: boolean
	local text: string
	if not ok then
		result, text = false, Locale.T("Network error: %s", tostring(success))
	else
		result = success == true
		text = message ~= nil and tostring(message) or (result and "OK" or Locale.T("Refused"))
		-- 3e valeur du serveur : commande déjà exécutée (doublon du chat)
		if duplicate == true then
			lastDuplicate = true
		end
	end
	DebugTools.Ran:Fire(command, argument or "", result, text)
	return result, text
end

----------------------------------------------------------------------
-- Commandes de chat (client)
----------------------------------------------------------------------

-- Affiche un message système dans la fenêtre de chat (si possible)
local function systemMessage(text: string)
	pcall(function()
		local channels = TextChatService:FindFirstChild("TextChannels")
		local channel = channels and channels:FindFirstChild("RBXSystem")
		if channel and channel:IsA("TextChannel") then
			channel:DisplaySystemMessage(text)
		end
	end)
end

-- Désactive (localement) une commande déclarée ailleurs avec un de nos alias
local function disableDuplicate(instance: Instance)
	if not instance:IsA("TextChatCommand") or myCommands[instance] then
		return
	end
	local primary = string.lower(instance.PrimaryAlias)
	local secondary = string.lower(instance.SecondaryAlias)
	if myAliases[primary] or myAliases[secondary] then
		pcall(function()
			instance.Enabled = false
		end)
	end
end

local function onTriggered(entry, text: string)
	-- "/give 1e6" -> argument "1e6" ; "/boost 5 60" -> "5 60"
	local argument = string.match(text, "^%s*/%S+%s*(.-)%s*$") or ""
	task.spawn(function()
		lastDuplicate = false
		local ok, message = DebugTools.Run(entry.Command, argument)
		if lastDuplicate or message == "(already run)" or message == "(déjà exécutée)" then
			return
		end
		systemMessage((ok and "🛠️ " or "❌ ") .. message)
		if not ok then
			Notifications.Toast(message, Theme.Colors.Red, 4, Locale.T("Command /%s", entry.Alias), false, "🛠️")
		end
	end)
end

function DebugTools.RegisterChatCommands()
	if not DebugTools.Enabled or registered then
		return
	end
	registered = true
	-- Les TextChatCommand ne marchent qu'avec le nouveau chat (TextChatService)
	local okVersion, isNewChat = pcall(function()
		return TextChatService.ChatVersion == Enum.ChatVersion.TextChatService
	end)
	if not okVersion or not isNewChat then
		return
	end

	local ok, err = pcall(function()
		local old = TextChatService:FindFirstChild(FOLDER_NAME)
		if old then
			old:Destroy()
		end
		local folder = Instance.new("Folder")
		folder.Name = FOLDER_NAME

		local function add(alias: string, callback: (text: string) -> ())
			local command = Instance.new("TextChatCommand")
			command.Name = "ClientDebug_" .. alias
			command.PrimaryAlias = "/" .. alias
			myCommands[command] = true
			myAliases["/" .. alias] = true
			command.Triggered:Connect(function(_source: TextSource, text: string)
				callback(text)
			end)
			command.Parent = folder
		end

		for _, entry in ipairs(CHAT_COMMANDS) do
			add(entry.Alias, function(text: string)
				onTriggered(entry, text)
			end)
		end
		add("test", function()
			local open = DebugTools.OpenPanel
			if open then
				open()
			end
		end)
		folder.Parent = TextChatService
	end)
	if not ok then
		warn("[DebugTools] Impossible de déclarer les commandes de chat : " .. tostring(err))
		return
	end

	-- Commandes du serveur avec le même alias : désactivées ici (une seule exécution)
	for _, descendant in ipairs(TextChatService:GetDescendants()) do
		disableDuplicate(descendant)
	end
	TextChatService.DescendantAdded:Connect(disableDuplicate)
end

return DebugTools
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="9">
          <Properties>
            <string name="Name">House</string>
          </Properties>
          <Item class="Folder" referent="10">
            <Properties>
              <string name="Name">Art</string>
            </Properties>
            <Item class="ModuleScript" referent="11">
              <Properties>
                <string name="Name">Cool92Adventure</string>
                <string name="Source"><![CDATA[--[[
	Cool92Adventure (ModuleScript) — (v9.2) aventure 🚀🦖🏴 : dinos, espace,
	robots, pirates, ninjas, super-héros (affiches maison, aucune marque),
	aquarium à requins, lampes néon
	Emplacement : ReplicatedStorage > Client > Components > House > Art > Cool92Adventure
	Contrat : voir HouseArt (boîte 100 x 100, pieds en bas pour les objets au
	sol, centrés pour les objets muraux).
]]

local Art = {}

local rgb = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)
local NAVY = rgb(52, 60, 100)
local DARK = rgb(44, 46, 64)
local DARKER = rgb(30, 32, 46)
local CYAN = rgb(60, 222, 255)
local RED = rgb(236, 66, 76)
local ORANGE = rgb(255, 152, 56)
local STEEL = rgb(176, 186, 206)
local CHROME = rgb(214, 222, 236)
local BLUE = rgb(80, 150, 255)
local DINO = rgb(120, 200, 110)
local BONE = rgb(246, 238, 220)
local LAVA = rgb(255, 110, 50)

-- Éclair (3 segments) dans la zone (x, y) de hauteur h
local function bolt(kit, parent, x, y, h, color, z, thick)
	local g = kit.Group(parent, x, y, h * 0.7, h, z)
	local t = thick or h * 0.16
	kit.Line(g, h * 0.55, 0, h * 0.16, h * 0.52, t, color, 0, 1)
	kit.Line(g, h * 0.16, h * 0.52, h * 0.54, h * 0.48, t, color, 0, 1)
	kit.Line(g, h * 0.54, h * 0.48, h * 0.14, h, t, color, 0, 1)
	return g
end

-- Bulles qui montent (aquarium, lampe à lave)
local function bubbles(kit, parent, list, z)
	for index, b in ipairs(list) do
		local bubble = kit.Circle(parent, b[1], b[2], b[3], b[3], WHITE, 0.45, z)
		kit.Stroke(bubble, WHITE, 1, 0.3)
		kit.Animate(bubble, "Bob", 3, 1.4, index * 0.9)
	end
end

----------------------------------------------------------------------
-- 🧸 Peluches
----------------------------------------------------------------------

-- T-rex en peluche (grosse tête, petits bras, dents, piques)
Art.TRexPlush = function(body, kit, _item)
	local C = kit.C
	local dark = kit.Darken(DINO, 0.2)
	-- queue + piques du dos
	kit.Blob(body, 20, 76, 40, 22, DINO, { Z = 1, Rotation = -20 })
	for index = 0, 3 do
		kit.Triangle(body, 30 + index * 9, 30 + index * 9, 10, 10, C.Butter, 1)
	end
	-- corps + ventre
	local belly = kit.Blob(body, 52, 70, 50, 50, DINO, { Z = 2, Shine = true })
	kit.Blob(belly, 28, 30, 30, 34, rgb(236, 246, 200), { Z = 2, Outline = false })
	for index = 0, 2 do
		kit.Box(belly, 18, 20 + index * 8, 20, 1.5, kit.Darken(DINO, 0.1), 0.4, 3)
	end
	-- pattes
	for _, x in ipairs({ 40, 64 }) do
		kit.Blob(body, x, 94, 18, 12, dark, { Z = 3 })
	end
	-- petits bras
	kit.Blob(body, 72, 58, 12, 7, DINO, { Z = 4, Rotation = 30 })
	-- tête
	local head = kit.Part(body, 44, 12, 50, 36, DINO, { Radius = 16, Z = 5, Shine = true })
	kit.Face(head, 28, 14, 20, { Eyes = "big", Mouth = "none", Z = 3 })
	kit.Part(head, 8, 24, 40, 8, rgb(255, 170, 190), { Radius = 4, Z = 2, Outline = false }) -- bouche
	for index = 0, 4 do
		kit.TriangleDown(head, 12 + index * 7, 24, 5, 5, WHITE, 3) -- dents
	end
	kit.Circle(head, 44, 8, 3, 3, dark, 0, 3) -- narine
	return nil
end

-- Ninja en peluche (capuche noire, bandeau rouge qui flotte, étoile en tissu)
Art.NinjaPlush = function(body, kit, _item)
	local C = kit.C
	-- rubans du bandeau (flottent)
	local tails = kit.Pivot(body, 22, 34, 1)
	kit.Part(tails, -20, -4, 22, 7, RED, { Radius = 3, Z = 1, Rotation = -18 })
	kit.Part(tails, -18, 4, 18, 6, RED, { Radius = 3, Z = 1, Rotation = 14 })
	kit.Animate(tails, "Sway", 8, 2.4, 0)
	-- corps
	local suit = kit.Blob(body, 50, 76, 50, 42, DARK, { Z = 2, Shine = true })
	kit.Box(suit, 6, 18, 38, 5, RED, 0, 2) -- ceinture
	for _, x in ipairs({ 38, 62 }) do
		kit.Blob(body, x, 95, 16, 10, DARKER, { Z = 3 })
	end
	-- tête
	local head = kit.Blob(body, 50, 38, 56, 50, DARK, { Z = 4, Shine = true })
	local slit = kit.Part(head, 8, 16, 40, 18, rgb(255, 220, 196), { Radius = 8, Z = 2, Outline = false })
	kit.Face(slit, 20, 10, 20, { Eyes = "happy", Mouth = "none", Z = 3 })
	kit.Box(head, 2, 10, 52, 5, RED, 0, 3) -- bandeau
	-- étoile en tissu dans la main
	local star = kit.Group(body, 70, 62, 20, 20, 6)
	kit.Diamond(star, 10, 10, 11, STEEL, 0, 1)
	kit.Box(star, 1, 8.5, 18, 3, STEEL, 0, 1)
	kit.Box(star, 8.5, 1, 3, 18, STEEL, 0, 1)
	kit.Circle(star, 10, 10, 4, 4, DARKER, 0, 2)
	kit.Animate(star, "Sway", 12, 1.5, 0)
	kit.Sparkle(body, 86, 22, 9, C.Butter, 0, 7)
	return nil
end

----------------------------------------------------------------------
-- 🖼️ Affiches, aquarium
----------------------------------------------------------------------

-- Affiche de super-héros (héros maison "éclair", cape, ville au loin)
Art.HeroPoster = function(body, kit, _item)
	local C = kit.C
	local poster = kit.Part(body, 12, 4, 76, 92, WHITE, { Radius = 3, Z = 1 })
	local art = kit.Group(poster, 4, 4, 68, 84, 2, true)
	local sky = kit.Box(art, 0, 0, 68, 84, WHITE, 0, 1)
	kit.Gradient(sky, rgb(90, 130, 240), rgb(255, 180, 120), 90)
	for index = 0, 4 do
		kit.Box(art, index * 14, 58 - (index % 3) * 8, 12, 40, rgb(60, 70, 130), 0.1, 2) -- ville
	end
	kit.Circle(art, 52, 18, 16, 16, C.Butter, 0.2, 2)
	-- cape qui flotte
	local cape = kit.Pivot(art, 34, 34, 3)
	kit.Part(cape, -18, 0, 36, 34, RED, { Radius = 10, Z = 1 })
	kit.Animate(cape, "Sway", 4, 1.6, 0)
	-- héros
	local suit = kit.Part(art, 22, 34, 24, 26, BLUE, { Radius = 8, Z = 4, Shine = true })
	bolt(kit, suit, 7, 4, 16, C.Butter, 3)
	kit.Part(art, 10, 34, 12, 7, BLUE, { Radius = 3, Z = 4, Rotation = -40 }) -- bras levé
	kit.Blob(art, 10, 30, 8, 8, RED, { Z = 5 }) -- poing
	local head = kit.Blob(art, 34, 26, 20, 18, rgb(255, 220, 196), { Z = 5, Shine = true })
	kit.Part(head, 1, 5, 18, 5, RED, { Radius = 2, Z = 2, Outline = false }) -- masque
	kit.Face(head, 10, 9, 12, { Eyes = "dot", Mouth = "smile", Blush = false, Z = 3 })
	kit.Text(art, "HERO!", 34, 74, 14, C.Butter, 6).TextStrokeTransparency = 0
	return { WallShadow = Vector2.new(76, 92) }
end

-- Affiche de BD "POW!" (explosion, points de trame, traits de vitesse)
Art.ComicPoster = function(body, kit, _item)
	local C = kit.C
	local poster = kit.Part(body, 8, 6, 84, 88, rgb(80, 200, 255), { Radius = 3, Z = 1, Shine = true })
	for row = 0, 7 do
		for col = 0, 7 do
			kit.Circle(poster, 6 + col * 10.5, 6 + row * 10.5, 3, 3, WHITE, 0.55, 2) -- trame
		end
	end
	-- explosion (carrés tournés)
	local burst = kit.Group(body, 14, 16, 72, 66, 3)
	for index = 0, 5 do
		local ray = kit.Box(burst, 6, 26, 60, 16, C.Butter, 0, 1)
		ray.Rotation = index * 30
		kit.Stroke(ray, RED, 2, 0)
	end
	kit.Blob(burst, 36, 34, 52, 40, C.Butter, { Z = 2, Outline = RED, Thickness = 2 })
	local word = kit.Text(burst, "POW!", 36, 34, 22, RED, 3)
	word.TextStrokeColor3 = WHITE
	word.TextStrokeTransparency = 0
	word.Rotation = -8
	kit.Animate(word, "Breathe", 0.06, 2, 0)
	for index = 0, 2 do
		kit.Line(body, 12, 80 + index * 4, 30 - index * 4, 80 + index * 4, 2, WHITE, 0.2, 4)
	end
	return { WallShadow = Vector2.new(84, 88) }
end

-- Grand aquarium à requins (deux requins mignons, corail, coffre, bulles)
Art.SharkTank = function(body, kit, _item)
	local C = kit.C
	kit.Part(body, 4, 76, 92, 22, DARK, { Radius = 5, Z = 1, Shine = true })
	for index = 0, 1 do
		kit.Part(body, 8 + index * 44, 80, 40, 14, NAVY, { Radius = 3, Z = 2 })
	end
	local tank = kit.Part(body, 2, 8, 96, 70, rgb(120, 200, 245), { Radius = 6, Z = 3, Outline = STEEL, Thickness = 2.5 })
	kit.Gradient(tank, rgb(150, 225, 255), rgb(40, 110, 200), 90)
	local water = kit.Group(tank, 3, 3, 90, 64, 2, true)
	kit.Box(water, 0, 54, 90, 10, rgb(240, 214, 170), 0, 1) -- sable
	for index, x in ipairs({ 10, 18, 78 }) do
		kit.Part(water, x, 34 + index * 3, 5, 24, index == 3 and rgb(255, 150, 120) or rgb(110, 200, 120), { Radius = 3, Z = 1, Outline = false })
	end
	local chest = kit.Part(water, 60, 46, 16, 10, rgb(170, 110, 70), { Radius = 3, Z = 2 })
	kit.Box(chest, 0, 3, 16, 2, C.Gold, 0, 2)
	-- requins (corps gris-bleu, ventre blanc, aileron)
	local function shark(x, y, scale, phase)
		local g = kit.Group(water, x, y, 40 * scale, 20 * scale, 4)
		local s = kit.Blob(g, 20 * scale, 10 * scale, 34 * scale, 14 * scale, rgb(130, 150, 190), { Z = 2, Shine = true })
		kit.Blob(s, 16 * scale, 10 * scale, 24 * scale, 6 * scale, WHITE, { Z = 1, Outline = false, Shade = false })
		kit.Triangle(g, 20 * scale, 0, 10 * scale, 7 * scale, rgb(130, 150, 190), 1)
		kit.Triangle(g, 2 * scale, 4 * scale, 10 * scale, 12 * scale, rgb(130, 150, 190), 1)
		kit.Face(s, 26 * scale, 6 * scale, 10 * scale, { Eyes = "happy", Mouth = "cat", Z = 3 })
		kit.Animate(g, "Drift", 12, 0.6, phase)
		return g
	end
	shark(16, 8, 1, 0)
	shark(40, 30, 0.8, 2)
	bubbles(kit, water, { { 80, 14, 5 }, { 84, 26, 3 }, { 8, 20, 4 } }, 5)
	-- couvercle + lampe
	kit.Part(body, 0, 4, 100, 7, DARK, { Radius = 3, Z = 4 })
	local lamp = kit.Box(body, 20, 10, 60, 2, CYAN, 0.2, 5)
	kit.Animate(lamp, "Pulse", 0.4, 1, 0)
	return { Glow = rgb(120, 210, 255) }
end

----------------------------------------------------------------------
-- 💡 Lumières
----------------------------------------------------------------------

-- Enseigne néon éclair (jaune) sur panneau sombre
Art.LightningNeon = function(body, kit, _item)
	local C = kit.C
	local halo = kit.Part(body, 10, 6, 80, 88, C.Butter, { Radius = 18, Z = 1, Outline = false, Shade = false, T = 0.75 })
	kit.Animate(halo, "Pulse", 0.2, 1.1, 0)
	local board = kit.Part(body, 14, 10, 72, 80, DARKER, { Radius = 14, Z = 2 })
	kit.Stroke(board, CYAN, 2, 0.3)
	local glow = bolt(kit, board, 16, 8, 64, rgb(255, 240, 150), 2, 12)
	local _ = glow
	local core = bolt(kit, board, 16, 8, 64, WHITE, 3, 5)
	kit.Animate(core, "Pulse", 0.5, 3, 0)
	return { Glow = C.Butter, WallShadow = Vector2.new(72, 80) }
end

-- Lampe œuf de dino (coquille fêlée qui brille, bébé dino qui regarde)
Art.DinoEggLamp = function(body, kit, _item)
	local C = kit.C
	kit.Blob(body, 50, 94, 58, 12, rgb(170, 120, 86), { Z = 1, Shine = true }) -- nid
	local glow = kit.Blob(body, 50, 56, 70, 78, C.Butter, { Z = 1, Outline = false, Shade = false, T = 0.7 })
	kit.Animate(glow, "Pulse", 0.2, 1.2, 0)
	local egg = kit.Blob(body, 50, 60, 50, 66, rgb(250, 244, 220), { Z = 2, Shine = true })
	for _, spot in ipairs({ { 12, 20, 8 }, { 34, 44, 10 }, { 16, 50, 6 } }) do
		kit.Circle(egg, spot[1], spot[2], spot[3], spot[3], DINO, 0.3, 2)
	end
	-- fêlure en zigzag + lumière
	for index = 0, 4 do
		kit.Line(egg, 4 + index * 9, 20 + (index % 2) * 6, 13 + index * 9, 20 + ((index + 1) % 2) * 6, 2, C.Gold, 0, 3)
	end
	-- bébé dino qui sort la tête
	local head = kit.Blob(body, 50, 30, 30, 24, DINO, { Z = 3, Shine = true })
	kit.Face(head, 15, 12, 18, { Eyes = "big", Mouth = "smile", Z = 3 })
	kit.Animate(head, "Bob", 1.5, 1, 0)
	return { Glow = rgb(255, 230, 150) }
end

-- Lampe à lave en forme de fusée (bulles de lave qui montent et descendent)
Art.RocketLavaLamp = function(body, kit, _item)
	local C = kit.C
	for _, side in ipairs({ -1, 1 }) do
		kit.Part(body, 50 + side * 20 - 7, 72, 14, 24, RED, { Radius = 4, Z = 1, Rotation = side * 18 })
	end
	kit.Part(body, 32, 80, 36, 18, CHROME, { Radius = 6, Z = 3, Shine = true })
	local glass = kit.Part(body, 34, 22, 32, 60, rgb(110, 60, 160), { Radius = 16, Z = 2 })
	kit.Gradient(glass, rgb(160, 100, 220), rgb(60, 30, 110), 90)
	for index, b in ipairs({ { 14, 44, 12 }, { 20, 26, 9 }, { 10, 14, 7 } }) do
		local blob = kit.Blob(glass, b[1], b[2], b[3], b[3] * 1.2, LAVA, { Z = 2, Outline = false })
		kit.Animate(blob, "Bob", 6, 0.6, index * 1.4)
	end
	kit.Shine(glass, 5, 6, 5, 30, 4, 0.5)
	kit.Triangle(body, 50, 4, 30, 20, CHROME, 3) -- nez
	local window = kit.Blob(body, 50, 36, 12, 12, CYAN, { Z = 4, Outline = CHROME, Thickness = 2 })
	local _ = window
	kit.Sparkle(body, 82, 20, 9, C.Butter, 0, 6)
	return { Glow = LAVA }
end

----------------------------------------------------------------------
-- 🚀 Aventure
----------------------------------------------------------------------

-- Parchemin ninja (rouleau suspendu : lune, bambou, chat ninja, étoile)
Art.NinjaBanner = function(body, kit, _item)
	local C = kit.C
	kit.Line(body, 30, 4, 50, -4, 1.5, DARK, 0, 1)
	kit.Line(body, 70, 4, 50, -4, 1.5, DARK, 0, 1)
	local scroll = kit.Part(body, 22, 6, 56, 86, rgb(250, 240, 214), { Radius = 2, Z = 2, Shine = true })
	kit.Part(body, 16, 2, 68, 7, rgb(150, 96, 60), { Radius = 3, Z = 3 })
	kit.Part(body, 16, 90, 68, 7, rgb(150, 96, 60), { Radius = 3, Z = 3 })
	kit.Circle(scroll, 36, 22, 22, 22, RED, 0, 2) -- soleil rouge
	for index = 0, 2 do
		kit.Part(scroll, 6 + index * 4, 34 + index * 6, 3, 48, rgb(110, 170, 110), { Radius = 1, Z = 3, Outline = false })
	end
	-- chat ninja
	local cat = kit.Blob(scroll, 32, 62, 28, 24, DARK, { Z = 4 })
	for _, side in ipairs({ -1, 1 }) do
		kit.Part(scroll, 32 + side * 9 - 4, 46, 8, 8, DARK, { Radius = 2, Z = 3, Rotation = 45 })
	end
	local mask = kit.Part(cat, 4, 6, 20, 8, rgb(255, 230, 210), { Radius = 4, Z = 2, Outline = false })
	kit.Face(mask, 10, 5, 14, { Eyes = "happy", Mouth = "none", Blush = false, Z = 3 })
	kit.Box(cat, 0, 3, 28, 3, RED, 0, 3)
	local star = kit.Group(scroll, 38, 72, 14, 14, 5)
	kit.Diamond(star, 7, 7, 8, STEEL, 0, 1)
	kit.Box(star, 0, 6, 14, 2, STEEL, 0, 1)
	kit.Box(star, 6, 0, 2, 14, STEEL, 0, 1)
	kit.Animate(star, "Spin", 1, 0.5, 0)
	kit.Sparkle(body, 86, 60, 8, C.Butter, 0, 4)
	return { WallShadow = Vector2.new(60, 90) }
end

-- Maquette de volcan (lave qui coule, fumée qui monte)
Art.VolcanoModel = function(body, kit, _item)
	local C = kit.C
	kit.Part(body, 4, 88, 92, 10, rgb(110, 190, 110), { Radius = 4, Z = 1, Shine = true })
	local mountain = kit.Triangle(body, 50, 30, 84, 62, rgb(150, 100, 80), 2)
	local _ = mountain
	kit.Triangle(body, 50, 30, 60, 44, rgb(170, 118, 92), 3)
	kit.Blob(body, 50, 32, 22, 8, DARKER, { Z = 4 })
	-- lave
	kit.Blob(body, 50, 34, 18, 8, LAVA, { Z = 5 })
	kit.Line(body, 46, 36, 36, 60, 5, LAVA, 0, 5)
	kit.Line(body, 54, 36, 62, 70, 5, ORANGE, 0, 5)
	kit.Line(body, 36, 60, 30, 78, 4, LAVA, 0, 5)
	-- fumée
	for index = 0, 2 do
		local puff = kit.Blob(body, 44 + index * 8, 18 - index * 7, 16 - index * 2, 14 - index * 2, rgb(220, 220, 230), { Z = 6, Outline = false })
		kit.Animate(puff, "Bob", 3, 1, index)
	end
	-- petit panneau "science"
	local sign = kit.Part(body, 72, 70, 20, 12, WHITE, { Radius = 2, Z = 6 })
	kit.Text(sign, "!", 10, 6, 10, RED, 2)
	kit.Line(body, 82, 82, 82, 90, 2, rgb(150, 96, 60), 0, 5)
	local _c = C
	return { Glow = LAVA }
end

-- Mobile du système solaire (soleil, planètes qui se balancent)
Art.PlanetMobile = function(body, kit, _item)
	local C = kit.C
	kit.Line(body, 50, 0, 50, 14, 1.5, DARK, 0, 1)
	kit.Part(body, 8, 12, 84, 4, rgb(170, 120, 86), { Radius = 2, Z = 2 })
	local specs = {
		{ 12, 40, 12, rgb(255, 180, 120) },
		{ 30, 58, 16, rgb(100, 170, 255) },
		{ 70, 54, 18, rgb(255, 120, 110) },
		{ 88, 38, 12, rgb(170, 140, 255) },
	}
	for index, p in ipairs(specs) do
		local swing = kit.Pivot(body, p[1], 14, 3)
		kit.Line(swing, 0, 0, 0, p[2] - 14, 1, DARK, 0.2, 1)
		local planet = kit.Blob(swing, 0, p[2] - 14, p[3], p[3], p[4], { Z = 2, Shine = true })
		if index == 3 then
			local ring = kit.Box(swing, -p[3] * 0.9, p[2] - 15, p[3] * 1.8, 3, C.Butter, 0, 3)
			ring.Rotation = -18
			kit.Round(ring)
		end
		local _ = planet
		kit.Animate(swing, "Sway", 6, 0.8, index)
	end
	-- soleil au centre
	local sunSwing = kit.Pivot(body, 50, 14, 4)
	kit.Line(sunSwing, 0, 0, 0, 26, 1, DARK, 0.2, 1)
	local sun = kit.Blob(sunSwing, 0, 44, 30, 30, C.Butter, { Z = 2, Shine = true })
	kit.Face(sun, 15, 16, 18, { Eyes = "happy", Mouth = "smile", Z = 3 })
	kit.Animate(sunSwing, "Sway", 3, 0.6, 0)
	return { WallShadow = Vector2.new(0, 0) }
end

-- Maquette de bateau pirate (voiles, drapeau à tête de mort mignonne)
Art.PirateShip = function(body, kit, _item)
	local C = kit.C
	kit.Part(body, 30, 88, 40, 10, rgb(150, 96, 60), { Radius = 3, Z = 1, Shine = true })
	kit.Part(body, 46, 76, 8, 14, rgb(120, 80, 50), { Radius = 2, Z = 1 })
	local ship = kit.Group(body, 0, 0, 100, 100, 2)
	kit.Animate(ship, "Sway", 3, 0.9, 0)
	local sail = rgb(250, 244, 228)
	-- mâts
	kit.Part(ship, 49, 10, 4, 62, rgb(120, 80, 50), { Radius = 2, Z = 1 })
	kit.Part(ship, 24, 30, 3, 42, rgb(120, 80, 50), { Radius = 2, Z = 1 })
	-- voiles gonflées (rayées de rouge) + foc triangulaire
	local top = kit.Part(ship, 36, 16, 30, 20, sail, { Radius = 9, Z = 2, Shine = true })
	kit.Box(top, 0, 8, 30, 4, RED, 0.1, 2)
	local main = kit.Part(ship, 30, 38, 42, 26, sail, { Radius = 12, Z = 2, Shine = true })
	kit.Box(main, 0, 8, 42, 4, RED, 0.1, 2)
	kit.Box(main, 0, 16, 42, 4, RED, 0.1, 2)
	local back = kit.Part(ship, 12, 38, 24, 22, sail, { Radius = 9, Z = 2 })
	kit.Box(back, 0, 9, 24, 4, RED, 0.1, 2)
	kit.Triangle(ship, 84, 30, 22, 34, sail, 2)
	kit.Line(ship, 51, 14, 92, 62, 1, rgb(120, 80, 50), 0.2, 1)
	-- drapeau pirate (tête de mort mignonne) en haut du grand mât
	local flag = kit.Part(ship, 53, 6, 20, 13, DARKER, { Radius = 2, Z = 3 })
	local skull = kit.Blob(flag, 10, 5.5, 8, 7, WHITE, { Z = 2, Outline = false })
	kit.Circle(skull, 2.5, 3, 2, 2, DARKER, 0, 2)
	kit.Circle(skull, 5.5, 3, 2, 2, DARKER, 0, 2)
	kit.Line(flag, 5, 10, 15, 12, 1.2, WHITE, 0, 2)
	kit.Line(flag, 15, 10, 5, 12, 1.2, WHITE, 0, 2)
	-- coque (proue relevée)
	kit.Triangle(ship, 90, 58, 14, 14, rgb(150, 96, 60), 3)
	local hull = kit.Part(ship, 6, 62, 86, 18, rgb(150, 96, 60), { Radius = 9, Z = 4, Shine = true })
	kit.Box(hull, 4, 4, 78, 3, C.Gold, 0, 2)
	for index = 0, 3 do
		kit.Circle(hull, 18 + index * 16, 11, 5, 5, DARKER, 0, 2) -- hublots
	end
	kit.Part(ship, 2, 56, 18, 10, rgb(150, 96, 60), { Radius = 3, Z = 3 }) -- château arrière
	return nil
end

-- Coffre au trésor ouvert (pièces d'or, gemmes, étincelles)
Art.PirateChest = function(body, kit, _item)
	local C = kit.C
	local wood = rgb(170, 110, 70)
	-- couvercle ouvert (derrière)
	local lid = kit.Part(body, 10, 18, 80, 28, wood, { Radius = 14, Z = 1, Shine = true })
	kit.Box(lid, 36, 0, 8, 28, C.Gold, 0, 2)
	-- trésor
	for index = 0, 6 do
		local coin = kit.Blob(body, 18 + index * 11, 48 - (index % 3) * 4, 14, 12, C.Gold, { Z = 2, Shine = true })
		kit.Text(coin, "$", 7, 6, 7, rgb(180, 130, 40), 2)
	end
	kit.Diamond(body, 36, 40, 10, RED, 0, 3)
	kit.Diamond(body, 62, 38, 9, CYAN, 0, 3)
	kit.Blob(body, 50, 34, 12, 12, rgb(160, 255, 170), { Z = 3, Shine = true })
	-- caisse
	local chest = kit.Part(body, 8, 50, 84, 46, wood, { Radius = 8, Z = 4, Shine = true })
	for _, x in ipairs({ 8, 68 }) do
		kit.Box(chest, x, 0, 8, 46, C.Gold, 0, 2)
	end
	kit.Box(chest, 0, 18, 84, 4, kit.Darken(wood, 0.25), 0, 2)
	local lock = kit.Part(chest, 34, 8, 16, 16, C.Gold, { Radius = 4, Z = 3, Shine = true })
	kit.Circle(lock, 8, 7, 4, 4, DARKER, 0, 2)
	kit.Box(lock, 7, 8, 2, 5, DARKER, 0, 2)
	for index, p in ipairs({ { 20, 22 }, { 80, 26 }, { 52, 14 } }) do
		local s = kit.Sparkle(body, p[1], p[2], 10, C.Butter, 0, 6)
		kit.Animate(s, "Pulse", 0.7, 1.5, index)
	end
	return { Glow = C.Butter }
end

-- Maquette de fusée sur sa tour de lancement (fumée au décollage)
Art.RocketModel = function(body, kit, _item)
	local C = kit.C
	-- tour de lancement
	kit.Part(body, 72, 12, 8, 80, RED, { Radius = 2, Z = 1 })
	for index = 0, 5 do
		kit.Line(body, 72, 16 + index * 12, 80, 26 + index * 12, 1.5, kit.Darken(RED, 0.3), 0, 2)
	end
	kit.Part(body, 58, 36, 16, 4, STEEL, { Radius = 2, Z = 2 })
	kit.Part(body, 10, 88, 80, 10, STEEL, { Radius = 4, Z = 1, Shine = true })
	-- fumée
	for index, p in ipairs({ { 30, 88, 20 }, { 54, 90, 18 }, { 42, 94, 24 } }) do
		local puff = kit.Blob(body, p[1], p[2], p[3], p[3] * 0.7, WHITE, { Z = 5, Outline = rgb(220, 220, 232) })
		kit.Animate(puff, "Breathe", 0.08, 2, index)
	end
	-- fusée
	for _, side in ipairs({ -1, 1 }) do
		kit.Part(body, 42 + side * 14 - 6, 64, 12, 22, RED, { Radius = 4, Z = 2, Rotation = side * 16 })
	end
	local rocket = kit.Part(body, 32, 20, 24, 64, WHITE, { Radius = 12, Z = 3, Shine = true })
	kit.Box(rocket, 0, 40, 24, 5, RED, 0, 2)
	local window = kit.Blob(rocket, 12, 20, 12, 12, CYAN, { Z = 3, Outline = STEEL, Thickness = 2 })
	kit.Shine(window, 2, 2, 4, 3, 2, 0.3)
	kit.Triangle(body, 44, 4, 22, 22, RED, 4)
	local flame = kit.Blob(body, 44, 88, 10, 12, ORANGE, { Z = 4, Outline = false })
	kit.Animate(flame, "Flicker", 0.4, 1, 0)
	kit.Sparkle(body, 16, 20, 10, C.Butter, 0, 6)
	return nil
end

-- Télescope d'observatoire (gros tube blanc, pied, chercheur, cadrans)
Art.Observatory = function(body, kit, _item)
	local C = kit.C
	kit.Part(body, 26, 86, 48, 12, DARK, { Radius = 5, Z = 1, Shine = true })
	kit.Part(body, 44, 50, 12, 40, STEEL, { Radius = 4, Z = 2, Shine = true })
	kit.Blob(body, 50, 50, 22, 22, DARK, { Z = 3 })
	local tube = kit.Part(body, 6, 26, 84, 26, WHITE, { Radius = 12, Z = 4, Shine = true, Rotation = -28 })
	kit.Box(tube, 22, 0, 6, 26, NAVY, 0, 2)
	kit.Box(tube, 60, 0, 6, 26, NAVY, 0, 2)
	kit.Part(body, 78, 0, 18, 32, DARK, { Radius = 6, Z = 5, Rotation = -28 }) -- pare-soleil
	kit.Part(body, 22, 16, 30, 7, STEEL, { Radius = 3, Z = 5, Rotation = -28 }) -- chercheur
	local dial = kit.Circle(body, 50, 50, 10, 10, C.Gold, 0, 6)
	kit.Box(dial, 4.4, 1, 1.2, 4, DARKER, 0, 2)
	for index, p in ipairs({ { 14, 8 }, { 88, 46 }, { 30, 70 } }) do
		local s = kit.Sparkle(body, p[1], p[2], 10, index == 2 and CYAN or C.Butter, 0, 7)
		kit.Animate(s, "Pulse", 0.7, 1, index)
	end
	return nil
end

-- Statue d'astronaute sur un rocher lunaire (salue, drapeau étoile)
Art.AstronautStatue = function(body, kit, _item)
	local C = kit.C
	kit.Blob(body, 50, 90, 92, 20, rgb(200, 196, 220), { Z = 1, Shine = true })
	kit.Circle(body, 30, 90, 12, 5, rgb(170, 166, 196), 0, 2)
	-- drapeau
	kit.Line(body, 84, 84, 84, 26, 2, STEEL, 0, 2)
	local flag = kit.Part(body, 84, 26, 16, 12, BLUE, { Radius = 2, Z = 2 })
	kit.Sparkle(flag, 8, 6, 8, WHITE, 0, 2)
	kit.Animate(flag, "Sway", 3, 1.5, 0)
	-- sac à dos, corps, jambes
	kit.Part(body, 28, 42, 44, 34, CHROME, { Radius = 8, Z = 3 })
	local suit = kit.Part(body, 32, 44, 36, 36, WHITE, { Radius = 12, Z = 4, Shine = true })
	local panel = kit.Part(suit, 10, 10, 16, 10, NAVY, { Radius = 3, Z = 2 })
	for index, color in ipairs({ RED, C.Butter, CYAN }) do
		kit.Circle(panel, 3 + (index - 1) * 5, 5, 3, 3, color, 0, 2)
	end
	for _, x in ipairs({ 36, 52 }) do
		kit.Part(body, x, 74, 12, 16, WHITE, { Radius = 5, Z = 3 })
		kit.Part(body, x - 1, 86, 14, 6, STEEL, { Radius = 3, Z = 4 })
	end
	-- bras qui salue
	local arm = kit.Pivot(body, 66, 50, 5)
	kit.Part(arm, 0, -22, 10, 24, WHITE, { Radius = 5, Z = 1 })
	kit.Blob(arm, 5, -24, 12, 12, STEEL, { Z = 2 })
	kit.Animate(arm, "Sway", 12, 1.6, 0)
	kit.Part(body, 22, 50, 12, 22, WHITE, { Radius = 5, Z = 3, Rotation = 12 })
	-- casque
	local helmet = kit.Blob(body, 50, 30, 40, 36, WHITE, { Z = 6, Shine = true })
	local visor = kit.Part(helmet, 6, 8, 28, 20, rgb(40, 50, 100), { Radius = 10, Z = 2 })
	kit.Gradient(visor, rgb(90, 120, 220), rgb(30, 30, 80), 90)
	kit.Face(visor, 14, 11, 16, { Eyes = "happy", Mouth = "smile", Color = WHITE, Blush = false, Z = 3 })
	kit.Shine(visor, 3, 2, 8, 4, 4, 0.4)
	return nil
end

-- Squelette de T-rex (musée : os crème sur un socle avec plaque)
Art.DinoSkeleton = function(body, kit, _item)
	local C = kit.C
	kit.Part(body, 4, 88, 92, 10, DARK, { Radius = 4, Z = 1, Shine = true })
	local plaque = kit.Part(body, 38, 90, 24, 6, C.Gold, { Radius = 2, Z = 2 })
	local _ = plaque
	-- supports
	kit.Line(body, 40, 88, 42, 56, 2, STEEL, 0, 1)
	kit.Line(body, 70, 88, 64, 50, 2, STEEL, 0, 1)
	-- colonne vertébrale (queue -> cou)
	local spine = { { 4, 70 }, { 16, 62 }, { 28, 56 }, { 40, 52 }, { 52, 50 }, { 62, 46 }, { 70, 38 }, { 74, 30 } }
	for index = 1, #spine - 1 do
		kit.Line(body, spine[index][1], spine[index][2], spine[index + 1][1], spine[index + 1][2], 3, BONE, 0, 3)
		kit.Blob(body, spine[index][1], spine[index][2], 7, 6, BONE, { Z = 4, Thickness = 1.1 })
	end
	-- côtes
	for index = 0, 3 do
		local x = 44 + index * 6
		kit.Blob(body, x, 62, 6, 22 - index * 2, BONE, { Z = 2, T = 1, Outline = BONE, Thickness = 2.2, Shade = false })
	end
	-- pattes
	kit.Line(body, 46, 58, 40, 76, 4, BONE, 0, 3)
	kit.Line(body, 40, 76, 44, 88, 3.5, BONE, 0, 3)
	kit.Line(body, 58, 56, 60, 76, 4, BONE, 0, 3)
	kit.Line(body, 60, 76, 56, 88, 3.5, BONE, 0, 3)
	kit.Line(body, 68, 44, 74, 52, 2, BONE, 0, 3) -- petit bras
	kit.Line(body, 74, 30, 72, 26, 3, BONE, 0, 3) -- cou
	-- crâne
	local skull = kit.Part(body, 64, 12, 34, 20, BONE, { Radius = 8, Z = 5, Shine = true })
	kit.Circle(skull, 12, 8, 7, 7, DARK, 0, 2)
	kit.Part(skull, 10, 14, 24, 5, DARK, { Radius = 2, Z = 2, Outline = false })
	for index = 0, 3 do
		kit.TriangleDown(skull, 14 + index * 5, 14, 3.5, 4, WHITE, 3)
	end
	local jaw = kit.Part(body, 68, 32, 28, 6, BONE, { Radius = 3, Z = 5 })
	kit.Animate(jaw, "Bob", 1, 1.4, 0)
	return nil
end

-- Robot géant (mech bleu et blanc, visière lumineuse, cœur d'énergie)
Art.MechRobot = function(body, kit, _item)
	local C = kit.C
	local white = rgb(240, 244, 252)
	-- jambes
	for _, x in ipairs({ 30, 56 }) do
		kit.Part(body, x, 64, 14, 26, STEEL, { Radius = 4, Z = 1 })
		kit.Part(body, x - 4, 86, 22, 12, BLUE, { Radius = 5, Z = 2, Shine = true })
	end
	-- bras
	for index, side in ipairs({ -1, 1 }) do
		local arm = kit.Pivot(body, 50 + side * 30, 36, 3)
		kit.Part(arm, -8, 0, 16, 34, white, { Radius = 7, Z = 1, Shine = true })
		kit.Blob(arm, 0, 38, 18, 16, BLUE, { Z = 2 })
		kit.Animate(arm, "Sway", 5, 1, index * 1.5)
		kit.Blob(body, 50 + side * 30, 36, 20, 20, BLUE, { Z = 4, Shine = true }) -- épaule
	end
	-- torse + cœur d'énergie
	local torso = kit.Part(body, 26, 30, 48, 40, white, { Radius = 10, Z = 5, Shine = true })
	kit.Box(torso, 0, 30, 48, 4, BLUE, 0, 2)
	local core = kit.Circle(torso, 24, 16, 16, 16, CYAN, 0, 3)
	kit.Stroke(core, BLUE, 2, 0)
	kit.Animate(core, "Pulse", 0.5, 1.6, 0)
	kit.Circle(torso, 24, 16, 7, 7, WHITE, 0.1, 4)
	-- tête + visière + antenne
	kit.Line(body, 50, 12, 50, 2, 2, STEEL, 0, 5)
	local tip = kit.Circle(body, 50, 2, 6, 6, RED, 0, 6)
	kit.Animate(tip, "Pulse", 0.6, 2, 0)
	local head = kit.Part(body, 34, 8, 32, 24, white, { Radius = 8, Z = 6, Shine = true })
	local visor = kit.Part(head, 4, 7, 24, 10, DARKER, { Radius = 5, Z = 2 })
	for _, x in ipairs({ 7, 17 }) do
		local eye = kit.Box(visor, x - 3, 3, 6, 4, CYAN, 0, 2)
		kit.Round(eye, 2)
		kit.Animate(eye, "Pulse", 0.4, 1.2, x)
	end
	kit.Sparkle(body, 12, 16, 10, C.Butter, 0, 7)
	return { Glow = CYAN }
end

return Art
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="12">
              <Properties>
                <string name="Name">Cool92Gaming</string>
                <string name="Source"><![CDATA[--[[
	Cool92Gaming (ModuleScript) — (v9.2) coin gamer 🎮 + meubles "cool"
	(chaise de course, bureau gamer, pouf, casier, table de briques, lits
	superposés, lit voiture de course)
	Emplacement : ReplicatedStorage > Client > Components > House > Art > Cool92Gaming
	Contrat : voir HouseArt (boîte 100 x 100, pieds en bas pour les objets au sol).

	Style : même rendu "autocollant" que le reste (contours doux, reflets),
	mais en couleurs de gamer : bleu nuit, néons cyan / magenta / vert,
	rouge course. Les dessus des tables, sièges et lits sont déclarés dans
	House/HouseSurfaces (mêmes coordonnées).
]]

local Art = {}

local rgb = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)
local NAVY = rgb(52, 60, 100)
local DARK = rgb(44, 46, 64)
local DARKER = rgb(30, 32, 46)
local CYAN = rgb(60, 222, 255)
local MAGENTA = rgb(255, 84, 196)
local LIME = rgb(140, 240, 110)
local RED = rgb(236, 66, 76)
local ORANGE = rgb(255, 152, 56)
local STEEL = rgb(176, 186, 206)
local SCREEN = rgb(36, 40, 78)

----------------------------------------------------------------------
-- Petits outils
----------------------------------------------------------------------

-- Manette (vue de face) centrée en (cx, cy), largeur w
local function controller(kit, parent, cx, cy, w, color, z)
	local C = kit.C
	local zz = z or 3
	for _, side in ipairs({ -1, 1 }) do
		kit.Blob(parent, cx + side * w * 0.3, cy + w * 0.14, w * 0.34, w * 0.4, color, { Z = zz, Thickness = 1.2 })
	end
	local pad = kit.Part(parent, cx - w / 2, cy - w * 0.2, w, w * 0.38, color, { Radius = math.floor(w * 0.16), Z = zz + 1, Shine = true, Thickness = 1.3 })
	-- croix directionnelle
	local s = w * 0.06
	kit.Box(pad, w * 0.2 - s * 1.5, w * 0.19 - s / 2, s * 3, s, WHITE, 0.1, 3)
	kit.Box(pad, w * 0.2 - s / 2, w * 0.19 - s * 1.5, s, s * 3, WHITE, 0.1, 3)
	-- boutons
	for index, spec in ipairs({ { 0.8, 0.1, C.Butter }, { 0.88, 0.19, RED }, { 0.72, 0.19, CYAN }, { 0.8, 0.28, LIME } }) do
		kit.Circle(pad, w * spec[1], w * spec[2], s * 1.3, s * 1.3, spec[3], 0, 3)
		local _ = index
	end
	-- sticks
	kit.Circle(pad, w * 0.38, w * 0.27, s * 1.7, s * 1.7, DARKER, 0, 3)
	kit.Circle(pad, w * 0.62, w * 0.27, s * 1.7, s * 1.7, DARKER, 0, 3)
	return pad
end

-- Bande de LED qui respire (cyan -> magenta), ancrée en (x, y)
local function ledStrip(kit, parent, x, y, w, h, z)
	local strip = kit.Box(parent, x, y, w, h, WHITE, 0, z)
	kit.Round(strip)
	kit.Gradient(strip, CYAN, MAGENTA, 0)
	local glow = kit.Box(parent, x - 2, y - 2, w + 4, h + 4, CYAN, 0.7, (z or 2) - 1)
	kit.Round(glow)
	kit.Animate(glow, "Pulse", 0.25, 1.4, x)
	return strip
end

-- Ventilateur RGB (anneau lumineux + pales qui tournent)
local function fan(kit, parent, cx, cy, size, color, z, phase)
	local ring = kit.Circle(parent, cx, cy, size, size, DARKER, 0, z)
	kit.Stroke(ring, color, 2, 0)
	local halo = kit.Circle(parent, cx, cy, size + 4, size + 4, color, 0.75, z - 1)
	kit.Animate(halo, "Pulse", 0.2, 1.2, phase or 0)
	local rotor = kit.Pivot(ring, size / 2, size / 2, 2)
	for index = 0, 2 do
		-- une pale par pivot tourné (les enfants tournent autour du pivot)
		local arm = kit.Pivot(rotor, 0, 0, 1)
		arm.Rotation = index * 120
		local blade = kit.Box(arm, -size * 0.07, -size * 0.42, size * 0.14, size * 0.36, kit.Lighten(color, 0.3), 0.15, 1)
		kit.Round(blade)
	end
	kit.Circle(ring, size / 2, size / 2, size * 0.26, size * 0.26, color, 0, 3)
	kit.Animate(rotor, "Spin", 1, 0.8, phase or 0)
	return ring
end

----------------------------------------------------------------------
-- 🎮 Jeux vidéo
----------------------------------------------------------------------

-- Casque gamer sur son support (oreillettes RGB, micro)
Art.RGBHeadset = function(body, kit, _item)
	kit.Blob(body, 50, 94, 58, 12, DARK, { Z = 1, Shine = true })
	kit.Part(body, 46, 34, 8, 60, STEEL, { Radius = 4, Z = 2, Shine = true })
	kit.Blob(body, 50, 34, 30, 10, STEEL, { Z = 3 })
	-- arceau (moitié haute d'un anneau)
	local clip = kit.Group(body, 14, 8, 72, 40, 4, true)
	local band = kit.Part(clip, 3, 3, 66, 66, DARK, { Radius = -1, T = 1, Outline = DARK, Thickness = 8, Shade = false })
	local _ = band
	local pad = kit.Part(body, 32, 8, 36, 10, NAVY, { Radius = 5, Z = 5, Shine = true })
	kit.Box(pad, 8, 3, 20, 3, CYAN, 0.2, 3)
	-- oreillettes
	for index, side in ipairs({ -1, 1 }) do
		local cx = 50 + side * 34
		local halo = kit.Blob(body, cx, 60, 30, 38, index == 1 and CYAN or MAGENTA, { Z = 5, Outline = false, Shade = false, T = 0.55 })
		kit.Animate(halo, "Pulse", 0.35, 1.6, index * 1.7)
		local cup = kit.Blob(body, cx, 60, 24, 32, DARK, { Z = 6, Shine = true })
		local ring = kit.Blob(cup, 12, 16, 14, 20, DARKER, { Z = 2, Outline = index == 1 and CYAN or MAGENTA, Thickness = 2.5, Shade = false })
		kit.Diamond(ring, 7, 10, 5, index == 1 and CYAN or MAGENTA, 0, 2)
		kit.Line(body, cx, 26, cx, 44, 5, DARK, 0, 4)
	end
	-- micro
	kit.Line(body, 20, 70, 36, 84, 3, DARK, 0, 7)
	kit.Blob(body, 38, 85, 9, 7, DARKER, { Z = 8 })
	local tip = kit.Circle(body, 38, 85, 4, 4, LIME, 0, 9)
	kit.Animate(tip, "Pulse", 0.6, 1.2, 0)
	return { Glow = CYAN }
end

-- Console de salon + deux manettes
Art.ConsoleSet = function(body, kit, _item)
	local C = kit.C
	-- console (boîtier noir, bande lumineuse)
	local console = kit.Part(body, 14, 34, 72, 34, DARK, { Radius = 8, Z = 1, Shine = true })
	kit.Part(console, 4, 4, 64, 10, NAVY, { Radius = 4, Z = 2, Outline = false })
	local light = kit.Box(console, 8, 18, 40, 3, CYAN, 0, 3)
	kit.Round(light)
	kit.Animate(light, "Pulse", 0.5, 1.2, 0)
	kit.Box(console, 52, 18, 10, 3, WHITE, 0.3, 3)
	kit.Circle(console, 62, 26, 6, 6, LIME, 0, 3) -- bouton marche
	for index = 0, 4 do
		kit.Box(console, 8 + index * 6, 26, 3, 4, DARKER, 0, 3) -- aérations
	end
	-- câble
	kit.Line(body, 86, 60, 94, 84, 2, DARKER, 0, 1)
	-- deux manettes posées devant
	local red = controller(kit, body, 30, 82, 38, RED, 4)
	local blue = controller(kit, body, 70, 86, 38, rgb(80, 150, 255), 6)
	blue.Rotation = 8
	red.Rotation = -6
	kit.Sparkle(body, 90, 28, 10, C.Butter, 0, 8)
	return nil
end

-- Enseigne néon "GG" (bon match !) sur panneau sombre
Art.NeonGG = function(body, kit, _item)
	local C = kit.C
	local halo = kit.Part(body, 4, 18, 92, 64, MAGENTA, { Radius = 16, Z = 1, Outline = false, Shade = false, T = 0.72 })
	kit.Animate(halo, "Pulse", 0.2, 1.3, 0)
	local board = kit.Part(body, 8, 22, 84, 56, DARKER, { Radius = 12, Z = 2 })
	kit.Stroke(board, MAGENTA, 2.5, 0.1)
	for index = 0, 1 do
		kit.Circle(board, 8 + index * 68, 8, 4, 4, STEEL, 0, 2) -- vis
	end
	-- néon : lettres claires + halo cyan (copie floue derrière)
	local halo2 = kit.Text(board, "GG", 42, 28, 42, CYAN, 3)
	halo2.TextTransparency = 0.55
	local text = kit.Text(board, "GG", 42, 28, 38, rgb(210, 250, 255), 4)
	text.TextStrokeColor3 = CYAN
	text.TextStrokeTransparency = 0
	kit.Animate(halo2, "Bob", 1, 1.5, 0)
	kit.Animate(text, "Bob", 1, 1.5, 0)
	-- petite manette + étincelles néon
	local pad = controller(kit, body, 50, 76, 22, MAGENTA, 5)
	local _ = pad
	kit.Sparkle(body, 16, 30, 10, C.Butter, 0, 6)
	kit.Sparkle(body, 86, 72, 8, CYAN, 0, 6)
	return { Glow = CYAN, WallShadow = Vector2.new(84, 56) }
end

-- PC gamer : écran avec jeu, tour vitrée à ventilateurs RGB, clavier lumineux
Art.GamerPC = function(body, kit, _item)
	local C = kit.C
	-- tour
	local tower = kit.Part(body, 66, 20, 30, 76, DARK, { Radius = 6, Z = 1, Shine = true })
	local glass = kit.Part(tower, 4, 6, 22, 58, rgb(20, 24, 44), { Radius = 4, Z = 2, Outline = CYAN, Thickness = 1.2 })
	fan(kit, glass, 11, 14, 16, CYAN, 3, 0)
	fan(kit, glass, 11, 34, 16, MAGENTA, 3, 1.3)
	kit.Box(glass, 3, 46, 16, 6, LIME, 0.2, 3) -- carte graphique
	kit.Shine(glass, 2, 2, 4, 30, 5, 0.6)
	kit.Circle(tower, 15, 70, 5, 5, LIME, 0, 3)
	-- écran
	kit.Part(body, 34, 58, 8, 22, STEEL, { Radius = 3, Z = 2 })
	kit.Blob(body, 38, 84, 30, 8, STEEL, { Z = 3 })
	local monitor = kit.Part(body, 2, 14, 64, 46, DARKER, { Radius = 6, Z = 4 })
	local screen = kit.Part(monitor, 4, 4, 56, 36, SCREEN, { Radius = 4, Z = 2, Outline = false })
	kit.Gradient(screen, rgb(120, 170, 255), rgb(255, 150, 200), 90)
	-- jeu : montagnes, héros, pièce
	kit.Triangle(screen, 16, 16, 26, 20, rgb(90, 90, 170), 2)
	kit.Triangle(screen, 38, 12, 30, 24, rgb(110, 100, 190), 2)
	kit.Box(screen, 0, 30, 56, 6, LIME, 0, 3)
	local hero = kit.Part(screen, 22, 20, 8, 10, RED, { Radius = 3, Z = 4, Thickness = 1 })
	kit.Animate(hero, "Bob", 2, 2, 0)
	local coin = kit.Circle(screen, 40, 14, 6, 6, C.Butter, 0, 4)
	kit.Animate(coin, "Bob", 1.5, 2.5, 1)
	kit.Text(screen, "x99", 10, 6, 7, WHITE, 5)
	-- clavier lumineux + souris
	ledStrip(kit, body, 6, 94, 56, 2, 5)
	local keyboard = kit.Part(body, 4, 84, 60, 11, DARK, { Radius = 3, Z = 6 })
	for index = 0, 9 do
		local key = kit.Box(keyboard, 3 + index * 5.6, 3, 4, 4, index % 2 == 0 and CYAN or MAGENTA, 0.15, 2)
		kit.Round(key, 1)
	end
	local mouse = kit.Blob(body, 60, 90, 10, 12, DARK, { Z = 7 })
	kit.Box(mouse, 4.5, 2, 1, 4, LIME, 0, 2)
	return { Glow = CYAN }
end

-- Télé géante (au mur) : jeu de course à l'écran, barre de son
Art.BigScreenTV = function(body, kit, _item)
	local C = kit.C
	local frame = kit.Part(body, 2, 18, 96, 58, DARKER, { Radius = 5, Z = 1 })
	local screen = kit.Group(frame, 3, 3, 90, 50, 2, true)
	local sky = kit.Box(screen, 0, 0, 90, 50, WHITE, 0, 1)
	kit.Gradient(sky, rgb(90, 150, 255), rgb(255, 176, 150), 90)
	kit.Circle(screen, 70, 16, 14, 14, C.Butter, 0, 2) -- soleil
	kit.Triangle(screen, 20, 12, 40, 16, rgb(120, 110, 200), 2)
	kit.Triangle(screen, 72, 14, 50, 14, rgb(100, 100, 190), 2)
	kit.Box(screen, 0, 26, 90, 24, rgb(110, 200, 110), 0, 3)
	-- route en perspective + bandes blanches qui défilent
	kit.Triangle(screen, 45, 22, 70, 28, rgb(80, 84, 100), 4, 0, 14)
	for index = 0, 2 do
		local dash = kit.Box(screen, 44, 28 + index * 7, 2 + index, 4 + index, WHITE, 0.1, 5)
		kit.Animate(dash, "Pulse", 0.8, 3, index * 0.8)
	end
	-- voiture du joueur
	local car = kit.Part(screen, 36, 38, 18, 9, RED, { Radius = 4, Z = 6, Thickness = 1 })
	kit.Box(car, 4, 1, 10, 3, CYAN, 0.2, 2)
	kit.Animate(car, "Drift", 2, 1.2, 0)
	-- compteur
	local hud = kit.Part(screen, 4, 4, 24, 11, DARKER, { Radius = 3, Z = 7, T = 0.25, Outline = false })
	kit.Text(hud, "1ST", 12, 5.5, 8, C.Butter, 3)
	local speed = kit.Part(screen, 62, 4, 24, 11, DARKER, { Radius = 3, Z = 7, T = 0.25, Outline = false })
	kit.Text(speed, "240", 12, 5.5, 8, CYAN, 3)
	-- pied mural + barre de son
	kit.Part(body, 22, 78, 56, 7, DARK, { Radius = 3, Z = 2 })
	for index = 0, 6 do
		kit.Circle(body, 28 + index * 7.4, 81.5, 3, 3, DARKER, 0, 3)
	end
	local led = kit.Circle(body, 92, 72, 3, 3, LIME, 0, 3)
	kit.Animate(led, "Pulse", 0.6, 1, 0)
	return { Glow = rgb(150, 200, 255), WallShadow = Vector2.new(96, 64) }
end

-- Borne d'arcade néon (fronton lumineux, envahisseur à l'écran, joystick)
Art.NeonArcade = function(body, kit, _item)
	local C = kit.C
	local cabinet = kit.Part(body, 14, 6, 72, 94, DARKER, { Radius = 8, Z = 1, Shine = true })
	for _, x in ipairs({ 14, 82 }) do
		kit.Box(body, x, 12, 4, 86, x < 50 and CYAN or MAGENTA, 0.1, 2) -- flancs néon
	end
	local _ = cabinet
	-- fronton
	local marquee = kit.Part(body, 18, 8, 64, 16, NAVY, { Radius = 5, Z = 3 })
	kit.Gradient(marquee, rgb(255, 120, 220), rgb(120, 140, 255), 0)
	local title = kit.Text(marquee, "ARCADE", 32, 8, 11, WHITE, 3)
	title.TextStrokeColor3 = MAGENTA
	title.TextStrokeTransparency = 0
	local bulbs = {}
	for index = 0, 4 do
		local color = index % 2 == 0 and CYAN or C.Butter
		local halo = kit.Circle(body, 22 + index * 14, 27, 8, 8, color, 0.6, 4)
		local bulb = kit.Circle(body, 22 + index * 14, 27, 4, 4, color, 0, 5)
		bulb:SetAttribute("Phase", index * 0.8)
		table.insert(bulbs, bulb)
		table.insert(bulbs, halo)
	end
	-- écran : envahisseur en pixels + score
	local screen = kit.Part(body, 22, 32, 56, 34, rgb(16, 20, 40), { Radius = 5, Z = 3, Outline = CYAN, Thickness = 1.5 })
	local invader = kit.Group(screen, 18, 8, 22, 16, 2)
	local pixels = { "0100010", "0011100", "0111110", "1101011", "1111111", "1010101" }
	for row, line in ipairs(pixels) do
		for col = 1, #line do
			if string.sub(line, col, col) == "1" then
				kit.Box(invader, (col - 1) * 3, (row - 1) * 2.6, 3, 2.6, LIME, 0, 1)
			end
		end
	end
	kit.Animate(invader, "Drift", 8, 1.2, 0)
	kit.Text(screen, "HI 9990", 28, 5, 6, C.Butter, 4)
	kit.Box(screen, 24, 28, 8, 3, CYAN, 0, 3) -- vaisseau
	-- tableau de commandes
	local panel = kit.Part(body, 16, 66, 68, 12, NAVY, { Radius = 4, Z = 4, Shine = true })
	kit.Line(panel, 16, 6, 14, -4, 2.5, STEEL, 0, 2)
	kit.Circle(panel, 14, -5, 7, 7, RED, 0, 3)
	for index, color in ipairs({ CYAN, MAGENTA, LIME, C.Butter }) do
		kit.Circle(panel, 34 + index * 7, 6, 5.5, 5.5, color, 0, 3)
	end
	-- trappe à pièces lumineuse
	local door = kit.Part(body, 36, 82, 28, 14, DARK, { Radius = 3, Z = 3 })
	for index = 0, 1 do
		local slot = kit.Box(door, 7 + index * 10, 4, 4, 6, ORANGE, 0, 2)
		kit.Animate(slot, "Pulse", 0.5, 1.5, index)
	end
	return { Bulbs = bulbs, Glow = MAGENTA }
end

-- Casque de réalité virtuelle pro sur présentoir, deux manettes anneaux
Art.VRHeadset = function(body, kit, _item)
	local C = kit.C
	-- présentoir
	kit.Part(body, 24, 64, 52, 30, WHITE, { Radius = 6, Z = 1, Shine = true })
	kit.Box(body, 24, 88, 52, 6, STEEL, 0, 2)
	kit.Blob(body, 50, 64, 56, 10, rgb(236, 240, 250), { Z = 2 })
	-- casque
	local strap = kit.Part(body, 22, 24, 56, 40, DARK, { Radius = 18, Z = 3, T = 1, Outline = DARK, Thickness = 5, Shade = false })
	local _ = strap
	local visor = kit.Part(body, 14, 30, 72, 30, WHITE, { Radius = 14, Z = 4, Shine = true })
	local glass = kit.Part(visor, 6, 5, 60, 18, DARKER, { Radius = 9, Z = 2 })
	kit.Gradient(glass, rgb(60, 80, 150), rgb(20, 24, 50), 90)
	local stripe = kit.Box(glass, 6, 7, 48, 3, CYAN, 0, 3)
	kit.Round(stripe)
	kit.Animate(stripe, "Pulse", 0.6, 1.3, 0)
	kit.Shine(glass, 6, 2, 16, 3, 4, 0.4)
	for _, x in ipairs({ 16, 44 }) do
		kit.Circle(glass, x, 13, 3, 3, MAGENTA, 0.2, 3)
	end
	-- manettes anneaux
	for index, side in ipairs({ -1, 1 }) do
		local cx = 50 + side * 40
		local ring = kit.Blob(body, cx, 78, 20, 20, WHITE, { Z = 5, T = 1, Outline = STEEL, Thickness = 3, Shade = false })
		local _r = ring
		kit.Part(body, cx - 4, 78, 8, 20, DARK, { Radius = 4, Z = 6, Shine = true })
		local led = kit.Circle(body, cx, 70, 4, 4, index == 1 and CYAN or MAGENTA, 0, 7)
		kit.Animate(led, "Pulse", 0.5, 1.5, index)
	end
	kit.Sparkle(body, 88, 22, 12, C.Butter, 0, 8)
	kit.Sparkle(body, 12, 20, 8, CYAN, 0, 8)
	return nil
end

-- Simulateur de course : siège baquet, volant, pédalier, écran
Art.RacingRig = function(body, kit, _item)
	local C = kit.C
	-- châssis
	kit.Part(body, 2, 90, 96, 8, DARK, { Radius = 3, Z = 1, Shine = true })
	kit.Part(body, 60, 44, 6, 48, STEEL, { Radius = 2, Z = 2 })
	-- écran au-dessus
	kit.Part(body, 76, 22, 4, 30, STEEL, { Radius = 2, Z = 1 })
	local screen = kit.Part(body, 56, 4, 42, 26, DARKER, { Radius = 4, Z = 2 })
	local view = kit.Group(screen, 3, 3, 36, 20, 2, true)
	local sky = kit.Box(view, 0, 0, 36, 20, WHITE, 0, 1)
	kit.Gradient(sky, rgb(100, 160, 255), rgb(255, 190, 150), 90)
	kit.Triangle(view, 18, 8, 34, 12, rgb(80, 84, 100), 2, 0, 8)
	kit.Box(view, 17, 12, 2, 3, WHITE, 0, 3)
	kit.Box(view, 16.5, 16, 3, 4, WHITE, 0, 3)
	-- siège baquet (rouge et noir)
	local seat = kit.Part(body, 6, 24, 38, 60, DARKER, { Radius = 14, Z = 3, Shine = true })
	kit.Part(seat, 8, 4, 22, 14, RED, { Radius = 6, Z = 2 })
	kit.Box(seat, 10, 22, 4, 34, RED, 0, 2)
	kit.Box(seat, 24, 22, 4, 34, RED, 0, 2)
	kit.Circle(seat, 19, 10, 5, 5, WHITE, 0.2, 3)
	kit.Part(body, 8, 70, 50, 16, DARK, { Radius = 7, Z = 4, Shine = true }) -- assise
	kit.Box(body, 14, 72, 38, 3, RED, 0, 5)
	-- volant sur sa colonne
	kit.Line(body, 63, 48, 54, 52, 5, STEEL, 0, 5)
	local wheel = kit.Blob(body, 52, 52, 22, 22, WHITE, { Z = 6, T = 1, Outline = DARKER, Thickness = 4, Shade = false })
	local hub = kit.Blob(wheel, 11, 11, 9, 9, DARKER, { Z = 2 })
	kit.Circle(hub, 4.5, 4.5, 3, 3, RED, 0, 2)
	kit.Animate(wheel, "Sway", 8, 1.2, 0)
	-- pédalier
	kit.Part(body, 76, 76, 16, 14, DARK, { Radius = 3, Z = 3 })
	for index = 0, 1 do
		kit.Part(body, 78 + index * 7, 70, 5, 10, STEEL, { Radius = 2, Z = 4, Rotation = -12 })
	end
	kit.Sparkle(body, 48, 16, 9, C.Butter, 0, 7)
	return nil
end

----------------------------------------------------------------------
-- 🛋️ Meubles cool (tables, sièges, lits)

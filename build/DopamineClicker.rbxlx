	local headlight = box({ Name = "Headlight", Position = UDim2.fromOffset(65, 29), Size = UDim2.fromOffset(4, 3), BackgroundColor3 = Color3.fromRGB(255, 236, 150), ZIndex = 13, Parent = van })
	UIUtil.Corner(headlight, 1)

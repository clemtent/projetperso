DETAILS.HeartDoor = doorDetail(C.Pink, 0.34)
DETAILS.CandyDoor = doorDetail(Color3.fromRGB(255, 170, 205), 0.34)
DETAILS.GardenDoor = doorDetail(Color3.fromRGB(140, 210, 160), 0.3)


	------------------------------------------------------------------
	local rotorHolder = frame({
		Name = "RotorHolder",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(hubX, hubY),
		Size = UDim2.fromOffset(reach * 2, reach * 2),
		BackgroundTransparency = 1,
		ZIndex = 7,
		Parent = card,
	})
	-- Ombre douce de la roue sur le ciel
	local rotorShadow = centered({
		Name = "Shadow",
		BackgroundColor3 = BLACK,
		BackgroundTransparency = 0.93,
		ZIndex = 1,
		Parent = rotorHolder,
	}, reach + 3, reach + 5, reach * 1.7, reach * 1.7)
	round(rotorShadow)

	local rotor = frame({
		Name = "Rotor",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = rotorHolder,
	})
	local foldSize = math.floor(BLADE * 0.8)
	for index, color in ipairs(BLADE_COLORS) do
		local bladeHolder = frame({
			Name = "Blade" .. index,
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Rotation = (index - 1) * 90,
			ZIndex = 2,
			Parent = rotor,
		})
		-- Triangle principal (moitié bas-gauche du carré, sommet au moyeu) :
		-- sombre dans le creux de la courbure, vif près de la pliure
		local main = frame({
			Name = "Main",
			Position = UDim2.fromOffset(reach, reach),
			Size = UDim2.fromOffset(BLADE, BLADE),
			BackgroundColor3 = WHITE,
			ZIndex = 2,
			Parent = bladeHolder,
		})
		local mainGradient = UIUtil.Gradient(main, ColorSequence.new({
			ColorSequenceKeypoint.new(0, color:Lerp(BLACK, 0.3)),
			ColorSequenceKeypoint.new(0.3, color),
			ColorSequenceKeypoint.new(0.5, color:Lerp(WHITE, 0.25)),
			ColorSequenceKeypoint.new(1, color),
		}), -45)
		mainGradient.Transparency = halfTransparency(true)
		-- Petits pois blancs (dans le triangle : y > x)
		for d, spec in ipairs({ { 0.24, 0.7, 6 }, { 0.5, 0.86, 4 } }) do
			local dot = centered({
				Name = "Dot" .. d,
				BackgroundColor3 = WHITE,
				BackgroundTransparency = 0.3,
				ZIndex = 3,
				Parent = main,
			}, BLADE * spec[1], BLADE * spec[2], spec[3], spec[3])
			round(dot)
		end
		-- Rabat (moitié haut-droite d'un carré plus petit) : papier plié, plus clair
		local fold = frame({
			Name = "Fold",
			Position = UDim2.fromOffset(reach, reach),
			Size = UDim2.fromOffset(foldSize, foldSize),
			BackgroundColor3 = WHITE,
			ZIndex = 4,
			Parent = bladeHolder,
		})
		local foldGradient = UIUtil.Gradient(fold, ColorSequence.new({
			ColorSequenceKeypoint.new(0, color:Lerp(WHITE, 0.7)),
			ColorSequenceKeypoint.new(0.5, color:Lerp(WHITE, 0.62)),
			ColorSequenceKeypoint.new(1, color:Lerp(WHITE, 0.18)),
		}), -45)
		foldGradient.Transparency = halfTransparency(false)
		-- Pliure brillante (diagonale du moyeu vers la pointe)
		local creaseLength = foldSize * math.sqrt(2)
		local crease = frame({
			Name = "Crease",
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromOffset(reach + foldSize / 2 - creaseLength / 2, reach + foldSize / 2),
			Size = UDim2.fromOffset(creaseLength, 2),
			Rotation = 45,
			BackgroundColor3 = WHITE,
			ZIndex = 5,
			Parent = bladeHolder,
		})
		UIUtil.Create("UIGradient", { Color = ColorSequence.new(WHITE), Transparency = FADE_ENDS, Parent = crease })
	end

	-- Disque "flou" coloré (apparaît quand ça tourne vite)
	local blur = centered({
		Name = "Blur",
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 1,
		ZIndex = 6,
		Parent = rotorHolder,
	}, reach, reach, reach * 1.85, reach * 1.85)
	round(blur)
	local blurColors = {}
	for i, color in ipairs(BLADE_COLORS) do
		table.insert(blurColors, ColorSequenceKeypoint.new((i - 1) / #BLADE_COLORS, color:Lerp(WHITE, 0.35)))
	end
	table.insert(blurColors, ColorSequenceKeypoint.new(1, BLADE_COLORS[1]:Lerp(WHITE, 0.35)))
	local blurGradient = UIUtil.Gradient(blur, ColorSequence.new(blurColors), 0)
	local blurStroke = UIUtil.Stroke(blur, WHITE, 3, 1)

	-- Moyeu : rosace + perle vernie + reflet
	local rosette = centered({ Name = "Rosette", BackgroundColor3 = WHITE, BackgroundTransparency = 0.15, ZIndex = 7, Parent = rotorHolder }, reach, reach, 24, 24)
	round(rosette)
	local hub = centered({ Name = "Hub", BackgroundColor3 = WHITE, ZIndex = 8, Parent = rotorHolder }, reach, reach, 16, 16)
	round(hub)
	UIUtil.Gradient(hub, ColorSequence.new(Color3.fromRGB(255, 236, 244), Color3.fromRGB(236, 90, 130)), 45)
	UIUtil.Stroke(hub, Color3.fromRGB(120, 30, 60), 1.5, 0.2)
	local hubShine = centered({ Name = "Shine", BackgroundColor3 = WHITE, BackgroundTransparency = 0.1, ZIndex = 9, Parent = hub }, 5.5, 5.5, 5, 4)
	round(hubShine)

	------------------------------------------------------------------
	-- Lignes de vent + étincelles (réserves recyclées)
	------------------------------------------------------------------
	local winds = {}
	for i = 1, WIND_POOL do
		local line = frame({
			Name = "Wind" .. i,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(30, 2),
			BackgroundColor3 = Color3.fromRGB(246, 252, 255),
			Visible = false,
			ZIndex = 11,
			Parent = card,
		})
		round(line)
		UIUtil.Create("UIGradient", { Color = ColorSequence.new(WHITE), Transparency = FADE_ENDS, Parent = line })
		winds[i] = { Frame = line, Active = false, X = 0, Y = 0, Speed = 0, Life = 0, MaxLife = 1, Phase = 0 }
	end

	local function spawnWind()
		for _, wind in ipairs(winds) do
			if not wind.Active then
				wind.Active = true
				wind.X = -20
				wind.Y = random:NextNumber(12, height - 50)
				wind.Speed = random:NextNumber(220, 320)
				wind.MaxLife = (width + 40) / wind.Speed
				wind.Life = 0
				wind.Phase = random:NextNumber(0, math.pi * 2)
				wind.Frame.Size = UDim2.fromOffset(random:NextNumber(22, 40), 2)
				wind.Frame.Visible = true
				return
			end
		end
	end

	local sparkles: { TextLabel } = {}
	local SPARKLE_COLORS = { Color3.fromRGB(255, 214, 60), WHITE, Color3.fromRGB(255, 150, 196) }
	for i = 1, SPARKLE_POOL do
		local sparkle = UIUtil.Create("TextLabel", {
			Name = "Sparkle" .. i,
			Text = "✨",
			Font = Theme.Fonts.Title,
			TextSize = 16,
			TextColor3 = SPARKLE_COLORS[(i - 1) % #SPARKLE_COLORS + 1],
			TextStrokeColor3 = Color3.fromRGB(200, 120, 40),
			TextStrokeTransparency = 1, -- (emoji ✨ : pas de contour)
			TextTransparency = 1,
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(hubX, hubY),
			Size = UDim2.fromOffset(20, 20),
			ZIndex = 13,
			Parent = card,
		})
		sparkles[i] = sparkle
	end
	local nextSparkle = 1

	-- Gerbe d'étincelles autour du moyeu (ou d'un autre point : x, y, portée)
	local function sparkleBurst(count: number, x: number?, y: number?, reach: number?)
		local originX, originY = x or hubX, y or hubY
		local far = reach or 56
		for _ = 1, count do
			local sparkle = sparkles[nextSparkle]
			nextSparkle = nextSparkle % #sparkles + 1
			local a = random:NextNumber(0, math.pi * 2)
			local distance = random:NextNumber(far * 0.6, far)
			sparkle.Position = UDim2.fromOffset(originX, originY)
			sparkle.TextTransparency = 0
			sparkle.TextStrokeTransparency = 1
			sparkle.TextSize = random:NextInteger(12, 18)
			sparkle.Rotation = 0
			UIUtil.Tween(sparkle, random:NextNumber(0.45, 0.65), {
				Position = UDim2.fromOffset(originX + math.cos(a) * distance, originY + math.sin(a) * distance),
				TextTransparency = 1,
				TextStrokeTransparency = 1,
				Rotation = random:NextNumber(-120, 120),
				TextSize = 6,
			}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		end
	end

	------------------------------------------------------------------
	-- Pastilles : compteur (cadran + tr/min), indice, décollage
	------------------------------------------------------------------
	local chip = frame({
		Name = "RpmChip",
		Position = UDim2.fromOffset(6, 6),
		Size = UDim2.fromOffset(72, 18),
		BackgroundColor3 = Color3.fromRGB(34, 28, 58),
		BackgroundTransparency = 0.08,
		ZIndex = 12,
		Parent = card,
	})
	round(chip)
	UIUtil.Gradient(chip, ColorSequence.new(WHITE, Color3.fromRGB(170, 170, 190)), 90)
	UIUtil.Stroke(chip, WHITE, 1, 0.55)
	local dial = centered({ Name = "Dial", BackgroundColor3 = Color3.fromRGB(18, 14, 34), ZIndex = 12, Parent = chip }, 10, 9, 12, 12)
	round(dial)
	local dialStroke = UIUtil.Stroke(dial, Theme.Colors.Green, 1.5, 0)
	local needle = frame({
		Name = "Needle",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(1.5, 5),
		BackgroundColor3 = WHITE,
		ZIndex = 13,
		Parent = dial,
	})
	local rpmFormat = Locale.T("%d rpm")
	local rpmLabel = UIUtil.Label({
		Name = "Rpm",
		Text = Locale.T("%d rpm", 12),
		Font = Theme.Fonts.Number,
		TextColor3 = WHITE,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(20, 2),
		Size = UDim2.new(1, -24, 1, -4),
		MaxTextSize = 11,
		ZIndex = 13,
		Parent = chip,
	})

	local hint = UIUtil.Label({
		Name = "Hint",
		Text = Locale.T("Blow! 🌬️"),
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.TextDark,
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.05,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromOffset(width - 6, height - 24),
		Size = UDim2.fromOffset(54, 18),
		MaxTextSize = 11,
		ZIndex = 12,
		Parent = card,
	})
	round(hint)
	local hintStroke = UIUtil.Stroke(hint, Theme.Colors.Border, 1, 0.5)

	local liftLabel = UIUtil.Label({
		Name = "Lift",
		Text = "",
		Font = Enum.Font.LuckiestGuy,
		TextColor3 = Theme.Colors.Yellow,
		TextTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromOffset(hubX, 28),
		Size = UDim2.fromOffset(width - 16, 18),
		MaxTextSize = 15,
		ZIndex = 14,
		Parent = card,
	})
	local liftStroke = UIUtil.Stroke(liftLabel, Theme.Colors.TextDark, 2, 1)
	liftStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual

	------------------------------------------------------------------
	-- Interaction (toute la carte est cliquable)
	------------------------------------------------------------------
	local button = Create("TextButton", {
		Name = "Blow",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 20,
		Parent = card,
	})

	local speed = BASE_SPEED
	local baseSpeed = BASE_SPEED -- vitesse de repos (monte avec WindPower)
	local angle = random:NextNumber(0, 90)
	local lastInteract = -math.huge
	local gustTimer = random:NextNumber(5, 10)
	local rpmTimer = 0
	local windTimer = 0
	local lifting = false
	local blown = false
	local clock = 0

	local function blow()
		speed = math.min(MAX_SPEED, speed + BOOST)
		cardScale.Scale = 0.94
		UIUtil.Tween(cardScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		ctx.Sound.Play("Open", random:NextNumber(1.1, 1.4))
		local fx = effectsOn()
		for _ = 1, fx and 3 or 1 do
			spawnWind()
		end
		sparkleBurst(fx and 4 or 2)
		-- Petit "pop" du moyeu
		hub.Size = UDim2.fromOffset(21, 21)
		UIUtil.Tween(hub, 0.3, { Size = UDim2.fromOffset(16, 16) }, Enum.EasingStyle.Back)
		if not blown then
			blown = true
			UIUtil.Tween(hint, 0.3, { TextTransparency = 1, BackgroundTransparency = 1 })
			UIUtil.Tween(hintStroke, 0.3, { Transparency = 1 })
		end
		local now = os.clock()
		if now - lastInteract >= cooldown then
			lastInteract = now
			ctx.Interact("Spin")
		end
	end
	ctx.Connect(button.Activated, blow)

	ctx.OnBonus("Spin", function(payload)
		local amount = tonumber(payload.Amount)
		if amount then
			floatOnOverlay(card, width, Vector2.new(hubX, hubY - 30), "+" .. ctx.Format.Format(amount), Theme.Colors.Gold, 26)
		end
	end)

	------------------------------------------------------------------
	-- v9 : niveau d'énergie éolienne (WindPower), appliqué en direct
	------------------------------------------------------------------
	local windLevel = -1
	local ambientWind = 0
	local sceneryClock = 0
	local energyClock = 0
	local lampOn = false

	-- Position du moyeu d'une éolienne (coordonnées de la carte)
	local function turbineHub(turbine): (number, number)
		local def = turbine.Def
		return def.X, def.Ground + 6 - (def.H + 6) * turbine.Scale.Scale
	end

	local function applyWind(level: number, animate: boolean)
		level = math.clamp(math.floor(level), 0, 10)
		if level == windLevel then
			return
		end
		local previousLevel = windLevel
		windLevel = level
		baseSpeed = BASE_SPEED + level * WIND_SPEED_PER_LEVEL
		-- Niveaux 7 à 10 : les éoliennes grandissent
		local grow = 1 + 0.08 * math.max(0, level - #TURBINES)
		for index, turbine in ipairs(turbines) do
			local show = level >= index
			turbine.Lamp.Visible = show and level >= 7
			if show and not turbine.Shown then
				turbine.Shown = true
				turbine.Root.Visible = true
				if animate then
					-- Sort de terre avec des étincelles
					turbine.Scale.Scale = 0.05
					UIUtil.Tween(turbine.Scale, 0.7, { Scale = grow }, Enum.EasingStyle.Back)
					local def = turbine.Def
					sparkleBurst(effectsOn() and 5 or 2, def.X, def.Ground - def.H * 0.7, 26)
				else
					turbine.Scale.Scale = grow
				end
			elseif show then
				if animate and math.abs(turbine.Scale.Scale - grow) > 0.001 then
					UIUtil.Tween(turbine.Scale, 0.5, { Scale = grow }, Enum.EasingStyle.Back)
				else
					turbine.Scale.Scale = grow
				end
			elseif turbine.Shown then
				turbine.Shown = false
				turbine.Root.Visible = false
			end
		end
		-- Niveau acheté : coup de vent pour qu'on le voie
		if animate and previousLevel >= 0 and level > previousLevel then
			speed = math.min(MAX_SPEED, speed + 450)
			for _ = 1, effectsOn() and 4 or 1 do
				spawnWind()
			end
		end
	end
	applyWind(tonumber(ctx.GetLevel("WindPower")) or 0, false)
	ctx.Connect(ctx.State.Changed, function()
		applyWind(tonumber(ctx.GetLevel("WindPower")) or 0, true)
	end)

	------------------------------------------------------------------
	-- Animation
	------------------------------------------------------------------
	local restPosition = UDim2.fromOffset(hubX, hubY)
	local SLOW_COLOR = Theme.Colors.Green
	local MID_COLOR = Theme.Colors.Yellow
	local FAST_COLOR = Theme.Colors.Red

	ctx.OnRender(function(dt: number)
		dt = math.min(dt, 0.1)
		clock += dt
		local fx = effectsOn()

		-- Coups de vent naturels
		gustTimer -= dt
		if gustTimer <= 0 then
			gustTimer = random:NextNumber(6, 12) / (1 + math.max(0, windLevel) * 0.12)
			speed = math.min(MAX_SPEED, speed + random:NextNumber(150, 300))
			if fx then
				spawnWind()
				spawnWind()
			end
		end

		-- Retour progressif au calme
		speed = baseSpeed + (speed - baseSpeed) * math.exp(-dt * DECAY)
		angle = (angle + speed * dt) % 360
		rotor.Rotation = angle

		-- Disque flou coloré (tourne avec la roue)
		local fast = math.clamp((speed - 450) / 1500, 0, 1)
		blur.BackgroundTransparency = 1 - fast * 0.5
		blurStroke.Transparency = 1 - fast * 0.6
		blurGradient.Rotation = angle

		-- Lignes de vent continues quand ça tourne vite
		if fx and speed > 700 then
			windTimer -= dt * (speed / 900)
			if windTimer <= 0 then
				windTimer = random:NextNumber(0.16, 0.3)
				spawnWind()
			end
		end
		-- v9 : vent ambiant (WindPower) : lignes de vent de plus en plus fréquentes
		if fx and windLevel > 0 then
			ambientWind -= dt * (0.25 + windLevel * 0.3)
			if ambientWind <= 0 then
				ambientWind = random:NextNumber(0.7, 1.3)
				spawnWind()
			end
		end
		-- Éoliennes : les pales tournent avec le vent, feux rouges (7+), éclairs d'énergie (10)
		if windLevel > 0 then
			local turbineSpin = 70 + windLevel * 16 + math.max(0, speed - baseSpeed) * 0.12
			for _, turbine in ipairs(turbines) do
				if turbine.Shown then
					turbine.Angle = (turbine.Angle + turbineSpin * turbine.Speed * dt) % 360
				end
			end
			if windLevel >= 7 then
				local on = (clock % 1.4) < 0.3
				if on ~= lampOn then
					lampOn = on
					for _, turbine in ipairs(turbines) do
						turbine.Lamp.BackgroundTransparency = on and 0 or 0.75
					end
				end
			end
			if windLevel >= 10 and fx then
				energyClock -= dt
				if energyClock <= 0 then
					energyClock = random:NextNumber(0.5, 1.1)
					local turbine = turbines[random:NextInteger(1, #turbines)]
					if turbine.Shown then
						local x, y = turbineHub(turbine)
						sparkleBurst(1, x, y, 16)
					end
				end
			end
		end
		for _, wind in ipairs(winds) do
			if wind.Active then
				wind.Life += dt
				wind.X += wind.Speed * dt
				local life = wind.Life / wind.MaxLife
				if life >= 1 then
					wind.Active = false
					wind.Frame.Visible = false
				else
					local wave = math.sin(wind.Phase + wind.Life * 9) * 4
					wind.Frame.Position = UDim2.fromOffset(wind.X, wind.Y + wave)
					wind.Frame.Rotation = math.cos(wind.Phase + wind.Life * 9) * 8
					wind.Frame.BackgroundTransparency = 0.15 + 0.85 * life * life
				end
			end
		end

		-- Décollage (tremble et monte un peu quand c'est très rapide)
		local liftAmount = math.clamp((speed - 1500) / 1000, 0, 1)
		if liftAmount > 0 then
			rotorHolder.Position = UDim2.fromOffset(
				hubX + random:NextNumber(-1.5, 1.5) * liftAmount,
				hubY - liftAmount * 6 + random:NextNumber(-1.5, 1.5) * liftAmount
			)
			stick.Rotation = math.sin(clock * 40) * 2 * liftAmount
		elseif rotorHolder.Position ~= restPosition then
			rotorHolder.Position = restPosition
			stick.Rotation = 0
		end
		if liftAmount > 0.3 and not lifting then
			lifting = true
			local liftTexts = Locale.Pick(LIFT_TEXTS)
			liftLabel.Text = liftTexts[random:NextInteger(1, #liftTexts)]
			UIUtil.Tween(liftLabel, 0.2, { TextTransparency = 0 })
			UIUtil.Tween(liftStroke, 0.2, { Transparency = 0 })
		elseif liftAmount < 0.1 and lifting then
			lifting = false
			UIUtil.Tween(liftLabel, 0.4, { TextTransparency = 1 })
			UIUtil.Tween(liftStroke, 0.4, { Transparency = 1 })
		end

		-- Nuages, soleil, fleur qui se balance dans le vent
		for _, cloud in ipairs(clouds) do
			cloud.X += cloud.Speed * dt * (1 + math.max(0, windLevel) * 0.15)
			if cloud.X > width + 30 then
				cloud.X = -30
			end
		end
		-- Décor (CanvasGroup redessiné à chaque changement) : 30 fois par seconde
		sceneryClock += dt
		if sceneryClock >= 1 / 30 then
			sceneryClock = 0
			for _, cloud in ipairs(clouds) do
				cloud.Frame.Position = UDim2.fromOffset(cloud.X, cloud.Y)
			end
			sunGlow.BackgroundTransparency = 0.6 + 0.12 * math.sin(clock * 1.3)
			for _, turbine in ipairs(turbines) do
				if turbine.Shown then
					turbine.Rotor.Rotation = turbine.Angle
				end
			end
		end
		flower.Rotation = math.sin(clock * (1.5 + fast * 6)) * (6 + fast * 14)

		-- Compteur : aiguille, couleur du cadran, tours / minute (degrés/s ÷ 6)
		local ratio = math.clamp((speed - BASE_SPEED) / (MAX_SPEED - BASE_SPEED), 0, 1)
		needle.Rotation = -120 + ratio * 240
		rpmTimer -= dt
		if rpmTimer <= 0 then
			rpmTimer = 0.12
			rpmLabel.Text = string.format(rpmFormat, math.floor(speed / 6 + 0.5))
			dialStroke.Color = ratio < 0.5 and SLOW_COLOR:Lerp(MID_COLOR, ratio * 2) or MID_COLOR:Lerp(FAST_COLOR, (ratio - 0.5) * 2)
		end

		-- L'indice "Souffle !" se dandine tant qu'on n'a pas soufflé
		if not blown then
			hint.Rotation = math.sin(clock * 3) * 4
		end
	end)
end

function Pinwheel.Stop(_ctx)
	-- Tout est dans ctx.Container (détruit par le StimulusManager)
end

return Pinwheel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="161">
          <Properties>
            <string name="Name">Press</string>
            <string name="Source"><![CDATA[--[[
	Press (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > Press

	Une vraie petite chaîne d'écrasement, en boucle, très satisfaisante :
	  - un tapis roulant (bande qui défile, rouleaux qui tournent, pieds)
	    amène les objets un par un sous la presse ; la file d'attente est
	    variée (macarons, canette, pastèque, gâteau, cadeau, gelée, éponge,
	    Rubik's cube, canard, ballon, pot de peinture... + objets propres au
	    palier), tous DESSINÉS en Frames : ils se déforment vraiment ;
	  - la presse : deux colonnes ombrées façon métal, traverse avec bande
	    d'accent et boulons, vérin (chemise + tige chromée), plateau guidé
	    par les colonnes, enclume ; centrale hydraulique à gauche (moteur,
	    réservoir avec voyant d'huile), deux flexibles jusqu'au vérin,
	    manomètres gradués (aiguille qui grimpe dans le rouge) ;
	  - le cycle : chargement (le tapis avance), descente, compression (l'objet
	    se tasse et s'élargit en tremblant), CRUNCH (écrasement avec rebond,
	    onde de choc, éclats, étincelles, vapeur, poussière, secousse de la
	    MACHINE seulement : la carte et son contour ne bougent pas), remontée,
	    et la galette repart sur le tapis vers le bac à gauche.

	10 paliers visuels, un par niveau de "Presse hydraulique" (ctx.GetLevel("Press")) :
	  1 bois rustique, 2 chêne & fer, 3 acier, 4 acier bleu, 5 industrielle
	  (gyrophare, vapeur), 6 usine (afficheur numérique), 7 or, 8 or royal
	  (rubis), 9 diamant (cristaux), 10 diamant néon (contours arc-en-ciel).
	Pastille "Niv. X · palier" + animation au changement de palier. La
	vitesse augmente avec le niveau.

	"Presse turbo" (Feature PressStart) : pupitre avec un gros bouton START
	(Interact("Press"), recharge côté serveur, jauge de recharge affichée) ;
	le bonus s'affiche via OnBonus("Press"). Sans turbo : panneau "Attention
	aux doigts".

	Performance : une seule boucle OnRender ; particules, bouffées de vapeur
	et cris "CRUNCH!" viennent de réserves réutilisées (aucune création
	d'instance par image) ; rien n'est animé quand la carte est cachée.
	Mise en page : tout reste à l'intérieur de la carte (ClipsDescendants),
	contour jamais coupé (voir Slots.ClipMargin).
]]

local Debris = game:GetService("Debris")

local Locale = require(game:GetService("ReplicatedStorage").Shared.Locale)

local Press = {}
Press.Slot = "C3"

----------------------------------------------------------------------
-- Géométrie (pixels "design" dans la carte de 380 x 264 : slot de 384 x 268
-- moins 2 px de marge de chaque côté pour que le contour ne soit pas coupé)
----------------------------------------------------------------------
local HEADER_H = 32
local MX = 170 -- axe de la presse
local FLOOR_Y = 246 -- sol de l'atelier
local BELT_Y = 206 -- dessus du tapis (bas des objets)
local BELT_H = 8
local BELT_X0, BELT_X1 = 64, 384 -- le tapis sort par le bord droit de la carte
local CROWN_Y, CROWN_H = 50, 26 -- traverse du haut
local CYL_Y = 36 -- haut du vérin
local PLATE_TOP = CROWN_Y + CROWN_H + 6 -- plateau en position haute
local PLATE_H = 22
local PLATE_W = 160
local PILLAR_W = 18
local PILLAR_X = { MX - 80 - PILLAR_W, MX + 80 } -- bord gauche de chaque colonne
-- Pas du tapis : l'objet en attente est posé À DROITE de la colonne et des
-- guides du plateau (jamais devant eux), le suivant arrive du bord de la carte
local SPACING = 152
local SLOT_X = { MX + SPACING } -- file d'attente visible (x = 322)
local ENTRY_X = MX + SPACING * 2 -- le nouvel objet arrive d'ici (hors carte)
local BIN_X, BIN_W, BIN_TOP = 34, 50, 212 -- bac : son bord est SOUS le tapis
local FLAT_H = 12 -- hauteur d'une galette
local ITEM_SCALE = 1.15 -- objets un peu plus gros (lisibles à la taille de la carte)
local CONSOLE_X, CONSOLE_Y, CONSOLE_W, CONSOLE_H = 294, 38, 76, 90
local PARTICLE_MAX = 48
local PUFF_MAX = 10
local SHOUT_COUNT = 2
local RAY_COUNT = 12 -- rayons de l'éclat "BD" au CRUNCH

-- Ordre d'empilement des calques de la machine (ZIndexBehavior = Sibling) :
-- chaque pièce a sa place, rien ne "traverse" une pièce qui devrait la cacher.
local Z = {
	Burst = 1, -- éclat BD derrière la machine
	DecorBack = 2, -- décor mural (étoiles, lueur)
	Hose = 3,
	BinBack = 3,
	BinFill = 4,
	Pillar = 4,
	PillarDecor = 5, -- cordes, ferrures, veinage : SUR les colonnes, SOUS le plateau et les objets
	Rod = 6,
	Housing = 6,
	Unit = 7, -- centrale hydraulique
	Crown = 8,
	CrownDecor = 9, -- rivets, manomètres, afficheur, gemmes, gyrophare
	Gland = 9,
	BeltLegs = 9,
	Bolster = 10,
	BolsterDecor = 11,
	Belt = 12,
	BeltFrame = 13,
	Roller = 14,
	Item = 15, -- objets : devant les colonnes...
	Plate = 16, -- ... mais derrière le plateau (et ses guides)
	BinFront = 17, -- la galette tombe DERRIÈRE la face du bac
	BinRim = 18,
	Console = 19,
	FX = 20, -- particules (découpées sous l'en-tête)
}

-- Durées de base (niveau 1), divisées par le facteur de vitesse
local DURATIONS = {
	Load = 0.9,
	Descend = 0.85,
	Squeeze = 0.6,
	Crunch = 0.07,
	Hold = 0.5,
	Rise = 0.8,
}

local rgb = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local INK = rgb(34, 34, 40)
local RED = rgb(230, 40, 50)
local PILL = UDim.new(0.5, 0)

----------------------------------------------------------------------
-- Petits outils de couleur
----------------------------------------------------------------------
local function seq(...: Color3): ColorSequence
	local colors = { ... }
	local keypoints = {}
	for i, color in ipairs(colors) do
		table.insert(keypoints, ColorSequenceKeypoint.new((i - 1) / math.max(1, #colors - 1), color))
	end
	if #keypoints == 1 then
		table.insert(keypoints, ColorSequenceKeypoint.new(1, colors[1]))
	end
	return ColorSequence.new(keypoints)
end

-- Bandes nettes de couleurs données (dégradé à bords francs)
local function bands(colors: { Color3 }): ColorSequence
	local keypoints = {}
	local n = #colors
	for i, color in ipairs(colors) do
		table.insert(keypoints, ColorSequenceKeypoint.new((i - 1) / n, color))
		table.insert(keypoints, ColorSequenceKeypoint.new(math.min(1, i / n - 0.002), color))
	end
	keypoints[#keypoints] = ColorSequenceKeypoint.new(1, colors[n])
	return ColorSequence.new(keypoints)
end

-- Rayures alternées (n bandes)
local function stripes(n: number, c1: Color3, c2: Color3): ColorSequence
	local colors = {}
	for i = 1, n do
		colors[i] = (i % 2 == 1) and c1 or c2
	end
	return bands(colors)
end

-- Bandes alternées nettes réparties en plusieurs morceaux côte à côte :
-- Roblox refuse un dégradé de plus de 20 points (erreur qui arrêtait toute
-- la carte), donc 10 bandes au maximum par morceau.
type StripeFill = { SetColors: (a: Color3, b: Color3) -> () }
local function stripeFill(frame: GuiObject, n: number, c1: Color3, c2: Color3, rotation: number): StripeFill
	local pieces = math.ceil(n / 10)
	local gradients: { UIGradient } = {}
	local starts: { number } = {}
	local counts: { number } = {}
	local used = 0
	frame.BackgroundTransparency = 1
	for p = 1, pieces do
		local count = math.floor(n * p / pieces + 0.5) - used
		local piece = Instance.new("Frame")
		piece.Name = "Stripes" .. p
		piece.BorderSizePixel = 0
		piece.BackgroundColor3 = WHITE
		piece.Position = UDim2.fromScale(used / n, 0)
		piece.Size = UDim2.fromScale(count / n, 1)
		piece.ZIndex = frame.ZIndex
		piece.Parent = frame
		local gradient = Instance.new("UIGradient")
		gradient.Rotation = rotation
		gradient.Parent = piece
		gradients[p] = gradient
		starts[p] = used
		counts[p] = count
		used += count
	end
	local fill = {}
	function fill.SetColors(a: Color3, b: Color3)
		for p, gradient in ipairs(gradients) do
			local colors = {}
			for i = 1, counts[p] do
				colors[i] = ((starts[p] + i) % 2 == 1) and a or b
			end
			gradient.Color = bands(colors)
		end
	end
	fill.SetColors(c1, c2)
	return fill :: StripeFill
end

local function darker(color: Color3, k: number): Color3
	return color:Lerp(BLACK, k)
end

local function lighter(color: Color3, k: number): Color3
	return color:Lerp(WHITE, k)
end

-- Ombrage d'un cylindre vertical (colonne, tige) : sombre / reflet / base / sombre
local function cylinderSeq(color: Color3): ColorSequence
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, darker(color, 0.35)),
		ColorSequenceKeypoint.new(0.22, lighter(color, 0.55)),
		ColorSequenceKeypoint.new(0.4, color),
		ColorSequenceKeypoint.new(0.85, darker(color, 0.25)),
		ColorSequenceKeypoint.new(1, darker(color, 0.45)),
	})
end

-- Ombrage d'une poutre horizontale (lumière d'en haut)
local function beamSeq(color: Color3): ColorSequence
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, lighter(color, 0.4)),
		ColorSequenceKeypoint.new(0.35, color),
		ColorSequenceKeypoint.new(1, darker(color, 0.35)),
	})
end

-- Dégradés "multiplicateurs" (appliqués sur une couleur de fond)
local SHADE_V = seq(WHITE, rgb(205, 205, 205))
local SHADE_CYL = ColorSequence.new({
	ColorSequenceKeypoint.new(0, rgb(150, 150, 150)),
	ColorSequenceKeypoint.new(0.25, WHITE),
	ColorSequenceKeypoint.new(0.55, rgb(225, 225, 225)),
	ColorSequenceKeypoint.new(1, rgb(125, 125, 125)),
})

local function easeInOut(t: number): number
	return t < 0.5 and 2 * t * t or 1 - (-2 * t + 2) ^ 2 / 2
end

local function easeOut(t: number): number
	return 1 - (1 - t) * (1 - t)
end

-- Rebond façon "Back" (dépasse puis revient) : 0 -> 1
local function easeOutBack(t: number): number
	local c1 = 1.70158
	local c3 = c1 + 1
	return 1 + c3 * (t - 1) ^ 3 + c1 * (t - 1) ^ 2
end

----------------------------------------------------------------------
-- Objets à écraser
----------------------------------------------------------------------
-- Texte traduit : { en = {...}, fr = {...} } (choisi avec Locale.Pick)
type Words = { en: { string }, fr: { string } }

local MACARON_COLORS = {
	rgb(255, 160, 192), -- framboise
	rgb(172, 222, 140), -- pistache
	rgb(192, 162, 240), -- violette
	rgb(255, 228, 120), -- citron
	rgb(156, 100, 74), -- chocolat
	rgb(255, 190, 132), -- fleur d'oranger
	rgb(150, 206, 255), -- myrtille... bleue
	rgb(236, 86, 124), -- fraise
}
local CAN_COLORS = { rgb(220, 40, 50), rgb(30, 110, 220), rgb(40, 170, 90), rgb(150, 70, 220), rgb(250, 150, 20) }
local GIFT_COLORS = { rgb(230, 60, 90), rgb(60, 140, 240), rgb(40, 180, 120), rgb(170, 90, 230), rgb(255, 170, 30) }
local RIBBON_COLORS = { rgb(255, 214, 60), WHITE, rgb(255, 120, 170), rgb(90, 220, 255) }
local JELLY_COLORS = { rgb(255, 70, 110), rgb(90, 220, 120), rgb(255, 170, 40), rgb(140, 110, 255), rgb(60, 200, 255) }
local ICING_COLORS = { rgb(255, 160, 200), rgb(120, 70, 50), WHITE, rgb(170, 220, 255) }
local RUBIK_COLORS = { rgb(230, 40, 40), rgb(40, 180, 70), rgb(30, 100, 230), rgb(255, 210, 30), rgb(255, 130, 20), WHITE }
local PAINT_COLORS = { rgb(255, 60, 120), rgb(40, 190, 255), rgb(120, 220, 60), rgb(255, 200, 30), rgb(160, 90, 255) }

local W = {
	Macaron = { en = { "CRUNCH!", "SCRUNCH!", "CRACK!", "Flat macaron!", "CRONCH!" }, fr = { "CRUNCH !", "SCRONCH !", "CRAC !", "Macaron à plat !", "CROUNCH !" } },
	Can = { en = { "CRONCH!", "Soda: flattened!", "PSSHT-CLONK!" }, fr = { "CRONCH !", "Soda aplati !", "PSCHT-CLONK !" } },
	Melon = { en = { "SPLOTCH!", "SPLOOSH!", "Instant juice!" }, fr = { "SPLOTCH !", "SCHPLOUF !", "Jus instantané !" } },
	Cake = { en = { "SPLAT!", "Happy squish-day!", "Flat cake!" }, fr = { "SPLAF !", "Joyeux écrasement !", "Gâteau plat !" } },
	Gift = { en = { "CRUNCH!", "Surprise! It's flat.", "Gift: unwrapped!" }, fr = { "CRUNCH !", "Surprise ! C'est plat.", "Cadeau déballé !" } },
	Jelly = { en = { "SPLORCH!", "Wobble... SPLAT!", "BLOBBB!" }, fr = { "SPLORTCH !", "Tremblote... SPLAF !", "BLOBBB !" } },
	Sponge = { en = { "SCHLURP!", "SQUISH!" }, fr = { "SCHLURP !", "SQUICH !" } },
	Rubik = { en = { "CRACK!", "Solved! (sort of)", "KRRRK!" }, fr = { "CRAC !", "Résolu ! (en quelque sorte)", "KRRRK !" } },
	Duck = { en = { "SQUEAK!", "QUACK!", "SQUEEEE!" }, fr = { "POUIC !", "COIN !", "POUIIIC !" } },
	Ball = { en = { "POP!!!", "BANG!", "Beach's closed!" }, fr = { "POP !!!", "BANG !", "Plage fermée !" } },
	Paint = { en = { "SPLASH!", "Modern art!", "SPLOSH!" }, fr = { "SPLASH !", "Art moderne !", "SPLOSH !" } },
	Log = { en = { "CRACK!", "Firewood, sorted!", "TIMBERRR!" }, fr = { "CRAC !", "Bois de chauffage, prêt !", "ATTENTION, CHUTE !" } },
	Barrel = { en = { "CLANG!", "Barrel pancake!", "BONG!" }, fr = { "CLANG !", "Tonneau-crêpe !", "BONG !" } },
	Drum = { en = { "KA-BLONK!", "Oil change!", "CRUMPLE!" }, fr = { "KA-BLONK !", "Vidange !", "FROISSSS !" } },
	Gold = { en = { "KA-CHING!", "Fresh gold leaf!", "CLINK!" }, fr = { "KA-CHING !", "Feuille d'or fraîche !", "CLING !" } },
	Crystal = { en = { "CRIIING!", "Premium crushed ice!", "SHIIING!" }, fr = { "CRIIING !", "Glace pilée premium !", "SHIIING !" } },
}

-- Boîte à outils passée aux dessins d'objets
type Kit = {
	Part: (parent: Instance, x: number, y: number, w: number, h: number, color: Color3, z: number?, radius: UDim?, transparency: number?) -> Frame,
	Gradient: (frame: Instance, color: ColorSequence, rotation: number?) -> UIGradient,
	Stroke: (frame: Instance, color: Color3, thickness: number?, transparency: number?) -> UIStroke,
	Random: Random,
}

-- Résultat d'un dessin : couleurs des éclats, couleur de la galette, pièces spéciales
type Built = {
	Colors: { Color3 },
	Main: Color3,
	Fillings: { Frame }?,
	Body: Frame?,
	Gradient: UIGradient?,
	Stroke: UIStroke?,
}

type Drawn = {
	Id: string,
	W: number,
	H: number,
	Weight: number,
	Words: Words,
	Special: string?,
	Wobble: number?,
	Juice: Color3?, -- couleur de la flaque après écrasement
	Build: (k: Kit, holder: Frame) -> Built,
}

local function pickFrom(list: { any }, r: Random): any
	return list[r:NextInteger(1, #list)]
end

-- Reflet commun (bande blanche translucide à gauche)
local function shine(k: Kit, holder: Frame, x: number, y: number, w: number, h: number, z: number?)
	k.Part(holder, x, y, w, h, WHITE, z or 8, PILL, 0.55)
end

local DRAWN: { [string]: Drawn } = {
	Macarons = {
		Id = "Macarons", W = 62, H = 64, Weight = 3, Words = W.Macaron,
		Build = function(k, holder)
			local colors, fillings = {}, {}
			for i = 1, 3 do
				local color = pickFrom(MACARON_COLORS, k.Random)
				colors[i] = color
				local unit = k.Part(holder, 0.5 + k.Random:NextNumber(-0.03, 0.03), (i - 1) / 3, k.Random:NextNumber(0.9, 1), 1 / 3, color, 1, nil, 1)
				unit.AnchorPoint = Vector2.new(0.5, 0)
				k.Gradient(k.Part(unit, 0, 0.04, 1, 0.42, color, 2, PILL), SHADE_V, 90)
				local fillingColor = (color.R < 0.7 and color.G < 0.5) and rgb(96, 56, 40) or rgb(255, 246, 228)
				local filling = k.Part(unit, 0.5, 0.42, 0.86, 0.17, fillingColor, 3, PILL)
				filling.AnchorPoint = Vector2.new(0.5, 0)
				k.Gradient(k.Part(unit, 0, 0.56, 1, 0.4, darker(color, 0.08), 2, PILL), SHADE_V, 90)
				table.insert(fillings, filling)
			end
			return { Colors = colors, Main = colors[2], Fillings = fillings }
		end,
	},
	Can = {
		Id = "Can", W = 40, H = 62, Weight = 2, Words = W.Can, Juice = rgb(200, 150, 60),
		Build = function(k, holder)
			local c = pickFrom(CAN_COLORS, k.Random)
			local body = k.Part(holder, 0, 0.07, 1, 0.93, c, 2, UDim.new(0.18, 0))
			k.Gradient(body, SHADE_CYL, 0)
			local band = k.Part(body, 0, 0.34, 1, 0.3, WHITE, 3)
			k.Gradient(band, SHADE_CYL, 0)
			k.Part(band, 0.28, 0.16, 0.44, 0.68, c, 4, PILL)
			local rim = k.Part(holder, 0.04, 0, 0.92, 0.15, rgb(214, 218, 226), 4, PILL)
			k.Gradient(rim, seq(WHITE, rgb(150, 156, 168)), 90)
			k.Part(rim, 0.38, 0.28, 0.24, 0.44, rgb(150, 156, 170), 5, PILL)
			shine(k, holder, 0.14, 0.14, 0.12, 0.78)
			return { Colors = { c, rgb(210, 214, 222), WHITE }, Main = c }
		end,
	},
	Melon = {
		Id = "Melon", W = 70, H = 54, Weight = 2, Words = W.Melon, Special = "Melon", Juice = rgb(236, 60, 72),
		Build = function(k, holder)
			local body = k.Part(holder, 0, 0, 1, 1, WHITE, 2, PILL)
			local gradient = k.Gradient(body, stripes(9, rgb(40, 132, 48), rgb(118, 198, 86)), 0)
			local stroke = k.Stroke(body, rgb(26, 90, 34), 1.5)
			k.Part(holder, 0.47, -0.06, 0.06, 0.1, rgb(110, 80, 40), 1)
			shine(k, holder, 0.18, 0.12, 0.3, 0.18)
			return { Colors = { rgb(235, 60, 70), rgb(255, 120, 120), rgb(40, 132, 48) }, Main = rgb(235, 60, 70), Body = body, Gradient = gradient, Stroke = stroke }
		end,
	},
	Cake = {
		Id = "Cake", W = 64, H = 64, Weight = 2, Words = W.Cake, Juice = rgb(255, 240, 246),
		Build = function(k, holder)
			local sponge = rgb(246, 206, 140)
			local icing = pickFrom(ICING_COLORS, k.Random)
			k.Part(holder, -0.08, 0.93, 1.16, 0.07, rgb(240, 242, 248), 1, PILL)
			k.Gradient(k.Part(holder, 0, 0.62, 1, 0.32, sponge, 2, UDim.new(0.15, 0)), SHADE_V, 90)
			k.Part(holder, 0, 0.55, 1, 0.08, rgb(255, 250, 240), 3, PILL)
			k.Gradient(k.Part(holder, 0, 0.3, 1, 0.27, sponge, 2, UDim.new(0.15, 0)), SHADE_V, 90)
			k.Part(holder, -0.03, 0.2, 1.06, 0.15, icing, 4, PILL)
			for _, x in ipairs({ 0.12, 0.42, 0.74 }) do
				k.Part(holder, x, 0.28, 0.08, k.Random:NextNumber(0.08, 0.16), icing, 4, PILL)
			end
			local cherry = k.Part(holder, 0.42, 0.02, 0.16, 0.18, rgb(220, 30, 50), 5, PILL)
			k.Part(cherry, 0.2, 0.15, 0.3, 0.3, WHITE, 6, PILL, 0.4)
			return { Colors = { sponge, icing, rgb(255, 250, 240), rgb(220, 30, 50) }, Main = sponge }
		end,
	},
	Gift = {
		Id = "Gift", W = 58, H = 60, Weight = 2, Words = W.Gift,
		Build = function(k, holder)
			local c = pickFrom(GIFT_COLORS, k.Random)
			local ribbon = pickFrom(RIBBON_COLORS, k.Random)
			k.Gradient(k.Part(holder, 0.05, 0.34, 0.9, 0.66, c, 2, UDim.new(0.08, 0)), SHADE_V, 90)
			k.Gradient(k.Part(holder, 0, 0.24, 1, 0.16, lighter(c, 0.12), 3, UDim.new(0.2, 0)), SHADE_V, 90)
			k.Part(holder, 0.42, 0.24, 0.16, 0.76, ribbon, 4)
			local left = k.Part(holder, 0.16, 0.05, 0.32, 0.2, ribbon, 5, PILL)
			left.Rotation = -18
			local right = k.Part(holder, 0.52, 0.05, 0.32, 0.2, ribbon, 5, PILL)
			right.Rotation = 18
			k.Part(holder, 0.43, 0.12, 0.14, 0.14, darker(ribbon, 0.15), 6, PILL)
			return { Colors = { c, ribbon, lighter(c, 0.3) }, Main = c }
		end,
	},
	Jelly = {
		Id = "Jelly", W = 58, H = 52, Weight = 2, Words = W.Jelly, Wobble = 4,
		Build = function(k, holder)
			local c = pickFrom(JELLY_COLORS, k.Random)
			k.Part(holder, -0.1, 0.9, 1.2, 0.1, rgb(240, 242, 248), 1, PILL)
			local body = k.Part(holder, 0, 0.14, 1, 0.8, c, 2, UDim.new(0.3, 0), 0.12)
			k.Gradient(body, seq(lighter(c, 0.35), c, darker(c, 0.2)), 90)
			k.Part(holder, 0.07, 0.16, 0.86, 0.2, lighter(c, 0.45), 3, PILL, 0.2)
			shine(k, holder, 0.14, 0.38, 0.1, 0.38)
			k.Part(holder, 0.4, 0, 0.2, 0.22, rgb(220, 30, 60), 4, PILL)
			return { Colors = { c, lighter(c, 0.4), rgb(220, 30, 60) }, Main = c }
		end,
	},
	Sponge = {
		Id = "Sponge", W = 64, H = 44, Weight = 1, Words = W.Sponge, Special = "Sponge", Wobble = 2,
		Build = function(k, holder)
			local foam = k.Part(holder, 0, 0.3, 1, 0.7, rgb(255, 220, 70), 2, UDim.new(0.12, 0))
			k.Gradient(foam, SHADE_V, 90)
			k.Gradient(k.Part(holder, 0, 0, 1, 0.34, rgb(60, 170, 80), 3, UDim.new(0.14, 0)), SHADE_V, 90)
			for _, hole in ipairs({ { 0.12, 0.5, 0.14, 0.16 }, { 0.42, 0.66, 0.1, 0.12 }, { 0.68, 0.46, 0.16, 0.16 }, { 0.3, 0.8, 0.12, 0.1 }, { 0.82, 0.76, 0.08, 0.1 } }) do
				k.Part(holder, hole[1], hole[2], hole[3], hole[4], rgb(222, 172, 30), 3, PILL)
			end
			return { Colors = { rgb(255, 220, 70), rgb(60, 170, 80), rgb(190, 230, 255) }, Main = rgb(255, 220, 70) }
		end,
	},
	Rubik = {
		Id = "Rubik", W = 52, H = 52, Weight = 1, Words = W.Rubik,
		Build = function(k, holder)
			local base = k.Part(holder, 0, 0, 1, 1, rgb(26, 26, 30), 2, UDim.new(0.12, 0))
			local used = {}
			for i = 0, 2 do
				for j = 0, 2 do
					local color = pickFrom(RUBIK_COLORS, k.Random)
					used[#used + 1] = color
					k.Part(base, 0.05 + i * 0.31, 0.05 + j * 0.31, 0.28, 0.28, color, 3, UDim.new(0.2, 0))
				end
			end
			shine(k, holder, 0.1, 0.08, 0.3, 0.1)
			return { Colors = { used[1], used[5], used[9], rgb(26, 26, 30) }, Main = used[5] }
		end,
	},
	Duck = {
		Id = "Duck", W = 62, H = 58, Weight = 2, Words = W.Duck,
		Build = function(k, holder)
			local yellow = rgb(255, 210, 40)
			k.Part(holder, -0.04, 0.36, 0.24, 0.24, yellow, 1, PILL)
			k.Gradient(k.Part(holder, 0, 0.42, 0.94, 0.56, yellow, 2, PILL), SHADE_V, 90)
			k.Gradient(k.Part(holder, 0.44, 0.02, 0.48, 0.5, yellow, 3, PILL), SHADE_V, 90)
			k.Part(holder, 0.84, 0.25, 0.2, 0.13, rgb(255, 130, 30), 4, PILL)
			local eye = k.Part(holder, 0.66, 0.14, 0.09, 0.1, rgb(30, 30, 40), 4, PILL)
			k.Part(eye, 0.2, 0.1, 0.4, 0.4, WHITE, 5, PILL)
			k.Part(holder, 0.16, 0.56, 0.42, 0.22, rgb(240, 178, 20), 3, PILL)
			shine(k, holder, 0.52, 0.08, 0.14, 0.12)
			return { Colors = { yellow, rgb(255, 130, 30), rgb(255, 240, 150) }, Main = yellow }
		end,
	},
	Ball = {
		Id = "Ball", W = 56, H = 56, Weight = 1, Words = W.Ball, Special = "Pop",
		Build = function(k, holder)
			local ball = k.Part(holder, 0, 0, 1, 1, WHITE, 2, PILL)
			k.Gradient(ball, bands({ rgb(230, 40, 50), WHITE, rgb(30, 110, 230), rgb(255, 210, 30), WHITE, rgb(40, 180, 90) }), 0)
			k.Stroke(ball, rgb(60, 60, 80), 1, 0.5)
			k.Part(holder, 0.42, 0.42, 0.16, 0.16, WHITE, 3, PILL)
			shine(k, holder, 0.2, 0.12, 0.26, 0.16)
			return { Colors = { rgb(230, 40, 50), rgb(30, 110, 230), rgb(255, 210, 30), rgb(40, 180, 90), WHITE }, Main = rgb(230, 40, 50) }
		end,
	},
	Paint = {
		Id = "Paint", W = 48, H = 56, Weight = 1, Words = W.Paint, Special = "Paint",
		Build = function(k, holder)
			local c = pickFrom(PAINT_COLORS, k.Random)
			local body = k.Part(holder, 0, 0.12, 1, 0.88, rgb(200, 204, 212), 2, UDim.new(0.12, 0))
			k.Gradient(body, SHADE_CYL, 0)
			local label = k.Part(body, 0, 0.28, 1, 0.46, c, 3)
			k.Gradient(label, SHADE_CYL, 0)
			k.Part(label, 0.34, 0.2, 0.32, 0.6, WHITE, 4, PILL, 0.25)
			k.Part(holder, 0, 0.05, 1, 0.14, rgb(214, 218, 226), 3, PILL)
			k.Part(holder, 0.08, 0.07, 0.56, 0.11, c, 4, PILL)
			k.Part(holder, 0.18, 0.12, 0.09, 0.24, c, 4, PILL)
			return { Colors = { c, c, lighter(c, 0.4), rgb(200, 204, 212) }, Main = c }
		end,
	},
	-- Objets propres aux paliers
	Log = {
		Id = "Log", W = 76, H = 40, Weight = 0, Words = W.Log,
		Build = function(k, holder)
			local bark = k.Part(holder, 0, 0, 0.84, 1, WHITE, 2, UDim.new(0.3, 0))
			k.Gradient(bark, stripes(6, rgb(140, 92, 52), rgb(100, 64, 34)), 90)
			local ring = k.Part(holder, 0.64, 0, 0.36, 1, rgb(226, 184, 124), 3, PILL)
			k.Stroke(ring, rgb(110, 70, 38), 2)
			local inner = k.Part(ring, 0.25, 0.25, 0.5, 0.5, rgb(206, 158, 96), 4, PILL)
			k.Stroke(inner, rgb(170, 120, 70), 1)
			return { Colors = { rgb(140, 92, 52), rgb(226, 184, 124), rgb(90, 60, 30) }, Main = rgb(206, 158, 96) }
		end,
	},
	Barrel = {
		Id = "Barrel", W = 50, H = 64, Weight = 0, Words = W.Barrel,
		Build = function(k, holder)
			local c = k.Random:NextNumber() < 0.5 and rgb(170, 176, 188) or rgb(50, 110, 200)
			local body = k.Part(holder, 0, 0.06, 1, 0.94, c, 2, UDim.new(0.14, 0))
			k.Gradient(body, SHADE_CYL, 0)
			k.Part(body, 0, 0.26, 1, 0.07, darker(c, 0.35), 3)
			k.Part(body, 0, 0.66, 1, 0.07, darker(c, 0.35), 3)
			k.Part(holder, 0.03, 0, 0.94, 0.13, lighter(c, 0.3), 4, PILL)
			shine(k, holder, 0.16, 0.14, 0.1, 0.76)
			return { Colors = { c, lighter(c, 0.4), darker(c, 0.3) }, Main = c }
		end,
	},
	Drum = {
		Id = "Drum", W = 50, H = 64, Weight = 0, Words = W.Drum,
		Build = function(k, holder)
			local c = rgb(255, 140, 20)
			local body = k.Part(holder, 0, 0.06, 1, 0.94, c, 2, UDim.new(0.14, 0))
			k.Gradient(body, SHADE_CYL, 0)
			local band = k.Part(body, 0, 0.36, 1, 0.3, rgb(30, 30, 36), 3)
			local sign = k.Part(band, 0.5, 0.5, 0.36, 0.6, rgb(255, 214, 40), 4)
			sign.AnchorPoint = Vector2.new(0.5, 0.5)
			sign.Rotation = 45
			k.Part(holder, 0.03, 0, 0.94, 0.13, lighter(c, 0.3), 4, PILL)
			shine(k, holder, 0.16, 0.14, 0.1, 0.76)
			return { Colors = { c, rgb(30, 30, 36), rgb(255, 214, 40), rgb(40, 30, 20) }, Main = c }
		end,
	},
	GoldBars = {
		Id = "GoldBars", W = 72, H = 42, Weight = 0, Words = W.Gold,
		Build = function(k, holder)
			local function bar(x: number, y: number, w: number, h: number)
				local b = k.Part(holder, x, y, w, h, WHITE, 2, UDim.new(0.2, 0))
				k.Gradient(b, seq(rgb(255, 246, 196), rgb(255, 208, 70), rgb(196, 126, 10)), 90)
				k.Stroke(b, rgb(150, 96, 10), 1)
				k.Part(b, 0.12, 0.16, 0.76, 0.2, WHITE, 3, PILL, 0.45)
			end
			bar(0, 0.52, 0.49, 0.48)
			bar(0.51, 0.52, 0.49, 0.48)
			bar(0.22, 0.04, 0.56, 0.48)
			return { Colors = { rgb(255, 214, 70), rgb(255, 246, 196), rgb(200, 130, 10) }, Main = rgb(255, 208, 70) }
		end,
	},
	Crystal = {
		Id = "Crystal", W = 56, H = 56, Weight = 0, Words = W.Crystal,
		Build = function(k, holder)
			local ice = k.Part(holder, 0, 0, 1, 1, rgb(170, 230, 255), 2, UDim.new(0.16, 0), 0.12)
			k.Gradient(ice, seq(WHITE, rgb(200, 240, 255), rgb(110, 180, 240)), 60)
			k.Stroke(ice, WHITE, 1.5, 0.15)
			k.Part(holder, 0.1, 0.08, 0.5, 0.3, WHITE, 3, UDim.new(0.25, 0), 0.5)
			k.Part(holder, 0.52, 0.56, 0.36, 0.3, rgb(120, 200, 255), 3, UDim.new(0.25, 0), 0.35)
			k.Part(holder, 0.18, 0.5, 0.08, 0.34, WHITE, 3, PILL, 0.45)
			return { Colors = { rgb(190, 240, 255), WHITE, rgb(120, 200, 255) }, Main = rgb(170, 230, 255) }
		end,
	},
}


	local function setPlayEnabled(value: boolean)
		playButton:SetAttribute("Enabled", value)
		playGradient.Enabled = value
		playButton.BackgroundColor3 = value and WHITE or Color3.fromRGB(120, 110, 110)
		playShine.BackgroundTransparency = value and 0.6 or 0.85
		if playLabel then
			playLabel.TextTransparency = value and 0 or 0.4
		end
	end

	------------------------------------------------------------------
	-- Pièces qui tombent (réserve réutilisée) et bannière JACKPOT
	------------------------------------------------------------------
	local coins = {}
	for _ = 1, MAX_COINS do
		-- Pièce dorée dessinée (elle "tourne" en s'aplatissant)
		local coin = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(14, 14),
			BackgroundColor3 = WHITE,
			Visible = false,
			ZIndex = 18,
			Parent = card,
		})
		round(coin)
		vGradient(coin, { { 0, GOLD_LIGHT }, { 0.5, GOLD }, { 1, GOLD_DARK } }, 45)
		UIUtil.Stroke(coin, Color3.fromRGB(150, 90, 0), 1.2, 0)
		table.insert(coins, { Label = coin, Active = false, X = 0, Y = 0, VX = 0, VY = 0, Spin = 0, Angle = 0 })
	end
	local activeCoins = 0

	local function dropCoins(count: number)
		if not effectsOn() then
			return
		end
		local launched = 0
		for _, coin in ipairs(coins) do
			if launched >= count then
				break
			end
			if not coin.Active then
				coin.Active = true
				coin.X = WINDOW_X + WINDOW_W / 2 + random:NextNumber(-60, 60)
				coin.Y = WINDOW_Y + WINDOW_H / 2
				coin.VX = random:NextNumber(-70, 70)
				coin.VY = random:NextNumber(-190, -110)
				coin.Spin = random:NextNumber(8, 16)
				coin.Angle = random:NextNumber(0, math.pi)
				coin.Label.Visible = true
				launched += 1
				activeCoins += 1
			end
		end
	end

	local jackpot = frame({
		Name = "Jackpot",
		Position = UDim2.fromOffset(WINDOW_X, WINDOW_Y),
		Size = UDim2.fromOffset(WINDOW_W, WINDOW_H),
		ClipsDescendants = true,
		Visible = false,
		ZIndex = 16,
		Parent = card,
	})
	round(jackpot, 9)
	local jackpotBg = frame({
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(60, 0, 20),
		BackgroundTransparency = 0.15,
		ZIndex = 16,
		Parent = jackpot,
	})
	round(jackpotBg, 9)
	local rays = UIUtil.Rays(jackpot, GOLD, 8, 260, UDim2.fromScale(0.5, 0.5), 17)
	local jackpotLabel = UIUtil.Label({
		Text = Locale.T("JACKPOT!"),
		Font = Theme.Fonts.Title,
		TextColor3 = WHITE,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.4),
		Size = UDim2.new(1, -20, 0, 34),
		MaxTextSize = 32,
		ZIndex = 18,
		Parent = jackpot,
	})
	vGradient(jackpotLabel, { { 0, GOLD_LIGHT }, { 1, Color3.fromRGB(255, 150, 0) } })
	local jackpotStroke = UIUtil.Stroke(jackpotLabel, Color3.fromRGB(80, 20, 0), 2, 0)
	jackpotStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	local jackpotAmount = UIUtil.Label({
		Text = "",
		Font = Theme.Fonts.Number,
		TextColor3 = WHITE,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.78),
		Size = UDim2.new(1, -20, 0, 18),
		MaxTextSize = 17,
		ZIndex = 18,
		Parent = jackpot,
	})
	local jackpotScale = Create("UIScale", { Parent = jackpot })
	local jackpotUntil = 0

	local function showJackpot(amountText: string)
		jackpot.Visible = true
		jackpotAmount.Text = amountText
		jackpotScale.Scale = 0.3
		UIUtil.Tween(jackpotScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
		jackpotUntil = os.clock() + 3
	end

	------------------------------------------------------------------
	-- Fermé : Data.CasinoEnabled = false (règle calculée par le serveur)
	------------------------------------------------------------------
	local function casinoEnabled(): boolean
		local data = ctx.State.Data
		if data and data.CasinoEnabled ~= nil then
			return data.CasinoEnabled == true
		end
		-- Pas encore d'état (ou ancien serveur) : même règle que le serveur
		if config.Enabled == false then
			return false
		end
		local monetization = ctx.Config.Monetization
		if ctx.Config.IsSellingForRobux and monetization and monetization.DisableCasinoWhenSelling then
			return false
		end
		return true
	end

	-- Voile sombre + pancarte suspendue (TextButton : bloque les clics)
	local closedVeil = Create("TextButton", {
		Name = "Closed",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(20, 4, 10),
		BackgroundTransparency = 0.25,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 30,
		Visible = false,
		Parent = card,
	})
	round(closedVeil, 18)
	-- Deux cordes + pancarte
	for side = -1, 1, 2 do
		frame({
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, side * 46, 0, 8),
			Size = UDim2.fromOffset(2, 44),
			Rotation = -side * 12,
			BackgroundColor3 = Color3.fromRGB(200, 180, 140),
			ZIndex = 31,
			Parent = closedVeil,
		})
	end
	local sign = frame({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 46),
		Size = UDim2.fromOffset(math.min(210, W - 40), 86),
		BackgroundColor3 = WHITE,
		Rotation = -3,
		ZIndex = 32,
		Parent = closedVeil,
	})
	round(sign, 12)
	vGradient(sign, { { 0, Color3.fromRGB(235, 60, 70) }, { 1, Color3.fromRGB(150, 10, 30) } })
	goldStroke(sign, 2)
	UIUtil.Label({
		Text = Locale.T("🚧 CLOSED 🚧"),
		Font = Theme.Fonts.Title,
		TextColor3 = GOLD_LIGHT,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.new(1, -20, 0, 30),
		MaxTextSize = 26,
		ZIndex = 33,
		Parent = sign,
	})
	UIUtil.Label({
		Text = Locale.T("The slot machine is taking a break."),
		Font = Theme.Fonts.Body,
		TextColor3 = WHITE,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 46),
		Size = UDim2.new(1, -20, 0, 16),
		MaxTextSize = 13,
		ZIndex = 33,
		Parent = sign,
	})
	UIUtil.Label({
		Text = Locale.T("Come back later 😴"),
		Font = Theme.Fonts.Body,
		TextColor3 = Color3.fromRGB(255, 210, 210),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 63),
		Size = UDim2.new(1, -20, 0, 14),
		MaxTextSize = 12,
		ZIndex = 33,
		Parent = sign,
	})

	local enabled = true
	local spinning = false
	local function applyEnabled()
		local now = casinoEnabled()
		closedVeil.Visible = not now
		if now ~= enabled then
			enabled = now
			if not now then
				setInfo(Locale.T("Closed for now 😴"), LED_TEXT)
				setPaytable(false)
			end
		end
		setPlayEnabled(enabled and not spinning)
		refreshBetLabel()
	end
	enabled = not casinoEnabled() -- force la première application
	applyEnabled()
	ctx.Connect(ctx.State.Changed, applyEnabled)

	------------------------------------------------------------------
	-- Animation (rouleaux, ampoules, ligne de gain, pièces, jackpot)
	------------------------------------------------------------------
	local partyUntil = 0
	local winGlowUntil = 0
	local bulbClock = 0
	local bulbStep = 0
	local elapsed = 0
	local partyColors = { Theme.Colors.Yellow, Theme.Colors.Cyan, Theme.Colors.Pink, Theme.Colors.Green, WHITE, Theme.Colors.Orange }
	local lastParty = false

	ctx.OnRender(function(dt: number)
		dt = math.min(dt, 0.1)
		elapsed += dt
		local now = os.clock()

		for _, reel in ipairs(reels) do
			if reel.Mode == "spin" then
				reel.Speed = math.min(MAX_SPEED, reel.Speed + dt * 70)
				reel.Pos += reel.Speed * dt
				renderReel(reel)
			elseif reel.Mode == "stop" then
				reel.StopT += dt
				local t = math.min(1, reel.StopT / reel.StopDur)
				reel.Pos = reel.StopFrom + (reel.StopTo - reel.StopFrom) * easeOutSoftBack(t)
				reel.Speed = MAX_SPEED * (1 - t)
				if t >= 1 then
					reel.Pos = reel.StopTo
					reel.Speed = 0
					reel.Mode = "idle"
					ctx.Sound.Play("SlotSpin", 0.9 + random:NextNumber(0, 0.3))
					reel.Scale.Scale = 1.06
					UIUtil.Tween(reel.Scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
				end
				renderReel(reel)
			end
		end

		-- Ampoules : chenillard (1 sur 3), ou arc-en-ciel rapide en cas de gain
		local party = now < partyUntil
		bulbClock += dt
		local interval = party and 0.06 or (spinning and 0.1 or 0.22)
		if bulbClock >= interval or party ~= lastParty then
			bulbClock = 0
			bulbStep += 1
			lastParty = party
			for index, bulb in ipairs(bulbs) do
				if party then
					local color = partyColors[((index + bulbStep) % #partyColors) + 1]
					bulb.Frame.BackgroundColor3 = color
					bulb.Frame.BackgroundTransparency = 0
					bulb.Stroke.Color = color
					bulb.Stroke.Transparency = 0.3
				else
					local on = (index + bulbStep) % 3 == 0
					bulb.Frame.BackgroundColor3 = on and GOLD_LIGHT or GOLD_DARK
					bulb.Frame.BackgroundTransparency = on and 0 or 0.35
					bulb.Stroke.Color = GOLD
					bulb.Stroke.Transparency = on and 0.35 or 1
				end
			end
		end

		-- Titre : dégradé qui ondule, pulse pendant la fête
		titleGradient.Offset = Vector2.new(0, math.sin(elapsed * 2) * 0.25)
		titleScale.Scale = party and (1 + math.abs(math.sin(elapsed * 10)) * 0.08) or 1

		-- Ligne de gain : respiration, éclatante après un gain
		local winGlow = now < winGlowUntil
		local wave = math.sin(elapsed * (winGlow and 14 or 3))
		if winGlow then
			paylineGlow.BackgroundColor3 = GOLD
			payline.BackgroundColor3 = GOLD_LIGHT
			paylineGlow.Size = UDim2.new(1, -4, 0, 18 + wave * 4)
			paylineGlow.BackgroundTransparency = 0.1
		else
			paylineGlow.BackgroundColor3 = Color3.fromRGB(255, 70, 70)
			payline.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
			paylineGlow.Size = UDim2.new(1, -4, 0, 12)
			paylineGlow.BackgroundTransparency = 0.55 + wave * 0.15
		end
		for index, arrow in ipairs(arrows) do
			local push = math.abs(math.sin(elapsed * 4)) * 2
			arrow.Position = UDim2.new(index - 1, (index == 1 and -12 or 12) + (index == 1 and push or -push), 0.5, 0)
			arrow.TextColor3 = winGlow and GOLD_LIGHT or GOLD
		end

		-- Pièces (gravité, rebond sur le bas de la machine)
		if activeCoins > 0 then
			for _, coin in ipairs(coins) do
				if coin.Active then
					coin.VY += 520 * dt
					coin.X += coin.VX * dt
					coin.Y += coin.VY * dt
					if coin.Y > H + 20 then
						coin.Active = false
						coin.Label.Visible = false
						activeCoins -= 1
					else
						coin.Angle += coin.Spin * dt
						coin.Label.Position = UDim2.fromOffset(coin.X, coin.Y)
						coin.Label.Size = UDim2.fromOffset(math.max(2, 14 * math.abs(math.cos(coin.Angle))), 14)
					end
				end
			end
		end

		-- Bannière jackpot : rayons qui tournent, puis disparition
		if jackpot.Visible then
			rays.Rotation = (rays.Rotation + dt * 60) % 360
			jackpotLabel.Rotation = math.sin(elapsed * 6) * 3
			if now > jackpotUntil then
				jackpot.Visible = false
			end
		end
	end)

	------------------------------------------------------------------
	-- Partie
	------------------------------------------------------------------
	local function stopReel(reel, id: string, extraDelay: number?)
		local base = math.floor(reel.Pos)
		local target = base + 5 + (extraDelay and 3 or 0)
		reel.Strip[wrap(target)] = id
		reel.StopFrom = reel.Pos
		reel.StopTo = target
		reel.StopT = 0
		local distance = target - reel.Pos
		reel.StopDur = math.clamp(3.9 * distance / math.max(reel.Speed, 1), 0.5, extraDelay and 2 or 1.3)
		reel.Mode = "stop"
	end

	local function allStopped(): boolean
		for _, reel in ipairs(reels) do
			if reel.Mode ~= "idle" then
				return false
			end
		end
		return true
	end

	-- Attend `seconds` ; renvoie false si le stimulus a été arrêté entre-temps
	local function waitAlive(seconds: number): boolean
		local finish = os.clock() + seconds
		while os.clock() < finish do
			if not ctx.IsAlive() then
				return false
			end
			task.wait()
		end
		return ctx.IsAlive()
	end

	local function randomLosingIds(): { string }
		-- Trois symboles différents (si possible) pour ne pas mentir au joueur
		local pool = {}
		for _, symbol in ipairs(symbols) do
			table.insert(pool, symbol.Id)
		end
		for i = #pool, 2, -1 do
			local j = random:NextInteger(1, i)
			pool[i], pool[j] = pool[j], pool[i]
		end
		return { pool[1], pool[2] or pool[1], pool[3] or pool[1] }
	end

	local function highlightWinners(ids: { string })
		local counts = {}
		for _, id in ipairs(ids) do
			counts[id] = (counts[id] or 0) + 1
		end
		for index, reel in ipairs(reels) do
			if (counts[ids[index]] or 0) >= 2 then
				local glow = reel.Glow
				task.spawn(function()
					for _ = 1, 4 do
						if not glow.Parent then
							return
						end
						UIUtil.Tween(glow, 0.18, { BackgroundTransparency = 0.05 })
						task.wait(0.2)
						if not glow.Parent then
							return
						end
						UIUtil.Tween(glow, 0.18, { BackgroundTransparency = 0.6 })
						task.wait(0.2)
					end
					if glow.Parent then
						UIUtil.Tween(glow, 0.3, { BackgroundTransparency = 1 })
					end
				end)
			end
		end
	end

	local function showResult(result)
		local bet = tonumber(result.Bet) or 0
		local payout = tonumber(result.Payout) or 0
		local multiplier = tonumber(result.Multiplier) or 0
		local center = UDim2.fromOffset(WINDOW_X + WINDOW_W / 2, WINDOW_Y + WINDOW_H / 2)
		local centerPoint = Vector2.new(WINDOW_X + WINDOW_W / 2, WINDOW_Y + WINDOW_H / 2)

		if payout > bet then
			highlightWinners(result.Reels)
			partyUntil = os.clock() + (multiplier >= 25 and 3.5 or 1.8)
			winGlowUntil = os.clock() + 2
			ctx.Sound.Play("SlotWin", multiplier >= 25 and 1.1 or 1)
			local text = "+" .. Format.Format(payout)
			floatOnOverlay(centerPoint, text, GOLD, multiplier >= 10 and 34 or 26)
			local winTexts = Locale.Pick(WIN_TEXTS)
			setInfo(winTexts[random:NextInteger(1, #winTexts)] .. " " .. Format.Multiplier(multiplier), GOLD_LIGHT, 3)
			UIUtil.Tween(windowStroke, 0.1, { Color = WHITE, Thickness = 3, Transparency = 0 })
			task.delay(0.6, function()
				if windowStroke.Parent then
					UIUtil.Tween(windowStroke, 0.4, { Color = GOLD, Thickness = 1.5, Transparency = 0.3 })
				end
			end)
			dropCoins(multiplier >= 25 and MAX_COINS or (multiplier >= 6 and 8 or 4))
			if effectsOn() then
				ctx.Effects.Burst(card, center, GOLD, multiplier >= 10 and 18 or 10)
			end
			if multiplier >= 25 then
				showJackpot(text .. " " .. Format.Multiplier(multiplier))
				ctx.Sound.Play("Jackpot", 1)
				ctx.Effects.Flash(GOLD, 0.45)
				ctx.Effects.BigMessage(Locale.T("🎰 JACKPOT! %s", text), GOLD, 2.5)
				if effectsOn() then
					ctx.Effects.Confetti(70)
				end
			elseif multiplier >= 6 and effectsOn() then
				ctx.Effects.Confetti(25)
			end
		elseif payout > 0 then
			highlightWinners(result.Reels)
			winGlowUntil = os.clock() + 1
			ctx.Sound.Play("Cash", 0.8)
			floatOnOverlay(centerPoint, "+" .. Format.Format(payout), WHITE, 22)
			setInfo(Locale.T("Partly refunded (%s) 🙃", Format.Multiplier(multiplier)), Color3.fromRGB(255, 225, 160), 2.5)
		else
			ctx.Sound.Play("Error", 0.75)
			UIUtil.Shake(window)
			local lossTexts = Locale.Pick(LOSS_TEXTS)
			setInfo(lossTexts[random:NextInteger(1, #lossTexts)], Color3.fromRGB(255, 150, 150), 2.5)
		end
	end

	local function play()
		if spinning or not ctx.IsAlive() then
			return
		end
		if not enabled or not casinoEnabled() then
			ctx.Sound.Play("Error", 1)
			UIUtil.Shake(playButton)
			return
		end
		local minBet = config.MinBet or 1
		if getDopamine() < minBet then
			ctx.Sound.Play("Error", 1)
			UIUtil.Shake(playButton)
			setInfo(Locale.T("You need at least %s Dopamine 😬", Format.Format(minBet)), Color3.fromRGB(255, 150, 150), 2)
			return
		end

		spinning = true
		setPlayEnabled(false)
		setPaytable(false)
		jackpot.Visible = false
		pullLever()
		ctx.Sound.Play("SlotSpin", 1)
		for _, reel in ipairs(reels) do
			reel.Mode = "spin"
			reel.Glow.BackgroundTransparency = 1
		end
		setInfo(Locale.T("Spinning… 🎲"), LED_TEXT)

		local fraction = fractions[selected] or fractions[1]
		task.spawn(function()
			local started = os.clock()
			local callOk, success, result = pcall(function()
				return ctx.Net.Function("CasinoSpin"):InvokeServer(fraction)
			end)
			if not waitAlive(math.max(0, MIN_SPIN_TIME - (os.clock() - started))) then
				return
			end

			local valid = callOk and success == true and type(result) == "table" and type(result.Reels) == "table"
			local ids = {}
			if valid then
				for index = 1, 3 do
					local id = result.Reels[index]
					if type(id) ~= "string" or not symbolsById[id] then
						id = symbols[1].Id
					end
					ids[index] = id
				end
			else
				ids = randomLosingIds()
			end

			-- Arrêts successifs (suspense si les deux premiers sont identiques)
			for index = 1, 3 do
				local suspense = valid and index == 3 and ids[1] == ids[2]
				if suspense then
					setInfo(Locale.T("🤞 Come on… come on…"), Theme.Colors.Yellow)
					partyUntil = os.clock() + 1
				end
				stopReel(reels[index], ids[index], suspense and 1 or nil)
				if not waitAlive(0.32) then
					return
				end
			end
			while not allStopped() do
				if not ctx.IsAlive() then
					return
				end
				task.wait()
			end

			if valid then
				showResult(result)
			else
				local message = (callOk and type(result) == "string") and result or Locale.T("The machine is on strike 🔧")
				ctx.Sound.Play("Error", 1)
				UIUtil.Shake(window)
				setInfo(message, Color3.fromRGB(255, 150, 150), 2.5)
			end

			spinning = false
			setPlayEnabled(enabled)
			refreshBetLabel()
		end)
	end

	ctx.Connect(playButton.Activated, play)
	ctx.Connect(leverButton.Activated, play)

	------------------------------------------------------------------
	-- Écran LED au repos : mise actuelle / petites annonces
	------------------------------------------------------------------
	local bestSymbol = symbols[1]
	for _, symbol in ipairs(symbols) do
		if (symbol.Triple or 0) > (bestSymbol.Triple or 0) then
			bestSymbol = symbol
		end
	end
	local attract = table.clone(Locale.Pick(ATTRACT_TEXTS))
	if bestSymbol then
		table.insert(attract, Locale.T("Triple %s = %s!", bestSymbol.Icon, Format.Multiplier(bestSymbol.Triple or 0)))
	end

	task.spawn(function()
		local tick = 0
		while ctx.IsAlive() do
			if enabled and not spinning and os.clock() >= infoLockUntil then
				tick += 1
				if tick % 8 == 0 then
					setInfo(attract[random:NextInteger(1, #attract)], Color3.fromRGB(255, 220, 150), 2)
				else
					setInfo(Locale.T("Bet: %s Dopamine", Format.Format(currentBet())), LED_TEXT)
				end
			end
			task.wait(0.5)
		end
	end)
end

return Casino
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">CursorTrail</string>
            <string name="Source"><![CDATA[--[[
	CursorTrail (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > CursorTrail

	Traînée magique : des étincelles arc-en-ciel suivent la souris (et le
	doigt sur mobile / tablette), tournoient, tombent un peu et s'éteignent.
	Chaque clic / toucher fait une petite gerbe d'étoiles.
	Purement visuel, non cliquable. 40 étincelles maximum, recyclées.
]]

local UserInputService = game:GetService("UserInputService")

local CursorTrail = {}
CursorTrail.Slot = "Overlay"

local MAX_SPARKLES = 40
local EMIT_SPACING = 14 -- distance (pixels "design") entre deux étincelles
local MAX_PER_FRAME = 3
local EMOJI_CHANCE = 0.18 -- parfois un ✨ / ⭐ au lieu d'un losange
local EMOJIS = { "✨", "⭐", "💫" }

function CursorTrail.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local container: Frame = ctx.Container
	local random = Random.new()

	local pool = {}
	local nextSlot = 1
	local hue = random:NextNumber()

	local pointer: Vector2? = nil -- dernière position connue (pixels écran réels)
	local lastEmit: Vector2? = nil
	local burstQueue = {} -- positions des clics à traiter

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	-- Crée toutes les étincelles une seule fois (recyclage circulaire)
	for i = 1, MAX_SPARKLES do
		local label = UIUtil.Create("TextLabel", {
			Name = "Sparkle",
			Size = UDim2.fromOffset(10, 10),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Font = Theme.Fonts.Body,
			Text = "",
			TextSize = 18,
			Active = false,
			Selectable = false,
			Visible = false,
			ZIndex = 60,
			Parent = container,
		})
		UIUtil.Corner(label, 3)
		local stroke = UIUtil.Stroke(label, Theme.Colors.Border, 1, 0.55)
		pool[i] = {
			Label = label,
			Stroke = stroke,
			Alive = false,
			Life = 0,
			MaxLife = 1,
			Pos = Vector2.zero,
			Vel = Vector2.zero,
			Size = 10,
			Spin = 0,
			Emoji = false,
		}
	end

	-- Émet une étincelle à `position` (pixels écran réels)
	local function emit(position: Vector2, velocity: Vector2, big: boolean?)
		local sparkle = pool[nextSlot]
		nextSlot = nextSlot % MAX_SPARKLES + 1

		hue = (hue + 0.035) % 1
		local color = Color3.fromHSV(hue, 0.8, 1)
		local isEmoji = random:NextNumber() < EMOJI_CHANCE
		local size = big and random:NextNumber(12, 18) or random:NextNumber(7, 13)

		sparkle.Alive = true
		sparkle.Emoji = isEmoji
		sparkle.Pos = position
		sparkle.Vel = velocity
		sparkle.Life = 0
		sparkle.MaxLife = random:NextNumber(0.45, 0.8)
		sparkle.Size = isEmoji and size * 1.8 or size
		sparkle.Spin = random:NextNumber(-360, 360)

		local label: TextLabel = sparkle.Label
		label.Rotation = 45
		if isEmoji then
			label.Text = EMOJIS[random:NextInteger(1, #EMOJIS)]
			label.TextSize = math.floor(sparkle.Size)
			label.TextTransparency = 0
			label.BackgroundTransparency = 1
			sparkle.Stroke.Enabled = false
		else
			label.Text = ""
			label.BackgroundColor3 = color
			label.BackgroundTransparency = 0
			sparkle.Stroke.Enabled = true
			sparkle.Stroke.Transparency = 0.55
		end
		label.Visible = true
	end

	-- Position du pointeur (même repère que AbsolutePosition)
	ctx.Connect(UserInputService.InputChanged, function(input: InputObject)
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseMovement or kind == Enum.UserInputType.Touch then
			pointer = Vector2.new(input.Position.X, input.Position.Y)
		end
	end)
	ctx.Connect(UserInputService.InputBegan, function(input: InputObject)
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch then
			local position = Vector2.new(input.Position.X, input.Position.Y)
			if kind == Enum.UserInputType.Touch then
				-- Nouveau doigt : pas de trait depuis l'ancienne position
				pointer = position
				lastEmit = position
			end
			if #burstQueue < 4 then
				table.insert(burstQueue, position)
			end
		end
	end)
	ctx.Connect(UserInputService.InputEnded, function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.Touch then
			pointer = nil
			lastEmit = nil
		end
	end)

	ctx.OnRender(function(dt: number)
		dt = math.min(dt, 0.1)
		local origin = container.AbsolutePosition
		local area = container.AbsoluteSize
		if area.X < 1 or area.Y < 1 then
			return
		end
		-- Pixels réels par pixel "design" (échelle de l'interface)
		local k = area.Y / 720
		local effects = effectsOn()

		-- Traînée : étincelles espacées le long du déplacement
		local current = pointer
		if current then
			if not lastEmit then
				lastEmit = current
			else
				local from = lastEmit :: Vector2
				local delta = current - from
				local distance = delta.Magnitude
				local spacing = EMIT_SPACING * k * (effects and 1 or 2.5)
				if distance >= spacing then
					local steps = math.min(MAX_PER_FRAME, math.floor(distance / spacing))
					for i = 1, steps do
						local point = from + delta * (i / steps)
						local drift = Vector2.new(random:NextNumber(-30, 30), random:NextNumber(-40, 10)) * k
						emit(point, drift - delta.Unit * 25 * k)
					end
					lastEmit = current
				end
			end
		end

		-- Gerbes de clic
		if #burstQueue > 0 then
			for _, position in ipairs(burstQueue) do
				local count = effects and 8 or 3
				local offset = random:NextNumber(0, math.pi * 2)
				for i = 1, count do
					local angle = offset + (i / count) * math.pi * 2
					local speed = random:NextNumber(110, 170) * k
					emit(position, Vector2.new(math.cos(angle), math.sin(angle)) * speed, true)
				end
			end
			table.clear(burstQueue)
		end

		-- Animation des étincelles vivantes
		local gravity = 160 * k
		for _, sparkle in ipairs(pool) do
			if sparkle.Alive then
				sparkle.Life += dt
				local ratio = sparkle.Life / sparkle.MaxLife
				local label: TextLabel = sparkle.Label
				if ratio >= 1 then
					sparkle.Alive = false
					label.Visible = false
				else
					sparkle.Vel = sparkle.Vel * (1 - math.min(1, 2.5 * dt)) + Vector2.new(0, gravity * dt)
					sparkle.Pos += sparkle.Vel * dt
					local relative = (sparkle.Pos - origin) / area
					label.Position = UDim2.fromScale(relative.X, relative.Y)
					label.Rotation += sparkle.Spin * dt
					-- Grossit vite puis rétrécit en s'éteignant
					local grow = ratio < 0.15 and (ratio / 0.15) or (1 - (ratio - 0.15) / 0.85)
					local size = math.max(1, sparkle.Size * (0.3 + 0.7 * grow))
					if sparkle.Emoji then
						label.TextSize = math.floor(size)
						label.Size = UDim2.fromOffset(size, size)
						label.TextTransparency = ratio * ratio
					else
						label.Size = UDim2.fromOffset(size, size)
						label.BackgroundTransparency = ratio * ratio
						sparkle.Stroke.Transparency = 0.55 + 0.45 * ratio
					end
				end
			end
		end
	end)
end

function CursorTrail.Stop(_ctx)
	-- Les étincelles sont dans ctx.Container (détruit par le StimulusManager)
end

return CursorTrail
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">DVD</string>
            <string name="Source"><![CDATA[--[[
	DVD (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > DVD

	Les logos "DOPA" qui rebondissent partout sur l'écran, façon vieil
	écran de veille. Logo 100 % original dessiné en code, style "badge"
	premium : une plaque sombre vernie avec un liseré lumineux, un disque
	brillant (anneau holographique qui tourne + reflet de lumière qui
	passe), le mot "DOPA" en gras (dégradé + contour) et une pastille
	"VIDÉO". Chaque logo a sa propre plaque opaque : quand plusieurs logos
	se croisent, ils passent proprement l'un devant l'autre (lisibles).
	  - Trajectoires données par le SERVEUR (ClientState.DVDSetup) et
	    calculées avec DVDMath depuis l'heure serveur : fluide et identique
	    quel que soit le nombre d'images par seconde.
	  - Traînée : 2 "fantômes" colorés placés sur la trajectoire un peu
	    plus tôt (DVDMath), halo coloré autour de la plaque.
	  - À chaque rebond : nouvelle couleur, écrasement contre le mur, flash
	    du halo, "+X" flottant (purement visuel, le serveur compte les
	    rebonds lui-même) et son "Bounce" si "DVDSound" est possédé.
	  - Coin touché : on prévient le serveur (DVDCorner), qui VÉRIFIE.
	  - Clic sur un logo : bonus (DVDClick), temps de recharge commun à
	    tous les logos (ils pâlissent pendant la recharge).
	  - Envoie la taille réelle du logo au serveur (DVDResize).
]]

local DVD = {}
DVD.Slot = "Overlay"

local Locale = require(game:GetService("ReplicatedStorage").Shared.Locale)

local RESIZE_INTERVAL = 0.6 -- temps minimum entre deux envois DVDResize
local COOLDOWN_FADE = 0.55 -- transparence des logos pendant la recharge
local MIN_SOUND_GAP = 0.07 -- évite la cacophonie avec 10 logos
local TRAIL_LAG = 0.07 -- retard (s) de chaque fantôme de la traînée
local TRAIL_ALPHA = { 0.8, 0.9 } -- transparence des 2 fantômes
local GLOW_ALPHA = 0.8 -- transparence normale du halo

local PLATE_COLOR = Color3.fromRGB(64, 56, 108) -- haut de la plaque (le bas est assombri)
local INK = Color3.fromRGB(18, 14, 34) -- contours sombres
local WHITE = Color3.new(1, 1, 1)

-- Petites phrases quand un logo frôle un coin sans le toucher
local NEAR_MISS = {
	en = { "almost... 😩", "one pixel off!", "noooo 😭", "so close...", "next time?", "argh!" },
	fr = { "presque... 😩", "à un pixel !", "noooon 😭", "si près...", "la prochaine ?", "argh !" },
}
local CORNER_TEXTS = {
	en = { "CORNER!!! 📀", "RIGHT IN THE CORNER!!!", "PERFECT CORNER HIT!" },
	fr = { "COIN !!! 📀", "DANS LE COIN !!!", "PILE DANS LE COIN !" },
}

-- Tire une phrase au hasard dans la liste de la langue du joueur
local function pickLine(variants, random: Random): string
	local list = Locale.Pick(variants)
	return list[random:NextInteger(1, #list)]
end

-- Reflet "holographique" de l'anneau du disque
local HOLO = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 120, 200)),
	ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 240, 150)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(130, 255, 220)),
	ColorSequenceKeypoint.new(0.75, Color3.fromRGB(140, 170, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 120, 200)),
})

-- Bande de lumière (le reste est invisible) : on fait glisser son Offset
local SWEEP = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 1),
	NumberSequenceKeypoint.new(0.4, 1),
	NumberSequenceKeypoint.new(0.5, 0.35),
	NumberSequenceKeypoint.new(0.6, 1),
	NumberSequenceKeypoint.new(1, 1),
})

-- Ombrage vertical "multiplié" sur la couleur de fond (clair en haut)
local function shade(bottom: number): ColorSequence
	return ColorSequence.new(WHITE, Color3.new(bottom, bottom, bottom))
end

function DVD.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local Config = ctx.Config
	local DVDMath = ctx.DVDMath
	local settings = Config.DVD
	local colors = settings.Colors
	local container: Frame = ctx.Container
	local random = Random.new()

	local logoSize: Vector2 = settings.LogoSize
	local useImage = settings.LogoImage ~= nil and settings.LogoImage ~= ""
	local W, H = logoSize.X, logoSize.Y

	local logos = {} -- [index] = objet logo (voir createLogo)
	local cooldownUntil = 0
	local cooling = false
	local lastSoundTime = 0

	local function getData()
		return ctx.State.Data
	end

	local function effectsOn(): boolean
		local data = getData()
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	-- Couleur du mot "DOPA" : la couleur du logo, éclaircie pour rester lisible
	local function inkFor(color: Color3): Color3
		return color:Lerp(WHITE, 0.3)
	end

	-- Élément centré sur (cx, cy) en pixels du logo, mais exprimé en
	-- proportions : l'écrasement (taille du corps) déforme tout le dessin
	local function place(props: { [string]: any }, cx: number, cy: number, w: number, h: number): { [string]: any }
		props.AnchorPoint = Vector2.new(0.5, 0.5)
		props.Position = UDim2.fromScale(cx / W, cy / H)
		props.Size = UDim2.fromScale(w / W, h / H)
		if props.BorderSizePixel == nil then
			props.BorderSizePixel = 0
		end
		return props
	end

	-- Sonde invisible de la taille d'un logo (sert à mesurer la taille réelle,
	-- sans être faussée par les animations d'écrasement)
	local probe = UIUtil.Create("Frame", {
		Name = "SizeProbe",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(W, H),
		Visible = false,
		Parent = container,
	})

	-- Taille du logo en fraction de l'écran
	local function measure(): (number?, number?)
		local parentSize = container.AbsoluteSize
		local size = probe.AbsoluteSize
		if parentSize.X < 1 or parentSize.Y < 1 or size.X < 1 or size.Y < 1 then
			return nil, nil
		end
		return size.X / parentSize.X, size.Y / parentSize.Y
	end

	------------------------------------------------------------------
	-- Construction d'un logo
	------------------------------------------------------------------
	local function createLogo(index: number)
		local logo = {
			Index = index,
			Params = nil :: any,
			LastX = nil :: number?,
			LastY = nil :: number?,
			ColorIndex = ((index - 1) % #colors) + 1,
			Fades = {} :: { { any } }, -- { instance, propriété, valeur normale }
			Ghosts = {} :: { Frame },
			Tinted = {} :: { { any } }, -- { instance, propriété } recolorés à chaque rebond
		}
		local color = colors[logo.ColorIndex]

		-- Traînée : 2 fantômes derrière tous les logos (ZIndex plus bas)
		for k = 1, #TRAIL_ALPHA do
			local ghost = UIUtil.Create("Frame", {
				Name = "DVDTrail" .. index .. "_" .. k,
				Size = UDim2.fromOffset(W, H),
				BackgroundColor3 = color,
				BackgroundTransparency = TRAIL_ALPHA[k],
				BorderSizePixel = 0,
				Visible = false,
				ZIndex = 2,
				Parent = container,
			})
			UIUtil.Corner(ghost, 18)
			logo.Ghosts[k] = ghost
			table.insert(logo.Tinted, { ghost, "BackgroundColor3" })
		end

		-- Racine = simple Frame (ne capte pas les clics) ; la zone cliquable
		-- est un bouton enfant "Hit", masqué pendant la recharge pour que les
		-- clics passent au bouton principal / aux cartes en dessous.
		local button = UIUtil.Create("Frame", {
			Name = "DVDLogo" .. index,
			Size = UDim2.fromOffset(W, H),
			BackgroundTransparency = 1,
			Active = false,
			Visible = false,
			ZIndex = 5,
			Parent = container,
		})
		local hit = UIUtil.Create("TextButton", {
			Name = "Hit",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			Visible = not cooling,
			ZIndex = 9,
			Parent = button,
		})

		-- Corps visuel (le bouton garde sa taille, seul le corps s'écrase)
		local body = UIUtil.Create("Frame", {
			Name = "Body",
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			ZIndex = 5,
			Parent = button,
		})
		local bodyScale = UIUtil.Create("UIScale", { Scale = 0, Parent = body })
		logo.Button = button
		logo.Hit = hit
		logo.Body = body
		logo.Scale = bodyScale

		-- Halo coloré (déborde un peu de la plaque, flashe à chaque rebond)
		local glow = UIUtil.Create("Frame", {
			Name = "Glow",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(1, 14, 1, 14),
			BackgroundColor3 = color,
			BackgroundTransparency = GLOW_ALPHA,
			BorderSizePixel = 0,
			ZIndex = 1,
			Parent = body,
		})
		UIUtil.Corner(glow, 24)
		logo.Glow = glow
		table.insert(logo.Tinted, { glow, "BackgroundColor3" })

		if useImage then
			-- Image personnalisée (blanche, recolorée)
			local image = UIUtil.Create("ImageLabel", {
				BackgroundTransparency = 1,
				Size = UDim2.fromScale(1, 1),
				Image = settings.LogoImage,
				ImageColor3 = color,
				ScaleType = Enum.ScaleType.Fit,
				ZIndex = 6,
				Parent = body,
			})
			table.insert(logo.Tinted, { image, "ImageColor3" })
			table.insert(logo.Fades, { image, "ImageTransparency", 0 })
		else
			-- Plaque vernie (sombre, dégradé vertical, liseré de la couleur du logo)
			local plate = UIUtil.Create("Frame", {
				Name = "Plate",
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = PLATE_COLOR,
				BackgroundTransparency = 0.04,
				BorderSizePixel = 0,
				ZIndex = 2,
				Parent = body,
			})
			UIUtil.Corner(plate, 18)
			UIUtil.Gradient(plate, shade(0.3), 90)
			local plateStroke = UIUtil.Stroke(plate, color, 2.5, 0.1)
			table.insert(logo.Tinted, { plateStroke, "Color" })

			-- Disque brillant
			local DX, DY, DS = 37, H / 2, 58
			local disc = UIUtil.Create("Frame", place({ Name = "Disc", BackgroundColor3 = color, ZIndex = 3, Parent = body }, DX, DY, DS, DS))
			UIUtil.Corner(disc, UDim.new(1, 0))
			UIUtil.Gradient(disc, shade(0.55), 45)
			local discStroke = UIUtil.Stroke(disc, WHITE, 2, 0.25)
			table.insert(logo.Tinted, { disc, "BackgroundColor3" })

			-- Anneau holographique (dégradé arc-en-ciel sur le contour, qui tourne)
			local ring = UIUtil.Create("Frame", place({ Name = "Ring", BackgroundTransparency = 1, ZIndex = 4, Parent = body }, DX, DY, 38, 38))
			UIUtil.Corner(ring, UDim.new(1, 0))
			local ringStroke = UIUtil.Stroke(ring, WHITE, 5, 0.3)
			local holo = UIUtil.Gradient(ringStroke, HOLO, 0)

			-- Moyeu
			local hub = UIUtil.Create("Frame", place({ Name = "Hub", BackgroundColor3 = INK, ZIndex = 5, Parent = body }, DX, DY, 15, 15))
			UIUtil.Corner(hub, UDim.new(1, 0))
			local hubStroke = UIUtil.Stroke(hub, WHITE, 2, 0.15)

			-- Reflet fixe (en haut à gauche)
			local highlight = UIUtil.Create("Frame", place({
				Name = "Highlight",
				BackgroundColor3 = WHITE,
				BackgroundTransparency = 0.45,
				Rotation = -35,
				ZIndex = 6,
				Parent = body,
			}, DX - 11, DY - 13, 20, 8))
			UIUtil.Corner(highlight, UDim.new(1, 0))

			-- Balayage de lumière qui traverse le disque de temps en temps
			local sweep = UIUtil.Create("Frame", place({
				Name = "Sweep",
				BackgroundColor3 = WHITE,
				ZIndex = 6,
				Parent = body,
			}, DX, DY, DS, DS))
			UIUtil.Corner(sweep, UDim.new(1, 0))
			local sweepGradient = UIUtil.Create("UIGradient", {
				Transparency = SWEEP,
				Rotation = 25,
				Offset = Vector2.new(-1, 0),
				Parent = sweep,
			})

			-- Mot "DOPA" : ombre portée + texte dégradé avec contour
			local TX, TW = 72 + (W - 76) / 2, W - 76
			local shadowLabel = UIUtil.Label(place({
				Name = "TitleShadow",
				Text = "DOPA",
				Font = Enum.Font.FredokaOne,
				TextColor3 = Color3.new(0, 0, 0),
				TextTransparency = 0.45,
				MaxTextSize = 40,
				ZIndex = 6,
				Parent = body,
			}, TX + 1.5, 30.5, TW, 34))
			local title = UIUtil.Label(place({
				Name = "Title",
				Text = "DOPA",
				Font = Enum.Font.FredokaOne,
				TextColor3 = inkFor(color),
				MaxTextSize = 40,
				ZIndex = 7,
				Parent = body,
			}, TX, 28, TW, 34))
			UIUtil.Gradient(title, shade(0.72), 90)
			local titleStroke = UIUtil.Stroke(title, INK, 2, 0)
			titleStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual

			-- Pastille "VIDÉO"
			local pill = UIUtil.Create("Frame", place({ Name = "Pill", BackgroundColor3 = color, ZIndex = 6, Parent = body }, TX, 60, TW - 10, 17))
			UIUtil.Corner(pill, UDim.new(1, 0))
			UIUtil.Gradient(pill, shade(0.7), 90)
			local pillStroke = UIUtil.Stroke(pill, WHITE, 1, 0.45)
			local pillText = UIUtil.Label({
				Name = "Text",
				Text = Locale.T("VIDEO"),
				Font = Theme.Fonts.Title,
				TextColor3 = Theme.ContrastText(color),
				Size = UDim2.fromScale(0.9, 0.9),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				MaxTextSize = 13,
				ZIndex = 7,
				Parent = pill,
			})
			table.insert(logo.Tinted, { pill, "BackgroundColor3" })

			logo.Holo = holo
			logo.Sweep = sweepGradient
			logo.Title = title
			logo.PillText = pillText
			table.insert(logo.Fades, { plate, "BackgroundTransparency", 0.04 })
			table.insert(logo.Fades, { plateStroke, "Transparency", 0.1 })
			table.insert(logo.Fades, { disc, "BackgroundTransparency", 0 })
			table.insert(logo.Fades, { discStroke, "Transparency", 0.25 })
			table.insert(logo.Fades, { ringStroke, "Transparency", 0.3 })
			table.insert(logo.Fades, { hub, "BackgroundTransparency", 0 })
			table.insert(logo.Fades, { hubStroke, "Transparency", 0.15 })
			table.insert(logo.Fades, { highlight, "BackgroundTransparency", 0.45 })
			table.insert(logo.Fades, { sweep, "BackgroundTransparency", 0 })
			table.insert(logo.Fades, { shadowLabel, "TextTransparency", 0.45 })
			table.insert(logo.Fades, { title, "TextTransparency", 0 })
			table.insert(logo.Fades, { titleStroke, "Transparency", 0 })
			table.insert(logo.Fades, { pill, "BackgroundTransparency", 0 })
			table.insert(logo.Fades, { pillStroke, "Transparency", 0.45 })
			table.insert(logo.Fades, { pillText, "TextTransparency", 0 })
		end

		-- Survol : le logo gonfle un peu (PC)
		ctx.Connect(hit.MouseEnter, function()
			if not cooling then
				UIUtil.Tween(bodyScale, 0.15, { Scale = 1.08 }, Enum.EasingStyle.Back)
			end
		end)
		ctx.Connect(hit.MouseLeave, function()
			UIUtil.Tween(bodyScale, 0.15, { Scale = 1 })
		end)

		-- Clic : bonus avec temps de recharge commun
		ctx.Connect(hit.Activated, function()
			if not ctx.IsAlive() then
				return
			end
			local center = UDim2.new(button.Position.X.Scale, W / 2, button.Position.Y.Scale, H / 2)
			if os.clock() < cooldownUntil then
				-- Encore en recharge : petit "non" et le temps restant
				UIUtil.Shake(body)
				ctx.FloatText(container, center, Locale.T("⏳ %ds", math.ceil(cooldownUntil - os.clock())), Theme.Colors.TextDim, 20)
				return
			end
			cooldownUntil = os.clock() + settings.ClickCooldown
			ctx.Net.Event("DVDClick"):FireServer(logo.Index)
			ctx.Sound.Play("Click", 1.3)
			bodyScale.Scale = 0.8
			UIUtil.Tween(bodyScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
			if effectsOn() then
				ctx.Effects.Burst(container, center, colors[logo.ColorIndex], 14)
			end
		end)

		return logo
	end

	-- Applique une couleur à tout le logo (petite transition)
	local function applyColor(logo, color: Color3)
		for _, entry in ipairs(logo.Tinted) do
			UIUtil.Tween(entry[1], 0.15, { [entry[2]] = color })
		end
		if logo.Title then
			UIUtil.Tween(logo.Title, 0.15, { TextColor3 = inkFor(color) })
		end
		if logo.PillText then
			logo.PillText.TextColor3 = Theme.ContrastText(color)
		end
	end

	local function nextColor(logo)
		-- Jamais deux fois la même couleur de suite
		local newIndex = random:NextInteger(1, #colors)
		if newIndex == logo.ColorIndex then
			newIndex = newIndex % #colors + 1
		end
		logo.ColorIndex = newIndex
		applyColor(logo, colors[newIndex])
	end

	local function setFaded(faded: boolean)
		for _, logo in ipairs(logos) do
			-- Pendant la recharge, les logos ne captent plus les clics
			logo.Hit.Visible = not faded
			for _, entry in ipairs(logo.Fades) do
				local target = faded and math.max(entry[3], COOLDOWN_FADE) or entry[3]
				UIUtil.Tween(entry[1], 0.25, { [entry[2]] = target })
			end
		end
	end

	------------------------------------------------------------------
	-- Envoi de la taille au serveur (limité à 1 envoi / 0,6 s)
	------------------------------------------------------------------
	local lastSentW, lastSentH = 0, 0
	local lastSendTime = -math.huge
	local pendingSend = false
	local pendingForce = false

	local function sendSize(force: boolean)
		if not ctx.IsAlive() or #logos == 0 then
			return
		end
		local w, h = measure()
		if not w or not h then
			return
		end
		if not force and math.abs(w - lastSentW) < 0.002 and math.abs(h - lastSentH) < 0.002 then
			return
		end
		lastSentW, lastSentH = w, h
		lastSendTime = os.clock()
		ctx.Net.Event("DVDResize"):FireServer(w, h)
	end

	local function requestSend(force: boolean)
		pendingForce = pendingForce or force
		if pendingSend then
			return
		end
		local wait = RESIZE_INTERVAL - (os.clock() - lastSendTime)
		pendingSend = true
		-- Toujours un petit délai : laisse le temps aux tailles de se stabiliser
		task.delay(math.max(0.1, wait), function()
			pendingSend = false
			local f = pendingForce
			pendingForce = false
			sendSize(f)
		end)
	end

	------------------------------------------------------------------
	-- Synchronisation avec DVDSetup
	------------------------------------------------------------------
	local function applySetup(setup)
		if not ctx.IsAlive() then
			return
		end
		local list = (setup and setup.Logos) or {}
		local previousCount = #logos

		-- Crée les logos manquants
		for index = #logos + 1, #list do
			local logo = createLogo(index)
			logos[index] = logo
			UIUtil.Tween(logo.Scale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
			if cooling then
				for _, entry in ipairs(logo.Fades) do
					(entry[1] :: any)[entry[2]] = math.max(entry[3], COOLDOWN_FADE)
				end
			end
		end
		-- Retire les logos en trop
		for index = #logos, #list + 1, -1 do
			local logo = logos[index]
			logos[index] = nil
			local button = logo.Button
			local ghosts = logo.Ghosts
			UIUtil.Tween(logo.Scale, 0.25, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			for _, ghost in ipairs(ghosts) do
				ghost.Visible = false
			end
			task.delay(0.3, function()
				button:Destroy()
				for _, ghost in ipairs(ghosts) do
					ghost:Destroy()
				end
			end)
		end
		-- Nouveaux paramètres de trajectoire
		for index, params in ipairs(list) do
			local logo = logos[index]
			logo.Params = params
			logo.LastX, logo.LastY = nil, nil
			logo.Button.Visible = true
		end

		if #list > 0 then
			-- Premier logo (ou retour après la détox) : on envoie la vraie taille
			-- si le serveur utilise une taille différente
			local w, h = measure()
			local first = list[1]
			local mismatch = w ~= nil
				and h ~= nil
				and type(first.W) == "number"
				and type(first.H) == "number"
				and (math.abs(first.W - w) > 0.003 or math.abs(first.H - h) > 0.003)
			requestSend(previousCount == 0 and mismatch)
		end
	end

	ctx.Connect(ctx.State.DVDSetupChanged, applySetup)
	ctx.Connect(container:GetPropertyChangedSignal("AbsoluteSize"), function()
		requestSend(false)
	end)
	applySetup(ctx.State.DVDSetup)

	------------------------------------------------------------------
	-- Rebonds (visuels)
	------------------------------------------------------------------
	local function onBounce(logo, x: number, y: number, w: number, h: number, bouncedX: boolean, bouncedY: boolean)
		nextColor(logo)

		-- Écrasement contre le mur (le corps s'aplatit puis reprend sa forme)
		local body = logo.Body
		if bouncedX and bouncedY then
			body.Size = UDim2.fromScale(0.88, 0.88)
		elseif bouncedX then
			body.Size = UDim2.fromScale(0.82, 1.1)
		else
			body.Size = UDim2.fromScale(1.1, 0.8)
		end
		UIUtil.Tween(body, 0.4, { Size = UDim2.fromScale(1, 1) }, Enum.EasingStyle.Back)

		-- Flash du halo
		local glow = logo.Glow
		glow.BackgroundTransparency = 0.35
		UIUtil.Tween(glow, 0.5, { BackgroundTransparency = GLOW_ALPHA })

		-- Point de contact (au milieu du bord touché)
		local contactX = x + w / 2
		local contactY = y + h / 2
		if bouncedX then
			contactX = (x < 0.5 - w / 2) and x or (x + w)
		end
		if bouncedY and not bouncedX then
			contactY = (y < 0.5 - h / 2) and y or (y + h)
		end

		local data = getData()
		local value = data and data.BounceValue or 0
		if value > 0 then
			ctx.FloatText(
				container,
				UDim2.fromScale(x + w / 2, y + h / 2),
				"+" .. ctx.Format.Format(value),
				colors[logo.ColorIndex],
				24
			)
		end
		if effectsOn() then
			ctx.Effects.Burst(container, UDim2.fromScale(contactX, contactY), colors[logo.ColorIndex], 4)
		end

		if ctx.HasFeature("DVDSound") then
			local now = os.clock()
			if now - lastSoundTime >= MIN_SOUND_GAP then
				lastSoundTime = now
				ctx.Sound.Play("Bounce", random:NextNumber(1.25, 1.75))
			end
		end
	end

	local function onCorner(logo, x: number, y: number, w: number, h: number)
		local center = UDim2.fromScale(x + w / 2, y + h / 2)
		ctx.FloatText(container, center, pickLine(CORNER_TEXTS, random), Theme.Colors.Gold, 44)
		if effectsOn() then
			ctx.Effects.Burst(container, center, Theme.Colors.Gold, 30)
			ctx.Effects.Burst(container, center, nil, 20)
		end
		local scale = logo.Scale
		scale.Scale = 1.5
		UIUtil.Tween(scale, 0.6, { Scale = 1 }, Enum.EasingStyle.Elastic)
		local glow = logo.Glow
		glow.BackgroundColor3 = Theme.Colors.Gold
		glow.BackgroundTransparency = 0.1
		UIUtil.Tween(glow, 1.2, { BackgroundTransparency = GLOW_ALPHA, BackgroundColor3 = colors[logo.ColorIndex] })
	end

	------------------------------------------------------------------
	-- Boucle d'affichage
	------------------------------------------------------------------
	local tolerance = settings.CornerTolerance
	ctx.OnRender(function()
		if #logos == 0 then
			return
		end
		local t = workspace:GetServerTimeNow()
		local w, h = measure()
		w = w or (W / 1280)
		h = h or (H / 720)

		-- Fin de la recharge : les logos reprennent leurs couleurs
		local isCooling = os.clock() < cooldownUntil
		if isCooling ~= cooling then
			cooling = isCooling
			setFaded(isCooling)
			if not isCooling then
				for _, logo in ipairs(logos) do
					logo.Scale.Scale = 1.15
					UIUtil.Tween(logo.Scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
				end
			end
		end

		-- Traînée seulement si les effets sont activés (et pas en recharge)
		local wantTrail = effectsOn() and not cooling

		for index, logo in ipairs(logos) do
			local params = logo.Params
			if params then
				local x, y = DVDMath.Position(params, t)
				logo.Button.Position = UDim2.fromScale(x, y)

				-- Fantômes : la même trajectoire, un peu plus tôt
				for k, ghost in ipairs(logo.Ghosts) do
					if wantTrail then
						local gx, gy = DVDMath.Position(params, t - k * TRAIL_LAG)
						ghost.Position = UDim2.fromScale(gx, gy)
					end
					if ghost.Visible ~= wantTrail then
						ghost.Visible = wantTrail
					end
				end

				-- Disque : anneau holographique qui tourne + reflet qui passe
				if logo.Holo then
					logo.Holo.Rotation = (t * 120 + index * 50) % 360
				end
				if logo.Sweep then
					local p = (t / 2.8 + index * 0.37) % 1
					logo.Sweep.Offset = Vector2.new(-1 + p * 3.2, 0)
				end

				local indexX, indexY = DVDMath.BounceIndex(params, t)
				local lastX, lastY = logo.LastX, logo.LastY
				local bouncedX = lastX ~= nil and indexX ~= lastX
				local bouncedY = lastY ~= nil and indexY ~= lastY

				if bouncedX or bouncedY then
					onBounce(logo, x, y, w, h, bouncedX, bouncedY)
				end

				if bouncedX and lastX then
					-- Numéro du bord touché = le plus grand des deux segments
					local k = math.max(indexX, lastX)
					if DVDMath.IsCornerAtBounceX(params, k, tolerance) then
						ctx.Net.Event("DVDCorner"):FireServer(index, k)
						onCorner(logo, x, y, w, h)
					else
						-- Frôlé ? (à moins de 3 % d'un coin)
						local _, rangeY = DVDMath.Ranges(params)
						if math.min(y, rangeY - y) < 0.03 then
							ctx.FloatText(
								container,
								UDim2.fromScale(x + w / 2, y + h / 2 + 0.06),
								pickLine(NEAR_MISS, random),
								Theme.Colors.TextDim,
								22
							)
						end
					end
				end

				logo.LastX, logo.LastY = indexX, indexY
			end
		end
	end)

	------------------------------------------------------------------
	-- Bonus confirmé par le serveur : "+X" au niveau du logo cliqué
	------------------------------------------------------------------
	ctx.OnBonus("DVD", function(payload)
		if not ctx.IsAlive() then
			return
		end
		local logo = logos[tonumber(payload.Index) or 1] or logos[1]
		local position = UDim2.fromScale(0.5, 0.4)
		if logo then
			local button = logo.Button
			position = UDim2.new(button.Position.X.Scale, W / 2, button.Position.Y.Scale, 0)
		end
		-- (le son "Bonus" est déjà joué par StimulusManager)
		ctx.FloatText(container, position, "+" .. ctx.Format.Format(tonumber(payload.Amount) or 0), Theme.Colors.Gold, 40)
	end)
end

function DVD.Stop(_ctx)
	-- Tout est dans ctx.Container (détruit par le StimulusManager)
end

return DVD
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Disco</string>
            <string name="Source"><![CDATA[--[[
	Disco (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > Disco

	Boule disco (calque Overlay) accrochée au bandeau d'actu, à droite de la
	colonne centrale (x = centre + 360, y = 20 : au-dessus des cartes du
	haut, pour ne jamais cacher R1 / CR) : une mosaïque de petites facettes qui
	"tournent" et scintillent, avec des reflets colorés.
	Elle projette des faisceaux de lumière translucides qui balayent tout
	l'écran en changeant de couleur, et quelques taches de lumière qui se
	promènent. Rien n'est cliquable : les clics passent à travers.
]]

local Debris = game:GetService("Debris")

local Disco = {}
Disco.Slot = "Overlay"

local BALL_X = 360 -- décalage depuis le centre de l'écran
local BALL_Y = 20 -- dans le bandeau d'actu (y 0-30) : les cartes commencent à y = 40
local BALL_SIZE = 36
local HALO_PAD = 20 -- le halo déborde de HALO_PAD / 2 autour de la boule
local TILE = 8 -- taille d'une facette (avec 1 px d'écart)
local GRID = 4 -- facettes par ligne / colonne (GRID * TILE <= BALL_SIZE)
local PATTERN_W = 14 -- largeur du motif qui "tourne"
local BEAM_LENGTH = 1500
local MAX_SPARKLES = 5

function Disco.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Create = UIUtil.Create
	local container: Frame = ctx.Container
	local random = Random.new()

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	local root = Create("Frame", {
		Name = "Disco",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Active = false,
		ZIndex = 1,
		Parent = container,
	})

	------------------------------------------------------------------
	-- Taches de lumière (derrière les faisceaux)
	------------------------------------------------------------------
	local spots = {}
	if effectsOn() then
		for index = 1, 4 do
			local size = random:NextInteger(140, 220)
			local spot = Create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(size, size),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BackgroundTransparency = 0.88,
				BorderSizePixel = 0,
				ZIndex = 1,
				Parent = root,
			})
			UIUtil.Corner(spot, UDim.new(1, 0))
			table.insert(spots, {
				Frame = spot,
				A = random:NextNumber(0.15, 0.35),
				B = random:NextNumber(0.12, 0.3),
				P = random:NextNumber(0, math.pi * 2),
				Q = random:NextNumber(0, math.pi * 2),
				Hue = index / 4,
			})
		end
	end

	------------------------------------------------------------------
	-- Faisceaux
	------------------------------------------------------------------
	local beams = {}
	local beamCount = effectsOn() and 6 or 3
	for index = 1, beamCount do
		local beam = Create("Frame", {
			Name = "Beam",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(BEAM_LENGTH, random:NextInteger(40, 70)),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			ZIndex = 2,
			Parent = root,
		})
		-- Lumineux près de la boule, s'efface au loin
		Create("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.62),
				NumberSequenceKeypoint.new(0.4, 0.84),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = beam,
		})
		table.insert(beams, {
			Frame = beam,
			-- La boule est à droite : les faisceaux partent surtout vers le bas / la gauche
			Base = 60 + (index - 1) * (110 / math.max(1, beamCount - 1)),
			Amp = random:NextNumber(18, 38),
			Freq = random:NextNumber(0.35, 0.8) * (random:NextNumber() < 0.5 and -1 or 1),
			Phase = random:NextNumber(0, math.pi * 2),
			Hue = (index - 1) / beamCount,
		})
	end

	------------------------------------------------------------------
	-- La boule
	------------------------------------------------------------------
	local ballPosition = UDim2.new(0.5, BALL_X, 0, BALL_Y)

	-- Halo coloré autour de la boule
	local halo = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = ballPosition,
		Size = UDim2.fromOffset(BALL_SIZE + HALO_PAD, BALL_SIZE + HALO_PAD),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.8,
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = root,
	})
	UIUtil.Corner(halo, UDim.new(1, 0))

	local ball = Create("Frame", {
		Name = "Ball",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = ballPosition,
		Size = UDim2.fromOffset(BALL_SIZE, BALL_SIZE),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = root,
	})
	UIUtil.Corner(ball, UDim.new(1, 0))
	UIUtil.Stroke(ball, Color3.fromRGB(40, 40, 50), 1.5, 0.2)
	UIUtil.Gradient(ball, ColorSequence.new(Color3.fromRGB(235, 235, 245), Color3.fromRGB(95, 95, 115)), 45)

	-- Facettes (seulement celles qui tiennent dans le cercle)
	local tiles = {}
	local radius = BALL_SIZE / 2
	local gridOrigin = (BALL_SIZE - GRID * TILE) / 2
	for i = 0, GRID - 1 do
		for j = 0, GRID - 1 do
			local cx = gridOrigin + i * TILE + TILE / 2 - radius
			local cy = gridOrigin + j * TILE + TILE / 2 - radius
			local far = math.sqrt((math.abs(cx) + TILE / 2) ^ 2 + (math.abs(cy) + TILE / 2) ^ 2)
			if far <= radius + 2 then
				local distance = math.sqrt(cx * cx + cy * cy)
				local tile = Create("Frame", {
					Position = UDim2.fromOffset(gridOrigin + i * TILE, gridOrigin + j * TILE),
					Size = UDim2.fromOffset(TILE - 1, TILE - 1),
					BackgroundColor3 = Color3.fromRGB(200, 200, 210),
					BackgroundTransparency = 0.1,
					BorderSizePixel = 0,
					ZIndex = 6,
					Parent = ball,
				})
				-- Plus sombre sur les bords (effet de sphère), plus clair en haut à gauche
				local shade = 1 - (distance / radius) * 0.4 - (cx + cy) / BALL_SIZE * 0.2
				table.insert(tiles, { Frame = tile, I = i, J = j, Shade = math.clamp(shade, 0.35, 1.1) })
			end
		end
	end

	-- Reflet
	local highlight = Create("Frame", {
		Position = UDim2.fromOffset(7, 6),
		Size = UDim2.fromOffset(8, 6),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
		ZIndex = 8,
		Parent = ball,
	})
	UIUtil.Corner(highlight, UDim.new(1, 0))

	-- Motif de luminosité qui défile (donne l'illusion de rotation)
	local pattern = {}
	for x = 1, PATTERN_W do
		pattern[x] = {}
		for y = 1, GRID do
			pattern[x][y] = random:NextNumber(0.55, 1)
		end
	end

	------------------------------------------------------------------
	-- Étincelles autour de la boule
	------------------------------------------------------------------
	local sparkles = 0
	local function spawnSparkle()
		if sparkles >= MAX_SPARKLES then
			return
		end
		sparkles += 1
		local angle = random:NextNumber(0, math.pi * 2)
		local distance = random:NextNumber(radius + 4, radius + 26)
		local star = UIUtil.Label({
			Text = random:NextNumber() < 0.6 and "✦" or "✨",
			TextColor3 = Color3.new(1, 1, 1),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = ballPosition + UDim2.fromOffset(math.cos(angle) * distance, math.sin(angle) * distance),
			Size = UDim2.fromOffset(16, 16),
			MaxTextSize = 16,
			ZIndex = 9,
			Parent = root,
		})
		local stroke = UIUtil.Stroke(star, Color3.fromRGB(90, 60, 140), 1, 0.3)
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		local scale = Create("UIScale", { Scale = 0.1, Parent = star })
		UIUtil.Tween(scale, 0.25, { Scale = 1.1 }, Enum.EasingStyle.Back)
		UIUtil.Tween(star, 0.7, { TextTransparency = 1, Rotation = random:NextNumber(-90, 90) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		UIUtil.Tween(stroke, 0.7, { Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Debris:AddItem(star, 0.75)
		task.delay(0.75, function()
			sparkles -= 1
		end)
	end

	------------------------------------------------------------------
	-- Animation
	------------------------------------------------------------------
	local time = 0
	local tileClock = 0
	local sparkleClock = 0
	local rotationStep = 0

	ctx.OnRender(function(dt: number)
		time += dt

		-- Faisceaux qui balayent (pivot = la boule)
		for _, beam in ipairs(beams) do
			local angle = beam.Base + math.sin(time * beam.Freq + beam.Phase) * beam.Amp
			local radians = math.rad(angle)
			local half = BEAM_LENGTH / 2
			beam.Frame.Position = UDim2.new(0.5, BALL_X + math.cos(radians) * half, 0, BALL_Y + math.sin(radians) * half)
			beam.Frame.Rotation = angle
			beam.Frame.BackgroundColor3 = Color3.fromHSV((time * 0.08 + beam.Hue) % 1, 0.7, 1)
			beam.Frame.BackgroundTransparency = 0.15 + (math.sin(time * 2.3 + beam.Phase) + 1) * 0.15
		end

		-- Taches de lumière (courbes de Lissajous)
		for _, spot in ipairs(spots) do
			spot.Frame.Position = UDim2.fromScale(
				0.5 + math.sin(time * spot.A + spot.P) * 0.45,
				0.55 + math.sin(time * spot.B + spot.Q) * 0.38
			)
			spot.Frame.BackgroundColor3 = Color3.fromHSV((time * 0.05 + spot.Hue) % 1, 0.6, 1)
		end

		local hueColor = Color3.fromHSV((time * 0.08) % 1, 0.8, 1)
		halo.BackgroundColor3 = hueColor
		halo.BackgroundTransparency = 0.78 + math.sin(time * 3) * 0.06

		-- Facettes (10 fois par seconde suffit)
		tileClock += dt
		if tileClock >= 0.1 then
			tileClock = 0
			rotationStep += 1
			local flash = random:NextInteger(1, math.max(1, #tiles))
			for index, tile in ipairs(tiles) do
				local column = ((tile.I + rotationStep) % PATTERN_W) + 1
				local value = pattern[column][tile.J + 1] * tile.Shade
				local grey = Color3.new(math.min(1, value), math.min(1, value), math.min(1, value * 1.04))
				if index == flash then
					tile.Frame.BackgroundColor3 = Color3.new(1, 1, 1)
				else
					-- Reflets colorés des faisceaux
					tile.Frame.BackgroundColor3 = grey:Lerp(hueColor, (column % 4 == 0) and 0.45 or 0.12)
				end
			end
		end

		-- Étincelles
		if effectsOn() then
			sparkleClock += dt
			if sparkleClock >= 0.35 then
				sparkleClock = 0
				spawnSparkle()
			end
		end
	end)
end

return Disco
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">

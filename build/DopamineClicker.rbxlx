	[5] = { Body = WHITE, Accent = rgb(0, 214, 255), Stripe = rgb(0, 214, 255), Laces = rgb(0, 214, 255), Sole = rgb(60, 244, 255), Glow = rgb(0, 230, 255), Trail = "Neon" },

	fr = { "Bloqué ! N'ouvre jamais un .exe inconnu 🛡️", "Bien essayé, le virus. Supprimé. 🛡️" },
}

-- Icône + couleur d'une pièce jointe selon son extension
local FILE_TYPES = {
	pdf = { Icon = "📕", Color = Color3.fromRGB(226, 60, 60) },
	xls = { Icon = "📊", Color = Color3.fromRGB(40, 160, 80) },
	jpg = { Icon = "🖼️", Color = Color3.fromRGB(40, 130, 230) },
	mp3 = { Icon = "🎵", Color = Color3.fromRGB(150, 70, 225) },
	zip = { Icon = "🗜️", Color = Color3.fromRGB(240, 150, 20) },
	exe = { Icon = "⚠️", Color = Color3.fromRGB(150, 20, 40) },
}

-- "Prince de Pixelie" -> "prince.de.pixelie"
local ACCENTS = {
	{ "[éèêë]", "e" },
	{ "[àâä]", "a" },
	{ "[ôö]", "o" },
	{ "[ùûü]", "u" },
	{ "[îï]", "i" },
	{ "ç", "c" },
	{ "É", "e" },
}
local function slug(value: string): string
	local result = string.lower(value)
	for _, pair in ipairs(ACCENTS) do
		-- Les accents UTF-8 font 2 octets : on remplace mot à mot
		local chars = pair[1]
		if string.sub(chars, 1, 1) == "[" then
			local inner = string.sub(chars, 2, -2)
			for _, code in utf8.codes(inner) do
				result = string.gsub(result, utf8.char(code), pair[2])
			end
		else
			result = string.gsub(result, chars, pair[2])
		end
	end
	result = string.gsub(result, "[^%a%d]+", ".")
	result = string.gsub(result, "^%.+", "")
	result = string.gsub(result, "%.+$", "")
	return result
end

local function pick(list: { any }, variant: any): any
	local v = math.floor(tonumber(variant) or 1)
	return list[(v - 1) % #list + 1]
end

local function pickLine(variants): string
	local list = Locale.Pick(variants)
	return list[math.random(1, #list)]
end

-- Étiquette d'affichage { Id, Text, Color } d'un identifiant de TAGS
local function makeTag(id: string)
	local known = TAGS[id] ~= nil
	local style = known and TAGS[id] or TAGS.PERSO
	return { Id = known and id or "PERSO", Text = Locale.T(style.Text), Color = style.Color }
end

-- Transforme une entrée compacte en mail complet
local function buildEmail(entry): { [string]: any }
	local sender = entry[3]
	local attachment = nil
	if type(entry[7]) == "string" then
		local name = string.gsub(entry[7], "^📎%s*", "")
		local extension = string.lower(string.match(name, "%.(%w+)$") or "")
		local kb = (#name * 137) % 2900 + 40
		attachment = {
			Name = name,
			Type = FILE_TYPES[extension] or { Icon = "📄", Color = Color3.fromRGB(110, 116, 132) },
			Size = kb >= 1000 and string.format("%.1f MB", kb / 1000) or (kb .. " KB"),
			Virus = extension == "exe",
		}
	end
	return {
		Tag = makeTag(entry[1]),
		Avatar = entry[2],
		Sender = sender,
		Address = slug(sender) .. Locale.T("@dopamail.com"),
		Subject = entry[4],
		Body = entry[5],
		Signature = entry[6] or sender,
		Attachment = attachment,
		Suspicious = entry[1] == "ARNAQUE" or entry[1] == "SPAM",
	}
end

local function pickFrom(list: { string }?): string
	if type(list) ~= "table" or #list == 0 then
		return ""
	end
	return list[math.random(1, #list)]
end

local function trim(value: string): string
	local left = string.gsub(value, "^%s+", "")
	local both = string.gsub(left, "%s+$", "")
	return both
end

-- "Re: " + objet (sans empiler "Re: Re: Re:")
local function prefixed(prefix: string, subject: string): string
	if string.sub(subject, 1, #prefix) == prefix then
		return subject
	end
	return prefix .. subject
end

-- Réponse automatique d'un correspondant (texts : CONTACT_TEXT ou TAG_VOICES)
-- selon les sujets (Topics) du message envoyé
local function composeReply(texts, topics: { any }, forwarded: boolean, caps: boolean): string
	local shared = Locale.Pick(TOPIC_LINES)
	local lines: { string } = {}
	if forwarded then
		table.insert(lines, pickFrom(texts.Forward or shared.Forward))
	end
	local seen = {}
	for _, topic in ipairs(topics) do
		if #lines >= 2 then
			break
		end
		if type(topic) == "string" and not seen[topic] then
			seen[topic] = true
			local pool = (texts.Special and texts.Special[topic]) or shared[topic]
			if pool then
				table.insert(lines, pickFrom(pool))
			end
		end
	end
	if #lines < 2 then
		table.insert(lines, pickFrom(texts.Generic))
	end
	local parts: { string } = {}
	for _, piece in ipairs({ pickFrom(texts.Hello), table.concat(lines, " "), pickFrom(texts.Bye) }) do
		if piece ~= "" then
			table.insert(parts, piece)
		end
	end
	-- (numéro de ticket AVANT les majuscules : "{n}" deviendrait "{N}")
	local body = string.gsub(table.concat(parts, " "), "{n}", tostring(math.random(10000, 99999)))
	if caps then
		body = shout(body)
	end
	if texts.Before then
		body = texts.Before .. body .. (texts.After or "")
	end
	return body
end

function Email.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local container: Frame = ctx.Container
	local random = Random.new()
	container.ZIndex = RAISED_Z

	local C = {
		White = Color3.new(1, 1, 1),
		Paper = Color3.fromRGB(255, 252, 244),
		Ink = Color3.fromRGB(28, 32, 44),
		InkSoft = Color3.fromRGB(56, 62, 80),
		InkDim = Color3.fromRGB(110, 116, 132),
		Blue = Color3.fromRGB(40, 120, 240),
		BlueDark = Color3.fromRGB(22, 84, 196),
		Border = Color3.fromRGB(30, 34, 48),
		Line = Color3.fromRGB(226, 230, 238),
		Side = Color3.fromRGB(243, 246, 252),
		Red = Color3.fromRGB(226, 38, 52),
		Green = Color3.fromRGB(24, 158, 88),
		Gold = Color3.fromRGB(240, 170, 20),
		Grey = Color3.fromRGB(120, 124, 136),
		Selected = Color3.fromRGB(221, 233, 255),
		Unread = Color3.fromRGB(240, 246, 255),
		Hover = Color3.fromRGB(246, 248, 252),
		Field = Color3.fromRGB(248, 249, 252),
		BrandA = Color3.fromRGB(58, 110, 255),
		BrandB = Color3.fromRGB(126, 72, 238),
	}
	local FONT_TITLE = Theme.Fonts.Title
	local FONT_BODY = Theme.Fonts.Body
	local FONT_NUMBER = Theme.Fonts.Number
	local ITALIC = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Medium, Enum.FontStyle.Italic)

	-- Le joueur (expéditeur des mails écrits)
	local player = Players.LocalPlayer
	local me = {
		Name = Locale.T("Me"),
		Avatar = "😎",
		-- (photo du joueur : sur les mails envoyés à un ami)
		Image = player and ("rbxthumb://type=AvatarHeadShot&id=" .. tostring(player.UserId) .. "&w=150&h=150") or nil,
		Address = string.lower(player and player.Name or "you") .. Locale.T("@dopamail.com"),
	}

	-- Correspondants (textes dans la langue du joueur)
	local contacts: { any } = {}
	do
		local texts = Locale.Pick(CONTACT_TEXT)
		for _, def in ipairs(CONTACTS) do
			local t = texts[def.Id]
			table.insert(contacts, {
				Id = def.Id,
				Avatar = def.Avatar,
				Tag = def.Tag,
				Caps = def.Caps == true,
				Name = t.Name,
				Short = t.Short,
				Signature = t.Signature,
				Address = slug(t.Name) .. Locale.T("@dopamail.com"),
			})
		end
	end
	local contactsById: { [string]: any } = {}
	for _, contact in ipairs(contacts) do
		contactsById[contact.Id] = contact
	end

	-- Amis Roblox : un "correspondant" par ami (photo, nom affiché, @pseudo)
	local function headshot(userId: number): string
		return "rbxthumb://type=AvatarHeadShot&id=" .. tostring(userId) .. "&w=150&h=150"
	end
	local friendContacts: { [number]: any } = {}
	local function friendContact(userId: number, name: any, display: any)
		local contact = friendContacts[userId]
		if not contact then
			contact = {
				Id = "Friend_" .. tostring(userId),
				Friend = true,
				UserId = userId,
				Avatar = "👤",
				Tag = "FRIEND",
				Image = headshot(userId),
				Short = "#" .. tostring(userId),
				Address = "#" .. tostring(userId),
			}
			friendContacts[userId] = contact
		end
		if type(display) == "string" and display ~= "" then
			contact.Short = display
		elseif type(name) == "string" and name ~= "" then
			contact.Short = name
		end
		if type(name) == "string" and name ~= "" then
			contact.Address = "@" .. name
		end
		contact.Name = "👤 " .. contact.Short
		return contact
	end

	-- État des mails d'amis (réponses du serveur, liste d'amis, présence)
	local FS = {
		Status = nil :: any, -- { Enabled, Reason, NewIn, ReplyIn } (secondes au moment StatusClock)
		StatusClock = 0,
		Friends = nil :: { any }?, -- { { Id, Name, Display } }
		FriendsClock = -math.huge,
		Loading = false,
		Error = nil :: string?,
		Online = {} :: { [number]: boolean },
		OnlineClock = -math.huge,
		Blocked = {} :: { [string]: boolean },
		Known = {} :: { [string]: any }, -- id serveur -> mail
		Booted = false,
		Sorted = {} :: { any },
	}

	------------------------------------------------------------------
	-- Modèle : TOUS les mails de la session (les plus récents en premier)
	--   Kind : "Spawn" (serveur) | "Reply" (réponse d'un correspondant) | "Sent"
	--   Folder : "Inbox" | "Sent" | "Spam" | "Trash" ; Read ; Starred
	--   State : "Live" (réclamable) | "Claimed" | "Expired" | "Missed" | "Local"
	------------------------------------------------------------------
	local mails: { any } = {}
	local bySpawn: { [string]: any } = {}
	local keySeq = 0
	local envelopes: { [string]: any } = {}
	local envelopeCount = 0
	local positions: { [string]: UDim2 } = {}
	local lastPosition = UDim2.fromScale(0.5, 0.45)
	local S = {
		Open = false,
		View = "List", -- "List" | "Message" | "Compose"
		Folder = "Inbox",
		Selected = nil :: any,
		Search = "",
		Draft = nil :: any, -- { Kind, Contact, Fixed, Quote, SubjectText, BodyText }
		Sending = nil :: any, -- jeton de l'envoi en cours
		Interaction = 0, -- augmente à chaque action dans la fenêtre (annule la fermeture auto)
		CloseToken = 0,
		SnackToken = 0,
		SnackAction = nil :: any,
		SnackTarget = nil :: any, -- mail annoncé par le snack (caché quand on l'ouvre)
		Group = "Characters", -- destinataires de la rédaction : "Characters" | "Friends"
		Confirm = nil :: any, -- { Id, Mail, Until } : Signaler / Bloquer attendent un 2e clic
		StatusHold = 0, -- un message d'erreur reste affiché jusque-là
	}
	local UI: any = nil -- fenêtre (construite à la première ouverture, puis réutilisée)

	-- Fonctions définies plus bas
	local refresh: (bump: boolean?) -> ()
	local openWindow: () -> ()
	local closeWindow: () -> ()
	local openMail: (mail: any, source: string?) -> ()
	local openCompose: (options: any) -> ()
	local setView: (view: string) -> ()
	local renderAll: () -> ()
	local renderMessage: (mail: any) -> ()
	local snack: (message: string, action: (() -> ())?, target: any?) -> ()
	local spawnCard: (mail: any, info: any?) -> ()
	local removeEnvelope: (envelope: any, opened: boolean) -> ()
	local expireMail: (mail: any) -> ()
	local updateFriendSend: () -> ()
	local renderFriendArea: () -> ()

	local function now(): number
		return os.clock()
	end

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	-- Connexion liée à un élément de l'interface (coupée avec lui)
	local function on(signal: RBXScriptSignal, callback: (...any) -> ())
		signal:Connect(function(...)
			if ctx.IsAlive() then
				callback(...)
			end
		end)
	end

	-- Bouton de la fenêtre : compte comme une interaction (annule la fermeture auto)
	local function onClick(button: GuiButton, callback: () -> ())
		on(button.Activated, function()
			S.Interaction += 1
			callback()
		end)
	end

	local function frame(props: { [string]: any }): Frame
		props.BorderSizePixel = 0
		if props.BackgroundTransparency == nil and props.BackgroundColor3 == nil then
			props.BackgroundTransparency = 1
		end
		return UIUtil.Create("Frame", props)
	end

	local function text(props: { [string]: any }): TextLabel
		props.BackgroundTransparency = props.BackgroundTransparency or 1
		props.BorderSizePixel = 0
		props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
		props.Font = props.Font or FONT_BODY
		props.TextColor3 = props.TextColor3 or C.Ink
		return UIUtil.Create("TextLabel", props)
	end

	-- Largeur d'un texte d'une ligne (pixels "design")
	local function textWidth(value: string, size: number, font: Enum.Font): number
		local ok, bounds = pcall(function()
			return TextService:GetTextSize(value, size, font, Vector2.new(2000, 200))
		end)
		if ok and typeof(bounds) == "Vector2" then
			return bounds.X
		end
		return (utf8.len(value) or #value) * size * 0.55
	end

	-- Bouton : un TextButton sans texte + un TextLabel "Label" (un dégradé
	-- sur le bouton ne teinte pas le texte). kind : "primary" | "secondary" |
	-- "danger" | "ghost"
	local function makeButton(props: { [string]: any }, kind: string, label: string, textSize: number, radius: number?): (TextButton, TextLabel)
		props.AutoButtonColor = false
		props.BorderSizePixel = 0
		props.Text = ""
		if kind == "ghost" then
			props.BackgroundColor3 = props.BackgroundColor3 or C.White
			if props.BackgroundTransparency == nil then
				props.BackgroundTransparency = 1
			end
		else
			props.BackgroundColor3 = props.BackgroundColor3 or (kind == "primary" and C.Blue or C.White)
		end
		local button = UIUtil.Create("TextButton", props)
		UIUtil.Corner(button, radius or 10)
		if kind == "primary" then
			UIUtil.Gradient(button, ColorSequence.new(C.White, Color3.fromRGB(200, 212, 255)), 90)
			UIUtil.Stroke(button, C.BlueDark, 1.5, 0)
		elseif kind ~= "ghost" then
			UIUtil.Gradient(button, ColorSequence.new(C.White, Color3.fromRGB(234, 237, 245)), 90)
			UIUtil.Stroke(button, kind == "danger" and Color3.fromRGB(240, 186, 190) or Color3.fromRGB(198, 204, 220), 1.3, 0)
		end
		local labelObject = UIUtil.Create("TextLabel", {
			Name = "Label",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(1, -12, 1, -8),
			BackgroundTransparency = 1,
			Font = FONT_TITLE,
			Text = label,
			TextColor3 = kind == "primary" and C.White or (kind == "danger" and C.Red or C.Ink),
			TextScaled = true,
			ZIndex = (props.ZIndex or 1) + 1,
			Parent = button,
		})
		UIUtil.Create("UITextSizeConstraint", { MaxTextSize = textSize, MinTextSize = math.max(8, textSize - 6), Parent = labelObject })
		UIUtil.AnimateButton(button, 1.04, 0.95)
		return button, labelObject
	end

	-- Avatar rond (dégradé de la couleur de l'étiquette + emoji), réutilisable
	local function makeAvatar(parent: Instance, size: number, position: UDim2, zIndex: number)
		local circle = frame({ Name = "Avatar", Size = UDim2.fromOffset(size, size), Position = position, BackgroundColor3 = C.White, ZIndex = zIndex, Parent = parent })
		UIUtil.Corner(circle, UDim.new(1, 0))
		local gradient = UIUtil.Gradient(circle, ColorSequence.new(C.White, C.White), 135)
		local stroke = UIUtil.Stroke(circle, C.Line, 1.5, 0.15)
		local emoji = text({
			Size = UDim2.fromScale(1, 1),
			Position = UDim2.fromOffset(0, 1),
			Text = "",
			TextSize = math.floor(size * 0.56),
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = zIndex + 1,
			Parent = circle,
		})
		-- Photo (amis Roblox) : par-dessus l'emoji, ronde elle aussi
		local photo = UIUtil.Create("ImageLabel", {
			Name = "Photo",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Image = "",
			ScaleType = Enum.ScaleType.Crop,
			Visible = false,
			ZIndex = zIndex + 1,
			Parent = circle,
		})
		UIUtil.Corner(photo, UDim.new(1, 0))
		local avatar = { Frame = circle }
		function avatar.Set(value: string, color: Color3, image: string?)
			local hasImage = type(image) == "string" and image ~= ""
			emoji.Text = hasImage and "" or value
			photo.Visible = hasImage
			if hasImage and photo.Image ~= image then
				photo.Image = image :: string
			end
			gradient.Color = ColorSequence.new(color:Lerp(C.White, 0.72), color:Lerp(C.White, 0.36))
			stroke.Color = color
		end
		return avatar
	end

	-- Pastille (étiquette, "NOUVEAU +X"...) : largeur calculée sur le texte
	local function makeChip(parent: Instance, height: number, zIndex: number)
		local chip = frame({ Name = "Chip", Size = UDim2.fromOffset(40, height), BackgroundColor3 = C.Blue, ZIndex = zIndex, Parent = parent })
		UIUtil.Corner(chip, UDim.new(1, 0))
		local label = text({
			Size = UDim2.fromScale(1, 1),
			Font = FONT_TITLE,
			TextColor3 = C.White,
			TextSize = math.floor(height * 0.64),
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = zIndex + 1,
			Parent = chip,
		})
		local out = { Frame = chip, Label = label }
		function out.Set(value: string, color: Color3): number
			label.Text = value
			chip.BackgroundColor3 = color
			local width = math.ceil(textWidth(value, label.TextSize, FONT_TITLE)) + 14
			chip.Size = UDim2.fromOffset(width, height)
			return width
		end
		return out
	end

	local function tagColor(id: string): Color3
		local style = TAGS[id] or TAGS.PERSO
		return style.Color
	end

	local function timeLabel(at: number): string
		local seconds = math.max(0, now() - at)
		if seconds < 60 then
			return Locale.T("now")
		end
		local minutes = math.floor(seconds / 60)
		if minutes < 60 then
			return Locale.T("%d min", minutes)
		end
		local hours = math.floor(minutes / 60)
		if hours < 24 then
			return Locale.T("%d h", hours)
		end
		return Locale.T("%d d", math.floor(hours / 24))
	end

	local function countText(count: number, forms): string
		local words = Locale.Pick(forms)
		return tostring(math.floor(count)) .. " " .. (count == 1 and words.One or words.Many)
	end

	local function folderName(id: string, long: boolean?): string
		local names = Locale.Pick(FOLDER_NAMES)
		return (long and names.Long or names.Short)[id] or id
	end

	-- Dopamine estimée d'un mail (même calcul que le serveur)
	local function estimateReward(): number
		local data = ctx.State.Data
		local settings = ctx.Config.Spawners and ctx.Config.Spawners.Email
		if not settings then
			return 0
		end
		local stats = {
			PerSecond = (data and tonumber(data.PerSecond)) or 0,
			ClickValue = (data and tonumber(data.ClickValue)) or 0,
		}
		local ok, amount = pcall(ctx.Formulas.ScaledReward, stats, settings.RewardSeconds or 8, settings.MinReward or 50)
		return ok and (tonumber(amount) or 0) or 0
	end

	------------------------------------------------------------------
	-- Modèle : requêtes et changements
	------------------------------------------------------------------
	local function isLive(mail): boolean
		return mail.State == "Live" and now() < mail.ExpiresAt
	end

	local function inFolder(mail, folder: string): boolean
		if folder == "Friends" then
			return mail.Friend == true and (mail.Folder == "Inbox" or mail.Folder == "Sent")
		end
		if folder == "Starred" then
			return mail.Starred == true and (mail.Folder == "Inbox" or mail.Folder == "Sent")
		end
		return mail.Folder == folder
	end

	local function unreadCount(): number
		local count = 0
		for _, mail in ipairs(mails) do
			if mail.Folder == "Inbox" and not mail.Read then
				count += 1
			end
		end
		return count
	end

	local function folderCount(folder: string): number
		if folder == "Inbox" then
			return unreadCount()
		end
		if folder == "Friends" then
			local count = 0
			for _, mail in ipairs(mails) do
				if mail.Kind == "Friend" and mail.Folder == "Inbox" and not mail.Read then
					count += 1
				end
			end
			return count
		end
		local count = 0
		for _, mail in ipairs(mails) do
			if inFolder(mail, folder) then
				count += 1
			end
		end
		return count
	end

	local function matches(mail, query: string): boolean
		if query == "" then
			return true
		end
		local e = mail.Email
		local haystack = string.lower(e.Sender .. " " .. e.Subject .. " " .. e.Body .. " " .. (mail.To and mail.To.Name or ""))
		return string.find(haystack, query, 1, true) ~= nil
	end

	local function removeMail(mail)
		local index = table.find(mails, mail)
		if index then
			table.remove(mails, index)
		end
		if mail.SpawnId and bySpawn[mail.SpawnId] == mail then
			bySpawn[mail.SpawnId] = nil
		end
		if mail.FriendId and FS.Known[mail.FriendId] == mail then
			FS.Known[mail.FriendId] = nil
		end
		if mail.Envelope then
			removeEnvelope(mail.Envelope, false)
		end
		if S.Selected == mail then
			S.Selected = nil
		end
	end

	-- Trop de mails : on oublie les plus vieux (lus, sans étoile, plus réclamables)
	local function trimModel()
		local received, sent = 0, 0
		for _, mail in ipairs(mails) do
			if mail.Kind == "Sent" then
				sent += 1
			else
				received += 1
			end
		end
		for index = #mails, 1, -1 do
			if received <= MAX_RECEIVED and sent <= MAX_SENT then
				break
			end
			local mail = mails[index]
			local isSent = mail.Kind == "Sent"
			local over = (isSent and sent > MAX_SENT) or (not isSent and received > MAX_RECEIVED)
			-- (mails d'amis reçus : gardés par le serveur, jamais oubliés ici)
			if over and mail.Kind ~= "Friend" and not mail.Starred and mail.Read and mail.State ~= "Live" and mail ~= S.Selected then
				removeMail(mail)
				if isSent then
					sent -= 1
				else
					received -= 1
				end
			end
		end
		-- Toujours trop (jamais lus : joueur absent) : les plus vieux non lus partent aussi
		for index = #mails, 1, -1 do
			if received <= MAX_RECEIVED then
				break
			end
			local mail = mails[index]
			if mail.Kind ~= "Sent" and mail.Kind ~= "Friend" and not mail.Starred and mail.State ~= "Live" and mail ~= S.Selected then
				removeMail(mail)
				received -= 1
			end
		end
	end

	local function addMail(mail)
		keySeq += 1
		mail.Key = keySeq
		-- Du plus récent au plus ancien (un mail d'ami peut dater d'hier)
		local position = #mails + 1
		for index, other in ipairs(mails) do
			if other.Time <= mail.Time then
				position = index
				break
			end
		end
		table.insert(mails, position, mail)
		if mail.SpawnId then
			bySpawn[mail.SpawnId] = mail
		end
		trimModel()
	end

	-- Correspondant à qui répondre (un personnage connu, sinon l'expéditeur lui-même)
	local function contactOf(mail)
		if mail.Contact then
			return mail.Contact
		end
		local e = mail.Email
		local castId = CAST_MATCH[e.Avatar .. e.Tag.Id]
		if castId and contactsById[castId] then
			return contactsById[castId]
		end
		return {
			Avatar = e.Avatar,
			Tag = e.Tag.Id,
			Name = e.Sender,
			Short = e.Sender,
			Signature = e.Signature,
			Address = e.Address,
		}
	end

	------------------------------------------------------------------
	-- Compteur "📬 non lus" (dans le bandeau d'actu, à gauche de son bloc
	-- droit) : toujours visible, ouvre / ferme Dopamail
	------------------------------------------------------------------
	local counter = UIUtil.Create("TextButton", {
		Name = "Unread",
		Size = UDim2.fromOffset(0, 22),
		AutomaticSize = Enum.AutomaticSize.X,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -(TICKER_RIGHT_FALLBACK + 6), 0, 4),
		BackgroundColor3 = C.White,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 40,
		Parent = container,
	})
	UIUtil.Corner(counter, UDim.new(1, 0))
	UIUtil.Stroke(counter, C.Border, 1.5, 0.15)
	UIUtil.Gradient(counter, ColorSequence.new(C.White, Color3.fromRGB(226, 232, 244)), 90)
	UIUtil.Create("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 9), Parent = counter })
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 5),
		Parent = counter,
	})
	local counterBadge = text({
		Size = UDim2.fromOffset(0, 16),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = C.Blue,
		BackgroundTransparency = 0,
		Font = FONT_NUMBER,
		Text = "0",
		TextColor3 = C.White,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 1,
		Visible = false,
		ZIndex = 41,
		Parent = counter,
	})
	UIUtil.Corner(counterBadge, UDim.new(1, 0))
	UIUtil.Create("UIPadding", { PaddingLeft = UDim.new(0, 5), PaddingRight = UDim.new(0, 5), Parent = counterBadge })
	local counterLabel = text({
		Size = UDim2.fromOffset(0, 18),
		AutomaticSize = Enum.AutomaticSize.X,
		Font = FONT_TITLE,
		Text = "📬 Dopamail",
		TextSize = 13,
		LayoutOrder = 2,
		ZIndex = 41,
		Parent = counter,
	})
	local counterScale = UIUtil.Create("UIScale", { Parent = counter })
	UIUtil.AnimateButton(counter, 1.06, 0.94)

	-- Place du compteur : juste à gauche du bloc horloge / segment du bandeau
	local tickerRight = TICKER_RIGHT_FALLBACK
	local function placeCounter()
		local slots = ctx.Interface and ctx.Interface.Layers and ctx.Interface.Layers.Slots
		local ticker = slots and slots:FindFirstChild("NewsTicker")
		local inset = ticker and ticker:GetAttribute("RightInset")
		tickerRight = type(inset) == "number" and inset or TICKER_RIGHT_FALLBACK
		counter.Position = UDim2.new(1, -(tickerRight + 6), 0, 4)
	end
	placeCounter()
	task.delay(1, function()
		if ctx.IsAlive() then
			placeCounter()
		end
	end)

	local function refreshCounter(bump: boolean?)
		local unread = unreadCount()
		counterBadge.Visible = unread > 0
		counterBadge.Text = unread > 999 and "999+" or tostring(unread)
		counterBadge.BackgroundColor3 = unread >= 10 and C.Red or C.Blue
		if unread > 0 then
			local suffix = unread >= 25 and " 😱" or (unread >= 10 and " 😬" or "")
			local words = Locale.Pick(UNREAD)
			counterLabel.Text = "📬 " .. (unread > 1 and words.Many or words.One) .. suffix
		else
			counterLabel.Text = "📬 Dopamail"
		end
		if bump then
			counterScale.Scale = 1.25
			UIUtil.Tween(counterScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		end
	end
	refreshCounter(false)

	------------------------------------------------------------------
	-- Fenêtre Dopamail
	------------------------------------------------------------------
	local function currentMode(): string
		local interface = ctx.Interface
		if interface and interface.Device == "Phone" then
			return "Phone"
		end
		return "Wide"
	end

	local function paintRow(entry)
		local mail = entry.Mail
		if not mail then
			return
		end
		local selected = S.Selected == mail
		local color = selected and C.Selected or (mail.Read and C.White or C.Unread)
		if entry.Hover and not selected then
			color = color:Lerp(Color3.fromRGB(210, 222, 245), 0.25)
		end
		entry.Row.BackgroundColor3 = color
		entry.Accent.Visible = selected
	end

	local function toggleStar(mail)
		mail.Starred = not mail.Starred
		ctx.Sound.Play("Click", 1.2)
		refresh()
	end

	-- Ligne de liste (réutilisée : une réserve de lignes par fenêtre)
	local function newRow(ui, index: number)
		local L = ui.L
		local F = L.F
		local rowW = ui.ListW - 18
		local rowH = L.Row - 4
		local row = UIUtil.Create("TextButton", {
			Name = "MailRow" .. index,
			Size = UDim2.fromOffset(rowW, rowH),
			Position = UDim2.fromOffset(6, 4),
			BackgroundColor3 = C.White,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
			ZIndex = 6,
			Parent = ui.List,
		})
		UIUtil.Corner(row, 10)
		local entry: any = { Row = row, Mail = nil, Hover = false, RowW = rowW }
		entry.Accent = frame({ Position = UDim2.fromOffset(0, 10), Size = UDim2.fromOffset(4, rowH - 20), BackgroundColor3 = C.Blue, Visible = false, ZIndex = 7, Parent = row })
		UIUtil.Corner(entry.Accent, 2)
		entry.Dot = frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(11, math.floor(rowH / 2)), Size = UDim2.fromOffset(8, 8), BackgroundColor3 = C.Blue, ZIndex = 7, Parent = row })
		UIUtil.Corner(entry.Dot, UDim.new(1, 0))
		local avatarSize = 40
		entry.Avatar = makeAvatar(row, avatarSize, UDim2.fromOffset(20, math.floor((rowH - avatarSize) / 2)), 7)
		local textX = 20 + avatarSize + 10
		entry.TextX = textX
		entry.Sender = text({ Position = UDim2.fromOffset(textX, 6), Size = UDim2.fromOffset(rowW - textX - 80, 18), TextSize = 14 + F, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 7, Parent = row })
		entry.Time = text({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromOffset(rowW - 10, 7), Size = UDim2.fromOffset(74, 16), TextColor3 = C.InkDim, TextSize = 11 + F, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 7, Parent = row })
		entry.Subject = text({ Position = UDim2.fromOffset(textX, 25), Size = UDim2.fromOffset(rowW - textX - 40, 17), TextColor3 = C.InkSoft, TextSize = 13 + F, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 7, Parent = row })
		entry.Chip = makeChip(row, 17, 7)
		entry.Chip.Frame.Position = UDim2.fromOffset(textX, 44)
		entry.Preview = text({ Position = UDim2.fromOffset(textX, 44), Size = UDim2.fromOffset(100, 17), TextColor3 = C.InkDim, TextSize = 12 + F, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 7, Parent = row })
		local star, starLabel = makeButton({ Name = "RowStar", AnchorPoint = Vector2.new(1, 1), Position = UDim2.fromOffset(rowW - 5, rowH - 3), Size = UDim2.fromOffset(32, 32), ZIndex = 8, Parent = row }, "ghost", "☆", 19 + F, 8)
		starLabel.TextColor3 = C.Gold
		entry.StarLabel = starLabel
		onClick(row, function()
			if entry.Mail then
				ctx.Sound.Play("Click", 1.1)
				openMail(entry.Mail, "List")
			end
		end)
		onClick(star, function()
			if entry.Mail then
				toggleStar(entry.Mail)
			end
		end)
		on(row.MouseEnter, function()
			entry.Hover = true
			paintRow(entry)
		end)
		on(row.MouseLeave, function()
			entry.Hover = false
			paintRow(entry)
		end)
		ui.Rows[index] = entry
		return entry
	end

	local function fillRow(ui, entry, mail, index: number)
		local e = mail.Email
		local F = ui.L.F
		local rowW = entry.RowW
		entry.Mail = mail
		entry.Row.Visible = true
		entry.Row.Position = UDim2.fromOffset(6, 4 + (index - 1) * ui.L.Row)
		paintRow(entry)
		entry.Dot.Visible = not mail.Read
		entry.Avatar.Set(e.Avatar, e.Tag.Color, e.Image)
		if mail.Kind == "Sent" then
			entry.Sender.Text = Locale.T("To: %s", mail.To.Name)
		else
			entry.Sender.Text = e.Sender
		end
		entry.Sender.Font = mail.Read and FONT_BODY or FONT_TITLE
		entry.Subject.Font = mail.Read and FONT_BODY or FONT_TITLE
		entry.Time.Text = timeLabel(mail.Time)
		local subject = e.Subject ~= "" and e.Subject or Locale.T("(no subject)")
		entry.Subject.Text = (e.Attachment and "📎 " or "") .. subject
		entry.StarLabel.Text = mail.Starred and "⭐" or "☆"
		-- Ligne 3 : pastille ("🎁 NOUVEAU · +X" tant qu'il est réclamable, sinon étiquette) + aperçu
		local x = entry.TextX
		if isLive(mail) then
			local width = entry.Chip.Set(Locale.T("🎁 NEW · +%s", ctx.Format.Format(mail.Estimate or 0)), C.Green)
			entry.Chip.Frame.Visible = true
			x += width + 6
		elseif mail.Kind ~= "Sent" or mail.Friend then
			local width = entry.Chip.Set(e.Tag.Text, e.Tag.Color)
			entry.Chip.Frame.Visible = true
			x += width + 6
		else
			entry.Chip.Frame.Visible = false
		end
		local previewW = rowW - x - 40
		entry.Preview.Visible = previewW > 24
		entry.Preview.Position = UDim2.fromOffset(x, 44)
		entry.Preview.Size = UDim2.fromOffset(math.max(0, previewW), 17)
		local preview = e.Body ~= "" and e.Body or subject
		entry.Preview.Text = string.gsub(preview, "%s+", " ")
		entry.Preview.TextSize = 12 + F
	end

	local function visibleMails(): { any }
		local list = {}
		local query = string.lower(trim(S.Search))
		for _, mail in ipairs(mails) do
			if inFolder(mail, S.Folder) and matches(mail, query) then
				table.insert(list, mail)
			end
		end
		return list
	end

	local EMPTY_ICONS = { Inbox = "🎉", Friends = "💌", Starred = "⭐", Sent = "📤", Spam = "🚫", Trash = "🗑️" }
	local function emptyText(folder: string): string
		if folder == "Friends" then
			return Locale.T("No friend mail yet. Tap ✏️ Write to send one to a Roblox friend!")
		elseif folder == "Starred" then
			return Locale.T("No starred mail. Tap ☆ on a mail to keep it here.")
		elseif folder == "Sent" then
			return Locale.T("Nothing sent yet. Grandma is waiting for your news!")
		elseif folder == "Spam" then
			return Locale.T("No spam here. Suspiciously clean.")
		elseif folder == "Trash" then
			return Locale.T("The trash is empty. Very tidy.")
		end
		return Locale.T("🎉 Inbox zero! Enjoy it, it won't last.")
	end

	local function renderList()
		local ui = UI
		if not ui then
			return
		end
		local list = visibleMails()
		local folder = S.Folder
		local searching = trim(S.Search) ~= ""
		local icon = "📥"
		for _, def in ipairs(FOLDERS) do
			if def.Id == folder then
				icon = def.Icon
			end
		end
		ui.ListTitle.Text = icon .. " " .. folderName(folder, true)
		local sub
		if searching then
			sub = "🔍 " .. countText(#list, RESULTS)
		elseif folder == "Inbox" then
			local unread = unreadCount()
			sub = (unread > 0 and (tostring(unread) .. " " .. (unread > 1 and Locale.Pick(UNREAD).Many or Locale.Pick(UNREAD).One) .. " · ") or "") .. countText(#list, MAIL_COUNT)
		else
			sub = countText(#list, MAIL_COUNT)
		end
		ui.ListSub.Text = sub
		-- Action d'en-tête : "Tout lu" (Réception) / "Vider" (Corbeille)
		local action = nil
		if folder == "Inbox" and unreadCount() > 0 and not searching then
			action = Locale.T("✓ All read")
		elseif folder == "Trash" and #list > 0 and not searching then
			action = Locale.T("🧹 Empty")
		elseif folder == "Friends" and not searching then
			action = Locale.T("✏️ Write")
		end
		ui.ListAction.Visible = action ~= nil
		ui.ListActionLabel.Text = action or ""
		-- Lignes (réserve réutilisée)
		for index, mail in ipairs(list) do
			local entry = ui.Rows[index] or newRow(ui, index)
			fillRow(ui, entry, mail, index)
		end
		for index = #list + 1, #ui.Rows do
			local entry = ui.Rows[index]
			entry.Row.Visible = false
			entry.Mail = nil
		end
		ui.List.CanvasSize = UDim2.fromOffset(0, #list * ui.L.Row + 10)
		local empty = #list == 0
		ui.Empty.Visible = empty
		ui.EmptyIcon.Visible = empty
		if empty then
			ui.EmptyIcon.Text = searching and "🔍" or (EMPTY_ICONS[folder] or "📭")
			ui.Empty.Text = searching and Locale.T("No mail matches your search.") or emptyText(folder)
		end
	end

	local function renderFolders()
		local ui = UI
		if not ui then
			return
		end
		for _, def in ipairs(FOLDERS) do
			local item = ui.Folders[def.Id]
			if item then
				local active = S.Folder == def.Id
				item.Button.BackgroundTransparency = active and 0 or 1
				item.Button.BackgroundColor3 = C.Selected
				item.Accent.Visible = active
				if item.Label then
					item.Label.Font = active and FONT_TITLE or FONT_BODY
					item.Label.TextColor3 = active and C.BlueDark or C.Ink
				end
				local count = folderCount(def.Id)
				item.Badge.Visible = count > 0
				item.Badge.Text = count > 99 and "99+" or tostring(count)
				if def.Id == "Inbox" then
					-- Comme le compteur du bandeau : rouge à partir de 10 non lus
					item.Badge.BackgroundColor3 = (count >= 10 or ui.Mode == "Phone") and C.Red or C.Blue
				elseif def.Id == "Friends" then
					item.Badge.BackgroundColor3 = TAGS.FRIEND.Color
				end
			end
		end
		ui.LogoDot.Visible = unreadCount() > 0
	end

	-- Bandeau (récompense / avertissement) de la zone de lecture
	local function setBanner(banner, value: string?, background: Color3?, border: Color3?, color: Color3?)
		banner.Frame.Visible = value ~= nil
		if value then
			banner.Label.Text = value
			banner.Frame.BackgroundColor3 = background or C.Field
			banner.Stroke.Color = border or C.Line
			banner.Label.TextColor3 = color or C.Ink
		end
	end

	local ACTION_ORDER = { "Reply", "Forward", "Spam", "NotSpam", "Delete", "Restore", "Forever", "Report", "Block" }

	-- État variable d'un mail affiché : étoile, récompense, boutons d'action
	local function updateMessageState(mail)
		local ui = UI
		if not ui then
			return
		end
		local msg = ui.Msg
		msg.StarLabel.Text = mail.Starred and "⭐" or "☆"
		-- (Signaler / Bloquer : la demande de confirmation repart de zéro)
		S.Confirm = nil
		for id, label in pairs(msg.ActionLabels) do
			label.Text = msg.ActionTexts[id]
			if id == "Report" or id == "Block" then
				msg.Actions[id].BackgroundColor3 = C.White
			end
		end
		if mail.Kind == "Friend" then
			if mail.Replied then
				setBanner(msg.Reward, Locale.T("↩️ You answered this mail."), C.Field, C.Line, C.InkDim)
			else
				setBanner(msg.Reward, nil)
			end
		elseif mail.Kind == "Spawn" then
			if mail.State == "Claimed" and mail.Reward then
				setBanner(msg.Reward, Locale.T("🎁 +%s Dopamine collected!", ctx.Format.Format(mail.Reward)), Color3.fromRGB(226, 248, 234), Color3.fromRGB(120, 210, 150), Color3.fromRGB(16, 120, 60))
			elseif mail.State == "Claimed" then
				setBanner(msg.Reward, Locale.T("🎁 Bonus on its way…"), Color3.fromRGB(236, 250, 241), Color3.fromRGB(160, 222, 180), Color3.fromRGB(30, 130, 70))
			elseif mail.State == "Expired" or mail.State == "Missed" then
				setBanner(msg.Reward, Locale.T("⌛ Opened too late: no bonus this time."), C.Field, C.Line, C.InkDim)
			else
				setBanner(msg.Reward, nil)
			end
		else
			setBanner(msg.Reward, nil)
		end
		-- Boutons selon le dossier
		local visible
		if mail.Kind == "Friend" then
			-- Mail d'un ami : pas de spam ni de transfert ; signaler / bloquer
			visible = { Reply = true, Delete = true, Report = true, Block = true }
		elseif mail.Folder == "Trash" then
			visible = { Restore = true, Forever = true }
		elseif mail.Folder == "Spam" then
			visible = { NotSpam = true, Delete = true }
		elseif mail.Kind == "Sent" then
			visible = { Forward = true, Delete = true }
		else
			visible = { Reply = true, Forward = true, Spam = true, Delete = true }
		end
		local shown = {}
		for _, id in ipairs(ACTION_ORDER) do
			local button = msg.Actions[id]
			button.Visible = visible[id] == true
			if visible[id] then
				table.insert(shown, button)
			end
		end
		local P = ui.L.Pad
		local gap = 8
		local width = math.floor((ui.ReadW - P * 2 - gap * (#shown - 1)) / math.max(1, #shown))
		for index, button in ipairs(shown) do
			button.Position = UDim2.fromOffset(P + (index - 1) * (width + gap), 10)
			button.Size = UDim2.fromOffset(width, 38)
		end
	end

	renderMessage = function(mail)
		local ui = UI
		if not ui then
			return
		end
		local msg = ui.Msg
		local e = mail.Email
		msg.Subject.Text = e.Subject ~= "" and e.Subject or Locale.T("(no subject)")
		if mail.Kind == "Sent" then
			msg.Avatar.Set(me.Avatar, C.Blue, mail.Friend and me.Image or nil)
			msg.Sender.Text = me.Name
			msg.Meta.Text = Locale.T("to %s <%s> · %s", mail.To.Name, mail.To.Address, timeLabel(mail.Time))
			msg.Chip.Frame.Visible = false
			msg.Sender.Size = UDim2.fromOffset(ui.ReadW - ui.L.Pad * 2 - 52, 20)
		else
			msg.Avatar.Set(e.Avatar, e.Tag.Color, e.Image)
			msg.Sender.Text = e.Sender
			msg.Meta.Text = Locale.T("<%s> · to me · %s", e.Address, timeLabel(mail.Time))
			local chipW = msg.Chip.Set(e.Tag.Text, e.Tag.Color)
			msg.Chip.Frame.Visible = true
			msg.Sender.Size = UDim2.fromOffset(math.max(40, ui.ReadW - ui.L.Pad * 2 - 52 - chipW - 8), 20)
		end
		-- Avertissement (spams et arnaques) / mot d'un ami Roblox
		if mail.Kind == "Friend" then
			setBanner(
				msg.Warning,
				Locale.T("💌 From your Roblox friend, filtered by Roblox. Friend mails give no Dopamine: just friendship!"),
				Color3.fromRGB(255, 236, 250),
				Color3.fromRGB(240, 160, 222),
				Color3.fromRGB(150, 24, 118)
			)
		elseif mail.Kind == "Sent" and mail.Friend then
			setBanner(
				msg.Warning,
				Locale.T("💌 Sent to your Roblox friend. Roblox filters it for them too."),
				Color3.fromRGB(255, 236, 250),
				Color3.fromRGB(240, 160, 222),
				Color3.fromRGB(150, 24, 118)
			)
		elseif e.Suspicious then
			local scam = e.Tag.Id == "ARNAQUE"
			setBanner(
				msg.Warning,
				scam and Locale.T("⚠️ Careful: this looks like a scam. Never share your password!") or Locale.T("🚫 This looks like spam. We're not judging."),
				scam and Color3.fromRGB(255, 240, 210) or Color3.fromRGB(238, 240, 246),
				scam and Color3.fromRGB(240, 160, 60) or Color3.fromRGB(196, 202, 216),
				scam and Color3.fromRGB(150, 70, 0) or C.InkDim
			)
		else
			setBanner(msg.Warning, nil)
		end
		msg.Body.Text = e.Body ~= "" and e.Body or "…"
		msg.Signature.Visible = e.Signature ~= nil and e.Signature ~= ""
		msg.Signature.Text = "— " .. tostring(e.Signature or "")
		if mail.Quote then
			msg.Quote.Visible = true
			msg.QuoteLabel.Text = mail.Quote.Label .. "\n" .. mail.Quote.Text
		else
			msg.Quote.Visible = false
		end
		local attachment = e.Attachment
		msg.Attachment.Visible = attachment ~= nil
		if attachment then
			msg.FileIcon.BackgroundColor3 = attachment.Type.Color
			msg.FileEmoji.Text = attachment.Type.Icon
			msg.FileName.Text = attachment.Name
			msg.FileSize.Text = attachment.Size
			msg.FileAction.Text = "⬇️"
		end
		msg.Scroll.CanvasPosition = Vector2.zero
		updateMessageState(mail)
	end

	------------------------------------------------------------------
	-- Amis Roblox : remotes, état anti-spam, présence
	------------------------------------------------------------------
	local remoteCache: { [string]: Instance } = {}
	local remoteMissing: { [string]: boolean } = {}
	-- Remote du serveur (attend au plus 10 s la première fois ; à appeler
	-- dans un task.spawn : peut attendre)
	local function findRemote(name: string): Instance?
		local cached = remoteCache[name]
		if cached then
			return cached
		end
		local folder = ReplicatedStorage:FindFirstChild("Remotes")
		local remote = folder and folder:FindFirstChild(name)
		if not remote and not remoteMissing[name] then
			folder = folder or ReplicatedStorage:WaitForChild("Remotes", 10)
			remote = folder and folder:WaitForChild(name, 10)
			if not remote then
				remoteMissing[name] = true
			end
		end
		if remote then
			remoteCache[name] = remote
		end
		return remote
	end

	local function applyStatus(status: any)
		if type(status) == "table" and type(status.NewIn) == "number" then
			FS.Status = status
			FS.StatusClock = now()
		end
	end

	-- RemoteFunction "FriendMail" (peut attendre) -> (ok, résultat | message)
	local function invokeFriend(action: string, arg: any?): (boolean, any)
		local remote = findRemote("FriendMail")
		if not remote or not remote:IsA("RemoteFunction") then
			return false, Locale.T("Friend mail is unavailable right now")
		end
		local okCall, ok, result, status = pcall(function()
			return (remote :: RemoteFunction):InvokeServer(action, arg)
		end)
		if not okCall then
			return false, Locale.T("Friend mail is unavailable right now")
		end
		applyStatus(status)
		if type(result) == "table" then
			applyStatus(result.Status)
			if action == "Status" and ok == true then
				applyStatus(result)
			end
		end
		return ok == true, result
	end

	-- Secondes avant le prochain mail d'ami (nouveau / réponse)
	local function friendWait(isReply: boolean): number
		local status = FS.Status
		if type(status) ~= "table" then
			return 0
		end
		local base = tonumber(isReply and status.ReplyIn or status.NewIn) or 0
		return math.max(0, math.ceil(base - (now() - FS.StatusClock)))
	end

	-- Présence d'un ami : sur ce serveur / en ligne ailleurs / hors ligne (/ bloqué)
	local PRESENCE = {
		Here = { Text = "● Here", Color = Color3.fromRGB(24, 158, 88), Rank = 1 },
		Online = { Text = "● Online", Color = Color3.fromRGB(40, 120, 240), Rank = 2 },
		Offline = { Text = "Offline", Color = Color3.fromRGB(140, 146, 160), Rank = 3 },
		Blocked = { Text = "🚫 Blocked", Color = Color3.fromRGB(226, 38, 52), Rank = 4 },
	}
	local function presenceOf(userId: number): string
		if FS.Blocked[tostring(userId)] then
			return "Blocked"
		end
		if Players:GetPlayerByUserId(userId) then
			return "Here"
		end
		if FS.Online[userId] then
			return "Online"
		end
		return "Offline"
	end

	local function isFriendDraft(draft: any): boolean
		return draft ~= nil and (draft.Group == "Friends" or (draft.Contact ~= nil and draft.Contact.Friend == true))
	end

	-- Ligne d'état d'un brouillon pour un ami (où en est la livraison)
	local function friendDefaultStatus(draft: any): (string, Color3)
		local contact = draft.Contact
		if contact and contact.Friend then
			local presence = presenceOf(contact.UserId)
			if presence == "Here" then
				return Locale.T("💌 %s is here: delivered instantly", contact.Short), PRESENCE.Here.Color
			elseif presence == "Online" then
				return Locale.T("💌 %s is online: delivered in a few seconds", contact.Short), PRESENCE.Online.Color
			end
			return Locale.T("💌 %s is offline: it will wait in their Dopamail", contact.Short), C.InkDim
		end
		return Locale.T("👥 Pick a friend to write to"), C.InkDim
	end

	------------------------------------------------------------------
	-- Rédaction
	------------------------------------------------------------------
	local function setStatus(message: string?, color: Color3?)
		local ui = UI
		if not ui then
			return
		end
		if message == nil and isFriendDraft(S.Draft) then
			message, color = friendDefaultStatus(S.Draft)
		end
		if color == C.Red then
			-- Une erreur reste lisible (le compte à rebours ne l'efface pas tout de suite)
			S.StatusHold = now() + 5
		end
		ui.Cmp.Status.Text = message or Locale.T("🛡️ Checked by the Roblox filter before sending")
		ui.Cmp.Status.TextColor3 = color or C.InkDim
	end

	local function setSending(active: boolean)
		local ui = UI
		if not ui then
			return
		end
		local cmp = ui.Cmp
		cmp.SendLabel.Text = active and Locale.T("⏳ Sending…") or ("✈️ " .. Locale.T("Send"))
		cmp.Send.BackgroundColor3 = active and C.Grey or C.Blue
		cmp.Subject.TextEditable = not active
		cmp.Body.TextEditable = not active
		if active then
			setStatus(Locale.T("🛡️ Checking your message…"), C.Blue)
		end
	end

	local function updateCounterLabel()
		local ui = UI
		if not ui then
			return
		end
		local length = utf8.len(ui.Cmp.Body.Text) or #ui.Cmp.Body.Text
		ui.Cmp.Counter.Text = string.format("%d/%d", math.floor(length), BODY_MAX)
		ui.Cmp.Counter.TextColor3 = length >= BODY_MAX and C.Red or C.InkDim
	end

	local function renderChips()
		local ui = UI
		if not ui then
			return
		end
		local draft = S.Draft
		for groupId, tab in pairs(ui.Cmp.TabButtons) do
			local active = draft ~= nil and draft.Group == groupId
			tab.Button.BackgroundTransparency = active and 0 or 1
			tab.Label.TextColor3 = active and C.BlueDark or C.InkDim
		end
		for id, chip in pairs(ui.Cmp.Chips) do
			local selected = draft ~= nil and draft.Contact ~= nil and draft.Contact.Id == id
			chip.Button.BackgroundColor3 = selected and C.Selected or C.White
			chip.Stroke.Color = selected and C.Blue or C.Line
			chip.Stroke.Thickness = selected and 2 or 1.3
			chip.Name.TextColor3 = selected and C.BlueDark or C.Ink
		end
	end

	-- Place les champs selon le brouillon (destinataire fixe, citation) :
	-- le texte prend toute la place restante
	local function layoutCompose()
		local ui = UI
		local draft = S.Draft
		if not ui or not draft then
			return
		end
		local cmp = ui.Cmp
		local P = ui.L.Pad
		local phone = ui.Mode == "Phone"
		local height = ui.L.H - ui.L.Title
		local fixed = draft.Fixed == true
		local friends = draft.Group == "Friends"
		cmp.Fixed.Visible = fixed
		cmp.Tabs.Visible = not fixed and draft.Kind ~= "Forward"
		for _, chip in pairs(cmp.Chips) do
			chip.Button.Visible = not fixed and not friends
		end
		cmp.FriendArea.Visible = not fixed and friends
		local y = (fixed and (cmp.GridTop + 40) or cmp.GridBottom) + 10
		cmp.SubjectField.Position = UDim2.fromOffset(P, y)
		y += 36 + 8
		local statusY = height - 12 - 42 - 6 - 18
		local quoteH = draft.Quote and (phone and 42 or 50) or 0
		local bodyH = math.max(48, statusY - 6 - y - (quoteH > 0 and quoteH + 8 or 0))
		cmp.BodyField.Position = UDim2.fromOffset(P, y)
		cmp.BodyField.Size = UDim2.new(1, -P * 2, 0, bodyH)
		y += bodyH + 8
		cmp.Quote.Visible = quoteH > 0
		if quoteH > 0 then
			cmp.Quote.Position = UDim2.fromOffset(P, y)
			cmp.Quote.Size = UDim2.new(1, -P * 2, 0, quoteH)
		end
		cmp.Status.Position = UDim2.fromOffset(P, statusY)
	end

	local function renderCompose()
		local ui = UI
		local draft = S.Draft
		if not ui or not draft then
			return
		end
		local cmp = ui.Cmp
		local titles = {
			New = Locale.T("✏️ New message"),
			Reply = Locale.T("↩️ Reply"),
			Forward = Locale.T("➡️ Forward"),
		}
		local title = titles[draft.Kind] or titles.New
		if draft.Kind == "New" and draft.Group == "Friends" then
			title = Locale.T("💌 Mail a friend")
		end
		cmp.Title.Text = title
		if ui.Mode == "Phone" then
			ui.Title.Text = title
		end
		local contact = draft.Contact
		if draft.Fixed and contact then
			cmp.FixedAvatar.Set(contact.Avatar, tagColor(contact.Tag), contact.Image)
			cmp.FixedName.Text = contact.Name .. "  <" .. contact.Address .. ">"
		end
		if draft.Quote then
			cmp.QuoteLabel.Text = draft.Quote.Label .. "\n" .. (draft.Quote.Short or draft.Quote.Text)
		end
		renderChips()
		layoutCompose()
		updateCounterLabel()
		if S.Sending then
			setSending(true)
		else
			setSending(false)
			setStatus(nil)
			if isFriendDraft(draft) then
				if draft.Group == "Friends" and not draft.Fixed then
					renderFriendArea()
				end
				updateFriendSend()
			end
		end
	end

	------------------------------------------------------------------
	-- Petit message en bas de la fenêtre ("snack"), cliquable si action
	------------------------------------------------------------------
	local function hideSnack()
		local ui = UI
		S.SnackToken += 1
		S.SnackAction = nil
		S.SnackTarget = nil
		if ui then
			ui.Snack.Visible = false
		end
	end

	snack = function(message: string, action: (() -> ())?, target: any?)
		local ui = UI
		if not ui or not S.Open then
			ctx.Notify(message)
			return
		end
		S.SnackToken += 1
		local token = S.SnackToken
		S.SnackAction = action
		S.SnackTarget = target
		ui.Snack.Text = message
		ui.Snack.Visible = true
		ui.SnackScale.Scale = 0.6
		UIUtil.Tween(ui.SnackScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
		task.delay(action and 5 or 2.8, function()
			if ctx.IsAlive() and S.SnackToken == token then
				hideSnack()
			end
		end)
	end

	------------------------------------------------------------------
	-- Construction de la fenêtre (une fois par mode d'affichage)
	------------------------------------------------------------------
	local selectFolder: (id: string) -> ()
	local sendDraft: () -> ()
	local cancelCompose: () -> ()
	local runAction: (id: string) -> ()
	local composeClicked: () -> ()
	local goBack: () -> ()
	local setGroup: (group: string) -> ()
	local pickFriend: (friend: any) -> ()
	local layoutFriendGrid: () -> ()
	local ensureFriends: (force: boolean?) -> ()

	local function limitBox(box: TextBox, maxChars: number)
		local value = box.Text
		local length = utf8.len(value)
		if length and length > maxChars then
			local cut = utf8.offset(value, maxChars + 1)
			if cut then
				box.Text = string.sub(value, 1, cut - 1)
			end
		end
	end

	local function buildWindow(mode: string)
		local L = LAYOUTS[mode]
		local phone = mode == "Phone"
		local F = L.F
		local P = L.Pad
		local W, H, T = L.W, L.H, L.Title
		local bodyH = H - T
		local ui: any = { Mode = mode, L = L, Rows = {}, Folders = {}, Fit = 1 }

		-- Fond assombri plein écran : un clic dehors ferme la fenêtre
		local dimmer = UIUtil.Create("TextButton", {
			Name = "MailDimmer",
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.fromRGB(10, 12, 28),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
			Visible = false,
			ZIndex = 20,
			Parent = container,
		})
		on(dimmer.Activated, function()
			closeWindow()
		end)
		ui.Dimmer = dimmer

		local root = frame({
			Name = "MailWindow",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(W, H),
			Visible = false,
			ZIndex = 60,
			Parent = container,
		})
		ui.Root = root
		ui.Scale = UIUtil.Create("UIScale", { Parent = root })
		-- Ombre douce
		for index, spec in ipairs({ { 18, 0.9 }, { 10, 0.85 }, { 4, 0.8 } }) do
			local spread = spec[1]
			local shadow = frame({
				Name = "Shadow" .. index,
				Position = UDim2.fromOffset(-spread, -spread + 10),
				Size = UDim2.new(1, spread * 2, 1, spread * 2),
				BackgroundColor3 = Color3.new(0, 0, 0),
				BackgroundTransparency = spec[2],
				ZIndex = index,
				Parent = root,
			})
			UIUtil.Corner(shadow, 16 + spread)
		end
		local win = frame({ Name = "Window", Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.White, ZIndex = 5, Parent = root })
		UIUtil.Corner(win, 16)
		UIUtil.Stroke(win, C.Border, 2, 0.05)
		-- Un clic sur une zone vide de la fenêtre ne ferme rien
		local sink = UIUtil.SinkClicks(win)
		on(sink.MouseEnter, function()
			S.Interaction += 1
		end)
		ui.Window = win

		-- Barre de titre (dégradé "Dopamail", ✕ rouge bien à nous)
		local titleBar = frame({ Name = "TitleBar", Size = UDim2.new(1, 0, 0, T), BackgroundColor3 = C.White, ZIndex = 3, Parent = win })
		UIUtil.Corner(titleBar, 16)
		UIUtil.Gradient(titleBar, ColorSequence.new(C.BrandA, C.BrandB), 0)
		local titleFill = frame({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 18), BackgroundColor3 = C.White, ZIndex = 3, Parent = titleBar })
		UIUtil.Gradient(titleFill, ColorSequence.new(C.BrandA, C.BrandB), 0)

		local left = 12
		if phone then
			local back = makeButton({
				Name = "MailBack",
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 8, 0.5, 0),
				Size = UDim2.fromOffset(44, 36),
				BackgroundColor3 = C.White,
				BackgroundTransparency = 0.78,
				Visible = false,
				ZIndex = 5,
				Parent = titleBar,
			}, "ghost", "←", 24, 10)
			back:FindFirstChild("Label").TextColor3 = C.White
			onClick(back, function()
				ctx.Sound.Play("Click", 1)
				goBack()
			end)
			ui.Back = back
		end
		local logo = frame({ Name = "Logo", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, left, 0.5, 0), Size = UDim2.fromOffset(32, 32), BackgroundColor3 = C.White, ZIndex = 5, Parent = titleBar })
		UIUtil.Corner(logo, 9)
		UIUtil.Stroke(logo, Color3.fromRGB(34, 44, 120), 1.5, 0.35)
		text({ Size = UDim2.fromScale(1, 1), Position = UDim2.fromOffset(0, 1), Text = "✉️", TextSize = 18, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 6, Parent = logo })
		local logoDot = frame({ Name = "Dot", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -2, 0, 3), Size = UDim2.fromOffset(12, 12), BackgroundColor3 = C.Red, Visible = false, ZIndex = 7, Parent = logo })
		UIUtil.Corner(logoDot, UDim.new(1, 0))
		UIUtil.Stroke(logoDot, C.White, 2, 0)
		ui.Logo = logo
		ui.LogoDot = logoDot
		local titleW = phone and (W - 200) or 300
		ui.Title = text({ Name = "AppTitle", Position = UDim2.fromOffset(left + 42, math.floor(T / 2) - 20), Size = UDim2.fromOffset(titleW, 22), Font = FONT_TITLE, Text = "Dopamail", TextColor3 = C.White, TextSize = 19 + F, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 5, Parent = titleBar })
		ui.Subtitle = text({ Position = UDim2.fromOffset(left + 42, math.floor(T / 2) + 2), Size = UDim2.fromOffset(titleW, 16), Text = me.Address, TextColor3 = Color3.fromRGB(224, 230, 255), TextSize = 12 + F, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 5, Parent = titleBar })

		if not phone then
			-- Recherche (filtre la liste du dossier affiché, rien n'est envoyé)
			local search = frame({ Name = "Search", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -60, 0.5, 0), Size = UDim2.fromOffset(250, 32), BackgroundColor3 = C.White, BackgroundTransparency = 0.8, ZIndex = 5, Parent = titleBar })
			UIUtil.Corner(search, UDim.new(1, 0))
			UIUtil.Stroke(search, C.White, 1, 0.55)
			text({ Position = UDim2.fromOffset(10, 0), Size = UDim2.new(0, 22, 1, 0), Text = "🔍", TextSize = 14, ZIndex = 6, Parent = search })
			local box = UIUtil.Create("TextBox", {
				Name = "SearchBox",
				Position = UDim2.fromOffset(34, 0),
				Size = UDim2.new(1, -44, 1, 0),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ClearTextOnFocus = false,
				Font = FONT_BODY,
				PlaceholderText = Locale.T("Search"),
				PlaceholderColor3 = Color3.fromRGB(214, 222, 255),
				Text = S.Search,
				TextColor3 = C.White,
				TextSize = 14,
				TextXAlignment = Enum.TextXAlignment.Left,
				ZIndex = 6,
				Parent = search,
			})
			on(box:GetPropertyChangedSignal("Text"), function()
				limitBox(box, 40)
				if S.Search ~= box.Text then
					S.Search = box.Text
					S.Interaction += 1
					renderList()
				end
			end)
			on(box.Focused, function()
				S.Interaction += 1
			end)
			ui.SearchBox = box
		end

		-- ✕ commun à toutes les fenêtres du jeu (disque blanc nacré, croix
		-- rouge au survol) : bien visible sur le dégradé, rien à voir avec les
		-- icônes rondes et sombres de Roblox ; zone tactile agrandie autour
		UIUtil.CloseButton({
			Name = "MailClose",
			Size = phone and 40 or 36,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			ZIndex = 7,
			Parent = titleBar,
			Hitbox = phone and 64 or 54,
			OnClose = function()
				if ctx.IsAlive() then
					closeWindow()
				end
			end,
		})

		-- Barre latérale (PC) / colonne d'icônes (téléphone)
		local side = frame({ Name = "Sidebar", Position = UDim2.fromOffset(0, T), Size = UDim2.new(0, L.Side, 1, -T), BackgroundColor3 = C.Side, ZIndex = 3, Parent = win })
		UIUtil.Corner(side, 16)
		frame({ Size = UDim2.new(1, 0, 0, 18), BackgroundColor3 = C.Side, ZIndex = 3, Parent = side })
		frame({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, 18, 1, 0), BackgroundColor3 = C.Side, ZIndex = 3, Parent = side })
		frame({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, 1, 1, 0), BackgroundColor3 = C.Line, ZIndex = 4, Parent = side })

		local compose = UIUtil.Create("TextButton", {
			Name = "ComposeButton",
			Position = UDim2.fromOffset(phone and 10 or 14, phone and 10 or 14),
			Size = phone and UDim2.fromOffset(48, 48) or UDim2.new(1, -28, 0, 44),
			BackgroundColor3 = C.White,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
			ZIndex = 6,
			Parent = side,
		})
		UIUtil.Corner(compose, UDim.new(1, 0))
		UIUtil.Gradient(compose, ColorSequence.new(C.BrandA, C.BrandB), 0)
		UIUtil.Stroke(compose, Color3.fromRGB(38, 48, 150), 1.5, 0.2)
		text({
			Size = UDim2.fromScale(1, 1),
			Font = FONT_TITLE,
			Text = phone and "✏️" or ("✏️ " .. Locale.T("Compose")),
			TextColor3 = C.White,
			TextSize = phone and 22 or 17,
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = 7,
			Parent = compose,
		})
		UIUtil.AnimateButton(compose, 1.05, 0.94)
		onClick(compose, function()
			ctx.Sound.Play("Click", 1)
			composeClicked()
		end)

		-- Dossiers
		local names = Locale.Pick(FOLDER_NAMES).Short
		local folderY = phone and 70 or 72
		for _, def in ipairs(FOLDERS) do
			local id = def.Id
			local item: any = {}
			local button = UIUtil.Create("TextButton", {
				Name = "Folder_" .. id,
				Position = UDim2.fromOffset(phone and 8 or 8, folderY),
				Size = phone and UDim2.fromOffset(52, 42) or UDim2.new(1, -16, 0, 36),
				BackgroundColor3 = C.Selected,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Text = "",
				ZIndex = 6,
				Parent = side,
			})
			UIUtil.Corner(button, 10)
			item.Button = button
			item.Accent = frame({ AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(4, phone and 24 or 20), BackgroundColor3 = C.Blue, Visible = false, ZIndex = 7, Parent = button })
			UIUtil.Corner(item.Accent, 2)
			if phone then
				text({ Size = UDim2.fromScale(1, 1), Text = def.Icon, TextSize = 22, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 7, Parent = button })
				item.Badge = text({
					Name = "Count",
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.new(1, 2, 0, -2),
					Size = UDim2.fromOffset(22, 17),
					BackgroundColor3 = id == "Inbox" and C.Red or (id == "Friends" and TAGS.FRIEND.Color or C.Grey),
					BackgroundTransparency = 0,
					Font = FONT_NUMBER,
					TextColor3 = C.White,
					TextSize = 11,
					TextXAlignment = Enum.TextXAlignment.Center,
					Visible = false,
					ZIndex = 8,
					Parent = button,
				})
				UIUtil.Corner(item.Badge, UDim.new(1, 0))
				folderY += 46
			else
				text({ Position = UDim2.fromOffset(12, 0), Size = UDim2.new(0, 24, 1, 0), Text = def.Icon, TextSize = 16, ZIndex = 7, Parent = button })
				item.Label = text({ Position = UDim2.fromOffset(40, 0), Size = UDim2.new(1, -40 - 42, 1, 0), Text = names[id] or id, TextSize = 15, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 7, Parent = button })
				local strong = id == "Inbox" or id == "Friends"
				item.Badge = text({
					Name = "Count",
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -8, 0.5, 0),
					Size = UDim2.fromOffset(32, 20),
					BackgroundColor3 = strong and C.Blue or C.White,
					BackgroundTransparency = strong and 0 or 1,
					Font = FONT_NUMBER,
					TextColor3 = strong and C.White or C.InkDim,
					TextSize = 12,
					TextXAlignment = strong and Enum.TextXAlignment.Center or Enum.TextXAlignment.Right,
					Visible = false,
					ZIndex = 7,
					Parent = button,
				})
				UIUtil.Corner(item.Badge, UDim.new(1, 0))
				folderY += 40
			end
			onClick(button, function()
				ctx.Sound.Play("Click", 1.05)
				selectFolder(id)
			end)
			on(button.MouseEnter, function()
				if S.Folder ~= id then
					button.BackgroundTransparency = 0.4
				end
			end)
			on(button.MouseLeave, function()
				button.BackgroundTransparency = S.Folder == id and 0 or 1
			end)
			ui.Folders[id] = item
		end

		if not phone then
			-- Contacts rapides : un clic = nouveau message à ce correspondant
			local quickY = folderY + 12
			local caption = text({ Position = UDim2.fromOffset(16, quickY), Size = UDim2.new(1, -32, 0, 16), Font = FONT_TITLE, Text = Locale.T("✏️ Write to…"), TextColor3 = C.InkDim, TextSize = 12, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 6, Parent = side })
			quickY += 24
			local cell = 36
			local gap = math.floor((L.Side - 28 - cell * 4) / 3)
			for index, contact in ipairs(contacts) do
				local column = (index - 1) % 4
				local line = math.floor((index - 1) / 4)
				local quick = UIUtil.Create("TextButton", {
					Name = "Quick_" .. contact.Id,
					Position = UDim2.fromOffset(14 + column * (cell + gap), quickY + line * (cell + 8)),
					Size = UDim2.fromOffset(cell, cell),
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					AutoButtonColor = false,
					Text = "",
					ZIndex = 6,
					Parent = side,
				})
				local avatar = makeAvatar(quick, cell, UDim2.fromOffset(0, 0), 7)
				avatar.Set(contact.Avatar, tagColor(contact.Tag))
				UIUtil.AnimateButton(quick, 1.12, 0.9)
				-- Survol : la légende donne le nom du correspondant
				on(quick.MouseEnter, function()
					caption.Text = Locale.T("✏️ Write to %s", contact.Short)
					caption.TextColor3 = C.BlueDark
				end)
				on(quick.MouseLeave, function()
					caption.Text = Locale.T("✏️ Write to…")
					caption.TextColor3 = C.InkDim
				end)
				onClick(quick, function()
					ctx.Sound.Play("Click", 1.1)
					openCompose({ Kind = "New", Contact = contact })
				end)
			end
			-- Stockage (toujours presque plein)
			text({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 16, 1, -28), Size = UDim2.new(1, -32, 0, 16), Text = Locale.T("💾 Storage: 99% full"), TextColor3 = C.InkDim, TextSize = 12, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 6, Parent = side })
			local bar = frame({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 16, 1, -14), Size = UDim2.new(1, -32, 0, 7), BackgroundColor3 = C.Line, ZIndex = 6, Parent = side })
			UIUtil.Corner(bar, UDim.new(1, 0))
			local fill = frame({ Size = UDim2.fromScale(0.99, 1), BackgroundColor3 = Color3.fromRGB(240, 120, 40), ZIndex = 7, Parent = bar })
			UIUtil.Corner(fill, UDim.new(1, 0))
		end

		-- Liste
		local listX = L.Side
		local listW = phone and (W - L.Side) or L.List
		ui.ListW = listW
		local listPane = frame({ Name = "ListPane", Position = UDim2.fromOffset(listX, T), Size = UDim2.fromOffset(listW, bodyH), ZIndex = 3, Parent = win })
		ui.ListPane = listPane
		-- En-tête : titre sur toute la largeur, puis compteurs + action ("Tout lu" / "Vider")
		ui.ListTitle = text({ Position = UDim2.fromOffset(P, 6), Size = UDim2.fromOffset(listW - P * 2, 24), Font = FONT_TITLE, TextSize = 19 + F, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 5, Parent = listPane })
		ui.ListSub = text({ Position = UDim2.fromOffset(P, 33), Size = UDim2.fromOffset(listW - P - 128, 18), TextColor3 = C.InkDim, TextSize = 12 + F, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 5, Parent = listPane })
		local listAction, listActionLabel = makeButton({ Name = "ListAction", AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromOffset(listW - 10, 30), Size = UDim2.fromOffset(112, 25), Visible = false, ZIndex = 5, Parent = listPane }, "secondary", "", 12 + F, 8)
		ui.ListAction, ui.ListActionLabel = listAction, listActionLabel
		onClick(listAction, function()
			ctx.Sound.Play("Click", 1)
			if S.Folder == "Friends" then
				openCompose({ Kind = "New", Group = "Friends" })
				return
			end
			if S.Folder == "Inbox" then
				local friendIds = {}
				for _, mail in ipairs(mails) do
					if mail.Folder == "Inbox" then
						mail.Read = true
						if mail.Kind == "Friend" and not mail.ReadSent then
							mail.ReadSent = true
							table.insert(friendIds, mail.FriendId)
						end
					end
				end
				if #friendIds > 0 then
					task.spawn(function()
						for _, friendId in ipairs(friendIds) do
							invokeFriend("Read", friendId)
							task.wait(0.15)
						end
					end)
				end
				snack(Locale.T("✓ All caught up!"))
			elseif S.Folder == "Trash" then
				local removed = 0
				for index = #mails, 1, -1 do
					local mail = mails[index]
					if mail.Folder == "Trash" then
						removeMail(mail)
						removed += 1
					end
				end
				snack(Locale.T("🧹 Trash emptied (%d)", removed))
				if S.View == "Message" then
					setView("List")
				end
			end
			refresh()
		end)
		frame({ Position = UDim2.fromOffset(0, 58), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = C.Line, ZIndex = 5, Parent = listPane })
		ui.List = UIUtil.Create("ScrollingFrame", {
			Name = "MailList",
			Position = UDim2.fromOffset(0, 59),
			Size = UDim2.new(1, 0, 1, -59),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			CanvasSize = UDim2.new(),
			ScrollBarThickness = 5,
			ScrollBarImageColor3 = Color3.fromRGB(170, 176, 192),
			ScrollingDirection = Enum.ScrollingDirection.Y,
			ZIndex = 5,
			Parent = listPane,
		})
		ui.EmptyIcon = text({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 104), Size = UDim2.new(1, -40, 0, 48), Text = "🎉", TextSize = 40, TextXAlignment = Enum.TextXAlignment.Center, Visible = false, ZIndex = 6, Parent = listPane })
		ui.Empty = text({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 158), Size = UDim2.new(1, -48, 0, 60), Font = FONT_TITLE, TextColor3 = C.InkDim, TextSize = 14 + F, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Top, Visible = false, ZIndex = 6, Parent = listPane })

		-- Zone de lecture (à droite sur PC, à la place de la liste sur téléphone)
		local readX = phone and L.Side or (L.Side + L.List)
		local readW = W - readX
		ui.ReadW = readW
		local readPane = frame({ Name = "ReadPane", Position = UDim2.fromOffset(readX, T), Size = UDim2.fromOffset(readW, bodyH), ZIndex = 3, Parent = win })
		ui.ReadPane = readPane
		if not phone then
			frame({ Position = UDim2.fromOffset(readX, T), Size = UDim2.new(0, 1, 1, -T), BackgroundColor3 = C.Line, ZIndex = 4, Parent = win })
			local placeholder = frame({ Name = "Placeholder", Size = UDim2.fromScale(1, 1), ZIndex = 4, Parent = readPane })
			local art = frame({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 120), Size = UDim2.fromOffset(96, 96), BackgroundColor3 = Color3.fromRGB(236, 241, 255), ZIndex = 5, Parent = placeholder })
			UIUtil.Corner(art, UDim.new(1, 0))
			UIUtil.Stroke(art, Color3.fromRGB(200, 214, 250), 2, 0)
			text({ Size = UDim2.fromScale(1, 1), Position = UDim2.fromOffset(0, 2), Text = "📬", TextSize = 46, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 6, Parent = art })
			text({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 232), Size = UDim2.new(1, -60, 0, 24), Font = FONT_TITLE, Text = Locale.T("Pick a mail to read it"), TextSize = 18, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 5, Parent = placeholder })
			text({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 262), Size = UDim2.new(1, -70, 0, 60), Text = Locale.T("💡 Flying mails give Dopamine if you open them before they fly away!"), TextColor3 = C.InkDim, TextSize = 13, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 5, Parent = placeholder })
			ui.Placeholder = placeholder
		end

		-- Vue "message"
		local msg: any = { Actions = {}, ActionLabels = {}, ActionTexts = {} }
		local messageView = frame({ Name = "MessageView", Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 4, Parent = readPane })
		msg.Frame = messageView
		msg.Subject = text({ Name = "Subject", Position = UDim2.fromOffset(P, 8), Size = UDim2.fromOffset(readW - P - 58, 48), Font = FONT_TITLE, TextSize = 18 + F, TextWrapped = true, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 5, Parent = messageView })
		local star, starLabel = makeButton({ Name = "StarButton", AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromOffset(readW - 10, 12), Size = UDim2.fromOffset(40, 40), ZIndex = 5, Parent = messageView }, "ghost", "☆", 26, 10)
		starLabel.TextColor3 = C.Gold
		msg.StarLabel = starLabel
		onClick(star, function()
			local mail = S.Selected
			if mail then
				toggleStar(mail)
			end
		end)
		local senderY = 60
		msg.Avatar = makeAvatar(messageView, 42, UDim2.fromOffset(P, senderY), 5)
		msg.Sender = text({ Position = UDim2.fromOffset(P + 52, senderY + 1), Size = UDim2.fromOffset(readW - P * 2 - 52, 20), Font = FONT_TITLE, TextSize = 15 + F, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 5, Parent = messageView })
		msg.Meta = text({ Position = UDim2.fromOffset(P + 52, senderY + 23), Size = UDim2.fromOffset(readW - P * 2 - 52, 16), TextColor3 = C.InkDim, TextSize = 12 + F, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 5, Parent = messageView })
		msg.Chip = makeChip(messageView, 20, 5)
		msg.Chip.Frame.AnchorPoint = Vector2.new(1, 0)
		msg.Chip.Frame.Position = UDim2.fromOffset(readW - P, senderY + 1)
		local dividerY = senderY + 50
		frame({ Position = UDim2.fromOffset(P, dividerY), Size = UDim2.new(1, -P * 2, 0, 1), BackgroundColor3 = C.Line, ZIndex = 5, Parent = messageView })
		local barH = 58
		local scroll = UIUtil.Create("ScrollingFrame", {
			Name = "MessageScroll",
			Position = UDim2.fromOffset(0, dividerY + 1),
			Size = UDim2.new(1, 0, 1, -(dividerY + 1 + barH)),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollBarThickness = 5,
			ScrollBarImageColor3 = Color3.fromRGB(170, 176, 192),
			ScrollingDirection = Enum.ScrollingDirection.Y,
			ZIndex = 5,
			Parent = messageView,
		})
		msg.Scroll = scroll
		UIUtil.Create("UIPadding", { PaddingLeft = UDim.new(0, P), PaddingRight = UDim.new(0, P + 4), PaddingTop = UDim.new(0, 12), Parent = scroll })
		UIUtil.Create("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll })
		on(scroll:GetPropertyChangedSignal("CanvasPosition"), function()
			if scroll.CanvasPosition.Y > 2 then
				S.Interaction += 1
			end
		end)
		local function banner(name: string, order: number)
			local box = frame({ Name = name, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = C.Field, LayoutOrder = order, Visible = false, ZIndex = 6, Parent = scroll })
			UIUtil.Corner(box, 9)
			local stroke = UIUtil.Stroke(box, C.Line, 1.2, 0)
			UIUtil.Create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), PaddingTop = UDim.new(0, 7), PaddingBottom = UDim.new(0, 7), Parent = box })
			local label = text({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Font = FONT_TITLE, TextSize = 13 + F, TextWrapped = true, ZIndex = 7, Parent = box })
			return { Frame = box, Label = label, Stroke = stroke }
		end
		msg.Reward = banner("RewardBanner", 1)
		msg.Warning = banner("WarningBanner", 2)
		msg.Body = text({ Name = "Body", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextSize = 15 + F, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, LineHeight = 1.1, LayoutOrder = 3, ZIndex = 6, Parent = scroll })
		msg.Signature = text({ Name = "Signature", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextColor3 = C.InkDim, TextSize = 13 + F, TextWrapped = true, LayoutOrder = 4, ZIndex = 6, Parent = scroll })
		msg.Signature.FontFace = ITALIC
		local quote = frame({ Name = "Quote", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Color3.fromRGB(245, 247, 251), LayoutOrder = 5, Visible = false, ZIndex = 6, Parent = scroll })
		UIUtil.Corner(quote, 8)
		UIUtil.Stroke(quote, Color3.fromRGB(214, 220, 234), 1, 0)
		UIUtil.Create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), PaddingTop = UDim.new(0, 7), PaddingBottom = UDim.new(0, 7), Parent = quote })
		msg.QuoteLabel = text({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextColor3 = C.InkDim, TextSize = 12 + F, TextWrapped = true, ZIndex = 7, Parent = quote })
		msg.Quote = quote
		local attachment = UIUtil.Create("TextButton", {
			Name = "Attachment",
			Size = UDim2.fromOffset(math.min(270, readW - P * 2 - 8), 46),
			BackgroundColor3 = Color3.fromRGB(245, 247, 252),
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
			LayoutOrder = 6,
			Visible = false,
			ZIndex = 6,
			Parent = scroll,
		})
		UIUtil.Corner(attachment, 10)
		UIUtil.Stroke(attachment, C.Line, 1.2, 0)
		msg.FileIcon = frame({ Position = UDim2.fromOffset(7, 7), Size = UDim2.fromOffset(32, 32), BackgroundColor3 = C.Grey, ZIndex = 7, Parent = attachment })
		UIUtil.Corner(msg.FileIcon, 7)
		msg.FileEmoji = text({ Size = UDim2.fromScale(1, 1), TextSize = 17, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 8, Parent = msg.FileIcon })
		msg.FileName = text({ Position = UDim2.fromOffset(48, 6), Size = UDim2.new(1, -84, 0, 18), Font = FONT_TITLE, TextSize = 13 + F, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 7, Parent = attachment })
		msg.FileSize = text({ Position = UDim2.fromOffset(48, 25), Size = UDim2.new(1, -84, 0, 15), TextColor3 = C.InkDim, TextSize = 11 + F, ZIndex = 7, Parent = attachment })
		msg.FileAction = text({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(24, 24), Text = "⬇️", TextSize = 17, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 7, Parent = attachment })
		UIUtil.AnimateButton(attachment, 1.03, 0.96)
		onClick(attachment, function()
			local mail = S.Selected
			local file = mail and mail.Email.Attachment
			if not file then
				return
			end
			ctx.Sound.Play("Click", 1)
			snack(file.Virus and pickLine(VIRUS_JOKES) or pickLine(ATTACHMENT_JOKES))
			msg.FileAction.Text = file.Virus and "🛡️" or "✅"
		end)
		msg.Attachment = attachment
		-- Marge du bas (le défilement automatique ne compte pas toujours le UIPadding)
		frame({ Name = "Spacer", Size = UDim2.new(1, 0, 0, 16), LayoutOrder = 9, Parent = scroll })

		local actionBar = frame({ Name = "ActionBar", AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, barH), ZIndex = 5, Parent = messageView })
		frame({ Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = C.Line, ZIndex = 6, Parent = actionBar })
		local actionSpecs = {
			Reply = { Locale.T("↩️ Reply"), "primary" },
			Forward = { Locale.T("➡️ Forward"), "secondary" },
			Spam = { Locale.T("🚫 Spam"), "secondary" },
			NotSpam = { Locale.T("✅ Not spam"), "secondary" },
			Delete = { Locale.T("🗑️ Delete"), "danger" },
			Restore = { Locale.T("♻️ Restore"), "secondary" },
			Forever = { Locale.T("❌ Delete forever"), "danger" },
			Report = { Locale.T("🚩 Report"), "danger" },
			Block = { Locale.T("⛔ Block"), "danger" },
		}
		for _, id in ipairs(ACTION_ORDER) do
			local spec = actionSpecs[id]
			local button, buttonLabel = makeButton({ Name = "Action" .. id, Position = UDim2.fromOffset(P, 10), Size = UDim2.fromOffset(100, 38), Visible = false, ZIndex = 6, Parent = actionBar }, spec[2], spec[1], 14 + F, 10)
			onClick(button, function()
				runAction(id)
			end)
			msg.Actions[id] = button
			msg.ActionLabels[id] = buttonLabel
			msg.ActionTexts[id] = spec[1]
		end
		ui.Msg = msg

		-- Vue "rédaction"
		local cmp: any = { Chips = {} }
		local composeView = frame({ Name = "ComposeView", Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 4, Parent = readPane })
		cmp.Frame = composeView
		cmp.Title = text({ Position = UDim2.fromOffset(P, 10), Size = UDim2.new(1, -P * 2, 0, 24), Font = FONT_TITLE, TextSize = 18 + F, TextTruncate = Enum.TextTruncate.AtEnd, Visible = not phone, ZIndex = 5, Parent = composeView })
		local toY = phone and 8 or 42
		text({ Position = UDim2.fromOffset(P, toY), Size = UDim2.new(1, -P * 2, 0, 16), Font = FONT_TITLE, Text = Locale.T("To:"), TextColor3 = C.InkDim, TextSize = 12 + F, ZIndex = 5, Parent = composeView })
		-- Onglets des destinataires : personnages du jeu / vrais amis Roblox
		local tabH = phone and 30 or 26
		local tabW = phone and 150 or 122
		local tabs = frame({
			Name = "RecipientTabs",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.fromOffset(readW - P, toY - 5),
			Size = UDim2.fromOffset(tabW * 2 + 6, tabH + 4),
			BackgroundColor3 = Color3.fromRGB(234, 238, 247),
			ZIndex = 5,
			Parent = composeView,
		})
		UIUtil.Corner(tabs, UDim.new(1, 0))
		UIUtil.Stroke(tabs, C.Line, 1.2, 0)
		cmp.Tabs = tabs
		cmp.TabButtons = {}
		for index, spec in ipairs({ { "Characters", Locale.T("🎭 Characters") }, { "Friends", Locale.T("👥 Friends") } }) do
			local groupId = spec[1]
			local tabButton, tabLabel = makeButton({
				Name = "CmpTab_" .. groupId,
				Position = UDim2.fromOffset(2 + (index - 1) * (tabW + 2), 2),
				Size = UDim2.fromOffset(tabW, tabH),
				BackgroundColor3 = C.White,
				ZIndex = 6,
				Parent = tabs,
			}, "ghost", spec[2], 13 + F, math.floor(tabH / 2))
			onClick(tabButton, function()
				setGroup(groupId)
			end)
			cmp.TabButtons[groupId] = { Button = tabButton, Label = tabLabel }
		end
		local gridY = toY + (phone and 32 or 28)
		local chipH = phone and 36 or 34
		local columns = 4
		local chipW = math.floor((readW - P * 2 - (columns - 1) * 6) / columns)
		cmp.GridTop = gridY
		for index, contact in ipairs(contacts) do
			local column = (index - 1) % columns
			local line = math.floor((index - 1) / columns)
			local chipButton = UIUtil.Create("TextButton", {
				Name = "Contact_" .. contact.Id,
				Position = UDim2.fromOffset(P + column * (chipW + 6), gridY + line * (chipH + 6)),
				Size = UDim2.fromOffset(chipW, chipH),
				BackgroundColor3 = C.White,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Text = "",
				ZIndex = 5,
				Parent = composeView,
			})
			UIUtil.Corner(chipButton, UDim.new(1, 0))
			local stroke = UIUtil.Stroke(chipButton, C.Line, 1.3, 0)
			local avatar = makeAvatar(chipButton, chipH - 8, UDim2.fromOffset(4, 4), 6)
			avatar.Set(contact.Avatar, tagColor(contact.Tag))
			local name = UIUtil.Create("TextLabel", {
				Position = UDim2.fromOffset(chipH + 1, 4),
				Size = UDim2.new(1, -chipH - 9, 1, -8),
				BackgroundTransparency = 1,
				Font = FONT_TITLE,
				Text = contact.Short,
				TextColor3 = C.Ink,
				TextScaled = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				ZIndex = 6,
				Parent = chipButton,
			})
			UIUtil.Create("UITextSizeConstraint", { MaxTextSize = 14 + F, MinTextSize = 9, Parent = name })
			UIUtil.AnimateButton(chipButton, 1.04, 0.95)
			onClick(chipButton, function()
				local draft = S.Draft
				if not draft or draft.Fixed or S.Sending then
					return
				end
				ctx.Sound.Play("Click", 1.1)
				draft.Contact = contact
				renderChips()
				setStatus(nil)
			end)
			cmp.Chips[contact.Id] = { Button = chipButton, Stroke = stroke, Name = name }
		end
		cmp.GridBottom = gridY + 2 * chipH + 6

		-- Amis Roblox : même place que la grille des personnages. Grille
		-- "virtuelle" : 3 lignes de pastilles recyclées au défilement (200
		-- amis ne créent pas 200 pastilles)
		local areaW = readW - P * 2
		local friendArea = frame({ Name = "FriendArea", Position = UDim2.fromOffset(P, gridY), Size = UDim2.fromOffset(areaW, 2 * chipH + 6), Visible = false, ZIndex = 5, Parent = composeView })
		cmp.FriendArea = friendArea
		local fColumns = phone and 4 or 3
		local fGap = 6
		local fChipW = math.floor((areaW - 8 - (fColumns - 1) * fGap) / fColumns)
		cmp.FriendLayout = { Columns = fColumns, W = fChipW, Pitch = chipH + fGap, Gap = fGap }
		local friendScroll = UIUtil.Create("ScrollingFrame", {
			Name = "FriendGrid",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			CanvasSize = UDim2.new(),
			ScrollBarThickness = 4,
			ScrollBarImageColor3 = Color3.fromRGB(170, 176, 192),
			ScrollingDirection = Enum.ScrollingDirection.Y,
			ZIndex = 5,
			Parent = friendArea,
		})
		cmp.FriendScroll = friendScroll
		cmp.FriendChips = {}
		local half = math.floor(chipH / 2)
		for index = 1, fColumns * 3 do
			local friendButton = UIUtil.Create("TextButton", {
				Name = "FriendChip" .. index,
				Size = UDim2.fromOffset(fChipW, chipH),
				BackgroundColor3 = C.White,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Text = "",
				Visible = false,
				ZIndex = 6,
				Parent = friendScroll,
			})
			UIUtil.Corner(friendButton, UDim.new(1, 0))
			local friendStroke = UIUtil.Stroke(friendButton, C.Line, 1.3, 0)
			local friendAvatar = makeAvatar(friendButton, chipH - 8, UDim2.fromOffset(4, 4), 7)
			-- Pastille de présence (en bas à droite de la photo)
			local dot = frame({ Name = "Presence", AnchorPoint = Vector2.new(1, 1), Position = UDim2.fromOffset(chipH - 3, chipH - 3), Size = UDim2.fromOffset(11, 11), BackgroundColor3 = C.Grey, ZIndex = 10, Parent = friendButton })
			UIUtil.Corner(dot, UDim.new(1, 0))
			UIUtil.Stroke(dot, C.White, 2, 0)
			local friendName = text({ Name = "FriendName", Position = UDim2.fromOffset(chipH + 2, 3), Size = UDim2.new(1, -chipH - 12, 0, half - 2), Font = FONT_TITLE, TextSize = 13 + F, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 7, Parent = friendButton })
			local friendState = text({ Name = "FriendState", Position = UDim2.fromOffset(chipH + 2, half), Size = UDim2.new(1, -chipH - 12, 0, half - 3), Font = FONT_TITLE, TextSize = 10 + F, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 7, Parent = friendButton })
			UIUtil.AnimateButton(friendButton, 1.04, 0.95)
			local chip: any = { Button = friendButton, Stroke = friendStroke, Avatar = friendAvatar, Dot = dot, Name = friendName, State = friendState, Friend = nil }
			onClick(friendButton, function()
				if chip.Friend then
					pickFriend(chip.Friend)
				end
			end)
			cmp.FriendChips[index] = chip
		end
		on(friendScroll:GetPropertyChangedSignal("CanvasPosition"), function()
			layoutFriendGrid()
		end)
		-- Note à la place de la grille : chargement, aucun ami, indisponible, erreur
		local note = frame({ Name = "FriendNote", Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.Field, Visible = false, ZIndex = 8, Parent = friendArea })
		UIUtil.Corner(note, 14)
		UIUtil.Stroke(note, Color3.fromRGB(214, 220, 234), 1.3, 0)
		UIUtil.Gradient(note, ColorSequence.new(C.White, Color3.fromRGB(255, 240, 251)), 0)
		cmp.NoteIcon = text({ AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 12, 0.5, 0), Size = UDim2.fromOffset(40, 40), TextSize = 28, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 9, Parent = note })
		cmp.NoteText = text({ Position = UDim2.fromOffset(60, 0), Size = UDim2.new(1, -72, 1, 0), Font = FONT_TITLE, TextColor3 = C.InkSoft, TextSize = 13 + F, TextWrapped = true, ZIndex = 9, Parent = note })
		local retryW = phone and 118 or 96
		cmp.NoteRetryW = retryW
		cmp.NoteRetry = makeButton({ Name = "FriendRetry", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(retryW, 32), Visible = false, ZIndex = 9, Parent = note }, "secondary", Locale.T("↻ Retry"), 13 + F, 10)
		onClick(cmp.NoteRetry, function()
			ctx.Sound.Play("Click", 1)
			FS.Error = nil
			ensureFriends(true)
			task.spawn(invokeFriend, "Status")
		end)
		cmp.Note = note
		-- Destinataire fixe (réponse)
		cmp.Fixed = frame({ Name = "ReplyTo", Position = UDim2.fromOffset(P, gridY), Size = UDim2.new(1, -P * 2, 0, 40), BackgroundColor3 = C.Field, Visible = false, ZIndex = 5, Parent = composeView })
		UIUtil.Corner(cmp.Fixed, UDim.new(1, 0))
		UIUtil.Stroke(cmp.Fixed, C.Line, 1.2, 0)
		cmp.FixedAvatar = makeAvatar(cmp.Fixed, 32, UDim2.fromOffset(4, 4), 6)
		cmp.FixedName = text({ Position = UDim2.fromOffset(44, 0), Size = UDim2.new(1, -56, 1, 0), Font = FONT_TITLE, TextSize = 14 + F, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 6, Parent = cmp.Fixed })

		local function field(name: string, multi: boolean, placeholder: string): (Frame, TextBox)
			-- (ClipsDescendants : un long texte ne déborde jamais du champ)
			local holder = frame({ Name = name .. "Field", Position = UDim2.fromOffset(P, 0), Size = UDim2.new(1, -P * 2, 0, 36), BackgroundColor3 = C.Field, ClipsDescendants = true, ZIndex = 5, Parent = composeView })
			UIUtil.Corner(holder, 9)
			local stroke = UIUtil.Stroke(holder, Color3.fromRGB(204, 210, 226), 1.3, 0)
			local box = UIUtil.Create("TextBox", {
				Name = name,
				Position = UDim2.fromOffset(10, multi and 8 or 0),
				Size = UDim2.new(1, -20, 1, multi and -26 or 0),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ClearTextOnFocus = false,
				MultiLine = multi,
				Font = FONT_BODY,
				PlaceholderText = placeholder,
				PlaceholderColor3 = Color3.fromRGB(150, 156, 172),
				Text = "",
				TextColor3 = C.Ink,
				TextSize = 15 + F,
				TextWrapped = multi,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = multi and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
				ZIndex = 6,
				Parent = holder,
			})
			on(box.Focused, function()
				S.Interaction += 1
				stroke.Color = C.Blue
				stroke.Thickness = 2
			end)
			on(box.FocusLost, function()
				stroke.Color = Color3.fromRGB(204, 210, 226)
				stroke.Thickness = 1.3
			end)
			return holder, box
		end
		cmp.SubjectField, cmp.Subject = field("SubjectBox", false, Locale.T("Subject"))
		cmp.BodyField, cmp.Body = field("BodyBox", true, Locale.T("Write your message…"))
		cmp.Counter = text({ AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -10, 1, -4), Size = UDim2.fromOffset(70, 15), TextColor3 = C.InkDim, TextSize = 11 + F, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 7, Parent = cmp.BodyField })
		on(cmp.Subject:GetPropertyChangedSignal("Text"), function()
			limitBox(cmp.Subject, SUBJECT_MAX)
			S.Interaction += 1
		end)
		on(cmp.Body:GetPropertyChangedSignal("Text"), function()
			limitBox(cmp.Body, BODY_MAX)
			updateCounterLabel()
			S.Interaction += 1
		end)
		on(cmp.Subject.FocusLost, function(enterPressed)
			if enterPressed and cmp.Body.TextEditable then
				cmp.Body:CaptureFocus()
			end
		end)
		cmp.Quote = frame({ Name = "ForwardQuote", Position = UDim2.fromOffset(P, 0), Size = UDim2.new(1, -P * 2, 0, 50), BackgroundColor3 = Color3.fromRGB(245, 247, 251), ClipsDescendants = true, Visible = false, ZIndex = 5, Parent = composeView })
		UIUtil.Corner(cmp.Quote, 8)
		UIUtil.Stroke(cmp.Quote, C.Line, 1, 0)
		cmp.QuoteLabel = text({ Position = UDim2.fromOffset(10, 5), Size = UDim2.new(1, -20, 1, -10), TextColor3 = C.InkDim, TextSize = 11 + F, TextWrapped = true, TextTruncate = Enum.TextTruncate.AtEnd, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 6, Parent = cmp.Quote })
		cmp.Status = text({ Name = "ComposeStatus", Position = UDim2.fromOffset(P, 0), Size = UDim2.new(1, -P * 2, 0, 18), TextColor3 = C.InkDim, TextSize = 12 + F, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 5, Parent = composeView })
		local sendW = phone and 210 or 176
		cmp.Send, cmp.SendLabel = makeButton({ Name = "SendButton", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, P, 1, -12), Size = UDim2.fromOffset(sendW, 42), ZIndex = 5, Parent = composeView }, "primary", "✈️ " .. Locale.T("Send"), 16 + F, 12)
		cmp.Cancel = makeButton({ Name = "CancelButton", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, P + sendW + 10, 1, -12), Size = UDim2.fromOffset(phone and 150 or 124, 42), ZIndex = 5, Parent = composeView }, "secondary", Locale.T("Cancel"), 15 + F, 12)
		onClick(cmp.Send, function()
			sendDraft()
		end)
		onClick(cmp.Cancel, function()
			ctx.Sound.Play("Click", 0.9)
			cancelCompose()
		end)
		ui.Cmp = cmp

		-- Petit message en bas ("snack"), au-dessus de tout
		local snackButton = UIUtil.Create("TextButton", {
			Name = "MailSnack",
			AnchorPoint = Vector2.new(0.5, 1),
			-- Centré sur la zone de lecture (PC) / sur la fenêtre (téléphone)
			Position = UDim2.new(0, phone and math.floor(W / 2) or (readX + math.floor(readW / 2)), 1, -72),
			Size = UDim2.fromOffset(0, 38),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = Color3.fromRGB(30, 34, 52),
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Font = FONT_TITLE,
			Text = "",
			TextColor3 = C.White,
			TextSize = 14 + F,
			Visible = false,
			ZIndex = 40,
			Parent = win,
		})
		UIUtil.Corner(snackButton, UDim.new(1, 0))
		UIUtil.Create("UIPadding", { PaddingLeft = UDim.new(0, 18), PaddingRight = UDim.new(0, 18), Parent = snackButton })
		UIUtil.Stroke(snackButton, C.White, 1.5, 0.7)
		ui.SnackScale = UIUtil.Create("UIScale", { Parent = snackButton })
		ui.Snack = snackButton
		onClick(snackButton, function()
			local action = S.SnackAction
			hideSnack()
			if action then
				action()
			end
		end)
		return ui
	end

	-- Taille / place de la fenêtre dans la toile (sous le bandeau d'actu)
	local function fitWindow()
		local ui = UI
		if not ui then
			return
		end
		local interface = ctx.Interface
		local canvas = (interface and interface.CanvasSize) or Vector2.new(1280, 720)
		local top = TICKER_H + 6
		local availableW = canvas.X - 24
		local availableH = canvas.Y - top - 10
		local scale = math.min(availableW / ui.L.W, availableH / ui.L.H)
		if ui.Mode == "Wide" then
			scale = math.min(scale, 1)
		end
		ui.Fit = math.max(0.4, scale)
		ui.Root.Position = UDim2.new(0.5, 0, 0, math.floor(top + availableH / 2))
		if S.Open then
			ui.Scale.Scale = ui.Fit
		end
	end

	local function destroyWindow()
		local ui = UI
		if not ui then
			return
		end
		if S.Draft then
			S.Draft.SubjectText = ui.Cmp.Subject.Text
			S.Draft.BodyText = ui.Cmp.Body.Text
		end
		UI = nil
		ui.Root:Destroy()
		ui.Dimmer:Destroy()
	end

	setView = function(view: string)
		S.View = view
		local ui = UI
		if not ui then
			return
		end
		ui.Msg.Frame.Visible = view == "Message"
		ui.Cmp.Frame.Visible = view == "Compose"
		if ui.Mode == "Phone" then
			ui.ListPane.Visible = view == "List"
			ui.ReadPane.Visible = view ~= "List"
			ui.Back.Visible = view ~= "List"
			local left = view ~= "List" and 60 or 12
			ui.Logo.Position = UDim2.new(0, left, 0.5, 0)
			ui.Title.Position = UDim2.fromOffset(left + 42, ui.Title.Position.Y.Offset)
			ui.Subtitle.Position = UDim2.fromOffset(left + 42, ui.Subtitle.Position.Y.Offset)
			if view ~= "Compose" then
				ui.Title.Text = "Dopamail"
			end
		else
			ui.Placeholder.Visible = view == "List"
		end
		if view ~= "Compose" then
			for _, box in ipairs({ ui.Cmp.Subject, ui.Cmp.Body }) do
				if box:IsFocused() then
					box:ReleaseFocus()
				end
			end
		end
	end

	renderAll = function()
		local ui = UI
		if not ui then
			return
		end
		if S.Selected and not table.find(mails, S.Selected) then
			S.Selected = nil
		end
		if S.View == "Message" and not S.Selected then
			setView("List")
		end
		renderFolders()
		renderList()
		if S.View == "Message" and S.Selected then
			updateMessageState(S.Selected)
		end
	end

	refresh = function(bump: boolean?)
		refreshCounter(bump)
		if UI and S.Open then
			renderAll()
		end
	end

	openWindow = function()
		if not ctx.IsAlive() then
			return
		end
		local mode = currentMode()
		if UI and UI.Mode ~= mode then
			destroyWindow()
		end
		if not UI then
			UI = buildWindow(mode)
			local draft = S.Draft
			if draft then
				UI.Cmp.Subject.Text = draft.SubjectText or ""
				UI.Cmp.Body.Text = draft.BodyText or ""
			end
		end
		local ui = UI
		fitWindow()
		if not S.Open then
			S.Open = true
			S.CloseToken += 1
			ui.Root.Visible = true
			ui.Dimmer.Visible = true
			ui.Dimmer.BackgroundTransparency = 1
			UIUtil.Tween(ui.Dimmer, 0.25, { BackgroundTransparency = 0.55 })
			ui.Scale.Scale = ui.Fit * 0.9
			UIUtil.Tween(ui.Scale, 0.32, { Scale = ui.Fit }, Enum.EasingStyle.Back)
		end
		setView(S.View)
		if S.View == "Compose" then
			renderCompose()
		end
		renderAll()
	end

	closeWindow = function()
		local ui = UI
		if not S.Open or not ui then
			return
		end
		S.Open = false
		S.CloseToken += 1
		local token = S.CloseToken
		hideSnack()
		for _, box in ipairs({ ui.Cmp.Subject, ui.Cmp.Body, ui.SearchBox }) do
			if box and box:IsFocused() then
				box:ReleaseFocus()
			end
		end
		UIUtil.Tween(ui.Dimmer, 0.18, { BackgroundTransparency = 1 })
		UIUtil.Tween(ui.Scale, 0.16, { Scale = ui.Fit * 0.92 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(0.18, function()
			if ctx.IsAlive() and S.CloseToken == token and UI == ui then
				ui.Root.Visible = false
				ui.Dimmer.Visible = false
			end
		end)
	end

	-- Mail ouvert depuis sa notification : fermeture auto si le joueur ne touche à rien
	local function scheduleQuickClose()
		local interaction = S.Interaction
		local token = S.CloseToken
		task.delay(QUICK_CLOSE, function()
			if ctx.IsAlive() and S.Open and S.CloseToken == token and S.Interaction == interaction then
				closeWindow()
			end
		end)
	end

	selectFolder = function(id: string)
		S.Folder = id
		S.Selected = nil
		if UI then
			UI.List.CanvasPosition = Vector2.zero
			if S.View ~= "Compose" or UI.Mode == "Phone" then
				setView("List")
			end
		end
		refresh()
	end

	goBack = function()
		if S.View == "Compose" then
			if S.Selected and table.find(mails, S.Selected) then
				renderMessage(S.Selected)
				setView("Message")
			else
				setView("List")
			end
		else
			S.Selected = nil
			setView("List")
		end
		refresh()
	end

	------------------------------------------------------------------
	-- Rédaction pour un ami : liste, présence, compte à rebours
	------------------------------------------------------------------
	-- Amis en ligne (GetFriendsOnlineAsync, API du client ; peut attendre) -> true si mis à jour
	local function refreshOnline(): boolean
		if not player or now() - FS.OnlineClock < ONLINE_REFRESH then
			return false
		end
		FS.OnlineClock = now()
		local ok, list = pcall(function()
			return player:GetFriendsOnlineAsync(200)
		end)
		if not ok or type(list) ~= "table" then
			return false
		end
		local online = {}
		for _, info in ipairs(list) do
			-- (noms de champs lus prudemment : VisitorId / Id / UserId)
			local id = FriendMailRules.ReadFriend(info)
			if id and info.IsOnline ~= false then
				online[id] = true
			end
		end
		FS.Online = online
		return true
	end

	-- État anti-spam redemandé au serveur s'il date un peu
	local function refreshStatus(force: boolean?)
		if not force and FS.Status and now() - FS.StatusClock < STATUS_REFRESH then
			return
		end
		task.spawn(function()
			invokeFriend("Status")
			if ctx.IsAlive() then
				updateFriendSend()
			end
		end)
	end

	updateFriendSend = function()
		local ui = UI
		local draft = S.Draft
		if not ui or not draft or S.Sending or not isFriendDraft(draft) then
			return
		end
		local cmp = ui.Cmp
		local status = FS.Status
		local locked, message, color, countdown = false, nil, nil, nil
		if type(status) == "table" and status.Enabled == false then
			locked = true
			message = status.Reason == "Studio" and Locale.T("🛠️ Friend mail is unavailable in Studio: it works in the published game!")
				or ("⚠️ " .. Locale.T("Friend mail is unavailable right now"))
			color = C.Red
		else
			local isReply = draft.ReplyTo ~= nil
			local wait = friendWait(isReply)
			if wait > 0 then
				locked = true
				countdown = FriendMailRules.Countdown(wait)
				message = isReply and Locale.T("⏳ Next reply in %s (1 every 2 min)", countdown)
					or Locale.T("⏳ Next friend mail in %s (1 every 10 min)", countdown)
				color = Color3.fromRGB(190, 104, 0)
			end
		end
		cmp.SendLabel.Text = countdown and ("⏳ " .. countdown) or ("💌 " .. Locale.T("Send"))
		cmp.Send.BackgroundColor3 = locked and C.Grey or C.Blue
		if now() >= S.StatusHold then
			if message then
				cmp.Status.Text = message
				cmp.Status.TextColor3 = color or C.InkDim
			else
				setStatus(nil)
			end
		end
	end

	layoutFriendGrid = function()
		local ui = UI
		if not ui then
			return
		end
		local cmp = ui.Cmp
		local layout = cmp.FriendLayout
		local list = FS.Sorted
		local lastFirst = math.max(0, math.ceil(#list / layout.Columns) - 2)
		local first = math.clamp(math.floor(cmp.FriendScroll.CanvasPosition.Y / layout.Pitch), 0, lastFirst)
		local selected = S.Draft and S.Draft.Contact
		for index, chip in ipairs(cmp.FriendChips) do
			local slot = first * layout.Columns + index - 1
			local friend = list[slot + 1]
			chip.Friend = friend
			chip.Button.Visible = friend ~= nil
			if friend then
				local column = slot % layout.Columns
				local row = math.floor(slot / layout.Columns)
				chip.Button.Position = UDim2.fromOffset(column * (layout.W + layout.Gap), row * layout.Pitch)
				local presence = presenceOf(friend.Id)
				local style = PRESENCE[presence]
				chip.Avatar.Set("👤", TAGS.FRIEND.Color, headshot(friend.Id))
				chip.Name.Text = friend.Display
				chip.State.Text = Locale.T(style.Text)
				chip.State.TextColor3 = style.Color
				chip.Dot.BackgroundColor3 = style.Color
				chip.Dot.Visible = presence ~= "Blocked"
				local isSelected = selected ~= nil and selected.Friend == true and selected.UserId == friend.Id
				chip.Button.BackgroundColor3 = isSelected and C.Selected or C.White
				chip.Stroke.Color = isSelected and C.Blue or C.Line
				chip.Stroke.Thickness = isSelected and 2 or 1.3
				chip.Name.TextColor3 = isSelected and C.BlueDark or C.Ink
			end
		end
	end

	renderFriendArea = function()
		local ui = UI
		if not ui then
			return
		end
		local cmp = ui.Cmp
		-- Tri : sur ce serveur, en ligne, hors ligne, bloqués ; puis par nom
		local ranks: { [number]: number } = {}
		local sorted = {}
		for _, friend in ipairs(FS.Friends or {}) do
			ranks[friend.Id] = PRESENCE[presenceOf(friend.Id)].Rank
			table.insert(sorted, friend)
		end
		table.sort(sorted, function(a, b)
			if ranks[a.Id] ~= ranks[b.Id] then
				return ranks[a.Id] < ranks[b.Id]
			end
			local nameA, nameB = string.lower(a.Display), string.lower(b.Display)
			if nameA ~= nameB then
				return nameA < nameB
			end
			return a.Id < b.Id
		end)
		FS.Sorted = sorted
		-- Note à la place de la grille
		local icon, message, retry = "", nil, false
		local status = FS.Status
		if type(status) == "table" and status.Enabled == false then
			icon = "🛠️"
			if status.Reason == "Studio" then
				message = Locale.T("Friend mail is unavailable in Studio (API services are off). It works in the published game!")
			else
				message = Locale.T("Friend mail is unavailable right now. Try again in a moment!")
				retry = true
			end
		elseif FS.Friends == nil and FS.Loading then
			icon = "⏳"
			message = Locale.T("Loading your Roblox friends…")
		elseif FS.Friends == nil then
			icon = "⚠️"
			message = FS.Error or Locale.T("Couldn't load your friends")
			retry = true
		elseif #sorted == 0 then
			icon = "🫂"
			message = Locale.T("No Roblox friends yet. Add friends on Roblox, then mail them from here!")
		end
		cmp.Note.Visible = message ~= nil
		cmp.FriendScroll.Visible = message == nil
		if message then
			cmp.NoteIcon.Text = icon
			cmp.NoteText.Text = message
			cmp.NoteRetry.Visible = retry
			cmp.NoteText.Size = UDim2.new(1, retry and -(72 + cmp.NoteRetryW + 8) or -72, 1, 0)
		end
		local layout = cmp.FriendLayout
		local rows = math.ceil(#sorted / layout.Columns)
		cmp.FriendScroll.CanvasSize = UDim2.fromOffset(0, math.max(0, rows * layout.Pitch - layout.Gap))
		layoutFriendGrid()
	end

	pickFriend = function(friend)
		local draft = S.Draft
		if not draft or draft.Fixed or S.Sending then
			return
		end
		local key = tostring(friend.Id)
		if FS.Blocked[key] then
			ctx.Sound.Play("Click", 0.9)
			snack(Locale.T("🚫 %s is blocked. Tap here to unblock", friend.Display), function()
				FS.Blocked[key] = nil
				renderFriendArea()
				task.spawn(function()
					local ok, result = invokeFriend("Unblock", friend.Id)
					if ok and type(result) == "table" and type(result.Blocked) == "table" then
						FS.Blocked = result.Blocked
					end
					if ctx.IsAlive() then
						renderFriendArea()
						snack(Locale.T("✅ %s is unblocked", friend.Display))
					end
				end)
			end)
			return
		end
		ctx.Sound.Play("Click", 1.1)
		draft.Contact = friendContact(friend.Id, friend.Name, friend.Display)
		S.StatusHold = 0
		layoutFriendGrid()
		updateFriendSend()
	end

	ensureFriends = function(force: boolean?)
		if not force and FS.Friends and now() - FS.FriendsClock < FRIENDS_REFRESH then
			-- Liste récente : seulement la présence, en arrière-plan
			task.spawn(function()
				if refreshOnline() and ctx.IsAlive() then
					renderFriendArea()
				end
			end)
			return
		end
		if FS.Loading then
			return
		end
		FS.Loading = true
		FS.Error = nil
		if force then
			FS.OnlineClock = -math.huge
		end
		renderFriendArea()
		task.spawn(function()
			if refreshOnline() and ctx.IsAlive() and FS.Friends then
				renderFriendArea()
			end
		end)
		task.spawn(function()
			local ok, result = invokeFriend("Friends")
			if not ctx.IsAlive() then
				return
			end
			FS.Loading = false
			if ok and type(result) == "table" and type(result.Friends) == "table" then
				local list = {}
				for _, friend in ipairs(result.Friends) do
					local id, name, display = FriendMailRules.ReadFriend(type(friend) == "table" and {
						Id = friend.Id,
						Username = friend.Name,
						DisplayName = friend.Display,
					} or nil)
					if id then
						table.insert(list, { Id = id, Name = name, Display = display ~= "" and display or ("#" .. tostring(id)) })
					end
				end
				FS.Friends = list
				FS.FriendsClock = now()
				if type(result.Blocked) == "table" then
					FS.Blocked = result.Blocked
				end
			else
				FS.Error = type(result) == "string" and result or nil
			end
			renderFriendArea()
			updateFriendSend()
		end)
	end

	setGroup = function(group: string)
		local draft = S.Draft
		if not draft or draft.Fixed or S.Sending or draft.Group == group then
			return
		end
		ctx.Sound.Play("Click", 1.05)
		draft.Group = group
		S.Group = group
		-- Le destinataire choisi n'appartient pas au nouveau groupe : on l'oublie
		if draft.Contact and (draft.Contact.Friend == true) ~= (group == "Friends") then
			draft.Contact = nil
		end
		S.StatusHold = 0
		if group == "Friends" then
			ensureFriends(false)
			refreshStatus(false)
		end
		renderCompose()
	end

	------------------------------------------------------------------
	-- Récompense (mails du serveur)
	------------------------------------------------------------------
	local function claim(mail, source: string?)
		mail.State = "Claimed"
		local id = mail.SpawnId
		if source ~= "Card" then
			-- Ouvert depuis la liste : le "+X" apparaît au-dessus de la fenêtre
			positions[id] = UDim2.new(0.5, 0, 0.5, -60)
		end
		lastPosition = positions[id] or lastPosition
		ctx.ClaimSpawn(id)
		task.delay(CLAIM_WAIT, function()
			if ctx.IsAlive() and mail.State == "Claimed" and not mail.Reward then
				mail.State = "Missed"
				refresh()
			end
		end)
		task.delay(8, function()
			positions[id] = nil
		end)
	end

	expireMail = function(mail)
		if mail.State ~= "Live" then
			return
		end
		mail.State = "Expired"
		if mail.Envelope then
			removeEnvelope(mail.Envelope, false)
		end
		refresh(true)
	end

	openMail = function(mail, source: string?)
		if not ctx.IsAlive() or not table.find(mails, mail) then
			return
		end
		if mail.State == "Live" then
			if now() < mail.ExpiresAt then
				claim(mail, source)
			else
				expireMail(mail)
			end
		end
		mail.Read = true
		if mail.Kind == "Friend" and not mail.ReadSent then
			mail.ReadSent = true
			task.spawn(invokeFriend, "Read", mail.FriendId)
		end
		if mail.Envelope then
			removeEnvelope(mail.Envelope, true)
		end
		if S.SnackTarget == mail then
			hideSnack()
		end
		if not inFolder(mail, S.Folder) then
			S.Folder = mail.Folder
		end
		S.Selected = mail
		local wasOpen = S.Open
		S.View = "Message"
		openWindow()
		renderMessage(mail)
		setView("Message")
		refresh()
		if source == "Card" and not wasOpen then
			scheduleQuickClose()
		end
	end

	------------------------------------------------------------------
	-- Rédaction : ouvrir, envoyer (filtre du serveur), annuler
	------------------------------------------------------------------
	openCompose = function(options)
		if S.Sending then
			return
		end
		local contact = options.Contact
		local group = options.Group
		if not group then
			if contact then
				group = contact.Friend and "Friends" or "Characters"
			elseif options.Kind == "Forward" then
				group = "Characters"
			else
				group = S.Group
			end
		end
		S.Draft = {
			Kind = options.Kind or "New",
			Contact = contact,
			Fixed = options.Kind == "Reply",
			Quote = options.Quote,
			Group = group,
			ReplyTo = options.ReplyTo, -- id du mail d'ami auquel on répond (règle des 2 min)
		}
		S.StatusHold = 0
		S.View = "Compose"
		openWindow()
		local ui = UI
		ui.Cmp.Subject.Text = options.Subject or ""
		ui.Cmp.Body.Text = ""
		ui.Cmp.FriendScroll.CanvasPosition = Vector2.zero
		if group == "Friends" then
			if not S.Draft.Fixed then
				ensureFriends(false)
			end
			refreshStatus(false)
		end
		renderCompose()
		setView("Compose")
	end

	composeClicked = function()
		if S.Draft then
			-- Brouillon en cours : on y revient
			S.View = "Compose"
			if isFriendDraft(S.Draft) then
				refreshStatus(false)
			end
			renderCompose()
			setView("Compose")
		else
			openCompose({ Kind = "New" })
		end
	end

	cancelCompose = function()
		S.Sending = nil
		S.Draft = nil
		local ui = UI
		if ui then
			ui.Cmp.Subject.Text = ""
			ui.Cmp.Body.Text = ""
			setSending(false)
		end
		goBack()
	end

	-- Objet et texte : UN seul appel au filtre, séparés par SEPARATOR
	local function splitFiltered(value: string, hasSubject: boolean, hasBody: boolean): (string, string)
		if hasSubject and hasBody then
			local first, last = string.find(value, SEPARATOR, 1, true)
			if first and last then
				return trim(string.sub(value, 1, first - 1)), trim(string.sub(value, last + 1))
			end
			return "", trim(value)
		elseif hasSubject then
			return trim(value), ""
		end
		return "", trim(value)
	end

	-- Réponse du correspondant, quelques secondes après l'envoi
	local function scheduleReply(contact, sent, topics: { any }, forwarded: boolean)
		task.delay(random:NextNumber(REPLY_DELAY_MIN, REPLY_DELAY_MAX), function()
			if not ctx.IsAlive() then
				return
			end
			local texts = (contact.Id and Locale.Pick(CONTACT_TEXT)[contact.Id]) or Locale.Pick(TAG_VOICES)[contact.Tag] or Locale.Pick(TAG_VOICES).PERSO
			local body = composeReply(texts, topics, forwarded, contact.Caps == true)
			local sentEmail = sent.Email
			local baseSubject = sentEmail.Subject ~= "" and sentEmail.Subject or Locale.T("(no subject)")
			local email = {
				Tag = makeTag(contact.Tag),
				Avatar = contact.Avatar,
				Sender = contact.Name,
				Address = contact.Address,
				Subject = prefixed("Re: ", baseSubject),
				Body = body,
				Signature = contact.Signature or contact.Name,
				Attachment = nil,
				Suspicious = contact.Tag == "ARNAQUE" or contact.Tag == "SPAM",
			}
			local quoted = sentEmail.Body ~= "" and sentEmail.Body or sentEmail.Subject
			local mail = {
				Kind = "Reply",
				Email = email,
				Contact = contact,
				Folder = "Inbox",
				Read = false,
				Starred = false,
				State = "Local",
				Time = now(),
				Quote = quoted ~= "" and { Label = Locale.T("You wrote:"), Text = quoted } or nil,
			}
			addMail(mail)
			ctx.Sound.Play("Mail", 1 + random:NextNumber() * 0.15)
			if S.Open then
				snack(Locale.T("📩 New mail from %s", contact.Short), function()
					openMail(mail, "List")
				end, mail)
			else
				spawnCard(mail, nil)
			end
			refresh(true)
		end)
	end

	local function deliverSent(draft, contact, subject: string, body: string, topics: { any }, where: string?)
		local friendMail = contact.Friend == true
		local email = {
			Tag = makeTag(contact.Tag),
			Avatar = contact.Avatar,
			Image = contact.Image,
			Sender = me.Name,
			Address = me.Address,
			Subject = subject,
			Body = body,
			Signature = nil,
			Attachment = nil,
			Suspicious = false,
		}
		local mail = {
			Kind = "Sent",
			Friend = friendMail or nil,
			Email = email,
			To = contact,
			Folder = "Sent",
			Read = true,
			Starred = false,
			State = "Local",
			Time = now(),
			Quote = draft.Quote,
		}
		addMail(mail)
		S.Draft = nil
		local ui = UI
		if ui then
			ui.Cmp.Subject.Text = ""
			ui.Cmp.Body.Text = ""
		end
		-- On montre ce qui est vraiment parti (texte filtré), dans "Envoyés"
		S.Folder = "Sent"
		S.Selected = mail
		if ui and S.Open then
			S.View = "Message"
			renderMessage(mail)
			setView("Message")
		else
			S.View = "List"
		end
		refresh()
		if friendMail then
			-- Un vrai ami : pas de réponse automatique, il répondra lui-même
			local original = draft.ReplyTo and FS.Known[draft.ReplyTo]
			if original then
				original.Replied = true
			end
			if where == "Server" then
				snack(Locale.T("💌 Delivered to %s!", contact.Short))
			else
				snack(Locale.T("💌 Sent to %s! It's waiting in their Dopamail", contact.Short))
			end
		else
			snack(Locale.T("✈️ Sent to %s!", contact.Short))
			scheduleReply(contact, mail, topics, draft.Kind == "Forward")
		end
	end

	sendDraft = function()
		local ui = UI
		local draft = S.Draft
		if not ui or not draft or S.Sending then
			return
		end
		local cmp = ui.Cmp
		local contact = draft.Contact
		if not contact then
			setStatus(draft.Group == "Friends" and Locale.T("Pick a friend first 👆") or Locale.T("Pick a recipient first 👆"), C.Red)
			return
		end
		local friendMail = contact.Friend == true
		if friendMail then
			-- Indisponible / compte à rebours : le bouton l'affiche déjà, on le rappelle
			local status = FS.Status
			if (type(status) == "table" and status.Enabled == false) or friendWait(draft.ReplyTo ~= nil) > 0 then
				S.StatusHold = 0
				updateFriendSend()
				return
			end
		end
		local subject = trim(cmp.Subject.Text)
		local body = trim(cmp.Body.Text)
		if subject == "" and body == "" then
			setStatus(Locale.T("Write something first ✍️"), C.Red)
			return
		end
		-- Le séparateur ne doit pas apparaître dans l'objet
		local cleanSubject = string.gsub(subject, "—", "-")
		local hasSubject, hasBody = cleanSubject ~= "", body ~= ""
		local payload
		if hasSubject and hasBody then
			payload = cleanSubject .. SEPARATOR .. body
		elseif hasSubject then
			payload = cleanSubject
		else
			payload = body
		end
		local token = {}
		S.Sending = token
		setSending(true)
		ctx.Sound.Play("Mail", 1.3)
		task.delay(friendMail and FRIEND_SEND_TIMEOUT or SEND_TIMEOUT, function()
			if ctx.IsAlive() and S.Sending == token then
				S.Sending = nil
				setSending(false)
				setStatus("⚠️ " .. Locale.T("Message could not be sent, try again"), C.Red)
				updateFriendSend()
			end
		end)
		-- Le filtre du serveur (peut attendre) : jamais dans le gestionnaire du clic
		task.spawn(function()
			local okCall, success, result = pcall(function()
				return ctx.Net.Function("FilterText"):InvokeServer("Mail", payload)
			end)
			if not ctx.IsAlive() or S.Sending ~= token then
				return
			end
			if not (okCall and success == true and type(result) == "table" and type(result.Text) == "string") then
				S.Sending = nil
				setSending(false)
				-- Jamais le texte brut : seulement le message d'erreur
				local message = (okCall and type(result) == "string" and result ~= "") and result or Locale.T("Message could not be sent, try again")
				setStatus("⚠️ " .. message, C.Red)
				updateFriendSend()
				return
			end
			local filteredSubject, filteredBody = splitFiltered(result.Text, hasSubject, hasBody)
			if not friendMail then
				S.Sending = nil
				setSending(false)
				local topics = type(result.Topics) == "table" and result.Topics or {}
				deliverSent(draft, contact, filteredSubject, filteredBody, topics)
				return
			end
			-- Ami Roblox : le serveur vérifie tout (ami, réglages, anti-spam),
			-- garde le texte brut pour lui seul et le filtre pour le destinataire
			local sent, reply = invokeFriend("Send", {
				To = contact.UserId,
				Subject = cleanSubject,
				Body = body,
				ReplyTo = draft.ReplyTo,
			})
			if not ctx.IsAlive() or S.Sending ~= token then
				return
			end
			S.Sending = nil
			setSending(false)
			if sent and type(reply) == "table" then
				deliverSent(draft, contact, filteredSubject, filteredBody, {}, reply.Where)
			else
				local message = (type(reply) == "string" and reply ~= "") and reply or Locale.T("Message could not be sent, try again")
				setStatus("⚠️ " .. message, C.Red)
				updateFriendSend()
			end
		end)
	end

	runAction = function(id: string)
		local mail = S.Selected
		if not mail then
			return
		end
		local e = mail.Email
		if id == "Reply" then
			ctx.Sound.Play("Click", 1)
			if mail.Kind == "Friend" then
				-- Déjà répondu : c'est un nouveau mail (règle des 10 min)
				openCompose({
					Kind = "Reply",
					Contact = mail.Contact,
					Subject = prefixed("Re: ", e.Subject),
					ReplyTo = (not mail.Replied) and mail.FriendId or nil,
					Group = "Friends",
				})
			else
				openCompose({ Kind = "Reply", Contact = contactOf(mail), Subject = prefixed("Re: ", e.Subject) })
			end
			return
		elseif id == "Forward" then
			ctx.Sound.Play("Click", 1)
			local from = mail.Kind == "Sent" and me.Name or e.Sender
			openCompose({
				Kind = "Forward",
				Subject = prefixed("Fwd: ", e.Subject),
				Quote = {
					Label = Locale.T("---------- Forwarded message ----------"),
					Text = Locale.T("From: %s", from) .. "\n" .. Locale.T("Subject: %s", e.Subject) .. "\n" .. e.Body,
					-- Aperçu court dans la rédaction (le mail envoyé montre tout)
					Short = Locale.T("From: %s", from) .. " · " .. Locale.T("Subject: %s", e.Subject),
				},
			})
			return
		end
		if mail.Kind == "Friend" and (id == "Report" or id == "Block") then
			-- Signaler / Bloquer : un 2e clic confirme (3 s)
			local confirm = S.Confirm
			if not (confirm and confirm.Id == id and confirm.Mail == mail and now() < confirm.Until) then
				ctx.Sound.Play("Click", 0.9)
				local stamp = { Id = id, Mail = mail, Until = now() + 3 }
				S.Confirm = stamp
				local ui = UI
				local label = ui and ui.Msg.ActionLabels[id]
				if label then
					label.Text = Locale.T("⚠️ Sure?")
					ui.Msg.Actions[id].BackgroundColor3 = Color3.fromRGB(255, 214, 218)
				end
				task.delay(3, function()
					if ctx.IsAlive() and S.Confirm == stamp then
						S.Confirm = nil
						local current = UI
						if current and current.Msg.ActionLabels[id] then
							current.Msg.ActionLabels[id].Text = current.Msg.ActionTexts[id]
							current.Msg.Actions[id].BackgroundColor3 = C.White
						end
					end
				end)
				return
			end
			S.Confirm = nil
		end
		ctx.Sound.Play("Click", 0.8)
		if mail.Kind == "Friend" and (id == "Delete" or id == "Report" or id == "Block") then
			local userId = mail.UserId
			local friendId = mail.FriendId
			local who = mail.Contact and mail.Contact.Short or "?"
			if id == "Delete" then
				removeMail(mail)
				snack(Locale.T("🗑️ Friend mail deleted"))
				task.spawn(invokeFriend, "Delete", friendId)
			else
				-- Caché + expéditeur bloqué pour ce joueur (rien n'est envoyé ailleurs)
				FS.Blocked[tostring(userId)] = true
				for index = #mails, 1, -1 do
					local other = mails[index]
					if other.Kind == "Friend" and other.UserId == userId then
						removeMail(other)
					end
				end
				if id == "Report" then
					snack(Locale.T("🚩 Reported: mail hidden and %s blocked", who))
					task.spawn(invokeFriend, "Report", friendId)
				else
					snack(Locale.T("⛔ %s is blocked: no more mails from them", who))
					task.spawn(invokeFriend, "Block", userId)
				end
			end
			S.Selected = nil
			setView("List")
			refresh()
			return
		end
		if id == "Spam" then
			mail.PrevFolder = mail.Folder
			mail.Folder = "Spam"
			snack(pickLine(SPAMMED))
		elseif id == "NotSpam" then
			mail.Folder = "Inbox"
			snack(Locale.T("✅ Back in your inbox"))
		elseif id == "Delete" then
			mail.PrevFolder = mail.Folder
			mail.Folder = "Trash"
			snack(Locale.T("🗑️ Moved to the trash"))
		elseif id == "Restore" then
			local target = mail.PrevFolder
			if target ~= "Inbox" and target ~= "Sent" and target ~= "Spam" then
				target = mail.Kind == "Sent" and "Sent" or "Inbox"
			end
			mail.Folder = target
			snack(Locale.T("♻️ Restored to %s", folderName(target)))
		elseif id == "Forever" then
			removeMail(mail)
			snack(Locale.T("💨 Deleted forever"))
		end
		S.Selected = nil
		setView("List")
		refresh()
	end

	------------------------------------------------------------------
	-- Notifications de mail (cartes volantes)
	------------------------------------------------------------------
	local function fadeOut(root: Instance, duration: number)
		for _, item in ipairs(root:GetDescendants()) do
			if item:IsA("TextLabel") then
				UIUtil.Tween(item, duration, { TextTransparency = 1, BackgroundTransparency = 1 })
			elseif item:IsA("Frame") then
				UIUtil.Tween(item, duration, { BackgroundTransparency = 1 })
			elseif item:IsA("UIStroke") then
				UIUtil.Tween(item, duration, { Transparency = 1 })
			end
		end
	end

	removeEnvelope = function(envelope, opened: boolean)
		if envelope.Done then
			return
		end
		envelope.Done = true
		envelopes[envelope.Id] = nil
		envelopeCount -= 1
		if envelope.Mail.Envelope == envelope then
			envelope.Mail.Envelope = nil
		end
		local root = envelope.Root
		if opened then
			-- La lettre sort de l'enveloppe, puis la carte s'efface
			UIUtil.Tween(envelope.Letter, 0.2, { Position = UDim2.new(0.5, 0, 0, -30) }, Enum.EasingStyle.Back)
			task.delay(0.12, function()
				if root.Parent then
					UIUtil.Tween(envelope.Scale, 0.25, { Scale = 1.12 }, Enum.EasingStyle.Quad)
					fadeOut(root, 0.22)
				end
			end)
		else
			-- Ignorée : elle file vers le compteur (le mail reste dans la Réception)
			UIUtil.Tween(root, 0.8, {
				Position = UDim2.new(1, -(tickerRight + 50), 0, 14),
				Rotation = -25,
			}, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			UIUtil.Tween(envelope.Scale, 0.8, { Scale = 0.15 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			fadeOut(root, 0.8)
		end
		Debris:AddItem(root, opened and 0.45 or 0.85)
	end

	spawnCard = function(mail, info)
		if not ctx.IsAlive() or mail.Envelope or envelopeCount >= MAX_ENVELOPES then
			return
		end
		local email = mail.Email
		local x = math.clamp(tonumber(info and info.X) or random:NextNumber(0.2, 0.7), 0.1, 0.9)
		local y = math.clamp(tonumber(info and info.Y) or random:NextNumber(0.25, 0.75), 0.12, 0.88)
		local rewarded = mail.Kind == "Spawn"
		local lifetime = rewarded and math.max(1, mail.ExpiresAt - now()) or LOCAL_CARD_LIFE
		local target = UDim2.fromScale(x, y)
		local color = email.Tag.Color

		local root = UIUtil.Create("TextButton", {
			Name = "Envelope",
			Size = UDim2.fromOffset(CARD_W, CARD_H),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(1.15, math.max(0.05, y - 0.2)),
			Rotation = 20,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
			ZIndex = 30,
			Parent = container,
		})
		local scale = UIUtil.Create("UIScale", { Scale = 0.6, Parent = root })

		-- Lettre (derrière la carte, elle en sort à l'ouverture)
		local letter = frame({ Name = "Letter", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 8), Size = UDim2.new(1, -34, 0, 56), BackgroundColor3 = C.Paper, ZIndex = 30, Parent = root })
		UIUtil.Corner(letter, 4)
		UIUtil.Stroke(letter, Color3.fromRGB(210, 214, 226), 1, 0)
		for i = 1, 3 do
			frame({ Position = UDim2.fromOffset(12, 8 + i * 7), Size = UDim2.new(0.7 - i * 0.12, 0, 0, 2), BackgroundColor3 = Color3.fromRGB(200, 204, 216), ZIndex = 30, Parent = letter })
		end

		-- Ombre douce
		local shadow = frame({ Size = UDim2.new(1, 4, 1, 4), Position = UDim2.fromOffset(-2, 5), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.8, ZIndex = 29, Parent = root })
		UIUtil.Corner(shadow, 16)

		-- Carte (notification)
		local body = frame({ Name = "Body", Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.White, ZIndex = 31, Parent = root })
		UIUtil.Corner(body, 14)
		UIUtil.Gradient(body, ColorSequence.new(C.White, Color3.fromRGB(238, 241, 248)), 90)
		local bodyStroke = UIUtil.Stroke(body, C.Border, 1.5, 0.15)
		-- Liseré coloré à gauche (couleur de l'étiquette)
		local accent = frame({ Size = UDim2.new(0, 4, 1, -24), Position = UDim2.fromOffset(0, 12), BackgroundColor3 = color, ZIndex = 32, Parent = body })
		UIUtil.Corner(accent, 2)

		-- En-tête "DOPAMAIL · maintenant" (comme une notification de téléphone)
		local appIcon = frame({ Position = UDim2.fromOffset(12, 7), Size = UDim2.fromOffset(14, 14), BackgroundColor3 = C.Blue, ZIndex = 33, Parent = body })
		UIUtil.Corner(appIcon, 4)
		UIUtil.Gradient(appIcon, ColorSequence.new(C.White, Color3.fromRGB(190, 205, 235)), 90)
		text({ Size = UDim2.fromScale(1, 1), Text = "✉", Font = FONT_TITLE, TextColor3 = C.White, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 34, Parent = appIcon })
		text({ Position = UDim2.fromOffset(31, 6), Size = UDim2.fromOffset(120, 16), Font = FONT_TITLE, Text = "DOPAMAIL · " .. Locale.T("now"), TextColor3 = C.InkDim, TextSize = 10, ZIndex = 33, Parent = body })
		local chip = makeChip(body, 15, 34)
		chip.Frame.AnchorPoint = Vector2.new(1, 0)
		chip.Frame.Position = UDim2.new(1, -10, 0, 6)
		chip.Set(email.Tag.Text, color)

		-- Avatar + pastille "non lu"
		local avatar = makeAvatar(body, 38, UDim2.fromOffset(12, 28), 33)
		avatar.Set(email.Avatar, color, email.Image)
		local dot = frame({ Name = "UnreadDot", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(15, 31), Size = UDim2.fromOffset(12, 12), BackgroundColor3 = C.Blue, ZIndex = 36, Parent = body })
		UIUtil.Corner(dot, UDim.new(1, 0))
		UIUtil.Stroke(dot, C.White, 2, 0)

		-- Textes (+ trombone s'il y a une pièce jointe)
		text({ Position = UDim2.fromOffset(58, 26), Size = UDim2.new(1, -90, 0, 16), Font = FONT_TITLE, Text = email.Sender, TextSize = 14, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 33, Parent = body })
		if email.Attachment then
			text({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 26), Size = UDim2.fromOffset(18, 16), Text = "📎", TextSize = 13, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 33, Parent = body })
		end
		text({ Position = UDim2.fromOffset(58, 42), Size = UDim2.new(1, -68, 0, 15), Font = FONT_TITLE, Text = email.Subject, TextColor3 = C.InkSoft, TextSize = 12, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 33, Parent = body })
		text({ Position = UDim2.fromOffset(58, 57), Size = UDim2.new(1, -68, 0, 14), Text = email.Body, TextColor3 = C.InkDim, TextSize = 11, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 33, Parent = body })

		-- Barre de temps restant (en bas)
		local lifeBack = frame({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 58, 1, -7), Size = UDim2.new(1, -70, 0, 3), BackgroundColor3 = Color3.fromRGB(222, 226, 236), ZIndex = 33, Parent = body })
		UIUtil.Corner(lifeBack, UDim.new(1, 0))
		local lifeBar = frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = color, ZIndex = 34, Parent = lifeBack })
		UIUtil.Corner(lifeBar, UDim.new(1, 0))

		local envelope = {
			Id = "card" .. tostring(mail.Key),
			Mail = mail,
			Root = root,
			Scale = scale,
			Body = body,
			BodyStroke = bodyStroke,
			Letter = letter,
			Dot = dot,
			Chip = chip,
			LifeBar = lifeBar,
			Target = target,
			Born = now(),
			Lifetime = lifetime,
			Rewarded = rewarded,
			Phase = random:NextNumber(0, math.pi * 2),
			Hurry = false,
			Done = false,
		}
		envelopes[envelope.Id] = envelope
		envelopeCount += 1
		mail.Envelope = envelope

		-- Arrivée en vol plané
		UIUtil.Tween(root, 0.75, { Position = target, Rotation = 0 }, Enum.EasingStyle.Back)
		UIUtil.Tween(scale, 0.75, { Scale = 1 }, Enum.EasingStyle.Back)

		-- Survol : la carte se soulève un peu
		ctx.Connect(root.MouseEnter, function()
			if not envelope.Done and now() - envelope.Born > 0.8 then
				UIUtil.Tween(scale, 0.15, { Scale = 1.05 }, Enum.EasingStyle.Back)
				bodyStroke.Color = C.Blue
			end
		end)
		ctx.Connect(root.MouseLeave, function()
			if not envelope.Done then
				UIUtil.Tween(scale, 0.15, { Scale = 1 })
				bodyStroke.Color = C.Border
			end
		end)

		-- Clic : on réclame (si encore possible) et on ouvre le mail
		ctx.Connect(root.Activated, function()
			if envelope.Done or not ctx.IsAlive() then
				return
			end
			local position = root.Position
			lastPosition = position
			if mail.SpawnId then
				positions[mail.SpawnId] = position
			end
			if mail.State == "Live" and now() < mail.ExpiresAt then
				claim(mail, "Card")
			end
			ctx.Sound.Play("Mail", 1.4)
			if effectsOn() then
				ctx.Effects.Burst(container, position, C.Blue, 10)
				ctx.Effects.Burst(container, position, nil, 6)
			end
			mail.Read = true
			removeEnvelope(envelope, true)
			refresh()
			task.delay(0.14, function()
				if ctx.IsAlive() then
					openMail(mail, "Card")
				end
			end)
		end)
	end

	-- Mail décidé par le serveur (événement Spawn "Email")
	local function onServerSpawn(info)
		if not ctx.IsAlive() or type(info) ~= "table" or type(info.Id) ~= "string" then
			return
		end
		if bySpawn[info.Id] then
			return
		end
		local lifetime = math.max(2, tonumber(info.Lifetime) or 15)
		local mail = {
			Kind = "Spawn",
			SpawnId = info.Id,
			Email = buildEmail(pick(Locale.Pick(EMAILS), info.Variant)),
			Folder = "Inbox",
			Read = false,
			Starred = false,
			State = "Live",
			Time = now(),
			ExpiresAt = now() + lifetime,
			Estimate = estimateReward(),
		}
		addMail(mail)
		spawnCard(mail, info)
		ctx.Sound.Play("Mail", 1 + random:NextNumber() * 0.15)
		-- Encore là à la fin de sa durée (carte ou non) : trop tard pour le bonus
		task.delay(lifetime, function()
			if ctx.IsAlive() then
				expireMail(mail)
			end
		end)
		if S.Open then
			snack(Locale.T("📩 New mail from %s", mail.Email.Sender), function()
				openMail(mail, "List")
			end, mail)
		end
		refresh(true)
	end

	-- Animation de toutes les cartes (une seule boucle ; rien quand il n'y en a pas)
	ctx.OnRender(function()
		if envelopeCount <= 0 then
			return
		end
		local clock = now()
		for _, envelope in pairs(envelopes) do
			local age = clock - envelope.Born
			local left = envelope.Lifetime - age
			if left <= 0 then
				removeEnvelope(envelope, false)
				if envelope.Rewarded then
					expireMail(envelope.Mail)
				end
			else
				local t = clock + envelope.Phase
				envelope.LifeBar.Size = UDim2.fromScale(math.clamp(left / envelope.Lifetime, 0, 1), 1)
				if envelope.Rewarded and left < HURRY_TIME then
					-- Pressée : elle s'agite, étiquette "Vite !" rouge
					if not envelope.Hurry then
						envelope.Hurry = true
						envelope.Chip.Set(Locale.T("⏰ QUICK, READ ME!"), C.Red)
						envelope.LifeBar.BackgroundColor3 = C.Red
					end
					envelope.Body.Rotation = math.sin(t * 24) * 4
					local pulse = 12 + math.abs(math.sin(t * 10)) * 4
					envelope.Dot.Size = UDim2.fromOffset(pulse, pulse)
				else
					envelope.Body.Rotation = math.sin(t * 2.5) * 1.2
				end
				-- Flotte doucement une fois arrivée
				if age > 0.8 then
					envelope.Root.Position = envelope.Target + UDim2.fromOffset(0, math.sin(t * 2.2) * 4)
				end
			end
		end
	end)

	ctx.OnSpawn("Email", onServerSpawn)

	------------------------------------------------------------------
	-- Mails d'amis reçus (déjà filtrés par le serveur POUR ce joueur)
	------------------------------------------------------------------
	local function serverNow(): number
		local ok, value = pcall(function()
			return workspace:GetServerTimeNow()
		end)
		return (ok and type(value) == "number") and value or os.time()
	end

	local function addFriendMail(info: any): any
		if type(info) ~= "table" or type(info.Id) ~= "string" or FS.Known[info.Id] then
			return nil
		end
		if type(info.From) ~= "number" or FS.Blocked[tostring(info.From)] then
			return nil
		end
		local contact = friendContact(info.From, info.Name, info.Display)
		-- Âge donné par le serveur (sinon : heure du serveur synchronisée)
		local age = tonumber(info.Age)
		if not age or age ~= age then
			age = serverNow() - (tonumber(info.Time) or serverNow())
		end
		age = math.clamp(age, 0, 60 * 86400)
		local mail = {
			Kind = "Friend",
			Friend = true,
			FriendId = info.Id,
			UserId = info.From,
			Email = {
				Tag = makeTag("FRIEND"),
				Avatar = contact.Avatar,
				Image = contact.Image,
				Sender = contact.Name,
				Address = contact.Address,
				Subject = type(info.Subject) == "string" and info.Subject or "",
				Body = type(info.Body) == "string" and info.Body or "",
				Signature = nil,
				Attachment = nil,
				Suspicious = false,
			},
			Contact = contact,
			Folder = "Inbox",
			Read = info.Read == true,
			ReadSent = info.Read == true,
			Starred = false,
			State = "Local", -- jamais de Dopamine
			Time = now() - age,
			Replied = info.Replied == true,
		}
		FS.Known[info.Id] = mail
		addMail(mail)
		return mail
	end

	local function unreadFriendMails(): number
		local count = 0
		for _, mail in ipairs(mails) do
			if mail.Kind == "Friend" and mail.Folder == "Inbox" and not mail.Read then
				count += 1
			end
		end
		return count
	end

	-- Fin du démarrage : un seul petit message pour les mails reçus hors ligne
	local function finishBoot()
		if FS.Booted or not ctx.IsAlive() then
			return
		end
		FS.Booted = true
		local unread = unreadFriendMails()
		if unread == 1 then
			ctx.Notify(Locale.T("💌 A friend sent you a mail!"))
		elseif unread > 1 then
			ctx.Notify(Locale.T("💌 %d friend mails are waiting for you!", unread))
		end
		refresh(unread > 0)
	end

	-- Un mail d'ami arrive (même serveur, autre serveur ou retour de connexion)
	local function onFriendEvent(kind: any, info: any)
		if kind ~= "New" then
			return
		end
		local mail = addFriendMail(info)
		if not mail then
			return
		end
		if not FS.Booted or mail.Read then
			refresh(false)
			return
		end
		ctx.Sound.Play("Mail", 1 + random:NextNumber() * 0.15)
		if S.Open then
			snack(Locale.T("📩 New mail from %s", mail.Contact.Short), function()
				openMail(mail, "List")
			end, mail)
		else
			spawnCard(mail, nil)
		end
		refresh(true)
	end

	task.spawn(function()
		local event = findRemote("FriendMailEvent")
		if not ctx.IsAlive() then
			return
		end
		if event and event:IsA("RemoteEvent") then
			ctx.Connect((event :: RemoteEvent).OnClientEvent, onFriendEvent)
		end
		local ok, result = invokeFriend("Inbox")
		if not ctx.IsAlive() then
			return
		end
		if ok and type(result) == "table" and type(result.Mails) == "table" then
			for _, info in ipairs(result.Mails) do
				addFriendMail(info)
			end
		end
		if ok and type(result) == "table" and result.Loaded == false then
			-- Boîte encore en lecture côté serveur : les mails arrivent juste après
			task.delay(8, finishBoot)
		else
			finishBoot()
		end
	end)

	-- Compte à rebours "⏳ 7:32" (1 fois par seconde, seulement pendant une
	-- rédaction pour un ami, fenêtre ouverte)
	task.spawn(function()
		while ctx.IsAlive() do
			task.wait(1)
			if S.Open and S.View == "Compose" and UI and isFriendDraft(S.Draft) and not S.Sending then
				updateFriendSend()
			end
		end
	end)

	-- Bonus confirmé par le serveur : "+X" (au-dessus de tout) + bandeau du mail
	ctx.OnBonus("Email", function(payload)
		if not ctx.IsAlive() then
			return
		end
		local amount = tonumber(payload.Amount) or 0
		local id = payload.SpawnId
		local mail = type(id) == "string" and bySpawn[id] or nil
		if mail then
			mail.Reward = amount
			mail.State = "Claimed"
		end
		local position = (type(id) == "string" and positions[id]) or lastPosition
		-- Mail affiché dans la fenêtre : le "+X" part de son bandeau de récompense
		local ui = UI
		local interface = ctx.Interface
		if mail and ui and S.Open and S.View == "Message" and S.Selected == mail and interface and interface.GetCanvasCenter then
			local ok, center = pcall(interface.GetCanvasCenter, ui.Msg.Reward.Frame)
			if ok and typeof(center) == "Vector2" then
				position = UDim2.fromOffset(center.X, center.Y)
			end
		end
		local layer = ctx.Effects.GetLayer and ctx.Effects.GetLayer() or nil
		ctx.FloatText(layer or container, position, "+" .. ctx.Format.Format(amount), C.Blue, 40)
		refresh()
	end)

	-- Compteur : ouvre la Réception (ou le brouillon en cours) / ferme
	ctx.Connect(counter.Activated, function()
		if S.Open then
			closeWindow()
			return
		end
		ctx.Sound.Play("Click", 1)
		if not (S.Draft and S.View == "Compose") then
			S.Folder = "Inbox"
			S.Selected = nil
			S.View = "List"
		end
		openWindow()
	end)

	-- Reconstruit la fenêtre (autre mise en page, autre langue) en gardant
	-- la vue, la sélection et le brouillon
	local function rebuildWindow()
		local wasOpen = S.Open
		destroyWindow()
		S.Open = false
		if wasOpen then
			openWindow()
			if S.View == "Message" and S.Selected then
				renderMessage(S.Selected)
				setView("Message")
			end
		end
	end

	-- L'écran change (rotation, fenêtre redimensionnée, autre appareil)
	local function onScreenChanged()
		task.delay(0.2, function()
			if not ctx.IsAlive() then
				return
			end
			placeCounter()
			local ui = UI
			if not ui then
				return
			end
			if ui.Mode ~= currentMode() then
				rebuildWindow()
			else
				fitWindow()
			end
		end)
	end
	if ctx.Interface then
		if ctx.Interface.ScaleChanged then
			ctx.Connect(ctx.Interface.ScaleChanged, onScreenChanged)
		end
		if ctx.Interface.DeviceChanged then
			ctx.Connect(ctx.Interface.DeviceChanged, onScreenChanged)
		end
	end

	-- Langue changée (réglages) : correspondants renommés, fenêtre reconstruite
	languageHandler = function()
		if not ctx.IsAlive() then
			return
		end
		local texts = Locale.Pick(CONTACT_TEXT)
		for _, contact in ipairs(contacts) do
			local t = texts[contact.Id]
			if t then
				contact.Name = t.Name
				contact.Short = t.Short
				contact.Signature = t.Signature
				contact.Address = slug(t.Name) .. Locale.T("@dopamail.com")
			end
		end
		me.Name = Locale.T("Me")
		me.Address = string.lower(player and player.Name or "you") .. Locale.T("@dopamail.com")
		for _, mail in ipairs(mails) do
			if mail.Friend then
				mail.Email.Tag = makeTag("FRIEND")
			end
		end
		refreshCounter(false)
		if UI then
			rebuildWindow()
		end
	end
	if not languageHooked then
		languageHooked = true
		Locale.OnChanged(function()
			local handler = languageHandler
			if handler then
				handler()
			end
		end)
	end
end

function Email.Stop(_ctx)
	-- Cartes, fenêtre et compteur vivent dans ctx.Container
	-- (détruit par le StimulusManager) ; les tâches en attente vérifient ctx.IsAlive()
	languageHandler = nil
end

return Email
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="112">
          <Properties>
            <string name="Name">EmojiRain</string>
            <string name="Source"><![CDATA[--[[
	EmojiRain (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > EmojiRain

	Une pluie d'emojis variée et vivante, en décor derrière tout le reste :
	  - des thèmes qui changent toutes les ~25 s en fondu (fête, amour,
	    miam, espace, animaux, hype, nature, jackpot) ;
	  - plusieurs façons de tomber : balancement, toupie, feuille qui
	    virevolte, rebond sur le bas de l'écran puis disparition ;
	  - de la profondeur : petits emojis pâles et lents au loin, gros et
	    nets devant ;
	  - de temps en temps un emoji "héros" géant avec un halo, et une
	    explosion d'emojis (un gros qui gonfle puis éclate en morceaux).
	Uniquement des TextLabels non cliquables (Active = false) : on ne bloque
	jamais les boutons en dessous. Étiquettes recyclées (35 au maximum),
	beaucoup moins d'emojis si le réglage "Effets" est coupé.
]]

local EmojiRain = {}
EmojiRain.Slot = "Overlay"

local POOL_SIZE = 34 -- + 1 halo = 35 étiquettes au total
local MAX_ACTIVE = 26
local MAX_ACTIVE_LOW = 9 -- réglage "Effets" désactivé
local SPAWN_INTERVAL = 0.28
local SPAWN_INTERVAL_LOW = 0.95
local THEME_BLEND = 4 -- durée du fondu entre deux thèmes (s)
local DESIGN_H = 720 -- hauteur de la toile "design"
local GRAVITY = 1.5 -- (hauteur d'écran / s²) pour les rebonds et les éclats

local THEMES = {
	{ Emojis = { "🎉", "🥳", "🎊", "🎈", "✨", "🎁", "🍾" }, Hero = { "🥳", "🎉", "🎁" }, Glow = Color3.fromRGB(255, 214, 90) },
	{ Emojis = { "💖", "😍", "💕", "💘", "😘", "🌹", "💝" }, Hero = { "💖", "😍" }, Glow = Color3.fromRGB(255, 120, 176) },
	{ Emojis = { "🍕", "🍩", "🍔", "🍟", "🍓", "🧁", "🍪", "🍿" }, Hero = { "🍩", "🍕", "🍔" }, Glow = Color3.fromRGB(255, 172, 90) },
	{ Emojis = { "🚀", "⭐", "🌙", "👽", "🌍", "🛸", "💫", "🌟" }, Hero = { "🚀", "🛸", "🌍" }, Glow = Color3.fromRGB(140, 160, 255) },
	{ Emojis = { "🐶", "🐱", "🦊", "🐼", "🐸", "🐧", "🦄", "🐥" }, Hero = { "🦄", "🐼", "🐶" }, Glow = Color3.fromRGB(150, 226, 140) },
	{ Emojis = { "🔥", "💯", "🤯", "😂", "💀", "👀", "🤩", "😎" }, Hero = { "🔥", "💯", "🤯" }, Glow = Color3.fromRGB(255, 132, 60) },
	{ Emojis = { "🌸", "🍀", "🌈", "🌻", "🍁", "🌷", "🦋" }, Hero = { "🌈", "🦋", "🌻" }, Glow = Color3.fromRGB(140, 224, 176) },
	{ Emojis = { "💰", "💎", "🤑", "👑", "💵", "⭐" }, Hero = { "💎", "👑", "💰" }, Glow = Color3.fromRGB(255, 220, 60) },
}

-- Couches de profondeur : loin (petit, pâle, lent) -> près (gros, net, rapide)
local LAYERS = {
	{ Chance = 0.4, MinSize = 15, MaxSize = 22, Transparency = { 0.55, 0.7 }, Speed = { 0.045, 0.065 }, ZIndex = 1 },
	{ Chance = 0.35, MinSize = 25, MaxSize = 33, Transparency = { 0.3, 0.45 }, Speed = { 0.075, 0.1 }, ZIndex = 2 },
	{ Chance = 0.25, MinSize = 38, MaxSize = 50, Transparency = { 0.15, 0.28 }, Speed = { 0.11, 0.15 }, ZIndex = 3 },
}

-- Façons de tomber (probabilités cumulées plus bas)
local STYLES = {
	{ Name = "Sway", Weight = 0.38 },
	{ Name = "Spin", Weight = 0.2 },
	{ Name = "Flutter", Weight = 0.22 },
	{ Name = "Bounce", Weight = 0.2 },
}

function EmojiRain.Start(ctx)
	local container: Frame = ctx.Container
	-- Tout en dessous des autres stimuli du calque (notifications, mails...) :
	-- la pluie reste un décor et ne recouvre jamais un élément à lire / cliquer
	container.ZIndex = 0
	local UIUtil = ctx.UIUtil
	local random = Random.new()

	local pool: { any } = {}
	local activeCount = 0
	local spawnTimer = 0
	local clock = 0

	local themeIndex = random:NextInteger(1, #THEMES)
	local previousTheme = themeIndex
	local themeAge = THEME_BLEND -- pas de fondu au démarrage
	local themeDuration = random:NextNumber(20, 28)
	local burstTimer = random:NextNumber(6, 10)
	local heroTimer = random:NextNumber(8, 14)
	local heroDrop: any = nil -- l'emoji héros actuel (un seul à la fois)
	local rushLeft = 0 -- petite averse au changement de thème

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	-- Halo derrière l'emoji héros (une étiquette ronde sans texte)
	local glow = UIUtil.Create("TextLabel", {
		Name = "HeroGlow",
		Text = "",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = THEMES[themeIndex].Glow,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		Selectable = false,
		Visible = false,
		ZIndex = 4,
		Parent = container,
	})
	UIUtil.Corner(glow, UDim.new(1, 0))
	local glowStroke = UIUtil.Stroke(glow, THEMES[themeIndex].Glow, 8, 1)

	-- Crée toutes les étiquettes une fois pour toutes
	for _ = 1, POOL_SIZE do
		local label = UIUtil.Create("TextLabel", {
			Name = "Emoji",
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Font = ctx.Theme.Fonts.Body,
			Text = "",
			TextScaled = false,
			Active = false,
			Selectable = false,
			Visible = false,
			ZIndex = 1,
			Parent = container,
		})
		table.insert(pool, { Label = label, Active = false })
	end

	local function acquire()
		for _, drop in ipairs(pool) do
			if not drop.Active then
				return drop
			end
		end
		return nil
	end

	local function release(drop)
		if drop.Active then
			drop.Active = false
			activeCount -= 1
		end
		drop.Label.Visible = false
		if drop == heroDrop then
			heroDrop = nil
			glow.Visible = false
		end
	end

	-- Thème du moment (pendant le fondu : mélange avec l'ancien)
	local function currentTheme()
		if themeAge < THEME_BLEND and random:NextNumber() > themeAge / THEME_BLEND then
			return THEMES[previousTheme]
		end
		return THEMES[themeIndex]
	end

	local function pick(list: { string }): string
		return list[random:NextInteger(1, #list)]
	end

	local function setSize(drop, size: number)
		drop.Size = size
		drop.Label.TextSize = size
		drop.Label.Size = UDim2.fromOffset(size * 1.3, size * 1.3)
	end

	-- Prépare une goutte commune à tous les styles
	local function activate(drop, text: string, size: number, transparency: number, zIndex: number)
		local label: TextLabel = drop.Label
		label.Text = text
		label.TextTransparency = transparency
		label.ZIndex = zIndex
		label.Rotation = 0
		label.Visible = true
		setSize(drop, size)
		drop.Active = true
		drop.Alpha = transparency
		drop.Age = 0
		drop.Rot = 0
		drop.Spin = 0
		drop.VX = 0
		drop.VY = 0
		drop.Bounces = 0
		drop.Fade = -1 -- < 0 : pas encore en train de disparaître
		activeCount += 1
	end

	-- Une goutte "normale" qui tombe du haut
	local function spawnDrop()
		local drop = acquire()
		if not drop then
			return
		end
		local roll = random:NextNumber()
		local layer = LAYERS[#LAYERS]
		local acc = 0
		for _, candidate in ipairs(LAYERS) do
			acc += candidate.Chance
			if roll <= acc then
				layer = candidate
				break
			end
		end
		local styleRoll = random:NextNumber()
		local style = "Sway"
		acc = 0
		for _, candidate in ipairs(STYLES) do
			acc += candidate.Weight
			if styleRoll <= acc then
				style = candidate.Name
				break
			end
		end

		local size = random:NextInteger(layer.MinSize, layer.MaxSize)
		activate(drop, pick(currentTheme().Emojis), size, random:NextNumber(layer.Transparency[1], layer.Transparency[2]), layer.ZIndex)
		drop.Style = style
		drop.BaseX = random:NextNumber(0.02, 0.98)
		drop.X = drop.BaseX
		drop.Y = -0.06
		drop.Speed = random:NextNumber(layer.Speed[1], layer.Speed[2])
		drop.Phase = random:NextNumber(0, math.pi * 2)
		drop.SwayAmp = random:NextNumber(0.006, 0.02)
		drop.SwayFreq = random:NextNumber(1, 2.2)
		drop.Rot = random:NextNumber(-25, 25)

		if style == "Spin" then
			drop.Speed *= 1.25
			drop.Spin = random:NextNumber(140, 280) * ((random:NextNumber() < 0.5) and -1 or 1)
		elseif style == "Flutter" then
			drop.Speed *= 0.75
			drop.SwayAmp = random:NextNumber(0.025, 0.05)
			drop.SwayFreq = random:NextNumber(0.9, 1.5)
		elseif style == "Bounce" then
			drop.VY = drop.Speed
			drop.VX = random:NextNumber(-0.03, 0.03)
			drop.Spin = random:NextNumber(-90, 90)
		end
	end

	-- Emoji héros : géant, lent, avec un halo qui pulse
	local function spawnHero()
		local drop = acquire()
		if not drop then
			return
		end
		local theme = THEMES[themeIndex]
		activate(drop, pick(theme.Hero), random:NextInteger(64, 78), 0.15, 5)
		drop.Style = "Hero"
		drop.BaseX = random:NextNumber(0.08, 0.92)
		drop.X = drop.BaseX
		drop.Y = -0.12
		drop.Speed = random:NextNumber(0.06, 0.075)
		drop.Phase = random:NextNumber(0, math.pi * 2)
		drop.SwayAmp = 0.025
		drop.SwayFreq = 0.8
		heroDrop = drop
		glow.BackgroundColor3 = theme.Glow
		glowStroke.Color = theme.Glow
		glow.Visible = true
	end

	-- Explosion : un gros emoji gonfle puis éclate en morceaux
	local function spawnBurst()
		local drop = acquire()
		if not drop then
			return
		end
		activate(drop, pick(THEMES[themeIndex].Hero), 1, 0.05, 5)
		drop.Style = "Burst"
		drop.X = random:NextNumber(0.1, 0.9)
		drop.Y = random:NextNumber(0.18, 0.5)
		drop.Spin = random:NextNumber(-40, 40)
	end

	local function explode(x: number, y: number)
		local theme = THEMES[themeIndex]
		local pieces = random:NextInteger(6, 8)
		for i = 1, pieces do
			local drop = acquire()
			if not drop then
				return
			end
			activate(drop, pick(theme.Emojis), random:NextInteger(22, 36), 0.1, 4)
			drop.Style = "Piece"
			drop.X, drop.Y = x, y
			local angle = (i / pieces) * math.pi * 2 + random:NextNumber(-0.3, 0.3)
			local power = random:NextNumber(0.25, 0.45)
			-- Toile 16:9 : l'écart horizontal est "écrasé" pour rester rond
			drop.VX = math.cos(angle) * power * 0.5625
			drop.VY = math.sin(angle) * power - 0.25
			drop.Spin = random:NextNumber(-300, 300)
			drop.Life = random:NextNumber(0.9, 1.3)
		end
	end

	ctx.OnRender(function(rawDt: number)
		local dt = math.min(rawDt, 0.1)
		clock += dt
		local fx = effectsOn()

		-- Changement de thème (en fondu) + petite averse
		themeAge += dt
		if themeAge >= themeDuration then
			previousTheme = themeIndex
			local nextTheme = random:NextInteger(1, #THEMES - 1)
			if nextTheme >= themeIndex then
				nextTheme += 1
			end
			themeIndex = nextTheme
			themeAge = 0
			themeDuration = random:NextNumber(20, 28)
			rushLeft = fx and 6 or 0
		end

		-- Nouvelles gouttes
		local limit = fx and MAX_ACTIVE or MAX_ACTIVE_LOW
		spawnTimer -= dt
		if spawnTimer <= 0 then
			if rushLeft > 0 then
				rushLeft -= 1
				spawnTimer = 0.08
			else
				spawnTimer = (fx and SPAWN_INTERVAL or SPAWN_INTERVAL_LOW) * random:NextNumber(0.7, 1.3)
			end
			if activeCount < limit then
				spawnDrop()
			end
		end

		heroTimer -= dt
		if heroTimer <= 0 then
			heroTimer = random:NextNumber(10, 18) * (fx and 1 or 2)
			if not heroDrop and activeCount < limit then
				spawnHero()
			end
		end

		if fx then
			burstTimer -= dt
			if burstTimer <= 0 then
				burstTimer = random:NextNumber(9, 16)
				if activeCount <= POOL_SIZE - 9 then
					spawnBurst()
				end
			end
		end

		-- Petit vent qui change lentement de sens
		local wind = math.sin(clock * 0.23) * 0.012

		for _, drop in ipairs(pool) do
			if drop.Active then
				drop.Age += dt
				local label: TextLabel = drop.Label
				local style = drop.Style
				local x, y = drop.X, drop.Y
				local rotation = drop.Rot
				local transparency = drop.Alpha
				local remove = false
				local burstAt: Vector2? = nil

				if style == "Sway" or style == "Hero" then
					drop.Y += drop.Speed * dt
					drop.BaseX += wind * dt
					local wave = math.sin(clock * drop.SwayFreq + drop.Phase)
					x = drop.BaseX + wave * drop.SwayAmp
					y = drop.Y
					rotation = drop.Rot + wave * 14
					remove = y > 1.12
				elseif style == "Spin" then
					drop.Y += drop.Speed * dt
					drop.BaseX += wind * 1.4 * dt
					drop.Rot += drop.Spin * dt
					x = drop.BaseX + math.sin(clock * drop.SwayFreq + drop.Phase) * drop.SwayAmp * 0.5
					y = drop.Y
					rotation = drop.Rot
					remove = y > 1.1
				elseif style == "Flutter" then
					-- Feuille : zigzag large, penche dans le sens où elle glisse
					drop.Y += drop.Speed * dt * (0.75 + 0.25 * math.abs(math.cos(clock * drop.SwayFreq + drop.Phase)))
					drop.BaseX += wind * 1.8 * dt
					local wave = math.sin(clock * drop.SwayFreq + drop.Phase)
					x = drop.BaseX + wave * drop.SwayAmp
					y = drop.Y
					rotation = math.cos(clock * drop.SwayFreq + drop.Phase) * 38
					remove = y > 1.1
				elseif style == "Bounce" then
					-- Tombe, rebondit sur le bas de l'écran puis s'efface
					local floorY = 1 - (drop.Size * 0.5) / DESIGN_H
					if drop.Fade < 0 then
						drop.VY += GRAVITY * 0.35 * dt
						drop.Y += drop.VY * dt
						drop.X += (drop.VX + wind) * dt
						drop.Rot += drop.Spin * dt
						if drop.Y >= floorY and drop.VY > 0 then
							drop.Y = floorY
							drop.Bounces += 1
							drop.VY = -drop.VY * 0.5
							drop.Spin = -drop.Spin * 0.7
							if drop.Bounces >= 2 or math.abs(drop.VY) < 0.03 then
								drop.Fade = 0
							end
						end
					else
						-- Au sol : glisse un peu, s'aplatit et disparaît
						drop.Fade += dt
						drop.X += drop.VX * dt * 0.5
						drop.Y = floorY
						local t = math.clamp(drop.Fade / 0.6, 0, 1)
						transparency = drop.Alpha + (1 - drop.Alpha) * t
						remove = t >= 1
					end
					x, y = drop.X, drop.Y
					rotation = drop.Rot
				elseif style == "Burst" then
					-- Gonfle (avec rebond), tremble, puis éclate
					local age = drop.Age
					local grow = math.clamp(age / 0.35, 0, 1)
					local overshoot = 1 + math.sin(grow * math.pi) * 0.25
					local size = 60 * grow * overshoot
					if age > 0.55 then
						size = 60 * (1 + (age - 0.55) * 1.8)
						x = drop.X + random:NextNumber(-0.002, 0.002)
						y = drop.Y + random:NextNumber(-0.003, 0.003)
					end
					setSize(drop, math.max(1, size))
					rotation = math.sin(age * 30) * 8 * math.clamp((age - 0.4) * 4, 0, 1)
					if age > 0.8 then
						remove = true
						burstAt = Vector2.new(drop.X, drop.Y)
					end
				elseif style == "Piece" then
					drop.VY += GRAVITY * dt
					drop.X += drop.VX * dt
					drop.Y += drop.VY * dt
					drop.Rot += drop.Spin * dt
					x, y = drop.X, drop.Y
					rotation = drop.Rot
					local t = math.clamp(drop.Age / drop.Life, 0, 1)
					transparency = drop.Alpha + (1 - drop.Alpha) * t * t
					remove = t >= 1 or y > 1.1
				end

				if x < -0.08 or x > 1.08 then
					remove = true
				end

				if remove then
					release(drop)
					if burstAt then
						explode(burstAt.X, burstAt.Y) -- après la libération : l'étiquette peut servir d'éclat
					end
				else
					label.Position = UDim2.fromScale(x, y)
					label.Rotation = rotation
					label.TextTransparency = transparency
					if drop == heroDrop then
						local pulse = 1 + math.sin(clock * 3) * 0.08
						local glowSize = drop.Size * 1.5 * pulse
						glow.Position = label.Position
						glow.Size = UDim2.fromOffset(glowSize, glowSize)
						glow.BackgroundTransparency = 0.72 + math.sin(clock * 3) * 0.06
						glowStroke.Transparency = 0.8
					end
				end
			end
		end
	end)
end

function EmojiRain.Stop(_ctx)
	-- Les étiquettes sont dans ctx.Container (détruit par le StimulusManager)
end

return EmojiRain
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="113">
          <Properties>
            <string name="Name">Finger</string>
            <string name="Source"><![CDATA[--[[
	Finger (ModuleScript - stimulus) — amélioration "Doigt musclé" (15 niveaux)
	Emplacement : ReplicatedStorage > Client > Stimuli > Finger

	Une petite main kawaii posée juste à côté du gros bouton (placée par
	Gear/GearLayout dans l'espace libre, jamais sur le compteur, les pastilles
	ou une carte). Elle vise le bouton et le TAPE à chaque clic : le bout du
	doigt vient toucher le bord du bouton (étoile d'impact + traits de vitesse).
	Chaque niveau la rend plus musclée et plus stylée (voir Gear/HandArt :
	joues, plis, bandeau éponge, bague, vernis, muscles, sueur, diamant,
	veines, bandeau doré, aura, lunettes...). Niveau 15 : de temps en temps
	elle "flexe" fièrement (et tous les 12 clics).
	Aucune animation au repos, sauf un petit geste toutes les 5 à 9 s.
]]

local Gear = script.Parent:WaitForChild("Gear")
local GearKit = require(Gear:WaitForChild("GearKit"))
local GearPiece = require(Gear:WaitForChild("GearPiece"))
local HandArt = require(Gear:WaitForChild("HandArt"))

local Finger = {}
Finger.Slot = "Background" -- sous l'interface (effets de clic : calque Overlay)

local FOOTPRINT = 90
local TOUCH_RANGE = 46 -- au-delà (en px), le doigt fait juste un petit "coup" dans le vide

local active: { [any]: any } = {}

function Finger.Start(ctx)
	local animator = GearKit.Animator(ctx)
	local piece = GearPiece.new(ctx, {
		Id = "Finger",
		Size = Vector2.new(FOOTPRINT, FOOTPRINT),
		Priority = 1,
		MinScale = 0.42,
		MaxScale = 1,
		Near = 60,
		GlowColor = Color3.fromRGB(255, 236, 214),
		ContainerZ = 1107,
		Anchor = function(button, _canvas)
			-- À gauche du bouton, un peu plus bas : le doigt vise vers le haut / la droite
			return Vector2.new(button.X0 - 50, (button.Y0 + button.Y1) / 2 + 6)
		end,
	}, animator)
	active[ctx] = piece

	-- Cadre qui vise le bouton (tourné) ; la main est dessinée dedans
	local aim = Instance.new("Frame")
	aim.Name = "Aim"
	aim.BackgroundTransparency = 1
	aim.AnchorPoint = Vector2.new(0.5, 0.5)
	aim.Position = UDim2.fromScale(0.5, 0.5)
	aim.Size = UDim2.fromOffset(FOOTPRINT, FOOTPRINT)
	aim.ZIndex = 3
	aim.Parent = piece.Content

	-- Traits de vitesse (derrière la main, le long de l'axe du doigt)
	local speedLines = {}
	for index = 1, 3 do
		local line = GearKit.Box(aim, 0, 0, 2.5, 16, Color3.fromRGB(255, 255, 255), {
			Name = "Speed",
			Anchor = Vector2.new(0.5, 0.5),
			Radius = "round",
			Z = 1,
			Visible = false,
		})
		line.Position = UDim2.fromOffset(FOOTPRINT / 2 + (index - 2) * 22, FOOTPRINT / 2 + 34 + math.abs(index - 2) * -6)
		table.insert(speedLines, line)
	end

	local hand: HandArt.Hand
	local aimAngle = 0
	local dir = Vector2.new(0, -1)
	local reach = 12
	local touching = false
	local lastTap = 0
	local taps = 0

	-- Impact (sur la toile) : étoile + anneau, réutilisés
	local impact = GearKit.Star(piece.FX, 0, 0, 22, Color3.fromRGB(255, 236, 120), 20)
	impact.Visible = false
	local ring = Instance.new("Frame")
	ring.Name = "ImpactRing"
	ring.AnchorPoint = Vector2.new(0.5, 0.5)
	ring.BackgroundTransparency = 1
	ring.ZIndex = 19
	ring.Visible = false
	local ringCorner = Instance.new("UICorner")
	ringCorner.CornerRadius = UDim.new(0.5, 0)
	ringCorner.Parent = ring
	local ringStroke = Instance.new("UIStroke")
	ringStroke.Color = Color3.fromRGB(255, 255, 255)
	ringStroke.Thickness = 2
	ringStroke.Parent = ring
	ring.Parent = piece.FX

	local dropBase: { [Frame]: UDim2 } = {}

	local function buildHand(level: number)
		if hand then
			animator:Stop("tap", true)
			animator:Stop("flex", true)
			animator:Stop("drops")
			hand.Root:Destroy()
		end
		hand = HandArt.Build(aim, { Level = level })
		if hand.Face then
			hand.Face.Rotation = -aimAngle
		end
		table.clear(dropBase)
		for _, drop in ipairs(hand.Drops) do
			dropBase[drop] = drop.Position
		end
	end
	buildHand(math.max(1, piece.Level))

	-- Vise le bouton depuis la place donnée par la mise en page
	local function aimAt(placement)
		local reachCanvas
		aimAngle, dir, reachCanvas, touching = HandArt.Aim(placement, hand and hand.ArtScale.Scale or 1, TOUCH_RANGE)
		aim.Rotation = aimAngle
		if hand and hand.Face then
			hand.Face.Rotation = -aimAngle
		end
		reach = reachCanvas / math.max(placement.Scale, 0.05)
	end

	piece.OnPlaced = function(placement, _first)
		aimAt(placement)
	end

	piece.OnLevel = function(level, _previous)
		buildHand(level)
		local placement = piece.Placement
		if placement then
			aimAt(placement)
		end
	end

	-- Pose "flex" (niveau 15) : la main gonfle fièrement, étincelles
	local function flex()
		if not piece:IsShown() or not hand then
			return
		end
		local base = HandArt.Features(piece.Level).Scale
		local artScale = hand.ArtScale
		animator:Play("flex", 0.9, function(t)
			artScale.Scale = base * (1 + 0.16 * GearKit.Bump(math.min(1, t * 1.6)))
			aim.Rotation = aimAngle + math.sin(t * math.pi * 3) * 7 * (1 - t)
		end, function()
			artScale.Scale = base
			aim.Rotation = aimAngle
		end)
		piece:Celebrate()
	end

	-- Le TAP : le doigt frappe le bouton puis revient
	local function tap()
		if not piece:IsShown() or not hand then
			return
		end
		lastTap = os.clock()
		taps += 1
		local placement = piece.Placement :: any
		local level = piece.Level
		local strikeEnd, holdEnd = 0.28, 0.42
		local showLines = level >= 2 and GearKit.EffectsOn(ctx)
		animator:Play("tap", 0.2, function(t)
			local offset
			if t < strikeEnd then
				offset = GearKit.Ease.InQuad(t / strikeEnd)
			elseif t < holdEnd then
				offset = 1
			else
				offset = 1 - GearKit.Ease.OutQuad((t - holdEnd) / (1 - holdEnd))
			end
			local d = dir * reach * offset
			-- (le cadre est tourné : on déplace dans le repère de la toile, pas du cadre)
			aim.Position = UDim2.new(0.5, d.X, 0.5, d.Y)
			HandArt.Squash(hand, (touching and t >= strikeEnd * 0.9 and t < holdEnd + 0.12) and 1 or 0)
			for _, line in ipairs(speedLines) do
				line.Visible = showLines and t < holdEnd
				line.BackgroundTransparency = 0.25 + 0.6 * math.min(1, t / holdEnd)
			end
		end, function()
			aim.Position = UDim2.fromScale(0.5, 0.5)
			HandArt.Squash(hand, 0)
			for _, line in ipairs(speedLines) do
				line.Visible = false
			end
		end)

		-- Impact au bout du doigt
		if GearKit.EffectsOn(ctx) then
			local center = Vector2.new(placement.CX, placement.CY)
			local tipDistance = (HandArt.Size / 2 - HandArt.TipY) * hand.ArtScale.Scale * placement.Scale
			local hit = center + dir * (tipDistance + reach * placement.Scale)
			local big = level >= 10
			local color = level >= 12 and Color3.fromRGB(255, 205, 60) or Color3.fromRGB(255, 240, 150)
			animator:Play("impact", 0.3, function(t)
				local k = math.clamp((t - 0.18) / 0.82, 0, 1)
				local visible = t >= 0.18 and k < 1
				impact.Visible = visible
				ring.Visible = visible and (touching or big)
				if not visible then
					return
				end
				local s = (big and 30 or 22) * (0.5 + 0.8 * GearKit.Ease.OutQuad(k))
				impact.Position = UDim2.fromOffset(hit.X, hit.Y)
				impact.Size = UDim2.fromOffset(s * (1 - k * 0.4), s * (1 - k * 0.4))
				impact.Rotation = 45 * k
				for _, arm in ipairs(impact:GetChildren()) do
					if arm:IsA("Frame") then
						arm.BackgroundColor3 = color
						arm.BackgroundTransparency = k
					end
				end
				local r = 10 + 30 * GearKit.Ease.OutQuad(k)
				ring.Position = UDim2.fromOffset(hit.X, hit.Y)
				ring.Size = UDim2.fromOffset(r, r)
				ringStroke.Transparency = 0.2 + 0.8 * k
				ringStroke.Color = color
			end, function()
				impact.Visible = false
				ring.Visible = false
			end)
		end

		-- Gouttes de sueur qui sautillent
		if #hand.Drops > 0 then
			local drops = hand.Drops
			animator:Play("drops", 0.35, function(t)
				for index, drop in ipairs(drops) do
					local base = dropBase[drop]
					if base then
						drop.Position = base - UDim2.fromOffset(0, GearKit.Bump(t) * (3 + index))
					end
				end
			end)
		end

		if level >= 15 and taps % 12 == 0 then
			task.delay(0.22, flex)
		end
	end

	ctx.Connect(ctx.State.Clicked, function()
		if ctx.IsVisible() then
			tap()
		end
	end)

	-- Petite vie au repos : un geste de temps en temps (seulement si on ne clique pas)
	GearKit.Every(ctx, 5, 9, function()
		if not piece:IsShown() or os.clock() - lastTap < 2.5 then
			return
		end
		if piece.Level >= 15 then
			flex()
		else
			animator:Play("wiggle", 0.6, function(t)
				aim.Rotation = aimAngle + math.sin(t * math.pi * 2) * 8 * (1 - t)
			end, function()
				aim.Rotation = aimAngle
			end)
		end
	end)
end

function Finger.Stop(ctx)
	local piece = active[ctx]
	active[ctx] = nil
	if piece then
		piece:Destroy()
	end
end

return Finger
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="114">
          <Properties>
            <string name="Name">GalaxyStream</string>
            <string name="Source"><![CDATA[--[[
	GalaxyStream (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > GalaxyStream

	🌠 Rivière galactique (+/s, 10 niveaux, après 5 visites à l'océan) : une
	rivière d'étoiles traverse le fond de l'écran : un voile lumineux violet
	/ rose avec un courant plus clair au milieu, et des étoiles qui coulent le
	long du courant, scintillent et se recyclent au bout.
	Le tracé est choisi parmi plusieurs courbes (diagonales, arches, S) : celle
	qui passe le plus dans le fond VISIBLE (Cosmos/Zones.PickPath : ni cartes,
	ni colonne, ni objets posés), recalculé quand la mise en page change.
	Chaque niveau rend la rivière plus dense et plus lumineuse :
	  - étoiles : 10 + 3 par niveau (40 au niveau 10), voile plus large ;
	  - niveau 4+ : éclats dorés ; niveau 7+ : étoiles filantes le long du
	    courant ; niveau 10 : courant central doré.
	Effet d'ambiance (sous les cartes). ≤ 15 images/s, particules recyclées.
]]

local Cosmos = script.Parent:WaitForChild("Cosmos")
local Kit = require(Cosmos:WaitForChild("Kit"))
local Zones = require(Cosmos:WaitForChild("Zones"))

local GalaxyStream = {}
GalaxyStream.Slot = "Background"

local ID = "GalaxyStream"
local MAX_LEVEL = 10
local SAMPLES = 48 -- points du chemin (précalculés)
local BAND_SEGMENTS = 6

-- Tracés possibles (4 points de contrôle, fractions de la toile)
local ROUTES = {
	{ Vector2.new(-0.06, 0.97), Vector2.new(0.3, 0.8), Vector2.new(0.62, 0.62), Vector2.new(1.06, 0.2) }, -- bas-gauche -> haut-droite
	{ Vector2.new(-0.06, 0.2), Vector2.new(0.38, 0.42), Vector2.new(0.62, 0.74), Vector2.new(1.06, 0.98) }, -- haut-gauche -> bas-droite
	{ Vector2.new(0.24, -0.06), Vector2.new(0.2, 0.62), Vector2.new(0.8, 0.42), Vector2.new(0.76, 1.06) }, -- S (couloir gauche, gouttière droite)
	{ Vector2.new(0.76, -0.06), Vector2.new(0.8, 0.62), Vector2.new(0.2, 0.42), Vector2.new(0.24, 1.06) }, -- S miroir
	{ Vector2.new(-0.06, 0.6), Vector2.new(0.3, 1.1), Vector2.new(0.7, 1.1), Vector2.new(1.06, 0.6) }, -- arche basse
}

local STAR_COLORS_DARK = {
	Color3.fromRGB(255, 255, 255),
	Color3.fromRGB(200, 224, 255),
	Color3.fromRGB(255, 200, 240),
	Color3.fromRGB(200, 180, 255),
}
local STAR_COLORS_LIGHT = {
	Color3.fromRGB(120, 80, 230),
	Color3.fromRGB(60, 120, 230),
	Color3.fromRGB(230, 80, 170),
	Color3.fromRGB(150, 90, 240),
}

local function starCount(level: number): number
	return 10 + 3 * level
end

function GalaxyStream.Start(ctx)
	Zones.Attach(ctx)
	local random = Random.new()
	local effects = Kit.Effects(ctx)
	local level = math.clamp(ctx.GetLevel(ID), 1, MAX_LEVEL)
	local dark = Kit.IsDark(ctx)
	local container: Frame = ctx.Container

	local root: Frame? = nil
	local route = 1
	local points: { Vector2 } = {}
	local normals: { Vector2 } = {}
	type Star = { Frame: Frame, U: number, Lane: number, Speed: number, Phase: number, Twinkle: boolean }
	local stars: { Star } = {}
	local streak: Frame? = nil
	local streakU = -1

	local function width(): number
		return 64 + level * 5
	end

	-- Chemin en pixels (toile) + normales
	local function computePath()
		local canvas = Zones.GetCanvas()
		table.clear(points)
		table.clear(normals)
		local controls = ROUTES[route]
		for index = 0, SAMPLES do
			local p = Zones.Bezier(controls, index / SAMPLES)
			points[index + 1] = Vector2.new(p.X * canvas.X, p.Y * canvas.Y)
		end
		for index = 1, #points do
			local a = points[math.max(1, index - 1)]
			local b = points[math.min(#points, index + 1)]
			local d = (b - a).Unit
			normals[index] = Vector2.new(-d.Y, d.X)
		end
	end

	-- Point du chemin (u de 0 à 1) + normale
	local function pathAt(u: number): (Vector2, Vector2)
		local f = math.clamp(u, 0, 1) * SAMPLES
		local i = math.floor(f)
		local k = f - i
		local a, b = points[i + 1], points[math.min(#points, i + 2)]
		return a:Lerp(b, k), normals[math.min(#normals, i + 1)]
	end

	local function build()
		if root then
			root:Destroy()
		end
		table.clear(stars)
		streak = nil
		computePath()
		local holder = Kit.Box(container, { Name = "GalaxyStream", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 })
		root = holder

		-- Voile de la rivière + courant central : segments le long de la courbe
		local edge = if dark then Kit.Rgb(160, 110, 255) else Kit.Rgb(140, 100, 240)
		local other = if dark then Kit.Rgb(255, 130, 210) else Kit.Rgb(236, 110, 196)
		local core = (if dark then 0.6 else 0.66) - level * 0.012
		local fade = Kit.Fade({ 0, 1, 0.3, core + 0.16, 0.5, core, 0.7, core + 0.16, 1, 1 })
		local coreColor = if level >= 10 then Kit.Rgb(255, 222, 140) elseif dark then Kit.Rgb(240, 230, 255) else Kit.Rgb(255, 255, 255)
		local w = width()
		for s = 1, BAND_SEGMENTS do
			local a = pathAt((s - 1) / BAND_SEGMENTS)
			local b = pathAt(s / BAND_SEGMENTS)
			local delta = b - a
			local centre = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
			local rotation = math.deg(math.atan2(delta.Y, delta.X))
			local segment = Kit.Box(holder, {
				Name = "Band",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = centre,
				Size = UDim2.fromOffset(delta.Magnitude + w * 0.5, w),
				Rotation = rotation,
				Color = Color3.new(1, 1, 1),
				ZIndex = 1,
			})
			Kit.Gradient(segment, ColorSequence.new(edge, other), fade, 90)
			Kit.Box(holder, {
				Name = "Current",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = centre,
				Size = UDim2.fromOffset(delta.Magnitude + 8, 6),
				Rotation = rotation,
				Color = coreColor,
				Alpha = math.clamp((if dark then 0.72 else 0.6) - level * 0.02, 0.4, 0.8),
				ZIndex = 2,
			})
		end

		-- Étoiles qui coulent
		local palette = if dark then STAR_COLORS_DARK else STAR_COLORS_LIGHT
		for index = 1, starCount(level) do
			local gold = level >= 4 and index % 6 == 0
			local size = if gold then 7 elseif index % 4 == 0 then 5 else random:NextInteger(3, 4)
			local frame = Kit.Box(holder, {
				Name = "Star",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(size, size),
				Rotation = 45,
				Color = if gold then Kit.Rgb(255, 204, 90) else palette[(index - 1) % #palette + 1],
				ZIndex = 3,
			})
			table.insert(stars, {
				Frame = frame,
				U = random:NextNumber(),
				Lane = random:NextNumber(-1, 1) * random:NextNumber(0.15, 1),
				Speed = random:NextNumber(0.02, 0.045),
				Phase = random:NextNumber(0, 6),
				Twinkle = index % 2 == 0,
			})
		end

		-- Étoile filante (niveau 7+)
		if level >= 7 then
			local line = Kit.Box(holder, {
				Name = "ShootingStar",
				AnchorPoint = Vector2.new(1, 0.5),
				Size = UDim2.fromOffset(52, 3),
				Color = if dark then Color3.new(1, 1, 1) else Kit.Rgb(255, 196, 80),
				Alpha = 1,
				ZIndex = 4,
			})
			Kit.Gradient(line, nil, Kit.Fade({ 0, 1, 1, 0 }), 0)
			streak = line
		end
	end

	-- Choisit le tracé le plus visible (après chaque planification des places)
	local function pickRoute(force: boolean?)
		local best = Zones.PickPath(ROUTES, width())
		if best ~= route or force then
			route = best
			build()
		end
	end

	build()
	Kit.WatchLevel(ctx, ID, function(newLevel)
		level = math.clamp(newLevel, 1, MAX_LEVEL)
		build()
	end)
	Kit.WatchTheme(ctx, function(isDark)
		dark = isDark
		build()
	end)
	local lastCanvas = Zones.GetCanvas()
	ctx.Connect(Zones.Changed, function()
		local now = Zones.GetCanvas()
		local resized = (now - lastCanvas).Magnitude > 1
		lastCanvas = now
		pickRoute(resized)
	end)
	-- Pas encore d'objet cosmique à placer : planification quand même (pour le tracé)
	Zones.Schedule()

	Kit.Loop(ctx, 15, function(dt, t)
		local half = width() / 2 - 6
		local count = if effects then #stars else math.floor(#stars / 2)
		for index = 1, count do
			local star = stars[index]
			star.U += dt * star.Speed
			if star.U > 1 then
				star.U -= 1
			end
			local p, n = pathAt(star.U)
			local sway = math.sin(t * 0.7 + star.Phase) * 0.12
			local position = p + n * ((star.Lane + sway) * half)
			star.Frame.Position = UDim2.fromOffset(position.X, position.Y)
			if star.Twinkle then
				star.Frame.BackgroundTransparency = 0.05 + 0.6 * (0.5 + 0.5 * math.sin(t * 2.6 + star.Phase))
			end
		end
		local line = streak
		if line and effects then
			if streakU < 0 then
				if random:NextNumber() < dt * 0.3 then
					streakU = 0
				end
			else
				streakU += dt * 0.5
				if streakU > 1 then
					streakU = -1
					line.BackgroundTransparency = 1
				else
					local p = pathAt(streakU)
					local q = pathAt(math.min(1, streakU + 0.01))
					local d = q - p
					line.Position = UDim2.fromOffset(p.X, p.Y)
					line.Rotation = math.deg(math.atan2(d.Y, d.X))
					line.BackgroundTransparency = if streakU < 0.1 then 1 - streakU / 0.1 elseif streakU > 0.85 then (streakU - 0.85) / 0.15 else 0
				end
			end
		end
	end)
end

return GalaxyStream
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="115">
          <Properties>
            <string name="Name">Garden</string>
            <string name="Source"><![CDATA[--[[
	Garden (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > Garden

	🌻 Jardin de Dopamine (slot R1, 288x190 ; remplace la bourse).
	Des parterres de terre (Config.Garden.BasePlots + niveau de "Flower
	Beds") où poussent des fleurs tirées au hasard par le SERVEUR
	(GardenService) : pousse -> bouton -> fleur épanouie. Une fleur éclose
	scintille : on la touche pour la cueillir (+X qui éclate, pétales), puis
	un nouveau bulbe est planté tout seul.
	  - ciel dégradé, soleil qui tourne, nuages qui dérivent, colline ;
	  - 2 papillons dessinés (ailes qui battent), un arrosoir qui passe
	    arroser les fleurs qui poussent (pour le plaisir : ça n'accélère rien) ;
	  - minuteur + jauge sous chaque parterre, "PRÊT !" quand c'est éclos ;
	  - bouton "Tout cueillir" dès que 2 fleurs ou plus sont prêtes.
	Données : State.Data.Garden = { Plots = { { Flower, PlantedAt, ReadyAt } }, Now }
	(dates du serveur ; le client ne fait qu'extrapoler l'heure du serveur).
	RemoteFunction "Garden" : ("harvest", index) / ("harvestAll").
]]

local Garden = {}
Garden.Slot = "R1"

local Locale = require(game:GetService("ReplicatedStorage").Shared.Locale)

-- Dimensions (pixels "design") : rentrées de 2 px (contour jamais coupé)
local W = 284
local H = 186

-- Parterre dessiné à cette taille "de base", puis mis à l'échelle (UIScale)
local PW, PH = 64, 76
local SOIL_Y = 46 -- haut du bac en bois dans un parterre
local SOIL_H = 16
local CHIP_Y = 64 -- minuteur
local CHIP_H = 12
local BASE_Y = SOIL_Y + 2 -- pied de la plante (dans la butte de terre)
local HEADER_H = 30
local MAX_DROPS = 8
local MAX_SPARKS = 3

local WHITE = Color3.new(1, 1, 1)
local SKY_TOP = Color3.fromRGB(150, 214, 255)
local SKY_BOTTOM = Color3.fromRGB(226, 247, 255)
local GRASS_TOP = Color3.fromRGB(128, 214, 96)
local GRASS_BOTTOM = Color3.fromRGB(64, 160, 70)
local SOIL_TOP = Color3.fromRGB(128, 82, 48)
local SOIL_BOTTOM = Color3.fromRGB(78, 44, 22)
local WOOD = Color3.fromRGB(150, 96, 52)
local WOOD_DARK = Color3.fromRGB(92, 54, 24)
local STEM = Color3.fromRGB(70, 170, 70)
local LEAF = Color3.fromRGB(96, 200, 90)
local GOLD = Color3.fromRGB(255, 205, 60)

-- Couleur des pétales (bouton, halo, pétales qui volent) par fleur
local PETALS = {
	Daisy = Color3.fromRGB(255, 250, 240),
	Tulip = Color3.fromRGB(255, 110, 160),
	Rose = Color3.fromRGB(235, 40, 70),
	Sunflower = Color3.fromRGB(255, 200, 30),
	Lotus = Color3.fromRGB(255, 190, 90),
}
local DEFAULT_PETAL = Color3.fromRGB(255, 150, 200)

local function clockText(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	if seconds >= 3600 then
		return string.format("%dh%02d", math.floor(seconds / 3600), math.floor(seconds % 3600 / 60))
	end
	return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

function Garden.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local Create = UIUtil.Create
	local Format = ctx.Format
	local config = ctx.Config.Garden
	local container: Frame = ctx.Container
	local random = Random.new()

	local flowersById = {}
	for _, flower in ipairs(config.Flowers) do
		flowersById[flower.Id] = flower
	end

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	local function isVisible(): boolean
		local fn = ctx.IsVisible
		if type(fn) == "function" then
			local ok, result = pcall(fn)
			return not ok or result ~= false
		end
		return true
	end

	local function frame(props: { [string]: any }): Frame
		props.BorderSizePixel = 0
		if props.BackgroundTransparency == nil and props.BackgroundColor3 == nil then
			props.BackgroundTransparency = 1
		end
		return Create("Frame", props)
	end

	local function round(guiObject: Instance, radius: number?)
		UIUtil.Corner(guiObject, radius and UDim.new(0, radius) or UDim.new(1, 0))
	end

	local function vGradient(parent: Instance, keypoints: { { number | Color3 } }, rotation: number?): UIGradient
		local list = {}
		for _, point in ipairs(keypoints) do
			table.insert(list, ColorSequenceKeypoint.new(point[1] :: number, point[2] :: Color3))
		end
		return UIUtil.Gradient(parent, ColorSequence.new(list), rotation or 90)
	end

	local function fade(parent: Instance, points: { { number } }, rotation: number?): UIGradient
		local list = {}
		for _, point in ipairs(points) do
			table.insert(list, NumberSequenceKeypoint.new(point[1], point[2]))
		end
		return Create("UIGradient", { Rotation = rotation or 90, Transparency = NumberSequence.new(list), Parent = parent })
	end

	------------------------------------------------------------------
	-- Carte : ciel, soleil, nuages, colline
	------------------------------------------------------------------
	local card = frame({
		Name = "Garden",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(W, H),
		BackgroundColor3 = WHITE,
		ClipsDescendants = true,
		ZIndex = 1,
		Parent = container,
	})
	round(card, 18)
	vGradient(card, { { 0, SKY_TOP }, { 0.6, SKY_BOTTOM }, { 1, SKY_BOTTOM } })
	-- Contour "bois" (en dehors de la carte : jamais coupé)
	local border = frame({
		Size = UDim2.fromOffset(W, H),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		ZIndex = 60,
		Parent = container,
	})
	round(border, 18)
	local borderStroke = UIUtil.Stroke(border, WHITE, 2, 0)
	vGradient(borderStroke, { { 0, Color3.fromRGB(170, 116, 64) }, { 1, WOOD_DARK } })

	-- Soleil (rayons qui tournent lentement)
	local sunRays = UIUtil.Rays(card, Color3.fromRGB(255, 236, 140), 7, 92, UDim2.fromOffset(W - 30, 22), 1)
	local sun = frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(W - 30, 22),
		Size = UDim2.fromOffset(30, 30),
		BackgroundColor3 = WHITE,
		ZIndex = 2,
		Parent = card,
	})
	round(sun)
	vGradient(sun, { { 0, Color3.fromRGB(255, 250, 190) }, { 1, Color3.fromRGB(255, 196, 40) } }, 45)
	UIUtil.Stroke(sun, Color3.fromRGB(255, 220, 90), 3, 0.55)

	-- Nuages (3 boules chacun), qui dérivent vers la droite
	local clouds = {}
	for c = 1, 2 do
		local cloud = frame({
			Position = UDim2.fromOffset(c == 1 and 60 or 170, c == 1 and 30 or 44),
			Size = UDim2.fromOffset(46, 18),
			ZIndex = 2,
			Parent = card,
		})
		for _, puff in ipairs({ { 0, 6, 20, 12 }, { 10, 0, 22, 18 }, { 24, 4, 22, 14 } }) do
			local ball = frame({
				Position = UDim2.fromOffset(puff[1], puff[2]),
				Size = UDim2.fromOffset(puff[3], puff[4]),
				BackgroundColor3 = WHITE,
				BackgroundTransparency = 0.1,
				ZIndex = 2,
				Parent = cloud,
			})
			round(ball)
		end
		local scale = Create("UIScale", { Scale = c == 1 and 0.9 or 0.7, Parent = cloud })
		clouds[c] = { Frame = cloud, X = c == 1 and 60 or 170, Y = c == 1 and 30 or 46, Speed = c == 1 and 5 or 3.2, Scale = scale }
	end

	-- Colline (grand ovale) : sa position dépend de la disposition des parterres.
	-- ClipsDescendants ne suit pas les coins arrondis : la colline est coupée
	-- au-dessus des coins du bas, et une bande arrondie fait le bas de la carte.
	local ground = frame({
		Name = "GroundBottom",
		Position = UDim2.fromOffset(0, H - 44),
		Size = UDim2.fromOffset(W, 44),
		BackgroundColor3 = GRASS_BOTTOM,
		ZIndex = 2,
		Parent = card,
	})
	round(ground, 18)
	local hillClip = frame({
		Name = "HillClip",
		Size = UDim2.fromOffset(W, H - 18),
		ClipsDescendants = true,
		ZIndex = 2,
		Parent = card,
	})
	local hillBack = frame({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.25, 0, 0, 70),
		Size = UDim2.fromOffset(W * 1.1, 300),
		BackgroundColor3 = Color3.fromRGB(160, 222, 120),
		ZIndex = 2,
		Parent = hillClip,
	})
	round(hillBack)
	local hill = frame({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 80),
		Size = UDim2.fromOffset(W * 1.8, 400),
		BackgroundColor3 = WHITE,
		ZIndex = 3,
		Parent = hillClip,
	})
	round(hill)
	vGradient(hill, { { 0, GRASS_TOP }, { 0.11, GRASS_BOTTOM }, { 1, GRASS_BOTTOM } })
	-- Palissade blanche au fond (seulement avec une rangée de parterres)
	local fence = frame({ Name = "Fence", Size = UDim2.fromOffset(W, 18), Visible = false, ZIndex = 4, Parent = card })
	for rail = 0, 1 do
		frame({
			Position = UDim2.fromOffset(0, 5 + rail * 7),
			Size = UDim2.new(1, 0, 0, 2),
			BackgroundColor3 = Color3.fromRGB(235, 232, 225),
			ZIndex = 4,
			Parent = fence,
		})
	end
	for k = 0, math.floor(W / 12) do
		local picket = frame({
			Position = UDim2.fromOffset(3 + k * 12, 0),
			Size = UDim2.fromOffset(5, 18),
			BackgroundColor3 = WHITE,
			ZIndex = 4,
			Parent = fence,
		})
		UIUtil.Corner(picket, UDim.new(0, 2))
		UIUtil.Stroke(picket, Color3.fromRGB(190, 180, 170), 1, 0.3)
	end

	-- Touffes d'herbe et petites fleurs sauvages sur la colline (placées par layoutPlots)
	local tufts = {}
	for t = 1, 7 do
		local tuft = frame({ Size = UDim2.fromOffset(10, 8), ZIndex = 4, Parent = hillClip })
		for blade = -1, 1 do
			local bar = frame({
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.new(0.5, blade * 3, 1, 0),
				Size = UDim2.fromOffset(2, blade == 0 and 8 or 6),
				Rotation = blade * 22,
				BackgroundColor3 = Color3.fromRGB(46, 130, 50),
				ZIndex = 4,
				Parent = tuft,
			})
			round(bar, 1)
		end
		if t % 3 == 0 then
			local bloom = frame({
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0.5, 0, 0, 0),
				Size = UDim2.fromOffset(4, 4),
				BackgroundColor3 = t % 2 == 0 and WHITE or Color3.fromRGB(255, 230, 90),
				ZIndex = 5,
				Parent = tuft,
			})
			round(bloom)
		end
		table.insert(tufts, tuft)
	end

	------------------------------------------------------------------
	-- En-tête : pancarte en bois + bouton "Tout cueillir" / prochain éclos
	------------------------------------------------------------------
	local sign = frame({
		Name = "Sign",
		Position = UDim2.fromOffset(7, 6),
		Size = UDim2.fromOffset(150, 21),
		BackgroundColor3 = WHITE,
		ZIndex = 20,
		Parent = card,
	})
	round(sign, 7)
	vGradient(sign, { { 0, Color3.fromRGB(196, 136, 78) }, { 1, WOOD } })
	UIUtil.Stroke(sign, WOOD_DARK, 1.5, 0)
	-- Veines du bois
	for v = 1, 2 do
		frame({
			Position = UDim2.fromOffset(8, 6 + (v - 1) * 8),
			Size = UDim2.new(1, -16, 0, 1),
			BackgroundColor3 = WOOD_DARK,
			BackgroundTransparency = 0.75,
			ZIndex = 20,
			Parent = sign,
		})
	end
	for side = 0, 1 do
		local nail = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(side, side == 0 and 5 or -5, 0.5, 0),
			Size = UDim2.fromOffset(3, 3),
			BackgroundColor3 = Color3.fromRGB(70, 50, 40),
			ZIndex = 21,
			Parent = sign,
		})
		round(nail)
	end
	local title = UIUtil.Label({
		Text = "🌻 " .. Locale.T("Dopamine Garden"),
		Font = Theme.Fonts.Title,
		TextColor3 = Color3.fromRGB(255, 248, 225),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -16, 0, 16),
		MaxTextSize = 14,
		ZIndex = 22,
		Parent = sign,
	})
	local titleStroke = UIUtil.Stroke(title, WOOD_DARK, 1.2, 0)
	titleStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual

	-- Pastille à droite : prochain éclos / "Tout cueillir"
	local pill = Create("TextButton", {
		Name = "GardenHarvestAll",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromOffset(W - 7, 7),
		Size = UDim2.fromOffset(104, 19),
		BackgroundColor3 = WHITE,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 20,
		Parent = card,
	})
	round(pill)
	local pillGradient = vGradient(pill, { { 0, Color3.fromRGB(255, 255, 255) }, { 1, Color3.fromRGB(226, 240, 250) } })
	local pillStroke = UIUtil.Stroke(pill, Color3.fromRGB(80, 130, 90), 1.5, 0)
	local pillLabel = UIUtil.Label({
		Text = "",
		Font = Theme.Fonts.Title,
		TextColor3 = Color3.fromRGB(40, 90, 50),
		Size = UDim2.new(1, -10, 1, -4),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		MaxTextSize = 12,
		ZIndex = 21,
		Parent = pill,
	})
	local pillScale = Create("UIScale", { Parent = pill })
	UIUtil.AnimateButton(pill, 1.05, 0.94)

	------------------------------------------------------------------
	-- Arrosoir (dessiné) + gouttes (réserve réutilisée)
	------------------------------------------------------------------
	local can = frame({
		Name = "WateringCan",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(176, 16),
		Size = UDim2.fromOffset(34, 24),
		ZIndex = 30,
		Parent = card,
	})
	local canHandle = frame({
		Position = UDim2.fromOffset(6, 0),
		Size = UDim2.fromOffset(14, 13),
		ZIndex = 30,
		Parent = can,
	})
	round(canHandle)
	UIUtil.Stroke(canHandle, Color3.fromRGB(30, 120, 140), 2.5, 0)
	local canSpout = frame({
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromOffset(22, 15),
		Size = UDim2.fromOffset(13, 3),
		Rotation = -35,
		BackgroundColor3 = Color3.fromRGB(40, 150, 170),
		ZIndex = 30,
		Parent = can,
	})
	round(canSpout, 1)
	local canRose = frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(33, 7),
		Size = UDim2.fromOffset(6, 6),
		BackgroundColor3 = Color3.fromRGB(30, 120, 140),
		ZIndex = 31,
		Parent = can,
	})
	round(canRose)
	local canBody = frame({
		Position = UDim2.fromOffset(3, 8),
		Size = UDim2.fromOffset(21, 15),
		BackgroundColor3 = WHITE,
		ZIndex = 31,
		Parent = can,
	})
	round(canBody, 5)
	vGradient(canBody, { { 0, Color3.fromRGB(110, 220, 230) }, { 1, Color3.fromRGB(30, 150, 170) } }, 0)
	UIUtil.Stroke(canBody, Color3.fromRGB(20, 100, 120), 1, 0.1)
	frame({
		Position = UDim2.fromOffset(0, 5),
		Size = UDim2.new(1, 0, 0, 3),
		BackgroundColor3 = Color3.fromRGB(255, 220, 90),
		ZIndex = 32,
		Parent = canBody,
	})
	local canShine = frame({
		Position = UDim2.fromOffset(3, 2),
		Size = UDim2.fromOffset(4, 10),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.45,
		ZIndex = 32,
		Parent = canBody,
	})
	round(canShine)

	local drops = {}
	for _ = 1, MAX_DROPS do
		local drop = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(3, 5),
			BackgroundColor3 = Color3.fromRGB(90, 180, 255),
			BackgroundTransparency = 0.1,
			Visible = false,
			ZIndex = 29,
			Parent = card,
		})
		round(drop)
		table.insert(drops, { Frame = drop, Active = false, X = 0, Y = 0, VY = 0, Floor = 0 })
	end
	local activeDrops = 0

	-- État de l'arrosoir : "rest" | "fly" | "pour" | "back"
	local CAN_REST = Vector2.new(W + 30, 60) -- hors de la carte (recalculé par layoutPlots)
	local canState = {
		Mode = "rest",
		From = CAN_REST,
		To = CAN_REST,
		T = 0,
		Dur = 1,
		Pour = 0,
		Pos = CAN_REST,
		Tilt = 0,
		Target = 0, -- index du parterre arrosé
		Next = 4, -- secondes avant la prochaine tournée
	}

	------------------------------------------------------------------
	-- Papillons (dessinés : 2 ailes qui battent + corps)
	------------------------------------------------------------------
	local butterflies = {}
	local BUTTERFLY_COLORS = {
		{ Color3.fromRGB(255, 140, 200), Color3.fromRGB(255, 220, 120) },
		{ Color3.fromRGB(120, 170, 255), Color3.fromRGB(255, 255, 255) },
	}
	for b = 1, 2 do
		local holder = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(20, 16),
			ZIndex = 40,
			Parent = card,
		})
		local wings = {}
		for side = -1, 1, 2 do
			local wing = frame({
				AnchorPoint = Vector2.new(side == -1 and 1 or 0, 0.5),
				Position = UDim2.new(0.5, 0, 0.5, -1),
				Size = UDim2.fromOffset(9, 11),
				BackgroundColor3 = BUTTERFLY_COLORS[b][1],
				ZIndex = 40,
				Parent = holder,
			})
			round(wing)
			UIUtil.Stroke(wing, Color3.fromRGB(80, 40, 70), 1, 0.3)
			local spot = frame({
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.4),
				Size = UDim2.fromScale(0.45, 0.35),
				BackgroundColor3 = BUTTERFLY_COLORS[b][2],
				ZIndex = 41,
				Parent = wing,
			})
			round(spot)
			local lower = frame({
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.new(0.5, 0, 0.75, 0),
				Size = UDim2.fromScale(0.7, 0.55),
				BackgroundColor3 = BUTTERFLY_COLORS[b][1]:Lerp(Color3.new(0, 0, 0), 0.12),
				ZIndex = 39,
				Parent = wing,
			})
			round(lower)
			table.insert(wings, wing)
		end
		local body = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(3, 11),
			BackgroundColor3 = Color3.fromRGB(60, 40, 50),
			ZIndex = 42,
			Parent = holder,
		})
		round(body)
		table.insert(butterflies, {
			Frame = holder,
			Wings = wings,
			Phase = random:NextNumber(0, math.pi * 2),
			Speed = b == 1 and 0.23 or 0.17,
			Flap = b == 1 and 15 or 12,
			CX = b == 1 and 90 or 200,
			CY = b == 1 and 70 or 100,
			LastX = 0,
		})
	end

	------------------------------------------------------------------
	-- Bulle d'info (une seule, réutilisée)
	------------------------------------------------------------------
	local bubble = frame({
		Name = "Bubble",
		AnchorPoint = Vector2.new(0.5, 1),
		Size = UDim2.fromOffset(130, 18),
		BackgroundColor3 = WHITE,
		Visible = false,
		ZIndex = 50,
		Parent = card,
	})
	round(bubble, 8)
	UIUtil.Stroke(bubble, Color3.fromRGB(70, 120, 80), 1.5, 0)
	local bubbleLabel = UIUtil.Label({
		Text = "",
		Font = Theme.Fonts.Title,
		TextColor3 = Color3.fromRGB(40, 80, 50),
		Size = UDim2.new(1, -8, 1, -2),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		MaxTextSize = 11,
		ZIndex = 51,
		Parent = bubble,
	})
	local bubbleScale = Create("UIScale", { Parent = bubble })
	local bubbleUntil = 0

	local function showBubble(point: Vector2, text: string, bad: boolean?)
		bubbleLabel.Text = text
		bubbleLabel.TextColor3 = bad and Color3.fromRGB(170, 40, 40) or Color3.fromRGB(40, 80, 50)
		local x = math.clamp(point.X, 68, W - 68)
		bubble.Position = UDim2.fromOffset(x, math.max(20, point.Y))
		bubble.Visible = true
		bubbleScale.Scale = 0.5
		UIUtil.Tween(bubbleScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
		bubbleUntil = os.clock() + 1.8
	end

	------------------------------------------------------------------
	-- Heure du serveur (extrapolée) et données
	------------------------------------------------------------------
	local serverOffset: number? = nil -- heure serveur = os.clock() + serverOffset
	local function serverNow(): number
		return os.clock() + (serverOffset or 0)
	end
	local function syncClock(now: any)
		now = tonumber(now)
		if not now then
			return
		end
		local offset = now - os.clock()
		-- Now est arrondi à la seconde inférieure (et arrive avec du retard) :
		-- la meilleure estimation est la plus grande, sauf gros écart
		if serverOffset == nil or offset > serverOffset or serverOffset - offset > 3 then
			serverOffset = offset
		end
	end

	------------------------------------------------------------------
	-- Parterres
	------------------------------------------------------------------
	type Plot = {
		Index: number,
		Holder: Frame,
		Scale: UIScale,
		Button: TextButton,
		Plant: Frame,
		PlantScale: UIScale,
		Stem: Frame,
		Leaves: { Frame },
		Bud: Frame,
		BudScale: UIScale,
		Head: TextLabel,
		HeadScale: UIScale,
		Halo: Frame,
		Sparks: { { Frame: Frame, Bars: { Frame } } },
		Chip: Frame,
		ChipFill: Frame,
		ChipLabel: TextLabel,
		Flower: string,
		PlantedAt: number,
		ReadyAt: number,
		Stage: string,
		Ripe: boolean,
		Pending: boolean,
		Sway: number,
		Popping: boolean,
	}
	local plots: { Plot } = {}
	local layoutCount = -1
	local plantBoost = 1 -- échelle des plantes (plus grandes s'il y a de la place)
	local plotArea = Instance.new("Frame")
	plotArea.Name = "Beds"
	plotArea.BackgroundTransparency = 1
	plotArea.BorderSizePixel = 0
	plotArea.Size = UDim2.fromScale(1, 1)
	plotArea.ZIndex = 5
	plotArea.Parent = card

	local function buildPlot(index: number): Plot
		local holder = frame({
			Name = "Plot" .. index,
			Size = UDim2.fromOffset(PW, PH),
			ZIndex = 5,
			Parent = plotArea,
		})
		local scale = Create("UIScale", { Parent = holder })

		-- Ombre au sol
		local shadow = frame({
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromOffset(PW / 2, SOIL_Y + SOIL_H - 3),
			Size = UDim2.fromOffset(PW + 2, 7),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.78,
			ZIndex = 5,
			Parent = holder,
		})
		round(shadow)
		-- Butte de terre (derrière la planche)
		local soil = frame({
			Name = "Soil",
			Position = UDim2.fromOffset(5, SOIL_Y - 3),
			Size = UDim2.fromOffset(PW - 10, 13),
			BackgroundColor3 = WHITE,
			ZIndex = 6,
			Parent = holder,
		})
		round(soil)
		vGradient(soil, { { 0, SOIL_TOP }, { 1, SOIL_BOTTOM } })
		for p = 1, 4 do
			local pebble = frame({
				Position = UDim2.fromOffset(7 + (p - 1) * 11 + (p % 2) * 3, 3 + (p % 2) * 2),
				Size = UDim2.fromOffset(3 + p % 2, 2),
				BackgroundColor3 = Color3.fromRGB(56, 30, 14),
				BackgroundTransparency = 0.3,
				ZIndex = 6,
				Parent = soil,
			})
			round(pebble)
		end
		-- Planche avant du bac en bois (2 lattes, clous)
		local board = frame({
			Name = "Board",
			Position = UDim2.fromOffset(2, SOIL_Y + 4),
			Size = UDim2.fromOffset(PW - 4, SOIL_H - 4),
			BackgroundColor3 = WHITE,
			ZIndex = 7,
			Parent = holder,
		})
		round(board, 3)
		vGradient(board, { { 0, Color3.fromRGB(214, 150, 88) }, { 0.5, WOOD }, { 1, Color3.fromRGB(120, 72, 36) } })
		UIUtil.Stroke(board, WOOD_DARK, 1.2, 0)
		frame({
			Position = UDim2.new(0, 2, 0.5, 0),
			Size = UDim2.new(1, -4, 0, 1),
			BackgroundColor3 = WOOD_DARK,
			BackgroundTransparency = 0.45,
			ZIndex = 7,
			Parent = board,
		})
		for k = 1, 2 do
			frame({
				Position = UDim2.new(k / 3, 0, 0, 1),
				Size = UDim2.new(0, 1, 1, -2),
				BackgroundColor3 = WOOD_DARK,
				BackgroundTransparency = 0.55,
				ZIndex = 7,
				Parent = board,
			})
		end
		for side = 0, 1 do
			local nail = frame({
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(side, side == 0 and 4 or -4, 0.5, 0),
				Size = UDim2.fromOffset(2, 2),
				BackgroundColor3 = Color3.fromRGB(70, 50, 40),
				ZIndex = 7,
				Parent = board,
			})
			round(nail)
		end

		-- Plante : cadre 2x plus haut, centré sur le pied (la rotation se fait autour du pied)
		local plant = frame({
			Name = "Plant",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(PW / 2, BASE_Y),
			Size = UDim2.fromOffset(48, 96),
			ZIndex = 8,
			Parent = holder,
		})
		local halo = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, -34),
			Size = UDim2.fromOffset(40, 40),
			BackgroundColor3 = GOLD,
			BackgroundTransparency = 1,
			ZIndex = 8,
			Parent = plant,
		})
		round(halo)
		fade(halo, { { 0, 0.1 }, { 0.6, 0.6 }, { 1, 1 } }, 0)
		local stem = frame({
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 0.5, 0),
			Size = UDim2.fromOffset(3, 10),
			BackgroundColor3 = WHITE,
			ZIndex = 9,
			Parent = plant,
		})
		round(stem, 2)
		UIUtil.Gradient(stem, ColorSequence.new(STEM:Lerp(WHITE, 0.2), STEM:Lerp(Color3.new(0, 0, 0), 0.2)), 0)
		local leaves = {}
		for side = -1, 1, 2 do
			local leaf = frame({
				AnchorPoint = Vector2.new(side == -1 and 1 or 0, 0.5),
				Size = UDim2.fromOffset(11, 5),
				Rotation = side * -28,
				BackgroundColor3 = WHITE,
				ZIndex = 9,
				Parent = plant,
			})
			round(leaf)
			UIUtil.Gradient(leaf, ColorSequence.new(LEAF:Lerp(WHITE, 0.25), LEAF:Lerp(Color3.new(0, 0, 0), 0.15)), 90)
			table.insert(leaves, leaf)
		end
		-- Bouton floral (dessiné) avec ses sépales
		local bud = frame({
			AnchorPoint = Vector2.new(0.5, 1),
			Size = UDim2.fromOffset(10, 13),
			BackgroundColor3 = WHITE,
			Visible = false,
			ZIndex = 10,
			Parent = plant,
		})
		round(bud)
		for side = -1, 1, 2 do
			local sepal = frame({
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.new(0.5, side * 3, 1, 1),
				Size = UDim2.fromOffset(5, 7),
				Rotation = side * 25,
				BackgroundColor3 = STEM,
				ZIndex = 11,
				Parent = bud,
			})
			round(sepal)
		end
		local budScale = Create("UIScale", { Parent = bud })
		-- Fleur épanouie (emoji de Config.Garden)
		local head = UIUtil.Label({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(34, 34),
			Text = "",
			Font = Theme.Fonts.Title,
			MaxTextSize = 30,
			Visible = false,
			ZIndex = 11,
			Parent = plant,
		})
		local headScale = Create("UIScale", { Parent = head })
		-- Étincelles : petites croix lumineuses (2 barres) qui tournent autour de la fleur
		local sparks = {}
		for s = 1, MAX_SPARKS do
			local spark = frame({
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(9, 9),
				Visible = false,
				ZIndex = 12,
				Parent = plant,
			})
			local color = s == 2 and WHITE or Color3.fromRGB(255, 240, 150)
			local bars = {}
			for b = 0, 1 do
				local bar = frame({
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromScale(0.5, 0.5),
					Size = b == 0 and UDim2.new(0, 1.5, 1, 0) or UDim2.new(1, 0, 0, 1.5),
					BackgroundColor3 = color,
					ZIndex = 12,
					Parent = spark,
				})
				round(bar, 1)
				table.insert(bars, bar)
			end
			table.insert(sparks, { Frame = spark, Bars = bars })
		end

		-- Minuteur (pastille + jauge)
		local chip = frame({
			Name = "Timer",
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromOffset(PW / 2, CHIP_Y),
			Size = UDim2.fromOffset(PW - 8, CHIP_H),
			BackgroundColor3 = Color3.fromRGB(40, 60, 40),
			BackgroundTransparency = 0.25,
			ClipsDescendants = true,
			ZIndex = 12,
			Parent = holder,
		})
		round(chip)
		local chipFill = frame({
			Size = UDim2.fromScale(0, 1),
			BackgroundColor3 = Color3.fromRGB(110, 210, 100),
			BackgroundTransparency = 0.25,
			ZIndex = 12,
			Parent = chip,
		})
		round(chipFill)
		local chipLabel = UIUtil.Label({
			Text = "",
			Font = Theme.Fonts.Number,
			TextColor3 = WHITE,
			Size = UDim2.new(1, -4, 1, 0),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			MaxTextSize = 10,
			ZIndex = 13,
			Parent = chip,
		})

		local button = Create("TextButton", {
			Name = "GardenPlot" .. index,
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			ZIndex = 20,
			Parent = holder,
		})

		return {
			Index = index,
			Holder = holder,
			Scale = scale,
			Button = button,
			Plant = plant,
			PlantScale = Create("UIScale", { Parent = plant }),
			Stem = stem,
			Leaves = leaves,
			Bud = bud,
			BudScale = budScale,
			Head = head,
			HeadScale = headScale,
			Halo = halo,
			Sparks = sparks,
			Chip = chip,
			ChipFill = chipFill,
			ChipLabel = chipLabel,
			Flower = "",
			PlantedAt = 0,
			ReadyAt = 0,
			Stage = "",
			Ripe = false,
			Pending = false,
			Sway = random:NextNumber(0, math.pi * 2),
			Popping = false,
		}
	end

	-- Centre (dans la carte) d'un point du parterre (coordonnées "de base")
	local function plotPoint(plot: Plot, x: number, y: number): Vector2
		local s = plot.Scale.Scale
		local pos = plot.Holder.Position
		return Vector2.new(pos.X.Offset + x * s, pos.Y.Offset + y * s)
	end

	-- Hauteur de la tête de la plante au-dessus du pied selon la pousse (0..1)
	local function stemHeight(progress: number, ripe: boolean): number
		if ripe then
			return 28
		elseif progress < 0.4 then
			return 5 + 13 * (progress / 0.4)
		end
		return 18 + 8 * ((progress - 0.4) / 0.6)
	end

	-- Met à jour le dessin de la plante (appelé 4 fois / s et à chaque changement)
	local function drawPlant(plot: Plot, progress: number, ripe: boolean)
		local flower = flowersById[plot.Flower]
		local petal = PETALS[plot.Flower] or DEFAULT_PETAL
		local stage = ripe and "bloom" or (progress < 0.4 and "sprout" or "bud")
		local height = stemHeight(progress, ripe)
		local centerY = 48 -- pied de la plante dans le cadre "Plant" (96 de haut)
		plot.Stem.Size = UDim2.fromOffset(stage == "sprout" and 2 or 3, height)
		-- Feuilles : en haut pour une pousse (cotylédons), à mi-hauteur ensuite
		local leafY = stage == "sprout" and (centerY - height + 2) or (centerY - height * 0.45)
		local leafScale = stage == "sprout" and (0.7 + 0.3 * math.min(1, progress / 0.4)) or 1
		for i, leaf in ipairs(plot.Leaves) do
			local side = i == 1 and -1 or 1
			leaf.Position = UDim2.new(0.5, side * 1, 0, leafY)
			leaf.Size = UDim2.fromOffset(math.floor(11 * leafScale + 0.5), math.max(3, math.floor(5 * leafScale + 0.5)))
		end
		if stage ~= plot.Stage then
			plot.Stage = stage
			plot.Bud.Visible = stage == "bud"
			plot.Head.Visible = stage == "bloom"
			plot.Bud.BackgroundColor3 = petal
			if stage == "bloom" then
				plot.Head.Text = flower and flower.Icon or "🌸"
				plot.Halo.BackgroundColor3 = petal:Lerp(GOLD, 0.5)
				plot.Halo.BackgroundTransparency = 0.35
				plot.HeadScale.Scale = 0.3
				UIUtil.Tween(plot.HeadScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
			else
				plot.Halo.BackgroundTransparency = 1
			end
			for _, spark in ipairs(plot.Sparks) do
				spark.Frame.Visible = stage == "bloom"
			end
		end
		if stage == "bud" then
			local open = (progress - 0.4) / 0.6
			plot.Bud.Position = UDim2.new(0.5, 0, 0, centerY - height + 3)
			plot.BudScale.Scale = 0.65 + 0.45 * open
		elseif stage == "bloom" then
			plot.Head.Position = UDim2.new(0.5, 0, 0, centerY - height - 4)
			plot.Halo.Position = UDim2.new(0.5, 0, 0, centerY - height - 4)
		end
	end

	-- Minuteur + jauge + dessin d'un parterre (4 fois / s)
	local function refreshPlot(plot: Plot, now: number)
		if plot.Flower == "" then
			return
		end
		local total = math.max(1, plot.ReadyAt - plot.PlantedAt)
		local remaining = plot.ReadyAt - now
		local ripe = remaining <= 0
		local progress = math.clamp(1 - remaining / total, 0, 1)
		plot.Ripe = ripe
		if not plot.Popping then
			drawPlant(plot, progress, ripe)
		end
		if ripe then
			plot.ChipFill.Size = UDim2.fromScale(1, 1)
			plot.ChipFill.BackgroundColor3 = GOLD
			plot.ChipFill.BackgroundTransparency = 0
			plot.ChipLabel.Text = Locale.T("READY!")
			plot.ChipLabel.TextColor3 = Color3.fromRGB(110, 60, 0)
		else
			plot.ChipFill.Size = UDim2.fromScale(progress, 1)
			plot.ChipFill.BackgroundColor3 = Color3.fromRGB(110, 210, 100)
			plot.ChipFill.BackgroundTransparency = 0.25
			plot.ChipLabel.Text = "⏱ " .. clockText(remaining)
			plot.ChipLabel.TextColor3 = WHITE
		end
	end

	-- Dispose les parterres selon leur nombre (1 ou 2 rangées)
	local function layoutPlots(count: number)
		local top = HEADER_H + 2
		local areaW = W - 12
		local areaH = H - top - 4
		local rows = count <= 4 and 1 or 2
		local cols = math.ceil(count / rows)
		local gap = 4
		local cellW = (areaW - gap * (cols - 1)) / cols
		local cellH = (areaH - gap * (rows - 1)) / rows
		local scale = math.min(cellW / PW, cellH / PH, 1.45)
		local plotW, plotH = PW * scale, PH * scale
		-- Une seule rangée avec des parterres étroits : il reste du ciel, les plantes poussent plus haut
		plantBoost = rows == 1 and math.clamp(1.35 / scale, 1, 1.35) or 1
		for index, plot in ipairs(plots) do
			local row = math.floor((index - 1) / cols)
			local col = (index - 1) % cols
			local inRow = math.min(cols, count - row * cols)
			-- Rangée incomplète : centrée
			local rowWidth = inRow * plotW + (inRow - 1) * gap
			local x0 = 6 + (areaW - rowWidth) / 2
			local y
			if rows == 1 then
				y = H - 6 - plotH -- au sol, en bas de la carte
			else
				y = top + row * (cellH + gap) + (cellH - plotH)
			end
			plot.Holder.Position = UDim2.fromOffset(x0 + col * (plotW + gap), y)
			plot.Scale.Scale = scale
			plot.PlantScale.Scale = plantBoost
		end
		-- Colline : juste derrière la première rangée de terre
		local firstY = plots[1] and plots[1].Holder.Position.Y.Offset or 90
		local hillTop = firstY + SOIL_Y * scale - (rows == 1 and 30 or 12)
		hill.Position = UDim2.new(0.5, 0, 0, hillTop)
		hillBack.Position = UDim2.new(0.22, 0, 0, hillTop - 12)
		fence.Visible = rows == 1
		fence.Position = UDim2.fromOffset(0, hillTop + 16)
		-- Touffes : entre les parterres et sur les bords
		for t, tuft in ipairs(tufts) do
			local tx = 8 + (t - 1) * (W - 26) / (#tufts - 1) + (t % 2) * 5
			local ty = rows == 1 and (hillTop + 8 + (t % 3) * 5) or (H - 26 - (t % 2) * 2)
			tuft.Position = UDim2.fromOffset(tx, ty)
			tuft.Visible = rows == 1 or t == 1 or t == #tufts
		end
		-- Arrosoir : dans le ciel s'il y a de la place, sinon il attend hors de la carte
		if rows == 1 then
			CAN_REST = Vector2.new(W * 0.56, HEADER_H + 22)
		else
			CAN_REST = Vector2.new(W + 30, 60)
		end
		if canState.Mode == "rest" then
			canState.Pos = CAN_REST
		end
	end

	local harvest -- (défini plus bas)

	local function rebuild(count: number)
		for _, plot in ipairs(plots) do
			plot.Holder:Destroy()
		end
		table.clear(plots)
		for index = 1, count do
			local plot = buildPlot(index)
			plots[index] = plot
			ctx.Connect(plot.Button.Activated, function()
				harvest(plot)
			end)
			ctx.Connect(plot.Button.MouseEnter, function()
				if plot.Ripe and not plot.Popping then
					UIUtil.Tween(plot.HeadScale, 0.15, { Scale = 1.15 }, Enum.EasingStyle.Back)
				end
			end)
			ctx.Connect(plot.Button.MouseLeave, function()
				if plot.Ripe and not plot.Popping then
					UIUtil.Tween(plot.HeadScale, 0.15, { Scale = 1 })
				end
			end)
		end
		layoutCount = count
		layoutPlots(count)
	end

	-- Applique la liste de parterres du serveur
	local function applyPlots(list: any)
		if type(list) ~= "table" then
			return
		end
		local count = #list
		if count ~= layoutCount then
			rebuild(count)
		end
		local now = serverNow()
		for index, info in ipairs(list) do
			local plot = plots[index]
			if plot and type(info) == "table" and flowersById[info.Flower] then
				local plantedAt = tonumber(info.PlantedAt) or 0
				local readyAt = tonumber(info.ReadyAt) or plantedAt
				if plot.Flower ~= info.Flower or plot.PlantedAt ~= plantedAt then
					local replanted = plot.Flower ~= ""
					plot.Flower = info.Flower
					plot.PlantedAt = plantedAt
					plot.ReadyAt = readyAt
					plot.Stage = ""
					plot.Popping = false
					plot.HeadScale.Scale = 1
					plot.Head.TextTransparency = 0
					if replanted then
						-- Nouvelle pousse : petit "pop" de terre
						plot.PlantScale.Scale = 0.2 * plantBoost
						UIUtil.Tween(plot.PlantScale, 0.35, { Scale = plantBoost }, Enum.EasingStyle.Back)
					end
				end
				refreshPlot(plot, now)
			end
		end
	end

	------------------------------------------------------------------
	-- En-tête : "Tout cueillir" ou prochain éclos
	------------------------------------------------------------------
	local ripeCount = 0
	local harvestingAll = false
	local lastPillMode = ""
	local function refreshPill(now: number)
		ripeCount = 0
		local nextIn = math.huge
		for _, plot in ipairs(plots) do
			if plot.Flower ~= "" and not plot.Popping then
				if plot.Ripe then
					ripeCount += 1
				else
					nextIn = math.min(nextIn, plot.ReadyAt - now)
				end
			end
		end
		local mode
		if ripeCount >= 2 then
			mode = "all"
			pillLabel.Text = Locale.T("🧺 Harvest all (%d)", ripeCount)
		elseif ripeCount == 1 then
			mode = "one"
			pillLabel.Text = Locale.T("🌸 Tap the flower!")
		elseif nextIn < math.huge then
			mode = "wait"
			pillLabel.Text = Locale.T("⏱ Next bloom %s", clockText(nextIn))
		else
			mode = "wait"
			pillLabel.Text = "🌱"
		end
		if mode ~= lastPillMode then
			lastPillMode = mode
			local active = mode == "all"
			pillGradient.Color = active
					and ColorSequence.new(Color3.fromRGB(150, 235, 110), Color3.fromRGB(60, 170, 70))
				or ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(226, 240, 250))
			pillStroke.Color = active and Color3.fromRGB(30, 100, 40) or Color3.fromRGB(80, 130, 90)
			pillLabel.TextColor3 = active and WHITE or Color3.fromRGB(40, 90, 50)
			if active then
				pillScale.Scale = 0.6
				UIUtil.Tween(pillScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
			end
		end
	end

	------------------------------------------------------------------
	-- Arrosoir : va arroser un parterre (pour le plaisir)
	------------------------------------------------------------------
	local function sendCan(target: number)
		local plot = plots[target]
		if not plot then
			return
		end
		local point = plotPoint(plot, PW / 2, SOIL_Y - 30)
		canState.Mode = "fly"
		canState.From = canState.Pos
		canState.To = Vector2.new(math.clamp(point.X - 16, 20, W - 20), math.max(HEADER_H + 4, point.Y - 6))
		canState.T = 0
		canState.Dur = 0.7
		canState.Target = target
	end

	local function spawnDrop(x: number, y: number, floor: number)
		for _, drop in ipairs(drops) do
			if not drop.Active then
				drop.Active = true
				drop.X = x + random:NextNumber(-3, 3)
				drop.Y = y
				drop.VY = random:NextNumber(30, 60)
				drop.Floor = floor
				drop.Frame.Visible = true
				activeDrops += 1
				return
			end
		end
	end

	------------------------------------------------------------------
	-- Cueillette
	------------------------------------------------------------------
	local function popPlot(plot: Plot, reward: number, flowerId: string, big: boolean?)
		local petal = PETALS[flowerId] or DEFAULT_PETAL
		local point = plotPoint(plot, PW / 2, BASE_Y - 32 * plantBoost)
		plot.Popping = true
		UIUtil.Tween(plot.HeadScale, 0.18, { Scale = 1.7 }, Enum.EasingStyle.Back)
		UIUtil.Tween(plot.Head, 0.25, { TextTransparency = 1 })
		plot.Halo.BackgroundTransparency = 1
		for _, spark in ipairs(plot.Sparks) do
			spark.Frame.Visible = false
		end
		if effectsOn() then
			ctx.Effects.Burst(card, UDim2.fromOffset(point.X, point.Y), petal, big and 14 or 9)
		end
		ctx.FloatText(card, UDim2.fromOffset(point.X, point.Y - 6), "+" .. Format.Format(reward), GOLD, big and 28 or 22)
	end

	local function applyResult(result: any)
		if type(result) ~= "table" then
			return
		end
		syncClock(result.Now)
		-- Petit délai : l'éclat de la fleur se voit avant la nouvelle pousse
		task.delay(0.3, function()
			if ctx.IsAlive() then
				applyPlots(result.Plots)
			end
		end)
	end

	harvest = function(plot: Plot)
		if plot.Pending or plot.Popping or plot.Flower == "" then
			return
		end
		local now = serverNow()
		if now < plot.ReadyAt then
			-- Pas encore : on dit combien de temps, et l'arrosoir passe
			local flower = flowersById[plot.Flower]
			local name = flower and Locale.T(flower.Name) or ""
			showBubble(plotPoint(plot, PW / 2, SOIL_Y - 30), Locale.T("%s · ready in %s", name, clockText(plot.ReadyAt - now)))
			ctx.Sound.Play("Click", 0.9)
			UIUtil.Shake(plot.Plant)
			if canState.Mode == "rest" then
				sendCan(plot.Index)
			end
			return
		end
		plot.Pending = true
		plot.HeadScale.Scale = 0.85
		task.spawn(function()
			local callOk, success, result = pcall(function()
				return ctx.Net.Function("Garden"):InvokeServer("harvest", plot.Index)
			end)
			plot.Pending = false
			if not ctx.IsAlive() then
				return
			end
			if callOk and success == true and type(result) == "table" then
				local flower = flowersById[result.Flower or plot.Flower]
				local big = flower ~= nil and flower.Weight <= 9
				ctx.Sound.Play("Pop", big and 0.9 or 1.1)
				popPlot(plot, tonumber(result.Reward) or 0, result.Flower or plot.Flower, big)
				applyResult(result)
			else
				plot.HeadScale.Scale = 1
				ctx.Sound.Play("Error", 1)
				UIUtil.Shake(plot.Holder)
				local message = (callOk and type(result) == "string") and result or Locale.T("The garden is resting 🌙")
				showBubble(plotPoint(plot, PW / 2, SOIL_Y - 30), message, true)
			end
		end)
	end

	ctx.Connect(pill.Activated, function()
		if ripeCount < 2 or harvestingAll then
			if ripeCount == 1 then
				for _, plot in ipairs(plots) do
					if plot.Ripe then
						harvest(plot)
						break
					end
				end
			end
			return
		end
		harvestingAll = true
		task.spawn(function()
			local callOk, success, result = pcall(function()
				return ctx.Net.Function("Garden"):InvokeServer("harvestAll")
			end)
			harvestingAll = false
			if not ctx.IsAlive() then
				return
			end
			if callOk and success == true and type(result) == "table" and type(result.Harvested) == "table" then
				ctx.Sound.Play("Cash", 1)
				for order, entry in ipairs(result.Harvested) do
					local plot = type(entry) == "table" and plots[tonumber(entry.Plot) or 0]
					if plot then
						task.delay((order - 1) * 0.08, function()
							if ctx.IsAlive() then
								popPlot(plot, tonumber(entry.Reward) or 0, entry.Flower or plot.Flower)
							end
						end)
					end
				end
				applyResult(result)
				task.delay(0.35, function()
					if ctx.IsAlive() then
						ctx.FloatText(card, UDim2.fromOffset(W / 2, H / 2), "🧺 +" .. Format.Format(tonumber(result.Reward) or 0), GOLD, 30)
					end
				end)
			else
				ctx.Sound.Play("Error", 1)
				UIUtil.Shake(pill)
			end
		end)
	end)

	------------------------------------------------------------------
	-- État du serveur
	------------------------------------------------------------------
	local lastGarden = nil
	local function applyState()
		local data = ctx.State.Data
		local garden = data and data.Garden
		if type(garden) ~= "table" or garden == lastGarden then
			return
		end
		lastGarden = garden
		syncClock(garden.Now)
		applyPlots(garden.Plots)
		refreshPill(serverNow())
	end
	applyState()
	ctx.Connect(ctx.State.Changed, applyState)

	------------------------------------------------------------------
	-- Animation
	------------------------------------------------------------------
	local elapsed = 0
	local slowClock = 0

	local function lerp(a: number, b: number, t: number): number
		return a + (b - a) * t
	end
	local function smooth(t: number): number
		return t * t * (3 - 2 * t)
	end

	ctx.OnRender(function(dt: number)
		dt = math.min(dt, 0.1)
		if not isVisible() then
			return
		end
		elapsed += dt

		-- Soleil, nuages
		sunRays.Rotation = (sunRays.Rotation + dt * 8) % 360
		for _, cloud in ipairs(clouds) do
			cloud.X += cloud.Speed * dt
			if cloud.X > W + 10 then
				cloud.X = -60
			end
			cloud.Frame.Position = UDim2.fromOffset(cloud.X, cloud.Y)
		end

		-- Plantes : balancement (vent), fleurs mûres qui dansent et scintillent
		for _, plot in ipairs(plots) do
			local wind = math.sin(elapsed * 1.6 + plot.Sway) * (plot.Ripe and 6 or 3)
			plot.Plant.Rotation = wind
			if plot.Ripe and not plot.Popping then
				local pulse = (math.sin(elapsed * 3 + plot.Sway) + 1) / 2
				plot.Halo.BackgroundTransparency = 0.25 + pulse * 0.35
				local headY = plot.Head.Position.Y.Offset
				for s, spark in ipairs(plot.Sparks) do
					local angle = elapsed * 1.4 + s * (math.pi * 2 / MAX_SPARKS) + plot.Sway
					local twinkle = (math.sin(elapsed * 5 + s * 2) + 1) / 2
					spark.Frame.Position = UDim2.new(0.5, math.cos(angle) * 16, 0, headY + math.sin(angle) * 13)
					spark.Frame.Rotation = (elapsed * 90 + s * 40) % 360
					spark.Frame.Size = UDim2.fromOffset(4 + 5 * twinkle, 4 + 5 * twinkle)
					for _, bar in ipairs(spark.Bars) do
						bar.BackgroundTransparency = 0.6 - 0.6 * twinkle
					end
				end
			end
		end

		-- Papillons (Lissajous) : ailes qui battent, orientés vers leur direction
		for _, butterfly in ipairs(butterflies) do
			local t = elapsed * butterfly.Speed * math.pi * 2 + butterfly.Phase
			local x = butterfly.CX + math.sin(t) * 80 + math.sin(t * 2.3) * 16
			local y = butterfly.CY + math.sin(t * 1.7) * 26 + math.cos(t * 3.1) * 6
			x = math.clamp(x, 10, W - 10)
			y = math.clamp(y, HEADER_H + 6, H - 20)
			butterfly.Frame.Position = UDim2.fromOffset(x, y)
			local dx = x - butterfly.LastX
			butterfly.LastX = x
			butterfly.Frame.Rotation = math.clamp(dx * 4, -20, 20)
			local flap = math.abs(math.sin(elapsed * butterfly.Flap + butterfly.Phase))
			local width = math.max(2, math.floor(2 + 7 * flap + 0.5))
			for _, wing in ipairs(butterfly.Wings) do
				wing.Size = UDim2.fromOffset(width, 11)
			end
		end

		-- Arrosoir
		local cs = canState
		if cs.Mode == "rest" then
			cs.Pos = CAN_REST + Vector2.new(0, math.sin(elapsed * 2) * 1.5)
			cs.Tilt = math.sin(elapsed * 1.3) * 4
			cs.Next -= dt
			if cs.Next <= 0 then
				cs.Next = random:NextNumber(7, 11)
				-- Arrose un parterre qui pousse (au hasard)
				local candidates = {}
				for _, plot in ipairs(plots) do
					if not plot.Ripe and plot.Flower ~= "" then
						table.insert(candidates, plot.Index)
					end
				end
				if #candidates > 0 then
					sendCan(candidates[random:NextInteger(1, #candidates)])
				end
			end
		elseif cs.Mode == "fly" or cs.Mode == "back" then
			cs.T += dt
			local t = smooth(math.min(1, cs.T / cs.Dur))
			local arc = math.sin(t * math.pi) * -14
			cs.Pos = Vector2.new(lerp(cs.From.X, cs.To.X, t), lerp(cs.From.Y, cs.To.Y, t) + arc)
			cs.Tilt = math.sin(t * math.pi) * 8
			if t >= 1 then
				if cs.Mode == "fly" then
					cs.Mode = "pour"
					cs.Pour = 0
				else
					cs.Mode = "rest"
				end
			end
		elseif cs.Mode == "pour" then
			cs.Pour += dt
			cs.Tilt = lerp(cs.Tilt, 32, math.min(1, dt * 8))
			if cs.Pour > 0.25 and math.floor(cs.Pour * 14) ~= math.floor((cs.Pour - dt) * 14) and effectsOn() then
				local plot = plots[cs.Target]
				local floor = plot and plotPoint(plot, PW / 2, SOIL_Y + 3).Y or H - 20
				spawnDrop(cs.Pos.X + 17, cs.Pos.Y + 6, floor)
			end
			if cs.Pour > 1.5 then
				cs.Mode = "back"
				cs.From = cs.Pos
				cs.To = CAN_REST
				cs.T = 0
				cs.Dur = 0.8
			end
		end
		can.Position = UDim2.fromOffset(cs.Pos.X, cs.Pos.Y)
		can.Rotation = cs.Tilt

		-- Gouttes d'eau
		if activeDrops > 0 then
			for _, drop in ipairs(drops) do
				if drop.Active then
					drop.VY += 260 * dt
					drop.Y += drop.VY * dt
					if drop.Y >= drop.Floor then
						drop.Active = false
						drop.Frame.Visible = false
						activeDrops -= 1
					else
						drop.Frame.Position = UDim2.fromOffset(drop.X, drop.Y)
					end
				end
			end
		end

		-- Bulle d'info
		if bubble.Visible and os.clock() > bubbleUntil then
			bubble.Visible = false
		end

		-- Minuteurs (4 fois par seconde)
		slowClock += dt
		if slowClock >= 0.25 then
			slowClock = 0
			local now = serverNow()
			for _, plot in ipairs(plots) do
				local wasRipe = plot.Ripe
				refreshPlot(plot, now)
				if plot.Ripe and not wasRipe and plot.Flower ~= "" and effectsOn() then
					-- Une fleur vient d'éclore : petite étincelle
					local point = plotPoint(plot, PW / 2, BASE_Y - 32 * plantBoost)
					ctx.Effects.Burst(card, UDim2.fromOffset(point.X, point.Y), GOLD, 6)
				end
			end
			refreshPill(now)
			if lastPillMode == "all" then
				pillScale.Scale = 1 + math.abs(math.sin(elapsed * 3)) * 0.04
			end
		end
	end)
end

return Garden
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="116">
          <Properties>
            <string name="Name">Gear</string>
          </Properties>
          <Item class="ModuleScript" referent="117">
            <Properties>
              <string name="Name">ClickableKeys</string>
              <string name="Source"><![CDATA[--[[
	ClickableKeys (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Stimuli > Gear > ClickableKeys

	v9.1 : tout ce qui rend un clavier dessiné CLIQUABLE (partagé par le
	clavier mécanique et le clavier corail) :
	  - dessin posé (GearPiece) en deux formes : "Full" (QWERTY complet) et
	    "Mini" (petit clavier résumé, quand la place manque) ;
	  - chaque touche = un bouton : appui -> la touche s'enfonce, son de touche
	    (GearClick.PlayKeySound, selon le niveau), VRAI clic (GearClick.Click :
	    même chemin que le gros bouton) ;
	  - touches trop petites pour être visées (< 22 px réels sur PC, < 34 px
	    en tactile) : badge 🔍 et un appui ouvre le GRAND clavier flottant
	    (KeyboardPanel), dessiné avec la même fonction, en grand ;
	  - vrai clavier du joueur (KeyInput) : la touche correspondante s'enfonce
	    (grand clavier s'il est ouvert, sinon le clavier posé) et clique.

	API : ClickableKeys.new(ctx, piece, animator, options) -> controller
	  options = {
	    Id: string,                 -- source du clic ("Keyboard", "CoralKeys")
	    InputPriority: number,      -- (KeyInput) le plus petit clique
	    StepFull, StepMini: number, -- pas des touches du dessin posé (échelle 1)
	    Draw: (root, layout, step, level) -> (keys, largeur, hauteur, extra),
	    Title: () -> string, Tray: Color3?, BadgeInk: Color3?,
	    Lit: ((level) -> Color3?)?, -- couleur d'une touche enfoncée (nil = assombrie)
	    SoundPitch: number?, SoundShift: number?,
	    OnBuilt: ((root, keys, extra, mini) -> ())?,      -- dessin posé refait
	    OnPanelBuilt: ((keys, extra) -> ())?,             -- grand clavier refait
	    OnStrike: ((key, point) -> ())?,                  -- touche frappée (effets en plus)
	  }
	  controller.Keys / controller.PanelKeys / controller.Panel
	  controller:Build(level), controller:AnimateKey(key, delay?),
	  controller:KeyPoint(key) -> Vector2?, controller:Wiggle(), controller:Destroy()
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Locale = require(ReplicatedStorage.Shared.Locale)
local GearKit = require(script.Parent.GearKit)
local KeyboardArt = require(script.Parent.KeyboardArt)
local GearClick = require(script.Parent.GearClick)
local KeyInput = require(script.Parent.KeyInput)
local KeyboardPanel = require(script.Parent.KeyboardPanel)

local ClickableKeys = {}
ClickableKeys.__index = ClickableKeys

local DIRECT_DESKTOP = 22 -- taille réelle minimale d'une touche pour la viser (px)
local DIRECT_TOUCH = 34

type Key = KeyboardArt.Key

local function isPress(input: InputObject): boolean
	local kind = input.UserInputType
	return kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch
end

function ClickableKeys.new(ctx: any, piece: any, animator: GearKit.Animator, options: { [string]: any })
	local self = setmetatable({
		Ctx = ctx,
		Piece = piece,
		Animator = animator,
		Options = options,
		Art = nil :: Frame?,
		Keys = {} :: { Key },
		PanelKeys = {} :: { Key },
		KeyUnit = options.StepFull,
		Direct = false,
		Badge = nil :: Frame?,
		Panel = nil :: any,
	}, ClickableKeys)
	local random = ctx.Random

	local function level(): number
		return math.max(1, piece.Level)
	end
	self.Level = level

	-- Grand clavier flottant (construit au premier affichage)
	self.Panel = KeyboardPanel.new(ctx, {
		Id = options.Id,
		Title = options.Title,
		Tray = options.Tray,
		Build = function(parent: Frame, step: number)
			for _, key in ipairs(self.PanelKeys) do
				animator:Stop(key)
			end
			local keys, W, H, extra = options.Draw(parent, "Full", step, level())
			self.PanelKeys = keys
			local callback = options.OnPanelBuilt
			if callback then
				callback(keys, extra)
			end
			return keys, W, H
		end,
		OnKey = function(key: Key)
			self:Strike(key, self.Panel:KeyPoint(key))
		end,
	})

	-- Vrai clavier du joueur -> touches du jeu
	KeyInput.Register(options.Id, {
		Priority = options.InputPriority or 1,
		Active = function(): boolean
			-- (même si le clavier n'a pas de place à l'écran : on tape quand même)
			return ctx.IsAlive() and ctx.GetVisibility() == "Visible"
		end,
		Press = function(code: string, doClick: boolean)
			local key: Key? = nil
			local point: Vector2? = nil
			if self.Panel:IsOpen() then
				key = KeyboardArt.Find(self.PanelKeys, code)
				if key then
					point = self.Panel:KeyPoint(key)
				end
			else
				key = KeyboardArt.Find(self.Keys, code) or KeyboardArt.Pick(self.Keys, 1, random)[1]
				if key then
					point = self:KeyPoint(key)
				end
			end
			if doClick then
				self:Strike(key, point)
			elseif key then
				self:AnimateKey(key)
			end
		end,
	})

	-- Crochets de l'accessoire
	piece.OnShape = function(_shape, _size)
		self:Build(level())
	end
	piece.OnPlaced = function(_placement, _first)
		self:RefreshMode()
	end
	piece.OnHidden = function()
		self:RefreshMode()
	end
	ctx.Connect(ctx.Interface.ScaleChanged, function()
		self:RefreshMode()
	end)
	ctx.Connect(ctx.Interface.DeviceChanged, function()
		self:RefreshMode()
	end)
	return self
end

-- Animation d'une touche (enfoncée puis relâchée)
function ClickableKeys.AnimateKey(self: any, key: Key, delay: number?)
	local wait = delay or 0
	local litFn = self.Options.Lit
	local lit = litFn and litFn(self.Level()) or nil
	self.Animator:Play(key, 0.17 + wait, function(t)
		local k = math.clamp((t * (0.17 + wait) - wait) / 0.17, 0, 1)
		local amount = k < 0.35 and k / 0.35 or 1 - (k - 0.35) / 0.65
		KeyboardArt.Press(key, amount, lit)
	end, function()
		KeyboardArt.Press(key, 0)
	end)
end

-- Point de la toile au-dessus d'une touche du clavier posé
function ClickableKeys.KeyPoint(self: any, key: Key): Vector2?
	return self.Piece:ToCanvas(Vector2.new(key.X + key.W / 2, key.Y))
end

-- Une touche frappée : animation, son de touche, vrai clic
function ClickableKeys.Strike(self: any, key: Key?, point: Vector2?)
	local options = self.Options
	if key then
		self:AnimateKey(key)
	end
	GearClick.PlayKeySound(self.Level(), options.SoundPitch, options.SoundShift)
	GearClick.Click(options.Id, point)
	local callback = options.OnStrike
	if callback and key then
		callback(key, point)
	end
end

-- Les touches posées sont-elles assez grandes pour être visées ?
function ClickableKeys.RefreshMode(self: any)
	local ctx = self.Ctx
	local placement = self.Piece.Placement
	local real = 0
	if placement then
		real = self.KeyUnit * placement.Scale * math.max(0.01, ctx.Interface.Scale or 1)
	end
	local touch = ctx.Interface.Device ~= "Desktop"
	self.Direct = real >= (touch and DIRECT_TOUCH or DIRECT_DESKTOP)
	local badge = self.Badge
	if badge then
		badge.Visible = placement ~= nil and not self.Direct
	end
end

-- (Re)dessine le clavier posé
function ClickableKeys.Build(self: any, lv: number)
	local options = self.Options
	local piece = self.Piece
	for _, key in ipairs(self.Keys) do
		self.Animator:Stop(key)
	end
	if self.Art then
		self.Art:Destroy()
	end
	local mini = piece.Shape > 0
	local size = piece.Size
	local root = Instance.new("Frame")
	root.Name = "Art"
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromOffset(size.X, size.Y)
	root.ZIndex = 2
	local step = mini and options.StepMini or options.StepFull
	local keys, W, _H, extra = options.Draw(root, mini and "Mini" or "Full", step, lv)
	self.Keys = keys
	self.KeyUnit = keys[1] and keys[1].H or step

	-- Badge 🔍 : "appuie pour ouvrir le grand clavier"
	local badgeSize = step * 1.3
	local badge = GearKit.Box(root, W - badgeSize * 0.32, badgeSize * 0.32, badgeSize, badgeSize, Color3.new(1, 1, 1), {
		Name = "ExpandBadge",
		Anchor = Vector2.new(0.5, 0.5),
		Radius = "round",
		Z = 30,
	})
	local stroke = Instance.new("UIStroke")
	stroke.Color = options.BadgeInk or Color3.fromRGB(52, 44, 72)
	stroke.Thickness = 2
	stroke.Parent = badge
	local icon = Instance.new("TextLabel")
	icon.Name = "Icon"
	icon.BackgroundTransparency = 1
	icon.Size = UDim2.fromScale(1, 1)
	icon.Font = Enum.Font.BuilderSansBold
	icon.Text = "🔍"
	icon.TextSize = math.floor(badgeSize * 0.6)
	icon.ZIndex = 31
	icon.Parent = badge
	badge.Visible = false
	self.Badge = badge

	-- Chaque touche est un vrai bouton
	for _, key in ipairs(keys) do
		key.Button.InputBegan:Connect(function(input: InputObject)
			if not isPress(input) then
				return
			end
			if self.Direct then
				self:Strike(key, self:KeyPoint(key))
			else
				self:AnimateKey(key)
				self.Panel:Open()
			end
		end)
	end

	root.Parent = piece.Content
	self.Art = root
	local callback = options.OnBuilt
	if callback then
		callback(root, keys, extra, mini)
	end
	self:RefreshMode()
end

-- Le niveau a changé : dessin posé et grand clavier refaits
function ClickableKeys.LevelChanged(self: any, lv: number)
	self:Build(lv)
	self.Panel:MarkDirty()
end

-- Le badge 🔍 fait coucou (au repos)
function ClickableKeys.Wiggle(self: any)
	local badge = self.Badge
	if badge and badge.Visible then
		self.Animator:Play("badge", 0.5, function(t)
			badge.Rotation = math.sin(t * math.pi * 3) * 14 * (1 - t)
		end, function()
			badge.Rotation = 0
		end)
	end
end

-- Titre du grand clavier : "<icône> <nom>  •  Niv. N"
function ClickableKeys.TitleFor(icon: string, name: string, lv: number): string
	return icon .. " " .. Locale.T(name) .. "  •  " .. Locale.T("Lv. %s", tostring(lv))
end

function ClickableKeys.Destroy(self: any)
	KeyInput.Unregister(self.Options.Id)
	self.Panel:Destroy()
end

return ClickableKeys
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="118">
            <Properties>
              <string name="Name">GearClick</string>
              <string name="Source"><![CDATA[--[[
	GearClick (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Stimuli > Gear > GearClick

	v9.1 : les accessoires CLIQUABLES (touches du clavier mécanique, du
	clavier corail, souris gaming) cliquent pour de vrai, par le même chemin
	que le gros bouton "Click me" :
	  - ClientState.Click() (gain prédit, combo, envoi au serveur qui
	    compte le clic : quêtes, statistiques, limite de clics par seconde) ;
	  - le "+X" qui s'envole (même couleur / style que le gros bouton :
	    Effects.AmountStyle, Effects.Pop) près de l'objet cliqué ;
	  - ClientState.Clicked est déclenché par ClientState.Click() : les
	    autres accessoires s'animent comme pour un clic sur le bouton.
	GearClick.Source vaut l'Id de l'accessoire PENDANT ce clic (les
	écouteurs de ClientState.Clicked savent d'où vient le clic).

	Sons de touches (exception v9.1 demandée par le joueur) : uniquement les
	sons existants Config.ClickSounds "Keyboard1".."Keyboard5", choisis selon
	le niveau de l'amélioration, joués par SoundManager (réglage Son et
	volume des effets respectés).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent.Parent
local ClientState = require(Client.ClientState)
local Effects = require(Client.Effects)
local SoundManager = require(Client.SoundManager)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)

local GearClick = {}

GearClick.Source = nil :: string?

local random = Random.new()

local function formatAmount(value: number): string
	if value >= 1e6 then
		return NumberFormatter.Format(value)
	elseif value < 10 and value % 1 ~= 0 then
		return NumberFormatter.Format(value)
	end
	return NumberFormatter.WithSpaces(value)
end

-- Un vrai clic depuis l'accessoire `source` ; `point` = position sur la toile
-- (pixels "design") où faire s'envoler le "+X". Renvoie le gain (nil = refusé :
-- trop rapide, état pas encore reçu...).
function GearClick.Click(source: string, point: Vector2?): number?
	GearClick.Source = source
	local ok, gain = pcall(ClientState.Click)
	GearClick.Source = nil
	if not ok then
		warn("[GearClick] " .. tostring(gain))
		return nil
	end
	if not gain then
		return nil
	end
	local layer = Effects.GetLayer()
	if layer and point then
		local data = ClientState.Data
		local base = tonumber(data and data.ClickValue) or gain
		local color, style = Effects.AmountStyle(gain, base, ClientState.DarkMode)
		local ratio = math.clamp(ClientState.GetComboMeter() / 100, 0, 1)
		local position = UDim2.fromOffset(point.X + random:NextNumber(-10, 10), point.Y - 4)
		Effects.Pop(layer, position, "+" .. formatAmount(gain), { Color = color, Size = 24 + ratio * 8, Style = style, Rise = 30 })
	end
	return gain
end

-- Son du clic choisi par le joueur (le même que le gros bouton : souris)
function GearClick.PlayClickSound()
	local ratio = math.clamp(ClientState.GetComboMeter() / 100, 0, 1)
	SoundManager.PlayClick(0.95 + ratio * 0.6 + random:NextNumber(0, 0.08))
end

-- Son de touche selon le niveau : 1-2 -> Keyboard1, 3-5 -> 2, 6-7 -> 3,
-- 8-10 -> 4, 11+ -> 5 (`shift` décale le palier, ex. clavier corail)
function GearClick.KeySoundId(level: number, shift: number?): string
	local tier = 1
	if level >= 11 then
		tier = 5
	elseif level >= 8 then
		tier = 4
	elseif level >= 6 then
		tier = 3
	elseif level >= 3 then
		tier = 2
	end
	tier = math.clamp(tier + (shift or 0), 1, 5)
	return "Keyboard" .. tostring(tier)
end

local lastKeySound = 0

-- Joue le son d'une touche (hauteur un peu variable ; `pitch` de base)
function GearClick.PlayKeySound(level: number, pitch: number?, shift: number?)
	local now = os.clock()
	if now - lastKeySound < 0.03 then
		return
	end
	lastKeySound = now
	local id = GearClick.KeySoundId(level, shift)
	local speed = (pitch or 1) * random:NextNumber(0.96, 1.04)
	local play = (SoundManager :: any).PlayKeySound
	if type(play) == "function" then
		play(id, speed)
	else
		SoundManager.PreviewClickSound(id)
	end
end

return GearClick
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="119">
            <Properties>
              <string name="Name">GearKit</string>
              <string name="Source"><![CDATA[--[[
	GearKit (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Stimuli > Gear > GearKit

	Boîte à outils partagée des "accessoires de clic" (v9, CLICKGEAR) :
	Finger, Keyboard, Mouse, MegaFinger, CoralKeys, QuantumFinger, NeuralLink.

	  - dessin en Frames : rectangles arrondis, ovales, contours "silhouette"
	    (une forme sombre un peu plus grande DERRIÈRE la forme colorée : le
	    contour grandit / rétrécit avec les UIScale, contrairement aux UIStroke) ;
	  - le gros bouton "ClickButton" : recherche (mise en cache) et rectangle
	    sur la toile (pixels "design", taille de repos : le survol / l'écrasement
	    du bouton ne font pas bouger les accessoires) ;
	  - Animator : animations pilotées par ctx.OnRender, branché UNIQUEMENT
	    pendant qu'une animation tourne (rien ne tourne image par image au repos) ;
	  - Every : petite vie "au repos" (une animation courte toutes les X s,
	    seulement si le stimulus est visible) ;
	  - Pool : objets réutilisés (aucune instance créée à chaque clic) ;
	  - courbes d'animation (Ease) et petits calculs de géométrie.
]]

local Client = script.Parent.Parent.Parent
local Interface = require(Client.Interface)

local GearKit = {}

export type Rect = { X0: number, Y0: number, X1: number, Y1: number }

----------------------------------------------------------------------
-- Couleurs communes
----------------------------------------------------------------------

GearKit.Ink = Color3.fromRGB(46, 34, 58) -- contour "encre" des dessins
GearKit.White = Color3.new(1, 1, 1)

-- Couleur d'un arc-en-ciel (h dans [0, 1[), douce ou vive
function GearKit.Rainbow(h: number, saturation: number?, value: number?): Color3
	return Color3.fromHSV(h % 1, saturation or 0.75, value or 1)
end

-- Dégradé arc-en-ciel (7 points, sous la limite Roblox de 20)
function GearKit.RainbowSequence(offset: number?, saturation: number?): ColorSequence
	local points = {}
	local shift = offset or 0
	for index = 0, 6 do
		local t = index / 6
		table.insert(points, ColorSequenceKeypoint.new(t, Color3.fromHSV((t + shift) % 1, saturation or 0.8, 1)))
	end
	return ColorSequence.new(points)
end

----------------------------------------------------------------------
-- Courbes d'animation (t dans [0, 1])
----------------------------------------------------------------------

GearKit.Ease = {
	Linear = function(t: number): number
		return t
	end,
	OutQuad = function(t: number): number
		return 1 - (1 - t) * (1 - t)
	end,
	InQuad = function(t: number): number
		return t * t
	end,
	OutCubic = function(t: number): number
		local u = 1 - t
		return 1 - u * u * u
	end,
	InOutSine = function(t: number): number
		return -(math.cos(math.pi * t) - 1) / 2
	end,
	OutBack = function(t: number): number
		local c1 = 1.70158
		local c3 = c1 + 1
		local u = t - 1
		return 1 + c3 * u * u * u + c1 * u * u
	end,
	OutElastic = function(t: number): number
		if t <= 0 then
			return 0
		elseif t >= 1 then
			return 1
		end
		return 2 ^ (-10 * t) * math.sin((t * 10 - 0.75) * (2 * math.pi) / 3) + 1
	end,
}

-- Bosse 0 -> 1 -> 0 (sinus)
function GearKit.Bump(t: number): number
	return math.sin(math.clamp(t, 0, 1) * math.pi)
end

function GearKit.Lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

----------------------------------------------------------------------
-- Dessin
----------------------------------------------------------------------

-- Frame simple. props : Name, Z, Radius (nombre, ou "round" = pilule),
-- Transparency, Rotation, Anchor (Vector2), Visible, Gradient (ColorSequence),
-- GradientRotation, GradientTransparency (NumberSequence)
function GearKit.Box(parent: Instance, x: number, y: number, w: number, h: number, color: Color3, props: { [string]: any }?): Frame
	local p = props or {}
	local frame = Instance.new("Frame")
	frame.Name = p.Name or "Part"
	frame.BorderSizePixel = 0
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = p.Transparency or 0
	frame.Position = UDim2.fromOffset(x, y)
	frame.Size = UDim2.fromOffset(w, h)
	if p.Anchor then
		frame.AnchorPoint = p.Anchor
	end
	frame.ZIndex = p.Z or 1
	if p.Rotation then
		frame.Rotation = p.Rotation
	end
	if p.Visible == false then
		frame.Visible = false
	end
	local radius = p.Radius
	if radius == "round" then
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = frame
	elseif type(radius) == "number" and radius > 0 then
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, radius)
		corner.Parent = frame
	end
	if p.Gradient or p.GradientTransparency then
		local gradient = Instance.new("UIGradient")
		if p.Gradient then
			gradient.Color = p.Gradient
		end
		if p.GradientTransparency then
			gradient.Transparency = p.GradientTransparency
		end
		gradient.Rotation = p.GradientRotation or 90
		gradient.Parent = frame
	end
	frame.Parent = parent
	return frame
end

-- Forme colorée + sa silhouette de contour (derrière, `outline` px plus grande).
-- Toutes les silhouettes d'un dessin ont un ZIndex plus petit que toutes les
-- formes colorées : le contour entoure l'ENSEMBLE du dessin (pas de traits
-- entre deux formes qui se touchent). Renvoie (forme, silhouette).
function GearKit.Outlined(
	parent: Instance,
	x: number,
	y: number,
	w: number,
	h: number,
	color: Color3,
	props: { [string]: any }?
): (Frame, Frame)
	local p = props or {}
	local outline = p.Outline or 2.5
	local radius = p.Radius
	local lineRadius = radius
	if type(radius) == "number" then
		lineRadius = radius + outline
	end
	local line = GearKit.Box(parent, x - outline, y - outline, w + outline * 2, h + outline * 2, p.OutlineColor or GearKit.Ink, {
		Name = (p.Name or "Part") .. "Line",
		Z = p.LineZ or 1,
		Radius = lineRadius,
		Rotation = p.Rotation,
		Transparency = p.OutlineTransparency,
		Visible = p.Visible,
	})
	local fill = GearKit.Box(parent, x, y, w, h, color, {
		Name = p.Name,
		Z = p.Z or 3,
		Radius = radius,
		Rotation = p.Rotation,
		Gradient = p.Gradient,
		GradientRotation = p.GradientRotation,
		GradientTransparency = p.GradientTransparency,
		Transparency = p.Transparency,
		Visible = p.Visible,
	})
	return fill, line
end

-- Reflet blanc doux (ovale semi-transparent)
function GearKit.Shine(parent: Instance, x: number, y: number, w: number, h: number, transparency: number?, z: number?, rotation: number?): Frame
	return GearKit.Box(parent, x, y, w, h, GearKit.White, {
		Name = "Shine",
		Radius = "round",
		Transparency = transparency or 0.45,
		Z = z or 6,
		Rotation = rotation,
	})
end

-- Petite étoile à 4 branches (deux losanges) centrée en (cx, cy)
function GearKit.Star(parent: Instance, cx: number, cy: number, size: number, color: Color3, z: number?): Frame
	local holder = Instance.new("Frame")
	holder.Name = "Star"
	holder.BackgroundTransparency = 1
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.Position = UDim2.fromOffset(cx, cy)
	holder.Size = UDim2.fromOffset(size, size)
	holder.ZIndex = z or 8
	for index = 0, 1 do
		local arm = GearKit.Box(holder, size / 2, size / 2, size * 0.28, size, color, {
			Name = "Arm",
			Anchor = Vector2.new(0.5, 0.5),
			Radius = "round",
			Rotation = index * 90,
			Z = z or 8,
		})
		arm.Name = "Arm" .. index
	end
	holder.Parent = parent
	return holder
end

-- Fixe l'opacité de tout un dessin : `base` garde la transparence d'origine
-- de chaque Frame (mesurée au premier appel) ; alpha = 0 (visible) .. 1 (invisible)
function GearKit.CaptureTransparency(root: Instance): { [Instance]: number }
	local base = {}
	for _, item in ipairs(root:GetDescendants()) do
		if item:IsA("Frame") then
			base[item] = item.BackgroundTransparency
		elseif item:IsA("TextLabel") then
			base[item] = item.TextTransparency
		end
	end
	if root:IsA("Frame") then
		base[root] = root.BackgroundTransparency
	end
	return base
end

function GearKit.ApplyFade(base: { [Instance]: number }, alpha: number)
	for item, original in pairs(base) do
		local value = original + (1 - original) * alpha
		if item:IsA("TextLabel") then
			item.TextTransparency = value
		else
			(item :: Frame).BackgroundTransparency = value
		end
	end
end

-- Cadre plein écran dans le calque Overlay pour les effets PASSAGERS d'un
-- stimulus dont le dessin permanent est dans le calque Background.
-- (à détruire dans Stop : il n'appartient pas au conteneur du stimulus)
function GearKit.FXLayer(ctx: any, name: string): Frame
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.fromScale(1, 1)
	frame.Active = false
	frame.ZIndex = 30
	frame.Parent = ctx.Overlay or ctx.Container
	return frame
end

----------------------------------------------------------------------
-- Toile et gros bouton
----------------------------------------------------------------------

function GearKit.Rect(x0: number, y0: number, x1: number, y1: number): Rect
	return { X0 = x0, Y0 = y0, X1 = x1, Y1 = y1 }
end

-- Rectangle d'un GuiObject sur la toile (pixels "design")
function GearKit.CanvasRect(object: GuiObject): Rect
	local root = Interface.Root
	local scale = math.max(Interface.Scale, 0.01)
	local origin = root and root.AbsolutePosition or Vector2.zero
	local position = (object.AbsolutePosition - origin) / scale
	local size = object.AbsoluteSize / scale
	return { X0 = position.X, Y0 = position.Y, X1 = position.X + size.X, Y1 = position.Y + size.Y }
end

function GearKit.CanvasSize(): Vector2
	return Interface.CanvasSize or Vector2.new(1280, 720)
end

local cachedButton: GuiObject? = nil

-- Le gros bouton "ClickButton" (colonne centrale), ou nil
function GearKit.GetButton(): GuiObject?
	local button = cachedButton
	if button and button.Parent then
		return button
	end
	cachedButton = nil
	local main = Interface.Layers and Interface.Layers.Main
	if not main then
		return nil
	end
	local found = main:FindFirstChild("ClickButton", true)
	if found and found:IsA("GuiObject") then
		cachedButton = found
		return found
	end
	return nil
end

-- Rectangle de repos du bouton sur la toile : centre réel, taille "design"
-- du support (ClickerHolder) ; nil si le bouton n'existe pas encore
function GearKit.GetButtonRect(): Rect?
	local button = GearKit.GetButton()
	if not button then
		return nil
	end
	local holder = button.Parent
	local reference: GuiObject = button
	if holder and holder:IsA("GuiObject") and holder.Name ~= "Main" then
		reference = holder
	end
	local rect = GearKit.CanvasRect(reference)
	local cx, cy = (rect.X0 + rect.X1) / 2, (rect.Y0 + rect.Y1) / 2
	local w, h = reference.Size.X.Offset, reference.Size.Y.Offset
	if w <= 0 or h <= 0 then
		w, h = rect.X1 - rect.X0, rect.Y1 - rect.Y0
	end
	if w <= 0 or h <= 0 then
		return nil
	end
	return { X0 = cx - w / 2, Y0 = cy - h / 2, X1 = cx + w / 2, Y1 = cy + h / 2 }
end

function GearKit.Center(rect: Rect): Vector2
	return Vector2.new((rect.X0 + rect.X1) / 2, (rect.Y0 + rect.Y1) / 2)
end

-- Point du bord de `rect` le plus proche de `point`
function GearKit.ClosestOnRect(rect: Rect, point: Vector2): Vector2
	local x = math.clamp(point.X, rect.X0, rect.X1)
	local y = math.clamp(point.Y, rect.Y0, rect.Y1)
	if x > rect.X0 and x < rect.X1 and y > rect.Y0 and y < rect.Y1 then
		-- point à l'intérieur : bord le plus proche
		local left, right, top, bottom = x - rect.X0, rect.X1 - x, y - rect.Y0, rect.Y1 - y
		local best = math.min(left, right, top, bottom)
		if best == left then
			x = rect.X0
		elseif best == right then
			x = rect.X1
		elseif best == top then
			y = rect.Y0
		else
			y = rect.Y1
		end
	end
	return Vector2.new(x, y)
end

-- Distance entre deux rectangles (0 s'ils se touchent / se chevauchent)
function GearKit.RectGap(a: Rect, b: Rect): number
	local dx = math.max(0, math.max(a.X0 - b.X1, b.X0 - a.X1))
	local dy = math.max(0, math.max(a.Y0 - b.Y1, b.Y0 - a.Y1))
	return math.sqrt(dx * dx + dy * dy)
end

-- Distance parcourue depuis `origin` dans la direction `dir` (unitaire)
-- avant d'entrer dans `rect` (math.huge si jamais)
function GearKit.RayToRect(origin: Vector2, dir: Vector2, rect: Rect): number
	local tMin, tMax = 0, math.huge
	for axis = 1, 2 do
		local o = axis == 1 and origin.X or origin.Y
		local d = axis == 1 and dir.X or dir.Y
		local lo = axis == 1 and rect.X0 or rect.Y0
		local hi = axis == 1 and rect.X1 or rect.Y1
		if math.abs(d) < 1e-6 then
			if o < lo or o > hi then
				return math.huge
			end
		else
			local t1, t2 = (lo - o) / d, (hi - o) / d
			if t1 > t2 then
				t1, t2 = t2, t1
			end
			tMin = math.max(tMin, t1)
			tMax = math.min(tMax, t2)
			if tMin > tMax then
				return math.huge
			end
		end
	end
	return tMin
end

-- Angle (degrés, sens horaire, 0 = vers le haut) pour viser `to` depuis `from`
function GearKit.AimAngle(from: Vector2, to: Vector2): number
	local d = to - from
	if d.Magnitude < 1e-3 then
		return 0
	end
	return math.deg(math.atan2(d.X, -d.Y))
end

-- Vecteur unitaire correspondant à un angle de AimAngle
function GearKit.AngleDir(angle: number): Vector2
	local r = math.rad(angle)
	return Vector2.new(math.sin(r), -math.cos(r))
end

----------------------------------------------------------------------
-- Animator : animations pilotées par ctx.OnRender, branché à la demande
----------------------------------------------------------------------

export type Animator = {
	Play: (self: Animator, key: any, duration: number, step: (t: number) -> (), done: (() -> ())?) -> (),
	Stop: (self: Animator, key: any, finish: boolean?) -> (),
	StopAll: (self: Animator) -> (),
	IsPlaying: (self: Animator, key: any) -> boolean,
	Count: (self: Animator) -> number,
}

type Track = { Key: any, T: number, D: number, Step: (t: number) -> (), Done: (() -> ())?, Dead: boolean }

function GearKit.Animator(ctx: any): Animator
	local list: { Track } = {}
	local byKey: { [any]: Track } = {}
	local connection: any = nil

	local function onRender(dt: number)
		local count = #list
		for index = 1, count do
			local track = list[index]
			if not track.Dead then
				track.T += dt
				local t = track.D > 0 and math.min(1, track.T / track.D) or 1
				track.Step(t)
				if t >= 1 then
					track.Dead = true
				end
			end
		end
		-- Nettoyage (les fins d'animation sont appelées APRÈS : elles peuvent relancer)
		local finished = nil
		local kept = {}
		for _, track in ipairs(list) do
			if track.Dead then
				if track.Key ~= nil and byKey[track.Key] == track then
					byKey[track.Key] = nil
				end
				if track.Done then
					finished = finished or {}
					table.insert(finished, track.Done)
				end
			else
				table.insert(kept, track)
			end
		end
		list = kept
		if finished then
			for _, done in ipairs(finished) do
				done()
			end
		end
		if #list == 0 and connection then
			connection:Disconnect()
			connection = nil
		end
	end

	local animator = {}

	function animator.Play(_self, key: any, duration: number, step: (t: number) -> (), done: (() -> ())?)
		local track = key ~= nil and byKey[key] or nil
		if track and not track.Dead then
			track.T = 0
			track.D = duration
			track.Step = step
			track.Done = done
		else
			track = { Key = key, T = 0, D = duration, Step = step, Done = done, Dead = false }
			table.insert(list, track :: Track)
			if key ~= nil then
				byKey[key] = track :: Track
			end
		end
		step(0)
		if not connection or not connection.Connected then
			connection = ctx.OnRender(onRender)
		end
	end

	-- Arrête une animation (finish = true : applique la fin et appelle Done)
	function animator.Stop(_self, key: any, finish: boolean?)
		local track = byKey[key]
		if not track or track.Dead then
			return
		end
		track.Dead = true
		byKey[key] = nil
		if finish then
			track.Step(1)
			if track.Done then
				track.Done()
			end
		end
	end

	function animator.StopAll(_self)
		for _, track in ipairs(list) do
			track.Dead = true
		end
		table.clear(byKey)
	end

	function animator.IsPlaying(_self, key: any): boolean
		local track = byKey[key]
		return track ~= nil and not track.Dead
	end

	function animator.Count(_self): number
		local count = 0
		for _, track in ipairs(list) do
			if not track.Dead then
				count += 1
			end
		end
		return count
	end

	return (animator :: any) :: Animator
end

----------------------------------------------------------------------
-- Vie au repos : fn() toutes les minDelay..maxDelay secondes (si visible)
----------------------------------------------------------------------

function GearKit.Every(ctx: any, minDelay: number, maxDelay: number, fn: () -> ())
	local random = ctx.Random or Random.new()
	local function schedule()
		task.delay(random:NextNumber(minDelay, maxDelay), function()
			if not ctx.IsAlive() then
				return
			end
			if ctx.IsVisible() then
				local ok, err = pcall(fn)
				if not ok then
					warn("[Gear] " .. tostring(ctx.Feature) .. " : " .. tostring(err))
				end
			end
			schedule()
		end)
	end
	schedule()
end

----------------------------------------------------------------------
-- Pool : objets réutilisés à tour de rôle (jamais créés pendant un clic)
----------------------------------------------------------------------

export type Pool<T> = { Items: { T }, Next: (self: Pool<T>) -> T }

function GearKit.Pool<T>(count: number, create: (index: number) -> T): Pool<T>
	local items = {}
	for index = 1, count do
		items[index] = create(index)
	end
	local cursor = 0
	local pool = { Items = items }
	function pool.Next(_self): T
		cursor = cursor % #items + 1
		return items[cursor]
	end
	return (pool :: any) :: Pool<T>
end

----------------------------------------------------------------------
-- Divers
----------------------------------------------------------------------

-- Vrai si le joueur n'a pas coupé les effets (particules) dans ⚙️
function GearKit.EffectsOn(ctx: any): boolean
	local data = ctx.State.Data
	return not (data and data.Settings and data.Settings.Effects == false)
end

-- Niveau d'une amélioration (0 si pas possédée)
function GearKit.Level(ctx: any, upgradeId: string): number
	local level = tonumber(ctx.GetLevel(upgradeId)) or 0
	return math.max(0, math.floor(level))
end

return GearKit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="120">
            <Properties>
              <string name="Name">GearLayout</string>
              <string name="Source"><![CDATA[--[[
	GearLayout (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Stimuli > Gear > GearLayout

	Range les accessoires de clic possédés (doigt, clavier, souris, tour de
	force du Méga doigt, clavier corail, cerveau du Neural Link...) dans l'espace
	LIBRE autour de la colonne centrale, sans jamais recouvrir :
	  - les cartes des stimuli (calque Slots, bandeau d'actu compris) ;
	  - le bouton "Click me" (+ chapeau / robot), le bouton 🏠, les pastilles
	    VIP / bonus / boost, le compteur de Dopamine, la ligne "par seconde",
	    les pastilles des menus, la jauge de combo, la barre d'améliorations ;
	  - les objets marqués par l'attribut LayoutObstacle = true dans les calques
	    Overlay / Background (convention partagée avec les autres stimuli) ;
	  - les autres accessoires (jamais deux accessoires l'un sur l'autre).

	Territoire (règle partagée avec les stimuli cosmiques, v9) : les accessoires
	restent dans la BANDE CENTRALE — entre les colonnes des slots de côté
	(L1 / L2 et R1 / R2, présents ou non) et AU-DESSUS du bas réel de la barre
	d'améliorations : autour du bouton et du compteur, à côté des menus, dans les
	poches à côté de la barre. Les gouttières entre les cartes du bas, les
	couloirs de côté et l'espace sous la barre sont aux stimuli cosmiques.

	Principe : une grille de cases de 8 px "design" marque ce qui est occupé
	(avec une marge), une table de sommes cumulées répond en O(1) "ce rectangle
	est-il libre ?". Chaque accessoire (par ordre de priorité) cherche la place
	libre la plus proche de son point préféré, à la plus grande taille possible :
	il rétrécit jusqu'à MinScale s'il le faut, peut prendre une forme de rechange
	plus compacte (ex. clavier -> pavé numérique en hauteur, pour les couloirs
	étroits), puis jusqu'à 20 % en dernier recours ; sinon il est caché. Un
	affinage au pixel près grossit ensuite l'accessoire autant que la place le
	permet. Un accessoire garde sa place tant qu'elle reste valable (pas de sauts
	inutiles) ; tout est recalculé quand l'écran change (téléphone / tablette /
	rotation).
	Positions peu fiables (layout pas encore calculé...) : si des éléments rangés
	par un UIListLayout se chevauchent, toute la pile est réservée prudemment.

	Déclencheurs : inscription d'un accessoire, Features qui changent (nouvelle
	carte), Slots.Changed / changement d'échelle ou d'appareil, et une petite
	vérification toutes les 1,2 s (compteur qui s'allonge, pastille de boost
	qui apparaît, barre qui descend...). Aucun calcul image par image.

	API :
	  GearLayout.Register(id, spec)   spec = {
	      Size = Vector2 (taille à l'échelle 1, pixels "design"),
	      Shapes = { Vector2 }? (formes de rechange, plus compactes),
	      Priority = number (plus petit = placé d'abord),
	      Anchor = function(button: Rect, canvas: Vector2): Vector2 (centre préféré),
	      MinScale, MaxScale, Near (écart max. avec le bouton, en px, facultatif),
	      SizePenalty (v9.1, facultatif : plus grand = préfère une place plus
	      grande, même plus loin — les claviers cliquables veulent de grosses touches),
	      OnPlace = function(placement | nil) }
	  GearLayout.Unregister(id)
	  GearLayout.GetPlacement(id) -> placement | nil
	  GearLayout.Changed : Signal (id, placement | nil)
	  placement = { CX, CY, Scale, W, H, Size (forme à l'échelle 1), Shape
	                (0 = forme principale, i = Shapes[i]), Rect, Button }
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent.Parent
local Interface = require(Client.Interface)
local ClientState = require(Client.ClientState)
local Slots = require(Client.Slots)
local Signal = require(ReplicatedStorage.Shared.Signal)
local GearKit = require(script.Parent.GearKit)

type Rect = GearKit.Rect

export type Placement = {
	CX: number,
	CY: number,
	Scale: number,
	W: number,
	H: number,
	Size: Vector2,
	Shape: number,
	Rect: Rect,
	Button: Rect,
}

export type Spec = {
	Size: Vector2,
	Shapes: { Vector2 }?,
	Priority: number,
	Anchor: (button: Rect, canvas: Vector2) -> Vector2,
	MinScale: number?,
	MaxScale: number?,
	Near: number?,
	SizePenalty: number?, -- v9.1 : "coût" d'une taille 2x plus petite (défaut SIZE_PENALTY)
	OnPlace: (placement: Placement?) -> (),
}

type Piece = { Id: string, Spec: Spec, Placement: Placement? }

local GearLayout = {}
GearLayout.Changed = Signal.new() -- (id, placement | nil)

local CELL = 8 -- taille d'une case de la grille (pixels "design")
local MARGIN = 6 -- espace laissé autour des obstacles quand on place (grille)
local EXACT_MARGIN = 5 -- même chose au pixel près (affinage)
local KEEP_MARGIN = 1 -- tolérance pour garder une place déjà prise (évite les sauts)
local PIECE_GAP = 3 -- espace entre deux accessoires (ils peuvent se serrer)
local EDGE = 6 -- marge au bord de l'écran
local SIZE_PENALTY = 300 -- "coût" (en px de distance) d'un accessoire 2x plus petit ... x2
local SHAPE_PENALTY = 24 -- petite préférence pour la forme principale
local CHECK_INTERVAL = 1.2
local LAST_RESORT_SCALE = 0.2

local pieces: { [string]: Piece } = {}
local running = false
local generation = 0
local scheduled = false
local forceNext = false
local connections: { any } = {}
local lastButton: Rect? = nil
local lastCanvas: Vector2? = nil
local lastTerritory: Rect? = nil
local checkCount = 0

----------------------------------------------------------------------
-- Obstacles (rectangles sur la toile)
----------------------------------------------------------------------

local function validRect(rect: Rect): boolean
	return rect.X1 - rect.X0 > 0.5 and rect.Y1 - rect.Y0 > 0.5
end

local function inflate(rect: Rect, left: number, top: number, right: number?, bottom: number?): Rect
	return {
		X0 = rect.X0 - left,
		Y0 = rect.Y0 - top,
		X1 = rect.X1 + (right or left),
		Y1 = rect.Y1 + (bottom or top),
	}
end

local function union(a: Rect?, b: Rect): Rect
	if not a then
		return b
	end
	return {
		X0 = math.min(a.X0, b.X0),
		Y0 = math.min(a.Y0, b.Y0),
		X1 = math.max(a.X1, b.X1),
		Y1 = math.max(a.Y1, b.Y1),
	}
end

local function addObject(list: { Rect }, object: Instance, left: number?, top: number?, right: number?, bottom: number?)
	if not object:IsA("GuiObject") or not object.Visible then
		return
	end
	local rect = GearKit.CanvasRect(object)
	if validRect(rect) then
		table.insert(list, inflate(rect, left or 0, top or 0, right, bottom))
	end
end

-- Rectangle FINAL d'un cadre de slot (même pendant son animation "pop") :
-- on retrouve son emplacement par sa position, puis taille x échelle du slot
local function slotRect(frame: GuiObject): Rect
	local rect = GearKit.CanvasRect(frame)
	local ok, name = pcall(function()
		for slotName in pairs(Slots.Definitions) do
			local position = Slots.GetPlacement(slotName)
			if position == frame.Position then
				return slotName
			end
		end
		return nil
	end)
	if ok and name and frame.Size.X.Scale == 0 then
		local scale = Slots.GetScale(name)
		local cx, cy = (rect.X0 + rect.X1) / 2, (rect.Y0 + rect.Y1) / 2
		local w, h = frame.Size.X.Offset * scale, frame.Size.Y.Offset * scale
		return { X0 = cx - w / 2, Y0 = cy - h / 2, X1 = cx + w / 2, Y1 = cy + h / 2 }
	end
	return rect
end

-- Vrai si aucun des rectangles ne chevauche un autre (des éléments rangés par
-- un UIListLayout ne se chevauchent jamais : sinon les positions lues ne sont
-- pas fiables — layout pas encore calculé, ou émulateur sans UIListLayout)
local function noOverlap(rects: { Rect }): boolean
	for i = 1, #rects do
		local a = rects[i]
		for j = i + 1, #rects do
			local b = rects[j]
			local ox = math.min(a.X1, b.X1) - math.max(a.X0, b.X0)
			local oy = math.min(a.Y1, b.Y1) - math.max(a.Y0, b.Y0)
			if ox > 2 and oy > 2 then
				return false
			end
		end
	end
	return true
end

local function visibleChildRects(parent: Instance): { Rect }
	local rects = {}
	for _, child in ipairs(parent:GetChildren()) do
		if child:IsA("GuiObject") and child.Visible then
			local rect = GearKit.CanvasRect(child)
			if validRect(rect) then
				table.insert(rects, rect)
			end
		end
	end
	return rects
end

-- Pile sous le bouton (compteur, "par seconde", menus, combo, améliorations).
-- Renvoie le bas de la barre d'améliorations (ou de la pile) sur la toile.
local function collectStack(list: { Rect }, stack: GuiObject): number
	local items = {}
	local rects = {}
	local widest = 0
	local frame = GearKit.CanvasRect(stack)
	for _, item in ipairs(stack:GetChildren()) do
		if item:IsA("GuiObject") and item.Visible then
			local rect = GearKit.CanvasRect(item)
			if validRect(rect) then
				table.insert(items, item)
				table.insert(rects, rect)
				widest = math.max(widest, rect.X1 - rect.X0)
			end
		end
	end
	if not noOverlap(rects) then
		-- Positions pas fiables : on réserve prudemment toute la pile (largeur de
		-- son élément le plus large, et un peu plus bas que son cadre)
		local cx = (frame.X0 + frame.X1) / 2
		local half = math.max(widest, 320) / 2 + 4
		local bottom = frame.Y1 + 60
		table.insert(list, { X0 = cx - half, Y0 = frame.Y0 - 2, X1 = cx + half, Y1 = bottom })
		return bottom
	end
	local barBottom: number? = nil
	local lowest = frame.Y0
	for index, item in ipairs(items) do
		local rect = rects[index]
		lowest = math.max(lowest, rect.Y1)
		if item.Name == "UpgradeBar" then
			barBottom = rect.Y1
		end
		if item.Name == "Counter" then
			-- Le nombre + "Dopamine" (avec de la place pour grandir)
			local labels = visibleChildRects(item)
			local box: Rect? = nil
			for _, label in ipairs(labels) do
				box = union(box, label)
			end
			local inside = box ~= nil and (box :: Rect).X0 >= rect.X0 - 2 and (box :: Rect).X1 <= rect.X1 + 2
			if box and inside and noOverlap(labels) then
				table.insert(list, inflate(box :: Rect, 24, 2))
			else
				table.insert(list, rect)
			end
		elseif item.Name == "Pills" and not item:IsA("ScrollingFrame") then
			-- Rangée des menus : seulement les pastilles visibles (si leurs positions sont fiables)
			local pills = visibleChildRects(item)
			local box: Rect? = nil
			for _, pill in ipairs(pills) do
				box = union(box, pill)
			end
			if box and noOverlap(pills) then
				table.insert(list, inflate(box :: Rect, 8, 3))
			else
				table.insert(list, inflate(rect, 4, 2))
			end
		elseif item.Name == "UpgradeBar" then
			-- Barre d'améliorations : les cartes visibles (la barre peut être à moitié vide)
			local box: Rect? = nil
			local reliable = true
			for _, child in ipairs(item:GetChildren()) do
				if child:IsA("GuiObject") and child.Visible then
					local childRect = GearKit.CanvasRect(child)
					if child:IsA("ScrollingFrame") then
						-- Cartes du défilement, coupées au cadre visible
						local cards = visibleChildRects(child)
						if not noOverlap(cards) then
							reliable = false
						end
						for _, card in ipairs(cards) do
							local clipped = {
								X0 = math.max(card.X0, childRect.X0),
								Y0 = math.max(card.Y0, childRect.Y0),
								X1 = math.min(card.X1, childRect.X1),
								Y1 = math.min(card.Y1, childRect.Y1),
							}
							if validRect(clipped) then
								box = union(box, clipped)
							end
						end
					elseif validRect(childRect) then
						box = union(box, childRect)
					end
				end
			end
			if box and reliable then
				table.insert(list, inflate(box :: Rect, 6, 4))
			else
				table.insert(list, rect)
			end
		else
			table.insert(list, rect)
			-- Enfants qui dépassent (bandeau Rush sur la ligne "par seconde"...)
			for _, sub in ipairs(item:GetChildren()) do
				if sub:IsA("GuiObject") and sub.Visible and sub.ZIndex > 1 then
					addObject(list, sub)
				end
			end
		end
	end
	return barBottom or lowest
end

-- Colonne centrale : chaque élément visible (pas le grand cadre transparent).
-- Renvoie le bas de la barre d'améliorations (nil si pas de pile).
local function collectColumn(list: { Rect }, column: Instance): number?
	local barBottom: number? = nil
	for _, child in ipairs(column:GetChildren()) do
		if child:IsA("GuiObject") and child.Visible then
			local name = child.Name
			if name == "Stack" then
				barBottom = collectStack(list, child)
			elseif name == "ClickerHolder" then
				addObject(list, child, 2, 2)
				for _, sub in ipairs(child:GetChildren()) do
					if sub:IsA("GuiObject") and sub.Visible and sub.Name ~= "ClickButton" and not string.find(sub.Name, "Shadow") then
						addObject(list, sub) -- chapeau, robot de l'auto-clic
					end
				end
			elseif name == "StatusLeft" then
				-- Pastilles VIP / bonus / boost : toute la colonne dès qu'une est visible
				for _, chip in ipairs(child:GetChildren()) do
					if chip:IsA("GuiObject") and chip.Visible then
						addObject(list, child, 2, 2)
						break
					end
				end
			elseif name == "HouseHolder" then
				-- Le badge "99+" déborde en haut à droite
				addObject(list, child, 2, 10, 16, 2)
			else
				addObject(list, child)
			end
		end
	end
	return barBottom
end

-- Objets persistants connus des autres stimuli plein écran (sans attribut)
local KNOWN_OVERLAY = {
	Disco = { "Ball" }, -- boule disco accrochée au bandeau d'actu
}

-- Objets marqués LayoutObstacle = true dans un calque plein écran (hors accessoires)
local function collectMarked(list: { Rect }, layer: Instance?)
	if not layer then
		return
	end
	for containerName, names in pairs(KNOWN_OVERLAY) do
		local container = layer:FindFirstChild(containerName)
		if container and container:IsA("GuiObject") and container.Visible then
			for _, name in ipairs(names) do
				local item = container:FindFirstChild(name, true)
				if item then
					addObject(list, item, 10, 10)
				end
			end
		end
	end
	for _, container in ipairs(layer:GetChildren()) do
		if container:IsA("GuiObject") and container.Visible then
			for _, item in ipairs(container:GetChildren()) do
				if item:IsA("GuiObject") and item.Visible and item:GetAttribute("LayoutObstacle") == true
					and not string.find(item.Name, "^Gear_") then
					addObject(list, item)
				end
				for _, sub in ipairs(item:GetChildren()) do
					if sub:IsA("GuiObject") and sub.Visible and sub:GetAttribute("LayoutObstacle") == true
						and not string.find(sub.Name, "^Gear_") then
						addObject(list, sub)
					end
				end
			end
		end
	end
end

-- Obstacles + bas de la barre d'améliorations (toile)
local function collectObstacles(canvas: Vector2): ({ Rect }, number)
	local list: { Rect } = {}
	local barBottom = canvas.Y
	local layers = Interface.Layers
	if not layers then
		return list, barBottom
	end
	local slots = layers.Slots
	if slots then
		for _, frame in ipairs(slots:GetChildren()) do
			if frame:IsA("GuiObject") and frame.Visible then
				local rect = slotRect(frame)
				if validRect(rect) then
					table.insert(list, rect)
				end
			end
		end
	end
	local main = layers.Main
	if main then
		for _, child in ipairs(main:GetChildren()) do
			if child:IsA("GuiObject") and child.Visible then
				if child.Name == "CenterColumn" then
					local bottom = collectColumn(list, child)
					if bottom then
						barBottom = bottom
					end
				else
					local rect = GearKit.CanvasRect(child)
					-- (les cadres plein écran ne sont pas des obstacles)
					if validRect(rect) and (rect.X1 - rect.X0) < canvas.X * 0.9 then
						table.insert(list, rect)
					end
				end
			end
		end
	end
	collectMarked(list, layers.Overlay)
	collectMarked(list, layers.Background)
	return list, barBottom
end

local function intersects(a: Rect, b: Rect, margin: number): boolean
	return a.X0 < b.X1 + margin and b.X0 < a.X1 + margin and a.Y0 < b.Y1 + margin and b.Y0 < a.Y1 + margin
end

-- Bande centrale réservée aux accessoires (voir l'en-tête)
local function computeTerritory(canvas: Vector2, barBottom: number): Rect
	local left, right = 0, canvas.X
	local l1 = Slots.Definitions.L1
	if l1 then
		left = (l1.X + l1.W + Slots.ClipMargin) * Slots.GetScale("L1")
	end
	local r1 = Slots.Definitions.R1
	if r1 then
		right = canvas.X - (r1.X + r1.W + Slots.ClipMargin) * Slots.GetScale("R1")
	end
	if right - left < 200 then
		left, right = 0, canvas.X
	end
	return { X0 = left, Y0 = 0, X1 = right, Y1 = math.clamp(barBottom, 60, canvas.Y) }
end

local function inside(rect: Rect, area: Rect, tolerance: number): boolean
	return rect.X0 >= area.X0 - tolerance and rect.Y0 >= area.Y0 - tolerance and rect.X1 <= area.X1 + tolerance and rect.Y1 <= area.Y1 + tolerance
end

----------------------------------------------------------------------
-- Grille d'occupation + sommes cumulées
----------------------------------------------------------------------

type Grid = {
	Cols: number,
	Rows: number,
	Occ: { number },
	Sat: { number },
}

local function newGrid(canvas: Vector2): Grid
	local cols = math.max(1, math.ceil(canvas.X / CELL))
	local rows = math.max(1, math.ceil(canvas.Y / CELL))
	return { Cols = cols, Rows = rows, Occ = table.create(cols * rows, 0), Sat = {} }
end

local function markRect(grid: Grid, x0: number, y0: number, x1: number, y1: number)
	local cols, rows = grid.Cols, grid.Rows
	local c0 = math.max(0, math.floor(x0 / CELL))
	local c1 = math.min(cols - 1, math.ceil(x1 / CELL) - 1)
	local r0 = math.max(0, math.floor(y0 / CELL))
	local r1 = math.min(rows - 1, math.ceil(y1 / CELL) - 1)
	local occ = grid.Occ
	for r = r0, r1 do
		local base = r * cols
		for c = c0, c1 do
			occ[base + c + 1] = 1
		end
	end
end

local function buildSat(grid: Grid)
	local cols, rows = grid.Cols, grid.Rows
	local width = cols + 1
	local sat = table.create((rows + 1) * width, 0)
	local occ = grid.Occ
	for r = 1, rows do
		local rowSum = 0
		local occBase = (r - 1) * cols
		local base = r * width
		local previous = (r - 1) * width
		for c = 1, cols do
			rowSum += occ[occBase + c]
			sat[base + c + 1] = sat[previous + c + 1] + rowSum
		end
	end
	grid.Sat = sat
end

-- Vrai si le bloc de cases [c0, c0 + cw[ x [r0, r0 + ch[ est entièrement libre
local function isFree(grid: Grid, c0: number, r0: number, cw: number, ch: number): boolean
	if c0 < 0 or r0 < 0 or c0 + cw > grid.Cols or r0 + ch > grid.Rows then
		return false
	end
	local width = grid.Cols + 1
	local sat = grid.Sat
	local a = sat[r0 * width + c0 + 1]
	local b = sat[r0 * width + c0 + cw + 1]
	local c = sat[(r0 + ch) * width + c0 + 1]
	local d = sat[(r0 + ch) * width + c0 + cw + 1]
	return d - b - c + a == 0
end

----------------------------------------------------------------------
-- Recherche d'une place
----------------------------------------------------------------------

local function makePlacement(cx: number, cy: number, scale: number, size: Vector2, shape: number, button: Rect): Placement
	local w, h = size.X * scale, size.Y * scale
	return {
		CX = cx,
		CY = cy,
		Scale = scale,
		W = w,
		H = h,
		Size = size,
		Shape = shape,
		Rect = { X0 = cx - w / 2, Y0 = cy - h / 2, X1 = cx + w / 2, Y1 = cy + h / 2 },
		Button = button,
	}
end

-- Formes possibles : { taille, facteur de "taille visible" par rapport à la forme principale }
local function shapesOf(spec: Spec): { { Size: Vector2, Index: number, Visual: number } }
	local main = spec.Size
	local list = { { Size = main, Index = 0, Visual = 1 } }
	for index, size in ipairs(spec.Shapes or {}) do
		-- (un pavé plus compact "compte" pour sa surface relative)
		local visual = math.sqrt((size.X * size.Y) / math.max(1, main.X * main.Y))
		table.insert(list, { Size = size, Index = index, Visual = visual })
	end
	return list
end

local function sizeCost(scale: number, maxScale: number, visual: number, shapeIndex: number, penalty: number?): number
	return (1 - (scale * visual) / maxScale) * (penalty or SIZE_PENALTY) + (shapeIndex > 0 and SHAPE_PENALTY or 0)
end

-- Meilleure place pour `spec` entre les échelles maxScale et minScale (nil si aucune)
local function search(
	grid: Grid,
	spec: Spec,
	button: Rect,
	canvas: Vector2,
	territory: Rect,
	maxScale: number,
	minScale: number,
	near: number?
): Placement?
	local anchor = spec.Anchor(button, canvas)
	local bestCost = math.huge
	local best: Placement? = nil
	for _, shape in ipairs(shapesOf(spec)) do
		local size = shape.Size
		local scale = maxScale
		while scale >= minScale - 1e-4 do
			local penalty = sizeCost(scale, maxScale, shape.Visual, shape.Index, spec.SizePenalty)
			if penalty >= bestCost then
				break
			end
			local w, h = size.X * scale, size.Y * scale
			local cw, ch = math.max(1, math.ceil(w / CELL)), math.max(1, math.ceil(h / CELL))
			-- Zone de recherche : le territoire (et autour du bouton si Near)
			local cMin = math.max(0, math.floor(territory.X0 / CELL))
			local cMax = math.min(grid.Cols, math.ceil(territory.X1 / CELL)) - cw
			local rMin = math.max(0, math.floor(territory.Y0 / CELL))
			local rMax = math.min(grid.Rows, math.ceil(territory.Y1 / CELL)) - ch
			if near then
				cMin = math.max(cMin, math.floor((button.X0 - near - w) / CELL) - 1)
				cMax = math.min(cMax, math.ceil((button.X1 + near) / CELL) + 1)
				rMin = math.max(rMin, math.floor((button.Y0 - near - h) / CELL) - 1)
				rMax = math.min(rMax, math.ceil((button.Y1 + near) / CELL) + 1)
			end
			local function try(c0: number, r0: number)
				local cx = (c0 + cw / 2) * CELL
				local cy = (r0 + ch / 2) * CELL
				local dx, dy = cx - anchor.X, cy - anchor.Y
				local cost = math.sqrt(dx * dx + dy * dy) + penalty
				if cost < bestCost and isFree(grid, c0, r0, cw, ch) then
					if near then
						local rect = { X0 = cx - w / 2, Y0 = cy - h / 2, X1 = cx + w / 2, Y1 = cy + h / 2 }
						if GearKit.RectGap(rect, button) > near then
							return
						end
					end
					bestCost = cost
					best = makePlacement(cx, cy, scale, size, shape.Index, button)
				end
			end
			-- Toutes les cases (une place de 3 cases de haut exactement doit être trouvée)
			for r0 = rMin, rMax do
				for c0 = cMin, cMax do
					try(c0, r0)
				end
			end
			scale *= 0.9
		end
	end
	return best
end

-- Test exact (sans grille) : rectangle libre et dans le territoire ?
local function exactFree(rect: Rect, obstacles: { Rect }, placed: { Rect }, canvas: Vector2, territory: Rect): boolean
	if rect.X0 < EDGE or rect.Y0 < EDGE or rect.X1 > canvas.X - EDGE or rect.Y1 > canvas.Y - EDGE then
		return false
	end
	if not inside(rect, territory, 0) then
		return false
	end
	for _, obstacle in ipairs(obstacles) do
		if intersects(rect, obstacle, EXACT_MARGIN) then
			return false
		end
	end
	for _, other in ipairs(placed) do
		if intersects(rect, other, PIECE_GAP) then
			return false
		end
	end
	return true
end

-- Affinage : la grille est prudente (jusqu'à une case perdue de chaque côté).
-- Autour de la place trouvée, on cherche au pixel près la position qui permet
-- la plus grande taille (et la plus proche du point préféré).
local function refine(
	placement: Placement,
	spec: Spec,
	obstacles: { Rect },
	placed: { Rect },
	button: Rect,
	canvas: Vector2,
	territory: Rect,
	near: number?
): Placement
	local anchor = spec.Anchor(button, canvas)
	local maxScale = spec.MaxScale or 1
	local size = placement.Size
	local shapeIndex = placement.Shape
	local visual = 1
	if shapeIndex > 0 then
		visual = math.sqrt((size.X * size.Y) / math.max(1, spec.Size.X * spec.Size.Y))
	end
	local function fits(cx: number, cy: number, scale: number): boolean
		local w, h = size.X * scale, size.Y * scale
		local rect = { X0 = cx - w / 2, Y0 = cy - h / 2, X1 = cx + w / 2, Y1 = cy + h / 2 }
		if near and GearKit.RectGap(rect, button) > near then
			return false
		end
		return exactFree(rect, obstacles, placed, canvas, territory)
	end
	local function cost(cx: number, cy: number, scale: number): number
		local dx, dy = cx - anchor.X, cy - anchor.Y
		return math.sqrt(dx * dx + dy * dy) + sizeCost(scale, maxScale, visual, shapeIndex, spec.SizePenalty)
	end
	local bestX, bestY, bestScale = placement.CX, placement.CY, placement.Scale
	if not fits(bestX, bestY, bestScale) then
		return placement
	end
	local bestCost = cost(bestX, bestY, bestScale)
	local startX, startY, startScale = bestX, bestY, bestScale
	for dy = -12, 12, 3 do
		for dx = -12, 12, 3 do
			local cx, cy = startX + dx, startY + dy
			if fits(cx, cy, startScale) then
				-- Plus grande échelle possible ici (dichotomie)
				local lo, hi = startScale, maxScale
				if fits(cx, cy, hi) then
					lo = hi
				else
					for _ = 1, 6 do
						local mid = (lo + hi) / 2
						if fits(cx, cy, mid) then
							lo = mid
						else
							hi = mid
						end
					end
				end
				local c = cost(cx, cy, lo)
				if c < bestCost - 0.5 then
					bestCost = c
					bestX, bestY, bestScale = cx, cy, lo
				end
			end
		end
	end
	if bestX == startX and bestY == startY and bestScale == startScale then
		return placement
	end
	return makePlacement(bestX, bestY, bestScale, size, shapeIndex, button)
end

-- La place actuelle est-elle toujours bonne ?
local function stillValid(
	placement: Placement,
	spec: Spec,
	obstacles: { Rect },
	placed: { Rect },
	button: Rect,
	canvas: Vector2,
	territory: Rect
): boolean
	local rect = placement.Rect
	if rect.X0 < 0 or rect.Y0 < 0 or rect.X1 > canvas.X or rect.Y1 > canvas.Y then
		return false
	end
	if not inside(rect, territory, 2) then
		return false
	end
	for _, obstacle in ipairs(obstacles) do
		if intersects(rect, obstacle, KEEP_MARGIN) then
			return false
		end
	end
	for _, other in ipairs(placed) do
		if intersects(rect, other, 1) then
			return false
		end
	end
	local old = placement.Button
	local moved = math.abs(old.X0 - button.X0) + math.abs(old.Y0 - button.Y0) + math.abs(old.X1 - button.X1) + math.abs(old.Y1 - button.Y1)
	if spec.Near and (moved > 4 or GearKit.RectGap(rect, button) > spec.Near + 4) then
		return false
	end
	return true
end

local function samePlacement(a: Placement?, b: Placement?): boolean
	if a == nil or b == nil then
		return a == b
	end
	local aa, bb = a :: Placement, b :: Placement
	if aa.Shape ~= bb.Shape then
		return false
	end
	if math.abs(aa.CX - bb.CX) > 0.5 or math.abs(aa.CY - bb.CY) > 0.5 or math.abs(aa.Scale - bb.Scale) > 1e-3 then
		return false
	end
	local ba, bbtn = aa.Button, bb.Button
	return math.abs(ba.X0 - bbtn.X0) < 0.5 and math.abs(ba.Y0 - bbtn.Y0) < 0.5 and math.abs(ba.X1 - bbtn.X1) < 0.5
end

local function orderedPieces(): { Piece }
	local list = {}
	for _, piece in pairs(pieces) do
		table.insert(list, piece)
	end
	table.sort(list, function(a, b)
		if a.Spec.Priority ~= b.Spec.Priority then
			return a.Spec.Priority < b.Spec.Priority
		end
		return a.Id < b.Id
	end)
	return list
end

local function notify(piece: Piece, placement: Placement?)
	piece.Placement = placement
	local ok, err = pcall(piece.Spec.OnPlace, placement)
	if not ok then
		warn("[GearLayout] " .. piece.Id .. " : " .. tostring(err))
	end
	GearLayout.Changed:Fire(piece.Id, placement)
end

----------------------------------------------------------------------
-- Calcul complet
----------------------------------------------------------------------

local retryScheduled = false

local function doLayout(force: boolean)
	local button = GearKit.GetButtonRect()
	if not button then
		-- Bouton pas encore construit / mis en page : on réessaie un peu plus tard
		if not retryScheduled then
			retryScheduled = true
			task.delay(0.5, function()
				retryScheduled = false
				if running then
					GearLayout.Request(force)
				end
			end)
		end
		return
	end
	local canvas = GearKit.CanvasSize()
	local obstacles, barBottom = collectObstacles(canvas)
	local territory = computeTerritory(canvas, barBottom)
	local grid = newGrid(canvas)
	for _, obstacle in ipairs(obstacles) do
		markRect(grid, obstacle.X0 - MARGIN, obstacle.Y0 - MARGIN, obstacle.X1 + MARGIN, obstacle.Y1 + MARGIN)
	end
	-- Bords de l'écran + hors du territoire
	markRect(grid, 0, 0, canvas.X, EDGE)
	markRect(grid, 0, canvas.Y - EDGE, canvas.X, canvas.Y)
	markRect(grid, 0, 0, math.max(EDGE, territory.X0), canvas.Y)
	markRect(grid, math.min(canvas.X - EDGE, territory.X1), 0, canvas.X, canvas.Y)
	markRect(grid, 0, territory.Y1, canvas.X, canvas.Y)
	buildSat(grid)

	local placed: { Rect } = {}
	local results: { [Piece]: Placement? } = {}
	for _, piece in ipairs(orderedPieces()) do
		local spec = piece.Spec
		local current = piece.Placement
		local placement: Placement? = nil
		if current and not force and stillValid(current, spec, obstacles, placed, button, canvas, territory) then
			placement = makePlacement(current.CX, current.CY, current.Scale, current.Size, current.Shape, button)
		else
			local maxScale = spec.MaxScale or 1
			local minScale = math.min(maxScale, spec.MinScale or 0.45)
			placement = search(grid, spec, button, canvas, territory, maxScale, minScale, spec.Near)
			local near = spec.Near
			if not placement then
				-- Dernier recours : plus petit, et n'importe où dans le territoire
				near = nil
				placement = search(grid, spec, button, canvas, territory, minScale * 0.9, maxScale * LAST_RESORT_SCALE, nil)
			end
			if placement then
				placement = refine(placement, spec, obstacles, placed, button, canvas, territory, near)
			end
		end
		results[piece] = placement
		if placement then
			local rect = placement.Rect
			table.insert(placed, rect)
			markRect(grid, rect.X0 - PIECE_GAP, rect.Y0 - PIECE_GAP, rect.X1 + PIECE_GAP, rect.Y1 + PIECE_GAP)
			buildSat(grid)
		end
	end

	lastButton = button
	lastCanvas = canvas
	lastTerritory = territory
	for piece, placement in pairs(results) do
		if pieces[piece.Id] == piece and not samePlacement(piece.Placement, placement) then
			notify(piece, placement)
		end
	end
	-- (accessoires sans place : results[piece] = nil, pairs ne les voit pas)
	for _, piece in pairs(pieces) do
		if results[piece] == nil and piece.Placement ~= nil then
			notify(piece, nil)
		end
	end
end

----------------------------------------------------------------------
-- Vérification périodique (bon marché : pas de grille)
----------------------------------------------------------------------

local function check()
	local button = GearKit.GetButtonRect()
	if not button then
		return
	end
	local canvas = GearKit.CanvasSize()
	local previousCanvas = lastCanvas
	if not previousCanvas or math.abs(previousCanvas.X - canvas.X) > 1 or math.abs(previousCanvas.Y - canvas.Y) > 1 then
		GearLayout.Request(true)
		return
	end
	local previous = lastButton
	if not previous or math.abs(previous.X0 - button.X0) + math.abs(previous.Y0 - button.Y0) > 3 then
		GearLayout.Request(false)
		return
	end
	local obstacles, barBottom = collectObstacles(canvas)
	local territory = computeTerritory(canvas, barBottom)
	local old = lastTerritory
	-- La barre remonte (plus de place) ou descend : on revérifie tout
	local territoryMoved = old ~= nil and (math.abs(old.Y1 - territory.Y1) > 6 or math.abs(old.X0 - territory.X0) > 6)
	local hidden = false
	for _, piece in pairs(pieces) do
		local placement = piece.Placement
		if placement then
			if not inside(placement.Rect, territory, 2) then
				GearLayout.Request(false)
				return
			end
			for _, obstacle in ipairs(obstacles) do
				if intersects(placement.Rect, obstacle, KEEP_MARGIN) then
					GearLayout.Request(false)
					return
				end
			end
		else
			hidden = true
		end
	end
	-- Un accessoire sans place : de la place a peut-être été libérée
	checkCount += 1
	if (hidden and checkCount % 5 == 0) or territoryMoved then
		GearLayout.Request(false)
	end
end

local function loop(gen: number)
	task.delay(CHECK_INTERVAL, function()
		if gen ~= generation or not running then
			return
		end
		local ok, err = pcall(check)
		if not ok then
			warn("[GearLayout] vérification : " .. tostring(err))
		end
		loop(gen)
	end)
end

local function start()
	if running then
		return
	end
	running = true
	generation += 1
	local function forced()
		GearLayout.Request(true)
	end
	table.insert(connections, Slots.Changed:Connect(forced))
	table.insert(connections, Interface.ScaleChanged:Connect(forced))
	table.insert(connections, Interface.DeviceChanged:Connect(forced))
	table.insert(connections, ClientState.FeaturesChanged:Connect(function()
		-- (les cadres des nouveaux stimuli sont créés par StimulusManager juste avant)
		GearLayout.Request(false)
	end))
	loop(generation)
end

local function stop()
	running = false
	generation += 1
	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	table.clear(connections)
	lastButton = nil
	lastCanvas = nil
	lastTerritory = nil
end

----------------------------------------------------------------------
-- API
----------------------------------------------------------------------

-- Demande un nouveau calcul (regroupé : un seul calcul pour plusieurs demandes)
function GearLayout.Request(force: boolean?)
	if force then
		forceNext = true
	end
	if scheduled or not running then
		return
	end
	scheduled = true
	task.delay(0.06, function()
		scheduled = false
		if not running then
			return
		end
		local useForce = forceNext
		forceNext = false
		local ok, err = pcall(doLayout, useForce)
		if not ok then
			warn("[GearLayout] " .. tostring(err))
		end
	end)
end

function GearLayout.Register(id: string, spec: Spec)
	pieces[id] = { Id = id, Spec = spec, Placement = nil }
	start()
	GearLayout.Request(false)
end

function GearLayout.Unregister(id: string)
	local piece = pieces[id]
	if not piece then
		return
	end
	pieces[id] = nil
	GearLayout.Changed:Fire(id, nil)
	if next(pieces) == nil then
		stop()
	end
end

function GearLayout.GetPlacement(id: string): Placement?
	local piece = pieces[id]
	return piece and piece.Placement or nil
end

function GearLayout.IsRegistered(id: string): boolean
	return pieces[id] ~= nil
end

-- (debug / tests) : { [id] = placement }
function GearLayout.Snapshot(): { [string]: Placement? }
	local out = {}
	for id, piece in pairs(pieces) do
		out[id] = piece.Placement
	end
	return out
end

-- (debug / tests) : bande réservée aux accessoires lors du dernier calcul
function GearLayout.GetTerritory(): Rect?
	return lastTerritory
end

-- (debug / tests) : obstacles vus maintenant + territoire
function GearLayout.DebugObstacles(): ({ Rect }, Rect)
	local canvas = GearKit.CanvasSize()
	local obstacles, barBottom = collectObstacles(canvas)
	return obstacles, computeTerritory(canvas, barBottom)
end

return GearLayout
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="121">
            <Properties>
              <string name="Name">GearPiece</string>
              <string name="Source"><![CDATA[--[[
	GearPiece (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Stimuli > Gear > GearPiece

	Un accessoire "posé" à l'écran (doigt, clavier, souris...) :
	  - cadre racine "Gear_<Id>" dans le conteneur du stimulus (Slot "Background" :
	    SOUS toute l'interface, au-dessus des fonds animés grâce au ZIndex du
	    conteneur), placé par GearLayout dans l'espace libre (attribut
	    LayoutObstacle = true : les autres stimuli peuvent l'éviter). Même si la
	    mise en page se trompait un instant, il ne recouvre JAMAIS une carte,
	    une pastille ou un bouton : il passerait dessous ;
	  - FX : cadre "Gear_<Id>FX" dans le calque Overlay pour les effets de clic
	    PASSAGERS (étoiles, "clac !", bulles, ondes...), au-dessus de l'interface ;
	  - Content : cadre de la taille "design" de l'accessoire, où le module dessine ;
	  - apparition "pop" (+ étincelles) au premier placement, glissement doux
	    quand la mise en page change, disparition si aucune place n'existe ;
	  - halo clair derrière l'accessoire en mode sombre (néon) pour qu'il reste
	    lisible sur fond noir ;
	  - suivi du niveau de l'amélioration (ctx.State.Changed) : OnLevel(niveau).
	Les animations passent par l'Animator du module (rien au repos).
]]

local GearKit = require(script.Parent.GearKit)
local GearLayout = require(script.Parent.GearLayout)

type Placement = GearLayout.Placement

export type Options = {
	Id: string,
	Size: Vector2,
	Shapes: { Vector2 }?, -- formes de rechange plus compactes (voir GearLayout)
	Priority: number,
	Anchor: (button: GearKit.Rect, canvas: Vector2) -> Vector2,
	MinScale: number?,
	MaxScale: number?,
	Near: number?,
	SizePenalty: number?, -- v9.1 (voir GearLayout)
	GlowColor: Color3?, -- couleur du halo (mode sombre)
	UpgradeId: string?, -- amélioration suivie pour OnLevel (par défaut Id)
	ContainerZ: number?, -- ZIndex du conteneur dans le calque Background (défaut 1100)
}

local GearPiece = {}
GearPiece.__index = GearPiece

export type Piece = typeof(setmetatable(
	{} :: {
		Id: string,
		Ctx: any,
		Options: Options,
		Root: Frame,
		Content: Frame,
		FX: Frame,
		PlaceScale: UIScale,
		Glow: Frame,
		Animator: GearKit.Animator,
		Placement: Placement?,
		Level: number,
		Shape: number,
		Size: Vector2,
		OnShape: ((shape: number, size: Vector2) -> ())?,
		OnPlaced: ((placement: Placement, first: boolean) -> ())?,
		OnHidden: (() -> ())?,
		OnLevel: ((level: number, previous: number) -> ())?,
		Sparkles: { Frame },
		SparkleCursor: number,
		Alive: boolean,
	},
	GearPiece
))

local SPARKLE_COLORS = {
	Color3.fromRGB(255, 214, 60),
	Color3.fromRGB(255, 120, 200),
	Color3.fromRGB(110, 220, 255),
	Color3.fromRGB(150, 255, 150),
}

function GearPiece.new(ctx: any, options: Options, animator: GearKit.Animator?): Piece
	local size = options.Size
	-- Calque Background : fond du thème 0, mode néon ~50, fonds cosmiques 301-310,
	-- nuages d'orage 1000 -> les accessoires (objets posés) sont au-dessus de ces
	-- ambiances (1101-1107), et sous toute l'interface (calques Slots, Main...)
	ctx.Container.ZIndex = options.ContainerZ or 1100
	local fx = GearKit.FXLayer(ctx, "Gear_" .. options.Id .. "FX")
	local root = Instance.new("Frame")
	root.Name = "Gear_" .. options.Id
	root.BackgroundTransparency = 1
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.Size = UDim2.fromOffset(size.X, size.Y)
	root.Visible = false
	root.Active = false
	root.ZIndex = 2
	root:SetAttribute("LayoutObstacle", true)
	local placeScale = Instance.new("UIScale")
	placeScale.Name = "PlaceScale"
	placeScale.Parent = root

	-- Halo (mode sombre) derrière le dessin
	local glowSize = math.max(size.X, size.Y) * 1.15
	local glow = GearKit.Box(root, size.X / 2, size.Y / 2, glowSize, glowSize, options.GlowColor or Color3.fromRGB(235, 225, 255), {
		Name = "Glow",
		Anchor = Vector2.new(0.5, 0.5),
		Radius = "round",
		Z = 1,
		Transparency = 0.2,
		Visible = false,
		GradientTransparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.3, 0.86),
			NumberSequenceKeypoint.new(0.5, 0.7),
			NumberSequenceKeypoint.new(0.7, 0.86),
			NumberSequenceKeypoint.new(1, 1),
		}),
		GradientRotation = 0,
	})
	if size.X ~= size.Y then
		glow.Size = UDim2.fromOffset(size.X * 1.1, size.Y * 1.25)
	end

	local content = Instance.new("Frame")
	content.Name = "Content"
	content.BackgroundTransparency = 1
	content.Size = UDim2.fromOffset(size.X, size.Y)
	content.ZIndex = 2
	content.Parent = root

	-- Étincelles (réutilisées) : apparition, niveau supérieur
	local sparkles = {}
	for index = 1, 6 do
		local star = GearKit.Star(fx, 0, 0, 14, SPARKLE_COLORS[(index - 1) % #SPARKLE_COLORS + 1], 30)
		star.Visible = false
		table.insert(sparkles, star)
	end

	root.Parent = ctx.Container

	local self = setmetatable({
		Id = options.Id,
		Ctx = ctx,
		Options = options,
		Root = root,
		Content = content,
		FX = fx,
		PlaceScale = placeScale,
		Glow = glow,
		Animator = animator or GearKit.Animator(ctx),
		Placement = nil,
		Level = GearKit.Level(ctx, options.UpgradeId or options.Id),
		Shape = 0,
		Size = size,
		OnShape = nil,
		OnPlaced = nil,
		OnHidden = nil,
		OnLevel = nil,
		Sparkles = sparkles,
		SparkleCursor = 0,
		Alive = true,
	}, GearPiece)

	-- Mode sombre : halo clair
	local function applyDark(dark: boolean)
		glow.Visible = dark == true
	end
	applyDark(ctx.State.DarkMode == true)
	ctx.Connect(ctx.State.DarkModeChanged, applyDark)

	-- Niveau
	ctx.Connect(ctx.State.Changed, function()
		local level = GearKit.Level(ctx, options.UpgradeId or options.Id)
		if level ~= self.Level and level > 0 then
			local previous = self.Level
			self.Level = level
			local callback = self.OnLevel
			if callback then
				callback(level, previous)
			end
			if level > previous then
				self:Celebrate()
			end
		end
	end)

	GearLayout.Register(options.Id, {
		Size = size,
		Shapes = options.Shapes,
		Priority = options.Priority,
		Anchor = options.Anchor,
		MinScale = options.MinScale,
		MaxScale = options.MaxScale,
		Near = options.Near,
		SizePenalty = options.SizePenalty,
		OnPlace = function(placement: Placement?)
			self:_place(placement)
		end,
	})
	return self
end

-- Nouveau placement (ou nil : plus de place)
function GearPiece._place(self: Piece, placement: Placement?)
	if not self.Alive then
		return
	end
	local root = self.Root
	if not placement then
		self.Placement = nil
		root.Visible = false
		local hidden = self.OnHidden
		if hidden then
			hidden()
		end
		return
	end
	local first = self.Placement == nil or not root.Visible
	-- Nouvelle forme (ex. clavier -> pavé numérique) : on redessine
	if placement.Shape ~= self.Shape then
		self:_setShape(placement.Shape, placement.Size)
	end
	local from = root.Position
	local fromScale = self.PlaceScale.Scale
	self.Placement = placement
	root.Visible = true
	local target = UDim2.fromOffset(placement.CX, placement.CY)
	local scale = placement.Scale
	local animator = self.Animator
	if first then
		root.Position = target
		animator:Play("place", 0.5, function(t)
			self.PlaceScale.Scale = scale * math.max(0.01, GearKit.Ease.OutBack(t))
		end)
		self:Celebrate()
	else
		animator:Play("place", 0.4, function(t)
			local e = GearKit.Ease.OutCubic(t)
			root.Position = from:Lerp(target, e)
			self.PlaceScale.Scale = fromScale + (scale - fromScale) * e
		end)
	end
	local callback = self.OnPlaced
	if callback then
		callback(placement, first)
	end
end

-- Change la forme (taille "design") de l'accessoire
function GearPiece._setShape(self: Piece, shape: number, size: Vector2)
	self.Shape = shape
	self.Size = size
	self.Root.Size = UDim2.fromOffset(size.X, size.Y)
	self.Content.Size = UDim2.fromOffset(size.X, size.Y)
	local glow = self.Glow
	glow.Position = UDim2.fromOffset(size.X / 2, size.Y / 2)
	if size.X ~= size.Y then
		glow.Size = UDim2.fromOffset(size.X * 1.1, size.Y * 1.25)
	else
		glow.Size = UDim2.fromOffset(size.X * 1.15, size.Y * 1.15)
	end
	local callback = self.OnShape
	if callback then
		callback(shape, size)
	end
end

-- Petite gerbe d'étincelles autour de l'accessoire
function GearPiece.Celebrate(self: Piece)
	local placement = self.Placement
	if not placement or not self.Alive or not GearKit.EffectsOn(self.Ctx) then
		return
	end
	local cx, cy = placement.CX, placement.CY
	local radius = math.max(placement.W, placement.H) * 0.5 + 6
	local count = #self.Sparkles
	local random = self.Ctx.Random
	for index = 1, count do
		local star = self.Sparkles[index]
		local angle = (index / count) * math.pi * 2 + random:NextNumber(-0.3, 0.3)
		local dist = radius * random:NextNumber(0.75, 1.1)
		local delay = random:NextNumber(0, 0.12)
		self.Animator:Play(star, 0.65 + delay, function(t)
			local k = math.clamp((t * (0.65 + delay) - delay) / 0.65, 0, 1)
			if k <= 0 then
				star.Visible = false
				return
			end
			star.Visible = k < 1
			local out = GearKit.Ease.OutCubic(k)
			star.Position = UDim2.fromOffset(cx + math.cos(angle) * dist * (0.4 + 0.6 * out), cy + math.sin(angle) * dist * (0.4 + 0.6 * out))
			local s = 16 * GearKit.Bump(k)
			star.Size = UDim2.fromOffset(s, s)
			star.Rotation = 90 * k
		end, function()
			star.Visible = false
		end)
	end
end

-- Position (toile) d'un point du dessin (coordonnées locales de Content)
function GearPiece.ToCanvas(self: Piece, localPoint: Vector2): Vector2?
	local placement = self.Placement
	if not placement then
		return nil
	end
	local size = self.Size
	local scale = placement.Scale
	return Vector2.new(placement.CX + (localPoint.X - size.X / 2) * scale, placement.CY + (localPoint.Y - size.Y / 2) * scale)
end

function GearPiece.IsShown(self: Piece): boolean
	return self.Alive and self.Placement ~= nil and self.Root.Visible
end

function GearPiece.Destroy(self: Piece)
	if not self.Alive then
		return
	end
	self.Alive = false
	GearLayout.Unregister(self.Id)
	if self.Root.Parent then
		self.Root:Destroy()
	end
	if self.FX.Parent then
		self.FX:Destroy()
	end
end

return GearPiece
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="122">
            <Properties>
              <string name="Name">HandArt</string>
              <string name="Source"><![CDATA[--[[
	HandArt (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Stimuli > Gear > HandArt

	La petite main kawaii qui pointe du doigt (dessinée en Frames, boîte de
	100x100 "design", doigt vers le HAUT ; on la fait tourner pour viser).
	Utilisée par Finger (le doigt musclé), QuantumFinger (copies fantômes)
	et MegaFinger (la main géante qui écrase le bouton).

	Niveaux du "Doigt musclé" (1 à 15) — chaque niveau ajoute quelque chose :
	  1 main + petit visage   2 joues roses        3 plis des phalanges
	  4 bandeau éponge rouge  5 manche de sport    6 bague en or
	  7 vernis brillant       8 avant-bras musclé + sourcils décidés
	  9 gouttes de sueur      10 diamant sur la bague
	  11 veines, encore plus de muscle            12 bandeau de champion doré
	  13 aura de puissance + yeux étincelants     14 bague au pouce, aura orange
	  15 lunettes de soleil, aura arc-en-ciel (et la pose "flex" : voir Finger)
	La main grandit aussi un peu à chaque niveau.

	Contour : silhouettes sombres derrière les formes (voir GearKit.Outlined),
	donc il suit les UIScale. Aucun ClipsDescendants (la main est tournée).
]]

local GearKit = require(script.Parent.GearKit)

local HandArt = {}

HandArt.Size = 100 -- boîte de dessin
HandArt.TipY = 6 -- bout du doigt (y dans la boîte)

export type Hand = {
	Root: Frame, -- cadre 100x100 (contient un UIScale "ArtScale")
	ArtScale: UIScale,
	Finger: Frame, -- l'index (pour l'écraser au moment du "tap")
	FingerLine: Frame,
	Face: Frame?, -- groupe du visage (tourné à l'inverse de la main : reste droit)
	Aura: Frame?,
	Drops: { Frame },
	Base: { [Instance]: number }, -- transparences d'origine (fondu)
	FingerHeight: number,
}

export type Options = {
	Level: number?,
	Style: string?, -- "Normal" | "Ghost" | "Giant"
	Tint: Color3?, -- couleur des fantômes
	Face: boolean?,
	Name: string?,
}

local SKIN = Color3.fromRGB(255, 216, 190)
local SKIN_GRADIENT = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(236, 222, 216))
local INK = Color3.fromRGB(78, 44, 58)
local NAIL = Color3.fromRGB(255, 238, 240)
local POLISH = Color3.fromRGB(255, 92, 160)
local GOLD = Color3.fromRGB(255, 196, 40)
local GOLD_DARK = Color3.fromRGB(214, 140, 20)
local SLEEVE = Color3.fromRGB(128, 196, 255)
local SLEEVE_DARK = Color3.fromRGB(78, 146, 230)
local RED_BAND = Color3.fromRGB(235, 52, 64)

-- Caractéristiques de la main selon le niveau du doigt musclé
local function features(level: number)
	local l = math.clamp(level, 1, 15)
	return {
		Scale = 0.84 + 0.16 * (l - 1) / 14,
		FingerW = 14.5 + l * 0.42,
		FistW = 38 + l * 0.55,
		FistH = 30 + l * 0.22,
		WristW = 20 + l * 0.62,
		Blush = l >= 2,
		Creases = l >= 3,
		Band = l >= 4,
		GoldBand = l >= 12,
		SportSleeve = l >= 5,
		Ring = l >= 6,
		Gem = l >= 10,
		Polish = l >= 7,
		Muscle = l >= 8,
		BigMuscle = l >= 11,
		Brows = l >= 8,
		Sweat = l >= 9,
		Veins = l >= 11,
		Aura = l >= 13,
		SparkleEyes = l >= 13,
		ThumbRing = l >= 14,
		Shades = l >= 15,
	}
end

HandArt.Features = features

-- Couleur de l'aura selon le niveau (13 jaune, 14 orange, 15 arc-en-ciel)
local function auraColor(level: number): Color3
	if level >= 15 then
		return Color3.fromRGB(255, 120, 220)
	elseif level >= 14 then
		return Color3.fromRGB(255, 150, 40)
	end
	return Color3.fromRGB(255, 226, 60)
end

-- Construit la main dans `parent` (cadre 100x100, AnchorPoint 0.5 / centré)
function HandArt.Build(parent: Instance, options: Options?): Hand
	local opts = options or {}
	local level = opts.Level or 1
	local style = opts.Style or "Normal"
	local f = features(level)
	local ghost = style == "Ghost"
	local giant = style == "Giant"
	if giant then
		-- La main géante est au maximum de sa forme
		f = features(15)
		f.Shades = false
		f.Aura = false
	end

	local skin = SKIN
	local ink = INK
	local fillTransparency = 0
	local lineTransparency = 0
	if ghost then
		local tint = opts.Tint or Color3.fromRGB(90, 230, 255)
		skin = tint:Lerp(Color3.new(1, 1, 1), 0.55)
		ink = tint
		fillTransparency = 0.45
		lineTransparency = 0.15
	end

	local root = Instance.new("Frame")
	root.Name = opts.Name or "Hand"
	root.BackgroundTransparency = 1
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.Position = UDim2.fromScale(0.5, 0.5)
	root.Size = UDim2.fromOffset(HandArt.Size, HandArt.Size)
	local artScale = Instance.new("UIScale")
	artScale.Name = "ArtScale"
	artScale.Scale = f.Scale
	artScale.Parent = root

	local function part(name: string, x: number, y: number, w: number, h: number, color: Color3, props: { [string]: any }?): (Frame, Frame)
		local p = props or {}
		p.Name = name
		p.OutlineColor = p.OutlineColor or ink
		p.OutlineTransparency = p.OutlineTransparency or lineTransparency
		p.Transparency = p.Transparency or fillTransparency
		if p.Gradient == nil and not ghost and color == skin then
			p.Gradient = SKIN_GRADIENT
		end
		return GearKit.Outlined(root, x, y, w, h, color, p)
	end

	-- Mesures
	local fistW, fistH = f.FistW, f.FistH
	local fistX = 50 - fistW / 2 + 2
	local fistY = 34
	local fingerW = f.FingerW
	local fingerX = fistX + 2
	local tipY = HandArt.TipY
	local fingerH = fistY + 12 - tipY
	local wristW = f.WristW
	local wristX = 50 - wristW / 2 + 2
	local wristY = fistY + fistH - 8
	local wristBottom = 89

	-- Aura (derrière tout)
	local aura: Frame? = nil
	if f.Aura and not ghost then
		-- Trois disques concentriques : une lueur "radiale"
		local color = auraColor(level)
		local halo = GearKit.Box(root, 50, 50, 106, 106, color, {
			Name = "Aura",
			Anchor = Vector2.new(0.5, 0.5),
			Radius = "round",
			Transparency = 0.86,
			Z = 0,
			Gradient = level >= 15 and GearKit.RainbowSequence(0, 0.6) or nil,
			GradientRotation = 45,
		})
		GearKit.Box(halo, 53, 53, 84, 84, color, { Name = "AuraMid", Anchor = Vector2.new(0.5, 0.5), Radius = "round", Transparency = 0.8, Z = 0 })
		GearKit.Box(halo, 53, 53, 62, 62, Color3.new(1, 1, 1):Lerp(color, 0.5), { Name = "AuraCore", Anchor = Vector2.new(0.5, 0.5), Radius = "round", Transparency = 0.72, Z = 0 })
		aura = halo
	end

	-- Avant-bras + manche
	part("Forearm", wristX, wristY, wristW, wristBottom - wristY, skin, { Radius = 8, Z = 3, LineZ = 1 })
	if f.Muscle and not ghost then
		local bulgeW = f.BigMuscle and wristW * 0.62 or wristW * 0.5
		local bulgeH = f.BigMuscle and 23 or 19
		part("Muscle", wristX + wristW - bulgeW * 0.55, wristY + 10, bulgeW, bulgeH, skin, { Radius = "round", Z = 3, LineZ = 1 })
		GearKit.Shine(root, wristX + wristW - bulgeW * 0.1, wristY + 14, bulgeW * 0.3, 6, 0.5, 9, -20)
	end
	if f.Veins and not ghost then
		GearKit.Box(root, wristX + 5, wristY + 15, 2, 10, Color3.fromRGB(200, 120, 160), { Name = "Vein", Radius = "round", Rotation = 16, Transparency = 0.2, Z = 9 })
		GearKit.Box(root, wristX + 9, wristY + 20, 2, 7, Color3.fromRGB(200, 120, 160), { Name = "Vein", Radius = "round", Rotation = -24, Transparency = 0.2, Z = 9 })
	end
	local sleeveW = wristW + 14
	local sleeveColor = ghost and skin or SLEEVE
	part("Sleeve", 50 - sleeveW / 2 + 2, wristBottom - 4, sleeveW, 14, sleeveColor, {
		Radius = 7,
		Z = 7,
		LineZ = 6,
		Gradient = (not ghost) and ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(210, 222, 240)) or nil,
	})
	if f.SportSleeve and not ghost then
		GearKit.Box(root, 50 - sleeveW / 2 + 4, wristBottom, sleeveW - 4, 2.5, Color3.new(1, 1, 1), { Name = "Stripe", Z = 8 })
		GearKit.Box(root, 50 - sleeveW / 2 + 4, wristBottom + 4, sleeveW - 4, 2.5, SLEEVE_DARK, { Name = "Stripe", Z = 8 })
	end

	-- Poing
	part("Fist", fistX, fistY, fistW, fistH, skin, { Radius = 13, Z = 4, LineZ = 1 })
	-- Doigts repliés (bosses en haut à droite du poing)
	local bumpW = (fistX + fistW - (fingerX + fingerW)) / 3
	for index = 1, 3 do
		local bx = fingerX + fingerW - 1 + (index - 1) * bumpW
		part("Knuckle" .. index, bx, fistY - 4 + (index - 1) * 1.5, bumpW + 1, 14, skin, { Radius = "round", Z = 4, LineZ = 1 })
		if f.Creases and index > 1 then
			GearKit.Box(root, bx, fistY + 1 + (index - 1) * 1.5, 1.6, 9, ink, { Name = "Crease", Radius = "round", Transparency = 0.45, Z = 8 })
		end
	end

	-- Index
	local finger, fingerLine = part("Finger", fingerX, tipY, fingerW, fingerH, skin, { Radius = "round", Z = 5, LineZ = 1 })
	local nailColor = (f.Polish and not ghost) and (level >= 15 and GOLD or POLISH) or (ghost and skin or NAIL)
	local nail = GearKit.Box(finger, 3, 3, fingerW - 6, 10, nailColor, { Name = "Nail", Radius = 5, Z = 6, Transparency = fillTransparency })
	if not ghost then
		GearKit.Shine(nail, 2, 1.5, 3, 4, 0.35, 7)
		if f.Creases then
			GearKit.Box(finger, fingerW * 0.28, 22, fingerW * 0.44, 1.6, ink, { Name = "Crease", Radius = "round", Transparency = 0.5, Z = 7 })
			GearKit.Box(finger, fingerW * 0.3, 30, fingerW * 0.4, 1.6, ink, { Name = "Crease", Radius = "round", Transparency = 0.5, Z = 7 })
		end
		GearKit.Shine(finger, 2.5, 14, 3, fingerH * 0.35, 0.6, 7)
	end
	if f.Ring and not ghost then
		local ringY = fistY - 9
		GearKit.Box(root, fingerX - 1.5, ringY, fingerW + 3, 5.5, GOLD, {
			Name = "Ring",
			Radius = 2,
			Z = 8,
			Gradient = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(230, 170, 60)),
		})
		if f.Gem then
			local gem = GearKit.Box(root, fingerX + fingerW / 2, ringY + 1, 7, 7, Color3.fromRGB(120, 235, 255), {
				Name = "Gem",
				Anchor = Vector2.new(0.5, 0.5),
				Rotation = 45,
				Z = 9,
			})
			GearKit.Shine(gem, 1, 1, 2.5, 2.5, 0.1, 10)
		end
	end

	-- Pouce (devant le poing : son contour passe par-dessus)
	local thumb = part("Thumb", fistX - 6, fistY + 4, 13, 24, skin, { Radius = "round", Rotation = 38, Z = 6, LineZ = 5 })
	if f.ThumbRing and not ghost then
		GearKit.Box(thumb, 1, 14, 12, 4.5, GOLD_DARK:Lerp(GOLD, 0.6), { Name = "ThumbRing", Radius = 2, Z = 8 })
	end

	-- Bandeau éponge (poignet)
	if f.Band and not ghost then
		local bandColor = f.GoldBand and GOLD or RED_BAND
		local bandY = fistY + fistH - 5
		local band = part("Band", wristX - 3, bandY, wristW + 6, 10, bandColor, {
			Radius = 3,
			Z = 7,
			LineZ = 6,
			Gradient = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(215, 205, 205)),
		})
		if f.GoldBand then
			GearKit.Star(band, (wristW + 6) / 2, 5, 8, Color3.new(1, 1, 1), 9)
		else
			GearKit.Box(band, 0, 4, wristW + 6, 2, Color3.new(1, 1, 1), { Name = "Stripe", Z = 8 })
		end
	end

	-- Visage (sur le poing), dans un groupe qui reste droit
	local face: Frame? = nil
	if opts.Face ~= false and not ghost then
		local group = Instance.new("Frame")
		group.Name = "Face"
		group.BackgroundTransparency = 1
		group.AnchorPoint = Vector2.new(0.5, 0.5)
		group.Size = UDim2.fromOffset(30, 20)
		group.Position = UDim2.fromOffset(fistX + fistW / 2 + 4, fistY + fistH / 2 + 3)
		group.ZIndex = 10
		group.Parent = root
		local eyeInk = Color3.fromRGB(58, 30, 40)
		if f.Shades then
			GearKit.Box(group, 1, 3, 28, 3, Color3.fromRGB(20, 20, 26), { Name = "Bridge", Radius = 1, Z = 2 })
			GearKit.Box(group, 2, 4, 11, 8, Color3.fromRGB(20, 20, 26), { Name = "Lens", Radius = 4, Z = 2 })
			GearKit.Box(group, 17, 4, 11, 8, Color3.fromRGB(20, 20, 26), { Name = "Lens", Radius = 4, Z = 2 })
			GearKit.Box(group, 4, 5.5, 5, 1.6, Color3.new(1, 1, 1), { Name = "Glint", Radius = "round", Transparency = 0.2, Z = 3 })
			GearKit.Box(group, 19, 5.5, 5, 1.6, Color3.new(1, 1, 1), { Name = "Glint", Radius = "round", Transparency = 0.2, Z = 3 })
		else
			for side = 0, 1 do
				local ex = side == 0 and 8 or 19
				local eye = GearKit.Box(group, ex, 5, 4, 5.5, eyeInk, { Name = "Eye", Radius = "round", Z = 2 })
				if f.SparkleEyes or giant then
					GearKit.Box(eye, 0.6, 0.6, 1.8, 1.8, Color3.new(1, 1, 1), { Name = "Glint", Radius = "round", Z = 3 })
				end
				if f.Brows then
					GearKit.Box(group, ex - 1.5, 1, 7, 2, eyeInk, {
						Name = "Brow",
						Radius = "round",
						Rotation = side == 0 and 18 or -18,
						Z = 2,
					})
				end
			end
		end
		if f.Blush then
			GearKit.Box(group, 1, 11, 6, 3.5, Color3.fromRGB(255, 130, 150), { Name = "Blush", Radius = "round", Transparency = 0.35, Z = 1 })
			GearKit.Box(group, 23, 11, 6, 3.5, Color3.fromRGB(255, 130, 150), { Name = "Blush", Radius = "round", Transparency = 0.35, Z = 1 })
		end
		local mouth = GearKit.Box(group, 12.5, 12, 5, 3.5, Color3.fromRGB(160, 50, 70), { Name = "Mouth", Radius = "round", Z = 2 })
		if f.Shades or giant then
			mouth.Size = UDim2.fromOffset(7, 2.5)
			mouth.Position = UDim2.fromOffset(12, 13)
			mouth.Rotation = -8
		end
		face = group
	end

	-- Gouttes de sueur (niveau 9+)
	local drops = {}
	if f.Sweat and not ghost then
		for index = 1, 2 do
			local drop = GearKit.Box(root, fistX + fistW + 1 + index * 3, fistY - 14 + index * 9, 5, 7, Color3.fromRGB(130, 210, 255), {
				Name = "Drop",
				Radius = "round",
				Z = 9,
			})
			GearKit.Box(drop, 1, 1, 1.6, 2.4, Color3.new(1, 1, 1), { Name = "Glint", Radius = "round", Transparency = 0.1, Z = 10 })
			table.insert(drops, drop)
		end
	end

	root.Parent = parent
	return {
		Root = root,
		ArtScale = artScale,
		Finger = finger,
		FingerLine = fingerLine,
		Face = face,
		Aura = aura,
		Drops = drops,
		Base = GearKit.CaptureTransparency(root),
		FingerHeight = fingerH,
	}
end

-- Visée d'une main posée en `placement` (GearLayout) vers le bouton :
-- angle (degrés), direction (unitaire), course du "tap" (px toile) et
-- vrai si le bout du doigt peut toucher le bouton (sinon petit coup dans le vide)
function HandArt.Aim(placement: any, artScale: number, touchRange: number?): (number, Vector2, number, boolean)
	local center = Vector2.new(placement.CX, placement.CY)
	local button = placement.Button
	local target = GearKit.Center(button)
	-- Un peu vers le bord le plus proche : le doigt touche le bouton "de face"
	local edge = GearKit.ClosestOnRect(button, center)
	target = target:Lerp(edge, 0.35)
	local angle = GearKit.AimAngle(center, target)
	local dir = GearKit.AngleDir(angle)
	local tipDistance = (HandArt.Size / 2 - HandArt.TipY) * artScale * placement.Scale
	local gap = GearKit.RayToRect(center + dir * tipDistance, dir, button)
	local touching = gap <= (touchRange or 46)
	return angle, dir, touching and (gap + 2) or 12, touching
end

-- Main "fantôme" légère (QuantumFinger) : mêmes formes que la vraie main,
-- mais seulement des aplats translucides (pas de contour ni de détails) :
-- ~12 instances au lieu d'une cinquantaine.
export type Ghost = {
	Root: Frame,
	ArtScale: UIScale,
	Parts: { Frame },
	Finger: Frame,
}

function HandArt.BuildGhost(parent: Instance, tint: Color3, level: number?, name: string?): Ghost
	local f = features(level or 1)
	local root = Instance.new("Frame")
	root.Name = name or "Ghost"
	root.BackgroundTransparency = 1
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.Position = UDim2.fromScale(0.5, 0.5)
	root.Size = UDim2.fromOffset(HandArt.Size, HandArt.Size)
	local artScale = Instance.new("UIScale")
	artScale.Name = "ArtScale"
	artScale.Scale = f.Scale
	artScale.Parent = root

	local light = tint:Lerp(Color3.new(1, 1, 1), 0.45)
	local parts = {}
	local function blob(partName: string, x: number, y: number, w: number, h: number, color: Color3, radius: any, rotation: number?, z: number): Frame
		local frame = GearKit.Box(root, x, y, w, h, color, {
			Name = partName,
			Radius = radius,
			Rotation = rotation,
			Transparency = 0.42,
			Z = z,
		})
		table.insert(parts, frame)
		return frame
	end
	local fistW, fistH = f.FistW, f.FistH
	local fistX = 50 - fistW / 2 + 2
	local fistY = 34
	local fingerW = f.FingerW
	local wristW = f.WristW
	local wristY = fistY + fistH - 8
	blob("Sleeve", 50 - (wristW + 14) / 2 + 2, 85, wristW + 14, 14, tint, 7, nil, 1)
	blob("Forearm", 50 - wristW / 2 + 2, wristY, wristW, 89 - wristY, light, 8, nil, 2)
	blob("Fist", fistX, fistY - 4, fistW, fistH + 4, light, 13, nil, 3)
	local finger = blob("Finger", fistX + 2, HandArt.TipY, fingerW, fistY + 12 - HandArt.TipY, light, "round", nil, 4)
	GearKit.Box(finger, 3, 3, fingerW - 6, 9, Color3.new(1, 1, 1), { Name = "Nail", Radius = 4, Transparency = 0.25, Z = 5 })
	blob("Thumb", fistX - 6, fistY + 4, 13, 24, tint, "round", 38, 5)
	root.Parent = parent
	return { Root = root, ArtScale = artScale, Parts = parts, Finger = finger }
end

-- Écrase un peu l'index (0 = normal, 1 = écrasé) : le bout du doigt descend
function HandArt.Squash(hand: Hand, amount: number)
	local squash = 5 * amount
	local h = hand.FingerHeight
	hand.Finger.Size = UDim2.fromOffset(hand.Finger.Size.X.Offset, h - squash)
	hand.Finger.Position = UDim2.fromOffset(hand.Finger.Position.X.Offset, HandArt.TipY + squash)
	local line = hand.FingerLine
	line.Size = UDim2.fromOffset(line.Size.X.Offset, h + 5 - squash)
	line.Position = UDim2.fromOffset(line.Position.X.Offset, HandArt.TipY - 2.5 + squash)
end

return HandArt
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="123">
            <Properties>
              <string name="Name">KeyInput</string>
              <string name="Source"><![CDATA[--[[
	KeyInput (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Stimuli > Gear > KeyInput

	v9.1 : le VRAI clavier du joueur appuie sur les touches du clavier du jeu.
	Une seule connexion à UserInputService.InputBegan, partagée par les
	claviers du jeu (clavier mécanique, clavier corail) :
	  - ignorée si le jeu a déjà traité la touche (gameProcessed : chat,
	    menus Roblox...) ou si une zone de texte a le focus (chat du live...) ;
	  - seulement les touches qui existent sur le clavier du jeu (lettres,
	    espace, entrée, retour arrière, maj, ctrl, alt, , . ?) ;
	  - chaque clavier inscrit ET actif (visible, aucune fenêtre ouverte)
	    enfonce la touche correspondante ; UN SEUL clic est compté par
	    appui (le clavier de plus petite priorité clique, les autres
	    s'animent seulement). Maintenir une touche ne répète pas le clic.

	API :
	  KeyInput.Register(id, { Priority = number, Active = () -> boolean,
	                          Press = (code: string, doClick: boolean) -> () })
	  KeyInput.Unregister(id)
	  KeyInput.Dispatch(code) (tests / émulateur : comme un appui réel)
]]

local UserInputService = game:GetService("UserInputService")

local KeyboardArt = require(script.Parent.KeyboardArt)

export type Entry = {
	Priority: number,
	Active: () -> boolean,
	Press: (code: string, doClick: boolean) -> (),
}

local KeyInput = {}

local entries: { [string]: Entry } = {}
local connection: RBXScriptConnection? = nil

local function sorted(): { Entry }
	local list = {}
	for _, entry in pairs(entries) do
		local ok, active = pcall(entry.Active)
		if ok and active then
			table.insert(list, entry)
		end
	end
	table.sort(list, function(a, b)
		return a.Priority < b.Priority
	end)
	return list
end

function KeyInput.Dispatch(code: string): boolean
	local list = sorted()
	for index, entry in ipairs(list) do
		local ok, err = pcall(entry.Press, code, index == 1)
		if not ok then
			warn("[KeyInput] " .. tostring(err))
		end
	end
	return #list > 0
end

local function onInput(input: InputObject, gameProcessed: boolean)
	if gameProcessed or input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end
	local focused = nil
	pcall(function()
		focused = UserInputService:GetFocusedTextBox()
	end)
	if focused then
		return
	end
	local code = KeyboardArt.CodeFor(input.KeyCode.Name)
	if code then
		KeyInput.Dispatch(code)
	end
end

function KeyInput.Register(id: string, entry: Entry)
	entries[id] = entry
	if not connection then
		connection = UserInputService.InputBegan:Connect(onInput)
	end
end

function KeyInput.Unregister(id: string)
	entries[id] = nil
	if next(entries) == nil and connection then
		connection:Disconnect()
		connection = nil
	end
end

return KeyInput
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="124">
            <Properties>
              <string name="Name">KeyboardArt</string>
              <string name="Source"><![CDATA[--[[
	KeyboardArt (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Stimuli > Gear > KeyboardArt

	Vraies touches QWERTY CLIQUABLES (partagé par Keyboard, CoralKeys et le
	grand clavier flottant KeyboardPanel) :
	  - KeyboardArt.Build(parent, layout, x, y, w, h, options) : dessine un
	    clavier dans le rectangle (x, y, w, h), centré, touches aussi grandes
	    que possible. Deux dispositions :
	      "Full" : Q W E R T Y U I O P back / A S D F G H J K L enter /
	               shift Z X C V B N M , . ? / ctrl alt [espace] alt fn
	      "Mini" : Q W E R T Y / A S D F G H / Z X C V B N / [espace] enter
	               (petit clavier "résumé" quand la place manque)
	    Renvoie (touches, unité) : unité = taille d'une touche carrée (px).
	  - chaque touche = un TextButton (le "socle", plus sombre) + la face
	    (Frame arrondie, léger dégradé) + la légende (TextLabel) : on clique
	    n'importe où sur la touche ; Key.Button reçoit les clics ;
	  - KeyboardArt.Press(key, amount, lit?) : touche enfoncée (0..1) ;
	  - KeyboardArt.SetColor(key, couleur) : nouvelle couleur de base ;
	  - KeyboardArt.Pick(keys, count, random) : quelques touches au hasard ;
	  - KeyboardArt.CodeFor(keyCodeName) : touche du jeu pour une touche du
	    vrai clavier (Enum.KeyCode.Name -> Code : "Q", "Space", "Return"...) ;
	  - KeyboardArt.Find(keys, code) : la touche qui porte ce Code (ou nil).
	Aucune instance n'est créée pendant les clics (tout est construit une fois).
]]

local KeyboardArt = {}

export type Key = {
	Button: TextButton,
	Frame: Frame, -- face de la touche (ce qui bouge quand on appuie)
	Label: TextLabel,
	Row: number,
	Col: number,
	X: number,
	Y: number,
	W: number,
	H: number,
	Fx: number,
	Fy: number,
	Kind: string, -- "Key" | "Mod" | "Space" | "Enter" | "Back"
	Code: string,
	Legend: string,
	Color: Color3,
	Units: number,
	Depth: number, -- hauteur du socle visible sous la face (px)
	Artisan: boolean?, -- touche artisanale (couleur fixe)
}

export type KeysOptions = {
	Color: ((key: Key) -> Color3)?,
	LegendColor: ((key: Key) -> Color3)?,
	Font: Enum.Font?,
	Radius: number?, -- en fraction de l'unité (défaut 0.16)
	Gap: number?, -- en fraction de l'unité (défaut 0.1)
	Z: number?,
	Name: string?,
}

-- { légende, Code, unités, genre }
type Spec = { string | number }

local ROWS: { [string]: { Indent: { number }, Rows: { { Spec } } } } = {
	Full = {
		Indent = { 0, 0.25, 0, 0 },
		Rows = {
			{ { "Q", "Q", 1 }, { "W", "W", 1 }, { "E", "E", 1 }, { "R", "R", 1 }, { "T", "T", 1 }, { "Y", "Y", 1 },
				{ "U", "U", 1 }, { "I", "I", 1 }, { "O", "O", 1 }, { "P", "P", 1 }, { "back", "Backspace", 1.5, "Back" } },
			{ { "A", "A", 1 }, { "S", "S", 1 }, { "D", "D", 1 }, { "F", "F", 1 }, { "G", "G", 1 }, { "H", "H", 1 },
				{ "J", "J", 1 }, { "K", "K", 1 }, { "L", "L", 1 }, { "enter", "Return", 2.25, "Enter" } },
			{ { "shift", "Shift", 1.5, "Mod" }, { "Z", "Z", 1 }, { "X", "X", 1 }, { "C", "C", 1 }, { "V", "V", 1 }, { "B", "B", 1 },
				{ "N", "N", 1 }, { "M", "M", 1 }, { ",", "Comma", 1 }, { ".", "Period", 1 }, { "?", "Slash", 1 } },
			{ { "ctrl", "Ctrl", 1.5, "Mod" }, { "alt", "Alt", 1.25, "Mod" }, { "", "Space", 6, "Space" },
				{ "alt", "AltRight", 1.25, "Mod" }, { "fn", "Fn", 1.5, "Mod" } },
		},
	},
	Mini = {
		Indent = { 0, 0, 0, 0 },
		Rows = {
			{ { "Q", "Q", 1 }, { "W", "W", 1 }, { "E", "E", 1 }, { "R", "R", 1 }, { "T", "T", 1 }, { "Y", "Y", 1 } },
			{ { "A", "A", 1 }, { "S", "S", 1 }, { "D", "D", 1 }, { "F", "F", 1 }, { "G", "G", 1 }, { "H", "H", 1 } },
			{ { "Z", "Z", 1 }, { "X", "X", 1 }, { "C", "C", 1 }, { "V", "V", 1 }, { "B", "B", 1 }, { "N", "N", 1 } },
			{ { "", "Space", 4, "Space" }, { "enter", "Return", 2, "Enter" } },
		},
	},
}

-- Largeur (en unités) d'une disposition
local function layoutUnits(layout: string): (number, number)
	local def = ROWS[layout] or ROWS.Full
	local widest = 0
	for index, row in ipairs(def.Rows) do
		local total = def.Indent[index] or 0
		for _, spec in ipairs(row) do
			total += spec[3] :: number
		end
		widest = math.max(widest, total)
	end
	return widest, #def.Rows
end
KeyboardArt.LayoutUnits = layoutUnits

export type Geometry = {
	Step: number,
	W: number,
	H: number,
	Pad: number,
	CaseX: number,
	CaseY: number,
	CaseW: number,
	CaseH: number,
	KeysX: number,
	KeysY: number,
	KeysW: number,
	KeysH: number,
	RestY: number,
	RestH: number,
}

-- Mise en page d'un clavier dessiné pour un pas de touche `step` (touche +
-- écart) : tapis (marge), place du câble en haut, boîtier, touches,
-- repose-poignets en bas. `top` / `bottom` / `side` : place en plus (décors).
function KeyboardArt.Geometry(layout: string, step: number, top: number?, bottom: number?, side: number?): Geometry
	local unitsW, rows = layoutUnits(layout)
	local pad = step * 0.34 + (side or 0)
	local casePad = step * 0.3
	local keysW, keysH = unitsW * step, rows * step
	local caseW, caseH = keysW + casePad * 2, keysH + casePad * 2
	local caseX = pad
	local caseY = step * 0.5 + (top or 0)
	local restH = step * 0.42
	local restY = caseY + caseH + step * 0.14
	return {
		Step = step,
		W = caseW + pad * 2,
		H = restY + restH + step * 0.3 + (bottom or 0),
		Pad = pad,
		CaseX = caseX,
		CaseY = caseY,
		CaseW = caseW,
		CaseH = caseH,
		KeysX = caseX + casePad,
		KeysY = caseY + casePad,
		KeysW = keysW,
		KeysH = keysH,
		RestY = restY,
		RestH = restH,
	}
end

-- Vraies touches (Enum.KeyCode.Name) -> Code des touches du jeu
local ALIASES: { [string]: string } = {
	LeftShift = "Shift",
	RightShift = "Shift",
	LeftControl = "Ctrl",
	RightControl = "Ctrl",
	LeftAlt = "Alt",
	RightAlt = "AltRight",
	KeypadEnter = "Return",
	Question = "Slash",
}

function KeyboardArt.CodeFor(keyCodeName: string): string?
	if #keyCodeName == 1 and string.match(keyCodeName, "^%u$") then
		return keyCodeName
	end
	local alias = ALIASES[keyCodeName]
	if alias then
		return alias
	end
	if keyCodeName == "Space" or keyCodeName == "Return" or keyCodeName == "Backspace" or keyCodeName == "Comma"
		or keyCodeName == "Period" or keyCodeName == "Slash" then
		return keyCodeName
	end
	return nil
end

function KeyboardArt.Find(keys: { Key }, code: string): Key?
	for _, key in ipairs(keys) do
		if key.Code == code then
			return key
		end
	end
	return nil
end

local function darker(color: Color3, amount: number): Color3
	return color:Lerp(Color3.fromRGB(40, 34, 60), amount)
end

-- Encre lisible sur la couleur de la touche
local function inkFor(color: Color3): Color3
	local luminance = 0.299 * color.R + 0.587 * color.G + 0.114 * color.B
	if luminance < 0.5 then
		return Color3.fromRGB(250, 248, 255)
	end
	return Color3.fromRGB(52, 44, 72)
end
KeyboardArt.InkFor = inkFor

local function corner(parent: Instance, radius: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
end

-- Dessine un clavier ; renvoie (touches, unité)
function KeyboardArt.Build(parent: Instance, layout: string, x: number, y: number, w: number, h: number, options: KeysOptions?): ({ Key }, number)
	local opts = options or {}
	local def = ROWS[layout] or ROWS.Full
	local unitsW, rows = layoutUnits(layout)
	local gapK = opts.Gap or 0.1
	-- Unité (touche + écart) la plus grande qui tient dans w x h
	local step = math.min(w / unitsW, h / rows)
	local gap = math.max(1, step * gapK)
	local unit = step - gap
	local totalW, totalH = step * unitsW - gap, step * rows - gap
	local x0 = x + (w - totalW) / 2
	local y0 = y + (h - totalH) / 2
	local radius = math.max(2, unit * (opts.Radius or 0.16))
	local depth = math.max(1.5, unit * 0.13)
	local z = opts.Z or 10
	local font = opts.Font or Enum.Font.BuilderSansBold
	local keys: { Key } = {}
	for rowIndex, row in ipairs(def.Rows) do
		local kx = x0 + (def.Indent[rowIndex] or 0) * step
		local ky = y0 + (rowIndex - 1) * step
		for colIndex, spec in ipairs(row) do
			local units = spec[3] :: number
			local kw = step * units - gap
			local legend = spec[1] :: string
			local key: Key = {
				Button = (nil :: any) :: TextButton,
				Frame = (nil :: any) :: Frame,
				Label = (nil :: any) :: TextLabel,
				Row = rowIndex,
				Col = colIndex,
				X = kx,
				Y = ky,
				W = kw,
				H = unit,
				Fx = (kx + kw / 2 - x0) / math.max(1, totalW),
				Fy = (ky + unit / 2 - y0) / math.max(1, totalH),
				Kind = (spec[4] :: string?) or "Key",
				Code = spec[2] :: string,
				Legend = legend,
				Color = Color3.new(1, 1, 1),
				Units = units,
				Depth = depth,
			}
			local color = opts.Color and opts.Color(key) or Color3.fromRGB(248, 248, 252)
			key.Color = color

			-- Socle (reçoit les clics)
			local button = Instance.new("TextButton")
			button.Name = (opts.Name or "Key_") .. key.Code
			button.AutoButtonColor = false
			button.Selectable = false
			button.Text = ""
			button.BorderSizePixel = 0
			button.BackgroundColor3 = darker(color, 0.42)
			button.Position = UDim2.fromOffset(kx, ky)
			button.Size = UDim2.fromOffset(kw, unit)
			button.ZIndex = z
			corner(button, radius)

			-- Face (bouge quand on appuie)
			local face = Instance.new("Frame")
			face.Name = "Face"
			face.BorderSizePixel = 0
			face.BackgroundColor3 = color
			face.Position = UDim2.fromOffset(0, 0)
			face.Size = UDim2.new(1, 0, 1, -depth)
			face.ZIndex = z + 1
			corner(face, radius)
			local gradient = Instance.new("UIGradient")
			gradient.Rotation = 90
			gradient.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(222, 222, 234))
			gradient.Parent = face
			face.Parent = button

			-- Légende
			local label = Instance.new("TextLabel")
			label.Name = "Legend"
			label.BackgroundTransparency = 1
			label.Size = UDim2.fromScale(1, 1)
			label.Font = font
			label.Text = legend
			local small = #legend > 1
			label.TextSize = math.max(6, math.floor(unit * (small and 0.36 or 0.56)))
			label.TextColor3 = opts.LegendColor and opts.LegendColor(key) or inkFor(color)
			label.ZIndex = z + 2
			label.Parent = face

			button.Parent = parent
			key.Button = button
			key.Frame = face
			key.Label = label
			table.insert(keys, key)
			kx += step * units
		end
	end
	return keys, unit
end

-- Touche enfoncée : la face descend sur son socle et s'assombrit (ou
-- s'illumine : `lit`). amount = 0 (relâchée) .. 1 (au fond)
function KeyboardArt.Press(key: Key, amount: number, lit: Color3?)
	local face = key.Frame
	face.Position = UDim2.fromOffset(0, key.Depth * amount)
	if lit then
		face.BackgroundColor3 = key.Color:Lerp(lit, 0.75 * amount)
	else
		face.BackgroundColor3 = key.Color:Lerp(Color3.fromRGB(60, 60, 80), 0.3 * amount)
	end
end

-- Change la couleur "de base" d'une touche (lumières RGB...)
function KeyboardArt.SetColor(key: Key, color: Color3)
	key.Color = color
	key.Frame.BackgroundColor3 = color
	key.Button.BackgroundColor3 = darker(color, 0.42)
end

-- `count` touches différentes au hasard (hors barre d'espace si possible)
function KeyboardArt.Pick(keys: { Key }, count: number, random: Random): { Key }
	local picked: { Key } = {}
	local used: { [number]: boolean } = {}
	local tries = 0
	while #picked < count and tries < 40 and #keys > 0 do
		tries += 1
		local index = random:NextInteger(1, #keys)
		if not used[index] and keys[index].Units < 4 then
			used[index] = true
			table.insert(picked, keys[index])
		end
	end
	return picked
end

-- Touche "artisanale" : dorée, avec une étoile blanche en légende
function KeyboardArt.Artisan(key: Key, _z: number)
	KeyboardArt.SetColor(key, Color3.fromRGB(255, 200, 60))
	key.Artisan = true
	key.Label.Text = "★"
	key.Label.TextColor3 = Color3.new(1, 1, 1)
	key.Label.TextSize = math.max(6, math.floor(key.H * 0.62))
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(200, 120, 20)
	stroke.Thickness = math.max(1, key.H * 0.05)
	stroke.Parent = key.Label
end

return KeyboardArt
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="125">
            <Properties>
              <string name="Name">KeyboardPanel</string>
              <string name="Source"><![CDATA[--[[
	KeyboardPanel (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Stimuli > Gear > KeyboardPanel

	v9.1 : GRAND clavier flottant. Quand le clavier posé à l'écran est trop
	petit pour viser ses touches (téléphone, écran chargé), un appui dessus
	ouvre ce grand clavier en bas de l'écran (comme le clavier d'un
	téléphone) : vraies touches QWERTY bien grosses (≈ 40 px sur PC, 46 px
	en tactile), le même dessin que le clavier posé (niveau compris),
	un titre, une astuce et un gros bouton ✕.
	  - calque Overlay (au-dessus des cartes, sous les fenêtres et toasts) ;
	  - UIUtil.SinkClicks : un appui entre deux touches ne traverse pas ;
	  - un appui EN DEHORS du clavier le ferme (comme les autres fenêtres),
	    sans bloquer le reste de l'écran (pas de voile) ;
	  - fermé aussi quand une fenêtre s'ouvre / l'écran change ;
	  - un seul grand clavier ouvert à la fois (clavier mécanique OU corail) ;
	  - construit au premier affichage puis réutilisé (reconstruit seulement
	    si le niveau ou l'écran a changé).

	API : KeyboardPanel.new(ctx, options) -> panel
	  options = { Id, Title: () -> string, Tray: Color3?,
	              Build: (parent, step) -> (keys, largeur, hauteur),
	              OnKey: (key) -> () }
	  panel:Open(), panel:Close(), panel:IsOpen(), panel:MarkDirty(),
	  panel:FindKey(code), panel:KeyPoint(key) -> Vector2 (toile), panel:Destroy()
	  KeyboardPanel.CloseAll()
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Locale = require(ReplicatedStorage.Shared.Locale)
local KeyboardArt = require(script.Parent.KeyboardArt)

local KeyboardPanel = {}
KeyboardPanel.__index = KeyboardPanel

export type Options = {
	Id: string,
	Title: () -> string,
	Tray: Color3?,
	Build: (parent: Frame, step: number) -> ({ KeyboardArt.Key }, number, number),
	OnKey: (key: KeyboardArt.Key) -> (),
}

local PANEL_Z = 2000
local openPanel: any = nil

function KeyboardPanel.CloseAll()
	local panel = openPanel
	if panel then
		panel:Close()
	end
end

function KeyboardPanel.new(ctx: any, options: Options)
	local self = setmetatable({
		Ctx = ctx,
		Options = options,
		Frame = nil :: Frame?,
		Art = nil :: Frame?,
		Keys = {} :: { KeyboardArt.Key },
		Dirty = true,
		Opened = false,
		OpenedAt = 0,
		InsideAt = -1,
		Title = nil :: TextLabel?,
		Hint = nil :: TextLabel?,
		Scale = nil :: UIScale?,
		Token = 0,
		Alive = true,
	}, KeyboardPanel)

	-- Appui en dehors : on ferme (vérifié un peu après, quand les boutons du
	-- panneau ont eu le temps de signaler un appui "dedans")
	ctx.Connect(UserInputService.InputBegan, function(input: InputObject)
		if not self.Opened then
			return
		end
		local kind = input.UserInputType
		if kind ~= Enum.UserInputType.MouseButton1 and kind ~= Enum.UserInputType.Touch then
			return
		end
		local stamp = os.clock()
		if math.abs(stamp - self.OpenedAt) < 0.15 then
			return -- (l'appui qui vient d'ouvrir le panneau)
		end
		task.delay(0.1, function()
			if self.Opened and math.abs(self.InsideAt - stamp) > 0.08 and math.abs(stamp - self.OpenedAt) >= 0.15 then
				self:Close()
			end
		end)
	end)
	ctx.OnVisibilityChanged(function(visibility: string)
		if visibility ~= "Visible" then
			self:Close()
		end
	end)
	ctx.Connect(ctx.Interface.ScaleChanged, function()
		self.Dirty = true
		self:Close()
	end)
	return self
end

function KeyboardPanel.MarkInside(self: any)
	self.InsideAt = os.clock()
end

local function isPress(input: InputObject): boolean
	local kind = input.UserInputType
	return kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch
end

-- (Re)construit le panneau à la taille de l'écran
function KeyboardPanel._build(self: any)
	local ctx = self.Ctx
	local Theme = ctx.Theme
	local UIUtil = ctx.UIUtil
	if self.Frame then
		self.Frame:Destroy()
	end
	table.clear(self.Keys)
	local interface = ctx.Interface
	local canvas: Vector2 = interface.CanvasSize or Vector2.new(1280, 720)
	local scale = math.max(0.05, interface.Scale or 1)
	local touch = interface.Device ~= "Desktop"
	local unitsW, rows = KeyboardArt.LayoutUnits("Full")
	-- Pas d'une touche (touche + écart) : ≈ 40 px réels sur PC, 46 en tactile
	local header = touch and 50 or 42
	local pad = 10
	local step = (touch and 52 or 44) / scale
	-- ... sans dépasser l'écran (largeur ; hauteur : 82 % sur téléphone, 66 % sinon)
	local phone = interface.Device == "Phone"
	local maxHeight = canvas.Y * (phone and 0.82 or 0.66)
	step = math.min(step, (canvas.X - 24 - pad * 2) / (unitsW + 1.3), (maxHeight - header - pad * 2) / (rows + 2))
	step = math.max(step, 18)

	local frame = Instance.new("Frame")
	frame.Name = "GearKeyboardPanel_" .. self.Options.Id
	frame.AnchorPoint = Vector2.new(0.5, 1)
	frame.Position = UDim2.new(0.5, 0, 1, -8)
	frame.BackgroundColor3 = self.Options.Tray or Color3.fromRGB(34, 28, 52)
	frame.BackgroundTransparency = 0.06
	frame.BorderSizePixel = 0
	frame.ZIndex = PANEL_Z
	frame.Visible = false
	frame.Active = true
	UIUtil.Corner(frame, 18)
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(255, 255, 255)
	stroke.Transparency = 0.55
	stroke.Thickness = 2
	stroke.Parent = frame
	local uiScale = Instance.new("UIScale")
	uiScale.Parent = frame
	self.Scale = uiScale

	-- Un appui entre deux touches ne traverse pas le panneau
	local sink = UIUtil.SinkClicks(frame)
	sink.InputBegan:Connect(function(input: InputObject)
		if isPress(input) then
			self:MarkInside()
		end
	end)

	-- Dessin du clavier (même style que le clavier posé)
	local art = Instance.new("Frame")
	art.Name = "Art"
	art.BackgroundTransparency = 1
	art.ZIndex = 2
	local keys, artW, artH = self.Options.Build(art, step)
	art.Size = UDim2.fromOffset(artW, artH)
	art.Position = UDim2.fromOffset(pad, pad + header)
	art.Parent = frame
	self.Art = art
	self.Keys = keys
	for _, key in ipairs(keys) do
		key.Button.InputBegan:Connect(function(input: InputObject)
			if isPress(input) then
				self:MarkInside()
				self.Options.OnKey(key)
			end
		end)
	end
	local width, height = artW + pad * 2, artH + pad * 2 + header
	frame.Size = UDim2.fromOffset(width, height)

	-- Titre (niveau compris)
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(pad + 6, pad + 2)
	title.Size = UDim2.fromOffset(phone and (width - header - pad * 3) or width * 0.56, header - 10)
	title.Font = Theme.Fonts.Title
	title.TextScaled = true -- (rétrécit un peu plutôt que d'être coupé)
	local titleSize = Instance.new("UITextSizeConstraint")
	titleSize.MaxTextSize = touch and 24 or 21
	titleSize.MinTextSize = 11
	titleSize.Parent = title
	title.TextColor3 = Color3.fromRGB(255, 255, 255)
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Text = self.Options.Title()
	title.ZIndex = 3
	title.Parent = frame
	self.Title = title

	-- Astuce (à droite du titre, avant le ✕)
	local closeSize = header - 6
	local hint = Instance.new("TextLabel")
	hint.Name = "Hint"
	hint.BackgroundTransparency = 1
	hint.AnchorPoint = Vector2.new(1, 0)
	hint.Position = UDim2.new(1, -(pad + closeSize + 12), 0, pad + 4)
	hint.Size = UDim2.fromOffset(width * 0.44 - closeSize - 34, header - 14)
	hint.Font = Theme.Fonts.Body
	hint.TextScaled = true
	local hintSize = Instance.new("UITextSizeConstraint")
	hintSize.MaxTextSize = touch and 19 or 17
	hintSize.MinTextSize = 9
	hintSize.Parent = hint
	hint.TextColor3 = Color3.fromRGB(214, 206, 255)
	hint.TextXAlignment = Enum.TextXAlignment.Right
	hint.Text = touch and Locale.T("Tap the keys!") or Locale.T("Type on your keyboard too!")
	hint.Visible = not phone -- (téléphone : place au titre)
	hint.ZIndex = 3
	hint.Parent = frame
	self.Hint = hint

	-- Gros bouton ✕ (le même que toutes les fenêtres)
	local close = UIUtil.CloseButton({
		Name = "KeyboardClose",
		Size = closeSize,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -pad, 0, pad - 2),
		ZIndex = 4,
		Parent = frame,
		OnClose = function()
			self:Close()
		end,
	})
	close.InputBegan:Connect(function(input: InputObject)
		if isPress(input) then
			self:MarkInside()
		end
	end)

	frame.Parent = ctx.Overlay or ctx.Container
	self.Frame = frame
	self.Dirty = false
end

function KeyboardPanel.IsOpen(self: any): boolean
	return self.Opened == true
end

function KeyboardPanel.MarkDirty(self: any)
	self.Dirty = true
	if self.Opened then
		-- Niveau changé pendant qu'il est ouvert : on redessine sur place
		self:_build()
		local frame = self.Frame
		if frame then
			frame.Visible = true
		end
	end
end

function KeyboardPanel.Open(self: any)
	if not self.Alive or self.Opened then
		return
	end
	if openPanel and openPanel ~= self then
		openPanel:Close()
	end
	if self.Dirty or not self.Frame or not self.Frame.Parent then
		self:_build()
	end
	local frame = self.Frame :: Frame
	local title = self.Title
	if title then
		title.Text = self.Options.Title()
	end
	self.Opened = true
	self.OpenedAt = os.clock()
	openPanel = self
	self.Token += 1
	frame.Visible = true
	local uiScale = self.Scale
	if uiScale then
		uiScale.Scale = 0.86
		self.Ctx.UIUtil.Tween(uiScale, 0.28, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	frame.Position = UDim2.new(0.5, 0, 1, 30)
	self.Ctx.UIUtil.Tween(frame, 0.25, { Position = UDim2.new(0.5, 0, 1, -8) }, Enum.EasingStyle.Quad)
end

function KeyboardPanel.Close(self: any)
	if not self.Opened then
		return
	end
	self.Opened = false
	if openPanel == self then
		openPanel = nil
	end
	self.Token += 1
	local token = self.Token
	local frame = self.Frame
	if frame and frame.Parent then
		self.Ctx.UIUtil.Tween(frame, 0.18, { Position = UDim2.new(0.5, 0, 1, 40) }, Enum.EasingStyle.Quad)
		task.delay(0.18, function()
			if self.Token == token and not self.Opened and frame.Parent then
				frame.Visible = false
			end
		end)
	end
end

function KeyboardPanel.FindKey(self: any, code: string): KeyboardArt.Key?
	return KeyboardArt.Find(self.Keys, code)
end

-- Point de départ du "+X" d'une touche : au-dessus du panneau, à l'aplomb de
-- la touche (les chiffres ne cachent pas les touches), en pixels "design"
function KeyboardPanel.KeyPoint(self: any, key: KeyboardArt.Key): Vector2?
	local ctx = self.Ctx
	local root = ctx.Interface.Root
	local frame = self.Frame
	local scale = math.max(0.01, ctx.Interface.Scale or 1)
	local button = key.Button
	if not root or not frame or not button.Parent then
		return nil
	end
	local origin = root.AbsolutePosition
	local x = (button.AbsolutePosition.X + button.AbsoluteSize.X / 2 - origin.X) / scale
	local y = (frame.AbsolutePosition.Y - origin.Y) / scale
	return Vector2.new(x, y - 6)
end

function KeyboardPanel.Destroy(self: any)
	self.Alive = false
	self:Close()
	if self.Frame then
		self.Frame:Destroy()
		self.Frame = nil
	end
end

return KeyboardPanel
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="126">
          <Properties>
            <string name="Name">GoldenStar</string>
            <string name="Source"><![CDATA[--[[
	GoldenStar (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > GoldenStar

	Étoiles dorées qui apparaissent au hasard (décidé par le SERVEUR via
	l'événement Spawn "Golden") : halo qui pulse, rayons qui tournent,
	petites étincelles en orbite... et elles s'en vont vite !
	Un clic = ClaimSpawn (le serveur vérifie puis envoie le bonus), et le
	bonus confirmé s'affiche en gros "+X" doré à l'endroit de l'étoile.
]]

local Debris = game:GetService("Debris")

local GoldenStar = {}
GoldenStar.Slot = "Overlay"

local Locale = require(game:GetService("ReplicatedStorage").Shared.Locale)

local MAX_STARS = 5
local RAY_COUNT = 6
local WARNING_TIME = 1.5 -- dernières secondes : l'étoile s'impatiente

local TAGS = {
	en = { "quick!!", "catch me", "click here ✨", "I'm shiny!", "it's me 🌟", "over here!" },
	fr = { "vite !!", "attrape-moi", "clique ici ✨", "je brille !", "c'est moi 🌟", "par ici !" },
}
local HURRY_TAGS = {
	en = { "too late?", "I'm leaving!", "bye bye...", "hurry up!" },
	fr = { "trop tard ?", "je pars !", "bye bye...", "dépêche !" },
}
local CHEERS = {
	en = { "SO LUCKY!", "STAR CAUGHT!", "GOLDEN!!!", "BRILLIANT!", "CAT-LIKE REFLEXES!" },
	fr = { "QUELLE CHANCE !", "ÉTOILE ATTRAPÉE !", "DORÉ !!!", "BRILLANT !", "RÉFLEXES DE CHAT !" },
}

-- Tire une phrase au hasard dans la liste de la langue du joueur
local function pickLine(variants, random: Random): string
	local list = Locale.Pick(variants)
	return list[random:NextInteger(1, #list)]
end

function GoldenStar.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local container: Frame = ctx.Container
	local random = Random.new()

	local stars = {} -- [id] = étoile active
	local count = 0
	local positions = {} -- [id] = UDim2 (pour placer le "+X" du bonus)
	local lastPosition = UDim2.fromScale(0.5, 0.45)

	local gold = Theme.Colors.Gold
	local orange = Theme.Colors.Orange

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	-- Fait disparaître tous les éléments visuels d'une étoile
	local function fadeAll(root: Instance, duration: number)
		for _, item in ipairs(root:GetDescendants()) do
			if item:IsA("TextLabel") then
				UIUtil.Tween(item, duration, { TextTransparency = 1, BackgroundTransparency = 1 })
			elseif item:IsA("Frame") then
				UIUtil.Tween(item, duration, { BackgroundTransparency = 1 })
			elseif item:IsA("UIStroke") then
				UIUtil.Tween(item, duration, { Transparency = 1 })
			end
		end
	end

	local function removeStar(star, popped: boolean)
		if star.Done then
			return
		end
		star.Done = true
		stars[star.Id] = nil
		count -= 1
		local scale = star.Scale
		if popped then
			UIUtil.Tween(scale, 0.3, { Scale = 1.8 }, Enum.EasingStyle.Quad)
			fadeAll(star.Button, 0.3)
		else
			UIUtil.Tween(scale, 0.35, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		end
		Debris:AddItem(star.Button, 0.4)
	end

	local function spawnStar(info)
		if not ctx.IsAlive() or type(info) ~= "table" or info.Id == nil then
			return
		end
		if stars[info.Id] or count >= MAX_STARS then
			return
		end
		local x = math.clamp(tonumber(info.X) or 0.5, 0.05, 0.95)
		local y = math.clamp(tonumber(info.Y) or 0.5, 0.08, 0.92)
		local lifetime = math.max(1, tonumber(info.Lifetime) or 6)
		local basePosition = UDim2.fromScale(x, y)

		-- Bouton principal (zone cliquable généreuse pour le tactile)
		local button = UIUtil.Create("TextButton", {
			Name = "GoldenStar",
			Size = UDim2.fromOffset(100, 100),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = basePosition,
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			ZIndex = 20,
			Parent = container,
		})
		local scale = UIUtil.Create("UIScale", { Scale = 0, Parent = button })

		-- Halo (cercles concentriques de plus en plus transparents)
		local halo = UIUtil.Create("Frame", {
			Name = "Halo",
			Size = UDim2.fromOffset(180, 180),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			BackgroundTransparency = 1,
			ZIndex = 20,
			Parent = button,
		})
		local haloScale = UIUtil.Create("UIScale", { Parent = halo })
		for i, spec in ipairs({ { 1, 0.88 }, { 0.75, 0.78 }, { 0.55, 0.62 } }) do
			local ring = UIUtil.Create("Frame", {
				Size = UDim2.fromScale(spec[1], spec[1]),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				BackgroundColor3 = i == 3 and Theme.Colors.Yellow or gold,
				BackgroundTransparency = spec[2],
				ZIndex = 20,
				Parent = halo,
			})
			UIUtil.Corner(ring, UDim.new(1, 0))
		end

		-- Rayons qui tournent
		local rays = {}
		for i = 1, RAY_COUNT do
			local ray = UIUtil.Create("Frame", {
				Size = UDim2.fromOffset(200, 8),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				BackgroundColor3 = Theme.Colors.Yellow,
				BackgroundTransparency = 0.2,
				Rotation = (i - 1) * (180 / RAY_COUNT),
				ZIndex = 21,
				Parent = button,
			})
			UIUtil.Corner(ray, UDim.new(1, 0))
			UIUtil.Create("UIGradient", {
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1),
					NumberSequenceKeypoint.new(0.35, 0.55),
					NumberSequenceKeypoint.new(0.5, 0.3),
					NumberSequenceKeypoint.new(0.65, 0.55),
					NumberSequenceKeypoint.new(1, 1),
				}),
				Parent = ray,
			})
			rays[i] = ray
		end

		-- Médaillon doré
		local disc = UIUtil.Create("Frame", {
			Name = "Disc",
			Size = UDim2.fromOffset(78, 78),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			BackgroundColor3 = Color3.new(1, 1, 1),
			ZIndex = 22,
			Parent = button,
		})
		UIUtil.Corner(disc, UDim.new(1, 0))
		local discStroke = UIUtil.Stroke(disc, Color3.new(1, 1, 1), 3, 0)
		local discGradient = UIUtil.Gradient(disc, ColorSequence.new({
			ColorSequenceKeypoint.new(0, Theme.Colors.Yellow),
			ColorSequenceKeypoint.new(0.5, gold),
			ColorSequenceKeypoint.new(1, orange),
		}), 45)
		UIUtil.Label({
			Text = "🌟",
			Size = UDim2.fromScale(0.78, 0.78),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			MaxTextSize = 56,
			ZIndex = 23,
			Parent = disc,
		})

		-- Étincelles en orbite
		local sparkles = {}
		for i = 1, 2 do
			sparkles[i] = UIUtil.Label({
				Text = "✨",
				Size = UDim2.fromOffset(26, 26),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				MaxTextSize = 24,
				ZIndex = 24,
				Parent = button,
			})
		end

		-- Petite étiquette "vite !!"
		local tag = UIUtil.Label({
			Text = pickLine(TAGS, random),
			Font = Theme.Fonts.Title,
			TextColor3 = Theme.Colors.TextDark,
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0,
			Size = UDim2.fromOffset(104, 24),
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 1, 4),
			MaxTextSize = 17,
			ZIndex = 25,
			Parent = button,
		})
		UIUtil.Corner(tag, UDim.new(1, 0))
		UIUtil.Stroke(tag, Theme.Colors.Border, 1.5, 0.1)

		local star = {
			Id = info.Id,
			Button = button,
			Scale = scale,
			HaloScale = haloScale,
			Rays = rays,
			Disc = disc,
			DiscStroke = discStroke,
			DiscGradient = discGradient,
			Sparkles = sparkles,
			Tag = tag,
			Base = basePosition,
			Born = os.clock(),
			Lifetime = lifetime,
			Phase = random:NextNumber(0, math.pi * 2),
			Hurry = false,
			Done = false,
		}
		stars[info.Id] = star
		count += 1

		-- Apparition
		UIUtil.Tween(scale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
		ctx.Sound.Play("Golden", 1.4)

		-- Clic : on réclame l'étoile au serveur
		ctx.Connect(button.Activated, function()
			if star.Done or not ctx.IsAlive() then
				return
			end
			local position = button.Position
			positions[star.Id] = position
			lastPosition = position
			ctx.ClaimSpawn(star.Id)
			ctx.Sound.Play("Golden", 1.8)
			if effectsOn() then
				ctx.Effects.Burst(container, position, gold, 24)
				ctx.Effects.Burst(container, position, nil, 12)
				ctx.Effects.Flash(Theme.Colors.Yellow, 0.2)
			end
			removeStar(star, true)
			-- On oublie la position après un moment
			task.delay(6, function()
				positions[star.Id] = nil
			end)
		end)
	end

	-- Animation de toutes les étoiles (une seule connexion)
	ctx.OnRender(function()
		local now = os.clock()
		for _, star in pairs(stars) do
			local age = now - star.Born
			local left = star.Lifetime - age
			if left <= 0 then
				removeStar(star, false)
			else
				local t = now + star.Phase
				-- Flotte doucement
				star.Button.Position = star.Base + UDim2.fromOffset(math.sin(t * 1.3) * 10, math.cos(t * 1.7) * 8)
				-- Halo qui respire
				star.HaloScale.Scale = 1 + math.sin(t * 5) * 0.1
				-- Rayons qui tournent
				local spin = t * 45
				for i, ray in ipairs(star.Rays) do
					ray.Rotation = spin + (i - 1) * (180 / RAY_COUNT)
				end
				star.DiscGradient.Rotation = (t * 120) % 360
				-- Étincelles en orbite
				for i, sparkle in ipairs(star.Sparkles) do
					local angle = t * 3 + i * math.pi
					sparkle.Position = UDim2.new(0.5, math.cos(angle) * 56, 0.5, math.sin(angle) * 48)
				end
				-- Pulsation (après l'apparition)
				if age > 0.45 then
					if left < WARNING_TIME then
						-- Pressée de partir : tremble et clignote
						if not star.Hurry then
							star.Hurry = true
							star.Tag.Text = pickLine(HURRY_TAGS, random)
							star.Tag.BackgroundColor3 = Theme.Colors.Red
							star.Tag.TextColor3 = Theme.Colors.TextLight
						end
						star.Scale.Scale = 1 + math.sin(t * 22) * 0.07
						star.Disc.Rotation = math.sin(t * 30) * 12
						star.DiscStroke.Color = (math.floor(now * 8) % 2 == 0) and Theme.Colors.Red or Color3.new(1, 1, 1)
					else
						star.Scale.Scale = 1 + math.sin(t * 9) * 0.06
						star.Disc.Rotation = math.sin(t * 3) * 12
					end
				end
			end
		end
	end)

	ctx.OnSpawn("Golden", spawnStar)

	-- Bonus confirmé : gros "+X" doré
	ctx.OnBonus("Golden", function(payload)
		if not ctx.IsAlive() then
			return
		end
		local position = (payload.SpawnId and positions[payload.SpawnId]) or lastPosition
		ctx.FloatText(container, position, "+" .. ctx.Format.Format(tonumber(payload.Amount) or 0), gold, 60)
		ctx.FloatText(container, position + UDim2.fromOffset(0, 50), pickLine(CHEERS, random), orange, 26)
	end)
end

function GoldenStar.Stop(_ctx)
	-- Les étoiles vivent dans ctx.Container (détruit par le StimulusManager)
end

return GoldenStar
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="127">
          <Properties>
            <string name="Name">InfiniteScroll</string>
            <string name="Source"><![CDATA[--[[
	InfiniteScroll (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > InfiniteScroll

	♾️ Défilement infini (+/s, 10 niveaux, après 8 visites à l'océan) : des
	téléphones translucides sur les côtés dont le fil (publications en
	couleurs, légendes, avatars) défile sans jamais s'arrêter, avec parfois un
	« coup de pouce » qui fait défiler très vite.
	Chaque niveau ajoute quelque chose :
	  1 : 2 téléphones                6 : contour lumineux
	  2 : cœurs qui s'envolent         7 : 4e téléphone
	  3 : pastille de notification     8 : 2e cœur par téléphone
	  4 : 3e téléphone                 9 : contour arc-en-ciel
	  5 : défilement « frénétique »   10 : 5e téléphone
	Le fil est UN seul cadre dont le dégradé dessine les publications
	(motif répété, défilement sans couture) : ~12 instances par téléphone.
	Chaque téléphone est posé par Cosmos/Zones (à gauche / à droite).
]]

local Cosmos = script.Parent:WaitForChild("Cosmos")
local Kit = require(Cosmos:WaitForChild("Kit"))
local Zones = require(Cosmos:WaitForChild("Zones"))

local InfiniteScroll = {}
InfiniteScroll.Slot = "Background"

local ID = "InfiniteScroll"
local MAX_LEVEL = 10
local PHONE_W, PHONE_H = 50, 96
local SCREEN_W, SCREEN_H = 40, 78
local PERIOD = 88 -- hauteur d'un motif du fil (2 publications)

-- Applis (couleurs des publications)
local APPS = {
	{ Color3.fromRGB(255, 120, 180), Color3.fromRGB(170, 110, 255) },
	{ Color3.fromRGB(255, 90, 90), Color3.fromRGB(60, 60, 70) },
	{ Color3.fromRGB(80, 170, 255), Color3.fromRGB(120, 230, 210) },
	{ Color3.fromRGB(255, 180, 60), Color3.fromRGB(255, 110, 150) },
	{ Color3.fromRGB(110, 220, 120), Color3.fromRGB(90, 140, 255) },
}

-- Côtés et hauteurs préférés des téléphones (fractions de la toile)
local ANCHORS = {
	Vector2.new(0.2, 0.34),
	Vector2.new(0.8, 0.34),
	Vector2.new(0.2, 0.66),
	Vector2.new(0.8, 0.66),
	Vector2.new(0.2, 0.9),
}

local function phoneCount(level: number): number
	return math.min(5, 2 + math.floor((level - 1) / 3))
end

-- Dégradé du fil : 2 publications (image + légende) par motif, répété 2 fois
local function feedSequence(app: { Color3 }, caption: Color3): ColorSequence
	local points = {}
	local blocks = {
		{ app[1], 0.28 },
		{ caption, 0.22 },
		{ app[2], 0.28 },
		{ caption, 0.22 },
	}
	local t = 0
	for _ = 1, 2 do
		for _, block in ipairs(blocks) do
			local span = block[2] / 2
			table.insert(points, t)
			table.insert(points, block[1])
			t += span
			table.insert(points, math.min(1, t - 0.002))
			table.insert(points, block[1])
		end
	end
	points[#points - 1] = 1
	return Kit.Colors(points)
end

function InfiniteScroll.Start(ctx)
	Zones.Attach(ctx)
	local random = Random.new()
	local effects = Kit.Effects(ctx)
	local level = math.clamp(ctx.GetLevel(ID), 1, MAX_LEVEL)
	local dark = Kit.IsDark(ctx)

	type Heart = { Frame: Frame, Offset: number }
	type Phone = {
		Piece: any,
		Content: Frame?,
		Feed: Frame?,
		Scroll: number,
		Speed: number,
		Boost: number,
		Hearts: { Heart },
		Stroke: UIStroke?,
		Badge: Frame?,
	}
	local phones: { Phone } = {}

	local function buildPhone(phone: Phone, index: number)
		if phone.Content then
			phone.Content:Destroy()
		end
		table.clear(phone.Hearts)
		phone.Badge = nil
		local root = Kit.Box(phone.Piece.Frame, { Name = "Content", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 })
		phone.Content = root
		local app = APPS[(index - 1) % #APPS + 1]

		-- Coque translucide
		local body = Kit.Box(root, {
			Name = "Body",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(PHONE_W / 2, PHONE_H / 2),
			Size = UDim2.fromOffset(PHONE_W - 4, PHONE_H - 4),
			Color = if dark then Kit.Rgb(24, 22, 40) else Kit.Rgb(60, 56, 80),
			Alpha = if dark then 0.35 else 0.55,
			ZIndex = 1,
		})
		Kit.Corner(body, 10)
		local strokeColor = if level >= 6 then app[1] elseif dark then Kit.Rgb(220, 210, 255) else Kit.Rgb(80, 70, 120)
		phone.Stroke = Kit.Stroke(body, strokeColor, if level >= 6 then 2 else 1.5, if dark then 0.35 else 0.25)
		-- Écran (découpe le fil)
		local screen = Kit.Box(root, {
			Name = "Screen",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(PHONE_W / 2, PHONE_H / 2 + 1),
			Size = UDim2.fromOffset(SCREEN_W, SCREEN_H),
			Color = if dark then Kit.Rgb(30, 28, 52) else Color3.new(1, 1, 1),
			Alpha = if dark then 0.4 else 0.35,
			ClipsDescendants = true,
			ZIndex = 2,
		})
		local caption = if dark then Kit.Rgb(70, 66, 100) else Kit.Rgb(245, 244, 250)
		local feed = Kit.Box(screen, {
			Name = "Feed",
			Position = UDim2.fromOffset(3, 0),
			Size = UDim2.fromOffset(SCREEN_W - 6, PERIOD * 2),
			Color = Color3.new(1, 1, 1),
			Alpha = if dark then 0.15 else 0.1,
			ZIndex = 3,
		})
		Kit.Gradient(feed, feedSequence(app, caption), nil, 90)
		phone.Feed = feed
		-- Cœurs (niveau 2+ ; 2 au niveau 8+)
		if level >= 2 then
			for heartIndex = 1, if level >= 8 then 2 else 1 do
				local heart = Kit.Text(root, "♥", PHONE_W - 8, PHONE_H - 22, 12, Kit.Rgb(255, 80, 130), 6)
				heart.TextTransparency = 1
				table.insert(phone.Hearts, { Frame = heart :: any, Offset = (heartIndex - 1) * 0.5 + random:NextNumber(0, 0.2) })
			end
		end
		-- Pastille de notification (niveau 3+)
		if level >= 3 then
			local badge = Kit.Diamond(root, PHONE_W - 5, 5, 8, Kit.Rgb(255, 60, 70), 0, 6)
			badge.Name = "Badge"
			phone.Badge = badge
		end
	end

	local function sync()
		local wanted = phoneCount(level)
		-- Ajoute les téléphones manquants (jamais recréés : le fil continue)
		for index = #phones + 1, wanted do
			local piece = Kit.Piece(ctx.Container, "Phone" .. index, PHONE_W, PHONE_H)
			phones[index] = { Piece = piece, Content = nil, Feed = nil, Scroll = random:NextNumber(0, PERIOD), Speed = random:NextNumber(14, 22), Boost = 0, Hearts = {}, Stroke = nil, Badge = nil }
		end
		for index, phone in ipairs(phones) do
			buildPhone(phone, index)
		end
		local items = {}
		for index = 1, #phones do
			table.insert(items, { W = PHONE_W, H = PHONE_H, Anchor = ANCHORS[index], MinScale = 0.5, MaxScale = 1.1, Gap = 4 })
		end
		Zones.Request(ID, items, function(placements)
			for index, phone in ipairs(phones) do
				Kit.Place(phone.Piece, placements[index])
			end
		end)
	end

	sync()
	Kit.WatchLevel(ctx, ID, function(newLevel)
		level = math.clamp(newLevel, 1, MAX_LEVEL)
		sync()
		for _, phone in ipairs(phones) do
			Kit.Bump(phone.Piece)
		end
	end)
	Kit.WatchTheme(ctx, function(isDark)
		dark = isDark
		for index, phone in ipairs(phones) do
			buildPhone(phone, index)
		end
	end)

	Kit.Loop(ctx, 20, function(dt, t)
		for index, phone in ipairs(phones) do
			if phone.Piece.Placed then
				-- Défilement (avec parfois un coup de pouce très rapide)
				if phone.Boost > 0 then
					phone.Boost = math.max(0, phone.Boost - dt)
				elseif effects and random:NextNumber() < dt * (if level >= 5 then 0.35 else 0.12) then
					phone.Boost = 0.6
				end
				local speed = phone.Speed * (if level >= 5 then 1.5 else 1) + (if phone.Boost > 0 then 220 * phone.Boost else 0)
				phone.Scroll = (phone.Scroll + speed * dt) % PERIOD
				local feed = phone.Feed
				if feed then
					feed.Position = UDim2.fromOffset(3, -phone.Scroll)
				end
				-- Cœurs qui s'envolent
				for _, heart in ipairs(phone.Hearts) do
					local p = (t / 2.4 + heart.Offset + index * 0.17) % 1
					local label = heart.Frame :: any
					label.Position = UDim2.fromOffset(PHONE_W - 10 + math.sin(p * 8) * 3, PHONE_H - 20 - p * 40)
					label.TextTransparency = if p < 0.15 then 1 - p / 0.15 elseif p > 0.6 then (p - 0.6) / 0.4 else 0
				end
				local badge = phone.Badge
				if badge then
					local pulse = 9 + math.max(0, math.sin(t * 3 + index)) * 3
					badge.Size = UDim2.fromOffset(pulse, pulse)
				end
				if level >= 9 then
					local stroke = phone.Stroke
					if stroke then
						stroke.Color = Color3.fromHSV((t * 0.15 + index * 0.2) % 1, 0.6, 1)
					end
				end
			end
		end
	end)
end

function InfiniteScroll.Stop(_ctx)
	Zones.Release(ID)
end

return InfiniteScroll
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="128">
          <Properties>
            <string name="Name">Keyboard</string>
            <string name="Source"><![CDATA[--[[
	Keyboard (ModuleScript - stimulus) — amélioration "Clavier mécanique" (12 niveaux)
	Emplacement : ReplicatedStorage > Client > Stimuli > Keyboard

	v9.1 : un VRAI clavier QWERTY cliquable, posé sur son tapis dans l'espace
	libre près de la colonne centrale (Gear/GearLayout, calque Background :
	il ne recouvre jamais l'interface).
	  - chaque touche (Q W E R T Y..., espace, entrée...) est un bouton :
	    l'appuyer l'enfonce, joue un son de touche (Config.ClickSounds
	    Keyboard1..5 selon le niveau, voir GearClick) et compte comme un VRAI
	    clic (même chemin que le gros bouton : gain, combo, quêtes, "+X") ;
	  - le vrai clavier du joueur appuie aussi sur les touches (Gear/KeyInput) ;
	  - quand la place manque, le clavier devient un petit clavier "résumé"
	    (Q W E R T Y / A S D F G H / Z X C V B N) ; si ses touches sont trop
	    petites pour être visées (≥ 22 px sur PC, 34 px en tactile), un appui
	    dessus ouvre le GRAND clavier flottant (Gear/KeyboardPanel) avec un
	    badge 🔍 pour le signaler.
	Chaque niveau ajoute quelque chose :
	  1 clavier blanc sur tapis lilas     2 touches colorées (retour, entrée, espace)
	  3 repose-poignets rose               4 tapis étoilé + 2 touches par clic
	  5 touches pastel                     6 tapis sombre + lueur cyan dessous
	  7 lueur RGB (tourne à chaque clic)   8 touches RGB + 3 touches par clic
	  9 gros "CLAC !" étincelants          10 touche artisanale dorée (étoile)
	  11 câble spiralé pastel              12 clavier doré + vague RGB + 4 touches
	Les sons de touches changent aussi avec le niveau (Keyboard1 -> Keyboard5).
	Au repos : de temps en temps, quelques touches "tapent" toutes seules.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Locale = require(ReplicatedStorage.Shared.Locale)
local Gear = script.Parent:WaitForChild("Gear")
local GearKit = require(Gear:WaitForChild("GearKit"))
local GearPiece = require(Gear:WaitForChild("GearPiece"))
local KeyboardArt = require(Gear:WaitForChild("KeyboardArt"))
local GearClick = require(Gear:WaitForChild("GearClick"))
local ClickableKeys = require(Gear:WaitForChild("ClickableKeys"))

local Keyboard = {}
Keyboard.Slot = "Background" -- sous l'interface (effets de clic : calque Overlay)

local STEP_FULL = 24 -- pas d'une touche (touche + écart) du clavier posé, échelle 1
local STEP_MINI = 21
local GEO_FULL = KeyboardArt.Geometry("Full", STEP_FULL)
local GEO_MINI = KeyboardArt.Geometry("Mini", STEP_MINI)
local FULL = Vector2.new(GEO_FULL.W, GEO_FULL.H)
local MINI = Vector2.new(GEO_MINI.W, GEO_MINI.H)

local INK = Color3.fromRGB(52, 44, 72)
local POP_COLORS = {
	Color3.fromRGB(255, 110, 170),
	Color3.fromRGB(80, 200, 255),
	Color3.fromRGB(255, 196, 40),
	Color3.fromRGB(130, 230, 120),
}
local PASTEL = {
	Color3.fromRGB(255, 206, 228),
	Color3.fromRGB(196, 246, 222),
	Color3.fromRGB(220, 210, 255),
	Color3.fromRGB(255, 240, 204),
	Color3.fromRGB(206, 232, 255),
}

local active: { [any]: any } = {}

-- Nombre de touches enfoncées par clic sur le gros bouton
local function keysPerClick(level: number): number
	if level >= 12 then
		return 4
	elseif level >= 8 then
		return 3
	elseif level >= 4 then
		return 2
	end
	return 1
end

-- Couleur de base d'une touche selon le niveau
local function keyColorFn(level: number, hueOffset: number): (key: KeyboardArt.Key) -> Color3
	return function(key: KeyboardArt.Key): Color3
		if level >= 8 then
			return GearKit.Rainbow(key.Fx * 0.92 + key.Fy * 0.12 + hueOffset, 0.42, 1)
		end
		if level >= 2 then
			if key.Kind == "Back" then
				return Color3.fromRGB(255, 110, 124)
			elseif key.Kind == "Enter" then
				return Color3.fromRGB(255, 212, 70)
			elseif key.Kind == "Space" then
				return Color3.fromRGB(130, 200, 255)
			end
		end
		if level >= 5 then
			return PASTEL[(key.Row - 1) % #PASTEL + 1]
		end
		if key.Kind ~= "Key" then
			return Color3.fromRGB(226, 228, 238)
		end
		return Color3.fromRGB(250, 250, 253)
	end
end

-- Dessine le clavier (tapis, câble, lueur, boîtier, touches...) pour un pas
-- de touche `step`. Renvoie (touches, largeur, hauteur, dégradé de la lueur).
local function drawKeyboard(root: Instance, layout: string, step: number, level: number, hueOffset: number): ({ KeyboardArt.Key }, number, number, UIGradient?)
	local geo = KeyboardArt.Geometry(layout, step)
	local W, H = geo.W, geo.H
	local s = step / STEP_FULL -- facteur des détails (1 = clavier posé)
	local dark = level >= 6

	-- Tapis de bureau (+ couture)
	local matColor = dark and Color3.fromRGB(40, 34, 62) or Color3.fromRGB(206, 196, 255)
	GearKit.Outlined(root, 0, 0, W, H, matColor, { Name = "Mat", Radius = 13 * s, Outline = 2 * s, OutlineColor = INK, Z = 2, LineZ = 1 })
	local stitch = GearKit.Box(root, 4 * s, 4 * s, W - 8 * s, H - 8 * s, matColor, { Name = "Stitch", Radius = 10 * s, Transparency = 1, Z = 3 })
	local stitchStroke = Instance.new("UIStroke")
	stitchStroke.Color = dark and Color3.fromRGB(120, 110, 170) or Color3.new(1, 1, 1)
	stitchStroke.Transparency = 0.35
	stitchStroke.Thickness = math.max(1, s)
	stitchStroke.Parent = stitch
	if level >= 4 then
		local inset = 9 * s
		local spots = { { inset, inset }, { W - inset, inset }, { inset, H - inset }, { W - inset, H - inset } }
		for index, spot in ipairs(spots) do
			GearKit.Star(root, spot[1], spot[2], 9 * s, POP_COLORS[(index - 1) % #POP_COLORS + 1], 4)
		end
	end

	-- Lueur sous le clavier
	local glowGradient: UIGradient? = nil
	if level >= 6 then
		local glowColor = level >= 7 and Color3.new(1, 1, 1) or Color3.fromRGB(80, 230, 255)
		local glow = GearKit.Box(root, geo.CaseX - 6 * s, geo.CaseY - 6 * s, geo.CaseW + 12 * s, geo.CaseH + 12 * s, glowColor, {
			Name = "Underglow",
			Radius = 16 * s,
			Transparency = 0.12,
			Z = 4,
			Gradient = level >= 7 and GearKit.RainbowSequence(0, 0.85) or nil,
			GradientRotation = 0,
		})
		glowGradient = glow:FindFirstChildOfClass("UIGradient")
	end

	-- Câble (spiralé au niveau 11), en haut du boîtier
	local cableX = geo.CaseX + geo.CaseW * 0.74
	if level >= 11 then
		for index = 0, 4 do
			GearKit.Outlined(root, cableX - 14 * s + index * 7 * s, 2 * s, 6 * s, 8 * s, index % 2 == 0 and Color3.fromRGB(255, 190, 220) or Color3.fromRGB(170, 215, 255), {
				Name = "Coil",
				Radius = "round",
				Outline = 1.2 * s,
				OutlineColor = INK,
				Z = 6,
				LineZ = 5,
			})
		end
	else
		GearKit.Outlined(root, cableX, 1, 4 * s, geo.CaseY + 2, Color3.fromRGB(90, 92, 110), { Name = "Cable", Radius = 2 * s, Outline = 1.2 * s, OutlineColor = INK, Z = 6, LineZ = 5 })
	end

	-- Repose-poignets
	if level >= 3 then
		GearKit.Outlined(root, geo.CaseX + geo.CaseW * 0.08, geo.RestY, geo.CaseW * 0.84, geo.RestH, Color3.fromRGB(255, 196, 216), {
			Name = "WristRest",
			Radius = "round",
			Outline = 1.8 * s,
			OutlineColor = INK,
			Z = 6,
			LineZ = 5,
			Gradient = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(235, 215, 225)),
		})
	end

	-- Boîtier + plaque
	local gold = level >= 12
	local caseColor = gold and Color3.fromRGB(255, 204, 70) or Color3.fromRGB(250, 250, 253)
	GearKit.Outlined(root, geo.CaseX, geo.CaseY, geo.CaseW, geo.CaseH, caseColor, {
		Name = "Case",
		Radius = 9 * s,
		Outline = 2.2 * s,
		OutlineColor = INK,
		Z = 8,
		LineZ = 7,
		Gradient = gold and ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(230, 160, 50))
			or ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(214, 216, 228)),
	})
	GearKit.Box(root, geo.CaseX + 5 * s, geo.CaseY + 2 * s, geo.CaseW - 10 * s, 2.5 * s, Color3.new(1, 1, 1), { Name = "CaseShine", Radius = "round", Transparency = 0.35, Z = 9 })
	local plateColor = dark and Color3.fromRGB(58, 52, 86) or Color3.fromRGB(150, 156, 178)
	GearKit.Box(root, geo.KeysX - 3 * s, geo.KeysY - 3 * s, geo.KeysW + 6 * s, geo.KeysH + 6 * s, plateColor, { Name = "Plate", Radius = 6 * s, Z = 9 })

	-- Touches QWERTY
	local keys = KeyboardArt.Build(root, layout, geo.KeysX, geo.KeysY, geo.KeysW, geo.KeysH, {
		Color = keyColorFn(level, hueOffset),
		Z = 10,
	})

	-- Touche artisanale (étoile dorée) : "fn" (ou "enter" sur le petit clavier)
	if level >= 10 then
		local artisan = KeyboardArt.Find(keys, "Fn") or KeyboardArt.Find(keys, "Return")
		if artisan then
			KeyboardArt.Artisan(artisan, 14)
		end
	end
	return keys, W, H, glowGradient
end

function Keyboard.Start(ctx)
	local Theme = ctx.Theme
	local animator = GearKit.Animator(ctx)
	local piece = GearPiece.new(ctx, {
		Id = "Keyboard",
		Size = FULL,
		Shapes = { MINI },
		Priority = 1.2, -- v9.1 : cliquable -> placé tôt (juste après le doigt)
		MinScale = 0.3,
		MaxScale = 1,
		SizePenalty = 520, -- préfère une grande place (touches cliquables)
		GlowColor = Color3.fromRGB(200, 190, 255),
		ContainerZ = 1104,
		Anchor = function(button, _canvas)
			-- En bas à gauche du bouton, à côté du compteur
			return Vector2.new(button.X0 - 170, button.Y1 + 95)
		end,
	}, animator)
	local random = ctx.Random

	local glowGradient: UIGradient? = nil
	local panelGlow: UIGradient? = nil
	local hueOffset = 0

	local function level(): number
		return math.max(1, piece.Level)
	end

	local keys = ClickableKeys.new(ctx, piece, animator, {
		Id = "Keyboard",
		InputPriority = 1,
		StepFull = STEP_FULL,
		StepMini = STEP_MINI,
		Draw = function(root: Instance, layout: string, step: number, lv: number)
			return drawKeyboard(root, layout, step, lv, hueOffset)
		end,
		Title = function(): string
			return ClickableKeys.TitleFor("⌨️", "Mechanical Keyboard", level())
		end,
		Tray = Color3.fromRGB(34, 28, 52),
		BadgeInk = INK,
		Lit = function(lv: number): Color3?
			return lv >= 9 and Color3.new(1, 1, 1) or nil
		end,
		OnBuilt = function(_root, _list, extra)
			glowGradient = extra
		end,
		OnPanelBuilt = function(_list, extra)
			panelGlow = extra
		end,
	})
	keys:Build(level())
	piece.OnLevel = function(lv, _previous)
		keys:LevelChanged(lv)
	end

	-- "clac !" réutilisés (calque Overlay, pas mis à l'échelle)
	local pops = GearKit.Pool(3, function(index)
		local label = Instance.new("TextLabel")
		label.Name = "Clack"
		label.BackgroundTransparency = 1
		label.AnchorPoint = Vector2.new(0.5, 1)
		label.Size = UDim2.fromOffset(70, 20)
		label.Font = Theme.Fonts.Title
		label.Text = Locale.T("clack!")
		label.TextSize = 14
		label.TextColor3 = POP_COLORS[(index - 1) % #POP_COLORS + 1]
		label.ZIndex = 25
		label.Visible = false
		local stroke = Instance.new("UIStroke")
		stroke.Color = Color3.fromRGB(40, 30, 60)
		stroke.Thickness = 1.5
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		stroke.Parent = label
		local scale = Instance.new("UIScale")
		scale.Parent = label
		label.Parent = piece.FX
		return label
	end)

	-- Couleurs RGB qui avancent à chaque clic (clavier posé + grand clavier ouvert)
	local function shiftRGB(lv: number)
		if lv < 7 then
			return
		end
		hueOffset = (hueOffset + 0.06) % 1
		for _, gradient in ipairs({ glowGradient, panelGlow }) do
			if gradient then
				gradient.Offset = Vector2.new(((hueOffset * 2) % 1) - 0.5, 0)
			end
		end
		if lv >= 8 and lv < 12 then
			for _, list in ipairs({ keys.Keys, keys.Panel:IsOpen() and keys.PanelKeys or {} }) do
				for _, key in ipairs(list) do
					if not key.Artisan then
						KeyboardArt.SetColor(key, GearKit.Rainbow(key.Fx * 0.92 + key.Fy * 0.12 + hueOffset, 0.42, 1))
					end
				end
			end
		end
	end

	-- Vague RGB (niveau 12) : les touches s'illuminent de gauche à droite
	local function wave()
		local list = keys.Panel:IsOpen() and keys.PanelKeys or keys.Keys
		animator:Play("wave", 0.45, function(t)
			for _, key in ipairs(list) do
				if not key.Artisan then
					local glow = GearKit.Bump(math.clamp((t * 1.6 - key.Fx * 0.6) / 0.6, 0, 1))
					local base = GearKit.Rainbow(key.Fx * 0.92 + key.Fy * 0.12 + hueOffset, 0.42 + 0.4 * glow, 1)
					key.Color = base
					if not animator:IsPlaying(key) then
						key.Frame.BackgroundColor3 = base
					end
				end
			end
		end)
	end

	local function popClack(key: KeyboardArt.Key, lv: number)
		if not GearKit.EffectsOn(ctx) then
			return
		end
		local point = keys:KeyPoint(key)
		if not point then
			return
		end
		local label = pops:Next()
		local scale = label:FindFirstChildOfClass("UIScale")
		local big = lv >= 9
		label.Text = big and Locale.T("CLACK!") or Locale.T("clack!")
		label.TextSize = big and 16 or 12
		local drift = random:NextNumber(-14, 14)
		local rise = (big and 30 or 22) + random:NextNumber(0, 10)
		animator:Play(label, 0.45, function(t)
			label.Visible = t < 1
			local e = GearKit.Ease.OutCubic(t)
			label.Position = UDim2.fromOffset(point.X + drift * e, point.Y - 2 - rise * e)
			if scale then
				scale.Scale = 0.6 + 0.5 * GearKit.Ease.OutBack(math.min(1, t * 2.5)) - 0.1 * t
			end
			label.TextTransparency = math.max(0, (t - 0.55) / 0.45)
			label.Rotation = drift * 0.8 * (1 - t)
		end, function()
			label.Visible = false
		end)
	end

	-- Touches au hasard (clic sur le gros bouton, ou au repos)
	local function pressRandom(count: number, lv: number, withPops: boolean)
		if #keys.Keys == 0 then
			return
		end
		for index, key in ipairs(KeyboardArt.Pick(keys.Keys, count, random)) do
			keys:AnimateKey(key, (index - 1) * 0.035)
			if withPops and index == 1 then
				popClack(key, lv)
			end
		end
	end

	ctx.Connect(ctx.State.Clicked, function()
		if not ctx.IsVisible() then
			return
		end
		local lv = level()
		shiftRGB(lv)
		if lv >= 12 then
			wave()
		end
		local source = GearClick.Source
		if source == "Keyboard" or source == "CoralKeys" then
			return -- (la touche frappée s'anime déjà)
		end
		if piece:IsShown() then
			pressRandom(keysPerClick(lv), lv, true)
		end
	end)

	-- Au repos : quelques touches tapent toutes seules ; le badge 🔍 fait coucou
	GearKit.Every(ctx, 6, 11, function()
		if piece:IsShown() then
			pressRandom(3, level(), false)
			keys:Wiggle()
		end
	end)

	active[ctx] = { Piece = piece, Keys = keys }
end

function Keyboard.Stop(ctx)
	local entry = active[ctx]
	active[ctx] = nil
	if entry then
		entry.Keys:Destroy()
		entry.Piece:Destroy()
	end
end

return Keyboard
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="129">
          <Properties>
            <string name="Name">Live</string>
          </Properties>
          <Item class="ModuleScript" referent="130">
            <Properties>
              <string name="Name">ChatInput</string>
              <string name="Source"><![CDATA[--[[
	ChatInput (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Stimuli > Live > ChatInput

	Champ de saisie du chat du live (utilisé par Stimuli > LiveStream) :
	  - TextBox "ChatBox" (« Envoyer un message… »), bouton rond "SendChat"
	    (flèche dessinée en Frames : ne dépend d'aucune police) ; Entrée
	    (FocusLost(true)) ou le bouton = envoyer ; 120 caractères maximum
	    (compteur à partir de 90) ;
	  - tactile : toucher la liste des messages (bouton transparent "ChatTap")
	    ouvre le clavier (CaptureFocus) ;
	  - envoi : RemoteFunction "FilterText" ("Live", texte) appelée dans un
	    task.spawn (InvokeServer attend le serveur). Pendant l'envoi le champ
	    est grisé (« Envoi… ») et le bouton montre "•••". Succès : le champ est
	    vidé et options.OnMessage(texteFiltré, sujets) est appelé. Échec : le
	    message du serveur s'affiche discrètement au-dessus du champ et le
	    brouillon reste (le texte tapé n'est JAMAIS affiché ailleurs que dans
	    le champ lui-même) ;
	  - anti-spam : COOLDOWN s entre deux messages (le bouton affiche le
	    compte à rebours ; « ⏳ Mode lent : 2s » si on insiste) ;
	  - tant que le joueur n'a rien écrit, le contour du champ "respire"
	    (invitation discrète).
	Step(now) est appelé par la boucle de rendu de LiveStream (≤ 30 Hz) :
	aucune boucle ni connexion par image ici.
	v9.1 : posé sur la vidéo (Live > ChatPanel) : champ sombre translucide
	plus grand (26 px, texte 13 ; 36 px et texte 19 en mode compact),
	marge réglable (options.Inset).
]]

local Locale = require(game:GetService("ReplicatedStorage").Shared.Locale)

local ChatInput = {}

local MAX_CHARS = 120 -- = ChatService (purpose "Live")
local COUNTER_FROM = 90 -- le compteur apparaît à partir de 90 caractères
local COOLDOWN = 3 -- secondes entre deux messages (le serveur en impose 1,2)
local FAIL_COOLDOWN = 1.3
local TIMEOUT = 10 -- sans réponse du serveur : on rend la main
local STATUS_TIME = 3

local FIELD = Color3.fromRGB(16, 10, 30)
local STROKE_IDLE = Color3.fromRGB(230, 220, 255)
local STROKE_FOCUS = Color3.fromRGB(200, 156, 255)
local STROKE_INVITE = Color3.fromRGB(255, 150, 214)
local SEND_READY = Color3.fromRGB(255, 60, 120)
local SEND_WAIT = Color3.fromRGB(74, 66, 100)
local ERROR_COLOR = Color3.fromRGB(255, 130, 140)
local SLOW_COLOR = Color3.fromRGB(255, 208, 110)
local INFO_COLOR = Color3.fromRGB(205, 196, 240)
local ARROW_BOX = 18 -- taille "design" du dessin de la flèche

export type Options = {
	Parent: GuiObject, -- panneau du chat
	TapArea: GuiObject?, -- zone (liste des messages) qui ouvre le clavier au toucher
	ZIndex: number?,
	Inset: number?, -- marge avec les bords du panneau (5 par défaut)
	KnownTopics: { [string]: boolean }?, -- sujets acceptés (ChatTopics.Order)
	OnMessage: (text: string, topics: { string }) -> (),
	OnFocus: ((focused: boolean) -> ())?,
}

local function trim(text: string): string
	return (string.match(text, "^%s*(.-)%s*$")) or ""
end

-- Tronque à maxChars caractères UTF-8 (texte invalide : laissé tel quel, le serveur le refusera)
local function limit(text: string, maxChars: number): string
	local length = utf8.len(text)
	if length and length > maxChars then
		local cut = utf8.offset(text, maxChars + 1)
		if cut then
			return string.sub(text, 1, cut - 1)
		end
	end
	return text
end

function ChatInput.new(ctx: any, options: Options)
	local UI = ctx.UIUtil
	local Theme = ctx.Theme
	local zBase = options.ZIndex or 3
	local placeholder = Locale.T("Send a message…")
	local compactPlaceholder = Locale.T("Type here…")
	local isCompact = false
	local inset = options.Inset or 5

	local height, sendSize = 26, 22
	local sending, token, sentAt = false, 0, 0
	local cooldownUntil = 0
	local statusUntil, statusKind = 0, "" -- "" | "counter" | "timed"
	local hasSent, focused = false, false
	local shownSend = "" -- état affiché du bouton ("ready" | "busy" | "wait3"...)
	local inviteOn = false

	------------------------------------------------------------------
	-- Construction
	------------------------------------------------------------------
	local frame = UI.Create("Frame", {
		Name = "ChatInput",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, inset, 1, -inset),
		Size = UDim2.new(1, -2 * inset, 0, height),
		BackgroundColor3 = FIELD,
		BackgroundTransparency = 0.3,
		BorderSizePixel = 0,
		ZIndex = zBase,
		Parent = options.Parent,
	})
	UI.Corner(frame, UDim.new(1, 0))
	local stroke = UI.Stroke(frame, STROKE_IDLE, 1, 0.3)

	-- Zone du texte : découpe ce qui dépasse (texte long, indication) avant le bouton
	local field = UI.Create("Frame", {
		Name = "Field",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Position = UDim2.fromOffset(11, 0),
		Size = UDim2.new(1, -(11 + sendSize + 7), 1, 0),
		ZIndex = zBase + 1,
		Parent = frame,
	})
	local box = UI.Create("TextBox", {
		Name = "ChatBox",
		Text = "",
		PlaceholderText = placeholder,
		PlaceholderColor3 = Color3.fromRGB(200, 190, 230),
		TextColor3 = Color3.fromRGB(250, 246, 255),
		Font = Theme.Fonts.Body,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		MultiLine = false,
		ClipsDescendants = true,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = zBase + 1,
		Parent = field,
	})

	local send = UI.Create("TextButton", {
		Name = "SendChat",
		Text = "",
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -2, 0.5, 0),
		Size = UDim2.fromOffset(sendSize, sendSize),
		BackgroundColor3 = SEND_READY,
		BorderSizePixel = 0,
		ZIndex = zBase + 1,
		Parent = frame,
	})
	UI.Corner(send, UDim.new(1, 0))
	UI.Gradient(send, ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(230, 180, 210)), 90)
	local sendStroke = UI.Stroke(send, Color3.fromRGB(255, 190, 220), 1, 0.35)
	UI.AnimateButton(send, 1.12, 0.86)
	local sendScale = send:FindFirstChild("AnimScale") :: UIScale? -- (un seul UIScale par objet)

	-- Flèche "envoyer" : tige + deux traits de pointe (dessin 18 x 18 mis à l'échelle)
	local arrow = UI.Create("Frame", {
		Name = "Arrow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(ARROW_BOX, ARROW_BOX),
		BackgroundTransparency = 1,
		ZIndex = zBase + 2,
		Parent = send,
	})
	local arrowScale = UI.Create("UIScale", { Scale = sendSize / ARROW_BOX, Parent = arrow })
	local function bar(x: number, y: number, w: number, rotation: number)
		local piece = UI.Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(x, y),
			Size = UDim2.fromOffset(w, 2),
			Rotation = rotation,
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			ZIndex = zBase + 2,
			Parent = arrow,
		})
		UI.Corner(piece, 1)
	end
	bar(8.2, 9, 8, 0) -- tige (x 4.2 -> 12.2)
	bar(10.9, 7.3, 5.4, 40) -- pointe (se rejoignent vers x = 13)
	bar(10.9, 10.7, 5.4, -40)

	-- Compte à rebours / "•••" sur le bouton
	local sendLabel = UI.Create("TextLabel", {
		Name = "Wait",
		Text = "",
		Font = Theme.Fonts.Title,
		TextSize = 12,
		TextColor3 = Color3.fromRGB(230, 222, 255),
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = zBase + 3,
		Parent = send,
	})

	-- Ligne d'état au-dessus du champ : compteur, erreur, mode lent
	-- (texte sur plusieurs lignes si besoin : la ligne grandit vers le haut)
	local status = UI.Create("TextLabel", {
		Name = "ChatStatus",
		Text = "",
		Font = Theme.Fonts.Title,
		TextSize = 11,
		TextColor3 = INFO_COLOR,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Color3.fromRGB(16, 12, 28),
		BackgroundTransparency = 0.04,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, inset, 1, -(height + inset + 3)),
		Size = UDim2.new(1, -2 * inset, 0, 16),
		Visible = false,
		ZIndex = zBase + 4,
		Parent = options.Parent,
	})
	UI.Corner(status, 5)
	UI.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 5),
		PaddingRight = UDim.new(0, 5),
		PaddingTop = UDim.new(0, 1),
		PaddingBottom = UDim.new(0, 1),
		Parent = status,
	})

	------------------------------------------------------------------
	-- États
	------------------------------------------------------------------
	local function showStatus(text: string, color: Color3, duration: number?)
		status.Text = text
		status.TextColor3 = color
		status.Visible = true
		if duration then
			statusKind = "timed"
			statusUntil = os.clock() + duration
		else
			statusKind = "counter"
			statusUntil = 0
		end
	end

	local function hideStatus()
		status.Visible = false
		statusKind = ""
		statusUntil = 0
	end

	-- Bouton : prêt (flèche violette), envoi ("•••"), attente (compte à rebours)
	local function refreshSend(now: number)
		local state
		if sending then
			state = "busy" .. (math.floor(now * 3) % 3)
		elseif now < cooldownUntil then
			state = "wait" .. math.ceil(cooldownUntil - now)
		else
			state = "ready"
		end
		if state == shownSend then
			return
		end
		local wasWaiting = string.sub(shownSend, 1, 4) == "wait" or string.sub(shownSend, 1, 4) == "busy"
		shownSend = state
		local ready = state == "ready"
		arrow.Visible = ready
		sendLabel.Visible = not ready
		send.BackgroundColor3 = ready and SEND_READY or SEND_WAIT
		sendStroke.Transparency = ready and 0.35 or 0.7
		if sending then
			sendLabel.Text = string.rep("•", math.floor(now * 3) % 3 + 1)
		elseif not ready then
			sendLabel.Text = tostring(math.ceil(cooldownUntil - now))
		elseif wasWaiting and sendScale then
			sendScale.Scale = 1.25 -- de nouveau prêt : petit "pop"
			UI.Tween(sendScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		end
	end

	local function setBusy(busy: boolean)
		box.TextEditable = not busy
		box.TextTransparency = busy and 0.55 or 0
		box.PlaceholderText = busy and Locale.T("Sending…") or (isCompact and compactPlaceholder or placeholder)
		refreshSend(os.clock())
	end

	local function nudge()
		local home = UDim2.new(0, inset, 1, -inset)
		frame.Position = home + UDim2.fromOffset(4, 0)
		UI.Tween(frame, 0.25, { Position = home }, Enum.EasingStyle.Elastic)
	end

	local function cleanTopics(raw: any): { string }
		local topics = {}
		if type(raw) == "table" then
			for _, topic in ipairs(raw) do
				if type(topic) == "string" and (options.KnownTopics == nil or options.KnownTopics[topic]) then
					table.insert(topics, topic)
					if #topics >= 4 then
						break
					end
				end
			end
		end
		return topics
	end

	-- Réponse du serveur (ignorée si une autre demande l'a remplacée)
	local function finish(requestToken: number, ok: boolean, success: any, result: any)
		if not ctx.IsAlive() or requestToken ~= token or not sending then
			return
		end
		sending = false
		setBusy(false)
		if ok and success == true and type(result) == "table" and type(result.Text) == "string" and trim(result.Text) ~= "" then
			box.Text = ""
			hasSent = true
			cooldownUntil = os.clock() + COOLDOWN
			hideStatus()
			refreshSend(os.clock())
			local handled, err = pcall(options.OnMessage, result.Text, cleanTopics(result.Topics))
			if not handled then
				warn("[LiveStream] " .. tostring(err))
			end
		else
			-- Message du serveur (déjà traduit) ou générique ; le brouillon reste
			local message = (ok and type(result) == "string" and result ~= "") and result
				or Locale.T("Message could not be sent, try again")
			showStatus("⚠️ " .. message, ERROR_COLOR, STATUS_TIME)
			cooldownUntil = os.clock() + FAIL_COOLDOWN
			refreshSend(os.clock())
		end
	end

	local function submit()
		if sending or not options.Parent.Visible then
			return
		end
		local text = limit(trim(box.Text), MAX_CHARS)
		if text == "" then
			nudge()
			return
		end
		local now = os.clock()
		if now < cooldownUntil then
			showStatus(Locale.T("⏳ Slow mode: %ss", tostring(math.ceil(cooldownUntil - now))), SLOW_COLOR, 1.6)
			nudge()
			return
		end
		sending = true
		token += 1
		sentAt = now
		local requestToken = token
		setBusy(true)
		task.spawn(function()
			local ok, success, result = pcall(function()
				return ctx.Net.Function("FilterText"):InvokeServer("Live", text)
			end)
			finish(requestToken, ok, success, result)
		end)
	end

	local function focus()
		if sending or not options.Parent.Visible then
			return
		end
		pcall(function()
			box:CaptureFocus()
		end)
	end

	------------------------------------------------------------------
	-- Événements
	------------------------------------------------------------------
	ctx.Connect(box.FocusLost, function(enterPressed: boolean)
		focused = false
		if options.OnFocus then
			options.OnFocus(false)
		end
		if enterPressed then
			submit()
		end
	end)
	ctx.Connect(box.Focused, function()
		focused = true
		if options.OnFocus then
			options.OnFocus(true)
		end
	end)
	ctx.Connect(send.Activated, submit)

	-- Une seule ligne, 120 caractères maximum, compteur
	ctx.Connect(box:GetPropertyChangedSignal("Text"), function()
		local text = box.Text
		if string.find(text, "[\r\n]") then
			box.Text = (string.gsub(text, "[\r\n]+", " ")) -- (rappelle ce gestionnaire)
			return
		end
		local limited = limit(text, MAX_CHARS)
		if limited ~= text then
			box.Text = limited
			return
		end
		local length = utf8.len(text) or #text
		if length >= COUNTER_FROM then
			if statusKind ~= "timed" then
				showStatus(string.format("%s/%s", tostring(length), tostring(MAX_CHARS)), length >= MAX_CHARS and SLOW_COLOR or INFO_COLOR, nil)
			end
		elseif statusKind == "counter" then
			hideStatus()
		end
	end)

	-- Tactile (et souris) : toucher la liste des messages ouvre le clavier
	if options.TapArea then
		local tap = UI.Create("TextButton", {
			Name = "ChatTap",
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 20,
			Parent = options.TapArea,
		})
		ctx.Connect(tap.Activated, focus)
	end

	------------------------------------------------------------------
	-- API
	------------------------------------------------------------------
	local api = { Frame = frame, Box = box, Send = send, Height = height }

	function api.SetCompact(compact: boolean)
		height = compact and 36 or 26
		sendSize = compact and 30 or 22
		api.Height = height
		frame.Size = UDim2.new(1, -2 * inset, 0, height)
		isCompact = compact
		box.TextSize = compact and 19 or 13
		field.Size = UDim2.new(1, -(11 + sendSize + 7), 1, 0)
		if not sending then
			box.PlaceholderText = compact and compactPlaceholder or placeholder
		end
		send.Size = UDim2.fromOffset(sendSize, sendSize)
		arrowScale.Scale = sendSize / ARROW_BOX
		sendLabel.TextSize = compact and 18 or 12
		status.TextSize = compact and 16 or 11
		status.Size = UDim2.new(1, -2 * inset, 0, compact and 22 or 16)
		status.Position = UDim2.new(0, inset, 1, -(height + inset + 3))
	end

	function api.Focus()
		focus()
	end

	function api.IsFocused(): boolean
		return focused
	end

	function api.HasSent(): boolean
		return hasSent
	end

	-- Appelé par la boucle de rendu (≤ 30 Hz)
	function api.Step(now: number)
		if sending and now - sentAt > TIMEOUT then
			-- Pas de réponse : on rend la main (une réponse tardive sera ignorée)
			token += 1
			sending = false
			setBusy(false)
			showStatus("⚠️ " .. Locale.T("Message could not be sent, try again"), ERROR_COLOR, STATUS_TIME)
		end
		refreshSend(now)
		if statusKind == "timed" and now >= statusUntil then
			hideStatus()
		end
		-- Contour : focus (vif), invitation tant que rien n'est écrit, repos
		if focused then
			if inviteOn or stroke.Color ~= STROKE_FOCUS then
				inviteOn = false
				stroke.Color, stroke.Transparency, stroke.Thickness = STROKE_FOCUS, 0, 1.5
			end
		elseif not hasSent then
			inviteOn = true
			stroke.Color, stroke.Thickness = STROKE_INVITE, 1.5
			stroke.Transparency = 0.15 + 0.5 * (0.5 + 0.5 * math.sin(now * 3.2))
		elseif inviteOn or stroke.Color ~= STROKE_IDLE then
			inviteOn = false
			stroke.Color, stroke.Transparency, stroke.Thickness = STROKE_IDLE, 0.45, 1
		end
	end

	return api
end

return ChatInput
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="131">
            <Properties>
              <string name="Name">ChatPanel</string>
              <string name="Source"><![CDATA[--[[
	ChatPanel (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Stimuli > Live > ChatPanel

	v9.1 : le chat du live POSÉ SUR LA VIDÉO, en bas à gauche (façon appli de
	live sur téléphone), utilisé par Stimuli > LiveStream :
	  - chaque message est une "bulle" sombre translucide À LA LARGEUR DU
	    TEXTE (TextService), avatar rond à initiale, pseudo en couleur, texte
	    blanc ombré : lisible sur l'image, même sur une petite carte ;
	  - styles : "you" (ton message : doré + ta photo), "mention" (on te
	    parle : rose), "host" (la streameuse : violet), messages système
	    (raid, don...) teintés ;
	  - le message arrive en glissant ; les plus anciens s'estompent vers le
	    haut (réserve FIXE de lignes recyclées, aucun objet créé ensuite) ;
	  - message épinglé (invitation à écrire) au-dessus, bandeau "RAID !" ;
	  - champ de saisie (Live > ChatInput) en bas ; toucher les messages
	    ouvre le clavier.
	Mode compact (téléphone) : texte bien plus gros, moins de lignes.
]]

local TextService = game:GetService("TextService")
local ChatInput = require(script.Parent.ChatInput)

local ChatPanel = {}

local WHITE = Color3.new(1, 1, 1)
local POOL = 10 -- lignes recyclées
local YOU_GOLD = Color3.fromRGB(255, 211, 77)
local MENTION_PINK = Color3.fromRGB(255, 84, 150)
local HOST_PURPLE = Color3.fromRGB(150, 80, 255)
local BUBBLE = Color3.fromRGB(12, 8, 24)

-- Tailles : normal / compact (téléphone)
local SIZES = {
	normal = { Text = 13, Avatar = 18, Pinned = 11, PinnedH = 30, Gap = 3, Visible = 6 },
	compact = { Text = 20, Avatar = 26, Pinned = 16, PinnedH = 0, Gap = 4, Visible = 3 },
}

export type Options = {
	Parent: GuiObject, -- la vidéo
	Position: UDim2,
	Size: UDim2,
	ZIndex: number,
	KnownTopics: { [string]: boolean }?,
	Headshot: string, -- photo du joueur ("" si aucune)
	OnMessage: (text: string, topics: { string }) -> (),
	OnFocus: ((focused: boolean) -> ())?,
}

type Line = {
	Frame: Frame,
	Bubble: Frame,
	Stroke: UIStroke,
	Gradient: UIGradient,
	Avatar: Frame,
	Initial: TextLabel,
	Photo: ImageLabel,
	Label: TextLabel,
	Plain: string,
	HasAvatar: boolean,
	Order: number,
}

function ChatPanel.new(ctx: any, options: Options)
	local UI = ctx.UIUtil
	local Theme = ctx.Theme
	local z = options.ZIndex
	local size = SIZES.normal
	local compact = false

	local panel = UI.Create("Frame", {
		Name = "Chat",
		Position = options.Position,
		Size = options.Size,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = z,
		Parent = options.Parent,
	})

	-- Message épinglé (en haut de la colonne)
	local pinned = UI.Create("Frame", {
		Name = "Pinned",
		Size = UDim2.new(1, 0, 0, size.PinnedH),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = z,
		Parent = panel,
	})
	UI.Corner(pinned, 9)
	UI.Gradient(pinned, ColorSequence.new(Color3.fromRGB(120, 60, 200), Color3.fromRGB(70, 40, 130)), 0)
	pinned.BackgroundTransparency = 0.15
	UI.Stroke(pinned, Color3.fromRGB(200, 160, 255), 1, 0.35)
	local pinnedLabel = UI.Create("TextLabel", {
		Text = "",
		RichText = true,
		Font = Theme.Fonts.Body,
		TextSize = size.Pinned,
		TextWrapped = true,
		TextColor3 = Color3.fromRGB(248, 242, 255),
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(7, 1),
		Size = UDim2.new(1, -12, 1, -2),
		ZIndex = z + 1,
		Parent = pinned,
	})

	-- Bandeau "RAID !" (caché hors raid)
	local banner = UI.Create("TextLabel", {
		Name = "Banner",
		Text = "",
		RichText = true,
		Font = Theme.Fonts.Title,
		TextSize = 14,
		TextColor3 = WHITE,
		BackgroundColor3 = Color3.fromRGB(230, 110, 20),
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 24),
		Visible = false,
		ZIndex = z + 2,
		Parent = panel,
	})
	UI.Corner(banner, 9)
	UI.Stroke(banner, Color3.fromRGB(255, 220, 150), 1.5, 0).ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	local bannerScale = UI.Create("UIScale", { Parent = banner })

	-- Liste : "rouleau" accroché en bas qui grandit vers le haut
	local list = UI.Create("Frame", {
		Name = "Messages",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = z,
		Parent = panel,
	})
	local scroller = UI.Create("Frame", {
		Name = "Scroller",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = z,
		Parent = list,
	})
	local listLayout = UI.Create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, size.Gap),
		Parent = scroller,
	})

	local input = ChatInput.new(ctx, {
		Parent = panel,
		TapArea = list,
		ZIndex = z + 2,
		Inset = 0,
		KnownTopics = options.KnownTopics,
		OnMessage = options.OnMessage,
		OnFocus = options.OnFocus,
	})

	local lines: { Line } = {}
	for i = 1, POOL do
		local frame = UI.Create("Frame", {
			Name = "Line" .. i,
			Size = UDim2.fromScale(1, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Visible = false,
			ZIndex = z,
			Parent = scroller,
		})
		UI.Create("UIPadding", { PaddingBottom = UDim.new(0, 3), Parent = frame })
		-- Bulle à la largeur du texte (hauteur = celle de la ligne)
		local bubble = UI.Create("Frame", {
			Name = "Bubble",
			Size = UDim2.new(0, 60, 1, 0),
			BackgroundColor3 = BUBBLE,
			BackgroundTransparency = 0.42,
			BorderSizePixel = 0,
			ZIndex = z,
			Parent = frame,
		})
		UI.Corner(bubble, 10)
		local stroke = UI.Stroke(bubble, YOU_GOLD, 1.5, 0.1)
		stroke.Enabled = false
		local gradient = UI.Gradient(bubble, ColorSequence.new(Color3.fromRGB(255, 196, 70), Color3.fromRGB(255, 104, 170)), 0)
		gradient.Enabled = false
		local avatar = UI.Create("Frame", {
			Name = "Avatar",
			Position = UDim2.fromOffset(3, 3),
			Size = UDim2.fromOffset(size.Avatar, size.Avatar),
			BackgroundColor3 = WHITE,
			BorderSizePixel = 0,
			ZIndex = z + 1,
			Parent = frame,
		})
		UI.Corner(avatar, UDim.new(1, 0))
		local initial = UI.Create("TextLabel", {
			Text = "",
			Font = Theme.Fonts.Title,
			TextSize = 11,
			TextColor3 = Color3.fromRGB(30, 20, 40),
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			ZIndex = z + 2,
			Parent = avatar,
		})
		local photo = UI.Create("ImageLabel", { Name = "Photo", Image = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = z + 3, Parent = avatar })
		UI.Corner(photo, UDim.new(1, 0))
		local label = UI.Create("TextLabel", {
			Name = "Msg",
			Text = "",
			RichText = true,
			Font = Theme.Fonts.Body,
			TextSize = size.Text,
			TextWrapped = true,
			TextColor3 = WHITE,
			TextStrokeColor3 = Color3.fromRGB(10, 6, 20),
			TextStrokeTransparency = 0.6,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = z + 1,
			Parent = frame,
		})
		lines[i] = { Frame = frame, Bubble = bubble, Stroke = stroke, Gradient = gradient, Avatar = avatar, Initial = initial, Photo = photo, Label = label, Plain = "", HasAvatar = false, Order = 0 }
	end
	local nextLine, order = 0, 0

	-- Largeur utile d'une ligne (pixels "design" de la carte)
	local function columnWidth(): number
		local width = panel.Size.X.Offset
		return width > 0 and width or 180
	end

	local function textLeft(line: Line): number
		return line.HasAvatar and (size.Avatar + 8) or 8
	end

	-- Texte brut d'un texte riche (balises retirées, entités décodées)
	local function plainOf(rich: string): string
		local plain = string.gsub(rich, "<[^>]*>", "")
		plain = string.gsub(plain, "&lt;", "<")
		plain = string.gsub(plain, "&gt;", ">")
		plain = string.gsub(plain, "&amp;", "&")
		return plain
	end

	-- Mesure du texte (police grasse : un peu plus large que le vrai rendu)
	local function measure(plain: string): number
		local ok, bounds = pcall(function()
			return TextService:GetTextSize(plain, size.Text, Theme.Fonts.Title, Vector2.new(4000, 200))
		end)
		if ok and typeof(bounds) == "Vector2" then
			return bounds.X
		end
		return 4000
	end

	local function layoutLine(line: Line)
		local left = textLeft(line)
		local labelWidth = columnWidth() - left - 6
		line.Label.Position = UDim2.fromOffset(left, 3)
		line.Label.Size = UDim2.new(0, labelWidth, 0, 0)
		line.Avatar.Size = UDim2.fromOffset(size.Avatar, size.Avatar)
		line.Initial.TextSize = compact and 16 or 11
		line.Label.TextSize = size.Text
		local textWidth = measure(line.Plain)
		if string.find(line.Label.Text, '<font size="', 1, true) then
			textWidth *= 1.45 -- (emotes affichées en plus gros)
		end
		local width = math.min(columnWidth(), left + textWidth + 10)
		line.Bubble.Size = UDim2.new(0, math.max(width, left + 24), 1, 0)
	end

	-- Estompe les plus anciens (seulement les `Visible` plus récents bien lisibles)
	local function refreshFade()
		local ranked = {}
		for _, line in ipairs(lines) do
			if line.Frame.Visible then
				table.insert(ranked, line)
			end
		end
		table.sort(ranked, function(a, b)
			return a.Order > b.Order
		end)
		for rank, line in ipairs(ranked) do
			local fade = rank <= size.Visible - 1 and 0 or (rank == size.Visible and 0.45 or 0.8)
			line.Label.TextTransparency = fade
			line.Label.TextStrokeTransparency = 0.6 + fade * 0.4
			line.Initial.TextTransparency = fade
			line.Avatar.BackgroundTransparency = fade
			line.Photo.ImageTransparency = fade
			local base = line.Gradient.Enabled and 0.3 or (line.Stroke.Enabled and 0.35 or 0.42)
			line.Bubble.BackgroundTransparency = base + (1 - base) * fade
			line.Stroke.Transparency = line.Stroke.Enabled and (0.1 + 0.9 * fade) or 1
			-- (une ligne qui a quitté la zone visible est recyclée plus tard)
		end
	end

	local api = { Frame = panel, Input = input }

	-- Écrit une ligne (réserve recyclée). rich : texte riche déjà échappé ;
	-- avatarName : initiale (nil = message système) ; style.Kind : "you" |
	-- "mention" | "host" ; style.Tint : couleur d'un message système.
	function api.Write(rich: string, avatarName: string?, avatarColor: Color3?, style: { Kind: string?, Tint: Color3? }?)
		nextLine = nextLine % POOL + 1
		local line = lines[nextLine]
		order += 1
		line.Order = order
		line.Frame.LayoutOrder = order
		line.Frame.Visible = true
		line.Label.Text = rich
		line.Plain = plainOf(rich)
		local kind = style and style.Kind
		local tint = style and style.Tint
		local you, mention, host = kind == "you", kind == "mention", kind == "host"
		line.HasAvatar = avatarName ~= nil
		line.Avatar.Visible = line.HasAvatar
		if avatarName then
			line.Avatar.BackgroundColor3 = you and YOU_GOLD or (avatarColor or WHITE)
			line.Initial.Text = string.upper(string.sub(avatarName, 1, 1))
		end
		local showPhoto = you and options.Headshot ~= ""
		line.Photo.Visible = showPhoto
		if showPhoto and line.Photo.Image ~= options.Headshot then
			line.Photo.Image = options.Headshot
		end
		line.Gradient.Enabled = you
		line.Stroke.Enabled = you or mention or host
		if you then
			line.Bubble.BackgroundColor3 = Color3.fromRGB(190, 120, 40)
			line.Stroke.Color = YOU_GOLD
		elseif mention then
			line.Bubble.BackgroundColor3 = Color3.fromRGB(120, 20, 70)
			line.Stroke.Color = MENTION_PINK
		elseif host then
			line.Bubble.BackgroundColor3 = Color3.fromRGB(70, 30, 140)
			line.Stroke.Color = HOST_PURPLE
		else
			line.Bubble.BackgroundColor3 = tint and tint:Lerp(BUBBLE, 0.35) or BUBBLE
		end
		layoutLine(line)
		refreshFade()
		-- Arrivée : glisse depuis la gauche + petit flash
		line.Label.Position = UDim2.fromOffset(textLeft(line) - 14, 3)
		UI.Tween(line.Label, 0.25, { Position = UDim2.fromOffset(textLeft(line), 3) }, Enum.EasingStyle.Back)
		if you or mention then
			line.Bubble.BackgroundTransparency = 0
			UI.Tween(line.Bubble, 0.8, { BackgroundTransparency = you and 0.3 or 0.35 })
		end
	end

	function api.SetPinned(rich: string?)
		if rich then
			pinnedLabel.Text = rich
		end
		pinned.Visible = rich ~= nil and not compact
		api.Layout()
	end

	function api.SetBanner(rich: string?)
		banner.Visible = rich ~= nil
		if rich then
			banner.Text = rich
			bannerScale.Scale = 0.4
			UI.Tween(bannerScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
		end
	end

	-- Replace la liste entre l'épinglé et la saisie
	function api.Layout()
		local top = pinned.Visible and (size.PinnedH + 4) or 0
		local bottom = input.Height + 5
		list.Position = UDim2.fromOffset(0, top)
		list.Size = UDim2.new(1, 0, 1, -(top + bottom))
		pinned.Size = UDim2.new(1, 0, 0, size.PinnedH)
	end

	function api.SetCompact(on: boolean)
		if on == compact then
			return
		end
		compact = on
		size = on and SIZES.compact or SIZES.normal
		input.SetCompact(on)
		pinnedLabel.TextSize = size.Pinned
		banner.TextSize = on and 20 or 14
		banner.Size = UDim2.new(1, 0, 0, on and 32 or 24)
		listLayout.Padding = UDim.new(0, size.Gap)
		pinned.Visible = pinned.Visible and not on
		for _, line in ipairs(lines) do
			layoutLine(line)
		end
		refreshFade()
		api.Layout()
	end

	function api.SetFrame(position: UDim2, frameSize: UDim2)
		panel.Position = position
		panel.Size = frameSize
		for _, line in ipairs(lines) do
			if line.Frame.Visible then
				layoutLine(line)
			end
		end
	end

	function api.IsCompact(): boolean
		return compact
	end

	function api.Step(now: number)
		input.Step(now)
	end

	api.Layout()
	return api
end

return ChatPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="132">
            <Properties>
              <string name="Name">ChatReplies</string>
              <string name="Source"><![CDATA[--[[
	ChatReplies (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Stimuli > Live > ChatReplies

	Ce que répondent la streameuse et les faux spectateurs quand le JOUEUR
	écrit dans le chat du live (Stimuli > LiveStream). Module "pur" (aucun
	service Roblox) : testable hors de Roblox.

	Entrée : le texte DÉJÀ FILTRÉ par le serveur (RemoteFunction
	"FilterText") et ses sujets (Shared > ChatTopics, ex. { "Greeting",
	"Question" }). Sortie : un "plan" que LiveStream joue dans le temps :
		{
			Topic = "Greeting",            -- sujet principal (ou "None", "Filtered"...)
			Mood = { Expression, Gesture, Float, Hearts },  -- réaction de la streameuse
			Host = { Delay = 1.7, Text = "coucou \1 !!" },  -- sa réponse (bulle + chat)
			Viewers = { { Delay = 1.2, Text = "...", Mod = false }, ... }, -- 1 à 4 (+ modo)
		}
	Le pseudo du joueur est remplacé par le caractère NAME ("\1") : LiveStream
	le met en valeur dans le chat (mention dorée) et le remet en clair dans la
	bulle. Toutes les phrases sont gentilles (même quand le joueur est
	méchant : réponses mignonnes / taquines, jamais d'insulte) et ne demandent
	jamais d'information personnelle.
	Chaque liste existe en anglais ET en français ({ en = {...}, fr = {...} }),
	"{n}" = pseudo du joueur.
]]

local ChatReplies = {}

-- Marque du pseudo dans les textes du plan (jamais tapée par un joueur :
-- le serveur retire les caractères de contrôle)
ChatReplies.NAME = "\1"

export type Mood = { Expression: string, Gesture: string?, Float: string?, Hearts: number? }
export type Line = { Delay: number, Text: string, Mod: boolean? }
export type Plan = { Topic: string, Mood: Mood, Host: Line, Viewers: { Line } }

-- Réaction de la streameuse (expression du visage, geste des bras, emoji qui
-- s'envole au-dessus de sa tête, nombre de cœurs)
ChatReplies.Moods = {
	Greeting = { Expression = "Happy", Gesture = "Wave", Float = "👋", Hearts = 1 },
	Bye = { Expression = "Happy", Gesture = "Wave", Float = "👋", Hearts = 1 },
	Love = { Expression = "Love", Gesture = "Heart", Float = "💖", Hearts = 4 },
	Compliment = { Expression = "Shy", Gesture = "Cheeks", Float = "🥰", Hearts = 3 },
	Mean = { Expression = "Pout", Float = "🥺" },
	Question = { Expression = "Think", Gesture = "Think", Float = "❓" },
	Food = { Expression = "Yum", Gesture = "Cheeks", Float = "🤤", Hearts = 1 },
	Butter = { Expression = "Wow", Gesture = "Cheer", Float = "🧈", Hearts = 1 },
	ASMR = { Expression = "Shh", Gesture = "Shh", Float = "🤫" },
	Dopamine = { Expression = "Wow", Gesture = "Cheer", Float = "🤯", Hearts = 1 },
	Follow = { Expression = "Shy", Gesture = "Heart", Float = "💜", Hearts = 3 },
	Laugh = { Expression = "Laugh", Float = "😂", Hearts = 1 },
	Music = { Expression = "Vibe", Gesture = "Cheer", Float = "🎵" },
	Sleep = { Expression = "Sleepy", Float = "💤" },
	Sad = { Expression = "Sad", Gesture = "Heart", Float = "💜", Hearts = 2 },
	Happy = { Expression = "Laugh", Gesture = "Cheer", Float = "🎉", Hearts = 2 },
	Game = { Expression = "Wow", Gesture = "Cheer", Float = "🎮" },
	Help = { Expression = "Think", Gesture = "Point", Float = "💡" },
	Age = { Expression = "Wink", Gesture = "Shh", Float = "🤫" },
	Name = { Expression = "Shy", Gesture = "Wave", Float = "✨", Hearts = 1 },
	Pet = { Expression = "Love", Gesture = "Cheeks", Float = "🐾", Hearts = 2 },
	Weather = { Expression = "Think", Gesture = "Point", Float = "☀️" },
	School = { Expression = "Talk", Gesture = "Point", Float = "📚" },
	None = { Expression = "Happy", Gesture = "Wave", Float = "💜", Hearts = 1 },
	-- Cas particuliers (voir Build)
	Filtered = { Expression = "Pout", Float = "🙈" },
	Test = { Expression = "Wow", Gesture = "Point", Float = "✅" },
	HowAreYou = { Expression = "Happy", Gesture = "Wave", Float = "😊", Hearts = 1 },
	Emoji = { Expression = "Laugh", Float = "✨", Hearts = 2 },
}

----------------------------------------------------------------------
-- Réponses de la streameuse (lues dans la bulle + écrites dans le chat)
----------------------------------------------------------------------

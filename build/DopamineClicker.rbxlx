		["No reward: the race was not valid"] = "Pas de récompense : course non valide",
		["You finished %d%s · +%s Dopamine!"] = "Tu finis %d%s · +%s de Dopamine !",
		["You finished %d%s · daily race rewards reached"] = "Tu finis %d%s · récompenses du jour atteintes",
		["You finished %d%s"] = "Tu finis %d%s",
	},
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="284">
          <Properties>
            <string name="Name">FR_V8_Arcade</string>
            <string name="Source"><![CDATA[--[[
	FR_V8_Arcade (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > Lang > FR_V8_Arcade

	Traductions françaises de l'🕹️ Arcade (ArcadeConfig, panneau Arcade,
	duels Client > Minigames > Duel_*, messages de MinigameService).
]]

return {
	fr = {
		-- Fenêtre, onglets
		["🕹️ Arcade"] = "🕹️ Arcade",

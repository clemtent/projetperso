	------------------------------------------------------------------
	-- Carte des chances (bouton "?")
	------------------------------------------------------------------
	local totalWeight = 0
	for _, tier in ipairs(tiers) do
		totalWeight += math.max(0, tonumber(tier.Weight) or 0)
	end

	local function percentOf(tier): number
		if totalWeight <= 0 then
			return 0
		end
		return math.max(0, tonumber(tier.Weight) or 0) / totalWeight * 100
	end

	local function percentText(percent: number): string
		if totalWeight <= 0 then
			return "?"
		end
		if percent >= 10 or math.abs(percent - math.floor(percent + 0.5)) < 0.05 then
			return tostring(math.floor(percent + 0.5)) .. " %"
		end
		return string.format("%.1f %%", percent)
	end

	local oddsPanel = Create("TextButton", {
		Name = "OddsPanel",
		Size = UDim2.new(1, -8, 1, -8),
		Position = UDim2.fromOffset(4, 4),
		BackgroundColor3 = WHITE,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 30,
		Visible = false,
		Parent = card,
	})
	UIUtil.Corner(oddsPanel, 16)
	UIUtil.Stroke(oddsPanel, Theme.Colors.Purple, 2, 0.1)
	vGradient(oddsPanel, WHITE, Color3.fromRGB(240, 234, 255))
	local oddsScale = Create("UIScale", { Parent = oddsPanel })
	UIUtil.Label({
		Text = Locale.T("🎲 Odds"),
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.TextDark,
		Position = UDim2.fromOffset(10, 5),
		Size = UDim2.new(1, -20, 0, 20),
		MaxTextSize = 16,
		ZIndex = 31,
		Parent = oddsPanel,
	})
	local panelHeight = height - 8
	local rowCount = math.max(1, #tiers)
	local rowHeight = math.min(30, math.floor((panelHeight - 28 - 18) / rowCount))
	local oddsFills = {}
	for index, tier in ipairs(tiers) do
		local y = 28 + (index - 1) * rowHeight
		local tierColor: Color3 = tier.Color or GOLD
		local percent = percentOf(tier)
		UIUtil.Label({
			Text = Locale.T(tostring(tier.Name or tier.Id)),
			Font = Theme.Fonts.Title,
			TextColor3 = tierColor:Lerp(Theme.Colors.TextDark, 0.3),
			TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.fromOffset(12, y),
			Size = UDim2.new(1, -76, 0, rowHeight - 14),
			MaxTextSize = 13,
			ZIndex = 31,
			Parent = oddsPanel,
		})
		UIUtil.Label({
			Text = percentText(percent),
			Font = Theme.Fonts.Number,
			TextColor3 = Theme.Colors.TextDark,
			TextXAlignment = Enum.TextXAlignment.Right,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -12, 0, y),
			Size = UDim2.fromOffset(56, rowHeight - 14),
			MaxTextSize = 13,
			ZIndex = 31,
			Parent = oddsPanel,
		})
		local track = box(oddsPanel, {
			Position = UDim2.fromOffset(12, y + rowHeight - 13),
			Size = UDim2.new(1, -24, 0, 8),
			BackgroundColor3 = Color3.fromRGB(226, 220, 240),
			ClipsDescendants = true,
			ZIndex = 31,
		})
		round(track)
		local fill = box(track, {
			Size = UDim2.fromScale(0, 1),
			BackgroundColor3 = WHITE,
			ZIndex = 32,
		})
		round(fill)
		Create("UIGradient", { Color = ColorSequence.new(tierColor:Lerp(WHITE, 0.45), tierColor), Parent = fill })
		oddsFills[index] = { Frame = fill, Target = math.max(0.04, percent / 100) }
	end
	UIUtil.Label({
		Text = Locale.T("Tap to close"),
		TextColor3 = Theme.Colors.TextDim,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -4),
		Size = UDim2.new(1, -16, 0, 13),
		MaxTextSize = 11,
		ZIndex = 31,
		Parent = oddsPanel,
	})

	local oddsToken = 0
	local function setOdds(show: boolean)
		oddsToken += 1
		oddsPanel.Visible = show
		if not show then
			return
		end
		oddsScale.Scale = 0.8
		UIUtil.Tween(oddsScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
		ctx.Sound.Play("Click", 1.4)
		local token = oddsToken
		for index, entry in ipairs(oddsFills) do
			entry.Frame.Size = UDim2.fromScale(0, 1)
			task.delay(0.05 + index * 0.07, function()
				if token == oddsToken and entry.Frame.Parent then
					UIUtil.Tween(entry.Frame, 0.45, { Size = UDim2.fromScale(entry.Target, 1) }, Enum.EasingStyle.Quart)
				end
			end)
		end
		-- Fermeture automatique
		task.delay(7, function()
			if token == oddsToken and oddsPanel.Parent then
				oddsPanel.Visible = false
			end
		end)
	end
	ctx.Connect(oddsButton.Activated, function()
		setOdds(not oddsPanel.Visible)
	end)
	ctx.Connect(oddsPanel.Activated, function()
		setOdds(false)
	end)
	ctx.Connect(oddsButton.MouseEnter, function()
		UIUtil.Tween(oddsButton, 0.12, { BackgroundTransparency = 0.6 })
	end)
	ctx.Connect(oddsButton.MouseLeave, function()
		UIUtil.Tween(oddsButton, 0.12, { BackgroundTransparency = 0.8 })
	end)

	------------------------------------------------------------------
	-- Suivi du stock et de la charge
	------------------------------------------------------------------
	local stored, serverProgress, maxStored = readChests()
	local progressTime = os.clock()
	local shownFill = 0
	local opening = false
	local calloutShown = false
	local pillText = ""
	local pillOverride = ""
	local pillOverrideUntil = 0

	local function setCallout(show: boolean)
		if show == calloutShown then
			return
		end
		calloutShown = show
		if show then
			callout.Visible = true
			calloutScale.Scale = 0.2
			UIUtil.Tween(calloutScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
		else
			UIUtil.Tween(calloutScale, 0.18, { Scale = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(0.2, function()
				if not calloutShown and callout.Parent then
					callout.Visible = false
				end
			end)
		end
	end

	local function refreshStock()
		badge.Visible = stored > 0
		badgeText.Text = stored > 99 and "99+" or tostring(math.floor(stored))
		callout.Text = stored >= maxStored and Locale.T("FULL!") or Locale.T("READY!")
		setCallout(stored >= 1 and not opening)
	end
	refreshStock()

	local function showPillMessage(text: string, seconds: number)
		pillOverride = text
		pillOverrideUntil = os.clock() + seconds
	end

	local function onChests()
		local newStored, newProgress, newMax = readChests()
		if newProgress ~= serverProgress then
			serverProgress = newProgress
			progressTime = os.clock()
		end
		maxStored = newMax
		if newStored ~= stored then
			local gained = newStored > stored
			stored = newStored
			refreshStock()
			if gained and not opening then
				-- Nouveau coffre prêt : "pop" du badge + étincelles
				ctx.Sound.Play("Bonus", 1.4)
				badgeScale.Scale = 1.8
				UIUtil.Tween(badgeScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
				launchSparks(Vector2.new(cx, chestCY - 6), GOLD, 6, 30, 60)
				floatText(Vector2.new(cx, EFFECT_TEXT_Y), "+1 📦", GOLD, 22)
			end
		end
	end
	ctx.Connect(ctx.State.Changed, onChests)
	-- v8 : la jauge arrive aussi par les petits ticks (StateTick) du serveur
	if ctx.State.TickReceived then
		ctx.Connect(ctx.State.TickReceived, function(tick)
			if type(tick) == "table" and tick.Chests ~= nil then
				onChests()
			end
		end)
	end

	------------------------------------------------------------------
	-- Animation continue
	------------------------------------------------------------------
	local elapsed = 0
	local shakeAmount = 0 -- tremblement (ouverture / refus)
	local charge = 0 -- 0..1 : montée en tension pendant l'ouverture
	local glowLevel = 0.3
	local glowColor = IDLE_GLOW
	local glowTarget = IDLE_GLOW
	local raysAlpha = 1 -- 1 = rayons invisibles
	local raysTarget = 1
	local bigRaysOn = false
	local glintClock = 0
	local legendaryName: Color3? = nil -- couleur du nom qui scintille (légendaire)

	local function drawRing(fill: number, shimmer: boolean)
		local wavePosition = (elapsed * 0.7) % 1.4 - 0.2
		for index, segment in ipairs(segments) do
			local amount = math.clamp(fill * RING_SEGMENTS - (index - 1), 0, 1)
			if shimmer or math.abs(amount - segment.Fill) > 0.002 then
				segment.Fill = amount
				local color = segment.Color
				if shimmer then
					local distance = math.abs(index / RING_SEGMENTS - wavePosition)
					color = color:Lerp(WHITE, math.max(0, 1 - distance * 7) * 0.75)
				end
				segment.Frame.BackgroundColor3 = RING_TRACK:Lerp(color, amount)
				segment.Frame.BackgroundTransparency = 0.45 * (1 - amount)
			end
		end
	end

	ctx.OnRender(function(dt: number)
		elapsed += dt
		stepGlints(dt)
		local ready = stored >= 1 and not opening
		local full = stored >= maxStored

		-- Charge (prédite entre deux états du serveur)
		local target
		if full then
			target = 1
		else
			target = math.clamp(serverProgress + (os.clock() - progressTime) / (config.ChargeInterval or 120), 0, 1)
		end
		shownFill += (target - shownFill) * math.min(1, dt * 6)
		if target < shownFill - 0.5 then
			shownFill = target -- nouveau cycle : on repart de zéro
		end
		drawRing(full and 1 or shownFill, full)

		local text
		if os.clock() < pillOverrideUntil then
			text = pillOverride
		elseif full then
			text = Locale.T("FULL")
		else
			text = math.floor(target * 100) .. " %"
		end
		if text ~= pillText then
			pillText = text
			percentPill.Text = text
			percentPill.TextColor3 = text == pillOverride and Theme.Colors.Yellow or WHITE
		end

		-- Mouvement du coffre : tremblement, sauts d'impatience ou flottement
		local offsetX, offsetY, rotation = 0, 0, 0
		if shakeAmount > 0 then
			offsetX = math.sin(elapsed * 61) * shakeAmount * 0.55
			offsetY = math.sin(elapsed * 43) * shakeAmount * 0.2
			rotation = math.sin(elapsed * 53) * shakeAmount * 0.9
		elseif ready then
			offsetY = math.sin(elapsed * 2.4) * 1.5
			local phase = elapsed % 2.3
			if phase < 0.55 then
				local hop = math.sin(phase / 0.55 * math.pi)
				offsetY -= hop * 11
				rotation = math.sin(phase / 0.55 * math.pi * 2) * 5
			end
		elseif not opening then
			offsetY = math.sin(elapsed * 2) * 2.5 - 1
		end
		chest.Position = UDim2.fromOffset(cx + offsetX, chestCY + offsetY)
		chest.Rotation = rotation
		if not opening then
			chestScale.Scale = 1 + math.max(0, -offsetY - 3) * 0.004
		end

		-- Ombre : plus petite et plus claire quand le coffre est en l'air
		local lift = math.max(0, -offsetY)
		shadowScale.Scale = math.clamp(1 - lift * 0.035, 0.55, 1.05)
		shadowInner.BackgroundTransparency = 0.7 + lift * 0.015

		-- Halo qui respire (plus fort quand un coffre attend)
		local wanted = opening and 1 or (stored >= 1 and 0.85 or 0.3)
		glowLevel += (wanted - glowLevel) * math.min(1, dt * 3)
		if not opening then
			glowTarget = stored >= 1 and GOLD or IDLE_GLOW
		end
		glowColor = glowColor:Lerp(glowTarget, math.min(1, dt * 5))
		local pulse = 0.5 + 0.5 * math.sin(elapsed * (stored >= 1 and 4 or 2))
		glowOuter.BackgroundColor3 = glowColor
		glowInner.BackgroundColor3 = glowColor:Lerp(WHITE, 0.3)
		glowOuter.BackgroundTransparency = 1 - (0.06 + 0.16 * glowLevel) * (0.7 + 0.3 * pulse)
		glowInner.BackgroundTransparency = 1 - (0.08 + 0.3 * glowLevel) * (0.65 + 0.35 * pulse)
		local glowSize = 116 + glowLevel * 10 + pulse * 8 * glowLevel
		glowOuter.Size = UDim2.fromOffset(glowSize, glowSize)

		-- Trou de serrure lumineux
		local keyLight
		if opening then
			keyLight = charge
		elseif ready then
			keyLight = 0.35 + 0.65 * pulse
		else
			keyLight = 0.1 * pulse
		end
		keyhole.BackgroundColor3 = KEY_DARK:Lerp(KEY_GLOW, keyLight)
		keySlot.BackgroundColor3 = keyhole.BackgroundColor3
		lockGlow.BackgroundTransparency = 1 - 0.5 * keyLight

		-- Bulle "PRÊT !" qui rebondit
		if calloutShown then
			-- (rebond limité : la bulle ne touche jamais le bord de la carte)
			callout.Position = UDim2.fromOffset(cx, 20 - math.abs(math.sin(elapsed * 4.5)) * 3)
			callout.Rotation = math.sin(elapsed * 2.2) * 3
		end

		-- Reflets : étincelles autour du coffre prêt, reflets sur le métal sinon
		if effectsOn() then
			glintClock += dt
			local interval = ready and 0.32 or (opening and 0.15 or 1.4)
			if glintClock >= interval then
				glintClock = 0
				if ready or opening then
					local angle = random:NextNumber(0, math.pi * 2)
					local distance = random:NextNumber(40, 58)
					spawnGlint(
						Vector2.new(cx + math.cos(angle) * distance, chestCY - 4 + math.sin(angle) * distance * 0.85),
						random:NextInteger(12, 18)
					)
				else
					-- Sur le rebord doré, le couvercle ou la serrure
					local spots = { Vector2.new(-38, -8), Vector2.new(30, -8), Vector2.new(-22, -26), Vector2.new(4, 2), Vector2.new(24, -30) }
					local spot = spots[random:NextInteger(1, #spots)]
					spawnGlint(Vector2.new(cx + spot.X, chestCY + offsetY + spot.Y), random:NextInteger(10, 14))
				end
			end
		end

		-- Rayons tournants
		raysAlpha += (raysTarget - raysAlpha) * math.min(1, dt * 6)
		if raysTarget >= 1 and raysAlpha > 0.985 then
			raysAlpha = 1
		end
		local raysVisible = raysAlpha < 1
		rays.Visible = raysVisible
		bigRays.Visible = raysVisible and bigRaysOn
		if raysVisible then
			rays.Rotation = elapsed * 28
			for _, bar in ipairs(rayBars) do
				bar.BackgroundTransparency = raysAlpha
			end
			if bigRaysOn then
				bigRays.Rotation = 15 - elapsed * 40
				local alpha = math.min(1, raysAlpha + 0.1)
				for _, bar in ipairs(bigRayBars) do
					bar.BackgroundTransparency = alpha
				end
			end
		end

		-- Nom légendaire qui scintille
		local shine = legendaryName
		if shine then
			tierLabel.TextColor3 = shine:Lerp(WHITE, 0.5 + 0.5 * math.sin(elapsed * 12))
		end
	end)

	-- Survol (PC)
	ctx.Connect(card.MouseEnter, function()
		UIUtil.Tween(cardScale, 0.15, { Scale = 1.03 }, Enum.EasingStyle.Back)
	end)
	ctx.Connect(card.MouseLeave, function()
		UIUtil.Tween(cardScale, 0.15, { Scale = 1 })
	end)

	------------------------------------------------------------------
	-- Ouverture
	------------------------------------------------------------------
	local function findTier(id: any)
		for index, tier in ipairs(tiers) do
			if tier.Id == id then
				return tier, index
			end
		end
		return tiers[1], 1
	end

	local function waitAlive(seconds: number): boolean
		local finish = os.clock() + seconds
		while os.clock() < finish do
			if not ctx.IsAlive() then
				return false
			end
			task.wait()
		end
		return ctx.IsAlive()
	end

	-- Le couvercle bascule : la face avant s'écrase, puis le dessous apparaît
	local function flipLid(open: boolean): boolean
		if open then
			UIUtil.Tween(lid, 0.1, { Size = UDim2.fromOffset(LID_W, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			if not waitAlive(0.1) then
				return false
			end
			lid.Visible = false
			lidInner.Size = UDim2.fromOffset(LID_W, 0)
			lidInner.Visible = true
			UIUtil.Tween(lidInner, 0.3, { Size = UDim2.fromOffset(LID_W, LID_INNER_H) }, Enum.EasingStyle.Back)
		else
			UIUtil.Tween(lidInner, 0.1, { Size = UDim2.fromOffset(LID_W, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			if not waitAlive(0.1) then
				return false
			end
			lidInner.Visible = false
			lid.Size = UDim2.fromOffset(LID_W, 0)
			lid.Visible = true
			UIUtil.Tween(lid, 0.3, { Size = UDim2.fromOffset(LID_W, LID_H) }, Enum.EasingStyle.Back)
		end
		return true
	end

	-- Gain qui défile de 0 à `amount`
	local function countUp(amount: number, duration: number)
		task.spawn(function()
			local started = os.clock()
			local ticks = 0
			while ctx.IsAlive() and reward.Visible do
				local t = math.min(1, (os.clock() - started) / duration)
				local eased = 1 - (1 - t) ^ 3
				amountLabel.Text = "+" .. Format.Format(math.floor(amount * eased))
				if t >= 1 then
					break
				end
				if t * 6 >= ticks + 1 then
					ticks += 1
					ctx.Sound.Play("Click", 1.1 + ticks * 0.12)
				end
				task.wait()
			end
			if ctx.IsAlive() then
				amountLabel.Text = "+" .. Format.Format(amount)
				amountScale.Scale = 1.3
				UIUtil.Tween(amountScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
			end
		end)
	end

	local rewardToken = 0

	local function showReward(tier, tierIndex: number, color: Color3, amount: number, legendary: boolean)
		rewardToken += 1
		tierLabel.Text = Locale.T(tostring(tier.Name or tier.Id))
		tierLabel.TextColor3 = color
		legendaryName = legendary and color or nil
		rewardStroke.Color = color
		rewardGradient.Color = ColorSequence.new(color:Lerp(WHITE, 0.72), WHITE)
		amountLabel.Text = "+0"
		amountScale.Scale = 1
		for index, star in ipairs(stars) do
			local filled = index <= tierIndex
			star.Label.TextColor3 = filled and GOLD or Color3.fromRGB(205, 205, 215)
			star.Stroke.Color = filled and GOLD_EDGE or Color3.fromRGB(160, 160, 175)
			star.Scale.Scale = 0
		end

		reward.Position = UDim2.fromOffset(cx, chestCY + 4)
		rewardScale.Scale = 0.25
		reward.Visible = true
		UIUtil.Tween(reward, 0.5, { Position = UDim2.fromOffset(cx, REWARD_Y) }, Enum.EasingStyle.Back)
		UIUtil.Tween(rewardScale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)

		-- Étoiles une par une
		task.spawn(function()
			if not waitAlive(0.3) then
				return
			end
			for index, star in ipairs(stars) do
				if not reward.Visible then
					return
				end
				UIUtil.Tween(star.Scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
				if index <= tierIndex then
					ctx.Sound.Play("Pop", 1 + index * 0.12)
				end
				if not waitAlive(0.09) then
					return
				end
			end
		end)
		countUp(amount, legendary and 1.4 or 0.9)
	end

	local function hideReward()
		legendaryName = nil
		local token = rewardToken
		UIUtil.Tween(rewardScale, 0.22, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		task.delay(0.24, function()
			if token == rewardToken and reward.Parent then
				reward.Visible = false
			end
		end)
	end

	-- Petit coup de secousse de toute la carte (légendaire)
	local function jolt()
		task.spawn(function()
			for step = 1, 8 do
				if not ctx.IsAlive() then
					return
				end
				card.Rotation = (step % 2 == 0 and 1 or -1) * (9 - step) * 0.5
				task.wait(0.03)
			end
			if card.Parent then
				card.Rotation = 0
			end
		end)
	end

	local function reveal(result): number
		local tier, tierIndex = findTier(result.Tier)
		local color: Color3 = tier.Color or GOLD
		local amount = tonumber(result.Amount) or 0
		local amountText = "+" .. Format.Format(amount)
		local legendary = tier.Id == "Legendary" or tierIndex >= #tiers

		-- 1) La serrure saute
		shakeAmount = 0
		charge = 1
		ctx.Sound.Play("Chest", 1)
		UIUtil.Tween(lockScale, 0.25, { Scale = 1.9 }, Enum.EasingStyle.Quad)
		fadeLock(1, 0.22)
		UIUtil.Tween(lockGlow, 0.25, { BackgroundTransparency = 1 })
		launchSparks(Vector2.new(cx, chestCY + HINGE_Y + 6 - CHEST_H / 2), GOLD, 5, 20, 45)

		-- 2) Le couvercle bascule, la lumière jaillit
		chestScale.Scale = 1.14
		UIUtil.Tween(chestScale, 0.6, { Scale = 1 }, Enum.EasingStyle.Elastic)
		if not flipLid(true) then
			return 0
		end
		flash.Size = UDim2.fromOffset(20, 20)
		flash.BackgroundTransparency = 0.15
		UIUtil.Tween(flash, 0.45, { Size = UDim2.fromOffset(210, 210), BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
		beam.BackgroundColor3 = color:Lerp(WHITE, 0.25)
		UIUtil.Tween(beam, 0.25, { BackgroundTransparency = 0 })
		mouthGlow.BackgroundColor3 = color:Lerp(WHITE, 0.55)
		UIUtil.Tween(mouthGlow, 0.2, { BackgroundTransparency = 0.1 })
		glowTarget = color
		for _, bar in ipairs(rayBars) do
			bar.BackgroundColor3 = color
		end
		for _, bar in ipairs(bigRayBars) do
			bar.BackgroundColor3 = color:Lerp(WHITE, 0.35)
		end
		bigRaysOn = legendary
		raysTarget = 0.2

		if effectsOn() then
			ctx.Effects.Burst(card, UDim2.fromOffset(cx, chestCY - 12), color, 6 + tierIndex * 4)
		end
		launchSparks(Vector2.new(cx, chestCY - 10), color, SPARK_POOL, 40, 80)

		-- 3) La carte récompense monte
		showReward(tier, tierIndex, color, amount, legendary)
		floatText(Vector2.new(cx, EFFECT_TEXT_Y), amountText, color, legendary and 34 or 26)

		if legendary then
			ctx.Sound.Play("Jackpot", 1)
			ctx.Effects.Flash(color, 0.45)
			ctx.Effects.BigMessage(Locale.T("🏆 %s CHEST! %s", Locale.T(tostring(tier.Name)), amountText), color, 2.8)
			jolt()
			if effectsOn() then
				ctx.Effects.Confetti(90)
			end
		elseif tierIndex >= 3 then
			ctx.Sound.Play("SlotWin", 1.1)
			if effectsOn() then
				ctx.Effects.Confetti(30)
			end
		elseif tierIndex == 2 then
			ctx.Sound.Play("Bonus", 1.2)
		else
			ctx.Sound.Play("Cash", 1)
		end
		return legendary and 3.4 or 2.5
	end

	local function closeChest()
		hideReward()
		raysTarget = 1
		bigRaysOn = false
		charge = 0
		UIUtil.Tween(beam, 0.3, { BackgroundTransparency = 1 })
		UIUtil.Tween(mouthGlow, 0.25, { BackgroundTransparency = 1 })
		if not flipLid(false) then
			return
		end
		ctx.Sound.Play("Bounce", 0.8)
		chestScale.Scale = 0.94
		UIUtil.Tween(chestScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
		-- La serrure revient
		lockScale.Scale = 0.2
		fadeLock(0, 0.15)
		UIUtil.Tween(lockScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	end

	-- Petit "non" : le coffre gigote (UIUtil.Shake serait écrasé par l'animation)
	local function wobble()
		shakeAmount = 7
		task.delay(0.3, function()
			if not opening then
				shakeAmount = 0
			end
		end)
	end

	local function open()
		if opening or not ctx.IsAlive() then
			return
		end
		if stored < 1 then
			ctx.Sound.Play("Error", 1)
			wobble()
			showPillMessage(Locale.T("Not yet!"), 1.4)
			return
		end

		opening = true
		setOdds(false)
		setCallout(false)
		oddsButton.Visible = false
		ctx.Sound.Play("Open", 1)

		task.spawn(function()
			local started = os.clock()
			-- Tremblement de plus en plus fort pendant l'appel serveur
			local shaking = true
			task.spawn(function()
				while shaking and ctx.IsAlive() do
					local t = os.clock() - started
					shakeAmount = math.min(9, 1.5 + t * 9)
					charge = math.min(1, t / MIN_SHAKE_TIME)
					chestScale.Scale = 1 + charge * 0.06 + math.sin(t * 30) * 0.015 * charge
					task.wait()
				end
			end)

			local callOk, success, result = pcall(function()
				return ctx.Net.Function("OpenChest"):InvokeServer()
			end)
			local alive = waitAlive(math.max(0, MIN_SHAKE_TIME - (os.clock() - started)))
			shaking = false
			shakeAmount = 0
			if not alive then
				return
			end

			if callOk and success == true and type(result) == "table" then
				local hold = reveal(result)
				if hold <= 0 or not waitAlive(hold) then
					return
				end
				closeChest()
				if not waitAlive(0.3) then
					return
				end
			else
				local message = (callOk and type(result) == "string") and result or Locale.T("The chest is stuck 🔒")
				charge = 0
				chestScale.Scale = 1
				ctx.Sound.Play("Error", 1)
				wobble()
				ctx.Notify(message, Theme.Colors.Red)
			end

			opening = false
			oddsButton.Visible = true
			refreshStock()
		end)
	end

	ctx.Connect(card.Activated, open)
end

return LootBox
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="137">
          <Properties>
            <string name="Name">MegaFinger</string>
            <string name="Source"><![CDATA[--[[
	MegaFinger (ModuleScript - stimulus) — amélioration "Méga doigt" (10 niveaux)
	Emplacement : ReplicatedStorage > Client > Stimuli > MegaFinger

	Une "tour de force" de fête foraine (placée par Gear/GearLayout) : le palet
	monte d'un cran à chaque clic ; quand il touche la cloche, une MAIN GÉANTE
	descend du haut de l'écran et ÉCRASE le bouton (le bouton s'aplatit, onde
	de choc, poussière, "BAM !"), puis remonte.
	Nombre de clics nécessaires (N, affiché sur la tour) : 40, 34, 28, 24, 20,
	17, 14, 12, 10, 8 (il baisse à chaque niveau).
	La tour change aussi à chaque niveau : bois, rayures de fête foraine,
	acier, ampoules, chrome, or, ampoules arc-en-ciel et cloche en diamant...
	et la main géante grossit, avec plus d'ondes de choc.
	Tout est réutilisé (main géante, anneaux, poussière) ; rien au repos, sauf
	un reflet sur la cloche de temps en temps.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Locale = require(ReplicatedStorage.Shared.Locale)
local Gear = script.Parent:WaitForChild("Gear")
local GearKit = require(Gear:WaitForChild("GearKit"))
local GearPiece = require(Gear:WaitForChild("GearPiece"))
local HandArt = require(Gear:WaitForChild("HandArt"))

local MegaFinger = {}
MegaFinger.Slot = "Background" -- sous l'interface (main géante et effets : calque Overlay)

local W, H = 60, 136
local INK = Color3.fromRGB(56, 36, 50)
local CLICKS = { 40, 34, 28, 24, 20, 17, 14, 12, 10, 8 }
local RAIL_TOP, RAIL_BOTTOM = 30, 110 -- course du palet (y du centre)

local active: { [any]: any } = {}
local smashers: { [any]: () -> () } = {}
local cleanups: { [any]: () -> () } = {}

local function clicksFor(level: number): number
	return CLICKS[math.clamp(level, 1, #CLICKS)]
end

-- Couleurs de la tour selon le niveau
local function towerStyle(level: number)
	if level >= 9 then
		return { Pole = Color3.fromRGB(255, 206, 70), Base = Color3.fromRGB(230, 160, 40), Bulbs = true, Rainbow = level >= 10 }
	elseif level >= 7 then
		return { Pole = Color3.fromRGB(214, 222, 236), Base = Color3.fromRGB(150, 160, 180), Bulbs = true }
	elseif level >= 5 then
		return { Pole = Color3.fromRGB(176, 186, 204), Base = Color3.fromRGB(110, 118, 136), Bulbs = level >= 6 }
	elseif level >= 3 then
		return { Pole = Color3.fromRGB(255, 255, 255), Base = Color3.fromRGB(220, 60, 70), Stripes = true, Bulbs = level >= 4 }
	end
	return { Pole = Color3.fromRGB(214, 160, 104), Base = Color3.fromRGB(160, 104, 60), Wood = true, Bulbs = level >= 2 }
end

function MegaFinger.Start(ctx)
	local animator = GearKit.Animator(ctx)
	local random = ctx.Random
	local piece = GearPiece.new(ctx, {
		Id = "MegaFinger",
		Size = Vector2.new(W, H),
		Priority = 2,
		MinScale = 0.42,
		MaxScale = 1,
		GlowColor = Color3.fromRGB(255, 226, 190),
		ContainerZ = 1103,
		Anchor = function(button, _canvas)
			-- À droite du bouton (après le bouton 🏠)
			return Vector2.new(button.X1 + 110, (button.Y0 + button.Y1) / 2 + 40)
		end,
	}, animator)
	active[ctx] = piece

	local count = 0
	local smashing = false
	local art: Frame? = nil
	local puck: Frame? = nil
	local bell: Frame? = nil
	local counter: TextLabel? = nil
	local bulbs: { Frame } = {}

	------------------------------------------------------------------
	-- La tour
	------------------------------------------------------------------

	local function puckY(value: number, total: number): number
		return RAIL_BOTTOM - (RAIL_BOTTOM - RAIL_TOP) * math.clamp(value / total, 0, 1)
	end

	local function build(level: number)
		animator:Stop("puck", true)
		animator:Stop("bell", true)
		if art then
			art:Destroy()
		end
		table.clear(bulbs)
		local style = towerStyle(level)
		local total = clicksFor(level)
		local root = Instance.new("Frame")
		root.Name = "Art"
		root.BackgroundTransparency = 1
		root.Size = UDim2.fromOffset(W, H)
		root.ZIndex = 2

		-- Socle + cible
		GearKit.Outlined(root, 6, 118, 48, 16, style.Base, {
			Name = "Base",
			Radius = 5,
			Outline = 2.2,
			OutlineColor = INK,
			Z = 4,
			LineZ = 1,
			Gradient = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(200, 190, 190)),
		})
		GearKit.Outlined(root, 16, 113, 28, 7, Color3.fromRGB(235, 60, 70), { Name = "Pad", Radius = 3, Outline = 2, OutlineColor = INK, Z = 5, LineZ = 1 })
		GearKit.Box(root, 20, 114, 20, 2, Color3.new(1, 1, 1), { Name = "PadShine", Radius = "round", Transparency = 0.4, Z = 6 })

		-- Mât
		local pole = GearKit.Outlined(root, 21, 22, 18, 94, style.Pole, {
			Name = "Pole",
			Radius = 5,
			Outline = 2.2,
			OutlineColor = INK,
			Z = 3,
			LineZ = 1,
			Gradient = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(215, 205, 205)),
			GradientRotation = 0,
		})
		if style.Stripes then
			for index = 0, 5 do
				GearKit.Box(pole, 0, 6 + index * 15, 18, 6, Color3.fromRGB(235, 60, 70), { Name = "Stripe", Z = 4 })
			end
		elseif style.Wood then
			for index = 0, 2 do
				GearKit.Box(pole, 4 + index * 5, 4, 1.2, 86, Color3.fromRGB(150, 96, 56), { Name = "Grain", Transparency = 0.5, Z = 4 })
			end
		end
		-- Graduations (une par clic, au plus 12)
		local marks = math.min(total, 12)
		for index = 1, marks - 1 do
			local y = RAIL_BOTTOM - (RAIL_BOTTOM - RAIL_TOP) * index / marks
			GearKit.Box(root, 23, y - 0.8, index % 3 == 0 and 9 or 6, 1.6, INK, { Name = "Mark", Transparency = 0.25, Z = 5 })
		end
		-- Rail du palet
		GearKit.Box(root, 29, 26, 2, 88, INK, { Name = "Rail", Transparency = 0.35, Z = 5 })

		-- Ampoules sur les côtés
		if style.Bulbs then
			for index = 0, 5 do
				for side = 0, 1 do
					local color = style.Rainbow and GearKit.Rainbow(index / 6 + side * 0.08, 0.6, 1) or Color3.fromRGB(255, 236, 140)
					local bulb = GearKit.Box(root, side == 0 and 16 or 44, 34 + index * 14, 5, 5, color, {
						Name = "Bulb",
						Anchor = Vector2.new(0.5, 0.5),
						Radius = "round",
						Z = 6,
					})
					table.insert(bulbs, bulb)
				end
			end
		end

		-- Cloche
		local bellFrame = Instance.new("Frame")
		bellFrame.Name = "BellHolder"
		bellFrame.BackgroundTransparency = 1
		bellFrame.AnchorPoint = Vector2.new(0.5, 0.5)
		bellFrame.Position = UDim2.fromOffset(30, 14)
		bellFrame.Size = UDim2.fromOffset(30, 26)
		bellFrame.ZIndex = 7
		local bellColor = level >= 10 and Color3.fromRGB(190, 245, 255) or Color3.fromRGB(255, 200, 50)
		local dome = GearKit.Outlined(bellFrame, 3, 1, 24, 22, bellColor, {
			Name = "Bell",
			Radius = 11,
			Outline = 2,
			OutlineColor = INK,
			Z = 3,
			LineZ = 1,
			Gradient = ColorSequence.new(Color3.new(1, 1, 1), level >= 10 and Color3.fromRGB(150, 200, 255) or Color3.fromRGB(230, 140, 30)),
		})
		GearKit.Outlined(bellFrame, 0, 19, 30, 6, bellColor:Lerp(Color3.new(0, 0, 0), 0.12), { Name = "Rim", Radius = 3, Outline = 2, OutlineColor = INK, Z = 4, LineZ = 1 })
		GearKit.Shine(dome, 5, 4, 5, 9, 0.3, 5, -15)
		bellFrame.Parent = root

		-- Palet
		local puckFrame = GearKit.Outlined(root, 17, 0, 26, 9, Color3.fromRGB(255, 90, 150), {
			Name = "Puck",
			Radius = "round",
			Outline = 2,
			OutlineColor = INK,
			Z = 9,
			LineZ = 8,
			Gradient = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(220, 120, 160)),
		})
		GearKit.Shine(puckFrame, 4, 1.5, 9, 2.5, 0.35, 10)
		local puckLine = root:FindFirstChild("PuckLine") :: Frame?
		puck = puckFrame

		-- Compteur de clics restants (pastille)
		local badge = GearKit.Outlined(root, 42, 2, 18, 18, Color3.fromRGB(45, 40, 62), { Name = "Badge", Radius = "round", Outline = 1.6, OutlineColor = Color3.new(1, 1, 1), Z = 12, LineZ = 11 })
		local label = Instance.new("TextLabel")
		label.Name = "Count"
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = ctx.Theme.Fonts.Title
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextSize = 11
		label.ZIndex = 13
		label.Parent = badge
		counter = label

		root.Parent = piece.Content
		art = root
		bell = bellFrame

		-- Place du palet
		local y = puckY(count, total)
		puckFrame.Position = UDim2.fromOffset(17, y - 4.5)
		if puckLine then
			puckLine.Position = UDim2.fromOffset(15, y - 6.5)
		end
		label.Text = tostring(math.max(0, total - count))
	end
	build(math.max(1, piece.Level))

	local function movePuck(to: number, duration: number)
		local frame = puck
		if not frame or not art then
			return
		end
		local line = (art :: Frame):FindFirstChild("PuckLine") :: Frame?
		local from = frame.Position.Y.Offset + 4.5
		animator:Play("puck", duration, function(t)
			local y = from + (to - from) * GearKit.Ease.OutBack(t)
			frame.Position = UDim2.fromOffset(17, y - 4.5)
			if line then
				line.Position = UDim2.fromOffset(15, y - 6.5)
			end
		end)
	end

	local function ringBell()
		local holder = bell
		if not holder then
			return
		end
		local list = bulbs
		animator:Play("bell", 0.6, function(t)
			holder.Rotation = math.sin(t * math.pi * 6) * 18 * (1 - t)
			for index, bulb in ipairs(list) do
				local on = math.floor(t * 12 + index) % 2 == 0
				bulb.BackgroundTransparency = on and 0 or 0.6
			end
		end, function()
			holder.Rotation = 0
			for _, bulb in ipairs(list) do
				bulb.BackgroundTransparency = 0
			end
		end)
	end

	------------------------------------------------------------------
	-- La main géante (réutilisée) + effets de l'écrasement
	------------------------------------------------------------------

	local giant = Instance.new("Frame")
	giant.Name = "GiantHand"
	giant.BackgroundTransparency = 1
	giant.AnchorPoint = Vector2.new(0.5, 0.5)
	giant.Size = UDim2.fromOffset(HandArt.Size, HandArt.Size)
	giant.Rotation = 180
	giant.ZIndex = 40
	giant.Visible = false
	local giantScale = Instance.new("UIScale")
	giantScale.Scale = 2.6
	giantScale.Parent = giant
	local giantHand = HandArt.Build(giant, { Style = "Giant", Level = 15 })
	if giantHand.Face then
		giantHand.Face.Rotation = 180 -- visage à l'endroit
	end
	-- Traits de vitesse au-dessus de la main
	local giantLines = {}
	for index = 1, 4 do
		local line = GearKit.Box(giant, 18 + index * 16, 100, 3, 34, Color3.new(1, 1, 1), {
			Name = "Speed",
			Radius = "round",
			Z = 0,
			Transparency = 0.3,
		})
		table.insert(giantLines, line)
	end
	giant.Parent = piece.FX

	local function shockRing(index: number)
		local ring = Instance.new("Frame")
		ring.Name = "Shock" .. index
		ring.AnchorPoint = Vector2.new(0.5, 0.5)
		ring.BackgroundTransparency = 1
		ring.ZIndex = 38
		ring.Visible = false
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = ring
		local stroke = Instance.new("UIStroke")
		stroke.Name = "Stroke"
		stroke.Thickness = 4
		stroke.Color = Color3.fromRGB(255, 220, 90)
		stroke.Parent = ring
		ring.Parent = piece.FX
		return ring
	end
	local rings = { shockRing(1), shockRing(2), shockRing(3) }
	local dust = GearKit.Pool(6, function()
		local puff = GearKit.Box(piece.FX, 0, 0, 16, 16, Color3.fromRGB(240, 236, 250), {
			Name = "Dust",
			Anchor = Vector2.new(0.5, 0.5),
			Radius = "round",
			Z = 37,
			Visible = false,
		})
		return puff
	end)

	-- "BAM !" : étoile à 8 branches + texte
	local burst = Instance.new("Frame")
	burst.Name = "Burst"
	burst.AnchorPoint = Vector2.new(0.5, 0.5)
	burst.BackgroundTransparency = 1
	burst.Size = UDim2.fromOffset(84, 84)
	burst.ZIndex = 42
	burst.Visible = false
	for index = 0, 1 do
		GearKit.Box(burst, 42, 42, 60, 60, Color3.fromRGB(255, 215, 50), {
			Name = "Spike",
			Anchor = Vector2.new(0.5, 0.5),
			Rotation = index * 45,
			Radius = 6,
			Z = 42,
			Gradient = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(255, 150, 40)),
		})
	end
	local burstLabel = Instance.new("TextLabel")
	burstLabel.Name = "Text"
	burstLabel.BackgroundTransparency = 1
	burstLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	burstLabel.Position = UDim2.fromScale(0.5, 0.5)
	burstLabel.Size = UDim2.fromOffset(84, 30)
	burstLabel.Font = ctx.Theme.Fonts.Title
	burstLabel.Text = Locale.T("BAM!")
	burstLabel.TextSize = 22
	burstLabel.TextColor3 = Color3.fromRGB(235, 40, 60)
	burstLabel.Rotation = -8
	burstLabel.ZIndex = 44
	local burstStroke = Instance.new("UIStroke")
	burstStroke.Color = Color3.new(1, 1, 1)
	burstStroke.Thickness = 2
	burstStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	burstStroke.Parent = burstLabel
	burstLabel.Parent = burst
	local burstScale = Instance.new("UIScale")
	burstScale.Parent = burst
	burst.Parent = piece.FX

	-- Écrasement du bouton : UNE animation (Tween) réutilisée, comme le "squish"
	-- de la colonne centrale (le bouton garde sa taille de repos 1 x 1)
	local squashTween: Tween? = nil
	local squashButton: GuiObject? = nil
	local function squashButtonNow(strength: number)
		local button = GearKit.GetButton()
		if not button then
			return
		end
		local size = button.Size
		-- Seulement si le bouton a sa taille "relative" habituelle (sinon on n'y touche pas)
		if size.X.Offset ~= 0 or size.Y.Offset ~= 0 or size.X.Scale < 0.5 or size.X.Scale > 1.3 then
			return
		end
		if squashButton ~= button or not squashTween then
			squashButton = button
			squashTween = TweenService:Create(
				button,
				TweenInfo.new(0.55, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out),
				{ Size = UDim2.fromScale(1, 1) }
			)
		end
		button.Size = UDim2.fromScale(1 + 0.22 * strength, 1 - 0.34 * strength)
		local tween = squashTween
		if tween then
			tween:Play()
		end
	end

	-- Arrêt (océan...) pendant un écrasement : le bouton retrouve sa taille de repos
	cleanups[ctx] = function()
		local tween = squashTween
		squashTween = nil
		if tween then
			tween:Cancel()
			tween:Destroy()
		end
		local button = squashButton
		squashButton = nil
		if button and button.Parent then
			local size = button.Size
			if size.X.Offset == 0 and size.Y.Offset == 0 and (size.X.Scale ~= 1 or size.Y.Scale ~= 1) then
				button.Size = UDim2.fromScale(1, 1)
			end
		end
	end

	local function smash(level: number)
		local button = GearKit.GetButtonRect()
		if not button then
			smashing = false
			return
		end
		smashing = true
		local effects = GearKit.EffectsOn(ctx)
		local cx = (button.X0 + button.X1) / 2
		local top = button.Y0
		local bw = button.X1 - button.X0
		local scale = 2.3 + level * 0.09 -- la main grossit avec le niveau
		giantScale.Scale = scale
		local tip = (HandArt.Size / 2 - HandArt.TipY) * scale
		local hitY = top - tip + 7 -- le bout du doigt enfonce un peu le bouton
		local startY = -HandArt.Size * scale * 0.6
		local ringCount = level >= 8 and 3 or (level >= 4 and 2 or 1)
		local impactDone = false

		giant.Visible = true
		giant.Position = UDim2.fromOffset(cx, startY)
		for _, line in ipairs(giantLines) do
			line.Visible = effects
		end

		local function impact()
			impactDone = true
			squashButtonNow(math.clamp(0.7 + level * 0.03, 0.7, 1))
			if not effects then
				return
			end
			-- Ondes de choc (ovales aplatis)
			for index = 1, ringCount do
				local ring = rings[index]
				local stroke = ring:FindFirstChild("Stroke") :: UIStroke
				local delay = (index - 1) * 0.08
				stroke.Color = level >= 10 and GearKit.Rainbow(index / 3, 0.7, 1) or Color3.fromRGB(255, 220, 90)
				animator:Play(ring, 0.55 + delay, function(t)
					local k = math.clamp((t * (0.55 + delay) - delay) / 0.55, 0, 1)
					ring.Visible = k > 0 and k < 1
					local e = GearKit.Ease.OutCubic(k)
					local w = bw * (0.9 + 1.5 * e)
					ring.Position = UDim2.fromOffset(cx, (button.Y0 + button.Y1) / 2 + 4)
					ring.Size = UDim2.fromOffset(w, w * 0.34)
					stroke.Transparency = 0.05 + 0.95 * k
					stroke.Thickness = 5 - 3.5 * k
				end, function()
					ring.Visible = false
				end)
			end
			-- Poussière sur les côtés du bouton
			for index = 1, 6 do
				local puff = dust:Next()
				local side = index <= 3 and -1 or 1
				local sx = side < 0 and button.X0 + 8 or button.X1 - 8
				local sy = button.Y1 - 2
				local vx = side * random:NextNumber(26, 60)
				local vy = -random:NextNumber(4, 22)
				local size = random:NextNumber(10, 18)
				animator:Play(puff, 0.6, function(t)
					puff.Visible = t < 1
					local e = GearKit.Ease.OutCubic(t)
					puff.Position = UDim2.fromOffset(sx + vx * e, sy + vy * e)
					local s = size * (0.6 + 0.8 * e)
					puff.Size = UDim2.fromOffset(s, s)
					puff.BackgroundTransparency = 0.15 + 0.85 * t
				end, function()
					puff.Visible = false
				end)
			end
			-- "BAM !"
			local bx = math.min(button.X1 + 26, GearKit.CanvasSize().X - 50)
			burst.Position = UDim2.fromOffset(bx, button.Y0 - 6)
			animator:Play(burst, 0.75, function(t)
				burst.Visible = t < 1
				burstScale.Scale = (0.4 + 0.75 * GearKit.Ease.OutBack(math.min(1, t * 3))) * (level >= 6 and 1.15 or 1)
				burst.Rotation = -6 + 12 * t
				local fade = math.max(0, (t - 0.65) / 0.35)
				burstLabel.TextTransparency = fade
				burstStroke.Transparency = fade
				for _, spike in ipairs(burst:GetChildren()) do
					if spike:IsA("Frame") then
						spike.BackgroundTransparency = fade
					end
				end
			end, function()
				burst.Visible = false
			end)
		end

		-- Descente (0 -> 0.2), appui (0.2 -> 0.45), remontée (0.45 -> 1)
		animator:Play(giant, 1.0, function(t)
			local y
			if t < 0.2 then
				y = startY + (hitY - startY) * GearKit.Ease.InQuad(t / 0.2)
			elseif t < 0.45 then
				if not impactDone then
					impact()
				end
				y = hitY + math.sin((t - 0.2) / 0.25 * math.pi) * 3
			else
				y = hitY + (startY - hitY) * GearKit.Ease.InQuad((t - 0.45) / 0.55)
			end
			giant.Position = UDim2.fromOffset(cx + (t < 0.45 and math.sin(t * 90) * (t > 0.2 and 2 or 0) or 0), y)
			for _, line in ipairs(giantLines) do
				line.BackgroundTransparency = t < 0.2 and 0.3 or 1
			end
			giantHand.ArtScale.Scale = 1
		end, function()
			giant.Visible = false
			smashing = false
		end)
	end

	------------------------------------------------------------------
	-- Clics
	------------------------------------------------------------------

	local function onClick()
		if not piece:IsShown() then
			return
		end
		local level = math.max(1, piece.Level)
		local total = clicksFor(level)
		if smashing then
			return -- (le palet attend que la main soit remontée)
		end
		count += 1
		local label = counter
		if count >= total then
			count = 0
			smashing = true
			movePuck(RAIL_TOP - 8, 0.12)
			ringBell()
			if label then
				label.Text = "0"
			end
			task.delay(0.12, function()
				if ctx.IsAlive() then
					smash(level)
					movePuck(puckY(0, total), 0.5)
					if counter then
						counter.Text = tostring(total)
					end
				end
			end)
		else
			movePuck(puckY(count, total), 0.2)
			if label then
				label.Text = tostring(total - count)
			end
		end
	end

	ctx.Connect(ctx.State.Clicked, function()
		if ctx.IsVisible() then
			onClick()
		end
	end)

	piece.OnLevel = function(level, _previous)
		count = math.min(count, clicksFor(level) - 1)
		build(level)
	end

	-- Au repos : les ampoules clignotent / la cloche brille de temps en temps
	GearKit.Every(ctx, 6, 10, function()
		if piece:IsShown() and not smashing then
			local holder = bell
			if holder then
				animator:Play("bell", 0.5, function(t)
					holder.Rotation = math.sin(t * math.pi * 4) * 6 * (1 - t)
				end, function()
					holder.Rotation = 0
				end)
			end
		end
	end)

	-- (debug / aperçu) : déclenche l'écrasement tout de suite
	smashers[ctx] = function()
		if not smashing then
			smash(math.max(1, piece.Level))
		end
	end
end

function MegaFinger.Stop(ctx)
	local piece = active[ctx]
	active[ctx] = nil
	smashers[ctx] = nil
	local cleanup = cleanups[ctx]
	cleanups[ctx] = nil
	if cleanup then
		cleanup()
	end
	if piece then
		piece:Destroy()
	end
end

-- (debug) écrasement immédiat pour tous les MegaFinger actifs
function MegaFinger.DebugSmash()
	for _, smash in pairs(smashers) do
		smash()
	end
end

return MegaFinger
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="138">
          <Properties>
            <string name="Name">Megaphone</string>
            <string name="Source"><![CDATA[--[[
	Megaphone (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > Megaphone

	Toutes les 4 à 9 secondes, un GROS mot d'encouragement est "crié" à
	l'écran ("INCROYABLE !!!", "LET'S GO"...) : il arrive en s'écrasant,
	tremble, laisse un écho et une onde de choc, puis s'envole.
	Crie aussi quand il se passe quelque chose de spécial (jackpot, rush,
	succès). Purement visuel : aucune récompense, aucun appel serveur.
]]

local Locale = require(game:GetService("ReplicatedStorage").Shared.Locale)

local Megaphone = {}
Megaphone.Slot = "Overlay"

local MAX_ACTIVE = 2

local WORDS = {
	en = {
		"INCREDIBLE!!!", "WOW", "HUGE", "LET'S GO", "MAGNIFICENT", "WHAT A CLICK!", "LEGENDARY",
		"PHENOMENAL", "YES YES YES", "INSANE", "SO GOOD", "MONSTROUS", "UNSTOPPABLE",
		"DOPAMINE!!!", "COME ON COME ON", "BRAVO CHAMP", "IMPRESSIVE", "WHOA", "BELIEVE IT",
		"RECORD?!", "EXTRAORDINARY", "MADNESS", "FASTER!", "MORE!!!", "GIGANTIC",
		"SPECTACULAR", "HISTORIC", "CLICKING HARD", "OH MY", "SENSATIONAL", "WHAT TALENT",
		"CLICK CLICK", "YOU'RE ON FIRE", "UN-BE-LIEV-ABLE", "NOBODY SAW THIS COMING",
	},
	fr = {
		"INCROYABLE !!!", "WOW", "ÉNORME", "LET'S GO", "MAGNIFIQUE", "QUEL CLIC !", "LÉGENDAIRE",
		"PHÉNOMÉNAL", "OUI OUI OUI", "C'EST FOU", "TROP FORT", "MONSTRUEUX", "INARRÊTABLE",
		"DOPAMINE !!!", "ALLEZ ALLEZ", "BRAVO CHAMPION", "IMPRESSIONNANT", "WAOUH", "ON Y CROIT",
		"RECORD ?!", "EXTRAORDINAIRE", "LA FOLIE", "PLUS VITE !", "ENCORE !!!", "GIGANTESQUE",
		"SPECTACULAIRE", "HISTORIQUE", "ÇA CLIQUE SEC", "OH LÀ LÀ", "SENSATIONNEL", "QUEL TALENT",
		"CLIQUE CLIQUE", "TU ES EN FEU", "IN-CRO-YABLE", "PERSONNE N'Y CROYAIT",
	},
}

-- Petits commentaires (parfois) sous le mot crié
local ASIDES = {
	en = {
		"(the neighbors heard that)", "(sorry about the noise)", "(your cat woke up)",
		"(volume at max)", "(this is the megaphone talking)", "(even your plant is proud)",
		"(we don't know why we're yelling)", "(batteries almost dead)", "(they heard it in Alaska)",
	},
	fr = {
		"(le voisin a entendu)", "(pardon pour le bruit)", "(ton chat s'est réveillé)",
		"(volume au maximum)", "(c'est le mégaphone qui parle)", "(même ta plante est fière)",
		"(on ne sait pas pourquoi on crie)", "(les piles sont presque vides)", "(ça résonne jusqu'à Brest)",
	},
}

-- Dégradés "hype" (haut -> bas)
local PALETTES = {
	{ Color3.fromRGB(255, 236, 70), Color3.fromRGB(255, 120, 20) },
	{ Color3.fromRGB(255, 120, 200), Color3.fromRGB(157, 60, 230) },
	{ Color3.fromRGB(120, 245, 255), Color3.fromRGB(30, 110, 240) },
	{ Color3.fromRGB(150, 255, 120), Color3.fromRGB(20, 170, 70) },
	{ Color3.fromRGB(255, 150, 120), Color3.fromRGB(230, 30, 60) },
}

function Megaphone.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local container: Frame = ctx.Container
	local random = Random.new()
	local active = 0
	local lastSpecial = 0

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	------------------------------------------------------------------
	-- v8 : MAX_ACTIVE "rigs" construits une fois et réutilisés (avant :
	-- ~12 instances créées puis détruites à chaque cri). Nouveau : éclat
	-- de rayons derrière le mot, onde de choc double, texte en relief.
	------------------------------------------------------------------
	local function buildRig()
		local holder = UIUtil.Create("Frame", {
			Name = "Shout",
			Size = UDim2.fromOffset(620, 120),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			Visible = false,
			ZIndex = 30,
			Parent = container,
		})
		local holderScale = UIUtil.Create("UIScale", { Scale = 1, Parent = holder })
		-- Éclat de rayons (derrière le mot)
		local burst = UIUtil.Rays(holder, Color3.new(1, 1, 1), 8, 300, UDim2.fromScale(0.5, 0.5), 29)
		burst.Name = "Burst"
		local burstScale = UIUtil.Create("UIScale", { Scale = 0, Parent = burst })
		local burstBars = {}
		for _, bar in ipairs(burst:GetChildren()) do
			if bar:IsA("Frame") then
				table.insert(burstBars, bar)
			end
		end
		-- Ondes de choc (dans le conteneur : elles débordent du mot)
		local rings = {}
		for index = 1, 2 do
			local ring = UIUtil.Create("Frame", {
				Name = "Shockwave",
				Size = UDim2.fromOffset(80, 80),
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundTransparency = 1,
				Visible = false,
				ZIndex = 29,
				Parent = container,
			})
			UIUtil.Corner(ring, UDim.new(1, 0))
			rings[index] = { Frame = ring, Stroke = UIUtil.Stroke(ring, Color3.new(1, 1, 1), 8, 1) }
		end
		local icon = UIUtil.Label({
			Text = "📢",
			Size = UDim2.fromOffset(84, 84),
			AnchorPoint = Vector2.new(1, 0.5),
			TextTransparency = 1,
			MaxTextSize = 80,
			ZIndex = 31,
			Parent = holder,
		})
		-- Ombre portée du mot (relief)
		local shadow = UIUtil.Label({
			Name = "Shadow",
			Text = "",
			Font = Enum.Font.LuckiestGuy,
			TextColor3 = Theme.Colors.TextDark,
			TextTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Position = UDim2.fromOffset(4, 6),
			MaxTextSize = 96,
			ZIndex = 31,
			Parent = holder,
		})
		local label = UIUtil.Label({
			Text = "",
			Font = Enum.Font.LuckiestGuy,
			TextColor3 = Color3.new(1, 1, 1),
			TextTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			MaxTextSize = 96,
			ZIndex = 32,
			Parent = holder,
		})
		local gradient = UIUtil.Gradient(label, ColorSequence.new(Color3.new(1, 1, 1), Color3.new(1, 1, 1)), 90)
		local stroke = UIUtil.Stroke(label, Theme.Colors.TextDark, 5, 1)
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		stroke.LineJoinMode = Enum.LineJoinMode.Round
		-- Écho (copie fantôme qui s'agrandit)
		local echo = UIUtil.Label({
			Text = "",
			Font = Enum.Font.LuckiestGuy,
			TextTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			MaxTextSize = 96,
			ZIndex = 31,
			Parent = holder,
		})
		local echoScale = UIUtil.Create("UIScale", { Parent = echo })
		-- Petit commentaire en dessous
		local aside = UIUtil.Label({
			Text = "",
			Font = Theme.Fonts.Body,
			TextColor3 = Theme.Colors.TextDark,
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 1,
			TextTransparency = 1,
			Size = UDim2.fromOffset(330, 28),
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 1, 2),
			MaxTextSize = 20,
			Visible = false,
			ZIndex = 33,
			Parent = holder,
		})
		UIUtil.Corner(aside, UDim.new(1, 0))
		return {
			Holder = holder,
			Scale = holderScale,
			Burst = burst,
			BurstScale = burstScale,
			BurstBars = burstBars,
			Rings = rings,
			Icon = icon,
			Shadow = shadow,
			Label = label,
			Gradient = gradient,
			Stroke = stroke,
			Echo = echo,
			EchoScale = echoScale,
			Aside = aside,
			Busy = false,
		}
	end

	local rigs = {}
	for index = 1, MAX_ACTIVE do
		rigs[index] = buildRig()
	end

	-- Crie un mot à l'écran
	local function shout(word: string, palette: { Color3 }?, withAside: boolean?)
		if not ctx.IsAlive() or active >= MAX_ACTIVE then
			return
		end
		local rig
		for _, candidate in ipairs(rigs) do
			if not candidate.Busy then
				rig = candidate
				break
			end
		end
		if not rig then
			return
		end
		rig.Busy = true
		active += 1
		-- Plus petit sur téléphone / tablette (la toile y est plus petite)
		local device = ctx.Interface and ctx.Interface.Device or "Desktop"
		local k = device == "Phone" and 0.72 or (device == "Tablet" and 0.88 or 1)
		local colors = palette or PALETTES[random:NextInteger(1, #PALETTES)]
		local effects = effectsOn()

		-- Position au hasard autour du centre (évite les bords)
		local position = UDim2.fromScale(random:NextNumber(0.3, 0.7), random:NextNumber(0.22, 0.7))
		local holder = rig.Holder
		holder.Position = position
		holder.Rotation = random:NextNumber(-9, 9)
		holder.Visible = true
		rig.Scale.Scale = 2.6 * k
		rig.Label.Text = word
		rig.Shadow.Text = word
		rig.Echo.Text = word
		rig.Label.TextTransparency = 1
		rig.Shadow.TextTransparency = 1
		rig.Stroke.Transparency = 1
		rig.Gradient.Color = ColorSequence.new(colors[1], colors[2])
		rig.Echo.TextColor3 = colors[2]
		rig.Echo.TextTransparency = 1
		rig.EchoScale.Scale = 1
		rig.Icon.TextTransparency = 1
		rig.Icon.Position = UDim2.new(0, -80, 0.5, 0)
		rig.Icon.Rotation = -20
		for _, bar in ipairs(rig.BurstBars) do
			bar.BackgroundColor3 = colors[1]:Lerp(Color3.new(1, 1, 1), 0.35)
		end
		rig.BurstScale.Scale = 0
		rig.Burst.Rotation = random:NextNumber(0, 45)
		rig.Burst.Visible = effects

		-- Ondes de choc (anneaux qui s'agrandissent)
		if effects then
			for index, ring in ipairs(rig.Rings) do
				local frame, ringStroke = ring.Frame, ring.Stroke
				frame.Position = position
				frame.Size = UDim2.fromOffset(80, 80)
				frame.Visible = true
				ringStroke.Color = index == 1 and colors[2] or colors[1]
				ringStroke.Thickness = index == 1 and 8 or 4
				ringStroke.Transparency = 1
				task.delay(0.1 + (index - 1) * 0.12, function()
					if frame.Parent then
						ringStroke.Transparency = index == 1 and 0.1 or 0.3
						UIUtil.Tween(frame, 0.55, { Size = UDim2.fromOffset(620 * k, 620 * k) }, Enum.EasingStyle.Quart)
						UIUtil.Tween(ringStroke, 0.55, { Transparency = 1, Thickness = 1 }, Enum.EasingStyle.Quart)
					end
				end)
			end
		end

		-- Petit commentaire en dessous
		local aside: TextLabel? = nil
		if withAside ~= false and random:NextNumber() < 0.4 then
			local asides = Locale.Pick(ASIDES)
			rig.Aside.Text = asides[random:NextInteger(1, #asides)]
			rig.Aside.TextTransparency = 1
			rig.Aside.BackgroundTransparency = 1
			rig.Aside.Visible = true
			aside = rig.Aside
		else
			rig.Aside.Visible = false
		end

		ctx.Sound.Play("Megaphone", random:NextNumber(0.85, 1.15))

		-- 1) Écrasement à l'arrivée
		local holderScale, label, stroke, icon = rig.Scale, rig.Label, rig.Stroke, rig.Icon
		UIUtil.Tween(holderScale, 0.18, { Scale = k }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		UIUtil.Tween(label, 0.12, { TextTransparency = 0 })
		UIUtil.Tween(rig.Shadow, 0.12, { TextTransparency = 0.55 })
		UIUtil.Tween(stroke, 0.12, { Transparency = 0 })
		UIUtil.Tween(icon, 0.25, { TextTransparency = 0, Position = UDim2.new(0, -6, 0.5, 0), Rotation = 12 }, Enum.EasingStyle.Back)
		if effects then
			UIUtil.Tween(rig.BurstScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
			UIUtil.Tween(rig.Burst, 1.6, { Rotation = rig.Burst.Rotation + 40 }, Enum.EasingStyle.Linear)
		end

		task.spawn(function()
			task.wait(0.18)
			if not holder.Parent or not ctx.IsAlive() then
				active -= 1
				rig.Busy = false
				return
			end

			-- Écho
			if effects then
				rig.Echo.TextTransparency = 0.45
				UIUtil.Tween(rig.EchoScale, 0.5, { Scale = 1.5 })
				UIUtil.Tween(rig.Echo, 0.5, { TextTransparency = 1 })
			end

			if aside then
				UIUtil.Tween(aside, 0.2, { TextTransparency = 0, BackgroundTransparency = 0.1 })
			end

			-- 2) Tremblement
			local base = position
			for i = 1, 8 do
				if not holder.Parent then
					break
				end
				local strength = (9 - i) * 1.6
				holder.Position = base + UDim2.fromOffset(random:NextNumber(-strength, strength), random:NextNumber(-strength, strength))
				task.wait(0.03)
			end
			if holder.Parent then
				holder.Position = base
				-- 3) Respiration
				UIUtil.Tween(holderScale, 0.6, { Scale = 1.07 * k }, Enum.EasingStyle.Sine)
				UIUtil.Tween(icon, 0.6, { Rotation = -6 }, Enum.EasingStyle.Sine)
				task.wait(0.65)
			end

			-- 4) S'envole en disparaissant
			if holder.Parent then
				UIUtil.Tween(holder, 0.4, { Position = base - UDim2.fromOffset(0, 40) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				UIUtil.Tween(holderScale, 0.4, { Scale = 0.85 * k })
				UIUtil.Tween(label, 0.35, { TextTransparency = 1 })
				UIUtil.Tween(rig.Shadow, 0.35, { TextTransparency = 1 })
				UIUtil.Tween(stroke, 0.35, { Transparency = 1 })
				UIUtil.Tween(icon, 0.35, { TextTransparency = 1 })
				UIUtil.Tween(rig.BurstScale, 0.3, { Scale = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				if aside then
					UIUtil.Tween(aside, 0.3, { TextTransparency = 1, BackgroundTransparency = 1 })
				end
				task.wait(0.45)
				if holder.Parent then
					holder.Visible = false
					for _, ring in ipairs(rig.Rings) do
						ring.Frame.Visible = false
					end
				end
			end
			active -= 1
			rig.Busy = false
		end)
	end

	-- Cri périodique
	task.spawn(function()
		task.wait(random:NextNumber(1.5, 3))
		while ctx.IsAlive() do
			-- (pas de cri quand une fenêtre est ouverte par-dessus)
			if ctx.GetVisibility == nil or ctx.GetVisibility() == "Visible" then
				local words = Locale.Pick(WORDS)
				shout(words[random:NextInteger(1, #words)])
			end
			task.wait(random:NextNumber(4, 9))
		end
	end)

	-- Cris spéciaux quand il se passe quelque chose (texte anglais traduit au moment du cri)
	local specials = {
		Jackpot = { "JACKPOT!!!", PALETTES[1] },
		Rush = { "IT'S RUSH TIME!!!", PALETTES[5] },
		Achievement = { "ACHIEVEMENT!!!", PALETTES[4] },
		Unlock = { "NEW STUFF!", PALETTES[2] },
	}
	if ctx.State.NotifyReceived then
		ctx.Connect(ctx.State.NotifyReceived, function(payload)
			if type(payload) ~= "table" then
				return
			end
			local special = specials[payload.Type]
			if not special then
				return
			end
			-- Les succès restent discrets tant que la fonctionnalité n'est pas débloquée
			if payload.Type == "Achievement" and not ctx.HasFeature("Achievements") then
				return
			end
			local now = os.clock()
			if now - lastSpecial < 2 then
				return
			end
			lastSpecial = now
			shout(Locale.T(special[1]), special[2], false)
		end)
	end
end

function Megaphone.Stop(_ctx)
	-- Tout est dans ctx.Container (détruit par le StimulusManager)
end

return Megaphone
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="139">
          <Properties>
            <string name="Name">Mouse</string>
            <string name="Source"><![CDATA[--[[
	Mouse (ModuleScript - stimulus) — amélioration "Souris gaming" (10 niveaux)
	Emplacement : ReplicatedStorage > Client > Stimuli > Mouse

	Une souris gaming vue de dessus, posée dans l'espace libre près de la
	colonne centrale (Gear/GearLayout). À chaque clic : le bouton gauche
	s'enfonce, des ondes de clic s'élargissent et les lumières RGB avancent.
	Chaque niveau ajoute quelque chose :
	  1 souris noire + câble          2 molette lumineuse
	  3 boutons latéraux               4 logo RGB
	  5 bande RGB                      6 tapis de souris (bord arc-en-ciel)
	  7 coque "nid d'abeille"          8 voyants DPI + ondes plus grandes
	  9 sans fil (ondes radio)         10 édition dorée, tout en RGB
	Au repos : les lumières "respirent" de temps en temps.
]]

local Gear = script.Parent:WaitForChild("Gear")
local GearKit = require(Gear:WaitForChild("GearKit"))
local GearPiece = require(Gear:WaitForChild("GearPiece"))
local GearClick = require(Gear:WaitForChild("GearClick"))

local Mouse = {}
Mouse.Slot = "Background" -- sous l'interface (effets de clic : calque Overlay)

local W, H = 72, 104
local INK = Color3.fromRGB(40, 34, 56)

local active: { [any]: any } = {}

function Mouse.Start(ctx)
	local animator = GearKit.Animator(ctx)
	local piece = GearPiece.new(ctx, {
		Id = "Mouse",
		Size = Vector2.new(W, H),
		Priority = 4,
		MinScale = 0.42,
		MaxScale = 1,
		GlowColor = Color3.fromRGB(190, 240, 255),
		ContainerZ = 1105,
		Anchor = function(button, _canvas)
			-- En bas à droite du bouton (le clavier est à gauche)
			return Vector2.new(button.X1 + 150, button.Y1 + 100)
		end,
	}, animator)
	active[ctx] = piece

	local art: Frame? = nil
	local leftButton: Frame? = nil
	local leftBase: Color3 = Color3.new()
	local rgbParts: { Frame } = {} -- parties colorées (teinte qui avance)
	local rgbGradients: { UIGradient } = {}
	local signalBars: { Frame } = {}
	local hue = 0.55

	-- Ondes de clic (sur la toile), réutilisées
	local ripples = GearKit.Pool(3, function()
		local ring = Instance.new("Frame")
		ring.Name = "Ripple"
		ring.AnchorPoint = Vector2.new(0.5, 0.5)
		ring.BackgroundTransparency = 1
		ring.ZIndex = 22
		ring.Visible = false
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = ring
		local stroke = Instance.new("UIStroke")
		stroke.Name = "Stroke"
		stroke.Thickness = 2.5
		stroke.Color = Color3.fromRGB(120, 230, 255)
		stroke.Parent = ring
		ring.Parent = piece.FX
		return ring
	end)

	local function applyHue()
		local color = GearKit.Rainbow(hue, 0.7, 1)
		for _, part in ipairs(rgbParts) do
			part.BackgroundColor3 = color
		end
		for _, gradient in ipairs(rgbGradients) do
			gradient.Offset = Vector2.new((hue * 2) % 1 - 0.5, 0)
		end
	end

	local function build(level: number)
		animator:Stop("press", true)
		animator:Stop("breathe", true)
		if art then
			art:Destroy()
		end
		table.clear(rgbParts)
		table.clear(rgbGradients)
		table.clear(signalBars)
		local root = Instance.new("Frame")
		root.Name = "Art"
		root.BackgroundTransparency = 1
		root.Size = UDim2.fromOffset(W, H)
		root.ZIndex = 2

		local gold = level >= 10
		local wireless = level >= 9

		-- Tapis de souris (bord arc-en-ciel)
		if level >= 6 then
			local _, edge = GearKit.Outlined(root, 3, 12, W - 6, H - 15, Color3.fromRGB(34, 30, 52), {
				Name = "Pad",
				Radius = 12,
				Outline = 2.5,
				OutlineColor = Color3.new(1, 1, 1),
				Z = 2,
				LineZ = 1,
			})
			local gradient = Instance.new("UIGradient")
			gradient.Color = GearKit.RainbowSequence(0, 0.85)
			gradient.Rotation = 90
			gradient.Parent = edge
			table.insert(rgbGradients, gradient)
			GearKit.Box(root, 8, H - 12, 14, 4, Color3.fromRGB(80, 74, 110), { Name = "PadLogo", Radius = "round", Z = 3 })
		end

		-- Câble ou ondes radio
		if wireless then
			for index = 1, 3 do
				local bar = GearKit.Box(root, W / 2, 14 - index * 3.2, 6 + index * 7, 2.4, Color3.fromRGB(120, 230, 255), {
					Name = "Signal",
					Anchor = Vector2.new(0.5, 0.5),
					Radius = "round",
					Z = 4,
					Transparency = 0.15,
				})
				table.insert(signalBars, bar)
			end
		else
			GearKit.Outlined(root, W / 2 - 1.5, 0, 3, 26, level >= 5 and Color3.fromRGB(80, 80, 110) or Color3.fromRGB(60, 60, 72), {
				Name = "Cable",
				Radius = 1.5,
				Outline = 1.2,
				OutlineColor = INK,
				Z = 4,
				LineZ = 3,
			})
		end

		-- Corps (capsule + dos plus large = forme d'œuf)
		local bodyColor = gold and Color3.fromRGB(255, 200, 70) or Color3.fromRGB(46, 46, 58)
		local bodyGradient = gold and ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(225, 150, 40))
			or ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(170, 170, 190))
		GearKit.Outlined(root, 16, 22, 40, 70, bodyColor, { Name = "Body", Radius = 20, Outline = 2.4, OutlineColor = INK, Z = 6, LineZ = 5, Gradient = bodyGradient })
		GearKit.Outlined(root, 13, 50, 46, 46, bodyColor, { Name = "Palm", Radius = "round", Outline = 2.4, OutlineColor = INK, Z = 6, LineZ = 5, Gradient = bodyGradient })
		if level >= 3 then
			GearKit.Outlined(root, 9, 50, 6, 9, Color3.fromRGB(90, 90, 110), { Name = "Side1", Radius = 2, Outline = 1.6, OutlineColor = INK, Z = 6, LineZ = 5 })
			GearKit.Outlined(root, 9, 61, 6, 9, Color3.fromRGB(90, 90, 110), { Name = "Side2", Radius = 2, Outline = 1.6, OutlineColor = INK, Z = 6, LineZ = 5 })
		end

		-- Boutons gauche / droit + séparation
		local buttonColor = gold and Color3.fromRGB(255, 220, 110) or Color3.fromRGB(70, 70, 86)
		local left = GearKit.Box(root, 18.5, 24.5, 16, 26, buttonColor, { Name = "LeftButton", Radius = 8, Z = 7 })
		GearKit.Box(root, 37.5, 24.5, 16, 26, buttonColor, { Name = "RightButton", Radius = 8, Z = 7 })
		GearKit.Box(root, 35, 23, 2, 30, INK, { Name = "Split", Z = 8 })
		GearKit.Shine(left, 3, 3, 4, 10, 0.55, 8)
		leftButton = left
		leftBase = buttonColor

		-- Molette
		local wheelColor = level >= 2 and Color3.fromRGB(110, 235, 255) or Color3.fromRGB(150, 150, 165)
		if level >= 2 then
			GearKit.Box(root, 36, 36, 16, 22, wheelColor, { Name = "WheelGlow", Anchor = Vector2.new(0.5, 0.5), Radius = "round", Transparency = 0.6, Z = 8 })
		end
		local wheel = GearKit.Outlined(root, 32.5, 28, 7, 15, wheelColor, { Name = "Wheel", Radius = 3.5, Outline = 1.4, OutlineColor = INK, Z = 10, LineZ = 9 })
		for index = 0, 2 do
			GearKit.Box(wheel, 1, 3 + index * 4, 5, 1.3, INK, { Name = "Tread", Transparency = 0.4, Z = 11 })
		end
		if level >= 2 then
			table.insert(rgbParts, wheel)
		end

		-- Voyants DPI
		if level >= 8 then
			local dpi = { Color3.fromRGB(255, 80, 90), Color3.fromRGB(255, 210, 60), Color3.fromRGB(90, 240, 120) }
			for index, color in ipairs(dpi) do
				GearKit.Box(root, 30 + (index - 1) * 5, 55, 3, 3, color, { Name = "Dpi", Radius = "round", Z = 9 })
			end
		end

		-- Coque nid d'abeille
		if level >= 7 then
			local holes = { { 26, 64 }, { 36, 62 }, { 46, 64 }, { 21, 73 }, { 31, 72 }, { 41, 72 }, { 51, 73 }, { 26, 81 }, { 36, 81 }, { 46, 81 } }
			for _, hole in ipairs(holes) do
				GearKit.Box(root, hole[1], hole[2], 5, 5, gold and Color3.fromRGB(190, 120, 30) or Color3.fromRGB(24, 24, 32), {
					Name = "Hole",
					Anchor = Vector2.new(0.5, 0.5),
					Radius = "round",
					Z = 9,
				})
			end
		end

		-- Logo RGB
		if level >= 4 then
			local logoY = level >= 7 and 89 or 72
			local glow = GearKit.Box(root, 36, logoY, 18, 18, Color3.fromRGB(255, 120, 220), { Name = "LogoGlow", Anchor = Vector2.new(0.5, 0.5), Radius = "round", Transparency = 0.55, Z = 9 })
			local logo = GearKit.Box(root, 36, logoY, 9, 9, Color3.fromRGB(255, 120, 220), { Name = "Logo", Anchor = Vector2.new(0.5, 0.5), Rotation = 45, Radius = 2, Z = 10 })
			GearKit.Shine(logo, 1.5, 1.5, 3, 3, 0.2, 11)
			table.insert(rgbParts, glow)
			table.insert(rgbParts, logo)
		end

		-- Bande RGB (au dos)
		if level >= 5 then
			local strip = GearKit.Box(root, 20, 92, 32, 3.5, Color3.new(1, 1, 1), {
				Name = "Strip",
				Radius = "round",
				Z = 9,
				Gradient = GearKit.RainbowSequence(0, 0.8),
				GradientRotation = 0,
			})
			local gradient = strip:FindFirstChildOfClass("UIGradient")
			if gradient then
				table.insert(rgbGradients, gradient)
			end
		end

		-- Reflet du dos
		GearKit.Shine(root, 20, 56, 8, 18, gold and 0.35 or 0.7, 12, -12)

		root.Parent = piece.Content
		art = root
		applyHue()
	end
	build(math.max(1, piece.Level))

	piece.OnLevel = function(level, _previous)
		build(level)
	end

	local function click()
		if not piece:IsShown() then
			return
		end
		local level = math.max(1, piece.Level)
		if level >= 2 then
			hue = (hue + 0.08) % 1
			applyHue()
		end
		-- Bouton gauche enfoncé
		local button = leftButton
		if button then
			local pressed = leftBase:Lerp(Color3.fromRGB(20, 20, 30), 0.45)
			animator:Play("press", 0.14, function(t)
				local amount = t < 0.3 and t / 0.3 or 1 - (t - 0.3) / 0.7
				button.Position = UDim2.fromOffset(18.5, 24.5 + 1.2 * amount)
				button.BackgroundColor3 = leftBase:Lerp(pressed, amount)
			end)
		end
		-- Ondes radio (sans fil)
		if #signalBars > 0 then
			local bars = signalBars
			animator:Play("signal", 0.35, function(t)
				for index, bar in ipairs(bars) do
					local k = math.clamp(t * 3 - (index - 1) * 0.5, 0, 1)
					bar.BackgroundTransparency = 0.15 + 0.7 * GearKit.Bump(k)
				end
			end)
		end
		-- Ondes de clic
		if GearKit.EffectsOn(ctx) then
			local origin = piece:ToCanvas(Vector2.new(27, 36))
			if origin then
				local count = level >= 8 and 2 or 1
				local maxSize = (level >= 8 and 62 or 44) * math.max(0.6, piece.PlaceScale.Scale)
				local color = level >= 5 and GearKit.Rainbow(hue, 0.6, 1) or Color3.fromRGB(130, 225, 255)
				for index = 1, count do
					local ring = ripples:Next()
					local stroke = ring:FindFirstChild("Stroke") :: UIStroke
					local delay = (index - 1) * 0.08
					stroke.Color = color
					animator:Play(ring, 0.42 + delay, function(t)
						local k = math.clamp((t * (0.42 + delay) - delay) / 0.42, 0, 1)
						ring.Visible = k > 0 and k < 1
						local e = GearKit.Ease.OutCubic(k)
						local s = 10 + (maxSize - 10) * e
						ring.Position = UDim2.fromOffset(origin.X, origin.Y)
						ring.Size = UDim2.fromOffset(s, s)
						stroke.Transparency = 0.1 + 0.9 * k
						stroke.Thickness = 3 - 1.8 * k
					end, function()
						ring.Visible = false
					end)
				end
			end
		end
	end

	ctx.Connect(ctx.State.Clicked, function()
		if ctx.IsVisible() then
			click()
		end
	end)

	-- La souris elle-même est un bouton (zone transparente au-dessus du dessin)
	local hit = Instance.new("TextButton")
	hit.Name = "MouseHit"
	hit.BackgroundTransparency = 1
	hit.AutoButtonColor = false
	hit.Selectable = false
	hit.Text = ""
	hit.Size = UDim2.fromScale(1, 1)
	hit.ZIndex = 40
	hit.Parent = piece.Content
	hit.InputBegan:Connect(function(input: InputObject)
		local kind = input.UserInputType
		if kind ~= Enum.UserInputType.MouseButton1 and kind ~= Enum.UserInputType.Touch then
			return
		end
		if not piece:IsShown() then
			return
		end
		GearClick.PlayClickSound()
		local gain = GearClick.Click("Mouse", piece:ToCanvas(Vector2.new(27, 20)))
		if not gain then
			click() -- (clic refusé : trop rapide, la souris s'anime quand même)
		end
	end)

	-- Au repos : les lumières respirent (un tour d'arc-en-ciel lent)
	GearKit.Every(ctx, 4, 7, function()
		if not piece:IsShown() or piece.Level < 2 then
			return
		end
		local start = hue
		local lastStep = -1
		animator:Play("breathe", 1.2, function(t)
			-- (≤ 30 mises à jour par seconde : animation d'ambiance)
			local step = math.floor(t * 36)
			if step == lastStep then
				return
			end
			lastStep = step
			hue = (start + 0.25 * GearKit.Ease.InOutSine(step / 36)) % 1
			applyHue()
		end)
	end)
end

function Mouse.Stop(ctx)
	local piece = active[ctx]
	active[ctx] = nil
	if piece then
		piece:Destroy()
	end
end

return Mouse
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="140">
          <Properties>
            <string name="Name">Multiverse</string>
            <string name="Source"><![CDATA[--[[
	Multiverse (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > Multiverse

	🪐 Multivers (gains x3, après 8 visites à l'océan) : trois portails
	tourbillonnants (bord arc-en-ciel qui tourne, halo), chacun montrant un
	mini monde parallèle où un autre « toi » clique aussi : une petite
	planète avec un minuscule bouton « Clique-moi » qui s'enfonce, et un
	« +1 » qui s'envole.
	  - monde bonbon (ciel rose, planète menthe) ;
	  - monde océan (nuit bleue, planète bleue et son voilier) ;
	  - monde lave (ciel violet, planète orange à anneau).
	Chaque portail est posé séparément par Cosmos/Zones (sur les côtés de
	préférence). ≤ 20 images/s, ~17 instances par portail.
]]

local Cosmos = script.Parent:WaitForChild("Cosmos")
local Kit = require(Cosmos:WaitForChild("Kit"))
local Zones = require(Cosmos:WaitForChild("Zones"))

local Multiverse = {}
Multiverse.Slot = "Background"

local ID = "Multiverse"
local BOX = 74
local C = BOX / 2

type World = {
	Name: string,
	SkyTop: Color3,
	SkyBottom: Color3,
	Planet: Color3,
	PlanetDark: Color3,
	Glow: Color3,
	Anchor: Vector2,
}

local WORLDS: { World } = {
	{
		Name = "Candy",
		SkyTop = Color3.fromRGB(255, 170, 214),
		SkyBottom = Color3.fromRGB(255, 214, 236),
		Planet = Color3.fromRGB(150, 236, 200),
		PlanetDark = Color3.fromRGB(80, 196, 160),
		Glow = Color3.fromRGB(255, 120, 200),
		Anchor = Vector2.new(0.14, 0.5),
	},
	{
		Name = "Ocean",
		SkyTop = Color3.fromRGB(28, 40, 110),
		SkyBottom = Color3.fromRGB(70, 110, 200),
		Planet = Color3.fromRGB(90, 190, 255),
		PlanetDark = Color3.fromRGB(40, 110, 220),
		Glow = Color3.fromRGB(80, 170, 255),
		Anchor = Vector2.new(0.86, 0.46),
	},
	{
		Name = "Lava",
		SkyTop = Color3.fromRGB(90, 40, 140),
		SkyBottom = Color3.fromRGB(190, 80, 150),
		Planet = Color3.fromRGB(255, 176, 80),
		PlanetDark = Color3.fromRGB(230, 90, 60),
		Glow = Color3.fromRGB(255, 130, 70),
		Anchor = Vector2.new(0.5, 0.97),
	},
}

local RIM = Kit.Colors({
	0,
	Color3.fromRGB(255, 110, 200),
	0.33,
	Color3.fromRGB(120, 200, 255),
	0.66,
	Color3.fromRGB(190, 130, 255),
	1,
	Color3.fromRGB(255, 110, 200),
})

function Multiverse.Start(ctx)
	Zones.Attach(ctx)
	local random = Random.new()
	local effects = Kit.Effects(ctx)
	local dark = Kit.IsDark(ctx)

	type Portal = {
		Piece: any,
		Content: Frame?,
		Rim: UIGradient?,
		Glow: Frame?,
		Planet: Frame?,
		Button: Frame?,
		Plus: TextLabel?,
		Stars: { Frame },
		Phase: number,
	}
	local portals: { Portal } = {}

	local function buildPortal(portal: Portal, world: World)
		if portal.Content then
			portal.Content:Destroy()
		end
		table.clear(portal.Stars)
		local root = Kit.Box(portal.Piece.Frame, { Name = "Content", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 })
		portal.Content = root

		portal.Glow = Kit.Circle(root, C, C, BOX - 2, world.Glow, if dark then 0.72 else 0.8, 1)
		-- Ciel du monde
		local sky = Kit.Circle(root, C, C, 56, Color3.new(1, 1, 1), 0, 2)
		sky.Name = "Sky"
		Kit.Gradient(sky, ColorSequence.new(world.SkyTop, world.SkyBottom), nil, 90)
		for _, spec in ipairs({ { 0.3, 0.28, 4 } }) do
			local star = Kit.Diamond(root, BOX * spec[1], BOX * spec[2], spec[3], Kit.Rgb(255, 250, 220), 0, 3)
			table.insert(portal.Stars, star)
		end
		-- Planète
		local planet = Kit.Box(root, {
			Name = "Planet",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(C, C + 9),
			Size = UDim2.fromOffset(28, 28),
			BackgroundTransparency = 1,
			ZIndex = 4,
		})
		portal.Planet = planet
		local ball = Kit.Circle(planet, 14, 14, 28, Color3.new(1, 1, 1), 0, 4)
		Kit.Gradient(ball, ColorSequence.new(world.Planet, world.PlanetDark), nil, 60)
		if world.Name == "Lava" then
			local ringFrame = Kit.Ellipse(planet, 14, 16, 44, 10, Color3.new(1, 1, 1), 1, 5)
			Kit.Stroke(ringFrame, Kit.Rgb(255, 226, 170), 2, 0.1)
		elseif world.Name == "Ocean" then
			-- Petit voilier
			Kit.Box(planet, { Name = "Sail", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromOffset(21, 2), Size = UDim2.fromOffset(6, 8), Rotation = 8, Color = Color3.new(1, 1, 1), ZIndex = 5 })
		end
		-- Minuscule bouton « Clique-moi » sur la planète (l'autre toi clique aussi)
		local button = Kit.Box(planet, {
			Name = "TinyButton",
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromOffset(if world.Name == "Ocean" then 11 else 14, 3),
			Size = UDim2.fromOffset(13, 6),
			Color = Kit.Rgb(236, 236, 240),
			ZIndex = 6,
		})
		Kit.Corner(button, 3)
		portal.Button = button
		local plus = Kit.Text(root, "+1", C, C - 12, 10, Kit.Rgb(255, 236, 120), 7)
		plus.TextTransparency = 1
		local stroke = Instance.new("UIStroke")
		stroke.Color = Kit.Rgb(70, 40, 100)
		stroke.Thickness = 1
		stroke.Parent = plus
		portal.Plus = plus
		-- Bord tourbillonnant
		local rim, rimStroke = Kit.Ring(root, C, C, 58, Color3.new(1, 1, 1), 4, 0, 8)
		rim.Name = "Rim"
		portal.Rim = Kit.Gradient(rimStroke, RIM, nil, 0)
	end

	local function buildAll()
		for index, portal in ipairs(portals) do
			buildPortal(portal, WORLDS[index])
		end
	end

	local items = {}
	for index, world in ipairs(WORLDS) do
		local piece = Kit.Piece(ctx.Container, "Portal" .. world.Name, BOX, BOX)
		portals[index] = { Piece = piece, Content = nil, Rim = nil, Glow = nil, Planet = nil, Button = nil, Plus = nil, Stars = {}, Phase = random:NextNumber(0, 6) }
		table.insert(items, { W = BOX, H = BOX, Anchor = world.Anchor, MinScale = 0.4, MaxScale = 1.1, Gap = 3 })
	end
	buildAll()
	Kit.WatchTheme(ctx, function(isDark)
		dark = isDark
		buildAll()
	end)

	Zones.Request(ID, items, function(placements)
		for index, portal in ipairs(portals) do
			Kit.Place(portal.Piece, placements[index])
		end
	end)

	Kit.Loop(ctx, 20, function(_dt, t)
		for index, portal in ipairs(portals) do
			if portal.Piece.Placed then
				local rim = portal.Rim
				if rim then
					rim.Rotation = (t * (60 + index * 15) + index * 120) % 360
				end
				local glow = portal.Glow
				if glow then
					glow.BackgroundTransparency = (if dark then 0.72 else 0.8) + 0.08 * math.sin(t * 2 + portal.Phase)
				end
				local planet = portal.Planet
				if planet then
					planet.Position = UDim2.fromOffset(C, C + 9 + math.sin(t * 1.4 + portal.Phase) * 1.5)
				end
				-- Le mini bouton s'enfonce toutes les ~1,6 s, un « +1 » s'envole
				local cycle = (t / 1.6 + portal.Phase) % 1
				local button = portal.Button
				if button then
					button.Size = if cycle < 0.12 then UDim2.fromOffset(14, 4) else UDim2.fromOffset(13, 6)
				end
				local plus = portal.Plus
				if plus and effects then
					plus.Position = UDim2.fromOffset(C + 4, C - 6 - cycle * 16)
					plus.TextTransparency = if cycle < 0.1 then 1 - cycle / 0.1 elseif cycle > 0.6 then (cycle - 0.6) / 0.4 else 0
				end
				for starIndex, star in ipairs(portal.Stars) do
					star.BackgroundTransparency = 0.2 + 0.6 * (0.5 + 0.5 * math.sin(t * 2.5 + starIndex + portal.Phase))
				end
			end
		end
	end)
end

function Multiverse.Stop(_ctx)
	Zones.Release(ID)
end

return Multiverse
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="141">
          <Properties>
            <string name="Name">NeonMode</string>
            <string name="Source"><![CDATA[--[[
	NeonMode (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > NeonMode

	Mode néon (calque Background, sous tout le reste) : reprise du fond
	animé de la v1, version "nuit électrique" :
	  - dégradé sombre qui tourne et pulse vers le rose / violet / cyan ;
	  - orbes lumineux qui dérivent lentement ;
	  - petites étoiles qui scintillent en haut ;
	  - grille rétro en perspective qui défile en bas de l'écran.
	Au démarrage, le néon "grésille" puis s'allume (comme un vrai tube),
	et l'interface passe en mode sombre (ctx.SetDarkMode). Pendant un
	Dopamine Rush, tout s'accélère et devient plus vif.

	v3 : si le joueur a équipé un thème (autre que "Classique"), le fond
	néon devient un peu translucide pour laisser deviner le thème acheté.
	À l'arrêt, le mode sombre suit de nouveau le thème (un thème sombre
	reste sombre).
]]

local NeonMode = {}
NeonMode.Slot = "Background"

local ORB_COUNT = 10
local STAR_COUNT = 14
local H_LINES = 9 -- lignes horizontales de la grille
local V_LINES = 7 -- lignes "fuyantes" de chaque côté du centre
local HORIZON = 0.64 -- hauteur de l'horizon (fraction de l'écran)

local BASE_TOP = Color3.fromRGB(18, 6, 40)
local BASE_MID = Color3.fromRGB(44, 10, 78)
local BASE_BOTTOM = Color3.fromRGB(6, 18, 48)
local THEMED_TRANSPARENCY = 0.22 -- transparence du fond néon au-dessus d'un thème acheté

-- Thème équipé (table de Config.Themes) ou nil
local function equippedTheme(ctx): any
	local data = ctx.State.Data
	local themes = data and data.Themes
	local id = themes and themes.Equipped
	return type(id) == "string" and ctx.Config.ThemesById[id] or nil
end

function NeonMode.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Create = UIUtil.Create
	local container: Frame = ctx.Container
	local random = Random.new()

	local pink = Color3.fromRGB(255, 46, 136)
	local purple = Color3.fromRGB(157, 78, 221)
	local cyan = Color3.fromRGB(0, 240, 255)
	local orbColors = { pink, cyan, purple }

	ctx.SetDarkMode(true)

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	local function rushActive(): boolean
		local rush = ctx.State.Rush
		return type(rush) == "table" and rush.Active == true
	end

	------------------------------------------------------------------
	-- Fond dégradé
	------------------------------------------------------------------
	local frame = Create("Frame", {
		Name = "Neon",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1), -- blanc : le dégradé donne les couleurs
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 1,
		Parent = container,
	})
	local gradient = UIUtil.Gradient(frame, ColorSequence.new({
		ColorSequenceKeypoint.new(0, BASE_TOP),
		ColorSequenceKeypoint.new(0.5, BASE_MID),
		ColorSequenceKeypoint.new(1, BASE_BOTTOM),
	}), 45)

	-- Tout ce qui doit apparaître en fondu : { objet, propriété, valeur cible }
	local fades = {}
	local function addFade(instance: Instance, property: string, target: number)
		table.insert(fades, { instance, property, target })
		local object: any = instance
		object[property] = 1
	end

	------------------------------------------------------------------
	-- Orbes lumineux (comme la v1)
	------------------------------------------------------------------
	local orbs = {}
	local orbCount = effectsOn() and ORB_COUNT or math.floor(ORB_COUNT / 2)
	for _ = 1, orbCount do
		local size = random:NextInteger(140, 340)
		local orb = Create("Frame", {
			Size = UDim2.fromOffset(size, size),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(random:NextNumber(0, 1), random:NextNumber(0, 1)),
			BackgroundColor3 = orbColors[random:NextInteger(1, #orbColors)],
			BorderSizePixel = 0,
			ZIndex = 2,
			Parent = frame,
		})
		UIUtil.Corner(orb, UDim.new(1, 0))
		-- Bord qui s'efface (faux dégradé radial)
		Create("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Rotation = random:NextInteger(0, 360),
			Parent = orb,
		})
		addFade(orb, "BackgroundTransparency", random:NextNumber(0.7, 0.82))
		table.insert(orbs, orb)
	end

	-- Chaque orbe dérive vers un point au hasard, encore et encore
	for _, orb in ipairs(orbs) do
		task.spawn(function()
			while ctx.IsAlive() and orb.Parent do
				local duration = random:NextNumber(6, 12) / (rushActive() and 3 or 1)
				UIUtil.Tween(orb, duration, {
					Position = UDim2.fromScale(random:NextNumber(0, 1), random:NextNumber(0, 0.9)),
				}, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
				task.wait(duration)
			end
		end)
	end

	------------------------------------------------------------------
	-- Étoiles
	------------------------------------------------------------------
	local stars = {}
	for _ = 1, STAR_COUNT do
		local size = random:NextInteger(2, 4)
		local star = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(random:NextNumber(0.02, 0.98), random:NextNumber(0.06, HORIZON - 0.12)),
			Size = UDim2.fromOffset(size, size),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 2,
			Parent = frame,
		})
		UIUtil.Corner(star, UDim.new(1, 0))
		table.insert(stars, { Frame = star, Phase = random:NextNumber(0, math.pi * 2), Speed = random:NextNumber(1.5, 4) })
	end

	------------------------------------------------------------------
	-- Horizon + grille rétro
	------------------------------------------------------------------
	local horizonGlow = Create("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, HORIZON),
		Size = UDim2.fromScale(1, 0.14),
		BackgroundColor3 = pink,
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = frame,
	})
	Create("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(1, 0.55),
		}),
		Parent = horizonGlow,
	})
	addFade(horizonGlow, "BackgroundTransparency", 0)

	local horizonLine = Create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, HORIZON),
		Size = UDim2.new(1, 0, 0, 3),
		BackgroundColor3 = pink,
		BorderSizePixel = 0,
		ZIndex = 4,
		Parent = frame,
	})
	Create("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.9),
			NumberSequenceKeypoint.new(0.5, 0.1),
			NumberSequenceKeypoint.new(1, 0.9),
		}),
		Parent = horizonLine,
	})
	addFade(horizonLine, "BackgroundTransparency", 0)

	local grid = Create("Frame", {
		Name = "Grid",
		Position = UDim2.fromScale(0, HORIZON),
		Size = UDim2.fromScale(1, 1 - HORIZON),
		BackgroundColor3 = Color3.fromRGB(10, 0, 24),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 3,
		Parent = frame,
	})
	Create("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.5),
			NumberSequenceKeypoint.new(1, 0.2),
		}),
		Parent = grid,
	})
	addFade(grid, "BackgroundTransparency", 0)

	local hLines = {}
	for index = 1, H_LINES do
		local line = Create("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Size = UDim2.new(1, 0, 0, 2),
			BackgroundColor3 = pink,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 4,
			Parent = grid,
		})
		hLines[index] = line
	end

	local vLines = {}
	for k = -V_LINES, V_LINES do
		local line = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.new(0, 2, 1, 0),
			BackgroundColor3 = pink,
			BorderSizePixel = 0,
			ZIndex = 4,
			Parent = grid,
		})
		Create("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.95),
				NumberSequenceKeypoint.new(1, 0.35),
			}),
			Parent = line,
		})
		addFade(line, "BackgroundTransparency", 0)
		table.insert(vLines, { Frame = line, K = k })
	end

	-- Lignes fuyantes : partent du centre de l'horizon vers le bas.
	-- Calcul en "hauteurs de grille" (le rapport largeur/hauteur ne dépend
	-- pas de l'échelle de l'écran).
	local function layoutGrid()
		local absolute = grid.AbsoluteSize
		if absolute.Y < 1 then
			return
		end
		local aspect = absolute.X / absolute.Y
		for _, entry in ipairs(vLines) do
			local dx = entry.K * aspect * 0.2
			local length = math.sqrt(dx * dx + 1)
			local mid = aspect / 2 + dx / 2
			entry.Frame.Size = UDim2.new(0, 2, length, 0)
			entry.Frame.Position = UDim2.fromScale(mid / aspect, 0.5)
			entry.Frame.Rotation = -math.deg(math.atan2(dx, 1))
		end
	end
	layoutGrid()
	ctx.Connect(grid:GetPropertyChangedSignal("AbsoluteSize"), layoutGrid)

	------------------------------------------------------------------
	-- Allumage : le tube néon grésille puis s'allume
	------------------------------------------------------------------
	local brightness = 0 -- 0 = éteint, 1 = allumé (multiplie les transparences)
	local baseTransparency = 0 -- 0 = néon opaque ; > 0 au-dessus d'un thème acheté
	local function applyBrightness(value: number)
		brightness = value
		frame.BackgroundTransparency = 1 - value * (1 - baseTransparency)
		for _, fade in ipairs(fades) do
			local instance = fade[1]
			if instance.Parent then
				local object: any = instance
				object[fade[2]] = 1 - (1 - fade[3]) * value
			end
		end
	end

	-- Thème acheté : on le laisse deviner sous le néon
	local function refreshThemeBlend()
		local theme = equippedTheme(ctx)
		local target = (theme and theme.Id ~= "Classic") and THEMED_TRANSPARENCY or 0
		if target ~= baseTransparency then
			baseTransparency = target
			applyBrightness(brightness)
		end
	end
	ctx.Connect(ctx.State.Changed, refreshThemeBlend)
	refreshThemeBlend()

	task.spawn(function()
		local steps = { 0.3, 0.05, 0.7, 0.2, 0.9, 0.5, 1 }
		for _, value in ipairs(steps) do
			if not ctx.IsAlive() then
				return
			end
			applyBrightness(value)
			task.wait(0.07)
		end
		-- Fondu final vers la pleine luminosité
		if ctx.IsAlive() then
			applyBrightness(1)
		end
	end)

	------------------------------------------------------------------
	-- Animation (dégradé, étoiles, grille)
	------------------------------------------------------------------
	local time = 0
	local gridScroll = 0
	ctx.OnRender(function(dt: number)
		local rush = rushActive()
		local speed = rush and 4 or 1
		time += dt * speed

		gradient.Rotation = (45 + time * 8) % 360
		gradient.Offset = Vector2.new(math.sin(time * 0.3) * 0.25, math.cos(time * 0.2) * 0.25)

		local pulse = (math.sin(time * 0.5) + 1) / 2
		local top = BASE_TOP:Lerp(pink, rush and 0.4 or pulse * 0.22)
		local mid = BASE_MID:Lerp(purple, pulse * 0.3)
		local bottom = BASE_BOTTOM:Lerp(cyan, rush and 0.35 or (1 - pulse) * 0.22)
		gradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, top),
			ColorSequenceKeypoint.new(0.5, mid),
			ColorSequenceKeypoint.new(1, bottom),
		})

		-- Étoiles qui scintillent
		for _, star in ipairs(stars) do
			local twinkle = (math.sin(time * star.Speed + star.Phase) + 1) / 2
			star.Frame.BackgroundTransparency = 1 - (0.25 + twinkle * 0.65) * brightness
		end

		-- Grille : les lignes horizontales avancent vers le joueur
		gridScroll = (gridScroll + dt * speed * 0.22) % 1
		local lineColor = pink:Lerp(cyan, (math.sin(time * 0.4) + 1) / 4)
		for index, line in ipairs(hLines) do
			local z = ((index - 1) / H_LINES + gridScroll) % 1
			local y = z ^ 2.1
			line.Position = UDim2.fromScale(0, y)
			line.BackgroundTransparency = 1 - (0.15 + z * 0.6) * brightness
			line.BackgroundColor3 = lineColor
		end
		for _, entry in ipairs(vLines) do
			entry.Frame.BackgroundColor3 = lineColor
		end
		horizonLine.BackgroundColor3 = lineColor
	end)

	-- Petit flash rose à l'allumage
	ctx.Effects.Flash(pink, 0.25)
end

function NeonMode.Stop(ctx)
	-- Le néon ne demande plus le mode sombre...
	ctx.SetDarkMode(false)
	-- ... mais un thème sombre le garde : on recalcule depuis le thème
	-- (après le gestionnaire de stimuli, qui recalcule aussi le mode sombre)
	local State = ctx.State
	task.defer(function()
		local theme = equippedTheme(ctx)
		State.SetDarkMode((theme ~= nil and theme.Dark == true) or State.HasFeature("NeonMode"))
	end)
end

return NeonMode
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="142">
          <Properties>
            <string name="Name">NeuralLink</string>
            <string name="Source"><![CDATA[--[[
	NeuralLink (ModuleScript - stimulus) — amélioration "Neural Link" (1 niveau,
	après 3 visites à l'océan)
	Emplacement : ReplicatedStorage > Client > Stimuli > NeuralLink

	Un petit cerveau kawaii qui brille (casque à électrodes), posé dans
	l'espace libre (Gear/GearLayout), relié au gros bouton par un câble
	neuronal. À chaque clic, une impulsion lumineuse part du cerveau, suit le
	câble et fait une étincelle au bouton ; le cerveau "pulse" et ses
	électrodes s'allument.
	Tout le dessin (cerveau + câble "Gear_NeuralCable") est SOUS l'interface
	(Slot "Background") : le câble ne recouvre jamais une carte, le compteur ou
	un bouton, il se glisse dessous quand il doit les traverser. Seule
	l'étincelle d'arrivée (passagère) est dans le calque Overlay.
	Au repos : de temps en temps une "pensée" (impulsion douce) et un clin d'œil.
]]

local Gear = script.Parent:WaitForChild("Gear")
local GearKit = require(Gear:WaitForChild("GearKit"))
local GearPiece = require(Gear:WaitForChild("GearPiece"))

local NeuralLink = {}
NeuralLink.Slot = "Background" -- sous l'interface (étincelles : calque Overlay)

local W, H = 104, 90
local INK = Color3.fromRGB(128, 48, 104)
local PINK = Color3.fromRGB(255, 176, 208)
local FOLD = Color3.fromRGB(226, 112, 166)
local SEGMENTS = 18

local active: { [any]: () -> () } = {}

-- Point d'une courbe de Bézier cubique
local function bezier(p0: Vector2, p1: Vector2, p2: Vector2, p3: Vector2, t: number): Vector2
	local u = 1 - t
	return p0 * (u * u * u) + p1 * (3 * u * u * t) + p2 * (3 * u * t * t) + p3 * (t * t * t)
end

function NeuralLink.Start(ctx)
	local animator = GearKit.Animator(ctx)
	local random = ctx.Random
	local piece = GearPiece.new(ctx, {
		Id = "NeuralLink",
		Size = Vector2.new(W, H),
		Priority = 6,
		MinScale = 0.42,
		MaxScale = 1,
		GlowColor = Color3.fromRGB(255, 200, 240),
		ContainerZ = 1101,
		Anchor = function(button, _canvas)
			-- En haut à droite du bouton (au-dessus de la souris)
			return Vector2.new(button.X1 + 200, button.Y0 + 30)
		end,
	}, animator)

	------------------------------------------------------------------
	-- Le cerveau
	------------------------------------------------------------------

	local root = Instance.new("Frame")
	root.Name = "Art"
	root.BackgroundTransparency = 1
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.Position = UDim2.fromOffset(W / 2, H / 2)
	root.Size = UDim2.fromOffset(W, H)
	root.ZIndex = 2
	local pulseScale = Instance.new("UIScale")
	pulseScale.Parent = root

	-- Halo
	local halo = GearKit.Box(root, W / 2, 44, 116, 100, Color3.fromRGB(255, 140, 220), { Name = "Halo", Anchor = Vector2.new(0.5, 0.5), Radius = "round", Transparency = 0.86, Z = 1 })
	local haloCore = GearKit.Box(root, W / 2, 44, 88, 74, Color3.fromRGB(255, 170, 230), { Name = "HaloCore", Anchor = Vector2.new(0.5, 0.5), Radius = "round", Transparency = 0.8, Z = 1 })

	-- Tronc cérébral (le câble en sort)
	GearKit.Outlined(root, 46, 60, 12, 22, Color3.fromRGB(240, 146, 186), { Name = "Stem", Radius = 5, Outline = 2.2, OutlineColor = INK, Z = 3, LineZ = 2 })
	GearKit.Outlined(root, 44, 78, 16, 8, Color3.fromRGB(90, 90, 120), { Name = "Port", Radius = 3, Outline = 2, OutlineColor = INK, Z = 4, LineZ = 2 })

	-- Lobes
	local lobeGradient = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(240, 210, 225))
	for _, lobe in ipairs({
		{ 10, 26, 40, 34 },
		{ 25, 11, 34, 30 },
		{ 46, 11, 34, 30 },
		{ 56, 25, 38, 35 },
		{ 20, 36, 64, 30 },
	}) do
		GearKit.Outlined(root, lobe[1], lobe[2], lobe[3], lobe[4], PINK, {
			Name = "Lobe",
			Radius = "round",
			Outline = 2.6,
			OutlineColor = INK,
			Z = 5,
			LineZ = 2,
			Gradient = lobeGradient,
		})
	end
	-- Sillon central + circonvolutions
	GearKit.Box(root, 51, 13, 2.2, 24, FOLD, { Name = "Fissure", Radius = "round", Z = 6 })
	for _, fold in ipairs({
		{ 16, 32, 12, 30 },
		{ 30, 20, 11, -40 },
		{ 36, 30, 9, 20 },
		{ 60, 20, 11, 40 },
		{ 64, 30, 9, -20 },
		{ 76, 34, 12, -30 },
		{ 18, 48, 10, -15 },
		{ 76, 50, 10, 15 },
	}) do
		GearKit.Box(root, fold[1], fold[2], fold[3], 2.4, FOLD, { Name = "Fold", Radius = "round", Rotation = fold[4], Z = 6 })
	end
	GearKit.Shine(root, 28, 16, 12, 6, 0.45, 7, -20)

	-- Visage
	local eyes = {}
	for side = 0, 1 do
		local ex = side == 0 and 40 or 59
		local eye = GearKit.Box(root, ex, 42, 5.5, 7, Color3.fromRGB(70, 30, 60), { Name = "Eye", Radius = "round", Z = 8 })
		GearKit.Box(eye, 1, 1, 2.2, 2.2, Color3.new(1, 1, 1), { Name = "Glint", Radius = "round", Z = 9 })
		table.insert(eyes, eye)
		GearKit.Box(root, side == 0 and 32 or 64, 50, 8, 4, Color3.fromRGB(255, 110, 150), { Name = "Blush", Radius = "round", Transparency = 0.35, Z = 7 })
	end
	GearKit.Box(root, 49, 51, 6, 3.5, Color3.fromRGB(170, 50, 90), { Name = "Mouth", Radius = "round", Z = 8 })

	-- Casque à électrodes
	GearKit.Outlined(root, 16, 6, 72, 6, Color3.fromRGB(232, 234, 246), { Name = "Band", Radius = "round", Outline = 2, OutlineColor = INK, Z = 10, LineZ = 9 })
	local electrodes = {}
	for index, ex in ipairs({ 20, 52, 84 }) do
		local glow = GearKit.Box(root, ex, 8, 18, 18, Color3.fromRGB(120, 240, 255), { Name = "NodeGlow", Anchor = Vector2.new(0.5, 0.5), Radius = "round", Transparency = 0.6, Z = 10 })
		local node = GearKit.Outlined(root, ex - 5, 3, 10, 10, Color3.fromRGB(120, 240, 255), { Name = "Node", Radius = "round", Outline = 1.8, OutlineColor = INK, Z = 12, LineZ = 11 })
		GearKit.Box(node, 2, 2, 3, 3, Color3.new(1, 1, 1), { Name = "Core", Radius = "round", Z = 13 })
		electrodes[index] = { Glow = glow, Node = node }
	end
	root.Parent = piece.Content

	------------------------------------------------------------------
	-- Le câble (calque Background) + impulsions
	------------------------------------------------------------------

	local cable = Instance.new("Frame")
	cable.Name = "Gear_NeuralCable"
	cable.BackgroundTransparency = 1
	cable.Size = UDim2.fromScale(1, 1)
	cable.ZIndex = 1 -- sous le cerveau (le conteneur est déjà sous l'interface)
	cable.Visible = false
	cable.Active = false
	cable.Parent = ctx.Container

	local segments = {}
	for index = 1, SEGMENTS do
		local outer = GearKit.Box(cable, 0, 0, 10, 7, Color3.fromRGB(70, 56, 100), { Name = "Segment", Anchor = Vector2.new(0.5, 0.5), Radius = "round", Z = 1 })
		local core = GearKit.Box(cable, 0, 0, 10, 2.6, Color3.fromRGB(255, 150, 225), { Name = "Core", Anchor = Vector2.new(0.5, 0.5), Radius = "round", Transparency = 0.25, Z = 2 })
		segments[index] = { Outer = outer, Core = core }
	end

	local pulses = GearKit.Pool(3, function()
		local dot = GearKit.Box(cable, 0, 0, 14, 14, Color3.fromRGB(255, 140, 230), { Name = "Pulse", Anchor = Vector2.new(0.5, 0.5), Radius = "round", Transparency = 0.2, Z = 4, Visible = false })
		GearKit.Box(dot, 4, 4, 6, 6, Color3.new(1, 1, 1), { Name = "Core", Radius = "round", Z = 5 })
		return dot
	end)

	-- Étincelle au bouton (au-dessus : calque Overlay)
	local sparks = GearKit.Pool(2, function()
		local ring = Instance.new("Frame")
		ring.Name = "Spark"
		ring.AnchorPoint = Vector2.new(0.5, 0.5)
		ring.BackgroundColor3 = Color3.fromRGB(255, 200, 250)
		ring.BackgroundTransparency = 1
		ring.ZIndex = 24
		ring.Visible = false
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = ring
		local stroke = Instance.new("UIStroke")
		stroke.Name = "Stroke"
		stroke.Color = Color3.fromRGB(255, 130, 230)
		stroke.Thickness = 2.5
		stroke.Parent = ring
		GearKit.Star(ring, 0, 0, 12, Color3.new(1, 1, 1), 25).Position = UDim2.fromScale(0.5, 0.5)
		ring.Parent = piece.FX
		return ring
	end)

	local path = { Vector2.zero, Vector2.zero, Vector2.zero, Vector2.zero }
	local attach = Vector2.zero

	local function layCable(placement: any)
		if not placement then
			cable.Visible = false
			return
		end
		local button = placement.Button
		local center = Vector2.new(placement.CX, placement.CY)
		-- Le câble sort du casque si le bouton est au-dessus, sinon du tronc cérébral
		local up = (button.Y0 + button.Y1) / 2 < center.Y - 10
		local port = piece:ToCanvas(up and Vector2.new(52, 3) or Vector2.new(52, 84))
		if not port then
			return
		end
		local portDir = up and Vector2.new(0, -1) or Vector2.new(0, 1)
		-- Point d'arrivée : bord du bouton le plus proche, un peu à l'intérieur (le câble passe dessous)
		local edge = GearKit.ClosestOnRect(button, center)
		local normal = Vector2.zero
		if edge.X <= button.X0 + 0.5 then
			normal = Vector2.new(-1, 0)
		elseif edge.X >= button.X1 - 0.5 then
			normal = Vector2.new(1, 0)
		elseif edge.Y <= button.Y0 + 0.5 then
			normal = Vector2.new(0, -1)
		else
			normal = Vector2.new(0, 1)
		end
		attach = edge
		local finish = edge - normal * 10
		local distance = (finish - port).Magnitude
		path[1] = port
		path[2] = port + portDir * math.clamp(distance * 0.35, 24, 90)
		path[3] = edge + normal * math.clamp(distance * 0.35, 20, 80)
		path[4] = finish
		local previous = path[1]
		for index = 1, SEGMENTS do
			local point = bezier(path[1], path[2], path[3], path[4], index / SEGMENTS)
			local delta = point - previous
			local length = delta.Magnitude
			local mid = (point + previous) / 2
			local angle = math.deg(math.atan2(delta.Y, delta.X))
			local segment = segments[index]
			for _, frame in ipairs({ segment.Outer, segment.Core }) do
				frame.Position = UDim2.fromOffset(mid.X, mid.Y)
				frame.Rotation = angle
			end
			local thickness = 7 * math.max(0.6, placement.Scale)
			segment.Outer.Size = UDim2.fromOffset(length + thickness, thickness)
			segment.Core.Size = UDim2.fromOffset(length + 2, thickness * 0.38)
			previous = point
		end
		cable.Visible = true
	end

	piece.OnPlaced = function(placement, _first)
		layCable(placement)
	end
	piece.OnHidden = function()
		cable.Visible = false
	end

	-- Impulsion le long du câble (dim = pensée au repos)
	local function firePulse(dim: boolean)
		if not piece:IsShown() or not cable.Visible then
			return
		end
		local dot = pulses:Next()
		local size = dim and 9 or 14
		animator:Play(dot, dim and 0.8 or 0.38, function(t)
			dot.Visible = t < 1
			local e = GearKit.Ease.InOutSine(t)
			local point = bezier(path[1], path[2], path[3], path[4], e)
			dot.Position = UDim2.fromOffset(point.X, point.Y)
			local s = size * (0.8 + 0.3 * GearKit.Bump(t))
			dot.Size = UDim2.fromOffset(s, s)
			dot.BackgroundTransparency = dim and 0.45 or 0.15
		end, function()
			dot.Visible = false
			if not dim and GearKit.EffectsOn(ctx) then
				local ring = sparks:Next()
				local stroke = ring:FindFirstChild("Stroke") :: UIStroke
				local at = attach
				animator:Play(ring, 0.3, function(t)
					ring.Visible = t < 1
					local s = 10 + 26 * GearKit.Ease.OutCubic(t)
					ring.Position = UDim2.fromOffset(at.X, at.Y)
					ring.Size = UDim2.fromOffset(s, s)
					stroke.Transparency = t
					ring.Rotation = 90 * t
				end, function()
					ring.Visible = false
				end)
			end
		end)
	end

	local function brainPulse()
		animator:Play("brain", 0.26, function(t)
			local b = GearKit.Bump(t)
			pulseScale.Scale = 1 + 0.07 * b
			halo.BackgroundTransparency = 0.86 - 0.3 * b
			haloCore.BackgroundTransparency = 0.8 - 0.3 * b
			for _, electrode in ipairs(electrodes) do
				electrode.Glow.BackgroundTransparency = 0.6 - 0.45 * b
			end
		end)
	end

	ctx.Connect(ctx.State.Clicked, function()
		if not ctx.IsVisible() or not piece:IsShown() then
			return
		end
		brainPulse()
		firePulse(false)
	end)

	-- Au repos : une pensée + un clin d'œil
	GearKit.Every(ctx, 3.5, 6, function()
		if not piece:IsShown() then
			return
		end
		firePulse(true)
		if random:NextNumber() < 0.6 then
			animator:Play("blink", 0.18, function(t)
				local closed = t < 0.6
				for _, eye in ipairs(eyes) do
					eye.Size = UDim2.fromOffset(5.5, closed and 1.6 or 7)
					eye.Position = UDim2.fromOffset(eye.Position.X.Offset, closed and 45 or 42)
				end
			end)
		end
	end)

	active[ctx] = function()
		piece:Destroy()
		if cable.Parent then
			cable:Destroy()
		end
	end
end

function NeuralLink.Stop(ctx)
	local cleanup = active[ctx]
	active[ctx] = nil
	if cleanup then
		cleanup()
	end
end

return NeuralLink
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="143">
          <Properties>
            <string name="Name">NewsTicker</string>
            <string name="Source"><![CDATA[--[[
	NewsTicker (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > NewsTicker

	Un vrai bandeau de chaîne d'info en continu, tout en haut de l'écran :
	  - à gauche : logo de la chaîne ("DC24", reflet qui passe), badge
	    "● DIRECT" (point rouge qui pulse) et cartouche de RUBRIQUE qui
	    affiche la rubrique du titre en cours de lecture (SPORT, MÉTÉO...),
	    en jaune "URGENT" ou "ALERTE" quand il le faut ;
	  - au centre : les titres absurdes qui défilent en douceur (une seule
	    "piste" déplacée par image), chacun précédé d'une étiquette de
	    rubrique colorée, séparés par un losange ; plus de 170 titres + des
	    titres "dynamiques" qui utilisent les stats du joueur en direct ;
	  - à droite : un segment qui tourne (météo de Clicville, indices
	    boursiers fantaisistes, production du joueur) puis l'horloge
	    (deux-points qui clignotent) ;
	  - "ALERTE INFO" de temps en temps : le bandeau flashe, une bande
	    "ALERTE INFO" traverse le défilé, et un bandeau descend sous le
	    ticker (calque Overlay, non cliquable) avec un titre spécial.
	Survoler le bandeau à la souris le ralentit. Cliquer sur un titre =
	Interact("Headline") : le serveur limite les récompenses
	(Config.Interactions.Headline) et le "+X" confirmé (OnBonus "Headline")
	s'affiche juste sous le bandeau.
]]

local Players = game:GetService("Players")
local TextService = game:GetService("TextService")

local Locale = require(game:GetService("ReplicatedStorage").Shared.Locale)

local NewsTicker = {}
NewsTicker.Slot = "Ticker"

local HEIGHT = 30 -- hauteur du slot (pixels "design")
local LOGO_W = 58 -- logo de la chaîne
local LIVE_W = 66 -- badge "● DIRECT"
local TAG_W = 108 -- cartouche de rubrique (bord droit en biais)
local LEFT_W = LOGO_W + LIVE_W + TAG_W + 10
local CLOCK_W = 60
local SEGMENT_W = 158 -- météo / marchés (masqué sur les écrans étroits)
local SEGMENT_MIN_WIDTH = 900 -- largeur "design" minimale pour l'afficher
local SEGMENT_TIME = 6 -- secondes par panneau du segment
local TEXT_SIZE = 17
local CHIP_TEXT_SIZE = 11
local SEPARATOR_W = 34
local SPEED = 92 -- pixels "design" par seconde
local SLOW_SPEED = 26 -- vitesse quand la souris survole le bandeau
local MAX_ITEMS = 14 -- sécurité : titres vivants au maximum
local URGENT_CHANCE = 1 / 8
local DYNAMIC_CHANCE = 0.22 -- part des titres "dynamiques" (stats du joueur)
local BREAKING_MIN, BREAKING_MAX = 70, 130 -- secondes entre deux "ALERTE INFO"
local BREAKING_TIME = 5.5
local BANNER_W, BANNER_H = 560, 58
local REBASE_AT = 4000 -- recentre la piste de temps en temps (précision)

-- Rubriques : texte de l'étiquette (anglais, traduit avec Locale.T) + couleur
local CATEGORIES = {
	SPORT = { Text = "SPORT", Color = Color3.fromRGB(30, 170, 80) },
	METEO = { Text = "WEATHER", Color = Color3.fromRGB(0, 160, 220) },
	BOURSE = { Text = "MARKETS", Color = Color3.fromRGB(235, 170, 0) },
	INSOLITE = { Text = "WEIRD", Color = Color3.fromRGB(150, 70, 225) },
	POLITIQUE = { Text = "POLITICS", Color = Color3.fromRGB(40, 90, 210) },
	SCIENCE = { Text = "SCIENCE", Color = Color3.fromRGB(0, 150, 140) },
	TECH = { Text = "TECH", Color = Color3.fromRGB(70, 90, 125) },
	CULTURE = { Text = "CULTURE", Color = Color3.fromRGB(230, 70, 140) },
	SANTE = { Text = "HEALTH", Color = Color3.fromRGB(110, 190, 40) },
	PEOPLE = { Text = "CELEBS", Color = Color3.fromRGB(255, 120, 30) },
	ANIMAUX = { Text = "ANIMALS", Color = Color3.fromRGB(170, 110, 50) },
	URGENT = { Text = "URGENT", Color = Color3.fromRGB(255, 210, 30) },
}

-- Titres absurdes { rubrique, texte } (déjà en majuscules), une liste par langue
local HEADLINES = {
	en = {
		{ "ANIMAUX", "THE FROGS HAVE DISAPPEARED... OR MAYBE NOT, HE'S NOT SURE" },
		{ "INSOLITE", "MAN HAS BEEN CLICKING FOR 3 DAYS, SAYS HE'S FINE" },
		{ "SANTE", "ARE COLD SHOWERS THE FUTURE? EXPERTS SHIVER" },
		{ "POLITIQUE", "PIGEON ELECTED MAYOR OF SMALL TOWN, PROMISES MORE CRUMBS" },
		{ "INSOLITE", "ALERT: MONDAY IS COMING AGAIN THIS WEEK" },
		{ "SCIENCE", "SCIENTISTS CONFIRM THE COUCH IS VERY COMFY" },
		{ "INSOLITE", "SOCK FOUND AFTER 12 YEARS ON THE RUN" },
		{ "TECH", "WI-FI GOES DOWN, FAMILY DISCOVERS THEY HAVE A BACKYARD" },
		{ "ANIMAUX", "CAT REFUSES TO GET OFF THE KEYBOARD, NEGOTIATIONS COLLAPSE" },
		{ "SCIENCE", "MOON ANNOUNCES CAREER BREAK, TIDES CONCERNED" },
		{ "SPORT", "SNAIL BREAKS WORLD SLOWNESS RECORD... FOR THE 3RD TIME" },
		{ "METEO", "CLOUDS GO ON STRIKE: SUNSHINE BY DEFAULT ALL WEEK" },
		{ "INSOLITE", "A BUTTON WAS CLICKED, NOBODY KNOWS WHY" },
		{ "BOURSE", "DOPAMINE HITS ALL-TIME HIGH, ECONOMISTS APPLAUD" },
		{ "CULTURE", "BAGUETTE NAMED ACCESSORY OF THE YEAR" },
		{ "ANIMAUX", "GOLDFISH FORGETS ITS OWN BIRTHDAY, AGAIN" },
		{ "SANTE", "RESEARCHERS ARE ADAMANT: YOU SHOULD DRINK WATER" },
		{ "TECH", "GRANDPA INVENTS THE TWO-FINGER CLICK, THE WORLD BOWS DOWN" },
		{ "INSOLITE", "OFFICE COFFEE MACHINE SUES FOR OVERWORK" },
		{ "ANIMAUX", "DUCK CROSSES THE ROAD: MOTIVE STILL UNKNOWN" },
		{ "INSOLITE", "GREEN BEANS COMPLAIN ABOUT ALWAYS BEING LEFT ON THE PLATE" },
		{ "METEO", "HAMSTER-SHAPED CLOUD SPOTTED ABOVE THE CITY" },
		{ "TECH", "EXPERT: “CLICKING IS LIKE BREATHING, BUT WITH YOUR FINGER”" },
		{ "INSOLITE", "KID ASKS “WHY?” 400 TIMES, PARENTS BOOK A VACATION" },
		{ "INSOLITE", "HOUSEPLANT WATERED TWICE IN ONE DAY, NOW IN A STATE OF SHOCK" },
		{ "SCIENCE", "SUN RISES IN THE EAST, NOBODY SURPRISED" },
		{ "SPORT", "BOUNCING LOGO GRAZES THE CORNER, NATION HOLDS ITS BREATH" },
		{ "TECH", "RECORD: 47 TABS OPEN, COMPUTER BEGS FOR MERCY" },
		{ "POLITIQUE", "PINEAPPLE PIZZA SPLITS TOWN, EMERGENCY COUNCIL MEETING CALLED" },
		{ "CULTURE", "GOLDEN STARS ARE FLEETING, PHILOSOPHERS REMIND US" },
		{ "SPORT", "HAMSTER RUNS 20 MILES IN HIS WHEEL, STILL HASN'T GOTTEN ANYWHERE" },
		{ "SPORT", "NAPPING BECOMES AN OLYMPIC SPORT, SPAIN HEAVY FAVORITE" },
		{ "INSOLITE", "FLY ENTERS LIVING ROOM: TOTAL PANIC" },
		{ "SANTE", "BUBBLE WRAP FINALLY RECOGNIZED AS THERAPY" },
		{ "TECH", "ROBOT VACUUM BECOMES SELF-AWARE, JUST WANTS TO BE LOVED" },
		{ "POLITIQUE", "POLL: 100% OF RESPONDENTS RESPONDED TO THE POLL" },
		{ "ANIMAUX", "THE FROGS ARE BACK, THEY WERE JUST ON VACATION" },
		{ "SCIENCE", "TOAST LANDS BUTTER-SIDE DOWN, SCIENTISTS STUNNED" },
		{ "METEO", "100% CHANCE OF WEATHER TOMORROW" },
		{ "INSOLITE", "BOY SAYS “5 MORE MINUTES”, IT'S 3 A.M." },
		{ "INSOLITE", "SLIPPERS GO ON STRIKE, DEMAND CLEANER FEET" },
		{ "BOURSE", "DOPAMINE MARKET GOES UP, DOWN, THEN UP AGAIN. DEVELOPING STORY" },
		{ "INSOLITE", "CONFUSED SUNFLOWER HAS BEEN STARING AT THE LIVING ROOM LAMP SINCE TUESDAY" },
		{ "METEO", "THE OCEAN REMINDS EVERYONE IT'S STILL THERE, JUST IN CASE" },
		{ "ANIMAUX", "SHEEP COUNTS HUMANS TO FALL ASLEEP, IS NOW UP TO 8 BILLION" },
		{ "INSOLITE", "UNICORN SPOTTED IN THE SUBURBS, TURNS OUT TO BE A HORSE HOLDING AN ICE CREAM CONE" },
		-- Sport
		{ "SPORT", "ROCK-PAPER-SCISSORS WORLD CUP CANCELED: EVERYONE PICKED ROCK" },
		{ "SPORT", "MARATHON RUNNER STOPS AT MILE 1 TO PET A DOG, CROWD APPROVES" },
		{ "SPORT", "CURLING VOTED CALMEST SPORT, BROOMS CELEBRATE IN SILENCE" },
		{ "SPORT", "SOCCER TEAM SCORES AN OWN GOAL OUT OF POLITENESS" },
		{ "SPORT", "FLEA SETS HIGH JUMP WORLD RECORD, DECLINES ALL INTERVIEWS" },
		{ "SPORT", "TOUR DE FRANCE ON SCOOTERS: THE PACK ARRIVES 3 WEEKS LATE" },
		{ "SPORT", "REFEREE ENDS THE GAME BY MISTAKE, HE JUST HAD THE HICCUPS" },
		{ "SPORT", "SYNCHRONIZED DUCK SWIMMING DAZZLES THE JUDGES" },
		{ "SPORT", "PING-PONG PLAYER LOSES THE BALL, MATCH ENTERS ITS 4TH HOUR" },
		-- Météo
		{ "METEO", "CODE ORANGE CONFETTI WARNING FOR THE ENTIRE NORTH" },
		{ "METEO", "IT'S RAINING CATS AND DOGS: CATS FURIOUS, DOGS DELIGHTED" },
		{ "METEO", "RAINBOW APOLOGIZES FOR FORGETTING PURPLE" },

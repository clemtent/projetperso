		["%s more 💧 earned to get in"] = "Encore %s 💧 gagnés pour y entrer",
		["%s more 💧 to pass %s"] = "Encore %s 💧 pour dépasser %s",
		["%s short"] = "Il manque %s",
		["%s tier"] = "Palier %s",
		["%s unlocked, thank you!"] = "%s débloqué, merci !",
		["%s • donations are about to start 💸"] = "%s • les dons vont commencer 💸",
		["%s • thanks, viewers"] = "%s • merci les viewers",
		["%s: it's yours!"] = "%s : à toi !",
		["%s: yours forever!"] = "%s : à toi pour toujours !",
		["+%d more achievements!"] = "+%d autres succès !",
		["+%s%% forever"] = "+%s %% pour toujours",
		["+%s%% gains forever • equipped automatically"] = "+%s %% de gains pour toujours • équipé automatiquement",
		["+3 chests"] = "+3 coffres",
		["A Roblox game  •  thanks for playing 💙"] = "Un jeu Roblox  •  merci de jouer 💙",
		["ACHIEVEMENT SPREE!"] = "SUCCÈS EN RAFALE !",
		["ACHIEVEMENT UNLOCKED!"] = "SUCCÈS DÉBLOQUÉ !",
		["Add the Game Pass ID in Config (%s)"] = "Ajoute l'ID du Game Pass dans Config (%s)",
		["All time"] = "Depuis toujours",
		["almost here…"] = "ça arrive…",
		["Alone on the server: invite your friends!"] = "Seul(e) sur le serveur : invite tes amis !",
		["Already claimed today! Next gift in %s."] = "Déjà récupéré aujourd'hui ! Prochain cadeau dans %s.",
		["Applied the next time you join"] = "Appliquée la prochaine fois que tu rejoins le jeu",
		["Auto-click"] = "Auto-clic",
		["Average %s"] = "Moyenne %s",
		["Away 12 h"] = "Absent 12 h",
		["Away 2 h"] = "Absent 2 h",
		["Breathe..."] = "Respire...",
		["Button color"] = "Couleur du bouton",

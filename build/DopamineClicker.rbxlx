		Parent = hero.Face,
	})
	hero.Brow = frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.6, 0.12),
		Size = UDim2.fromScale(0.3, 0.08),
		BackgroundColor3 = HAIR,
		ZIndex = 2,
		Parent = hero.Face,
	}, UDim.new(0.5, 0))
	hero.Mouth = frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.62, 0.78),
		Size = UDim2.fromScale(0.3, 0.1),
		BackgroundColor3 = MOUTH,
		ZIndex = 2,

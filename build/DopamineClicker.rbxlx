        <Item class="ModuleScript" referent="177">
          <Properties>
            <string name="Name">FR_V8_House</string>
            <string name="Source"><![CDATA[--[[
	FR_V8_House (ModuleScript) — traductions françaises de la maison (v8 :
	objets sur les meubles, animaux qui bougent, verrous "visites à l'océan")
	Emplacement : ReplicatedStorage > Shared > Lang > FR_V8_House
]]

return {
	fr = {
		["After 1 ocean visit"] = "Après 1 visite à l'océan",
		["After %d ocean visits"] = "Après %d visites à l'océan",
		["✋ Drag to move  •  🧁 small items go ON tables & shelves"] = "✋ Glisse pour déplacer  •  🧁 les petits objets se posent SUR les meubles",
	},
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="178">
          <Properties>
            <string name="Name">FR_V8_LiveLofi</string>
            <string name="Source"><![CDATA[--[[
	FR_V8_LiveLofi (ModuleScript - traductions françaises)
	Emplacement : ReplicatedStorage > Shared > Lang > FR_V8_LiveLofi

	Nouveaux textes (v8) des stimuli LiveStream (habillage du live, chat,
	objectif d'abonnés) et Lofi (lecteur, chambre) :
	["texte anglais exact"] = "texte français".
]]

return {
	fr = {
		-- LiveStream
		["ASMR mukbang"] = "mukbang ASMR",
		["Stream chat"] = "Chat du live",
		["Send a message"] = "Envoyer un message",
		["💜 Follower goal"] = "💜 Objectif abonnés",
		["GOAL!"] = "OBJECTIF !",
		["🎯 Follower goal reached: <b>%s</b>!"] = "🎯 Objectif d'abonnés atteint : <b>%s</b> !",

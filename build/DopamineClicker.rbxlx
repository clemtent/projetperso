House3DScale.TABLE = TABLE

local F_MIN, F_MAX = 0.7, 1.8
local S_MIN, S_MAX = 0.75, 1.5

function House3DScale.Of(item: any): (number, number)
	if type(item) ~= "table" or item.Placement == "Wall" or item.Category == "Pets" then
		return 1, 1
	end
	local row = TABLE[tostring(item.Id)]
	if not row then
		return 1, 1
	end
	local f = math.clamp(tonumber(row[1]) or 1, F_MIN, F_MAX)
	local s = math.clamp(tonumber(row[2]) or 1, S_MIN, S_MAX)
	return f, s
end

return House3DScale
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">House3DScene</string>
              <string name="Source"><![CDATA[--[[
	House3DScene (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > House3DScene

	Construit la "maison de poupée" 3D d'UNE pièce pour la vue 3D (House3D),
	loin du monde (autour de ORIGIN), dans un Folder du Workspace. v9.1 :
	TOUT est en vraie géométrie 3D, avec des Parts OPAQUES de taille
	normale (aucune pièce géante, aucune pièce invisible qui porte le
	décor) :
	  - studio : grande boîte pastel (Parts opaques) + pelouse sur un socle ;
	  - pièce : dalle, sol (couleur + matière du sol de la pièce), mur du
	    fond et murs de côté (coque + "peau" couleur du papier peint),
	    plinthes, moulures, poutre, fenêtre en relief (cadre, croisillon,
	    rebord, tringle, rideaux, vue dessinée sur la vitre), prise ;
	    les motifs (papier peint, sol) ne sont qu'une DÉCORATION facultative
	    (SurfaceGui de taille fixe sur la face d'une pièce normale) : la
	    couleur de la pièce suffit déjà ;
	  - objets (v9.3) : TOUS en vrais modèles 3D (House3DRecipes +
	    House3DCritters / House3DObjects / House3DToys), aux couleurs du
	    dessin 2D de l'objet (et de sa variante de couleur), jamais de carton
	    découpé ; placés par House3DLayout (posés SUR le vrai dessus 3D des
	    meubles, chaises tournées vers leur table, F = miroir, R = rotation) ;
	    arrivée en douceur et respiration des animaux (BulkMoveTo, ≤ 30 Hz) ;
	  - lumières : plafonnier, soleil de la fenêtre (SpotLight), lampes
	    (PointLight), ambiance de la pièce (Room.Mood : couleur, intensité,
	    petites particules) ; l'éclairage du lieu est réglé par House3D
	    (scene.Lighting) et remis à la fermeture.

	v9.6 ("le mode 3D c'est n'importe quoi") : la maquette a les MÊMES
	mesures que la pièce de la maison en ville (WorldLayout.PX / DEPTH /
	WALL_H) : mêmes places d'objets qu'en ville (écart mesuré 0 stud au lieu
	de 2,5), fenêtre à la place de la fenêtre 2D (aperçu et ville) ; lumières
	douces (≤ 1,2, soleil 1,6 au plus, exposition ≤ 0, éclair d'orage doux).

	Champs de pièce lus (tous facultatifs, valeurs par défaut sinon) :
	  Wallpaper, Floor, Trim (Config.HouseTrimsById), Mood
	  (Config.HouseMoodsById), View (Config.HouseViewsById) ; objets :
	  { I, X, Y, S, Z, F, C, R } (C = variante de couleur, HouseTints ;
	  R = rotation en degrés, multiple de 15, monde "Dopamine Town").

	API :
	  House3DScene.new(room, sizeId, night) -> Scene   (décor construit tout de suite)
	  scene.BuildItems(alive, progress?)   objets, étalés sur plusieurs images (yield)
	  scene.SetNight(night)
	  scene.Lighting(night) -> { [propriété de Lighting]: valeur }
	  scene.UpdateWalls(eye)   baisse le mur de côté entre la caméra et la pièce
	  scene.Step(dt)           arrivée des objets, ambiance (appelé chaque image)
	  scene.Destroy()

	API du monde (v9.3, Dopamine Town : n'utilise ni la vue 3D, ni la
	caméra, ni l'interface ; utilisable depuis n'importe quel script client) :
	  House3DScene.BuildRoomShell(roomData, sizeDef?, options?) -> Model "RoomShell"
	    options : Scale (studs par px de la pièce 2D ; 32/760 = ~32 studs de
	    large), Depth (24), WallHeight (14), Doors ({ "Front" } ; "Left",
	    "Right", "Back"), DoorWidth (6), DoorHeight (9), Front (true = mur
	    avant), Ceiling (false), Patterns (true = motifs décoratifs).
	    PrimaryPart "Floor" ; pivot = centre du dessus du sol ; mur du fond
	    vers -Z, avant (porte) vers +Z ; sol et murs solides (CanCollide),
	    vraies ouvertures de porte ; attributs Width, Depth, WallHeight,
	    Scale, RoomWpx.
	  House3DScene.PlaceItems(roomModel, roomData, options?) -> { Model }
	    options : Night, Collide, Query, Yield. Construit les objets (voir
	    House3DRecipes.BuildItem) dans roomModel.Items, avec le même passage
	    2D -> 3D que la vue 3D (au pivot ACTUEL de la coque) ; attribut
	    "EntryIndex" = index dans roomData.Placed ; entry.R = rotation.
	  Devant d'un modèle d'objet = -Z (convention LookVector de Roblox).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local HouseCommon = require(script.Parent.HouseCommon)

-- v9.5 🖥️ objets "Dopamine Setup" vivants dans l'aperçu (World/LiveProps, chargé à la demande)
local liveProps: any = nil
local function getLiveProps(): any
	if liveProps == nil then
		local ok, result = pcall(function()
			local world = script.Parent.Parent.Parent:FindFirstChild("World")
			local module = world and world:FindFirstChild("LiveProps")
			return module and require(module :: ModuleScript) or false
		end)
		liveProps = ok and result or false
	end
	return liveProps or nil
end
local HousePatterns = require(script.Parent.HousePatterns)
local House3DFloor = require(script.Parent.House3DFloor)
local House3DKit = require(script.Parent.House3DKit)
local House3DLayout = require(script.Parent.House3DLayout)

type Placed = HouseCommon.Placed

local House3DScene = {}

House3DScene.ORIGIN = Vector3.new(0, 5000, 0) -- loin du monde (au-dessus de tout)
House3DScene.FOLDER_NAME = "House3DPreview"

-- v9.6 (PREVIEW96) : la maquette a EXACTEMENT les mesures d'une pièce de la
-- maison en ville (WorldLayout : 0,036 stud / px, 24 de profondeur, 12 sous
-- plafond). Avant : 0,05 / 22 / 10,1 -> pièce 1,4 fois plus large mais
-- moins profonde, objets tassés vers l'avant et décalés jusqu'à 2,5 studs
-- par rapport à la même pièce en ville.
local WorldLayout = require(ReplicatedStorage.Shared.WorldLayout)
local PX = tonumber(WorldLayout.PX) or 0.036 -- studs par px de maquette de la pièce 2D
local ROOM_BASE_WIDTH = 760 -- (= HouseRoom.BASE_WIDTH)
local ROOM_HEIGHT = 440 -- (= HouseRoom.HEIGHT)
local SIDE_PX = 42 -- murs de côté en perspective de la pièce 2D (HouseRoom)
local DEPTH = tonumber(WorldLayout.DEPTH) or 24 -- (studs) profondeur de la pièce
local WALL_H = tonumber(WorldLayout.WALL_H) or 12 -- (studs) hauteur des murs
local DEPTH_PX = math.floor(DEPTH / PX)
local WALL_PX = math.floor(WALL_H / PX) -- hauteur des toiles des murs (motifs non étirés)
local WALL_T = 0.8 -- épaisseur de la coque
local SKIN = 0.1 -- épaisseur de la "peau" papier peint
local SLAB = 1.2
local LAWN_SIDE = 4
local LAWN_FRONT = 5
local LAWN_BACK = 3
local MAX_LAMPS = 8 -- vraies lumières d'objets au plus
-- v9.6 ("flash bang") : lumières douces, jamais plus de 1,2 de luminosité
local LIGHT_MAX = 1.2
local function soft(brightness: number): number
	return math.clamp(brightness, 0, LIGHT_MAX)
end
local DROP = 1.4 -- (studs) les objets tombent doucement à leur place
local DROP_TIME = 0.45
local BATCH_ITEMS = 4
local BATCH_TIME = 0.008

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local C = HouseCommon.Colors
local SHELL = Color3.fromRGB(252, 214, 232)
local BASE_PINK = Color3.fromRGB(242, 188, 216)
local GRASS = Color3.fromRGB(140, 214, 140)
local CREAM = Color3.fromRGB(255, 247, 236)
local M = Enum.Material

-- Studio (fond) : bandes du bas vers le haut (jour / nuit)
local SKY_DAY = { Color3.fromRGB(255, 236, 228), Color3.fromRGB(255, 222, 238), Color3.fromRGB(226, 226, 255), Color3.fromRGB(196, 222, 255), Color3.fromRGB(176, 212, 255) }
local SKY_NIGHT = { Color3.fromRGB(120, 84, 150), Color3.fromRGB(86, 62, 132), Color3.fromRGB(58, 46, 112), Color3.fromRGB(36, 32, 86), Color3.fromRGB(22, 20, 62) }

local DEFAULT_MOOD = { Tint = WHITE, Amount = 0, Light = Color3.fromRGB(255, 244, 230), Brightness = 1, Effect = "None" }

export type Scene = {
	Folder: Folder,
	Width: number,
	Depth: number,
	WallHeight: number,
	Focus: Vector3,
	BoundsMin: Vector3,
	BoundsMax: Vector3,
	FrontZ: number,
	ItemCount: number,
	BuildItems: (alive: () -> boolean, progress: ((done: number, total: number) -> ())?) -> (),
	SetNight: (night: boolean) -> (),
	Lighting: (night: boolean) -> { [string]: any },
	UpdateWalls: (eye: Vector3) -> (),
	Step: (dt: number) -> (),
	Destroy: () -> (),
}

type Build = House3DLayout.Build
type Pet = { Parts: { BasePart }, Finals: { CFrame }, Phase: number, Amount: number }

type SideWall = {
	Side: number,
	Shell: BasePart,
	Skin: BasePart,
	Crown: BasePart,
	Skirt: BasePart,
	Edge: BasePart,
	Gui: SurfaceGui?,
	Lowered: boolean,
	-- (v9.6) écarts anti-scintillement de la pose "levée" (gardés en baissant / relevant)
	Deltas: { [BasePart]: { P: Vector3, S: Vector3 } }?,
}

type Arrival = { Parts: { BasePart }, Finals: { CFrame }, Delay: number, Clock: number }

----------------------------------------------------------------------
-- Outils
----------------------------------------------------------------------

local newPart = House3DKit.NewPart

-- Déplace beaucoup de pièces d'un coup (BulkMoveTo ; sinon une par une)
local function moveParts(parts: { BasePart }, cframes: { CFrame })
	local ok = pcall(function()
		workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end)
	if not ok then
		for index, p in ipairs(parts) do
			p.CFrame = cframes[index]
		end
	end
end

local function noise(a: number, b: number): number
	local value = math.sin(a * 12.9898 + b * 78.233) * 43758.5453
	return value - math.floor(value)
end

local function finite(value: any, default: number): number
	local number = tonumber(value)
	if number == nil or number ~= number or number == math.huge or number == -math.huge then
		return default
	end
	return number
end

local function requireSibling(name: string): any
	local module = script.Parent:FindFirstChild(name)
	if not module or not module:IsA("ModuleScript") then
		return nil
	end
	local ok, result = pcall(require, module)
	if ok and type(result) == "table" then
		return result
	end
	return nil
end

local function configTable(name: string): { [string]: any }
	local okConfig, Config = pcall(function()
		return require(ReplicatedStorage.Shared.Config)
	end)
	if okConfig and type(Config) == "table" and type((Config :: any)[name]) == "table" then
		return (Config :: any)[name]
	end
	return {}
end

local function asColor(value: any, default: Color3): Color3
	if typeof(value) == "Color3" then
		return value
	end
	return default
end

-- Fenêtre de la pièce 2D (HouseRoom : à gauche, 104 x 92 px, 36 px sous le
-- haut du mur) -> rectangle sur le mur du fond, avec le MÊME passage 2D -> 3D
-- que les objets muraux (House3DLayout) : (centre x, centre y, largeur,
-- hauteur) en studs. v9.6 : aperçu ET ville (un tableau posé à côté de la
-- fenêtre en 2D ne la chevauche plus en 3D)
local function windowRect(roomWpx: number, scale: number): (number, number, number, number)
	local wallPx = math.floor(ROOM_HEIGHT * (tonumber(HouseCommon.Config.WallRatio) or 0.46) + 0.5)
	local k = roomWpx / math.max(1, roomWpx - 2 * SIDE_PX)
	local x2D = SIDE_PX + math.floor(roomWpx * 0.1) + 52
	local cx = ((x2D - SIDE_PX) * k - roomWpx / 2) * scale
	local ww, wh = 104 * k * scale, 92 * scale
	local cy = (wallPx - 36) * scale - wh / 2
	return cx, cy, ww, wh
end

-- Matière d'un mur / d'un sol selon son motif (la couleur suffit déjà)
local WALL_MATERIAL: { [string]: Enum.Material } = {
	Bricks = M.Brick,
	Wood = M.WoodPlanks,
}
local FLOOR_MATERIAL: { [string]: Enum.Material } = {
	Wood = M.WoodPlanks,
	Herringbone = M.WoodPlanks,
	Carpet = M.Fabric,
	Marble = M.Marble,
	Tiles = M.SmoothPlastic,
	Checker = M.SmoothPlastic,
	Grass = M.Grass,
	Terrazzo = M.Marble,
	Mosaic = M.SmoothPlastic,
	Clouds = M.Fabric,
	Starry = M.SmoothPlastic,
	Concrete = M.Concrete,
	Court = M.WoodPlanks,
	Turf = M.Grass,
	TreadPlate = M.DiamondPlate,
	Road = M.Asphalt,
	Lava = M.CrackedLava,
}

----------------------------------------------------------------------
-- Scène
----------------------------------------------------------------------

function House3DScene.new(room: any, sizeId: string?, startNight: boolean?): Scene
	local config = HouseCommon.Config
	local size = HouseCommon.SizesById[sizeId or ""] or config.Sizes[1]
	local widthFactor = tonumber(size and size.Width) or 1
	local roomWpx = math.floor(ROOM_BASE_WIDTH * widthFactor + 0.5)
	local W = roomWpx * PX
	-- (murs de la ville : la bande murale 2D en occupe le bas, comme en ville)
	local WH = WALL_H
	local D = DEPTH
	local origin = House3DScene.ORIGIN
	local roomData = type(room) == "table" and room or {}
	local wallpaper = HouseCommon.GetRoomWallpaper(roomData)
	local floorStyle = HouseCommon.GetRoomFloor(roomData)
	local wallA = wallpaper and wallpaper.A or C.PinkSoft
	local floorA = floorStyle and floorStyle.A or C.Lilac
	local night = startNight == true
	local destroyed = false

	-- Personnalisation (v9.1) : moulures, ambiance, vue de la fenêtre
	local trimEntry = configTable("HouseTrimsById")[tostring(roomData.Trim or "Cream")]
	local trim = asColor(type(trimEntry) == "table" and trimEntry.Color, CREAM)
	local moodRaw = configTable("HouseMoodsById")[tostring(roomData.Mood or "Sunny")]
	local mood = {
		Tint = asColor(type(moodRaw) == "table" and moodRaw.Tint, DEFAULT_MOOD.Tint),
		Amount = math.clamp(finite(type(moodRaw) == "table" and moodRaw.Amount, 0), 0, 1),
		Light = asColor(type(moodRaw) == "table" and moodRaw.Light, DEFAULT_MOOD.Light),
		Brightness = math.clamp(finite(type(moodRaw) == "table" and moodRaw.Brightness, 1), 0.2, 2),
		Effect = type(moodRaw) == "table" and type(moodRaw.Effect) == "string" and moodRaw.Effect or "None",
	}
	local views = configTable("HouseViewsById")
	local viewEntry = views[tostring(roomData.View or "Garden")] or views.Garden
	local HouseViews = requireSibling("HouseViews")

	local folder = Instance.new("Folder")
	folder.Name = House3DScene.FOLDER_NAME

	local function at(x: number, y: number, z: number): Vector3
		return origin + Vector3.new(x, y, z)
	end
	local X_AXIS = Vector3.new(1, 0, 0)
	local Y_AXIS = Vector3.new(0, 1, 0)
	local BACKWARD = Vector3.new(0, 0, -1)

	local function part(name: string, sizeV: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?, shadow: boolean?): BasePart
		local p = newPart("Part", name, sizeV, cframe, color, material)
		p.CastShadow = shadow == true
		p.Parent = folder
		return p
	end
	-- Pièce orientée (droite, haut) : la face Back (+Z local) regarde `right x up`
	local function facing(name: string, center: Vector3, right: Vector3, up: Vector3, w: number, h: number, t: number, color: Color3, material: Enum.Material?): BasePart
		local normal = right:Cross(up)
		return part(name, Vector3.new(w, h, t), CFrame.fromMatrix(center - normal * (t / 2), right, up), color, material)
	end

	-- Ce qui change la nuit / avec l'ambiance
	local skyBands: { { Part: BasePart, Index: number } } = {}
	local viewHolders: { Frame } = {}
	local itemLights: { { Light: PointLight, Base: number } } = {}
	local glowParts: { BasePart } = {}
	local ceilingLight: PointLight? = nil
	local fillLight: PointLight? = nil
	local sunLight: SpotLight? = nil
	local sideWalls: { SideWall } = {}
	local arrivals: { Arrival } = {}
	local effects: { ParticleEmitter } = {}
	local discoClock = 0
	local stormClock = 0

	------------------------------------------------------------------
	-- Studio : boîte pastel en bandes (Parts opaques, pas d'ombre)
	------------------------------------------------------------------
	local centerZ = D / 2
	local HX, HZ = 110, 110
	local yMin, yMax = -40, 110
	local bands = #SKY_DAY
	local bandH = (yMax - yMin) / bands
	for index = 1, bands do
		local y = yMin + (index - 0.5) * bandH
		for _, spec in ipairs({
			{ "Back", Vector3.new(0, y, centerZ - HZ), Vector3.new(HX * 2 + 2, bandH + 0.2, 1) },
			{ "Front", Vector3.new(0, y, centerZ + HZ), Vector3.new(HX * 2 + 2, bandH + 0.2, 1) },
			{ "Left", Vector3.new(-HX, y, centerZ), Vector3.new(1, bandH + 0.2, HZ * 2 + 2) },
			{ "Right", Vector3.new(HX, y, centerZ), Vector3.new(1, bandH + 0.2, HZ * 2 + 2) },
		}) do
			local p = part("Studio" .. spec[1] .. index, spec[3], CFrame.new(at(spec[2].X, spec[2].Y, spec[2].Z)), SKY_DAY[index], M.SmoothPlastic, false)
			table.insert(skyBands, { Part = p, Index = index })
		end
	end
	table.insert(skyBands, { Part = part("StudioTop", Vector3.new(HX * 2 + 2, 1, HZ * 2 + 2), CFrame.new(at(0, yMax, centerZ)), SKY_DAY[bands], M.SmoothPlastic, false), Index = bands })
	table.insert(skyBands, { Part = part("StudioBottom", Vector3.new(HX * 2 + 2, 1, HZ * 2 + 2), CFrame.new(at(0, yMin, centerZ)), SKY_DAY[1], M.SmoothPlastic, false), Index = 1 })
	-- Nuages (boules blanches, derrière la maison)
	for index = 1, 6 do
		local cx = -90 + index * 26 + (noise(index, 1) - 0.5) * 12
		local cy = -2 + noise(index, 2) * 8
		local cz = centerZ - HZ + 6 + noise(index, 3) * 8
		for puff = 0, 2 do
			local ball = part("Cloud", Vector3.new(1, 1, 1) * (5 + puff % 2 * 2), CFrame.new(at(cx + (puff - 1) * 4, cy + (puff % 2) * 1.5, cz)), WHITE, M.SmoothPlastic, false)
			;(ball :: Part).Shape = Enum.PartType.Ball
			table.insert(skyBands, { Part = ball, Index = 0 })
		end
	end

	------------------------------------------------------------------
	-- Socle : pelouse sur un gâteau rose
	------------------------------------------------------------------
	local lawnW = W + WALL_T * 2 + LAWN_SIDE * 2
	local lawnZ0 = -WALL_T - LAWN_BACK
	local lawnZ1 = D + LAWN_FRONT
	local lawnD = lawnZ1 - lawnZ0
	local lawnTop = -SLAB
	part("Lawn", Vector3.new(lawnW, 0.8, lawnD), CFrame.new(at(0, lawnTop - 0.4, (lawnZ0 + lawnZ1) / 2)), GRASS, M.Grass, false)
	part("Base", Vector3.new(lawnW - 0.9, 2.6, lawnD - 0.9), CFrame.new(at(0, lawnTop - 0.8 - 1.3, (lawnZ0 + lawnZ1) / 2)), BASE_PINK, M.SmoothPlastic, false)
	part("BaseTrim", Vector3.new(lawnW - 0.3, 0.35, lawnD - 0.3), CFrame.new(at(0, lawnTop - 0.8 - 2.5, (lawnZ0 + lawnZ1) / 2)), CREAM, M.SmoothPlastic, false)
	-- Petites fleurs et buissons sur la pelouse (autour de la maison)
	local flowerColors = { C.Pink, Color3.fromRGB(255, 226, 130), WHITE, C.Lilac }
	for index = 1, 26 do
		local side = index % 3
		local x, z
		if side == 0 then
			x = -lawnW / 2 + 1 + noise(index, 1) * (lawnW - 2)
			z = D + 1 + noise(index, 2) * (LAWN_FRONT - 2)
		elseif side == 1 then
			x = -W / 2 - WALL_T - 1 - noise(index, 3) * (LAWN_SIDE - 2)
			z = lawnZ0 + 1 + noise(index, 4) * (lawnD - 2)
		else
			x = W / 2 + WALL_T + 1 + noise(index, 5) * (LAWN_SIDE - 2)
			z = lawnZ0 + 1 + noise(index, 6) * (lawnD - 2)
		end
		if index % 4 == 0 then
			local bush = part("Bush", Vector3.new(1.6, 1.6, 1.6), CFrame.new(at(x, lawnTop + 0.5, z)), Color3.fromRGB(110, 190, 110), M.SmoothPlastic, true)
			;(bush :: Part).Shape = Enum.PartType.Ball
		else
			part("Stem", Vector3.new(0.12, 0.6, 0.12), CFrame.new(at(x, lawnTop + 0.3, z)), Color3.fromRGB(90, 170, 90), M.SmoothPlastic, false)
			local flower = part("Flower", Vector3.new(0.5, 0.5, 0.5), CFrame.new(at(x, lawnTop + 0.7, z)), flowerColors[index % #flowerColors + 1], M.SmoothPlastic, false)
			;(flower :: Part).Shape = Enum.PartType.Ball
		end
	end

	------------------------------------------------------------------
	-- Dalle, sol
	------------------------------------------------------------------
	-- (le dessus de la dalle reste sous le sol : pas de faces confondues)
	part("Slab", Vector3.new(W + WALL_T * 2, SLAB - 0.3, D + WALL_T), CFrame.new(at(0, -0.3 - (SLAB - 0.3) / 2, (D - WALL_T) / 2)), SHELL, M.SmoothPlastic, false)
	part("SlabTrim", Vector3.new(W + WALL_T * 2 + 0.1, 0.25, 0.25), CFrame.new(at(0, -0.12, D + 0.02)), trim, M.SmoothPlastic, false)
	do
		local pattern = floorStyle and floorStyle.Pattern or "Plain"
		-- (la "face du dessus" est la face Back d'une dalle tournée : le haut de la toile = le mur du fond)
		local floorPart = facing("Floor", at(0, 0, D / 2), X_AXIS, BACKWARD, W, D, 0.3, floorA, FLOOR_MATERIAL[pattern] or M.SmoothPlastic)
		local gui = House3DKit.Surface(floorPart, Enum.NormalId.Back, Vector2.new(roomWpx, DEPTH_PX), 1)
		local sheet = Instance.new("Frame")
		sheet.Name = "Floor"
		sheet.BackgroundTransparency = 1
		sheet.BorderSizePixel = 0
		sheet.Size = UDim2.fromScale(1, 1)
		sheet.ClipsDescendants = true
		sheet.Parent = gui
		local ok, err = pcall(House3DFloor.Paint, sheet, roomWpx, DEPTH_PX, floorStyle, 1)
		if not ok then
			warn("[House3D] Sol : " .. tostring(err))
		end
		-- (la couleur vient de la pièce : le fond de la toile reste transparent)
		sheet.BackgroundTransparency = 1
		if pattern == "Lava" then
			-- la lave éclaire la pièce par en dessous
			local glow = Instance.new("PointLight")
			glow.Color = Color3.fromRGB(255, 130, 60)
			glow.Range = 16
			glow.Brightness = 1
			glow.Shadows = false
			glow.Parent = floorPart
		end
		-- ombres douces au pied des murs
		local back = HousePatterns.Box(sheet, 0, 0, roomWpx, 40, BLACK, 0.75, 20)
		local fade = Instance.new("UIGradient")
		fade.Rotation = 90
		fade.Transparency = NumberSequence.new(0, 1)
		fade.Parent = back
	end

	------------------------------------------------------------------
	-- Murs : coque + peau (papier peint), plinthes, moulures, poutre
	------------------------------------------------------------------
	local function paper(gui: SurfaceGui, widthPx: number)
		local sheet = Instance.new("Frame")
		sheet.Name = "Paper"
		sheet.BackgroundTransparency = 1
		sheet.BorderSizePixel = 0
		sheet.Size = UDim2.fromScale(1, 1)
		sheet.ClipsDescendants = true
		sheet.Parent = gui
		local ok, err = pcall(HousePatterns.BuildWall, sheet, widthPx, WALL_PX, wallpaper, 1)
		if not ok then
			warn("[House3D] Papier peint : " .. tostring(err))
		end
		sheet.BackgroundTransparency = 1
		-- ombre au pied du mur
		local ao = HousePatterns.Box(sheet, 0, WALL_PX - 30, widthPx, 30, BLACK, 0.8, 20)
		local fade = Instance.new("UIGradient")
		fade.Rotation = 90
		fade.Transparency = NumberSequence.new(1, 0)
		fade.Parent = ao
	end
	local wallMaterial = WALL_MATERIAL[wallpaper and wallpaper.Pattern or ""] or M.SmoothPlastic
	-- Mur du fond
	part("WallBack", Vector3.new(W + WALL_T * 2, WH + 0.4, WALL_T), CFrame.new(at(0, (WH + 0.4) / 2 - 0.2, -WALL_T / 2 - SKIN)), SHELL, M.SmoothPlastic, false)
	do
		local skin = facing("WallBackPaper", at(0, WH / 2, 0), X_AXIS, Y_AXIS, W, WH, SKIN, wallA, wallMaterial)
		local gui = House3DKit.Surface(skin, Enum.NormalId.Back, Vector2.new(roomWpx, WALL_PX), 1)
		paper(gui, roomWpx)
	end
	-- Murs de côté (se baissent quand la caméra passe derrière eux)
	local crownH = 0.45
	for _, side in ipairs({ -1, 1 }) do
		local shellPart = part(side < 0 and "WallLeft" or "WallRight", Vector3.new(WALL_T, WH + 0.4, D + WALL_T + SKIN),
			CFrame.new(at(side * (W / 2 + SKIN + WALL_T / 2), (WH + 0.4) / 2 - 0.2, (D - WALL_T - SKIN) / 2)), SHELL, M.SmoothPlastic, false)
		local right = side < 0 and BACKWARD or -BACKWARD
		local skin = facing(side < 0 and "WallLeftPaper" or "WallRightPaper", at(side * W / 2, WH / 2, D / 2), right, Y_AXIS, D, WH, SKIN, wallA:Lerp(BLACK, 0.04), wallMaterial)
		local gui = House3DKit.Surface(skin, Enum.NormalId.Back, Vector2.new(DEPTH_PX, WALL_PX), 1)
		paper(gui, DEPTH_PX)
		local crown = part("TrimCrownSide", Vector3.new(0.36, crownH, D), CFrame.new(at(side * (W / 2 - 0.18), WH - crownH / 2, D / 2)), trim, M.SmoothPlastic, false)
		local skirt = part("TrimSkirtSide", Vector3.new(0.2, 0.6, D), CFrame.new(at(side * (W / 2 - 0.1), 0.3, D / 2)), trim, M.SmoothPlastic, false)
		-- chant avant du mur (liseré)
		local edge = part("TrimEdge", Vector3.new(WALL_T + SKIN + 0.1, WH + 0.4, 0.2), CFrame.new(at(side * (W / 2 + (WALL_T + SKIN) / 2), (WH + 0.4) / 2 - 0.2, D + 0.05)), trim, M.SmoothPlastic, false)
		table.insert(sideWalls, { Side = side, Shell = shellPart, Skin = skin, Crown = crown, Skirt = skirt, Edge = edge, Gui = gui, Lowered = false })
	end
	part("TrimSkirtBack", Vector3.new(W, 0.6, 0.2), CFrame.new(at(0, 0.3, 0.1)), trim, M.SmoothPlastic, false)
	part("TrimCrownBack", Vector3.new(W, crownH, 0.36), CFrame.new(at(0, WH - crownH / 2, 0.18)), trim, M.SmoothPlastic, false)
	-- Poutre du plafond (au-dessus du mur du fond) et petits corbeaux
	part("CeilingBeam", Vector3.new(W + WALL_T * 2 + 0.4, 0.7, 1.4), CFrame.new(at(0, WH + 0.35, 0.3)), trim:Lerp(Color3.fromRGB(160, 110, 78), 0.35), M.Wood, false)
	for index = -2, 2 do
		part("BeamBracket", Vector3.new(0.5, 0.5, 0.9), CFrame.new(at(index * W / 5, WH - 0.2, 0.9)), trim:Lerp(Color3.fromRGB(160, 110, 78), 0.35), M.Wood, false)
	end

	------------------------------------------------------------------
	-- Fenêtre fixe (à gauche, comme la pièce 2D) : vraie fenêtre en relief
	------------------------------------------------------------------
	-- (v9.6 : place et taille de la fenêtre 2D, comme la pièce en ville)
	local windowCX, windowCY, windowW, windowH = windowRect(roomWpx, PX)
	do
		-- vue (panneau opaque derrière la vitre, dessiné par HouseViews)
		local view = facing("WindowView", at(windowCX, windowCY, 0.02), X_AXIS, Y_AXIS, windowW - 0.5, windowH - 0.5, 0.05, Color3.fromRGB(170, 214, 255), M.SmoothPlastic)
		view.Color = viewEntry and asColor(viewEntry.Sky, Color3.fromRGB(170, 214, 255)) or Color3.fromRGB(170, 214, 255)
		local gui = House3DKit.Surface(view, Enum.NormalId.Back, Vector2.new(200, 180), 0)
		local holder = Instance.new("Frame")
		holder.Name = "View"
		holder.BackgroundTransparency = 1
		holder.BorderSizePixel = 0
		holder.Size = UDim2.fromScale(1, 1)
		holder.ClipsDescendants = true
		holder.Parent = gui
		table.insert(viewHolders, holder)
		-- cadre (couleur des moulures), croisillon, rebord, tringle
		local fw = 0.32
		for _, spec in ipairs({
			{ 0, windowH / 2 + fw / 2, windowW + fw * 2, fw },
			{ 0, -windowH / 2 - fw / 2, windowW + fw * 2, fw },
			{ -windowW / 2 - fw / 2, 0, fw, windowH },
			{ windowW / 2 + fw / 2, 0, fw, windowH },
			{ 0, 0, 0.16, windowH },
			{ 0, 0, windowW, 0.16 },
		}) do
			part("WindowFrame", Vector3.new(spec[3], spec[4], 0.3), CFrame.new(at(windowCX + spec[1], windowCY + spec[2], 0.15)), trim, M.SmoothPlastic, true)
		end
		local glass = part("WindowGlass", Vector3.new(windowW, windowH, 0.05), CFrame.new(at(windowCX, windowCY, 0.1)), Color3.fromRGB(220, 240, 255), M.Glass, false)
		glass.Transparency = 0.8
		part("WindowSill", Vector3.new(windowW + 1, 0.3, 0.8), CFrame.new(at(windowCX, windowCY - windowH / 2 - 0.3, 0.4)), trim, M.SmoothPlastic, true)
		local rodY = windowCY + windowH / 2 + 0.5
		local rod = part("CurtainRod", Vector3.new(windowW + 2.4, 0.16, 0.16), CFrame.new(at(windowCX, rodY, 0.5)), Color3.fromRGB(160, 110, 78), M.Wood, false)
		;(rod :: Part).Shape = Enum.PartType.Cylinder
		for _, side in ipairs({ -1, 1 }) do
			local knob = part("CurtainKnob", Vector3.new(0.4, 0.4, 0.4), CFrame.new(at(windowCX + side * (windowW / 2 + 1.2), rodY, 0.5)), C.PinkDeep, M.SmoothPlastic, false)
			;(knob :: Part).Shape = Enum.PartType.Ball
			-- rideau (tissu) retenu par une embrasse
			local cx = windowCX + side * (windowW / 2 + 0.3)
			local curtain = C.Pink:Lerp(trim, 0.15)
			for fold = 0, 2 do
				part("Curtain", Vector3.new(0.42, windowH + 0.6, 0.3), CFrame.new(at(cx + side * (fold - 1) * 0.36, rodY - (windowH + 0.6) / 2 - 0.1, 0.42 + (fold % 2) * 0.12)),
					fold % 2 == 0 and curtain or curtain:Lerp(WHITE, 0.2), M.Fabric, true)
			end
			part("CurtainTie", Vector3.new(1.4, 0.3, 0.5), CFrame.new(at(cx, windowCY - windowH * 0.08, 0.62)), C.PinkDeep, M.Fabric, false)
		end
		-- soleil de la fenêtre
		local sunAnchor = newPart("Part", "WindowLight", Vector3.new(0.2, 0.2, 0.2), CFrame.lookAt(at(windowCX, windowCY, 0.9), at(windowCX + 4, 0, D * 0.6)), WHITE, nil, 1)
		sunAnchor.CastShadow = false
		sunAnchor.Parent = folder
		local spot = Instance.new("SpotLight")
		spot.Face = Enum.NormalId.Front
		spot.Angle = 70
		spot.Range = 30
		spot.Shadows = true
		spot.Parent = sunAnchor
		sunLight = spot
	end
	-- Prise électrique (à droite)
	do
		local ox = ((roomWpx - SIDE_PX - 70 + 11 - SIDE_PX) / math.max(1, roomWpx - 2 * SIDE_PX) * roomWpx - roomWpx / 2) * PX
		part("Outlet", Vector3.new(0.8, 0.95, 0.12), CFrame.new(at(ox, 1.2, 0.06)), WHITE, M.SmoothPlastic, false)
		for _, dx in ipairs({ -0.15, 0.15 }) do
			part("OutletHole", Vector3.new(0.1, 0.24, 0.05), CFrame.new(at(ox + dx, 1.26, 0.14)), Color3.fromRGB(90, 70, 90), M.SmoothPlastic, false)
		end
	end

	------------------------------------------------------------------
	-- Lumières de la pièce + ambiance
	------------------------------------------------------------------
	do
		local lamp = newPart("Part", "CeilingLight", Vector3.new(0.3, 0.3, 0.3), CFrame.new(at(0, WH - 0.6, D * 0.45)), WHITE, nil, 1)
		lamp.CastShadow = false
		lamp.Parent = folder
		local light = Instance.new("PointLight")
		light.Range = 36
		light.Shadows = false
		light.Parent = lamp
		ceilingLight = light
		local fill = Instance.new("PointLight")
		fill.Range = 40
		fill.Shadows = false
		fill.Parent = lamp
		fillLight = fill
	end
	-- Petites particules d'ambiance (Room.Mood.Effect), dans le volume de la pièce
	do
		local specs: { [string]: { Colors: { Color3 }, Rate: number, Size: number, Speed: number, Up: number, Life: number, Emission: number } } = {
			Neon = { Colors = { Color3.fromRGB(255, 80, 200), Color3.fromRGB(80, 230, 255) }, Rate = 8, Size = 0.3, Speed = 0.3, Up = 0.1, Life = 3, Emission = 1 },
			Floodlights = { Colors = { WHITE, Color3.fromRGB(230, 240, 255) }, Rate = 5, Size = 0.22, Speed = 0.2, Up = 0.05, Life = 5, Emission = 1 },
			RGB = { Colors = { Color3.fromRGB(255, 60, 90), Color3.fromRGB(90, 255, 120), Color3.fromRGB(80, 140, 255) }, Rate = 10, Size = 0.3, Speed = 0.8, Up = 0, Life = 2, Emission = 1 },
			Storm = { Colors = { Color3.fromRGB(170, 200, 255), Color3.fromRGB(120, 140, 200) }, Rate = 14, Size = 0.18, Speed = 3, Up = -6, Life = 1.2, Emission = 0.6 },
			Embers = { Colors = { Color3.fromRGB(255, 200, 80), Color3.fromRGB(255, 90, 30) }, Rate = 9, Size = 0.28, Speed = 0.6, Up = 0.8, Life = 3, Emission = 1 },
			Sparkles = { Colors = { Color3.fromRGB(255, 244, 190), WHITE }, Rate = 6, Size = 0.35, Speed = 0.3, Up = 0.2, Life = 3, Emission = 1 },
			Bubbles = { Colors = { Color3.fromRGB(190, 230, 255), WHITE }, Rate = 5, Size = 0.5, Speed = 0.6, Up = 0.5, Life = 5, Emission = 0.4 },
			Hearts = { Colors = { C.Pink, C.PinkDeep }, Rate = 5, Size = 0.45, Speed = 0.5, Up = 0.4, Life = 4, Emission = 0.7 },
			Disco = { Colors = { C.Pink, Color3.fromRGB(120, 220, 255), Color3.fromRGB(255, 226, 130), C.Lilac }, Rate = 14, Size = 0.3, Speed = 1.5, Up = 0, Life = 1.6, Emission = 1 },
			Aurora = { Colors = { Color3.fromRGB(120, 255, 200), Color3.fromRGB(170, 140, 255) }, Rate = 3, Size = 1.4, Speed = 0.2, Up = 0.1, Life = 6, Emission = 0.8 },
			Rays = { Colors = { Color3.fromRGB(255, 236, 170) }, Rate = 5, Size = 0.25, Speed = 0.15, Up = 0.05, Life = 5, Emission = 1 },
			Leaves = { Colors = { Color3.fromRGB(140, 210, 110), Color3.fromRGB(240, 190, 90) }, Rate = 4, Size = 0.45, Speed = 0.4, Up = -0.6, Life = 5, Emission = 0.2 },
			Rainbow = { Colors = { Color3.fromRGB(255, 120, 140), Color3.fromRGB(255, 210, 110), Color3.fromRGB(140, 230, 150), Color3.fromRGB(130, 190, 255), C.Lilac }, Rate = 8, Size = 0.35, Speed = 0.4, Up = 0.2, Life = 4, Emission = 1 },
		}
		local spec = specs[mood.Effect]
		if spec then
			local volume = newPart("Part", "MoodVolume", Vector3.new(W - 1, WH - 1.5, D - 2), CFrame.new(at(0, WH / 2 + 0.3, D / 2)), WHITE, nil, 1)
			volume.CastShadow = false
			volume.Parent = folder
			local emitter = Instance.new("ParticleEmitter")
			emitter.Name = "Mood" .. mood.Effect
			emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
			emitter.Shape = Enum.ParticleEmitterShape.Box
			emitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
			emitter.EmissionDirection = Enum.NormalId.Top
			emitter.Rate = spec.Rate
			emitter.Lifetime = NumberRange.new(spec.Life * 0.7, spec.Life)
			emitter.Speed = NumberRange.new(spec.Speed * 0.5, spec.Speed)
			emitter.SpreadAngle = Vector2.new(180, 180)
			emitter.Acceleration = Vector3.new(0, spec.Up, 0)
			-- (particules douces : peu d'émission, pas d'éblouissement)
			emitter.LightEmission = spec.Emission * 0.4
			emitter.LightInfluence = 0
			emitter.Size = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(0.2, spec.Size),
				NumberSequenceKeypoint.new(0.8, spec.Size),
				NumberSequenceKeypoint.new(1, 0),
			})
			emitter.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.2, 0.15),
				NumberSequenceKeypoint.new(0.8, 0.3),
				NumberSequenceKeypoint.new(1, 1),
			})
			local keys = {}
			local n = #spec.Colors
			for index, color in ipairs(spec.Colors) do
				table.insert(keys, ColorSequenceKeypoint.new(n == 1 and (index - 1) or (index - 1) / (n - 1), color))
			end
			if n == 1 then
				table.insert(keys, ColorSequenceKeypoint.new(1, spec.Colors[1]))
			end
			emitter.Color = ColorSequence.new(keys)
			emitter.RotSpeed = NumberRange.new(-60, 60)
			emitter.Parent = volume
			table.insert(effects, emitter)
		end
	end

	------------------------------------------------------------------
	-- Nuit / jour, ambiance
	------------------------------------------------------------------
	local function paintViews()
		for _, holder in ipairs(viewHolders) do
			for _, child in ipairs(holder:GetChildren()) do
				child:Destroy()
			end
			local painted = false
			if HouseViews and type(HouseViews.Paint) == "function" and type(viewEntry) == "table" then
				local ok, err = pcall(HouseViews.Paint, holder, 200, 180, viewEntry, night)
				painted = ok
				if not ok then
					warn("[House3D] Vue : " .. tostring(err))
				end
			end
			if not painted then
				-- ciel dégradé + soleil / lune + nuage
				local sky = HousePatterns.Box(holder, 0, 0, 200, 180, WHITE, 0, 1)
				local gradient = Instance.new("UIGradient")
				gradient.Rotation = 90
				gradient.Color = night and ColorSequence.new(Color3.fromRGB(24, 22, 70), Color3.fromRGB(80, 60, 150))
					or ColorSequence.new(Color3.fromRGB(150, 214, 255), Color3.fromRGB(255, 214, 236))
				gradient.Parent = sky
				HousePatterns.Circle(holder, 140, 46, 40, 40, night and Color3.fromRGB(255, 244, 200) or Color3.fromRGB(255, 230, 130), 0, 2)
				if not night then
					HousePatterns.Cloud(holder, 60, 130, 80, WHITE, 0.05, 3)
				end
				local hill = HousePatterns.Circle(holder, 100, 200, 300, 90, night and Color3.fromRGB(60, 90, 90) or Color3.fromRGB(140, 214, 140), 0, 2)
				hill.Name = "Hill"
			end
		end
	end

	local function applyNight()
		for _, band in ipairs(skyBands) do
			if band.Index == 0 then
				band.Part.Color = night and Color3.fromRGB(96, 82, 150) or WHITE
			else
				band.Part.Color = (night and SKY_NIGHT or SKY_DAY)[band.Index]
			end
		end
		paintViews()
		local lampBoost = night and 1.25 or 0.8
		for _, entry in ipairs(itemLights) do
			entry.Light.Brightness = soft(entry.Base * lampBoost * mood.Brightness)
			entry.Light.Color = entry.Light.Color
		end
		local ceiling = ceilingLight
		if ceiling then
			ceiling.Brightness = soft((night and 0.75 or 0.55) * mood.Brightness)
			ceiling.Color = night and Color3.fromRGB(255, 214, 170):Lerp(mood.Light, 0.5) or mood.Light
		end
		local fill = fillLight
		if fill then
			fill.Enabled = mood.Amount > 0.01
			fill.Color = mood.Tint
			fill.Brightness = soft(mood.Amount * 1.2)
		end
		local spot = sunLight
		if spot then
			spot.Brightness = soft((night and 0.5 or 1.1) * math.clamp(mood.Brightness, 0.4, 1))
			spot.Color = night and Color3.fromRGB(150, 170, 255) or Color3.fromRGB(255, 236, 200)
		end
	end
	applyNight()
	-- (v9.6) anti-scintillement du décor : moulures, fenêtre, rideaux...
	-- écartés des murs / du sol / du studio (qui ne bougent pas)
	pcall(House3DScene.SeparateShell, folder, nil)
	folder.Parent = workspace

	------------------------------------------------------------------
	-- Objets : vrais modèles 3D (House3DRecipes), placés par House3DLayout
	------------------------------------------------------------------
	local entries = House3DLayout.Entries(roomData)
	local dims = House3DLayout.Dims(size, PX, D, WH)
	local frame = CFrame.new(origin)
	local itemFolder = Instance.new("Folder")
	itemFolder.Name = "Items"
	itemFolder.Parent = folder
	local pets: { Pet } = {}
	local petClock = 0
	local liveHandles: { any } = {}

	-- montage dans la pièce (+ arrivée en douceur)
	local lampCount = 0
	local function mount(build: Build, delay: number)
		local model = build.Model
		model.Name = "Item_" .. tostring(build.Item.Id)
		local data = build.Data
		for _, light in ipairs(data.Lights) do
			lampCount += 1
			if lampCount > MAX_LAMPS then
				light.Enabled = false
			end
			table.insert(itemLights, { Light = light, Base = light.Brightness })
			light.Brightness = soft(light.Brightness * (night and 1.25 or 0.8) * mood.Brightness)
		end
		for _, glow in ipairs(data.Glows) do
			table.insert(glowParts, glow)
		end
		model:PivotTo(build.Pivot)
		local parts: { BasePart } = {}
		local finals: { CFrame } = {}
		for _, p in ipairs(model:GetDescendants()) do
			if p:IsA("BasePart") then
				-- petit tapis : pas d'ombre
				if build.Kind == "Flat" then
					p.CastShadow = false
				end
				table.insert(parts, p)
				table.insert(finals, p.CFrame)
			end
		end
		if data.Info.Pet then
			table.insert(pets, { Parts = parts, Finals = finals, Phase = #pets * 1.7, Amount = math.clamp(data.H * 0.035, 0.03, 0.12) })
		end
		local lifted = table.create(#finals)
		for index, final in ipairs(finals) do
			lifted[index] = final + Vector3.new(0, DROP, 0)
		end
		moveParts(parts, lifted)
		model.Parent = itemFolder
		table.insert(arrivals, { Parts = parts, Finals = finals, Delay = delay, Clock = 0 })
	end

	------------------------------------------------------------------
	-- Scène (objet renvoyé)
	------------------------------------------------------------------
	local scene: Scene
	scene = {
		Folder = folder,
		Width = W,
		Depth = D,
		WallHeight = WH,
		Focus = at(0, WH * 0.36, D * 0.5),
		BoundsMin = at(-W / 2 - WALL_T, -SLAB, -WALL_T),
		BoundsMax = at(W / 2 + WALL_T, WH + 0.7, D + 0.3),
		FrontZ = origin.Z + D,
		ItemCount = #entries,
		BuildItems = function(alive: () -> boolean, progress: ((done: number, total: number) -> ())?)
			local total = #entries * 2
			local done = 0
			local builds: { Build } = {}
			local started = os.clock()
			local count = 0
			local function breathe(): boolean
				count += 1
				if count >= BATCH_ITEMS or os.clock() - started > BATCH_TIME then
					if progress then
						pcall(progress, done, total)
					end
					task.wait()
					started = os.clock()
					count = 0
				end
				return alive() and not destroyed
			end
			local function discard()
				for _, build in ipairs(builds) do
					if build.Model.Parent == nil then
						build.Model:Destroy()
					end
				end
			end
			for index, entry in ipairs(entries) do
				local ok, result = pcall(House3DLayout.Prepare, entry, index, dims, { Collide = false, Query = false, Trim = trim })
				if ok and result then
					table.insert(builds, result)
				elseif not ok then
					warn("[House3D] Objet " .. tostring(entry.I) .. " : " .. tostring(result))
				end
				done += 1
				if not breathe() then
					discard()
					return
				end
			end
			local okLayout, err = pcall(House3DLayout.Layout, builds, dims, frame)
			if not okLayout then
				warn("[House3D] Disposition : " .. tostring(err))
				for _, build in ipairs(builds) do
					if not build.Placed then
						build.Pivot = frame * CFrame.new(0, 0, D * 0.6) * CFrame.Angles(0, math.pi, 0)
					end
				end
			end
			if not alive() or destroyed then
				discard()
				return
			end
			-- (v9.6) anti-scintillement entre objets voisins et avec le décor
			-- (avant l'arrivée en douceur, qui garde les places finales)
			pcall(function()
				local models: { Instance } = {}
				for _, build in ipairs(builds) do
					build.Model:PivotTo(build.Pivot)
					table.insert(models, build.Model)
				end
				House3DScene.SeparateShell(folder, models)
			end)
			local order = table.clone(builds)
			table.sort(order, function(a, b)
				if a.Entry.Y ~= b.Entry.Y then
					return a.Entry.Y < b.Entry.Y
				end
				return a.Order < b.Order
			end)
			for index, build in ipairs(order) do
				local ok, mountErr = pcall(mount, build, 0.05 + math.min(1.2, index * 0.04))
				if not ok then
					warn("[House3D] Objet " .. tostring(build.Entry.I) .. " : " .. tostring(mountErr))
					pcall(function()
						build.Model:Destroy()
					end)
				end
				done += 1
				if not breathe() then
					discard()
					return
				end
			end
			local live = getLiveProps()
			if live then
				local okLive, handles = pcall(live.AttachAll, itemFolder:GetChildren(), { Interactive = false })
				if okLive and type(handles) == "table" then
					liveHandles = handles
				end
				-- (v9.6 : un point de focus laissé par la ville, ~2 s après la
				-- sortie, mettait les écrans de l'aperçu en pause : focus = caméra)
				if #liveHandles > 0 and type(live.SetFocus) == "function" then
					pcall(live.SetFocus, nil)
				end
			end
			applyNight()
			if progress then
				pcall(progress, total, total)
			end
		end,
		SetNight = function(value: boolean)
			if night == value then
				return
			end
			night = value
			applyNight()
		end,
		-- Éclairage du lieu pendant la vue (House3D le remet à la fermeture)
		Lighting = function(isNight: boolean): { [string]: any }
			local tint = mood.Tint
			local amount = mood.Amount
			-- v9.6 ("flash bang") : soleil plus doux, lumière ambiante moins
			-- forte (150 délavait tout dans le vrai Roblox), exposition ≤ 0
			local ambientDay = Color3.fromRGB(118, 110, 128):Lerp(tint, amount * 0.5)
			local ambientNight = Color3.fromRGB(64, 56, 110):Lerp(tint, amount * 0.4)
			local bright = mood.Brightness
			return {
				ClockTime = isNight and 0.5 or 14.5,
				Brightness = (isNight and 0.35 or 1.6) * math.clamp(bright, 0.6, 1.1),
				Ambient = isNight and ambientNight or ambientDay,
				OutdoorAmbient = isNight and Color3.fromRGB(70, 64, 120):Lerp(tint, amount * 0.4) or Color3.fromRGB(138, 132, 150):Lerp(tint, amount * 0.5),
				ColorShift_Top = isNight and Color3.fromRGB(40, 40, 90) or tint:Lerp(BLACK, 1 - amount * 0.35),
				ColorShift_Bottom = BLACK,
				EnvironmentDiffuseScale = 0.4,
				EnvironmentSpecularScale = 0.3,
				ExposureCompensation = isNight and 0 or -0.1,
				GlobalShadows = true,
				ShadowSoftness = 0.35,
				FogStart = 0,
				FogEnd = 100000,
				GeographicLatitude = 23,
			}
		end,
		UpdateWalls = function(eye: Vector3)
			local localX = eye.X - origin.X
			for _, wall in ipairs(sideWalls) do
				local outside = wall.Side * localX > W / 2 + 0.6
				local inside = wall.Side * localX < W / 2 - 1.2
				local lower = nil
				if outside and not wall.Lowered then
					lower = true
				elseif inside and wall.Lowered then
					lower = false
				end
				if lower ~= nil then
					wall.Lowered = lower
					local x = wall.Side * (W / 2 + SKIN + WALL_T / 2)
					local right = wall.Side < 0 and BACKWARD or -BACKWARD
					local normal = right:Cross(Y_AXIS)
					-- pose d'un mur de hauteur `height` (tailles, repères)
					local function pose(height: number): { { Part: BasePart, S: Vector3, C: CFrame } }
						return {
							{ Part = wall.Shell, S = Vector3.new(WALL_T, height + 0.4, D + WALL_T + SKIN), C = CFrame.new(at(x, (height + 0.4) / 2 - 0.2, (D - WALL_T - SKIN) / 2)) },
							{ Part = wall.Skin, S = Vector3.new(D, height, SKIN), C = CFrame.fromMatrix(at(wall.Side * W / 2, height / 2, D / 2) - normal * (SKIN / 2), right, Y_AXIS) },
							{ Part = wall.Crown, S = wall.Crown.Size, C = CFrame.new(at(wall.Side * (W / 2 - 0.18), height - crownH / 2, D / 2)) },
							{ Part = wall.Edge, S = Vector3.new(WALL_T + SKIN + 0.1, height + 0.4, 0.2), C = CFrame.new(at(wall.Side * (W / 2 + (WALL_T + SKIN) / 2), (height + 0.4) / 2 - 0.2, D + 0.05)) },
						}
					end
					-- (v9.6) écarts anti-scintillement de la pose levée, gardés dans les deux poses
					local deltas = wall.Deltas
					if not deltas then
						local fresh: { [BasePart]: { P: Vector3, S: Vector3 } } = {}
						for _, spec in ipairs(pose(WH)) do
							fresh[spec.Part] = { P = spec.Part.Position - spec.C.Position, S = spec.Part.Size - spec.S }
						end
						wall.Deltas = fresh
						deltas = fresh
					end
					for _, spec in ipairs(pose(lower and 1.2 or WH)) do
						local delta = (deltas :: any)[spec.Part]
						spec.Part.Size = spec.S + (delta and delta.S or Vector3.zero)
						spec.Part.CFrame = spec.C + (delta and delta.P or Vector3.zero)
					end
					local gui = wall.Gui
					if gui then
						gui.Enabled = not lower
					end
				end
			end
		end,
		Step = function(dt: number)
			if #arrivals > 0 then
				for index = #arrivals, 1, -1 do
					local arrival = arrivals[index]
					arrival.Clock += dt
					local t = math.clamp((arrival.Clock - arrival.Delay) / DROP_TIME, 0, 1)
					-- (petit rebond à l'arrivée)
					local s = 1.70158
					local eased = 1 + (s + 1) * (t - 1) ^ 3 + s * (t - 1) ^ 2
					local offset = Vector3.new(0, DROP * (1 - eased), 0)
					if t >= 1 then
						moveParts(arrival.Parts, arrival.Finals)
						table.remove(arrivals, index)
					elseif arrival.Clock >= arrival.Delay then
						local moved = table.create(#arrival.Finals)
						for i, final in ipairs(arrival.Finals) do
							moved[i] = final + offset
						end
						moveParts(arrival.Parts, moved)
					end
				end
			end
			-- Animaux : petite respiration (≤ 30 fois par seconde, une fois tous arrivés)
			petClock += dt
			if #pets > 0 and petClock >= 1 / 30 and #arrivals == 0 then
				petClock = 0
				local now = os.clock()
				for _, pet in ipairs(pets) do
					local lift = Vector3.new(0, (math.sin(now * 2.4 + pet.Phase) * 0.5 + 0.5) * pet.Amount, 0)
					local moved = table.create(#pet.Finals)
					for i, final in ipairs(pet.Finals) do
						moved[i] = final + lift
					end
					moveParts(pet.Parts, moved)
				end
			end
			if mood.Effect == "Storm" then
				-- éclair de temps en temps (lumière de remplissage)
				stormClock += dt
				local fill = fillLight
				if fill then
					if stormClock > 6 then
						stormClock = 0
					end
					-- (éclair doux : plus d'éblouissement, luminosité ≤ 1,2)
					local flash = (stormClock < 0.12 or (stormClock > 0.25 and stormClock < 0.33)) and 0.8 or 0
					fill.Enabled = true
					fill.Color = Color3.fromRGB(210, 225, 255)
					fill.Brightness = soft(mood.Amount * 1.2 + flash)
				end
			end
			if mood.Effect == "Disco" or mood.Effect == "RGB" or mood.Effect == "Neon" then
				discoClock += dt
				local ceiling = ceilingLight
				if ceiling and discoClock > 0.25 then
					discoClock = 0
					ceiling.Color = Color3.fromHSV((os.clock() * 0.2) % 1, 0.5, 1)
				end
			end
		end,
		Destroy = function()
			destroyed = true
			for _, emitter in ipairs(effects) do
				pcall(function()
					emitter.Enabled = false
				end)
			end
			local live = getLiveProps()
			if live then
				pcall(live.DetachAll, liveHandles)
			end
			folder:Destroy()
		end,
	}
	return scene
end

----------------------------------------------------------------------
-- Monde (v9.3, Dopamine Town) : coque de pièce à taille de personnage et
-- objets placés comme dans la vue 3D (voir l'en-tête)
----------------------------------------------------------------------

export type ShellOptions = {
	Scale: number?, -- studs par px de la pièce 2D (32 / 760 par défaut : ~32 studs de large)
	Depth: number?, -- (studs) profondeur intérieure (24)
	WallHeight: number?, -- hauteur des murs (14)
	Doors: { string }?, -- côtés avec une porte ouverte : "Front" | "Left" | "Right" | "Back" ({ "Front" })
	DoorWidth: number?, -- (6)
	DoorHeight: number?, -- (9)
	Front: boolean?, -- mur avant (avec sa porte) ; true par défaut
	Ceiling: boolean?, -- plafond ; false par défaut
	Patterns: boolean?, -- motifs du papier peint / du sol (SurfaceGui décoratives) ; true par défaut
	-- (v9.8 HOUSE98) VRAIE fenêtre dans le mur du fond (ville) : { x0, x1, y0, y1 }
	-- (x depuis le milieu de la pièce, y depuis le sol) : trou dans le mur,
	-- chambranle + appui intérieurs, PAS de vue peinte ni de vitre (la vitre
	-- est dans le mur du fond de la façade, HouseFacade) ; nil = fenêtre décor
	BackWindow: { number }?,
}

local SHELL_WALL_T = 1

-- Pièce solide d'une coque (collision + rayons)
local function shellPart(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?, solid: boolean): BasePart
	local p = newPart("Part", name, size, cframe, color, material)
	p.CanCollide = solid
	p.CanQuery = solid
	p.CastShadow = solid
	p.Parent = parent
	return p
end

function House3DScene.BuildRoomShell(roomData: any, sizeDef: any?, options: ShellOptions?): Model
	local opts: ShellOptions = type(options) == "table" and options or {}
	local room = type(roomData) == "table" and roomData or {}
	local widthFactor = type(sizeDef) == "table" and tonumber(sizeDef.Width) or 1
	local roomWpx = math.floor(ROOM_BASE_WIDTH * (widthFactor or 1) + 0.5)
	local scale = tonumber(opts.Scale) or 32 / ROOM_BASE_WIDTH
	local W = roomWpx * scale
	local D = tonumber(opts.Depth) or 24
	local WH = tonumber(opts.WallHeight) or 14
	local T = SHELL_WALL_T
	local doorW = math.clamp(tonumber(opts.DoorWidth) or 6, 3, W - 2)
	local doorH = math.clamp(tonumber(opts.DoorHeight) or 9, 6, WH - 1)
	local doors: { [string]: boolean } = {}
	for _, side in ipairs(type(opts.Doors) == "table" and opts.Doors or { "Front" }) do
		doors[tostring(side)] = true
	end
	local wallpaper = HouseCommon.GetRoomWallpaper(room)
	local floorStyle = HouseCommon.GetRoomFloor(room)
	local wallA = wallpaper and wallpaper.A or C.PinkSoft
	local floorA = floorStyle and floorStyle.A or C.Lilac
	local trimEntry = configTable("HouseTrimsById")[tostring(room.Trim or "Cream")]
	local trim = asColor(type(trimEntry) == "table" and trimEntry.Color, CREAM)
	local wallMaterial = WALL_MATERIAL[wallpaper and wallpaper.Pattern or ""] or M.SmoothPlastic
	local floorMaterial = FLOOR_MATERIAL[floorStyle and floorStyle.Pattern or ""] or M.SmoothPlastic
	local patterns = opts.Patterns ~= false

	local model = Instance.new("Model")
	model.Name = "RoomShell"
	-- Repère : pivot au centre du dessus du sol, mur du fond vers -Z, avant (+Z)
	local floorPart = shellPart(model, "Floor", Vector3.new(W + 2 * T, 1, D + 2 * T), CFrame.new(0, -0.5, 0), floorA, floorMaterial, true)
	floorPart.CastShadow = false
	floorPart.PivotOffset = CFrame.new(0, 0.5, 0)
	model.PrimaryPart = floorPart
	if patterns then
		-- motif du sol (décoration : la couleur de la pièce suffit déjà)
		local skin = shellPart(model, "FloorPattern", Vector3.new(W, D, 0.05), CFrame.fromMatrix(Vector3.new(0, 0.025 - 0.05, 0), Vector3.new(1, 0, 0), Vector3.new(0, 0, -1)), floorA, floorMaterial, false)
		skin.CastShadow = false
		local canvasW, canvasH = math.floor(W / PX), math.floor(D / PX)
		local gui = House3DKit.Surface(skin, Enum.NormalId.Back, Vector2.new(canvasW, canvasH), 1)
		local sheet = Instance.new("Frame")
		sheet.Name = "Floor"
		sheet.BackgroundTransparency = 1
		sheet.BorderSizePixel = 0
		sheet.Size = UDim2.fromScale(1, 1)
		sheet.ClipsDescendants = true
		sheet.Parent = gui
		pcall(House3DFloor.Paint, sheet, canvasW, canvasH, floorStyle, 1)
		sheet.BackgroundTransparency = 1
	end

	-- Un mur (avec une porte ouverte au milieu si demandé) ; `along` = axe du mur
	-- (v9.8 HOUSE98) `hole` = { a0, a1, y0, y1 } : vraie fenêtre (a le long de `along`)
	local function wall(name: string, center: Vector3, along: Vector3, length: number, inward: Vector3, withDoor: boolean, hole: { number }?)
		local across = Vector3.new(math.abs(inward.X), 0, math.abs(inward.Z)) * T
		local lengthVec = Vector3.new(math.abs(along.X), 0, math.abs(along.Z))
		local function segment(offset: number, segLength: number, y0: number, y1: number)
			if segLength <= 0.05 or y1 - y0 <= 0.05 then
				return
			end
			local size = lengthVec * segLength + across + Vector3.new(0, y1 - y0, 0)
			shellPart(model, name, size, CFrame.new(center + along * offset + Vector3.new(0, (y0 + y1) / 2, 0)), wallA, wallMaterial, true)
		end
		if withDoor then
			local side = (length - doorW) / 2
			segment(-(doorW / 2 + side / 2), side, 0, WH)
			segment(doorW / 2 + side / 2, side, 0, WH)
			segment(0, doorW, doorH, WH)
			-- chambranle (moulures)
			local face = center + inward * (T / 2 + 0.1)
			local trimSize = lengthVec * 0.5 + Vector3.new(math.abs(inward.X), 0, math.abs(inward.Z)) * 0.3
			for _, sx in ipairs({ -1, 1 }) do
				shellPart(model, "DoorFrame", trimSize + Vector3.new(0, doorH + 0.5, 0), CFrame.new(face + along * sx * (doorW / 2 + 0.25) + Vector3.new(0, (doorH + 0.5) / 2, 0)), trim, M.Wood, false)
			end
			shellPart(model, "DoorFrame", lengthVec * (doorW + 1) + Vector3.new(math.abs(inward.X), 0, math.abs(inward.Z)) * 0.3 + Vector3.new(0, 0.5, 0),
				CFrame.new(face + Vector3.new(0, doorH + 0.25, 0)), trim, M.Wood, false)
		elseif hole then
			-- mur percé d'une vraie fenêtre : gauche, droite (pleine hauteur), dessous, dessus
			local a0, a1 = math.max(-length / 2, hole[1]), math.min(length / 2, hole[2])
			segment((-length / 2 + a0) / 2, a0 + length / 2, 0, WH)
			segment((a1 + length / 2) / 2, length / 2 - a1, 0, WH)
			segment((a0 + a1) / 2, a1 - a0, 0, hole[3])
			segment((a0 + a1) / 2, a1 - a0, hole[4], WH)
		else
			segment(0, length, 0, WH)
		end
		-- plinthe et moulure du haut (côté intérieur)
		local inner = center + inward * (T / 2 + 0.1)
		local stripDepth = Vector3.new(math.abs(inward.X), 0, math.abs(inward.Z)) * 0.2
		local function strip(stripName: string, y: number, h: number)
			if withDoor and y < doorH then
				local side = (length - doorW) / 2
				for _, sx in ipairs({ -1, 1 }) do
					shellPart(model, stripName, lengthVec * side + stripDepth + Vector3.new(0, h, 0), CFrame.new(inner + along * sx * (doorW / 2 + side / 2) + Vector3.new(0, y + h / 2, 0)), trim, M.SmoothPlastic, false)
				end
			else
				shellPart(model, stripName, lengthVec * length + stripDepth + Vector3.new(0, h, 0), CFrame.new(inner + Vector3.new(0, y + h / 2, 0)), trim, M.SmoothPlastic, false)
			end
		end
		strip("Skirting", 0, 0.7)
		strip("Crown", WH - 0.5, 0.5)
	end
	local X = Vector3.new(1, 0, 0)
	local Z = Vector3.new(0, 0, 1)
	local backWindow: { number }? = nil
	if type(opts.BackWindow) == "table" and #opts.BackWindow >= 4 then
		local b = opts.BackWindow :: { number }
		local bx0, bx1 = math.clamp(tonumber(b[1]) or 0, -W / 2 + 0.6, W / 2 - 1.6), math.clamp(tonumber(b[2]) or 0, -W / 2 + 1.6, W / 2 - 0.6)
		local by0, by1 = math.clamp(tonumber(b[3]) or 0, 0.8, WH - 2), math.clamp(tonumber(b[4]) or 0, 1.8, WH - 1)
		if bx1 - bx0 > 1 and by1 - by0 > 1 then
			backWindow = { bx0, bx1, by0, by1 }
		end
	end
	wall("WallBack", Vector3.new(0, 0, -D / 2 - T / 2), X, W + 2 * T, Z, doors.Back == true, backWindow)
	wall("WallLeft", Vector3.new(-W / 2 - T / 2, 0, 0), Z, D, X, doors.Left == true)
	wall("WallRight", Vector3.new(W / 2 + T / 2, 0, 0), Z, D, -X, doors.Right == true)
	if opts.Front ~= false then
		wall("WallFront", Vector3.new(0, 0, D / 2 + T / 2), X, W + 2 * T, -Z, doors.Front == true)
	end
	if opts.Ceiling == true then
		-- (v9.6 : dessous 0,04 plus bas que le dessous du plancher de l'étage :
		-- plus de faces confondues avec lui, ni avec la dalle de la façade)
		shellPart(model, "Ceiling", Vector3.new(W + 2 * T, 0.56, D + 2 * T), CFrame.new(0, WH + 0.24, 0), trim:Lerp(WHITE, 0.5), M.SmoothPlastic, true)
	end
	-- Papier peint (décoration) sur le mur du fond
	if patterns and backWindow then
		-- (v9.8) peau percée : à gauche / à droite de la fenêtre (motif : la même
		-- feuille décalée, donc raccord parfait), dessous / dessus (couleur unie)
		local bw = backWindow :: { number }
		local wallPx = math.floor(ROOM_HEIGHT * (tonumber(HouseCommon.Config.WallRatio) or 0.46) + 0.5)
		local s = wallPx / WH -- px de feuille par stud
		local canvasW = math.floor(W * s)
		local function piece(x0: number, x1: number, y0: number, y1: number, painted: boolean)
			if x1 - x0 < 0.05 or y1 - y0 < 0.05 then
				return
			end
			local skin = shellPart(model, "WallPattern", Vector3.new(x1 - x0, y1 - y0, 0.05), CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, -D / 2 + 0.03), wallA, wallMaterial, false)
			skin.CastShadow = false
			if not painted then
				return
			end
			local gui = House3DKit.Surface(skin, Enum.NormalId.Back, Vector2.new((x1 - x0) * s, (y1 - y0) * s), 1)
			local sheet = Instance.new("Frame")
			sheet.Name = "Paper"
			sheet.BackgroundTransparency = 1
			sheet.BorderSizePixel = 0
			sheet.Position = UDim2.fromOffset(-math.floor((x0 + W / 2) * s + 0.5), -math.floor((WH - y1) * s + 0.5))
			sheet.Size = UDim2.fromOffset(canvasW, wallPx)
			sheet.ClipsDescendants = true
			sheet.Parent = gui
			pcall(HousePatterns.BuildWall, sheet, canvasW, wallPx, wallpaper, 1)
			sheet.BackgroundTransparency = 1
		end
		piece(-W / 2, bw[1], 0, WH, true)
		piece(bw[2], W / 2, 0, WH, true)
		piece(bw[1], bw[2], 0, bw[3], false)
		piece(bw[1], bw[2], bw[4], WH, false)
	elseif patterns then
		local wallPx = math.floor(ROOM_HEIGHT * (tonumber(HouseCommon.Config.WallRatio) or 0.46) + 0.5)
		local skin = shellPart(model, "WallPattern", Vector3.new(W, WH, 0.05), CFrame.new(0, WH / 2, -D / 2 + 0.03), wallA, wallMaterial, false)
		skin.CastShadow = false
		local canvasW = math.floor(W / (WH / wallPx))
		local gui = House3DKit.Surface(skin, Enum.NormalId.Back, Vector2.new(canvasW, wallPx), 1)
		local sheet = Instance.new("Frame")
		sheet.Name = "Paper"
		sheet.BackgroundTransparency = 1
		sheet.BorderSizePixel = 0
		sheet.Size = UDim2.fromScale(1, 1)
		sheet.ClipsDescendants = true
		sheet.Parent = gui
		pcall(HousePatterns.BuildWall, sheet, canvasW, wallPx, wallpaper, 1)
		sheet.BackgroundTransparency = 1
	end
	-- Fenêtre du mur du fond (cadre, vitre, rebord ; décor)
	if backWindow then
		-- (v9.8) vraie fenêtre : chambranle mouluré (4 pièces, 0,05 dans le trou :
		-- jamais coplanaire avec les tranches du mur) + appui intérieur en bois
		local bw = backWindow :: { number }
		local z = -D / 2
		local f = 0.4
		local x0, x1, y0, y1 = bw[1], bw[2], bw[3], bw[4]
		local ww = x1 - x0
		shellPart(model, "WindowFrame", Vector3.new(ww + 2 * f, f, 0.3), CFrame.new((x0 + x1) / 2, y1 + f / 2 - 0.05, z + 0.12), trim, M.Wood, false)
		shellPart(model, "WindowFrame", Vector3.new(f, y1 - y0, 0.3), CFrame.new(x0 - f / 2 + 0.05, (y0 + y1) / 2, z + 0.12), trim, M.Wood, false)
		shellPart(model, "WindowFrame", Vector3.new(f, y1 - y0, 0.3), CFrame.new(x1 + f / 2 - 0.05, (y0 + y1) / 2, z + 0.12), trim, M.Wood, false)
		shellPart(model, "WindowSill", Vector3.new(ww + 1.3, 0.28, 0.75), CFrame.new((x0 + x1) / 2, y0 - 0.1, z + 0.3), trim, M.Wood, false)
		model:SetAttribute("BackWindow", Vector3.new((x0 + x1) / 2, (y0 + y1) / 2, 0))
	else
		-- (fenêtre décor de la vue 3D de la maison 2D : vue peinte derrière une vitre)
		-- (v9.6 : place et taille de la fenêtre de la pièce 2D, comme les objets muraux)
		local cx, cy, ww, wh = windowRect(roomWpx, scale)
		local z = -D / 2
		local views = configTable("HouseViewsById")
		local viewEntry = views[tostring(room.View or "Garden")] or views.Garden
		local sky = type(viewEntry) == "table" and asColor(viewEntry.Sky, Color3.fromRGB(170, 214, 255)) or Color3.fromRGB(170, 214, 255)
		shellPart(model, "WindowView", Vector3.new(ww, wh, 0.1), CFrame.new(cx, cy, z + 0.1), sky, M.SmoothPlastic, false).CastShadow = false
		shellPart(model, "WindowHill", Vector3.new(ww, wh * 0.28, 0.1), CFrame.new(cx, cy - wh * 0.36, z + 0.15), GRASS, M.SmoothPlastic, false).CastShadow = false
		local glass = shellPart(model, "WindowGlass", Vector3.new(ww, wh, 0.08), CFrame.new(cx, cy, z + 0.35), Color3.fromRGB(220, 240, 255), M.Glass, false)
		glass.Transparency = 0.75
		glass.CastShadow = false
		local f = 0.35
		for _, spec in ipairs({
			{ 0, wh / 2 + f / 2, ww + 2 * f, f }, { 0, -wh / 2 - f / 2, ww + 2 * f, f },
			{ -ww / 2 - f / 2, 0, f, wh }, { ww / 2 + f / 2, 0, f, wh }, { 0, 0, 0.18, wh }, { 0, 0, ww, 0.18 },
		}) do
			shellPart(model, "WindowFrame", Vector3.new(spec[3], spec[4], 0.4), CFrame.new(cx + spec[1], cy + spec[2], z + 0.25), trim, M.Wood, false)
		end
		shellPart(model, "WindowSill", Vector3.new(ww + 1.2, 0.3, 0.9), CFrame.new(cx, cy - wh / 2 - 0.35, z + 0.45), trim, M.Wood, false)
	end
	model:SetAttribute("Width", W)
	model:SetAttribute("Depth", D)
	model:SetAttribute("WallHeight", WH)
	model:SetAttribute("Scale", scale)
	model:SetAttribute("RoomWpx", roomWpx)
	model.WorldPivot = CFrame.new()
	-- (v9.6) anti-scintillement : moulures, chambranles, fenêtre écartés des
	-- murs / du sol (qui ne bougent pas : collisions et portes intactes)
	pcall(House3DScene.SeparateShell, model, nil)
	return model
end

export type PlaceOptions = {
	Night: boolean?,
	Collide: boolean?, -- (true) gros meubles solides
	Query: boolean?, -- (true) objets visibles aux rayons (déplacer à la souris)
	Yield: boolean?, -- (false) task.wait() entre deux lots d'objets
}

-- Place les objets d'une pièce dans une coque (BuildRoomShell) : dossier
-- "Items" de la coque (vidé d'abord). Renvoie les modèles ; chaque modèle a
-- l'attribut "EntryIndex" (= index dans roomData.Placed).
function House3DScene.PlaceItems(roomModel: Model, roomData: any, options: PlaceOptions?): { Model }
	local opts: PlaceOptions = type(options) == "table" and options or {}
	local scale = tonumber(roomModel:GetAttribute("Scale")) or 32 / ROOM_BASE_WIDTH
	local roomWpx = tonumber(roomModel:GetAttribute("RoomWpx")) or ROOM_BASE_WIDTH
	local D = tonumber(roomModel:GetAttribute("Depth")) or 24
	local WH = tonumber(roomModel:GetAttribute("WallHeight")) or 14
	local dims = House3DLayout.Dims({ Width = roomWpx / ROOM_BASE_WIDTH }, scale, D, WH)
	local frame = roomModel:GetPivot() * CFrame.new(0, 0, -D / 2)
	local folder = roomModel:FindFirstChild("Items")
	if folder then
		folder:ClearAllChildren()
	else
		folder = Instance.new("Folder")
		folder.Name = "Items"
		folder.Parent = roomModel
	end
	local room = type(roomData) == "table" and roomData or {}
	local trimEntry = configTable("HouseTrimsById")[tostring(room.Trim or "Cream")]
	local trim = asColor(type(trimEntry) == "table" and trimEntry.Color, CREAM)
	local entries, indices = House3DLayout.Entries(room)
	local builds: { House3DLayout.Build } = {}
	for index, entry in ipairs(entries) do
		local ok, build = pcall(House3DLayout.Prepare, entry, index, dims, { Night = opts.Night == true, Collide = opts.Collide, Query = opts.Query, Trim = trim })
		if ok and build then
			build.Model:SetAttribute("EntryIndex", indices[index])
			table.insert(builds, build)
		elseif not ok then
			warn("[House3D] Objet " .. tostring(entry.I) .. " : " .. tostring(build))
		end
		if opts.Yield == true and index % 6 == 0 then
			task.wait()
		end
	end
	local okLayout, err = pcall(House3DLayout.Layout, builds, dims, frame)
	if not okLayout then
		warn("[House3D] Disposition : " .. tostring(err))
	end
	local models: { Model } = {}
	for _, build in ipairs(builds) do
		pcall(function()
			build.Model:PivotTo(build.Pivot)
		end)
		build.Model.Parent = folder
		table.insert(models, build.Model)
	end
	-- (v9.6) anti-scintillement entre objets voisins et avec la coque
	pcall(House3DScene.SeparateShell, roomModel, models)
	return models
end

-- v9.6 : faces confondues (z-fighting) d'une coque et de ses objets. Les
-- grandes pièces de la coque (sol, murs, plafond, motifs) restent fixes ;
-- les moulures et les pièces des objets s'écartent de 0,035 stud.
local SHELL_FIXED: { [string]: boolean } = {
	Floor = true, FloorPattern = true, WallPattern = true, Ceiling = true,
	WallBack = true, WallLeft = true, WallRight = true, WallFront = true,
	-- (maquette de la vue 3D : coque, peaux papier peint, socle, studio)
	WallBackPaper = true, WallLeftPaper = true, WallRightPaper = true, Slab = true, Lawn = true, Base = true,
}
function House3DScene.SeparateShell(shell: Instance, items: { any }?)
	local parts: { BasePart } = {}
	local fixed: { [BasePart]: boolean } = {}
	for _, child in ipairs(shell:GetChildren()) do
		if child:IsA("BasePart") then
			table.insert(parts, child)
			if SHELL_FIXED[child.Name] or string.sub(child.Name, 1, 6) == "Studio" then
				fixed[child] = true
			end
		end
	end
	for _, model in ipairs(items or {}) do
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then
				table.insert(parts, d)
			end
		end
	end
	House3DKit.Separate(parts, fixed)
end

return House3DScene
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">House3DSetup</string>
              <string name="Source"><![CDATA[--[[
	House3DSetup (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > House3DSetup

	v9.5 🖥️ "Dopamine Setup" : les modèles 3D de TOUS les objets de la
	catégorie "Setup" (Config.House.Items, champ Setup) : bureaux gamer (1 à 5
	écrans + chaise gamer), clavier mécanique RGB, souris + tapis, télés (de
	S à Géant, sur pied ou au mur avec support), meuble télé, chaînes hi-fi
	(radio-cassette, CD, platine vinyle, mur de studio), moulin à vent,
	presse hydraulique, table à papier bulle, coin live, écran d'infos,
	pots de fleurs du jardin.

	Mêmes conventions que House3DRecipes (Register) : House3DKit.Builder,
	boîte 2D = 100 unités, y = hauteur depuis le sol, +z = le devant ; le
	modèle final (House3DRecipes.BuildModel) regarde -Z, pivot = bas du
	centre, PrimaryPart "Root", attributs ItemId / Footprint / TopHeight...,
	"SeatPart" (chaise des bureaux), "Hitbox".

	Pièces "vivantes" (animées / cliquables par World/LiveProps) :
	  - "Screen" : écran (face Front = côté visible), attributs ScreenKind
	    ("Runner" | "Live" | "DVD" | "News" | "Music") et ScreenIndex ;
	    "ScreenWing" : bords de l'écran incurvé (attribut ScreenIndex) ;
	  - "Key_<A..Z | 0..9 | Space>" : touches du clavier ; "KeyboardBase" ;
	  - "MouseBody", "MouseLeft", "MouseRight", "MouseWheel" ;
	  - "Bubble_<i>" : bulles du papier bulle ;
	  - "PressRam" (tout ce qui descend), "PressButton", "Crushable"
	    (attribut Variant = 1..3 : un seul visible à la fois), "PressBeacon" ;
	  - "Blades" (moyeu) + "Blade" (ailes) : tournent autour de "Pivot_Blades" ;
	  - "Vinyl" (disque qui tourne autour de "Pivot_Vinyl"), "SpeakerCone",
	    "VU_<i>" (barres de niveau), "PlayButton", "NextButton" ;
	  - "RecLight", "OnAir", "RingLight" (coin live) ;
	  - "Flower" : la fleur du pot (se balance autour de "Pivot_Flower") ;
	  - "RGB" : bandes lumineuses arc-en-ciel animées ; "Glow" : lumière fixe.
	  - "Pivot_*" : repères invisibles (pivots des animations ; leur axe Y =
	    la verticale du modèle, leur axe Z = l'axe avant-arrière).

	v9.8 (DESK98) :
	  - clavier mécanique 65 % refait (63 touches avec légendes, plaque RGB,
	    liseré lumineux) : les touches étaient cachées DANS la plaque (voir
	    la recette) ;
	  - télés refaites (dalle fine aux coins arrondis, dos bombé, pieds /
	    supports, barre de son, caisson, halo doux) + champs Setup.Scale
	    (largeur x Scale) et Setup.Cinema (toile + projecteur au plafond) ;
	  - presse refaite (4 colonnes, vérin, manomètres, pupitre, tapis
	    roulant, bac, centrale hydraulique, bandes de danger) aux couleurs des
	    10 paliers de la presse du clicker (House3DSetup.PressTiers) ;
	  - règle d'épaisseur th() : aucune couche < 0,03 stud, faces parallèles
	    de couleurs différentes à plus de 0,03 stud (House3DKit.Separate ne
	    déforme plus rien).

	API :
	  House3DSetup.Register(recipes, family, helpers, flags)  (House3DRecipes)
	  House3DSetup.Has(itemId) -> boolean
	  House3DSetup.SetupOf(itemId) -> { Kind, Tier, Screens, Feeds, ... }?
	  House3DSetup.KindOf(itemId) -> string?
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local House3DKit = require(script.Parent.House3DKit)
local HouseCommon = require(script.Parent.HouseCommon)

type Builder = House3DKit.Builder

local House3DSetup = {}

local M = Enum.Material
local rgb = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)
local INK = rgb(46, 40, 58)
local CARBON = rgb(38, 40, 52)
local CARBON_LIGHT = rgb(64, 66, 84)
local CHROME = rgb(214, 218, 230)
local STEEL = rgb(150, 156, 172)
local SCREEN_OFF = rgb(22, 24, 36)
local PINK = rgb(255, 92, 170)
local CYAN = rgb(70, 225, 255)
local PURPLE = rgb(170, 110, 255)
local MINT = rgb(90, 230, 170)
local GOLD = rgb(245, 190, 60)
local RED = rgb(236, 60, 72)
local ORANGE = rgb(255, 150, 50)
local YELLOW = rgb(255, 214, 60)
local WOOD = rgb(196, 146, 102)
local WOOD_DARK = rgb(128, 86, 60)
local CREAM = rgb(255, 247, 236)
local LEAF = rgb(110, 196, 110)
local LEAF_DARK = rgb(64, 146, 84)
local darken = House3DKit.Darken
local lighten = House3DKit.Lighten

local RAINBOW = { rgb(255, 70, 110), rgb(255, 160, 50), rgb(255, 230, 70), rgb(90, 230, 120), rgb(60, 200, 255), rgb(150, 100, 255) }

local R: { [string]: (b: Builder, ctx: any) -> () } = {}

----------------------------------------------------------------------
-- Réglages "Setup" (lus dans Config ; repli si l'objet n'y est pas)
----------------------------------------------------------------------

-- Repli par préfixe d'id (objet futur sans champ Setup)
local PREFIX_KINDS = {
	{ "SetupDesk", "Desk" },
	{ "SetupKeyboard", "Keyboard" },
	{ "SetupMouse", "Mouse" },
	{ "SetupTVStand", "TVStand" },
	{ "SetupTV", "TV" },
	{ "SetupNewsTV", "NewsTV" },
	{ "SetupHiFi", "HiFi" },
	{ "SetupWindmill", "Windmill" },
	{ "SetupPress", "Press" },
	{ "SetupBubbleWrap", "BubbleWrap" },
	{ "SetupLiveStudio", "LiveStudio" },
	{ "SetupPlant", "Plant" },
}

function House3DSetup.SetupOf(itemId: string): { [string]: any }?
	local item = HouseCommon.ItemsById[itemId]
	if type(item) == "table" and type(item.Setup) == "table" then
		return item.Setup
	end
	if type(itemId) ~= "string" then
		return nil
	end
	for _, pair in ipairs(PREFIX_KINDS) do
		if string.sub(itemId, 1, #pair[1]) == pair[1] then
			local setup: { [string]: any } = { Kind = pair[2], Tier = 1 }
			if pair[2] == "Plant" then
				setup.Flower = string.sub(itemId, #pair[1] + 1)
			end
			return setup
		end
	end
	return nil
end

function House3DSetup.KindOf(itemId: string): string?
	local setup = House3DSetup.SetupOf(itemId)
	return setup and tostring(setup.Kind) or nil
end

local function setupOf(b: Builder): { [string]: any }
	local item = b.Item
	local id = type(item) == "table" and tostring(item.Id) or ""
	return House3DSetup.SetupOf(id) or { Kind = "Unknown", Tier = 1 }
end

local function tierOf(setup: { [string]: any }): number
	return math.clamp(math.floor(tonumber(setup.Tier) or 1), 1, 6)
end

local function sizeRank(setup: { [string]: any }): number
	local size = tostring(setup.Size or "M")
	return ({ S = 1, M = 2, L = 3, XL = 4 })[size] or 2
end

----------------------------------------------------------------------
-- Petits morceaux
----------------------------------------------------------------------

-- Épaisseur (unités) d'au moins `studs` à l'échelle de l'objet
local function th(b: Builder, units: number, studs: number?): number
	return math.max(units, (studs or 0.036) / math.max(0.001, b.K))
end


local function named(part: BasePart, name: string): BasePart
	part.Name = name
	return part
end

local function neon(b: Builder, part: BasePart, name: string?): BasePart
	b.Neon(part)
	if name then
		part.Name = name
	end
	return part
end

-- Repère invisible (pivot d'une animation), repère local = celui de la recette
local function pivot(b: Builder, name: string, x: number, y: number, z: number): BasePart
	local part = b.Part("Part", CFrame.new(x, y, z), Vector3.new(1, 1, 1), WHITE, M.SmoothPlastic, name)
	part.Transparency = 1
	part.CastShadow = false
	return part
end

-- Écran : sa face Front regarde le devant (repère `cf`, bas-centre du verre)
local function screenPart(b: Builder, cf: CFrame, w: number, h: number, kind: string, index: number, depth: number?): BasePart
	local part = b.Part("Part", cf * CFrame.new(0, h / 2, 0) * CFrame.Angles(0, math.pi, 0), Vector3.new(w, h, depth or 0.5), SCREEN_OFF, M.SmoothPlastic, "Screen")
	part.CastShadow = false
	part:SetAttribute("ScreenKind", kind)
	part:SetAttribute("ScreenIndex", index)
	return part
end

-- Moniteur complet (cadre, dos, pied) ; `cf` = bas-centre du cadre, face +z
local function monitor(b: Builder, cf: CFrame, w: number, h: number, kind: string, index: number, frame: Color3, stand: boolean, standH: number)
	local bezel = 1.4
	b.BoxR(cf * CFrame.new(0, h / 2, 0), w + bezel * 2, h + bezel * 2, 1.6, frame, M.SmoothPlastic)
	b.BoxR(cf * CFrame.new(0, h / 2, -1.6), w * 0.5, h * 0.55, 1.8, darken(frame, 0.15), M.SmoothPlastic)
	local glass = cf * CFrame.new(0, 0, 1.05)
	local screen = screenPart(b, glass, w, h, kind, index)
	-- petite diode de marche
	local led = b.BoxR(cf * CFrame.new(w / 2 - 1, -bezel + 0.35, 0.9), 1, 0.5, 0.3, MINT, M.Neon)
	neon(b, led)
	if stand then
		b.BoxR(cf * CFrame.new(0, -standH / 2 - bezel, -2.2), 3, standH, 1.6, CHROME, M.Metal)
		b.BoxR(cf * CFrame.new(0, -standH - bezel + 0.6, -1), 14, 1.2, 9, frame, M.Metal)
	end
	return screen
end

-- Chaise gamer (le personnage regarde vers -z : le bureau) ; assise à `seatY`
local function gamerChair(b: Builder, z: number, seatY: number, main: Color3, trim: Color3, glowing: boolean)
	for index = 0, 4 do
		local angle = index / 5 * math.pi * 2 + 0.3
		b.BoxR(CFrame.new(math.cos(angle) * 7, 1.5, z + math.sin(angle) * 7) * CFrame.Angles(0, -angle, 0), 15, 2, 2.6, CARBON, M.Metal)
		b.Ball(math.cos(angle) * 14, 1.5, z + math.sin(angle) * 14, 3, INK, M.Rubber)
	end
	b.Cyl(0, 2.5, z, 3.2, seatY - 8, CHROME, M.Metal)
	b.Cyl(0, seatY - 7, z, 8, 2, CARBON, M.Metal)
	-- assise
	b.Round(0, seatY - 6, z, 30, 6, 28, 3, CARBON, M.Leather)
	b.Box(0, seatY - 5.6, z, 12, 6.8, 27, main, M.Leather) -- (v9.6 : dépasse de 1.2, plus 0.2)
	-- dossier (côté +z), un peu penché vers l'arrière
	local back = CFrame.new(0, seatY, z + 14) * CFrame.Angles(0.12, 0, 0)
	b.BoxR(back * CFrame.new(0, 19, 0), 28, 38, 5, CARBON, M.Leather)
	b.BoxR(back * CFrame.new(0, 17, -2.6), 11, 30, 0.6, main, M.Leather)
	b.BoxR(back * CFrame.new(0, 17, -3.5), 2, 30, 1.2, trim, M.Leather)
	for _, side in ipairs({ -1, 1 }) do
		b.BoxR(back * CFrame.new(side * 12, 16, -2.5) * CFrame.Angles(0, side * 0.35, 0), 6, 28, 4, main, M.Leather)
		-- accoudoirs
		b.Box(side * 16, seatY - 2, z + 1, 2.4, 9, 2.4, CARBON, M.Metal)
		b.Box(side * 16, seatY + 7, z + 1, 4, 1.6, 14, INK, M.Rubber)
	end
	-- coussin de tête
	b.EggR(back * CFrame.new(0, 34, -3), 14, 6, 4, trim, M.Fabric)
	if glowing then
		local strip = b.BoxR(back * CFrame.new(0, 1, 2.7), 26, 1, 0.4, trim, M.Neon)
		neon(b, strip, "RGB")
	end
	b.Seat(0, seatY, z, 26, 24)
end

----------------------------------------------------------------------
-- 🖥️ BUREAUX GAMER
----------------------------------------------------------------------

-- Disposition des écrans : x, largeur, hauteur, lacet, "Top" (étage), "Curved"
type Slot = { X: number, W: number, H: number, Yaw: number, Top: boolean?, Curved: boolean? }
local LAYOUTS: { [number]: { Slot } } = {
	[1] = { { X = 0, W = 48, H = 28, Yaw = 0 } },
	[2] = { { X = -21.5, W = 40, H = 24, Yaw = 0.2 }, { X = 21.5, W = 40, H = 24, Yaw = -0.2 } },
	[3] = { { X = -34, W = 28, H = 18, Yaw = 0.45 }, { X = 0, W = 36, H = 22, Yaw = 0 }, { X = 34, W = 28, H = 18, Yaw = -0.45 } },
	[4] = { { X = -38, W = 22, H = 15, Yaw = 0.55 }, { X = -12.5, W = 23, H = 14, Yaw = 0.1, Top = true }, { X = 0, W = 34, H = 19, Yaw = 0, Curved = true }, { X = 38, W = 22, H = 15, Yaw = -0.55 } },
	[5] = {
		{ X = -39, W = 22, H = 15, Yaw = 0.55 },
		{ X = -12.5, W = 23, H = 14, Yaw = 0.1, Top = true },
		{ X = 0, W = 34, H = 19, Yaw = 0, Curved = true },
		{ X = 12.5, W = 23, H = 14, Yaw = -0.1, Top = true },
		{ X = 39, W = 22, H = 15, Yaw = -0.55 },
	},
}
local DEFAULT_FEEDS = { "Runner", "Live", "News", "DVD", "Live" }

local DESK_STYLES = {
	{ Edge = PINK, Chair = PINK, Trim = WHITE, Top = CARBON },
	{ Edge = CYAN, Chair = rgb(60, 170, 255), Trim = CYAN, Top = CARBON },
	{ Edge = PURPLE, Chair = PURPLE, Trim = rgb(255, 120, 220), Top = rgb(30, 30, 44) },
	{ Edge = RAINBOW[1], Chair = rgb(255, 70, 140), Trim = CYAN, Top = rgb(24, 24, 34) },
}

-- Tour PC (au sol, sous le bureau) : façade vitrée + ventilateurs lumineux
local function pcTower(b: Builder, x: number, z: number, h: number, glow: Color3, rgbFans: boolean)
	b.Box(x, 0, z, 17, h, 32, CARBON, M.SmoothPlastic)
	-- (v9.6 z-fighting : vitre puis ventilateurs empilés SANS faces confondues :
	-- vitre 16..16.5, anneau 16.5..17.5, moyeu 17.5..18.2, centre 18.2..18.9)
	b.Box(x, 1, z + 16.25, 15, h - 2, 0.5, rgb(60, 70, 96), M.Glass).Transparency = 0.35
	for index = 1, 3 do
		local y = h * (index / 3.6) + 2
		local ring = b.CylZ(x, y, z + 17, 10, 1, rgbFans and RAINBOW[index * 2] or glow, M.Neon)
		neon(b, ring, rgbFans and "RGB" or "Glow")
		b.CylZ(x, y, z + 17.85, 7, 0.7, INK, M.SmoothPlastic)
		b.CylZ(x, y, z + 18.55, 2.4, 0.7, CARBON_LIGHT, M.Metal)
	end
	local power = b.CylZ(x + 5, h - 3, z + 16.9, 2, 0.8, glow, M.Neon)
	neon(b, power, "Glow")
end

local function desk(b: Builder, ctx: any)
	local setup = setupOf(b)
	local tier = math.clamp(tierOf(setup), 1, 4)
	local style = DESK_STYLES[tier]
	local count = math.clamp(math.floor(tonumber(setup.Screens) or tier), 1, 5)
	local feeds = type(setup.Feeds) == "table" and setup.Feeds or {}
	local rgbAll = setup.RGB == true or tier >= 4
	local T = ctx.TopY(1, 50)
	local deskW = tier >= 4 and 100 or 96
	local deskD = 46
	local deskZ = -25 -- centre du plateau (le dos du bureau à z = -48)
	local frame = rgb(28, 28, 38)
	local top = b.Map(style.Top)
	local edge = b.Map(style.Edge)
	-- plateau + chant lumineux
	b.Box(0, T - 3, deskZ, deskW, 3, deskD, top, M.SmoothPlastic)
	b.Box(0, T - 4, deskZ, deskW - 4, 1, deskD - 4, darken(top, 0.3), M.SmoothPlastic) -- (v9.6 : dessous 1 plus bas, plus 0.2)
	local strip = b.Box(0, T - 2.6, deskZ + deskD / 2 + 0.2, deskW - 2, 1.2, 0.6, edge, M.Neon)
	neon(b, strip, rgbAll and "RGB" or "Glow")
	-- tapis de bureau XXL (fin, à l'avant)
	b.Box(0, T, deskZ + 9, deskW - 14, 0.25, 22, rgb(34, 34, 48), M.Fabric)
	if tier >= 3 then
		local matEdge = b.Box(0, T, deskZ + 20.2, deskW - 14, 0.3, 0.5, edge, M.Neon)
		neon(b, matEdge, rgbAll and "RGB" or "Glow")
	end
	-- pieds en "Z" (panneaux latéraux)
	for _, side in ipairs({ -1, 1 }) do
		local x = side * (deskW / 2 - 3)
		b.Box(x, 0, deskZ, 3, T - 3, 6, CARBON_LIGHT, M.Metal)
		b.Box(x, 0, deskZ, 4, 2.4, deskD - 4, CARBON, M.Metal)
		b.Box(x, T - 7, deskZ, 4, 3, deskD - 6, CARBON, M.Metal)
		local foot = b.Box(x + side * 0.1, 2.4, deskZ + deskD / 2 - 6, 4.2, 0.6, 2, edge, M.Neon)
		neon(b, foot, rgbAll and "RGB" or "Glow")
	end
	-- goulotte à câbles + lumière sous le bureau
	b.Box(0, T - 9, -44, deskW * 0.6, 4, 6, CARBON, M.Metal)
	if tier >= 2 then
		local under = b.Box(0, T - 4.8, -40, deskW - 12, 0.8, 2, edge, M.Neon)
		neon(b, under, rgbAll and "RGB" or "Glow")
	end
	-- tour PC (au sol, à droite) ; bureau ultime : une seconde à gauche
	pcTower(b, deskW / 2 - 15, -30, math.min(T - 6, 40), edge, rgbAll)
	-- écrans
	local layout = LAYOUTS[count] or LAYOUTS[1]
	local baseY = T + 8
	local monitorZ = -38
	local topY = baseY
	local highest = baseY
	for _, slot in ipairs(layout) do
		if not slot.Top then
			topY = math.max(topY, baseY + slot.H + 3)
		end
	end
	for index, slot in ipairs(layout) do
		local kind = tostring(feeds[index] or DEFAULT_FEEDS[index] or "Runner")
		local y = slot.Top and topY or baseY
		local cf = CFrame.new(slot.X, y, monitorZ) * CFrame.Angles(0, slot.Yaw, 0)
		if slot.Curved and setup.Curved ~= false then
			-- ultra-large incurvé : panneau central + deux ailes tournées vers soi
			-- (v9.6 : pied posé SUR le plateau, plus enfoncé de 0.2 dedans)
			monitor(b, cf, slot.W, slot.H, kind, index, frame, true, y - T - 1.4)
			local wing = 9
			for _, side in ipairs({ -1, 1 }) do
				local a = -side * 0.38
				local inner = CFrame.new(slot.X + side * (slot.W / 2 + 1.4), y, monitorZ)
				local wingCF = inner * CFrame.Angles(0, a, 0) * CFrame.new(side * wing / 2, 0, 0)
				b.BoxR(wingCF * CFrame.new(0, slot.H / 2, 0), wing + 1.4, slot.H + 2.8, 1.6, frame, M.SmoothPlastic)
				-- (v9.8 : ailes en verre sombre, plus des dalles Neon cyan éblouissantes)
				local w = b.Part("Part", wingCF * CFrame.new(0, slot.H / 2, 1.05) * CFrame.Angles(0, math.pi, 0), Vector3.new(wing, slot.H, 0.5), rgb(18, 22, 34), M.SmoothPlastic, "ScreenWing")
				w.CastShadow = false
				w:SetAttribute("ScreenIndex", index)
			end
		else
			monitor(b, cf, slot.W, slot.H, kind, index, frame, not slot.Top, y - T - 1.4)
		end
		highest = math.max(highest, y + slot.H + 1.4)
	end
	-- bras de moniteur (écrans du haut) : mât + traverse
	if count >= 4 then
		b.Box(0, T, monitorZ - 5, 3, topY - T + 8, 3, CHROME, M.Metal)
		b.Box(0, topY + 6, monitorZ - 3.5, 34, 2, 2, CHROME, M.Metal)
		b.Box(0, T, monitorZ - 5, 12, 1.2, 8, frame, M.Metal)
	end
	-- rétroéclairage derrière les écrans
	if tier >= 3 then
		local barTop = count >= 4 and (topY + 16) or (baseY + 24)
		for _, side in ipairs({ -1, 1 }) do
			local bar = b.Box(side * (deskW / 2 - 12), T + 1, -47.4, 1.6, barTop - T - 1, 0.6, edge, M.Neon)
			neon(b, bar, rgbAll and "RGB" or "Glow")
		end
		local beam = b.Box(0, barTop - 1.6, -47.4, deskW - 22, 1.6, 0.6, edge, M.Neon)
		neon(b, beam, rgbAll and "RGB" or "Glow")
	end
	-- déco selon le palier : casque sur son crochet, enceintes, figurine
	if tier >= 2 then
		b.Box(deskW / 2 + 1, T - 12, deskZ + 10, 1.6, 6, 1.6, CHROME, M.Metal)
		House3DKit.Path(b, { { deskW / 2 + 1.5, T - 13, deskZ + 6 }, { deskW / 2 + 1.5, T - 5, deskZ + 7 }, { deskW / 2 + 1.5, T - 5, deskZ + 13 }, { deskW / 2 + 1.5, T - 13, deskZ + 14 } }, 1.4, INK, M.SmoothPlastic)
		for _, dz in ipairs({ 6, 14 }) do
			local cup = b.CylX(deskW / 2 + 1.5, T - 14, deskZ + dz, 5, 2.4, style.Chair, M.Fabric)
			cup.Name = "Casque"
		end
	end
	if tier >= 4 then
		for _, side in ipairs({ -1, 1 }) do
			local x = side * 45
			b.Box(x, T, -44, 7, 14, 7, CARBON, M.SmoothPlastic)
			local ring = b.CylZ(x, T + 9, -40.3, 5.5, 0.6, RAINBOW[side == -1 and 5 or 2], M.Neon)
			neon(b, ring, "RGB")
			b.CylZ(x, T + 9, -40.1, 4, 0.7, INK, M.SmoothPlastic)
			b.CylZ(x, T + 3.4, -40.3, 2.4, 0.6, CARBON_LIGHT, M.Metal)
		end
	end
	-- chaise gamer (devant le bureau, tournée vers les écrans)
	local seatY = math.clamp(T * 0.6, 20, 36)
	gamerChair(b, 26, seatY, b.Map(style.Chair), style.Trim, tier >= 3)
	-- (dessus libre = l'avant du plateau : clavier, souris, plantes)
	b.Top(1, 0, T, deskZ + 11, deskW - 10, 22)
	local height = count >= 4 and math.max(highest, topY + 8) or highest
	b.Footprint(deskW, 96, math.max(height, T + 30))
end

R.SetupDeskSolo = desk
R.SetupDeskDuo = desk
R.SetupDeskTrio = desk
R.SetupDeskUltra = desk

----------------------------------------------------------------------
-- ⌨️ CLAVIER MÉCANIQUE RGB (v9.8 : refait)
-- Cause du clavier "cassé" (v9.5 -> v9.7) : à cette échelle (1 unité ≈
-- 0,02 stud) la plaque "KeyboardBase" de 0,6 unité était gonflée à
-- l'épaisseur minimale (0,03 stud) puis encore poussée par l'anti-
-- scintillement (House3DKit.Separate) AU-DESSUS des touches : seules la
-- barre d'espace et les grandes touches dépassaient. Ici chaque couche
-- fait au moins l'épaisseur minimale et deux faces parallèles de couleurs
-- différentes sont toujours à plus de 0,03 stud l'une de l'autre.
-- Clavier 65 % : 5 rangées de 15 unités de touche, flèches, touches larges ;
-- légendes posées par LiveProps (une SurfaceGui par touche, seulement de
-- près) grâce à l'attribut "Legend" ; plaque RGB entre les touches (douce,
-- pas de néon) + fin liseré lumineux sous le boîtier.
----------------------------------------------------------------------

-- { nom, légende, largeur (unités de touche), style } ; style : "A" lettre,
-- "M" modificateur, "X" accent
local KEY_LAYOUT: { { any } } = {
	{ { "Grave", "`" }, { "1" }, { "2" }, { "3" }, { "4" }, { "5" }, { "6" }, { "7" }, { "8" }, { "9" }, { "0" }, { "Minus", "-" }, { "Equals", "=" }, { "Backspace", "⌫", 2, "M" } },
	{ { "Tab", "Tab", 1.5, "M" }, { "Q" }, { "W" }, { "E" }, { "R" }, { "T" }, { "Y" }, { "U" }, { "I" }, { "O" }, { "P" }, { "LBracket", "[" }, { "RBracket", "]" }, { "Backslash", "\\", 1.5, "M" } },
	{ { "Caps", "Caps", 1.75, "M" }, { "A" }, { "S" }, { "D" }, { "F" }, { "G" }, { "H" }, { "J" }, { "K" }, { "L" }, { "Semicolon", ";" }, { "Quote", "'" }, { "Enter", "Enter", 2.25, "X" } },
	{ { "LShift", "Shift", 2.25, "M" }, { "Z" }, { "X" }, { "C" }, { "V" }, { "B" }, { "N" }, { "M" }, { "Comma", "," }, { "Period", "." }, { "Slash", "/" }, { "RShift", "Shift", 1.75, "M" }, { "Up", "▲", 1, "X" } },
	{ { "LCtrl", "Ctrl", 1.25, "M" }, { "Win", "◆", 1.25, "M" }, { "LAlt", "Alt", 1.25, "M" }, { "Space", "", 6.25, "A" }, { "RAlt", "Alt", 1, "M" }, { "Fn", "Fn", 1, "M" }, { "Left", "◀", 1, "X" }, { "Down", "▼", 1, "X" }, { "Right", "▶", 1, "X" } },
}
House3DSetup.KeyLayout = KEY_LAYOUT

R.SetupKeyboard = function(b, _ctx)
	local caseColor = b.Map(rgb(46, 48, 64))
	local rimColor = caseColor -- (même teinte que le bac : aucune face confondue de couleur différente)
	local alpha = b.Map(rgb(246, 242, 234))
	local modifier = b.Map(rgb(112, 108, 150))
	local accent = b.Map(rgb(255, 104, 170))
	local w, d = 100, 44
	local U = 6 -- une unité de touche
	local gap = 0.9
	local layer = th(b, 2.2)
	-- (règle anti-scintillement : deux faces parallèles, tournées du même
	-- côté, de couleurs différentes, qui se recouvrent -> au moins 0,03 stud
	-- d'écart ; sinon House3DKit.Separate déforme les pièces)
	local clear = th(b, 1.4, 0.031)
	-- boîtier (bac arrondi) + liseré lumineux dessous (doux, en retrait)
	local trayH = 5
	b.Round(0, 0, 0, w, trayH, d, 3, caseColor, M.SmoothPlastic)
	local glowY = clear
	local glow = b.Box(0, glowY, 0, w + clear * 2, th(b, 1.6), d + clear * 2, RAINBOW[5], M.Neon)
	neon(b, glow, "RGB")
	glow.Transparency = 0.45
	-- plaque (couleur RGB animée, SmoothPlastic : lueur douce entre les touches)
	local plateTop = trayH + clear
	local plateBottom = plateTop - layer
	local plateW, plateD = 90 + clear * 2 + 0.9, 30 + clear * 2 + 0.9
	named(b.Box(0, plateBottom, 0, plateW, layer, plateD, rgb(120, 90, 255), M.SmoothPlastic), "RGB").CastShadow = false
	-- rebord du boîtier (4 baguettes au-dessus de la plaque, même teinte que le bac)
	local rimH = math.max(th(b, 2.8), plateTop - plateBottom + clear)
	local rimTop = plateBottom + rimH
	local rimW = 2
	b.Box(0, plateBottom, d / 2 - rimW / 2, w, rimH, rimW, rimColor, M.SmoothPlastic)
	b.Box(0, plateBottom, -d / 2 + rimW / 2, w, rimH, rimW, rimColor, M.SmoothPlastic)
	b.Box(-w / 2 + rimW / 2, plateBottom, 0, rimW, rimH, d - rimW * 2 + 0.4, rimColor, M.SmoothPlastic)
	b.Box(w / 2 - rimW / 2, plateBottom, 0, rimW, rimH, d - rimW * 2 + 0.4, rimColor, M.SmoothPlastic)
	-- touches (le bas des touches est pris dans la plaque : aucune face confondue)
	local keyBottom = plateTop - math.min(0.5, layer - clear)
	local keyH = math.max(4, rimTop - keyBottom + 2.2)
	for rowIndex, row in ipairs(KEY_LAYOUT) do
		local z = -12 + (rowIndex - 1) * U -- rangée 1 au fond, espace devant
		local cursor = -45
		for _, spec in ipairs(row) do
			local id = spec[1]
			local legend = spec[2] or id
			local width = tonumber(spec[3]) or 1
			local style = spec[4] or "A"
			local x = cursor + width * U / 2
			cursor += width * U
			local color = style == "M" and modifier or (style == "X" and accent or alpha)
			-- rangée du fond un peu plus haute (profil "sculpté")
			local lift = (rowIndex == 1 and 0.5) or (rowIndex == 5 and -0.3) or 0
			local key = b.Box(x, keyBottom, z, width * U - gap, keyH + lift, U - gap, color, M.SmoothPlastic)
			key.Name = "Key_" .. id
			key:SetAttribute("Legend", legend)
			key:SetAttribute("KeyStyle", style)
		end
	end
	-- molette de volume (sur le rebord arrière droit) + diode
	b.Cyl(w / 2 - 7, rimTop - 1, -d / 2 + rimW / 2, 3.6, 2.6, CHROME, M.Metal)
	neon(b, b.Ball(w / 2 - 14, rimTop - 0.3, -d / 2 + rimW / 2, 1.6, MINT, M.Neon), "Glow")
	-- câble tressé vers l'arrière
	House3DKit.Path(b, { { -20, 3, -d / 2 - 0.5 }, { -22, 2, -d / 2 - 8 }, { -30, 1.6, -d / 2 - 14 } }, 2.2, INK, M.Fabric)
	b.Footprint(w, d, rimTop + keyH)
end

----------------------------------------------------------------------
-- 🖱️ SOURIS GAMING + TAPIS
----------------------------------------------------------------------

R.SetupMouse = function(b, _ctx)
	local body = b.Map(rgb(36, 36, 50))
	-- tapis (bord lumineux)
	-- (v9.6 z-fighting : tapis de 4 d'épaisseur (le tapis du bureau fait
	-- 0,03 stud : le dessus du tapis de souris est maintenant bien au-dessus),
	-- autocollant de 2 ; la souris posée dessus (+2.6))
	local pad = 4
	b.Round(0, 0, 0, 100, pad, 76, 5, rgb(30, 30, 42), M.Fabric)
	for _, side in ipairs({ -1, 1 }) do
		-- (bords lumineux épais de 3 : l'épaisseur mini des pièces (0,03 stud)
		-- ne les ramène plus sur les faces du tapis)
		neon(b, b.Box(0, 0.2, side * 40, 94, pad - 1.4, 3, RAINBOW[5], M.Neon), "RGB")
		neon(b, b.Box(side * 52, 0.2, 0, 3, pad - 1.4, 70, RAINBOW[1], M.Neon), "RGB")
	end
	b.Box(-30, pad, -26, 22, 2, 10, rgb(255, 92, 170), M.SmoothPlastic)
	-- souris
	local mx, mz = 12, 4
	local up = pad - 1.4
	named(b.Egg(mx, 7 + up, mz + 3, 30, 14, 46, body, M.SmoothPlastic), "MouseBody")
	b.Box(mx, pad, mz + 3, 22, 3, 36, body, M.SmoothPlastic)
	for _, side in ipairs({ -1, 1 }) do
		local button = b.BoxR(CFrame.new(mx + side * 6.6, 12.4 + up, mz - 9) * CFrame.Angles(0.22, 0, 0), 12, 2, 18, lighten(body, 0.12), M.SmoothPlastic)
		button.Name = side == -1 and "MouseLeft" or "MouseRight"
		b.BoxR(CFrame.new(mx + side * 14.4, 8 + up, mz + 2) * CFrame.Angles(0, 0, side * 0.35), 1.2, 6, 24, CARBON_LIGHT, M.Rubber)
	end
	local wheel = b.CylX(mx, 13.6 + up, mz - 10, 5, 3, RAINBOW[6], M.Neon)
	neon(b, wheel, "MouseWheel")
	local logo = b.Ball(mx, 12.2 + up, mz + 14, 4.5, RAINBOW[5], M.Neon)
	neon(b, logo, "RGB")
	-- câble (tressé) vers l'arrière
	House3DKit.Path(b, { { mx, 4 + up, mz - 20 }, { mx - 4, 2.2 + up, mz - 30 }, { mx - 20, 2 + up, -36 }, { mx - 30, 2 + up, -40 } }, 1.6, INK, M.Fabric)
	b.Footprint(100, 76, 16 + up)
end

----------------------------------------------------------------------
-- 📺 TÉLÉS (logo DVD) + MEUBLE TÉLÉ + ÉCRAN D'INFOS
----------------------------------------------------------------------

-- v9.8 📺 Télés "10x" : dalle ultra-fine aux coins arrondis, bords fins,
-- dos bombé, pieds / supports réalistes, barre de son, halo doux pour les
-- grandes, écran de cinéma (projecteur au plafond + toile). Les épaisseurs
-- suivent l'échelle (th) : aucune couche plus fine que 0,03 stud, aucune
-- face confondue (l'écran dépasse de 0,03 stud du cadre).

-- Bloc aux coins arrondis dans le plan de l'image (arêtes le long de Z) ;
-- `cf` = centre du bloc
local function roundRectZ(b: Builder, cf: CFrame, w: number, h: number, d: number, r: number, color: Color3, material: Enum.Material?)
	r = math.clamp(r, 0.3, math.min(w, h) / 2 - 0.05)
	local main = b.BoxR(cf, w - 2 * r, h, d, color, material)
	b.BoxR(cf, w, h - 2 * r, d, color, material)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sy in ipairs({ -1, 1 }) do
			local corner = b.Part("Part", cf * CFrame.new(sx * (w / 2 - r), sy * (h / 2 - r), 0) * CFrame.Angles(0, math.pi / 2, 0), Vector3.new(d, 2 * r, 2 * r), color, material, "Cylindre")
			;(corner :: Part).Shape = Enum.PartType.Cylinder
		end
	end
	return main
end

type Panel = { W: number, H: number, Back: number, Screen: BasePart }

-- Dalle 16:9 : `cf` = bas-centre de la FACE AVANT du cadre ; renvoie ses mesures
local function tvPanel(b: Builder, cf: CFrame, w: number, kind: string, frameColor: Color3): Panel
	local h = w * 9 / 16
	local bezel = math.max(1.1, w * 0.011)
	local chin = bezel * 2.4
	local depth = th(b, 2.2)
	local bulge = th(b, 2.6)
	local gap = th(b, 0, 0.032)
	local W, H = w + bezel * 2, h + bezel + chin
	roundRectZ(b, cf * CFrame.new(0, H / 2, -depth / 2), W, H, depth, math.max(1.4, w * 0.018), frameColor, M.SmoothPlastic)
	-- dos bombé (électronique) : en partie pris dans la dalle
	roundRectZ(b, cf * CFrame.new(0, H * 0.52, -depth - bulge * 0.35), W * 0.7, H * 0.62, bulge, math.max(2, w * 0.05), darken(frameColor, 0.14), M.SmoothPlastic)
	-- écran : sa face avant à 0,03 stud devant le cadre
	local screenDepth = th(b, 0.8)
	local screen = screenPart(b, cf * CFrame.new(0, chin, gap - screenDepth / 2), w, h, kind, 1, screenDepth)
	-- logo de la marque + diode (dans le menton, même plan que l'écran)
	b.BoxR(cf * CFrame.new(0, chin / 2, gap - screenDepth / 2), math.min(10, w * 0.07), chin * 0.28, screenDepth, CHROME, M.Metal)
	neon(b, b.BoxR(cf * CFrame.new(w / 2 - 2, chin / 2, gap - screenDepth / 2), 1.2, chin * 0.24, screenDepth, RED, M.Neon), "Glow")
	return { W = W, H = H, Back = depth + bulge * 0.85, Screen = screen }
end

-- Barre de son (bouts arrondis, grille en tissu, diode) ; `z` = face arrière
local function soundbar(b: Builder, x: number, y: number, z: number, w: number)
	local h = 5
	local d = 6.5
	local r = h / 2
	b.Box(x, y, z + d / 2, w - h, h, d, CARBON, M.SmoothPlastic)
	for _, side in ipairs({ -1, 1 }) do
		-- (cylindre couché avant-arrière : bouts arrondis vus de face)
		local cap = b.Part("Part", CFrame.new(x + side * (w / 2 - r), y + r, z + d / 2) * CFrame.Angles(0, math.pi / 2, 0), Vector3.new(d, h, h), CARBON, M.SmoothPlastic, "Cylindre")
		;(cap :: Part).Shape = Enum.PartType.Cylinder
	end
	-- grille (tissu) : devant la barre, un peu en retrait des bouts
	local fabric = th(b, 1)
	b.Box(x, y + 0.6, z + d + fabric / 2 - fabric * 0.4, w - h - 2, h - 1.2, fabric, rgb(62, 62, 78), M.Fabric)
	neon(b, b.Box(x + w * 0.3, y + h - 0.2, z + d * 0.5, 2.4, th(b, 0.6), 1.2, CYAN, M.Neon), "Glow")
end

-- 🎬 Écran de cinéma : toile déroulante + projecteur accroché au plafond
local function cinema(b: Builder, setup: { [string]: any }, kind: string)
	local w = 94 * math.clamp(tonumber(setup.Scale) or 2.2, 1, 3)
	local h = w * 9 / 16
	local border = math.max(3, w * 0.025)
	local W, H = w + border * 2, h + border * 2
	local t = th(b, 1.2)
	local gap = th(b, 0, 0.032)
	local y0 = 6
	-- fond noir (bordure de la toile)
	b.Box(0, y0, 2 + t / 2, W, H, t, rgb(20, 20, 26), M.Fabric)
	-- toile blanche (l'écran) : 0,03 stud devant le fond
	local screenDepth = th(b, 0.8)
	screenPart(b, CFrame.new(0, y0 + border, 2 + t + gap - screenDepth / 2), w, h, kind, 1, screenDepth).Material = M.Fabric
	-- carter du rouleau (en haut) + barre de lestage (en bas) + tirette
	local top = y0 + H
	b.CylX(0, top + 3.2, 4, 7, W + 8, rgb(236, 236, 244), M.SmoothPlastic)
	for _, side in ipairs({ -1, 1 }) do
		b.CylX(side * (W / 2 + 4.6), top + 3.2, 4, 8, 1.4, CARBON, M.SmoothPlastic)
		b.Box(side * (W / 2 + 2), top + 1, 0, 3, 6, 4, CARBON_LIGHT, M.Metal)
	end
	b.CylX(0, y0 - 1.4, 2 + t / 2, 2.8, W + 2, CARBON, M.Metal)
	House3DKit.Path(b, { { 0, y0 - 2.4, 2 + t / 2 }, { 0, y0 - 9, 2 + t / 2 } }, 0.8, INK, M.Fabric)
	b.Ball(0, y0 - 10, 2 + t / 2, 2.6, CARBON, M.SmoothPlastic)
	-- projecteur au plafond (devant la toile, objectif tourné vers elle)
	local pz = math.max(60, w * 0.45)
	local py = top + 6
	b.Cyl(0, py + 12, pz, 12, th(b, 1.4), rgb(236, 236, 244), M.SmoothPlastic) -- platine de plafond
	b.Cyl(0, py + 6, pz, 2, 7, CHROME, M.Metal)
	b.Round(0, py - 4, pz, 28, 10, 24, 3, rgb(244, 244, 250), M.SmoothPlastic)
	b.Box(0, py - 4.6, pz, 20, th(b, 1), 18, CARBON_LIGHT, M.SmoothPlastic) -- dessous
	b.CylZ(-6, py + 1, pz - 12.6, 7, 2.4, CARBON, M.Metal)
	neon(b, b.CylZ(-6, py + 1, pz - 13.8 - th(b, 0.4) / 2, 4.4, th(b, 0.4), rgb(200, 230, 255), M.Neon), "Glow")
	for index = 0, 3 do
		b.Box(6 + index * 3, py + 3, pz + 12 + th(b, 0.6) / 2, 1.6, 4, th(b, 0.6), CARBON, M.SmoothPlastic)
	end
	neon(b, b.Ball(10, py + 6.2, pz - 8, 1.4, MINT, M.Neon), "Glow")
	b.Footprint(W + 12, 14, 100)
end

local function tvRecipe(b: Builder, _ctx: any)
	local setup = setupOf(b)
	local rank = sizeRank(setup)
	local scale = math.clamp(tonumber(setup.Scale) or 1, 1, 3)
	local frameColor = rank >= 3 and rgb(26, 26, 34) or b.Map(rgb(40, 40, 54))
	local feeds = type(setup.Feeds) == "table" and setup.Feeds or {}
	local kind = tostring(feeds[1] or "DVD")
	if setup.Cinema == true then
		cinema(b, setup, kind)
		return
	end
	local w = 94 * scale
	local h = w * 9 / 16
	local big = rank >= 4 or scale > 1
	if tostring(setup.Mount) == "Wall" then
		-- au mur : platine fine + bras (moyenne) ; la dalle presque contre le mur
		local armed = rank <= 2 and not big
		local plate = th(b, 1.2)
		local front = armed and 12 or 7.5
		local H = h + math.max(1.1, w * 0.011) * 3.4
		local y0 = math.max(4, 50 - H / 2)
		b.Box(0, y0 + H * 0.3, plate / 2, 26, 22, plate, CARBON_LIGHT, M.Metal)
		if armed then
			-- bras articulé (2 segments + rotules)
			House3DKit.Path(b, { { 0, y0 + H * 0.42, plate }, { -8, y0 + H * 0.46, front * 0.55 }, { 0, y0 + H * 0.5, front - 3.5 } }, 2.6, STEEL, M.Metal)
		else
			for _, side in ipairs({ -1, 1 }) do
				b.Box(side * 9, y0 + H * 0.34, plate, 3, 3, front - 3 - plate, STEEL, M.Metal)
			end
		end
		if big then
			-- halo doux derrière la télé (entre la télé et le mur)
			local halo = b.Box(0, y0 - 3, plate + th(b, 0.8), w + 10, H + 6, th(b, 0.4), CYAN, M.Neon)
			neon(b, halo, "Ambilight")
			halo.Transparency = 0.6
		end
		tvPanel(b, CFrame.new(0, y0, front), w, kind, frameColor)
		if rank >= 3 or big then
			soundbar(b, 0, y0 - 8.5, plate + 1, math.min(w * 0.7, 110))
			b.Box(0, y0 - 4, plate, 18, 1.4, 3, STEEL, M.Metal)
		end
		b.Footprint(w + 6, 14, 100)
		return
	end
	if big then
		-- grande sur pied : deux mâts de studio + barre de son
		local y0 = 24
		local panelBack = -3.4
		local legX = math.min(w * 0.3, 44)
		for _, side in ipairs({ -1, 1 }) do
			b.Cyl(side * legX, 2, panelBack - 4, 3.2, y0 + h * 0.6, CHROME, M.Metal)
			b.Round(side * legX, 0, panelBack - 2, 12, th(b, 2), 30, 3, CARBON, M.Metal)
		end
		b.Box(0, y0 + h * 0.3, panelBack - 4.6, legX * 2 + 4, 3, 2.6, CARBON_LIGHT, M.Metal)
		local halo = b.Box(0, y0 - 2, panelBack - 7.5, w + 8, h + 8, th(b, 0.4), CYAN, M.Neon)
		neon(b, halo, "Ambilight")
		halo.Transparency = 0.6
		tvPanel(b, CFrame.new(0, y0, 0), w, kind, frameColor)
		soundbar(b, 0, 3.4, 8, math.min(w * 0.75, 120))
		-- caisson de basses à côté
		b.Round(legX + 18, 0, 6, 16, 16, 16, 2.5, CARBON, M.SmoothPlastic)
		b.CylZ(legX + 18, 8, 14 + th(b, 0.8) / 2, 10, th(b, 0.8), rgb(56, 56, 70), M.Fabric)
		b.Footprint(math.max(w + 6, 100), 34, y0 + h + 8)
		return
	end
	-- petite / moyenne / grande sur meuble : pied central (petite, grande) ou lames (moyenne)
	local y0 = rank == 3 and 8 or 7
	if rank == 2 then
		for _, side in ipairs({ -1, 1 }) do
			local x = side * w * 0.36
			b.BoxR(CFrame.new(x, y0 * 0.5, -2) * CFrame.Angles(0, 0, side * 0.32), 2.2, y0 + 2.5, 3.2, CHROME, M.Metal)
			b.Round(x + side * 2, 0, -1, 9, th(b, 1.2), 14, 2, CHROME, M.Metal)
		end
	else
		b.Box(0, 0.8, -4.2, 7, y0 + 6, th(b, 1.6), CHROME, M.Metal)
		b.Round(0, 0, -2, rank == 3 and 40 or 30, th(b, 1.4), 14, 5, CARBON_LIGHT, M.Metal)
	end
	tvPanel(b, CFrame.new(0, y0, 0), w, kind, frameColor)
	if rank >= 3 then
		soundbar(b, 0, 0, 5, w * 0.6)
	end
	b.Footprint(100, rank >= 3 and 24 or 18, y0 + h + 5)
end

R.SetupTVSmall = tvRecipe
R.SetupTVMedium = tvRecipe
R.SetupTVLarge = tvRecipe
R.SetupTVGiant = tvRecipe
R.SetupTVWallMedium = tvRecipe
R.SetupTVWallLarge = tvRecipe
R.SetupTVWallGiant = tvRecipe

R.SetupNewsTV = function(b, _ctx)
	-- écran mural "Breaking news" : cadre rouge, bandeau lumineux
	b.Box(0, 44, 2, 26, 14, 4, CARBON_LIGHT, M.Metal)
	local w = 92
	local h = w * 9 / 16
	local y0 = 50 - h / 2 - 2
	b.Box(0, y0 - 2, 5, w + 6, h + 8, 2.4, rgb(40, 14, 24), M.SmoothPlastic)
	-- (v9.6 z-fighting : bandeaux 1 plus larges et 0.5 plus épais que le cadre)
	neon(b, b.Box(0, y0 - 3.2, 5, w + 8, 1.2, 4.4, RED, M.Neon), "Glow")
	neon(b, b.Box(0, y0 + h + 6, 5, w + 8, 1.2, 4.4, RED, M.Neon), "Glow")
	screenPart(b, CFrame.new(0, y0 + 2, 6.45), w, h, "News", 1)
	-- voyant "ON AIR" au-dessus
	local lamp = b.Round(0, y0 + h + 7, 4, 22, 5, 3, 1.5, RED, M.Neon)
	neon(b, lamp, "OnAir")
	b.Footprint(w + 8, 10, 100)
end

R.SetupTVStand = function(b, ctx)
	local T = ctx.TopY(1, 45)
	local body = b.Map(rgb(46, 42, 62))
	local d = 40
	-- pieds + caisson
	for _, side in ipairs({ -1, 1 }) do
		b.Box(side * 44, 0, 0, 4, 6, 30, CARBON_LIGHT, M.Metal)
	end
	local inner = T - 9
	-- (v9.6 z-fighting : flancs plus larges que les plateaux (±50.5), cloisons
	-- posées SUR le plateau bas, fond en retrait : aucune face confondue)
	b.Box(0, 6, 0, 100, 3, d, body, M.Wood)
	b.Box(0, 6.5, -d / 2 + 2.5, 99, inner - 0.5, 2, darken(body, 0.2), M.Wood)
	for _, x in ipairs({ -49, 49 }) do
		b.Box(x, 5.5, 0, 3, inner + 0.5, d - 1, body, M.Wood)
	end
	for _, x in ipairs({ -14.5, 14.5 }) do
		b.Box(x, 9, 0, 3, inner - 3, d - 1, body, M.Wood)
	end
	b.Box(0, T - 3, 0, 100, 3, d + 1, darken(body, 0.25), M.SmoothPlastic)
	-- portes pleines (côtés) + niche ouverte au centre
	for _, side in ipairs({ -1, 1 }) do
		b.Box(side * 31.5, 9, d / 2 - 0.6, 31, inner - 6, 1.2, lighten(body, 0.12), M.Wood)
		b.Box(side * 31.5, 10.5, d / 2 + 0.3, 27, inner - 9, 0.6, lighten(body, 0.2), M.Wood)
		b.Box(side * 17.5, 9 + (inner - 6) / 2 - 3, d / 2 + 0.4, 1, 6, 1, CHROME, M.Metal)
	end
	b.Box(0, 9, 0, 26, 0.6, d - 4, rgb(24, 22, 34), M.SmoothPlastic)
	neon(b, b.Box(0, T - 3.6, d / 2 - 3, 26, 0.5, 0.5, CYAN, M.Neon), "Glow")
	-- console + manettes + boîtiers de DVD dans la niche
	b.Round(0, 9.6, d / 2 - 10, 20, 5, 14, 2, WHITE, M.SmoothPlastic)
	neon(b, b.Box(0, 12, d / 2 - 2.9, 8, 0.6, 0.4, CYAN, M.Neon), "Glow")
	b.EggR(CFrame.new(-6, 10.5, d / 2 - 1) * CFrame.Angles(0, 0.3, 0), 8, 3, 5, rgb(255, 120, 190), M.SmoothPlastic)
	b.Box(0, 9 + inner * 0.5, 0, 26, 0.8, d - 4, rgb(40, 36, 54), M.SmoothPlastic)
	for index = 1, 6 do
		b.Box(-10 + index * 3, 9.8 + inner * 0.5, 2, 2.4, 11, 13, RAINBOW[index], M.SmoothPlastic)
	end
	-- bande lumineuse au pied (arc-en-ciel)
	neon(b, b.Box(0, 6.2, d / 2 + 0.3, 96, 1, 0.6, RAINBOW[1], M.Neon), "RGB")
	b.Top(1, 0, T, 0, 94, 34)
	b.Footprint(100, d, T)
end

----------------------------------------------------------------------
-- 🎧 CHAÎNES HI-FI (lofi)
----------------------------------------------------------------------

-- Boutons lecture / suivant (dessus d'un appareil)
local function transport(b: Builder, x: number, y: number, z: number, scale: number)
	b.Box(x, y, z, 15 * scale, 1, 7 * scale, INK, M.SmoothPlastic)
	local play = b.Box(x - 3.6 * scale, y + 1, z, 6 * scale, 2 * scale, 5 * scale, rgb(90, 220, 140), M.SmoothPlastic)
	play.Name = "PlayButton"
	local nextButton = b.Box(x + 3.6 * scale, y + 1, z, 6 * scale, 2 * scale, 5 * scale, rgb(110, 170, 255), M.SmoothPlastic)
	nextButton.Name = "NextButton"
end

-- Barres de niveau (VU) : `count` barres lumineuses, bas à `y` ; `z` = face
-- sur laquelle on les monte (v9.6 z-fighting : fond z..z+1.4, barres
-- z+1.4..z+2.8 : même dans un petit objet, faces à plus de 0,02 stud)
local function vuBars(b: Builder, x: number, y: number, z: number, w: number, h: number, count: number)
	b.Box(x, y - 1, z + 0.7, w + 2, h + 2, 1.4, INK, M.SmoothPlastic)
	local step = w / count
	for index = 1, count do
		local color = index <= count * 0.6 and MINT or (index <= count * 0.85 and YELLOW or RED)
		local bar = b.Box(x - w / 2 + step * (index - 0.5), y, z + 2.1, step * 0.6, h, 1.4, color, M.Neon)
		neon(b, bar, "VU_" .. index)
	end
end

-- Haut-parleur (face +z) : caisson, membranes qui battent
local function speaker(b: Builder, x: number, y: number, z: number, w: number, h: number, d: number, body: Color3, cones: number)
	b.Round(x, y, z, w, h, d, 1.5, body, M.Wood)
	-- (v9.6 z-fighting : grille, anneau, membrane, cache empilés sans faces
	-- confondues : d/2..+0.8, +0.8..+1.6, +1.6..+2.4, +2.4..+3)
	b.Box(x, y + 1, z + d / 2 + 0.4, w - 3, h - 2, 0.8, rgb(40, 40, 52), M.Fabric)
	for index = 1, cones do
		local cy = y + h * (index - 0.4) / (cones + 0.2)
		local size = math.min(w - 5, h / cones - 2) * (index == cones and 1 or 0.62)
		b.CylZ(x, cy, z + d / 2 + 1.2, size + 1.4, 0.8, CHROME, M.Metal)
		named(b.CylZ(x, cy, z + d / 2 + 2, size, 0.8, rgb(30, 30, 40), M.SmoothPlastic), "SpeakerCone")
		b.CylZ(x, cy, z + d / 2 + 2.7, size * 0.34, 0.6, rgb(70, 70, 86), M.SmoothPlastic)
	end
end

-- Platine : plateau + disque (tourne) + bras
local function turntable(b: Builder, x: number, y: number, z: number, w: number, d: number, plinth: Color3)
	b.Round(x, y, z, w, 5, d, 2, plinth, M.Wood)
	b.Box(x, y + 5, z, w - 2, 0.4, d - 2, rgb(30, 30, 40), M.Metal)
	local cx = x - w * 0.12
	local diameter = math.min(w * 0.7, d - 5)
	b.Cyl(cx, y + 5.2, z, diameter + 1, 1, CHROME, M.Metal)
	pivot(b, "Pivot_Vinyl", cx, y + 6.2, z)
	named(b.Cyl(cx, y + 6.2, z, diameter, 0.6, rgb(20, 20, 26), M.SmoothPlastic), "Vinyl")
	-- (v9.6 z-fighting : étiquette SUR le disque (6.8..7.2), repères au-dessus)
	named(b.Cyl(cx, y + 6.8, z, diameter * 0.36, 0.4, rgb(255, 90, 120), M.SmoothPlastic), "Vinyl")
	-- repère sur l'étiquette (on voit le disque tourner)
	named(b.Box(cx + diameter * 0.1, y + 7.2, z, diameter * 0.12, 0.3, 1.6, CREAM, M.SmoothPlastic), "Vinyl")
	named(b.Box(cx - diameter * 0.32, y + 6.8, z, diameter * 0.1, 0.4, 1.2, rgb(60, 60, 72), M.SmoothPlastic), "Vinyl")
	b.Cyl(cx, y + 6.6, z, 1, 1.4, CHROME, M.Metal)
	-- bras de lecture
	local ax, az = x + w * 0.36, z - d * 0.3
	b.Cyl(ax, y + 5, az, 4, 3, CHROME, M.Metal)
	House3DKit.Path(b, { { ax, y + 8, az }, { ax - 2, y + 8, z + d * 0.1 }, { cx + diameter * 0.3, y + 7.6, z + d * 0.18 } }, 1, CHROME, M.Metal, false, true)
	b.Box(cx + diameter * 0.3, y + 6.8, z + d * 0.18, 2, 1, 3, INK, M.SmoothPlastic)
end

-- Petit écran LCD (morceau en cours) ; `z` = face de montage (v9.6 : cadre
-- z..z+1.4, écran z+1.4..z+1.9)
local function lcd(b: Builder, x: number, y: number, z: number, w: number, h: number)
	b.Box(x, y - 0.8, z + 0.7, w + 1.6, h + 1.6, 1.4, INK, M.SmoothPlastic)
	screenPart(b, CFrame.new(x, y, z + 1.65), w, h, "Music", 1)
end

local function hifi(b: Builder, _ctx: any)
	local setup = setupOf(b)
	local tier = math.clamp(tierOf(setup), 1, 4)
	if tier == 1 then
		-- radio-cassette rétro
		local body = b.Map(rgb(255, 140, 180))
		b.Round(0, 0, 0, 100, 48, 30, 5, body, M.SmoothPlastic)
		-- (v9.6 z-fighting : petit objet (~0,02 stud / unité, épaisseur mini
		-- 0,03) -> façade 15..16.4 puis couches de 1,4 : anneau, tissu, membrane,
		-- cache ; fenêtre, bobines, repères)
		b.Box(0, 4, 15.7, 94, 40, 1.4, darken(body, 0.2), M.SmoothPlastic)
		for _, side in ipairs({ -1, 1 }) do
			b.CylZ(side * 29, 24, 17.1, 36, 1.4, CHROME, M.Metal)
			b.CylZ(side * 29, 24, 18.5, 32, 1.4, rgb(40, 40, 52), M.Fabric)
			named(b.CylZ(side * 29, 24, 19.9, 22, 1.4, rgb(30, 30, 40), M.SmoothPlastic), "SpeakerCone")
			b.CylZ(side * 29, 24, 21.3, 8, 1.4, CHROME, M.Metal)
		end
		-- fenêtre de la cassette + bobines
		b.Box(0, 20, 17.1, 22, 16, 1.4, rgb(60, 50, 80), M.Glass).Transparency = 0.2
		for _, side in ipairs({ -1, 1 }) do
			pivot(b, side == -1 and "Pivot_Spool1" or "Pivot_Spool2", side * 5.5, 28, 18.5)
			named(b.CylZ(side * 5.5, 28, 18.5, 6, 1.4, WHITE, M.SmoothPlastic), side == -1 and "Spool1" or "Spool2")
			named(b.Box(side * 5.5, 28, 19.9, 5.4, 1, 1.4, INK, M.SmoothPlastic), side == -1 and "Spool1" or "Spool2")
		end
		vuBars(b, 0, 8, 16.4, 20, 7, 5)
		lcd(b, 0, 38, 16.4, 24, 6)
		-- poignée
		House3DKit.Path(b, { { -34, 48, 0 }, { -30, 60, 0 }, { 30, 60, 0 }, { 34, 48, 0 } }, 3, CHROME, M.Metal)
		transport(b, -14, 48, 4, 1)
		b.CylZ(38, 52, 0, 1.4, 2, CHROME, M.Metal)
		House3DKit.Path(b, { { 38, 48, 0 }, { 40, 70, -2 } }, 1, CHROME, M.Metal)
		b.Footprint(100, 30, 62)
		return
	end
	if tier == 2 then
		-- mini chaîne CD : lecteur à chargement par le dessus + 2 enceintes
		local body = b.Map(rgb(210, 214, 232))
		b.Round(0, 0, 0, 40, 44, 34, 3, body, M.SmoothPlastic)
		b.Box(0, 44, 0, 38, 0.6, 32, darken(body, 0.2), M.Metal)
		-- CD sous le couvercle transparent
		pivot(b, "Pivot_Vinyl", 0, 44.8, 0)
		named(b.Cyl(0, 44.8, 0, 26, 0.4, rgb(220, 230, 255), M.Glass), "Vinyl")
		named(b.Box(6, 45.2, 0, 8, 0.2, 3, rgb(255, 120, 200), M.Neon), "Vinyl")
		named(b.Box(-7, 45.2, 3, 6, 0.2, 2, rgb(120, 220, 255), M.Neon), "Vinyl")
		local lid = b.Cyl(0, 44.9, 0, 30, 3, rgb(200, 230, 255), M.Glass)
		lid.Transparency = 0.6
		lcd(b, 0, 30, 17, 30, 8)
		vuBars(b, 0, 20, 17, 28, 6, 7)
		b.CylZ(-12, 10, 17.2, 8, 1.6, CHROME, M.Metal)
		transport(b, 6, 8, 17, 1)
		for _, side in ipairs({ -1, 1 }) do
			speaker(b, side * 38, 0, 0, 22, 40, 26, b.Map(WOOD_DARK), 2)
		end
		b.Footprint(100, 34, 50)
		return
	end
	if tier == 3 then
		-- meuble bas en bois + platine vinyle + ampli + enceintes sur pieds
		local wood = b.Map(WOOD)
		b.Box(0, 0, 0, 56, 36, 34, wood, M.Wood)
		b.Box(0, 36, 0, 58, 2, 36, darken(wood, 0.2), M.Wood)
		-- ampli (façade + VU + boutons) dans le meuble
		b.Box(0, 20, 17, 48, 13, 2, rgb(34, 32, 40), M.Metal)
		vuBars(b, -10, 23, 18, 20, 7, 8)
		b.CylZ(12, 26.5, 18.7, 7, 1.4, CHROME, M.Metal)
		transport(b, 14, 21, 17.5, 0.9)
		-- bac à vinyles (pochettes colorées)
		for index = 1, 7 do
			b.Box(-22 + index * 5.5, 3, 12, 1.2, 14, 14, RAINBOW[(index - 1) % #RAINBOW + 1], M.SmoothPlastic)
		end
		turntable(b, 0, 38, -2, 46, 30, darken(wood, 0.1))
		for _, side in ipairs({ -1, 1 }) do
			local x = side * 41
			b.Cyl(x, 0, 0, 12, 1.5, CARBON, M.Metal)
			b.Cyl(x, 1.5, 0, 3, 24, CARBON_LIGHT, M.Metal)
			speaker(b, x, 25, 0, 18, 32, 20, b.Map(WOOD_DARK), 2)
		end
		b.Footprint(100, 36, 57)
		return
	end
	-- palier 4 : mur de studio lofi (enceintes colonnes, console, mur de vinyles, VU)
	local wood = b.Map(rgb(90, 64, 52))
	b.Box(0, 0, -16, 100, 96, 4, rgb(52, 40, 64), M.Wood)
	-- mur de vinyles (pochettes exposées)
	for row = 0, 1 do
		for col = 0, 4 do
			local x = -24 + col * 12
			local y = 62 + row * 16
			b.Box(x, y, -13.6, 11, 11, 0.8, RAINBOW[(row * 5 + col) % #RAINBOW + 1], M.SmoothPlastic)
			b.CylZ(x, y + 5.5, -13, 7, 0.4, rgb(20, 20, 26), M.SmoothPlastic)
			b.CylZ(x, y + 5.5, -12.7, 2.6, 0.3, WHITE, M.SmoothPlastic)
		end
		b.Box(0, 61 + row * 16, -12, 62, 1, 4, darken(wood, 0.1), M.Wood)
	end
	-- enseigne néon "lofi"
	neon(b, b.Round(0, 90, -13.4, 30, 5, 1.2, 2, rgb(255, 120, 210), M.Neon), "RGB")
	-- console (meuble + platine + table de mixage)
	b.Box(0, 0, 0, 62, 34, 28, wood, M.Wood)
	b.Box(0, 34, 0, 64, 2, 30, darken(wood, 0.25), M.Wood)
	neon(b, b.Box(0, 33, 14.4, 62, 1, 0.6, RAINBOW[1], M.Neon), "RGB")
	turntable(b, -14, 36, 0, 30, 24, rgb(40, 38, 50))
	b.Box(14, 36, 0, 20, 4, 22, rgb(40, 38, 50), M.Metal)
	for index = 1, 3 do
		b.Box(8 + index * 3, 40, 2, 1, 1.2, 12, CHROME, M.Metal)
	end
	transport(b, 16, 40, -6, 0.8)
	vuBars(b, 0, 20, 14, 40, 10, 10)
	lcd(b, 0, 46, -14, 26, 8)
	-- enceintes colonnes
	for _, side in ipairs({ -1, 1 }) do
		speaker(b, side * 42, 0, -2, 16, 86, 20, rgb(30, 30, 38), 3)
		neon(b, b.Box(side * 42, 0.4, 8.3, 14, 1, 0.6, RAINBOW[side == -1 and 5 or 2], M.Neon), "RGB")
	end
	b.Footprint(100, 36, 98)
end

R.SetupHiFiBoombox = hifi
R.SetupHiFiCD = hifi
R.SetupHiFiVinyl = hifi
R.SetupHiFiStudio = hifi

----------------------------------------------------------------------
-- 🌀 MOULIN À VENT (jardin / terrasse)
----------------------------------------------------------------------

R.SetupWindmill = function(b, _ctx)
	local stone = rgb(214, 204, 196)
	local body = b.Map(rgb(255, 238, 222))
	local roof = b.Map(rgb(236, 110, 130))
	-- socle de pierre + massif de fleurs
	b.Cyl(0, 0, 0, 58, 6, stone, M.Slate)
	for index = 0, 9 do
		local angle = index / 10 * math.pi * 2
		b.Ball(math.cos(angle) * 27, 7, math.sin(angle) * 27, 6, RAINBOW[index % #RAINBOW + 1], M.SmoothPlastic)
		b.Ball(math.cos(angle + 0.3) * 27, 5, math.sin(angle + 0.3) * 27, 7, LEAF, M.Grass)
	end
	-- tour conique (3 tambours)
	b.Cyl(0, 6, 0, 42, 22, body, M.SmoothPlastic)
	b.Cyl(0, 28, 0, 36, 20, body, M.SmoothPlastic)
	b.Cyl(0, 48, 0, 30, 16, body, M.SmoothPlastic)
	b.Cyl(0, 27, 0, 44, 2, WOOD_DARK, M.Wood)
	-- balcon
	b.Cyl(0, 46, 0, 40, 1.4, WOOD, M.Wood)
	-- porte + fenêtres
	b.Box(0, 6, 20.3, 10, 16, 1.4, WOOD_DARK, M.Wood)
	b.CylZ(0, 22, 20.3, 10, 1.4, WOOD_DARK, M.Wood)
	for _, y in ipairs({ 34, 52 }) do
		b.Box(0, y, 17.6 - (y - 34) * 0.1, 7, 8, 1.2, rgb(150, 200, 255), M.Glass)
		b.Box(0, y + 3.6, 18 - (y - 34) * 0.1, 7, 0.8, 1.4, WHITE, M.Wood)
	end
	-- chapeau (toit)
	b.Cyl(0, 64, 0, 34, 3, roof, M.SmoothPlastic)
	b.Egg(0, 71, 0, 32, 22, 32, roof, M.SmoothPlastic)
	b.Ball(0, 82, 0, 5, GOLD, M.Metal)
	-- moyeu + ailes (tournent autour de Pivot_Blades, face +z)
	local hy, hz = 68, 19
	pivot(b, "Pivot_Blades", 0, hy, hz)
	b.CylZ(0, hy, hz - 3, 5, 6, WOOD_DARK, M.Wood)
	named(b.CylZ(0, hy, hz, 7, 2.4, rgb(120, 80, 60), M.Wood), "Blades")
	local sail = b.Map(rgb(255, 250, 244))
	for index = 0, 3 do
		local angle = index * math.pi / 2 + math.pi / 4
		local base = CFrame.new(0, hy, hz + 1.4) * CFrame.Angles(0, 0, angle)
		-- longeron
		named(b.BoxR(base * CFrame.new(22, 0, 0), 44, 2, 1.2, WOOD_DARK, M.Wood), "Blade")
		-- toile + lattes
		named(b.BoxR(base * CFrame.new(26, 4.2, -0.2), 30, 7, 0.4, sail, M.Fabric), "Blade")
		for slat = 0, 3 do
			named(b.BoxR(base * CFrame.new(13 + slat * 9, 4.2, 0.2), 0.8, 8, 0.6, WOOD, M.Wood), "Blade")
		end
		named(b.BoxR(base * CFrame.new(26, 8, 0.2), 30, 0.8, 0.6, WOOD, M.Wood), "Blade")
	end
	b.Footprint(62, 58, 100)
end

----------------------------------------------------------------------
-- 🗜️ PRESSE HYDRAULIQUE (v9.8 : refaite "comme la presse du clicker")
-- Bâti en H (lit + montants + traverse), vérin hydraulique chromé, coulisseau
-- (bélier) à bandes de danger, enclume striée, deux manomètres, pupitre
-- (gros bouton rouge, voyants, afficheur), tapis roulant qui AMÈNE les objets
-- sous la presse (lamelles qui défilent), bac à galettes, centrale
-- hydraulique + flexibles, gyrophare. Les pièces portent un attribut "Tint"
-- (Frame / FrameDark / AccentA / AccentB / Chrome / Hose / Bolt) : LiveProps
-- les peint aux couleurs du palier de la presse du clicker (niveau
-- "Presse hydraulique" du propriétaire, 10 paliers : bois -> diamant néon).
----------------------------------------------------------------------

-- Paliers de la presse du clicker (Stimuli > Press, TIERS) : couleurs 3D
House3DSetup.PressTiers = {
	{ Name = "Rustic wood", Frame = rgb(186, 128, 74), Dark = rgb(150, 100, 56), AccentA = rgb(226, 196, 138), AccentB = rgb(186, 150, 92), Chrome = rgb(214, 170, 84), Hose = rgb(122, 76, 42), Bolt = rgb(70, 58, 50), Wood = true, Debris = { rgb(186, 128, 74), rgb(226, 196, 138) } },
	{ Name = "Oak & iron", Frame = rgb(140, 90, 50), Dark = rgb(92, 94, 104), AccentA = rgb(92, 94, 104), AccentB = rgb(62, 64, 72), Chrome = rgb(160, 164, 172), Hose = rgb(64, 46, 32), Bolt = rgb(44, 44, 50), Wood = true, Debris = { rgb(140, 90, 50), rgb(120, 122, 130) } },
	{ Name = "Steel", Frame = rgb(160, 168, 182), Dark = rgb(110, 116, 132), AccentA = rgb(255, 200, 30), AccentB = INK, Chrome = rgb(210, 216, 226), Hose = rgb(40, 40, 46), Bolt = rgb(90, 96, 110), Debris = { rgb(200, 205, 215) } },
	{ Name = "Blue steel", Frame = rgb(48, 114, 204), Dark = rgb(36, 80, 150), AccentA = rgb(255, 200, 30), AccentB = INK, Chrome = rgb(214, 220, 230), Hose = rgb(30, 30, 36), Bolt = rgb(220, 226, 236), Debris = { rgb(48, 114, 204), rgb(220, 226, 236) } },
	{ Name = "Industrial", Frame = rgb(244, 140, 30), Dark = rgb(70, 74, 86), AccentA = rgb(255, 214, 40), AccentB = INK, Chrome = rgb(214, 220, 230), Hose = rgb(28, 28, 32), Bolt = rgb(60, 60, 66), Beacon = true, Steam = true, Debris = { rgb(244, 140, 30), rgb(120, 126, 140) } },
	{ Name = "Factory", Frame = rgb(78, 88, 104), Dark = rgb(50, 56, 68), AccentA = rgb(60, 214, 110), AccentB = rgb(26, 30, 36), Chrome = rgb(214, 220, 230), Hose = rgb(20, 20, 24), Bolt = rgb(150, 160, 176), Beacon = true, Steam = true, Debris = { rgb(78, 88, 104), rgb(60, 214, 110) } },
	{ Name = "Solid gold", Frame = rgb(240, 180, 40), Dark = rgb(200, 140, 30), AccentA = rgb(255, 240, 170), AccentB = rgb(214, 150, 20), Chrome = rgb(255, 230, 140), Hose = rgb(120, 72, 20), Bolt = rgb(150, 100, 10), Shine = true, Debris = { rgb(255, 214, 70), rgb(255, 246, 200) } },
	{ Name = "Royal gold", Frame = rgb(246, 190, 50), Dark = rgb(150, 20, 44), AccentA = rgb(196, 24, 56), AccentB = rgb(255, 222, 120), Chrome = rgb(255, 236, 160), Hose = rgb(150, 20, 44), Bolt = rgb(255, 236, 160), Shine = true, Debris = { rgb(255, 214, 70), rgb(196, 24, 56) } },
	{ Name = "Diamond", Frame = rgb(176, 232, 255), Dark = rgb(120, 190, 235), AccentA = WHITE, AccentB = rgb(130, 206, 255), Chrome = rgb(236, 250, 255), Hose = rgb(80, 164, 230), Bolt = rgb(90, 170, 230), Shine = true, Crystal = true, Debris = { rgb(190, 240, 255), WHITE } },
	{ Name = "Neon diamond", Frame = rgb(200, 238, 255), Dark = rgb(40, 24, 80), AccentA = rgb(0, 230, 255), AccentB = rgb(255, 60, 200), Chrome = rgb(236, 250, 255), Hose = rgb(255, 60, 200), Bolt = rgb(0, 230, 255), Beacon = true, Shine = true, Crystal = true, Neon = true, Debris = { rgb(0, 230, 255), rgb(255, 60, 200) } },
}
House3DSetup.PRESS_DEFAULT_TIER = 5 -- (visiteurs : palier "industriel")

local HAZARD_A, HAZARD_B = rgb(255, 204, 36), rgb(34, 34, 40)

-- Bandes de danger en diagonale sur une face (une SurfaceGui, 8 bandes)
local function hazard(part: BasePart, face: Enum.NormalId, faceW: number, faceH: number, stripes: number)
	local canvas = Vector2.new(256, math.max(16, math.floor(256 * faceH / math.max(0.01, faceW) + 0.5)))
	local gui = House3DKit.Surface(part, face, canvas, 1)
	gui.Name = "Hazard"
	local fill = Instance.new("Frame")
	fill.BorderSizePixel = 0
	fill.BackgroundColor3 = WHITE
	fill.Size = UDim2.fromScale(1, 1)
	fill.Parent = gui
	local n = math.clamp(stripes, 2, 10)
	local keypoints = {}
	for i = 1, n do
		local color = i % 2 == 1 and HAZARD_A or HAZARD_B
		table.insert(keypoints, ColorSequenceKeypoint.new((i - 1) / n, color))
		table.insert(keypoints, ColorSequenceKeypoint.new(math.min(1, i / n - 0.002), color))
	end
	keypoints[#keypoints] = ColorSequenceKeypoint.new(1, n % 2 == 1 and HAZARD_A or HAZARD_B)
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new(keypoints)
	gradient.Rotation = 35
	gradient.Parent = fill
end

local function tint(part: BasePart, role: string): BasePart
	part:SetAttribute("Tint", role)
	return part
end

R.SetupPress = function(b, _ctx)
	local tierStyle = House3DSetup.PressTiers[House3DSetup.PRESS_DEFAULT_TIER]
	local frame = b.Map(tierStyle.Frame)
	local dark = tierStyle.Dark
	local chrome = tierStyle.Chrome
	local t = th(b, 1.2)
	local PX, PZ = -10, -4 -- axe de la presse
	local ANVIL = 22 -- dessus de l'enclume
	-- plancher (tôle striée) + bande de danger au bord avant
	b.Box(0, 0, 0, 100, 3, 60, rgb(82, 86, 98), M.DiamondPlate)
	local strip = b.Box(0, 2.4, 26.5, 98, th(b, 1.6), 5, HAZARD_A, M.SmoothPlastic)
	hazard(strip, Enum.NormalId.Top, 98, 5, 10)
	-- lit (bâti bas) + enclume striée
	tint(b.Box(PX, 2.4, PZ, 56, 16, 42, frame, M.Metal), "Frame")
	b.Box(PX, 18, PZ, 34, ANVIL - 18, 28, rgb(120, 126, 142), M.DiamondPlate)
	pivot(b, "Pivot_Anvil", PX, ANVIL, PZ)
	-- presse à 4 colonnes chromées (le tapis passe entre elles) + écrous
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			local x, z = PX + sx * 24, PZ + sz * 15.5
			tint(b.Cyl(x, 17.6, z, 6, 67, chrome, M.Metal), "Chrome")
			tint(b.Cyl(x, 18.4, z, 9, 3, tierStyle.Bolt, M.Metal), "Bolt")
			tint(b.Cyl(x, 80.6, z, 9, 3, tierStyle.Bolt, M.Metal), "Bolt")
		end
	end
	-- traverse + bandeau de danger + manomètres
	tint(b.Box(PX, 83.4, PZ, 60, 16, 40, frame, M.Metal), "Frame")
	local band = b.Box(PX, 87.4, PZ + 20 + t * 0.3, 28, 7, t, HAZARD_A, M.SmoothPlastic)
	hazard(band, Enum.NormalId.Back, 28, 7, 6) -- (face vers +z : "Back" une fois l'objet retourné)
	for index, gx in ipairs({ PX - 21, PX + 21 }) do
		local dz = PZ + 20
		-- (couches à plus de 0,03 stud l'une de l'autre : boîtier, cadran, aiguille)
		b.CylZ(gx, 91.4, dz + t * 0.1, 11, t, INK, M.Metal) -- boîtier (avant à +0,6 t)
		local face = dz + t * 1.4
		named(b.CylZ(gx, 91.4, face - t / 2, 9, t, rgb(250, 248, 240), M.SmoothPlastic), "GaugeDial" .. index)
		-- zone rouge du cadran
		b.BoxR(CFrame.new(gx + 2.4, 93.6, face + th(b, 0.3) / 2 - 0.1) * CFrame.Angles(0, 0, -0.7), 2.6, 0.9, th(b, 0.3), RED, M.SmoothPlastic)
		named(b.BoxR(CFrame.new(gx, 93.4, face + th(b, 0.8)), 0.8, 4.6, th(b, 0.6), RED, M.SmoothPlastic), "Gauge" .. index)
		b.CylZ(gx, 91.4, face + th(b, 1.6), 1.6, th(b, 0.8), INK, M.Metal)
	end
	-- vérin hydraulique (sur la traverse) + gyrophare
	tint(b.Cyl(PX, 99, PZ, 24, 18, dark, M.Metal), "FrameDark")
	tint(b.Cyl(PX, 116.6, PZ, 26, 3, chrome, M.Metal), "Chrome")
	for _, dx in ipairs({ -11, 11 }) do
		tint(b.Cyl(PX + dx, 99, PZ + 9, 2.4, 17.6, chrome, M.Metal), "Chrome") -- tirants
	end
	b.Cyl(PX, 119.4, PZ, 7, 2, CARBON, M.Metal)
	neon(b, b.Egg(PX, 124.6, PZ, 6, 8, 6, ORANGE, M.Neon), "PressBeacon")
	-- coulisseau (descend) : tige chromée longue (reste dans le vérin), bélier, guides
	pivot(b, "Pivot_Ram", PX, 52, PZ)
	tint(named(b.Cyl(PX, 62, PZ, 9, 51, chrome, M.Metal), "PressRam"), "Chrome")
	local ram = named(b.Box(PX, 52, PZ, 44, 10, 23, dark, M.Metal), "PressRam")
	tint(ram, "FrameDark")
	local ramBand = named(b.Box(PX, 53.5, PZ + 11.5 + t * 0.3, 38, 7, t, HAZARD_A, M.SmoothPlastic), "PressRam")
	hazard(ramBand, Enum.NormalId.Back, 38, 7, 8)
	-- pupitre (devant à droite) : gros bouton rouge, voyants, afficheur
	local cx, cz = 43, 21
	b.Box(cx, 3.2, cz, 5, 36, 5, CARBON, M.Metal)
	b.Box(cx, 2.4, cz, 14, th(b, 2), 14, CARBON_LIGHT, M.Metal)
	local head = CFrame.new(cx, 42, cz) * CFrame.Angles(-0.55, 0, 0)
	tint(b.BoxR(head, 24, 7, 16, tierStyle.AccentA, M.Metal), "AccentA")
	local topFace = head * CFrame.new(0, 3.5, 0)
	local button = b.Part("Part", topFace * CFrame.new(-4, 1.2, 1) * CFrame.Angles(0, 0, math.pi / 2), Vector3.new(2.4, 6.4, 6.4), RED, M.SmoothPlastic, "PressButton")
	;(button :: Part).Shape = Enum.PartType.Cylinder
	b.Part("Part", topFace * CFrame.new(-4, 0.1, 1) * CFrame.Angles(0, 0, math.pi / 2), Vector3.new(1.6, 8.4, 8.4), rgb(255, 214, 60), M.SmoothPlastic, "Collar").CastShadow = false
	;(b.Parts[#b.Parts] :: Part).Shape = Enum.PartType.Cylinder
	for index, color in ipairs({ MINT, YELLOW, RED }) do
		neon(b, b.Part("Part", topFace * CFrame.new(3 + index * 2.6, 0.5, -4), Vector3.new(1.8, 1.4, 1.8), color, M.Neon, "Lamp" .. index), nil)
	end
	named(b.Part("Part", topFace * CFrame.new(6, 0.3, 2.6), Vector3.new(10, th(b, 1.2), 5), rgb(10, 22, 16), M.SmoothPlastic, "PressDisplay"), "PressDisplay")
	-- tapis roulant (amène les objets de la droite vers l'enclume)
	local beltX0, beltX1 = PX + 29, 50
	local beltMid, beltLen = (beltX0 + beltX1) / 2, beltX1 - beltX0
	local beltTop = ANVIL
	b.Box(beltMid, beltTop - 2.6, PZ, beltLen, 2.6 - th(b, 0.2, 0.004), 22, rgb(36, 36, 44), M.Rubber)
	for _, side in ipairs({ -1, 1 }) do
		tint(b.Box(beltMid, beltTop - 5, PZ + side * 12.4, beltLen + 4, 7, 2.4, tierStyle.AccentA, M.Metal), "AccentA")
		b.Box(beltX0 + 4, 2.4, PZ + side * 9, 3, beltTop - 8, 3, CARBON, M.Metal)
		b.Box(beltX1 - 3, 2.4, PZ + side * 9, 3, beltTop - 8, 3, CARBON, M.Metal)
	end
	b.CylZ(beltX1, beltTop - 1.6, PZ, 3.4, 24.6, CHROME, M.Metal)
	b.CylZ(beltX0 + 0.5, beltTop - 1.6, PZ, 3.2, 24.6, CHROME, M.Metal)
	for index = 0, 5 do
		local x = beltX0 + 2 + index * (beltLen - 4) / 6
		named(b.Box(x, beltTop - th(b, 1) * 0.6, PZ, 1.8, th(b, 1), 20, rgb(78, 78, 92), M.Rubber), "BeltSlat")
	end
	-- bac à galettes (à gauche) : les objets écrasés y tombent
	local binX = -44
	b.Box(binX, 1.2, PZ, 9, th(b, 1.4) + 1.2, 24.6, CARBON, M.Metal)
	for _, side in ipairs({ -1, 1 }) do
		tint(b.Box(binX, 2.4, PZ + side * 12, 10.6, 14, 2, tierStyle.AccentB, M.Metal), "AccentB")
		tint(b.Box(binX + side * 4.3, 2.4, PZ, 2, 14, 23, tierStyle.AccentB, M.Metal), "AccentB")
	end
	for index, color in ipairs({ YELLOW, RED, rgb(70, 170, 80), rgb(255, 150, 190) }) do
		b.Cyl(binX + (index % 2) * 1.2 - 0.6, 2.2 + th(b, 1.4) + (index - 1) * 1.6, PZ + (index - 2.5) * 3, 7, 1.8, color, M.SmoothPlastic)
	end
	-- centrale hydraulique (au fond à droite) + flexibles jusqu'au vérin
	local ux, uz = 34, -22
	tint(b.Round(ux, 2.4, uz, 22, 20, 14, 3, dark, M.Metal), "FrameDark")
	tint(b.CylX(ux, 27, uz, 10, 16, chrome, M.Metal), "Chrome")
	b.CylX(ux - 9.6, 27, uz, 6, 3, CARBON, M.Metal)
	neon(b, b.Ball(ux + 6, 21, uz + 7.2, 1.6, MINT, M.Neon), "Glow")
	for index, dz in ipairs({ -3, 3 }) do
		local hose = House3DKit.Path(b, { { ux - 6, 23, uz + dz * 0.5 }, { ux - 14, 60, uz + dz }, { PX + 14, 108, PZ + dz * 1.4 } }, 2.4, tierStyle.Hose, M.Rubber, false, true)
		for _, part in ipairs(hose) do
			tint(part, "Hose")
		end
		local _ = index
	end
	-- objets à écraser (un seul visible à la fois ; ils arrivent par le tapis)
	-- (les variantes 2+ sont cachées : elles occupent la même place ; LiveProps
	-- les montre une à une, transparence de base = attribut "BaseTransparency")
	local function crushable(list: { BasePart }, variant: number)
		for _, part in ipairs(list) do
			part.Name = "Crushable"
			part:SetAttribute("Variant", variant)
			part:SetAttribute("BaseTransparency", part.Transparency)
			if variant > 1 then
				part.Transparency = 1
			end
		end
	end
	local y = ANVIL - 0.8 -- (posés dans l'enclume : aucune face collée)
	-- 1 : canard en caoutchouc
	crushable({ b.Egg(PX, y + 8, PZ, 22, 16, 18, YELLOW, M.SmoothPlastic), b.Ball(PX + 1, y + 18, PZ - 3, 12, YELLOW, M.SmoothPlastic),
		b.Egg(PX + 1, y + 17, PZ - 10, 7, 3.4, 7, ORANGE, M.SmoothPlastic), b.Ball(PX - 2.6, y + 20, PZ - 7.4, 2.2, INK, M.SmoothPlastic),
		b.Ball(PX + 4.6, y + 20, PZ - 7.4, 2.2, INK, M.SmoothPlastic) }, 1)
	-- 2 : canette de soda
	crushable({ b.Cyl(PX, y, PZ, 14, 22, RED, M.Metal), b.Cyl(PX, y + 21.6, PZ, 12, 1.6, CHROME, M.Metal), b.Cyl(PX, y + 9, PZ, 14.6, 5, WHITE, M.SmoothPlastic) }, 2)
	-- 3 : pastèque
	crushable({ b.Egg(PX, y + 11, PZ, 26, 21, 20, rgb(70, 170, 80), M.SmoothPlastic), b.Egg(PX, y + 11, PZ, 26.6, 10, 20.6, rgb(40, 120, 60), M.SmoothPlastic) }, 3)
	-- 4 : gâteau (deux étages, glaçage, cerise)
	crushable({ b.Cyl(PX, y, PZ, 22, 8, rgb(255, 170, 200), M.SmoothPlastic), b.Cyl(PX, y + 7.6, PZ, 17, 7, rgb(255, 236, 214), M.SmoothPlastic),
		b.Cyl(PX, y + 14.2, PZ, 17.8, 1.8, WHITE, M.SmoothPlastic), b.Ball(PX, y + 17.2, PZ, 4.6, RED, M.SmoothPlastic) }, 4)
	-- 5 : paquet cadeau
	crushable({ b.Box(PX, y, PZ, 18, 16, 18, rgb(120, 110, 255), M.SmoothPlastic), b.Box(PX, y - 0.3, PZ, 4, 16.8, 18.8, GOLD, M.SmoothPlastic),
		b.Box(PX, y - 0.3, PZ, 18.8, 16.8, 4, GOLD, M.SmoothPlastic), b.Ball(PX - 2.4, y + 17.4, PZ, 4.4, GOLD, M.SmoothPlastic),
		b.Ball(PX + 2.4, y + 17.4, PZ, 4.4, GOLD, M.SmoothPlastic) }, 5)
	-- 6 : cube magique (faces colorées)
	crushable({ b.Box(PX, y, PZ, 16, 16, 16, INK, M.SmoothPlastic), b.Box(PX, y + 1, PZ + 8 + t * 0.2, 14, 14, t, RED, M.SmoothPlastic),
		b.Box(PX, y + 16 - t * 0.6, PZ, 14, t, 14, WHITE, M.SmoothPlastic), b.Box(PX + 8 + t * 0.2, y + 1, PZ, t, 14, 14, rgb(60, 200, 90), M.SmoothPlastic) }, 6)
	b.Footprint(100, 60, 130)
end

----------------------------------------------------------------------
-- 🔘 TABLE À PAPIER BULLE
----------------------------------------------------------------------

R.SetupBubbleWrap = function(b, ctx)
	local T = ctx.TopY(1, 48)
	local wood = b.Map(rgb(240, 214, 190))
	b.Box(0, T - 4, 0, 96, 4, 52, wood, M.Wood)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			b.Box(sx * 42, 0, sz * 20, 5, T - 4, 5, darken(wood, 0.15), M.Wood)
		end
	end
	b.Box(0, T * 0.3, 0, 84, 2, 40, darken(wood, 0.1), M.Wood)
	-- rouleau (dérouleur) au fond
	b.Box(-44, T, -18, 3, 12, 4, CHROME, M.Metal)
	b.Box(44, T, -18, 3, 12, 4, CHROME, M.Metal)
	b.CylX(0, T + 9, -18, 4, 90, CHROME, M.Metal)
	local roll = b.CylX(0, T + 9, -18, 16, 84, rgb(200, 230, 255), M.Glass)
	roll.Transparency = 0.35
	b.CylX(0, T + 9, -18, 12, 86, rgb(230, 244, 255), M.SmoothPlastic).Transparency = 0.55
	-- feuille dépliée + bulles (cliquables)
	local sheet = b.Box(0, T, 6, 84, 0.6, 34, rgb(220, 240, 255), M.SmoothPlastic)
	sheet.Transparency = 0.35
	b.BoxR(CFrame.new(0, T + 4, -9) * CFrame.Angles(0.9, 0, 0), 84, 0.5, 12, rgb(220, 240, 255), M.SmoothPlastic).Transparency = 0.4
	local cols, rows = 9, 4
	local index = 0
	for row = 1, rows do
		for col = 1, cols do
			index += 1
			local x = -40 + (col - 0.5) * (80 / cols) + (row % 2 == 0 and 2 or -2)
			local z = -8 + (row - 0.5) * (30 / rows) + 2
			local bubble = b.Egg(x, T + 2.2, z, 7, 3.6, 6.4, rgb(232, 246, 255), M.SmoothPlastic)
			bubble.Name = "Bubble_" .. index
			bubble.Transparency = 0.05
			bubble.CastShadow = false
		end
	end
	-- petit panneau "POP ME"
	b.Box(40, T, 22, 12, 7, 1, rgb(255, 120, 190), M.SmoothPlastic)
	b.Top(1, 0, T + 1, 6, 80, 30)
	b.Footprint(96, 52, T + 18)
end

----------------------------------------------------------------------
-- 🎥 COIN LIVE (anneau lumineux, caméra, écran du stream)
----------------------------------------------------------------------

R.SetupLiveStudio = function(b, _ctx)
	-- petit bureau + écran du live (à gauche)
	local desk = b.Map(rgb(250, 236, 246))
	b.Box(-24, 38, -4, 48, 3, 30, desk, M.Wood)
	for _, sx in ipairs({ -46, -2 }) do
		b.Box(sx, 0, -4, 3, 38, 26, darken(desk, 0.1), M.Wood)
	end
	monitor(b, CFrame.new(-24, 50, -12), 36, 22, "Live", 1, rgb(30, 30, 40), true, 7.6)
	-- micro sur bras
	b.Cyl(-44, 41, -14, 4, 2, CARBON, M.Metal)
	House3DKit.Path(b, { { -44, 43, -14 }, { -44, 62, -12 }, { -34, 60, 4 } }, 1.2, CARBON_LIGHT, M.Metal, false, true)
	b.Egg(-34, 58, 5, 5, 8, 5, rgb(60, 60, 70), M.Metal)
	-- anneau lumineux sur trépied (à droite)
	local rx, ry, rz = 28, 62, 6
	for _, angle in ipairs({ 0, 2.1, 4.2 }) do
		b.Tube(rx, 30, rz, rx + math.cos(angle) * 12, 0, rz + math.sin(angle) * 12, 1.6, CARBON, M.Metal)
	end
	b.Cyl(rx, 30, rz, 2, ry - 30, CHROME, M.Metal)
	local segments = 14
	local radius = 15
	for index = 0, segments - 1 do
		local angle = index / segments * math.pi * 2
		local part = b.BoxR(CFrame.new(rx + math.cos(angle) * radius, ry + math.sin(angle) * radius, rz) * CFrame.Angles(0, 0, angle), 2.6, 7.2, 2.4, rgb(255, 246, 236), M.Neon)
		neon(b, part, "RingLight")
	end
	-- téléphone / caméra au centre + voyant REC
	b.Box(rx, ry - 8, rz + 0.6, 9, 16, 1.4, rgb(30, 30, 40), M.SmoothPlastic)
	b.CylZ(rx, ry + 3, rz + 1.6, 3, 1, rgb(80, 120, 200), M.Glass)
	neon(b, b.Ball(rx + 3, ry + 6, rz + 1.6, 1.6, RED, M.Neon), "RecLight")
	-- enseigne ON AIR (au fond)
	b.Box(-6, 41, -16, 2, 30, 2, CARBON_LIGHT, M.Metal)
	b.Box(-6, 70, -16, 20, 8, 3, rgb(40, 14, 24), M.SmoothPlastic)
	neon(b, b.Round(-6, 71, -14.4, 17, 6, 0.6, 1.5, RED, M.Neon), "OnAir")
	-- tabouret
	b.Cyl(0, 0, 16, 16, 1.5, CARBON, M.Metal)
	b.Cyl(0, 1.5, 16, 3, 20, CHROME, M.Metal)
	b.Cyl(0, 21, 16, 18, 4, rgb(255, 120, 190), M.Leather)
	b.Footprint(100, 44, 88)
end

----------------------------------------------------------------------
-- 🌼 POTS DE FLEURS DU JARDIN (GardenBuilder.BuildFlower si présent)
----------------------------------------------------------------------

local FLOWER_COLORS: { [string]: { Color3 } } = {
	Daisy = { WHITE, YELLOW },
	Tulip = { rgb(255, 90, 130), rgb(255, 170, 190) },
	Rose = { rgb(214, 36, 70), rgb(150, 20, 50) },
	Sunflower = { rgb(255, 200, 40), rgb(120, 70, 30) },
	Lotus = { rgb(255, 200, 230), GOLD },
}

-- Module du jardin 3D (GARDEN3D95) : chargé une fois, jamais bloquant
local gardenModule: any = nil
local gardenTried = false
local function gardenBuilder(): any
	if gardenTried then
		return gardenModule
	end
	gardenTried = true
	local ok, result = pcall(function()
		local client = ReplicatedStorage:FindFirstChild("Client")
		local world = client and client:FindFirstChild("World")
		local module = world and world:FindFirstChild("GardenBuilder")
		if module and module:IsA("ModuleScript") then
			return require(module) :: any
		end
		return nil
	end)
	if ok and type(result) == "table" and type(result.BuildFlower) == "function" then
		gardenModule = result
	end
	return gardenModule
end

-- Fleur "maison" (repli) : une tige, des feuilles, une corolle ; y = base
local function simpleFlower(b: Builder, flower: string, x: number, y: number, z: number, height: number, lean: number)
	local colors = FLOWER_COLORS[flower] or FLOWER_COLORS.Daisy
	local petal, heart = colors[1], colors[2]
	local top = Vector3.new(x + lean, y + height, z)
	local parts = {}
	table.insert(parts, b.Tube(x, y, z, top.X, top.Y, top.Z, 2, LEAF_DARK, M.SmoothPlastic))
	table.insert(parts, b.EggR(CFrame.new(x + 3, y + height * 0.35, z) * CFrame.Angles(0, 0, -0.7), 9, 3.5, 4, LEAF, M.SmoothPlastic))
	table.insert(parts, b.EggR(CFrame.new(x - 3, y + height * 0.55, z) * CFrame.Angles(0, 0, 0.7), 8, 3, 4, LEAF, M.SmoothPlastic))
	if flower == "Tulip" then
		table.insert(parts, b.Egg(top.X, top.Y + 3, top.Z, 9, 12, 9, petal, M.SmoothPlastic))
		for index = 0, 2 do
			local angle = index / 3 * math.pi * 2
			table.insert(parts, b.EggR(CFrame.new(top.X + math.cos(angle) * 3, top.Y + 5, top.Z + math.sin(angle) * 3) * CFrame.Angles(math.sin(angle) * 0.3, 0, -math.cos(angle) * 0.3), 5, 12, 5, heart, M.SmoothPlastic))
		end
	elseif flower == "Rose" then
		table.insert(parts, b.Ball(top.X, top.Y + 3, top.Z, 10, petal, M.SmoothPlastic))
		table.insert(parts, b.Egg(top.X, top.Y + 6, top.Z, 7, 5, 7, heart, M.SmoothPlastic))
		for index = 0, 4 do
			local angle = index / 5 * math.pi * 2
			table.insert(parts, b.EggR(CFrame.new(top.X + math.cos(angle) * 4, top.Y + 2.5, top.Z + math.sin(angle) * 4) * CFrame.Angles(0, -angle, 0.5), 7, 3, 6, petal, M.SmoothPlastic))
		end
	elseif flower == "Sunflower" then
		local head = CFrame.new(top.X, top.Y + 6, top.Z + 1) * CFrame.Angles(-0.25, 0, 0)
		for index = 0, 11 do
			local angle = index / 12 * math.pi * 2
			table.insert(parts, b.EggR(head * CFrame.Angles(0, 0, angle) * CFrame.new(0, 9, 0), 5, 10, 1.6, petal, M.SmoothPlastic))
		end
		table.insert(parts, b.EggR(head * CFrame.new(0, 0, 0.6), 12, 12, 3, heart, M.SmoothPlastic))
	elseif flower == "Lotus" then
		for ring = 1, 2 do
			for index = 0, 5 do
				local angle = index / 6 * math.pi * 2 + ring * 0.5
				local r = ring == 1 and 6 or 3
				table.insert(parts, b.EggR(CFrame.new(top.X + math.cos(angle) * r, top.Y + 3 + ring * 1.5, top.Z + math.sin(angle) * r) * CFrame.Angles(0, -angle, ring == 1 and 0.9 or 0.5), 9, 3, 5, ring == 1 and petal or lighten(petal, 0.4), M.SmoothPlastic))
			end
		end
		local core = b.Ball(top.X, top.Y + 5, top.Z, 5, heart, M.Neon)
		b.Neon(core)
		table.insert(parts, core)
	else
		for index = 0, 9 do
			local angle = index / 10 * math.pi * 2
			table.insert(parts, b.EggR(CFrame.new(top.X + math.cos(angle) * 5, top.Y + 2, top.Z + math.sin(angle) * 5) * CFrame.Angles(0, -angle, 0), 8, 1.6, 3.4, petal, M.SmoothPlastic))
		end
		table.insert(parts, b.Ball(top.X, top.Y + 2.4, top.Z, 5, heart, M.SmoothPlastic))
	end
	for _, part in ipairs(parts) do
		part.Name = "Flower"
		part.CastShadow = false
	end
end

-- Fleur du jardin 3D (GARDEN3D95) mise à l'échelle et versée dans le modèle
local function gardenFlower(b: Builder, flower: string, y: number, height: number, x: number?, z: number?, lean: number?): boolean
	local module = gardenBuilder()
	if not module then
		return false
	end
	local ok, model = pcall(module.BuildFlower, flower, "Bloom")
	if not ok or typeof(model) ~= "Instance" or not model:IsA("Model") then
		return false
	end
	local okMove = pcall(function()
		local source = model:GetPivot()
		local natural = tonumber(model:GetAttribute("TopHeight")) or 3
		local scale = (height * b.K) / math.max(0.2, natural)
		local parent = b.Parts[1] and b.Parts[1].Parent
		local originCF = (b.Parts[1] and (b.Parts[1].CFrame * b.Locals[1]:Inverse())) or CFrame.new()
		local base = originCF * CFrame.new((x or 0) * b.K, y * b.K, (z or 0) * b.K) * CFrame.Angles(0, (x or 0) * 0.07, -(lean or 0))
		for _, part in ipairs(model:GetDescendants()) do
			-- (v9.6 z-fighting : le pot du lotus a déjà son eau et ses nénuphars ;
			-- la mare du jardin se superposait exactement à eux)
			local skip = flower == "Lotus" and (part.Name == "Water" or part.Name == "WaterRim" or part.Name == "Pad")
			if part:IsA("BasePart") and part.Name ~= "Root" and not skip then
				local rel = source:ToObjectSpace(part.CFrame)
				part.Size = part.Size * scale
				part.CFrame = base * CFrame.new(rel.Position * scale) * rel.Rotation
				part.Name = "Flower"
				part.Anchored = true
				part.CanCollide = false
				part.CanTouch = false
				part.CastShadow = false
				part.Parent = parent
				table.insert(b.Parts, part)
				table.insert(b.Locals, originCF:ToObjectSpace(part.CFrame))
			end
		end
	end)
	pcall(function()
		model:Destroy()
	end)
	return okMove
end

R.SetupPlant = function(b, _ctx)
	local setup = setupOf(b)
	local flower = tostring(setup.Flower or "Daisy")
	local tier = tierOf(setup)
	local potColor, rim = rgb(214, 120, 84), rgb(236, 150, 110)
	if flower == "Tulip" then
		potColor, rim = b.Map(rgb(255, 190, 214)), WHITE
	elseif flower == "Rose" then
		potColor, rim = WHITE, GOLD
	elseif flower == "Sunflower" then
		potColor, rim = b.Map(WOOD), WOOD_DARK
	elseif flower == "Lotus" then
		potColor, rim = GOLD, rgb(255, 230, 150)
	end
	local soil = 30
	if flower == "Lotus" then
		-- vasque dorée + eau + nénuphar
		b.Cyl(0, 0, 0, 44, 4, darken(potColor, 0.2), M.Metal)
		b.Cyl(0, 4, 0, 70, 16, potColor, M.Metal)
		-- (v9.6 z-fighting : liseré sous le bord (18..19.4), eau puis nénuphars
		-- empilés à 1 d'écart ; la fleur du jardin n'apporte plus sa propre mare)
		b.Cyl(0, 17, 0, 74, 1.4, rim, M.Metal)
		local water = b.Cyl(0, 20, 0, 66, 1, rgb(90, 190, 230), M.SmoothPlastic)
		water.Transparency = 0.1
		b.Cyl(14, 21, 8, 20, 1, LEAF, M.SmoothPlastic)
		b.Cyl(-16, 21, -6, 16, 1, LEAF_DARK, M.SmoothPlastic)
		soil = 21
	elseif flower == "Sunflower" then
		-- jardinière en bois
		b.Box(0, 0, 0, 50, 30, 40, potColor, M.Wood)
		for index = 0, 3 do
			b.Box(0, 2 + index * 7, 20.2, 50, 0.6, 0.5, rim, M.Wood)
		end
		b.Box(0, 29, 0, 46, 2, 36, rgb(110, 76, 56), M.Grass)
		soil = 30
	else
		b.Cyl(0, 0, 0, 34, 4, darken(potColor, 0.15), M.SmoothPlastic)
		b.Cyl(0, 4, 0, 40, 22, potColor, M.SmoothPlastic)
		b.Cyl(0, 24, 0, 46, 6, rim, M.SmoothPlastic)
		b.Cyl(0, 29.4, 0, 40, 2, rgb(110, 76, 56), M.Grass) -- (v9.6 : dessus 1.4 au-dessus du pot)
		if tier >= 3 then
			-- motif en cœur sur le pot
			House3DKit.Heart(b, 0, 14, 20.2, 10, 0.6, PINK, M.SmoothPlastic)
		end
		soil = 30
	end
	pivot(b, "Pivot_Flower", 0, soil, 0)
	local height = 100 - soil - 16
	-- fleurs du jardin 3D : un bouquet (3 marguerites / tulipes, 2 roses)
	local count = (flower == "Daisy" or flower == "Tulip") and 3 or (flower == "Rose" and 2 or 1)
	local okGarden = true
	for index = 1, count do
		local offset = count > 1 and (index - (count + 1) / 2) * 11 or 0
		local tall = flower == "Lotus" and 26 or (height - math.abs(offset) * 0.9)
		if not gardenFlower(b, flower, soil, tall, offset, (index % 2) * 5 - 2, offset * 0.02) then
			okGarden = false
			break
		end
	end
	if not okGarden then
		if flower == "Sunflower" then
			simpleFlower(b, flower, 0, soil, 0, height - 6, 0)
		elseif flower == "Lotus" then
			simpleFlower(b, flower, 0, soil, 0, 1, 0)
		else
			local tufts = flower == "Rose" and 2 or 3
			for index = 1, tufts do
				local offset = (index - (tufts + 1) / 2) * 9
				simpleFlower(b, flower, offset, soil, (index % 2) * 4 - 2, height - 10 - math.abs(offset) * 0.6, offset * 0.4)
			end
		end
	end
	if flower == "Lotus" then
		-- étincelles dorées
		for index = 0, 4 do
			local angle = index / 5 * math.pi * 2
			local spark = b.Ball(math.cos(angle) * 22, 30 + (index % 2) * 10, math.sin(angle) * 22, 2, rgb(255, 236, 150), M.Neon)
			neon(b, spark, "Sparkle")
		end
	end
	b.Footprint(flower == "Lotus" and 74 or 50, flower == "Lotus" and 74 or 44, 100)
end

----------------------------------------------------------------------
-- Branchement (House3DRecipes.loadFamilies("House3DSetup"))
----------------------------------------------------------------------

-- Recette d'un objet Setup (d'après son Kind)
local BY_KIND: { [string]: (b: Builder, ctx: any) -> () } = {
	Desk = desk,
	Keyboard = R.SetupKeyboard,
	Mouse = R.SetupMouse,
	TV = tvRecipe,
	TVStand = R.SetupTVStand,
	NewsTV = R.SetupNewsTV,
	HiFi = hifi,
	Windmill = R.SetupWindmill,
	Press = R.SetupPress,
	BubbleWrap = R.SetupBubbleWrap,
	LiveStudio = R.SetupLiveStudio,
	Plant = R.SetupPlant,
}

function House3DSetup.Has(itemId: string): boolean
	local kind = House3DSetup.KindOf(itemId)
	return kind ~= nil and BY_KIND[kind] ~= nil
end

-- Liste des recettes { [itemId] = recette } pour tous les objets Setup de Config
function House3DSetup.Recipes(): { [string]: (b: Builder, ctx: any) -> () }
	local list = {}
	for id, recipe in pairs(R) do
		if id ~= "SetupPlant" then
			list[id] = recipe
		end
	end
	for flower in pairs(FLOWER_COLORS) do
		list["SetupPlant" .. flower] = R.SetupPlant
	end
	for id, item in pairs(HouseCommon.ItemsById) do
		if type(item) == "table" and (item.Category == "Setup" or type(item.Setup) == "table") then
			local kind = House3DSetup.KindOf(id)
			local recipe = kind and BY_KIND[kind]
			if recipe then
				list[id] = recipe
			end
		end
	end
	return list
end

function House3DSetup.Register(recipes: { [string]: any }, _family: { [string]: any }, _helpers: any, _flags: any)
	for id, recipe in pairs(House3DSetup.Recipes()) do
		recipes[id] = recipe
	end
end

return House3DSetup
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">House3DTime</string>
              <string name="Source"><![CDATA[--[[
	House3DTime (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > House3DTime

	v9.9 🕰️📅 SCALE99 : les objets "de l'heure" de la maison sont VRAIS.
	  - Horloges (réveil, coucou, horloge chat, pendule, horloge comtoise) :
	    aiguilles en 3D qui montrent l'heure LOCALE du joueur (os.date),
	    trotteuse qui avance d'un cran par seconde, minutes et heures qui
	    glissent. Une aiguille est construite droite (vers 12 h) par la
	    recette ; on la tourne autour de l'axe du cadran (son axe Z local =
	    la normale du cadran, vers celui qui regarde) : ça marche aussi
	    quand le modèle est déplacé (mode édition, chaise tirée...), en
	    miroir (entry.F) et dans la vue 3D de l'interface.
	  - Calendrier mural : page du mois en cours (photo du mois, nom du mois
	    en français, année, grille des jours qui commence le lundi, jour
	    d'aujourd'hui entouré en rouge, jours passés estompés, dimanches en
	    rouge) ; la page se redessine toute seule à minuit.
	Un seul Heartbeat pour tout (branché seulement s'il y a des horloges ou
	des calendriers vivants, débranché sinon) ; au plus une mise à jour par
	seconde ; les aiguilles loin de la caméra (> 90 studs) attendent.
	Aucune lumière, aucun son.

	API :
	  House3DTime.Hand(b, kind, cx, cy, z, length, tail, width, thick, color, material?) -> BasePart
	      kind = "H" (heures) | "M" (minutes) | "S" (trotteuse) ; unités de la
	      recette ; (cx, cy) = axe, z = arrière de l'aiguille, `length` = de
	      l'axe à la pointe, `tail` = queue derrière l'axe
	  House3DTime.CalendarPage(part, face, canvas?) -> SurfaceGui
	  House3DTime.Angles(date?) -> (heure, minute, seconde) en radians (sens horaire)
	  House3DTime.Month(year, month) -> { Days, First (1 = lundi .. 7 = dimanche) }
	  House3DTime.MONTHS (noms français)
]]

local RunService = game:GetService("RunService")

local House3DTime = {}

House3DTime.MONTHS = {
	"janvier", "février", "mars", "avril", "mai", "juin",
	"juillet", "août", "septembre", "octobre", "novembre", "décembre",
}
local WEEKDAYS = { "L", "M", "M", "J", "V", "S", "D" }
local WEEKDAY_NAMES = { "lundi", "mardi", "mercredi", "jeudi", "vendredi", "samedi", "dimanche" }

local rgb = Color3.fromRGB
local TAU = math.pi * 2
local FAR = 90 -- (studs) au-delà : les aiguilles attendent que l'on s'approche

----------------------------------------------------------------------
-- Date
----------------------------------------------------------------------

type Date = { year: number, month: number, day: number, hour: number, min: number, sec: number }

local function now(): Date
	local ok, t = pcall(function()
		return os.date("*t")
	end)
	if ok and type(t) == "table" and tonumber(t.year) then
		return {
			year = tonumber(t.year) or 2026,
			month = tonumber(t.month) or 1,
			day = tonumber(t.day) or 1,
			hour = tonumber(t.hour) or 12,
			min = tonumber(t.min) or 0,
			sec = tonumber(t.sec) or 0,
		}
	end
	return { year = 2026, month = 1, day = 1, hour = 12, min = 0, sec = 0 }
end

local function leap(year: number): boolean
	return (year % 4 == 0 and year % 100 ~= 0) or year % 400 == 0
end

-- Jour de la semaine (Sakamoto) : 1 = lundi .. 7 = dimanche (arithmétique
-- pure : ne dépend ni de os.time ni du fuseau)
local function weekday(year: number, month: number, day: number): number
	local offsets = { 0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4 }
	local y = month < 3 and year - 1 or year
	local w = (y + y // 4 - y // 100 + y // 400 + offsets[month] + day) % 7 -- 0 = dimanche
	return w == 0 and 7 or w
end

function House3DTime.Month(year: number, month: number): { Days: number, First: number }
	local days = ({ 31, leap(year) and 29 or 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 })[month] or 30
	return { Days = days, First = weekday(year, month, 1) }
end

-- Angles des aiguilles (radians, sens horaire depuis 12 h)
function House3DTime.Angles(date: Date?): (number, number, number)
	local d = date or now()
	local s = d.sec
	local m = d.min + s / 60
	local h = (d.hour % 12) + m / 60
	return h / 12 * TAU, m / 60 * TAU, s / 60 * TAU
end

----------------------------------------------------------------------
-- Registre (aiguilles, calendriers) et battement unique
----------------------------------------------------------------------

type HandState = { Kind: string, R: number, A: number }
type PageState = { Gui: SurfaceGui, Key: string }

local hands: { [BasePart]: HandState } = setmetatable({}, { __mode = "k" }) :: any
local pages: { [SurfaceGui]: PageState } = setmetatable({}, { __mode = "k" }) :: any
local connection: RBXScriptConnection? = nil
local lastSecond = -1
local lastPageCheck = 0
local drawPage: (gui: SurfaceGui, date: Date) -> ()

-- Pose une aiguille à l'angle `a` (autour de son axe Z local, sens horaire vu de devant)
local function pose(part: BasePart, state: HandState, a: number)
	if math.abs(a - state.A) < 1e-4 then
		return
	end
	local axis = part.CFrame * CFrame.new(0, -state.R, 0) * CFrame.Angles(0, 0, state.A)
	part.CFrame = axis * CFrame.Angles(0, 0, -a) * CFrame.new(0, state.R, 0)
	state.A = a
end

local function angleOf(kind: string, h: number, m: number, s: number): number
	if kind == "S" then
		return s
	elseif kind == "M" then
		return m
	end
	return h
end

local function step()
	local date = now()
	if date.sec == lastSecond then
		return
	end
	lastSecond = date.sec
	local h, m, s = House3DTime.Angles(date)
	local camera = workspace.CurrentCamera
	local eye = camera and camera.CFrame.Position
	local alive = false
	for part, state in pairs(hands) do
		if part.Parent == nil then
			hands[part] = nil
		else
			alive = true
			-- (dans le monde : seulement près de la caméra ; vue 3D : toujours)
			local near = true
			if eye and part:IsDescendantOf(workspace) then
				near = (part.Position - eye).Magnitude <= FAR
			end
			if near then
				pose(part, state, angleOf(state.Kind, h, m, s))
			end
		end
	end
	-- calendriers : le jour a-t-il changé ? (toutes les 5 s suffisent)
	local clock = os.clock()
	if clock - lastPageCheck >= 5 then
		lastPageCheck = clock
		local key = string.format("%d-%d-%d", date.year, date.month, date.day)
		for gui, state in pairs(pages) do
			if gui.Parent == nil then
				pages[gui] = nil
			else
				alive = true
				if state.Key ~= key then
					state.Key = key
					pcall(drawPage, gui, date)
				end
			end
		end
	elseif next(pages) ~= nil then
		alive = true
	end
	if not alive and connection then
		connection:Disconnect()
		connection = nil
	end
end

local function ensureRunning()
	if connection or not RunService:IsClient() then
		return
	end
	local acc = 1
	connection = RunService.Heartbeat:Connect(function(dt: number)
		-- (5 fois par seconde suffit : la trotteuse avance d'un cran par seconde)
		acc += dt
		if acc < 0.2 then
			return
		end
		acc = 0
		local ok, err = pcall(step)
		if not ok then
			warn("[House3DTime] " .. tostring(err))
			if connection then
				connection:Disconnect()
				connection = nil
			end
		end
	end)
end

----------------------------------------------------------------------
-- Aiguilles
----------------------------------------------------------------------

function House3DTime.Hand(b: any, kind: string, cx: number, cy: number, z: number, length: number, tail: number, width: number, thick: number, color: Color3, material: Enum.Material?): BasePart
	local total = length + tail
	local part: BasePart = b.BoxR(CFrame.new(cx, cy + (length - tail) / 2, z + thick / 2), width, total, thick, color, material or Enum.Material.SmoothPlastic)
	part.Name = kind == "S" and "SecondHand" or (kind == "M" and "MinuteHand" or "HourHand")
	part.CastShadow = false
	-- distance (studs) de l'axe au centre de la pièce, le long de son axe Y
	local r = part.Size.Y * ((length - tail) / 2) / math.max(0.01, total)
	local state: HandState = { Kind = kind, R = r, A = 0 }
	hands[part] = state
	local h, m, s = House3DTime.Angles()
	pose(part, state, angleOf(kind, h, m, s))
	ensureRunning()
	return part
end

----------------------------------------------------------------------
-- Calendrier : photo du mois + grille
----------------------------------------------------------------------

type Theme = { Sky0: Color3, Sky1: Color3, Far: Color3, Near: Color3, Accent: Color3, Motif: string, Sun: Color3? }

-- Une "photo" par mois (saisons de l'hémisphère nord)
local THEMES: { Theme } = {
	{ Sky0 = rgb(150, 190, 230), Sky1 = rgb(225, 238, 250), Far = rgb(236, 242, 250), Near = rgb(250, 252, 255), Accent = rgb(70, 120, 190), Motif = "Snow", Sun = rgb(255, 250, 230) },
	{ Sky0 = rgb(120, 150, 200), Sky1 = rgb(240, 214, 222), Far = rgb(214, 224, 240), Near = rgb(246, 248, 252), Accent = rgb(120, 110, 190), Motif = "Cabin" },
	{ Sky0 = rgb(120, 190, 240), Sky1 = rgb(220, 240, 250), Far = rgb(140, 196, 120), Near = rgb(110, 176, 90), Accent = rgb(60, 160, 90), Motif = "Daffodils", Sun = rgb(255, 236, 150) },
	{ Sky0 = rgb(130, 196, 245), Sky1 = rgb(250, 230, 240), Far = rgb(150, 200, 130), Near = rgb(120, 186, 100), Accent = rgb(230, 110, 150), Motif = "Blossom", Sun = rgb(255, 240, 180) },
	{ Sky0 = rgb(110, 180, 240), Sky1 = rgb(210, 236, 252), Far = rgb(120, 180, 100), Near = rgb(96, 160, 80), Accent = rgb(220, 70, 90), Motif = "Tulips", Sun = rgb(255, 238, 160) },
	{ Sky0 = rgb(100, 170, 235), Sky1 = rgb(250, 226, 200), Far = rgb(160, 150, 200), Near = rgb(120, 100, 170), Accent = rgb(130, 90, 190), Motif = "Lavender", Sun = rgb(255, 226, 140) },
	{ Sky0 = rgb(60, 160, 230), Sky1 = rgb(190, 230, 250), Far = rgb(40, 150, 200), Near = rgb(246, 222, 170), Accent = rgb(20, 140, 190), Motif = "Beach", Sun = rgb(255, 230, 120) },
	{ Sky0 = rgb(120, 90, 170), Sky1 = rgb(255, 170, 110), Far = rgb(60, 110, 170), Near = rgb(236, 196, 150), Accent = rgb(230, 110, 70), Motif = "Sunset", Sun = rgb(255, 200, 110) },
	{ Sky0 = rgb(120, 180, 230), Sky1 = rgb(250, 236, 200), Far = rgb(170, 170, 90), Near = rgb(226, 190, 90), Accent = rgb(200, 140, 50), Motif = "Harvest", Sun = rgb(255, 222, 140) },
	{ Sky0 = rgb(130, 170, 220), Sky1 = rgb(250, 220, 180), Far = rgb(200, 120, 60), Near = rgb(150, 110, 60), Accent = rgb(210, 100, 40), Motif = "Autumn", Sun = rgb(255, 214, 140) },
	{ Sky0 = rgb(150, 160, 180), Sky1 = rgb(220, 222, 226), Far = rgb(120, 136, 150), Near = rgb(96, 120, 130), Accent = rgb(90, 110, 140), Motif = "Mist" },
	{ Sky0 = rgb(20, 30, 70), Sky1 = rgb(60, 70, 130), Far = rgb(220, 230, 245), Near = rgb(245, 248, 255), Accent = rgb(190, 40, 50), Motif = "Christmas", Sun = rgb(250, 246, 220) },
}

local function frame(parent: Instance, x: number, y: number, w: number, h: number, color: Color3, round: number?, z: number?): Frame
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.Position = UDim2.fromOffset(x, y)
	f.Size = UDim2.fromOffset(w, h)
	f.BackgroundColor3 = color
	f.ZIndex = z or 1
	if round then
		local corner = Instance.new("UICorner")
		corner.CornerRadius = round >= 1 and UDim.new(1, 0) or UDim.new(0, math.floor(round * 100 + 0.5))
		corner.Parent = f
	end
	f.Parent = parent
	return f
end

local function circle(parent: Instance, cx: number, cy: number, d: number, color: Color3, z: number?): Frame
	return frame(parent, cx - d / 2, cy - d / 2, d, d, color, 1, z)
end

local function label(parent: Instance, x: number, y: number, w: number, h: number, text: string, size: number, color: Color3, font: Enum.Font?, z: number?): TextLabel
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Position = UDim2.fromOffset(x, y)
	t.Size = UDim2.fromOffset(w, h)
	t.Text = text
	t.TextSize = size
	t.TextColor3 = color
	t.Font = font or Enum.Font.GothamBold
	t.ZIndex = z or 3
	t.Parent = parent
	return t
end

local function gradient(target: GuiObject, top: Color3, bottom: Color3)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(top, bottom)
	g.Rotation = 90
	g.Parent = target
end

-- Petit arbre "boule" (tronc + feuillage)
local function tree(parent: Instance, x: number, base: number, h: number, leaf: Color3, z: number)
	frame(parent, x - h * 0.05, base - h * 0.45, h * 0.1, h * 0.45, rgb(110, 80, 60), nil, z)
	circle(parent, x, base - h * 0.62, h * 0.62, leaf, z + 1)
	circle(parent, x - h * 0.16, base - h * 0.5, h * 0.4, leaf:Lerp(Color3.new(0, 0, 0), 0.08), z + 1)
end

-- Sapin (3 étages de losanges aplatis)
local function pine(parent: Instance, x: number, base: number, h: number, color: Color3, z: number)
	frame(parent, x - h * 0.05, base - h * 0.18, h * 0.1, h * 0.18, rgb(100, 70, 50), nil, z)
	for index = 0, 2 do
		local s = h * (0.44 - index * 0.11)
		local cy = base - h * (0.32 + index * 0.22)
		local f = frame(parent, x - s / 2, cy - s / 2, s, s, color:Lerp(Color3.new(1, 1, 1), index * 0.05), nil, z + 1)
		f.Rotation = 45
	end
end

-- Photo du mois dans `holder` (w x h px)
local function paintPhoto(holder: Frame, month: number, w: number, h: number)
	local theme = THEMES[month] or THEMES[1]
	local sky = frame(holder, 0, 0, w, h, Color3.new(1, 1, 1), nil, 1)
	gradient(sky, theme.Sky0, theme.Sky1)
	local horizon = h * 0.62
	if theme.Sun then
		circle(holder, w * 0.74, h * 0.26, h * 0.2, theme.Sun, 2)
		local halo = circle(holder, w * 0.74, h * 0.26, h * 0.34, theme.Sun, 2)
		halo.BackgroundTransparency = 0.75
	end
	local motif = theme.Motif
	if motif == "Christmas" then
		for index = 1, 18 do
			local sx = (index * 53) % w
			local sy = (index * 29) % math.floor(horizon * 0.8)
			circle(holder, sx, sy + 4, 2 + index % 2, rgb(255, 250, 220), 2)
		end
	end
	-- collines lointaines puis sol proche (grands disques coupés par le cadre)
	circle(holder, w * 0.2, horizon + h * 0.5, w * 1.1, theme.Far, 3)
	circle(holder, w * 0.85, horizon + h * 0.56, w * 1.0, theme.Far:Lerp(Color3.new(0, 0, 0), 0.06), 3)
	if motif == "Beach" or motif == "Sunset" then
		-- mer, vaguelettes, plage
		local sea = frame(holder, 0, horizon - 4, w, h * 0.22, theme.Far, nil, 4)
		gradient(sea, theme.Far, theme.Far:Lerp(Color3.new(1, 1, 1), 0.25))
		for index = 0, 5 do
			frame(holder, 12 + index * (w / 6), horizon + 6 + (index % 2) * 8, w / 10, 2, rgb(255, 255, 255), 1, 5).BackgroundTransparency = 0.3
		end
		circle(holder, w * 0.5, h + w * 0.7, w * 2.0, theme.Near, 5)
		if motif == "Beach" then
			-- parasol rayé + serviette
			frame(holder, w * 0.3, h * 0.66, 3, h * 0.24, rgb(240, 240, 240), nil, 6)
			local top = frame(holder, w * 0.3 - 30, h * 0.62, 62, 18, theme.Accent, 1, 7)
			top.Size = UDim2.fromOffset(62, 20)
			frame(holder, w * 0.55, h * 0.86, 40, 12, rgb(250, 110, 120), 0.2, 6)
		else
			-- reflet du soleil couchant
			frame(holder, w * 0.74 - 16, horizon + 2, 32, 3, theme.Sun or rgb(255, 200, 110), 1, 6)
			frame(holder, w * 0.74 - 10, horizon + 10, 20, 3, theme.Sun or rgb(255, 200, 110), 1, 6)
		end
		return
	end
	circle(holder, w * 0.5, horizon + w * 0.95, w * 2.1, theme.Near, 4)
	if motif == "Snow" or motif == "Christmas" or motif == "Cabin" then
		for index = 0, 4 do
			pine(holder, 18 + index * (w / 5) + (index % 2) * 8, horizon + 14 + (index % 3) * 6, 36 + (index % 2) * 12, rgb(40, 90, 70), 5)
		end
		if motif == "Cabin" then
			local cabin = frame(holder, w * 0.56, horizon - 6, 50, 30, rgb(150, 90, 60), nil, 6)
			frame(cabin, 18, 12, 12, 18, rgb(90, 50, 40), nil, 7)
			frame(cabin, 4, 6, 10, 9, rgb(255, 220, 140), nil, 7)
			local roof = frame(holder, w * 0.56 - 4, horizon - 16, 58, 12, rgb(250, 250, 255), 0.3, 7)
			roof.Size = UDim2.fromOffset(58, 12)
		elseif motif == "Christmas" then
			pine(holder, w * 0.6, horizon + 26, 70, rgb(30, 110, 70), 6)
			for index = 0, 5 do
				circle(holder, w * 0.6 - 18 + (index * 13) % 36, horizon - 10 + index * 5, 6, index % 2 == 0 and theme.Accent or rgb(255, 214, 90), 9)
			end
			circle(holder, w * 0.6, horizon - 20, 9, rgb(255, 220, 90), 9)
		end
		-- flocons
		for index = 1, 22 do
			circle(holder, (index * 37) % w, (index * 23) % math.floor(h * 0.95), 2 + index % 3, rgb(255, 255, 255), 8).BackgroundTransparency = 0.15
		end
	elseif motif == "Blossom" then
		frame(holder, w * 0.34, horizon - 52, 8, 70, rgb(110, 70, 60), nil, 5)
		for index = 0, 9 do
			local a = index / 10 * TAU
			circle(holder, w * 0.35 + math.cos(a) * 36, horizon - 58 + math.sin(a) * 22, 34, index % 2 == 0 and rgb(255, 190, 214) or rgb(250, 160, 196), 6)
		end
		for index = 1, 14 do
			circle(holder, (index * 41) % w, horizon + 10 + (index * 13) % 40, 4, rgb(255, 200, 220), 7)
		end
		tree(holder, w * 0.8, horizon + 8, 40, rgb(110, 170, 90), 5)
	elseif motif == "Daffodils" or motif == "Tulips" or motif == "Lavender" or motif == "Harvest" then
		-- rangées de fleurs / de blé qui fuient vers l'horizon
		for row = 0, 4 do
			local y = horizon + 8 + row * 12
			local count = 8 + row * 3
			for index = 0, count - 1 do
				local x = (index + 0.5) * w / count + (row % 2) * 4
				local d = 3 + row * 1.6
				local color = theme.Accent
				if motif == "Daffodils" then
					color = index % 3 == 0 and rgb(255, 255, 240) or rgb(255, 214, 60)
				elseif motif == "Tulips" then
					color = ({ rgb(230, 60, 80), rgb(255, 150, 190), rgb(255, 200, 70) })[(row % 3) + 1]
				elseif motif == "Harvest" then
					color = rgb(240, 200, 100):Lerp(rgb(200, 150, 60), (index % 3) / 3)
				end
				circle(holder, x, y, d, color, 6)
			end
		end
		if motif == "Harvest" then
			tree(holder, w * 0.18, horizon + 4, 44, rgb(150, 150, 60), 5)
		else
			tree(holder, w * 0.86, horizon + 4, 40, theme.Far:Lerp(Color3.new(0, 0, 0), 0.2), 5)
		end
	elseif motif == "Autumn" then
		for index = 0, 5 do
			local leaf = ({ rgb(220, 110, 40), rgb(240, 170, 50), rgb(190, 60, 40) })[(index % 3) + 1]
			tree(holder, 20 + index * (w / 6), horizon + 12 + (index % 2) * 8, 46 + (index % 3) * 8, leaf, 5)
		end
		for index = 1, 16 do
			circle(holder, (index * 43) % w, horizon + 24 + (index * 11) % 30, 4, rgb(230, 130, 50), 8)
		end
	elseif motif == "Mist" then
		-- lac brumeux, arbres nus
		local lake = frame(holder, 0, horizon + 4, w, h * 0.2, rgb(150, 170, 186), nil, 5)
		gradient(lake, rgb(170, 186, 200), rgb(120, 140, 160))
		for index = 0, 3 do
			local x = 20 + index * 70
			frame(holder, x, horizon - 40, 4, 48, rgb(80, 80, 90), nil, 6)
			local branch = frame(holder, x - 8, horizon - 32, 20, 2, rgb(80, 80, 90), nil, 6)
			branch.Rotation = -30
		end
		local fog = frame(holder, 0, horizon - 20, w, 30, rgb(235, 238, 242), nil, 7)
		fog.BackgroundTransparency = 0.45
	end
end

-- Dessine la page du mois de `date` dans la toile (canvas 300 x 420 px)
drawPage = function(gui: SurfaceGui, date: Date)
	for _, child in ipairs(gui:GetChildren()) do
		child:Destroy()
	end
	local W, H = gui.CanvasSize.X, gui.CanvasSize.Y
	local theme = THEMES[date.month] or THEMES[1]
	local paper = frame(gui, 0, 0, W, H, rgb(252, 251, 247), nil, 1)
	paper.Name = "Page"
	-- trous de la reliure
	for index = 0, 13 do
		circle(paper, 18 + index * (W - 36) / 13, 9, 7, rgb(70, 66, 64), 2)
	end
	-- photo (moitié haute) avec un fin liseré blanc
	local photoH = math.floor(H * 0.44)
	local holder = frame(paper, 10, 20, W - 20, photoH, rgb(255, 255, 255), nil, 2)
	holder.ClipsDescendants = true
	pcall(paintPhoto, holder, date.month, W - 20, photoH)
	-- bandeau : mois + année
	local bandY = 20 + photoH + 6
	local band = frame(paper, 10, bandY, W - 20, 34, theme.Accent, 0.06, 2)
	label(band, 12, 0, W - 110, 34, string.upper(House3DTime.MONTHS[date.month] or ""), 22, rgb(255, 255, 255), Enum.Font.GothamBlack, 3).TextXAlignment = Enum.TextXAlignment.Left
	label(band, W - 100, 0, 76, 34, tostring(date.year), 20, rgb(255, 255, 255), Enum.Font.GothamBold, 3).TextXAlignment = Enum.TextXAlignment.Right
	-- jours de la semaine
	local gridX, cellW = 12, (W - 24) / 7
	local headY = bandY + 40
	for index, name in ipairs(WEEKDAYS) do
		label(paper, gridX + (index - 1) * cellW, headY, cellW, 16, name, 13, index == 7 and rgb(200, 50, 60) or rgb(110, 104, 110), Enum.Font.GothamBold, 3)
	end
	frame(paper, 12, headY + 18, W - 24, 1, rgb(210, 204, 200), nil, 2)
	-- grille (6 semaines au plus)
	local info = House3DTime.Month(date.year, date.month)
	local rows = math.ceil((info.First - 1 + info.Days) / 7)
	local gridY = headY + 22
	local cellH = math.min(26, (H - gridY - 22) / rows)
	for day = 1, info.Days do
		local slot = info.First - 1 + day - 1
		local col = slot % 7
		local row = slot // 7
		local x = gridX + col * cellW
		local y = gridY + row * cellH
		local sunday = col == 6
		local past = day < date.day
		local color = sunday and rgb(200, 50, 60) or rgb(50, 46, 52)
		local t = label(paper, x, y, cellW, cellH, tostring(day), 15, color, day == date.day and Enum.Font.GothamBlack or Enum.Font.Gotham, 4)
		if past then
			t.TextTransparency = 0.55
		end
		if day == date.day then
			-- AUJOURD'HUI : entouré au feutre rouge
			local ring = circle(paper, x + cellW / 2, y + cellH / 2, math.min(cellW, cellH) + 4, rgb(255, 255, 255), 3)
			ring.BackgroundTransparency = 1
			local stroke = Instance.new("UIStroke")
			stroke.Color = rgb(220, 40, 50)
			stroke.Thickness = 3
			stroke.Parent = ring
		end
	end
	-- pied de page : la date complète
	local wd = weekday(date.year, date.month, date.day)
	label(paper, 12, H - 22, W - 24, 18, string.format("Aujourd'hui : %s %d %s", WEEKDAY_NAMES[wd], date.day, House3DTime.MONTHS[date.month] or ""), 12, rgb(150, 140, 150), Enum.Font.GothamMedium, 3)
end

-- Toile du calendrier sur la face `face` de `part` (page redessinée à minuit)
function House3DTime.CalendarPage(part: BasePart, face: Enum.NormalId, canvas: Vector2?): SurfaceGui
	local gui = Instance.new("SurfaceGui")
	gui.Name = "CalendarPage"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.CanvasSize = canvas or Vector2.new(300, 420)
	gui.LightInfluence = 0.6
	gui.Brightness = 1
	gui.AlwaysOnTop = false
	gui.MaxDistance = 160
	gui.ClipsDescendants = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = part
	local date = now()
	local ok, err = pcall(drawPage, gui, date)
	if not ok then
		warn("[House3DTime] Calendrier : " .. tostring(err))
	end
	pages[gui] = { Gui = gui, Key = string.format("%d-%d-%d", date.year, date.month, date.day) }
	ensureRunning()
	return gui
end

return House3DTime
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">House3DToys</string>
              <string name="Source"><![CDATA[--[[
	House3DToys (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > House3DToys

	(v9.3) Recettes 3D des jouets, de l'électronique, de la cuisine
	gourmande, du coin gamer, du sport, de l'aventure, des accessoires des
	animaux et des tapis à forme : de vraies petites maquettes (blocs arrondis,
	ovales, tubes, pentes ; écrans et voyants en Neon) aux couleurs du dessin
	2D de chaque objet.

	Repère : House3DKit.Builder (boîte 2D = 100 unités ; y = hauteur depuis
	le sol ; +z = devant ; objets muraux : z = 0 = le mur). Branché par
	House3DRecipes (Register).
]]

local House3DKit = require(script.Parent.House3DKit)
-- (v9.9 SCALE99) aiguilles à l'heure réelle
local House3DTime = require(script.Parent.House3DTime)

type Builder = House3DKit.Builder

local House3DToys = {}

local M = Enum.Material
local rgb = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)
local INK = rgb(60, 44, 66)
local CARBON = rgb(44, 42, 56)
local GOLD = rgb(245, 190, 60)
local CHROME = rgb(214, 218, 230)
local GLASS = rgb(200, 235, 255)
local SCREEN = rgb(120, 200, 255)
local NEON_PINK = rgb(255, 80, 200)
local NEON_CYAN = rgb(80, 230, 255)
local darken = House3DKit.Darken
local lighten = House3DKit.Lighten

local R: { [string]: (b: Builder, ctx: any) -> () } = {}
local H: any = nil

local function vivid(b: Builder, n: number, fallback: Color3): Color3
	local count = 0
	for _, color in ipairs(b.Pal) do
		local _h, s, v = color:ToHSV()
		if s > 0.2 and v > 0.35 then
			count += 1
			if count == n then
				return color
			end
		end
	end
	return b.Map(fallback)
end

local function screen(b: Builder, x: number, y: number, z: number, w: number, h: number, color: Color3?): BasePart
	local panel = b.Box(x, y, z, w, h, 0.8, color or SCREEN, M.Neon)
	panel.CastShadow = false
	table.insert(b.Glows, panel)
	return panel
end

local function wheel(b: Builder, x: number, y: number, z: number, diameter: number, width: number, rim: Color3?)
	b.CylZ(x, y, z, diameter, width, CARBON, M.Rubber)
	b.CylZ(x, y, z, diameter * 0.55, width + 0.4, rim or CHROME, M.Metal)
end

----------------------------------------------------------------------
-- JOUETS
----------------------------------------------------------------------

R.YoYo = function(b, _ctx)
	-- (v9.9 SCALE99) vrai yo-yo : deux moitiés bombées (bord arrondi, flasque
	-- intérieure, capuchon central transparent + étoile), axe métallique
	-- dans l'entrefer, ficelle enroulée, brin qui monte et boucle pour le doigt
	local color = vivid(b, 1, rgb(255, 110, 150))
	local g = House3DKit.Gap(b, 0.6)
	local cy = 36
	for _, side in ipairs({ -1, 1 }) do
		b.CylZ(0, cy, side * 9, 64, 11, color, M.SmoothPlastic)
		-- bord arrondi (anneau un peu plus large, plus sombre) et flasque bombée
		b.CylZ(0, cy, side * 9, 70, 6, darken(color, 0.12), M.SmoothPlastic)
		b.EggR(CFrame.new(0, cy, side * 14.5), 56, 56, 6, lighten(color, 0.08), M.SmoothPlastic)
		-- capuchon central transparent et son étoile
		local cap = b.CylZ(0, cy, side * (17.5 + g), 26, 2, rgb(236, 246, 255), M.Glass)
		cap.Transparency = 0.35
		House3DKit.Star(b, 0, cy, side > 0 and 17 + 2 * g or -(18 + 2 * g), 9, 1, WHITE, M.SmoothPlastic)
	end
	-- entrefer : axe + ficelle enroulée
	b.CylZ(0, cy, 0, 10, 8, CHROME, M.Metal)
	b.CylZ(0, cy, 0, 24, 5, rgb(250, 248, 240), M.Fabric)
	-- brin : part du bas de la bobine, monte, boucle du doigt en haut
	local path = { { 11, cy, 0 }, { 14, cy + 20, 0 }, { 12, cy + 40, 0 }, { 8, cy + 54, 0 } }
	for index = 0, 8 do
		local a = index / 8 * math.pi * 2
		table.insert(path, { 8 + math.sin(a) * 5, cy + 60 - math.cos(a) * 6, math.cos(a) * 1.5 })
	end
	House3DKit.Path(b, path, 1.4, rgb(250, 248, 240), M.Fabric)
	b.Footprint(70, 30, 80)
end

R.PuzzlePieces = function(b, _ctx)
	local colors = { vivid(b, 1, rgb(255, 120, 150)), vivid(b, 2, rgb(120, 190, 255)), vivid(b, 3, rgb(255, 210, 80)), vivid(b, 4, rgb(140, 220, 140)) }
	local spots = { { -20, 0, -12, 0.1 }, { 18, 0, -8, -0.3 }, { -6, 0, 16, 0.5 }, { 22, 6, 16, 0.2 } }
	for index, p in ipairs(spots) do
		local color = colors[index]
		local cf = CFrame.new(p[1], p[2] + 3, p[3]) * CFrame.Angles(0, p[4], p[2] > 0 and 0.3 or 0)
		b.BoxR(cf, 30, 6, 30, color, M.SmoothPlastic)
		b.Part("Part", cf * CFrame.new(15, 0, 0) * CFrame.Angles(0, 0, math.pi / 2), Vector3.new(6, 12, 12), color, M.SmoothPlastic, "Tenon");
		((b.Parts[#b.Parts]) :: Part).Shape = Enum.PartType.Cylinder
		b.Part("Part", cf * CFrame.new(0, 0, 15) * CFrame.Angles(0, 0, math.pi / 2), Vector3.new(6, 12, 12), color, M.SmoothPlastic, "Tenon");
		((b.Parts[#b.Parts]) :: Part).Shape = Enum.PartType.Cylinder
	end
	b.Footprint(80, 70, 20)
end

R.MagicWand = function(b, _ctx)
	local color = vivid(b, 1, rgb(255, 150, 210))
	b.Round(0, 0, 0, 60, 8, 30, 6, rgb(250, 240, 250), M.SmoothPlastic)
	b.Tube(-22, 12, 0, 20, 60, 0, 5, color, M.SmoothPlastic)
	for index = 0, 3 do
		local t = index / 4
		b.Ball(-22 + t * 42, 12 + t * 48, 0, 6, index % 2 == 0 and WHITE or GOLD, M.SmoothPlastic)
	end
	local before = #b.Parts
	House3DKit.Star(b, 24, 70, -4, 20, 8, rgb(255, 226, 110), M.Neon)
	b.Light(b.Parts[before + 1], rgb(255, 230, 150), 8, 0.6)
	for index = 0, 4 do
		local a = index * 1.3
		b.Ball(24 + math.cos(a) * 22, 70 + math.sin(a) * 18, 0, 3, index % 2 == 0 and NEON_CYAN or rgb(255, 170, 230), M.Neon)
	end
	b.Footprint(70, 30, 92)
end

-- Guitares
local function guitar(electric: boolean)
	return function(b: Builder, _ctx: any)
		local body = vivid(b, 1, electric and rgb(240, 60, 60) or rgb(255, 140, 190))
		local stand = rgb(60, 60, 70)
		b.Tube(-14, 0, -10, 0, 34, -8, 3, stand, M.Metal)
		b.Tube(14, 0, -10, 0, 34, -8, 3, stand, M.Metal)
		b.Tube(0, 0, 10, 0, 34, -8, 3, stand, M.Metal)
		local tilt = CFrame.Angles(-0.2, 0, 0)
		local base = CFrame.new(0, 30, 0) * tilt
		if electric then
			b.EggR(base, 44, 40, 10, body, M.SmoothPlastic)
			b.EggR(base * CFrame.new(-8, 18, 0) * CFrame.Angles(0, 0, 0.5), 18, 26, 10, body, M.SmoothPlastic)
			b.EggR(base * CFrame.new(8, 18, 0) * CFrame.Angles(0, 0, -0.3), 14, 22, 10, body, M.SmoothPlastic)
			-- flammes
			for index = 0, 2 do
				b.EggR(base * CFrame.new(-10 + index * 10, -8, 5.2) * CFrame.Angles(0, 0, 0.3), 8, 18, 1, index % 2 == 0 and rgb(255, 200, 60) or rgb(255, 130, 50), M.SmoothPlastic)
			end
			b.BoxR(base * CFrame.new(0, 2, 5.5), 22, 5, 1, CARBON)
			b.BoxR(base * CFrame.new(0, -10, 5.5), 20, 4, 1, CHROME, M.Metal)
		else
			b.EggR(base, 46, 36, 12, body, M.SmoothPlastic)
			b.EggR(base * CFrame.new(0, 24, 0), 34, 26, 12, body, M.SmoothPlastic)
			b.Part("Part", base * CFrame.new(0, 10, 6.2) * CFrame.Angles(0, math.pi / 2, 0), Vector3.new(1, 12, 12), CARBON, M.SmoothPlastic, "Rosace");
			((b.Parts[#b.Parts]) :: Part).Shape = Enum.PartType.Cylinder
			b.BoxR(base * CFrame.new(0, -6, 6.2), 16, 3, 1.5, darken(body, 0.35), M.Wood)
		end
		b.BoxR(base * CFrame.new(0, 58, 0), 6, 50, 4, rgb(150, 100, 70), M.Wood)
		b.BoxR(base * CFrame.new(0, 88, 0), 9, 14, 4, CARBON, M.Wood)
		-- clés d'accordage
		for index = 0, 2 do
			for _, side in ipairs({ -1, 1 }) do
				local p = (base * CFrame.new(side * 5.5, 84 + index * 4, 0)).Position
				b.CylX(p.X, p.Y, p.Z, 2, 3, CHROME, M.Metal)
			end
		end
		-- cordes
		for index = -1, 1 do
			local a = (base * CFrame.new(index * 1.4, -8, 6.4)).Position
			local c = (base * CFrame.new(index * 1.4, 84, 2.2)).Position
			b.Tube(a.X, a.Y, a.Z, c.X, c.Y, c.Z, 0.4, rgb(250, 250, 240), M.Metal)
		end
		b.Footprint(50, 36, 100)
	end
end
R.PinkGuitar = guitar(false)
R.ElectricGuitar = guitar(true)

-- Chevaux (à bascule / de manège)
local function horse(b: Builder, base: CFrame, body: Color3, mane: Color3, saddle: Color3)
	b.EggR(base * CFrame.new(0, 0, 0), 46, 26, 22, body, M.SmoothPlastic)
	b.EggR(base * CFrame.new(24, 14, 0) * CFrame.Angles(0, 0, -0.9), 14, 28, 14, body, M.SmoothPlastic)
	b.EggR(base * CFrame.new(34, 26, 0) * CFrame.Angles(0, 0, -0.35), 24, 14, 14, body, M.SmoothPlastic)
	for _, side in ipairs({ -1, 1 }) do
		local eye = (base * CFrame.new(34, 30, side * 6.5)).Position
		b.Ball(eye.X, eye.Y, eye.Z, 3.5, INK, M.SmoothPlastic)
		local ear = base * CFrame.new(28, 36, side * 4)
		b.Part("WedgePart", ear, Vector3.new(3, 8, 5), body, M.SmoothPlastic, "Oreille")
	end
	for index = 0, 4 do
		local p = base * CFrame.new(18 - index * 2, 30 - index * 5, 0)
		b.EggR(p, 8, 10, 8, mane, M.Fabric)
	end
	b.EggR(base * CFrame.new(-26, 4, 0) * CFrame.Angles(0, 0, 0.8), 8, 24, 8, mane, M.Fabric)
	b.EggR(base * CFrame.new(-2, 12, 0), 20, 6, 24, saddle, M.Leather)
end

R.RockingHorse = function(b, _ctx)
	local body = vivid(b, 1, rgb(255, 250, 250))
	local mane = vivid(b, 2, rgb(255, 150, 200))
	local wood = H.woodOf(b, rgb(214, 164, 120))
	-- bascules courbes
	for _, z in ipairs({ -12, 12 }) do
		local points = {}
		for index = 0, 8 do
			local t = (index / 8 - 0.5) * 1.6
			table.insert(points, { math.sin(t) * 48, 10 - math.cos(t) * 10 + 4, z })
		end
		House3DKit.Path(b, points, 5, wood, M.Wood)
	end
	for _, x in ipairs({ -16, 16 }) do
		for _, z in ipairs({ -12, 12 }) do
			b.Tube(x, 4, z, x * 0.8, 40, z * 0.5, 4, body, M.SmoothPlastic)
		end
	end
	horse(b, CFrame.new(0, 48, 0), body, mane, vivid(b, 3, rgb(120, 190, 255)))
	b.Tube(18, 64, -12, 18, 64, 12, 2.5, GOLD, M.Metal)
	b.Seat(-2, 56, 0, 24, 20)
	b.Footprint(100, 34, 88)
end

R.CarouselHorse = function(b, _ctx)
	local body = vivid(b, 1, rgb(255, 250, 250))
	local mane = vivid(b, 2, rgb(255, 170, 210))
	b.Cyl(0, 0, 0, 60, 8, vivid(b, 3, rgb(120, 190, 255)), M.SmoothPlastic)
	b.Cyl(0, 8, 0, 50, 3, GOLD, M.Metal)
	b.Tube(0, 10, 0, 0, 100, 0, 4, GOLD, M.Metal)
	for index = 0, 8 do
		b.Ball(0, 16 + index * 10, 0, 5.5, index % 2 == 0 and GOLD or WHITE, M.Metal)
	end
	horse(b, CFrame.new(0, 54, 0) * CFrame.Angles(0, 0, 0.15), body, mane, rgb(255, 120, 160))
	for _, x in ipairs({ -14, 14 }) do
		b.Tube(x, 44, 6, x - 4, 30, 8, 4, body, M.SmoothPlastic)
		b.Tube(x, 44, -6, x + 4, 32, -8, 4, body, M.SmoothPlastic)
	end
	b.Footprint(64, 60, 100)
end

R.ToyTrain = function(b, _ctx)
	local colors = { vivid(b, 1, rgb(255, 110, 130)), vivid(b, 2, rgb(120, 190, 255)), vivid(b, 3, rgb(255, 210, 80)) }
	-- rails
	for _, z in ipairs({ -8, 8 }) do
		b.Box(0, 0, z, 100, 2, 2, CHROME, M.Metal)
	end
	for index = 0, 9 do
		b.Box(-45 + index * 10, 0, 0, 4, 1.5, 22, rgb(170, 120, 80), M.Wood)
	end
	-- locomotive
	b.Round(20, 8, 0, 34, 16, 20, 3, colors[1], M.SmoothPlastic)
	b.CylX(24, 32, 0, 18, 26, colors[1], M.SmoothPlastic)
	b.Box(10, 24, 0, 14, 22, 20, colors[1], M.SmoothPlastic)
	b.Box(10, 46, 0, 18, 3, 22, INK)
	screen(b, 10, 34, 10.1, 8, 7, rgb(255, 240, 180))
	b.Cyl(30, 40, 0, 7, 12, CARBON, M.Metal)
	b.Cyl(30, 52, 0, 10, 3, CARBON, M.Metal)
	b.Ball(38, 32, 0, 6, GOLD, M.Metal)
	b.Ball(30, 60, 0, 8, WHITE, M.SmoothPlastic)
	b.Ball(36, 66, 0, 6, WHITE, M.SmoothPlastic)
	-- wagons
	for index = 1, 2 do
		local x = 20 - index * 30
		b.Round(x, 8, 0, 26, 16, 20, 3, colors[index + 1], M.SmoothPlastic)
		b.Box(x, 24, 0, 22, 4, 16, lighten(colors[index + 1], 0.3), M.SmoothPlastic)
		for _, dx in ipairs({ -6, 6 }) do
			b.Ball(x + dx, 30, (dx > 0) and 3 or -2, 8, colors[(index + 1) % 3 + 1], M.SmoothPlastic)
		end
		for _, dx in ipairs({ -8, 8 }) do
			for _, z in ipairs({ -10, 10 }) do
				b.CylZ(x + dx, 7, z, 10, 2, GOLD, M.Metal)
			end
		end
	end
	for _, dx in ipairs({ 12, 28 }) do
		for _, z in ipairs({ -10, 10 }) do
			wheel(b, dx, 8, z, 12, 2, GOLD)
		end
	end
	b.Footprint(100, 26, 70)
end

R.BlanketFort = function(b, _ctx)
	local blanket = vivid(b, 1, rgb(255, 170, 200))
	local second = vivid(b, 2, rgb(170, 200, 255))
	local wood = rgb(214, 164, 120)
	-- deux chaises + un drap tendu
	for _, x in ipairs({ -40, 40 }) do
		b.Box(x, 0, -14, 4, 60, 4, wood, M.Wood)
		b.Box(x, 0, 14, 4, 60, 4, wood, M.Wood)
	end
	b.Tube(-42, 60, 0, 42, 60, 0, 3, wood, M.Wood)
	for _, side in ipairs({ -1, 1 }) do
		b.BoxR(CFrame.new(0, 34, side * 20) * CFrame.Angles(side * 0.55, 0, 0), 92, 60, 2, side < 0 and blanket or second, M.Fabric)
	end
	b.Box(0, 0, 2, 50, 3, 40, lighten(second, 0.3), M.Fabric)
	b.Cushion(-14, 3, 6, 18, 10, 14, rgb(255, 230, 150))
	-- guirlande lumineuse
	for index = 0, 6 do
		b.Ball(-36 + index * 12, 58 - (index % 2) * 3, 3, 4, index % 2 == 0 and rgb(255, 230, 120) or rgb(255, 150, 200), M.Neon)
	end
	b.Light(b.Parts[#b.Parts], rgb(255, 220, 160), 10, 0.6)
	b.Footprint(96, 60, 70)
end

R.DollCastle = function(b, _ctx)
	local wall = rgb(255, 240, 246)
	local roof = vivid(b, 1, rgb(255, 130, 180))
	local accent = vivid(b, 2, rgb(170, 150, 255))
	b.Box(0, 0, 0, 60, 50, 40, wall, M.SmoothPlastic)
	for index = 0, 4 do
		b.Box(-24 + index * 12, 50, 18, 6, 6, 4, wall, M.SmoothPlastic)
	end
	for _, x in ipairs({ -36, 36 }) do
		b.Cyl(x, 0, 0, 24, 66, wall, M.SmoothPlastic)
		for index = 0, 3 do
			b.Cyl(x, 66 + index * 6, 0, 28 - index * 7, 6.2, roof, M.SmoothPlastic)
		end
		b.Tube(x, 90, 0, x, 100, 0, 1, GOLD, M.Metal)
		House3DKit.Triangle(b, x + 4, 97, 0, 5, 8, -math.pi / 2, 1, accent, M.Fabric)
		b.Box(x, 36, 11.5, 8, 12, 1, rgb(160, 210, 255), M.Glass)
	end
	-- tour centrale
	b.Box(0, 50, 0, 26, 24, 26, wall, M.SmoothPlastic)
	for index = 0, 3 do
		b.Cyl(0, 74 + index * 6, 0, 34 - index * 8, 6.2, accent, M.SmoothPlastic)
	end
	House3DKit.Heart(b, 0, 62, 13, 12, 1, roof, M.SmoothPlastic)
	-- porte en arc + fenêtres
	b.Box(0, 0, 19.5, 16, 20, 1.5, rgb(200, 140, 110), M.Wood)
	b.CylZ(0, 20, 19.5, 16, 1.5, rgb(200, 140, 110), M.Wood)
	for _, x in ipairs({ -18, 18 }) do
		b.Box(x, 28, 20.2, 8, 10, 1, rgb(160, 210, 255), M.Glass)
	end
	b.Footprint(88, 40, 100)
end

R.FerrisWheel = function(b, _ctx)
	local frame = vivid(b, 1, rgb(255, 130, 180))
	local colors = { rgb(255, 214, 90), rgb(120, 200, 255), rgb(150, 220, 140), rgb(255, 150, 200), rgb(190, 150, 255), rgb(255, 170, 110) }
	b.Round(0, 0, 0, 70, 6, 34, 5, rgb(250, 244, 250), M.SmoothPlastic)
	for _, z in ipairs({ -8, 8 }) do
		b.Tube(-26, 6, z, 0, 54, z, 3, CHROME, M.Metal)
		b.Tube(26, 6, z, 0, 54, z, 3, CHROME, M.Metal)
	end
	b.CylZ(0, 54, 0, 8, 20, GOLD, M.Metal)
	local points = {}
	for index = 0, 12 do
		local a = index / 12 * math.pi * 2
		table.insert(points, { math.cos(a) * 40, 54 + math.sin(a) * 40, 0 })
	end
	House3DKit.Path(b, points, 3, frame, M.SmoothPlastic, false, true)
	for index = 0, 5 do
		local a = index / 6 * math.pi * 2
		local x, y = math.cos(a) * 40, 54 + math.sin(a) * 40
		b.Tube(0, 54, 0, x, y, 0, 1.5, WHITE, M.Metal)
		-- nacelle (toujours à l'endroit)
		b.Tube(x, y, 0, x, y - 6, 0, 1, CHROME, M.Metal)
		b.Box(x, y - 16, 0, 12, 10, 10, colors[index + 1], M.SmoothPlastic)
		b.Box(x, y - 6, 0, 13, 1.5, 11, lighten(colors[index + 1], 0.3), M.SmoothPlastic)
		local bulb = b.Ball(x, y, 0, 4, rgb(255, 240, 180), M.Neon)
		bulb.CastShadow = false
	end
	b.Light(b.Parts[#b.Parts], rgb(255, 230, 170), 10, 0.6)
	b.Footprint(90, 34, 100)
end

R.Xylophone = function(b, _ctx)
	local colors = { rgb(255, 110, 120), rgb(255, 170, 80), rgb(255, 226, 90), rgb(130, 220, 130), rgb(110, 180, 255), rgb(170, 130, 255), rgb(255, 140, 200) }
	local frame = vivid(b, 1, rgb(214, 164, 120))
	for _, z in ipairs({ -10, 10 }) do
		b.BoxR(CFrame.new(0, 8, z) * CFrame.Angles(0, 0.08 * (z > 0 and -1 or 1), 0), 92, 6, 4, frame, M.Wood)
	end
	for _, x in ipairs({ -40, 40 }) do
		for _, z in ipairs({ -10, 10 }) do
			wheel(b, x, 4, z + (z > 0 and 3 or -3), 8, 2, GOLD)
		end
	end
	for index, color in ipairs(colors) do
		local x = -36 + (index - 1) * 12
		local len = 34 - index * 2.4
		b.Box(x, 11, 0, 10, 3, len, color, M.SmoothPlastic)
		for _, z in ipairs({ -len / 2 + 4, len / 2 - 4 }) do
			b.Cyl(x, 14, z, 2, 0.6, CHROME, M.Metal)
		end
	end
	for _, side in ipairs({ -1, 1 }) do
		b.Tube(side * 14, 16, 22, side * 30, 24, 30, 2, rgb(214, 164, 120), M.Wood)
		b.Ball(side * 14, 16, 22, 7, colors[side > 0 and 5 or 1], M.SmoothPlastic)
	end
	b.Footprint(96, 46, 30)
end

R.JackInTheBox = function(b, _ctx)
	local boxColor = vivid(b, 1, rgb(120, 190, 255))
	local jester = vivid(b, 2, rgb(255, 120, 160))
	b.Round(0, 0, 0, 50, 44, 50, 4, boxColor, M.SmoothPlastic)
	for _, z in ipairs({ -25.5, 25.5 }) do
		House3DKit.Star(b, 0, 22, z > 0 and 25 or -27, 10, 1.5, rgb(255, 226, 110), M.SmoothPlastic)
	end
	b.BoxR(CFrame.new(0, 58, -30) * CFrame.Angles(-1.3, 0, 0), 50, 30, 3, boxColor, M.SmoothPlastic)
	b.CylX(27, 22, 0, 4, 6, GOLD, M.Metal)
	b.Tube(31, 22, 0, 31, 30, 8, 2, GOLD, M.Metal)
	-- ressort + clown
	for index = 0, 5 do
		b.Cyl(0, 44 + index * 3.5, 0, 14 - (index % 2) * 3, 1.5, CHROME, M.Metal)
	end
	b.Egg(0, 70, 0, 24, 16, 20, jester, M.Fabric)
	b.Ball(0, 84, 0, 20, rgb(255, 232, 214), M.SmoothPlastic)
	b.Ball(0, 83, 10, 6, rgb(255, 80, 90), M.SmoothPlastic)
	for _, side in ipairs({ -1, 1 }) do
		b.Ball(side * 4, 87, 9, 3, INK, M.SmoothPlastic)
		b.Tube(side * 4, 92, 0, side * 16, 100, 2, 5, side < 0 and jester or rgb(255, 214, 90), M.Fabric)
		b.Ball(side * 16, 100, 2, 5, rgb(255, 214, 90), M.SmoothPlastic)
	end
	b.Footprint(56, 56, 100)
end

-- Petites voitures
local function car(b: Builder, color: Color3, scale: number, monster: boolean)
	local wheelD = monster and 26 or 16
	local y0 = monster and 20 or 8
	b.Round(0, y0, 0, 70 * scale, 16, 36, 6, color, M.SmoothPlastic)
	b.Round(-4, y0 + 16, 0, 40 * scale, 14, 30, 6, lighten(color, 0.12), M.SmoothPlastic)
	local glass = b.Box(-4, y0 + 18, 0, 40 * scale + 1, 9, 26, rgb(170, 220, 255), M.Glass)
	glass.Transparency = 0.2
	for _, x in ipairs({ -22 * scale, 22 * scale }) do
		for _, z in ipairs({ -18, 18 }) do
			wheel(b, x, wheelD / 2, z, wheelD, monster and 10 or 5, monster and rgb(255, 214, 90) or CHROME)
		end
	end
	for _, z in ipairs({ -12, 12 }) do
		b.CylX(35 * scale + 0.5, y0 + 9, z, 6, 1.5, rgb(255, 240, 180), M.Neon)
		b.CylX(-35 * scale - 0.5, y0 + 9, z, 5, 1.5, rgb(255, 80, 80), M.Neon)
	end
	if monster then
		for _, z in ipairs({ -12, 12 }) do
			b.Tube(-18, y0, z, 18, y0, z, 3, CHROME, M.Metal)
		end
		b.Tube(-30, y0 + 30, 0, -30, y0 + 50, 0, 1, CARBON, M.Metal)
	end
end
R.ToyCar = function(b, _ctx)
	car(b, vivid(b, 1, rgb(255, 130, 180)), 1.25, false)
	b.Footprint(92, 44, 48)
end
R.RCCar = function(b, _ctx)
	car(b, vivid(b, 1, rgb(80, 150, 255)), 1.1, true)
	b.Footprint(90, 50, 80)
end

R.ToyGarage = function(b, _ctx)
	local wall = vivid(b, 1, rgb(255, 214, 90))
	local roof = vivid(b, 2, rgb(255, 110, 120))
	b.Box(0, 0, -6, 90, 40, 36, wall, M.SmoothPlastic)
	for index = 0, 1 do
		b.Box(-20 + index * 40, 4, 12.2, 30, 26, 1, rgb(60, 60, 80))
		b.Box(-20 + index * 40, 4, 12.6, 30, 3, 1, CHROME, M.Metal)
	end
	b.Box(0, 40, -6, 94, 4, 40, roof, M.SmoothPlastic)
	-- rampe qui descend du toit
	b.BoxR(CFrame.new(38, 24, 26) * CFrame.Angles(0, 0, 0.5), 50, 3, 18, rgb(120, 120, 140), M.SmoothPlastic)
	b.Box(0, 44, -6, 30, 18, 20, lighten(wall, 0.2), M.SmoothPlastic)
	b.Box(0, 62, -6, 34, 3, 24, roof, M.SmoothPlastic)
	House3DKit.Heart(b, 0, 52, 4, 8, 1, roof, M.SmoothPlastic)
	-- petite voiture garée devant
	b.Round(-20, 3, 26, 22, 7, 12, 3, rgb(120, 190, 255), M.SmoothPlastic)
	b.Round(-22, 10, 26, 12, 5, 10, 3, rgb(160, 210, 255), M.SmoothPlastic)
	for _, x in ipairs({ -27, -13 }) do
		for _, z in ipairs({ 20, 32 }) do
			wheel(b, x, 3, z, 6, 2)
		end
	end
	b.Footprint(96, 70, 66)
end

-- Tas de peluches (petites boules-animaux entassées)
R.PlushPile = function(b, _ctx)
	local colors = { vivid(b, 1, rgb(255, 180, 200)), vivid(b, 2, rgb(200, 170, 255)), vivid(b, 3, rgb(255, 220, 150)), vivid(b, 4, rgb(170, 220, 255)), rgb(250, 250, 252) }
	local spots = { { -24, 16, 6, 30 }, { 20, 16, 4, 32 }, { 0, 14, -16, 28 }, { -6, 40, 0, 28 }, { 18, 42, -8, 22 }, { 2, 62, -4, 22 } }
	for index, p in ipairs(spots) do
		local color = colors[(index - 1) % #colors + 1]
		b.Egg(p[1], p[2], p[3], p[4], p[4] * 0.9, p[4] * 0.9, color, M.Fabric)
		b.Ball(p[1], p[2] + p[4] * 0.45, p[3] + 2, p[4] * 0.7, color, M.Fabric)
		for _, side in ipairs({ -1, 1 }) do
			b.Ball(p[1] + side * p[4] * 0.26, p[2] + p[4] * 0.72, p[3] + 1, p[4] * 0.28, color, M.Fabric)
			b.Ball(p[1] + side * p[4] * 0.12, p[2] + p[4] * 0.48, p[3] + 2 + p[4] * 0.33, p[4] * 0.1, INK, M.SmoothPlastic)
		end
	end
	b.Footprint(84, 60, 80)
end

----------------------------------------------------------------------
-- ÉLECTRONIQUE
----------------------------------------------------------------------

R.RotaryPhone = function(b, _ctx)
	local color = vivid(b, 1, rgb(255, 130, 170))
	b.Round(0, 0, 0, 64, 18, 48, 8, color, M.SmoothPlastic)
	b.Part("WedgePart", CFrame.new(0, 26, 2) * CFrame.Angles(0, math.pi, 0), Vector3.new(56, 16, 36), color, M.SmoothPlastic, "Pente")
	b.Part("Part", CFrame.new(0, 28, 12) * CFrame.Angles(-0.42, 0, 0) * CFrame.Angles(0, math.pi / 2, 0) * CFrame.Angles(0, 0, math.pi / 2), Vector3.new(3, 30, 30), rgb(250, 246, 250), M.SmoothPlastic, "Cadran");
	((b.Parts[#b.Parts]) :: Part).Shape = Enum.PartType.Cylinder
	for index = 0, 9 do
		local a = index / 10 * math.pi * 1.6 + 0.4
		local p = (CFrame.new(0, 28, 12) * CFrame.Angles(-0.42, 0, 0) * CFrame.new(math.cos(a) * 10, math.sin(a) * 10, 1.8)).Position
		b.Ball(p.X, p.Y, p.Z, 3.5, INK, M.SmoothPlastic)
	end
	-- combiné
	b.Box(0, 34, -10, 56, 5, 10, darken(color, 0.1), M.SmoothPlastic)
	for _, side in ipairs({ -1, 1 }) do
		b.Egg(side * 28, 36, -10, 14, 10, 14, darken(color, 0.1), M.SmoothPlastic)
	end
	House3DKit.Path(b, { { -30, 8, -22 }, { -36, 4, -10 }, { -34, 8, 4 }, { -32, 30, -8 } }, 2, darken(color, 0.2), M.SmoothPlastic)
	b.Footprint(80, 50, 44)
end

R.RetroRadio = function(b, _ctx)
	local body = vivid(b, 1, rgb(140, 210, 190))
	b.Round(0, 4, 0, 86, 50, 34, 10, body, M.SmoothPlastic)
	b.CylZ(-18, 30, 17, 36, 1.5, rgb(240, 230, 214), M.Fabric)
	for index = 0, 4 do
		b.Box(-18, 16 + index * 6, 18, 30, 1.5, 1, darken(body, 0.25))
	end
	b.Box(22, 28, 17.3, 30, 14, 1, rgb(255, 240, 200))
	b.Box(18, 30, 18, 1.2, 10, 1, rgb(240, 70, 70))
	for _, x in ipairs({ 14, 30 }) do
		b.CylZ(x, 16, 18, 8, 3, CHROME, M.Metal)
	end
	for _, x in ipairs({ -30, 30 }) do
		b.Box(x, 0, 0, 8, 4, 30, darken(body, 0.3))
	end
	b.Tube(-26, 54, 0, 0, 66, 0, 3, CHROME, M.Metal)
	b.Tube(0, 66, 0, 26, 54, 0, 3, CHROME, M.Metal)
	b.Tube(30, 54, -6, 44, 92, -10, 1.5, CHROME, M.Metal)
	b.Footprint(90, 36, 90)
end

R.Smartphone = function(b, _ctx)
	local case = vivid(b, 1, rgb(255, 170, 200))
	b.Round(0, 0, -6, 44, 3, 30, 4, rgb(240, 236, 246), M.SmoothPlastic)
	b.BoxR(CFrame.new(0, 40, 0) * CFrame.Angles(-0.25, 0, 0), 40, 78, 6, case, M.SmoothPlastic)
	local glass = b.BoxR(CFrame.new(0, 41, 0) * CFrame.Angles(-0.25, 0, 0) * CFrame.new(0, 0, 3.2), 34, 66, 0.6, rgb(130, 190, 255), M.Neon)
	table.insert(b.Glows, glass)
	for row = 0, 2 do
		for column = 0, 2 do
			local p = CFrame.new(0, 41, 0) * CFrame.Angles(-0.25, 0, 0) * CFrame.new(-10 + column * 10, 18 - row * 10, 3.8)
			b.BoxR(p, 7, 7, 0.6, ({ rgb(255, 130, 160), rgb(255, 214, 90), rgb(130, 220, 150) })[(row + column) % 3 + 1])
		end
	end
	b.BoxR(CFrame.new(0, 41, 0) * CFrame.Angles(-0.25, 0, 0) * CFrame.new(0, 30, 3.6), 10, 2, 0.6, CARBON)
	b.Footprint(46, 34, 84)
end

R.InstantCamera = function(b, _ctx)
	local body = vivid(b, 1, rgb(140, 200, 255))
	b.Round(0, 0, 0, 80, 56, 44, 10, body, M.SmoothPlastic)
	b.Round(0, 56, -6, 60, 10, 30, 6, lighten(body, 0.3), M.SmoothPlastic)
	b.CylZ(-4, 28, 22, 34, 6, rgb(240, 240, 246), M.SmoothPlastic)
	b.CylZ(-4, 28, 25, 24, 2, CARBON, M.SmoothPlastic)

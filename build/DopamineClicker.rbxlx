	------------------------------------------------------------------
	-- État de la partie
	------------------------------------------------------------------
	local st = {
		Visible = true,
		VisibleCheck = 0,
		Clock = 0,
		DayTime = DAY_LENGTH * random:NextNumber(0.1, 0.3),
		LightTimer = 0,
		LightSig = -99,
		NightMask = false,
		Night = 0,
		Mode = "Run", -- "Run" | "Crash"
		ModeT = 0,
		RunTime = 0,
		RunLength = random:NextNumber(80, 160),
		CrashPending = false,
		Speed = BASE_SPEED,
		Scroll = 0,
		WaveDistance = 0,
		Distance = 0,
		Coins = 0,
		ShownCoins = -1,
		ShownDistance = -1,
		CoinPulse = 0,
		Combo = 0,
		LastCoin = -10,
		ComboPulse = 0,
		BestBeaten = false,
		EventCooldown = 0,
		TargetLane = 2,
		LeftLane = 2,
		LaneChangedAt = -10,
		RunnerX = 0,
		RunnerH = 0,
		Lean = 0,
		RunPhase = 0,
		LastStep = 0,
		JumpT = -1, -- < 0 : pas de saut en cours
		SlideT = -1, -- < 0 : pas de glissade en cours
		LandT = 0,
		WishLane = 2,
		WishTimer = 2,
		JetTime = 0,
		MagnetTime = 0,
		DoubleTime = 0,
		PowerTimer = random:NextNumber(8, 12), -- premier bonus assez tôt
		PendingPower = nil :: string?,
		AirDistance = 0,

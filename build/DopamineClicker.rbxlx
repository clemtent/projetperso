        <Item class="ModuleScript" referent="168">
          <Properties>
            <string name="Name">FR_HouseRooms</string>
            <string name="Source"><![CDATA[--[[
	FR_HouseRooms (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > Lang > FR_HouseRooms

	Traductions françaises de la maison à plusieurs pièces (vue d'ensemble
	de l'immeuble, mode rangement, choix du type de pièce, onglets des
	pièces, éditeur : annuler / rétablir, aimant, dupliquer, envoyer dans
	une autre pièce).
	Clé = texte ANGLAIS exact utilisé dans le code (Locale.T("...")) ;
	valeur = texte français. Mêmes %s / %d dans les deux ("%%" = signe %).
]]

return {
	fr = {
		-- Bandeau, vue d'ensemble
		["%d/%d rooms"] = "%d/%d pièces",
		["+%s%%"] = "+%s %%",
		["↔️ Arrange"] = "↔️ Ranger",
		["⬅ House"] = "⬅ Maison",
		["👆 Tap a room to decorate it"] = "👆 Touche une pièce pour la décorer",
		["✋ Drag a room onto another spot  •  tap it for options"] = "✋ Glisse une pièce vers une autre place  •  touche-la pour les options",
		["New room"] = "Nouvelle pièce",
		["🔀 Swap"] = "🔀 Échanger",
		["📍 Move here"] = "📍 Mettre ici",

		-- Achat / type de pièce, menu d'une pièce
		["🏗️ New room  •  💧 %s"] = "🏗️ Nouvelle pièce  •  💧 %s",
		["Room %d/%d — its favourite items give ✨ +%s%% comfort"] = "Pièce %d/%d — ses objets préférés donnent ✨ +%s %% de confort",
		["New room!"] = "Nouvelle pièce !",
		["🏠 New room"] = "🏠 Nouvelle pièce",
		["🔄 Change room type"] = "🔄 Changer le type de pièce",
		["Free! Items stay where they are  •  favourites give ✨ +%s%% comfort"] = "Gratuit ! Les objets restent en place  •  les préférés donnent ✨ +%s %% de confort",
		["✓ Current"] = "✓ Actuel",
		["Drag the room onto another spot to move it"] = "Glisse la pièce vers une autre place pour la déplacer",
		["🚪 Go inside"] = "🚪 Entrer",
		["🔄 Change type"] = "🔄 Changer de type",

		-- Pièce
		["This room is empty! 🥺\nPlace cute furniture to make it cozy."] = "Cette pièce est vide ! 🥺\nPose des meubles tout mignons pour la rendre douillette.",
		["✏️ Decorate"] = "✏️ Décorer",
		["This room is full! The new item waits in your inventory 📦"] = "Cette pièce est pleine ! Le nouvel objet t'attend dans l'inventaire 📦",
		["This room is full (%d items)! Decorate another room 🏡"] = "Cette pièce est pleine (%d objets) ! Décore une autre pièce 🏡",

		-- Éditeur
		["Copy"] = "Copier",
		["Send"] = "Envoyer",
		["Smaller  ( - )"] = "Plus petit  ( - )",
		["Bigger  ( + )"] = "Plus grand  ( + )",
		["Send backward  ( Page Down )"] = "Derrière  ( Page suiv. )",
		["Bring forward  ( Page Up )"] = "Devant  ( Page préc. )",
		["Duplicate  ( Ctrl+D )"] = "Dupliquer  ( Ctrl+D )",
		["Send to another room"] = "Envoyer dans une autre pièce",
		["Store in inventory  ( Delete )"] = "Ranger dans l'inventaire  ( Suppr )",
		["↩️ Undo"] = "↩️ Annuler",
		["↪️ Redo"] = "↪️ Rétablir",
		["🧲 Snap: on"] = "🧲 Aimant : oui",
		["🧲 Snap: off"] = "🧲 Aimant : non",
		["🧲 Items now snap to the grid"] = "🧲 Les objets s'aimantent à la grille",
		["🧲 Free placement"] = "🧲 Placement libre",
		["No other copy in your inventory: buy one in the shop!"] = "Plus d'exemplaire dans ton inventaire : achètes-en un à la boutique !",
		["Buy another room first! 🏡"] = "Achète d'abord une autre pièce ! 🏡",
		["Some items are already used in another room"] = "Certains objets sont déjà utilisés dans une autre pièce",
		["%s sent to %s"] = "%s envoyé dans : %s",

		-- Envoyer dans une autre pièce
		["🚪 Send %s to…"] = "🚪 Envoyer %s dans…",
		["It lands on a free spot of that room"] = "Il sera posé à une place libre de cette pièce",
		["🚫 Full"] = "🚫 Pleine",
		["✨ Favourite"] = "✨ Préféré",
	},
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="169">
          <Properties>
            <string name="Name">FR_HouseShop</string>
            <string name="Source"><![CDATA[--[[
	FR_HouseShop (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > Lang > FR_HouseShop

	Traductions françaises de la boutique de la maison (House/HouseShop) :
	onglet 🚪 Pièces, onglet 🏡 Maisons (bâtiments, grille des pièces),
	murs / sols par pièce, badges ✨ des objets préférés.
	Clé = texte ANGLAIS exact utilisé dans le code (Locale.T("...")) ;
	valeur = texte français. Mêmes %s / %d dans les deux ("%%" = signe %).
	Les textes déjà traduits ailleurs (FR_HouseUI, FR_UI, FR_Server) ne sont
	pas répétés ici.
]]

return {
	fr = {
		-- Onglets
		["🚪 Rooms"] = "🚪 Pièces",

		-- Objets : préférés de la pièce ouverte
		["%s Favourites"] = "%s Préférés",
		["✨ +%s comfort"] = "✨ +%s confort",
		["MAX ✓"] = "MAX ✓",

		-- Murs / sols par pièce
		["🎨 Walls of this room:"] = "🎨 Murs de cette pièce :",
		["🟫 Floor of this room:"] = "🟫 Sol de cette pièce :",
		["🏠 Open a room, or pick one here:"] = "🏠 Ouvre une pièce, ou choisis-la ici :",
		["Open a room to change its walls and floor"] = "Ouvre une pièce pour changer ses murs et son sol",

		-- Pièces
		["%s %s  •  %d/%d rooms"] = "%s %s  •  %d/%d pièces",
		["Next room: %s"] = "Prochaine pièce : %s",
		["🏠 Full house! Move to a bigger one 🏡"] = "🏠 Maison pleine ! Passe à plus grand 🏡",
		["✨ Items a room loves give +%s%% comfort there"] = "✨ Les objets préférés d'une pièce y donnent +%s %% de confort",
		["✨ Loves (+%s%%):"] = "✨ Préférés (+%s %%) :",
		["🏡 Bigger house"] = "🏡 Plus grande maison",
		["New room: %s!"] = "Nouvelle pièce : %s !",
		["🚪 New room!"] = "🚪 Nouvelle pièce !",

		-- Maisons
		["🏢 1 floor × %d rooms"] = "🏢 1 étage × %d pièces",
		["🏢 %d floors × %d rooms"] = "🏢 %d étages × %d pièces",
		["🛋️ up to %d items / room"] = "🛋️ %d objets max / pièce",
		["🏠 Home • %d/%d rooms"] = "🏠 Chez toi • %d/%d pièces",
		["⚠️ Too many rooms (max %d)"] = "⚠️ Trop de pièces (max %d)",
	},
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="170">
          <Properties>
            <string name="Name">FR_HouseUI</string>
            <string name="Source"><![CDATA[--[[
	FR_HouseUI (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > Lang > FR_HouseUI

	Traductions françaises de l'interface de "🏠 Ma maison" (fenêtre de la
	maison, pièce, barre d'outils d'édition, inventaire, boutique de la
	maison, bouton 🏠 de la colonne centrale).
	Clé = texte ANGLAIS exact utilisé dans le code (Locale.T("...")) ;
	valeur = texte français. Mêmes %s / %d dans les deux ("%%" = signe %).
	Les noms des objets, papiers peints, sols et tailles (Config.House) sont
	traduits par FR_House ; les textes déjà traduits ailleurs (FR_UI :
	"You need %s more Dopamine", "✔ Owned"...) ne sont pas répétés ici.
]]

return {
	fr = {
		-- Fenêtre
		["🏠 My House"] = "🏠 Ma maison",
		["Decorate your cozy room: comfort boosts ALL your gains"] = "Décore ton petit nid : le confort booste TOUS tes gains",
		["🏠 My house"] = "🏠 Ma maison",
		["%d/%d items"] = "%d/%d objets",
		["❤️ %d comfort"] = "❤️ %d de confort",
		["+%s%% Dopamine"] = "+%s %% de Dopamine",
		["✏️ Edit"] = "✏️ Modifier",
		["✅ Done"] = "✅ Terminé",
		["🛍️ Shop"] = "🛍️ Boutique",
		["👀 Preview"] = "👀 Aperçu",
		["✋ Drag to move  •  tap for options"] = "✋ Glisse pour déplacer  •  touche pour les options",
		["Your room is empty! 🥺\nBuy cute furniture to make it cozy."] = "Ta chambre est vide ! 🥺\nAchète des meubles tout mignons pour la rendre douillette.",
		["🛍️ Open the shop"] = "🛍️ Ouvrir la boutique",
		["📦 Inventory\ntap to place"] = "📦 Inventaire\ntouche pour poser",
		["Everything is placed! Buy more cute stuff in the 🛍️ Shop."] = "Tout est posé ! Achète encore plein de trucs mignons dans la 🛍️ Boutique.",
		["Your house is full! The new item waits in your inventory 📦"] = "Ta maison est pleine ! Le nouvel objet t'attend dans ton inventaire 📦",

		-- Sauvegarde automatique
		["✏️ Changes…"] = "✏️ Modifications…",
		["💾 Saving…"] = "💾 Enregistrement…",
		["Saved ✓"] = "Enregistré ✓",
		["⚠️ Not saved"] = "⚠️ Non enregistré",
		["Couldn't save your room, try again."] = "Impossible d'enregistrer ta chambre, réessaie.",

		-- Barre d'outils d'édition
		["Smaller"] = "Petit",
		["Bigger"] = "Grand",
		["Back"] = "Derrière",
		["Front"] = "Devant",
		["Store"] = "Ranger",
		["Already in front!"] = "Déjà devant !",
		["Already at the back!"] = "Déjà derrière !",
		["Buy one in the shop first!"] = "Achètes-en d'abord un dans la boutique !",
		["Your house is full (%d items)! Move into a bigger one 🏡"] = "Ta maison est pleine (%d objets) ! Emménage dans une plus grande 🏡",

		-- Boutique de la maison
		["🛍️ House shop"] = "🛍️ Boutique déco",
		["🛋️ Items"] = "🛋️ Objets",
		["🎨 Walls"] = "🎨 Murs",
		["🟫 Floors"] = "🟫 Sols",
		["🏡 Houses"] = "🏡 Maisons",
		["Wall"] = "Mur",
		["Floor"] = "Sol",
		["✨ New"] = "✨ Nouveau",
		["❤️ +%d comfort"] = "❤️ +%d de confort",
		["You already have the maximum of %s"] = "Tu as déjà le maximum de %s",
		["%s is yours!"] = "%s est à toi !",
		["🏠 New item"] = "🏠 Nouvel objet",
		["✔ Applied"] = "✔ Appliqué",
		["Apply"] = "Appliquer",
		["Applied!"] = "Appliqué !",
		["↔ x%s wide  •  up to %d items"] = "↔ largeur x%s  •  jusqu'à %d objets",
		["✔ Home"] = "✔ Chez toi",
		["🏠 You live here"] = "🏠 Tu habites ici",
		["Move in"] = "Emménager",
		["Welcome home!"] = "Bienvenue chez toi !",
		["🏡 New house!"] = "🏡 Nouvelle maison !",
	},
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="171">
          <Properties>
            <string name="Name">FR_Server</string>
            <string name="Source"><![CDATA[--[[
	FR_Server (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > Lang > FR_Server

	Traductions françaises des textes envoyés par le SERVEUR (notifications,
	réponses des RemoteFunctions, quêtes, commandes de test...).
	Clé = texte ANGLAIS exact utilisé dans ServerScriptService ; valeur =
	texte français. Garde les mêmes %s / %d, dans le même ordre.
]]

return {
	fr = {
		-- Messages communs
		["Slow down!"] = "Doucement !",
		["Loading..."] = "Chargement en cours...",
		["Invalid request"] = "Requête invalide",
		["Not enough %s"] = "Pas assez de %s",

		-- Sauvegarde (DataService)
		["⚠️ Saving is unavailable: your progress won't be saved."] = "⚠️ Sauvegarde indisponible : ta progression ne sera pas enregistrée.",

		-- Améliorations, océan, hors-ligne (GameService)
		["Unknown upgrade"] = "Amélioration inconnue",
		["Max level reached"] = "Niveau maximum atteint",
		["🌊 Breathe... Permanent earnings %s"] = "🌊 Respire... Gains permanents %s",
		["✨ New: %s %s!"] = "✨ Nouveau : %s %s !",
		["%s %s level %d"] = "%s %s niveau %d",
		["🌊 %s went to the ocean (x%s)"] = "🌊 %s est allé(e) à l'océan (x%s)",
		["😴 Welcome back! +%s %s earned while you were away"] = "😴 Bon retour ! +%s %s gagnée hors-ligne",

		-- Quêtes et succès
		["QUEST COMPLETE!"] = "QUÊTE TERMINÉE !",
		["ACHIEVEMENT UNLOCKED!"] = "SUCCÈS DÉBLOQUÉ !",

		-- Machine à sous (CasinoService)
		["The casino is closed"] = "Le casino est fermé",
		["The slot machine isn't unlocked yet"] = "La machine à sous n'est pas encore débloquée",
		["Invalid bet"] = "Mise invalide",
		["The machine is still spinning..."] = "La machine tourne encore...",
		["You need at least %s %s"] = "Il faut au moins %s %s",
		["🎰 %s won x%s on the slot machine!"] = "🎰 %s a gagné x%s à la machine à sous !",

		-- Boutique d'objets (CosmeticService)
		["The shop isn't unlocked yet"] = "La boutique n'est pas encore débloquée",
		["Unknown item"] = "Objet inconnu",
		["Invalid item"] = "Objet invalide",
		["You already own this item"] = "Tu as déjà cet objet",
		["%s %s bought! (%s)"] = "%s %s acheté ! (%s)",
		["You don't own this item"] = "Tu ne possèdes pas cet objet",
		["%s %s equipped"] = "%s %s équipé",
		["%s %s removed"] = "%s %s retiré",

		-- Cadeau quotidien (DailyRewardService)
		["The calendar isn't unlocked yet"] = "Le calendrier n'est pas encore débloqué",
		["Already claimed today, come back tomorrow!"] = "Déjà récupéré aujourd'hui, reviens demain !",
		["Day %d: +%s %s!"] = "Jour %d : +%s %s !",

		-- Coffre mystère (LootService)
		["The mystery chest isn't unlocked yet"] = "Le coffre mystère n'est pas encore débloqué",
		["No chests to open, be patient..."] = "Aucun coffre à ouvrir, patience...",
		["📦 %s opened a %s chest (+%s)!"] = "📦 %s a ouvert un coffre %s (+%s) !",

		-- Logo DVD (DVDService)
		["📀 PERFECT CORNER! +%s"] = "📀 COIN PARFAIT ! +%s",
		["📀 %s hit the PERFECT CORNER!"] = "📀 %s a touché le COIN PARFAIT !",

		-- Dopamine Rush (EventService)
		["⚡ %s extended by %s s!"] = "⚡ %s prolongé de %s s !",
		["⚡ %s: x%s for %s s!"] = "⚡ %s : x%s pendant %s s !",

		-- Bourse (StockService)
		["The stock market isn't unlocked yet"] = "La bourse n'est pas encore débloquée",
		["📈 Bought %s %s share(s)"] = "📈 %s action(s) %s achetée(s)",
		["You don't own any shares"] = "Tu n'as aucune action",
		["profit +%s"] = "bénéfice +%s",
		["loss -%s"] = "perte -%s",
		["💰 Sold for %s (%s)"] = "💰 Vendu pour %s (%s)",

		-- Thèmes (ThemeService)
		["Unknown theme"] = "Thème inconnu",
		["You already own this theme"] = "Tu as déjà ce thème",
		["This theme is unlocked with Robux"] = "Ce thème s'obtient avec des Robux",
		["This theme is unlocked with Robux (or the VIP pass)"] = "Ce thème s'obtient avec des Robux (ou le pass VIP)",
		["Theme unavailable"] = "Thème indisponible",
		["%s %s theme bought! (%s)"] = "%s Thème %s acheté ! (%s)",
		["You don't own this theme"] = "Tu ne possèdes pas ce thème",
		["%s %s theme equipped"] = "%s Thème %s équipé",

		-- Boutique Robux (MonetizationService)
		["%s %s theme"] = "%s Thème %s",
		["💎 Thank you! %s unlocked!"] = "💎 Merci ! %s débloqué !",
		["💎 Thank you! %s %s: +%s %s"] = "💎 Merci ! %s %s : +%s %s",
		["💎 Thank you! %s %s active (%d min left)"] = "💎 Merci ! %s %s actif (%d min restantes)",
		["🎉 %s is treating the whole server to a Dopamine Rush!"] = "🎉 %s offre un Dopamine Rush à tout le serveur !",
		["💎 Thank you! %s Rush started for the whole server!"] = "💎 Merci ! %s Rush lancé pour tout le serveur !",

		-- Commandes de test (DebugService, Studio uniquement)
		["Invalid amount"] = "Montant invalide",
		["Dopamine Rush started!"] = "Dopamine Rush lancé !",
		["A Rush is already running"] = "Un Rush est déjà en cours",
		["Daily gift available"] = "Cadeau quotidien disponible",
		["💾 Saved!"] = "💾 Sauvegardé !",
		["💾 Couldn't save (see the Output)"] = "💾 Sauvegarde impossible (voir la sortie)",
		["Corner in ~2 seconds..."] = "Coin dans ~2 secondes...",
		["You need at least one DVD logo"] = "Il faut au moins un logo DVD",
		["Everything unlocked!"] = "Tout est débloqué !",
		["Unknown type: %s"] = "Type inconnu : %s",
		["Too many %s objects on screen"] = "Trop d'objets %s à l'écran",
		["%s object sent"] = "Objet %s envoyé",
		["🌊 Free detox"] = "🌊 Détox gratuite",
		["Chests added"] = "Coffres ajoutés",
		["Data reset"] = "Données remises à zéro",
		["Unknown pass: %s"] = "Pass inconnu : %s",
		["Couldn't toggle this pass"] = "Impossible de changer ce pass",
		["Pass %s enabled"] = "Pass %s activé",
		["Pass %s disabled"] = "Pass %s désactivé",
		["Usage: /boost <mult 1-1000> <seconds>"] = "Usage : /boost <mult 1-1000> <secondes>",
		["Boost x%s for %d s"] = "Boost x%s pendant %d s",
		["Unknown theme: %s"] = "Thème inconnu : %s",
		["Theme %s given and equipped"] = "Thème %s donné et équipé",
		["Usage: /offline <seconds 1-%s>"] = "Usage : /offline <secondes 1-%s>",
		["Nothing earned (no production or away < %s s)"] = "Rien gagné (production nulle ou absence < %s s)",
		["Offline simulated: +%s %s"] = "Hors-ligne simulé : +%s %s",
		["Usage: /lang <auto|en|fr>"] = "Usage : /lang <auto|en|fr>",
		["🌐 Language: %s (takes effect after rejoining)"] = "🌐 Langue : %s (appliquée au prochain lancement)",
		["/give /rush /daily /save /corner /unlockall /spawn <%s> /detox /chest /reset /pass <id> /boost <mult> <seconds> /theme <id> /offline <seconds> /lang <auto|en|fr>"] = "/give /rush /daily /save /corner /unlockall /spawn <%s> /detox /chest /reset /pass <id> /boost <mult> <secondes> /theme <id> /offline <secondes> /lang <auto|en|fr>",
		["Unknown command. %s"] = "Commande inconnue. %s",
		["Invalid command"] = "Commande invalide",
		["(already run)"] = "(déjà exécutée)",
		["Error: %s"] = "Erreur : %s",
		["Test commands are only available in Studio"] = "Commandes de test disponibles uniquement dans Studio",
		["Invalid argument"] = "Argument invalide",
		["Locked for now"] = "Verrouillé pour l'instant",
	},
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="172">
          <Properties>
            <string name="Name">FR_StimuliLive</string>
            <string name="Source"><![CDATA[--[[
	FR_StimuliLive (ModuleScript - traductions françaises)
	Emplacement : ReplicatedStorage > Shared > Lang > FR_StimuliLive

	Textes des stimuli LiveStream, Lofi, Runner, Press, Pinwheel et
	BubbleWrap : ["texte anglais exact"] = "texte français".
	Les grosses listes (chat du live, onomatopées, paliers de la presse...)
	sont directement dans chaque module, en { en = {...}, fr = {...} }.
]]

return {
	fr = {
		["🔘 BUBBLE WRAP"] = "🔘 PAPIER BULLE",
		["%d rpm"] = "%d tr/min",
		["Blow! 🌬️"] = "Souffle ! 🌬️",
		["Lv. %s"] = "Niv. %s",
		["...and it's back"] = "...elle est revenue",
		["KEEP FINGERS CLEAR"] = "NE PAS METTRE LES DOIGTS",
		["🗜️ PRESS"] = "🗜️ PRESSE",
		["<s>study</s>\nclick ✅"] = "<s>réviser</s>\ncliquer ✅",
		["%s people studying (or not)"] = "%s personnes révisent (ou pas)",
		["lofi beats 🎧 to study to"] = "lofi beats 🎧 pour réviser",
		["♫ Loading music..."] = "♫ Chargement de la musique...",
		["🔇 Music off (⚙️ Settings)"] = "🔇 Musique coupée (⚙️ Paramètres)",
		["⚠️ Add some music in Config.Music"] = "⚠️ Ajoute une musique dans Config.Music",
		["JETPACK!"] = "JETPACK !",
		["MAGNET!"] = "AIMANT !",
		["💜 Follow"] = "💜 Suivre",
		["yum ♥"] = "miam ♥",
		["BITE!"] = "CROQUE !",
		["📌 <b>Follow</b> to unlock donations 💸"] = "📌 <b>Suis</b> pour débloquer les dons 💸",
		["📌 Thanks followers 💜 Bite the <b>butter</b>!"] = "📌 Merci les abonnés 💜 Croquez le <b>beurre</b> !",
		["📌 Thanks followers 💜 Be nice!"] = "📌 Merci les abonnés 💜 Soyez gentils !",
		["chat is open!! 🎉"] = "le chat est ouvert !! 🎉",
		["i brought BUTTER 🧈"] = "j'ai ramené du BEURRE 🧈",
		["✔ Following"] = "✔ Abonné",
		["💜 You're now following <b>%s</b>!"] = "💜 Tu suis maintenant <b>%s</b> !",
		["thanks for the follow!! donations are open 💸"] = "merci pour le follow !! les dons sont ouverts 💸",
		["Click to claim ✨"] = "Clique pour récupérer ✨",
		["✔ Thanks <b>%s</b>!"] = "✔ Merci <b>%s</b> !",
		["Thanks 💜"] = "Merci 💜",
		["THANKS!!"] = "MERCI !!",
		["out of butter... time for a refill! 🧈"] = "plus de beurre... j'en ressers ! 🧈",
		["Too late 😢"] = "Trop tard 😢",
		["REFILL!"] = "RESSERVI !",
		["SHE'S GOING FOR SECONDS 😭🔥"] = "ELLE RESSERT 😭🔥",
		["RAID!"] = "RAID !",
		["🚨 RAID from <b>%s</b> with %s viewers!"] = "🚨 RAID de <b>%s</b> avec %s spectateurs !",
		["thanks for the raid %s!! 💜"] = "merci pour le raid %s !! 💜",
	},
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="173">
          <Properties>
            <string name="Name">FR_StimuliMisc</string>
            <string name="Source"><![CDATA[--[[
	FR_StimuliMisc (ModuleScript - traductions)
	Emplacement : ReplicatedStorage > Shared > Lang > FR_StimuliMisc

	Textes français des stimuli Casino, Bourse (Stocks), Coffre (LootBox),
	Orage (Weather), DVD, Étoile dorée, Océan...
	Clé = texte anglais exact passé à Locale.T, valeur = texte français.
	Les listes de phrases (actus, blagues...) sont dans les modules
	eux-mêmes ({ en = ..., fr = ... } + Locale.Pick).
]]

return {
	fr = {
		["📜 PAYOUTS"] = "📜 GAINS",
		["Pair = small win · Triple = big win"] = "Paire = petit gain · Triple = gros gain",
		["Average return: %d %% · the house wins a little 🏠"] = "Retour moyen : %d %% · la maison gagne un peu 🏠",

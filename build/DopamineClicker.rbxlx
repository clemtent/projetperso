	fr = { "Clicville", "Bulle-sur-Mer", "Port-Dopa", "Sieste-les-Bains", "Lofi-la-Colline" },
}
local WEATHER = {
	{ Icon = "☀️", Min = 22, Max = 31 },
	{ Icon = "🌤️", Min = 17, Max = 26 },
	{ Icon = "⛅", Min = 12, Max = 21 },
	{ Icon = "🌧️", Min = 8, Max = 16 },

		Scaled = true, ZIndex = 7 })
	local lobbyLeave = button({ Name = "LeaveLobby", Parent = lobby, Text = T("Leave"), TextSize = 16, Color = rgb(120, 100, 140), Size = UDim2.fromOffset(84, 38),

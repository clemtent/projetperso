	-- tronçons le long de X : Bite3 (gauche) .. Bite1 (bout droit)
	local segs = { { "Bite3", -0.3 }, { "Bite2", 0.1 }, { "Bite1", 0.5 } }
	for _, sg in ipairs(segs) do

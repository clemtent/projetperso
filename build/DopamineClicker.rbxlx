local function buildResults(root: Frame)
	local dim = box({ Name = "ResultsDim", Parent = root, Color = rgb(0, 0, 0), Transparency = 0.4, Visible = false, ZIndex = 30, Clip = true })
	UIUtil.SinkClicks(dim)
	-- support (échelle téléphone) ; la carte "pop" à l'intérieur
	local holder = box({ Name = "ResultsHolder", Parent = dim, Transparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(720, 480), ZIndex = 31 })
	parts.ResultsScale = UIUtil.Create("UIScale", { Parent = holder })
	local card = box({ Name = "Results", Parent = holder, Color = PANEL, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(720, 480),
		Radius = UDim.new(0, 24), Stroke = GOLD, StrokeThickness = 3, ZIndex = 31 })
	card.BackgroundColor3 = WHITE
	UIUtil.Gradient(card, ColorSequence.new(PANEL2, PANEL), 90)
	local band = box({ Name = "Band", Parent = card, Transparency = 1, Size = UDim2.new(1, -48, 0, 12), Position = UDim2.fromOffset(24, 10), ZIndex = 32, Clip = true })
	checker(band, 60, 2, 32)
	local title = label({ Name = "Title", Parent = card, Text = "", TextSize = 30, Size = UDim2.new(1, -40, 0, 40), Position = UDim2.fromOffset(20, 26), ZIndex = 32 })
	local stage = box({ Name = "Stage", Parent = card, Transparency = 1, Size = UDim2.fromOffset(420, 250), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 68), ZIndex = 32 })
	local columns = {}
	for i, spec in ipairs({ { 2, 0.18, 104, SILVER }, { 1, 0.5, 146, GOLD }, { 3, 0.82, 76, BRONZE } }) do
		local col = box({ Name = "Col" .. spec[1], Parent = stage, Transparency = 1, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(spec[2], 1),
			Size = UDim2.fromOffset(128, 250), ZIndex = 33 })
		local block = box({ Name = "Block", Parent = col, Color = spec[4], AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, 1), Size = UDim2.fromOffset(124, 0),
			Radius = UDim.new(0, 10), ZIndex = 34, Clip = true })
		UIUtil.Gradient(block, ColorSequence.new(spec[4]:Lerp(WHITE, 0.3), spec[4]:Lerp(INK, 0.25)), 90)
		label({ Name = "Num", Parent = block, Text = tostring(spec[1]), TextSize = 46, Font = Theme.Fonts.Number, Color = WHITE, Size = UDim2.new(1, 0, 0, 56), ZIndex = 35 })
		local head = box({ Name = "Head", Parent = col, Color = WHITE, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -spec[3] - 46), Size = UDim2.fromOffset(62, 62),
			Radius = UDim.new(1, 0), Stroke = spec[4], StrokeThickness = 3, ZIndex = 35, Clip = true })
		local img = UIUtil.Create("ImageLabel", { Name = "Img", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Image = "", ZIndex = 36, Parent = head })
		local emoji = label({ Name = "Emoji", Parent = head, Text = "", TextSize = 36, ZIndex = 37 })
		local name = label({ Name = "Name", Parent = col, Text = "", TextSize = 16, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -spec[3] - 24),
			Size = UDim2.fromOffset(150, 20), Scaled = true, ZIndex = 35 })
		local time = label({ Name = "Time", Parent = col, Text = "", TextSize = 15, Font = Theme.Fonts.Body, Color = SOFT, AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -spec[3] - 4), Size = UDim2.fromOffset(150, 18), ZIndex = 35 })
		columns[spec[1]] = { Col = col, Block = block, Height = spec[3], Head = head, Img = img, Emoji = emoji, Name = name, Time = time }
		local _ = i
	end
	local rows = label({ Name = "Rows", Parent = card, Text = "", Font = Theme.Fonts.Body, TextSize = 15, Color = SOFT, Size = UDim2.new(1, -60, 0, 44), Position = UDim2.fromOffset(30, 324),
		Wrap = true, Rich = true, ZIndex = 32 })
	local mine = label({ Name = "Mine", Parent = card, Text = "", TextSize = 22, Color = GOLD, Size = UDim2.new(1, -60, 0, 30), Position = UDim2.fromOffset(30, 370), Scaled = true, Rich = true, ZIndex = 32 })
	local ok = button({ Name = "Ok", Parent = card, Text = T("Awesome!"), Size = UDim2.fromOffset(200, 48), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -18), ZIndex = 33 })
	ok.Activated:Connect(function()
		RaceHud.HideResults()
	end)
	parts.ResultsDim = dim
	parts.Results = card
	parts.ResultsTitle = title
	parts.Columns = columns
	parts.ResultsRows = rows
	parts.ResultsMine = mine
	parts.ResultsOk = ok
end

local function layout()
	local screen = gui
	if not screen or not parts.Root then
		return
	end
	local size = screen.AbsoluteSize
	if size.X < 10 or size.Y < 10 then
		return
	end
	local touch = UserInputService.TouchEnabled and not UserInputService.MouseEnabled
	phone = touch and math.min(size.X, size.Y) < 500
	local designW, designH = if phone then 820 else 1100, if phone then 430 else 620
	local scale = math.clamp(math.min(size.X / designW, size.Y / designH), 0.45, 1.35)
	parts.Scale.Scale = scale
	parts.Root.Size = UDim2.fromOffset(size.X / scale, size.Y / scale)
	-- téléphone : panneaux plus compacts, bouton 🏁 sous la colonne des voitures
	-- (téléphone : à droite, sous les boutons du haut ; la colonne des voitures est à gauche)
	parts.RacePanel.AnchorPoint = if phone then Vector2.new(1, 0) else Vector2.zero
	parts.RacePanel.Position = if phone then UDim2.new(1, -74, 0, 50) else UDim2.fromOffset(12, 104)
	parts.RaceButton.Position = if phone then UDim2.fromOffset(14, 316) else UDim2.new(0, 22, 0.5, 140)
	parts.RaceTag.Visible = not phone
	local mini = if phone then 116 else 150
	parts.Mini.Size = UDim2.fromOffset(mini, mini)
	parts.MiniLine.Size = UDim2.fromOffset(mini - 24, mini - 24)
	parts.MiniDots.Size = UDim2.fromOffset(mini - 24, mini - 24)
	if parts.MiniPoints then
		drawLine(parts.MiniLine, parts.MiniPoints, WHITE, 4, 6, parts.MiniClosed)
	end
	parts.Arrow.Position = if phone then UDim2.new(0.5, 0, 0, 96) else UDim2.new(0.5, 0, 0, 112)
	parts.Lobby.Position = parts.Arrow.Position
	parts.Reset.Position = UDim2.new(1, -12, 1, -(mini + 22))
	parts.Quit.Position = UDim2.new(1, -104, 1, -(mini + 22))
	parts.Menu.Size = if phone then UDim2.fromOffset(800, 412) else UDim2.fromOffset(800, 470)
	parts.CardGrid.CellSize = if phone then UDim2.fromOffset(183, 250) else UDim2.fromOffset(183, 306)
	for _, c in ipairs(parts.CardList) do
		c.Map.Size = if phone then UDim2.new(1, -20, 0, 60) else UDim2.new(1, -20, 0, 96)
		local lineSize = if phone then 52 else 80
		if c.Line.Size.X.Offset ~= lineSize then
			c.Line.Size = UDim2.fromOffset(lineSize, lineSize)
			c.PreviewKey = nil -- (redessiné à la prochaine mise à jour)
		end
		local top = if phone then 72 else 112
		c.Icon.Position = UDim2.fromOffset(8, top)
		c.Name.Position = UDim2.fromOffset(48, top)
		c.Info.Position = UDim2.fromOffset(10, top + 36)
		c.Info.Visible = not phone
		c.Record.Position = UDim2.fromOffset(10, top + (if phone then 36 else 72))
		c.Best.Position = UDim2.fromOffset(10, top + (if phone then 56 else 92))
		c.Status.Position = UDim2.fromOffset(10, top + (if phone then 78 else 116))
	end
	-- (téléphone : la carte des résultats est réduite d'un bloc)
	if parts.ResultsScale then
		parts.ResultsScale.Scale = if phone then 0.8 else 1
	end
end

function RaceHud.Build(cb: { [string]: any })
	RaceHud.Destroy()
	callbacks = cb or {}
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local old = playerGui:FindFirstChild(RaceHud.GUI_NAME)
	if old then
		old:Destroy()
	end
	local screen = Instance.new("ScreenGui")
	screen.Name = RaceHud.GUI_NAME
	screen.ResetOnSpawn = false
	screen.IgnoreGuiInset = false
	screen.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screen.DisplayOrder = 22
	screen.Parent = playerGui
	gui = screen
	local root = UIUtil.Create("Frame", { Name = "Root", BackgroundTransparency = 1, Size = UDim2.fromOffset(1100, 620), Parent = screen })
	parts.Root = root
	parts.Scale = UIUtil.Create("UIScale", { Parent = root })
	buildRaceHud(root)
	buildMenu(root)
	buildResults(root)
	table.insert(conns, screen:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout))
	layout()
end

function RaceHud.Destroy()
	for _, c in ipairs(conns) do
		c:Disconnect()
	end
	table.clear(conns)
	if gui then
		gui:Destroy()
		gui = nil
	end
	table.clear(parts)
	menuOpen = false
end

function RaceHud.IsBuilt(): boolean
	return gui ~= nil
end

----------------------------------------------------------------------
-- Mises à jour
----------------------------------------------------------------------

function RaceHud.SetRaceButton(visible: boolean)
	if parts.RaceButton then
		parts.RaceButton.Visible = visible
	end
end

function RaceHud.IsMenuOpen(): boolean
	return menuOpen
end

function RaceHud.SetMenu(open: boolean, cards: { any }?, info: { [string]: any }?)
	if not parts.MenuDim then
		return
	end
	local wasOpen = menuOpen
	menuOpen = open
	parts.MenuDim.Visible = open
	if not open then
		return
	end
	if not wasOpen then
		UIUtil.Pop(parts.Menu, 0.92, 0.18)
	end
	if info then
		parts.MenuSub.Text = info.Sub or ""
		parts.MenuFoot.Text = info.Foot or ""
	end
	for index, data in ipairs(cards or {}) do
		local c = parts.CardList[index]
		if not c then
			c = buildCard(parts.Cards, index)
			parts.CardList[index] = c
			local card = c
			card.Join.Activated:Connect(function()
				if callbacks.Join and card.Id ~= "" then
					callbacks.Join(card.Id, card.Joined)
				end
			end)
			layout()
		end
		c.Id = data.Id
		c.Joined = data.Joined == true
		c.Icon.Text = data.Icon or "🏁"
		c.Name.Text = data.Name or ""
		c.Info.Text = data.Info or ""
		c.Record.Text = data.Record or ""
		c.Best.Text = data.Best or ""
		c.Status.Text = data.Status or ""
		c.Status.TextColor3 = data.StatusColor or WHITE
		c.Join.Text = if data.Joined then T("Leave") else T("Join")
		c.Join.BackgroundColor3 = if data.Joined then rgb(120, 100, 140) elseif data.CanJoin then PINK_DEEP else rgb(90, 84, 100)
		c.Card:FindFirstChildOfClass("UIStroke").Color = if data.Joined then GOLD else rgb(120, 90, 160)
		if data.Preview and c.PreviewKey ~= data.PreviewKey then
			c.PreviewKey = data.PreviewKey
			drawLine(c.Line, data.Preview, WHITE, 3, 26, data.Closed)
		end
	end
end

function RaceHud.SetLobby(info: { [string]: any }?)
	if not parts.Lobby then
		return
	end
	parts.Lobby.Visible = info ~= nil
	if info then
		parts.LobbyText.Text = info.Text or ""
	end
end

function RaceHud.SetRace(info: { [string]: any }?)
	if not parts.RacePanel then
		return
	end
	local on = info ~= nil
	parts.RacePanel.Visible = on
	parts.Arrow.Visible = on and info ~= nil and info.Cp ~= nil
	parts.Mini.Visible = on
	parts.Reset.Visible = on and info ~= nil and info.Running == true
	parts.Quit.Visible = on and info ~= nil and info.Running == true
	if not on then
		parts.Wrong.Visible = false
		return
	end
	local i = info :: { [string]: any }
	parts.Place.Text = tostring(i.Place or 1)
	parts.Place.TextColor3 = if i.Place == 1 then GOLD elseif i.Place == 2 then SILVER elseif i.Place == 3 then BRONZE else WHITE
	parts.Count.Text = "/" .. tostring(i.Count or 1)
	parts.Lap.Text = if (i.Laps or 1) > 1 then T("Lap %d/%d", math.clamp(i.Lap or 1, 1, i.Laps), i.Laps) else T("Sprint")
	parts.Time.Text = i.Time or "0:00.00"
	parts.Gap.Text = i.Gap or ""
	parts.BestLap.Text = i.Best or ""
	if i.Cp then
		parts.CpText.Text = i.Cp
		parts.Needle.Rotation = i.Arrow or 0
	end
	parts.Wrong.Visible = i.Wrong == true
end

-- points : { { u, v } } (0..1) ; dots : { { u, v, color, me } }
function RaceHud.SetMinimap(points: { { number } }?, dots: { { any } }?, closed: boolean?)
	if not parts.Mini then
		return
	end
	if points then
		parts.MiniPoints = points
		parts.MiniClosed = closed
		drawLine(parts.MiniLine, points, WHITE, 4, 6, closed)
	end
	if dots then
		local holder = parts.MiniDots
		local w = math.max(4, holder.Size.X.Offset)
		local h = math.max(4, holder.Size.Y.Offset)
		for k, d in ipairs(dots) do
			local dot = parts.Dots[k]
			if not dot then
				dot = box({ Name = "Dot", Parent = holder, Color = WHITE, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(10, 10), Radius = UDim.new(1, 0), ZIndex = 9 })
				UIUtil.Stroke(dot, INK, 1.5)
				parts.Dots[k] = dot
			end
			dot.Visible = true
			dot.BackgroundColor3 = d[3] or WHITE
			dot.Size = if d[4] then UDim2.fromOffset(14, 14) else UDim2.fromOffset(9, 9)
			dot.ZIndex = if d[4] then 10 else 9
			dot.Position = UDim2.fromOffset(d[1] * w, d[2] * h)
		end
		for k = #dots + 1, #parts.Dots do
			parts.Dots[k].Visible = false
		end
	end
end

function RaceHud.Countdown(text: string, color: Color3?)
	local big = parts.Big
	if not big then
		return
	end
	big.Text = text
	big.TextColor3 = color or WHITE
	big.TextTransparency = 0
	local bigStroke = big:FindFirstChild("Stroke") :: UIStroke?
	if bigStroke then
		bigStroke.Transparency = 0
	end
	if countdownTween then
		countdownTween:Cancel()
	end
	parts.BigScale.Scale = 1.6
	local tween = TweenService:Create(parts.BigScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
	countdownTween = tween
	tween:Play()
	if text ~= "" then
		local stamp = text
		task.delay(0.85, function()
			local b = parts.Big
			if b and b.Text == stamp then
				TweenService:Create(b, TweenInfo.new(0.25), { TextTransparency = 1 }):Play()
				local st = b:FindFirstChild("Stroke")
				if st then
					TweenService:Create(st, TweenInfo.new(0.25), { Transparency = 1 }):Play()
				end
				task.delay(0.3, function()
					if parts.Big == b and b.Text == stamp then
						b.Text = ""
					end
				end)
			end
		end)
	end
end

function RaceHud.Flash(text: string, color: Color3?)
	local f = parts.Flash
	if not f then
		return
	end
	flashToken += 1
	local token = flashToken
	f.Text = text
	f.TextColor3 = color or CYAN
	f.TextTransparency = 0
	local fStroke = f:FindFirstChild("Stroke") :: UIStroke?
	if fStroke then
		fStroke.Transparency = 0
	end
	f.Position = UDim2.fromScale(0.5, 0.52)
	TweenService:Create(f, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = UDim2.fromScale(0.5, 0.48) }):Play()
	task.delay(1.3, function()
		local fl = parts.Flash
		if flashToken == token and fl then
			TweenService:Create(fl, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
			local st = fl:FindFirstChild("Stroke")
			if st then
				TweenService:Create(st, TweenInfo.new(0.4), { Transparency = 1 }):Play()
			end
			task.delay(0.45, function()
				if flashToken == token and parts.Flash == fl then
					fl.Text = ""
				end
			end)
		end
	end)
end

----------------------------------------------------------------------
-- Résultats : podium animé
----------------------------------------------------------------------

local function confetti(parent: Instance)
	local colors = { PINK, GOLD, CYAN, MINT, WHITE, rgb(186, 156, 246) }
	for k = 1, 46 do
		local x = math.random()
		local piece = box({ Name = "Confetti", Parent = parent, Color = colors[(k % #colors) + 1], AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(8 + math.random() * 6, 5 + math.random() * 4), Position = UDim2.new(x, 0, 0, -20), ZIndex = 40 })
		piece.Rotation = math.random(0, 180)
		local fall = 2.2 + math.random() * 1.6
		TweenService:Create(piece, TweenInfo.new(fall, Enum.EasingStyle.Sine, Enum.EasingDirection.In), {
			Position = UDim2.new(x + (math.random() - 0.5) * 0.2, 0, 1, 30),
			Rotation = piece.Rotation + math.random(180, 540),
		}):Play()
		task.delay(fall + 0.1, function()
			piece:Destroy()
		end)
	end
end

-- res = { Title, Rows = { { Place, Name, UserId, AI, Time, Finished, Dnf } }, Mine = texte riche, Others = texte riche }
function RaceHud.ShowResults(res: { [string]: any })
	if not parts.ResultsDim then
		return
	end
	RaceHud.SetMenu(false)
	resultsToken += 1
	local token = resultsToken
	parts.ResultsDim.Visible = true
	parts.ResultsTitle.Text = res.Title or ""
	parts.ResultsRows.Text = res.Others or ""
	parts.ResultsMine.Text = res.Mine or ""
	UIUtil.Pop(parts.Results, 0.85, 0.25)
	local byPlace = {}
	for _, row in ipairs(res.Rows or {}) do
		byPlace[row.Place] = row
	end
	-- colonnes : 3e, puis 2e, puis 1er (le suspense), qui montent en douceur
	for _, place in ipairs({ 3, 2, 1 }) do
		local c = parts.Columns[place]
		local row = byPlace[place]
		c.Block.Size = UDim2.fromOffset(124, 0)
		c.Head.Visible = false
		c.Name.Visible = false
		c.Time.Visible = false
		if row then
			c.Name.Text = row.Name or ""
			c.Time.Text = row.TimeText or ""
			if row.AI or (row.UserId or 0) <= 0 then
				c.Img.Image = ""
				c.Emoji.Text = "🤖"
			else
				c.Img.Image = UIUtil.HeadshotUrl(row.UserId, 150)
				c.Emoji.Text = ""
			end
		end
	end
	task.spawn(function()
		for step, place in ipairs({ 3, 2, 1 }) do
			task.wait(if step == 1 then 0.35 else 0.45)
			if token ~= resultsToken or not parts.Columns then
				return
			end
			local c = parts.Columns[place]
			if byPlace[place] then
				TweenService:Create(c.Block, TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.fromOffset(124, c.Height) }):Play()
				task.delay(0.35, function()
					if token ~= resultsToken or not parts.Columns then
						return
					end
					c.Head.Visible = true
					c.Name.Visible = true
					c.Time.Visible = true
					UIUtil.Pop(c.Head, 0.4, 0.3)
				end)
			end
		end
		task.wait(0.5)
		if token == resultsToken and parts.ResultsDim then
			confetti(parts.ResultsDim)
		end
	end)
end

function RaceHud.HideResults()
	resultsToken += 1
	if parts.ResultsDim then
		parts.ResultsDim.Visible = false
	end
end

function RaceHud.Debug(): any
	return { Parts = parts, Layout = layout, IsPhone = function()
		return phone
	end }
end

return RaceHud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="221">
          <Properties>
            <string name="Name">RaceProps</string>
            <string name="Source"><![CDATA[--[[
	RaceProps (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > RaceProps

	🏁 Décor 3D des courses de rue (v10, RACE10), construit CÔTÉ CLIENT et
	en flux par RaceClient (rien sur le serveur) :
	  - QG DES COURSES (zone "RaceMeet" de LAYOUT10) : dalle d'asphalte avec
	    marquages, stand des stands (3 box à rideaux levés, auvent rayé,
	    enseigne "STREET RACES"), comptoir d'inscription (invite E), grand
	    TABLEAU DES RECORDS (SurfaceGui), feux de départ décoratifs, podium
	    1-2-3, piles de pneus, cônes, drapeaux à damier ;
	  - PORTIQUE DE DÉPART (à la ligne de chaque parcours) : 2 piliers, poutre
	    en treillis, banderole au nom du parcours, 5 blocs de FEUX (rouges
	    puis verts : SetLights), ligne de départ à damier et cases de grille
	    peintes (SurfaceGui sur pièces invisibles : aucun z-fight) ;
	  - ARCHE D'ARRIVÉE (sprint) avec banderole à damier ;
	  - ARCHES DE PORTE gonflables (la prochaine brille, SetGateState).
	Aucune vraie lumière (Neon doux), aucun son. Tout est ancré, sans
	collision, sans requête, sans contact (sauf rien).

	API :
	  RaceProps.BuildHQ(cf: CFrame, w: number, d: number) -> (Model, parts : { Prompt: BasePart, Board: BasePart })
	  RaceProps.BuildGantry(cf: CFrame, width: number, title: string, finish: boolean?) -> (Model, { Lights: { { Red, Green } } })
	  RaceProps.SetLights(lights, stage)   stage : 0 éteint, 1..5 rouges allumés, 6 = verts (GO)
	  RaceProps.BuildArch(cf: CFrame, width: number, index: number) -> Model
	  RaceProps.SetGateState(model, state)  "next" | "later" | "done"
	  RaceProps.GridMarks(parent, cfs: { CFrame }) (cases peintes)
]]

local RaceProps = {}

local M = Enum.Material
local rgb = Color3.fromRGB

local INK = rgb(34, 30, 40)
local ASPHALT = rgb(58, 58, 64)
local CONCRETE = rgb(196, 192, 186)
local WHITE = rgb(246, 244, 240)
local RED = rgb(222, 48, 62)
local PINK = rgb(255, 110, 170)
local STEEL = rgb(150, 156, 166)
local DARK = rgb(44, 44, 52)
local YELLOW = rgb(255, 204, 60)
local CYAN = rgb(80, 220, 240)

local function part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: string?): BasePart
	local p: BasePart
	if shape == "Wedge" then
		p = Instance.new("WedgePart")
	else
		local q = Instance.new("Part")
		if shape == "Cyl" then
			q.Shape = Enum.PartType.Cylinder
		elseif shape == "Ball" then
			q.Shape = Enum.PartType.Ball
		end
		p = q
	end
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = size.X * size.Y * size.Z > 30
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end
RaceProps.Part = part

-- Pièce invisible qui porte une SurfaceGui (marquages au sol, textes)
local function canvas(parent: Instance, name: string, size: Vector3, cf: CFrame, face: Enum.NormalId, pps: number): (BasePart, SurfaceGui)
	local p = part(parent, name, size, cf, WHITE)
	p.Transparency = 1
	p.CastShadow = false
	local sg = Instance.new("SurfaceGui")
	sg.Name = "Gui"
	sg.Face = face
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = pps
	sg.LightInfluence = 1
	sg.MaxDistance = 400
	sg.Parent = p
	return p, sg
end

local function frame(parent: Instance, props: { [string]: any }): Frame
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	for k, v in pairs(props) do
		(f :: any)[k] = v
	end
	f.Parent = parent
	return f
end

local function text(parent: Instance, props: { [string]: any }): TextLabel
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.BorderSizePixel = 0
	t.Font = Enum.Font.GothamBlack
	t.TextScaled = true
	t.TextColor3 = WHITE
	for k, v in pairs(props) do
		(t :: any)[k] = v
	end
	t.Parent = parent
	return t
end

-- Verso d'un panneau : pièce invisible un peu plus épaisse, retournée, qui
-- porte une copie de la SurfaceGui sur SA face avant (0,02 devant le dos du
-- panneau : lisible des deux côtés, sans z-fight)
local function backSide(parent: Instance, base: BasePart, sg: SurfaceGui)
	local p = part(parent, base.Name .. "Back", base.Size + Vector3.new(0, 0, 0.1), base.CFrame * CFrame.Angles(0, math.pi, 0), WHITE)
	p.Transparency = 1
	p.CastShadow = false
	local copy = sg:Clone()
	copy.Face = Enum.NormalId.Front
	copy.Parent = p
end

-- Damier (cases n x m) dans une Frame
local function checker(parent: Instance, cols: number, rows: number, a: Color3, b: Color3, z: number?)
	for i = 0, cols - 1 do
		for j = 0, rows - 1 do
			frame(parent, {
				Name = "Sq",
				BackgroundColor3 = if (i + j) % 2 == 0 then a else b,
				Size = UDim2.fromScale(1 / cols, 1 / rows),
				Position = UDim2.fromScale(i / cols, j / rows),
				ZIndex = z or 1,
			})
		end
	end
end
RaceProps.Checker = checker

-- Drapeau à damier sur son mât
local function flag(parent: Instance, base: CFrame, height: number)
	part(parent, "FlagPole", Vector3.new(height, 0.3, 0.3), base * CFrame.new(0, height / 2, 0) * CFrame.Angles(0, 0, math.rad(90)), STEEL, M.Metal, "Cyl")
	part(parent, "FlagKnob", Vector3.new(0.5, 0.5, 0.5), base * CFrame.new(0, height + 0.2, 0), YELLOW, M.Metal, "Ball")
	local cloth, sg = canvas(parent, "Flag", Vector3.new(3.6, 2.4, 0.06), base * CFrame.new(1.95, height - 1.4, 0) * CFrame.Angles(0, 0, math.rad(-3)), Enum.NormalId.Front, 20)
	cloth.Transparency = 0
	cloth.Color = WHITE
	cloth.Material = M.Fabric
	checker(sg, 6, 4, INK, WHITE)
	backSide(parent, cloth, sg)
end

local function tyreStack(parent: Instance, base: CFrame, count: number, color: Color3?)
	for k = 0, count - 1 do
		local cf = base * CFrame.new(0, 0.55 + k * 1.02, 0) * CFrame.Angles(0, 0, math.rad(90))
		part(parent, "Tyre", Vector3.new(1, 2.6, 2.6), cf, DARK, M.Rubber, "Cyl")
		if k % 2 == 1 then
			part(parent, "TyreBand", Vector3.new(0.5, 2.62, 2.62), cf, color or RED, M.SmoothPlastic, "Cyl")
		end
	end
end

local function cone(parent: Instance, base: CFrame)
	part(parent, "ConeBase", Vector3.new(1.3, 0.16, 1.3), base * CFrame.new(0, 0.08, 0), rgb(255, 120, 40), M.SmoothPlastic)
	part(parent, "Cone", Vector3.new(1.3, 0.8, 0.8), base * CFrame.new(0, 0.55, 0) * CFrame.Angles(0, 0, math.rad(90)), rgb(255, 120, 40), M.SmoothPlastic, "Cyl")
	part(parent, "ConeTop", Vector3.new(0.9, 0.5, 0.5), base * CFrame.new(0, 1.2, 0) * CFrame.Angles(0, 0, math.rad(90)), WHITE, M.SmoothPlastic, "Cyl")
	part(parent, "ConeTip", Vector3.new(0.6, 0.3, 0.3), base * CFrame.new(0, 1.7, 0) * CFrame.Angles(0, 0, math.rad(90)), rgb(255, 120, 40), M.SmoothPlastic, "Cyl")
end

-- Bloc de feux de départ (boîtier + 2 feux rouges au-dessus, 2 verts en dessous)
local function lightPod(parent: Instance, cf: CFrame): { any }
	part(parent, "PodHousing", Vector3.new(1.5, 3.2, 0.9), cf, INK, M.SmoothPlastic)
	part(parent, "PodVisor", Vector3.new(1.6, 0.12, 0.5), cf * CFrame.new(0, 1.62, -0.55), INK, M.SmoothPlastic)
	local reds, greens = {}, {}
	for k, y in ipairs({ 0.95, 0.2, -0.55, -1.3 }) do
		local lamp = part(parent, if k <= 2 then "RedLamp" else "GreenLamp", Vector3.new(0.7, 0.7, 0.3), cf * CFrame.new(0, y, -0.46) * CFrame.Angles(0, math.rad(90), 0), rgb(70, 30, 34), M.SmoothPlastic, "Cyl")
		lamp.Size = Vector3.new(0.12, 0.7, 0.7)
		lamp.CFrame = cf * CFrame.new(0, y, -0.47) * CFrame.Angles(0, math.rad(90), 0)
		if k <= 2 then
			table.insert(reds, lamp)
		else
			lamp.Color = rgb(30, 60, 40)
			table.insert(greens, lamp)
		end
	end
	return { Red = reds, Green = greens }
end

----------------------------------------------------------------------
-- QG des courses
----------------------------------------------------------------------

-- cf : centre de la zone au sol (dessus du trottoir), -Z local = vers la route
function RaceProps.BuildHQ(cf: CFrame, w: number, d: number): (Model, { [string]: any })
	local model = Instance.new("Model")
	model.Name = "RaceHQ"
	local W, D = math.max(40, w - 2), math.max(30, d - 2)
	-- dalle (dessus à +0,3) avec bordure
	part(model, "Pad", Vector3.new(W, 0.8, D), cf * CFrame.new(0, -0.1, 0), ASPHALT, M.Asphalt).CastShadow = false
	part(model, "CurbFront", Vector3.new(W + 0.1, 0.58, 0.6), cf * CFrame.new(0, 0.05, -D / 2 + 0.26), CONCRETE, M.Concrete)
	-- marquages : places de stationnement + damier au sol (SurfaceGui sur pièces invisibles)
	-- (tourné d'un demi-tour : le texte se lit depuis la route)
	local _, marks = canvas(model, "Marks", Vector3.new(W - 2, 0.05, D - 2), cf * CFrame.new(0, 0.33, 0) * CFrame.Angles(0, math.pi, 0), Enum.NormalId.Top, 6)
	for k = 0, 5 do
		frame(marks, { Name = "Bay", BackgroundColor3 = WHITE, BackgroundTransparency = 0.15, Size = UDim2.new(0, 3, 0.36, 0), Position = UDim2.new(0.5 + k * 0.075, 0, 0.06, 0) })
	end
	local strip = frame(marks, { Name = "Checker", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 18), Position = UDim2.new(0, 0, 1, -18) })
	checker(strip, 30, 1, INK, WHITE)
	text(marks, { Name = "Paint", Text = "🏁 RACE HQ", TextColor3 = rgb(255, 214, 90), TextTransparency = 0.1, Size = UDim2.new(0.34, 0, 0.16, 0), Position = UDim2.new(0.06, 0, 0.1, 0), Rotation = 0 })

	-- STAND (au fond, à gauche) : 3 box, auvent rayé, enseigne
	local bx0, bx1 = -W / 2 + 2, W * 0.1
	local bw = bx1 - bx0
	local bz0 = D / 2 - 13
	local bh = 9
	local center = (bx0 + bx1) / 2
	part(model, "BackWall", Vector3.new(bw, bh, 0.8), cf * CFrame.new(center, bh / 2 + 0.3, D / 2 - 0.9), WHITE, M.Concrete)
	part(model, "SideL", Vector3.new(0.8, bh, 12), cf * CFrame.new(bx0 + 0.4, bh / 2 + 0.3, bz0 + 6), WHITE, M.Concrete)
	part(model, "SideR", Vector3.new(0.8, bh, 12), cf * CFrame.new(bx1 - 0.4, bh / 2 + 0.3, bz0 + 6), WHITE, M.Concrete)
	part(model, "Roof", Vector3.new(bw + 1.6, 0.8, 14.6), cf * CFrame.new(center, bh + 0.7, bz0 + 5.5), rgb(70, 72, 84), M.Metal)
	part(model, "Floor", Vector3.new(bw - 1.6, 0.2, 11.4), cf * CFrame.new(center, 0.4, bz0 + 6.2), rgb(150, 150, 156), M.Concrete).CastShadow = false
	-- 3 box : piliers + rideaux levés + intérieur (établis, pneus)
	for k = 0, 3 do
		local x = bx0 + 0.4 + k * (bw - 0.8) / 3
		part(model, "Pillar", Vector3.new(1, bh, 1), cf * CFrame.new(math.clamp(x, bx0 + 0.9, bx1 - 0.9), bh / 2 + 0.3, bz0 + 0.4), RED, M.SmoothPlastic)
	end
	for k = 0, 2 do
		local x = bx0 + 0.4 + (k + 0.5) * (bw - 0.8) / 3
		local doorW = (bw - 0.8) / 3 - 1.2
		part(model, "Shutter", Vector3.new(doorW, 1.4, 0.5), cf * CFrame.new(x, bh - 0.4, bz0 + 0.6), STEEL, M.DiamondPlate)
		part(model, "Bench", Vector3.new(doorW * 0.7, 2.4, 1.6), cf * CFrame.new(x, 1.5, D / 2 - 2.4), rgb(90, 96, 110), M.Metal)
		part(model, "BenchTop", Vector3.new(doorW * 0.72, 0.2, 1.7), cf * CFrame.new(x, 2.8, D / 2 - 2.4), rgb(176, 120, 70), M.Wood)
		part(model, "ToolBoard", Vector3.new(doorW * 0.7, 3, 0.2), cf * CFrame.new(x, 5.2, D / 2 - 1.4), rgb(64, 64, 76), M.SmoothPlastic)
		tyreStack(model, cf * CFrame.new(x + doorW * 0.36, 0.3, D / 2 - 5), 3, if k == 1 then YELLOW else RED)
	end
	-- auvent rayé
	for k = 0, 9 do
		local sx = bx0 + (k + 0.5) * bw / 10
		part(model, "Awning", Vector3.new(bw / 10, 0.2, 3.2), cf * CFrame.new(sx, bh - 0.9, bz0 - 1.3) * CFrame.Angles(math.rad(-16), 0, 0), if k % 2 == 0 then RED else WHITE, M.Fabric)
	end
	-- enseigne sur le toit
	local sign, sgs = canvas(model, "Sign", Vector3.new(bw * 0.8, 3.2, 0.4), cf * CFrame.new(center, bh + 2.9, bz0 + 0.4), Enum.NormalId.Front, 24)
	sign.Transparency = 0
	sign.Color = INK
	local signBg = frame(sgs, { Name = "Bg", BackgroundColor3 = INK, Size = UDim2.fromScale(1, 1) })
	local band = frame(signBg, { Name = "Band", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0.16, 0), Position = UDim2.fromScale(0, 0.84) })
	checker(band, 40, 2, INK, WHITE, 2)
	text(signBg, { Name = "Title", Text = "🏁 STREET RACES", TextColor3 = rgb(255, 214, 90), Size = UDim2.fromScale(0.92, 0.7), Position = UDim2.fromScale(0.04, 0.06), ZIndex = 3 })
	part(model, "SignPostL", Vector3.new(0.4, 1.6, 0.4), cf * CFrame.new(center - bw * 0.3, bh + 1.1, bz0 + 0.6), STEEL, M.Metal)
	part(model, "SignPostR", Vector3.new(0.4, 1.6, 0.4), cf * CFrame.new(center + bw * 0.3, bh + 1.1, bz0 + 0.6), STEEL, M.Metal)

	-- COMPTOIR d'inscription (devant le stand) : invite E
	local counterCf = cf * CFrame.new(center, 0, bz0 - 5)
	part(model, "Counter", Vector3.new(7, 3.4, 1.8), counterCf * CFrame.new(0, 2, 0), WHITE, M.SmoothPlastic)
	part(model, "CounterTop", Vector3.new(7.4, 0.25, 2.2), counterCf * CFrame.new(0, 3.82, 0), rgb(176, 120, 70), M.Wood)
	local _, face = canvas(model, "CounterFace", Vector3.new(6.6, 2.6, 0.05), counterCf * CFrame.new(0, 2.1, -0.93), Enum.NormalId.Front, 30)
	local fbg = frame(face, { Name = "Bg", BackgroundColor3 = RED, Size = UDim2.fromScale(1, 1) })
	local fb = frame(fbg, { Name = "Band", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0.22, 0), Position = UDim2.fromScale(0, 0.78) })
	checker(fb, 22, 2, INK, WHITE, 2)
	text(fbg, { Name = "T", Text = "SIGN UP · E", Size = UDim2.fromScale(0.9, 0.5), Position = UDim2.fromScale(0.05, 0.12), ZIndex = 3 })
	-- écran d'inscription sur le comptoir
	part(model, "ScreenStand", Vector3.new(0.3, 1.2, 0.3), counterCf * CFrame.new(1.8, 4.5, 0.3), DARK, M.Metal)
	local screen, ssg = canvas(model, "Screen", Vector3.new(2.6, 1.7, 0.2), counterCf * CFrame.new(1.8, 5.8, 0.3) * CFrame.Angles(math.rad(-10), 0, 0), Enum.NormalId.Front, 60)
	screen.Transparency = 0
	screen.Color = DARK
	local sbg = frame(ssg, { Name = "Bg", BackgroundColor3 = rgb(20, 24, 40), Size = UDim2.fromScale(1, 1) })
	text(sbg, { Name = "T", Text = "🏁 3 · 2 · 1 · GO", TextColor3 = CYAN, Size = UDim2.fromScale(0.9, 0.5), Position = UDim2.fromScale(0.05, 0.25) })
	local prompt = part(model, "PromptAnchor", Vector3.new(1, 1, 1), counterCf * CFrame.new(0, 3.5, -1.4), WHITE)
	prompt.Transparency = 1

	-- TABLEAU DES RECORDS (à droite) sur 2 poteaux, face à la route
	local boardCf = cf * CFrame.new(W * 0.3, 0, D / 2 - 6)
	local bW, bH = math.min(20, W * 0.34), 11
	part(model, "BoardPostL", Vector3.new(0.9, 7, 0.9), boardCf * CFrame.new(-bW / 2 + 1.5, 3.8, 0.5), STEEL, M.Metal)
	part(model, "BoardPostR", Vector3.new(0.9, 7, 0.9), boardCf * CFrame.new(bW / 2 - 1.5, 3.8, 0.5), STEEL, M.Metal)
	part(model, "BoardFrame", Vector3.new(bW + 0.8, bH + 0.8, 0.7), boardCf * CFrame.new(0, 6.8 + bH / 2, 0.55), INK, M.SmoothPlastic)
	local boardPart, boardGui = canvas(model, "Board", Vector3.new(bW, bH, 0.3), boardCf * CFrame.new(0, 6.8 + bH / 2, 0.1), Enum.NormalId.Front, 32)
	boardPart.Transparency = 0
	boardPart.Color = rgb(20, 22, 34)
	boardGui.LightInfluence = 0.3
	boardGui.MaxDistance = 260

	-- feux de départ décoratifs (arbre) près de la route
	local treeCf = cf * CFrame.new(W / 2 - 3, 0, -D / 2 + 3)
	part(model, "TreePole", Vector3.new(0.6, 7.5, 0.6), treeCf * CFrame.new(0, 3.9, 0), STEEL, M.Metal)
	local deco = {}
	for k = 0, 2 do
		table.insert(deco, lightPod(model, treeCf * CFrame.new(0, 6.4 - k * 0.2, 0) * CFrame.new((k - 1) * 1.6, 1.4, -0.5)))
	end
	-- podium 1-2-3
	local podCf = cf * CFrame.new(-W / 2 + 7, 0, -D / 2 + 7)
	for _, spec in ipairs({ { 0, 2.2, "1", YELLOW }, { -3.2, 1.5, "2", rgb(200, 206, 216) }, { 3.2, 1, "3", rgb(214, 150, 90) } }) do
		local step = part(model, "PodiumStep", Vector3.new(3.1, spec[2], 3), podCf * CFrame.new(spec[1], 0.3 + spec[2] / 2, 0), WHITE, M.SmoothPlastic)
		local _ = step
		local _, ng = canvas(model, "PodiumNum", Vector3.new(2.4, spec[2] * 0.8, 0.05), podCf * CFrame.new(spec[1], 0.3 + spec[2] / 2, -1.53), Enum.NormalId.Front, 40)
		text(ng, { Name = "N", Text = spec[3], TextColor3 = spec[4], Size = UDim2.fromScale(1, 1) })
	end
	-- pneus, cônes, drapeaux
	tyreStack(model, cf * CFrame.new(-W / 2 + 1.8, 0.3, -D / 2 + 1.8), 4)
	tyreStack(model, cf * CFrame.new(W / 2 - 1.8, 0.3, D / 2 - 1.8), 4, YELLOW)
	for k = 0, 4 do
		cone(model, cf * CFrame.new(-W * 0.2 + k * 4.2, 0.3, -D / 2 + 1.6))
	end
	flag(model, cf * CFrame.new(-W / 2 + 1, 0.3, -D / 2 + 4), 7)
	flag(model, cf * CFrame.new(W / 2 - 7, 0.3, -D / 2 + 1), 7)
	return model, { Prompt = prompt, Board = boardPart, BoardGui = boardGui, Screen = sbg, Deco = deco }
end

----------------------------------------------------------------------
-- Portique de départ / arche d'arrivée
----------------------------------------------------------------------

-- cf : centre de la ligne au sol (dessus de la chaussée), -Z = sens de la course
function RaceProps.BuildGantry(cf: CFrame, width: number, title: string, finish: boolean?): (Model, { [string]: any })
	local model = Instance.new("Model")
	model.Name = if finish then "RaceFinish" else "RaceGantry"
	local half = width / 2 + 1.6
	local H = 12.5
	for _, side in ipairs({ -1, 1 }) do
		local x = side * half
		part(model, "PillarBase", Vector3.new(2.6, 0.8, 2.6), cf * CFrame.new(x, 0.4, 0), CONCRETE, M.Concrete)
		part(model, "Pillar", Vector3.new(1.4, H, 1.4), cf * CFrame.new(x, H / 2 + 0.5, 0), if finish then WHITE else RED, M.SmoothPlastic)
		part(model, "PillarStripe", Vector3.new(1.46, 1.2, 1.46), cf * CFrame.new(x, 2.4, 0), YELLOW, M.SmoothPlastic)
		part(model, "PillarStripe", Vector3.new(1.46, 1.2, 1.46), cf * CFrame.new(x, 4.8, 0), YELLOW, M.SmoothPlastic)
	end
	-- poutre en treillis (2 membrures + diagonales)
	local span = half * 2 + 1.1
	part(model, "BeamTop", Vector3.new(span, 0.5, 1.2), cf * CFrame.new(0, H + 0.2, 0), STEEL, M.Metal)
	part(model, "BeamLow", Vector3.new(span, 0.5, 1.2), cf * CFrame.new(0, H - 1.9, 0), STEEL, M.Metal)
	local n = math.max(4, math.floor(span / 3))
	for k = 0, n - 1 do
		local x0 = -span / 2 + (k + 0.5) * span / n
		local ang = if k % 2 == 0 then math.rad(40) else math.rad(-40)
		part(model, "Diag", Vector3.new(0.25, 2.6, 0.25), cf * CFrame.new(x0, H - 0.85, 0) * CFrame.Angles(0, 0, ang), STEEL, M.Metal)
	end
	-- banderole (les deux faces)
	local bannerW = math.min(span - 4, 26)
	local banner, bsg = canvas(model, "Banner", Vector3.new(bannerW, 2.6, 0.2), cf * CFrame.new(0, H + 1.75, 0), Enum.NormalId.Front, 28)
	banner.Transparency = 0
	banner.Color = INK
	local bg = frame(bsg, { Name = "Bg", BackgroundColor3 = if finish then WHITE else INK, Size = UDim2.fromScale(1, 1) })
	if finish then
		checker(bg, 36, 4, INK, WHITE)
	else
		local l = frame(bg, { Name = "L", BackgroundTransparency = 1, Size = UDim2.new(0.12, 0, 1, 0) })
		checker(l, 3, 4, INK, WHITE, 2)
		local r = frame(bg, { Name = "R", BackgroundTransparency = 1, Size = UDim2.new(0.12, 0, 1, 0), Position = UDim2.fromScale(0.88, 0) })
		checker(r, 3, 4, INK, WHITE, 2)
		text(bg, { Name = "Title", Text = title, TextColor3 = rgb(255, 214, 90), Size = UDim2.fromScale(0.72, 0.8), Position = UDim2.fromScale(0.14, 0.1), ZIndex = 3 })
	end
	backSide(model, banner, bsg)
	-- feux de départ : 5 blocs sous la poutre (face à la grille : +Z)
	local lights = {}
	if not finish then
		for k = 1, 5 do
			local x = (k - 3) * 2.2
			part(model, "PodHanger", Vector3.new(0.2, 0.9, 0.2), cf * CFrame.new(x, H - 2.4, 0.9), INK, M.Metal)
			table.insert(lights, lightPod(model, cf * CFrame.new(x, H - 4.4, 1.2) * CFrame.Angles(0, math.pi, 0)))
		end
	end
	-- ligne au sol : damier (pièce invisible + SurfaceGui, 0,04 au-dessus de la chaussée)
	local _, line = canvas(model, "Line", Vector3.new(width, 0.05, 2.4), cf * CFrame.new(0, 0.16, 0), Enum.NormalId.Top, 10)
	checker(line, math.max(8, math.floor(width / 1.2)), 2, INK, WHITE)
	return model, { Lights = lights }
end

-- stage : 0 éteint, 1..5 = blocs rouges allumés, 6 = tous verts (GO)
function RaceProps.SetLights(lights: { any }, stage: number)
	for k, pod in ipairs(lights) do
		local red = stage >= 1 and stage <= 5 and k <= stage
		local green = stage >= 6
		for _, lamp in ipairs(pod.Red) do
			lamp.Color = if red then rgb(255, 50, 50) else rgb(70, 30, 34)
			lamp.Material = if red then M.Neon else M.SmoothPlastic
		end
		for _, lamp in ipairs(pod.Green) do
			lamp.Color = if green then rgb(80, 255, 120) else rgb(30, 60, 40)
			lamp.Material = if green then M.Neon else M.SmoothPlastic
		end
	end
end

-- Cases de la grille peintes au sol (une pièce invisible + SurfaceGui par case)
function RaceProps.GridMarks(parent: Instance, cfs: { CFrame })
	for k, cf in ipairs(cfs) do
		local _, sg = canvas(parent, "GridBox", Vector3.new(6.4, 0.05, 11), cf * CFrame.new(0, 0.16, 0), Enum.NormalId.Top, 8)
		local box = frame(sg, { Name = "Box", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) })
		frame(box, { Name = "Front", BackgroundColor3 = WHITE, Size = UDim2.new(1, 0, 0, 3) })
		frame(box, { Name = "L", BackgroundColor3 = WHITE, Size = UDim2.new(0, 3, 0.35, 0) })
		frame(box, { Name = "R", BackgroundColor3 = WHITE, Size = UDim2.new(0, 3, 0.35, 0), Position = UDim2.new(1, -3, 0, 0) })
		text(box, { Name = "N", Text = tostring(k), TextColor3 = WHITE, TextTransparency = 0.15, Size = UDim2.fromScale(0.5, 0.22), Position = UDim2.fromScale(0.25, 0.12) })
	end
end

----------------------------------------------------------------------
-- Arches de porte (gonflables)
----------------------------------------------------------------------

function RaceProps.BuildArch(cf: CFrame, width: number, index: number): Model
	local model = Instance.new("Model")
	model.Name = "RaceGate_" .. index
	local r = width / 2 + 1.2
	local rise = 9
	local seg = 11
	local tubeD = 2
	local parts = {}
	-- piliers
	for _, side in ipairs({ -1, 1 }) do
		local p = part(model, "Leg", Vector3.new(rise, tubeD, tubeD), cf * CFrame.new(side * r, rise / 2, 0) * CFrame.Angles(0, 0, math.rad(90)), PINK, M.SmoothPlastic, "Cyl")
		p:SetAttribute("BaseColor", p.Color)
		table.insert(parts, p)
		part(model, "Foot", Vector3.new(3, 0.6, 3), cf * CFrame.new(side * r, 0.3, 0), INK, M.Rubber)
	end
	-- arc (demi-ellipse aplatie au-dessus des piliers)
	local prev: Vector3? = nil
	for k = 0, seg do
		local a = math.pi * k / seg
		local p = (cf * CFrame.new(-math.cos(a) * r, rise + math.sin(a) * r * 0.45, 0)).Position
		if prev then
			local mid = (prev + p) / 2
			local len = (p - prev).Magnitude + 0.5
			local c = CFrame.lookAt(mid, p) * CFrame.Angles(0, math.rad(90), 0)
			local tube = part(model, "Tube", Vector3.new(len, tubeD, tubeD), c, if k % 2 == 0 then PINK else WHITE, M.SmoothPlastic, "Cyl")
			tube:SetAttribute("BaseColor", tube.Color)
			table.insert(parts, tube)
		end
		prev = p
	end
	-- panneau "n" au sommet
	local _, sg = canvas(model, "Num", Vector3.new(4, 2, 0.05), cf * CFrame.new(0, rise + r * 0.45 - 2.2, -0.2), Enum.NormalId.Front, 30)
	local lbl = text(sg, { Name = "N", Text = tostring(index), TextColor3 = WHITE, Size = UDim2.fromScale(1, 1) })
	local _ = lbl
	-- rideau lumineux (visible seulement pour la prochaine porte)
	local veil = part(model, "Veil", Vector3.new(r * 2 - tubeD, rise + r * 0.3, 0.1), cf * CFrame.new(0, (rise + r * 0.3) / 2, 0), CYAN, M.Neon)
	veil.Transparency = 0.88
	veil.CastShadow = false
	model:SetAttribute("GateIndex", index)
	return model
end

function RaceProps.SetGateState(model: Model, state: string)
	for _, d in ipairs(model:GetChildren()) do
		if d:IsA("BasePart") then
			if d.Name == "Veil" then
				d.Transparency = if state == "next" then 0.84 else 1
			elseif d.Name == "Tube" or d.Name == "Leg" then
				local base = d:GetAttribute("BaseColor")
				local color = if typeof(base) == "Color3" then base else PINK
				if state == "next" then
					d.Material = M.Neon
					d.Color = if d.Name == "Leg" then CYAN else color:Lerp(CYAN, 0.35)
				else
					d.Material = M.SmoothPlastic
					d.Color = color
				end
				d.Transparency = if state == "done" then 0.7 else 0
			end
		end
	end
end

return RaceProps
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="222">
          <Properties>
            <string name="Name">Reflections</string>
            <string name="Source"><![CDATA[--[[
	Reflections (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > Reflections

	v9.8 (REALISM98) 🪞 VRAIS miroirs (reflet plan) + reflets discrets.

	1) Miroirs. Contrat (RECIPES98 / CATALOG98) : dans le modèle d'un objet
	   miroir, une BasePart (bloc mince) nommée "Mirror", attributs
	   Mirror = true, MirrorFace = "Front" (face qui réfléchit ; sa normale
	   = LookVector, vers la pièce), MirrorShape = "Rect" | "Oval". Sa taille
	   X / Y = la surface qui réfléchit. Sans reflets : son verre statique
	   (Reflectance) reste visible = le repli.
	   Reflet "vivant" : une SurfaceGui sur la face du miroir, avec une
	   ViewportFrame qui filme un MONDE RÉFLÉCHI :
	     (SurfaceGui dans le PlayerGui, Adornee = "Mirror" : rien dans le Workspace)
	     - le décor proche (pièces de la maison / de la vue, devant le plan du
	       miroir, ≤ 36 studs, ≤ 650 pièces) cloné UNE fois et réfléchi par
	       rapport au plan (mis en cache, reconstruit si la pièce change) ;
	     - une copie légère du personnage local (Humanoid + vêtements, sans
	       scripts ni joints) dont les CFrame sont recopiées réfléchies à
	       chaque image (30 images / s au plus).
	   Mathématiques (vérifiées numériquement, voir le rapport REALISM98) :
	     plan : centre M, normale n, axes de la toile u (vers la droite vue
	     de face) et v (haut), u x v = n ;
	     réflexion d'un point : p' = p - 2 ((p - M) . n) n ;
	     réflexion d'un CFrame : position réfléchie, axes (-H X, H Y, H Z)
	     avec H = I - 2 n nᵀ (on retourne l'axe X local : rotation propre,
	     les blocs / boules / cylindres / pentes sont symétriques en X) ;
	     caméra de la ViewportFrame = position de la VRAIE caméra, qui
	     regarde -n (perpendiculaire au miroir : son plan image est
	     parallèle au miroir, donc la projection sur la face est affine) ;
	     la ViewportFrame est centrée sur le pied de la perpendiculaire
	     (cx, cy) = ((C - M) . u, (C - M) . v), de demi-taille
	     (|cx| + w/2, |cy| + h/2) dans le plan, et
	     FieldOfView = 2 atan(demi-hauteur / D), D = (C - M) . n ;
	     un cadre "Clip" (ClipsDescendants) la découpe à la taille du miroir.
	     Limites : FieldOfView ≤ 110° (très près : seule la partie autour du
	     pied est couverte, c'est aussi la seule visible), toile ≤ 2048 px
	     (densité réduite quand on regarde de très biais), en dessous de
	     6 px / stud le miroir repasse en verre statique.
	   v9.9 (REALISM99) — bug de la capture 28 (dalles sombres en biais,
	   morceaux flottants quand on lève la caméra) : les copies à cheval sur
	   le plan du miroir étaient copiées ENTIÈRES ; leur partie située
	   derrière la glace, une fois réfléchie, se retrouvait DEVANT elle (sol,
	   plafond, murs, dalles de la façade, cadre, tringles...). Désormais
	   chaque copie est coupée au plan (ClipToPlane) : rien n'est jamais entre
	   la caméra du reflet et la glace. Et le reflet est posé sur un ÉCRAN
	   OPAQUE (client, 0,04 stud devant la glace, disque pour les ovales) :
	   aucune autre SurfaceGui (papier peint à cœurs...) ni verre ne peut
	   plus se dessiner par-dessus.
	   Coût : 1 miroir vivant à la fois (2 en "Tout" + Détail élevé), le
	   plus grand à l'écran ; en pause s'il est caché, derrière un mur, de
	   dos ou à plus de 45 studs.
	2) Reflets "Tout" (Graphismes > Reflets = Tout) :
	   - écrans ("Screen" de House3DSetup / attribut Glossy) : voile de
	     verre discret (dégradé en diagonale qui glisse avec l'angle de vue),
	     10 écrans proches au plus ;
	   - sols des pièces ("Floor" des RoomShell / Room_<n>) : Reflectance légère
	     (bois 0,05, marbre / carrelage 0,1), remise à l'arrêt.

	API :
	  Reflections.Acquire(owner) / Reflections.Release(owner)   ("Town", "House3D"...)
	  Reflections.IsActive() -> boolean
	  Reflections.Live() -> { { Part, Gui, Viewport, World, Camera, View } }  (tests)
	  Fonctions pures (tests) :
	  Reflections.ReflectPoint(p, M, n) -> Vector3
	  Reflections.ReflectCFrame(cf, M, n) -> CFrame
	  Reflections.PlaneOf(part) -> Plane?
	  Reflections.ComputeView(cameraPosition, plane, pps) -> View?
	  Reflections.ProjectToCanvas(view, plane, worldPoint) -> Vector2?  (pixel de la toile)
	  Reflections.Extent(cf, size, center, n) -> (arrière, avant)          (v9.9)
	  Reflections.ClipToPlane(cf, size, shape, center, n) -> (cf?, size?)  (v9.9)
	  Reflections.ScreenCFrame(plane, oval) -> (CFrame, Vector3)            (v9.9)
	Aucun son. Rien n'est créé quand les reflets sont coupés.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GraphicsQuality = require(ReplicatedStorage.Shared.GraphicsQuality)

local Reflections = {}

local MAX_FOV = 110
local MAX_CANVAS = 2048
local BASE_PPS = 56
local MIN_PPS = 6
local STATIC_RADIUS = 36
local STATIC_MAX = 650
local LIVE_RANGE = 45
local FRAME_RATE = 1 / 30
local SELECT_EVERY = 0.25
local GLOSS_EVERY = 0.1
local GLOSS_RANGE = 40
local GLOSS_MAX = 10
local RENDER_NAME = "DopamineMirrors"
local GLASS_TINT = Color3.fromRGB(176, 192, 206)

----------------------------------------------------------------------
-- Mathématiques (pures)
----------------------------------------------------------------------

export type Plane = {
	Center: Vector3, -- centre de la face qui réfléchit
	U: Vector3, -- axe X de la toile (vers la droite, vu de face)
	V: Vector3, -- axe Y de la toile (vers le haut)
	N: Vector3, -- normale (vers la pièce)
	HalfW: number,
	HalfH: number,
}

export type View = {
	CameraCF: CFrame,
	FieldOfView: number,
	FramePos: Vector2, -- coin haut-gauche de la ViewportFrame (pixels de la toile)
	FrameSize: Vector2, -- taille de la ViewportFrame (pixels)
	PPS: number, -- pixels par stud de la toile
	D: number, -- distance caméra -> plan
	Foot: Vector2, -- pied de la perpendiculaire (studs, repère du miroir)
}

function Reflections.ReflectPoint(p: Vector3, center: Vector3, n: Vector3): Vector3
	return p - n * (2 * (p - center):Dot(n))
end

local function reflectVector(v: Vector3, n: Vector3): Vector3
	return v - n * (2 * v:Dot(n))
end

-- Réflexion d'un CFrame par un plan : rotation PROPRE (axe X local retourné)
function Reflections.ReflectCFrame(cf: CFrame, center: Vector3, n: Vector3): CFrame
	local p = Reflections.ReflectPoint(cf.Position, center, n)
	local x = -reflectVector(cf.RightVector, n)
	local y = reflectVector(cf.UpVector, n)
	local z = reflectVector(-cf.LookVector, n)
	return CFrame.fromMatrix(p, x, y, z)
end

-- Face qui réfléchit d'une pièce "Mirror" (Front par défaut)
function Reflections.PlaneOf(part: BasePart): Plane?
	local face = part:GetAttribute("MirrorFace")
	local cf, size = part.CFrame, part.Size
	local up = cf.UpVector
	local n: Vector3, w: number, offset: number
	if face == nil or face == "Front" then
		n, w, offset = cf.LookVector, size.X, size.Z / 2
	elseif face == "Back" then
		n, w, offset = -cf.LookVector, size.X, size.Z / 2
	elseif face == "Left" then
		n, w, offset = -cf.RightVector, size.Z, size.X / 2
	elseif face == "Right" then
		n, w, offset = cf.RightVector, size.Z, size.X / 2
	else
		return nil
	end
	-- axe X de la toile d'une SurfaceGui sur une face de côté : haut x normale
	local u = up:Cross(n)
	return {
		Center = cf.Position + n * offset,
		U = u,
		V = up,
		N = n,
		HalfW = w / 2,
		HalfH = size.Y / 2,
	}
end

-- Caméra + cadre de la ViewportFrame pour une caméra à `camPos`
function Reflections.ComputeView(camPos: Vector3, plane: Plane, pps: number?): View?
	local rel = camPos - plane.Center
	local d = rel:Dot(plane.N)
	if d < 0.05 then
		return nil -- derrière le miroir (ou collé dessus)
	end
	local cx, cy = rel:Dot(plane.U), rel:Dot(plane.V)
	local hx = math.abs(cx) + plane.HalfW
	local hy = math.abs(cy) + plane.HalfH
	-- champ vertical limité : très près, on ne couvre que l'entour du pied
	local maxHalf = d * math.tan(math.rad(MAX_FOV / 2))
	hy = math.min(hy, maxHalf)
	hx = math.min(hx, maxHalf * 8, hy * 8)
	hy = math.max(hy, hx / 8)
	local density = math.min(pps or BASE_PPS, MAX_CANVAS / (2 * hx), MAX_CANVAS / (2 * hy))
	if density < MIN_PPS then
		return nil -- trop de biais : verre statique
	end
	local fov = math.deg(2 * math.atan(hy / d))
	return {
		CameraCF = CFrame.fromMatrix(camPos, plane.U, plane.V, plane.N),
		FieldOfView = fov,
		FramePos = Vector2.new((cx - hx + plane.HalfW) * density, (plane.HalfH - (cy + hy)) * density),
		FrameSize = Vector2.new(2 * hx * density, 2 * hy * density),
		PPS = density,
		D = d,
		Foot = Vector2.new(cx, cy),
	}
end

-- Où un point du MONDE RÉFLÉCHI (ex. une copie réfléchie) apparaît sur la
-- toile du miroir, d'après la projection de la caméra de la ViewportFrame
-- (même formule que Roblox : champ vertical, rapport largeur / hauteur du cadre)
function Reflections.ProjectToCanvas(view: View, _plane: Plane, worldPoint: Vector3): Vector2?
	local rel = view.CameraCF:PointToObjectSpace(worldPoint)
	local depth = -rel.Z
	if depth <= 1e-6 then
		return nil
	end
	local t = math.tan(math.rad(view.FieldOfView) / 2)
	local aspect = view.FrameSize.X / view.FrameSize.Y
	local ndcX = rel.X / (depth * t * aspect)
	local ndcY = rel.Y / (depth * t)
	return Vector2.new(view.FramePos.X + (ndcX + 1) / 2 * view.FrameSize.X, view.FramePos.Y + (1 - ndcY) / 2 * view.FrameSize.Y)
end

----------------------------------------------------------------------
-- Registre (miroirs, écrans, sols) : DescendantAdded filtré par nom
----------------------------------------------------------------------

type Live = {
	Part: BasePart,
	Plane: Plane,
	Gui: SurfaceGui,
	Clip: GuiObject,
	Viewport: ViewportFrame,
	World: WorldModel,
	Camera: Camera,
	Static: Model,
	Screen: BasePart,
	Oval: boolean,
	StaticClipped: number,
	StaticBuilt: number,
	StaticDirty: boolean,
	StaticCount: number,
	Scope: Instance?,
	ScopeConns: { RBXScriptConnection },
	CharModel: Model?,
	CharSource: Model?,
	CharPairs: { { Src: BasePart, Dst: BasePart } },
	CharCount: number,
	PPS: number,
	View: View?,
	Visible: boolean,
	LastCam: CFrame?,
}

local owners: { [string]: boolean } = {}
local active = false
local mirrors: { [BasePart]: boolean } = {}
local screens: { [BasePart]: boolean } = {}
local floors: { [BasePart]: boolean } = {}
local floorSaved: { [BasePart]: number } = {}
local sheens: { [BasePart]: { Gui: SurfaceGui, Gradient: UIGradient } } = {}
local lives: { [BasePart]: Live } = {}
local addedConn: RBXScriptConnection? = nil
local qualityConn: any = nil
local selectClock = 0
local frameClock = 0
local glossClock = 0
local glossOn = false
local floorsDirty = false

-- Les SurfaceGui (miroirs, voiles) vont dans le PlayerGui avec Adornee = la
-- pièce (comme LiveProps) : les copies réfléchies ne sont JAMAIS dans le
-- Workspace (ni dans le modèle de l'objet : audits, LiveProps, rayons...)
local function guiParent(part: BasePart): Instance
	local player = Players.LocalPlayer
	local playerGui = player and player:FindFirstChildOfClass("PlayerGui")
	return playerGui or part
end

-- (v9.9 REALISM99) ÉCRAN du miroir vivant : une plaque OPAQUE (client, dans
-- la caméra : ni rayons ni collisions) posée 0,04 stud devant la glace, qui
-- porte la SurfaceGui. Elle écrit la profondeur : rien de ce qui est
-- derrière (papier peint à motifs en SurfaceGui, verre, pièce "Mirror"
-- invisible des miroirs ovales) ne peut plus se dessiner PAR-DESSUS le
-- reflet (les SurfaceGui ne se trient pas entre elles). Ovale : disque
-- elliptique (cylindre) ; cachée dès que le miroir n'est plus vivant.
local SCREEN_GAP = 0.04
local SCREEN_T = 0.02
local screenFolder: Instance? = nil

local function screenParent(): Instance
	local cam = workspace.CurrentCamera
	local folder = screenFolder
	if folder and folder.Parent ~= nil and folder.Parent == (cam or workspace) then
		return folder
	end
	local f = Instance.new("Folder")
	f.Name = "DopamineMirrorScreens"
	f.Parent = cam or workspace
	screenFolder = f
	return f
end

-- Place / taille de l'écran d'après le plan du miroir (pur : tests)
function Reflections.ScreenCFrame(plane: Plane, oval: boolean): (CFrame, Vector3)
	local pos = plane.Center + plane.N * (SCREEN_GAP + SCREEN_T / 2)
	if oval then
		-- cylindre : axe X = normale (face Right = la glace)
		return CFrame.fromMatrix(pos, plane.N, plane.V), Vector3.new(SCREEN_T, plane.HalfH * 2, plane.HalfW * 2)
	end
	-- bloc : face Front (LookVector) = normale ; axe X de la toile = U
	return CFrame.fromMatrix(pos, -plane.U, plane.V, -plane.N), Vector3.new(plane.HalfW * 2, plane.HalfH * 2, SCREEN_T)
end

local function newScreen(plane: Plane, oval: boolean): BasePart
	local screen = Instance.new("Part")
	screen.Name = "MirrorScreen"
	screen.Anchored = true
	screen.CanCollide = false
	screen.CanQuery = false
	screen.CanTouch = false
	screen.CastShadow = false
	screen.Material = Enum.Material.SmoothPlastic
	screen.Color = GLASS_TINT
	screen.TopSurface = Enum.SurfaceType.Smooth
	screen.BottomSurface = Enum.SurfaceType.Smooth
	if oval then
		screen.Shape = Enum.PartType.Cylinder
	end
	local cf, size = Reflections.ScreenCFrame(plane, oval)
	screen.Size = size
	screen.CFrame = cf
	screen.Transparency = 1
	screen:SetAttribute("MirrorScreen", true)
	screen.Parent = screenParent()
	return screen
end

local function consider(d: Instance)
	if not d:IsA("BasePart") then
		return
	end
	local name = d.Name
	if name == "Mirror" then
		if d:GetAttribute("Mirror") == true then
			mirrors[d] = true
		end
	elseif name == "Screen" or d:GetAttribute("Glossy") == true then
		screens[d] = true
	elseif name == "Floor" then
		local parent = d.Parent
		-- (coque "RoomShell" ; renommée "Room_<n>" par HouseBuilder en ville)
		if parent and (parent.Name == "RoomShell" or string.match(parent.Name, "^Room_%d+$") ~= nil) then
			floors[d] = true
			floorsDirty = true -- (pièce construite pendant que les reflets sont actifs)
		end
	end
end

local function scanAll()
	for _, d in ipairs(workspace:GetDescendants()) do
		consider(d)
	end
end

----------------------------------------------------------------------
-- Copies réfléchies
----------------------------------------------------------------------

local KEEP_CHILD: { [string]: boolean } = {
	SpecialMesh = true,
	BlockMesh = true,
	CylinderMesh = true,
	Decal = true,
	Texture = true,
	SurfaceAppearance = true,
}

-- Copie d'une pièce : seulement ce qui se voit (maillage, décalque, apparence)
local function cloneVisual(part: BasePart): BasePart?
	local ok, copy = pcall(function()
		return part:Clone()
	end)
	if not ok or copy == nil then
		return nil
	end
	local c = copy :: BasePart
	for _, child in ipairs(c:GetChildren()) do
		if not KEEP_CHILD[child.ClassName] then
			child:Destroy()
		end
	end
	c.Anchored = true
	c.CanCollide = false
	c.CanQuery = false
	c.CanTouch = false
	c.CastShadow = false
	for name in pairs(c:GetAttributes()) do
		c:SetAttribute(name, nil)
	end
	return c
end

-- Racine de la zone à copier : la maison (Interiors + Exterior : le mur de
-- façade d'une pièce est dans Exterior), sinon l'enfant du Workspace
local function scopeOf(part: BasePart): Instance?
	local node: Instance? = part.Parent
	local top: Instance? = nil
	while node and node ~= workspace do
		if node.Name == "Interiors" then
			return node.Parent or node
		end
		top = node
		node = node.Parent
	end
	return top
end

local function characterOf(inst: Instance): boolean
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		if character and inst:IsDescendantOf(character) then
			return true
		end
	end
	return false
end

-- Étendue d'une pièce le long de la normale du plan : (arrière, avant)
-- en studs signés (> 0 = devant le miroir, côté pièce)
function Reflections.Extent(cf: CFrame, size: Vector3, center: Vector3, n: Vector3): (number, number)
	local nLocal = cf:VectorToObjectSpace(n)
	local reach = math.abs(nLocal.X) * size.X / 2 + math.abs(nLocal.Y) * size.Y / 2 + math.abs(nLocal.Z) * size.Z / 2
	local c = (cf.Position - center):Dot(n)
	return c - reach, c + reach
end

--[[
	(v9.9 REALISM99) CAUSE du bug de la capture 28 : un vrai miroir plan ne
	montre QUE ce qui est devant lui. La v9.8 copiait toute pièce qui
	dépassait un peu devant le plan (sol, plafond, murs latéraux, plinthes,
	dalles et toit de la façade, tringles, cadre du miroir...) EN ENTIER :
	une fois réfléchie, leur partie située DERRIÈRE le miroir (dans le mur,
	la pièce voisine, dehors : jusqu'à 25 studs) passait DEVANT le plan,
	entre la caméra du reflet et la glace : grandes dalles sombres en biais
	et morceaux flottants par-dessus le reflet, surtout caméra levée / de
	biais / miroir posé loin du mur (80 copies fautives sur 650 dans la
	scène de test). Roblox n'a pas de plan de coupe pour la caméra d'une
	ViewportFrame : on COUPE donc chaque copie au plan du miroir.
	ClipToPlane(cf, size, shape, center, n) -> (cf, size)? :
	  - entièrement devant : inchangée ;
	  - entièrement derrière : nil ;
	  - à cheval : bloc (ou cylindre coupé le long de son axe) dont un axe
	    local est parallèle à la normale -> raccourci pour s'arrêter au plan ;
	    autre forme : gardée seulement si elle ne dépasse derrière que d'un
	    rien (≤ SLIVER), sinon écartée.
]]
local SLIVER = 0.06
local AXIS_EPS = 0.999
function Reflections.ClipToPlane(cf: CFrame, size: Vector3, shape: string, center: Vector3, n: Vector3): (CFrame?, Vector3?)
	local back, front = Reflections.Extent(cf, size, center, n)
	if front <= 0.01 then
		return nil, nil
	end
	if back >= -SLIVER then
		return cf, size
	end
	-- axe local parallèle à la normale ?
	local nLocal = cf:VectorToObjectSpace(n)
	local ax, ay, az = math.abs(nLocal.X), math.abs(nLocal.Y), math.abs(nLocal.Z)
	local axis: string? = nil
	if ax >= AXIS_EPS then
		axis = "X"
	elseif ay >= AXIS_EPS then
		axis = "Y"
	elseif az >= AXIS_EPS then
		axis = "Z"
	end
	local clippable = shape == "Block" or (shape == "Cylinder" and axis == "X")
	if not axis or not clippable then
		return nil, nil
	end
	-- on garde la face avant ; longueur L le long de l'axe telle que
	-- l'arrière de la boîte (axe presque parallèle : on tient compte du
	-- léger biais des 2 autres axes) s'arrête AU plan
	local e: Vector3, a: number, old: number, other: number
	if axis == "X" then
		e, a, old, other = cf.RightVector, ax, size.X, ay * size.Y / 2 + az * size.Z / 2
	elseif axis == "Y" then
		e, a, old, other = cf.UpVector, ay, size.Y, ax * size.X / 2 + az * size.Z / 2
	else
		e, a, old, other = -cf.LookVector, az, size.Z, ax * size.X / 2 + ay * size.Y / 2
	end
	local keep = (front - 2 * other) / a
	if keep < 0.02 then
		return nil, nil
	end
	keep = math.min(keep, old)
	local newSize = Vector3.new(axis == "X" and keep or size.X, axis == "Y" and keep or size.Y, axis == "Z" and keep or size.Z)
	local toward = if e:Dot(n) >= 0 then e else -e
	return cf + toward * ((old - keep) / 2), newSize
end

-- Forme "coupable" d'une copie (bloc simple ; les maillages spéciaux non)
local function shapeOf(part: BasePart): string
	if part:FindFirstChildOfClass("SpecialMesh") or part:FindFirstChildOfClass("CylinderMesh") then
		return "Mesh"
	end
	if part.ClassName == "Part" then
		local shape = (part :: Part).Shape
		if shape == Enum.PartType.Block then
			return "Block"
		elseif shape == Enum.PartType.Cylinder then
			return "Cylinder"
		end
		return "Round"
	end
	if part:IsA("SpawnLocation") or part.ClassName == "Seat" then
		return "Block"
	end
	return part.ClassName
end

local function buildStatic(live: Live)
	live.Static:ClearAllChildren()
	local scope = live.Scope
	if not scope or scope.Parent == nil then
		live.StaticCount = 0
		return
	end
	local plane = live.Plane
	local candidates: { { Part: BasePart, Dist: number, CF: CFrame, Size: Vector3 } } = {}
	local r2 = STATIC_RADIUS * STATIC_RADIUS
	local clipped = 0
	for _, d in ipairs(scope:GetDescendants()) do
		-- (v9.9 : ni voilages / vitres presque transparents, ni anneaux de tringle : budget)
		if d:IsA("BasePart") and d ~= live.Part and d.Transparency < 0.6 and d:GetAttribute("Mirror") ~= true
			and d:GetAttribute("MirrorScreen") ~= true and d.Name ~= "CurtainRing" then
			local offset = d.Position - plane.Center
			-- (grandes pièces : sol, plafond, murs -> distance au bord de la boîte)
			local size = d.Size
			local radius = math.max(size.X, size.Y, size.Z) / 2
			local dist = math.max(0, offset.Magnitude - radius)
			if dist * dist <= r2 and not characterOf(d) then
				-- (v9.9) coupée au plan du miroir : rien ne passe devant la glace
				local cf, cut = Reflections.ClipToPlane(d.CFrame, size, shapeOf(d), plane.Center, plane.N)
				if cf and cut then
					if cut ~= size then
						clipped += 1
					end
					table.insert(candidates, { Part = d, Dist = dist, CF = cf, Size = cut })
				end
			end
		end
	end
	table.sort(candidates, function(a, b)
		return a.Dist < b.Dist
	end)
	local count = 0
	for _, entry in ipairs(candidates) do
		if count >= STATIC_MAX then
			break
		end
		local copy = cloneVisual(entry.Part)
		if copy then
			copy.Size = entry.Size
			copy.CFrame = Reflections.ReflectCFrame(entry.CF, plane.Center, plane.N)
			copy.Parent = live.Static
			count += 1
		end
	end
	live.StaticCount = count
	live.StaticClipped = clipped
	live.StaticBuilt = os.clock()
	live.StaticDirty = false
end

local function watchScope(live: Live)
	for _, conn in ipairs(live.ScopeConns) do
		conn:Disconnect()
	end
	table.clear(live.ScopeConns)
	local scope = live.Scope
	if not scope then
		return
	end
	local function touched(d: Instance)
		if d:IsA("BasePart") and d.Parent ~= nil then
			if (d.Position - live.Plane.Center).Magnitude <= STATIC_RADIUS + 20 then
				live.StaticDirty = true
			end
		elseif d:IsA("BasePart") then
			live.StaticDirty = true
		end
	end
	table.insert(live.ScopeConns, scope.DescendantAdded:Connect(touched))
	table.insert(live.ScopeConns, scope.DescendantRemoving:Connect(function(d)
		if d:IsA("BasePart") then
			live.StaticDirty = true
		end
	end))
end

-- Copie légère du personnage local (Humanoid + vêtements, sans scripts / joints)
local function buildCharacter(live: Live)
	if live.CharModel then
		live.CharModel:Destroy()
		live.CharModel = nil
	end
	table.clear(live.CharPairs)
	live.CharSource = nil
	live.CharCount = 0
	local character = Players.LocalPlayer and Players.LocalPlayer.Character
	if not character then
		return
	end
	local archivable = character.Archivable
	character.Archivable = true
	local ok, copy = pcall(function()
		return character:Clone()
	end)
	character.Archivable = archivable
	if not ok or copy == nil then
		return
	end
	-- paires source / copie : parcours parallèle AVANT de nettoyer
	local function pair(src: Instance, dst: Instance)
		local a, b = src:GetChildren(), dst:GetChildren()
		if #a ~= #b then
			return
		end
		for i = 1, #a do
			if a[i].Name == b[i].Name then
				if a[i]:IsA("BasePart") and b[i]:IsA("BasePart") then
					table.insert(live.CharPairs, { Src = a[i] :: BasePart, Dst = b[i] :: BasePart })
				end
				pair(a[i], b[i])
			end
		end
	end
	pair(character, copy)
	for _, d in ipairs(copy:GetDescendants()) do
		if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Sound") or d:IsA("JointInstance") or d:IsA("Constraint")
			or d:IsA("WeldConstraint") or d:IsA("Animator") or d:IsA("ForceField") or d:IsA("ProximityPrompt")
			or d:IsA("BillboardGui") or d:IsA("ParticleEmitter") or d:IsA("Light") then
			pcall(d.Destroy, d)
		elseif d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
		elseif d:IsA("Humanoid") then
			pcall(function()
				d.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
				d.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
			end)
		end
	end
	copy.Name = "Reflection"
	copy.Parent = live.World
	live.CharModel = copy
	live.CharSource = character
	live.CharCount = #character:GetDescendants()
end

local function updateCharacter(live: Live)
	local character = Players.LocalPlayer and Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local near = root and root:IsA("BasePart") and (root.Position - live.Plane.Center).Magnitude < STATIC_RADIUS
		and (root.Position - live.Plane.Center):Dot(live.Plane.N) > -1
	if not near then
		if live.CharModel then
			live.CharModel:Destroy()
			live.CharModel = nil
			table.clear(live.CharPairs)
		end
		return
	end
	if live.CharSource ~= character or live.CharModel == nil or (character and #character:GetDescendants() ~= live.CharCount) then
		buildCharacter(live)
	end
	local plane = live.Plane
	local parts, cframes = {}, {}
	for _, p in ipairs(live.CharPairs) do
		if p.Src.Parent then
			table.insert(parts, p.Dst)
			table.insert(cframes, Reflections.ReflectCFrame(p.Src.CFrame, plane.Center, plane.N))
		end
	end
	if #parts > 0 then
		local ok = pcall(function()
			live.World:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
		end)
		if not ok then
			for i, part in ipairs(parts) do
				part.CFrame = cframes[i]
			end
		end
	end
end

----------------------------------------------------------------------
-- Miroirs vivants
----------------------------------------------------------------------

local function newLive(part: BasePart, plane: Plane): Live
	local oval = part:GetAttribute("MirrorShape") == "Oval"
	local screen = newScreen(plane, oval)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "DopamineMirror"
	-- (v9.9) sur l'écran opaque : face Front (bloc) / Right (disque ovale)
	gui.Face = oval and Enum.NormalId.Right or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = BASE_PPS
	gui.LightInfluence = 0
	gui.Brightness = 1
	gui.MaxDistance = LIVE_RANGE + 15
	gui.ClipsDescendants = true
	gui.ZOffset = 1
	gui.Adornee = screen
	-- (ovale : un CanvasGroup arrondi découpe la ViewportFrame en ellipse ;
	-- un simple Frame + UICorner ne découpe PAS ses enfants dans Roblox)
	local clip: GuiObject
	if oval then
		clip = Instance.new("CanvasGroup")
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = clip
	else
		clip = Instance.new("Frame")
		clip.ClipsDescendants = true
	end
	clip.Name = "Clip"
	clip.Size = UDim2.fromScale(1, 1)
	clip.BackgroundColor3 = GLASS_TINT
	clip.BackgroundTransparency = oval and 1 or 0
	clip.BorderSizePixel = 0
	clip.Parent = gui
	local viewport = Instance.new("ViewportFrame")
	viewport.Name = "Reflection"
	viewport.BackgroundTransparency = 1
	viewport.BorderSizePixel = 0
	viewport.ImageColor3 = Color3.fromRGB(236, 242, 248) -- verre légèrement froid
	viewport.Parent = clip
	local camera = Instance.new("Camera")
	camera.Name = "MirrorCamera"
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	local world = Instance.new("WorldModel")
	world.Name = "World"
	world.Parent = viewport
	local static = Instance.new("Model")
	static.Name = "Static"
	static.Parent = world
	-- voile de verre (reflet diagonal très discret)
	local sheen = Instance.new("Frame")
	sheen.Name = "Sheen"
	sheen.Size = UDim2.fromScale(1, 1)
	sheen.BackgroundColor3 = Color3.new(1, 1, 1)
	sheen.BorderSizePixel = 0
	sheen.ZIndex = 3
	sheen.Parent = clip
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 28
	gradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.34, 0.97),
		NumberSequenceKeypoint.new(0.46, 0.9),
		NumberSequenceKeypoint.new(0.56, 0.95),
		NumberSequenceKeypoint.new(1, 1),
	})
	gradient.Parent = sheen
	gui.Parent = guiParent(screen)
	local live: Live = {
		Part = part,
		Plane = plane,
		Gui = gui,
		Clip = clip,
		Viewport = viewport,
		World = world,
		Camera = camera,
		Static = static,
		Screen = screen,
		Oval = oval,
		StaticClipped = 0,
		StaticBuilt = 0,
		StaticDirty = true,
		StaticCount = 0,
		Scope = scopeOf(part),
		ScopeConns = {},
		CharModel = nil,
		CharSource = nil,
		CharPairs = {},
		CharCount = 0,
		PPS = BASE_PPS,
		View = nil,
		Visible = true,
		LastCam = nil,
	}
	watchScope(live)
	return live
end

local function dropLive(live: Live)
	for _, conn in ipairs(live.ScopeConns) do
		conn:Disconnect()
	end
	table.clear(live.ScopeConns)
	pcall(live.Gui.Destroy, live.Gui)
	pcall(live.Screen.Destroy, live.Screen)
	lives[live.Part] = nil
end

-- Éclairage de la ViewportFrame (pas d'ombres ni de lampes : ambiance du lieu)
local function lightViewport(live: Live)
	local ambient = Lighting.Ambient
	local bright = math.clamp(Lighting.Brightness / 2, 0.35, 1.1)
	local base = Color3.new(math.min(1, ambient.R * 1.7 + 0.28), math.min(1, ambient.G * 1.7 + 0.28), math.min(1, ambient.B * 1.7 + 0.3))
	live.Viewport.Ambient = base
	live.Viewport.LightColor = Color3.new(0.62 * bright, 0.6 * bright, 0.57 * bright)
	live.Viewport.LightDirection = Vector3.new(-0.35, -1, -0.45)
end

-- Reflet affiché (écran opaque + SurfaceGui) ou caché (verre statique)
local function setShown(live: Live, shown: boolean)
	live.Gui.Enabled = shown
	local t = shown and 0 or 1
	if live.Screen.Transparency ~= t then
		live.Screen.Transparency = t
	end
end

local function updateLive(live: Live, camCF: CFrame)
	local part = live.Part
	local plane = Reflections.PlaneOf(part)
	if not plane then
		setShown(live, false)
		return
	end
	-- (le miroir a bougé : copies à refaire, écran replacé)
	if (plane.Center - live.Plane.Center).Magnitude > 0.01 or plane.N:Dot(live.Plane.N) < 0.9999
		or math.abs(plane.HalfW - live.Plane.HalfW) > 0.01 or math.abs(plane.HalfH - live.Plane.HalfH) > 0.01 then
		live.Plane = plane
		live.StaticDirty = true
		local cf, size = Reflections.ScreenCFrame(plane, live.Oval)
		live.Screen.Size = size
		live.Screen.CFrame = cf
	end
	if live.Screen.Parent == nil then
		live.Screen.Parent = screenParent()
	end
	if live.StaticDirty and os.clock() - live.StaticBuilt > 0.5 then
		buildStatic(live)
		lightViewport(live)
	end
	local view = Reflections.ComputeView(camCF.Position, live.Plane, BASE_PPS)
	if not view then
		setShown(live, false)
		live.View = nil
		return
	end
	-- densité de la toile : par paliers (évite de tout remettre en page à chaque image)
	local pps = view.PPS
	if math.abs(pps - live.PPS) / live.PPS > 0.15 then
		live.PPS = pps
		live.Gui.PixelsPerStud = pps
	end
	-- recalcul avec la densité retenue (cadre en pixels de CETTE toile)
	local fitted = Reflections.ComputeView(camCF.Position, live.Plane, live.PPS)
	if fitted and fitted.PPS < live.PPS - 1e-6 then
		live.PPS = fitted.PPS
		live.Gui.PixelsPerStud = fitted.PPS
	end
	view = fitted or view
	live.View = view
	setShown(live, true)
	live.Viewport.Position = UDim2.fromOffset(view.FramePos.X, view.FramePos.Y)
	live.Viewport.Size = UDim2.fromOffset(view.FrameSize.X, view.FrameSize.Y)
	live.Camera.FieldOfView = view.FieldOfView
	live.Camera.CFrame = view.CameraCF
	updateCharacter(live)
end

-- Le miroir est-il visible (devant, à l'écran, pas derrière un mur) ?
local function visibleScore(part: BasePart, cam: Camera, occlusion: boolean): number
	if part.Parent == nil then
		return -1
	end
	local plane = Reflections.PlaneOf(part)
	if not plane then
		return -1
	end
	local camPos = cam.CFrame.Position
	local rel = camPos - plane.Center
	local dist = rel.Magnitude
	local d = rel:Dot(plane.N)
	if d < 0.1 or dist > LIVE_RANGE then
		return -1
	end
	local onScreen = false
	for _, corner in ipairs({ Vector2.new(0, 0), Vector2.new(-1, -1), Vector2.new(1, -1), Vector2.new(-1, 1), Vector2.new(1, 1) }) do
		local p = plane.Center + plane.U * (corner.X * plane.HalfW) + plane.V * (corner.Y * plane.HalfH)
		local ok, screen, inView = pcall(function()
			return cam:WorldToViewportPoint(p)
		end)
		if ok and inView and screen.Z > 0 then
			local size = cam.ViewportSize
			if screen.X >= -20 and screen.Y >= -20 and screen.X <= size.X + 20 and screen.Y <= size.Y + 20 then
				onScreen = true
				break
			end
		end
	end
	if not onScreen then
		return -1
	end
	if occlusion then
		local ok, hit = pcall(function()
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			local list: { Instance } = {}
			local character = Players.LocalPlayer and Players.LocalPlayer.Character
			if character then
				table.insert(list, character)
			end
			local item = part.Parent
			if item then
				table.insert(list, item)
			end
			local weather = workspace:FindFirstChild("DopamineWeather")
			if weather then
				table.insert(list, weather)
			end
			params.FilterDescendantsInstances = list
			return workspace:Raycast(camPos, (plane.Center - camPos) * 0.97, params)
		end)
		if ok and hit and hit.Instance:IsA("BasePart") and hit.Instance.Transparency < 0.6 then
			return -1
		end
	end
	-- grand à l'écran = prioritaire
	return (plane.HalfW * plane.HalfH) * (d / dist) / (dist * dist + 1)
end

local function selectMirrors(cam: Camera)
	local q = GraphicsQuality.Get()
	local want: { { Part: BasePart, Score: number } } = {}
	if q.MaxMirrors > 0 then
		for part in pairs(mirrors) do
			if part.Parent == nil then
				mirrors[part] = nil
			else
				local score = visibleScore(part, cam, true)
				if score > 0 then
					table.insert(want, { Part = part, Score = score })
				end
			end
		end
		table.sort(want, function(a, b)
			return a.Score > b.Score
		end)
	end
	local keep: { [BasePart]: boolean } = {}
	for i = 1, math.min(q.MaxMirrors, #want) do
		keep[want[i].Part] = true
	end
	for part, live in pairs(lives) do
		if not keep[part] then
			dropLive(live)
		end
	end
	for part in pairs(keep) do
		if not lives[part] then
			local plane = Reflections.PlaneOf(part)
			if plane then
				local live = newLive(part, plane)
				lives[part] = live
				buildStatic(live)
				lightViewport(live)
			end
		end
	end
end

----------------------------------------------------------------------
-- Reflets "Tout" : écrans (voile de verre) + sols des pièces
----------------------------------------------------------------------

local FLOOR_GLOSS: { [Enum.Material]: number } = {
	[Enum.Material.Wood] = 0.05,
	[Enum.Material.WoodPlanks] = 0.05,
	[Enum.Material.Marble] = 0.1,
	[Enum.Material.Granite] = 0.1,
	[Enum.Material.Slate] = 0.08,
	[Enum.Material.SmoothPlastic] = 0.08,
	[Enum.Material.Plastic] = 0.06,
	[Enum.Material.Glass] = 0.1,
	[Enum.Material.Concrete] = 0.04,
}

local function setFloors(on: boolean)
	if on then
		for part in pairs(floors) do
			if part.Parent == nil then
				floors[part] = nil
			else
				local gloss = FLOOR_GLOSS[part.Material]
				if gloss then
					if floorSaved[part] == nil then
						floorSaved[part] = tonumber(part.Reflectance) or 0
					end
					part.Reflectance = math.max(floorSaved[part], gloss)
				end
			end
		end
	else
		for part, reflectance in pairs(floorSaved) do
			if part.Parent then
				part.Reflectance = reflectance
			end
		end
		table.clear(floorSaved)
	end
end

local function removeSheen(part: BasePart)
	local sheen = sheens[part]
	if sheen then
		pcall(sheen.Gui.Destroy, sheen.Gui)
		sheens[part] = nil
	end
end

local function addSheen(part: BasePart)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "DopamineSheen"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 20
	gui.LightInfluence = 0
	gui.ZOffset = 4
	gui.MaxDistance = GLOSS_RANGE + 10
	gui.Adornee = part
	local frame = Instance.new("Frame")
	frame.Name = "Sheen"
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Color3.new(1, 1, 1)
	frame.BorderSizePixel = 0
	frame.Active = false
	frame.Parent = gui
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 24
	gradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.3, 0.97),
		NumberSequenceKeypoint.new(0.42, 0.91),
		NumberSequenceKeypoint.new(0.5, 0.94),
		NumberSequenceKeypoint.new(0.62, 0.985),
		NumberSequenceKeypoint.new(1, 1),
	})
	gradient.Parent = frame
	gui.Parent = guiParent(part)
	sheens[part] = { Gui = gui, Gradient = gradient }
end

local function stepGloss(cam: Camera)
	local q = GraphicsQuality.Get()
	local on = q.Reflections == "All"
	if on ~= glossOn then
		glossOn = on
		setFloors(on)
		if not on then
			for part in pairs(sheens) do
				removeSheen(part)
			end
		end
	end
	if not on then
		return
	end
	if floorsDirty then
		floorsDirty = false
		setFloors(true)
	end
	local camCF = cam.CFrame
	local camPos = camCF.Position
	local near: { { Part: BasePart, Dist: number } } = {}
	for part in pairs(screens) do
		if part.Parent == nil then
			screens[part] = nil
			removeSheen(part)
		else
			local rel = camPos - part.Position
			local dist = rel.Magnitude
			if dist < GLOSS_RANGE and rel:Dot(part.CFrame.LookVector) > 0 then
				table.insert(near, { Part = part, Dist = dist })
			end
		end
	end
	table.sort(near, function(a, b)
		return a.Dist < b.Dist
	end)
	local keep: { [BasePart]: boolean } = {}
	for i = 1, math.min(GLOSS_MAX, #near) do
		keep[near[i].Part] = true
	end
	for part in pairs(sheens) do
		if not keep[part] then
			removeSheen(part)
		end
	end
	for part in pairs(keep) do
		if not sheens[part] then
			addSheen(part)
		end
		-- le reflet glisse avec l'angle de vue (parallaxe douce)
		local sheen = sheens[part]
		if sheen then
			local toCam = (camPos - part.Position).Unit
			local side = toCam:Dot(part.CFrame.RightVector)
			local vertical = toCam:Dot(part.CFrame.UpVector)
			sheen.Gradient.Offset = Vector2.new(math.clamp(-side * 0.45, -0.45, 0.45), math.clamp(vertical * 0.25, -0.25, 0.25))
		end
	end
end

----------------------------------------------------------------------
-- Boucle (après la caméra : BindToRenderStep, priorité Last + 5)
----------------------------------------------------------------------

local function step(dt: number)
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	selectClock += dt
	if selectClock >= SELECT_EVERY then
		selectClock = 0
		local ok, err = pcall(selectMirrors, cam)
		if not ok then
			warn("[Reflections] " .. tostring(err))
		end
	end
	glossClock += dt
	if glossClock >= GLOSS_EVERY then
		glossClock = 0
		pcall(stepGloss, cam)
	end
	frameClock += dt
	if frameClock < FRAME_RATE then
		return
	end
	frameClock = 0
	local camCF = cam.CFrame
	for _, live in pairs(lives) do
		if live.Part.Parent == nil then
			dropLive(live)
		else
			local ok, err = pcall(updateLive, live, camCF)
			if not ok then
				warn("[Reflections] " .. tostring(err))
				pcall(setShown, live, false)
			end
		end
	end
end

local function start()
	if active then
		return
	end
	active = true
	selectClock, frameClock, glossClock = SELECT_EVERY, FRAME_RATE, GLOSS_EVERY
	scanAll()
	addedConn = workspace.DescendantAdded:Connect(consider)
	qualityConn = GraphicsQuality.Changed:Connect(function()
		selectClock = SELECT_EVERY
		glossClock = GLOSS_EVERY
	end)
	RunService:BindToRenderStep(RENDER_NAME, Enum.RenderPriority.Last.Value + 5, step)
end

local function stop()
	if not active then
		return
	end
	active = false
	pcall(function()
		RunService:UnbindFromRenderStep(RENDER_NAME)
	end)
	if addedConn then
		addedConn:Disconnect()
		addedConn = nil
	end
	if qualityConn then
		qualityConn:Disconnect()
		qualityConn = nil
	end
	for _, live in pairs(lives) do
		dropLive(live)
	end
	for part in pairs(sheens) do
		removeSheen(part)
	end
	setFloors(false)
	glossOn = false
	if screenFolder then
		pcall(screenFolder.Destroy, screenFolder)
		screenFolder = nil
	end
	table.clear(mirrors)
	table.clear(screens)
	table.clear(floors)
end

-- Plusieurs "propriétaires" (la ville, la vue 🧊 3D d'une pièce...) : actif
-- tant qu'au moins un le demande
function Reflections.Acquire(owner: string)
	owners[owner] = true
	start()
end

function Reflections.Release(owner: string)
	owners[owner] = nil
	if next(owners) == nil then
		stop()
	end
end

function Reflections.IsActive(): boolean
	return active
end

-- (tests / rendus) miroirs vivants
function Reflections.Live(): { any }
	local list = {}
	for _, live in pairs(lives) do
		table.insert(list, live)
	end
	return list
end

-- (tests / rendus) une passe complète tout de suite (sélection + images)
function Reflections.ForceStep()
	selectClock, frameClock, glossClock = SELECT_EVERY, FRAME_RATE, GLOSS_EVERY
	step(0)
end

-- (tests) compteurs
function Reflections.Counts(): { [string]: number }
	local n = { Mirrors = 0, Screens = 0, Floors = 0, Live = 0, Sheens = 0, FloorsGlossy = 0, Clipped = 0 }
	for _ in pairs(mirrors) do
		n.Mirrors += 1
	end
	for _ in pairs(screens) do
		n.Screens += 1
	end
	for _ in pairs(floors) do
		n.Floors += 1
	end
	for _, live in pairs(lives) do
		n.Live += 1
		n.Clipped += live.StaticClipped
	end
	for _ in pairs(sheens) do
		n.Sheens += 1
	end
	for _ in pairs(floorSaved) do
		n.FloorsGlossy += 1
	end
	return n
end

return Reflections
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="223">
          <Properties>
            <string name="Name">ShopInteriors</string>
            <string name="Source"><![CDATA[--[[
	ShopInteriors (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > ShopInteriors

	🛍️ Dopamine Town (v9.6, SHOPS96) : l'INTÉRIEUR des boutiques où l'on
	entre, construit côté client (les modèles 3D des objets n'existent que
	côté client : House3DRecipes.BuildItem ; voitures : CarModels.Build).
	Le serveur a posé les coques (TownShops) dans DopamineTown.Shops, avec
	les attributs ShopId, InteriorCF, InteriorSize, DoorCF…
	  - FLUX à deux niveaux autour de l'avatar :
	      1. "Vitrine" (≤ 150 studs) : habillage (sol, murs, plafond,
	         lambris), estrades des vitrines et leurs 2 objets (vus depuis la
	         place) ; à la concession, les 8 voitures sur leurs plateaux ;
	      2. "Complet" (≤ 60 studs, gardé jusqu'à 100) : étagères, estrades,
	         comptoir + caisse + vendeur·se, enseigne, suspensions (2 VRAIES
	         lumières douces, allumées seulement quand on est dedans), déco
	         du métier, TOUS les objets exposés avec leur étiquette de prix
	         (BillboardGui, visible à ≤ 16 studs : icône, nom, prix, verrou,
	         exemplaires possédés) et une invite "Acheter — 🧠 prix" ; au
	         comptoir, l'invite "🛍️ Voir tout" ouvre le catalogue (ShopUI).
	    3 boutiques complètes au plus (les plus proches) ; construction
	    étalée : UNE boutique à la fois, quelques pièces par image (budget
	    de temps), jamais de création / destruction par image ensuite.
	  - portes vitrées coulissantes : s'ouvrent quand un avatar approche ;
	  - achat : ShopUI.Purchase (serveur House "buyItem" / Car "buy") ;
	    réussi -> petite pluie d'étincelles sur l'objet, étiquette à jour.
	Choix des objets exposés : chaque boutique a des emplacements (étagères,
	estrades, murs) ; s'il y a plus d'objets que de places, on en prend un
	échantillon régulier du moins cher au plus cher (le catalogue du
	comptoir montre TOUT). Taille réelle (WorldLayout.PX) réduite si
	besoin pour tenir dans l'emplacement.

	API (TownClient, via optionalModule) :
	  ShopInteriors.Start({ Toast = fn(text, color?) }?)   à l'entrée en ville
	  ShopInteriors.Step(position: Vector3)                 flux (4 fois / s)
	  ShopInteriors.Stop()                                  à la sortie
	  ShopInteriors.Debug() -> table                        (tests / rendus)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local Locale = require(ReplicatedStorage.Shared.Locale)
local WorldLayout = require(ReplicatedStorage.Shared.WorldLayout)
local HouseCommon = require(Client.Components.House.HouseCommon)
local ShopUI = require(script.Parent.ShopUI)

local ShopInteriors = {}

local M = Enum.Material
local rgb = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)
local INK = rgb(92, 58, 96)

local FOLDER_NAME = "TownShopInteriors"
local FRONT_RANGE, FRONT_DROP = 150, 190 -- vitrine
local FULL_RANGE, FULL_DROP = 60, 100 -- intérieur complet
local MAX_FULL = 3
local STEP_BUDGET = 0.004 -- (s) de construction par image
local STEP_EVERY = 0.25
local DOOR_RANGE = 10
local TAG_DISTANCE = 16
local PROMPT_DISTANCE = 5.5
local PX = WorldLayout.PX
local GAP = 0.05 -- (studs) entre deux faces parallèles : jamais de faces confondues

----------------------------------------------------------------------
-- Thèmes (couleurs, matières, disposition des murs de côté)
----------------------------------------------------------------------

type Theme = {
	Floor: Color3,
	FloorMat: Enum.Material,
	Wall: Color3,
	Wainscot: Color3,
	Ceiling: Color3,
	Shelf: Color3,
	ShelfMat: Enum.Material,
	Back: Color3,
	Podium: Color3,
	Accent: Color3,
	Lamp: Color3,
	Sides: string, -- "Shelves" | "Platforms"
	Keeper: Color3,
}

local THEMES: { [string]: Theme } = {
	Pets = { Floor = rgb(226, 196, 160), FloorMat = M.WoodPlanks, Wall = rgb(255, 246, 232), Wainscot = rgb(150, 212, 190), Ceiling = rgb(255, 252, 246),
		Shelf = rgb(222, 184, 140), ShelfMat = M.Wood, Back = rgb(196, 236, 220), Podium = rgb(255, 222, 200), Accent = rgb(86, 176, 150), Lamp = rgb(255, 238, 204),
		Sides = "Shelves", Keeper = rgb(96, 186, 156) },
	Toys = { Floor = rgb(255, 232, 196), FloorMat = M.SmoothPlastic, Wall = rgb(255, 244, 250), Wainscot = rgb(255, 176, 196), Ceiling = rgb(255, 252, 255),
		Shelf = rgb(255, 255, 255), ShelfMat = M.SmoothPlastic, Back = rgb(200, 226, 255), Podium = rgb(255, 214, 120), Accent = rgb(236, 104, 140),
		Lamp = rgb(255, 240, 214), Sides = "Shelves", Keeper = rgb(255, 150, 90) },
	Kitchen = { Floor = rgb(250, 246, 240), FloorMat = M.Marble, Wall = rgb(255, 242, 240), Wainscot = rgb(236, 130, 146), Ceiling = rgb(255, 252, 250),
		Shelf = rgb(246, 240, 234), ShelfMat = M.SmoothPlastic, Back = rgb(214, 242, 230), Podium = rgb(214, 170, 124), Accent = rgb(214, 90, 110),
		Lamp = rgb(255, 238, 210), Sides = "Shelves", Keeper = rgb(236, 112, 132) },
	Furniture = { Floor = rgb(198, 152, 110), FloorMat = M.WoodPlanks, Wall = rgb(246, 238, 226), Wainscot = rgb(176, 150, 124), Ceiling = rgb(255, 252, 246),
		Shelf = rgb(160, 116, 84), ShelfMat = M.Wood, Back = rgb(236, 222, 204), Podium = rgb(236, 226, 214), Accent = rgb(160, 116, 84), Lamp = rgb(255, 232, 196),
		Sides = "Platforms", Keeper = rgb(190, 146, 108) },
	Setup = { Floor = rgb(64, 60, 84), FloorMat = M.SmoothPlastic, Wall = rgb(96, 90, 128), Wainscot = rgb(58, 54, 80), Ceiling = rgb(70, 66, 92),
		Shelf = rgb(48, 46, 62), ShelfMat = M.Metal, Back = rgb(120, 110, 170), Podium = rgb(46, 44, 60), Accent = rgb(120, 214, 250), Lamp = rgb(214, 226, 255),
		Sides = "Platforms", Keeper = rgb(106, 90, 210) },
	Garden = { Floor = rgb(206, 140, 108), FloorMat = M.Slate, Wall = rgb(236, 248, 228), Wainscot = rgb(120, 180, 110), Ceiling = rgb(248, 255, 244),
		Shelf = rgb(186, 140, 96), ShelfMat = M.WoodPlanks, Back = rgb(206, 236, 196), Podium = rgb(170, 120, 86), Accent = rgb(84, 160, 96), Lamp = rgb(255, 246, 210),
		Sides = "Shelves", Keeper = rgb(126, 192, 112) },
	Cars = { Floor = rgb(240, 240, 246), FloorMat = M.Marble, Wall = rgb(246, 246, 250), Wainscot = rgb(70, 74, 92), Ceiling = rgb(250, 250, 252),
		Shelf = rgb(70, 74, 92), ShelfMat = M.Metal, Back = rgb(236, 72, 120), Podium = rgb(250, 250, 252), Accent = rgb(236, 72, 120), Lamp = rgb(246, 248, 255),
		Sides = "Shelves", Keeper = rgb(236, 72, 120) },
}

----------------------------------------------------------------------
-- Pièces
----------------------------------------------------------------------

local function newPart(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, solid: boolean?, className: string?): BasePart
	local p = Instance.new((className or "Part") :: any) :: BasePart
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = solid == true
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Parent = parent
	return p
end

-- Boîte entre deux coins dans le repère F (x, y, z)
local function box(parent: Instance, name: string, F: CFrame, x0: number, x1: number, y0: number, y1: number, z0: number, z1: number, color: Color3, material: Enum.Material?, solid: boolean?): BasePart
	return newPart(parent, name, Vector3.new(math.abs(x1 - x0), math.abs(y1 - y0), math.abs(z1 - z0)), F * CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2), color, material, solid)
end

local function cylinder(parent: Instance, name: string, F: CFrame, x: number, y0: number, z: number, height: number, diameter: number, color: Color3, material: Enum.Material?, solid: boolean?): BasePart
	local p = newPart(parent, name, Vector3.new(height, diameter, diameter), F * CFrame.new(x, y0 + height / 2, z) * CFrame.Angles(0, 0, math.rad(90)), color, material, solid)
	;(p :: Part).Shape = Enum.PartType.Cylinder
	return p
end

local function ball(parent: Instance, name: string, F: CFrame, x: number, y: number, z: number, diameter: number, color: Color3, material: Enum.Material?): BasePart
	local p = newPart(parent, name, Vector3.new(diameter, diameter, diameter), F * CFrame.new(x, y, z), color, material)
	;(p :: Part).Shape = Enum.PartType.Ball
	return p
end

-- Panneau texte (SurfaceGui, face avant = -Z du panneau)
local function sign(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, text: string, textColor: Color3, pps: number): BasePart
	local board = newPart(parent, name, size, cf, color, M.SmoothPlastic)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Sign"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pps
	gui.LightInfluence = 0.3
	gui.Brightness = 1
	gui.MaxDistance = 90
	gui.Parent = board
	local l = Instance.new("TextLabel")
	l.Name = "Text"
	l.BackgroundTransparency = 1
	l.Size = UDim2.fromScale(0.9, 0.8)
	l.Position = UDim2.fromScale(0.05, 0.1)
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.Text = text
	l.TextColor3 = textColor
	l.Parent = gui
	return board
end

----------------------------------------------------------------------
-- Modèles 3D (paresseux : l'intérieur marche sans eux)
----------------------------------------------------------------------

local recipes: any = nil
local function Recipes(): any
	if recipes == nil then
		local module = Client.Components.House:FindFirstChild("House3DRecipes")
		local ok, result = false, nil
		if module then
			ok, result = pcall(require, module)
		end
		recipes = ok and result or false
	end
	return recipes or nil
end

local function optional(parent: Instance, name: string): any?
	local module = parent:FindFirstChild(name)
	if not module then
		return nil
	end
	local ok, result = pcall(require, module)
	return ok and type(result) == "table" and result or nil
end

----------------------------------------------------------------------
-- État
----------------------------------------------------------------------

type Slot = {
	CF: CFrame, -- sol de l'emplacement, LookVector = vers le visiteur
	MaxW: number,
	MaxH: number,
	MaxD: number,
	Kind: string, -- "Window" | "Podium" | "Platform" | "Shelf" | "Wall" | "Car"
	Tag: CFrame, -- étiquette (face vers le visiteur)
	WallZ: number?, -- (étagère) distance du fond depuis le centre de l'emplacement
}

type Display = {
	Entry: ShopUI.Entry,
	Model: Model?,
	Tag: BasePart?,
	Billboard: BillboardGui?,
	Prompt: ProximityPrompt?,
	Labels: { [string]: TextLabel },
	Key: string,
	Live: any?,
	SlotKind: string?,
}

type Door = { Part: BasePart, Closed: CFrame, Open: CFrame, IsOpen: boolean }

type Shop = {
	Model: Model,
	Id: string,
	Kind: string,
	Theme: Theme,
	InteriorCF: CFrame,
	Size: Vector3,
	DoorCF: CFrame,
	F: CFrame, -- repère : sol, milieu de la face intérieure de la façade, +Z vers le fond
	Level: number, -- 0 rien, 1 vitrine, 2 complet
	Tiers: { [number]: Folder },
	Jobs: { () -> () }?,
	Building: number, -- niveau en construction (0 = rien)
	Plan: any?,
	Displays: { Display },
	Lights: { Light },
	LightsOn: boolean,
	Doors: { Door },
	Counter: Vector3?,
}

local started = false
local shops: { Shop } = {}
local folder: Folder? = nil
local conns: { any } = {}
local clock = 0
local dirty = false
local focus: Vector3? = nil
local stats = { Built = 0, Destroyed = 0, Items = 0, Purchases = 0 }

----------------------------------------------------------------------
-- Emplacements (repère F de la boutique)
----------------------------------------------------------------------

-- Face vers +X (mur gauche vu de la porte... côté x < 0), -X, ou la porte (-Z)
local FACE_DOOR = CFrame.new()
local FACE_PX = CFrame.Angles(0, -math.pi / 2, 0) -- LookVector = +X
local FACE_NX = CFrame.Angles(0, math.pi / 2, 0) -- LookVector = -X

type Plan = {
	Window: { Slot },
	Podium: { Slot },
	Platform: { Slot },
	Wall: { Slot },
	Shelf: { Slot },
	ShelfUnits: { { CF: CFrame, L: number, Dp: number, H: number, Levels: { number } } },
	PodiumSpots: { { X: number, Z: number } },
	Platforms: { { CF: CFrame, W: number, Dp: number } },
}

local SHELF_DEPTH = 2.3
local SHELF_H = 8.6
local SHELF_LEVELS = { 0.55, 3.25, 5.95 } -- dessus des planches
local SHELF_CLEAR = 2.35 -- hauteur libre au-dessus d'une planche

-- Étagère murale : `cf` = milieu de la FACE AVANT au sol, LookVector vers
-- le visiteur ; renvoie ses emplacements
local function shelfSlots(plan: Plan, cf: CFrame, length: number, perLevel: number)
	table.insert(plan.ShelfUnits, { CF = cf, L = length, Dp = SHELF_DEPTH, H = SHELF_H, Levels = SHELF_LEVELS })
	local inner = length - 0.5
	local w = inner / perLevel
	for _, y in ipairs(SHELF_LEVELS) do
		for i = 1, perLevel do
			local x = -inner / 2 + (i - 0.5) * w
			-- (repère de l'étagère : -Z = vers le visiteur ; fond à +SHELF_DEPTH)
			local centerZ = (SHELF_DEPTH - 0.25) / 2
			table.insert(plan.Shelf, {
				CF = cf * CFrame.new(x, y, centerZ),
				MaxW = w - 0.35,
				MaxH = SHELF_CLEAR - 0.15,
				MaxD = SHELF_DEPTH - 0.45,
				Kind = "Shelf",
				Tag = cf * CFrame.new(x, y - 0.2, -0.12),
				WallZ = SHELF_DEPTH - 0.25 - centerZ - GAP,
			})
		end
	end
end

local function makePlan(shop: Shop): Plan
	local W, D = shop.Size.X, shop.Size.Z
	local hw = W / 2
	local F = shop.F
	local plan: Plan = { Window = {}, Podium = {}, Platform = {}, Wall = {}, Shelf = {}, ShelfUnits = {}, PodiumSpots = {}, Platforms = {} }
	-- vitrines : estrades derrière les deux grandes vitres (vues de la place)
	for _, sx in ipairs({ -1, 1 }) do
		local x = sx * 8.55
		table.insert(plan.Window, { CF = F * CFrame.new(x, 1.72, 2.1), MaxW = 7, MaxH = 7, MaxD = 3, Kind = "Window", Tag = F * CFrame.new(x, 1.5, 0.35) })
	end
	-- estrades au centre : 4 de part et d'autre de l'allée, ou 2 dans l'axe
	-- quand les murs de côté ont des estrades "salon"
	local spots = shop.Theme.Sides == "Platforms" and { { 0, 8.6 }, { 0, 14.4 } } or { { -6.2, 8.4 }, { 6.2, 8.4 }, { -6.2, 14.2 }, { 6.2, 14.2 } }
	for _, spot in ipairs(spots) do
		local x, z = spot[1], spot[2]
		table.insert(plan.PodiumSpots, { X = x, Z = z })
		table.insert(plan.Podium, { CF = F * CFrame.new(x, 0.7, z), MaxW = 4.6, MaxH = 7.2, MaxD = 4.6, Kind = "Podium",
			Tag = F * CFrame.new(x, 0.45, z - 2.56) })
	end
	-- fond : deux étagères de part et d'autre du comptoir (devant le lambris)
	local back = hw - 0.45
	for _, sx in ipairs({ -1, 1 }) do
		shelfSlots(plan, F * CFrame.new(sx * (back - 4.2), 0, D - 0.35 - SHELF_DEPTH) * FACE_DOOR, 8.4, 2)
	end
	-- murs de côté : étagères, ou estrades "salon" + objets muraux au-dessus
	local z0, z1 = 3.4, D - 3.2
	for _, sx in ipairs({ -1, 1 }) do
		local face = sx < 0 and FACE_PX or FACE_NX
		local wallX = sx * back -- (devant la cimaise)
		if shop.Theme.Sides == "Platforms" then
			local n = 3
			local len = (z1 - z0) / n
			for i = 1, n do
				local z = z0 + (i - 0.5) * len
				local depth = 3.8
				local cf = F * CFrame.new(wallX - sx * depth / 2, 0, z) * face
				table.insert(plan.Platforms, { CF = cf, W = len - 0.4, Dp = depth })
				table.insert(plan.Platform, { CF = cf * CFrame.new(0, 0.58, 0), MaxW = len - 0.8, MaxH = 5.4, MaxD = depth - 0.5, Kind = "Platform",
					Tag = cf * CFrame.new(0, 0.3, -depth / 2 - 0.08) })
				-- objet mural au-dessus (pivot contre le mur), étiquette sous lui
				local wallCF = F * CFrame.new(sx * (hw - 0.2), 6.1, z) * face
				table.insert(plan.Wall, { CF = wallCF, MaxW = len - 1.2, MaxH = 3.4, MaxD = 1.5, Kind = "Wall", Tag = wallCF * CFrame.new(0, -0.45, -0.1) })
			end
		else
			local cf = F * CFrame.new(wallX - sx * SHELF_DEPTH, 0, (z0 + z1) / 2) * face
			shelfSlots(plan, cf, z1 - z0, 4)
		end
	end
	return plan
end

-- Échantillon régulier de `k` éléments (du premier au dernier)
local function spread<T>(list: { T }, k: number): { T }
	local n = #list
	if n <= k then
		return table.clone(list)
	end
	local out = {}
	if k <= 0 then
		return out
	end
	if k == 1 then
		out[1] = list[math.ceil(n / 2)]
		return out
	end
	for i = 1, k do
		out[i] = list[math.floor(1 + (i - 1) * (n - 1) / (k - 1) + 0.5)]
	end
	return out
end

-- Qui va où : { { Slot, Entry } }
local function assign(shop: Shop, plan: Plan): { { Slot: Slot, Entry: ShopUI.Entry } }
	local big, wall, small = {}, {}, {}
	for _, entry in ipairs(ShopUI.ShopEntries(shop.Id)) do
		if entry.Kind == "Item" then
			local item = entry.Def
			if item.Placement == "Wall" then
				table.insert(wall, entry)
			elseif (tonumber(item.Size) or 80) >= 100 and not HouseCommon.CanGoOnFurniture(item) then
				table.insert(big, entry)
			else
				table.insert(small, entry)
			end
		end
	end
	local result = {}
	local used: { [ShopUI.Entry]: boolean } = {}
	local function place(slots: { Slot }, pool: { ShopUI.Entry })
		local free = {}
		for _, entry in ipairs(pool) do
			if not used[entry] then
				table.insert(free, entry)
			end
		end
		local chosen = spread(free, #slots)
		for i, entry in ipairs(chosen) do
			used[entry] = true
			table.insert(result, { Slot = slots[i], Entry = entry })
		end
	end
	-- vitrines : deux beaux gros objets (milieu et haut de gamme)
	if #big >= 2 then
		local a, b = big[math.max(1, math.floor(#big * 0.4 + 0.5))], big[math.max(1, math.floor(#big * 0.8 + 0.5))]
		if a ~= b then
			used[a], used[b] = true, true
			table.insert(result, { Slot = plan.Window[1], Entry = a })
			table.insert(result, { Slot = plan.Window[2], Entry = b })
		end
	end
	place(plan.Podium, big)
	place(plan.Platform, big)
	place(plan.Wall, wall)
	-- étagères : petits objets + objets muraux restants, puis gros objets en
	-- miniature s'il reste de la place ; rangés du moins cher au plus cher
	local shelfPool = {}
	for _, list in ipairs({ small, wall }) do
		for _, entry in ipairs(list) do
			if not used[entry] then
				table.insert(shelfPool, entry)
			end
		end
	end
	local rest = #plan.Shelf - #shelfPool
	if rest > 0 then
		local freeBig = {}
		for _, entry in ipairs(big) do
			if not used[entry] then
				table.insert(freeBig, entry)
			end
		end
		for _, entry in ipairs(spread(freeBig, rest)) do
			table.insert(shelfPool, entry)
		end
	end
	local picked = spread(shelfPool, #plan.Shelf)
	local price: { [ShopUI.Entry]: number } = {}
	for i, entry in ipairs(picked) do
		price[entry] = (tonumber(entry.Def.Cost) or 0) + i * 1e-6
	end
	table.sort(picked, function(a, b)
		return price[a] < price[b]
	end)
	-- (répartis sur TOUTES les étagères, pas entassés au début)
	local indices = {}
	for i = 1, #plan.Shelf do
		indices[i] = i
	end
	local slotIndex = spread(indices, #picked)
	for i, entry in ipairs(picked) do
		table.insert(result, { Slot = plan.Shelf[slotIndex[i]], Entry = entry })
	end
	return result
end

----------------------------------------------------------------------
-- Étiquettes + invites
----------------------------------------------------------------------

local function promptText(entry: ShopUI.Entry): string
	if ShopUI.LockText(entry) then
		return "🔒 " .. Locale.T("Locked")
	end
	if entry.Kind == "Car" and ShopUI.Owned(entry) > 0 then
		return ShopUI.IsSelected(entry) and Locale.T("✅ Selected") or Locale.T("🚗 Choose")
	end
	if ShopUI.IsMaxed(entry) then
		return "✅ " .. Locale.T("Already yours!")
	end
	return Locale.T("Buy — 🧠 %s", ShopUI.Format(ShopUI.Price(entry)))
end

local function refreshDisplay(d: Display)
	local entry = d.Entry
	local lock = ShopUI.LockText(entry)
	local owned = ShopUI.Owned(entry)
	local labels = d.Labels
	if labels.Price then
		if lock then
			labels.Price.Text = "🔒 " .. lock
			labels.Price.TextColor3 = rgb(130, 100, 200)
		elseif ShopUI.IsMaxed(entry) and entry.Kind ~= "Item" then
			labels.Price.Text = "✅ " .. Locale.T("Already yours!")
			labels.Price.TextColor3 = rgb(40, 160, 110)
		else
			labels.Price.Text = "🧠 " .. ShopUI.Format(ShopUI.Price(entry))
			labels.Price.TextColor3 = HouseCommon.Dopamine() >= ShopUI.Price(entry) and rgb(236, 72, 140) or rgb(210, 120, 80)
		end
	end
	if labels.Owned then
		labels.Owned.Visible = owned > 0 and entry.Kind == "Item"
		labels.Owned.Text = "x" .. tostring(owned)
	end
	if d.Prompt then
		d.Prompt.ActionText = promptText(entry)
	end
end

local function buyDisplay(d: Display)
	local entry = d.Entry
	if entry.Kind == "Car" and ShopUI.Owned(entry) > 0 and ShopUI.LockText(entry) == nil then
		ShopUI.SelectCar(entry)
		return
	end
	local ok = ShopUI.Purchase(entry)
	if ok then
		stats.Purchases += 1
		local tag = d.Tag
		if tag and tag.Parent then
			local sparkle = Instance.new("ParticleEmitter")
			sparkle.Name = "Bought"
			sparkle.Color = ColorSequence.new(rgb(255, 150, 200), rgb(255, 230, 120))
			sparkle.LightEmission = 0.2
			sparkle.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) })
			sparkle.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
			sparkle.Lifetime = NumberRange.new(0.6, 1.1)
			sparkle.Speed = NumberRange.new(4, 8)
			sparkle.SpreadAngle = Vector2.new(60, 60)
			sparkle.EmissionDirection = Enum.NormalId.Top
			sparkle.Acceleration = Vector3.new(0, -10, 0)
			sparkle.Rate = 0
			sparkle.Parent = tag
			sparkle:Emit(28)
			task.delay(1.6, function()
				sparkle:Destroy()
			end)
		end
	end
	dirty = true
end

-- Étiquette de prix + invite "Acheter" d'un objet exposé
local function addTag(shop: Shop, parent: Instance, d: Display, tagCF: CFrame, center: Vector3)
	local theme = shop.Theme
	-- (v9.6.1) ancre INVISIBLE : l'ancienne étiquette en pièce (et son bandeau)
	-- passait DEVANT le panneau de prix et cachait le texte
	local tag = newPart(parent, "PriceTag", Vector3.new(0.4, 0.4, 0.08), tagCF, WHITE, M.SmoothPlastic)
	tag.Transparency = 1
	tag.CastShadow = false
	d.Tag = tag
	-- l'invite est posée au centre de l'objet (l'interface Roblox s'y affiche)
	local attachment = Instance.new("Attachment")
	attachment.Name = "PromptAt"
	attachment.WorldPosition = center
	attachment.Parent = tag
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "BuyPrompt"
	prompt.ObjectText = d.Entry.Icon .. " " .. Locale.T(d.Entry.Name)
	prompt.ActionText = promptText(d.Entry)
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0.25
	prompt.MaxActivationDistance = d.Entry.Kind == "Car" and 11 or PROMPT_DISTANCE
	prompt.RequiresLineOfSight = false
	prompt.Parent = attachment
	prompt.Triggered:Connect(function()
		task.spawn(buyDisplay, d)
	end)
	d.Prompt = prompt
	-- étiquette flottante (taille en studs : elle rapetisse avec la distance)
	local bb = Instance.new("BillboardGui")
	bb.Name = "PriceLabel"
	bb.Size = d.Entry.Kind == "Car" and UDim2.fromScale(3.6, 1.45) or UDim2.fromScale(1.9, 0.86)
	bb.StudsOffsetWorldSpace = tagCF.LookVector * 0.25 + Vector3.new(0, d.Entry.Kind == "Car" and 1.6 or -0.1, 0)
	bb.MaxDistance = d.Entry.Kind == "Car" and 40 or TAG_DISTANCE
	bb.LightInfluence = 0
	bb.Brightness = 1
	-- (v9.6.1) toujours lisible (jamais coupé par une étagère ou un objet) ;
	-- seules les étiquettes les plus proches s'affichent (updateTags)
	bb.AlwaysOnTop = true
	bb.Enabled = false
	bb.Parent = tag
	d.Billboard = bb
	local card = Instance.new("Frame")
	card.Name = "Card"
	card.Size = UDim2.fromScale(1, 1)
	card.BackgroundColor3 = WHITE
	card.BackgroundTransparency = 0.04
	card.Parent = bb
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.22, 0)
	corner.Parent = card
	local stroke = Instance.new("UIStroke")
	stroke.Color = theme.Accent
	stroke.Thickness = 2
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = card
	local function text(name: string, value: string, y: number, h: number, color: Color3, font: Enum.Font): TextLabel
		local l = Instance.new("TextLabel")
		l.Name = name
		l.BackgroundTransparency = 1
		l.Position = UDim2.fromScale(0.06, y)
		l.Size = UDim2.fromScale(0.88, h)
		l.Font = font
		l.TextScaled = true
		l.Text = value
		l.TextColor3 = color
		l.Parent = card
		return l
	end
	d.Labels.Name = text("Name", d.Entry.Icon .. " " .. Locale.T(d.Entry.Name), 0.08, 0.42, INK, Enum.Font.GothamBold)
	d.Labels.Price = text("Price", "", 0.52, 0.4, rgb(236, 72, 140), Enum.Font.FredokaOne)
	local owned = Instance.new("TextLabel")
	owned.Name = "Owned"
	owned.AnchorPoint = Vector2.new(1, 0)
	owned.Position = UDim2.fromScale(1.02, -0.22)
	owned.Size = UDim2.fromScale(0.3, 0.42)
	owned.BackgroundColor3 = rgb(64, 196, 150)
	owned.Font = Enum.Font.FredokaOne
	owned.TextScaled = true
	owned.TextColor3 = WHITE
	owned.Text = ""
	owned.Visible = false
	owned.Parent = card
	local oc = Instance.new("UICorner")
	oc.CornerRadius = UDim.new(1, 0)
	oc.Parent = owned
	d.Labels.Owned = owned
	refreshDisplay(d)
end

----------------------------------------------------------------------
-- Objets exposés
----------------------------------------------------------------------

-- Construit le modèle 3D d'un objet à la bonne taille pour son emplacement
local function buildItem(entry: ShopUI.Entry, slot: Slot): Model?
	local R = Recipes()
	if not R then
		return nil
	end
	local item = entry.Def
	local size = math.max(20, tonumber(item.Size) or 80)
	local scale = math.min(PX, slot.MaxW / size, slot.MaxH / size)
	local opts = { Scale = scale, Collide = slot.Kind == "Podium" or slot.Kind == "Platform", Query = false, Shadows = slot.Kind ~= "Shelf" }
	local model: Model? = R.BuildItem(entry.Id, nil, opts)
	if not model then
		return nil
	end
	local fp = model:GetAttribute("Footprint")
	if typeof(fp) == "Vector3" then
		local ratio = math.min(1, slot.MaxW / math.max(0.1, fp.X), slot.MaxH / math.max(0.1, fp.Y), slot.MaxD / math.max(0.1, fp.Z))
		if ratio < 0.95 then
			model:Destroy()
			opts.Scale = scale * ratio
			model = R.BuildItem(entry.Id, nil, opts)
		end
	end
	if model then
		-- (≤ 2 vraies lumières par boutique : celles des lampes exposées s'éteignent)
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("Light") then
				d:Destroy()
			end
		end
	end
	return model
end

local function placeDisplay(shop: Shop, parent: Instance, slot: Slot, entry: ShopUI.Entry, withTag: boolean): Display?
	local model = buildItem(entry, slot)
	local d: Display = { Entry = entry, Model = model, Labels = {}, Key = entry.Kind .. ":" .. entry.Id, SlotKind = slot.Kind }
	local height = 1.5
	local lift = 0.02
	if model and slot.Kind == "Shelf" and model:GetAttribute("Wall") ~= true then
		-- 🐾 coussin sous chaque animal, 🪴 soucoupe en terre cuite sous les plantes
		local fp = model:GetAttribute("Footprint")
		local width = typeof(fp) == "Vector3" and math.clamp(math.max(fp.X, fp.Z) + 0.3, 1.2, slot.MaxW) or 1.8
		if shop.Id == "Pets" then
			local cushion = newPart(parent, "Cushion", Vector3.new(0.3, width, width), slot.CF * CFrame.new(0, 0.15, 0) * CFrame.Angles(0, 0, math.rad(90)), shop.Theme.Podium, M.Fabric)
			;(cushion :: Part).Shape = Enum.PartType.Cylinder
			lift = 0.32
		elseif shop.Id == "Garden" then
			local saucer = newPart(parent, "Saucer", Vector3.new(0.14, width * 0.8, width * 0.8), slot.CF * CFrame.new(0, 0.07, 0) * CFrame.Angles(0, 0, math.rad(90)), rgb(206, 124, 90), M.Slate)
			;(saucer :: Part).Shape = Enum.PartType.Cylinder
			lift = 0.16
		end
	end
	if model then
		local pivot = slot.CF * CFrame.new(0, lift, 0)
		if model:GetAttribute("Wall") == true and slot.WallZ then
			pivot = slot.CF * CFrame.new(0, 0.05, slot.WallZ)
		end
		model:PivotTo(pivot)
		model.Parent = parent
		local fp = model:GetAttribute("Footprint")
		height = typeof(fp) == "Vector3" and fp.Y or height
		stats.Items += 1
		-- 🖥️ écrans vivants du Setup Store (LiveProps, aperçu non interactif)
		if shop.Id == "Setup" then
			local live = optional(script.Parent, "LiveProps")
			if live and type(live.Attach) == "function" then
				local ok, handle = pcall(live.Attach, model, entry.Id, { Interactive = false, PauseDistance = 60, ScreenDistance = 45 })
				if ok then
					d.Live = handle
				end
			end
		end
	end
	if withTag then
		local center = (slot.CF * CFrame.new(0, math.max(0.6, height / 2), 0)).Position
		if slot.Kind == "Wall" then
			center = (slot.CF * CFrame.new(0, height / 2, -0.6)).Position
		end
		addTag(shop, parent, d, slot.Tag, center)
	end
	table.insert(shop.Displays, d)
	return d
end

----------------------------------------------------------------------
-- Habillage (niveau 1) et mobilier (niveau 2)
----------------------------------------------------------------------

-- (v9.9, SHOPS99) BOUTIQUE ÉCLAIRÉE VUE DE DEHORS, de jour comme de nuit,
-- dès 150 studs (niveau 1) : plafonniers LED « lumineux » (SurfaceGui peu
-- sensible à la lumière : aucune vraie lumière, aucun Neon), murs et sol
-- doucement « éclairés », silhouettes des étagères pleines (retirées quand
-- l'intérieur complet est là), flaque de lumière chaude sur le trottoir la nuit
local function glow(p: BasePart, face: Enum.NormalId, color: Color3, transparency: number, influence: number, pps: number?): SurfaceGui
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Glow"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pps or 4
	gui.LightInfluence = influence
	gui.MaxDistance = FRONT_DROP
	gui.Parent = p
	local f = Instance.new("Frame")
	f.Name = "Wash"
	f.Size = UDim2.fromScale(1, 1)
	f.BorderSizePixel = 0
	f.BackgroundColor3 = color
	f.BackgroundTransparency = transparency
	f.Parent = gui
	return gui
end

local function litShell(shop: Shop, parent: Instance)
	local t = shop.Theme
	local F = shop.F
	local H, D = shop.Size.Y, shop.Size.Z
	local s: any = shop
	-- murs et sol : lumière douce (le matériau reste visible dessous)
	for _, p in ipairs(parent:GetChildren()) do
		if p:IsA("BasePart") then
			if p.Name == "BackLining" then
				glow(p, Enum.NormalId.Front, t.Wall:Lerp(t.Lamp, 0.4), 0.3, 0.35)
			elseif p.Name == "WallLining" then
				local rel = F:PointToObjectSpace(p.Position)
				glow(p, rel.X < 0 and Enum.NormalId.Right or Enum.NormalId.Left, t.Wall:Lerp(t.Lamp, 0.4), 0.3, 0.35)
			elseif p.Name == "FloorFinish" then
				glow(p, Enum.NormalId.Top, t.Floor:Lerp(t.Lamp, 0.3), 0.55, 0.45, 2)
			end
		end
	end
	-- 4 plafonniers LED encastrés (dalles lumineuses)
	for _, spot in ipairs({ { -6.5, 5 }, { 6.5, 5 }, { -6.5, 15 }, { 6.5, 15 } }) do
		local x, z = spot[1], math.min(spot[2], D - 5)
		local panel = box(parent, "LedPanel", F, x - 1.8, x + 1.8, H - 0.25, H - 0.08, z - 0.55, z + 0.55, rgb(230, 230, 236), M.Metal)
		glow(panel, Enum.NormalId.Bottom, t.Lamp:Lerp(WHITE, 0.5), 0, 0, 20)
	end
	-- silhouettes des étagères pleines (dossier Night, retiré au niveau complet)
	local night = Instance.new("Folder")
	night.Name = "Night"
	night.Parent = parent
	s.Night, s.NightParent = night, parent
	local plan = shop.Plan
	for i, unit in ipairs(plan and plan.ShelfUnits or {}) do
		local hl = unit.L / 2
		local body = box(night, "ShelfShape", unit.CF, -hl + 0.05, hl - 0.05, 0.15, unit.H - 0.05, 0.1, unit.Dp - 0.3, t.Shelf, t.ShelfMat)
		local gui = glow(body, Enum.NormalId.Front, WHITE, 1, 0.3, 6)
		for k, y in ipairs(unit.Levels) do
			local band = Instance.new("Frame")
			band.BorderSizePixel = 0
			band.Position = UDim2.fromScale(0.03, 1 - (y + 1.6) / unit.H)
			band.Size = UDim2.fromScale(0.94, 1.5 / unit.H)
			band.BackgroundColor3 = t.Accent:Lerp(({ rgb(255, 214, 120), rgb(150, 200, 255), rgb(255, 150, 180) })[(i + k) % 3 + 1], 0.55)
			band.Parent = gui
		end
	end
	-- flaque de lumière chaude sur le trottoir devant la vitrine (nuit seulement)
	local spill = box(parent, "LightSpill", shop.DoorCF, -12.4, 12.4, 0.02, 0.04, -4.8, -0.9, WHITE, M.SmoothPlastic)
	spill.Transparency = 1
	local sg = Instance.new("SurfaceGui")
	sg.Name = "Spill"
	sg.Face = Enum.NormalId.Top
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 4
	sg.LightInfluence = 0
	sg.MaxDistance = FRONT_DROP
	sg.Enabled = false
	sg.Parent = spill
	local wash = Instance.new("Frame")
	wash.Size = UDim2.fromScale(1, 1)
	wash.BorderSizePixel = 0
	wash.BackgroundColor3 = t.Lamp
	wash.BackgroundTransparency = 0.72
	wash.Parent = sg
	local grad = Instance.new("UIGradient")
	grad.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(0.6, 0.6), NumberSequenceKeypoint.new(1, 1) })
	grad.Rotation = 90
	grad.Parent = wash
	s.Spill = sg
end

-- Sol, murs, lambris, plafond (tout à GAP des murs du serveur)
local function lining(shop: Shop, parent: Instance)
	local t = shop.Theme
	local F = shop.F
	local W, H, D = shop.Size.X, shop.Size.Y, shop.Size.Z
	local hw = W / 2
	local inset = GAP
	box(parent, "FloorFinish", F, -hw + inset, hw - inset, 0.05, 0.12, inset, D - inset, t.Floor, t.FloorMat)
	local wx = hw - inset - 0.1
	local top = H - 0.15
	for _, sx in ipairs({ -1, 1 }) do
		box(parent, "WallLining", F, sx * wx, sx * (wx + 0.1), 0.15, top, 0.2, D - 0.2, t.Wall, M.SmoothPlastic)
		box(parent, "Wainscot", F, sx * (wx - GAP - 0.1), sx * (wx - GAP), 0.15, 3.1, 0.4, D - 0.4, t.Wainscot, M.WoodPlanks)
		box(parent, "ChairRail", F, sx * (wx - GAP - 0.22), sx * (wx - GAP - 0.05), 3.05, 3.3, 0.4, D - 0.4, WHITE, M.SmoothPlastic)
	end
	box(parent, "BackLining", F, -wx + 0.15, wx - 0.15, 0.15, top, D - inset - 0.1, D - inset, t.Wall, M.SmoothPlastic)
	box(parent, "BackWainscot", F, -wx + 0.35, wx - 0.35, 0.15, 3.1, D - inset - 0.2 - GAP, D - inset - 0.1 - GAP, t.Wainscot, M.WoodPlanks)
	box(parent, "CeilingFinish", F, -hw + 0.3, hw - 0.3, H - 0.1, H - GAP, 0.3, D - 0.3, t.Ceiling, M.SmoothPlastic)
	if shop.Kind == "Items" then
		-- façade (côté intérieur) : bandeau au-dessus de la porte et des vitrines
		box(parent, "FrontLining", F, -12.5, 12.5, 9.1, top, inset, inset + 0.1, t.Wall, M.SmoothPlastic)
	end
	if shop.Kind == "Items" then
		pcall(litShell, shop, parent)
	end
end

local function windowDisplays(shop: Shop, parent: Instance, plan: Plan)
	local t = shop.Theme
	local F = shop.F
	for _, slot in ipairs(plan.Window) do
		local p = F:ToObjectSpace(slot.CF).Position
		box(parent, "WindowStage", F, p.X - 3.8, p.X + 3.8, 0.1, 1.64, 0.45, 3.8, t.Podium, M.SmoothPlastic, true)
		box(parent, "StageTrim", F, p.X - 3.85, p.X + 3.85, 1.68, 1.72, 0.4, 3.85, WHITE, M.SmoothPlastic)
	end
end

-- Étagère murale (planches, montants, fond coloré, socle)
local function shelfUnit(parent: Instance, unit: any, t: Theme, caption: string?)
	local cf, L, Dp, H = unit.CF, unit.L, unit.Dp, unit.H
	local hl = L / 2
	-- montants + dessus
	for _, sx in ipairs({ -1, 1 }) do
		box(parent, "ShelfSide", cf, sx * (hl - 0.2), sx * hl, 0.1, H, 0, Dp, t.Shelf, t.ShelfMat, true)
	end
	box(parent, "ShelfTop", cf, -hl, hl, H, H + 0.2, 0, Dp, t.Shelf, t.ShelfMat)
	box(parent, "ShelfBack", cf, -hl + 0.2 + GAP, hl - 0.2 - GAP, 0.1, H - GAP, Dp - 0.25, Dp - 0.1, t.Back, M.SmoothPlastic, true)
	for index, y in ipairs(unit.Levels) do
		local y0 = index == 1 and 0.1 or y - 0.2
		box(parent, index == 1 and "ShelfBase" or "ShelfBoard", cf, -hl + 0.2, hl - 0.2, y0, y, 0.05, Dp - 0.25 - GAP, t.Shelf, t.ShelfMat, index == 1)
		-- (v9.8) barre de prix colorée au bord de la planche
		box(parent, "PriceRail", cf, -hl + 0.25, hl - 0.25, y - 0.19, y - 0.02, 0, 0.03, t.Accent:Lerp(WHITE, 0.25), M.SmoothPlastic)
	end
	-- (v9.8) en-tête du rayon au-dessus de l'étagère
	if caption then
		local head = box(parent, "ShelfHeader", cf, -math.min(hl - 0.6, 3), math.min(hl - 0.6, 3), H + 0.25, H + 1.15, Dp * 0.4, Dp * 0.4 + 0.12, WHITE, M.SmoothPlastic)
		local gui = Instance.new("SurfaceGui")
		gui.Name = "Sign"
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 40
		gui.LightInfluence = 0.3
		gui.MaxDistance = 60
		gui.Parent = head
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Size = UDim2.fromScale(0.92, 0.8)
		l.Position = UDim2.fromScale(0.04, 0.1)
		l.Font = Enum.Font.FredokaOne
		l.TextScaled = true
		l.Text = caption
		l.TextColor3 = t.Accent
		l.Parent = gui
	end
end

-- (v9.8, MARKET98) personnages de CITY98 (NPCModels, paresseux)
local npcModule: any = nil
local function NPC(): any?
	if npcModule == nil then
		npcModule = optional(ReplicatedStorage.Shared, "NPCModels") or false
	end
	return npcModule or nil
end

-- Personnage animé d'une boutique (fixe, ou sur un parcours fermé `path`)
local function shopActor(shop: Shop, parent: Instance, style: string, seed: number, cf: CFrame, anim: string, opts: { [string]: any }?, path: { Vector3 }?): boolean
	local N = NPC()
	if not N or type(N.Build) ~= "function" then
		return false
	end
	local o: { [string]: any } = { Seed = seed }
	for k, v in pairs(opts or {}) do
		o[k] = v
	end
	local ok, model = pcall(N.Build, style, o)
	if not ok or typeof(model) ~= "Instance" or not model:IsA("Model") then
		return false
	end
	model:PivotTo(cf)
	model.Parent = parent
	pcall(N.Animate, model, anim, seed * 1.37)
	local s: any = shop
	s.Actors = s.Actors or {}
	local length = 0
	if path then
		for i = 1, #path do
			length += (path[i % #path + 1] - path[i]).Magnitude
		end
	end
	table.insert(s.Actors, { Model = model, Anim = anim, Offset = seed * 1.37, Path = path, Length = length, Speed = 2.2, Pos = cf.Position })
	return true
end

-- Point et direction (lissée aux virages) sur un parcours fermé
local function pathAt(path: { Vector3 }, s: number): (Vector3, Vector3)
	local n = #path
	for i = 1, n do
		local a, b = path[i], path[i % n + 1]
		local seg = (b - a).Magnitude
		if s <= seg or i == n then
			local dir = seg > 0 and (b - a) / seg or Vector3.new(0, 0, -1)
			local p = a + dir * math.min(s, seg)
			local turn = 1.2
			if seg - s < turn then
				local c = path[(i + 1) % n + 1]
				local nd = (c - b).Magnitude > 0 and (c - b).Unit or dir
				dir = dir:Lerp(nd, (turn - (seg - s)) / (turn * 2))
			elseif s < turn then
				local z = path[(i - 2) % n + 1]
				local pd = (a - z).Magnitude > 0 and (a - z).Unit or dir
				dir = dir:Lerp(pd, (turn - s) / (turn * 2))
			end
			if dir.Magnitude < 1e-3 then
				dir = Vector3.new(0, 0, -1)
			end
			return p, dir.Unit
		end
		s -= seg
	end
	return path[1], Vector3.new(0, 0, -1)
end

-- Étiquette imprimée (SurfaceGui) sur la face avant d'un article, plafonnée
local MAX_PRINTS = 60
local function printLabel(shop: Shop, p: BasePart, caption: string, icon: string, color: Color3)
	local s: any = shop
	s.Prints = (s.Prints or 0) + 1
	if s.Prints > MAX_PRINTS then
		return
	end
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Print"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 60
	gui.LightInfluence = 0.8
	gui.MaxDistance = 26
	gui.Parent = p
	local band = Instance.new("Frame")
	band.Name = "Band"
	band.BorderSizePixel = 0
	band.BackgroundColor3 = WHITE
	band.Position = UDim2.fromScale(0.08, 0.34)
	band.Size = UDim2.fromScale(0.84, 0.32)
	band.Parent = gui
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0.25, 0)
	c.Parent = band
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = UDim2.fromScale(0.9, 0.84)
	l.Position = UDim2.fromScale(0.05, 0.08)
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.Text = caption
	l.TextColor3 = color:Lerp(Color3.new(0, 0, 0), 0.4)
	l.Parent = band
	local i = Instance.new("TextLabel")
	i.BackgroundTransparency = 1
	i.Size = UDim2.fromScale(0.5, 0.28)
	i.Position = UDim2.fromScale(0.25, 0.68)
	i.Font = Enum.Font.GothamBold
	i.TextScaled = true
	i.Text = icon
	i.Parent = gui
end


	-- Avec turbo : bouton champignon rouge + jauge de recharge
	local startGroup = box({ Name = "StartGroup", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 13, Visible = false, Parent = console })

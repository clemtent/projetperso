----------------------------------------------------------------------
-- Construction du plan
----------------------------------------------------------------------

-- Tronque un texte à maxChars caractères (UTF-8), avec "…"
function ChatReplies.Quote(text: string, maxChars: number): string
	local length = utf8.len(text)
	if length == nil then
		return string.sub(text, 1, maxChars)
	end
	if length <= maxChars then
		return text
	end
	local cut = utf8.offset(text, maxChars) or (#text + 1)
	return string.sub(text, 1, cut - 1) .. "…"
end

type Options = {
	Topics: { string }?,
	Lang: string?,
	Text: string?,
	Normalized: string?, -- texte en minuscules sans accents (ChatTopics.Normalize), sinon string.lower
	First: boolean?,
	Repeat: boolean?,
	Random: any, -- Random (NextNumber / NextInteger)
}

function ChatReplies.Build(options: Options): Plan
	local random = options.Random
	local lang = options.Lang == "fr" and "fr" or "en"
	local text = options.Text or ""
	local topics = options.Topics or {}
	local normalized = options.Normalized or string.lower(text)
	local used: { [string]: boolean } = {}

	-- Une phrase au hasard (jamais deux fois la même dans une réponse)
	local function pickLine(variants: any): string
		local list = variants and (variants[lang] or variants.en)
		if type(list) ~= "table" or #list == 0 then
			return ""
		end
		local line = list[random:NextInteger(1, #list)]
		for _ = 1, 4 do
			if not used[line] then
				break
			end
			line = list[random:NextInteger(1, #list)]
		end
		used[line] = true
		return (string.gsub(line, "{n}", ChatReplies.NAME))
	end

	-- Particularités du message
	local words = {}
	for word in string.gmatch(normalized, "[%w%-]+") do
		table.insert(words, word)
	end
	local joined = table.concat(words, " ")
	local spaced = " " .. joined .. " "
	local filtered = string.find(text, "##", 1, true) ~= nil
	local letters = string.gsub(text, "[^%a]", "")
	local caps = #letters >= 5 and not string.find(letters, "%l")
	local emojiOnly = #words == 0 and string.find(text, "%S") ~= nil
	local long = (utf8.len(text) or #text) > 90
	local isTest = TEST_MESSAGES[joined] == true
	local howAreYou = false
	for _, phrase in ipairs(HOW_ARE_YOU) do
		if string.find(spaced, phrase, 1, true) then
			howAreYou = true
			break
		end
	end

	local primary: string = topics[1] or "None"
	if ChatReplies.Host[primary] == nil then
		primary = "None"
	end
	-- Une question sur un sujet précis ("tu manges quoi ?") : elle répond avec ce sujet
	-- (même après un "coucou" : "salut ! tu manges quoi ?" -> elle parle de sa nourriture)
	local answer = primary
	if table.find(topics, "Question") and primary ~= "Mean" and primary ~= "Sad" then
		local best = math.huge
		for _, candidate in ipairs(topics) do
			local rank = ANSWER_PRIORITY[candidate]
			if rank and rank < best and ChatReplies.Host[candidate] then
				best, answer = rank, candidate
			end
		end
	end
	local topic: string = answer
	local hostVariants: any = ChatReplies.Host[answer]
	if answer ~= primary or primary == "Question" then
		hostVariants = ChatReplies.Answers[answer] or hostVariants
	end
	local upset = primary == "Mean" or primary == "Sad"
	local noTopic = primary == "None"
	if filtered then
		topic, hostVariants = "Filtered", ChatReplies.Extra.FilteredHost
	elseif isTest then
		topic, hostVariants = "Test", ChatReplies.Extra.TestHost
	elseif howAreYou and not upset then
		topic, hostVariants = "HowAreYou", ChatReplies.Extra.HowAreYouHost
	elseif emojiOnly and noTopic then
		topic, hostVariants = "Emoji", ChatReplies.Extra.EmojiHost
	end

	local plan: Plan = {
		Topic = topic,
		Mood = ChatReplies.Moods[topic] or ChatReplies.Moods.None,
		Host = { Delay = random:NextNumber(1.5, 2.2), Text = pickLine(hostVariants) },
		Viewers = {},
	}

	-- Spectateurs : 1 à 4 lignes (+ un modo si besoin)
	local lines: { Line } = {}
	local function add(variants: any, mod: boolean?)
		local line = pickLine(variants)
		if line ~= "" then
			table.insert(lines, { Delay = 0, Text = line, Mod = mod })
		end
	end
	local viewerCount = 0
	local function addViewer(variants: any)
		if viewerCount < 4 then
			viewerCount += 1
			add(variants)
		end
	end
	if filtered then
		add(ChatReplies.Extra.Mod, true)
		addViewer(ChatReplies.Extra.Filtered)
		if random:NextNumber() < 0.5 then
			addViewer(ChatReplies.Extra.Filtered)
		end
	else
		if primary == "Mean" then
			add(ChatReplies.Extra.Mod, true)
		end
		if options.First then
			addViewer(ChatReplies.Extra.First)
		end
		if isTest then
			addViewer(ChatReplies.Extra.Test)
		end
		if caps then
			addViewer(ChatReplies.Extra.Caps)
		end
		if long then
			addViewer(ChatReplies.Extra.Long)
		end
		if options.Repeat then
			addViewer(ChatReplies.Extra.Repeat)
		end
		local wanted = random:NextInteger(1, 3) + (#topics >= 2 and 1 or 0)
		local topical = 0
		while viewerCount < 4 and (topical < wanted or topical == 0) do
			local variants: any
			if topic == "HowAreYou" then
				variants = random:NextNumber() < 0.6 and ChatReplies.Extra.HowAreYou or ChatReplies.Viewers.Greeting
			else
				-- surtout le sujet de la réponse, parfois un autre sujet du message
				local pickTopic = answer
				if #topics >= 2 and random:NextNumber() < 0.4 then
					pickTopic = topics[random:NextInteger(1, #topics)]
				end
				if emojiOnly and pickTopic == "None" then
					pickTopic = "Emoji"
				end
				variants = ChatReplies.Viewers[pickTopic] or ChatReplies.Viewers.None
			end
			addViewer(variants)
			topical += 1
		end
	end

	-- Mentions "@pseudo" (un peu plus d'une fois sur trois) et délais étalés entre 1 et 6 s
	local slots = #lines
	for index, line in ipairs(lines) do
		if not string.find(line.Text, ChatReplies.NAME, 1, true) and random:NextNumber() < (line.Mod and 0.5 or 0.35) then
			line.Text = "@" .. ChatReplies.NAME .. " " .. line.Text
		end
		local slot = 5 / math.max(1, slots)
		line.Delay = (line.Mod and 0.4 or 0.9) + (index - 1) * slot + random:NextNumber(0, slot * 0.7)
		line.Delay = math.min(line.Delay, 6)
	end
	table.sort(lines, function(a, b)
		return a.Delay < b.Delay
	end)
	plan.Viewers = lines
	return plan
end

return ChatReplies
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="147">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--[[
	Hud (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Stimuli > Live > Hud

	v9.1 : habillage du live POSÉ SUR LA VIDÉO (façon appli de live sur
	téléphone), utilisé par Stimuli > LiveStream :
	  - ombrages haut / bas (les textes restent lisibles sur l'image) ;
	  - pastille de la streameuse en haut à gauche : avatar dessiné dans un
	    anneau dégradé qui tourne, étiquette "LIVE", couronne (studio 9),
	    pseudo certifié, titre + durée, bouton "Suivre" (reflet qui passe tant
	    qu'on n'est pas abonné) ;
	  - en haut à droite : "● LIVE" rouge qui clignote + spectateurs, et les
	    likes en dessous (petit rebond quand ils montent) ;
	  - sous la pastille : objectif d'abonnés (barre qui se remplit, alterne
	    avec "Nouvel abonné : X").
	Mode compact (téléphone) : pastilles agrandies, textes secondaires cachés.
	Rien ne tourne ici : LiveStream appelle Step(clock) depuis SA boucle (≤ 30 Hz).
]]

local Locale = require(game:GetService("ReplicatedStorage").Shared.Locale)

local Hud = {}

local WHITE = Color3.new(1, 1, 1)
local SKIN = Color3.fromRGB(255, 220, 196)
local HAIR = Color3.fromRGB(70, 46, 96)
local INK = Color3.fromRGB(46, 28, 52)
local PHONES_GLOW = Color3.fromRGB(255, 130, 210)
local PILL = Color3.fromRGB(14, 9, 26)
local FOLLOW_COLOR = Color3.fromRGB(255, 60, 120)
local FOLLOWED_COLOR = Color3.fromRGB(70, 62, 96)

local MARGIN = 6 -- marge avec les bords de la vidéo
local HOST_H = 36 -- pastille de la streameuse
local HOST_W = 238
local AVATAR = 36 -- dessin de l'avatar (réduit par un UIScale)
local AVATAR_SHOWN = 30
local FOLLOW_W, FOLLOW_H = 64, 26
local GOAL_W, GOAL_H = 184, 17
local RIGHT_H = 20 -- pastilles de droite

export type Options = {
	Parent: GuiObject, -- la vidéo
	ZIndex: number,
	Host: string, -- pseudo de la streameuse
}

function Hud.new(ctx: any, options: Options)
	local UI = ctx.UIUtil
	local Theme = ctx.Theme
	local z = options.ZIndex

	local function box(props: { [string]: any }, radius: (number | UDim)?): Frame
		props.BorderSizePixel = 0
		local frame = UI.Create("Frame", props)
		if radius then
			UI.Corner(frame, radius)
		end
		return frame
	end
	local function text(props: { [string]: any }): TextLabel
		props.BackgroundTransparency = props.BackgroundTransparency or 1
		props.BorderSizePixel = 0
		props.Font = props.Font or Theme.Fonts.Body
		props.TextColor3 = props.TextColor3 or WHITE
		return UI.Create("TextLabel", props)
	end
	local function at(props: { [string]: any }, x: number, y: number, w: number, h: number): { [string]: any }
		props.AnchorPoint = Vector2.new(0.5, 0.5)
		props.Position = UDim2.fromOffset(x, y)
		props.Size = UDim2.fromOffset(w, h)
		return props
	end
	-- Ombre de texte (contour sombre, lisible sur n'importe quelle image)
	local function shadow(label: TextLabel, transparency: number?)
		label.TextStrokeColor3 = Color3.fromRGB(12, 6, 22)
		label.TextStrokeTransparency = transparency or 0.55
	end

	local root = box({ Name = "Hud", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = z, Parent = options.Parent })

	-- Ombrages : haut (pastilles) et bas (saisie)
	local topShade = box({ Name = "TopShade", Size = UDim2.new(1, 0, 0, 70), BackgroundColor3 = Color3.fromRGB(10, 6, 20), ZIndex = 1, Parent = root })
	UI.Gradient(topShade, ColorSequence.new(WHITE), 90).Transparency = NumberSequence.new(0.35, 1)
	local bottomShade = box({ Name = "BottomShade", AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = Color3.fromRGB(10, 6, 20), ZIndex = 1, Parent = root })
	-- (léger : les bulles du chat ont leur propre fond, la table reste bien visible)
	UI.Gradient(bottomShade, ColorSequence.new(WHITE), 90).Transparency = NumberSequence.new(1, 0.5)

	------------------------------------------------------------------
	-- Pastille de la streameuse
	------------------------------------------------------------------
	local host = box({
		Name = "Host",
		Position = UDim2.fromOffset(MARGIN, MARGIN),
		Size = UDim2.fromOffset(HOST_W, HOST_H),
		BackgroundColor3 = PILL,
		BackgroundTransparency = 0.28,
		ZIndex = 3,
		Parent = root,
	}, UDim.new(1, 0))
	UI.Stroke(host, WHITE, 1, 0.82)
	local hostScale = UI.Create("UIScale", { Parent = host })

	-- Avatar : anneau dégradé qui tourne + mini portrait dessiné
	local avatarRing = box(at({ Name = "Avatar", BackgroundColor3 = WHITE, ZIndex = 4, Parent = host }, HOST_H / 2, HOST_H / 2, AVATAR, AVATAR), UDim.new(1, 0))
	UI.Create("UIScale", { Scale = AVATAR_SHOWN / AVATAR, Parent = avatarRing })
	local ringGradient = UI.Gradient(avatarRing, ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 90)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 120, 200)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 180, 60)),
	}), 45)
	do
		local gap = box(at({ BackgroundColor3 = Color3.fromRGB(30, 24, 44), ZIndex = 5, Parent = avatarRing }, AVATAR / 2, AVATAR / 2, AVATAR - 4, AVATAR - 4), UDim.new(1, 0))
		local s = AVATAR - 7
		local face = box(at({ BackgroundColor3 = Color3.fromRGB(255, 196, 222), ZIndex = 6, ClipsDescendants = true, Parent = gap }, (AVATAR - 4) / 2, (AVATAR - 4) / 2, s, s), UDim.new(1, 0))
		UI.Gradient(face, ColorSequence.new(Color3.fromRGB(255, 214, 234), Color3.fromRGB(250, 160, 200)), 90)
		box(at({ BackgroundColor3 = HAIR, ZIndex = 6, Parent = face }, s / 2, s / 2 + 3, 22, 26), 9)
		box(at({ BackgroundColor3 = SKIN, ZIndex = 7, Parent = face }, s / 2, s / 2 + 5, 16, 16), UDim.new(0.48, 0))
		box(at({ BackgroundColor3 = HAIR, ZIndex = 8, Parent = face }, s / 2, s / 2 - 3, 20, 8), 4)
		for _, x in ipairs({ -3.5, 3.5 }) do
			box(at({ BackgroundColor3 = INK, ZIndex = 9, Parent = face }, s / 2 + x, s / 2 + 5, 2.5, 3), UDim.new(1, 0))
			box(at({ BackgroundColor3 = Color3.fromRGB(255, 120, 150), BackgroundTransparency = 0.4, ZIndex = 9, Parent = face }, s / 2 + x * 1.6, s / 2 + 8, 4, 2), UDim.new(1, 0))
		end
		box(at({ BackgroundColor3 = Color3.fromRGB(190, 70, 100), ZIndex = 9, Parent = face }, s / 2, s / 2 + 9.5, 4, 2), UDim.new(1, 0))
		for _, x in ipairs({ -9, 9 }) do
			box(at({ BackgroundColor3 = PHONES_GLOW, ZIndex = 9, Parent = face }, s / 2 + x, s / 2 + 4, 4, 8), 2)
		end
	end
	local liveTag = text({
		Name = "LiveTag",
		Text = "LIVE",
		Font = Theme.Fonts.Title,
		TextSize = 8,
		BackgroundColor3 = Color3.fromRGB(235, 35, 60),
		BackgroundTransparency = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(HOST_H / 2, HOST_H - 3),
		Size = UDim2.fromOffset(24, 10),
		ZIndex = 10,
		Parent = host,
	})
	UI.Corner(liveTag, 3)
	UI.Stroke(liveTag, Color3.fromRGB(30, 24, 44), 1.5)
	local crown = text({
		Name = "Crown",
		Text = "👑",
		TextSize = 15,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(HOST_H / 2 + 11, 1),
		Size = UDim2.fromOffset(20, 20),
		Rotation = 22,
		Visible = false,
		ZIndex = 11,
		Parent = host,
	})

	local nameX = HOST_H + 3
	local textW = HOST_W - nameX - FOLLOW_W - 8
	local nameLabel = text({
		Name = "Streamer",
		Text = "<b>" .. options.Host .. "</b> ✅",
		RichText = true,
		Font = Theme.Fonts.Title,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(nameX, 3),
		Size = UDim2.fromOffset(textW, 17),
		ZIndex = 4,
		Parent = host,
	})
	local subtitle = text({
		Name = "Title",
		Text = "",
		RichText = true,
		TextSize = 10,
		TextColor3 = Color3.fromRGB(214, 204, 240),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(nameX, 19),
		Size = UDim2.fromOffset(textW, 13),
		ZIndex = 4,
		Parent = host,
	})

	-- Bouton Suivre (dans la pastille, à droite)
	local follow = UI.Create("TextButton", {
		Name = "Follow",
		Text = Locale.T("💜 Follow"),
		Font = Theme.Fonts.Title,
		TextSize = 12,
		TextColor3 = WHITE,
		BackgroundColor3 = FOLLOW_COLOR,
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -5, 0.5, 0),
		Size = UDim2.fromOffset(FOLLOW_W, FOLLOW_H),
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = host,
	})
	UI.Corner(follow, UDim.new(1, 0))
	local followGradient = UI.Gradient(follow, ColorSequence.new(WHITE, Color3.fromRGB(215, 190, 230)), 90)
	local followStroke = UI.Stroke(follow, Color3.fromRGB(255, 190, 220), 1.5, 0.2)
	UI.AnimateButton(follow, 1.06, 0.9)
	local shine = box({ Name = "Shine", Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BackgroundTransparency = 0.5, ZIndex = 6, Parent = follow }, UDim.new(1, 0))
	local shineGradient = UI.Create("UIGradient", {
		Rotation = 20,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.42, 1),
			NumberSequenceKeypoint.new(0.5, 0.2),
			NumberSequenceKeypoint.new(0.58, 1),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Offset = Vector2.new(-1, 0),
		Parent = shine,
	})

	------------------------------------------------------------------
	-- En haut à droite : LIVE + spectateurs, likes
	------------------------------------------------------------------
	local right = box({
		Name = "Stats",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -MARGIN, 0, MARGIN + (HOST_H - RIGHT_H) / 2),
		Size = UDim2.fromOffset(120, RIGHT_H * 2 + 4),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = root,
	})
	local rightScale = UI.Create("UIScale", { Parent = right })
	local live = box({ Name = "Live", AnchorPoint = Vector2.new(1, 0), Size = UDim2.fromOffset(112, RIGHT_H), BackgroundColor3 = PILL, BackgroundTransparency = 0.28, Position = UDim2.fromScale(1, 0), ZIndex = 3, Parent = right }, 6)
	local liveBadge = box({ Name = "Badge", Size = UDim2.new(0, 44, 1, 0), BackgroundColor3 = WHITE, ZIndex = 4, Parent = live }, 6)
	UI.Gradient(liveBadge, ColorSequence.new(Color3.fromRGB(255, 70, 90), Color3.fromRGB(215, 20, 50)), 90)
	local liveDot = box(at({ BackgroundColor3 = WHITE, ZIndex = 5, Parent = liveBadge }, 9, RIGHT_H / 2, 6, 6), UDim.new(1, 0))
	local liveText = text({ Text = "LIVE", Font = Theme.Fonts.Title, TextSize = 12, Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -15, 1, 0), ZIndex = 5, Parent = liveBadge })
	-- Petit bonhomme (icône "spectateurs")
	local viewerIcon = box(at({ BackgroundTransparency = 1, ZIndex = 4, Parent = live }, 53, RIGHT_H / 2, 10, 11))
	box(at({ BackgroundColor3 = Color3.fromRGB(255, 130, 140), ZIndex = 4, Parent = viewerIcon }, 5, 2.5, 5, 5), UDim.new(1, 0))
	box(at({ BackgroundColor3 = Color3.fromRGB(255, 130, 140), ZIndex = 4, Parent = viewerIcon }, 5, 8.5, 9, 5), 2)
	local viewers = text({
		Name = "Count",
		Text = "0",
		Font = Theme.Fonts.Number,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(61, 0),
		Size = UDim2.new(1, -62, 1, 0),
		ZIndex = 4,
		Parent = live,
	})
	local likesPill = box({ Name = "Likes", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, RIGHT_H + 4), Size = UDim2.fromOffset(64, RIGHT_H), BackgroundColor3 = PILL, BackgroundTransparency = 0.28, ZIndex = 3, Parent = right }, 6)
	local likes = text({ Name = "Count", Text = "❤️ 0", Font = Theme.Fonts.Number, TextSize = 12, TextColor3 = Color3.fromRGB(255, 176, 206), Size = UDim2.fromScale(1, 1), ZIndex = 4, Parent = likesPill })
	local likesScale = UI.Create("UIScale", { Parent = likesPill })

	------------------------------------------------------------------
	-- Objectif d'abonnés (sous la pastille)
	------------------------------------------------------------------
	local goal = box({
		Name = "Goal",
		Position = UDim2.fromOffset(MARGIN, MARGIN + HOST_H + 5),
		Size = UDim2.fromOffset(GOAL_W, GOAL_H),
		BackgroundColor3 = PILL,
		BackgroundTransparency = 0.25,
		ClipsDescendants = true,
		ZIndex = 3,
		Parent = root,
	}, UDim.new(1, 0))
	UI.Stroke(goal, Color3.fromRGB(210, 160, 255), 1, 0.5)
	local goalFill = box({ Name = "Fill", Size = UDim2.fromScale(0.5, 1), BackgroundColor3 = WHITE, BackgroundTransparency = 0.1, ZIndex = 3, Parent = goal }, UDim.new(1, 0))
	local goalGradient = UI.Gradient(goalFill, ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(150, 80, 255)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 90, 180)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 80, 255)),
	}), 0)
	local goalLabel = text({
		Name = "Label",
		Text = Locale.T("💜 Follower goal"),
		RichText = true,
		Font = Theme.Fonts.Title,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(8, 0),
		Size = UDim2.new(0.55, -8, 1, 0),
		ZIndex = 4,
		Parent = goal,
	})
	local goalCount = text({
		Name = "Count",
		Text = "",
		Font = Theme.Fonts.Number,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 0),
		Size = UDim2.new(0.45, -4, 1, 0),
		ZIndex = 4,
		Parent = goal,
	})
	for _, label in ipairs({ nameLabel, subtitle, viewers, likes, goalLabel, goalCount, liveText }) do
		shadow(label)
	end

	------------------------------------------------------------------
	-- API
	------------------------------------------------------------------
	local hud = { Root = root, Follow = follow, Crown = crown }
	local compact = false
	local shownViewers, shownLikes, shownRising = "", "", false

	function hud.SetFollowed(followed: boolean)
		shine.Visible = not followed
		if followed then
			follow.Text = Locale.T("✅ Following")
			follow.BackgroundColor3 = FOLLOWED_COLOR
			followGradient.Color = ColorSequence.new(WHITE, Color3.fromRGB(220, 220, 230))
			followStroke.Color = Color3.fromRGB(140, 130, 170)
			followStroke.Transparency = 0.5
		else
			follow.Text = Locale.T("💜 Follow")
			follow.BackgroundColor3 = FOLLOW_COLOR
			followGradient.Color = ColorSequence.new(WHITE, Color3.fromRGB(215, 190, 230))
			followStroke.Color = Color3.fromRGB(255, 190, 220)
			followStroke.Transparency = 0.2
		end
	end

	function hud.SetViewers(value: string, rising: boolean)
		if value ~= shownViewers then
			shownViewers = value
			viewers.Text = value
			live.Size = UDim2.fromOffset(66 + #value * 7, RIGHT_H)
		end
		if rising ~= shownRising then
			shownRising = rising
			viewers.TextColor3 = rising and Color3.fromRGB(150, 255, 180) or WHITE
		end
	end

	function hud.SetLikes(value: string)
		if value ~= shownLikes then
			shownLikes = value
			likes.Text = value
			likesPill.Size = UDim2.fromOffset(24 + #value * 6, RIGHT_H)
		end
	end

	function hud.BumpLikes()
		likesScale.Scale = 1.25
		UI.Tween(likesScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	end

	function hud.SetSubtitle(rich: string)
		subtitle.Text = rich
	end

	-- ratio 0..1 ; countText "5 802 / 6 000"
	function hud.SetGoal(ratio: number, countText: string)
		goalFill.Size = UDim2.fromScale(ratio, 1)
		goalCount.Text = countText
	end

	-- follower (texte riche) : "Nouvel abonné : X" ; nil : l'objectif
	function hud.ShowFollower(rich: string?)
		if rich then
			goalLabel.Text = rich
			goalLabel.Size = UDim2.new(1, -16, 1, 0)
			goalCount.Visible = false
		else
			goalLabel.Text = Locale.T("💜 Follower goal")
			goalLabel.Size = UDim2.new(0.55, -8, 1, 0)
			goalCount.Visible = true
		end
	end

	function hud.ResetGoalShine()
		goalGradient.Offset = Vector2.new(0, 0)
	end

	-- Centre du bouton Suivre, en pixels de la vidéo (effets de gain)
	function hud.FollowCenter(): Vector2
		local scale = hostScale.Scale
		local width = compact and (HOST_H + FOLLOW_W + 10) or HOST_W
		return Vector2.new(MARGIN + (width - 5 - FOLLOW_W / 2) * scale, MARGIN + HOST_H / 2 * scale)
	end

	-- Téléphone : pastilles agrandies, seulement l'essentiel
	function hud.SetCompact(on: boolean)
		compact = on
		hostScale.Scale = on and 1.45 or 1
		rightScale.Scale = on and 1.45 or 1
		nameLabel.Visible = not on
		subtitle.Visible = not on
		likesPill.Visible = not on
		goal.Visible = not on
		host.Size = UDim2.fromOffset(on and (HOST_H + FOLLOW_W + 10) or HOST_W, HOST_H)
		topShade.Size = UDim2.new(1, 0, 0, on and 84 or 70)
	end

	-- Animations (appelé par la boucle de LiveStream, ≤ 30 Hz)
	function hud.Step(clock: number)
		local blink = math.sin(clock * 5) > 0
		liveDot.BackgroundTransparency = blink and 0 or 0.7
		liveTag.BackgroundTransparency = blink and 0 or 0.2
		ringGradient.Rotation = (clock * 60) % 360
		goalGradient.Offset = Vector2.new((clock * 0.25) % 1 - 0.5, 0)
		if shine.Visible then
			shineGradient.Offset = Vector2.new(((clock * 0.5) % 2) - 1, 0)
		end
	end

	return hud
end

return Hud
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="148">
          <Properties>
            <string name="Name">LiveStream</string>
            <string name="Source"><![CDATA[--[[
	LiveStream (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > LiveStream

	Faux live "ASMR mukbang" (slot L3, 384x268, en bas à gauche), façon
	vraie appli de streaming (v8 : tout est redessiné en Frames) :
	  - en-tête : avatar dessiné avec anneau "en direct", pseudo certifié,
	    titre du live (catégorie, qualité, durée qui défile) et bouton
	    "Suivre" ;
	  - la vidéo, filmée comme une vraie webcam : mur de studio (mousse
	    acoustique, ruban LED, étagère, néon), la streameuse DESSINÉE
	    (cheveux, casque à oreilles de chat lumineuses, yeux avec iris et
	    reflets, sourcils et bouche expressifs : sourire, bouche grande
	    ouverte, mâche, "O" étonné, bouche de chat, parle), deux bras
	    articulés (épaule / coude / main) qui prennent la nourriture avec
	    des baguettes, boivent un bubble tea, font un cœur avec les mains
	    ou saluent ; la table (set de table, assiette, bol de nouilles
	    fumant, bubble tea, micro "moumoute") ;
	  - l'habillage du live : cadre caméra (coins de visée), vignettage,
	    pastilles "● LIVE" + spectateurs + likes, barre "objectif
	    d'abonnés" qui se remplit (et fête l'objectif atteint), alertes
	    de dons animées ;
	  - améliorations : "StreamStudio" ajoute ring light (1), LED
	    arc-en-ciel (2), micro pro sur bras articulé (3), lumières bokeh
	    (5), qualité 4K (7) ; "Followers" fait monter les spectateurs,
	    accélère le chat et pose des trophées sur l'étagère (5 / 10 / 15) ;
	  - bouton "Suivre" : si ClientState.Data.LiveFollowed est faux,
	    Interact("Follow") (récompense unique par partie), puis "✔ Abonné"
	    et les dons commencent ;
	  - dons : OnSpawn("Donation") affiche une alerte dorée dans la vidéo,
	    cliquable -> ClaimSpawn ; OnBonus("Donation" / "Follow") fait
	    flotter le gain ;
	  - Feature "LiveChat" : colonne de chat (avatars à initiale, badges
	    🛡️ modo / 💎 abonné / 👑 VIP, emotes en grand, message épinglé,
	    champ "Envoyer un message", raids) qui réagit à tout ce qui se
	    passe. Les lignes du chat sont RECYCLÉES (réserve fixe) ;
	  - Feature "Butter" : un bloc de beurre brillant. Clic = son "Crunch",
	    traces de dents, éclats, "+X" = gain par clic x ClickFraction,
	    Interact("Butter") limité côté client à MaxPerSecond.
	v9 :
	  - le joueur ÉCRIT dans le chat (Live > ChatInput : champ, bouton ➤,
	    Entrée, tactile, 120 caractères, mode lent). Le texte passe par le
	    filtre du serveur (RemoteFunction "FilterText") : seul le texte FILTRÉ
	    s'affiche, dans un style "toi" doré (photo d'avatar, pseudo affiché).
	    La streameuse le lit dans une bulle, réagit (expression, geste, emoji,
	    cœurs) puis répond ; 1 à 4 spectateurs répondent en 1 à 6 s selon les
	    sujets détectés (Shared > ChatTopics, réponses dans Live > ChatReplies),
	    parfois avec une mention @pseudo ; le chat se calme quelques secondes
	    pour qu'on puisse lire ;
	  - nouvelles expressions (rire, cœurs dans les yeux, boude, réfléchit,
	    bâille, clin d'œil, chut...) et gestes (main au menton, bras en l'air,
	    mains sur les joues, montre le chat, chut) ; elle parle aussi dans la
	    bulle pour les grands moments (abonnement, dons, raids, objectif) ;
	  - chaque niveau de "StreamStudio" se voit : 1 ring light, 2 LED RGB,
	    3 micro pro + HD, 4 tubes néon, 5 bokeh, 6 casque RGB + sweat étoile,
	    7 4K, 8 faisceaux de scène, 9 couronne sur l'avatar, 10 cadre doré ;
	  - widget d'objectif : alterne avec "Nouvel abonné : X" ;
	  - boucle de rendu plafonnée à 30 images/s, textes mis à jour seulement
	    quand ils changent.
	v9.1 (« le live n'a pas changé en mieux ») : NOUVELLE MISE EN SCÈNE,
	pensée pour une carte d'environ 350 x 245 px :
	  - la vidéo occupe TOUTE la carte ; l'habillage est posé dessus comme
	    sur une appli de live (Live > Hud : pastille de la streameuse avec
	    Suivre, ● LIVE + spectateurs, likes, objectif) ;
	  - une CAMÉRA filme la scène en gros plan (UIScale sur le plateau) :
	    la streameuse est ~1,6 fois plus grande, décalée à droite quand le
	    chat est là ; la caméra respire, zoome d'un coup à chaque bouchée,
	    se rapproche quand elle lit ton message, tremble pendant un raid ;
	  - le chat (Live > ChatPanel) est posé en bas à gauche : bulles sombres
	    à la largeur du texte, texte plus gros et ombré, les anciens
	    messages s'estompent ; la saisie reste en bas (Live > ChatInput) ;
	  - sa bulle de parole est au-dessus du chat, pointée vers sa bouche ;
	  - plus expressive : symboles de manga près de la tête (❗ 💢 💤 ❓ 💕
	    ♪ 💧...), rebond de tout le corps quand elle croque, cœurs le long
	    du bord droit, onomatopées en grand.
	Performance : UNE seule boucle de rendu (repas, chat, raids, particules
	recyclées, caméra...) qui se met en pause quand le live n'est pas visible.
]]

local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Locale = require(ReplicatedStorage.Shared.Locale)
local ChatTopics = require(ReplicatedStorage.Shared.ChatTopics)
local Replies = require(script.Parent.Live.ChatReplies)
local ChatPanel = require(script.Parent.Live.ChatPanel)
local Hud = require(script.Parent.Live.Hud)

local LiveStream = {}
LiveStream.Slot = "L3"

----------------------------------------------------------------------
-- Disposition (pixels "design" de la carte, 380 x 264 dans le slot L3).
-- v9.1 : la vidéo couvre toute la carte. La SCÈNE (mur, streameuse, table)
-- garde ses mesures "de plateau" (210 de haut, x compté depuis le centre =
-- la streameuse) ; la caméra (UIScale) la filme en gros plan : le point
-- (0, HEAD_Y) de la scène est affiché en (camX, FACE_VY) dans la vidéo.
----------------------------------------------------------------------
local SLOT_W, SLOT_H = 384, 268 -- = Slots.Definitions.L3

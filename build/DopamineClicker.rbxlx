	-- Arrosoir (dessiné) + gouttes (réserve réutilisée)
	------------------------------------------------------------------
	local can = frame({
		Name = "WateringCan",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(176, 16),
		Size = UDim2.fromOffset(34, 24),

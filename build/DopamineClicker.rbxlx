	lens.Reflectance = 0.3
	b.Box(26, 40, 22, 14, 10, 1, rgb(255, 250, 230), M.Neon)
	b.CylZ(-28, 44, 22, 10, 2, CARBON)
	b.Cyl(26, 56, 6, 8, 4, rgb(255, 90, 110), M.SmoothPlastic)
	-- photo qui sort
	b.BoxR(CFrame.new(0, 4, 26) * CFrame.Angles(-0.3, 0, 0), 30, 2, 26, WHITE)
	b.BoxR(CFrame.new(0, 5.2, 27) * CFrame.Angles(-0.3, 0, 0), 24, 0.6, 18, rgb(255, 190, 150))
	b.Footprint(80, 50, 66)
end

R.RetroHandheld = function(b, _ctx)
	local body = vivid(b, 1, rgb(170, 150, 230))
	local cf = CFrame.new(0, 40, 0) * CFrame.Angles(-0.3, 0, 0)
	b.BoxR(cf, 50, 76, 12, body, M.SmoothPlastic)
	local g = House3DKit.Gap(b, 0.6)
	b.BoxR(cf * CFrame.new(0, 16, 6 + g / 2), 40, 32, g, rgb(90, 90, 110))
	local lcd = b.BoxR(cf * CFrame.new(0, 16, 6 + 1.5 * g), 32, 24, g, rgb(170, 230, 150), M.Neon)
	table.insert(b.Glows, lcd)
	b.BoxR(cf * CFrame.new(-12, -16, 6.8), 14, 4, 2, CARBON)
	b.BoxR(cf * CFrame.new(-12, -16, 6.8), 4, 14, 2, CARBON)
	for _, p in ipairs({ { 10, -12 }, { 18, -18 } }) do
		local q = (cf * CFrame.new(p[1], p[2], 6.8)).Position
		b.Ball(q.X, q.Y, q.Z, 7, rgb(255, 90, 140), M.SmoothPlastic)
	end
	b.Round(0, 0, -6, 44, 3, 28, 4, rgb(240, 236, 246), M.SmoothPlastic)
	b.Footprint(52, 30, 82)
end

-- Casques audio (chat / gamer RGB)
local function headphones(cat: boolean)
	return function(b: Builder, _ctx: any)
		local color = vivid(b, 1, cat and rgb(255, 170, 210) or rgb(90, 90, 120))
		b.Cyl(0, 0, 0, 36, 4, rgb(250, 246, 250), M.SmoothPlastic)
		b.Tube(0, 4, 0, 0, 58, 0, 4, CHROME, M.Metal)
		local points = {}
		for index = 0, 10 do
			local a = index / 10 * math.pi
			table.insert(points, { math.cos(a) * 30, 56 + math.sin(a) * 30, 0 })
		end
		House3DKit.Path(b, points, 7, color, M.SmoothPlastic)
		for _, side in ipairs({ -1, 1 }) do
			b.CylX(side * 32, 50, 0, 30, 10, color, M.SmoothPlastic)
			local pad = b.CylX(side * 26, 50, 0, 24, 3, cat and rgb(255, 240, 246) or CARBON, M.Fabric)
			local _ = pad
			if cat then
				House3DKit.Triangle(b, side * 22, 90, -3, 16, 16, side * -0.4, 6, color, M.SmoothPlastic)
				House3DKit.Triangle(b, side * 22, 89, 2.5, 8, 9, side * -0.4, 1, rgb(255, 196, 214), M.SmoothPlastic)
			else
				local ring = b.CylX(side * 37.3, 50, 0, 20, 1, side < 0 and NEON_PINK or NEON_CYAN, M.Neon)
				table.insert(b.Glows, ring)
				b.Light(ring, side < 0 and NEON_PINK or NEON_CYAN, 8, 0.5)
			end
		end
		if not cat then
			b.Tube(-32, 42, 8, -16, 34, 18, 3, CARBON, M.SmoothPlastic)
			b.Ball(-16, 34, 18, 5, CARBON, M.SmoothPlastic)
		end
		b.Footprint(80, 36, 100)
	end
end
R.CatHeadphones = headphones(true)
R.RGBHeadset = headphones(false)

R.RobotVacuum = function(b, _ctx)
	local body = vivid(b, 1, rgb(200, 190, 240))
	b.Cyl(0, 2, 0, 90, 16, body, M.SmoothPlastic)
	b.Cyl(0, 18, 0, 70, 3, lighten(body, 0.3), M.SmoothPlastic)
	b.Cyl(0, 0, 0, 86, 3, CARBON, M.Rubber)
	b.Box(0, 10, 44, 40, 6, 3, CARBON, M.Rubber)
	local led = b.Cyl(0, 21, 10, 10, 1.5, NEON_CYAN, M.Neon)
	table.insert(b.Glows, led)
	for _, side in ipairs({ -1, 1 }) do
		b.Ball(side * 12, 22, 20, 6, INK, M.SmoothPlastic)
		b.Egg(side * 20, 20, 24, 8, 3, 4, rgb(255, 150, 180), M.SmoothPlastic)
		b.Tube(side * 30, 2, 36, side * 44, 1, 44, 1, CARBON, M.SmoothPlastic)
	end
	b.Footprint(90, 90, 24)
end

R.AirConditioner = function(b, _ctx)
	local body = rgb(248, 248, 252)
	local g = House3DKit.Gap(b, 0.6)
	-- (v9.8) split mural : coque arrondie, grille d'aspiration sur le dessus,
	-- volet orientable, lamelles, afficheur, tuyau d'évacuation
	b.Round(0, 30, 10, 96, 40, 20, 8, body, M.SmoothPlastic)
	for index = 0, 9 do
		b.Box(-40 + index * 8.8, 70, 10, 5, g, 16, rgb(220, 224, 236), M.SmoothPlastic)
	end
	b.BoxR(CFrame.new(0, 34, 20) * CFrame.Angles(0.5, 0, 0), 84, 8, 2, lighten(body, 0.1), M.SmoothPlastic)
	b.Box(0, 30.6, 17, 78, 3, 5, rgb(60, 64, 76), M.SmoothPlastic)
	for index = 0, 5 do
		b.Box(0, 36 + index * 4, 20 + g / 2, 80, 1, g, rgb(220, 224, 236))
	end
	b.Box(36, 54.5, 20 + g / 2, 12, 6, g, rgb(40, 44, 52), M.SmoothPlastic)
	b.Tube(-44, 32, 4, -46, 4, 4, 2.4, rgb(220, 220, 228), M.SmoothPlastic)
	local led = b.Box(36, 56, 20 + 1.5 * g, 6, 3, g, rgb(120, 255, 170), M.Neon)
	table.insert(b.Glows, led)
	-- petit souffle froid (flocons)
	for index = 0, 4 do
		local x = -30 + index * 15
		b.Ball(x, 22 - (index % 2) * 6, 26, 4, rgb(200, 240, 255), M.Neon)
	end
	b.Footprint(96, 24, 80)
end

R.SatelliteDish = function(b, _ctx)
	local body = rgb(236, 238, 246)
	local accent = vivid(b, 1, rgb(255, 130, 170))
	b.Box(0, 30, 3, 20, 30, 6, rgb(200, 200, 210), M.Metal)
	b.Tube(0, 45, 6, 0, 45, 22, 5, CHROME, M.Metal)
	b.EggR(CFrame.new(0, 54, 30) * CFrame.Angles(-1.0, 0.35, 0), 72, 72, 16, accent, M.Metal)
	b.EggR(CFrame.new(0, 56, 32) * CFrame.Angles(-1.0, 0.35, 0), 64, 64, 12, body, M.Metal)
	for _, side in ipairs({ -1, 1 }) do
		b.Tube(side * 20, 40, 34, 0, 62, 50, 1.5, CHROME, M.Metal)
	end
	b.Tube(0, 76, 32, 0, 62, 50, 1.5, CHROME, M.Metal)
	local tip = b.Ball(0, 62, 50, 6, rgb(255, 90, 90), M.Neon)
	b.Light(tip, rgb(255, 90, 90), 6, 0.4)
	b.Footprint(76, 60, 100)
end

R.GameConsole = function(b, _ctx)
	local body = vivid(b, 1, rgb(90, 90, 110))
	b.Round(0, 0, 0, 80, 16, 50, 8, body, M.SmoothPlastic)
	b.Box(0, 16, 0, 60, 2, 36, lighten(body, 0.2), M.SmoothPlastic)
	local led = b.Box(28, 8, 25.3, 10, 2, 0.6, NEON_CYAN, M.Neon)
	table.insert(b.Glows, led)
	-- manette
	b.Egg(-6, 22, 18, 40, 8, 22, rgb(250, 250, 255), M.SmoothPlastic)
	for _, side in ipairs({ -1, 1 }) do
		b.Egg(-6 + side * 16, 22, 24, 12, 8, 14, rgb(250, 250, 255), M.SmoothPlastic)
	end
	b.Ball(-16, 26, 20, 5, CARBON, M.SmoothPlastic)
	b.Ball(4, 26, 20, 4, rgb(255, 90, 120), M.SmoothPlastic)
	b.Ball(8, 26, 16, 4, rgb(90, 200, 255), M.SmoothPlastic)
	b.Footprint(80, 50, 30)
end

R.ConsoleSet = function(b, _ctx)
	local body = vivid(b, 1, rgb(60, 60, 80))
	b.Round(0, 0, -8, 70, 44, 22, 6, body, M.SmoothPlastic)
	local stripe = b.Box(0, 4, 3.3, 4, 36, 0.6, NEON_CYAN, M.Neon)
	table.insert(b.Glows, stripe)
	for index, x in ipairs({ -22, 22 }) do
		local color = index == 1 and rgb(255, 110, 140) or rgb(110, 180, 255)
		b.Egg(x, 5, 18, 36, 8, 20, color, M.SmoothPlastic)
		for _, side in ipairs({ -1, 1 }) do
			b.Egg(x + side * 14, 5, 22, 12, 8, 14, color, M.SmoothPlastic)
		end
		b.Ball(x - 8, 9, 18, 5, CARBON, M.SmoothPlastic)
		b.Ball(x + 8, 9, 18, 5, CARBON, M.SmoothPlastic)
	end
	b.Footprint(90, 50, 48)
end

-- Casques VR
local function vr(pro: boolean)
	return function(b: Builder, _ctx: any)
		local body = vivid(b, 1, pro and rgb(70, 70, 90) or rgb(255, 255, 255))
		b.Round(0, 0, 0, 60, 6, 40, 6, rgb(240, 236, 246), M.SmoothPlastic)
		b.Round(0, 14, 0, 76, 32, 36, 12, body, M.SmoothPlastic)
		local visor = b.Box(0, 18, 18.2, 64, 24, 1, pro and NEON_CYAN or rgb(40, 40, 60), pro and M.Neon or M.Glass)
		if pro then
			table.insert(b.Glows, visor)
			b.Light(visor, NEON_CYAN, 8, 0.5)
		else
			visor.Reflectance = 0.3
		end
		-- (v9.9 SCALE99) casque complet : mousse de visage à l'arrière, sangle
		-- élastique qui fait le tour (et le dessus de la tête), capteurs devant
		local strap = pro and CARBON or rgb(220, 220, 236)
		local g = House3DKit.Gap(b, 0.6)
		b.Round(0, 16, -18 - g, 64, 26, 6, 6, rgb(60, 58, 70), M.Fabric)
		local loop = {}
		for index = 0, 12 do
			local a = index / 12 * math.pi
			table.insert(loop, { math.cos(a) * 38, 30, -18 - math.sin(a) * 30 })
		end
		House3DKit.Path(b, loop, 5, strap, M.Fabric)
		House3DKit.Path(b, { { 0, 46, -10 }, { 0, 52, -26 }, { 0, 34, -46 } }, 4, strap, M.Fabric)
		for _, x in ipairs({ -26, 26 }) do
			for _, y in ipairs({ 20, 38 }) do
				b.CylZ(x, y, 18.2 + g, 4, g, rgb(20, 20, 26), M.Glass)
			end
		end
		b.Footprint(80, 44, 52)
	end
end
R.VRGoggles = vr(false)
R.VRHeadset = vr(true)

R.KaraokeMic = function(b, _ctx)
	local color = vivid(b, 1, rgb(255, 150, 210))
	b.Cyl(0, 0, 0, 44, 5, CARBON, M.Metal)
	b.Tube(0, 5, 0, 0, 60, 0, 4, CHROME, M.Metal)
	b.Tube(0, 60, 0, 0, 72, 6, 7, color, M.SmoothPlastic)
	local head = b.Ball(0, 80, 8, 20, CHROME, M.DiamondPlate)
	local _ = head
	b.Cyl(0, 70, 7, 16, 3, color, M.SmoothPlastic)
	for index = 0, 3 do
		local a = index * 1.6
		b.Ball(math.cos(a) * 22, 76 + math.sin(a) * 12, 4, 4, index % 2 == 0 and rgb(255, 230, 120) or NEON_PINK, M.Neon)
	end
	b.Footprint(48, 44, 94)
end

R.Projector = function(b, _ctx)
	local body = vivid(b, 1, rgb(90, 90, 110))
	-- trépied
	for index = 0, 2 do
		local a = index / 3 * math.pi * 2
		b.Tube(0, 36, 0, math.cos(a) * 22, 0, math.sin(a) * 18, 3, CHROME, M.Metal)
	end
	b.Round(0, 36, 0, 60, 24, 40, 6, body, M.Metal)
	for _, x in ipairs({ -16, 16 }) do
		b.CylZ(x, 72, -4, 34, 6, darken(body, 0.2), M.Metal)
		b.CylZ(x, 72, -4, 10, 7, CHROME, M.Metal)
	end
	b.CylX(36, 48, 0, 16, 14, CARBON, M.Metal)
	local lens = b.CylX(43.5, 48, 0, 12, 1, rgb(255, 250, 220), M.Neon)
	b.Light(lens, rgb(255, 250, 220), 10, 0.7)
	-- faisceau
	local beam = b.Part("Part", CFrame.new(70, 52, 0) * CFrame.Angles(0, 0, 0.1), Vector3.new(44, 14, 14), rgb(255, 250, 230), M.Neon, "Faisceau");
	(beam :: Part).Shape = Enum.PartType.Cylinder
	beam.Transparency = 0.85
	beam.CastShadow = false
	b.Footprint(76, 40, 92)
end

R.AlarmClock = function(b, _ctx)
	local body = vivid(b, 1, rgb(255, 120, 150))
	for _, side in ipairs({ -1, 1 }) do
		b.Tube(side * 18, 0, 0, side * 14, 12, 0, 5, CHROME, M.Metal)
		b.Egg(side * 20, 80, -2, 26, 18, 22, body, M.Metal)
	end
	b.Tube(-20, 80, -2, 20, 80, -2, 3, CHROME, M.Metal)
	b.CylZ(0, 44, 0, 70, 30, body, M.SmoothPlastic)
	-- (v9.9 SCALE99) cadran en couches franchement espacées (g ≈ 0,035 stud) :
	-- cadran, index, aiguilles à l'heure réelle, trotteuse, cache-axe (avant,
	-- les couches trop fines grossissaient à l'anti-scintillement et
	-- cachaient les aiguilles)
	local g = House3DKit.Gap(b, 0.6)
	local F = 15 -- (faces du même côté toujours à >= g l'une de l'autre)
	b.CylZ(0, 44, F + 0.25 * g, 56, 1.5 * g, rgb(255, 250, 240), M.SmoothPlastic)
	for index = 0, 11 do
		local a = index / 12 * math.pi * 2
		b.Box(math.sin(a) * 23, 44 + math.cos(a) * 23 - 1.5, F + 2 * g, index % 3 == 0 and 2.6 or 1.8, index % 3 == 0 and 4 or 3, g, INK)
	end
	House3DTime.Hand(b, "H", 0, 44, F + 3 * g, 14, 3, 3, g, INK)
	House3DTime.Hand(b, "M", 0, 44, F + 4.5 * g, 21, 4, 2.2, g, INK)
	House3DTime.Hand(b, "S", 0, 44, F + 6 * g, 23, 6, 0.9, g, rgb(220, 50, 60))
	b.Ball(0, 44, F + 7.6 * g, math.max(4, 1.6 * g), GOLD, M.Metal)
	b.Footprint(76, 34, 92)
end

R.Typewriter = function(b, _ctx)
	local body = vivid(b, 1, rgb(140, 200, 180))
	b.Round(0, 0, -4, 84, 26, 50, 8, body, M.SmoothPlastic)
	b.Part("WedgePart", CFrame.new(0, 13, 26) * CFrame.Angles(0, math.pi, 0) * CFrame.new(0, 0, 0), Vector3.new(76, 26, 12), body, M.SmoothPlastic, "Clavier")
	for row = 0, 2 do
		for column = 0, 7 do
			local x = -28 + column * 8 + row * 2
			b.Cyl(x, 12 + row * 6, 24 - row * 5, 5, 3, row == 1 and rgb(250, 250, 240) or INK, M.SmoothPlastic)
		end
	end
	b.CylX(0, 34, -12, 12, 92, CARBON, M.Rubber)
	for _, side in ipairs({ -1, 1 }) do
		b.CylX(side * 48, 34, -12, 8, 4, CHROME, M.Metal)
	end
	b.BoxR(CFrame.new(0, 50, -16) * CFrame.Angles(-0.2, 0, 0), 44, 34, 1, WHITE)
	for index = 0, 3 do
		b.BoxR(CFrame.new(-4, 56 - index * 5, -15.2) * CFrame.Angles(-0.2, 0, 0), 30 - index * 4, 1.2, 0.4, rgb(120, 120, 140))
	end
	b.Footprint(90, 60, 66)
end

R.DeskFan = function(b, _ctx)
	local color = vivid(b, 1, rgb(140, 210, 255))
	b.Cyl(0, 0, 0, 44, 6, color, M.SmoothPlastic)
	b.Tube(0, 6, 0, 0, 50, 0, 6, CHROME, M.Metal)
	b.Egg(0, 56, -8, 18, 18, 22, color, M.SmoothPlastic)
	-- cage ronde + pales
	local points = {}
	for index = 0, 16 do
		local a = index / 16 * math.pi * 2
		table.insert(points, { math.cos(a) * 34, 58 + math.sin(a) * 34, 6 })
	end
	House3DKit.Path(b, points, 2.5, CHROME, M.Metal)
	for index = 0, 5 do
		local a = index / 6 * math.pi
		b.Tube(math.cos(a) * 34, 58 + math.sin(a) * 34, 7, -math.cos(a) * 34, 58 - math.sin(a) * 34, 7, 0.8, CHROME, M.Metal)
	end
	for index = 0, 2 do
		local a = index / 3 * math.pi * 2
		b.EggR(CFrame.new(math.cos(a) * 14, 58 + math.sin(a) * 14, 4) * CFrame.Angles(0, 0.3, a), 26, 12, 1.5, lighten(color, 0.3), M.SmoothPlastic)
	end
	b.CylZ(0, 58, 6, 10, 4, color, M.SmoothPlastic)
	b.Footprint(70, 44, 94)
end

R.DrawingTablet = function(b, _ctx)
	local body = vivid(b, 1, rgb(90, 90, 110))
	local cf = CFrame.new(0, 14, 0) * CFrame.Angles(-1.1, 0, 0)
	b.BoxR(cf, 80, 56, 5, body, M.SmoothPlastic)
	local g = House3DKit.Gap(b, 0.6)
	local panel = b.BoxR(cf * CFrame.new(0, 0, 2.5 + g / 2), 66, 44, g, rgb(255, 250, 244), M.Neon)
	table.insert(b.Glows, panel)
	-- dessin : un arc-en-ciel de petits traits
	for index, color in ipairs({ rgb(255, 110, 140), rgb(255, 200, 90), rgb(120, 200, 255) }) do
		b.BoxR(cf * CFrame.new(-10 + index * 6, 4 - index * 3, 2.5 + 1.5 * g) * CFrame.Angles(0, 0, 0.3), 24, 2.5, g, color)
	end
	b.BoxR(CFrame.new(30, 6, 20) * CFrame.Angles(0, 0.6, 0), 4, 4, 40, rgb(250, 250, 255), M.SmoothPlastic)
	b.Footprint(84, 40, 34)
end

R.Hologram = function(b, _ctx)
	local color = vivid(b, 1, rgb(90, 220, 255))
	b.Cyl(0, 0, 0, 70, 10, CARBON, M.Metal)
	local ring = b.Cyl(0, 10, 0, 60, 2, color, M.Neon)
	b.Light(ring, color, 12, 0.8)
	-- globe holographique (anneaux néon semi-transparents)
	for index = 0, 3 do
		local a = index / 4 * math.pi
		local band = b.Part("Part", CFrame.new(0, 56, 0) * CFrame.Angles(0, a, 0) * CFrame.Angles(0, 0, math.pi / 2) * CFrame.Angles(0, 0, 0), Vector3.new(1, 60, 60), color, M.Neon, "Anneau");
		(band :: Part).Shape = Enum.PartType.Cylinder
		band.Transparency = 0.8
		band.CastShadow = false
	end
	local core = b.Ball(0, 56, 0, 26, lighten(color, 0.4), M.Neon)
	core.Transparency = 0.45
	core.CastShadow = false
	local beam = b.Cyl(0, 12, 0, 40, 16, color, M.Neon)
	beam.Transparency = 0.8
	beam.CastShadow = false
	b.Footprint(70, 70, 90)
end

----------------------------------------------------------------------
-- CUISINE GOURMANDE
----------------------------------------------------------------------

R.CroissantBasket = function(b, _ctx)
	local wicker = rgb(210, 160, 100)
	b.Cyl(0, 0, 0, 60, 6, darken(wicker, 0.15), M.WoodPlanks)
	b.Egg(0, 16, 0, 84, 28, 64, wicker, M.WoodPlanks)
	b.Cyl(0, 22, 0, 76, 4, lighten(wicker, 0.1), M.WoodPlanks)
	b.Cyl(0, 24, 0, 70, 2 + House3DKit.Gap(b, 0.6), rgb(255, 240, 240), M.Fabric)
	for index, p in ipairs({ { -18, 32, 4, 0.4 }, { 14, 34, -4, -0.5 }, { 0, 40, 10, 0.1 } }) do
		local cf = CFrame.new(p[1], p[2], p[3]) * CFrame.Angles(0, p[4], 0)
		for seg = -2, 2 do
			local color = seg % 2 == 0 and rgb(236, 170, 80) or rgb(214, 140, 60)
			b.EggR(cf * CFrame.new(seg * 6, 0, math.abs(seg) * 2.5) * CFrame.Angles(0, seg * 0.35, 0), 9, 12 - math.abs(seg) * 2, 12 - math.abs(seg) * 2, color, M.SmoothPlastic)
		end
		local _ = index
	end
	b.Tube(-36, 22, 0, 0, 58, 0, 4, wicker, M.WoodPlanks)
	b.Tube(0, 58, 0, 36, 22, 0, 4, wicker, M.WoodPlanks)
	b.Footprint(84, 64, 62)
end

R.GiantLollipop = function(b, _ctx)
	local a = vivid(b, 1, rgb(255, 110, 170))
	local c = vivid(b, 2, rgb(120, 200, 255))
	b.Cyl(0, 0, 0, 30, 6, rgb(250, 240, 250), M.SmoothPlastic)
	b.Tube(0, 6, 0, 0, 60, 0, 5, WHITE, M.SmoothPlastic)
	b.CylZ(0, 74, 0, 50, 10, a, M.SmoothPlastic)
	-- spirale colorée sur les deux faces
	for _, z in ipairs({ -5.4, 5.4 }) do
		local points = {}
		for index = 0, 13 do
			local t = index / 13 * math.pi * 4
			local r = 3 + index * 1.6
			table.insert(points, { math.cos(t) * r, 74 + math.sin(t) * r, z })
		end
		House3DKit.Path(b, points, 3.5, z > 0 and c or lighten(c, 0.2), M.SmoothPlastic, false, true)
	end
	b.Egg(-4, 60, 4, 16, 10, 6, rgb(255, 240, 250), M.Fabric)
	b.Footprint(52, 30, 100)
end

-- Bar à glaces : comptoir, bacs de glace, coupe
R.SundaeBar = function(b, ctx)
	local top = ctx.TopY(1, 46)
	local body = vivid(b, 1, rgb(255, 190, 220))
	b.Round(0, 0, 0, 96, top - 4, 44, 4, body, M.SmoothPlastic)
	for index = 0, 5 do
		b.Box(-40 + index * 16, 0, 22.3, 8, top - 6, 1, index % 2 == 0 and WHITE or lighten(body, 0.3), M.SmoothPlastic)
	end
	b.Box(0, top - 4, 0, 100, 4, 48, rgb(250, 246, 250), M.Marble)
	local flavors = { rgb(255, 170, 200), rgb(255, 240, 200), rgb(140, 90, 70), rgb(170, 230, 190) }
	for index, color in ipairs(flavors) do
		local x = -36 + (index - 1) * 24
		b.Box(x, top - 2, -12, 18, 6, 14, CHROME, M.Metal)
		b.Egg(x, top + 4, -12, 16, 6, 12, color, M.SmoothPlastic)
	end
	-- coupe avec boules + cerise
	b.Cyl(20, top, 12, 12, 2, GLASS, M.Glass)
	b.Tube(20, top + 2, 12, 20, top + 10, 12, 3, GLASS, M.Glass)
	b.Egg(20, top + 14, 12, 20, 10, 20, GLASS, M.Glass)
	for index, color in ipairs({ flavors[1], flavors[4], flavors[2] }) do
		b.Ball(20 + (index - 2) * 5, top + 20 + (index == 2 and 4 or 0), 12, 11, color, M.SmoothPlastic)
	end
	b.Ball(20, top + 30, 12, 6, rgb(230, 40, 60), M.SmoothPlastic)
	b.Top(1, 0, top, 0, 90, 40)
	b.Footprint(100, 48, top + 32)
end

R.ChocolateFountain = function(b, _ctx)
	local choco = rgb(120, 70, 50)
	local chrome = CHROME
	b.Cyl(0, 0, 0, 80, 8, chrome, M.Metal)
	b.Cyl(0, 8, 0, 70, 8, choco, M.SmoothPlastic)
	for index = 0, 2 do
		local y = 24 + index * 22
		local d = 56 - index * 16
		b.Tube(0, y - 16, 0, 0, y, 0, 6, chrome, M.Metal)
		b.Cyl(0, y, 0, d, 4, chrome, M.Metal)
		b.Cyl(0, y - 10, 0, d - 4, 10, choco, M.SmoothPlastic)
	end
	b.Egg(0, 94, 0, 14, 10, 14, choco, M.SmoothPlastic)
	-- fruits à tremper
	for index = 0, 5 do
		local a = index / 6 * math.pi * 2
		b.Egg(math.cos(a) * 34, 12, math.sin(a) * 34, 8, 10, 8, index % 2 == 0 and rgb(230, 50, 70) or rgb(255, 220, 110), M.SmoothPlastic)
	end
	b.Footprint(80, 80, 100)
end

R.ShavedIceMachine = function(b, _ctx)
	local body = vivid(b, 1, rgb(120, 200, 255))
	b.Round(0, 0, 0, 60, 40, 40, 8, body, M.SmoothPlastic)
	local glass = b.Cyl(0, 40, 0, 40, 30, GLASS, M.Glass)
	glass.Transparency = 0.5
	for index = 0, 5 do
		b.Ball((index % 3 - 1) * 10, 46 + math.floor(index / 3) * 8, (index % 2) * 6 - 3, 8, rgb(240, 250, 255), M.Glass)
	end
	b.Cyl(0, 70, 0, 44, 6, darken(body, 0.2), M.SmoothPlastic)
	b.Tube(24, 76, 0, 36, 90, 0, 3, CHROME, M.Metal)
	b.Ball(36, 90, 0, 6, rgb(255, 110, 150), M.SmoothPlastic)
	-- bol de glace pilée arc-en-ciel devant
	b.Cyl(-20, 40, 22, 22, 6, WHITE, M.SmoothPlastic)
	b.Egg(-20, 48, 22, 20, 14, 20, rgb(255, 160, 200), M.SmoothPlastic)
	b.Egg(-20, 52, 22, 12, 8, 12, rgb(160, 220, 255), M.SmoothPlastic)
	b.Box(0, 10, 20.2, 30, 16, 1, rgb(255, 250, 250), M.SmoothPlastic)
	b.Footprint(70, 50, 98)
end

R.Popsicles = function(b, _ctx)
	local colors = { vivid(b, 1, rgb(255, 120, 150)), vivid(b, 2, rgb(255, 210, 90)), vivid(b, 3, rgb(140, 220, 150)) }
	b.Round(0, 0, 0, 70, 14, 30, 6, rgb(250, 246, 250), M.SmoothPlastic)
	for index, color in ipairs(colors) do
		local x = -22 + (index - 1) * 22
		local tilt = (index - 2) * 0.2
		local cf = CFrame.new(x, 50, 0) * CFrame.Angles(0, 0, tilt)
		b.BoxR(cf * CFrame.new(0, -28, 0), 5, 22, 3, rgb(230, 190, 140), M.Wood)
		b.EggR(cf * CFrame.new(0, 6, 0), 18, 42, 12, color, M.SmoothPlastic)
		b.BoxR(cf * CFrame.new(0, 2, 0), 18, 30, 12, color, M.SmoothPlastic)
		b.EggR(cf * CFrame.new(-4, 14, 6), 4, 12, 1, lighten(color, 0.5), M.SmoothPlastic)
	end
	b.Footprint(76, 30, 84)
end

R.WaffleMaker = function(b, _ctx)
	local body = vivid(b, 1, rgb(255, 150, 190))
	b.Round(0, 0, 0, 76, 20, 60, 12, body, M.SmoothPlastic)
	b.BoxR(CFrame.new(0, 40, -24) * CFrame.Angles(-1.1, 0, 0), 76, 12, 56, body, M.SmoothPlastic)
	-- gaufre dorée à carreaux
	b.Round(0, 20, 0, 58, 6, 46, 10, rgb(236, 180, 90), M.SmoothPlastic)
	for index = -2, 2 do
		b.Box(index * 10, 26, 0, 2, 1, 42, rgb(200, 140, 60))
		b.Box(0, 26, index * 8, 54, 1, 2, rgb(200, 140, 60))
	end
	b.Box(30, 10, 30.3, 10, 4, 1, rgb(120, 255, 170), M.Neon)
	b.CylX(-40, 12, 0, 8, 6, CARBON, M.SmoothPlastic)
	b.Footprint(84, 64, 60)
end

R.DumplingSteamer = function(b, _ctx)
	local bamboo = rgb(220, 180, 110)
	for index = 0, 1 do
		b.Cyl(0, index * 26, 0, 80, 24, index == 0 and bamboo or lighten(bamboo, 0.08), M.WoodPlanks)
		b.Cyl(0, index * 26 + 20, 0, 82, 4, darken(bamboo, 0.15), M.Wood)
	end
	b.Egg(0, 54, 0, 78, 18, 78, lighten(bamboo, 0.1), M.WoodPlanks)
	b.Cyl(0, 60, 0, 12, 4, darken(bamboo, 0.2), M.Wood)
	-- raviolis fumants posés devant
	for index, x in ipairs({ -18, 4, 24 }) do
		b.Egg(x, 58 + (index % 2) * 2, 26, 16, 12, 14, rgb(255, 250, 240), M.SmoothPlastic)
		b.Egg(x, 64 + (index % 2) * 2, 26, 6, 5, 6, rgb(255, 250, 240), M.SmoothPlastic)
	end
	for index = 0, 2 do
		local puff = b.Ball(-10 + index * 10, 78 + index * 6, 0, 10 - index * 2, WHITE, M.SmoothPlastic)
		puff.Transparency = 0.4
		puff.CastShadow = false
	end
	b.Footprint(82, 82, 96)
end

R.GingerbreadHouse = function(b, _ctx)
	local ginger = rgb(190, 120, 70)
	local icing = WHITE
	local candy = { vivid(b, 1, rgb(255, 110, 150)), vivid(b, 2, rgb(120, 200, 255)), vivid(b, 3, rgb(140, 220, 140)) }
	b.Cyl(0, 0, 0, 96, 4, rgb(250, 246, 250), M.SmoothPlastic)
	b.Box(0, 4, 0, 60, 36, 44, ginger, M.SmoothPlastic)
	b.Part("WedgePart", CFrame.new(-16, 54, 0) * CFrame.Angles(0, math.pi / 2, 0), Vector3.new(50, 28, 34), ginger, M.SmoothPlastic, "Toit")
	b.Part("WedgePart", CFrame.new(16, 54, 0) * CFrame.Angles(0, -math.pi / 2, 0), Vector3.new(50, 28, 34), ginger, M.SmoothPlastic, "Toit")
	-- glaçage le long des bords du toit
	for _, side in ipairs({ -1, 1 }) do
		for _, z in ipairs({ -25, 25 }) do
			b.BoxR(CFrame.new(side * 16, 55, z) * CFrame.Angles(0, 0, side * -0.69), 46, 3, 3, icing, M.SmoothPlastic)
		end
		b.Box(side * 32, 39, 0, 4, 3, 52, icing, M.SmoothPlastic)
		for index = 0, 3 do
			b.Ball(side * (8 + index * 7), 66 - index * 8, 24, 6, candy[index % 3 + 1], M.SmoothPlastic)
		end
	end
	b.Box(0, 4, 22.2, 14, 20, 1, rgb(120, 70, 40), M.SmoothPlastic)
	b.CylZ(0, 24, 22.2, 14, 1, rgb(120, 70, 40), M.SmoothPlastic)
	for _, x in ipairs({ -20, 20 }) do
		b.Box(x, 18, 22.2, 10, 10, 1, rgb(255, 230, 140), M.Neon)
		House3DKit.Frame(b, x, 17, 22.6, 12, 12, 1.5, 1, icing, M.SmoothPlastic)
	end
	b.Box(0, 38, 0, 62, 3, 46, icing, M.SmoothPlastic)
	for index = 0, 4 do
		local x = -40 + index * 20
		b.Tube(x, 4, 32, x, 18, 32, 3, WHITE, M.SmoothPlastic)
		b.BoxR(CFrame.new(x, 12, 32.3) * CFrame.Angles(0, 0, 0.6), 1.5, 5, 3.2, rgb(240, 60, 70))
	end
	b.Footprint(96, 96, 84)
end

----------------------------------------------------------------------
-- COIN GAMER / SPORT / AVENTURE
----------------------------------------------------------------------

R.BigScreenTV = function(b, _ctx)
	-- (v9.8) support mural, dos, cadre fin en alu brossé, vitre brillante
	-- devant la dalle, barre de son sous l'écran
	local g = House3DKit.Gap(b, 0.8)
	b.Box(0, 30, 0.5, 30, 20, 1, rgb(60, 60, 70), M.Metal)
	b.Round(0, 12, 3, 100, 60, 6, 3, CARBON, M.SmoothPlastic)
	b.Box(0, 12, 6 + g / 2, 99, 60, g, rgb(160, 164, 176), M.Metal).Reflectance = 0.2
	local cover = b.Box(0, 14.4, 6.6 + 5.5 * g, 95, 55.4, 0.4, rgb(220, 230, 250), M.Glass)
	cover.Transparency = 0.9
	cover.Reflectance = 0.2
	cover.CastShadow = false
	b.Box(0, 12.6, 6 + 1.5 * g, 16, 1, g, rgb(220, 224, 236), M.Metal)
	b.Round(0, 2.4, 6, 70, 5, 6, 2, rgb(34, 34, 44), M.Fabric)
	for index = -3, 3 do
		b.CylZ(index * 9, 4.9, 9 + g / 2, 3, g, rgb(20, 20, 26), M.SmoothPlastic)
	end
	local panel = screen(b, 0, 15, 6.2 + g, 94, 54, rgb(90, 150, 255))
	b.Light(panel, rgb(120, 170, 255), 14, 0.8)
	-- image de jeu : sol, montagnes, personnage
	b.Box(0, 15, 6.6 + 1.5 * g, 94, 12, g, rgb(110, 210, 120), M.Neon)
	House3DKit.Triangle(b, -24, 34, 6.6 + 2 * g, 34, 20, 0, g, rgb(140, 120, 220), M.Neon)
	House3DKit.Triangle(b, 10, 32, 6.6 + 3 * g, 26, 16, 0, g, rgb(170, 150, 240), M.Neon)
	b.Box(22, 27, 6.6 + 4.5 * g, 6, 8, g, rgb(255, 90, 90), M.Neon)
	b.Box(30, 44, 6.6 + 4.5 * g, 8, 3, g, rgb(255, 214, 90), M.Neon)
	-- rampe LED sous l'écran
	local strip = b.Box(0, 8, 4, 90, 2, 2, NEON_PINK, M.Neon)
	table.insert(b.Glows, strip)
	b.Footprint(100, 10, 76)
end

R.Dumbbells = function(b, _ctx)
	local color = vivid(b, 1, rgb(255, 110, 150))
	b.Box(0, 0, -6, 90, 6, 40, rgb(60, 60, 76), M.Metal)
	for _, z in ipairs({ -14, 6 }) do
		b.CylX(0, 18, z - 6, 6, 60, CHROME, M.Metal)
		for _, side in ipairs({ -1, 1 }) do
			b.CylX(side * 22, 18, z - 6, 26, 10, color, M.Rubber)
			b.CylX(side * 29, 18, z - 6, 20, 4, darken(color, 0.2), M.Rubber)
		end
	end
	b.Footprint(90, 40, 34)
end

R.SportsBallBin = function(b, _ctx)
	local wire = CHROME
	b.Cyl(0, 0, 0, 70, 4, rgb(80, 80, 100), M.Metal)
	for index = 0, 7 do
		local a = index / 8 * math.pi * 2
		b.Tube(math.cos(a) * 33, 4, math.sin(a) * 33, math.cos(a) * 36, 52, math.sin(a) * 36, 2, wire, M.Metal)
	end
	for _, y in ipairs({ 20, 52 }) do
		local points = {}
		for index = 0, 10 do
			local a = index / 10 * math.pi * 2
			table.insert(points, { math.cos(a) * 35, y, math.sin(a) * 35 })
		end
		House3DKit.Path(b, points, 2.5, wire, M.Metal, false, true)
	end
	local balls = { { rgb(255, 140, 50), 26 }, { WHITE, 24 }, { rgb(255, 214, 90), 22 }, { rgb(90, 160, 255), 24 }, { rgb(240, 70, 80), 20 } }
	local spots = { { -12, 18, -8 }, { 12, 18, 6 }, { 0, 20, 16 }, { -6, 42, 2 }, { 14, 40, -10 } }
	for index, p in ipairs(spots) do
		local ball = b.Ball(p[1], p[2], p[3], balls[index][2], balls[index][1], M.SmoothPlastic)
		local _ = ball
	end
	-- coutures du ballon de basket
	b.Tube(-12, 5, -8, -12, 31, -8, 1, INK, M.SmoothPlastic)
	b.Footprint(76, 76, 64)
end

R.Surfboard = function(b, _ctx)
	local color = vivid(b, 1, rgb(120, 200, 255))
	local stripe = vivid(b, 2, rgb(255, 150, 190))
	local cf = CFrame.new(0, 50, 0) * CFrame.Angles(-0.15, 0, 0.12)
	b.EggR(cf, 32, 100, 5, color, M.SmoothPlastic)
	b.BoxR(cf * CFrame.new(0, 0, 0.2), 4, 80, 5.2, stripe, M.SmoothPlastic)
	House3DKit.Heart(b, 0, 64, 2.2, 10, 1, stripe, M.SmoothPlastic)
	b.Part("WedgePart", cf * CFrame.new(0, -38, -4) * CFrame.Angles(0, math.pi / 2, 0), Vector3.new(6, 8, 1.5), CARBON, M.SmoothPlastic, "Aileron")
	b.Round(0, 0, -8, 30, 4, 18, 4, rgb(240, 220, 180), M.Sand)
	b.Footprint(40, 20, 100)
end

R.BMXBike = function(b, _ctx)
	local frame = vivid(b, 1, rgb(80, 180, 255))
	for _, x in ipairs({ -30, 30 }) do
		b.CylZ(x, 20, 0, 40, 5, CARBON, M.Rubber)
		b.CylZ(x, 20, 0, 32, 5 + 2 * House3DKit.Gap(b, 0.4), rgb(250, 250, 255), M.SmoothPlastic)
		for index = 0, 3 do
			local a = index / 4 * math.pi
			b.Tube(x + math.cos(a) * 15, 20 + math.sin(a) * 15, 0, x - math.cos(a) * 15, 20 - math.sin(a) * 15, 0, 0.8, CHROME, M.Metal)
		end
		b.CylZ(x, 20, 0, 6, 5 + 4 * House3DKit.Gap(b, 0.4), CHROME, M.Metal)
	end
	b.Tube(-30, 20, 0, -6, 22, 0, 3.5, frame, M.Metal)
	b.Tube(-6, 22, 0, 22, 44, 0, 3.5, frame, M.Metal)
	b.Tube(-10, 46, 0, 22, 44, 0, 3.5, frame, M.Metal)
	b.Tube(-10, 46, 0, -6, 22, 0, 3.5, frame, M.Metal)
	b.Tube(-30, 20, 0, -10, 46, 0, 3, frame, M.Metal)
	b.Tube(30, 20, 0, 22, 44, 0, 3.5, frame, M.Metal)
	b.Tube(22, 44, 0, 20, 58, 0, 3, CHROME, M.Metal)
	b.Tube(20, 58, -12, 20, 58, 12, 3, CHROME, M.Metal)
	for _, z in ipairs({ -12, 12 }) do
		b.CylZ(20, 58, z, 4.5, 6, CARBON, M.Rubber)
	end
	b.Egg(-12, 50, 0, 16, 5, 8, CARBON, M.Leather)
	b.Tube(-12, 46, 0, -12, 50, 0, 2, CHROME, M.Metal)
	b.CylZ(-6, 22, 0, 12, 2, CHROME, M.Metal)
	for _, z in ipairs({ -6, 6 }) do
		b.Box(-6, 20, z, 8, 2, 4, CARBON)
	end
	b.Footprint(100, 26, 62)
end

R.VolcanoModel = function(b, _ctx)
	local rock = rgb(150, 110, 100)
	b.Round(0, 0, 0, 90, 6, 70, 8, rgb(140, 200, 120), M.Grass)
	for index = 0, 4 do
		b.Cyl(0, 6 + index * 11, 0, 80 - index * 14, 11.2, index % 2 == 0 and rock or darken(rock, 0.1), M.Slate)
	end
	b.Cyl(0, 58, 0, 18, 3, rgb(255, 120, 40), M.CrackedLava)
	local lava = b.Ball(0, 64, 0, 14, rgb(255, 140, 50), M.Neon)
	b.Light(lava, rgb(255, 140, 60), 12, 1)
	for index = 0, 3 do
		local a = index * 1.6
		House3DKit.Path(b, { { math.cos(a) * 8, 58, math.sin(a) * 8 }, { math.cos(a) * 18, 42, math.sin(a) * 18 }, { math.cos(a) * 26, 26, math.sin(a) * 26 } }, 4, rgb(255, 120, 40), M.Neon, true)
	end
	for index = 0, 2 do
		local puff = b.Ball(-4 + index * 6, 76 + index * 8, 0, 12 - index * 2, rgb(200, 196, 210), M.SmoothPlastic)
		puff.CastShadow = false
	end
	for _, p in ipairs({ { -34, 20 }, { 32, -22 } }) do
		b.Cyl(p[1], 6, p[2], 3, 10, rgb(150, 100, 70), M.Wood)
		b.Ball(p[1], 20, p[2], 12, rgb(90, 170, 90), M.SmoothPlastic)
	end
	b.Footprint(90, 70, 92)
end

R.PirateShip = function(b, _ctx)
	local hull = rgb(150, 95, 60)
	local sail = rgb(250, 244, 230)
	local stand = rgb(100, 70, 50)
	b.Round(0, 0, 0, 60, 4, 26, 4, stand, M.Wood)
	for _, x in ipairs({ -18, 18 }) do
		b.Tube(x, 4, 0, x, 14, 0, 3, stand, M.Wood)
	end
	-- coque : bloc + proue en pente + poupe haute
	b.Box(-4, 14, 0, 60, 14, 22, hull, M.WoodPlanks)
	b.Part("WedgePart", CFrame.new(34, 21, 0) * CFrame.Angles(0, -math.pi / 2, 0), Vector3.new(22, 14, 16), hull, M.WoodPlanks, "Proue")
	b.Box(-28, 28, 0, 14, 10, 22, darken(hull, 0.1), M.WoodPlanks)
	b.Box(-4, 26, 0, 60, 2, 23, GOLD, M.Metal)
	for index = 0, 3 do
		b.CylZ(-20 + index * 12, 20, 11.5, 4, 2, CARBON, M.Metal)
	end
	-- mâts et voiles
	for index, x in ipairs({ -10, 12 }) do
		b.Tube(x, 28, 0, x, 92 - index * 6, 0, 3, stand, M.Wood)
		for sailIndex = 0, 1 do
			b.BoxR(CFrame.new(x, 48 + sailIndex * 20 - index * 3, 1) * CFrame.Angles(0.15, 0, 0), 30 - sailIndex * 6, 17, 1.5, sail, M.Fabric)
		end
	end
	House3DKit.Triangle(b, -8, 94, 0, 6, 12, -math.pi / 2, 1, CARBON, M.Fabric)
	b.BoxR(CFrame.new(-10, 60, 2.2), 6, 6, 0.5, CARBON, M.SmoothPlastic)
	b.Tube(34, 28, 0, 48, 40, 0, 2, stand, M.Wood)
	b.Footprint(90, 26, 100)
end

----------------------------------------------------------------------
-- ACCESSOIRES DES ANIMAUX
----------------------------------------------------------------------

R.PetFountain = function(b, _ctx)
	local body = vivid(b, 1, rgb(140, 210, 255))
	b.Cyl(0, 0, 0, 90, 10, body, M.SmoothPlastic)
	local water = b.Cyl(0, 10, 0, 80, 3, rgb(150, 210, 255), M.Glass)
	water.Transparency = 0.2
	b.Egg(0, 30, 0, 44, 40, 44, lighten(body, 0.2), M.SmoothPlastic)
	b.Cyl(0, 46, 0, 24, 6, body, M.SmoothPlastic)
	local jet = b.Cyl(0, 52, 0, 6, 10, rgb(190, 230, 255), M.Glass)
	jet.Transparency = 0.3
	for index = 0, 5 do
		local a = index / 6 * math.pi * 2
		House3DKit.Path(b, { { 0, 62, 0 }, { math.cos(a) * 12, 58, math.sin(a) * 12 }, { math.cos(a) * 20, 42, math.sin(a) * 20 } }, 2, rgb(190, 230, 255), M.Glass)
	end
	House3DKit.Heart(b, 0, 26, 21, 14, 1.5, rgb(255, 130, 170), M.SmoothPlastic)
	b.Footprint(90, 90, 70)
end

R.BirdCage = function(b, _ctx)
	local metal = b.Map(GOLD)
	b.Cyl(0, 0, 0, 64, 8, darken(metal, 0.2), M.Metal)
	for index = 0, 7 do
		local a = index / 8 * math.pi * 2
		b.Tube(math.cos(a) * 28, 8, math.sin(a) * 28, math.cos(a) * 28, 70, math.sin(a) * 28, 1.2, metal, M.Metal)
		b.Tube(math.cos(a) * 28, 70, math.sin(a) * 28, 0, 90, 0, 1.2, metal, M.Metal)
	end
	for _, y in ipairs({ 30, 70 }) do
		local points = {}
		for index = 0, 10 do
			local a = index / 10 * math.pi * 2
			table.insert(points, { math.cos(a) * 28, y, math.sin(a) * 28 })
		end
		House3DKit.Path(b, points, 2, metal, M.Metal, false, true)
	end
	b.Ball(0, 91, 0, 6, metal, M.Metal)
	b.Tube(0, 94, 0, 0, 100, 0, 1.5, metal, M.Metal)
	b.CylX(0, 32, 0, 3, 50, rgb(170, 120, 80), M.Wood)
	-- oiseau bleu
	local bird = rgb(120, 190, 255)
	b.Egg(0, 42, 0, 16, 18, 16, bird, M.SmoothPlastic)
	b.Ball(3, 53, 2, 12, bird, M.SmoothPlastic)
	b.Ball(6, 55, 7, 3, INK, M.SmoothPlastic)
	b.EggR(CFrame.new(10, 52, 4) * CFrame.Angles(0, 0, -0.4), 6, 3, 3, rgb(255, 180, 60), M.SmoothPlastic)
	b.EggR(CFrame.new(-8, 36, -2) * CFrame.Angles(0, 0, 0.6), 4, 14, 6, darken(bird, 0.15), M.SmoothPlastic)
	b.Footprint(64, 64, 100)
end

----------------------------------------------------------------------
-- TAPIS À FORME (à plat)
----------------------------------------------------------------------

local function shadowless(b: Builder, from: number)
	for index = from, #b.Parts do
		b.Parts[index].CastShadow = false
	end
end

R.HeartRug = function(b, _ctx)
	local color = vivid(b, 1, rgb(255, 130, 170))
	local before = #b.Parts + 1
	-- cœur couché : les formes plates tournées à plat (x-z)
	local flat = CFrame.Angles(-math.pi / 2, 0, 0)
	local side = 100 / 1.707
	local offset = side / (2 * math.sqrt(2))
	b.BoxR(CFrame.new(0, 0.5, 4) * flat * CFrame.Angles(0, 0, math.pi / 4), side, side, 1, color, M.Fabric)
	for _, sx in ipairs({ -1, 1 }) do
		b.Cyl(sx * offset, 0, 4 - offset, side, 1, color, M.Fabric)
	end
	local inner = side * 0.72
	local innerOffset = inner / (2 * math.sqrt(2))
	b.BoxR(CFrame.new(0, 1.2, 2) * flat * CFrame.Angles(0, 0, math.pi / 4), inner, inner, 0.5, lighten(color, 0.35), M.Fabric)
	for _, sx in ipairs({ -1, 1 }) do
		b.Cyl(sx * innerOffset, 1, 2 - innerOffset, inner, 0.5, lighten(color, 0.35), M.Fabric)
	end
	shadowless(b, before)
	b.Footprint(100, 90, 2)
end

R.CloudRug = function(b, _ctx)
	local color = vivid(b, 1, rgb(240, 244, 255))
	local before = #b.Parts + 1
	for _, p in ipairs({ { -30, 6, 40 }, { -8, -4, 46 }, { 18, -2, 42 }, { 34, 8, 34 }, { 4, 14, 44 }, { -24, 16, 30 } }) do
		b.Cyl(p[1], 0, p[2], p[3], 1, color, M.Fabric)
		b.Cyl(p[1], 0.8, p[2], p[3] * 0.8, 0.5, lighten(color, 0.4), M.Fabric)
	end
	shadowless(b, before)
	b.Footprint(100, 60, 2)
end

R.RaceTrackRug = function(b, _ctx)
	local grass = rgb(120, 200, 120)
	local road = rgb(90, 90, 104)
	local before = #b.Parts + 1
	b.Round(0, 0, 0, 100, 1, 66, 10, grass, M.Fabric)
	-- piste ovale (anneau de segments)
	local points = {}
	for index = 0, 20 do
		local a = index / 20 * math.pi * 2
		table.insert(points, { math.cos(a) * 36, 1.2, math.sin(a) * 20 })
	end
	for index = 1, #points - 1 do
		local p, q = points[index], points[index + 1]
		local from, to = Vector3.new(p[1], p[2], p[3]), Vector3.new(q[1], q[2], q[3])
		b.BoxR(CFrame.lookAt((from + to) / 2, to), 11, 1, (to - from).Magnitude + 2, road, M.Fabric)
	end
	for index = 0, 3 do
		b.Box(-4 + index * 2.5, 1.4, 20, 2, 0.5, 10, index % 2 == 0 and WHITE or CARBON, M.Fabric)
	end
	b.Box(-40, 1, -30, 12, 1, 8, rgb(255, 214, 90), M.Fabric)
	shadowless(b, before)
	b.Footprint(100, 66, 3)
end

----------------------------------------------------------------------
-- Branchement
----------------------------------------------------------------------

function House3DToys.Register(recipes: { [string]: any }, _family: { [string]: any }, helpers: any, _flags: any)
	H = helpers
	for id, recipe in pairs(R) do
		-- (v9.8) finition réaliste : reflets du métal, du verre, du marbre
		recipes[id] = House3DKit.Polished(recipe)
	end
end

return House3DToys
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">HouseArt</string>
              <string name="Source"><![CDATA[--[[
	HouseArt (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > HouseArt

	Dessins "autocollants kawaii" des objets de la maison, faits UNIQUEMENT
	avec des Frames (aucune image à importer) :
	  - une boîte à outils (Kit) : formes arrondies avec contour et ombrage,
	    ovales, traits, triangles, cœurs, étincelles, nuages, petits visages
	    kawaii, reflets, pivots de rotation et petites animations ;
	  - les dessins eux-mêmes, rangés par catégorie dans le dossier Art
	    (un ModuleScript par catégorie : { [Id d'objet] = peintre }).

	Contrat d'un peintre : function(body, kit, item) -> Result?
	  - `body` est une boîte de 100 x 100 px ("maquette") ; les objets posés
	    au sol ont leurs pieds en bas (y = 100), les objets muraux sont
	    centrés. On peut déborder un peu (fil d'une ampoule...).
	  - ZIndex relatifs (ZIndexBehavior = Sibling) : 1..9 entre frères.
	  - Result (tout est facultatif) :
	      Glow       = Color3 : halo de lumière (plus fort la nuit)
	      Flat       = true : objet posé à plat (tapis) -> pas d'ombre ovale
	      WallShadow = Vector2 : taille de l'ombre d'un objet mural (0 = aucune)
	      Bulbs      = { ampoule, halo, ampoule, halo... } : scintillement
	      ShowEmoji  = true : garde l'emoji de l'objet par-dessus (rare)
	      EmojiScale, EmojiY : taille / hauteur de cet emoji

	API :
	  HouseArt.Has(itemId) -> boolean
	  HouseArt.Paint(body, item, static?) -> (Result?, { Anim })
	      dessine l'objet dans `body` ; `static` = pas d'animation (vignettes)
	  HouseArt.Thumbnail(parent, item, size, zIndex?) -> Frame
	      vignette carrée de `size` px (dessin, ou emoji si pas de dessin)
	  HouseArt.PaintGarden(body, entry, static?) : (v9.1) déco du jardin
	      (dossier GardenArt, Config.House.GardenDecor)
	  HouseArt.NewKit(static?) -> (kit, anims) : (v9.2) la boîte à outils seule
	      (chapeaux et boutons dessinés : Components > CosmeticArt)
	  HouseArt.Step(anims, clock) : fait vivre les animations
	  HouseArt.Mirror(root, anims) : retourne le dessin gauche <-> droite
	      (les animaux qui se promènent regardent où ils vont) ; le refaire
	      remet le dessin à l'endroit
]]

local HouseArt = {}

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local SQRT2 = math.sqrt(2)
local FONT = Enum.Font.FredokaOne

-- Palette kawaii (mêmes teintes que HouseCommon.Colors + quelques couleurs)
local C = {
	White = WHITE,
	Black = BLACK,
	Ink = Color3.fromRGB(92, 58, 96), -- contours / yeux "chocolat-prune"
	Pink = Color3.fromRGB(255, 126, 182),
	PinkDeep = Color3.fromRGB(236, 72, 140),
	PinkSoft = Color3.fromRGB(255, 214, 232),
	PinkMist = Color3.fromRGB(255, 240, 247),
	Blush = Color3.fromRGB(255, 150, 170),
	Lilac = Color3.fromRGB(183, 148, 246),
	LilacSoft = Color3.fromRGB(236, 224, 255),
	Purple = Color3.fromRGB(150, 100, 220),
	Mint = Color3.fromRGB(110, 214, 176),
	MintSoft = Color3.fromRGB(214, 247, 234),
	Green = Color3.fromRGB(110, 190, 110),
	Leaf = Color3.fromRGB(120, 200, 120),
	LeafDark = Color3.fromRGB(70, 150, 90),
	Cream = Color3.fromRGB(255, 247, 236),
	Peach = Color3.fromRGB(255, 190, 160),
	Orange = Color3.fromRGB(255, 160, 90),
	Sky = Color3.fromRGB(150, 205, 255),
	Blue = Color3.fromRGB(100, 160, 240),
	Navy = Color3.fromRGB(60, 70, 130),
	Butter = Color3.fromRGB(255, 226, 130),
	Yellow = Color3.fromRGB(255, 210, 80),
	Gold = Color3.fromRGB(245, 190, 60),
	Red = Color3.fromRGB(240, 90, 100),
	Heart = Color3.fromRGB(255, 79, 139),
	Wood = Color3.fromRGB(214, 164, 120),
	WoodLight = Color3.fromRGB(236, 196, 150),
	WoodDark = Color3.fromRGB(160, 110, 78),
	Brown = Color3.fromRGB(150, 100, 80),
	Grey = Color3.fromRGB(200, 196, 210),
	GreyDark = Color3.fromRGB(120, 116, 136),
	Glass = Color3.fromRGB(200, 235, 255),
}
HouseArt.Colors = C

export type Result = {
	Glow: Color3?,
	Flat: boolean?,
	WallShadow: Vector2?,
	Bulbs: { Frame }?,
	ShowEmoji: boolean?,
	EmojiScale: number?,
	EmojiY: number?,
}

export type Anim = {
	Object: GuiObject,
	Kind: string,
	Amp: number,
	Speed: number,
	Phase: number,
	BaseRotation: number,
	BasePosition: UDim2,
	BaseTransparency: number,
	Scale: UIScale?,
}

type PartOptions = {
	Radius: number?, -- rayon des coins en px (défaut : 6) ; -1 = pilule / ovale
	Z: number?,
	T: number?, -- transparence du fond
	Outline: any?, -- false = sans contour ; Color3 = couleur ; défaut = teinte foncée
	Thickness: number?, -- épaisseur du contour (défaut 1.6)
	Shade: any?, -- false = sans ombrage ; nombre = force (défaut 0.12)
	Shine: boolean?, -- petit reflet blanc en haut à gauche
	Rotation: number?,
}

----------------------------------------------------------------------
-- Couleurs
----------------------------------------------------------------------

local function lighten(color: Color3, amount: number): Color3
	return color:Lerp(WHITE, amount)
end

local function darken(color: Color3, amount: number): Color3
	return color:Lerp(BLACK, amount)
end

-- Contour "kawaii" : la couleur tirée vers l'encre prune
local function outlineOf(color: Color3): Color3
	return color:Lerp(C.Ink, 0.55)
end

----------------------------------------------------------------------
-- Formes de base
----------------------------------------------------------------------

local function box(parent: Instance, x: number, y: number, w: number, h: number, color: Color3, transparency: number?, z: number?): Frame
	local frame = Instance.new("Frame")
	frame.BorderSizePixel = 0
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = transparency or 0
	frame.Position = UDim2.fromOffset(x, y)
	frame.Size = UDim2.fromOffset(w, h)
	frame.ZIndex = z or 2
	frame.Parent = parent
	return frame
end

local function round(frame: GuiObject, radius: number?)
	local corner = Instance.new("UICorner")
	if radius == nil or radius < 0 then
		corner.CornerRadius = UDim.new(1, 0)
	else
		corner.CornerRadius = UDim.new(0, radius)
	end
	corner.Parent = frame
	return corner
end

local function stroke(frame: GuiObject, color: Color3, thickness: number?, transparency: number?): UIStroke
	local line = Instance.new("UIStroke")
	line.Color = color
	line.Thickness = thickness or 1.6
	line.Transparency = transparency or 0
	line.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	line.LineJoinMode = Enum.LineJoinMode.Round
	line.Parent = frame
	return line
end

-- Dégradé de couleur (multiplie la couleur du fond) ; rotation 90 = haut -> bas
local function gradient(frame: GuiObject, top: Color3, bottom: Color3, rotation: number?): UIGradient
	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new(top, bottom)
	grad.Rotation = rotation or 90
	grad.Parent = frame
	return grad
end

-- Dégradé de transparence (fondu) ; rotation 90 = haut -> bas
local function fade(frame: GuiObject, from: number, to: number, rotation: number?): UIGradient
	local grad = Instance.new("UIGradient")
	grad.Transparency = NumberSequence.new(from, to)
	grad.Rotation = rotation or 90
	grad.Parent = frame
	return grad
end

local function circle(parent: Instance, cx: number, cy: number, w: number, h: number, color: Color3, transparency: number?, z: number?): Frame
	local frame = box(parent, cx - w / 2, cy - h / 2, w, h, color, transparency, z)
	round(frame)
	return frame
end

-- Forme "kawaii" : fond + contour foncé + ombrage vertical (+ reflet)
local function part(parent: Instance, x: number, y: number, w: number, h: number, color: Color3, options: PartOptions?): Frame
	local opts: PartOptions = options or {}
	local frame = box(parent, x, y, w, h, color, opts.T, opts.Z)
	local radius = opts.Radius
	if radius == nil then
		radius = 6
	end
	if radius ~= 0 then
		round(frame, radius)
	end
	if opts.Rotation then
		frame.Rotation = opts.Rotation
	end
	local outline = opts.Outline
	if outline ~= false then
		local lineColor = if typeof(outline) == "Color3" then outline else outlineOf(color)
		stroke(frame, lineColor, opts.Thickness or 1.6, 0)
	end
	local shade = opts.Shade
	if shade ~= false then
		local amount = if type(shade) == "number" then shade else 0.12
		gradient(frame, WHITE, Color3.new(1 - amount, 1 - amount, 1 - amount), 90)
	end
	if opts.Shine then
		local shine = box(frame, math.max(2, w * 0.14), math.max(2, h * 0.12), math.max(3, w * 0.26), math.max(2, math.min(6, h * 0.14)), WHITE, 0.35, 3)
		round(shine)
	end
	return frame
end

-- Ovale "kawaii" (même style que part)
local function blob(parent: Instance, cx: number, cy: number, w: number, h: number, color: Color3, options: PartOptions?): Frame
	local opts: PartOptions = options or {}
	local copy: PartOptions = {
		Radius = -1,
		Z = opts.Z,
		T = opts.T,
		Outline = opts.Outline,
		Thickness = opts.Thickness,
		Shade = opts.Shade,
		Shine = opts.Shine,
		Rotation = opts.Rotation,
	}
	return part(parent, cx - w / 2, cy - h / 2, w, h, color, copy)
end

-- Trait (segment arrondi) entre deux points
local function line(parent: Instance, x1: number, y1: number, x2: number, y2: number, thickness: number, color: Color3, transparency: number?, z: number?): Frame
	local dx, dy = x2 - x1, y2 - y1
	local length = math.sqrt(dx * dx + dy * dy)
	local frame = box(parent, 0, 0, length + thickness, thickness, color, transparency, z)
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2)
	frame.Rotation = math.deg(math.atan2(dy, dx))
	round(frame)
	return frame
end

-- Triangle pointe en haut (tranches horizontales) ; `top` = y de la pointe
local function triangle(parent: Instance, cx: number, top: number, w: number, h: number, color: Color3, z: number?, transparency: number?, slices: number?): Frame
	local holder = box(parent, cx - w / 2, top, w, h, color, 1, z)
	local count = slices or math.clamp(math.floor(h / 2), 4, 24)
	for index = 1, count do
		local k = index / count
		local sliceW = w * k
		box(holder, (w - sliceW) / 2, (index - 1) * h / count, sliceW, h / count + 0.6, color, transparency, 1)
	end
	return holder
end

-- Triangle pointe en bas ; `top` = y de la base
local function triangleDown(parent: Instance, cx: number, top: number, w: number, h: number, color: Color3, z: number?, transparency: number?, slices: number?): Frame
	local holder = box(parent, cx - w / 2, top, w, h, color, 1, z)
	local count = slices or math.clamp(math.floor(h / 2), 4, 24)
	for index = 1, count do
		local k = 1 - (index - 1) / count
		local sliceW = w * k
		box(holder, (w - sliceW) / 2, (index - 1) * h / count, sliceW, h / count + 0.6, color, transparency, 1)
	end
	return holder
end

local function diamond(parent: Instance, cx: number, cy: number, side: number, color: Color3, transparency: number?, z: number?): Frame
	local frame = box(parent, 0, 0, side, side, color, transparency, z)
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromOffset(cx, cy)
	frame.Rotation = 45
	return frame
end

-- Cœur (2 cercles + un losange) centré, de largeur `width` ; renvoie son conteneur
local function heart(parent: Instance, cx: number, cy: number, width: number, color: Color3, transparency: number?, z: number?): Frame
	local holder = box(parent, cx - width / 2, cy - width / 2, width, width, color, 1, z)
	local a = width / (1 + 1 / SQRT2)
	local centerY = width / 2 + a * 0.073
	local offset = a / (2 * SQRT2)
	diamond(holder, width / 2, centerY, a, color, transparency, 1)
	circle(holder, width / 2 - offset, centerY - offset, a, a, color, transparency, 1)
	circle(holder, width / 2 + offset, centerY - offset, a, a, color, transparency, 1)
	return holder
end

-- Étincelle à 4 branches ; renvoie son conteneur
local function sparkle(parent: Instance, cx: number, cy: number, size: number, color: Color3, transparency: number?, z: number?): Frame
	local holder = box(parent, cx - size / 2, cy - size / 2, size, size, color, 1, z)
	diamond(holder, size / 2, size / 2, size * 0.36, color, transparency, 1)
	local thin = math.max(1, size * 0.14)
	local vertical = box(holder, size / 2 - thin / 2, 0, thin, size, color, transparency, 1)
	round(vertical)
	local horizontal = box(holder, 0, size / 2 - thin / 2, size, thin, color, transparency, 1)
	round(horizontal)
	return holder
end

-- Nuage (base arrondie + 2 bosses), `cy` = bas du nuage ; renvoie son conteneur
local function cloud(parent: Instance, cx: number, cy: number, width: number, color: Color3, transparency: number?, z: number?): Frame
	local height = width * 0.62
	local holder = box(parent, cx - width / 2, cy - height, width, height, color, 1, z)
	local baseH = width * 0.34
	local base = box(holder, 0, height - baseH, width, baseH, color, transparency, 1)
	round(base)
	circle(holder, width * 0.36, height - baseH, width * 0.5, width * 0.5, color, transparency, 1)
	circle(holder, width * 0.7, height - baseH * 0.9, width * 0.36, width * 0.36, color, transparency, 1)
	return holder
end

-- Reflet blanc (pilule semi-transparente)
local function shine(parent: Instance, x: number, y: number, w: number, h: number, z: number?, transparency: number?): Frame
	local frame = box(parent, x, y, w, h, WHITE, transparency or 0.35, z or 5)
	round(frame)
	return frame
end

-- Texte / petit emoji d'accent (centré)
local function text(parent: Instance, value: string, cx: number, cy: number, size: number, color: Color3?, z: number?): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.fromOffset(cx, cy)
	label.Size = UDim2.fromOffset(size * 3, size * 1.3)
	label.Font = FONT
	label.Text = value
	label.TextSize = size
	label.TextColor3 = color or C.Ink
	label.ZIndex = z or 6
	label.Parent = parent
	return label
end

-- Conteneur transparent (pour grouper, découper avec clip = true)
local function group(parent: Instance, x: number, y: number, w: number, h: number, z: number?, clip: boolean?): Frame
	local frame = box(parent, x, y, w, h, WHITE, 1, z)
	frame.ClipsDescendants = clip == true
	return frame
end

-- Pivot : conteneur de taille nulle placé en (px, py). Ses enfants se placent
-- par rapport à ce point et tournent autour de lui (balancier, hélice...)
local function pivot(parent: Instance, px: number, py: number, z: number?): Frame
	local frame = box(parent, px, py, 0, 0, WHITE, 1, z)
	return frame
end

----------------------------------------------------------------------
-- Visage kawaii
----------------------------------------------------------------------

type FaceOptions = {
	Eyes: string?, -- "dot" (défaut) | "happy" (^ ^) | "closed" (endormi) | "big" (yeux brillants)
	Mouth: string?, -- "smile" (défaut) | "cat" (ω) | "o" | "none"
	Blush: boolean?, -- défaut true
	Color: Color3?, -- couleur des yeux / de la bouche
	Z: number?,
	Spacing: number?, -- écart entre les yeux (fraction de size, défaut 0.62)
}

-- Visage centré en (cx, cy), `size` ≈ largeur du visage ; renvoie son conteneur
-- (les yeux "dot" / "big" clignent tout seuls si le kit est animé)
local function makeFace(kit: any, parent: Instance, cx: number, cy: number, size: number, options: FaceOptions?): Frame
	local opts: FaceOptions = options or {}
	local ink = opts.Color or C.Ink
	local holder = group(parent, cx - size / 2, cy - size / 2, size, size, opts.Z or 6)
	local half = size / 2
	local gap = size * (opts.Spacing or 0.62) / 2
	local eyeY = half - size * 0.08
	local eyes = opts.Eyes or "dot"
	local eyeSize = math.max(2, size * 0.16)
	local eyeFrames = {}
	for _, side in ipairs({ -1, 1 }) do
		local ex = half + side * gap
		if eyes == "happy" then
			line(holder, ex - eyeSize * 0.55, eyeY + eyeSize * 0.25, ex, eyeY - eyeSize * 0.3, math.max(1, size * 0.06), ink, 0, 2)
			line(holder, ex, eyeY - eyeSize * 0.3, ex + eyeSize * 0.55, eyeY + eyeSize * 0.25, math.max(1, size * 0.06), ink, 0, 2)
		elseif eyes == "closed" then
			line(holder, ex - eyeSize * 0.6, eyeY, ex + eyeSize * 0.6, eyeY, math.max(1, size * 0.06), ink, 0, 2)
		else
			local big = eyes == "big"
			local w = big and eyeSize * 1.35 or eyeSize
			local h = big and eyeSize * 1.6 or eyeSize * 1.15
			local eye = circle(holder, ex, eyeY, w, h, ink, 0, 2)
			local dot = circle(eye, w * 0.32, h * 0.3, w * 0.42, w * 0.42, WHITE, 0, 2)
			dot.AnchorPoint = Vector2.new(0.5, 0.5)
			dot.Position = UDim2.fromOffset(w * 0.34, h * 0.3)
			table.insert(eyeFrames, eye)
		end
		if opts.Blush ~= false then
			circle(holder, ex + side * size * 0.1, eyeY + size * 0.16, size * 0.2, size * 0.11, C.Blush, 0.35, 1)
		end
	end
	local mouth = opts.Mouth or "smile"
	local my = eyeY + size * 0.12
	local mw = size * 0.12
	local thick = math.max(1, size * 0.055)
	if mouth == "smile" then
		line(holder, half - mw / 2, my - mw * 0.2, half, my + mw * 0.25, thick, ink, 0, 2)
		line(holder, half, my + mw * 0.25, half + mw / 2, my - mw * 0.2, thick, ink, 0, 2)
	elseif mouth == "cat" then
		for _, side in ipairs({ -1, 1 }) do
			local ox = half + side * mw * 0.45
			line(holder, ox - mw * 0.45, my - mw * 0.15, ox, my + mw * 0.25, thick, ink, 0, 2)
			line(holder, ox, my + mw * 0.25, ox + mw * 0.45, my - mw * 0.15, thick, ink, 0, 2)
		end
	elseif mouth == "o" then
		local o = circle(holder, half, my + mw * 0.2, mw * 1.1, mw * 1.3, ink, 0, 2)
		circle(o, mw * 0.55, mw * 0.95, mw * 0.7, mw * 0.5, C.Blush, 0, 2)
	end
	for index, eye in ipairs(eyeFrames) do
		kit.Animate(eye, "Blink", 1, 1, index * 0.001 + (cx + cy) * 0.37)
	end
	return holder
end

----------------------------------------------------------------------
-- Kit (une instance par dessin : elle collecte les animations)
----------------------------------------------------------------------

local function newKit(static: boolean)
	local anims: { Anim } = {}
	local kit: any = {
		C = C,
		Static = static,
		Lighten = lighten,
		Darken = darken,
		OutlineOf = outlineOf,
		Box = box,
		Round = round,
		Stroke = stroke,
		Gradient = gradient,
		Fade = fade,
		Circle = circle,
		Part = part,
		Blob = blob,
		Line = line,
		Triangle = triangle,
		TriangleDown = triangleDown,
		Diamond = diamond,
		Heart = heart,
		Sparkle = sparkle,
		Cloud = cloud,
		Shine = shine,
		Text = text,
		Group = group,
		Pivot = pivot,
	}

	-- Animation d'un objet :
	--   "Sway"    : balancement, Amp = degrés
	--   "Spin"    : rotation continue, Speed = tours par seconde (Amp ignoré)
	--   "Bob"     : monte et descend, Amp = px
	--   "Drift"   : glisse de gauche à droite, Amp = px
	--   "Pulse"   : la transparence du fond varie de Amp (lueur, écran)
	--   "Flicker" : petite flamme qui vacille (transparence irrégulière, Amp)
	--   "Breathe" : grossit / rétrécit un peu, Amp = fraction (0.04 = 4 %)
	--   "Blink"   : les yeux clignent de temps en temps (Amp ignoré)
	function kit.Animate(object: GuiObject, kind: string, amp: number?, speed: number?, phase: number?)
		if static then
			return
		end
		local anim: Anim = {
			Object = object,
			Kind = kind,
			Amp = amp or 1,
			Speed = speed or 1,
			Phase = phase or 0,
			BaseRotation = object.Rotation,
			BasePosition = object.Position,
			BaseTransparency = object.BackgroundTransparency,
			Scale = nil,
		}
		if kind == "Breathe" or kind == "Flicker" then
			local existing = object:FindFirstChildOfClass("UIScale")
			anim.Scale = existing or Instance.new("UIScale")
			if not existing then
				(anim.Scale :: UIScale).Parent = object
			end
		end
		table.insert(anims, anim)
	end

	function kit.Face(parent: Instance, cx: number, cy: number, size: number, options: FaceOptions?): Frame
		return makeFace(kit, parent, cx, cy, size, options)
	end

	return kit, anims
end

----------------------------------------------------------------------
-- Registre des dessins (dossier Art)
----------------------------------------------------------------------

type Painter = (Frame, any, any) -> Result?

local painters: { [string]: Painter } = {}

local artFolder = script.Parent:FindFirstChild("Art")
if artFolder then
	for _, moduleScript in ipairs(artFolder:GetChildren()) do
		if moduleScript:IsA("ModuleScript") then
			local ok, result = pcall(require, moduleScript)
			if ok and type(result) == "table" then
				for id, painter in pairs(result) do
					if type(id) == "string" and type(painter) == "function" then
						painters[id] = painter
					end
				end
			else
				warn("[HouseArt] Dessins " .. moduleScript.Name .. " : " .. tostring(result))
			end
		end
	end
end

-- (v9.1) Déco du jardin (Config.House.GardenDecor) : dossier GardenArt,
-- même contrat (boîte 100 x 100, pieds en bas)
local gardenPainters: { [string]: Painter } = {}
local gardenFolder = script.Parent:FindFirstChild("GardenArt")
if gardenFolder then
	for _, moduleScript in ipairs(gardenFolder:GetChildren()) do
		if moduleScript:IsA("ModuleScript") then
			local ok, result = pcall(require, moduleScript)
			if ok and type(result) == "table" then
				for id, painter in pairs(result) do
					if type(id) == "string" and type(painter) == "function" then
						gardenPainters[id] = painter
					end
				end
			else
				warn("[HouseArt] Jardin " .. moduleScript.Name .. " : " .. tostring(result))
			end
		end
	end
end

-- (v9.2) Boîte à outils de dessin pour d'autres modules (chapeaux et boutons
-- de la boutique d'objets : CosmeticArt) ; `static` = sans animation
function HouseArt.NewKit(static: boolean?): (any, { Anim })
	return newKit(static == true)
end

function HouseArt.HasGarden(decorId: string): boolean
	return gardenPainters[decorId] ~= nil
end

-- Dessine une déco du jardin dans `body` (100 x 100) ; sinon son emoji
function HouseArt.PaintGarden(body: Frame, entry: any, static: boolean?): (Result?, { Anim })
	local painter = gardenPainters[entry.Id]
	if painter then
		local kit, anims = newKit(static == true)
		local ok, result = pcall(painter, body, kit, entry)
		if ok then
			return (type(result) == "table" and result or {}) :: Result, anims
		end
		warn("[HouseArt] Jardin " .. tostring(entry.Id) .. " : " .. tostring(result))
		for _, child in ipairs(body:GetChildren()) do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
	end
	local label = text(body, tostring(entry.Icon or "🌷"), 50, 60, 60, WHITE, 2)
	label.Font = Enum.Font.BuilderSansMedium
	return nil, {}
end

function HouseArt.Has(itemId: string): boolean
	return painters[itemId] ~= nil
end

-- Dessine l'objet dans `body` (100 x 100) ; nil si l'objet n'a pas de dessin
function HouseArt.Paint(body: Frame, item: any, static: boolean?): (Result?, { Anim })
	local painter = painters[item.Id]
	if not painter then
		return nil, {}
	end
	local kit, anims = newKit(static == true)
	local ok, result = pcall(painter, body, kit, item)
	if not ok then
		warn("[HouseArt] Dessin " .. tostring(item.Id) .. " : " .. tostring(result))
		for _, child in ipairs(body:GetChildren()) do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		return nil, {}
	end
	return (type(result) == "table" and result or {}) :: Result, anims
end

-- Vignette carrée (boutique, inventaire) : le dessin réduit, sinon l'emoji
function HouseArt.Thumbnail(parent: Instance, item: any, size: number, zIndex: number?): Frame
	local holder = Instance.new("Frame")
	holder.Name = "Art"
	holder.BackgroundTransparency = 1
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.Position = UDim2.fromScale(0.5, 0.5)
	holder.Size = UDim2.fromOffset(size, size)
	holder.ZIndex = zIndex or 1
	local body = Instance.new("Frame")
	body.Name = "Body"
	body.BackgroundTransparency = 1
	body.AnchorPoint = Vector2.new(0.5, 0.5)
	body.Position = UDim2.fromScale(0.5, 0.5)
	body.Size = UDim2.fromOffset(100, 100)
	body.ZIndex = 1
	local scale = Instance.new("UIScale")
	-- Un peu de marge : certains dessins débordent de leur boîte
	scale.Scale = size / 100 * 0.84
	scale.Parent = body
	body.Parent = holder
	local result = HouseArt.Paint(body, item, true)
	if not result then
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = Enum.Font.BuilderSansMedium
		label.Text = tostring(item.Icon)
		label.TextSize = math.floor(size * 0.72)
		label.TextColor3 = WHITE
		label.ZIndex = 2
		label.Parent = body
		scale.Scale = size / 100
	end
	holder.Parent = parent
	return holder
end

-- Fait vivre les animations (clock = temps en secondes)
function HouseArt.Step(anims: { Anim }, clock: number)
	for _, anim in ipairs(anims) do
		local object = anim.Object
		local t = clock * anim.Speed + anim.Phase
		local kind = anim.Kind
		if kind == "Sway" then
			object.Rotation = anim.BaseRotation + math.sin(t * 2) * anim.Amp
		elseif kind == "Spin" then
			object.Rotation = anim.BaseRotation + (clock * anim.Speed * 360 + anim.Phase * 57) % 360
		elseif kind == "Bob" then
			local base = anim.BasePosition
			object.Position = base + UDim2.fromOffset(0, math.sin(t * 2.2) * anim.Amp)
		elseif kind == "Drift" then
			local base = anim.BasePosition
			object.Position = base + UDim2.fromOffset(math.sin(t * 1.3) * anim.Amp, 0)
		elseif kind == "Pulse" then
			object.BackgroundTransparency = math.clamp(anim.BaseTransparency + (0.5 + 0.5 * math.sin(t * 2.4)) * anim.Amp, 0, 1)
		elseif kind == "Flicker" then
			local wave = math.sin(t * 9) * 0.5 + math.sin(t * 13.7 + 1.3) * 0.3 + math.sin(t * 23.1) * 0.2
			object.BackgroundTransparency = math.clamp(anim.BaseTransparency + (0.5 + 0.5 * wave) * anim.Amp, 0, 1)
			local scale = anim.Scale
			if scale then
				scale.Scale = 1 + wave * 0.05
			end
		elseif kind == "Breathe" then
			local scale = anim.Scale
			if scale then
				scale.Scale = 1 + math.sin(t * 1.8) * anim.Amp
			end
		elseif kind == "Blink" then
			-- Un clignement rapide toutes les ~4 s (décalé par objet)
			local cycle = (clock + anim.Phase) % 4.2
			object.Visible = cycle < 4.05
		end
	end
end

-- Miroir gauche <-> droite d'un dessin déjà peint (Roblox n'a pas d'échelle
-- négative pour les GuiObjects) : chaque forme change de côté dans son
-- parent, les rotations et dégradés horizontaux s'inversent, les
-- animations suivent. Appliqué deux fois = dessin d'origine.
-- `axis` (facultatif) : x de l'axe de symétrie pour les enfants directs de
-- `root` (ex. les pieds d'un animal) ; par défaut le milieu de `root`.
function HouseArt.Mirror(root: GuiObject, anims: { Anim }, axis: number?)
	local byObject: { [Instance]: { Anim } } = {}
	for _, anim in ipairs(anims) do
		local list = byObject[anim.Object]
		if not list then
			list = {}
			byObject[anim.Object] = list
		end
		table.insert(list, anim)
	end
	local widths: { [Instance]: number } = {}
	local function widthOf(object: Instance): number
		local cached = widths[object]
		if cached then
			return cached
		end
		local width = 0
		if object == root then
			width = root.AbsoluteSize.X > 0 and root.Size.X.Offset <= 0 and root.AbsoluteSize.X or root.Size.X.Offset
		elseif object:IsA("GuiObject") then
			local parent = object.Parent
			local parentWidth = parent and widthOf(parent) or 0
			width = object.Size.X.Scale * parentWidth + object.Size.X.Offset
		end
		widths[object] = width
		return width
	end
	for _, object in ipairs(root:GetDescendants()) do
		if object:IsA("GuiObject") then
			local parent = object.Parent :: Instance
			local parentWidth = widthOf(parent)
			if parent == root and axis then
				parentWidth = axis * 2
			end
			local width = widthOf(object)
			local list = byObject[object]
			local first = list and list[1]
			local position = first and first.BasePosition or object.Position
			local left = position.X.Scale * parentWidth + position.X.Offset - object.AnchorPoint.X * width
			local newLeft = parentWidth - left - width
			local newPosition = UDim2.new(0, newLeft + object.AnchorPoint.X * width, position.Y.Scale, position.Y.Offset)
			local rotation = -(first and first.BaseRotation or object.Rotation)
			object.Position = newPosition
			object.Rotation = rotation
			if list then
				for _, anim in ipairs(list) do
					anim.BasePosition = newPosition
					anim.BaseRotation = rotation
					if anim.Kind == "Sway" or anim.Kind == "Drift" then
						anim.Amp = -anim.Amp
					elseif anim.Kind == "Spin" then
						anim.Speed = -anim.Speed
					end
				end
			end
		elseif object:IsA("UIGradient") then
			object.Rotation = (180 - object.Rotation) % 360
		end
	end
end

return HouseArt
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">HouseButtons</string>
              <string name="Source"><![CDATA[--[[
	HouseButtons (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > HouseButtons

	Boutons "bonbons" de la maison (plus de boutons plats basiques) :
	  - Candy : bouton-outil carré (barre d'outils de l'éditeur) : face
	    brillante en dégradé + reflet, "lèvre" plus foncée dessous (effet 3D
	    qui s'enfonce quand on appuie), icône + légende, survol qui soulève
	    le bouton, état désactivé grisé ;
	  - Tip : petite bulle sombre au survol (nom + raccourci clavier).
	Tout est construit une fois ; les animations sont de simples Tweens.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local Interface = require(Client.Interface)
local Locale = require(ReplicatedStorage.Shared.Locale)
local HouseCommon = require(script.Parent.HouseCommon)

local HouseButtons = {}

local WHITE = Color3.new(1, 1, 1)
local C = HouseCommon.Colors
local LIP = 4 -- (px) épaisseur de la "lèvre" sous la face

-- Couleurs des familles d'outils (face) : exposées pour l'éditeur / la fenêtre
HouseButtons.Palette = {
	Lilac = Color3.fromRGB(200, 176, 255),
	Mint = Color3.fromRGB(128, 222, 190),
	Sky = Color3.fromRGB(140, 200, 255),
	Butter = Color3.fromRGB(255, 214, 110),
	Peach = Color3.fromRGB(255, 176, 140),
	Pink = Color3.fromRGB(255, 132, 186),
	Red = Color3.fromRGB(255, 88, 118),
	White = Color3.fromRGB(255, 252, 254),
	Green = Color3.fromRGB(96, 206, 128),
}

local function lipOf(color: Color3): Color3
	return color:Lerp(C.Ink, 0.42)
end

local function outlineOf(color: Color3): Color3
	return color:Lerp(C.Ink, 0.55)
end

-- Texte clair ou foncé selon la face
local function inkFor(color: Color3): Color3
	local luminance = 0.3 * color.R + 0.59 * color.G + 0.11 * color.B
	return luminance > 0.72 and C.Ink or WHITE
end

----------------------------------------------------------------------
-- Bulle d'aide (une seule, déplacée de bouton en bouton)
----------------------------------------------------------------------

local tip: Frame? = nil
local tipLabel: TextLabel? = nil
local tipOwner: GuiObject? = nil

local function ensureTip(): (Frame, TextLabel)
	local frame = tip
	local label = tipLabel
	if frame and label then
		return frame, label
	end
	local newTip = UIUtil.Create("Frame", {
		Name = "HouseTip",
		AnchorPoint = Vector2.new(0.5, 1),
		Size = UDim2.fromOffset(0, 26),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = C.Ink,
		BackgroundTransparency = 0.04,
		Visible = false,
		ZIndex = 60,
	})
	UIUtil.Corner(newTip, UDim.new(0, 9))
	UIUtil.Stroke(newTip, WHITE, 1.5, 0.35)
	UIUtil.Create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), Parent = newTip })
	local newLabel = UIUtil.Create("TextLabel", {
		Name = "Label",
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = "",
		TextColor3 = WHITE,
		TextSize = 14,
		ZIndex = 62,
		Parent = newTip,
	})
	-- petite pointe
	local pointer = UIUtil.Create("Frame", {
		Name = "Pointer",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.fromOffset(10, 10),
		Rotation = 45,
		BackgroundColor3 = C.Ink,
		BackgroundTransparency = 0.04,
		BorderSizePixel = 0,
		ZIndex = 61,
		Parent = newTip,
	})
	pointer:SetAttribute("DarkSkinIgnore", true)
	newTip:SetAttribute("DarkSkinIgnore", true)
	tip = newTip
	tipLabel = newLabel
	return newTip, newLabel
end

-- Affiche la bulle au-dessus de `owner` (nil = cache)
function HouseButtons.ShowTip(owner: GuiObject?, text: string?)
	local frame, label = ensureTip()
	if not owner or not text or text == "" then
		tipOwner = nil
		frame.Visible = false
		frame.Parent = nil
		return
	end
	tipOwner = owner
	label.Text = text
	frame.Position = UDim2.new(0.5, 0, 0, -8)
	-- (bulle détruite avec un ancien bouton : on en refait une)
	if not pcall(function()
		frame.Parent = owner
	end) then
		tip, tipLabel = nil, nil
		frame, label = ensureTip()
		label.Text = text
		frame.Position = UDim2.new(0.5, 0, 0, -8)
		frame.Parent = owner
	end
	frame.Visible = true
	UIUtil.Pop(frame, 0.7, 0.2)
end

-- Bulle au survol (souris seulement) ; `getText` peut changer (état du bouton)
function HouseButtons.Tip(button: GuiButton, getText: () -> string)
	button.MouseEnter:Connect(function()
		if not Interface.IsTouch() then
			HouseButtons.ShowTip(button, getText())
		end
	end)
	button.MouseLeave:Connect(function()
		if tipOwner == button then
			HouseButtons.ShowTip(nil)
		end
	end)
	button.Activated:Connect(function()
		if tipOwner == button then
			-- (le texte peut changer après un clic : ex. aimant oui / non)
			task.defer(function()
				if tipOwner == button then
					HouseButtons.ShowTip(button, getText())
				end
			end)
		end
	end)
end

-- Cache la bulle si elle est sur ce bouton (bouton qui disparaît)
function HouseButtons.HideTipOf(owner: GuiObject)
	if tipOwner == owner or (tipOwner and tipOwner:IsDescendantOf(owner)) then
		HouseButtons.ShowTip(nil)
	end
end

----------------------------------------------------------------------
-- Bouton-outil "bonbon"
----------------------------------------------------------------------

export type Candy = {
	Button: TextButton,
	Face: Frame,
	Icon: TextLabel,
	Caption: TextLabel?,
	SetEnabled: (enabled: boolean) -> (),
	IsEnabled: () -> boolean,
	SetColor: (color: Color3) -> (),
	SetIcon: (text: string) -> (),
	SetCaption: (text: string) -> (),
	SetSize: (width: number, height: number) -> (),
}

-- props : Name, Icon, Caption?, Color, TextColor?, Width, Height, Radius?,
-- IconSize?, LayoutOrder?, ZIndex?, Parent?
function HouseButtons.Candy(props: { [string]: any }): Candy
	local color: Color3 = props.Color or HouseButtons.Palette.White
	local z = props.ZIndex or 1
	local radius = props.Radius or 14
	local enabled = true
	local hovering = false

	local button = UIUtil.Create("TextButton", {
		Name = props.Name or "Candy",
		Size = UDim2.fromOffset(props.Width or 48, props.Height or 52),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = z,
		Parent = props.Parent,
	})
	local lip = UIUtil.Create("Frame", {
		Name = "Lip",
		Position = UDim2.fromOffset(0, LIP),
		Size = UDim2.new(1, 0, 1, -LIP),
		BackgroundColor3 = lipOf(color),
		ZIndex = z,
		Parent = button,
	})
	UIUtil.Corner(lip, radius)
	local lipStroke = UIUtil.Stroke(lip, outlineOf(color), 1.5, 0.25)
	local face = UIUtil.Create("Frame", {
		Name = "Face",
		Size = UDim2.new(1, 0, 1, -LIP),
		BackgroundColor3 = color,
		ZIndex = z + 1,
		Parent = button,
	})
	UIUtil.Corner(face, radius)
	local faceStroke = UIUtil.Stroke(face, outlineOf(color), 1.5, 0.25)
	UIUtil.Gradient(face, ColorSequence.new(WHITE, Color3.fromRGB(226, 226, 232)), 90)
	local gloss = UIUtil.Create("Frame", {
		Name = "Gloss",
		Position = UDim2.new(0, 4, 0, 3),
		Size = UDim2.new(1, -8, 0.4, 0),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.35,
		ZIndex = z + 2,
		Parent = face,
	})
	UIUtil.Corner(gloss, math.max(4, radius - 4))
	UIUtil.Create("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new(0.25, 1),
		Parent = gloss,
	})
	local hasCaption = props.Caption ~= nil and props.Caption ~= ""
	local textColor = props.TextColor or inkFor(color)
	local icon = UIUtil.Create("TextLabel", {
		Name = "Icon",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = hasCaption and UDim2.new(0.5, 0, 0.38, 0) or UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, 0, hasCaption and 0.6 or 1, 0),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = props.Icon or "",
		TextColor3 = textColor,
		TextSize = props.IconSize or 22,
		ZIndex = z + 3,
		Parent = face,
	})
	local caption: TextLabel? = nil
	if hasCaption then
		local label = UIUtil.Create("TextLabel", {
			Name = "Caption",
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -3),
			Size = UDim2.new(1, -4, 0, 13),
			BackgroundTransparency = 1,
			Font = Theme.Fonts.Title,
			Text = props.Caption,
			TextColor3 = textColor,
			TextSize = 12,
			TextScaled = true,
			ZIndex = z + 3,
			Parent = face,
		})
		UIUtil.Create("UITextSizeConstraint", { MaxTextSize = 12, MinTextSize = 7, Parent = label })
		caption = label
	end

	local function setFace(offset: number, time: number)
		UIUtil.Tween(face, time, { Position = UDim2.fromOffset(0, offset) }, Enum.EasingStyle.Quad)
	end
	button.MouseEnter:Connect(function()
		hovering = true
		if enabled then
			setFace(-1.5, 0.1)
		end
	end)
	button.MouseLeave:Connect(function()
		hovering = false
		setFace(0, 0.12)
	end)
	button.MouseButton1Down:Connect(function()
		setFace(LIP - 1, 0.06)
	end)
	button.MouseButton1Up:Connect(function()
		setFace(hovering and enabled and -1.5 or 0, 0.14)
	end)

	local candy: Candy
	local function paint()
		local shown = enabled and color or color:Lerp(Color3.fromRGB(214, 210, 222), 0.65)
		face.BackgroundColor3 = shown
		lip.BackgroundColor3 = lipOf(shown)
		lipStroke.Color = outlineOf(shown)
		faceStroke.Color = outlineOf(shown)
		gloss.BackgroundTransparency = enabled and 0.35 or 0.6
		local ink = props.TextColor or inkFor(color)
		icon.TextColor3 = ink
		icon.TextTransparency = enabled and 0 or 0.5
		local label = candy and candy.Caption
		if label then
			label.TextColor3 = ink
			label.TextTransparency = enabled and 0 or 0.45
		end
	end
	candy = {
		Button = button,
		Face = face,
		Icon = icon,
		Caption = caption,
		SetEnabled = function(value: boolean)
			if enabled == value then
				return
			end
			enabled = value
			paint()
		end,
		IsEnabled = function(): boolean
			return enabled
		end,
		SetColor = function(value: Color3)
			color = value
			paint()
		end,
		SetIcon = function(text: string)
			if icon.Text ~= text then
				icon.Text = text
			end
		end,
		SetCaption = function(text: string)
			local label = caption
			if label and label.Text ~= text then
				label.Text = text
			end
		end,
		SetSize = function(width: number, height: number)
			button.Size = UDim2.fromOffset(width, height)
		end,
	}
	paint()
	return candy
end

----------------------------------------------------------------------
-- Cadres qui "avalent" les clics
----------------------------------------------------------------------

-- Conteneur visible (pastille, capsule, bandeau...) fait avec un TextButton
-- sans action : sur Roblox une Frame laisse passer le clic vers un bouton
-- placé derrière (la pièce désélectionnerait l'objet, une case de la maison
-- s'ouvrirait...). À utiliser à la place d'une Frame quand le cadre a un
-- UIListLayout / UIPadding (UIUtil.SinkClicks y ajouterait un enfant rangé
-- par la liste). props : mêmes propriétés qu'une Frame.
function HouseButtons.Container(props: { [string]: any }): TextButton
	local finalProps: { [string]: any } = {
		AutoButtonColor = false,
		Text = "",
		Selectable = false,
	}
	for key, value in pairs(props) do
		finalProps[key] = value
	end
	return UIUtil.Create("TextButton", finalProps)
end

-- Bouton invisible sous tout le contenu d'un cadre SANS liste (comme
-- UIUtil.SinkClicks) qui couvre aussi ses marges internes (UIPadding)
function HouseButtons.Sink(frame: GuiObject): TextButton
	local existing = frame:FindFirstChild("ClickSink")
	if existing and existing:IsA("TextButton") then
		return existing
	end
	local padding = frame:FindFirstChildOfClass("UIPadding")
	local padL = padding and padding.PaddingLeft.Offset or 0
	local padR = padding and padding.PaddingRight.Offset or 0
	local padT = padding and padding.PaddingTop.Offset or 0
	local padB = padding and padding.PaddingBottom.Offset or 0
	local sink = UIUtil.Create("TextButton", {
		Name = "ClickSink",
		Position = UDim2.fromOffset(-padL, -padT),
		Size = UDim2.new(1, padL + padR, 1, padT + padB),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		Selectable = false,
		ZIndex = 0,
		Parent = frame,
	})
	return sink
end

-- Texte localisé d'une bulle "Nom  (raccourci)"
function HouseButtons.TipText(name: string, shortcut: string?): string
	if shortcut and shortcut ~= "" and not Interface.IsTouch() then
		return Locale.T(name) .. "   " .. shortcut
	end
	return Locale.T(name)
end

return HouseButtons
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">HouseCommon</string>
              <string name="Source"><![CDATA[--[[
	HouseCommon (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > HouseCommon

	Outils partagés de "🏠 Ma maison" côté client :
	  - accès typé à Config.House (tailles, papiers peints, sols, objets) ;
	  - lecture de ClientState.Data.House (avec valeurs par défaut) : la
	    maison est une grille de pièces (Rooms), chacune avec son type, son
	    emplacement (Slot), son papier peint, son sol et ses objets ;
	  - prix (Formulas.GetHouseItemPrice), exemplaires possédés / posés,
	    confort et bonus (mêmes formules que le serveur) ;
	  - bornes des zones "Wall" (haut) / "Floor" (bas) de la pièce, et
	    règle "peut être posé SUR un meuble" (CanGoOnFurniture, même règle
	    que le serveur : Formulas.CanGoOnFurniture) ;
	  - objets posés { I, X, Y, S, Z, F? } : F = dessin retourné (miroir) ;
	  - appel du serveur : Net.Function("House"):InvokeServer(action, arg)
	    protégé par pcall ;
	  - palette kawaii (roses, lilas, menthe) utilisée par tous les modules
	    de la maison.
	Aucune interface ici (utilisé aussi par la colonne centrale pour son badge).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent.Parent
local ClientState = require(Client.ClientState)
local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Net = require(ReplicatedStorage.Shared.Net)
local Locale = require(ReplicatedStorage.Shared.Locale)
local WorldLayout = require(ReplicatedStorage.Shared.WorldLayout)

export type Item = {
	Id: string,
	Name: string,
	Icon: string,
	Category: string,
	Placement: string, -- "Floor" | "Wall"
	Size: number,
	Cost: number,
	CostGrowth: number,
	Comfort: number,
	MaxOwned: number?,
	Order: number?,
	Tabletop: boolean?, -- true / false : force "peut être posé sur un meuble"
	RequiresUpgrade: string?, -- (v9.5) amélioration du clicker à posséder pour l'acheter
	Setup: any?, -- (v9.5) "Dopamine Setup" : comportement live (voir Config.House.Items)
}

export type SizeDef = {
	Id: string,
	Name: string,
	Icon: string,
	Cost: number,
	Floors: number, -- étages
	Columns: number, -- pièces par étage
	MaxRooms: number, -- Floors x Columns
	Width: number, -- largeur relative d'une pièce
	RoomItems: number, -- objets posés max par pièce
	Exterior: string, -- "Cottage" | "Townhouse" | "Loft" | "Mansion"
	Order: number?,
}

export type RoomTypeDef = {
	Id: string,
	Name: string,
	Icon: string,
	Wallpaper: string,
	Floor: string,
	Trim: string?, -- (v9.6) look du type (gratuit pour la pièce)
	Mood: string?,
	Categories: { string },
	Items: { string },
	FavoriteCategories: { [string]: boolean },
	FavoriteItems: { [string]: boolean },
	Order: number?,
}

export type Style = {
	Id: string,
	Name: string,
	Icon: string?,
	Cost: number,
	Pattern: string,
	A: Color3,
	B: Color3,
	Order: number?,
}

export type Category = { Id: string, Name: string, Icon: string, Order: number? }

-- Un objet posé (format du serveur) ; F = dessin retourné (miroir) ;
-- C = couleur (Config.House.Tints, nil = couleurs d'origine)
export type Placed = { I: string, X: number, Y: number, S: number, Z: number, F: boolean?, C: string?, R: number? }

-- Une pièce (format du serveur) ; Slot = (étage - 1) x Columns + colonne,
-- étage 1 = rez-de-chaussée
export type Room = {
	Id: string,
	Type: string,
	Slot: number,
	Wallpaper: string,
	Floor: string,
	Trim: string, -- (v9.1) boiseries (Config.House.Trims)
	Mood: string, -- (v9.1) ambiance / lumière (Config.House.Moods)
	View: string, -- (v9.1) vue par la fenêtre (Config.House.Views)
	Placed: { Placed },
}

-- (v9.1) Entrée de personnalisation (boiseries, ambiance, vue, façade, toit,
-- motif du toit, déco du jardin, couleur d'objet) : champs selon le genre
export type Look = {
	Id: string,
	Name: string,
	Icon: string,
	Cost: number?,
	RequiresRebirths: number?,
	Color: Color3?,
	Tint: Color3?,
	Tint2: Color3?,
	Amount: number?,
	Light: Color3?,
	Brightness: number?,
	Effect: string?,
	Kind: string?,
	Sky: Color3?,
	Horizon: Color3?,
	Ground: Color3?,
	Pattern: string?,
	Order: number?,
}

export type HouseData = {
	Size: string,
	OwnedSizes: { [string]: boolean },
	OwnedWallpapers: { [string]: boolean },
	OwnedFloors: { [string]: boolean },
	Items: { [string]: number },
	Rooms: { Room },
	-- (v9.1) personnalisation : possédés par genre ({ [id] = true }), extérieur
	Owned: { [string]: { [string]: boolean } },
	Facade: string,
	Roof: string,
	RoofStyle: string,
	Garden: { string },
}

export type HouseConfig = {
	ComfortBonusPerPoint: number,
	MaxComfortBonus: number,
	WallRatio: number,
	TabletopMaxSize: number?,
	TabletopMinY: number?,
	LegacyTabletopSize: number?,
	RoomCost: number,
	RoomCostGrowth: number,
	HarmonyBonus: number,
	Sizes: { SizeDef },
	RoomTypes: { RoomTypeDef },
	Wallpapers: { Style },
	Floors: { Style },
	Categories: { Category },
	Items: { Item },
}

local HouseCommon = {}

-- Config typée (le tableau de Config.luau mélange des objets avec / sans MaxOwned)
local rawConfig = (Config :: any).House
local EMPTY_CONFIG: HouseConfig = {
	ComfortBonusPerPoint = 0,
	MaxComfortBonus = 0,
	WallRatio = 0.46,
	RoomCost = 0,
	RoomCostGrowth = 1,
	HarmonyBonus = 0,
	Sizes = {
		{ Id = "Studio", Name = "Cozy studio", Icon = "🏠", Cost = 0, Floors = 1, Columns = 1, MaxRooms = 1, Width = 1,
			RoomItems = 25, Exterior = "Cottage" },
	},
	RoomTypes = {},
	Wallpapers = {},
	Floors = {},
	Categories = {},
	Items = {},
}
HouseCommon.Config = (type(rawConfig) == "table" and rawConfig or EMPTY_CONFIG) :: HouseConfig

HouseCommon.ItemsById = ((Config :: any).HouseItemsById or {}) :: { [string]: Item }
HouseCommon.SizesById = ((Config :: any).HouseSizesById or {}) :: { [string]: SizeDef }
HouseCommon.WallpapersById = ((Config :: any).HouseWallpapersById or {}) :: { [string]: Style }
HouseCommon.FloorsById = ((Config :: any).HouseFloorsById or {}) :: { [string]: Style }
HouseCommon.CategoriesById = ((Config :: any).HouseCategoriesById or {}) :: { [string]: Category }
HouseCommon.RoomTypesById = ((Config :: any).HouseRoomTypesById or {}) :: { [string]: RoomTypeDef }

-- Échelle des objets posés (bornes du serveur) et pas des boutons ➕ / ➖
HouseCommon.MIN_SCALE = 0.6
HouseCommon.MAX_SCALE = 1.6
HouseCommon.SCALE_STEP = 0.1
-- Couche de départ d'un objet posé (Z) : de la place pour "reculer" (0..999)
HouseCommon.DEFAULT_Z = 100
HouseCommon.MAX_Z = 999

-- Palette kawaii
HouseCommon.Colors = {
	Pink = Color3.fromRGB(255, 126, 182),
	PinkDeep = Color3.fromRGB(236, 72, 140),
	PinkSoft = Color3.fromRGB(255, 214, 232),
	PinkMist = Color3.fromRGB(255, 240, 247),
	Lilac = Color3.fromRGB(183, 148, 246),
	LilacSoft = Color3.fromRGB(236, 224, 255),
	Mint = Color3.fromRGB(110, 214, 176),
	MintSoft = Color3.fromRGB(214, 247, 234),
	Cream = Color3.fromRGB(255, 247, 236),
	Peach = Color3.fromRGB(255, 190, 160),
	Sky = Color3.fromRGB(150, 205, 255),
	Butter = Color3.fromRGB(255, 226, 130),
	Heart = Color3.fromRGB(255, 79, 139),
	Wood = Color3.fromRGB(214, 164, 120),
	WoodDark = Color3.fromRGB(160, 110, 78),
	Ink = Color3.fromRGB(92, 58, 96), -- texte "chocolat-prune" sur fond pastel
}

-- Fond pastel de la vignette d'un objet, selon sa catégorie
local CATEGORY_TINTS: { [string]: Color3 } = {
	Furniture = Color3.fromRGB(255, 228, 206),
	Decor = Color3.fromRGB(255, 222, 238),
	Toys = Color3.fromRGB(255, 240, 200),
	Plants = Color3.fromRGB(216, 245, 222),
	Electronics = Color3.fromRGB(214, 232, 255),
	Kitchen = Color3.fromRGB(255, 226, 222),
	Doors = Color3.fromRGB(236, 224, 210),
	Windows = Color3.fromRGB(214, 240, 255),
	Lights = Color3.fromRGB(255, 244, 196),
	Pets = Color3.fromRGB(255, 232, 214),
}

function HouseCommon.CategoryTint(categoryId: string): Color3
	-- (v9.2) les nouvelles catégories donnent leur teinte dans Config (Tint)
	local entry = Config.HouseCategoriesById[categoryId]
	local configured = entry and entry.Tint
	return CATEGORY_TINTS[categoryId] or (typeof(configured) == "Color3" and configured) or HouseCommon.Colors.PinkSoft
end

----------------------------------------------------------------------
-- Données
----------------------------------------------------------------------

local function mapOf(value): { [string]: any }
	if type(value) == "table" then
		return value
	end
	return {}
end

local function readPlaced(list: any): { Placed }
	local placed = {}
	if type(list) == "table" then
		for _, entry in ipairs(list) do
			if type(entry) == "table" and type(entry.I) == "string" then
				table.insert(placed, {
					I = entry.I,
					X = tonumber(entry.X) or 0.5,
					Y = tonumber(entry.Y) or 0.8,
					S = tonumber(entry.S) or 1,
					Z = tonumber(entry.Z) or 0,
					F = entry.F == true or nil,
					C = type(entry.C) == "string" and entry.C or nil,
					R = tonumber(entry.R), -- v9.3 : rotation 3D (Dopamine Town), en degrés
				})
			end
		end
	end
	return placed
end

-- (v9.1) Genres de personnalisation (Config.HouseLookKinds)
export type LookKind = { Kind: string, List: { Look }, Owned: string, Scope: string, Field: string, ById: { [string]: Look } }
local LOOK_KINDS = ((Config :: any).HouseLookKinds or {}) :: { [string]: LookKind }
local LOOKS_BY_ID = ((Config :: any).HouseLooksById or {}) :: { [string]: { [string]: Look } }
HouseCommon.LookKinds = LOOK_KINDS
HouseCommon.TintsById = ((Config :: any).HouseTintsById or {}) :: { [string]: Look }
HouseCommon.Tints = ((Config.House :: any).Tints or {}) :: { Look }
HouseCommon.GardenSlots = tonumber((Config.House :: any).GardenSlots) or 6

-- (v9.8 GARDEN98) places de déco du jardin avec les agrandissements du jardin
-- (Config.Garden.Expansion[data.Garden.Level].DecorSlots : 6 / 8 / 10 / 12),
-- même règle que HouseService (serveur) ; data = état du joueur (ClientState.Data par défaut)
function HouseCommon.GardenSlotsFor(data: any?): number
	local source = data or ClientState.Data
	local garden = type(source) == "table" and source.Garden or nil
	local level = type(garden) == "table" and tonumber(garden.Level) or 0
	local levels = Config.Garden and (Config.Garden :: any).Expansion
	local entry = type(levels) == "table" and level and level == level and levels[math.floor(level)] or nil
	return math.max(HouseCommon.GardenSlots, type(entry) == "table" and tonumber(entry.DecorSlots) or 0)
end

-- Id valide d'un genre (sinon la 1re entrée de la liste)
local function lookId(kind: string, value: any): string
	local byId = LOOKS_BY_ID[kind]
	if type(value) == "string" and byId and byId[value] then
		return value
	end
	local def = LOOK_KINDS[kind]
	local first = def and def.List[1]
	return first and first.Id or ""
end

-- Entrée d'un genre par id (la 1re si inconnue)
function HouseCommon.Look(kind: string, id: string?): Look?
	local byId = LOOKS_BY_ID[kind]
	return byId and byId[lookId(kind, id)] or nil
end

-- Vrai si le joueur possède cette entrée (la 1re est gratuite, sauf jardin)
function HouseCommon.OwnsLook(house: HouseData, kind: string, id: string): boolean
	local map = house.Owned[kind]
	return map ~= nil and map[id] == true
end

-- Maison du joueur (jamais nil : valeurs par défaut avant le premier état ;
-- une ancienne maison à une seule pièce devient un salon)
function HouseCommon.GetHouse(data: any): HouseData
	local house = type(data) == "table" and data.House or nil
	local config = HouseCommon.Config
	local firstSize = config.Sizes[1]
	local firstWallpaper = config.Wallpapers[1]
	local firstFloor = config.Floors[1]
	local firstType = config.RoomTypes[1]
	if type(house) ~= "table" then
		house = {}
	end
	local rooms: { Room } = {}
	local ok, rawRooms = pcall(Formulas.GetHouseRooms, house)
	if ok and type(rawRooms) == "table" then
		for index, raw in ipairs(rawRooms) do
			if type(raw) == "table" then
				table.insert(rooms, {
					Id = type(raw.Id) == "string" and raw.Id or ("R" .. index),
					Type = type(raw.Type) == "string" and raw.Type or (firstType and firstType.Id or "Living"),
					Slot = tonumber(raw.Slot) or index,
					Wallpaper = type(raw.Wallpaper) == "string" and raw.Wallpaper
						or (type(house.Wallpaper) == "string" and house.Wallpaper)
						or (firstWallpaper and firstWallpaper.Id or ""),
					Floor = type(raw.Floor) == "string" and raw.Floor
						or (type(house.Floor) == "string" and house.Floor)
						or (firstFloor and firstFloor.Id or ""),
					Trim = lookId("Trim", raw.Trim),
					Mood = lookId("Mood", raw.Mood),
					View = lookId("View", raw.View),
					Placed = readPlaced(raw.Placed),
				})
			end
		end
	end
	if #rooms == 0 then
		table.insert(rooms, {
			Id = "R1",
			Type = firstType and firstType.Id or "Living",
			Slot = 1,
			Wallpaper = firstWallpaper and firstWallpaper.Id or "",
			Floor = firstFloor and firstFloor.Id or "",
			Trim = lookId("Trim", nil),
			Mood = lookId("Mood", nil),
			View = lookId("View", nil),
			Placed = {},
		})
	end
	-- (v9.1) personnalisation : possédés par genre (la 1re entrée est gratuite)
	local owned: { [string]: { [string]: boolean } } = {}
	for kind, def in pairs(LOOK_KINDS) do
		local map = table.clone(mapOf(house[def.Owned]))
		local first = def.List[1]
		if first and def.Scope ~= "Garden" then
			map[first.Id] = true
		end
		owned[kind] = map
	end
	local garden: { string } = {}
	if type(house.Garden) == "table" then
		for _, id in ipairs(house.Garden) do
			if type(id) == "string" and LOOKS_BY_ID.Garden and LOOKS_BY_ID.Garden[id] then
				table.insert(garden, id)
			end
		end
	end
	return {
		Owned = owned,
		Facade = lookId("Facade", house.Facade),
		Roof = lookId("Roof", house.Roof),
		RoofStyle = lookId("RoofStyle", house.RoofStyle),
		Garden = garden,
		Size = type(house.Size) == "string" and house.Size or (firstSize and firstSize.Id or "Studio"),
		OwnedSizes = mapOf(house.OwnedSizes),
		OwnedWallpapers = mapOf(house.OwnedWallpapers),
		OwnedFloors = mapOf(house.OwnedFloors),
		Items = mapOf(house.Items),
		Rooms = rooms,
	}
end

function HouseCommon.GetSize(house: HouseData): SizeDef
	return HouseCommon.SizesById[house.Size] or HouseCommon.Config.Sizes[1]
end

-- Pièce par Id (nil si elle n'existe pas)
function HouseCommon.GetRoom(house: HouseData, roomId: string?): Room?
	for _, room in ipairs(house.Rooms) do
		if room.Id == roomId then
			return room
		end
	end
	return nil
end

-- Pièce à un emplacement de la grille (nil si vide)
function HouseCommon.RoomAtSlot(house: HouseData, slot: number): Room?
	for _, room in ipairs(house.Rooms) do
		if room.Slot == slot then
			return room
		end
	end
	return nil
end

-- Emplacement -> (étage, colonne) ; étage 1 = rez-de-chaussée
function HouseCommon.SlotCell(size: SizeDef, slot: number): (number, number)
	return math.floor((slot - 1) / size.Columns) + 1, (slot - 1) % size.Columns + 1
end

function HouseCommon.CellSlot(size: SizeDef, floor: number, column: number): number
	return (floor - 1) * size.Columns + column
end

function HouseCommon.GetRoomType(room: Room?): RoomTypeDef
	local roomType = room and HouseCommon.RoomTypesById[room.Type]
	return roomType or HouseCommon.Config.RoomTypes[1]
end

function HouseCommon.GetRoomWallpaper(room: Room?): Style?
	return (room and HouseCommon.WallpapersById[room.Wallpaper]) or HouseCommon.Config.Wallpapers[1]
end

function HouseCommon.GetRoomFloor(room: Room?): Style?
	return (room and HouseCommon.FloorsById[room.Floor]) or HouseCommon.Config.Floors[1]
end

-- Vrai si l'objet est un "préféré" de la pièce (bonus d'harmonie)
function HouseCommon.IsFavorite(room: Room?, item: Item): boolean
	local ok, value = pcall(Formulas.IsRoomFavorite, HouseCommon.GetRoomType(room), item)
	return ok and value == true
end

-- Confort d'un objet dans une pièce (harmonie comprise)
function HouseCommon.PlacedComfort(room: Room?, item: Item): number
	local ok, value = pcall(Formulas.GetPlacedComfort, HouseCommon.GetRoomType(room), item)
	if ok and type(value) == "number" then
		return value
	end
	return item.Comfort
end

-- Prix de la prochaine pièce
function HouseCommon.RoomCost(house: HouseData): number
	local ok, value = pcall(Formulas.GetRoomCost, #house.Rooms)
	if ok and type(value) == "number" then
		return value
	end
	return math.huge
end

-- Anciennes fonctions (1re pièce) : pour le code qui ne connaît qu'une pièce
function HouseCommon.GetWallpaper(house: HouseData): Style?
	return HouseCommon.GetRoomWallpaper(house.Rooms[1])
end

function HouseCommon.GetFloor(house: HouseData): Style?
	return HouseCommon.GetRoomFloor(house.Rooms[1])
end

-- Exemplaires possédés d'un objet
function HouseCommon.Owned(house: HouseData, itemId: string): number
	return math.max(0, math.floor(tonumber(house.Items[itemId]) or 0))
end

-- Exemplaires posés d'un objet dans une disposition
function HouseCommon.PlacedCount(placed: { Placed }, itemId: string): number
	local count = 0
	for _, entry in ipairs(placed) do
		if entry.I == itemId then
			count += 1
		end
	end
	return count
end

-- Prix du prochain exemplaire
function HouseCommon.Price(item: Item, owned: number): number
	return Formulas.GetHouseItemPrice(item, owned)
end

-- Vrai si on ne peut plus en acheter (MaxOwned atteint)
function HouseCommon.IsMaxed(item: Item, owned: number): boolean
	return item.MaxOwned ~= nil and owned >= (item.MaxOwned :: number)
end

-- Dopamine sûre (sans l'extrapolation des gains passifs)
function HouseCommon.Dopamine(): number
	local ok, value = pcall(ClientState.GetConfirmedDopamine)
	if ok and type(value) == "number" then
		return value
	end
	return 0
end

-- Dispositions "en cours" : { [roomId] = objets posés } remplace celles du serveur
export type Overrides = { [string]: { Placed } }

local function layoutOf(room: Room, overrides: Overrides?): { Placed }
	return (overrides and overrides[room.Id]) or room.Placed
end

-- Exemplaires d'un objet posés dans TOUTES les pièces
function HouseCommon.PlacedTotal(house: HouseData, itemId: string, overrides: Overrides?): number
	local count = 0
	for _, room in ipairs(house.Rooms) do
		count += HouseCommon.PlacedCount(layoutOf(room, overrides), itemId)
	end
	return count
end

-- Exemplaires encore rangés (possédés - posés partout)
function HouseCommon.Available(house: HouseData, itemId: string, overrides: Overrides?): number
	return math.max(0, HouseCommon.Owned(house, itemId) - HouseCommon.PlacedTotal(house, itemId, overrides))
end

-- Confort total de la maison (même calcul que le serveur : objets possédés,
-- RoomItems par pièce, harmonie), avec des dispositions en cours éventuelles
function HouseCommon.Comfort(house: HouseData, overrides: Overrides?): number
	local rooms = {}
	for _, room in ipairs(house.Rooms) do
		table.insert(rooms, { Id = room.Id, Type = room.Type, Slot = room.Slot, Placed = layoutOf(room, overrides) })
	end
	local ok, value = pcall(Formulas.GetHouseComfort, {
		House = { Size = house.Size, Items = house.Items, Rooms = rooms },
	})
	if ok and type(value) == "number" then
		return value
	end
	return 0
end

-- Confort d'une seule pièce (sans tenir compte des autres pièces)
function HouseCommon.RoomComfort(house: HouseData, room: Room, placed: { Placed }?): number
	local ok, value = pcall(Formulas.GetHouseComfort, {
		House = {
			Size = house.Size,
			Items = house.Items,
			Rooms = { { Id = room.Id, Type = room.Type, Slot = 1, Placed = placed or room.Placed } },
		},
	})
	if ok and type(value) == "number" then
		return value
	end
	return 0
end

-- Bonus en % sur tous les gains (ex. 17 pour +17 %)
function HouseCommon.BonusPercent(comfort: number): number
	local ok, multiplier = pcall(Formulas.GetHouseBonus, comfort)
	if ok and type(multiplier) == "number" then
		return math.max(0, (multiplier - 1) * 100)
	end
	return 0
end

-- "17" / "2.5" : pourcentage lisible
function HouseCommon.FormatPercent(value: number): string
	if value >= 10 or math.abs(value - math.floor(value)) < 0.05 then
		return tostring(math.floor(value + 0.5))
	end
	return string.format("%.1f", value)
end

-- Visites à l'océan nécessaires pour une entrée (objet, style, maison)
function HouseCommon.RequiredRebirths(entry: any): number
	local ok, value = pcall(Formulas.GetHouseRequiredRebirths, entry)
	if ok and type(value) == "number" then
		return value
	end
	return 0
end

-- (v9.5) Amélioration du clicker exigée par un objet "Dopamine Setup"
-- (item.RequiresUpgrade = Id de Config.Upgrades, au moins 1 niveau :
-- data.Upgrades[id] >= 1, même règle que HouseService) : renvoie
-- l'amélioration qui manque, nil si rien ne manque
function HouseCommon.MissingUpgrade(data: any, entry: any): any?
	local upgradeId = type(entry) == "table" and entry.RequiresUpgrade or nil
	if type(upgradeId) ~= "string" then
		return nil
	end
	local upgrades = type(data) == "table" and data.Upgrades or nil
	local level = type(upgrades) == "table" and tonumber(upgrades[upgradeId]) or 0
	if level and level == level and level >= 1 then
		return nil
	end
	return Config.UpgradesById[upgradeId] or { Id = upgradeId, Name = upgradeId, Icon = "🔒" }
end

-- Vrai si l'entrée est débloquée pour ces données (visites à l'océan et,
-- v9.5, amélioration exigée)
function HouseCommon.IsUnlocked(data: any, entry: any): boolean
	if HouseCommon.MissingUpgrade(data, entry) ~= nil then
		return false
	end
	local ok, value = pcall(Formulas.IsHouseEntryUnlocked, data, entry)
	if ok and type(value) == "boolean" then
		return value
	end
	return true
end

-- (v9.5) Pourquoi l'entrée est verrouillée : (genre, texte court traduit)
--   "Rebirths" : "Après N visites à l'océan" (le plus gros verrou d'abord)
--   "Upgrade"  : "Débloque 🏃 Coureur infini d'abord" (3e valeur = l'amélioration)
--   nil        : rien ne bloque
function HouseCommon.LockReason(data: any, entry: any): (string?, string?, any?)
	local ok, value = pcall(Formulas.IsHouseEntryUnlocked, data, entry)
	if ok and value == false then
		local required = HouseCommon.RequiredRebirths(entry)
		if required == 1 then
			return "Rebirths", Locale.T("After 1 ocean visit")
		end
		return "Rebirths", Locale.T("After %d ocean visits", required)
	end
	local upgrade = HouseCommon.MissingUpgrade(data, entry)
	if upgrade then
		local label = tostring(upgrade.Icon or "") .. " " .. Locale.T(tostring(upgrade.Name or upgrade.Id))
		return "Upgrade", Locale.T("Unlock %s first", label), upgrade
	end
	return nil, nil
end

-- Objets jamais achetés qu'on peut se payer maintenant (badges)
function HouseCommon.AffordableNew(data: any, dopamine: number): { string }
	local result = {}
	if type(data) ~= "table" then
		return result
	end
	local house = HouseCommon.GetHouse(data)
	for _, item in ipairs(HouseCommon.Config.Items) do
		if HouseCommon.Owned(house, item.Id) == 0 and dopamine >= HouseCommon.Price(item, 0) and HouseCommon.IsUnlocked(data, item) then
			table.insert(result, item.Id)
		end
	end
	return result
end

-- Nom traduit d'un objet / d'une entrée de config
function HouseCommon.Name(entry: { Name: string }): string
	return Locale.T(entry.Name)
end

----------------------------------------------------------------------
-- Zones de la pièce
----------------------------------------------------------------------

-- Vrai si l'objet peut être posé SUR un meuble (table, étagère, lit...) :
-- même règle que le serveur (Formulas.CanGoOnFurniture)
local tabletopCache: { [string]: boolean } = {}
function HouseCommon.CanGoOnFurniture(item: Item?): boolean
	if not item then
		return false
	end
	local cached = tabletopCache[item.Id]
	if cached ~= nil then
		return cached
	end
	local ok, value = pcall(Formulas.CanGoOnFurniture, item)
	local result = ok and value == true
	tabletopCache[item.Id] = result
	return result
end

-- Bornes (Y) de la zone d'un objet : "Wall" = haut, "Floor" = bas
-- (un peu plus serrées que celles du serveur : l'objet reste bien dans sa zone)
function HouseCommon.ZoneBounds(placement: string): (number, number)
	local ratio = HouseCommon.Config.WallRatio
	if placement == "Wall" then
		return 0.1, ratio - 0.03
	end
	return ratio + 0.035, 0.985
end

-- Position corrigée d'un objet : dans sa zone, sans sortir de la pièce.
-- `roomWidth` / `roomHeight` : taille de la pièce en px de maquette.
-- `onSurface` : petit objet posé SUR un meuble (peut monter jusqu'à
-- Config.House.TabletopMinY, comme le permet le serveur).
-- (v9.6) Zone valide = WorldLayout.PlacementArea : LA MÊME que l'édition 3D
-- de la ville (FurnitureEdit) et que le serveur (HouseService).
function HouseCommon.PlacementArea(item: Item, scale: number, roomWidth: number, roomHeight: number, onSurface: boolean?): (number, number, number, number)
	local raised: number? = nil
	if item.Placement ~= "Wall" and onSurface == true and HouseCommon.CanGoOnFurniture(item) then
		raised = HouseCommon.Config.TabletopMinY
	end
	return WorldLayout.PlacementArea(item.Placement, item.Size * scale, roomWidth, roomHeight, HouseCommon.Config.WallRatio, raised)
end

function HouseCommon.ClampPosition(item: Item, x: number, y: number, scale: number, roomWidth: number, roomHeight: number, onSurface: boolean?): (number, number)
	local x0, x1, y0, y1 = HouseCommon.PlacementArea(item, scale, roomWidth, roomHeight, onSurface)
	return math.clamp(x, x0, x1), math.clamp(y, y0, y1)
end

-- (v9.6) Style "du type" d'une pièce (Config.House.RoomTypes Wallpaper /
-- Floor) : gratuit et débloqué POUR CETTE PIÈCE même s'il n'est pas acheté
-- (même règle que le serveur). kind = "Wallpaper" | "Floor"
function HouseCommon.IsRoomTypeStyle(room: Room?, kind: string, id: string): boolean
	if not room then
		return false
	end
	local roomType = HouseCommon.RoomTypesById[room.Type] :: any
	return roomType ~= nil and roomType[kind] == id
end

----------------------------------------------------------------------
-- Serveur
----------------------------------------------------------------------

-- Appel protégé : (succès, message?)
function HouseCommon.Invoke(action: string, argument: any): (boolean, string?)
	local ok, success, message = pcall(function()
		return Net.Function("House"):InvokeServer(action, argument)
	end)
	if not ok then
		return false, Locale.T("Network error, try again.")
	end
	return success == true, message ~= nil and tostring(message) or nil
end

-- Petit hachage déterministe d'un texte (détails "aléatoires" mais stables)
function HouseCommon.Hash(text: string): number
	local hash = 5381
	for index = 1, #text do
		hash = (hash * 33 + string.byte(text, index)) % 2147483647
	end
	return hash
end

return HouseCommon
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">HouseEditor</string>
              <string name="Source"><![CDATA[--[[
	HouseEditor (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > HouseEditor

	Disposition des objets d'UNE pièce de la maison (côté client) :
	  - copie locale de room.Placed + un "autocollant" par objet
	    (HouseRoom.CreateSticker), triés en profondeur : objets muraux
	    derrière, tapis à plat, puis objets au sol (couche Z, puis Y : plus
	    bas = devant) ; SetRoom change de pièce (la précédente est
	    sauvegardée tout de suite) ;
	  - MODE ÉDITION : glisser-déposer fluide à la souris ET au doigt,
	    l'objet reste dans sa zone (mur / sol), zone valide mise en valeur,
	    AIMANTATION à la grille (option 🧲, lignes visibles pendant le
	    glissement), petit "plop" à la pose ;
	  - sélection + BARRE D'OUTILS "bonbons" (House/HouseButtons) près de
	    l'objet (ou en bas de la scène sur téléphone) : vignette + nom +
	    confort + "📍 sur la table", taille ➖ 100 % ➕, ⏬ derrière /
	    ⏫ devant, ↔️ retourner (miroir), 🎨 couleur (v9.1 : la rangée des
	    couleurs remplace les outils ; touche C), 📑 copier, 🚪 envoyer
	    dans une autre pièce, 📦 ranger (rouge) ; bulle au survol (nom + raccourci) ;
	    les clics dans la barre ne désélectionnent jamais l'objet ;
	  - ANNULER / RÉTABLIR (30 étapes par pièce ; Ctrl+Z / Ctrl+Y) ;
	  - clavier : flèches = petit déplacement (Maj = plus grand), + / - =
	    taille, Page préc. / suiv. = couche, F = retourner, Suppr = ranger,
	    Ctrl+D = dupliquer, Échap = désélectionner, G = aimant ;
	  - pose depuis l'inventaire (Place) à un endroit libre : petite déco
	    directement SUR un meuble (nourriture sur une table, coussin sur le
	    lit...), chaise directement À UNE TABLE ;
	  - sauvegarde automatique "saveLayout" { Rooms = { [pièce] = ... } }
	    ~1,5 s après la dernière modification (les 2 pièces d'un envoi
	    partent dans le même appel) ; nouvel essai si le serveur refuse,
	    puis resynchro ;
	  - hors édition : toucher un objet le fait rebondir (petits cœurs) ;
	  - SUR LES MEUBLES (House/HouseSurfaces) : un petit objet glissé
	    au-dessus d'une table, d'un bureau, d'une étagère, d'un lit, d'un
	    canapé, d'une chaise... s'y pose : pendant le glissement, toutes les
	    places possibles s'allument, le dessus visé brille avec une étiquette
	    "✨ Poser sur : Table à manger" et le meuble est entouré ;
	  - CHAISES À TABLE : une chaise / un tabouret glissé près d'une table
	    se range à gauche ou à droite (tournée vers elle), derrière (le
	    dossier dépasse) ou devant ; déplacer / agrandir la table emporte ses
	    chaises et ce qui est posé dessus ; ranger la table fait tomber ce
	    qui était posé dessus (les chaises restent) ;
	  - ANIMAUX : hors édition, les animaux de la pièce se promènent et
	    utilisent leurs affaires (House/HousePets, visuel seulement).
	Les exemplaires sont comptés dans TOUTES les pièces (HouseCommon.Available
	avec la disposition locale). Le serveur revérifie tout.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TextService = game:GetService("TextService")

local Client = script.Parent.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local Interface = require(Client.Interface)
local Effects = require(Client.Effects)
local SoundManager = require(Client.SoundManager)
local Signal = require(ReplicatedStorage.Shared.Signal)
local Locale = require(ReplicatedStorage.Shared.Locale)
local HouseCommon = require(script.Parent.HouseCommon)
local HouseRoom = require(script.Parent.HouseRoom)
local HouseSurfaces = require(script.Parent.HouseSurfaces)
local HousePets = require(script.Parent.HousePets)
local HouseArt = require(script.Parent.HouseArt)
local HouseButtons = require(script.Parent.HouseButtons)
local ClientState = require(Client.ClientState)

type Placed = HouseCommon.Placed
type HouseData = HouseCommon.HouseData
type Item = HouseCommon.Item
type Room = HouseRoom.Room
type Sticker = HouseRoom.Sticker
type Candy = HouseButtons.Candy

local HouseEditor = {}

local SAVE_DELAY = 1.5 -- (s) après la dernière modification
local RETRY_DELAY = 1.2 -- (s) nouvel essai si le serveur refuse
local SYNC_BLOCK = 2.5 -- (s) après une sauvegarde : on ignore les anciens états du serveur
local DRAG_THRESHOLD = 6 -- (px écran) en dessous : c'est un simple toucher
local DRAG_SMOOTHING = 24 -- vitesse de rattrapage du doigt (plus = plus collé)
local LIFT_SCALE = 1.1
local HISTORY_STEPS = 30
local GRID = 20 -- (px de maquette) pas de l'aimant
local NUDGE_SMALL = 4 -- (px de maquette) flèche
local NUDGE_BIG = 24 -- (px de maquette) Maj + flèche
local NUDGE_MERGE = 0.8 -- (s) flèches enchaînées = une seule étape d'annulation
local DOCK_BELOW = 760 -- (px de maquette) scène plus étroite : barre d'outils en bas de la scène

local C = HouseCommon.Colors
local P = HouseButtons.Palette
local WHITE = Color3.new(1, 1, 1)
local SEAT_TINT = Color3.fromRGB(56, 176, 140) -- étiquette "chaise à table"

export type SaveStatus = "idle" | "dirty" | "saving" | "saved" | "error"

export type Editor = {
	Changed: any, -- Signal () : disposition modifiée (confort, inventaire)
	SaveStatusChanged: any, -- Signal (status: SaveStatus)
	SelectionChanged: any, -- Signal (entry: Placed?)
	HistoryChanged: any, -- Signal () : annuler / rétablir / aimant
	SetEditing: (editing: boolean) -> (),
	IsEditing: () -> boolean,
	SetActive: (active: boolean) -> (),
	SetLive: (visible: boolean) -> (), -- pièce affichée : les animaux vivent
	GetPets: () -> HousePets.Pets,
	SetRoom: (roomId: string) -> (),
	GetRoomId: () -> string?,
	Sync: (house: HouseData, force: boolean?) -> (),
	GetLayout: () -> { Placed },
	Overrides: () -> HouseCommon.Overrides,
	Available: (itemId: string) -> number,
	CanPlace: (itemId: string) -> (boolean, string?),
	Place: (itemId: string) -> boolean,
	Select: (index: number) -> (),
	Deselect: () -> (),
	GetSelected: () -> Placed?,
	Duplicate: () -> boolean,
	Flip: () -> boolean,
	SendTo: (roomId: string) -> boolean,
	SetSendHandler: (handler: (entry: Placed) -> ()) -> (),
	SetDockHost: (host: GuiObject?) -> (), -- téléphone : la barre d'outils prend la place de l'inventaire
	Undo: () -> boolean,
	Redo: () -> boolean,
	CanUndo: () -> boolean,
	CanRedo: () -> boolean,
	SetSnap: (on: boolean) -> (),
	GetSnap: () -> boolean,
	Flush: () -> (),
	IsBusy: () -> boolean,
	Update: (dt: number) -> (),
}

-- Objet posé sur le meuble qu'on déplace (décalage en fractions de la pièce)
type Rider = { Entry: Placed, DX: number, DY: number }

type Drag = {
	Entry: Placed,
	Input: InputObject,
	Offset: Vector2,
	Target: Vector2,
	Start: Vector2,
	Moved: boolean,
	Before: { Placed },
	Riders: { Rider },
	Skip: { [Placed]: boolean },
	Tabletop: boolean, -- peut être posé sur un meuble
	IsSeat: boolean, -- chaise / tabouret : peut se ranger à une table
	Surface: HouseSurfaces.Surface?,
	Seat: HouseSurfaces.SeatSpot?,
	HintKey: string,
	WasOn: boolean, -- posé sur un meuble au début du glissement
}

-- Envoi vers une autre pièce (pour l'annuler / le rétablir)
type Cross = { Room: string, Before: { Placed }, After: { Placed } }
type Step = { Layout: { Placed }, Cross: Cross? }
type History = { Undo: { Step }, Redo: { Step } }

-- Rang de la zone : muraux derrière, objets à plat (tapis), puis le sol
local function zoneRank(sticker: Sticker): number
	if sticker.Item.Placement == "Wall" then
		return 0
	elseif sticker.Flat then
		return 1
	end
	return 2
end

local function roundTo(value: number, step: number): number
	return math.floor(value / step + 0.5) * step
end

local function signature(list: { Placed }): string
	local parts = table.create(#list)
	for index, entry in ipairs(list) do
		parts[index] = string.format("%s:%.4f:%.4f:%.3f:%d%s%s", entry.I, entry.X, entry.Y, entry.S, math.floor(entry.Z), entry.F and ":F" or "", entry.C and (":" .. entry.C) or "")
	end
	return table.concat(parts, ";")
end

local function copyEntry(entry: Placed): Placed
	return { I = entry.I, X = entry.X, Y = entry.Y, S = entry.S, Z = entry.Z, F = entry.F == true or nil, C = entry.C, R = entry.R }
end

local function copyList(list: { Placed }): { Placed }
	local result = table.create(#list)
	for index, entry in ipairs(list) do
		result[index] = copyEntry(entry)
	end
	return result
end

-- Disposition envoyée au serveur (mêmes arrondis que lui)
local function payloadOf(list: { Placed }): { Placed }
	local payload = table.create(#list)
	for index, entry in ipairs(list) do
		payload[index] = {
			I = entry.I,
			X = roundTo(entry.X, 0.0001),
			Y = roundTo(entry.Y, 0.0001),
			S = roundTo(entry.S, 0.001),
			Z = math.clamp(math.floor(entry.Z), 0, HouseCommon.MAX_Z),
			F = entry.F == true or nil,
			C = entry.C,
			R = entry.R, -- v9.3 : rotation 3D gardée
		}
	end
	return payload
end

-- Aimant : partagé par toutes les pièces (et gardé entre deux ouvertures)
local snapEnabled = false

function HouseEditor.new(room: Room, notify: (text: string, color: Color3?) -> ()): Editor
	local editor: Editor
	local house: HouseData = HouseCommon.GetHouse(nil)
	local roomId: string? = nil
	local layout: { Placed } = {}
	local stickers: { [Placed]: Sticker } = {}
	local selected: Placed? = nil
	local drag: Drag? = nil
	local editing = false
	local active = false
	local dirty = false
	local saving = false
	local saveAt = 0
	local failures = 0
	local blockUntil = 0
	local lastSignature = ""
	local clock = 0

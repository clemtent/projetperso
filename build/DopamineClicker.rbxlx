	------------------------------------------------------------------
	-- Affichage des jetons / du bouton (appelé 4 fois par seconde)
	------------------------------------------------------------------
	local enabled = true
	local spinning = false
	local lastTokens = -1
	local canPlay = false

	local function refreshTokens()
		local tokens, progress, remaining = currentTokens()
		local max = tokenBase.Max
		tokenCount.Text = string.format("%d<font color=\"#C89080\" size=\"12\"> / %d</font>", tokens, max)
		if tokens >= max then
			barFill.Size = UDim2.fromScale(1, 1)
			timerLabel.Text = Locale.T("FULL") .. " ✨"
		else
			barFill.Size = UDim2.fromScale(math.clamp(progress, 0, 1), 1)
			timerLabel.Text = Locale.T("+1 in %s", clockText(remaining))
		end
		if lastTokens >= 0 and tokens > lastTokens and not spinning then
			-- Nouveau jeton : la pièce saute
			coinScale.Scale = 1.35
			UIUtil.Tween(coinScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
		end
		lastTokens = tokens

		canPlay = enabled and not spinning and tokens >= 1
		playGradient.Enabled = canPlay
		playButton.BackgroundColor3 = canPlay and WHITE or Color3.fromRGB(125, 105, 110)
		playShine.BackgroundTransparency = canPlay and 0.6 or 0.85
		playStroke.Color = canPlay and Color3.fromRGB(90, 40, 0) or Color3.fromRGB(60, 30, 40)
		playSweep.Visible = canPlay
		pullHint.Visible = canPlay
		if spinning then
			playLabel.Text = Locale.T("SPIN")
			playSub.Text = Locale.T("Good luck! 🍀")
		elseif tokens >= 1 or not enabled then
			playLabel.Text = Locale.T("SPIN")
			playSub.Text = Locale.T("FREE · 1 token")
		else
			playLabel.Text = Locale.T("NO TOKENS")
			playSub.Text = Locale.T("Next in %s", clockText(remaining))
		end
		playLabel.TextColor3 = canPlay and Color3.fromRGB(80, 20, 0) or Color3.fromRGB(235, 220, 225)
		playSub.TextColor3 = canPlay and Color3.fromRGB(120, 45, 0) or Color3.fromRGB(220, 195, 200)
	end

	local function applyState()
		local data = ctx.State.Data
		if data and not spinning then
			readServerTokens(data.Casino)
		end
		local now = casinoEnabled()
		closedVeil.Visible = not now
		if now ~= enabled then
			enabled = now
			if not now then
				setInfo(Locale.T("Closed for now 😴"), LED_TEXT)
				setPaytable(false)
			end
		end
		refreshTokens()
	end
	enabled = not casinoEnabled() -- force la première application
	applyState()
	ctx.Connect(ctx.State.Changed, applyState)

	------------------------------------------------------------------
	-- Animation (rouleaux, ampoules, ligne de gain, pièces, gros lot)
	------------------------------------------------------------------
	local partyUntil = 0
	local winGlowUntil = 0
	local bulbClock = 0
	local bulbStep = 0
	local elapsed = 0
	local slowClock = 0
	local partyColors = { Theme.Colors.Yellow, Theme.Colors.Cyan, Theme.Colors.Pink, Theme.Colors.Green, WHITE, Theme.Colors.Orange }
	local lastParty = false
	local nextSweep = 2

	ctx.OnRender(function(dt: number)
		dt = math.min(dt, 0.1)
		local reelsMoving = false
		for _, reel in ipairs(reels) do
			if reel.Mode ~= "idle" then
				reelsMoving = true
				break
			end
		end
		-- Hors écran et rien d'important en cours : on ne dessine rien
		if not reelsMoving and activeCoins == 0 and not isVisible() then
			return
		end
		elapsed += dt
		local now = os.clock()

		for _, reel in ipairs(reels) do
			if reel.Mode == "spin" then
				reel.Speed = math.min(MAX_SPEED, reel.Speed + dt * 70)
				reel.Pos += reel.Speed * dt
				renderReel(reel)
			elseif reel.Mode == "stop" then
				reel.StopT += dt
				local t = math.min(1, reel.StopT / reel.StopDur)
				reel.Pos = reel.StopFrom + (reel.StopTo - reel.StopFrom) * easeOutSoftBack(t)
				reel.Speed = MAX_SPEED * (1 - t) * (1 - t)
				if t >= 1 then
					reel.Pos = reel.StopTo
					reel.Speed = 0
					reel.Mode = "idle"
					ctx.Sound.Play("SlotSpin", 0.9 + random:NextNumber(0, 0.3))
					reel.Scale.Scale = 1.06
					UIUtil.Tween(reel.Scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
				end
				renderReel(reel)
			end
		end

		-- Ampoules : chenillard (1 sur 3), ou arc-en-ciel rapide en cas de gain
		local party = now < partyUntil
		bulbClock += dt
		local interval = party and 0.06 or (spinning and 0.08 or 0.22)
		if bulbClock >= interval or party ~= lastParty then
			bulbClock = 0
			bulbStep += 1
			lastParty = party
			for index, bulb in ipairs(bulbs) do
				if party then
					local color = partyColors[((index + bulbStep) % #partyColors) + 1]
					bulb.Frame.BackgroundColor3 = color
					bulb.Frame.BackgroundTransparency = 0
					bulb.Stroke.Color = color
					bulb.Stroke.Transparency = 0.3
				else
					local on = (bulb.Order + bulbStep) % 3 == 0
					bulb.Frame.BackgroundColor3 = on and GOLD_LIGHT or GOLD_DARK
					bulb.Frame.BackgroundTransparency = on and 0 or 0.35
					bulb.Stroke.Color = GOLD
					bulb.Stroke.Transparency = on and 0.35 or 1
				end
			end
		end

		-- Titre : dégradé qui ondule, pulse pendant la fête
		titleGradient.Offset = Vector2.new(0, math.sin(elapsed * 2) * 0.25)
		titleScale.Scale = party and (1 + math.abs(math.sin(elapsed * 10)) * 0.08) or 1

		-- Ligne de gain : respiration, éclatante après un gain
		local winGlow = now < winGlowUntil
		local wave = math.sin(elapsed * (winGlow and 14 or 3))
		if winGlow then
			paylineGlow.BackgroundColor3 = GOLD
			payline.BackgroundColor3 = GOLD_LIGHT
			paylineGlow.Size = UDim2.new(1, -4, 0, 18 + wave * 4)
			paylineGlow.BackgroundTransparency = 0.1
		else
			paylineGlow.BackgroundColor3 = Color3.fromRGB(255, 70, 70)
			payline.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
			paylineGlow.Size = UDim2.new(1, -4, 0, 12)
			paylineGlow.BackgroundTransparency = 0.55 + wave * 0.15
		end
		local push = math.abs(math.sin(elapsed * 4)) * 2
		arrows[1].Position = UDim2.new(0, -8 + push, 0.5, 0)
		arrows[2].Position = UDim2.new(1, 8 - push, 0.5, 0)

		-- Flèche du levier et reflet du bouton
		if canPlay then
			pullHint.Position = UDim2.fromOffset(leverX, knobTop + 22 + math.abs(math.sin(elapsed * 3)) * 5)
			nextSweep -= dt
			if nextSweep <= 0 then
				nextSweep = 3.5
				playSweep.Position = UDim2.new(-0.3, 0, 0.5, 0)
				UIUtil.Tween(playSweep, 0.7, { Position = UDim2.new(1.3, 0, 0.5, 0) }, Enum.EasingStyle.Quad)
			end
		end

		-- Pièces (gravité)
		if activeCoins > 0 then
			for _, coin in ipairs(coins) do
				if coin.Active then
					coin.VY += 520 * dt
					coin.X += coin.VX * dt
					coin.Y += coin.VY * dt
					if coin.Y > H + 20 then
						coin.Active = false
						coin.Label.Visible = false
						activeCoins -= 1
					else
						coin.Angle += coin.Spin * dt
						coin.Label.Position = UDim2.fromOffset(coin.X, coin.Y)
						coin.Label.Size = UDim2.fromOffset(math.max(2, 14 * math.abs(math.cos(coin.Angle))), 14)
					end
				end
			end
		end

		-- Bannière gros lot : rayons qui tournent, puis disparition
		if jackpot.Visible then
			rays.Rotation = (rays.Rotation + dt * 60) % 360
			jackpotLabel.Rotation = math.sin(elapsed * 6) * 3
			if now > jackpotUntil then
				jackpot.Visible = false
			end
		end

		-- Jetons / minuteur : 4 fois par seconde
		slowClock += dt
		if slowClock >= 0.25 then
			slowClock = 0
			refreshTokens()
		end
	end)

	------------------------------------------------------------------
	-- Partie
	------------------------------------------------------------------
	local function stopReel(reel, id: string, extraDelay: number?)
		local base = math.floor(reel.Pos)
		local target = base + 5 + (extraDelay and 3 or 0)
		reel.Strip[wrap(target)] = id
		reel.StopFrom = reel.Pos
		reel.StopTo = target
		reel.StopT = 0
		local distance = target - reel.Pos
		reel.StopDur = math.clamp(3.9 * distance / math.max(reel.Speed, 1), 0.5, extraDelay and 2 or 1.3)
		reel.Mode = "stop"
	end

	local function allStopped(): boolean
		for _, reel in ipairs(reels) do
			if reel.Mode ~= "idle" then
				return false
			end
		end
		return true
	end

	-- Attend `seconds` ; renvoie false si le stimulus a été arrêté entre-temps
	local function waitAlive(seconds: number): boolean
		local finish = os.clock() + seconds
		while os.clock() < finish do
			if not ctx.IsAlive() then
				return false
			end
			task.wait()
		end
		return ctx.IsAlive()
	end

	local function randomMissIds(): { string }
		-- Trois symboles différents (si possible) : on ne ment pas au joueur
		local pool = {}
		for _, symbol in ipairs(symbols) do
			table.insert(pool, symbol.Id)
		end
		for i = #pool, 2, -1 do
			local j = random:NextInteger(1, i)
			pool[i], pool[j] = pool[j], pool[i]
		end
		return { pool[1], pool[2] or pool[1], pool[3] or pool[1] }
	end

	local function highlightWinners(ids: { string })
		local counts = {}
		for _, id in ipairs(ids) do
			counts[id] = (counts[id] or 0) + 1
		end
		for index, reel in ipairs(reels) do
			if (counts[ids[index]] or 0) >= 2 then
				local glow = reel.Glow
				task.spawn(function()
					for _ = 1, 4 do
						if not glow.Parent then
							return
						end
						UIUtil.Tween(glow, 0.18, { BackgroundTransparency = 0.05 })
						task.wait(0.2)
						if not glow.Parent then
							return
						end
						UIUtil.Tween(glow, 0.18, { BackgroundTransparency = 0.6 })
						task.wait(0.2)
					end
					if glow.Parent then
						UIUtil.Tween(glow, 0.3, { BackgroundTransparency = 1 })
					end
				end)
			end
		end
	end

	local function showResult(result, ids: { string })
		local reward = tonumber(result.Reward) or 0
		local matched = ctx.Formulas.GetCasinoMultiplier(ids)
		local big = result.Big == true or matched >= 240
		local center = UDim2.fromOffset(WINDOW_X + WINDOW_W / 2, WINDOW_Y + WINDOW_H / 2)
		local text = "+" .. Format.Format(reward)

		if matched > 0 then
			local triple = ids[1] == ids[2] and ids[2] == ids[3]
			highlightWinners(ids)
			partyUntil = os.clock() + (big and 3.5 or (triple and 2.4 or 1.6))
			winGlowUntil = os.clock() + 2
			ctx.Sound.Play("SlotWin", big and 1.1 or 1)
			ctx.FloatText(card, center, text, GOLD, big and 34 or (triple and 30 or 26))
			local winTexts = Locale.Pick(WIN_TEXTS)
			setInfo(winTexts[random:NextInteger(1, #winTexts)] .. " " .. text, GOLD_LIGHT, 3)
			UIUtil.Tween(windowStroke, 0.1, { Color = WHITE, Thickness = 3, Transparency = 0 })
			task.delay(0.6, function()
				if windowStroke.Parent then
					UIUtil.Tween(windowStroke, 0.4, { Color = GOLD, Thickness = 1.5, Transparency = 0.3 })
				end
			end)
			dropCoins(big and MAX_COINS or (triple and 8 or 4))
			if effectsOn() then
				ctx.Effects.Burst(card, center, GOLD, triple and 18 or 10)
			end
			if big then
				showJackpot(text)
				ctx.Sound.Play("Jackpot", 1)
				ctx.Effects.Flash(GOLD, 0.45)
				ctx.Effects.BigMessage(Locale.T("🎰 JACKPOT! %s", text), GOLD, 2.5)
				if effectsOn() then
					ctx.Effects.Confetti(70)
				end
			elseif triple and effectsOn() then
				ctx.Effects.Confetti(25)
			end
		else
			-- Rien d'aligné : petit lot de consolation
			ctx.Sound.Play("Error", 0.75)
			UIUtil.Shake(window)
			ctx.FloatText(card, center, text, WHITE, 20)
			local missTexts = Locale.Pick(MISS_TEXTS)
			setInfo(missTexts[random:NextInteger(1, #missTexts)], Color3.fromRGB(255, 215, 170), 2.5)
		end
	end

	local function play()
		if spinning or not ctx.IsAlive() then
			return
		end
		if not enabled or not casinoEnabled() then
			ctx.Sound.Play("Error", 1)
			UIUtil.Shake(playButton)
			return
		end
		local tokens, _, remaining = currentTokens()
		if tokens < 1 then
			ctx.Sound.Play("Error", 1)
			UIUtil.Shake(playButton)
			UIUtil.Shake(tokenPanel)
			setInfo(Locale.T("No tokens! Next one in %s ⏳", clockText(remaining)), BAD, 2)
			return
		end

		spinning = true
		setPaytable(false)
		jackpot.Visible = false
		pullLever()
		ctx.Sound.Play("SlotSpin", 1)
		for _, reel in ipairs(reels) do
			reel.Mode = "spin"
			reel.Glow.BackgroundTransparency = 1
		end
		setInfo(Locale.T("Spinning… 🎲"), LED_TEXT)
		-- Le jeton part tout de suite (le serveur confirmera)
		tokenBase.Tokens = math.max(0, tokenBase.Tokens - 1)
		refreshTokens()

		task.spawn(function()
			local started = os.clock()
			local callOk, success, result = pcall(function()
				return ctx.Net.Function("CasinoSpin"):InvokeServer()
			end)
			if not waitAlive(math.max(0, MIN_SPIN_TIME - (os.clock() - started))) then
				return
			end

			local list = callOk and success == true and type(result) == "table" and (result.Symbols or result.Reels)
			local valid = type(list) == "table"
			local ids = {}
			if valid then
				for index = 1, 3 do
					local id = list[index]
					if type(id) ~= "string" or not symbolsById[id] then
						id = symbols[1].Id
					end
					ids[index] = id
				end
				readServerTokens(result)
			else
				ids = randomMissIds()
				-- Refusé : on reprend le dernier état connu
				local data = ctx.State.Data
				if data then
					readServerTokens(data.Casino)
				end
			end

			-- Arrêts successifs (suspense si les deux premiers sont identiques)
			for index = 1, 3 do
				local suspense = valid and index == 3 and ids[1] == ids[2]
				if suspense then
					setInfo(Locale.T("🤞 Come on… come on…"), Theme.Colors.Yellow)
					partyUntil = os.clock() + 1
				end
				stopReel(reels[index], ids[index], suspense and 1 or nil)
				if not waitAlive(0.32) then
					return
				end
			end
			while not allStopped() do
				if not ctx.IsAlive() then
					return
				end
				task.wait()
			end

			if valid then
				showResult(result, ids)
			else
				local message = (callOk and type(result) == "string") and result or Locale.T("The machine is on strike 🔧")
				ctx.Sound.Play("Error", 1)
				UIUtil.Shake(window)
				setInfo(message, BAD, 2.5)
			end

			spinning = false
			refreshTokens()
		end)
	end

	ctx.Connect(playButton.Activated, play)
	ctx.Connect(leverButton.Activated, play)

	------------------------------------------------------------------
	-- Écran LED au repos : petites annonces
	------------------------------------------------------------------
	local bestSymbol = symbols[1]
	for _, symbol in ipairs(symbols) do
		if (symbol.Triple or 0) > (bestSymbol.Triple or 0) then
			bestSymbol = symbol
		end
	end
	local attract = table.clone(Locale.Pick(ATTRACT_TEXTS))

	task.spawn(function()
		local tick = 0
		while ctx.IsAlive() do
			if enabled and not spinning and os.clock() >= infoLockUntil then
				tick += 1
				local phase = tick % 3
				if phase == 0 and bestSymbol then
					local icon = bestSymbol.Icon
					setInfo(Locale.T("Triple %s = %s!", icon .. icon .. icon, "+" .. Format.Format(rewardFor(bestSymbol.Triple or 0))), GOLD_LIGHT)
				elseif phase == 1 then
					setInfo(attract[random:NextInteger(1, #attract)], Color3.fromRGB(255, 220, 150))
				else
					setInfo(Locale.T("1 free token every %s of play", clockText(tokenBase.Interval)), LED_TEXT)
				end
			end
			task.wait(3)
		end
	end)
end

return Casino
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="102">
          <Properties>
            <string name="Name">CoralKeys</string>
            <string name="Source"><![CDATA[--[[
	CoralKeys (ModuleScript - stimulus) — amélioration "Clavier corail" (10 niveaux,
	après une visite à l'océan)
	Emplacement : ReplicatedStorage > Client > Stimuli > CoralKeys

	Un clavier venu de l'océan : boîtier turquoise, touches galets couleur
	corail / coquillage / sable / lagon, posé sur un tapis de sable avec une
	frange d'écume.
	v9.1 : un VRAI clavier QWERTY cliquable (Gear/ClickableKeys, comme le
	clavier mécanique) : chaque touche frappée s'enfonce, joue un son de
	touche plus doux (Config.ClickSounds Keyboard1..5 selon le niveau, plus
	grave), fait monter une bulle et compte comme un vrai clic. Trop petit
	pour viser ? badge 🔍 -> grand clavier corail flottant. Le vrai clavier
	du joueur l'anime aussi (le clavier mécanique, s'il est là, compte le clic).
	Chaque niveau ajoute quelque chose :
	  1 clavier corail + 1 bulle par clic   2 touches nacrées
	  3 algues                              4 étoile de mer + 2 bulles
	  5 coquillage                          6 poisson-clown qui nage
	  7 branches de corail + 3 bulles       8 touches bioluminescentes (lueur lagon)
	  9 palourde avec sa perle              10 touches sirène irisées + grosses bulles
	Au repos : une bulle monte de temps en temps (et le poisson fait un tour).
]]

local Gear = script.Parent:WaitForChild("Gear")
local GearKit = require(Gear:WaitForChild("GearKit"))
local GearPiece = require(Gear:WaitForChild("GearPiece"))
local KeyboardArt = require(Gear:WaitForChild("KeyboardArt"))
local GearClick = require(Gear:WaitForChild("GearClick"))
local ClickableKeys = require(Gear:WaitForChild("ClickableKeys"))

local CoralKeys = {}
CoralKeys.Slot = "Background" -- sous l'interface (effets de clic : calque Overlay)

local STEP_FULL = 24 -- pas d'une touche (touche + écart) du clavier posé, échelle 1
local STEP_MINI = 21

-- Place en plus autour du boîtier : écume (haut), coquillages (bas), algues (côtés)
local function coralGeometry(layout: string, step: number): KeyboardArt.Geometry
	return KeyboardArt.Geometry(layout, step, step * 0.45, step * 0.5, step * 0.22)
end

local GEO_FULL = coralGeometry("Full", STEP_FULL)
local GEO_MINI = coralGeometry("Mini", STEP_MINI)
local FULL = Vector2.new(GEO_FULL.W, GEO_FULL.H)
local MINI = Vector2.new(GEO_MINI.W, GEO_MINI.H)
local INK = Color3.fromRGB(28, 70, 96)
local CORAL_PALETTE = {
	Color3.fromRGB(255, 138, 138),
	Color3.fromRGB(255, 204, 214),
	Color3.fromRGB(255, 236, 200),
	Color3.fromRGB(138, 232, 224),
}

local active: { [any]: any } = {}

local function bubblesPerClick(level: number): number
	if level >= 7 then
		return 3
	elseif level >= 4 then
		return 2
	end
	return 1
end

-- Étoile de mer : 5 branches autour d'un centre
local function starfish(parent: Instance, cx: number, cy: number, size: number, z: number)
	for index = 0, 4 do
		local angle = index * 72
		local r = math.rad(angle)
		local arm = GearKit.Box(parent, cx + math.sin(r) * size * 0.28, cy - math.cos(r) * size * 0.28, size * 0.3, size * 0.62, Color3.fromRGB(255, 150, 70), {
			Name = "Arm",
			Anchor = Vector2.new(0.5, 0.5),
			Radius = "round",
			Rotation = angle,
			Z = z,
		})
		GearKit.Box(arm, size * 0.1, size * 0.12, size * 0.1, size * 0.1, Color3.fromRGB(255, 230, 190), { Name = "Dot", Radius = "round", Z = z + 1 })
	end
	GearKit.Box(parent, cx, cy, size * 0.36, size * 0.36, Color3.fromRGB(255, 170, 90), { Name = "Center", Anchor = Vector2.new(0.5, 0.5), Radius = "round", Z = z + 1 })
end


local function keyColorFn(level: number): (key: KeyboardArt.Key) -> Color3
	local count = 0
	return function(key: KeyboardArt.Key): Color3
		count += 1
		if level >= 10 then
			return GearKit.Rainbow(0.45 + key.Fx * 0.5 + key.Fy * 0.08, 0.32, 1) -- touches sirène
		end
		if level >= 2 and count % 5 == 0 then
			return Color3.fromRGB(252, 248, 255) -- nacre
		end
		return CORAL_PALETTE[(key.Row + key.Col) % #CORAL_PALETTE + 1]
	end
end

-- Dessine le clavier corail pour un pas de touche `step`.
-- Renvoie (touches, largeur, hauteur, poisson-clown ou nil).
local function drawCoral(root: Instance, layout: string, step: number, level: number): ({ KeyboardArt.Key }, number, number, Frame?)
	local geo = coralGeometry(layout, step)
	local W, H = geo.W, geo.H
	local s = step / STEP_FULL

	-- Tapis de sable + frange d'écume
	local top = 6 * s
	GearKit.Outlined(root, 0, top, W, H - top, Color3.fromRGB(252, 228, 182), {
		Name = "Sand",
		Radius = 16 * s,
		Outline = 2 * s,
		OutlineColor = Color3.fromRGB(196, 150, 90),
		Z = 2,
		LineZ = 1,
		Gradient = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(236, 214, 190)),
	})
	GearKit.Box(root, 0, top, W, 11 * s, Color3.fromRGB(120, 222, 230), { Name = "Foam", Radius = 12 * s, Z = 3, Transparency = 0.15 })
	local dots = math.floor((W - 20 * s) / (22 * s))
	for index = 0, dots do
		GearKit.Box(root, 8 * s + index * 22 * s, top + 5 * s + (index % 2) * 2 * s, 12 * s, 5 * s, Color3.new(1, 1, 1), { Name = "FoamDot", Radius = "round", Z = 3, Transparency = 0.1 })
	end
	for index, ripple in ipairs({ { 0.14, 0.955 }, { 0.62, 0.96 }, { 0.38, 0.975 }, { 0.84, 0.95 } }) do
		GearKit.Box(root, W * ripple[1], H * ripple[2] - 4 * s, (18 + index * 4) * s, 1.8 * s, Color3.fromRGB(214, 176, 120), {
			Name = "Ripple",
			Radius = "round",
			Z = 3,
			Transparency = 0.35,
		})
	end

	-- Lueur lagon (bioluminescence)
	if level >= 8 then
		GearKit.Box(root, geo.CaseX - 6 * s, geo.CaseY - 6 * s, geo.CaseW + 12 * s, geo.CaseH + 12 * s, Color3.fromRGB(90, 255, 230), { Name = "Glow", Radius = 18 * s, Z = 4, Transparency = 0.45 })
	end

	-- Algues (à gauche, le long du boîtier)
	if level >= 3 then
		for strand = 0, 1 do
			for leaf = 0, 3 do
				GearKit.Outlined(root, 1 * s + strand * 5 * s + (leaf % 2) * 3 * s, geo.CaseY + geo.CaseH - 12 * s - leaf * 14 * s - strand * 6 * s, 7 * s, 15 * s, Color3.fromRGB(96, 206, 120), {
					Name = "Leaf",
					Radius = "round",
					Rotation = (leaf % 2 == 0) and -18 or 18,
					Outline = 1.2 * s,
					OutlineColor = Color3.fromRGB(40, 120, 70),
					Z = 12,
					LineZ = 11,
				})
			end
		end
	end

	-- Boîtier + plaque + touches galets
	GearKit.Outlined(root, geo.CaseX, geo.CaseY, geo.CaseW, geo.CaseH, Color3.fromRGB(84, 206, 206), {
		Name = "Case",
		Radius = 13 * s,
		Outline = 2.2 * s,
		OutlineColor = INK,
		Z = 6,
		LineZ = 5,
		Gradient = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(190, 225, 235)),
	})
	GearKit.Box(root, geo.CaseX + 6 * s, geo.CaseY + 2 * s, geo.CaseW - 12 * s, 2.5 * s, Color3.new(1, 1, 1), { Name = "CaseShine", Radius = "round", Transparency = 0.4, Z = 7 })
	GearKit.Box(root, geo.KeysX - 3 * s, geo.KeysY - 3 * s, geo.KeysW + 6 * s, geo.KeysH + 6 * s, Color3.fromRGB(30, 112, 142), { Name = "Plate", Radius = 8 * s, Z = 7 })
	local keys = KeyboardArt.Build(root, layout, geo.KeysX, geo.KeysY, geo.KeysW, geo.KeysH, {
		Color = keyColorFn(level),
		LegendColor = function(_key: KeyboardArt.Key): Color3
			return INK
		end,
		Radius = 0.32, -- touches "galets"
		Z = 8,
	})

	-- Branches de corail (coin haut gauche du boîtier)
	if level >= 7 then
		local coral = Color3.fromRGB(255, 110, 150)
		local line = Color3.fromRGB(170, 40, 80)
		local bx, by = geo.CaseX + 12 * s, geo.CaseY - 16 * s
		GearKit.Outlined(root, bx, by, 5 * s, 20 * s, coral, { Name = "Coral", Radius = "round", Outline = 1.2 * s, OutlineColor = line, Z = 14, LineZ = 13 })
		GearKit.Outlined(root, bx - 6 * s, by + 5 * s, 5 * s, 13 * s, coral, { Name = "Coral", Radius = "round", Rotation = -35, Outline = 1.2 * s, OutlineColor = line, Z = 14, LineZ = 13 })
		GearKit.Outlined(root, bx + 6 * s, by + 4 * s, 5 * s, 13 * s, coral, { Name = "Coral", Radius = "round", Rotation = 35, Outline = 1.2 * s, OutlineColor = line, Z = 14, LineZ = 13 })
		for _, dot in ipairs({ { bx + 2.5 * s, by - 1 * s }, { bx - 7 * s, by + 4 * s }, { bx + 11 * s, by + 3 * s } }) do
			GearKit.Box(root, dot[1], dot[2], 4.5 * s, 4.5 * s, Color3.fromRGB(255, 200, 220), { Name = "Polyp", Anchor = Vector2.new(0.5, 0.5), Radius = "round", Z = 15 })
		end
	end

	-- Étoile de mer, coquillage, palourde (sur le sable, sous le boîtier)
	local sandY = geo.CaseY + geo.CaseH
	local sandH = H - sandY
	if level >= 4 then
		starfish(root, W - 16 * s, sandY + sandH * 0.52, 20 * s, 14)
	end
	if level >= 5 then
		local shell = GearKit.Outlined(root, 8 * s, sandY + sandH * 0.3, 17 * s, 11 * s, Color3.fromRGB(255, 190, 200), {
			Name = "Shell",
			Radius = 6 * s,
			Outline = 1.2 * s,
			OutlineColor = Color3.fromRGB(190, 90, 120),
			Z = 14,
			LineZ = 13,
		})
		for index = 1, 3 do
			GearKit.Box(shell, index * 4.2 * s, 2 * s, 1.3 * s, 8 * s, Color3.fromRGB(210, 120, 150), { Name = "Ridge", Z = 15 })
		end
	end
	if level >= 9 then
		GearKit.Outlined(root, W / 2 - 12 * s, sandY + sandH * 0.3, 24 * s, 10 * s, Color3.fromRGB(170, 150, 230), {
			Name = "Clam",
			Radius = 5 * s,
			Outline = 1.2 * s,
			OutlineColor = Color3.fromRGB(90, 70, 160),
			Z = 14,
			LineZ = 13,
		})
		local pearl = GearKit.Box(root, W / 2, sandY + sandH * 0.3 + 1 * s, 9 * s, 9 * s, Color3.fromRGB(255, 252, 255), { Name = "Pearl", Anchor = Vector2.new(0.5, 0.5), Radius = "round", Z = 15 })
		GearKit.Shine(pearl, 1.5 * s, 1.5 * s, 3 * s, 3 * s, 0, 16)
	end

	-- Poisson-clown (dans l'écume, en haut à droite)
	local fish: Frame? = nil
	if level >= 6 then
		local holder = Instance.new("Frame")
		holder.Name = "Fish"
		holder.BackgroundTransparency = 1
		holder.AnchorPoint = Vector2.new(0.5, 0.5)
		holder.Size = UDim2.fromOffset(26 * s, 15 * s)
		holder.Position = UDim2.fromOffset(W - 34 * s, top + 6 * s)
		holder.ZIndex = 16
		GearKit.Outlined(holder, 18 * s, 2.5 * s, 8 * s, 10 * s, Color3.fromRGB(255, 140, 40), { Name = "Tail", Rotation = 45, Radius = 2 * s, Outline = 1.2 * s, OutlineColor = INK, Z = 2, LineZ = 1 })
		local body = GearKit.Outlined(holder, 1 * s, 1 * s, 20 * s, 13 * s, Color3.fromRGB(255, 140, 40), { Name = "Body", Radius = "round", Outline = 1.2 * s, OutlineColor = INK, Z = 3, LineZ = 1 })
		GearKit.Box(body, 7.5 * s, 0, 3 * s, 13 * s, Color3.new(1, 1, 1), { Name = "Stripe", Z = 4 })
		GearKit.Box(body, 3 * s, 4 * s, 2.6 * s, 2.6 * s, Color3.fromRGB(30, 30, 40), { Name = "Eye", Radius = "round", Z = 5 })
		holder.Parent = root
		fish = holder
	end
	return keys, W, H, fish
end

function CoralKeys.Start(ctx)
	local animator = GearKit.Animator(ctx)
	local piece = GearPiece.new(ctx, {
		Id = "CoralKeys",
		Size = FULL,
		Shapes = { MINI },
		Priority = 2.5, -- v9.1 : cliquable -> avant les accessoires décoratifs
		MinScale = 0.3,
		MaxScale = 1,
		SizePenalty = 420,
		GlowColor = Color3.fromRGB(170, 250, 240),
		ContainerZ = 1102,
		Anchor = function(button, _canvas)
			-- Sous le clavier mécanique, à gauche
			return Vector2.new(button.X0 - 170, button.Y1 + 215)
		end,
	}, animator)
	local random = ctx.Random

	local fish: Frame? = nil
	local fishHome = Vector2.zero

	local function level(): number
		return math.max(1, piece.Level)
	end

	-- Bulles (sur la toile), réutilisées
	local bubbles = GearKit.Pool(9, function()
		local bubble = Instance.new("Frame")
		bubble.Name = "Bubble"
		bubble.AnchorPoint = Vector2.new(0.5, 0.5)
		bubble.BackgroundColor3 = Color3.fromRGB(190, 250, 255)
		bubble.BackgroundTransparency = 0.7
		bubble.BorderSizePixel = 0
		bubble.ZIndex = 22
		bubble.Visible = false
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = bubble
		local stroke = Instance.new("UIStroke")
		stroke.Name = "Stroke"
		stroke.Color = Color3.fromRGB(255, 255, 255)
		stroke.Thickness = 1.2
		stroke.Transparency = 0.15
		stroke.Parent = bubble
		local shine = Instance.new("Frame")
		shine.Name = "Shine"
		shine.BackgroundColor3 = Color3.new(1, 1, 1)
		shine.BorderSizePixel = 0
		shine.Position = UDim2.fromScale(0.22, 0.18)
		shine.Size = UDim2.fromScale(0.28, 0.28)
		shine.ZIndex = 23
		local shineCorner = Instance.new("UICorner")
		shineCorner.CornerRadius = UDim.new(0.5, 0)
		shineCorner.Parent = shine
		shine.Parent = bubble
		bubble.Parent = piece.FX
		return bubble
	end)

	-- Bulle qui monte depuis un point de la toile
	local function releaseBubbleAt(origin: Vector2, big: boolean)
		if not GearKit.EffectsOn(ctx) then
			return
		end
		local bubble = bubbles:Next()
		local placeScale = math.max(0.7, piece.PlaceScale.Scale)
		local size = (big and random:NextNumber(10, 16) or random:NextNumber(6, 11)) * placeScale
		local rise = random:NextNumber(46, 78) * placeScale
		local wobble = random:NextNumber(3, 7)
		local phase = random:NextNumber(0, math.pi * 2)
		local duration = random:NextNumber(0.8, 1.1)
		local stroke = bubble:FindFirstChild("Stroke") :: UIStroke?
		animator:Play(bubble, duration, function(t)
			bubble.Visible = t < 1
			local popping = t > 0.86
			local sz = size * (0.6 + 0.4 * math.min(1, t * 3)) * (popping and (1 + (t - 0.86) * 4) or 1)
			bubble.Size = UDim2.fromOffset(sz, sz)
			bubble.Position = UDim2.fromOffset(origin.X + math.sin(phase + t * 7) * wobble, origin.Y - rise * GearKit.Ease.OutQuad(t))
			local fade = popping and (t - 0.86) / 0.14 or 0
			bubble.BackgroundTransparency = 0.7 + 0.3 * fade
			if stroke then
				stroke.Transparency = 0.15 + 0.85 * fade
			end
		end, function()
			bubble.Visible = false
		end)
	end

	local function releaseBubble(fromLocal: Vector2, big: boolean)
		local origin = piece:ToCanvas(fromLocal)
		if origin then
			releaseBubbleAt(origin, big)
		end
	end

	-- Le poisson sursaute
	local function fishJump()
		local swimmer = fish
		if swimmer then
			animator:Play("fishJump", 0.3, function(t)
				swimmer.Rotation = math.sin(t * math.pi * 4) * 14 * (1 - t)
			end)
		end
	end

	local keys
	keys = ClickableKeys.new(ctx, piece, animator, {
		Id = "CoralKeys",
		InputPriority = 2,
		StepFull = STEP_FULL,
		StepMini = STEP_MINI,
		Draw = drawCoral,
		Title = function(): string
			return ClickableKeys.TitleFor("🪸", "Coral Keyboard", level())
		end,
		Tray = Color3.fromRGB(18, 70, 96),
		BadgeInk = INK,
		Lit = function(lv: number): Color3?
			return lv >= 8 and Color3.fromRGB(120, 255, 235) or nil
		end,
		SoundPitch = 0.86, -- plus doux, plus grave
		OnBuilt = function(_root, _list, extra)
			animator:Stop("fish", true)
			fish = extra
			if extra then
				fishHome = Vector2.new(extra.Position.X.Offset, extra.Position.Y.Offset)
			end
		end,
		OnStrike = function(_key: KeyboardArt.Key, point: Vector2?)
			-- Une bulle monte de la touche frappée (clavier posé)
			if point and not keys.Panel:IsOpen() then
				releaseBubbleAt(point, level() >= 10)
			end
			fishJump()
		end,
	})
	keys:Build(level())
	piece.OnLevel = function(lv, _previous)
		keys:LevelChanged(lv)
	end

	-- Clic sur le gros bouton (ou autre accessoire) : touches + bulles
	ctx.Connect(ctx.State.Clicked, function()
		if not ctx.IsVisible() or not piece:IsShown() or GearClick.Source == "CoralKeys" then
			return
		end
		local lv = level()
		local pressed = KeyboardArt.Pick(keys.Keys, 2, random)
		for index, key in ipairs(pressed) do
			keys:AnimateKey(key, (index - 1) * 0.04)
		end
		for index = 1, bubblesPerClick(lv) do
			local key = pressed[(index - 1) % math.max(1, #pressed) + 1]
			if key then
				releaseBubble(Vector2.new(key.X + key.W / 2 + random:NextNumber(-6, 6), key.Y), lv >= 10)
			end
		end
		fishJump()
	end)

	-- Au repos : une bulle, et le poisson fait un petit tour
	GearKit.Every(ctx, 3, 5.5, function()
		if not piece:IsShown() then
			return
		end
		local width = piece.Size.X
		releaseBubble(Vector2.new(random:NextNumber(width * 0.2, width * 0.8), 20), false)
		keys:Wiggle()
		local swimmer = fish
		if swimmer and random:NextNumber() < 0.5 then
			local home = fishHome
			local lastStep = -1
			animator:Play("fish", 2.4, function(t)
				local step = math.floor(t * 72) -- (≤ 30 images/s)
				if step == lastStep then
					return
				end
				lastStep = step
				local k = step / 72
				local angle = k * math.pi * 2
				local x = home.X - math.min(70, piece.Size.X * 0.45) * math.sin(angle * 0.5)
				local y = home.Y + math.sin(angle) * 3
				swimmer.Position = UDim2.fromOffset(x, y)
				swimmer.Rotation = math.cos(angle * 3) * 6
			end, function()
				swimmer.Position = UDim2.fromOffset(home.X, home.Y)
				swimmer.Rotation = 0
			end)
		end
	end)

	active[ctx] = { Piece = piece, Keys = keys }
end

function CoralKeys.Stop(ctx)
	local entry = active[ctx]
	active[ctx] = nil
	if entry then
		entry.Keys:Destroy()
		entry.Piece:Destroy()
	end
end

return CoralKeys
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="103">
          <Properties>
            <string name="Name">Cosmos</string>
          </Properties>
          <Item class="ModuleScript" referent="104">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[--[[
	Cosmos > Kit (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Stimuli > Cosmos > Kit

	Petite boîte à outils commune aux stimuli « cosmiques » :
	  - dessin en Frames (cercles, anneaux, losanges-étoiles, éclats à 4
	    branches, arcs "◡" pour les yeux fermés, dégradés, contours) ;
	  - palette claire / sombre (les objets ont un contour "sticker" doux
	    sur fond clair, une lueur sur fond sombre) ;
	  - boucle d'animation limitée (≤ 20-24 images/s, une seule par
	    stimulus, en pause quand le stimulus est caché, ralentie quand une
	    fenêtre est ouverte par-dessus) ;
	  - suivi du niveau d'une amélioration et du mode sombre ;
	  - objet "posé" par le planificateur (Zones) : cadre centré + UIScale,
	    apparition "pop", glissement quand la place change.
	Rien n'est créé à chaque image : les stimuli construisent leurs objets
	une fois (ou à un changement de niveau / de thème) et les recyclent.
]]

local TweenService = game:GetService("TweenService")

local Kit = {}

----------------------------------------------------------------------
-- Création
----------------------------------------------------------------------

-- Instance + propriétés (Parent appliqué en dernier)
function Kit.New(className: string, props: { [string]: any }, parent: Instance?): any
	local instance = Instance.new(className)
	for key, value in pairs(props) do
		(instance :: any)[key] = value
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

-- Cadre simple (sans bordure, non cliquable). props.Color / props.Alpha raccourcis.
function Kit.Box(parent: Instance, props: { [string]: any }): Frame
	local frame = Instance.new("Frame")
	frame.BorderSizePixel = 0
	frame.Active = false
	for key, value in pairs(props) do
		if key == "Color" then
			frame.BackgroundColor3 = value
		elseif key == "Alpha" then
			frame.BackgroundTransparency = value
		else
			(frame :: any)[key] = value
		end
	end
	frame.Parent = parent
	return frame
end

function Kit.Corner(parent: Instance, radius: (number | UDim)?): UICorner
	local value: any = radius or UDim.new(1, 0)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = if typeof(value) == "UDim" then value else UDim.new(0, value)
	corner.Parent = parent
	return corner
end

function Kit.Stroke(parent: Instance, color: Color3, thickness: number, transparency: number?): UIStroke
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = thickness
	stroke.Transparency = transparency or 0
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = parent
	return stroke
end

function Kit.Gradient(parent: Instance, color: ColorSequence?, transparency: NumberSequence?, rotation: number?): UIGradient
	local gradient = Instance.new("UIGradient")
	if color then
		gradient.Color = color
	end
	if transparency then
		gradient.Transparency = transparency
	end
	gradient.Rotation = rotation or 0
	gradient.Parent = parent
	return gradient
end

-- NumberSequence depuis { t0, v0, t1, v1, ... } (t de 0 à 1, au plus 20 points)
function Kit.Fade(points: { number }): NumberSequence
	local keypoints = {}
	for index = 1, #points - 1, 2 do
		table.insert(keypoints, NumberSequenceKeypoint.new(math.clamp(points[index], 0, 1), math.clamp(points[index + 1], 0, 1)))
	end
	return NumberSequence.new(keypoints)
end

-- ColorSequence depuis { t0, c0, t1, c1, ... }
function Kit.Colors(points: { any }): ColorSequence
	local keypoints = {}
	for index = 1, #points - 1, 2 do
		table.insert(keypoints, ColorSequenceKeypoint.new(math.clamp(points[index] :: number, 0, 1), points[index + 1] :: Color3))
	end
	return ColorSequence.new(keypoints)
end

-- Cercle plein centré en (x, y) (repère du parent, pixels "design")
function Kit.Circle(parent: Instance, x: number, y: number, diameter: number, color: Color3, alpha: number?, z: number?): Frame
	local circle = Kit.Box(parent, {
		Name = "Circle",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(diameter, diameter),
		BackgroundColor3 = color,
		BackgroundTransparency = alpha or 0,
		ZIndex = z or 1,
	})
	Kit.Corner(circle)
	return circle
end

-- Ellipse (cadre arrondi) centrée
function Kit.Ellipse(parent: Instance, x: number, y: number, w: number, h: number, color: Color3, alpha: number?, z: number?): Frame
	local ellipse = Kit.Box(parent, {
		Name = "Ellipse",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, h),
		BackgroundColor3 = color,
		BackgroundTransparency = alpha or 0,
		ZIndex = z or 1,
	})
	Kit.Corner(ellipse)
	return ellipse
end

-- Anneau (contour seul) centré
function Kit.Ring(parent: Instance, x: number, y: number, diameter: number, color: Color3, thickness: number, alpha: number?, z: number?): (Frame, UIStroke)
	local ring = Kit.Box(parent, {
		Name = "Ring",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(diameter, diameter),
		BackgroundTransparency = 1,
		ZIndex = z or 1,
	})
	Kit.Corner(ring)
	local stroke = Kit.Stroke(ring, color, thickness, alpha)
	return ring, stroke
end

-- Petite étoile en losange (carré tourné de 45°) : 1 seule instance
function Kit.Diamond(parent: Instance, x: number, y: number, size: number, color: Color3, alpha: number?, z: number?): Frame
	return Kit.Box(parent, {
		Name = "Star",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(size, size),
		Rotation = 45,
		BackgroundColor3 = color,
		BackgroundTransparency = alpha or 0,
		ZIndex = z or 1,
	})
end

-- Éclat à 4 branches (✦) : deux traits effilés (dégradé de transparence).
-- Renvoie le cadre porteur (à faire tourner / scintiller).
function Kit.Glint(parent: Instance, x: number, y: number, size: number, color: Color3, z: number?): Frame
	local holder = Kit.Box(parent, {
		Name = "Glint",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
		ZIndex = z or 1,
	})
	local taper = Kit.Fade({ 0, 1, 0.5, 0, 1, 1 })
	local thickness = math.max(2, math.floor(size * 0.16 + 0.5))
	local vertical = Kit.Box(holder, {
		Name = "V",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, thickness, 1, 0),
		BackgroundColor3 = color,
		ZIndex = z or 1,
	})
	Kit.Gradient(vertical, nil, taper, 90)
	local horizontal = Kit.Box(holder, {
		Name = "H",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0.72, 0, 0, thickness),
		BackgroundColor3 = color,
		ZIndex = z or 1,
	})
	Kit.Gradient(horizontal, nil, taper, 0)
	return holder
end

-- Arc "◡" (œil fermé, sourire) : moitié basse d'une ellipse en contour,
-- découpée par un cadre (jamais tourné : la découpe reste valable).
function Kit.Arc(parent: Instance, x: number, y: number, w: number, h: number, color: Color3, thickness: number, z: number?): Frame
	local clip = Kit.Box(parent, {
		Name = "Arc",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w + thickness * 2 + 2, h / 2 + thickness + 1),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		ZIndex = z or 1,
	})
	local ellipse = Kit.Box(clip, {
		Name = "Curve",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.fromOffset(w, h),
		BackgroundTransparency = 1,
		ZIndex = z or 1,
	})
	Kit.Corner(ellipse)
	Kit.Stroke(ellipse, color, thickness, 0)
	return clip
end

-- Texte simple (taille fixe, suit l'UIScale du parent)
function Kit.Text(parent: Instance, text: string, x: number, y: number, size: number, color: Color3, z: number?): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.fromOffset(x, y)
	label.Size = UDim2.fromOffset(size * 2, size * 1.4)
	label.Font = Enum.Font.FredokaOne
	label.Text = text
	label.TextSize = size
	label.TextColor3 = color
	label.TextScaled = false
	label.ZIndex = z or 1
	label.Parent = parent
	return label
end

----------------------------------------------------------------------
-- Couleurs
----------------------------------------------------------------------

function Kit.Rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

-- Mélange vers le blanc (t = 0..1)
function Kit.Tint(color: Color3, t: number): Color3
	return color:Lerp(Color3.new(1, 1, 1), t)
end

-- Mélange vers le noir (t = 0..1)
function Kit.Shade(color: Color3, t: number): Color3
	return color:Lerp(Color3.new(0, 0, 0), t)
end

-- Contour "sticker" : encre violette douce sur fond clair, lavande pâle sur fond sombre
function Kit.Ink(dark: boolean): Color3
	return if dark then Color3.fromRGB(226, 216, 255) else Color3.fromRGB(78, 62, 122)
end

----------------------------------------------------------------------
-- Suivi (niveau, thème, effets)
----------------------------------------------------------------------

function Kit.IsDark(ctx): boolean
	return ctx.State.DarkMode == true
end

-- callback(dark) quand le mode sombre change
function Kit.WatchTheme(ctx, callback: (dark: boolean) -> ())
	ctx.Connect(ctx.State.DarkModeChanged, function(enabled)
		callback(enabled == true)
	end)
end

-- callback(nouveau, ancien) quand le niveau de `upgradeId` change (état
-- serveur reçu ~5 fois/s : simple comparaison, rien d'autre)
function Kit.WatchLevel(ctx, upgradeId: string, callback: (level: number, previous: number) -> ()): number
	local current = math.max(1, ctx.GetLevel(upgradeId))
	ctx.Connect(ctx.State.Changed, function()
		local level = ctx.GetLevel(upgradeId)
		if level > 0 and level ~= current then
			local previous = current
			current = level
			callback(level, previous)
		end
	end)
	return current
end

-- Vrai si le joueur n'a pas coupé les effets (⚙️)
function Kit.Effects(ctx): boolean
	return ctx.EffectsEnabled == nil or ctx.EffectsEnabled()
end

-- Boucle d'animation (UNE par stimulus) limitée à `hz` images/s ; moitié
-- moins quand une fenêtre est ouverte par-dessus ; rien quand c'est caché.
-- fn(dt, t) : dt = temps écoulé depuis le dernier appel, t = temps total.
function Kit.Loop(ctx, hz: number, fn: (dt: number, t: number) -> ())
	local step = 1 / hz
	local pending = 0
	local clock = 0
	return ctx.OnRender(function(dt: number)
		pending += dt
		local wanted = step
		if ctx.GetVisibility() == "Dimmed" then
			wanted = step * 2
		end
		if pending < wanted then
			return
		end
		local elapsed = math.min(pending, 0.25)
		pending = 0
		if not ctx.IsVisible() then
			return
		end
		clock += elapsed
		fn(elapsed, clock)
	end)
end

----------------------------------------------------------------------
-- Objet posé par le planificateur
----------------------------------------------------------------------

export type Piece = {
	Frame: Frame,
	Scale: UIScale,
	Placed: boolean,
	Target: number, -- échelle donnée par le planificateur
}

-- Cadre transparent de taille "design" w x h, centré (AnchorPoint 0.5),
-- avec un UIScale ; caché tant qu'il n'a pas de place.
function Kit.Piece(parent: Instance, name: string, w: number, h: number): Piece
	local frame = Kit.Box(parent, {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(w, h),
		BackgroundTransparency = 1,
		Visible = false,
	})
	local scale = Instance.new("UIScale")
	scale.Scale = 1
	scale.Parent = frame
	return { Frame = frame, Scale = scale, Placed = false, Target = 1 }
end

-- Applique une place (Zones) : "pop" la 1re fois, glissement ensuite ;
-- false = pas de place (caché)
function Kit.Place(piece: Piece, placement: any)
	local frame, scale = piece.Frame, piece.Scale
	if not placement then
		frame.Visible = false
		frame:SetAttribute("LayoutObstacle", nil)
		piece.Placed = false
		return
	end
	-- Convention partagée : les autres stimuli (accessoires de clic...) évitent cet objet
	frame:SetAttribute("LayoutObstacle", true)
	local position = UDim2.fromOffset(placement.X, placement.Y)
	frame.Size = UDim2.fromOffset(placement.W, placement.H)
	piece.Target = placement.Scale
	if not piece.Placed then
		piece.Placed = true
		frame.Position = position
		frame.Visible = true
		scale.Scale = placement.Scale * 0.2
		TweenService:Create(scale, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = placement.Scale }):Play()
	else
		frame.Visible = true
		local info = TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		TweenService:Create(frame, info, { Position = position }):Play()
		TweenService:Create(scale, info, { Scale = placement.Scale }):Play()
	end
end

-- Petit "boing" quand le niveau monte (l'objet grossit puis revient)
function Kit.Bump(piece: Piece)
	if not piece.Placed then
		return
	end
	local scale = piece.Scale
	local target = piece.Target
	scale.Scale = target * 1.12
	TweenService:Create(scale, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = target }):Play()
end

-- Tween court (raccourci)
function Kit.Tween(instance: Instance, duration: number, props: { [string]: any }, style: Enum.EasingStyle?, direction: Enum.EasingDirection?)
	local tween = TweenService:Create(instance, TweenInfo.new(duration, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

return Kit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="105">
            <Properties>
              <string name="Name">Zones</string>
              <string name="Source"><![CDATA[--[[
	Cosmos > Zones (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Stimuli > Cosmos > Zones

	Planificateur de place partagé par les 10 stimuli « cosmiques » (SleepMode,
	DeepFocus, Seashell, DreamMachine, Aurora, TimeWarp, GalaxyStream,
	Singularity, InfiniteScroll, Multiverse). Ils sont tous dans le calque
	Background (SOUS les cartes et la colonne centrale) : ils ne cachent jamais
	une information, mais il faut les poser là où le fond se voit vraiment.

	  - Profondeur (convention du calque Background) : fond du thème 0, mode
	    néon ~50, COSMOS 301-310 (Zones.Depth : ciel lointain -> anneaux ->
	    objets), nuages de l'orage 1000, accessoires de clic 1101-1107.
	    Nos conteneurs découpent leur contenu (rien sous la barre Roblox).
	  - Territoire (règle du chef de projet) : les accessoires de clic
	    (CLICKGEAR) ont la « bande centrale » au-dessus du BAS RÉEL de la
	    barre d'améliorations (autour du bouton et du compteur, à côté des
	    pastilles, poches à côté de la barre). Les OBJETS cosmiques vont
	    partout ailleurs : gouttières entre les cartes du bas, couloirs entre
	    les slots de côté et CL / CR, espaces sous la barre, côtés libres.
	    Les effets d'ambiance (aurore, rivière d'étoiles, anneaux, ondes du
	    temps) peuvent passer partout, très transparents.
	  - Place : grille d'occupation (cases de 8 px "design") : bandeau
	    d'actualités, cartes des slots présentes, colonne centrale (rectangle
	    réel de la barre d'améliorations), bande des accessoires, et objets
	    des autres stimuli marqués LayoutObstacle = true (convention
	    partagée ; nos objets posés le sont aussi). Chaque objet demande une
	    ou plusieurs places (taille "design", formes de rechange, point
	    préféré, échelle min / max). Service en 2 tours : le 1er objet de
	    chaque stimulus (ordre Zones.Priority : la machine à rêves d'abord),
	    puis les objets en plus (2e / 3e portail, téléphones...). Ce qui ne
	    tient pas est « replié » en tout petit (échelle 0,25 minimum) plutôt
	    que de disparaître. Deux objets ne se chevauchent jamais.
	  - Stabilité : un objet garde sa place tant qu'elle reste libre (sauf si
	    une place nettement plus grande se libère, ex. après l'océan).
	  - Replanification regroupée (jamais à chaque image) : écran (appareil,
	    taille), carte qui apparaît / disparaît, barre qui change de taille,
	    stimulus cosmique qui démarre / s'arrête, et vérification toutes les
	    1,5 s (objet d'un autre stimulus posé sur un des nôtres).

	API :
	  Zones.Attach(ctx)                   -- profondeur + découpe du conteneur
	  Zones.Request(id, items, onPlace)   -- demande / met à jour des places
	  Zones.Release(id)                   -- libère (Stop du stimulus)
	  Zones.Schedule()                    -- demande une replanification
	  Zones.GetCanvas() -> Vector2        -- taille de la toile ("design")
	  Zones.GetFocus() -> Vector2         -- centre du compteur
	  Zones.PickPath(routes, width) -> i  -- courbe la plus visible (ambiance)
	  Zones.Bezier(points, u) -> Vector2
	  Zones.Changed                       -- Signal : mise en page recalculée
	Item = { W, H, Shapes? = { Vector2 } (formes de rechange), Anchor =
	         Vector2 (fraction de la toile), MinScale?, MaxScale?, Gap? }
	Placement = { X, Y (centre, px de la toile), Scale, Shape (0 = forme
	              principale, i = Shapes[i]), W, H, Folded? } ou false
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent.Parent
local Slots = require(Client.Slots)
local Interface = require(Client.Interface)
local Signal = require(ReplicatedStorage.Shared.Signal)

local Zones = {}

export type Rect = { X: number, Y: number, W: number, H: number }

export type Item = {
	W: number,
	H: number,
	Shapes: { Vector2 }?,
	Anchor: Vector2,
	MinScale: number?,
	MaxScale: number?,
	Gap: number?,
}

export type Placement = {
	X: number,
	Y: number,
	Scale: number,
	Shape: number,
	W: number,
	H: number,
	Folded: boolean?, -- replié en tout petit (pas de place à l'échelle minimale)
}

type Request = {
	Id: string,
	Priority: number,
	Items: { Item },
	OnPlace: (placements: { Placement | false }) -> (),
	Signature: string?,
	Previous: { Placement | false },
}

type Grid = {
	Cols: number,
	Rows: number,
	Occ: { number },
	Sat: { number },
}

-- ZIndex des conteneurs dans le calque Background (convention partagée)
Zones.Depth = {
	Aurora = 301,
	GalaxyStream = 302,
	DeepFocus = 303,
	TimeWarp = 304,
	InfiniteScroll = 305,
	Multiverse = 306,
	Seashell = 307,
	Singularity = 308,
	SleepMode = 309,
	DreamMachine = 310,
}

-- Ordre de service des demandes de place (plus petit = servi d'abord)
Zones.Priority = {
	DreamMachine = 1, -- place garantie : le joueur a demandé à la voir
	Seashell = 2,
	SleepMode = 3,
	Singularity = 4,
	Multiverse = 5,
	InfiniteScroll = 6,
	TimeWarp = 7, -- l'horloge est un bonus : ses ondes sont une ambiance
}

Zones.Changed = Signal.new()

local CELL = 8 -- taille d'une case de la grille (pixels "design")
local EDGE = 4 -- marge le long des bords de la toile
local TICKER_HEIGHT = 32
local SCALE_WEIGHT = 0.55 -- préférence "plus gros" face à "plus près du point préféré"
local MOVE_GAIN = 0.12 -- on ne quitte une place valable que pour une échelle nettement plus grande
local FOLD_SCALE = 0.25 -- dernier recours : objet replié en tout petit
local REPLAN_DELAY = 0.12
local CHECK_INTERVAL = 1.5
local BAR_MAX_HALF = 346 -- demi-largeur max de la barre d'améliorations (660 + marges)
local BAR_CHANGE = 12 -- replanifie si la barre change de plus de 12 px

-- Échelles essayées (de la plus grande à la plus petite)
local SCALES = { 1.5, 1.4, 1.3, 1.2, 1.1, 1, 0.92, 0.85, 0.78, 0.72, 0.66, 0.6, 0.55, 0.5, 0.45, 0.4, 0.36, 0.32, 0.28, 0.25 }

-- Colonne centrale (pixels "design" depuis le haut de la toile), d'après
-- CenterColumn / UpgradeBar ; sert aussi de secours si la barre est introuvable
local COLUMN = {
	Desktop = { PillsBottom = 294, Row1Half = 336, Row2Half = 300, TwoRows = true, BarHeight = 118 },
	Tablet = { PillsBottom = 302, Row1Half = 336, Row2Half = 300, TwoRows = true, BarHeight = 118 },
	Phone = { PillsBottom = 262, Row1Half = 300, Row2Half = 300, TwoRows = false, BarHeight = 102 },
}

-- Nos propres conteneurs (on ne s'évite pas soi-même)
local OWN = {}
for name in pairs(Zones.Depth) do
	OWN[name] = true
end

local requests: { [string]: Request } = {}
local bound = false
local planPending = false
local planning = false
local planAgain = false
local checking = false
-- Grille "visible" (sans la bande des accessoires) : pour Zones.PickPath
local viewGrid: Grid = { Cols = 0, Rows = 0, Occ = {}, Sat = {} }

----------------------------------------------------------------------
-- Toile, appareil
----------------------------------------------------------------------

function Zones.GetCanvas(): Vector2
	local canvas = Interface.CanvasSize
	if typeof(canvas) ~= "Vector2" or canvas.X < 100 or canvas.Y < 100 then
		return Vector2.new(1280, 720)
	end
	return canvas
end

local function device(): string
	local name = Interface.Device
	if COLUMN[name] then
		return name
	end
	return "Desktop"
end

-- Centre du compteur de Dopamine (anneaux de concentration...)
function Zones.GetFocus(): Vector2
	return Vector2.new(Zones.GetCanvas().X / 2, 156)
end

-- Rectangle (toile) d'un objet quelconque, d'après sa position à l'écran
local function screenRect(object: GuiObject): Rect?
	local scale = Interface.Scale
	if type(scale) ~= "number" or scale <= 0 then
		return nil
	end
	local size = object.AbsoluteSize / scale
	if size.X < 1 or size.Y < 1 then
		return nil
	end
	local topLeft = Interface.ScreenToCanvas(object.AbsolutePosition)
	return { X = topLeft.X, Y = topLeft.Y, W = size.X, H = size.Y }
end

----------------------------------------------------------------------
-- Barre d'améliorations : rectangle RÉEL (ScrollingFrame "Cards")
----------------------------------------------------------------------

local cardsFrame: GuiObject? = nil
local lastBar: Rect? = nil

local function findCards(): GuiObject?
	local cards = cardsFrame
	if cards and cards.Parent then
		return cards
	end
	cardsFrame = nil
	local main = Interface.Layers and Interface.Layers.Main
	local bar = main and main:FindFirstChild("UpgradeBar", true)
	local found = bar and bar:FindFirstChild("Cards")
	if found and found:IsA("GuiObject") then
		cardsFrame = found
		-- La barre change de taille (cartes ajoutées / retirées) : on replanifie
		found:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			local previous = lastBar
			local now = if found == cardsFrame then screenRect(found) else nil
			if previous and now and (math.abs(now.W - previous.W) >= BAR_CHANGE or math.abs(now.Y + now.H - previous.Y - previous.H) >= BAR_CHANGE) then
				Zones.Schedule()
			end
		end)
		return found
	end
	return nil
end

-- Rectangle de la barre (toile) ; secours : taille lue / constantes
local function barRect(canvas: Vector2): Rect
	local cx = canvas.X / 2
	local m = COLUMN[device()]
	local cards = findCards()
	if cards and cards.Visible then
		local rect = screenRect(cards)
		if rect and rect.W > 20 and rect.H > 20 and rect.Y > 100 then
			lastBar = rect
			return rect
		end
		local size = cards.Size
		if size.X.Scale == 0 and size.X.Offset > 0 then
			local half = math.clamp(size.X.Offset / 2 + 4, 40, BAR_MAX_HALF)
			local fallback = { X = cx - half, Y = m.PillsBottom + 22, W = half * 2, H = m.BarHeight }
			lastBar = fallback
			return fallback
		end
	end
	local fallback = { X = cx - BAR_MAX_HALF, Y = m.PillsBottom + 22, W = BAR_MAX_HALF * 2, H = m.BarHeight }
	lastBar = fallback
	return fallback
end

----------------------------------------------------------------------
-- Ce qui cache le fond
----------------------------------------------------------------------

-- Bouton + compteur
local function textRects(canvas: Vector2): { Rect }
	local cx = canvas.X / 2
	return {
		{ X = cx - 182, Y = 24, W = 346, H = 110 }, -- bouton, pastilles VIP / boost, maison, chapeau
		{ X = cx - 240, Y = 126, W = 480, H = 80 }, -- compteur + Dopamine par seconde
	}
end

local function columnRects(canvas: Vector2): { Rect }
	local cx = canvas.X / 2
	local m = COLUMN[device()]
	local rects = textRects(canvas)
	if m.TwoRows then
		table.insert(rects, { X = cx - m.Row1Half, Y = 202, W = m.Row1Half * 2, H = 48 })
		table.insert(rects, { X = cx - m.Row2Half, Y = 248, W = m.Row2Half * 2, H = m.PillsBottom - 248 })
	else
		table.insert(rects, { X = cx - m.Row1Half, Y = 202, W = m.Row1Half * 2, H = m.PillsBottom - 202 })
	end
	table.insert(rects, { X = cx - 156, Y = m.PillsBottom, W = 312, H = 24 }) -- jauge de combo
	table.insert(rects, barRect(canvas))
	return rects
end

-- Rectangle "design" d'un slot (même vide) sur la toile
local function slotDesignRect(name: string, canvas: Vector2): Rect?
	local def = Slots.Definitions[name]
	if not def then
		return nil
	end
	local position = Slots.GetPlacement(name)
	local cx = position.X.Scale * canvas.X + position.X.Offset
	local cy = position.Y.Scale * canvas.Y + position.Y.Offset
	if def.Anchor == "T" then
		return { X = 0, Y = cy - def.H / 2, W = canvas.X, H = def.H }
	end
	local k = Slots.GetScale(name)
	local w, h = def.W * k, def.H * k
	return { X = cx - w / 2, Y = cy - h / 2, W = w, H = h }
end

local function samePosition(a: UDim2, b: UDim2): boolean
	return math.abs(a.X.Scale - b.X.Scale) < 1e-3
		and math.abs(a.Y.Scale - b.Y.Scale) < 1e-3
		and math.abs(a.X.Offset - b.X.Offset) < 1
		and math.abs(a.Y.Offset - b.Y.Offset) < 1
end

-- Rectangle (toile) d'un cadre du calque Slots : slot connu (définition +
-- échelle, même pendant l'animation d'apparition) ou cadre quelconque
local function slotRect(child: GuiObject, canvas: Vector2): Rect?
	for name in pairs(Slots.Definitions) do
		if samePosition(Slots.GetPlacement(name), child.Position) then
			return slotDesignRect(name, canvas)
		end
	end
	local size = child.Size
	local w = size.X.Scale * canvas.X + size.X.Offset
	local h = size.Y.Scale * canvas.Y + size.Y.Offset
	if w <= 0 or h <= 0 or (w >= canvas.X * 0.9 and h >= canvas.Y * 0.9) then
		return nil -- calque plein écran : on l'ignore
	end
	local uiScale = child:FindFirstChildOfClass("UIScale")
	local k = uiScale and uiScale.Scale or 1
	w *= k
	h *= k
	local position = child.Position
	local anchor = child.AnchorPoint
	return {
		X = position.X.Scale * canvas.X + position.X.Offset - anchor.X * w,
		Y = position.Y.Scale * canvas.Y + position.Y.Offset - anchor.Y * h,
		W = w,
		H = h,
	}
end

-- Bandeau + cartes des slots + colonne centrale
local function blockedRects(canvas: Vector2): { Rect }
	local rects: { Rect } = { { X = 0, Y = 0, W = canvas.X, H = TICKER_HEIGHT } }
	local layer = Interface.Layers and Interface.Layers.Slots
	if layer then
		for _, child in ipairs(layer:GetChildren()) do
			if child:IsA("GuiObject") and child.Visible then
				local rect = slotRect(child, canvas)
				if rect then
					table.insert(rects, rect)
				end
			end
		end
	end
	for _, rect in ipairs(columnRects(canvas)) do
		table.insert(rects, rect)
	end
	return rects
end

-- Bande des accessoires de clic (interdite à nos OBJETS) : entre CL et CR
-- au-dessus de leur bas, puis entre les slots de côté jusqu'au bas réel de
-- la barre d'améliorations. Les couloirs entre les slots de côté et CL / CR
-- (au-dessus du bas de CL) restent à nous.
local function gearBand(canvas: Vector2): { Rect }
	local cl, cr = slotDesignRect("CL", canvas), slotDesignRect("CR", canvas)
	local l1, r1 = slotDesignRect("L1", canvas), slotDesignRect("R1", canvas)
	if not (cl and cr) then
		return {}
	end
	local bar = barRect(canvas)
	local top = cl.Y + cl.H
	local left = if l1 then l1.X + l1.W else cl.X
	local right = if r1 then r1.X else cr.X + cr.W
	return {
		{ X = cl.X, Y = 0, W = cr.X + cr.W - cl.X, H = top },
		{ X = left, Y = top, W = right - left, H = math.max(0, bar.Y + bar.H - top) },
	}
end

-- Objets des AUTRES stimuli marqués LayoutObstacle = true (calques plein écran)
local function markedRects(): { Rect }
	local rects: { Rect } = {}
	local layers = Interface.Layers
	if not layers then
		return rects
	end
	for _, layerName in ipairs({ "Overlay", "Background" }) do
		local layer = layers[layerName]
		if layer then
			for _, container in ipairs(layer:GetChildren()) do
				if container:IsA("GuiObject") and container.Visible and not OWN[container.Name] then
					for _, item in ipairs(container:GetChildren()) do
						if item:IsA("GuiObject") and item.Visible then
							if item:GetAttribute("LayoutObstacle") == true then
								local rect = screenRect(item)
								if rect then
									table.insert(rects, rect)
								end
							end
							for _, sub in ipairs(item:GetChildren()) do
								if sub:IsA("GuiObject") and sub.Visible and sub:GetAttribute("LayoutObstacle") == true then
									local rect = screenRect(sub)
									if rect then
										table.insert(rects, rect)
									end
								end
							end
						end
					end
				end
			end
		end
	end
	return rects
end

----------------------------------------------------------------------
-- Grille d'occupation (Occ[j * cols + i + 1] = 1 si la case (i, j) est prise)
----------------------------------------------------------------------

local function newGrid(canvas: Vector2): Grid
	local cols = math.max(1, math.ceil(canvas.X / CELL))
	local rows = math.max(1, math.ceil(canvas.Y / CELL))
	return { Cols = cols, Rows = rows, Occ = table.create(cols * rows, 0), Sat = {} }
end

local function mark(g: Grid, rect: Rect, pad: number)
	local cols, rows, occ = g.Cols, g.Rows, g.Occ
	local i0 = math.max(0, math.floor((rect.X - pad) / CELL))
	local i1 = math.min(cols - 1, math.ceil((rect.X + rect.W + pad) / CELL) - 1)
	local j0 = math.max(0, math.floor((rect.Y - pad) / CELL))
	local j1 = math.min(rows - 1, math.ceil((rect.Y + rect.H + pad) / CELL) - 1)
	for j = j0, j1 do
		local base = j * cols
		for i = i0, i1 do
			occ[base + i + 1] = 1
		end
	end
end

-- Sommes cumulées : "ce rectangle est-il libre ?" en O(1)
local function buildSat(g: Grid)
	local cols, rows, occ = g.Cols, g.Rows, g.Occ
	local stride = cols + 1
	local sat = table.create(stride * (rows + 1), 0)
	for j = 1, rows do
		local rowSum = 0
		local base = j * stride
		local previous = (j - 1) * stride
		local occBase = (j - 1) * cols
		for i = 1, cols do
			rowSum += occ[occBase + i]
			sat[base + i + 1] = sat[previous + i + 1] + rowSum
		end
	end
	g.Sat = sat
end

-- Nombre de cases prises dans [i, i + w) x [j, j + h)
local function takenCount(g: Grid, i: number, j: number, w: number, h: number): number
	local stride = g.Cols + 1
	local sat = g.Sat
	return sat[(j + h) * stride + i + w + 1] - sat[j * stride + i + w + 1] - sat[(j + h) * stride + i + 1] + sat[j * stride + i + 1]
end

local function markEdges(g: Grid, canvas: Vector2)
	mark(g, { X = 0, Y = 0, W = canvas.X, H = EDGE }, 0)
	mark(g, { X = 0, Y = canvas.Y - EDGE, W = canvas.X, H = EDGE }, 0)
	mark(g, { X = 0, Y = 0, W = EDGE, H = canvas.Y }, 0)
	mark(g, { X = canvas.X - EDGE, Y = 0, W = EDGE, H = canvas.Y }, 0)
end

-- Rectangle occupé par une place (sans marge)
local function placementRect(p: Placement): Rect
	local w, h = p.W * p.Scale, p.H * p.Scale
	return { X = p.X - w / 2, Y = p.Y - h / 2, W = w, H = h }
end

-- Vrai si la place (avec sa marge) est entièrement libre dans la grille
local function isFree(g: Grid, p: Placement, gap: number): boolean
	local rect = placementRect(p)
	local i0 = math.floor((rect.X - gap) / CELL)
	local j0 = math.floor((rect.Y - gap) / CELL)
	local i1 = math.ceil((rect.X + rect.W + gap) / CELL)
	local j1 = math.ceil((rect.Y + rect.H + gap) / CELL)
	if i0 < 0 or j0 < 0 or i1 > g.Cols or j1 > g.Rows then
		return false
	end
	return takenCount(g, i0, j0, i1 - i0, j1 - j0) == 0
end

-- Meilleure place pour un objet entre les échelles minScale et maxScale :
-- pour chaque case libre (coin haut-gauche), plus grande échelle qui tient
-- (recherche dichotomique), puis score = distance au point préféré - bonus
-- de taille.
local function search(g: Grid, item: Item, canvas: Vector2, minScale: number, maxScale: number): Placement?
	local gap = item.Gap or 6
	local scales = {}
	for _, s in ipairs(SCALES) do
		if s <= maxScale + 1e-6 and s >= minScale - 1e-6 then
			table.insert(scales, s)
		end
	end
	if #scales == 0 then
		return nil
	end
	local shapes = { { item.W, item.H, 0 } }
	for index, extra in ipairs(item.Shapes or {}) do
		table.insert(shapes, { extra.X, extra.Y, index })
	end
	local anchorX, anchorY = item.Anchor.X * canvas.X, item.Anchor.Y * canvas.Y
	local diagonal = math.max(1, canvas.Magnitude)
	local cols, rows, occ = g.Cols, g.Rows, g.Occ

	local best: Placement? = nil
	local bestScore = math.huge
	for _, shape in ipairs(shapes) do
		local w, h = shape[1], shape[2]
		-- Taille en cases pour chaque échelle (la place est centrée dans les cases)
		local cellsW, cellsH = {}, {}
		for index, s in ipairs(scales) do
			cellsW[index] = math.ceil((w * s + gap * 2) / CELL)
			cellsH[index] = math.ceil((h * s + gap * 2) / CELL)
		end
		local smallW, smallH = cellsW[#scales], cellsH[#scales]
		for j = 0, rows - smallH do
			local base = j * cols
			for i = 0, cols - smallW do
				if occ[base + i + 1] == 0 and takenCount(g, i, j, smallW, smallH) == 0 then
					-- Plus grande échelle qui tient ici (les échelles vont en décroissant)
					local lo, hi = 1, #scales -- hi tient toujours
					while lo < hi do
						local mid = (lo + hi) // 2
						local cw, ch = cellsW[mid], cellsH[mid]
						if i + cw <= cols and j + ch <= rows and takenCount(g, i, j, cw, ch) == 0 then
							hi = mid
						else
							lo = mid + 1
						end
					end
					local s = scales[hi]
					local centreX = i * CELL + cellsW[hi] * CELL / 2
					local centreY = j * CELL + cellsH[hi] * CELL / 2
					local dx, dy = centreX - anchorX, centreY - anchorY
					local score = math.sqrt(dx * dx + dy * dy) / diagonal - s * SCALE_WEIGHT
					if score < bestScore then
						bestScore = score
						best = { X = centreX, Y = centreY, Scale = s, Shape = shape[3], W = w, H = h }
					end
				end
			end
		end
	end
	return best
end

----------------------------------------------------------------------
-- Planification
----------------------------------------------------------------------

local function signatureOf(placements: { Placement | false }): string
	local parts = {}
	for _, p in ipairs(placements) do
		if p then
			table.insert(parts, string.format("%d,%d,%.2f,%d", math.floor(p.X + 0.5), math.floor(p.Y + 0.5), p.Scale, p.Shape))
		else
			table.insert(parts, "-")
		end
	end
	return table.concat(parts, ";")
end

local function sortedRequests(): { Request }
	local list = {}
	for _, request in pairs(requests) do
		table.insert(list, request)
	end
	table.sort(list, function(a, b)
		if a.Priority ~= b.Priority then
			return a.Priority < b.Priority
		end
		return a.Id < b.Id
	end)
	return list
end

local function sameShapeAs(old: Placement, item: Item): boolean
	if old.W == item.W and old.H == item.H then
		return true
	end
	for _, extra in ipairs(item.Shapes or {}) do
		if old.W == extra.X and old.H == extra.Y then
			return true
		end
	end
	return false
end

local function plan()
	local canvas = Zones.GetCanvas()
	local blocked = blockedRects(canvas)
	local marked = markedRects()
	-- Grille des OBJETS : tout ce qui cache le fond + bande des accessoires
	local objects = newGrid(canvas)
	markEdges(objects, canvas)
	for _, rect in ipairs(blocked) do
		mark(objects, rect, 2)
	end
	for _, rect in ipairs(gearBand(canvas)) do
		mark(objects, rect, 0)
	end
	for _, rect in ipairs(marked) do
		mark(objects, rect, 2)
	end
	buildSat(objects)

	local order = sortedRequests()
	local results: { [Request]: { Placement | false } } = {}
	-- 2 tours : le 1er objet de chaque stimulus, puis les objets en plus
	local queue: { { Request: Request, Index: number } } = {}
	for _, request in ipairs(order) do
		results[request] = {}
		if request.Items[1] then
			table.insert(queue, { Request = request, Index = 1 })
		end
	end
	for _, request in ipairs(order) do
		for index = 2, #request.Items do
			table.insert(queue, { Request = request, Index = index })
		end
	end
	local function commit(request: Request, index: number, chosen: Placement, gap: number)
		mark(objects, placementRect(chosen), gap)
		buildSat(objects)
		results[request][index] = chosen
	end
	local missing: { { Request: Request, Index: number } } = {}
	for _, entry in ipairs(queue) do
		local request, index = entry.Request, entry.Index
		local item = request.Items[index]
		local gap = item.Gap or 6
		local chosen: Placement? = search(objects, item, canvas, item.MinScale or 0.5, item.MaxScale or 1)
		-- Stabilité : garder l'ancienne place si elle est encore libre
		local previous = request.Previous[index]
		if previous then
			local old = previous :: Placement
			local fresh = chosen
			if not old.Folded and sameShapeAs(old, item) and isFree(objects, old, gap) and (fresh == nil or fresh.Scale < old.Scale + MOVE_GAIN) then
				chosen = old
			end
		end
		if chosen then
			commit(request, index, chosen, gap)
		else
			table.insert(missing, entry)
		end
	end
	-- Dernier recours : replié en tout petit plutôt que disparaître
	for _, entry in ipairs(missing) do
		local request, index = entry.Request, entry.Index
		local item = request.Items[index]
		local gap = math.min(item.Gap or 6, 3)
		local folded = search(objects, item, canvas, FOLD_SCALE, item.MinScale or 0.5)
		if folded then
			folded.Folded = true
			commit(request, index, folded, gap)
		else
			results[request][index] = false
		end
	end

	-- Grille "visible" (ambiance) : sans la bande des accessoires
	local view = newGrid(canvas)
	markEdges(view, canvas)
	for _, rect in ipairs(blocked) do
		mark(view, rect, 2)
	end
	for _, rect in ipairs(marked) do
		mark(view, rect, 2)
	end
	for _, request in ipairs(order) do
		for _, p in pairs(results[request]) do
			if p then
				mark(view, placementRect(p), 2)
			end
		end
	end
	viewGrid = view

	-- Rappels (hors de la boucle de calcul)
	for _, request in ipairs(order) do
		if requests[request.Id] == request then
			local placements = results[request]
			for index = 1, #request.Items do
				if placements[index] == nil then
					placements[index] = false
				end
			end
			request.Previous = placements
			local signature = signatureOf(placements)
			if signature ~= request.Signature then
				request.Signature = signature
				local ok, err = pcall(request.OnPlace, placements)
				if not ok then
					warn("[Cosmos.Zones] Erreur dans le placement de " .. request.Id .. " : " .. tostring(err))
				end
			end
		end
	end
	Zones.Changed:Fire()
end

-- Demande une replanification (regroupée, jamais pendant une image de rendu)
function Zones.Schedule()
	if planning then
		planAgain = true
		return
	end
	if planPending then
		return
	end
	planPending = true
	task.delay(REPLAN_DELAY, function()
		planPending = false
		planning = true
		local ok, err = pcall(plan)
		planning = false
		if not ok then
			warn("[Cosmos.Zones] Erreur de planification : " .. tostring(err))
		end
		if planAgain then
			planAgain = false
			Zones.Schedule()
		end
	end)
end

-- Vérification lente : un objet d'un autre stimulus s'est-il posé sur un des nôtres ?
local function overlaps(a: Rect, b: Rect): boolean
	return a.X < b.X + b.W and b.X < a.X + a.W and a.Y < b.Y + b.H and b.Y < a.Y + a.H
end

local function check()
	local others = markedRects()
	if #others == 0 then
		return
	end
	for _, request in pairs(requests) do
		for _, p in ipairs(request.Previous) do
			if p then
				local mine = placementRect(p)
				for _, rect in ipairs(others) do
					if overlaps(mine, rect) then
						Zones.Schedule()
						return
					end
				end
			end
		end
	end
end

local function startChecks()
	if checking then
		return
	end
	checking = true
	task.spawn(function()
		while next(requests) ~= nil do
			task.wait(CHECK_INTERVAL)
			local ok, err = pcall(check)
			if not ok then
				warn("[Cosmos.Zones] Erreur de vérification : " .. tostring(err))
				break
			end
		end
		checking = false
	end)
end

local function bind()
	if bound then
		return
	end
	bound = true
	local function changed()
		Zones.Schedule()
	end
	Interface.ScaleChanged:Connect(changed)
	Interface.DeviceChanged:Connect(changed)
	Slots.Changed:Connect(changed)
	local layer = Interface.Layers and Interface.Layers.Slots
	if layer then
		layer.ChildAdded:Connect(changed)
		layer.ChildRemoved:Connect(changed)
	end
end

----------------------------------------------------------------------
-- Chemins (effets d'ambiance) : quelle courbe se voit le mieux ?
----------------------------------------------------------------------

-- Point d'une courbe de Bézier cubique (4 points en fractions de la toile)
function Zones.Bezier(points: { Vector2 }, u: number): Vector2
	local a = 1 - u
	return points[1] * (a * a * a) + points[2] * (3 * a * a * u) + points[3] * (3 * a * u * u) + points[4] * (u * u * u)
end

-- Parmi plusieurs courbes (4 points de contrôle chacune, fractions de la
-- toile), celle dont la bande de largeur `width` passe le plus dans le fond
-- VISIBLE (ni carte, ni colonne, ni objet posé). À appeler après une
-- planification (Zones.Changed).
function Zones.PickPath(candidates: { { Vector2 } }, width: number): number
	local canvas = Zones.GetCanvas()
	local grid = viewGrid
	if grid.Cols == 0 or #grid.Occ == 0 then
		return 1
	end
	local bestIndex, bestScore = 1, -1
	for index, points in ipairs(candidates) do
		local free = 0
		local previous = Zones.Bezier(points, 0)
		for step = 1, 60 do
			local p = Zones.Bezier(points, step / 60)
			local d = p - previous
			previous = p
			local length = math.max(1e-6, d.Magnitude)
			local normal = Vector2.new(-d.Y / length, d.X / length)
			for _, lane in ipairs({ -0.35, 0, 0.35 }) do
				local x = p.X * canvas.X + normal.X * lane * width
				local y = p.Y * canvas.Y + normal.Y * lane * width
				local i, j = math.floor(x / CELL), math.floor(y / CELL)
				if i >= 0 and j >= 0 and i < grid.Cols and j < grid.Rows and grid.Occ[j * grid.Cols + i + 1] == 0 then
					free += 1
				end
			end
		end
		if free > bestScore then
			bestIndex, bestScore = index, free
		end
	end
	return bestIndex
end

----------------------------------------------------------------------
-- API
----------------------------------------------------------------------

-- Profondeur du stimulus (ZIndex de son conteneur dans le calque
-- Background) + découpe : rien ne déborde de la toile
function Zones.Attach(ctx)
	local container = ctx.Container
	if container then
		local depth = Zones.Depth[ctx.Feature]
		if depth then
			container.ZIndex = depth
		end
		container.ClipsDescendants = true
	end
	bind()
end

-- Demande (ou remplace) les places d'un stimulus. onPlace(placements) est
-- rappelé à chaque changement (placements[i] = Placement ou false).
function Zones.Request(id: string, items: { Item }, onPlace: (placements: { Placement | false }) -> ())
	bind()
	local previous = requests[id]
	requests[id] = {
		Id = id,
		Priority = Zones.Priority[id] or 50,
		Items = items,
		OnPlace = onPlace,
		Signature = nil,
		Previous = if previous then previous.Previous else {},
	}
	Zones.Schedule()
	startChecks()
end

function Zones.Release(id: string)
	if requests[id] then
		requests[id] = nil
		Zones.Schedule()
	end
end

-- Résumé des places actuelles (débogage) : "Id: x,y,échelle[,replié] ..."
function Zones.Describe(): string
	local parts = {}
	for _, request in ipairs(sortedRequests()) do
		local items = {}
		for _, p in ipairs(request.Previous) do
			if p then
				table.insert(items, string.format("%d,%d,x%.2f%s", math.floor(p.X), math.floor(p.Y), p.Scale, if p.Folded then ",replié" else ""))
			else
				table.insert(items, "-")
			end
		end
		table.insert(parts, request.Id .. "[" .. table.concat(items, " ") .. "]")
	end
	return table.concat(parts, " ")
end

return Zones
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="106">
          <Properties>
            <string name="Name">CursorTrail</string>
            <string name="Source"><![CDATA[--[[
	CursorTrail (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > CursorTrail

	Traînée magique : des étincelles arc-en-ciel suivent la souris (et le
	doigt sur mobile / tablette), tournoient, tombent un peu et s'éteignent.
	Chaque clic / toucher fait une petite gerbe d'étoiles.
	Purement visuel, non cliquable. 40 étincelles maximum, recyclées.
]]

local UserInputService = game:GetService("UserInputService")

local CursorTrail = {}
CursorTrail.Slot = "Overlay"

local MAX_SPARKLES = 40
local EMIT_SPACING = 14 -- distance (pixels "design") entre deux étincelles
local MAX_PER_FRAME = 3
local EMOJI_CHANCE = 0.18 -- parfois un ✨ / ⭐ au lieu d'un losange
local EMOJIS = { "✨", "⭐", "💫" }

function CursorTrail.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local container: Frame = ctx.Container
	local random = Random.new()

	local pool = {}
	local nextSlot = 1
	local hue = random:NextNumber()

	local pointer: Vector2? = nil -- dernière position connue (pixels écran réels)
	local lastEmit: Vector2? = nil
	local burstQueue = {} -- positions des clics à traiter

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	-- Crée toutes les étincelles une seule fois (recyclage circulaire)
	for i = 1, MAX_SPARKLES do
		local label = UIUtil.Create("TextLabel", {
			Name = "Sparkle",
			Size = UDim2.fromOffset(10, 10),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Font = Theme.Fonts.Body,
			Text = "",
			TextSize = 18,
			Active = false,
			Selectable = false,
			Visible = false,
			ZIndex = 60,
			Parent = container,
		})
		UIUtil.Corner(label, 3)
		local stroke = UIUtil.Stroke(label, Theme.Colors.Border, 1, 0.55)
		pool[i] = {
			Label = label,
			Stroke = stroke,
			Alive = false,
			Life = 0,
			MaxLife = 1,
			Pos = Vector2.zero,
			Vel = Vector2.zero,
			Size = 10,
			Spin = 0,
			Emoji = false,
		}
	end

	-- Émet une étincelle à `position` (pixels écran réels)
	local function emit(position: Vector2, velocity: Vector2, big: boolean?)
		local sparkle = pool[nextSlot]
		nextSlot = nextSlot % MAX_SPARKLES + 1

		hue = (hue + 0.035) % 1
		local color = Color3.fromHSV(hue, 0.8, 1)
		local isEmoji = random:NextNumber() < EMOJI_CHANCE
		local size = big and random:NextNumber(12, 18) or random:NextNumber(7, 13)

		sparkle.Alive = true
		sparkle.Emoji = isEmoji
		sparkle.Pos = position
		sparkle.Vel = velocity
		sparkle.Life = 0
		sparkle.MaxLife = random:NextNumber(0.45, 0.8)
		sparkle.Size = isEmoji and size * 1.8 or size
		sparkle.Spin = random:NextNumber(-360, 360)

		local label: TextLabel = sparkle.Label
		label.Rotation = 45
		if isEmoji then
			label.Text = EMOJIS[random:NextInteger(1, #EMOJIS)]
			label.TextSize = math.floor(sparkle.Size)
			label.TextTransparency = 0
			label.BackgroundTransparency = 1
			sparkle.Stroke.Enabled = false
		else
			label.Text = ""
			label.BackgroundColor3 = color
			label.BackgroundTransparency = 0
			sparkle.Stroke.Enabled = true
			sparkle.Stroke.Transparency = 0.55
		end
		label.Visible = true
	end

	-- Position du pointeur (même repère que AbsolutePosition)
	ctx.Connect(UserInputService.InputChanged, function(input: InputObject)
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseMovement or kind == Enum.UserInputType.Touch then
			pointer = Vector2.new(input.Position.X, input.Position.Y)
		end
	end)
	ctx.Connect(UserInputService.InputBegan, function(input: InputObject)
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch then
			local position = Vector2.new(input.Position.X, input.Position.Y)
			if kind == Enum.UserInputType.Touch then
				-- Nouveau doigt : pas de trait depuis l'ancienne position
				pointer = position
				lastEmit = position
			end
			if #burstQueue < 4 then
				table.insert(burstQueue, position)
			end
		end
	end)
	ctx.Connect(UserInputService.InputEnded, function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.Touch then
			pointer = nil
			lastEmit = nil
		end
	end)

	ctx.OnRender(function(dt: number)
		dt = math.min(dt, 0.1)
		local origin = container.AbsolutePosition
		local area = container.AbsoluteSize
		if area.X < 1 or area.Y < 1 then
			return
		end
		-- Pixels réels par pixel "design" (échelle de l'interface)
		local k = area.Y / 720
		local effects = effectsOn()

		-- Traînée : étincelles espacées le long du déplacement
		local current = pointer
		if current then
			if not lastEmit then
				lastEmit = current
			else
				local from = lastEmit :: Vector2
				local delta = current - from
				local distance = delta.Magnitude
				local spacing = EMIT_SPACING * k * (effects and 1 or 2.5)
				if distance >= spacing then
					local steps = math.min(MAX_PER_FRAME, math.floor(distance / spacing))
					for i = 1, steps do
						local point = from + delta * (i / steps)
						local drift = Vector2.new(random:NextNumber(-30, 30), random:NextNumber(-40, 10)) * k
						emit(point, drift - delta.Unit * 25 * k)
					end
					lastEmit = current
				end
			end
		end

		-- Gerbes de clic
		if #burstQueue > 0 then
			for _, position in ipairs(burstQueue) do
				local count = effects and 8 or 3
				local offset = random:NextNumber(0, math.pi * 2)
				for i = 1, count do
					local angle = offset + (i / count) * math.pi * 2
					local speed = random:NextNumber(110, 170) * k
					emit(position, Vector2.new(math.cos(angle), math.sin(angle)) * speed, true)
				end
			end
			table.clear(burstQueue)
		end

		-- Animation des étincelles vivantes
		local gravity = 160 * k
		for _, sparkle in ipairs(pool) do
			if sparkle.Alive then
				sparkle.Life += dt
				local ratio = sparkle.Life / sparkle.MaxLife
				local label: TextLabel = sparkle.Label
				if ratio >= 1 then
					sparkle.Alive = false
					label.Visible = false
				else
					sparkle.Vel = sparkle.Vel * (1 - math.min(1, 2.5 * dt)) + Vector2.new(0, gravity * dt)
					sparkle.Pos += sparkle.Vel * dt
					local relative = (sparkle.Pos - origin) / area
					label.Position = UDim2.fromScale(relative.X, relative.Y)
					label.Rotation += sparkle.Spin * dt
					-- Grossit vite puis rétrécit en s'éteignant
					local grow = ratio < 0.15 and (ratio / 0.15) or (1 - (ratio - 0.15) / 0.85)
					local size = math.max(1, sparkle.Size * (0.3 + 0.7 * grow))
					if sparkle.Emoji then
						label.TextSize = math.floor(size)
						label.Size = UDim2.fromOffset(size, size)
						label.TextTransparency = ratio * ratio
					else
						label.Size = UDim2.fromOffset(size, size)
						label.BackgroundTransparency = ratio * ratio
						sparkle.Stroke.Transparency = 0.55 + 0.45 * ratio
					end
				end
			end
		end
	end)
end

function CursorTrail.Stop(_ctx)
	-- Les étincelles sont dans ctx.Container (détruit par le StimulusManager)
end

return CursorTrail
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="107">
          <Properties>
            <string name="Name">DVD</string>
            <string name="Source"><![CDATA[--[[
	DVD (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > DVD

	Les logos qui rebondissent partout sur l'écran, façon vieil écran de
	veille de lecteur DVD (5 logos au maximum : un par niveau). v9 : le logo
	est dessiné en Frames, net à toutes les tailles :
	  - "DVD" en gras italique, couleur du logo, avec un léger vernis, un
	    fin contour sombre (lisible sur n'importe quel fond) et une ombre
	    décalée qui lui donne du relief ;
	  - dessous, le disque aplati : une VRAIE ellipse (8 pilules inscrites
	    dans l'ellipse, calculées), reflet blanc, reflet holographique qui
	    glisse, et "VIDEO" en creux ;
	  - un halo doux (3 couches) de la couleur du logo, qui s'illumine à
	    chaque rebond, et une traînée discrète (3 silhouettes du logo placées
	    un peu plus tôt sur la même trajectoire).
	Comportement :
	  - trajectoires données par le SERVEUR (ClientState.DVDSetup) et
	    calculées avec DVDMath depuis l'heure serveur : fluide et identique
	    quel que soit le nombre d'images par seconde ;
	  - à chaque rebond : nouvelle couleur, écrasement contre le mur, flash
	    du halo, éclaboussure de lumière au point de contact, "+X" flottant
	    (visuel : le serveur compte les rebonds) et son "Bounce" si
	    "DVDSound" est possédé ;
	  - coin touché : on prévient le serveur (DVDCorner), qui VÉRIFIE ; à
	    l'écran, grande fête : ondes de choc et gerbe de rayons depuis le
	    coin, tampon "COIN !!!" qui claque près du coin, logo qui tourne sur
	    lui-même en arc-en-ciel, étincelles, confettis, flash doré ;
	  - clic sur un logo : bonus (DVDClick), recharge commune à tous les
	    logos (ils pâlissent pendant la recharge et laissent passer les clics) ;
	  - envoie la taille réelle du logo au serveur (DVDResize).
	Performance : une seule boucle OnRender, aucune création d'instance par
	image (ondes, rayons, éclaboussures et tampon sont réutilisés).
]]

local DVD = {}
DVD.Slot = "Overlay"

local Locale = require(game:GetService("ReplicatedStorage").Shared.Locale)

local WORDMARK = "DVD" -- mot principal du logo
local MAX_LOGOS = 5
local RESIZE_INTERVAL = 0.6 -- temps minimum entre deux envois DVDResize
local MIN_SOUND_GAP = 0.07 -- évite la cacophonie avec plusieurs logos
local TRAIL_LAG = 0.05 -- retard (s) de chaque silhouette de la traînée
local TRAIL_ALPHA = { 0.8, 0.88, 0.94 } -- transparence des silhouettes
local GLOW_ALPHA = 0.9 -- transparence de chaque couche du halo
local GLOW_FLASH = 0.7 -- halo au moment d'un rebond
local RAINBOW_TIME = 2.6 -- durée de l'arc-en-ciel après un coin
local SPIN_TIME = 0.8 -- tour sur soi-même après un coin
local RING_COUNT = 3 -- ondes de choc réutilisées
local SPLASH_COUNT = 4 -- éclaboussures de lumière réutilisées
local SPLASH_TIME = 0.45
local BURST_TIME = 1.1 -- gerbe de rayons du coin
local STAMP_TIME = 1.9 -- tampon "COIN !!!"

local INK = Color3.fromRGB(16, 12, 30) -- lettres "VIDEO" (en creux)
local PALE = Color3.fromRGB(170, 168, 190) -- couleur "en recharge"
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local GOLD_TOP = Color3.fromRGB(255, 244, 170)
local GOLD_BOTTOM = Color3.fromRGB(255, 176, 40)

-- Police du mot "DVD" : gras italique
local WORD_FONT = Font.new("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.Heavy, Enum.FontStyle.Italic)
local VIDEO_FONT = Font.new("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.ExtraBold, Enum.FontStyle.Normal)

-- Petites phrases quand un logo frôle un coin sans le toucher
local NEAR_MISS = {
	en = { "almost... 😩", "one pixel off!", "noooo 😭", "so close...", "next time?", "argh!", "the corner dodged!" },
	fr = { "presque... 😩", "à un pixel !", "noooon 😭", "si près...", "la prochaine ?", "argh !", "le coin a esquivé !" },
}
local CORNER_TEXTS = {
	en = { "CORNER!!! 📀", "RIGHT IN THE CORNER!!!", "PERFECT CORNER HIT!", "IT HIT THE CORNER!!!" },
	fr = { "COIN !!! 📀", "DANS LE COIN !!!", "PILE DANS LE COIN !", "IL A TOUCHÉ LE COIN !!!" },
}

-- Tire une phrase au hasard dans la liste de la langue du joueur
local function pickLine(variants, random: Random): string
	local list = Locale.Pick(variants)
	return list[random:NextInteger(1, #list)]
end

-- Reflet "holographique" de l'anneau du disque
local HOLO = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 120, 200)),
	ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 240, 150)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(130, 255, 220)),
	ColorSequenceKeypoint.new(0.75, Color3.fromRGB(140, 170, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 120, 200)),
})

-- Vernis vertical "multiplié" sur la couleur (clair en haut, plus sombre en bas)
local GLOSS = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
	ColorSequenceKeypoint.new(0.5, Color3.new(0.95, 0.95, 0.95)),
	ColorSequenceKeypoint.new(1, Color3.new(0.72, 0.72, 0.72)),
})

-- Le disque aplati est une ellipse (demi-axes a, b). UICorner ne sait faire
-- que des pilules : on superpose des pilules OPAQUES dont les coins touchent
-- l'ellipse (de la plus fine et large à la plus haute et étroite). Renvoie
-- { { largeur, hauteur }, ... } en pixels "design".
local function ellipseLayers(a: number, b: number): { { number } }
	local layers = {}
	for _, f in ipairs({ 0.3, 0.43, 0.56, 0.68, 0.79, 0.88, 0.95, 1 }) do
		local halfH = b * f
		local halfW = math.min(a, halfH + a * math.sqrt(math.max(0, 1 - f * f)))
		table.insert(layers, { halfW * 2, halfH * 2 })
	end
	return layers
end

function DVD.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local Config = ctx.Config
	local DVDMath = ctx.DVDMath
	local Effects = ctx.Effects
	local settings = Config.DVD
	local colors = settings.Colors
	local container: Frame = ctx.Container
	local random = Random.new()

	local logoSize: Vector2 = settings.LogoSize
	local useImage = settings.LogoImage ~= nil and settings.LogoImage ~= ""
	local W, H = logoSize.X, logoSize.Y

	local logos = {} -- [index] = objet logo (voir createLogo)
	local cooldownUntil = 0
	local cooling = false
	local lastSoundTime = 0

	local function getData()
		return ctx.State.Data
	end

	local function effectsOn(): boolean
		local data = getData()
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	-- Élément centré sur (cx, cy) en pixels du logo, mais exprimé en
	-- proportions : l'écrasement (taille du corps) déforme tout le dessin
	local function place(props: { [string]: any }, cx: number, cy: number, w: number, h: number): { [string]: any }
		props.AnchorPoint = Vector2.new(0.5, 0.5)
		props.Position = UDim2.fromScale(cx / W, cy / H)
		props.Size = UDim2.fromScale(w / W, h / H)
		if props.BorderSizePixel == nil then
			props.BorderSizePixel = 0
		end
		return props
	end

	local function pill(props: { [string]: any }): Frame
		local f = UIUtil.Create("Frame", props)
		UIUtil.Corner(f, UDim.new(1, 0))
		return f
	end

	-- Sonde invisible de la taille d'un logo (sert à mesurer la taille réelle,
	-- sans être faussée par les animations d'écrasement)
	local probe = UIUtil.Create("Frame", {
		Name = "SizeProbe",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(W, H),
		Visible = false,
		Parent = container,
	})

	-- Taille du logo en fraction de l'écran
	local function measure(): (number?, number?)
		local parentSize = container.AbsoluteSize
		local size = probe.AbsoluteSize
		if parentSize.X < 1 or parentSize.Y < 1 or size.X < 1 or size.Y < 1 then
			return nil, nil
		end
		return size.X / parentSize.X, size.Y / parentSize.Y
	end

	------------------------------------------------------------------
	-- Effets réutilisés : ondes de choc, rayons, éclaboussures, tampon
	------------------------------------------------------------------
	local rings = {}
	for i = 1, RING_COUNT do
		local ring = pill({
			Name = "CornerRing" .. i,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(10, 10),
			BackgroundTransparency = 1,
			Visible = false,
			ZIndex = 8,
			Parent = container,
		})
		local stroke = UIUtil.Stroke(ring, Theme.Colors.Gold, 6, 0)
		table.insert(rings, { Frame = ring, Stroke = stroke, Age = -2, Delay = (i - 1) * 0.13 })
	end

	-- Gerbe de rayons (16 rayons) qui s'ouvre et tourne depuis le coin
	local burst = UIUtil.Rays(container, GOLD_TOP, 8, 60, UDim2.fromScale(0, 0), 7)
	burst.Name = "CornerBurst"
	burst.Visible = false
	local burstBars = {}
	for _, bar in ipairs(burst:GetChildren()) do
		if bar:IsA("Frame") then
			-- largeur proportionnelle : les rayons s'élargissent avec la gerbe
			bar.Size = UDim2.fromScale(0.06, 1)
			table.insert(burstBars, bar)
		end
	end
	local burstAge = -1

	-- Éclaboussures de lumière au point de contact d'un rebond
	local splashes = {}
	for i = 1, SPLASH_COUNT do
		local splash = pill({
			Name = "Splash" .. i,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(10, 10),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 1,
			Visible = false,
			ZIndex = 3,
			Parent = container,
		})
		local core = pill({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.45, 0.45), BackgroundColor3 = WHITE, BackgroundTransparency = 0.2, ZIndex = 3, Parent = splash })
		table.insert(splashes, { Frame = splash, Core = core, Age = -1 })
	end
	local nextSplash = 1

	-- Tampon "COIN !!!" (badge doré qui claque près du coin)
	local stamp = pill({
		Name = "CornerStamp",
		Size = UDim2.fromOffset(250, 58),
		BackgroundColor3 = WHITE,
		Visible = false,
		ZIndex = 9,
		Parent = container,
	})
	UIUtil.Gradient(stamp, ColorSequence.new(GOLD_TOP, GOLD_BOTTOM), 90)
	local stampStroke = UIUtil.Stroke(stamp, Color3.fromRGB(120, 60, 0), 3, 0)
	local stampShine = pill({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 5), Size = UDim2.new(1, -30, 0, 8), BackgroundColor3 = WHITE, BackgroundTransparency = 0.45, ZIndex = 9, Parent = stamp })
	local stampLabel = UIUtil.Label({
		Name = "Text",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.new(1, -24, 1, -12),
		Font = Theme.Fonts.Title,
		TextColor3 = Color3.fromRGB(110, 40, 0),
		MaxTextSize = 34,
		ZIndex = 10,
		Parent = stamp,
	})
	local stampScale = UIUtil.Create("UIScale", { Scale = 0, Parent = stamp })
	local stampAge = -1

	------------------------------------------------------------------
	-- Construction d'un logo
	------------------------------------------------------------------
	local DISC_Y = 62
	local DISC_LAYERS = ellipseLayers(W / 2 - 9, 13)
	local GHOST_LAYER = 4 -- la traînée n'utilise qu'une pilule (moyenne)

	-- Dessine le mot + le disque (logo complet, ou silhouette de traînée) ;
	-- renvoie les pièces à colorer
	local function drawMark(parent: Instance, z: number, full: boolean)
		local parts = { Disc = {} :: { Frame } }
		if full then
			-- Ombre décalée (relief) sous le mot
			parts.Shadow = UIUtil.Label(place({ Name = "WordShadow", Text = WORDMARK, MaxTextSize = 60, TextTransparency = 0.15, ZIndex = z + 1, Parent = parent }, W / 2 + 4.5, 26.5, W - 10, 46))
			parts.Shadow.FontFace = WORD_FONT
		end
		-- Mot "DVD"
		parts.Word = UIUtil.Label(place({ Name = "Word", Text = WORDMARK, MaxTextSize = 60, ZIndex = z + 2, Parent = parent }, W / 2 + 2, 24, W - 10, 46))
		parts.Word.FontFace = WORD_FONT
		-- Disque aplati (silhouette : une seule pilule, sinon les recouvrements
		-- transparents se verraient)
		for i = (full and 1 or GHOST_LAYER), (full and #DISC_LAYERS or GHOST_LAYER) do
			local layer = DISC_LAYERS[i]
			table.insert(parts.Disc, pill(place({ Name = "Disc" .. i, ZIndex = z + 1, Parent = parent }, W / 2, DISC_Y, layer[1], layer[2])))
		end
		if not full then
			return parts
		end
		UIUtil.Gradient(parts.Word, GLOSS, 90)
		parts.WordStroke = UIUtil.Stroke(parts.Word, BLACK, 1.4, 0.25)
		parts.WordStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		-- Reflet brillant en haut du disque
		parts.Gloss = pill(place({ Name = "Gloss", BackgroundColor3 = WHITE, BackgroundTransparency = 0.45, ZIndex = z + 3, Parent = parent }, W / 2 - 12, DISC_Y - 7.5, W - 80, 3.5))
		-- Reflet irisé en bas du disque (dégradé holographique qui glisse)
		local sheen = pill(place({ Name = "Sheen", BackgroundColor3 = WHITE, BackgroundTransparency = 0.3, ZIndex = z + 3, Parent = parent }, W / 2 + 8, DISC_Y + 8, W - 72, 3))
		parts.Holo = UIUtil.Gradient(sheen, HOLO, 0)
		-- "VIDEO" en creux
		parts.Video = UIUtil.Label(place({
			Name = "Video",
			Text = Locale.T("VIDEO"),
			TextColor3 = INK,
			MaxTextSize = 17,
			ZIndex = z + 4,
			Parent = parent,
		}, W / 2, DISC_Y + 0.5, W - 60, 16))
		parts.Video.FontFace = VIDEO_FONT
		return parts
	end

	-- Couleur du logo (dérivées : ombre, contour, halo, traînée). En recharge
	-- le logo pâlit (couleur mêlée de gris) sans devenir transparent : les
	-- pièces du disque se recouvrent et ne doivent pas se voir.
	local function paint(logo, color: Color3)
		local main = (cooling and not logo.Rainbow) and color:Lerp(PALE, 0.72) or color
		if logo.Image then
			logo.Image.ImageColor3 = main
		else
			logo.Word.TextColor3 = main
			logo.Shadow.TextColor3 = main:Lerp(BLACK, 0.62)
			logo.WordStroke.Color = main:Lerp(BLACK, 0.72)
			for _, piece in ipairs(logo.Disc) do
				piece.BackgroundColor3 = main
			end
		end
		for _, glow in ipairs(logo.Glow) do
			glow.BackgroundColor3 = color
		end
		for _, part in ipairs(logo.GhostParts) do
			(part[1] :: any)[part[2]] = color
		end
	end

	local function createLogo(index: number)
		local logo = {
			Index = index,
			Params = nil :: any,
			LastX = nil :: number?,
			LastY = nil :: number?,
			ColorIndex = ((index - 1) % #colors) + 1,
			Ghosts = {} :: { Frame },
			GhostParts = {} :: { { any } }, -- { instance, propriété } recolorés à chaque rebond
			Glow = {} :: { Frame },
			Disc = {} :: { Frame },
			RainbowUntil = 0,
			SpinUntil = 0,
			Rainbow = false,
			Button = nil :: any,
			Hit = nil :: any,
			Body = nil :: any,
			Scale = nil :: any,
			Holo = nil :: any,
			Word = nil :: any,
			Shadow = nil :: any,
			WordStroke = nil :: any,
			Image = nil :: any,
		}

		-- Traînée : silhouettes du logo derrière tous les logos (ZIndex plus bas)
		for k = 1, #TRAIL_ALPHA do
			local ghost = UIUtil.Create("Frame", {
				Name = "DVDTrail" .. index .. "_" .. k,
				Size = UDim2.fromOffset(W, H),
				BackgroundTransparency = 1,
				Visible = false,
				ZIndex = 2,
				Parent = container,
			})
			local marks = drawMark(ghost, 1, false)
			marks.Word.TextTransparency = TRAIL_ALPHA[k]
			logo.Ghosts[k] = ghost
			table.insert(logo.GhostParts, { marks.Word, "TextColor3" })
			for _, piece in ipairs(marks.Disc) do
				piece.BackgroundTransparency = TRAIL_ALPHA[k]
				table.insert(logo.GhostParts, { piece, "BackgroundColor3" })
			end
		end

		-- Racine = simple Frame (ne capte pas les clics) ; la zone cliquable
		-- est un bouton enfant "Hit", masqué pendant la recharge pour que les
		-- clics passent au bouton principal / aux cartes en dessous.
		local button = UIUtil.Create("Frame", {
			Name = "DVDLogo" .. index,
			Size = UDim2.fromOffset(W, H),
			BackgroundTransparency = 1,
			Active = false,
			Visible = false,
			ZIndex = 5,
			Parent = container,
		})
		local hit = UIUtil.Create("TextButton", {
			Name = "Hit",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			Visible = not cooling,
			ZIndex = 12,
			Parent = button,
		})

		-- Corps visuel (le bouton garde sa taille, seul le corps s'écrase)
		local body = UIUtil.Create("Frame", {
			Name = "Body",
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			ZIndex = 5,
			Parent = button,
		})
		local bodyScale = UIUtil.Create("UIScale", { Scale = 0, Parent = body })
		logo.Button = button
		logo.Hit = hit
		logo.Body = body
		logo.Scale = bodyScale

		-- Halo doux (3 ellipses superposées : plus lumineux au centre)
		for i, size in ipairs({ { 1.16, 1.02 }, { 0.96, 0.8 }, { 0.74, 0.58 } }) do
			local glow = pill({
				Name = "Glow" .. i,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.52),
				Size = UDim2.fromScale(size[1], size[2]),
				BackgroundTransparency = GLOW_ALPHA,
				BorderSizePixel = 0,
				ZIndex = 5,
				Parent = body,
			})
			table.insert(logo.Glow, glow)
		end

		if useImage then
			-- Image personnalisée (blanche, recolorée)
			logo.Image = UIUtil.Create("ImageLabel", {
				BackgroundTransparency = 1,
				Size = UDim2.fromScale(1, 1),
				Image = settings.LogoImage,
				ScaleType = Enum.ScaleType.Fit,
				ZIndex = 7,
				Parent = body,
			})
		else
			local parts = drawMark(body, 5, true)
			logo.Holo = parts.Holo
			logo.Word = parts.Word
			logo.Shadow = parts.Shadow
			logo.WordStroke = parts.WordStroke
			logo.Disc = parts.Disc
		end
		paint(logo, colors[logo.ColorIndex])

		-- Survol : le logo gonfle un peu (PC)
		ctx.Connect(hit.MouseEnter, function()
			if not cooling then
				UIUtil.Tween(bodyScale, 0.15, { Scale = 1.08 }, Enum.EasingStyle.Back)
			end
		end)
		ctx.Connect(hit.MouseLeave, function()
			UIUtil.Tween(bodyScale, 0.15, { Scale = 1 })
		end)

		-- Clic : bonus avec temps de recharge commun
		ctx.Connect(hit.Activated, function()
			if not ctx.IsAlive() then
				return
			end
			local center = UDim2.new(button.Position.X.Scale, W / 2, button.Position.Y.Scale, H / 2)
			if os.clock() < cooldownUntil then
				-- Encore en recharge : petit "non" et le temps restant
				UIUtil.Shake(body)
				ctx.FloatText(container, center, Locale.T("⏳ %ds", math.ceil(cooldownUntil - os.clock())), Theme.Colors.TextDim, 20)
				return
			end
			cooldownUntil = os.clock() + settings.ClickCooldown
			ctx.Net.Event("DVDClick"):FireServer(logo.Index)
			ctx.Sound.Play("Click", 1.3)
			bodyScale.Scale = 0.8
			UIUtil.Tween(bodyScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
			if effectsOn() then
				ctx.Effects.Burst(container, center, colors[logo.ColorIndex], 14)
			end
		end)

		return logo
	end

	local function nextColor(logo)
		-- Jamais deux fois la même couleur de suite
		local newIndex = random:NextInteger(1, #colors)
		if newIndex == logo.ColorIndex then
			newIndex = newIndex % #colors + 1
		end
		logo.ColorIndex = newIndex
		if os.clock() >= logo.RainbowUntil then
			paint(logo, colors[newIndex])
		end
	end

	-- Recharge : les logos pâlissent, le halo s'éteint, les clics passent
	local function setFaded(faded: boolean)
		for _, logo in ipairs(logos) do
			logo.Hit.Visible = not faded
			paint(logo, colors[logo.ColorIndex])
			for _, glow in ipairs(logo.Glow) do
				UIUtil.Tween(glow, 0.25, { BackgroundTransparency = faded and 1 or GLOW_ALPHA })
			end
			if logo.Word then
				UIUtil.Tween(logo.Word, 0.25, { TextTransparency = faded and 0.3 or 0 })
				UIUtil.Tween(logo.Shadow, 0.25, { TextTransparency = faded and 0.6 or 0.15 })
			end
		end
	end

	------------------------------------------------------------------
	-- Envoi de la taille au serveur (limité à 1 envoi / 0,6 s)
	------------------------------------------------------------------
	local lastSentW, lastSentH = 0, 0
	local lastSendTime = -math.huge
	local pendingSend = false
	local pendingForce = false

	local function sendSize(force: boolean)
		if not ctx.IsAlive() or #logos == 0 then
			return
		end
		local w, h = measure()
		if not w or not h then
			return
		end
		if not force and math.abs(w - lastSentW) < 0.002 and math.abs(h - lastSentH) < 0.002 then
			return
		end
		lastSentW, lastSentH = w, h
		lastSendTime = os.clock()
		ctx.Net.Event("DVDResize"):FireServer(w, h)
	end

	local function requestSend(force: boolean)
		pendingForce = pendingForce or force
		if pendingSend then
			return
		end
		local wait = RESIZE_INTERVAL - (os.clock() - lastSendTime)
		pendingSend = true
		-- Toujours un petit délai : laisse le temps aux tailles de se stabiliser
		task.delay(math.max(0.1, wait), function()
			pendingSend = false
			local f = pendingForce
			pendingForce = false
			sendSize(f)
		end)
	end

	------------------------------------------------------------------
	-- Synchronisation avec DVDSetup
	------------------------------------------------------------------
	local function applySetup(setup)
		if not ctx.IsAlive() then
			return
		end
		local list = (setup and setup.Logos) or {}
		local count = math.min(#list, MAX_LOGOS)
		local previousCount = #logos

		-- Crée les logos manquants
		for index = #logos + 1, count do
			local logo = createLogo(index)
			logos[index] = logo
			UIUtil.Tween(logo.Scale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
			if cooling then
				for _, glow in ipairs(logo.Glow) do
					glow.BackgroundTransparency = 1
				end
			end
		end
		-- Retire les logos en trop
		for index = #logos, count + 1, -1 do
			local logo = logos[index]
			logos[index] = nil
			local button = logo.Button
			local ghosts = logo.Ghosts
			UIUtil.Tween(logo.Scale, 0.25, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			for _, ghost in ipairs(ghosts) do
				ghost.Visible = false
			end
			task.delay(0.3, function()
				button:Destroy()
				for _, ghost in ipairs(ghosts) do
					ghost:Destroy()
				end
			end)
		end
		-- Nouveaux paramètres de trajectoire
		for index = 1, count do
			local logo = logos[index]
			logo.Params = list[index]
			logo.LastX, logo.LastY = nil, nil
			logo.Button.Visible = true
		end

		if count > 0 then
			-- Premier logo (ou retour après la détox) : on envoie la vraie taille
			-- si le serveur utilise une taille différente
			local w, h = measure()
			local first = list[1]
			local mismatch = w ~= nil
				and h ~= nil
				and type(first.W) == "number"
				and type(first.H) == "number"
				and (math.abs(first.W - w) > 0.003 or math.abs(first.H - h) > 0.003)
			requestSend(previousCount == 0 and mismatch)
		end
	end

	ctx.Connect(ctx.State.DVDSetupChanged, applySetup)
	ctx.Connect(container:GetPropertyChangedSignal("AbsoluteSize"), function()
		requestSend(false)
	end)
	applySetup(ctx.State.DVDSetup)

	------------------------------------------------------------------
	-- Rebonds (visuels)
	------------------------------------------------------------------
	local function splashAt(position: UDim2, color: Color3)
		local splash = splashes[nextSplash]
		nextSplash = nextSplash % #splashes + 1
		splash.Frame.Position = position
		splash.Frame.BackgroundColor3 = color
		splash.Core.BackgroundColor3 = color:Lerp(WHITE, 0.6)
		splash.Age = 0
		splash.Frame.Visible = true
	end

	local function onBounce(logo, x: number, y: number, w: number, h: number, bouncedX: boolean, bouncedY: boolean, corner: boolean)
		nextColor(logo)
		local color = colors[logo.ColorIndex]

		-- Écrasement contre le mur (le corps s'aplatit puis reprend sa forme)
		local body = logo.Body
		if bouncedX and bouncedY then
			body.Size = UDim2.fromScale(0.86, 0.86)
		elseif bouncedX then
			body.Size = UDim2.fromScale(0.82, 1.1)
		else
			body.Size = UDim2.fromScale(1.1, 0.8)
		end
		UIUtil.Tween(body, 0.42, { Size = UDim2.fromScale(1, 1) }, Enum.EasingStyle.Back)

		-- Flash du halo (doux)
		if not cooling then
			for _, glow in ipairs(logo.Glow) do
				glow.BackgroundTransparency = GLOW_FLASH
				UIUtil.Tween(glow, 0.55, { BackgroundTransparency = GLOW_ALPHA })
			end
		end

		-- Point de contact (au milieu du bord touché)
		local contactX = x + w / 2
		local contactY = y + h / 2
		if bouncedX then
			contactX = (x < 0.5 - w / 2) and x or (x + w)
		end
		if bouncedY and not bouncedX then
			contactY = (y < 0.5 - h / 2) and y or (y + h)
		end

		local data = getData()
		local value = data and data.BounceValue or 0
		if value > 0 and not corner then
			ctx.FloatText(container, UDim2.fromScale(x + w / 2, y + h / 2), "+" .. ctx.Format.Format(value), color, 24)
		end
		if effectsOn() then
			splashAt(UDim2.fromScale(contactX, contactY), color)
			ctx.Effects.Burst(container, UDim2.fromScale(contactX, contactY), color, 5)
		end

		if ctx.HasFeature("DVDSound") then
			local now = os.clock()
			if now - lastSoundTime >= MIN_SOUND_GAP then
				lastSoundTime = now
				ctx.Sound.Play("Bounce", random:NextNumber(1.25, 1.75))
			end
		end
	end

	-- Fête du coin : ondes de choc + rayons depuis le coin, tampon "COIN !!!",
	-- arc-en-ciel, tour sur soi-même, étincelles, confettis
	local function onCorner(logo, x: number, y: number, w: number, h: number)
		local center = UDim2.fromScale(x + w / 2, y + h / 2)
		-- Coin exact touché (le plus proche du logo)
		local cornerX = (x + w / 2 < 0.5) and 0 or 1
		local cornerY = (y + h / 2 < 0.5) and 0 or 1
		local corner = UDim2.fromScale(cornerX, cornerY)
		for i, ring in ipairs(rings) do
			ring.Frame.Position = corner
			ring.Age = -ring.Delay
			ring.Stroke.Color = i == 2 and WHITE or Theme.Colors.Gold
		end
		-- Tampon près du coin, juste au-delà du logo (vers l'intérieur de l'écran)
		stampLabel.Text = pickLine(CORNER_TEXTS, random)
		stamp.AnchorPoint = Vector2.new(cornerX, cornerY)
		stamp.Position = UDim2.new(cornerX, cornerX == 0 and 30 or -30, cornerY, cornerY == 0 and H + 34 or -(H + 34))
		stamp.Rotation = (cornerX == cornerY) and -7 or 7
		stampAge = 0
		stamp.Visible = true
		stamp.BackgroundTransparency = 0
		stampLabel.TextTransparency = 0
		stampStroke.Transparency = 0
		stampShine.BackgroundTransparency = 0.45
		stampScale.Scale = 0
		if effectsOn() then
			burst.Position = corner
			burst.Size = UDim2.fromOffset(60, 60)
			burstAge = 0
			burst.Visible = true
			ctx.Effects.Burst(container, center, Theme.Colors.Gold, 26)
			ctx.Effects.Burst(container, corner, nil, 24)
			if type(Effects.Confetti) == "function" then
				pcall(Effects.Confetti, 45)
			end
			if type(Effects.Flash) == "function" then
				pcall(Effects.Flash, Theme.Colors.Gold, 0.3)
			end
		end
		logo.RainbowUntil = os.clock() + RAINBOW_TIME
		logo.SpinUntil = os.clock() + SPIN_TIME
		local scale = logo.Scale
		scale.Scale = 1.55
		UIUtil.Tween(scale, 0.8, { Scale = 1 }, Enum.EasingStyle.Elastic)
		for _, glow in ipairs(logo.Glow) do
			glow.BackgroundColor3 = Theme.Colors.Gold
			glow.BackgroundTransparency = 0.45
			UIUtil.Tween(glow, 1.6, { BackgroundTransparency = GLOW_ALPHA })
		end
	end

	-- Effets réutilisés : avancent à chaque image, se cachent une fois finis
	local function updateEffects(dt: number)
		for _, ring in ipairs(rings) do
			if ring.Age > -1 and ring.Age < 1 then
				ring.Age += dt / 0.9
				if ring.Age >= 1 then
					ring.Frame.Visible = false
				elseif ring.Age >= 0 then
					local k = 1 - (1 - ring.Age) ^ 3
					local size = 30 + k * 560
					ring.Frame.Size = UDim2.fromOffset(size, size)
					ring.Stroke.Transparency = ring.Age
					ring.Stroke.Thickness = 9 - ring.Age * 7
					ring.Frame.Visible = true
				end
			end
		end
		if burstAge >= 0 then
			burstAge += dt
			local p = burstAge / BURST_TIME
			if p >= 1 then
				burstAge = -1
				burst.Visible = false
			else
				local size = 60 + (1 - (1 - p) ^ 2) * 900
				burst.Size = UDim2.fromOffset(size, size)
				burst.Rotation = p * 40
				local alpha = 0.15 + p * 0.85
				for _, bar in ipairs(burstBars) do
					bar.BackgroundTransparency = alpha
				end
			end
		end
		for _, splash in ipairs(splashes) do
			if splash.Age >= 0 then
				splash.Age += dt
				local p = splash.Age / SPLASH_TIME
				if p >= 1 then
					splash.Age = -1
					splash.Frame.Visible = false
				else
					local size = 12 + (1 - (1 - p) ^ 2) * 70
					splash.Frame.Size = UDim2.fromOffset(size, size)
					splash.Frame.BackgroundTransparency = 0.55 + p * 0.45
					splash.Core.BackgroundTransparency = 0.2 + p * 0.8
				end
			end
		end
		if stampAge >= 0 then
			stampAge += dt
			local p = stampAge / STAMP_TIME
			if p >= 1 then
				stampAge = -1
				stamp.Visible = false
			else
				-- Claque (0 -> 1.25 -> 1), reste, puis s'efface en montant un peu
				local t = stampAge
				stampScale.Scale = t < 0.14 and (t / 0.14) * 1.25 or (t < 0.3 and 1.25 - (t - 0.14) / 0.16 * 0.25 or 1)
				local fade = math.clamp((p - 0.75) / 0.25, 0, 1)
				stamp.BackgroundTransparency = fade
				stampLabel.TextTransparency = fade
				stampStroke.Transparency = fade
				stampShine.BackgroundTransparency = 0.45 + fade * 0.55
			end
		end
	end

	------------------------------------------------------------------
	-- Boucle d'affichage
	------------------------------------------------------------------
	local tolerance = settings.CornerTolerance
	ctx.OnRender(function(dt: number)
		updateEffects(dt)

		if #logos == 0 then
			return
		end
		local t = workspace:GetServerTimeNow()
		local clock = os.clock()
		local w, h = measure()
		w = w or (W / 1280)
		h = h or (H / 720)

		-- Fin de la recharge : les logos reprennent leurs couleurs
		local isCooling = clock < cooldownUntil
		if isCooling ~= cooling then
			cooling = isCooling
			setFaded(isCooling)
			if not isCooling then
				for _, logo in ipairs(logos) do
					logo.Scale.Scale = 1.15
					UIUtil.Tween(logo.Scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
				end
			end
		end

		-- Traînée seulement si les effets sont activés (et pas en recharge)
		local wantTrail = effectsOn() and not cooling

		for index, logo in ipairs(logos) do
			local params = logo.Params
			if params then
				local x, y = DVDMath.Position(params, t)
				logo.Button.Position = UDim2.fromScale(x, y)

				-- Silhouettes : la même trajectoire, un peu plus tôt
				for k, ghost in ipairs(logo.Ghosts) do
					if wantTrail then
						local gx, gy = DVDMath.Position(params, t - k * TRAIL_LAG)
						ghost.Position = UDim2.fromScale(gx, gy)
					end
					if ghost.Visible ~= wantTrail then
						ghost.Visible = wantTrail
					end
				end

				-- Reflet holographique qui glisse
				if logo.Holo then
					logo.Holo.Offset = Vector2.new(math.sin(t * 1.3 + index) * 0.5, 0)
				end

				-- Après un coin : arc-en-ciel + tour sur soi-même
				if clock < logo.RainbowUntil then
					logo.Rainbow = true
					paint(logo, Color3.fromHSV((clock * 1.4 + index * 0.2) % 1, 0.75, 1))
					for _, glow in ipairs(logo.Glow) do
						glow.BackgroundColor3 = Theme.Colors.Gold
					end
				elseif logo.Rainbow then
					logo.Rainbow = false
					paint(logo, colors[logo.ColorIndex])
				end
				if clock < logo.SpinUntil then
					local k = 1 - (logo.SpinUntil - clock) / SPIN_TIME
					logo.Body.Rotation = 360 * (1 - (1 - k) ^ 3)
				elseif logo.Body.Rotation ~= 0 then
					logo.Body.Rotation = 0
				end

				local indexX, indexY = DVDMath.BounceIndex(params, t)
				local lastX, lastY = logo.LastX, logo.LastY
				local bouncedX = lastX ~= nil and indexX ~= lastX
				local bouncedY = lastY ~= nil and indexY ~= lastY
				-- Numéro du bord touché = le plus grand des deux segments
				local k = (bouncedX and lastX) and math.max(indexX, lastX) or nil
				local corner = k ~= nil and DVDMath.IsCornerAtBounceX(params, k, tolerance)

				if bouncedX or bouncedY then
					onBounce(logo, x, y, w, h, bouncedX, bouncedY, corner)
				end

				if corner and k then
					ctx.Net.Event("DVDCorner"):FireServer(index, k)
					onCorner(logo, x, y, w, h)
				elseif k then
					-- Frôlé ? (à moins de 3 % d'un coin)
					local _, rangeY = DVDMath.Ranges(params)
					if math.min(y, rangeY - y) < 0.03 then
						ctx.FloatText(
							container,
							UDim2.fromScale(x + w / 2, y + h / 2 + 0.06),
							pickLine(NEAR_MISS, random),
							Theme.Colors.TextDim,
							22
						)
					end
				end

				logo.LastX, logo.LastY = indexX, indexY
			end
		end
	end)

	------------------------------------------------------------------
	-- Bonus confirmé par le serveur : "+X" au niveau du logo cliqué
	------------------------------------------------------------------
	ctx.OnBonus("DVD", function(payload)
		if not ctx.IsAlive() then
			return
		end
		local logo = logos[tonumber(payload.Index) or 1] or logos[1]
		local position = UDim2.fromScale(0.5, 0.4)
		if logo then
			local button = logo.Button
			position = UDim2.new(button.Position.X.Scale, W / 2, button.Position.Y.Scale, 0)
		end
		-- (le son "Bonus" est déjà joué par StimulusManager)
		ctx.FloatText(container, position, "+" .. ctx.Format.Format(tonumber(payload.Amount) or 0), Theme.Colors.Gold, 40)
	end)
end

function DVD.Stop(_ctx)
	-- Tout est dans ctx.Container (détruit par le StimulusManager)
end

return DVD
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="108">
          <Properties>
            <string name="Name">DeepFocus</string>
            <string name="Source"><![CDATA[--[[
	DeepFocus (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > DeepFocus

	🧘 Concentration (+/s, 10 niveaux, après 1 visite à l'océan) : des anneaux
	zen concentriques, fins et calmes (menthe, turquoise, lavande), centrés
	sur le compteur de Dopamine, qui RESPIRENT lentement (inspire 4 s,
	expire 4 s) ; à chaque respiration, une onde douce part du centre.
	Chaque niveau ajoute un anneau (3 au niveau 1, 12 au niveau 10) et plus
	de lueur ; niveau 3+ : perles de concentration qui tournent sur les
	anneaux ; niveau 6+ : halo doux derrière le compteur ; niveau 10 :
	anneau extérieur doré.
	Effet d'ambiance (derrière la colonne centrale, très transparent : le
	compteur reste parfaitement lisible). Une seule propriété (UIScale)
	anime la respiration de tous les anneaux. ≤ 20 images/s.
]]

local Cosmos = script.Parent:WaitForChild("Cosmos")
local Kit = require(Cosmos:WaitForChild("Kit"))
local Zones = require(Cosmos:WaitForChild("Zones"))

local DeepFocus = {}
DeepFocus.Slot = "Background"

local ID = "DeepFocus"
local MAX_LEVEL = 10
local FIRST_RADIUS = 96
local RING_GAP = 21
local BREATH = 8 -- secondes par respiration complète
local CUT_BELOW = 22 -- les anneaux s'arrêtent 22 px sous le centre du compteur

local COLORS = {
	Color3.fromRGB(110, 220, 200),
	Color3.fromRGB(90, 190, 230),
	Color3.fromRGB(170, 150, 240),
}

local function ringCount(level: number): number
	return 2 + level
end

local function beadCount(level: number): number
	return if level >= 3 then math.min(5, math.floor((level - 1) / 2)) else 0
end

function DeepFocus.Start(ctx)
	Zones.Attach(ctx)
	local effects = Kit.Effects(ctx)
	local level = math.clamp(ctx.GetLevel(ID), 1, MAX_LEVEL)
	local dark = Kit.IsDark(ctx)
	local container: Frame = ctx.Container

	local root: Frame? = nil
	local breathScale: UIScale? = nil
	local pulse: Frame? = nil
	local pulseStroke: UIStroke? = nil
	local glow: Frame? = nil
	type Bead = { Frame: Frame, Radius: number, Speed: number, Angle: number }
	local beads: { Bead } = {}
	local maxRadius = FIRST_RADIUS

	local function build()
		if root then
			root:Destroy()
		end
		table.clear(beads)
		local focus = Zones.GetFocus()
		local rings = ringCount(level)
		maxRadius = FIRST_RADIUS + (rings - 1) * RING_GAP
		local size = maxRadius * 2 + 40
		-- Porteur centré sur le compteur (l'UIScale fait respirer tout)
		local holder = Kit.Box(container, {
			Name = "FocusRings",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(focus.X, focus.Y),
			Size = UDim2.fromOffset(size, size),
			BackgroundTransparency = 1,
		})
		root = holder
		local scale = Instance.new("UIScale")
		scale.Parent = holder
		breathScale = scale
		local c = size / 2

		-- Halo doux derrière le compteur (niveau 6+)
		if level >= 6 then
			glow = Kit.Ellipse(holder, c, c, 420, 150, if dark then Kit.Rgb(90, 220, 200) else Kit.Rgb(150, 235, 220), 0.88, 1)
		else
			glow = nil
		end

		-- Les anneaux sont coupés juste sous le nombre : des arches au-dessus
		-- du bouton et autour du compteur, rien derrière la ligne "par
		-- seconde" ni les pastilles.
		local arch = Kit.Box(holder, {
			Name = "Arch",
			Size = UDim2.fromOffset(size, c + CUT_BELOW),
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			ZIndex = 2,
		})

		-- Anneaux (plus transparents vers l'extérieur, plus lumineux à chaque niveau)
		for index = 1, rings do
			local radius = FIRST_RADIUS + (index - 1) * RING_GAP
			local golden = level >= 10 and index == rings
			local color = if golden then Kit.Rgb(255, 204, 100) else COLORS[(index - 1) % #COLORS + 1]
			local alpha = math.clamp(0.64 + index * 0.022 - level * 0.02, 0.42, 0.88)
			if not dark then
				alpha = math.clamp(alpha + 0.04, 0.44, 0.9)
			end
			local ring = Kit.Ring(arch, c, c, radius * 2, color, if golden then 3 else (if index % 3 == 1 then 2 else 1.5), alpha, 2)
			ring.Name = "Ring"
		end

		-- Onde de respiration
		local wave, stroke = Kit.Ring(arch, c, c, FIRST_RADIUS * 2, COLORS[1], 2, 1, 2)
		wave.Name = "Breath"
		pulse, pulseStroke = wave, stroke

		-- Perles de concentration (passent sous "l'horizon" du compteur)
		for index = 1, beadCount(level) do
			local ringIndex = 1 + (index * 2) % rings
			local radius = FIRST_RADIUS + (ringIndex - 1) * RING_GAP
			local bead = Kit.Circle(arch, c, c, 7, Kit.Rgb(255, 255, 255), 0, 3)
			Kit.Stroke(bead, COLORS[(index - 1) % #COLORS + 1], 2, 0)
			table.insert(beads, { Frame = bead, Radius = radius, Speed = (if index % 2 == 0 then -1 else 1) * (0.25 + index * 0.04), Angle = index * 1.3 - math.pi / 2 })
		end
	end

	build()
	Kit.WatchLevel(ctx, ID, function(newLevel)
		level = math.clamp(newLevel, 1, MAX_LEVEL)
		build()
	end)
	Kit.WatchTheme(ctx, function(isDark)
		dark = isDark
		build()
	end)
	ctx.Connect(Zones.Changed, function()
		local holder = root
		if holder then
			local focus = Zones.GetFocus()
			holder.Position = UDim2.fromOffset(focus.X, focus.Y)
		end
	end)

	Kit.Loop(ctx, 20, function(dt, t)
		local phase = (t % BREATH) / BREATH
		local breath = 0.5 - 0.5 * math.cos(phase * math.pi * 2) -- 0 -> 1 -> 0
		local scale = breathScale
		if scale then
			scale.Scale = 0.97 + breath * 0.06
		end
		local halo = glow
		if halo then
			halo.BackgroundTransparency = 0.9 - breath * 0.05
		end
		-- Onde : part du centre à chaque inspiration
		local wave, stroke = pulse, pulseStroke
		if wave and stroke and effects then
			local c = wave.Parent and (wave.Parent :: Frame).Size.X.Offset / 2 or 0
			local d = (FIRST_RADIUS * 0.6 + phase * (maxRadius - FIRST_RADIUS * 0.6 + 30)) * 2
			wave.Position = UDim2.fromOffset(c, c)
			wave.Size = UDim2.fromOffset(d, d)
			stroke.Transparency = 0.45 + phase * 0.55
		end
		for _, bead in ipairs(beads) do
			bead.Angle += bead.Speed * dt
			local holder = root
			if holder then
				local c = holder.Size.X.Offset / 2
				bead.Frame.Position = UDim2.fromOffset(c + math.cos(bead.Angle) * bead.Radius, c + math.sin(bead.Angle) * bead.Radius)
			end
		end
	end)
end

return DeepFocus
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="109">
          <Properties>
            <string name="Name">Disco</string>
            <string name="Source"><![CDATA[--[[
	Disco (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > Disco

	v9 : une VRAIE boule à facettes (calque Overlay), suspendue par une
	chaîne devant le bandeau d'actu, à droite de la colonne centrale
	(x = centre + 360 au plus, mais toujours à gauche du bloc droit du
	bandeau - horloge, marchés - et de la pastille "📬 Dopamail", revérifié
	chaque seconde ; y = 14 : au-dessus des cartes du haut ; la chaîne
	monte dans la barre du haut de Roblox) :
	  - la boule : 11 rangées x 10 colonnes de facettes carrées projetées
	    sur une sphère (plus étroites vers les bords = relief), ombrées par
	    une lumière en haut à gauche, séparées par des joints sombres ; en
	    tournant, un motif de luminosité défile sur chaque rangée
	    (scintillement), des reflets colorés passent et des facettes
	    flashent (étoile ✦) ; gros reflet doux fixe, calotte + anneau +
	    chaîne, léger balancement ;
	  - fins rayons de lumière qui partent de la boule et balayent l'écran
	    en tournant (ils s'estompent au loin), 3 faisceaux colorés qui vont
	    et viennent, et une pluie de taches de lumière (cœur lumineux +
	    halo coloré : les reflets des facettes) qui glissent sur tout
	    l'écran sans jamais en sortir, plus 3 halos colorés très doux ;
	  - thème clair : rayons et taches plus colorés (le blanc disparaîtrait) ;
	  - rien n'est cliquable : les clics passent à travers.
	Spectaculaire mais pas éblouissant : tout est semi-transparent, les
	rayons sont fins. Coût : UNE boucle OnRender, mise à jour 30 fois par
	seconde (facettes 12 fois par seconde) ; aucune création d'instance
	après le départ. Effets coupés (⚙️) : moins de rayons, pas de taches.
]]

local Disco = {}
Disco.Slot = "Overlay"

local BALL_X = 360 -- décalage maximal depuis le centre de l'écran
local BALL_X_MIN = 200 -- ... et minimal (le chapeau du gros bouton est au centre)
local BALL_Y = 14 -- centre de la boule (le bandeau d'actu fait y 0-30 ; les cartes commencent à y = 40)
local BALL_D = 50
local PIVOT_Y = -74 -- point d'attache de la chaîne (au-dessus de l'écran)
local UPDATE_STEP = 1 / 30
local FACET_STEP = 1 / 12
local RAY_COUNT = 12
local BEAM_COUNT = 3
local SPOT_COUNT = 20
local POOL_COUNT = 3
local SPARKLE_COUNT = 4
local RING = 24 -- facettes sur le tour complet d'une rangée
local SPIN_SPEED = 3 -- facettes / seconde (la boule fait un tour en ~8 s)
local SWEEP_SPEED = 13 -- degrés / seconde (rayons et taches)
local RANGE_MIN, RANGE_MAX = 6, 174 -- angles visibles (0 = droite, 90 = bas)

local WHITE = Color3.new(1, 1, 1)
local GROUT = Color3.fromRGB(46, 48, 62)

local PALETTE = {
	Color3.fromRGB(255, 96, 206), -- rose
	Color3.fromRGB(86, 222, 255), -- cyan
	Color3.fromRGB(176, 116, 255), -- violet
	Color3.fromRGB(255, 214, 96), -- or
	Color3.fromRGB(128, 255, 170), -- menthe
}

-- Rangées (latitudes en degrés, du haut vers le bas) et colonnes (longitudes)
local LATITUDES = { 70, 57, 44, 31, 18, 6, -6, -18, -31, -44, -57, -70 }
local LONGITUDES = { -75, -60, -45, -30, -15, 0, 15, 30, 45, 60, 75 }

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

-- Fondu en entrée / sortie de la zone visible (0..1)
local function edgeFade(angle: number): number
	return math.clamp(math.min(angle - RANGE_MIN, RANGE_MAX - angle) / 18, 0, 1)
end

function Disco.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Create = UIUtil.Create
	local container: Frame = ctx.Container
	local random = Random.new()

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end
	local fullEffects = effectsOn()

	local root = Create("Frame", {
		Name = "Disco",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Active = false,
		ZIndex = 1,
		Parent = container,
	})

	local function round(guiObject: GuiObject)
		UIUtil.Corner(guiObject, UDim.new(1, 0))
	end

	------------------------------------------------------------------
	-- Halos colorés très doux (derrière tout)
	------------------------------------------------------------------
	local pools = {}
	if fullEffects then
		for index = 1, POOL_COUNT do
			local size = random:NextInteger(200, 280)
			local pool = Create("Frame", {
				Name = "Pool",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(size, size),
				BackgroundColor3 = PALETTE[index],
				BackgroundTransparency = 0.93,
				BorderSizePixel = 0,
				ZIndex = 1,
				Parent = root,
			})
			round(pool)
			table.insert(pools, {
				Frame = pool,
				A = random:NextNumber(0.1, 0.22),
				B = random:NextNumber(0.08, 0.18),
				P = random:NextNumber(0, math.pi * 2),
				Q = random:NextNumber(0, math.pi * 2),
				Hue = index / POOL_COUNT,
			})
		end
	end

	------------------------------------------------------------------
	-- Larges faisceaux colorés (vont et viennent) et fins rayons
	------------------------------------------------------------------
	local beams = {}
	for index = 1, (fullEffects and BEAM_COUNT or 2) do
		local beam = Create("Frame", {
			Name = "Beam",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(1500, random:NextInteger(28, 38)),
			BackgroundColor3 = PALETTE[index],
			BackgroundTransparency = 0.62,
			BorderSizePixel = 0,
			ZIndex = 2,
			Parent = root,
		})
		Create("UIGradient", {
			Color = ColorSequence.new(WHITE),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(0.2, 0.25),
				NumberSequenceKeypoint.new(0.65, 0.85),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = beam,
		})
		table.insert(beams, {
			Frame = beam,
			Length = 1500,
			Base = 45 + (index - 1) * (90 / math.max(1, BEAM_COUNT - 1)),
			Amp = random:NextNumber(26, 40),
			Freq = random:NextNumber(0.22, 0.4) * (index % 2 == 0 and -1 or 1),
			Phase = random:NextNumber(0, math.pi * 2),
			Hue = (index - 1) / BEAM_COUNT,
		})
	end

	local rays = {}
	for index = 1, (fullEffects and RAY_COUNT or 5) do
		local length = random:NextInteger(520, 1250)
		local ray = Create("Frame", {
			Name = "Ray",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(length, random:NextInteger(2, 5)),
			BackgroundColor3 = WHITE:Lerp(PALETTE[(index - 1) % #PALETTE + 1], 0.35),
			BackgroundTransparency = 0.4,
			BorderSizePixel = 0,
			ZIndex = 3,
			Parent = root,
		})
		Create("UIGradient", {
			Color = ColorSequence.new(WHITE),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(0.3, 0.45),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = ray,
		})
		table.insert(rays, {
			Frame = ray,
			Tint = PALETTE[(index - 1) % #PALETTE + 1],
			Length = length,
			Offset = (index - 1) * (RANGE_MAX - RANGE_MIN) / (fullEffects and RAY_COUNT or 5) + random:NextNumber(-6, 6),
			Alpha = random:NextNumber(0.3, 0.5),
			Twinkle = random:NextNumber(0, math.pi * 2),
		})
	end

	------------------------------------------------------------------
	-- Taches de lumière projetées (les reflets des facettes)
	------------------------------------------------------------------
	local spots = {}
	if fullEffects then
		for index = 1, SPOT_COUNT do
			-- Distance = fraction de la distance au bord de l'écran dans sa direction
			local reach = random:NextNumber(0.12, 0.95)
			local size = math.floor(5 + reach * 5 + random:NextNumber(0, 3))
			local color = PALETTE[(index - 1) % #PALETTE + 1]
			-- Halo coloré (doux) + cœur lumineux (petit carré arrondi, en losange)
			local glow = Create("Frame", {
				Name = "Spot",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(size * 3, size * 3),
				BackgroundColor3 = color,
				BackgroundTransparency = 0.8,
				BorderSizePixel = 0,
				ZIndex = 4,
				Parent = root,
			})
			round(glow)
			local core = Create("Frame", {
				Name = "Core",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(size, size),
				BackgroundColor3 = WHITE:Lerp(color, 0.3),
				BackgroundTransparency = 0.2,
				BorderSizePixel = 0,
				Rotation = 45,
				ZIndex = 5,
				Parent = glow,
			})
			UIUtil.Corner(core, math.max(1, math.floor(size / 3)))
			table.insert(spots, {
				Frame = glow,
				Core = core,
				Tint = color,
				Reach = reach,
				Offset = random:NextNumber(0, RANGE_MAX - RANGE_MIN),
				Speed = SWEEP_SPEED * random:NextNumber(0.8, 1.2) * (reach < 0.35 and 1.15 or 1),
				Alpha = random:NextNumber(0.65, 0.9),
				Twinkle = random:NextNumber(0, math.pi * 2),
			})
		end
	end

	------------------------------------------------------------------
	-- La boule, sa calotte et sa chaîne (dans un support qui se balance
	-- autour du point d'attache : Rotation tourne autour du CENTRE d'un
	-- cadre, donc le support est centré sur le point d'attache)
	------------------------------------------------------------------
	local radius = BALL_D / 2
	local hang = BALL_Y - PIVOT_Y -- distance point d'attache -> centre de la boule
	local half = hang + radius + 10
	-- Décalage horizontal : à gauche du bloc droit du bandeau d'actu (horloge,
	-- marchés : attribut "RightInset" de NewsTicker) et de la pastille Dopamail
	local function computeBallOffset(): number
		local interface = ctx.Interface
		local canvas = interface.CanvasSize or Vector2.new(1280, 720)
		local scale = math.max(0.01, interface.Scale or 1)
		local rightZone = 70
		local slots = interface.Layers and interface.Layers.Slots
		local ticker = slots and slots:FindFirstChild("NewsTicker")
		local inset = ticker and ticker:GetAttribute("RightInset")
		if type(inset) == "number" then
			rightZone = inset
		end
		local email = ctx.Overlay and ctx.Overlay:FindFirstChild("Email")
		local pill = email and email:FindFirstChild("Unread")
		if pill and pill:IsA("GuiObject") and pill.Visible then
			rightZone += 6 + pill.AbsoluteSize.X / scale
		end
		return math.clamp(canvas.X / 2 - rightZone - BALL_D / 2 - 28, BALL_X_MIN, BALL_X)
	end
	local ballOffset = computeBallOffset()

	local holder = Create("Frame", {
		Name = "Hanger",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, ballOffset, 0, PIVOT_Y),
		Size = UDim2.fromOffset(half * 2, half * 2),
		BackgroundTransparency = 1,
		ZIndex = 6,
		Parent = root,
	})
	local ballX, ballY = half, half + hang -- centre de la boule dans le support

	-- Chaîne : maillons ovales (creux) et maillons vus de profil, alternés
	local capTop = ballY - radius - 6
	local linkY = half + 2
	local linkIndex = 0
	while linkY < capTop - 3 do
		linkIndex += 1
		if linkIndex % 2 == 1 then
			local link = Create("Frame", {
				Name = "Link",
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.fromOffset(ballX, linkY),
				Size = UDim2.fromOffset(6, 9),
				BackgroundTransparency = 1,
				ZIndex = 6,
				Parent = holder,
			})
			round(link)
			UIUtil.Stroke(link, Color3.fromRGB(196, 198, 214), 1.6, 0)
		else
			Create("Frame", {
				Name = "Link",
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.fromOffset(ballX, linkY - 1),
				Size = UDim2.fromOffset(2, 11),
				BackgroundColor3 = Color3.fromRGB(150, 152, 170),
				BorderSizePixel = 0,
				ZIndex = 7,
				Parent = holder,
			})
		end
		linkY += 7
	end
	-- Anneau + calotte
	local eye = Create("Frame", {
		Name = "Eye",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(ballX, capTop - 1),
		Size = UDim2.fromOffset(8, 8),
		BackgroundTransparency = 1,
		ZIndex = 7,
		Parent = holder,
	})
	round(eye)
	UIUtil.Stroke(eye, Color3.fromRGB(214, 216, 230), 2, 0)
	local cap = Create("Frame", {
		Name = "Cap",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromOffset(ballX, capTop + 2),
		Size = UDim2.fromOffset(14, 7),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 9,
		Parent = holder,
	})
	UIUtil.Corner(cap, 3)
	UIUtil.Gradient(cap, ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(120, 122, 140)),
		ColorSequenceKeypoint.new(0.35, Color3.fromRGB(246, 246, 252)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(96, 98, 116)),
	}), 0)
	UIUtil.Stroke(cap, Color3.fromRGB(30, 30, 40), 1, 0.4)

	-- Halo coloré autour de la boule
	local halo = Create("Frame", {
		Name = "Halo",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(ballX, ballY),
		Size = UDim2.fromOffset(BALL_D + 26, BALL_D + 26),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.82,
		BorderSizePixel = 0,
		ZIndex = 6,
		Parent = holder,
	})
	round(halo)

	-- Boule : joints sombres (fond), facettes par-dessus
	local ball = Create("Frame", {
		Name = "Ball",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(ballX, ballY),
		Size = UDim2.fromOffset(BALL_D, BALL_D),
		BackgroundColor3 = GROUT,
		BorderSizePixel = 0,
		ZIndex = 7,
		Parent = holder,
	})
	round(ball)
	UIUtil.Stroke(ball, Color3.fromRGB(20, 20, 30), 1.2, 0.2)

	-- Facettes : projection des rangées / colonnes sur la sphère
	local lightLength = math.sqrt(0.45 ^ 2 + 0.55 ^ 2 + 0.7 ^ 2)
	local lightX, lightY, lightZ = -0.45 / lightLength, -0.55 / lightLength, 0.7 / lightLength
	local facets = {}
	for row = 1, #LATITUDES - 1 do
		local top, bottom = math.rad(LATITUDES[row]), math.rad(LATITUDES[row + 1])
		local middle = (top + bottom) / 2
		local y1 = radius - radius * math.sin(top)
		local y2 = radius - radius * math.sin(bottom)
		for column = 1, #LONGITUDES - 1 do
			local left, right = math.rad(LONGITUDES[column]), math.rad(LONGITUDES[column + 1])
			local x1 = radius + radius * math.cos(middle) * math.sin(left)
			local x2 = radius + radius * math.cos(middle) * math.sin(right)
			local width, height = x2 - x1 - 1, y2 - y1 - 1
			if width >= 1.2 and height >= 1.2 then
				local lon = (left + right) / 2
				-- Normale (x droite, y bas, z vers nous) : ombrage fixe (lumière en haut à gauche)
				local nx, ny, nz = math.cos(middle) * math.sin(lon), -math.sin(middle), math.cos(middle) * math.cos(lon)
				local lambert = math.max(0, nx * lightX + ny * lightY + nz * lightZ)
				local shade = (0.3 + 0.7 * lambert ^ 0.8) * (0.55 + 0.45 * nz)
				local facet = Create("Frame", {
					Name = "Facet",
					Position = UDim2.fromOffset(x1 + 0.5, y1 + 0.5),
					Size = UDim2.fromOffset(width, height),
					BackgroundColor3 = Color3.new(shade, shade, shade),
					BorderSizePixel = 0,
					ZIndex = 8,
					Parent = ball,
				})
				table.insert(facets, {
					Frame = facet,
					Row = row,
					Column = column,
					Shade = shade,
					Center = Vector2.new(x1 + width / 2, y1 + height / 2),
					Flash = 0,
				})
			end
		end
	end

	-- Motifs de luminosité / de reflets colorés, un par rangée (tour complet)
	local patterns = {}
	for row = 1, #LATITUDES - 1 do
		local values, tints = {}, {}
		for index = 1, RING do
			local roll = random:NextNumber()
			values[index] = roll < 0.12 and random:NextNumber(0.95, 1.25) or random:NextNumber(0.25, 0.85)
			tints[index] = random:NextNumber() < 0.14 and random:NextInteger(1, #PALETTE) or 0
		end
		patterns[row] = { Values = values, Tints = tints, Offset = random:NextNumber(0, RING) }
	end

	-- Reflet doux fixe (la lumière ne tourne pas avec la boule)
	local shine = Create("Frame", {
		Name = "Shine",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(radius * 0.62, radius * 0.56),
		Size = UDim2.fromOffset(19, 13),
		Rotation = -35,
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.38,
		BorderSizePixel = 0,
		ZIndex = 10,
		Parent = ball,
	})
	round(shine)
	local shineCore = Create("Frame", {
		Name = "ShineCore",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(6, 4),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.05,
		BorderSizePixel = 0,
		ZIndex = 11,
		Parent = shine,
	})
	round(shineCore)

	------------------------------------------------------------------
	-- Étincelles ✦ sur les facettes qui flashent (réserve recyclée)
	------------------------------------------------------------------
	local sparkles = {}
	for index = 1, SPARKLE_COUNT do
		local star = UIUtil.Label({
			Name = "Sparkle",
			Text = "✦",
			TextColor3 = WHITE,
			TextTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(18, 18),
			MaxTextSize = 18,
			Visible = false,
			ZIndex = 12,
			Parent = holder,
		})
		local stroke = UIUtil.Stroke(star, Color3.fromRGB(110, 70, 170), 1, 1)
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		sparkles[index] = { Label = star, Stroke = stroke, Scale = Create("UIScale", { Scale = 0.2, Parent = star }), Age = 1, Spin = 0 }
	end
	local nextSparkle = 1

	local function flashFacet()
		local facet = facets[random:NextInteger(1, #facets)]
		-- Surtout les facettes bien éclairées (face à nous)
		if facet.Shade < 0.45 then
			facet = facets[random:NextInteger(1, #facets)]
		end
		facet.Flash = 1
		local sparkle = sparkles[nextSparkle]
		nextSparkle = nextSparkle % SPARKLE_COUNT + 1
		sparkle.Age = 0
		sparkle.Spin = random:NextNumber(-60, 60)
		sparkle.Label.Position = UDim2.fromOffset(ballX - radius + facet.Center.X, ballY - radius + facet.Center.Y)
		sparkle.Label.Visible = true
	end

	local function stepSparkles(dt: number)
		for _, sparkle in ipairs(sparkles) do
			if sparkle.Age < 1 then
				sparkle.Age = math.min(1, sparkle.Age + dt / 0.6)
				local age = sparkle.Age
				local grow = math.clamp(age / 0.3, 0, 1)
				sparkle.Scale.Scale = 0.2 + 0.9 * math.sin(grow * math.pi / 2) - 0.5 * math.max(0, age - 0.3)
				sparkle.Label.TextTransparency = age ^ 2
				sparkle.Stroke.Transparency = 0.4 + 0.6 * age
				sparkle.Label.Rotation = sparkle.Spin * age
				if sparkle.Age >= 1 then
					sparkle.Label.Visible = false
				end
			end
		end
	end

	------------------------------------------------------------------
	-- Animation (30 fois par seconde ; facettes 12 fois par seconde)
	------------------------------------------------------------------
	-- Thème clair : rayons et taches colorés (le blanc disparaîtrait sur un fond clair)
	local darkTheme = nil :: boolean?
	local function applyTheme()
		local dark = ctx.State.DarkMode == true
		if dark == darkTheme then
			return
		end
		darkTheme = dark
		for _, ray in ipairs(rays) do
			ray.Frame.BackgroundColor3 = dark and WHITE:Lerp(ray.Tint, 0.35) or WHITE:Lerp(ray.Tint, 0.9)
		end
		for _, spot in ipairs(spots) do
			spot.Core.BackgroundColor3 = dark and WHITE:Lerp(spot.Tint, 0.3) or spot.Tint
		end
	end
	applyTheme()

	local time = 0
	local pending = 0
	local layoutClock = 0
	local facetClock = 0
	local flashClock = 0
	local spin = 0

	local function updateFacets(hue: number)
		local tintBoost = 0.28 + 0.1 * math.sin(time * 1.7)
		for _, facet in ipairs(facets) do
			local pattern = patterns[facet.Row]
			local position = (facet.Column + spin + pattern.Offset) % RING
			local index = math.floor(position)
			local frac = position - index
			local a = pattern.Values[index + 1]
			local b = pattern.Values[(index + 1) % RING + 1]
			local value = lerp(a, b, frac)
			local brightness = math.min(1, facet.Shade * (0.62 + 0.7 * value))
			local color = Color3.new(brightness * 0.97, brightness * 0.98, math.min(1, brightness * 1.05))
			local tint = pattern.Tints[index + 1]
			if tint > 0 then
				local tintColor = PALETTE[(tint + math.floor(hue * #PALETTE)) % #PALETTE + 1]
				color = color:Lerp(tintColor, tintBoost * math.min(1, facet.Shade + 0.3))
			end
			if facet.Flash > 0 then
				color = color:Lerp(WHITE, facet.Flash)
				facet.Flash = math.max(0, facet.Flash - FACET_STEP * 3.5)
			end
			facet.Frame.BackgroundColor3 = color
		end
	end

	ctx.OnRender(function(dt: number)
		pending += dt
		if pending < UPDATE_STEP then
			return
		end
		local step = math.min(pending, 0.1)
		pending = 0
		time += step
		spin = (spin + step * SPIN_SPEED) % RING
		local hue = (time * 0.05) % 1

		-- Place de la boule (le bandeau / la boîte mail peuvent changer)
		layoutClock += step
		if layoutClock >= 1 then
			layoutClock = 0
			applyTheme()
			local offset = computeBallOffset()
			if math.abs(offset - ballOffset) > 0.5 then
				ballOffset = offset
				holder.Position = UDim2.new(0.5, ballOffset, 0, PIVOT_Y)
			end
		end

		-- Balancement (autour du point d'attache) et centre de la boule
		local sway = math.sin(time * 0.9) * 2.2
		holder.Rotation = sway
		local swayRad = math.rad(sway)
		local cx = ballOffset - hang * math.sin(swayRad)
		local cy = PIVOT_Y + hang * math.cos(swayRad)

		-- Larges faisceaux (vont et viennent, couleur qui change doucement)
		for _, beam in ipairs(beams) do
			local angle = beam.Base + math.sin(time * beam.Freq + beam.Phase) * beam.Amp
			local radians = math.rad(angle)
			local halfLength = beam.Length / 2
			beam.Frame.Position = UDim2.new(0.5, cx + math.cos(radians) * halfLength, 0, cy + math.sin(radians) * halfLength)
			beam.Frame.Rotation = angle
			beam.Frame.BackgroundColor3 = Color3.fromHSV((hue + beam.Hue) % 1, darkTheme and 0.72 or 0.9, 1)
			beam.Frame.BackgroundTransparency = 0.58 + 0.12 * (0.5 + 0.5 * math.sin(time * 1.3 + beam.Phase))
		end

		-- Fins rayons : ils tournent avec la boule, entrent d'un côté et sortent de l'autre
		local sweepRange = RANGE_MAX - RANGE_MIN
		for _, ray in ipairs(rays) do
			local angle = RANGE_MIN + (ray.Offset + time * SWEEP_SPEED) % sweepRange
			local radians = math.rad(angle)
			local halfLength = ray.Length / 2
			ray.Frame.Position = UDim2.new(0.5, cx + math.cos(radians) * halfLength, 0, cy + math.sin(radians) * halfLength)
			ray.Frame.Rotation = angle
			local alpha = ray.Alpha * edgeFade(angle) * (0.75 + 0.25 * math.sin(time * 4 + ray.Twinkle)) * (darkTheme and 1 or 1.25)
			ray.Frame.BackgroundTransparency = 1 - alpha
		end

		-- Taches de lumière (reflets projetés qui glissent sur l'écran, toujours dedans)
		local canvas = ctx.Interface.CanvasSize or Vector2.new(1280, 720)
		local originX = canvas.X / 2 + cx
		for _, spot in ipairs(spots) do
			local angle = RANGE_MIN + (spot.Offset + time * spot.Speed) % sweepRange
			local radians = math.rad(angle)
			local dx, dy = math.cos(radians), math.sin(radians)
			local toEdgeX = dx > 0.01 and (canvas.X - originX) / dx or (dx < -0.01 and originX / -dx or math.huge)
			local toEdgeY = dy > 0.01 and (canvas.Y - cy) / dy or math.huge
			local distance = math.min(toEdgeX, toEdgeY, 1400) * spot.Reach
			spot.Frame.Position = UDim2.new(0.5, cx + dx * distance, 0, cy + dy * distance)
			local alpha = spot.Alpha * edgeFade(angle) * (0.65 + 0.35 * math.sin(time * 3.2 + spot.Twinkle))
			spot.Core.BackgroundTransparency = 1 - alpha
			spot.Frame.BackgroundTransparency = 1 - alpha * 0.28
		end

		-- Halos colorés (courbes de Lissajous)
		for _, pool in ipairs(pools) do
			pool.Frame.Position = UDim2.fromScale(0.5 + math.sin(time * pool.A + pool.P) * 0.42, 0.55 + math.sin(time * pool.B + pool.Q) * 0.36)
			pool.Frame.BackgroundColor3 = Color3.fromHSV((hue + pool.Hue) % 1, 0.65, 1)
		end

		halo.BackgroundColor3 = Color3.fromHSV(hue, 0.35, 1)
		halo.BackgroundTransparency = 0.78 + 0.06 * math.sin(time * 2.4)

		-- Facettes
		facetClock += step
		if facetClock >= FACET_STEP then
			facetClock = 0
			updateFacets(hue)
		end

		-- Facettes qui flashent + étincelles
		flashClock += step
		if flashClock >= 0.45 then
			flashClock = random:NextNumber(-0.2, 0.1)
			flashFacet()
		end
		stepSparkles(step)
	end)
end

return Disco
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="110">
          <Properties>
            <string name="Name">DreamMachine</string>
            <string name="Source"><![CDATA[--[[
	DreamMachine (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > DreamMachine

	💤 Machine à rêves (+/s, 10 niveaux, après 2 visites à l'océan) : une
	petite machine rétro (corps lavande, écran « z », bouton, voyants,
	ampoule qui s'allume) souffle des bulles de pensée vers des NUAGES DE
	RÊVE ; dans le premier nuage, des moutons sautent une barrière l'un
	après l'autre (compter les moutons !). Chaque niveau ajoute quelque chose :
	  1 : machine + 1 nuage + 1 mouton     6 : 3e nuage (lune et étoiles)
	  2 : voyants qui clignotent            7 : 3e mouton
	  3 : 2e nuage (mouton qui dort)        8 : liseré doré + étincelles
	  4 : 2e mouton                         9 : ampoule arc-en-ciel
	  5 : rayon de rêve (lumière)          10 : 4e mouton + « zZ » de la machine
	Trois mises en page, Cosmos/Zones choisit celle qui se voit le mieux :
	HAUTE (nuages empilés au-dessus de la machine : gouttières entre les
	cartes du bas sur PC), LARGE (nuages à droite : bas des téléphones) ou
	CARRÉE (2-3 nuages autour de la machine : côtés des tablettes).
	Calque Background, ≤ 20 images/s, objets recyclés.
]]

local Cosmos = script.Parent:WaitForChild("Cosmos")
local Kit = require(Cosmos:WaitForChild("Kit"))
local Zones = require(Cosmos:WaitForChild("Zones"))

local DreamMachine = {}
DreamMachine.Slot = "Background"

local UPGRADE_ID = "DreamMachine"
local MAX_LEVEL = 10

-- Tailles de la boîte selon le nombre de nuages (1, 2, 3)
local TALL_W = 106
local TALL_H = { 222, 292, 366 }
local WIDE_H = 160
local WIDE_W = { 238, 340, 438 }
local SQUARE_W, SQUARE_H = 238, 176 -- 2 ou 3 nuages

-- Formes (index Cosmos/Zones) : 0 = haute, 1 = large, 2 = carrée
local TALL, WIDE, SQUARE = 0, 1, 2

-- Nuages : taille intérieure
local CLOUD_SIZE = {
	Vector2.new(104, 76),
	Vector2.new(92, 58),
	Vector2.new(84, 54),
}

local function cloudCount(level: number): number
	return if level >= 6 then 3 elseif level >= 3 then 2 else 1
end

local function sheepCount(level: number): number
	return if level >= 10 then 4 elseif level >= 7 then 3 elseif level >= 4 then 2 else 1
end

-- Positions (centre) : machine, ampoule, bulles, nuages, selon la mise en page
type Layout = {
	W: number,
	H: number,
	Device: Vector2,
	Bulb: Vector2,
	Bubbles: { Vector3 }, -- x, y, diamètre
	Clouds: { Vector2 },
	Beam: { Vector2 }, -- début, fin
}

local function layoutFor(shape: number, clouds: number): Layout
	if shape == WIDE then
		local w = WIDE_W[clouds]
		return {
			W = w,
			H = WIDE_H,
			Device = Vector2.new(52, 116),
			Bulb = Vector2.new(70, 82),
			Bubbles = { Vector3.new(86, 70, 6), Vector3.new(98, 58, 9), Vector3.new(112, 46, 12) },
			Clouds = { Vector2.new(178, 70), Vector2.new(288, 104), Vector2.new(390, 60) },
			Beam = { Vector2.new(70, 82), Vector2.new(170, 70) },
		}
	elseif shape == SQUARE and clouds >= 2 then
		return {
			W = SQUARE_W,
			H = SQUARE_H,
			Device = Vector2.new(54, 138),
			Bulb = Vector2.new(73, 102),
			Bubbles = { Vector3.new(88, 90, 6), Vector3.new(100, 78, 9), Vector3.new(114, 66, 12) },
			Clouds = { Vector2.new(180, 52), Vector2.new(54, 44), Vector2.new(184, 140) },
			Beam = { Vector2.new(73, 102), Vector2.new(176, 58) },
		}
	end
	local h = TALL_H[clouds]
	return {
		W = TALL_W,
		H = h,
		Device = Vector2.new(53, h - 36),
		Bulb = Vector2.new(72, h - 72),
		Bubbles = { Vector3.new(78, h - 90, 6), Vector3.new(70, h - 103, 9), Vector3.new(59, h - 118, 12) },
		Clouds = { Vector2.new(53, h - 166), Vector2.new(50, h - 252), Vector2.new(56, h - 326) },
		Beam = { Vector2.new(72, h - 72), Vector2.new(53, h - 160) },
	}
end

function DreamMachine.Start(ctx)
	Zones.Attach(ctx)
	local random = Random.new()
	local effects = Kit.Effects(ctx)
	local level = math.clamp(ctx.GetLevel(UPGRADE_ID), 1, MAX_LEVEL)
	local dark = Kit.IsDark(ctx)
	local shape = TALL
	local piece = Kit.Piece(ctx.Container, "DreamMachine", TALL_W, TALL_H[1])

	-- Éléments animés (remplis par build)
	local content: Frame? = nil
	type Sheep = { Frame: Frame, Offset: number }
	local sheep: { Sheep } = {}
	local cloud1: Frame? = nil
	local floaters: { { Frame: Frame, Base: UDim2, Phase: number, Amp: number } } = {}
	local lights: { Frame } = {}
	local twinkles: { { Frame: Frame, Phase: number } } = {}
	local bulb: Frame? = nil
	local bulbGlow: Frame? = nil
	local beam: UIGradient? = nil
	local screenZ: TextLabel? = nil
	local sleeper: Frame? = nil
	local floatZs: { { Label: TextLabel, Origin: Vector2, Offset: number } } = {}

	local function float(frame: Frame, amplitude: number)
		table.insert(floaters, { Frame = frame, Base = frame.Position, Phase = random:NextNumber(0, math.pi * 2), Amp = amplitude })
	end

	-- Mouton (corps laineux, tête et pattes sombres). (x, y) = centre.
	-- 6 instances (7 avec contour) : corps + coins, tête + coins, 2 pattes.
	local function makeSheep(parent: Instance, x: number, y: number, z: number, outline: boolean?): Frame
		local body = Kit.Box(parent, {
			Name = "Sheep",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(x, y),
			Size = UDim2.fromOffset(20, 14),
			Color = Color3.new(1, 1, 1),
			ZIndex = z,
		})
		Kit.Corner(body, 7)
		if outline then
			Kit.Stroke(body, Kit.Rgb(150, 140, 200), 1, 0)
		end
		local head = Kit.Ellipse(body, 19, 6, 8, 9, Kit.Rgb(64, 56, 84), 0, z + 1)
		head.Name = "Head"
		Kit.Box(body, { Name = "LegA", Position = UDim2.fromOffset(4, 13), Size = UDim2.fromOffset(2, 4), Color = Kit.Rgb(64, 56, 84), ZIndex = z })
		Kit.Box(body, { Name = "LegB", Position = UDim2.fromOffset(13, 13), Size = UDim2.fromOffset(2, 4), Color = Kit.Rgb(64, 56, 84), ZIndex = z })
		return body
	end

	-- Nuage de rêve : intérieur "ciel du soir" + bord blanc duveteux.
	-- Renvoie l'intérieur (qui découpe son contenu).
	local function makeCloud(parent: Instance, index: number, centre: Vector2): Frame
		local size = CLOUD_SIZE[index]
		local rim = if dark then Color3.new(1, 1, 1) else Kit.Rgb(214, 206, 252)
		local holder = Kit.Box(parent, {
			Name = "Cloud" .. index,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(centre.X, centre.Y),
			Size = UDim2.fromOffset(size.X, size.Y),
			BackgroundTransparency = 1,
			ZIndex = 4,
		})
		-- Bosses du nuage (derrière l'intérieur)
		local bumps = if index == 1 then { { 0.3, 34 }, { 0.68, 28 } } else {}
		for _, bump in ipairs(bumps) do
			local puff = Kit.Circle(holder, size.X * bump[1], 4, bump[2], rim, 0, 4)
			puff.Name = "Puff"
		end
		local inside = Kit.Box(holder, {
			Name = "Inside",
			Size = UDim2.fromScale(1, 1),
			Color = Color3.new(1, 1, 1),
			ClipsDescendants = true,
			ZIndex = 5,
		})
		Kit.Corner(inside, 18)
		local top = if index == 1 then Kit.Rgb(126, 150, 246) else Kit.Rgb(108, 116, 226)
		local bottom = if index == 1 then Kit.Rgb(178, 150, 240) else Kit.Rgb(84, 70, 170)
		Kit.Gradient(inside, ColorSequence.new(top, bottom), nil, 90)
		Kit.Stroke(inside, rim, 3, 0)
		float(holder, if index == 1 then 1.5 else 2.2)
		return inside
	end

	local function build()
		if content then
			content:Destroy()
		end
		table.clear(sheep)
		table.clear(floaters)
		table.clear(lights)
		table.clear(twinkles)
		table.clear(floatZs)
		bulb, bulbGlow, beam, screenZ, sleeper, cloud1 = nil, nil, nil, nil, nil, nil

		local clouds = cloudCount(level)
		local layout = layoutFor(shape, clouds)
		piece.Frame.Size = UDim2.fromOffset(layout.W, layout.H)
		local ink = Kit.Ink(dark)
		local root = Kit.Box(piece.Frame, {
			Name = "Content",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
		})
		content = root

		-- Rayon de rêve (niveau 5+) : de l'ampoule vers le 1er nuage
		if level >= 5 then
			local from, to = layout.Beam[1], layout.Beam[2]
			local delta = to - from
			local ray = Kit.Box(root, {
				Name = "Beam",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset((from.X + to.X) / 2, (from.Y + to.Y) / 2),
				Size = UDim2.fromOffset(delta.Magnitude, 26),
				Rotation = math.deg(math.atan2(delta.Y, delta.X)),
				Color = Kit.Rgb(255, 236, 150),
				Alpha = if dark then 0.35 else 0.45,
				ZIndex = 2,
			})
			beam = Kit.Gradient(ray, nil, Kit.Fade({ 0, 0.25, 0.45, 0.6, 1, 1 }), 0)
		end

		-- Nuages de rêve
		for index = 1, clouds do
			local inside = makeCloud(root, index, layout.Clouds[index])
			local size = CLOUD_SIZE[index]
			if index == 1 then
				cloud1 = inside
				-- Herbe + barrière
				Kit.Box(inside, {
					Name = "Grass",
					AnchorPoint = Vector2.new(0.5, 1),
					Position = UDim2.new(0.5, 0, 1, -3),
					Size = UDim2.new(1, -14, 0, 11),
					Color = Kit.Rgb(122, 214, 132),
					ZIndex = 6,
				})
				local wood = Kit.Rgb(196, 140, 96)
				local fx, groundY = size.X / 2, size.Y - 12
				for _, dx in ipairs({ -8, 8 }) do
					Kit.Box(inside, { Name = "Post", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromOffset(fx + dx, groundY + 2), Size = UDim2.fromOffset(4, 21), Color = wood, ZIndex = 7 })
				end
				for _, dy in ipairs({ -15, -7 }) do
					Kit.Box(inside, { Name = "Rail", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(fx, groundY + dy), Size = UDim2.fromOffset(28, 3), Color = wood, ZIndex = 7 })
				end
				-- Moutons (recyclés : traversent le nuage en boucle)
				local count = sheepCount(level)
				for k = 1, count do
					local body = makeSheep(inside, -20, groundY - 8, 9)
					table.insert(sheep, { Frame = body, Offset = (k - 1) / count })
				end
				-- Deux étoiles dans le ciel du rêve
				for _, spec in ipairs({ { 0.16, 0.22, 4 } }) do
					local star = Kit.Diamond(inside, size.X * spec[1], size.Y * spec[2], spec[3], Kit.Rgb(255, 246, 204), 0, 6)
					table.insert(twinkles, { Frame = star, Phase = random:NextNumber(0, 6) })
				end
			elseif index == 2 then
				-- Un mouton qui dort sur un petit nuage-lit
				local bed = Kit.Ellipse(inside, size.X / 2, size.Y - 13, 46, 14, Kit.Rgb(222, 216, 255), 0.15, 6)
				bed.Name = "Bed"
				local body = makeSheep(inside, size.X / 2 - 2, size.Y - 24, 8, true)
				body.Rotation = -6
				sleeper = body
				local z = Kit.Text(inside, "z", size.X / 2 + 16, size.Y - 38, 12, Kit.Rgb(240, 236, 255), 9)
				table.insert(floatZs, { Label = z, Origin = Vector2.new(size.X / 2 + 14, size.Y - 34), Offset = 0 })
			else
				-- Lune (croissant : "morsure" au dégradé exact du ciel) et étoiles
				local skyTop, skyBottom = Kit.Rgb(108, 116, 226), Kit.Rgb(84, 70, 170)
				local moonX, moonY = size.X * 0.38, size.Y * 0.52
				Kit.Circle(inside, moonX, moonY, 26, Kit.Rgb(255, 226, 130), 0, 6)
				local biteY = moonY - 6
				local bite = Kit.Circle(inside, moonX + 9, biteY, 22, Color3.new(1, 1, 1), 0, 7)
				Kit.Gradient(bite, ColorSequence.new(skyTop:Lerp(skyBottom, (biteY - 11) / size.Y), skyTop:Lerp(skyBottom, (biteY + 11) / size.Y)), nil, 90)
				for _, spec in ipairs({ { 0.7, 0.3, 5 }, { 0.8, 0.66, 3 } }) do
					local star = Kit.Diamond(inside, size.X * spec[1], size.Y * spec[2], spec[3], Kit.Rgb(255, 246, 204), 0, 8)
					table.insert(twinkles, { Frame = star, Phase = random:NextNumber(0, 6) })
				end
			end
		end

		-- Bulles de pensée
		for _, spec in ipairs(layout.Bubbles) do
			local bubble = Kit.Circle(root, spec.X, spec.Y, spec.Z, if dark then Kit.Rgb(236, 232, 255) else Color3.new(1, 1, 1), 0, 3)
			bubble.Name = "Thought"
			if not dark then
				Kit.Stroke(bubble, Kit.Rgb(170, 158, 230), 1, 0)
			end
			float(bubble, 1.2)
		end

		-- Machine
		local d = layout.Device
		local bodyColor = Kit.Rgb(206, 186, 255)
		-- Ampoule sur sa tige (à droite, au-dessus)
		local b = layout.Bulb
		Kit.Box(root, { Name = "Stem", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromOffset(b.X, b.Y + 4), Size = UDim2.fromOffset(3, d.Y - 26 - b.Y - 4), Color = Kit.Rgb(150, 126, 210), ZIndex = 9 })
		bulbGlow = Kit.Circle(root, b.X, b.Y, 26, Kit.Rgb(255, 232, 140), 0.7, 9)
		bulb = Kit.Circle(root, b.X, b.Y, 14, Kit.Rgb(255, 226, 120), 0, 10)
		local body = Kit.Box(root, {
			Name = "Machine",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(d.X, d.Y),
			Size = UDim2.fromOffset(86, 52),
			Color = Color3.new(1, 1, 1),
			ZIndex = 11,
		})
		Kit.Corner(body, 16)
		Kit.Gradient(body, ColorSequence.new(bodyColor, Kit.Rgb(150, 122, 236)), nil, 90)
		Kit.Stroke(body, if level >= 8 then Kit.Rgb(255, 200, 90) elseif dark then Kit.Rgb(236, 226, 255) else ink, if level >= 8 then 2.5 else 2, if dark and level < 8 then 0.3 else 0)
		-- Pieds
		Kit.Box(root, { Name = "Feet", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromOffset(d.X, d.Y + 22), Size = UDim2.fromOffset(62, 9), Color = Kit.Rgb(120, 96, 196), ZIndex = 10 })
		-- Écran rond avec un « z »
		local screen = Kit.Circle(body, 26, 26, 32, Kit.Rgb(40, 40, 104), 0, 12)
		screenZ = Kit.Text(screen, "z", 16, 15, 17, Kit.Rgb(255, 232, 150), 13)
		-- Bouton rose
		Kit.Circle(body, 66, 18, 12, Kit.Rgb(255, 138, 196), 0, 12)
		-- Voyants (clignotent au niveau 2+)
		for index, color in ipairs({ Kit.Rgb(120, 240, 190), Kit.Rgb(255, 150, 210), Kit.Rgb(255, 226, 120) }) do
			local light = Kit.Box(body, {
				Name = "Light",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(52 + index * 7, 38),
				Size = UDim2.fromOffset(5, 5),
				Color = color,
				Alpha = if level >= 2 then 0 else 0.55,
				Rotation = 45,
				ZIndex = 12,
			})
			table.insert(lights, light)
		end

		-- Étincelles autour de la machine (niveau 8+)
		if level >= 8 then
			for _, spec in ipairs({ { -48, -24, 7 }, { 50, -30, 5 } }) do
				local star = Kit.Diamond(root, d.X + spec[1], d.Y + spec[2], spec[3], Kit.Rgb(255, 214, 110), 0, 12)
				table.insert(twinkles, { Frame = star, Phase = random:NextNumber(0, 6) })
			end
		end

		-- « zZ » de la machine (niveau 10)
		if level >= 10 then
			for index = 1, 2 do
				local z = Kit.Text(root, if index == 1 then "z" else "Z", d.X - 30, d.Y - 36, 12 + index * 3, Kit.Rgb(236, 230, 255), 12)
				local stroke = Instance.new("UIStroke")
				stroke.Color = if dark then Kit.Rgb(70, 56, 140) else ink
				stroke.Thickness = 1.5
				stroke.Parent = z
				table.insert(floatZs, { Label = z, Origin = Vector2.new(d.X - 30, d.Y - 34), Offset = (index - 1) / 2 })
			end
		end
	end

	local function request()
		local clouds = cloudCount(level)
		local shapes = { Vector2.new(WIDE_W[clouds], WIDE_H) }
		if clouds >= 2 then
			table.insert(shapes, Vector2.new(SQUARE_W, SQUARE_H))
		end
		Zones.Request(UPGRADE_ID, {
			{
				W = TALL_W,
				H = TALL_H[clouds],
				Shapes = shapes,
				Anchor = Vector2.new(0.3, 0.84),
				MinScale = 0.45,
				MaxScale = 1.15,
				Gap = 4,
			},
		}, function(placements)
			local placement = placements[1]
			if placement and placement.Shape ~= shape then
				shape = placement.Shape
				build()
			end
			Kit.Place(piece, placement)
		end)
	end

	build()
	request()

	Kit.WatchLevel(ctx, UPGRADE_ID, function(newLevel)
		local oldClouds = cloudCount(level)
		level = math.clamp(newLevel, 1, MAX_LEVEL)
		build()
		if cloudCount(level) ~= oldClouds then
			request()
		end
		Kit.Bump(piece)
	end)
	Kit.WatchTheme(ctx, function(isDark)
		dark = isDark
		build()
	end)

	-- Animation (20 images/s)
	Kit.Loop(ctx, 20, function(_dt, t)
		if not piece.Placed then
			return
		end
		-- Moutons : entrent à gauche, sautent la barrière, sortent à droite
		local inside = cloud1
		if inside then
			local width = CLOUD_SIZE[1].X
			local groundY = CLOUD_SIZE[1].Y - 20
			local fence = width / 2
			for _, s in ipairs(sheep) do
				local p = (t / 3.6 + s.Offset) % 1
				local x = -16 + p * (width + 32)
				local dx = (x - fence) / 21
				local lift = if math.abs(dx) < 1 then 22 * (1 - dx * dx) else math.abs(math.sin(p * 44)) * 1.5
				s.Frame.Position = UDim2.fromOffset(x, groundY - lift)
				s.Frame.Rotation = if math.abs(dx) < 1 then -dx * 16 else 0
			end
		end
		-- Nuages et bulles qui flottent
		for _, item in ipairs(floaters) do
			local base = item.Base
			item.Frame.Position = UDim2.new(base.X.Scale, base.X.Offset, base.Y.Scale, base.Y.Offset + math.sin(t * 1.1 + item.Phase) * item.Amp)
		end
		-- Voyants
		if level >= 2 then
			for index, light in ipairs(lights) do
				light.BackgroundTransparency = if math.floor(t * 3 + index) % 3 == 0 then 0.6 else 0
			end
		end
		-- Ampoule (arc-en-ciel au niveau 9+)
		local glow = bulbGlow
		if glow then
			glow.BackgroundTransparency = 0.62 + 0.18 * math.sin(t * 2.4)
			if level >= 9 then
				local color = Color3.fromHSV((t * 0.18) % 1, 0.45, 1)
				glow.BackgroundColor3 = color
				local core = bulb
				if core then
					core.BackgroundColor3 = color
				end
			end
		end
		local ray = beam
		if ray then
			ray.Offset = Vector2.new(math.sin(t * 1.6) * 0.08, 0)
		end
		local z = screenZ
		if z then
			z.Position = UDim2.fromOffset(16, 15 + math.sin(t * 2) * 2)
		end
		local sleeping = sleeper
		if sleeping then
			sleeping.Rotation = -6 + math.sin(t * 1.4) * 4
		end
		for _, fz in ipairs(floatZs) do
			local p = (t / 2.8 + fz.Offset) % 1
			fz.Label.Position = UDim2.fromOffset(fz.Origin.X + p * 12, fz.Origin.Y - p * 18)
			fz.Label.TextTransparency = if p < 0.2 then 1 - p / 0.2 elseif p > 0.7 then (p - 0.7) / 0.3 else 0
		end
		-- Étoiles qui scintillent (fixes si le joueur a coupé les effets)
		if effects then
			for _, star in ipairs(twinkles) do
				star.Frame.BackgroundTransparency = 0.1 + 0.6 * (0.5 + 0.5 * math.sin(t * 2.2 + star.Phase))
			end
		end
	end)
end

function DreamMachine.Stop(_ctx)
	Zones.Release(UPGRADE_ID)
end

return DreamMachine
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="111">
          <Properties>
            <string name="Name">Email</string>
            <string name="Source"><![CDATA[--[[
	Email (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > Email

	"Dopamail", un vrai petit client mail.

	UNE seule source de vérité : chaque mail de la session (reçu en vol,
	ouvert, raté, réponse d'un correspondant, mail envoyé) est un
	enregistrement du modèle `mails` : dossier (Réception / Envoyés / Spams /
	Corbeille ; "Favoris" = les mails étoilés), lu / non lu, étoile, et état
	de la récompense ("Live" = encore réclamable, "Claimed", "Expired",
	"Missed", "Local" = sans récompense). Le compteur "📬 non lus" du bandeau
	d'actu = le nombre de mails NON LUS de la Réception, et la liste de la
	Réception montre exactement ces mails (les plus récents en premier).

	  - Chaque mail décidé par le SERVEUR (événement Spawn "Email") arrive en
	    vol plané (notification : "DOPAMAIL · maintenant", avatar, étiquette,
	    aperçu, barre de temps). Un clic le réclame (ctx.ClaimSpawn, le
	    serveur valide ; le "+X" confirmé arrive par OnBonus "Email") et
	    l'ouvre. Ignoré, il file vers le compteur mais reste non lu dans la
	    Réception. Tant qu'il est réclamable, la liste l'affiche
	    "🎁 NOUVEAU · +X" : l'ouvrir depuis la liste le réclame exactement
	    comme un clic sur sa notification.
	  - La fenêtre (clic sur le compteur ou sur une notification) : barre de
	    titre (recherche, ✕ rouge bien visible), barre latérale (✏️ Écrire,
	    dossiers avec compteurs, contacts rapides), liste (avatars,
	    étiquettes, heure, étoiles), zone de lecture (bandeaux récompense /
	    arnaque, citation, pièce jointe, Répondre / Transférer / Spam /
	    Supprimer / Pas un spam / Restaurer / Supprimer pour toujours,
	    "Tout lu", "Vider la corbeille") et rédaction (destinataire parmi les
	    personnages, objet, texte). PC / tablette : deux volets ;
	    téléphone : un seul volet avec retour ←.
	  - Le texte tapé passe par le filtre du serveur (RemoteFunction
	    "FilterText", purpose "Mail", appelée dans un task.spawn) : SEUL le
	    texte filtré est affiché (dossier Envoyés) ; en cas d'échec, seul le
	    message d'erreur. Quelques secondes plus tard, le correspondant répond
	    selon les sujets détectés (Topics), une réplique par personnage et par
	    langue.
	  - Fenêtre dans la toile (donc dans la zone sûre, jamais sous les
	    boutons Roblox), sous le bandeau d'actu, fond assombri : un clic
	    dehors la ferme, un clic dedans jamais (UIUtil.SinkClicks). Elle est
	    construite une fois puis réutilisée (lignes de liste recyclées) ; rien
	    n'est animé image par image quand il n'y a ni carte ni fenêtre.
	Plus de 90 mails absurdes (une liste par langue, même ordre) choisis par
	info.Variant.

	v9.1 : mails entre AMIS Roblox (FriendMailService côté serveur).
	  - Rédaction : onglets "🎭 Personnages" / "👥 Amis" ; les amis Roblox
	    (liste du serveur, en cache) avec leur photo et leur statut : sur ce
	    serveur / en ligne ailleurs / hors ligne. Grille "virtuelle" : une
	    petite réserve de pastilles recyclées, même avec 200 amis.
	  - Anti-spam vérifié par le serveur (1 nouveau mail / 10 min, 1 réponse
	    à un mail d'ami / 2 min, gardé d'une partie à l'autre) : compte à
	    rebours sur le bouton Envoyer ("⏳ 7:32").
	  - Envoi : texte d'abord passé par "FilterText" (copie "Envoyés" du
	    joueur, filtrée), puis "FriendMail" ("Send") : le serveur vérifie tout,
	    garde le texte brut pour lui seul et le filtre POUR le destinataire à
	    la livraison. Jamais de réponse automatique : c'est un vrai ami.
	  - Réception : "FriendMailEvent" (et "Inbox" au démarrage) apporte des
	    mails DÉJÀ filtrés pour ce joueur ; étiquette "AMI 💌", photo, dossier
	    "💌 Amis", aucune Dopamine. Répondre, Supprimer, Signaler (caché +
	    expéditeur bloqué, rien n'est envoyé ailleurs), Bloquer.
	  - Studio sans accès aux API : "indisponible dans Studio", rien ne casse.
]]

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")

local Locale = require(ReplicatedStorage.Shared.Locale)
local FriendMailRules = require(ReplicatedStorage.Shared.FriendMailRules)

local Email = {}
Email.Slot = "Overlay"

-- Changement de langue : UN seul écouteur pour le module (Locale.OnChanged
-- ne se débranche pas), qui prévient le Dopamail en cours s'il y en a un
local languageHandler: (() -> ())? = nil
local languageHooked = false

local MAX_ENVELOPES = 4
local CARD_W = 250
local CARD_H = 86
local HURRY_TIME = 3 -- dernières secondes : la carte s'agite
local LOCAL_CARD_LIFE = 9 -- notification d'une réponse de correspondant (sans récompense)
local MAX_RECEIVED = 40 -- mails reçus gardés (hors favoris) : les plus vieux déjà lus sont oubliés
local MAX_SENT = 20
local QUICK_CLOSE = 25 -- mail ouvert depuis sa notification : fermeture auto si on ne touche à rien
local CLAIM_WAIT = 5 -- pas de "+X" du serveur après ce délai : bonus manqué
local SUBJECT_MAX = 60
local BODY_MAX = 300
local SEPARATOR = " — " -- sépare l'objet du texte : UN seul appel au filtre (1 appel / 2 s)
local SEND_TIMEOUT = 12
local REPLY_DELAY_MIN = 3
local REPLY_DELAY_MAX = 6
-- Mails d'amis : envoi plus long (filtre + contrôles + DataStore côté serveur)
local FRIEND_SEND_TIMEOUT = 25
local FRIENDS_REFRESH = 120 -- liste d'amis redemandée au plus toutes les 2 min
local ONLINE_REFRESH = 45 -- amis en ligne (GetFriendsOnline) : au plus toutes les 45 s
local STATUS_REFRESH = 60 -- état anti-spam redemandé au serveur
-- Le cadre du mail passe au-dessus des autres stimuli plein écran (boule
-- disco, pluie d'emojis...) : compteur lisible, cartes et fenêtre cliquables
local RAISED_Z = 1000
-- Place du bloc droit du bandeau d'actu (horloge + segment), si le bandeau
-- ne donne pas l'attribut "RightInset"
local TICKER_RIGHT_FALLBACK = 60
local TICKER_H = 30

-- Tailles de la fenêtre (pixels "design" de la fenêtre, avant sa mise à
-- l'échelle) : "Wide" = PC / tablette (deux volets), "Phone" = un volet.
-- F = points de texte en plus (téléphone : plus lisible)
local LAYOUTS = {
	Wide = { W = 940, H = 540, Title = 48, Side = 184, List = 320, Row = 68, Pad = 16, F = 0 },
	Phone = { W = 660, H = 400, Title = 48, Side = 68, Row = 68, Pad = 14, F = 1 },
}

-- Styles des étiquettes de priorité (texte anglais, traduit avec Locale.T)
local TAGS = {
	URGENT = { Text = "🔴 URGENT", Color = Color3.fromRGB(226, 38, 52) },
	PROMO = { Text = "🏷️ PROMO", Color = Color3.fromRGB(255, 132, 20) },
	SPAM = { Text = "🚫 SPAM", Color = Color3.fromRGB(120, 124, 136) },
	ARNAQUE = { Text = "⚠️ SCAM?", Color = Color3.fromRGB(150, 20, 40) },
	FAMILLE = { Text = "💗 FAMILY", Color = Color3.fromRGB(240, 70, 140) },

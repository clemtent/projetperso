R.VelvetChaise = function(b, ctx)
	local seat = ctx.TopY(1, 38)
	local velvet = b.Map(VELVET)
	local depth = 44
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			b.Cyl(sx * 36, 0, sz * 16, 4, 12, GOLD, M.Metal)
		end
	end
	b.Box(4, 10, 0, 86, 2, depth, GOLD, M.Metal)
	b.Box(4, 12, 0, 86, seat - 20, depth, darken(velvet, 0.3), M.Fabric)
	b.Cushion(6, seat - 9, 0, 84, 10, depth, velvet, M.Fabric)
	-- dossier arrondi, haut à gauche
	b.Round(-38, 12, 0, 22, 64, depth, 10, velvet, M.Fabric)
	b.CylZ(-38, 76, 0, 22, depth, velvet, M.Fabric)
	for row = 0, 3 do
		for _, sz in ipairs({ -12, 0, 12 }) do
			b.Ball(-26.8, 34 + row * 10, sz + (row % 2) * 6, 2.4, darken(velvet, 0.3), M.Fabric)
		end
	end
	pillow(b, -20, seat - 1, 4, 20, 10, 12, rgb(236, 210, 120), 0)
	b.Top(1, 12, seat, 0, 70, depth - 8)
	b.Footprint(90, depth, 87)
end

R.MarbleStatue = function(b, _ctx)
	b.Box(0, 0, 0, 52, 10, 40, MARBLE, M.Marble)
	b.Cyl(0, 10, 0, 34, 38, MARBLE, M.Marble)
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		b.Cyl(math.cos(a) * 16.4, 11, math.sin(a) * 16.4, 2, 36, MARBLE_VEIN, M.Marble)
	end
	b.Box(0, 48, 0, 44, 5, 36, MARBLE, M.Marble)
	-- buste drapé + tête + couronne de laurier
	b.Egg(0, 62, 0, 38, 22, 24, MARBLE, M.Marble)
	b.BoxR(CFrame.new(-8, 62, 11) * CFrame.Angles(0, 0, 0.6), 4, 20, 2, MARBLE_VEIN, M.Marble)
	b.Cyl(0, 68, 0, 11, 10, MARBLE, M.Marble)
	b.Egg(0, 86, 1, 20, 24, 22, MARBLE, M.Marble)
	b.Wedge(0, 83, 12.4, 4, 6, 3, MARBLE, "Front", M.Marble) -- nez
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		b.EggR(CFrame.new(math.cos(a) * 10, 93, 1 + math.sin(a) * 11) * CFrame.Angles(0, -a, 0.5), 3, 6, 2, rgb(210, 190, 120), M.Metal)
	end
	b.Footprint(52, 40, 99)
end

R.KingBed = function(b, ctx)
	local top = ctx.TopY(1, 40)
	local depth = 92
	local walnut = b.Map(WALNUT)
	local duvet = b.Map(rgb(90, 70, 130))
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			b.Cyl(sx * 42, 0, sz * 40, 5, 6, GOLD, M.Metal)
		end
	end
	b.Box(4, 6, 0, 92, 16, depth, walnut, M.Wood)
	b.Box(4, 22, 0, 90, top - 24, depth - 4, WHITE, M.Fabric)
	b.Box(18, top - 8, 0, 62, 9, depth - 2, duvet, M.Fabric)
	b.Box(-15, top - 7.6, 0, 10, 9, depth - 1, rgb(236, 220, 180), M.Fabric)
	b.Box(40, top - 7.2, 0, 16, 9, depth, GOLD, M.Fabric) -- plaid
	-- tête de lit capitonnée haute
	b.Round(-44, 6, 0, 12, 80, depth + 4, 5, rgb(236, 226, 214), M.Fabric)
	for row = 0, 5 do
		for col = -3, 3 do
			b.Ball(-37.6, 22 + row * 10, col * 12 + (row % 2) * 6, 2.4, rgb(196, 180, 164), M.Fabric)
		end
	end
	for _, z in ipairs({ -26, 0, 26 }) do
		b.EggR(CFrame.new(-30, top + 4, z) * CFrame.Angles(0, 0, -0.35), 20, 10, 26, WHITE, M.Fabric)
	end
	b.EggR(CFrame.new(-24, top + 4, -12) * CFrame.Angles(0, 0, -0.3), 14, 9, 20, rgb(236, 220, 180), M.Fabric)
	b.EggR(CFrame.new(-22, top + 3, 12) * CFrame.Angles(0, 0, -0.3), 10, 8, 14, duvet, M.Fabric)
	b.Top(1, 8, top + 1, 0, 74, depth - 12)
	b.Footprint(100, depth + 4, 86)
end

R.PoolTable = function(b, ctx)
	local top = ctx.TopY(1, 56)
	local depth = 64
	local walnut = b.Map(WALNUT)
	for _, x in ipairs({ -38, 0, 38 }) do
		for _, sz in ipairs({ -1, 1 }) do
			b.Box(x, 0, sz * 24, 9, 8, 9, WALNUT_DARK, M.Wood)
			b.Box(x, 8, sz * 24, 7, top - 20, 7, walnut, M.Wood)
			b.Box(x, 22, sz * 24, 7.6, 2, 7.6, GOLD, M.Metal)
		end
	end
	b.Box(0, top - 12, 0, 98, 9, depth, walnut, M.Wood)
	b.Box(0, top - 8.4, depth / 2 + 0.2, 90, 1.4, 0.6, GOLD, M.Metal)
	b.Box(0, top - 3, 0, 86, 2, depth - 12, b.Map(FELT), M.Fabric)
	-- bandes (coussins verts) + cadre bois
	for _, sz in ipairs({ -1, 1 }) do
		b.Box(0, top - 3, sz * (depth / 2 - 4), 86, 4, 4, lighten(FELT, 0.1), M.Fabric)
		b.Box(0, top - 3, sz * (depth / 2 - 1), 98, 5, 2, walnut, M.Wood)
	end
	for _, sx in ipairs({ -1, 1 }) do
		b.Box(sx * 45, top - 3, 0, 4, 4, depth - 12, lighten(FELT, 0.1), M.Fabric)
		b.Box(sx * 48, top - 3, 0, 2, 5, depth - 4, walnut, M.Wood)
	end
	-- poches
	for _, x in ipairs({ -45, 0, 45 }) do
		for _, sz in ipairs({ -1, 1 }) do
			b.Cyl(x, top - 2.9, sz * (depth / 2 - 4), 6, 4.2, IRON_DARK, M.Fabric)
		end
	end
	-- boules en triangle + boule blanche + queue
	local colors = { rgb(240, 200, 40), RED, rgb(40, 90, 200), rgb(30, 30, 30), rgb(120, 50, 150), ORANGE }
	local n = 0
	for row = 0, 2 do
		for k = 0, row do
			n += 1
			b.Ball(20 + row * 3.6, top + 1, (k - row / 2) * 4.2, 4, colors[(n % #colors) + 1], M.SmoothPlastic)
		end
	end
	b.Ball(-20, top + 1, 0, 4, rgb(250, 250, 240), M.SmoothPlastic)
	b.Tube(-24, top + 1.6, 2, -64, top + 6, 10, 1.6, rgb(214, 180, 120), M.Wood)
	b.Top(1, 0, top, 0, 80, depth - 16)
	b.Footprint(98, depth, top + 3)
end

R.AmethystGeode = function(b, _ctx)
	b.Box(0, 0, 0, 48, 10, 34, IRON_DARK, M.Metal)
	b.Box(0, 10, 0, 30, 8, 22, IRON, M.Metal)
	-- coquille de pierre (dos) + bord blanc + cristaux
	b.Egg(0, 54, -6, 70, 76, 30, STONE, M.Slate)
	b.Egg(0, 54, 2, 60, 66, 20, rgb(236, 230, 240), M.SmoothPlastic)
	b.Egg(0, 54, 4, 52, 58, 20, rgb(110, 60, 160), M.SmoothPlastic)
	local purples = { rgb(170, 110, 230), rgb(140, 80, 210), rgb(200, 150, 250), rgb(120, 70, 190) }
	local n = 0
	for row = 0, 4 do
		for col = 0, 3 do
			n += 1
			local x = -15 + col * 10 + (row % 2) * 5
			local y = 34 + row * 10
			local lean = CFrame.Angles(0.5 + (n % 3) * 0.2, 0, (col - 1.5) * 0.3)
			local crystal = b.BoxR(CFrame.new(x, y, 12) * lean, 4, 10, 4, purples[(n % #purples) + 1], M.Glass)
			crystal.Transparency = 0.15
		end
	end
	local heart = glow(b, b.Ball(0, 54, 8, 8, rgb(220, 180, 255), M.Neon))
	b.Light(heart, rgb(200, 150, 250), 10, 0.5)
	b.Footprint(70, 34, 92)
end

R.ModernFireplace = function(b, _ctx)
	local slab = b.Map(rgb(64, 64, 70))
	b.Box(0, 22, 3, 96, 56, 6, slab, M.Slate)
	b.Box(0, 72, 6.5, 96, 6, 1, rgb(90, 90, 96), M.Slate)
	-- foyer : boîte sombre en saillie, cadre inox, vitre
	b.Box(0, 34, 6.5, 84, 28, 1, rgb(20, 18, 22), M.Metal) -- fond du foyer
	b.Box(0, 34, 9, 84, 1.6, 5, rgb(30, 28, 32), M.Metal) -- sole
	b.Box(0, 60.4, 9, 84, 1.6, 5, rgb(30, 28, 32), M.Metal) -- linteau
	for _, x in ipairs({ -41.2, 41.2 }) do
		b.Box(x, 35.6, 9, 1.6, 24.8, 5, rgb(30, 28, 32), M.Metal)
	end
	for _, y in ipairs({ 33, 62 }) do
		b.Box(0, y, 11.4, 88, 1.4, 1, STEEL, M.Metal)
	end
	for _, x in ipairs({ -43.3, 43.3 }) do
		b.Box(x, 33, 11.4, 1.4, 30.4, 1, STEEL, M.Metal)
	end
	for k = 0, 9 do
		b.Egg(-36 + k * 8, 37.4, 9, 8, 4, 5, k % 2 == 0 and rgb(200, 196, 190) or rgb(150, 146, 144), M.Pebble)
	end
	local first = nil
	for k = 0, 7 do
		local flame = glow(b, b.Egg(-32 + k * 9, 44 + (k % 3), 8.4, 6, 12 + (k % 3) * 2, 3, k % 2 == 0 and FIRE or rgb(255, 200, 80), M.Neon))
		first = first or flame
	end
	glass(b.Box(0, 34.6, 11.2, 84, 27, 0.4, GLASS, M.Glass), 0.85)
	if first then
		b.Light(first, FIRE, 14, 0.8)
	end
	b.Footprint(96, 12, 100)
end

R.CinemaRecliners = function(b, ctx)
	local seat = ctx.TopY(1, 38)
	local leather = b.Map(rgb(170, 40, 50))
	local depth = 56
	b.Box(0, 0, 0, 98, 6, depth, IRON_DARK, M.Metal)
	glow(b, b.Box(0, 1, depth / 2 + 0.3, 92, 1.4, 0.6, AMBER, M.Neon))
	for index = -1, 1 do
		local x = index * 32
		b.Box(x, 6, 2, 26, seat - 16, depth - 8, darken(leather, 0.2), M.Leather)
		b.Cushion(x, seat - 10, 4, 26, 10, depth - 14, leather, M.Leather)
		b.BoxR(CFrame.new(x, seat + 14, -depth / 2 + 8) * CFrame.Angles(-0.25, 0, 0), 26, 36, 10, leather, M.Leather)
		b.BoxR(CFrame.new(x, seat + 16, -depth / 2 + 13.5) * CFrame.Angles(-0.25, 0, 0), 18, 16, 2, darken(leather, 0.15), M.Leather)
		-- repose-pieds déplié
		b.BoxR(CFrame.new(x, seat - 16, depth / 2 + 4) * CFrame.Angles(0.5, 0, 0), 22, 4, 18, darken(leather, 0.2), M.Leather)
	end
	for index = 0, 3 do
		local x = -48 + index * 32
		b.Box(x, 6, 2, 6, seat - 2, depth - 8, rgb(40, 36, 40), M.Leather)
		b.Cyl(x, seat + 4, 14, 5, 1.4, IRON, M.Metal) -- porte-gobelet
	end
	-- pot de pop-corn dans un porte-gobelet
	b.Cyl(16, seat + 5, 14, 5, 8, WHITE, M.SmoothPlastic)
	b.Cyl(16, seat + 5, 14, 5.2, 3, RED, M.SmoothPlastic)
	for k = 0, 3 do
		b.Ball(15 + (k % 2) * 2, seat + 13.5 + math.floor(k / 2), 13 + k % 2, 3, rgb(255, 240, 190), M.SmoothPlastic)
	end
	b.Top(1, 0, seat, 4, 90, depth - 20)
	b.Seat(0, seat, 4, 22, depth - 20)
	b.Footprint(100, depth + 12, seat + 32)
end

R.WhitePiano = function(b, _ctx)
	local lacquer = b.Map(rgb(248, 248, 252))
	-- caisse (côté droit arrondi = la queue du piano)
	b.Box(-12, 34, 0, 70, 20, 54, lacquer, M.SmoothPlastic)
	b.Cyl(22, 34, -6, 44, 20, lacquer, M.SmoothPlastic)
	b.Box(-12, 36, 27.2, 60, 1.2, 0.6, GOLD, M.Metal)
	-- pieds dorés
	for _, spec in ipairs({ { -40, 20 }, { -40, -20 }, { 34, -10 } }) do
		b.Cyl(spec[1], 0, spec[2], 8, 34, lacquer, M.SmoothPlastic)
		b.Cyl(spec[1], 0, spec[2], 9, 3, GOLD, M.Metal)
	end
	-- clavier
	b.Box(-12, 50, 30, 64, 4, 10, lacquer, M.SmoothPlastic)
	b.Box(-12, 54, 30, 60, 1.6, 9, WHITE, M.SmoothPlastic)
	for k = 0, 13 do
		if k % 7 ~= 2 and k % 7 ~= 6 then
			b.Box(-40 + k * 4.2, 55.6, 28, 2, 1.4, 5, rgb(30, 30, 36), M.SmoothPlastic)
		end
	end
	b.Box(-12, 56, 25, 64, 8, 2, lacquer, M.SmoothPlastic) -- pupitre
	b.BoxR(CFrame.new(-12, 62, 22) * CFrame.Angles(-0.25, 0, 0), 30, 12, 1.2, rgb(250, 244, 226), M.SmoothPlastic) -- partition
	-- couvercle ouvert + béquille
	-- (charnière le long du côté gauche, soulevé à droite par la béquille)
	local lift = 0.4
	b.BoxR(CFrame.new(-47 + 45 * math.cos(lift), 54 + 45 * math.sin(lift), -2) * CFrame.Angles(0, 0, lift), 90, 2, 56, lacquer, M.SmoothPlastic)
	b.Tube(26, 54, -4, 26, 53 + 73 * math.tan(lift), -4, 1.6, GOLD, M.Metal)
	-- lyre + pédales
	b.Box(-12, 6, 20, 10, 28, 4, lacquer, M.SmoothPlastic)
	for k = -1, 1 do
		b.Box(-12 + k * 4, 3, 24, 2.4, 1.6, 6, GOLD, M.Metal)
	end
	b.Footprint(100, 60, 94)
end

R.Jacuzzi = function(b, _ctx)
	local shell = b.Map(rgb(236, 230, 220))
	local rimTop = 38
	b.Cyl(0, 0, 0, 96, 28, shell, M.Marble)
	glow(b, b.Cyl(0, 14, 0, 96.6, 1.2, CYAN, M.Neon))
	-- fond clair + eau transparente bleue (on voit dedans)
	b.Cyl(0, 28, 0, 88, 0.6, rgb(190, 225, 240), M.SmoothPlastic)
	local water = glass(b.Cyl(0, 28.6, 0, 88, 6.4, b.Map(WATER), M.Glass), 0.35)
	b.Light(water, CYAN, 12, 0.5)
	-- margelle : anneau de 16 segments (extérieur 100, intérieur 88)
	local segments = 16
	for k = 0, segments - 1 do
		local angle = (k + 0.5) / segments * math.pi * 2
		local r = 47
		local chord = 2 * 50 * math.sin(math.pi / segments) + 0.4
		b.BoxR(CFrame.new(math.cos(angle) * r, 28 + (rimTop - 28) / 2, math.sin(angle) * r) * CFrame.Angles(0, -angle, 0), 6, rimTop - 28, chord,
			lighten(shell, 0.05), M.Marble)
	end
	-- bulles à la surface
	for k = 0, 13 do
		local a = k * 2.39996
		local r = 8 + (k * 7) % 30
		glass(b.Ball(math.cos(a) * r, 35.2 + (k % 3) * 0.5, math.sin(a) * r, 3 + k % 3, WHITE, M.Glass), 0.3)
	end
	-- marches, serviettes roulées, bougie
	b.Box(0, 0, 50, 36, 10, 12, lighten(shell, 0.05), M.Marble)
	b.CylX(30, rimTop + 4, 30, 8, 16, WHITE, M.Fabric)
	b.CylX(30, rimTop + 11, 30, 7, 14, rgb(160, 210, 230), M.Fabric)
	b.Cyl(-32, rimTop, 30, 5, 7, rgb(250, 240, 220), M.SmoothPlastic)
	glow(b, b.Ball(-32, rimTop + 8.4, 30, 2.4, FIRE, M.Neon))
	b.Seat(0, 30, -16, 40, 26)
	b.Footprint(100, 100, rimTop)
end

R.AquariumWall = function(b, _ctx)
	local depth = 36
	local frame = b.Map(IRON_DARK)
	-- (v9.8 z-fighting : le dos recule d'une unité, il ne touche plus le mur de la pièce)
	b.Box(0, 0, 0.5, 98, 14, depth - 1, b.Map(rgb(80, 64, 50)), M.Wood)
	b.Box(0, 14, 0.5, 98, 4, depth - 1, frame, M.Metal)
	b.Box(0, 94, 0.5, 98, 6, depth - 1, frame, M.Metal)
	for _, sx in ipairs({ -1, 1 }) do
		b.Box(sx * 47, 18, 0.5, 4, 76, depth - 1, frame, M.Metal)
	end
	-- eau + fond + sable
	b.Box(0, 18, -depth / 2 + 2, 90, 76, 2, WATER_DEEP, M.SmoothPlastic)
	glass(b.Box(0, 18, 0, 90, 76, depth - 4, b.Map(WATER), M.Glass), 0.55)
	b.Box(0, 18, 0, 89, 6, depth - 5, rgb(236, 214, 160), M.Sand)
	-- coraux, algues, rochers
	for index, s in ipairs({ { -32, rgb(255, 110, 120) }, { -14, rgb(255, 170, 80) }, { 16, rgb(200, 110, 230) }, { 34, rgb(255, 130, 160) } }) do
		for k = 0, 2 do
			b.Tube(s[1], 24, -4 + k * 3, s[1] + (k - 1) * 5, 38 + k * 2, -2 + k * 2, 2.4, s[2], M.SmoothPlastic)
			b.Ball(s[1] + (k - 1) * 5, 38 + k * 2, -2 + k * 2, 4, s[2], M.SmoothPlastic)
		end
		local _ = index
	end
	for _, x in ipairs({ -24, 4, 26 }) do
		b.EggR(CFrame.new(x, 44, -8) * CFrame.Angles(0, 0, 0.1), 5, 40, 2, LEAF, M.SmoothPlastic)
	end
	b.Egg(-4, 26, 0, 16, 10, 12, STONE_DARK, M.Rock)
	fish(b, -22, 72, 4, 12, rgb(255, 150, 40), 1)
	fish(b, 18, 62, 2, 10, rgb(255, 220, 60), -1)
	fish(b, -2, 50, 6, 14, rgb(60, 140, 255), 1)
	fish(b, 30, 82, -2, 9, rgb(255, 100, 140), -1)
	fish(b, -34, 54, -4, 8, WHITE, -1)
	-- lumière douce au-dessus de l'eau
	local lamp = glow(b, b.Box(0, 92.6, 0, 80, 1.2, 8, rgb(200, 240, 255), M.Neon))
	b.Light(lamp, rgb(170, 230, 255), 14, 0.6)
	b.Footprint(98, depth, 100)
end

R.RollercoasterModel = function(b, _ctx)
	b.Round(0, 0, 0, 98, 6, 56, 5, rgb(60, 140, 90), M.Grass)
	local red = b.Map(RED)
	-- rail (chemin de tubes) : montée, descente, looping, virage
	local rail: { { number } } = {
		{ -44, 12, 16 }, { -34, 36, 14 }, { -24, 64, 10 }, { -16, 70, 6 }, { -8, 60, 2 }, { 0, 40, 0 }, { 8, 24, -2 }, { 18, 20, -4 },
	}
	-- looping (cercle vertical dans le plan x-y)
	for k = 0, 10 do
		local a = -math.pi / 2 + k / 10 * math.pi * 2
		table.insert(rail, { 28 + math.cos(a) * 12, 34 + math.sin(a) * 14, -6 - k * 0.8 })
	end
	table.insert(rail, { 40, 22, -18 })
	table.insert(rail, { 44, 26, -6 })
	table.insert(rail, { 38, 30, 10 })
	House3DKit.Path(b, rail, 2.6, red, M.Metal)
	-- piliers blancs
	for _, p in ipairs({ { -34, 36, 14 }, { -24, 64, 10 }, { -8, 60, 2 }, { 8, 24, -2 }, { 40, 22, -18 }, { 38, 30, 10 } }) do
		b.Cyl(p[1], 6, p[3], 2, p[2] - 7, rgb(236, 236, 244), M.Metal)
	end
	-- 3 wagonnets dans la descente
	for k = 0, 2 do
		local t = k * 0.28
		local x, y, z = -8 + t * 12, 60 - t * 50 + 3, 2 - t * 3
		b.BoxR(CFrame.new(x, y, z) * CFrame.Angles(0, 0, -1.1), 7, 5, 6, k == 0 and rgb(255, 214, 60) or rgb(60, 160, 255), M.SmoothPlastic)
	end
	-- gare + drapeau
	b.Box(-40, 6, 20, 16, 10, 12, rgb(255, 230, 180), M.Wood)
	b.Wedge(-40, 16, 20, 18, 6, 14, rgb(236, 72, 120), "Front", M.SmoothPlastic)
	b.Cyl(46, 6, 22, 1.2, 30, IRON, M.Metal)
	b.Box(49, 30, 22, 6, 4, 0.6, rgb(255, 214, 60), M.Fabric)
	b.Footprint(98, 56, 76)
end

R.GoldThrone = function(b, ctx)
	local seat = ctx.TopY(1, 42)
	local gold = b.Map(GOLD)
	local velvet = b.Map(rgb(170, 30, 50))
	local depth = 44
	b.Box(0, 0, 0, 76, 6, depth + 16, GOLD_DARK, M.Metal) -- estrade
	b.Box(0, 6, 0, 60, seat - 18, depth, gold, M.Metal)
	b.Cushion(0, seat - 12, 4, 54, 12, depth - 8, velvet, M.Fabric)
	-- dossier haut + velours + joyau
	b.Round(0, 6, -depth / 2 + 5, 54, 92, 10, 4, gold, M.Metal)
	b.Box(0, seat + 6, -depth / 2 + 10.4, 38, 42, 1, velvet, M.Fabric)
	b.BoxR(CFrame.new(0, seat + 32, -depth / 2 + 11.4) * CFrame.Angles(0, 0, math.pi / 4), 6, 6, 1, rgb(255, 80, 120), M.Glass)
	-- couronne en haut du dossier
	for k = -1, 1 do
		b.Wedge(k * 13 - 3, 98, -depth / 2 + 5, 6, 10, 8, gold, "Left", M.Metal)
		b.Wedge(k * 13 + 3, 98, -depth / 2 + 5, 6, 10, 8, gold, "Right", M.Metal)
		b.Ball(k * 13, 108, -depth / 2 + 5, 4, rgb(236, 72, 100), M.Glass)
	end
	-- accoudoirs + têtes de lion + pieds griffes
	for _, sx in ipairs({ -1, 1 }) do
		b.Box(sx * 32, 6, 0, 10, seat + 12, depth, gold, M.Metal)
		b.Ball(sx * 32, seat + 16, depth / 2 - 2, 14, GOLD_LIGHT, M.Metal)
		b.Ball(sx * 32, seat + 14, depth / 2 + 4, 5, GOLD_DARK, M.Metal)
		for _, sz in ipairs({ -1, 1 }) do
			b.Ball(sx * 30, 8, sz * (depth / 2 - 2), 10, GOLD_LIGHT, M.Metal)
		end
	end
	b.Top(1, 0, seat, 4, 40, depth - 12)
	b.Seat(0, seat, 4, 40, depth - 12)
	b.Footprint(76, depth + 16, 112)
end

R.IndoorWaterfall = function(b, _ctx)
	local depth = 40
	-- mur de pierres
	b.Box(0, 16, -depth / 2 + 6, 84, 80, 12, STONE, M.Slate)
	for index, s in ipairs({ { -30, 86, 20 }, { 24, 88, 22 }, { -26, 60, 18 }, { 30, 62, 20 }, { -32, 34, 20 }, { 28, 34, 18 } }) do
		b.EggR(CFrame.new(s[1], s[2], -depth / 2 + 13) * CFrame.Angles(0, 0, index * 0.5), s[3], 14, 8, index % 2 == 0 and STONE_DARK or rgb(170, 164, 156), M.Rock)
	end
	-- déversoir + nappe d'eau
	b.Box(0, 92, -depth / 2 + 14, 36, 3, 8, STEEL, M.Metal)
	glass(b.Box(0, 20, -depth / 2 + 16, 32, 72, 1.2, b.Map(WATER), M.Glass), 0.35)
	for k = 0, 4 do
		glass(b.Box(-12 + k * 6, 22, -depth / 2 + 17.2, 1.4, 68, 0.4, rgb(200, 240, 255), M.Glass), 0.3)
	end
	-- bassin de pierre + eau + remous
	b.Round(0, 0, 4, 98, 16, depth - 4, 8, STONE_DARK, M.Slate)
	local pool = glass(b.Round(0, 14, 4, 90, 3, depth - 10, 6, b.Map(WATER), M.Glass), 0.3)
	for k = 0, 4 do
		glass(b.Egg(-10 + k * 5, 17.4, -depth / 2 + 18 + (k % 2) * 3, 8, 2, 5, WHITE, M.Glass), 0.3)
	end
	b.Light(pool, rgb(170, 230, 255), 12, 0.5)
	-- fougères de chaque côté
	for _, sx in ipairs({ -1, 1 }) do
		for k = 0, 3 do
			b.EggR(CFrame.new(sx * 40, 24 + k * 4, 8 + (k % 2) * 6) * CFrame.Angles(0.4, sx * k * 0.8, sx * (0.6 - k * 0.2)), 8, 24, 1.6,
				k % 2 == 0 and LEAF or LEAF_DARK, M.SmoothPlastic)
		end
	end
	b.Footprint(98, depth, 96)
end

R.CapsuleBed = function(b, _ctx)
	local shell = b.Map(rgb(240, 242, 248))
	local depth = 70
	b.Round(0, 0, 0, 90, 8, depth - 10, 6, IRON, M.Metal)
	b.Round(0, 8, 0, 98, 18, depth, 12, shell, M.SmoothPlastic)
	glow(b, b.Box(0, 24, depth / 2 + 0.3, 80, 1.2, 0.6, CYAN, M.Neon))
	-- matelas + couette + oreiller
	b.Box(0, 26, 0, 88, 8, depth - 8, rgb(200, 210, 240), M.Fabric)
	b.Box(14, 30, 0, 58, 6, depth - 6, b.Map(rgb(90, 120, 220)), M.Fabric)
	b.EggR(CFrame.new(-32, 38, 0) * CFrame.Angles(0, 0, -0.3), 16, 8, 30, WHITE, M.Fabric)
	-- coque : arceaux au-dessus (fond fermé, avant en verre)
	for k = 0, 8 do
		local a = k / 8 * math.pi
		local x, y = math.cos(a) * 46, 26 + math.sin(a) * 40
		b.BoxR(CFrame.new(x, y, -depth / 2 + 3) * CFrame.Angles(0, 0, a), 4, 18, 6, shell, M.SmoothPlastic)
	end
	b.Box(0, 26, -depth / 2 + 1.5, 86, 36, 3, rgb(40, 50, 90), M.SmoothPlastic)
	for k = 0, 7 do
		glow(b, b.Ball(-30 + (k * 17) % 60, 44 + (k * 11) % 16, -depth / 2 + 3.2, 1.6, WHITE, M.Neon))
	end
	-- verrière (demi-coque transparente)
	local canopy = glass(b.EggR(CFrame.new(0, 26, 2), 96, 84, depth - 8, rgb(190, 220, 255), M.Glass), 0.75)
	local _ = canopy
	-- panneau de contrôle
	b.Box(40, 30, depth / 2 - 6, 10, 16, 4, IRON_DARK, M.SmoothPlastic)
	for k = 0, 2 do
		glow(b, b.CylZ(40, 34 + k * 4, depth / 2 - 3.8, 2.4, 0.6, ({ RED, CYAN, LIME })[k + 1], M.Neon))
	end
	b.Seat(0, 34, 0, 50, 36)
	b.Footprint(98, depth, 68)
end

R.DragonStatue = function(b, _ctx)
	local gold = b.Map(GOLD)
	b.Round(0, 0, 0, 80, 10, 50, 6, rgb(60, 50, 50), M.Marble)
	b.Round(0, 10, 0, 68, 4, 40, 5, GOLD_DARK, M.Metal)
	-- corps enroulé (anneaux de boules)
	local coil = { { -24, 22, 6, 20 }, { -10, 20, 12, 22 }, { 8, 20, 10, 22 }, { 22, 24, 2, 20 }, { 18, 34, -8, 18 }, { 4, 40, -10, 18 }, { -8, 46, -4, 16 },
		{ -6, 58, 2, 15 }, { 0, 68, 4, 14 } }
	for index, s in ipairs(coil) do
		b.Ball(s[1], s[2], s[3], s[4], index % 2 == 0 and gold or lighten(gold, 0.08), M.Foil)
		-- écailles dorsales
		b.Wedge(s[1], s[2] + s[4] * 0.42, s[3], 3, 5, 5, GOLD_DARK, "Front", M.Metal)
	end
	-- queue
	b.Tube(-24, 22, 6, -40, 16, 14, 7, gold, M.Foil)
	b.Wedge(-44, 14, 16, 8, 6, 3, GOLD_DARK, "Left", M.Metal)
	-- ailes (membranes fines + nervures)
	for _, sx in ipairs({ -1, 1 }) do
		for k = 0, 2 do
			b.Tube(sx * 6, 56, -6, sx * (22 + k * 8), 88 - k * 12, -10 - k * 4, 2, GOLD_DARK, M.Metal)
		end
		b.BoxR(CFrame.new(sx * 20, 72, -10) * CFrame.Angles(0.2, 0, sx * -0.9), 26, 30, 1, gold, M.Foil)
	end
	-- tête, cornes, yeux, moustaches
	b.Egg(4, 80, 10, 18, 14, 22, gold, M.Foil)
	b.Egg(4, 76, 22, 12, 9, 12, lighten(gold, 0.1), M.Foil)
	for _, sx in ipairs({ -1, 1 }) do
		b.Tube(4 + sx * 5, 86, 4, 4 + sx * 10, 96, -6, 2.4, GOLD_LIGHT, M.Metal)
		glow(b, b.Ball(4 + sx * 6, 82, 18, 3, RED, M.Neon))
		b.Tube(4 + sx * 4, 74, 26, 4 + sx * 18, 70, 34, 1, GOLD_LIGHT, M.Metal)
	end
	-- perle
	local pearl = b.Ball(32, 42, 20, 14, rgb(240, 236, 255), M.Glass)
	pearl.Transparency = 0.05
	b.Light(pearl, rgb(255, 236, 180), 8, 0.4)
	b.Footprint(80, 50, 98)
end

R.AquariumTunnel = function(b, _ctx)
	local depth = 64
	local frame = b.Map(IRON_DARK)
	local radius = 40
	local band = 12
	-- sol du passage
	b.Box(0, 0, 0, 100, 3, depth, rgb(70, 72, 84), M.Slate)
	b.Box(0, 3, 0, 40, 0.6, depth, rgb(90, 100, 120), M.Slate)
	-- arche : bande d'eau (verre bleu) entre deux arceaux métalliques
	local segments = 12
	for k = 0, segments - 1 do
		local a = (k + 0.5) / segments * math.pi
		local r = radius + band / 2
		local x, y = math.cos(a) * r, 3 + math.sin(a) * r
		local cf = CFrame.new(x, y, 0) * CFrame.Angles(0, 0, a)
		local width = 2 * r * math.sin(math.pi / segments / 2) * 2 + 0.6
		glass(b.BoxR(cf, band, width, depth - 4, b.Map(WATER), M.Glass), 0.45)
		for _, sz in ipairs({ -1, 1 }) do
			b.BoxR(CFrame.new(x, y, sz * (depth / 2 - 1)) * CFrame.Angles(0, 0, a), band + 2, width, 2, frame, M.Metal)
		end
	end
	-- pieds de l'arche
	for _, sx in ipairs({ -1, 1 }) do
		b.Box(sx * (radius + band / 2), 0, 0, band + 4, 4, depth, frame, M.Metal)
	end
	-- vie marine dans la bande d'eau
	local sea = { { 150, 0.3, rgb(255, 150, 40), 1 }, { 30, 0.5, rgb(255, 220, 60), -1 }, { 100, 0.9, rgb(60, 140, 255), 1 }, { 60, 0.15, rgb(255, 100, 140), -1 },
		{ 120, 0.7, WHITE, 1 }, { 20, 0.2, rgb(255, 170, 80), -1 } }
	for index, s in ipairs(sea) do
		local a = math.rad(s[1])
		local r = radius + band / 2
		fish(b, math.cos(a) * r, 3 + math.sin(a) * r, (s[2] - 0.5) * (depth - 16), 8, s[3], s[4])
		local _ = index
	end
	-- raie manta au sommet
	local top = 3 + radius + band / 2
	b.BoxR(CFrame.new(0, top, 6) * CFrame.Angles(0, math.pi / 4, 0), 12, 1.4, 12, rgb(60, 70, 110), M.SmoothPlastic)
	b.Tube(0, top, 6, 0, top, -8, 1, rgb(60, 70, 110), M.SmoothPlastic)
	-- lumière bleue douce
	local light = glow(b, b.Box(0, 3.6, 0, 4, 0.4, depth - 8, rgb(140, 220, 255), M.Neon))
	b.Light(light, rgb(150, 220, 255), 16, 0.6)
	b.Footprint(100, depth, top + band / 2)
end

----------------------------------------------------------------------
-- Branchement (House3DRecipes.loadFamilies("House3DLuxe"))
----------------------------------------------------------------------

function House3DLuxe.Has(itemId: string): boolean
	return R[itemId] ~= nil
end

function House3DLuxe.Register(recipes: { [string]: any }, _family: { [string]: any }, _helpers: any, _flags: any)
	for id, recipe in pairs(R) do
		if recipes[id] == nil then
			recipes[id] = recipe
		end
	end
end

return House3DLuxe
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">House3DObjects</string>
              <string name="Source"><![CDATA[--[[
	House3DObjects (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > House3DObjects

	(v9.3) Recettes 3D des objets de déco, lumières, portes, fenêtres et
	plantes qui n'avaient pas de vrai modèle : chaque objet est une petite
	maquette en vraies pièces (blocs, ovales, tubes, pentes, néons) aux
	couleurs de son dessin 2D. Les objets muraux sont construits contre le
	mur (z = 0 = le mur, +z vers la pièce ; y = 0..100 = leur boîte 2D).

	Branché par House3DRecipes (Register) ; voir House3DToys pour les jouets,
	l'électronique, la cuisine, le sport.
]]

local House3DKit = require(script.Parent.House3DKit)
-- (v9.9 SCALE99) aiguilles à l'heure réelle
local House3DTime = require(script.Parent.House3DTime)

type Builder = House3DKit.Builder

local House3DObjects = {}

local M = Enum.Material
local rgb = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)
local INK = rgb(60, 44, 66)
local GOLD = rgb(245, 190, 60)
local BUTTER = rgb(255, 226, 130)
local GLASS = rgb(200, 235, 255)
local LEAF = rgb(110, 196, 110)
local WOOD = rgb(214, 164, 120)
local darken = House3DKit.Darken
local lighten = House3DKit.Lighten

local R: { [string]: (b: Builder, ctx: any) -> () } = {}
local H: any = nil -- aides de House3DRecipes (Register)

local function vivid(b: Builder, n: number, fallback: Color3): Color3
	local count = 0
	for _, color in ipairs(b.Pal) do
		local _h, s, v = color:ToHSV()
		if s > 0.2 and v > 0.35 then
			count += 1
			if count == n then
				return color
			end
		end
	end
	return b.Map(fallback)
end

----------------------------------------------------------------------
-- DÉCO MURALE
----------------------------------------------------------------------

R.HeartSticker = function(b, _ctx)
	local pink = vivid(b, 1, rgb(255, 110, 160))
	House3DKit.Heart(b, 0, 50, 0, 84, 3, lighten(pink, 0.5), M.SmoothPlastic)
	House3DKit.Heart(b, 0, 51, 2, 70, 3, pink, M.SmoothPlastic)
	b.Egg(-16, 62, 5, 12, 8, 2, WHITE, M.SmoothPlastic)
	b.Footprint(84, 6, 90)
end

R.GiantBow = function(b, _ctx)
	local ribbon = vivid(b, 1, rgb(255, 110, 160))
	for _, side in ipairs({ -1, 1 }) do
		b.EggR(CFrame.new(side * 22, 58, 8) * CFrame.Angles(0, 0, side * 0.35), 44, 32, 14, ribbon, M.Fabric)
		b.EggR(CFrame.new(side * 22, 58, 12) * CFrame.Angles(0, 0, side * 0.35), 24, 14, 10, darken(ribbon, 0.2), M.Fabric)
		b.BoxR(CFrame.new(side * 12, 28, 6) * CFrame.Angles(0, 0, side * -0.3), 12, 40, 5, ribbon, M.Fabric)
		b.Part("WedgePart", CFrame.new(side * 17, 7, 6) * CFrame.Angles(0, math.pi / 2, math.pi), Vector3.new(5, 8, 12), ribbon, M.Fabric, "Pointe")
	end
	b.Egg(0, 58, 14, 18, 20, 14, lighten(ribbon, 0.15), M.Fabric)
	b.Footprint(96, 22, 90)
end

R.Balloons = function(b, _ctx)
	local colors = { vivid(b, 1, rgb(255, 120, 160)), vivid(b, 2, rgb(120, 190, 255)), vivid(b, 3, rgb(255, 214, 90)), vivid(b, 4, rgb(170, 140, 255)) }
	local spots = { { -18, 70, 10 }, { 14, 76, 14 }, { -2, 88, 6 }, { 24, 58, 8 }, { -26, 52, 14 } }
	for index, p in ipairs(spots) do
		local color = colors[(index - 1) % #colors + 1]
		b.Egg(p[1], p[2], p[3], 24, 30, 24, color, M.SmoothPlastic)
		b.Egg(p[1] - 5, p[2] + 7, p[3] + 10, 5, 8, 3, lighten(color, 0.6), M.SmoothPlastic)
		b.Cyl(p[1], p[2] - 17, p[3], 4, 3, darken(color, 0.1), M.SmoothPlastic)
		b.Tube(p[1], p[2] - 16, p[3], 0, 10, 8, 0.8, WHITE, M.SmoothPlastic)
	end
	b.EggR(CFrame.new(0, 10, 8), 8, 6, 6, colors[1], M.Fabric)
	b.Footprint(80, 30, 100)
end

-- Guirlande de fanions / d'étoiles / de lunes : une corde et des motifs
local function garland(kind: string)
	return function(b: Builder, _ctx: any)
		local colors = { vivid(b, 1, rgb(255, 120, 160)), vivid(b, 2, rgb(120, 200, 255)), vivid(b, 3, rgb(255, 214, 90)), vivid(b, 4, rgb(140, 220, 150)) }
		local count = kind == "Flags" and 9 or 7
		local points = {}
		for index = 0, count do
			local t = index / count
			table.insert(points, { -48 + t * 96, 78 - math.sin(t * math.pi) * 20, 3 })
		end
		House3DKit.Path(b, points, 1.4, kind == "Stars" and GOLD or rgb(240, 230, 220), M.SmoothPlastic)
		for index = 1, count - 1 do
			local p = points[index + 1]
			local color = colors[index % #colors + 1]
			if kind == "Flags" then
				House3DKit.Triangle(b, p[1], p[2] - 9, 2.5, 10, 16, math.pi, 1.5, color, M.Fabric)
			elseif kind == "Stars" then
				local star = b.Part("Part", CFrame.new(p[1], p[2] - 6, 4), Vector3.new(0.1, 0.1, 0.1), color, M.SmoothPlastic, "Accroche")
				star.Transparency = 1
				House3DKit.StarSoft(b, p[1], p[2] - 9, 2.5, 8, 2, index % 2 == 0 and BUTTER or color, M.Neon)
			else
				-- lunes : un disque et un disque "mangeur" couleur du mur
				local moon = b.CylZ(p[1], p[2] - 9, 3.5, 12, 2, BUTTER, M.SmoothPlastic)
				moon.Material = M.Neon
				b.CylZ(p[1] + 4, p[2] - 7, 4.8, 10, 1, lighten(color, 0.4), M.SmoothPlastic)
				b.Tube(p[1], p[2], 3, p[1], p[2] - 4, 3, 0.6, WHITE, M.SmoothPlastic)
			end
		end
		b.Footprint(100, 6, 100)
	end
end
R.PartyBunting = garland("Flags")
R.StarGarland = garland("Stars")
R.MoonGarland = garland("Moons")

R.PhotoString = function(b, _ctx)
	local points = {}
	for index = 0, 8 do
		local t = index / 8
		table.insert(points, { -48 + t * 96, 80 - math.sin(t * math.pi) * 14, 3 })
	end
	House3DKit.Path(b, points, 1.2, rgb(200, 160, 120), M.SmoothPlastic)
	local colors = { vivid(b, 1, rgb(255, 170, 200)), vivid(b, 2, rgb(140, 200, 255)), vivid(b, 3, rgb(255, 214, 120)), vivid(b, 4, rgb(150, 220, 170)) }
	for index = 1, 4 do
		local p = points[index * 2]
		local tilt = (index % 2 == 0 and 1 or -1) * 0.12
		local cf = CFrame.new(p[1], p[2] - 13, 3.5) * CFrame.Angles(0, 0, tilt)
		b.BoxR(cf, 17, 20, 1, WHITE)
		b.BoxR(cf * CFrame.new(0, 2, 0.6), 13, 12, 0.5, colors[index])
		b.BoxR(cf * CFrame.new(0, 10, 0.9), 3, 5, 1, rgb(200, 150, 110), M.Wood)
	end
	b.Footprint(100, 6, 100)
end

-- (v9.8) VRAI miroir : cadre en cœur (deux épaisseurs), glace en cœur
-- réfléchissante et, au centre, la surface "Mirror" (ovale) taguée pour les
-- reflets en temps réel de REALISM98 ; perles autour, attache
R.HeartMirror = function(b, _ctx)
	local frame = vivid(b, 1, rgb(255, 150, 190))
	local g = House3DKit.Gap(b, 0.8)
	House3DKit.Heart(b, 0, 50, 0, 90, 4, frame, M.SmoothPlastic)
	House3DKit.Heart(b, 0, 50.4, 4, 82, g, lighten(frame, 0.25), M.SmoothPlastic)
	local before = #b.Parts
	House3DKit.Heart(b, 0, 51, 4 + g, 72, 2, rgb(214, 228, 238), M.Glass)
	for index = before + 1, #b.Parts do
		b.Parts[index].Reflectance = 0.45
		b.Parts[index].CastShadow = false
	end
	House3DKit.Mirror(b, 0, 53, 6 + g + 0.4, 44, 40, "Oval")
	for index, p in ipairs(House3DKit.HeartPoints(0, 50, 5, 90, 14)) do
		if index <= 14 then
			b.Ball(p[1], p[2], 5, 5, index % 2 == 0 and GOLD or WHITE, M.SmoothPlastic).Reflectance = index % 2 == 0 and 0.3 or 0.1
		end
	end
	b.Ball(0, 90, 2, 5, GOLD, M.Metal)
	b.Footprint(90, 8, 90)
end

-- (v9.8) Grand miroir mural en arche : moulure dorée en relief (montants,
-- arc, filet intérieur), glace pleine hauteur taguée "Mirror" (rectangle +
-- arc réfléchissant), tablette basse, attaches
R.BigWallMirror = function(b, _ctx)
	local frame = vivid(b, 1, rgb(230, 190, 110))
	local g = House3DKit.Gap(b, 0.8)
	local w, y0, yArc = 56, 6, 64
	-- glace : partie droite = surface Mirror (Rect), arc = verre réfléchissant
	House3DKit.Mirror(b, 0, (y0 + yArc) / 2, 2 + g, w, yArc - y0, "Rect")
	local arc = b.CylZ(0, yArc, 2 - g / 2, w, g, rgb(214, 228, 238), M.Glass)
	arc.Reflectance = 0.45
	arc.CastShadow = false
	b.Box(0, y0, 0.5, w + 2, yArc - y0, 1, darken(frame, 0.5), M.SmoothPlastic)
	-- cadre mouluré
	for _, side in ipairs({ -1, 1 }) do
		b.Box(side * (w / 2 + 3), y0 - 2, 2, 6, yArc - y0 + 2, 6, frame, M.Metal)
		b.Box(side * (w / 2 + 0.6), y0, 3.4 + g, 1.2, yArc - y0, 2, lighten(frame, 0.25), M.Metal)
	end
	local points = {}
	for index = 0, 12 do
		local a = index / 12 * math.pi
		table.insert(points, { math.cos(a) * (w / 2 + 3), yArc + math.sin(a) * (w / 2 + 3), 5 })
	end
	for _, part in ipairs(House3DKit.Path(b, points, 6, frame, M.Metal)) do
		part.Reflectance = 0.25
	end
	b.Box(0, y0 - 6, 3, w + 14, 5, 8, frame, M.Metal)
	b.Box(0, y0 - 7, 5, w + 10, 2, 8, darken(frame, 0.15), M.Metal)
	House3DKit.StarSoft(b, 0, yArc + w / 2 + 3, 6, 4, 2, lighten(frame, 0.2), M.Metal)
	for _, x in ipairs({ -w / 2 - 3, w / 2 + 3 }) do
		b.Ball(x, y0 - 4, 7, 5, lighten(frame, 0.2), M.Metal).Reflectance = 0.3
	end
	b.Footprint(w + 14, 10, 100)
end

R.GlowStars = function(b, _ctx)
	local color = vivid(b, 1, rgb(255, 240, 150))
	local spots = { { -26, 70, 16 }, { 18, 78, 12 }, { 2, 46, 20 }, { -30, 30, 10 }, { 30, 36, 14 }, { 34, 64, 8 }, { -8, 18, 8 } }
	for index, p in ipairs(spots) do
		local core = House3DKit.StarSoft(b, p[1], p[2], 0, p[3], 2, index % 3 == 0 and rgb(190, 250, 200) or color, M.Neon)
		if index == 3 then
			b.Light(core, color, 8, 0.5)
		end
	end
	b.Footprint(90, 3, 100)
end

R.DreamCatcher = function(b, _ctx)
	local ring = vivid(b, 1, rgb(210, 160, 110))
	local feather = { vivid(b, 2, rgb(255, 170, 200)), vivid(b, 3, rgb(170, 150, 255)), WHITE }
	local points = {}
	for index = 0, 16 do
		local a = index / 16 * math.pi * 2
		table.insert(points, { math.cos(a) * 24, 66 + math.sin(a) * 24, 3 })
	end
	House3DKit.Path(b, points, 3.5, ring, M.Wood)
	-- toile
	for index = 0, 5 do
		local a = index / 6 * math.pi
		b.Tube(math.cos(a) * 22, 66 + math.sin(a) * 22, 3, -math.cos(a) * 22, 66 - math.sin(a) * 22, 3, 0.6, WHITE, M.SmoothPlastic)
	end
	b.Ball(0, 66, 3.5, 6, feather[2], M.Glass)
	-- plumes
	for index, x in ipairs({ -16, 0, 16 }) do
		local y = 34 - (index == 2 and 8 or 0)
		b.Tube(x, 44, 3, x, y + 8, 3, 0.6, WHITE, M.SmoothPlastic)
		b.Ball(x, y + 10, 3, 4, feather[index], M.SmoothPlastic)
		b.EggR(CFrame.new(x, y - 4, 3), 8, 22, 2, feather[index], M.Fabric)
	end
	b.Footprint(56, 6, 100)
end

-- Horloge à coucou : chalet, cadran, balancier, pommes de pin
R.CuckooClock = function(b, _ctx)
	local wood = darken(H.woodOf(b, rgb(170, 110, 70)), 0.1)
	b.Box(0, 30, 3, 50, 44, 10, wood, M.Wood)
	for _, side in ipairs({ -1, 1 }) do
		b.BoxR(CFrame.new(side * 15, 82, 5) * CFrame.Angles(0, 0, side * -0.62), 38, 6, 16, darken(wood, 0.25), M.Wood)
	end
	b.CylZ(0, 50, 8.5, 30, 2, rgb(255, 248, 232), M.SmoothPlastic)
	-- (v9.9 SCALE99) index + aiguilles à l'heure réelle
	local g = House3DKit.Gap(b, 0.5)
	for index = 0, 11 do
		local a = index / 12 * math.pi * 2
		b.Box(math.sin(a) * 12, 50 + math.cos(a) * 12 - 1, 9.5, 1, index % 3 == 0 and 2.4 or 1.4, 2 * g, INK)
	end
	House3DTime.Hand(b, "H", 0, 50, 9.5 + 1.5 * g, 7, 1.5, 1.8, 0.8, INK)
	House3DTime.Hand(b, "M", 0, 50, 10.3 + 2.5 * g, 10.5, 2, 1.2, 0.8, INK)
	b.CylZ(0, 50, 11.1 + 3.5 * g, 2.4, 1, GOLD, M.Metal)
	b.Box(0, 72, 7, 10, 8, 2, rgb(60, 40, 40))
	b.Ball(0, 76, 11, 7, rgb(255, 214, 90))
	b.Tube(0, 30, 6, 0, 10, 6, 1, GOLD, M.Metal)
	b.CylZ(0, 9, 6, 10, 1.5, GOLD, M.Metal)
	for _, x in ipairs({ -12, 12 }) do
		b.Tube(x, 30, 5, x, 16, 5, 0.6, INK, M.SmoothPlastic)
		b.Egg(x, 12, 5, 7, 12, 7, rgb(150, 100, 60), M.Wood)
	end
	b.Footprint(60, 16, 100)
end

-- Horloges murales (chat / soleil)
R.KittyClock = function(b, _ctx)
	local body = vivid(b, 1, rgb(255, 150, 190))
	b.CylZ(0, 50, 3, 70, 6, body, M.SmoothPlastic)
	b.CylZ(0, 50, 6.5, 56, 1, rgb(255, 250, 244), M.SmoothPlastic)
	for _, side in ipairs({ -1, 1 }) do
		House3DKit.Triangle(b, side * 22, 88, 0, 20, 18, side * -0.3, 6, body, M.SmoothPlastic)
		b.Ball(side * 12, 60, 7.5, 7, INK, M.SmoothPlastic)
	end
	for index = 0, 11 do
		local a = index / 12 * math.pi * 2
		b.Box(math.sin(a) * 23, 50 + math.cos(a) * 23 - 1.5, 7.2, 2, 3, 0.8, INK)
	end
	-- (v9.9 SCALE99) aiguilles à l'heure réelle + trotteuse
	local g = House3DKit.Gap(b, 0.5)
	House3DTime.Hand(b, "H", 0, 50, 7.6 + g, 14, 3, 2.6, 0.8, INK)
	House3DTime.Hand(b, "M", 0, 50, 8.4 + 2 * g, 20, 4, 1.8, 0.8, INK)
	House3DTime.Hand(b, "S", 0, 50, 9.2 + 3 * g, 22, 5, 0.8, 0.6, rgb(230, 70, 110))
	b.Ball(0, 50, 9.8 + 4 * g, 4, body, M.SmoothPlastic)
	-- queue-balancier
	b.Tube(0, 16, 4, 6, 4, 4, 5, body, M.SmoothPlastic)
	b.Footprint(76, 12, 100)
end

R.Tapestry = function(b, _ctx)
	local colors = { vivid(b, 1, rgb(255, 120, 140)), vivid(b, 2, rgb(255, 190, 90)), vivid(b, 3, rgb(255, 236, 120)), vivid(b, 4, rgb(140, 220, 150)), vivid(b, 5, rgb(120, 180, 255)), vivid(b, 6, rgb(180, 140, 255)) }
	b.CylX(0, 92, 3, 5, 92, rgb(170, 120, 80), M.Wood)
	for index = 1, 6 do
		b.Box(0, 14 + (6 - index) * 13, 2, 80, 13, 1.5, colors[index], M.Fabric)
	end
	for index = 0, 9 do
		b.Box(-36 + index * 8, 6, 2, 2, 9, 1.2, rgb(250, 240, 230), M.Fabric)
	end
	b.Footprint(92, 6, 100)
end

R.ButterflyFrame = function(b, _ctx)
	local frame = vivid(b, 1, rgb(210, 170, 110))
	local wing = { vivid(b, 2, rgb(120, 190, 255)), vivid(b, 3, rgb(255, 150, 200)) }
	local g = House3DKit.Gap(b, 0.8)
	House3DKit.Frame(b, 0, 8, (6 + g) / 2, 76, 84, 7, 6 + g, frame, M.Wood)
	b.Box(0, 12, 1, 66, 76, 1, rgb(255, 250, 240), M.SmoothPlastic)
	for _, side in ipairs({ -1, 1 }) do
		b.EggR(CFrame.new(side * 12, 58, 2.5) * CFrame.Angles(0, 0, side * -0.4), 22, 28, 1.5, wing[1], M.SmoothPlastic)
		b.EggR(CFrame.new(side * 10, 38, 2.5) * CFrame.Angles(0, 0, side * 0.5), 16, 20, 1.5, wing[2], M.SmoothPlastic)
		b.Ball(side * 14, 60, 3.4, 5, WHITE, M.SmoothPlastic)
		b.Tube(0, 66, 3, side * 8, 78, 3, 0.8, INK, M.SmoothPlastic)
	end
	b.EggR(CFrame.new(0, 50, 3), 5, 34, 3, INK, M.SmoothPlastic)
	local glass = b.Box(0, 12, 4.3, 66, 76, 0.4, GLASS, M.Glass)
	glass.Transparency = 0.85
	glass.Reflectance = 0.15
	b.Footprint(76, 8, 100)
end

-- Affiches, drapeaux : cadre / baguettes + le dessin 2D sur la face avant
local function poster(framed: boolean)
	return function(b: Builder, _ctx: any)
		local frame = framed and darken(vivid(b, 1, rgb(80, 90, 140)), 0.3) or rgb(240, 236, 230)
		if framed then
			House3DKit.Frame(b, 0, 4, 2, 84, 92, 5, 5, frame, M.Wood)
			b.Art(0, 8, 0.5, 74, 84, 1.05)
		else
			b.Art(0, 6, 0.5, 80, 88, 1.02)
			for _, x in ipairs({ -36, 36 }) do
				b.Ball(x, 90, 2.2, 5, rgb(255, 110, 140), M.SmoothPlastic)
			end
		end
		b.Footprint(84, 6, 100)
	end
end
R.HeroPoster = poster(false)
R.ComicPoster = poster(false)
R.JerseyFrame = function(b, _ctx)
	local shirt = vivid(b, 1, rgb(240, 70, 80))
	local frame = rgb(60, 60, 80)
	House3DKit.Frame(b, 0, 4, 3, 84, 92, 6, 6, frame, M.Wood)
	b.Box(0, 10, 1, 72, 80, 1, rgb(250, 248, 244), M.SmoothPlastic)
	b.Box(0, 18, 2.5, 38, 50, 2, shirt, M.Fabric)
	for _, side in ipairs({ -1, 1 }) do
		b.BoxR(CFrame.new(side * 25, 58, 3.5) * CFrame.Angles(0, 0, side * -0.6), 14, 24, 2, shirt, M.Fabric)
	end
	b.Box(0, 64, 3.8, 14, 4, 1, WHITE, M.Fabric)
	b.Box(0, 32, 3.6, 5, 22, 0.6, WHITE, M.SmoothPlastic)
	b.Box(6, 32, 3.6, 5, 22, 0.6, WHITE, M.SmoothPlastic)
	local glass = b.Box(0, 10, 5.8, 72, 80, 0.4, GLASS, M.Glass)
	glass.Transparency = 0.85
	b.Footprint(84, 8, 100)
end
R.NinjaBanner = function(b, _ctx)
	local paper = rgb(250, 240, 214)
	local red = vivid(b, 1, rgb(220, 60, 60))
	b.CylX(0, 92, 3, 6, 60, rgb(120, 70, 50), M.Wood)
	b.CylX(0, 8, 3, 6, 60, rgb(120, 70, 50), M.Wood)
	for _, x in ipairs({ -32, 32 }) do
		b.CylX(x, 92, 3, 8, 4, GOLD, M.Metal)
		b.CylX(x, 8, 3, 8, 4, GOLD, M.Metal)
	end
	b.Box(0, 10, 2, 50, 80, 1.5, paper, M.Fabric)
	b.CylZ(0, 64, 3, 22, 1, red, M.SmoothPlastic)
	-- trois traits d'encre (kanji stylisé)
	b.BoxR(CFrame.new(0, 40, 3.2), 4, 28, 1, INK)
	b.BoxR(CFrame.new(0, 44, 3.3) * CFrame.Angles(0, 0, 1.57), 4, 24, 1, INK)
	b.BoxR(CFrame.new(-6, 28, 3.3) * CFrame.Angles(0, 0, 0.7), 3, 14, 1, INK)
	b.BoxR(CFrame.new(6, 28, 3.3) * CFrame.Angles(0, 0, -0.7), 3, 14, 1, INK)
	b.Tube(-20, 92, 3, 0, 100, 3, 0.8, INK, M.SmoothPlastic)
	b.Tube(20, 92, 3, 0, 100, 3, 0.8, INK, M.SmoothPlastic)
	b.Footprint(64, 8, 100)
end

R.WindChime = function(b, _ctx)
	local color = vivid(b, 1, rgb(140, 200, 255))
	b.CylZ(0, 80, 8, 1, 1, INK, M.SmoothPlastic)
	b.Tube(0, 100, 8, 0, 82, 8, 0.8, INK, M.SmoothPlastic)
	local bell = b.Egg(0, 74, 8, 30, 18, 30, lighten(color, 0.3), M.Glass)
	bell.Transparency = 0.3
	b.Cyl(0, 66, 8, 30, 2, color, M.Glass)
	for index = 0, 4 do
		local a = index / 5 * math.pi * 2
		local x, z = math.cos(a) * 9, 8 + math.sin(a) * 6
		b.Tube(x, 66, z, x, 52 - index * 3, z, 0.6, WHITE, M.SmoothPlastic)
		b.Cyl(x, 34 - index * 3, z, 4, 18, index % 2 == 0 and rgb(220, 220, 235) or GOLD, M.Metal)
	end
	b.Tube(0, 66, 8, 0, 30, 8, 0.6, WHITE, M.SmoothPlastic)
	b.BoxR(CFrame.new(0, 22, 8), 12, 16, 0.8, rgb(255, 240, 200), M.Fabric)
	b.Footprint(40, 20, 100)
end

R.CarpStreamer = function(b, _ctx)
	local colors = { vivid(b, 1, rgb(240, 80, 80)), vivid(b, 2, rgb(90, 140, 255)), vivid(b, 3, rgb(255, 150, 190)) }
	b.Tube(-44, 96, 4, 44, 96, 4, 2.5, rgb(180, 130, 90), M.Wood)
	for index, color in ipairs(colors) do
		local y = 86 - (index - 1) * 26
		local len = 70 - index * 8
		b.Tube(-44 + index * 4, 96, 4, -40 + index * 4, y, 4, 0.6, INK, M.SmoothPlastic)
		b.EggR(CFrame.new(-40 + index * 4 + len / 2, y - 4, 6), len, 18, 10, color, M.Fabric)
		b.CylX(-40 + index * 4 + 3, y - 4, 6, 16, 3, WHITE, M.Fabric)
		b.Ball(-40 + index * 4 + 10, y - 2, 11, 7, WHITE, M.SmoothPlastic)
		b.Ball(-40 + index * 4 + 10, y - 2, 13.5, 3.5, INK, M.SmoothPlastic)
		House3DKit.Triangle(b, -40 + index * 4 + len + 2, y - 4, 5, 16, 10, -math.pi / 2, 2, darken(color, 0.1), M.Fabric)
	end
	b.Footprint(96, 16, 100)
end

R.Pinata = function(b, _ctx)
	local colors = { vivid(b, 1, rgb(255, 120, 170)), vivid(b, 2, rgb(255, 210, 80)), vivid(b, 3, rgb(120, 210, 255)), vivid(b, 4, rgb(140, 220, 140)) }
	b.Tube(0, 100, 8, 0, 70, 8, 0.8, INK, M.SmoothPlastic)
	-- âne en bandes de papier
	for index = 0, 4 do
		b.Box(-28 + index * 11, 40, 8, 11, 24, 22, colors[index % 4 + 1], M.Fabric)
	end
	for _, x in ipairs({ -22, 18 }) do
		for _, z in ipairs({ 1, 15 }) do
			b.Box(x, 14, z, 7, 26, 7, colors[(x + z) % 4 + 1], M.Fabric)
		end
	end
	b.Box(22, 60, 8, 14, 22, 14, colors[1], M.Fabric)
	b.Box(26, 72, 8, 16, 12, 18, colors[2], M.Fabric)
	b.Box(34, 76, 8, 8, 5, 10, colors[3], M.Fabric)
	b.Ball(33, 80, 15, 3.5, INK, M.SmoothPlastic)
	for _, dz in ipairs({ -4, 4 }) do
		House3DKit.Triangle(b, 22, 92, 8 + dz, 6, 10, 0, 2, colors[4], M.Fabric)
	end
	for index = 0, 4 do
		b.BoxR(CFrame.new(-32 - index * 0.6, 46 - index * 3, 8) * CFrame.Angles(0, index * 0.25, 0.3 + index * 0.07), 2, 18, 3, colors[index % 4 + 1], M.Fabric)
	end
	b.Footprint(80, 24, 100)
end

R.FloatingPlanet = function(b, _ctx)
	local planet = vivid(b, 1, rgb(255, 180, 110))
	local ring = vivid(b, 2, rgb(170, 150, 255))
	b.Tube(0, 100, 20, 0, 82, 20, 0.8, INK, M.SmoothPlastic)
	b.Ball(0, 55, 20, 52, planet, M.SmoothPlastic)
	b.Egg(-8, 64, 36, 16, 8, 8, lighten(planet, 0.3), M.SmoothPlastic)
	b.Egg(10, 46, 38, 12, 6, 6, darken(planet, 0.15), M.SmoothPlastic)
	b.Part("Part", CFrame.new(0, 55, 20) * CFrame.Angles(0, 0, 0.35) * CFrame.Angles(0, 0, math.pi / 2), Vector3.new(2, 92, 92), ring, M.SmoothPlastic, "Anneau")
	local ringPart = b.Parts[#b.Parts];
	(ringPart :: Part).Shape = Enum.PartType.Cylinder
	b.Part("Part", CFrame.new(0, 55, 20) * CFrame.Angles(0, 0, 0.35) * CFrame.Angles(0, 0, math.pi / 2), Vector3.new(2.4, 60, 60), lighten(planet, 0.1), M.SmoothPlastic, "Anneau");
	((b.Parts[#b.Parts]) :: Part).Shape = Enum.PartType.Cylinder
	for index = 0, 3 do
		local a = index * 1.7
		local star = b.Ball(math.cos(a) * 42, 55 + math.sin(a) * 36, 22, 5, BUTTER, M.Neon)
		star.CastShadow = false
	end
	b.Footprint(96, 44, 100)
end

R.PlanetMobile = function(b, _ctx)
	local colors = { vivid(b, 1, rgb(255, 170, 90)), vivid(b, 2, rgb(120, 180, 255)), vivid(b, 3, rgb(255, 120, 150)), vivid(b, 4, rgb(150, 220, 140)) }
	b.Tube(0, 100, 20, 0, 88, 20, 0.8, INK, M.SmoothPlastic)
	b.CylX(0, 86, 20, 2.5, 90, rgb(200, 170, 120), M.Wood)
	b.CylZ(0, 86, 20, 2.5, 30, rgb(200, 170, 120), M.Wood)
	local sun = b.Ball(0, 58, 20, 22, rgb(255, 214, 90), M.Neon)
	b.Light(sun, rgb(255, 220, 150), 8, 0.6)
	b.Tube(0, 86, 20, 0, 69, 20, 0.5, WHITE, M.SmoothPlastic)
	local spots = { { -42, 50, 20, 14 }, { 42, 42, 20, 18 }, { 0, 34, 6, 12 }, { 0, 48, 34, 10 } }
	for index, p in ipairs(spots) do
		local x, z = p[1], p[3]
		b.Tube(x, 86, z, x, p[2] + p[4] / 2, z, 0.5, WHITE, M.SmoothPlastic)
		b.Ball(x, p[2], z, p[4], colors[index], M.SmoothPlastic)
		if index == 2 then
			local ring = b.Part("Part", CFrame.new(x, p[2], z) * CFrame.Angles(0, 0, 0.3) * CFrame.Angles(0, 0, math.pi / 2), Vector3.new(1, 30, 30), lighten(colors[index], 0.4), M.SmoothPlastic, "Anneau");
			(ring :: Part).Shape = Enum.PartType.Cylinder
		end
	end
	b.Footprint(96, 40, 100)
end

-- Étagère à trophées murale
R.TrophyShelf = function(b, _ctx)
	local wood = H.woodOf(b, rgb(170, 120, 80))
	for _, y in ipairs({ 16, 56 }) do
		b.Box(0, y, 10, 96, 4, 20, wood, M.Wood)
		for _, x in ipairs({ -40, 40 }) do
			b.Wedge(x, y - 10, 4, 4, 10, 8, darken(wood, 0.2), "Front", M.Wood)
		end
	end
	local metals = { GOLD, rgb(210, 214, 226), rgb(210, 140, 90) }
	for row, y in ipairs({ 20, 60 }) do
		for index, x in ipairs({ -28, 0, 28 }) do
			local metal = metals[(index + row) % 3 + 1]
			b.Box(x, y, 12, 14, 5, 10, rgb(60, 50, 60), M.Wood)
			b.Cyl(x, y + 5, 12, 3, 8, metal, M.Metal)
			b.Egg(x, y + 20, 12, 16, 14, 16, metal, M.Metal)
			b.Cyl(x, y + 23, 12, 16, 3, metal, M.Metal)
			for _, side in ipairs({ -1, 1 }) do
				b.Tube(x + side * 8, y + 24, 12, x + side * 11, y + 17, 12, 2, metal, M.Metal)
			end
		end
	end
	b.Top(1, 0, 20, 10, 90, 16)
	b.Footprint(96, 20, 100)
end

-- Porte-skates mural : 3 planches en biais sur des crochets
R.SkateRack = function(b, _ctx)
	local colors = { vivid(b, 1, rgb(255, 110, 150)), vivid(b, 2, rgb(90, 180, 255)), vivid(b, 3, rgb(140, 220, 120)) }
	b.Box(0, 44, 1.5, 96, 12, 3, rgb(90, 80, 100), M.Wood)
	for index, color in ipairs(colors) do
		local x = -32 + (index - 1) * 32
		b.Box(x, 50, 5, 4, 3, 10, rgb(200, 200, 210), M.Metal)
		local cf = CFrame.new(x, 50, 9) * CFrame.Angles(0, 0, 0.12 * (index - 2))
		b.EggR(cf * CFrame.new(0, 0, 0), 20, 88, 3, color, M.SmoothPlastic)
		b.BoxR(cf * CFrame.new(0, 0, 1.6), 16, 70, 0.4, darken(color, 0.4), M.SmoothPlastic)
		for _, dy in ipairs({ -30, 30 }) do
			b.BoxR(cf * CFrame.new(0, dy, 4), 12, 3, 3, rgb(200, 200, 210), M.Metal)
			for _, dx in ipairs({ -8, 8 }) do
				local p = (cf * CFrame.new(dx, dy, 6)).Position
				b.CylX(p.X, p.Y, p.Z, 6, 4, rgb(255, 240, 200), M.SmoothPlastic)
			end
		end
	end
	b.Footprint(96, 14, 100)
end

R.Kite = function(b, _ctx)
	local colors = { vivid(b, 1, rgb(255, 110, 150)), vivid(b, 2, rgb(255, 210, 80)), vivid(b, 3, rgb(120, 200, 255)), vivid(b, 4, rgb(140, 220, 140)) }
	-- losange en 4 quartiers colorés + baguettes + queue à nœuds
	local cy, r = 62, 30
	local quarters = { { -1, 1 }, { 1, 1 }, { 1, -1 }, { -1, -1 } }
	for index, q in ipairs(quarters) do
		b.BoxR(CFrame.new(q[1] * r / 4, cy + q[2] * r / 4, 3 + (index - 1) * House3DKit.Gap(b, 0.4)) * CFrame.Angles(0, 0, math.pi / 4), r * 0.707, r * 0.707, 1.5, colors[index], M.Fabric)
	end
	b.Tube(0, cy + r, 4.2, 0, cy - r, 4.2, 1.5, rgb(160, 110, 70), M.Wood)
	b.Tube(-r, cy, 4.2, r, cy, 4.2, 1.5, rgb(160, 110, 70), M.Wood)
	local points = { { 0, cy - r, 3.5 }, { 8, 20, 3.5 }, { -6, 10, 3.5 }, { 6, 2, 3.5 } }
	House3DKit.Path(b, points, 1, WHITE, M.SmoothPlastic)
	for index = 2, 4 do
		local p = points[index]
		b.BoxR(CFrame.new(p[1], p[2], 4) * CFrame.Angles(0, 0, 0.5), 9, 4, 1, colors[index], M.Fabric)
		b.BoxR(CFrame.new(p[1], p[2], 4) * CFrame.Angles(0, 0, -0.5), 9, 4, 1, colors[index], M.Fabric)
	end
	b.Footprint(64, 8, 100)
end

----------------------------------------------------------------------
-- DÉCO AU SOL

        <Item class="ModuleScript" referent="298">
          <Properties>
            <string name="Name">FR_V93_World</string>
            <string name="Source"><![CDATA[--[[
	FR_V93_World (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > Lang > FR_V93_World

	Traductions françaises de 🚶 Dopamine Town (WORLD93) : HUD de la ville,
	visites, ❤️, émotes, déplacement des meubles, messages du serveur
	(WorldService), boutons d'entrée (menu, fenêtre Maison).
]]

return {
	fr = {
		-- entrées
		["🚶 Town"] = "🚶 Ville",
		["🚶 Walk in"] = "🚶 Entrer",
		["Walk inside your house with your avatar (Dopamine Town)"] = "Marche dans ta maison avec ton avatar (Dopamine Town)",

-- Table de ping-pong (bleue, filet, raquettes, balle)
Art.PingPongTable = function(body, kit, _item)
	for _, x in ipairs({ 10, 90 }) do
		kit.Part(body, x - 3, 56, 6, 42, IRON, { Radius = 2, Z = 1 })
		kit.Circle(body, x, 97, 8, 5, IRON_DARK, 0, 2)
	end
	kit.Line(body, 14, 90, 86, 90, 3, IRON, 0, 1)
	local top = kit.Part(body, 1, 50, 98, 8, rgb(40, 90, 170), { Radius = 2, Z = 3, Shine = true })
	kit.Box(top, 1, 0, 96, 1.2, WHITE, 0, 2)
	kit.Box(top, 48.4, 0, 1.2, 8, WHITE, 0, 2)
	kit.Part(body, 48, 38, 3, 14, IRON_DARK, { Radius = 1, Z = 4 })
	local net = kit.Part(body, 36, 38, 28, 12, WHITE, { Radius = 1, Z = 4, T = 0.35, Outline = rgb(90, 90, 100) })
	for k = 1, 4 do
		kit.Box(net, k * 5.6, 0, 0.8, 12, rgb(120, 120, 130), 0.3, 2)
	end
	-- raquettes + balle
	for _, spec in ipairs({ { 20, RED, -20 }, { 78, rgb(30, 30, 36), 20 } }) do
		local p = kit.Pivot(body, spec[1], 44, 5)
		p.Rotation = spec[3]
		kit.Blob(p, 0, 0, 14, 12, spec[2], { Z = 1 })
		kit.Part(p, -1.5, 5, 3, 9, WALNUT, { Radius = 1, Z = 1 })
	end
	local ball = kit.Circle(body, 60, 30, 4, 4, rgb(255, 170, 60), 0, 6)
	kit.Animate(ball, "Bob", 5, 1.8, 0)
	return nil
end

-- Rameur (rail, siège coulissant, volant ventilé, écran)
Art.RowingMachine = function(body, kit, _item)
	kit.Part(body, 6, 82, 88, 6, IRON, { Radius = 3, Z = 1, Shine = true })
	kit.Part(body, 4, 90, 12, 8, IRON_DARK, { Radius = 2, Z = 1 })
	kit.Part(body, 84, 90, 12, 8, IRON_DARK, { Radius = 2, Z = 1 })
	local seat = kit.Part(body, 48, 70, 22, 10, rgb(40, 40, 46), { Radius = 4, Z = 3, Shine = true })
	kit.Animate(seat, "Drift", 10, 1, 0)
	-- volant + carter
	local wheel = kit.Circle(body, 18, 68, 30, 30, rgb(60, 62, 72), 0, 2)
	kit.Stroke(wheel, rgb(230, 70, 80), 2, 0)
	local fan = kit.Pivot(wheel, 15, 15, 2)
	for k = 0, 3 do
		local arm = kit.Pivot(fan, 0, 0, 1)
		arm.Rotation = k * 45
		kit.Box(arm, -1, -12, 2, 24, rgb(120, 124, 136), 0, 1)
	end
	kit.Animate(fan, "Spin", 1, 1.2, 0)
	kit.Line(body, 20, 64, 32, 46, 3, IRON, 0, 3)
	kit.Part(body, 26, 36, 16, 12, SCREEN, { Radius = 2, Z = 4, Outline = IRON_DARK })
	kit.Text(body, "500m", 34, 42, 7, LIME, 5)
	-- poignée + repose-pieds
	kit.Line(body, 30, 62, 42, 56, 2, IRON_DARK, 0, 4)
	kit.Part(body, 40, 52, 6, 8, rgb(40, 40, 46), { Radius = 2, Z = 5 })
	kit.Part(body, 34, 74, 10, 8, rgb(230, 70, 80), { Radius = 2, Z = 4 })
	return nil
end

-- Banc de musculation + rack + barre chargée
Art.WeightBench = function(body, kit, _item)
	-- rack
	for _, x in ipairs({ 14, 86 }) do
		kit.Part(body, x - 3, 18, 6, 80, IRON, { Radius = 1, Z = 1 })
		kit.Part(body, x - 8, 94, 16, 5, IRON_DARK, { Radius = 2, Z = 1 })
		kit.Part(body, x - 5, 38, 10, 4, IRON_DARK, { Radius = 1, Z = 2 })
	end
	kit.Line(body, 4, 36, 96, 36, 3, STEEL, 0, 3)
	for _, x in ipairs({ 8, 92 }) do
		kit.Part(body, x - 3, 22, 6, 28, rgb(40, 40, 46), { Radius = 3, Z = 4 })
		kit.Part(body, x + (x < 50 and 3 or -7), 26, 4, 20, RED, { Radius = 2, Z = 4 })
	end
	-- banc
	kit.Part(body, 46, 72, 8, 26, IRON_DARK, { Radius = 2, Z = 3 })
	kit.Part(body, 30, 94, 40, 5, IRON_DARK, { Radius = 2, Z = 3 })
	kit.Part(body, 24, 62, 52, 10, rgb(40, 40, 46), { Radius = 5, Z = 4, Shine = true })
	kit.Box(body, 28, 63, 44, 1.4, RED, 0.2, 5)
	-- haltères au sol
	kit.Part(body, 76, 86, 16, 8, rgb(60, 60, 70), { Radius = 4, Z = 5 })
	return nil
end

-- Tapis de course (console, bande qui défile, rampes)
Art.Treadmill = function(body, kit, _item)
	kit.Part(body, 6, 82, 88, 14, rgb(50, 52, 60), { Radius = 5, Z = 1, Shine = true })
	local belt = kit.Part(body, 10, 80, 76, 6, rgb(30, 30, 36), { Radius = 3, Z = 2 })
	local stripe = kit.Box(belt, 20, 2, 18, 2, rgb(90, 90, 100), 0, 2)
	kit.Animate(stripe, "Drift", 18, 2, 0)
	for _, x in ipairs({ 16, 26 }) do
		kit.Line(body, x, 82, x + 6, 26, 4, STEEL, 0, 1)
	end
	kit.Line(body, 22, 44, 50, 44, 3, STEEL, 0, 3)
	local console = kit.Part(body, 6, 16, 34, 16, IRON_DARK, { Radius = 4, Z = 4, Shine = true })
	local screen = kit.Part(console, 4, 3, 26, 10, SCREEN, { Radius = 2, Z = 2, Outline = false })
	kit.Text(screen, "8.5 km/h", 13, 5, 7, CYAN, 2)
	kit.Circle(body, 44, 24, 5, 5, RED, 0, 5)
	-- bouteille d'eau
	kit.Part(body, 40, 30, 5, 10, rgb(120, 200, 240), { Radius = 2, Z = 5, T = 0.2 })
	return { Glow = CYAN }
end

-- Mur d'escalade (panneau, prises de couleur, corde)
Art.ClimbingWall = function(body, kit, _item)
	local panel = kit.Part(body, 6, 4, 88, 92, rgb(214, 200, 176), { Radius = 3, Z = 1, Shine = true })
	for k = 1, 3 do
		kit.Box(panel, 0, k * 23, 88, 1, rgb(170, 156, 134), 0, 2)
		kit.Box(panel, k * 22, 0, 1, 92, rgb(170, 156, 134), 0, 2)
	end
	local colors = { RED, BLUE, rgb(255, 200, 60), LIME, MAGENTA, ORANGE, CYAN }
	local holds = { { 20, 84 }, { 38, 74 }, { 26, 62 }, { 54, 58 }, { 70, 70 }, { 44, 44 }, { 66, 38 }, { 30, 30 }, { 52, 22 }, { 76, 16 },
		{ 18, 46 }, { 82, 52 }, { 60, 86 }, { 36, 12 } }
	for index, h in ipairs(holds) do
		local hold = kit.Blob(body, h[1], h[2], 9 + index % 3 * 2, 7 + index % 2 * 2, colors[(index % #colors) + 1], { Z = 3, Rotation = index * 23, Shine = true })
		local _ = hold
	end
	kit.Line(body, 84, 4, 84, 96, 2, rgb(255, 120, 60), 0, 4)
	kit.Circle(body, 84, 6, 5, 5, STEEL, 0, 5)
	return { WallShadow = Vector2.new(88, 92) }
end

-- Station de réalité virtuelle (tapis rond, capteurs, casque sur socle)
Art.VRStation = function(body, kit, _item)
	local mat = kit.Blob(body, 50, 92, 94, 14, rgb(40, 44, 70), { Z = 1, Shine = true })
	kit.Stroke(mat, CYAN, 2, 0)
	local ring = kit.Blob(body, 50, 92, 70, 8, CYAN, { Z = 2, T = 0.6, Outline = false })
	kit.Animate(ring, "Pulse", 0.3, 1.2, 0)
	for _, x in ipairs({ 8, 92 }) do
		kit.Part(body, x - 2, 20, 4, 72, IRON, { Radius = 2, Z = 2 })
		local sensor = kit.Part(body, x - 5, 14, 10, 8, IRON_DARK, { Radius = 2, Z = 3 })
		local led = kit.Circle(sensor, 5, 4, 3, 3, RED, 0, 2)
		kit.Animate(led, "Pulse", 0.7, 1.6, x)
	end
	-- socle + casque + manettes
	kit.Part(body, 42, 54, 16, 34, rgb(236, 238, 244), { Radius = 5, Z = 3, Shine = true })
	local headset = kit.Part(body, 32, 36, 36, 20, rgb(240, 242, 248), { Radius = 9, Z = 4, Shine = true })
	kit.Part(headset, 4, 4, 28, 12, rgb(30, 34, 50), { Radius = 5, Z = 2 })
	kit.Line(body, 32, 44, 22, 40, 3, rgb(60, 60, 70), 0, 3)
	kit.Line(body, 68, 44, 78, 40, 3, rgb(60, 60, 70), 0, 3)
	for _, x in ipairs({ 24, 76 }) do
		local c = kit.Part(body, x - 5, 58, 10, 18, rgb(236, 238, 244), { Radius = 5, Z = 4 })
		kit.Circle(c, 5, 4, 8, 8, rgb(60, 60, 70), 0, 2)
	end
	kit.Sparkle(body, 86, 44, 10, CYAN, 0, 5)
	return { Glow = CYAN }
end

-- Cockpit de course pro (3 écrans incurvés, siège baquet, volant, pédales)
Art.RacingCockpit = function(body, kit, _item)
	-- 3 écrans
	for index, spec in ipairs({ { 4, 18, -10 }, { 34, 12, 0 }, { 66, 18, 10 } }) do
		local s = glowScreen(kit, body, spec[1], spec[2], 30, 20, rgb(80, 150, 230), rgb(40, 60, 120), 2)
		s.Rotation = spec[3]
		kit.Box(s, 0, 12, 30, 8, rgb(60, 60, 70), 0, 2) -- piste
		kit.Box(s, 14, 12, 2, 8, WHITE, 0.4, 3)
		local _ = index
	end
	kit.Part(body, 46, 32, 8, 16, IRON, { Radius = 2, Z = 1 })
	-- châssis
	kit.Part(body, 4, 86, 92, 8, IRON_DARK, { Radius = 3, Z = 2, Shine = true })
	kit.Line(body, 30, 88, 36, 58, 4, IRON, 0, 2)
	-- volant
	local wheel = kit.Circle(body, 36, 54, 22, 22, rgb(30, 30, 36), 0, 5)
	kit.Stroke(wheel, rgb(60, 60, 70), 2, 0)
	kit.Box(wheel, 3, 10, 16, 3, rgb(60, 60, 70), 0, 2)
	kit.Circle(wheel, 11, 11, 6, 6, RED, 0, 3)
	-- siège baquet
	kit.Part(body, 60, 34, 30, 44, RED, { Radius = 12, Z = 4, Shine = true })
	kit.Part(body, 66, 38, 18, 30, rgb(30, 30, 36), { Radius = 8, Z = 5 })
	kit.Part(body, 54, 70, 40, 16, RED, { Radius = 7, Z = 6, Shine = true })
	kit.Part(body, 12, 76, 16, 10, IRON, { Radius = 2, Z = 4 }) -- pédales
	kit.Sparkle(body, 92, 12, 9, rgb(255, 214, 90), 0, 7)
	return { Glow = rgb(80, 150, 230) }
end

-- Double borne d'arcade néon (2 bornes côte à côte, écrans animés)
Art.TwinArcade = function(body, kit, _item)
	for index, spec in ipairs({ { 4, rgb(120, 60, 200), CYAN }, { 52, rgb(220, 50, 120), LIME } }) do
		local x, color, neon = spec[1], spec[2], spec[3]
		local cab = kit.Part(body, x, 12, 44, 88, color, { Radius = 4, Z = 1 + index, Shine = true })
		kit.Stroke(cab, neon, 2, 0)
		local marquee = kit.Part(cab, 3, 3, 38, 12, rgb(30, 30, 46), { Radius = 3, Z = 2 })
		kit.Text(marquee, index == 1 and "DOPA" or "RUN!", 19, 6, 9, neon, 2)
		local scr = kit.Part(cab, 5, 18, 34, 26, SCREEN, { Radius = 3, Z = 2, Outline = rgb(20, 20, 30) })
		local sprite = kit.Box(scr, 6, 12, 6, 6, neon, 0, 2)
		kit.Animate(sprite, "Drift", 8, 1.2, index)
		kit.Box(scr, 20, 6, 4, 4, rgb(255, 214, 90), 0, 2)
		kit.Box(scr, 0, 22, 34, 4, rgb(60, 60, 90), 0, 2)
		local panel = kit.Part(cab, 2, 46, 40, 12, rgb(30, 30, 46), { Radius = 3, Z = 3 })
		kit.Circle(panel, 10, 6, 6, 6, RED, 0, 2)
		kit.Circle(panel, 26, 6, 5, 5, rgb(255, 214, 90), 0, 2)
		kit.Circle(panel, 33, 6, 5, 5, neon, 0, 2)
		kit.Part(cab, 14, 64, 16, 10, rgb(30, 30, 46), { Radius = 2, Z = 2 }) -- fente à pièces
		local glow = kit.Box(body, x - 2, 96, 48, 4, neon, 0.5, 1)
		kit.Animate(glow, "Pulse", 0.3, 1.3, index)
	end
	return { Glow = CYAN }
end

return Art
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="28">
              <Properties>
                <string name="Name">Nature91</string>
                <string name="Source"><![CDATA[--[[
	Nature91 (ModuleScript) — (v9.1) plantes, lumières, fenêtres, portes et
	animaux 🪴💡🪟🚪🐾
	Emplacement : ReplicatedStorage > Client > Components > House > Art > Nature91
	Contrat : voir HouseArt ; animaux : voir Art/Pets (parties "animal" dans
	des groupes dont le nom commence par "Pet", le reste = leur maison).
]]

local Art = {}

local WHITE = Color3.new(1, 1, 1)

-- Pot arrondi avec bord et petit visage
local function pot(body, kit, x, y, w, h, color, face)
	local frame = kit.Part(body, x, y, w, h, color, { Radius = 8, Z = 5, Shine = true })
	kit.Part(body, x - 3, y - 2, w + 6, 8, kit.Darken(color, 0.06), { Radius = 4, Z = 6 })
	if face then
		kit.Face(frame, w / 2, h * 0.55, math.min(w, h) * 0.6, { Z = 3 })
	end
	return frame
end

-- Groupe qui respire (échelle ancrée en bas au centre)
local function breather(parent, kit, x, y, w, h, z)
	local g = kit.Group(parent, x, y, w, h, z)
	g.AnchorPoint = Vector2.new(0.5, 1)
	g.Position = UDim2.fromOffset(x + w / 2, y + h)
	return g
end

-- Trio de succulentes dans des petits pots pastel
Art.SucculentTrio = function(body, kit, _item)
	local C = kit.C
	for index, p in ipairs({ { 6, C.Pink, 0.9 }, { 36, C.Sky, 1.1 }, { 66, C.Butter, 0.9 } }) do
		local cx = p[1] + 14
		local s = p[3]
		for k = 0, 4 do
			local angle = -60 + k * 30
			local leaf = kit.Blob(body, cx + math.sin(math.rad(angle)) * 7 * s, 62 - math.cos(math.rad(angle)) * 8 * s, 9 * s, 18 * s, k % 2 == 0 and C.Mint or C.Leaf, { Z = 2, Rotation = angle, Thickness = 1.2 })
			local _ = leaf
		end
		kit.Blob(body, cx, 66, 12 * s, 12 * s, C.Mint, { Z = 3 })
		if index == 2 then
			kit.Circle(body, cx, 50, 7, 7, C.Pink, 0, 4) -- petite fleur
		end
		pot(body, kit, p[1], 70, 28, 28, p[2], index == 2)
	end
	return nil
end

-- Pot de lavande (épis violets qui ondulent)
Art.LavenderPot = function(body, kit, _item)
	local C = kit.C
	local purple = Color3.fromRGB(170, 130, 230)
	for index = 0, 6 do
		local x = 28 + index * 7.3
		local sway = kit.Pivot(body, x, 64, 2)
		kit.Line(sway, 0, 0, (index - 3) * 2, -40 - (index % 2) * 8, 1.6, C.LeafDark, 0, 1)
		for bud = 0, 3 do
			kit.Blob(sway, (index - 3) * 2 * (0.6 + bud * 0.1), -30 - (index % 2) * 8 - bud * 4, 6, 7, purple, { Z = 2, Thickness = 1, Shade = false })
		end
		kit.Animate(sway, "Sway", 4, 0.8, index * 0.6)
	end
	pot(body, kit, 22, 62, 56, 36, C.Cream, true)
	kit.Heart(body, 70, 86, 10, purple, 0, 8)
	return nil
end

-- Terrarium suspendu (bulle de verre, fougère, champignon)
Art.HangingTerrarium = function(body, kit, _item)
	local C = kit.C
	kit.Line(body, 50, 0, 50, 22, 1.5, C.Brown, 0, 1)
	local swing = kit.Pivot(body, 50, 2, 2)
	kit.Animate(swing, "Sway", 4, 0.6, 0)
	local glass = kit.Blob(swing, 0, 56, 60, 56, C.Glass, { Z = 1, T = 0.35, Outline = C.Sky })
	kit.Blob(glass, 30, 44, 50, 20, C.Brown, { Z = 2, Outline = false, Shade = false })
	kit.Blob(glass, 22, 38, 12, 20, C.Leaf, { Z = 3, Rotation = -25 })
	kit.Blob(glass, 34, 34, 12, 24, C.LeafDark, { Z = 3, Rotation = 18 })
	local cap = kit.Blob(glass, 42, 40, 12, 8, C.Red, { Z = 4 })
	kit.Circle(cap, 4, 3, 3, 3, WHITE, 0, 2)
	kit.Shine(glass, 10, 10, 6, 14, 5, 0.3)
	kit.Part(swing, -8, 26, 16, 6, C.Gold, { Radius = 3, Z = 2 })
	return { WallShadow = Vector2.new(0.5, 0.55) }
end

-- Bol de lotus (eau, fleur rose, feuilles rondes, poisson rouge)
Art.LotusBowl = function(body, kit, _item)
	local C = kit.C
	local bowl = kit.Part(body, 8, 62, 84, 36, C.Sky, { Radius = 16, Z = 3, Shine = true })
	kit.Blob(body, 50, 64, 80, 12, Color3.fromRGB(140, 210, 240), { Z = 4, Outline = false })
	kit.Face(bowl, 42, 22, 20, { Eyes = "happy", Z = 3 })
	kit.Blob(body, 26, 62, 26, 9, C.Leaf, { Z = 5 })
	kit.Blob(body, 74, 63, 22, 8, C.LeafDark, { Z = 5 })
	local flower = kit.Group(body, 0, 0, 100, 100, 6)
	kit.Animate(flower, "Bob", 1.5, 0.8, 0)
	for k = -2, 2 do
		kit.Blob(flower, 50 + k * 7, 50 - (2 - math.abs(k)) * 3, 12, 24, k % 2 == 0 and C.Pink or C.PinkSoft, { Z = 1 + (2 - math.abs(k)), Rotation = k * 22 })
	end
	kit.Circle(flower, 50, 54, 8, 6, C.Butter, 0, 5)
	return nil
end

-- Arbre arc-en-ciel (feuillage multicolore, fruits-cœurs, étincelles)
Art.RainbowTree = function(body, kit, _item)
	local C = kit.C
	kit.Part(body, 44, 58, 12, 34, C.Wood, { Radius = 4, Z = 1 })
	pot(body, kit, 28, 84, 44, 16, C.Lilac, false)
	local crown = kit.Group(body, 0, 0, 100, 100, 2)
	kit.Animate(crown, "Breathe", 0.02, 0.8, 0)
	local colors = { C.Red, C.Orange, C.Yellow, C.Leaf, C.Sky, C.Lilac }
	for index, color in ipairs(colors) do
		local a = (index - 1) / #colors * math.pi * 2
		kit.Blob(crown, 50 + math.cos(a) * 26, 36 + math.sin(a) * 18, 36, 32, color, { Z = index, Shine = true })
	end
	kit.Blob(crown, 50, 36, 40, 34, WHITE, { Z = 8, Shine = true })
	kit.Face(crown, 50, 36, 22, { Eyes = "happy", Z = 9 })
	for index, spot in ipairs({ { 18, 12 }, { 84, 20 }, { 50, 2 } }) do
		local sparkle = kit.Sparkle(body, spot[1], spot[2], 12, WHITE, 0, 10)
		kit.Animate(sparkle, "Pulse", 0.7, 1.3, index)
	end
	return { Glow = Color3.fromRGB(255, 230, 250) }
end

-- Lampe tulipe (abat-jour en fleur, tige verte)
Art.TulipLamp = function(body, kit, _item)
	local C = kit.C
	kit.Blob(body, 50, 94, 44, 12, C.Mint, { Z = 1, Shine = true })
	kit.Line(body, 50, 92, 50, 44, 4, C.LeafDark, 0, 2)
	kit.Blob(body, 60, 70, 18, 8, C.Leaf, { Z = 2, Rotation = -30 })
	local shade = kit.Part(body, 26, 14, 48, 36, C.Pink, { Radius = 16, Z = 3, Shine = true })
	for _, x in ipairs({ 22, 36, 50 }) do
		kit.Part(body, x + 2, 6, 14, 18, C.Pink, { Radius = 7, Z = 2 })
	end
	local bulb = kit.Circle(shade, 24, 30, 16, 10, C.Butter, 0, 2)
	kit.Animate(bulb, "Pulse", 0.3, 1, 0)
	return { Glow = Color3.fromRGB(255, 200, 220) }
end

-- Lampe méduse (cloche lumineuse, tentacules qui ondulent)
Art.JellyfishLamp = function(body, kit, _item)
	local C = kit.C
	local jelly = Color3.fromRGB(190, 170, 255)
	kit.Blob(body, 50, 94, 50, 12, C.Navy, { Z = 1, Shine = true })
	local float = kit.Group(body, 0, 0, 100, 100, 2)
	kit.Animate(float, "Bob", 4, 0.8, 0)
	for index = 0, 4 do
		local tentacle = kit.Pivot(float, 30 + index * 10, 50, 1)
		kit.Blob(tentacle, 0, 16, 5, 30, index % 2 == 0 and C.Pink or C.Sky, { Z = 1, T = 0.2, Thickness = 1 })
		kit.Animate(tentacle, "Sway", 8, 1.2, index)
	end
	local bell = kit.Blob(float, 50, 40, 60, 44, jelly, { Z = 3, T = 0.1, Shine = true })
	kit.Face(bell, 30, 24, 22, { Z = 3 })
	kit.Box(float, 20, 52, 60, 6, jelly, 0.2, 3)
	return { Glow = Color3.fromRGB(200, 170, 255) }
end

-- Enseigne néon étoile (contour qui clignote)
Art.NeonStar = function(body, kit, _item)
	local C = kit.C
	local neon = Color3.fromRGB(255, 210, 90)
	kit.Part(body, 10, 12, 80, 76, Color3.fromRGB(70, 60, 110), { Radius = 12, Z = 1 })
	local star = kit.Sparkle(body, 50, 48, 58, neon, 0, 2)
	kit.Animate(star, "Pulse", 0.25, 2, 0)
	kit.Diamond(body, 50, 48, 22, neon, 0, 3)
	kit.Circle(body, 50, 48, 10, 10, WHITE, 0, 4)
	local bulbs = {}
	for index = 0, 5 do
		local x = 18 + index * 12.8
		local halo = kit.Circle(body, x, 80, 9, 9, C.Pink, 0.6, 2)
		local dot = kit.Circle(body, x, 80, 5, 5, C.Pink, 0, 3)
		dot:SetAttribute("Phase", index * 1.1)
		table.insert(bulbs, dot)
		table.insert(bulbs, halo)
	end
	return { Glow = neon, Bulbs = bulbs, WallShadow = Vector2.new(0.8, 0.76) }
end

-- Fenêtre cintrée (arc, croisillons, lune et étoiles, jardinière)
Art.ArchWindow = function(body, kit, _item)
	local C = kit.C
	local frame = kit.Part(body, 16, 6, 68, 84, C.Cream, { Radius = 34, Z = 1 })
	local glass = kit.Part(frame, 6, 6, 56, 74, Color3.fromRGB(150, 180, 250), { Radius = 28, Z = 2, Outline = false })
	kit.Gradient(glass, Color3.fromRGB(160, 170, 255), WHITE, 90)
	local moon = kit.Circle(glass, 36, 20, 14, 14, C.Butter, 0, 3)
	kit.Circle(moon, 10, 4, 12, 12, Color3.fromRGB(170, 180, 255), 0, 2)
	for index, spot in ipairs({ { 14, 18 }, { 20, 40 }, { 42, 44 } }) do
		local star = kit.Sparkle(glass, spot[1], spot[2], 7, WHITE, 0, 3)
		kit.Animate(star, "Pulse", 0.6, 1, index)
	end
	kit.Box(body, 49, 12, 3, 76, C.Cream, 0, 3)
	kit.Box(body, 22, 50, 56, 3, C.Cream, 0, 3)
	kit.Part(body, 10, 86, 80, 8, C.Cream, { Radius = 3, Z = 4 })
	for index, color in ipairs({ C.Pink, C.Butter, C.Lilac }) do
		kit.Circle(body, 30 + (index - 1) * 20, 84, 10, 10, color, 0, 5)
	end
	return { WallShadow = Vector2.new(0.72, 0.9) }
end

-- Vitrail (rosace colorée qui brille)
Art.StainedGlass = function(body, kit, _item)
	local C = kit.C
	local lead = Color3.fromRGB(90, 76, 110)
	local frame = kit.Part(body, 14, 4, 72, 92, C.Cream, { Radius = 36, Z = 1 })
	local glass = kit.Part(frame, 6, 6, 60, 80, lead, { Radius = 30, Z = 2, Outline = false })
	local colors = { C.Pink, C.Sky, C.Butter, C.Mint, C.Lilac, C.Peach }
	for row = 0, 3 do
		for col = 0, 2 do
			local color = colors[(row * 3 + col) % #colors + 1]
			local pane = kit.Part(glass, 4 + col * 18, 30 + row * 12, 16, 10, color, { Radius = 2, Z = 2, Outline = false, Shade = false })
			local _ = pane
		end
	end
	local rose = kit.Circle(glass, 30, 16, 30, 30, C.Pink, 0, 3)
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		kit.Circle(rose, 15 + math.cos(a) * 8, 15 + math.sin(a) * 8, 9, 9, colors[k + 1], 0, 2)
	end
	kit.Heart(rose, 15, 15, 9, WHITE, 0, 3)
	local shine = kit.Box(glass, 6, 6, 8, 70, WHITE, 0.7, 4)
	kit.Animate(shine, "Pulse", 0.2, 0.6, 0)
	return { Glow = Color3.fromRGB(255, 220, 240), WallShadow = Vector2.new(0.74, 0.94) }
end

-- Porte hollandaise pastel (moitié haute ouverte, couronne de fleurs)
Art.DutchDoor = function(body, kit, _item)
	local C = kit.C
	local mint = Color3.fromRGB(170, 226, 206)
	kit.Part(body, 16, 4, 68, 96, C.Cream, { Radius = 8, Z = 1 }) -- chambranle
	kit.Part(body, 22, 10, 56, 40, Color3.fromRGB(90, 76, 110), { Radius = 4, Z = 2 }) -- ouverture
	kit.Part(body, 24, 40, 52, 8, C.Wood, { Radius = 3, Z = 3 }) -- tablette
	kit.Blob(body, 40, 38, 12, 10, C.Peach, { Z = 4 })
	local top = kit.Part(body, 70, 10, 18, 40, mint, { Radius = 4, Z = 3 }) -- battant ouvert
	local _ = top
	local bottom = kit.Part(body, 22, 50, 56, 50, mint, { Radius = 4, Z = 3, Shine = true })
	kit.Part(bottom, 6, 8, 44, 34, kit.Lighten(mint, 0.3), { Radius = 4, Z = 2, Outline = false })
	kit.Circle(bottom, 46, 22, 5, 5, C.Gold, 0, 3)
	-- couronne de fleurs
	local wreath = kit.Circle(body, 50, 24, 20, 20, C.Leaf, 1, 5)
	kit.Stroke(wreath, C.Leaf, 4, 0)
	for k = 0, 4 do
		local a = k / 5 * math.pi * 2
		kit.Circle(body, 50 + math.cos(a) * 10, 24 + math.sin(a) * 10, 5, 5, k % 2 == 0 and C.Pink or C.Butter, 0, 6)
	end
	return nil
end

-- Porte de château (arche de pierre, grille dorée, drapeaux)
Art.CastleGate = function(body, kit, _item)
	local C = kit.C
	local stone = Color3.fromRGB(226, 218, 240)
	for _, x in ipairs({ 4, 76 }) do
		kit.Part(body, x, 20, 20, 80, stone, { Radius = 4, Z = 2, Shine = true })
		for k = 0, 1 do
			kit.Box(body, x + k * 12, 14, 8, 8, stone, 0, 2)
		end
		kit.Triangle(body, x + 10, 0, 22, 16, C.Lilac, 3)
		local flag = kit.Part(body, x + 10, -6, 12, 8, C.Pink, { Radius = 2, Z = 1 })
		kit.Animate(flag, "Sway", 6, 1.5, x)
	end
	kit.Part(body, 22, 16, 56, 84, stone, { Radius = 26, Z = 1, Shine = true })
	local door = kit.Part(body, 30, 30, 40, 70, Color3.fromRGB(150, 100, 90), { Radius = 20, Z = 3 })
	for k = 0, 3 do
		kit.Box(door, 5 + k * 9, 4, 3, 66, C.Gold, 0, 2)
	end
	for k = 0, 2 do
		kit.Box(door, 0, 18 + k * 18, 40, 3, C.Gold, 0, 2)
	end
	kit.Heart(body, 50, 22, 14, C.Heart, 0, 4)
	return nil
end

-- Caneton dans son nid (trottine, picore)
Art.Duckling = function(body, kit, _item)
	local C = kit.C
	local yellow = Color3.fromRGB(255, 230, 120)
	-- nid (sa maison)
	kit.Blob(body, 50, 90, 90, 20, C.WoodLight, { Z = 1 })
	for k = 0, 5 do
		kit.Line(body, 10 + k * 14, 84, 22 + k * 14, 96, 1.5, C.Wood, 0.2, 2)
	end
	local duck = breather(body, kit, 0, 0, 100, 90, 3)
	duck.Name = "Pet"
	kit.Blob(duck, 54, 66, 50, 36, yellow, { Z = 1, Shine = true })
	local wing = kit.Pivot(duck, 62, 64, 2)
	kit.Blob(wing, 4, 2, 20, 14, kit.Darken(yellow, 0.06), { Rotation = -20 })
	kit.Animate(wing, "Sway", 10, 1.4, 0)
	kit.Blob(duck, 36, 44, 32, 30, yellow, { Z = 3, Shine = true })
	kit.Face(duck, 36, 44, 22, { Mouth = "none", Z = 4 })
	kit.Part(duck, 14, 46, 14, 8, C.Orange, { Radius = 4, Z = 5 })
	kit.Blob(duck, 38, 28, 6, 8, yellow, { Z = 4, Rotation = 20 })
	kit.Animate(duck, "Breathe", 0.03, 1.2, 0)
	return nil
end

-- Petit manchot sur sa banquise (se dandine, écharpe)
Art.Penguin = function(body, kit, _item)
	local C = kit.C
	local navy = Color3.fromRGB(70, 76, 120)
	kit.Blob(body, 50, 92, 94, 18, Color3.fromRGB(226, 242, 255), { Z = 1, Shine = true }) -- banquise
	kit.Blob(body, 50, 97, 94, 8, C.Sky, { Z = 0, Outline = false })
	local bird = breather(body, kit, 0, 0, 100, 92, 3)
	bird.Name = "Pet"
	for _, side in ipairs({ -1, 1 }) do
		local flipper = kit.Pivot(bird, 50 + side * 22, 48, 1)
		kit.Blob(flipper, side * 4, 12, 10, 26, navy, { Rotation = side * -15 })
		kit.Animate(flipper, "Sway", 10, 1.2, side)
	end
	kit.Blob(bird, 50, 56, 48, 64, navy, { Z = 2, Shine = true })
	kit.Blob(bird, 50, 62, 34, 46, WHITE, { Z = 3, Outline = false })
	kit.Face(bird, 50, 42, 24, { Z = 4 })
	kit.Diamond(bird, 50, 48, 6, C.Orange, 0, 5)
	kit.Part(bird, 30, 52, 40, 8, C.Pink, { Radius = 4, Z = 5 }) -- écharpe
	kit.Part(bird, 58, 56, 8, 16, C.Pink, { Radius = 3, Z = 5, Rotation = -10 })
	for _, x in ipairs({ 40, 60 }) do
		kit.Blob(bird, x, 88, 14, 6, C.Orange, { Z = 4 })
	end
	kit.Animate(bird, "Sway", 4, 1.4, 0)
	return nil
end

-- Axolotl dans son aquarium (nage de gauche à droite, bulles)
Art.Axolotl = function(body, kit, _item)
	local C = kit.C
	local pink = Color3.fromRGB(255, 176, 206)
	local tank = kit.Part(body, 6, 26, 88, 72, C.Glass, { Radius = 10, Z = 1, T = 0.2, Shine = true })
	kit.Box(tank, 0, 56, 88, 16, Color3.fromRGB(240, 214, 170), 0, 2) -- sable
	kit.Blob(tank, 16, 50, 10, 24, C.Leaf, { Z = 2 })
	kit.Blob(tank, 72, 48, 10, 28, C.LeafDark, { Z = 2 })
	local swim = kit.Group(body, 0, 0, 100, 100, 3)
	kit.Animate(swim, "Drift", 14, 0.6, 0)
	kit.Blob(swim, 56, 64, 36, 16, pink, { Z = 1, Shine = true })
	kit.Blob(swim, 76, 64, 16, 8, pink, { Z = 1 })
	local head = kit.Blob(swim, 40, 60, 26, 22, pink, { Z = 2, Shine = true })
	kit.Face(head, 13, 12, 16, { Z = 3 })
	for _, side in ipairs({ -1, 1 }) do
		for k = 0, 2 do
			kit.Blob(swim, 40 + side * (14 + k * 2), 52 + k * 5, 8, 4, C.PinkDeep, { Z = 1, Rotation = side * (20 + k * 20), Thickness = 1 })
		end
	end
	for index = 0, 2 do
		local bubble = kit.Circle(body, 30 + index * 16, 40 - index * 5, 6, 6, WHITE, 0.4, 4)
		kit.Animate(bubble, "Bob", 4, 1, index)
	end
	kit.Part(body, 2, 22, 96, 8, C.Mint, { Radius = 3, Z = 5 }) -- couvercle
	return nil
end

-- Chouette endormie sur sa branche (s'envole la nuit… et le jour !)
Art.Owl = function(body, kit, _item)
	local C = kit.C
	local brown = Color3.fromRGB(190, 150, 120)
	-- branche + petites feuilles (sa maison)
	kit.Part(body, 4, 84, 92, 10, C.WoodDark, { Radius = 5, Z = 1 })
	kit.Part(body, 44, 92, 10, 8, C.WoodDark, { Radius = 3, Z = 1 })
	kit.Blob(body, 10, 82, 14, 8, C.Leaf, { Z = 2, Rotation = -20 })
	kit.Blob(body, 90, 82, 14, 8, C.Leaf, { Z = 2, Rotation = 20 })
	local owl = kit.Pivot(body, 50, 84, 3)
	owl.Name = "Pet"
	local g = breather(owl, kit, -30, -70, 60, 70, 1)
	for _, side in ipairs({ -1, 1 }) do
		local ear = kit.Part(g, 30 + side * 16 - 6, 4, 12, 12, brown, { Radius = 3, Z = 1, Rotation = 45 })
		local _ = ear
		local wing = kit.Pivot(g, 30 + side * 22, 34, 2)
		kit.Blob(wing, side * 2, 12, 14, 30, kit.Darken(brown, 0.1), { Rotation = side * -10 })
		kit.Animate(wing, "Sway", 6, 1, side)
	end
	kit.Blob(g, 30, 40, 50, 60, brown, { Z = 3, Shine = true })
	kit.Blob(g, 30, 48, 30, 34, C.Cream, { Z = 4, Outline = false })
	for _, side in ipairs({ -1, 1 }) do
		kit.Circle(g, 30 + side * 10, 26, 18, 18, C.Cream, 0, 5)
	end
	kit.Face(g, 30, 26, 30, { Eyes = "closed", Mouth = "none", Z = 6 })
	kit.Diamond(g, 30, 33, 6, C.Orange, 0, 7)
	for _, x in ipairs({ 24, 36 }) do
		kit.Blob(g, x, 70, 8, 5, C.Orange, { Z = 7 })
	end
	kit.Animate(g, "Breathe", 0.03, 0.8, 0)
	local zzz = kit.Text(body, "z", 80, 20, 12, C.Lilac, 6)
	zzz.Name = "PetZ" -- (s'envole avec la chouette)
	kit.Animate(zzz, "Bob", 2, 0.6, 0.3)
	return nil
end

return Art
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="29">
              <Properties>
                <string name="Name">PetFurniture</string>
                <string name="Source"><![CDATA[--[[
	PetFurniture (ModuleScript) — dessins 🐾 des affaires des animaux :
	gamelle, panier de jouets, coussin, griffoir, fontaine, niche, cage à
	oiseaux, arbre à chat. Les animaux posés dans la pièce viennent s'en
	servir (House/HousePets + House/HouseSurfaces : places "PetSpots").
	Emplacement : ReplicatedStorage > Client > Components > House > Art > PetFurniture
	Contrat : voir HouseArt (boîte 100 x 100, pieds en bas pour les objets au sol).
]]

local Art = {}

----------------------------------------------------------------------
-- Aides communes
----------------------------------------------------------------------

-- Empreinte de patte (coussinet + 3 doigts)
local function paw(parent, kit, cx, cy, size, color, t, z)
	kit.Blob(parent, cx, cy + size * 0.12, size * 0.56, size * 0.46, color, { Z = z, T = t, Outline = false, Shade = false })
	for _, d in ipairs({ { -0.34, -0.26 }, { 0, -0.42 }, { 0.34, -0.26 } }) do
		kit.Circle(parent, cx + d[1] * size, cy + d[2] * size, size * 0.24, size * 0.26, color, t or 0, z)
	end
end

-- Petit os (deux boules à chaque bout)
local function bone(parent, kit, cx, cy, length, color, rotation, z)
	local p = kit.Pivot(parent, cx, cy, z)
	p.Rotation = rotation or 0
	local r = length * 0.26
	kit.Part(p, -length / 2 + r * 0.5, -r * 0.42, length - r, r * 0.84, color, { Radius = -1, Z = 1, Thickness = 1.2, Shade = false })
	for _, side in ipairs({ -1, 1 }) do
		for _, dy in ipairs({ -1, 1 }) do
			kit.Circle(p, side * (length / 2 - r * 0.45), dy * r * 0.36, r * 0.9, r * 0.9, color, 0, 2)
		end
	end
	return p
end

-- Corde de sisal (poteau à griffer) : bande beige + rayures
local function sisal(parent, kit, x, y, w, h, z)
	local C = kit.C
	local rope = Color3.fromRGB(236, 214, 170)
	local post = kit.Part(parent, x, y, w, h, rope, { Radius = 3, Z = z, Shade = 0.1 })
	kit.Gradient(post, Color3.fromRGB(255, 255, 255), Color3.fromRGB(226, 226, 226), 0)
	local line = kit.Darken(rope, 0.18)
	local step = 5
	local yy = 3
	while yy < h - 2 do
		kit.Box(post, 1, yy, w - 2, 1.4, line, 0.25, 2)
		yy += step
	end
	-- griffures
	kit.Line(post, w * 0.3, h * 0.3, w * 0.45, h * 0.46, 1.2, C.White, 0.3, 3)
	kit.Line(post, w * 0.55, h * 0.32, w * 0.7, h * 0.48, 1.2, C.White, 0.3, 3)
	return post
end

----------------------------------------------------------------------
-- Dessins
----------------------------------------------------------------------

-- Gamelle rose avec une patte, pleine de croquettes, et un petit os
Art.PetBowl = function(body, kit, _item)
	local C = kit.C
	local bowl = C.Pink
	-- croquettes (derrière le rebord)
	local kibble = { Color3.fromRGB(196, 132, 92), Color3.fromRGB(226, 164, 110), Color3.fromRGB(176, 112, 80) }
	for index, k in ipairs({ { 30, 60 }, { 40, 56 }, { 50, 54 }, { 60, 56 }, { 70, 60 }, { 36, 64 }, { 46, 61 }, { 56, 61 }, { 65, 64 } }) do
		kit.Blob(body, k[1], k[2], 11, 9, kibble[index % 3 + 1], { Z = 2, Thickness = 1.1, Shade = false })
	end
	kit.Heart(body, 50, 51, 9, C.Heart, 0, 3)
	-- bol
	local base = kit.Part(body, 12, 64, 76, 32, bowl, { Radius = 14, Z = 4, Shade = 0.2 })
	kit.Gradient(base, Color3.fromRGB(255, 255, 255), Color3.fromRGB(225, 225, 225), 90)
	kit.Part(body, 6, 60, 88, 11, kit.Lighten(bowl, 0.25), { Radius = -1, Z = 5, Shine = true })
	kit.Part(body, 18, 92, 64, 7, kit.Darken(bowl, 0.12), { Radius = -1, Z = 3, Shade = false })
	paw(body, kit, 50, 80, 16, C.White, 0.1, 6)
	-- os à côté
	bone(body, kit, 86, 93, 20, C.Cream, -18, 7)
	local spark = kit.Sparkle(body, 18, 48, 8, C.Butter, 0, 7)
	kit.Animate(spark, "Bob", 2, 0.8, 0.4)
	return nil
end

-- Panier en osier rempli de jouets : balle de tennis, os, souris, corde
Art.PetToys = function(body, kit, _item)
	local C = kit.C
	-- jouets qui dépassent (derrière le rebord)
	local rope = kit.Pivot(body, 30, 52, 2)
	rope.Rotation = -24
	kit.Part(rope, -4, -24, 8, 30, C.Sky, { Radius = -1, Z = 1, Thickness = 1.2 })
	for k = 0, 3 do
		kit.Line(rope, -4, -20 + k * 7, 4, -16 + k * 7, 1.5, C.White, 0.2, 2)
	end
	kit.Blob(rope, 0, -26, 10, 7, C.PinkDeep, { Z = 3, Thickness = 1.1 })
	bone(body, kit, 64, 42, 30, C.Cream, 28, 3)
	-- souris en peluche
	local mouse = kit.Group(body, 36, 36, 26, 22, 4)
	kit.Circle(mouse, 6, 5, 9, 9, C.Grey, 0, 1)
	kit.Circle(mouse, 6, 5, 5, 5, C.PinkSoft, 0, 2)
	kit.Blob(mouse, 14, 13, 22, 16, C.Grey, { Z = 3, Shine = true })
	kit.Face(mouse, 11, 13, 12, { Mouth = "none", Z = 4 })
	-- balle de tennis (elle rebondit un peu)
	local ball = kit.Group(body, 58, 44, 22, 22, 5)
	local b = kit.Blob(ball, 11, 11, 21, 21, Color3.fromRGB(214, 240, 110), { Z = 1, Shine = true })
	kit.Line(b, 3, 6, 10, 11, 1.6, C.White, 0, 2)
	kit.Line(b, 10, 11, 18, 5, 1.6, C.White, 0, 2)
	kit.Animate(ball, "Bob", 1.6, 1.3, 0.2)
	-- panier
	local basket = kit.Part(body, 10, 60, 80, 38, C.WoodLight, { Radius = 12, Z = 6, Shade = 0.18 })
	for _, y in ipairs({ 11, 19, 27 }) do
		kit.Box(basket, 3, y, 74, 2, C.Wood, 0.1, 2)
	end
	for x = 10, 70, 12 do
		kit.Box(basket, x, 4, 2, 30, C.Wood, 0.45, 2)
	end
	kit.Part(body, 5, 56, 90, 10, C.Wood, { Radius = -1, Z = 7, Shine = true })
	-- étiquette cœur
	kit.Part(body, 40, 72, 20, 16, C.PinkSoft, { Radius = 5, Z = 8 })
	kit.Heart(body, 50, 80, 10, C.Heart, 0, 9)
	return nil
end

-- Coussin rond pour animaux : gros boudin lilas, fond crème, os en peluche
Art.PetBed = function(body, kit, _item)
	local C = kit.C
	local rim = Color3.fromRGB(196, 170, 246)
	-- boudin arrière
	kit.Blob(body, 50, 66, 94, 40, rim, { Z = 1, Shade = 0.15 })
	-- coussin intérieur
	local cushion = kit.Blob(body, 50, 76, 76, 24, C.Cream, { Z = 2, Thickness = 1.4, Shade = 0.1 })
	for _, s in ipairs({ { 28, 10 }, { 50, 7 }, { 72, 11 } }) do
		kit.Circle(cushion, s[1], s[2], 3, 3, C.PinkSoft, 0, 2)
	end
	-- os en peluche
	bone(body, kit, 70, 74, 24, C.White, -14, 3)
	-- boudin avant (plus bas : on voit dedans)
	kit.Part(body, 4, 80, 92, 19, kit.Lighten(rim, 0.1), { Radius = -1, Z = 4, Shine = true, Shade = 0.2 })
	for _, x in ipairs({ 22, 50, 78 }) do
		kit.Line(body, x, 82, x, 96, 1.4, kit.Darken(rim, 0.15), 0.35, 5)
	end
	paw(body, kit, 50, 89.5, 9, C.White, 0.15, 5)
	for index, h in ipairs({ { 20, 50, 7 }, { 82, 46, 6 } }) do
		local heart = kit.Heart(body, h[1], h[2], h[3], C.Pink, 0.1, 6)
		kit.Animate(heart, "Bob", 1.5, 0.7, index * 1.7)
	end
	return nil
end

-- Griffoir : socle moquette, poteau de sisal griffé, plateau rond et pompon qui se balance
Art.ScratchingPost = function(body, kit, _item)
	local C = kit.C
	local carpet = Color3.fromRGB(255, 186, 206)
	-- socle
	kit.Part(body, 10, 86, 80, 12, carpet, { Radius = 5, Z = 1, Shine = true, Shade = 0.2 })
	kit.Part(body, 14, 96, 72, 4, kit.Darken(carpet, 0.2), { Radius = -1, Z = 0, Shade = false })
	-- poteau
	sisal(body, kit, 39, 22, 22, 66, 2)
	-- plateau
	kit.Part(body, 22, 14, 56, 11, carpet, { Radius = -1, Z = 3, Shine = true })
	kit.Part(body, 26, 9, 48, 9, kit.Lighten(carpet, 0.35), { Radius = -1, Z = 4, Thickness = 1.3, Shade = false })
	-- pompon au bout d'une ficelle (pendule)
	local toy = kit.Pivot(body, 72, 22, 5)
	kit.Line(toy, 0, 0, 0, 30, 1.2, C.GreyDark, 0.2, 1)
	kit.Blob(toy, 0, 34, 12, 12, C.Lilac, { Z = 2, Shine = true })
	kit.Circle(toy, -2, 32, 3, 3, C.White, 0.3, 3)
	kit.Animate(toy, "Sway", 12, 0.9, 0.3)
	-- pattes brodées sur le socle
	paw(body, kit, 22, 92, 7, C.White, 0.2, 2)
	paw(body, kit, 78, 92, 7, C.White, 0.2, 2)
	return nil
end

-- Fontaine à eau : vasque ronde, dôme menthe souriant, jet d'eau et bulles
Art.PetFountain = function(body, kit, _item)
	local C = kit.C
	local mint = Color3.fromRGB(150, 222, 214)
	-- bec verseur et gouttes qui retombent en arc dans la vasque
	for index, d in ipairs({ { 55, 24, 6 }, { 62, 22, 5.5 }, { 69, 26, 5 }, { 74, 34, 4.5 }, { 77, 44, 4 }, { 79, 54, 3.5 } }) do
		local drop = kit.Circle(body, d[1], d[2], d[3], d[3], kit.Lighten(C.Sky, 0.15), 0.05, 6)
		kit.Stroke(drop, kit.Darken(C.Sky, 0.1), 1, 0.3)
		kit.Animate(drop, "Pulse", 0.5, 2.2, -index * 0.45)
	end
	-- dôme
	local dome = kit.Blob(body, 50, 56, 50, 44, mint, { Z = 3, Shine = true })
	kit.Face(dome, 25, 22, 24, { Eyes = "happy", Mouth = "smile", Z = 4 })
	kit.Part(body, 44, 26, 12, 10, kit.Darken(mint, 0.15), { Radius = 4, Z = 4, Shine = true })
	kit.Part(body, 46, 21, 12, 6, kit.Darken(mint, 0.1), { Radius = -1, Z = 5 })
	-- vasque et eau
	kit.Part(body, 6, 70, 88, 16, kit.Lighten(C.Sky, 0.25), { Radius = -1, Z = 5, T = 0.05, Shine = true })
	local water = kit.Part(body, 12, 72, 76, 6, C.Sky, { Radius = -1, Z = 6, Outline = false, Shade = false })
	kit.Animate(water, "Pulse", 0.3, 1, 1.2)
	kit.Part(body, 10, 80, 80, 18, mint, { Radius = 8, Z = 7, Shade = 0.22 })
	paw(body, kit, 50, 89, 8, C.White, 0.15, 8)
	for index, b in ipairs({ { 28, 66, 5 }, { 72, 64, 4 }, { 20, 58, 3 } }) do
		local bubble = kit.Circle(body, b[1], b[2], b[3], b[3], C.White, 0.4, 8)
		kit.Stroke(bubble, C.Sky, 1, 0.2)
		kit.Animate(bubble, "Bob", 2, 0.9, index * 1.3)
	end
	return nil
end

-- Niche : toit de tuiles rose avec un cœur, planches crème, porte ronde, écriteau os
Art.DogHouse = function(body, kit, _item)
	local C = kit.C
	local wall = Color3.fromRGB(255, 226, 196)
	local roof = Color3.fromRGB(240, 120, 140)
	local plank = kit.Darken(wall, 0.12)
	-- murs
	local walls = kit.Part(body, 14, 44, 72, 54, wall, { Radius = 4, Z = 2, Shade = 0.14 })
	for _, y in ipairs({ 13, 26, 39 }) do
		kit.Box(walls, 2, y, 68, 1.6, plank, 0.2, 2)
	end
	-- porte (arche sombre)
	local door = kit.Group(body, 33, 58, 34, 40, 3, true)
	kit.Part(door, 0, 0, 34, 60, Color3.fromRGB(92, 62, 86), { Radius = -1, Z = 1, Thickness = 1.8, Shade = 0.25 })
	kit.Blob(door, 17, 44, 30, 12, Color3.fromRGB(70, 46, 70), { Z = 2, Outline = false, Shade = false })
	kit.Part(body, 31, 56, 38, 5, C.Cream, { Radius = -1, Z = 4 })
	-- toit
	kit.Triangle(body, 50, 6, 104, 44, roof, 5, 0, 30)
	-- reflet sur le pan gauche du toit
	kit.Line(body, 30, 36, 46, 16, 2.4, kit.Lighten(roof, 0.4), 0.2, 6)
	-- tuiles en festons
	for index = 0, 4 do
		kit.Circle(body, 12 + index * 19, 49, 20, 10, kit.Darken(roof, 0.08), 0, 6)
	end
	kit.Part(body, 0, 42, 100, 6, kit.Darken(roof, 0.15), { Radius = -1, Z = 7, Shine = true })
	local heart = kit.Heart(body, 50, 26, 14, C.White, 0.05, 7)
	kit.Animate(heart, "Breathe", 0.06, 1.2, 0.3)
	-- écriteau os au-dessus de la porte (il se balance)
	local sign = kit.Pivot(body, 50, 45, 8)
	kit.Line(sign, -6, 0, -6, 5, 1, C.GreyDark, 0.2, 1)
	kit.Line(sign, 6, 0, 6, 5, 1, C.GreyDark, 0.2, 1)
	bone(sign, kit, 0, 8, 22, C.Cream, 0, 2)
	kit.Animate(sign, "Sway", 3, 0.7, 0.8)
	-- petite gamelle devant
	kit.Part(body, 76, 88, 20, 10, C.Sky, { Radius = 4, Z = 8, Shine = true })
	kit.Part(body, 74, 86, 24, 4, kit.Lighten(C.Sky, 0.3), { Radius = -1, Z = 9 })
	return nil
end

-- Cage à oiseaux dorée : dôme de barreaux, anneau, balançoire, mangeoire et socle
Art.BirdCage = function(body, kit, _item)
	local C = kit.C
	local gold = C.Gold
	local line = kit.Darken(gold, 0.2)
	-- fond de la cage (verre bleuté léger)
	kit.Blob(body, 50, 36, 64, 44, C.Glass, { Z = 1, T = 0.55, Outline = false, Shade = false })
	kit.Part(body, 18, 36, 64, 44, C.Glass, { Radius = 2, Z = 1, T = 0.55, Outline = false, Shade = false })
	-- balançoire (pendule)
	local swing = kit.Pivot(body, 50, 20, 3)
	kit.Line(swing, -9, 0, -9, 34, 1.2, line, 0, 1)
	kit.Line(swing, 9, 0, 9, 34, 1.2, line, 0, 1)
	kit.Part(swing, -13, 33, 26, 4, C.Wood, { Radius = -1, Z = 2 })
	kit.Heart(swing, 0, 44, 7, C.Pink, 0.1, 2)
	kit.Animate(swing, "Sway", 6, 0.8, 0.2)
	-- mangeoire
	kit.Part(body, 22, 66, 14, 8, C.Sky, { Radius = 3, Z = 3, Shine = true })
	kit.Circle(body, 26, 66, 3, 3, C.Butter, 0, 4)
	kit.Circle(body, 31, 66, 3, 3, C.Butter, 0, 4)
	-- barreaux (dôme = arc + montants)
	local dome = kit.Blob(body, 50, 36, 66, 46, gold, { Z = 5, T = 1, Outline = gold, Thickness = 2.6, Shade = false })
	dome.BackgroundTransparency = 1
	for _, x in ipairs({ 17, 83 }) do
		kit.Line(body, x, 34, x, 82, 2.6, gold, 0, 5)
	end
	for _, x in ipairs({ 30, 42, 50, 58, 70 }) do
		local top = 36 - math.sqrt(math.max(0, 1 - ((x - 50) / 33) ^ 2)) * 22
		kit.Line(body, x, top + 1, x, 82, 1.6, gold, 0.1, 5)
	end
	kit.Line(body, 17, 54, 83, 54, 1.4, gold, 0.2, 5)
	-- anneau et petit cœur en haut
	local ring = kit.Circle(body, 50, 5, 9, 9, gold, 1, 6)
	kit.Stroke(ring, gold, 2)
	kit.Blob(body, 50, 13, 9, 7, gold, { Z = 6, Shine = true })
	-- base et pied
	kit.Part(body, 12, 78, 76, 10, C.PinkSoft, { Radius = -1, Z = 6, Shine = true })
	kit.Part(body, 44, 88, 12, 6, gold, { Radius = 2, Z = 5 })
	kit.Part(body, 30, 93, 40, 6, C.Pink, { Radius = -1, Z = 6, Shade = 0.2 })
	local note = kit.Text(body, "🎵", 84, 18, 12, C.Purple, 7)
	kit.Animate(note, "Bob", 2, 0.8, 1.2)
	return nil
end

-- Arbre à chat : socle, poteaux de sisal, niche ronde, plateau bas et
-- coussin tout en haut, pompons qui pendent
Art.CatTree = function(body, kit, _item)
	local C = kit.C
	local carpet = Color3.fromRGB(206, 186, 250)
	local carpetB = Color3.fromRGB(255, 196, 214)
	-- socle
	kit.Part(body, 4, 88, 92, 10, carpet, { Radius = 5, Z = 1, Shine = true, Shade = 0.2 })
	-- poteaux
	sisal(body, kit, 68, 62, 10, 28, 2)
	sisal(body, kit, 22, 80, 10, 10, 2)
	sisal(body, kit, 30, 22, 10, 34, 2)
	-- niche (cube avec trou rond)
	local cube = kit.Part(body, 6, 52, 42, 30, carpetB, { Radius = 7, Z = 3, Shine = true, Shade = 0.18 })
	kit.Blob(cube, 21, 17, 18, 18, Color3.fromRGB(110, 70, 100), { Z = 2, Thickness = 1.4, Shade = 0.3 })
	paw(cube, kit, 36, 7, 6, C.White, 0.25, 2)
	-- plateau bas (à droite)
	kit.Part(body, 52, 56, 44, 9, carpetB, { Radius = -1, Z = 4, Shine = true })
	-- coussin rond tout en haut
	kit.Part(body, 12, 14, 48, 12, carpet, { Radius = -1, Z = 4, Shine = true })
	kit.Part(body, 16, 9, 40, 8, kit.Lighten(carpet, 0.35), { Radius = -1, Z = 5, Thickness = 1.3, Shade = false })
	kit.Heart(body, 36, 20, 7, C.White, 0.1, 6)
	-- pompons
	for index, p in ipairs({ { 90, 64, C.Butter, 22 }, { 14, 25, C.Mint, 16 } }) do
		local toy = kit.Pivot(body, p[1], p[2], 6)
		kit.Line(toy, 0, 0, 0, p[4], 1.1, C.GreyDark, 0.2, 1)
		kit.Blob(toy, 0, p[4] + 4, 9, 9, p[3], { Z = 2, Shine = true })
		kit.Animate(toy, "Sway", 10, 0.8, index * 1.4)
	end
	return nil
end

return Art
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="30">
              <Properties>
                <string name="Name">Pets</string>
                <string name="Source"><![CDATA[--[[
	Pets (ModuleScript) — dessins des animaux 🐾 (ils respirent, clignent des yeux, remuent la queue)
	Emplacement : ReplicatedStorage > Client > Components > House > Art > Pets
	Contrat : voir HouseArt (boîte 100 x 100, pieds en bas pour les objets au sol).
	Les parties "animal" de chaque dessin sont rangées dans des groupes dont le
	nom commence par "Pet" (le reste = sa maison : coquille, panier, perchoir,
	trésor) : House/HousePets fait se promener l'animal seul dans la pièce.
	"PetWalk" (caché) = pose debout du chat pour marcher.
]]

local Art = {}

local HALF_PI = math.pi / 2 -- décalage de phase pour un balancement "en miroir"

----------------------------------------------------------------------
-- Aides communes
----------------------------------------------------------------------

-- Conteneur qui respire : UIScale autour du bas-centre (les pattes restent au sol)
-- les enfants se placent par rapport au coin (x, y)
local function breather(parent, kit, x, y, w, h, z)
	local g = kit.Group(parent, x, y, w, h, z)
	g.AnchorPoint = Vector2.new(0.5, 1)
	g.Position = UDim2.fromOffset(x + w / 2, y + h)
	return g
end

-- Oreille pointue : carré arrondi tourné à 45° (la pointe dépasse de la tête), intérieur rose
local function ear(parent, kit, cx, cy, size, color, inner, tilt, z)
	local frame = kit.Part(parent, cx - size / 2, cy - size / 2, size, size, color, {
		Radius = size * 0.24,
		Rotation = 45 + tilt,
		Z = z,
		Shade = false,
	})
	if inner then
		kit.Part(frame, size * 0.2, size * 0.2, size * 0.46, size * 0.46, inner, {
			Radius = size * 0.14,
			Z = 2,
			Outline = false,
			Shade = false,
		})
	end
	return frame
end

-- Petit museau : truffe + bouche en ω
local function snout(parent, kit, x, y, size, z)
	local C = kit.C
	kit.Blob(parent, x, y, size * 0.5, size * 0.34, C.Ink, { Z = z, Outline = false, Shade = false })
	local t = math.max(1, size * 0.1)
	for _, side in ipairs({ -1, 1 }) do
		kit.Line(parent, x, y + size * 0.1, x + side * size * 0.2, y + size * 0.38, t, C.Ink, 0, z)
		kit.Line(parent, x + side * size * 0.2, y + size * 0.38, x + side * size * 0.4, y + size * 0.22, t, C.Ink, 0, z)
	end
end

----------------------------------------------------------------------
-- Dessins
----------------------------------------------------------------------

-- Poussin : boule jaune qui sort de sa coquille, toupet et petites ailes qui battent
Art.Chick = function(body, kit, _item)
	local C = kit.C
	local yellow = Color3.fromRGB(255, 222, 110)
	local wingColor = Color3.fromRGB(255, 205, 90)
	local chick = breather(body, kit, 0, 0, 100, 92, 3)
	chick.Name = "Pet"
	local tuft = kit.Pivot(chick, 50, 36, 1)
	kit.Blob(tuft, -3.5, -3, 4, 9, yellow, { Rotation = -35, Thickness = 1.3 })
	kit.Blob(tuft, 0, -5, 4.5, 11, yellow, { Rotation = 0, Thickness = 1.3 })
	kit.Blob(tuft, 3.5, -3, 4, 9, yellow, { Rotation = 35, Thickness = 1.3 })
	kit.Animate(tuft, "Sway", 8, 1.1, 0.4)
	for index, side in ipairs({ -1, 1 }) do
		local wing = kit.Pivot(chick, 50 + side * 22, 58, 1)
		kit.Blob(wing, side * 5, 3, 13, 18, wingColor, { Rotation = side * -35, Thickness = 1.4 })
		kit.Animate(wing, "Sway", 14, 1.6, (index - 1) * HALF_PI)
	end
	kit.Blob(chick, 50, 62, 54, 50, yellow, { Z = 2, Shine = true })
	kit.Face(chick, 50, 58, 30, { Mouth = "none", Z = 4 })
	kit.Diamond(chick, 50, 63.5, 6.5, C.Orange, 0, 5)
	kit.Animate(chick, "Breathe", 0.03, 1, 0.2)
	-- coquille
	local shell = kit.Group(body, 14, 74, 72, 26, 5, true)
	kit.Blob(shell, 36, 0, 68, 52, C.Cream, { Z = 1, Thickness = 1.8, Shade = 0.2 })
	local shellLine = kit.OutlineOf(C.Cream)
	for k = 0, 5 do
		local d = kit.Diamond(body, 22 + k * 11.2, 75.5, 8, C.Cream, 0, 6)
		kit.Stroke(d, shellLine, 1.4)
	end
	kit.Box(body, 18, 75.5, 64, 6, C.Cream, 0, 7)
	return nil
end

-- Poisson rouge dans son bocal rond : il nage, les bulles montent, l'algue ondule
Art.Goldfish = function(body, kit, _item)
	local C = kit.C
	local glassLine = Color3.fromRGB(130, 175, 215)
	-- eau (bas du bocal)
	local water = kit.Group(body, 8, 34, 84, 66, 2, true)
	kit.Blob(water, 42, 26, 84, 76, C.Sky, { Z = 1, T = 0.45, Outline = false, Shade = 0.25 })
	kit.Part(body, 21, 32, 58, 5, kit.Lighten(C.Sky, 0.5), { Radius = -1, Z = 3, T = 0.15, Outline = false, Shade = false })
	for _, p in ipairs({ { 38, 90, C.Pink }, { 47, 93, C.Butter }, { 57, 92, C.Mint }, { 65, 89, C.Lilac } }) do
		kit.Blob(body, p[1], p[2], 9, 6, p[3], { Z = 3, Thickness = 1.1, Shade = false })
	end
	local weed = kit.Pivot(body, 30, 90, 3)
	kit.Blob(weed, -1, -12, 6, 24, C.Green, { Rotation = -8, Thickness = 1.2, Shade = false })
	kit.Blob(weed, 5, -9, 5, 18, C.Leaf, { Rotation = 12, Thickness = 1.2, Shade = false })
	kit.Animate(weed, "Sway", 7, 0.8, 1.2)
	-- poisson
	local fish = kit.Group(body, 34, 46, 38, 28, 5)
	local orange, fin = Color3.fromRGB(255, 150, 80), Color3.fromRGB(255, 190, 130)
	local tail = kit.Pivot(fish, 8, 14, 1)
	kit.Blob(tail, -5, -5, 13, 10, fin, { Rotation = -35, Thickness = 1.3 })
	kit.Blob(tail, -5, 5, 13, 10, fin, { Rotation = 35, Thickness = 1.3 })
	kit.Animate(tail, "Sway", 12, 2.2, 0)
	kit.Blob(fish, 19, 3, 11, 8, fin, { Z = 1, Rotation = -20, Thickness = 1.3 })
	kit.Blob(fish, 22, 14, 30, 22, orange, { Z = 2, Shine = true })
	kit.Face(fish, 27, 14, 17, { Mouth = "smile", Spacing = 0.64, Z = 4 })
	kit.Animate(fish, "Drift", 7, 0.35, 0)
	for index, b in ipairs({ { 70, 44, 5 }, { 74, 36, 3.5 }, { 66, 60, 4 } }) do
		local bubble = kit.Circle(body, b[1], b[2], b[3], b[3], C.White, 0.5, 6)
		kit.Stroke(bubble, C.White, 1, 0.1)
		kit.Animate(bubble, "Bob", 2, 0.8, index * 1.9)
	end
	-- bocal
	kit.Blob(body, 50, 60, 84, 76, C.Glass, { Z = 7, T = 0.82, Outline = glassLine, Thickness = 2, Shade = false })
	kit.Part(body, 28, 18, 44, 8, C.Glass, { Radius = -1, Z = 8, T = 0.35, Outline = glassLine })
	kit.Shine(body, 18, 46, 5, 20, 9, 0.35)
	kit.Shine(body, 20, 70, 4, 5, 9, 0.45)
	return nil
end

-- Chat endormi roulé en boule dans son panier : yeux fermés, "z" qui flottent, queue qui pend
Art.SleepyCat = function(body, kit, _item)
	local C = kit.C
	local fur = Color3.fromRGB(215, 210, 232)
	local stripe = Color3.fromRGB(170, 160, 200)
	kit.Blob(body, 50, 68, 84, 16, C.PinkSoft, { Z = 2 })
	local cat = breather(body, kit, 0, 0, 100, 76, 3)
	cat.Name = "Pet"
	kit.Blob(cat, 58, 58, 58, 32, fur, { Z = 2, Shine = true })
	for _, s in ipairs({ { 56, 44 }, { 65, 44 }, { 74, 46 } }) do
		kit.Line(cat, s[1], s[2], s[1] + 1.5, s[2] + 6, 2.6, stripe, 0, 3)
	end
	ear(cat, kit, 21, 44, 12, fur, C.Pink, -22, 1)
	ear(cat, kit, 39, 41, 12, fur, C.Pink, 10, 1)
	kit.Blob(cat, 31, 57, 36, 30, fur, { Z = 4, Shine = true })
	kit.Line(cat, 31, 42.5, 31, 47, 2.4, stripe, 0, 5)
	kit.Face(cat, 31, 59, 24, { Eyes = "closed", Mouth = "cat", Z = 6 })
	kit.Animate(cat, "Breathe", 0.03, 0.6, 0)
	-- panier
	kit.Part(body, 8, 70, 84, 30, C.WoodLight, { Radius = 12, Z = 5, Shade = 0.18 })
	for _, y in ipairs({ 81, 89 }) do
		kit.Box(body, 10, y, 80, 2, C.Wood, 0, 6)
	end
	kit.Part(body, 4, 66, 92, 10, C.Wood, { Radius = -1, Z = 6, Shine = true })
	-- pattes posées sur le rebord, queue, z z z (devant le panier)
	local front = kit.Group(body, 0, 0, 100, 100, 7)
	front.Name = "PetFront"
	for _, x in ipairs({ 28, 40 }) do
		kit.Blob(front, x, 67, 10, 7, C.White, { Z = 2, Thickness = 1.3 })
	end
	-- queue qui pend du panier
	local tail = kit.Pivot(front, 84, 66, 2)
	tail.Name = "Tail" -- (cachée quand le chat dort ailleurs que dans son panier)
	kit.Blob(tail, 3, 11, 9, 26, fur, { Rotation = -10, Thickness = 1.5 })
	kit.Line(tail, 0.5, 8, 6.5, 8, 2.2, stripe, 0, 2)
	kit.Line(tail, 1.5, 15, 7.5, 15, 2.2, stripe, 0, 2)
	kit.Animate(tail, "Sway", 6, 0.5, 0.8)
	-- z z z
	for index, z in ipairs({ { "z", 56, 36, 11 }, { "z", 66, 25, 14 }, { "Z", 78, 13, 17 } }) do
		local label = kit.Text(front, z[1], z[2], z[3], z[4], index == 2 and C.Purple or C.Lilac, 3)
		kit.Animate(label, "Bob", 2, 0.6, index * 1.4)
	end
	-- pose debout (cachée) : le chat réveillé qui se promène, tourné vers la droite
	local walk = kit.Group(body, 0, 0, 100, 100, 9)
	walk.Name = "PetWalk"
	walk.Visible = false
	local wtail = kit.Pivot(walk, 27, 66, 1)
	kit.Blob(wtail, -5, -15, 9, 32, fur, { Rotation = -18, Thickness = 1.5 })
	kit.Line(wtail, -9, -20, -2, -21, 2.2, stripe, 0, 2)
	kit.Line(wtail, -7, -10, 0, -11, 2.2, stripe, 0, 2)
	kit.Animate(wtail, "Sway", 9, 0.9, 0.4)
	for index, x in ipairs({ 33, 43, 60, 70 }) do
		local leg = kit.Part(walk, x - 5, 80, 10, 18, index % 2 == 0 and kit.Darken(fur, 0.06) or fur, { Radius = 5, Z = 1, Thickness = 1.4 })
		kit.Blob(leg, 5, 16, 11, 6, C.White, { Z = 2, Thickness = 1.1, Shade = false })
	end
	kit.Blob(walk, 50, 74, 56, 30, fur, { Z = 2, Shine = true })
	for _, x in ipairs({ 40, 49, 58 }) do
		kit.Line(walk, x, 60, x + 1.5, 66, 2.6, stripe, 0, 3)
	end
	ear(walk, kit, 64, 40, 13, fur, C.Pink, -16, 3)
	ear(walk, kit, 86, 41, 13, fur, C.Pink, 18, 3)
	kit.Blob(walk, 75, 55, 36, 31, fur, { Z = 4, Shine = true })
	kit.Line(walk, 75, 40.5, 75, 45, 2.4, stripe, 0, 5)
	kit.Face(walk, 77, 57, 24, { Mouth = "cat", Z = 6 })
	kit.Animate(walk, "Breathe", 0.02, 1.2, 0.2)
	return nil
end

-- Petite tortue : carapace à motifs, tête qui sort et hoche doucement
Art.Turtle = function(root, kit, _item)
	local C = kit.C
	local body = kit.Group(root, 0, 0, 100, 100, 1)
	body.Name = "Pet"
	local shellColor = Color3.fromRGB(115, 195, 135)
	local skin = Color3.fromRGB(175, 228, 170)
	for _, x in ipairs({ 24, 58 }) do
		kit.Blob(body, x, 88, 14, 14, skin, { Z = 1, Thickness = 1.4 })
	end
	kit.Blob(body, 7, 78, 10, 6, skin, { Z = 1, Rotation = 20, Thickness = 1.3 })
	local head = kit.Pivot(body, 72, 72, 2)
	kit.Blob(head, 4, -5, 16, 12, skin, { Z = 1, Rotation = -30, Thickness = 1.4 })
	kit.Blob(head, 14, -14, 26, 24, skin, { Z = 2, Shine = true })
	kit.Face(head, 15, -13, 18, { Z = 3 })
	kit.Animate(head, "Bob", 1.2, 0.8, 0.5)
	local shell = breather(body, kit, 0, 0, 90, 84, 3)
	local clip = kit.Group(shell, 6, 32, 72, 44, 1, true)
	kit.Blob(clip, 36, 44, 72, 86, shellColor, { Z = 1, Thickness = 2 })
	local tile = kit.Lighten(shellColor, 0.3)
	kit.Blob(clip, 36, 22, 22, 17, tile, { Z = 2, Thickness = 1.2, Shade = false })
	kit.Heart(clip, 36, 22.5, 8, C.Pink, 0.1, 3)
	kit.Blob(clip, 15, 32, 14, 14, tile, { Z = 2, Thickness = 1.2, Shade = false })
	kit.Blob(clip, 57, 32, 14, 14, tile, { Z = 2, Thickness = 1.2, Shade = false })
	kit.Shine(clip, 18, 12, 12, 4, 3, 0.45)
	kit.Part(shell, 2, 71, 80, 11, kit.Darken(shellColor, 0.06), { Radius = -1, Z = 3, Shade = 0.12 })
	kit.Animate(shell, "Breathe", 0.02, 0.7, 1.1)
	return nil
end

-- Chiot heureux : oreilles tombantes, tache sur l'œil, langue, collier à cœur, queue qui remue
Art.Puppy = function(root, kit, _item)
	local C = kit.C
	local body = kit.Group(root, 0, 0, 100, 100, 1)
	body.Name = "Pet"
	local fur = Color3.fromRGB(255, 238, 215)
	local spot = Color3.fromRGB(215, 160, 115)
	local tail = kit.Pivot(body, 70, 86, 1)
	kit.Blob(tail, 6, -9, 9, 22, spot, { Rotation = 35, Thickness = 1.4 })
	kit.Animate(tail, "Sway", 18, 2.4, 0)
	local pup = breather(body, kit, 0, 0, 100, 98, 2)
	kit.Blob(pup, 50, 78, 48, 38, fur, { Z = 1, Shine = true })
	for _, x in ipairs({ 40, 60 }) do
		kit.Blob(pup, x, 94, 14, 9, fur, { Z = 3, Thickness = 1.4 })
	end
	kit.Part(pup, 33, 63, 34, 7, C.Pink, { Radius = -1, Z = 2 })
	kit.Heart(pup, 50, 72.5, 9, C.Gold, 0, 2)
	kit.Blob(pup, 50, 43, 58, 46, fur, { Z = 3, Shine = true })
	kit.Blob(pup, 62, 39, 16, 14, spot, { Z = 4, Outline = false, Shade = false })
	for index, side in ipairs({ -1, 1 }) do
		local flop = kit.Pivot(pup, 50 + side * 25, 28, 5)
		kit.Blob(flop, side * 2, 13, 16, 29, spot, { Rotation = side * -18, Thickness = 1.5 })
		kit.Animate(flop, "Sway", 4, 1, (index - 1) * HALF_PI)
	end
	kit.Face(pup, 50, 43, 34, { Mouth = "none", Z = 6 })
	kit.Blob(pup, 50, 53, 22, 13, C.White, { Z = 6, Thickness = 1.2, Shade = false })
	snout(pup, kit, 50, 50, 10, 7)
	kit.Animate(pup, "Breathe", 0.025, 1.1, 0.3)
	return nil
end

-- Lapin tout doux : longues oreilles (une tombante), petite carotte, pompon
Art.Bunny = function(root, kit, _item)
	local C = kit.C
	local body = kit.Group(root, 0, 0, 100, 100, 1)
	body.Name = "Pet"
	local fur = Color3.fromRGB(255, 250, 252)
	kit.Circle(body, 75, 88, 14, 14, fur, 0, 1)
	local bun = breather(body, kit, 0, 0, 100, 98, 2)
	for index, e in ipairs({ { 42, -10 }, { 58, 28 } }) do
		local earPivot = kit.Pivot(bun, e[1], 38, 1)
		earPivot.Rotation = e[2]
		kit.Part(earPivot, -6.5, -36, 13, 40, fur, { Radius = -1, Z = 1 })
		kit.Part(earPivot, -3, -31, 6, 28, C.PinkSoft, { Radius = -1, Z = 2, Outline = false, Shade = false })
		kit.Animate(earPivot, "Sway", 4, 0.9, index * 1.7)
	end
	kit.Blob(bun, 50, 80, 46, 34, fur, { Z = 2, Shine = true })
	kit.Blob(bun, 50, 54, 48, 38, fur, { Z = 3, Shine = true })
	kit.Face(bun, 50, 55, 30, { Mouth = "cat", Z = 5 })
	for _, x in ipairs({ 42, 58 }) do
		kit.Blob(bun, x, 94, 13, 8, fur, { Z = 4, Thickness = 1.4 })
	end
	-- carotte
	local carrot = kit.Pivot(bun, 50, 84, 5)
	carrot.Rotation = 25
	kit.Blob(carrot, 3, -7, 7, 11, C.Leaf, { Rotation = 20, Z = 1, Thickness = 1.1 })
	kit.Blob(carrot, -3, -7, 7, 11, C.Green, { Rotation = -20, Z = 1, Thickness = 1.1 })
	kit.Part(carrot, -5, -4, 10, 18, C.Orange, { Radius = 5, Z = 2 })
	kit.Line(carrot, -2, 3, 1, 3, 1.2, kit.Darken(C.Orange, 0.25), 0, 3)
	kit.Animate(bun, "Breathe", 0.025, 0.9, 1.4)
	return nil
end

-- Hamster qui court dans sa roue (la roue tourne, le hamster sautille)
Art.Hamster = function(body, kit, _item)
	local C = kit.C
	kit.Line(body, 50, 50, 28, 96, 4, C.GreyDark, 0, 1)
	kit.Line(body, 50, 50, 72, 96, 4, C.GreyDark, 0, 1)
	kit.Part(body, 18, 93, 64, 7, C.Wood, { Radius = -1, Z = 7, Shine = true })
	local ring = kit.Circle(body, 50, 50, 84, 84, C.Sky, 0.82, 2)
	kit.Stroke(ring, C.Blue, 3.5)
	local wheel = kit.Pivot(body, 50, 50, 3)
	for k = 0, 3 do
		local a = math.rad(k * 45)
		local dx, dy = math.cos(a) * 40, math.sin(a) * 40
		kit.Line(wheel, -dx, -dy, dx, dy, 1.6, C.Blue, 0.45, 1)
	end
	for k = 0, 11 do
		local a = math.rad(k * 30)
		kit.Circle(wheel, math.cos(a) * 40.5, math.sin(a) * 40.5, 3.5, 3.5, C.White, 0, 2)
	end
	kit.Animate(wheel, "Spin", 1, 0.6, 0)
	local hub = kit.Circle(body, 50, 50, 9, 9, C.Sky, 0, 6)
	kit.Stroke(hub, C.Blue, 1.6)
	-- hamster
	local fur = Color3.fromRGB(255, 196, 135)
	local ham = kit.Group(body, 30, 58, 40, 32, 5)
	for _, x in ipairs({ 12, 28 }) do
		kit.Blob(ham, x, 30, 7, 4.5, C.Pink, { Z = 1, Thickness = 1 })
	end
	for _, x in ipairs({ 13, 29 }) do
		local e = kit.Blob(ham, x, 6, 10, 10, fur, { Z = 1, Thickness = 1.3 })
		kit.Circle(e, 5, 5, 5, 5, C.Pink, 0.2, 2)
	end
	kit.Blob(ham, 20, 18, 38, 26, fur, { Z = 2, Shine = true })
	kit.Blob(ham, 23, 24, 22, 12, C.Cream, { Z = 3, Outline = false, Shade = false })
	kit.Face(ham, 22, 15, 20, { Mouth = "cat", Z = 4 })
	kit.Animate(ham, "Bob", 1.5, 3, 0)
	return nil
end

-- Perroquet sur son perchoir : il se balance, gonfle ses plumes, longue queue colorée
Art.Parrot = function(body, kit, _item)
	local C = kit.C
	local red = Color3.fromRGB(250, 115, 115)
	kit.Part(body, 47, 42, 6, 54, C.WoodDark, { Radius = 3, Z = 1 })
	kit.Part(body, 28, 93, 44, 7, C.Wood, { Radius = -1, Z = 2, Shine = true })
	kit.Part(body, 16, 40, 68, 6, C.Wood, { Radius = -1, Z = 4 })
	-- mangeoire
	kit.Part(body, 70, 31, 13, 10, C.Sky, { Radius = 3, Z = 3, Shine = true })
	for _, x in ipairs({ 73, 76.5, 80 }) do
		kit.Circle(body, x, 31, 3, 3, C.Butter, 0, 2)
	end
	-- oiseau (pivot sur les pattes)
	local bird = kit.Pivot(body, 42, 42, 5)
	bird.Name = "Pet"
	kit.Blob(bird, -4, 16, 9, 36, C.Blue, { Z = 1, Rotation = 10 })
	kit.Blob(bird, 3, 15, 8, 32, C.Butter, { Z = 1, Rotation = -6 })
	local g = breather(bird, kit, -22, -52, 44, 52, 2)
	kit.Blob(g, 22, 34, 30, 36, red, { Z = 1, Shine = true })
	kit.Blob(g, 25, 40, 15, 20, kit.Lighten(red, 0.35), { Z = 2, Outline = false, Shade = false })
	local wing = kit.Pivot(g, 14, 24, 3)
	kit.Blob(wing, -2, 10, 15, 28, C.Sky, { Rotation = 14, Z = 1 })
	kit.Blob(wing, -4, 21, 10, 10, C.Butter, { Rotation = 14, Z = 2, Thickness = 1.2 })
	kit.Animate(wing, "Sway", 5, 1.2, 0.6)
	kit.Blob(g, 17, 3, 6, 11, red, { Z = 3, Rotation = -28, Thickness = 1.3 })
	kit.Blob(g, 23, 1, 6, 12, kit.Lighten(red, 0.2), { Z = 3, Rotation = 5, Thickness = 1.3 })
	kit.Blob(g, 23, 15, 30, 27, red, { Z = 4, Shine = true })
	kit.Blob(g, 28, 15, 15, 13, C.White, { Z = 5, Outline = false, Shade = false })
	kit.Face(g, 25, 15, 17, { Mouth = "none", Spacing = 0.6, Z = 6 })
	kit.Blob(g, 34.5, 23, 7, 6, C.GreyDark, { Z = 6, Thickness = 1.1 })
	kit.Blob(g, 36, 18.5, 10, 11, C.Butter, { Z = 7, Rotation = 25, Thickness = 1.3 })
	kit.Blob(g, 39, 22, 4, 6, C.Butter, { Z = 7, Rotation = -20, Thickness = 1.1 })
	kit.Animate(g, "Breathe", 0.03, 1, 0.2)
	for _, x in ipairs({ -5, 5 }) do
		kit.Blob(bird, x, 0, 6, 5, C.Grey, { Z = 3, Thickness = 1.1 })
	end
	kit.Animate(bird, "Sway", 3, 0.7, 0)
	return nil
end

-- Renard tout doux : grandes oreilles, joues blanches, énorme queue touffue qui balance
Art.Fox = function(root, kit, _item)
	local C = kit.C
	local body = kit.Group(root, 0, 0, 100, 100, 1)
	body.Name = "Pet"
	local orange = Color3.fromRGB(255, 160, 95)
	local paw = Color3.fromRGB(175, 105, 85)
	local tail = kit.Pivot(body, 64, 92, 1)
	kit.Blob(tail, 14, -18, 26, 46, orange, { Rotation = 30, Shine = true })
	kit.Blob(tail, 24, -35, 16, 15, C.Cream, { Rotation = 30, Thickness = 1.4 })
	kit.Animate(tail, "Sway", 5, 0.8, 0.3)
	local fox = breather(body, kit, 0, 0, 100, 98, 2)
	kit.Blob(fox, 46, 78, 44, 38, orange, { Z = 1 })
	kit.Blob(fox, 46, 80, 22, 26, C.Cream, { Z = 2, Thickness = 1.2, Shade = false })
	for _, x in ipairs({ 38, 54 }) do
		kit.Blob(fox, x, 94, 11, 9, paw, { Z = 3, Thickness = 1.4 })
	end
	ear(fox, kit, 29, 30, 19, orange, C.Cream, -14, 1)
	ear(fox, kit, 63, 30, 19, orange, C.Cream, 14, 1)
	kit.Blob(fox, 46, 48, 54, 40, orange, { Z = 3, Shine = true })
	kit.Blob(fox, 36, 58, 24, 16, C.Cream, { Z = 4, Outline = false, Shade = false })
	kit.Blob(fox, 56, 58, 24, 16, C.Cream, { Z = 4, Outline = false, Shade = false })
	kit.Face(fox, 46, 49, 32, { Mouth = "none", Z = 6 })
	snout(fox, kit, 46, 55, 10, 7)
	kit.Animate(fox, "Breathe", 0.025, 0.9, 0.7)
	return nil
end

-- Bébé dragon : ailes qui battent, cornes, ventre rayé, queue en pique, petit trésor et lueur
Art.Dragon = function(body, kit, _item)
	local C = kit.C
	local scale = Color3.fromRGB(150, 220, 200)
	local wingColor = C.PinkSoft
	local bone = C.Lilac
	-- trésor
	for _, c in ipairs({ { 20, 95, 18 }, { 80, 95, 18 }, { 84, 89, 14 }, { 15, 90, 12 } }) do
		kit.Blob(body, c[1], c[2], c[3], c[3] * 0.45, C.Gold, { Z = 5, Thickness = 1.3 })
	end
	local gem = kit.Diamond(body, 26, 88, 8, C.Sky, 0, 6)
	kit.Stroke(gem, C.Blue, 1.2)
	local treasure = body
	body = kit.Group(treasure, 0, 0, 100, 100, 3)
	body.Name = "Pet"
	-- queue
	local tail = kit.Pivot(body, 66, 90, 1)
	kit.Blob(tail, 12, -2, 30, 12, scale, { Rotation = -25, Thickness = 1.6 })
	kit.Diamond(tail, 27, -10, 10, C.Pink, 0, 2)
	kit.Animate(tail, "Sway", 6, 0.8, 0.4)
	-- ailes (derrière le corps, battement en miroir)
	for index, side in ipairs({ -1, 1 }) do
		local wing = kit.Pivot(body, 50 + side * 14, 62, 2)
		kit.Blob(wing, side * 15, -14, 30, 22, wingColor, { Rotation = side * -35, Z = 1, Thickness = 1.5 })
		kit.Blob(wing, side * 22, -3, 20, 14, wingColor, { Rotation = side * -12, Z = 1, Thickness = 1.5 })
		kit.Line(wing, 0, 0, side * 28, -26, 2.6, bone, 0, 2)
		kit.Line(wing, side * 28, -26, side * 30, 2, 1.6, bone, 0.2, 2)
		kit.Circle(wing, side * 28, -26, 4.5, 4.5, bone, 0, 2)
		kit.Animate(wing, "Sway", 10, 1.3, (index - 1) * HALF_PI)
	end
	local dragon = breather(body, kit, 0, 0, 100, 98, 3)
	kit.Blob(dragon, 50, 76, 50, 42, scale, { Z = 1, Shine = true })
	kit.Blob(dragon, 50, 80, 28, 30, C.Butter, { Z = 2, Thickness = 1.3, Shade = 0.08 })
	for _, y in ipairs({ 74, 81, 88 }) do
		kit.Line(dragon, 42, y, 58, y, 1.4, C.Gold, 0.35, 3)
	end
	for _, side in ipairs({ -1, 1 }) do
		kit.Blob(dragon, 50 + side * 16, 74, 9, 15, scale, { Z = 3, Rotation = side * -20, Thickness = 1.4 })
		kit.Blob(dragon, 50 + side * 12, 95, 15, 9, scale, { Z = 3, Thickness = 1.4 })
		ear(dragon, kit, 50 + side * 15, 23, 10, C.Cream, nil, side * 16, 0)
	end
	for _, s in ipairs({ { 50, 21, 8 }, { 42, 23, 6 }, { 58, 23, 6 } }) do
		local spike = kit.Diamond(dragon, s[1], s[2], s[3], C.Pink, 0, 1)
		kit.Stroke(spike, C.PinkDeep, 1.2)
	end
	kit.Blob(dragon, 50, 43, 60, 44, scale, { Z = 4, Shine = true })
	kit.Face(dragon, 50, 42, 36, { Eyes = "big", Mouth = "none", Z = 6 })
	kit.Blob(dragon, 50, 55, 24, 12, kit.Lighten(scale, 0.35), { Z = 5, Thickness = 1.3, Shade = false })
	for _, side in ipairs({ -1, 1 }) do
		kit.Circle(dragon, 50 + side * 4, 53, 2.2, 2.2, kit.Darken(scale, 0.4), 0, 6)
	end
	kit.Line(dragon, 46, 57.5, 50, 59.5, 1.6, C.Ink, 0, 6)
	kit.Line(dragon, 50, 59.5, 54, 57.5, 1.6, C.Ink, 0, 6)
	kit.Animate(dragon, "Breathe", 0.025, 0.9, 0.1)
	-- étincelles magiques
	for index, s in ipairs({ { 12, 38, 10 }, { 88, 28, 8 }, { 84, 62, 6 } }) do
		local spark = kit.Sparkle(body, s[1], s[2], s[3], C.Butter, 0, 7)
		kit.Animate(spark, "Bob", 2, 0.7, index * 2.3)
	end
	return { Glow = Color3.fromRGB(200, 255, 225) }
end

return Art
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="31">
              <Properties>
                <string name="Name">Plants</string>
                <string name="Source"><![CDATA[--[[
	Plants (ModuleScript) — dessins des plantes 🪴
	Emplacement : ReplicatedStorage > Client > Components > House > Art > Plants
	Contrat : voir HouseArt (boîte 100 x 100, pieds en bas pour les objets au sol).
]]

local Art = {}

local SQRT2 = math.sqrt(2)

----------------------------------------------------------------------
-- Aides communes
----------------------------------------------------------------------

-- Pot kawaii (corps + rebord en pilule), posé sur `bottom` ; renvoie (corps, y du visage)
local function pot(parent, kit, cx, bottom, w, h, color, z)
	local zz = z or 5
	local rimH = math.clamp(h * 0.27, 6, 11)
	local bodyW = w * 0.84
	local base = kit.Part(parent, cx - bodyW / 2, bottom - h + rimH * 0.5, bodyW, h - rimH * 0.5, color, {
		Radius = math.min(12, bodyW * 0.28),
		Z = zz,
		Shade = 0.16,
	})
	kit.Part(parent, cx - w / 2, bottom - h, w, rimH, kit.Lighten(color, 0.2), { Radius = -1, Z = zz + 1, Shine = true })
	-- terre qui dépasse un peu du rebord
	kit.Blob(parent, cx, bottom - h + 1, w * 0.74, 6, kit.C.WoodDark, { Z = zz - 1, Outline = false, Shade = false })
	return base, bottom - (h - rimH) / 2 + 1
end

-- Feuille ovale partant de (px, py) dans la direction `angle` (degrés, 0 = droite, -90 = haut)
local function leaf(parent, kit, px, py, angle, len, wid, color, z, vein, thickness)
	local a = math.rad(angle)
	local cx, cy = px + math.cos(a) * len / 2, py + math.sin(a) * len / 2
	local frame = kit.Blob(parent, cx, cy, len, wid, color, { Z = z, Rotation = angle, Shade = false, Thickness = thickness or 1.4 })
	if vein ~= false then
		kit.Line(frame, len * 0.14, wid / 2, len * 0.78, wid / 2, math.max(1, wid * 0.1), kit.Darken(color, 0.2), 0.25, 2)
	end
	return frame
end

-- Conteneur plein cadre qui "respire" depuis le point (ax, ay) (UIScale autour de l'ancre)
local function anchored(parent, kit, ax, ay, z)
	local g = kit.Group(parent, 0, 0, 100, 100, z)
	g.AnchorPoint = Vector2.new(ax / 100, ay / 100)
	g.Position = UDim2.fromOffset(ax, ay)
	return g
end

-- Étage de sapin : carré arrondi tourné à 45° coupé à mi-hauteur (triangle aux coins doux)
-- + ourlet festonné en bas ; `apex` = y de la pointe, `half` = demi-largeur
local function tier(parent, kit, cx, apex, half, color, z)
	local clip = kit.Group(parent, cx - half - 4, apex - 4, half * 2 + 8, half + 4, z, true)
	local side = half * SQRT2
	kit.Part(clip, half + 4 - side / 2, 4 + half - side / 2, side, side, color, {
		Radius = 7,
		Rotation = 45,
		Z = 1,
		Shade = false,
		Thickness = 1.8,
	})
	kit.Part(parent, cx - half + 3, apex + half - 6, half * 2 - 6, 8, color, { Radius = -1, Z = z + 1, Shade = 0.18, Thickness = 1.8 })
	kit.Shine(clip, half + 4 - half * 0.34, 4 + half * 0.42, half * 0.22, 3, 2, 0.55)
	return clip
end

-- Petite fleur ronde à 5 pétales (cerisier, bouquet)
local function blossom(parent, kit, x, y, r, color, heart, z)
	local zz = z or 4
	for index = 0, 4 do
		local a = math.rad(index * 72 - 90)
		kit.Blob(parent, x + math.cos(a) * r * 0.52, y + math.sin(a) * r * 0.52, r * 0.78, r * 0.78, color, {
			Z = zz,
			Shade = false,
			Thickness = 1,
		})
	end
	kit.Circle(parent, x, y, r * 0.42, r * 0.42, heart, 0, zz + 1)
end

----------------------------------------------------------------------
-- Dessins
----------------------------------------------------------------------

-- Petite pousse : deux feuilles rondes dans un pot pêche qui sourit
Art.Sprout = function(body, kit, _item)
	local C = kit.C
	local stem = kit.Pivot(body, 50, 64, 3)
	kit.Line(stem, 0, 2, 0, -22, 3.5, C.LeafDark, 0, 1)
	leaf(stem, kit, 0, -20, -155, 25, 17, C.Leaf, 2)
	leaf(stem, kit, 0, -20, -25, 25, 17, Color3.fromRGB(150, 220, 130), 2)
	kit.Animate(stem, "Sway", 4, 0.8, 0.3)
	local _, faceY = pot(body, kit, 50, 100, 52, 38, C.Peach)
	kit.Face(body, 50, faceY, 24, { Z = 8 })
	return nil
end

-- Pot de tulipes : trois tulipes (rose, rouge, beurre) et un petit cœur sur le pot
Art.TulipPot = function(body, kit, _item)
	local C = kit.C
	local stems = kit.Pivot(body, 50, 68, 3)
	local heads = {
		{ -15, -40, C.Pink },
		{ 1, -52, Color3.fromRGB(250, 105, 125) },
		{ 16, -38, C.Butter },
	}
	for _, h in ipairs(heads) do
		kit.Line(stems, 0, 0, h[1], h[2], 2.6, C.Green, 0, 1)
	end
	leaf(stems, kit, -2, 0, -118, 32, 10, C.Leaf, 2)
	leaf(stems, kit, 2, 0, -62, 30, 10, C.Leaf, 2)
	for _, h in ipairs(heads) do
		local x, y, color = h[1], h[2], h[3]
		kit.Blob(stems, x, y - 4, 8, 14, kit.Darken(color, 0.12), { Z = 3, Shade = false })
		kit.Blob(stems, x - 3.5, y, 10, 16, color, { Z = 4, Rotation = -14, Shade = false, Thickness = 1.3 })
		kit.Blob(stems, x + 3.5, y, 10, 16, color, { Z = 4, Rotation = 14, Shade = false, Thickness = 1.3 })
	end
	kit.Animate(stems, "Sway", 2.5, 0.7, 1.1)
	local _, faceY = pot(body, kit, 50, 100, 48, 34, C.Lilac)
	kit.Heart(body, 50, faceY, 11, C.White, 0.15, 8)
	return nil
end

-- Petit cactus rigolo : bras levés, visage, fleur rose sur la tête
Art.TinyCactus = function(body, kit, _item)
	local C = kit.C
	local green = Color3.fromRGB(125, 205, 140)
	local cactus = anchored(body, kit, 50, 76, 3)
	for _, side in ipairs({ -1, 1 }) do
		local arm = kit.Pivot(cactus, 50 + side * 12, 58, 1)
		kit.Blob(arm, side * 6, -7, 10, 20, green, { Rotation = side * 28, Shade = false })
		kit.Animate(arm, "Sway", 5, 0.9, side)
	end
	kit.Part(cactus, 35, 28, 30, 52, green, { Radius = -1, Z = 2, Shine = true })
	kit.Face(cactus, 50, 54, 22, { Mouth = "cat", Z = 4 })
	for _, p in ipairs({ { 41, 38 }, { 60, 40 }, { 40, 68 }, { 60, 70 } }) do
		kit.Line(cactus, p[1] - 1, p[2] - 1, p[1] + 1, p[2] + 1, 1.3, kit.Darken(green, 0.35), 0.2, 3)
	end
	for _, dx in ipairs({ -4, 4 }) do
		kit.Blob(cactus, 50 + dx, 28, 9, 8, C.Pink, { Z = 3, Shade = false, Thickness = 1.2 })
	end
	kit.Blob(cactus, 50, 24, 8, 9, C.Pink, { Z = 3, Shade = false, Thickness = 1.2 })
	kit.Circle(cactus, 50, 27.5, 4, 4, C.Yellow, 0, 4)
	kit.Animate(cactus, "Breathe", 0.015, 1, 0.4)
	local potBody = pot(body, kit, 50, 100, 46, 28, Color3.fromRGB(240, 160, 120))
	kit.Box(potBody, 4, 12, potBody.Size.X.Offset - 8, 3, C.Cream, 0.2, 2)
	return nil
end

-- Pot de marguerites : trois marguerites (celle du milieu sourit), pot à pois
Art.DaisyPot = function(body, kit, _item)
	local C = kit.C
	local stems = kit.Pivot(body, 50, 70, 3)
	local flowers = { { -17, -34, 8 }, { 17, -32, 8 }, { 1, -50, 10 } }
	for _, f in ipairs(flowers) do
		kit.Line(stems, 0, 0, f[1], f[2], 2.4, C.Green, 0, 1)
	end
	leaf(stems, kit, -1, -4, -140, 22, 10, C.Leaf, 2)
	leaf(stems, kit, 1, -8, -40, 20, 9, C.Leaf, 2)
	local petalLine = Color3.fromRGB(215, 200, 225)
	for index, f in ipairs(flowers) do
		local x, y, r = f[1], f[2], f[3]
		for k = 0, 3 do
			local a = math.rad(k * 45)
			local dx, dy = math.cos(a) * r * 0.62, math.sin(a) * r * 0.62
			local petal = kit.Line(stems, x - dx, y - dy, x + dx, y + dy, r * 0.62, C.White, 0, 3)
			kit.Stroke(petal, petalLine, 1.1)
		end
		kit.Blob(stems, x, y, r * 0.95, r * 0.95, C.Yellow, { Z = 4, Shade = false, Thickness = 1.2 })
		if index == 3 then
			kit.Face(stems, x, y + 0.5, r * 0.95, { Mouth = "none", Blush = false, Z = 5 })
		end
	end
	kit.Animate(stems, "Sway", 2.5, 0.8, 2.2)
	local potBody = pot(body, kit, 50, 100, 48, 32, C.Sky)
	for _, p in ipairs({ { 8, 8 }, { 20, 16 }, { 32, 8 } }) do
		kit.Circle(potBody, p[1], p[2], 4.5, 4.5, C.White, 0.1, 2)
	end
	return nil
end

-- Plante en pot : éventail de grandes feuilles, pot crème à bande rose qui sourit
Art.PottedPlant = function(body, kit, _item)
	local C = kit.C
	local foliage = kit.Pivot(body, 50, 64, 3)
	local light = Color3.fromRGB(145, 215, 125)
	local leaves = {
		{ -90, 50, C.LeafDark, 1 },
		{ -114, 46, C.Leaf, 2 },
		{ -66, 46, C.Leaf, 2 },
		{ -140, 40, light, 3 },
		{ -40, 40, light, 3 },
		{ -166, 30, C.Leaf, 4 },
		{ -14, 30, C.Leaf, 4 },
	}
	for _, l in ipairs(leaves) do
		leaf(foliage, kit, 0, 0, l[1], l[2], 15, l[3], l[4])
	end
	kit.Animate(foliage, "Sway", 2, 0.6, 0.8)
	local potBody, faceY = pot(body, kit, 50, 100, 60, 40, C.Cream)
	kit.Box(potBody, 0, 22, potBody.Size.X.Offset, 5, C.PinkSoft, 0, 2)
	kit.Face(body, 50, faceY - 3, 22, { Z = 8 })
	return nil
end

-- Herbes séchées : trois bouquets suspendus à une tringle (romarin, lavande, basilic)
Art.HangingHerbs = function(body, kit, _item)
	local C = kit.C
	kit.Line(body, 50, 16, 14, 32, 1.4, C.WoodDark, 0, 2)
	kit.Line(body, 50, 16, 86, 32, 1.4, C.WoodDark, 0, 2)
	kit.Circle(body, 50, 16, 6, 6, C.GreyDark, 0, 4)
	kit.Part(body, 8, 29, 84, 7, C.Wood, { Radius = -1, Z = 5, Shine = true })
	local kinds = {
		{ 24, "rosemary" },
		{ 50, "lavender" },
		{ 76, "basil" },
	}
	for index, k in ipairs(kinds) do
		local bundle = kit.Pivot(body, k[1], 33, 3)
		kit.Line(bundle, 0, 0, 0, 9, 1.3, C.WoodDark, 0, 1)
		for _, dx in ipairs({ -2.5, 0, 2.5 }) do
			kit.Line(bundle, dx * 0.6, 8, dx, 14, 1.6, Color3.fromRGB(150, 150, 90), 0, 1)
		end
		kit.Part(bundle, -5.5, 12, 11, 5, C.PinkDeep, { Radius = -1, Z = 4, Shade = false, Thickness = 1.2 })
		if k[2] == "rosemary" then
			for _, a in ipairs({ 65, 78, 90, 102, 115 }) do
				leaf(bundle, kit, 0, 15, a, 30, 6, Color3.fromRGB(95, 160, 120), 2, false)
			end
		elseif k[2] == "lavender" then
			for _, a in ipairs({ 72, 90, 108 }) do
				local r = math.rad(a)
				local ex, ey = math.cos(r) * 20, 15 + math.sin(r) * 20
				kit.Line(bundle, 0, 15, ex, ey, 1.6, C.Green, 0, 1)
				leaf(bundle, kit, ex, ey, a, 16, 7, C.Lilac, 3, false)
			end
		else
			for _, l in ipairs({ { 70, 18 }, { 110, 18 }, { 90, 22 }, { 55, 13 }, { 125, 13 } }) do
				leaf(bundle, kit, 0, 15, l[1], l[2] + 4, 12, C.Leaf, 2)
			end
		end
		kit.Animate(bundle, "Sway", 3, 0.7, index * 1.7)
	end
	return { WallShadow = Vector2.new(0.8, 0.45) }
end

-- Pothos suspendu : suspension en macramé, pot blanc qui sourit, lianes de feuilles-cœurs
Art.HangingPothos = function(body, kit, _item)
	local C = kit.C
	kit.Circle(body, 50, 2, 6, 6, C.GreyDark, 0, 6)
	local hanger = kit.Pivot(body, 50, 2, 3)
	local cord = C.WoodLight
	for _, x in ipairs({ -19, 0, 19 }) do
		kit.Line(hanger, 0, 0, x, 36, 1.6, cord, 0, 1)
	end
	kit.Circle(hanger, 0, 12, 6, 6, C.Wood, 0, 2)
	local light, dark = Color3.fromRGB(165, 222, 130), C.Leaf
	-- lianes (derrière le pot) : feuilles en cœur
	local vines = {
		{ -19, -8, 58, { 12, 25, 38, 51 } },
		{ 19, 6, 36, { 12, 24, 36 } },
	}
	for index, v in ipairs(vines) do
		local vine = kit.Pivot(hanger, v[1], 36, 2)
		kit.Line(vine, 0, 0, v[2], v[3], 1.8, C.LeafDark, 0, 1)
		for n, y in ipairs(v[4]) do
			local side = if n % 2 == 0 then 1 else -1
			local heart = kit.Heart(vine, v[2] * y / v[3] + side * 3.5, y, 12, n % 2 == 0 and light or dark, 0, 2)
			heart.Rotation = side * -28
		end
		kit.Animate(vine, "Sway", 4, 0.8, index * 2.1)
	end
	-- feuilles au-dessus du rebord
	for _, l in ipairs({ { -8, -125, dark }, { 2, -80, light }, { 10, -50, dark } }) do
		leaf(hanger, kit, l[1], 36, l[2], 16, 11, l[3], 3, false)
	end
	local potBody = pot(hanger, kit, 0, 66, 42, 30, C.Cream, 5)
	kit.Box(potBody, 0, 12, potBody.Size.X.Offset, 4, C.PinkSoft, 0, 2)
	kit.Box(potBody, 0, 18, potBody.Size.X.Offset, 2, C.Pink, 0.3, 2)
	kit.Animate(hanger, "Sway", 1.5, 0.6, 0.5)
	return { WallShadow = Vector2.new(0.42, 0.5) }
end

-- Tournesol : grande fleur souriante sur sa tige, pot en terre cuite
Art.Sunflower = function(body, kit, _item)
	local C = kit.C
	local flower = kit.Pivot(body, 50, 72, 3)
	kit.Line(flower, 0, 2, 0, -46, 4, C.Green, 0, 1)
	leaf(flower, kit, 0, -16, -160, 20, 12, C.Leaf, 2)
	leaf(flower, kit, 0, -24, -20, 20, 12, C.Leaf, 2)
	local hy = -48
	local petalLine = Color3.fromRGB(225, 160, 40)
	for k = 0, 5 do
		local a = math.rad(k * 30)
		local dx, dy = math.cos(a) * 14, math.sin(a) * 14
		local petal = kit.Line(flower, -dx, hy - dy, dx, hy + dy, 10, C.Yellow, 0, 3)
		kit.Stroke(petal, petalLine, 1.3)
	end
	kit.Blob(flower, 0, hy, 24, 24, Color3.fromRGB(205, 140, 90), { Z = 4, Shade = 0.1 })
	kit.Face(flower, 0, hy + 1, 18, { Eyes = "happy", Z = 5 })
	kit.Animate(flower, "Sway", 2, 0.6, 1.4)
	pot(body, kit, 50, 100, 42, 30, Color3.fromRGB(240, 160, 120))
	return nil
end

-- Bouquet dans un vase en verre, gros nœud rose
Art.Bouquet = function(body, kit, _item)
	local C = kit.C
	local flowers = kit.Pivot(body, 50, 62, 3)
	leaf(flowers, kit, 0, -4, -155, 22, 9, C.Leaf, 1)
	leaf(flowers, kit, 0, -4, -25, 22, 9, C.Leaf, 1)
	leaf(flowers, kit, 0, -4, -105, 30, 8, C.LeafDark, 1)
	for _, f in ipairs({ { -12, -22, 12, C.Pink }, { 11, -24, 11, Color3.fromRGB(255, 170, 120) }, { -1, -36, 10, C.Lilac } }) do
		local x, y, r, color = f[1], f[2], f[3], f[4]
		kit.Blob(flowers, x, y, r * 2, r * 1.85, color, { Z = 3, Shine = true })
		kit.Blob(flowers, x, y + 0.5, r * 1.1, r * 0.95, kit.Darken(color, 0.12), { Z = 4, Shade = false, Thickness = 1.2 })
		kit.Line(flowers, x - r * 0.25, y, x + r * 0.2, y - r * 0.15, 1.4, kit.Lighten(color, 0.4), 0.2, 5)
	end
	blossom(flowers, kit, -22, -8, 8, C.White, C.Yellow, 4)
	blossom(flowers, kit, 22, -8, 8, C.Sky, C.White, 4)
	for _, p in ipairs({ { -24, -30 }, { 24, -38 }, { 6, -46 } }) do
		kit.Circle(flowers, p[1], p[2], 4, 4, C.White, 0, 2)
	end
	kit.Animate(flowers, "Sway", 1.8, 0.6, 0.2)
	-- vase
	for _, dx in ipairs({ -3, 0, 3 }) do
		kit.Line(body, 50 + dx * 0.4, 64, 50 + dx, 94, 2, C.Green, 0.2, 4)
	end
	kit.Blob(body, 50, 88, 36, 18, C.Sky, { Z = 4, T = 0.45, Outline = false, Shade = false })
	kit.Blob(body, 50, 83, 42, 34, C.Glass, { Z = 5, T = 0.45, Outline = Color3.fromRGB(130, 170, 210) })
	kit.Part(body, 40, 58, 20, 12, C.Glass, { Z = 5, T = 0.45, Radius = 4, Outline = Color3.fromRGB(130, 170, 210) })
	kit.Shine(body, 34, 74, 4, 12, 6, 0.3)
	for _, side in ipairs({ -1, 1 }) do
		kit.Blob(body, 50 + side * 6, 68, 11, 7, C.Pink, { Z = 7, Rotation = side * 20, Shade = false, Thickness = 1.2 })
		kit.Line(body, 50 + side * 1, 70, 50 + side * 5, 78, 2.5, C.Pink, 0, 6)
	end
	kit.Circle(body, 50, 68, 5, 5, C.PinkDeep, 0, 8)
	return nil
end

-- Rose rouge sous cloche de verre, sur un socle en bois
Art.RedRose = function(body, kit, _item)
	local C = kit.C
	local red = Color3.fromRGB(240, 80, 100)
	kit.Line(body, 50, 86, 50, 52, 3, C.LeafDark, 0, 3)
	leaf(body, kit, 50, 74, -155, 15, 9, C.Leaf, 3)
	leaf(body, kit, 50, 68, -25, 15, 9, C.Leaf, 3)
	local rose = kit.Pivot(body, 50, 46, 4)
	kit.Blob(rose, -8, 2, 12, 15, kit.Darken(red, 0.12), { Z = 1, Rotation = -30, Shade = false })
	kit.Blob(rose, 8, 2, 12, 15, kit.Darken(red, 0.12), { Z = 1, Rotation = 30, Shade = false })
	kit.Blob(rose, 0, 0, 22, 20, red, { Z = 2, Shine = true })
	kit.Blob(rose, 0, -3, 13, 9, kit.Darken(red, 0.18), { Z = 3, Shade = false, Thickness = 1.2 })
	kit.Line(rose, -3, -3, 3, -4, 1.5, kit.Lighten(red, 0.35), 0.1, 4)
	kit.Animate(rose, "Bob", 0.8, 0.6, 0.5)
	local petal = kit.Blob(body, 60, 84, 6, 4, red, { Z = 5, Rotation = 25, Shade = false, Thickness = 1 })
	kit.Animate(petal, "Drift", 1.5, 0.4, 1)
	-- cloche
	kit.Part(body, 25, 16, 50, 76, C.Glass, { Radius = 25, Z = 6, T = 0.72, Outline = Color3.fromRGB(140, 180, 215), Thickness = 2, Shade = false })
	kit.Blob(body, 50, 14, 11, 9, C.Glass, { Z = 7, T = 0.3, Outline = Color3.fromRGB(140, 180, 215) })
	kit.Shine(body, 31, 28, 5, 26, 8, 0.35)
	kit.Shine(body, 32, 58, 4, 6, 8, 0.45)
	kit.Sparkle(body, 66, 30, 9, C.White, 0, 8)
	-- socle
	kit.Part(body, 20, 86, 60, 8, C.Wood, { Radius = -1, Z = 7 })
	kit.Part(body, 24, 92, 52, 8, C.WoodDark, { Radius = 3, Z = 6 })
	kit.Circle(body, 50, 96, 4, 4, C.Gold, 0, 8)
	return nil
end

-- Feuille de monstera : nervure + lobes séparés (les trous entre lobes font les fentes)
-- `angle` = direction de la feuille depuis (px, py)
local function monsteraLeaf(parent, kit, px, py, angle, size, color, z)
	local holder = kit.Pivot(parent, px, py, z)
	holder.Rotation = angle + 90 -- repère local : la feuille pousse vers le haut (-y)
	local L = size
	local opts = { Z = 1, Shade = false, Thickness = 1.4 }
	for index, t in ipairs({ 0.22, 0.47, 0.72 }) do
		local len = L * (0.62 - t * 0.26)
		for _, side in ipairs({ -1, 1 }) do
			local o = table.clone(opts)
			o.Rotation = side * -(16 + index * 10)
			kit.Blob(holder, side * L * 0.24, -t * L - L * 0.02, len, L * 0.25, color, o)
		end
	end
	kit.Blob(holder, 0, -L * 0.86, L * 0.3, L * 0.34, color, opts)
	kit.Line(holder, 0, -L * 0.02, 0, -L * 0.86, 1.6, kit.Darken(color, 0.25), 0, 2)
	return holder
end

-- Monstera : grandes feuilles fendues sur un pot blanc façon terrazzo
Art.Monstera = function(body, kit, _item)
	local C = kit.C
	local plant = kit.Pivot(body, 50, 66, 3)
	local green, deep = Color3.fromRGB(95, 185, 110), Color3.fromRGB(80, 165, 100)
	local leaves = {
		{ -22, -8, -160, 28, deep },
		{ 22, -10, -20, 28, deep },
		{ -10, -30, -112, 36, green },
		{ 12, -32, -64, 36, Color3.fromRGB(110, 200, 120) },
	}
	for index, l in ipairs(leaves) do
		kit.Line(plant, 0, 0, l[1], l[2], 2.4, C.LeafDark, 0, 1)
		monsteraLeaf(plant, kit, l[1], l[2], l[3], l[4], l[5], index + 1)
	end
	kit.Animate(plant, "Sway", 1.5, 0.5, 2.6)
	local potBody = pot(body, kit, 50, 100, 54, 34, Color3.fromRGB(252, 247, 242))
	for _, d in ipairs({ { 7, 8, C.Pink }, { 20, 18, C.Sky }, { 33, 9, C.Butter }, { 12, 22, C.Mint } }) do
		kit.Circle(potBody, d[1], d[2], 4, 3.5, d[3], 0.1, 2)
	end
	return nil
end

-- Hibiscus : buisson vert foncé et deux grandes fleurs tropicales
Art.Hibiscus = function(body, kit, _item)
	local C = kit.C
	local bush = kit.Pivot(body, 50, 70, 3)
	for index, l in ipairs({ { -160, 24 }, { -130, 30 }, { -100, 32 }, { -75, 32 }, { -45, 30 }, { -18, 24 } }) do
		leaf(bush, kit, 0, 0, l[1], l[2], 11, index % 2 == 0 and C.LeafDark or C.Green, 1)
	end
	for _, f in ipairs({ { -11, -30, 13, Color3.fromRGB(255, 105, 150) }, { 14, -20, 11, Color3.fromRGB(255, 150, 120) } }) do
		local x, y, r, color = f[1], f[2], f[3], f[4]
		for k = 0, 4 do
			local a = math.rad(k * 72 - 90)
			kit.Blob(bush, x + math.cos(a) * r * 0.5, y + math.sin(a) * r * 0.5, r * 1.05, r * 0.95, color, {
				Z = 4,
				Rotation = k * 72,
				Shade = false,
				Thickness = 1.2,
			})
		end
		kit.Circle(bush, x, y, r * 0.55, r * 0.55, kit.Darken(color, 0.25), 0, 5)
		kit.Line(bush, x, y, x + r * 0.45, y - r * 0.75, 1.6, kit.Darken(color, 0.1), 0, 6)
		kit.Circle(bush, x + r * 0.5, y - r * 0.82, 3.5, 3.5, C.Yellow, 0, 6)
	end
	kit.Line(bush, 12, -24, 22, -36, 1.8, C.LeafDark, 0, 2)
	kit.Blob(bush, 23, -38, 6, 9, C.Pink, { Z = 3, Rotation = 30, Shade = false, Thickness = 1.2 })
	kit.Animate(bush, "Sway", 2, 0.6, 3.1)
	pot(body, kit, 50, 100, 44, 30, C.Mint)
	return nil
end

-- Trèfle à quatre feuilles (quatre cœurs) dans un petit pot qui sourit, étincelles dorées
Art.LuckyClover = function(body, kit, _item)
	local C = kit.C
	local clover = kit.Pivot(body, 50, 70, 3)
	kit.Line(clover, 0, 2, 1, -28, 3, C.LeafDark, 0, 1)
	local cy = -36
	local green = Color3.fromRGB(100, 200, 110)
	for k = 0, 3 do
		local a = math.rad(k * 90 - 90)
		local h = kit.Heart(clover, math.cos(a) * 8.5, cy + math.sin(a) * 8.5, 19, k % 2 == 0 and green or C.Leaf, 0, 2)
		h.Rotation = k * 90
	end
	kit.Circle(clover, 0, cy, 5, 5, C.LeafDark, 0, 3)
	kit.Animate(clover, "Sway", 3, 0.7, 0.9)
	kit.Sparkle(body, 22, 30, 9, C.Gold, 0, 6)
	kit.Sparkle(body, 80, 44, 7, C.Gold, 0, 6)
	local _, faceY = pot(body, kit, 50, 100, 46, 32, C.MintSoft)
	kit.Face(body, 50, faceY, 20, { Eyes = "happy", Z = 8 })
	return nil
end

-- Terrarium : bocal en verre, mousse, succulente, champignon et petit escargot
Art.Terrarium = function(body, kit, _item)
	local C = kit.C
	-- contenu (derrière le verre)
	kit.Part(body, 21, 66, 58, 31, C.Brown, { Radius = 19, Z = 2, Outline = false, Shade = 0.25 })
	kit.Box(body, 22, 78, 56, 4, C.Butter, 0.2, 2)
	for _, p in ipairs({ { 30, 88, 7 }, { 46, 91, 5 }, { 64, 89, 7 } }) do
		kit.Circle(body, p[1], p[2], p[3], p[3] * 0.7, C.Grey, 0, 3)
	end
	kit.Blob(body, 50, 69, 56, 10, C.Green, { Z = 3, Shade = false, Thickness = 1.2 })
	leaf(body, kit, 30, 68, -130, 14, 7, C.Mint, 4, false)
	leaf(body, kit, 30, 68, -50, 14, 7, C.Mint, 4, false)
	leaf(body, kit, 30, 68, -90, 16, 7, Color3.fromRGB(130, 220, 185), 4, false)
	kit.Part(body, 69, 58, 4, 10, C.Cream, { Radius = 2, Z = 4, Thickness = 1.2 })
	kit.Blob(body, 71, 58, 12, 8, C.Red, { Z = 5, Thickness = 1.2 })
	kit.Circle(body, 68.5, 57, 2.5, 2.5, C.White, 0, 6)
	-- escargot
	local snail = kit.Group(body, 38, 49, 28, 18, 5)
	kit.Part(snail, 2, 12, 24, 6, C.Butter, { Radius = -1, Z = 1, Thickness = 1.2 })
	kit.Blob(snail, 21, 9, 8, 11, C.Butter, { Z = 2, Thickness = 1.2 })
	kit.Line(snail, 20, 4, 18, -1, 1, C.Ink, 0, 1)
	kit.Line(snail, 23, 4, 25, -1, 1, C.Ink, 0, 1)
	kit.Blob(snail, 10, 8, 14, 13, C.Pink, { Z = 3, Shine = true, Thickness = 1.3 })
	kit.Circle(snail, 10, 8.5, 6, 6, C.PinkDeep, 0.3, 4)
	kit.Face(snail, 21.5, 9, 8, { Mouth = "none", Z = 3 })
	kit.Animate(snail, "Drift", 3, 0.3, 0.7)
	-- bocal
	kit.Part(body, 20, 22, 60, 76, C.Glass, { Radius = 20, Z = 7, T = 0.74, Outline = Color3.fromRGB(140, 180, 215), Thickness = 2, Shade = false })
	kit.Part(body, 31, 16, 38, 9, C.Glass, { Radius = -1, Z = 8, T = 0.45, Outline = Color3.fromRGB(140, 180, 215) })
	kit.Part(body, 35, 5, 30, 13, C.WoodLight, { Radius = 4, Z = 6, Shine = true })
	kit.Shine(body, 26, 32, 4.5, 22, 9, 0.35)
	kit.Sparkle(body, 70, 34, 8, C.White, 0, 9)
	return nil
end

-- Branche de cerisier dans un vase : fleurs roses, boutons et pétales qui tombent
Art.CherryBlossom = function(body, kit, _item)
	local C = kit.C
	local branch = kit.Pivot(body, 50, 60, 3)
	local brown = Color3.fromRGB(140, 95, 80)
	local segments = {
		{ 0, 0, -8, -24, 3.6 },
		{ -8, -24, -22, -42, 3 },
		{ -8, -24, -4, -52, 2.6 },
		{ 0, 0, 10, -22, 3.4 },
		{ 10, -22, 26, -36, 2.8 },
		{ 10, -22, 32, -16, 2.4 },
		{ -22, -42, -36, -36, 2.2 },
	}
	for _, s in ipairs(segments) do
		kit.Line(branch, s[1], s[2], s[3], s[4], s[5], brown, 0, 1)
	end
	local petal, heart = Color3.fromRGB(255, 200, 220), C.PinkDeep
	for _, f in ipairs({ { -22, -43, 13 }, { -4, -53, 12 }, { 26, -37, 13 }, { 32, -16, 11 }, { -36, -35, 10 } }) do
		blossom(branch, kit, f[1], f[2], f[3], petal, heart, 2)
	end
	for _, b in ipairs({ { -14, -30 }, { 18, -30 }, { -30, -46 }, { 38, -22 } }) do
		kit.Blob(branch, b[1], b[2], 5, 5, C.Pink, { Z = 2, Shade = false, Thickness = 1 })
	end
	kit.Animate(branch, "Sway", 1.5, 0.5, 0.6)
	local fall1 = kit.Blob(body, 18, 70, 5, 4, petal, { Z = 6, Rotation = 30, Shade = false, Thickness = 1 })
	kit.Animate(fall1, "Bob", 3, 0.5, 0.3)
	local fall2 = kit.Blob(body, 82, 58, 5, 4, petal, { Z = 6, Rotation = -20, Shade = false, Thickness = 1 })
	kit.Animate(fall2, "Drift", 3, 0.5, 1.9)
	-- vase
	local vase = Color3.fromRGB(235, 228, 255)
	kit.Part(body, 36, 62, 28, 38, vase, { Radius = 12, Z = 5, Shine = true })
	kit.Part(body, 41, 55, 18, 12, vase, { Radius = 4, Z = 4 })
	kit.Part(body, 38, 53, 24, 5, kit.Lighten(vase, 0.3), { Radius = -1, Z = 6 })
	kit.Box(body, 36.8, 78, 26.4, 4, C.PinkSoft, 0, 6)
	kit.Heart(body, 50, 90, 9, C.Pink, 0, 6)
	return nil
end

-- Petit sapin en pot : trois étages doux, pommes de pin, pot bleu qui sourit
Art.MiniPine = function(body, kit, _item)
	local C = kit.C
	local tree = anchored(body, kit, 50, 76, 3)
	local green = Color3.fromRGB(95, 180, 120)
	kit.Part(tree, 45, 56, 10, 20, C.WoodDark, { Radius = 3, Z = 1 })
	tier(tree, kit, 50, 28, 34, kit.Darken(green, 0.06), 2)
	tier(tree, kit, 50, 14, 26, green, 4)
	tier(tree, kit, 50, 2, 18, kit.Lighten(green, 0.08), 6)
	for _, p in ipairs({ { 38, 54, C.Pink }, { 64, 50, C.Butter }, { 44, 33, C.Sky }, { 58, 20, C.Pink } }) do
		kit.Circle(tree, p[1], p[2], 5, 5, p[3], 0, 9)
	end
	kit.Heart(tree, 50, 2, 8, C.Pink, 0, 9)
	kit.Animate(tree, "Breathe", 0.012, 0.8, 0.5)
	local snow = kit.Circle(body, 84, 30, 4, 4, C.White, 0.1, 6)
	kit.Animate(snow, "Bob", 3, 0.4, 0.2)
	local potBody, faceY = pot(body, kit, 50, 100, 44, 28, C.Sky)
	kit.Face(body, 50, faceY, 18, { Z = 8 })
	kit.Box(potBody, 0, 3, potBody.Size.X.Offset, 2.5, C.White, 0.4, 2)
	return nil
end

-- Champignon géant : chapeau rouge à pois, pied crème qui sourit, deux petits champignons
Art.GiantMushroom = function(body, kit, _item)
	local C = kit.C
	local red = Color3.fromRGB(245, 95, 110)
	-- petits champignons
	for _, m in ipairs({ { 12, 13, C.Pink, 0.5 }, { 88, 10, C.Butter, 2.2 } }) do
		local mini = kit.Pivot(body, m[1], 100, 3)
		local s = m[2]
		kit.Part(mini, -s * 0.2, -s * 1.05, s * 0.4, s * 1.05, C.Cream, { Radius = 3, Z = 1, Thickness = 1.2 })
		kit.Part(mini, -s * 0.6, -s * 1.4, s * 1.2, s * 0.6, m[3], { Radius = -1, Z = 2, Thickness = 1.3 })
		kit.Circle(mini, -s * 0.15, -s * 1.2, s * 0.2, s * 0.2, C.White, 0, 3)
		kit.Animate(mini, "Sway", 4, 0.7, m[4])
	end
	local shroom = anchored(body, kit, 50, 100, 4)
	-- pied
	kit.Part(shroom, 30, 50, 40, 50, C.Cream, { Radius = 16, Z = 1, Shine = true })
	kit.Face(shroom, 50, 75, 26, { Z = 3 })
	-- chapeau (demi-ovale découpé)
	local cap = kit.Group(shroom, 2, 6, 96, 48, 3, true)
	kit.Blob(cap, 48, 48, 92, 88, red, { Z = 1, Thickness = 2 })
	kit.Part(shroom, 4, 46, 92, 12, kit.Darken(red, 0.08), { Radius = -1, Z = 4, Shade = 0.1 })
	kit.Part(shroom, 16, 53, 68, 6, C.PinkSoft, { Radius = -1, Z = 2, Shade = false })
	for _, d in ipairs({ { 28, 22, 13 }, { 58, 14, 10 }, { 76, 32, 12 }, { 46, 36, 8 }, { 14, 40, 6 } }) do
		kit.Blob(cap, d[1] - 2, d[2] - 6 + 6, d[3], d[3] * 0.85, C.White, { Z = 2, Shade = false, Outline = false })
	end
	kit.Shine(cap, 20, 10, 16, 5, 3, 0.4)
	kit.Animate(shroom, "Breathe", 0.012, 0.7, 1.3)
	-- touffes d'herbe
	for _, g in ipairs({ { 26, 97, -110 }, { 28, 97, -75 }, { 72, 97, -105 }, { 74, 97, -70 } }) do
		leaf(body, kit, g[1], g[2], g[3], 10, 4, C.Leaf, 5, false)
	end
	return nil
end

-- Arbre d'intérieur : feuillage en nuage avec petites pommes, grand pot rose qui sourit
Art.IndoorTree = function(body, kit, _item)
	local C = kit.C
	local tree = kit.Pivot(body, 50, 70, 3)
	kit.Part(tree, -4, -34, 8, 36, C.WoodDark, { Radius = 3, Z = 1 })
	kit.Line(tree, 0, -18, 10, -28, 3, C.WoodDark, 0, 1)
	local g1, g2, g3 = C.LeafDark, C.Leaf, Color3.fromRGB(150, 220, 130)
	local puffs = {
		{ -24, -36, 34, 28, g1 },
		{ 24, -38, 34, 28, g1 },
		{ -14, -52, 36, 30, g2 },
		{ 14, -54, 36, 30, g2 },
		{ 0, -44, 46, 34, g2 },
		{ 0, -64, 32, 24, g3 },
	}
	for index, p in ipairs(puffs) do
		kit.Blob(tree, p[1], p[2], p[3], p[4], p[5], { Z = index + 1, Shade = 0.08, Thickness = 1.6 })
	end
	kit.Shine(tree, -8, -71, 12, 4, 9, 0.45)
	for _, a in ipairs({ { -24, -40 }, { 18, -48 }, { -6, -56 }, { 28, -34 }, { 6, -36 } }) do
		local apple = kit.Blob(tree, a[1], a[2], 7, 7, C.Red, { Z = 8, Thickness = 1.1 })
		kit.Circle(apple, 2.2, 2.2, 2, 2, C.White, 0.2, 2)
	end
	kit.Animate(tree, "Sway", 1.2, 0.5, 1.7)
	local potBody, faceY = pot(body, kit, 50, 100, 54, 32, C.PinkSoft)
	kit.Face(body, 50, faceY, 24, { Z = 8 })
	kit.Box(potBody, 0, 4, potBody.Size.X.Offset, 3, C.Pink, 0.3, 2)
	return nil
end

-- Bambou à vœux (Tanabata) : tiges vertes, feuilles fines, papiers à vœux colorés
Art.Bamboo = function(body, kit, _item)
	local C = kit.C
	local plant = kit.Pivot(body, 50, 80, 3)
	local green = Color3.fromRGB(130, 200, 110)
	local stalks = { { -10, -66 }, { 2, -74 }, { 13, -58 } }
	for index, s in ipairs(stalks) do
		local x, top = s[1], s[2]
		local stalk = kit.Part(plant, x - 4, top, 8, -top + 2, kit.Lighten(green, (index - 1) * 0.08), { Radius = 4, Z = 2 + index, Shine = true })
		for y = 14, -top - 8, 16 do
			kit.Box(stalk, -0.5, y, 9, 2, kit.Darken(green, 0.3), 0.2, 2)
		end
	end
	-- rameaux + touffes de feuilles fines et tombantes
	local light = Color3.fromRGB(150, 215, 120)
	local twigs = {
		{ -10, -50, -26, -60, { -170, 160, -140 } },
		{ 2, -62, 18, -72, { -20, 25, -60 } },
		{ 13, -42, 30, -48, { -10, 30 } },
		{ -10, -28, -26, -32, { 175, 145 } },
	}
	for index, t in ipairs(twigs) do
		kit.Line(plant, t[1], t[2], t[3], t[4], 1.8, kit.Darken(green, 0.15), 0, 2)
		for n, a in ipairs(t[5]) do
			leaf(plant, kit, t[3], t[4], a, 21 - n * 1.5, 8, (index + n) % 2 == 0 and C.Leaf or light, 6, false, 1.1)
		end
	end
	for _, l in ipairs({ { 2, -73, -110 }, { 2, -73, -65 }, { -10, -65, -125 }, { 13, -57, -55 } }) do
		leaf(plant, kit, l[1], l[2], l[3], 14, 7, light, 6, false, 1.1)
	end
	local papers = {
		{ -21, -57, C.Pink },
		{ 14, -69, C.Butter },
		{ 25, -47, C.Lilac },
		{ -21, -31, C.Sky },
	}
	for index, p in ipairs(papers) do
		local strip = kit.Pivot(plant, p[1], p[2], 7)
		kit.Line(strip, 0, 0, 0, 6, 1, C.Ink, 0.3, 1)
		kit.Part(strip, -3.5, 5, 7, 14, p[3], { Radius = 1.5, Z = 2, Thickness = 1.2 })
		kit.Animate(strip, "Sway", 6, 0.9, index * 1.3)
	end
	kit.Animate(plant, "Sway", 1, 0.4, 0.9)
	-- jardinière en bois
	kit.Part(body, 28, 76, 44, 24, C.WoodLight, { Radius = 5, Z = 5 })
	kit.Part(body, 25, 74, 50, 7, C.Wood, { Radius = -1, Z = 6, Shine = true })
	kit.Box(body, 29, 88, 42, 2.5, C.Wood, 0, 6)
	kit.Heart(body, 50, 89, 9, C.PinkDeep, 0, 7)
	return nil
end

-- Palmier en pot : tronc écaillé courbé, grandes palmes, noix de coco
Art.PalmTree = function(body, kit, _item)
	local C = kit.C
	local palm = kit.Pivot(body, 50, 72, 3)
	local trunk = { { 0, -4 }, { 1, -12 }, { 2.5, -20 }, { 4, -28 }, { 5.5, -36 }, { 6.5, -44 }, { 7, -52 } }
	for index, t in ipairs(trunk) do
		kit.Blob(palm, t[1], t[2], 15 - index * 0.6, 11, index % 2 == 0 and C.Wood or C.WoodLight, { Z = index, Thickness = 1.4 })
	end
	local top = kit.Pivot(palm, 7, -54, 9)
	local fronds = {
		{ 140, 32, C.Green },
		{ 40, 32, C.Green },
		{ -172, 38, C.LeafDark },
		{ -8, 38, C.LeafDark },
		{ -140, 34, C.Leaf },
		{ -40, 34, C.Leaf },
		{ -95, 24, Color3.fromRGB(150, 220, 130) },
	}
	for index, f in ipairs(fronds) do
		leaf(top, kit, 0, 0, f[1], f[2], 12, f[3], index)
	end
	for _, c in ipairs({ { -5, 4 }, { 4, 5 }, { 0, -1 } }) do
		local nut = kit.Blob(top, c[1], c[2], 9, 9, C.Brown, { Z = 9, Thickness = 1.2 })
		kit.Circle(nut, 2.5, 2.5, 2.5, 2.5, C.White, 0.4, 2)
	end
	kit.Animate(top, "Sway", 2.5, 0.6, 0.4)
	kit.Animate(palm, "Sway", 0.8, 0.4, 2)
	-- panier tressé
	kit.Part(body, 28, 72, 44, 28, C.WoodLight, { Radius = 10, Z = 5, Shade = 0.18 })
	for _, y in ipairs({ 80, 88 }) do
		kit.Box(body, 30, y, 40, 2, C.Wood, 0, 6)
	end
	kit.Part(body, 25, 69, 50, 8, C.Wood, { Radius = -1, Z = 7, Shine = true })
	return nil
end

-- Sapin de fête : étoile, guirlande lumineuse qui scintille, boules, cadeaux
Art.HolidayTree = function(body, kit, _item)
	local C = kit.C
	local green = Color3.fromRGB(90, 175, 115)
	kit.Part(body, 45, 70, 10, 14, C.WoodDark, { Radius = 3, Z = 1 })
	tier(body, kit, 50, 34, 40, kit.Darken(green, 0.06), 2)
	tier(body, kit, 50, 18, 30, green, 4)
	tier(body, kit, 50, 6, 20, kit.Lighten(green, 0.08), 6)
	kit.Face(body, 50, 44, 20, { Eyes = "happy", Z = 8 })
	-- guirlandes + ampoules
	local colors = { C.Heart, C.Butter, C.Sky, C.Mint, C.Lilac }
	local garlands = {
		{ 36, 24, 64, 20, 3 },
		{ 28, 53, 72, 48, 4 },
		{ 18, 72, 82, 66, 5 },
	}
	local n = 0
	for _, g in ipairs(garlands) do
		kit.Line(body, g[1], g[2], g[3], g[4], 1.4, C.Gold, 0.2, 8)
		for k = 0, g[5] - 1 do
			local t = (k + 0.5) / g[5]
			n += 1
			local bulb = kit.Circle(body, g[1] + (g[3] - g[1]) * t, g[2] + (g[4] - g[2]) * t + 2, 5.5, 5.5, colors[(n - 1) % #colors + 1], 0, 9)
			kit.Stroke(bulb, C.White, 1, 0.3)
			kit.Animate(bulb, "Pulse", 0.6, 1.2, n * 1.37)
		end
	end
	for _, b in ipairs({ { 32, 42, C.PinkDeep }, { 70, 40, C.Blue }, { 38, 62, C.Gold }, { 64, 61, C.Pink } }) do
		local ball = kit.Blob(body, b[1], b[2], 8, 8, b[3], { Z = 8, Thickness = 1.2 })
		kit.Circle(ball, 2.4, 2.4, 2.4, 2.4, C.White, 0.2, 2)
	end
	-- étoile
	local star = kit.Pivot(body, 50, 6, 9)
	kit.Part(star, -7, -7, 14, 14, C.Yellow, { Radius = 1, Z = 1, Outline = C.Gold })
	kit.Part(star, -7, -7, 14, 14, C.Yellow, { Radius = 1, Z = 2, Rotation = 45, Outline = C.Gold })
	kit.Shine(star, -4, -4, 4, 3, 3, 0.3)
	kit.Animate(star, "Sway", 6, 0.6, 0)
	-- seau + cadeaux
	kit.Part(body, 38, 80, 24, 20, C.Red, { Radius = 5, Z = 3 })
	kit.Part(body, 36, 78, 28, 6, kit.Lighten(C.Red, 0.25), { Radius = -1, Z = 4, Shine = true })
	for _, g in ipairs({ { 8, 82, 22, 18, C.Sky, C.Pink }, { 72, 86, 20, 14, C.Pink, C.Butter } }) do
		local x, y, w, h = g[1], g[2], g[3], g[4]
		local gift = kit.Part(body, x, y, w, h, g[5], { Radius = 3, Z = 5, Shine = true })
		kit.Box(gift, w / 2 - 2, 0, 4, h, g[6], 0, 2)
		kit.Blob(body, x + w / 2 - 4, y - 1, 8, 6, g[6], { Z = 6, Rotation = -20, Shade = false, Thickness = 1.2 })
		kit.Blob(body, x + w / 2 + 4, y - 1, 8, 6, g[6], { Z = 6, Rotation = 20, Shade = false, Thickness = 1.2 })
	end
	return { Glow = Color3.fromRGB(255, 225, 150) }
end

return Art
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="32">
              <Properties>
                <string name="Name">Setup95</string>
                <string name="Source"><![CDATA[--[[
	Setup95 (ModuleScript) — (v9.5) 🖥️ "Dopamine Setup" : les stimuli du
	clicker deviennent de vrais objets de la maison
	Emplacement : ReplicatedStorage > Client > Components > House > Art > Setup95
	Contrat : voir HouseArt (boîte 100 x 100, pieds en bas pour les objets au
	sol, objets muraux centrés).

	Bureaux gamer (1 à 5 écrans + chaise gamer vue de dos), clavier RGB,
	souris et tapis, télés DVD (sur pied / murales, du petit écran au
	cinéma géant) et leur meuble néon, écran flash info, chaînes hi-fi
	(radio-cassette -> mur de studio), moulin de jardin, vraie presse
	hydraulique, table à papier bulle, coin streaming live et plantes du
	Jardin de Dopamine en pot.
	Les écrans montrent une image fixe mais vivante (petites animations
	HouseArt) : coureur façon "Subway", live ASMR, logo DVD, flash info.
	Tout reste DANS le cadre de l'écran (le découpage ClipsDescendants ne
	marche plus si un parent est tourné).
	Les dessus (bureaux y = 50, meuble télé y = 55, table à papier bulle
	y = 52) sont déclarés dans House/HouseSurfaces (mêmes hauteurs que la 3D).
]]

local Art = {}

local rgb = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)
local NAVY = rgb(52, 60, 100)
local DARK = rgb(46, 48, 68)
local DARKER = rgb(30, 32, 46)
local STEEL = rgb(178, 188, 208)
local STEEL_DARK = rgb(120, 130, 152)
local CYAN = rgb(60, 222, 255)
local MAGENTA = rgb(255, 84, 196)
local LIME = rgb(140, 240, 110)
local RED = rgb(236, 66, 76)
local ORANGE = rgb(255, 152, 56)
local YELLOW = rgb(255, 214, 70)
local PURPLE = rgb(150, 100, 230)
local SKIN = rgb(255, 214, 186)
local DESK_TOP = rgb(64, 68, 104)

-- Couleurs arc-en-ciel (claviers, LED)
local RAINBOW = {
	rgb(255, 92, 120),
	rgb(255, 160, 70),
	rgb(255, 222, 80),
	rgb(120, 230, 120),
	rgb(70, 210, 255),
	rgb(130, 130, 255),
	rgb(210, 110, 255),
}

-- Logo DVD : une couleur par écran (comme les rebonds du stimulus)
local DVD_COLORS = { rgb(255, 90, 150), rgb(90, 200, 255), rgb(255, 210, 70), rgb(140, 240, 120), rgb(190, 130, 255) }

----------------------------------------------------------------------
-- Petits outils
----------------------------------------------------------------------

-- Bande de LED dégradée (cyan -> magenta) avec halo qui respire
local function ledStrip(kit, parent, x, y, w, h, z, phase)
	local strip = kit.Box(parent, x, y, w, h, WHITE, 0, z)
	kit.Round(strip)
	kit.Gradient(strip, CYAN, MAGENTA, 0)
	local glow = kit.Box(parent, x - 2, y - 2, w + 4, h + 4, MAGENTA, 0.72, (z or 2) - 1)
	kit.Round(glow)
	kit.Animate(glow, "Pulse", 0.2, 1.3, phase or 0)
	return strip
end

-- Note de musique (rond + hampe + drapeau)
local function note(kit, parent, x, y, size, color, z)
	local holder = kit.Group(parent, x - size / 2, y - size / 2, size, size, z)
	kit.Blob(holder, size * 0.32, size * 0.78, size * 0.46, size * 0.36, color, { Z = 2, Outline = false, Shade = false })
	kit.Box(holder, size * 0.5, size * 0.1, size * 0.12, size * 0.7, color, 0, 2)
	kit.Line(holder, size * 0.56, size * 0.14, size * 0.84, size * 0.34, size * 0.12, color, 0, 2)
	return holder
end

-- Petite étoile de rareté (plantes)
local function star(kit, parent, cx, cy, size, color, z)
	return kit.Sparkle(parent, cx, cy, size, color, 0, z)
end

----------------------------------------------------------------------
-- 📺 Images des écrans (tout reste dans w x h)
----------------------------------------------------------------------

-- Coureur façon "Subway" : ciel couchant, immeubles, voie en perspective,
-- héros qui court, pièces, train
local function feedRunner(kit, screen, w, h)
	local sky = kit.Box(screen, 0, 0, w, h, WHITE, 0, 1)
	kit.Gradient(sky, rgb(255, 176, 120), rgb(255, 120, 186), 90)
	kit.Circle(screen, w * 0.8, h * 0.22, h * 0.24, h * 0.24, rgb(255, 240, 160), 0, 2)
	for _, b in ipairs({ { 0.02, 0.14, 0.3 }, { 0.17, 0.1, 0.2 }, { 0.68, 0.12, 0.26 }, { 0.84, 0.14, 0.18 } }) do
		kit.Box(screen, w * b[1], h * (0.52 - b[3]), w * b[2], h * b[3] + 1, rgb(160, 96, 170), 0.15, 2)
	end
	kit.Box(screen, 0, h * 0.5, w, h * 0.5, rgb(122, 204, 132), 0, 2)
	-- voie (triangle depuis l'horizon) + rails
	kit.Triangle(screen, w / 2, h * 0.46, w * 0.9, h * 0.54, rgb(126, 116, 148), 3, 0, 8)
	for _, side in ipairs({ -1, 1 }) do
		kit.Line(screen, w / 2 + side * w * 0.02, h * 0.5, w / 2 + side * w * 0.16, h * 0.99, math.max(1, h * 0.03), rgb(236, 226, 255), 0.25, 4)
	end
	-- train dans le couloir de gauche
	local train = kit.Part(screen, w * 0.1, h * 0.58, w * 0.2, h * 0.34, RED, { Radius = 2, Z = 5, Thickness = 1, Shade = 0.2 })
	kit.Box(train, w * 0.03, h * 0.05, w * 0.14, h * 0.1, rgb(200, 236, 255), 0, 2)
	-- pièces qui flottent dans le couloir de droite
	for index, c in ipairs({ { 0.62, 0.56, 0.06 }, { 0.66, 0.66, 0.08 }, { 0.71, 0.8, 0.1 } }) do
		local coin = kit.Circle(screen, w * c[1], h * c[2], h * c[3] * 1.6, h * c[3] * 1.6, YELLOW, 0, 6)
		kit.Stroke(coin, rgb(210, 150, 40), 1, 0)
		kit.Animate(coin, "Bob", h * 0.03, 2.4, index * 0.7)
	end
	-- héros (sweat orange, casquette) au milieu
	local hero = kit.Group(screen, w * 0.44, h * 0.56, w * 0.12, h * 0.42, 7)
	local hw, hh = w * 0.12, h * 0.42
	kit.Part(hero, hw * 0.2, hh * 0.36, hw * 0.6, hh * 0.4, ORANGE, { Radius = 2, Z = 2, Thickness = 1 })
	kit.Box(hero, hw * 0.24, hh * 0.74, hw * 0.18, hh * 0.24, NAVY, 0, 1)
	kit.Box(hero, hw * 0.58, hh * 0.7, hw * 0.18, hh * 0.24, NAVY, 0, 1)
	kit.Circle(hero, hw * 0.5, hh * 0.24, hw * 0.52, hw * 0.52, SKIN, 0, 3)
	kit.Box(hero, hw * 0.22, hh * 0.08, hw * 0.56, hh * 0.1, rgb(80, 150, 255), 0, 4)
	kit.Animate(hero, "Bob", h * 0.04, 3, 0)
	-- score
	local score = kit.Text(screen, "1250", w * 0.16, h * 0.12, math.max(5, h * 0.16), WHITE, 8)
	score.TextStrokeTransparency = 0.4
end

-- Live ASMR : chambre violette, streameuse au casque qui croque un sandwich,
-- pastille LIVE, spectateurs, bulles de chat, cœurs
local function feedLive(kit, screen, w, h)
	local C = kit.C
	-- écran vertical (bureau ultime) : la streameuse au centre, sans le chat
	local tall = h > w * 1.1
	local room = kit.Box(screen, 0, 0, w, h, WHITE, 0, 1)
	kit.Gradient(room, rgb(120, 90, 200), rgb(60, 40, 110), 90)
	kit.Box(screen, 0, h * 0.78, w, h * 0.22, rgb(90, 60, 150), 0, 2) -- bureau
	-- guirlande lumineuse
	local bulbs = tall and 3 or 5
	for index = 0, bulbs - 1 do
		local size = math.min(w, h) * 0.07
		local bulb = kit.Circle(screen, w * (0.2 + index * (tall and 0.3 or 0.1)), h * (0.24 + (index % 2) * 0.04), size, size, C.Butter, 0, 2)
		kit.Animate(bulb, "Pulse", 0.5, 1.5, index)
	end
	-- streameuse
	local cx, cy, r = w * 0.34, h * 0.56, h * 0.48
	if tall then
		cx, cy, r = w * 0.5, h * 0.62, math.min(h * 0.36, w * 0.8)
	end
	kit.Blob(screen, cx, cy + r * 0.62, r * 1.1, r * 0.5, rgb(255, 140, 190), { Z = 3, Thickness = 1 }) -- sweat
	kit.Blob(screen, cx, cy - r * 0.06, r * 0.98, r * 0.9, rgb(120, 70, 60), { Z = 3, Thickness = 1, Shade = false }) -- cheveux
	local head = kit.Blob(screen, cx, cy + r * 0.04, r * 0.76, r * 0.72, SKIN, { Z = 4, Thickness = 1 })
	kit.Face(head, r * 0.38, r * 0.4, r * 0.62, { Eyes = "happy", Mouth = "o", Z = 3 })
	-- casque
	for _, side in ipairs({ -1, 1 }) do
		kit.Blob(screen, cx + side * r * 0.42, cy + r * 0.04, r * 0.2, r * 0.3, MAGENTA, { Z = 5, Thickness = 1 })
	end
	-- sandwich 🥪
	local sandwich = kit.Group(screen, cx + r * 0.2, cy + r * 0.2, r * 0.44, r * 0.3, 6)
	kit.Part(sandwich, 0, 0, r * 0.44, r * 0.1, rgb(236, 190, 120), { Radius = 2, Z = 1, Thickness = 0.8 })
	kit.Box(sandwich, 0, r * 0.1, r * 0.44, r * 0.06, LIME, 0, 2)
	kit.Part(sandwich, 0, r * 0.15, r * 0.44, r * 0.1, rgb(236, 190, 120), { Radius = 2, Z = 1, Thickness = 0.8 })
	kit.Animate(sandwich, "Bob", h * 0.02, 2.6, 0.5)
	-- LIVE (+ spectateurs sur les écrans larges)
	local liveW = tall and w * 0.62 or w * 0.22
	local liveH = tall and w * 0.24 or h * 0.15
	local live = kit.Part(screen, w * 0.05, h * 0.04, liveW, liveH, RED, { Radius = 3, Z = 7, Outline = false })
	kit.Animate(live, "Pulse", 0.25, 1.6, 0)
	kit.Text(live, "LIVE", liveW / 2, liveH / 2, math.max(4, liveH * 0.8), WHITE, 3)
	if not tall then
		kit.Text(screen, "👁 1.2K", w * 0.44, h * 0.12, math.max(4, h * 0.1), WHITE, 7)
		-- bulles de chat
		local chat = { MAGENTA, CYAN, C.Butter, LIME }
		for index, color in ipairs(chat) do
			local bubble = kit.Part(screen, w * 0.64, h * (0.1 + (index - 1) * 0.2), w * 0.32, h * 0.15, WHITE, { Radius = 3, Z = 6, Outline = false, T = 0.1 })
			kit.Box(bubble, w * 0.03, h * 0.04, w * 0.07, h * 0.07, color, 0, 2)
			kit.Box(bubble, w * 0.12, h * 0.05, w * 0.17, h * 0.04, rgb(170, 160, 200), 0, 2)
		end
	end
	-- cœurs qui montent
	for index = 1, 2 do
		local hx = if tall then w * (0.7 + index * 0.08) else w * (0.54 + index * 0.02)
		local size = math.min(h * 0.14, w * 0.3)
		local heartFrame = kit.Heart(screen, math.min(hx, w - size / 2), h * (0.66 - index * 0.14), size, C.Heart, 0, 8)
		kit.Animate(heartFrame, "Bob", h * 0.05, 1.8, index * 1.4)
	end
end

-- Logo DVD qui rebondit (dérive + montée : reste dans l'écran)
local function feedDVD(kit, screen, w, h, colorIndex: number?)
	local bg = kit.Box(screen, 0, 0, w, h, WHITE, 0, 1)
	kit.Gradient(bg, rgb(26, 22, 50), rgb(12, 10, 26), 90)
	-- étoiles de fond
	for index = 1, 5 do
		kit.Circle(screen, w * ((index * 0.37) % 1), h * ((index * 0.53) % 1), 1.5, 1.5, WHITE, 0.5, 2)
	end
	local color = DVD_COLORS[((colorIndex or 1) - 1) % #DVD_COLORS + 1]
	local lw, lh = w * 0.36, h * 0.34
	local driftBox = kit.Group(screen, w / 2 - lw / 2, h / 2 - lh / 2, lw, lh, 4)
	kit.Animate(driftBox, "Drift", (w - lw) * 0.42, 0.9, (colorIndex or 1) * 0.8)
	local logo = kit.Group(driftBox, 0, 0, lw, lh, 1)
	kit.Animate(logo, "Bob", (h - lh) * 0.4, 0.7, (colorIndex or 1) * 1.3)
	local plate = kit.Part(logo, 0, 0, lw, lh * 0.66, color, { Radius = math.max(2, lh * 0.2), Z = 1, Outline = false, Shade = 0.15 })
	local label = kit.Text(plate, "DVD", lw / 2, lh * 0.33, math.max(5, lh * 0.46), WHITE, 3)
	label.Font = Enum.Font.FredokaOne
	kit.Blob(logo, lw / 2, lh * 0.84, lw * 0.8, lh * 0.26, color, { Z = 1, Outline = false, Shade = false })
	kit.Blob(logo, lw / 2, lh * 0.84, lw * 0.26, lh * 0.1, rgb(26, 22, 50), { Z = 2, Outline = false, Shade = false })
	-- coin qui scintille (le fameux "coin parfait")
	local corner = kit.Sparkle(screen, w * 0.9, h * 0.14, math.max(5, h * 0.16), rgb(255, 240, 170), 0, 5)
	kit.Animate(corner, "Breathe", 0.2, 1.5, 0)
end

-- Flash info : studio bleu, présentateur, bandeau rouge et texte qui défile
local function feedNews(kit, screen, w, h)
	local studio = kit.Box(screen, 0, 0, w, h, WHITE, 0, 1)
	kit.Gradient(studio, rgb(70, 130, 230), rgb(30, 60, 140), 90)
	-- globe du studio
	local globe = kit.Circle(screen, w * 0.78, h * 0.34, h * 0.42, h * 0.42, rgb(120, 190, 255), 0.35, 2)
	kit.Stroke(globe, WHITE, 1, 0.5)
	kit.Box(screen, w * 0.78 - h * 0.21, h * 0.33, h * 0.42, 1, WHITE, 0.5, 3)
	-- présentateur
	local cx = w * 0.36
	kit.Blob(screen, cx, h * 0.7, h * 0.56, h * 0.36, NAVY, { Z = 3, Thickness = 1 }) -- veste
	kit.Box(screen, cx - h * 0.03, h * 0.56, h * 0.06, h * 0.16, RED, 0, 4) -- cravate
	local head = kit.Blob(screen, cx, h * 0.38, h * 0.3, h * 0.3, SKIN, { Z = 4, Thickness = 1 })
	kit.Face(head, h * 0.15, h * 0.16, h * 0.24, { Mouth = "o", Z = 3 })
	kit.Blob(screen, cx, h * 0.25, h * 0.3, h * 0.12, rgb(90, 60, 40), { Z = 5, Outline = false, Shade = false })
	-- bandeau "BREAKING"
	local bar = kit.Box(screen, 0, h * 0.64, w, h * 0.17, RED, 0, 6)
	local breaking = kit.Text(bar, "BREAKING", w * 0.26, h * 0.085, math.max(4, h * 0.12), WHITE, 3)
	breaking.Font = Enum.Font.FredokaOne
	local ticker = kit.Box(screen, 0, h * 0.81, w, h * 0.19, WHITE, 0, 6)
	local line = kit.Group(ticker, 0, 0, w, h * 0.19, 2, true)
	local text = kit.Text(line, "DOPAMINE +1000% • CLICKS AT ALL-TIME HIGH •", w * 0.5, h * 0.095, math.max(4, h * 0.1), rgb(40, 40, 70), 2)
	text.Size = UDim2.fromOffset(w * 1.3, h * 0.19)
	kit.Animate(text, "Drift", w * 0.12, 0.6, 0)
	local liveDot = kit.Circle(screen, w * 0.92, h * 0.1, h * 0.08, h * 0.08, RED, 0, 7)
	kit.Animate(liveDot, "Pulse", 0.6, 2, 0)
end

local FEEDS = {
	Runner = feedRunner,
	Live = feedLive,
	DVD = feedDVD,
	News = feedNews,
}

-- Écran encadré : cadre sombre + image (feed) + reflet ; renvoie le cadre
local function monitorFrame(kit, parent, x, y, w, h, feed: string, z: number, options: any?)
	local opts = options or {}
	local bezelColor = opts.Bezel or DARKER
	local bezel = kit.Part(parent, x, y, w, h, bezelColor, { Radius = opts.Radius or 3, Z = z, Thickness = 1.2, Shade = 0.1 })
	local inset = opts.Inset or math.max(1.6, math.min(w, h) * 0.06)
	local chin = opts.Chin or 0
	local sw, sh = w - inset * 2, h - inset * 2 - chin
	local screen = kit.Group(bezel, inset, inset, sw, sh, 2, true)
	local painter = FEEDS[feed] or feedDVD
	painter(kit, screen, sw, sh, opts.Color)
	-- reflet en biais (vitre)
	local glare = kit.Box(screen, sw * 0.62, -sh * 0.1, sw * 0.08, sh * 1.2, WHITE, 0.86, 20)
	glare.Rotation = 18
	if opts.Curved then
		-- écran incurvé : bords assombris (on devine la courbe)
		local shade = kit.Box(screen, 0, 0, sw, sh, rgb(10, 10, 30), 0, 19)
		local grad = Instance.new("UIGradient")
		grad.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.35),
			NumberSequenceKeypoint.new(0.2, 1),
			NumberSequenceKeypoint.new(0.8, 1),
			NumberSequenceKeypoint.new(1, 0.35),
		})
		grad.Parent = shade
	end
	if chin > 0 then
		local led = kit.Circle(bezel, w / 2, h - chin / 2 - inset / 2, math.max(1.5, chin * 0.35), math.max(1.5, chin * 0.35), LIME, 0, 3)
		kit.Animate(led, "Pulse", 0.4, 1, x)
	end
	return bezel
end

-- Pied d'écran (col + socle) de l'écran vers baseY
local function monitorStand(kit, parent, cx, topY, baseY, z)
	kit.Part(parent, cx - 2, topY, 4, math.max(1, baseY - topY - 2), STEEL, { Radius = 1, Z = z, Thickness = 1 })
	kit.Blob(parent, cx, baseY - 1.4, 18, 3.2, STEEL_DARK, { Z = z, Thickness = 1 })
end

----------------------------------------------------------------------
-- 🖥️ Bureaux gamer
----------------------------------------------------------------------

-- Chaise gamer vue de dos (au milieu, devant le bureau)
local function chairBack(kit, parent, cx, top, accent, z)
	local zz = z or 8
	for _, dx in ipairs({ -15, 0, 15 }) do
		kit.Line(parent, cx, 91, cx + dx, 97, 3, DARKER, 0, zz)
		kit.Circle(parent, cx + dx, 98, 4.5, 4.5, DARK, 0, zz + 1)
	end
	kit.Part(parent, cx - 2, 80, 4, 12, STEEL, { Radius = 1, Z = zz, Thickness = 1 })
	kit.Blob(parent, cx, 81, 36, 8, DARK, { Z = zz + 1, Thickness = 1.2 })
	for _, side in ipairs({ -1, 1 }) do
		kit.Part(parent, cx + side * 17 - 3, 68, 6, 13, DARKER, { Radius = 2, Z = zz + 1, Thickness = 1 })
		kit.Part(parent, cx + side * 17 - 4, 66, 8, 4, DARK, { Radius = 2, Z = zz + 2, Thickness = 1 })
	end
	local back = kit.Part(parent, cx - 14, top, 28, 78 - top, DARK, { Radius = 9, Z = zz + 3, Shine = true, Thickness = 1.4 })
	local bw = 28
	-- bandes "course" colorées
	kit.Box(back, 5, 6, 4, 78 - top - 12, accent, 0, 2)
	kit.Box(back, bw - 9, 6, 4, 78 - top - 12, accent, 0, 2)
	-- coussin de tête + petit cerveau (logo Dopamine)
	kit.Part(parent, cx - 8, top + 3, 16, 7, accent, { Radius = 3, Z = zz + 4, Thickness = 1 })
	kit.Heart(back, bw / 2, 78 - top - 12, 8, WHITE, 0.2, 3)
end

-- Plateau + pieds + LED du bureau (dessus à y = 50)
local function deskBase(kit, body, width: number?)
	local w = width or 98
	local x = (100 - w) / 2
	for _, lx in ipairs({ x + 4, x + w - 11 }) do
		kit.Part(body, lx, 54, 7, 45, DARK, { Radius = 2, Z = 1, Thickness = 1.2 })
		kit.Blob(body, lx + 3.5, 99, 11, 3, DARKER, { Z = 1, Outline = false, Shade = false })
	end
	kit.Part(body, x + 11, 55, w - 22, 12, DARKER, { Radius = 2, Z = 1, Thickness = 1 }) -- panneau arrière
	ledStrip(kit, body, x + 12, 56, w - 24, 1.6, 3, 0)
	local top = kit.Part(body, x, 49.5, w, 6, DESK_TOP, { Radius = 3, Z = 4, Shine = true, Thickness = 1.4 })
	local edge = kit.Box(top, 3, 4.2, w - 6, 1.2, WHITE, 0, 2)
	kit.Gradient(edge, CYAN, MAGENTA, 0)
	return top
end

-- Tour de PC vitrée à ventilateurs (au sol)
local function pcTower(kit, parent, x, y, w, h, z)
	local tower = kit.Part(parent, x, y, w, h, DARK, { Radius = 3, Z = z, Shine = true, Thickness = 1.2 })
	local glass = kit.Part(tower, 2.5, 3, w - 5, h - 10, rgb(20, 24, 44), { Radius = 2, Z = 2, Outline = CYAN, Thickness = 1 })
	for index, color in ipairs({ CYAN, MAGENTA }) do
		local fan = kit.Circle(glass, (w - 5) / 2, (h - 10) * (index == 1 and 0.28 or 0.66), (w - 5) * 0.7, (w - 5) * 0.7, DARKER, 0, 2)
		kit.Stroke(fan, color, 1.4, 0)
		local rotor = kit.Pivot(fan, (w - 5) * 0.35, (w - 5) * 0.35, 2)
		for k = 0, 2 do
			local arm = kit.Pivot(rotor, 0, 0, 1)
			arm.Rotation = k * 120
			local blade = kit.Box(arm, -1, -(w - 5) * 0.3, 2, (w - 5) * 0.24, kit.Lighten(color, 0.3), 0.1, 1)
			kit.Round(blade)
		end
		kit.Animate(rotor, "Spin", 1, 0.9, index)
	end
	kit.Circle(tower, w / 2, h - 3.5, 3, 3, LIME, 0, 3)
	return tower
end

-- Lampe de bureau néon (petit cercle lumineux)
local function deskLamp(kit, parent, x, baseY, color, z)
	kit.Blob(parent, x, baseY - 1.2, 10, 2.8, DARK, { Z = z, Outline = false })
	kit.Line(parent, x, baseY - 2, x + 3, baseY - 14, 1.6, STEEL_DARK, 0, z)
	local ring = kit.Circle(parent, x + 3, baseY - 18, 9, 9, WHITE, 0.2, z + 1)
	kit.Stroke(ring, color, 1.6, 0)
	local glow = kit.Circle(parent, x + 3, baseY - 18, 14, 14, color, 0.72, z)
	kit.Animate(glow, "Pulse", 0.2, 1.1, x)
end

-- 1 écran : coureur. Lampe néon, casque sur support, tour au sol
Art.SetupDeskSolo = function(body, kit, _item)
	local C = kit.C
	deskBase(kit, body)
	monitorStand(kit, body, 50, 38, 50, 3)
	monitorFrame(kit, body, 26, 11, 48, 29, "Runner", 5, { Chin = 2.5 })
	deskLamp(kit, body, 12, 50, MAGENTA, 5)
	-- casque sur son support
	kit.Part(body, 84, 34, 2.5, 16, STEEL, { Radius = 1, Z = 5, Thickness = 1 })
	kit.Blob(body, 85, 49, 10, 2.5, DARK, { Z = 5, Outline = false })
	local band = kit.Part(body, 79, 30, 13, 13, DARK, { Radius = -1, T = 1, Outline = CYAN, Thickness = 2.2, Shade = false, Z = 6 })
	local _ = band
	kit.Blob(body, 79.5, 40, 5, 7, CYAN, { Z = 7, Thickness = 1 })
	kit.Blob(body, 91.5, 40, 5, 7, CYAN, { Z = 7, Thickness = 1 })
	pcTower(kit, body, 72, 66, 16, 33, 6)
	chairBack(kit, body, 42, 57, MAGENTA, 8)
	kit.Sparkle(body, 8, 12, 8, C.Butter, 0, 9)
	return { Glow = CYAN }
end

-- 2 écrans : coureur + live
Art.SetupDeskDuo = function(body, kit, _item)
	local C = kit.C
	deskBase(kit, body)
	monitorStand(kit, body, 27, 38, 50, 3)
	monitorStand(kit, body, 73, 38, 50, 3)
	monitorFrame(kit, body, 4, 12, 45, 27, "Runner", 5, { Chin = 2.5 })
	monitorFrame(kit, body, 51, 12, 45, 27, "Live", 5, { Chin = 2.5 })
	pcTower(kit, body, 73, 64, 17, 35, 6)
	chairBack(kit, body, 44, 57, CYAN, 8)
	kit.Sparkle(body, 50, 6, 8, C.Butter, 0, 9)
	return { Glow = MAGENTA }
end

-- 3 écrans : live, coureur (au centre, plus haut), live ; écrans des côtés
-- tournés vers le joueur (plus étroits, bord foncé)
Art.SetupDeskTrio = function(body, kit, _item)
	local C = kit.C
	-- halo néon derrière
	local halo = kit.Part(body, 10, 4, 80, 40, PURPLE, { Radius = 18, Z = 1, Outline = false, Shade = false, T = 0.78 })
	kit.Animate(halo, "Pulse", 0.12, 1, 0)
	deskBase(kit, body)
	monitorStand(kit, body, 50, 36, 50, 3)
	monitorStand(kit, body, 16, 38, 50, 3)
	monitorStand(kit, body, 84, 38, 50, 3)
	monitorFrame(kit, body, 1, 15, 31, 24, "Live", 5, { Color = 2 })
	monitorFrame(kit, body, 68, 15, 31, 24, "Live", 5, { Color = 3 })
	for _, x in ipairs({ 1, 96.5 }) do
		kit.Box(body, x, 15.5, 2.5, 23, rgb(14, 14, 24), 0.3, 7) -- bord tourné
	end
	monitorFrame(kit, body, 31, 9, 38, 28, "Runner", 6, { Chin = 2.5 })
	pcTower(kit, body, 75, 62, 18, 37, 6)
	chairBack(kit, body, 44, 57, LIME, 8)
	kit.Sparkle(body, 94, 6, 8, C.Butter, 0, 9)
	return { Glow = PURPLE }
end

-- 5 écrans : grand écran incurvé (coureur), 2 écrans au-dessus (flash
-- info, DVD), 2 écrans verticaux (live) ; halo arc-en-ciel, LED partout
Art.SetupDeskUltra = function(body, kit, _item)
	local C = kit.C
	-- halo arc-en-ciel qui respire
	local halo = kit.Part(body, 2, -2, 96, 50, WHITE, { Radius = 20, Z = 1, Outline = false, Shade = false, T = 0.6 })
	kit.Gradient(halo, RAINBOW[1], RAINBOW[6], 0)
	kit.Animate(halo, "Pulse", 0.2, 0.9, 0)
	deskBase(kit, body)
	-- bras d'écrans (poteau central)
	kit.Part(body, 48.5, 4, 3, 46, STEEL_DARK, { Radius = 1, Z = 2, Thickness = 1 })
	kit.Blob(body, 50, 48.6, 16, 3, STEEL_DARK, { Z = 3, Thickness = 1 })
	monitorFrame(kit, body, 22, 1, 27, 17, "News", 4)
	monitorFrame(kit, body, 51, 1, 27, 17, "DVD", 4, { Color = 4 })
	monitorFrame(kit, body, 15, 20, 70, 25, "Runner", 6, { Curved = true, Chin = 2.5 })
	-- écrans verticaux sur pieds
	monitorStand(kit, body, 8, 44, 50, 3)
	monitorStand(kit, body, 92, 44, 50, 3)
	monitorFrame(kit, body, 0, 12, 15, 33, "Live", 5, { Color = 1 })
	monitorFrame(kit, body, 85, 12, 15, 33, "Live", 5, { Color = 2 })
	-- tour vitrée à gauche au sol + enceintes RGB sur le bureau
	pcTower(kit, body, 8, 62, 18, 37, 6)
	for index, x in ipairs({ 17, 79 }) do
		local speaker = kit.Part(body, x, 40, 5, 9.5, DARK, { Radius = 2, Z = 7, Thickness = 1 })
		local cone = kit.Circle(speaker, 2.5, 6, 3.5, 3.5, RAINBOW[index * 2], 0, 2)
		kit.Animate(cone, "Pulse", 0.4, 2, index)
	end
	chairBack(kit, body, 54, 56, MAGENTA, 8)
	for index, pos in ipairs({ { 3, 6 }, { 97, 52 } }) do
		local s = kit.Sparkle(body, pos[1], pos[2], 8, index == 2 and CYAN or C.Butter, 0, 9)
		kit.Animate(s, "Breathe", 0.2, 1.4, index)
	end
	return { Glow = MAGENTA }
end

----------------------------------------------------------------------
-- ⌨️ Clavier RGB, 🖱️ souris gamer
----------------------------------------------------------------------

Art.SetupKeyboard = function(body, kit, _item)
	-- câble qui remonte derrière
	kit.Line(body, 50, 60, 54, 44, 2, DARKER, 0, 1)
	kit.Line(body, 54, 44, 66, 38, 2, DARKER, 0, 1)
	local glow = kit.Part(body, 0, 60, 100, 38, MAGENTA, { Radius = 10, Z = 1, Outline = false, Shade = false, T = 0.7 })
	kit.Gradient(glow, CYAN, MAGENTA, 0)
	kit.Animate(glow, "Pulse", 0.2, 1.3, 0)
	local board = kit.Part(body, 2, 62, 96, 32, DARK, { Radius = 6, Z = 2, Shine = true, Thickness = 1.5 })
	-- 4 rangées de touches arc-en-ciel (couleur selon la colonne)
	local cols = 11
	local keyW, keyH, gap = 6.8, 5, 1.4
	for row = 0, 3 do
		local count = row == 3 and 3 or cols
		for col = 0, count - 1 do
			local x, w = 4 + col * (keyW + gap), keyW
			if row == 3 then
				-- rangée du bas : Ctrl, grande barre d'espace, flèche
				x = ({ 4, 20.4, 77.8 })[col + 1]
				w = ({ 14, 55, 14 })[col + 1]
			end
			local hue = RAINBOW[math.clamp(math.floor((x + w / 2) / 96 * #RAINBOW) + 1, 1, #RAINBOW)]
			local key = kit.Box(board, x, 4 + row * (keyH + gap), w, keyH, hue, 0, 3)
			kit.Round(key, 1.5)
			kit.Box(key, 1, 0.6, w - 2, 1.4, WHITE, 0.55, 2)
		end
	end
	-- touches qui s'enfoncent (petit clignement de lumière)
	for index, pos in ipairs({ { 2, 1 }, { 6, 2 }, { 9, 0 } }) do
		local flash = kit.Box(board, 4 + pos[1] * (keyW + gap), 4 + pos[2] * (keyH + gap), keyW, keyH, WHITE, 0.4, 5)
		kit.Round(flash, 1.5)
		kit.Animate(flash, "Pulse", 0.6, 2.2, index * 1.3)
	end
	-- repose-poignets
	kit.Part(body, 16, 92, 68, 6, rgb(80, 84, 116), { Radius = 3, Z = 3, Thickness = 1 })
	return { Glow = CYAN, Flat = false }
end

Art.SetupMouse = function(body, kit, _item)
	-- tapis (bord RGB)
	local pad = kit.Blob(body, 50, 90, 98, 18, DARKER, { Z = 1, Outline = MAGENTA, Thickness = 2 })
	kit.Blob(pad, 49, 9, 84, 10, DARK, { Z = 2, Outline = false, Shade = false })
	-- câble
	kit.Line(body, 50, 34, 56, 18, 2.2, DARKER, 0, 2)
	kit.Line(body, 56, 18, 70, 8, 2.2, DARKER, 0, 2)
	-- souris
	local glow = kit.Blob(body, 50, 64, 50, 58, CYAN, { Z = 2, Outline = false, Shade = false, T = 0.72 })
	kit.Animate(glow, "Pulse", 0.2, 1.4, 0)
	local mouse = kit.Blob(body, 50, 64, 42, 54, DARK, { Z = 3, Shine = true, Thickness = 1.6 })
	kit.Box(mouse, 20.2, 2, 1.6, 20, DARKER, 0, 2) -- séparation des boutons
	local wheel = kit.Part(mouse, 18, 7, 6, 11, CYAN, { Radius = 3, Z = 3, Thickness = 1 })
	kit.Gradient(wheel, CYAN, MAGENTA, 90)
	kit.Animate(wheel, "Pulse", 0.3, 2, 0.5)
	-- boutons latéraux + logo
	kit.Part(mouse, 1, 24, 4, 6, STEEL, { Radius = 2, Z = 3, Thickness = 0.8 })
	kit.Part(mouse, 1, 32, 4, 6, STEEL, { Radius = 2, Z = 3, Thickness = 0.8 })
	local logo = kit.Heart(mouse, 21, 38, 10, MAGENTA, 0, 3)
	kit.Animate(logo, "Pulse", 0.4, 1.2, 1)
	-- petit "clic !"
	local spark = kit.Sparkle(body, 26, 36, 10, rgb(255, 240, 170), 0, 5)
	kit.Animate(spark, "Breathe", 0.25, 2, 0)
	return { Glow = CYAN }
end

----------------------------------------------------------------------
-- 📺 Télés DVD
----------------------------------------------------------------------

-- Petite télé (sur un meuble) : antenne lapin, pieds courts
Art.SetupTVSmall = function(body, kit, _item)
	local C = kit.C
	kit.Line(body, 50, 26, 34, 6, 2, STEEL_DARK, 0, 1)
	kit.Line(body, 50, 26, 68, 4, 2, STEEL_DARK, 0, 1)
	kit.Circle(body, 34, 6, 5, 5, C.Pink, 0, 2)
	kit.Circle(body, 68, 4, 5, 5, C.Mint, 0, 2)
	for _, x in ipairs({ 24, 76 }) do
		kit.Part(body, x - 3, 86, 6, 13, DARK, { Radius = 2, Z = 1, Thickness = 1 })
	end
	local case = kit.Part(body, 6, 24, 88, 64, rgb(255, 170, 200), { Radius = 12, Z = 2, Shine = true, Shade = 0.18 })
	local _ = case
	monitorFrame(kit, body, 12, 30, 62, 50, "DVD", 3, { Radius = 8, Color = 1, Bezel = rgb(60, 50, 80) })
	for index, color in ipairs({ C.Butter, C.Mint }) do
		local knob = kit.Blob(body, 84, 40 + (index - 1) * 14, 10, 10, color, { Z = 4, Shine = true })
		kit.Box(knob, 4.2, 1, 1.6, 4, kit.OutlineOf(color), 0, 3)
	end
	for i = 0, 2 do
		kit.Box(body, 79, 64 + i * 4, 11, 1.6, kit.OutlineOf(rgb(255, 170, 200)), 0.3, 4)
	end
	return { Glow = rgb(255, 120, 180) }
end

-- Télé plate sur petits pieds
Art.SetupTVMedium = function(body, kit, _item)
	for _, x in ipairs({ 14, 86 }) do
		kit.Line(body, x, 86, x + (x < 50 and -5 or 5), 99, 3, STEEL_DARK, 0, 1)
	end
	monitorFrame(kit, body, 2, 30, 96, 58, "DVD", 2, { Color = 2, Chin = 3, Inset = 2.5 })
	return { Glow = CYAN }
end

-- Grande télé : pied central + barre de son
Art.SetupTVLarge = function(body, kit, _item)
	kit.Part(body, 44, 80, 12, 12, STEEL_DARK, { Radius = 2, Z = 1, Thickness = 1 })
	kit.Blob(body, 50, 97, 46, 6, STEEL_DARK, { Z = 1, Thickness = 1 })
	local halo = kit.Part(body, -2, 22, 104, 64, CYAN, { Radius = 10, Z = 1, Outline = false, Shade = false, T = 0.8 })
	kit.Animate(halo, "Pulse", 0.12, 1, 0)
	monitorFrame(kit, body, 0, 24, 100, 60, "DVD", 2, { Color = 3, Inset = 2 })
	local bar = kit.Part(body, 22, 88, 56, 7, DARK, { Radius = 3, Z = 3, Thickness = 1 })
	for i = 0, 9 do
		kit.Box(bar, 4 + i * 5, 2.5, 2.4, 2, STEEL, 0.2, 2)
	end
	return { Glow = CYAN }
end

-- Télé cinéma géante sur chevalet (pieds écartés + barre), rétroéclairage
Art.SetupTVGiant = function(body, kit, _item)
	local C = kit.C
	for _, side in ipairs({ -1, 1 }) do
		kit.Line(body, 50 + side * 26, 60, 50 + side * 38, 99, 3.5, DARK, 0, 1)
		kit.Blob(body, 50 + side * 38, 99, 10, 3, DARKER, { Z = 1, Outline = false })
	end
	kit.Box(body, 22, 84, 56, 3, DARK, 0, 1)
	local halo = kit.Part(body, -4, 0, 108, 70, WHITE, { Radius = 14, Z = 1, Outline = false, Shade = false, T = 0.62 })
	kit.Gradient(halo, MAGENTA, CYAN, 0)
	kit.Animate(halo, "Pulse", 0.2, 0.8, 0)
	monitorFrame(kit, body, 0, 4, 100, 62, "DVD", 2, { Color = 5, Inset = 1.8 })
	-- barre de son + caisson de basses
	local bar = kit.Part(body, 18, 70, 64, 7, DARK, { Radius = 3, Z = 3, Thickness = 1 })
	ledStrip(kit, bar, 4, 5, 56, 1, 3, 1)
	local sub = kit.Part(body, 74, 80, 20, 19, DARK, { Radius = 4, Z = 3, Thickness = 1.2 })
	local cone = kit.Circle(sub, 10, 9.5, 13, 13, DARKER, 0, 2)
	kit.Stroke(cone, MAGENTA, 1.2, 0)
	kit.Animate(cone, "Breathe", 0.06, 3, 0)
	kit.Sparkle(body, 8, 76, 9, C.Butter, 0, 4)
	return { Glow = MAGENTA }
end

-- Support mural (plaque + bras) derrière une télé murale
local function wallBracket(kit, body, cx, top, bottom)
	kit.Part(body, cx - 12, top, 24, bottom - top, rgb(90, 96, 120), { Radius = 3, Z = 1, Thickness = 1 })
	for _, dy in ipairs({ 3, bottom - top - 6 }) do
		for _, dx in ipairs({ -8, 5 }) do
			kit.Circle(body, cx + dx + 1.5, top + dy + 1.5, 2.4, 2.4, STEEL, 0, 2)
		end
	end
end

Art.SetupTVWallMedium = function(body, kit, _item)
	wallBracket(kit, body, 50, 14, 86)
	monitorFrame(kit, body, 2, 20, 96, 60, "DVD", 3, { Color = 2, Chin = 3, Inset = 2.5 })
	return { Glow = CYAN, WallShadow = Vector2.new(96, 60) }
end

Art.SetupTVWallLarge = function(body, kit, _item)
	wallBracket(kit, body, 50, 12, 88)
	local halo = kit.Part(body, -3, 15, 106, 70, CYAN, { Radius = 12, Z = 2, Outline = false, Shade = false, T = 0.74 })
	kit.Animate(halo, "Pulse", 0.14, 1, 0)
	monitorFrame(kit, body, 0, 18, 100, 64, "DVD", 3, { Color = 3, Inset = 2 })
	return { Glow = CYAN, WallShadow = Vector2.new(100, 64) }
end

Art.SetupTVWallGiant = function(body, kit, _item)
	wallBracket(kit, body, 50, 10, 90)
	local halo = kit.Part(body, -5, 11, 110, 78, WHITE, { Radius = 14, Z = 2, Outline = false, Shade = false, T = 0.6 })
	kit.Gradient(halo, MAGENTA, CYAN, 0)
	kit.Animate(halo, "Pulse", 0.2, 0.8, 0)
	monitorFrame(kit, body, 0, 14, 100, 70, "DVD", 3, { Color = 5, Inset = 1.8 })
	local s = kit.Sparkle(body, 96, 12, 9, kit.C.Butter, 0, 6)
	kit.Animate(s, "Breathe", 0.25, 1.4, 0)
	return { Glow = MAGENTA, WallShadow = Vector2.new(100, 70) }
end

-- Écran "flash info" mural
Art.SetupNewsTV = function(body, kit, _item)
	wallBracket(kit, body, 50, 16, 84)
	monitorFrame(kit, body, 4, 20, 92, 58, "News", 3, { Inset = 2.5 })
	local tag = kit.Part(body, 6, 12, 26, 9, RED, { Radius = 3, Z = 5, Thickness = 1 })
	kit.Text(tag, "NEWS", 13, 4.5, 6.5, WHITE, 3)
	return { Glow = rgb(120, 180, 255), WallShadow = Vector2.new(92, 58) }
end

-- Meuble télé néon (dessus à y = 55) : portes vitrées, console, disques
Art.SetupTVStand = function(body, kit, _item)
	local C = kit.C
	for _, x in ipairs({ 8, 88 }) do
		kit.Part(body, x, 93, 5, 7, DARKER, { Radius = 2, Z = 1, Thickness = 1 })
	end
	local cab = kit.Part(body, 2, 58, 96, 36, rgb(70, 64, 110), { Radius = 5, Z = 2, Shine = true, Shade = 0.2 })
	local top = kit.Part(body, 0, 54.5, 100, 5.5, rgb(96, 90, 140), { Radius = 3, Z = 3, Thickness = 1.4 })
	local _ = top
	ledStrip(kit, body, 4, 60.5, 92, 1.6, 4, 0)
	-- portes vitrées (à gauche et à droite) avec disques
	for index, x in ipairs({ 4, 68 }) do
		local door = kit.Part(cab, x, 6, 24, 26, rgb(36, 32, 64), { Radius = 3, Z = 2, Outline = index == 1 and CYAN or MAGENTA, Thickness = 1.2 })
		for k = 0, 3 do
			kit.Box(door, 3 + k * 5, 6, 3.5, 17, RAINBOW[(k + index * 2) % #RAINBOW + 1], 0.1, 2)
		end
		kit.Box(door, 18, 2, 1.6, 22, WHITE, 0.75, 3)
	end
	-- niche du milieu : console + manette
	local niche = kit.Part(cab, 30, 6, 36, 26, rgb(30, 26, 52), { Radius = 3, Z = 2, Outline = false })
	local console = kit.Part(niche, 5, 12, 26, 9, WHITE, { Radius = 3, Z = 2, Thickness = 1 })
	local light = kit.Box(console, 3, 6, 20, 1.2, CYAN, 0, 2)
	kit.Animate(light, "Pulse", 0.5, 1.2, 0)
	kit.Blob(niche, 18, 5, 14, 6, MAGENTA, { Z = 2, Thickness = 1 })
	kit.Sparkle(body, 94, 46, 8, C.Butter, 0, 5)
	return { Glow = MAGENTA }
end

----------------------------------------------------------------------
-- 🎧 Chaînes hi-fi
----------------------------------------------------------------------

-- Haut-parleur rond (membrane qui "respire")
local function driver(kit, parent, cx, cy, size, ring, z, phase)
	kit.Circle(parent, cx, cy, size, size, rgb(236, 230, 250), 0, z)
	local cone = kit.Circle(parent, cx, cy, size * 0.78, size * 0.78, rgb(70, 64, 96), 0, z + 1)
	kit.Stroke(cone, ring, 1.2, 0)
	kit.Circle(cone, size * 0.39, size * 0.39, size * 0.28, size * 0.28, ring, 0, 2)
	kit.Animate(cone, "Breathe", 0.06, 3, phase or 0)
	return cone
end

-- Radio-cassette lofi (poignée, 2 haut-parleurs, cassette qui tourne)
Art.SetupHiFiBoombox = function(body, kit, _item)
	local C = kit.C
	local shell = rgb(190, 160, 250)
	kit.Line(body, 80, 40, 92, 6, 2, STEEL_DARK, 0, 1) -- antenne
	kit.Circle(body, 92, 6, 4, 4, C.Pink, 0, 2)
	local handle = kit.Part(body, 22, 24, 56, 18, shell, { Radius = 8, T = 1, Outline = kit.OutlineOf(shell), Thickness = 4, Shade = false, Z = 1 })
	local _ = handle
	local case = kit.Part(body, 4, 38, 92, 58, shell, { Radius = 12, Z = 2, Shine = true, Shade = 0.2 })
	kit.Box(case, 6, 6, 80, 5, kit.Lighten(shell, 0.4), 0, 2)
	driver(kit, body, 24, 70, 30, MAGENTA, 3, 0)
	driver(kit, body, 76, 70, 30, CYAN, 3, 1.5)
	-- cassette au milieu
	local tape = kit.Part(body, 38, 58, 24, 20, rgb(60, 50, 90), { Radius = 3, Z = 4, Thickness = 1.2 })
	kit.Box(tape, 3, 3, 18, 6, C.Butter, 0, 2)
	for _, x in ipairs({ 7, 17 }) do
		local reel = kit.Pivot(tape, x, 13, 3)
		kit.Circle(reel, 0, 0, 7, 7, WHITE, 0, 1)
		kit.Box(reel, -0.8, -3, 1.6, 6, rgb(60, 50, 90), 0, 2)
		kit.Animate(reel, "Spin", 1, 0.6, x)
	end
	-- boutons
	for i, color in ipairs({ RED, C.Butter, C.Mint, C.Sky }) do
		kit.Part(body, 36 + (i - 1) * 7.5, 44, 6, 6, color, { Radius = 2, Z = 4, Thickness = 1 })
	end
	for i, pos in ipairs({ { 10, 26 }, { 90, 30 } }) do
		local n = note(kit, body, pos[1], pos[2], 12, i == 1 and C.PinkDeep or PURPLE, 6)
		kit.Animate(n, "Bob", 2.5, 1.2, i * 1.1)
	end
	return { Glow = rgb(210, 170, 255) }
end

-- Mini-chaîne CD : unité centrale (écran bleu, égaliseur) + 2 enceintes,
-- un CD qui tourne sur le dessus
Art.SetupHiFiCD = function(body, kit, _item)
	local C = kit.C
	for index, x in ipairs({ 2, 72 }) do
		local box = kit.Part(body, x, 44, 26, 54, rgb(70, 66, 100), { Radius = 5, Z = 1, Shine = true, Shade = 0.2 })
		local _ = box
		driver(kit, body, x + 13, 58, 13, index == 1 and MAGENTA or CYAN, 2, index)
		driver(kit, body, x + 13, 82, 20, index == 1 and MAGENTA or CYAN, 2, index + 0.7)
	end
	local unit = kit.Part(body, 30, 38, 40, 60, rgb(210, 214, 236), { Radius = 5, Z = 2, Shine = true, Shade = 0.2 })
	local display = kit.Part(unit, 4, 5, 32, 16, rgb(30, 50, 110), { Radius = 3, Z = 2, Outline = false })
	for i = 0, 6 do
		local barH = 3 + ((i * 5) % 9)
		local eqBar = kit.Box(display, 3 + i * 4, 14 - barH, 2.6, barH, RAINBOW[i + 1], 0, 2)
		kit.Animate(eqBar, "Pulse", 0.6, 2.4, i * 0.8)
	end
	kit.Part(unit, 4, 26, 32, 5, rgb(160, 164, 190), { Radius = 2, Z = 2, Thickness = 1 }) -- tiroir CD
	for i, color in ipairs({ C.Pink, C.Butter, C.Mint }) do
		kit.Circle(unit, 9 + (i - 1) * 11, 40, 6, 6, color, 0, 2)
	end
	local knob = kit.Blob(unit, 20, 51, 11, 11, STEEL, { Z = 2, Shine = true })
	kit.Box(knob, 4.8, 1, 1.4, 4, DARK, 0, 3)
	-- CD brillant qui tourne sur le dessus
	local cd = kit.Pivot(body, 50, 28, 3)
	local disc = kit.Circle(cd, 0, 0, 22, 22, WHITE, 0, 1)
	kit.Gradient(disc, rgb(200, 240, 255), rgb(255, 190, 240), 45)
	kit.Stroke(disc, STEEL_DARK, 1, 0)
	kit.Circle(cd, 0, 0, 13, 13, WHITE, 0.5, 2)
	kit.Circle(cd, 0, 0, 6, 6, rgb(210, 214, 236), 0, 2)
	kit.Circle(cd, 0, 0, 2.6, 2.6, DARK, 0, 3)
	kit.Box(cd, -1, -10, 2, 5, WHITE, 0.2, 3)
	kit.Box(cd, 4, 3, 2, 5, rgb(255, 200, 240), 0.3, 3)
	kit.Animate(cd, "Spin", 1, 0.5, 0)
	return { Glow = C.Sky }
end

-- Platine vinyle sur console en bois + enceintes colonnes
Art.SetupHiFiVinyl = function(body, kit, _item)
	local C = kit.C
	-- enceintes colonnes
	for index, x in ipairs({ 0, 80 }) do
		kit.Part(body, x, 28, 20, 71, rgb(160, 110, 78), { Radius = 4, Z = 1, Shine = true, Shade = 0.2 })
		driver(kit, body, x + 10, 40, 11, C.Butter, 2, index)
		driver(kit, body, x + 10, 62, 16, C.Butter, 2, index + 0.4)
		driver(kit, body, x + 10, 84, 16, C.Butter, 2, index + 0.8)
	end
	-- console "années 60" : pieds obliques, étagère à vinyles
	for _, side in ipairs({ -1, 1 }) do
		kit.Line(body, 50 + side * 22, 88, 50 + side * 27, 99, 2.6, C.WoodDark, 0, 2)
	end
	local console = kit.Part(body, 21, 56, 58, 34, C.Wood, { Radius = 4, Z = 3, Shine = true, Shade = 0.18 })
	for k = 0, 8 do
		kit.Box(console, 4 + k * 5.6, 12, 4.2, 18, RAINBOW[k % #RAINBOW + 1], 0.1, 2)
	end
	kit.Box(console, 3, 9, 52, 1.4, C.WoodDark, 0.3, 2)
	-- platine (plateau vu de biais + disque + bras)
	local deck = kit.Part(body, 25, 44, 50, 13, rgb(60, 56, 80), { Radius = 3, Z = 4, Thickness = 1.2 })
	local disc = kit.Blob(deck, 20, 5.5, 34, 8, rgb(30, 28, 40), { Z = 2, Outline = false })
	kit.Blob(disc, 17, 4, 10, 3.4, C.PinkDeep, { Z = 2, Outline = false, Shade = false })
	local shineDot = kit.Blob(disc, 8, 2.4, 8, 1.6, WHITE, { Z = 3, Outline = false, Shade = false, T = 0.5 })
	kit.Animate(shineDot, "Drift", 8, 2.4, 0)
	local armPivot = kit.Pivot(deck, 44, 2, 3)
	kit.Line(armPivot, 0, 0, -9, 4, 1.6, STEEL, 0, 1)
	kit.Circle(armPivot, 0, 0, 4, 4, STEEL_DARK, 0, 2)
	kit.Animate(armPivot, "Sway", 3, 0.8, 0)
	for i, pos in ipairs({ { 30, 32 }, { 50, 24 }, { 70, 34 } }) do
		local n = note(kit, body, pos[1], pos[2], 11, i == 2 and PURPLE or C.PinkDeep, 6)
		kit.Animate(n, "Bob", 2.5, 1.1, i * 1.3)
	end
	return { Glow = C.Butter }
end

-- Mur de studio lofi : étagère de pochettes, enceintes tours, table de
-- mixage avec VU-mètres, platine
Art.SetupHiFiStudio = function(body, kit, _item)
	local C = kit.C
	-- étagère murale de vinyles (pochettes colorées)
	local shelf = kit.Part(body, 18, 2, 64, 30, rgb(90, 70, 130), { Radius = 5, Z = 1, Shade = 0.15 })
	local sleeves = { { MAGENTA, CYAN }, { C.Butter, PURPLE }, { LIME, RED }, { rgb(255, 160, 90), C.Sky } }
	for index, pair in ipairs(sleeves) do
		local x = 4 + (index - 1) * 15
		kit.Circle(shelf, x + 12, 13, 12, 12, rgb(30, 28, 40), 0, 2)
		local sleeve = kit.Part(shelf, x, 4, 13, 20, pair[1], { Radius = 2, Z = 3, Thickness = 1 })
		kit.Circle(sleeve, 6.5, 10, 7, 7, pair[2], 0, 2)
	end
	local neon = kit.Text(body, "LOFI", 50, 38, 9, WHITE, 3)
	neon.TextStrokeColor3 = MAGENTA
	neon.TextStrokeTransparency = 0
	kit.Animate(neon, "Bob", 1, 1.3, 0)
	-- enceintes tours
	for index, x in ipairs({ 0, 82 }) do
		kit.Part(body, x, 20, 18, 79, DARK, { Radius = 4, Z = 2, Shine = true, Thickness = 1.3 })
		local led = kit.Box(body, x + 2, 22, 14, 1.4, index == 1 and MAGENTA or CYAN, 0, 4)
		kit.Animate(led, "Pulse", 0.5, 2, index)
		driver(kit, body, x + 9, 33, 10, index == 1 and MAGENTA or CYAN, 3, index)
		driver(kit, body, x + 9, 55, 15, index == 1 and MAGENTA or CYAN, 3, index + 0.3)
		driver(kit, body, x + 9, 80, 15, index == 1 and MAGENTA or CYAN, 3, index + 0.6)
	end
	-- table de mixage
	for _, x in ipairs({ 22, 74 }) do
		kit.Part(body, x, 66, 4, 33, DARKER, { Radius = 1, Z = 3, Thickness = 1 })
	end
	local desk = kit.Part(body, 19, 54, 62, 14, DARK, { Radius = 3, Z = 4, Shine = true, Thickness = 1.3 })
	-- VU-mètres (deux colonnes de LED qui montent / descendent)
	for column = 0, 1 do
		for level = 0, 5 do
			local color = if level >= 5 then RED elseif level >= 3 then YELLOW else LIME
			local led = kit.Box(desk, 36 + column * 5, 10 - level * 1.6, 3.6, 1.2, color, 0, 2)
			kit.Animate(led, "Pulse", 0.8, 2.6 + column, level * 0.9)
		end
	end
	for i = 0, 3 do
		kit.Circle(desk, 48 + i * 3.4, 4, 2.6, 2.6, RAINBOW[i + 2], 0, 2)
	end
	-- platine sur la table (disque qui tourne, vu de biais)
	local disc = kit.Blob(desk, 16, 4, 24, 5, rgb(30, 28, 40), { Z = 3, Outline = false })
	local glint = kit.Blob(disc, 6, 1.5, 6, 1.2, WHITE, { Z = 2, Outline = false, Shade = false, T = 0.4 })
	kit.Animate(glint, "Drift", 6, 2.4, 0)
	-- casque sur la table
	kit.Blob(body, 72, 52, 8, 7, MAGENTA, { Z = 5, Thickness = 1 })
	kit.Blob(body, 62, 52, 8, 7, MAGENTA, { Z = 5, Thickness = 1 })
	kit.Part(body, 60, 43, 14, 11, DARK, { Radius = -1, T = 1, Outline = DARK, Thickness = 2, Shade = false, Z = 5 })
	for i, pos in ipairs({ { 12, 10 }, { 88, 12 } }) do
		local n = note(kit, body, pos[1], pos[2], 10, i == 1 and C.Butter or CYAN, 6)
		kit.Animate(n, "Bob", 2.5, 1.1, i)
	end
	return { Glow = MAGENTA }
end

----------------------------------------------------------------------
-- 🌀 Moulin, 🗜️ presse, 🔘 papier bulle, 🎥 coin live
----------------------------------------------------------------------

-- Moulin de jardin : petite tour pastel + 4 ailes couleurs "moulin à vent"
Art.SetupWindmill = function(body, kit, _item)
	local C = kit.C
	-- herbe + fleurs
	kit.Blob(body, 50, 98, 90, 8, C.Leaf, { Z = 1, Outline = false })
	for i, x in ipairs({ 12, 22, 80, 90 }) do
		kit.Circle(body, x, 94 - (i % 2) * 2, 5, 5, ({ C.Pink, C.Butter, C.Sky, C.Pink })[i], 0, 2)
	end
	-- tour en trapèze (tranches qui s'élargissent vers le bas) + planches
	local towerColor = rgb(255, 238, 220)
	local tower = kit.Group(body, 20, 28, 60, 70, 3)
	local slices = 14
	for k = 0, slices - 1 do
		local t = k / (slices - 1)
		local sliceW = 30 + 26 * t
		local slice = kit.Box(tower, 30 - sliceW / 2, k * 5, sliceW, 5.4, towerColor, 0, 1)
		if k % 4 == 3 then
			kit.Box(slice, 0, 4.2, sliceW, 1.1, C.WoodDark, 0.55, 2)
		end
	end
	kit.Line(body, 35, 28, 22, 98, 1.6, kit.OutlineOf(towerColor), 0, 4)
	kit.Line(body, 65, 28, 78, 98, 1.6, kit.OutlineOf(towerColor), 0, 4)
	local door = kit.Part(body, 43, 78, 14, 20, C.Wood, { Radius = 6, Z = 4, Thickness = 1.2 })
	kit.Circle(door, 11, 11, 2, 2, C.Butter, 0, 2)
	local window = kit.Part(body, 44, 50, 12, 12, C.Sky, { Radius = -1, Z = 4, Shine = true })
	kit.Box(window, 5.4, 0, 1.2, 12, WHITE, 0.3, 2)
	kit.Blob(body, 50, 26, 36, 18, C.PinkDeep, { Z = 4, Shine = true }) -- toit
	-- ailes (pivot au moyeu)
	local hub = kit.Pivot(body, 50, 26, 6)
	local colors = { C.Pink, C.Butter, C.Mint, C.Sky }
	for index = 0, 3 do
		local arm = kit.Pivot(hub, 0, 0, 1)
		arm.Rotation = index * 90 + 20
		kit.Box(arm, -1.2, -34, 2.4, 34, C.WoodDark, 0, 1)
		local sail = kit.Part(arm, 1, -34, 12, 26, colors[index + 1], { Radius = 3, Z = 2, Thickness = 1.2, Shine = true })
		for k = 1, 3 do
			kit.Box(sail, 0, k * 6.5, 12, 0.8, WHITE, 0.4, 2)
		end
	end
	kit.Circle(hub, 0, 0, 8, 8, C.Butter, 0, 5)
	kit.Animate(hub, "Spin", 1, 0.35, 0)
	return nil
end

-- Vraie presse hydraulique : colonnes, traverse jaune, vérin qui descend,
-- canard en caoutchouc écrasé, bouton rouge
Art.SetupPress = function(body, kit, _item)
	local C = kit.C
	local yellow = rgb(255, 204, 40)
	-- socle à rayures de danger
	local base = kit.Part(body, 2, 88, 96, 12, DARK, { Radius = 3, Z = 1, Thickness = 1.3 })
	local stripes = kit.Group(base, 3, 3, 90, 5, 2, true)
	for k = 0, 9 do
		local stripe = kit.Box(stripes, k * 10 - 2, -3, 5, 12, yellow, 0, 1)
		stripe.Rotation = 35
	end
	-- colonnes
	for _, x in ipairs({ 8, 80 }) do
		kit.Part(body, x, 14, 12, 76, STEEL, { Radius = 2, Z = 2, Shine = true, Thickness = 1.3 })
	end
	-- traverse jaune + vérin
	local beam = kit.Part(body, 2, 6, 96, 16, yellow, { Radius = 4, Z = 4, Shine = true, Thickness = 1.5 })
	kit.Text(beam, "PRESS", 48, 8, 9, DARK, 3)
	kit.Part(body, 38, 21, 24, 18, STEEL_DARK, { Radius = 3, Z = 3, Thickness = 1.3 })
	-- piston (monte et descend)
	local ram = kit.Group(body, 0, 0, 100, 100, 5)
	kit.Part(ram, 45, 38, 10, 20, rgb(220, 226, 240), { Radius = 2, Z = 1, Shine = true, Thickness = 1 })
	local plate = kit.Part(ram, 20, 56, 60, 8, rgb(90, 96, 120), { Radius = 2, Z = 2, Thickness = 1.3 })
	kit.Box(plate, 2, 5.5, 56, 1.2, RED, 0.2, 2)
	kit.Animate(ram, "Bob", 3, 1.1, 0)
	-- canard écrasé sur le socle
	local duck = kit.Blob(body, 50, 82, 40, 12, C.Yellow, { Z = 3, Shine = true })
	kit.Face(duck, 20, 6, 12, { Eyes = "happy", Mouth = "o", Z = 3 })
	kit.Blob(body, 72, 82, 10, 5, C.Orange, { Z = 3 })
	for index, pos in ipairs({ { 24, 74 }, { 76, 72 } }) do
		local s = kit.Sparkle(body, pos[1], pos[2], 7, C.Butter, 0, 4)
		kit.Animate(s, "Breathe", 0.3, 2, index)
	end
	-- boîtier du bouton + manomètre
	local boxFrame = kit.Part(body, 84, 44, 15, 22, DARK, { Radius = 3, Z = 6, Thickness = 1.2 })
	local button = kit.Circle(boxFrame, 7.5, 7, 9, 9, RED, 0, 2)
	kit.Stroke(button, rgb(140, 20, 30), 1.2, 0)
	kit.Animate(button, "Pulse", 0.3, 1.6, 0)
	kit.Text(boxFrame, "PUSH", 7.5, 16, 4.5, WHITE, 3)
	local gauge = kit.Circle(body, 14, 34, 12, 12, WHITE, 0, 5)
	kit.Stroke(gauge, DARK, 1.4, 0)
	local needle = kit.Pivot(gauge, 6, 6, 2)
	kit.Box(needle, -0.6, -5, 1.2, 5, RED, 0, 1)
	kit.Animate(needle, "Sway", 35, 1.1, 0)
	return nil
end

-- Table à papier bulle (dessus à y = 52) : rouleau posé dessus, feuille
-- qui pend devant (bulles pleines et éclatées)
Art.SetupBubbleWrap = function(body, kit, _item)
	local C = kit.C
	for _, x in ipairs({ 10, 86 }) do
		kit.Part(body, x, 56, 5, 44, C.WoodDark, { Radius = 2, Z = 1, Thickness = 1.2 })
	end
	kit.Part(body, 4, 51.5, 92, 6, C.Wood, { Radius = 3, Z = 3, Shine = true, Thickness = 1.3 })
	-- rouleau sur la table
	local roll = kit.Part(body, 54, 28, 38, 24, rgb(214, 240, 255), { Radius = 11, Z = 4, Shine = true, Thickness = 1.3 })
	for k = 0, 4 do
		kit.Box(roll, 4 + k * 7, 2, 1, 20, WHITE, 0.4, 2)
	end
	kit.Blob(body, 56, 40, 10, 22, rgb(190, 225, 250), { Z = 5, Thickness = 1.2 })
	kit.Circle(body, 56, 40, 4, 4, C.WoodLight, 0, 6)
	-- feuille qui pend devant la table
	local sheet = kit.Part(body, 14, 56, 64, 30, rgb(220, 244, 255), { Radius = 4, Z = 6, T = 0.1, Thickness = 1.2, Shade = 0.08 })
	for row = 0, 2 do
		for col = 0, 6 do
			local cx, cy = 5 + col * 9 + (row % 2) * 4, 5 + row * 9.5
			local popped = (row * 7 + col) % 5 == 2
			if popped then
				local flat = kit.Circle(sheet, cx, cy, 6, 3, rgb(180, 200, 220), 0.3, 2)
				local _ = flat
			else
				local bubble = kit.Circle(sheet, cx, cy, 7, 7, rgb(186, 228, 255), 0.15, 2)
				kit.Stroke(bubble, rgb(140, 196, 236), 0.8, 0)
				kit.Circle(bubble, 2.3, 2.3, 2.2, 2.2, WHITE, 0.1, 2)
				if (row + col) % 4 == 0 then
					kit.Animate(bubble, "Breathe", 0.06, 2, row + col)
				end
			end
		end
	end
	local pop = kit.Text(body, "POP!", 22, 44, 9, C.PinkDeep, 7)
	pop.TextStrokeColor3 = WHITE
	pop.TextStrokeTransparency = 0
	kit.Animate(pop, "Bob", 2, 1.6, 0)
	kit.Sparkle(body, 36, 42, 8, C.Butter, 0, 7)
	return nil
end

-- Coin streaming : anneau lumineux, écran du live sur petit bureau, micro,
-- caméra sur trépied, enseigne ON AIR
Art.SetupLiveStudio = function(body, kit, _item)
	local C = kit.C
	-- enseigne "ON AIR"
	local sign = kit.Part(body, 36, 0, 30, 10, DARKER, { Radius = 3, Z = 2, Thickness = 1 })
	local onAir = kit.Text(sign, "ON AIR", 15, 5, 6.5, rgb(255, 120, 130), 3)
	onAir.TextStrokeColor3 = RED
	onAir.TextStrokeTransparency = 0.2
	kit.Animate(sign, "Pulse", 0.25, 1.4, 0)
	-- anneau lumineux sur trépied (à gauche)
	for _, dx in ipairs({ -9, 0, 9 }) do
		kit.Line(body, 17, 60, 17 + dx, 99, 2, DARK, 0, 1)
	end
	kit.Line(body, 17, 42, 17, 60, 2.2, STEEL_DARK, 0, 1)
	local glow = kit.Circle(body, 17, 28, 36, 36, rgb(255, 250, 220), 0.6, 2)
	kit.Animate(glow, "Pulse", 0.2, 1, 0)
	local ring = kit.Circle(body, 17, 28, 28, 28, WHITE, 1, 3)
	kit.Stroke(ring, rgb(255, 222, 140), 4.5, 0)
	local rim = kit.Circle(body, 17, 28, 33, 33, WHITE, 1, 3)
	kit.Stroke(rim, STEEL_DARK, 1.2, 0)
	local inner = kit.Circle(body, 17, 28, 23, 23, WHITE, 1, 3)
	kit.Stroke(inner, STEEL_DARK, 1, 0.3)
	kit.Circle(body, 17, 28, 6, 6, DARK, 0, 3) -- téléphone au centre
	-- petit bureau + écran du live
	for _, x in ipairs({ 33, 70 }) do
		kit.Part(body, x, 66, 4, 33, DARKER, { Radius = 1, Z = 2, Thickness = 1 })
	end
	kit.Part(body, 30, 62, 44, 5.5, DESK_TOP, { Radius = 2, Z = 3, Shine = true, Thickness = 1.2 })
	monitorStand(kit, body, 52, 52, 62, 3)
	monitorFrame(kit, body, 32, 18, 40, 35, "Live", 4, { Chin = 2.5 })
	-- micro sur bras
	kit.Line(body, 34, 62, 38, 50, 1.6, STEEL_DARK, 0, 5)
	kit.Line(body, 38, 50, 44, 56, 1.6, STEEL_DARK, 0, 5)
	kit.Part(body, 42, 52, 6, 9, rgb(80, 80, 100), { Radius = 3, Z = 6, Thickness = 1 })
	-- caméra sur trépied (à droite)
	for _, dx in ipairs({ -8, 0, 8 }) do
		kit.Line(body, 88, 52, 88 + dx, 99, 2, DARK, 0, 1)
	end
	local cam = kit.Part(body, 78, 34, 18, 14, DARK, { Radius = 3, Z = 4, Shine = true, Thickness = 1.2 })
	local lens = kit.Circle(body, 78, 41, 11, 11, DARKER, 0, 5)
	kit.Stroke(lens, STEEL, 1.4, 0)
	kit.Circle(lens, 5.5, 5.5, 5, 5, rgb(90, 140, 255), 0, 2)
	local rec = kit.Circle(cam, 14.5, 3.5, 3.4, 3.4, RED, 0, 2)
	kit.Animate(rec, "Pulse", 0.7, 2, 0)
	kit.Heart(body, 96, 24, 8, C.Heart, 0, 6)
	return { Glow = rgb(255, 240, 200) }
end

----------------------------------------------------------------------
-- 🌼 Plantes du Jardin de Dopamine (pot lumineux + étoiles de rareté)
----------------------------------------------------------------------

-- Pot "Dopamine" : céramique pastel, bord doré, bandeau à étoiles ;
-- (cx, bottom) = milieu du bas ; renvoie le pot
local function dopaminePot(kit, body, cx, bottom, w, h, color, stars: number)
	local C = kit.C
	kit.Blob(body, cx, bottom - 1.5, w * 0.8, 4, rgb(0, 0, 0), { Z = 1, Outline = false, Shade = false, T = 0.85 })
	local potBody = kit.Part(body, cx - w / 2 + w * 0.08, bottom - h, w * 0.84, h, color, { Radius = 6, Z = 5, Shine = true, Shade = 0.2 })
	kit.Part(body, cx - w / 2, bottom - h - 2, w, 7, C.Gold, { Radius = 3, Z = 6, Shine = true, Thickness = 1.3 })
	local band = kit.Box(potBody, 2, h * 0.42, w * 0.84 - 4, h * 0.3, WHITE, 0.35, 2)
	kit.Round(band, 3)
	for index = 1, stars do
		local sx = (w * 0.84) / 2 + (index - (stars + 1) / 2) * math.min(9, (w * 0.84 - 6) / stars)
		star(kit, potBody, sx, h * 0.57, 7, C.Gold, 3)
	end
	return potBody
end

-- Halo de lumière derrière une plante rare
local function plantGlow(kit, body, cx, cy, size, color)
	local halo = kit.Circle(body, cx, cy, size, size, color, 0.7, 1)
	kit.Animate(halo, "Pulse", 0.2, 1, cx)
	return halo
end

-- Feuille (ovale tourné)
local function leaf(kit, parent, x, y, angle, w, h, color, z)
	local frame = kit.Blob(parent, x, y, w, h, color, { Z = z, Thickness = 1.1 })
	frame.Rotation = angle
	return frame
end

Art.SetupPlantDaisy = function(body, kit, _item)
	local C = kit.C
	plantGlow(kit, body, 50, 38, 70, C.Butter)
	local stems = kit.Pivot(body, 50, 70, 3)
	local flowers = { { -18, -36, 9 }, { 18, -34, 9 }, { 0, -52, 11 } }
	for _, f in ipairs(flowers) do
		kit.Line(stems, 0, 0, f[1], f[2], 2.4, C.Green, 0, 1)
	end
	leaf(kit, stems, -8, -10, -30, 18, 8, C.Leaf, 2)
	leaf(kit, stems, 8, -14, 30, 18, 8, C.Leaf, 2)
	for index, f in ipairs(flowers) do
		local x, y, r = f[1], f[2], f[3]
		for k = 0, 3 do
			local a = math.rad(k * 45)
			local dx, dy = math.cos(a) * r * 0.62, math.sin(a) * r * 0.62
			local petal = kit.Line(stems, x - dx, y - dy, x + dx, y + dy, r * 0.62, WHITE, 0, 3)
			kit.Stroke(petal, rgb(220, 205, 230), 1.1)
		end
		kit.Blob(stems, x, y, r * 0.95, r * 0.95, C.Yellow, { Z = 4, Shade = false, Thickness = 1.2 })
		if index == 3 then
			kit.Face(stems, x, y + 0.5, r * 0.95, { Mouth = "none", Blush = false, Z = 5 })
		end
	end
	kit.Animate(stems, "Sway", 2.5, 0.8, 1)
	dopaminePot(kit, body, 50, 100, 46, 30, C.Sky, 1)
	kit.Sparkle(body, 80, 20, 8, C.Butter, 0, 6)
	return { Glow = C.Butter }
end

Art.SetupPlantTulip = function(body, kit, _item)
	local C = kit.C
	plantGlow(kit, body, 50, 38, 72, C.PinkSoft)
	local stems = kit.Pivot(body, 50, 70, 3)
	local tulips = { { -16, -38, C.Pink }, { 16, -40, PURPLE }, { 0, -54, C.PinkDeep } }
	for _, t in ipairs(tulips) do
		kit.Line(stems, 0, 0, t[1], t[2], 2.4, C.Green, 0, 1)
	end
	leaf(kit, stems, -9, -12, -25, 22, 8, C.Leaf, 2)
	leaf(kit, stems, 9, -16, 25, 22, 8, C.LeafDark, 2)
	for _, t in ipairs(tulips) do
		local x, y, color = t[1], t[2], t[3]
		kit.Blob(stems, x, y, 13, 14, color, { Z = 3, Shine = true })
		for _, dx in ipairs({ -4, 0, 4 }) do
			local tip = kit.Blob(stems, x + dx, y - 6, 5, 8, color, { Z = 3, Outline = false, Shade = false })
			local _ = tip
		end
	end
	kit.Animate(stems, "Sway", 2.5, 0.8, 2)
	dopaminePot(kit, body, 50, 100, 46, 30, C.LilacSoft, 2)
	kit.Sparkle(body, 20, 22, 8, C.Butter, 0, 6)
	return { Glow = C.Pink }
end

Art.SetupPlantRose = function(body, kit, _item)
	local C = kit.C
	plantGlow(kit, body, 50, 36, 74, rgb(255, 170, 190))
	local stems = kit.Pivot(body, 50, 68, 3)
	local roses = { { -15, -34 }, { 15, -38 }, { 0, -52 } }
	for _, r in ipairs(roses) do
		kit.Line(stems, 0, 0, r[1], r[2], 2.4, C.LeafDark, 0, 1)
	end
	leaf(kit, stems, -10, -12, -35, 16, 8, C.Leaf, 2)
	leaf(kit, stems, 10, -20, 35, 16, 8, C.Leaf, 2)
	for index, r in ipairs(roses) do
		local size = index == 3 and 16 or 13
		kit.Blob(stems, r[1], r[2], size, size, RED, { Z = 3, Shine = true })
		kit.Blob(stems, r[1] + 1, r[2] - 1, size * 0.62, size * 0.62, rgb(255, 110, 120), { Z = 4, Thickness = 1 })
		kit.Blob(stems, r[1] + 1.5, r[2] - 1.5, size * 0.28, size * 0.28, rgb(200, 40, 60), { Z = 5, Outline = false, Shade = false })
	end
	kit.Animate(stems, "Sway", 2, 0.7, 3)
	dopaminePot(kit, body, 50, 100, 48, 32, C.PinkMist, 3)
	for index, pos in ipairs({ { 18, 18 }, { 84, 26 } }) do
		local s = kit.Sparkle(body, pos[1], pos[2], 8, C.Butter, 0, 6)
		kit.Animate(s, "Breathe", 0.25, 1.4, index)
	end
	return { Glow = rgb(255, 120, 150) }
end

Art.SetupPlantSunflower = function(body, kit, _item)
	local C = kit.C
	plantGlow(kit, body, 50, 26, 70, C.Butter)
	local plant = kit.Pivot(body, 50, 72, 3)
	kit.Line(plant, 0, 0, 0, -48, 3.4, C.Green, 0, 1)
	leaf(kit, plant, -10, -18, -30, 22, 10, C.Leaf, 2)
	leaf(kit, plant, 10, -28, 30, 22, 10, C.LeafDark, 2)
	-- fleur : couronne de pétales + cœur brun avec visage
	local head = kit.Pivot(plant, 0, -50, 3)
	for k = 0, 11 do
		local a = math.rad(k * 30)
		local px, py = math.cos(a) * 13, math.sin(a) * 13
		local petal = kit.Blob(head, px, py, 12, 7, C.Yellow, { Z = 1, Thickness = 1 })
		petal.Rotation = k * 30
	end
	local core = kit.Blob(head, 0, 0, 20, 20, rgb(140, 90, 50), { Z = 2, Shine = true })
	kit.Face(core, 10, 10, 14, { Eyes = "happy", Z = 3, Color = rgb(255, 230, 170) })
	kit.Animate(head, "Sway", 6, 0.6, 0)
	kit.Animate(plant, "Sway", 1.5, 0.5, 1)
	dopaminePot(kit, body, 50, 100, 52, 30, rgb(255, 214, 170), 4)
	kit.Sparkle(body, 84, 12, 9, C.Butter, 0, 6)
	return { Glow = C.Yellow }
end

Art.SetupPlantLotus = function(body, kit, _item)
	local C = kit.C
	plantGlow(kit, body, 50, 50, 84, C.Gold)
	-- bol doré plein d'eau
	kit.Blob(body, 50, 97, 76, 6, rgb(0, 0, 0), { Z = 1, Outline = false, Shade = false, T = 0.85 })
	local bowl = kit.Part(body, 14, 70, 72, 28, C.Gold, { Radius = 14, Z = 3, Shine = true, Shade = 0.25 })
	local _ = bowl
	local water = kit.Blob(body, 50, 71, 72, 12, rgb(120, 200, 240), { Z = 4, Thickness = 1.2 })
	kit.Blob(water, 20, 4, 18, 3, WHITE, { Z = 2, Outline = false, Shade = false, T = 0.4 })
	-- nénuphars
	kit.Blob(body, 26, 71, 16, 6, C.Leaf, { Z = 5, Thickness = 1 })
	kit.Blob(body, 76, 72, 14, 5, C.LeafDark, { Z = 5, Thickness = 1 })
	-- lotus d'or : pétales en éventail
	local flower = kit.Pivot(body, 50, 68, 6)
	for index, angle in ipairs({ -70, -40, -14, 14, 40, 70 }) do
		-- un pivot par pétale : il tourne autour de la base de la fleur
		local arm = kit.Pivot(flower, 0, 0, 1)
		arm.Rotation = angle
		kit.Part(arm, -5, -26, 10, 26, if index % 2 == 0 then rgb(255, 214, 110) else rgb(255, 236, 170), { Radius = -1, Z = 1, Thickness = 1.1, Shine = true })
	end
	local center = kit.Part(flower, -6, -24, 12, 22, rgb(255, 246, 200), { Radius = -1, Z = 3, Thickness = 1.1, Shine = true })
	local _c = center
	kit.Face(flower, 0, -12, 10, { Eyes = "closed", Mouth = "smile", Z = 4 })
	kit.Animate(flower, "Breathe", 0.04, 1.2, 0)
	for index, pos in ipairs({ { 22, 40 }, { 80, 34 }, { 50, 10 } }) do
		local s = kit.Sparkle(body, pos[1], pos[2], 9, index == 3 and WHITE or C.Butter, 0, 7)
		kit.Animate(s, "Breathe", 0.3, 1.4, index)
	end
	return { Glow = C.Gold }
end

return Art
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="33">
              <Properties>
                <string name="Name">Tables</string>
                <string name="Source"><![CDATA[--[[
	Tables (ModuleScript) — dessins des tables, sièges et meubles "à poser dessus" 🍽️🪑
	Emplacement : ReplicatedStorage > Client > Components > House > Art > Tables
	Contrat : voir HouseArt (boîte 100 x 100, pieds en bas pour les objets au sol).

	Les tables sont VIDES (le joueur y pose ce qu'il veut) : le dessus de
	chaque meuble est déclaré dans House/HouseSurfaces (mêmes coordonnées).
	Chaises "de profil" (DiningChair, RockingChair) : elles regardent à
	DROITE ; l'éditeur les retourne (miroir) pour les tourner vers une table.
]]

local Art = {}

----------------------------------------------------------------------
-- Petits outils partagés
----------------------------------------------------------------------

-- Pied tourné (fuseau arrondi) de (x, top) à (x, bottom)
local function turnedLeg(kit, parent, x, top, bottom, width, color, z)
	local leg = kit.Part(parent, x - width / 2, top, width, bottom - top, color, { Radius = math.floor(width / 2), Z = z or 1 })
	kit.Blob(parent, x, top + (bottom - top) * 0.35, width * 1.6, width * 1.3, kit.Lighten(color, 0.1), { Z = (z or 1) + 1, Thickness = 1.2 })
	return leg
end

-- Petit pied rond (patin)
local function foot(kit, parent, cx, y, w, color, z)
	return kit.Blob(parent, cx, y, w, w * 0.55, color, { Z = z or 1, Thickness = 1.2 })
end

-- Nappe festonnée devant un plateau : bande + petits arcs ; (x, y) = haut gauche
local function lace(kit, parent, x, y, w, h, color, z)
	local band = kit.Part(parent, x, y, w, h, color, { Radius = 3, Z = z, Shade = 0.08 })
	local count = math.max(3, math.floor(w / 9))
	local step = w / count
	for index = 0, count - 1 do
		kit.Circle(parent, x + step * (index + 0.5), y + h, step * 0.9, step * 0.7, color, 0, z)
	end
	return band
end

-- Tiroir avec poignée ronde
local function drawer(kit, parent, x, y, w, h, color, knob, z)
	local frame = kit.Part(parent, x, y, w, h, color, { Radius = 3, Z = z or 2, Thickness = 1.3 })
	kit.Blob(frame, w / 2, h / 2, math.min(8, w * 0.22), math.min(4.5, h * 0.36), knob, { Z = 2, Thickness = 1 })
	return frame
end

----------------------------------------------------------------------
-- Tables (dessus vides)
----------------------------------------------------------------------

-- Petite table d'appoint ronde : plateau crème bordé de rose, pied tulipe
Art.SideTable = function(body, kit, _item)
	local C = kit.C
	-- pied tulipe : 3 petites pattes + tige
	kit.Line(body, 50, 86, 30, 97, 5, C.WoodDark, 0, 1)
	kit.Line(body, 50, 86, 70, 97, 5, C.WoodDark, 0, 1)
	kit.Blob(body, 50, 94, 20, 9, C.Wood, { Z = 1, Thickness = 1.2 })
	local stem = kit.Part(body, 45, 44, 10, 50, C.Wood, { Radius = 5, Z = 2 })
	kit.Box(stem, 2.5, 4, 2, 42, C.White, 0.6, 2)
	kit.Blob(body, 50, 64, 18, 8, C.WoodLight, { Z = 3, Thickness = 1.2 })
	-- plateau (vu un peu de dessus) + chant
	kit.Part(body, 4, 38, 92, 11, kit.Darken(C.PinkSoft, 0.05), { Radius = -1, Z = 3 })
	local top = kit.Blob(body, 50, 38, 92, 16, C.Cream, { Z = 4, Shine = true })
	kit.Blob(top, 46, 8, 70, 8, C.White, { Z = 2, Outline = false, Shade = false, T = 0.5 })
	kit.Heart(body, 50, 44, 8, C.Pink, 0, 5)
	return nil
end

-- Table ronde de café : plateau marbre rose bordé d'or, pied en fer forgé
Art.CafeTable = function(body, kit, _item)
	local C = kit.C
	local metal = Color3.fromRGB(96, 84, 120)
	-- pied central + 3 pattes recourbées
	kit.Part(body, 46, 36, 8, 52, metal, { Radius = 4, Z = 1, Thickness = 1.2 })
	kit.Line(body, 50, 86, 22, 97, 5, metal, 0, 1)
	kit.Line(body, 50, 86, 78, 97, 5, metal, 0, 1)
	kit.Circle(body, 21, 96.5, 7, 5, metal, 0, 1)
	kit.Circle(body, 79, 96.5, 7, 5, metal, 0, 1)
	kit.Blob(body, 50, 60, 14, 7, C.Gold, { Z = 2, Thickness = 1 })
	-- volutes
	for _, side in ipairs({ -1, 1 }) do
		local curl = kit.Circle(body, 50 + side * 10, 46, 12, 12, metal, 1, 2)
		kit.Stroke(curl, metal, 2.2)
	end
	-- plateau
	kit.Part(body, 2, 30, 96, 10, C.Gold, { Radius = -1, Z = 3 })
	local top = kit.Blob(body, 50, 30, 96, 17, Color3.fromRGB(255, 228, 238), { Z = 4, Shine = true })
	kit.Line(top, 20, 6, 44, 11, 1.4, C.Pink, 0.55, 2) -- veines du marbre
	kit.Line(top, 58, 5, 80, 9, 1.2, C.Pink, 0.6, 2)
	return nil
end

-- Table basse : plateau bois clair, tablette basse, pieds boule
Art.CoffeeTable = function(body, kit, _item)
	local C = kit.C
	for _, x in ipairs({ 12, 88 }) do
		kit.Part(body, x - 4, 58, 8, 36, C.WoodDark, { Radius = 3, Z = 1 })
		kit.Blob(body, x, 95, 12, 9, C.Wood, { Z = 2 })
	end
	-- tablette du bas (avec un joli motif)
	local shelf = kit.Part(body, 8, 76, 84, 8, C.Wood, { Radius = 3, Z = 2 })
	kit.Box(shelf, 3, 2, 78, 1.6, C.White, 0.6, 2)
	-- ceinture + plateau
	local apron = kit.Part(body, 6, 58, 88, 10, C.Wood, { Radius = 3, Z = 3 })
	for _, x in ipairs({ 22, 44, 66 }) do
		kit.Heart(apron, x, 5, 6, C.PinkSoft, 0, 2)
	end
	kit.Part(body, 1, 50, 98, 10, C.WoodLight, { Radius = 5, Z = 4, Shine = true })
	kit.Box(body, 6, 51.5, 60, 2, C.White, 0.5, 5)
	return nil
end

-- Grande table à manger : plateau bois, nappe festonnée, 4 pieds tournés
Art.DiningTable = function(body, kit, _item)
	local C = kit.C
	-- pieds du fond (plus sombres)
	for _, x in ipairs({ 16, 84 }) do
		kit.Part(body, x - 3, 42, 6, 50, kit.Darken(C.Wood, 0.2), { Radius = 3, Z = 1 })
	end
	-- pieds de devant
	for _, x in ipairs({ 8, 92 }) do
		turnedLeg(kit, body, x, 44, 97, 7, C.Wood, 3)
	end
	-- plateau
	kit.Part(body, 0, 34, 100, 10, C.WoodLight, { Radius = 4, Z = 5, Shine = true })
	kit.Box(body, 4, 35.5, 70, 2, C.White, 0.5, 6)
	-- nappe blanche festonnée (seulement devant, le dessus reste libre)
	lace(kit, body, 14, 42, 72, 9, C.White, 6)
	for _, x in ipairs({ 28, 50, 72 }) do
		kit.Heart(body, x, 47, 6, C.Pink, 0, 7)
	end
	return nil
end

-- Haute table de bar : petit plateau rond, long pied, repose-pieds
Art.BarTable = function(body, kit, _item)
	local C = kit.C
	local mint = Color3.fromRGB(150, 222, 200)
	foot(kit, body, 50, 96, 44, C.GreyDark, 1)
	local stem = kit.Part(body, 45, 24, 10, 72, C.Grey, { Radius = 5, Z = 2 })
	kit.Box(stem, 2.5, 4, 2, 64, C.White, 0.5, 2)
	local ring = kit.Circle(body, 50, 70, 30, 9, C.White, 1, 3)
	kit.Stroke(ring, C.Gold, 2.4)
	kit.Part(body, 10, 16, 80, 9, kit.Darken(mint, 0.12), { Radius = -1, Z = 4 })
	local top = kit.Blob(body, 50, 16, 80, 14, mint, { Z = 5, Shine = true })
	kit.Blob(top, 40, 7, 50, 6, C.White, { Z = 2, Outline = false, Shade = false, T = 0.55 })
	return nil
end

-- Commode pastel : 2 x 3 tiroirs arc-en-ciel, dessus libre
Art.Dresser = function(body, kit, _item)
	local C = kit.C
	local lilac = Color3.fromRGB(226, 208, 250)
	for _, x in ipairs({ 12, 82 }) do
		kit.Part(body, x, 90, 6, 10, C.WoodDark, { Radius = 2, Z = 1 })
	end
	local cabinet = kit.Part(body, 6, 42, 88, 50, lilac, { Radius = 6, Z = 2 })
	local colors = { C.PinkSoft, C.MintSoft, kit.Lighten(C.Butter, 0.4) }
	for row = 0, 2 do
		for col = 0, 1 do
			drawer(kit, cabinet, 5 + col * 40, 5 + row * 14.5, 38, 12, colors[row + 1], C.Lilac, 2)
		end
	end
	kit.Part(body, 2, 36, 96, 8, kit.Lighten(lilac, 0.5), { Radius = 4, Z = 3, Shine = true })
	return nil
end

-- Meuble télé : console basse, niches (manette, disques), dessus libre
Art.TVStand = function(body, kit, _item)
	local C = kit.C
	local wood = Color3.fromRGB(242, 212, 176)
	for _, x in ipairs({ 10, 86 }) do
		kit.Part(body, x - 3, 88, 6, 12, C.WoodDark, { Radius = 2, Z = 1, Rotation = x < 50 and 8 or -8 })
	end
	local cabinet = kit.Part(body, 3, 58, 94, 32, wood, { Radius = 6, Z = 2 })
	-- niche gauche : console de jeu ; niche droite : porte ronde
	local nook = kit.Part(cabinet, 5, 6, 40, 20, kit.Darken(wood, 0.35), { Radius = 4, Z = 2, Shade = false })
	local console = kit.Part(nook, 6, 9, 28, 8, C.White, { Radius = 3, Z = 2, Thickness = 1.2 })
	kit.Circle(console, 22, 4, 3, 3, C.Mint, 0, 2)
	kit.Box(console, 4, 3, 10, 2, C.GreyDark, 0.2, 2)
	for index, color in ipairs({ C.Pink, C.Sky, C.Butter }) do
		kit.Part(nook, 3 + index * 4.5, 1.5, 3.5, 7, color, { Radius = 1, Z = 2, Thickness = 1 })
	end
	local door = kit.Part(cabinet, 50, 6, 39, 20, kit.Lighten(wood, 0.3), { Radius = 4, Z = 2 })
	kit.Circle(door, 19.5, 10, 12, 12, C.PinkSoft, 0, 2)
	kit.Blob(door, 32, 10, 4, 4, C.Gold, { Z = 3, Thickness = 1 })
	kit.Part(body, 0, 52, 100, 8, kit.Lighten(wood, 0.35), { Radius = 4, Z = 3, Shine = true })
	return nil
end

-- Îlot de cuisine : placards menthe, plan de travail marbre qui dépasse
Art.KitchenIsland = function(body, kit, _item)
	local C = kit.C
	local mint = Color3.fromRGB(176, 230, 210)
	kit.Part(body, 8, 94, 84, 6, kit.Darken(mint, 0.3), { Radius = 2, Z = 1, Shade = false }) -- socle
	local cabinet = kit.Part(body, 8, 44, 84, 52, mint, { Radius = 5, Z = 2 })
	-- tiroirs en haut, portes en bas
	for index = 0, 2 do
		drawer(kit, cabinet, 4 + index * 26.5, 4, 23, 10, kit.Lighten(mint, 0.45), C.Gold, 2)
		local door = kit.Part(cabinet, 4 + index * 26.5, 17, 23, 30, kit.Lighten(mint, 0.3), { Radius = 3, Z = 2, Thickness = 1.3 })
		kit.Part(door, 3, 3, 17, 24, kit.Lighten(mint, 0.5), { Radius = 2, Z = 2, Thickness = 1, Shade = false })
		kit.Blob(door, index == 1 and 5 or 18, 15, 3, 6, C.Gold, { Z = 3, Thickness = 1 })
	end
	-- plan de travail
	local top = kit.Part(body, 0, 36, 100, 10, Color3.fromRGB(252, 248, 255), { Radius = 4, Z = 3, Shine = true })
	kit.Line(top, 12, 6, 36, 4, 1.2, C.Lilac, 0.55, 2)
	kit.Line(top, 60, 5, 88, 7, 1.2, C.Lilac, 0.6, 2)
	return nil
end

-- Table de pique-nique : plateau à lattes, bancs attachés, nappe vichy
Art.PicnicTable = function(body, kit, _item)
	local C = kit.C
	local wood = Color3.fromRGB(226, 176, 128)
	-- pieds en X
	for _, x in ipairs({ 20, 80 }) do
		kit.Line(body, x - 12, 98, x + 8, 44, 6, kit.Darken(wood, 0.2), 0, 1)
		kit.Line(body, x + 12, 98, x - 8, 44, 6, kit.Darken(wood, 0.12), 0, 2)
	end
	-- plateau (lattes) + nappe vichy sur le devant
	local top = kit.Part(body, 2, 38, 96, 10, wood, { Radius = 3, Z = 3, Shine = true })
	for _, x in ipairs({ 24, 48, 72 }) do
		kit.Box(top, x, 1, 1.5, 8, kit.Darken(wood, 0.3), 0.3, 2)
	end
	local cloth = kit.Part(body, 26, 42, 48, 12, C.White, { Radius = 2, Z = 4, Shade = 0.06 })
	for index = 0, 5 do
		kit.Box(cloth, 2 + index * 8, 0, 4, 12, C.Red, 0.55, 2)
	end
	for index = 0, 2 do
		kit.Box(cloth, 0, 1 + index * 4, 48, 2, C.Red, 0.6, 2)
	end
	-- banc de devant
	local bench = kit.Part(body, 0, 70, 100, 9, kit.Lighten(wood, 0.12), { Radius = 3, Z = 5, Shine = true })
	kit.Box(bench, 49, 1, 1.5, 7, kit.Darken(wood, 0.3), 0.3, 2)
	for _, x in ipairs({ 10, 90 }) do
		kit.Part(body, x - 3, 78, 6, 20, kit.Darken(wood, 0.08), { Radius = 2, Z = 4 })
	end
	return nil
end

-- Grand bureau en bois : 2 caissons à tiroirs, sous-main vert, dessus libre
Art.BigDesk = function(body, kit, _item)
	local C = kit.C
	local wood = Color3.fromRGB(196, 140, 100)
	local light = kit.Lighten(wood, 0.25)
	kit.Part(body, 30, 46, 40, 34, kit.Darken(wood, 0.3), { Radius = 3, Z = 1, Shade = false }) -- fond
	for _, x in ipairs({ 4, 68 }) do
		local pedestal = kit.Part(body, x, 44, 28, 52, wood, { Radius = 4, Z = 2 })
		for row = 0, 2 do
			drawer(kit, pedestal, 3, 3 + row * 16, 22, 13, light, C.Gold, 2)
		end
		kit.Part(body, x + 1, 95, 26, 5, kit.Darken(wood, 0.25), { Radius = 2, Z = 1 })
	end
	local middle = kit.Part(body, 32, 44, 36, 10, light, { Radius = 3, Z = 2 })
	kit.Blob(middle, 18, 5, 8, 4, C.Gold, { Z = 2, Thickness = 1 })
	-- plateau + sous-main
	kit.Part(body, 0, 36, 100, 10, kit.Lighten(wood, 0.35), { Radius = 4, Z = 3, Shine = true })
	kit.Part(body, 30, 37.5, 40, 3, Color3.fromRGB(120, 190, 140), { Radius = 1.5, Z = 4, Outline = false, Shade = false })
	return nil
end

----------------------------------------------------------------------
-- Sièges
----------------------------------------------------------------------

-- Tabouret champignon : chapeau rouge à pois, pied crème
Art.MushroomStool = function(body, kit, _item)
	local C = kit.C
	local stem = kit.Part(body, 32, 36, 36, 62, C.Cream, { Radius = 14, Z = 1, Shade = 0.14 })
	kit.Face(stem, 18, 30, 22, { Eyes = "happy", Mouth = "cat", Z = 3 })
	kit.Blob(body, 50, 97, 44, 8, kit.Darken(C.Cream, 0.1), { Z = 0, Outline = false, Shade = false })
	local cap = kit.Part(body, 6, 12, 88, 34, C.Red, { Radius = -1, Z = 2, Shine = true })
	for _, dot in ipairs({ { 20, 10, 10 }, { 44, 7, 13 }, { 68, 12, 10 }, { 32, 22, 7 }, { 58, 24, 7 } }) do
		kit.Circle(cap, dot[1], dot[2], dot[3], dot[3] * 0.8, C.White, 0, 2)
	end
	kit.Part(body, 12, 34, 76, 8, kit.Darken(C.Red, 0.25), { Radius = -1, Z = 1, Outline = false })
	return nil
end

-- Deux gros coussins de sol empilés (façon dango : rose, crème, menthe)
Art.FloorCushion = function(body, kit, _item)
	local C = kit.C
	local low = kit.Part(body, 4, 70, 92, 28, C.MintSoft, { Radius = 13, Z = 1, Shade = 0.16 })
	kit.Circle(low, 46, 14, 5, 5, kit.Darken(C.Mint, 0.1), 0.2, 2)
	local high = kit.Part(body, 12, 46, 76, 28, C.PinkSoft, { Radius = 13, Z = 2, Shade = 0.16, Shine = true })
	kit.Circle(high, 38, 14, 5, 5, C.Pink, 0.2, 2)
	for _, x in ipairs({ 12, 64 }) do
		kit.Line(high, x, 6, x, 22, 1.5, C.Pink, 0.55, 2) -- coutures
	end
	kit.Face(high, 38, 15, 18, { Eyes = "happy", Mouth = "smile", Z = 3 })
	-- pompons aux coins
	for _, x in ipairs({ 10, 90 }) do
		kit.Blob(body, x, 50, 8, 8, C.Butter, { Z = 3, Thickness = 1.2 })
	end
	return nil
end

-- Chaise de salle à manger DE PROFIL (regarde à droite) : dossier à cœur, galette rose
Art.DiningChair = function(body, kit, _item)
	local C = kit.C
	local wood = C.Wood
	-- pieds (arrière-plan plus sombre)
	kit.Part(body, 30, 60, 6, 38, kit.Darken(wood, 0.2), { Radius = 3, Z = 1, Rotation = -4 })
	kit.Part(body, 72, 60, 6, 38, kit.Darken(wood, 0.2), { Radius = 3, Z = 1, Rotation = 4 })
	kit.Part(body, 24, 60, 7, 40, wood, { Radius = 3, Z = 3, Rotation = -6 })
	kit.Part(body, 76, 60, 7, 40, wood, { Radius = 3, Z = 3, Rotation = 6 })
	kit.Part(body, 28, 84, 50, 4, kit.Darken(wood, 0.1), { Radius = 2, Z = 2 }) -- barreau
	-- dossier (à gauche, un peu penché)
	local back = kit.Part(body, 18, 4, 14, 60, wood, { Radius = 6, Z = 4, Rotation = -6, Shine = true })
	kit.Heart(back, 7, 16, 9, C.Pink, 0, 2)
	-- assise + galette
	kit.Part(body, 20, 58, 64, 9, C.WoodLight, { Radius = 4, Z = 4 })
	local cushion = kit.Part(body, 28, 50, 56, 11, C.PinkSoft, { Radius = -1, Z = 5, Shine = true })
	for _, x in ipairs({ 14, 28, 42 }) do
		kit.Circle(cushion, x, 5.5, 2, 2, C.Pink, 0.2, 2)
	end
	return nil
end

-- Tabouret de bar : assise ronde matelassée, pieds hauts, repose-pieds doré
Art.BarStool = function(body, kit, _item)
	local C = kit.C
	local metal = Color3.fromRGB(150, 146, 172)
	kit.Line(body, 44, 36, 30, 98, 4, kit.Darken(metal, 0.15), 0, 1)
	kit.Line(body, 56, 36, 70, 98, 4, kit.Darken(metal, 0.15), 0, 1)
	kit.Line(body, 40, 36, 20, 98, 5, metal, 0, 2)
	kit.Line(body, 60, 36, 80, 98, 5, metal, 0, 2)
	local ring = kit.Circle(body, 50, 72, 44, 10, C.White, 1, 3)
	kit.Stroke(ring, C.Gold, 3)
	kit.Part(body, 22, 34, 56, 8, kit.Darken(C.Sky, 0.2), { Radius = -1, Z = 3 })
	local seat = kit.Blob(body, 50, 30, 60, 18, C.Sky, { Z = 4, Shine = true })
	kit.Circle(seat, 30, 9, 4, 4, kit.Darken(C.Sky, 0.25), 0.2, 2)
	return nil
end

-- Fauteuil douillet (de face) : dossier arrondi, accoudoirs, plaid
Art.Armchair = function(body, kit, _item)
	local C = kit.C
	local peach = Color3.fromRGB(255, 196, 170)
	for _, x in ipairs({ 16, 78 }) do
		kit.Part(body, x, 88, 6, 12, C.WoodDark, { Radius = 2, Z = 1, Rotation = x < 50 and 10 or -10 })
	end
	local back = kit.Part(body, 14, 16, 72, 52, peach, { Radius = 26, Z = 2 })
	for _, x in ipairs({ 26, 46 }) do
		kit.Circle(back, x, 24, 3.5, 3.5, kit.OutlineOf(peach), 0.3, 2) -- capitonnage
	end
	local seat = kit.Part(body, 12, 60, 76, 30, peach, { Radius = 12, Z = 3, Shade = 0.18 })
	kit.Part(seat, 8, 2, 60, 12, kit.Lighten(peach, 0.35), { Radius = -1, Z = 2, Shine = true }) -- coussin
	for _, x in ipairs({ 2, 76 }) do
		kit.Part(body, x, 44, 22, 46, kit.Darken(peach, 0.05), { Radius = 11, Z = 4, Shine = true })
	end
	-- plaid à carreaux sur l'accoudoir droit
	local throw = kit.Part(body, 70, 40, 20, 34, C.LilacSoft, { Radius = 5, Z = 5, Rotation = 6 })
	kit.Box(throw, 0, 10, 20, 3, C.Lilac, 0.3, 2)
	kit.Box(throw, 0, 22, 20, 3, C.Lilac, 0.3, 2)
	kit.Box(throw, 8, 0, 3, 34, C.Lilac, 0.4, 2)
	return nil
end

-- Banc de jardin : lattes de bois, accoudoirs en fer forgé
Art.GardenBench = function(body, kit, _item)
	local C = kit.C
	local iron = Color3.fromRGB(90, 110, 100)
	local wood = Color3.fromRGB(226, 180, 130)
	-- dossier (3 lattes)
	for index = 0, 2 do
		kit.Part(body, 10, 22 + index * 10, 80, 7, kit.Darken(wood, 0.05 * index), { Radius = 3, Z = 2, Shine = index == 0 })
	end
	-- assise (2 lattes)
	kit.Part(body, 6, 58, 88, 7, wood, { Radius = 3, Z = 3, Shine = true })
	kit.Part(body, 6, 64, 88, 7, kit.Darken(wood, 0.1), { Radius = 3, Z = 3 })
	-- flancs en fer forgé (volutes)
	for _, x in ipairs({ 8, 92 }) do
		kit.Part(body, x - 3, 18, 6, 80, iron, { Radius = 3, Z = 4 })
		local curl = kit.Circle(body, x + (x < 50 and 7 or -7), 50, 14, 14, iron, 1, 4)
		kit.Stroke(curl, iron, 2.6)
		kit.Blob(body, x, 97, 12, 6, iron, { Z = 4, Thickness = 1 })
	end
	-- petite fleur posée sur le dossier
	kit.Circle(body, 70, 20, 8, 8, C.Pink, 0, 5)
	kit.Circle(body, 70, 20, 3.5, 3.5, C.Butter, 0, 6)
	return nil
end

-- Rocking-chair DE PROFIL (regarde à droite) : patins courbes, plaid tricoté
Art.RockingChair = function(body, kit, _item)
	local C = kit.C
	local wood = Color3.fromRGB(200, 146, 104)
	-- patin courbe (arc fait de 3 segments)
	kit.Line(body, 8, 88, 30, 96, 5, kit.Darken(wood, 0.1), 0, 1)
	kit.Line(body, 30, 96, 70, 96, 5, kit.Darken(wood, 0.1), 0, 1)
	kit.Line(body, 70, 96, 94, 86, 5, kit.Darken(wood, 0.1), 0, 1)
	-- pieds
	kit.Line(body, 28, 60, 30, 95, 5, wood, 0, 2)
	kit.Line(body, 72, 60, 70, 95, 5, wood, 0, 2)
	-- dossier (penché vers l'arrière, à gauche) avec barreaux
	local back = kit.Group(body, 10, 2, 30, 64, 3)
	back.Rotation = -12
	kit.Part(back, 2, 0, 8, 62, wood, { Radius = 4, Z = 1 })
	kit.Part(back, 18, 4, 8, 58, wood, { Radius = 4, Z = 1 })
	for _, y in ipairs({ 12, 26, 40 }) do
		kit.Part(back, 4, y, 20, 5, kit.Lighten(wood, 0.2), { Radius = 2, Z = 2 })
	end
	-- assise
	kit.Part(body, 22, 56, 60, 8, kit.Lighten(wood, 0.15), { Radius = 4, Z = 4, Shine = true })
	-- accoudoir
	kit.Line(body, 34, 40, 78, 44, 5, wood, 0, 5)
	kit.Line(body, 74, 44, 74, 58, 4, wood, 0, 5)
	-- plaid tricoté qui pend
	local throw = kit.Part(body, 16, 30, 30, 34, C.PinkSoft, { Radius = 6, Z = 6, Rotation = -8, Shine = true })
	for _, y in ipairs({ 9, 18, 27 }) do
		kit.Box(throw, 2, y, 26, 2, C.Pink, 0.35, 2)
	end
	-- pelote de laine au pied
	local ball = kit.Blob(body, 86, 92, 14, 13, C.Lilac, { Z = 6, Shine = true })
	kit.Line(ball, 3, 4, 11, 9, 1.2, C.White, 0.4, 2)
	kit.Line(body, 80, 94, 70, 99, 1.2, C.Lilac, 0, 5)
	return nil
end

-- Grand lit douillet (de face) : tête de lit cœur, couette, dessus libre pour
-- les coussins et les animaux
Art.DoubleBed = function(body, kit, _item)
	local C = kit.C
	local frameColor = Color3.fromRGB(255, 236, 226)
	-- tête de lit
	local head = kit.Part(body, 6, 10, 88, 60, frameColor, { Radius = 30, Z = 1, Shade = 0.12 })
	kit.Heart(head, 44, 24, 26, C.PinkSoft, 0, 2)
	kit.Heart(head, 44, 24, 14, C.Pink, 0, 3)
	for _, x in ipairs({ 0, 90 }) do
		local post = kit.Part(body, x, 26, 10, 72, kit.Darken(frameColor, 0.05), { Radius = 5, Z = 2 })
		kit.Blob(body, x + 5, 25, 14, 14, C.PinkSoft, { Z = 3, Shine = true })
		kit.Box(post, 3, 4, 2, 60, C.White, 0.5, 2)
	end
	-- matelas + couette
	kit.Part(body, 8, 52, 84, 14, C.White, { Radius = 6, Z = 3 })
	local duvet = kit.Part(body, 6, 58, 88, 32, Color3.fromRGB(196, 222, 255), { Radius = 10, Z = 4, Shine = true })
	for _, x in ipairs({ 18, 42, 66 }) do
		kit.Circle(duvet, x, 17, 8, 8, C.White, 0.35, 2) -- pois
	end
	kit.Part(body, 6, 56, 88, 8, C.White, { Radius = -1, Z = 5 }) -- revers du drap
	kit.Part(body, 10, 88, 80, 8, kit.Darken(frameColor, 0.08), { Radius = 3, Z = 5 }) -- cadre du pied
	return nil
end

-- Fauteuil-œuf suspendu : arceau, chaîne, coque en rotin, coussin
Art.EggChair = function(body, kit, _item)
	local C = kit.C
	local metal = Color3.fromRGB(236, 206, 150)
	-- arceau
	kit.Blob(body, 50, 96, 60, 8, kit.Darken(metal, 0.2), { Z = 1, Thickness = 1.2 })
	kit.Line(body, 26, 94, 32, 30, 5, metal, 0, 1)
	kit.Line(body, 32, 30, 56, 4, 5, metal, 0, 1)
	kit.Line(body, 56, 4, 66, 10, 5, metal, 0, 1)
	-- chaîne
	local chain = kit.Pivot(body, 64, 10, 2)
	for index = 0, 3 do
		local link = kit.Circle(chain, 0, 3 + index * 5, 4, 6, C.White, 1, 1)
		kit.Stroke(link, kit.Darken(metal, 0.3), 1.6)
	end
	-- coque (se balance doucement)
	local swing = kit.Pivot(body, 64, 30, 3)
	local shell = kit.Part(swing, -28, 0, 56, 68, Color3.fromRGB(240, 214, 176), { Radius = 26, Z = 1, Shade = 0.18 })
	for _, y in ipairs({ 14, 28, 42, 56 }) do
		kit.Box(shell, 4, y, 48, 1.6, kit.Darken(metal, 0.3), 0.5, 2) -- tressage
	end
	local inside = kit.Part(swing, -20, 10, 40, 44, Color3.fromRGB(180, 140, 110), { Radius = 20, Z = 2, Shade = false })
	kit.Part(inside, 4, 20, 32, 20, C.PinkSoft, { Radius = 10, Z = 2, Shine = true }) -- coussin
	kit.Heart(inside, 20, 29, 8, C.Pink, 0, 3)
	kit.Animate(swing, "Sway", 2.2, 0.35, 0)
	return nil
end

----------------------------------------------------------------------
-- Étagère murale (on pose des petits objets sur ses 2 planches)
----------------------------------------------------------------------

Art.FloatingShelf = function(body, kit, _item)
	local C = kit.C
	local wood = C.WoodLight
	for _, y in ipairs({ 34, 72 }) do
		-- consoles
		for _, x in ipairs({ 18, 82 }) do
			local bracket = kit.Part(body, x - 3, y + 3, 6, 12, kit.Darken(wood, 0.25), { Radius = 2, Z = 1 })
			kit.Stroke(bracket, kit.Darken(wood, 0.45), 1.2)
		end
		kit.Part(body, 4, y, 92, 7, wood, { Radius = 3, Z = 2, Shine = true })
		kit.Box(body, 8, y + 5, 84, 1.5, kit.Darken(wood, 0.25), 0.2, 3)
	end
	-- petites guirlandes de cœurs entre les planches
	for index = 0, 4 do
		kit.Heart(body, 20 + index * 15, 52 + (index % 2) * 3, 5, index % 2 == 0 and C.Pink or C.Lilac, 0.1, 1)
	end
	return { WallShadow = Vector2.new(0.9, 0.5) }
end

return Art
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="34">
              <Properties>
                <string name="Name">Tabletop</string>
                <string name="Source"><![CDATA[--[[
	Tabletop (ModuleScript) — petits objets à poser partout (tables, étagères, lit...) 🧁
	Emplacement : ReplicatedStorage > Client > Components > House > Art > Tabletop
	Contrat : voir HouseArt (boîte 100 x 100, pieds en bas : posés sur un meuble,
	leurs pieds sont sur le dessus du meuble).
]]

local Art = {}

----------------------------------------------------------------------
-- Petits outils partagés
----------------------------------------------------------------------

-- Assiette vue un peu de dessus (ovale + creux) ; (cx, cy) = centre
local function plate(kit, parent, cx, cy, w, color, z)
	local C = kit.C
	kit.Blob(parent, cx, cy, w, w * 0.3, color or C.White, { Z = z, Thickness = 1.4 })
	kit.Blob(parent, cx, cy - w * 0.02, w * 0.66, w * 0.17, kit.Darken(color or C.White, 0.06), { Z = (z or 1) + 1, Outline = false, Shade = false })
end

-- Petite flamme de bougie qui vacille
local function flame(kit, parent, cx, bottom, w, h, z, phase)
	local C = kit.C
	local holder = kit.Group(parent, cx - w / 2, bottom - h, w, h, z)
	kit.Circle(holder, w / 2, h * 0.62, w, h * 0.72, C.Orange, 0, 1)
	kit.Circle(holder, w / 2, h * 0.7, w * 0.55, h * 0.45, C.Butter, 0, 2)
	kit.Animate(holder, "Flicker", 0.15, 1, phase or 0)
	return holder
end

-- Petit livre couché (tranche vers nous) ; (x, y) = haut gauche
local function book(kit, parent, x, y, w, h, color, z)
	local C = kit.C
	local cover = kit.Part(parent, x, y, w, h, color, { Radius = 2, Z = z, Thickness = 1.3 })
	kit.Box(cover, 3, h * 0.28, w - 8, h * 0.44, C.Cream, 0, 2) -- pages
	kit.Box(cover, w - 6, 1.5, 3, h - 3, kit.Lighten(color, 0.3), 0, 2)
	return cover
end

----------------------------------------------------------------------
-- 🖼️ Déco
----------------------------------------------------------------------

-- Pile de livres pastel + lunettes rondes
Art.BookStack = function(body, kit, _item)
	local C = kit.C
	book(kit, body, 8, 78, 84, 20, C.Lilac, 1)
	book(kit, body, 14, 58, 72, 20, C.Mint, 2)
	book(kit, body, 4, 40, 80, 18, C.Pink, 3)
	book(kit, body, 18, 24, 62, 16, C.Butter, 4)
	-- petites lunettes posées dessus
	for _, x in ipairs({ 38, 58 }) do
		local lens = kit.Circle(body, x, 16, 15, 15, C.Glass, 0.35, 5)
		kit.Stroke(lens, C.Ink, 2)
	end
	kit.Line(body, 45, 16, 51, 16, 2, C.Ink, 0, 5)
	return nil
end

-- Coussin cœur qui sourit, petit nœud sur le dessus
Art.HeartPillow = function(body, kit, _item)
	local C = kit.C
	kit.Heart(body, 50, 56, 96, kit.Darken(C.Pink, 0.18), 0, 1)
	local heart = kit.Heart(body, 50, 54, 88, C.Pink, 0, 2)
	kit.Shine(heart, 18, 20, 18, 7, 3)
	kit.Face(heart, 44, 44, 34, { Eyes = "happy", Mouth = "smile", Z = 4 })
	-- nœud
	for _, side in ipairs({ -1, 1 }) do
		kit.Part(body, 50 + side * 9 - 7, 12, 14, 12, C.White, { Radius = 5, Z = 3, Rotation = side * 18 })
	end
	kit.Blob(body, 50, 18, 8, 8, C.White, { Z = 4 })
	return nil
end

-- Coussin rond "pleine lune" endormie, brodé d'un croissant et d'une étoile
Art.MoonPillow = function(body, kit, _item)
	local C = kit.C
	local pillow = kit.Part(body, 6, 22, 88, 76, C.Butter, { Radius = 34, Z = 1, Shine = true })
	for _, spot in ipairs({ { 8, 8 }, { 80, 8 }, { 8, 68 }, { 80, 68 } }) do
		kit.Circle(pillow, spot[1], spot[2], 9, 9, kit.Darken(C.Butter, 0.08), 0, 1) -- coins bombés
	end
	kit.Face(pillow, 44, 44, 34, { Eyes = "closed", Mouth = "cat", Z = 3 })
	-- croissant brodé (2 cercles) + étoile
	kit.Circle(pillow, 20, 20, 14, 14, C.Lilac, 0, 2)
	kit.Circle(pillow, 24, 17, 12, 12, C.Butter, 0, 3)
	local star = kit.Sparkle(body, 76, 36, 16, C.Pink, 0, 4)
	kit.Animate(star, "Breathe", 0.08, 1.2, 0)
	-- passepoil
	kit.Box(pillow, 12, 72, 64, 2, kit.Darken(C.Butter, 0.2), 0.3, 2)
	return nil
end

-- Cadre photo sur pied : photo d'un chat devant un arc-en-ciel
Art.PhotoFrame = function(body, kit, _item)
	local C = kit.C
	kit.Line(body, 62, 60, 80, 99, 5, C.WoodDark, 0, 1) -- béquille
	local frame = kit.Part(body, 10, 12, 80, 86, C.PinkSoft, { Radius = 10, Z = 2, Shine = true })
	for _, spot in ipairs({ { 8, 8 }, { 72, 8 }, { 8, 78 }, { 72, 78 } }) do
		kit.Heart(frame, spot[1], spot[2], 8, C.Pink, 0, 3)
	end
	local photo = kit.Part(frame, 12, 12, 56, 62, C.Sky, { Radius = 4, Z = 2, Thickness = 1.2, Shade = false })
	kit.Blob(photo, 28, 62, 70, 30, C.Leaf, { Z = 2, Outline = false, Shade = false })
	for index, color in ipairs({ C.Red, C.Butter, C.Mint }) do
		local arc = kit.Circle(photo, 28, 46, 60 - index * 10, 60 - index * 10, C.White, 1, 1)
		kit.Stroke(arc, color, 2.4)
	end
	local cat = kit.Blob(photo, 28, 44, 24, 20, C.White, { Z = 3, Thickness = 1.2 })
	kit.Face(cat, 12, 10, 14, { Eyes = "happy", Mouth = "cat", Z = 2 })
	return nil
end

-- Pile de plaids pliés (carreaux, torsades) + petit ruban
Art.BlanketStack = function(body, kit, _item)
	local C = kit.C
	local colors = { C.MintSoft, C.PinkSoft, C.LilacSoft, kit.Lighten(C.Butter, 0.4) }
	for index, color in ipairs(colors) do
		local y = 100 - index * 22
		local fold = kit.Part(body, 6 + (index % 2) * 4, y, 86, 22, color, { Radius = 9, Z = index, Shine = index == #colors })
		kit.Box(fold, 6, 9, 74, 2, kit.Darken(color, 0.18), 0.3, 2)
		if index == 2 then
			for x = 12, 72, 12 do
				kit.Box(fold, x, 2, 2, 18, kit.Darken(color, 0.15), 0.4, 2)
			end
		end
	end
	kit.Heart(body, 50, 24, 12, C.PinkDeep, 0, 6)
	return nil
end

-- Tirelire cochon rose
Art.PiggyBank = function(body, kit, _item)
	local C = kit.C
	local pink = Color3.fromRGB(255, 178, 204)
	for _, x in ipairs({ 26, 40, 60, 74 }) do
		kit.Part(body, x - 5, 82, 10, 16, kit.Darken(pink, 0.1), { Radius = 4, Z = 1 })
	end
	local pig = kit.Blob(body, 50, 60, 88, 60, pink, { Z = 2, Shine = true })
	kit.Box(pig, 38, 3, 12, 3, kit.Darken(pink, 0.4), 0, 2) -- fente
	for _, x in ipairs({ 30, 60 }) do
		kit.Part(body, x - 7, 26, 14, 14, pink, { Radius = 4, Z = 1, Rotation = 45 }) -- oreilles
	end
	local nose = kit.Blob(body, 16, 62, 20, 16, kit.Darken(pink, 0.08), { Z = 3 })
	kit.Circle(nose, 7, 8, 4, 5, kit.Darken(pink, 0.45), 0, 2)
	kit.Circle(nose, 13, 8, 4, 5, kit.Darken(pink, 0.45), 0, 2)
	kit.Face(body, 36, 52, 26, { Eyes = "dot", Mouth = "none", Z = 4 })
	local coin = kit.Blob(body, 48, 16, 16, 16, C.Gold, { Z = 3, Shine = true })
	kit.Text(coin, "$", 8, 8, 10, kit.Darken(C.Gold, 0.4), 2)
	kit.Animate(coin, "Bob", 2.5, 1, 0)
	return nil
end

-- Boule à neige : petit chalet, sapin, flocons qui tombent
Art.SnowGlobe = function(body, kit, _item)
	local C = kit.C
	local base = kit.Part(body, 16, 78, 68, 20, C.WoodLight, { Radius = 6, Z = 1, Shine = true })
	kit.Heart(base, 34, 10, 10, C.Pink, 0, 2)
	local globe = kit.Circle(body, 50, 46, 76, 76, C.Glass, 0.3, 2)
	kit.Stroke(globe, kit.Darken(C.Glass, 0.3), 2)
	-- (pas de découpe : les formes restent dans la boule)
	kit.Blob(globe, 38, 62, 58, 18, C.White, { Z = 1, Outline = false, Shade = false })
	local house = kit.Part(globe, 18, 38, 20, 18, C.PinkSoft, { Radius = 3, Z = 2, Thickness = 1.2 })
	kit.Box(house, 7, 9, 6, 9, C.WoodDark, 0, 2)
	kit.Triangle(globe, 28, 26, 26, 14, C.Red, 3)
	kit.Triangle(globe, 52, 22, 20, 34, C.LeafDark, 2)
	for index = 1, 6 do
		local flake = kit.Circle(globe, 14 + index * 8, 14 + (index * 17) % 30, 4, 4, C.White, 0, 4)
		kit.Animate(flake, "Bob", 3, 0.7, index)
	end
	kit.Shine(globe, 14, 12, 12, 22, 5, 0.3)
	return nil
end

-- Boîte à musique : couvercle ouvert (miroir), danseuse qui tourne
Art.MusicBox = function(body, kit, _item)
	local C = kit.C
	-- couvercle ouvert derrière la boîte (on voit son miroir)
	local lid = kit.Part(body, 12, 22, 76, 38, C.Pink, { Radius = 8, Z = 1 })
	local mirror = kit.Part(lid, 6, 5, 64, 26, Color3.fromRGB(230, 244, 255), { Radius = 5, Z = 2, Thickness = 1.2, Shade = false })
	kit.Shine(mirror, 8, 4, 16, 5, 3)
	kit.Heart(lid, 38, 34, 6, C.Gold, 0, 3)
	local box = kit.Part(body, 8, 58, 84, 40, C.Pink, { Radius = 8, Z = 2, Shine = true })
	kit.Box(box, 0, 12, 84, 4, C.Gold, 0, 2)
	kit.Heart(box, 42, 27, 13, C.White, 0, 3)
	kit.Blob(body, 94, 80, 8, 12, C.Gold, { Z = 3, Thickness = 1 }) -- clé
	-- danseuse sur son pied
	local dancer = kit.Pivot(body, 50, 60, 3)
	kit.Part(dancer, -1.5, -8, 3, 8, C.Gold, { Radius = 1, Z = 1, Outline = false })
	kit.Blob(dancer, 0, -13, 24, 9, C.LilacSoft, { Z = 2, Thickness = 1.2 }) -- tutu
	kit.Part(dancer, -4, -26, 8, 13, C.Lilac, { Radius = 4, Z = 3 })
	kit.Line(dancer, -3, -24, -12, -33, 2.4, C.Peach, 0, 3)
	kit.Line(dancer, 3, -24, 12, -33, 2.4, C.Peach, 0, 3)
	kit.Blob(dancer, 0, -32, 11, 11, C.Peach, { Z = 4, Thickness = 1.2 })
	kit.Blob(dancer, 0, -38, 8, 5, C.Brown, { Z = 5, Thickness = 1 })
	kit.Animate(dancer, "Sway", 6, 1.3, 0)
	-- notes
	for index, x in ipairs({ 6, 92 }) do
		local note = kit.Text(body, index == 1 and "🎵" or "🎶", x, 34, 14, C.PinkDeep, 5)
		kit.Animate(note, "Bob", 3, 0.8, index * 1.3)
	end
	return nil
end

-- Mini aquarium rond : poisson, algue, bulles
Art.MiniAquarium = function(body, kit, _item)
	local C = kit.C
	local stand = kit.Part(body, 20, 84, 60, 14, C.WoodLight, { Radius = 5, Z = 1, Shine = true })
	kit.Box(stand, 6, 6, 48, 2, C.WoodDark, 0.3, 2)
	local bowl = kit.Circle(body, 50, 50, 86, 76, C.Glass, 0.3, 2)
	kit.Stroke(bowl, kit.Darken(C.Glass, 0.35), 2)
	-- eau (ovale dans le bas du bocal) + sable
	kit.Blob(bowl, 43, 44, 78, 52, Color3.fromRGB(150, 210, 250), { Z = 1, Outline = false, Shade = false, T = 0.15 })
	kit.Blob(bowl, 43, 64, 56, 12, C.Butter, { Z = 2, Outline = false, Shade = false })
	for _, x in ipairs({ 24, 31 }) do
		local weed = kit.Pivot(bowl, x, 64, 3)
		kit.Blob(weed, 0, -12, 7, 26, C.Leaf, { Thickness = 1.1 })
		kit.Animate(weed, "Sway", 8, 0.7, x)
	end
	local fish = kit.Group(bowl, 44, 34, 30, 18, 4)
	kit.Blob(fish, 12, 9, 22, 16, C.Orange, { Z = 2, Shine = true })
	kit.Part(fish, 20, 3, 10, 12, kit.Darken(C.Orange, 0.1), { Radius = 3, Z = 1, Rotation = 45 })
	kit.Circle(fish, 7, 7, 3, 3, C.Ink, 0, 3)
	kit.Animate(fish, "Drift", 6, 0.6, 0)
	for index = 1, 3 do
		local bubble = kit.Circle(bowl, 34 + index * 6, 30 - index * 5, 4 + index, 4 + index, C.White, 0.4, 5)
		kit.Animate(bubble, "Bob", 2, 1.1, index)
	end
	kit.Shine(bowl, 14, 10, 10, 22, 6, 0.3)
	return nil
end

-- Coffret à bijoux royal : couvercle bombé, perles, diamants
Art.JewelryBox = function(body, kit, _item)
	local C = kit.C
	local velvet = Color3.fromRGB(180, 120, 220)
	for _, x in ipairs({ 18, 82 }) do
		kit.Blob(body, x, 94, 12, 10, C.Gold, { Z = 1, Shine = true })
	end
	local box = kit.Part(body, 8, 54, 84, 40, velvet, { Radius = 8, Z = 2, Shine = true })
	kit.Box(box, 0, 3, 84, 4, C.Gold, 0, 2)
	kit.Box(box, 0, 32, 84, 4, C.Gold, 0, 2)
	local lock = kit.Part(box, 36, 12, 12, 14, C.Gold, { Radius = 3, Z = 3 })
	kit.Circle(lock, 6, 6, 4, 4, kit.Darken(C.Gold, 0.45), 0, 2)
	-- collier de perles qui dépasse
	for index = 0, 6 do
		kit.Circle(body, 22 + index * 9, 52 + math.abs(index - 3) * -2, 7, 7, C.White, 0, 4)
	end
	-- couvercle bombé
	local lid = kit.Part(body, 6, 28, 88, 26, kit.Lighten(velvet, 0.12), { Radius = 12, Z = 3, Shine = true })
	kit.Box(lid, 0, 20, 88, 3, C.Gold, 0, 2)
	-- couronne + diamant
	local crown = kit.Part(body, 36, 10, 28, 18, C.Gold, { Radius = 3, Z = 4, Shine = true })
	for _, x in ipairs({ 4, 14, 24 }) do
		kit.Diamond(crown, x, 0, 8, C.Gold, 0, 1)
	end
	kit.Diamond(crown, 14, 10, 8, C.Sky, 0, 3)
	local sparkle = kit.Sparkle(body, 82, 18, 16, C.White, 0, 5)
	kit.Animate(sparkle, "Breathe", 0.15, 1.6, 0)
	return { Glow = Color3.fromRGB(255, 230, 160) }
end

----------------------------------------------------------------------
-- 🍰 Cuisine
----------------------------------------------------------------------

-- Coupe de fruits : pommes, banane, raisin
Art.FruitBowl = function(body, kit, _item)
	local C = kit.C
	kit.Blob(body, 50, 44, 18, 14, C.Lilac, { Z = 1 }) -- raisin (derrière)
	for index, g in ipairs({ { 36, 40 }, { 44, 36 }, { 40, 46 } }) do
		kit.Circle(body, g[1], g[2], 11, 11, index == 2 and C.Purple or C.Lilac, 0, 2)
	end
	local banana = kit.Part(body, 50, 34, 38, 12, C.Yellow, { Radius = -1, Z = 2, Rotation = -18, Shine = true })
	kit.Box(banana, 34, 3, 4, 5, C.Brown, 0, 2)
	kit.Blob(body, 30, 56, 26, 24, C.Red, { Z = 3, Shine = true })
	kit.Blob(body, 68, 56, 26, 24, C.Leaf, { Z = 3, Shine = true })
	for _, x in ipairs({ 30, 68 }) do
		kit.Line(body, x, 45, x + 2, 40, 2.2, C.Brown, 0, 4)
	end
	local bowl = kit.Part(body, 6, 58, 88, 30, C.Sky, { Radius = -1, Z = 4, Shine = true })
	kit.Box(bowl, 10, 3, 68, 3, C.White, 0.4, 2)
	kit.Part(body, 30, 86, 40, 12, kit.Darken(C.Sky, 0.1), { Radius = 5, Z = 3 })
	kit.Heart(bowl, 44, 16, 10, C.White, 0, 3)
	return nil
end

-- Assiette de pizza : parts garnies, une part soulevée (fil de fromage)
Art.PizzaPlate = function(body, kit, _item)
	local C = kit.C
	plate(kit, body, 50, 84, 96, C.White, 1)
	local pizza = kit.Blob(body, 46, 74, 76, 28, C.Orange, { Z = 3 })
	kit.Blob(pizza, 38, 12, 64, 18, C.Butter, { Z = 2, Outline = false, Shade = false })
	for _, p in ipairs({ { 18, 11 }, { 38, 7 }, { 54, 13 }, { 30, 18 } }) do
		kit.Circle(pizza, p[1], p[2], 8, 6, C.Red, 0, 3)
	end
	kit.Circle(pizza, 46, 19, 5, 4, C.Leaf, 0, 3)
	-- part triangulaire soulevée (pointe en bas)
	local slice = kit.Pivot(body, 78, 56, 4)
	slice.Rotation = 16
	kit.TriangleDown(slice, 0, -18, 26, 34, C.Butter, 1)
	kit.Part(slice, -14, -22, 28, 7, kit.Darken(C.Orange, 0.05), { Radius = 3, Z = 2 }) -- croûte
	kit.Circle(slice, -3, -8, 7, 6, C.Red, 0, 2)
	kit.Circle(slice, 4, 2, 5, 4, C.Red, 0, 2)
	kit.Line(body, 70, 74, 74, 86, 2, C.Butter, 0, 5) -- fil de fromage
	return nil
end

-- Carafe de citronnade + verre avec paille
Art.Lemonade = function(body, kit, _item)
	local C = kit.C
	local jug = kit.Part(body, 8, 24, 52, 74, C.Glass, { Radius = 14, Z = 1, T = 0.2 })
	kit.Part(jug, 4, 20, 44, 50, C.Yellow, { Radius = 12, Z = 1, Outline = false, Shade = false, T = 0.1 })
	kit.Circle(jug, 18, 36, 12, 12, kit.Lighten(C.Yellow, 0.4), 0, 2) -- rondelle
	kit.Circle(jug, 32, 50, 10, 10, kit.Lighten(C.Yellow, 0.4), 0, 2)
	local handle = kit.Circle(body, 60, 52, 20, 30, C.White, 1, 0)
	kit.Stroke(handle, kit.Darken(C.Glass, 0.3), 3)
	kit.Part(body, 6, 20, 56, 8, C.White, { Radius = 4, Z = 2 })
	kit.Shine(jug, 6, 8, 6, 30, 3, 0.3)
	-- verre
	local glass = kit.Part(body, 66, 54, 26, 44, C.Glass, { Radius = 6, Z = 3, T = 0.2 })
	kit.Part(glass, 2, 12, 22, 30, C.Yellow, { Radius = 5, Z = 1, Outline = false, Shade = false, T = 0.1 })
	kit.Line(body, 82, 58, 88, 36, 3, C.Pink, 0, 4)
	kit.Blob(body, 72, 54, 14, 10, kit.Lighten(C.Yellow, 0.2), { Z = 4, Thickness = 1.1 })
	return nil
end

-- Service à thé : théière fleurie + 2 tasses sur un plateau
Art.TeaSet = function(body, kit, _item)
	local C = kit.C
	kit.Part(body, 2, 88, 96, 10, C.WoodLight, { Radius = 5, Z = 1, Shine = true }) -- plateau
	-- théière
	local spout = kit.Line(body, 62, 62, 76, 48, 6, C.White, 0, 2)
	kit.Stroke(spout, kit.OutlineOf(C.White), 1.3)
	local handle = kit.Circle(body, 28, 62, 16, 22, C.White, 1, 2)
	kit.Stroke(handle, kit.OutlineOf(C.White), 3)
	local pot = kit.Blob(body, 48, 64, 40, 36, C.White, { Z = 3, Shine = true })
	kit.Circle(pot, 12, 20, 8, 8, C.Pink, 0, 2)
	kit.Circle(pot, 26, 14, 7, 7, C.Mint, 0, 2)
	kit.Blob(body, 48, 46, 22, 8, C.PinkSoft, { Z = 4 })
	kit.Blob(body, 48, 41, 7, 6, C.Pink, { Z = 5 })
	-- tasses
	for _, x in ipairs({ 16, 84 }) do
		local cup = kit.Part(body, x - 10, 74, 20, 14, C.PinkSoft, { Radius = 6, Z = 4, Shine = true })
		kit.Heart(cup, 10, 7, 6, C.Pink, 0, 2)
		kit.Blob(body, x, 88, 26, 6, C.White, { Z = 3, Thickness = 1.1 })
	end
	local steam = kit.Line(body, 76, 42, 80, 32, 2, C.White, 0.4, 3)
	kit.Animate(steam, "Drift", 2, 1, 0)
	return nil
end

-- Saladier : feuilles, tomates, œuf
Art.SaladBowl = function(body, kit, _item)
	local C = kit.C
	for index, leaf in ipairs({ { 30, 48, -30 }, { 50, 42, 0 }, { 70, 48, 30 }, { 40, 52, -12 }, { 60, 52, 14 } }) do
		kit.Blob(body, leaf[1], leaf[2], 26, 18, index % 2 == 0 and C.Leaf or C.Green, { Z = 1, Rotation = leaf[3] })
	end
	kit.Circle(body, 36, 50, 12, 12, C.Red, 0, 2)
	kit.Circle(body, 62, 48, 11, 11, C.Red, 0, 2)
	local egg = kit.Blob(body, 50, 52, 16, 12, C.White, { Z = 2 })
	kit.Circle(egg, 8, 6, 7, 7, C.Yellow, 0, 2)
	local bowl = kit.Part(body, 4, 56, 92, 34, C.White, { Radius = -1, Z = 3, Shine = true })
	kit.Box(bowl, 8, 12, 76, 4, C.Mint, 0.2, 2)
	kit.Part(body, 28, 86, 44, 12, kit.Darken(C.White, 0.08), { Radius = 5, Z = 2 })
	return nil
end

-- Grille-pain qui sourit, 2 tartines qui sautent
Art.Toaster = function(body, kit, _item)
	local C = kit.C
	for index, x in ipairs({ 34, 56 }) do
		local toast = kit.Part(body, x - 10, 18, 20, 24, C.WoodLight, { Radius = 7, Z = 1 })
		kit.Part(toast, 3, 3, 14, 18, kit.Lighten(C.WoodLight, 0.4), { Radius = 5, Z = 2, Outline = false, Shade = false })
		kit.Animate(toast, "Bob", 3, 1.4, index * 1.1)
	end
	local toaster = kit.Part(body, 10, 36, 80, 58, C.Mint, { Radius = 16, Z = 2, Shine = true })
	kit.Box(toaster, 18, 2, 18, 3, kit.Darken(C.Mint, 0.4), 0, 2)
	kit.Box(toaster, 40, 2, 18, 3, kit.Darken(C.Mint, 0.4), 0, 2)
	kit.Face(toaster, 38, 32, 30, { Eyes = "happy", Mouth = "smile", Z = 3 })
	kit.Part(body, 84, 50, 8, 14, C.Grey, { Radius = 3, Z = 3 }) -- levier
	kit.Part(body, 18, 92, 64, 6, kit.Darken(C.Mint, 0.3), { Radius = 3, Z = 1 })
	return nil
end

-- Tour de macarons pastel
Art.MacaronTower = function(body, kit, _item)
	local C = kit.C
	kit.Blob(body, 50, 95, 70, 8, C.Gold, { Z = 1 }) -- présentoir
	kit.Part(body, 46, 84, 8, 10, C.Gold, { Radius = 3, Z = 1 })
	local colors = { C.PinkSoft, C.MintSoft, C.LilacSoft, kit.Lighten(C.Butter, 0.3), C.Pink }
	local rows = { { 5, 82 }, { 4, 66 }, { 3, 50 }, { 2, 34 }, { 1, 18 } }
	for r, row in ipairs(rows) do
		local count, y = row[1], row[2]
		for index = 1, count do
			local x = 50 + (index - (count + 1) / 2) * 17
			local color = colors[(r + index) % #colors + 1]
			local mac = kit.Part(body, x - 8, y - 6, 16, 12, color, { Radius = -1, Z = 2 + r, Thickness = 1.2 })
			kit.Box(mac, 1, 5, 14, 2, C.Cream, 0, 2)
		end
	end
	kit.Heart(body, 50, 8, 12, C.PinkDeep, 0, 9)
	return nil
end

-- Micro-ondes mignon : hublot, pop-corn qui éclate
Art.Microwave = function(body, kit, _item)
	local C = kit.C
	local oven = kit.Part(body, 4, 30, 92, 64, C.PinkSoft, { Radius = 12, Z = 1, Shine = true })
	local door = kit.Part(oven, 6, 8, 58, 48, C.Glass, { Radius = 8, Z = 2, Thickness = 1.3 })
	local inside = kit.Part(door, 5, 5, 48, 38, Color3.fromRGB(255, 236, 170), { Radius = 5, Z = 2, Outline = false, Shade = false, T = 0.1 })
	local bag = kit.Part(inside, 16, 10, 16, 24, C.White, { Radius = 3, Z = 2, Thickness = 1.1 })
	kit.Box(bag, 3, 6, 10, 3, C.Red, 0, 2)
	for index, p in ipairs({ { 12, 9 }, { 34, 7 }, { 26, 4 } }) do
		local corn = kit.Circle(inside, p[1], p[2], 7, 6, C.White, 0, 3)
		kit.Animate(corn, "Bob", 2, 1.6, index)
	end
	kit.Face(oven, 78, 18, 18, { Eyes = "dot", Mouth = "cat", Z = 3 })
	for index = 0, 2 do
		kit.Circle(oven, 78, 34 + index * 7, 5, 5, index == 0 and C.Pink or C.White, 0, 3)
	end
	for _, x in ipairs({ 16, 80 }) do
		kit.Part(body, x, 92, 8, 6, C.GreyDark, { Radius = 2, Z = 0 })
	end
	return nil
end

----------------------------------------------------------------------
-- 🪴 Plantes
----------------------------------------------------------------------

-- Vase rond et bouquet de tulipes / marguerites
Art.FlowerVase = function(body, kit, _item)
	local C = kit.C
	for index, stem in ipairs({ { 34, 16, -14 }, { 50, 8, 0 }, { 66, 16, 14 }, { 42, 24, -6 }, { 58, 24, 8 } }) do
		kit.Line(body, 50, 60, stem[1], stem[2] + 8, 3, C.LeafDark, 0, 1)
		local color = ({ C.Pink, C.Butter, C.Lilac, C.PinkDeep, C.White })[index]
		local flower = kit.Pivot(body, stem[1], stem[2] + 4, 2)
		if index % 2 == 1 then
			kit.Part(flower, -7, -8, 14, 14, color, { Radius = 5, Z = 1 }) -- tulipe
			kit.Triangle(flower, -3, -12, 5, 6, color, 2)
			kit.Triangle(flower, 3, -12, 5, 6, color, 2)
		else
			for petal = 0, 4 do
				local a = petal * math.pi * 2 / 5
				kit.Circle(flower, math.cos(a) * 5, math.sin(a) * 5 - 2, 7, 7, color, 0, 1)
			end
			kit.Circle(flower, 0, -2, 5, 5, C.Yellow, 0, 2)
		end
		kit.Animate(flower, "Sway", 3, 0.6, index)
	end
	kit.Blob(body, 32, 50, 16, 8, C.Leaf, { Z = 2, Rotation = -30 })
	kit.Blob(body, 68, 50, 16, 8, C.Leaf, { Z = 2, Rotation = 30 })
	local vase = kit.Blob(body, 50, 78, 50, 44, C.Sky, { Z = 3, Shine = true })
	kit.Part(body, 38, 52, 24, 10, kit.Darken(C.Sky, 0.08), { Radius = 4, Z = 4 })
	kit.Heart(vase, 25, 24, 12, C.White, 0, 3)
	return nil
end

-- Petit bonsaï dans un pot bas
Art.Bonsai = function(body, kit, _item)
	local C = kit.C
	local trunk = C.Brown
	kit.Line(body, 50, 84, 44, 60, 8, trunk, 0, 1)
	kit.Line(body, 44, 60, 56, 40, 7, trunk, 0, 1)
	kit.Line(body, 50, 52, 30, 44, 5, trunk, 0, 1)
	kit.Line(body, 54, 44, 72, 34, 5, trunk, 0, 1)
	for index, puff in ipairs({ { 28, 38, 30 }, { 54, 26, 36 }, { 76, 30, 28 }, { 42, 30, 24 } }) do
		local cloud = kit.Blob(body, puff[1], puff[2], puff[3], puff[3] * 0.7, index % 2 == 0 and C.LeafDark or C.Leaf, { Z = 2, Shine = true })
		kit.Animate(cloud, "Breathe", 0.03, 0.5, index)
	end
	kit.Circle(body, 60, 24, 6, 6, C.Pink, 0, 3) -- fleur
	local pot = kit.Part(body, 12, 80, 76, 18, C.Peach, { Radius = 5, Z = 3, Shine = true })
	kit.Box(pot, 0, 0, 76, 5, kit.Darken(C.Peach, 0.12), 0, 2)
	kit.Blob(body, 50, 81, 60, 6, C.Brown, { Z = 2, Outline = false, Shade = false })
	return nil
end

----------------------------------------------------------------------
-- 💡 Lumières
----------------------------------------------------------------------

-- Lampe de bureau articulée (abat-jour menthe qui éclaire)
Art.DeskLamp = function(body, kit, _item)
	local C = kit.C
	kit.Blob(body, 34, 95, 44, 10, C.Mint, { Z = 1, Shine = true })
	kit.Line(body, 34, 92, 26, 54, 5, C.GreyDark, 0, 2)
	kit.Line(body, 26, 54, 52, 26, 5, C.GreyDark, 0, 2)
	kit.Circle(body, 26, 54, 9, 9, C.Mint, 0, 3)
	local shade = kit.Pivot(body, 56, 24, 4)
	shade.Rotation = 30
	kit.Part(shade, -18, -10, 36, 22, C.Mint, { Radius = 9, Z = 2, Shine = true })
	kit.Blob(shade, 0, 12, 18, 8, C.Butter, { Z = 3, Outline = false })
	local beam = kit.Triangle(body, 72, 36, 40, 50, C.Butter, 1, 0.75)
	beam.Rotation = -30
	return { Glow = Color3.fromRGB(255, 240, 180) }
end

-- Lampe champignon qui brille (pois lumineux)
Art.MushroomLamp = function(body, kit, _item)
	local C = kit.C
	local stem = kit.Part(body, 36, 50, 28, 46, C.Cream, { Radius = 12, Z = 1 })
	kit.Face(stem, 14, 20, 18, { Eyes = "closed", Mouth = "cat", Z = 3 })
	kit.Blob(body, 50, 96, 50, 8, C.Leaf, { Z = 0 })
	local cap = kit.Part(body, 6, 8, 88, 50, C.Lilac, { Radius = -1, Z = 2, Shine = true })
	local dots = {}
	for index, d in ipairs({ { 18, 18, 11 }, { 44, 10, 14 }, { 70, 18, 11 }, { 30, 32, 8 }, { 58, 32, 8 } }) do
		local dot = kit.Circle(cap, d[1], d[2], d[3], d[3], C.Butter, 0, 2)
		kit.Animate(dot, "Pulse", 0.35, 1, index)
		table.insert(dots, dot)
	end
	kit.Part(body, 14, 50, 72, 8, kit.Darken(C.Lilac, 0.25), { Radius = -1, Z = 1, Outline = false })
	return { Glow = Color3.fromRGB(230, 200, 255) }
end

-- Chandelier de cristal : 3 bougies, pampilles
Art.Candelabra = function(body, kit, _item)
	local C = kit.C
	kit.Blob(body, 50, 94, 48, 10, C.Gold, { Z = 1, Shine = true })
	kit.Part(body, 46, 52, 8, 42, C.Gold, { Radius = 4, Z = 2 })
	kit.Blob(body, 50, 74, 16, 10, C.Gold, { Z = 3, Shine = true })
	-- bras recourbés (segments dorés)
	for _, side in ipairs({ -1, 1 }) do
		kit.Line(body, 50, 64, 50 + side * 18, 66, 4, C.Gold, 0, 2)
		kit.Line(body, 50 + side * 18, 66, 50 + side * 28, 58, 4, C.Gold, 0, 2)
	end
	for index, x in ipairs({ 22, 50, 78 }) do
		local top = index == 2 and 18 or 30
		kit.Blob(body, x, top + 26, 18, 6, C.Gold, { Z = 3 })
		kit.Part(body, x - 5, top, 10, 26, C.Cream, { Radius = 3, Z = 4, Shine = true })
		flame(kit, body, x, top + 1, 9, 14, 5, index)
		-- pampille de cristal
		local drop = kit.Diamond(body, x, top + 34, 6, C.Glass, 0.1, 5)
		kit.Stroke(drop, C.Sky, 1)
		kit.Animate(drop, "Sway", 8, 1, index)
	end
	return { Glow = Color3.fromRGB(255, 210, 140) }
end

----------------------------------------------------------------------
-- 📺 Électronique
----------------------------------------------------------------------

-- Réveil à deux cloches qui sourit
Art.AlarmClock = function(body, kit, _item)
	local C = kit.C
	for _, x in ipairs({ 26, 74 }) do
		kit.Blob(body, x, 20, 26, 18, C.Gold, { Z = 1, Shine = true })
	end
	kit.Line(body, 30, 12, 70, 12, 3, C.GreyDark, 0, 1)
	for _, x in ipairs({ 22, 78 }) do
		kit.Line(body, 50 + (x - 50) * 0.6, 84, x, 97, 5, C.GreyDark, 0, 1)
	end
	local clock = kit.Circle(body, 50, 56, 76, 76, C.Red, 0, 2)
	kit.Stroke(clock, kit.OutlineOf(C.Red), 1.6)
	local face = kit.Circle(clock, 38, 38, 58, 58, C.White, 0, 2)
	for index = 0, 3 do
		local a = index * math.pi / 2
		kit.Circle(face, 29 + math.cos(a) * 22, 29 + math.sin(a) * 22, 4, 4, C.Ink, 0, 2)
	end
	local hand = kit.Pivot(face, 29, 29, 3)
	kit.Part(hand, -1.5, -20, 3, 20, C.Ink, { Radius = 1, Outline = false, Shade = false })
	kit.Animate(hand, "Spin", 1, 0.08, 0)
	kit.Part(face, 27.5, 18, 3, 12, C.PinkDeep, { Radius = 1, Z = 3, Outline = false, Shade = false })
	kit.Circle(face, 29, 29, 5, 5, C.PinkDeep, 0, 4)
	return nil
end

-- Machine à écrire rétro avec une feuille
Art.Typewriter = function(body, kit, _item)
	local C = kit.C
	local paper = kit.Part(body, 28, 6, 44, 40, C.White, { Radius = 2, Z = 1, Thickness = 1.2 })
	for index = 0, 3 do
		kit.Box(paper, 5, 8 + index * 6, 34 - index * 5, 1.6, C.Grey, 0, 2)
	end
	kit.Heart(paper, 34, 32, 7, C.Pink, 0, 2)
	kit.Part(body, 14, 38, 72, 10, C.GreyDark, { Radius = 5, Z = 2 }) -- rouleau
	for _, x in ipairs({ 10, 90 }) do
		kit.Blob(body, x, 43, 10, 12, C.Grey, { Z = 3 })
	end
	local machine = kit.Part(body, 6, 46, 88, 50, C.Mint, { Radius = 10, Z = 3, Shine = true })
	for row = 0, 2 do
		for col = 0, 6 - row do
			kit.Circle(machine, 14 + col * 10 + row * 5, 12 + row * 10, 7, 7, C.Cream, 0, 2)
		end
	end
	kit.Part(machine, 26, 40, 36, 6, C.Cream, { Radius = 3, Z = 2 }) -- barre d'espace
	return nil
end

-- Ventilateur de bureau (pales qui tournent)
Art.DeskFan = function(body, kit, _item)
	local C = kit.C
	kit.Blob(body, 50, 94, 50, 12, C.Sky, { Z = 1, Shine = true })
	kit.Part(body, 45, 56, 10, 38, C.Sky, { Radius = 5, Z = 2 })
	local cage = kit.Circle(body, 50, 38, 74, 74, C.White, 0.55, 3)
	kit.Stroke(cage, kit.Darken(C.Sky, 0.25), 3)
	local blades = kit.Pivot(body, 50, 38, 4)
	for index = 0, 2 do
		local blade = kit.Pivot(blades, 0, 0, 1)
		blade.Rotation = index * 120
		kit.Blob(blade, 0, -15, 16, 28, index == 0 and C.Pink or C.PinkSoft, { Thickness = 1.3 })
	end
	kit.Animate(blades, "Spin", 1, 1.2, 0)
	kit.Circle(body, 50, 38, 12, 12, C.Butter, 0, 5)
	for index = 0, 2 do
		local wind = kit.Line(body, 84, 28 + index * 10, 96, 28 + index * 10, 2, C.Sky, 0.3, 2)
		kit.Animate(wind, "Drift", 3, 1.5, index)
	end
	return nil
end

-- Tablette à dessin + stylet (un petit dessin de chat sur l'écran)
Art.DrawingTablet = function(body, kit, _item)
	local C = kit.C
	local stand = kit.Line(body, 70, 50, 84, 98, 5, C.GreyDark, 0, 1)
	stand.Name = "Stand"
	local tablet = kit.Part(body, 6, 28, 76, 70, C.Ink, { Radius = 10, Z = 2, Shine = true })
	local screen = kit.Part(tablet, 6, 6, 64, 58, Color3.fromRGB(255, 244, 250), { Radius = 5, Z = 2, Outline = false, Shade = false })
	local cat = kit.Circle(screen, 30, 32, 26, 22, C.White, 1, 2)
	kit.Stroke(cat, C.PinkDeep, 2)
	kit.Line(screen, 20, 21, 22, 14, 2, C.PinkDeep, 0, 3)
	kit.Line(screen, 38, 21, 36, 14, 2, C.PinkDeep, 0, 3)
	kit.Circle(screen, 25, 31, 3, 3, C.PinkDeep, 0, 3)
	kit.Circle(screen, 35, 31, 3, 3, C.PinkDeep, 0, 3)
	for index, color in ipairs({ C.Red, C.Butter, C.Mint, C.Sky }) do
		kit.Circle(screen, 8 + index * 9, 52, 6, 6, color, 0, 3)
	end
	local pen = kit.Pivot(body, 84, 30, 4)
	pen.Rotation = 30
	kit.Part(pen, -3, -2, 6, 36, C.Lilac, { Radius = 3 })
	kit.Part(pen, -1.5, 32, 3, 6, C.GreyDark, { Radius = 1 })
	return nil
end

----------------------------------------------------------------------
-- 🧸 Jouets
----------------------------------------------------------------------

-- Jeu de société : plateau, dés, pions
Art.BoardGame = function(body, kit, _item)
	local C = kit.C
	kit.Part(body, 4, 72, 92, 26, C.Red, { Radius = 5, Z = 1 }) -- boîte
	local board = kit.Part(body, 2, 64, 96, 16, C.Cream, { Radius = 4, Z = 2, Shine = true })
	for col = 0, 7 do
		kit.Box(board, 6 + col * 11, 3, 10, 10, col % 2 == 0 and C.Pink or C.Mint, 0.1, 2)
	end
	-- pions
	for index, p in ipairs({ { 24, C.Sky }, { 50, C.Butter }, { 76, C.Lilac } }) do
		local pawn = kit.Pivot(body, p[1], 66, 3)
		kit.Part(pawn, -7, -16, 14, 16, p[2], { Radius = 6, Z = 1 })
		kit.Blob(pawn, 0, -20, 12, 12, p[2], { Z = 2, Shine = true })
		kit.Animate(pawn, "Bob", 1.5, 1, index)
	end
	-- dé
	local die = kit.Part(body, 60, 34, 22, 22, C.White, { Radius = 5, Z = 4, Rotation = 12, Shine = true })
	for _, dot in ipairs({ { 6, 6 }, { 16, 16 }, { 11, 11 } }) do
		kit.Circle(die, dot[1], dot[2], 4, 4, C.Ink, 0, 2)
	end
	return nil
end

-- Peluche baleine bleue (petit jet d'eau)
Art.WhalePlush = function(body, kit, _item)
	local C = kit.C
	local blue = Color3.fromRGB(150, 196, 250)
	local tail = kit.Pivot(body, 86, 64, 1)
	kit.Blob(tail, 4, -12, 22, 14, blue, { Rotation = -30 })
	kit.Animate(tail, "Sway", 8, 0.8, 0)
	local whale = kit.Blob(body, 46, 70, 84, 56, blue, { Z = 2, Shine = true })
	kit.Blob(whale, 38, 44, 60, 20, kit.Lighten(blue, 0.55), { Z = 1, Outline = false, Shade = false })
	kit.Face(whale, 28, 22, 28, { Eyes = "big", Mouth = "smile", Z = 3 })
	kit.Blob(body, 66, 84, 18, 10, kit.Darken(blue, 0.08), { Z = 3, Rotation = 20 }) -- nageoire
	for index, x in ipairs({ 40, 46, 52 }) do
		local drop = kit.Circle(body, x, 26 - index % 2 * 6, 7, 9, C.Sky, 0, 3)
		kit.Animate(drop, "Bob", 3, 1.4, index)
	end
	kit.Line(body, 46, 42, 46, 32, 3, C.Sky, 0, 3)
	return nil
end

-- Peluche pieuvre rose aux tentacules qui ondulent
Art.OctopusPlush = function(body, kit, _item)
	local C = kit.C
	local pink = Color3.fromRGB(255, 160, 196)
	for index = 0, 5 do
		local x = 18 + index * 12.8
		local leg = kit.Pivot(body, x, 70, 1)
		kit.Part(leg, -6, 0, 12, 28, pink, { Radius = 6, Thickness = 1.3 })
		kit.Circle(leg, 0, 20, 4, 4, kit.Lighten(pink, 0.5), 0, 2)
		kit.Animate(leg, "Sway", 6, 1.1, index * 0.9)
	end
	local head = kit.Blob(body, 50, 46, 76, 62, pink, { Z = 2, Shine = true })
	kit.Face(head, 38, 36, 34, { Eyes = "happy", Mouth = "o", Z = 3 })
	kit.Circle(head, 20, 16, 7, 7, kit.Lighten(pink, 0.4), 0, 2)
	kit.Circle(head, 56, 12, 5, 5, kit.Lighten(pink, 0.4), 0, 2)
	-- petit chapeau
	local hat = kit.Part(body, 36, 8, 28, 12, C.Butter, { Radius = 4, Z = 3, Rotation = -8 })
	kit.Heart(hat, 14, 6, 6, C.PinkDeep, 0, 2)
	return nil
end

return Art
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="35">
              <Properties>
                <string name="Name">Toys</string>
                <string name="Source"><![CDATA[--[[
	Toys (ModuleScript) — dessins 🧸 jouets
	Emplacement : ReplicatedStorage > Client > Components > House > Art > Toys
	Contrat : voir HouseArt (boîte 100 x 100, pieds en bas pour les objets au sol).
]]

local Art = {}

----------------------------------------------------------------------
-- Aides partagées
----------------------------------------------------------------------

-- Pivot + calque 100 x 100 : on dessine avec les coordonnées de la boîte,
-- et le tout tourne autour de (px, py)
local function rig(parent, kit, px, py, z)
	local pivot = kit.Pivot(parent, px, py, z)
	local layer = kit.Group(pivot, -px, -py, 100, 100, 1)
	return pivot, layer
end

-- Calque qui "respire" depuis le sol (échelle ancrée en bas au centre)
local function breathing(body, kit, amp, phase)
	local layer = kit.Group(body, 0, 0, 100, 100, 2)
	layer.AnchorPoint = Vector2.new(0.5, 1)
	layer.Position = UDim2.fromOffset(50, 100)
	kit.Animate(layer, "Breathe", amp, 1, phase)
	return layer
end

-- Cœur avec contour (un cœur foncé un peu plus grand derrière)
local function heartOutlined(parent, kit, cx, cy, w, color, z)
	kit.Heart(parent, cx, cy + 0.5, w + 3.6, kit.OutlineOf(color), 0, z)
	return kit.Heart(parent, cx, cy, w, color, 0, z + 1)
end

-- Pointe arrondie (carré tourné à 45°) : oreille de chat, piquant de dino...
local function point(parent, kit, cx, cy, size, color, rotation, z, inner)
	local frame = kit.Part(parent, cx - size / 2, cy - size / 2, size, size, color, { Radius = size * 0.22, Z = z, Rotation = rotation, Shade = false })
	if inner then
		kit.Part(frame, size * 0.14, size * 0.14, size * 0.52, size * 0.52, inner, { Radius = size * 0.14, Z = 2, Outline = false, Shade = false })
	end
	return frame
end

-- Museau (ours, chien) : truffe + petite bouche "w"
local function muzzle(parent, kit, cx, cy, w, h, color, nose, z)
	local C = kit.C
	local frame = kit.Blob(parent, cx, cy, w, h, color, { Z = z, Thickness = 1.3, Shade = 0.06 })
	local truffle = kit.Blob(frame, w / 2, h * 0.3, w * 0.36, h * 0.32, nose, { Z = 3, Outline = false, Shade = false })
	kit.Circle(truffle, w * 0.1, h * 0.09, w * 0.1, h * 0.08, C.White, 0.3, 2)
	kit.Line(frame, w / 2, h * 0.44, w / 2, h * 0.6, 1.3, C.Ink, 0, 2)
	kit.Line(frame, w / 2 - w * 0.15, h * 0.68, w / 2, h * 0.6, 1.3, C.Ink, 0, 2)
	kit.Line(frame, w / 2, h * 0.6, w / 2 + w * 0.15, h * 0.68, 1.3, C.Ink, 0, 2)
	return frame
end

-- Nœud (2 boucles + un nœud central)
local function bow(parent, kit, cx, cy, w, color, z)
	for _, side in ipairs({ -1, 1 }) do
		kit.Blob(parent, cx + side * w * 0.27, cy, w * 0.54, w * 0.4, color, { Z = z, Rotation = -side * 14, Thickness = 1.3 })
	end
	kit.Blob(parent, cx, cy, w * 0.24, w * 0.28, kit.Darken(color, 0.06), { Z = z + 1, Thickness = 1.3 })
end

-- Peluche assise vue de face : corps, ventre, pieds, bras, tête dans un pivot
-- au cou (pour pencher la tête). Oreilles / visage : dans `Head` (tête Z = 4).
local function plush(root, kit, o)
	local color = o.Color
	local limb = o.Limb or color
	local light = o.Light or kit.Lighten(color, 0.5)
	local bw, bh = o.BodyW or 50, o.BodyH or 38
	local torso = kit.Blob(root, 50, 97 - bh / 2, bw, bh, color, { Z = 3 })
	if o.Belly ~= false then
		kit.Blob(torso, bw / 2, bh * 0.58, bw * 0.56, bh * 0.6, light, { Z = 2, Outline = false, Shade = false })
	end
	for _, side in ipairs({ -1, 1 }) do
		local foot = kit.Blob(root, 50 + side * bw * 0.3, 92, bw * 0.38, 14, limb, { Z = 4 })
		kit.Blob(foot, bw * 0.19, 7.5, bw * 0.2, 7, o.Paw or light, { Z = 2, Outline = false, Shade = false })
		kit.Blob(root, 50 + side * bw * 0.43, 97 - bh * 0.6, 13, bh * 0.56, limb, { Z = 5, Rotation = -side * 26 })
	end
	local neck, head = rig(root, kit, 50, 97 - bh + 4, 6)
	local skull = kit.Blob(head, 50, o.HeadY or 40, o.HeadW or 58, o.HeadH or 46, color, { Z = 4, Shine = true })
	return { Torso = torso, Neck = neck, Head = head, Skull = skull }
end

-- Cheval vu de profil (tourné vers la droite), origine = centre du corps,
-- k = échelle. o = { X, Y, K, Coat, Mane = { couleurs }, Saddle, Hoof, Legs }
-- Legs = liste de { x1, y1, x2, y2, x3?, y3?, far? } (coordonnées "cheval")
local function horse(parent, kit, o)
	local C = kit.C
	local k, ox, oy = o.K, o.X, o.Y
	local function X(v)
		return ox + v * k
	end
	local function Y(v)
		return oy + v * k
	end
	local coat = o.Coat
	local far = kit.Darken(coat, 0.1)
	local mane = o.Mane
	-- queue (derrière)
	for index, color in ipairs(mane) do
		kit.Blob(parent, X(-25 - index * 3), Y(-4 + index * 5), 8 * k, 22 * k, color, { Z = 1, Rotation = 30 + index * 14, Thickness = 1.3 })
	end
	-- jambes (le haut est caché par le corps)
	local legT = 6 * k
	for _, leg in ipairs(o.Legs) do
		local color = if leg[7] then far else coat
		local z = if leg[7] then 1 else 2
		local ex, ey = leg[3], leg[4]
		kit.Line(parent, X(leg[1]), Y(leg[2]), X(leg[3]), Y(leg[4]), legT, color, 0, z)
		if leg[5] then
			kit.Line(parent, X(leg[3]), Y(leg[4]), X(leg[5]), Y(leg[6]), legT, color, 0, z)
			ex, ey = leg[5], leg[6]
		end
		kit.Circle(parent, X(ex), Y(ey), legT * 1.25, legT * 1.1, o.Hoof, 0, z)
	end
	-- corps, cou, tête
	kit.Blob(parent, X(0), Y(0), 50 * k, 28 * k, coat, { Z = 3, Shine = true })
	kit.Blob(parent, X(17), Y(-15), 17 * k, 34 * k, coat, { Z = 2, Rotation = 30, Shade = false })
	local headFrame = kit.Blob(parent, X(29), Y(-29), 30 * k, 16 * k, coat, { Z = 5, Rotation = 32, Shade = false })
	kit.Blob(parent, X(39), Y(-22), 13 * k, 12 * k, C.PinkSoft, { Z = 6, Thickness = 1.3 })
	kit.Circle(parent, X(41), Y(-22.5), 2 * k, 2.4 * k, C.Ink, 0.3, 7)
	point(parent, kit, X(19), Y(-39), 8 * k, coat, 20, 3, C.PinkSoft)
	local eye = kit.Circle(parent, X(27), Y(-31), 4 * k, 4.8 * k, C.Ink, 0, 7)
	kit.Circle(eye, 1.3 * k, 1.3 * k, 1.6 * k, 1.6 * k, C.White, 0, 2)
	kit.Circle(parent, X(31), Y(-25), 6 * k, 3.5 * k, C.Blush, 0.35, 7)
	-- crinière (boucles le long du cou)
	local curls = { { 13, -37, 12 }, { 8, -29, 12 }, { 5, -20, 11 }, { 3, -11, 9 }, { 21, -41, 9 } }
	for index, curl in ipairs(curls) do
		kit.Blob(parent, X(curl[1]), Y(curl[2]), curl[3] * k, curl[3] * k, mane[(index - 1) % #mane + 1], { Z = 6, Thickness = 1.3 })
	end
	-- selle et tapis
	kit.Part(parent, X(-13), Y(-13), 22 * k, 14 * k, o.Blanket, { Radius = 4 * k, Z = 5, Shade = false })
	kit.Part(parent, X(-10), Y(-17), 16 * k, 8 * k, o.Saddle, { Radius = 4 * k, Z = 6, Shine = true })
	return headFrame
end

----------------------------------------------------------------------
-- Petits jouets
----------------------------------------------------------------------

-- Yo-yo rose : disque, anneau, motif qui tourne, ficelle et boucle pour le doigt
Art.YoYo = function(body, kit, _item)
	local C = kit.C
	local g = kit.Group(body, 0, 0, 100, 100, 2)
	kit.Line(g, 50, 72, 50, 24, 1.6, C.Ink, 0.25, 1)
	kit.Part(g, 43, 10, 14, 14, C.White, { Radius = -1, T = 1, Outline = C.Lilac, Thickness = 2.4, Shade = false, Z = 1 })
	kit.Blob(g, 50, 74, 46, 46, C.Pink, { Z = 3, Shine = true })
	kit.Blob(g, 50, 74, 32, 32, C.PinkSoft, { Z = 4, Outline = kit.Lighten(C.PinkDeep, 0.3), Thickness = 1.3 })
	local spin = kit.Pivot(g, 50, 74, 5)
	for _, a in ipairs({ 0, 120, 240 }) do
		local r = math.rad(a)
		kit.Heart(spin, math.sin(r) * 9, -math.cos(r) * 9, 7, C.PinkDeep, 0.1, 1)
	end
	kit.Blob(g, 50, 74, 8, 8, C.White, { Z = 6, Outline = C.PinkDeep, Thickness = 1.2 })
	kit.Animate(spin, "Spin", 0, 0.25, 0.4)
	kit.Animate(g, "Bob", 1.5, 0.8, 0.2)
	return nil
end

-- Ballon de plage : quartiers colorés, pôle blanc, léger roulis
Art.BeachBall = function(body, kit, _item)
	local C = kit.C
	local pivot, layer = rig(body, kit, 50, 69, 2)
	pivot.Rotation = -18
	kit.Blob(layer, 50, 69, 58, 58, C.Pink, { Z = 2, Shade = 0.16 })
	kit.Blob(layer, 50, 69, 40, 58, C.White, { Z = 3, Outline = false, Shade = 0.1 })
	kit.Blob(layer, 50, 69, 22, 58, C.Sky, { Z = 4, Outline = false, Shade = 0.12 })
	kit.Blob(layer, 50, 69, 6, 58, C.Butter, { Z = 5, Outline = false, Shade = false })
	kit.Blob(layer, 50, 42.5, 11, 6, C.White, { Z = 6, Thickness = 1.2 })
	kit.Shine(layer, 28, 52, 7, 12, 7, 0.3)
	kit.Animate(pivot, "Sway", 5, 0.5, 0.3)
	return nil
end

-- Canard de bain jaune, vu de 3/4, qui se dandine
Art.RubberDucky = function(body, kit, _item)
	local C = kit.C
	local yellow = Color3.fromRGB(255, 222, 110)
	local pivot, layer = rig(body, kit, 50, 97, 2)
	point(layer, kit, 22, 67, 16, yellow, 25, 2)
	kit.Blob(layer, 46, 79, 62, 36, yellow, { Z = 3, Shine = true })
	kit.Blob(layer, 38, 79, 24, 15, kit.Lighten(yellow, 0.35), { Z = 4, Rotation = -14, Thickness = 1.3 })
	kit.Blob(layer, 61, 48, 36, 34, yellow, { Z = 5, Shine = true })
	point(layer, kit, 61, 32, 9, yellow, 45, 4)
	kit.Face(layer, 61, 47, 24, { Eyes = "dot", Mouth = "none", Z = 7 })
	kit.Blob(layer, 62, 55, 15, 8, C.Orange, { Z = 8, Thickness = 1.3 })
	kit.Line(layer, 57, 55.5, 67, 55.5, 1, kit.Darken(C.Orange, 0.25), 0.3, 9)
	kit.Animate(pivot, "Sway", 4, 0.7, 0.6)
	return nil
end

-- Pièces de puzzle (tenon avec contour ; le raccord est masqué)
local function puzzlePiece(parent, kit, x, y, s, color, knobs, rotation, z)
	local g = kit.Group(parent, x, y, s, s, z)
	g.Rotation = rotation
	kit.Part(g, 0, 0, s, s, color, { Radius = 4, Z = 2, Shade = false })
	kit.Shine(g, 3.5, 3.5, s * 0.3, 3.5, 4)
	local r = s * 0.17
	for _, side in ipairs(knobs) do
		local kx, ky, cw, ch
		if side == "R" then
			kx, ky, cw, ch = s + r * 0.55, s / 2, 4.4, r * 1.5
		elseif side == "L" then
			kx, ky, cw, ch = -r * 0.55, s / 2, 4.4, r * 1.5
		elseif side == "T" then
			kx, ky, cw, ch = s / 2, -r * 0.55, r * 1.5, 4.4
		else
			kx, ky, cw, ch = s / 2, s + r * 0.55, r * 1.5, 4.4
		end
		kit.Blob(g, kx, ky, r * 2, r * 2, color, { Z = 1, Shade = false })
		local cx = if side == "R" then s else if side == "L" then 0 else s / 2
		local cy = if side == "T" then 0 else if side == "B" then s else s / 2
		kit.Box(g, cx - cw / 2, cy - ch / 2, cw, ch, color, 0, 3)
	end
	return g
end

Art.PuzzlePieces = function(body, kit, _item)
	local C = kit.C
	puzzlePiece(body, kit, 50, 67, 31, C.Mint, { "T" }, 6, 2)
	puzzlePiece(body, kit, 12, 66, 32, C.Pink, { "R", "T" }, -3, 3)
	local top = puzzlePiece(body, kit, 30, 24, 30, C.Butter, { "L", "B" }, -14, 4)
	kit.Animate(top, "Bob", 1.2, 0.7, 0.5)
	kit.Sparkle(body, 80, 40, 9, C.Lilac, 0, 5)
	return nil
end

-- Dé géant façon cube arrondi : face avant, dessus, côté, points en cœur
Art.GiantDice = function(body, kit, _item)
	local C = kit.C
	local white = Color3.fromRGB(255, 252, 250)
	local pip = C.PinkDeep
	local back = kit.Part(body, 24, 34, 56, 54, kit.Lighten(C.PinkSoft, 0.45), { Radius = 11, Z = 2, Shade = false })
	kit.Part(back, 44, 12, 11, 40, C.PinkSoft, { Radius = 6, Z = 2, Outline = false, Shade = false })
	local front = kit.Part(body, 14, 44, 56, 54, white, { Radius = 11, Z = 3, Shine = true, Shade = 0.08 })
	for _, p in ipairs({ { 14, 14 }, { 42, 14 }, { 14, 40 }, { 42, 40 } }) do
		local dot = kit.Circle(front, p[1], p[2], 9, 9, pip, 0, 2)
		kit.Circle(dot, 3, 3, 3, 3, C.White, 0.4, 2)
	end
	kit.Heart(front, 28, 27, 13, C.Heart, 0, 2)
	for _, p in ipairs({ { 34, 40 }, { 50, 39 }, { 66, 38 } }) do
		kit.Circle(body, p[1], p[2], 6, 3.4, pip, 0.1, 4)
	end
	kit.Circle(body, 74.5, 56, 3.4, 6, pip, 0.15, 4)
	kit.Circle(body, 74.5, 76, 3.4, 6, pip, 0.15, 4)
	return nil
end

-- Baguette magique : cœur ailé avec un visage, bâton sucre d'orge, étincelles
Art.MagicWand = function(body, kit, _item)
	local C = kit.C
	local pivot, layer = rig(body, kit, 42, 98, 3)
	pivot.Rotation = 14
	local stick = kit.Part(layer, 39, 50, 6, 48, C.White, { Radius = 3, Z = 2 })
	for index = 0, 4 do
		kit.Box(stick, 0.5, 5 + index * 8.5, 5, 3.2, C.Pink, 0.1, 2)
	end
	for _, side in ipairs({ -1, 1 }) do
		kit.Blob(layer, 42 + side * 18, 32, 17, 11, C.White, { Z = 3, Rotation = side * 24, Outline = C.Lilac, Thickness = 1.3 })
		kit.Blob(layer, 42 + side * 20, 38, 12, 8, C.LilacSoft, { Z = 2, Rotation = side * 32, Outline = C.Lilac, Thickness = 1.3 })
	end
	kit.Part(layer, 36, 48, 12, 6, C.Gold, { Radius = 3, Z = 4 })
	heartOutlined(layer, kit, 42, 34, 28, C.Pink, 5)
	kit.Shine(layer, 32, 27, 6, 4, 8)
	kit.Face(layer, 42, 36, 15, { Eyes = "happy", Mouth = "smile", Z = 8 })
	local sparkles = {
		kit.Sparkle(body, 80, 26, 11, C.Butter, 0, 6),
		kit.Sparkle(body, 16, 44, 8, C.Lilac, 0, 6),
		kit.Sparkle(body, 82, 62, 7, C.Pink, 0, 6),
	}
	for index, sparkle in ipairs(sparkles) do
		kit.Animate(sparkle, "Bob", 2, 0.8, index * 1.7)
	end
	kit.Animate(pivot, "Sway", 3, 0.5, 0.1)
	return { Glow = C.PinkSoft }
end

----------------------------------------------------------------------
-- Peluches
----------------------------------------------------------------------

-- Ours en peluche brun : museau, nœud papillon bleu, cœur cousu
Art.TeddyBear = function(body, kit, _item)
	local C = kit.C
	local fur = Color3.fromRGB(205, 150, 105)
	local light = Color3.fromRGB(245, 215, 175)
	local root = breathing(body, kit, 0.012, 0.3)
	local p = plush(root, kit, { Color = fur, Light = light, BodyW = 50, BodyH = 38, HeadY = 38, HeadW = 58, HeadH = 46 })
	for _, side in ipairs({ -1, 1 }) do
		local ear = kit.Blob(p.Head, 50 + side * 22, 19, 19, 18, fur, { Z = 3 })
		kit.Circle(ear, 9.5, 10, 10, 9, light, 0, 2)
	end
	muzzle(p.Head, kit, 50, 49, 22, 15, light, C.Brown, 5)
	kit.Face(p.Head, 50, 38, 32, { Eyes = "dot", Mouth = "none", Z = 6 })
	bow(root, kit, 50, 62, 20, C.Sky, 7)
	kit.Heart(p.Torso, 32, 22, 9, C.Heart, 0, 3)
	kit.Animate(p.Neck, "Sway", 3, 0.6, 0.2)
	return nil
end

-- Lapin blanc : longues oreilles (une qui bouge), carotte dans les bras
Art.BunnyPlush = function(body, kit, _item)
	local C = kit.C
	local fur = Color3.fromRGB(255, 246, 250)
	local root = breathing(body, kit, 0.012, 1.1)
	local p = plush(root, kit, { Color = fur, Light = C.PinkMist, Paw = C.PinkSoft, BodyW = 48, BodyH = 36, HeadY = 46, HeadW = 54, HeadH = 42 })
	local left = kit.Blob(p.Head, 40, 14, 14, 36, fur, { Z = 3, Rotation = -8 })
	kit.Blob(left, 7, 17, 6, 25, C.PinkSoft, { Z = 2, Outline = false, Shade = false })
	local earPivot, ear = rig(p.Head, kit, 59, 30, 3)
	local right = kit.Blob(ear, 62, 14, 14, 36, fur, { Z = 1, Rotation = 12 })
	kit.Blob(right, 7, 17, 6, 25, C.PinkSoft, { Z = 2, Outline = false, Shade = false })
	kit.Face(p.Head, 50, 46, 30, { Eyes = "big", Mouth = "cat", Z = 6 })
	kit.Blob(p.Head, 50, 47.6, 4, 3, C.Pink, { Z = 7, Outline = false, Shade = false })
	-- carotte
	kit.Blob(root, 50, 79, 10, 24, C.Orange, { Z = 4, Rotation = 28, Thickness = 1.3 })
	kit.Blob(root, 57, 66, 6, 11, C.Leaf, { Z = 4, Rotation = 10, Thickness = 1.2 })
	kit.Blob(root, 61, 69, 6, 11, C.Leaf, { Z = 4, Rotation = 55, Thickness = 1.2 })
	kit.Animate(earPivot, "Sway", 6, 0.7, 0.4)
	kit.Animate(p.Neck, "Sway", 2.5, 0.5, 1.3)
	return nil
end

-- Chaton gris tigré : oreilles pointues, moustaches, clochette, queue qui balance
Art.KittyPlush = function(body, kit, _item)
	local C = kit.C
	local fur = Color3.fromRGB(206, 200, 226)
	local stripe = kit.Darken(fur, 0.2)
	local root = breathing(body, kit, 0.012, 2.1)
	local tailPivot, tail = rig(root, kit, 70, 92, 1)
	local tailFrame = kit.Blob(tail, 78, 76, 13, 34, fur, { Z = 1, Rotation = 18 })
	kit.Box(tailFrame, 1, 5, 11, 2.4, stripe, 0, 2)
	kit.Box(tailFrame, 0.5, 11, 12, 2.4, stripe, 0, 2)
	local p = plush(root, kit, { Color = fur, Light = C.Cream, Paw = C.PinkSoft, BodyW = 48, BodyH = 36, HeadY = 42, HeadW = 62, HeadH = 44 })
	point(p.Head, kit, 30, 24, 19, fur, 33, 2, C.PinkSoft)
	point(p.Head, kit, 70, 24, 19, fur, 57, 2, C.PinkSoft)
	for _, s in ipairs({ { 50, 21, 50, 28 }, { 43, 22, 44, 27 }, { 57, 22, 56, 27 } }) do
		kit.Line(p.Head, s[1], s[2], s[3], s[4], 2.4, stripe, 0, 6)
	end
	kit.Face(p.Head, 50, 43, 32, { Eyes = "dot", Mouth = "cat", Z = 6 })
	kit.Blob(p.Head, 50, 45, 4, 3, C.Pink, { Z = 7, Outline = false, Shade = false })
	for _, side in ipairs({ -1, 1 }) do
		kit.Line(p.Head, 50 + side * 21, 45, 50 + side * 30, 43, 1.1, C.Ink, 0.35, 6)
		kit.Line(p.Head, 50 + side * 21, 48, 50 + side * 30, 49, 1.1, C.Ink, 0.35, 6)
	end
	kit.Part(root, 36, 62, 28, 5, C.Pink, { Radius = 3, Z = 7, Shade = false })
	local bell = kit.Blob(root, 50, 68, 8, 8, C.Gold, { Z = 8, Thickness = 1.2 })
	kit.Box(bell, 1.5, 4.5, 5, 1, kit.Darken(C.Gold, 0.3), 0, 2)
	kit.Animate(tailPivot, "Sway", 8, 0.8, 0.7)
	kit.Animate(p.Neck, "Sway", 2.5, 0.5, 2.2)
	return nil
end

-- Chiot crème : oreilles tombantes, tache sur l'œil, langue, collier + médaille
Art.PuppyPlush = function(body, kit, _item)
	local C = kit.C
	local fur = Color3.fromRGB(248, 228, 198)
	local brown = Color3.fromRGB(196, 140, 100)
	local root = breathing(body, kit, 0.012, 3.3)
	local tailPivot, tail = rig(root, kit, 70, 86, 1)
	kit.Blob(tail, 76, 78, 10, 18, brown, { Z = 1, Rotation = 40 })
	local p = plush(root, kit, { Color = fur, Light = C.Cream, Paw = brown, BodyW = 50, BodyH = 38, HeadY = 40, HeadW = 60, HeadH = 46 })
	kit.Circle(p.Head, 60, 37, 14, 13, kit.Lighten(brown, 0.25), 0, 5)
	kit.Blob(p.Head, 50, 55, 7, 9, C.Pink, { Z = 4, Thickness = 1.2 })
	muzzle(p.Head, kit, 50, 48, 22, 14, C.White, C.Ink, 5)
	kit.Face(p.Head, 50, 40, 32, { Eyes = "happy", Mouth = "none", Z = 6 })
	for _, side in ipairs({ -1, 1 }) do
		local earPivot, ear = rig(p.Head, kit, 50 + side * 22, 24, 7)
		kit.Blob(ear, 50 + side * 28, 38, 15, 30, brown, { Z = 1, Rotation = -side * 18 })
		kit.Animate(earPivot, "Sway", 3, 0.6, side)
	end
	kit.Part(root, 35, 63, 30, 6, C.Red, { Radius = 3, Z = 5, Shade = false })
	kit.Blob(root, 50, 70, 8, 8, C.Gold, { Z = 5, Thickness = 1.2 })
	kit.Animate(tailPivot, "Sway", 14, 2.2, 0.1)
	return nil
end

-- Grenouille : gros yeux sur le dessus, grand sourire, petite couronne
Art.FroggyPlush = function(body, kit, _item)
	local C = kit.C
	local fur = Color3.fromRGB(150, 215, 125)
	local root = breathing(body, kit, 0.014, 4.4)
	local p = plush(root, kit, { Color = fur, Light = Color3.fromRGB(228, 246, 190), Paw = kit.Lighten(fur, 0.4), BodyW = 54, BodyH = 32, HeadY = 55, HeadW = 72, HeadH = 40 })
	for _, side in ipairs({ -1, 1 }) do
		kit.Blob(p.Head, 50 + side * 17, 40, 24, 22, fur, { Z = 3 })
	end
	kit.Face(p.Head, 50, 43, 42, { Eyes = "big", Spacing = 0.8, Mouth = "none", Blush = false, Z = 6 })
	for _, side in ipairs({ -1, 1 }) do
		kit.Circle(p.Head, 50 + side * 22, 59, 11, 6, C.Blush, 0.3, 6)
	end
	kit.Line(p.Head, 39, 57, 45, 61, 2, C.Ink, 0, 6)
	kit.Line(p.Head, 45, 61, 55, 61, 2, C.Ink, 0, 6)
	kit.Line(p.Head, 55, 61, 61, 57, 2, C.Ink, 0, 6)
	-- couronne
	for _, x in ipairs({ 43, 50, 57 }) do
		kit.Diamond(p.Head, x, 28, 5, C.Gold, 0, 3)
	end
	kit.Part(p.Head, 42, 28, 16, 7, C.Gold, { Radius = 2, Z = 4 })
	kit.Circle(p.Head, 50, 31.5, 3.5, 3.5, C.PinkDeep, 0, 5)
	kit.Animate(p.Neck, "Sway", 2, 0.5, 4.1)
	return nil
end

-- Dino menthe : piquants roses sur la tête et la queue, ventre rayé, "rawr"
Art.DinoPlush = function(body, kit, _item)
	local C = kit.C
	local fur = Color3.fromRGB(150, 222, 196)
	local root = breathing(body, kit, 0.012, 5.2)
	local tailPivot, tail = rig(root, kit, 66, 90, 1)
	point(tail, kit, 80, 76, 9, C.Pink, 45, 1)
	point(tail, kit, 89, 70, 8, C.Pink, 45, 1)
	kit.Blob(tail, 82, 84, 34, 15, fur, { Z = 2, Rotation = -30 })
	local p = plush(root, kit, { Color = fur, Light = C.Butter, Paw = kit.Darken(fur, 0.15), BodyW = 50, BodyH = 38, HeadY = 40, HeadW = 60, HeadH = 46 })
	kit.Box(p.Torso, 16, 20, 18, 1.6, kit.Darken(C.Butter, 0.15), 0, 3)
	kit.Box(p.Torso, 17, 26, 16, 1.6, kit.Darken(C.Butter, 0.15), 0, 3)
	point(p.Head, kit, 50, 18, 13, C.Pink, 45, 2)
	point(p.Head, kit, 37, 21, 10, C.Pink, 35, 2)
	point(p.Head, kit, 63, 21, 10, C.Pink, 55, 2)
	kit.Face(p.Head, 50, 41, 32, { Eyes = "happy", Mouth = "o", Z = 6 })
	for _, x in ipairs({ 46, 54 }) do
		kit.Circle(p.Head, x, 33, 2, 1.6, kit.Darken(fur, 0.35), 0, 6)
	end
	for _, s in ipairs({ { 30, 49 }, { 70, 49 } }) do
		kit.Circle(p.Head, s[1], s[2] - 20, 5, 5, kit.Darken(fur, 0.1), 0, 5)
	end
	kit.Animate(tailPivot, "Sway", 6, 0.7, 0.9)
	kit.Animate(p.Neck, "Sway", 2.5, 0.5, 5.3)
	return nil
end

-- Hamster tout rond : joues gonflées, graine de tournesol entre les pattes
Art.HamsterPlush = function(body, kit, _item)
	local C = kit.C
	local fur = Color3.fromRGB(250, 196, 132)
	local cream = Color3.fromRGB(255, 244, 228)
	local root = breathing(body, kit, 0.02, 6.1)
	for _, side in ipairs({ -1, 1 }) do
		local ear = kit.Blob(root, 50 + side * 21, 42, 15, 14, fur, { Z = 2 })
		kit.Circle(ear, 7.5, 7.5, 8, 7, C.PinkSoft, 0, 2)
		kit.Blob(root, 50 + side * 12, 97, 12, 6, C.PinkSoft, { Z = 2, Thickness = 1.2 })
	end
	local ball = kit.Blob(root, 50, 69, 72, 58, fur, { Z = 3, Shine = true })
	kit.Blob(ball, 36, 38, 52, 38, cream, { Z = 2, Outline = false, Shade = false })
	kit.Blob(ball, 36, 11, 8, 10, kit.Darken(fur, 0.12), { Z = 2, Outline = false, Shade = false })
	for _, side in ipairs({ -1, 1 }) do
		kit.Blob(ball, 36 + side * 21, 29, 20, 16, cream, { Z = 3, Outline = false, Shade = false })
	end
	kit.Face(root, 50, 60, 32, { Eyes = "dot", Mouth = "cat", Z = 6 })
	kit.Blob(root, 50, 61.4, 4, 3, C.Pink, { Z = 7, Outline = false, Shade = false })
	local seed = kit.Blob(root, 50, 76, 9, 16, C.GreyDark, { Z = 7, Rotation = 12 })
	kit.Box(seed, 2.2, 2.5, 1.4, 11, C.White, 0.25, 2)
	kit.Box(seed, 5.4, 2.5, 1.4, 11, C.White, 0.25, 2)
	for _, side in ipairs({ -1, 1 }) do
		kit.Blob(root, 50 + side * 5.5, 83, 8, 7, fur, { Z = 8, Thickness = 1.2 })
	end
	return nil
end

-- Pingouin : corps en œuf marine, masque en cœur, écharpe rose, ailerons qui saluent
Art.PenguinPlush = function(body, kit, _item)
	local C = kit.C
	local navy = Color3.fromRGB(88, 102, 160)
	local white = Color3.fromRGB(255, 252, 250)
	local root = breathing(body, kit, 0.012, 7.3)
	for _, side in ipairs({ -1, 1 }) do
		kit.Blob(root, 50 + side * 11, 96, 16, 8, C.Orange, { Z = 2, Thickness = 1.2 })
	end
	local flippers = {}
	for _, side in ipairs({ -1, 1 }) do
		local fp, flipper = rig(root, kit, 50 + side * 26, 62, 4)
		kit.Blob(flipper, 50 + side * 30, 74, 12, 26, navy, { Z = 1, Rotation = -side * 28 })
		table.insert(flippers, fp)
	end
	local egg = kit.Blob(root, 50, 62, 58, 72, navy, { Z = 3, Shine = true })
	kit.Blob(egg, 29, 50, 40, 40, white, { Z = 2, Outline = false, Shade = 0.08 })
	for _, side in ipairs({ -1, 1 }) do
		kit.Circle(egg, 29 + side * 7.5, 20, 24, 22, white, 0, 2)
	end
	kit.Face(root, 50, 47, 28, { Eyes = "big", Mouth = "none", Z = 6 })
	kit.Blob(root, 50, 51, 9, 6, C.Orange, { Z = 7, Thickness = 1.2 })
	kit.Part(root, 58, 62, 8, 20, C.Pink, { Radius = 3, Z = 6, Rotation = -10 })
	kit.Part(root, 27, 58, 46, 8, C.Pink, { Radius = 4, Z = 7, Shade = false })
	for _, y in ipairs({ 68, 74 }) do
		kit.Box(root, 59.5 - (y - 68) * 0.2, y, 7, 2, C.PinkSoft, 0, 7).Rotation = -10
	end
	kit.Animate(flippers[1], "Sway", 6, 0.9, 0.2)
	kit.Animate(flippers[2], "Sway", 6, 0.9, 1.9)
	return nil
end

-- Panda : oreilles et taches noires, reflets dans les yeux, tige de bambou
Art.PandaPlush = function(body, kit, _item)
	local C = kit.C
	local white = Color3.fromRGB(252, 250, 252)
	local black = Color3.fromRGB(78, 70, 92)
	local root = breathing(body, kit, 0.012, 8.2)
	-- bambou
	local bamboo = kit.Part(root, 55, 52, 7, 46, C.Leaf, { Radius = 3, Z = 4, Rotation = 34 })
	for _, y in ipairs({ 12, 26 }) do
		kit.Box(bamboo, 0, y, 7, 1.6, C.LeafDark, 0, 2)
	end
	kit.Blob(root, 77, 55, 7, 16, C.Leaf, { Z = 4, Rotation = 70, Thickness = 1.2 })
	kit.Blob(root, 75, 62, 6, 13, C.Leaf, { Z = 4, Rotation = 120, Thickness = 1.2 })
	local p = plush(root, kit, { Color = white, Limb = black, Belly = false, Paw = kit.Lighten(black, 0.25), BodyW = 52, BodyH = 38, HeadY = 40, HeadW = 60, HeadH = 46 })
	kit.Blob(p.Torso, 26, 6, 46, 12, black, { Z = 2, Outline = false, Shade = false })
	for _, side in ipairs({ -1, 1 }) do
		kit.Blob(p.Head, 50 + side * 22, 20, 18, 17, black, { Z = 3 })
		kit.Blob(p.Head, 50 + side * 11, 40, 13, 17, black, { Z = 5, Rotation = side * 32, Outline = false, Shade = false })
		local eye = kit.Circle(p.Head, 50 + side * 10.5, 39, 6, 6.5, white, 0, 6)
		local pupil = kit.Circle(eye, 3.5, 3.6, 4, 4.2, C.Ink, 0, 2)
		kit.Circle(pupil, 1.3, 1.3, 1.6, 1.6, white, 0, 2)
		kit.Circle(p.Head, 50 + side * 18, 50, 8, 5, C.Blush, 0.35, 6)
	end
	kit.Blob(p.Head, 50, 48, 7, 4.5, black, { Z = 6, Outline = false, Shade = false })
	kit.Line(p.Head, 47, 51.5, 50, 53, 1.3, black, 0, 6)
	kit.Line(p.Head, 50, 53, 53, 51.5, 1.3, black, 0, 6)
	kit.Animate(p.Neck, "Sway", 2.5, 0.5, 8.6)
	return nil
end

-- Licorne : corne dorée, frange arc-en-ciel, yeux fermés à cils, sabots lilas
Art.UnicornPlush = function(body, kit, _item)
	local C = kit.C
	local white = Color3.fromRGB(255, 250, 253)
	local rainbow = { C.Pink, C.Butter, C.Mint, C.Sky, C.Lilac }
	local root = breathing(body, kit, 0.012, 9.1)
	local tailPivot, tail = rig(root, kit, 70, 90, 1)
	for index, color in ipairs({ C.Lilac, C.Sky, C.Pink }) do
		kit.Blob(tail, 76 + index * 4, 84 - index * 7, 11, 22, color, { Z = index, Rotation = 30 - index * 6, Thickness = 1.3 })
	end
	local p = plush(root, kit, { Color = white, Light = C.PinkMist, Paw = C.Lilac, BodyW = 48, BodyH = 36, HeadY = 44, HeadW = 54, HeadH = 44 })
	for index, s in ipairs({ { 26, 34, 14 }, { 24, 47, 13 }, { 74, 34, 14 }, { 76, 47, 13 } }) do
		kit.Blob(p.Head, s[1], s[2], s[3], s[3], rainbow[index + 1], { Z = 3, Thickness = 1.3 })
	end
	point(p.Head, kit, 33, 25, 13, white, 30, 2, C.PinkSoft)
	point(p.Head, kit, 67, 25, 13, white, 60, 2, C.PinkSoft)
	for index, s in ipairs({ { 38, 27, 12 }, { 46, 25, 11 }, { 58, 25, 11 }, { 64, 29, 9 } }) do
		kit.Blob(p.Head, s[1], s[2], s[3], s[3], rainbow[index], { Z = 5, Thickness = 1.3 })
	end
	-- corne torsadée (3 boules dorées empilées)
	kit.Blob(p.Head, 50, 21, 13, 9, C.Butter, { Z = 6, Thickness = 1.3 })
	kit.Blob(p.Head, 50, 14.5, 10, 8, C.Butter, { Z = 7, Thickness = 1.3 })
	kit.Blob(p.Head, 50, 8.5, 6.5, 7, C.Butter, { Z = 8, Thickness = 1.3, Shine = true })
	kit.Face(p.Head, 50, 42, 30, { Eyes = "closed", Mouth = "none", Z = 6 })
	for _, side in ipairs({ -1, 1 }) do
		local ex = 50 + side * 14.8
		kit.Line(p.Head, ex + side * 3.5, 39.6, ex + side * 5.5, 37.4, 1.2, C.Ink, 0, 6)
	end
	local snout = kit.Blob(p.Head, 50, 53, 22, 11, Color3.fromRGB(255, 236, 244), { Z = 5, Thickness = 1.2, Shade = false })
	kit.Line(snout, 9, 5.5, 12, 8, 1.3, C.Ink, 0, 2)
	kit.Line(snout, 12, 8, 15, 5.5, 1.3, C.Ink, 0, 2)
	local sparkle = kit.Sparkle(root, 76, 12, 10, C.Butter, 0, 8)
	kit.Animate(sparkle, "Bob", 2, 0.7, 0.3)
	kit.Animate(tailPivot, "Sway", 6, 0.6, 9.4)
	kit.Animate(p.Neck, "Sway", 2.5, 0.5, 9.2)
	return nil
end

-- Gros ours géant couleur miel : grand nœud rose, coussin cœur dans les bras
Art.BigBear = function(body, kit, _item)
	local C = kit.C
	local fur = Color3.fromRGB(240, 196, 140)
	local light = Color3.fromRGB(255, 236, 205)
	local root = breathing(body, kit, 0.01, 10.4)
	local p = plush(root, kit, { Color = fur, Light = light, BodyW = 58, BodyH = 42, HeadY = 36, HeadW = 64, HeadH = 50 })
	for _, side in ipairs({ -1, 1 }) do
		local ear = kit.Blob(p.Head, 50 + side * 25, 15, 21, 20, fur, { Z = 3 })
		kit.Circle(ear, 10.5, 11, 11, 10, light, 0, 2)
	end
	muzzle(p.Head, kit, 50, 47, 24, 16, light, C.Brown, 5)
	kit.Face(p.Head, 50, 36, 36, { Eyes = "happy", Mouth = "none", Z = 6 })
	bow(p.Head, kit, 71, 16, 18, C.Pink, 7)
	-- coussin cœur tenu contre le ventre
	heartOutlined(root, kit, 50, 78, 24, C.Heart, 4)
	kit.Shine(root, 42, 71, 5, 3, 6)
	kit.Part(root, 31, 58, 38, 6, C.PinkSoft, { Radius = 3, Z = 7, Shade = false })
	kit.Animate(p.Neck, "Sway", 2, 0.45, 10.2)
	return nil
end

----------------------------------------------------------------------
-- Jouets moyens
----------------------------------------------------------------------

-- Cerf-volant arc-en-ciel avec visage, queue à nœuds qui ondule
Art.Kite = function(body, kit, _item)
	local C = kit.C
	local pivot, layer = rig(body, kit, 50, 40, 2)
	local tailPivot, tail = rig(layer, kit, 50, 74, 1)
	kit.Line(tail, 50, 74, 44, 83, 1.3, C.Ink, 0.3, 1)
	kit.Line(tail, 44, 83, 54, 91, 1.3, C.Ink, 0.3, 1)
	kit.Line(tail, 54, 91, 46, 99, 1.3, C.Ink, 0.3, 1)
	bow(tail, kit, 44, 83, 11, C.Pink, 2)
	bow(tail, kit, 54, 91, 10, C.Mint, 2)
	bow(tail, kit, 46, 99, 9, C.Lilac, 2)
	local sail = kit.Part(layer, 25, 15, 50, 50, C.White, { Radius = 6, Z = 3, Rotation = 45, Shade = false, Outline = C.Ink, Thickness = 1.8 })
	local grad = kit.Gradient(sail, C.White, C.White, 45)
	local bands = { C.Pink, C.Peach, C.Butter, C.Mint, C.Sky, C.Lilac }
	local keys = {}
	for index, color in ipairs(bands) do
		local t0 = (index - 1) / #bands
		local t1 = index / #bands
		table.insert(keys, ColorSequenceKeypoint.new(if index == 1 then 0 else t0 + 0.01, color))
		table.insert(keys, ColorSequenceKeypoint.new(if index == #bands then 1 else t1 - 0.01, color))
	end
	grad.Color = ColorSequence.new(keys)
	kit.Line(layer, 50, 8, 50, 72, 1.4, C.White, 0.45, 4)
	kit.Line(layer, 18, 40, 82, 40, 1.4, C.White, 0.45, 4)
	kit.Face(layer, 50, 44, 22, { Eyes = "dot", Mouth = "smile", Z = 5 })
	kit.Shine(layer, 38, 22, 8, 4, 5).Rotation = -45
	kit.Animate(pivot, "Sway", 4, 0.5, 0.2)
	kit.Animate(tailPivot, "Sway", 9, 0.9, 0.8)
	return { WallShadow = Vector2.new(0.55, 0.7) }
end

-- Robot jouet : écran-visage lumineux, antenne qui clignote, bras qui saluent
Art.ToyRobot = function(body, kit, _item)
	local C = kit.C
	local metal = Color3.fromRGB(170, 210, 245)
	for _, x in ipairs({ 36, 54 }) do
		kit.Part(body, x, 80, 10, 12, C.Grey, { Radius = 2, Z = 1 })
		kit.Part(body, x - 3, 90, 16, 8, kit.Darken(metal, 0.08), { Radius = 4, Z = 2 })
	end
	local arms = {}
	for _, side in ipairs({ -1, 1 }) do
		local ap, arm = rig(body, kit, 50 + side * 22, 60, 2)
		kit.Part(arm, 50 + side * 24 - 4, 58, 8, 18, C.Grey, { Radius = 4, Z = 1 })
		kit.Blob(arm, 50 + side * 24, 79, 11, 10, C.Butter, { Z = 2 })
		table.insert(arms, ap)
	end
	local torso = kit.Part(body, 27, 55, 46, 32, metal, { Radius = 9, Z = 3, Shine = true })
	local panel = kit.Part(torso, 10, 8, 26, 17, C.Cream, { Radius = 5, Z = 2, Thickness = 1.2 })
	kit.Heart(panel, 8, 8.5, 9, C.Heart, 0, 2)
	kit.Circle(panel, 17.5, 6, 4, 4, C.Mint, 0, 2)
	kit.Circle(panel, 17.5, 12, 4, 4, C.Butter, 0, 2)
	kit.Box(body, 45, 50, 10, 6, C.Grey, 0, 2)
	for _, side in ipairs({ -1, 1 }) do
		kit.Part(body, 50 + side * 26 - 3, 30, 6, 12, C.Pink, { Radius = 3, Z = 3 })
	end
	local head = kit.Part(body, 25, 18, 50, 36, metal, { Radius = 11, Z = 4, Shine = true })
	local screen = kit.Part(head, 6, 6, 38, 24, C.Navy, { Radius = 7, Z = 2, Thickness = 1.3 })
	kit.Face(screen, 19, 13, 24, { Eyes = "big", Mouth = "smile", Color = C.Mint, Z = 3 })
	kit.Line(body, 50, 18, 50, 9, 2, C.GreyDark, 0, 2)
	local bulb = kit.Blob(body, 50, 7, 9, 9, C.Heart, { Z = 3, Thickness = 1.2 })
	kit.Circle(bulb, 3, 3, 2.5, 2.5, C.White, 0.2, 2)
	kit.Animate(bulb, "Pulse", 0.5, 0.8, 0.3)
	kit.Animate(arms[1], "Sway", 8, 0.7, 0.4)
	kit.Animate(arms[2], "Sway", 8, 0.7, 2.1)
	return nil
end

-- Tambour : peau crème, cerclages dorés, cordage en zigzag, baguettes qui tapent
Art.ToyDrum = function(body, kit, _item)
	local C = kit.C
	local shell = Color3.fromRGB(255, 150, 175)
	kit.Part(body, 14, 50, 72, 42, shell, { Radius = 8, Z = 2, Shine = true, Shade = 0.16 })
	kit.Part(body, 12, 86, 76, 11, C.Gold, { Radius = 5, Z = 4 })
	kit.Blob(body, 50, 50, 76, 22, C.Gold, { Z = 3 })
	kit.Blob(body, 50, 49, 66, 15, C.Cream, { Z = 4, Shade = false, Thickness = 1.3 })
	local xs = { 20, 30, 40, 50, 60, 70, 80 }
	for index = 1, #xs - 1 do
		local y1 = if index % 2 == 1 then 60 else 85
		local y2 = if index % 2 == 1 then 85 else 60
		kit.Line(body, xs[index], y1, xs[index + 1], y2, 2.2, C.White, 0.05, 3)
	end
	for index, side in ipairs({ -1, 1 }) do
		local sp, stick = rig(body, kit, 50 + side * 12, 50, 6)
		kit.Line(stick, 50 + side * 12, 50, 50 + side * 32, 24, 3, C.WoodLight, 0, 1)
		kit.Blob(stick, 50 + side * 32, 24, 8, 8, if side < 0 then C.Pink else C.Sky, { Z = 2 })
		kit.Animate(sp, "Sway", 7, 1.4, index * 1.6)
	end
	return nil
end

-- Poupées russes : 3 poupées pastel de tailles différentes, visages variés
local function doll(parent, kit, cx, h, color, eyes, z)
	local C = kit.C
	local w = h * 0.62
	local g = kit.Group(parent, 0, 0, 100, 100, z)
	local bodyH = h * 0.7
	kit.Blob(g, cx, 98 - bodyH / 2, w, bodyH, color, { Z = 3, Shine = true })
	local headD = w * 0.82
	local headCy = 98 - h + headD / 2
	kit.Blob(g, cx, headCy, headD, headD, color, { Z = 2 })
	local face = kit.Blob(g, cx, headCy + headD * 0.08, headD * 0.66, headD * 0.58, C.Cream, { Z = 4, Thickness = 1.2, Shade = false })
	kit.Blob(face, headD * 0.33, headD * 0.08, headD * 0.5, headD * 0.22, C.WoodDark, { Z = 2, Outline = false, Shade = false })
	kit.Face(g, cx, headCy + headD * 0.14, headD * 0.5, { Eyes = eyes, Z = 6 })
	kit.Blob(g, cx, 98 - bodyH * 0.4, w * 0.6, bodyH * 0.56, C.Cream, { Z = 4, Thickness = 1.2, Shade = false })
	-- fleur sur le tablier
	local flower = kit.Circle(g, cx, 98 - bodyH * 0.42, w * 0.3, w * 0.3, color, 0, 5)
	kit.Circle(flower, w * 0.15, w * 0.15, w * 0.12, w * 0.12, C.Butter, 0, 2)
	return g
end

Art.NestingDolls = function(body, kit, _item)
	local C = kit.C
	local big = doll(body, kit, 30, 70, C.Pink, "dot", 2)
	local mid = doll(body, kit, 63, 52, C.Lilac, "happy", 3)
	local small = doll(body, kit, 87, 36, C.Mint, "closed", 4)
	kit.Animate(big, "Sway", 1.5, 0.6, 0.1)
	kit.Animate(mid, "Sway", 2, 0.7, 1.4)
	kit.Animate(small, "Sway", 2.5, 0.8, 2.7)
	return nil
end

-- Guitare rose appuyée : caisse en 8, rosace, manche, cordes, sticker cœur
Art.PinkGuitar = function(body, kit, _item)
	local C = kit.C
	local pink = Color3.fromRGB(255, 160, 200)
	local pivot, layer = rig(body, kit, 50, 98, 2)
	pivot.Rotation = 10
	kit.Blob(layer, 50, 56, 34, 30, pink, { Z = 2, Shade = false })
	kit.Blob(layer, 50, 79, 46, 38, pink, { Z = 3, Shade = false, Shine = true })
	kit.Box(layer, 36, 60, 28, 10, pink, 0, 4)
	kit.Blob(layer, 50, 67, 15, 15, C.Cream, { Z = 5, Thickness = 1.3 })
	kit.Circle(layer, 50, 67, 10, 10, kit.OutlineOf(pink), 0, 6)
	kit.Part(layer, 46.5, 6, 7, 52, C.WoodLight, { Radius = 2, Z = 7, Shade = false })
	for _, y in ipairs({ 18, 30, 42 }) do
		kit.Box(layer, 46.5, y, 7, 1.2, C.Gold, 0, 8)
	end
	kit.Part(layer, 43, -4, 14, 14, C.PinkDeep, { Radius = 4, Z = 8 })
	for _, s in ipairs({ { 41, -1 }, { 41, 5 }, { 59, -1 }, { 59, 5 } }) do
		kit.Circle(layer, s[1], s[2], 4, 4, C.Butter, 0, 7)
	end
	kit.Part(layer, 41, 84, 18, 5, C.WoodDark, { Radius = 2, Z = 7 })
	for _, x in ipairs({ 48, 50, 52 }) do
		kit.Line(layer, x, 4, x, 86, 0.7, C.White, 0.1, 9)
	end
	kit.Heart(layer, 62, 82, 9, C.White, 0, 6)
	kit.Sparkle(layer, 36, 88, 6, C.White, 0.1, 6)
	return nil
end


R.CatSofa = function(b, ctx)
	sofa(b, ctx, 36, 100, 3)
	local color = accent(b, 1, rgb(255, 190, 150))
	local seat = ctx.TopY(1, 36)
	for _, side in ipairs({ -1, 1 }) do

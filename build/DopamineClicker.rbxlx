-- Grands jouets
----------------------------------------------------------------------

-- Cheval à bascule en bois : crinière rose, selle rouge, bascule qui berce
Art.RockingHorse = function(body, kit, _item)
	local C = kit.C
	local pivot, layer = rig(body, kit, 50, 95, 2)
	local wood = Color3.fromRGB(236, 196, 150)
	local rocker = { { 5, 78 }, { 20, 88 }, { 50, 93 }, { 80, 88 }, { 95, 78 } }
	horse(layer, kit, {
		X = 48,
		Y = 50,
		K = 1,
		Coat = wood,
		Mane = { C.Pink, C.PinkSoft, C.Lilac },
		Saddle = C.Red,
		Blanket = C.Sky,
		Hoof = C.WoodDark,
		Legs = {
			{ -10, 8, -24, 38, nil, nil, true },
			{ 12, 8, 26, 38, nil, nil, true },
			{ -14, 8, -28, 37 },
			{ 16, 8, 30, 37 },
		},
	})
	for index = 1, #rocker - 1 do
		local a, b = rocker[index], rocker[index + 1]
		kit.Line(layer, a[1], a[2], b[1], b[2], 6, C.WoodDark, 0, 4)
	end
	kit.Circle(layer, 5, 78, 7, 7, C.Pink, 0, 5)
	kit.Circle(layer, 95, 78, 7, 7, C.Pink, 0, 5)
	kit.Line(layer, 66, 20, 76, 26, 2.6, C.Gold, 0, 8)
	kit.Animate(pivot, "Sway", 4, 0.7, 0.2)
	return nil
end

-- Train à vapeur : locomotive souriante, wagon de cubes, roues qui tournent, fumée
Art.ToyTrain = function(body, kit, _item)
	local C = kit.C
	local wheels = {}
	local function wheel(cx, cy, d, color)
		local w = kit.Blob(body, cx, cy, d, d, color, { Z = 6, Shade = false })
		kit.Line(w, d * 0.18, d / 2, d * 0.82, d / 2, 1.6, C.White, 0.2, 2)
		kit.Line(w, d / 2, d * 0.18, d / 2, d * 0.82, 1.6, C.White, 0.2, 2)
		kit.Circle(w, d / 2, d / 2, d * 0.32, d * 0.32, C.Butter, 0, 3)
		table.insert(wheels, w)
	end
	-- wagon de cubes
	kit.Part(body, 5, 51, 11, 11, C.Mint, { Radius = 2, Z = 2, Rotation = -8 })
	kit.Part(body, 15, 47, 12, 12, C.Pink, { Radius = 2, Z = 2, Rotation = 10 })
	kit.Part(body, 25, 53, 9, 9, C.Sky, { Radius = 2, Z = 2, Rotation = -4 })
	kit.Part(body, 2, 60, 34, 22, C.Butter, { Radius = 5, Z = 3, Shine = true })
	kit.Box(body, 34, 78, 8, 3, C.GreyDark, 0, 2)
	-- locomotive
	kit.Part(body, 38, 80, 60, 6, C.Navy, { Radius = 3, Z = 3 })
	kit.Part(body, 62, 54, 34, 28, C.Sky, { Radius = 12, Z = 3, Shine = true })
	for _, x in ipairs({ 70, 86 }) do
		kit.Box(body, x, 55, 2.5, 26, C.Gold, 0, 4)
	end
	kit.Part(body, 80, 38, 10, 18, C.GreyDark, { Radius = 2, Z = 2 })
	kit.Part(body, 76, 33, 18, 7, C.GreyDark, { Radius = 3, Z = 3 })
	kit.Blob(body, 73, 54, 10, 7, C.Gold, { Z = 2 })
	kit.Part(body, 92, 78, 8, 10, C.Red, { Radius = 2, Z = 4, Rotation = -12 })
	kit.Part(body, 40, 40, 26, 44, C.Pink, { Radius = 5, Z = 4, Shine = true })
	kit.Part(body, 45, 46, 16, 13, C.Glass, { Radius = 4, Z = 5, Thickness = 1.3 })
	kit.Part(body, 37, 34, 32, 8, C.PinkDeep, { Radius = 4, Z = 6 })
	kit.Face(body, 79, 67, 18, { Eyes = "happy", Mouth = "smile", Z = 5 })
	wheel(53, 87, 20, C.PinkDeep)
	wheel(76, 90, 14, C.PinkDeep)
	wheel(90, 90, 14, C.PinkDeep)
	wheel(12, 88, 14, C.Lilac)
	wheel(27, 88, 14, C.Lilac)
	for _, w in ipairs(wheels) do
		kit.Animate(w, "Spin", 0, 0.3, 0)
	end
	local puffs = { kit.Cloud(body, 86, 30, 16, C.White, 0.1, 7), kit.Cloud(body, 76, 18, 12, C.White, 0.3, 7) }
	kit.Animate(puffs[1], "Bob", 2, 0.8, 0.3)
	kit.Animate(puffs[2], "Drift", 3, 0.6, 1.2)
	return nil
end

-- Fort en couverture : couverture à pois sur 2 chaises, guirlande lumineuse,
-- petits yeux qui brillent dans le noir, drapeau, coussins
Art.BlanketFort = function(body, kit, _item)
	local C = kit.C
	local blanket = Color3.fromRGB(255, 188, 214)
	for _, x in ipairs({ 3, 85 }) do
		kit.Part(body, x, 20, 12, 78, C.WoodLight, { Radius = 4, Z = 1 })
		kit.Circle(body, x + 6, 20, 9, 9, C.Wood, 0, 1)
	end
	local tent = kit.Group(body, 6, 24, 88, 74, 2, true)
	kit.Part(tent, 2, 2, 84, 120, blanket, { Radius = 30, Z = 1, Shade = 0.1 })
	for _, d in ipairs({ { 18, 18 }, { 44, 10 }, { 70, 18 }, { 12, 46 }, { 76, 46 }, { 20, 64 }, { 68, 64 } }) do
		kit.Circle(tent, d[1], d[2], 7, 7, C.White, 0.25, 2)
	end
	local door = kit.Part(tent, 27, 28, 34, 60, C.Navy, { Radius = 16, Z = 3, Shade = false })
	kit.Gradient(door, Color3.fromRGB(150, 130, 200), Color3.fromRGB(255, 220, 190), 90)
	kit.Face(tent, 44, 50, 20, { Eyes = "dot", Mouth = "none", Blush = false, Color = C.Butter, Z = 4 })
	kit.Blob(tent, 26, 56, 14, 58, kit.Lighten(blanket, 0.35), { Z = 5, Rotation = 12 })
	kit.Blob(tent, 62, 56, 14, 58, kit.Lighten(blanket, 0.35), { Z = 5, Rotation = -12 })
	kit.Part(body, 6, 90, 88, 8, C.PinkDeep, { Radius = 3, Z = 3, Shade = false })
	-- guirlande lumineuse
	local pts = { { 9, 30 }, { 29, 40 }, { 50, 43 }, { 71, 40 }, { 91, 30 } }
	for index = 1, #pts - 1 do
		kit.Line(body, pts[index][1], pts[index][2], pts[index + 1][1], pts[index + 1][2], 1, C.Ink, 0.4, 6)
	end
	local bulbs = {}
	local colors = { C.Butter, C.Mint, C.Sky, C.Lilac, C.Butter }
	for index, pt in ipairs({ { 19, 36 }, { 39, 42 }, { 50, 44.5 }, { 61, 42 }, { 81, 36 } }) do
		local halo = kit.Circle(body, pt[1], pt[2] + 3, 11, 11, colors[index], 0.6, 6)
		local bulb = kit.Blob(body, pt[1], pt[2] + 3, 5, 6.5, colors[index], { Z = 7, Thickness = 1 })
		table.insert(bulbs, bulb)
		table.insert(bulbs, halo)
	end
	-- drapeau
	kit.Line(body, 50, 25, 50, 6, 1.8, C.WoodDark, 0, 3)
	local flagPivot, flag = rig(body, kit, 50, 7, 3)
	kit.Part(flag, 50, 5, 15, 10, C.Mint, { Radius = 2, Z = 1 })
	kit.Heart(flag, 57.5, 10, 6, C.White, 0, 2)
	-- coussins
	kit.Blob(body, 16, 92, 24, 13, C.Lilac, { Z = 8, Shine = true })
	kit.Blob(body, 84, 93, 22, 11, C.Butter, { Z = 8, Shine = true })
	kit.Animate(flagPivot, "Sway", 7, 0.9, 0.2)
	return { Glow = C.Butter, Bulbs = bulbs }
end

-- Château de poupée : donjon rose, 2 tourelles à toit pointu, drapeaux, porte en arche
Art.DollCastle = function(body, kit, _item)
	local C = kit.C
	local wall = Color3.fromRGB(255, 214, 230)
	local tower = Color3.fromRGB(236, 224, 255)
	-- tour centrale (derrière)
	kit.Part(body, 39, 22, 22, 24, wall, { Radius = 3, Z = 1 })
	kit.Triangle(body, 50, 4, 28, 20, C.Pink, 1, 0, 6)
	kit.Circle(body, 50, 4, 5, 5, C.Gold, 0, 2)
	-- donjon
	for index = 0, 3 do
		kit.Part(body, 26 + index * 13, 34, 9, 10, wall, { Radius = 2, Z = 2 })
	end
	local keep = kit.Part(body, 24, 40, 52, 58, wall, { Radius = 4, Z = 3, Shade = 0.1 })
	local door = kit.Part(keep, 17, 34, 18, 24, C.WoodDark, { Radius = 9, Z = 2 })
	kit.Circle(door, 13, 14, 3, 3, C.Gold, 0, 2)
	kit.Heart(keep, 26, 26, 8, C.Heart, 0, 2)
	local window = kit.Part(keep, 19, 7, 14, 12, C.Sky, { Radius = 6, Z = 2, Thickness = 1.3 })
	kit.Box(window, 6.3, 0, 1.4, 12, C.White, 0.2, 2)
	-- tourelles
	for _, s in ipairs({ { 6, 1 }, { 72, -1 } }) do
		local x = s[1]
		local t = kit.Part(body, x, 38, 22, 60, tower, { Radius = 4, Z = 4, Shine = true })
		kit.Part(t, 7, 12, 8, 13, C.Sky, { Radius = 4, Z = 2, Thickness = 1.2 })
		kit.Part(t, 7, 34, 8, 11, C.Sky, { Radius = 4, Z = 2, Thickness = 1.2 })
		kit.Triangle(body, x + 11, 12, 30, 26, C.Pink, 5, 0, 9)
		kit.Part(body, x - 3, 35, 28, 6, C.PinkDeep, { Radius = 3, Z = 6 })
		kit.Line(body, x + 11, 12, x + 11, 2, 1.4, C.GreyDark, 0, 5)
		local fp, flag = rig(body, kit, x + 11, 3, 6)
		kit.Part(flag, x + 11, 1, 10, 6, if x < 50 then C.Mint else C.Butter, { Radius = 1.5, Z = 1 })
		kit.Animate(fp, "Sway", 6, 0.9, x * 0.1)
	end
	kit.Part(body, 20, 94, 60, 5, C.Leaf, { Radius = 2.5, Z = 7 })
	for _, x in ipairs({ 22, 36, 64, 78 }) do
		kit.Circle(body, x, 94, 5, 5, if x < 50 then C.Pink else C.Butter, 0, 8)
	end
	return nil
end

-- Cheval de manège : cheval blanc sur une barre torsadée qui monte et descend
Art.CarouselHorse = function(body, kit, _item)
	local C = kit.C
	-- socle et toit
	kit.Part(body, 22, 86, 56, 12, C.PinkSoft, { Radius = 5, Z = 5, Shine = true })
	kit.Part(body, 20, 84, 60, 5, C.Gold, { Radius = 2.5, Z = 6 })
	for _, x in ipairs({ 32, 50, 68 }) do
		kit.Circle(body, x, 92, 4, 4, C.Heart, 0, 6)
	end
	kit.Part(body, 33, 0, 34, 7, C.Pink, { Radius = 3.5, Z = 5 })
	kit.Circle(body, 50, -2, 7, 7, C.Gold, 0, 4)
	-- barre torsadée
	local pole = kit.Part(body, 47.5, 5, 5, 81, C.Gold, { Radius = 2, Z = 4, Shade = false })
	pole.ClipsDescendants = true
	for index = 0, 9 do
		kit.Box(pole, -2, 2 + index * 8, 9, 2.6, C.White, 0.1, 2).Rotation = -30
	end
	-- cheval
	local g = kit.Group(body, 0, 0, 100, 100, 3)
	horse(g, kit, {
		X = 46,
		Y = 50,
		K = 1.1,
		Coat = Color3.fromRGB(255, 252, 250),
		Mane = { C.Lilac, C.Pink, C.Sky },
		Saddle = C.Heart,
		Blanket = C.Butter,
		Hoof = C.Gold,
		Legs = {
			{ -12, 6, -24, 20, -34, 24, true },
			{ 12, 6, 24, 10, 26, 22, true },
			{ -16, 6, -26, 18, -36, 20 },
			{ 16, 6, 28, 14, 24, 25 },
		},
	})
	kit.Heart(g, 41, 44, 7, C.White, 0, 7)
	kit.Animate(g, "Bob", 3, 0.6, 0.4)
	return nil
end

-- Fusée jouet : nez rose, hublot avec visage, ailerons, flamme qui vacille
Art.ToyRocket = function(body, kit, _item)
	local C = kit.C
	local flame = kit.Blob(body, 50, 88, 20, 22, C.Orange, { Z = 1, Outline = false, Shade = false })
	kit.Fade(flame, 0, 0.3, 90)
	local core = kit.Blob(body, 50, 86, 11, 14, C.Butter, { Z = 2, Outline = false, Shade = false })
	kit.Animate(flame, "Flicker", 0.35, 1, 0.1)
	kit.Animate(core, "Flicker", 0.3, 1.2, 0.8)
	local g = kit.Group(body, 0, 0, 100, 100, 3)
	for _, side in ipairs({ -1, 1 }) do
		kit.Part(g, 50 + side * 18 - 6, 56, 12, 26, C.Pink, { Radius = 5, Z = 1, Rotation = side * 22 })
	end
	kit.Part(g, 40, 78, 20, 7, C.GreyDark, { Radius = 3, Z = 1 })
	kit.Part(g, 32, 10, 36, 72, C.White, { Radius = -1, Z = 2, Shine = true, Shade = 0.1 })
	local nose = kit.Group(g, 29, 8, 42, 26, 3, true)
	kit.Part(nose, 3, 2, 36, 72, C.Pink, { Radius = -1, Z = 1, Shade = 0.1 })
	kit.Part(g, 31, 32, 38, 5, C.PinkDeep, { Radius = 2.5, Z = 4 })
	kit.Blob(g, 50, 51, 22, 22, C.Grey, { Z = 4 })
	local glass = kit.Blob(g, 50, 51, 16, 16, C.Sky, { Z = 5, Thickness = 1.2 })
	kit.Face(glass, 8, 8.5, 12, { Eyes = "happy", Mouth = "smile", Z = 3 })
	kit.Shine(glass, 3, 2.5, 5, 3, 4)
	kit.Heart(g, 50, 68, 8, C.Heart, 0, 4)
	kit.Part(g, 47, 70, 6, 14, C.PinkDeep, { Radius = 3, Z = 5 })
	local sparkles = { kit.Sparkle(body, 16, 22, 10, C.Butter, 0, 6), kit.Sparkle(body, 84, 36, 8, C.Lilac, 0, 6), kit.Sparkle(body, 20, 66, 6, C.Sky, 0, 6) }
	for index, s in ipairs(sparkles) do
		kit.Animate(s, "Bob", 2, 0.7, index * 1.3)
	end
	kit.Animate(g, "Bob", 1.5, 0.9, 0.2)
	return { Glow = C.Orange }
end

-- Grande roue : roue qui tourne (nacelles qui restent droites), lumières, pied en A
Art.FerrisWheel = function(body, kit, _item)
	local C = kit.C
	local cx, cy, radius = 50, 42, 34
	kit.Part(body, 14, 90, 72, 9, C.Pink, { Radius = 4, Z = 1, Shine = true })
	local wheel = kit.Pivot(body, cx, cy, 2)
	kit.Part(wheel, -radius, -radius, radius * 2, radius * 2, C.White, { Radius = -1, T = 1, Outline = C.Pink, Thickness = 3.4, Shade = false, Z = 2 })
	kit.Part(wheel, -22, -22, 44, 44, C.White, { Radius = -1, T = 1, Outline = C.PinkSoft, Thickness = 2, Shade = false, Z = 2 })
	for _, a in ipairs({ 0, 45, 90, 135 }) do
		local r = math.rad(a)
		kit.Line(wheel, -math.cos(r) * radius, -math.sin(r) * radius, math.cos(r) * radius, math.sin(r) * radius, 1.6, C.Lilac, 0.1, 1)
	end
	local bulbs = {}
	local colors = { C.Pink, C.Mint, C.Butter, C.Sky, C.Lilac, C.Peach }
	for index = 0, 5 do
		local r = math.rad(index * 60 + 30)
		local bx, by = math.cos(r) * radius, math.sin(r) * radius
		local halo = kit.Circle(wheel, bx, by, 9, 9, C.Butter, 0.6, 3)
		local bulb = kit.Circle(wheel, bx, by, 4.5, 4.5, C.Butter, 0, 4)
		table.insert(bulbs, bulb)
		table.insert(bulbs, halo)
	end
	-- pied en A (devant la roue)
	kit.Line(body, cx, cy, 24, 92, 5, C.LilacSoft, 0, 3)
	kit.Line(body, cx, cy, 76, 92, 5, C.LilacSoft, 0, 3)
	kit.Line(body, 33, 72, 67, 72, 3, C.LilacSoft, 0, 3)
	for index = 0, 5 do
		local r = math.rad(index * 60 + 90)
		local gp = kit.Pivot(wheel, math.cos(r) * radius, math.sin(r) * radius, 5)
		local color = colors[index + 1]
		kit.Line(gp, 0, 0, 0, 3, 1.4, C.GreyDark, 0, 1)
		kit.Part(gp, -7, 3, 14, 12, color, { Radius = 4, Z = 2 })
		kit.Part(gp, -8, 1, 16, 5, kit.Darken(color, 0.12), { Radius = 2.5, Z = 3 })
		kit.Part(gp, -4, 7, 8, 4, C.Glass, { Radius = 2, Z = 3, Outline = false })
		kit.Animate(gp, "Spin", 0, -0.04, 0)
	end
	local hub = kit.Blob(body, cx, cy, 13, 13, C.Butter, { Z = 6 })
	kit.Heart(hub, 6.5, 6.5, 7, C.Heart, 0, 2)
	kit.Animate(wheel, "Spin", 0, 0.04, 0)
	return { Glow = C.Butter, Bulbs = bulbs }
end

return Art
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="36">
              <Properties>
                <string name="Name">Windows</string>
                <string name="Source"><![CDATA[--[[
	Windows (ModuleScript) — dessins des fenêtres 🪟
	Emplacement : ReplicatedStorage > Client > Components > House > Art > Windows
	Contrat : voir HouseArt (boîte 100 x 100, objets muraux centrés).
	Chaque fenêtre = cadre + rebord (+ rideaux) et une VUE dessinée dans un
	groupe découpé (clip) : nuages, pluie, coucher de soleil, océan, ville...
]]

local Art = {}

local WHITE = Color3.new(1, 1, 1)

----------------------------------------------------------------------
-- Aides partagées
----------------------------------------------------------------------

-- Couleur prolongée au-delà de `bottom` (pour un dégradé plus haut que la vitre)
local function extend(top: Color3, bottom: Color3, k: number): Color3
	return Color3.new(
		math.clamp(top.R + (bottom.R - top.R) * k, 0, 1),
		math.clamp(top.G + (bottom.G - top.G) * k, 0, 1),
		math.clamp(top.B + (bottom.B - top.B) * k, 0, 1)
	)
end

-- Rideaux noués de part et d'autre (tringle + 2 pans + embrasses)
local function curtains(body, kit, x, y, w, h, fw, color, tie, rod)
	local rodY = y - fw - 5
	local left, right = x - fw - 10, x + w + fw + 10
	kit.Part(body, left, rodY, right - left, 4, rod, { Radius = -1, Z = 9, Shade = false })
	for _, px in ipairs({ left, right }) do
		kit.Circle(body, px, rodY + 2, 7, 7, rod, 0, 9)
	end
	local tieY = y + h * 0.55
	local bottom = y + h + 5
	for _, side in ipairs({ -1, 1 }) do
		local cx = if side < 0 then x - fw + 1 else x + w + fw - 1
		kit.Part(body, cx - 7, rodY + 1, 14, tieY - rodY + 2, color, { Radius = 5, Z = 10, Shade = 0.08 })
		kit.Line(body, cx + side * 1.5, rodY + 5, cx + side * 1, tieY - 4, 1.3, kit.Darken(color, 0.14), 0.25, 11)
		kit.Blob(body, cx + side * 2.5, (tieY + bottom) / 2, 17, bottom - tieY + 4, color, { Z = 11, Shade = 0.1 })
		kit.Part(body, cx - 9, tieY - 3, 18, 6, tie, { Radius = -1, Z = 12 })
	end
end

-- Fenêtre : cadre (rectangle ou arche), vitre avec VUE découpée, reflets,
-- croisillon, rebord et rideaux. Renvoie la vue (coordonnées locales w x h).
-- o = { X, Y, W, H, Arch, Radius, Frame, Border, Sky = { haut, bas }, Cross,
--       Curtain, Tie, Rod, Sill }
local function window(body, kit, o)
	local C = kit.C
	local x, y, w, h = o.X or 22, o.Y or 16, o.W or 56, o.H or 58
	local arch = o.Arch == true
	local r = if arch then w / 2 else (o.Radius or 5)
	local fw = o.Border or 6
	local fc = o.Frame or C.Cream
	local extra = if arch then w else 0
	-- cadre (le bas d'une arche est caché sous le rebord)
	local frameClip = kit.Group(body, x - fw - 3, y - fw - 3, w + fw * 2 + 6, h + fw + 6, 2, true)
	kit.Part(frameClip, 3, 3, w + fw * 2, h + fw * 2 + extra, fc, { Radius = r + fw, Shine = false, Shade = 0.1 })
	-- vue
	local view = kit.Group(body, x, y, w, h, 3, true)
	local sky = o.Sky or { C.Sky, C.PinkMist }
	local back = kit.Box(view, 0, 0, w, h + extra, WHITE, 0, 1)
	kit.Round(back, r)
	kit.Gradient(back, sky[1], extend(sky[1], sky[2], (h + extra) / h), 90)
	-- bord intérieur (cache les coins de la découpe)
	local rimClip = kit.Group(body, x - 4, y - 4, w + 8, h + 4, 5, true)
	local rim = kit.Box(rimClip, 4, 4, w, h + extra, WHITE, 1, 1)
	kit.Round(rim, r)
	kit.Stroke(rim, kit.Darken(fc, 0.12), 2.6, 0)
	-- croisillon
	local cross = o.Cross or "+"
	if cross == "+" or cross == "|" then
		kit.Part(body, x + w / 2 - 2, y, 4, h, fc, { Radius = 1, Z = 6, Thickness = 1.2, Shade = false })
	end
	if cross == "+" or cross == "-" then
		kit.Part(body, x, y + h * 0.5 - 2, w, 4, fc, { Radius = 1, Z = 6, Thickness = 1.2, Shade = false })
	end
	-- reflets sur la vitre
	kit.Line(body, x + 5, y + h * 0.36, x + w * 0.2, y + h * 0.36 - w * 0.15, 3, WHITE, 0.5, 7)
	kit.Line(body, x + 6, y + h * 0.36 + 7, x + w * 0.3, y + h * 0.36 + 7 - w * 0.24, 1.6, WHITE, 0.62, 7)
	-- rebord
	if o.Sill ~= false then
		local sillColor = o.SillColor or kit.Lighten(fc, 0.15)
		kit.Part(body, x - fw - 7, y + h + 1, w + fw * 2 + 14, 8, sillColor, { Radius = 3, Z = 8, Shine = true })
		kit.Part(body, x - fw - 3, y + h + 8, w + fw * 2 + 6, 4, kit.Darken(sillColor, 0.1), { Radius = 2, Z = 7 })
	end
	if o.Curtain then
		curtains(body, kit, x, y, w, h, fw, o.Curtain, o.Tie or C.PinkDeep, o.Rod or C.WoodDark)
	end
	return view, w, h
end

-- Petits oiseaux en "v"
local function bird(parent, kit, cx, cy, size, color)
	kit.Line(parent, cx - size, cy - size * 0.5, cx, cy, 1.4, color, 0, 4)
	kit.Line(parent, cx, cy, cx + size, cy - size * 0.5, 1.4, color, 0, 4)
end

-- Montagne arrondie (carré tourné à 45°) avec sa pointe en (px, py)
local function mountain(parent, kit, px, py, side, color, snow, z)
	local diag = side / math.sqrt(2)
	kit.Part(parent, px - side / 2, py + diag - side / 2, side, side, color, { Rotation = 45, Radius = 5, Z = z, Shade = false })
	if snow then
		local s = side * 0.36
		local d = s / math.sqrt(2)
		kit.Part(parent, px - s / 2, py + d - s / 2 + 0.4, s, s, WHITE, { Rotation = 45, Radius = 4, Z = z + 1, Outline = false, Shade = false })
	end
end

-- Petite étoile scintillante (losange) dans le ciel
local function twinkle(parent, kit, cx, cy, size, color, phase)
	local dot = kit.Diamond(parent, cx, cy, size, color, 0, 3)
	kit.Animate(dot, "Pulse", 0.7, 1.2, phase)
	return dot
end

-- Fait "pulser" tous les morceaux d'un conteneur
local function pulseAll(kit, holder, amp, speed, phase)
	for _, child in ipairs(holder:GetChildren()) do
		if child:IsA("GuiObject") then
			kit.Animate(child, "Pulse", amp, speed, phase)
		end
	end
end

----------------------------------------------------------------------
-- Dessins
----------------------------------------------------------------------

-- Fenêtre à rideaux : ciel bleu, soleil, nuages, collines ; pot de fleurs
Art.CurtainWindow = function(body, kit, _item)
	local C = kit.C
	local view, w, h = window(body, kit, {
		Frame = C.Cream,
		Sky = { Color3.fromRGB(140, 205, 255), Color3.fromRGB(225, 242, 255) },
		Curtain = Color3.fromRGB(255, 170, 200),
		Tie = C.PinkDeep,
	})
	kit.Circle(view, w - 12, 12, 20, 20, C.Butter, 0.5, 2)
	kit.Circle(view, w - 12, 12, 13, 13, C.Butter, 0, 2)
	local c1 = kit.Cloud(view, 16, 22, 22, WHITE, 0, 3)
	kit.Animate(c1, "Drift", 3, 0.3, 0)
	local c2 = kit.Cloud(view, 40, 32, 16, WHITE, 0.1, 3)
	kit.Animate(c2, "Drift", 2.5, 0.4, 2)
	kit.Blob(view, 14, h + 4, 50, 26, C.Leaf, { Z = 4, Shade = false, Thickness = 1.2 })
	kit.Blob(view, w - 10, h + 6, 56, 26, C.Mint, { Z = 4, Shade = false, Thickness = 1.2 })
	-- pot de fleurs sur le rebord
	kit.Part(body, 62, 66, 12, 12, C.Peach, { Radius = 3, Z = 13 })
	kit.Line(body, 68, 66, 68, 60, 1.4, C.LeafDark, 0, 12)
	kit.Circle(body, 68, 58, 8, 8, C.Pink, 0, 13)
	kit.Circle(body, 68, 58, 3, 3, C.Butter, 0, 14)
	return { WallShadow = Vector2.new(0.78, 0.78) }
end

-- Fenêtre nuageuse (arche menthe) : gros nuage souriant et nuages qui passent
Art.CloudyWindow = function(body, kit, _item)
	local C = kit.C
	local view, w, h = window(body, kit, {
		Arch = true,
		Frame = C.MintSoft,
		Sky = { Color3.fromRGB(120, 195, 255), Color3.fromRGB(210, 238, 255) },
		Curtain = C.Lilac,
		Tie = C.Butter,
		Rod = C.Purple,
	})
	local big = kit.Cloud(view, w * 0.74, h * 0.94, 26, WHITE, 0, 3)
	kit.Animate(big, "Drift", 1.5, 0.25, 0)
	kit.Face(big, 12, 11, 11, { Eyes = "happy", Mouth = "smile", Z = 3 })
	local small = kit.Cloud(view, 15, h * 0.42, 18, WHITE, 0.05, 2)
	kit.Animate(small, "Drift", 3, 0.3, 1.5)
	kit.Circle(view, w * 0.78, h * 0.3, 13, 13, C.Butter, 0, 2)
	local small2 = kit.Cloud(view, w * 0.7, h * 0.42, 18, WHITE, 0.05, 2)
	kit.Animate(small2, "Drift", 3, 0.35, 3)
	return { WallShadow = Vector2.new(0.78, 0.8) }
end

-- Fenêtre pluvieuse : nuage gris qui boude, pluie, gouttes sur la vitre
Art.RainyWindow = function(body, kit, _item)
	local C = kit.C
	local view, w, h = window(body, kit, {
		Frame = Color3.fromRGB(255, 232, 160),
		Sky = { Color3.fromRGB(125, 145, 185), Color3.fromRGB(195, 208, 230) },
		Curtain = Color3.fromRGB(150, 200, 255),
		Tie = C.Yellow,
		Rod = C.Navy,
	})
	local rain = kit.Group(view, 0, 0, w, h, 2)
	for row = 0, 1 do
		for col = 0, 4 do
			local rx = 6 + col * 11 + (row % 2) * 5.5
			local ry = 28 + row * 15 + (col % 2) * 5
			kit.Line(rain, rx, ry, rx - 2, ry + 6, 1.5, WHITE, 0.3, 1)
		end
	end
	kit.Animate(rain, "Bob", 2.5, 2.2, 0)
	local cloud = kit.Cloud(view, w * 0.3, 24, 32, Color3.fromRGB(220, 216, 236), 0, 3)
	kit.Face(cloud, 13, 13, 12, { Eyes = "closed", Mouth = "o", Z = 3 })
	kit.Animate(cloud, "Drift", 2, 0.3, 0.4)
	kit.Blob(view, w / 2, h + 3, w + 10, 14, Color3.fromRGB(150, 165, 200), { Z = 2, Outline = false, Shade = false })
	-- gouttes sur la vitre
	for _, d in ipairs({ { 30, 58, 3 }, { 36, 70, 4 }, { 64, 50, 3 }, { 70, 64, 4 } }) do
		kit.Circle(body, d[1], d[2], d[3], d[3] * 1.3, WHITE, 0.35, 7)
	end
	return { WallShadow = Vector2.new(0.78, 0.78) }
end

-- Coucher de soleil (arche pêche) : ciel rose-orangé, soleil sur la mer, oiseaux
Art.SunsetWindow = function(body, kit, _item)
	local C = kit.C
	local view, w, h = window(body, kit, {
		Arch = true,
		Frame = Color3.fromRGB(255, 214, 190),
		Sky = { Color3.fromRGB(190, 150, 235), Color3.fromRGB(255, 180, 150) },
		Curtain = C.Cream,
		Tie = C.Orange,
		Rod = C.WoodDark,
		Cross = "none",
	})
	local horizon = h * 0.64
	local sun = kit.Circle(view, w / 2, horizon, 30, 30, C.Butter, 0, 2)
	kit.Gradient(sun, WHITE, Color3.fromRGB(255, 200, 150), 90)
	kit.Face(sun, 15, 9, 14, { Eyes = "happy", Mouth = "none", Z = 2 })
	local sea = kit.Box(view, 0, horizon, w, h - horizon, Color3.fromRGB(170, 120, 210), 0, 3)
	kit.Gradient(sea, WHITE, Color3.fromRGB(180, 170, 220), 90)
	for index, s in ipairs({ { 22, 4 }, { 14, 9 }, { 8, 14 } }) do
		local glint = kit.Box(view, w / 2 - s[1] / 2, horizon + s[2], s[1], 2.4, C.Butter, 0.15, 4)
		kit.Round(glint)
		kit.Animate(glint, "Pulse", 0.5, 1, index)
	end
	bird(view, kit, 16, 16, 4, C.Purple)
	bird(view, kit, 24, 22, 3, C.Purple)
	return { WallShadow = Vector2.new(0.78, 0.8) }
end

-- Hublot : anneau doré à rivets, océan, poissons, algues et bulles
Art.PortholeWindow = function(body, kit, _item)
	local C = kit.C
	local brass = Color3.fromRGB(245, 205, 120)
	local cx, cy, d = 50, 50, 60
	kit.Circle(body, cx, cy, d + 30, d + 30, kit.OutlineOf(brass), 0, 1)
	local view = kit.Group(body, cx - d / 2, cy - d / 2, d, d, 2, true)
	local sea = kit.Circle(view, d / 2, d / 2, d, d, WHITE, 0, 1)
	kit.Gradient(sea, Color3.fromRGB(150, 220, 255), Color3.fromRGB(70, 140, 220), 90)
	kit.Line(view, 14, -4, 30, 40, 5, WHITE, 0.8, 2)
	kit.Line(view, 30, -4, 44, 34, 3, WHITE, 0.82, 2)
	local sand = kit.Group(view, 0, 46, d, 14, 3, true)
	kit.Circle(sand, d / 2, d / 2 - 46, d, d, Color3.fromRGB(255, 225, 170), 0, 1)
	kit.Circle(sand, 40, 5, 7, 4, C.Pink, 0, 2) -- coquillage
	for index, s in ipairs({ { 12, 36, 18 }, { 18, 40, 13 }, { 50, 38, 16 } }) do
		local weed = kit.Part(view, s[1] - 2, s[2], 4, s[3], C.Leaf, { Radius = -1, Z = 2, Thickness = 1.2 })
		kit.Circle(weed, if index % 2 == 0 then 0 else 4, s[3] * 0.4, 4, 5, C.Leaf, 0, 1)
		kit.Animate(weed, "Sway", 8, 0.8, index * 1.3)
	end
	local function fish(fx, fy, size, color, flip, phase)
		local g = kit.Group(view, 0, 0, d, d, 4)
		local dir = if flip then -1 else 1
		kit.Diamond(g, fx - dir * size * 0.55, fy, size * 0.5, kit.Darken(color, 0.08), 0, 1)
		kit.Blob(g, fx, fy, size, size * 0.66, color, { Z = 2, Thickness = 1.2 })
		kit.Circle(g, fx + dir * size * 0.22, fy - size * 0.06, size * 0.16, size * 0.16, C.Ink, 0, 3)
		kit.Circle(g, fx + dir * size * 0.08, fy + size * 0.12, size * 0.16, size * 0.1, C.Blush, 0.3, 3)
		kit.Animate(g, "Drift", 4, 0.5, phase)
	end
	fish(24, 20, 15, Color3.fromRGB(255, 160, 190), false, 0)
	fish(42, 34, 11, C.Butter, true, 2)
	for index, b in ipairs({ { 46, 14, 4 }, { 50, 8, 3 }, { 16, 30, 3 } }) do
		local bubble = kit.Circle(view, b[1], b[2], b[3], b[3], WHITE, 0.6, 5)
		kit.Stroke(bubble, WHITE, 1, 0.2)
		kit.Animate(bubble, "Bob", 2, 0.9, index)
	end
	-- anneau doré (recouvre les coins de la découpe) + rivets
	local ring = kit.Circle(body, cx, cy, d, d, brass, 1, 4)
	kit.Stroke(ring, brass, 13, 0)
	local lip = kit.Circle(body, cx, cy, d, d, brass, 1, 5)
	kit.Stroke(lip, kit.Darken(brass, 0.15), 2.4, 0)
	for index = 0, 7 do
		local a = math.rad(index * 45 + 22.5)
		kit.Circle(body, cx + math.sin(a) * 37, cy - math.cos(a) * 37, 5, 5, kit.Lighten(brass, 0.4), 0, 6)
	end
	kit.Line(body, 30, 38, 38, 28, 3, WHITE, 0.5, 7)
	return { WallShadow = Vector2.new(0.86, 0.86) }
end

-- Ville la nuit : ciel violet, lune endormie, immeubles aux fenêtres allumées
Art.CityNightWindow = function(body, kit, _item)
	local C = kit.C
	local view, w, h = window(body, kit, {
		Frame = C.LilacSoft,
		Sky = { Color3.fromRGB(45, 45, 100), Color3.fromRGB(130, 95, 180) },
		Curtain = Color3.fromRGB(160, 125, 225),
		Tie = C.Butter,
		Rod = C.Navy,
	})
	local moon = kit.Circle(view, w - 13, 13, 14, 14, C.Butter, 0, 2)
	kit.Face(moon, 7, 7, 10, { Eyes = "closed", Mouth = "none", Z = 2 })
	for index, s in ipairs({ { 8, 8 }, { 22, 14 }, { 34, 6 }, { 18, 26 } }) do
		twinkle(view, kit, s[1], s[2], 2.6, WHITE, index)
	end
	local towers = {
		{ 0, 30, 12, Color3.fromRGB(95, 80, 160) },
		{ 10, 20, 12, Color3.fromRGB(120, 95, 185) },
		{ 21, 34, 11, Color3.fromRGB(85, 70, 145) },
		{ 31, 24, 13, Color3.fromRGB(110, 90, 175) },
		{ 43, 32, 14, Color3.fromRGB(90, 75, 155) },
	}
	for index, t in ipairs(towers) do
		kit.Part(view, t[1], t[2], t[3], h - t[2] + 4, t[4], { Radius = 2, Z = 3 + index % 2, Thickness = 1.2, Shade = false })
	end
	local lit = { { 3, 36 }, { 14, 26 }, { 14, 34 }, { 25, 40 }, { 35, 30 }, { 47, 38 }, { 47, 46 }, { 25, 48 } }
	for index, p in ipairs(lit) do
		local win = kit.Box(view, p[1], p[2], 3.4, 3.4, C.Butter, 0, 6)
		kit.Round(win, 1)
		if index % 3 == 0 then
			kit.Animate(win, "Pulse", 0.8, 0.5, index)
		end
	end
	return { WallShadow = Vector2.new(0.78, 0.78) }
end

-- Fenêtre sakura (arche en bois) : branche fleurie, mont Fuji, pétales qui tombent
Art.SakuraWindow = function(body, kit, _item)
	local C = kit.C
	local view, w, h = window(body, kit, {
		Arch = true,
		Frame = C.WoodLight,
		Sky = { Color3.fromRGB(190, 225, 255), Color3.fromRGB(255, 232, 244) },
		Curtain = C.Cream,
		Tie = C.Pink,
		Rod = C.WoodDark,
		Cross = "|",
	})
	mountain(view, kit, w * 0.62, h * 0.52, 34, Color3.fromRGB(200, 190, 240), true, 2)
	kit.Blob(view, w / 2, h + 4, w + 20, 18, Color3.fromRGB(255, 200, 225), { Z = 4, Shade = false, Thickness = 1.2 })
	local wood = C.WoodDark
	kit.Line(view, -4, 22, 26, 28, 3.4, wood, 0, 5)
	kit.Line(view, 26, 28, 46, 22, 2.6, wood, 0, 5)
	kit.Line(view, 14, 25, 24, 12, 2, wood, 0, 5)
	local blossom = Color3.fromRGB(255, 180, 210)
	for _, b in ipairs({ { 24, 11, 9 }, { 46, 21, 9 }, { 34, 27, 8 }, { 8, 23, 8 }, { 17, 33, 7 }, { 40, 15, 7 } }) do
		kit.Circle(view, b[1], b[2], b[3], b[3], blossom, 0, 6)
		kit.Circle(view, b[1], b[2], b[3] * 0.34, b[3] * 0.34, C.PinkDeep, 0, 7)
	end
	for index, p in ipairs({ { 12, 44 }, { 30, 40 }, { 48, 48 }, { 38, 54 } }) do
		local petal = kit.Blob(view, p[1], p[2], 4.5, 3, blossom, { Z = 6, Outline = false, Shade = false, Rotation = index * 40 })
		kit.Animate(petal, if index % 2 == 0 then "Drift" else "Bob", 2.5, 0.6, index * 1.4)
	end
	return { WallShadow = Vector2.new(0.78, 0.8) }
end

-- Vue montagne (large cadre en bois) : sommets enneigés, sapins, prairie
Art.MountainWindow = function(body, kit, _item)
	local C = kit.C
	local view, w, h = window(body, kit, {
		X = 14,
		Y = 18,
		W = 72,
		H = 54,
		Frame = C.Wood,
		Border = 6,
		Sky = { Color3.fromRGB(130, 195, 255), Color3.fromRGB(230, 245, 255) },
		Curtain = Color3.fromRGB(245, 150, 150),
		Tie = C.Cream,
		Rod = C.WoodDark,
	})
	local cloud = kit.Cloud(view, 58, 16, 18, WHITE, 0, 5)
	kit.Animate(cloud, "Drift", 4, 0.25, 0)
	mountain(view, kit, 22, 12, 44, Color3.fromRGB(180, 170, 230), true, 2)
	mountain(view, kit, 50, 20, 40, Color3.fromRGB(150, 160, 220), true, 3)
	kit.Blob(view, w * 0.3, h + 6, w * 1.1, 26, C.Leaf, { Z = 6, Shade = false, Thickness = 1.2 })
	kit.Blob(view, w * 0.85, h + 8, w * 0.7, 30, C.Green, { Z = 6, Shade = false, Thickness = 1.2 })
	-- sapins (2 étages arrondis)
	for _, t in ipairs({ { 10, 40, 0.8 }, { 58, 38, 1 }, { 66, 44, 0.75 } }) do
		local s = t[3]
		kit.Box(view, t[1] - 1.2, t[2] + 12 * s, 2.4, 5 * s, C.WoodDark, 0, 7)
		kit.Part(view, t[1] - 6 * s, t[2] + 6 * s, 12 * s, 8 * s, C.LeafDark, { Radius = 3, Z = 8, Thickness = 1.2, Shade = false })
		kit.Part(view, t[1] - 4 * s, t[2], 8 * s, 8 * s, C.LeafDark, { Radius = -1, Z = 9, Thickness = 1.2, Shade = false })
	end
	bird(view, kit, 38, 10, 3, C.Navy)
	return { WallShadow = Vector2.new(0.86, 0.72) }
end

-- Vue plage (grand cadre blanc) : soleil, mer qui scintille, sable, palmier, parasol
Art.BeachWindow = function(body, kit, _item)
	local C = kit.C
	local view, w, h = window(body, kit, {
		X = 12,
		Y = 16,
		W = 76,
		H = 58,
		Frame = Color3.fromRGB(235, 248, 255),
		Sky = { Color3.fromRGB(110, 200, 255), Color3.fromRGB(215, 242, 255) },
		Curtain = Color3.fromRGB(140, 215, 235),
		Tie = C.Butter,
		Rod = C.Blue,
	})
	local halo = kit.Circle(view, 14, 13, 22, 22, C.Butter, 0.55, 2)
	kit.Animate(halo, "Pulse", 0.3, 0.6, 0)
	kit.Circle(view, 14, 13, 14, 14, C.Yellow, 0, 2)
	local cloud = kit.Cloud(view, 44, 17, 18, WHITE, 0, 2)
	kit.Animate(cloud, "Drift", 4, 0.25, 1)
	bird(view, kit, 30, 10, 3, C.Navy)
	local seaY = h * 0.5
	local sea = kit.Box(view, 0, seaY, w, h - seaY, C.Blue, 0, 3)
	kit.Gradient(sea, Color3.fromRGB(140, 200, 250), WHITE, 90)
	for index, wv in ipairs({ { 10, 4, 14 }, { 40, 7, 16 }, { 24, 11, 12 } }) do
		local wave = kit.Box(view, wv[1], seaY + wv[2], wv[3], 2, WHITE, 0.3, 4)
		kit.Round(wave)
		kit.Animate(wave, "Drift", 3, 0.5, index * 1.7)
	end
	kit.Blob(view, w * 0.45, h + 8, w * 1.3, 30, Color3.fromRGB(255, 228, 170), { Z = 5, Shade = false, Thickness = 1.2 })
	-- parasol
	kit.Line(view, 24, 36, 26, 56, 1.6, C.WoodDark, 0, 6)
	local umbrella = kit.Group(view, 12, 29, 26, 8, 7, true)
	kit.Circle(umbrella, 13, 8, 26, 16, C.Pink, 0, 1)
	kit.Box(umbrella, 10, 0, 6, 8, WHITE, 0, 2)
	kit.Circle(view, 40, 52, 4, 3, C.Red, 0, 6) -- crabe / coquillage
	-- palmier
	local trunk = { { 62, 58 }, { 62, 48 }, { 60, 38 }, { 56, 28 } }
	for index = 1, #trunk - 1 do
		local a, b = trunk[index], trunk[index + 1]
		kit.Line(view, a[1], a[2], b[1], b[2], 5, C.WoodLight, 0, 6 + index)
	end
	for index, a in ipairs({ 155, -165, -120, -60, -15, 30 }) do
		local rad = math.rad(a)
		local len = 17
		kit.Part(view, 56 + math.cos(rad) * len * 0.5 - len / 2, 28 + math.sin(rad) * len * 0.5 - 3, len, 6, if index % 2 == 0 then C.Leaf else C.Green, {
			Radius = -1,
			Z = 10 + index % 2,
			Rotation = a,
			Thickness = 1.2,
			Shade = false,
		})
	end
	kit.Circle(view, 55, 31, 4, 4, C.Brown, 0, 12)
	kit.Circle(view, 59, 31, 4, 4, C.WoodDark, 0, 12)
	return { WallShadow = Vector2.new(0.88, 0.8) }
end

-- Étoile filante (arche lilas) : nuit étoilée, lune, colline et maisonnette
Art.ShootingStarWindow = function(body, kit, _item)
	local C = kit.C
	local view, w, h = window(body, kit, {
		Arch = true,
		Frame = C.Lilac,
		Sky = { Color3.fromRGB(30, 28, 80), Color3.fromRGB(120, 85, 180) },
		Curtain = Color3.fromRGB(110, 90, 185),
		Tie = C.Butter,
		Rod = C.Navy,
		Cross = "|",
	})
	kit.Circle(view, 15, 24, 12, 12, C.Butter, 0, 2)
	kit.Circle(view, 19, 21, 11, 11, Color3.fromRGB(38, 34, 90), 0, 2)
	for index, s in ipairs({ { 22, 12 }, { 36, 34 }, { 50, 16 }, { 8, 36 }, { 24, 32 } }) do
		twinkle(view, kit, s[1], s[2], 2.6, if index % 2 == 0 then C.Butter else WHITE, index * 0.8)
	end
	-- étoile filante
	local shooter = kit.Group(view, 0, 0, w, h, 5)
	local tail = kit.Line(shooter, 28, 4, 46, 20, 5, C.PinkSoft, 0, 1)
	kit.Fade(tail, 1, 0.05, 0)
	local core = kit.Line(shooter, 34, 10, 46, 20, 1.6, WHITE, 0, 2)
	kit.Fade(core, 1, 0, 0)
	kit.Sparkle(shooter, 47, 21, 12, C.Butter, 0, 3)
	kit.Circle(shooter, 47, 21, 4, 4, WHITE, 0, 4)
	kit.Animate(shooter, "Drift", 3, 0.6, 0)
	-- colline et maisonnette
	kit.Blob(view, w * 0.3, h + 8, w * 1.1, 30, Color3.fromRGB(70, 60, 130), { Z = 6, Shade = false, Thickness = 1.2 })
	kit.Blob(view, w * 0.9, h + 6, w * 0.7, 22, Color3.fromRGB(90, 75, 150), { Z = 6, Shade = false, Thickness = 1.2 })
	kit.Part(view, 36, 42, 11, 9, C.PinkSoft, { Radius = 1.5, Z = 7, Thickness = 1.2, Shade = false })
	kit.Part(view, 36.5, 37.5, 9, 9, C.Pink, { Radius = 1.5, Z = 6, Rotation = 45, Thickness = 1.2, Shade = false })
	local lamp = kit.Box(view, 39.5, 44.5, 3.4, 3.4, C.Butter, 0, 9)
	kit.Animate(lamp, "Pulse", 0.4, 0.6, 0)
	return { WallShadow = Vector2.new(0.78, 0.8) }
end

-- Fenêtre galaxie (grande arche dorée) : nébuleuse, galaxie qui tourne, planète
Art.GalaxyWindow = function(body, kit, _item)
	local C = kit.C
	local gold = Color3.fromRGB(245, 205, 110)
	local view = window(body, kit, {
		Arch = true,
		X = 20,
		Y = 12,
		W = 60,
		H = 64,
		Frame = gold,
		Border = 7,
		Sky = { Color3.fromRGB(35, 20, 80), Color3.fromRGB(150, 80, 190) },
		Curtain = Color3.fromRGB(125, 85, 200),
		Tie = gold,
		Rod = gold,
		Cross = "none",
	})
	kit.Circle(view, 16, 26, 36, 30, C.Pink, 0.75, 2)
	kit.Circle(view, 44, 46, 40, 32, C.Sky, 0.8, 2)
	-- galaxie spirale
	local spiral = kit.Pivot(view, 20, 26, 3)
	kit.Blob(spiral, 0, 0, 30, 10, C.LilacSoft, { T = 0.45, Outline = false, Shade = false, Rotation = 25 })
	kit.Blob(spiral, 0, 0, 30, 10, C.PinkSoft, { T = 0.55, Outline = false, Shade = false, Rotation = -35 })
	kit.Circle(spiral, 0, 0, 8, 8, C.Butter, 0, 2)
	kit.Animate(spiral, "Spin", 1, 0.04, 0)
	-- planète à anneau
	local planet = kit.Blob(view, 42, 46, 20, 20, C.Peach, { Z = 4, Shine = true })
	kit.Face(planet, 10, 11, 14, { Eyes = "happy", Mouth = "smile", Z = 3 })
	kit.Blob(view, 42, 47, 34, 8, gold, { T = 1, Z = 5, Outline = C.Butter, Thickness = 2, Shade = false, Rotation = -16 })
	kit.Circle(view, 14, 50, 6, 6, C.MintSoft, 0, 4)
	for index, s in ipairs({ { 36, 10 }, { 50, 22 }, { 8, 40 }, { 28, 58 }, { 54, 60 }, { 30, 38 } }) do
		twinkle(view, kit, s[1], s[2], 2.4, if index % 2 == 0 then C.Butter else WHITE, index * 0.9)
	end
	for index, s in ipairs({ { 44, 16, 9 }, { 10, 60, 7 }, { 24, 8, 6 } }) do
		local sp = kit.Sparkle(view, s[1], s[2], s[3], WHITE, 0, 6)
		pulseAll(kit, sp, 0.7, 1, index * 1.3)
	end
	-- joyau sur le haut de l'arche
	kit.Part(body, 45, 1, 10, 10, C.Pink, { Radius = 2, Z = 8, Rotation = 45, Shine = true })
	return { Glow = Color3.fromRGB(190, 140, 255), WallShadow = Vector2.new(0.8, 0.86) }
end

return Art
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="Folder" referent="37">
            <Properties>
              <string name="Name">GardenArt</string>
            </Properties>
            <Item class="ModuleScript" referent="38">
              <Properties>
                <string name="Name">Cool92Garden</string>
                <string name="Source"><![CDATA[--[[
	Cool92Garden (ModuleScript) — (v9.2) déco "cool" du jardin 🏀⛺
	Emplacement : ReplicatedStorage > Client > Components > House > GardenArt > Cool92Garden
	Contrat : voir HouseArt (boîte 100 x 100, pieds en bas, y = 100).
	Ids = Config.House.GardenDecor (panier de basket, tente, barbecue, cage
	de foot, rampe de skate, cabane dans l'arbre, statue de dino).
]]

local Garden = {}

local rgb = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)
local DARK = rgb(44, 46, 64)
local DARKER = rgb(30, 32, 46)
local RED = rgb(236, 66, 76)
local ORANGE = rgb(255, 152, 56)
local STEEL = rgb(176, 186, 206)
local BLUE = rgb(80, 150, 255)
local WOOD = rgb(186, 130, 90)

-- Panier de basket de l'allée (poteau, panneau, filet, ballon)
Garden.YardHoop = function(body, kit, _entry)
	kit.Blob(body, 50, 96, 60, 8, DARKER, { Z = 1, Outline = false, Shade = false, T = 0.6 })
	kit.Part(body, 44, 26, 8, 72, STEEL, { Radius = 3, Z = 2, Shine = true })
	local board = kit.Part(body, 20, 4, 60, 36, WHITE, { Radius = 4, Z = 3, Shine = true })
	kit.Stroke(board, BLUE, 2.5, 0)
	local square = kit.Part(board, 20, 16, 20, 14, WHITE, { Radius = 1, Z = 2, Outline = RED, Thickness = 2, Shade = false })
	local _ = square
	kit.Part(body, 34, 38, 32, 4, ORANGE, { Radius = 2, Z = 5 })
	for index = 0, 4 do
		kit.Line(body, 36 + index * 7, 42, 38 + index * 6, 56, 1.2, WHITE, 0.1, 4)
	end
	local ball = kit.Blob(body, 72, 86, 20, 20, rgb(250, 140, 60), { Z = 6, Shine = true })
	kit.Box(ball, 9.4, 1, 1.2, 18, rgb(120, 60, 30), 0, 2)
	kit.Box(ball, 1, 9.4, 18, 1.2, rgb(120, 60, 30), 0, 2)
	kit.Animate(ball, "Bob", 3, 2, 0)
	return nil
end

-- Tente de camping (toile orange, ouverture, lanterne, fanion)
Garden.CampTent = function(body, kit, _entry)
	local C = kit.C
	kit.Blob(body, 50, 96, 90, 8, rgb(110, 160, 90), { Z = 1, Outline = false, Shade = false, T = 0.4 })
	local tent = kit.Triangle(body, 50, 22, 92, 76, ORANGE, 2)
	local _ = tent
	kit.Triangle(body, 50, 22, 60, 76, rgb(255, 180, 90), 3)
	kit.Triangle(body, 50, 50, 26, 48, DARK, 4) -- ouverture
	kit.Line(body, 50, 22, 50, 10, 2, WOOD, 0, 1)
	local flag = kit.Part(body, 50, 8, 14, 9, RED, { Radius = 2, Z = 1 })
	kit.Animate(flag, "Sway", 6, 2, 0)
	for _, x in ipairs({ 6, 94 }) do
		kit.Line(body, x, 98, x < 50 and 22 or 78, 70, 1.2, WHITE, 0.2, 5)
	end
	local lantern = kit.Part(body, 76, 80, 12, 16, C.Butter, { Radius = 4, Z = 5, Shine = true })
	kit.Animate(lantern, "Pulse", 0.3, 1.5, 0)
	kit.Part(body, 78, 76, 8, 4, DARK, { Radius = 2, Z = 6 })
	return { Glow = C.Butter }
end

-- Barbecue (cuve ronde, grille, saucisses, fumée qui monte)
Garden.BBQGrill = function(body, kit, _entry)
	for _, spec in ipairs({ { 30, 98, 40, 62 }, { 70, 98, 60, 62 } }) do
		kit.Line(body, spec[1], spec[2], spec[3], spec[4], 3, DARK, 0, 1)
	end
	kit.Blob(body, 30, 96, 10, 10, DARKER, { Z = 2 })
	local bowl = kit.Part(body, 18, 44, 64, 28, RED, { Radius = 14, Z = 3, Shine = true })
	kit.Box(bowl, 6, 0, 52, 3, DARKER, 0, 2)
	kit.Part(body, 14, 42, 72, 5, STEEL, { Radius = 2, Z = 4 }) -- grille
	for index, x in ipairs({ 26, 42, 58 }) do
		local sausage = kit.Part(body, x, 34, 14, 7, rgb(200, 100, 70), { Radius = 3, Z = 5, Shine = true })
		kit.Box(sausage, 3, 2, 8, 1, rgb(120, 60, 40), 0.3, 2)
		local _ = index
	end
	for index = 0, 2 do
		local puff = kit.Blob(body, 40 + index * 12, 22 - index * 8, 14 - index * 2, 12 - index * 2, rgb(230, 230, 240), { Z = 6, Outline = false })
		kit.Animate(puff, "Bob", 3, 1, index)
	end
	kit.Part(body, 80, 50, 14, 4, STEEL, { Radius = 2, Z = 4 }) -- poignée
	return nil
end

-- Cage de foot du jardin (filet, ballon)
Garden.YardGoal = function(body, kit, _entry)
	local net = kit.Group(body, 10, 28, 80, 68, 1)
	for index = 0, 8 do
		kit.Box(net, index * 10, 0, 1.2, 68, WHITE, 0.35, 1)
	end
	for index = 0, 6 do
		kit.Box(net, 0, index * 10, 80, 1.2, WHITE, 0.35, 1)
	end
	kit.Part(body, 6, 24, 88, 7, WHITE, { Radius = 3, Z = 3, Shine = true, Outline = STEEL })
	for _, x in ipairs({ 6, 87 }) do
		kit.Part(body, x, 24, 7, 76, WHITE, { Radius = 3, Z = 3, Shine = true, Outline = STEEL })
	end
	local ball = kit.Blob(body, 60, 88, 20, 20, WHITE, { Z = 5, Shine = true })
	kit.Diamond(ball, 10, 10, 6, DARK, 0, 2)
	for _, p in ipairs({ { 3, 6 }, { 17, 6 }, { 6, 17 }, { 14, 17 } }) do
		kit.Circle(ball, p[1], p[2], 4, 4, DARK, 0, 2)
	end
	kit.Animate(ball, "Drift", 3, 1, 0)
	return nil
end

-- Rampe de skate (quart de lune en bois, bord métal, skate posé)
Garden.SkateRamp = function(body, kit, _entry)
	local C = kit.C
	-- profil en quart de cercle (creux) : tranches horizontales de bois
	local right, top, bottom, radius = 80, 30, 98, 70
	local slices = 22
	for index = 1, slices do
		local k = index / slices
		local width = radius * (1 - math.sqrt(math.max(0, 1 - k * k)))
		local y = top + (bottom - top) * (index - 1) / slices
		local slice = kit.Box(body, right - width - 2, y, width + 2, (bottom - top) / slices + 0.8, WOOD, 0, 1)
		local _ = slice
	end
	kit.Part(body, 80, 28, 16, 70, kit.Darken(WOOD, 0.1), { Radius = 2, Z = 2, Shine = true }) -- plateforme
	for index = 0, 3 do
		kit.Box(body, 82, 36 + index * 16, 12, 2, kit.Darken(WOOD, 0.3), 0, 3)
	end
	kit.Part(body, 74, 25, 24, 5, STEEL, { Radius = 2, Z = 3 }) -- bord (coping)
	kit.Part(body, 8, 94, 76, 5, kit.Darken(WOOD, 0.15), { Radius = 2, Z = 2 }) -- base
	-- skate posé en bas de la rampe
	kit.Part(body, 16, 86, 30, 5, RED, { Radius = 3, Z = 4 })
	kit.Circle(body, 21, 93, 5, 5, C.Butter, 0, 5)
	kit.Circle(body, 41, 93, 5, 5, C.Butter, 0, 5)
	kit.Sparkle(body, 56, 30, 10, C.Butter, 0, 5)
	return nil
end

-- Cabane dans l'arbre (tronc, feuillage, cabane en bois, échelle de corde)
Garden.Treehouse = function(body, kit, _entry)
	local C = kit.C
	kit.Part(body, 42, 44, 16, 56, rgb(150, 100, 70), { Radius = 5, Z = 1, Shine = true })
	kit.Blob(body, 50, 26, 96, 50, C.Leaf, { Z = 2, Shine = true })
	kit.Blob(body, 30, 36, 40, 30, C.LeafDark, { Z = 2 })
	local hut = kit.Part(body, 26, 36, 48, 30, WOOD, { Radius = 4, Z = 3, Shine = true })
	for index = 0, 3 do
		kit.Box(hut, 0, 6 + index * 7, 48, 1.5, kit.Darken(WOOD, 0.25), 0, 2)
	end
	kit.Part(hut, 18, 8, 12, 12, rgb(170, 220, 255), { Radius = 2, Z = 3 }) -- fenêtre
	kit.Triangle(body, 50, 20, 60, 18, RED, 4) -- toit
	local flag = kit.Part(body, 70, 8, 12, 8, BLUE, { Radius = 2, Z = 4 })
	kit.Line(body, 70, 8, 70, 22, 1.5, WOOD, 0, 4)
	kit.Animate(flag, "Sway", 6, 2, 0)
	-- échelle de corde
	for _, x in ipairs({ 30, 40 }) do
		kit.Line(body, x, 66, x, 98, 1.5, rgb(220, 190, 140), 0, 4)
	end
	for index = 0, 3 do
		kit.Box(body, 29, 70 + index * 8, 12, 2.5, WOOD, 0, 5)
	end
	return nil
end

-- Statue de dino (long cou, en pierre moussue, sur un socle)
Garden.DinoStatue = function(body, kit, _entry)
	local stone = rgb(150, 190, 150)
	kit.Part(body, 14, 86, 72, 12, rgb(170, 170, 186), { Radius = 4, Z = 1, Shine = true })
	kit.Blob(body, 40, 70, 56, 34, stone, { Z = 2, Shine = true })
	kit.Line(body, 58, 64, 74, 22, 10, stone, 0, 2)
	local head = kit.Blob(body, 78, 18, 22, 16, stone, { Z = 3, Shine = true })
	kit.Face(head, 12, 7, 12, { Eyes = "happy", Mouth = "smile", Z = 3 })
	kit.Line(body, 14, 72, 2, 82, 7, stone, 0, 2)
	for _, x in ipairs({ 26, 50 }) do
		kit.Part(body, x, 76, 10, 12, stone, { Radius = 3, Z = 3 })
	end
	for index = 0, 3 do
		kit.Triangle(body, 24 + index * 10, 50 - index * 2, 8, 8, rgb(120, 170, 120), 1)
	end
	kit.Blob(body, 36, 60, 14, 6, rgb(110, 180, 100), { Z = 3, Outline = false }) -- mousse
	return nil
end

return Garden
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="39">
              <Properties>
                <string name="Name">Garden</string>
                <string name="Source"><![CDATA[--[[
	Garden (ModuleScript) — (v9.1) dessins de la déco du jardin 🌷
	Emplacement : ReplicatedStorage > Client > Components > House > GardenArt > Garden
	Contrat : voir HouseArt (boîte 100 x 100, pieds en bas, y = 100).
	Ids = Config.House.GardenDecor (tulipes, nain, flamant rose, bain
	d'oiseaux, ruche, mare aux canards, citrouilles, bonhomme de neige,
	puits à vœux, trampoline, arc-en-ciel, statue de licorne).
]]

local Garden = {}

-- Parterre de tulipes dans une jardinière en bois
Garden.TulipBed = function(body, kit, _entry)
	local C = kit.C
	local colors = { C.Pink, C.Red, C.Butter, C.Lilac, C.Pink }
	for index, color in ipairs(colors) do
		local x = 18 + (index - 1) * 16
		local top = 44 + (index % 2) * 8
		kit.Line(body, x, top + 6, x, 80, 3, C.LeafDark, 0, 1)
		kit.Blob(body, x + 5, 70 - (index % 2) * 4, 10, 16, C.Leaf, { Z = 1, Rotation = 30, Thickness = 1.2 })
		local cup = kit.Part(body, x - 7, top - 8, 14, 16, color, { Radius = 6, Z = 2, Thickness = 1.3 })
		kit.Box(cup, 4, -3, 6, 6, color, 0, 1).Rotation = 45
		kit.Shine(cup, 3, 3, 3, 6, 3, 0.4)
	end
	local box = kit.Part(body, 6, 76, 88, 22, C.Wood, { Radius = 6, Z = 4, Shine = true })
	for index = 1, 3 do
		kit.Box(box, index * 22, 3, 2, 16, kit.Darken(C.Wood, 0.2), 0.4, 2)
	end
	kit.Heart(body, 50, 87, 12, C.Pink, 0, 5)
	return nil
end

-- Nain de jardin (bonnet rouge, barbe blanche, petite pelle)
Garden.GardenGnome = function(body, kit, _entry)
	local C = kit.C
	kit.Blob(body, 50, 94, 44, 10, C.GreyDark, { Z = 1, Outline = false, Shade = false, T = 0.5 })
	kit.Part(body, 32, 60, 36, 36, C.Blue, { Radius = 12, Z = 2, Shine = true })
	kit.Part(body, 34, 84, 14, 12, C.Brown, { Radius = 5, Z = 3 })
	kit.Part(body, 52, 84, 14, 12, C.Brown, { Radius = 5, Z = 3 })
	kit.Box(body, 32, 76, 36, 5, C.Brown, 0, 3)
	kit.Blob(body, 50, 50, 30, 26, C.Peach, { Z = 4, Shine = true })
	kit.Face(body, 50, 48, 20, { Eyes = "happy", Mouth = "none", Z = 7 })
	kit.Blob(body, 50, 60, 30, 24, C.White, { Z = 5 })
	kit.Circle(body, 50, 52, 8, 7, C.Blush, 0, 6)
	local hat = kit.Triangle(body, 50, 10, 34, 34, C.Red, 4)
	local _ = hat
	kit.Blob(body, 50, 40, 36, 10, kit.Darken(C.Red, 0.1), { Z = 5 })
	kit.Circle(body, 50, 12, 8, 8, C.White, 0, 6)
	-- pelle
	kit.Line(body, 74, 56, 80, 92, 3, C.WoodDark, 0, 3)
	kit.Part(body, 74, 86, 12, 12, C.GreyDark, { Radius = 4, Z = 4 })
	return nil
end

-- Flamant rose sur une patte (se balance doucement)
Garden.PinkFlamingo = function(body, kit, _entry)
	local C = kit.C
	local pink = Color3.fromRGB(255, 150, 190)
	kit.Line(body, 48, 64, 48, 98, 3, kit.Darken(pink, 0.3), 0, 1)
	kit.Line(body, 48, 78, 58, 72, 2.5, kit.Darken(pink, 0.3), 0, 1)
	local bird = kit.Pivot(body, 48, 64, 2)
	kit.Animate(bird, "Sway", 3, 0.6, 0.4)
	kit.Blob(bird, 4, -8, 44, 28, pink, { Z = 2, Shine = true })
	kit.Blob(bird, 14, -12, 22, 14, kit.Darken(pink, 0.08), { Z = 3, Rotation = -20 })
	kit.Line(bird, -12, -12, -14, -46, 6, pink, 0, 2)
	kit.Blob(bird, -10, -50, 18, 16, pink, { Z = 3, Shine = true })
	kit.Circle(bird, -7, -52, 3.5, 3.5, C.Ink, 0, 4)
	kit.Part(bird, -26, -52, 12, 7, C.White, { Radius = 3, Z = 3, Rotation = 20 })
	kit.Part(bird, -28, -48, 6, 5, C.Ink, { Radius = 2, Z = 4, Rotation = 20, Outline = false })
	kit.Circle(bird, -12, -46, 5, 3, C.Blush, 0.3, 4)
	return nil
end

-- Bain d'oiseaux en pierre + un petit oiseau bleu
Garden.Birdbath = function(body, kit, _entry)
	local C = kit.C
	local stone = Color3.fromRGB(226, 220, 240)
	kit.Part(body, 32, 88, 36, 10, kit.Darken(stone, 0.08), { Radius = 4, Z = 1 })
	kit.Part(body, 43, 56, 14, 34, stone, { Radius = 5, Z = 2, Shine = true })
	kit.Blob(body, 50, 54, 76, 18, stone, { Z = 3, Shine = true })
	kit.Blob(body, 50, 50, 60, 9, C.Sky, { Z = 4, Outline = false, Shade = false })
	kit.Shine(body, 30, 47, 14, 3, 5, 0.3)
	local bird = kit.Group(body, 0, 0, 100, 100, 6)
	kit.Animate(bird, "Bob", 1.5, 1.2, 0.2)
	kit.Blob(bird, 68, 38, 18, 14, C.Blue, { Z = 1, Shine = true })
	kit.Blob(bird, 76, 32, 12, 11, C.Blue, { Z = 2 })
	kit.Circle(bird, 78, 31, 2.5, 2.5, C.Ink, 0, 3)
	kit.Part(bird, 82, 32, 6, 4, C.Orange, { Radius = 2, Z = 3, Outline = false })
	kit.Blob(bird, 64, 38, 10, 7, C.Sky, { Z = 3, Outline = false })
	return nil
end

-- Ruche en paille + abeilles qui tournent autour
Garden.Beehive = function(body, kit, _entry)
	local C = kit.C
	kit.Part(body, 26, 84, 48, 14, C.WoodDark, { Radius = 4, Z = 1 })
	local straw = Color3.fromRGB(255, 212, 96)
	kit.Blob(body, 50, 56, 60, 60, straw, { Z = 2, Shine = true })
	for index = 0, 3 do
		kit.Box(body, 24 + index * 2, 38 + index * 12, 52 - index * 4, 2.5, kit.Darken(straw, 0.25), 0.2, 3)
	end
	kit.Part(body, 42, 70, 16, 14, Color3.fromRGB(150, 96, 60), { Radius = 7, Z = 8 })
	kit.Blob(body, 60, 82, 8, 12, C.Orange, { Z = 9, T = 0.1 }) -- goutte de miel
	kit.Face(body, 50, 56, 18, { Eyes = "happy", Z = 9 })
	kit.Blob(body, 58, 26, 6, 10, C.Gold, { Z = 9, Rotation = 30 })
	for index, spot in ipairs({ { 18, 36 }, { 82, 44 } }) do
		local bee = kit.Group(body, 0, 0, 100, 100, 10)
		kit.Animate(bee, index == 1 and "Drift" or "Bob", 4, 1.4, index)
		kit.Blob(bee, spot[1], spot[2], 12, 9, C.Yellow, { Z = 1 })
		kit.Box(bee, spot[1] - 1, spot[2] - 4, 2.5, 8, C.Ink, 0, 2)
		kit.Blob(bee, spot[1] - 2, spot[2] - 7, 7, 5, C.White, { Z = 0, T = 0.3, Outline = false })
	end
	return nil
end

-- Mare aux canards (nénuphar, deux canetons)
Garden.DuckPond = function(body, kit, _entry)
	local C = kit.C
	kit.Blob(body, 50, 84, 96, 28, C.GreyDark, { Z = 1, T = 0.2 })
	kit.Blob(body, 50, 82, 88, 22, C.Sky, { Z = 2, Shine = true })
	kit.Blob(body, 26, 82, 16, 7, C.Leaf, { Z = 3 })
	kit.Circle(body, 26, 80, 6, 6, C.Pink, 0, 4)
	for index, x in ipairs({ 54, 74 }) do
		local duck = kit.Group(body, 0, 0, 100, 100, 5)
		kit.Animate(duck, "Bob", 1.2, 1, index)
		local s = index == 1 and 1 or 0.8
		kit.Blob(duck, x, 74, 18 * s, 12 * s, C.Butter, { Z = 1, Shine = true })
		kit.Blob(duck, x + 7 * s, 66, 11 * s, 10 * s, C.Butter, { Z = 2 })
		kit.Circle(duck, x + 9 * s, 65, 2.5, 2.5, C.Ink, 0, 3)
		kit.Part(duck, x + 11 * s, 67, 6 * s, 4 * s, C.Orange, { Radius = 2, Z = 3, Outline = false })
	end
	for index = 0, 2 do
		kit.Circle(body, 40 + index * 8, 88, 12, 3, C.White, 0.5, 3)
	end
	return nil
end

-- Petit champ de citrouilles souriantes
Garden.PumpkinPatch = function(body, kit, _entry)
	local C = kit.C
	kit.Blob(body, 50, 94, 90, 10, C.Brown, { Z = 1, Outline = false, T = 0.3 })
	for index, p in ipairs({ { 30, 78, 34 }, { 68, 74, 42 }, { 50, 88, 24 } }) do
		local cx, cy, w = p[1], p[2], p[3]
		local color = index == 3 and C.Butter or C.Orange
		kit.Blob(body, cx - w * 0.22, cy, w * 0.6, w * 0.8, kit.Darken(color, 0.06), { Z = index * 2 })
		kit.Blob(body, cx + w * 0.22, cy, w * 0.6, w * 0.8, kit.Darken(color, 0.06), { Z = index * 2 })
		kit.Blob(body, cx, cy, w * 0.6, w * 0.84, color, { Z = index * 2 + 1, Shine = true })
		kit.Part(body, cx - 2, cy - w * 0.52, 5, 8, C.LeafDark, { Radius = 2, Z = index * 2 + 1 })
		kit.Face(body, cx, cy + 2, w * 0.5, { Eyes = "happy", Z = index * 2 + 1 })
	end
	kit.Blob(body, 84, 60, 16, 10, C.Leaf, { Z = 2, Rotation = -20 })
	return nil
end

-- Bonhomme de neige (écharpe rose, bonnet, bras en brindilles)
Garden.Snowman = function(body, kit, _entry)
	local C = kit.C
	kit.Blob(body, 50, 76, 48, 42, C.White, { Z = 1, Shine = true })
	kit.Blob(body, 50, 42, 36, 32, C.White, { Z = 2, Shine = true })
	kit.Face(body, 50, 42, 22, { Z = 5 })
	kit.Part(body, 52, 43, 10, 5, C.Orange, { Radius = 2, Z = 6, Rotation = 10 })
	kit.Part(body, 32, 54, 36, 8, C.Pink, { Radius = 4, Z = 4 })
	kit.Part(body, 56, 56, 8, 18, C.Pink, { Radius = 3, Z = 4, Rotation = -10 })
	kit.Part(body, 34, 20, 32, 12, C.Lilac, { Radius = 6, Z = 4 })
	kit.Circle(body, 50, 16, 10, 10, C.White, 0, 5)
	kit.Line(body, 28, 70, 10, 58, 2.5, C.WoodDark, 0, 1)
	kit.Line(body, 72, 70, 90, 58, 2.5, C.WoodDark, 0, 1)
	for index = 0, 2 do
		kit.Circle(body, 50, 68 + index * 9, 4, 4, C.Ink, 0, 3)
	end
	return nil
end

-- Puits à vœux (toit de tuiles roses, seau, petite étincelle)
Garden.WishingWell = function(body, kit, _entry)
	local C = kit.C
	local stone = Color3.fromRGB(214, 206, 232)
	kit.Part(body, 22, 66, 56, 32, stone, { Radius = 8, Z = 3, Shine = true })
	for row = 0, 1 do
		for col = 0, 2 do
			kit.Box(body, 26 + col * 17 + row * 8, 72 + row * 12, 14, 8, kit.Darken(stone, 0.08), 0.3, 4)
		end
	end
	kit.Blob(body, 50, 66, 56, 10, C.Navy, { Z = 2 })
	kit.Part(body, 24, 28, 6, 40, C.Wood, { Radius = 2, Z = 1 })
	kit.Part(body, 70, 28, 6, 40, C.Wood, { Radius = 2, Z = 1 })
	kit.Triangle(body, 50, 10, 70, 24, C.Pink, 5)
	kit.Box(body, 14, 32, 72, 4, kit.Darken(C.Pink, 0.2), 0, 5)
	kit.Line(body, 50, 36, 50, 52, 1.5, C.Brown, 0, 2)
	kit.Part(body, 44, 50, 12, 10, C.WoodDark, { Radius = 3, Z = 3 })
	local wish = kit.Sparkle(body, 74, 50, 12, C.Butter, 0, 6)
	kit.Animate(wish, "Bob", 2, 1, 0.5)
	return nil
end

-- Trampoline (filet, ressorts, un ballon qui rebondit)
Garden.Trampoline = function(body, kit, _entry)
	local C = kit.C
	for _, x in ipairs({ 16, 34, 66, 84 }) do
		kit.Line(body, x, 72, x + (x < 50 and -4 or 4), 98, 3, C.GreyDark, 0, 1)
	end
	kit.Blob(body, 50, 70, 92, 20, C.Sky, { Z = 2 })
	kit.Blob(body, 50, 69, 76, 12, C.Navy, { Z = 3, Outline = false })
	for index = 0, 5 do
		kit.Line(body, 16 + index * 13, 63, 18 + index * 13, 67, 1.5, C.White, 0.2, 4)
	end
	local ball = kit.Group(body, 0, 0, 100, 100, 5)
	kit.Animate(ball, "Bob", 10, 1.4, 0)
	local b = kit.Blob(ball, 50, 36, 22, 22, C.Pink, { Z = 1, Shine = true })
	kit.Box(b, 10, 0, 2, 22, C.White, 0.2, 2)
	kit.Sparkle(body, 22, 30, 10, C.Butter, 0, 6)
	return nil
end

-- Arc-en-ciel posé sur deux nuages
Garden.RainbowArch = function(body, kit, _entry)
	local C = kit.C
	local colors = { C.Red, C.Orange, C.Yellow, C.Leaf, C.Sky, C.Lilac }
	local clip = kit.Group(body, 0, 0, 100, 76, 1, true)
	-- anneaux (contours épais de cercles vides), moitié haute seulement
	for index, color in ipairs(colors) do
		local size = 86 - (index - 1) * 11
		local ring = kit.Circle(clip, 50, 80, size, size, color, 1, index)
		kit.Stroke(ring, color, 5.6, 0)
	end
	kit.Cloud(body, 18, 92, 38, C.White, 0, 3)
	kit.Cloud(body, 82, 92, 38, C.White, 0, 3)
	local sparkle = kit.Sparkle(body, 50, 18, 12, C.White, 0, 4)
	kit.Animate(sparkle, "Pulse", 0.6, 1, 0.3)
	return nil
end

-- Statue de licorne en marbre sur un socle doré
Garden.UnicornStatue = function(body, kit, _entry)
	local C = kit.C
	local marble = Color3.fromRGB(248, 244, 255)
	kit.Part(body, 22, 80, 56, 18, C.Gold, { Radius = 5, Z = 1, Shine = true })
	kit.Heart(body, 50, 89, 10, C.Pink, 0, 2)
	kit.Blob(body, 48, 62, 44, 26, marble, { Z = 2, Shine = true })
	for _, x in ipairs({ 32, 44, 56, 64 }) do
		kit.Part(body, x - 3, 66, 7, 16, marble, { Radius = 3, Z = 1 })
	end
	kit.Part(body, 60, 34, 14, 30, marble, { Radius = 6, Z = 3, Rotation = 18 })
	kit.Blob(body, 72, 30, 24, 18, marble, { Z = 4, Shine = true })
	kit.Circle(body, 76, 28, 3, 3, C.Ink, 0, 5)
	kit.Triangle(body, 72, 6, 7, 18, C.Gold, 5)
	for index, color in ipairs({ C.Pink, C.Lilac, C.Sky }) do
		kit.Blob(body, 60 - index * 3, 30 + index * 6, 10, 8, color, { Z = 4 })
	end
	kit.Blob(body, 24, 56, 12, 18, C.Pink, { Z = 1, Rotation = -30 })
	local shine = kit.Sparkle(body, 22, 34, 12, C.Butter, 0, 6)
	kit.Animate(shine, "Pulse", 0.6, 1.2, 1)
	return nil
end

return Garden
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">House3D</string>
              <string name="Source"><![CDATA[--[[
	House3D (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > House3D

	Vue 3D "maison de poupée" d'une pièce (bouton "🧊 3D" de la vue pièce) :
	une vraie maquette en 3D, construite côté client dans le Workspace, loin
	du monde (House3DScene : studio pastel, socle fleuri, pièce en vraies
	Parts opaques avec le papier peint / le sol / les moulures / l'ambiance
	de la pièce, objets en 3D (House3DRecipes) ou en cartons épais),
	filmée par une caméra Scriptable :
	  - glisser (souris / doigt) = tourner autour (±70°, inclinaison
	    limitée), molette / pincer = zoomer, amorti doux ;
	  - au repos, la caméra se balance doucement toute seule ;
	  - le mur de côté entre la caméra et la pièce se baisse ;
	  - barre d'outils : flèches = tourner, 🔄 recentrer, 🌙 / ☀️ nuit / jour,
	    croix = fermer (Échap ferme aussi) ; icônes dessinées (UIUtil.Icon) ;
	  - pendant la vue, TOUTES les ScreenGui du joueur sont masquées ; à la
	    fermeture on remet EXACTEMENT : les ScreenGui qui étaient visibles,
	    la caméra (CameraType, CameraSubject, CFrame, FieldOfView, Focus)
	    et l'éclairage du lieu (Lighting + Atmosphere / flous, réglés
	    pendant la vue pour que la pièce soit toujours bien éclairée) ;
	  - la caméra est reprise CHAQUE image après toutes les autres
	    (BindToRenderStep, priorité Last) : les scripts de caméra par
	    défaut ne peuvent pas la déplacer.
	v9.1 (vu dans le vrai Roblox : "c'est en 2D, on ne voit ni le sol ni
	les murs") : le décor était dessiné sur des SurfaceGui portées par des
	pièces invisibles de 2040 studs d'épaisseur (pour l'ordre d'affichage).
	Le centre de ces pièces était à plus de 1000 studs de la caméra, or une
	SurfaceGui neuve a MaxDistance = 1000 : sol, murs et ciel n'étaient
	pas dessinés, il ne restait que les cartons plats. Tout est maintenant
	en Parts opaques de taille normale (voir House3DScene).
	v9.3 (revue contre le vrai moteur Roblox) : tous les objets sont de
	vrais modèles 3D (plus aucun carton en SurfaceGui : trop de toiles 2D
	ne s'affichent pas toutes dans Roblox) ; la ScreenGui de la vue pose
	IgnoreGuiInset avant ScreenInsets (l'un réécrit l'autre) ; les
	ScreenGui vides (sondes de zones sûres de l'interface) ne sont plus
	coupées ; flous / halos / rayons de soleil coupés aussi sous la caméra
	et dans Lighting (Bloom, SunRays) puis remis ; le personnage (monde)
	ne marche plus pendant la vue (PlayerModule, remis à la fermeture) ;
	souris libérée (MouseBehavior / icône remis à la fermeture) ; objets
	déplacés en lot (BulkMoveTo).
	v9.6 (avec Dopamine Town, son ambiance et les LiveProps) : pendant la vue,
	chaque seconde, l'éclairage de la vue est repris si un autre script l'a
	changé, un halo / flou / brume ajouté entre-temps est coupé (et remis à
	la fermeture), et la barre d'outils (✕) reste visible même si un autre
	script masque les interfaces.
	Robuste : double ouverture (la vue précédente est fermée proprement),
	réapparition du personnage, nouvelle caméra, erreurs (un objet cassé
	n'empêche pas les autres de s'afficher). Travail par image = caméra
	seulement (la maquette est construite une fois, sur quelques images).
	Aucun son.

	API :
	  House3D.Open({ Room = pièce, SizeId = taille de la maison, Title = nom de la pièce,
	                 OnClose = function() end }) -> boolean
	  House3D.Close()
	  House3D.IsOpen() -> boolean
	(Room = une pièce de ClientState.Data.House.Rooms, voir HouseCommon.Room)
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local GuiService = game:GetService("GuiService")
local TextService = game:GetService("TextService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local Client = script.Parent.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local Locale = require(ReplicatedStorage.Shared.Locale)
local HouseCommon = require(script.Parent.HouseCommon)
local House3DScene = require(script.Parent.House3DScene)

local House3D = {}

export type Options = {
	Room: any,
	House: any?,
	SizeId: string?,
	Title: string?,
	OnClose: (() -> ())?,
}

local RENDER_NAME = "House3DCamera"
local FOV = 40
local PITCH_DEFAULT = math.rad(20)
local PITCH_MIN = math.rad(7)
local PITCH_MAX = math.rad(52)
local YAW_MAX = math.rad(70)
local ZOOM_MIN = 0.55
local ZOOM_MAX = 1.5
local WHEEL_STEP = 0.88
local ROTATE_STEP = math.rad(25)
local DRAG_SPEED = math.rad(0.3) -- par pixel (souris)
local TOUCH_SPEED = math.rad(0.4) -- par pixel (doigt)
local DAMPING = 7
local INTRO_TIME = 1.4
local INTRO_DAMPING = 3.2
local IDLE_TIME = 4 -- (s) sans toucher : la caméra se balance doucement
local AUTO_AMPLITUDE = math.rad(24)
local AUTO_PERIOD = 16
local FRONT_MARGIN = 1.2 -- la caméra reste devant le bord avant de la pièce
local REHIDE_EVERY = 1 -- (s) vérifie que les autres interfaces restent masquées
-- Propriétés de Lighting réglées pendant la vue (et remises à la fermeture)
local LIGHTING_KEYS = { "ClockTime", "Brightness", "Ambient", "OutdoorAmbient", "ColorShift_Top", "ColorShift_Bottom", "EnvironmentDiffuseScale",
	"EnvironmentSpecularScale", "ExposureCompensation", "GlobalShadows", "ShadowSoftness", "FogStart", "FogEnd", "GeographicLatitude" }
-- Effets coupés pendant la vue (dans Lighting ET sous la caméra) : flou de
-- profondeur, flou, correction de couleur, halo, rayons de soleil (le modèle
-- "Baseplate" de Roblox met Bloom / DepthOfField / SunRays dans Lighting)
local EFFECT_CLASSES = { "DepthOfFieldEffect", "BlurEffect", "ColorCorrectionEffect", "BloomEffect", "SunRaysEffect" }

local WHITE = Color3.new(1, 1, 1)
local C = HouseCommon.Colors

type Saved = {
	CameraType: Enum.CameraType,
	CameraSubject: Instance?,
	CFrame: CFrame,
	FieldOfView: number,
	Focus: CFrame,
}

type Session = {
	Alive: boolean,
	LightingSaved: { [string]: any },
	EffectsSaved: { { Instance: Instance, Property: string, Value: any } },
	Muted: { [Instance]: boolean }, -- effets déjà gardés (voir muteEffects)
	Applied: { [string]: any }, -- réglages de Lighting posés par la vue
	OnClose: (() -> ())?,
	Saved: Saved?,
	Hidden: { ScreenGui },
	Connections: { RBXScriptConnection },
	Controls: any?, -- contrôles du personnage coupés pendant la vue (PlayerModule)
	MouseSaved: { Behavior: Enum.MouseBehavior, Icon: boolean }?,
	Bound: boolean,
	Gui: ScreenGui?,
	Scene: House3DScene.Scene?,
	Night: boolean,
	-- caméra (repère : angle autour de la pièce, inclinaison, zoom)
	Yaw: number,
	Pitch: number,
	Zoom: number,
	YawT: number,
	PitchT: number,
	ZoomT: number,
	ZoomMin: number,
	Fit: number,
	Focus: Vector3,
	FrontZ: number,
	Viewport: Vector2,
	Clock: number,
	LastInput: number,
	Auto: boolean,
	AutoPhase: number,
	RehideClock: number,
	-- entrées
	Dragging: boolean,
	DragLast: Vector2,
	Touches: { [any]: Vector2 },
	PinchStart: number?,
	PinchZoom: number,
	Stick: Vector2, -- stick de la manette (tourner en continu)
	Warned: boolean,
	-- interface
	NightButton: TextButton?,
	Chip: Frame?,
	ChipBar: Frame?,
	ChipText: TextLabel?,
	TitleCard: Frame?,
	Toolbar: Frame?,
	UiScale: number,
	TopReserve: number, -- (px de maquette) haut de l'écran pris par le titre
	BottomReserve: number, -- bas de l'écran pris par la barre d'outils
}

local session: Session? = nil
local applyLighting: (s: Session) -> ()
local keepLighting: (s: Session) -> ()

----------------------------------------------------------------------
-- Outils
----------------------------------------------------------------------

local function create(className: string, props: { [string]: any }): any
	local instance = Instance.new(className)
	local parent = nil
	for key, value in pairs(props) do
		if key == "Parent" then
			parent = value
		else
			(instance :: any)[key] = value
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

local function corner(parent: Instance, radius: UDim)
	create("UICorner", { CornerRadius = radius, Parent = parent })
end

local function stroke(parent: Instance, color: Color3, thickness: number, transparency: number)
	create("UIStroke", {
		Color = color,
		Thickness = thickness,
		Transparency = transparency,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

local function tween(instance: Instance, duration: number, props: { [string]: any }, style: Enum.EasingStyle?)
	TweenService:Create(instance, TweenInfo.new(duration, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local function textWidth(text: string, size: number, font: Enum.Font): number
	local ok, bounds = pcall(function()
		return TextService:GetTextSize(text, size, font, Vector2.new(4000, 200))
	end)
	if ok and typeof(bounds) == "Vector2" then
		return bounds.X
	end
	return (utf8.len(text) or #text) * size * 0.55
end

-- Caméra en orbite autour de `focus` (yaw 0 = face à la pièce)
local function orbitCFrame(focus: Vector3, yaw: number, pitch: number, distance: number): CFrame
	local flat = math.cos(pitch)
	local eye = focus + Vector3.new(math.sin(yaw) * flat, math.sin(pitch), math.cos(yaw) * flat) * distance
	return CFrame.lookAt(eye, focus)
end

local function isTouchDevice(): boolean
	return UserInputService.TouchEnabled and not UserInputService.MouseEnabled
end

----------------------------------------------------------------------
-- Cadrage
----------------------------------------------------------------------

-- Place prise par l'interface (px d'écran) : titre en haut, barre en bas
local function reservedArea(s: Session, viewportH: number): (number, number, number)
	local bottomInset = 0
	local ok, _, bottomRight = pcall(function()
		return GuiService:GetGuiInset()
	end)
	if ok and typeof(bottomRight) == "Vector2" then
		bottomInset = bottomRight.Y
	end
	local scale = s.UiScale
	local top = s.TopReserve * scale
	-- (tactile : marge pour la barre d'accueil des téléphones)
	local bottom = bottomInset + s.BottomReserve * scale + (isTouchDevice() and 12 or 0)
	-- (écran très bas : on garde au moins la moitié de la hauteur pour la pièce)
	local free = viewportH - top - bottom
	if free < viewportH * 0.5 then
		local k = (viewportH * 0.5) / math.max(1, top + bottom)
		top *= k
		bottom *= k
	end
	return top, bottom, 20 * scale
end

-- Distance (et cible) pour voir toute la pièce de face, à l'inclinaison par défaut
local function computeFit(s: Session)
	local scene = s.Scene
	local camera = workspace.CurrentCamera
	if not scene or not camera then
		return
	end
	local viewport = camera.ViewportSize
	local vw, vh = math.max(200, viewport.X), math.max(160, viewport.Y)
	local tanY = math.tan(math.rad(FOV) / 2)
	local tanX = tanY * vw / vh
	local topPx, bottomPx, sidePx = reservedArea(s, vh)
	local limitTop = 1 - 2 * topPx / vh
	local limitBottom = -1 + 2 * bottomPx / vh
	local limitX = 1 - 2 * sidePx / vw
	local lo, hi = scene.BoundsMin, scene.BoundsMax
	local corners = {}
	for _, x in ipairs({ lo.X, hi.X }) do
		for _, y in ipairs({ lo.Y, hi.Y }) do
			for _, z in ipairs({ lo.Z, hi.Z }) do
				table.insert(corners, Vector3.new(x, y, z))
			end
		end
	end
	local function extents(target: Vector3, distance: number): (boolean, number, number, number)
		local cframe = orbitCFrame(target, 0, PITCH_DEFAULT, distance)
		local maxX, minY, maxY = 0, math.huge, -math.huge
		for _, point in ipairs(corners) do
			local v = cframe:PointToObjectSpace(point)
			local depth = -v.Z
			if depth < 0.5 then
				return false, 0, 0, 0
			end
			maxX = math.max(maxX, math.abs(v.X / (depth * tanX)))
			local y = v.Y / (depth * tanY)
			minY = math.min(minY, y)
			maxY = math.max(maxY, y)
		end
		return true, maxX, minY, maxY
	end
	local target = scene.Focus
	local distance = 60
	for _ = 1, 3 do
		local near, far = 4, 800
		for _ = 1, 26 do
			local mid = (near + far) / 2
			local ok, maxX, minY, maxY = extents(target, mid)
			if ok and maxX <= limitX and minY >= limitBottom and maxY <= limitTop then
				far = mid
			else
				near = mid
			end
		end
		distance = far
		local ok, _, minY, maxY = extents(target, distance)
		if ok then
			local shift = (minY + maxY) / 2 - (limitTop + limitBottom) / 2
			target += Vector3.new(0, shift * distance * tanY * 0.9, 0)
		end
	end
	s.Fit = distance
	s.Focus = target
	-- Zoom minimum : on doit toujours pouvoir tourner d'au moins ±25° en restant devant la pièce
	local reach = s.FrontZ + FRONT_MARGIN - target.Z
	local needed = reach / math.cos(math.rad(25)) / math.cos(PITCH_MAX)
	s.ZoomMin = math.clamp(needed / math.max(1, distance), ZOOM_MIN, 1)
end

-- Angle maximal autour de la pièce (la caméra reste devant son bord avant)
local function yawLimit(s: Session, pitch: number, distance: number): number
	local reach = s.FrontZ + FRONT_MARGIN - s.Focus.Z
	local horizontal = distance * math.cos(pitch)
	if horizontal <= reach then
		return 0
	end
	return math.min(YAW_MAX, math.acos(math.clamp(reach / horizontal, -1, 1)))
end

local function clampTargets(s: Session)
	s.PitchT = math.clamp(s.PitchT, PITCH_MIN, PITCH_MAX)
	s.ZoomT = math.clamp(s.ZoomT, s.ZoomMin, ZOOM_MAX)
	local limit = yawLimit(s, s.PitchT, s.Fit * s.ZoomT)
	s.YawT = math.clamp(s.YawT, -limit, limit)
end

local function touched(s: Session)
	s.LastInput = s.Clock
	s.Auto = false
end

----------------------------------------------------------------------
-- Caméra (chaque image)
----------------------------------------------------------------------

local function stepCamera(s: Session, dt: number)
	local camera = workspace.CurrentCamera
	local scene = s.Scene
	if not camera or not scene then
		return
	end
	dt = math.clamp(dt, 0, 0.1)
	s.Clock += dt
	if camera.CameraType ~= Enum.CameraType.Scriptable then
		camera.CameraType = Enum.CameraType.Scriptable
	end
	-- souris libre et visible (un verrouillage de souris d'un autre script
	-- empêcherait de tourner autour de la pièce)
	if s.MouseSaved and UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default and not s.Dragging then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end
	local viewport = camera.ViewportSize
	if viewport ~= s.Viewport then
		s.Viewport = viewport
		computeFit(s)
	end
	-- Manette : le stick fait tourner en continu
	local stick = s.Stick
	if stick.Magnitude > 0.2 then
		touched(s)
		s.YawT += stick.X * dt * math.rad(90)
		s.PitchT -= stick.Y * dt * math.rad(60)
	end
	-- Balancement tout seul au repos
	if s.Clock - s.LastInput > IDLE_TIME and not s.Dragging and next(s.Touches) == nil then
		local amplitude = math.min(AUTO_AMPLITUDE, yawLimit(s, s.PitchT, s.Fit * s.ZoomT) * 0.8)
		if amplitude > 0.01 then
			if not s.Auto then
				s.Auto = true
				s.AutoPhase = math.asin(math.clamp(s.Yaw / amplitude, -1, 1))
			end
			s.AutoPhase += dt * math.pi * 2 / AUTO_PERIOD
			s.YawT = amplitude * math.sin(s.AutoPhase)
		end
	end
	clampTargets(s)
	local rate = s.Clock < INTRO_TIME and INTRO_DAMPING or DAMPING
	local alpha = 1 - math.exp(-dt * rate)
	s.Yaw += (s.YawT - s.Yaw) * alpha
	s.Pitch += (s.PitchT - s.Pitch) * alpha
	s.Zoom += (s.ZoomT - s.Zoom) * alpha
	local cframe = orbitCFrame(s.Focus, s.Yaw, s.Pitch, s.Fit * s.Zoom)
	camera.CFrame = cframe
	camera.Focus = CFrame.new(s.Focus)
	if math.abs(camera.FieldOfView - FOV) > 0.01 then
		camera.FieldOfView = FOV
	end
	scene.UpdateWalls(cframe.Position)
	scene.Step(dt)
	-- Les autres interfaces restent masquées (une ScreenGui réactivée ailleurs)
	s.RehideClock += dt
	if s.RehideClock >= REHIDE_EVERY then
		s.RehideClock = 0
		for _, gui in ipairs(s.Hidden) do
			if gui.Parent and gui.Enabled then
				gui.Enabled = false
			end
		end
		-- (v9.6) notre barre d'outils reste visible (un autre script qui masque
		-- les interfaces, ex. la ville, ne doit pas faire disparaître ✕ Fermer)
		local own = s.Gui
		if own and own.Parent and not own.Enabled then
			own.Enabled = true
		end
		keepLighting(s)
	end
end

----------------------------------------------------------------------
-- Commandes
----------------------------------------------------------------------

local function rotateBy(s: Session, delta: number)
	touched(s)
	s.YawT += delta
	clampTargets(s)
end

local function resetView(s: Session)
	touched(s)
	s.YawT = 0
	s.PitchT = PITCH_DEFAULT
	s.ZoomT = 1
end

local function refreshNightButton(s: Session)
	local button = s.NightButton
	if not button then
		return
	end
	local icon = button:FindFirstChild("Icon") :: TextLabel?
	local caption = button:FindFirstChild("Caption") :: TextLabel?
	if icon then
		icon.Text = s.Night and "☀️" or "🌙"
	end
	if caption then
		caption.Text = s.Night and Locale.T("Day") or Locale.T("Night")
	end
end

----------------------------------------------------------------------
-- Éclairage du lieu (réglé pendant la vue, remis EXACTEMENT à la fermeture)
----------------------------------------------------------------------

-- Coupe les effets (Lighting + caméra) pas encore coupés : à l'ouverture,
-- puis chaque seconde (v9.6 : un effet ajouté pendant la vue par un autre
-- script, ex. l'ambiance de la ville, est coupé aussi et remis à la fermeture)
-- Propriété coupée pendant la vue pour un enfant de Lighting / de la caméra
local function muteProperty(child: Instance): string?
	if child:IsA("Atmosphere") then
		return "Density"
	end
	for _, className in ipairs(EFFECT_CLASSES) do
		if child:IsA(className) then
			return "Enabled"
		end
	end
	return nil
end

local function muteEffects(s: Session)
	local holders: { Instance } = Lighting:GetChildren()
	local camera = workspace.CurrentCamera
	if camera then
		for _, child in ipairs(camera:GetChildren()) do
			table.insert(holders, child)
		end
	end
	for _, child in ipairs(holders) do
		local property = muteProperty(child)
		if property then
			local off: any = property == "Density" and 0 or false
			if not s.Muted[child] then
				-- (valeur d'origine gardée une seule fois, remise à la fermeture)
				local ok, value = pcall(function()
					return (child :: any)[property]
				end)
				if ok then
					s.Muted[child] = true
					table.insert(s.EffectsSaved, { Instance = child, Property = property, Value = value })
				end
			end
			pcall(function()
				if (child :: any)[property] ~= off then
					(child :: any)[property] = off
				end
			end)
		end
	end
end

local function saveLighting(s: Session)
	for _, key in ipairs(LIGHTING_KEYS) do
		local ok, value = pcall(function()
			return (Lighting :: any)[key]
		end)
		if ok and value ~= nil then
			s.LightingSaved[key] = value
		end
	end
	muteEffects(s)
end

applyLighting = function(s: Session)
	local scene = s.Scene
	if not scene then
		return
	end
	local okProps, props = pcall(scene.Lighting, s.Night)
	if not okProps or type(props) ~= "table" then
		return
	end
	table.clear(s.Applied)
	for key, value in pairs(props) do
		if s.LightingSaved[key] ~= nil then
			s.Applied[key] = value
			pcall(function()
				(Lighting :: any)[key] = value
			end)
		end
	end
end

-- v9.6 : un autre script (ambiance de la ville, cycle du soleil...) a
-- changé l'éclairage pendant la vue : on remet celui de la vue
-- (comparaison tolérante : on ne réécrit Lighting que s'il a vraiment changé)
local function sameValue(a: any, b: any): boolean
	if type(a) == "number" and type(b) == "number" then
		return math.abs(a - b) < 1e-3
	end
	if typeof(a) == "Color3" and typeof(b) == "Color3" then
		return math.abs(a.R - b.R) < 0.005 and math.abs(a.G - b.G) < 0.005 and math.abs(a.B - b.B) < 0.005
	end
	return a == b
end

keepLighting = function(s: Session)
	for key, value in pairs(s.Applied) do
		pcall(function()
			if not sameValue((Lighting :: any)[key], value) then
				(Lighting :: any)[key] = value
			end
		end)
	end
	muteEffects(s)
end

local function restoreLighting(s: Session)
	for key, value in pairs(s.LightingSaved) do
		pcall(function()
			(Lighting :: any)[key] = value
		end)
	end
	table.clear(s.LightingSaved)
	for _, saved in ipairs(s.EffectsSaved) do
		pcall(function()
			(saved.Instance :: any)[saved.Property] = saved.Value
		end)
	end
	table.clear(s.EffectsSaved)
	table.clear(s.Muted)
	table.clear(s.Applied)
end

local function toggleNight(s: Session)
	touched(s)
	s.Night = not s.Night
	local scene = s.Scene
	if scene then
		scene.SetNight(s.Night)
	end
	applyLighting(s)
	refreshNightButton(s)
end

----------------------------------------------------------------------
-- Interface (titre, barre d'outils, construction)
----------------------------------------------------------------------

type Metrics = {
	ButtonW: number,
	ButtonH: number,
	IconSize: number,
	CaptionSize: number,
	Pad: number,
	Gap: number,
}

local function toolButton(parent: Instance, m: Metrics, name: string, icon: string, caption: string, order: number, primary: boolean): TextButton
	local button = create("TextButton", {
		Name = name,
		AutoButtonColor = false,
		Text = "",
		Size = UDim2.fromOffset(m.ButtonW, m.ButtonH),
		BackgroundColor3 = primary and C.PinkDeep or C.PinkMist,
		BorderSizePixel = 0,
		LayoutOrder = order,
		Parent = parent,
	}) :: TextButton
	corner(button, UDim.new(0, math.floor(m.ButtonH * 0.28)))
	stroke(button, primary and C.PinkDeep:Lerp(Color3.new(0, 0, 0), 0.15) or C.PinkSoft, 1.5, 0)
	create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(WHITE, Color3.fromRGB(236, 230, 240)),
		Parent = button,
	})
	if icon == "Cross" or icon == "ArrowLeft" or icon == "ArrowRight" then
		-- (icône dessinée : ces glyphes s'affichent en carré vide dans Roblox)
		UIUtil.Icon(icon, {
			Name = "Icon",
			Size = math.floor(m.IconSize * 0.9),
			Thickness = math.max(2, math.floor(m.IconSize * 0.16 + 0.5)),
			Color = primary and WHITE or C.Ink,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0, math.floor(m.ButtonH * 0.08) + math.floor((m.IconSize + 4) / 2)),
			Parent = button,
		})
	else
		create("TextLabel", {
			Name = "Icon",
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(0, math.floor(m.ButtonH * 0.08)),
			Size = UDim2.new(1, 0, 0, m.IconSize + 4),
			Font = Theme.Fonts.Title,
			Text = icon,
			TextSize = m.IconSize,
			TextColor3 = primary and WHITE or C.Ink,
			Parent = button,
		})
	end
	local label = create("TextLabel", {
		Name = "Caption",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -math.floor(m.ButtonH * 0.08)),
		Size = UDim2.new(1, -8, 0, m.CaptionSize + 3),
		Font = Theme.Fonts.Title,
		Text = caption,
		TextScaled = true,
		TextColor3 = primary and WHITE or C.Ink,
		Parent = button,
	})
	create("UITextSizeConstraint", { MaxTextSize = m.CaptionSize, MinTextSize = 7, Parent = label })
	-- Petit rebond au survol / à l'appui
	local press = create("UIScale", { Name = "Press", Parent = button }) :: UIScale
	local hovering = false
	button.MouseEnter:Connect(function()
		hovering = true
		tween(press, 0.14, { Scale = 1.07 }, Enum.EasingStyle.Back)
	end)
	button.MouseLeave:Connect(function()
		hovering = false
		tween(press, 0.14, { Scale = 1 })
	end)
	button.MouseButton1Down:Connect(function()
		tween(press, 0.08, { Scale = 0.92 })
	end)
	button.MouseButton1Up:Connect(function()
		tween(press, 0.2, { Scale = hovering and 1.07 or 1 }, Enum.EasingStyle.Back)
	end)
	return button
end

local function separator(parent: Instance, m: Metrics, order: number)
	local holder = create("Frame", {
		Name = "Separator",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(9, m.ButtonH),
		LayoutOrder = order,
		Parent = parent,
	})
	create("Frame", {
		Name = "Line",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(2, math.floor(m.ButtonH * 0.58)),
		BackgroundColor3 = C.LilacSoft,
		BorderSizePixel = 0,
		Parent = holder,
	})
end

-- Interface de la vue : carte de titre (dans la barre du haut de Roblox, au
-- milieu, qui est libre) + barre d'outils en bas + pastille "construction"
local function buildGui(s: Session, title: string, roomIcon: string): ScreenGui
	-- (propriétés posées dans l'ordre : dans Roblox, IgnoreGuiInset réécrit
	-- ScreenInsets ; avec create() l'ordre de `pairs` n'est pas garanti)
	local gui = Instance.new("ScreenGui")
	gui.Name = "House3DView"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets
	gui.DisplayOrder = 60
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	local touch = isTouchDevice()
	local device = "Desktop"
	local okInterface, Interface = pcall(require, Client.Interface)
	if okInterface and type(Interface) == "table" and type(Interface.Device) == "string" then
		device = Interface.Device
	end
	-- Téléphone (paysage, peu de hauteur) : tout est plus compact
	local compact = device == "Phone"
	local scale = compact and 0.82 or 1
	s.UiScale = scale
	local m: Metrics = compact and { ButtonW = 58, ButtonH = 48, IconSize = 20, CaptionSize = 10, Pad = 7, Gap = 5 }
		or { ButtonW = 66, ButtonH = 58, IconSize = 24, CaptionSize = 12, Pad = 8, Gap = 6 }
	local root = create("Frame", {
		Name = "Root",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = gui,
	})
	local content = create("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1 / scale, 0, 1 / scale, 0),
		Parent = root,
	})
	create("UIScale", { Scale = scale, Parent = content })

	-- Carte de titre : "🛏️ Vue 3D · Chambre" + aide
	local heading = Locale.T("3D view") .. " · " .. title
	local hint = touch and Locale.T("Drag to rotate · Pinch to zoom") or Locale.T("Drag to rotate · Scroll to zoom")
	local cardH = compact and 44 or 54
	local badgeSize = compact and 30 or 38
	local titleSize = compact and 16 or 19
	local hintSize = compact and 11 or 13
	local textLeft = 10 + badgeSize + 10
	local width = math.clamp(math.max(textWidth(heading, titleSize, Theme.Fonts.Title), textWidth(hint, hintSize, Theme.Fonts.Body)) + textLeft + 20, 220, 560)
	local card = create("Frame", {
		Name = "TitleCard",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.fromOffset(width, cardH),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.03,
		BorderSizePixel = 0,
		Parent = content,
	})
	corner(card, UDim.new(0, math.floor(cardH * 0.36)))
	stroke(card, C.PinkSoft, 2, 0)
	create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(WHITE, C.PinkMist),
		Parent = card,
	})
	local badge = create("Frame", {
		Name = "Badge",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		Size = UDim2.fromOffset(badgeSize, badgeSize),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		Parent = card,
	})
	corner(badge, UDim.new(1, 0))
	create("UIGradient", {
		Rotation = 45,
		Color = ColorSequence.new(C.Pink, C.Lilac),
		Parent = badge,
	})
	create("TextLabel", {
		Name = "Icon",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Font = Theme.Fonts.Title,
		Text = roomIcon,
		TextSize = math.floor(badgeSize * 0.56),
		TextColor3 = WHITE,
		Parent = badge,
	})
	local lineTop = math.floor((cardH - titleSize - hintSize - 6) / 2)
	create("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(textLeft, lineTop),
		Size = UDim2.new(1, -textLeft - 12, 0, titleSize + 4),
		Font = Theme.Fonts.Title,
		Text = heading,
		TextSize = titleSize,
		TextColor3 = C.Ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = card,
	})
	create("TextLabel", {
		Name = "Hint",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(textLeft, lineTop + titleSize + 4),
		Size = UDim2.new(1, -textLeft - 12, 0, hintSize + 4),
		Font = Theme.Fonts.Body,
		Text = hint,
		TextSize = hintSize,
		TextColor3 = C.Ink,
		TextTransparency = 0.3,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = card,
	})
	s.TitleCard = card
	s.TopReserve = 6 + cardH + 8

	-- Barre d'outils
	local buttons, separators = 5, 2
	local barH = m.ButtonH + m.Pad * 2
	local barWidth = m.Pad * 2 + buttons * m.ButtonW + separators * 9 + (buttons + separators - 1) * m.Gap
	local bar = create("Frame", {
		Name = "Toolbar",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Size = UDim2.fromOffset(barWidth, barH),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.03,
		BorderSizePixel = 0,
		Parent = content,
	})
	corner(bar, UDim.new(0, math.floor(barH * 0.36)))
	stroke(bar, C.PinkSoft, 2, 0)
	create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(WHITE, C.PinkMist),
		Parent = bar,
	})
	create("UIPadding", {
		PaddingLeft = UDim.new(0, m.Pad),
		PaddingRight = UDim.new(0, m.Pad),
		PaddingTop = UDim.new(0, m.Pad),
		PaddingBottom = UDim.new(0, m.Pad),
		Parent = bar,
	})
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, m.Gap),
		Parent = bar,
	})
	local rotateLeft = toolButton(bar, m, "RotateLeft", "ArrowLeft", Locale.T("Rotate"), 1, false)
	local rotateRight = toolButton(bar, m, "RotateRight", "ArrowRight", Locale.T("Rotate"), 2, false)
	separator(bar, m, 3)
	local reset = toolButton(bar, m, "Reset", "🔄", Locale.T("Reset"), 4, false)
	local nightButton = toolButton(bar, m, "Night", "🌙", Locale.T("Night"), 5, false)
	separator(bar, m, 6)
	local close = toolButton(bar, m, "Close", "Cross", Locale.T("Close"), 7, true)
	s.NightButton = nightButton
	s.Toolbar = bar
	s.BottomReserve = 10 + barH + 10
	refreshNightButton(s)
	rotateLeft.Activated:Connect(function()
		rotateBy(s, -ROTATE_STEP)
	end)
	rotateRight.Activated:Connect(function()
		rotateBy(s, ROTATE_STEP)
	end)
	reset.Activated:Connect(function()
		resetView(s)
	end)
	nightButton.Activated:Connect(function()
		toggleNight(s)
	end)
	close.Activated:Connect(function()
		if session == s then
			House3D.Close()
		end
	end)

	-- Pastille "construction" (le temps que les objets arrivent), au-dessus de la barre
	local chip = create("Frame", {
		Name = "Building",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -(10 + barH + 10)),
		Size = UDim2.fromOffset(250, 32),
		BackgroundColor3 = C.Ink,
		BackgroundTransparency = 0.12,
		BorderSizePixel = 0,
		Visible = false,
		Parent = content,
	})
	corner(chip, UDim.new(1, 0))
	local chipText = create("TextLabel", {
		Name = "Text",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 0),
		Size = UDim2.new(1, -28, 1, -6),
		Font = Theme.Fonts.Title,
		Text = "✨ " .. Locale.T("Building the room…"),
		TextSize = 14,
		TextColor3 = WHITE,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = chip,
	})
	local track = create("Frame", {
		Name = "Track",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -5),
		Size = UDim2.new(1, -28, 0, 3),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.75,
		BorderSizePixel = 0,
		Parent = chip,
	})
	corner(track, UDim.new(1, 0))
	local fill = create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = C.Pink,
		BorderSizePixel = 0,
		Parent = track,
	})
	corner(fill, UDim.new(1, 0))
	s.Chip = chip
	s.ChipBar = fill
	s.ChipText = chipText
	return gui
end

local function showProgress(s: Session, done: number, total: number)
	local chip = s.Chip
	local bar = s.ChipBar
	if not chip or not bar then
		return
	end
	if total <= 0 or done >= total then
		chip.Visible = false
		return
	end
	chip.Visible = true
	bar.Size = UDim2.fromScale(math.clamp(done / total, 0, 1), 1)
end

----------------------------------------------------------------------
-- Entrées
----------------------------------------------------------------------

local function onInputBegan(s: Session, input: InputObject, processed: boolean)
	local kind = input.UserInputType
	local key = input.KeyCode
	if key == Enum.KeyCode.Escape or key == Enum.KeyCode.ButtonB then
		if session == s then
			House3D.Close()
		end
		return
	end
	if processed then
		return
	end
	if kind == Enum.UserInputType.Keyboard or kind == Enum.UserInputType.Gamepad1 then
		if key == Enum.KeyCode.Left or key == Enum.KeyCode.Q or key == Enum.KeyCode.DPadLeft then
			rotateBy(s, -ROTATE_STEP)
		elseif key == Enum.KeyCode.Right or key == Enum.KeyCode.E or key == Enum.KeyCode.DPadRight then
			rotateBy(s, ROTATE_STEP)
		elseif key == Enum.KeyCode.ButtonR1 or key == Enum.KeyCode.ButtonR2 then
			touched(s)
			s.ZoomT *= WHEEL_STEP
		elseif key == Enum.KeyCode.ButtonL1 or key == Enum.KeyCode.ButtonL2 then
			touched(s)
			s.ZoomT /= WHEEL_STEP
		elseif key == Enum.KeyCode.ButtonY then
			resetView(s)
		elseif key == Enum.KeyCode.Up then
			touched(s)
			s.PitchT += math.rad(8)
		elseif key == Enum.KeyCode.Down then
			touched(s)
			s.PitchT -= math.rad(8)
		end
	elseif kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.MouseButton2 then
		s.Dragging = true
		s.DragLast = Vector2.new(input.Position.X, input.Position.Y)
		touched(s)
	elseif kind == Enum.UserInputType.Touch then
		s.Touches[input] = Vector2.new(input.Position.X, input.Position.Y)
		s.PinchStart = nil
		touched(s)
	end
end

local function onInputChanged(s: Session, input: InputObject, processed: boolean)
	local kind = input.UserInputType
	if kind == Enum.UserInputType.MouseMovement then
		if s.Dragging then
			local position = Vector2.new(input.Position.X, input.Position.Y)
			local delta = position - s.DragLast
			s.DragLast = position
			s.YawT -= delta.X * DRAG_SPEED
			s.PitchT += delta.Y * DRAG_SPEED
			touched(s)
		end
	elseif kind == Enum.UserInputType.Gamepad1 then
		if input.KeyCode == Enum.KeyCode.Thumbstick1 or input.KeyCode == Enum.KeyCode.Thumbstick2 then
			s.Stick = Vector2.new(input.Position.X, input.Position.Y)
		end
	elseif kind == Enum.UserInputType.MouseWheel then
		if processed then
			return
		end
		local wheel = input.Position.Z
		if wheel ~= 0 then
			s.ZoomT *= wheel > 0 and WHEEL_STEP or 1 / WHEEL_STEP
			touched(s)
		end
	elseif kind == Enum.UserInputType.Touch then
		local previous = s.Touches[input]
		if not previous then
			return
		end
		local position = Vector2.new(input.Position.X, input.Position.Y)
		s.Touches[input] = position
		local fingers = {}
		for _, point in pairs(s.Touches) do
			table.insert(fingers, point)
		end
		if #fingers == 1 then
			local delta = position - previous
			s.YawT -= delta.X * TOUCH_SPEED
			s.PitchT += delta.Y * TOUCH_SPEED
		elseif #fingers >= 2 then
			local spread = (fingers[1] - fingers[2]).Magnitude
			local start = s.PinchStart
			if not start then
				s.PinchStart = spread
				s.PinchZoom = s.ZoomT
			else
				s.ZoomT = s.PinchZoom * start / math.max(10, spread)
			end
		end
		touched(s)
	end
end

local function onInputEnded(s: Session, input: InputObject)
	local kind = input.UserInputType
	if kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.MouseButton2 then
		s.Dragging = false
	elseif kind == Enum.UserInputType.Touch then
		s.Touches[input] = nil
		s.PinchStart = nil
	elseif kind == Enum.UserInputType.Gamepad1 then
		if input.KeyCode == Enum.KeyCode.Thumbstick1 or input.KeyCode == Enum.KeyCode.Thumbstick2 then
			s.Stick = Vector2.zero
		end
	end
end

----------------------------------------------------------------------
-- Ouverture / fermeture
----------------------------------------------------------------------

local function hideGui(s: Session, child: Instance)
	-- (une ScreenGui vide ne cache rien : on n'y touche pas, par ex. les
	-- sondes de zones sûres de l'interface, dont la taille sert au jeu)
	if child:IsA("ScreenGui") and child ~= s.Gui and child.Enabled and #child:GetChildren() > 0 then
		child.Enabled = false
		table.insert(s.Hidden, child)
	end
end

-- Coupe les contrôles du personnage (PlayerModule de Roblox) s'ils sont
-- actifs ; renvoie l'objet à réactiver à la fermeture (nil sinon)
local function disableControls(): any
	local player = Players.LocalPlayer
	if not player or not player.Character then
		return nil
	end
	local ok, controls = pcall(function()
		local scripts = player:FindFirstChildOfClass("PlayerScripts")
		local module = scripts and scripts:FindFirstChild("PlayerModule")
		if not module or not module:IsA("ModuleScript") then
			return nil
		end
		local playerModule = (require :: any)(module)
		local result = playerModule:GetControls()
		local active = result and result.activeController
		if not active or active.enabled == false then
			return nil
		end
		result:Disable()
		return result
	end)
	return ok and controls or nil
end

local function restoreCamera(s: Session)
	local saved = s.Saved
	local camera = workspace.CurrentCamera
	if not saved or not camera then
		return
	end
	local subject = saved.CameraSubject
	local okAlive, alive = pcall(function()
		return subject ~= nil and subject:IsDescendantOf(game)
	end)
	if subject and not (okAlive and alive) then
		-- (le personnage a réapparu pendant la vue : on suit le nouveau)
		local player = Players.LocalPlayer
		local character = player and player.Character
		subject = character and character:FindFirstChildOfClass("Humanoid") or nil
	end
	if subject then
		pcall(function()
			camera.CameraSubject = subject
		end)
	end
	pcall(function()
		camera.CameraType = saved.CameraType
	end)
	pcall(function()
		camera.CFrame = saved.CFrame
	end)
	pcall(function()
		camera.Focus = saved.Focus
	end)
	pcall(function()
		camera.FieldOfView = saved.FieldOfView
	end)
end

local function start(s: Session, options: Options)
	local camera = workspace.CurrentCamera
	assert(camera, "pas de caméra")
	s.Saved = {
		CameraType = camera.CameraType,
		CameraSubject = camera.CameraSubject,
		CFrame = camera.CFrame,
		FieldOfView = camera.FieldOfView,
		Focus = camera.Focus,
	}
	local room = options.Room
	local roomType = HouseCommon.GetRoomType(room)
	local title = type(options.Title) == "string" and options.Title ~= "" and options.Title
		or (roomType and Locale.T(roomType.Name) or Locale.T("3D view"))
	-- (l'icône de la pièce est déjà dans la pastille du titre)
	local icon = roomType and roomType.Icon or ""
	if icon ~= "" and string.sub(title, 1, #icon) == icon then
		local rest = string.gsub(string.sub(title, #icon + 1), "^%s+", "")
		if rest ~= "" then
			title = rest
		end
	end
	local okDark, darkMode = pcall(function()
		return require(Client.ClientState).DarkMode
	end)
	s.Night = okDark and darkMode == true

	-- Interface de la vue (créée avant de masquer les autres)
	local gui = buildGui(s, title, roomType and roomType.Icon or "🏠")
	s.Gui = gui
	local player = Players.LocalPlayer
	local playerGui = player and player:FindFirstChildOfClass("PlayerGui")
	if playerGui then
		for _, child in ipairs(playerGui:GetChildren()) do
			hideGui(s, child)
		end
		table.insert(s.Connections, playerGui.ChildAdded:Connect(function(child: Instance)
			if s.Alive then
				hideGui(s, child)
			end
		end))
	end

	-- Maquette (une ancienne maquette oubliée est enlevée)
	local stale = workspace:FindFirstChild(House3DScene.FOLDER_NAME)
	if stale then
		stale:Destroy()
	end
	local scene = House3DScene.new(room, options.SizeId, s.Night)
	s.Scene = scene
	s.FrontZ = scene.FrontZ
	s.Focus = scene.Focus
	-- Éclairage : la pièce est bien éclairée quel que soit le réglage du lieu
	saveLighting(s)
	applyLighting(s)
	if playerGui then
		gui.Parent = playerGui
	end

	-- Personnage (monde) : ne marche pas pendant la vue (flèches, ZQSD, saut)
	s.Controls = disableControls()
	pcall(function()
		s.MouseSaved = { Behavior = UserInputService.MouseBehavior, Icon = UserInputService.MouseIconEnabled }
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
	end)

	-- Caméra : arrivée en douceur depuis un peu plus loin, de côté
	s.Viewport = camera.ViewportSize
	computeFit(s)
	s.Yaw, s.Pitch, s.Zoom = math.rad(26), math.rad(34), 1.45
	s.YawT, s.PitchT, s.ZoomT = 0, PITCH_DEFAULT, 1
	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = FOV
	camera.CFrame = orbitCFrame(s.Focus, s.Yaw, s.Pitch, s.Fit * s.Zoom)
	camera.Focus = CFrame.new(s.Focus)
	-- (priorité Last : après les scripts de caméra de Roblox et tous les autres)
	RunService:BindToRenderStep(RENDER_NAME, Enum.RenderPriority.Last.Value, function(dt: number)
		if s.Alive then
			local ok, err = pcall(stepCamera, s, dt)
			if not ok and not s.Warned then
				s.Warned = true
				warn("[House3D] Caméra : " .. tostring(err))
			end
		end
	end)
	s.Bound = true
	-- Un autre script remet la caméra en mode normal : on la reprend tout de suite
	table.insert(s.Connections, camera:GetPropertyChangedSignal("CameraType"):Connect(function()
		if s.Alive and camera.CameraType ~= Enum.CameraType.Scriptable then
			camera.CameraType = Enum.CameraType.Scriptable
		end
	end))

	table.insert(s.Connections, UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if s.Alive then
			onInputBegan(s, input, processed)
		end
	end))
	table.insert(s.Connections, UserInputService.InputChanged:Connect(function(input: InputObject, processed: boolean)
		if s.Alive then
			onInputChanged(s, input, processed)
		end
	end))
	table.insert(s.Connections, UserInputService.InputEnded:Connect(function(input: InputObject)
		if s.Alive then
			onInputEnded(s, input)
		end
	end))
	if player then
		-- Réapparition du personnage : la caméra reste la nôtre (voir stepCamera)
		table.insert(s.Connections, player.CharacterAdded:Connect(function()
			if s.Alive then
				s.Viewport = Vector2.zero
			end
		end))
	end

	-- Objets : construits sur quelques images
	showProgress(s, 0, scene.ItemCount * 2)
	task.spawn(function()
		local ok, err = pcall(scene.BuildItems, function(): boolean
			return s.Alive
		end, function(done: number, total: number)
			if s.Alive then
				showProgress(s, done, total)
			end
		end)
		if not ok then
			warn("[House3D] Objets : " .. tostring(err))
		end
		if s.Alive then
			showProgress(s, 1, 1)
		end
	end)
end

function House3D.IsOpen(): boolean
	return session ~= nil
end

local function closeSession()
	local s = session
	if not s then
		return
	end
	session = nil
	s.Alive = false
	if s.Bound then
		pcall(function()
			RunService:UnbindFromRenderStep(RENDER_NAME)
		end)
	end
	for _, connection in ipairs(s.Connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	table.clear(s.Connections)
	pcall(restoreCamera, s)
	pcall(restoreLighting, s)
	local controls = s.Controls
	if controls then
		s.Controls = nil
		pcall(function()
			controls:Enable()
		end)
	end
	local mouse = s.MouseSaved
	if mouse then
		s.MouseSaved = nil
		pcall(function()
			UserInputService.MouseBehavior = mouse.Behavior
			UserInputService.MouseIconEnabled = mouse.Icon
		end)
	end
	for _, gui in ipairs(s.Hidden) do
		if gui.Parent then
			pcall(function()
				gui.Enabled = true
			end)
		end
	end
	table.clear(s.Hidden)
	local scene = s.Scene
	if scene then
		pcall(scene.Destroy)
	end
	local gui = s.Gui
	if gui then
		pcall(function()
			gui:Destroy()
		end)
	end
	local callback = s.OnClose
	if callback then
		task.spawn(function()
			local ok, err = pcall(callback)
			if not ok then
				warn("[House3D] OnClose : " .. tostring(err))
			end
		end)
	end
end

local function openSession(options: Options?): boolean
	if type(options) ~= "table" or type(options.Room) ~= "table" then
		warn("[House3D] Open : pièce manquante")
		return false
	end
	if session then
		closeSession()
	end
	if session then
		-- (rouverte par OnClose de la vue précédente)
		return true
	end
	local s: Session = {
		Alive = true,
		LightingSaved = {},
		EffectsSaved = {},
		Muted = {},
		Applied = {},
		OnClose = type(options.OnClose) == "function" and options.OnClose or nil,
		Saved = nil,
		Hidden = {},
		Connections = {},
		Controls = nil,
		MouseSaved = nil,
		Bound = false,
		Gui = nil,
		Scene = nil,
		Night = false,
		Yaw = 0,
		Pitch = PITCH_DEFAULT,
		Zoom = 1,
		YawT = 0,
		PitchT = PITCH_DEFAULT,
		ZoomT = 1,
		ZoomMin = ZOOM_MIN,
		Fit = 60,
		Focus = House3DScene.ORIGIN,
		FrontZ = House3DScene.ORIGIN.Z,
		Viewport = Vector2.zero,
		Clock = 0,
		LastInput = 0,
		Auto = false,
		AutoPhase = 0,
		RehideClock = 0,
		Dragging = false,
		DragLast = Vector2.zero,
		Touches = {},
		PinchStart = nil,
		PinchZoom = 1,
		Stick = Vector2.zero,
		Warned = false,
		NightButton = nil,
		Chip = nil,
		ChipBar = nil,
		ChipText = nil,
		TitleCard = nil,
		Toolbar = nil,
		UiScale = 1,
		TopReserve = 80,
		BottomReserve = 100,
	}
	session = s
	local ok, err = pcall(start, s, options)
	if not ok then
		warn("[House3D] Ouverture : " .. tostring(err))
		if session == s then
			House3D.Close()
		end
		return false
	end
	return true
end

-- Fermeture : ne lève jamais d'erreur (chaque étape est protégée)
-- v9.8 🪞 miroirs de l'aperçu (Reflections, REALISM98) : chargé à la demande
local function reflections(): any
	local ok, module = pcall(function()
		local client = script.Parent.Parent.Parent
		local world = client:FindFirstChild("World")
		local found = world and world:FindFirstChild("Reflections")
		return found and require(found :: ModuleScript) or nil
	end)
	return ok and module or nil
end

function House3D.Close()
	local refl = reflections()
	if refl and type(refl.Release) == "function" then
		pcall(refl.Release, "House3D")
	end
	local ok, err = pcall(closeSession)
	if not ok then
		warn("[House3D] Fermeture : " .. tostring(err))
		session = nil
	end
end

-- Ouverture : ne lève jamais d'erreur ; en cas d'échec, tout est remis
-- comme avant (interfaces, caméra) et la fonction renvoie false
function House3D.Open(options: Options?): boolean
	local ok, result = pcall(openSession, options)
	if not ok then
		warn("[House3D] Ouverture : " .. tostring(result))
		House3D.Close()
		return false
	end
	if result == true then
		local refl = reflections()
		if refl and type(refl.Acquire) == "function" then
			pcall(refl.Acquire, "House3D")
		end
	end
	return result == true
end

return House3D
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="41">
            <Properties>
              <string name="Name">House3DCritters</string>
              <string name="Source"><![CDATA[--[[
	House3DCritters (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > House3DCritters

	(v9.3) Animaux et peluches de la vue 3D : de vraies petites figurines
	arrondies (ovales = Part + SpecialMesh "Sphere", boules, tubes) aux
	couleurs du dessin 2D de l'objet : corps, ventre, tête, museau, yeux
	brillants, joues, oreilles, pattes, queue, et les détails de chaque
	espèce (cornes, crinière, ailes, carapace, piquants, tentacules...).
	Les animaux (catégorie Pets) respirent doucement dans la vue 3D.

	Repère : House3DKit.Builder (boîte 2D = 100 unités ; y = hauteur depuis
	le sol ; +z = devant). Branché par House3DRecipes (Register).
	v9.8 (GARDEN98) : les VRAIS animaux (Pets) sont réalistes et articulés
	(voir "ANIMAUX RÉALISTES ARTICULÉS" plus bas) : Client/World/PetRoam les
	fait se promener dans la maison et le jardin. House3DCritters.ROAMERS =
	les espèces qui se promènent.
]]

local House3DKit = require(script.Parent.House3DKit)

type Builder = House3DKit.Builder

local House3DCritters = {}

local M = Enum.Material
local rgb = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)
local INK = rgb(52, 36, 58)
local CHEEK = rgb(255, 150, 175)
local PINK_IN = rgb(255, 196, 214)
local BEAK = rgb(255, 170, 60)
local GOLD = rgb(245, 190, 60)
local GLASS = rgb(200, 235, 255)
local darken = House3DKit.Darken
local lighten = House3DKit.Lighten

-- Couleur principale : la plus grande surface qui n'est pas un contour sombre
local function mainOf(b: Builder, fallback: Color3, allowWhite: boolean?): Color3
	for _, color in ipairs(b.Pal) do
		local _h, s, v = color:ToHSV()
		if v > 0.3 and (s > 0.1 or allowWhite) then
			return color
		end
	end
	return b.Map(fallback)
end

-- n-ième couleur vive de la palette (autre que `avoid`)
local function vivid(b: Builder, n: number, fallback: Color3, avoid: Color3?): Color3
	local count = 0
	for _, color in ipairs(b.Pal) do
		local _h, s, v = color:ToHSV()
		if s > 0.2 and v > 0.35 and (not avoid or House3DKit.Dist(color, avoid) > 0.12) then
			count += 1
			if count == n then
				return color
			end
		end
	end
	return b.Map(fallback)
end

-- z de la face avant d'un ovale (centre c, demi-axes r) au point (x, y)
local function front(cx: number, cy: number, cz: number, rx: number, ry: number, rz: number, x: number, y: number): number
	local u, v = (x - cx) / rx, (y - cy) / ry
	return cz + rz * math.sqrt(math.max(0, 1 - u * u - v * v))
end

type Head = { X: number, Y: number, Z: number, W: number, H: number, D: number }

-- Yeux brillants (+ reflet), joues roses, sur la face avant de la tête
local function face(b: Builder, head: Head, eye: number, spread: number, lift: number, sleepy: boolean?, cheeks: boolean?)
	local rx, ry, rz = head.W / 2, head.H / 2, head.D / 2
	for _, side in ipairs({ -1, 1 }) do
		local ex, ey = head.X + side * spread, head.Y + lift
		local ez = front(head.X, head.Y, head.Z, rx, ry, rz, ex, ey)
		if sleepy then
			b.BoxR(CFrame.new(ex, ey, ez - 0.3) * CFrame.Angles(0, side * 0.35, side * 0.15), eye * 1.2, eye * 0.22, eye * 0.5, INK)
		else
			b.Egg(ex, ey, ez - eye * 0.25, eye, eye * 1.12, eye * 0.7, INK, M.SmoothPlastic)
			b.Ball(ex + side * eye * 0.12, ey + eye * 0.22, ez + eye * 0.1, eye * 0.36, WHITE, M.SmoothPlastic)
		end
		if cheeks ~= false then
			local cx, cy = head.X + side * (spread + eye * 1.1), head.Y + lift - eye * 1.2
			local cz = front(head.X, head.Y, head.Z, rx, ry, rz, cx, cy)
			b.Egg(cx, cy, cz - 0.8, eye * 1.1, eye * 0.62, eye * 0.5, CHEEK, M.SmoothPlastic)
		end
	end
end

-- Museau clair + truffe
local function muzzle(b: Builder, head: Head, w: number, h: number, color: Color3, nose: Color3?)
	local my = head.Y - head.H * 0.14
	local mz = front(head.X, head.Y, head.Z, head.W / 2, head.H / 2, head.D / 2, head.X, my) - h * 0.35
	b.Egg(head.X, my, mz, w, h, h * 0.9, color, M.Fabric)
	b.Egg(head.X, my + h * 0.22, mz + h * 0.42, w * 0.3, h * 0.26, h * 0.26, nose or INK, M.SmoothPlastic)
end

-- Peluche / animal assis : corps, ventre, pattes, bras ; renvoie la tête
type Body = { Color: Color3, Belly: Color3, BW: number, BH: number, BD: number, HeadW: number, HeadH: number, HeadD: number, Feet: Color3? }
local function sitting(b: Builder, body: Body): Head
	local bw, bh, bd = body.BW, body.BH, body.BD
	local by = bh / 2 + 4
	b.Egg(0, by, 0, bw, bh, bd, body.Color, M.Fabric)
	b.Egg(0, by - bh * 0.06, bd * 0.2, bw * 0.64, bh * 0.72, bd * 0.66, body.Belly, M.Fabric)
	local feet = body.Feet or body.Color
	for _, side in ipairs({ -1, 1 }) do
		-- jambes assises (vers l'avant) + coussinets
		b.Egg(side * bw * 0.26, 7, bd * 0.36, bw * 0.3, 14, bd * 0.52, feet, M.Fabric)
		b.Egg(side * bw * 0.26, 7, bd * 0.36 + bd * 0.25, bw * 0.2, 10, 3, lighten(body.Belly, 0.2), M.Fabric)
		-- bras
		b.EggR(CFrame.new(side * bw * 0.44, by + bh * 0.08, bd * 0.18) * CFrame.Angles(0.35, 0, side * 0.35), bw * 0.24, bh * 0.52, bw * 0.24, body.Color, M.Fabric)
	end
	return { X = 0, Y = by + bh / 2 + body.HeadH * 0.36, Z = bd * 0.06, W = body.HeadW, H = body.HeadH, D = body.HeadD }
end

local function head(b: Builder, h: Head, color: Color3)
	b.Egg(h.X, h.Y, h.Z, h.W, h.H, h.D, color, M.Fabric)
end

-- Oreilles
local function roundEars(b: Builder, h: Head, size: number, color: Color3, inner: Color3?)
	for _, side in ipairs({ -1, 1 }) do
		local x, y = h.X + side * h.W * 0.36, h.Y + h.H * 0.38
		b.Egg(x, y, h.Z - 2, size, size, size * 0.6, color, M.Fabric)
		if inner then
			b.Egg(x, y - size * 0.05, h.Z - 2 + size * 0.22, size * 0.58, size * 0.58, size * 0.2, inner, M.Fabric)
		end
	end
end
local function pointyEars(b: Builder, h: Head, w: number, tall: number, color: Color3, inner: Color3?)
	for _, side in ipairs({ -1, 1 }) do
		local x, y = h.X + side * h.W * 0.3, h.Y + h.H * 0.36
		local cf = CFrame.new(x, y + tall / 2, h.Z) * CFrame.Angles(0, 0, -side * 0.28)
		b.Part("WedgePart", cf * CFrame.new(0, 0, -w * 0.25), Vector3.new(w, tall, w * 0.5), color, M.Fabric, "Oreille")
		b.Part("WedgePart", cf * CFrame.Angles(0, math.pi, 0) * CFrame.new(0, 0, -w * 0.25), Vector3.new(w, tall, w * 0.5), color, M.Fabric, "Oreille")
		if inner then
			b.Part("WedgePart", cf * CFrame.new(0, -tall * 0.1, w * 0.26) * CFrame.Angles(0, math.pi, 0), Vector3.new(w * 0.55, tall * 0.7, 0.8), inner, M.Fabric, "Oreille")
		end
	end
end
local function longEars(b: Builder, h: Head, color: Color3, length: number)
	for _, side in ipairs({ -1, 1 }) do
		local cf = CFrame.new(h.X + side * h.W * 0.2, h.Y + h.H * 0.38 + length * 0.42, h.Z - 1) * CFrame.Angles(-0.12, 0, -side * 0.16)
		b.EggR(cf, h.W * 0.24, length, h.W * 0.14, color, M.Fabric)
		b.EggR(cf * CFrame.new(0, -length * 0.02, h.W * 0.05), h.W * 0.13, length * 0.78, h.W * 0.06, PINK_IN, M.Fabric)
	end
end

-- Queue en tubes (points successifs)
local function tail(b: Builder, points: { { number } }, diameter: number, color: Color3, tip: Color3?)
	for index = 1, #points - 1 do
		local a, c = points[index], points[index + 1]
		local d = diameter * (1 - (index - 1) / #points * 0.4)
		b.Tube(a[1], a[2], a[3], c[1], c[2], c[3], d, color, M.Fabric)
		b.Ball(c[1], c[2], c[3], d, (index == #points - 1 and tip) or color, M.Fabric)
	end
end

----------------------------------------------------------------------
-- Espèces
----------------------------------------------------------------------

local R: { [string]: (b: Builder, ctx: any) -> () } = {}

local function bear(big: boolean, bow: boolean)
	return function(b: Builder, _ctx: any)
		local fur = mainOf(b, rgb(214, 150, 100))
		local belly = lighten(fur, 0.45)
		local h = sitting(b, { Color = fur, Belly = belly, BW = 60, BH = 48, BD = 50, HeadW = 52, HeadH = 46, HeadD = 44 })
		head(b, h, fur)
		roundEars(b, h, 18, fur, belly)
		muzzle(b, h, 20, 14, belly)
		face(b, h, 6.5, 10, 2)
		if bow then
			local ribbon = vivid(b, 2, rgb(255, 110, 150), fur)
			local y = h.Y - h.H * 0.48
			for _, side in ipairs({ -1, 1 }) do
				b.EggR(CFrame.new(side * 7, y, 20) * CFrame.Angles(0, 0, side * 0.3), 14, 9, 5, ribbon, M.Fabric)
			end
			b.Ball(0, y, 22, 6, darken(ribbon, 0.1), M.Fabric)
		end
		if big then
			-- grand nounours : un cœur sur le ventre
			local heart = vivid(b, 2, rgb(255, 110, 150), fur)
			b.EggR(CFrame.new(-3, 30, 27) * CFrame.Angles(0, 0, 0.6), 9, 12, 3, heart, M.Fabric)
			b.EggR(CFrame.new(3, 30, 27) * CFrame.Angles(0, 0, -0.6), 9, 12, 3, heart, M.Fabric)
		end
		b.Seat(0, 30, 0, 40, 30)
		b.Footprint(66, 56, 98)
	end
end
R.TeddyBear = bear(false, true)
R.BigBear = bear(true, false)

R.PandaPlush = function(b, _ctx)
	local white = rgb(250, 250, 252)
	local black = rgb(46, 42, 54)
	local h = sitting(b, { Color = white, Belly = white, BW = 60, BH = 48, BD = 50, HeadW = 54, HeadH = 46, HeadD = 44, Feet = black })
	head(b, h, white)
	roundEars(b, h, 18, black)
	-- bras noirs + taches des yeux
	for _, side in ipairs({ -1, 1 }) do
		b.EggR(CFrame.new(side * 26, 34, 11) * CFrame.Angles(0.35, 0, side * 0.35), 15, 26, 15, black, M.Fabric)
		local x, y = side * 11, h.Y + 2
		b.EggR(CFrame.new(x, y, front(h.X, h.Y, h.Z, h.W / 2, h.H / 2, h.D / 2, x, y) - 2.5) * CFrame.Angles(0, 0, side * -0.5), 13, 16, 5, black, M.Fabric)
	end
	muzzle(b, h, 18, 12, white)
	face(b, h, 5.5, 11, 3, false, true)
	b.Seat(0, 30, 0, 40, 30)
	b.Footprint(66, 56, 96)
end

local function bunny(pet: boolean)
	return function(b: Builder, _ctx: any)
		local fur = mainOf(b, rgb(250, 246, 250), true)
		local belly = lighten(fur, 0.5)
		local h = sitting(b, { Color = fur, Belly = belly, BW = 56, BH = 44, BD = 50, HeadW = 46, HeadH = 40, HeadD = 40 })
		head(b, h, fur)
		longEars(b, h, fur, pet and 34 or 40)
		muzzle(b, h, 16, 11, belly, rgb(255, 140, 170))
		face(b, h, 5.5, 9, 2)
		b.Ball(0, 16, -26, 16, WHITE, M.Fabric) -- queue pompon
		b.Footprint(62, 58, 98)
	end
end
R.BunnyPlush = bunny(false)
R.Bunny = bunny(true)

local function cat(sleepy: boolean, calico: boolean?)
	return function(b: Builder, _ctx: any)
		local fur = mainOf(b, rgb(255, 196, 150))
		local belly = lighten(fur, 0.55)
		local patch = vivid(b, 2, darken(fur, 0.25), fur)
		if sleepy then
			-- chat couché en boule
			b.Egg(0, 17, 0, 84, 32, 54, fur, M.Fabric)
			b.Egg(0, 14, 14, 60, 22, 30, belly, M.Fabric)
			local h: Head = { X = 24, Y = 26, Z = 14, W = 40, H = 32, D = 34 }
			head(b, h, fur)
			pointyEars(b, h, 12, 13, fur, PINK_IN)
			face(b, h, 5, 8, 1, true)
			b.Egg(h.X, h.Y - 5, front(h.X, h.Y, h.Z, 20, 16, 17, h.X, h.Y - 5) - 1, 5, 3.5, 3, rgb(255, 130, 160), M.SmoothPlastic)
			tail(b, { { -38, 14, 0 }, { -40, 10, 18 }, { -26, 8, 28 }, { -8, 8, 30 } }, 9, fur, patch)
			for _, x in ipairs({ -2, 12 }) do
				b.Egg(x, 6, 26, 12, 9, 14, belly, M.Fabric)
			end
			b.Footprint(90, 60, 46)
			return
		end
		local h = sitting(b, { Color = fur, Belly = belly, BW = 54, BH = 46, BD = 46, HeadW = 50, HeadH = 42, HeadD = 40 })
		head(b, h, fur)
		pointyEars(b, h, 16, 18, fur, PINK_IN)
		face(b, h, 6.5, 10, 2)
		local nz = front(h.X, h.Y, h.Z, h.W / 2, h.H / 2, h.D / 2, 0, h.Y - 6)
		b.Egg(0, h.Y - 6, nz - 1, 6, 4, 3, rgb(255, 130, 160), M.SmoothPlastic)
		for _, side in ipairs({ -1, 1 }) do
			for _, dy in ipairs({ -1, 2 }) do
				b.BoxR(CFrame.new(side * 22, h.Y - 6 + dy, nz - 4) * CFrame.Angles(0, 0, side * dy * 0.06), 14, 0.8, 0.8, INK)
			end
		end
		-- patchs de couleur (chaton calico) + queue relevée
		if calico then
			b.Egg(-14, h.Y + 12, h.Z + 8, 18, 14, 22, patch, M.Fabric)
		else
			patch = lighten(fur, 0.4)
		end
		tail(b, { { -18, 12, -20 }, { -30, 24, -26 }, { -34, 44, -22 }, { -26, 58, -18 } }, 9, fur, patch)
		b.Footprint(60, 54, 96)
	end
end
R.KittyPlush = cat(false)
R.Kitten = cat(false, true)
R.SleepyCat = cat(true)

local function dog(plush: boolean)
	return function(b: Builder, _ctx: any)
		local fur = mainOf(b, rgb(236, 200, 160))
		local belly = lighten(fur, 0.5)
		local ear = darken(fur, 0.28)
		local h = sitting(b, { Color = fur, Belly = belly, BW = 56, BH = 46, BD = 50, HeadW = 50, HeadH = 42, HeadD = 42 })
		head(b, h, fur)
		for _, side in ipairs({ -1, 1 }) do
			b.EggR(CFrame.new(side * 25, h.Y - 2, h.Z) * CFrame.Angles(0, 0, side * 0.35), 13, 30, 12, ear, M.Fabric)
		end
		muzzle(b, h, 22, 15, belly)
		face(b, h, 6, 10, 4)
		b.EggR(CFrame.new(0, h.Y - 15, front(h.X, h.Y, h.Z, 25, 21, 21, 0, h.Y - 15) + 1) * CFrame.Angles(0.4, 0, 0), 7, 8, 3, rgb(255, 120, 150), M.SmoothPlastic)
		-- collier + médaille
		local collar = vivid(b, 2, rgb(255, 90, 120), fur)
		b.Egg(0, h.Y - h.H * 0.52, 2, 40, 6, 36, collar, M.Fabric)
		b.Ball(0, h.Y - h.H * 0.52 - 4, 20, 6, GOLD, M.Metal)
		tail(b, { { 0, 14, -24 }, { 6, 24, -32 }, { 10, 34, -30 } }, plush and 10 or 8, fur, belly)
		b.Footprint(64, 58, 96)
	end
end
R.PuppyPlush = dog(true)
R.Puppy = dog(false)

R.Fox = function(b, _ctx)
	local fur = mainOf(b, rgb(255, 140, 70))
	local cream = rgb(255, 246, 236)
	local h = sitting(b, { Color = fur, Belly = cream, BW = 52, BH = 44, BD = 46, HeadW = 50, HeadH = 40, HeadD = 42, Feet = rgb(70, 50, 60) })
	head(b, h, fur)
	pointyEars(b, h, 16, 20, fur, rgb(70, 50, 60))
	-- museau pointu blanc
	local mz = front(h.X, h.Y, h.Z, 25, 20, 21, 0, h.Y - 6)
	b.Egg(0, h.Y - 6, mz - 2, 26, 16, 16, cream, M.Fabric)
	b.Ball(0, h.Y - 4, mz + 6, 5, INK, M.SmoothPlastic)
	face(b, h, 5.5, 11, 4)
	-- grosse queue touffue au bout blanc
	b.EggR(CFrame.new(-26, 24, -18) * CFrame.Angles(0, 0.3, 0.9), 22, 50, 22, fur, M.Fabric)
	b.EggR(CFrame.new(-40, 44, -24) * CFrame.Angles(0, 0.3, 0.9), 16, 18, 16, cream, M.Fabric)
	b.Footprint(80, 56, 92)
end

R.HamsterPlush = function(b, _ctx)
	local fur = mainOf(b, rgb(255, 200, 140))
	local cream = rgb(255, 246, 232)
	b.Egg(0, 30, 0, 72, 58, 58, fur, M.Fabric)
	b.Egg(0, 26, 12, 50, 44, 40, cream, M.Fabric)
	local h: Head = { X = 0, Y = 46, Z = 4, W = 70, H = 46, D = 54 }
	for _, side in ipairs({ -1, 1 }) do
		b.Egg(side * 22, 40, 22, 24, 20, 16, cream, M.Fabric) -- bajoues
		b.Egg(side * 22, 70, 0, 16, 16, 8, fur, M.Fabric)
		b.Egg(side * 22, 70, 2, 9, 9, 6, PINK_IN, M.Fabric)
		b.Egg(side * 10, 8, 22, 12, 8, 12, PINK_IN, M.Fabric)
		b.Egg(side * 20, 30, 26, 10, 12, 8, PINK_IN, M.Fabric) -- menottes
	end
	face(b, h, 6.5, 12, 4)
	b.Ball(0, 45, 32, 5, rgb(255, 130, 160), M.SmoothPlastic)
	b.Footprint(72, 60, 76)
end

-- Roue du hamster (+ hamster dedans)
R.Hamster = function(b, _ctx)
	local frame = vivid(b, 1, rgb(120, 200, 255))
	local fur = rgb(255, 196, 130)
	b.Round(0, 0, 0, 80, 5, 50, 6, darken(frame, 0.2), M.SmoothPlastic)
	-- support derrière la roue ; la roue regarde la pièce (axe vers +z)
	for _, side in ipairs({ -1, 1 }) do
		b.Tube(side * 30, 5, -16, 0, 48, -16, 4, frame, M.SmoothPlastic)
	end
	local cy, r = 48, 36
	for index = 0, 15 do
		local a0, a1 = index / 16 * math.pi * 2, (index + 1) / 16 * math.pi * 2
		for _, z in ipairs({ -10, 10 }) do
			b.Tube(math.cos(a0) * r, cy + math.sin(a0) * r, z, math.cos(a1) * r, cy + math.sin(a1) * r, z, 3.5, frame, M.SmoothPlastic)
		end
		if index % 2 == 0 then
			b.Tube(math.cos(a0) * r, cy + math.sin(a0) * r, -10, math.cos(a0) * r, cy + math.sin(a0) * r, 10, 2, WHITE, M.Metal)
		end
	end
	for index = 0, 3 do
		local a = index / 4 * math.pi
		b.Tube(math.cos(a) * r, cy + math.sin(a) * r, -10, -math.cos(a) * r, cy - math.sin(a) * r, -10, 1.5, frame, M.SmoothPlastic)
	end
	b.CylZ(0, cy, -12, 8, 8, GOLD, M.Metal)
	-- hamster qui court en bas de la roue
	b.Egg(-4, 24, 0, 28, 20, 20, fur, M.Fabric)
	b.Egg(10, 28, 2, 18, 17, 18, fur, M.Fabric)
	b.Egg(12, 25, 9, 10, 9, 6, rgb(255, 246, 232), M.Fabric)
	for _, side in ipairs({ -1, 1 }) do
		b.Ball(9 + side * 4, 31, 10, 3.5, INK, M.SmoothPlastic)
		b.Ball(6 + side * 5, 37, 2, 7, PINK_IN, M.Fabric)
		b.Egg(-4 + side * 8, 15, 6, 6, 5, 6, PINK_IN, M.Fabric)
	end
	b.Footprint(80, 40, 86)
end

-- Grenouille
R.FroggyPlush = function(b, _ctx)
	local green = mainOf(b, rgb(120, 210, 110))
	local belly = rgb(236, 250, 200)
	b.Egg(0, 24, 0, 66, 42, 54, green, M.Fabric)
	b.Egg(0, 22, 14, 44, 30, 34, belly, M.Fabric)
	local h: Head = { X = 0, Y = 50, Z = 4, W = 70, H = 36, D = 50 }
	head(b, h, green)
	for _, side in ipairs({ -1, 1 }) do
		b.Ball(side * 17, 68, 8, 22, green, M.Fabric)
		b.Ball(side * 17, 69, 17, 13, WHITE, M.SmoothPlastic)
		b.Ball(side * 17, 69, 22, 7, INK, M.SmoothPlastic)
		b.Ball(side * 15, 71, 25, 2.5, WHITE, M.SmoothPlastic)
		b.Egg(side * 26, 46, 22, 10, 6, 4, CHEEK, M.SmoothPlastic)
		b.Egg(side * 24, 6, 20, 22, 8, 22, green, M.Fabric) -- pattes palmées
		b.EggR(CFrame.new(side * 32, 24, 12) * CFrame.Angles(0.3, 0, side * 0.4), 12, 24, 12, green, M.Fabric)
	end
	-- grand sourire
	b.BoxR(CFrame.new(0, 45, 28.5) * CFrame.Angles(0, 0, 0), 22, 1.6, 1, INK)
	b.Footprint(72, 60, 80)
end

-- Dinosaures
local function dino(rex: boolean)
	return function(b: Builder, _ctx: any)
		local skin = mainOf(b, rgb(120, 200, 130))
		local belly = lighten(skin, 0.55)
		local spike = vivid(b, 2, rgb(255, 170, 90), skin)
		b.Egg(0, 30, 0, 52, 50, 50, skin, M.Fabric)
		b.Egg(0, 28, 14, 34, 38, 26, belly, M.Fabric)
		for _, side in ipairs({ -1, 1 }) do
			b.Egg(side * 16, 8, 8, 18, 16, 26, skin, M.Fabric)
			b.EggR(CFrame.new(side * 20, 38, 18) * CFrame.Angles(0.9, 0, side * 0.2), 8, 14, 8, skin, M.Fabric) -- petits bras
		end
		-- tête allongée
		local h: Head = { X = 0, Y = rex and 66 or 62, Z = 8, W = 44, H = 36, D = 40 }
		head(b, h, skin)
		b.Egg(0, h.Y - 8, h.Z + 16, 32, 16, 26, skin, M.Fabric)
		b.Egg(0, h.Y - 12, h.Z + 18, 26, 6, 22, belly, M.Fabric)
		face(b, h, 6.5, 11, 6)
		for _, side in ipairs({ -1, 1 }) do
			b.Ball(side * 5, h.Y - 3, h.Z + 28, 3, darken(skin, 0.35), M.SmoothPlastic)
		end
		if rex then
			for index = 0, 4 do
				b.Part("WedgePart", CFrame.new(-9 + index * 4.5, h.Y - 16, h.Z + 27) * CFrame.Angles(math.pi, 0, 0), Vector3.new(2.4, 3, 1.5), WHITE, M.SmoothPlastic, "Dent")
			end
		end
		-- queue
		b.EggR(CFrame.new(0, 18, -30) * CFrame.Angles(-0.5, 0, 0), 26, 22, 30, skin, M.Fabric)
		b.EggR(CFrame.new(0, 10, -48) * CFrame.Angles(-0.4, 0, 0), 14, 12, 22, skin, M.Fabric)
		-- piquants dans le dos
		for index = 0, 5 do
			local y = 80 - index * 12
			local z = -4 - index * 7
			if index == 0 then
				y, z = h.Y + 16, h.Z - 10
			end
			b.Part("WedgePart", CFrame.new(0, y, z) * CFrame.Angles(0, 0, 0), Vector3.new(3, 9, 9), spike, M.Fabric, "Piquant")
		end
		b.Footprint(56, 76, 90)
	end
end
R.DinoPlush = dino(false)
R.TRexPlush = dino(true)

-- Oiseaux
local function bird(kind: string)
	return function(b: Builder, _ctx: any)
		local feather = mainOf(b, kind == "Penguin" and rgb(60, 70, 110) or rgb(255, 220, 90))
		local belly = kind == "Penguin" and WHITE or lighten(feather, 0.55)
		local beak = BEAK
		if kind == "Penguin" then
			b.Egg(0, 34, 0, 54, 64, 48, feather, M.Fabric)
			b.Egg(0, 32, 12, 38, 52, 28, belly, M.Fabric)
			local h: Head = { X = 0, Y = 66, Z = 2, W = 46, H = 38, D = 40 }
			head(b, h, feather)
			b.Egg(0, 62, 16, 30, 24, 16, WHITE, M.Fabric)
			face(b, { X = 0, Y = 66, Z = 4, W = 44, H = 36, D = 40 }, 5.5, 8, 2)
			b.Part("WedgePart", CFrame.new(0, 60, 23) * CFrame.Angles(-math.pi / 2, 0, 0), Vector3.new(8, 8, 4), beak, M.SmoothPlastic, "Bec")
			for _, side in ipairs({ -1, 1 }) do
				b.EggR(CFrame.new(side * 27, 36, 2) * CFrame.Angles(0, 0, side * 0.3), 8, 34, 16, feather, M.Fabric)
				b.Egg(side * 10, 3, 14, 14, 5, 20, beak, M.SmoothPlastic)
			end
			local scarf = vivid(b, 2, rgb(255, 110, 140), feather)
			b.Egg(0, 50, 2, 48, 8, 42, scarf, M.Fabric)
			b.Footprint(58, 50, 88)
			return
		end
		if kind == "Owl" then
			b.Egg(0, 34, 0, 58, 66, 50, feather, M.Fabric)
			b.Egg(0, 30, 12, 40, 44, 30, belly, M.Fabric)
			for _, side in ipairs({ -1, 1 }) do
				b.Egg(side * 12, 52, 20, 20, 20, 8, WHITE, M.SmoothPlastic)
				b.Ball(side * 12, 52, 24, 10, INK, M.SmoothPlastic)
				b.Ball(side * 10, 55, 27, 3.5, WHITE, M.SmoothPlastic)
				b.Part("WedgePart", CFrame.new(side * 18, 70, 2), Vector3.new(8, 12, 8), darken(feather, 0.2), M.Fabric, "Aigrette")
				b.EggR(CFrame.new(side * 28, 34, 0) * CFrame.Angles(0, 0, side * 0.2), 10, 38, 26, darken(feather, 0.15), M.Fabric)
				b.Egg(side * 9, 3, 12, 10, 5, 12, beak, M.SmoothPlastic)
			end
			b.Part("WedgePart", CFrame.new(0, 45, 25) * CFrame.Angles(-math.pi / 2, 0, 0), Vector3.new(6, 6, 6), beak, M.SmoothPlastic, "Bec")
			-- branche
			b.CylX(0, 0.5, 0, 6, 70, rgb(150, 100, 70), M.Wood)
			b.Footprint(70, 50, 76)
			return
		end
		-- poussin / caneton / canard de bain / perroquet
		local round = kind == "Chick" or kind == "Duck"
		b.Egg(0, 26, 0, 56, 46, 50, feather, M.SmoothPlastic)
		if kind == "Duck" then
			b.Egg(-4, 34, -16, 34, 24, 26, feather, M.SmoothPlastic)
		end
		local h: Head = { X = 0, Y = round and 60 or 62, Z = kind == "Duck" and 12 or 6, W = 40, H = 38, D = 38 }
		head(b, h, feather)
		face(b, h, 5.5, 8, 3, false, true)
		local bz = front(h.X, h.Y, h.Z, 20, 19, 19, 0, h.Y - 6)
		b.Egg(0, h.Y - 6, bz + 1, 16, 7, 12, beak, M.SmoothPlastic)
		for _, side in ipairs({ -1, 1 }) do
			b.EggR(CFrame.new(side * 27, 30, 0) * CFrame.Angles(0, 0, side * 0.5), 8, 26, 24, darken(feather, 0.06), M.SmoothPlastic)
			if kind ~= "Duck" then
				b.Egg(side * 10, 3, 10, 10, 5, 14, beak, M.SmoothPlastic)
			end
		end
		if kind == "Chick" then
			for index = -1, 1 do
				b.EggR(CFrame.new(index * 3, h.Y + 19, h.Z) * CFrame.Angles(0, 0, index * 0.4), 3, 10, 3, feather, M.SmoothPlastic)
			end
		elseif kind == "Duck" then
			-- petite vague d'eau sous le canard de bain
			local water = b.Egg(0, 3, 0, 80, 8, 64, rgb(150, 210, 255), M.Glass)
			water.Transparency = 0.3
		end
		b.Footprint(62, 56, 82)
	end
end
R.Chick = bird("Chick")
R.Duckling = bird("Chick")
R.RubberDucky = bird("Duck")
R.PenguinPlush = bird("Penguin")
R.Penguin = bird("Penguin")
R.Owl = bird("Owl")

-- Perroquet sur son perchoir
R.Parrot = function(b, _ctx)
	local red = mainOf(b, rgb(240, 70, 80))
	local wing = vivid(b, 2, rgb(80, 150, 255), red)
	local yellow = vivid(b, 3, rgb(255, 210, 70), red)
	local wood = rgb(170, 120, 80)
	b.Cyl(0, 0, 0, 44, 5, darken(wood, 0.2), M.Wood)
	b.Cyl(0, 5, 0, 5, 58, wood, M.Wood)
	b.CylX(0, 62, 0, 5, 50, wood, M.Wood)
	b.Cyl(-22, 58, 0, 12, 4, rgb(220, 220, 230), M.Metal) -- gamelle
	-- oiseau
	b.EggR(CFrame.new(4, 76, 0) * CFrame.Angles(0, 0, -0.25), 22, 30, 22, red, M.SmoothPlastic)
	b.Ball(6, 92, 2, 18, red, M.SmoothPlastic)
	b.Egg(6, 90, 9, 12, 10, 6, WHITE, M.SmoothPlastic)
	b.Ball(10, 93, 10, 4, INK, M.SmoothPlastic)
	b.Ball(2, 93, 10, 4, INK, M.SmoothPlastic)
	b.EggR(CFrame.new(6, 86, 13) * CFrame.Angles(0.5, 0, 0), 6, 9, 7, rgb(60, 50, 60), M.SmoothPlastic)
	for _, side in ipairs({ -1, 1 }) do
		b.EggR(CFrame.new(4 + side * 11, 74, -2) * CFrame.Angles(0.2, 0, side * 0.3), 7, 24, 16, wing, M.SmoothPlastic)
	end
	b.EggR(CFrame.new(-2, 56, -6) * CFrame.Angles(0.35, 0, -0.1), 8, 26, 5, yellow, M.SmoothPlastic)
	b.Footprint(50, 44, 102)
end

R.Turtle = function(b, _ctx)
	local shell = vivid(b, 1, rgb(110, 190, 120))
	local skin = rgb(190, 230, 160)
	b.Egg(0, 18, 0, 64, 34, 58, shell, M.SmoothPlastic)
	b.Egg(0, 10, 0, 70, 10, 62, darken(shell, 0.2), M.SmoothPlastic)
	for index = 0, 5 do
		local a = index / 6 * math.pi * 2
		b.Egg(math.cos(a) * 16, 28, math.sin(a) * 14, 14, 6, 12, lighten(shell, 0.25), M.SmoothPlastic)
	end
	b.Egg(0, 33, 0, 16, 5, 14, lighten(shell, 0.25), M.SmoothPlastic)
	local h: Head = { X = 0, Y = 18, Z = 36, W = 24, H = 22, D = 22 }
	head(b, h, skin)
	face(b, h, 4, 5, 2)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			b.Egg(sx * 26, 5, sz * 20, 14, 9, 16, skin, M.SmoothPlastic)
		end
	end
	b.Footprint(70, 72, 36)
end

R.Hedgehog = function(b, _ctx)
	local spikes = mainOf(b, rgb(150, 100, 80))
	local face_ = rgb(255, 226, 196)
	b.Egg(0, 24, -4, 64, 44, 58, spikes, M.Fabric)
	-- piquants (petites pentes tout autour du dos)
	for row = 0, 2 do
		for index = 0, 6 do
			local a = (index / 6 - 0.5) * 2.4
			local y = 30 + row * 8
			local z = -4 - row * 8
			b.Part("WedgePart", CFrame.new(math.sin(a) * (26 - row * 6), y + math.cos(a) * 8, z) * CFrame.Angles(-0.6, 0, -a * 0.8), Vector3.new(6, 12, 6), darken(spikes, 0.2), M.Fabric, "Piquant")
		end
	end
	local h: Head = { X = 0, Y = 22, Z = 22, W = 34, H = 30, D = 30 }
	head(b, h, face_)
	b.Egg(0, 18, 36, 12, 9, 12, face_, M.Fabric)
	b.Ball(0, 20, 42, 5, INK, M.SmoothPlastic)
	face(b, h, 4.5, 8, 3)
	for _, side in ipairs({ -1, 1 }) do
		b.Ball(side * 12, 36, 20, 9, face_, M.Fabric)
		b.Egg(side * 14, 4, 14, 10, 7, 12, face_, M.Fabric)
	end
	b.Footprint(66, 64, 56)
end

R.UnicornPlush = function(b, _ctx)
	local white = rgb(252, 250, 255)
	local mane = { vivid(b, 1, rgb(255, 150, 200)), vivid(b, 2, rgb(170, 150, 255)), vivid(b, 3, rgb(140, 220, 255)) }
	local h = sitting(b, { Color = white, Belly = rgb(255, 240, 250), BW = 54, BH = 46, BD = 48, HeadW = 46, HeadH = 42, HeadD = 44 })
	head(b, h, white)
	b.Egg(0, h.Y - 8, h.Z + 14, 26, 18, 22, rgb(255, 232, 244), M.Fabric)
	face(b, h, 6, 10, 4)
	pointyEars(b, h, 12, 14, white, PINK_IN)
	-- corne dorée (cylindres de plus en plus fins)
	for index = 0, 3 do
		b.Cyl(0, h.Y + h.H * 0.42 + index * 5, h.Z + 6 - index * 0.5, 9 - index * 2, 5.2, GOLD, M.Metal)
	end
	-- crinière arc-en-ciel
	for index = 0, 5 do
		b.Ball(-4 + (index % 2) * 3, h.Y + 18 - index * 8, h.Z - 16 - index * 2, 14, mane[index % 3 + 1], M.Fabric)
	end
	tail(b, { { 0, 14, -22 }, { -8, 22, -32 }, { -4, 34, -36 } }, 12, mane[1], mane[2])
	b.Footprint(62, 60, 100)
end

R.WhalePlush = function(b, _ctx)
	local blue = mainOf(b, rgb(120, 170, 255))
	local belly = rgb(236, 244, 255)
	b.Egg(0, 30, 0, 90, 56, 58, blue, M.Fabric)
	b.Egg(8, 20, 8, 70, 30, 48, belly, M.Fabric)
	for _, side in ipairs({ -1, 1 }) do
		b.EggR(CFrame.new(-50, 42, side * 10) * CFrame.Angles(side * 0.6, 0, 0.5), 10, 12, 24, blue, M.Fabric)
		b.EggR(CFrame.new(8, 16, side * 30) * CFrame.Angles(0, 0, 0.5), 20, 8, 12, blue, M.Fabric)
		b.Ball(26, 38, side * 24, 6, INK, M.SmoothPlastic)
		b.Ball(27, 40, side * 26.5, 2, WHITE, M.SmoothPlastic)
		b.Egg(30, 30, side * 24, 7, 4, 4, CHEEK, M.SmoothPlastic)
	end
	-- jet d'eau
	b.Tube(10, 58, 0, 10, 70, 0, 3, rgb(170, 220, 255), M.Glass)
	for _, dx in ipairs({ -5, 5 }) do
		b.Ball(10 + dx, 72, 0, 7, rgb(190, 230, 255), M.Glass)
	end
	b.Footprint(100, 62, 76)
end

R.OctopusPlush = function(b, _ctx)
	local pink = mainOf(b, rgb(255, 140, 170))
	b.Egg(0, 52, -2, 62, 60, 56, pink, M.Fabric)
	for index = 0, 7 do
		local a = index / 8 * math.pi * 2 + 0.2
		local x, z = math.cos(a), math.sin(a)
		b.Tube(x * 14, 26, z * 12, x * 30, 10, z * 26, 13, pink, M.Fabric)
		b.Tube(x * 30, 10, z * 26, x * 38, 7, z * 36, 10, pink, M.Fabric)
		b.Ball(x * 38, 8, z * 36, 11, lighten(pink, 0.25), M.Fabric)
	end
	local h: Head = { X = 0, Y = 46, Z = -2, W = 62, H = 60, D = 56 }
	face(b, h, 7, 11, 0)
	b.Egg(0, 36, front(0, 46, -2, 31, 30, 28, 0, 36) - 1, 8, 5, 3, rgb(200, 80, 110), M.SmoothPlastic)
	b.Footprint(80, 78, 84)
end

R.NinjaPlush = function(b, _ctx)
	local suit = b.Map(rgb(70, 72, 104))
	local skin = rgb(255, 226, 200)
	local band = vivid(b, 2, rgb(240, 70, 80), suit)
	local h = sitting(b, { Color = suit, Belly = darken(suit, 0.15), BW = 54, BH = 44, BD = 46, HeadW = 50, HeadH = 46, HeadD = 44 })
	head(b, h, suit)
	-- fente des yeux (visage) + bandeau et ses rubans
	local fz = front(h.X, h.Y, h.Z, 25, 23, 22, 0, h.Y + 1)
	b.Egg(0, h.Y + 1, fz - 4, 38, 12, 12, skin, M.Fabric)
	face(b, h, 5.5, 9, 1, false, false)
	b.Egg(0, h.Y + 12, h.Z, h.W + 2, 6, h.D + 2, band, M.Fabric)
	for _, side in ipairs({ -1, 1 }) do
		b.EggR(CFrame.new(side * 6, h.Y + 8, h.Z - 26) * CFrame.Angles(0.4, 0, side * 0.5), 6, 18, 3, band, M.Fabric)
	end
	b.Egg(0, 30, 2, 58, 6, 50, band, M.Fabric) -- ceinture
	b.Footprint(62, 56, 96)
end

R.PiggyBank = function(b, _ctx)
	local pink = mainOf(b, rgb(255, 170, 200))
	b.Egg(0, 38, 0, 84, 62, 62, pink, M.SmoothPlastic)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			b.Cyl(sx * 22, 0, sz * 16, 14, 14, darken(pink, 0.08), M.SmoothPlastic)
		end
		b.Part("WedgePart", CFrame.new(28, 66, sx * 14) * CFrame.Angles(0, -math.pi / 2, 0), Vector3.new(12, 12, 8), darken(pink, 0.1), M.SmoothPlastic, "Oreille")
		b.Ball(34, 50, sx * 12, 6, INK, M.SmoothPlastic)
		b.Ball(35, 52, sx * 13.5, 2, WHITE, M.SmoothPlastic)
	end
	b.CylX(44, 40, 0, 20, 8, lighten(pink, 0.15), M.SmoothPlastic)
	for _, dz in ipairs({ -4, 4 }) do
		b.CylX(48.5, 40, dz, 4, 1, darken(pink, 0.35), M.SmoothPlastic)
	end
	b.Box(-4, 68, 0, 18, 2, 3, INK) -- fente à pièces
	b.Cyl(-2, 69, 0, 9, 2, GOLD, M.Metal)
	tail(b, { { -42, 42, 0 }, { -48, 48, 4 }, { -46, 54, -2 } }, 4, pink)
	b.Footprint(96, 64, 72)
end

-- Bébé dragon
R.Dragon = function(b, _ctx)
	local scale = mainOf(b, rgb(150, 110, 230))
	local belly = rgb(255, 226, 170)
	local wing = vivid(b, 2, rgb(255, 150, 200), scale)
	local h = sitting(b, { Color = scale, Belly = belly, BW = 52, BH = 48, BD = 46, HeadW = 46, HeadH = 40, HeadD = 44 })
	head(b, h, scale)
	b.Egg(0, h.Y - 8, h.Z + 14, 28, 18, 24, scale, M.SmoothPlastic)
	for _, side in ipairs({ -1, 1 }) do
		b.Ball(side * 5, h.Y - 5, h.Z + 26, 3, INK, M.SmoothPlastic)
		-- cornes
		b.Tube(side * 10, h.Y + 16, h.Z - 6, side * 14, h.Y + 28, h.Z - 12, 5, belly, M.SmoothPlastic)
		-- ailes (voiles triangulaires)
		local cf = CFrame.new(side * 26, 52, -16) * CFrame.Angles(0.2, side * -0.6, side * -0.5)
		b.Part("WedgePart", cf, Vector3.new(2, 30, 26), wing, M.SmoothPlastic, "Aile")
		b.Tube(side * 18, 46, -12, side * 34, 66, -24, 3, scale, M.SmoothPlastic)
	end
	face(b, h, 6.5, 10, 6)
	-- queue à pointe
	tail(b, { { 0, 12, -20 }, { 16, 8, -34 }, { 32, 10, -32 } }, 12, scale)
	b.Part("WedgePart", CFrame.new(38, 12, -30) * CFrame.Angles(0, -math.pi / 2, -math.pi / 2), Vector3.new(10, 10, 6), wing, M.SmoothPlastic, "Pointe")
	-- petites plaques dans le dos
	for index = 0, 3 do
		b.Part("WedgePart", CFrame.new(0, 60 - index * 11, -18 - index * 3), Vector3.new(2.5, 7, 7), wing, M.SmoothPlastic, "Plaque")
	end
	b.Footprint(76, 60, 100)
end

-- Bocaux (poisson rouge, axolotl)

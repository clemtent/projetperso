  <Item class="ServerScriptService" referent="352">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="353">
      <Properties>
        <string name="Name">Main</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	Main (Script)
	Emplacement : ServerScriptService > Main

	Point d'entrée du serveur :
	  1. crée les RemoteEvents / RemoteFunctions (Net.Setup) ;
	  2. initialise puis démarre tous les services ;
	  3. gère l'arrivée et le départ des joueurs.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
Net.Setup() -- AVANT tout le reste : les clients attendent ces remotes

-- Jeu 100 % interface 2D : pas de personnage (sinon il bouge en fond avec ZQSD / espace)
Players.CharacterAutoLoads = false

local ServicesFolder = script.Parent:WaitForChild("Services")

-- Ordre important : les données d'abord, puis le jeu, puis le reste
-- (PlayerReady est appelé dans cet ordre : QuestService a besoin des stats,
-- DVDService crée les logos avant la synchro complète)
-- (MonetizationService vérifie les Game Passes, ThemeService en a besoin)
-- (HouseService corrige la maison avant QuestService : le confort compte dans les stats)
local ORDER = {
	"DataService",
	"GameService",
	"MonetizationService",
	"ThemeService",
	"EventService",
	"DVDService",
	"InteractService",
	"CasinoService",
	"LootService",
	"GardenService",
	"MinigameService",
	"ChatService",
	"FriendMailService", -- mails entre amis Roblox (après ChatService ; lit data.FriendMail)
	"CosmeticService",
	"HouseService",
	"WorldService", -- 🚶 Dopamine Town (après HouseService : la maison est déjà corrigée)
	"CarService", -- 🚗 voitures + garage du manoir (v9.6 ; après WorldService : conduite en ville seulement)
	"ImpactService", -- 💥 v10 collisions réalistes, se faire renverser (après CarService / WorldService)
	"FoodService", -- 🍦 nourriture de la ville + boost (v9.8 ; après CarService, avant QuestService)
	"RaceService", -- 🏁 courses de rue (v10 ; après CarService : RaceSpawn / SetFrozen / RaceRelease)
	"QuestService",
	"AchievementService",
	"DailyRewardService",
	"LeaderboardService",
	"DebugService",
}

local services = {}
for _, name in ipairs(ORDER) do
	services[name] = require(ServicesFolder:WaitForChild(name))
end

-- Init : chaque service reçoit la liste des autres (évite les require circulaires)
for _, name in ipairs(ORDER) do
	local service = services[name]
	if service.Init then
		service:Init(services)
	end
end

for _, name in ipairs(ORDER) do
	local service = services[name]
	if service.Start then
		service:Start()
	end
end

----------------------------------------------------------------------
-- Joueurs
----------------------------------------------------------------------

-- Ménage de sortie (tous les services, puis sauvegarde + oubli des données).
-- Sans risque s'il est appelé deux fois : chaque PlayerRemoving vide ses
-- tables, ReleaseAsync ne fait rien si les données sont déjà libérées.
local function cleanupPlayer(player: Player)
	for _, name in ipairs(ORDER) do
		local service = services[name]
		if service.PlayerRemoving then
			local ok, err = pcall(service.PlayerRemoving, service, player)
			if not ok then
				warn("[Main] Erreur PlayerRemoving dans " .. name .. " :", err)
			end
		end
	end
	services.DataService:ReleaseAsync(player)
end

local function onPlayerAdded(player: Player)
	local data = services.DataService:LoadAsync(player)
	if not data or not player.Parent then
		return
	end

	for _, name in ipairs(ORDER) do
		-- v9.3 : le joueur a pu partir pendant un PlayerReady qui attend
		-- (ex. vérification des Game Passes) : on arrête de le préparer
		if not player.Parent then
			break
		end
		local service = services[name]
		if service.PlayerReady then
			local ok, err = pcall(service.PlayerReady, service, player, data)
			if not ok then
				warn("[Main] Erreur PlayerReady dans " .. name .. " :", err)
			end
		end
	end

	if not player.Parent then
		-- Parti pendant la préparation : PlayerRemoving est déjà passé, mais un
		-- service a pu finir sa préparation APRÈS (états par joueur jamais
		-- libérés) : on refait le ménage
		cleanupPlayer(player)
		return
	end
	services.GameService:SendFullSync(player)
end

local function onPlayerRemoving(player: Player)
	cleanupPlayer(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)

-- Joueurs déjà présents (arrive parfois dans Studio)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="354">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="ModuleScript" referent="355">
        <Properties>
          <string name="Name">AchievementService</string>
          <string name="Source"><![CDATA[--[[
	AchievementService (ModuleScript)
	Emplacement : ServerScriptService > Services > AchievementService

	Vérifie les succès (définis dans Config.Achievements) et donne les
	récompenses. Appelé automatiquement par GameService quand l'état change.
	Si un succès a un BadgeId (Config.AchievementBadges), le vrai badge
	Roblox est aussi donné (BadgeService), y compris pour les succès déjà
	débloqués avant que le badge existe (vérifié à la connexion).
]]

local BadgeService = game:GetService("BadgeService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)

local AchievementService = {}

local services

function AchievementService:Init(allServices)
	services = allServices
end

-- Donne le badge Roblox d'un succès (en arrière-plan, jamais bloquant)
local function awardBadge(player: Player, achievement)
	local badgeId = achievement.BadgeId
	if type(badgeId) ~= "number" or badgeId <= 0 then
		return
	end
	task.spawn(function()
		local okHas, has = pcall(function()
			return BadgeService:UserHasBadgeAsync(player.UserId, badgeId)
		end)
		if okHas and has then
			return
		end
		local ok, err = pcall(function()
			BadgeService:AwardBadge(player.UserId, badgeId)
		end)
		if not ok then
			warn("[AchievementService] Badge " .. tostring(badgeId) .. " non donné :", err)
		end
	end)
end

-- À la connexion : badges des succès déjà débloqués (si le badge a été ajouté après)
function AchievementService:PlayerReady(player: Player, data)
	for _, achievement in ipairs(Config.Achievements) do
		if data.Achievements[achievement.Id] then
			awardBadge(player, achievement)
		end
	end
end

-- Valeur actuelle d'une statistique (dans data.Stats, ou à la racine comme Rebirths)
function AchievementService:GetStatValue(data, statName: string): number
	local value = data.Stats[statName]
	if value == nil then
		value = data[statName]
	end
	return (type(value) == "number") and value or 0
end

function AchievementService:Check(player: Player)
	local data = services.DataService:GetData(player)
	if not data then
		return
	end

	for _, achievement in ipairs(Config.Achievements) do
		if not data.Achievements[achievement.Id] then
			local value = self:GetStatValue(data, achievement.Stat)
			if value >= achievement.Goal then
				data.Achievements[achievement.Id] = true
				services.GameService:AddDopamine(player, achievement.Reward, false)
				-- Id envoyé : le client peut afficher Locale.T(Config.AchievementsById[Id].Name).
				-- Title, Text et Name sont déjà dans la langue du joueur.
				local name = services.GameService:T(player, achievement.Name)
				services.GameService:Notify(player, {
					Type = "Achievement",
					Icon = achievement.Icon,
					Title = services.GameService:T(player, "ACHIEVEMENT UNLOCKED!"),
					Text = achievement.Icon .. " " .. name .. "  (+" .. NumberFormatter.Format(achievement.Reward) .. ")",
					Id = achievement.Id,
					Name = name,
					Reward = achievement.Reward,
					BadgeAwarded = achievement.BadgeId > 0,
				})
				awardBadge(player, achievement)
			end
		end
	end
end

return AchievementService
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="356">
        <Properties>
          <string name="Name">Arcade</string>
        </Properties>
        <Item class="ModuleScript" referent="357">
          <Properties>
            <string name="Name">SoloGames</string>
            <string name="Source"><![CDATA[--[[
	SoloGames (ModuleScript)
	Emplacement : ServerScriptService > Services > Arcade > SoloGames

	🕹️ Mini-jeux SOLO de l'arcade, côté serveur (anti-triche) :
	  💣 Minesweeper, 🃏 Memory, 🎵 Simon, 🔨 WhackAMole, 🐍 Snake, 🔢 Game2048.

	Appelé par MinigameService pour toute action "solo:..." :
	  SoloGames.Handle(player, data, action, arg, api) -> (ok, résultat | message)

	Principe : une seule partie en cours par joueur (session en mémoire,
	jamais sauvegardée). Chaque partie a un jeton (Token) à renvoyer.
	  - Démineur, Memory, Simon : le SERVEUR garde le plateau / le paquet /
	    la séquence et répond coup par coup (le client ne voit jamais les
	    mines ni les cartes cachées).
	  - Tape-taupe, Snake, 2048 : le serveur donne une graine (Seed), le
	    client joue avec la même simulation (Client > Minigames > Solo_Logic)
	    et envoie à la fin le journal de la partie ; le serveur la REJOUE et
	    vérifie les durées (impossible d'annoncer un faux score).

	Protocole (arg = table ; toute valeur invalide est refusée sans erreur) :
	  solo:info   nil                                  -> { Best = { ["Id:Diff"] = n } }
	  solo:start  { Game, Difficulty }                 -> { Token, Game, Difficulty, Best, ... (selon le jeu) }
	  solo:move   { Token, ... }                       -> selon le jeu (Démineur, Memory, Simon)
	  solo:finish { Token, ... }                       -> { Done = true, Won, Stars, Score, Tickets, Trophies, Dopamine, ... }
	  (voir le détail en bas de chaque section)

	Récompenses : une victoire (>= 1 étoile) appelle api.RewardWin (base
	ArcadeConfig : tickets, 🏆 trophée, Dopamine, stat MinigamesWon, parties
	récompensées par jour, record), puis ajoute un bonus selon la difficulté et les étoiles
	(Solo_Logic.Multiplier) tant que le quota du jour n'est pas atteint.
	Records par difficulté : data.Arcade.Solo.Best["Id:Diff"] (nettoyé ici).
	L'onglet Records de l'arcade (data.Arcade.Best) reçoit le score du mode
	RECORD_DIFFICULTY ("Normal") pour que les records restent comparables.
]]

local SoloGames = {}

local RECORD_DIFFICULTY = "Normal"
local MAX_BEST_ENTRIES = 64

----------------------------------------------------------------------
-- Dépendances (résolues sans jamais bloquer ; injectables pour les tests)
----------------------------------------------------------------------

local Logic = nil
local ArcadeConfig = nil

local function resolveModules()
	if Logic then
		return
	end
	local ok, err = pcall(function()
		local ReplicatedStorage = game:GetService("ReplicatedStorage")
		local folder = ReplicatedStorage:WaitForChild("Client", 10):WaitForChild("Minigames", 10)
		Logic = require(folder:WaitForChild("Solo_Logic", 10))
		local shared = ReplicatedStorage:FindFirstChild("Shared")
		local config = shared and shared:FindFirstChild("ArcadeConfig")
		if config then
			ArcadeConfig = require(config)
		end
	end)
	if not ok then
		warn("[SoloGames] Solo_Logic introuvable : " .. tostring(err))
	end
end

-- Tests hors Roblox : SoloGames._Inject(logicModule, arcadeConfig)
function SoloGames._Inject(logicModule, arcadeConfig)
	Logic = logicModule
	ArcadeConfig = arcadeConfig
end

-- Hasard du serveur (plateaux secrets : Démineur, Memory, Simon, graines)
local serverRandom = nil
local function randomInt(a: number, b: number): number
	if b <= a then
		return a
	end
	if serverRandom == nil then
		local ok, rng = pcall(function()
			return Random.new()
		end)
		serverRandom = ok and rng or false
	end
	if serverRandom then
		return serverRandom:NextInteger(a, b)
	end
	return math.random(a, b)
end

----------------------------------------------------------------------
-- Sessions (une partie en cours par joueur, en mémoire seulement)
----------------------------------------------------------------------

local sessions = {}
local tokenCounter = 0

pcall(function()
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		sessions[player] = nil
	end)
end)

function SoloGames.Cleanup(player)
	sessions[player] = nil
end

-- Tests : session en cours d'un joueur (lecture seule)
function SoloGames._GetSession(player)
	return sessions[player]
end

local function now(api): number
	if type(api.Now) == "function" then
		local ok, value = pcall(api.Now)
		if ok and type(value) == "number" and value == value then
			return value
		end
	end
	return os.clock()
end

local function T(api, player, text: string, ...): string
	if type(api.T) == "function" then
		local ok, result = pcall(api.T, player, text, ...)
		if ok and type(result) == "string" then
			return result
		end
	end
	if select("#", ...) > 0 then
		local ok, result = pcall(string.format, text, ...)
		if ok then
			return result
		end
	end
	return text
end

-- Entier valide dans [lo, hi] (sinon nil) : protège contre NaN, 1e999, "1"...
local function int(value: any, lo: number, hi: number): number?
	if type(value) ~= "number" or value ~= value or value % 1 ~= 0 or value < lo or value > hi then
		return nil
	end
	return value
end

----------------------------------------------------------------------
-- Données : records par difficulté (data.Arcade.Solo)
----------------------------------------------------------------------

local function soloData(data)
	if type(data.Arcade) ~= "table" then
		data.Arcade = {}
	end
	local solo = data.Arcade.Solo
	if type(solo) ~= "table" then
		solo = {}
		data.Arcade.Solo = solo
	end
	if type(solo.Best) ~= "table" then
		solo.Best = {}
	end
	-- Nettoyage : seulement "Jeu:Difficulté" connus, nombres finis >= 0
	local count = 0
	for key, value in pairs(solo.Best) do
		local valid = false
		if type(key) == "string" and type(value) == "number" and value == value and value >= 0 and value < 1e12 then
			local gameId, difficulty = string.match(key, "^(%w+):(%w+)$")
			valid = gameId ~= nil and Logic.GetRules(gameId, difficulty) ~= nil
		end
		if valid then
			count += 1
		end
		if not valid or count > MAX_BEST_ENTRIES then
			solo.Best[key] = nil
		end
	end
	for key in pairs(solo) do
		if key ~= "Best" then
			solo[key] = nil
		end
	end
	return solo
end

local function bestKey(session): string
	return session.Game .. ":" .. session.Difficulty
end

-- Met à jour le record perso ; renvoie (record, nouveau record ?)
local function updateBest(data, session, value: number?, lower: boolean): (number?, boolean)
	local solo = soloData(data)
	local key = bestKey(session)
	local old = solo.Best[key]
	if type(value) ~= "number" or value ~= value or value < 0 then
		return old, false
	end
	local better = old == nil or (lower and value < old) or (not lower and value > old)
	if better and (lower or value > 0) then
		solo.Best[key] = value
		return value, true
	end
	return old, false
end

----------------------------------------------------------------------
-- Fin de partie : stats, récompenses, records
----------------------------------------------------------------------

local function arcadeEntry(api, gameId: string)
	local config = (type(api.Config) == "table" and api.Config) or ArcadeConfig
	local byId = config and config.GamesById
	return type(byId) == "table" and byId[gameId] or nil
end

local function callApi(api, name: string, ...)
	local fn = api[name]
	if type(fn) ~= "function" then
		return false, nil
	end
	local ok, result = pcall(fn, ...)
	if not ok then
		warn("[SoloGames] api." .. name .. " : " .. tostring(result))
		return false, nil
	end
	return true, result
end

-- metrics : { Score (affiché), Record (valeur de record, optionnelle), Stars,
-- Lower (record "plus petit = mieux"), Rejected (message anti-triche) }
local function conclude(player, data, api, session, metrics)
	session.Done = true
	if sessions[player] == session then
		sessions[player] = nil
	end
	local stars = math.clamp(math.floor(metrics.Stars or 0), 0, 3)
	local elapsed = now(api) - (session.FirstMove or session.Started)
	local result = {
		Done = true,
		Game = session.Game,
		Difficulty = session.Difficulty,
		Won = stars >= 1,
		Stars = stars,
		Score = metrics.Score or 0,
		Time = math.floor(elapsed * 10) / 10,
		Tickets = 0,
		Trophies = 0,
		Dopamine = 0,
		Capped = false,
		Record = false,
		NewBest = false,
	}
	-- Une partie compte si le joueur a vraiment joué
	if session.Moves > 0 or metrics.Played then
		callApi(api, "CountPlay", player, session.Game)
	end
	if metrics.Rejected then
		result.Won = false
		result.Stars = 0
		result.Rejected = metrics.Rejected
		result.Best = soloData(data).Best[bestKey(session)]
		return result
	end
	if stars >= 1 then
		local recordValue = session.Difficulty == RECORD_DIFFICULTY and (metrics.Record or metrics.Score) or nil
		local entry = arcadeEntry(api, session.Game)
		local baseTickets = entry and tonumber(entry.Tickets) or 0
		local baseSeconds = entry and tonumber(entry.RewardSeconds) or 0
		local okReward, reward = callApi(api, "RewardWin", player, session.Game, recordValue)
		if okReward and type(reward) == "table" then
			result.Tickets = tonumber(reward.Tickets) or 0
			result.Trophies = tonumber(reward.Trophies) or 0 -- 🏆 (mises des duels, jamais achetables)
			result.Dopamine = tonumber(reward.Dopamine) or 0
			result.Capped = reward.Capped == true
			result.Record = reward.Record == true
		elseif type(api.RewardWin) ~= "function" then
			-- Ancien contrat : récompense de base à la main
			local _, granted = callApi(api, "GrantTickets", player, baseTickets)
			local _, amount = callApi(api, "GrantDopamineSeconds", player, baseSeconds)
			callApi(api, "AddStat", player, "MinigamesWon", 1)
			result.Tickets = tonumber(granted) or 0
			result.Dopamine = tonumber(amount) or 0
		end
		-- Bonus de difficulté / étoiles (pas de bonus si le quota du jour est atteint)
		if not result.Capped then
			local totalTickets, totalSeconds = Logic.Reward(baseTickets, baseSeconds, session.Difficulty, stars)
			local bonusTickets = math.max(0, totalTickets - baseTickets)
			local bonusSeconds = math.max(0, totalSeconds - baseSeconds)
			if bonusTickets > 0 then
				local _, granted = callApi(api, "GrantTickets", player, bonusTickets)
				result.Tickets += tonumber(granted) or 0
			end
			if bonusSeconds > 0 then
				local _, amount = callApi(api, "GrantDopamineSeconds", player, bonusSeconds)
				result.Dopamine += tonumber(amount) or 0
			end
		end
	end
	-- Record perso de cette difficulté (temps : seulement les victoires)
	local bestValue = metrics.Record or metrics.Score
	if metrics.Lower and stars < 1 then
		bestValue = nil
	end
	result.Best, result.NewBest = updateBest(data, session, bestValue, metrics.Lower == true)
	return result
end

local function newSession(player, gameId: string, difficulty: string, gameRules, rules, api)
	tokenCounter += 1
	local session = {
		Game = gameId,
		Difficulty = difficulty,
		GameRules = gameRules,
		Rules = rules,
		Token = tokenCounter * 1000 + randomInt(0, 999),
		Started = now(api),
		Moves = 0,
		Done = false,
	}
	sessions[player] = session
	return session
end

----------------------------------------------------------------------
-- 💣 Démineur
--   start  -> { Cols, Rows, Mines }
--   move   { Token, Cell = i } ou { Token, Cells = { i, ... } (<= 9, "accord") }
--          -> { Cells = { i... }, Numbers = { n... } }  (+ Boom, Cell, Mines = { i... }, Done, Result en fin)
--   finish { Token } -> abandon (défaite)
----------------------------------------------------------------------

local Minesweeper = {}

function Minesweeper.Start(session, reply)
	local rules = session.Rules
	session.Board = Logic.MineBoard(rules.Cols, rules.Rows, rules.Mines)
	reply.Cols = rules.Cols
	reply.Rows = rules.Rows
	reply.Mines = rules.Mines
end

local function allMines(board): { number }
	local list = {}
	for index in pairs(board.Mines or {}) do
		table.insert(list, index)
	end
	table.sort(list)
	return list
end

-- Chrono à partir du premier coup (comme le démineur classique)
local function playTime(session, api): number
	return math.floor((now(api) - (session.FirstMove or session.Started)) * 10) / 10
end

local function mineMetrics(session, api, won: boolean)
	local board = session.Board
	local elapsed = playTime(session, api)
	local stars = Logic.Stars("Minesweeper", session.Rules, {
		Won = won,
		Time = elapsed,
		Progress = board.SafeTotal > 0 and board.RevealedCount / board.SafeTotal or 0,
	})
	local metrics = { Stars = stars, Score = elapsed, Record = elapsed, Lower = true }
	if won and elapsed < (session.Rules.MinSeconds or 0) then
		metrics.Rejected = "Too fast! This run can't be rewarded."
	end
	return metrics
end

function Minesweeper.Move(player, data, api, session, arg)
	local board = session.Board
	local total = board.Cols * board.Rows
	local list = {}
	if type(arg.Cells) == "table" then
		for k = 1, 9 do
			local cell = int(arg.Cells[k], 1, total)
			if cell then
				table.insert(list, cell)
			end
		end
	else
		local cell = int(arg.Cell, 1, total)
		if cell then
			table.insert(list, cell)
		end
	end
	if #list == 0 then
		return false, T(api, player, "Invalid move")
	end
	if not board.Mines then
		Logic.MinePlace(board, list[1], randomInt)
		session.FirstMove = now(api)
	end
	session.Moves += 1
	local reply = { Cells = {}, Numbers = {} }
	for _, cell in ipairs(list) do
		local opened, boom = Logic.MineReveal(board, cell)
		if boom then
			reply.Boom = true
			reply.Cell = cell
			reply.Mines = allMines(board)
			reply.Done = true
			local metrics = mineMetrics(session, api, false)
			if metrics.Rejected then
				metrics.Rejected = nil
			end
			reply.Result = conclude(player, data, api, session, metrics)
			return true, reply
		end
		for _, index in ipairs(opened) do
			table.insert(reply.Cells, index)
			table.insert(reply.Numbers, board.Counts[index])
		end
	end
	if Logic.MineWon(board) then
		reply.Won = true
		reply.Mines = allMines(board)
		reply.Done = true
		reply.Result = conclude(player, data, api, session, mineMetrics(session, api, true))
	end
	return true, reply
end

function Minesweeper.Finish(player, data, api, session, _arg)
	return true, conclude(player, data, api, session, { Stars = 0, Score = 0, Lower = true })
end

----------------------------------------------------------------------
-- 🃏 Memory
--   start  -> { Cols, Rows, Pairs }
--   move   { Token, Cell = i } -> { Cell, Symbol } (1re carte) ou
--          { Cell, Symbol, Other, Match, Pairs, Moves } (2e carte) (+ Done, Result à la fin)
--          { Ignored = true } si la carte est déjà ouverte / trouvée
--   finish { Token } -> abandon
----------------------------------------------------------------------

local Memory = {}

function Memory.Start(session, reply)
	local rules = session.Rules
	session.Deck = Logic.MemoryDeck(rules.Pairs, randomInt)
	session.Matched = {}
	session.Found = 0
	session.Turns = 0
	session.Open = nil
	reply.Cols = rules.Cols
	reply.Rows = rules.Rows
	reply.Pairs = rules.Pairs
end

function Memory.Move(player, data, api, session, arg)
	local cell = int(arg.Cell, 1, #session.Deck)
	if not cell then
		return false, T(api, player, "Invalid move")
	end
	if session.Matched[cell] or session.Open == cell then
		return true, { Ignored = true, Cell = cell }
	end
	session.Moves += 1
	session.FirstMove = session.FirstMove or now(api)
	local symbol = session.Deck[cell]
	if not session.Open then
		session.Open = cell
		return true, { Cell = cell, Symbol = symbol }
	end
	local other = session.Open
	session.Open = nil
	session.Turns += 1
	local match = session.Deck[other] == symbol
	if match then
		session.Matched[cell] = true
		session.Matched[other] = true
		session.Found += 1
	end
	local reply = { Cell = cell, Symbol = symbol, Other = other, Match = match, Pairs = session.Found, Moves = session.Turns }
	if session.Found >= session.Rules.Pairs then
		local elapsed = playTime(session, api)
		local stars = Logic.Stars("Memory", session.Rules, { Won = true, Moves = session.Turns })
		local metrics = { Stars = stars, Score = session.Turns, Record = elapsed, Lower = true }
		if elapsed < (session.Rules.MinSeconds or 0) then
			metrics.Rejected = "Too fast! This run can't be rewarded."
		end
		reply.Done = true
		reply.Result = conclude(player, data, api, session, metrics)
	end
	return true, reply
end

function Memory.Finish(player, data, api, session, _arg)
	return true, conclude(player, data, api, session, { Stars = 0, Score = session.Turns or 0, Lower = true })
end

----------------------------------------------------------------------
-- 🎵 Simon
--   start  -> { Pads, Step, MaxRounds, Sequence = { pad } }
--   move   { Token, Inputs = { pad, ... } } (la manche entière, ou jusqu'à l'erreur)
--          -> { Round, Sequence } (manche réussie : séquence complète suivante)
--          -> { Wrong = true, Expected, Done, Result } (erreur = fin)
--   finish { Token } -> arrêt (score = manches réussies)
----------------------------------------------------------------------

local Simon = {}

function Simon.Start(session, reply, api)
	local rules = session.Rules
	session.Sequence = { randomInt(1, rules.Pads) }
	session.SentAt = now(api)
	session.Rounds = 0
	reply.Pads = rules.Pads
	reply.Step = rules.Step
	reply.MaxRounds = session.GameRules.MaxRounds
	reply.Sequence = table.clone(session.Sequence)
end

local function simonEnd(player, data, api, session)
	local score = session.Rounds
	local stars = Logic.Stars("Simon", session.Rules, { Score = score })
	return conclude(player, data, api, session, { Stars = stars, Score = score })
end

function Simon.Move(player, data, api, session, arg)
	local inputs = arg.Inputs
	local sequence = session.Sequence
	if type(inputs) ~= "table" then
		return false, T(api, player, "Invalid move")
	end
	local count = 0
	for k = 1, #sequence do
		local value = inputs[k]
		if value == nil then
			break
		end
		count = k
		local pad = int(value, 1, session.Rules.Pads)
		if pad ~= sequence[k] then
			session.Moves += 1
			local reply = { Wrong = true, Expected = sequence[k], Index = k, Done = true }
			reply.Result = simonEnd(player, data, api, session)
			return true, reply
		end
	end
	if count < #sequence then
		return false, T(api, player, "Invalid move")
	end
	-- Anti-robot : il faut au moins le temps de voir la séquence et de la rejouer
	local elapsed = now(api) - session.SentAt
	local minimum = #sequence * session.Rules.Step * 0.85 + #sequence * 0.07
	if elapsed < minimum then
		return false, T(api, player, "Too fast!")
	end
	session.Moves += 1
	session.Rounds = #sequence
	if session.Rounds >= session.GameRules.MaxRounds then
		return true, { Round = session.Rounds, Done = true, Result = simonEnd(player, data, api, session) }
	end
	table.insert(sequence, randomInt(1, session.Rules.Pads))
	session.SentAt = now(api)
	return true, { Round = session.Rounds, Sequence = table.clone(sequence) }
end

function Simon.Finish(player, data, api, session, _arg)
	return true, simonEnd(player, data, api, session)
end

----------------------------------------------------------------------
-- 🔨 Tape-taupe (programme des taupes = Solo_Logic.WhackSchedule(Seed))
--   start  -> { Seed, Holes, Duration }
--   finish { Token, Hits = { index dans le programme, ... } } (après Duration s)
----------------------------------------------------------------------

local Whack = {}

function Whack.Start(session, reply)
	local gameRules = session.GameRules
	session.Seed = randomInt(1, 2147483646)
	reply.Seed = session.Seed
	reply.Holes = gameRules.Holes
	reply.Duration = gameRules.Duration
end

function Whack.Finish(player, data, api, session, arg)
	local gameRules = session.GameRules
	local elapsed = now(api) - session.Started
	local schedule, maxScore = Logic.WhackSchedule(session.Seed, session.Rules, gameRules.Holes, gameRules.Duration)
	local hits = type(arg.Hits) == "table" and arg.Hits or {}
	local score, counted = Logic.WhackScore(schedule, hits, elapsed)
	session.Moves += counted
	if elapsed < gameRules.Duration - 1.5 then
		-- partie arrêtée avant la fin : pas de victoire
		return true, conclude(player, data, api, session, { Stars = 0, Score = score, Played = counted > 0 })
	end
	local stars = Logic.Stars("WhackAMole", session.Rules, { Score = score, Max = maxScore })
	return true, conclude(player, data, api, session, { Stars = stars, Score = score, Played = true })
end

----------------------------------------------------------------------
-- 🐍 Snake (rejoué avec Solo_Logic.SnakeReplay)
--   start  -> { Seed, Cols, Rows, Tick, Wrap }
--   finish { Token, Turns = { tick1, dir1, tick2, dir2, ... }, Ticks = pas joués }
----------------------------------------------------------------------

local Snake = {}

function Snake.Start(session, reply)
	local rules = session.Rules
	session.Seed = randomInt(1, 2147483646)
	reply.Seed = session.Seed
	reply.Cols = rules.Cols
	reply.Rows = rules.Rows
	reply.Tick = rules.Tick
	reply.Wrap = rules.Wrap
end

function Snake.Finish(player, data, api, session, arg)
	local gameRules = session.GameRules
	local maxTicks = gameRules.MaxTicks
	local turns = {}
	if type(arg.Turns) == "table" then
		local last = 0
		for k = 1, math.min(#arg.Turns, 12000), 2 do
			local tick = int(arg.Turns[k], 1, maxTicks)
			local dir = int(arg.Turns[k + 1], 1, 4)
			if not tick or not dir or tick <= last then
				break -- journal abîmé : on garde le début
			end
			last = tick
			table.insert(turns, tick)
			table.insert(turns, dir)
		end
	end
	local ticks = int(arg.Ticks, 0, maxTicks) or 0
	local score, played, minDuration = Logic.SnakeReplay(session.Seed, session.Rules, turns, ticks, maxTicks)
	session.Moves += played
	local elapsed = now(api) - session.Started
	local stars = Logic.Stars("Snake", session.Rules, { Score = score })
	local metrics = { Stars = stars, Score = score, Played = played > 0 }
	if elapsed < minDuration * 0.8 - 1 then
		metrics.Rejected = "Too fast! This run can't be rewarded."
	end
	return true, conclude(player, data, api, session, metrics)
end

----------------------------------------------------------------------
-- 🔢 2048 (rejoué avec Solo_Logic.G2048Replay)
--   start  -> { Seed, Size, Target }
--   finish { Token, Moves = "URDL..." (coups qui ont bougé) }
----------------------------------------------------------------------

local G2048 = {}

function G2048.Start(session, reply)
	session.Seed = randomInt(1, 2147483646)
	reply.Seed = session.Seed
	reply.Size = session.GameRules.Size
	reply.Target = session.Rules.Target
end

function G2048.Finish(player, data, api, session, arg)
	local gameRules = session.GameRules
	local moves = arg.Moves
	if type(moves) ~= "string" or #moves > gameRules.MaxMoves + 16 then
		moves = ""
	end
	local state, played = Logic.G2048Replay(session.Seed, session.Rules, gameRules.Size, moves, gameRules.MaxMoves)
	session.Moves += played
	local elapsed = now(api) - session.Started
	local stars = Logic.Stars("Game2048", session.Rules, { MaxTile = state.MaxTile })
	local metrics = { Stars = stars, Score = state.Score, Played = played > 0 }
	if elapsed + 1 < played * gameRules.MinMoveSeconds then
		metrics.Rejected = "Too fast! This run can't be rewarded."
	end
	local result = conclude(player, data, api, session, metrics)
	result.MaxTile = state.MaxTile
	return true, result
end

----------------------------------------------------------------------
-- 🏃 Desk Runner (v9.8, bureau gamer ; rejoué avec Shared > DeskRunnerLogic)
--   start  -> { Seed, Tick }
--   finish { Token, Inputs = { tick1, action1, tick2, action2, ... }, Ticks = pas joués }
--   (même anti-triche que le Snake : rejeu serveur + durée minimale)
----------------------------------------------------------------------

local runnerLogic = nil
local function deskRunnerLogic()
	if runnerLogic == nil then
		local ok, result = pcall(function()
			local shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared", 10)
			return require(shared:WaitForChild("DeskRunnerLogic", 10))
		end)
		runnerLogic = (ok and type(result) == "table") and result or false
	end
	return runnerLogic or nil
end

-- Tests hors Roblox : SoloGames._InjectRunner(module)
function SoloGames._InjectRunner(module)
	runnerLogic = module
end

local DeskRunner = {}

function DeskRunner.Start(session, reply)
	session.Seed = randomInt(1, 2147483646)
	reply.Seed = session.Seed
	local runner = deskRunnerLogic()
	reply.Tick = runner and runner.TICK or (1 / 30)
end

function DeskRunner.Finish(player, data, api, session, arg)
	local runner = deskRunnerLogic()
	if not runner then
		return false, T(api, player, "Something went wrong")
	end
	local maxTicks = session.GameRules.MaxTicks
	local inputs = {}
	if type(arg.Inputs) == "table" then
		local last = 0
		for k = 1, math.min(#arg.Inputs, 12000), 2 do
			local tick = int(arg.Inputs[k], 1, maxTicks)
			local action = int(arg.Inputs[k + 1], 1, 4)
			if not tick or not action or tick <= last then
				break -- journal abîmé : on garde le début
			end
			last = tick
			table.insert(inputs, tick)
			table.insert(inputs, action)
		end
	end
	local ticks = int(arg.Ticks, 0, maxTicks) or 0
	local score, _coins, _distance, played, minDuration = runner.Replay(session.Seed, inputs, ticks)
	session.Moves += played
	local elapsed = now(api) - session.Started
	local stars = Logic.Stars("DeskRunner", session.Rules, { Score = score })
	local metrics = { Stars = stars, Score = score, Played = played > 0 }
	if elapsed < minDuration * 0.8 - 1 then
		metrics.Rejected = "Too fast! This run can't be rewarded."
	end
	return true, conclude(player, data, api, session, metrics)
end

----------------------------------------------------------------------
-- Routage
----------------------------------------------------------------------

local HANDLERS = {
	DeskRunner = DeskRunner,
	Minesweeper = Minesweeper,
	Memory = Memory,
	Simon = Simon,
	WhackAMole = Whack,
	Snake = Snake,
	Game2048 = G2048,
}

-- Abandon silencieux de la partie en cours (nouvelle partie lancée)
local function dropSession(player, data, api)
	local session = sessions[player]
	if session and not session.Done then
		conclude(player, data, api, session, { Stars = 0, Score = 0, Lower = true })
	end
	sessions[player] = nil
end

local function activeSession(player, api, arg)
	local session = sessions[player]
	if not session or type(arg) ~= "table" or arg.Token ~= session.Token then
		return nil, T(api, player, "This game is over. Start a new one!")
	end
	if now(api) - session.Started > Logic.SessionTimeout then
		sessions[player] = nil
		return nil, T(api, player, "This game is over. Start a new one!")
	end
	return session, nil
end

local function dispatch(player, data, action: string, arg, api)
	if action == "solo:info" then
		local best = table.clone(soloData(data).Best)
		return true, { Best = best }
	end

	if action == "solo:start" then
		if type(arg) ~= "table" then
			return false, T(api, player, "Invalid request")
		end
		local gameRules, rules = Logic.GetRules(arg.Game, arg.Difficulty)
		local handler = HANDLERS[arg.Game]
		if not gameRules or not handler then
			return false, T(api, player, "Unknown game")
		end
		dropSession(player, data, api)
		local session = newSession(player, arg.Game, arg.Difficulty, gameRules, rules, api)
		local reply = { Token = session.Token, Game = session.Game, Difficulty = session.Difficulty }
		handler.Start(session, reply, api)
		reply.Best = soloData(data).Best[bestKey(session)]
		return true, reply
	end

	if action == "solo:move" then
		local session, message = activeSession(player, api, arg)
		if not session then
			return false, message
		end
		local handler = HANDLERS[session.Game]
		if not handler.Move then
			return false, T(api, player, "Invalid move")
		end
		return handler.Move(player, data, api, session, arg)
	end

	if action == "solo:finish" then
		local session, message = activeSession(player, api, arg)
		if not session then
			return false, message
		end
		return HANDLERS[session.Game].Finish(player, data, api, session, arg)
	end

	return false, T(api, player, "Invalid request")
end

function SoloGames.Handle(player, data, action, arg, api)
	if type(api) ~= "table" then
		return false, "Invalid request"
	end
	if type(action) ~= "string" or type(data) ~= "table" or player == nil then
		return false, T(api, player, "Invalid request")
	end
	resolveModules()
	if not Logic then
		return false, T(api, player, "Arcade unavailable, try again later")
	end
	local ok, success, result = pcall(dispatch, player, data, action, arg, api)
	if not ok then
		warn("[SoloGames] " .. tostring(action) .. " : " .. tostring(success))
		return false, T(api, player, "Something went wrong")
	end
	return success, result
end

return SoloGames
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="358">
        <Properties>
          <string name="Name">CarService</string>
          <string name="Source"><![CDATA[--[[
	CarService (ModuleScript)
	Emplacement : ServerScriptService > Services > CarService

	🚗 Voitures de Dopamine Town (v9.6, GARAGE96).
	  - Catalogue : Config.Cars (8 modèles de Shared/CarModels, prix étalés
	    sur la progression, verrous "visites à l'océan"). Achat à la
	    concession (TownShops / ShopUI de SHOPS96) ou n'importe où par le
	    remote "Car". Voitures gardées pour toujours (même après l'océan).
	  - 🏎️ Garage du manoir (Config.House.Garage) : aile de 3 places devant
	    le manoir (GarageLayout), construite par chaque client (HouseFacade),
	    voitures possédées garées dedans (CarClient). On peut acheter des
	    voitures SANS garage : elles y seront rangées le jour où on l'a.
	  - Conduite (en ville seulement) : "🚗 Ma voiture" fait apparaître SA
	    voiture choisie (côté SERVEUR : tout le monde la voit) à côté de soi,
	    ou dans son garage si on est devant, et nous assoit au volant.
	    Contrôle "physique légère" : boîte de collision surélevée (les
	    bordures passent dessous) + 4 boules invisibles aux roues (elles
	    montent les trottoirs), tout le reste soudé et sans masse ;
	    LinearVelocity (plan horizontal) + AlignOrientation (toujours à
	    plat, cap voulu) pilotés par le CLIENT du conducteur, propriétaire
	    réseau de la voiture (CarClient lit VehicleSeat.ThrottleFloat /
	    SteerFloat : clavier ZQSD / WASD / flèches, joystick mobile, manette).
	    Garée (personne au volant) = ancrée : elle ne bouge jamais.
	  - Sécurité : groupes de collision (v10, PHYS10 : voitures <-> avatars
	    et voitures <-> voitures = collision ; renversé façon dessin animé,
	    jamais de mort : ImpactService) ; ronde 4 fois / s : voiture tombée, retournée, trop rapide,
	    entrée dans une maison (WorldLayout.InsideHouse) ou une boutique
	    (attributs InteriorCF / InteriorSize, sauf AllowCars) -> remise à sa
	    dernière position sûre ; rangée au bout de Config.Cars.IdleDespawn s
	    sans conducteur, ou si son propriétaire quitte la ville / le jeu.
	  - Klaxon VISUEL "💨" (bulle au-dessus de la voiture) : aucun son.
	  - Attributs du Player (répliqués, lus par CarClient pour les garages) :
	    DopamineCars = "id:couleur,..." (voitures possédées), DopamineCar =
	    voiture choisie, DopamineGarage = garage (et manoir), DopamineCarOut =
	    voiture sortie.

	Données : data.Cars = { Owned = { [carId] = true }, Colors = { [carId] =
	colorId }, Selected = carId | "", Garage = bool,
	(v10, CARS10) Tuning = { [carId] = { Engine, Tyres, Suspension } (0..3) },
	Mods = { [carId] = { [Kind] = Id } } (Config.Cars.Mods, sans l'origine),
	Unlocked = { [carId] = { ["Kind:Id"] = true } } (options achetées),
	Plates = { [carId] = "TEXTE" } (filtré par TextService) }.
	RemoteFunction "Car" (action, a, b) -> (succès, message, extra?) :
	  "buy" carId -> extra = Dopamine manquante (nombre) si trop cher
	  "setColor" carId, colorId | "select" carId | "buyGarage"
	  (v10) "setMod" carId, "Kind:Id" | "tune" carId, partId | "plate" carId, texte
	    (achat vérifié : prix = CarModels.PriceFor, verrous, extra = manque)
	  "spawn" | "exit" | "despawn" | "honk" | "reset"
	Attribut (v10) DopamineCarMods = "carId>Kind=Id;Kind=Id/carId2>..." (garages).
	Courses (v10, RACE10) : CarService:RaceSpawn / RaceRelease / SetFrozen /
	GetStats (voir en bas).
	Tout est dans des pcall, chaque action a sa limite de fréquence.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local PhysicsService = game:GetService("PhysicsService")
local TextService = game:GetService("TextService")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local WorldLayout = require(ReplicatedStorage.Shared.WorldLayout)
local CarModels = require(ReplicatedStorage.Shared.CarModels)
local GarageLayout = require(ReplicatedStorage.Shared.GarageLayout)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local RateLimiter = require(script.Parent.RateLimiter)

local CarService = {}

CarService.CAR_GROUP = "DopamineCars"
CarService.WALKER_GROUP = "DopamineWalkers"
CarService.FOLDER_NAME = "DopamineCars"

local PATROL_INTERVAL = 0.25
local MAX_SPEED_CLAMP = 110 -- studs/s : au-delà, c'est un bug physique -> on arrête tout
local SPAWN_RANGE_GARAGE = 45 -- studs : "🚗 Ma voiture" près de son garage -> sortie du garage

type Car = {
	Player: Player,
	Model: Model,
	Root: BasePart,
	Seat: VehicleSeat,
	CarId: string,
	Driving: boolean,
	LastUsed: number,
	LastSafe: CFrame,
	Generation: number,
	Frozen: boolean, -- (v10) départ de course : ancrée pendant le compte à rebours
	Loaner: boolean, -- (v10) voiture de prêt des courses (pas possédée)
}

local services: any = nil
local cars: { [Player]: Car } = {}
local folder: Folder? = nil
local generation = 0

----------------------------------------------------------------------
-- Outils
----------------------------------------------------------------------

local function T(player: Player, text: string, ...): string
	if services and services.GameService then
		return services.GameService:T(player, text, ...)
	end
	if select("#", ...) > 0 then
		return string.format(text, ...)
	end
	return text
end

local function isValidNumber(value: any): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function dataOf(player: Player): any
	return services and services.DataService and services.DataService:GetData(player) or nil
end

-- data.Cars propre (sauvegarde abîmée corrigée, ids inconnus retirés)
function CarService.Sanitize(data: any)
	if type(data) ~= "table" then
		return
	end
	local raw = type(data.Cars) == "table" and data.Cars or {}
	local owned, colors = {}, {}
	if type(raw.Owned) == "table" then
		for id, value in pairs(raw.Owned) do
			if value == true and type(id) == "string" and Config.CarsById[id] then
				owned[id] = true
			end
		end
	end
	if type(raw.Colors) == "table" then
		for id, colorId in pairs(raw.Colors) do
			if owned[id] and type(colorId) == "string" and Config.CarColorsById[colorId] then
				colors[id] = colorId
			end
		end
	end
	local selected = type(raw.Selected) == "string" and owned[raw.Selected] and raw.Selected or ""
	if selected == "" then
		for _, car in ipairs(Config.Cars.List) do
			if owned[car.Id] then
				selected = car.Id
			end
		end
	end
	-- (v10, CARS10) atelier : préparation, options, achats, plaques (par voiture possédée)
	local tuning, mods, unlocked, plates = {}, {}, {}, {}
	local maxPlate = tonumber(Config.Cars.PlateMaxLength) or 8
	for id in pairs(owned) do
		local t = type(raw.Tuning) == "table" and raw.Tuning[id]
		if type(t) == "table" then
			local clean = CarModels.CleanTuning(t)
			if clean.Engine + clean.Tyres + clean.Suspension > 0 then
				tuning[id] = clean
			end
		end
		local m = type(raw.Mods) == "table" and raw.Mods[id]
		if type(m) == "table" then
			local clean = CarModels.CleanMods(m)
			if next(clean) ~= nil then
				mods[id] = clean
			end
		end
		local u = type(raw.Unlocked) == "table" and raw.Unlocked[id]
		if type(u) == "table" then
			local set = {}
			for key, value in pairs(u) do
				local kind, entryId = nil, nil
				if type(key) == "string" then
					kind, entryId = string.match(key, "^(%w+):(%w+)$")
				end
				if value == true and kind and entryId and Config.CarModsById[kind] and Config.CarModsById[kind][entryId] then
					set[key] = true
				end
			end
			if next(set) ~= nil then
				unlocked[id] = set
			end
		end
		local plate = type(raw.Plates) == "table" and raw.Plates[id]
		if type(plate) == "string" and plate ~= "" and #plate <= maxPlate * 4 then
			plates[id] = plate
		end
	end
	data.Cars = { Owned = owned, Colors = colors, Selected = selected, Garage = raw.Garage == true, Tuning = tuning, Mods = mods, Unlocked = unlocked, Plates = plates }
end

local function ownedList(data: any): { string }
	local list = {}
	local cars_ = data and data.Cars
	for _, car in ipairs(Config.Cars.List) do
		if cars_ and cars_.Owned and cars_.Owned[car.Id] then
			table.insert(list, car.Id)
		end
	end
	return list
end

local function colorOf(data: any, carId: string): string
	local colors = data and data.Cars and data.Cars.Colors
	local colorId = colors and colors[carId]
	if type(colorId) == "string" and Config.CarColorsById[colorId] then
		return colorId
	end
	local car = Config.CarsById[carId]
	return car and car.DefaultColor or "Bubblegum"
end

-- Le garage est visible : acheté ET on habite le manoir
local function hasGarage(data: any): boolean
	if type(data) ~= "table" or type(data.Cars) ~= "table" or data.Cars.Garage ~= true then
		return false
	end
	local house = data.House
	local size = house and Config.HouseSizesById[house.Size]
	return GarageLayout.Supports(size)
end

-- Attributs répliqués du Player (garages des autres clients)
local function publish(player: Player)
	local data = dataOf(player)
	if not data then
		return
	end
	local parts = {}
	local modParts = {}
	for _, id in ipairs(ownedList(data)) do
		table.insert(parts, id .. ":" .. colorOf(data, id))
		-- (v10) options de chaque voiture (garages vus par les autres clients)
		local encoded = CarModels.EncodeMods(data.Cars.Mods and data.Cars.Mods[id])
		if encoded ~= "" then
			table.insert(modParts, id .. ">" .. encoded)
		end
	end
	pcall(function()
		player:SetAttribute("DopamineCarMods", table.concat(modParts, "/"))
		player:SetAttribute("DopamineCars", table.concat(parts, ","))
		player:SetAttribute("DopamineCar", data.Cars and data.Cars.Selected or "")
		player:SetAttribute("DopamineGarage", hasGarage(data))
		player:SetAttribute("DopamineCarOut", cars[player] ~= nil)
	end)
end

local function toast(player: Player, text: string)
	pcall(function()
		Net.Event("WorldEvent"):FireClient(player, "Toast", text)
	end)
end

local function sendState(player: Player)
	if services and services.GameService then
		services.GameService:SendState(player)
	end
end

----------------------------------------------------------------------
-- Ville : maisons, boutiques, parcelles (zones interdites aux voitures)
----------------------------------------------------------------------

local function townFolder(): Instance?
	return workspace:FindFirstChild("DopamineTown")
end

-- { { HouseCF, Size, OwnerId } } des parcelles habitées
local function houses(): { { HouseCF: CFrame, Size: any, OwnerId: number } }
	local out = {}
	local town = townFolder()
	local plots = town and town:FindFirstChild("Plots")
	if not plots then
		return out
	end
	local list = plots:GetChildren()
	local count = #list
	for _, plot in ipairs(list) do
		local index = tonumber(plot:GetAttribute("Index"))
		local ownerId = tonumber(plot:GetAttribute("OwnerId")) or 0
		if index and ownerId ~= 0 then
			local owner = Players:GetPlayerByUserId(ownerId)
			local data = owner and dataOf(owner)
			local size = data and data.House and Config.HouseSizesById[data.House.Size] or Config.House.Sizes[1]
			table.insert(out, { HouseCF = WorldLayout.HouseCFrame(WorldLayout.PlotCFrame(index, count)), Size = size, OwnerId = ownerId })
		end
	end
	return out
end

local function houseOf(player: Player): (CFrame?, any)
	for _, h in ipairs(houses()) do
		if h.OwnerId == player.UserId then
			return h.HouseCF, h.Size
		end
	end
	return nil, nil
end

-- Point dans une zone interdite (maison, boutique fermée aux voitures) ?
local function forbidden(position: Vector3, zones: { { HouseCF: CFrame, Size: any, OwnerId: number } }?): boolean
	for _, h in ipairs(zones or houses()) do
		local x, y, d = WorldLayout.ToLocal(h.HouseCF, position)
		if WorldLayout.InsideHouse(h.Size, x, y, d, 0.3) then
			return true
		end
	end
	local town = townFolder()
	local shops = town and town:FindFirstChild("Shops")
	if shops then
		for _, shop in ipairs(shops:GetChildren()) do
			local cf = shop:GetAttribute("InteriorCF")
			local size = shop:GetAttribute("InteriorSize")
			if typeof(cf) == "CFrame" and typeof(size) == "Vector3" and shop:GetAttribute("AllowCars") ~= true then
				local p = cf:PointToObjectSpace(position)
				if math.abs(p.X) <= size.X / 2 + 0.5 and math.abs(p.Z) <= size.Z / 2 + 0.5 and p.Y >= -2 and p.Y <= size.Y + 1 then
					return true
				end
			end
		end
	end
	return false
end
CarService.IsForbidden = forbidden

----------------------------------------------------------------------
-- Groupes de collision (v10, PHYS10) : voitures <-> avatars = OUI, voitures
-- <-> voitures = OUI (on ne traverse plus rien ; se faire renverser :
-- ImpactService). Matrice complète : Shared/ImpactRules.MATRIX.
----------------------------------------------------------------------

local function setupGroups()
	pcall(function()
		PhysicsService:RegisterCollisionGroup(CarService.CAR_GROUP)
	end)
	pcall(function()
		PhysicsService:RegisterCollisionGroup(CarService.WALKER_GROUP)
	end)
	pcall(function()
		PhysicsService:CollisionGroupSetCollidable(CarService.CAR_GROUP, CarService.WALKER_GROUP, true)
		PhysicsService:CollisionGroupSetCollidable(CarService.CAR_GROUP, CarService.CAR_GROUP, true)
	end)
end

local function tagWalker(part: Instance)
	-- (v10) KeepGroup : boîtes du ragdoll (groupe "Ragdoll", ImpactRules)
	if part:IsA("BasePart") and part:GetAttribute("KeepGroup") ~= true then
		pcall(function()
			part.CollisionGroup = CarService.WALKER_GROUP
		end)
	end
end

local function watchCharacter(character: Model)
	for _, d in ipairs(character:GetDescendants()) do
		tagWalker(d)
	end
	character.DescendantAdded:Connect(tagWalker)
end

----------------------------------------------------------------------
-- La voiture qu'on conduit
----------------------------------------------------------------------

local function characterOf(player: Player): (Model?, Humanoid?, BasePart?)
	local character = player.Character
	if not character or not character.Parent then
		return nil, nil, nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
		return nil, nil, nil
	end
	return character, humanoid, root
end

local function flatten(cf: CFrame): CFrame
	local look = cf.LookVector * Vector3.new(1, 0, 1)
	if look.Magnitude < 1e-3 then
		look = Vector3.new(0, 0, -1)
	end
	return CFrame.lookAt(cf.Position, cf.Position + look.Unit)
end

local function despawn(player: Player, silent: boolean?)
	local car = cars[player]
	if not car then
		return
	end
	cars[player] = nil
	pcall(function()
		local weld = car.Seat:FindFirstChild("SeatWeld")
		if weld then
			weld:Destroy()
		end
	end)
	pcall(car.Model.Destroy, car.Model)
	if not silent and player.Parent then
		toast(player, T(player, "🚗 Your car went back to the garage"))
	end
	publish(player)
end

-- Transforme le modèle ancré de CarModels en voiture qu'on conduit
local function rig(model: Model, carId: string): (BasePart, VehicleSeat)
	local root = model.PrimaryPart :: BasePart
	local pivot = model:GetPivot()
	local noFriction = PhysicalProperties.new(0.7, 0, 0, 100, 100)
	-- (v9.9, CARS99) roues animables : pivots "WheelSteer" (braquage) et
	-- "WheelSpin" (rotation) reliés par des Motor6D ; chaque client règle
	-- leur Transform (CarClient). Les autres pièces des roues sont soudées à
	-- leur pivot, le reste de la carrosserie à la boîte Root.
	local steers: { [number]: BasePart } = {}
	local spins: { [number]: BasePart } = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and type(d:GetAttribute("Wheel")) == "number" then
			if d.Name == "WheelSteer" then
				steers[d:GetAttribute("Wheel") :: number] = d
			elseif d.Name == "WheelSpin" then
				spins[d:GetAttribute("Wheel") :: number] = d
			end
		end
	end
	for index, steer in pairs(steers) do
		local spin = spins[index]
		if spin then
			local m1 = Instance.new("Motor6D")
			m1.Name = "WheelSteer"
			m1.Part0 = root
			m1.Part1 = steer
			m1.C0 = root.CFrame:ToObjectSpace(steer.CFrame)
			m1.Parent = steer
			local m2 = Instance.new("Motor6D")
			m2.Name = "WheelSpin"
			m2.Part0 = steer
			m2.Part1 = spin
			m2.C0 = steer.CFrame:ToObjectSpace(spin.CFrame)
			m2.Parent = spin
		end
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d ~= root then
			d.Massless = true
			d.CanCollide = false
			d.CanTouch = false
			d.CanQuery = false
			local wheelIndex = d:GetAttribute("Wheel")
			local hub: BasePart? = nil
			if type(wheelIndex) == "number" and steers[wheelIndex] and spins[wheelIndex] then
				hub = if d:GetAttribute("Spin") then spins[wheelIndex] else steers[wheelIndex]
			end
			if d.Name == "WheelSteer" or d.Name == "WheelSpin" then
				if not (hub and spins[wheelIndex :: number]) then
					local weld = Instance.new("WeldConstraint")
					weld.Part0 = root
					weld.Part1 = d
					weld.Parent = d
				end
			elseif hub and hub ~= d then
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = hub
				weld.Part1 = d
				weld.Parent = d
			else
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = root
				weld.Part1 = d
				weld.Parent = d
			end
			d.Anchored = false
		end
	end
	root.CanCollide = true
	root.CanTouch = false
	root.CustomPhysicalProperties = noFriction
	root.CollisionGroup = CarService.CAR_GROUP
	-- boules de contact aux roues (invisibles) : montent les bordures
	local wheelRadius = tonumber(model:GetAttribute("WheelRadius")) or 1
	for index, position in ipairs(CarModels.WheelPositions(carId)) do
		local ball = Instance.new("Part")
		ball.Name = "Contact" .. index
		ball.Shape = Enum.PartType.Ball
		ball.Size = Vector3.new(wheelRadius * 2, wheelRadius * 2, wheelRadius * 2)
		ball.CFrame = pivot * CFrame.new(position.X * 0.8, wheelRadius, position.Z)
		ball.Transparency = 1
		ball.CanCollide = true
		ball.CanTouch = false
		ball.CanQuery = false
		ball.CastShadow = false
		ball.CustomPhysicalProperties = noFriction
		ball.CollisionGroup = CarService.CAR_GROUP
		ball.Anchored = false
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = ball
		weld.Parent = ball
		ball.Parent = model
	end
	-- siège du conducteur (invisible ; on s'y assoit par l'invite ou le bouton)
	local seatCF = model:GetAttribute("SeatCF")
	local seat = Instance.new("VehicleSeat")
	seat.Name = "DriverSeat"
	seat.Size = Vector3.new(1.6, 0.3, 1.6)
	seat.CFrame = pivot * (typeof(seatCF) == "CFrame" and seatCF or CFrame.new(0, 2, 0)) * CFrame.new(0, -0.15, 0)
	seat.Transparency = 1
	seat.CanCollide = false
	seat.CanTouch = false
	seat.CanQuery = false
	seat.Massless = true
	seat.MaxSpeed = 0
	seat.Torque = 0
	seat.TurnSpeed = 0
	seat.HeadsUpDisplay = false
	seat.Anchored = false
	local seatWeld = Instance.new("WeldConstraint")
	seatWeld.Part0 = root
	seatWeld.Part1 = seat
	seatWeld.Parent = seat
	seat.Parent = model
	-- contrôleurs (réglés chaque image par le client du conducteur)
	local attachment = Instance.new("Attachment")
	attachment.Name = "Drive"
	attachment.Parent = root
	local mass = root:GetMass()
	for _, d in ipairs(model:GetChildren()) do
		if d:IsA("BasePart") and d.Name:sub(1, 7) == "Contact" then
			mass += d:GetMass()
		end
	end
	local drive = Instance.new("LinearVelocity")
	drive.Name = "DriveVelocity"
	drive.Attachment0 = attachment
	drive.RelativeTo = Enum.ActuatorRelativeTo.World
	drive.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	drive.PrimaryTangentAxis = Vector3.new(1, 0, 0)
	drive.SecondaryTangentAxis = Vector3.new(0, 0, 1)
	drive.PlaneVelocity = Vector2.new(0, 0)
	drive.MaxForce = math.max(1000, mass * 140)
	drive.Parent = root
	local align = Instance.new("AlignOrientation")
	align.Name = "DriveAlign"
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = attachment
	align.RigidityEnabled = false
	align.MaxTorque = math.max(1e5, mass * 4000)
	align.MaxAngularVelocity = 8
	align.Responsiveness = 30
	align.CFrame = flatten(pivot).Rotation
	align.Parent = root
	model:SetAttribute("Mass", mass)
	root.Anchored = true
	return root, seat
end

-- Une place libre au sol près de `origin` (sinon `origin` lui-même)
local function findSpot(origin: CFrame, size: Vector3, ignore: { Instance }): CFrame
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	local look = flatten(origin)
	local candidates = { look * CFrame.new(size.X / 2 + 4, 0, 0), look * CFrame.new(-size.X / 2 - 4, 0, 0), look * CFrame.new(0, 0, size.Z / 2 + 4), look }
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = ignore
	overlap.RespectCanCollide = true
	local zones = houses()
	for index, cf in ipairs(candidates) do
		local from = cf.Position + Vector3.new(0, 6, 0)
		local hit = workspace:Raycast(from, Vector3.new(0, -20, 0), params)
		if hit then
			local ground = CFrame.new(Vector3.new(cf.X, hit.Position.Y + 0.05, cf.Z)) * look.Rotation
			local free = true
			if index < #candidates then
				local okBox, parts = pcall(function()
					return workspace:GetPartBoundsInBox(ground * CFrame.new(0, size.Y / 2 + 0.7, 0), size - Vector3.new(0.4, 1.2, 0.4), overlap)
				end)
				free = okBox and #parts == 0 and not forbidden(ground.Position + Vector3.new(0, 1, 0), zones)
			end
			if free then
				return ground
			end
		end
	end
	return look * CFrame.new(0, -3, 0)
end

local function sit(player: Player, car: Car): boolean
	local _, humanoid = characterOf(player)
	if not humanoid then
		return false
	end
	if car.Seat.Occupant ~= nil then
		return car.Seat.Occupant == humanoid
	end
	local ok = pcall(function()
		car.Seat:Sit(humanoid)
	end)
	return ok
end

local function onOccupant(car: Car)
	local occupant = car.Seat.Occupant
	if occupant then
		local who = Players:GetPlayerFromCharacter(occupant.Parent)
		if who ~= car.Player then
			-- (seul le propriétaire conduit)
			pcall(function()
				local weld = car.Seat:FindFirstChild("SeatWeld")
				if weld then
					weld:Destroy()
				end
			end)
			return
		end
		car.Driving = true
		car.LastUsed = os.clock()
		-- (v9.7) le client cache l'invite "Conduire" tant que quelqu'un est au volant
		car.Model:SetAttribute("Occupied", true)
		-- (v10) départ de course : reste ancrée tant que RACE10 la bloque
		if not car.Frozen then
			car.Root.Anchored = false
			pcall(function()
				car.Root:SetNetworkOwner(car.Player)
			end)
		end
	else
		car.Driving = false
		car.LastUsed = os.clock()
		car.Model:SetAttribute("Occupied", false)
		pcall(function()
			local drive = car.Root:FindFirstChild("DriveVelocity") :: LinearVelocity?
			if drive then
				drive.PlaneVelocity = Vector2.new(0, 0)
			end
			local align = car.Root:FindFirstChild("DriveAlign") :: AlignOrientation?
			if align then
				align.CFrame = flatten(car.Root.CFrame).Rotation
			end
		end)
		local gen = car.Generation
		task.delay(0.8, function()
			if cars[car.Player] == car and car.Generation == gen and car.Seat.Occupant == nil and car.Root.Parent then
				pcall(function()
					car.Root.AssemblyLinearVelocity = Vector3.zero
					car.Root.AssemblyAngularVelocity = Vector3.zero
					car.Root.CFrame = flatten(car.Root.CFrame)
					car.Root.Anchored = true
				end)
			end
		end)
	end
end

local function plateText(player: Player): string
	return string.format("DC %03d", player.UserId % 1000)
end

-- (v10, CARS10) plaque personnalisée (déjà filtrée à l'enregistrement) ou "DC 123"
local function plateOf(player: Player, data: any, carId: string): string
	local plates = data and data.Cars and data.Cars.Plates
	local text = type(plates) == "table" and plates[carId]
	if type(text) == "string" and text ~= "" then
		return text
	end
	return plateText(player)
end

-- Options de CarModels.Build pour la voiture d'un joueur (peinture, options, plaque)
local function buildOptions(player: Player, data: any, carId: string): any
	local mods = data and data.Cars and data.Cars.Mods
	return { Detail = "Full", Plate = plateOf(player, data, carId), Mods = type(mods) == "table" and mods[carId] or nil }
end

-- Construit, équipe et enregistre la voiture d'un joueur à `target`
-- (commun à "🚗 Ma voiture" et aux courses de RACE10)
local function makeCar(player: Player, data: any, carId: string, target: CFrame, loaner: boolean, fromGarage: boolean): Car
	despawn(player, true)
	local opts = if loaner then { Detail = "Full", Plate = "LOAN " .. tostring(player.UserId % 100) } else buildOptions(player, data, carId)
	local model = CarModels.Build(carId, if loaner then nil else colorOf(data, carId), opts)
	model.Name = "Car_" .. player.UserId
	model:SetAttribute("OwnerId", player.UserId)
	model:SetAttribute("OwnerName", player.DisplayName)
	if fromGarage then
		model:SetAttribute("FromGarage", true)
	end
	if loaner then
		model:SetAttribute("Loaner", true)
	end
	-- (v10) performances (RACE10 : plausibilité de la vitesse, affichage)
	local stats = CarModels.Stats(carId, if loaner then nil else CarModels.TuningOf(data, carId))
	model:SetAttribute("TopSpeed", stats.TopSpeed)
	model:SetAttribute("Rating", stats.Rating)
	model:SetAttribute("Class", stats.Class)
	model:SetAttribute("Tuning", string.format("%d%d%d", stats.Tuning.Engine, stats.Tuning.Tyres, stats.Tuning.Suspension))
	model:PivotTo(target)
	local root, seat = rig(model, carId)
	generation += 1
	local car: Car = {
		Player = player,
		Model = model,
		Root = root,
		Seat = seat,
		CarId = carId,
		Driving = false,
		LastUsed = os.clock(),
		LastSafe = root.CFrame,
		Generation = generation,
		Frozen = false,
		Loaner = loaner,
	}
	cars[player] = car
	-- invite "Conduire" (le client la traduit et la cache aux autres joueurs)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "DrivePrompt"
	prompt.ActionText = "Drive"
	prompt.ObjectText = tostring((Config.CarsById[carId] or {}).Name or carId)
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = root
	prompt.Triggered:Connect(function(who: Player)
		if who == player and cars[player] == car then
			sit(player, car)
		elseif who ~= player then
			toast(who, T(who, "🔒 This is %s's car", player.DisplayName))
		end
	end)
	seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		onOccupant(car)
	end)
	local f = folder
	if not f or not f.Parent then
		local newFolder = Instance.new("Folder")
		newFolder.Name = CarService.FOLDER_NAME
		newFolder.Parent = workspace
		folder = newFolder
		f = newFolder
	end
	model.Parent = f
	publish(player)
	return car
end

local function spawnCar(player: Player, data: any): (boolean, string)
	local character, _, charRoot = characterOf(player)
	if not character or not charRoot then
		return false, T(player, "Walk around the town first")
	end
	local carId = data.Cars.Selected
	if carId == "" or not data.Cars.Owned[carId] then
		return false, T(player, "🚗 Buy a car at the car dealership first!")
	end
	local zones = houses()
	if forbidden(charRoot.Position, zones) then
		return false, T(player, "🚫 Go outside to take your car")
	end
	despawn(player, true)
	-- où ? dans son garage si on est devant, sinon à côté de soi
	local target: CFrame? = nil
	local fromGarage = false
	local houseCF = houseOf(player)
	if houseCF and hasGarage(data) and (GarageLayout.Center(houseCF) - charRoot.Position).Magnitude < SPAWN_RANGE_GARAGE then
		local bays = GarageLayout.Assign(ownedList(data), carId)
		target = GarageLayout.BayCFrame(houseCF, bays[carId] or 2)
		fromGarage = true
	end
	if not target then
		local size = CarModels.Dimensions(carId)
		-- (v10, PHYS10) les autres voitures et les autres joueurs COMPTENT
		-- (on s'y cogne maintenant) : jamais d'apparition dans quelqu'un
		local ignore: { Instance } = { character }
		target = findSpot(charRoot.CFrame, size, ignore)
	end
	local car = makeCar(player, data, carId, target :: CFrame, false, fromGarage)
	sit(player, car)
	local def = Config.CarsById[carId]
	return true, T(player, "%s Let's drive! WASD / arrows, jump to get out", def and def.Icon or "🚗")
end

local function honk(player: Player): (boolean, string)
	local car = cars[player]
	if not car then
		return false, T(player, "Invalid request")
	end
	local old = car.Root:FindFirstChild("Honk")
	if old then
		old:Destroy()
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "Honk"
	gui.Size = UDim2.fromOffset(150, 56)
	gui.StudsOffsetWorldSpace = Vector3.new(0, (tonumber(car.Model:GetAttribute("Height")) or 5) + 1.5, 0)
	gui.MaxDistance = 90
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0.2
	label.TextStrokeColor3 = Color3.fromRGB(236, 72, 140)
	label.Text = "💨 Tut-tut !"
	label.Parent = gui
	gui.Parent = car.Root
	task.delay(1.6, function()
		if gui.Parent then
			gui:Destroy()
		end
	end)
	return true, ""
end

local function reset(player: Player): (boolean, string)
	local car = cars[player]
	if not car then
		return false, T(player, "Invalid request")
	end
	pcall(function()
		car.Root.AssemblyLinearVelocity = Vector3.zero
		car.Root.AssemblyAngularVelocity = Vector3.zero
		car.Root.CFrame = flatten(car.LastSafe) + Vector3.new(0, 2, 0)
	end)
	return true, T(player, "🔄 Back on its wheels!")
end

----------------------------------------------------------------------
-- Achats
----------------------------------------------------------------------

local function buy(player: Player, data: any, carId: any): (boolean, string, number?)
	local car = type(carId) == "string" and Config.CarsById[carId] or nil
	if not car then
		return false, T(player, "Invalid request")
	end
	if data.Cars.Owned[car.Id] then
		return false, T(player, "You already own this car")
	end
	local lock = (tonumber(car.RequiresRebirths) or 0) > (tonumber(data.Rebirths) or 0)
	if lock then
		return false, T(player, "🔒 Unlocked after %d visits to the ocean", tonumber(car.RequiresRebirths) or 0)
	end
	local cost = car.Cost
	if not isValidNumber(cost) or cost < 0 then
		return false, T(player, "Invalid request")
	end
	if not isValidNumber(data.Dopamine) or data.Dopamine < cost then
		local missing = math.max(0, cost - (isValidNumber(data.Dopamine) and data.Dopamine or 0))
		return false, T(player, "Not enough %s", Config.Game.CurrencyName), missing
	end
	data.Dopamine -= cost
	data.Cars.Owned[car.Id] = true
	data.Cars.Colors[car.Id] = data.Cars.Colors[car.Id] or car.DefaultColor
	data.Cars.Selected = car.Id
	sendState(player)
	publish(player)
	return true, T(player, "%s %s is yours! Drive it in Dopamine Town (%s)", car.Icon, T(player, car.Name), NumberFormatter.Format(cost))
end

local function buyGarage(player: Player, data: any): (boolean, string, number?)
	local garage = Config.House.Garage
	if data.Cars.Garage then
		return false, T(player, "You already have a garage")
	end
	if (tonumber(data.Rebirths) or 0) < (tonumber(garage.RequiresRebirths) or 0) then
		return false, T(player, "🔒 Unlocked after %d visits to the ocean", tonumber(garage.RequiresRebirths) or 0)
	end
	local house = data.House
	if not (house and house.OwnedSizes and house.OwnedSizes[garage.RequiresSize]) then
		local size = Config.HouseSizesById[garage.RequiresSize]
		return false, T(player, "🏰 You need the %s first", T(player, size and size.Name or tostring(garage.RequiresSize)))
	end
	local cost = garage.Cost
	if not isValidNumber(data.Dopamine) or data.Dopamine < cost then
		local missing = math.max(0, cost - (isValidNumber(data.Dopamine) and data.Dopamine or 0))
		return false, T(player, "Not enough %s", Config.Game.CurrencyName), missing
	end
	data.Dopamine -= cost
	data.Cars.Garage = true
	sendState(player)
	publish(player)
	return true, T(player, "%s Your garage is built! Your cars are parked inside", garage.Icon)
end

local function setColor(player: Player, data: any, carId: any, colorId: any): (boolean, string)
	if type(carId) ~= "string" or not data.Cars.Owned[carId] or type(colorId) ~= "string" or not Config.CarColorsById[colorId] then
		return false, T(player, "Invalid request")
	end
	data.Cars.Colors[carId] = colorId
	sendState(player)
	publish(player)
	-- voiture sortie : repeinte tout de suite, même au volant (v9.8 : on ne
	-- change que la couleur des pièces "Paint", rien ne bouge)
	local car = cars[player]
	if car and car.CarId == carId then
		CarModels.Repaint(car.Model, carId, colorId)
	end
	local paint = Config.CarColorsById[colorId]
	return true, T(player, "🎨 %s applied", T(player, paint.Name))
end

local function select_(player: Player, data: any, carId: any): (boolean, string)
	if type(carId) ~= "string" or not data.Cars.Owned[carId] then
		return false, T(player, "Invalid request")
	end
	data.Cars.Selected = carId
	sendState(player)
	publish(player)
	local car = Config.CarsById[carId]
	return true, T(player, "%s %s selected", car.Icon, T(player, car.Name))
end

----------------------------------------------------------------------
-- 🔧 (v10, CARS10) Atelier : options visuelles, préparation, plaque
----------------------------------------------------------------------

local function isUnlocked(data: any, carId: string, kind: string, id: string): boolean
	local list = Config.Cars.Mods[kind]
	if list and list[1] and list[1].Id == id then
		return true -- (l'origine est toujours gratuite)
	end
	local entry = Config.CarModsById[kind] and Config.CarModsById[kind][id]
	if entry and (tonumber(entry.Price) or 0) <= 0 then
		return true
	end
	local set = data.Cars.Unlocked[carId]
	return type(set) == "table" and set[kind .. ":" .. id] == true
end

-- Paiement (Dopamine) -> (ok, message?, manque?)
local function pay(player: Player, data: any, cost: number): (boolean, string?, number?)
	if not isValidNumber(cost) or cost < 0 then
		return false, T(player, "Invalid request"), nil
	end
	if cost <= 0 then
		return true, nil, nil
	end
	if not isValidNumber(data.Dopamine) or data.Dopamine < cost then
		local missing = math.max(0, cost - (isValidNumber(data.Dopamine) and data.Dopamine or 0))
		return false, T(player, "Not enough %s", Config.Game.CurrencyName), missing
	end
	data.Dopamine -= cost
	return true, nil, nil
end

-- Voiture sortie et garée : reconstruite sur place avec ses nouvelles options
local function refreshOut(player: Player, data: any, carId: string)
	local car = cars[player]
	if car and car.CarId == carId and not car.Loaner and not car.Driving and car.Seat.Occupant == nil and car.Root.Parent then
		local cf = flatten(car.Model:GetPivot())
		pcall(makeCar, player, data, carId, cf, false, car.Model:GetAttribute("FromGarage") == true)
	end
end

-- "setMod" carId, "Kind:Id" : applique une option (achetée une fois par voiture)
local function setMod(player: Player, data: any, carId: any, pair: any): (boolean, string, number?)
	if type(carId) ~= "string" or not data.Cars.Owned[carId] or type(pair) ~= "string" or #pair > 40 then
		return false, T(player, "Invalid request")
	end
	local kind, id = string.match(pair, "^(%w+):(%w+)$")
	local entry = kind and id and Config.CarModsById[kind] and Config.CarModsById[kind][id]
	if not entry then
		return false, T(player, "Invalid request")
	end
	local need = tonumber(entry.RequiresRebirths) or 0
	if (tonumber(data.Rebirths) or 0) < need then
		return false, T(player, "🔒 Unlocked after %d visits to the ocean", need)
	end
	local owned = isUnlocked(data, carId, kind :: string, id :: string)
	if not owned then
		local cost = CarModels.PriceFor(carId, entry.Price)
		local ok, message, missing = pay(player, data, cost)
		if not ok then
			return false, message or "", missing
		end
		data.Cars.Unlocked[carId] = data.Cars.Unlocked[carId] or {}
		data.Cars.Unlocked[carId][kind .. ":" .. id] = true
	end
	local mods = data.Cars.Mods[carId] or {}
	mods[kind] = id
	data.Cars.Mods[carId] = CarModels.CleanMods(mods)
	sendState(player)
	publish(player)
	refreshOut(player, data, carId)
	return true, T(player, "🔧 %s applied", T(player, entry.Name))
end

-- "tune" carId, "Engine" | "Tyres" | "Suspension" : niveau suivant
local function tune(player: Player, data: any, carId: any, partId: any): (boolean, string, number?)
	local part = type(partId) == "string" and Config.CarTuningById[partId] or nil
	if type(carId) ~= "string" or not data.Cars.Owned[carId] or not part then
		return false, T(player, "Invalid request")
	end
	local tuning = CarModels.TuningOf(data, carId)
	local level = (tuning :: any)[part.Id] + 1
	local maxLevel = tonumber(Config.Cars.Tuning.MaxLevel) or 3
	if level > maxLevel then
		return false, T(player, "Already at the max level")
	end
	local need = type(part.RequiresRebirths) == "table" and tonumber(part.RequiresRebirths[level]) or 0
	if (tonumber(data.Rebirths) or 0) < need then
		return false, T(player, "🔒 Unlocked after %d visits to the ocean", need)
	end
	local cost = CarModels.PriceFor(carId, type(part.Price) == "table" and part.Price[level] or 0)
	local ok, message, missing = pay(player, data, cost)
	if not ok then
		return false, message or "", missing
	end
	;(tuning :: any)[part.Id] = level
	data.Cars.Tuning[carId] = tuning
	sendState(player)
	-- voiture sortie : ses performances changent tout de suite (CarClient lit l'attribut)
	local car = cars[player]
	if car and car.CarId == carId and not car.Loaner then
		local stats = CarModels.Stats(carId, tuning)
		pcall(function()
			car.Model:SetAttribute("TopSpeed", stats.TopSpeed)
			car.Model:SetAttribute("Rating", stats.Rating)
			car.Model:SetAttribute("Class", stats.Class)
			car.Model:SetAttribute("Tuning", string.format("%d%d%d", tuning.Engine, tuning.Tyres, tuning.Suspension))
		end)
	end
	return true, T(player, "%s %s level %d!", part.Icon, T(player, part.Name), level)
end

-- "plate" carId, texte : plaque personnalisée (A-Z, 0-9, espace ; filtrée)
local function setPlate(player: Player, data: any, carId: any, text: any): (boolean, string, number?)
	if type(carId) ~= "string" or not data.Cars.Owned[carId] or type(text) ~= "string" then
		return false, T(player, "Invalid request")
	end
	local maxLength = tonumber(Config.Cars.PlateMaxLength) or 8
	local clean = string.upper(text)
	clean = string.gsub(clean, "[^A-Z0-9 ]", "")
	clean = string.gsub(clean, "^%s+", "")
	clean = string.gsub(clean, "%s+$", "")
	clean = string.gsub(clean, "%s+", " ")
	if #clean == 0 then
		-- plaque d'origine (gratuit)
		data.Cars.Plates[carId] = nil
		sendState(player)
		refreshOut(player, data, carId)
		return true, T(player, "🔖 Original plate")
	end
	if #clean > maxLength then
		return false, T(player, "%d characters max", maxLength)
	end
	local okFilter, filtered = pcall(function()
		local result = TextService:FilterStringAsync(clean, player.UserId)
		return result:GetNonChatStringForBroadcastAsync()
	end)
	if not okFilter or type(filtered) ~= "string" then
		return false, T(player, "Network error, try again.")
	end
	if filtered ~= clean or string.find(filtered, "#", 1, true) then
		return false, T(player, "🚫 This plate is not allowed")
	end
	if data.Cars.Plates[carId] == clean then
		return true, ""
	end
	local cost = CarModels.PriceFor(carId, Config.Cars.PlatePrice)
	local ok, message, missing = pay(player, data, cost)
	if not ok then
		return false, message or "", missing
	end
	data.Cars.Plates[carId] = clean
	sendState(player)
	refreshOut(player, data, carId)
	return true, T(player, "🔖 Plate %s applied", clean)
end

----------------------------------------------------------------------
-- Remote
----------------------------------------------------------------------

local INTERVALS = { buy = 0.4, buyGarage = 0.4, setColor = 0.25, select = 0.25, exit = 0.3, despawn = 0.5, reset = 2, setMod = 0.2, tune = 0.4, plate = 2 }

local function onCar(player: Player, action: any, a: any, b: any): (boolean, string, any?)
	if type(action) ~= "string" or #action > 24 then
		return false, T(player, "Invalid request")
	end
	local interval = INTERVALS[action]
	if action == "spawn" then
		interval = Config.Cars.SpawnCooldown
	elseif action == "honk" then
		interval = Config.Cars.HonkCooldown
	end
	if not interval then
		return false, T(player, "Invalid request")
	end
	if not RateLimiter.Check(player, "Car_" .. action, interval) then
		if action == "honk" then
			return false, ""
		end
		return false, T(player, "Slow down!")
	end
	local data = dataOf(player)
	if not data or (services.GameService.IsReady and not services.GameService:IsReady(player)) then
		return false, T(player, "Loading...")
	end
	CarService.Sanitize(data)
	if action == "buy" then
		return buy(player, data, a)
	elseif action == "buyGarage" then
		return buyGarage(player, data)
	elseif action == "setColor" then
		return setColor(player, data, a, b)
	elseif action == "select" then
		return select_(player, data, a)
	elseif action == "setMod" then
		return setMod(player, data, a, b)
	elseif action == "tune" then
		return tune(player, data, a, b)
	elseif action == "plate" then
		return setPlate(player, data, a, b)
	end
	-- en ville seulement
	local world = services.WorldService
	if world and world.IsInTown and not world:IsInTown(player) then
		return false, T(player, "Walk around the town first")
	end
	if action == "spawn" then
		return spawnCar(player, data)
	elseif action == "exit" then
		local car = cars[player]
		if car then
			pcall(function()
				local weld = car.Seat:FindFirstChild("SeatWeld")
				if weld then
					weld:Destroy()
				end
			end)
		end
		return true, ""
	elseif action == "despawn" then
		despawn(player, true)
		return true, ""
	elseif action == "honk" then
		return honk(player)
	elseif action == "reset" then
		return reset(player)
	end
	return false, T(player, "Invalid request")
end

----------------------------------------------------------------------
-- Ronde : sécurité, rangement
----------------------------------------------------------------------

local function patrol()
	if next(cars) == nil then
		return
	end
	local zones = houses()
	local floorY = WorldLayout.Origin().Y - 30
	local world = services and services.WorldService
	for player, car in pairs(cars) do
		local root = car.Root
		if not root.Parent or not player.Parent then
			despawn(player, true)
		elseif world and world.IsInTown and not world:IsInTown(player) then
			despawn(player, true)
		elseif not car.Driving and os.clock() - car.LastUsed > Config.Cars.IdleDespawn then
			despawn(player, false)
		elseif car.Driving then
			local cf = root.CFrame
			local bad = cf.Position.Y < floorY or cf.UpVector.Y < 0.3 or forbidden(cf.Position, zones)
			local speed = root.AssemblyLinearVelocity.Magnitude
			if bad or speed > MAX_SPEED_CLAMP then
				pcall(function()
					root.AssemblyLinearVelocity = Vector3.zero
					root.AssemblyAngularVelocity = Vector3.zero
					if bad then
						root.CFrame = flatten(car.LastSafe)
					end
				end)
				if bad and cf.Position.Y >= floorY and cf.UpVector.Y >= 0.3 then
					toast(player, T(player, "🚫 No cars inside!"))
				end
			else
				car.LastSafe = cf
				car.LastUsed = os.clock()
			end
		end
	end
end

----------------------------------------------------------------------
-- Cycle de vie
----------------------------------------------------------------------

function CarService:Init(allServices)
	services = allServices
end

function CarService:Start()
	setupGroups()
	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(watchCharacter)
		if player.Character then
			watchCharacter(player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayer(player)
	end
	Net.Function("Car").OnServerInvoke = function(player: Player, action: any, a: any, b: any)
		local ok, success, message, extra = pcall(onCar, player, action, a, b)
		if not ok then
			warn("[CarService] Erreur pour " .. player.Name .. " :", success)
			return false, T(player, "Invalid request")
		end
		return success, message, extra
	end
	local clock = 0
	RunService.Heartbeat:Connect(function(dt: number)
		clock += dt
		if clock >= PATROL_INTERVAL then
			clock = 0
			local ok, err = pcall(patrol)
			if not ok then
				warn("[CarService] Ronde : " .. tostring(err))
			end
		end
	end)
end

function CarService:PlayerReady(player: Player, data)
	CarService.Sanitize(data)
	publish(player)
end

function CarService:PlayerRemoving(player: Player)
	despawn(player, true)
end

-- État client (GameService.BuildState) : ClientState.Data.Cars
function CarService:GetClientState(_player: Player, data)
	if type(data) ~= "table" then
		return nil
	end
	if type(data.Cars) ~= "table" then
		CarService.Sanitize(data)
	end
	return { Cars = data.Cars }
end

-- (WorldService, instantané de la maison) garage visible ? (aile du manoir)
function CarService:GarageSnapshot(player: Player): boolean
	return hasGarage(dataOf(player))
end

-- (tests / autres services) la voiture sortie d'un joueur
function CarService:GetCar(player: Player): Model?
	local car = cars[player]
	return car and car.Model or nil
end

-- (v10, CARS10 -> RACE10) performances d'une voiture du joueur avec SA
-- préparation (carId nil = voiture choisie ; nil si pas possédée)
function CarService:GetStats(player: Player, carId: string?): any
	local data = dataOf(player)
	if type(data) ~= "table" then
		return nil
	end
	CarService.Sanitize(data)
	local id = if type(carId) == "string" then carId else data.Cars.Selected
	if type(id) ~= "string" or not data.Cars.Owned[id] then
		return nil
	end
	return CarModels.Stats(id, CarModels.TuningOf(data, id))
end

----------------------------------------------------------------------
-- 🏁 (v10, CARS10 -> RACE10) courses : placer / bloquer / rendre
----------------------------------------------------------------------

-- Met la voiture CHOISIE du joueur sur la grille (`cf` = pivot au sol, avant
-- vers -Z), la fait apparaître si elle n'est pas sortie, et l'assoit au
-- volant. Sans voiture : une "CityCar" de prêt (attribut "Loaner"), rendue
-- par RaceRelease. -> (ok, message?)
function CarService:RaceSpawn(player: Player, cf: CFrame): (boolean, string?)
	if typeof(cf) ~= "CFrame" then
		return false, "bad cframe"
	end
	local data = dataOf(player)
	if type(data) ~= "table" then
		return false, T(player, "Loading...")
	end
	local _, humanoid = characterOf(player)
	if not humanoid then
		return false, T(player, "Walk around the town first")
	end
	CarService.Sanitize(data)
	local target = flatten(cf)
	local selected = data.Cars.Selected
	local owned = type(selected) == "string" and selected ~= "" and data.Cars.Owned[selected] == true
	local carId = if owned then selected else "CityCar"
	local car = cars[player]
	local ok, err = pcall(function()
		if car and car.Root.Parent and car.CarId == carId and car.Loaner == not owned then
			-- déjà sortie : on la pose sur la grille (tout l'assemblage suit la Root)
			local root = car.Root
			local wasAnchored = root.Anchored
			root.Anchored = true
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			car.Model:PivotTo(target)
			car.LastSafe = root.CFrame
			car.LastUsed = os.clock()
			if not wasAnchored and not car.Frozen and car.Seat.Occupant ~= nil then
				root.Anchored = false
				pcall(function()
					root:SetNetworkOwner(player)
				end)
			end
		else
			car = makeCar(player, data, carId, target, not owned, false)
		end
	end)
	if not ok or not car then
		warn("[CarService] RaceSpawn : " .. tostring(err))
		return false, T(player, "Invalid request")
	end
	sit(player, car :: Car)
	return true, nil
end

-- Fin de course : rend la voiture de prêt (la vraie voiture reste sortie)
function CarService:RaceRelease(player: Player)
	local car = cars[player]
	if not car then
		return
	end
	if car.Frozen then
		CarService:SetFrozen(player, false)
	end
	if car.Loaner then
		despawn(player, true)
	end
end

-- Compte à rebours : voiture ancrée sur place (frozen = true), puis libérée
-- (désancrée, propriété réseau rendue au conducteur)
function CarService:SetFrozen(player: Player, frozen: boolean)
	local car = cars[player]
	if not car or not car.Root.Parent then
		return
	end
	car.Frozen = frozen == true
	pcall(function()
		local root = car.Root
		if car.Frozen then
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			root.Anchored = true
			car.Model:SetAttribute("Frozen", true)
		else
			car.Model:SetAttribute("Frozen", nil)
			car.LastSafe = root.CFrame
			if car.Seat.Occupant ~= nil then
				root.Anchored = false
				root:SetNetworkOwner(player)
			end
		end
	end)
end

return CarService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="359">
        <Properties>
          <string name="Name">CasinoService</string>
          <string name="Source"><![CDATA[--[[
	CasinoService (ModuleScript)
	Emplacement : ServerScriptService > Services > CasinoService

	🎰 Machine chanceuse (débloquée par l'amélioration "Lucky Machine").
	Tours GRATUITS : on ne mise JAMAIS rien (la Dopamine s'achète en Robux,
	donc aucun pari avec elle : règles Roblox sur les jeux d'argent).
	  - Jetons : 1 toutes les Config.Casino.TokenInterval secondes de jeu
	    (au plus MaxTokens). StartTokens offerts une seule fois quand la
	    machine est débloquée (data.Casino.Tokens = -1 : jamais initialisé).
	  - Un tour coûte 1 jeton. Le SERVEUR tire les 3 symboles (selon leur
	    poids) ; le gain vaut des SECONDES de production
	    (Formulas.GetCasinoRewardSeconds -> Formulas.ScaledReward) : paire,
	    triple, ou petit lot de consolation (MissRewardSeconds).
	  - Fermée seulement si Config.Casino.Enabled = false (ou si
	    Config.Monetization.DisableCasinoWhenSelling est forcé à true).
	Le client ne fait qu'afficher l'animation puis le résultat reçu.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Locale = require(ReplicatedStorage.Shared.Locale)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Net = require(ReplicatedStorage.Shared.Net)
local RateLimiter = require(script.Parent.RateLimiter)

local CasinoService = {}

local services
local random = Random.new()
local settings = Config.Casino

local CHARGE_RATE = 1 -- (s) fréquence de la recharge des jetons
local BIG_WIN_SECONDS = 240 -- à partir de ce gain (en secondes), tout le serveur est prévenu

function CasinoService:Init(allServices)
	services = allServices
end

local function isValidNumber(value: any): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

-- Répare data.Casino (sauvegarde abîmée) et donne les jetons de départ
-- la première fois que la machine est possédée. Renvoie true si ça a changé.
local function ensure(data): boolean
	local casino = data.Casino
	if type(casino) ~= "table" then
		casino = { Tokens = -1, Progress = 0 }
		data.Casino = casino
	end
	local changed = false
	if not isValidNumber(casino.Tokens) then
		casino.Tokens = -1
	end
	if not isValidNumber(casino.Progress) then
		casino.Progress = 0
	end
	casino.Progress = math.clamp(casino.Progress, 0, 1)
	if casino.Tokens < 0 then
		casino.Tokens = -1
		if Formulas.HasFeature(data, settings.Feature) then
			casino.Tokens = math.clamp(math.floor(settings.StartTokens or 0), 0, settings.MaxTokens)
			casino.Progress = 0
			changed = true
		end
	else
		casino.Tokens = math.clamp(math.floor(casino.Tokens), 0, settings.MaxTokens)
	end
	if casino.Tokens >= settings.MaxTokens then
		casino.Progress = 0
	end
	return changed
end

-- Recharge : `elapsed` secondes de jeu. Renvoie true si un jeton a été gagné.
local function charge(data, elapsed: number): boolean
	local changed = ensure(data)
	local casino = data.Casino
	if casino.Tokens < 0 or not Formulas.HasFeature(data, settings.Feature) then
		return changed
	end
	if casino.Tokens >= settings.MaxTokens then
		casino.Progress = 0
		return changed
	end
	casino.Progress += elapsed / math.max(1, settings.TokenInterval)
	while casino.Progress >= 1 and casino.Tokens < settings.MaxTokens do
		casino.Progress -= 1
		casino.Tokens += 1
		changed = true
	end
	if casino.Tokens >= settings.MaxTokens then
		casino.Progress = 0
	end
	return changed
end

-- Ajoute des jetons (commandes de test, récompenses éventuelles)
function CasinoService:AddTokens(player: Player, count: number)
	local data = services.DataService:GetData(player)
	if not data or not isValidNumber(count) then
		return
	end
	ensure(data)
	data.Casino.Tokens = math.clamp(math.max(0, data.Casino.Tokens) + math.floor(count), 0, settings.MaxTokens)
	services.GameService:SendState(player)
end

-- Champs ajoutés à l'état envoyé au client (voir GameService:BuildState)
function CasinoService:GetClientState(_player: Player, data)
	ensure(data)
	local casino = data.Casino
	return {
		Casino = {
			Tokens = math.max(0, casino.Tokens),
			Progress = casino.Progress,
			Max = settings.MaxTokens,
			Interval = settings.TokenInterval,
		},
	}
end

-- Tire un symbole au hasard selon son poids
local function pickSymbol(): string
	local total = 0
	for _, symbol in ipairs(settings.Symbols) do
		total += symbol.Weight
	end
	local roll = random:NextNumber(0, total)
	for _, symbol in ipairs(settings.Symbols) do
		roll -= symbol.Weight
		if roll <= 0 then
			return symbol.Id
		end
	end
	return settings.Symbols[#settings.Symbols].Id
end

-- Texte dans la langue du joueur
local function T(player: Player, text: string, ...): string
	return services.GameService:T(player, text, ...)
end

local function formatWait(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

local function onSpin(player: Player, _ignored: any)
	local data = services.DataService:GetData(player)
	if not data or not services.GameService:IsReady(player) then
		return false, T(player, "Loading...")
	end
	if not services.MonetizationService:IsCasinoEnabled() then
		return false, T(player, "The lucky machine is closed")
	end
	if not Formulas.HasFeature(data, settings.Feature) then
		return false, T(player, "The lucky machine isn't unlocked yet")
	end
	-- Petite marge pour la latence réseau
	if not RateLimiter.Check(player, "CasinoSpin", math.max(0, settings.Cooldown - 0.1)) then
		return false, T(player, "The machine is still spinning...")
	end
	ensure(data)
	local casino = data.Casino
	if casino.Tokens < 1 then
		local wait = (1 - casino.Progress) * settings.TokenInterval
		return false, T(player, "No tokens left! Next one in %s", formatWait(wait))
	end

	local reels = { pickSymbol(), pickSymbol(), pickSymbol() }
	local matched = Formulas.GetCasinoMultiplier(reels)
	local seconds = Formulas.GetCasinoRewardSeconds(reels)
	local missSeconds = math.max(1, settings.MissRewardSeconds or 1)
	local minimum = (settings.MinReward or 0) * math.max(1, seconds / missSeconds)
	local reward = Formulas.ScaledReward(services.GameService:GetStats(player), seconds, minimum)

	casino.Tokens -= 1
	data.Stats.SlotSpins += 1
	if matched > 0 then
		data.Stats.SlotWins += 1
	end
	services.GameService:AddDopamine(player, reward, true)
	services.QuestService:Progress(player, "Casino", 1)
	services.GameService:SendState(player)

	if matched >= BIG_WIN_SECONDS then
		local displayName, formatted = player.DisplayName, NumberFormatter.Format(reward)
		services.GameService:NotifyAll(function(lang)
			return {
				Type = "Info",
				Text = Locale.TFor(lang, "🎰 %s hit the jackpot on the lucky machine (+%s)!", displayName, formatted),
			}
		end, player)
	end

	return true, {
		Symbols = reels,
		Reels = reels, -- (ancien nom)
		Reward = reward,
		Seconds = seconds,
		Win = matched > 0,
		Big = matched >= BIG_WIN_SECONDS,
		Tokens = casino.Tokens,
		Progress = casino.Progress,
		Max = settings.MaxTokens,
		Interval = settings.TokenInterval,
	}
end

function CasinoService:Start()
	Net.Function("CasinoSpin").OnServerInvoke = onSpin

	-- Recharge des jetons avec le temps de jeu (indépendante du tick passif)
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(CHARGE_RATE)
			local now = os.clock()
			local elapsed = math.min(now - last, 5) -- pas d'énorme rattrapage après un gel
			last = now
			for _, player in ipairs(Players:GetPlayers()) do
				local data = services.DataService:GetData(player)
				if data and services.GameService:IsReady(player) then
					local ok, changed = pcall(charge, data, elapsed)
					if not ok then
						warn("[CasinoService] Recharge des jetons de " .. player.Name .. " :", changed)
					elseif changed then
						-- Nouveau jeton : état complet (au plus 1 fois / TokenInterval)
						services.GameService:SendState(player)
					end
				end
			end
		end
	end)
end

return CasinoService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="360">
        <Properties>
          <string name="Name">ChatService</string>
          <string name="Source"><![CDATA[--[[
	ChatService (ModuleScript)
	Emplacement : ServerScriptService > Services > ChatService

	Texte TAPÉ par le joueur (chat du live, mails écrits) : obligatoirement
	passé par le filtre de Roblox (TextService) avant d'être affiché, même
	au joueur lui-même.

	RemoteFunction "FilterText" (purpose, text) -> (ok, résultat | message)
	  purpose : "Live" (message du chat du live) ou "Mail" (mail écrit)
	  résultat : { Text = texte filtré pour CE joueur, Topics = { sujets } }
	  Les sujets (ChatTopics.Detect) servent aux faux spectateurs /
	  correspondants pour répondre "en fonction de ce qu'il a dit" ; v9 : si
	  le filtre a masqué des mots, les sujets viennent du texte FILTRÉ (on ne
	  réagit jamais à un mot censuré). Le texte brut n'est jamais renvoyé ni
	  montré à personne.
	Anti-spam : 1 message / 1,2 s (live), 1 / 2 s (mail) ; longueur limitée.
	Si le filtre échoue (panne Roblox), le message n'est PAS affiché.
]]

local TextService = game:GetService("TextService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local ChatTopics = require(Shared.ChatTopics)

local RateLimiter = require(script.Parent.RateLimiter)

local ChatService = {}

local services = nil

local PURPOSES = {
	Live = { MaxLength = 120, Interval = 1.2 },
	Mail = { MaxLength = 400, Interval = 2 },
}

function ChatService:Init(allServices)
	services = allServices
end

local function T(player: Player, text: string, ...): string
	local game = services and services.GameService
	if game and game.T then
		return game:T(player, text, ...)
	end
	return string.format(text, ...)
end

-- Nettoie le texte reçu : caractères de contrôle retirés, espaces réduits
local function clean(text: string, maxLength: number): string
	text = string.gsub(text, "[%c]", " ")
	text = string.gsub(text, "%s+", " ")
	text = string.gsub(text, "^%s+", "")
	text = string.gsub(text, "%s+$", "")
	if utf8.len(text) == nil then
		return "" -- UTF-8 invalide : refusé
	end
	if (utf8.len(text) :: number) > maxLength then
		local cut = utf8.offset(text, maxLength + 1)
		if cut then
			text = string.sub(text, 1, cut - 1)
		end
	end
	return text
end

local function onFilter(player: Player, purpose: any, text: any)
	local settings = type(purpose) == "string" and PURPOSES[purpose] or nil
	if not settings or type(text) ~= "string" then
		return false, T(player, "Invalid message")
	end
	if #text > settings.MaxLength * 4 then
		return false, T(player, "Message too long")
	end
	if not RateLimiter.Check(player, "FilterText_" .. purpose, settings.Interval) then
		return false, T(player, "Slow down a little!")
	end
	local cleaned = clean(text, settings.MaxLength)
	if cleaned == "" then
		return false, T(player, "Invalid message")
	end
	local ok, filtered = pcall(function()
		local result = TextService:FilterStringAsync(cleaned, player.UserId, Enum.TextFilterContext.PublicChat)
		return result:GetNonChatStringForUserAsync(player.UserId)
	end)
	if not ok or type(filtered) ~= "string" then
		return false, T(player, "Message could not be sent, try again")
	end
	-- Sujets : sur le texte tel que le joueur a le droit de le dire. Si le
	-- filtre a masqué des mots (#####), on ne réagit qu'à ce qui reste lisible
	-- (jamais à un mot censuré).
	local topics = ChatTopics.Detect(filtered == cleaned and cleaned or filtered)
	return true, { Text = filtered, Topics = topics }
end

function ChatService:Start()
	Net.Function("FilterText").OnServerInvoke = onFilter
end

return ChatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="361">
        <Properties>
          <string name="Name">CosmeticService</string>
          <string name="Source"><![CDATA[--[[
	CosmeticService (ModuleScript)
	Emplacement : ServerScriptService > Services > CosmeticService

	Boutique d'objets (débloquée par l'amélioration "Boutique d'objets") :
	chapeaux (emoji posé sur le bouton) et skins (couleurs du bouton).
	Les objets achetés sont gardés pour toujours et donnent chacun un petit
	bonus de gains permanent (Config.CosmeticBonus).
	RemoteFunction ItemShop ("buy" | "equip" | "unequip", cosmeticId).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Net = require(ReplicatedStorage.Shared.Net)
local RateLimiter = require(script.Parent.RateLimiter)

local CosmeticService = {}

local services

function CosmeticService:Init(allServices)
	services = allServices
end

-- Texte dans la langue du joueur
local function T(player: Player, text: string, ...): string
	return services.GameService:T(player, text, ...)
end

local function onItemShop(player: Player, action: any, cosmeticId: any)
	if not RateLimiter.Check(player, "ItemShop", 0.2) then
		return false, T(player, "Slow down!")
	end
	local data = services.DataService:GetData(player)
	if not data or not services.GameService:IsReady(player) then
		return false, T(player, "Loading...")
	end
	if not Formulas.HasFeature(data, "ItemShop") then
		return false, T(player, "The shop isn't unlocked yet")
	end
	if type(action) ~= "string" or type(cosmeticId) ~= "string" or #cosmeticId > 64 then
		return false, T(player, "Invalid request")
	end
	local cosmetic = Config.CosmeticsById[cosmeticId]
	if not cosmetic then
		return false, T(player, "Unknown item")
	end

	local cosmetics = data.Cosmetics
	local slot = cosmetic.Slot
	if slot ~= "Hat" and slot ~= "Skin" then
		return false, T(player, "Invalid item")
	end
	local name = T(player, cosmetic.Name)

	if action == "buy" then
		if cosmetics.Owned[cosmeticId] then
			return false, T(player, "You already own this item")
		end
		if (cosmetic.RequiresRebirths or 0) > (data.Rebirths or 0) then
			return false, T(player, "🔒 Unlocked after %d visits to the ocean", cosmetic.RequiresRebirths)
		end
		if data.Dopamine < cosmetic.Cost then
			return false, T(player, "Not enough %s", Config.Game.CurrencyName)
		end
		data.Dopamine -= cosmetic.Cost
		cosmetics.Owned[cosmeticId] = true
		cosmetics.Equipped[slot] = cosmeticId -- équipé tout de suite
		data.Stats.CosmeticsBought += 1
		services.GameService:SendState(player)
		return true, T(player, "%s %s bought! (%s)", cosmetic.Icon, name, NumberFormatter.Format(cosmetic.Cost))
	elseif action == "equip" then
		if not cosmetics.Owned[cosmeticId] then
			return false, T(player, "You don't own this item")
		end
		cosmetics.Equipped[slot] = cosmeticId
		services.GameService:SendState(player)
		return true, T(player, "%s %s equipped", cosmetic.Icon, name)
	elseif action == "unequip" then
		cosmetics.Equipped[slot] = ""
		services.GameService:SendState(player)
		return true, T(player, "%s %s removed", cosmetic.Icon, name)
	end
	return false, T(player, "Invalid request")
end

function CosmeticService:Start()
	Net.Function("ItemShop").OnServerInvoke = onItemShop
end

return CosmeticService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="362">
        <Properties>
          <string name="Name">DVDService</string>
          <string name="Source"><![CDATA[--[[
	DVDService (ModuleScript)
	Emplacement : ServerScriptService > Services > DVDService

	Logos DVD rebondissants (un par niveau de l'amélioration "Logo DVD").
	Le SERVEUR choisit la trajectoire de chaque logo (position, vitesse, heure
	de départ) et l'envoie au client, qui ne fait que l'afficher. Comme les
	trajectoires sont déterministes (voir DVDMath), le serveur peut :
	  - compter lui-même les rebonds (gain passif à chaque rebond) ;
	  - vérifier si un coin a vraiment été touché : un tricheur ne peut pas
	    inventer de jackpot.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DVDMath = require(ReplicatedStorage.Shared.DVDMath)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Locale = require(ReplicatedStorage.Shared.Locale)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Net = require(ReplicatedStorage.Shared.Net)
local RateLimiter = require(script.Parent.RateLimiter)

local DVDService = {}

local services
local random = Random.new()

-- Taille par défaut d'un logo (fraction de l'écran), corrigée dès que le
-- client envoie la vraie taille (DVDResize)
local DEFAULT_W = Config.DVD.LogoSize.X / 1280
local DEFAULT_H = Config.DVD.LogoSize.Y / 720
-- Zone de déplacement "de référence" : les gains de rebond sont ramenés à
-- cette taille, quelle que soit la taille envoyée par le client
local DEFAULT_RX, DEFAULT_RY = 1 - DEFAULT_W, 1 - DEFAULT_H
-- Après un redimensionnement, aucun coin n'est accepté pendant ce délai
-- (sinon le client pourrait choisir une taille qui "fabrique" un coin)
local RESIZE_CORNER_LOCK = 10
-- Temps minimum entre deux jackpots d'un même joueur (sécurité anti-abus)
local JACKPOT_COOLDOWN = 45

--[[
	[Player] = {
		Logos = { { Params, ClaimedCorners = { [k] = true }, LastBX, LastBY, Frac } },
		W, H = taille commune des logos,
		Carry = rebonds pas encore comptés (avant un changement de trajectoire),
		LastClick = os.clock() du dernier clic récompensé (recharge commune),
		LastResize = os.clock() du dernier redimensionnement appliqué,
		LastJackpot = os.clock() du dernier jackpot payé,
	}
]]
local states = {}

function DVDService:Init(allServices)
	services = allServices
end

local function now(): number
	return workspace:GetServerTimeNow()
end

-- Nouvelle trajectoire aléatoire (angle entre 25° et 65° pour éviter les
-- trajectoires trop horizontales ou verticales)
local function randomParams(w: number, h: number): DVDMath.Params
	local angle = math.rad(random:NextNumber(25, 65))
	local variation = Config.DVD.SpeedVariation or 0
	local speed = Config.DVD.Speed * (1 + random:NextNumber(-variation, variation))
	local signX = random:NextNumber() < 0.5 and -1 or 1
	local signY = random:NextNumber() < 0.5 and -1 or 1
	return {
		X0 = random:NextNumber(0, math.max(0, 1 - w)),
		Y0 = random:NextNumber(0, math.max(0, 1 - h)),
		VX = math.cos(angle) * speed * signX,
		VY = math.sin(angle) * speed * signY,
		T0 = now(),
		W = w,
		H = h,
	}
end

-- (Re)définit la trajectoire d'un logo en repartant les compteurs de rebonds
local function setParams(logo, params: DVDMath.Params)
	logo.Params = params
	logo.ClaimedCorners = {} -- nouvelle trajectoire = nouveaux numéros de rebond
	logo.LastBX, logo.LastBY = DVDMath.BounceIndex(params, now())
end

local function newLogo(w: number, h: number)
	local logo = { Frac = 0 }
	setParams(logo, randomParams(w, h))
	return logo
end

-- Rebonds d'un logo depuis le dernier comptage (plafonnés).
-- Chaque rebond est pondéré par (zone réelle / zone de référence) : un logo
-- plus gros (zone plus petite) rebondit plus souvent mais chaque rebond vaut
-- moins, donc la taille envoyée par le client ne change pas les gains.
local function countBounces(logo, t: number): number
	local params = logo.Params
	local bx, by = DVDMath.BounceIndex(params, t)
	local rx, ry = DVDMath.Ranges(params)
	local weighted = math.abs(bx - logo.LastBX) * rx / DEFAULT_RX + math.abs(by - logo.LastBY) * ry / DEFAULT_RY
	logo.LastBX, logo.LastBY = bx, by
	if weighted ~= weighted or weighted == math.huge then
		return 0
	end
	-- On garde la partie décimale pour le prochain comptage
	logo.Frac = (logo.Frac or 0) + weighted
	local whole = math.floor(logo.Frac)
	logo.Frac -= whole
	return math.min(whole, Config.DVD.MaxBouncesPerTick)
end

-- Avant de changer une trajectoire : on met de côté les rebonds pas encore comptés
local function flushBounces(state)
	local t = now()
	for _, logo in ipairs(state.Logos) do
		state.Carry += countBounces(logo, t)
	end
	state.Carry = math.min(state.Carry, Config.DVD.MaxBouncesPerTick * math.max(1, #state.Logos))
end

-- Nombre de logos que le joueur doit avoir (niveau de "Logo DVD")
local function desiredCount(player: Player): number
	local data = services.DataService:GetData(player)
	if not data then
		return 0
	end
	return Formulas.ComputeStats(data).DVDCount
end

local function isValidIndex(state, index: any): boolean
	return type(index) == "number" and index == math.floor(index) and index >= 1 and index <= #state.Logos
end

----------------------------------------------------------------------
-- API
----------------------------------------------------------------------

function DVDService:SendSetup(player: Player)
	local state = states[player]
	if not state then
		return
	end
	local list = {}
	for _, logo in ipairs(state.Logos) do
		local p = logo.Params
		table.insert(list, { X0 = p.X0, Y0 = p.Y0, VX = p.VX, VY = p.VY, T0 = p.T0, W = p.W, H = p.H })
	end
	Net.Event("DVDSetup"):FireClient(player, { Logos = list })
end

-- Ajoute / retire des logos pour correspondre au niveau de l'amélioration.
-- Les logos existants gardent leur trajectoire. Renvoie true si ça a changé.
function DVDService:SyncLogos(player: Player): boolean
	local state = states[player]
	if not state then
		return false
	end
	local wanted = desiredCount(player)
	local logos = state.Logos
	if #logos == wanted then
		return false
	end
	flushBounces(state)
	while #logos < wanted do
		table.insert(logos, newLogo(state.W, state.H))
	end
	while #logos > wanted do
		table.remove(logos)
	end
	self:SendSetup(player)
	return true
end

-- Détox / reset : tous les logos disparaissent (puis on recrée ceux encore dus)
function DVDService:Reset(player: Player)
	local state = states[player]
	if not state then
		return
	end
	state.Logos = {}
	state.Carry = 0
	state.LastClick = 0
	if not self:SyncLogos(player) then
		self:SendSetup(player) -- toujours prévenir le client (liste vide)
	end
end

-- Appelé par le tick passif de GameService : nombre total de rebonds
-- (tous les logos, horizontaux + verticaux) depuis le dernier appel
function DVDService:CollectBounces(player: Player, t: number): number
	local state = states[player]
	if not state then
		return 0
	end
	local total = state.Carry
	state.Carry = 0
	for _, logo in ipairs(state.Logos) do
		total += countBounces(logo, t)
	end
	return total
end

function DVDService:PlayerReady(player: Player)
	states[player] = {
		Logos = {},
		W = DEFAULT_W,
		H = DEFAULT_H,
		Carry = 0,
		LastClick = 0,
		-- -math.huge (et pas 0) : os.clock() peut être petit juste après le démarrage du serveur
		LastResize = -math.huge,
		LastJackpot = -math.huge,
		PendingResize = nil, -- taille reçue trop tôt, appliquée plus tard
		ResizeScheduled = false,
	}
	-- Crée les logos déjà achetés (le client recevra DVDSetup avec la synchro complète)
	local wanted = desiredCount(player)
	for _ = 1, wanted do
		table.insert(states[player].Logos, newLogo(DEFAULT_W, DEFAULT_H))
	end
end

function DVDService:PlayerRemoving(player: Player)
	states[player] = nil
end

----------------------------------------------------------------------
-- Remotes
----------------------------------------------------------------------

-- Applique une nouvelle taille à tous les logos en gardant la position et
-- la direction actuelles de chacun (pour qu'aucun logo ne "saute")
local function applyResize(player: Player, state, w: number, h: number)
	if math.abs(w - state.W) < 1e-4 and math.abs(h - state.H) < 1e-4 then
		return -- rien ne change
	end
	flushBounces(state)
	state.W, state.H = w, h
	state.LastResize = os.clock()
	local t = now()
	for _, logo in ipairs(state.Logos) do
		local params = logo.Params
		local x, y = DVDMath.Position(params, t)
		local dirX, dirY = DVDMath.Directions(params, t)
		-- Borné juste AVANT le bord : un logo collé au bord ne compte pas un
		-- faux rebond et ne se retrouve pas pile sur un "coin"
		setParams(logo, {
			X0 = math.clamp(x, 0, math.max(0, 1 - w - 1e-6)),
			Y0 = math.clamp(y, 0, math.max(0, 1 - h - 1e-6)),
			VX = math.abs(params.VX) * dirX,
			VY = math.abs(params.VY) * dirY,
			T0 = t,
			W = w,
			H = h,
		})
	end
	DVDService:SendSetup(player)
end

-- Le client indique la taille d'un logo à l'écran (en fraction de l'écran).
-- Trop rapproché (< 0.5 s) : la dernière taille reçue est appliquée un peu plus tard.
local function onResize(player: Player, w: any, h: any)
	local state = states[player]
	if not state then
		return
	end
	if type(w) ~= "number" or type(h) ~= "number" or w ~= w or h ~= h then
		return
	end
	w = math.clamp(w, 0.03, 0.5)
	h = math.clamp(h, 0.03, 0.5)

	if RateLimiter.Check(player, "DVDResize", 0.5) then
		state.PendingResize = nil
		applyResize(player, state, w, h)
		return
	end
	state.PendingResize = { W = w, H = h }
	if state.ResizeScheduled then
		return
	end
	state.ResizeScheduled = true
	task.delay(0.55, function()
		state.ResizeScheduled = false
		local pending = state.PendingResize
		state.PendingResize = nil
		-- Le joueur a pu partir (ou tout a été réinitialisé) entre-temps
		if pending and states[player] == state then
			applyResize(player, state, pending.W, pending.H)
		end
	end)
end

-- Clic sur un logo : petit bonus, avec un temps de recharge commun à tous les logos
local function onClick(player: Player, index: any)
	local state = states[player]
	local data = services.DataService:GetData(player)
	if not state or not data or not isValidIndex(state, index) then
		return
	end
	local clock = os.clock()
	-- 0.3 s de tolérance pour la latence
	if clock - state.LastClick < Config.DVD.ClickCooldown - 0.3 then
		return
	end
	state.LastClick = clock

	local reward = Formulas.ScaledReward(
		services.GameService:GetStats(player),
		Config.DVD.ClickRewardSeconds,
		Config.DVD.ClickMinReward
	)
	data.Stats.DVDClicks += 1
	services.GameService:AddDopamine(player, reward, true)
	services.GameService:Notify(player, {
		Type = "Bonus",
		Source = "DVD",
		Amount = reward,
		Index = index,
	})
end

-- Le client signale un coin du logo `index` au rebond horizontal numéro k : on VÉRIFIE
local function onCorner(player: Player, index: any, k: any)
	local state = states[player]
	local data = services.DataService:GetData(player)
	if not state or not data or not isValidIndex(state, index) then
		return
	end
	if type(k) ~= "number" or k ~= math.floor(k) or math.abs(k) > 1e9 then
		return
	end
	if not RateLimiter.Check(player, "DVDCorner" .. index, 0.3) then
		return
	end
	local clock = os.clock()
	-- Trajectoire tout juste imposée par un redimensionnement, ou jackpot trop récent : refusé
	if clock - state.LastResize < RESIZE_CORNER_LOCK or clock - state.LastJackpot < JACKPOT_COOLDOWN then
		return
	end
	local logo = state.Logos[index]
	if logo.ClaimedCorners[k] then
		return -- déjà récompensé
	end

	local params = logo.Params
	local bounceTime = DVDMath.BounceTimeX(params, k)
	local t = now()
	-- Le rebond doit avoir eu lieu récemment (et nettement après le début de la
	-- trajectoire : un "rebond" pile au départ n'est qu'un logo posé contre le bord)
	if bounceTime ~= bounceTime or bounceTime < params.T0 + 0.25 or bounceTime > t + 0.5 or bounceTime < t - 5 then
		return
	end
	if not DVDMath.IsCornerAtBounceX(params, k, Config.DVD.CornerTolerance) then
		return -- pas un vrai coin : tentative de triche ou erreur d'arrondi
	end

	logo.ClaimedCorners[k] = true
	state.LastJackpot = clock
	local reward = Formulas.ScaledReward(
		services.GameService:GetStats(player),
		Config.DVD.JackpotRewardSeconds,
		Config.DVD.JackpotMinReward
	)
	data.Stats.DVDCorners += 1
	services.GameService:AddDopamine(player, reward, true)
	services.GameService:Notify(player, {
		Type = "Jackpot",
		Amount = reward,
		Index = index,
		Text = services.GameService:T(player, "📀 PERFECT CORNER! +%s", NumberFormatter.Format(reward)),
	})
	local displayName = player.DisplayName
	services.GameService:NotifyAll(function(lang)
		return {
			Type = "Info",
			Text = Locale.TFor(lang, "📀 %s hit the PERFECT CORNER!", displayName),
		}
	end, player)
end

-- TEST (Studio) : place le 1er logo pour qu'il touche un coin dans ~2 secondes
function DVDService:DebugCorner(player: Player): boolean
	local state = states[player]
	if not state or #state.Logos == 0 then
		return false
	end
	flushBounces(state)
	-- Test : on lève les sécurités anti-abus des jackpots
	state.LastResize, state.LastJackpot = -math.huge, -math.huge
	local logo = state.Logos[1]
	local params = logo.Params
	local rangeX, rangeY = DVDMath.Ranges(params)
	local speedX, speedY = math.abs(params.VX), math.abs(params.VY)
	local delay = math.min(2, rangeX * 0.9 / speedX, rangeY * 0.9 / speedY)
	setParams(logo, {
		X0 = rangeX - speedX * delay,
		Y0 = rangeY - speedY * delay,
		VX = speedX,
		VY = speedY,
		T0 = now(),
		W = params.W,
		H = params.H,
	})
	self:SendSetup(player)
	return true
end

function DVDService:Start()
	Net.Event("DVDResize").OnServerEvent:Connect(onResize)
	Net.Event("DVDClick").OnServerEvent:Connect(onClick)
	Net.Event("DVDCorner").OnServerEvent:Connect(onCorner)
end

return DVDService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="363">
        <Properties>
          <string name="Name">DailyRewardService</string>
          <string name="Source"><![CDATA[--[[
	DailyRewardService (ModuleScript)
	Emplacement : ServerScriptService > Services > DailyRewardService

	Récompense quotidienne : 1 fois par jour (jour UTC). Revenir le jour
	suivant augmente la série (streak) et donc la récompense.
	L'heure utilisée est celle du SERVEUR (impossible à tricher en changeant
	l'heure de son PC). Nécessite la Feature "Daily" (amélioration "Calendrier").
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Net = require(ReplicatedStorage.Shared.Net)
local RateLimiter = require(script.Parent.RateLimiter)

local DailyRewardService = {}

local services
local SECONDS_PER_DAY = 86400

function DailyRewardService:Init(allServices)
	services = allServices
end

local function today(): number
	return math.floor(os.time() / SECONDS_PER_DAY)
end

-- Série qu'aurait le joueur s'il réclamait maintenant
local function nextStreak(data): number
	if data.Daily.LastDay == today() - 1 then
		return data.Daily.Streak + 1
	end
	return 1
end

local function computeReward(stats, streak: number): number
	local bonusDays = math.min(streak, Config.Daily.MaxStreakBonus) - 1
	local seconds = Config.Daily.BaseRewardSeconds + bonusDays * Config.Daily.StreakBonusSeconds
	return Formulas.ScaledReward(stats, seconds, Config.Daily.MinReward * math.min(streak, Config.Daily.MaxStreakBonus))
end

-- Infos affichées par le client
function DailyRewardService:GetInfo(player: Player, stats)
	local data = services.DataService:GetData(player)
	local available = data.Daily.LastDay < today()
	local streak = available and nextStreak(data) or data.Daily.Streak
	return {
		Available = available,
		Streak = streak,
		Reward = computeReward(stats, streak),
		-- secondes avant le prochain jour UTC
		NextIn = (today() + 1) * SECONDS_PER_DAY - os.time(),
	}
end

-- Texte dans la langue du joueur
local function T(player: Player, text: string, ...): string
	return services.GameService:T(player, text, ...)
end

local function onClaim(player: Player)
	if not RateLimiter.Check(player, "Daily", 1) then
		return false, T(player, "Slow down!")
	end
	local data = services.DataService:GetData(player)
	if not data or not services.GameService:IsReady(player) then
		return false, T(player, "Loading...")
	end
	if not Formulas.HasFeature(data, "Daily") then
		return false, T(player, "The calendar isn't unlocked yet")
	end
	if data.Daily.LastDay >= today() then
		return false, T(player, "Already claimed today, come back tomorrow!")
	end

	local streak = nextStreak(data)
	local reward = computeReward(services.GameService:GetStats(player), streak)

	data.Daily.LastDay = today()
	data.Daily.Streak = streak
	data.Stats.DailyClaims += 1
	services.GameService:AddDopamine(player, reward, false)
	services.GameService:SendState(player)

	return true, T(player, "Day %d: +%s %s!", streak, NumberFormatter.Format(reward), Config.Game.CurrencyName)
end

function DailyRewardService:Start()
	Net.Function("ClaimDaily").OnServerInvoke = onClaim
end

return DailyRewardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="364">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--[[
	DataService (ModuleScript)
	Emplacement : ServerScriptService > Services > DataService

	Chargement / sauvegarde des données des joueurs avec DataStoreService
	(format "version 2", magasin Config.DataStore.Name) :
	  - pcall + plusieurs tentatives (retry) avec attente croissante ;
	  - sauvegarde à la sortie du joueur, toutes les 60 secondes (au plus),
	    après certaines actions importantes (détox, achat Robux) et à la
	    fermeture du serveur (BindToClose) ;
	  - data.LastOnline (os.time) est mis à jour à chaque sauvegarde : au
	    chargement, l'absence (en secondes) sert au gain hors-ligne
	    (GameService, voir TakeOfflineSeconds) ;
	  - si le chargement échoue, on NE sauvegarde PAS (pour ne jamais écraser
	    une vraie sauvegarde avec des données vides).
]]

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local FriendMailRules = require(ReplicatedStorage.Shared.FriendMailRules)
local Locale = require(ReplicatedStorage.Shared.Locale)

local DataService = {}

-- Profils chargés : [Player] = { Data = table, CanSave = bool, Saving = bool, Releasing = bool,
--   OfflineSeconds = secondes d'absence depuis la dernière sauvegarde (0 = rien à donner) }
local profiles = {}

-- Données d'un nouveau joueur (version 2). Toute nouvelle clé ajoutée ici
-- sera automatiquement ajoutée aux anciennes sauvegardes (voir reconcile).
local TEMPLATE = {
	Version = 2,
	Dopamine = 0,
	Rebirths = 0,
	Upgrades = {}, -- [upgradeId] = niveau
	Achievements = {}, -- [achievementId] = true
	Quests = {}, -- liste des quêtes actives
	Daily = { LastDay = 0, Streak = 0 },
	-- ClickSound = Id de Config.ClickSounds ; Language = "Auto" | "en" | "fr"
	-- ("Auto" = langue de Roblox du joueur) ; DarkMode = mode sombre de l'interface ;
	-- MusicTrack = "Shuffle" (aléatoire) ou Key d'une musique de Config.Music.Playlist
	-- v9.8 🎨 Gfx* = Graphismes / Mode réaliste (Shared/GraphicsQuality : "Auto" = selon
	-- l'appareil et le Mode réaliste ; valeurs validées par SetSetting)
	Settings = { Sound = true, Music = true, Effects = true, ClickSound = "Default", Language = "Auto", DarkMode = false,
		MusicTrack = "Shuffle", GfxRealistic = "Auto", GfxReflections = "Auto", GfxWeather = "Auto", GfxRain = "Auto",
		GfxShadows = "Auto", GfxEffects = "Auto", GfxDetail = "Auto", GfxTime = "Auto" }, -- (v9.9 GfxTime : heure du jour en ville)
	Cosmetics = {
		Owned = {}, -- [cosmeticId] = true
		Equipped = { Hat = "", Skin = "" }, -- "" = rien d'équipé
	},
	Stock = { Shares = 0, CostBasis = 0 }, -- ancienne bourse (remboursée puis vidée)
	Casino = { Tokens = -1, Progress = 0 }, -- 🎰 jetons de tours gratuits (-1 = jamais initialisé)
	Garden = {}, -- 🌻 parterres du jardin (voir GardenService)
	Tickets = 0, -- 🎟️ tickets d'arcade (gagnés en jouant ou achetés en Robux ; boutique à tickets, jamais misés)
	Trophies = 0, -- 🏆 trophées d'arcade (gagnés UNIQUEMENT en jouant, jamais achetables ni convertibles : mises des duels)
	Arcade = {}, -- 🕹️ mini-jeux (records, limites du jour : voir MinigameService)
	Chests = { Stored = 0, Progress = 0 }, -- coffres mystère
	ScreenTime = {}, -- ["numéro du jour UTC"] = secondes jouées ce jour-là
	Themes = {
		Owned = { Classic = true }, -- [themeId] = true (achetés, gardés pour toujours)
		Equipped = "Classic",
	},
	Boost = { Multiplier = 1, EndsAt = 0 }, -- boost acheté (EndsAt = os.time() de fin)
	-- 🏠 Maison (Config.House), gardée pour toujours (même après l'océan).
	-- Items = { [itemId] = nombre possédé } ; Rooms = pièces (voir HouseService :
	-- vide ici, HouseService crée le salon de départ ou convertit l'ancienne
	-- maison à une pièce)
	House = {
		Size = Config.House.Sizes[1].Id,
		OwnedSizes = { [Config.House.Sizes[1].Id] = true },
		OwnedWallpapers = { [Config.House.Wallpapers[1].Id] = true },
		OwnedFloors = { [Config.House.Floors[1].Id] = true },
		Items = {},
		Rooms = {},
		NextRoom = 2,
		-- (v10 HOUSE10) 🏡 extérieur personnalisé (Shared/HouseOptions) :
		-- Ext = { [genre] = Id du choix, Num = numéro de la maison (0 = auto) },
		-- OwnedExt = { ["Genre.Id"] = true } ; vide = le look d'origine du style
		Ext = {},
		OwnedExt = {},
	},
	Purchases = {}, -- PurchaseId (texte) des 50 derniers achats Robux traités (anti-doublon)
	LastOnline = 0, -- os.time() de la dernière sauvegarde / sortie (0 = jamais)
	LiveFollowed = false, -- abonné au live ASMR pendant cette partie (remis à false à la détox)
	-- 💌 Mails entre amis Roblox (FriendMailService) : dernier envoi d'un
	-- nouveau mail / d'une réponse (os.time(), anti-spam gardé d'une partie à
	-- l'autre) et expéditeurs bloqués { ["UserId"] = true }
	FriendMail = { LastNew = 0, LastReply = 0, Blocked = {} },
	-- 🚶 Dopamine Town (WorldService) : ouverture de la maison aux visiteurs
	-- ("Everyone" | "Friends" | "Nobody"), ❤️ reçus, visites, ❤️ donnés aujourd'hui
	Town = { Open = "Everyone", Likes = 0, Visits = 0, LikeDay = 0, Liked = {}, LikesGiven = 0, LikedRewards = 0, RewardDay = 0 },
	-- 🚗 Voitures (v9.6, CarService) : possédées, couleur de chacune (Id de
	-- Config.Cars.Colors), voiture choisie ("" = aucune), 🏎️ garage du manoir
	-- (v10 CARS10) + réglages de performance, pièces de tuning, options débloquées, plaques
	Cars = { Owned = {}, Colors = {}, Selected = "", Garage = false, Tuning = {}, Mods = {}, Unlocked = {}, Plates = {} },
	-- 🍦 (v9.8, FoodService) boost "nourriture" en cours (EndsAt = os.time() de fin)
	Food = { Multiplier = 1, EndsAt = 0, Food = "" },
	-- 🏁 (v10 RACE10) courses de rue : jour, gains du jour, courses, victoires, podiums, meilleurs tours
	Race = { Day = 0, Rewarded = 0, Races = 0, Wins = 0, Podiums = 0, Best = {} },
	Stats = {
		TotalClicks = 0,
		LifetimeDopamine = 0, -- Dopamine gagnée depuis toujours (classement)
		UpgradesBought = 0,
		CombosMaxed = 0,
		DVDClicks = 0,
		DVDCorners = 0,
		Bounces = 0,
		GoldenClicks = 0,
		LightningClicks = 0,
		NotifsOpened = 0,
		EmailsRead = 0,
		BubblesPopped = 0,
		Spins = 0,
		HeadlinesClicked = 0,
		PressCrushes = 0,
		SlotSpins = 0,
		SlotWins = 0,
		StockTrades = 0,
		GardenHarvests = 0,
		MinigamesPlayed = 0,
		MinigamesWon = 0,
		DuelsWon = 0,
		ChestsOpened = 0,
		CosmeticsBought = 0,
		QuestsCompleted = 0,
		DailyClaims = 0,
		PlaySeconds = 0,
		RobuxPurchases = 0,
		ThemesBought = 0,
		Donations = 0, -- dons du live cliqués
		Follows = 0, -- abonnements au live
		ButterCrunches = 0, -- croquées de beurre
		OfflineEarned = 0, -- Dopamine gagnée hors-ligne
		HouseItemsBought = 0, -- objets de maison achetés
		HouseComfort = 0, -- meilleur confort de maison atteint
	},
}

local services -- rempli par Init

local dataStore: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStore.Name)
	end)
	if ok then
		dataStore = result
	else
		warn("[DataService] DataStore indisponible (place non publiée ?) :", result)
	end
end

----------------------------------------------------------------------
-- Utilitaires
----------------------------------------------------------------------

local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for key, inner in pairs(value) do
		copy[key] = deepCopy(inner)
	end
	return copy
end

-- Ajoute les clés manquantes (nouvelle version du jeu) sans toucher aux
-- existantes. Une valeur du mauvais type (sauvegarde corrompue) est remplacée.
local function reconcile(data, template)
	for key, value in pairs(template) do
		local current = data[key]
		if current == nil or type(current) ~= type(value) or (type(value) == "number" and current ~= current) then
			data[key] = deepCopy(value)
		elseif type(value) == "table" and next(value) ~= nil then
			reconcile(current, value)
		end
	end
	return data
end

-- Erreurs pour lesquelles réessayer ne sert à rien (ex. Studio sans accès aux API)
local function isFatalError(message: string): boolean
	return string.find(message, "StudioAccessToApisNotAllowed", 1, true) ~= nil
		or string.find(message, "publish", 1, true) ~= nil
		or string.find(message, "403", 1, true) ~= nil
end

-- Exécute `callback` avec pcall et réessaie en cas d'échec
local function retry(description: string, callback: () -> any): (boolean, any)
	local lastError
	for attempt = 1, Config.DataStore.MaxRetries do
		local ok, result = pcall(callback)
		if ok then
			return true, result
		end
		lastError = result
		warn(string.format("[DataService] %s : échec (tentative %d) : %s", description, attempt, tostring(result)))
		if isFatalError(tostring(result)) then
			warn("[DataService] Active 'Enable Studio Access to API Services' (Game Settings > Security) et publie le jeu.")
			break
		end
		if attempt < Config.DataStore.MaxRetries then
			task.wait(2 ^ attempt) -- 2s, 4s, 8s...
		end
	end
	return false, lastError
end

-- Plafond de l'absence prise en compte (sécurité contre une date abîmée) : 1 an
local MAX_OFFLINE_SECONDS = 365 * 86400
-- Sauvegarde automatique : au plus toutes les 60 secondes
local AUTOSAVE_INTERVAL = math.min(Config.DataStore.AutoSaveInterval, 60)

local function isValidNumber(value): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

-- Secondes écoulées depuis `lastOnline` (0 si jamais connecté ou date invalide)
local function offlineSecondsSince(lastOnline): number
	if not isValidNumber(lastOnline) or lastOnline <= 0 then
		return 0
	end
	return math.clamp(os.time() - lastOnline, 0, MAX_OFFLINE_SECONDS)
end

local function keyFor(player: Player): string
	return "Player_" .. player.UserId
end

----------------------------------------------------------------------
-- API
----------------------------------------------------------------------

function DataService:Init(allServices)
	services = allServices
end

-- Charge les données d'un joueur (bloquant). Renvoie la table de données.
function DataService:LoadAsync(player: Player)
	local canSave = dataStore ~= nil
	local data

	if dataStore then
		local store = dataStore :: DataStore
		local ok, result = retry("Chargement de " .. player.Name, function()
			return store:GetAsync(keyFor(player))
		end)
		if ok then
			data = (type(result) == "table") and result or nil
		else
			-- Échec total : on joue avec des données vides mais sans sauvegarder
			canSave = false
		end
	end

	data = reconcile(data or deepCopy(TEMPLATE), TEMPLATE)
	data.Version = TEMPLATE.Version
	-- 🏆 Trophées : entier >= 0 (sauvegarde abîmée corrigée)
	if not isValidNumber(data.Trophies) or data.Trophies < 0 then
		data.Trophies = 0
	end
	data.Trophies = math.floor(data.Trophies)
	-- 💌 Mails entre amis : horodatages valides (jamais dans le futur), blocages propres
	data.FriendMail = FriendMailRules.SanitizeData(data.FriendMail, os.time())

	-- Absence depuis la dernière sauvegarde (gain hors-ligne donné par
	-- GameService quand le client est prêt), puis on repart de maintenant
	local offlineSeconds = offlineSecondsSince(data.LastOnline)
	data.LastOnline = os.time()

	-- Le joueur a pu partir pendant le chargement
	if not player.Parent then
		return nil
	end

	profiles[player] = {
		Data = data,
		CanSave = canSave,
		Saving = false,
		Releasing = false,
		OfflineSeconds = offlineSeconds,
	}

	if not canSave then
		local language = Locale.ForPlayer(player, data.Settings.Language)
		task.defer(function()
			services.GameService:Notify(player, {
				Type = "Error",
				Text = Locale.TFor(language, "⚠️ Saving is unavailable: your progress won't be saved."),
			})
		end)
	end

	return data
end

function DataService:GetData(player: Player)
	local profile = profiles[player]
	return profile and profile.Data
end

-- Renvoie (une seule fois) les secondes d'absence calculées au chargement
function DataService:TakeOfflineSeconds(player: Player): number
	local profile = profiles[player]
	if not profile then
		return 0
	end
	local seconds = profile.OfflineSeconds or 0
	profile.OfflineSeconds = 0
	return seconds
end

function DataService:GetLoadedPlayers(): { Player }
	local list = {}
	for player in pairs(profiles) do
		table.insert(list, player)
	end
	return list
end

-- Remet les données d'un joueur à zéro (commande de test /reset), SAUF les
-- réglages et la liste des achats Robux traités (anti-doublon). La table est vidée "sur place" : les autres services qui ont
-- gardé une référence vers elle restent valides.
function DataService:ResetData(player: Player): boolean
	local profile = profiles[player]
	if not profile then
		return false
	end
	local data = profile.Data
	local settings = deepCopy(data.Settings)
	local purchases = deepCopy(data.Purchases)
	for key in pairs(data) do
		data[key] = nil
	end
	for key, value in pairs(TEMPLATE) do
		data[key] = deepCopy(value)
	end
	if type(settings) == "table" then
		data.Settings = reconcile(settings, TEMPLATE.Settings)
	end
	if type(purchases) == "table" then
		data.Purchases = purchases
	end
	data.LastOnline = os.time()
	profile.OfflineSeconds = 0
	return true
end

-- true si les données de ce joueur peuvent être sauvegardées
-- (DataStore disponible et chargement réussi)
function DataService:CanSave(player: Player): boolean
	local profile = profiles[player]
	return profile ~= nil and profile.CanSave and dataStore ~= nil
end

-- Sauvegarde les données d'un joueur (bloquant).
-- `waitIfBusy` = true : si une sauvegarde est déjà en cours, on attend qu'elle
-- finisse puis on sauvegarde à nouveau (utilisé après un achat Robux : la
-- sauvegarde en cours ne contient peut-être pas l'achat).
function DataService:SaveAsync(player: Player, waitIfBusy: boolean?): boolean
	local profile = profiles[player]
	if not profile or not profile.CanSave or not dataStore then
		return false
	end
	if profile.Saving and waitIfBusy then
		local waited = 0
		while profile.Saving and waited < 30 do
			waited += task.wait(0.1)
		end
	end
	if profile.Saving then
		return false -- une sauvegarde est déjà en cours
	end

	profile.Saving = true
	local data = profile.Data
	data.LastOnline = os.time() -- dernière présence connue (gain hors-ligne)
	local store = dataStore :: DataStore
	local ok = retry("Sauvegarde de " .. player.Name, function()
		store:UpdateAsync(keyFor(player), function()
			return data
		end)
	end)
	profile.Saving = false
	return ok
end

-- Sauvegarde puis oublie le joueur (à la sortie)
function DataService:ReleaseAsync(player: Player)
	local profile = profiles[player]
	if not profile then
		return
	end
	-- Déjà en cours de libération (PlayerRemoving puis BindToClose) : rien à refaire
	if profile.Releasing then
		return
	end
	profile.Releasing = true
	-- Si une sauvegarde automatique est en cours, on attend qu'elle finisse
	local waited = 0
	while profile.Saving and waited < 10 do
		waited += task.wait(0.1)
	end
	-- v9.3 : sauvegarde de sortie même si une sauvegarde lente est encore en
	-- cours (sinon les derniers changements étaient perdus)
	self:SaveAsync(player, true)
	profiles[player] = nil
end

function DataService:Start()
	-- Sauvegarde périodique
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for player in pairs(profiles) do
				task.spawn(function()
					self:SaveAsync(player)
				end)
			end
		end
	end)

	-- Fermeture du serveur : on sauvegarde tout le monde en parallèle
	game:BindToClose(function()
		-- On libère TOUS les profils chargés, y compris ceux des joueurs déjà
		-- sortis de la liste Players (leur sauvegarde de sortie peut être en cours)
		for player, profile in pairs(profiles) do
			if not profile.Releasing then
				task.spawn(function()
					self:ReleaseAsync(player)
				end)
			end
		end
		-- On attend aussi les sauvegardes lancées par PlayerRemoving :
		-- ReleaseAsync retire le profil de la table quand il a fini
		local start = os.clock()
		while next(profiles) ~= nil and os.clock() - start < 25 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="365">
        <Properties>
          <string name="Name">DebugService</string>
          <string name="Source"><![CDATA[--[[
	DebugService (ModuleScript)
	Emplacement : ServerScriptService > Services > DebugService

	Commandes de TEST, actives UNIQUEMENT dans Roblox Studio (jamais dans le
	jeu publié). Trois façons de les lancer, qui passent toutes par le MÊME
	exécuteur (runCommand) :
	  - le chat (TextChatCommand côté serveur + Player.Chatted pour l'ancien chat) ;
	  - la RemoteFunction DebugCommand (commande, argument) -> (succès, message),
	    utilisée par le panneau "🛠️ Test" et les commandes de chat du client.
	    Hors Studio, elle répond toujours (false, message) sans rien faire.
	Commandes :
	  /give 1e6         -> donne de la Dopamine (ici 1 million)
	  /rush             -> lance un Dopamine Rush
	  /daily            -> rend la récompense quotidienne à nouveau disponible
	  /save             -> force une sauvegarde
	  /corner           -> le 1er logo DVD touchera un coin dans ~2 secondes
	  /unlockall        -> toutes les améliorations au max (sauf l'océan)
	  /spawn golden     -> fait apparaître un objet (golden, lightning, notif, email, donation)
	  /golden           -> raccourci de /spawn golden
	  /detox            -> va à l'océan gratuitement
	  /chest 3          -> ajoute des coffres mystère
	  /reset            -> remet toutes les données à zéro (sauf les réglages)
	  /pass vip         -> active / désactive un Game Pass pour tester (x10, x2, autoclick, vip)
	  /boost 5 60       -> boost x5 pendant 60 secondes
	  /theme kawaii     -> donne et équipe un thème
	  /offline 7200     -> simule un retour après 7200 s d'absence (gain hors-ligne)
	  /lang fr          -> langue du jeu : auto, en ou fr (appliquée au prochain lancement)
	  /house            -> 🏠 toutes les tailles, papiers peints, sols et 1 exemplaire de chaque objet
	  /help             -> liste des commandes
	Les messages sont écrits en anglais puis traduits dans la langue du
	joueur (Locale.TFor, traductions dans Shared > Lang > FR_Server).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")

local Config = require(ReplicatedStorage.Shared.Config)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Net = require(ReplicatedStorage.Shared.Net)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)

local DebugService = {}

local services

local IS_STUDIO = RunService:IsStudio()
local MAX_OFFLINE_SECONDS = 30 * 86400 -- /offline : 30 jours au maximum
-- Même commande reçue par deux chemins différents (chat serveur + RF du
-- client) en moins de DUPLICATE_WINDOW secondes : exécutée une seule fois
local DUPLICATE_WINDOW = 1

-- "golden" -> "Golden" (le chat est mis en minuscules)
local spawnKinds = {}
for kind in pairs(Config.Spawners) do
	spawnKinds[string.lower(kind)] = kind
end

-- "vip" -> "VIP", "kawaii" -> "Kawaii" (le chat est mis en minuscules)
local passIds = {}
for _, pass in ipairs(Config.Monetization.GamePasses) do
	passIds[string.lower(pass.Id)] = pass.Id
end
local themeIds = {}
for _, theme in ipairs(Config.Themes) do
	themeIds[string.lower(theme.Id)] = theme.Id
end

local function listIds(map): string
	local list = {}
	for lower in pairs(map) do
		table.insert(list, lower)
	end
	table.sort(list)
	return table.concat(list, ", ")
end

-- Noms des commandes (déclarées comme TextChatCommand dans Studio)
local COMMAND_NAMES = {
	"give", "rush", "daily", "save", "corner", "unlockall", "spawn", "golden", "detox", "chest", "reset",
	"pass", "boost", "theme", "offline", "lang", "house", "help", "aide",
}

-- Aide : "%s" = types d'objets de /spawn
local HELP = "/give /rush /daily /save /corner /unlockall /spawn <%s> /detox /chest /reset"
	.. " /pass <id> /boost <mult> <seconds> /theme <id> /offline <seconds> /lang <auto|en|fr>"

-- /lang : argument (minuscules) -> valeur de Settings.Language
local LANGUAGE_ARGS = { auto = "Auto", en = "en", fr = "fr" }

function DebugService:Init(allServices)
	services = allServices
end

-- Texte dans la langue du joueur
local function T(player: Player, text: string, ...): string
	return services.GameService:T(player, text, ...)
end

local function helpText(player: Player): string
	return T(player, HELP, listIds(spawnKinds))
end

local function info(player: Player, text: string)
	services.GameService:Notify(player, { Type = "Info", Text = "🛠️ " .. text })
end

----------------------------------------------------------------------
-- Exécuteur commun : renvoie (succès, message)
----------------------------------------------------------------------

local function runCommand(player: Player, command: string, argument: string, second: string): (boolean, string)
	local gameService = services.GameService
	local data = services.DataService:GetData(player)
	if not data or not gameService:IsReady(player) then
		return false, T(player, "Loading...")
	end

	if command == "give" then
		local amount = tonumber(argument) or 1e6
		if amount ~= amount or amount <= 0 or amount == math.huge then
			return false, T(player, "Invalid amount")
		end
		gameService:AddDopamine(player, amount, false)
		return true, "+" .. NumberFormatter.Format(amount) .. " " .. Config.Game.CurrencyName
	elseif command == "rush" then
		if services.EventService:StartRush() then
			return true, T(player, "Dopamine Rush started!")
		end
		return false, T(player, "A Rush is already running")
	elseif command == "daily" then
		data.Daily.LastDay = 0
		gameService:MarkDirty(player)
		return true, T(player, "Daily gift available")
	elseif command == "save" then
		local ok = services.DataService:SaveAsync(player, true)
		return ok, ok and T(player, "💾 Saved!") or T(player, "💾 Couldn't save (see the Output)")
	elseif command == "corner" then
		if services.DVDService:DebugCorner(player) then
			return true, T(player, "Corner in ~2 seconds...")
		end
		return false, T(player, "You need at least one DVD logo")
	elseif command == "unlockall" then
		for _, upgrade in ipairs(Config.Upgrades) do
			if upgrade.Effect ~= "Detox" then
				local level = data.Upgrades[upgrade.Id] or 0
				data.Upgrades[upgrade.Id] = upgrade.MaxLevel or math.max(level, 1)
			end
		end
		services.QuestService:Regenerate(player)
		gameService:RefreshAfterUpgradeChange(player)
		return true, T(player, "Everything unlocked!")
	elseif command == "spawn" or command == "golden" then
		local kind = (command == "golden") and "Golden" or spawnKinds[argument]
		if not kind then
			return false, T(player, "Unknown type: %s", listIds(spawnKinds))
		end
		if not services.EventService:Spawn(player, kind) then
			return false, T(player, "Too many %s objects on screen", kind)
		end
		return true, T(player, "%s object sent", kind)
	elseif command == "detox" then
		gameService:Detox(player)
		return true, T(player, "🌊 Free detox")
	elseif command == "chest" then
		local count = math.floor(tonumber(argument) or 1)
		if count ~= count or count < 1 or count == math.huge then
			count = 1
		end
		services.LootService:AddChests(player, count)
		return true, T(player, "Chests added")
	elseif command == "reset" then
		services.DataService:ResetData(player)
		gameService:ResetCombo(player)
		services.EventService:ClearSpawns(player)
		services.DVDService:Reset(player)
		services.QuestService:PlayerReady(player, data)
		gameService:SendFullSync(player)
		return true, T(player, "Data reset")
	elseif command == "pass" then
		local passId = passIds[argument]
		if not passId then
			return false, T(player, "Unknown pass: %s", listIds(passIds))
		end
		local owned = services.MonetizationService:DebugTogglePass(player, passId)
		if owned == nil then
			return false, T(player, "Couldn't toggle this pass")
		end
		gameService:SendState(player)
		return true, owned and T(player, "Pass %s enabled", passId) or T(player, "Pass %s disabled", passId)
	elseif command == "boost" then
		local multiplier = tonumber(argument) or 2
		local seconds = tonumber(second) or 60
		if multiplier ~= multiplier or multiplier < 1 or multiplier > 1000
			or seconds ~= seconds or seconds < 0 or seconds > 7 * 86400 then
			return false, T(player, "Usage: /boost <mult 1-1000> <seconds>")
		end
		data.Boost = { Multiplier = multiplier, EndsAt = os.time() + math.floor(seconds) }
		gameService:SendState(player)
		return true, T(player, "Boost x%s for %d s", tostring(multiplier), math.floor(seconds))
	elseif command == "theme" then
		local themeId = themeIds[argument]
		if not themeId or not services.ThemeService:DebugGrant(player, themeId) then
			return false, T(player, "Unknown theme: %s", listIds(themeIds))
		end
		gameService:SendState(player)
		return true, T(player, "Theme %s given and equipped", themeId)
	elseif command == "offline" then
		local seconds = tonumber(argument) or 7200
		if seconds ~= seconds or seconds <= 0 or seconds > MAX_OFFLINE_SECONDS then
			return false, T(player, "Usage: /offline <seconds 1-%s>", tostring(MAX_OFFLINE_SECONDS))
		end
		local amount = gameService:GrantOffline(player, math.floor(seconds), true)
		if amount <= 0 then
			return false, T(player, "Nothing earned (no production or away < %s s)", tostring(Config.Offline.MinSeconds))
		end
		return true, T(player, "Offline simulated: +%s %s", NumberFormatter.Format(amount), Config.Game.CurrencyName)
	elseif command == "lang" then
		local language = LANGUAGE_ARGS[argument]
		if not language then
			return false, T(player, "Usage: /lang <auto|en|fr>")
		end
		data.Settings.Language = language
		gameService:MarkDirty(player)
		-- Message dans la NOUVELLE langue (celle du prochain lancement)
		return true, Locale.TFor(Locale.ForPlayer(player, language),
			"🌐 Language: %s (takes effect after rejoining)", language)
	elseif command == "house" then
		if not services.HouseService:DebugGrantAll(player) then
			return false, T(player, "Loading...")
		end
		return true, T(player, "🏠 Everything in the house shop unlocked!")
	elseif command == "help" or command == "aide" then
		return true, helpText(player)
	end
	return false, T(player, "Unknown command. %s", helpText(player))
end

----------------------------------------------------------------------
-- Entrée commune (chat et RemoteFunction)
----------------------------------------------------------------------

-- Dernière commande exécutée par joueur (anti-doublon entre les chemins)
local lastRun: { [Player]: { Line: string, Clock: number, Source: string } } = {}

-- Découpe "/give 1e6" ou "boost 5 60" en (commande, argument, second)
local function parse(line: string): (string?, string, string)
	local command, argument, second = string.match(string.lower(line), "^%s*/?(%a+)%s*(%S*)%s*(%S*)")
	return command, argument or "", second or ""
end

-- `source` = "chat" ou "remote". Doublon ignoré si la même ligne arrive dans
-- la seconde par un autre chemin (ou deux fois par le chat) ; deux clics
-- rapides sur le même bouton du panneau de test restent exécutés.
-- 3e valeur renvoyée : true si c'était un doublon (rien n'a été exécuté).
local function execute(player: Player, line: string, source: string): (boolean, string, boolean)
	local command, argument, second = parse(line)
	if not command then
		return false, T(player, "Invalid command"), false
	end
	local normalized = command .. " " .. argument .. " " .. second
	local clock = os.clock()
	local last = lastRun[player]
	if last and last.Line == normalized and clock - last.Clock < DUPLICATE_WINDOW
		and (last.Source ~= source or source == "chat") then
		return true, T(player, "(already run)"), true
	end
	lastRun[player] = { Line = normalized, Clock = clock, Source = source }

	local ok, success, message = pcall(runCommand, player, command, argument, second)
	if not ok then
		warn("[DebugService] Erreur de la commande /" .. command .. " :", success)
		return false, T(player, "Error: %s", tostring(success)), false
	end
	return success, message, false
end

-- Message de chat : exécuté s'il ressemble à une commande "/xxx", résultat en notification
local function handleChat(player: Player, message: string)
	if not string.match(message, "^%s*/%a") then
		return
	end
	local ok, text, duplicate = execute(player, message, "chat")
	if not duplicate then
		info(player, (ok and "" or "❌ ") .. text)
	end
end

-- RemoteFunction DebugCommand (command: string, arg: string?) -> (ok, message)
local function onDebugCommand(player: Player, command: any, argument: any): (boolean, string)
	if not IS_STUDIO then
		return false, T(player, "Test commands are only available in Studio")
	end
	if type(command) ~= "string" or #command == 0 or #command > 64 then
		return false, T(player, "Invalid command")
	end
	if argument ~= nil and (type(argument) ~= "string" or #argument > 64) then
		return false, T(player, "Invalid argument")
	end
	local ok, message = execute(player, command .. " " .. (argument or ""), "remote")
	return ok, message
end

----------------------------------------------------------------------
-- Cycle de vie
----------------------------------------------------------------------

function DebugService:Start()
	-- Toujours branchée (sinon l'appel du client resterait bloqué), mais ne
	-- fait rien hors de Studio
	Net.Function("DebugCommand").OnServerInvoke = onDebugCommand

	if not IS_STUDIO then
		return
	end
	-- Avec le nouveau chat (TextChatService), un message "/xxx" inconnu peut ne
	-- jamais arriver à Player.Chatted : on déclare donc de vraies commandes.
	local ok, err = pcall(function()
		local folder = Instance.new("Folder")
		folder.Name = "DopamineDebugCommands"
		for _, name in ipairs(COMMAND_NAMES) do
			local command = Instance.new("TextChatCommand")
			command.Name = "Debug_" .. name
			command.PrimaryAlias = "/" .. name
			command.Triggered:Connect(function(textSource: TextSource, text: string)
				local player = Players:GetPlayerByUserId(textSource.UserId)
				if player and services.DataService:GetData(player) then
					handleChat(player, text)
				end
			end)
			command.Parent = folder
		end
		folder.Parent = TextChatService
	end)
	if not ok then
		warn("[DebugService] Impossible de déclarer les commandes de chat :", err)
	end
end

function DebugService:PlayerReady(player: Player)
	if not IS_STUDIO then
		return
	end
	-- Ancien chat (LegacyChatService) : Player.Chatted suffit
	player.Chatted:Connect(function(message: string)
		handleChat(player, message)
	end)
end

function DebugService:PlayerRemoving(player: Player)
	lastRun[player] = nil
end

return DebugService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="366">
        <Properties>
          <string name="Name">EventService</string>
          <string name="Source"><![CDATA[--[[
	EventService (ModuleScript)
	Emplacement : ServerScriptService > Services > EventService

	Événements aléatoires :
	  - "Dopamine Rush" : x2 sur tous les gains pendant 30 s, pour TOUT le serveur ;
	  - objets à cliquer vite (Config.Spawners) : étoile dorée, éclair,
	    notification de téléphone, e-mail, don du live. Chaque type apparaît
	    chez un joueur seulement s'il possède la Feature correspondante
	    (et, si RequiresFollow, seulement s'il est abonné au live :
	    data.LiveFollowed).
	Le serveur décide quand ils arrivent et valide les clics.
]]

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Net = require(ReplicatedStorage.Shared.Net)

local EventService = {}

local services
local random = Random.new()

-- Dans Studio, les événements arrivent plus vite pour pouvoir les tester
local speedup = RunService:IsStudio() and Config.Events.StudioSpeedup or 1

local SPAWN_GRACE = 0.5 -- marge (s) pour la latence réseau
local SCHEDULER_STEP = 0.25 -- intervalle (s) de la boucle des apparitions

local rush = {
	Active = false,
	EndsAt = 0, -- heure serveur (workspace:GetServerTimeNow())
	Token = 0, -- change à chaque (re)programmation de la fin du Rush
}

--[[
	Apparitions par joueur :
	[Player] = {
		Pending = { [id] = { Kind, ExpiresAt } }, -- objets affichés, pas encore cliqués
		NextAt = { [kind] = os.clock() de la prochaine apparition (nil = Feature absente) },
	}
]]
local spawnStates = {}

function EventService:Init(allServices)
	services = allServices
end

----------------------------------------------------------------------
-- Dopamine Rush (global)
----------------------------------------------------------------------

function EventService:GetMultiplier(): number
	return rush.Active and Config.Events.Rush.Multiplier or 1
end

local function rushPayload()
	return {
		Active = rush.Active,
		EndsAt = rush.EndsAt,
		Name = Config.Events.Rush.Name,
		Multiplier = Config.Events.Rush.Multiplier,
	}
end

function EventService:SendState(player: Player)
	Net.Event("EventUpdate"):FireClient(player, rushPayload())
end

-- Programme la fin du Rush en cours (un jeton évite qu'une ancienne fin
-- programmée coupe un Rush prolongé entre-temps)
local function scheduleRushEnd()
	rush.Token += 1
	local token = rush.Token
	local remaining = math.max(0, rush.EndsAt - workspace:GetServerTimeNow())
	task.delay(remaining, function()
		if rush.Token ~= token or not rush.Active then
			return
		end
		rush.Active = false
		Net.Event("EventUpdate"):FireAllClients(rushPayload())
		services.GameService:MarkAllDirty()
	end)
end

-- Lance un Dopamine Rush (aussi utilisé par la commande de test /rush).
-- `extend` = true (Rush acheté avec des Robux) : si un Rush est déjà en
-- cours, il est prolongé de sa durée au lieu d'être ignoré.
-- Renvoie true si un Rush a été lancé ou prolongé.
function EventService:StartRush(extend: boolean?): boolean
	local settings = Config.Events.Rush
	if rush.Active then
		if not extend then
			return false
		end
		rush.EndsAt += settings.Duration
		scheduleRushEnd()
		Net.Event("EventUpdate"):FireAllClients(rushPayload())
		services.GameService:MarkAllDirty()
		services.GameService:NotifyAll(function(lang)
			return {
				Type = "Rush",
				Text = Locale.TFor(lang, "⚡ %s extended by %s s!", Locale.TFor(lang, settings.Name), tostring(settings.Duration)),
			}
		end)
		return true
	end
	rush.Active = true
	rush.EndsAt = workspace:GetServerTimeNow() + settings.Duration
	scheduleRushEnd()
	Net.Event("EventUpdate"):FireAllClients(rushPayload())
	services.GameService:MarkAllDirty()
	services.GameService:NotifyAll(function(lang)
		return {
			Type = "Rush",
			Text = Locale.TFor(lang, "⚡ %s: x%s for %s s!", Locale.TFor(lang, settings.Name),
				tostring(settings.Multiplier), tostring(settings.Duration)),
		}
	end)
	return true
end

----------------------------------------------------------------------
-- Objets à cliquer (Config.Spawners)
----------------------------------------------------------------------

-- Retire les objets expirés et renvoie le nombre d'objets encore en attente pour ce type
local function cleanPending(state, kind: string): number
	local clock = os.clock()
	local count = 0
	for id, spawn in pairs(state.Pending) do
		if clock > spawn.ExpiresAt + SPAWN_GRACE then
			state.Pending[id] = nil
		elseif spawn.Kind == kind then
			count += 1
		end
	end
	return count
end

-- Fait apparaître un objet chez un joueur (ignore la Feature : utilisé aussi par /spawn).
-- Renvoie false si trop d'objets de ce type sont déjà affichés.
function EventService:Spawn(player: Player, kind: string): boolean
	local state = spawnStates[player]
	local settings = Config.Spawners[kind]
	if not state or not settings then
		return false
	end
	if cleanPending(state, kind) >= Config.MaxPendingSpawnsPerKind then
		return false
	end

	local id = HttpService:GenerateGUID(false)
	state.Pending[id] = {
		Kind = kind,
		ExpiresAt = os.clock() + settings.Lifetime,
	}
	Net.Event("Spawn"):FireClient(player, {
		Kind = kind,
		Id = id,
		X = random:NextNumber(0.08, 0.72),
		Y = random:NextNumber(0.15, 0.85),
		Lifetime = settings.Lifetime,
		Variant = random:NextInteger(1, 1000),
	})
	return true
end

-- Ancien nom (v1), gardé pour compatibilité
function EventService:SpawnGolden(player: Player)
	return self:Spawn(player, "Golden")
end

-- Oublie tous les objets en attente (détox, reset)
function EventService:ClearSpawns(player: Player)
	local state = spawnStates[player]
	if state then
		state.Pending = {}
		state.NextAt = {}
	end
end

local function randomDelay(settings): number
	return random:NextNumber(settings.MinInterval, settings.MaxInterval) / speedup
end

-- Le joueur remplit-il les conditions de ce type d'objet ?
local function isSpawnerUnlocked(data, settings): boolean
	if not Formulas.HasFeature(data, settings.Feature) then
		return false
	end
	if settings.RequiresFollow and data.LiveFollowed ~= true then
		return false -- dons du live : seulement après "Suivre"
	end
	return true
end

-- Boucle unique qui planifie les apparitions de chaque type pour chaque joueur
-- (équivaut à une boucle par joueur et par type, sans créer de threads)
local function schedulerStep()
	local clock = os.clock()
	for player, state in pairs(spawnStates) do
		local data = services.DataService:GetData(player)
		if data and services.GameService:IsReady(player) then
			for kind, settings in pairs(Config.Spawners) do
				if not isSpawnerUnlocked(data, settings) then
					state.NextAt[kind] = nil -- pas débloqué : rien ne se prépare
				elseif state.NextAt[kind] == nil then
					-- Tout juste débloqué (ou arrivée du joueur) : le premier arrive plus vite
					state.NextAt[kind] = clock + randomDelay(settings) * 0.5
				elseif clock >= state.NextAt[kind] then
					state.NextAt[kind] = clock + randomDelay(settings)
					EventService:Spawn(player, kind)
				end
			end
		end
	end
end

-- Pas de limite de fréquence ici : chaque id est à usage unique (supprimé de
-- Pending dès le premier clic), donc deux clics rapides légitimes passent
local function onSpawnClick(player: Player, id: any)
	local state = spawnStates[player]
	if not state or type(id) ~= "string" or #id > 64 then
		return
	end
	local spawn = state.Pending[id]
	if not spawn then
		return
	end
	state.Pending[id] = nil
	if os.clock() > spawn.ExpiresAt + SPAWN_GRACE then
		return -- trop tard
	end

	local data = services.DataService:GetData(player)
	local settings = Config.Spawners[spawn.Kind]
	if not data or not settings then
		return
	end
	local reward = Formulas.ScaledReward(services.GameService:GetStats(player), settings.RewardSeconds, settings.MinReward)
	if settings.Stat then
		data.Stats[settings.Stat] = (data.Stats[settings.Stat] or 0) + 1
	end
	services.GameService:AddDopamine(player, reward, true)
	services.QuestService:Progress(player, "Spawns", 1)
	services.GameService:Notify(player, {
		Type = "Bonus",
		Source = spawn.Kind,
		Amount = reward,
		SpawnId = id,
	})
end

----------------------------------------------------------------------
-- Cycle de vie
----------------------------------------------------------------------

function EventService:PlayerReady(player: Player)
	spawnStates[player] = { Pending = {}, NextAt = {} }
end

function EventService:PlayerRemoving(player: Player)
	spawnStates[player] = nil
end

function EventService:Start()
	Net.Event("SpawnClick").OnServerEvent:Connect(onSpawnClick)

	-- Boucle des apparitions (par joueur et par type)
	task.spawn(function()
		while true do
			task.wait(SCHEDULER_STEP)
			local ok, err = pcall(schedulerStep)
			if not ok then
				warn("[EventService] Erreur des apparitions :", err)
			end
		end
	end)

	-- Boucle des Dopamine Rush (globaux)
	task.spawn(function()
		local settings = Config.Events.Rush
		while true do
			task.wait(random:NextNumber(settings.MinInterval, settings.MaxInterval) / speedup)
			self:StartRush()
			task.wait(settings.Duration)
		end
	end)
end

return EventService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="367">
        <Properties>
          <string name="Name">FoodService</string>
          <string name="Source"><![CDATA[--[[
	FoodService (ModuleScript)
	Emplacement : ServerScriptService > Services > FoodService

	🍦 Nourriture de Dopamine Town (v9.8, FAIR98) : glaces, barbe à papa,
	churros, popcorn, crêpes, pizza, tacos, milkshakes, hot-dogs, pommes
	d'amour, beignets (Config.Food).
	  - Achat à un STAND (place, fête foraine, coin gourmand) : les stands
	    s'enregistrent (RegisterStall) avec leur pièce et leurs aliments ;
	    le serveur vérifie l'aliment, le stand, la DISTANCE, le prix
	    (FoodRules.Price : secondes de la production du joueur), la limite de
	    fréquence, et qu'on n'a pas déjà quelque chose en main.
	  - L'aliment devient un Tool tenu en main (FoodModels : pièce "Handle"
	    + bouchées "Bite1…") ; chaque clic (Tool.Activated) ou le bouton
	    "🍴 Croquer" (remote "Food" : "bite") = une bouchée : la bouchée
	    disparaît, attributs "BitesLeft" / "BiteAt" (les clients animent le
	    bras et les miettes : FairFx).
	  - La DERNIÈRE bouchée donne le boost (FoodRules.Stack : un seul boost
	    nourriture, cumul converti, plafonds Config.Food). Un aliment pas
	    fini (on quitte la ville / le jeu) donne quand même son boost.
	  - Le boost est appliqué PAR LE SERVEUR dans l'économie :
	    GameService:GetStats multiplie par FoodService:GetMultiplier(player)
	    (clics, production, rebonds…). Pas de boost hors-ligne.
	Données : data.Food = { Multiplier = n, EndsAt = os.time() de fin,
	Food = id du dernier aliment } (créé ici si absent, réparé au chargement).
	État client (GetClientState) : FoodBoost = { Multiplier, Remaining, Food }.
	RemoteFunction "Food" (action, a, b) -> (succès, message, manquant?) :
	  "buy" foodId, stallId | "bite"
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local FoodRules = require(ReplicatedStorage.Shared.FoodRules)
local FoodModels = require(ReplicatedStorage.Shared.FoodModels)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local RateLimiter = require(script.Parent.RateLimiter)

local FoodService = {}

FoodService.TOOL_NAME = "DopamineFood"

local services: any = nil

type Stall = { Part: BasePart, Foods: { [string]: boolean } }
local stalls: { [string]: Stall } = {}

type Holding = { Tool: Tool, Food: any, Done: number, Finished: boolean, LastBite: number }
local holdings: { [Player]: Holding } = {}

local function isValidNumber(v: any): boolean
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

local function T(player: Player, text: string, ...): string
	if services and services.GameService then
		return services.GameService:T(player, text, ...)
	end
	return string.format(text, ...)
end

local function now(): number
	return os.time()
end

----------------------------------------------------------------------
-- Stands
----------------------------------------------------------------------

-- Appelé par TownFair / TownPlaza à la construction de la ville
function FoodService.RegisterStall(id: string, part: BasePart, foods: { string })
	local set = {}
	for _, foodId in ipairs(foods) do
		if Config.FoodById[foodId] then
			set[foodId] = true
		end
	end
	stalls[id] = { Part = part, Foods = set }
end

function FoodService.ClearStalls()
	table.clear(stalls)
end

----------------------------------------------------------------------
-- Boost
----------------------------------------------------------------------

local function sanitize(data)
	local food = data.Food
	if type(food) ~= "table" then
		data.Food = { Multiplier = 1, EndsAt = 0, Food = "" }
		return
	end
	local m = food.Multiplier
	if not isValidNumber(m) or m < 1 or m > Config.Food.MaxMultiplier or not isValidNumber(food.EndsAt)
		or food.EndsAt <= now() or food.EndsAt > now() + Config.Food.MaxSeconds + 5 then
		data.Food = { Multiplier = 1, EndsAt = 0, Food = "" }
	elseif type(food.Food) ~= "string" then
		food.Food = ""
	end
end

-- (multiplicateur, secondes restantes) du boost nourriture ; (1, 0) si aucun
function FoodService:GetBoost(data): (number, number)
	local food = data and data.Food
	if type(food) ~= "table" or not isValidNumber(food.Multiplier) or not isValidNumber(food.EndsAt) then
		return 1, 0
	end
	local remaining = food.EndsAt - now()
	if remaining <= 0 or food.Multiplier <= 1 then
		return 1, 0
	end
	return math.min(food.Multiplier, Config.Food.MaxMultiplier), remaining
end

-- Multiplicateur appliqué à l'économie (GameService:GetStats)
function FoodService:GetMultiplier(player: Player): number
	local data = services and services.DataService:GetData(player)
	if not data then
		return 1
	end
	local m = self:GetBoost(data)
	return m
end

-- Champ d'état envoyé au client (GameService:BuildState)
function FoodService:GetClientState(_player: Player, data)
	local m, remaining = self:GetBoost(data)
	local last = type(data.Food) == "table" and data.Food.Food or ""
	return {
		FoodBoost = { Multiplier = m, Remaining = math.max(0, math.floor(remaining)), Food = if remaining > 0 then last else "" },
	}
end

local expiryToken: { [Player]: number } = {}

local function applyBoost(player: Player, food: any)
	local data = services.DataService:GetData(player)
	if not data then
		return
	end
	sanitize(data)
	local m, remaining = FoodService:GetBoost(data)
	local newM, newRemaining = FoodRules.Stack(m, remaining, food)
	if newM <= 1 or newRemaining <= 0 then
		return
	end
	data.Food = { Multiplier = newM, EndsAt = now() + math.floor(newRemaining + 0.5), Food = food.Id }
	services.GameService:MarkDirty(player)
	-- fin du boost : un état complet (gains / badge) au bon moment
	local token = (expiryToken[player] or 0) + 1
	expiryToken[player] = token
	task.delay(newRemaining + 1, function()
		if expiryToken[player] == token and player.Parent then
			services.GameService:MarkDirty(player)
		end
	end)
end

----------------------------------------------------------------------
-- Aliment en main (Tool)
----------------------------------------------------------------------

local function characterOf(player: Player): (Model?, Humanoid?, BasePart?)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not character or not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
		return nil, nil, nil
	end
	return character, humanoid, root
end

local function finish(player: Player, holding: Holding)
	if holding.Finished then
		return
	end
	holding.Finished = true
	if holdings[player] == holding then
		holdings[player] = nil
	end
	applyBoost(player, holding.Food)
end

local function makeTool(food: any): Tool?
	local model = FoodModels.Build(food.Id, CFrame.new(0, 200, 0))
	if not model then
		return nil
	end
	local handle = model.PrimaryPart
	if not handle then
		model:Destroy()
		return nil
	end
	local tool = Instance.new("Tool")
	tool.Name = FoodService.TOOL_NAME
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.ToolTip = food.Icon .. " " .. food.Name
	-- (v9.9, FAIR99) prise : aucune rotation -> l'aliment reste DEBOUT dans
	-- la pose "outil" (R15 : RightGripAttachment ; R6 : RightGrip C0 =
	-- (0, -1, 0) * Angles(-90°, 0, 0) : son +Y = l'avant du bras = le haut
	-- quand le bras est tendu) ; le repère des modèles est le centre du
	-- poing (FoodModels.GRIP). v9.8 : prise sous le cornet -> l'aliment
	-- flottait au-dessus de la main et penchait avec le poignet.
	tool.Grip = FoodModels.GRIP
	tool:SetAttribute("FoodId", food.Id)
	tool:SetAttribute("BitesLeft", food.Bites)
	tool:SetAttribute("BiteAt", 0)
	for _, p in ipairs(model:GetChildren()) do
		if p:IsA("BasePart") then
			p.Parent = tool
			if p ~= handle then
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = handle
				weld.Part1 = p
				weld.Parent = p
			end
		end
	end
	model:Destroy()
	for _, p in ipairs(tool:GetChildren()) do
		if p:IsA("BasePart") then
			p.Anchored = false
			p.CanCollide = false
			p.CanTouch = false
			p.CanQuery = false
			p.Massless = true
		end
	end
	handle.Name = "Handle"
	return tool
end

local function bite(player: Player): (boolean, string?)
	local holding = holdings[player]
	if not holding or holding.Finished then
		return false, T(player, "You're not holding any food")
	end
	local t = os.clock()
	if t - holding.LastBite < Config.Food.BiteCooldown then
		return false, nil
	end
	holding.LastBite = t
	local tool = holding.Tool
	local character = player.Character
	if not tool.Parent then
		finish(player, holding)
		return true, nil
	end
	-- rangé (sac à dos caché) : on le remet en main
	if character and tool.Parent ~= character then
		tool.Parent = character
	end
	holding.Done += 1
	local food = holding.Food
	local serverTime = workspace:GetServerTimeNow()
	tool:SetAttribute("BitesLeft", math.max(0, food.Bites - holding.Done))
	tool:SetAttribute("BiteAt", serverTime)
	for _, p in ipairs(tool:GetChildren()) do
		if p.Name == "Bite" .. holding.Done then
			p:Destroy()
		end
	end
	if holding.Done >= food.Bites then
		finish(player, holding)
		-- (laisse le temps de voir la dernière bouchée)
		task.delay(0.45, function()
			if tool.Parent then
				tool:Destroy()
			end
		end)
	end
	return true, nil
end

local function give(player: Player, food: any): boolean
	local character, humanoid = characterOf(player)
	if not character or not humanoid then
		return false
	end
	local tool = makeTool(food)
	if not tool then
		return false
	end
	local holding: Holding = { Tool = tool, Food = food, Done = 0, Finished = false, LastBite = os.clock() - Config.Food.BiteCooldown - 0.05 }
	holdings[player] = holding
	tool.Activated:Connect(function()
		pcall(bite, player)
	end)
	-- détruit / parti avant la fin (sortie de la ville, personnage retiré) :
	-- le boost payé est quand même donné
	tool.AncestryChanged:Connect(function(_, parent)
		if parent == nil and not holding.Finished then
			finish(player, holding)
		end
	end)
	tool.Parent = character
	pcall(function()
		humanoid:EquipTool(tool)
	end)
	return true
end

local function buy(player: Player, foodId: any, stallId: any): (boolean, string, number?)
	local data = services.DataService:GetData(player)
	if not data then
		return false, T(player, "Invalid request")
	end
	local food = type(foodId) == "string" and Config.FoodById[foodId] or nil
	local stall = type(stallId) == "string" and stalls[stallId] or nil
	if not food or not stall or not stall.Foods[food.Id] or not stall.Part.Parent then
		return false, T(player, "Invalid request")
	end
	local _, _, root = characterOf(player)
	if not root then
		return false, T(player, "Walk to a food stall in Dopamine Town")
	end
	if (root.Position - stall.Part.Position).Magnitude > Config.Food.BuyDistance then
		return false, T(player, "Walk closer to the stall")
	end
	local holding = holdings[player]
	if holding and not holding.Finished and holding.Tool.Parent then
		return false, T(player, "Finish what you're eating first! 🍴")
	end
	local stats = services.GameService:GetStats(player)
	local currentFood = FoodService:GetBoost(data)
	local price = FoodRules.Price(food, stats.PerSecond, stats.ClickValue, currentFood)
	if not isValidNumber(price) or price < 0 then
		return false, T(player, "Invalid request")
	end
	if not isValidNumber(data.Dopamine) or data.Dopamine < price then
		local missing = math.max(0, price - (isValidNumber(data.Dopamine) and data.Dopamine or 0))
		return false, T(player, "Not enough %s", Config.Game.CurrencyName), missing
	end
	data.Dopamine -= price
	if not give(player, food) then
		data.Dopamine += price
		return false, T(player, "Invalid request")
	end
	services.GameService:MarkDirty(player)
	return true, T(player, "%s %s! Click to take a bite (%s)", food.Icon, T(player, food.Name), NumberFormatter.Format(price))
end

-- Prix actuel (tests / debug)
function FoodService:GetPrice(player: Player, foodId: string): number?
	local data = services.DataService:GetData(player)
	local food = Config.FoodById[foodId]
	if not data or not food then
		return nil
	end
	local stats = services.GameService:GetStats(player)
	return FoodRules.Price(food, stats.PerSecond, stats.ClickValue, (self:GetBoost(data)))
end

function FoodService:IsHolding(player: Player): boolean
	local holding = holdings[player]
	return holding ~= nil and not holding.Finished
end

----------------------------------------------------------------------
-- Cycle de vie
----------------------------------------------------------------------

function FoodService:Init(allServices)
	services = allServices
end

function FoodService:PlayerReady(_player: Player, data)
	sanitize(data)
end

function FoodService:PlayerRemoving(player: Player)
	local holding = holdings[player]
	if holding and not holding.Finished then
		finish(player, holding)
	end
	holdings[player] = nil
	expiryToken[player] = nil
end

function FoodService:Start()
	Net.Function("Food").OnServerInvoke = function(player: Player, action: any, a: any, b: any)
		if not services.DataService:GetData(player) then
			return false, T(player, "Invalid request")
		end
		if action == "buy" then
			if not RateLimiter.Check(player, "FoodBuy", Config.Food.BuyCooldown) then
				return false, T(player, "Slow down a little!")
			end
			local ok, success, message, missing = pcall(buy, player, a, b)
			if not ok then
				warn("[FoodService] achat : " .. tostring(success))
				return false, T(player, "Invalid request")
			end
			return success, message, missing
		elseif action == "bite" then
			local ok, success, message = pcall(bite, player)
			if not ok then
				warn("[FoodService] bouchée : " .. tostring(success))
				return false, nil
			end
			return success, message
		end
		return false, T(player, "Invalid request")
	end
end

return FoodService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="368">
        <Properties>
          <string name="Name">FriendMailService</string>
          <string name="Source"><![CDATA[--[[
	FriendMailService (ModuleScript)
	Emplacement : ServerScriptService > Services > FriendMailService

	Dopamail entre AMIS Roblox (vrais joueurs) : écrire à un ami, qu'il soit
	sur ce serveur, sur un autre serveur du jeu ou hors ligne, et lui répondre.
	Ces mails ne rapportent JAMAIS de Dopamine.

	Règles (toutes vérifiées ICI, jamais confiées au client) :
	  - le destinataire est un ami Roblox du joueur (liste GetFriendsAsync en
	    cache, sinon player:IsFriendsWithAsync) ;
	  - le joueur a le droit de discuter (TextChatService:CanUserChatAsync) et
	    la paire expéditeur -> destinataire aussi
	    (TextChatService:CanUsersDirectChatAsync, sinon CanUsersChatAsync) :
	    réglages de confidentialité, d'âge et contrôle parental respectés.
	    Un "non" net = refusé tout de suite. Réponse inconnue (API qui ne sait
	    pas répondre pour un destinataire absent du serveur) = accepté si
	    l'expéditeur a le droit de discuter ; le contrôle de la paire est
	    REFAIT à la livraison (destinataire présent) : refusé -> mail supprimé ;
	  - anti-spam persistant (data.FriendMail, sauvegardé : se reconnecter ne
	    remet rien à zéro) : 1 nouveau mail / 10 min, 1 réponse à un mail
	    d'ami reçu / 2 min (une seule réponse par mail reçu) ;
	  - longueurs : objet 60, texte 300 caractères (FriendMailRules).

	Filtrage (règle Roblox) :
	  - le texte BRUT n'est gardé que côté serveur (DataStore "FriendMail_v1",
	    une clé par destinataire) et n'est jamais envoyé à personne ;
	  - à la LIVRAISON, sur le serveur du destinataire (il y est donc présent) :
	    TextService:FilterStringAsync(brut, expéditeur, PrivateChat) puis
	    GetChatForUserAsync(destinataire). Pourquoi la variante "chat" : un
	    mail d'ami est un message privé d'un utilisateur à UN autre
	    utilisateur précis ; Roblox demande PrivateChat + GetChatForUserAsync
	    pour ces messages (le filtre s'adapte aux deux comptes : âge,
	    réglages). GetNonChatString* est prévu pour du texte "hors
	    conversation" (noms d'objets, panneaux...), ce qui n'est pas le cas ;
	  - secours (API refusée, expéditeur hors ligne...) : à l'ENVOI, pendant
	    que l'expéditeur est sur son serveur, on calcule aussi
	    GetNonChatStringForBroadcastAsync (la version la plus stricte, valable
	    pour tout le monde), gardée à côté du brut (BS / BB). Si le filtre par
	    destinataire échoue à la livraison, c'est ELLE qui est montrée, jamais
	    le brut. Filtre "pour tout le monde" en échec à l'envoi = envoi refusé.
	    Sans aucune version filtrée = mail NON montré, nouvel essai plus tard ;
	  - la copie "Envoyés" de l'expéditeur passe par le chemin habituel
	    (RemoteFunction "FilterText", purpose "Mail", côté client).

	Livraison :
	  - même serveur : immédiate ;
	  - autre serveur : MessagingService, sujet "FriendMail", petit message
	    { To = UserId, Id = id du mail } ; le serveur du destinataire relit sa
	    boîte (DataStore, sans cache) et livre ;
	  - hors ligne : la boîte (UpdateAsync, ajout, 30 mails max, rien de plus
	    de 30 jours) est lue à la prochaine connexion : mails non lus.
	  + relecture de secours toutes les 3 minutes (message perdu, filtre en
	    panne...). Tout est sous pcall avec nouvelles tentatives, budgets
	    DataStore vérifiés ; dans Studio sans accès aux API, rien ne casse :
	    le client affiche "indisponible dans Studio".

	Remotes :
	  RemoteFunction "FriendMail" (action, argument) -> (ok, résultat | message, état?)
	    "Status" -> état { Enabled, Reason, NewIn, ReplyIn, NewInterval, ReplyInterval }
	    "Friends" -> { Friends = { { Id, Name, Display } }, Status }
	    "Inbox" -> { Mails = { mail filtré }, Loaded, Status }
	    "Send" { To, Subject, Body, ReplyTo? } -> { Id, Where = "Server" | "Away", Status }
	    "Read" id | "Delete" id | "Report" id (cache + bloque l'expéditeur)
	    "Block" userId | "Unblock" userId -> { Blocked = { [userId] = true } }
	  RemoteEvent "FriendMailEvent" S -> C ("New", mail filtré)
	    mail filtré = { Id, From, Name, Display, Subject, Body, Time, Age, Read, Replied, IsReply }
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Rules = require(Shared.FriendMailRules)

local RateLimiter = require(script.Parent.RateLimiter)

local FriendMailService = {}

local STORE_NAME = "FriendMail_v1"
local TOPIC = "FriendMail"
local FRIENDS_TTL = 600 -- liste d'amis gardée 10 min
local FRIENDS_MAX = 250
local PAIR_TTL = 300 -- résultat d'un contrôle "peuvent discuter" gardé 5 min
local FLUSH_DELAY = 10 -- regroupe les changements (lu, supprimé...) avant d'écrire
local POLL_INTERVAL = 180 -- relecture de secours de la boîte
local RETRY_INTERVAL = 60 -- relecture plus tôt si un mail n'a pas pu être livré
local MAX_ATTEMPTS = 3

-- Délais anti-spam des appels (secondes), par action
local CALL_INTERVALS = {
	Status = 0.5,
	Friends = 2,
	Inbox = 1,
	Send = 1.5,
	Read = 0.1,
	Delete = 0.2,
	Report = 0.5,
	Block = 0.5,
	Unblock = 0.5,
}

local services = nil
local store: DataStore? = nil
-- "Unknown" (pas encore essayé) | "Ok" | "Studio" (API coupées dans Studio) | "Down"
local storeState = "Unknown"
local messagingReady = false
local sessions: { [Player]: any } = {}
local inflight = 0 -- écritures en cours (sortie d'un joueur, fermeture du serveur)

----------------------------------------------------------------------
-- Utilitaires
----------------------------------------------------------------------

local function T(player: Player, text: string, ...): string
	local game = services and services.GameService
	if game and game.T then
		return game:T(player, text, ...)
	end
	return string.format(text, ...)
end

local function getData(player: Player): any
	local dataService = services and services.DataService
	return dataService and dataService:GetData(player)
end

-- Données anti-spam / blocages du joueur (créées si absentes)
local function friendState(player: Player): any
	local data = getData(player)
	if not data then
		return nil
	end
	if type(data.FriendMail) ~= "table" then
		data.FriendMail = Rules.SanitizeData(nil, os.time())
	end
	if type(data.FriendMail.Blocked) ~= "table" then
		data.FriendMail.Blocked = {}
	end
	return data.FriendMail
end

-- Erreurs pour lesquelles réessayer ne sert à rien (Studio sans API, place non publiée)
local function isFatal(message: string): boolean
	return string.find(message, "StudioAccessToApisNotAllowed", 1, true) ~= nil
		or string.find(message, "publish", 1, true) ~= nil
		or string.find(message, "403", 1, true) ~= nil
end

local function markFatal()
	storeState = RunService:IsStudio() and "Studio" or "Down"
end

-- pcall + nouvelles tentatives avec attente croissante (1 s, 2 s...)
local function retry(description: string, callback: () -> any): (boolean, any)
	local lastError = nil
	for attempt = 1, MAX_ATTEMPTS do
		local ok, result = pcall(callback)
		if ok then
			return true, result
		end
		lastError = result
		if isFatal(tostring(result)) then
			markFatal()
			break
		end
		warn(string.format("[FriendMailService] %s : échec (tentative %d) : %s", description, attempt, tostring(result)))
		if attempt < MAX_ATTEMPTS then
			task.wait(2 ^ (attempt - 1))
		end
	end
	return false, lastError
end

-- Budget DataStore restant pour ce type de requête (inconnu = on tente)
local function hasBudget(requestType: Enum.DataStoreRequestType): boolean
	local ok, budget = pcall(function()
		return DataStoreService:GetRequestBudgetForRequestType(requestType)
	end)
	if not ok or type(budget) ~= "number" then
		return true
	end
	return budget >= 1
end

local function keyFor(userId: number): string
	return "Inbox_" .. tostring(userId)
end

-- Lecture SANS le cache de 4 s du DataStore (un mail vient d'arriver)
local function freshOptions(): any
	local ok, options = pcall(function()
		local value = Instance.new("DataStoreGetOptions")
		value.UseCache = false
		return value
	end)
	return ok and options or nil
end

local function unavailableReason(): string?
	if storeState == "Studio" or (store == nil and RunService:IsStudio()) then
		return "Studio"
	end
	if store == nil or storeState == "Down" then
		return "Down"
	end
	return nil
end

local function unavailableText(player: Player, reason: string): string
	if reason == "Studio" then
		return T(player, "Friend mail is unavailable in Studio")
	end
	return T(player, "Friend mail is unavailable right now")
end

local function statusFor(player: Player)
	local state = friendState(player)
	local now = os.time()
	local _, newIn = Rules.Check(state, now, false)
	local _, replyIn = Rules.Check(state, now, true)
	local reason = unavailableReason()
	return {
		Enabled = reason == nil,
		Reason = reason,
		NewIn = newIn,
		ReplyIn = replyIn,
		NewInterval = Rules.NewInterval,
		ReplyInterval = Rules.ReplyInterval,
	}
end

local function newSession(): any
	return {
		Inbox = {}, -- enregistrements BRUTS (jamais envoyés)
		Shown = {}, -- [id] = mail filtré déjà livré au client
		Ops = { Delete = {}, Read = {}, Replied = {} }, -- changements à écrire
		Pairs = {}, -- ["de>à"] = { Value, At } (peuvent discuter ?)
		Loaded = false,
		Dirty = false,
		Flushing = false,
		FlushQueued = false,
		RefreshQueued = false,
		Delivering = false,
		DeliverAgain = false,
		Failed = false,
		LastPoll = os.clock(),
		Friends = nil,
		FriendSet = nil,
		FriendsAt = 0,
		FriendsLoading = false,
		Sending = false,
	}
end

-- Changements à appliquer à la boîte stockée (+ expéditeurs bloqués)
local function opsFor(player: Player?, session): any
	local state = player and friendState(player)
	return {
		Delete = session.Ops.Delete,
		Read = session.Ops.Read,
		Replied = session.Ops.Replied,
		-- (joueur parti : copie de ses blocages faite à sa sortie)
		Blocked = (state and state.Blocked) or session.BlockedCopy or {},
	}
end

local function findRecord(session, id: any): any
	if type(id) ~= "string" then
		return nil
	end
	for _, record in ipairs(session.Inbox) do
		if record.Id == id then
			return record
		end
	end
	return nil
end

----------------------------------------------------------------------
-- Contrôles Roblox (amis, droit de discuter, filtre)
----------------------------------------------------------------------

-- Amis du joueur (paginé, en cache 10 min). nil si l'API a échoué.
local function fetchFriends(player: Player, session): { any }?
	if session.Friends and os.clock() - session.FriendsAt < FRIENDS_TTL then
		return session.Friends
	end
	local waited = 0
	while session.FriendsLoading and waited < 15 do
		waited += task.wait(0.2)
	end
	if session.Friends and os.clock() - session.FriendsAt < FRIENDS_TTL then
		return session.Friends
	end
	session.FriendsLoading = true
	local list: { any } = {}
	local ok = false
	for attempt = 1, 2 do
		list = {}
		ok = pcall(function()
			local pages = Players:GetFriendsAsync(player.UserId)
			while true do
				for _, item in ipairs(pages:GetCurrentPage()) do
					local id, name, display = Rules.ReadFriend(item)
					if id and #list < FRIENDS_MAX then
						table.insert(list, { Id = id, Name = name, Display = display })
					end
				end
				if pages.IsFinished or #list >= FRIENDS_MAX then
					break
				end
				pages:AdvanceToNextPageAsync()
			end
		end)
		if ok or attempt == 2 then
			break
		end
		task.wait(1)
	end
	session.FriendsLoading = false
	if not ok then
		return nil
	end
	local set = {}
	for _, friend in ipairs(list) do
		set[friend.Id] = true
	end
	session.Friends = list
	session.FriendSet = set
	session.FriendsAt = os.clock()
	return list
end

local function isFriend(player: Player, session, userId: number): boolean?
	if session.FriendSet and session.FriendSet[userId] and os.clock() - session.FriendsAt < FRIENDS_TTL then
		return true
	end
	local ok, result = pcall(function()
		return player:IsFriendsWithAsync(userId)
	end)
	if ok and type(result) == "boolean" then
		return result
	end
	return nil
end

-- Le joueur a-t-il le droit de discuter (réglages du compte) ? nil = inconnu
local function canUserChat(userId: number): boolean?
	local ok, result = pcall(function()
		return TextChatService:CanUserChatAsync(userId)
	end)
	if ok and type(result) == "boolean" then
		return result
	end
	return nil
end

-- `fromId` peut-il écrire en privé à `toId` ? true / false / nil (inconnu).
-- CanUsersDirectChatAsync est fait pour les messages directs (1 à 1) ;
-- CanUsersChatAsync en secours si l'API précédente n'est pas disponible.
local function canUsersChat(fromId: number, toId: number): boolean?
	local ok, result = pcall(function()
		return TextChatService:CanUsersDirectChatAsync(fromId, { toId })
	end)
	if ok and type(result) == "table" then
		return table.find(result, toId) ~= nil
	end
	local okPair, allowed = pcall(function()
		return TextChatService:CanUsersChatAsync(fromId, toId)
	end)
	if okPair and type(allowed) == "boolean" then
		return allowed
	end
	return nil
end

-- Même contrôle, gardé 5 min dans la session (par sens : "de>à" ; seulement
-- les réponses sûres)
local function pairAllowed(session, fromId: number, toId: number): boolean?
	local key = tostring(fromId) .. ">" .. tostring(toId)
	local cached = session.Pairs[key]
	if cached and os.clock() - cached.At < PAIR_TTL then
		return cached.Value
	end
	local value = canUsersChat(fromId, toId)
	if value ~= nil then
		session.Pairs[key] = { Value = value, At = os.clock() }
	end
	return value
end

-- Texte brut -> version filtrée "pour tout le monde" (la plus stricte),
-- calculée à l'ENVOI (l'expéditeur est là). nil = échec : envoi refusé.
local function filterBroadcast(raw: string, fromId: number): string?
	if raw == "" then
		return ""
	end
	local ok, text = pcall(function()
		local result = TextService:FilterStringAsync(raw, fromId, Enum.TextFilterContext.PrivateChat)
		return result:GetNonChatStringForBroadcastAsync()
	end)
	if ok and type(text) == "string" then
		return text
	end
	return nil
end

-- Texte brut -> texte filtré POUR le destinataire (nil = échec)
local function filterFor(raw: string, fromId: number, toId: number): string?
	if raw == "" then
		return ""
	end
	local ok, text = pcall(function()
		local result = TextService:FilterStringAsync(raw, fromId, Enum.TextFilterContext.PrivateChat)
		return result:GetChatForUserAsync(toId)
	end)
	if ok and type(text) == "string" then
		return text
	end
	return nil
end

----------------------------------------------------------------------
-- Boîte de réception (DataStore) : lecture, écriture, livraison
----------------------------------------------------------------------

local function flushSession(userId: number, session, player: Player?)
	if not session.Dirty or session.Flushing or not store then
		return
	end
	if not hasBudget(Enum.DataStoreRequestType.UpdateAsync) then
		return
	end
	local dataStore = store :: DataStore
	session.Flushing = true
	session.Dirty = false
	local ops = opsFor(player, session)
	local ok = retry("Écriture de la boîte " .. tostring(userId), function()
		dataStore:UpdateAsync(keyFor(userId), function(old)
			return Rules.ApplyOps(old, ops, os.time())
		end)
	end)
	session.Flushing = false
	if not ok then
		session.Dirty = true -- nouvel essai au prochain passage
	end
end

-- Écriture comptée : la fermeture du serveur attend qu'elle finisse
local function trackedFlush(userId: number, session, player: Player?)
	inflight += 1
	pcall(flushSession, userId, session, player)
	inflight -= 1
end

local function markDirty(player: Player, session)
	session.Dirty = true
	if session.FlushQueued then
		return
	end
	session.FlushQueued = true
	task.delay(FLUSH_DELAY, function()
		session.FlushQueued = false
		if sessions[player] == session then
			flushSession(player.UserId, session, player)
		end
	end)
end

local function removeFromSession(session, predicate: (any) -> boolean): number
	local removed = 0
	for index = #session.Inbox, 1, -1 do
		local record = session.Inbox[index]
		if predicate(record) then
			table.remove(session.Inbox, index)
			session.Shown[record.Id] = nil
			removed += 1
		end
	end
	return removed
end

-- Copie envoyée au client : + Age (secondes depuis l'envoi, calculées ici :
-- l'heure du client n'entre pas en jeu)
local function withAge(mail): any
	local copy = table.clone(mail)
	copy.Age = math.max(0, os.time() - mail.Time)
	return copy
end

-- Filtre puis envoie UN mail au client (s'il ne l'a pas déjà)
local function deliver(player: Player, session, record): boolean
	if session.Shown[record.Id] then
		return true
	end
	local state = friendState(player)
	if state and state.Blocked[tostring(record.F)] then
		return true -- expéditeur bloqué : jamais montré
	end
	local allowed = pairAllowed(session, record.F, player.UserId)
	if allowed == false then
		-- Réglages de confidentialité / d'âge : jamais montré, retiré de la boîte
		session.Ops.Delete[record.Id] = true
		removeFromSession(session, function(other)
			return other.Id == record.Id
		end)
		markDirty(player, session)
		return true
	elseif allowed == nil then
		return false
	end
	-- Filtre pour CE destinataire ; en échec, la version "pour tout le
	-- monde" faite à l'envoi (jamais le brut)
	local subject = Rules.ShownText(filterFor(record.S, record.F, player.UserId), record.BS)
	local body = subject ~= nil and Rules.ShownText(filterFor(record.B, record.F, player.UserId), record.BB) or nil
	if subject == nil or body == nil or not player.Parent or sessions[player] ~= session then
		return false -- aucune version filtrée : pas montré, nouvel essai plus tard
	end
	local out = {
		Id = record.Id,
		From = record.F,
		Name = type(record.N) == "string" and record.N or "",
		Display = type(record.D) == "string" and record.D or "",
		Subject = subject,
		Body = body,
		Time = record.T,
		Read = record.Rd == true or session.Ops.Read[record.Id] == true,
		Replied = record.Rp == true or session.Ops.Replied[record.Id] == true,
		IsReply = record.R ~= nil,
	}
	session.Shown[record.Id] = out
	Net.Event("FriendMailEvent"):FireClient(player, "New", withAge(out))
	return true
end

-- Livre tous les mails pas encore montrés (un seul passage à la fois)
local function deliverAll(player: Player)
	local session = sessions[player]
	if not session then
		return
	end
	if session.Delivering then
		session.DeliverAgain = true
		return
	end
	session.Delivering = true
	repeat
		session.DeliverAgain = false
		local failed = false
		local list = table.clone(session.Inbox)
		for _, record in ipairs(list) do
			if sessions[player] ~= session then
				break
			end
			if not deliver(player, session, record) then
				failed = true
			end
		end
		session.Failed = failed
	until not session.DeliverAgain or sessions[player] ~= session
	session.Delivering = false
end

-- (Re)lit la boîte du joueur ; `fresh` = sans cache (un mail vient d'arriver)
local function loadInbox(player: Player, fresh: boolean): boolean
	local session = sessions[player]
	if not session or not store or unavailableReason() == "Studio" then
		return false
	end
	if not hasBudget(Enum.DataStoreRequestType.GetAsync) then
		return false
	end
	local dataStore = store :: DataStore
	session.LastPoll = os.clock()
	local options = fresh and freshOptions() or nil
	local ok, value = retry("Lecture de la boîte de " .. player.Name, function()
		if options then
			return dataStore:GetAsync(keyFor(player.UserId), options)
		end
		return dataStore:GetAsync(keyFor(player.UserId))
	end)
	if not ok then
		return false
	end
	if storeState == "Unknown" then
		storeState = "Ok"
	end
	if sessions[player] ~= session then
		return false
	end
	session.Inbox = Rules.ApplyOps(value, opsFor(player, session), os.time())
	session.Loaded = true
	deliverAll(player)
	return true
end

local function queueRefresh(player: Player, delay: number)
	local session = sessions[player]
	if not session or session.RefreshQueued then
		return
	end
	session.RefreshQueued = true
	task.delay(delay, function()
		if sessions[player] == session then
			session.RefreshQueued = false
			loadInbox(player, true)
		end
	end)
end

-- Message d'un autre serveur : un mail attend un joueur d'ici
local function onMessage(message: any)
	local data = type(message) == "table" and message.Data or nil
	if type(data) ~= "table" or not Rules.ValidUserId(data.To) then
		return
	end
	local player = Players:GetPlayerByUserId(data.To)
	if player and sessions[player] then
		queueRefresh(player, 1.5)
	end
end

----------------------------------------------------------------------
-- Envoi
----------------------------------------------------------------------

local function doSend(player: Player, session, args): (boolean, any)
	local toId = args.To
	local subject = Rules.Clean(args.Subject, Rules.SubjectMax)
	local body = Rules.Clean(args.Body, Rules.BodyMax)
	if subject == "" and body == "" then
		return false, T(player, "Write something first ✍️")
	end

	-- Réponse : à un mail reçu de CE destinataire, une seule fois
	local original = nil
	if args.ReplyTo ~= nil then
		original = findRecord(session, args.ReplyTo)
		if not original or original.F ~= toId then
			return false, T(player, "This mail can't be answered anymore")
		end
		if original.Rp or session.Ops.Replied[original.Id] then
			return false, T(player, "You already answered this mail")
		end
	end
	local replying = original ~= nil

	local state = friendState(player)
	if not state then
		return false, T(player, "Message could not be sent, try again")
	end
	local allowedNow, remaining = Rules.Check(state, os.time(), replying)
	if not allowedNow then
		return false, T(player, "Next friend mail in %s", Rules.Countdown(remaining))
	end

	local friend = isFriend(player, session, toId)
	if friend == false then
		return false, T(player, "You can only mail your Roblox friends")
	elseif friend == nil then
		return false, T(player, "Friend mail is unavailable right now")
	end
	local canChat = canUserChat(player.UserId)
	if canChat == false then
		return false, T(player, "Your account settings don't allow private messages")
	elseif canChat == nil then
		return false, T(player, "Friend mail is unavailable right now")
	end
	-- "Non" net : refusé. Inconnu (destinataire sur un autre serveur ou hors
	-- ligne) : accepté, la paire est contrôlée à la livraison
	local pair = pairAllowed(session, player.UserId, toId)
	if pair == false then
		return false, T(player, "This friend can't receive messages (privacy settings)")
	end

	-- Version filtrée "pour tout le monde" (secours de la livraison)
	local broadcastSubject = filterBroadcast(subject, player.UserId)
	local broadcastBody = broadcastSubject ~= nil and filterBroadcast(body, player.UserId) or nil
	if broadcastSubject == nil or broadcastBody == nil then
		return false, T(player, "Message could not be sent, try again")
	end

	if not store or not hasBudget(Enum.DataStoreRequestType.UpdateAsync) then
		return false, T(player, "Friend mail is busy, try again in a minute")
	end
	local dataStore = store :: DataStore
	local now = os.time()
	local record = {
		Id = HttpService:GenerateGUID(false),
		F = player.UserId,
		N = player.Name,
		D = player.DisplayName,
		S = subject,
		B = body,
		BS = broadcastSubject,
		BB = broadcastBody,
		T = now,
		R = original and original.Id or nil,
	}
	local ok = retry("Envoi d'un mail à " .. tostring(toId), function()
		dataStore:UpdateAsync(keyFor(toId), function(old)
			return Rules.Append(old, record, os.time())
		end)
	end)
	if not ok then
		return false, T(player, "Message could not be sent, try again")
	end

	-- Envoyé : l'anti-spam compte (sauvegardé avec les données du joueur)
	if replying then
		state.LastReply = now
		original.Rp = true
		session.Ops.Replied[original.Id] = true
		local shown = session.Shown[original.Id]
		if shown then
			shown.Replied = true
		end
		markDirty(player, session)
	else
		state.LastNew = now
	end

	-- Livraison : tout de suite (même serveur) ou message aux autres serveurs
	local target = Players:GetPlayerByUserId(toId)
	local targetSession = target and sessions[target]
	if target and targetSession then
		targetSession.Inbox = Rules.Append(targetSession.Inbox, table.clone(record), os.time())
		task.spawn(deliverAll, target)
	elseif messagingReady then
		task.spawn(function()
			pcall(function()
				MessagingService:PublishAsync(TOPIC, { To = toId, Id = record.Id })
			end)
		end)
	end
	return true, { Id = record.Id, Where = targetSession and "Server" or "Away" }
end

----------------------------------------------------------------------
-- RemoteFunction "FriendMail"
----------------------------------------------------------------------

local function sortedShown(session): { any }
	local list = {}
	for _, mail in pairs(session.Shown) do
		table.insert(list, withAge(mail))
	end
	table.sort(list, function(a, b)
		return a.Time > b.Time
	end)
	return list
end

local function onInvoke(player: Player, action: any, arg: any)
	local session = sessions[player]
	local interval = type(action) == "string" and CALL_INTERVALS[action] or nil
	if not session or not interval then
		return false, T(player, "Invalid message")
	end
	if not RateLimiter.Check(player, "FriendMail_" .. action, interval) then
		return false, T(player, "Slow down a little!"), statusFor(player)
	end

	if action == "Status" then
		return true, statusFor(player)
	elseif action == "Inbox" then
		return true, { Mails = sortedShown(session), Loaded = session.Loaded, Status = statusFor(player) }
	elseif action == "Friends" then
		local reason = unavailableReason()
		local list = fetchFriends(player, session)
		if not list then
			return false, T(player, "Couldn't load your friends"), statusFor(player)
		end
		local state = friendState(player)
		return true, { Friends = list, Blocked = state and state.Blocked or {}, Status = statusFor(player), Reason = reason }
	elseif action == "Send" then
		local reason = unavailableReason()
		if reason then
			return false, unavailableText(player, reason), statusFor(player)
		end
		if type(arg) ~= "table" or not Rules.ValidUserId(arg.To) or arg.To == player.UserId then
			return false, T(player, "Invalid message"), statusFor(player)
		end
		if type(arg.Subject) ~= "string" or type(arg.Body) ~= "string" or (arg.ReplyTo ~= nil and type(arg.ReplyTo) ~= "string") then
			return false, T(player, "Invalid message"), statusFor(player)
		end
		if session.Sending then
			return false, T(player, "Slow down a little!"), statusFor(player)
		end
		session.Sending = true
		local okCall, ok, result = pcall(doSend, player, session, arg)
		session.Sending = false
		if not okCall then
			warn("[FriendMailService] Envoi : " .. tostring(ok))
			return false, T(player, "Message could not be sent, try again"), statusFor(player)
		end
		if ok then
			result.Status = statusFor(player)
			return true, result
		end
		return false, result, statusFor(player)
	elseif action == "Read" then
		local record = findRecord(session, arg)
		if record and not record.Rd then
			record.Rd = true
			session.Ops.Read[record.Id] = true
			local shown = session.Shown[record.Id]
			if shown then
				shown.Read = true
			end
			markDirty(player, session)
		end
		return true, true
	elseif action == "Delete" or action == "Report" then
		local record = findRecord(session, arg)
		if not record then
			return false, T(player, "This mail can't be answered anymore")
		end
		session.Ops.Delete[record.Id] = true
		removeFromSession(session, function(other)
			return other.Id == record.Id
		end)
		local state = friendState(player)
		if action == "Report" and state then
			-- Signaler : rien n'est envoyé ailleurs ; le mail est caché et
			-- l'expéditeur bloqué pour CE joueur
			state.Blocked[tostring(record.F)] = true
			removeFromSession(session, function(other)
				return other.F == record.F
			end)
		end
		markDirty(player, session)
		return true, { Blocked = state and state.Blocked or {} }
	elseif action == "Block" or action == "Unblock" then
		local state = friendState(player)
		if not state or not Rules.ValidUserId(arg) then
			return false, T(player, "Invalid message")
		end
		local key = tostring(arg)
		if action == "Block" then
			local count = 0
			for _ in pairs(state.Blocked) do
				count += 1
			end
			if count >= Rules.BlockMax and not state.Blocked[key] then
				return false, T(player, "Too many blocked players")
			end
			state.Blocked[key] = true
			removeFromSession(session, function(other)
				return other.F == arg
			end)
			markDirty(player, session)
		else
			state.Blocked[key] = nil
			queueRefresh(player, 1)
		end
		return true, { Blocked = state.Blocked }
	end
	return false, T(player, "Invalid message")
end

----------------------------------------------------------------------
-- Cycle de vie
----------------------------------------------------------------------

function FriendMailService:Init(allServices)
	services = allServices
end

function FriendMailService:Start()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[FriendMailService] DataStore indisponible (place non publiée ?) :", result)
		markFatal()
	end

	Net.Function("FriendMail").OnServerInvoke = onInvoke

	-- Messages des autres serveurs (quelques essais, rien de grave sinon :
	-- la relecture de secours livre quand même)
	task.spawn(function()
		for attempt = 1, 3 do
			local subscribed, err = pcall(function()
				return MessagingService:SubscribeAsync(TOPIC, onMessage)
			end)
			if subscribed then
				messagingReady = true
				return
			end
			if isFatal(tostring(err)) then
				return
			end
			task.wait(5 * attempt)
		end
	end)

	-- Relecture de secours + écritures en retard
	task.spawn(function()
		while true do
			task.wait(20)
			local clock = os.clock()
			for player, session in pairs(sessions) do
				if session.Dirty and not session.FlushQueued and not session.Flushing then
					task.spawn(flushSession, player.UserId, session, player)
				end
				local wait = session.Failed and RETRY_INTERVAL or POLL_INTERVAL
				if clock - session.LastPoll >= wait and not session.RefreshQueued then
					queueRefresh(player, math.random() * 5)
				end
			end
		end
	end)

	-- Fermeture du serveur : on écrit ce qui reste
	game:BindToClose(function()
		for player, session in pairs(sessions) do
			if session.Dirty then
				task.spawn(trackedFlush, player.UserId, session, player)
			end
		end
		local start = os.clock()
		while inflight > 0 and os.clock() - start < 15 do
			task.wait(0.1)
		end
	end)
end

function FriendMailService:PlayerReady(player: Player, _data)
	local session = newSession()
	sessions[player] = session
	task.spawn(loadInbox, player, false)
end

function FriendMailService:PlayerRemoving(player: Player)
	local session = sessions[player]
	sessions[player] = nil
	if session and session.Dirty then
		-- (ses données sont encore là : DataService les libère après nous)
		session.BlockedCopy = table.clone(opsFor(player, session).Blocked)
		task.spawn(trackedFlush, player.UserId, session, nil)
	end
end

return FriendMailService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="369">
        <Properties>
          <string name="Name">GameService</string>
          <string name="Source"><![CDATA[--[[
	GameService (ModuleScript)
	Emplacement : ServerScriptService > Services > GameService

	Cœur du jeu, 100 % côté serveur :
	  - clics (limite de clics/seconde, combo calculé par le serveur si la
	    Feature "Combo" est débloquée) ;
	  - achats d'améliorations (le serveur vérifie le prix et l'argent) et
	    "Aller à l'océan" (détox = rebirth) ;
	  - gains passifs (voir le pipeline ci-dessous) ;
	  - temps d'écran (par session, par jour UTC, total) ;
	  - envoi de l'état au client : état COMPLET (StateUpdate) seulement quand
	    quelque chose de "structurel" change (achat, quête terminée, coffre
	    gagné, réglage...), sinon un petit "StateTick" (Dopamine, ClickSeq,
	    avancement des quêtes / du coffre) : voir "Synchronisation" plus bas ;
	  - leaderstats (liste des joueurs en haut à droite) ;
	  - Dopamine hors-ligne : l'absence est calculée au chargement
	    (DataService:TakeOfflineSeconds), le gain est donné et notifié
	    (Notify { Type = "Offline" }) seulement quand le client est prêt
	    (ClientReady), pour que la fenêtre "Bon retour !" s'affiche.
	    Si le joueur part avant, le gain est donné sans notification.

	Pipeline du tick passif (toutes les Config.Game.PassiveTickRate secondes,
	pour chaque joueur chargé) :
	  1. Dopamine/s : PerSecond x temps écoulé -> AddDopamine ;
	  2. Rebonds DVD : DVDService:CollectBounces renvoie le nombre de rebonds
	     depuis le dernier tick (tous les logos, 2 axes, plafonné) ;
	     gain = rebonds x BounceValue, Stats.Bounces, quête "Bounces" ;
	  3. Temps de jeu : Stats.PlaySeconds, temps de la session et
	     ScreenTime["jour UTC"] (on ne garde que Config.ScreenTime.DaysKept jours) ;
	  4. Coffres : LootService:Charge remplit la jauge du coffre mystère ;
	  5. Auto-clic (Game Pass) : AutoClicksPerSecond clics/s, même gain qu'un
	     clic sans combo, comptés dans Stats.TotalClicks.
	Les stats (Rush et bonus compris) sont recalculées une seule fois par
	joueur et par tick. Bonus = produit des multiplicateurs des Game Passes
	possédés x boost actif (MonetizationService) x confort de la maison
	(HouseService, objets posés dans 🏠).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Formulas = require(Shared.Formulas)
local Locale = require(Shared.Locale)
local NumberFormatter = require(Shared.NumberFormatter)
local Net = require(Shared.Net)
local GraphicsQuality = require(Shared.GraphicsQuality) -- v9.8 🎨 réglages "Graphismes" (clés Gfx*)
local RateLimiter = require(script.Parent.RateLimiter)

local GameService = {}

local services -- toutes les autres services (rempli par Init)

-- Données "de session" (non sauvegardées) : [Player] = session
local sessions = {}

-- Réglages booléens acceptés par SetSetting (+ "ClickSound" et "Language", voir plus bas)
local VALID_SETTINGS = { Sound = true, Music = true, Effects = true, DarkMode = true }
-- Langues acceptées pour Settings.Language ("Auto" = langue de Roblox)
local VALID_LANGUAGES = { Auto = true, en = true, fr = true }
local DEFAULT_LANGUAGE = "Auto"
-- Sons de clic existants : [Id] = true
local CLICK_SOUNDS = {}
for _, clickSound in ipairs(Config.ClickSounds) do
	CLICK_SOUNDS[clickSound.Id] = true
end
local DEFAULT_CLICK_SOUND = "Default"
-- Musiques au choix : "Shuffle" (aléatoire) ou la Key d'une piste de Config.Music.Playlist
local MUSIC_TRACKS = { Shuffle = true }
for _, track in ipairs(Config.Music.Playlist) do
	if type(track.Key) == "string" then
		MUSIC_TRACKS[track.Key] = true
	end
end

-- Clients qui ont envoyé ClientReady (l'interface peut afficher les notifications).
-- Peut arriver AVANT la fin du chargement des données : on le retient à part.
local readyClients: { [Player]: boolean } = {}
local SECONDS_PER_DAY = 86400

----------------------------------------------------------------------
-- Utilitaires
----------------------------------------------------------------------

local function isValidNumber(value): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function currentDay(): number
	return math.floor(os.time() / SECONDS_PER_DAY)
end

local function createLeaderstats(player: Player)
	if player:FindFirstChild("leaderstats") then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"

	-- StringValue pour afficher "1.5M" au lieu d'un nombre illisible
	local dopamine = Instance.new("StringValue")
	dopamine.Name = Config.Game.CurrencyName
	dopamine.Value = "0"
	dopamine.Parent = folder

	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Value = 0
	rebirths.Parent = folder

	folder.Parent = player
end

local function updateLeaderstats(player: Player, data)
	local folder = player:FindFirstChild("leaderstats")
	if not folder then
		return
	end
	local dopamine = folder:FindFirstChild(Config.Game.CurrencyName) :: StringValue?
	local rebirths = folder:FindFirstChild("Rebirths") :: IntValue?
	if dopamine then
		local text = NumberFormatter.Format(data.Dopamine)
		if dopamine.Value ~= text then
			dopamine.Value = text
		end
	end
	if rebirths and rebirths.Value ~= data.Rebirths then
		rebirths.Value = data.Rebirths
	end
end

-- Temps d'écran : supprime les jours trop anciens (et les clés invalides)
local function pruneScreenTime(data)
	local screenTime = data.ScreenTime
	local oldest = currentDay() - Config.ScreenTime.DaysKept + 1
	for key, value in pairs(screenTime) do
		local day = tonumber(key)
		if type(key) ~= "string" or not day or day < oldest or not isValidNumber(value) then
			screenTime[key] = nil
		end
	end
end

-- Corrige une sauvegarde abîmée ou devenue incohérente avec la config
-- (niveau max baissé, objet cosmétique supprimé...)
local function sanitizeData(data)
	for upgradeId, level in pairs(data.Upgrades) do
		local upgrade = Config.UpgradesById[upgradeId]
		if not upgrade or not isValidNumber(level) or level <= 0 or upgrade.Effect == "Detox" then
			data.Upgrades[upgradeId] = nil
		elseif upgrade.MaxLevel and level > upgrade.MaxLevel then
			data.Upgrades[upgradeId] = upgrade.MaxLevel
		else
			data.Upgrades[upgradeId] = math.floor(level)
		end
	end

	local cosmetics = data.Cosmetics
	for _, slot in ipairs({ "Hat", "Skin" }) do
		local id = cosmetics.Equipped[slot]
		local cosmetic = type(id) == "string" and Config.CosmeticsById[id]
		if not cosmetic or cosmetic.Slot ~= slot or not cosmetics.Owned[id] then
			cosmetics.Equipped[slot] = ""
		end
	end

	local chests = data.Chests
	chests.Stored = math.clamp(math.floor(chests.Stored), 0, Config.LootBox.MaxStored)
	chests.Progress = math.clamp(chests.Progress, 0, 1)

	if not isValidNumber(data.Dopamine) or data.Dopamine < 0 then
		data.Dopamine = 0
	end
	if type(data.Stock) ~= "table" then
		data.Stock = { Shares = 0, CostBasis = 0 }
	end
	if not isValidNumber(data.Stock.Shares) or data.Stock.Shares < 0 then
		data.Stock.Shares = 0
		data.Stock.CostBasis = 0
	end

	pruneScreenTime(data)

	-- Son de clic supprimé de la config -> son par défaut
	if type(data.Settings.ClickSound) ~= "string" or not CLICK_SOUNDS[data.Settings.ClickSound] then
		data.Settings.ClickSound = DEFAULT_CLICK_SOUND
	end
	-- Musique retirée de la config -> aléatoire
	if type(data.Settings.MusicTrack) ~= "string" or not MUSIC_TRACKS[data.Settings.MusicTrack] then
		data.Settings.MusicTrack = "Shuffle"
	end
	-- Niveaux au-delà du maximum (ex. 10 logos DVD -> 5 maintenant)
	for upgradeId, level in pairs(data.Upgrades) do
		local upgrade = Config.UpgradesById[upgradeId]
		if upgrade and upgrade.MaxLevel and type(level) == "number" and level > upgrade.MaxLevel then
			data.Upgrades[upgradeId] = upgrade.MaxLevel
		end
	end
	-- Ancienne bourse retirée : les actions encore détenues sont remboursées une fois
	if isValidNumber(data.Stock.Shares) and data.Stock.Shares > 0 then
		local price = (Config.Stocks and tonumber(Config.Stocks.StartPrice)) or 0
		data.Dopamine = math.min(Config.Game.MaxDopamine, data.Dopamine + data.Stock.Shares * price)
	end
	data.Stock.Shares = 0
	data.Stock.CostBasis = 0
	-- Langue inconnue (sauvegarde abîmée) -> automatique
	if type(data.Settings.Language) ~= "string" or not VALID_LANGUAGES[data.Settings.Language] then
		data.Settings.Language = DEFAULT_LANGUAGE
	end
	-- Abonné au live sans posséder le live (sauvegarde incohérente)
	if data.LiveFollowed and not Formulas.HasFeature(data, "LiveStream") then
		data.LiveFollowed = false
	end
end

----------------------------------------------------------------------
-- API utilisée par les autres services
----------------------------------------------------------------------

function GameService:Init(allServices)
	services = allServices
end

function GameService:IsReady(player: Player): boolean
	return sessions[player] ~= nil
end

function GameService:GetSession(player: Player)
	return sessions[player]
end

-- Le joueur possède-t-il cette Feature (débloquée par une amélioration) ?
function GameService:HasFeature(player: Player, feature: string): boolean
	local data = services.DataService:GetData(player)
	return data ~= nil and Formulas.HasFeature(data, feature)
end

-- Calcule les statistiques actuelles du joueur (gain/clic, gain/s...)
-- Bonus = Game Passes x boost actif x confort de la maison 🏠
function GameService:GetStats(player: Player)
	local data = services.DataService:GetData(player)
	return Formulas.ComputeStats(
		data,
		services.EventService:GetMultiplier(),
		services.MonetizationService:GetBonusMultiplier(player) * services.HouseService:GetBonus(player)
			* (if services.FoodService then services.FoodService:GetMultiplier(player) else 1) -- (v9.8) 🍦 boost nourriture
	)
end

-- Ajoute de la Dopamine (façon normale de gagner de l'argent dans le jeu)
-- countForQuests = false pour ne pas faire avancer les quêtes "Gagne X"
function GameService:AddDopamine(player: Player, amount: number, countForQuests: boolean?)
	local data = services.DataService:GetData(player)
	if not data or not isValidNumber(amount) or amount <= 0 then
		return
	end
	local maxValue = Config.Game.MaxDopamine
	data.Dopamine = math.min(maxValue, data.Dopamine + amount)
	data.Stats.LifetimeDopamine = math.min(maxValue, data.Stats.LifetimeDopamine + amount)
	if countForQuests ~= false then
		-- Quêtes "Gagne X" : leur avancement part dans le petit tick ; un état
		-- complet seulement si une quête a été terminée (nouvelle quête)
		local before = data.Stats.QuestsCompleted
		self:RunLight(player, services.QuestService.Progress, services.QuestService, player, "Earn", amount)
		if data.Stats.QuestsCompleted ~= before then
			self:MarkDirty(player)
		end
	end
	self:MarkTick(player)
end

-- Quelque chose de "structurel" a changé : l'état COMPLET partira au
-- prochain envoi (Config.Game.SyncRate). Pendant RunLight, le changement
-- est rétrogradé en petit tick (l'appelant décide lui-même).
function GameService:MarkDirty(player: Player)
	local session = sessions[player]
	if session then
		if session.Light > 0 then
			session.TickDirty = true
		else
			session.Dirty = true
		end
	end
end

-- Seules des valeurs "légères" ont changé (Dopamine, clics, avancement des
-- quêtes ou du coffre) : un petit StateTick suffit
function GameService:MarkTick(player: Player)
	local session = sessions[player]
	if session then
		session.TickDirty = true
	end
end

function GameService:MarkAllDirty()
	for _, session in pairs(sessions) do
		session.Dirty = true
	end
end

-- Appelle fn(...) en rétrogradant ses MarkDirty en petits ticks (appels
-- fréquents : quêtes "Gagne X", jauge du coffre, succès). Les erreurs sont
-- relancées après avoir rétabli le compteur.
function GameService:RunLight(player: Player, fn: (...any) -> ...any, ...)
	local session = sessions[player]
	if not session then
		fn(...)
		return
	end
	session.Light += 1
	local ok, err = pcall(fn, ...)
	session.Light = math.max(0, session.Light - 1)
	if not ok then
		error(err, 0)
	end
end

-- Langue d'un joueur ("en" | "fr") : réglage Settings.Language sinon langue Roblox
function GameService:GetLanguage(player: Player): string
	local data = services and services.DataService:GetData(player)
	local settings = data and data.Settings
	return Locale.ForPlayer(player, settings and settings.Language)
end

-- Traduit un texte anglais dans la langue du joueur (puis string.format)
-- Ex. : GameService:T(player, "Not enough %s", "Dopamine")
function GameService:T(player: Player, text: string, ...): string
	return Locale.TFor(self:GetLanguage(player), text, ...)
end

-- Envoie une notification à un joueur
-- payload = { Type = "Info" | "Error" | "Achievement" | "Quest" | "Bonus" | "Jackpot" | "Rush" | "Unlock" | "Detox" | "Purchase", ... }
-- Le Text éventuel doit déjà être dans la langue du joueur (GameService:T).
function GameService:Notify(player: Player, payload)
	Net.Event("Notify"):FireClient(player, payload)
end

-- Notifie tous les joueurs (sauf `except`, optionnel).
-- `payload` peut être une table (identique pour tous) ou une fonction
-- (langue) -> table, appelée pour chaque joueur afin que le texte soit
-- dans SA langue : NotifyAll(function(lang) return { Text = Locale.TFor(lang, ...) } end)
function GameService:NotifyAll(payload: any, except: Player?)
	local remote = Net.Event("Notify")
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= except then
			local message = payload
			if type(payload) == "function" then
				local ok, result = pcall(payload, self:GetLanguage(other))
				message = ok and result or nil
			end
			if type(message) == "table" then
				remote:FireClient(other, message)
			end
		end
	end
end

-- Temps d'écran envoyé au client
function GameService:GetScreenTime(player: Player)
	local data = services.DataService:GetData(player)
	local session = sessions[player]
	local today = currentDay()
	local days = {}
	for offset = Config.ScreenTime.DaysKept - 1, 0, -1 do
		table.insert(days, data.ScreenTime[tostring(today - offset)] or 0)
	end
	return {
		Session = session and session.SessionSeconds or 0,
		Today = data.ScreenTime[tostring(today)] or 0,
		Total = data.Stats.PlaySeconds,
		Days = days, -- du plus ancien à aujourd'hui
	}
end

-- Construit l'état envoyé au client (tout ce que l'interface doit afficher)
function GameService:BuildState(player: Player)
	local data = services.DataService:GetData(player)
	local session = sessions[player]
	local stats = self:GetStats(player)
	local monetization = services.MonetizationService
	local boostMultiplier, boostRemaining = monetization:GetBoost(data)
	local offlineRate, offlineMaxSeconds = Formulas.GetOfflineSettings(data)
	local houseComfort = Formulas.GetHouseComfort(data)

	local state = {
		Dopamine = data.Dopamine,
		Rebirths = data.Rebirths,
		Upgrades = data.Upgrades,
		Features = Formulas.GetFeatures(data),
		Achievements = data.Achievements,
		Quests = data.Quests,
		Stats = data.Stats,
		Settings = data.Settings, -- { Sound, Music, Effects, ClickSound, Language, DarkMode }
		LiveFollowed = data.LiveFollowed == true, -- abonné au live (bouton "Suivre")

		ClickValue = stats.ClickValue,
		PerSecond = stats.PerSecond,
		BounceValue = stats.BounceValue,
		DVDCount = stats.DVDCount,
		GlobalMultiplier = stats.GlobalMultiplier,
		ClickMultiplier = stats.ClickMultiplier,
		UpgradeMultiplier = stats.UpgradeMultiplier,
		RebirthMultiplier = stats.RebirthMultiplier,
		AchievementMultiplier = stats.AchievementMultiplier,
		CosmeticMultiplier = stats.CosmeticMultiplier,
		EventMultiplier = stats.EventMultiplier,
		BonusMultiplier = monetization:GetBonusMultiplier(player), -- Game Passes x boost actif (sans la maison)
		ComboEnabled = Formulas.HasFeature(data, "Combo"),

		RebirthCost = Formulas.GetRebirthCost(data.Rebirths),
		NextRebirthMultiplier = Formulas.GetRebirthMultiplier(data.Rebirths + 1),

		Daily = services.DailyRewardService:GetInfo(player, stats),
		Chests = {
			Stored = data.Chests.Stored,
			Progress = data.Chests.Progress,
			Max = Config.LootBox.MaxStored,
		},
		Cosmetics = data.Cosmetics,
		ScreenTime = self:GetScreenTime(player),

		-- Thèmes et boutique Robux
		Themes = services.ThemeService:GetState(player), -- { Owned = { [id] = true }, Equipped = id }
		Passes = monetization:GetOwnedPasses(player), -- { [passId] = true }
		Boost = { Multiplier = boostMultiplier, Remaining = math.max(0, math.floor(boostRemaining)) },
		CasinoEnabled = monetization:IsCasinoEnabled(),
		IsVIP = monetization:IsVIP(player),

		-- 🏠 Maison (gardée pour toujours) : données, confort des objets posés
		-- et multiplicateur de gains (ex. 1.23 = +23 %, déjà compris dans GlobalMultiplier)
		House = data.House,
		HouseComfort = houseComfort,
		HouseBonus = Formulas.GetHouseBonus(houseComfort),

		-- Dopamine hors-ligne : taux (0..1) de la production et durée max prise en compte
		Offline = { Rate = offlineRate, MaxSeconds = offlineMaxSeconds },

		-- Nombre de clics reçus par le serveur (sert au client pour sa prédiction)
		ClickSeq = session and session.ClickSeq or 0,
	}
	-- Champs ajoutés par les autres services (machine chanceuse, jardin,
	-- arcade...) : service:GetClientState(player, data) -> { [champ] = valeur }
	for name, service in pairs(services) do
		if type(service) == "table" and type(service.GetClientState) == "function" then
			local ok, extra = pcall(service.GetClientState, service, player, data)
			if ok and type(extra) == "table" then
				for key, value in pairs(extra) do
					if state[key] == nil then
						state[key] = value
					end
				end
			elseif not ok then
				warn("[GameService] GetClientState de " .. tostring(name) .. " :", extra)
			end
		end
	end
	return state
end

-- Avancement des quêtes (pour savoir s'il a changé depuis le dernier envoi)
local function questProgressKey(data): string
	local parts = {}
	for index, quest in ipairs(data.Quests) do
		parts[index] = tostring(quest.Progress)
	end
	return table.concat(parts, ",")
end

-- Jauge du coffre arrondie au pourcent (ce que le client affiche)
local function chestKey(data): number
	local chests = data.Chests
	return chests.Stored * 1000 + math.floor((chests.Progress or 0) * 100)
end

-- Mémorise ce qui vient d'être envoyé (le prochain tick n'envoie que ce qui change)
local function rememberSent(session, data)
	session.SentQuests = questProgressKey(data)
	session.SentChest = chestKey(data)
	session.SentClicks = data.Stats.TotalClicks
end

function GameService:SendState(player: Player)
	local session = sessions[player]
	local data = services.DataService:GetData(player)
	if not session or not data then
		return
	end
	session.Dirty = false
	session.TickDirty = false
	session.Stale = false
	session.LastFull = os.clock()
	Net.Event("StateUpdate"):FireClient(player, self:BuildState(player))
	rememberSent(session, data)
	updateLeaderstats(player, data)
end

-- Petit état fréquent entre deux états complets. Toujours : Dopamine et
-- ClickSeq ; seulement si changé : clics totaux, avancement des quêtes
-- ({ progrès dans l'ordre de data.Quests }) et coffre ({ Stored, Progress }).
function GameService:BuildTick(player: Player, session, data)
	local tick: { [string]: any } = {
		Dopamine = data.Dopamine,
		ClickSeq = session.ClickSeq,
	}
	local clicks = data.Stats.TotalClicks
	if clicks ~= session.SentClicks then
		tick.TotalClicks = clicks
	end
	local quests = questProgressKey(data)
	if quests ~= session.SentQuests then
		local progress = {}
		for index, quest in ipairs(data.Quests) do
			progress[index] = quest.Progress
		end
		tick.QuestProgress = progress
	end
	if chestKey(data) ~= session.SentChest then
		tick.Chests = { Stored = data.Chests.Stored, Progress = data.Chests.Progress }
	end
	return tick
end

function GameService:SendTick(player: Player)
	local session = sessions[player]
	local data = services.DataService:GetData(player)
	if not session or not data then
		return
	end
	session.TickDirty = false
	Net.Event("StateTick"):FireClient(player, self:BuildTick(player, session, data))
	rememberSent(session, data)
	-- Liste des joueurs : texte "1.5M" (ne change pas à chaque tick)
	updateLeaderstats(player, data)
end

-- Dopamine hors-ligne : calcule le gain pour `seconds` d'absence (production
-- sans Rush ni boost, avec les Game Passes et le confort de la maison), le donne (sans faire avancer les
-- quêtes) et, si `notify`, envoie la fenêtre "Bon retour !" au client.
-- Renvoie le montant donné (0 si rien).
function GameService:GrantOffline(player: Player, seconds: number, notify: boolean?): number
	local data = services.DataService:GetData(player)
	if not data or not isValidNumber(seconds) or seconds <= 0 then
		return 0
	end
	local permanentBonus = services.MonetizationService:GetPassMultiplier(player) * services.HouseService:GetBonus(player)
	local stats = Formulas.ComputeStats(data, 1, permanentBonus)
	local reward = Formulas.GetOfflineReward(data, stats.PerSecond, seconds)
	if not isValidNumber(reward) or reward <= 0 then
		return 0
	end
	local rate, maxSeconds = Formulas.GetOfflineSettings(data)

	self:AddDopamine(player, reward, false)
	data.Stats.OfflineEarned = math.min(Config.Game.MaxDopamine, data.Stats.OfflineEarned + reward)

	if notify and sessions[player] then
		self:SendState(player) -- le compteur inclut déjà le gain quand la fenêtre s'ouvre
		self:Notify(player, {
			Type = "Offline",
			Amount = reward,
			Seconds = math.floor(seconds), -- durée réelle de l'absence (non plafonnée)
			Rate = rate, -- 0..1
			MaxSeconds = maxSeconds, -- durée max prise en compte
			Text = self:T(player, "😴 Welcome back! +%s %s earned while you were away",
				NumberFormatter.Format(reward), Config.Game.CurrencyName),
		})
	end
	return reward
end

-- Donne le gain hors-ligne en attente, seulement si le client est prêt.
-- On attend d'abord (5 s max) la vérification des Game Passes pour que leurs
-- multiplicateurs comptent. Si le joueur part pendant l'attente,
-- PlayerRemoving donne le gain (PendingOffline n'est remis à 0 qu'au don).
local OFFLINE_PASS_WAIT = 5
local function deliverPendingOffline(player: Player)
	local session = sessions[player]
	if not session or not readyClients[player] or session.PendingOffline <= 0 or session.OfflineDelivering then
		return
	end
	session.OfflineDelivering = true
	task.spawn(function()
		services.MonetizationService:WaitForPassChecks(player, OFFLINE_PASS_WAIT)
		session.OfflineDelivering = false
		if sessions[player] ~= session then
			return -- parti entre-temps : déjà donné par PlayerRemoving
		end
		local seconds = session.PendingOffline
		session.PendingOffline = 0 -- avant tout : jamais donné deux fois
		if seconds > 0 then
			local ok, err = pcall(GameService.GrantOffline, GameService, player, seconds, true)
			if not ok then
				warn("[GameService] Erreur du gain hors-ligne pour " .. player.Name .. " :", err)
			end
		end
	end)
end

-- Envoie tout ce dont le client a besoin (état, logos DVD, Rush, classement,
-- bourse) puis le gain hors-ligne si le client est prêt
function GameService:SendFullSync(player: Player)
	if not sessions[player] then
		return
	end
	self:SendState(player)
	services.DVDService:SendSetup(player)
	services.EventService:SendState(player)
	services.LeaderboardService:SendTo(player)
	deliverPendingOffline(player)
end

-- Remet le combo à zéro (détox, reset...)
function GameService:ResetCombo(player: Player)
	local session = sessions[player]
	if session then
		session.Combo = 0
		session.ComboMaxed = false
	end
end

-- "Aller à l'océan" : remet la progression à zéro contre un multiplicateur
-- permanent. On garde : succès, stats, cosmétiques, cadeau, réglages,
-- coffres, temps d'écran, quêtes, la maison 🏠 (data.House n'est pas
-- touchée) et les améliorations "Permanent".
function GameService:Detox(player: Player)
	local data = services.DataService:GetData(player)
	if not data or not sessions[player] then
		return
	end

	local kept = {}
	for upgradeId, level in pairs(data.Upgrades) do
		local upgrade = Config.UpgradesById[upgradeId]
		if upgrade and upgrade.Permanent then
			kept[upgradeId] = level
		end
	end

	data.Dopamine = 0
	data.Upgrades = kept
	if type(data.Stock) == "table" then
		data.Stock.Shares = 0
		data.Stock.CostBasis = 0
	end
	data.Rebirths += 1
	data.LiveFollowed = false -- le live repart de zéro : il faudra se réabonner
	self:ResetCombo(player)

	services.DVDService:Reset(player)
	services.EventService:ClearSpawns(player)
	-- Nouvelles quêtes adaptées à la production (redevenue petite) après la détox
	services.QuestService:Regenerate(player)

	local multiplier = Formulas.GetRebirthMultiplier(data.Rebirths)
	self:Notify(player, {
		Type = "Detox",
		Rebirths = data.Rebirths,
		Multiplier = multiplier,
	})
	local displayName, rebirths = player.DisplayName, tostring(data.Rebirths)
	self:NotifyAll(function(lang)
		return {
			Type = "Info",
			Text = Locale.TFor(lang, "🌊 %s went to the ocean (x%s)", displayName, rebirths),
		}
	end, player)
	self:SendState(player)

	-- Étape importante : on sauvegarde tout de suite (sans bloquer l'appelant)
	task.spawn(function()
		services.DataService:SaveAsync(player, true)
	end)
end

-- Appelé après un changement d'améliorations fait "à la main" (commandes de test)
function GameService:RefreshAfterUpgradeChange(player: Player)
	services.DVDService:SyncLogos(player)
	self:SendState(player)
end

----------------------------------------------------------------------
-- Cycle de vie du joueur (appelé par Main)
----------------------------------------------------------------------

function GameService:PlayerReady(player: Player, data)
	local now = os.clock()
	sessions[player] = {
		ClickSeq = 0,
		Combo = 0, -- jauge de combo (0-100)
		ComboMaxed = false, -- déjà compté comme "combo max" ?
		LastClick = now,
		Tokens = Config.Game.MaxClicksPerSecond, -- anti-autoclick (seau de jetons)
		LastRefill = now,
		SessionSeconds = 0, -- temps de jeu de cette session
		PendingOffline = services.DataService:TakeOfflineSeconds(player), -- absence à récompenser
		OfflineDelivering = false, -- don du gain hors-ligne programmé
		Dirty = true, -- état COMPLET à envoyer (changement structurel)
		TickDirty = false, -- petit StateTick à envoyer (Dopamine, clics...)
		Stale = false, -- des valeurs secondaires (stats...) ont bougé depuis le dernier état complet
		LastFull = 0, -- os.clock() du dernier état complet
		Light = 0, -- > 0 pendant RunLight (MarkDirty -> petit tick)
		AchievementCount = -1, -- succès débloqués (pour détecter un nouveau succès)
		SentQuests = "", -- avancement des quêtes déjà envoyé
		SentChest = -1, -- jauge du coffre déjà envoyée
		SentClicks = -1, -- clics totaux déjà envoyés
	}
	sanitizeData(data)
	createLeaderstats(player)
end

function GameService:PlayerRemoving(player: Player)
	-- Gain hors-ligne jamais notifié (client jamais prêt) : donné quand même,
	-- avant la sauvegarde de sortie (Main appelle ReleaseAsync après)
	local session = sessions[player]
	if session and session.PendingOffline > 0 then
		local seconds = session.PendingOffline
		session.PendingOffline = 0
		local ok, err = pcall(self.GrantOffline, self, player, seconds, false)
		if not ok then
			warn("[GameService] Erreur du gain hors-ligne pour " .. player.Name .. " :", err)
		end
	end
	sessions[player] = nil
	readyClients[player] = nil
end

----------------------------------------------------------------------
-- Actions des joueurs (toujours validées ici)
----------------------------------------------------------------------

local function onClick(player: Player)
	local session = sessions[player]
	local data = services.DataService:GetData(player)
	if not session or not data then
		return
	end

	-- Compté même si refusé : le client s'en sert pour corriger sa prédiction
	session.ClickSeq += 1
	session.TickDirty = true

	-- Seau de jetons : on regagne MaxClicksPerSecond jetons par seconde
	local now = os.clock()
	local maxClicks = Config.Game.MaxClicksPerSecond
	session.Tokens = math.min(maxClicks, session.Tokens + (now - session.LastRefill) * maxClicks)
	session.LastRefill = now
	if session.Tokens < 1 then
		return -- trop de clics : ignoré (autoclicker / exploit)
	end
	session.Tokens -= 1

	data.Stats.TotalClicks += 1

	-- Combo calculé par le serveur (le client ne fait que l'afficher),
	-- seulement si l'amélioration "Combo" est achetée
	local comboMultiplier = 1
	if Formulas.HasFeature(data, "Combo") then
		session.Combo = Formulas.StepCombo(session.Combo, now - session.LastClick)
		if session.Combo >= 100 and not session.ComboMaxed then
			session.ComboMaxed = true
			data.Stats.CombosMaxed += 1
			services.QuestService:Progress(player, "Combo", 1)
		elseif session.Combo < 50 then
			session.ComboMaxed = false
		end
		comboMultiplier = Formulas.GetComboMultiplier(session.Combo)
	else
		session.Combo = 0
		session.ComboMaxed = false
	end
	session.LastClick = now

	local stats = GameService:GetStats(player)
	GameService:AddDopamine(player, stats.ClickValue * comboMultiplier, true)
	services.QuestService:Progress(player, "Clicks", 1)
end

local function onBuyUpgrade(player: Player, upgradeId: any)
	if not RateLimiter.Check(player, "Buy", 0.05) then
		return false, GameService:T(player, "Slow down!")
	end
	local data = services.DataService:GetData(player)
	if not data or not sessions[player] then
		return false, GameService:T(player, "Loading...")
	end
	if type(upgradeId) ~= "string" or #upgradeId > 64 then
		return false, GameService:T(player, "Invalid request")
	end
	local upgrade = Config.UpgradesById[upgradeId]
	if not upgrade then
		return false, GameService:T(player, "Unknown upgrade")
	end

	local level = data.Upgrades[upgradeId] or 0
	if Formulas.IsMaxed(upgrade, level) then
		return false, GameService:T(player, "Max level reached")
	end
	if not Formulas.IsUpgradeUnlocked(data, upgrade) then
		return false, GameService:T(player, "Locked for now")
	end
	local cost = Formulas.GetUpgradeCost(upgrade, level, data.Rebirths)
	if not isValidNumber(cost) or data.Dopamine < cost then
		return false, GameService:T(player, "Not enough %s", Config.Game.CurrencyName)
	end

	-- "Aller à l'océan" : la détox
	if upgrade.Effect == "Detox" then
		if not RateLimiter.Check(player, "Detox", 2) then
			return false, GameService:T(player, "Slow down!")
		end
		GameService:Detox(player)
		local multiplier = NumberFormatter.Multiplier(Formulas.GetRebirthMultiplier(data.Rebirths))
		return true, GameService:T(player, "🌊 Breathe... Permanent earnings %s", multiplier)
	end

	data.Dopamine -= cost
	data.Upgrades[upgradeId] = level + 1
	data.Stats.UpgradesBought += 1
	services.QuestService:Progress(player, "Buy", 1)

	if upgrade.Feature and level == 0 then
		GameService:Notify(player, {
			Type = "Unlock",
			Feature = upgrade.Feature,
			UpgradeId = upgrade.Id,
			Text = GameService:T(player, "✨ New: %s %s!", upgrade.Icon, GameService:T(player, upgrade.Name)),
		})
		if upgrade.Feature == "Quests" then
			-- Les quêtes deviennent visibles : on en propose des toutes neuves, à l'échelle
			services.QuestService:Regenerate(player)
		end
	end

	services.DVDService:SyncLogos(player)
	GameService:SendState(player)
	return true, GameService:T(player, "%s %s level %d", upgrade.Icon, GameService:T(player, upgrade.Name), level + 1)
end

local function onSetSetting(player: Player, name: any, value: any)
	if type(name) ~= "string" then
		return false
	end
	if name == "ClickSound" then
		-- Son de clic : l'Id doit exister dans Config.ClickSounds
		if type(value) ~= "string" or #value > 64 or not CLICK_SOUNDS[value] then
			return false
		end
	elseif name == "MusicTrack" then
		-- Musique : "Shuffle" ou la Key d'une piste de Config.Music.Playlist
		if type(value) ~= "string" or #value > 32 or not MUSIC_TRACKS[value] then
			return false
		end
	elseif name == "Language" then
		-- Langue : "Auto" | "en" | "fr" (appliquée par le client au prochain lancement)
		if type(value) ~= "string" or not VALID_LANGUAGES[value] then
			return false
		end
	elseif GraphicsQuality.IsKey(name) then
		-- v9.8 🎨 Graphismes / Mode réaliste : clé Gfx* connue + valeur de sa liste
		if not GraphicsQuality.IsValid(name, value) then
			return false
		end
	elseif not VALID_SETTINGS[name] or type(value) ~= "boolean" then
		return false
	end
	-- Une limite par réglage : couper le son puis les effets rapidement reste possible
	if not RateLimiter.Check(player, "Setting" .. name, 0.2) then
		return false
	end
	local data = services.DataService:GetData(player)
	if not data then
		return false
	end
	data.Settings[name] = value
	GameService:MarkDirty(player)
	return true
end

----------------------------------------------------------------------
-- Tick passif (voir le pipeline en haut du fichier)
----------------------------------------------------------------------

local function passiveTick(player: Player, session, elapsed: number)
	local data = services.DataService:GetData(player)
	if not data then
		return
	end
	local stats = GameService:GetStats(player)

	-- 1. Dopamine par seconde
	if stats.PerSecond > 0 then
		GameService:AddDopamine(player, stats.PerSecond * elapsed, true)
	end

	-- 2. Rebonds des logos DVD
	local bounces = services.DVDService:CollectBounces(player, workspace:GetServerTimeNow())
	if bounces > 0 then
		data.Stats.Bounces += bounces
		GameService:AddDopamine(player, stats.BounceValue * bounces, true)
		services.QuestService:Progress(player, "Bounces", bounces)
	end

	-- 3. Temps de jeu / temps d'écran
	local before = math.floor(session.SessionSeconds)
	session.SessionSeconds += elapsed
	data.Stats.PlaySeconds += elapsed
	local key = tostring(currentDay())
	local screenTime = data.ScreenTime
	if screenTime[key] == nil then
		screenTime[key] = 0
		pruneScreenTime(data) -- nouveau jour : on oublie le plus ancien
	end
	screenTime[key] += elapsed
	if math.floor(session.SessionSeconds) ~= before then
		-- Le client extrapole le temps d'écran : l'état complet périodique suffit
		session.Stale = true
	end

	-- 4. Coffre mystère : la jauge part dans le petit tick, un nouveau coffre
	-- plein déclenche un état complet
	local storedBefore = data.Chests.Stored
	GameService:RunLight(player, services.LootService.Charge, services.LootService, player, data, elapsed)
	if data.Chests.Stored ~= storedBefore then
		GameService:MarkDirty(player)
	end

	-- 5. Auto-clic (Game Pass) : comme un clic normal, sans combo
	local autoClicks = services.MonetizationService:TakeAutoClicks(player, elapsed)
	if autoClicks > 0 then
		data.Stats.TotalClicks += autoClicks
		GameService:AddDopamine(player, stats.ClickValue * autoClicks, true)
	end
end

----------------------------------------------------------------------
-- Démarrage : branchements des remotes + boucles
----------------------------------------------------------------------

function GameService:Start()
	Net.Event("Click").OnServerEvent:Connect(onClick)
	Net.Event("ClientReady").OnServerEvent:Connect(function(player)
		-- Retenu même si les données chargent encore : Main enverra la synchro
		-- complète (et le gain hors-ligne) à la fin du chargement
		if player.Parent then
			readyClients[player] = true
		end
		if RateLimiter.Check(player, "ClientReady", 2) then
			self:SendFullSync(player)
		end
	end)
	Net.Function("BuyUpgrade").OnServerInvoke = onBuyUpgrade
	Net.Function("SetSetting").OnServerInvoke = onSetSetting

	-- Gains passifs
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(Config.Game.PassiveTickRate)
			local now = os.clock()
			-- plafond : évite un énorme rattrapage après un gel du serveur
			local elapsed = math.min(now - last, 5)
			last = now
			for player, session in pairs(sessions) do
				local ok, err = pcall(passiveTick, player, session, elapsed)
				if not ok then
					warn("[GameService] Erreur du tick passif pour " .. player.Name .. " :", err)
				end
			end
		end
	end)

	-- Synchronisation vers les clients (toutes les Config.Game.SyncRate s) :
	--   - état COMPLET (StateUpdate) si quelque chose de structurel a changé
	--     (Dirty), ou toutes les FULL_REFRESH s si des valeurs secondaires
	--     (stats, temps d'écran...) ont bougé ;
	--   - sinon petit StateTick (Dopamine, ClickSeq, quêtes, coffre) si besoin.
	-- Avant : l'état complet (maison, quêtes, stats...) partait 5 fois par
	-- seconde dès qu'un gain passif existait (source de lag réseau / client).
	local FULL_REFRESH = 10
	local function countAchievements(data): number
		local count = 0
		for _, unlocked in pairs(data.Achievements) do
			if unlocked then
				count += 1
			end
		end
		return count
	end
	task.spawn(function()
		while true do
			task.wait(Config.Game.SyncRate)
			local now = os.clock()
			for player, session in pairs(sessions) do
				if session.Dirty or session.TickDirty or session.Stale then
					local ok, err = pcall(function()
						local data = services.DataService:GetData(player)
						if not data then
							return
						end
						-- Succès : un nouveau succès = état complet (médaille, bonus)
						services.AchievementService:Check(player)
						local achievements = countAchievements(data)
						if achievements ~= session.AchievementCount then
							if session.AchievementCount >= 0 then
								session.Dirty = true
							end
							session.AchievementCount = achievements
						end
						if session.TickDirty then
							session.Stale = true
						end
						if session.Dirty or (session.Stale and now - session.LastFull >= FULL_REFRESH) then
							self:SendState(player)
						elseif session.TickDirty then
							self:SendTick(player)
						end
					end)
					if not ok then
						session.Dirty = false
						session.TickDirty = false
						warn("[GameService] Erreur d'envoi de l'état pour " .. player.Name .. " :", err)
					end
				end
			end
		end
	end)

	-- Petit rappel dans la console du serveur
	print(string.format("[Dopamine Clicker] Serveur prêt (%d joueur(s))", #Players:GetPlayers()))
end

return GameService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="370">
        <Properties>
          <string name="Name">GardenService</string>
          <string name="Source"><![CDATA[--[[
	GardenService (ModuleScript)
	Emplacement : ServerScriptService > Services > GardenService

	🌻 Jardin de Dopamine (Config.Garden, Feature "Garden" ; remplace la bourse).
	  - Parterres : Config.Garden.BasePlots + niveau de l'amélioration
	    "Flower Beds" (Feature "GardenPlots") : Formulas.GetGardenPlotCount.
	  - Chaque parterre fait pousser une fleur tirée au hasard (Weight) ;
	    elle est prête GrowSeconds après avoir été plantée. Les dates sont
	    celles du SERVEUR (os.time) et sont gardées dans data.Garden.Plots :
	    le jardin pousse même quand on n'est pas là.
	  - RemoteFunction "Garden" :
	      "harvest", index  -> cueille UNE fleur (seulement si elle est prête)
	      "harvestAll"      -> cueille toutes les fleurs prêtes
	    Gain = RewardSeconds de production (Formulas.ScaledReward, au moins
	    MinReward), puis un nouveau bulbe est planté automatiquement.
	    v9.8 (GARDEN98) 🌷 jardin de la maison aménagé librement :
	      "saveLayout", { Layout = { [clé] = { X, D, R } }, Decor = { id, ... }? }
	          -> places choisies dans le mode édition du jardin (GardenEdit) ;
	             TOUT est revérifié (GardenSnapshot.CleanLayout : clés connues,
	             objets possédés, zones du niveau, couloirs des portes, nombre
	             d'objets posés) ; Decor = la déco du jardin sortie (possédée,
	             places du niveau) -> data.House.Garden ; limité à 1 / 0,5 s
	      "buyPiece", id    -> achète un objet de jardin (Config.Garden.Pieces :
	             +15 % par exemplaire possédé, Max, RequiresRebirths)
	      "expand"          -> agrandit le jardin d'un niveau (Config.Garden.Expansion)
	  - Envoyé au client par GetClientState :
	      Garden = { Plots = { { Flower, PlantedAt, ReadyAt } }, Now = os.time(),
	                 Level = n, Pieces = { [id] = n }, Layout = { ... } }
	  Données (anciennes sauvegardes : tout ce qui manque = niveau 0, rien) :
	    data.Garden = { Plots, Level, Pieces = { [id] = n }, Layout = { [clé] = { X, D, R } } }
	    (data.Garden n'est jamais remis à zéro par l'océan : seuls les
	    parterres en trop disparaissent)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Locale = require(ReplicatedStorage.Shared.Locale)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Net = require(ReplicatedStorage.Shared.Net)
local GardenSnapshot = require(ReplicatedStorage.Shared.GardenSnapshot)
local RateLimiter = require(script.Parent.RateLimiter)

local GardenService = {}

local services
local random = Random.new()
local settings = Config.Garden

local MAX_PLOTS = 24 -- garde-fou (sauvegarde abîmée, configuration extrême)
local RARE_BROADCAST_WEIGHT = 3 -- fleurs au plus aussi rares que ça : annoncées au serveur
local LAYOUT_INTERVAL = 0.5 -- (s) entre deux sauvegardes du jardin
local BUY_INTERVAL = 0.2 -- (s) entre deux achats du jardin

local flowersById = {}
for _, flower in ipairs(settings.Flowers) do
	flowersById[flower.Id] = flower
end

function GardenService:Init(allServices)
	services = allServices
end

local function isValidNumber(value: any): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

-- Tire une fleur au hasard selon son poids
local function pickFlower()
	local total = 0
	for _, flower in ipairs(settings.Flowers) do
		total += flower.Weight
	end
	local roll = random:NextNumber(0, total)
	for _, flower in ipairs(settings.Flowers) do
		roll -= flower.Weight
		if roll <= 0 then
			return flower
		end
	end
	return settings.Flowers[1]
end

local function plant(now: number)
	local flower = pickFlower()
	return { Flower = flower.Id, PlantedAt = now, ReadyAt = now + flower.GrowSeconds }
end

-- Nombre de parterres du joueur
local function plotCount(data): number
	return math.clamp(math.floor(Formulas.GetGardenPlotCount(data)), 1, MAX_PLOTS)
end

-- (v9.8) Contexte de vérification de la disposition du jardin
local function layoutContext(data): any
	local owned = Formulas.HasFeature(data, settings.Feature)
	local house = type(data.House) == "table" and data.House or {}
	local decor = {}
	if type(house.Garden) == "table" then
		for _, id in ipairs(house.Garden) do
			if type(id) == "string" then
				decor[id] = true
			end
		end
	end
	return {
		Level = GardenSnapshot.Level(data),
		Size = type(house.Size) == "string" and house.Size or nil,
		Beds = owned and plotCount(data) or math.max(1, settings.BasePlots or 3),
		Decor = decor,
		Pieces = GardenSnapshot.OwnedPieces(data),
		Windmill = GardenSnapshot.HasWindmill(data),
	}
end

-- (v9.8) Niveau, objets possédés et disposition : réparés (jamais d'erreur)
local function sanitizeLayout(data)
	local garden = data.Garden
	garden.Level = GardenSnapshot.Level(data)
	garden.Pieces = GardenSnapshot.OwnedPieces(data)
	garden.Layout = GardenSnapshot.CleanLayout(garden.Layout, layoutContext(data))
end

-- Répare data.Garden (types, fleurs retirées de la config, dates impossibles)
-- et ajuste le nombre de parterres. Les parterres ne bougent pas sans la Feature.
local function sanitize(data)
	if type(data.Garden) ~= "table" then
		data.Garden = {}
	end
	local garden = data.Garden
	if type(garden.Plots) ~= "table" then
		garden.Plots = {}
	end
	sanitizeLayout(data)
	if not Formulas.HasFeature(data, settings.Feature) then
		return
	end
	local now = os.time()
	local count = plotCount(data)
	local plots = garden.Plots
	-- Appelé à chaque état envoyé : on ne recrée un parterre que s'il est abîmé
	for index = 1, count do
		local plot = plots[index]
		local flower = type(plot) == "table" and flowersById[plot.Flower]
		if not flower or not isValidNumber(plot.PlantedAt) then
			plots[index] = plant(now)
		elseif plot.PlantedAt > now or plot.PlantedAt ~= math.floor(plot.PlantedAt) or plot.ReadyAt ~= plot.PlantedAt + flower.GrowSeconds then
			-- Date dans le futur (horloge d'un autre serveur) ou incohérente : recalculée
			local plantedAt = math.min(math.floor(plot.PlantedAt), now)
			plots[index] = { Flower = flower.Id, PlantedAt = plantedAt, ReadyAt = plantedAt + flower.GrowSeconds }
		end
	end
	-- Parterres en trop (après l'océan, "Flower Beds" repart de zéro) ou clés parasites
	for key in pairs(plots) do
		if type(key) ~= "number" or key < 1 or key > count or key ~= math.floor(key) then
			plots[key] = nil
		end
	end
end

-- Champs ajoutés à l'état envoyé au client (voir GameService:BuildState)
function GardenService:GetClientState(_player: Player, data)
	sanitize(data)
	-- (la table est copiée par le RemoteEvent : on peut l'envoyer telle quelle)
	local owned = Formulas.HasFeature(data, settings.Feature)
	local garden = data.Garden
	return {
		Garden = {
			Plots = owned and garden.Plots or {},
			Now = os.time(),
			Level = garden.Level,
			Pieces = garden.Pieces,
			Layout = garden.Layout,
		},
	}
end

-- Texte dans la langue du joueur
local function T(player: Player, text: string, ...): string
	return services.GameService:T(player, text, ...)
end

local function formatWait(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

-- Cueille la fleur du parterre `index` (déjà vérifiée prête). Renvoie le gain.
local function harvestPlot(player: Player, data, index: number, stats, now: number)
	local plot = data.Garden.Plots[index]
	local flower = flowersById[plot.Flower]
	local minimum = (settings.MinReward or 0) * math.max(1, flower.RewardSeconds / 10)
	local amount = Formulas.ScaledReward(stats, flower.RewardSeconds, minimum)
	data.Garden.Plots[index] = plant(now)
	data.Stats.GardenHarvests = (tonumber(data.Stats.GardenHarvests) or 0) + 1
	services.GameService:AddDopamine(player, amount, true)
	return flower, amount
end

local function announceRare(player: Player, flower, amount: number)
	if flower.Weight > RARE_BROADCAST_WEIGHT then
		return
	end
	local displayName, formatted = player.DisplayName, NumberFormatter.Format(amount)
	services.GameService:NotifyAll(function(lang)
		return {
			Type = "Info",
			Text = Locale.TFor(lang, "🌸 %s picked a %s in their garden (+%s)!", displayName, Locale.TFor(lang, flower.Name), formatted),
		}
	end, player)
end

----------------------------------------------------------------------
-- v9.8 (GARDEN98) : jardin de la maison (disposition, objets, agrandissement)
----------------------------------------------------------------------

local function gardenResult(data): any
	local garden = data.Garden
	return { Level = garden.Level, Pieces = garden.Pieces, Layout = garden.Layout, Decor = (data.House and data.House.Garden) or {} }
end

-- Déco du jardin sortie demandée par le mode édition -> data.House.Garden
local function applyDecor(data, requested: any)
	local house = data.House
	if type(house) ~= "table" or type(requested) ~= "table" then
		return
	end
	local owned = type(house.OwnedGarden) == "table" and house.OwnedGarden or {}
	local looks = Config.HouseLooksById and Config.HouseLooksById.Garden or {}
	local slots = GardenSnapshot.DecorSlots(GardenSnapshot.Level(data))
	local list, seen = {}, {}
	for index, id in ipairs(requested) do
		if index > 64 or #list >= slots then
			break
		end
		if type(id) == "string" and #id <= 64 and owned[id] == true and looks[id] and not seen[id] then
			seen[id] = true
			table.insert(list, id)
		end
	end
	house.Garden = list
end

local function saveLayout(player: Player, data, argument: any)
	if type(argument) ~= "table" or type(argument.Layout) ~= "table" then
		return false, T(player, "Invalid request")
	end
	local requested = 0
	for _ in pairs(argument.Layout) do
		requested += 1
		if requested > GardenSnapshot.MAX_ENTRIES * 2 then
			return false, T(player, "Invalid request")
		end
	end
	if argument.Decor ~= nil then
		applyDecor(data, argument.Decor)
	end
	local clean = GardenSnapshot.CleanLayout(argument.Layout, layoutContext(data))
	local kept = 0
	for _ in pairs(clean) do
		kept += 1
	end
	data.Garden.Layout = clean
	services.GameService:SendState(player)
	local result = gardenResult(data)
	result.Dropped = math.max(0, requested - kept)
	return true, result
end

local function buyPiece(player: Player, data, pieceId: any)
	local piece = type(pieceId) == "string" and GardenSnapshot.PiecesById[pieceId] or nil
	if not piece then
		return false, T(player, "Invalid request")
	end
	local rebirths = isValidNumber(data.Rebirths) and data.Rebirths or 0
	local needed = tonumber(piece.RequiresRebirths) or 0
	if rebirths < needed then
		return false, T(player, "🔒 Unlocked after %d visits to the ocean", needed)
	end
	local pieces = data.Garden.Pieces
	local owned = pieces[piece.Id] or 0
	if owned >= (tonumber(piece.Max) or 10) then
		return false, T(player, "You have the maximum of this item")
	end
	local cost = GardenSnapshot.PieceCost(piece, owned)
	if not isValidNumber(data.Dopamine) or data.Dopamine < cost then
		return false, T(player, "Not enough %s", Config.Game.CurrencyName)
	end
	data.Dopamine -= cost
	pieces[piece.Id] = owned + 1
	services.GameService:SendState(player)
	local result = gardenResult(data)
	result.Piece = piece.Id
	result.Count = owned + 1
	result.Message = T(player, "%s %s is yours! (%s)", piece.Icon or "🪴", T(player, piece.Name), NumberFormatter.Format(cost))
	return true, result
end

local function expand(player: Player, data)
	local level = GardenSnapshot.Level(data)
	local info = GardenSnapshot.LevelInfo(level + 1)
	if not info then
		return false, T(player, "Your garden is already at its biggest!")
	end
	local rebirths = isValidNumber(data.Rebirths) and data.Rebirths or 0
	local needed = tonumber(info.RequiresRebirths) or 0
	if rebirths < needed then
		return false, T(player, "🔒 Unlocked after %d visits to the ocean", needed)
	end
	local cost = tonumber(info.Cost) or math.huge
	if not isValidNumber(data.Dopamine) or data.Dopamine < cost then
		return false, T(player, "Not enough %s", Config.Game.CurrencyName)
	end
	data.Dopamine -= cost
	data.Garden.Level = level + 1
	sanitizeLayout(data)
	services.GameService:SendState(player)
	local result = gardenResult(data)
	result.Message = T(player, "%s %s: your garden is bigger! (%s)", info.Icon or "🌳", T(player, info.Name), NumberFormatter.Format(cost))
	return true, result
end

local HOUSE_ACTIONS = { saveLayout = true, buyPiece = true, expand = true }

local function onGarden(player: Player, action: any, arg: any)
	if HOUSE_ACTIONS[action] then
		local interval = action == "saveLayout" and LAYOUT_INTERVAL or BUY_INTERVAL
		if not RateLimiter.Check(player, "Garden_" .. action, interval) then
			return false, T(player, "Slow down!")
		end
		local data = services.DataService:GetData(player)
		if not data or not services.GameService:IsReady(player) then
			return false, T(player, "Loading...")
		end
		sanitize(data)
		if action == "saveLayout" then
			return saveLayout(player, data, arg)
		elseif action == "buyPiece" then
			return buyPiece(player, data, arg)
		end
		return expand(player, data)
	end
	if action ~= "harvest" and action ~= "harvestAll" then
		return false, T(player, "Invalid request")
	end
	local interval = action == "harvestAll" and 1 or math.max(0.05, (settings.HarvestCooldown or 0.3) - 0.1)
	if not RateLimiter.Check(player, "Garden_" .. action, interval) then
		return false, T(player, "Slow down!")
	end
	local data = services.DataService:GetData(player)
	if not data or not services.GameService:IsReady(player) then
		return false, T(player, "Loading...")
	end
	if not Formulas.HasFeature(data, settings.Feature) then
		return false, T(player, "The garden isn't unlocked yet")
	end
	sanitize(data)

	local now = os.time()
	local plots = data.Garden.Plots
	local stats = services.GameService:GetStats(player)

	if action == "harvest" then
		local index = tonumber(arg)
		if not index or index ~= math.floor(index) or index < 1 or index > #plots then
			return false, T(player, "Invalid request")
		end
		local plot = plots[index]
		if now < plot.ReadyAt then
			return false, T(player, "Still growing... ready in %s", formatWait(plot.ReadyAt - now))
		end
		local flower, amount = harvestPlot(player, data, index, stats, now)
		services.QuestService:Progress(player, "Harvest", 1)
		services.GameService:SendState(player)
		announceRare(player, flower, amount)
		return true, {
			Plot = index,
			Flower = flower.Id,
			Reward = amount,
			Harvested = { { Plot = index, Flower = flower.Id, Reward = amount } },
			Plots = data.Garden.Plots,
			Now = now,
		}
	end

	-- "harvestAll"
	local harvested = {}
	local total = 0
	for index, plot in ipairs(plots) do
		if now >= plot.ReadyAt then
			local flower, amount = harvestPlot(player, data, index, stats, now)
			total += amount
			table.insert(harvested, { Plot = index, Flower = flower.Id, Reward = amount })
			announceRare(player, flower, amount)
		end
	end
	if #harvested == 0 then
		return false, T(player, "Nothing is ready yet 🌱")
	end
	services.QuestService:Progress(player, "Harvest", #harvested)
	services.GameService:SendState(player)
	return true, {
		Reward = total,
		Harvested = harvested,
		Plots = data.Garden.Plots,
		Now = now,
	}
end

function GardenService:PlayerReady(_player: Player, data)
	sanitize(data)
end

function GardenService:Start()
	Net.Function("Garden").OnServerInvoke = function(player: Player, action: any, arg: any)
		local ok, success, result = pcall(onGarden, player, action, arg)
		if not ok then
			warn("[GardenService] Erreur pour " .. player.Name .. " :", success)
			return false, T(player, "Invalid request")
		end
		return success, result
	end
end

return GardenService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="371">
        <Properties>
          <string name="Name">HouseService</string>
          <string name="Source"><![CDATA[--[[
	HouseService (ModuleScript)
	Emplacement : ServerScriptService > Services > HouseService

	🏠 Ma maison (Config.House) : une maison de poupée à plusieurs pièces,
	gardée pour toujours (même après l'océan).
	  - la maison (taille) est une grille Floors x Columns de pièces ; on en
	    achète une plus grande avec la Dopamine ;
	  - chaque pièce a un type (salon, chambre, cuisine...), un emplacement
	    dans la grille (déplaçable), son papier peint, son sol et ses objets ;
	  - on achète des pièces (prix x RoomCostGrowth par pièce), des objets
	    (prix x CostGrowth par exemplaire), des papiers peints et des sols ;
	  - le client envoie la disposition des pièces ("saveLayout"), le
	    serveur vérifie TOUT (objets possédés toutes pièces confondues,
	    nombre max par pièce, zones mur/sol) ;
	  - le Confort des objets posés (x1,5 pour les objets "préférés" de leur
	    pièce : harmonie) donne un bonus sur TOUS les gains.

	Données : data.House = {
		Size = "Studio",
		OwnedSizes = { [id] = true }, OwnedWallpapers = { [id] = true }, OwnedFloors = { [id] = true },
		Items = { [itemId] = nombre possédé },
		Rooms = { { Id = "R1", Type = "Living", Slot = 1..MaxRooms, Wallpaper = id, Floor = id,
			Placed = { { I = itemId, X = 0..1, Y = 0..1, S = 0.6..1.6, Z = 0..999, F = true? }, ... } }, ... },
		NextRoom = 2, -- prochain numéro d'Id de pièce
		-- v9.1 🎨 personnalisation (Config.HouseLookKinds) :
		OwnedTrims / OwnedMoods / OwnedViews / OwnedFacades / OwnedRoofs /
		OwnedRoofStyles / OwnedGarden = { [id] = true },
		Facade = id, Roof = id, RoofStyle = id, -- extérieur
		Garden = { id, ... }, -- déco du jardin affichée (GardenSlots max)
	}
	Chaque pièce a aussi Trim (boiseries), Mood (ambiance) et View (vue par la
	fenêtre) ; un objet posé peut avoir C = couleur (Config.House.Tints ;
	les couleurs verrouillées par les visites à l'océan sont retirées).
	Anciennes sauvegardes : tout ce qui manque prend la 1re entrée (gratuite).
	F (facultatif) = objet retourné gauche <-> droite (chaise tournée vers la
	table...). Petits objets posés SUR un meuble : Formulas.CanGoOnFurniture
	(Y jusqu'à Config.House.TabletopMinY), même règle que l'éditeur.
	Emplacement (Slot) : (étage - 1) x Columns + colonne ; étage 1 = rez-de-chaussée.
	Les anciennes sauvegardes (une seule pièce : Wallpaper / Floor / Placed)
	deviennent un salon.
	Stats : HouseItemsBought, HouseComfort (meilleur confort atteint).

	RemoteFunction House (action, argument) -> (succès, message) :
	  "buyItem" itemId | "buySize" sizeId | "setSize" sizeId
	  "buyRoom" typeId | { Type, Slot? }
	  "moveRoom" { Room, Slot }   (échange si l'emplacement est pris)
	  "setRoomType" { Room, Type }
	  "buyWallpaper" / "setWallpaper" / "buyFloor" / "setFloor" { Room, Id } (ou Id seul = 1re pièce)
	  "saveLayout" { Rooms = { [roomId] = { { I, X, Y, S, Z, F?, C? }, ... } } }  (ou { Room, Placed })
	  "buyLook" { Kind, Id, Room? }  achète (et applique) une personnalisation
	  "setRoomState" { Room, LightsOn?, CurtainsOpen? }  (v9.8) 💡 interrupteur / 🪟 rideaux d'une pièce
	  "setLook" { Kind, Id, Room?, On? }  applique une personnalisation possédée
	    (Kind "Garden" : On = true / false pose / range la déco du jardin)
	  "saveExterior" { [Kind] = Id, Num = n }  (v10 HOUSE10) 🏡 éditeur de
	    l'extérieur : achète d'un coup les choix pas encore possédés
	    (Shared/HouseOptions : prix, visites à l'océan) puis applique le tout ;
	    data.House.Ext / OwnedExt ; attribut répliqué "HouseExt" du joueur
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local WorldLayout = require(ReplicatedStorage.Shared.WorldLayout)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Net = require(ReplicatedStorage.Shared.Net)
local RateLimiter = require(script.Parent.RateLimiter)
-- (v10 HOUSE10) 🏡 extérieur (facultatif : les simulations de tests sans ce module continuent)
local HouseOptions: any = nil
do
	local ok, result = pcall(function()
		return require(ReplicatedStorage.Shared.HouseOptions)
	end)
	if ok and type(result) == "table" then
		HouseOptions = result
	end
end

local HouseService = {}

local services

local HOUSE = Config.House
local DEFAULT_SIZE = HOUSE.Sizes[1].Id
local DEFAULT_WALLPAPER = HOUSE.Wallpapers[1].Id
local DEFAULT_FLOOR = HOUSE.Floors[1].Id

local DEFAULT_ROOM_TYPE = HOUSE.RoomTypes[1].Id
local ROOM_LOOKS = { "Trim", "Mood", "View" }

local MAX_ID_LENGTH = 64
local MAX_ROOM_ID_LENGTH = 16
local BUY_INTERVAL = 0.1 -- secondes entre deux achats / changements
local LAYOUT_INTERVAL = 0.5 -- secondes entre deux sauvegardes de disposition
local MIN_SCALE, MAX_SCALE = 0.6, 1.6
local MAX_Z = 999
-- Zones : objets "Wall" en haut (Y <= WallRatio), objets "Floor" en bas
-- (Y >= WallRatio x 0.85 : un peu de marge pour les objets posés contre le mur)
local WALL_MAX_Y = HOUSE.WallRatio
local FLOOR_MIN_Y = HOUSE.WallRatio * 0.85

----------------------------------------------------------------------
-- Utilitaires
----------------------------------------------------------------------

local function isValidNumber(value): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

-- Arrondi (sauvegarde plus légère)
local function round(value: number, step: number): number
	return math.floor(value / step + 0.5) * step
end

local LOOK_KINDS = Config.HouseLookKinds
local GARDEN_SLOTS = HOUSE.GardenSlots or 6

-- (v9.8 GARDEN98) places de déco du jardin : GardenSlots, plus celles des
-- agrandissements du jardin (Config.Garden.Expansion[data.Garden.Level].DecorSlots)
local function gardenSlots(data): number
	local garden = type(data) == "table" and data.Garden or nil
	local level = type(garden) == "table" and tonumber(garden.Level) or 0
	local levels = Config.Garden and Config.Garden.Expansion
	local entry = type(levels) == "table" and level and level == level and levels[math.floor(level)] or nil
	return math.max(GARDEN_SLOTS, type(entry) == "table" and tonumber(entry.DecorSlots) or 0)
end

local function numberOr(value, default: number): number
	if isValidNumber(value) then
		return value
	end
	return default
end

-- Texte dans la langue du joueur
local function T(player: Player, text: string, ...): string
	return services.GameService:T(player, text, ...)
end

-- (v9.5) "Dopamine Setup" : amélioration du clicker exigée par un objet
-- (item.RequiresUpgrade, au moins 1 niveau dans data.Upgrades) ; renvoie
-- l'amélioration qui manque (ou une entrée minimale si l'Id est inconnu),
-- nil si rien ne manque. Même règle que HouseCommon.MissingUpgrade.
local function missingUpgrade(data, item): any?
	local upgradeId = item.RequiresUpgrade
	if type(upgradeId) ~= "string" then
		return nil
	end
	local upgrades = type(data.Upgrades) == "table" and data.Upgrades or {}
	local level = upgrades[upgradeId]
	if isValidNumber(level) and level >= 1 then
		return nil
	end
	return Config.UpgradesById[upgradeId] or { Id = upgradeId, Name = upgradeId, Icon = "🔒" }
end

-- Un objet posé, corrigé : coordonnées bornées, dans la bonne zone.
-- F = true : dessin retourné (miroir gauche <-> droite), absent sinon.
-- Couleur d'un objet posé : id connu et débloqué (visites à l'océan), sinon nil
local function tintOf(entry, rebirths: number): string?
	local id = entry.C
	if type(id) ~= "string" or #id > MAX_ID_LENGTH then
		return nil
	end
	local tint = Config.HouseTintsById[id]
	if not tint or Formulas.GetHouseRequiredRebirths(tint) > rebirths then
		return nil
	end
	return id
end

-- (v9.3) Rotation 3D d'un objet posé (Dopamine Town) : degrés entiers,
-- multiple de 15 dans 15..345 ; nil = 0 (même règle que WorldLayout.NormalizeRotation)
local function rotationOf(value): number?
	if not isValidNumber(value) then
		return nil
	end
	local r = (math.floor(value / 15 + 0.5) * 15) % 360
	return if r == 0 then nil else r
end

-- (v9.6) Zone valide d'un objet posé : WorldLayout.PlacementArea, LA MÊME
-- que l'éditeur 2D (HouseCommon.ClampPosition) et l'édition 3D de la ville
-- (FurnitureEdit). Un petit objet qui peut aller SUR un meuble (ou un petit
-- objet d'une ancienne sauvegarde) peut monter jusqu'à TabletopMinY.
-- `roomWpx` = largeur 2D de la pièce (px de maquette) de la maison actuelle.
local function areaOf(item, scale: number, roomWpx: number): (number, number, number, number)
	local raised: number? = nil
	if item.Placement ~= "Wall" then
		local floorMin = Formulas.GetHouseFloorMinY(item)
		if floorMin < FLOOR_MIN_Y then
			raised = floorMin
		end
	end
	return WorldLayout.PlacementArea(item.Placement, (tonumber(item.Size) or 80) * scale, roomWpx, WorldLayout.ROOM_HEIGHT_PX, WALL_MAX_Y, raised)
end

local function normalizeEntry(entry, item, rebirths: number?, roomWpx: number?)
	local s = math.clamp(round(math.clamp(numberOr(entry.S, 1), MIN_SCALE, MAX_SCALE), 0.001), MIN_SCALE, MAX_SCALE)
	local x0, x1, y0, y1 = areaOf(item, s, roomWpx or WorldLayout.ROOM_BASE_PX)
	local x, y = WorldLayout.ClampToArea(numberOr(entry.X, 0.5), numberOr(entry.Y, (y0 + y1) / 2), x0, x1, y0, y1)
	local z = math.clamp(math.floor(numberOr(entry.Z, 0)), 0, MAX_Z)
	return {
		I = item.Id,
		X = x,
		Y = y,
		S = s,
		Z = z,
		F = entry.F == true or nil,
		C = tintOf(entry, rebirths or 0),
		-- (v9.3 🚶 Dopamine Town) rotation 3D facultative : degrés, multiple de 15, nil = 0
		R = rotationOf(entry.R),
	}
end

-- Garde les `maxItems` premiers objets posés d'une pièce ; renvoie le nombre rangé
local function trimPlaced(room, maxItems: number): number
	local removed = 0
	while #room.Placed > maxItems do
		table.remove(room.Placed)
		removed += 1
	end
	return removed
end

-- Changement de taille : les objets gardent leur place "en px" autour du
-- centre de la pièce (la déco ne s'étire pas dans une maison plus grande).
-- Si la déco ne tient pas dans la nouvelle largeur, on la resserre à la place.
local LAYOUT_MARGIN = 0.05 -- marge gauche / droite (fraction de la largeur)
local function refitLayout(room, oldSize, newSize)
	local oldWidth = tonumber(oldSize and oldSize.Width) or 1
	local newWidth = tonumber(newSize and newSize.Width) or 1
	if oldWidth <= 0 or newWidth <= 0 or oldWidth == newWidth or #room.Placed == 0 then
		return
	end
	-- Étendue actuelle de la déco (en largeurs de "studio")
	local minX, maxX = math.huge, -math.huge
	for _, entry in ipairs(room.Placed) do
		local px = (entry.X - 0.5) * oldWidth
		minX = math.min(minX, px)
		maxX = math.max(maxX, px)
	end
	local half = (0.5 - LAYOUT_MARGIN) * newWidth
	local factor = 1
	local spread = math.max(-minX, maxX)
	if spread > half and spread > 0 then
		factor = half / spread -- trop large : on resserre autour du centre
	end
	local roomWpx = WorldLayout.RoomWidthPx(newSize)
	for _, entry in ipairs(room.Placed) do
		local px = (entry.X - 0.5) * oldWidth * factor
		local x = math.clamp(0.5 + px / newWidth, 0, 1)
		-- (v9.6) reste dans la zone valide de la nouvelle largeur
		local item = Config.HouseItemsById[entry.I]
		if item then
			local x0, x1 = areaOf(item, numberOr(entry.S, 1), roomWpx)
			x = math.clamp(x, x0, x1)
		end
		entry.X = round(x, 0.0001)
	end
end

----------------------------------------------------------------------
-- Pièces
----------------------------------------------------------------------

-- Emplacement -> (étage, colonne) et inverse, pour une grille de `columns`
local function slotToCell(slot: number, columns: number): (number, number)
	return math.floor((slot - 1) / columns) + 1, (slot - 1) % columns + 1
end

local function cellToSlot(floor: number, column: number, columns: number): number
	return (floor - 1) * columns + column
end

local function findRoom(house, roomId: any)
	if type(roomId) ~= "string" then
		return nil
	end
	for _, room in ipairs(house.Rooms) do
		if room.Id == roomId then
			return room
		end
	end
	return nil
end

local function roomAtSlot(house, slot: number)
	for _, room in ipairs(house.Rooms) do
		if room.Slot == slot then
			return room
		end
	end
	return nil
end

-- Premier emplacement libre (rez-de-chaussée d'abord), nil si la maison est pleine
local function firstFreeSlot(house, maxRooms: number): number?
	for slot = 1, maxRooms do
		if not roomAtSlot(house, slot) then
			return slot
		end
	end
	return nil
end

-- (v9.6) "Look" d'un type de pièce (Config.House.RoomTypes : Wallpaper,
-- Floor, Trim, Mood) : GRATUIT et débloqué pour une pièce de ce type, même
-- s'il n'est pas acheté. Appliqué tout seul à l'achat de la pièce et quand
-- son type change, sauf un style choisi à la main (room.Custom[kind]).
local TYPE_STYLE_KINDS = { "Wallpaper", "Floor", "Trim", "Mood" }
local function styleLookup(kind: string): { [string]: any }
	if kind == "Wallpaper" then
		return Config.HouseWallpapersById
	elseif kind == "Floor" then
		return Config.HouseFloorsById
	end
	return LOOK_KINDS[kind].ById
end
local function styleDefault(kind: string): string
	if kind == "Wallpaper" then
		return DEFAULT_WALLPAPER
	elseif kind == "Floor" then
		return DEFAULT_FLOOR
	end
	return LOOK_KINDS[kind].List[1].Id
end
-- Style du type (id connu) ou nil
local function typeStyle(typeId: any, kind: string): string?
	local roomType = type(typeId) == "string" and Config.HouseRoomTypesById[typeId] or nil
	local id = roomType and roomType[kind]
	if type(id) == "string" and styleLookup(kind)[id] then
		return id
	end
	return nil
end
local function isTypeStyle(room, kind: string, id: any): boolean
	return type(id) == "string" and room ~= nil and typeStyle(room.Type, kind) == id
end
-- Le joueur a-t-il choisi ce style à la main ? (drapeau, sinon : ni le style
-- du type d'avant, ni le style gratuit de départ = choisi)
local function isCustomStyle(room, kind: string, oldTypeId: any): boolean
	if type(room.Custom) == "table" and room.Custom[kind] == true then
		return true
	end
	local current = room[kind]
	return current ~= nil and current ~= typeStyle(oldTypeId, kind) and current ~= styleDefault(kind)
end
-- Retient (ou oublie) un choix à la main
local function markCustom(room, kind: string, id: string)
	local custom = type(room.Custom) == "table" and room.Custom or {}
	custom[kind] = if isTypeStyle(room, kind, id) then nil else true
	room.Custom = next(custom) ~= nil and custom or nil
end
-- Applique le look du type `room.Type` (sauf les styles choisis à la main)
local function applyTypeStyles(room, oldTypeId: any)
	for _, kind in ipairs(TYPE_STYLE_KINDS) do
		if not isCustomStyle(room, kind, oldTypeId) then
			room[kind] = typeStyle(room.Type, kind) or styleDefault(kind)
		end
	end
end

-- Style de départ d'une pièce : celui du type (gratuit), sinon le 1er
local function defaultStyles(_house, roomType): (string, string)
	return typeStyle(roomType.Id, "Wallpaper") or DEFAULT_WALLPAPER, typeStyle(roomType.Id, "Floor") or DEFAULT_FLOOR
end

local function newRoom(house, typeId: string, slot: number)
	local roomType = Formulas.GetRoomType(typeId)
	local id = "R" .. tostring(house.NextRoom)
	house.NextRoom += 1
	local wallpaper, floor = defaultStyles(house, roomType)
	return { Id = id, Type = roomType.Id, Slot = slot, Wallpaper = wallpaper, Floor = floor,
		Trim = typeStyle(roomType.Id, "Trim") or HOUSE.Trims[1].Id, Mood = typeStyle(roomType.Id, "Mood") or HOUSE.Moods[1].Id,
		View = HOUSE.Views[1].Id, Placed = {} }
end

-- Déménagement : chaque pièce garde son étage / sa colonne si possible,
-- sinon elle prend le premier emplacement libre ; la déco est recalée pour
-- la nouvelle largeur de pièce et les objets en trop sont rangés.
local function refitRooms(house, oldSize, newSize): number
	local stored = 0
	local taken = {}
	local pending = {}
	for _, room in ipairs(house.Rooms) do
		local floor, column = slotToCell(room.Slot, oldSize.Columns)
		if floor <= newSize.Floors and column <= newSize.Columns then
			local slot = cellToSlot(floor, column, newSize.Columns)
			if not taken[slot] then
				taken[slot] = true
				room.Slot = slot
			else
				table.insert(pending, room)
			end
		else
			table.insert(pending, room)
		end
	end
	for _, room in ipairs(pending) do
		for slot = 1, newSize.MaxRooms do
			if not taken[slot] then
				taken[slot] = true
				room.Slot = slot
				break
			end
		end
	end
	for _, room in ipairs(house.Rooms) do
		refitLayout(room, oldSize, newSize)
		stored += trimPlaced(room, newSize.RoomItems)
	end
	return stored
end

-- Met à jour le meilleur confort atteint (stat)
local function updateComfortStat(data)
	local comfort = Formulas.GetHouseComfort(data)
	local stats = data.Stats
	if not isValidNumber(stats.HouseComfort) or comfort > stats.HouseComfort then
		stats.HouseComfort = comfort
	end
end

-- Garde seulement les ids connus (valeur true) d'une table { [id] = true }
local function cleanOwnedMap(map, lookup)
	local clean = {}
	if type(map) == "table" then
		for id, value in pairs(map) do
			if value == true and type(id) == "string" and lookup[id] then
				clean[id] = true
			end
		end
	end
	return clean
end

-- Objets posés d'une pièce, corrigés : connus, pas plus que possédés
-- (`used` compte les exemplaires déjà posés dans les autres pièces), au
-- plus `maxItems`
local function cleanPlaced(list, owned, used, maxItems: number, rebirths: number, roomWpx: number?)
	local placed = {}
	if type(list) ~= "table" then
		return placed
	end
	for _, entry in ipairs(list) do
		if #placed >= maxItems then
			break
		end
		local id = type(entry) == "table" and entry.I or nil
		local item = type(id) == "string" and Config.HouseItemsById[id] or nil
		if item and (used[id] or 0) < (owned[id] or 0) then
			used[id] = (used[id] or 0) + 1
			table.insert(placed, normalizeEntry(entry, item, rebirths, roomWpx))
		end
	end
	return placed
end

-- Corrige une sauvegarde abîmée ou devenue incohérente avec la config
-- (et transforme l'ancienne maison à une pièce en maison à pièces)
local function sanitizeHouse(data)
	local house = data.House

	house.OwnedSizes = cleanOwnedMap(house.OwnedSizes, Config.HouseSizesById)
	house.OwnedSizes[DEFAULT_SIZE] = true
	house.OwnedWallpapers = cleanOwnedMap(house.OwnedWallpapers, Config.HouseWallpapersById)
	house.OwnedWallpapers[DEFAULT_WALLPAPER] = true
	house.OwnedFloors = cleanOwnedMap(house.OwnedFloors, Config.HouseFloorsById)
	house.OwnedFloors[DEFAULT_FLOOR] = true

	if type(house.Size) ~= "string" or not house.OwnedSizes[house.Size] then
		house.Size = DEFAULT_SIZE
	end
	local rebirths = numberOr(data.Rebirths, 0)

	-- (v9.1) Personnalisation : entrées connues, la 1re gratuite toujours possédée
	for _, def in pairs(LOOK_KINDS) do
		local owned = cleanOwnedMap(house[def.Owned], def.ById)
		if def.Scope ~= "Garden" then
			owned[def.List[1].Id] = true
		end
		house[def.Owned] = owned
		if def.Scope == "House" then
			local value = house[def.Field]
			if type(value) ~= "string" or not owned[value] then
				house[def.Field] = def.List[1].Id
			end
		elseif def.Scope == "Garden" then
			local garden, seen = {}, {}
			if type(house.Garden) == "table" then
				local slots = gardenSlots(data) -- (v9.8 GARDEN98)
				for _, id in ipairs(house.Garden) do
					if #garden >= slots then
						break
					end
					if type(id) == "string" and owned[id] and not seen[id] then
						seen[id] = true
						table.insert(garden, id)
					end
				end
			end
			house.Garden = garden
		end
	end

	-- Objets possédés : nombres entiers > 0, jamais plus que MaxOwned
	local items = {}
	if type(house.Items) == "table" then
		for id, count in pairs(house.Items) do
			local item = type(id) == "string" and Config.HouseItemsById[id] or nil
			if item and isValidNumber(count) and count >= 1 then
				local n = math.floor(count)
				if item.MaxOwned then
					n = math.min(n, item.MaxOwned)
				end
				items[id] = n
			end
		end
	end
	house.Items = items

	-- Ancienne sauvegarde (une seule pièce) -> un salon
	if type(house.Rooms) ~= "table" or #house.Rooms == 0 then
		house.Rooms = {
			{
				Id = "R1",
				Type = DEFAULT_ROOM_TYPE,
				Slot = 1,
				Wallpaper = house.Wallpaper,
				Floor = house.Floor,
				Placed = house.Placed,
			},
		}
	end
	house.Wallpaper = nil
	house.Floor = nil
	house.Placed = nil

	-- Trop de pièces pour la maison actuelle (sauvegarde abîmée) : on prend
	-- la plus petite maison possédée où elles tiennent
	local size = Formulas.GetHouseSize(data)
	if #house.Rooms > size.MaxRooms then
		for _, candidate in ipairs(HOUSE.Sizes) do
			if house.OwnedSizes[candidate.Id] and candidate.MaxRooms >= #house.Rooms then
				house.Size = candidate.Id
				size = candidate
				break
			end
		end
	end

	-- Pièces : Id unique, type connu, emplacement unique dans la grille,
	-- styles possédés, objets vérifiés (toutes pièces confondues)
	local rooms, ids, slots, used = {}, {}, {}, {}
	local highest = 0
	for _, raw in ipairs(house.Rooms) do
		if #rooms >= size.MaxRooms then
			break
		end
		if type(raw) == "table" then
			local id = raw.Id
			if type(id) ~= "string" or #id == 0 or #id > MAX_ROOM_ID_LENGTH or ids[id] then
				id = nil
			end
			local slot = raw.Slot
			if not isValidNumber(slot) or slot % 1 ~= 0 or slot < 1 or slot > size.MaxRooms or slots[slot] then
				slot = nil
			end
			local roomType = Formulas.GetRoomType(raw.Type)
			local fallbackWallpaper, fallbackFloor = defaultStyles(house, roomType)
			local room = {
				Id = id or "",
				Type = roomType.Id,
				Slot = slot or 0,
				-- (v9.6) possédé, ou le look (gratuit) du type de la pièce
				Wallpaper = (type(raw.Wallpaper) == "string" and (house.OwnedWallpapers[raw.Wallpaper] or typeStyle(roomType.Id, "Wallpaper") == raw.Wallpaper))
					and raw.Wallpaper or fallbackWallpaper,
				Floor = (type(raw.Floor) == "string" and (house.OwnedFloors[raw.Floor] or typeStyle(roomType.Id, "Floor") == raw.Floor))
					and raw.Floor or fallbackFloor,
				-- (v9.6) réparation des anciennes dispositions : tout revient dans la zone valide
				Placed = cleanPlaced(raw.Placed, items, used, size.RoomItems, rebirths, WorldLayout.RoomWidthPx(size)),
			}
			-- (v9.1) boiseries / ambiance / vue : possédées, sinon la 1re (gratuite)
			for _, kind in ipairs(ROOM_LOOKS) do
				local def = LOOK_KINDS[kind]
				local value = raw[def.Field]
				room[def.Field] = (type(value) == "string" and (house[def.Owned][value] or typeStyle(roomType.Id, kind) == value)) and value
					or typeStyle(roomType.Id, kind) or def.List[1].Id
			end
			-- (v9.6) styles choisis à la main (pas remplacés quand le type change)
			if type(raw.Custom) == "table" then
				local custom = {}
				for _, kind in ipairs(TYPE_STYLE_KINDS) do
					if raw.Custom[kind] == true then
						custom[kind] = true
					end
				end
				room.Custom = next(custom) ~= nil and custom or nil
			end
			-- (v9.8 HOUSE98) 💡 lumières éteintes / 🪟 rideaux fermés (absent = allumées / ouverts)
			room.LightsOff = raw.LightsOff == true or nil
			room.CurtainsClosed = raw.CurtainsClosed == true or nil
			if id then
				ids[id] = true
				local number = tonumber(string.match(id, "^R(%d+)$"))
				if number then
					highest = math.max(highest, number)
				end
			end
			if slot then
				slots[slot] = true
			end
			table.insert(rooms, room)
		end
	end
	if #rooms == 0 then
		table.insert(rooms, { Id = "R1", Type = DEFAULT_ROOM_TYPE, Slot = 1, Wallpaper = DEFAULT_WALLPAPER, Floor = DEFAULT_FLOOR,
			Trim = HOUSE.Trims[1].Id, Mood = HOUSE.Moods[1].Id, View = HOUSE.Views[1].Id, Placed = {} })
		highest = 1
	end
	if not isValidNumber(house.NextRoom) or house.NextRoom <= highest then
		house.NextRoom = highest + 1
	end
	house.NextRoom = math.floor(house.NextRoom)
	for _, room in ipairs(rooms) do
		if room.Id == "" then
			room.Id = "R" .. tostring(house.NextRoom)
			house.NextRoom += 1
		end
		if room.Slot == 0 then
			for slot = 1, size.MaxRooms do
				if not slots[slot] then
					slots[slot] = true
					room.Slot = slot
					break
				end
			end
		end
	end
	house.Rooms = rooms

	-- (v10 HOUSE10) 🏡 extérieur personnalisé : choix connus et possédés
	if HouseOptions then
		house.OwnedExt = HouseOptions.CleanOwned(house.OwnedExt)
		house.Ext = HouseOptions.Sanitize(house.Ext, house.OwnedExt)
	end

	if not isValidNumber(data.Stats.HouseItemsBought) or data.Stats.HouseItemsBought < 0 then
		data.Stats.HouseItemsBought = 0
	end
	updateComfortStat(data)
end

----------------------------------------------------------------------
-- API utilisée par les autres services
----------------------------------------------------------------------

function HouseService:Init(allServices)
	services = allServices
end

-- Confort actuel (objets posés)
function HouseService:GetComfort(player: Player): number
	local data = services.DataService:GetData(player)
	if not data then
		return 0
	end
	return Formulas.GetHouseComfort(data)
end

-- Multiplicateur de gains de la maison (1 = aucun bonus)
function HouseService:GetBonus(player: Player): number
	return Formulas.GetHouseBonus(self:GetComfort(player))
end

-- Commande de test /house (Studio) : toutes les tailles, papiers peints,
-- sols, et au moins un exemplaire de chaque objet
function HouseService:DebugGrantAll(player: Player): boolean
	local data = services.DataService:GetData(player)
	if not data then
		return false
	end
	local house = data.House
	for _, size in ipairs(HOUSE.Sizes) do
		house.OwnedSizes[size.Id] = true
	end
	for _, wallpaper in ipairs(HOUSE.Wallpapers) do
		house.OwnedWallpapers[wallpaper.Id] = true
	end
	for _, floor in ipairs(HOUSE.Floors) do
		house.OwnedFloors[floor.Id] = true
	end
	for _, item in ipairs(HOUSE.Items) do
		house.Items[item.Id] = math.max(house.Items[item.Id] or 0, 1)
	end
	for _, def in pairs(LOOK_KINDS) do
		for _, entry in ipairs(def.List) do
			house[def.Owned][entry.Id] = true
		end
	end
	-- (v10 HOUSE10) tous les choix de l'extérieur
	house.OwnedExt = type(house.OwnedExt) == "table" and house.OwnedExt or {}
	for _, def in ipairs(if HouseOptions then HouseOptions.KINDS else {}) do
		for _, choice in ipairs(def.Choices) do
			house.OwnedExt[HouseOptions.OwnedKey(def.Id, choice.Id)] = true
		end
	end
	-- La plus grande maison, avec une pièce de chaque type (gratuit)
	local biggest = HOUSE.Sizes[#HOUSE.Sizes]
	refitRooms(house, Formulas.GetHouseSize(data), biggest)
	house.Size = biggest.Id
	for _, roomType in ipairs(HOUSE.RoomTypes) do
		local slot = firstFreeSlot(house, biggest.MaxRooms)
		if not slot then
			break
		end
		local exists = false
		for _, room in ipairs(house.Rooms) do
			if room.Type == roomType.Id then
				exists = true
				break
			end
		end
		if not exists then
			table.insert(house.Rooms, newRoom(house, roomType.Id, slot))
		end
	end
	updateComfortStat(data)
	services.GameService:SendState(player)
	return true
end

----------------------------------------------------------------------
-- Actions (RemoteFunction House)
----------------------------------------------------------------------

local function buyItem(player: Player, data, itemId: string): (boolean, string)
	local item = Config.HouseItemsById[itemId]
	if not item then
		return false, T(player, "Unknown house item")
	end
	local house = data.House
	local owned = house.Items[itemId] or 0
	local name = T(player, item.Name)
	if item.MaxOwned and owned >= item.MaxOwned then
		return false, T(player, "You can't have more %s %s", item.Icon, name)
	end
	if not Formulas.IsHouseEntryUnlocked(data, item) then
		return false, T(player, "🔒 Unlocked after %d visits to the ocean", Formulas.GetHouseRequiredRebirths(item))
	end
	-- (v9.5) "Dopamine Setup" : l'amélioration du clicker exigée (au moins 1 niveau)
	local missing = missingUpgrade(data, item)
	if missing then
		local label = tostring(missing.Icon or "") .. " " .. T(player, tostring(missing.Name or missing.Id))
		return false, "🔒 " .. T(player, "Unlock %s first", label)
	end
	local price = Formulas.GetHouseItemPrice(item, owned)
	if not isValidNumber(price) or price < 0 or data.Dopamine < price then
		return false, T(player, "Not enough %s", Config.Game.CurrencyName)
	end
	data.Dopamine -= price
	house.Items[itemId] = owned + 1
	data.Stats.HouseItemsBought += 1
	services.GameService:SendState(player)
	return true, T(player, "%s %s added to your house! (%s)", item.Icon, name, NumberFormatter.Format(price))
end

-- Emménage dans une taille possédée (les pièces gardent leur place si possible)
local function moveInto(player: Player, data, size): (boolean, string)
	local house = data.House
	if #house.Rooms > size.MaxRooms then
		return false, T(player, "Too many rooms for this house (max %d)", size.MaxRooms)
	end
	local stored = refitRooms(house, Formulas.GetHouseSize(data), size)
	house.Size = size.Id
	updateComfortStat(data)
	services.GameService:SendState(player)
	local name = T(player, size.Name)
	if stored > 0 then
		return true, T(player, "%s Welcome to your %s! (%d items stored)", size.Icon, name, stored)
	end
	return true, T(player, "%s Welcome to your %s!", size.Icon, name)
end

local function buySize(player: Player, data, sizeId: string): (boolean, string)
	local size = Config.HouseSizesById[sizeId]
	if not size then
		return false, T(player, "Unknown house size")
	end
	local house = data.House
	if house.OwnedSizes[sizeId] then
		return false, T(player, "You already own this house")
	end
	if not Formulas.IsHouseEntryUnlocked(data, size) then
		return false, T(player, "🔒 Unlocked after %d visits to the ocean", Formulas.GetHouseRequiredRebirths(size))
	end
	if not isValidNumber(size.Cost) or size.Cost < 0 or data.Dopamine < size.Cost then
		return false, T(player, "Not enough %s", Config.Game.CurrencyName)
	end
	data.Dopamine -= size.Cost
	house.OwnedSizes[sizeId] = true
	-- On emménage tout de suite si la nouvelle maison est plus grande
	local current = Formulas.GetHouseSize(data)
	if size.Order > current.Order and #house.Rooms <= size.MaxRooms then
		refitRooms(house, current, size)
		house.Size = sizeId
		updateComfortStat(data)
	end
	services.GameService:SendState(player)
	return true, T(player, "%s %s unlocked! (%s)", size.Icon, T(player, size.Name), NumberFormatter.Format(size.Cost))
end

local function setSize(player: Player, data, sizeId: string): (boolean, string)
	local size = Config.HouseSizesById[sizeId]
	if not size then
		return false, T(player, "Unknown house size")
	end
	if not data.House.OwnedSizes[sizeId] then
		return false, T(player, "You don't own this house yet")
	end
	return moveInto(player, data, size)
end

-- Nouvelle pièce (argument : typeId, ou { Type, Slot? })
local function buyRoom(player: Player, data, argument: any): (boolean, string)
	local typeId, wantedSlot = argument, nil
	if type(argument) == "table" then
		typeId, wantedSlot = argument.Type, argument.Slot
	end
	if type(typeId) ~= "string" or not Config.HouseRoomTypesById[typeId] then
		return false, T(player, "Unknown room type")
	end
	-- (v9.3) Types de pièces verrouillés par les visites à l'océan
	local roomTypeEntry = Config.HouseRoomTypesById[typeId]
	if not Formulas.IsHouseEntryUnlocked(data, roomTypeEntry) then
		return false, T(player, "🔒 Unlocked after %d visits to the ocean", Formulas.GetHouseRequiredRebirths(roomTypeEntry))
	end
	local house = data.House
	local size = Formulas.GetHouseSize(data)
	if #house.Rooms >= size.MaxRooms then
		return false, T(player, "Your house is full: move to a bigger house!")
	end
	local slot: number? = nil
	if wantedSlot ~= nil then
		if not isValidNumber(wantedSlot) or wantedSlot % 1 ~= 0 or wantedSlot < 1 or wantedSlot > size.MaxRooms then
			return false, T(player, "Invalid request")
		end
		if roomAtSlot(house, wantedSlot) then
			return false, T(player, "This spot is already taken")
		end
		slot = wantedSlot
	else
		slot = firstFreeSlot(house, size.MaxRooms)
	end
	if not slot then
		return false, T(player, "Your house is full: move to a bigger house!")
	end
	local price = Formulas.GetRoomCost(#house.Rooms)
	if not isValidNumber(price) or price < 0 or data.Dopamine < price then
		return false, T(player, "Not enough %s", Config.Game.CurrencyName)
	end
	data.Dopamine -= price
	local room = newRoom(house, typeId, slot)
	table.insert(house.Rooms, room)
	services.GameService:SendState(player)
	local roomType = Formulas.GetRoomType(typeId)
	return true, T(player, "%s New room: %s! (%s)", roomType.Icon, T(player, roomType.Name), NumberFormatter.Format(price))
end

-- Déplace une pièce dans la grille (échange avec la pièce déjà là)
local function moveRoom(player: Player, data, argument: any): (boolean, string)
	if type(argument) ~= "table" then
		return false, T(player, "Invalid request")
	end
	local house = data.House
	local room = findRoom(house, argument.Room)
	local slot = argument.Slot
	local size = Formulas.GetHouseSize(data)
	if not room or not isValidNumber(slot) or slot % 1 ~= 0 or slot < 1 or slot > size.MaxRooms then
		return false, T(player, "Invalid request")
	end
	if room.Slot == slot then
		return true, T(player, "🏠 Room moved")
	end
	local other = roomAtSlot(house, slot)
	if other then
		other.Slot = room.Slot
	end
	room.Slot = slot
	services.GameService:SendState(player)
	return true, T(player, "🏠 Room moved")
end

-- Change le type d'une pièce (gratuit ; les objets restent)
local function setRoomType(player: Player, data, argument: any): (boolean, string)
	if type(argument) ~= "table" then
		return false, T(player, "Invalid request")
	end
	local room = findRoom(data.House, argument.Room)
	local typeId = argument.Type
	if not room or type(typeId) ~= "string" or not Config.HouseRoomTypesById[typeId] then
		return false, T(player, "Invalid request")
	end
	-- (v9.3) Types de pièces verrouillés par les visites à l'océan
	local wanted = Config.HouseRoomTypesById[typeId]
	if room.Type ~= typeId and not Formulas.IsHouseEntryUnlocked(data, wanted) then
		return false, T(player, "🔒 Unlocked after %d visits to the ocean", Formulas.GetHouseRequiredRebirths(wanted))
	end
	local oldType = room.Type
	room.Type = typeId
	-- (v9.6) le look du nouveau type (murs, sol, boiseries, ambiance), sauf
	-- ce que le joueur a choisi à la main
	if oldType ~= typeId then
		applyTypeStyles(room, oldType)
	end
	updateComfortStat(data)
	services.GameService:SendState(player)
	local roomType = Formulas.GetRoomType(typeId)
	return true, T(player, "%s This room is now: %s", roomType.Icon, T(player, roomType.Name))
end

-- Papier peint et sol : même logique (kind = "Wallpaper" | "Floor")
local SKINS = {
	Wallpaper = {
		Lookup = Config.HouseWallpapersById,
		OwnedKey = "OwnedWallpapers",
		Unknown = "Unknown wallpaper",
		AlreadyOwned = "You already own this wallpaper",
		NotOwned = "You don't own this wallpaper",
		Bought = "🎨 %s %s wallpaper bought! (%s)",
		Applied = "🎨 %s %s wallpaper applied",
	},
	Floor = {
		Lookup = Config.HouseFloorsById,
		OwnedKey = "OwnedFloors",
		Unknown = "Unknown floor",
		AlreadyOwned = "You already own this floor",
		NotOwned = "You don't own this floor",
		Bought = "🧱 %s %s floor bought! (%s)",
		Applied = "🧱 %s %s floor applied",
	},
}

-- Argument d'un style : { Room, Id } (ou Id seul = 1re pièce)
local function skinTarget(house, argument: any): (any, any)
	if type(argument) == "string" then
		return house.Rooms[1], argument
	end
	if type(argument) == "table" and type(argument.Id) == "string" and #argument.Id <= MAX_ID_LENGTH then
		return findRoom(house, argument.Room), argument.Id
	end
	return nil, nil
end

local function buySkin(player: Player, data, kind: string, argument: any): (boolean, string)
	local skin = SKINS[kind]
	local house = data.House
	local room, id = skinTarget(house, argument)
	if not room or not id then
		return false, T(player, "Invalid request")
	end
	local entry = skin.Lookup[id]
	if not entry then
		return false, T(player, skin.Unknown)
	end
	local owned = house[skin.OwnedKey]
	if owned[id] then
		return false, T(player, skin.AlreadyOwned)
	end
	-- (v9.6) le look du type de la pièce : gratuit pour elle (rien à acheter)
	if isTypeStyle(room, kind, id) then
		room[kind] = id
		markCustom(room, kind, id)
		services.GameService:SendState(player)
		return true, T(player, skin.Applied, entry.Icon or "", T(player, entry.Name))
	end
	if not Formulas.IsHouseEntryUnlocked(data, entry) then
		return false, T(player, "🔒 Unlocked after %d visits to the ocean", Formulas.GetHouseRequiredRebirths(entry))
	end
	if not isValidNumber(entry.Cost) or entry.Cost < 0 or data.Dopamine < entry.Cost then
		return false, T(player, "Not enough %s", Config.Game.CurrencyName)
	end
	data.Dopamine -= entry.Cost
	owned[id] = true
	room[kind] = id -- appliqué tout de suite à la pièce
	markCustom(room, kind, id)
	services.GameService:SendState(player)
	return true, T(player, skin.Bought, entry.Icon or "", T(player, entry.Name), NumberFormatter.Format(entry.Cost))
end

local function setSkin(player: Player, data, kind: string, argument: any): (boolean, string)
	local skin = SKINS[kind]
	local house = data.House
	local room, id = skinTarget(house, argument)
	if not room or not id then
		return false, T(player, "Invalid request")
	end
	local entry = skin.Lookup[id]
	if not entry then
		return false, T(player, skin.Unknown)
	end
	if not house[skin.OwnedKey][id] and not isTypeStyle(room, kind, id) then
		return false, T(player, skin.NotOwned)
	end
	room[kind] = id
	markCustom(room, kind, id)
	services.GameService:SendState(player)
	return true, T(player, skin.Applied, entry.Icon or "", T(player, entry.Name))
end

-- Vérifie une liste d'objets posés venue du client (vraie liste 1..n)
local function readPlacedList(player: Player, list: any, maxItems: number, rebirths: number, roomWpx: number?): ({ any }?, string?)
	if type(list) ~= "table" then
		return nil, T(player, "Invalid request")
	end
	local count = 0
	for key in pairs(list) do
		count += 1
		if count > maxItems then
			return nil, T(player, "Too many items in this room (max %d)", maxItems)
		end
		if type(key) ~= "number" or key % 1 ~= 0 or key < 1 then
			return nil, T(player, "Invalid request")
		end
	end
	local result = {}
	for index = 1, count do
		local entry = list[index]
		if type(entry) ~= "table" then
			return nil, T(player, "Invalid request")
		end
		local id = entry.I
		if type(id) ~= "string" or #id > MAX_ID_LENGTH then
			return nil, T(player, "Invalid request")
		end
		local item = Config.HouseItemsById[id]
		if not item then
			return nil, T(player, "Unknown house item")
		end
		table.insert(result, normalizeEntry(entry, item, rebirths, roomWpx))
	end
	return result, nil
end

-- Nouvelle disposition de une ou plusieurs pièces (déplacer un objet d'une
-- pièce à l'autre = les deux pièces dans le même envoi). Tout est vérifié,
-- puis les listes REMPLACENT les anciennes.
local function saveLayout(player: Player, data, argument: any): (boolean, string)
	if type(argument) ~= "table" then
		return false, T(player, "Invalid request")
	end
	local house = data.House
	local size = Formulas.GetHouseSize(data)
	local lists = argument.Rooms
	if lists == nil and argument.Room ~= nil then
		lists = { [argument.Room] = argument.Placed }
	end
	if type(lists) ~= "table" then
		return false, T(player, "Invalid request")
	end

	local updates = {}
	local count = 0
	for roomId, list in pairs(lists) do
		count += 1
		if count > size.MaxRooms then
			return false, T(player, "Invalid request")
		end
		local room = findRoom(house, roomId)
		if not room then
			return false, T(player, "Unknown room")
		end
		local placed, message = readPlacedList(player, list, size.RoomItems, numberOr(data.Rebirths, 0), WorldLayout.RoomWidthPx(size))
		if not placed then
			return false, message or T(player, "Invalid request")
		end
		updates[room] = placed
	end

	-- Exemplaires posés, toutes pièces confondues (nouvelles listes comprises)
	local used = {}
	for _, room in ipairs(house.Rooms) do
		for _, entry in ipairs(updates[room] or room.Placed) do
			used[entry.I] = (used[entry.I] or 0) + 1
		end
	end
	for id, n in pairs(used) do
		if n > (house.Items[id] or 0) then
			local item = Config.HouseItemsById[id]
			return false, T(player, "You don't own enough %s %s", item.Icon, T(player, item.Name))
		end
	end

	for room, placed in pairs(updates) do
		room.Placed = placed
	end
	updateComfortStat(data)
	services.GameService:SendState(player)
	return true, T(player, "🏠 Layout saved")
end

----------------------------------------------------------------------
-- (v9.1) Personnalisation : boiseries, ambiance, vue (par pièce), façade,
-- toit, motif du toit (maison), déco du jardin (liste)
----------------------------------------------------------------------

-- Argument { Kind, Id, Room?, On? } -> (définition du genre, entrée, pièce?)
local function lookTarget(house, argument: any)
	if type(argument) ~= "table" or type(argument.Kind) ~= "string" or type(argument.Id) ~= "string"
		or #argument.Id > MAX_ID_LENGTH then
		return nil, nil, nil
	end
	local def = LOOK_KINDS[argument.Kind]
	if not def then
		return nil, nil, nil
	end
	local entry = def.ById[argument.Id]
	local room = nil
	if def.Scope == "Room" then
		room = if argument.Room == nil then house.Rooms[1] else findRoom(house, argument.Room)
	end
	return def, entry, room
end

-- Applique une entrée possédée ; Garden : On (défaut true) pose / range
local function applyLook(player: Player, house, def, entry, room, on: boolean, slots: number?): (boolean, string?)
	if def.Scope == "Room" then
		room[def.Field] = entry.Id
		if table.find(TYPE_STYLE_KINDS, def.Field) then
			markCustom(room, def.Field, entry.Id)
		end
	elseif def.Scope == "House" then
		house[def.Field] = entry.Id
	else
		local index = table.find(house.Garden, entry.Id)
		local maxSlots = slots or GARDEN_SLOTS -- (v9.8 GARDEN98 : agrandissements du jardin)
		if on and not index then
			if #house.Garden >= maxSlots then
				return false, T(player, "Your garden is full (max %d): put something away first", maxSlots)
			end
			table.insert(house.Garden, entry.Id)
		elseif not on and index then
			table.remove(house.Garden, index)
		end
	end
	return true, nil
end

local function buyLook(player: Player, data, argument: any): (boolean, string)
	local house = data.House
	local def, entry, room = lookTarget(house, argument)
	if not def then
		return false, T(player, "Invalid request")
	end
	if not entry then
		return false, T(player, "Unknown style")
	end
	if def.Scope == "Room" and not room then
		return false, T(player, "Unknown room")
	end
	local owned = house[def.Owned]
	if owned[entry.Id] then
		return false, T(player, "You already own this style")
	end
	-- (v9.6) le look du type de la pièce : gratuit pour elle
	if def.Scope == "Room" and isTypeStyle(room, def.Field, entry.Id) then
		applyLook(player, house, def, entry, room, true)
		services.GameService:SendState(player)
		return true, T(player, "🎨 %s %s applied", entry.Icon or "", T(player, entry.Name))
	end
	if not Formulas.IsHouseEntryUnlocked(data, entry) then
		return false, T(player, "🔒 Unlocked after %d visits to the ocean", Formulas.GetHouseRequiredRebirths(entry))
	end
	local cost = entry.Cost
	if not isValidNumber(cost) or cost < 0 or data.Dopamine < cost then
		return false, T(player, "Not enough %s", Config.Game.CurrencyName)
	end
	data.Dopamine -= cost
	owned[entry.Id] = true
	-- appliqué tout de suite (jardin plein : acheté quand même, rangé)
	applyLook(player, house, def, entry, room, true, gardenSlots(data))
	services.GameService:SendState(player)
	return true, T(player, "🎨 %s %s is yours! (%s)", entry.Icon or "", T(player, entry.Name), NumberFormatter.Format(cost))
end

local function setLook(player: Player, data, argument: any): (boolean, string)
	local house = data.House
	local def, entry, room = lookTarget(house, argument)
	if not def then
		return false, T(player, "Invalid request")
	end
	if not entry then
		return false, T(player, "Unknown style")
	end
	if def.Scope == "Room" and not room then
		return false, T(player, "Unknown room")
	end
	if not house[def.Owned][entry.Id] and not (def.Scope == "Room" and isTypeStyle(room, def.Field, entry.Id)) then
		return false, T(player, "You don't own this style yet")
	end
	local ok, message = applyLook(player, house, def, entry, room, argument.On ~= false, gardenSlots(data))
	if not ok then
		return false, message or T(player, "Invalid request")
	end
	services.GameService:SendState(player)
	return true, T(player, "🎨 %s %s applied", entry.Icon or "", T(player, entry.Name))
end

----------------------------------------------------------------------
-- (v9.8 HOUSE98) 💡 Interrupteur et 🪟 rideaux de chaque pièce (maison 3D)
-- Données : room.LightsOff = true (lumières éteintes) / room.CurtainsClosed
-- = true (rideaux fermés) ; absent = allumées / ouverts (anciennes
-- sauvegardes). Copie répliquée pour la ville (tous les clients voient la
-- même maison) : attributs du joueur "HouseLightsOff" / "HouseCurtainsClosed"
-- = Id des pièces concernées séparés par des virgules ("R1,R4").
----------------------------------------------------------------------
local TOGGLE_INTERVAL = 0.25 -- secondes entre deux clics d'interrupteur / de rideaux

local function publishRoomStates(player: Player, data)
	local house = type(data) == "table" and data.House or nil
	if type(house) ~= "table" or type(house.Rooms) ~= "table" then
		return
	end
	local off, closed = {}, {}
	for _, room in ipairs(house.Rooms) do
		if type(room) == "table" and type(room.Id) == "string" then
			if room.LightsOff == true then
				table.insert(off, room.Id)
			end
			if room.CurtainsClosed == true then
				table.insert(closed, room.Id)
			end
		end
	end
	pcall(function()
		player:SetAttribute("HouseLightsOff", table.concat(off, ","))
		player:SetAttribute("HouseCurtainsClosed", table.concat(closed, ","))
	end)
end

-- "setRoomState" { Room = id, LightsOn = bool? , CurtainsOpen = bool? }
local function setRoomState(player: Player, data, argument: any): (boolean, string)
	if type(argument) ~= "table" then
		return false, T(player, "Invalid request")
	end
	-- (limite séparée pour l'interrupteur et pour les rideaux)
	if not RateLimiter.Check(player, if argument.LightsOn ~= nil then "HouseToggleL" else "HouseToggleC", TOGGLE_INTERVAL) then
		return false, T(player, "Slow down!")
	end
	local room = findRoom(data.House, argument.Room)
	if not room then
		return false, T(player, "Invalid request")
	end
	local lights, curtains = argument.LightsOn, argument.CurtainsOpen
	if (lights ~= nil and type(lights) ~= "boolean") or (curtains ~= nil and type(curtains) ~= "boolean") or (lights == nil and curtains == nil) then
		return false, T(player, "Invalid request")
	end
	if lights ~= nil then
		room.LightsOff = lights == false or nil
	end
	if curtains ~= nil then
		room.CurtainsClosed = curtains == false or nil
	end
	publishRoomStates(player, data)
	return true, ""
end

----------------------------------------------------------------------
-- (v10 HOUSE10) 🏡 Extérieur personnalisé (Shared/HouseOptions)
----------------------------------------------------------------------

-- Attribut répliqué pour la ville (HouseBuilder le lit sur le propriétaire)
local function publishExterior(player: Player, data)
	local house = type(data) == "table" and data.House or nil
	if type(house) ~= "table" or not HouseOptions then
		return
	end
	pcall(function()
		player:SetAttribute("HouseExt", HouseOptions.Encode(house.Ext))
	end)
end

-- "saveExterior" { [Kind] = Id, Num = n } : tout ou rien (projet invalide,
-- verrou des visites à l'océan ou pas assez de Dopamine = rien ne change)
local function saveExterior(player: Player, data, argument: any): (boolean, string)
	if type(argument) ~= "table" or not HouseOptions then
		return false, T(player, "Invalid request")
	end
	local house = data.House
	local owned = HouseOptions.CleanOwned(house.OwnedExt)
	local design: { [string]: any } = {}
	local count = 0
	for key, value in pairs(argument) do
		count += 1
		if count > 64 or type(key) ~= "string" then
			return false, T(player, "Invalid request")
		end
		if key == "Num" then
			if value ~= nil and type(value) ~= "number" then
				return false, T(player, "Invalid request")
			end
			design.Num = HouseOptions.ValidNumber(value)
		else
			local def = HouseOptions.ByKind[key]
			if not def or type(value) ~= "string" or not def.ById[value] then
				return false, T(player, "Unknown style")
			end
			design[key] = value
		end
	end
	local rebirths = numberOr(data.Rebirths, 0)
	local cost, toBuy, locked = HouseOptions.Quote(design, owned, rebirths)
	if locked then
		return false, T(player, "🔒 Unlocked after %d visits to the ocean", locked.Choice.Rebirths)
	end
	if not isValidNumber(cost) or cost < 0 or data.Dopamine < cost then
		return false, T(player, "Not enough %s", Config.Game.CurrencyName)
	end
	data.Dopamine -= cost
	for _, entry in ipairs(toBuy) do
		owned[HouseOptions.OwnedKey(entry.Kind, entry.Choice.Id)] = true
	end
	house.OwnedExt = owned
	house.Ext = HouseOptions.Sanitize(design, owned)
	publishExterior(player, data)
	services.GameService:SendState(player)
	if cost > 0 then
		return true, T(player, "🏡 New look for your house! (%s)", NumberFormatter.Format(cost))
	end
	return true, T(player, "🏡 New look for your house!")
end

local STRING_ACTIONS = { buyItem = true, buySize = true, setSize = true }

local function onHouse(player: Player, action: any, argument: any)
	if type(action) ~= "string" or #action > 32 then
		return false, T(player, "Invalid request")
	end
	local isLayout = action == "saveLayout"
	if isLayout then
		if not RateLimiter.Check(player, "HouseLayout", LAYOUT_INTERVAL) then
			return false, T(player, "Slow down!")
		end
	elseif not RateLimiter.Check(player, "House", BUY_INTERVAL) then
		return false, T(player, "Slow down!")
	end
	local data = services.DataService:GetData(player)
	if not data or not services.GameService:IsReady(player) then
		return false, T(player, "Loading...")
	end
	if isLayout then
		return saveLayout(player, data, argument)
	end

	if STRING_ACTIONS[action] then
		if type(argument) ~= "string" or #argument == 0 or #argument > MAX_ID_LENGTH then
			return false, T(player, "Invalid request")
		end
		if action == "buyItem" then
			return buyItem(player, data, argument)
		elseif action == "buySize" then
			return buySize(player, data, argument)
		end
		return setSize(player, data, argument)
	end
	if type(argument) ~= "string" and type(argument) ~= "table" then
		return false, T(player, "Invalid request")
	end
	if action == "buyRoom" then
		return buyRoom(player, data, argument)
	elseif action == "moveRoom" then
		return moveRoom(player, data, argument)
	elseif action == "setRoomType" then
		return setRoomType(player, data, argument)
	elseif action == "buyWallpaper" then
		return buySkin(player, data, "Wallpaper", argument)
	elseif action == "setWallpaper" then
		return setSkin(player, data, "Wallpaper", argument)
	elseif action == "buyFloor" then
		return buySkin(player, data, "Floor", argument)
	elseif action == "setFloor" then
		return setSkin(player, data, "Floor", argument)
	elseif action == "buyLook" then
		return buyLook(player, data, argument)
	elseif action == "setLook" then
		return setLook(player, data, argument)
	elseif action == "setRoomState" then
		return setRoomState(player, data, argument)
	elseif action == "saveExterior" then
		return saveExterior(player, data, argument)
	end
	return false, T(player, "Invalid request")
end

----------------------------------------------------------------------
-- Cycle de vie
----------------------------------------------------------------------

function HouseService:PlayerReady(player: Player, data)
	sanitizeHouse(data)
	publishRoomStates(player, data) -- (v9.8 HOUSE98) 💡 / 🪟 pour la ville
	publishExterior(player, data) -- (v10 HOUSE10) 🏡 extérieur pour la ville
end

function HouseService:Start()
	Net.Function("House").OnServerInvoke = function(player: Player, action: any, argument: any)
		local ok, success, message = pcall(onHouse, player, action, argument)
		if not ok then
			warn("[HouseService] Erreur pour " .. player.Name .. " :", success)
			return false, T(player, "Invalid request")
		end
		return success, message
	end
end

return HouseService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="372">
        <Properties>
          <string name="Name">ImpactService</string>
          <string name="Source"><![CDATA[--[[
	ImpactService (ModuleScript)
	Emplacement : ServerScriptService > Services > ImpactService

	💥 v10 (PHYS10) : collisions réalistes + "se faire renverser" (façon
	dessin animé : on tombe, étoiles, on se relève ; jamais de mort, jamais de
	perte de vie). Règles et chiffres : Shared/ImpactRules.

	  - GROUPES DE COLLISION : enregistre "Riders" et "Ragdoll" et applique la
	    matrice complète (ImpactRules.MATRIX) ; CarService règle déjà
	    avatars <-> voitures et voitures <-> voitures (collision : OUI).
	  - VOITURES DES JOUEURS (et tout modèle étiqueté "DopamineMover" par
	    CollectionService : voitures IA des courses…) : le SERVEUR détecte le
	    choc (20 fois / s) avec la vitesse de la voiture ; >= 12 studs/s ->
	    RENVERSÉ, >= 4,5 -> titube. Le propriétaire n'est jamais renversé par
	    sa propre voiture ; un avatar assis (conducteur, manège) non plus.
	  - RAGDOLL CÔTÉ SERVEUR (répliqué : tout le monde voit le corps tomber) :
	    Motor6D coupés + BallSocket / charnières (ImpactRules.Ragdoll), puis le
	    client du joueur (propriétaire réseau) passe l'Humanoid en "Physics"
	    et donne l'élan. Le client relève le personnage ("up") ; le serveur
	    restaure EXACTEMENT les articulations (et d'office après 6 s).
	  - CIRCULATION (voitures d'ambiance : côté client) : le client détecte et
	    tombe tout de suite, puis PRÉVIENT le serveur ("traffic") qui vérifie
	    (vitesse plausible, recharge, zone sûre, en ville, pas assis) et fait
	    le ragdoll répliqué + les étoiles pour les autres.
	  - ANTI-ABUS : pas de nouveau renversement moins de 3 s après s'être
	    relevé, jamais dans une zone sûre (scène de la place, intérieurs des
	    boutiques, attribut SafeZone), remote limité en fréquence.

	Attributs du PERSONNAGE (répliqués ; chaque client anime les autres) :
	  DopaKnockAt = heure serveur du renversement (étoiles)
	  DopaUpAt    = heure serveur où il se relève ; DopaUpFace = sur le dos ?
	  DopaStumbleAt / DopaStumbleDir = titubement (heure, direction monde)

	RemoteEvent "Impact" :
	  S -> C ("knock", élan: Vector3, rotation: Vector3, vitesse)   renversé
	         ("stumble", poussée: Vector3, direction: Vector3)       titube
	  C -> S ("traffic", "knock" | "stumble", vitesseVoiture: Vector3, dir: Vector3)
	         ("up", surLeDos: boolean)                               relevé
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local PhysicsService = game:GetService("PhysicsService")
local CollectionService = game:GetService("CollectionService")

local Net = require(ReplicatedStorage.Shared.Net)
local ImpactRules = require(ReplicatedStorage.Shared.ImpactRules)
local RateLimiter = require(script.Parent.RateLimiter)

local ImpactService = {}

ImpactService.CHECK_INTERVAL = 0.05 -- (s) détection des chocs (20 Hz)
ImpactService.ZONE_REFRESH = 5 -- (s) zones sûres relues
ImpactService.MOVER_TAG = "DopamineMover"
ImpactService.LATENCY_AHEAD = 0.08 -- (s) anticipation (positions répliquées en retard)

type Victim = {
	Down: boolean,
	KnockAt: number?,
	UpAt: number?,
	StumbleAt: number?,
	Ragdoll: any,
	Character: Model?,
}

local services: any = nil
local victims: { [Player]: Victim } = {}
local zones: { ImpactRules.Zone } = {}
local zonesAt = -math.huge
local movers: { [Instance]: { Pos: Vector3, T: number, Vel: Vector3 } } = setmetatable({} :: any, { __mode = "k" })
local remote: RemoteEvent? = nil

----------------------------------------------------------------------
-- Outils
----------------------------------------------------------------------

local function now(): number
	return workspace:GetServerTimeNow()
end

local function T(player: Player, text: string, ...): string
	if services and services.GameService then
		return services.GameService:T(player, text, ...)
	end
	if select("#", ...) > 0 then
		return string.format(text, ...)
	end
	return text
end

local function toast(player: Player, text: string)
	pcall(function()
		Net.Event("WorldEvent"):FireClient(player, "Toast", text)
	end)
end

local function victimOf(player: Player): Victim
	local v = victims[player]
	if not v then
		v = { Down = false }
		victims[player] = v
	end
	return v
end

local function isFinite(v: Vector3): boolean
	return v.X == v.X and v.Y == v.Y and v.Z == v.Z and math.abs(v.X) < 1e6 and math.abs(v.Y) < 1e6 and math.abs(v.Z) < 1e6
end

local function characterOf(player: Player): (Model?, Humanoid?, BasePart?)
	local character = player.Character
	if not character or not character.Parent then
		return nil, nil, nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
		return nil, nil, nil
	end
	return character, humanoid, root
end

local function inTown(player: Player): boolean
	local world = services and services.WorldService
	if world and world.IsInTown then
		return world:IsInTown(player)
	end
	return true
end

local function refreshZones()
	local t = os.clock()
	if t - zonesAt < ImpactService.ZONE_REFRESH then
		return
	end
	zonesAt = t
	local ok, list = pcall(ImpactRules.CollectSafeZones, workspace:FindFirstChild("DopamineTown"))
	if ok then
		zones = list
	end
end

----------------------------------------------------------------------
-- Renverser / relever
----------------------------------------------------------------------

local function standUp(player: Player, faceUp: boolean?)
	local v = victims[player]
	if not v or not v.Down then
		return
	end
	v.Down = false
	v.UpAt = now()
	pcall(ImpactRules.Restore, v.Ragdoll)
	v.Ragdoll = nil
	local character = v.Character
	if character and character.Parent then
		pcall(function()
			character:SetAttribute("DopaUpFace", faceUp == true)
			character:SetAttribute("DopaUpAt", v.UpAt)
		end)
	end
end
ImpactService.StandUp = standUp

-- Peut-on toucher ce joueur (en ville, debout, hors zone sûre) ?
local function eligible(player: Player): (boolean, Model?, Humanoid?, BasePart?)
	local character, humanoid, root = characterOf(player)
	if not character or not humanoid or not root then
		return false, nil, nil, nil
	end
	if not inTown(player) then
		return false, nil, nil, nil
	end
	if humanoid.SeatPart ~= nil or humanoid.Sit then
		return false, nil, nil, nil
	end
	refreshZones()
	if ImpactRules.InSafeZone(root.Position, zones) then
		return false, nil, nil, nil
	end
	return true, character, humanoid, root
end

-- Renverse `player` (ragdoll répliqué). notify : prévenir son client (choc
-- détecté par le serveur ; pour la circulation, le client est déjà tombé).
function ImpactService.Knock(player: Player, dir: Vector3, speed: number, notify: boolean, driver: Player?): boolean
	local ok, character, _humanoid, root = eligible(player)
	if not ok or not character or not root then
		return false
	end
	local v = victimOf(player)
	local t = now()
	if not ImpactRules.CanKnock(v, t) then
		return false
	end
	local state = ImpactRules.Ragdoll(character, { Local = false })
	v.Down = true
	v.KnockAt = t
	v.UpAt = nil
	v.Ragdoll = state
	v.Character = character
	pcall(function()
		character:SetAttribute("DopaUpAt", nil)
		character:SetAttribute("DopaKnockAt", t)
	end)
	if notify and remote then
		local linear, spin = ImpactRules.Impulse(dir, speed, root.AssemblyLinearVelocity)
		pcall(function()
			(remote :: RemoteEvent):FireClient(player, "knock", linear, spin, speed)
		end)
	end
	if driver and driver ~= player then
		toast(driver, T(driver, "⚠️ Careful! You knocked %s over", player.DisplayName))
	end
	-- filet : relevé d'office si le client ne répond pas
	local gen = t
	task.delay(ImpactRules.FAILSAFE, function()
		local cur = victims[player]
		if cur and cur.Down and cur.KnockAt == gen then
			standUp(player, true)
		end
	end)
	return true
end

function ImpactService.Stumble(player: Player, dir: Vector3, speed: number, notify: boolean): boolean
	local ok, character = eligible(player)
	if not ok or not character then
		return false
	end
	local v = victimOf(player)
	local t = now()
	if not ImpactRules.CanStumble(v, t) then
		return false
	end
	v.StumbleAt = t
	local flat = Vector3.new(dir.X, 0, dir.Z)
	local unit = if flat.Magnitude > 1e-3 then flat.Unit else Vector3.new(0, 0, -1)
	pcall(function()
		character:SetAttribute("DopaStumbleDir", unit)
		character:SetAttribute("DopaStumbleAt", t)
	end)
	if notify and remote then
		pcall(function()
			(remote :: RemoteEvent):FireClient(player, "stumble", ImpactRules.StumblePush(unit, speed), unit)
		end)
	end
	return true
end

----------------------------------------------------------------------
-- Détection (voitures des joueurs + modèles "DopamineMover")
----------------------------------------------------------------------

-- Boîte de collision + vitesse d'un mobile ; `owner` = son conducteur légitime
local function moverInfo(model: Instance): (CFrame?, Vector3?, Vector3?)
	local root: BasePart? = nil
	if model:IsA("BasePart") then
		root = model
	elseif model:IsA("Model") then
		root = model.PrimaryPart
	end
	if not root or not root.Parent then
		return nil, nil, nil
	end
	local cf, size = root.CFrame, root.Size
	local vel = root.AssemblyLinearVelocity
	if root.Anchored then
		-- (mobile déplacé par CFrame : vitesse = dérivée de la position)
		local t = os.clock()
		local rec = movers[root]
		if rec then
			local dt = t - rec.T
			if dt > 1e-3 then
				local raw = (cf.Position - rec.Pos) / dt
				if raw.Magnitude > 150 then
					raw = Vector3.zero -- (téléporté)
				end
				rec.Vel = rec.Vel:Lerp(raw, 0.6)
				rec.Pos = cf.Position
				rec.T = t
			end
			vel = rec.Vel
		else
			movers[root] = { Pos = cf.Position, T = t, Vel = Vector3.zero }
			vel = Vector3.zero
		end
	end
	if model:IsA("Model") then
		-- (boîte : celle de la pièce racine, au moins la taille annoncée)
		local w = tonumber(model:GetAttribute("Width"))
		local l = tonumber(model:GetAttribute("Length"))
		if w and l and (w > size.X + 0.5 or l > size.Z + 0.5) then
			size = Vector3.new(math.max(size.X, w - 0.2), size.Y, math.max(size.Z, l - 0.2))
		end
	end
	return cf, size, vel
end

local function checkMover(model: Instance, owner: Player?)
	local cf, size, vel = moverInfo(model)
	if not cf or not size or not vel or not isFinite(vel) then
		return
	end
	local speed = Vector3.new(vel.X, 0, vel.Z).Magnitude
	if speed < ImpactRules.STUMBLE_SPEED then
		return
	end
	local ahead = speed * ImpactService.LATENCY_AHEAD
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= owner then
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") and (root.Position - cf.Position).Magnitude < size.Magnitude / 2 + ahead + 6 then
				local impact, dir = ImpactRules.Contact(cf, size, vel, root.Position, root.AssemblyLinearVelocity, ahead)
				if impact and dir then
					local kind = ImpactRules.Classify(impact)
					if kind == "knock" then
						ImpactService.Knock(player, dir, impact, true, owner)
					elseif kind == "stumble" then
						ImpactService.Stumble(player, dir, impact, true)
					end
				end
			end
		end
	end
end

local function detect()
	local carService = services and services.CarService
	if carService and carService.GetCar then
		for _, player in ipairs(Players:GetPlayers()) do
			local ok, model = pcall(carService.GetCar, carService, player)
			if ok and model and model.Parent then
				checkMover(model, player)
			end
		end
	end
	local okTag, tagged = pcall(function()
		return CollectionService:GetTagged(ImpactService.MOVER_TAG)
	end)
	if okTag and type(tagged) == "table" then
		for _, model in ipairs(tagged) do
			if model:IsDescendantOf(workspace) then
				local ownerId = tonumber(model:GetAttribute("OwnerId"))
				local owner = ownerId and Players:GetPlayerByUserId(ownerId) or nil
				checkMover(model, owner)
			end
		end
	end
end

----------------------------------------------------------------------
-- Remote
----------------------------------------------------------------------

local function onImpact(player: Player, action: any, a: any, b: any, c: any)
	if type(action) ~= "string" then
		return
	end
	if action == "up" then
		if not RateLimiter.Check(player, "Impact_up", 0.3) then
			return
		end
		local v = victims[player]
		-- (au moins une seconde au sol : pas de relevé instantané)
		if v and v.Down and v.KnockAt and now() - v.KnockAt >= 1 then
			standUp(player, a == true)
		end
		return
	end
	if action ~= "traffic" then
		return
	end
	if not RateLimiter.Check(player, "Impact_traffic", 0.5) then
		return
	end
	if type(a) ~= "string" or typeof(b) ~= "Vector3" or typeof(c) ~= "Vector3" then
		return
	end
	if not isFinite(b) or not isFinite(c) then
		return
	end
	local speed = Vector3.new(b.X, 0, b.Z).Magnitude
	if speed > ImpactRules.MAX_SPEED then
		return
	end
	-- (le type annoncé doit correspondre à la vitesse)
	local kind = ImpactRules.Classify(speed)
	if a == "knock" and kind == "knock" then
		ImpactService.Knock(player, c, speed, false, nil)
	elseif a == "stumble" and (kind == "knock" or kind == "stumble") then
		ImpactService.Stumble(player, c, speed, false)
	end
end

----------------------------------------------------------------------
-- Cycle de vie
----------------------------------------------------------------------

function ImpactService:Init(allServices)
	services = allServices
end

function ImpactService:Start()
	ImpactRules.SetupGroups(PhysicsService)
	local ok, event = pcall(Net.Event, "Impact")
	if ok and event then
		remote = event
		event.OnServerEvent:Connect(function(player: Player, action: any, a: any, b: any, c: any)
			local okCall, err = pcall(onImpact, player, action, a, b, c)
			if not okCall then
				warn("[ImpactService] " .. tostring(err))
			end
		end)
	else
		warn("[ImpactService] remote \"Impact\" absent (Net.Events)")
	end
	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function(character: Model)
			-- nouveau personnage : on oublie l'ancien ragdoll (détruit avec lui)
			local v = victims[player]
			if v then
				v.Down = false
				v.Ragdoll = nil
				v.Character = character
			end
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayer(player)
	end
	local clock = 0
	RunService.Heartbeat:Connect(function(dt: number)
		clock += dt
		if clock >= ImpactService.CHECK_INTERVAL then
			clock = 0
			local okDetect, err = pcall(detect)
			if not okDetect then
				warn("[ImpactService] détection : " .. tostring(err))
			end
		end
	end)
end

function ImpactService:PlayerRemoving(player: Player)
	local v = victims[player]
	if v then
		pcall(ImpactRules.Restore, v.Ragdoll)
	end
	victims[player] = nil
end

-- (tests)
function ImpactService.Debug(): any
	return {
		Victims = victims,
		Zones = function()
			return zones
		end,
		Detect = detect,
		OnImpact = onImpact,
		RefreshZones = function()
			zonesAt = -math.huge
			refreshZones()
		end,
	}
end

return ImpactService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="373">
        <Properties>
          <string name="Name">InteractService</string>
          <string name="Source"><![CDATA[--[[
	InteractService (ModuleScript)
	Emplacement : ServerScriptService > Services > InteractService

	Interactions "satisfaisantes" avec les éléments de l'écran
	(RemoteEvent Interact, réglages dans Config.Interactions) :
	  - "Bubble", "Butter" : papier bulle / beurre croustillant. Seau de
	                 jetons (MaxPerSecond), gain = gain par clic x ClickFraction,
	                 SANS notification (le client affiche lui-même le "+X") ;
	  - "Follow"   : bouton "Suivre" du live (OneTime) : UNE fois par partie
	                 (data.LiveFollowed, remis à false à la détox), gain = X
	                 secondes de production, notification "Bonus" ; les dons
	                 du live (spawner "Donation") ne viennent qu'après ;
	  - "Spin", "Headline", "Press" : temps de recharge, gain = X secondes de
	                 production, notification "Bonus".
	Chaque interaction exige la Feature correspondante.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Net = require(ReplicatedStorage.Shared.Net)

local InteractService = {}

local services
local COOLDOWN_TOLERANCE = 0.2 -- marge (s) pour la latence réseau

-- [Player] = { Tokens = { [kind] = n }, LastRefill = { [kind] = clock }, LastUse = { [kind] = clock } }
local states = {}

-- Interactions "une seule fois par partie" : [kind] = clé booléenne dans data
local ONE_TIME_FLAGS = {
	Follow = "LiveFollowed",
}

function InteractService:Init(allServices)
	services = allServices
end

-- Seau de jetons : true si l'action est autorisée
local function takeToken(state, kind: string, perSecond: number): boolean
	local clock = os.clock()
	local tokens = state.Tokens[kind] or perSecond
	local last = state.LastRefill[kind] or clock
	tokens = math.min(perSecond, tokens + (clock - last) * perSecond)
	state.LastRefill[kind] = clock
	if tokens < 1 then
		state.Tokens[kind] = tokens
		return false
	end
	state.Tokens[kind] = tokens - 1
	return true
end

local function onInteract(player: Player, kind: any, _arg: any)
	local state = states[player]
	if not state or type(kind) ~= "string" then
		return
	end
	local settings = Config.Interactions[kind]
	if not settings then
		return
	end
	local data = services.DataService:GetData(player)
	if not data or not Formulas.HasFeature(data, settings.Feature) then
		return
	end

	local stats = services.GameService:GetStats(player)

	if settings.MaxPerSecond then
		-- Papier bulle : beaucoup de petits gains, pas de notification
		if not takeToken(state, kind, settings.MaxPerSecond) then
			return
		end
		if settings.Stat then
			data.Stats[settings.Stat] = (data.Stats[settings.Stat] or 0) + 1
		end
		services.GameService:AddDopamine(player, stats.ClickValue * (settings.ClickFraction or 1), true)
		if kind == "Bubble" then
			services.QuestService:Progress(player, "Bubbles", 1)
		end
		return
	end

	-- Une seule fois par partie (ex. s'abonner au live)
	if settings.OneTime then
		local flag = ONE_TIME_FLAGS[kind]
		if not flag or data[flag] == true then
			return -- déjà fait (ou interaction sans drapeau connu : refusée)
		end
		data[flag] = true
		local reward = Formulas.ScaledReward(stats, settings.RewardSeconds or 1, settings.MinReward or 1)
		if settings.Stat then
			data.Stats[settings.Stat] = (data.Stats[settings.Stat] or 0) + 1
		end
		services.GameService:AddDopamine(player, reward, true)
		services.GameService:SendState(player) -- le client voit tout de suite "✔ Abonné"
		services.GameService:Notify(player, {
			Type = "Bonus",
			Source = kind,
			Amount = reward,
		})
		return
	end

	-- Autres interactions : temps de recharge + notification
	local clock = os.clock()
	local last = state.LastUse[kind]
	if last and clock - last < (settings.Cooldown or 1) - COOLDOWN_TOLERANCE then
		return
	end
	state.LastUse[kind] = clock

	local reward = Formulas.ScaledReward(stats, settings.RewardSeconds or 1, settings.MinReward or 1)
	if settings.Stat then
		data.Stats[settings.Stat] = (data.Stats[settings.Stat] or 0) + 1
	end
	services.GameService:AddDopamine(player, reward, true)
	services.GameService:Notify(player, {
		Type = "Bonus",
		Source = kind,
		Amount = reward,
	})
end

function InteractService:PlayerReady(player: Player)
	states[player] = { Tokens = {}, LastRefill = {}, LastUse = {} }
end

function InteractService:PlayerRemoving(player: Player)
	states[player] = nil
end

function InteractService:Start()
	Net.Event("Interact").OnServerEvent:Connect(onInteract)
end

return InteractService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="374">
        <Properties>
          <string name="Name">LeaderboardService</string>
          <string name="Source"><![CDATA[--[[
	LeaderboardService (ModuleScript)
	Emplacement : ServerScriptService > Services > LeaderboardService

	Classement disponible pour tout le monde dès le début (pas d'amélioration) :
	  - "Global" : top de tous les serveurs sur la Dopamine totale gagnée,
	    avec un OrderedDataStore (Config.Leaderboard.StoreName) ;
	  - "GlobalRebirths" : top de tous les serveurs sur le nombre de
	    renaissances (visites à l'océan), second OrderedDataStore
	    (Config.Leaderboard.RebirthStoreName) ;
	  - "Server" : classement EN DIRECT des joueurs de ce serveur (Dopamine
	    actuelle), envoyé à tout le monde toutes les 2 secondes.
	Les deux tops mondiaux sont écrits puis relus toutes les
	Config.Leaderboard.UpdateInterval secondes (et au départ d'un joueur).

	Événement LeaderboardUpdate :
	  {
	    Global         = { { Rank, UserId, Name, Value, Rebirths? } }, -- Value = Dopamine gagnée
	    GlobalRebirths = { { Rank, UserId, Name, Value, Dopamine? } }, -- Value = renaissances
	    Server         = { { Rank, UserId, Name, Dopamine, Lifetime, Rebirths } }, -- Dopamine décroissante
	  }
	Les champs "croisés" (Rebirths d'un top Dopamine, Dopamine d'un top
	renaissances) sont remplis quand on les connaît : joueur présent, présent
	dans l'autre top, ou lu dans l'autre store (avec cache et budget).

	Astuce : un OrderedDataStore n'accepte que des entiers (max ~9.2e18),
	alors que la Dopamine peut dépasser 1e30. On stocke donc
	log10(valeur) * 1 000 000 (un entier), puis on refait l'inverse à la lecture.
	L'ordre du classement reste exactement le même. Les renaissances, elles,
	sont stockées telles quelles (entier).
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)

local LeaderboardService = {}

local services
local dopamineStore: OrderedDataStore? = nil
local rebirthStore: OrderedDataStore? = nil
local cachedTop = {} -- dernier top mondial Dopamine connu
local cachedRebirthTop = {} -- dernier top mondial renaissances connu
local nameCache = {} -- [userId] = nom
local lastSubmitted = {} -- [userId] = { Dopamine = encodé, Rebirths = entier } (évite les écritures inutiles)
local crossCache = {} -- [clé] = { Value = number?, Time = os.clock() } (valeurs lues dans l'autre store)
local lastWarn = {} -- [clé] = os.clock() du dernier avertissement

local SERVER_RANKING_INTERVAL = 2 -- secondes entre deux envois du classement du serveur
local WARN_COOLDOWN = 300 -- un même avertissement au plus toutes les 5 minutes
local MIN_GET_BUDGET = 20 -- on garde de la marge de lecture pour les sauvegardes des joueurs
local MAX_INTEGER = 2 ^ 53 -- au-delà, un entier n'est plus exact

-- Avertissement limité (évite de remplir la console dans Studio sans accès aux API)
local function warnThrottled(key: string, ...)
	local now = os.clock()
	if lastWarn[key] and now - lastWarn[key] < WARN_COOLDOWN then
		return
	end
	lastWarn[key] = now
	warn("[LeaderboardService]", ...)
end

local function openStore(name: any): OrderedDataStore?
	if type(name) ~= "string" or name == "" then
		return nil
	end
	local ok, result = pcall(function()
		return DataStoreService:GetOrderedDataStore(name)
	end)
	if ok then
		return result
	end
	warn("[LeaderboardService] Classement " .. name .. " indisponible :", result)
	return nil
end

dopamineStore = openStore(Config.Leaderboard.StoreName)
rebirthStore = openStore(Config.Leaderboard.RebirthStoreName)

local function isValidNumber(value): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function safeNumber(value): number
	return isValidNumber(value) and value or 0
end

-- Dopamine -> entier du store (log10)
local function encode(value: number): number
	return math.floor(math.log10(math.max(0, safeNumber(value)) + 1) * 1e6)
end

-- Entier du store -> Dopamine
local function decode(stored: any): number
	local number = tonumber(stored)
	if not number or not isValidNumber(number) then
		return 0
	end
	local value = 10 ^ (number / 1e6) - 1
	return isValidNumber(value) and math.max(0, value) or 0
end

-- Renaissances -> entier du store (tel quel, borné)
local function encodeRebirths(value: any): number
	return math.floor(math.clamp(safeNumber(value), 0, MAX_INTEGER))
end

local function getName(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		nameCache[userId] = player.DisplayName
		return player.DisplayName
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	if ok and type(name) == "string" then
		nameCache[userId] = name
		return name
	end
	return "Player " .. userId -- nom de secours (envoyé à tous : laissé en anglais)
end

-- Valeurs à envoyer pour un joueur (nil si ses données ne sont pas chargées)
local function readScores(player: Player): (number?, number?)
	local data = services and services.DataService:GetData(player)
	if type(data) ~= "table" then
		return nil, nil
	end
	local stats = type(data.Stats) == "table" and data.Stats or {}
	return encode(stats.LifetimeDopamine), encodeRebirths(data.Rebirths)
end

function LeaderboardService:Init(allServices)
	services = allServices
end

----------------------------------------------------------------------
-- Classement du serveur (en direct)
----------------------------------------------------------------------

local function buildServerRanking()
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local data = services.DataService:GetData(player)
		if type(data) == "table" then
			local stats = type(data.Stats) == "table" and data.Stats or {}
			table.insert(list, {
				UserId = player.UserId,
				Name = player.DisplayName,
				Dopamine = safeNumber(data.Dopamine),
				Lifetime = safeNumber(stats.LifetimeDopamine),
				Rebirths = safeNumber(data.Rebirths),
			})
		end
	end
	table.sort(list, function(a, b)
		if a.Dopamine ~= b.Dopamine then
			return a.Dopamine > b.Dopamine
		end
		if a.Lifetime ~= b.Lifetime then
			return a.Lifetime > b.Lifetime
		end
		return a.UserId < b.UserId
	end)
	for rank, entry in ipairs(list) do
		entry.Rank = rank
	end
	return list
end

-- Contenu de LeaderboardUpdate
local function buildPayload()
	return {
		Global = cachedTop,
		GlobalRebirths = cachedRebirthTop,
		Server = buildServerRanking(),
	}
end

function LeaderboardService:SendTo(player: Player)
	Net.Event("LeaderboardUpdate"):FireClient(player, buildPayload())
end

-- Envoie le classement (tops mondiaux en cache + serveur en direct) à tout le monde
function LeaderboardService:Broadcast()
	if #Players:GetPlayers() == 0 then
		return
	end
	Net.Event("LeaderboardUpdate"):FireAllClients(buildPayload())
end

----------------------------------------------------------------------
-- Classements mondiaux (OrderedDataStore)
----------------------------------------------------------------------

-- Écrit une valeur dans un store (pcall) ; vrai si réussi
local function writeScore(store: OrderedDataStore?, key: string, value: number, label: string): boolean
	if not store then
		return false
	end
	local target = store :: OrderedDataStore
	local ok, err = pcall(function()
		target:SetAsync(key, value)
	end)
	if not ok then
		warnThrottled("write" .. label, "Échec d'envoi du score (" .. label .. ") :", err)
	end
	return ok
end

-- Écrit les scores déjà lus (Dopamine encodée, renaissances) d'un joueur
local function submitScores(userId: number, dopamine: number, rebirths: number)
	local key = "P_" .. userId
	local previous = lastSubmitted[userId] or {}
	local submitted = { Dopamine = previous.Dopamine, Rebirths = previous.Rebirths }
	lastSubmitted[userId] = submitted
	if dopamine > 0 and previous.Dopamine ~= dopamine then
		if writeScore(dopamineStore, key, dopamine, "Dopamine") then
			submitted.Dopamine = dopamine
		end
	end
	-- Pas de renaissance : inutile d'encombrer le top avec des zéros
	-- (sauf si un score a déjà été écrit, pour le corriger)
	if (rebirths > 0 or previous.Rebirths ~= nil) and previous.Rebirths ~= rebirths then
		if writeScore(rebirthStore, key, rebirths, "Rebirths") then
			submitted.Rebirths = rebirths
		end
	end
end

-- Écrit les scores d'un joueur dans les deux classements
function LeaderboardService:SubmitAsync(player: Player)
	local dopamine, rebirths = readScores(player)
	if dopamine == nil or rebirths == nil then
		return
	end
	submitScores(player.UserId, dopamine, rebirths)
end

-- Lit un top (pcall) : liste { { UserId, Stored } } ou nil si échec
local function readTop(store: OrderedDataStore?, label: string): { { UserId: number, Stored: number } }?
	if not store then
		return nil
	end
	local target = store :: OrderedDataStore
	local ok, result = pcall(function()
		local pages = target:GetSortedAsync(false, Config.Leaderboard.Size)
		return pages:GetCurrentPage()
	end)
	if not ok or type(result) ~= "table" then
		warnThrottled("read" .. label, "Échec de lecture du classement (" .. label .. ") :", result)
		return nil
	end
	local list = {}
	for _, entry in ipairs(result) do
		local key = type(entry) == "table" and entry.key
		local stored = type(entry) == "table" and tonumber(entry.value)
		local userId = type(key) == "string" and tonumber(string.sub(key, 3)) or nil
		if userId and stored and stored > 0 then
			table.insert(list, { UserId = userId, Stored = stored })
		end
	end
	return list
end

-- Valeur d'un joueur dans l'autre store (cache + budget de lecture).
-- Renvoie (valeur brute ou nil, connue) : "connue" = lecture réussie
-- (valeur nil = aucun score écrit), faux = impossible de savoir pour l'instant.
local function lookupStored(store: OrderedDataStore?, label: string, userId: number): (number?, boolean)
	if not store then
		return nil, false
	end
	local cacheKey = label .. "_" .. userId
	local cached = crossCache[cacheKey]
	local cacheTime = tonumber(Config.Leaderboard.CrossLookupCacheTime) or 300
	if cached and os.clock() - cached.Time < cacheTime then
		return cached.Value, true
	end
	local budgetOk, budget = pcall(function()
		return DataStoreService:GetRequestBudgetForRequestType(Enum.DataStoreRequestType.GetAsync)
	end)
	if not budgetOk or type(budget) ~= "number" or budget < MIN_GET_BUDGET then
		if cached then
			return cached.Value, true -- valeur un peu ancienne, mieux que rien
		end
		return nil, false
	end
	local target = store :: OrderedDataStore
	local ok, value = pcall(function()
		return target:GetAsync("P_" .. userId)
	end)
	if not ok then
		warnThrottled("lookup" .. label, "Échec de lecture d'un score (" .. label .. ") :", value)
		if cached then
			return cached.Value, true
		end
		return nil, false
	end
	local number = tonumber(value)
	crossCache[cacheKey] = { Value = number, Time = os.clock() }
	return number, true
end

-- Lit les deux tops, complète les valeurs croisées, puis envoie à tout le monde
function LeaderboardService:RefreshAsync()
	local dopamineTop = readTop(dopamineStore, "Dopamine")
	local rebirthTop = readTop(rebirthStore, "Rebirths")

	-- Valeurs connues sans requête : joueurs présents et entrées de l'autre top
	local knownDopamine = {} -- [userId] = Dopamine gagnée (décodée)
	local knownRebirths = {} -- [userId] = renaissances
	for _, player in ipairs(Players:GetPlayers()) do
		local data = services.DataService:GetData(player)
		if type(data) == "table" then
			local stats = type(data.Stats) == "table" and data.Stats or {}
			knownDopamine[player.UserId] = safeNumber(stats.LifetimeDopamine)
			knownRebirths[player.UserId] = encodeRebirths(data.Rebirths)
		end
	end
	for _, entry in ipairs(dopamineTop or {}) do
		if knownDopamine[entry.UserId] == nil then
			knownDopamine[entry.UserId] = decode(entry.Stored)
		end
	end
	for _, entry in ipairs(rebirthTop or {}) do
		if knownRebirths[entry.UserId] == nil then
			knownRebirths[entry.UserId] = entry.Stored
		end
	end

	if dopamineTop then
		local top = {}
		for rank, entry in ipairs(dopamineTop) do
			local rebirths = knownRebirths[entry.UserId]
			if rebirths == nil then
				-- Absent du top renaissances : on lit son score (0 si jamais écrit)
				local stored, known = lookupStored(rebirthStore, "Rebirths", entry.UserId)
				if known then
					rebirths = stored or 0
				end
			end
			table.insert(top, {
				Rank = rank,
				UserId = entry.UserId,
				Name = getName(entry.UserId),
				Value = decode(entry.Stored),
				Rebirths = rebirths,
			})
		end
		cachedTop = top
	end

	if rebirthTop then
		local top = {}
		for rank, entry in ipairs(rebirthTop) do
			local dopamine = knownDopamine[entry.UserId]
			if dopamine == nil then
				local stored, known = lookupStored(dopamineStore, "Dopamine", entry.UserId)
				if known then
					dopamine = stored and decode(stored) or 0
				end
			end
			table.insert(top, {
				Rank = rank,
				UserId = entry.UserId,
				Name = getName(entry.UserId),
				Value = entry.Stored,
				Dopamine = dopamine,
			})
		end
		cachedRebirthTop = top
	end

	self:Broadcast()
end

function LeaderboardService:PlayerRemoving(player: Player)
	-- Scores lus tout de suite (les données sont libérées juste après)
	local userId = player.UserId
	local dopamine, rebirths = readScores(player)
	if dopamine == nil or rebirths == nil then
		lastSubmitted[userId] = nil
		return
	end
	task.spawn(function()
		submitScores(userId, dopamine, rebirths)
		lastSubmitted[userId] = nil
	end)
end

function LeaderboardService:Start()
	-- Classement du serveur en direct
	task.spawn(function()
		while true do
			task.wait(SERVER_RANKING_INTERVAL)
			local ok, err = pcall(self.Broadcast, self)
			if not ok then
				warn("[LeaderboardService] Échec d'envoi du classement du serveur :", err)
			end
		end
	end)

	-- Classements mondiaux (OrderedDataStore)
	task.spawn(function()
		task.wait(5) -- laisse le temps aux premiers joueurs de charger
		while true do
			local ok, err = pcall(function()
				for _, player in ipairs(services.DataService:GetLoadedPlayers()) do
					self:SubmitAsync(player)
				end
				self:RefreshAsync()
			end)
			if not ok then
				warn("[LeaderboardService] Erreur du classement mondial :", err)
			end
			task.wait(Config.Leaderboard.UpdateInterval)
		end
	end)
end

return LeaderboardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="375">
        <Properties>
          <string name="Name">LootService</string>
          <string name="Source"><![CDATA[--[[
	LootService (ModuleScript)
	Emplacement : ServerScriptService > Services > LootService

	Coffre mystère (débloqué par l'amélioration "Coffre mystère") :
	  - se remplit avec le temps de jeu (Charge, appelé par le tick passif
	    de GameService) : 1 coffre toutes les ChargeInterval secondes, au
	    maximum MaxStored coffres en réserve ;
	  - le joueur l'ouvre avec la RemoteFunction OpenChest : le serveur tire
	    la rareté (poids de Config.LootBox.Tiers) et donne la récompense.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Locale = require(ReplicatedStorage.Shared.Locale)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Net = require(ReplicatedStorage.Shared.Net)
local RateLimiter = require(script.Parent.RateLimiter)

local LootService = {}

local services
local random = Random.new()
local settings = Config.LootBox

function LootService:Init(allServices)
	services = allServices
end

-- Remplit la jauge du coffre (appelé à chaque tick passif)
function LootService:Charge(player: Player, data, elapsed: number)
	if not Formulas.HasFeature(data, settings.Feature) then
		return
	end
	local chests = data.Chests
	if chests.Stored >= settings.MaxStored then
		chests.Progress = 0
		return
	end
	chests.Progress += elapsed / settings.ChargeInterval
	while chests.Progress >= 1 and chests.Stored < settings.MaxStored do
		chests.Progress -= 1
		chests.Stored += 1
	end
	if chests.Stored >= settings.MaxStored then
		chests.Progress = 0
	end
	services.GameService:MarkDirty(player)
end

-- Ajoute des coffres (commande de test /chest)
function LootService:AddChests(player: Player, count: number)
	local data = services.DataService:GetData(player)
	if not data then
		return
	end
	data.Chests.Stored = math.clamp(data.Chests.Stored + count, 0, settings.MaxStored)
	services.GameService:MarkDirty(player)
end

-- Tire une rareté selon les poids
local function pickTier()
	local total = 0
	for _, tier in ipairs(settings.Tiers) do
		total += tier.Weight
	end
	local roll = random:NextNumber(0, total)
	for _, tier in ipairs(settings.Tiers) do
		roll -= tier.Weight
		if roll <= 0 then
			return tier
		end
	end
	return settings.Tiers[1]
end

-- Texte dans la langue du joueur
local function T(player: Player, text: string, ...): string
	return services.GameService:T(player, text, ...)
end

local function onOpen(player: Player)
	local data = services.DataService:GetData(player)
	if not data or not services.GameService:IsReady(player) then
		return false, T(player, "Loading...")
	end
	if not Formulas.HasFeature(data, settings.Feature) then
		return false, T(player, "The mystery chest isn't unlocked yet")
	end
	if data.Chests.Stored < 1 then
		return false, T(player, "No chests to open, be patient...")
	end
	if not RateLimiter.Check(player, "OpenChest", settings.OpenCooldown) then
		return false, T(player, "Slow down!")
	end

	local tier = pickTier()
	local amount = Formulas.ScaledReward(services.GameService:GetStats(player), tier.RewardSeconds, 100)

	data.Chests.Stored -= 1
	data.Stats.ChestsOpened += 1
	services.GameService:AddDopamine(player, amount, true)
	services.QuestService:Progress(player, "Chests", 1)
	services.GameService:SendState(player)

	if tier.Id == "Legendary" then
		local displayName, formatted = player.DisplayName, NumberFormatter.Format(amount)
		services.GameService:NotifyAll(function(lang)
			return {
				Type = "Info",
				Text = Locale.TFor(lang, "📦 %s opened a %s chest (+%s)!", displayName, Locale.TFor(lang, tier.Name), formatted),
			}
		end, player)
	end

	return true, { Tier = tier.Id, Amount = amount }
end

function LootService:Start()
	Net.Function("OpenChest").OnServerInvoke = onOpen
end

return LootService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="376">
        <Properties>
          <string name="Name">MinigameService</string>
          <string name="Source"><![CDATA[--[[
	MinigameService (ModuleScript)
	Emplacement : ServerScriptService > Services > MinigameService

	🕹️ Arcade (amélioration "Arcade", Feature "Minigames") : mini-jeux solo,
	🎟️ tickets, 🏆 trophées et duels entre joueurs du serveur. 100 % côté serveur.

	RemoteFunction "Arcade" (action, argument) -> (succès, résultat | message) :
	  - "solo:*"    : routé vers Services > Arcade > SoloGames.Handle(player, data,
	                  action, arg, api) (jeux solo, écrits à part ; chargé avec
	                  pcall : son absence ne casse jamais l'arcade) ;
	  - "lobby"     : joueurs du serveur qui ont l'arcade, invitations, duel en cours ;
	  - "invite"    : { Target = UserId, Game = Id, Stake = 🏆 trophées } ;
	  - "cancel" / "accept" / "decline" (Id d'invitation) ;
	  - "move"      : { Id = duel, Move = coup } ; "forfeit" (abandon) ;
	  - "buy"       : Id d'un objet de la boutique à tickets ; "badge" : équipe un badge.
	    Refus faute de tickets : (false, { Text, Missing = tickets manquants,
	    Currency = "Tickets" }) -> le client propose d'en acheter (NeedTickets).
	RemoteEvent "ArcadeEvent" (S -> C) : "invite", "inviteClosed", "duelStart",
	  "duelUpdate", "duelEnd" (payload = invitation ou état du duel VU par ce joueur).

	Deux monnaies (règles Roblox : on ne mise JAMAIS une monnaie achetable) :
	  - 🎟️ tickets (data.Tickets) : boutique à tickets. Gagnés en jouant
	    (plafond par jour) ou achetés en Robux (packs : MonetizationService
	    appelle GrantPurchasedTickets). Jamais misés ;
	  - 🏆 trophées (data.Trophies) : MISES des duels. Gagnés UNIQUEMENT en
	    jouant (victoires solo / duel récompensées, plafond par jour) + un
	    cadeau de bienvenue ; jamais achetables, jamais convertibles.

	Duels :
	  - invitation d'un joueur du serveur (pas soi-même), mise identique pour
	    les deux (en 🏆, vérifiée ici pour les DEUX joueurs), délai
	    d'expiration, refus, annulation ;
	  - à l'acceptation : les deux mises sont prises (séquestre), revérifiées ;
	  - état du jeu gardé ICI : coups validés (tour, case libre...), victoire
	    détectée ici (ArcadeConfig.Logic), temps par coup, durée max ;
	  - gagnant : les deux mises (x2, en 🏆) + Dopamine (secondes de
	    production) + tickets bonus + 1 🏆 bonus (le prix NE dépend PAS de la
	    mise) ; perdant : perd sa mise ; égalité : mises rendues ;
	  - déconnexion ou abandon : le joueur qui part perd ;
	  - anti-abus : limites de duels par jour contre le MÊME joueur (et
	    récompenses limitées), cadence des invitations, pas de duel contre soi.

	data.Arcade = { Day, DayTickets, DayTrophies, DayRewards = { [jeu] = n }, DayPairs = { [UserId] = n },
	  DayPairRewards = { [UserId] = n }, DayShop = { [objet] = n }, Best = { [jeu] = record },
	  Plays / Wins / Losses / Draws = { [jeu] = n }, Badges = { [id] = true }, Badge = id,
	  History = { dernier duel en premier ; K = "T" : mise en 🏆 }, TicketsEarned, TrophiesEarned,
	  TicketsBought, Welcomed, TrophyGift }
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Formulas = require(Shared.Formulas)
local Locale = require(Shared.Locale)
local NumberFormatter = require(Shared.NumberFormatter)
local Net = require(Shared.Net)
local ArcadeConfig = require(Shared.ArcadeConfig)
local RateLimiter = require(script.Parent.RateLimiter)

local MinigameService = {}

local services
local random = Random.new()
local Logic = ArcadeConfig.Logic
local DUELS = ArcadeConfig.Duels
local TICKETS = ArcadeConfig.Tickets
local TROPHIES = ArcadeConfig.Trophies
local SECONDS_PER_DAY = 86400
local HISTORY_SIZE = 8

local arcadeEvent: RemoteEvent? = nil

-- Joueurs dont les tickets / records ont changé pendant l'action en cours (état complet à renvoyer)
local changed: { [Player]: boolean } = {}

-- Invitations : [id] = { Id, From, To, Game, Stake, ExpiresAt }
local invites = {}
-- Duels en cours : [id] = duel ; [Player] = duel
local duels = {}
local duelOf: { [Player]: any } = {}
local lastInviteAt: { [Player]: number } = {}
local declinedAt: { [Player]: { [number]: number } } = {}
local nextId = 0

----------------------------------------------------------------------
-- Utilitaires
----------------------------------------------------------------------

local function isValidNumber(value): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function T(player: Player, text: string, ...): string
	return services.GameService:T(player, text, ...)
end

local function newId(prefix: string): string
	nextId += 1
	return string.format("%s%d_%d", prefix, nextId, random:NextInteger(100, 999))
end

local function getData(player: Player)
	return services.DataService:GetData(player)
end

local function asTable(value)
	return type(value) == "table" and value or {}
end

-- Données d'arcade propres (sauvegarde abîmée corrigée) + remise à zéro des limites du jour
local function ensureArcade(data)
	local arcade = data.Arcade
	if type(arcade) ~= "table" then
		arcade = {}
		data.Arcade = arcade
	end
	if not isValidNumber(data.Tickets) or data.Tickets < 0 then
		data.Tickets = 0
	end
	data.Tickets = math.floor(math.min(data.Tickets, TICKETS.Max))
	if not isValidNumber(data.Trophies) or data.Trophies < 0 then
		data.Trophies = 0
	end
	data.Trophies = math.floor(math.min(data.Trophies, TROPHIES.Max))
	for _, key in ipairs({ "Best", "Plays", "Wins", "Losses", "Draws", "Badges", "History" }) do
		arcade[key] = asTable(arcade[key])
	end
	if type(arcade.Badge) ~= "string" or not arcade.Badges[arcade.Badge] or not ArcadeConfig.ShopById[arcade.Badge] then
		arcade.Badge = ""
	end
	for _, key in ipairs({ "TicketsEarned", "TrophiesEarned", "TicketsBought" }) do
		if not isValidNumber(arcade[key]) then
			arcade[key] = 0
		end
	end
	local day = math.floor(os.time() / SECONDS_PER_DAY)
	if arcade.Day ~= day then
		arcade.Day = day
		arcade.DayTickets = 0
		arcade.DayTrophies = 0
		arcade.DayRewards = {}
		arcade.DayPairs = {}
		arcade.DayPairRewards = {}
		arcade.DayShop = {}
	else
		arcade.DayTickets = isValidNumber(arcade.DayTickets) and arcade.DayTickets or 0
		arcade.DayTrophies = isValidNumber(arcade.DayTrophies) and arcade.DayTrophies or 0
		for _, key in ipairs({ "DayRewards", "DayPairs", "DayPairRewards", "DayShop" }) do
			arcade[key] = asTable(arcade[key])
		end
	end
	return arcade
end

local function hasArcade(player: Player): boolean
	local data = getData(player)
	return data ~= nil and services.GameService:IsReady(player) and Formulas.HasFeature(data, ArcadeConfig.Feature)
end

local function badgeIcon(data): string
	local arcade = data and data.Arcade
	local item = arcade and type(arcade.Badge) == "string" and ArcadeConfig.ShopById[arcade.Badge]
	return item and item.Icon or ""
end

local function playerInfo(player: Player)
	local data = getData(player)
	return {
		UserId = player.UserId,
		Name = player.DisplayName,
		User = player.Name,
		Badge = badgeIcon(data),
		Trophies = data and isValidNumber(data.Trophies) and math.floor(data.Trophies) or 0,
	}
end

local function fire(player: Player, kind: string, payload)
	if arcadeEvent and player.Parent == Players then
		arcadeEvent:FireClient(player, kind, payload)
	end
end

local function incr(map, key, amount: number?)
	map[key] = (tonumber(map[key]) or 0) + (amount or 1)
end

----------------------------------------------------------------------
-- Tickets, trophées, Dopamine, stats (aussi exposés aux jeux solo via `api`)
----------------------------------------------------------------------

-- Ajoute / retire des 🎟️ tickets SANS plafond du jour (achats en tickets, cadeau, packs Robux)
local function moveTickets(player: Player, amount: number): number
	local data = getData(player)
	if not data or not isValidNumber(amount) then
		return 0
	end
	ensureArcade(data)
	local before = data.Tickets
	data.Tickets = math.clamp(math.floor(before + amount), 0, TICKETS.Max)
	changed[player] = true
	return data.Tickets - before
end

-- Tickets GAGNÉS (récompenses) : plafonnés par jour. Renvoie le nombre vraiment donné.
local function grantTickets(player: Player, amount: number): number
	local data = getData(player)
	if not data then
		return 0
	end
	local arcade = ensureArcade(data)
	local granted = Logic.CappedGrant(amount, arcade.DayTickets, TICKETS.DailyCap)
	if granted <= 0 then
		return 0
	end
	granted = moveTickets(player, granted)
	arcade.DayTickets += granted
	arcade.TicketsEarned += granted
	return granted
end

-- Ajoute / retire des 🏆 trophées SANS plafond du jour (mises en séquestre, pots, remboursements, cadeau)
local function moveTrophies(player: Player, amount: number): number
	local data = getData(player)
	if not data or not isValidNumber(amount) then
		return 0
	end
	ensureArcade(data)
	local before = data.Trophies
	data.Trophies = math.clamp(math.floor(before + amount), 0, TROPHIES.Max)
	changed[player] = true
	return data.Trophies - before
end

-- Trophées GAGNÉS en jouant : plafonnés par jour. Renvoie le nombre vraiment donné.
local function grantTrophies(player: Player, amount: number): number
	local data = getData(player)
	if not data then
		return 0
	end
	local arcade = ensureArcade(data)
	local granted = Logic.CappedGrant(amount, arcade.DayTrophies, TROPHIES.DailyCap)
	if granted <= 0 then
		return 0
	end
	granted = moveTrophies(player, granted)
	arcade.DayTrophies += granted
	arcade.TrophiesEarned += granted
	return granted
end

-- Dopamine = `seconds` de production (comme les autres bonus du jeu)
local function grantDopamineSeconds(player: Player, seconds: number, countForQuests: boolean?): number
	if not isValidNumber(seconds) or seconds <= 0 or not getData(player) then
		return 0
	end
	local stats = services.GameService:GetStats(player)
	local amount = Formulas.ScaledReward(stats, math.min(seconds, 3600), ArcadeConfig.MinDopamineReward)
	if not isValidNumber(amount) or amount <= 0 then
		return 0
	end
	services.GameService:AddDopamine(player, amount, countForQuests ~= false)
	changed[player] = true
	return amount
end

local function addStat(player: Player, stat: string, amount: number?)
	local data = getData(player)
	if not data or type(stat) ~= "string" or type(data.Stats) ~= "table" then
		return
	end
	local value = amount or 1
	if not isValidNumber(value) then
		return
	end
	data.Stats[stat] = (tonumber(data.Stats[stat]) or 0) + value
	changed[player] = true
end

-- Record d'un jeu (game.Record "High" = plus grand, "Low" = plus petit) -> nouveau record ?
local function recordScore(player: Player, gameId: string, score: number): boolean
	local data = getData(player)
	local entry = ArcadeConfig.GamesById[gameId]
	if not data or not entry or not isValidNumber(score) then
		return false
	end
	local arcade = ensureArcade(data)
	local best = arcade.Best[gameId]
	local better = best == nil or (entry.Record == "Low" and score < best) or (entry.Record ~= "Low" and score > best)
	if better then
		arcade.Best[gameId] = score
		changed[player] = true
	end
	return better
end

-- Une partie récompensée de plus aujourd'hui pour ce jeu ? (consomme si oui)
local function takeDailyReward(player: Player, gameId: string): boolean
	local data = getData(player)
	local entry = ArcadeConfig.GamesById[gameId]
	if not data or not entry then
		return false
	end
	local arcade = ensureArcade(data)
	local used = tonumber(arcade.DayRewards[gameId]) or 0
	if used >= (entry.DailyRewarded or 10) then
		return false
	end
	arcade.DayRewards[gameId] = used + 1
	changed[player] = true
	return true
end

local function countPlay(player: Player, gameId: string)
	local data = getData(player)
	if not data or not ArcadeConfig.GamesById[gameId] then
		return
	end
	incr(ensureArcade(data).Plays, gameId)
	addStat(player, "MinigamesPlayed", 1)
end

-- Victoire en solo : récompense (si pas encore au plafond du jour), record, stats
local function rewardWin(player: Player, gameId: string, score: number?)
	local data = getData(player)
	local entry = ArcadeConfig.GamesById[gameId]
	local result = { Tickets = 0, Trophies = 0, Dopamine = 0, Record = false, Capped = false }
	if not data or not entry then
		return result
	end
	local arcade = ensureArcade(data)
	incr(arcade.Wins, gameId)
	if score ~= nil then
		result.Record = recordScore(player, gameId, score)
	end
	if takeDailyReward(player, gameId) then
		result.Tickets = grantTickets(player, entry.Tickets or 0)
		result.Trophies = grantTrophies(player, TROPHIES.PerSoloWin)
		result.Dopamine = grantDopamineSeconds(player, entry.RewardSeconds or 0, true)
		addStat(player, "MinigamesWon", 1)
	else
		result.Capped = true
	end
	changed[player] = true
	return result
end

-- API donnée aux jeux solo (Services > Arcade > SoloGames)
local soloApi = {
	GrantDopamineSeconds = function(player: Player, seconds: number): number
		return grantDopamineSeconds(player, seconds, true)
	end,
	GrantTickets = grantTickets,
	GrantTrophies = grantTrophies,
	AddStat = addStat,
	Notify = function(player: Player, payload)
		services.GameService:Notify(player, payload)
	end,
	T = function(player: Player, text: string, ...): string
		return T(player, text, ...)
	end,
	Now = function(): number
		return os.clock()
	end,
	Config = ArcadeConfig,
	CountPlay = countPlay,
	RecordScore = recordScore,
	TakeDailyReward = takeDailyReward,
	RewardWin = rewardWin,
}

----------------------------------------------------------------------
-- Jeux solo (module écrit à part, chargé prudemment)
----------------------------------------------------------------------

local soloModule = nil
local soloWarned = false

local function getSolo()
	if soloModule then
		return soloModule
	end
	local folder = script.Parent:FindFirstChild("Arcade")
	local moduleScript = folder and folder:FindFirstChild("SoloGames")
	if not moduleScript or not moduleScript:IsA("ModuleScript") then
		return nil
	end
	local ok, result = pcall(require, moduleScript)
	if ok and type(result) == "table" and type(result.Handle) == "function" then
		soloModule = result
		if type(result.Init) == "function" then
			pcall(result.Init, soloApi)
		end
		return result
	end
	if not soloWarned then
		soloWarned = true
		warn("[MinigameService] SoloGames indisponible :", result)
	end
	return nil
end

----------------------------------------------------------------------
-- Invitations
----------------------------------------------------------------------

local function inviteView(invite)
	return {
		Id = invite.Id,
		From = playerInfo(invite.From),
		To = playerInfo(invite.To),
		Game = invite.Game,
		Stake = invite.Stake,
		Seconds = math.max(0, math.floor(invite.ExpiresAt - os.clock() + 0.5)),
		Total = DUELS.InviteSeconds,
	}
end

local function closeInvite(invite, reason: string?)
	if invites[invite.Id] ~= invite then
		return
	end
	invites[invite.Id] = nil
	if reason then
		local payload = { Id = invite.Id, Reason = reason, From = invite.From.DisplayName, To = invite.To.DisplayName, Game = invite.Game }
		fire(invite.From, "inviteClosed", payload)
		fire(invite.To, "inviteClosed", payload)
	end
end

-- Ferme toutes les invitations d'un joueur (envoyées et reçues)
local function closeInvitesOf(player: Player, reason: string)
	for _, invite in pairs(invites) do
		if invite.From == player or invite.To == player then
			closeInvite(invite, reason)
		end
	end
end

local function outgoingOf(player: Player)
	for _, invite in pairs(invites) do
		if invite.From == player then
			return invite
		end
	end
	return nil
end

local function incomingOf(player: Player)
	local list = {}
	for _, invite in pairs(invites) do
		if invite.To == player then
			table.insert(list, invite)
		end
	end
	table.sort(list, function(a, b)
		return a.ExpiresAt < b.ExpiresAt
	end)
	return list
end

local function pairCount(data, other: Player, key: string): number
	return tonumber(ensureArcade(data)[key][tostring(other.UserId)]) or 0
end

----------------------------------------------------------------------
-- Duels : état, vue, fin
----------------------------------------------------------------------

local function gameOf(duel)
	return ArcadeConfig.GamesById[duel.Game]
end

-- État du duel vu par `viewer` (rien de secret : ni l'intrus avant la fin de manche, ni l'heure du GO)
local function snapshot(duel, viewer: Player?)
	local now = os.clock()
	local entry = gameOf(duel)
	local view = {
		Id = duel.Id,
		Game = duel.Game,
		Stake = duel.Stake,
		Pot = duel.Pot,
		You = viewer and duel.Seats[viewer] or 0,
		Players = duel.Infos,
		Turn = duel.Turn,
		TurnLeft = duel.TurnEndsAt and math.max(0, duel.TurnEndsAt - now) or nil,
		TurnSeconds = entry.TurnSeconds,
		Scores = { duel.Scores[1], duel.Scores[2] },
		WinScore = entry.WinScore,
		Round = duel.Round,
		Phase = duel.Phase,
		PhaseLeft = duel.PhaseEndsAt and math.max(0, duel.PhaseEndsAt - now) or nil,
		Moves = duel.Moves,
		Over = duel.Over,
		Winner = duel.Winner,
		Reason = duel.Reason,
	}
	if duel.Game == "TicTacToe" or duel.Game == "Connect4" then
		view.Board = duel.Board
		view.Last = duel.Last
		view.Line = duel.Line
	elseif duel.Game == "ReactionDuel" then
		view.RoundResult = duel.RoundResult
	elseif duel.Game == "SpotRace" then
		local grid = duel.Grid
		if grid then
			view.Grid = { Size = grid.Size, Cells = grid.Cells }
		end
		view.RoundResult = duel.RoundResult
		local seat = viewer and duel.Seats[viewer]
		local locked = seat and duel.Locked and duel.Locked[seat] or 0
		view.Locked = math.max(0, locked - now)
	end
	return view
end

local function broadcast(duel, kind: string)
	for _, player in ipairs(duel.Players) do
		fire(player, kind, snapshot(duel, player))
	end
end

local function pushHistory(data, entry)
	local history = ensureArcade(data).History
	table.insert(history, 1, entry)
	while #history > HISTORY_SIZE do
		table.remove(history)
	end
end

-- Fin du duel : winnerSeat = 1 | 2, ou 0 (égalité : mises rendues)
local function endDuel(duel, winnerSeat: number, reason: string)
	if duel.Over then
		return
	end
	duel.Over = true
	duel.Winner = winnerSeat
	duel.Reason = reason
	duel.Token += 1
	duel.TurnEndsAt = nil
	duel.PhaseEndsAt = nil
	duels[duel.Id] = nil
	for _, player in ipairs(duel.Players) do
		if duelOf[player] == duel then
			duelOf[player] = nil
		end
	end

	local entry = gameOf(duel)
	local results = {}
	-- Mises en 🏆 (déjà en séquestre) : gagnant x2, perdant rien, égalité rendue
	local payouts = Logic.StakePayouts(duel.Stake, winnerSeat)
	for seat, player in ipairs(duel.Players) do
		local data = getData(player)
		local other = duel.Players[3 - seat]
		-- Trophies = gain / perte de la mise ; Bonus = 🎟️ bonus ; TrophyBonus = 🏆 bonus
		local result = { Outcome = "Draw", Reason = reason, Trophies = 0, Bonus = 0, TrophyBonus = 0, Dopamine = 0, Rewarded = false }
		results[seat] = result
		if data then
			local arcade = ensureArcade(data)
			addStat(player, "MinigamesPlayed", 1)
			incr(arcade.Plays, duel.Game)
			if payouts[seat] > 0 then
				moveTrophies(player, payouts[seat])
			end
			if winnerSeat == 0 then
				incr(arcade.Draws, duel.Game)
			elseif winnerSeat == seat then
				result.Outcome = "Win"
				result.Trophies = payouts[seat] - duel.Stake
				incr(arcade.Wins, duel.Game)
				local key = tostring(other.UserId)
				local rewardedToday = tonumber(arcade.DayPairRewards[key]) or 0
				if rewardedToday < DUELS.PairRewardedPerDay and duel.Moves >= DUELS.MinMovesForReward then
					-- Prix de la victoire : identique quelle que soit la mise (même en duel amical)
					arcade.DayPairRewards[key] = rewardedToday + 1
					result.Rewarded = true
					result.Bonus = grantTickets(player, TICKETS.DuelWinBonus)
					result.TrophyBonus = grantTrophies(player, TROPHIES.PerDuelWin)
					result.Dopamine = grantDopamineSeconds(player, entry.RewardSeconds or 30, true)
					addStat(player, "MinigamesWon", 1)
					addStat(player, "DuelsWon", 1)
				end
			else
				result.Outcome = "Lose"
				result.Trophies = -duel.Stake
				incr(arcade.Losses, duel.Game)
			end
			pushHistory(data, {
				G = duel.Game,
				O = duel.Infos[3 - seat].Name,
				R = result.Outcome == "Win" and "W" or (result.Outcome == "Lose" and "L" or "D"),
				S = duel.Stake,
				K = "T", -- mise en 🏆 trophées (les anciens duels, sans K, étaient en tickets)
				T = os.time(),
			})
			changed[player] = true
		end
	end

	for seat, player in ipairs(duel.Players) do
		local view = snapshot(duel, player)
		view.Result = results[seat]
		fire(player, "duelEnd", view)
		if player.Parent == Players and services.GameService:IsReady(player) then
			changed[player] = nil
			services.GameService:SendState(player)
		end
	end

	-- Gros duel : tout le serveur est prévenu
	if winnerSeat ~= 0 and duel.Stake >= (DUELS.AnnounceStake or 5) then
		local winnerName = duel.Infos[winnerSeat].Name
		local loserName = duel.Infos[3 - winnerSeat].Name
		local pot = tostring(duel.Pot)
		local gameName = entry.Name
		services.GameService:NotifyAll(function(lang)
			return {
				Type = "Info",
				Text = Locale.TFor(lang, "⚔️ %s beat %s at %s and won %s 🏆!", winnerName, loserName, Locale.TFor(lang, gameName), pot),
			}
		end)
	end
end

-- Temps pour jouer (jeux au tour par tour) : trop lent = défaite
local function armTurn(duel)
	local entry = gameOf(duel)
	local seconds = entry.TurnSeconds or 20
	duel.Token += 1
	local token = duel.Token
	duel.TurnEndsAt = os.clock() + seconds
	task.delay(seconds + 0.35, function()
		if not duel.Over and duel.Token == token then
			endDuel(duel, 3 - duel.Turn, "timeout")
		end
	end)
end

----------------------------------------------------------------------
-- Jeux en manches (Reaction Duel, Spot Race)
----------------------------------------------------------------------

local nextRound -- (duel) déclaré plus bas

-- Fin d'une manche : points, puis manche suivante ou fin du duel
local function finishRound(duel)
	if duel.Over then
		return
	end
	local entry = gameOf(duel)
	duel.Phase = "result"
	duel.Token += 1
	local token = duel.Token
	local result = duel.RoundResult or { Winner = 0 }
	local winner = result.Winner or 0
	if winner > 0 then
		duel.Scores[winner] += 1
		duel.Moves += 1
	end
	duel.PhaseEndsAt = os.clock() + DUELS.ResultSeconds
	broadcast(duel, "duelUpdate")
	local champion = Logic.RoundsWinner(duel.Scores, entry.WinScore or 3)
	task.delay(champion > 0 and 1.4 or DUELS.ResultSeconds, function()
		if duel.Over or duel.Token ~= token then
			return
		end
		if champion > 0 then
			endDuel(duel, champion, "score")
		else
			nextRound(duel)
		end
	end)
end

-- (lecture de la phase hors du raffinement de type de l'analyseur : elle change entre deux délais)
local function phaseOf(duel): string
	return duel.Phase
end

local function maxRounds(duel): number
	return duel.Game == "ReactionDuel" and DUELS.Reaction.MaxRounds or DUELS.Spot.MaxRounds
end

-- Réaction : le premier appui valide est connu, on attend `Window` pour départager avec la latence
local function reactionResolve(duel, token: number)
	if duel.Over or duel.Token ~= token or duel.Phase ~= "go" then
		return
	end
	local t1, t2 = duel.Taps[1], duel.Taps[2]
	local winner = 0
	if t1 and (not t2 or t1 <= t2) then
		winner = 1
	elseif t2 then
		winner = 2
	end
	duel.RoundResult = { Winner = winner, Times = { t1 or -1, t2 or -1 } }
	finishRound(duel)
end

nextRound = function(duel: any)
	if duel.Over then
		return
	end
	if duel.Round >= maxRounds(duel) then
		-- Trop de manches : le meilleur score gagne, sinon égalité
		local s1, s2 = duel.Scores[1], duel.Scores[2]
		endDuel(duel, s1 > s2 and 1 or (s2 > s1 and 2 or 0), "rounds")
		return
	end
	duel.Round += 1
	duel.RoundResult = nil
	duel.Token += 1
	local token = duel.Token

	if duel.Game == "ReactionDuel" then
		local settings = DUELS.Reaction
		duel.Phase = "wait"
		duel.Taps = {}
		duel.PhaseEndsAt = nil
		broadcast(duel, "duelUpdate")
		task.delay(random:NextNumber(settings.MinDelay, settings.MaxDelay), function()
			if duel.Over or duel.Token ~= token or duel.Phase ~= "wait" then
				return
			end
			duel.Phase = "go"
			duel.GoAt = os.clock()
			broadcast(duel, "duelUpdate")
			task.delay(settings.RoundTimeout, function()
				if not duel.Over and duel.Token == token and phaseOf(duel) == "go" then
					duel.RoundResult = { Winner = 0, Void = true }
					finishRound(duel)
				end
			end)
		end)
	else
		local settings = DUELS.Spot
		duel.Grid = Logic.SpotMakeGrid(function(a: number, b: number): number
			return random:NextInteger(a, b)
		end, duel.Round)
		duel.Phase = "play"
		duel.GridAt = os.clock()
		duel.Locked = { 0, 0 }
		duel.PhaseEndsAt = os.clock() + settings.RoundTimeout
		broadcast(duel, "duelUpdate")
		task.delay(settings.RoundTimeout, function()
			if not duel.Over and duel.Token == token and duel.Phase == "play" then
				duel.RoundResult = { Winner = 0, Void = true, Odd = duel.Grid.Odd }
				finishRound(duel)
			end
		end)
	end
end

----------------------------------------------------------------------
-- Début d'un duel
----------------------------------------------------------------------

local INTRO_SECONDS = 3

local function startDuel(gameId: string, a: Player, b: Player, stake: number)
	-- Places tirées au hasard (la place 1 commence au morpion / puissance 4)
	local first, second = a, b
	if random:NextInteger(1, 2) == 2 then
		first, second = b, a
	end
	local duel = {
		Id = newId("D"),
		Game = gameId,
		Stake = stake,
		Pot = stake * 2,
		Players = { first, second },
		Seats = { [first] = 1, [second] = 2 },
		Infos = { playerInfo(first), playerInfo(second) },
		Turn = 1,
		Scores = { 0, 0 },
		Round = 0,
		Moves = 0,
		Token = 0,
		Over = false,
		Winner = 0,
		StartedAt = os.clock(),
	}
	duels[duel.Id] = duel
	duelOf[first] = duel
	duelOf[second] = duel

	-- Compteurs anti-farm (des deux côtés)
	for seat, player in ipairs(duel.Players) do
		local data = getData(player)
		if data then
			incr(ensureArcade(data).DayPairs, tostring(duel.Players[3 - seat].UserId))
		end
	end

	if gameId == "TicTacToe" then
		duel.Board = table.create(9, 0)
		duel.Phase = "play"
		armTurn(duel)
	elseif gameId == "Connect4" then
		duel.Board = table.create(Logic.C4Cols * Logic.C4Rows, 0)
		duel.Phase = "play"
		armTurn(duel)
	else
		duel.Phase = "intro"
		duel.PhaseEndsAt = os.clock() + INTRO_SECONDS
		local token = duel.Token
		task.delay(INTRO_SECONDS, function()
			if not duel.Over and duel.Token == token then
				nextRound(duel)
			end
		end)
	end

	broadcast(duel, "duelStart")

	-- Duel trop long : égalité, mises rendues
	task.delay(DUELS.MaxDuelSeconds, function()
		if not duel.Over then
			endDuel(duel, 0, "time")
		end
	end)
	return duel
end

----------------------------------------------------------------------
-- Coups
----------------------------------------------------------------------

local function pingOf(player: Player): number
	local ok, ping = pcall(function()
		return player:GetNetworkPing()
	end)
	if ok and isValidNumber(ping) then
		return math.clamp(ping, 0, DUELS.Reaction.MaxPingComp)
	end
	return 0
end

-- Coup d'un jeu au tour par tour (morpion, puissance 4)
local function playBoardMove(player: Player, duel, seat: number, move): (boolean, string?)
	if duel.Phase ~= "play" or duel.Turn ~= seat then
		return false, T(player, "Not your turn!")
	end
	local index
	if duel.Game == "TicTacToe" then
		if type(move) ~= "number" or move ~= math.floor(move) or move < 1 or move > 9 or duel.Board[move] ~= 0 then
			return false, T(player, "Invalid move")
		end
		index = move
	else
		index = Logic.C4Drop(duel.Board, move)
		if not index then
			return false, T(player, "This column is full")
		end
	end
	duel.Board[index] = seat
	duel.Last = index
	duel.Moves += 1

	local winner, line
	if duel.Game == "TicTacToe" then
		winner, line = Logic.TicTacToeWinner(duel.Board)
	else
		winner, line = Logic.C4Winner(duel.Board)
	end
	if winner ~= 0 then
		duel.Line = line
		endDuel(duel, winner, "line")
		return true, nil
	end
	if Logic.IsFull(duel.Board, #duel.Board) then
		endDuel(duel, 0, "draw")
		return true, nil
	end
	duel.Turn = 3 - seat
	armTurn(duel)
	broadcast(duel, "duelUpdate")
	return true, nil
end

local function playReactionTap(player: Player, duel, seat: number): (boolean, any)
	local settings = DUELS.Reaction
	if duel.Phase == "wait" then
		-- Faux départ : le point va à l'adversaire
		duel.RoundResult = { Winner = 3 - seat, FalseStart = seat }
		finishRound(duel)
		return true, { FalseStart = true }
	elseif duel.Phase == "go" then
		if duel.Taps[seat] then
			return true, nil
		end
		local reaction = os.clock() - duel.GoAt - pingOf(player)
		if reaction < settings.MinHuman then
			-- Impossible pour un humain : appui envoyé avant d'avoir vu le GO
			duel.RoundResult = { Winner = 3 - seat, FalseStart = seat }
			finishRound(duel)
			return true, { FalseStart = true }
		end
		duel.Taps[seat] = math.floor(reaction * 1000 + 0.5) / 1000
		local token = duel.Token
		if duel.Taps[3 - seat] then
			reactionResolve(duel, token)
		elseif not duel.WindowArmed or duel.WindowArmed ~= token then
			duel.WindowArmed = token
			task.delay(settings.Window, reactionResolve, duel, token)
		end
		return true, { Time = duel.Taps[seat] }
	end
	return false, nil
end

local function playSpot(player: Player, duel, seat: number, move): (boolean, any)
	local settings = DUELS.Spot
	local grid = duel.Grid
	if duel.Phase ~= "play" or not grid then
		return false, nil
	end
	if type(move) ~= "number" or move ~= math.floor(move) or move < 1 or move > #grid.Cells then
		return false, T(player, "Invalid move")
	end
	local now = os.clock()
	if now < (duel.Locked[seat] or 0) then
		return false, { Locked = duel.Locked[seat] - now }
	end
	if now - duel.GridAt < settings.MinFind then
		return false, nil -- trop rapide pour un humain (la grille vient d'arriver)
	end
	if move == grid.Odd then
		duel.RoundResult = { Winner = seat, Odd = grid.Odd, Time = math.floor((now - duel.GridAt) * 100 + 0.5) / 100 }
		finishRound(duel)
		return true, { Found = true }
	end
	duel.Locked[seat] = now + settings.WrongLock
	return true, { Wrong = true, Locked = settings.WrongLock }
end

----------------------------------------------------------------------
-- Actions
----------------------------------------------------------------------

local ACTIONS = {}

function ACTIONS.lobby(player: Player, _data, _arg)
	local list = {}
	local outgoing = outgoingOf(player)
	local myData = getData(player)
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player and other.UserId ~= player.UserId and hasArcade(other) then
			local info = playerInfo(other)
			info.Busy = duelOf[other] ~= nil
			info.Invited = outgoing ~= nil and outgoing.To == other
			info.PairLeft = math.max(0, DUELS.PairDailyLimit - pairCount(myData, other, "DayPairs"))
			table.insert(list, info)
		end
	end
	table.sort(list, function(a, b)
		return string.lower(a.Name) < string.lower(b.Name)
	end)
	local incoming = {}
	for _, invite in ipairs(incomingOf(player)) do
		table.insert(incoming, inviteView(invite))
	end
	local duel = duelOf[player]
	return true, {
		Players = list,
		Incoming = incoming,
		Outgoing = outgoing and inviteView(outgoing) or nil,
		Duel = duel and snapshot(duel, player) or nil,
	}
end

function ACTIONS.invite(player: Player, data, arg)
	if type(arg) ~= "table" then
		return false, T(player, "Invalid request")
	end
	local gameId, stake, targetId = arg.Game, arg.Stake, arg.Target
	local entry = type(gameId) == "string" and ArcadeConfig.GamesById[gameId]
	if not entry or entry.Kind ~= "Duel" then
		return false, T(player, "Unknown game")
	end
	if type(stake) ~= "number" or not ArcadeConfig.StakesSet[stake] then
		return false, T(player, "Invalid stake")
	end
	if type(targetId) ~= "number" then
		return false, T(player, "Invalid request")
	end
	local target = Players:GetPlayerByUserId(targetId)
	if not target or target == player or target.UserId == player.UserId then
		return false, T(player, "You can't duel yourself!")
	end
	if not hasArcade(target) then
		return false, T(player, "%s doesn't have the arcade yet", target.DisplayName)
	end
	if duelOf[player] then
		return false, T(player, "Finish your current duel first")
	end
	if duelOf[target] then
		return false, T(player, "%s is already in a duel", target.DisplayName)
	end
	local now = os.clock()
	if now - (lastInviteAt[player] or -math.huge) < DUELS.InviteCooldown then
		return false, T(player, "Slow down!")
	end
	local declined = declinedAt[player] and declinedAt[player][target.UserId]
	if declined and now - declined < DUELS.DeclineCooldown then
		return false, T(player, "%s just said no. Try again in a moment", target.DisplayName)
	end
	local targetData = getData(target)
	if not targetData then
		return false, T(player, "This player has left")
	end
	if pairCount(data, target, "DayPairs") >= DUELS.PairDailyLimit or pairCount(targetData, player, "DayPairs") >= DUELS.PairDailyLimit then
		return false, T(player, "You've dueled %s a lot today. Come back tomorrow!", target.DisplayName)
	end
	-- Mise en 🏆 trophées (jamais en tickets : ils s'achètent en Robux)
	ensureArcade(targetData)
	local stakeOk, why = Logic.CheckStake(stake, data.Trophies, targetData.Trophies)
	if not stakeOk then
		if why == "self" then
			return false, T(player, "Not enough trophies: win arcade games to earn some!")
		elseif why == "other" then
			return false, T(player, "%s doesn't have enough trophies for this stake", target.DisplayName)
		end
		return false, T(player, "Invalid stake")
	end
	local previous = outgoingOf(player)
	if previous then
		closeInvite(previous, "cancelled")
	end
	if #incomingOf(target) >= DUELS.MaxIncoming then
		return false, T(player, "%s already has too many invitations", target.DisplayName)
	end
	-- Invitation croisée déjà en attente : on l'accepte directement ? Non : chacun choisit, on garde les deux.
	lastInviteAt[player] = now
	local invite = {
		Id = newId("I"),
		From = player,
		To = target,
		Game = entry.Id,
		Stake = stake,
		ExpiresAt = now + DUELS.InviteSeconds,
	}
	invites[invite.Id] = invite
	task.delay(DUELS.InviteSeconds, function()
		if invites[invite.Id] == invite then
			closeInvite(invite, "expired")
		end
	end)
	fire(target, "invite", inviteView(invite))
	return true, { Invite = inviteView(invite), Text = T(player, "Invitation sent to %s", target.DisplayName) }
end

function ACTIONS.cancel(player: Player, _data, _arg)
	local invite = outgoingOf(player)
	if invite then
		closeInvite(invite, "cancelled")
	end
	return true, nil
end

function ACTIONS.decline(player: Player, _data, id)
	local invite = type(id) == "string" and invites[id]
	if not invite or invite.To ~= player then
		return false, T(player, "This invitation has expired")
	end
	declinedAt[invite.From] = declinedAt[invite.From] or {}
	declinedAt[invite.From][player.UserId] = os.clock()
	closeInvite(invite, "declined")
	return true, nil
end

function ACTIONS.accept(player: Player, data, id)
	local invite = type(id) == "string" and invites[id]
	if not invite or invite.To ~= player then
		return false, T(player, "This invitation has expired")
	end
	local from = invite.From
	local fromData = getData(from)
	if from.Parent ~= Players or not fromData or not hasArcade(from) then
		closeInvite(invite, "left")
		return false, T(player, "This player has left")
	end
	if duelOf[player] then
		return false, T(player, "Finish your current duel first")
	end
	if duelOf[from] then
		closeInvite(invite, "busy")
		return false, T(player, "%s is already in a duel", from.DisplayName)
	end
	if pairCount(data, from, "DayPairs") >= DUELS.PairDailyLimit or pairCount(fromData, player, "DayPairs") >= DUELS.PairDailyLimit then
		closeInvite(invite, "limit")
		return false, T(player, "You've dueled %s a lot today. Come back tomorrow!", from.DisplayName)
	end
	-- Mise revérifiée au moment d'accepter (les soldes ont pu changer)
	local stake = invite.Stake
	ensureArcade(fromData)
	local stakeOk, why = Logic.CheckStake(stake, data.Trophies, fromData.Trophies)
	if not stakeOk then
		if why == "self" then
			return false, T(player, "Not enough trophies: win arcade games to earn some!")
		end
		closeInvite(invite, "trophies")
		return false, T(player, "%s doesn't have enough trophies anymore", from.DisplayName)
	end
	closeInvite(invite, "accepted")
	-- Les deux joueurs ne sont plus disponibles : leurs autres invitations tombent
	closeInvitesOf(player, "busy")
	closeInvitesOf(from, "busy")
	-- Séquestre : les deux mises (🏆) sont prises maintenant
	if stake > 0 then
		moveTrophies(player, -stake)
		moveTrophies(from, -stake)
	end
	local duel = startDuel(invite.Game, from, player, stake)
	if changed[from] then
		changed[from] = nil
		services.GameService:SendState(from)
	end
	return true, snapshot(duel, player)
end

function ACTIONS.move(player: Player, _data, arg)
	local duel = duelOf[player]
	if type(arg) ~= "table" or not duel or arg.Id ~= duel.Id or duel.Over then
		return false, T(player, "This duel is over")
	end
	local seat = duel.Seats[player]
	if not seat then
		return false, T(player, "Invalid request")
	end
	if duel.Game == "TicTacToe" or duel.Game == "Connect4" then
		return playBoardMove(player, duel, seat, arg.Move)
	elseif duel.Game == "ReactionDuel" then
		return playReactionTap(player, duel, seat)
	elseif duel.Game == "SpotRace" then
		return playSpot(player, duel, seat, arg.Move)
	end
	return false, T(player, "Invalid request")
end

function ACTIONS.forfeit(player: Player, _data, id)
	local duel = duelOf[player]
	if not duel or (id ~= nil and id ~= duel.Id) then
		return false, T(player, "This duel is over")
	end
	endDuel(duel, 3 - duel.Seats[player], "forfeit")
	return true, nil
end

function ACTIONS.buy(player: Player, data, itemId)
	local item = type(itemId) == "string" and ArcadeConfig.ShopById[itemId]
	if not item then
		return false, T(player, "Unknown item")
	end
	if not RateLimiter.Check(player, "ArcadeBuy", 0.3) then
		return false, T(player, "Slow down!")
	end
	local arcade = ensureArcade(data)
	if item.Kind == "Badge" and arcade.Badges[item.Id] then
		return false, T(player, "You already own this item")
	end
	if item.MaxPerDay and (tonumber(arcade.DayShop[item.Id]) or 0) >= item.MaxPerDay then
		return false, T(player, "Sold out for today. Come back tomorrow!")
	end
	if data.Tickets < item.Price then
		-- Le client propose alors d'en acheter (fenêtre NeedTickets)
		return false, { Text = T(player, "Not enough tickets"), Missing = item.Price - data.Tickets, Currency = "Tickets" }
	end
	local name = T(player, item.Name)
	local text
	if item.Kind == "Boost" then
		local monetization = services.MonetizationService
		local current, remaining = monetization:GetBoost(data)
		-- Un autre boost (ex. acheté avec des Robux) est actif : on ne l'écrase pas
		if remaining > 0 and math.abs(current - item.Multiplier) > 1e-6 then
			return false, T(player, "Another boost is already running")
		end
		moveTickets(player, -item.Price)
		monetization:AddBoost(data, item.Multiplier, item.Duration)
		text = T(player, "%s %s activated!", item.Icon, name)
	elseif item.Kind == "Dopamine" then
		moveTickets(player, -item.Price)
		local amount = grantDopamineSeconds(player, item.Seconds, false)
		text = T(player, "%s +%s %s", item.Icon, NumberFormatter.Format(amount), Config.Game.CurrencyName)
	elseif item.Kind == "Badge" then
		moveTickets(player, -item.Price)
		arcade.Badges[item.Id] = true
		arcade.Badge = item.Id -- équipé tout de suite
		text = T(player, "%s %s bought and equipped!", item.Icon, name)
	else
		return false, T(player, "Invalid item")
	end
	incr(arcade.DayShop, item.Id)
	changed[player] = true
	return true, { Text = text, Tickets = data.Tickets }
end

function ACTIONS.badge(player: Player, data, badgeId)
	local arcade = ensureArcade(data)
	if badgeId == "" or badgeId == nil then
		arcade.Badge = ""
		changed[player] = true
		return true, T(player, "Badge removed")
	end
	local item = type(badgeId) == "string" and ArcadeConfig.ShopById[badgeId]
	if not item or item.Kind ~= "Badge" or not arcade.Badges[badgeId] then
		return false, T(player, "You don't own this item")
	end
	arcade.Badge = badgeId
	changed[player] = true
	return true, T(player, "%s %s equipped", item.Icon, T(player, item.Name))
end

----------------------------------------------------------------------
-- Point d'entrée (RemoteFunction "Arcade")
----------------------------------------------------------------------

local function onArcade(player: Player, action: any, arg: any)
	if type(action) ~= "string" or #action > 48 then
		return false, T(player, "Invalid request")
	end
	-- ~30 appels / s max (les jeux de rapidité cliquent vite)
	if not RateLimiter.Check(player, "Arcade", 0.03) then
		return false, T(player, "Slow down!")
	end
	local data = getData(player)
	if not data or not services.GameService:IsReady(player) then
		return false, T(player, "Loading...")
	end
	if not Formulas.HasFeature(data, ArcadeConfig.Feature) then
		return false, T(player, "The arcade isn't unlocked yet")
	end
	local arcade = ensureArcade(data)
	-- Cadeaux de bienvenue (une seule fois chacun ; les trophées sont aussi
	-- offerts aux joueurs qui avaient déjà l'arcade avant leur arrivée)
	if not arcade.Welcomed then
		arcade.Welcomed = true
		moveTickets(player, TICKETS.StartTickets)
	end
	if not arcade.TrophyGift then
		arcade.TrophyGift = true
		moveTrophies(player, TROPHIES.WelcomeGift)
	end

	local okCall, ok, result
	if string.sub(action, 1, 5) == "solo:" then
		local solo = getSolo()
		if not solo then
			return false, T(player, "This game is coming soon!")
		end
		okCall, ok, result = pcall(solo.Handle, player, data, action, arg, soloApi)
	else
		local handler = ACTIONS[action]
		if not handler then
			return false, T(player, "Invalid request")
		end
		okCall, ok, result = pcall(handler, player, data, arg)
	end
	if not okCall then
		warn("[MinigameService] Erreur dans l'action " .. action .. " :", ok)
		ok, result = false, T(player, "Something went wrong")
	end
	if changed[player] then
		changed[player] = nil
		services.GameService:SendState(player)
	end
	return ok == true, result
end

----------------------------------------------------------------------
-- Cycle de vie
----------------------------------------------------------------------

function MinigameService:Init(allServices)
	services = allServices
end

-- Champs ajoutés à l'état envoyé au client (GameService:BuildState)
function MinigameService:GetClientState(player: Player, data)
	local arcade = ensureArcade(data)
	return {
		Tickets = data.Tickets,
		Trophies = data.Trophies,
		Arcade = {
			Badge = arcade.Badge,
			Badges = arcade.Badges,
			Best = arcade.Best,
			Plays = arcade.Plays,
			Wins = arcade.Wins,
			Losses = arcade.Losses,
			Draws = arcade.Draws,
			History = arcade.History,
			TicketsEarned = arcade.TicketsEarned,
			TrophiesEarned = arcade.TrophiesEarned,
			DayTickets = arcade.DayTickets,
			DailyCap = TICKETS.DailyCap,
			DayTrophies = arcade.DayTrophies,
			TrophyCap = TROPHIES.DailyCap,
			DayRewards = arcade.DayRewards,
			DayShop = arcade.DayShop,
			InDuel = duelOf[player] ~= nil,
		},
	}
end

-- 🎟️ Tickets achetés en Robux (appelé par MonetizationService dans
-- ProcessReceipt, APRÈS la vérification de l'achat) : ajoutés au même solde
-- que les tickets gagnés, sans plafond du jour. -> (ajoutés, nouveau solde)
function MinigameService:GrantPurchasedTickets(player: Player, amount: number): (number, number)
	local data = getData(player)
	if not data or not isValidNumber(amount) or amount <= 0 or amount ~= math.floor(amount) then
		error("montant de tickets invalide : " .. tostring(amount))
	end
	local arcade = ensureArcade(data)
	local added = moveTickets(player, amount)
	arcade.TicketsBought += added
	changed[player] = nil -- (MonetizationService renvoie l'état complet lui-même)
	return added, data.Tickets
end

function MinigameService:PlayerReady(_player: Player, data)
	ensureArcade(data)
end

function MinigameService:PlayerRemoving(player: Player)
	-- Le joueur qui part perd son duel
	local duel = duelOf[player]
	if duel and not duel.Over then
		local seat = duel.Seats[player]
		if seat then
			endDuel(duel, 3 - seat, "left")
		end
	end
	closeInvitesOf(player, "left")
	duelOf[player] = nil
	changed[player] = nil
	lastInviteAt[player] = nil
	declinedAt[player] = nil
	local solo = soloModule
	if solo then
		for _, name in ipairs({ "PlayerRemoving", "Cleanup" }) do
			if type(solo[name]) == "function" then
				pcall(solo[name], player)
			end
		end
	end
end

function MinigameService:Start()
	arcadeEvent = Net.Event("ArcadeEvent")
	Net.Function("Arcade").OnServerInvoke = onArcade
	-- Préchargement des jeux solo (sans bloquer : une erreur est seulement signalée)
	task.defer(getSolo)
	-- Fermeture du serveur : duels en cours annulés, mises rendues (avant la sauvegarde)
	game:BindToClose(function()
		for _, duel in pairs(duels) do
			pcall(endDuel, duel, 0, "shutdown")
		end
	end)
end

-- (tests / debug) logique interne accessible sans passer par le réseau
MinigameService._Internal = {
	Snapshot = snapshot,
	EndDuel = endDuel,
	RewardWin = rewardWin,
}

return MinigameService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="377">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source"><![CDATA[--[[
	MonetizationService (ModuleScript)
	Emplacement : ServerScriptService > Services > MonetizationService

	💎 Boutique Robux (offres dans Config.Monetization) :
	  - Game Passes : possession vérifiée par le SERVEUR à l'arrivée du joueur
	    (UserOwnsGamePassAsync, 1 nouvel essai si Roblox ne répond pas) puis
	    après chaque achat (PromptGamePassPurchaseFinished). Multiplicateurs
	    (x2, x10, VIP), auto-clic, thèmes Premium (VIP) et thèmes vendus en
	    Game Pass (Config.Themes[].GamePassId) ;
	  - Developer Products : ProcessReceipt (défini UNE seule fois ici).
	    Chaque achat n'est accordé qu'une fois : son PurchaseId est gardé dans
	    data.Purchases et sauvegardé AVANT de répondre "PurchaseGranted" à Roblox ;
	    types : Dopamine, Boost, ServerRush, Tickets (🎟️ tickets d'arcade,
	    même solde data.Tickets que MinigameService), Combo (🎟️ + Dopamine).
	    Un type absent de Config.Monetization.ReadyKinds (ex. "Stylish",
	    pas encore codé) n'est jamais accordé (Roblox réessaiera plus tard) ;
	  - Boost temporaire (data.Boost, conservé si le joueur revient avant la fin).
	Le client ne fait qu'OUVRIR la fenêtre d'achat Roblox : il ne peut rien
	s'accorder lui-même.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Locale = require(ReplicatedStorage.Shared.Locale)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)

local MonetizationService = {}

local services

local MAX_PURCHASES_KEPT = 50 -- nombre de PurchaseId gardés (anti-doublon)
local MAX_BOOST_MULTIPLIER = 1000 -- sécurité contre une sauvegarde abîmée

--[[
	Possession par joueur (session, jamais sauvegardée : Roblox fait foi) :
	[Player] = {
		Passes = { [passId de Config.Monetization.GamePasses] = true },
		Themes = { [themeId] = true }, -- thèmes vendus en Game Pass
		Debug = { [passId] = true | false }, -- commande de test /pass (Studio)
		AutoClickCarry = number, -- fraction de clic automatique en attente
		PendingChecks = number, -- vérifications Roblox encore en cours (arrivée)
	}
]]
local owners = {}

-- PurchaseId en cours de traitement (évite deux traitements simultanés)
local processing = {}

-- Index : ID Roblox du Game Pass -> offres / thèmes concernés
local passesByGamePassId = {}
local themesByGamePassId = {}
for _, pass in ipairs(Config.Monetization.GamePasses) do
	if type(pass.GamePassId) == "number" and pass.GamePassId ~= 0 then
		passesByGamePassId[pass.GamePassId] = passesByGamePassId[pass.GamePassId] or {}
		table.insert(passesByGamePassId[pass.GamePassId], pass)
	end
end
for _, theme in ipairs(Config.Themes) do
	if type(theme.GamePassId) == "number" and theme.GamePassId ~= 0 then
		themesByGamePassId[theme.GamePassId] = themesByGamePassId[theme.GamePassId] or {}
		table.insert(themesByGamePassId[theme.GamePassId], theme)
	end
end

local function isValidNumber(value): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

function MonetizationService:Init(allServices)
	services = allServices
end

-- Texte dans la langue du joueur
local function T(player: Player, text: string, ...): string
	return services.GameService:T(player, text, ...)
end

----------------------------------------------------------------------
-- 🎰 Machine chanceuse : tours GRATUITS (jetons gagnés en jouant, aucune
-- mise), donc toujours ouverte quand Config.Casino.Enabled = true, même si
-- de la Dopamine se vend en Robux. DisableCasinoWhenSelling = true permet
-- quand même de la fermer dans ce cas.
----------------------------------------------------------------------

function MonetizationService:IsCasinoEnabled(): boolean
	if Config.Casino.Enabled ~= true then
		return false
	end
	if Config.Monetization.DisableCasinoWhenSelling == true and Config.IsSellingForRobux then
		return false
	end
	return true
end

----------------------------------------------------------------------
-- Game Passes
----------------------------------------------------------------------

-- Vérifie auprès de Roblox (pcall + 1 nouvel essai). Renvoie nil si Roblox
-- n'a pas répondu (on ne change alors rien).
local function checkOwnership(player: Player, gamePassId: number): boolean?
	for attempt = 1, 2 do
		local ok, result = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(player.UserId, gamePassId)
		end)
		if ok then
			return result == true
		end
		warn(string.format("[MonetizationService] Vérification du Game Pass %d pour %s impossible (essai %d) : %s",
			gamePassId, player.Name, attempt, tostring(result)))
		if attempt == 1 then
			task.wait(2)
		end
	end
	return nil
end

-- Le joueur possède-t-il l'offre `passId` (Config.Monetization.GamePasses) ?
function MonetizationService:OwnsPass(player: Player, passId: string): boolean
	local owner = owners[player]
	if not owner then
		return false
	end
	local override = owner.Debug[passId]
	if override ~= nil then
		return override
	end
	return owner.Passes[passId] == true
end

-- { [passId] = true } des Game Passes possédés (copie envoyée au client)
function MonetizationService:GetOwnedPasses(player: Player): { [string]: boolean }
	local result = {}
	for _, pass in ipairs(Config.Monetization.GamePasses) do
		if self:OwnsPass(player, pass.Id) then
			result[pass.Id] = true
		end
	end
	return result
end

-- VIP = possède un pass qui débloque les thèmes Premium (le pass "VIP")
function MonetizationService:IsVIP(player: Player): boolean
	for _, pass in ipairs(Config.Monetization.GamePasses) do
		if (pass.UnlockPremiumThemes or pass.Id == "VIP") and self:OwnsPass(player, pass.Id) then
			return true
		end
	end
	return false
end

-- Le joueur possède-t-il le Game Pass propre à ce thème ?
function MonetizationService:OwnsThemePass(player: Player, themeId: string): boolean
	local owner = owners[player]
	return owner ~= nil and owner.Themes[themeId] == true
end

-- Clics automatiques par seconde (pass "Auto-clic")
function MonetizationService:GetAutoClicksPerSecond(player: Player): number
	local total = 0
	for _, pass in ipairs(Config.Monetization.GamePasses) do
		local rate = pass.AutoClicksPerSecond
		if isValidNumber(rate) and rate > 0 and self:OwnsPass(player, pass.Id) then
			total += rate
		end
	end
	return total
end

-- Nombre de clics automatiques à faire pendant `elapsed` secondes (garde la fraction restante)
function MonetizationService:TakeAutoClicks(player: Player, elapsed: number): number
	local owner = owners[player]
	local rate = self:GetAutoClicksPerSecond(player)
	if not owner or rate <= 0 or not isValidNumber(elapsed) or elapsed <= 0 then
		if owner then
			owner.AutoClickCarry = 0
		end
		return 0
	end
	local carry = owner.AutoClickCarry + rate * elapsed
	local clicks = math.floor(carry)
	owner.AutoClickCarry = carry - clicks
	return clicks
end

----------------------------------------------------------------------
-- Boost temporaire et multiplicateur bonus
----------------------------------------------------------------------

-- Boost actif : (multiplicateur, secondes restantes). (1, 0) si aucun.
function MonetizationService:GetBoost(data): (number, number)
	local boost = data and data.Boost
	if type(boost) ~= "table" or not isValidNumber(boost.Multiplier) or not isValidNumber(boost.EndsAt) then
		return 1, 0
	end
	local remaining = boost.EndsAt - os.time()
	if remaining <= 0 or boost.Multiplier <= 1 then
		return 1, 0
	end
	return boost.Multiplier, remaining
end

-- Produit des multiplicateurs des Game Passes possédés (sans le boost :
-- sert aussi au gain hors-ligne, un boost ne dure pas pendant l'absence)
function MonetizationService:GetPassMultiplier(player: Player): number
	local multiplier = 1
	for _, pass in ipairs(Config.Monetization.GamePasses) do
		if isValidNumber(pass.Multiplier) and pass.Multiplier > 0 and self:OwnsPass(player, pass.Id) then
			multiplier *= pass.Multiplier
		end
	end
	return multiplier
end

-- Produit des multiplicateurs des Game Passes possédés x boost actif
function MonetizationService:GetBonusMultiplier(player: Player): number
	local data = services.DataService:GetData(player)
	local boostMultiplier = self:GetBoost(data)
	return self:GetPassMultiplier(player) * boostMultiplier
end

-- Ajoute un boost : si un boost au moins aussi fort est actif, on le
-- prolonge ; sinon le nouveau boost remplace l'ancien.
function MonetizationService:AddBoost(data, multiplier: number, duration: number)
	local now = os.time()
	local currentMultiplier, remaining = self:GetBoost(data)
	if remaining > 0 and currentMultiplier >= multiplier then
		data.Boost.EndsAt = now + remaining + duration
	else
		data.Boost = { Multiplier = multiplier, EndsAt = now + duration }
	end
end

-- Accorde un Game Pass (après vérification serveur ou achat confirmé par Roblox)
local function grantGamePass(player: Player, gamePassId: number, purchased: boolean)
	local owner = owners[player]
	if not owner then
		return
	end
	local names = {}
	for _, pass in ipairs(passesByGamePassId[gamePassId] or {}) do
		if not owner.Passes[pass.Id] then
			owner.Passes[pass.Id] = true
			table.insert(names, pass.Icon .. " " .. T(player, pass.Name))
		end
	end
	for _, theme in ipairs(themesByGamePassId[gamePassId] or {}) do
		if not owner.Themes[theme.Id] then
			owner.Themes[theme.Id] = true
			table.insert(names, T(player, "%s %s theme", theme.Icon, T(player, theme.Name)))
		end
	end
	if #names == 0 then
		return
	end

	local data = services.DataService:GetData(player)
	if purchased and data then
		data.Stats.RobuxPurchases += 1
		-- Un thème acheté en Game Pass est équipé tout de suite
		local themes = themesByGamePassId[gamePassId]
		if themes and themes[1] and type(data.Themes) == "table" then
			data.Themes.Equipped = themes[1].Id
		end
	end
	if purchased then
		services.GameService:Notify(player, {
			Type = "Purchase",
			Kind = "Pass",
			Id = (passesByGamePassId[gamePassId] and passesByGamePassId[gamePassId][1].Id) or nil,
			Text = T(player, "💎 Thank you! %s unlocked!", table.concat(names, ", ")),
		})
	end
	services.GameService:MarkDirty(player)
end

-- Vérifie tous les Game Passes configurés (en parallèle) pour ce joueur
local function checkAllPasses(player: Player)
	local ids = {}
	for gamePassId in pairs(passesByGamePassId) do
		ids[gamePassId] = true
	end
	for gamePassId in pairs(themesByGamePassId) do
		ids[gamePassId] = true
	end
	local owner = owners[player]
	for gamePassId in pairs(ids) do
		if owner then
			owner.PendingChecks += 1
		end
		task.spawn(function()
			local ok, owned = pcall(checkOwnership, player, gamePassId)
			if ok and owned and owners[player] then
				grantGamePass(player, gamePassId, false)
			end
			if owner then
				owner.PendingChecks -= 1
			end
		end)
	end
end

-- Attend (au plus `timeout` secondes) la fin des vérifications des Game
-- Passes lancées à l'arrivée du joueur (utilisé avant le gain hors-ligne)
function MonetizationService:WaitForPassChecks(player: Player, timeout: number)
	local start = os.clock()
	while os.clock() - start < timeout do
		local owner = owners[player]
		if not owner or owner.PendingChecks <= 0 then
			return
		end
		task.wait(0.1)
	end
end

local function onGamePassPurchaseFinished(player: Player, gamePassId: number, wasPurchased: boolean)
	if typeof(player) ~= "Instance" or not player:IsA("Player") or type(gamePassId) ~= "number" then
		return
	end
	if not passesByGamePassId[gamePassId] and not themesByGamePassId[gamePassId] then
		return -- pas une offre de ce jeu
	end
	if not owners[player] then
		return
	end
	-- On revérifie auprès de Roblox (jamais de confiance aveugle) :
	--  - possédé -> accordé ;
	--  - Roblox ne répond pas mais achat annoncé -> accordé pour cette session
	--    (rien n'est sauvegardé : tout est revérifié à la prochaine connexion) ;
	--  - "pas possédé" juste après un achat -> on réessaie (cache Roblox) ;
	--    dans Studio les achats sont simulés : on se fie à l'événement.
	local purchased = wasPurchased == true
	local owned = checkOwnership(player, gamePassId)
	if owned == false and purchased then
		for _ = 1, 2 do
			task.wait(3)
			if not owners[player] then
				return
			end
			owned = checkOwnership(player, gamePassId)
			if owned ~= false then
				break
			end
		end
	end
	if owned == true or (owned == nil and purchased) or (purchased and RunService:IsStudio()) then
		grantGamePass(player, gamePassId, purchased)
	end
end

----------------------------------------------------------------------
-- Developer Products (ProcessReceipt)
----------------------------------------------------------------------

local function hasProcessed(data, purchaseId: string): boolean
	for _, id in ipairs(data.Purchases) do
		if id == purchaseId then
			return true
		end
	end
	return false
end

local function recordPurchase(data, purchaseId: string)
	table.insert(data.Purchases, purchaseId)
	while #data.Purchases > MAX_PURCHASES_KEPT do
		table.remove(data.Purchases, 1)
	end
	data.Stats.RobuxPurchases += 1
end

-- 🎟️ Tickets achetés : même solde que les tickets gagnés (MinigameService).
-- -> (tickets ajoutés, nouveau solde)
local function addPurchasedTickets(player: Player, data, amount: number): (number, number)
	local minigames = services.MinigameService
	if minigames and type(minigames.GrantPurchasedTickets) == "function" then
		return minigames:GrantPurchasedTickets(player, amount)
	end
	-- (secours si l'arcade n'est pas chargée : même champ data.Tickets)
	local before = (isValidNumber(data.Tickets) and data.Tickets >= 0) and math.floor(data.Tickets) or 0
	data.Tickets = before + amount
	return amount, data.Tickets
end

-- Nombre entier de tickets d'une offre (Tickets / Combo), sinon erreur
local function ticketAmount(product): number
	local amount = product.Tickets
	if not isValidNumber(amount) or amount <= 0 or amount ~= math.floor(amount) then
		error("nombre de tickets invalide pour " .. tostring(product.Id))
	end
	return amount
end

-- Accorde le contenu d'un produit. Renvoie (texte de remerciement, titre
-- optionnel du bandeau, tickets ajoutés optionnels).
-- Tout est calculé AVANT de modifier les données (pas d'accord à moitié).
local function grantProduct(player: Player, data, product): (string, string?, number?)
	local kind = product.Kind
	local ready = Config.Monetization.ReadyKinds
	if type(ready) == "table" and not ready[kind] then
		error("type de produit pas encore codé : " .. tostring(kind))
	end
	if kind == "Tickets" then
		local amount = ticketAmount(product)
		local added, balance = addPurchasedTickets(player, data, amount)
		return T(player, "💎 Thank you! %s %s: +%s 🎟️ tickets (you have %s)", product.Icon, T(player, product.Name),
			NumberFormatter.Format(added), NumberFormatter.Format(balance)),
			T(player, "🎟️ +%s TICKETS!", NumberFormatter.Format(added)),
			added
	elseif kind == "Combo" then
		-- Tout est vérifié d'abord ; la Dopamine (seule étape qui peut échouer)
		-- est donnée AVANT les tickets (simple addition) : jamais à moitié
		local tickets = ticketAmount(product)
		local stats = services.GameService:GetStats(player)
		local amount = Formulas.ScaledReward(stats, product.Seconds or 0, product.Minimum or 0)
		if not isValidNumber(amount) or amount <= 0 then
			error("montant invalide pour " .. tostring(product.Id))
		end
		services.GameService:AddDopamine(player, amount, false)
		local added = addPurchasedTickets(player, data, tickets)
		return T(player, "💎 Thank you! %s %s: +%s 🎟️ tickets and +%s %s", product.Icon, T(player, product.Name),
			NumberFormatter.Format(added), NumberFormatter.Format(amount), Config.Game.CurrencyName),
			T(player, "🎁 COMBO UNLOCKED!"),
			added
	elseif kind == "Dopamine" then
		local stats = services.GameService:GetStats(player)
		local amount = Formulas.ScaledReward(stats, product.Seconds or 0, product.Minimum or 0)
		if not isValidNumber(amount) or amount <= 0 then
			error("montant invalide pour " .. tostring(product.Id))
		end
		-- Compté comme gagné (classement), mais ne fait pas avancer les quêtes
		services.GameService:AddDopamine(player, amount, false)
		return T(player, "💎 Thank you! %s %s: +%s %s", product.Icon, T(player, product.Name),
			NumberFormatter.Format(amount), Config.Game.CurrencyName)
	elseif kind == "Boost" then
		local multiplier, duration = product.Multiplier, product.Duration
		if not isValidNumber(multiplier) or multiplier <= 1 or not isValidNumber(duration) or duration <= 0 then
			error("boost mal configuré : " .. tostring(product.Id))
		end
		MonetizationService:AddBoost(data, multiplier, duration)
		local _, remaining = MonetizationService:GetBoost(data)
		return T(player, "💎 Thank you! %s %s active (%d min left)", product.Icon, T(player, product.Name),
			math.ceil(remaining / 60))
	elseif kind == "ServerRush" then
		services.EventService:StartRush(true)
		local displayName = player.DisplayName
		services.GameService:NotifyAll(function(lang)
			return {
				Type = "Info",
				Text = Locale.TFor(lang, "🎉 %s is treating the whole server to a Dopamine Rush!", displayName),
			}
		end, player)
		return T(player, "💎 Thank you! %s Rush started for the whole server!", product.Icon)
	end
	error("type de produit inconnu : " .. tostring(kind))
end

local function processReceipt(receiptInfo)
	local purchaseId = tostring(receiptInfo.PurchaseId)
	local product = Config.ProductsByProductId[receiptInfo.ProductId]
	if not product then
		warn("[MonetizationService] Produit inconnu (ProductId " .. tostring(receiptInfo.ProductId) .. ") : ajoute-le dans Config.Monetization.Products")
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	local data = player and services.DataService:GetData(player)
	if not player or not data or not services.GameService:IsReady(player) then
		-- Joueur absent ou pas encore chargé : Roblox réessaiera plus tard
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	-- Déjà accordé (et sauvegardé avec l'achat) : on confirme sans rien redonner
	if hasProcessed(data, purchaseId) then
		if processing[purchaseId] then
			return Enum.ProductPurchaseDecision.NotProcessedYet -- sauvegarde encore en cours
		end
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	if processing[purchaseId] then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	-- Sans sauvegarde possible (chargement raté), on n'accorde rien en jeu
	-- publié : Roblox redemandera à la prochaine connexion. Dans Studio
	-- (DataStore souvent indisponible), on accorde quand même pour tester.
	local canSave = services.DataService:CanSave(player)
	if not canSave and not RunService:IsStudio() then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	-- Accord + enregistrement du PurchaseId, sans aucune attente entre les deux
	local ok, result, title, tickets = pcall(grantProduct, player, data, product)
	if not ok then
		warn("[MonetizationService] Erreur en accordant " .. tostring(product.Id) .. " :", result)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	recordPurchase(data, purchaseId)

	services.GameService:Notify(player, {
		Type = "Purchase",
		Kind = "Product",
		Id = product.Id,
		Text = result,
		Title = title, -- (nil = titre par défaut du bandeau)
		Tickets = tickets, -- 🎟️ ajoutés (packs de tickets, combos)
	})
	services.GameService:SendState(player)

	if not canSave then
		return Enum.ProductPurchaseDecision.PurchaseGranted -- Studio sans DataStore
	end

	-- On ne confirme à Roblox qu'une fois l'achat sauvegardé. En cas d'échec,
	-- Roblox réessaiera : le PurchaseId est déjà enregistré, on ne redonnera
	-- rien (et si la sauvegarde n'a jamais eu lieu, l'achat sera réaccordé).
	processing[purchaseId] = true
	local saved = false
	local saveOk, saveResult = pcall(function()
		return services.DataService:SaveAsync(player, true)
	end)
	saved = saveOk and saveResult == true
	processing[purchaseId] = nil
	if not saved then
		warn("[MonetizationService] Sauvegarde après l'achat " .. purchaseId .. " impossible : Roblox réessaiera")
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

----------------------------------------------------------------------
-- Données sauvegardées (Boost, Purchases)
----------------------------------------------------------------------

local function sanitizeData(data)
	local boost = data.Boost
	if not isValidNumber(boost.Multiplier) or not isValidNumber(boost.EndsAt)
		or boost.Multiplier < 1 or boost.Multiplier > MAX_BOOST_MULTIPLIER or boost.EndsAt <= os.time() then
		data.Boost = { Multiplier = 1, EndsAt = 0 }
	end

	local purchases = {}
	for _, id in ipairs(data.Purchases) do
		if type(id) == "string" then
			table.insert(purchases, id)
		end
	end
	while #purchases > MAX_PURCHASES_KEPT do
		table.remove(purchases, 1)
	end
	data.Purchases = purchases
end

----------------------------------------------------------------------
-- Commande de test /pass (Studio uniquement, appelée par DebugService)
----------------------------------------------------------------------

function MonetizationService:DebugTogglePass(player: Player, passId: string): boolean?
	local owner = owners[player]
	if not owner or not Config.GamePassesById[passId] then
		return nil
	end
	local owned = not self:OwnsPass(player, passId)
	owner.Debug[passId] = owned
	services.GameService:MarkDirty(player)
	return owned
end

----------------------------------------------------------------------
-- Cycle de vie
----------------------------------------------------------------------

function MonetizationService:PlayerReady(player: Player, data)
	owners[player] = { Passes = {}, Themes = {}, Debug = {}, AutoClickCarry = 0, PendingChecks = 0 }
	sanitizeData(data)
	checkAllPasses(player)
end

function MonetizationService:PlayerRemoving(player: Player)
	owners[player] = nil
end

function MonetizationService:Start()
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId, wasPurchased)
		local ok, err = pcall(onGamePassPurchaseFinished, player, gamePassId, wasPurchased)
		if not ok then
			warn("[MonetizationService] Erreur après l'achat d'un Game Pass :", err)
		end
	end)

	MarketplaceService.ProcessReceipt = function(receiptInfo)
		local ok, decision = pcall(processReceipt, receiptInfo)
		if ok and decision then
			return decision
		end
		warn("[MonetizationService] Erreur ProcessReceipt :", decision)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	if Config.Casino.Enabled and not self:IsCasinoEnabled() then
		print("[Dopamine Clicker] DisableCasinoWhenSelling = true : la machine chanceuse est fermée.")
	end
end

return MonetizationService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="378">
        <Properties>
          <string name="Name">QuestService</string>
          <string name="Source"><![CDATA[--[[
	QuestService (ModuleScript)
	Emplacement : ServerScriptService > Services > QuestService

	Quêtes simples (ex. "Fais 50 clics"). Le joueur a toujours
	Config.Quests.ActiveCount quêtes actives. Une quête terminée donne sa
	récompense automatiquement et est remplacée par une nouvelle.
	  - Un modèle avec une Feature n'est proposé que si le joueur la possède.
	  - Les quêtes n'avancent qu'une fois le menu "Quêtes" débloqué.
	  - Types : Clicks, Earn, Buy, Bounces, Bubbles, Spawns, Combo, Casino, Chests.
	  - Les quêtes sont gardées après une détox.
	  - Chaque quête contient Type, Goal, Progress, Reward et Text. Text est
	    écrit dans la langue du joueur (compatibilité) ; le client devrait
	    plutôt afficher Locale.T(Config.Quests.Pool[Type].Text, Format(Goal))
	    (voir QuestService.GetTemplate / FormatText).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Locale = require(ReplicatedStorage.Shared.Locale)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)

local QuestService = {}

local services
local random = Random.new()

local QUESTS_FEATURE = "Quests"

-- Types de quêtes existants (d'après la config) : [Type] = modèle
local validTypes = {}
local templatesByType = {}
for _, template in ipairs(Config.Quests.Pool) do
	validTypes[template.Type] = true
	templatesByType[template.Type] = template
end

-- Modèle (Config.Quests.Pool) d'un type de quête
function QuestService.GetTemplate(questType: string)
	return templatesByType[questType]
end

-- Texte d'une quête dans la langue `lang` (ex. "Click 50 times" / "Fais 50 clics")
function QuestService.FormatText(lang: string, questType: string, goal: number): string
	local template = templatesByType[questType]
	if not template then
		return ""
	end
	return Locale.TFor(lang, template.Text, NumberFormatter.Format(goal))
end

function QuestService:Init(allServices)
	services = allServices
end

local function isTemplateAvailable(data, template): boolean
	return template.Feature == nil or Formulas.HasFeature(data, template.Feature)
end

-- Crée une nouvelle quête en évitant les types déjà actifs
local function generateQuest(player: Player, data, activeQuests)
	local usedTypes = {}
	for _, quest in ipairs(activeQuests) do
		usedTypes[quest.Type] = true
	end

	local available = {}
	local candidates = {}
	for _, template in ipairs(Config.Quests.Pool) do
		if isTemplateAvailable(data, template) then
			table.insert(available, template)
			if not usedTypes[template.Type] then
				table.insert(candidates, template)
			end
		end
	end
	if #candidates == 0 then
		candidates = (#available > 0) and available or Config.Quests.Pool
	end

	local template = candidates[random:NextInteger(1, #candidates)]
	local stats = services.GameService:GetStats(player)

	local goal
	if template.GoalSeconds then
		-- Objectif "à l'échelle" : X secondes de production
		local seconds = template.GoalSeconds[random:NextInteger(1, #template.GoalSeconds)]
		goal = Formulas.ScaledReward(stats, seconds, template.MinGoal or 100)
	else
		goal = template.Goals[random:NextInteger(1, #template.Goals)]
	end

	return {
		Type = template.Type,
		Goal = goal,
		Progress = 0,
		-- Texte dans la langue du joueur (le client peut le recalculer depuis Type + Goal)
		Text = QuestService.FormatText(services.GameService:GetLanguage(player), template.Type, goal),
		Reward = Formulas.ScaledReward(stats, template.RewardSeconds, template.MinReward),
	}
end

local function isValidQuest(quest): boolean
	return type(quest) == "table"
		and type(quest.Type) == "string"
		and validTypes[quest.Type] == true
		and type(quest.Goal) == "number"
		and type(quest.Progress) == "number"
		and type(quest.Text) == "string"
		and type(quest.Reward) == "number"
end

-- Complète la liste des quêtes si nécessaire (nouveau joueur, config modifiée...)
function QuestService:PlayerReady(player: Player, data)
	-- Nettoie les quêtes invalides ou dont le type n'existe plus dans la config
	local cleaned = {}
	for _, quest in ipairs(data.Quests) do
		if isValidQuest(quest) and #cleaned < Config.Quests.ActiveCount then
			table.insert(cleaned, quest)
		end
	end
	data.Quests = cleaned

	-- Texte réécrit dans la langue actuelle du joueur (elle a pu changer depuis
	-- la dernière partie, ou venir d'une ancienne sauvegarde en français)
	local lang = Locale.ForPlayer(player, data.Settings.Language)
	for _, quest in ipairs(data.Quests) do
		quest.Text = QuestService.FormatText(lang, quest.Type, quest.Goal)
	end

	while #data.Quests < Config.Quests.ActiveCount do
		table.insert(data.Quests, generateQuest(player, data, data.Quests))
	end
end

-- Remplace toutes les quêtes par des nouvelles (à l'échelle de la production actuelle)
function QuestService:Regenerate(player: Player)
	local data = services.DataService:GetData(player)
	if not data then
		return
	end
	data.Quests = {}
	while #data.Quests < Config.Quests.ActiveCount do
		table.insert(data.Quests, generateQuest(player, data, data.Quests))
	end
	services.GameService:MarkDirty(player)
end

-- Fait avancer les quêtes d'un type donné
function QuestService:Progress(player: Player, questType: string, amount: number)
	local data = services.DataService:GetData(player)
	if not data or type(amount) ~= "number" or amount ~= amount or amount <= 0 then
		return
	end
	if not Formulas.HasFeature(data, QUESTS_FEATURE) then
		return -- menu des quêtes pas encore débloqué
	end

	local completed = {}
	for index, quest in ipairs(data.Quests) do
		if quest.Type == questType and quest.Progress < quest.Goal then
			quest.Progress = math.min(quest.Goal, quest.Progress + amount)
			if quest.Progress >= quest.Goal then
				table.insert(completed, index)
			end
		end
	end

	if #completed == 0 then
		return
	end

	-- D'abord on remplace les quêtes terminées, ENSUITE on donne les récompenses
	-- (évite de modifier la liste pendant qu'on la parcourt)
	local rewards = {}
	for _, index in ipairs(completed) do
		local quest = data.Quests[index]
		table.insert(rewards, quest)
		data.Stats.QuestsCompleted += 1
		local others = table.clone(data.Quests)
		table.remove(others, index)
		data.Quests[index] = generateQuest(player, data, others)
	end

	local lang = services.GameService:GetLanguage(player)
	for _, quest in ipairs(rewards) do
		services.GameService:AddDopamine(player, quest.Reward, false)
		services.GameService:Notify(player, {
			Type = "Quest",
			Title = Locale.TFor(lang, "QUEST COMPLETE!"),
			Text = "📜 " .. QuestService.FormatText(lang, quest.Type, quest.Goal)
				.. "  (+" .. NumberFormatter.Format(quest.Reward) .. ")",
			-- Pour que le client puisse réécrire le texte lui-même
			QuestType = quest.Type,
			Goal = quest.Goal,
			Reward = quest.Reward,
		})
	end
	services.GameService:MarkDirty(player)
end

return QuestService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="379">
        <Properties>
          <string name="Name">RaceService</string>
          <string name="Source"><![CDATA[--[[
	RaceService (ModuleScript)
	Emplacement : ServerScriptService > Services > RaceService

	🏁 Courses de rue de Dopamine Town (v10, RACE10). Tout est décidé ICI
	(le client n'annonce jamais ni porte, ni temps, ni place) :
	  - 4 parcours (Config.Race.Routes, géométrie : Shared/RaceRoutes, sur le
	    graphe des rues de LAYOUT10) ; une course à la fois par parcours ;
	  - INSCRIPTION ("join") au QG des courses (à pied, touche E, à moins de
	    Config.Race.JoinRange studs) ou au volant de sa voiture (bouton 🏁
	    du HUD) ; salle d'attente de LobbySeconds (une inscription tardive
	    laisse au moins LateJoinSeconds), 1 à 8 humains, des pilotes IA
	    complètent la grille jusqu'à MinGrid voitures ;
	  - GRILLE : chaque humain est posé à sa place au volant de SA voiture
	    choisie (CarService:RaceSpawn ; sans voiture : une citadine prêtée),
	    voitures GELÉES (CarService:SetFrozen) pendant le 3-2-1 (heure du
	    serveur : les feux sont synchronisés chez tout le monde), puis GO ;
	  - COURSE (10 fois / s) : position de chaque voiture projetée sur la
	    trajectoire -> distance parcourue, portes dans l'ORDRE (largeur de la
	    porte vérifiée), tours, meilleur tour ; ANTI-TRICHE : vitesse
	    plausible sur ~1 s (vitesse de pointe de SA voiture x 1,3), saut
	    instantané -> remis à la dernière porte (3e fois : disqualifié),
	    tronçon plus rapide que possible -> disqualifié (pas de récompense),
	    hors de sa voiture plus de OffCarGrace s -> abandon ;
	  - PILOTES IA simulés ici (profil de vitesse de la trajectoire,
	    habileté 0,90..0,97, voitures d'un niveau proche de celui des
	    humains, élastique léger et JAMAIS au-delà de leur vitesse de pointe,
	    coupé dans les 12 % finaux ; ils changent de file pour doubler un
	    humain au lieu de le traverser). Les clients les dessinent (RaceClient)
	    d'après les instantanés (5 fois / s) ;
	  - ARRIVÉE / RÉSULTATS : classement, RÉCOMPENSE en Dopamine (secondes
	    de production selon la place, adversaires humains, plafond
	    quotidien : RaceRules.Reward), records par parcours (data.Race.Best
	    + tableau du serveur, affiché au QG), voiture prêtée rendue.
	  - Circulation : l'attribut "DopamineRaceRoutes" de Workspace liste les
	    parcours en course (TownTraffic évite leurs rues : RaceRoutes.BlockedEdgeKeys).
	Tout est dans des pcall ; chaque demande a sa limite de fréquence.

	Données : data.Race = { Day, Rewarded, Races, Wins, Podiums, Best = { [routeId] = s } }.
	RemoteEvent "RaceEvent" :
	  C -> S : ("join", routeId) | ("leave") | ("reset") | ("sync")
	  S -> C : ("Lobbies", { [routeId] = { Phase, Count, Names, EndsAt } })
	           ("Board", { [routeId] = { { Name, UserId, Time, CarId } } })
	           ("Joined", { Route, RaceId }) | ("Left", { Route })
	           ("State", instantané) (5 fois / s aux joueurs en ville près d'une course)
	           ("Result", { Route, RaceId, Rows, Mine }) | ("Toast", texte) | ("Reset", { D })
	           ("Grid", { Route, RaceId, GoAt, Slot }) | ("Finished", { Route, Time })
	           ("Me", { Rewarded, Daily, Best, Wins, Races, Podiums })
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local WorldLayout = require(ReplicatedStorage.Shared.WorldLayout)
local CarModels = require(ReplicatedStorage.Shared.CarModels)
local RaceRules = require(ReplicatedStorage.Shared.RaceRules)
local RaceRoutes = require(ReplicatedStorage.Shared.RaceRoutes)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local RateLimiter = require(script.Parent.RateLimiter)

local RaceService = {}

local TICK = 0.1
local SNAPSHOT_EVERY = 0.2
local RESULTS_HOLD = 9 -- s d'affichage des résultats avant de rouvrir le parcours
local PROJECT_WINDOW = 220
local BOARD_SIZE = 8

type Racer = {
	Key: string,
	Player: Player?,
	UserId: number,
	Name: string,
	IsAI: boolean,
	CarId: string,
	Color: string,
	Top: number,
	Accel: number,
	Rating: number,
	Slot: number,
	D: number,
	S: number,
	Lat: number,
	V: number,
	Next: number,
	LastCpD: number,
	Finished: boolean,
	FinishTime: number?,
	Dnf: boolean,
	DnfReason: string?,
	Strikes: number,
	Suspicious: boolean,
	Samples: { { number } }, -- { t, x, z }
	SegStart: number,
	LapStart: number,
	BestLap: number?,
	OffCarSince: number?,
	IgnoreUntil: number,
	LastReset: number,
	-- IA
	Skill: number,
	Lane: number,
	LaneGoal: number,
	Profile: { number }?,
	Place: number,
}

type Race = {
	Id: number,
	RouteId: string,
	Route: any,
	Phase: string, -- "Lobby" | "Grid" | "Countdown" | "Racing" | "Results"
	Racers: { Racer },
	ByPlayer: { [Player]: Racer },
	LobbyEnds: number,
	GoAt: number,
	FirstFinish: number?,
	EndsAt: number,
	PhaseAt: number,
	Results: any?,
}

local services: any = nil
local races: { [string]: Race } = {}
local playerRace: { [Player]: Race } = {}
local board: { [string]: { { Name: string, UserId: number, Time: number, CarId: string } } } = {}
local raceCounter = 0
local lobbiesDirty = true
local boardDirty = true
local profiles: { [string]: { number } } = {}

----------------------------------------------------------------------
-- Outils
----------------------------------------------------------------------

local function now(): number
	local ok, t = pcall(function()
		return workspace:GetServerTimeNow()
	end)
	if ok and type(t) == "number" then
		return t
	end
	return os.clock()
end

local function T(player: Player, text: string, ...): string
	if services and services.GameService then
		return services.GameService:T(player, text, ...)
	end
	if select("#", ...) > 0 then
		return string.format(text, ...)
	end
	return text
end

local function dataOf(player: Player): any
	return services and services.DataService and services.DataService:GetData(player) or nil
end

local function plotCount(): number
	return WorldLayout.PlotCount(Players.MaxPlayers)
end

local function inTown(player: Player): boolean
	local world = services and services.WorldService
	if world and type(world.IsInTown) == "function" then
		local ok, result = pcall(world.IsInTown, world, player)
		return ok and result == true
	end
	return false
end

local function fire(player: Player, kind: string, payload: any)
	pcall(function()
		Net.Event("RaceEvent"):FireClient(player, kind, payload)
	end)
end

local function townPlayers(): { Player }
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if inTown(p) then
			table.insert(list, p)
		end
	end
	return list
end

local function toast(player: Player, text: string)
	fire(player, "Toast", text)
end

local raceData: (player: Player) -> any

-- Ses chiffres (menu : courses payées aujourd'hui, records, victoires)
local function pushMe(player: Player)
	local rd = raceData(player)
	if rd then
		local daily = (Config.Race and Config.Race.Rewards and Config.Race.Rewards.DailyRewarded) or 8
		fire(player, "Me", { Rewarded = rd.Rewarded, Daily = daily, Best = rd.Best, Wins = rd.Wins, Races = rd.Races, Podiums = rd.Podiums })
	end
end

raceData = function(player: Player): any?
	local data = dataOf(player)
	if type(data) ~= "table" then
		return nil
	end
	data.Race = RaceRules.SanitizeData(data.Race, RaceRules.Today(os.time()))
	return data.Race
end

-- Voiture pilotée : (modèle, racine, au volant ?)
local function carOf(player: Player): (Model?, BasePart?, boolean)
	local cs = services and services.CarService
	if not cs or type(cs.GetCar) ~= "function" then
		return nil, nil, false
	end
	local ok, model = pcall(cs.GetCar, cs, player)
	if not ok or not model or not model.Parent then
		return nil, nil, false
	end
	local root = model.PrimaryPart or model:FindFirstChild("Root")
	local seat = model:FindFirstChild("DriverSeat", true)
	local driving = false
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if seat and seat:IsA("VehicleSeat") and humanoid then
		driving = seat.Occupant == humanoid
	end
	if root and not root:IsA("BasePart") then
		root = nil
	end
	return model, root :: BasePart?, driving
end

-- Performances de la voiture d'un humain (celle qu'il conduit, avec sa préparation)
local function statsOf(player: Player): any
	local model = carOf(player)
	local carId = model and model:GetAttribute("CarId")
	local cs = services and services.CarService
	local stats = nil
	if cs and type(cs.GetStats) == "function" then
		local ok, s = pcall(cs.GetStats, cs, player, if type(carId) == "string" then carId else nil)
		if ok and type(s) == "table" then
			stats = s
		end
	end
	if not stats then
		stats = CarModels.Stats(if type(carId) == "string" then carId else "CityCar", nil)
	end
	return stats
end

local function profileFor(race: Race, top: number): { number }
	local key = race.RouteId .. ":" .. tostring(math.floor(top + 0.5))
	local p = profiles[key]
	if not p then
		p = RaceRules.SpeedProfile(race.Route.Line, math.floor(top + 0.5))
		profiles[key] = p
	end
	return p
end

local function lineS(race: Race, d: number): number
	local route = race.Route
	if route.Closed then
		return d % route.Total
	end
	return route.StartS + d
end

----------------------------------------------------------------------
-- Tableau des records (serveur) + salles d'attente
----------------------------------------------------------------------

local function recordBest(routeId: string, player: Player, time: number, carId: string)
	local list = board[routeId] or {}
	board[routeId] = list
	for i, row in ipairs(list) do
		if row.UserId == player.UserId then
			if time >= row.Time then
				return
			end
			table.remove(list, i)
			break
		end
	end
	table.insert(list, { Name = player.DisplayName, UserId = player.UserId, Time = time, CarId = carId })
	table.sort(list, function(a, b)
		return a.Time < b.Time
	end)
	while #list > BOARD_SIZE do
		table.remove(list)
	end
	boardDirty = true
end

local function lobbiesPayload(): any
	local out = {}
	for id, race in pairs(races) do
		local names = {}
		for _, r in ipairs(race.Racers) do
			if not r.IsAI then
				table.insert(names, r.Name)
			end
		end
		out[id] = { Phase = race.Phase, Count = #names, Names = names, EndsAt = race.LobbyEnds, RaceId = race.Id }
	end
	return out
end

local function pushLobbies(target: Player?)
	local payload = lobbiesPayload()
	if target then
		fire(target, "Lobbies", payload)
		return
	end
	for _, p in ipairs(townPlayers()) do
		fire(p, "Lobbies", payload)
	end
end

local function pushBoard(target: Player?)
	if target then
		fire(target, "Board", board)
		return
	end
	for _, p in ipairs(townPlayers()) do
		fire(p, "Board", board)
	end
end

local function setActiveAttribute()
	local ids = {}
	for id, race in pairs(races) do
		if race.Phase == "Grid" or race.Phase == "Countdown" or race.Phase == "Racing" then
			table.insert(ids, id)
		end
	end
	table.sort(ids)
	pcall(function()
		workspace:SetAttribute(RaceRoutes.ACTIVE_ATTRIBUTE, table.concat(ids, ","))
	end)
end

----------------------------------------------------------------------
-- Instantané (clients)
----------------------------------------------------------------------

local function snapshot(race: Race): any
	local rows = {}
	for _, r in ipairs(race.Racers) do
		table.insert(rows, {
			K = r.Key,
			N = r.Name,
			U = r.UserId,
			AI = r.IsAI,
			C = r.CarId,
			Col = r.Color,
			D = math.floor(r.D * 10) / 10,
			V = math.floor(r.V * 10) / 10,
			L = math.floor((if r.IsAI then r.Lane else r.Lat) * 10) / 10,
			Nx = r.Next,
			Pl = r.Place,
			F = r.Finished,
			T = r.FinishTime,
			X = r.Dnf,
			B = r.BestLap,
		})
	end
	return {
		Id = race.Id,
		Route = race.RouteId,
		Phase = race.Phase,
		GoAt = race.GoAt,
		Now = now(),
		EndsAt = race.EndsAt,
		Racers = rows,
	}
end

----------------------------------------------------------------------
-- Inscription / départ
----------------------------------------------------------------------

local function newRace(routeId: string): Race?
	local route = RaceRoutes.Get(routeId, plotCount())
	if not route then
		return nil
	end
	raceCounter += 1
	local race: Race = {
		Id = raceCounter,
		RouteId = routeId,
		Route = route,
		Phase = "Lobby",
		Racers = {},
		ByPlayer = {},
		LobbyEnds = now() + ((Config.Race and Config.Race.LobbySeconds) or 20),
		GoAt = 0,
		FirstFinish = nil,
		EndsAt = 0,
		PhaseAt = now(),
		Results = nil,
	}
	races[routeId] = race
	return race
end

local function newRacer(player: Player?, index: number): Racer
	return {
		Key = if player then "P" .. player.UserId else "AI" .. index,
		Player = player,
		UserId = if player then player.UserId else 0,
		Name = if player then player.DisplayName else "",
		IsAI = player == nil,
		CarId = "CityCar",
		Color = "",
		Top = 50,
		Accel = 24,
		Rating = 300,
		Slot = index,
		D = 0,
		S = 0,
		Lat = 0,
		V = 0,
		Next = 1,
		LastCpD = 0,
		Finished = false,
		FinishTime = nil,
		Dnf = false,
		DnfReason = nil,
		Strikes = 0,
		Suspicious = false,
		Samples = {},
		SegStart = 0,
		LapStart = 0,
		BestLap = nil,
		OffCarSince = nil,
		IgnoreUntil = 0,
		LastReset = 0,
		Skill = 1,
		Lane = 0,
		LaneGoal = 0,
		Profile = nil,
		Place = index,
	}
end

local function removeRacer(race: Race, player: Player)
	local racer = race.ByPlayer[player]
	race.ByPlayer[player] = nil
	playerRace[player] = nil
	if racer then
		local i = table.find(race.Racers, racer)
		if i then
			table.remove(race.Racers, i)
		end
	end
	lobbiesDirty = true
end

local function join(player: Player, routeId: any): (boolean, string?)
	if type(routeId) ~= "string" or not Config.RaceRoutesById[routeId] then
		return false, T(player, "Invalid request")
	end
	if not inTown(player) then
		return false, T(player, "Walk around the town first")
	end
	if raceData(player) == nil then
		return false, T(player, "Loading...")
	end
	local current = playerRace[player]
	if current then
		if current.RouteId == routeId then
			return true, nil
		end
		if current.Phase ~= "Lobby" then
			return false, T(player, "Finish your race first!")
		end
		removeRacer(current, player)
	end
	-- au QG (à pied) ou au volant de sa voiture
	local _, root, driving = carOf(player)
	local near = false
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		local meet = RaceRoutes.MeetCFrame(plotCount()).Position
		local flat = Vector3.new(hrp.Position.X - meet.X, 0, hrp.Position.Z - meet.Z)
		near = flat.Magnitude <= ((Config.Race and Config.Race.JoinRange) or 45)
	end
	if not near and not (driving and root) then
		return false, T(player, "Join at the race meeting point, or from your car 🏁")
	end
	local race = races[routeId]
	if race and race.Phase ~= "Lobby" then
		return false, T(player, "A race is running on this route: try another one!")
	end
	if not race then
		race = newRace(routeId)
		if not race then
			return false, T(player, "This route is not available")
		end
	end
	local humans = 0
	for _, r in ipairs(race.Racers) do
		if not r.IsAI then
			humans += 1
		end
	end
	if humans >= ((Config.Race and Config.Race.MaxRacers) or 8) then
		return false, T(player, "This race is full")
	end
	local racer = newRacer(player, humans + 1)
	table.insert(race.Racers, racer)
	race.ByPlayer[player] = racer
	playerRace[player] = race
	local late = now() + ((Config.Race and Config.Race.LateJoinSeconds) or 8)
	if race.LobbyEnds < late then
		race.LobbyEnds = late
	end
	lobbiesDirty = true
	fire(player, "Joined", { Route = routeId, RaceId = race.Id, EndsAt = race.LobbyEnds })
	return true, nil
end

-- Pilotes IA : voitures d'un niveau proche de celui des humains
local function addAI(race: Race)
	local cfgRace = Config.Race or {}
	local ai = cfgRace.AI or {}
	local want = (cfgRace.MinGrid or 4) - #race.Racers
	if want <= 0 then
		return
	end
	local ratings = {}
	for _, r in ipairs(race.Racers) do
		table.insert(ratings, r.Rating)
	end
	table.sort(ratings)
	local target = ratings[math.max(1, math.ceil(#ratings / 2))] or 300
	local kinds = {}
	for _, kind in ipairs(CarModels.Kinds or {}) do
		local s = CarModels.Stats(kind, nil)
		table.insert(kinds, { Kind = kind, Rating = s.Rating })
	end
	table.sort(kinds, function(a, b)
		return math.abs(a.Rating - target) < math.abs(b.Rating - target)
	end)
	local colors = (Config.Cars and Config.Cars.Colors) or {}
	local names = ai.Names or { "Nina" }
	local skills = ai.Skill or { 0.93 }
	local seed = race.Id * 7 + #race.Route.Line.X
	for k = 1, want do
		local index = #race.Racers + 1
		local racer = newRacer(nil, index)
		local pick = kinds[((k - 1) % math.max(1, math.min(3, #kinds))) + 1]
		local kind = pick and pick.Kind or "CityCar"
		local stats = CarModels.Stats(kind, nil)
		racer.CarId = kind
		racer.Color = colors[((seed + k * 5) % math.max(1, #colors)) + 1] and colors[((seed + k * 5) % math.max(1, #colors)) + 1].Id or ""
		racer.Name = "🤖 " .. names[((seed + k) % #names) + 1]
		racer.Top = stats.TopSpeed
		racer.Accel = stats.Accel
		racer.Rating = stats.Rating
		racer.Skill = skills[((seed + k * 3) % #skills) + 1]
		table.insert(race.Racers, racer)
	end
end

local function startGrid(race: Race)
	race.Phase = "Grid"
	race.PhaseAt = now()
	lobbiesDirty = true
	local cs = services and services.CarService
	-- humains : à leur place au volant, voitures gelées
	local slot = 0
	for _, racer in ipairs(table.clone(race.Racers)) do
		local player = racer.Player
		if player then
			local ok, message = false, nil
			if player.Parent and inTown(player) and cs and type(cs.RaceSpawn) == "function" then
				slot += 1
				racer.Slot = slot
				local okCall, a, b = pcall(cs.RaceSpawn, cs, player, RaceRoutes.GridCFrame(race.Route, slot))
				ok, message = okCall and a == true, if okCall then b else tostring(a)
			end
			if not ok then
				slot -= 1
				removeRacer(race, player)
				fire(player, "Left", { Route = race.RouteId })
				if player.Parent then
					toast(player, T(player, "Could not start the race: %s", tostring(message or "?")))
				end
			else
				pcall(cs.SetFrozen, cs, player, true)
				local stats = statsOf(player)
				local model = carOf(player)
				racer.CarId = model and tostring(model:GetAttribute("CarId") or stats.CarId) or stats.CarId
				racer.Top = RaceRules.Finite(stats.TopSpeed, 50)
				racer.Accel = RaceRules.Finite(stats.Accel, 24)
				racer.Rating = RaceRules.Finite(stats.Rating, 300)
			end
		end
	end
	if next(race.ByPlayer) == nil then
		races[race.RouteId] = nil
		lobbiesDirty = true
		setActiveAttribute()
		return
	end
	addAI(race)
	-- IA : places restantes de la grille
	for _, racer in ipairs(race.Racers) do
		if racer.IsAI then
			slot += 1
			racer.Slot = slot
			local g = race.Route.Grid[math.clamp(slot, 1, #race.Route.Grid)]
			racer.D = -g.Back
			local side = if (slot - 1) % 2 == 0 then -RaceRoutes.GRID_SIDE else RaceRoutes.GRID_SIDE
			racer.Lane = side
			racer.LaneGoal = side
			racer.Profile = profileFor(race, racer.Top)
		end
	end
	-- humains : distance de départ (derrière la ligne)
	for _, racer in ipairs(race.Racers) do
		if not racer.IsAI then
			local g = race.Route.Grid[math.clamp(racer.Slot, 1, #race.Route.Grid)]
			racer.D = -g.Back
			racer.S = lineS(race, racer.D)
		end
	end
	setActiveAttribute()
	local cfgRace = Config.Race or {}
	race.GoAt = now() + (cfgRace.GridSeconds or 3) + (cfgRace.CountdownSeconds or 3)
	race.EndsAt = race.GoAt + (cfgRace.MaxSeconds or 480)
	for player in pairs(race.ByPlayer) do
		fire(player, "Grid", { Route = race.RouteId, RaceId = race.Id, GoAt = race.GoAt, Slot = race.ByPlayer[player].Slot })
	end
end

local function go(race: Race)
	race.Phase = "Racing"
	race.PhaseAt = now()
	local cs = services and services.CarService
	for player, racer in pairs(race.ByPlayer) do
		racer.SegStart = race.GoAt
		racer.LapStart = race.GoAt
		racer.IgnoreUntil = race.GoAt + 0.5
		table.clear(racer.Samples)
		if cs and type(cs.SetFrozen) == "function" then
			pcall(cs.SetFrozen, cs, player, false)
		end
	end
	for _, racer in ipairs(race.Racers) do
		racer.SegStart = race.GoAt
		racer.LapStart = race.GoAt
	end
	lobbiesDirty = true
end

----------------------------------------------------------------------
-- Pendant la course
----------------------------------------------------------------------

local function dnf(race: Race, racer: Racer, reason: string)
	if racer.Finished or racer.Dnf then
		return
	end
	racer.Dnf = true
	racer.DnfReason = reason
	local player = racer.Player
	if player and player.Parent then
		toast(player, T(player, reason))
	end
end

-- Porte franchie (dans l'ordre) : temps minimal du tronçon, tour, arrivée
local function passCheckpoints(race: Race, racer: Racer, t: number)
	local cps = race.Route.Checkpoints
	while racer.Next <= #cps do
		local cp = cps[racer.Next]
		if racer.D < cp.D - 1 then
			break
		end
		if math.abs(racer.Lat) > cp.W / 2 + 6 then
			-- à côté de la porte : il faut revenir la prendre
			break
		end
		local seg = cp.D - racer.LastCpD
		if not racer.IsAI and t - racer.SegStart < RaceRules.MinSegmentTime(seg, racer.Top) then
			racer.Suspicious = true
		end
		racer.LastCpD = cp.D
		racer.SegStart = t
		racer.Next += 1
		-- tour bouclé (boucle : la porte de la ligne de départ)
		if race.Route.Closed and (cp.S < 1 or cp.Finish) then
			local lap = t - racer.LapStart
			racer.LapStart = t
			if lap > 3 and (racer.BestLap == nil or lap < (racer.BestLap :: number)) then
				racer.BestLap = lap
			end
		end
		if cp.Finish then
			racer.Finished = true
			racer.FinishTime = t - race.GoAt
			if not race.Route.Closed then
				racer.BestLap = racer.FinishTime
			end
			if not racer.IsAI and race.FirstFinish == nil then
				race.FirstFinish = t
			end
			local player = racer.Player
			if player then
				fire(player, "Finished", { Route = race.RouteId, Time = racer.FinishTime })
			end
			break
		end
	end
end

local function updateHuman(race: Race, racer: Racer, t: number)
	local player = racer.Player :: Player
	if not player.Parent or not inTown(player) then
		dnf(race, racer, "You left the race")
		return
	end
	local _, root, driving = carOf(player)
	if not driving or not root then
		racer.OffCarSince = racer.OffCarSince or t
		if t - (racer.OffCarSince :: number) > ((Config.Race and Config.Race.OffCarGrace) or 5) then
			dnf(race, racer, "You left your car: race over")
		end
		racer.V = 0
		return
	end
	racer.OffCarSince = nil
	local origin = WorldLayout.Origin()
	local x, z = root.Position.X - origin.X, root.Position.Z - origin.Z
	local anti = (Config.Race and Config.Race.Anti) or {}
	-- saut / vitesse (fenêtre d'~1 s)
	local samples = racer.Samples
	local last = samples[#samples]
	if t >= racer.IgnoreUntil and last then
		local jump = math.sqrt((x - last[2]) ^ 2 + (z - last[3]) ^ 2)
		if RaceRules.CheckMove(jump, t - last[1], racer.Top) == "teleport" then
			warn(string.format("[RaceService] %s : saut de %.0f studs en %.2f s (%.0f, %.0f) -> (%.0f, %.0f)", player.Name, jump, t - last[1], last[2], last[3], x, z))
			racer.Strikes += 1
			table.clear(samples)
			if racer.Strikes >= (anti.MaxStrikes or 3) then
				racer.Suspicious = true
				dnf(race, racer, "Disqualified: impossible moves")
				return
			end
			-- remis à la dernière porte
			local cs = services and services.CarService
			if cs and type(cs.RaceSpawn) == "function" then
				pcall(cs.RaceSpawn, cs, player, RaceRoutes.CFrameAtD(race.Route, racer.LastCpD - 6))
			end
			racer.D = racer.LastCpD - 6
			racer.S = lineS(race, racer.D)
			racer.IgnoreUntil = t + 1
			toast(player, T(player, "Back to the last checkpoint"))
			return
		end
	end
	table.insert(samples, { t, x, z })
	while #samples > 2 and t - samples[1][1] > 1.2 do
		table.remove(samples, 1)
	end
	local first = samples[1]
	local span = t - first[1]
	if span >= 0.5 and t >= racer.IgnoreUntil then
		local dist = math.sqrt((x - first[2]) ^ 2 + (z - first[3]) ^ 2)
		racer.V = dist / span
		if RaceRules.CheckMove(dist, span, racer.Top) == "fast" then
			racer.Suspicious = true
		end
	end
	-- progression sur la trajectoire
	local route = race.Route
	local s, lat, off = RaceRules.Project(route.Line, x, z, racer.S, PROJECT_WINDOW)
	if off > route.Width / 2 + 60 then
		return -- perdu loin de la route : la progression attend
	end
	racer.Lat = lat
	if route.Closed then
		local delta = s - racer.S
		local half = route.Total / 2
		if delta > half then
			delta -= route.Total
		elseif delta < -half then
			delta += route.Total
		end
		racer.D += delta
	else
		racer.D = s - route.StartS
	end
	racer.S = s
	passCheckpoints(race, racer, t)
end

local function updateAI(race: Race, racer: Racer, t: number, dt: number, leadD: number?)
	local route = race.Route
	local profile = racer.Profile or profileFor(race, racer.Top)
	racer.Profile = profile
	local s = lineS(race, racer.D)
	local target = RaceRules.ProfileAt(route.Line, profile, s) * racer.Skill * RaceRules.RubberBand(racer.D, leadD, route.RaceDistance)
	-- un humain juste devant dans la même file : on change de file (ou on suit)
	local halfRoad = math.max(4, route.Width / 2 - 3)
	local blocked = false
	for _, other in ipairs(race.Racers) do
		if other ~= racer and not other.Dnf and not other.Finished then
			local gap = other.D - racer.D
			if gap > 0 and gap < 24 and math.abs((if other.IsAI then other.Lane else other.Lat) - racer.Lane) < 4.6 then
				blocked = true
				local otherLat = if other.IsAI then other.Lane else other.Lat
				racer.LaneGoal = math.clamp(if otherLat > 0 then otherLat - 6 else otherLat + 6, -halfRoad, halfRoad)
				if gap < 12 then
					target = math.min(target, other.V)
				end
			end
		end
	end
	if not blocked and math.abs(racer.LaneGoal) > 0.1 and t - race.GoAt > 4 then
		-- retour doux vers la trajectoire
		racer.LaneGoal *= 0.98
	end
	racer.Lane += math.clamp(racer.LaneGoal - racer.Lane, -3 * dt, 3 * dt)
	local before = racer.D
	RaceRules.AIStep(racer :: any, dt, target, racer.Top, racer.Accel, (Config.Race and Config.Race.AI and Config.Race.AI.Brake) or 38)
	racer.Lat = racer.Lane
	racer.S = lineS(race, racer.D)
	-- portes (l'IA reste sur sa trajectoire : largeur toujours bonne)
	if racer.D > before then
		local cps = route.Checkpoints
		while racer.Next <= #cps and racer.D >= cps[racer.Next].D do
			local cp = cps[racer.Next]
			racer.Next += 1
			racer.LastCpD = cp.D
			if cp.Finish then
				racer.Finished = true
				-- instant exact du franchissement (interpolé)
				local frac = if racer.D > before then (cp.D - before) / (racer.D - before) else 1
				racer.FinishTime = (t - dt + dt * math.clamp(frac, 0, 1)) - race.GoAt
				break
			end
		end
	end
end

local function rank(race: Race)
	local rows = {}
	for _, r in ipairs(race.Racers) do
		local cps = race.Route.Checkpoints
		local cap = if r.Next <= #cps then cps[r.Next].D else race.Route.RaceDistance
		table.insert(rows, { Key = r.Key, Racer = r, Finished = r.Finished, FinishTime = r.FinishTime, Progress = math.min(r.D, cap + 0.5), Dnf = r.Dnf })
	end
	for place, row in ipairs(RaceRules.Standings(rows)) do
		row.Racer.Place = place
	end
end

----------------------------------------------------------------------
-- Fin de course : classement, récompenses, records
----------------------------------------------------------------------

local function finish(race: Race)
	race.Phase = "Results"
	race.PhaseAt = now()
	-- IA encore en route : temps estimé (distance restante à leur vitesse moyenne)
	local t = now()
	for _, r in ipairs(race.Racers) do
		if r.IsAI and not r.Finished then
			local elapsed = math.max(1, t - race.GoAt)
			local avg = math.max(8, (r.D + 1) / elapsed)
			r.Finished = true
			r.FinishTime = elapsed + math.max(0, race.Route.RaceDistance - r.D) / avg
		end
	end
	rank(race)
	local humans = 0
	for _, r in ipairs(race.Racers) do
		if not r.IsAI then
			humans += 1
		end
	end
	local rows = {}
	local ordered = table.clone(race.Racers)
	table.sort(ordered, function(a, b)
		return a.Place < b.Place
	end)
	local cs = services and services.CarService
	local mine: { [Player]: any } = {}
	for _, r in ipairs(ordered) do
		local reward, seconds, capped = 0, 0, false
		local player = r.Player
		if player and player.Parent then
			local rd = raceData(player)
			if rd then
				if not r.Suspicious then
					local stats = services and services.GameService and services.GameService:GetStats(player)
					reward, seconds, capped = RaceRules.Reward(stats, r.Place, r.Finished, humans - 1, rd.Rewarded)
				end
				if reward > 0 and services and services.GameService then
					services.GameService:AddDopamine(player, reward)
					rd.Rewarded += 1
				end
				rd.Races += 1
				if r.Finished and not r.Suspicious then
					if r.Place == 1 then
						rd.Wins += 1
					end
					if r.Place <= 3 then
						rd.Podiums += 1
					end
					local best = r.BestLap
					if best and best > 3 then
						local old = rd.Best[race.RouteId]
						if old == nil or best < old then
							rd.Best[race.RouteId] = best
						end
						recordBest(race.RouteId, player, best, r.CarId)
					end
				end
				if services and services.GameService then
					services.GameService:MarkDirty(player)
				end
			end
			mine[player] = { Place = r.Place, Reward = reward, Seconds = seconds, Capped = capped, Suspicious = r.Suspicious,
				Left = math.max(0, ((Config.Race and Config.Race.Rewards and Config.Race.Rewards.DailyRewarded) or 8) - (rd and rd.Rewarded or 0)) }
		end
		table.insert(rows, {
			Place = r.Place,
			Name = r.Name,
			UserId = r.UserId,
			AI = r.IsAI,
			CarId = r.CarId,
			Color = r.Color,
			Time = r.FinishTime,
			BestLap = r.BestLap,
			Finished = r.Finished,
			Dnf = r.Dnf,
			Reward = if player then (mine[player] and mine[player].Reward or 0) else 0,
		})
	end
	race.Results = rows
	for player, racer in pairs(race.ByPlayer) do
		if cs and type(cs.RaceRelease) == "function" then
			pcall(cs.RaceRelease, cs, player)
		end
		local m = mine[player] or { Place = racer.Place, Reward = 0 }
		if player.Parent then
			fire(player, "Result", { Route = race.RouteId, RaceId = race.Id, Rows = rows, Mine = m, Humans = humans })
			pushMe(player)
			if m.Reward and m.Reward > 0 then
				toast(player, T(player, "🏁 +%s Dopamine!", NumberFormatter.Format(m.Reward)))
			elseif m.Capped then
				toast(player, T(player, "Daily race rewards reached: records still count!"))
			end
		end
		playerRace[player] = nil
	end
	table.clear(race.ByPlayer)
	lobbiesDirty = true
	setActiveAttribute()
end

----------------------------------------------------------------------
-- Boucle
----------------------------------------------------------------------

local function stepRace(race: Race, dt: number)
	local t = now()
	local cfgRace = Config.Race or {}
	if race.Phase == "Lobby" then
		-- humains partis
		for _, r in ipairs(table.clone(race.Racers)) do
			local p = r.Player
			if p and (not p.Parent or not inTown(p)) then
				removeRacer(race, p)
			end
		end
		if #race.Racers == 0 then
			races[race.RouteId] = nil
			lobbiesDirty = true
			return
		end
		if t >= race.LobbyEnds or #race.Racers >= (cfgRace.MaxRacers or 8) then
			startGrid(race)
		end
	elseif race.Phase == "Grid" then
		if t >= race.GoAt - (cfgRace.CountdownSeconds or 3) then
			race.Phase = "Countdown"
			race.PhaseAt = t
		end
	elseif race.Phase == "Countdown" then
		if t >= race.GoAt then
			go(race)
		end
	elseif race.Phase == "Racing" then
		local leadD: number? = nil
		for _, r in ipairs(race.Racers) do
			if not r.IsAI and not r.Dnf and not r.Finished then
				updateHuman(race, r, t)
			end
		end
		for _, r in ipairs(race.Racers) do
			if not r.IsAI and not r.Dnf then
				local d = if r.Finished then race.Route.RaceDistance else r.D
				if leadD == nil or d > (leadD :: number) then
					leadD = d
				end
			end
		end
		for _, r in ipairs(race.Racers) do
			if r.IsAI and not r.Finished then
				updateAI(race, r, t, dt, leadD)
			end
		end
		rank(race)
		-- fin : tous les humains arrivés / abandonnés, délai après le 1er, durée max
		local running = false
		for _, r in ipairs(race.Racers) do
			if not r.IsAI and not r.Finished and not r.Dnf then
				running = true
			end
		end
		local graceOver = race.FirstFinish ~= nil and t - (race.FirstFinish :: number) > (cfgRace.FinishGrace or 35)
		if not running or graceOver or t >= race.EndsAt then
			for _, r in ipairs(race.Racers) do
				if not r.Finished and not r.Dnf and not r.IsAI then
					dnf(race, r, "Time's up!")
				end
			end
			finish(race)
		end
	elseif race.Phase == "Results" then
		if t - race.PhaseAt > RESULTS_HOLD then
			races[race.RouteId] = nil
			lobbiesDirty = true
		end
	end
end

local snapClock = 0
local snapRound = 0
local function tick(dt: number)
	for _, race in pairs(races) do
		local ok, err = pcall(stepRace, race, dt)
		if not ok then
			warn("[RaceService] " .. tostring(err))
		end
	end
	snapClock += dt
	if snapClock >= SNAPSHOT_EVERY then
		snapClock = 0
		local active = {}
		for _, race in pairs(races) do
			if race.Phase ~= "Lobby" then
				table.insert(active, snapshot(race))
			end
		end
		-- coureurs : 5 fois / s ; spectateurs en ville : 2,5 fois / s (50 joueurs)
		snapRound += 1
		if #active > 0 then
			for _, p in ipairs(townPlayers()) do
				if playerRace[p] ~= nil or snapRound % 2 == 0 then
					fire(p, "State", active)
				end
			end
		end
		if lobbiesDirty then
			lobbiesDirty = false
			pushLobbies()
		end
		if boardDirty then
			boardDirty = false
			pushBoard()
		end
	end
end

----------------------------------------------------------------------
-- Demandes des clients
----------------------------------------------------------------------

local function leave(player: Player)
	local race = playerRace[player]
	if not race then
		return
	end
	if race.Phase == "Lobby" then
		removeRacer(race, player)
		fire(player, "Left", { Route = race.RouteId })
		return
	end
	local racer = race.ByPlayer[player]
	if racer and (race.Phase == "Racing" or race.Phase == "Grid" or race.Phase == "Countdown") then
		dnf(race, racer, "You left the race")
		local cs = services and services.CarService
		if cs and type(cs.RaceRelease) == "function" then
			pcall(cs.RaceRelease, cs, player)
		end
		race.ByPlayer[player] = nil
		playerRace[player] = nil
		fire(player, "Left", { Route = race.RouteId })
	end
end

local function resetToCheckpoint(player: Player)
	local race = playerRace[player]
	local racer = race and race.ByPlayer[player]
	if not race or not racer or race.Phase ~= "Racing" or racer.Finished or racer.Dnf then
		return
	end
	local t = now()
	if t - racer.LastReset < ((Config.Race and Config.Race.ResetCooldown) or 3) then
		return
	end
	racer.LastReset = t
	local cs = services and services.CarService
	if cs and type(cs.RaceSpawn) == "function" then
		local d = math.max(racer.LastCpD - 6, -RaceRoutes.GRID_FIRST)
		local ok = pcall(cs.RaceSpawn, cs, player, RaceRoutes.CFrameAtD(race.Route, d))
		if ok then
			racer.D = d
			racer.S = lineS(race, d)
			racer.Lat = 0
			racer.IgnoreUntil = t + 1
			table.clear(racer.Samples)
			fire(player, "Reset", { D = d })
		end
	end
end

local function onEvent(player: Player, kind: any, arg: any)
	if type(kind) ~= "string" then
		return
	end
	if not RateLimiter.Check(player, "Race_" .. kind, if kind == "sync" then 1 else 0.4) then
		return
	end
	if kind == "join" then
		local ok, message = join(player, arg)
		if not ok and message then
			toast(player, message)
		end
	elseif kind == "leave" then
		leave(player)
	elseif kind == "reset" then
		resetToCheckpoint(player)
	elseif kind == "sync" then
		pushLobbies(player)
		pushBoard(player)
		pushMe(player)
		local race = playerRace[player]
		if race then
			fire(player, "Joined", { Route = race.RouteId, RaceId = race.Id, EndsAt = race.LobbyEnds })
		end
	end
end

----------------------------------------------------------------------
-- Cycle de vie
----------------------------------------------------------------------

function RaceService:Init(allServices)
	services = allServices
end

function RaceService:Start()
	pcall(function()
		workspace:SetAttribute(RaceRoutes.ACTIVE_ATTRIBUTE, "")
	end)
	-- parcours calculés d'avance (le 1er joueur n'attend pas)
	task.spawn(function()
		local ok, err = pcall(RaceRoutes.All, plotCount())
		if not ok then
			warn("[RaceService] Parcours : " .. tostring(err))
		end
	end)
	Net.Event("RaceEvent").OnServerEvent:Connect(function(player: Player, kind: any, arg: any)
		local ok, err = pcall(onEvent, player, kind, arg)
		if not ok then
			warn("[RaceService] Erreur pour " .. player.Name .. " : " .. tostring(err))
		end
	end)
	local clock = 0
	RunService.Heartbeat:Connect(function(dt: number)
		clock += dt
		if clock >= TICK then
			local step = math.min(clock, 0.5)
			clock = 0
			tick(step)
		end
	end)
end

function RaceService:PlayerReady(player: Player, data)
	data.Race = RaceRules.SanitizeData(data.Race, RaceRules.Today(os.time()))
	-- ses records (sauvegardés) rejoignent le tableau du serveur
	for routeId, best in pairs(data.Race.Best) do
		recordBest(routeId, player, best, "")
	end
end

function RaceService:PlayerRemoving(player: Player)
	local race = playerRace[player]
	if race then
		pcall(leave, player)
		removeRacer(race, player)
	end
	playerRace[player] = nil
end

-- (tests / autres services) la course d'un joueur (id du parcours) ou nil
function RaceService:RaceOf(player: Player): string?
	local race = playerRace[player]
	return race and race.RouteId or nil
end

-- (tests) accès interne
function RaceService:Debug(): any
	return {
		Races = races,
		Board = board,
		Tick = tick,
		Join = join,
		Leave = leave,
		Reset = resetToCheckpoint,
		Now = now,
	}
end

return RaceService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="380">
        <Properties>
          <string name="Name">RateLimiter</string>
          <string name="Source"><![CDATA[--[[
	RateLimiter (ModuleScript)
	Emplacement : ServerScriptService > Services > RateLimiter

	Anti-spam simple : empêche un joueur d'appeler une action plus souvent
	que l'intervalle donné (protection contre les exploits qui spamment
	les RemoteEvents).
]]

local Players = game:GetService("Players")

local RateLimiter = {}

-- [Player] = { [clé] = dernière heure d'appel }
local lastCalls = {}

-- Renvoie true si l'action est autorisée, false si le joueur va trop vite
function RateLimiter.Check(player: Player, key: string, interval: number): boolean
	local now = os.clock()
	local playerCalls = lastCalls[player]
	if not playerCalls then
		playerCalls = {}
		lastCalls[player] = playerCalls
	end

	local last = playerCalls[key]
	if last and now - last < interval then
		return false
	end
	playerCalls[key] = now
	return true
end

Players.PlayerRemoving:Connect(function(player)
	lastCalls[player] = nil
end)

return RateLimiter
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="381">
        <Properties>
          <string name="Name">ThemeService</string>
          <string name="Source"><![CDATA[--[[
	ThemeService (ModuleScript)
	Emplacement : ServerScriptService > Services > ThemeService

	Thèmes (fonds d'écran, Config.Themes), gardés pour toujours (même après
	l'océan). Un thème est possédé s'il a été acheté avec la Dopamine
	(data.Themes.Owned), si c'est un thème Premium et que le joueur est VIP,
	ou si le joueur possède le Game Pass du thème (vérifié par
	MonetizationService). RemoteFunction ThemeShop ("buy" | "equip", themeId).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Net = require(ReplicatedStorage.Shared.Net)
local RateLimiter = require(script.Parent.RateLimiter)

local ThemeService = {}

local services

local DEFAULT_THEME = Config.ThemesById.Classic and "Classic" or (Config.Themes[1] and Config.Themes[1].Id) or "Classic"

local function isValidNumber(value): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

function ThemeService:Init(allServices)
	services = allServices
end

-- Le joueur possède-t-il ce thème (achat, VIP ou Game Pass) ?
function ThemeService:Owns(player: Player, themeId: string): boolean
	local theme = Config.ThemesById[themeId]
	if not theme then
		return false
	end
	local data = services.DataService:GetData(player)
	if data and data.Themes.Owned[themeId] == true then
		return true
	end
	if theme.Premium and services.MonetizationService:IsVIP(player) then
		return true
	end
	return services.MonetizationService:OwnsThemePass(player, themeId)
end

-- État envoyé au client : { Owned = { [id] = true }, Equipped = id }
function ThemeService:GetState(player: Player)
	local owned = {}
	for _, theme in ipairs(Config.Themes) do
		if self:Owns(player, theme.Id) then
			owned[theme.Id] = true
		end
	end
	-- Le thème équipé n'est pas effacé des données s'il n'est plus possédé
	-- (vérification des Game Passes pas encore finie) : on affiche juste le thème par défaut.
	local data = services.DataService:GetData(player)
	local equipped = data and data.Themes.Equipped
	if type(equipped) ~= "string" or not owned[equipped] then
		equipped = DEFAULT_THEME
	end
	return { Owned = owned, Equipped = equipped }
end

-- Texte dans la langue du joueur
local function T(player: Player, text: string, ...): string
	return services.GameService:T(player, text, ...)
end

local function onThemeShop(player: Player, action: any, themeId: any)
	if not RateLimiter.Check(player, "ThemeShop", 0.2) then
		return false, T(player, "Slow down!")
	end
	local data = services.DataService:GetData(player)
	if not data or not services.GameService:IsReady(player) then
		return false, T(player, "Loading...")
	end
	if type(action) ~= "string" or type(themeId) ~= "string" or #themeId > 64 then
		return false, T(player, "Invalid request")
	end
	local theme = Config.ThemesById[themeId]
	if not theme then
		return false, T(player, "Unknown theme")
	end
	local themes = data.Themes
	local name = T(player, theme.Name)

	if action == "buy" then
		if ThemeService:Owns(player, themeId) then
			return false, T(player, "You already own this theme")
		end
		local cost = theme.Cost
		if cost == nil then
			if theme.Premium then
				return false, T(player, "This theme is unlocked with Robux (or the VIP pass)")
			end
			return false, T(player, "This theme is unlocked with Robux")
		end
		if not isValidNumber(cost) or cost < 0 then
			return false, T(player, "Theme unavailable")
		end
		-- (v9.3) Thèmes verrouillés par les visites à l'océan (RequiresRebirths)
		if not Formulas.IsThemeUnlocked(data, theme) then
			return false, T(player, "🔒 Unlocked after %d visits to the ocean", Formulas.GetRequiredRebirths(theme))
		end
		if data.Dopamine < cost then
			return false, T(player, "Not enough %s", Config.Game.CurrencyName)
		end
		data.Dopamine -= cost
		themes.Owned[themeId] = true
		themes.Equipped = themeId -- équipé tout de suite
		data.Stats.ThemesBought += 1
		services.GameService:SendState(player)
		return true, T(player, "%s %s theme bought! (%s)", theme.Icon, name, NumberFormatter.Format(cost))
	elseif action == "equip" then
		if not ThemeService:Owns(player, themeId) then
			return false, T(player, "You don't own this theme")
		end
		themes.Equipped = themeId
		services.GameService:SendState(player)
		return true, T(player, "%s %s theme equipped", theme.Icon, name)
	end
	return false, T(player, "Invalid request")
end

-- Commande de test /theme (Studio) : donne et équipe un thème
function ThemeService:DebugGrant(player: Player, themeId: string): boolean
	local data = services.DataService:GetData(player)
	if not data or not Config.ThemesById[themeId] then
		return false
	end
	data.Themes.Owned[themeId] = true
	data.Themes.Equipped = themeId
	services.GameService:MarkDirty(player)
	return true
end

-- Corrige une sauvegarde abîmée (thème supprimé de la config...)
function ThemeService:PlayerReady(player: Player, data)
	local themes = data.Themes
	for id, value in pairs(themes.Owned) do
		if value ~= true or type(id) ~= "string" or not Config.ThemesById[id] then
			themes.Owned[id] = nil
		end
	end
	themes.Owned[DEFAULT_THEME] = true
	if type(themes.Equipped) ~= "string" or not Config.ThemesById[themes.Equipped] then
		themes.Equipped = DEFAULT_THEME
	end
end

function ThemeService:Start()
	Net.Function("ThemeShop").OnServerInvoke = onThemeShop
end

return ThemeService
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="382">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="383">
          <Properties>
            <string name="Name">NPCSeatGuard</string>
            <string name="Source"><![CDATA[--[[
	NPCSeatGuard (ModuleScript)
	Emplacement : ServerScriptService > Services > World > NPCSeatGuard

	v9.9 (NPC99) 🪑 "Si un PNJ est assis, je ne m'assois pas DANS lui : je
	m'assois à côté."

	Les passants assis sur les bancs sont construits côté client (TownPeople),
	mais leurs places sont DÉTERMINISTES (NPCSeats.BenchPlan(graine de
	l'emplacement "SitBench")). Le serveur connaît donc exactement les places
	prises. Pour chaque emplacement "SitBench" publié (StreetLife) on retrouve
	le Seat du banc (le plus proche, ≤ 1,5 stud à l'horizontale) puis :
	  - banc PLEIN (2 PNJ) : Seat.Disabled = true (on ne s'y assoit plus) ;
	  - sinon, quand un joueur s'assoit (Roblox crée la soudure "SeatWeld"),
	    la soudure est décalée le long du banc vers la place LIBRE la plus
	    proche de l'avatar : tout le monde le voit à côté du PNJ (soudure du
	    serveur, répliquée) ;
	  - attributs sur le Seat : NpcSlots = "10" / "01" / "11" / "00",
	    NpcSlotX = "-1.3,1.3" (pour les invites "S'asseoir" éventuelles) ;
	  - publie StreetLife > NpcBenches (attribut Data : lignes
	    "x;y;z;dessus;masque") : TownPeople y lit la hauteur exacte du siège.

	API :
	  NPCSeatGuard.Apply(townRoot) -> number   (bancs gardés) ; à appeler
	    APRÈS TownKit.PublishLife (fin de TownMap.Build). Sans danger si
	    rappelé (reconstruction de la ville).
	  NPCSeatGuard.SlotFor(seat, position) -> number? (x local de la place)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local NPCSeats = require(ReplicatedStorage.Shared.NPCSeats)

local NPCSeatGuard = {}

local MATCH_RADIUS = 1.5

type Spot = { Pos: Vector3, Seed: number }

local conns: { RBXScriptConnection } = {}

local function readSpots(life: Instance): { Spot }
	local spots = {}
	for _, child in ipairs(life:GetChildren()) do
		local text = child:GetAttribute("Data")
		if child.Name ~= "NpcBenches" and type(text) == "string" then
			for _, line in ipairs(string.split(text, "\n")) do
				local f = string.split(line, ";")
				if f[1] == "SitBench" then
					local x, y, z = tonumber(f[2]), tonumber(f[3]), tonumber(f[4])
					if x and y and z then
						table.insert(spots, { Pos = Vector3.new(x, y, z), Seed = tonumber(f[6]) or 0 })
					end
				end
			end
		end
	end
	return spots
end

-- x local (le long du banc) de la place libre la plus proche de `position`
function NPCSeatGuard.SlotFor(seat: BasePart, position: Vector3): number?
	local mask = seat:GetAttribute("NpcSlots")
	if type(mask) ~= "string" then
		return nil
	end
	local rel = seat.CFrame:PointToObjectSpace(position).X
	local best, bestD = nil, math.huge
	for i, x in ipairs(NPCSeats.BENCH_SLOTS) do
		if string.sub(mask, i, i) ~= "1" then
			local d = math.abs(x - rel)
			if d < bestD then
				best, bestD = x, d
			end
		end
	end
	return best
end

local function guard(seat: Seat)
	table.insert(
		conns,
		seat.ChildAdded:Connect(function(child)
			if child.Name ~= "SeatWeld" or not child:IsA("Weld") then
				return
			end
			local weld = child :: Weld
			local root = weld.Part1
			if not root then
				return
			end
			local x = NPCSeatGuard.SlotFor(seat, root.Position)
			if x then
				-- (décalage le long du banc, dans le repère du Seat)
				weld.C0 = CFrame.new(x, 0, 0) * weld.C0
			end
		end)
	)
end

function NPCSeatGuard.Apply(townRoot: Instance): number
	for _, c in ipairs(conns) do
		c:Disconnect()
	end
	table.clear(conns)
	local life = townRoot:FindFirstChild("StreetLife")
	if not life then
		return 0
	end
	local spots = readSpots(life)
	if #spots == 0 then
		return 0
	end
	local seats: { Seat } = {}
	for _, d in ipairs(townRoot:GetDescendants()) do
		if d:IsA("Seat") then
			table.insert(seats, d)
		end
	end
	local lines = {}
	local count = 0
	for _, spot in ipairs(spots) do
		local best: Seat? = nil
		local bestD = MATCH_RADIUS
		for _, seat in ipairs(seats) do
			local p = seat.Position
			local dy = p.Y - spot.Pos.Y
			local d = Vector3.new(p.X - spot.Pos.X, 0, p.Z - spot.Pos.Z).Magnitude
			if d < bestD and dy > 0.2 and dy < 3 then
				best, bestD = seat, d
			end
		end
		if best then
			local plan = NPCSeats.BenchPlan(spot.Seed)
			local top = best.Position.Y + best.Size.Y / 2 - spot.Pos.Y
			best:SetAttribute("NpcSlots", plan.Mask)
			best:SetAttribute("NpcSlotX", table.concat(NPCSeats.BENCH_SLOTS, ","))
			if plan.Mask == "11" then
				best.Disabled = true
			elseif plan.Mask ~= "00" then
				guard(best)
			end
			table.insert(lines, string.format("%.2f;%.2f;%.2f;%.3f;%s", spot.Pos.X, spot.Pos.Y, spot.Pos.Z, top, plan.Mask))
			count += 1
		end
	end
	local old = life:FindFirstChild("NpcBenches")
	if old then
		old:Destroy()
	end
	local cfg = Instance.new("Configuration")
	cfg.Name = "NpcBenches"
	cfg:SetAttribute("Data", table.concat(lines, "\n"))
	cfg:SetAttribute("Count", count)
	cfg.Parent = life
	return count
end

return NPCSeatGuard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="384">
          <Properties>
            <string name="Name">TownBuildings</string>
            <string name="Source"><![CDATA[--[[
	TownBuildings (ModuleScript)
	Emplacement : ServerScriptService > Services > World > TownBuildings

	🏪 Les bâtiments du centre-ville (décor, v9.4) :
	  - BOUTIQUES autour de la place et le long de l'avenue : façade en
	    enduit / brique, rez-de-chaussée vitré (vitrines éclairées, porte),
	    store rayé, enseigne (SurfaceGui), étages avec fenêtres encadrées,
	    appuis, volets, jardinières, corniches, toit (tuiles, ardoises ou
	    toit-terrasse), cheminée, gouttière ; un détail par métier (terrasse
	    de café, cornet géant, néons de l'arcade, bretzel de la boulangerie,
	    seaux de fleurs, gobelet de bubble tea, marquise du cinéma...) ;
	  - la MAIRIE au fond de la place : portique à colonnes, fronton,
	    tour de l'horloge, et le GRAND ÉCRAN des meilleurs joueurs du serveur
	    (SurfaceGui mis à jour par TownMap) ;
	  - silhouette lointaine d'une ville (au-delà des collines) ;
	  - (v9.7, BUILDINGS97) IMMEUBLES DE RUE en 5 styles (Haussmann, briques,
	    pastel à pignon, moderne, colombages) : coque ici, détail en flux
	    côté client (Client/World/TownFacades) ; boutiques de décor et mairie
	    finies sur toutes leurs faces (arrière, côtés), pancarte "Fermé".
	v9.6 : ces boutiques restent du DÉCOR (portes fermées) ; celles où l'on
	entre sont dans TownShops (qui réutilise Window / GableRoof d'ici).
	Plus de néon sur les grandes surfaces (marquise, bandeaux, portail de la
	mairie, cœur de la flèche) : SmoothPlastic / verre ; lumière de l'écran
	adoucie (portée 18, luminosité 0,8).
	Repère d'un bâtiment : `cf` = milieu du pied de la façade, LookVector
	vers la rue ; le volume est derrière (+Z local).
]]

local TownKit = require(script.Parent.TownKit)

local TownBuildings = {}

local M = TownKit.M
local C = TownKit.C
local part = TownKit.Part
local hash = TownKit.Hash

export type ShopSpec = {
	Kind: string,
	Sign: string,
	W: number,
	D: number,
	Floors: number,
	Wall: Color3,
	Material: Enum.Material?,
	Trim: Color3?,
	Awning: { Color3 },
	Roof: string, -- "Gable" | "Flat"
	RoofColor: Color3?,
	SignColor: Color3?,
	Shutters: Color3?,
}

-- Les boutiques (ordre de placement autour de la place puis sur l'avenue)
TownBuildings.SHOPS = {
	{ Kind = "Cafe", Sign = "☕ Café Mochi", W = 28, D = 20, Floors = 3, Wall = Color3.fromRGB(255, 214, 222), Material = M.Plaster, Awning = { Color3.fromRGB(236, 90, 130), C.White }, Roof = "Gable", RoofColor = Color3.fromRGB(150, 84, 90), Shutters = Color3.fromRGB(120, 190, 170) },
	{ Kind = "IceCream", Sign = "🍦 Gelato Cloud", W = 24, D = 18, Floors = 2, Wall = Color3.fromRGB(196, 240, 222), Material = M.Plaster, Awning = { Color3.fromRGB(120, 210, 190), C.White }, Roof = "Flat", SignColor = Color3.fromRGB(236, 90, 150) },
	{ Kind = "Arcade", Sign = "🕹️ Pixel Arcade", W = 30, D = 22, Floors = 2, Wall = Color3.fromRGB(96, 80, 150), Material = M.Brick, Awning = { Color3.fromRGB(80, 60, 130), Color3.fromRGB(255, 90, 200) }, Roof = "Flat", SignColor = Color3.fromRGB(90, 240, 255) },
	{ Kind = "Bakery", Sign = "🥐 Sweet Bakery", W = 26, D = 20, Floors = 3, Wall = Color3.fromRGB(255, 236, 196), Material = M.Plaster, Awning = { Color3.fromRGB(214, 150, 90), C.Cream }, Roof = "Gable", RoofColor = Color3.fromRGB(120, 110, 130), Shutters = Color3.fromRGB(150, 110, 200) },
	{ Kind = "Flowers", Sign = "🌷 Petal Shop", W = 22, D = 18, Floors = 2, Wall = Color3.fromRGB(226, 214, 255), Material = M.Plaster, Awning = { Color3.fromRGB(150, 200, 110), C.White }, Roof = "Gable", RoofColor = Color3.fromRGB(96, 110, 150), Shutters = Color3.fromRGB(236, 130, 170) },
	{ Kind = "Boba", Sign = "🧋 Boba Bubble", W = 24, D = 18, Floors = 2, Wall = Color3.fromRGB(255, 226, 180), Material = M.Brick, Awning = { Color3.fromRGB(170, 120, 90), C.Cream }, Roof = "Flat", SignColor = Color3.fromRGB(150, 90, 60) },
	{ Kind = "Books", Sign = "📚 Story Nook", W = 26, D = 20, Floors = 3, Wall = Color3.fromRGB(190, 222, 255), Material = M.Plaster, Awning = { Color3.fromRGB(80, 120, 200), C.White }, Roof = "Gable", RoofColor = Color3.fromRGB(90, 96, 120), Shutters = Color3.fromRGB(255, 255, 255) },
	{ Kind = "Toys", Sign = "🧸 Plushie Palace", W = 28, D = 20, Floors = 2, Wall = Color3.fromRGB(255, 196, 170), Material = M.Plaster, Awning = { Color3.fromRGB(255, 150, 90), C.White }, Roof = "Gable", RoofColor = Color3.fromRGB(170, 90, 100) },
	{ Kind = "Cinema", Sign = "🎬 Dream Cinema", W = 32, D = 24, Floors = 2, Wall = Color3.fromRGB(236, 96, 110), Material = M.Brick, Awning = { Color3.fromRGB(60, 50, 70), Color3.fromRGB(255, 214, 96) }, Roof = "Flat", SignColor = Color3.fromRGB(255, 214, 96) },
	{ Kind = "Pizza", Sign = "🍕 Pizza Luna", W = 24, D = 18, Floors = 3, Wall = Color3.fromRGB(255, 244, 214), Material = M.Plaster, Awning = { Color3.fromRGB(220, 70, 70), C.White }, Roof = "Gable", RoofColor = Color3.fromRGB(176, 96, 70), Shutters = Color3.fromRGB(90, 150, 100) },
	{ Kind = "Music", Sign = "🎧 Vinyl Vibes", W = 24, D = 18, Floors = 2, Wall = Color3.fromRGB(170, 214, 200), Material = M.Brick, Awning = { Color3.fromRGB(60, 60, 80), Color3.fromRGB(120, 230, 200) }, Roof = "Flat", SignColor = Color3.fromRGB(60, 60, 80) },
	{ Kind = "Candy", Sign = "🍭 Candy Pop", W = 24, D = 18, Floors = 2, Wall = Color3.fromRGB(255, 186, 222), Material = M.Plaster, Awning = { Color3.fromRGB(255, 110, 170), Color3.fromRGB(255, 240, 120) }, Roof = "Gable", RoofColor = Color3.fromRGB(130, 100, 170), Shutters = C.White },
	{ Kind = "Gym", Sign = "💪 Brain Gym", W = 28, D = 20, Floors = 2, Wall = Color3.fromRGB(210, 214, 226), Material = M.Concrete, Awning = { Color3.fromRGB(70, 80, 110), Color3.fromRGB(140, 200, 255) }, Roof = "Flat", SignColor = Color3.fromRGB(70, 80, 110) },
} :: { ShopSpec }

local GROUND_H = 10 -- rez-de-chaussée
local FLOOR_H = 8.5 -- étages

-- Fenêtre encadrée (cadre, vitre, appui ; volets / jardinière en option)
local function window(parent: Instance, cf: CFrame, w: number, h: number, trim: Color3, shutters: Color3?, flowers: boolean, seed: number)
	part(parent, "WinFrame", Vector3.new(w + 0.8, h + 0.8, 0.3), cf * CFrame.new(0, 0, -0.1), trim, M.SmoothPlastic, "deco")
	local glass = part(parent, "WinGlass", Vector3.new(w, h, 0.3), cf * CFrame.new(0, 0, -0.16), Color3.fromRGB(150, 196, 226), M.Glass, "deco")
	glass.Reflectance = 0.15
	part(parent, "WinBar", Vector3.new(0.25, h - 0.1, 0.35), cf * CFrame.new(0, 0, -0.18), trim, M.SmoothPlastic, "deco")
	part(parent, "Sill", Vector3.new(w + 1.4, 0.35, 0.8), cf * CFrame.new(0, -h / 2 - 0.5, -0.4), trim, M.Concrete, "deco")
	if shutters then
		for _, sx in ipairs({ -1, 1 }) do
			part(parent, "Shutter", Vector3.new(w / 2, h + 0.4, 0.2), cf * CFrame.new(sx * (w * 0.75 + 0.55), 0, -0.2), shutters, M.WoodPlanks, "deco")
		end
	end
	if flowers then
		part(parent, "FlowerBox", Vector3.new(w + 0.8, 0.8, 0.9), cf * CFrame.new(0, -h / 2 - 1.1, -0.6), C.Wood, M.WoodPlanks, "deco")
		part(parent, "Blooms", Vector3.new(w + 0.4, 0.7, 0.7), cf * CFrame.new(0, -h / 2 - 0.45, -0.6), TownKit.FLOWERS[seed % #TownKit.FLOWERS + 1], M.Grass, "deco")
	end
end

-- Toit à deux pans (faîtage parallèle à la façade), débord de 0,8
local function gableRoof(parent: Instance, cf: CFrame, w: number, d: number, h: number, color: Color3)
	local half = d / 2 + 0.8
	TownKit.Wedge(parent, "Roof", Vector3.new(w + 1.6, h, half), cf * CFrame.new(0, h / 2, d / 2 - half / 2), color, M.ClayRoofTiles, "decoS")
	TownKit.Wedge(parent, "Roof", Vector3.new(w + 1.6, h, half), cf * CFrame.new(0, h / 2, d / 2 + half / 2) * CFrame.Angles(0, math.pi, 0), color, M.ClayRoofTiles, "decoS")
	part(parent, "Ridge", Vector3.new(w + 1.8, 0.5, 0.8), cf * CFrame.new(0, h + 0.1, d / 2), color:Lerp(Color3.new(0, 0, 0), 0.25), M.Slate, "deco")
	-- (v9.7) plus de coins "pignon" : ils étaient ENFERMÉS dans le toit
	-- (invisibles) et leurs faces se confondaient avec celles du toit
end

-- (v9.6) partagés avec TownShops (boutiques où l'on entre)
TownBuildings.Window = window
TownBuildings.GableRoof = gableRoof
TownBuildings.GROUND_H = GROUND_H
TownBuildings.FLOOR_H = FLOOR_H

-- Détail propre à chaque métier (devant / sur la boutique)
local function shopExtras(parent: Instance, cf: CFrame, spec: ShopSpec, height: number)
	local kind = spec.Kind
	local w = spec.W
	if kind == "Cafe" or kind == "Pizza" then
		-- terrasse : tables rondes + parasols
		for i, x in ipairs({ -w * 0.3, w * 0.3 }) do
			local base = (cf * CFrame.new(x, 0, -7)).Position
			TownKit.Column(parent, "TableLeg", base, 2.6, 0.3, C.Metal, M.Metal, "prop")
			TownKit.Disc(parent, "TableTop", base + Vector3.new(0, 2.8, 0), 1.5, 0.2, C.White, M.Marble, "deco")
			TownKit.Column(parent, "UmbrellaPole", base + Vector3.new(0, 2.8, 0), 4.6, 0.2, C.White, M.Metal, "deco")
			local canopy = TownKit.Disc(parent, "Umbrella", base + Vector3.new(0, 7.3, 0), 3.8, 0.5, spec.Awning[1], M.Fabric, "deco")
			canopy.CastShadow = true
			TownKit.Disc(parent, "UmbrellaTop", base + Vector3.new(0, 7.8, 0), 2.2, 0.5, i == 1 and C.White or spec.Awning[1], M.Fabric, "deco")
			for _, cx in ipairs({ -2.2, 2.2 }) do
				part(parent, "Chair", Vector3.new(1.3, 0.3, 1.3), CFrame.new(base + Vector3.new(cx, 1.6, 0)), C.Metal, M.Metal, "prop")
				part(parent, "ChairBack", Vector3.new(0.2, 1.6, 1.3), CFrame.new(base + Vector3.new(cx + (cx > 0 and 0.6 or -0.6), 2.5, 0)), C.Metal, M.Metal, "deco")
			end
		end
	elseif kind == "IceCream" then
		local top = cf * CFrame.new(0, height + 0.6, 2)
		TownKit.Wedge(parent, "Cone", Vector3.new(1, 6, 2.2), top * CFrame.new(0, 3, 0) * CFrame.Angles(math.pi, 0, 0), Color3.fromRGB(226, 170, 100), M.WoodPlanks, "deco")
		TownKit.Column(parent, "ConeTop", (top * CFrame.new(0, 5.6, 0)).Position, 0.6, 3.6, Color3.fromRGB(226, 170, 100), M.WoodPlanks, "deco")
		TownKit.Ball(parent, "Scoop", (top * CFrame.new(0, 7.4, 0)).Position, 4.4, Color3.fromRGB(255, 170, 200), M.SmoothPlastic, "decoS")
		TownKit.Ball(parent, "Scoop2", (top * CFrame.new(0, 10, 0)).Position, 3.4, Color3.fromRGB(170, 236, 200), M.SmoothPlastic, "decoS")
		TownKit.Ball(parent, "Cherry", (top * CFrame.new(0, 12.1, 0)).Position, 1.1, Color3.fromRGB(230, 40, 70), M.SmoothPlastic, "deco")
	elseif kind == "Arcade" or kind == "Cinema" then
		-- cadre de néons autour de l'enseigne + marquise à ampoules
		local signY = GROUND_H + 1.6
		local neon = spec.SignColor or C.Pink
		part(parent, "NeonTop", Vector3.new(w * 0.78, 0.3, 0.3), cf * CFrame.new(0, signY + 1.6, -0.9), neon, M.SmoothPlastic, "deco")
		part(parent, "NeonBottom", Vector3.new(w * 0.78, 0.3, 0.3), cf * CFrame.new(0, signY - 1.6, -0.9), neon, M.SmoothPlastic, "deco")
		if kind == "Cinema" then
			part(parent, "Marquee", Vector3.new(w * 0.6, 1.2, 5), cf * CFrame.new(0, GROUND_H - 1.2, -3), Color3.fromRGB(60, 50, 70), M.Metal, "deco")
			part(parent, "MarqueeLights", Vector3.new(w * 0.6 + 0.2, 0.3, 5.2), cf * CFrame.new(0, GROUND_H - 1.9, -3), Color3.fromRGB(255, 226, 150), M.SmoothPlastic, "deco")
		else
			part(parent, "NeonStripe", Vector3.new(0.3, height - 2, 0.3), cf * CFrame.new(-w / 2 + 0.6, height / 2, -0.3), Color3.fromRGB(90, 240, 255), M.SmoothPlastic, "deco")
			part(parent, "NeonStripe", Vector3.new(0.3, height - 2, 0.3), cf * CFrame.new(w / 2 - 0.6, height / 2, -0.3), Color3.fromRGB(255, 90, 200), M.SmoothPlastic, "deco")
		end
	elseif kind == "Bakery" then
		-- enseigne suspendue (potence + médaillon)
		local anchor = cf * CFrame.new(w / 2 - 2, GROUND_H + 3.2, 0)
		part(parent, "Bracket", Vector3.new(0.25, 0.25, 3.4), anchor * CFrame.new(0, 0, -1.7), C.Metal, M.Metal, "deco")
		local medal = part(parent, "Medallion", Vector3.new(0.3, 2.6, 2.6), anchor * CFrame.new(0, -1.6, -2.6) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(214, 160, 90), M.Wood, "deco")
		;(medal :: Part).Shape = Enum.PartType.Cylinder
		-- baguettes dans un panier devant la vitrine
		local basket = (cf * CFrame.new(-w * 0.28, 0, -1.6)).Position
		part(parent, "Basket", Vector3.new(3, 1.4, 1.4), CFrame.new(basket + Vector3.new(0, 0.7, 0)), C.WoodLight, M.Fabric, "prop")
		for i = -1, 1 do
			part(parent, "Baguette", Vector3.new(0.5, 3.4, 0.5), CFrame.new(basket + Vector3.new(i * 0.8, 2, 0)) * CFrame.Angles(0, 0, math.rad(i * 10)), Color3.fromRGB(226, 170, 100), M.SmoothPlastic, "deco")
		end
	elseif kind == "Flowers" then
		for i = -2, 2 do
			local base = (cf * CFrame.new(i * 2.2, 0, -1.8)).Position
			TownKit.Column(parent, "Bucket", base, 1.3, 1.4, C.MetalLight, M.Metal, "prop")
			TownKit.Ball(parent, "Bouquet", base + Vector3.new(0, 2, 0), 1.8, TownKit.FLOWERS[(i + 3) % #TownKit.FLOWERS + 1], M.SmoothPlastic, "deco")
		end
	elseif kind == "Boba" then
		local top = (cf * CFrame.new(w * 0.25, height + 0.6, 3)).Position
		TownKit.Column(parent, "Cup", top, 7, 4.2, Color3.fromRGB(255, 236, 214), M.Glass, "deco").Transparency = 0.15
		TownKit.Column(parent, "Tea", top + Vector3.new(0, 0.2, 0), 5, 3.9, Color3.fromRGB(200, 150, 110), M.SmoothPlastic, "deco")
		TownKit.Column(parent, "Lid", top + Vector3.new(0, 7, 0), 0.6, 4.4, C.White, M.SmoothPlastic, "deco")
		TownKit.Column(parent, "Straw", top + Vector3.new(0.6, 6, 0), 4.5, 0.6, Color3.fromRGB(255, 120, 170), M.SmoothPlastic, "deco")
		for i = 0, 3 do
			TownKit.Ball(parent, "Pearl", top + Vector3.new(math.cos(i * 1.6) * 1.1, 0.9, math.sin(i * 1.6) * 1.1), 1.1, Color3.fromRGB(60, 40, 40), M.SmoothPlastic, "deco")
		end
	elseif kind == "Candy" then
		local base = (cf * CFrame.new(-w / 2 + 1.5, 0, -1.8)).Position
		TownKit.Column(parent, "LollipopStick", base, 6, 0.4, C.White, M.SmoothPlastic, "prop")
		local lolly = part(parent, "Lollipop", Vector3.new(0.6, 3.4, 3.4), CFrame.new(base + Vector3.new(0, 7.4, 0)) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(255, 120, 180), M.SmoothPlastic, "deco")
		;(lolly :: Part).Shape = Enum.PartType.Cylinder
		local swirl = part(parent, "Swirl", Vector3.new(0.7, 1.8, 1.8), CFrame.new(base + Vector3.new(0, 7.4, 0)) * CFrame.Angles(0, math.rad(90), 0), C.White, M.SmoothPlastic, "deco")
		;(swirl :: Part).Shape = Enum.PartType.Cylinder
	end
end

-- Une boutique complète (≈ 40 à 55 pièces)
function TownBuildings.Shop(parent: Instance, cf: CFrame, spec: ShopSpec, seed: number): Model
	local model = TownKit.Model(parent, "Shop_" .. spec.Kind)
	local w, d = spec.W, spec.D
	local height = GROUND_H + (spec.Floors - 1) * FLOOR_H
	local trim = spec.Trim or C.White
	local mat = spec.Material or M.Plaster
	-- volume principal + socle
	part(model, "Body", Vector3.new(w, height, d), cf * CFrame.new(0, height / 2, d / 2), spec.Wall, mat, "solid")
	part(model, "Plinth", Vector3.new(w + 0.4, 1.2, d + 0.4), cf * CFrame.new(0, 0.6, d / 2), C.StoneDark, M.Granite, "prop")
	-- rez-de-chaussée : devanture (cadre sombre, vitrines éclairées, porte)
	local frameColor = spec.Awning[1]:Lerp(Color3.new(0, 0, 0), 0.35)
	part(model, "Shopfront", Vector3.new(w - 1.6, GROUND_H - 2.4, 0.4), cf * CFrame.new(0, 1.2 + (GROUND_H - 2.4) / 2, -0.15), frameColor, M.Wood, "deco")
	local doorW = 3.4
	for _, sx in ipairs({ -1, 1 }) do
		local ww = (w - 1.6 - doorW) / 2 - 1.2
		local x = sx * (doorW / 2 + 0.6 + ww / 2)
		part(model, "Interior", Vector3.new(ww, GROUND_H - 4.2, 0.2), cf * CFrame.new(x, 1.2 + (GROUND_H - 2.4) / 2 + 0.1, -0.38), Color3.fromRGB(255, 222, 178), M.SmoothPlastic, "deco")
		local glass = part(model, "ShopWindow", Vector3.new(ww, GROUND_H - 4.2, 0.2), cf * CFrame.new(x, 1.2 + (GROUND_H - 2.4) / 2 + 0.1, -0.5), Color3.fromRGB(190, 226, 246), M.Glass, "deco")
		glass.Transparency = 0.45
		glass.Reflectance = 0.2
	end
	part(model, "Door", Vector3.new(doorW, 7, 0.3), cf * CFrame.new(0, 1.2 + 3.5, -0.42), spec.Awning[1], M.Wood, "deco")
	part(model, "DoorGlass", Vector3.new(doorW - 1.2, 3.6, 0.3), cf * CFrame.new(0, 1.2 + 4.6, -0.5), Color3.fromRGB(190, 226, 246), M.Glass, "deco")
	part(model, "Knob", Vector3.new(0.35, 0.35, 0.35), cf * CFrame.new(doorW / 2 - 0.5, 1.2 + 3.2, -0.65), C.Yellow, M.Metal, "deco")
	part(model, "Step", Vector3.new(doorW + 1.2, 0.4, 1.2), cf * CFrame.new(0, 0.2, -0.6), C.Stone, M.Concrete, "prop")
	-- store rayé (lames inclinées) + lambrequin
	local stripes = math.max(4, math.floor((w - 2) / 2.6))
	local sw = (w - 2) / stripes
	local tilt = CFrame.Angles(math.rad(22), 0, 0)
	for i = 1, stripes do
		local x = -(w - 2) / 2 + (i - 0.5) * sw
		part(model, "Awning", Vector3.new(sw, 0.2, 3.6), cf * CFrame.new(x, GROUND_H - 1.1, -1.7) * tilt, spec.Awning[i % 2 + 1], M.Fabric, i == 1 and "decoS" or "deco")
	end
	part(model, "Valance", Vector3.new(w - 2, 0.7, 0.15), cf * CFrame.new(0, GROUND_H - 2.1, -3.4), spec.Awning[1], M.Fabric, "deco")
	-- enseigne (texte traduisible côté client)
	local signColor = spec.SignColor or C.HotPink
	local board = part(model, "SignBoard", Vector3.new(w * 0.72, 2.6, 0.4), cf * CFrame.new(0, GROUND_H + 1.6, -0.3), C.Cream, M.Wood, "deco")
	local _, body = TownKit.Surface(board, Enum.NormalId.Front, 30, nil, 360, 0.5)
	local label = TownKit.Label(body, "Title", spec.Sign, 0.03, 0.08, 0.94, 0.84, signColor, Enum.Font.FredokaOne, false)
	local stroke = Instance.new("UIStroke")
	stroke.Color = C.White
	stroke.Thickness = 2
	stroke.Parent = label
	-- étages : bandeaux + fenêtres
	local nWin = math.max(2, math.floor(w / 8.5))
	for f = 1, spec.Floors - 1 do
		local y = GROUND_H + (f - 1) * FLOOR_H
		part(model, "Band", Vector3.new(w + 0.6, 0.6, 0.7), cf * CFrame.new(0, y + 0.3, -0.05), trim, M.Concrete, "deco")
		for i = 1, nWin do
			local x = -w / 2 + (i - 0.5) * w / nWin
			local flowers = (i + f + seed) % 3 == 0
			window(model, cf * CFrame.new(x, y + FLOOR_H / 2 + 0.6, 0), 3.2, 4.4, trim, spec.Shutters, flowers, seed + i)
		end
	end
	-- corniche + toit
	part(model, "Cornice", Vector3.new(w + 1.2, 1, d + 1.2), cf * CFrame.new(0, height + 0.5, d / 2), trim, M.Concrete, "decoS")
	local top = cf * CFrame.new(0, height + 1, 0)
	if spec.Roof == "Gable" then
		gableRoof(model, top, w, d, math.min(9, d * 0.42), spec.RoofColor or Color3.fromRGB(150, 90, 90))
		part(model, "Chimney", Vector3.new(2, 5, 2), top * CFrame.new(w * 0.3, 4.5, d * 0.7), Color3.fromRGB(176, 110, 96), M.Brick, "deco")
		-- lucarne
		part(model, "Dormer", Vector3.new(4, 3.6, 3), top * CFrame.new(-w * 0.2, 2.2, d * 0.22), spec.Wall, mat, "deco")
		part(model, "DormerGlass", Vector3.new(2.2, 2, 0.2), top * CFrame.new(-w * 0.2, 2.2, d * 0.22 - 1.55), Color3.fromRGB(150, 196, 226), M.Glass, "deco")
		part(model, "DormerRoof", Vector3.new(4.8, 0.4, 3.6), top * CFrame.new(-w * 0.2, 4.2, d * 0.22), spec.RoofColor or Color3.fromRGB(150, 90, 90), M.Slate, "deco")
	else
		part(model, "Parapet", Vector3.new(w + 1.2, 1.4, 0.6), top * CFrame.new(0, 0.7, -0.3), trim, M.Concrete, "deco")
		part(model, "RoofUnit", Vector3.new(4, 2.4, 3), top * CFrame.new(w * 0.25, 1.2, d * 0.6), C.MetalLight, M.DiamondPlate, "deco")
		TownKit.Column(model, "WaterTank", (top * CFrame.new(-w * 0.25, 0, d * 0.55)).Position, 4, 3.6, C.WoodLight, M.WoodPlanks, "deco")
	end
	-- gouttière
	part(model, "Drainpipe", Vector3.new(0.4, height, 0.4), cf * CFrame.new(w / 2 - 0.3, height / 2, -0.25), C.MetalLight, M.Metal, "deco")
	shopExtras(model, cf, spec, height)
	-- (v9.7) arrière / côtés / pancarte "Fermé" : détail client (TownFacades)
	model:SetAttribute("FacadeStyle", "DecorShop")
	model:SetAttribute("FacadeCF", cf)
	model:SetAttribute("W", w)
	model:SetAttribute("D", d)
	model:SetAttribute("Floors", spec.Floors)
	model:SetAttribute("Height", height)
	model:SetAttribute("Seed", seed)
	model:SetAttribute("Wall", spec.Wall)
	model:SetAttribute("Trim", trim)
	model:SetAttribute("Accent", spec.Awning[1])
	model:SetAttribute("GroundH", GROUND_H)
	model:SetAttribute("FloorH", FLOOR_H)
	return model
end

----------------------------------------------------------------------
-- Mairie + grand écran
----------------------------------------------------------------------

export type Screen = { Rows: { TextLabel }, Title: TextLabel, Footer: TextLabel }

function TownBuildings.TownHall(parent: Instance, cf: CFrame): (Model, Screen)
	local model = TownKit.Model(parent, "TownHall")
	local w, d, h = 64, 26, 34
	local wall = Color3.fromRGB(250, 238, 230)
	local trim = C.White
	local roof = Color3.fromRGB(110, 104, 140)
	part(model, "Body", Vector3.new(w, h, d), cf * CFrame.new(0, h / 2, d / 2 + 3), wall, M.Limestone, "solid")
	part(model, "Plinth", Vector3.new(w + 0.8, 1.6, d + 0.8), cf * CFrame.new(0, 0.75, d / 2 + 3), C.StoneDark, M.Granite, "prop")
	-- avant-corps central (portique) : marches, colonnes, fronton
	local cw = 28
	for i = 0, 2 do
		part(model, "Steps", Vector3.new(cw + 4 - i * 1.2, 0.6, 3.6 - i * 1.1), cf * CFrame.new(0, 0.3 + i * 0.6, -1.4 + i * 0.55), C.Stone, M.Marble, "solid")
	end
	part(model, "Porch", Vector3.new(cw, 0.6, 4), cf * CFrame.new(0, 2, 1), C.Stone, M.Marble, "solid")
	for i = 0, 5 do
		local x = -cw / 2 + 2 + i * (cw - 4) / 5
		TownKit.Column(model, "Column", (cf * CFrame.new(x, 2.3, 0)).Position, 9.4, 1.5, trim, M.Marble, "prop")
		part(model, "Capital", Vector3.new(2.2, 0.6, 2.2), cf * CFrame.new(x, 12, 0), trim, M.Marble, "deco")
	end
	part(model, "Entablature", Vector3.new(cw + 1, 1.6, 4.6), cf * CFrame.new(0, 13.1, 1.2), trim, M.Marble, "decoS")
	part(model, "PortalDoor", Vector3.new(6, 9, 0.4), cf * CFrame.new(0, 6.8, 2.85), Color3.fromRGB(120, 80, 70), M.Wood, "deco")
	part(model, "PortalGlass", Vector3.new(4.6, 2.9, 0.3), cf * CFrame.new(0, 12.35, 2.75), Color3.fromRGB(255, 226, 160), M.Glass, "deco")
	-- ailes : fenêtres hautes sur 2 étages
	for _, sx in ipairs({ -1, 1 }) do
		for f = 0, 1 do
			for i = 0, 2 do
				local x = sx * (cw / 2 + 3.5 + i * 6.4)
				window(model, cf * CFrame.new(x, 7 + f * 14, 3), 3.4, 6.4, trim, nil, f == 1, i + f)
			end
		end
		-- drapeaux sur la façade
		local flagBase = cf * CFrame.new(sx * (cw / 2 + 1.2), 16, 2.8)
		TownKit.Beam(model, "FlagPole", flagBase.Position, (flagBase * CFrame.new(0, 3.4, -5.8)).Position, 0.25, 0.25, C.MetalLight, M.Metal, "deco")
		part(model, "Flag", Vector3.new(0.15, 3.2, 3.4), flagBase * CFrame.new(0, 1.6, -3.9), sx < 0 and C.Pink or C.Lilac, M.Fabric, "deco")
	end
	part(model, "Cornice", Vector3.new(w + 1.6, 1.4, d + 1.6), cf * CFrame.new(0, h + 0.7, d / 2 + 3), trim, M.Marble, "decoS")
	-- toit à la Mansart (deux coins) + balustrade
	local top = cf * CFrame.new(0, h + 1.4, 3)
	TownKit.Wedge(model, "Roof", Vector3.new(w, 6, d / 2), top * CFrame.new(0, 3, d / 4), roof, M.Slate, "decoS")
	TownKit.Wedge(model, "Roof", Vector3.new(w, 6, d / 2), top * CFrame.new(0, 3, d * 3 / 4) * CFrame.Angles(0, math.pi, 0), roof, M.Slate, "decoS")
	-- tour de l'horloge (au-dessus du portique)
	local tower = cf * CFrame.new(0, h + 1.4, 8)
	-- (v9.7 : pied de la tour 0,1 au-dessus du bas du toit : faces non confondues)
	part(model, "Tower", Vector3.new(12, 15.9, 12), tower * CFrame.new(0, 8.05, 0), wall, M.Limestone, "solid")
	part(model, "TowerCornice", Vector3.new(13.4, 1, 13.4), tower * CFrame.new(0, 16.5, 0), trim, M.Marble, "deco")
	local clock = part(model, "Clock", Vector3.new(0.6, 8, 8), tower * CFrame.new(0, 9, -6.2) * CFrame.Angles(0, math.rad(90), 0), C.White, M.SmoothPlastic, "deco")
	;(clock :: Part).Shape = Enum.PartType.Cylinder
	local rim = part(model, "ClockRim", Vector3.new(0.4, 9, 9), tower * CFrame.new(0, 9, -6.05) * CFrame.Angles(0, math.rad(90), 0), C.Yellow, M.Metal, "deco")
	;(rim :: Part).Shape = Enum.PartType.Cylinder
	part(model, "HandHour", Vector3.new(0.4, 2.4, 0.2), tower * CFrame.new(0.6, 9.8, -6.6) * CFrame.Angles(0, 0, math.rad(-35)), C.Ink, M.Metal, "deco")
	part(model, "HandMinute", Vector3.new(0.3, 3.4, 0.2), tower * CFrame.new(-0.2, 10.6, -6.65) * CFrame.Angles(0, 0, math.rad(10)), C.Ink, M.Metal, "deco")
	-- flèche (pyramide approchée : deux paires de coins) + cœur
	for r = 0, 1 do
		local rot = CFrame.Angles(0, r * math.pi / 2, 0)
		TownKit.Wedge(model, "Spire", Vector3.new(12, 10, 6), tower * CFrame.new(0, 22, 0) * rot * CFrame.new(0, 0, -3), roof, M.Slate, "decoS")
		TownKit.Wedge(model, "Spire", Vector3.new(12, 10, 6), tower * CFrame.new(0, 22, 0) * rot * CFrame.Angles(0, math.pi, 0) * CFrame.new(0, 0, -3), roof, M.Slate, "decoS")
	end
	TownKit.Ball(model, "SpireHeart", (tower * CFrame.new(0, 28, 0)).Position, 2.4, C.Pink, M.SmoothPlastic, "deco")
	-- GRAND ÉCRAN (au-dessus du portique, sous l'horloge)
	local screenCF = cf * CFrame.new(0, 24.5, 2.2)
	part(model, "ScreenFrame", Vector3.new(30, 14.2, 1.2), screenCF * CFrame.new(0, 0, 0.3), Color3.fromRGB(40, 36, 52), M.Metal, "deco")
	local screen = part(model, "Screen", Vector3.new(28.6, 12.8, 0.4), screenCF * CFrame.new(0, 0, -0.4), Color3.fromRGB(24, 20, 40), M.SmoothPlastic, "deco")
	part(model, "ScreenGlow", Vector3.new(30.4, 0.3, 0.3), screenCF * CFrame.new(0, 7.2, -0.5), C.Pink, M.SmoothPlastic, "deco")
	part(model, "ScreenGlow", Vector3.new(30.4, 0.3, 0.3), screenCF * CFrame.new(0, -7.2, -0.5), C.Lilac, M.SmoothPlastic, "deco")
	local light = part(model, "ScreenLight", Vector3.new(1, 1, 1), screenCF * CFrame.new(0, 0, -6), C.White, M.SmoothPlastic, "deco")
	light.Transparency = 1
	-- (v9.6 : lumière douce, pas d'éblouissement)
	TownKit.Light(light, Color3.fromRGB(255, 196, 232), 18, 0.8)
	local _, body = TownKit.Surface(screen, Enum.NormalId.Front, 24, Color3.fromRGB(24, 20, 44), 800, 0)
	TownKit.Gradient(body, Color3.fromRGB(40, 24, 70), Color3.fromRGB(16, 20, 44), 90)
	local title = TownKit.Label(body, "Title", "🏆 Top players of the server", 0.04, 0.04, 0.92, 0.17, Color3.fromRGB(255, 214, 96), Enum.Font.FredokaOne, true)
	local rows = {}
	for i = 1, 5 do
		local row = TownKit.Label(body, "Row" .. i, "", 0.08, 0.23 + (i - 1) * 0.13, 0.84, 0.115, i == 1 and Color3.fromRGB(255, 236, 150) or C.White, Enum.Font.GothamBold, false)
		row.TextXAlignment = Enum.TextXAlignment.Left
		rows[i] = row
	end
	local footer = TownKit.Label(body, "Footer", "❤️ Like houses to climb the board!", 0.06, 0.88, 0.88, 0.09, Color3.fromRGB(255, 160, 210), Enum.Font.GothamBold, true)
	-- (v9.7) arrière (côté parc) et côtés : fenêtres, porte de service... en
	-- détail client (TownFacades, style "Hall") ; repère = pied du corps
	model:SetAttribute("FacadeStyle", "Hall")
	model:SetAttribute("FacadeCF", cf * CFrame.new(0, 0, 3))
	model:SetAttribute("W", w)
	model:SetAttribute("D", d)
	model:SetAttribute("Floors", 2)
	model:SetAttribute("Height", h)
	model:SetAttribute("Seed", 7)
	model:SetAttribute("Wall", wall)
	model:SetAttribute("Trim", trim)
	model:SetAttribute("Accent", roof)
	return model, { Rows = rows, Title = title, Footer = footer }
end

----------------------------------------------------------------------
-- Immeubles de rue (v9.7) : COQUE serveur + DÉTAIL client (TownFacades)
----------------------------------------------------------------------
-- Cinq styles qui alternent le long d'une rue (deux voisins ne se
-- ressemblent jamais) :
--   Haussmann : pierre de taille crème, toit à la Mansart en zinc ;
--   Brick     : briques, toit à deux pans en tuiles, cheminée ;
--   Pastel    : enduit pastel, PIGNON SUR RUE (toit à deux pans tourné) ;
--   Modern    : béton clair ou anthracite, toit-terrasse ;
--   Timber    : colombages (enduit crème + poutres sombres), tuiles.
-- Le serveur ne pose que la coque (volume solide, socle, corniche, toit,
-- cheminées) et, pour la vue de loin, des bandeaux vitrés "FarLOD" que le
-- client masque (localement) dès qu'il a construit le vrai détail :
-- fenêtres encadrées, balcons, volets, vitrine FERMÉE (store roulé, stores
-- baissés, pancarte "Fermé"), porte et perron, arrière fini (fenêtres,
-- porte de service, jardinet), pignons exposés (fenêtres, réclame peinte).
-- Attributs lus par le client : FacadeStyle, FacadeCF, W, D, Floors,
-- Height, Seed, Wall, Trim, Accent, Detail, GroundH, FloorH.

TownBuildings.STYLES = { "Haussmann", "Brick", "Pastel", "Modern", "Timber" }

local PASTELS = {
	Color3.fromRGB(255, 206, 214),
	Color3.fromRGB(196, 234, 216),
	Color3.fromRGB(255, 234, 176),
	Color3.fromRGB(216, 204, 248),
	Color3.fromRGB(190, 222, 248),
	Color3.fromRGB(255, 212, 184),
}
local BRICKS = {
	Color3.fromRGB(172, 84, 66),
	Color3.fromRGB(150, 96, 80),
	Color3.fromRGB(196, 128, 96),
	Color3.fromRGB(128, 74, 66),
}
-- devantures (bois peint) et volets
local ACCENTS = {
	Color3.fromRGB(46, 92, 78),
	Color3.fromRGB(48, 62, 104),
	Color3.fromRGB(122, 44, 62),
	Color3.fromRGB(214, 110, 140),
	Color3.fromRGB(86, 150, 170),
	Color3.fromRGB(120, 90, 160),
}

export type RowPalette = { Wall: Color3, Material: Enum.Material, Trim: Color3, Roof: Color3, RoofMat: Enum.Material, Accent: Color3, Detail: Color3 }

-- Style + couleurs d'un immeuble (déterministe : même ville à chaque démarrage)
function TownBuildings.RowStyle(seed: number): (string, RowPalette)
	local style = TownBuildings.STYLES[seed % #TownBuildings.STYLES + 1]
	local accent = ACCENTS[math.floor(hash(seed, 83) * #ACCENTS) + 1]
	if style == "Haussmann" then
		return style, { Wall = Color3.fromRGB(238, 228, 208), Material = M.Limestone, Trim = Color3.fromRGB(248, 242, 230),
			Roof = Color3.fromRGB(104, 112, 132), RoofMat = M.Slate, Accent = accent, Detail = Color3.fromRGB(46, 48, 58) }
	elseif style == "Brick" then
		return style, { Wall = BRICKS[math.floor(hash(seed, 84) * #BRICKS) + 1], Material = M.Brick, Trim = Color3.fromRGB(246, 242, 236),
			Roof = Color3.fromRGB(92, 84, 96), RoofMat = M.Slate, Accent = accent, Detail = Color3.fromRGB(40, 40, 48) }
	elseif style == "Pastel" then
		local wall = PASTELS[math.floor(hash(seed, 85) * #PASTELS) + 1]
		return style, { Wall = wall, Material = M.Plaster, Trim = C.White, Roof = Color3.fromRGB(176, 96, 82), RoofMat = M.ClayRoofTiles,
			Accent = accent, Detail = wall:Lerp(Color3.fromRGB(60, 60, 90), 0.45) }
	elseif style == "Modern" then
		local dark = hash(seed, 86) < 0.4
		return style, { Wall = dark and Color3.fromRGB(74, 78, 92) or Color3.fromRGB(236, 238, 242), Material = M.Concrete,
			Trim = dark and Color3.fromRGB(214, 218, 226) or Color3.fromRGB(70, 74, 88), Roof = Color3.fromRGB(150, 150, 160), RoofMat = M.Concrete,
			Accent = accent, Detail = Color3.fromRGB(60, 64, 76) }
	end
	return style, { Wall = Color3.fromRGB(250, 244, 230), Material = M.Plaster, Trim = Color3.fromRGB(250, 244, 230), Roof = Color3.fromRGB(140, 86, 72),
		RoofMat = M.ClayRoofTiles, Accent = accent, Detail = Color3.fromRGB(92, 62, 46) }
end

-- Toit à deux pans : repère F = milieu de la ligne d'égout "avant", toit sur
-- x ∈ [-W/2, W/2], z ∈ [0, D] (faîtage à z = D/2). Pignons pleins (couleur
-- du mur) + deux pans de couverture qui débordent + faîtière.
local function pitchedRoof(parent: Instance, F: CFrame, W: number, D: number, h: number, wall: Color3, wallMat: Enum.Material, roof: Color3, roofMat: Enum.Material)
	TownKit.Wedge(parent, "Gable", Vector3.new(W, h, D / 2), F * CFrame.new(0, h / 2, D / 4), wall, wallMat, "decoS")
	TownKit.Wedge(parent, "Gable", Vector3.new(W, h, D / 2), F * CFrame.new(0, h / 2, D * 3 / 4) * CFrame.Angles(0, math.pi, 0), wall, wallMat, "decoS")
	local half = D / 2
	local a = math.atan2(h, half)
	local len = math.sqrt(half * half + h * h)
	local t = 0.35
	for _, back in ipairs({ false, true }) do
		local side = back and F * CFrame.new(0, 0, D) * CFrame.Angles(0, math.pi, 0) or F
		-- (pan posé 0,05 au-dessus de la pente : jamais de faces confondues)
		local cf = side * CFrame.new(0, h / 2, half / 2) * CFrame.Angles(-a, 0, 0) * CFrame.new(0, t / 2 + 0.05, -0.45)
		part(parent, "RoofPlane", Vector3.new(W + 1, t, len + 0.9), cf, roof, roofMat, "decoS")
	end
	part(parent, "Ridge", Vector3.new(W + 1.2, 0.45, 0.9), F * CFrame.new(0, h + 0.42, half), roof:Lerp(Color3.new(0, 0, 0), 0.25), M.Slate, "deco")
end
TownBuildings.PitchedRoof = pitchedRoof

function TownBuildings.RowHouse(parent: Instance, cf: CFrame, w: number, d: number, floors: number, seed: number): Model
	local model = TownKit.Model(parent, "RowHouse")
	local style, pal = TownBuildings.RowStyle(seed)
	local height = GROUND_H + (floors - 1) * FLOOR_H
	part(model, "Body", Vector3.new(w, height, d), cf * CFrame.new(0, height / 2, d / 2), pal.Wall, pal.Material, "solid")
	-- socle en pierre (déborde de 0,6 tout autour : les détails de façade tiennent au-dessus)
	part(model, "Plinth", Vector3.new(w + 0.5, 1.8, d + 1.2), cf * CFrame.new(0, 0.3, d / 2), C.StoneDark, M.Granite, "prop")
	-- vue de loin : bandeaux vitrés (masqués par le client quand le détail est là)
	local farGlass = Color3.fromRGB(120, 150, 180)
	local function far(name: string, size: Vector3, at: CFrame)
		local g = part(model, name, size, at, farGlass, M.Glass, "deco")
		g.Reflectance = 0.12
		g:SetAttribute("FarLOD", true)
	end
	far("FarShop", Vector3.new(w - 4, GROUND_H - 4.6, 0.2), cf * CFrame.new(0, 1.2 + (GROUND_H - 4.6) / 2 + 1, -0.1))
	for f = 1, floors - 1 do
		local y = GROUND_H + (f - 1) * FLOOR_H + FLOOR_H / 2 + 0.3
		far("FarFront", Vector3.new(w - 3, 4.4, 0.2), cf * CFrame.new(0, y, -0.1))
		far("FarBack", Vector3.new(w - 5, 3.8, 0.2), cf * CFrame.new(0, y, d + 0.1))
	end
	local top = cf * CFrame.new(0, height, 0)
	if style == "Haussmann" then
		-- corniche, puis toit à la Mansart (brisis raide + terrasson) en zinc, 2 souches de cheminée
		part(model, "Cornice", Vector3.new(w + 0.8, 0.9, d + 0.8), top * CFrame.new(0, 0.45, d / 2), pal.Trim, M.Limestone, "decoS")
		local mh, md = 5.2, 2
		local base = top * CFrame.new(0, 0.9, 0)
		part(model, "MansardCore", Vector3.new(w - 0.2, mh, d - 2 * md), base * CFrame.new(0, mh / 2, d / 2), pal.Roof, pal.RoofMat, "decoS")
		TownKit.Wedge(model, "Mansard", Vector3.new(w - 0.2, mh, md), base * CFrame.new(0, mh / 2, md / 2), pal.Roof, pal.RoofMat, "decoS")
		TownKit.Wedge(model, "Mansard", Vector3.new(w - 0.2, mh, md), base * CFrame.new(0, mh / 2, d - md / 2) * CFrame.Angles(0, math.pi, 0), pal.Roof, pal.RoofMat, "decoS")
		part(model, "MansardCap", Vector3.new(w - 0.4, 0.4, d - 2 * md + 0.6), base * CFrame.new(0, mh + 0.2, d / 2), pal.Roof:Lerp(C.White, 0.2), M.Metal, "deco")
		for _, sx in ipairs({ -1, 1 }) do
			part(model, "Chimney", Vector3.new(1.6, 3.2, 3.4), base * CFrame.new(sx * (w / 2 - 1.2), mh + 1.8, d * 0.55), pal.Wall, M.Limestone, "deco")
		end
	elseif style == "Pastel" then
		-- pignon sur rue : faîtage perpendiculaire à la rue
		part(model, "Cornice", Vector3.new(w + 0.6, 0.6, d + 0.6), top * CFrame.new(0, 0.3, d / 2), pal.Trim, M.SmoothPlastic, "decoS")
		local h = math.min(9, w * 0.4)
		local F = top * CFrame.new(-w / 2, 0.6, d / 2) * CFrame.Angles(0, math.pi / 2, 0)
		pitchedRoof(model, F, d, w, h, pal.Wall, pal.Material, pal.Roof, pal.RoofMat)
		part(model, "Chimney", Vector3.new(1.8, 4.4, 1.8), top * CFrame.new(w * 0.22, 0.6 + h * 0.55 + 1.6, d * 0.7), Color3.fromRGB(196, 120, 100), M.Brick, "deco")
	elseif style == "Modern" then
		-- toit-terrasse : acrotère + édicule
		part(model, "Parapet", Vector3.new(w + 0.4, 1.4, d + 0.4), top * CFrame.new(0, 0.7, d / 2), pal.Trim, M.Concrete, "decoS")
		part(model, "RoofDeck", Vector3.new(w * 0.36, 3, d * 0.34), top * CFrame.new(-w * 0.18, 2.9, d * 0.62), pal.Wall, pal.Material, "deco")
	else
		-- Brick / Timber : corniche + toit à deux pans (faîtage parallèle à la rue) + cheminée
		part(model, "Cornice", Vector3.new(w + 0.8, 0.9, d + 0.8), top * CFrame.new(0, 0.45, d / 2), style == "Brick" and pal.Trim or pal.Detail, style == "Brick" and M.Concrete or M.Wood, "decoS")
		local h = math.min(8, d * 0.42)
		pitchedRoof(model, top * CFrame.new(0, 0.9, 0), w, d, h, pal.Wall, pal.Material, pal.Roof, pal.RoofMat)
		part(model, "Chimney", Vector3.new(2, 4.8, 2), top * CFrame.new(w * 0.3 * (seed % 2 == 0 and 1 or -1), 0.9 + h * 0.6 + 1.4, d * 0.66), style == "Brick" and pal.Wall or Color3.fromRGB(176, 110, 96), M.Brick, "deco")
	end
	model:SetAttribute("FacadeStyle", style)
	model:SetAttribute("FacadeCF", cf)
	model:SetAttribute("W", w)
	model:SetAttribute("D", d)
	model:SetAttribute("Floors", floors)
	model:SetAttribute("Height", height)
	model:SetAttribute("Seed", seed)
	model:SetAttribute("Wall", pal.Wall)
	model:SetAttribute("Trim", pal.Trim)
	model:SetAttribute("Accent", pal.Accent)
	model:SetAttribute("Detail", pal.Detail)
	model:SetAttribute("GroundH", GROUND_H)
	model:SetAttribute("FloorH", FLOOR_H)
	return model
end

----------------------------------------------------------------------
-- Ville lointaine (silhouettes au-delà des collines)
----------------------------------------------------------------------

function TownBuildings.Skyline(parent: Instance, center: Vector3, fromAngle: number, toAngle: number, distance: number, count: number)
	local model = TownKit.Model(parent, "Skyline")
	for i = 1, count do
		local t = (i - 0.5) / count
		local a = fromAngle + (toAngle - fromAngle) * t + (hash(i, 41) - 0.5) * 0.04
		local dist = distance + hash(i, 42) * 90
		local h = 40 + hash(i, 43) * 90
		local w = 26 + hash(i, 44) * 30
		local p = center + Vector3.new(math.sin(a) * dist, h / 2 - 6, math.cos(a) * dist)
		local cf = CFrame.lookAt(p, Vector3.new(center.X, p.Y, center.Z))
		local tone = Color3.fromRGB(176, 186, 222):Lerp(Color3.fromRGB(214, 196, 232), hash(i, 45))
		part(model, "Tower", Vector3.new(w, h, w * 0.8), cf, tone, M.SmoothPlastic, "deco")
		-- rangées de fenêtres (une bande lumineuse) + toit
		part(model, "Windows", Vector3.new(w * 0.7, h * 0.8, 0.2), cf * CFrame.new(0, -h * 0.02, -w * 0.4 - 0.1), tone:Lerp(Color3.fromRGB(255, 244, 214), 0.35), M.SmoothPlastic, "deco")
		if hash(i, 46) < 0.35 then
			part(model, "Antenna", Vector3.new(0.8, 16, 0.8), cf * CFrame.new(0, h / 2 + 8, 0), tone, M.Metal, "deco")
		end
	end
	return model
end

return TownBuildings
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="385">
          <Properties>
            <string name="Name">TownEntrance</string>
            <string name="Source"><![CDATA[--[[
	TownEntrance (ModuleScript)
	Emplacement : ServerScriptService > Services > World > TownEntrance

	🏰 L'ENTRÉE de Dopamine Town (v9.4), sur l'axe +Z (emplacement 0) :
	  - la GRANDE PORTE : deux tours en pierre (socle, meurtrières, corniche,
	    toit pointu, drapeaux), arche en voussoirs avec clé de voûte en cœur,
	    fronton "DOPAMINE TOWN" lisible des deux côtés, cadre néon, cœur
	    lumineux, lanternes (vraies lumières), murets et piliers de chaque côté ;
	  - la PLACE D'ACCUEIL (entre la porte et le boulevard) : pavage, rosace
	    d'apparition, panneau "Bienvenue", PLAN de la ville avec le nom des
	    propriétaires (mis à jour par TownMap), jardinières, arbres, bancs,
	    lampadaires, arceaux à vélos, haies ;
	  - dehors : route d'arrivée, rond-point, abribus + bus qui vient de
	    déposer les joueurs, parking avec voitures.
	Le joueur apparaît juste à l'intérieur de la porte et regarde l'avenue
	(WorldLayout.EntranceCFrame).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WorldLayout = require(ReplicatedStorage.Shared.WorldLayout)
local TownKit = require(script.Parent.TownKit)
local TownVehicles = require(script.Parent.TownVehicles) -- (v9.7, VEHICLES97) bus, 2-roues
local TownStreets = require(script.Parent.TownStreets) -- (v9.9, CITY99) tronçons des routes réalistes (client)

local TownEntrance = {}

local M = TownKit.M
local C = TownKit.C
local part = TownKit.Part

local WALK_Y = WorldLayout.WALK_Y
local ROAD_Y = WorldLayout.ROAD_Y

local PLAZA_HALF = 38 -- demi-largeur de la place d'accueil
local OPENING = 13 -- demi-largeur du passage sous l'arche
local TOWER = 9 -- largeur d'une tour

export type MapBoard = {
	Labels: { [number]: TextLabel },
	Markers: { [number]: Frame },
}

----------------------------------------------------------------------
-- La grande porte
----------------------------------------------------------------------

local function tower(model: Instance, cf: CFrame, flagColor: Color3)
	local stone = Color3.fromRGB(246, 232, 218)
	local trim = Color3.fromRGB(255, 196, 214)
	local roof = Color3.fromRGB(150, 116, 206)
	part(model, "TowerPlinth", Vector3.new(TOWER + 2, 3, TOWER + 2), cf * CFrame.new(0, 1.5, 0), C.StoneDark, M.Granite, "solid")
	part(model, "Tower", Vector3.new(TOWER, 26, TOWER), cf * CFrame.new(0, 16, 0), stone, M.Limestone, "solid")
	part(model, "TowerBand", Vector3.new(TOWER + 0.6, 1, TOWER + 0.6), cf * CFrame.new(0, 13, 0), trim, M.Marble, "deco")
	part(model, "TowerCornice", Vector3.new(TOWER + 1.6, 1.4, TOWER + 1.6), cf * CFrame.new(0, 29.7, 0), trim, M.Marble, "decoS")
	-- créneaux
	for _, x in ipairs({ -1, 1 }) do
		for _, z in ipairs({ -1, 1 }) do
			part(model, "Merlon", Vector3.new(2.2, 2.2, 2.2), cf * CFrame.new(x * (TOWER / 2 - 0.3), 31.5, z * (TOWER / 2 - 0.3)), stone, M.Limestone, "deco")
		end
	end
	-- toit pointu (deux paires de coins) + drapeau
	for r = 0, 1 do
		local rot = CFrame.Angles(0, r * math.pi / 2, 0)
		TownKit.Wedge(model, "Spire", Vector3.new(TOWER, 9, TOWER / 2), cf * CFrame.new(0, 35.1, 0) * rot * CFrame.new(0, 0, -TOWER / 4), roof, M.Slate, "decoS")
		TownKit.Wedge(model, "Spire", Vector3.new(TOWER, 9, TOWER / 2), cf * CFrame.new(0, 35.1, 0) * rot * CFrame.Angles(0, math.pi, 0) * CFrame.new(0, 0, -TOWER / 4), roof, M.Slate, "decoS")
	end
	TownKit.Column(model, "FlagPole", (cf * CFrame.new(0, 39.4, 0)).Position, 7, 0.3, C.MetalLight, M.Metal, "deco")
	part(model, "Flag", Vector3.new(4.6, 2.8, 0.15), cf * CFrame.new(2.4, 44.8, 0), flagColor, M.Fabric, "deco")
	-- meurtrières (des deux côtés)
	for _, z in ipairs({ -1, 1 }) do
		for _, y in ipairs({ 19, 24.5 }) do
			part(model, "Slit", Vector3.new(0.9, 3, 0.2), cf * CFrame.new(0, y, z * (TOWER / 2 + 0.05)), C.Ink, M.SmoothPlastic, "deco")
		end
		part(model, "Crest", Vector3.new(3.4, 3.4, 0.3), cf * CFrame.new(0, 8.5, z * (TOWER / 2 + 0.1)) * CFrame.Angles(0, 0, math.rad(45)), C.Pink, M.Marble, "deco")
	end
end

local function lantern(model: Instance, cf: CFrame, withLight: boolean)
	part(model, "LanternArm", Vector3.new(0.3, 0.3, 2.2), cf * CFrame.new(0, 0, -1.1), C.Metal, M.Metal, "deco")
	part(model, "LanternTop", Vector3.new(1.6, 0.5, 1.6), cf * CFrame.new(0, -0.4, -2.2), C.Metal, M.Metal, "deco")
	-- (v9.6 : verre mat le jour, Neon la nuit seulement ; lumière 30 / 1.6 -> 18 / 0.9)
	local glow = TownKit.Glow(part(model, "LanternGlow", Vector3.new(1.1, 1.8, 1.1), cf * CFrame.new(0, -1.6, -2.2), C.Glow, M.SmoothPlastic, "deco"))
	part(model, "LanternBase", Vector3.new(1.4, 0.3, 1.4), cf * CFrame.new(0, -2.6, -2.2), C.Metal, M.Metal, "deco")
	if withLight then
		TownKit.Light(glow, C.Glow, 18, 0.9)
	end
end

local function gate(folder: Instance, gcf: CFrame)
	local model = TownKit.Model(folder, "Gate")
	local towerX = OPENING + TOWER / 2
	for _, sx in ipairs({ -1, 1 }) do
		tower(model, gcf * CFrame.new(sx * towerX, 0, 0), sx < 0 and C.Pink or C.Lilac)
		-- lanternes côté ville et côté route
		for _, z in ipairs({ -1, 1 }) do
			local face = gcf * CFrame.new(sx * towerX, 11.5, z * (TOWER / 2)) * CFrame.Angles(0, z > 0 and math.pi or 0, 0)
			lantern(model, face, z < 0)
		end
		-- muret + pilier au bout
		local wallLen = PLAZA_HALF - (towerX + TOWER / 2) + 6
		local wx = sx * (towerX + TOWER / 2 + wallLen / 2)
		part(model, "Wall", Vector3.new(wallLen, 6, 2.4), gcf * CFrame.new(wx, 3, 0), Color3.fromRGB(246, 232, 218), M.Limestone, "solid")
		part(model, "WallCap", Vector3.new(wallLen, 0.6, 3), gcf * CFrame.new(wx, 6.3, 0), Color3.fromRGB(255, 196, 214), M.Marble, "deco")
		local px = sx * (towerX + TOWER / 2 + wallLen + 1.5)
		part(model, "Pillar", Vector3.new(3, 8, 3), gcf * CFrame.new(px, 4, 0), Color3.fromRGB(246, 232, 218), M.Limestone, "solid")
		TownKit.Ball(model, "PillarBall", (gcf * CFrame.new(px, 9, 0)).Position, 2.4, C.Pink, M.Marble, "deco")
	end
	-- arche (9 voussoirs sur un demi-cercle) + clé de voûte en cœur
	local spring = 15
	local radius = OPENING
	local n = 9
	for i = 0, n - 1 do
		local a0 = i / n * math.pi
		local a1 = (i + 1) / n * math.pi
		local p0 = gcf * Vector3.new(math.cos(a0) * radius, spring + math.sin(a0) * radius, 0)
		local p1 = gcf * Vector3.new(math.cos(a1) * radius, spring + math.sin(a1) * radius, 0)
		local mid = (p0 + p1) / 2
		local out = (mid - (gcf * Vector3.new(0, spring, 0))).Unit
		-- (v9.6 z-fighting : les voussoirs se chevauchent de 0.3 ; profondeur
		-- alternée 4 / 4.12 pour que leurs faces avant / arrière ne soient pas confondues)
		local block = part(model, "Voussoir", Vector3.new((p1 - p0).Magnitude + 0.3, 2.6, i % 2 == 0 and 4.12 or 4), CFrame.fromMatrix(mid + out * 1.1, (p1 - p0).Unit, out), i % 2 == 0 and Color3.fromRGB(255, 214, 226) or Color3.fromRGB(246, 232, 218), M.Limestone, "solid")
		block.CastShadow = true
	end
	-- remplissage au-dessus de l'arche (écoinçons) + fronton
	-- (au-dessus de l'extrados, sans empiéter sous l'arche)
	for _, sx in ipairs({ -1, 1 }) do
		part(model, "Spandrel", Vector3.new(3, 7, 3.4), gcf * CFrame.new(sx * 12, spring + 11, 0), Color3.fromRGB(246, 232, 218), M.Limestone, "solid")
		part(model, "Spandrel", Vector3.new(3.5, 3.4, 3.4), gcf * CFrame.new(sx * 8.75, spring + 12.7, 0), Color3.fromRGB(246, 232, 218), M.Limestone, "solid")
	end
	part(model, "Keystone", Vector3.new(2.6, 3.2, 4.8), gcf * CFrame.new(0, spring + radius + 0.4, 0), C.HotPink, M.Marble, "deco")
	-- fronton "DOPAMINE TOWN" (lisible des deux côtés)
	-- (entre les deux tours, au-dessus de l'arche)
	local boardW = 2 * OPENING - 0.6
	local boardY = spring + radius + 5.4
	part(model, "Lintel", Vector3.new(2 * OPENING, 1.2, 4.2), gcf * CFrame.new(0, boardY - 4, 0), Color3.fromRGB(255, 196, 214), M.Marble, "decoS")
	local board = part(model, "NameBoard", Vector3.new(boardW, 6.8, 1.6), gcf * CFrame.new(0, boardY, 0), Color3.fromRGB(255, 244, 250), M.SmoothPlastic, "solid")
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local _, body = TownKit.Surface(board, face, 24, nil, 900, 0.5)
		local title = TownKit.Label(body, "Title", "DOPAMINE TOWN", 0.03, 0.06, 0.94, 0.62, C.HotPink, Enum.Font.FredokaOne, false)
		local stroke = Instance.new("UIStroke")
		stroke.Color = C.White
		stroke.Thickness = 4
		stroke.Parent = title
		TownKit.Label(body, "Subtitle", "🧠 Welcome! 💖", 0.1, 0.68, 0.8, 0.28, C.Plum, Enum.Font.GothamBold, true)
	end
	for _, y in ipairs({ 3.6, -3.6 }) do
		-- (v9.6 : liseré en marbre rose, plus un tube Neon de 26 studs qui éblouit)
		part(model, "Rim", Vector3.new(boardW + 0.4, 0.35, 1.8), gcf * CFrame.new(0, boardY + y, 0), C.Pink, M.Marble, "deco")
	end
	-- cœur au sommet (deux boules + un carré tourné) ; v9.6 : marbre, plus Neon
	local heart = gcf * CFrame.new(0, boardY + 5.8, 0)
	TownKit.Ball(model, "Heart", (heart * CFrame.new(-1.15, 0.7, 0)).Position, 3, C.HotPink, M.Marble, "deco")
	TownKit.Ball(model, "Heart", (heart * CFrame.new(1.15, 0.7, 0)).Position, 3, C.HotPink, M.Marble, "deco")
	part(model, "HeartTip", Vector3.new(2.6, 2.6, 1.2), heart * CFrame.new(0, -0.6, 0) * CFrame.Angles(0, 0, math.rad(45)), C.HotPink, M.Marble, "deco")
	return model
end

----------------------------------------------------------------------
-- Plan de la ville (propriétaires)
----------------------------------------------------------------------

local function mapBoard(folder: Instance, cf: CFrame, geo: TownKit.Geo): MapBoard
	local model = TownKit.Model(folder, "MapBoard")
	for _, sx in ipairs({ -1, 1 }) do
		part(model, "Post", Vector3.new(0.8, 12, 0.8), cf * CFrame.new(sx * 8, 6, 0.2), C.Wood, M.Wood, "prop")
	end
	part(model, "Roof", Vector3.new(18.5, 0.6, 2.6), cf * CFrame.new(0, 12.2, 0.2) * CFrame.Angles(math.rad(-12), 0, 0), Color3.fromRGB(150, 116, 206), M.Slate, "deco")
	local board = part(model, "Board", Vector3.new(16, 9.6, 0.5), cf * CFrame.new(0, 6.6, 0.2), C.Wood, M.Wood, "solid")
	local _, body = TownKit.Surface(board, Enum.NormalId.Front, 36, Color3.fromRGB(252, 244, 226), 200, 0.5)
	TownKit.Stroke(body, Color3.fromRGB(176, 124, 84), 6)
	TownKit.Label(body, "Title", "🗺️ Town map", 0.03, 0.02, 0.5, 0.1, C.Ink, Enum.Font.FredokaOne, true)
	-- zone de la carte (carrée, à gauche) + légende (à droite)
	local map = Instance.new("Frame")
	map.Name = "Map"
	map.BackgroundColor3 = Color3.fromRGB(170, 222, 150)
	map.BorderSizePixel = 0
	map.Position = UDim2.fromScale(0.03, 0.13)
	map.Size = UDim2.fromScale(0.52, 0.84)
	map.Parent = body
	TownKit.Corner(map, 16)
	local aspect = Instance.new("UIAspectRatioConstraint")
	aspect.AspectRatio = 1
	aspect.Parent = map
	-- (v10, LAYOUT10) la GRANDE ville : autoroute, ceinture, avenues,
	-- quartiers (couleurs), place ; parcelles numérotées
	local count = geo.Count
	local world = WorldLayout.HighwayR(count) + WorldLayout.HIGHWAY_W / 2 + 12
	local function mapPos(x: number, z: number): UDim2
		return UDim2.fromScale(0.5 + x / world / 2, 0.5 + z / world / 2)
	end
	local function block(name: string, x: number, z: number, w: number, h: number, rot: number, color: Color3, z0: number): Frame
		local f = Instance.new("Frame")
		f.Name = name
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = mapPos(x, z)
		f.Size = UDim2.fromScale(w / world / 2, h / world / 2)
		f.Rotation = rot
		f.BackgroundColor3 = color
		f.BorderSizePixel = 0
		f.ZIndex = z0
		f.Parent = map
		return f
	end
	-- quartiers (fond coloré)
	local tint = {
		Cottage = Color3.fromRGB(196, 232, 160),
		Townhouse = Color3.fromRGB(250, 214, 190),
		Loft = Color3.fromRGB(206, 196, 190),
		Mansion = Color3.fromRGB(226, 206, 250),
		Mixed = Color3.fromRGB(190, 222, 240),
	}
	for _, d in ipairs(WorldLayout.Districts(count)) do
		local b = d.Bounds
		local f = block("District_" .. d.Id, b.X, b.Z, b.W, b.D, 0, tint[d.Id] or Color3.fromRGB(210, 230, 200), 2)
		local label = TownKit.Label(f, "Name", d.Emoji, 0.3, 0.3, 0.4, 0.4, C.Ink, Enum.Font.GothamBold, false)
		label.ZIndex = 3
	end
	-- autoroute + routes (un trait par arête droite du graphe)
	local roadColor = Color3.fromRGB(120, 122, 136)
	local hw = WorldLayout.HighwayPath(count)
	for i = 1, #hw do
		local a2, b2 = hw[i], hw[i % #hw + 1]
		local dx, dz = b2.X - a2.X, b2.Z - a2.Z
		local len = math.sqrt(dx * dx + dz * dz)
		if len > 1 then
			block("Highway", (a2.X + b2.X) / 2, (a2.Z + b2.Z) / 2, len + 20, 44, math.deg(math.atan2(dz, dx)), Color3.fromRGB(96, 98, 112), 3)
		end
	end
	for _, e in ipairs(WorldLayout.RoadGraph(count).Edges) do
		if not e.Highway and e.Kind ~= "Roundabout" then
			local a2, b2 = e.Points[1], e.Points[#e.Points]
			local dx, dz = b2.X - a2.X, b2.Z - a2.Z
			local len = math.sqrt(dx * dx + dz * dz)
			if len > 1 then
				block("Road", (a2.X + b2.X) / 2, (a2.Z + b2.Z) / 2, len + 16, e.Ramp and 12 or 22, math.deg(math.atan2(dz, dx)), roadColor, 3)
			end
		end
	end
	local plaza = block("Plaza", 0, 0, WorldLayout.PLAZA_R * 2, WorldLayout.PLAZA_R * 2, 0, Color3.fromRGB(255, 214, 226), 4)
	TownKit.Corner(plaza, 999)
	local fountainIcon = TownKit.Label(plaza, "Icon", "⛲", 0.1, 0.1, 0.8, 0.8, C.Ink, Enum.Font.GothamBold, false)
	fountainIcon.ZIndex = 5
	-- entrée : "vous êtes ici"
	local here = block("Here", 0, geo.Gate - 12, 70, 70, 0, C.HotPink, 7)
	TownKit.Corner(here, 999)
	TownKit.Stroke(here, C.White, 3)
	-- parcelles : pastille numérotée + étiquette dans la légende (colonnes)
	local labels, markers = {}, {}
	local legend = Instance.new("Frame")
	legend.Name = "Legend"
	legend.BackgroundTransparency = 1
	legend.Position = UDim2.fromScale(0.58, 0.13)
	legend.Size = UDim2.fromScale(0.4, 0.84)
	legend.Parent = body
	local perColumn = 13
	local columns = math.max(1, math.ceil((count + 1) / perColumn))
	local rows = math.max(6, math.min(perColumn, count + 1))
	for i = 1, count do
		local place = WorldLayout.PlotPlaceData(i, count)
		local x, z = place and place.X or 0, place and place.Z or 0
		local alongX = place ~= nil and math.abs(place.LookZ) > 0.5
		local lot = block("Lot" .. i, x, z, alongX and WorldLayout.PLOT_W or WorldLayout.PLOT_D, alongX and WorldLayout.PLOT_D or WorldLayout.PLOT_W, 0, Color3.fromRGB(126, 196, 112), 5)
		TownKit.Stroke(lot, Color3.fromRGB(255, 255, 255), 1)
		local pin = block("Pin" .. i, x, z, 90, 90, 0, Color3.fromRGB(150, 150, 170), 6)
		TownKit.Corner(pin, 999)
		local num = TownKit.Label(pin, "N", tostring(i), 0.1, 0.1, 0.8, 0.8, C.White, Enum.Font.GothamBlack, false)
		num.ZIndex = 7
		markers[i] = pin
		local col = math.floor((i - 1) / perColumn)
		local r = (i - 1) % perColumn
		local row = TownKit.Label(legend, "Row" .. i, i .. ". ✨ Free plot", col / columns, r / rows, 1 / columns, 0.9 / rows, C.Ink, Enum.Font.GothamBold, false)
		row.TextXAlignment = Enum.TextXAlignment.Left
		labels[i] = row
	end
	local lastCol = math.floor(count / perColumn)
	local you = TownKit.Label(legend, "Here", "📍 You are here", lastCol / columns, (count % perColumn) / rows, 1 / columns, 0.9 / rows, C.HotPink, Enum.Font.GothamBlack, true)
	you.TextXAlignment = Enum.TextXAlignment.Left
	return { Labels = labels, Markers = markers }
end

-- Panneau de bienvenue
local function welcomeSign(folder: Instance, cf: CFrame)
	local model = TownKit.Model(folder, "WelcomeSign")
	part(model, "Base", Vector3.new(15, 1.6, 3), cf * CFrame.new(0, 0.8, 0), C.Stone, M.Limestone, "solid")
	part(model, "Planter", Vector3.new(14, 0.8, 2.2), cf * CFrame.new(0, 2, -0.2), C.GrassDark, M.Grass, "deco")
	for i = -3, 3 do
		TownKit.Ball(model, "Flower", (cf * CFrame.new(i * 1.9, 2.6, -0.6)).Position, 1.2, TownKit.FLOWERS[(i + 4) % #TownKit.FLOWERS + 1], M.SmoothPlastic, "deco")
	end
	local board = part(model, "Board", Vector3.new(14, 6, 0.6), cf * CFrame.new(0, 6, 0.6), Color3.fromRGB(255, 244, 250), M.SmoothPlastic, "solid")
	local _, body = TownKit.Surface(board, Enum.NormalId.Front, 36, nil, 260, 0.5)
	TownKit.Gradient(body, Color3.fromRGB(255, 240, 248), Color3.fromRGB(255, 212, 234), 90)
	body.BackgroundTransparency = 0
	TownKit.Stroke(body, C.Pink, 6)
	TownKit.Label(body, "Title", "✨ Welcome to Dopamine Town! ✨", 0.04, 0.08, 0.92, 0.36, C.HotPink, Enum.Font.FredokaOne, true)
	TownKit.Label(body, "Line1", "🏠 Visit the houses   ❤️ Leave likes", 0.06, 0.5, 0.88, 0.2, C.Plum, Enum.Font.GothamBold, true)
	TownKit.Label(body, "Line2", "⛲ Meet at the fountain   😀 Dance!", 0.06, 0.73, 0.88, 0.2, C.Plum, Enum.Font.GothamBold, true)
	part(model, "Frame", Vector3.new(14.8, 6.8, 0.4), cf * CFrame.new(0, 6, 0.95), C.Wood, M.Wood, "deco")
end

----------------------------------------------------------------------
-- Dehors : route, rond-point, bus, parking
----------------------------------------------------------------------

local function busStop(folder: Instance, cf: CFrame)
	local model = TownKit.Model(folder, "BusStop")
	part(model, "Slab", Vector3.new(12, 0.3, 5), cf * CFrame.new(0, 0.15, 0), C.Walk, M.Pavement, "solid")
	part(model, "Roof", Vector3.new(12.4, 0.5, 5.2), cf * CFrame.new(0, 8.4, 0), C.White, M.SmoothPlastic, "decoS")
	part(model, "BackGlass", Vector3.new(11, 6.6, 0.25), cf * CFrame.new(0, 4.6, 2.2), C.Glass, M.Glass, "deco").Transparency = 0.5
	for _, x in ipairs({ -5.8, 5.8 }) do
		part(model, "Post", Vector3.new(0.4, 8.2, 0.4), cf * CFrame.new(x * 0.99, 4.2, 2.2), C.MetalLight, M.Metal, "prop")
	end
	-- (v9.6 : vrai banc TownKit, dos à la vitre, plus une planche flottante)
	TownKit.Bench(model, cf * CFrame.new(0, 0.3, 0.9))
	local ad = part(model, "Ad", Vector3.new(0.3, 5.4, 3.4), cf * CFrame.new(6.1, 4.2, 0.4), C.White, M.SmoothPlastic, "deco")
	local _, body = TownKit.Surface(ad, Enum.NormalId.Right, 40, nil, 150, 0.5)
	TownKit.Gradient(body, Color3.fromRGB(255, 190, 222), Color3.fromRGB(190, 170, 255), 90)
	body.BackgroundTransparency = 0
	TownKit.Label(body, "Ad", "🧠 Click more!", 0.05, 0.3, 0.9, 0.4, C.White, Enum.Font.FredokaOne, true)
	TownKit.RoadSign(model, (cf * CFrame.new(-7.5, 0, -1.8)).Position, 0, Color3.fromRGB(60, 120, 220), "Rect")
end

local function outside(folder: Instance, geo: TownKit.Geo, gcf: CFrame)
	local model = TownKit.Model(folder, "Arrival")
	local len = 50
	gcf = gcf * CFrame.new(0, -WALK_Y, 0) -- (repère au niveau du pré)
	-- route depuis la porte, puis rond-point
	part(model, "Road", Vector3.new(16, 0.7, len), gcf * CFrame.new(0, ROAD_Y - 0.35, len / 2 + 3), C.Asphalt, M.Asphalt, "solid")
	for i = 0, 3 do
		-- (v9.8, CITY98) peinture au sol construite côté client (TownStreetLife)
		TownKit.LifeSpot("Paint", gcf * CFrame.new(0, ROAD_Y + 0.05, 10 + i * 11), 0, Vector3.new(0.4, 0.1, 5))
	end
	local loop = gcf * CFrame.new(0, 0, len + 16)
	-- (v9.8 z-fighting : l'anneau 0,03 au-dessus de la route qui y entre)
	TownKit.Disc(model, "Roundabout", (loop * CFrame.new(0, ROAD_Y + 0.03, 0)).Position, 20, 0.7, C.Asphalt, M.Asphalt, "solid")
	TownKit.Disc(model, "Island", (loop * CFrame.new(0, WALK_Y, 0)).Position, 8, 1.3, C.Curb, M.Concrete, "solid")
	TownKit.Disc(model, "IslandGrass", (loop * CFrame.new(0, WALK_Y + 0.05, 0)).Position, 7.2, 0.3, C.Lawn, M.Grass, "deco")
	TownKit.Tree(model, (loop * CFrame.new(0, WALK_Y, 0)).Position, 16, 77, "Cherry", { Tier = 1, Lawn = true }) -- (v9.7 NATURE97)
	-- bus arrêté devant l'abribus (il vient de déposer les joueurs)
	-- (v9.7, VEHICLES97) vrai bus de ville, portes côté abribus : construit
	-- côté client (TownTraffic : vitres, sièges, barres) ; boîte solide ici
	TownVehicles.Bus(model, gcf * CFrame.new(4.2, ROAD_Y, 28))
	busStop(model, gcf * CFrame.new(13, WALK_Y - 0.3, 30) * CFrame.Angles(0, math.rad(90), 0))
	part(model, "Sidewalk", Vector3.new(6, 1.3, len - 4), gcf * CFrame.new(11, WALK_Y - 0.65, len / 2 + 5), C.Walk, M.Pavement, "solid")
	-- parking (côté gauche en arrivant de la ville)
	local lot = gcf * CFrame.new(-31, 0, 26)
	part(model, "Parking", Vector3.new(30, 0.7, 34), lot * CFrame.new(0, ROAD_Y - 0.35, 0), C.AsphaltDark, M.Asphalt, "solid")
	for i = 0, 5 do
		part(model, "Bay", Vector3.new(0.3, 0.1, 11), lot * CFrame.new(-15 + i * 6, ROAD_Y + 0.05, -9), C.Line, M.SmoothPlastic, "deco")
	end
	local colors = { Color3.fromRGB(130, 200, 255), Color3.fromRGB(255, 236, 150), Color3.fromRGB(250, 250, 250), Color3.fromRGB(200, 170, 250) }
	for i, bay in ipairs({ 0, 1, 4 }) do
		TownKit.Car(model, lot * CFrame.new(-12 + bay * 6, ROAD_Y, -9) * CFrame.Angles(0, math.pi, 0), colors[i], ({ "CityCar", "BubbleCar", "Hatchback" })[i], {}) -- (v9.6) CarModels
	end
	-- (v9.7, VEHICLES97) 2 places de plus occupées (voitures construites côté client)
	TownKit.VehicleSpot(model, "Car", lot * CFrame.new(-12 + 2 * 6, ROAD_Y, -9) * CFrame.Angles(0, math.pi, 0), { CarId = "CityCar", Color = Color3.fromRGB(220, 44, 64), Stripe = true })
	TownKit.VehicleSpot(model, "Car", lot * CFrame.new(-12 + 3 * 6, ROAD_Y, -9) * CFrame.Angles(0, math.pi, 0), { CarId = "BubbleCar", Color = Color3.fromRGB(128, 222, 190) })
	TownKit.Lamp(model, (lot * CFrame.new(0, ROAD_Y, 6)).Position, 0, false, true)
	geo.Reserve((loop * CFrame.new(0, 0, 0)).Position, 24)
	-- (v9.8, CITY98) vie de la rue (client) : on attend le bus, lampadaires
	-- le long de la route, poteau indicateur, colline au moulin à vent
	-- derrière le rond-point
	local stopCF = gcf * CFrame.new(13, WALK_Y - 0.3, 30) * CFrame.Angles(0, math.rad(90), 0)
	TownKit.LifeSpot("SitBench", stopCF * CFrame.new(0, 0.3, 0.9), 40)
	TownKit.LifeSpot("Wait", stopCF * CFrame.new(-3.6, 0.3, -1.4) * CFrame.Angles(0, 0.3, 0), 41)
	for i, z in ipairs({ 12, 44 }) do
		TownKit.LifeSpot("Lamppost", gcf * CFrame.new(9.6, WALK_Y, z) * CFrame.Angles(0, math.rad(90), 0), 50 + i)
	end
	for i, z in ipairs({ 14, 30 }) do
		TownKit.LifeSpot("Lamppost", gcf * CFrame.new(-9.8, WorldLayout.GROUND_Y, z) * CFrame.Angles(0, math.rad(-90), 0), 52 + i)
	end
	TownKit.LifeSpot("Signpost", gcf * CFrame.new(-11.5, WorldLayout.GROUND_Y, len - 4), 60)
	TownKit.LifeSpot("Bin", gcf * CFrame.new(12.6, WALK_Y, 22), 62)
	TownKit.LifeSpot("WindmillHill", gcf * CFrame.new(-24, WorldLayout.GROUND_Y, len + 68) * CFrame.Angles(0, math.rad(200), 0), 63)
	-- (v9.9, CITY99) route d'arrivée réaliste (client : TownRoads) : asphalte
	-- vivant, caniveau + bordure du trottoir, dalles, rond-point détaillé
	local along = gcf * CFrame.new(0, 0, len / 2 + 3) * CFrame.Angles(0, math.pi / 2, 0)
	-- (X local vers la porte : on s'arrête avant l'anneau du rond-point)
	TownStreets.Chunks("RoadSurface", along, -len / 2 + 8, len / 2 - 1, ROAD_Y, 0, 2, 16, 7001)
	local walkAlong = gcf * CFrame.new(0, 0, len / 2 + 5) * CFrame.Angles(0, math.pi / 2, 0)
	-- (X local vers la porte : le caniveau s'arrête avant l'anneau du rond-point)
	TownStreets.Chunks("CurbLine", walkAlong, -17, (len - 4) / 2, ROAD_Y, 8, WALK_Y - ROAD_Y, 0, 7002)
	-- (pas de dalles sous la dalle de l'abribus : gcf z 24..36 = X local -6..6)
	TownStreets.Chunks("Pavers", walkAlong, -(len - 4) / 2 + 0.5, (len - 4) / 2 - 0.5, WALK_Y, 11, 0, 5.8, 7003, { { -6.5, 6.5 } })
	TownKit.LifeSpot("Roundabout", loop * CFrame.new(0, ROAD_Y + 0.03, 0), 7004, Vector3.new(8, 0, 20))
	-- repères des lieux (poteaux indicateurs, client) : porte, MégaDopa,
	-- concession, coin gourmand
	TownKit.LifeSpot("Dest", CFrame.new(gcf.Position), 15)
	TownKit.LifeSpot("Dest", WorldLayout.MarketCFrame(geo.Count), 6)
	TownKit.LifeSpot("Dest", WorldLayout.DealershipCFrame(geo.Count), 7)
	TownKit.LifeSpot("Dest", WorldLayout.FoodCornerCFrame(geo.Count), 8)
end

----------------------------------------------------------------------
-- Construction
----------------------------------------------------------------------

export type EntranceResult = { Map: MapBoard, Spawn: SpawnLocation }

function TownEntrance.Build(folder: Instance, geo: TownKit.Geo): EntranceResult
	local entrance = Instance.new("Folder")
	entrance.Name = "Entrance"
	entrance.Parent = folder
	local O = geo.Origin
	local gcf = WorldLayout.GateCFrame(geo.Count) -- LookVector vers la place ; +Z local = dehors
	local depth = geo.Gate - geo.Front
	-- place d'accueil : pavage, bande rose dans l'axe, bordures
	local center = O + Vector3.new(0, WALK_Y, geo.Front + depth / 2 + 2)
	part(entrance, "WelcomePlaza", Vector3.new(PLAZA_HALF * 2, 1.3, depth + 4), CFrame.new(center - Vector3.new(0, 0.65, 0)), C.Paving, M.Cobblestone, "solid")
	-- (v9.6 z-fighting : bande et bordures un peu en retrait des bords du pavage)
	part(entrance, "Band", Vector3.new(14, 0.2, depth + 3.9), CFrame.new(center + Vector3.new(0, 0.03, 0)), C.PavingRose, M.Cobblestone, "deco")
	for _, sx in ipairs({ -1, 1 }) do
		part(entrance, "Border", Vector3.new(1.1, 0.2, depth + 3.9), CFrame.new(center + Vector3.new(sx * (PLAZA_HALF - 0.6), 0.04, 0)), C.StoneDark, M.Granite, "deco")
		-- haies le long des bords + arbres en bacs aux coins
		-- (v9.7 NATURE97) haie taillée au dessus arrondi
		if sx > 0 then
			-- (v9.9, CITY99) haie ouverte vers le 🍦 coin gourmand (passage de 7 studs)
			local z0, z1 = -3 - (depth - 14) / 2, -3 + (depth - 14) / 2
			local gap0, gap1 = -5.5, 1.5
			TownKit.Hedge(entrance, CFrame.new(center + Vector3.new(sx * (PLAZA_HALF - 2.4), 0, (z0 + gap0) / 2)) * CFrame.Angles(0, math.pi / 2, 0), gap0 - z0, 2.4, 3.2, 20 + sx)
			TownKit.Hedge(entrance, CFrame.new(center + Vector3.new(sx * (PLAZA_HALF - 2.4), 0, (gap1 + z1) / 2)) * CFrame.Angles(0, math.pi / 2, 0), z1 - gap1, 2.4, 3.2, 23 + sx)
		else
			TownKit.Hedge(entrance, CFrame.new(center + Vector3.new(sx * (PLAZA_HALF - 2.4), 0, -3)) * CFrame.Angles(0, math.pi / 2, 0), depth - 14, 2.4, 3.2, 20 + sx)
		end
		for _, dz in ipairs({ -depth / 2 + 6, depth / 2 - 10 }) do
			local p = center + Vector3.new(sx * (PLAZA_HALF - 8), 0, dz)
			part(entrance, "TreeBox", Vector3.new(4.4, 1.8, 4.4), CFrame.new(p + Vector3.new(0, 0.9, 0)), C.White, M.Concrete, "prop")
			TownKit.Tree(entrance, p + Vector3.new(0, 1.8, 0), 14, math.floor(p.X + dz), sx > 0 and "Cherry" or "Oak") -- (v9.7 NATURE97)
		end
		-- lampadaires (vraies lumières)
		TownKit.Lamp(entrance, center + Vector3.new(sx * 13, 0, 3), TownKit.Facing(Vector3.new(-sx, 0, 0)), true)
		-- jardinières le long de l'axe
		TownKit.Planter(entrance, CFrame.new(center + Vector3.new(sx * 18, 0, 6)), 8, 3, 3 + sx)
		TownKit.Planter(entrance, CFrame.new(center + Vector3.new(sx * 18, 0, -14)), 8, 3, 7 + sx)
		-- bancs face à l'axe
		local benchCF = CFrame.lookAt(center + Vector3.new(sx * 24, 0, -4), center + Vector3.new(0, 0, -4))
		TownKit.Bench(entrance, benchCF)
		TownKit.LifeSpot("SitBench", benchCF, 30 + sx) -- (v9.8, CITY98) un passant peut s'y asseoir
		-- (v9.8, CITY98) mobilier construit côté client : poubelle près du banc
		TownKit.LifeSpot("Bin", CFrame.new(center + Vector3.new(sx * 24.3, 0, -0.2)), 32 + sx)
	end
	-- rosace d'apparition (juste à l'intérieur de la porte)
	local spawnCF = WorldLayout.EntranceCFrame(geo.Count)
	local spawnGround = spawnCF.Position - Vector3.new(0, 3, 0)
	TownKit.Disc(entrance, "Rosette", spawnGround + Vector3.new(0, 0.08, 0), 7, 0.4, C.PavingLilac, M.Marble, "deco")
	TownKit.Disc(entrance, "RosetteInner", spawnGround + Vector3.new(0, 0.11, 0), 5.2, 0.4, C.White, M.Marble, "deco")
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		local d = Vector3.new(math.sin(a), 0, math.cos(a))
		local mid = spawnGround + d * 4.6 + Vector3.new(0, 0.14, 0)
		part(entrance, "RosetteRay", Vector3.new(0.9, 0.1, 4.4), CFrame.lookAt(mid, mid + d), i % 2 == 0 and C.Pink or C.Lilac, M.Marble, "deco")
	end
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "TownSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(5, 0.3, 5)
	spawn.CFrame = CFrame.new(spawnGround + Vector3.new(0, 0.08, 0)) -- (v9.6 : dessus à +0.23, au-dessus des rayons)
	spawn.Color = C.Pink
	spawn.Material = M.Marble
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.BottomSurface = Enum.SurfaceType.Smooth
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.Enabled = true
	spawn.CastShadow = false
	spawn.Parent = entrance
	TownKit.Stats.Parts += 1
	-- la porte
	gate(entrance, gcf)
	-- panneau de bienvenue (à droite) + plan (à gauche), tournés vers l'arrivant
	welcomeSign(entrance, CFrame.lookAt(center + Vector3.new(19, 0, -24), center + Vector3.new(4, 0, 4)))
	local map = mapBoard(entrance, CFrame.lookAt(center + Vector3.new(-19, 0, -22), center + Vector3.new(-4, 0, 6)), geo)
	-- vélos
	TownKit.BikeRack(entrance, CFrame.new(center + Vector3.new(26, 0, 12)) * CFrame.Angles(0, math.rad(90), 0), 3)
	-- (v9.7, VEHICLES97) trottinettes / scooter garés à côté des vélos (client)
	TownVehicles.TwoWheelers(entrance, CFrame.new(center + Vector3.new(24.5, 0, 18.5)) * CFrame.Angles(0, math.rad(90), 0), 3, 4)
	-- (v9.8, CITY98) vie de la rue (client) : colonne d'affiches, distributeurs,
	-- gens qui discutent, fontaine à boire
	TownKit.LifeSpot("Morris", CFrame.new(center + Vector3.new(-27, 0, 11)), 1)
	TownKit.LifeSpot("Vending", CFrame.lookAt(center + Vector3.new(29, 0, -12), center + Vector3.new(0, 0, -12)), 2)
	TownKit.LifeSpot("Vending", CFrame.lookAt(center + Vector3.new(29, 0, -9.6), center + Vector3.new(0, 0, -9.6)), 3)
	TownKit.LifeSpot("DrinkFountain", CFrame.lookAt(center + Vector3.new(-9, 0, -22), center + Vector3.new(0, 0, -22)), 4)
	TownKit.LifeSpot("Chat", CFrame.new(center + Vector3.new(9, 0, -8)) * CFrame.Angles(0, 2.4, 0), 7)
	TownKit.LifeSpot("Chat", CFrame.new(center + Vector3.new(-8, 0, 6)) * CFrame.Angles(0, -0.8, 0), 8)
	-- (v9.9, CITY99) poteau indicateur à l'arrivée (vers tous les lieux de la ville)
	TownKit.LifeSpot("Direction", CFrame.new(center + Vector3.new(-12, 0, 12)), 320)
	-- (v9.9, CITY99) allées pavées vers le 🍦 coin gourmand : depuis la place
	-- d'accueil (par le passage dans la haie) et depuis le trottoir du boulevard
	local food = WorldLayout.FoodCornerCFrame(geo.Count)
	local foodX0 = food.Position.X - WorldLayout.FOOD_W / 2
	local y = geo.Origin.Y + WorldLayout.GROUND_Y
	local gz = center.Z - 2
	local x0 = center.X + PLAZA_HALF
	if foodX0 > x0 + 1 then
		TownKit.LifeSpot("Walkway", CFrame.new((x0 + foodX0) / 2 + 0.1, y, gz), 330, Vector3.new(foodX0 - x0 + 0.4, 1, 5))
	end
	local foodZ0 = food.Position.Z - WorldLayout.FOOD_D / 2
	local walkZ = geo.Origin.Z + geo.Front
	if foodZ0 > walkZ + 1 then
		TownKit.LifeSpot("Walkway", CFrame.new(food.Position.X, y, (walkZ + foodZ0) / 2) * CFrame.Angles(0, math.pi / 2, 0), 331, Vector3.new(foodZ0 - walkZ + 0.4, 1, 5))
	end
	-- dehors
	outside(entrance, geo, gcf)
	return { Map = map, Spawn = spawn }
end

return TownEntrance
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="386">
          <Properties>
            <string name="Name">TownFair</string>
            <string name="Source"><![CDATA[--[[
	TownFair (ModuleScript)
	Emplacement : ServerScriptService > Services > World > TownFair

	🎡 FÊTE FORAINE de Dopamine Town (v9.8, FAIR98), côté SERVEUR :
	derrière la mairie (WorldLayout.FairCFrame), 110 x 76 studs, avec de
	VRAIS manèges où l'on s'assoit :
	  🎡 grande roue (10 nacelles qui restent droites), 🎠 manège à chevaux,
	  ☕ tasses qui tournent, 🎢 chaises volantes, 🗼 tour de chute douce,
	  🚗 autos tamponneuses (on conduit !) ; + le manège de la PLACE
	  (TownPlaza) devient lui aussi un vrai manège.
	Ici, SEULEMENT ce qui doit être partagé : le sol, les SIÈGES (Seat
	ancrés, invisibles), les bornes "Monter" (ProximityPrompt), l'arène et
	les 6 autos tamponneuses (physique), les bornes des stands de
	nourriture (FoodService). Tout le décor (structures, chevaux, nacelles,
	guirlandes, stands, clôtures…) est construit par chaque client
	(Client/World/FairFx) et suit la MÊME pose (Shared/FairRides : fonction
	pure de l'heure du serveur).

	Pourquoi des sièges ANCRÉS déplacés par CFrame : un avatar assis est
	soudé (SeatWeld) à son siège ; siège ancré = tout l'assemblage ancré :
	aucune physique, donc jamais de projection ni de chute, quel que soit
	le poids des passagers. Le serveur ne déplace QUE les sièges occupés
	(10 fois / s, peu de réseau) ; chaque client déplace localement tous
	les sièges proches à chaque image (FairFx : même pose -> fluide).
	Monter : invite "Monter" à l'entrée du manège -> Seat:Sit sur une place
	libre (sièges CanTouch = false : on ne s'y assoit jamais par accident).
	Descendre : sauter / bouton "Se lever" -> le serveur repose l'avatar à
	la sortie du manège (jamais en l'air).
	Autos tamponneuses : caisse NON ancrée (groupe de collision
	"DopamineBumper" : se cognent entre elles et contre la bordure, jamais
	contre les piétons), VehicleSeat, LinearVelocity + AlignOrientation
	réglés par le client du conducteur (propriétaire réseau), comme
	CarService ; rangée (ancrée) à sa place dès qu'elle est libre.
	Budget : ~110 pièces serveur, 0 lumière (les lueurs sont côté client).
	(v9.9, FAIR99) + l'ANNEXE (buildAnnex) : cirque (24 places sur les
	gradins, invite "Voir le spectacle"), grand huit (4 wagons x 2),
	bateau pirate (12 places), train fantôme (3 wagonnets x 2) : ~60 pièces
	de plus ; trampolines et palais des glaces : rien au serveur (client).
	Les sièges occupés ne bougent plus que 4 fois / s au serveur : chaque
	client les pose lui-même à chaque image (FairFx) -> plus de saccades.

	API (TownMap / TownPlaza) :
	  TownFair.Build(decor, geo) -> Folder "Fair" (réserve la place AVANT la
	    nature / les rues : appeler avant elles)
	  TownFair.BuildFoodCorner(decor, geo) -> Folder "FoodCorner"
	  TownFair.AddPlazaCarousel(model, baseCF, booth) : sièges + invite du
	    manège de la place (appelé par TownPlaza, avant Build)
	  TownFair.StallAnchor(parent, cf, stallId, foods, label) : borne de stand
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local PhysicsService = game:GetService("PhysicsService")

local WorldLayout = require(ReplicatedStorage.Shared.WorldLayout)
local FairRides = require(ReplicatedStorage.Shared.FairRides)
local Config = require(ReplicatedStorage.Shared.Config)
local TownKit = require(script.Parent.TownKit)

local TownFair = {}

TownFair.FOLDER_NAME = "Fair"
TownFair.BUMPER_GROUP = "DopamineBumper"
TownFair.WALKER_GROUP = "DopamineWalkers" -- (= CarService.WALKER_GROUP)

local M = TownKit.M
local part = TownKit.Part

-- (v9.9, FAIR99) sièges occupés déplacés 4 fois / s seulement : chaque
-- client déplace LUI-MÊME tous les sièges occupés à chaque image (FairFx),
-- la valeur du serveur ne sert plus qu'à garder l'avatar à peu près au bon
-- endroit côté serveur (et ne se voit jamais : le client la réécrit avant
-- le rendu). Avant : 10 fois / s, et ces mises à jour répliquées faisaient
-- reculer les passagers d'une image sur les autres écrans ("saccadé").
local SERVER_RATE = 0.25
local GATE_RANGE = 14 -- (studs) distance max à la borne pour monter
local BUMPER_SPEED_CLAMP = 60

local function foodService(): any
	local services = script.Parent.Parent
	local module = services:FindFirstChild("FoodService")
	if not module then
		return nil
	end
	local ok, result = pcall(require, module)
	return ok and result or nil
end

----------------------------------------------------------------------
-- État (un seul jeu de manèges : TownMap.Build peut reconstruire)
----------------------------------------------------------------------

type Ride = {
	Def: any,
	Base: CFrame,
	Seats: { Seat },
	Riders: { [Seat]: Humanoid },
	Groups: { CFrame },
	Exit: CFrame,
	Gate: BasePart?,
	Cars: { any }?,
}

local rides: { Ride } = {}
local pendingPlaza: Ride? = nil
local connections: { RBXScriptConnection } = {}
local generation = 0

local function serverNow(): number
	return workspace:GetServerTimeNow()
end

----------------------------------------------------------------------
-- Pièces serveur
----------------------------------------------------------------------

local function invisible(p: BasePart): BasePart
	p.Transparency = 1
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	return p
end

local function newSeat(parent: Instance, name: string, size: Vector3, cf: CFrame): Seat
	local seat = part(parent, name, size, cf, Color3.fromRGB(255, 255, 255), M.SmoothPlastic, "deco", "Seat") :: Seat
	invisible(seat)
	-- (SEAT98 : SitAnimator joue les poses "manège" : bras levés, regard, pieds)
	seat:SetAttribute("SitKind", "ride")
	return seat
end

-- Invite (textes anglais ; FairFx les traduit : attributs LocAction / LocObject)
local function prompt(host: BasePart, action: string, object: string, distance: number): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.Name = "FairPrompt"
	p.ActionText = action
	p.ObjectText = object
	p.KeyboardKeyCode = Enum.KeyCode.E
	p.HoldDuration = 0
	p.MaxActivationDistance = distance
	p.RequiresLineOfSight = false
	p.Style = Enum.ProximityPromptStyle.Default
	p:SetAttribute("LocAction", action)
	p:SetAttribute("LocObject", object)
	p.Parent = host
	return p
end

----------------------------------------------------------------------
-- Monter / descendre
----------------------------------------------------------------------

local function characterOf(player: Player): (Model?, Humanoid?, BasePart?)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not character or not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
		return nil, nil, nil
	end
	return character, humanoid, root
end

local function poseRide(ride: Ride, t: number)
	if ride.Def.Kind ~= "Bumper" then
		FairRides.Pose(ride.Def, t, ride.Groups)
	end
end

local function seatWorld(ride: Ride, index: number): CFrame
	return ride.Base * FairRides.SeatLocal(ride.Def.Kind, index, ride.Groups)
end

-- Place libre : grande roue = la nacelle la plus basse ; sinon au hasard
local function pickSeat(ride: Ride): (Seat?, number?)
	local free = {}
	for i, seat in ipairs(ride.Seats) do
		if seat.Occupant == nil and ride.Riders[seat] == nil then
			table.insert(free, i)
		end
	end
	if #free == 0 then
		return nil, nil
	end
	local best = free[math.random(1, #free)]
	if ride.Def.Kind == "Ferris" then
		local lowest = math.huge
		for _, i in ipairs(free) do
			local y = seatWorld(ride, i).Position.Y
			if y < lowest - 0.01 then
				lowest = y
				best = i
			end
		end
	end
	return ride.Seats[best], best
end

local function exitCharacter(ride: Ride, humanoid: Humanoid, index: number)
	local character = humanoid.Parent
	if not character or not character:IsA("Model") or not character.Parent then
		return
	end
	if humanoid.SeatPart ~= nil then
		return -- (déjà assis ailleurs)
	end
	local off = ((index % 5) - 2) * 1.6
	local cf = ride.Exit * CFrame.new(off, 3.2, 0)
	pcall(function()
		character:PivotTo(cf)
	end)
end

local releaseCar: (ride: Ride, car: any) -> ()

local function watchSeat(ride: Ride, seat: Seat, index: number)
	table.insert(connections, seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		local occupant = seat.Occupant
		local previous = ride.Riders[seat]
		if occupant then
			ride.Riders[seat] = occupant
			return
		end
		ride.Riders[seat] = nil
		if previous then
			-- (après la destruction de la soudure : on repose l'avatar au sol)
			task.defer(exitCharacter, ride, previous, index)
		end
		if ride.Cars then
			for _, car in ipairs(ride.Cars) do
				if car.Seat == seat then
					task.delay(1.2, function()
						if seat.Occupant == nil then
							releaseCar(ride, car)
						end
					end)
				end
			end
		end
	end))
end

local function board(ride: Ride, player: Player)
	local _, humanoid, root = characterOf(player)
	if not humanoid or not root then
		return
	end
	if humanoid.SeatPart ~= nil then
		return -- déjà assis (voiture, banc, autre manège)
	end
	local gate = ride.Gate
	if gate and (root.Position - gate.Position).Magnitude > GATE_RANGE then
		return
	end
	if ride.Def.Kind == "Bumper" then
		local cars = ride.Cars or {}
		for _, car in ipairs(cars) do
			if car.Seat.Occupant == nil and not car.Busy then
				car.Busy = true
				local body: BasePart = car.Body
				body.Anchored = false
				pcall(function()
					body:SetNetworkOwner(player)
				end)
				car.Seat:Sit(humanoid)
				task.delay(0.5, function()
					car.Busy = false
				end)
				return
			end
		end
		return
	end
	-- (v9.9) grand huit, train fantôme, bateau : on monte seulement en gare
	-- (pendant l'embarquement), jamais dans un wagon en marche
	local kind = ride.Def.Kind
	if kind == "Coaster" or kind == "Ghost" or kind == "Pirate" then
		local phase, left = FairRides.Phase(ride.Def, serverNow())
		if phase ~= "load" or left < 0.8 then
			return
		end
	end
	local seat, index = pickSeat(ride)
	if not seat or not index then
		return
	end
	-- siège mis à la pose EXACTE du moment, puis on s'assoit
	poseRide(ride, serverNow())
	seat.CFrame = seatWorld(ride, index)
	ride.Riders[seat] = humanoid
	seat:Sit(humanoid)
	task.delay(1, function()
		if seat.Occupant == nil and ride.Riders[seat] == humanoid then
			ride.Riders[seat] = nil
		end
	end)
end

local function addGate(ride: Ride, parent: Instance, gateCF: CFrame)
	local gate = invisible(part(parent, "RideGate", Vector3.new(1.2, 5, 1.2), gateCF * CFrame.new(0, 2.5, 0), Color3.fromRGB(255, 255, 255), M.SmoothPlastic, "deco"))
	gate:SetAttribute("RideId", ride.Def.Id)
	local def = ride.Def
	local action = if def.Kind == "Circus" then "Watch the show" else "Ride"
	local p = prompt(gate, action, def.Icon .. " " .. def.Name, 10)
	p:SetAttribute("RideId", def.Id)
	table.insert(connections, p.Triggered:Connect(function(player)
		local ok, err = pcall(board, ride, player)
		if not ok then
			warn("[TownFair] monter : " .. tostring(err))
		end
	end))
	ride.Gate = gate
end

local function makeRide(parent: Instance, def: any, base: CFrame, exitCF: CFrame): Ride
	local ride: Ride = { Def = def, Base = base, Seats = {}, Riders = {}, Groups = {}, Exit = exitCF }
	local model = Instance.new("Folder")
	model.Name = def.Id
	model:SetAttribute("BaseCF", base) -- (v9.9 : le client lit la place de l'annexe ici)
	model.Parent = parent
	if def.Kind ~= "Bumper" then
		poseRide(ride, serverNow())
		for i, spec in ipairs(FairRides.Seats(def.Kind)) do
			local seat = newSeat(model, "RideSeat", spec.Size, seatWorld(ride, i))
			seat:SetAttribute("RideId", def.Id)
			seat:SetAttribute("SeatIndex", i)
			ride.Seats[i] = seat
			watchSeat(ride, seat, i)
		end
	end
	return ride
end

----------------------------------------------------------------------
-- Autos tamponneuses
----------------------------------------------------------------------

local BUMPER_COLORS = {
	Color3.fromRGB(236, 72, 120),
	Color3.fromRGB(80, 170, 255),
	Color3.fromRGB(255, 200, 60),
	Color3.fromRGB(110, 210, 150),
	Color3.fromRGB(176, 120, 240),
	Color3.fromRGB(255, 130, 70),
}

local function setupGroups()
	pcall(function()
		PhysicsService:RegisterCollisionGroup(TownFair.BUMPER_GROUP)
	end)
	pcall(function()
		PhysicsService:RegisterCollisionGroup(TownFair.WALKER_GROUP)
	end)
	pcall(function()
		PhysicsService:CollisionGroupSetCollidable(TownFair.BUMPER_GROUP, TownFair.WALKER_GROUP, false)
		PhysicsService:CollisionGroupSetCollidable(TownFair.BUMPER_GROUP, TownFair.BUMPER_GROUP, true)
	end)
end

local function carHome(ride: Ride, index: number): CFrame
	return ride.Base * CFrame.new(0, 0.3, 0) * FairRides.BumperHome(index)
end

releaseCar = function(ride: Ride, car: any)
	local body: BasePart = car.Body
	if not body.Parent then
		return
	end
	pcall(function()
		if not body.Anchored then
			body:SetNetworkOwner(nil)
		end
	end)
	body.AssemblyLinearVelocity = Vector3.zero
	body.AssemblyAngularVelocity = Vector3.zero
	body.Anchored = true
	body.CFrame = carHome(ride, car.Index) * CFrame.new(0, 0.6, 0)
	local velocity = body:FindFirstChild("BumperVelocity") :: LinearVelocity?
	if velocity then
		velocity.PlaneVelocity = Vector2.zero
	end
	local align = body:FindFirstChild("BumperAlign") :: AlignOrientation?
	if align then
		align.CFrame = body.CFrame.Rotation
	end
end

local function buildBumper(parent: Instance, ride: Ride)
	setupGroups()
	local model = parent:FindFirstChild(ride.Def.Id) or parent
	local W, D = FairRides.BUMPER_W, FairRides.BUMPER_D
	local base = ride.Base
	-- piste (légèrement surélevée) + bordure en caoutchouc
	local floor = part(model, "BumperFloor", Vector3.new(W, 0.3, D), base * CFrame.new(0, 0.15, 0), Color3.fromRGB(70, 74, 92), M.SmoothPlastic, "solid")
	floor.CastShadow = false
	local rubber = Color3.fromRGB(250, 214, 80)
	for _, s in ipairs({ { 0, -D / 2 - 0.4, W + 1.6, 0.8 }, { 0, D / 2 + 0.4, W + 1.6, 0.8 }, { -W / 2 - 0.4, 0, 0.8, D }, { W / 2 + 0.4, 0, 0.8, D } }) do
		local wall = part(model, "BumperRail", Vector3.new(s[3], 1.9, s[4]), base * CFrame.new(s[1], 0.95, s[2]), rubber, M.Rubber, "solid")
		wall.CustomPhysicalProperties = PhysicalProperties.new(1, 0.2, 0.7, 1, 100)
	end
	local cars: { any } = {}
	ride.Cars = cars
	for i = 1, FairRides.BUMPER_CARS do
		local home = carHome(ride, i)
		local body = part(model, "BumperBody", Vector3.new(3.4, 1.1, 4.6), home * CFrame.new(0, 0.6, 0), BUMPER_COLORS[(i - 1) % #BUMPER_COLORS + 1], M.SmoothPlastic, "solid")
		body.CanQuery = false
		body.CustomPhysicalProperties = PhysicalProperties.new(1.2, 0, 0.55, 100, 100)
		pcall(function()
			body.CollisionGroup = TownFair.BUMPER_GROUP
		end)
		body:SetAttribute("BumperIndex", i)
		local seat = Instance.new("VehicleSeat")
		seat.Name = "BumperSeat"
		seat.Size = Vector3.new(1.6, 0.3, 1.6)
		seat.CFrame = body.CFrame * CFrame.new(0, 0.7, 0.55)
		seat.Transparency = 1
		seat.CanCollide = false
		seat.CanTouch = false
		seat.CanQuery = false
		seat.CastShadow = false
		seat.Massless = true
		seat.MaxSpeed = 0
		seat.Torque = 0
		seat.TurnSpeed = 0
		seat.HeadsUpDisplay = false
		seat.Anchored = false
		seat:SetAttribute("RideId", ride.Def.Id)
		seat:SetAttribute("SeatIndex", i)
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = body
		weld.Part1 = seat
		weld.Parent = seat
		seat.Parent = body
		TownKit.Stats.Parts += 1
		local attachment = Instance.new("Attachment")
		attachment.Name = "Drive"
		attachment.Parent = body
		local mass = 3.4 * 1.1 * 4.6 * 1.2 -- (volume x densité de la caisse)
		local velocity = Instance.new("LinearVelocity")
		velocity.Name = "BumperVelocity"
		velocity.Attachment0 = attachment
		velocity.RelativeTo = Enum.ActuatorRelativeTo.World
		velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
		velocity.PrimaryTangentAxis = Vector3.new(1, 0, 0)
		velocity.SecondaryTangentAxis = Vector3.new(0, 0, 1)
		velocity.PlaneVelocity = Vector2.zero
		velocity.MaxForce = math.max(800, (mass + 20) * 90)
		velocity.Parent = body
		local align = Instance.new("AlignOrientation")
		align.Name = "BumperAlign"
		align.Mode = Enum.OrientationAlignmentMode.OneAttachment
		align.Attachment0 = attachment
		align.RigidityEnabled = false
		align.MaxTorque = math.max(1e5, mass * 4000)
		align.MaxAngularVelocity = 10
		align.Responsiveness = 25
		align.CFrame = body.CFrame.Rotation
		align.Parent = body
		local car = { Body = body, Seat = seat, Index = i, Busy = false }
		table.insert(cars, car)
		ride.Seats[i] = seat :: any
		watchSeat(ride, seat :: any, i)
	end
end

-- Ronde (2 fois / s) : auto sortie de l'arène, tombée ou trop rapide -> rangée
local function patrolBumper(ride: Ride)
	local cars = ride.Cars
	if not cars then
		return
	end
	for _, car in ipairs(cars) do
		local body: BasePart = car.Body
		if body.Parent and not body.Anchored then
			local rel = ride.Base:PointToObjectSpace(body.Position)
			local out = math.abs(rel.X) > FairRides.BUMPER_W / 2 + 2 or math.abs(rel.Z) > FairRides.BUMPER_D / 2 + 2 or rel.Y < -3 or rel.Y > 6
			if out or body.AssemblyLinearVelocity.Magnitude > BUMPER_SPEED_CLAMP then
				local occupant = car.Seat.Occupant
				if occupant then
					occupant.Sit = false
				end
				releaseCar(ride, car)
			elseif car.Seat.Occupant == nil and not car.Busy then
				releaseCar(ride, car)
			end
		end
	end
end

----------------------------------------------------------------------
-- Boucle serveur : seuls les sièges OCCUPÉS bougent (10 fois / s)
----------------------------------------------------------------------

local moveParts: { BasePart } = {}
local moveFrames: { CFrame } = {}

local function stepRides()
	local t = serverNow()
	table.clear(moveParts)
	table.clear(moveFrames)
	for _, ride in ipairs(rides) do
		if ride.Def.Kind ~= "Bumper" and ride.Def.Kind ~= "Circus" and next(ride.Riders) ~= nil then
			poseRide(ride, t)
			for i, seat in ipairs(ride.Seats) do
				if seat.Occupant ~= nil then
					table.insert(moveParts, seat)
					table.insert(moveFrames, seatWorld(ride, i))
				end
			end
		end
	end
	if #moveParts > 0 then
		workspace:BulkMoveTo(moveParts, moveFrames, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

-- Nouvelle construction de la ville : on oublie l'ancienne (connexions,
-- boucle, manèges) ; appelé par le premier de AddPlazaCarousel / Build
local function beginEpoch()
	for _, c in ipairs(connections) do
		c:Disconnect()
	end
	table.clear(connections)
	table.clear(rides)
	generation += 1
end

local function startLoop()
	local myGen = generation
	local acc, patrol = 0, 0
	table.insert(connections, RunService.Heartbeat:Connect(function(dt)
		if myGen ~= generation then
			return
		end
		acc += dt
		patrol += dt
		if acc >= SERVER_RATE then
			acc = 0
			local ok, err = pcall(stepRides)
			if not ok then
				warn("[TownFair] " .. tostring(err))
			end
		end
		if patrol >= 0.5 then
			patrol = 0
			for _, ride in ipairs(rides) do
				if ride.Cars then
					pcall(patrolBumper, ride)
				end
			end
		end
	end))
end

----------------------------------------------------------------------
-- Stands de nourriture (borne invisible + invite, enregistrée par FoodService)
----------------------------------------------------------------------

-- `cf` = devant du comptoir (au sol), -Z vers les clients
function TownFair.StallAnchor(parent: Instance, cf: CFrame, stallId: string, foods: { string }, label: string): BasePart
	local anchor = invisible(part(parent, "StallAnchor", Vector3.new(2, 4, 1), cf * CFrame.new(0, 2.6, 0), Color3.fromRGB(255, 255, 255), M.SmoothPlastic, "deco"))
	anchor:SetAttribute("FoodStall", stallId)
	local p = prompt(anchor, "Order", label, 9)
	p:SetAttribute("FoodStall", stallId)
	p:SetAttribute("Foods", table.concat(foods, ","))
	local service = foodService()
	if service and type(service.RegisterStall) == "function" then
		service.RegisterStall(stallId, anchor, foods)
	end
	return anchor
end

local function stallLabel(foods: { string }): string
	local icons = {}
	for _, id in ipairs(foods) do
		local food = Config.FoodById[id]
		if food then
			table.insert(icons, food.Icon)
		end
	end
	return table.concat(icons, " ") .. " Snacks"
end

----------------------------------------------------------------------
-- Manège de la place (TownPlaza) : 12 places sur les chevaux / carrosses
----------------------------------------------------------------------

function TownFair.AddPlazaCarousel(model: Instance, baseCF: CFrame, booth: BasePart?)
	beginEpoch()
	local def = {
		Id = "PlazaCarousel",
		Kind = "PlazaCarousel",
		Name = "Carousel",
		Icon = "🎠",
		Cycle = { Load = 0, Ramp = 0, Run = 1 },
		Speed = 0,
	}
	local exitCF = if booth then CFrame.new(booth.Position + (baseCF.Position - booth.Position) * Vector3.new(1, 0, 1) * -0.35) else baseCF * CFrame.new(0, 0, -13)
	local folder = Instance.new("Folder")
	folder.Name = "RideSeats"
	folder.Parent = model
	local ride = makeRide(folder, def, baseCF, CFrame.new(exitCF.Position.X, baseCF.Position.Y - 1.2, exitCF.Position.Z))
	if booth then
		addGate(ride, folder, CFrame.new(booth.Position.X, baseCF.Position.Y - 1.2, booth.Position.Z))
	end
	pendingPlaza = ride
end

----------------------------------------------------------------------
-- La fête
----------------------------------------------------------------------

-- Réserve le rectangle de la fête (arbres / terrains n'y poussent pas)
local function reserve(geo: TownKit.Geo, F: CFrame)
	for _, x in ipairs({ -40, 0, 40 }) do
		for _, z in ipairs({ -20, 20 }) do
			geo.Reserve(F * Vector3.new(x, 0, z), 25)
		end
	end
	for _, x in ipairs({ -20, 20 }) do
		geo.Reserve(F * Vector3.new(x, 0, 0), 25)
	end
	geo.Reserve(F * Vector3.new(0, 0, -44), 10) -- allée devant l'arche
end


----------------------------------------------------------------------
-- (v9.9, FAIR99) 🎪 ANNEXE : cirque, grand huit, bateau pirate, train
-- fantôme, trampolines, palais des glaces. Leur place dépend de la taille
-- de la ville : FairRides.SolveAnnex cherche des places LIBRES (geo : rues,
-- boulevard, place, zones réservées) autour de la fête, AVANT que la
-- nature ne soit posée. Les sites fixes de la nature (lac, jardin fleuri,
-- basket : TownNature) sont évités ici (même calcul que TownNature) ; le
-- jardin et le basket ne sont "empiétés" qu'en dernier recours (2e passe :
-- ils doivent alors tester geo.IsFree, c'est convenu avec CITY99 / main).
----------------------------------------------------------------------

-- Sites fixes de TownNature (copie de ses formules : lac, jardin, basket)
local function natureSites(geo: TownKit.Geo): { { P: Vector3, R: number, Lake: boolean } }
	local sites = {}
	local ok = pcall(function()
		local aR = geo.SlotAngle(geo.SideR)
		local aL = geo.SlotAngle(geo.SideL)
		local r0 = WorldLayout.PLAZA_R + 30
		local depth = geo.Inner - r0
		local mid = r0 + depth / 2
		local lakeR = math.min(math.clamp(depth / 2 - 12, 20, 42) * 1.15, depth / 2 - 18)
		table.insert(sites, { P = geo.At((aR + math.pi) / 2 + 0.05, mid + 4), R = lakeR + 9, Lake = true })
		table.insert(sites, { P = geo.At((math.pi + aL) / 2 + 0.06, r0 + 25), R = 16, Lake = false })
		if depth > 70 then
			table.insert(sites, { P = geo.At((math.pi + aL) / 2 - 0.05, geo.Inner - 18), R = 17, Lake = false })
		end
	end)
	return if ok then sites else {}
end

local function solveAnnex(geo: TownKit.Geo, F: CFrame): { [string]: any }
	local sites = natureSites(geo)
	local function free(lx: number, lz: number, loose: boolean): boolean
		local p = F * Vector3.new(lx, 0, lz)
		if not geo.IsFree(p, 0) then
			return false
		end
		for _, s in ipairs(sites) do
			if (s.Lake or not loose) and Vector3.new(p.X - s.P.X, 0, p.Z - s.P.Z).Magnitude < s.R then
				return false
			end
		end
		return true
	end
	local ok, result = pcall(FairRides.SolveAnnex, function(x, z)
		return free(x, z, false)
	end, function(x, z)
		return free(x, z, true)
	end)
	if not ok then
		warn("[TownFair] annexe : " .. tostring(result))
		return {}
	end
	return result
end

local function buildAnnex(folder: Instance, ridesFolder: Instance, geo: TownKit.Geo, F: CFrame, placements: { [string]: any }): number
	local annex = Instance.new("Folder")
	annex.Name = "Annex"
	annex.Parent = folder
	local count = 0
	local boxes = { { X0 = -FairRides.FAIR_HALF_W - 1, X1 = FairRides.FAIR_HALF_W + 1, Z0 = -FairRides.FAIR_HALF_D - 1, Z1 = FairRides.FAIR_HALF_D + 1 } }
	for _, def in ipairs(FairRides.Annex) do
		local place = placements[def.Id]
		if place then
			table.insert(boxes, place.Box)
		end
	end
	for _, def in ipairs(FairRides.Annex) do
		local place = placements[def.Id]
		if place then
			count += 1
			local base = F * place.CF
			-- (le sol de terre battue est posé par chaque client : FairFx ; ici
			-- seulement la réserve, pour que rien ne pousse dessus)
			local b, a = def.Body, def.Apron
			local x0, x1 = math.min(b.X0, a.X0) - 1, math.max(b.X1, a.X1) + 1
			local z0, z1 = math.min(b.Z0, a.Z0) - 1, b.Z1 + 1
			local center = base * Vector3.new((x0 + x1) / 2, 0, (z0 + z1) / 2)
			geo.Reserve(center, math.sqrt((x1 - x0) ^ 2 + (z1 - z0) ^ 2) / 2 + 2)
			-- allée depuis la porte de la fête la plus proche (réservée : pas d'arbre dessus)
			local path = FairRides.AnnexPath(def, place.CF, boxes)
			for i = 1, #path - 1 do
				local p0, p1 = path[i], path[i + 1]
				local len = (p1 - p0).Magnitude
				local n = math.max(1, math.ceil(len / 5))
				for k = 0, n do
					geo.Reserve(F * p0:Lerp(p1, k / n), 3.5)
				end
			end
			if def.Kind == "Trampolines" or def.Kind == "Mirrors" then
				-- (pas de siège : tout est côté client ; le dossier porte la place)
				local model = Instance.new("Folder")
				model.Name = def.Id
				model:SetAttribute("BaseCF", base)
				model.Parent = ridesFolder
			else
				local ride = makeRide(ridesFolder, def, base, base * CFrame.new(def.Exit))
				if def.Kind == "Circus" then
					-- (v9.9) les panneaux directionnels de la ville indiquent le cirque (🎪 = 3)
					pcall(TownKit.LifeSpot, "Dest", base, 3)
					-- (gradins : pose "banc" de SitAnimator, pas les bras levés du manège)
					for _, seat in ipairs(ride.Seats) do
						seat:SetAttribute("SitKind", "bench")
					end
				end
				addGate(ride, ridesFolder, base * CFrame.new(def.Gate))
				table.insert(rides, ride)
			end
		else
			warn("[TownFair] annexe : pas de place pour " .. def.Id)
		end
	end
	return count
end

function TownFair.Build(decor: Instance, geo: TownKit.Geo): Folder
	-- (reconstruction : l'ancienne boucle s'arrête, les sièges partent avec la ville)
	local plaza = pendingPlaza
	pendingPlaza = nil
	if not plaza then
		beginEpoch()
	end
	table.clear(rides)
	local F = WorldLayout.FairCFrame()
	-- (v9.9) places de l'annexe AVANT les réserves de la fête (ses cercles
	-- débordent un peu de la clôture)
	local placements = solveAnnex(geo, F)
	reserve(geo, F)
	local folder = Instance.new("Folder")
	folder.Name = TownFair.FOLDER_NAME
	folder:SetAttribute("FxVersion", 1)
	folder:SetAttribute("FairCF", F)
	folder.Parent = decor
	-- sol de la fête (terre battue claire ; allées et décor : client)
	local ground = part(folder, "FairGround", Vector3.new(WorldLayout.FAIR_W, 0.3, WorldLayout.FAIR_D), F * CFrame.new(0, -0.15, 0), Color3.fromRGB(226, 206, 170), M.Ground, "solid")
	ground.CastShadow = false
	local ridesFolder = Instance.new("Folder")
	ridesFolder.Name = "Rides"
	ridesFolder.Parent = folder
	for _, def in ipairs(FairRides.Rides) do
		local base = FairRides.RideBase(F, def)
		local exitCF = F * CFrame.new(def.Exit)
		local ride = makeRide(ridesFolder, def, base, exitCF)
		addGate(ride, ridesFolder, F * CFrame.new(def.Gate))
		if def.Kind == "Bumper" then
			buildBumper(ridesFolder, ride)
		end
		table.insert(rides, ride)
	end
	-- (v9.9) 🎪 l'annexe : cirque + nouveaux manèges
	local annexCount = buildAnnex(folder, ridesFolder, geo, F, placements)
	folder:SetAttribute("Annex", annexCount)
	if plaza then
		table.insert(rides, plaza) -- (sièges et invite créés juste avant par TownPlaza)
	end
	-- stands de nourriture de la fête
	local stallsFolder = Instance.new("Folder")
	stallsFolder.Name = "Stalls"
	stallsFolder.Parent = folder
	for _, s in ipairs(FairRides.Stalls) do
		local cf = F * CFrame.new(s.Pos) * CFrame.Angles(0, math.rad(s.Yaw), 0)
		TownFair.StallAnchor(stallsFolder, cf * CFrame.new(0, 0, -2.2), s.Id, s.Foods, stallLabel(s.Foods))
	end
	startLoop()
	folder:SetAttribute("Rides", #rides)
	return folder
end

-- 🍦 Coin gourmand près de l'arrivée : sol pavé + 3 bornes de stands
function TownFair.BuildFoodCorner(decor: Instance, geo: TownKit.Geo): Folder
	local cf = WorldLayout.FoodCornerCFrame(geo.Count)
	local folder = Instance.new("Folder")
	folder.Name = "FoodCorner"
	folder:SetAttribute("FxVersion", 1)
	folder:SetAttribute("CornerCF", cf)
	folder.Parent = decor
	-- (juste au-dessus du trottoir : jamais coplanaire avec lui)
	local pad = part(folder, "CornerPad", Vector3.new(WorldLayout.FOOD_W, 1.3, WorldLayout.FOOD_D), cf * CFrame.new(0, -0.65 + 0.04, 0), Color3.fromRGB(236, 222, 208), M.Pavement, "solid")
	pad.CastShadow = false
	for _, s in ipairs(FairRides.CornerStalls) do
		local scf = cf * CFrame.new(s.Pos) * CFrame.Angles(0, math.rad(s.Yaw), 0)
		local front = if s.Style == "Truck" then CFrame.new(0, 0, -3.4) else CFrame.new(0, 0, -2.2)
		TownFair.StallAnchor(folder, scf * front, s.Id, s.Foods, stallLabel(s.Foods))
	end
	geo.Reserve(cf.Position, math.sqrt((WorldLayout.FOOD_W / 2) ^ 2 + (WorldLayout.FOOD_D / 2) ^ 2))
	return folder
end

-- (tests / debug) état des manèges
function TownFair.Debug(): any
	return { Rides = rides }
end

-- Garde l'API privée utilisable par les tests : monter un joueur
function TownFair.Board(rideId: string, player: Player): boolean
	for _, ride in ipairs(rides) do
		if ride.Def.Id == rideId then
			board(ride, player)
			return true
		end
	end
	return false
end

-- (Players.PlayerRemoving : rien à faire, Seat.Occupant repasse à nil tout seul)
local _ = Players

return TownFair
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="387">
          <Properties>
            <string name="Name">TownKit</string>
            <string name="Source"><![CDATA[--[[
	TownKit (ModuleScript)
	Emplacement : ServerScriptService > Services > World > TownKit

	🧱 Boîte à outils du décor de Dopamine Town (v9.4), partagée par
	TownStreets / TownPlaza / TownBuildings / TownEntrance / TownNature :
	  - fabrique de pièces avec des PROFILS de performance :
	      "solid" : on marche dessus / on s'y cogne (sol, murs, troncs) ;
	      "prop"  : petit objet solide, sans ombre ni requête ;
	      "deco"  : décor pur (CanCollide / CanQuery / CanTouch false, sans
	                ombre) : feuillages, lignes de la route, fenêtres... ;
	      "decoS" : décor pur qui garde son ombre (gros volumes) ;
	  - disques, boules, cylindres debout, poutres entre deux points ;
	  - compteur de pièces et BUDGET de vraies lumières (≤ 16 pour la ville) ;
	  - panneaux SurfaceGui (texte clé "LocText" : le client peut traduire) ;
	  - petits objets de rue réutilisés partout (arbres, lampadaires, bancs,
	    poubelles, bornes, jardinières, voitures...).
	Tout est ancré, construit UNE fois au démarrage du serveur.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WorldLayout = require(ReplicatedStorage.Shared.WorldLayout)
local CarModels = require(ReplicatedStorage.Shared.CarModels) -- (v9.6, GARAGE96) voitures garées
local VehicleModels = require(ReplicatedStorage.Shared.VehicleModels) -- (v9.7, VEHICLES97) bus, vélos, camions
local Greenery = require(ReplicatedStorage.Shared.Greenery) -- (v9.7, NATURE97) arbres

local TownKit = {}

local M = Enum.Material
TownKit.M = M

TownKit.MAX_LIGHTS = 16

-- Palette "kawaii réaliste" : matières réelles, teintes douces
TownKit.C = {
	White = Color3.fromRGB(255, 255, 255),
	Cream = Color3.fromRGB(252, 246, 236),
	Grass = Color3.fromRGB(128, 196, 112),
	GrassDark = Color3.fromRGB(104, 172, 96),
	Lawn = Color3.fromRGB(140, 206, 118),
	Asphalt = Color3.fromRGB(78, 80, 92),
	AsphaltDark = Color3.fromRGB(64, 66, 78),
	Walk = Color3.fromRGB(216, 210, 204),
	Curb = Color3.fromRGB(238, 236, 232),
	Line = Color3.fromRGB(250, 250, 246),
	Yellow = Color3.fromRGB(255, 208, 72),
	Paving = Color3.fromRGB(240, 222, 212),
	PavingRose = Color3.fromRGB(226, 170, 178),
	PavingLilac = Color3.fromRGB(200, 186, 226),
	Stone = Color3.fromRGB(226, 220, 212),
	StoneDark = Color3.fromRGB(170, 162, 156),
	Wood = Color3.fromRGB(176, 124, 84),
	WoodLight = Color3.fromRGB(214, 168, 122),
	Bark = Color3.fromRGB(122, 88, 64),
	Metal = Color3.fromRGB(62, 58, 76),
	MetalLight = Color3.fromRGB(150, 150, 164),
	Glass = Color3.fromRGB(168, 214, 240),
	GlassDark = Color3.fromRGB(96, 136, 170),
	Water = Color3.fromRGB(96, 186, 236),
	WaterDeep = Color3.fromRGB(58, 132, 190),
	Sand = Color3.fromRGB(236, 214, 170),
	Pink = Color3.fromRGB(255, 132, 184),
	HotPink = Color3.fromRGB(236, 72, 140),
	Lilac = Color3.fromRGB(186, 150, 246),
	Mint = Color3.fromRGB(128, 222, 190),
	Sky = Color3.fromRGB(126, 196, 255),
	Peach = Color3.fromRGB(255, 190, 150),
	Lemon = Color3.fromRGB(255, 228, 120),
	Glow = Color3.fromRGB(255, 232, 180),
	Ink = Color3.fromRGB(92, 58, 96),
	Plum = Color3.fromRGB(120, 90, 160),
}
local C = TownKit.C

TownKit.FOLIAGE = {
	Color3.fromRGB(96, 170, 92),
	Color3.fromRGB(116, 186, 98),
	Color3.fromRGB(84, 150, 88),
	Color3.fromRGB(255, 182, 206), -- cerisier
	Color3.fromRGB(140, 196, 110),
}
TownKit.FLOWERS = {
	Color3.fromRGB(255, 110, 160),
	Color3.fromRGB(255, 214, 96),
	Color3.fromRGB(186, 140, 255),
	Color3.fromRGB(255, 255, 255),
	Color3.fromRGB(255, 150, 110),
}

----------------------------------------------------------------------
-- Compteurs (pour le budget : pièces, vraies lumières)
----------------------------------------------------------------------

local stats = { Parts = 0, Lights = 0 }
TownKit.Stats = stats

-- (v9.8, CITY98) mobilier de rue + chemins des passants construits côté
-- CLIENT (TownStreetLife / TownPeople) : le serveur ne fait que noter les
-- emplacements (0 pièce), publiés en attributs par TownKit.PublishLife
local life: { Spots: { string }, Paths: { [string]: { Points: { Vector3 }, Loop: boolean } } } = { Spots = {}, Paths = {} }

function TownKit.Reset()
	stats.Parts = 0
	stats.Lights = 0
	life.Spots = {}
	life.Paths = {}
end

----------------------------------------------------------------------
-- Pièces
----------------------------------------------------------------------

export type Profile = string -- "solid" | "prop" | "deco" | "decoS"

local function applyProfile(p: BasePart, profile: Profile?)
	if profile == "deco" then
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
	elseif profile == "decoS" then
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
	elseif profile == "prop" then
		p.CanTouch = false
		p.CanQuery = false
		p.CastShadow = false
	elseif profile == "ghost" then
		-- (mur invisible : bloque sans être vu ni visé)
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Transparency = 1
	else
		p.CanTouch = false
	end
end

-- Pièce ancrée ; `className` : "Part" (défaut), "WedgePart", "Seat"...
function TownKit.Part(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?, profile: Profile?, className: string?): BasePart
	local p = Instance.new((className or "Part") :: any) :: BasePart
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	applyProfile(p, profile)
	p.Parent = parent
	stats.Parts += 1
	return p
end
local part = TownKit.Part

function TownKit.Wedge(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?, profile: Profile?): BasePart
	return part(parent, name, size, cframe, color, material, profile, "WedgePart")
end

-- Disque plat (cylindre couché), dessus à la hauteur `topY` du point `center`
function TownKit.Disc(parent: Instance, name: string, center: Vector3, radius: number, thickness: number, color: Color3, material: Enum.Material?, profile: Profile?): BasePart
	local p = part(parent, name, Vector3.new(thickness, radius * 2, radius * 2), CFrame.new(center - Vector3.new(0, thickness / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), color, material, profile)
	;(p :: Part).Shape = Enum.PartType.Cylinder
	return p
end

function TownKit.Ball(parent: Instance, name: string, center: Vector3, diameter: number, color: Color3, material: Enum.Material?, profile: Profile?): BasePart
	local p = part(parent, name, Vector3.new(diameter, diameter, diameter), CFrame.new(center), color, material, profile or "deco")
	;(p :: Part).Shape = Enum.PartType.Ball
	return p
end

-- Boule aplatie / étirée (bloc arrondi = cylindre couché court) : pour les
-- feuillages en couches on garde de vraies boules (plus jolies en jeu)
function TownKit.Column(parent: Instance, name: string, bottom: Vector3, height: number, diameter: number, color: Color3, material: Enum.Material?, profile: Profile?): BasePart
	local p = part(parent, name, Vector3.new(height, diameter, diameter), CFrame.new(bottom + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), color, material, profile)
	;(p :: Part).Shape = Enum.PartType.Cylinder
	return p
end

-- Poutre (bloc) entre deux points, section w x h (h vertical quand c'est possible)
function TownKit.Beam(parent: Instance, name: string, a: Vector3, b: Vector3, w: number, h: number, color: Color3, material: Enum.Material?, profile: Profile?): BasePart
	local mid = (a + b) / 2
	local len = (b - a).Magnitude
	local cf
	if math.abs((b - a).Unit.Y) > 0.98 then
		cf = CFrame.new(mid) * CFrame.Angles(math.rad(90), 0, 0)
	else
		cf = CFrame.lookAt(mid, b)
	end
	return part(parent, name, Vector3.new(w, h, len), cf, color, material, profile)
end

-- Tige cylindrique entre deux points
function TownKit.Rod(parent: Instance, name: string, a: Vector3, b: Vector3, diameter: number, color: Color3, material: Enum.Material?, profile: Profile?): BasePart
	local mid = (a + b) / 2
	local len = (b - a).Magnitude
	local cf = CFrame.lookAt(mid, b) * CFrame.Angles(0, math.rad(90), 0)
	local p = part(parent, name, Vector3.new(len, diameter, diameter), cf, color, material, profile or "deco")
	;(p :: Part).Shape = Enum.PartType.Cylinder
	return p
end

function TownKit.Model(parent: Instance, name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

----------------------------------------------------------------------
-- Lumières (budget global)
----------------------------------------------------------------------

-- v9.6 (FIXES96) "flash bang" : plafonds pour TOUTES les lumières de la
-- ville (même si un appelant demande plus) ; lumières "NightOnly" : le
-- client (TownAtmosphere) ne les allume que la nuit
TownKit.MAX_LIGHT_BRIGHTNESS = 1
TownKit.MAX_LIGHT_RANGE = 20

function TownKit.Light(host: BasePart, color: Color3, range: number, brightness: number, kind: string?): Light?
	if stats.Lights >= TownKit.MAX_LIGHTS then
		return nil
	end
	stats.Lights += 1
	local light: Light
	local r = math.min(range, TownKit.MAX_LIGHT_RANGE)
	if kind == "Spot" then
		local spot = Instance.new("SpotLight")
		spot.Angle = 70
		spot.Face = Enum.NormalId.Bottom
		spot.Range = r
		light = spot
	else
		local point = Instance.new("PointLight")
		point.Range = r
		light = point
	end
	light.Color = color
	light.Brightness = math.min(brightness, TownKit.MAX_LIGHT_BRIGHTNESS)
	light.Shadows = false
	light:SetAttribute("NightOnly", true)
	light.Parent = host
	return light
end

-- Verre de lanterne / ampoule : mat (SmoothPlastic) le jour, Neon la nuit
-- (bascule côté client, TownAtmosphere) ; à garder PETIT (≤ ~1 stud)
function TownKit.Glow(p: BasePart): BasePart
	p.Material = M.SmoothPlastic
	p:SetAttribute("NightGlow", true)
	return p
end

----------------------------------------------------------------------
-- Panneaux (SurfaceGui)
----------------------------------------------------------------------

function TownKit.Surface(board: BasePart, face: Enum.NormalId, pixelsPerStud: number, background: Color3?, maxDistance: number?, lightInfluence: number?): (SurfaceGui, Frame)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Sign"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerStud
	-- (v9.6 : 0.5 par défaut, un panneau n'est plus une boîte lumineuse la nuit)
	gui.LightInfluence = lightInfluence or 0.5
	gui.MaxDistance = maxDistance or 400
	gui.Parent = board
	local frame = Instance.new("Frame")
	frame.Name = "Body"
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = background or C.White
	frame.BackgroundTransparency = background and 0 or 1
	frame.BorderSizePixel = 0
	frame.Parent = gui
	return gui, frame
end

-- Texte (clé anglaise en attribut "LocText" : le client la traduit)
function TownKit.Label(parent: Instance, name: string, text: string, x: number, y: number, w: number, h: number, color: Color3, font: Enum.Font?, localize: boolean?): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundTransparency = 1
	l.Position = UDim2.fromScale(x, y)
	l.Size = UDim2.fromScale(w, h)
	l.Font = font or Enum.Font.GothamBold
	l.Text = text
	l.TextColor3 = color
	l.TextScaled = true
	if localize then
		l:SetAttribute("LocText", text)
	end
	l.Parent = parent
	return l
end

function TownKit.Corner(parent: Instance, radius: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
end

function TownKit.Gradient(parent: Instance, a: Color3, b: Color3, rotation: number)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(a, b)
	g.Rotation = rotation
	g.Parent = parent
end

function TownKit.Stroke(parent: Instance, color: Color3, thickness: number)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
end

----------------------------------------------------------------------
-- Objets de rue
----------------------------------------------------------------------

-- Angle (autour de Y) qui tourne l'axe X local vers `dir` (bras des lampadaires...)
function TownKit.Facing(dir: Vector3): number
	return math.atan2(-dir.Z, dir.X)
end

-- Pseudo-aléatoire stable (même ville à chaque démarrage)
function TownKit.Hash(a: number, b: number?): number
	local x = math.sin(a * 12.9898 + (b or 0) * 78.233) * 43758.5453
	return x - math.floor(x)
end
local hash = TownKit.Hash

-- Arbre (v9.7, NATURE97) : espèces réalistes stylisées de Shared/Greenery
-- (tronc évasé, branches, grappes irrégulières en 2-3 teintes).
-- `kind` : nom d'espèce ("Oak", "Maple", "Cherry", "Birch", "Fir", "Palm",
-- "Poplar", "Fruit", "Willow", "Round") ou ancien numéro v9.4 (1 feuillu
-- au hasard, 2 cerisier, 3 sapin, 4 boule taillée).
-- `opts.Tier` : niveau de détail construit par le SERVEUR (0 = silhouette,
-- défaut ; 1 = arbre "vedette" avec branches) ; le client (TownGreenery)
-- ajoute le niveau 2 aux arbres proches. `opts.Lawn` : sur pelouse (pétales
-- au sol permis).
TownKit.SPECIES = Greenery.SPECIES
-- v9.9 (CITY99, budget du serveur) : l'arbre n'est plus construit ici. Le
-- serveur pose un Model VIDE (0 pièce) qui porte les attributs de l'arbre
-- (TreeBase / TreeSpecies / TreeHeight / TreeSeed / TreeTier / TreeLawn,
-- comme Greenery.Tree) + "TreeClient" = true ; chaque client construit le
-- même arbre (Greenery.Tree : mêmes pièces, même hasard) à l'arrivée en
-- ville (TownStreetLife, les plus proches d'abord) et TownGreenery ajoute
-- toujours le niveau de détail de près. WorldPivot = pied de l'arbre (les
-- ClearSite du supermarché / de la concession le lisent).
function TownKit.Tree(parent: Instance, base: Vector3, height: number, seed: number, kind: any?, opts: { Tier: number?, Lawn: boolean? }?)
	local o = opts or {}
	local species = Greenery.Species(kind or 1, seed)
	local model = Greenery.Tree(parent, base, height, seed, species, -1, 0, { Lawn = o.Lawn == true })
	model:SetAttribute("TreeTier", o.Tier or 0)
	model:SetAttribute("TreeClient", true)
	model.WorldPivot = CFrame.new(base)
	return model
end

-- Buisson : 3-4 boules qui se chevauchent (+ fleurs si `flower`)
function TownKit.Bush(parent: Instance, base: Vector3, size: number, seed: number, flower: Color3?)
	local model = TownKit.Model(parent, "Bush")
	local a = hash(seed, 81) * math.pi * 2
	local green = TownKit.FOLIAGE[1 + math.floor(hash(seed, 82) * 3) % 3]
	local function at(ang: number, r: number, y: number): Vector3
		return base + Vector3.new(math.cos(ang) * r, y, math.sin(ang) * r)
	end
	TownKit.Ball(model, "Bush", at(a, size * 0.06, size * 0.36), size, green, M.Grass, "decoS")
	TownKit.Ball(model, "Bush", at(a + 2.2, size * 0.42, size * 0.26), size * 0.7, green:Lerp(C.White, 0.1), M.Grass, "deco")
	TownKit.Ball(model, "Bush", at(a + 4.1, size * 0.38, size * 0.22), size * 0.62, green:Lerp(Color3.new(0, 0, 0), 0.1), M.Grass, "deco")
	if flower then
		for k = 0, 1 do
			local p = at(a + 1 + k * 2.6, size * 0.4, size * 0.62)
			TownKit.Egg(model, "Blossom", CFrame.new(p), Vector3.new(size * 0.34, size * 0.2, size * 0.34), flower, M.SmoothPlastic, "deco")
		end
	end
	return model
end

-- Ovale (Part + SpecialMesh "Sphere" : une Ball de Roblox reste ronde)
function TownKit.Egg(parent: Instance, name: string, cf: CFrame, size: Vector3, color: Color3, material: Enum.Material?, profile: Profile?): BasePart
	local p = part(parent, name, size, cf, color, material or M.Grass, profile or "deco")
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

-- Haie taillée au dessus ARRONDI : corps + boudin (cylindre couché) + bouts
-- arrondis (colonne + boule). `cf` au sol, au milieu, longueur le long de X.
-- 6 pièces ; seul le corps est solide.
TownKit.HEDGE = Color3.fromRGB(78, 146, 76)
function TownKit.Hedge(parent: Instance, cf: CFrame, length: number, width: number, height: number, seed: number?)
	local model = TownKit.Model(parent, "Hedge")
	local w = width
	local L = math.max(length, w + 0.5)
	local body = height - w / 2
	local green = TownKit.HEDGE:Lerp(Color3.fromRGB(96, 160, 84), hash(seed or 1, 83) * 0.6)
	local top = green:Lerp(Color3.fromRGB(150, 200, 110), 0.18)
	part(model, "Hedge", Vector3.new(L - w, body - 0.04, w - 0.04), cf * CFrame.new(0, (body - 0.04) / 2, 0), green, M.Grass, "prop")
	local roll = part(model, "HedgeTop", Vector3.new(L - w - 0.1, w, w), cf * CFrame.new(0, body, 0), top, M.Grass, "decoS")
	;(roll :: Part).Shape = Enum.PartType.Cylinder
	for _, sx in ipairs({ -1, 1 }) do
		local x = sx * (L - w) / 2
		TownKit.Column(model, "HedgeEnd", (cf * CFrame.new(x, 0, 0)).Position, body - 0.08, w, green, M.Grass, "deco")
		TownKit.Ball(model, "HedgeCap", (cf * CFrame.new(x, body, 0)).Position, w, top, M.Grass, "deco")
	end
	return model
end

-- Massif de fleurs rond : bordure en pierre, terre, touffes de feuilles et
-- VRAIS bouquets (ovales de couleur posés sur les feuilles) ; ~11 pièces
function TownKit.FlowerBed(parent: Instance, center: Vector3, radius: number, seed: number)
	local model = TownKit.Model(parent, "FlowerBed")
	TownKit.Disc(model, "BedEdge", center + Vector3.new(0, 0.45, 0), radius + 0.4, 0.45, C.Stone, M.Cobblestone, "prop")
	TownKit.Disc(model, "BedSoil", center + Vector3.new(0, 0.52, 0), radius, 0.2, Color3.fromRGB(104, 74, 58), M.Ground, "deco")
	local a = hash(seed, 84) * math.pi * 2
	local leaf = Color3.fromRGB(86, 150, 78)
	for k = 0, 2 do
		local ang = a + k * math.pi * 2 / 3
		-- (hauteurs décalées de 0,06 : aucune face de boîte confondue, même pour un détecteur qui ignore le maillage)
		local p = center + Vector3.new(math.cos(ang) * radius * 0.42, 0.62 + k * 0.06, math.sin(ang) * radius * 0.42)
		TownKit.Egg(model, "Leaves", CFrame.new(p) * CFrame.Angles(0, -ang, 0), Vector3.new(radius * 0.95, 1.1, radius * 0.75), leaf:Lerp(C.White, k * 0.06), M.Grass, "deco")
	end
	local n = radius >= 3 and 6 or 4
	for k = 0, n - 1 do
		local ang = a + 0.5 + k * math.pi * 2 / n
		local r = radius * (k % 2 == 0 and 0.62 or 0.36)
		local p = center + Vector3.new(math.cos(ang) * r, 1.1 + (k % 2) * 0.2 + k * 0.05, math.sin(ang) * r)
		local color = TownKit.FLOWERS[(seed + k) % #TownKit.FLOWERS + 1]
		TownKit.Egg(model, "Blooms", CFrame.new(p) * CFrame.Angles(0, ang, 0), Vector3.new(1.5, 0.75, 1.3), color, M.SmoothPlastic, "deco")
	end
	TownKit.Egg(model, "Blooms", CFrame.new(center + Vector3.new(0, 1.55, 0)), Vector3.new(1.6, 1, 1.6), TownKit.FLOWERS[(seed + 2) % #TownKit.FLOWERS + 1], M.SmoothPlastic, "deco")
	return model
end

-- Touffes d'herbe haute (3 ovales fins penchés) dans un rectangle w x d
function TownKit.Tufts(parent: Instance, cf: CFrame, w: number, d: number, seed: number)
	local model = TownKit.Model(parent, "Tufts")
	for k = 0, 2 do
		local x = (hash(seed, 85 + k) - 0.5) * w
		local z = (hash(seed, 88 + k) - 0.5) * d
		local h = 1.2 + hash(seed, 91 + k) * 0.8
		TownKit.Egg(model, "Tuft", cf * CFrame.new(x, h * 0.3, z) * CFrame.Angles(math.rad(8), hash(seed, 94 + k) * 6, math.rad(-6)), Vector3.new(1.3, h, 0.9), Color3.fromRGB(96, 164, 80):Lerp(Color3.fromRGB(150, 196, 96), hash(seed, 97 + k)), M.Grass, "deco")
	end
	return model
end

-- Lampadaire de ville (fonte + lanterne) ; `light` : vraie lumière si le budget le permet
function TownKit.Lamp(parent: Instance, base: Vector3, facing: number, light: boolean?, double: boolean?)
	local model = TownKit.Model(parent, "Lamp")
	local rot = CFrame.new(base) * CFrame.Angles(0, facing, 0)
	part(model, "Foot", Vector3.new(1.3, 1, 1.3), rot * CFrame.new(0, 0.5, 0), C.Metal, M.Metal, "prop")
	TownKit.Column(model, "Pole", base + Vector3.new(0, 1, 0), 11, 0.45, C.Metal, M.Metal, "prop")
	local arms = double and { -1, 1 } or { 1 }
	local glowPart: BasePart? = nil
	for _, side in ipairs(arms) do
		local armEnd = rot * CFrame.new(side * 2.2, 11.6, 0)
		TownKit.Beam(model, "Arm", (rot * CFrame.new(0, 11.8, 0)).Position, armEnd.Position, 0.22, 0.22, C.Metal, M.Metal, "deco")
		part(model, "Hood", Vector3.new(1.6, 0.35, 1.6), armEnd * CFrame.new(0, -0.1, 0), C.Metal, M.Metal, "deco")
		-- (v9.6 : verre dépoli sous le chapeau, Neon la nuit seulement)
		local glow = part(model, "Glow", Vector3.new(0.9, 0.9, 0.9), armEnd * CFrame.new(0, -0.74, 0), C.Glow, M.SmoothPlastic, "deco")
		TownKit.Glow(glow)
		glowPart = glowPart or glow
	end
	part(model, "Cap", Vector3.new(0.7, 0.5, 0.7), rot * CFrame.new(0, 12.2, 0), C.Metal, M.Metal, "deco")
	if light and glowPart then
		-- (v9.6 : 26 / 1.4 -> 18 / 0.85)
		TownKit.Light(glowPart, C.Glow, 18, 0.85)
	end
	return model
end

-- Banc public (v9.6, refait) : banc de parc réaliste, vrai Seat.
-- `cf` = au sol, milieu du banc ; l'AVANT (LookVector, -Z local) est le côté
-- où l'on s'assoit, le DOSSIER est du côté +Z local. Signature inchangée.
--   - 2 flasques en fonte (pied avant qui monte jusqu'à l'accoudoir, pied
--     arrière qui continue en montant du dossier, accoudoir) : 14 pièces en
--     tout (budget de la ville) ;
--   - 3 lattes d'assise + 2 lattes de dossier en bois, dossier incliné de
--     12° vers l'ARRIÈRE (+Z) ; (v9.4 : incliné vers l'avant, flottant) ;
--   - assise à 1.9 stud (R15) ; le Seat (invisible) est une seule pièce
--     dont le DESSUS = le dessus des lattes et la face avant (-Z) regarde à
--     l'opposé du dossier -> le personnage s'assoit face à l'avant, le dos
--     contre le dossier ;
--   - seul le Seat a CanTouch ; tout est ancré ; lattes / accoudoirs sans
--     collision (pas de petites pièces qui font trébucher).
TownKit.BENCH = {
	Length = 5.4, -- lattes (x)
	SeatTop = 1.45, -- dessus de l'assise (y) ; v9.9 (CITY99, échelle SCALE99) : 1,9 -> 1,45 (~45 cm, assise réelle)
	SeatFront = -0.85, -- bord avant de l'assise (z)
	SeatBack = 0.75, -- bord arrière de l'assise (z)
	Tilt = 12, -- (°) dossier incliné vers l'arrière
}
function TownKit.Bench(parent: Instance, cf: CFrame)
	local B = TownKit.BENCH
	local model = TownKit.Model(parent, "Bench")
	local wood = Color3.fromRGB(196, 140, 92)
	local iron = Color3.fromRGB(58, 54, 66)
	local L, H = B.Length, B.SeatTop
	local SLAT_T = 0.16
	-- Seat : une pièce invisible, dessus = assise visible, avant = -Z ; un
	-- peu reculée (le personnage s'assoit au CENTRE du Seat : le dos vient
	-- contre le dossier, les cuisses sur les lattes avant)
	local zFront, zBack = B.SeatFront, B.SeatBack
	local seatDepth = zBack - zFront
	local seat = part(model, "Seat", Vector3.new(L, 1, seatDepth - 0.25), cf * CFrame.new(0, H - 0.5, (zFront + 0.25 + zBack) / 2), wood, M.Wood, "solid", "Seat")
	seat.Transparency = 1
	seat.CanCollide = true
	seat.CanQuery = true
	seat.CanTouch = true -- (un Seat s'active au contact : SEULE pièce touchable)
	seat.CastShadow = false
	-- 3 lattes d'assise (visibles, sans collision)
	local slatW = (seatDepth - 2 * 0.08) / 3
	for i = 0, 2 do
		local z = zFront + slatW / 2 + i * (slatW + 0.08)
		part(model, "SeatSlat", Vector3.new(L, SLAT_T, slatW), cf * CFrame.new(0, H - SLAT_T / 2, z), wood, M.Wood, "deco").CastShadow = true
	end
	-- dossier : 2 lattes sur un repère incliné (pivot au bord arrière de l'assise)
	local tilt = CFrame.Angles(math.rad(B.Tilt), 0, 0) -- (+X : le haut part vers +Z)
	local pivot = cf * CFrame.new(0, H + 0.05, zBack - 0.05) * tilt
	for i, y in ipairs({ 0.55, 1.2 }) do
		local slat = part(model, "BackSlat", Vector3.new(L, 0.5, 0.14), pivot * CFrame.new(0, y, 0.07), wood, M.Wood, "prop")
		slat.CastShadow = true
		slat.Name = "BackSlat" .. i
	end
	-- 2 flasques en fonte, JUSTE à l'extérieur des lattes
	local fx = L / 2 + 0.13
	local armY = H + 0.72
	for _, sx in ipairs({ -1, 1 }) do
		local x = sx * fx
		-- pied avant (du sol jusqu'à l'accoudoir)
		part(model, "FrontLeg", Vector3.new(0.22, armY, 0.22), cf * CFrame.new(x, armY / 2, zFront + 0.2), iron, M.Metal, "prop")
		-- pied arrière (du sol à l'assise), puis montant du dossier (incliné)
		part(model, "RearLeg", Vector3.new(0.22, H, 0.22), cf * CFrame.new(x, H / 2, zBack - 0.12), iron, M.Metal, "prop")
		part(model, "BackPost", Vector3.new(0.22, 1.75, 0.2), pivot * CFrame.new(x, 0.755, -0.02), iron, M.Metal, "deco")
		-- accoudoir
		part(model, "ArmRest", Vector3.new(0.3, 0.14, seatDepth + 0.1), cf * CFrame.new(x, armY + 0.07, (zFront + zBack) / 2 - 0.08), iron, M.Metal, "deco")
	end
	return model
end

-- Poubelle (tri : deux couleurs)
function TownKit.Bin(parent: Instance, base: Vector3, color: Color3?)
	local model = TownKit.Model(parent, "Bin")
	TownKit.Column(model, "Body", base, 2.6, 1.6, color or Color3.fromRGB(96, 150, 110), M.Metal, "prop")
	TownKit.Column(model, "Lid", base + Vector3.new(0, 2.6, 0), 0.3, 1.8, C.Metal, M.Metal, "deco")
	return model
end

-- Borne (potelet)
function TownKit.Bollard(parent: Instance, base: Vector3)
	TownKit.Column(parent, "Bollard", base, 2.2, 0.6, C.Metal, M.Metal, "prop")
end

-- Bouche d'incendie
function TownKit.Hydrant(parent: Instance, base: Vector3)
	local model = TownKit.Model(parent, "Hydrant")
	TownKit.Column(model, "Body", base, 2, 0.8, Color3.fromRGB(226, 64, 72), M.Metal, "prop")
	TownKit.Ball(model, "Top", base + Vector3.new(0, 2, 0), 0.8, Color3.fromRGB(226, 64, 72), M.Metal, "deco")
	part(model, "Nozzle", Vector3.new(1.4, 0.35, 0.35), CFrame.new(base + Vector3.new(0, 1.4, 0)), C.MetalLight, M.Metal, "deco")
	return model
end

-- Jardinière de fleurs (bac en pierre + terre + boules de fleurs)
function TownKit.Planter(parent: Instance, cf: CFrame, length: number, width: number, seed: number)
	local model = TownKit.Model(parent, "Planter")
	part(model, "Box", Vector3.new(length, 1.6, width), cf * CFrame.new(0, 0.8, 0), C.Stone, M.Concrete, "prop")
	part(model, "Soil", Vector3.new(length - 0.6, 0.2, width - 0.6), cf * CFrame.new(0, 1.62, 0), Color3.fromRGB(110, 78, 60), M.Ground, "deco")
	-- (v9.7) touffes de feuillage arrondies + bouquets (ovales posés dessus)
	local leaves = math.max(1, math.floor(length / 4 + 0.5))
	for i = 1, leaves do
		local x = -length / 2 + (i - 0.5) * length / leaves
		TownKit.Egg(model, "Leaves", cf * CFrame.new(x, 2 + (i % 2) * 0.06, 0), Vector3.new(length / leaves + 0.6, 1.3, width - 0.46 - (i % 2) * 0.24), C.GrassDark:Lerp(C.White, (i % 2) * 0.08), M.Grass, "deco")
	end
	local n = math.max(2, math.floor(length / 2.2))
	for i = 1, n do
		local x = -length / 2 + (i - 0.5) * length / n
		local color = TownKit.FLOWERS[(seed + i) % #TownKit.FLOWERS + 1]
		TownKit.Egg(model, "Flower", cf * CFrame.new(x, 2.55 + (i % 2) * 0.12, (hash(seed, i) - 0.5) * (width - 1.6)) * CFrame.Angles(0, hash(seed, i + 9) * 3, 0), Vector3.new(1.4, 0.7, 1.2), color, M.SmoothPlastic, "deco")
	end
	return model
end

-- Arceau à vélos + un vélo garé
-- (v9.7, VEHICLES97) Place réservée à un véhicule construit côté CLIENT
-- (TownTraffic, en flux : bus complet, vélos, trottinettes, voitures garées
-- en plus...) : une Configuration (0 pièce) dans DopamineTown/VehicleSpots,
-- attributs Kind + CF (au sol, avant vers -Z) + options (Color, Variant...).
-- `collider` (facultatif) : boîte invisible solide côté serveur (1 pièce),
-- pour qu'on ne traverse pas un bus / un camion.
TownKit.SPOTS_FOLDER = "VehicleSpots"
function TownKit.VehicleSpot(parent: Instance, kind: string, cf: CFrame, attrs: { [string]: any }?, collider: { Size: Vector3, CF: CFrame }?): Instance
	local root = parent:FindFirstAncestor("DopamineTown") or parent
	local folder = root:FindFirstChild(TownKit.SPOTS_FOLDER)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = TownKit.SPOTS_FOLDER
		folder.Parent = root
	end
	local spot = Instance.new("Configuration")
	spot.Name = kind
	spot:SetAttribute("Kind", kind)
	spot:SetAttribute("CF", cf)
	for key, value in pairs(attrs or {}) do
		spot:SetAttribute(key, value)
	end
	spot.Parent = folder
	if collider then
		part(parent, "VehicleCollider", collider.Size, collider.CF, C.White, M.SmoothPlastic, "ghost")
	end
	return spot
end

-- (v9.8, CITY98) VIE DE LA RUE, construite côté CLIENT (0 pièce serveur) :
--   TownKit.LifeSpot(kind, cf, seed)   un objet de rue (poubelle, abribus,
--       kiosque, feux, panneau publicitaire, moulin...) : `cf` au sol, avant
--       du mobilier vers -Z (seule la rotation autour de Y est gardée) ;
--   TownKit.LifePath(name, points, loop)  un chemin des passants (au sol) ;
--   TownKit.PublishLife(root)          à la fin du Build : dossier
--       "StreetLife" (Configuration par case de 64 studs, attribut "Data" =
--       lignes "kind;x;y;z;yaw;seed[;sx,sy,sz]") + Configuration "Path" (attributs
--       Name, Loop, Points = "x,y,z;x,y,z...").
TownKit.LIFE_FOLDER = "StreetLife"
TownKit.LIFE_CELL = 64

local function r2(v: number): string
	return string.format("%.2f", v)
end

-- `size` (facultatif) : taille d'une pièce simple (peinture au sol : "Paint")
function TownKit.LifeSpot(kind: string, cf: CFrame, seed: number?, size: Vector3?)
	local _, yaw = cf:ToEulerAnglesYXZ()
	local p = cf.Position
	local fields = { kind, r2(p.X), r2(p.Y), r2(p.Z), string.format("%.4f", yaw), tostring(math.floor(seed or 0)) }
	if size then
		table.insert(fields, r2(size.X) .. "," .. r2(size.Y) .. "," .. r2(size.Z))
	end
	table.insert(life.Spots, table.concat(fields, ";"))
end

function TownKit.LifePath(name: string, points: { Vector3 }, loop: boolean)
	life.Paths[name] = { Points = points, Loop = loop }
end

function TownKit.LifeCount(): number
	return #life.Spots
end

function TownKit.PublishLife(root: Instance): Folder
	local old = root:FindFirstChild(TownKit.LIFE_FOLDER)
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = TownKit.LIFE_FOLDER
	local cells: { [string]: { string } } = {}
	local order: { string } = {}
	for _, line in ipairs(life.Spots) do
		local fields = string.split(line, ";")
		local cx = math.floor((tonumber(fields[2]) or 0) / TownKit.LIFE_CELL)
		local cz = math.floor((tonumber(fields[4]) or 0) / TownKit.LIFE_CELL)
		local key = cx .. "_" .. cz
		if not cells[key] then
			cells[key] = {}
			table.insert(order, key)
		end
		table.insert(cells[key], line)
	end
	for _, key in ipairs(order) do
		local cell = Instance.new("Configuration")
		cell.Name = "Cell_" .. key
		cell:SetAttribute("Data", table.concat(cells[key], "\n"))
		cell:SetAttribute("Count", #cells[key])
		cell.Parent = folder
	end
	local names = {}
	for name in pairs(life.Paths) do
		table.insert(names, name)
	end
	table.sort(names)
	for _, name in ipairs(names) do
		local path = life.Paths[name]
		local pts = {}
		for _, p in ipairs(path.Points) do
			table.insert(pts, r2(p.X) .. "," .. r2(p.Y) .. "," .. r2(p.Z))
		end
		local conf = Instance.new("Configuration")
		conf.Name = "Path"
		conf:SetAttribute("Name", name)
		conf:SetAttribute("Loop", path.Loop)
		conf:SetAttribute("Points", table.concat(pts, ";"))
		conf.Parent = folder
	end
	folder:SetAttribute("Version", 1)
	folder:SetAttribute("Spots", #life.Spots)
	folder.Parent = root
	return folder
end

-- Arceaux à vélos (v9.7, VEHICLES97) : 3 arceaux inox en U (serveur, sans
-- coudes : 10 pièces) + `bikes` vélos réalistes (cadre, roues à rayons,
-- panier...) construits côté client entre les arceaux (TownTraffic).
function TownKit.BikeRack(parent: Instance, cf: CFrame, bikes: number)
	local model = VehicleModels.BikeRack({ Count = 3, Gap = 2.2, Plate = false, Bends = false })
	model:PivotTo(cf)
	model.Parent = parent
	stats.Parts += tonumber(model:GetAttribute("PartCount")) or 0
	local colors = { C.Sky, C.Pink, C.Mint, C.Lemon }
	for i, x in ipairs({ -1.1, 1.1, 3.3, -3.3 }) do
		if i > bikes then
			break
		end
		TownKit.VehicleSpot(parent, "Bike", cf * CFrame.new(x, 0, 0.15), { Variant = if i == 3 then "Kid" else "City", Color = colors[i] })
	end
	return model
end

-- Panneau routier (poteau + disque / losange)
function TownKit.RoadSign(parent: Instance, base: Vector3, facing: number, color: Color3, shape: string?)
	local model = TownKit.Model(parent, "RoadSign")
	TownKit.Column(model, "Pole", base, 7, 0.25, C.MetalLight, M.Metal, "prop")
	local cf = CFrame.new(base + Vector3.new(0, 7.2, 0)) * CFrame.Angles(0, facing, 0)
	if shape == "Diamond" then
		part(model, "Plate", Vector3.new(1.8, 1.8, 0.12), cf * CFrame.Angles(0, 0, math.rad(45)), color, M.Metal, "deco")
		-- (v9.6 z-fighting : 0.2 d'épaisseur, 0.04 devant / derrière la plaque)
		part(model, "Inner", Vector3.new(1.3, 1.3, 0.2), cf * CFrame.Angles(0, 0, math.rad(45)), C.White, M.SmoothPlastic, "deco")
	elseif shape == "Rect" then
		part(model, "Plate", Vector3.new(2.6, 1.6, 0.12), cf, color, M.Metal, "deco")
		part(model, "Inner", Vector3.new(2.2, 1.2, 0.2), cf, C.White, M.SmoothPlastic, "deco")
	else
		local plate = part(model, "Plate", Vector3.new(0.12, 2.2, 2.2), cf * CFrame.Angles(0, math.rad(90), 0), color, M.Metal, "deco")
		;(plate :: Part).Shape = Enum.PartType.Cylinder
		part(model, "Bar", Vector3.new(1.4, 0.36, 0.22), cf, C.White, M.SmoothPlastic, "deco")
	end
	return model
end

-- Voiture garée (carrosserie + cabine vitrée + roues + phares) ; `cf` au sol, avant vers -Z
-- (v9.6, GARAGE96) vrais modèles de Shared/CarModels, en version "Parked"
-- (~45-55 pièces, sans intérieur) : `kind` = Id de CarModels / Config.Cars
-- (nil = "CityCar") ; "Van" SANS `opts` garde le gabarit v9.4 (camion à
-- tacos de TownNature : 4,7 x 11 studs). `opts` = options de CarModels.Build.
-- Seule la boîte "Root" (invisible) est solide ; aucune lumière, aucun Neon.
function TownKit.Car(parent: Instance, cf: CFrame, color: Color3, kind: string?, opts: any?)
	local options: { [string]: any } = { Detail = "Parked" }
	if type(opts) == "table" then
		for key, value in pairs(opts) do
			options[key] = value
		end
	elseif kind == "Van" then
		options.Scale = Vector3.new(0.78, 0.87, 0.85)
	end
	local model = CarModels.Build(kind or "CityCar", color, options)
	model.Name = "Car"
	model:PivotTo(cf)
	model.Parent = parent
	stats.Parts += tonumber(model:GetAttribute("PartCount")) or 0
	return model
end

----------------------------------------------------------------------
-- Géométrie de la ville (repère : centre de la place = Origin, sol y = 0)
----------------------------------------------------------------------
-- (v10 LAYOUT10) La grande ville : le centre-ville est le carré du
-- boulevard (WorldLayout.DOWNTOWN_B) ; ses 4 côtés sont les 4
-- "emplacements" (0 = entrée +Z, 1 = +X, 2 = -Z mairie, 3 = -X). IsFree ne
-- répond que pour l'INTÉRIEUR du centre-ville (le décor des parcs) ;
-- IsFreeCity pour toute la ville (routes, parcelles, lieux réservés de
-- WorldLayout.Facilities + réservations). Districts / Graph : ceux de
-- WorldLayout (quartiers, graphe routier).
-- Emplacements 0..m-1 autour de la place (0 = entrée, +Z), boulevard
-- polygonal (un côté droit par emplacement). Repère d'un côté (SideFrame) :
-- x le long de la rue (vers la droite de qui regarde la place), -z vers le
-- centre, +z vers l'extérieur.

export type Geo = {
	Count: number,
	Slots: number,
	Origin: Vector3,
	HalfAngle: number,
	PlotR: number,
	Front: number,
	Road: number,
	Inner: number,
	Gate: number,
	Town: number,
	StreetStart: number,
	SideR: number,
	SideL: number,
	Streets: { number },
	Reserved: { { P: Vector3, R: number } },
	Dir: (angle: number) -> Vector3,
	SlotAngle: (slot: number) -> number,
	At: (angle: number, dist: number, y: number?) -> Vector3,
	SideFrame: (slot: number, dist: number, y: number?) -> CFrame,
	PolyRadius: (p: Vector3) -> number,
	Reserve: (p: Vector3, r: number) -> (),
	IsFree: (p: Vector3, r: number) -> boolean,
	IsFreeCity: (p: Vector3, r: number) -> boolean,
	Districts: { any },
	Graph: any,
}

function TownKit.Geo(count: number): Geo
	local O = WorldLayout.Origin()
	local m = WorldLayout.PlotSlots(count)
	local g = {} :: any
	g.Count = count
	g.Slots = m
	g.Origin = O
	g.HalfAngle = math.pi / m
	g.PlotR = WorldLayout.PlotRadius(count)
	g.Front = WorldLayout.PlotFrontRadius(count)
	g.Road = WorldLayout.RingRoadRadius(count)
	g.Inner = WorldLayout.RingInnerRadius(count)
	g.Gate = WorldLayout.GateDistance(count)
	g.Town = WorldLayout.TownRadius(count)
	-- (les rues commencent après la couronne de boutiques de la place)
	g.StreetStart = WorldLayout.PLAZA_R + 30
	g.SideR = math.max(1, math.floor(m / 4 + 0.5))
	g.SideL = m - g.SideR
	g.Streets = { 0, g.SideR, g.SideL }
	g.Reserved = {}
	function g.Dir(angle: number): Vector3
		return Vector3.new(math.sin(angle), 0, math.cos(angle))
	end
	function g.SlotAngle(slot: number): number
		return slot / m * math.pi * 2
	end
	-- point relatif au centre (y relatif au sol)
	function g.At(angle: number, dist: number, y: number?): Vector3
		return O + g.Dir(angle) * dist + Vector3.new(0, y or 0, 0)
	end
	function g.SideFrame(slot: number, dist: number, y: number?): CFrame
		local d = g.Dir(g.SlotAngle(slot))
		local p = O + d * dist + Vector3.new(0, y or 0, 0)
		return CFrame.lookAt(p, p - d)
	end
	-- "rayon" polygonal d'un point du monde (comparable à Road / Inner / Front)
	function g.PolyRadius(p: Vector3): number
		local rel = p - O
		local best = -math.huge
		for k = 0, m - 1 do
			local d = g.Dir(g.SlotAngle(k))
			best = math.max(best, rel.X * d.X + rel.Z * d.Z)
		end
		return best
	end
	function g.Reserve(p: Vector3, r: number)
		table.insert(g.Reserved, { P = p, R = r })
	end
	g.Districts = WorldLayout.Districts(count)
	g.Graph = WorldLayout.RoadGraph(count)
	-- Place libre n'importe où en ville (hors centre-ville : voir IsFree)
	function g.IsFreeCity(p: Vector3, r: number): boolean
		local rel = p - O
		if not WorldLayout.IsFreeAt(count, rel.X, rel.Z, r) then
			return false
		end
		for _, z in ipairs(g.Reserved) do
			local dz = Vector3.new(p.X - z.P.X, 0, p.Z - z.P.Z)
			if dz.Magnitude < z.R + r then
				return false
			end
		end
		return true
	end
	-- Place libre pour un objet de rayon r (hors rues, boulevard, place, zones réservées)
	function g.IsFree(p: Vector3, r: number): boolean
		local rel = p - O
		local flat = Vector3.new(rel.X, 0, rel.Z)
		if flat.Magnitude < WorldLayout.PLAZA_R + 26 + r then
			return false
		end
		if g.PolyRadius(p) > g.Inner - 3 - r then
			return false
		end
		for _, slot in ipairs(g.Streets) do
			local d = g.Dir(g.SlotAngle(slot))
			local along = flat:Dot(d)
			local side = math.abs(flat.X * d.Z - flat.Z * d.X)
			local halfW = slot == 0 and 24 or 15
			if along > 0 and side < halfW + r then
				return false
			end
		end
		for _, z in ipairs(g.Reserved) do
			local dz = Vector3.new(p.X - z.P.X, 0, p.Z - z.P.Z)
			if dz.Magnitude < z.R + r then
				return false
			end
		end
		return true
	end
	return g :: Geo
end

return TownKit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="388">
          <Properties>
            <string name="Name">TownMap</string>
            <string name="Source"><![CDATA[--[[
	TownMap (ModuleScript)
	Emplacement : ServerScriptService > Services > World > TownMap

	🚶 Dopamine Town (v9.4) : construit UNE fois, au démarrage du serveur, la
	ville commune dans Workspace > DopamineTown (≈ 3 500 Parts ancrées, 16
	vraies lumières au plus, rien par image) :
	  - TownPlaza     : place pavée, fontaine au cerveau, kiosque, manège,
	                    guirlandes, mairie + GRAND ÉCRAN des meilleurs joueurs,
	                    couronne de boutiques ;
	  - TownStreets   : boulevard polygonal devant les parcelles, avenue
	                    "rambla" de l'entrée à la place, rues latérales,
	                    passages piétons, mobilier, voitures garées ;
	  - TownEntrance  : GRANDE PORTE "DOPAMINE TOWN", place d'accueil, point
	                    d'apparition, plan de la ville (propriétaires), bus,
	                    parking ;
	  - TownNature    : lac + pont, aire de jeux, marché, jardin, basket,
	                    arbres, bois, collines, montagnes, ville lointaine,
	                    murs invisibles ;
	  - TownShops (v9.6) : les boutiques où l'on ENTRE (6 autour de la place,
	                    placées par TownPlaza) et la 🚗 concession auto (à
	                    droite de la place d'accueil), dans le dossier Shops ;
	  - TownMarket (v9.7) : le 🛒 supermarché MégaDopa et son parking, hors
	                    de la porte (WorldLayout.MarketCFrame), dossier Market ;
	  - ici : les N parcelles (WorldLayout) : pelouse, clôtures, haie, arbres,
	    boîte aux lettres et panneau du propriétaire (SetPlotSign, appelé par
	    WorldService) ; le grand écran et le plan suivent les panneaux.
	Les MAISONS ne sont pas ici : chaque client les construit (HouseBuilder).

	Contrat (ENTRY94 / WorldService) :
	  TownMap.SpawnCFrame() -> CFrame : pieds ~3 studs au-dessus du pavé,
	    juste à l'intérieur de la porte, regard vers l'avenue et la place ;
	  attributs de Workspace.DopamineTown : PlotCount, EntranceCF (= SpawnCFrame),
	    PlazaCF (centre de la place au sol), GateCF (arche, LookVector vers la
	    place), TownRadius (murs) ;
	  dossier Seats (sièges créés par WorldService) ; dossier Shops (v9.6 :
	    boutiques où l'on entre, attributs ShopId / InteriorCF… : TownShops) ;
	    attribut Shops (nombre de boutiques) ; Town.PlazaCFrame =
	    SpawnCFrame (retour de chute / apparition sans parcelle).
	  Les TextLabel des panneaux fixes ont un attribut "LocText" (clé anglaise) :
	  le client peut les traduire (Locale.T).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WorldLayout = require(ReplicatedStorage.Shared.WorldLayout)
local TownKit = require(script.Parent.TownKit)
local TownStreets = require(script.Parent.TownStreets)
local TownPlaza = require(script.Parent.TownPlaza)
local TownEntrance = require(script.Parent.TownEntrance)
local TownNature = require(script.Parent.TownNature)
local TownShops = require(script.Parent.TownShops)
local TownMarket = require(script.Parent.TownMarket) -- (v9.7) 🛒 supermarché
local TownFair = require(script.Parent.TownFair) -- (v9.8, FAIR98) 🎡 fête foraine + 🍦 coin gourmand
local TownNetwork = require(script.Parent.TownNetwork) -- (v10, LAYOUT10) routes de la grande ville, autoroute, ponts

local TownMap = {}

TownMap.FOLDER_NAME = "DopamineTown"

local M = TownKit.M
local C = TownKit.C
local part = TownKit.Part

export type PlotInfo = {
	Index: number,
	Model: Model,
	CFrame: CFrame,
	HouseCFrame: CFrame,
	Title: TextLabel,
	Subtitle: TextLabel,
	Stats: TextLabel,
	Board: BasePart,
}

export type Town = {
	Folder: Folder,
	Plots: { PlotInfo },
	Spawn: SpawnLocation,
	PlazaCFrame: CFrame,
	Seats: Folder,
}

-- État du dernier Build (écran + plan à tenir à jour)
local builtCount: number? = nil
local boards: {
	Plots: { PlotInfo },
	Screen: any,
	Map: any,
}? = nil
local refreshPending = false

----------------------------------------------------------------------
-- Parcelles
----------------------------------------------------------------------

local function signLabel(parent: Instance, name: string, text: string, y: number, h: number, color: Color3, font: Enum.Font): TextLabel
	local l = TownKit.Label(parent, name, text, 0.05, y, 0.9, h, color, font, false)
	return l
end

local function buildPlot(parent: Instance, index: number, count: number): PlotInfo
	local plotCF = WorldLayout.PlotCFrame(index, count)
	local houseCF = WorldLayout.HouseCFrame(plotCF)
	local model = Instance.new("Model")
	model.Name = "Plot_" .. index
	model:SetAttribute("Index", index)
	model:SetAttribute("OwnerId", 0)
	-- (v10, LAYOUT10) quartier de la parcelle (WorldLayout.PlotDistrict)
	local district = WorldLayout.PlotDistrict(index, count)
	model:SetAttribute("District", district and district.Id or "Mixed")
	model:SetAttribute("DistrictStyle", district and district.Style or "Mixed")
	model.Parent = parent
	local W, D = WorldLayout.PLOT_W, WorldLayout.PLOT_D
	local g = WorldLayout.GROUND_Y
	-- pelouse (repère : -Z local = vers la rue / la place)
	local base = part(model, "Lawn", Vector3.new(W, 0.3, D), plotCF * CFrame.new(0, g - 0.1, 0), C.Lawn, M.Grass, "solid")
	base:SetAttribute("PlotIndex", index)
	-- bordure en pierre côté rue
	part(model, "Edging", Vector3.new(W, 0.25, 0.6), plotCF * CFrame.new(0, g + 0.1, -D / 2 + 0.36), C.Stone, M.Granite, "deco") -- (v10) 0,06 en retrait : plus de z-fight avec le bord de la pelouse
	-- (v10, LAYOUT10) clôtures, haie, boîte aux lettres et arbres de la parcelle :
	-- construits côté CLIENT par HOUSE10 (parcelle habitée, options de la
	-- maison) et CONSTRUCT10 (chantier des parcelles libres). Le serveur garde
	-- la pelouse, sa bordure et le panneau du propriétaire (budget 50 parcelles).
	-- panneau du propriétaire (à droite du chemin, face à la rue)
	local signCF = plotCF * CFrame.new(10, g, -D / 2 + 2.5)
	for _, sx in ipairs({ -1, 1 }) do
		part(model, "SignPost", Vector3.new(0.5, 7.4, 0.5), signCF * CFrame.new(sx * 5.4, 3.7, 0.3), C.Wood, M.Wood, "prop")
	end
	part(model, "SignRoof", Vector3.new(12.4, 0.4, 1.6), signCF * CFrame.new(0, 7.6, 0.3), Color3.fromRGB(150, 116, 206), M.Slate, "deco")
	local board = part(model, "SignBoard", Vector3.new(11, 4.8, 0.4), signCF * CFrame.new(0, 4.8, 0), C.White, M.SmoothPlastic, "prop")
	part(model, "SignPlanter", Vector3.new(10, 0.9, 1.4), signCF * CFrame.new(0, 0.45, 0.2), C.Wood, M.WoodPlanks, "deco")
	part(model, "SignFlowers", Vector3.new(9.4, 0.8, 1), signCF * CFrame.new(0, 1.2, 0.2), TownKit.FLOWERS[index % #TownKit.FLOWERS + 1], M.Grass, "deco")
	local _, body = TownKit.Surface(board, Enum.NormalId.Front, 36, C.White, 400, 0.2)
	TownKit.Gradient(body, Color3.fromRGB(255, 244, 250), Color3.fromRGB(255, 214, 236), 90)
	TownKit.Stroke(body, Color3.fromRGB(255, 170, 210), 4)
	local title = signLabel(body, "Title", "✨ Free plot", 0.06, 0.34, C.HotPink, Enum.Font.FredokaOne)
	local subtitle = signLabel(body, "Subtitle", "", 0.42, 0.22, C.Plum, Enum.Font.GothamBold)
	local stats = signLabel(body, "Stats", "", 0.68, 0.26, C.Ink, Enum.Font.GothamBold)
	model.PrimaryPart = base
	return {
		Index = index,
		Model = model,
		CFrame = plotCF,
		HouseCFrame = houseCF,
		Title = title,
		Subtitle = subtitle,
		Stats = stats,
		Board = board,
	}
end

----------------------------------------------------------------------
-- Grand écran + plan : suivent les panneaux des parcelles
----------------------------------------------------------------------

local MEDALS = { "🥇", "🥈", "🥉", "4.", "5." }

local function refreshBoards()
	refreshPending = false
	local current = boards
	if not current then
		return
	end
	local owned = {}
	for _, plot in ipairs(current.Plots) do
		local ownerId = plot.Model:GetAttribute("OwnerId")
		local name = plot.Model:GetAttribute("OwnerName")
		local owner = type(ownerId) == "number" and ownerId ~= 0 and type(name) == "string" and name ~= ""
		-- plan : pastille + légende
		local label = current.Map and current.Map.Labels[plot.Index]
		if label then
			label.Text = plot.Index .. ". " .. (owner and ("🏠 " .. name) or "✨ Free plot")
		end
		local marker = current.Map and current.Map.Markers[plot.Index]
		if marker then
			marker.BackgroundColor3 = owner and C.HotPink or Color3.fromRGB(150, 150, 170)
		end
		if owner then
			local likes = plot.Model:GetAttribute("Likes")
			table.insert(owned, { Name = name, Likes = type(likes) == "number" and likes or 0, Stats = plot.Stats.Text })
		end
	end
	table.sort(owned, function(a, b)
		if a.Likes ~= b.Likes then
			return a.Likes > b.Likes
		end
		return a.Name < b.Name
	end)
	local screen = current.Screen
	if screen then
		for i, row in ipairs(screen.Rows) do
			local entry = owned[i]
			if entry then
				row.Text = MEDALS[i] .. "  " .. entry.Name .. "     " .. entry.Stats
			elseif i == 1 then
				row.Text = "⏳ …"
			else
				row.Text = ""
			end
		end
	end
end

local function scheduleRefresh()
	if refreshPending then
		return
	end
	refreshPending = true
	-- (WorldService pose les attributs juste après SetPlotSign : on attend un peu)
	task.delay(0.1, function()
		local ok, err = pcall(refreshBoards)
		if not ok then
			refreshPending = false
			warn("[TownMap] écran / plan : " .. tostring(err))
		end
	end)
end

----------------------------------------------------------------------
-- Construction
----------------------------------------------------------------------

-- Point d'apparition à l'entrée (utilisable avant Build : nombre de parcelles par défaut)
function TownMap.SpawnCFrame(): CFrame
	return WorldLayout.EntranceCFrame(builtCount or WorldLayout.PlotCount(Players.MaxPlayers))
end

function TownMap.Build(plotCount: number): Town
	local old = workspace:FindFirstChild(TownMap.FOLDER_NAME)
	if old then
		old:Destroy()
	end
	TownKit.Reset()
	builtCount = plotCount
	local geo = TownKit.Geo(plotCount)
	local folder = Instance.new("Folder")
	folder.Name = TownMap.FOLDER_NAME

	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	decor.Parent = folder
	local plotsFolder = Instance.new("Folder")
	plotsFolder.Name = "Plots"
	plotsFolder.Parent = folder
	local seats = Instance.new("Folder")
	seats.Name = "Seats"
	seats.Parent = folder
	-- (v9.6) boutiques où l'on entre (coques ; intérieurs : client ShopInteriors)
	local shops = Instance.new("Folder")
	shops.Name = "Shops"
	shops.Parent = folder

	-- (ordre = priorité des 16 vraies lumières : place, entrée, avenue)
	local plaza = TownPlaza.Build(decor, geo, shops)
	local entrance = TownEntrance.Build(decor, geo)
	-- 🚗 concession auto : hors de la porte, à gauche de la route d'arrivée (WorldLayout.DealershipCFrame) (avant la nature :
	-- sa place est réservée)
	TownShops.BuildDealership(shops, geo)
	-- (v9.7, BUILDINGS97) 🛒 supermarché MégaDopa + parking, hors de la porte
	-- (coque ; intérieur : client MarketInterior) ; dossier Market
	local market = Instance.new("Folder")
	market.Name = "Market"
	market.Parent = folder
	local okMarket, errMarket = pcall(TownMarket.Build, market, geo)
	if not okMarket then
		warn("[TownMap] supermarché : " .. tostring(errMarket))
	end
	-- (v9.8, FAIR98) 🎡 fête foraine derrière la mairie + 🍦 coin gourmand près
	-- de l'arrivée : AVANT les rues et la nature (leur place est réservée)
	local okFair, errFair = pcall(TownFair.Build, decor, geo)
	if not okFair then
		warn("[TownMap] fête foraine : " .. tostring(errFair))
	end
	local okCorner, errCorner = pcall(TownFair.BuildFoodCorner, decor, geo)
	if not okCorner then
		warn("[TownMap] coin gourmand : " .. tostring(errCorner))
	end
	TownStreets.Build(decor, geo)
	-- (v10, LAYOUT10) la grande ville : avenues, ceinture, rues des quartiers,
	-- autoroute, bretelles, ponts, plateau de la colline des manoirs
	local okNet, errNet = pcall(TownNetwork.Build, decor, geo)
	if not okNet then
		warn("[TownMap] réseau routier : " .. tostring(errNet))
	end
	TownNature.Build(decor, geo)
	-- (v9.7) aucun arbre du bois planté sur le parking / dans le magasin
	pcall(TownMarket.ClearSite, decor, plotCount)
	pcall(TownShops.ClearDealerSite, decor, plotCount) -- (v9.8, CARS98) pas d'arbres sur la concession

	local plots: { PlotInfo } = {}
	for index = 1, plotCount do
		plots[index] = buildPlot(plotsFolder, index, plotCount)
	end

	local spawnCF = WorldLayout.EntranceCFrame(plotCount)
	-- (les clients recalculent les parcelles avec WorldLayout : même nombre)
	folder:SetAttribute("PlotCount", plotCount)
	folder:SetAttribute("EntranceCF", spawnCF)
	folder:SetAttribute("PlazaCF", WorldLayout.PlazaCFrame())
	folder:SetAttribute("GateCF", WorldLayout.GateCFrame(plotCount))
	folder:SetAttribute("TownRadius", WorldLayout.TownRadius(plotCount))
	folder:SetAttribute("CityVersion", 10) -- (v10, LAYOUT10) grande ville : quartiers, autoroute
	folder:SetAttribute("HighwayR", WorldLayout.HighwayR(plotCount))
	folder:SetAttribute("BeltR", WorldLayout.BeltR(plotCount))
	folder:SetAttribute("Parts", TownKit.Stats.Parts)
	folder:SetAttribute("Lights", TownKit.Stats.Lights)
	folder:SetAttribute("Shops", #shops:GetChildren())
	-- (v9.9, NPC99) places des bancs occupées par des passants : le joueur s'assoit à côté
	local okSeatGuard, NPCSeatGuard = pcall(require, script.Parent.NPCSeatGuard)
	if okSeatGuard then
		pcall(NPCSeatGuard.Apply, folder)
	end
	folder.Parent = workspace

	boards = { Plots = plots, Screen = plaza.Screen, Map = entrance.Map }
	refreshBoards()
	return {
		Folder = folder,
		Plots = plots,
		Spawn = entrance.Spawn,
		PlazaCFrame = spawnCF,
		Seats = seats,
	}
end

-- Panneau d'une parcelle (textes déjà neutres : noms, chiffres, emoji)
function TownMap.SetPlotSign(plot: PlotInfo, title: string, subtitle: string, stats: string)
	plot.Title.Text = title
	plot.Subtitle.Text = subtitle
	plot.Stats.Text = stats
	scheduleRefresh()
end

return TownMap
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="389">
          <Properties>
            <string name="Name">TownMarket</string>
            <string name="Source"><![CDATA[--[[
	TownMarket (ModuleScript)
	Emplacement : ServerScriptService > Services > World > TownMarket

	🛒 Dopamine Town : le SUPERMARCHÉ « MégaDopa », hors de la porte de la
	ville, à droite de la route d'arrivée (en venant de la ville), l'entrée
	face au rond-point. Le serveur ne pose que la COQUE (collisions justes
	pour tout le monde) et le gros du parking ; l'intérieur (rayons,
	produits, vrais objets de la maison, caisses, café, aire de restauration,
	boutique Robux, personnages, lumières), les marquages du parking, les
	voitures garées et le CONTENU des écrans de classement sont construits
	par chaque client, en flux (Client/World/MarketInterior).

	v9.7 (BUILDINGS97) : 70 x 48. v9.8 (MARKET98) : 10x mieux et PLUS GRAND
	(WorldLayout.MARKET_W x MARKET_D = 104 x 68, sous toit à 18) :
	  - façade : grand ATRIUM vitré (mur-rideau à meneaux) dans une tour
	    rose qui porte l'enseigne, sas à portes coulissantes sous une
	    marquise sur deux colonnes, DEUX GRANDS ÉCRANS DE CLASSEMENT
	    (🏆 Dopamine / ♻️ Renaissances : cadres "LeaderScreen", le client y
	    affiche le top en direct), vitrines d'angle, enseignes des rayons
	    (Épicerie, Maison & Jardin, Café, Boutique Robux) ;
	  - toit : 3 lanterneaux sur toute la largeur, groupes de ventilation ;
	  - côtés finis (pilastres, bandeau, fenêtres hautes, sorties de
	    secours, descentes d'eau, logo) ; arrière : 3 quais de livraison ;
	  - PARKING : enrobé, allée d'accès depuis le rond-point, voie le long
	    de la route, îlots plantés, lampadaires, totem de l'enseigne près du
	    rond-point, trottoir et bornes devant l'entrée.
	Aucune vraie lumière ici ; aucune grande surface en Neon ; budget ~210
	pièces (v9.7 : ~200).

	Contrat (client MarketInterior) : Model "Supermarket" dans
	DopamineTown.Market, attributs
	  MarketCF     CFrame : pied de la façade (milieu), LookVector vers la route
	  InteriorCF   CFrame : centre du SOL intérieur (dessus), mêmes axes
	  InteriorSize Vector3 (largeur, hauteur sous toit, profondeur)
	  DoorCF       CFrame : seuil du sas (sol), LookVector vers le parking
	  LotCF        CFrame : centre du parking (dessus de l'enrobé)
	  LotSize      Vector3 (largeur, 0, profondeur)
	  StallsA / StallsB  nombre de places par rangée
	  Version      98
	Vantaux vitrés "DoorPanel" (attribut SlideX), jamais bloquants.
	Écrans "LeaderScreen" (attribut Board = "Dopamine" | "Rebirths" ; face
	avant = -Z de la pièce, vers le parking).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WorldLayout = require(ReplicatedStorage.Shared.WorldLayout)
local TownKit = require(script.Parent.TownKit)

local TownMarket = {}

local M = TownKit.M
local C = TownKit.C
local part = TownKit.Part

TownMarket.NAME = "MegaDopa" -- (clé anglaise ; en français : "MégaDopa")
TownMarket.VERSION = 98

local W = WorldLayout.MARKET_W -- 104
local D = WorldLayout.MARKET_D -- 68
local T = 1 -- épaisseur des murs
local ROOF = 18 -- dessous du toit
local TOP = 21 -- haut des murs (acrotère)
local FLOOR = 0.2 -- dessus du sol intérieur
local ATRIUM = 17 -- demi-largeur de l'atrium vitré
local ATRIUM_H = 17 -- haut du mur-rideau
local PIER = 4 -- largeur des piliers de la tour
local DOOR_W = 14 -- baie du sas
local DOOR_H = 10
local LOT_Y = -0.5 -- dessus de l'enrobé (niveau de la route)
local LOT_Z0, LOT_Z1 = -52, -10 -- parking (z local)
TownMarket.ROOF = ROOF
TownMarket.FLOOR = FLOOR
TownMarket.LOT_Z0 = LOT_Z0
TownMarket.LOT_Z1 = LOT_Z1
TownMarket.ATRIUM = ATRIUM

TownMarket.BRAND = Color3.fromRGB(236, 72, 140)
TownMarket.BRAND2 = Color3.fromRGB(120, 90, 200)
local BRAND = TownMarket.BRAND
local BRAND2 = TownMarket.BRAND2
local FACADE = Color3.fromRGB(236, 228, 214)
local FACADE2 = Color3.fromRGB(214, 206, 194)
local GLASS = Color3.fromRGB(150, 196, 226)
local FRAME = Color3.fromRGB(176, 180, 190)
local YELLOW = Color3.fromRGB(255, 208, 72)
local SCREEN = Color3.fromRGB(24, 20, 40)

-- Boîte entre deux coins (repère `cf`)
local function box(parent: Instance, name: string, cf: CFrame, x0: number, x1: number, y0: number, y1: number, z0: number, z1: number, color: Color3, material: Enum.Material, profile: string?): BasePart
	return part(parent, name, Vector3.new(math.abs(x1 - x0), math.abs(y1 - y0), math.abs(z1 - z0)), cf * CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2), color, material, profile)
end

local function glassBox(parent: Instance, name: string, cf: CFrame, x0: number, x1: number, y0: number, y1: number, z0: number, z1: number, transparency: number, profile: string?): BasePart
	local g = box(parent, name, cf, x0, x1, y0, y1, z0, z1, GLASS, M.Glass, profile or "prop")
	g.Transparency = transparency
	g.Reflectance = 0.15
	return g
end

-- Panneau texte (SurfaceGui) traduisible (attribut "LocText" : le client traduit)
local function sign(parent: Instance, name: string, cf: CFrame, x0: number, x1: number, y0: number, y1: number, z0: number, z1: number, color: Color3, text: string, textColor: Color3, pps: number, maxDistance: number, face: Enum.NormalId?): BasePart
	local board = box(parent, name, cf, x0, x1, y0, y1, z0, z1, color, M.SmoothPlastic, "deco")
	local _, body = TownKit.Surface(board, face or Enum.NormalId.Front, pps, nil, maxDistance, 0.4)
	local label = TownKit.Label(body, "Text", text, 0.04, 0.08, 0.92, 0.84, textColor, Enum.Font.FredokaOne, true)
	local stroke = Instance.new("UIStroke")
	stroke.Color = C.White
	stroke.Thickness = 2
	stroke.Parent = label
	return board
end

----------------------------------------------------------------------
-- Bâtiment
----------------------------------------------------------------------

local function building(model: Model, cf: CFrame)
	local hw = W / 2
	-- dalle du sol (sous les murs)
	box(model, "Floor", cf, -hw, hw, -1.3, FLOOR, 0, D, Color3.fromRGB(226, 222, 216), M.Concrete, "solid")
	-- façade : murs pleins de part et d'autre de la tour (l'atrium est vitré)
	for _, sx in ipairs({ -1, 1 }) do
		local a, b = sx < 0 and -hw or ATRIUM + PIER, sx < 0 and -ATRIUM - PIER or hw
		box(model, "FrontWall", cf, a, b, FLOOR, TOP, 0, T, FACADE, M.Concrete, "solid")
	end
	box(model, "BackWall", cf, -hw, hw, FLOOR, TOP, D - T, D, FACADE2, M.Concrete, "solid")
	for _, sx in ipairs({ -1, 1 }) do
		box(model, "SideWall", cf, sx < 0 and -hw or hw - T, sx < 0 and -hw + T or hw, FLOOR, TOP, T, D - T, FACADE2, M.Concrete, "solid")
	end
	-- toit : bandes pleines + 3 lanterneaux sur toute la largeur utile
	local roofColor = Color3.fromRGB(196, 196, 204)
	local sky = { math.floor(D * 0.25), math.floor(D * 0.5), math.floor(D * 0.75) }
	local skyHalf = hw - 10
	local z = T
	for _, zc in ipairs(sky) do
		box(model, "Roof", cf, -hw + T, hw - T, ROOF, ROOF + 1, z, zc - 1.5, roofColor, M.Concrete, "solid")
		for _, sx in ipairs({ -1, 1 }) do
			box(model, "Roof", cf, sx < 0 and -hw + T or skyHalf, sx < 0 and -skyHalf or hw - T, ROOF, ROOF + 1, zc - 1.5, zc + 1.5, roofColor, M.Concrete, "solid")
		end
		local sk = glassBox(model, "Skylight", cf, -skyHalf, skyHalf, ROOF + 0.2, ROOF + 0.8, zc - 1.5, zc + 1.5, 0.35, "prop")
		sk.CastShadow = false
		box(model, "SkylightCurb", cf, -skyHalf - 0.2, skyHalf + 0.2, ROOF + 1, ROOF + 1.5, zc - 1.7, zc - 1.5, FRAME, M.Metal, "deco")
		box(model, "SkylightCurb", cf, -skyHalf - 0.2, skyHalf + 0.2, ROOF + 1, ROOF + 1.5, zc + 1.5, zc + 1.7, FRAME, M.Metal, "deco")
		z = zc + 1.5
	end
	box(model, "Roof", cf, -hw + T, hw - T, ROOF, ROOF + 1, z, D - T, roofColor, M.Concrete, "solid")
	-- couvertines (haut des murs ; la façade s'arrête aux piliers de la tour)
	for _, sx in ipairs({ -1, 1 }) do
		local a, b = sx < 0 and -hw - 0.2 or ATRIUM + PIER + 0.2, sx < 0 and -ATRIUM - PIER - 0.2 or hw + 0.2
		box(model, "Coping", cf, a, b, TOP, TOP + 0.35, -0.2, T + 0.1, C.White, M.Concrete, "deco")
	end
	box(model, "Coping", cf, -hw - 0.2, hw + 0.2, TOP, TOP + 0.35, D - T - 0.1, D + 0.2, C.White, M.Concrete, "deco")
	for _, sx in ipairs({ -1, 1 }) do
		box(model, "Coping", cf, sx < 0 and -hw - 0.2 or hw - T - 0.1, sx < 0 and -hw + T + 0.1 or hw + 0.2, TOP, TOP + 0.35, T + 0.1, D - T - 0.1, C.White, M.Concrete, "deco")
	end
	-- groupes de ventilation sur le toit (entre les lanterneaux)
	for i, spot in ipairs({ { -30, D * 0.38 }, { 8, D * 0.62 }, { 32, D * 0.38 }, { -12, D * 0.88 } }) do
		local x, zc = spot[1], spot[2]
		box(model, "HVAC", cf, x - 3, x + 3, ROOF + 1, ROOF + 3.6, zc - 2.2, zc + 2.2, Color3.fromRGB(206, 208, 214), M.DiamondPlate, "deco")
		local fan = part(model, "HVACFan", Vector3.new(0.3, 2.8, 2.8), cf * CFrame.new(x + (i % 2 == 0 and 1.3 or -1.3), ROOF + 3.75, zc) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(120, 124, 136), M.Metal, "deco")
		;(fan :: Part).Shape = Enum.PartType.Cylinder
	end
end

-- Tour d'entrée + atrium vitré + sas + marquise
local function entrance(model: Model, cf: CFrame)
	local ax = ATRIUM
	-- piliers de la tour (pleins : ils portent l'enseigne) + haut de la tour
	for _, sx in ipairs({ -1, 1 }) do
		box(model, "TowerPier", cf, sx < 0 and -ax - PIER or ax, sx < 0 and -ax or ax + PIER, 0, 27, -1.6, T, BRAND, M.Concrete, "solid")
	end
	box(model, "TowerTop", cf, -ax, ax, ATRIUM_H, 27, -1.6, T, BRAND, M.Concrete, "solid")
	box(model, "TowerCap", cf, -ax - PIER - 0.4, ax + PIER + 0.4, 27, 27.7, -2, T + 0.4, C.White, M.Concrete, "deco")
	sign(model, "BigSign", cf, -15, 15, 19.6, 26.2, -1.75, -1.6, C.White, "🧠 MegaDopa", BRAND, 18, 900)
	local tag = sign(model, "Tagline", cf, -13, 13, 17.4, 19.3, -1.75, -1.6, BRAND2, "Everything for your home!", C.White, 30, 300)
	tag.Color = BRAND2
	-- mur-rideau de l'atrium (deux pans de part et d'autre du sas + imposte)
	local dx = DOOR_W / 2
	for _, sx in ipairs({ -1, 1 }) do
		local a, b = sx < 0 and -ax or dx + 0.3, sx < 0 and -dx - 0.3 or ax
		local g = glassBox(model, "Atrium", cf, a, b, FLOOR, ATRIUM_H, 0.3, 0.6, 0.45, "solid")
		g.Color = Color3.fromRGB(120, 160, 196)
		-- meneaux (4 par pan) + traverse
		for i = 0, 3 do
			local x = a + (i + 0.5) * (b - a) / 4
			box(model, "Mullion", cf, x - 0.15, x + 0.15, FLOOR, ATRIUM_H, 0.05, 0.3, FRAME, M.Metal, "deco")
		end
		box(model, "Transom", cf, a, b, 10.2, 10.6, 0.02, 0.3, FRAME, M.Metal, "deco")
	end
	glassBox(model, "AtriumHead", cf, -dx - 0.3, dx + 0.3, DOOR_H + 0.4, ATRIUM_H, 0.3, 0.6, 0.45, "prop").Color = Color3.fromRGB(120, 160, 196)
	box(model, "DoorHeader", cf, -dx - 0.3, dx + 0.3, DOOR_H, DOOR_H + 0.4, 0, T, FRAME, M.Metal, "solid")
	-- sas vitré (auvent au-dessus, portes coulissantes devant)
	local vz = -6
	for _, sx in ipairs({ -1, 1 }) do
		glassBox(model, "VestibuleSide", cf, sx < 0 and -dx or dx - 0.3, sx < 0 and -dx + 0.3 or dx, FLOOR, DOOR_H + 0.2, vz, 0, 0.4, "prop")
		-- vitres fixes de part et d'autre des portes
		glassBox(model, "VestibuleLite", cf, sx < 0 and -dx + 0.3 or 3.9, sx < 0 and -3.9 or dx - 0.3, FLOOR, 8.2, vz, vz + 0.3, 0.4, "prop")
		box(model, "VestibulePost", cf, sx < 0 and -3.9 or 3.7, sx < 0 and -3.7 or 3.9, FLOOR, 8.4, vz - 0.1, vz + 0.4, FRAME, M.Metal, "deco")
	end
	box(model, "VestibuleFloor", cf, -dx, dx, -1.3, FLOOR, vz, 0, Color3.fromRGB(206, 200, 196), M.Concrete, "solid")
	box(model, "VestibuleHeader", cf, -dx + 0.3, dx - 0.3, 8.2, DOOR_H + 0.2, vz - 0.05, vz + 0.35, FRAME, M.Metal, "deco")
	box(model, "VestibuleRoof", cf, -dx, dx, DOOR_H + 0.2, DOOR_H + 0.5, vz, 0, C.White, M.Concrete, "deco")
	sign(model, "Welcome", cf, -4.5, 4.5, 8.5, 9.9, vz - 0.13, vz - 0.05, C.White, "Welcome! Open every day", BRAND, 40, 140)
	-- marquise sur deux colonnes (au-dessus du trottoir)
	box(model, "Canopy", cf, -12.5, 12.5, 11.2, 11.9, -11, -1.6, C.White, M.Concrete, "decoS")
	box(model, "CanopyEdge", cf, -12.6, 12.6, 11.2, 11.9, -11.15, -11, BRAND, M.SmoothPlastic, "deco")
	for _, sx in ipairs({ -1, 1 }) do
		TownKit.Column(model, "CanopyColumn", (cf * CFrame.new(sx * 11.4, 0, -10)).Position, 11.2, 0.8, FRAME, M.Metal, "prop")
	end
	-- deux vantaux vitrés coulissants (le client les ouvre ; jamais bloquants)
	for _, sx in ipairs({ -1, 1 }) do
		local panel = box(model, "DoorPanel", cf, sx < 0 and -3.7 or 0.02, sx < 0 and -0.02 or 3.7, FLOOR, 8.2, vz + 0.35, vz + 0.5, GLASS, M.Glass, "deco")
		panel.Transparency = 0.4
		panel.Reflectance = 0.15
		panel:SetAttribute("SlideX", sx * 3.2)
	end
	-- bornes devant le sas (pas de voiture dans l'entrée)
	for _, x in ipairs({ -8.5, -4.5, 4.5, 8.5 }) do
		TownKit.Column(model, "Bollard", (cf * CFrame.new(x, 0, -8.6)).Position, 2.6, 0.7, YELLOW, M.Metal, "prop")
	end
end

-- Façade : bandeau, ÉCRANS DE CLASSEMENT, vitrines d'angle, enseignes
local function facade(model: Model, cf: CFrame)
	local hw = W / 2
	local x0 = ATRIUM + PIER
	-- bandeau aux couleurs de l'enseigne (sur la façade, hors tour)
	for _, sx in ipairs({ -1, 1 }) do
		local a, b = sx < 0 and -hw - 0.1 or x0, sx < 0 and -x0 or hw + 0.1
		box(model, "BrandBand", cf, a, b, 17.6, TOP - 0.05, -0.35, 0, BRAND2, M.SmoothPlastic, "deco")
		box(model, "BrandStripe", cf, a, b, 16.9, 17.6, -0.35, 0, YELLOW, M.SmoothPlastic, "deco")
	end
	-- deux grands écrans de classement (contenu : client MarketInterior)
	for _, spec in ipairs({ { 1, "Dopamine" }, { -1, "Rebirths" } }) do
		local sx = spec[1] :: number
		local cx = sx * (x0 + 9.5)
		box(model, "ScreenBezel", cf, cx - 8, cx + 8, 5.4, 15.8, -0.7, 0, Color3.fromRGB(40, 38, 52), M.Metal, "deco")
		local screen = box(model, "LeaderScreen", cf, cx - 7.5, cx + 7.5, 5.9, 15.3, -0.78, -0.7, SCREEN, M.SmoothPlastic, "deco")
		screen:SetAttribute("Board", spec[2])
		box(model, "ScreenFoot", cf, cx - 5, cx + 5, 4.9, 5.4, -1.1, 0, FRAME, M.Metal, "deco")
		box(model, "ScreenCap", cf, cx - 8.3, cx + 8.3, 15.8, 16.3, -1.1, 0, BRAND, M.SmoothPlastic, "deco")
	end
	-- vitrines d'angle (menuiseries, allège)
	for _, sx in ipairs({ -1, 1 }) do
		local a, b = sx < 0 and -hw + 2.5 or x0 + 20, sx < 0 and -x0 - 20 or hw - 2.5
		box(model, "Storefront", cf, a - 0.4, b + 0.4, 0, 1.6, -0.5, 0, FACADE2, M.Concrete, "prop")
		local g = glassBox(model, "ShopWindow", cf, a, b, 1.6, 12.4, -0.26, -0.08, 0.1, "deco")
		g.Color = Color3.fromRGB(96, 124, 150)
		box(model, "WindowHead", cf, a - 0.4, b + 0.4, 12.4, 12.9, -0.5, 0, C.White, M.Concrete, "deco")
		for i = 0, 3 do
			local x = a + i * (b - a) / 3
			box(model, "WindowMullion", cf, x - 0.15, x + 0.15, 1.6, 12.4, -0.42, -0.26, FRAME, M.Metal, "deco")
		end
	end
	-- enseignes de rayons sur la façade (au-dessus des vitrines)
	sign(model, "SubSign", cf, x0 + 20, hw - 2.5, 13.3, 16.3, -0.55, -0.35, C.White, "🏠 Home & Garden", BRAND2, 26, 300)
	sign(model, "SubSign", cf, -hw + 2.5, -x0 - 20, 13.3, 16.3, -0.55, -0.35, C.White, "💎 Robux Shop & ☕ Café", BRAND2, 26, 300)
	-- trottoir devant le magasin (+ bordure)
	box(model, "Apron", cf, -hw - 1, hw + 1, -1.3, 0, LOT_Z1 + 0.4, 0, C.Walk, M.Pavement, "solid")
	box(model, "Curb", cf, -hw - 1, hw + 1, -1.3, 0, LOT_Z1, LOT_Z1 + 0.4, C.Curb, M.Concrete, "solid")
end

-- Côtés et arrière (jamais de mur nu)
local function sides(model: Model, cf: CFrame)
	local hw = W / 2
	for _, sx in ipairs({ -1, 1 }) do
		-- repère de la face latérale : x le long du mur (profondeur), -Z vers dehors
		local R = cf * CFrame.new(sx * hw, 0, D / 2) * CFrame.Angles(0, sx * -math.pi / 2, 0)
		box(model, "SideBand", R, -D / 2 - 0.1, D / 2 + 0.1, 17.6, TOP - 0.05, -0.35, 0, BRAND2, M.SmoothPlastic, "deco")
		box(model, "SideStripe", R, -D / 2 - 0.1, D / 2 + 0.1, 16.9, 17.6, -0.35, 0, YELLOW, M.SmoothPlastic, "deco")
		for i = 0, 4 do
			local x = -D / 2 + 4 + i * (D - 8) / 4
			box(model, "Pilaster", R, x - 0.8, x + 0.8, -0.6, 16.9, -0.6, 0, FACADE, M.Concrete, "deco")
		end
		-- fenêtres hautes (entre les pilastres ; la 2e laisse la place à la sortie)
		for i = 0, 3 do
			local x = -D / 2 + 4 + (i + 0.5) * (D - 8) / 4
			if i ~= 1 then
				local g = glassBox(model, "HighWindow", R, x - 5, x + 5, 12, 15.4, -0.2, -0.05, 0.15, "deco")
				g.Color = Color3.fromRGB(110, 140, 170)
				box(model, "HighSill", R, x - 5.3, x + 5.3, 11.6, 12, -0.5, 0, C.White, M.Concrete, "deco")
			end
		end
		-- sortie de secours (porte, auvent, marche, panneau vert)
		local ex = -D / 2 + 4 + 1.5 * (D - 8) / 4
		box(model, "ExitFrame", R, ex - 2.1, ex + 2.1, 0, 8.3, -0.18, 0, FRAME, M.Metal, "deco")
		box(model, "ExitDoor", R, ex - 1.7, ex + 1.7, 0.2, 7.9, -0.3, -0.18, Color3.fromRGB(150, 156, 170), M.Metal, "deco")
		box(model, "ExitBar", R, ex - 1.4, ex + 1.4, 3.6, 3.9, -0.42, -0.3, Color3.fromRGB(220, 60, 70), M.Metal, "deco")
		box(model, "ExitCanopy", R, ex - 2.8, ex + 2.8, 8.6, 9, -2.4, 0, FRAME, M.Metal, "deco")
		box(model, "ExitSign", R, ex - 1, ex + 1, 8.4, 8.58, -0.8, -0.3, Color3.fromRGB(60, 180, 100), M.SmoothPlastic, "deco")
		box(model, "ExitStep", R, ex - 2.2, ex + 2.2, -1.3, 0.2, -2.2, 0, C.Walk, M.Concrete, "solid")
		-- descentes d'eau
		for _, x in ipairs({ -D / 2 + 1.2, D / 2 - 1.2 }) do
			TownKit.Column(model, "Downpipe", (R * CFrame.new(x, -0.4, -0.4)).Position, TOP - 0.2, 0.45, Color3.fromRGB(150, 154, 166), M.Metal, "deco")
		end
		-- logo peint (grand chariot) sur le côté
		sign(model, "SideLogo", R, 10, 26, 2, 10.4, -0.12, -0.04, BRAND, "🛒 MegaDopa", C.White, 12, 400)
	end
	-- arrière : quais de livraison
	local B = cf * CFrame.new(0, 0, D) * CFrame.Angles(0, math.pi, 0) -- -Z vers dehors (arrière)
	box(model, "DockPlatform", B, -10, 38, -1.3, 1.4, -4.5, 0, Color3.fromRGB(176, 172, 168), M.Concrete, "solid")
	for i, x in ipairs({ 0, 14, 28 }) do
		box(model, "DockFrame", B, x - 4.6, x + 4.6, 1.4, 11, -0.2, 0, Color3.fromRGB(150, 156, 170), M.Metal, "deco")
		box(model, "DockDoor", B, x - 4.1, x + 4.1, 1.4, 10.6, -0.32, -0.2, Color3.fromRGB(206, 210, 218), M.CorrodedMetal, "deco")
		for _, sx in ipairs({ -1, 1 }) do
			box(model, "Bumper", B, x + sx * 3.4 - 0.4, x + sx * 3.4 + 0.4, 1.6, 3.2, -4.9, -4.5, Color3.fromRGB(40, 40, 46), M.Rubber, "deco")
		end
		sign(model, "DockNumber", B, x - 1, x + 1, 11.4, 12.8, -0.12, -0.04, YELLOW, tostring(i), Color3.fromRGB(40, 40, 46), 30, 150)
	end
	box(model, "DockCanopy", B, -10.5, 38.5, 12.8, 13.3, -5.5, 0, FRAME, M.Metal, "decoS")
	sign(model, "DockSign", B, -34, -18, 10.6, 13.4, -0.12, -0.04, C.White, "🚚 Deliveries", BRAND2, 24, 200)
	box(model, "StaffDoor", B, -30, -26.8, 0.2, 7.6, -0.3, -0.05, Color3.fromRGB(150, 156, 170), M.Metal, "deco")
	box(model, "BackBand", B, -W / 2 - 0.1, W / 2 + 0.1, 17.6, TOP - 0.05, -0.35, 0, BRAND2, M.SmoothPlastic, "deco")
	for _, x in ipairs({ -W / 2 + 1.2, W / 2 - 1.2 }) do
		TownKit.Column(model, "Downpipe", (B * CFrame.new(x, -0.4, -0.4)).Position, TOP - 0.2, 0.45, Color3.fromRGB(150, 154, 166), M.Metal, "deco")
	end
end

----------------------------------------------------------------------
-- Parking (le gros oeuvre ; marquages, voitures, chariots : client)
----------------------------------------------------------------------

local function parking(model: Model, cf: CFrame, geo: TownKit.Geo): (number, number)
	local hw = W / 2 + 1
	local lot = box(model, "Lot", cf, -hw, hw, LOT_Y - 0.7, LOT_Y, LOT_Z0, LOT_Z1, C.AsphaltDark, M.Asphalt, "solid")
	lot.CastShadow = false
	-- allée d'accès depuis le rond-point (même niveau que la route ; un peu
	-- plus basse que l'anneau du rond-point : jamais de faces confondues)
	local roadCF = WorldLayout.GateCFrame(geo.Count)
	local loop = roadCF.Position + Vector3.new(0, 0, 66) -- centre du rond-point (TownEntrance : porte + 50 + 16)
	local rel = cf:PointToObjectSpace(Vector3.new(loop.X, cf.Position.Y, loop.Z))
	local drive = box(model, "Driveway", cf, rel.X - 6.5, rel.X + 6.5, LOT_Y - 0.72, LOT_Y - 0.04, rel.Z + 16, LOT_Z0 + 0.5, C.AsphaltDark, M.Asphalt, "solid")
	drive.CastShadow = false
	-- îlots plantés aux bouts des rangées
	local rows = { { -46, -35.5 }, { -28, -17.5 } }
	for _, sx in ipairs({ -1, 1 }) do
		for _, row in ipairs(rows) do
			local x0, x1 = sx < 0 and -hw + 0.3 or hw - 4.3, sx < 0 and -hw + 4.3 or hw - 0.3
			box(model, "Island", cf, x0, x1, LOT_Y - 0.1, LOT_Y + 0.5, row[1] + 0.5, row[2] - 0.5, C.Curb, M.Concrete, "prop")
			box(model, "IslandGrass", cf, x0 + 0.2, x1 - 0.2, LOT_Y + 0.5, LOT_Y + 0.55, row[1] + 0.7, row[2] - 0.7, C.Lawn, M.Grass, "deco")
		end
		-- lampadaire au bout de l'allée centrale (sur un petit socle)
		local lx, lz = sx * 30, -31.8
		box(model, "LightBase", cf, lx - 0.6, lx + 0.6, LOT_Y, LOT_Y + 1, lz - 0.6, lz + 0.6, C.Curb, M.Concrete, "prop")
		TownKit.Column(model, "LightPole", (cf * CFrame.new(lx, LOT_Y + 1, lz)).Position, 15, 0.5, C.Metal, M.Metal, "prop")
		box(model, "LightArm", cf, lx - 2.6, lx + 2.6, LOT_Y + 15.6, LOT_Y + 16, lz - 0.2, lz + 0.2, C.Metal, M.Metal, "deco")
		for _, dx in ipairs({ -2.4, 2.4 }) do
			local head = box(model, "LightHead", cf, lx + dx - 0.7, lx + dx + 0.7, LOT_Y + 15.2, LOT_Y + 15.6, lz - 0.6, lz + 0.6, C.Glow, M.SmoothPlastic, "deco")
			TownKit.Glow(head)
		end
	end
	-- totem de l'enseigne près du rond-point (vu en arrivant en ville)
	local totem = cf * CFrame.new(rel.X + 13, LOT_Y, LOT_Z0 - 3) * CFrame.Angles(0, math.rad(-45), 0)
	box(model, "PylonBase", totem, -3.4, 3.4, -1.2, 1.4, -1.4, 1.4, C.StoneDark, M.Granite, "prop")
	for _, x in ipairs({ -2, 2 }) do
		box(model, "PylonLeg", totem, x - 0.4, x + 0.4, 1.4, 14, -0.4, 0.4, C.MetalLight, M.Metal, "prop")
	end
	local panel = box(model, "PylonSign", totem, -4.4, 4.4, 14, 22.6, -0.8, 0.8, BRAND, M.SmoothPlastic, "deco")
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local _, body = TownKit.Surface(panel, face, 18, nil, 500, 0.4)
		TownKit.Gradient(body, BRAND, BRAND2, 90)
		body.BackgroundTransparency = 0
		TownKit.Label(body, "Brand", "🧠 MegaDopa", 0.05, 0.08, 0.9, 0.52, C.White, Enum.Font.FredokaOne, true)
		TownKit.Label(body, "Hours", "🛒 Open every day", 0.08, 0.64, 0.84, 0.26, Color3.fromRGB(255, 236, 150), Enum.Font.GothamBold, true)
	end
	box(model, "PylonCap", totem, -4.7, 4.7, 22.6, 23.1, -1, 1, C.White, M.Concrete, "deco")
	-- arbres des îlots du fond (pas trop près des voitures)
	for _, sx in ipairs({ -1, 1 }) do
		local row = rows[2]
		local p = (cf * CFrame.new(sx * (hw - 2.3), LOT_Y + 0.5, (row[1] + row[2]) / 2)).Position
		pcall(TownKit.Tree, model, p, 12, math.floor(p.X + p.Z), nil)
	end
	local stalls = 15 -- (places de 6,4 : marquages côté client)
	return stalls, stalls
end

----------------------------------------------------------------------
-- Construction
----------------------------------------------------------------------

function TownMarket.Build(folder: Instance, geo: TownKit.Geo): Model
	local cf = WorldLayout.MarketCFrame(geo.Count)
	local model = TownKit.Model(folder, "Supermarket")
	building(model, cf)
	entrance(model, cf)
	facade(model, cf)
	sides(model, cf)
	local nA, nB = parking(model, cf, geo)
	model:SetAttribute("MarketCF", cf)
	model:SetAttribute("InteriorCF", cf * CFrame.new(0, FLOOR, D / 2))
	model:SetAttribute("InteriorSize", Vector3.new(W - 2 * T, ROOF - FLOOR, D - 2 * T))
	model:SetAttribute("DoorCF", cf * CFrame.new(0, FLOOR, -6))
	model:SetAttribute("LotCF", cf * CFrame.new(0, LOT_Y, (LOT_Z0 + LOT_Z1) / 2))
	model:SetAttribute("LotSize", Vector3.new(W + 2, 0, LOT_Z1 - LOT_Z0))
	model:SetAttribute("StallsA", nA)
	model:SetAttribute("StallsB", nB)
	model:SetAttribute("Name", TownMarket.NAME)
	model:SetAttribute("Version", TownMarket.VERSION)
	-- (emprise réservée : aucun arbre ni objet semé dessus)
	geo.Reserve((cf * CFrame.new(0, 0, (LOT_Z0 + D) / 2)).Position, math.max(W, D - LOT_Z0) / 2 + 10)
	return model
end

-- Zone du magasin + parking (repère MarketCF) : pour écarter les arbres
-- semés dessus par d'autres modules (bois autour de la ville...)
function TownMarket.InZone(cf: CFrame, p: Vector3, margin: number): boolean
	local rel = cf:PointToObjectSpace(p)
	return math.abs(rel.X) < W / 2 + 2 + margin and rel.Z > LOT_Z0 - 6 - margin and rel.Z < D + 6 + margin
end

-- Filet de sécurité : retire les ARBRES (modèles "Tree*") d'autres modules
-- plantés sur l'emprise (appelé par TownMap après la nature) ; renvoie le
-- nombre de pièces retirées (budget)
function TownMarket.ClearSite(decor: Instance, count: number): number
	local cf = WorldLayout.MarketCFrame(count)
	local removed = 0
	for _, d in ipairs(decor:GetDescendants()) do
		if d:IsA("Model") and string.sub(d.Name, 1, 4) == "Tree" and d.Parent and not d:FindFirstAncestor("Supermarket") then
			local pivot = d:GetPivot().Position
			local first = d:FindFirstChildWhichIsA("BasePart", true)
			local p = first and first.Position or pivot
			if TownMarket.InZone(cf, Vector3.new(p.X, cf.Position.Y, p.Z), 4) then
				for _, x in ipairs(d:GetDescendants()) do
					if x:IsA("BasePart") then
						removed += 1
					end
				end
				d:Destroy()
			end
		end
	end
	TownKit.Stats.Parts -= removed
	return removed
end

return TownMarket
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="390">
          <Properties>
            <string name="Name">TownMusic</string>
            <string name="Source"><![CDATA[--[[
	TownMusic (ModuleScript)
	Emplacement : ServerScriptService > Services > World > TownMusic

	🎵 SCÈNE MUSICALE de la place de Dopamine Town (v9.9, MUSIC99), côté
	SERVEUR. Ici, SEULEMENT ce qui doit être partagé :
	  - le plancher de la scène, ses 2 marches, les praticables (batterie,
	    DJ) et les volumes solides (tours du portique, enceintes, pupitre) ;
	  - une invite "Jouer" (touche E) par instrument : 🎹 piano à queue,
	    🥁 batterie, 🎸 guitare électrique, 🎸 basse, 🎶 xylophone,
	    🎛️ synthé, 🎧 platines DJ ; et au pied de la scène, le pupitre
	    "musique" : E = choisir un morceau, F = radio lofi sur la scène ;
	  - QUI joue de quoi (attribut "Player" = UserId sur la borne de
	    l'instrument : chaque client anime l'avatar du musicien) ;
	  - le MORCEAU en cours (attributs du dossier : SongId, SongStart = heure
	    du serveur, SongMode "one" | "all") et la RADIO (Radio = numéro de la
	    piste de Config.Music.Playlist, RadioStart) : tous les clients jouent
	    la même chose au même moment, sans autre message ;
	  - le RELAIS des notes : un joueur joue -> ses notes (paquets de 24 au
	    plus) -> le serveur vérifie (c'est bien son instrument, il est à son
	    poste, pas de spam : seau de jetons) -> les joueurs à moins de
	    MusicData.HEAR_RADIUS studs les entendent et le voient jouer.
	Tout le DÉCOR (portique, projecteurs, écran LED, enceintes, instruments
	détaillés, câbles…) est construit par chaque client (Client/World/
	MusicStage), en flux. Budget : ~22 pièces serveur, 2 vraies lumières
	douces (projecteurs de face, la nuit seulement).

	Remote "MusicEvent" (RemoteEvent) :
	  C -> S ("leave")                          : quitter son instrument
	         ("notes", instIndex, { n, v, dt… }) : notes jouées (triplets)
	         ("song", songId | "", "one" | "all") : lancer / arrêter un morceau
	         ("radio", piste 0..N)               : radio lofi (0 = coupée)
	         ("loop", 0..4)                      : boucle du DJ (0 = coupée)
	  S -> C ("open", instId)  : tu joues de cet instrument (au joueur)
	         ("close", instId) : ton instrument est libéré
	         ("busy", instId)  : quelqu'un en joue déjà
	         ("picker")        : ouvre le choix des morceaux
	         ("notes", userId, instIndex, { n, v, dt… }) : notes d'un voisin

	API (TownPlaza, via un pcall) :
	  TownMusic.Build(parent, cf) -> Folder "MusicStage"
	    cf : centre de l'empreinte 24 x 16 au niveau du pavé, LookVector = le
	    devant de la scène (vers le public) ; attribut "StageCF" = cf.
	  TownMusic.Debug() -> état (tests)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MusicData = require(ReplicatedStorage.Shared.MusicData)
local Config = require(ReplicatedStorage.Shared.Config)
local TownKit = require(script.Parent.TownKit)

local TownMusic = {}

TownMusic.FOLDER_NAME = "MusicStage"

local M = TownKit.M
local part = TownKit.Part

local WATCH_EVERY = 0.5 -- (s) vérification des musiciens / fin du morceau
local STAGE_RANGE = 70 -- (studs) pour lancer un morceau / la radio
local SONG_LEAD = 0.8 -- (s) le morceau démarre un peu après la demande (tous en même temps)
local SONG_COOLDOWN = 1.2 -- (s) entre deux demandes d'un même joueur
-- seaux de jetons (anti-spam) : messages et notes par seconde
local MSG_RATE, MSG_BURST = 18, 24
local NOTE_RATE, NOTE_BURST = 40, 64

type Anchor = { Id: string, Part: BasePart, Prompt: ProximityPrompt }

local state = {
	Folder = nil :: Folder?,
	StageCF = CFrame.identity,
	Anchors = {} :: { [string]: Anchor },
	Occupant = {} :: { [Player]: string },
	Buckets = {} :: { [Player]: { Msg: number, Notes: number, At: number, SongAt: number } },
	Connections = {} :: { RBXScriptConnection },
	Generation = 0,
	Relayed = 0,
	Dropped = 0,
	Accepted = 0,
}
local remoteConnected = false
local watching = false

local function now(): number
	return workspace:GetServerTimeNow()
end

local function remote(): RemoteEvent?
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	local r = folder and folder:FindFirstChild("MusicEvent")
	return (r and r:IsA("RemoteEvent")) and r or nil
end

local function send(player: Player, ...: any)
	local r = remote()
	if r and player.Parent then
		r:FireClient(player, ...)
	end
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return (root and root:IsA("BasePart")) and root or nil
end

local function alive(player: Player): boolean
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0
end

local function nearStage(player: Player, range: number): boolean
	local root = rootOf(player)
	return root ~= nil and (root.Position - state.StageCF.Position).Magnitude <= range
end

----------------------------------------------------------------------
-- Occupation des instruments
----------------------------------------------------------------------

local function release(player: Player, notify: boolean)
	local id = state.Occupant[player]
	if not id then
		return
	end
	state.Occupant[player] = nil
	local anchor = state.Anchors[id]
	if anchor and anchor.Part.Parent then
		if anchor.Part:GetAttribute("Player") == player.UserId then
			anchor.Part:SetAttribute("Player", 0)
			anchor.Part:SetAttribute("Loop", 0)
		end
		anchor.Prompt.Enabled = true
	end
	if notify then
		send(player, "close", id)
	end
end

local function claim(player: Player, id: string)
	local anchor = state.Anchors[id]
	if not anchor or not anchor.Part.Parent or not alive(player) then
		return
	end
	local root = rootOf(player)
	if not root or (root.Position - anchor.Part.Position).Magnitude > MusicData.PLAY_RANGE + 4 then
		return
	end
	local current = anchor.Part:GetAttribute("Player")
	if type(current) == "number" and current ~= 0 and current ~= player.UserId then
		send(player, "busy", id)
		return
	end
	if state.Occupant[player] and state.Occupant[player] ~= id then
		release(player, false)
	end
	state.Occupant[player] = id
	anchor.Part:SetAttribute("Player", player.UserId)
	anchor.Part:SetAttribute("Since", now())
	anchor.Prompt.Enabled = false
	send(player, "open", id)
end

----------------------------------------------------------------------
-- Anti-spam (seau de jetons)
----------------------------------------------------------------------

local function bucket(player: Player): { Msg: number, Notes: number, At: number, SongAt: number }
	local b = state.Buckets[player]
	local t = now()
	if not b then
		b = { Msg = MSG_BURST, Notes = NOTE_BURST, At = t, SongAt = -math.huge }
		state.Buckets[player] = b
	end
	local dt = math.max(0, t - b.At)
	b.At = t
	b.Msg = math.min(MSG_BURST, b.Msg + dt * MSG_RATE)
	b.Notes = math.min(NOTE_BURST, b.Notes + dt * NOTE_RATE)
	return b
end

-- Notes reçues -> triplets propres (entiers, bornés) ; {} si rien de valable
local function cleanNotes(id: string, raw: any, allowance: number): { number }
	local out = {}
	if type(raw) ~= "table" then
		return out
	end
	local kind = MusicData.STATIONS[id].Kind
	local lo, hi = MusicData.NOTE_MIN, MusicData.NOTE_MAX
	if kind == "drums" then
		lo, hi = 1, #MusicData.DRUMS
	elseif kind == "dj" then
		lo, hi = MusicData.DJ_LOOPS + 1, #MusicData.DJ_PADS
	end
	local count = math.min(MusicData.MAX_BATCH, math.floor(#raw / 3), math.floor(allowance))
	for i = 1, count do
		local n, v, dt = raw[i * 3 - 2], raw[i * 3 - 1], raw[i * 3]
		if type(n) == "number" and type(v) == "number" and type(dt) == "number" and n == n and v == v and dt == dt then
			n = math.floor(n + 0.5)
			if n >= lo and n <= hi then
				table.insert(out, n)
				table.insert(out, math.clamp(math.floor(v + 0.5), 1, 100))
				table.insert(out, math.clamp(math.floor(dt + 0.5), 0, 400))
			end
		end
	end
	return out
end

local function relay(player: Player, instIndex: number, notes: { number })
	local r = remote()
	if not r or #notes == 0 then
		return
	end
	local center = state.StageCF.Position
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			local root = rootOf(other)
			if root and (root.Position - center).Magnitude <= MusicData.HEAR_RADIUS then
				r:FireClient(other, "notes", player.UserId, instIndex, notes)
				state.Relayed += 1
			end
		end
	end
end

----------------------------------------------------------------------
-- Morceaux et radio (attributs du dossier)
----------------------------------------------------------------------

local function setSong(id: string, mode: string)
	local folder = state.Folder
	if not folder then
		return
	end
	if id == "" or MusicData.SONG_INDEX[id] == nil then
		folder:SetAttribute("SongId", "")
		folder:SetAttribute("SongMode", "")
		return
	end
	folder:SetAttribute("Radio", 0)
	folder:SetAttribute("SongStart", now() + SONG_LEAD)
	folder:SetAttribute("SongMode", mode == "all" and "all" or "one")
	folder:SetAttribute("SongId", id)
end

local function playlistCount(): number
	local list = Config.Music and Config.Music.Playlist
	return type(list) == "table" and #list or 0
end

local function setRadio(index: number)
	local folder = state.Folder
	if not folder then
		return
	end
	if index < 1 or index > playlistCount() then
		folder:SetAttribute("Radio", 0)
		return
	end
	local track = Config.Music.Playlist[index]
	if type(track) ~= "table" or type(track.Id) ~= "string" or track.Id == "" then
		return
	end
	folder:SetAttribute("SongId", "")
	folder:SetAttribute("SongMode", "")
	folder:SetAttribute("RadioStart", now())
	folder:SetAttribute("Radio", index)
end

local function onEvent(player: Player, kind: any, a: any, b: any)
	if not state.Folder or type(kind) ~= "string" then
		return
	end
	local bk = bucket(player)
	if bk.Msg < 1 then
		state.Dropped += 1
		return
	end
	bk.Msg -= 1
	if kind == "leave" then
		release(player, true)
	elseif kind == "notes" then
		local id = state.Occupant[player]
		if not id or type(a) ~= "number" or MusicData.ORDER[a] ~= id then
			return
		end
		local anchor = state.Anchors[id]
		local root = rootOf(player)
		if not anchor or not root or (root.Position - anchor.Part.Position).Magnitude > MusicData.PLAY_RANGE + 6 then
			return
		end
		local notes = cleanNotes(id, b, bk.Notes)
		bk.Notes -= #notes / 3
		state.Accepted += #notes / 3
		if #notes > 0 then
			relay(player, a, notes)
		end
	elseif kind == "song" then
		if type(a) ~= "string" or not nearStage(player, STAGE_RANGE) then
			return
		end
		local t = now()
		-- (arrêter est toujours permis ; lancer : une demande par SONG_COOLDOWN)
		if a ~= "" and t - bk.SongAt < SONG_COOLDOWN then
			return
		end
		bk.SongAt = t
		setSong(a, type(b) == "string" and b or "one")
	elseif kind == "radio" then
		if type(a) ~= "number" or a ~= a or not nearStage(player, STAGE_RANGE) then
			return
		end
		local t = now()
		if a ~= 0 and t - bk.SongAt < SONG_COOLDOWN then
			return
		end
		bk.SongAt = t
		setRadio(math.floor(a))
	elseif kind == "loop" then
		if state.Occupant[player] ~= "DJ" or type(a) ~= "number" or a ~= a then
			return
		end
		local anchor = state.Anchors.DJ
		local index = math.floor(a)
		if anchor and index >= 0 and index <= MusicData.DJ_LOOPS then
			-- (calée sur une grille de mesures : tous les clients entendent la même boucle)
			local bar = MusicData.LOOP_BAR
			anchor.Part:SetAttribute("LoopStart", math.ceil((now() + 0.25) / bar) * bar)
			anchor.Part:SetAttribute("Loop", index)
		end
	end
end

----------------------------------------------------------------------
-- Surveillance : musiciens partis / trop loin, fin des morceaux
----------------------------------------------------------------------

local function watchStep()
	for player, id in pairs(state.Occupant) do
		local anchor = state.Anchors[id]
		local root = rootOf(player)
		local spot = MusicData.SpotCFrame(state.StageCF, id)
		local flat = root and Vector3.new(root.Position.X - spot.Position.X, 0, root.Position.Z - spot.Position.Z).Magnitude or math.huge
		if not player.Parent or not anchor or not alive(player) or flat > MusicData.LEAVE_RANGE then
			release(player, player.Parent ~= nil)
		end
	end
	local folder = state.Folder
	if folder and folder.Parent then
		local id = folder:GetAttribute("SongId")
		local start = folder:GetAttribute("SongStart")
		if type(id) == "string" and id ~= "" and type(start) == "number" then
			local duration = MusicData.Duration(id)
			if now() > start + duration + 0.6 then
				if folder:GetAttribute("SongMode") == "all" then
					local index = MusicData.SONG_INDEX[id] or 0
					local nextSong = MusicData.SONGS[index % #MusicData.SONGS + 1]
					folder:SetAttribute("SongStart", now() + 1.2)
					folder:SetAttribute("SongId", nextSong.Id)
				else
					folder:SetAttribute("SongId", "")
					folder:SetAttribute("SongMode", "")
				end
			end
		end
	end
end

local function startWatch()
	if watching then
		return
	end
	watching = true
	task.spawn(function()
		while watching do
			task.wait(WATCH_EVERY)
			local ok, err = pcall(watchStep)
			if not ok then
				warn("[TownMusic] surveillance : " .. tostring(err))
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		release(player, false)
		state.Buckets[player] = nil
	end)
end

local function connectRemote()
	if remoteConnected then
		return
	end
	local r = remote()
	if not r then
		warn("[TownMusic] remote MusicEvent absent (Net.luau)")
		return
	end
	remoteConnected = true
	r.OnServerEvent:Connect(function(player: Player, kind: any, a: any, b: any)
		local ok, err = pcall(onEvent, player, kind, a, b)
		if not ok then
			warn("[TownMusic] " .. tostring(err))
		end
	end)
end

----------------------------------------------------------------------
-- Construction
----------------------------------------------------------------------

local function prompt(host: BasePart, name: string, action: string, object: string, key: Enum.KeyCode, distance: number): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.Name = name
	p.ActionText = action
	p.ObjectText = object
	p.KeyboardKeyCode = key
	p.HoldDuration = 0
	p.MaxActivationDistance = distance
	p.RequiresLineOfSight = false
	p.Style = Enum.ProximityPromptStyle.Default
	-- (textes anglais ; MusicStage les traduit : attributs LocAction / LocObject)
	p:SetAttribute("LocAction", action)
	p:SetAttribute("LocObject", object)
	p.Parent = host
	return p
end

local function ghost(parent: Instance, name: string, size: Vector3, cf: CFrame): BasePart
	-- (volume solide invisible : le décor visible est construit par le client)
	return part(parent, name, size, cf, Color3.fromRGB(40, 40, 44), M.SmoothPlastic, "ghost")
end

function TownMusic.Build(parent: Instance, cf: CFrame): Folder
	local old = parent:FindFirstChild(TownMusic.FOLDER_NAME)
	if old then
		old:Destroy()
	end
	for _, c in ipairs(state.Connections) do
		c:Disconnect()
	end
	table.clear(state.Connections)
	for player in pairs(state.Occupant) do
		release(player, true)
	end
	state.Generation += 1
	state.StageCF = cf
	table.clear(state.Anchors)
	local partsBefore = TownKit.Stats.Parts

	local folder = Instance.new("Folder")
	folder.Name = TownMusic.FOLDER_NAME
	folder:SetAttribute("StageCF", cf)
	folder:SetAttribute("SongId", "")
	folder:SetAttribute("SongStart", 0)
	folder:SetAttribute("SongMode", "")
	folder:SetAttribute("Radio", 0)
	folder:SetAttribute("RadioStart", 0)

	local D = MusicData.DECK
	local top = MusicData.DECK_TOP
	local low = -0.3 -- (plancher enfoncé sous le pavé : aucune face commune avec lui)
	local deckColor = Color3.fromRGB(62, 52, 50)
	-- plancher (bois sombre, comme une vraie scène)
	part(folder, "Deck", Vector3.new(D.X1 - D.X0, top - low, D.Z1 - D.Z0), cf * CFrame.new((D.X0 + D.X1) / 2, (top + low) / 2, (D.Z0 + D.Z1) / 2), deckColor, M.WoodPlanks, "solid")
	-- 2 marches devant (0,5 chacune)
	local S = MusicData.STEPS
	for i = 1, S.Count do
		local stepTop = i * S.Rise
		local z1 = D.Z0 - (S.Count - i) * S.Depth
		local z0 = z1 - S.Depth
		part(folder, "Step", Vector3.new(S.X * 2, stepTop - low, z1 - z0), cf * CFrame.new(0, (stepTop + low) / 2, (z0 + z1) / 2), Color3.fromRGB(70, 60, 58), M.WoodPlanks, "solid")
	end
	-- praticables (batterie, DJ) : posés 0,05 DANS le plancher
	for name, r in pairs(MusicData.RISERS) do
		local h = r.H + 0.05
		part(folder, name .. "Riser", Vector3.new(r.X1 - r.X0, h, r.Z1 - r.Z0), cf * CFrame.new((r.X0 + r.X1) / 2, top - 0.05 + h / 2, (r.Z0 + r.Z1) / 2), Color3.fromRGB(46, 44, 50), M.Carpet, "solid")
	end
	-- volumes solides (invisibles) : tours du portique, enceintes, pupitre
	local ts = MusicData.TOWER_SIZE
	for i, p in ipairs(MusicData.TRUSS_TOWERS) do
		ghost(folder, "TowerBlock" .. i, Vector3.new(ts, MusicData.TRUSS_H, ts), cf * CFrame.new(p.X, MusicData.TRUSS_H / 2, p.Z))
	end
	for i, p in ipairs(MusicData.PA) do
		ghost(folder, "SpeakerBlock" .. i, Vector3.new(2.2, 4.6, 2.0), cf * CFrame.new(p.X, 2.3, p.Z))
	end
	local jukeCF = cf * MusicData.JUKEBOX
	ghost(folder, "JukeboxBlock", Vector3.new(2.6, 3.3, 1.3), jukeCF * CFrame.new(0, 1.65, 0))

	-- bornes des instruments (invites "Jouer")
	for _, id in ipairs(MusicData.ORDER) do
		local st = MusicData.STATIONS[id]
		local host = part(folder, "Play_" .. id, Vector3.new(0.4, 0.4, 0.4), cf * CFrame.new(st.Prompt), Color3.new(1, 1, 1), M.SmoothPlastic, "deco")
		host.Transparency = 1
		host:SetAttribute("Instrument", id)
		host:SetAttribute("Player", 0)
		host:SetAttribute("Loop", 0)
		host:SetAttribute("LoopStart", 0)
		local p = prompt(host, "MusicPrompt", "Play", st.Name, Enum.KeyCode.E, 6.5)
		p:SetAttribute("Instrument", id)
		state.Anchors[id] = { Id = id, Part = host, Prompt = p }
		table.insert(state.Connections, p.Triggered:Connect(function(player: Player)
			local ok, err = pcall(claim, player, id)
			if not ok then
				warn("[TownMusic] jouer : " .. tostring(err))
			end
		end))
	end
	-- pupitre "musique" au pied de la scène : E = morceaux, F = radio lofi
	local juke = part(folder, "Jukebox", Vector3.new(0.4, 0.4, 0.4), jukeCF * CFrame.new(0, 3.6, -0.4), Color3.new(1, 1, 1), M.SmoothPlastic, "deco")
	juke.Transparency = 1
	local songPrompt = prompt(juke, "SongPrompt", "Play a song", "Stage music", Enum.KeyCode.E, 10)
	local radioPrompt = prompt(juke, "RadioPrompt", "Lo-fi radio", "Stage music", Enum.KeyCode.F, 10)
	table.insert(state.Connections, songPrompt.Triggered:Connect(function(player: Player)
		if nearStage(player, STAGE_RANGE) then
			send(player, "picker")
		end
	end))
	table.insert(state.Connections, radioPrompt.Triggered:Connect(function(player: Player)
		if not nearStage(player, STAGE_RANGE) then
			return
		end
		local bk = bucket(player)
		local t = now()
		if t - bk.SongAt < SONG_COOLDOWN then
			return
		end
		bk.SongAt = t
		local current = folder:GetAttribute("Radio")
		if type(current) == "number" and current > 0 then
			setRadio(0)
		else
			setRadio(math.random(1, math.max(1, playlistCount())))
		end
	end))
	-- 2 projecteurs de face, doux (la nuit seulement : TownAtmosphere)
	for _, x in ipairs({ -5, 5 }) do
		local host = part(folder, "StageLight", Vector3.new(0.4, 0.4, 0.4), cf * CFrame.new(x, MusicData.TRUSS_H - 0.6, -2.4) * CFrame.Angles(math.rad(-28), 0, 0), Color3.new(1, 1, 1), M.SmoothPlastic, "deco")
		host.Transparency = 1
		TownKit.Light(host, Color3.fromRGB(255, 226, 190), 20, 0.8, "Spot")
	end

	folder:SetAttribute("Parts", TownKit.Stats.Parts - partsBefore)
	folder.Parent = parent
	state.Folder = folder
	connectRemote()
	startWatch()
	return folder
end

function TownMusic.Debug(): any
	local occupants = {}
	for player, id in pairs(state.Occupant) do
		occupants[player.Name] = id
	end
	return {
		Folder = state.Folder,
		Anchors = state.Anchors,
		Occupants = occupants,
		Relayed = state.Relayed,
		Dropped = state.Dropped,
		Accepted = state.Accepted,
		Claim = claim,
		Release = release,
		OnEvent = onEvent,
		Watch = watchStep,
	}
end

return TownMusic
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="391">
          <Properties>
            <string name="Name">TownNature</string>
            <string name="Source"><![CDATA[--[[
	TownNature (ModuleScript)
	Emplacement : ServerScriptService > Services > World > TownNature

	🌳 Parcs et paysage de Dopamine Town (v9.4) :
	  - le pré (un grand disque d'herbe) et les murs invisibles du bord ;
	  - dans l'anneau entre la place et le boulevard, un quartier par secteur :
	      avant droit  : aire de jeux (toboggan, balançoires, tape-cul) +
	                     tables de pique-nique ;
	      arrière droit: LAC (rives de sable, eau transparente, nénuphars,
	                     roseaux, canards, ponton + barque, pont en bois) ;
	      arrière gauche : jardin fleuri sous pergola + terrain de basket ;
	      avant gauche : petit marché (étals rayés) + food truck ;
	    puis des arbres semés sans jamais toucher les rues ni les zones ;
	  - une ceinture de bois derrière les parcelles, des collines, des
	    montagnes enneigées et une ville lointaine (TownBuildings.Skyline).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WorldLayout = require(ReplicatedStorage.Shared.WorldLayout)
local TownKit = require(script.Parent.TownKit)
local TownBuildings = require(script.Parent.TownBuildings)
local TownVehicles = require(script.Parent.TownVehicles) -- (v9.7, VEHICLES97) food truck
local Greenery = require(ReplicatedStorage.Shared.Greenery) -- (v9.7, NATURE97) plan du lac

local TownNature = {}

local M = TownKit.M
local C = TownKit.C
local part = TownKit.Part
local hash = TownKit.Hash

local GROUND_Y = WorldLayout.GROUND_Y

----------------------------------------------------------------------
-- Lac (v9.7, NATURE97) : un vrai lac de parc
----------------------------------------------------------------------
-- Une seule nappe d'eau (disque transparent : pas de recouvrements qui
-- assombrissent l'eau), bord peu profond (sable visible sous l'eau), fond
-- plus sombre au milieu ; la rive IRRÉGULIÈRE vient des berges (monticules
-- d'herbe / criques de sable qui mordent sur l'eau), des pierres, des
-- roseaux, d'une île avec son saule. Pont en arc en bois (tablier = vraie
-- rampe continue, sans marche), ponton sur pilotis, barque, pédalo cygne,
-- jet d'eau. Les petits détails (nénuphars fleuris, canards, cygnes,
-- roseaux en plus) sont ajoutés côté CLIENT près de l'avatar
-- (TownGreenery, attributs NearDetail / DetailCF / DetailR).

local LAKE = Greenery.LAKE
local SAND = Color3.fromRGB(232, 210, 164)
local ROCK = Color3.fromRGB(150, 146, 150)
local PLANK = Color3.fromRGB(186, 134, 90)
local PLANK_DARK = Color3.fromRGB(140, 98, 66)

-- Tablier en arc (points du DESSUS, du bord a au bord b) : poutres jointives
-- qui dépassent un peu à chaque joint (pas de trou ; arête < 0,03 stud)
local function arch(a: Vector3, b: Vector3, rise: number, n: number): { Vector3 }
	local pts = {}
	for i = 0, n do
		local t = i / n
		table.insert(pts, a:Lerp(b, t) + Vector3.new(0, rise * math.sin(t * math.pi), 0))
	end
	return pts
end

local function bridge(model: Instance, from: Vector3, to: Vector3, side: Vector3)
	local br = TownKit.Model(model, "Bridge")
	local n = 8
	local len = (Vector3.new(to.X, 0, to.Z) - Vector3.new(from.X, 0, from.Z)).Magnitude
	local rise = math.min(4.6, len * 0.075)
	local deck = arch(from + Vector3.new(0, 0.06, 0), to + Vector3.new(0, 0.06, 0), rise, n)
	local T = 0.6 -- épaisseur du tablier
	local halfW = LAKE.BridgeHalfW
	for i = 1, n do
		local a, b = deck[i], deck[i + 1]
		local axis = (b - a).Unit
		local up = axis:Cross(side).Unit
		if up.Y < 0 then
			up = -up
		end
		-- (le dessus de la poutre passe par a et b : centre abaissé de T/2)
		local a2, b2 = a - axis * 0.3 - up * T / 2, b + axis * 0.3 - up * T / 2
		-- (un tronçon sur deux 0,1 plus étroit : côtés des recouvrements jamais confondus)
		local plank = TownKit.Beam(br, "Deck", a2, b2, halfW * 2 - (i % 2) * 0.1, T, i % 2 == 0 and PLANK or PLANK:Lerp(PLANK_DARK, 0.25), M.WoodPlanks, "solid")
		plank.CastShadow = true
	end
	-- garde-corps : poteaux à chaque joint + main courante
	for i = 1, n + 1 do
		for _, s in ipairs({ -1, 1 }) do
			local p = deck[i] + side * s * (halfW - 0.2)
			local newel = i == 1 or i == n + 1
			TownKit.Column(br, newel and "Newel" or "Post", p - Vector3.new(0, 0.3, 0), newel and 3.5 or 3.2, newel and 0.7 or 0.36, PLANK_DARK, M.Wood, "prop")
			if newel then
				TownKit.Ball(br, "NewelCap", p + Vector3.new(0, 3.3, 0), 0.9, PLANK, M.Wood, "deco")
			end
			if i <= n then
				local q = deck[i + 1] + side * s * (halfW - 0.2)
				TownKit.Beam(br, "Handrail", p + Vector3.new(0, 2.95, 0), q + Vector3.new(0, 2.95, 0), 0.34, 0.22, PLANK, M.Wood, "deco")
			end
		end
	end
	-- culées en pierre (les pieds du pont, dans la berge)
	for _, e in ipairs({ { deck[1], deck[2] }, { deck[n + 1], deck[n] } }) do
		local dirIn = Vector3.new(e[2].X - e[1].X, 0, e[2].Z - e[1].Z).Unit
		local p = e[1] + dirIn * 2.2
		TownKit.Part(br, "Abutment", Vector3.new(halfW * 2 + 1.6, 1.4, 2.2), CFrame.lookAt(p, p + dirIn) * CFrame.new(0, -0.62, 0), ROCK, M.Cobblestone, "deco")
	end
	return deck
end

-- Barque (coque en 3 pièces + banc + rames)
local function rowBoat(model: Instance, cf: CFrame)
	local hull = Color3.fromRGB(96, 150, 196)
	TownKit.Part(model, "BoatBottom", Vector3.new(2.6, 0.5, 5.4), cf * CFrame.new(0, 0.25, 0), hull, M.WoodPlanks, "deco")
	for _, s in ipairs({ -1, 1 }) do
		TownKit.Part(model, "BoatSide", Vector3.new(0.25, 0.9, 5.6), cf * CFrame.new(s * 1.35, 0.7, 0) * CFrame.Angles(0, 0, math.rad(s * 12)), C.White, M.WoodPlanks, "deco")
	end
	TownKit.Egg(model, "BoatBow", cf * CFrame.new(0, 0.55, -2.7), Vector3.new(2.7, 1.1, 3.4), hull, M.WoodPlanks, "deco")
	TownKit.Part(model, "BoatSeat", Vector3.new(2.5, 0.2, 0.9), cf * CFrame.new(0, 0.95, 0.4), C.WoodLight, M.WoodPlanks, "deco")
	TownKit.Rod(model, "Oar", (cf * CFrame.new(-1.2, 1.1, 0.4)).Position, (cf * CFrame.new(-3.4, 0.3, 1.8)).Position, 0.18, C.WoodLight, M.Wood, "deco")
end

-- Pédalo cygne (coque blanche, cou courbé, tête, bec orange, banc rose)
local function swanBoat(model: Instance, cf: CFrame)
	local white = Color3.fromRGB(250, 250, 252)
	TownKit.Egg(model, "SwanHull", cf * CFrame.new(0, 0.6, 0), Vector3.new(3.8, 1.8, 6.2), white, M.SmoothPlastic, "decoS")
	TownKit.Egg(model, "SwanWing", cf * CFrame.new(0, 1.3, 0.9), Vector3.new(3.4, 1.2, 3.6), Color3.fromRGB(238, 240, 246), M.SmoothPlastic, "deco")
	TownKit.Part(model, "SwanSeat", Vector3.new(2.4, 0.5, 1.2), cf * CFrame.new(0, 1.5, -0.2), Color3.fromRGB(255, 150, 190), M.Fabric, "deco")
	local neck0 = (cf * CFrame.new(0, 1.2, -2.4)).Position
	local neck1 = (cf * CFrame.new(0, 3.6, -3.2)).Position
	local neck2 = (cf * CFrame.new(0, 4.6, -2.7)).Position
	TownKit.Rod(model, "SwanNeck", neck0, neck1, 0.8, white, M.SmoothPlastic, "deco")
	TownKit.Rod(model, "SwanNeck", neck1, neck2, 0.7, white, M.SmoothPlastic, "deco")
	TownKit.Ball(model, "SwanHead", neck2 + Vector3.new(0, 0.1, 0), 1.3, white, M.SmoothPlastic, "deco")
	TownKit.Egg(model, "SwanBeak", CFrame.lookAt(neck2, (cf * CFrame.new(0, 4.4, -4.2)).Position) * CFrame.new(0, -0.05, -0.8), Vector3.new(0.4, 0.35, 0.9), Color3.fromRGB(255, 150, 60), M.SmoothPlastic, "deco")
end

local function lake(folder: Instance, geo: TownKit.Geo, center: Vector3, radius: number)
	local model = TownKit.Model(folder, "Lake")
	local towardPlaza = (Vector3.new(geo.Origin.X, center.Y, geo.Origin.Z) - center).Unit
	local side = Vector3.new(-towardPlaza.Z, 0, towardPlaza.X)
	local G = center + Vector3.new(0, GROUND_Y, 0)
	-- repère du lac : X = side, Y = haut, Z = en s'éloignant de la place
	local L = CFrame.fromMatrix(G, side, Vector3.new(0, 1, 0))
	local R = radius
	local function P(x: number, z: number, y: number?): Vector3
		return (L * CFrame.new(x, y or 0, z)).Position
	end
	local function ang(a: number, r: number): (number, number)
		return math.sin(a) * r, math.cos(a) * r
	end
	model:SetAttribute("NearDetail", "Lake")
	model:SetAttribute("DetailCF", L)
	model:SetAttribute("DetailR", R)
	-- nappes : rive de sable (on y marche), bord peu profond, fond, eau
	TownKit.Disc(model, "Shore", G + Vector3.new(0, 0.06, 0), R + 1.2, 0.3, SAND, M.Sand, "solid")
	TownKit.Disc(model, "LakeBed", G + Vector3.new(0, 0.12, 0), R - 1.6, 0.2, Color3.fromRGB(70, 150, 176), M.Sand, "deco")
	TownKit.Disc(model, "LakeDeep", G + Vector3.new(0, 0.16, 0), R * 0.62, 0.2, C.WaterDeep, M.Slate, "deco")
	local water = TownKit.Disc(model, "Water", G + Vector3.new(0, LAKE.WaterTop, 0), R, 0.2, C.Water, M.Glass, "deco")
	water.Transparency = 0.35
	water.Reflectance = 0.12
	-- berges : une couronne d'ovales couchés le long de la rive, herbe et
	-- sable en alternance, qui mordent plus ou moins sur l'eau : le bord
	-- devient une ligne ondulée (on laisse libres les bouts du pont et le ponton)
	local bx = LAKE.BridgeX * R
	local n = 16
	for k = 0, n - 1 do
		local a = k / n * math.pi * 2 + (hash(k, 101) - 0.5) * 0.2
		local bite = (hash(k, 102) - 0.35) * 3.2
		local x, z = ang(a, R + 1 - bite)
		local nearBridge = math.abs(x - bx) < 7 and math.abs(z) > R * 0.6
		local nearDock = x > R * 0.6 and math.abs(z - LAKE.DockZ * R) < 6
		if not nearBridge and not nearDock then
			local beach = k % 3 == 1
			local len = 2 * math.pi * R / n * (1.25 + hash(k, 103) * 0.35)
			local wid = 5 + hash(k, 104) * 4 + math.max(0, bite) * 1.4
			local tall = beach and 0.95 or 1.3 + hash(k, 105) * 0.5
			local color = beach and SAND or C.Grass:Lerp(C.GrassDark, hash(k, 106) * 0.45)
			TownKit.Egg(model, beach and "Beach" or "Bank", L * CFrame.new(x, 0, z) * CFrame.Angles(0, a, 0), Vector3.new(len, tall, wid), color, beach and M.Sand or M.Grass, "deco")
		end
	end
	-- pierres de la rive
	for k = 0, 6 do
		local a = k / 7 * math.pi * 2 + 0.2 + hash(k, 106) * 0.35
		local x, z = ang(a, R - 0.4 + hash(k, 107) * 1.2)
		if not (math.abs(x - bx) < 6 and math.abs(z) > R * 0.6) then
			local s = 1.1 + hash(k, 108) * 1.3
			TownKit.Egg(model, "Stone", L * CFrame.new(x, 0.3, z) * CFrame.Angles(0, hash(k, 109) * 6, 0), Vector3.new(s * 1.3, s * 0.8, s), ROCK:Lerp(C.White, hash(k, 110) * 0.25), M.Slate, "deco")
		end
	end
	-- roseaux + massettes (le reste des roseaux vient du client)
	for k = 0, 1 do
		local a = 0.7 + k * 1.55
		local x, z = ang(a, R - 1.2)
		if not (math.abs(x - bx) < 6 and math.abs(z) > R * 0.6) then
			local base = L * CFrame.new(x, 0, z)
			TownKit.Egg(model, "Reeds", base * CFrame.new(0, 1.7, 0) * CFrame.Angles(0, a, math.rad(6)), Vector3.new(1.4, 4.2, 1.1), Color3.fromRGB(104, 158, 84), M.Grass, "deco")
			TownKit.Rod(model, "Cattail", (base * CFrame.new(0.5, 0.3, 0.3)).Position, (base * CFrame.new(0.7, 4.4, 0.4)).Position, 0.14, Color3.fromRGB(96, 146, 78), M.Grass, "deco")
			TownKit.Egg(model, "CattailHead", base * CFrame.new(0.72, 4.5, 0.4), Vector3.new(0.42, 1.2, 0.42), Color3.fromRGB(122, 84, 58), M.Fabric, "deco")
		end
	end
	-- l'île et son saule
	local ix, iz, ir = LAKE.Island[1] * R, LAKE.Island[2] * R, math.max(4.5, LAKE.Island[3] * R)
	TownKit.Egg(model, "IslandSand", L * CFrame.new(ix, 0.3, iz), Vector3.new(ir * 2 + 2.4, 1.2, ir * 2 + 1.6), SAND, M.Sand, "deco")
	TownKit.Egg(model, "Island", L * CFrame.new(ix, 0.4, iz), Vector3.new(ir * 2, 2.4, ir * 1.8), C.Grass, M.Grass, "deco")
	TownKit.Tree(model, P(ix, iz, 1.4), 13, 911, "Willow", { Tier = 1, Lawn = true })
	TownKit.Egg(model, "Stone", L * CFrame.new(ix - ir * 0.8, 0.5, iz + ir * 0.5), Vector3.new(1.8, 1.1, 1.4), ROCK, M.Slate, "deco")
	-- jet d'eau (colonne + gerbe, transparentes, + particules douces)
	local jx, jz = LAKE.Jet[1] * R, LAKE.Jet[2] * R
	TownKit.Disc(model, "JetRipple", P(jx, jz, LAKE.WaterTop + 0.04), 2.2, 0.06, Color3.fromRGB(214, 238, 252), M.SmoothPlastic, "deco").Transparency = 0.35
	local column = TownKit.Egg(model, "JetColumn", L * CFrame.new(jx, LAKE.WaterTop + 3.3, jz), Vector3.new(0.8, 6.4, 0.8), Color3.fromRGB(226, 244, 255), M.Glass, "deco")
	column.Transparency = 0.35
	local spray = TownKit.Egg(model, "JetSpray", L * CFrame.new(jx, LAKE.WaterTop + 6.2, jz), Vector3.new(3.2, 1.6, 3.2), Color3.fromRGB(236, 248, 255), M.Glass, "deco")
	spray.Transparency = 0.45
	local drops = Instance.new("ParticleEmitter")
	drops.Name = "JetDrops"
	drops.Color = ColorSequence.new(Color3.fromRGB(230, 246, 255))
	drops.LightEmission = 0
	drops.Transparency = NumberSequence.new(0.3, 1)
	drops.Size = NumberSequence.new(0.35, 0.1)
	drops.Lifetime = NumberRange.new(0.8, 1.2)
	drops.Rate = 18
	drops.Speed = NumberRange.new(4, 6)
	drops.SpreadAngle = Vector2.new(35, 35)
	drops.Acceleration = Vector3.new(0, -18, 0)
	drops.Parent = spray
	-- pont en arc (du côté de la place vers le fond)
	bridge(model, P(bx, -(R + 5)), P(bx, R + 5), side)
	-- ponton sur pilotis (depuis la rive +X, vers le milieu) + barque + pédalo
	local dz = LAKE.DockZ * R
	local dock = L * CFrame.new(R - 3, 0, dz) * CFrame.Angles(0, math.pi / 2, 0)
	-- (dessus à 0,85 : une petite marche depuis la rive)
	TownKit.Part(model, "Dock", Vector3.new(4, 0.4, 12), dock * CFrame.new(0, 0.65, 0), PLANK, M.WoodPlanks, "solid")
	for _, zz in ipairs({ -5.4, 0, 5.4 }) do
		for _, xx in ipairs({ -1.7, 1.7 }) do
			TownKit.Column(model, "DockPost", (dock * CFrame.new(xx, -0.2, zz)).Position, 1.8, 0.45, PLANK_DARK, M.Wood, "deco")
		end
	end
	rowBoat(model, dock * CFrame.new(-3.6, LAKE.WaterTop - 0.35, 2.4) * CFrame.Angles(0, math.rad(8), 0))
	swanBoat(model, dock * CFrame.new(3.8, LAKE.WaterTop - 0.3, 1.4) * CFrame.Angles(0, math.rad(-10), 0))
	-- arbres de la rive : saules pleureurs + deux palmiers sur la plage
	local rim = {
		{ -0.62, 0.9, "Willow" },
		{ -1.02, -0.2, "Willow" },
		{ 0.62, 0.94, "Palm" },
		{ 0.86, 0.72, "Palm" },
	}
	for i, t in ipairs(rim) do
		local p = P(t[1] * R + (t[1] > 0 and 3 or -3), t[2] * R + 3)
		TownKit.Tree(model, p, t[3] == "Palm" and 15 + i or 14, 131 * i, t[3], { Tier = 1, Lawn = true })
	end
	-- bancs face à l'eau (côté place) + lampadaires aux bouts du pont
	for _, bxx in ipairs({ 0.34, -0.72 }) do
		local p = P(bxx * R, -(R + 6))
		TownKit.Bench(model, CFrame.lookAt(p, P(bxx * R, 0)))
	end
	for _, s in ipairs({ -1, 1 }) do
		TownKit.Lamp(model, P(bx + 5.2, s * (R + 7)), TownKit.Facing(-side), false)
	end
	geo.Reserve(center, R + 9)
	-- (pied du pont côté place : l'allée du parc y arrive)
	return P(bx, -(R + 7))
end

----------------------------------------------------------------------
-- Aire de jeux (v9.7, NATURE97), pique-nique, coin du parc
----------------------------------------------------------------------
-- (v9.9, PARK99) 🛝 aire de jeux QUI MARCHE : ici, seulement le squelette
-- serveur (TownPark : sol souple, murs invisibles, volumes où l'on marche,
-- mur d'escalade, SIÈGES + invites E des balançoires, tape-cul, tourniquet,
-- jeux à ressort, bancs ; repères des invites Glisser / Traverser /
-- Creuser). Tout le décor réaliste et les animations sont côté CLIENT
-- (ParkPlay, via TownGreenery : NearDetail "Playground"). `cf` : centre au
-- sol, -Z vers la place. (v9.7 : ~110 pièces serveur, rien ne bougeait.)

local TownPark = require(script.Parent.TownPark)

local function playground(folder: Instance, geo: TownKit.Geo, cf: CFrame)
	local model = TownKit.Model(folder, "Playground")
	local g = cf * CFrame.new(0, GROUND_Y, 0)
	model:SetAttribute("NearDetail", "Playground")
	model:SetAttribute("DetailCF", g)
	TownPark.Build(model, g)
	-- un banc pour les parents + une poubelle, dehors, près du portillon
	local hd = 30 / 2 + 0.6
	TownKit.Bench(model, CFrame.lookAt((g * CFrame.new(-9, 0, -hd - 4.5)).Position, (g * CFrame.new(-9, 0, 0)).Position))
	TownKit.Bin(model, (g * CFrame.new(2.4 + 3.2, 0, -hd - 2.4)).Position, Color3.fromRGB(96, 150, 110))
	geo.Reserve(cf.Position, 23)
	-- (après toute la nature : invite "S'asseoir" sur les bancs du parc)
	task.defer(TownPark.BenchPrompts, folder)
end

local function picnic(folder: Instance, geo: TownKit.Geo, cf: CFrame, count: number)
	local model = TownKit.Model(folder, "Picnic")
	for i = 1, count do
		local t = cf * CFrame.new((i - (count + 1) / 2) * 9, GROUND_Y, (i % 2) * 3) * CFrame.Angles(0, math.rad(i * 25), 0)
		part(model, "TableTop", Vector3.new(6, 0.35, 2.6), t * CFrame.new(0, 2.6, 0), C.WoodLight, M.WoodPlanks, "solid")
		part(model, "Cloth", Vector3.new(3, 0.05, 2.7), t * CFrame.new(0, 2.8, 0), i % 2 == 0 and C.Pink or C.Sky, M.Fabric, "deco")
		for _, z in ipairs({ -2, 2 }) do
			part(model, "BenchPlank", Vector3.new(6, 0.3, 1), t * CFrame.new(0, 1.5, z), C.WoodLight, M.WoodPlanks, "solid")
		end
		for _, x in ipairs({ -2.4, 2.4 }) do
			part(model, "Legs", Vector3.new(0.4, 2.5, 4.6), t * CFrame.new(x, 1.25, 0), C.Wood, M.Wood, "prop")
		end
		geo.Reserve(t.Position, 5)
	end
	-- (v9.7) chariot à glaces sous son parasol, à côté des tables
	local cart = cf * CFrame.new((count + 1) / 2 * 9 + 4, GROUND_Y, -2) * CFrame.Angles(0, math.rad(-20), 0)
	part(model, "CartBody", Vector3.new(4.4, 2.2, 2.2), cart * CFrame.new(0, 1.9, 0), Color3.fromRGB(255, 236, 244), M.SmoothPlastic, "prop")
	part(model, "CartStripe", Vector3.new(4.5, 0.5, 2.3), cart * CFrame.new(0, 2.2, 0), C.Pink, M.SmoothPlastic, "deco")
	for _, x in ipairs({ -1.4, 1.4 }) do
		local wheel = part(model, "CartWheel", Vector3.new(0.3, 1.6, 1.6), cart * CFrame.new(x, 0.8, 1.2) * CFrame.Angles(0, math.rad(90), 0), C.Metal, M.Rubber, "deco")
		;(wheel :: Part).Shape = Enum.PartType.Cylinder
	end
	TownKit.Column(model, "CartPole", (cart * CFrame.new(0, 3, 0)).Position, 4.2, 0.2, C.White, M.Metal, "deco")
	TownKit.Egg(model, "Parasol", cart * CFrame.new(0, 7.2, 0), Vector3.new(6.4, 1.6, 6.4), C.Mint, M.Fabric, "decoS")
	TownKit.Ball(model, "Scoop", (cart * CFrame.new(-1, 3.4, 0)).Position, 0.9, C.Pink, M.SmoothPlastic, "deco")
	TownKit.Ball(model, "Scoop", (cart * CFrame.new(0.2, 3.4, 0.1)).Position, 0.9, C.Lemon, M.SmoothPlastic, "deco")
	geo.Reserve(cart.Position, 5)
end

-- Kiosque (gloriette) : plancher, 6 colonnes, dôme, épi de faîtage
local function gazebo(folder: Instance, geo: TownKit.Geo, cf: CFrame)
	local model = TownKit.Model(folder, "Gazebo")
	local g = cf * CFrame.new(0, GROUND_Y, 0)
	TownKit.Disc(model, "GazeboFloor", (g * CFrame.new(0, 0.5, 0)).Position, 6.2, 0.6, C.Stone, M.Marble, "solid")
	TownKit.Disc(model, "GazeboStep", (g * CFrame.new(0, 0.25, 0)).Position, 7, 0.3, C.StoneDark, M.Marble, "solid")
	for k = 0, 5 do
		local a = k * math.pi / 3 + math.pi / 6
		TownKit.Column(model, "GazeboPost", (g * CFrame.new(math.cos(a) * 5.4, 0.5, math.sin(a) * 5.4)).Position, 6.6, 0.5, C.White, M.Wood, "prop")
	end
	-- (dôme en lentille : dessous à 6,1 au centre, au-dessus des têtes)
	TownKit.Egg(model, "GazeboRoof", g * CFrame.new(0, 7.6, 0), Vector3.new(14.4, 3, 14.4), Color3.fromRGB(150, 196, 180), M.SmoothPlastic, "decoS")
	TownKit.Egg(model, "GazeboCrown", g * CFrame.new(0, 8.9, 0), Vector3.new(5, 1.4, 5), Color3.fromRGB(236, 246, 240), M.SmoothPlastic, "deco")
	TownKit.Ball(model, "GazeboFinial", (g * CFrame.new(0, 9.9, 0)).Position, 0.9, C.Yellow, M.Metal, "deco")
	TownKit.Bench(model, g * CFrame.new(0, 0.5, 2.6) * CFrame.Angles(0, math.pi, 0))
	geo.Reserve(cf.Position, 11)
end

----------------------------------------------------------------------
-- Marché + food truck
----------------------------------------------------------------------

local function market(folder: Instance, geo: TownKit.Geo, cf: CFrame)
	local model = TownKit.Model(folder, "Market")
	TownKit.Disc(model, "Square", (cf * CFrame.new(0, GROUND_Y + 0.15, 0)).Position, 17, 0.5, C.Paving, M.Cobblestone, "solid")
	local stalls = {
		{ C.Pink, Color3.fromRGB(255, 120, 120) }, -- fraises
		{ C.Mint, Color3.fromRGB(255, 190, 90) }, -- oranges
		{ C.Lemon, Color3.fromRGB(150, 210, 110) }, -- pommes
	}
	for i, colors in ipairs(stalls) do
		-- (v9.6 : posés SUR la place (dessus à +0.15), plus 0.25 au-dessus du sol)
		local s = cf * CFrame.Angles(0, math.rad((i - 2) * 50), 0) * CFrame.new(0, GROUND_Y + 0.15, -10)
		part(model, "Counter", Vector3.new(7, 2.6, 2.6), s * CFrame.new(0, 1.3, 0), C.WoodLight, M.WoodPlanks, "solid")
		part(model, "Goods", Vector3.new(6.4, 0.6, 2), s * CFrame.new(0, 2.9, 0), colors[2], M.SmoothPlastic, "deco")
		for _, x in ipairs({ -3.3, 3.3 }) do
			part(model, "Pole", Vector3.new(0.3, 7, 0.3), s * CFrame.new(x, 3.5, 1.2), C.White, M.Wood, "deco")
		end
		for k = 0, 5 do
			part(model, "Canopy", Vector3.new(7.6 / 6, 0.2, 4.4), s * CFrame.new(-3.8 + (k + 0.5) * 7.6 / 6, 7, -0.2) * CFrame.Angles(math.rad(-14), 0, 0), k % 2 == 0 and colors[1] or C.White, M.Fabric, k == 0 and "decoS" or "deco")
		end
	end
	-- food truck (v9.7, VEHICLES97) : vrai food truck posé SUR la place
	-- (cabine, passe-plat + comptoir tournés vers le marché, auvent rayé,
	-- menu, enseigne "🌮 Taco Party") ; version légère (~50 pièces)
	local truck = cf * CFrame.new(0, GROUND_Y + 0.15, 9) * CFrame.Angles(0, math.rad(90), 0)
	TownVehicles.FoodTruck(model, truck, Color3.fromRGB(255, 214, 120))
	geo.Reserve(cf.Position, 19)
end

----------------------------------------------------------------------
-- Jardin fleuri (pergola) + terrain de basket
----------------------------------------------------------------------

local function flowerGarden(folder: Instance, geo: TownKit.Geo, cf: CFrame)
	local model = TownKit.Model(folder, "FlowerGarden")
	-- (v9.7) planches de terre + vraies touffes de fleurs (ovales en bouquets)
	for i = 0, 4 do
		local row = cf * CFrame.new(0, GROUND_Y, -9 + i * 4.4)
		part(model, "Soil", Vector3.new(20, 0.6, 2.4), row * CFrame.new(0, 0.3, 0), Color3.fromRGB(120, 86, 64), M.Ground, "prop")
		-- feuillage de la planche, puis des bouquets ronds qui dépassent
		TownKit.Egg(model, "Leaves", row * CFrame.new(0, 0.75, 0), Vector3.new(19.4, 1.1, 2.12), Color3.fromRGB(92, 156, 80), M.Grass, "deco")
		for k = 0, 3 do
			local color = TownKit.FLOWERS[(i + (k % 2) * 2) % #TownKit.FLOWERS + 1]
			TownKit.Egg(model, "Flowers", row * CFrame.new(-7.2 + k * 4.8 + (hash(i, k + 120) - 0.5) * 0.8, 1.25 + hash(i, k + 126) * 0.15, (hash(i, k + 123) - 0.5) * 0.4), Vector3.new(3.4, 0.95, 1.7), color, M.SmoothPlastic, "deco")
		end
	end
	-- pergola couverte de glycine
	local p = cf * CFrame.new(0, GROUND_Y, 16)
	for _, x in ipairs({ -4, 4 }) do
		for _, z in ipairs({ -3, 3 }) do
			part(model, "PergolaPost", Vector3.new(0.7, 8, 0.7), p * CFrame.new(x, 4, z), C.White, M.Wood, "prop")
		end
	end
	for i = 0, 4 do
		part(model, "PergolaBeam", Vector3.new(10, 0.4, 0.5), p * CFrame.new(0, 8.2, -3 + i * 1.5), C.White, M.Wood, "deco")
	end
	local lilac = Color3.fromRGB(200, 150, 230)
	TownKit.Egg(model, "Vine", p * CFrame.new(-2, 8.9, 0), Vector3.new(6.3, 1.4, 7.4), Color3.fromRGB(120, 176, 96), M.Grass, "deco")
	TownKit.Egg(model, "Vine", p * CFrame.new(2.4, 8.8, 0.5), Vector3.new(5.6, 1.3, 6.6), lilac, M.Grass, "deco")
	for k = 0, 3 do
		local x = -3.3 + k * 2.2
		TownKit.Egg(model, "Wisteria", p * CFrame.new(x, 7.4, (k % 2 == 0) and -2.6 or 2.6), Vector3.new(0.9, 2.2, 0.9), lilac:Lerp(C.White, (k % 2) * 0.25), M.SmoothPlastic, "deco")
	end
	TownKit.Bench(model, p * CFrame.new(0, 0, 1.2))
	geo.Reserve((cf * CFrame.new(0, 0, 3)).Position, 16)
end

local function court(folder: Instance, geo: TownKit.Geo, cf: CFrame)
	local model = TownKit.Model(folder, "Court")
	part(model, "Floor", Vector3.new(30, 0.5, 17), cf * CFrame.new(0, GROUND_Y + 0.1, 0), Color3.fromRGB(120, 150, 214), M.Rubber, "solid")
	part(model, "Paint", Vector3.new(26, 0.1, 13), cf * CFrame.new(0, GROUND_Y + 0.38, 0), Color3.fromRGB(236, 150, 120), M.Rubber, "deco")
	part(model, "MidLine", Vector3.new(0.3, 0.12, 13), cf * CFrame.new(0, GROUND_Y + 0.4, 0), C.White, M.SmoothPlastic, "deco")
	-- (v9.6 z-fighting : dessus à +0.49, au-dessus de la peinture (+0.43) et de la ligne (+0.46))
	TownKit.Disc(model, "Circle", (cf * CFrame.new(0, GROUND_Y + 0.49, 0)).Position, 2.4, 0.1, C.White, M.SmoothPlastic, "deco")
	for _, sx in ipairs({ -1, 1 }) do
		local hoop = cf * CFrame.new(sx * 13.8, GROUND_Y, 0)
		part(model, "HoopPole", Vector3.new(0.5, 10, 0.5), hoop * CFrame.new(sx * 1, 5, 0), C.Metal, M.Metal, "prop")
		part(model, "Backboard", Vector3.new(0.2, 3.4, 5), hoop * CFrame.new(sx * 0.6, 10, 0), C.White, M.Glass, "deco")
		local ring = part(model, "Rim", Vector3.new(0.2, 1.8, 1.8), hoop * CFrame.new(-sx * 0.4, 8.8, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(255, 120, 60), M.Metal, "deco")
		;(ring :: Part).Shape = Enum.PartType.Cylinder
	end
	-- grillage (deux longs côtés)
	for _, sz in ipairs({ -1, 1 }) do
		local fence = part(model, "Fence", Vector3.new(30, 5, 0.2), cf * CFrame.new(0, GROUND_Y + 2.5, sz * 8.6), C.MetalLight, M.DiamondPlate, "prop")
		fence.Transparency = 0.55
	end
	TownKit.Ball(model, "Ball", (cf * CFrame.new(3, GROUND_Y + 1.2, 2)).Position, 1.6, Color3.fromRGB(240, 130, 60), M.Rubber, "deco")
	geo.Reserve(cf.Position, 17)
end

----------------------------------------------------------------------
-- Allées de parc, terrain de foot, champ de tulipes (grandes villes)
----------------------------------------------------------------------

local PATH = Color3.fromRGB(236, 222, 196)

-- Allée en gravier SINUEUSE de a à b (v9.7) : tronçons droits + disques
-- aux coudes (virages arrondis, un peu plus hauts : pas de faces confondues) ;
-- réserve son tracé (pas d'arbre dessus)
local function footpath(folder: Instance, geo: TownKit.Geo, a: Vector3, b: Vector3, seed: number?)
	local y = geo.Origin.Y + GROUND_Y + 0.06
	local flatA = Vector3.new(a.X, y, a.Z)
	local flatB = Vector3.new(b.X, y, b.Z)
	local len = (flatB - flatA).Magnitude
	if len < 6 then
		return
	end
	local along = (flatB - flatA).Unit
	local perp = Vector3.new(-along.Z, 0, along.X)
	local n = math.clamp(math.floor(len / 13), 1, 5)
	local amp = math.min(4, len * 0.08) * (hash(seed or 1, 130) < 0.5 and -1 or 1)
	local pts = {}
	for i = 0, n do
		local t = i / n
		local wiggle = (i == 0 or i == n) and 0 or math.sin(t * math.pi * 2) * amp
		table.insert(pts, flatA:Lerp(flatB, t) + perp * wiggle)
	end
	for i = 1, n do
		local p0, p1 = pts[i], pts[i + 1]
		local mid = (p0 + p1) / 2
		part(folder, "Footpath", Vector3.new(5, 0.2, (p1 - p0).Magnitude), CFrame.lookAt(mid, p1) * CFrame.new(0, -0.1, 0), PATH, M.Pebble, "deco")
		if i < n then
			TownKit.Disc(folder, "PathBend", p1 + Vector3.new(0, 0.03, 0), 2.5, 0.2, PATH, M.Pebble, "deco")
		end
	end
	for t = 0, len, 9 do
		geo.Reserve(flatA:Lerp(flatB, t / len), 4 + math.abs(amp))
	end
end

local function soccer(folder: Instance, geo: TownKit.Geo, cf: CFrame)
	local model = TownKit.Model(folder, "SoccerField")
	local L, W = 44, 28
	part(model, "Pitch", Vector3.new(W, 0.2, L), cf * CFrame.new(0, GROUND_Y + 0.02, 0), Color3.fromRGB(110, 190, 100), M.Grass, "deco")
	for i = -2, 2, 2 do
		part(model, "Stripe", Vector3.new(W - 2, 0.2, L / 7), cf * CFrame.new(0, GROUND_Y + 0.05, i * L / 7), Color3.fromRGB(130, 206, 116), M.Grass, "deco")
	end
	local line = C.White
	for _, sx in ipairs({ -1, 1 }) do
		part(model, "Touchline", Vector3.new(0.4, 0.2, L - 2), cf * CFrame.new(sx * (W / 2 - 1), GROUND_Y + 0.08, 0), line, M.SmoothPlastic, "deco")
		part(model, "GoalLine", Vector3.new(W - 2, 0.2, 0.4), cf * CFrame.new(0, GROUND_Y + 0.08, sx * (L / 2 - 1)), line, M.SmoothPlastic, "deco")
		-- but : poteaux, barre, filet
		local goal = cf * CFrame.new(0, GROUND_Y, sx * (L / 2 - 0.6))
		for _, gx in ipairs({ -3.5, 3.5 }) do
			part(model, "Post", Vector3.new(0.3, 4, 0.3), goal * CFrame.new(gx, 2, 0), line, M.Metal, "prop")
		end
		part(model, "Bar", Vector3.new(7.3, 0.3, 0.3), goal * CFrame.new(0, 4, 0), line, M.Metal, "deco")
		local net = part(model, "Net", Vector3.new(7, 3.8, 2), goal * CFrame.new(0, 2, sx * 1.1), line, M.Fabric, "deco")
		net.Transparency = 0.6
	end
	part(model, "MidLine", Vector3.new(W - 2, 0.2, 0.4), cf * CFrame.new(0, GROUND_Y + 0.08, 0), line, M.SmoothPlastic, "deco")
	TownKit.Disc(model, "CenterRing", (cf * CFrame.new(0, GROUND_Y + 0.1, 0)).Position, 4.2, 0.1, line, M.SmoothPlastic, "deco")
	TownKit.Disc(model, "CenterIn", (cf * CFrame.new(0, GROUND_Y + 0.12, 0)).Position, 3.8, 0.1, Color3.fromRGB(110, 190, 100), M.Grass, "deco")
	TownKit.Ball(model, "Ball", (cf * CFrame.new(2, GROUND_Y + 0.9, 3)).Position, 1.4, C.White, M.SmoothPlastic, "deco")
	geo.Reserve(cf.Position, 27)
end

local function tulips(folder: Instance, geo: TownKit.Geo, cf: CFrame)
	local model = TownKit.Model(folder, "TulipField")
	for i = 0, 6 do
		part(model, "Tulips", Vector3.new(26, 1.1, 2.6), cf * CFrame.new(0, GROUND_Y + 0.5, -12 + i * 4), TownKit.FLOWERS[i % #TownKit.FLOWERS + 1], M.Grass, "deco")
	end
	-- petit moulin décoratif
	local mill = cf * CFrame.new(16, GROUND_Y, 0)
	TownKit.Column(model, "MillTower", mill.Position, 12, 5, C.Cream, M.Plaster, "solid")
	TownKit.Wedge(model, "MillRoof", Vector3.new(5.6, 3, 2.8), mill * CFrame.new(0, 13.5, -1.4), Color3.fromRGB(170, 96, 90), M.ClayRoofTiles, "deco")
	TownKit.Wedge(model, "MillRoof", Vector3.new(5.6, 3, 2.8), mill * CFrame.new(0, 13.5, 1.4) * CFrame.Angles(0, math.pi, 0), Color3.fromRGB(170, 96, 90), M.ClayRoofTiles, "deco")
	local hub = mill * CFrame.new(0, 10, -2.8)
	for k = 0, 1 do
		part(model, "Sail", Vector3.new(1.4, 14, 0.2), hub * CFrame.Angles(0, 0, math.rad(45 + k * 90)), C.White, M.Fabric, "deco")
	end
	geo.Reserve(cf.Position, 20)
	geo.Reserve(mill.Position, 5)
end

----------------------------------------------------------------------
-- Paysage lointain
----------------------------------------------------------------------

local function hills(folder: Instance, geo: TownKit.Geo)
	local model = TownKit.Model(folder, "Hills")
	local O = geo.Origin
	-- (grandes boules très enterrées : on ne voit qu'un dôme doux de 25 à 55 studs)
	-- (v10, LAYOUT10 : la grande ville va jusqu'à ~1580 studs ; collines et
	-- montagnes bornées pour rester sur le pré, qui s'arrête à 2048)
	local town = math.min(geo.Town, 1520)
	local n = 18
	for i = 1, n do
		local a = (i + hash(i, 61) * 0.6) / n * math.pi * 2
		local d = 380 + hash(i, 63) * 260
		local rise = 25 + hash(i, 65) * 30
		local dist = town + 60 + math.sqrt(d * rise) * 0.9 + hash(i, 62) * 60
		local p = O + Vector3.new(math.sin(a) * dist, GROUND_Y - d / 2 + rise, math.cos(a) * dist)
		local tone = C.Grass:Lerp(Color3.fromRGB(106, 176, 98), hash(i, 64))
		TownKit.Ball(model, "Hill", p, d, tone, M.Grass, "deco")
		-- (v9.8, CITY98) éoliennes sur quelques sommets (client : pales qui tournent)
		if i % 4 == 1 then
			local top = O + Vector3.new(math.sin(a) * dist, GROUND_Y + rise - 0.6, math.cos(a) * dist)
			TownKit.LifeSpot("Turbine", CFrame.lookAt(top, Vector3.new(O.X, top.Y, O.Z)), i)
		end
	end
	-- montagnes enneigées (pyramides approchées) dans le dos de l'entrée
	for i = 1, 5 do
		local a = math.pi + (i - 3) * 0.36 + (hash(i, 65) - 0.5) * 0.1
		local dist = math.min(geo.Town, 1460) + 360 + hash(i, 66) * 80
		local h = 90 + hash(i, 67) * 80
		local w = h * 1.5
		local base = O + Vector3.new(math.sin(a) * dist, GROUND_Y - 5, math.cos(a) * dist)
		local cf = CFrame.lookAt(base, Vector3.new(O.X, base.Y, O.Z))
		local rock = Color3.fromRGB(150, 150, 196):Lerp(Color3.fromRGB(176, 170, 214), hash(i, 68))
		for r = 0, 1 do
			local rot = CFrame.Angles(0, r * math.pi / 2, 0)
			TownKit.Wedge(model, "Mountain", Vector3.new(w, h, w / 2), cf * rot * CFrame.new(0, h / 2, -w / 4), rock, M.Rock, "deco")
			TownKit.Wedge(model, "Mountain", Vector3.new(w, h, w / 2), cf * rot * CFrame.Angles(0, math.pi, 0) * CFrame.new(0, h / 2, -w / 4), rock, M.Rock, "deco")
		end
		local sh = h * 0.28
		local sw = w * 0.28
		for r = 0, 1 do
			local rot = CFrame.Angles(0, r * math.pi / 2, 0)
			TownKit.Wedge(model, "Snow", Vector3.new(sw + 0.4, sh, sw / 2 + 0.2), cf * rot * CFrame.new(0, h - sh / 2 + 0.3, -sw / 4), C.White, M.Snow, "deco")
			TownKit.Wedge(model, "Snow", Vector3.new(sw + 0.4, sh, sw / 2 + 0.2), cf * rot * CFrame.Angles(0, math.pi, 0) * CFrame.new(0, h - sh / 2 + 0.3, -sw / 4), C.White, M.Snow, "deco")
		end
	end
end

-- Arbres semés dans les zones libres de l'anneau intérieur
local function scatterTrees(folder: Instance, geo: TownKit.Geo, target: number)
	local model = TownKit.Model(folder, "ParkTrees")
	-- (grandes villes : plus d'arbres, surtout des boules taillées à 2 pièces)
	local roundish = geo.Slots >= 11 and 0.65 or 0.3
	local placed = 0
	local r0 = WorldLayout.PLAZA_R + 30
	local r1 = geo.Inner
	for i = 1, target * 8 do
		if placed >= target then
			break
		end
		local a = hash(i, 71) * math.pi * 2
		-- (v10 : centre-ville CARRÉ, les coins aussi : r jusqu'à r1 / cos 45°)
		local r = r0 + math.sqrt(hash(i, 72)) * (r1 * 1.41 - r0)
		local p = geo.Origin + Vector3.new(math.sin(a) * r, 0, math.cos(a) * r)
		local size = 10 + hash(i, 73) * 8
		if geo.IsFree(p, 4) then
			-- (v9.7 NATURE97) parc mélangé : chênes, érables, cerisiers, bouleaux,
			-- sapins, peupliers, pommiers (grandes villes : plus de peupliers, fins
			-- et à 3 pièces) ; silhouette côté serveur, détails de près côté client
			local h = hash(i, 74)
			local mix = roundish > 0.5 and { "Poplar", "Oak", "Poplar", "Birch", "Fir", "Cherry", "Poplar", "Maple" }
				or { "Oak", "Maple", "Cherry", "Birch", "Oak", "Fir", "Poplar", "Fruit", "Oak", "Cherry" }
			local kind = mix[1 + math.floor(h * #mix) % #mix]
			TownKit.Tree(model, p + Vector3.new(0, GROUND_Y, 0), size, i, kind, { Lawn = true })
			geo.Reserve(p, 6)
			placed += 1
		end
	end
	return placed
end

-- (v10, LAYOUT10) Ceinture verte de la grande ville : arbres (construits
-- côté client, 0 pièce serveur : TownKit.Tree) entre l'avenue de ceinture et
-- l'autoroute, et dans la campagne au-delà de l'autoroute. Jamais sur une
-- route, une parcelle, un lieu réservé ni dans les zones de quartier / nature
-- (celles-là sont habillées par CITY10, côté client).
local function belt(folder: Instance, geo: TownKit.Geo)
	local model = TownKit.Model(folder, "Woods")
	local O = geo.Origin
	local count = geo.Count
	local R = WorldLayout.BeltR(count)
	local H = WorldLayout.HighwayR(count)
	local town = WorldLayout.TownRadius(count)
	local zones = WorldLayout.Facilities(count)
	local function blocked(x: number, z: number, r: number): boolean
		if WorldLayout.OnRoad(count, x, z, r + 3) or WorldLayout.OnPlot(count, x, z, r + 2) then
			return true
		end
		for _, zone in ipairs(zones) do
			if WorldLayout.InZone(zone, x, z, r) then
				return true
			end
		end
		return false
	end
	local rings = {
		{ In = R + WorldLayout.GRID_HALF + 10, Out = H - WorldLayout.HIGHWAY_W / 2 - 14, Target = 90, Salt = 0 },
		{ In = H + WorldLayout.HIGHWAY_W / 2 + 18, Out = town - 40, Target = 70, Salt = 5000 },
	}
	local placed: { Vector3 } = {}
	for _, ring in ipairs(rings) do
		local n = 0
		for i = 1, ring.Target * 6 do
			if n >= ring.Target then
				break
			end
			local salt = ring.Salt + i
			-- point au hasard dans l'anneau carré : un côté, une position le long, une profondeur
			local side = math.floor(hash(salt, 11) * 4) % 4
			local along = (hash(salt, 12) * 2 - 1) * ring.Out
			local depth = ring.In + hash(salt, 13) * (ring.Out - ring.In)
			local x, z
			if side == 0 then
				x, z = along, depth
			elseif side == 1 then
				x, z = depth, along
			elseif side == 2 then
				x, z = along, -depth
			else
				x, z = -depth, along
			end
			local size = 13 + hash(salt, 14) * 9
			local ok = not blocked(x, z, 6)
			if ok then
				for _, q in ipairs(placed) do
					if (q.X - x) ^ 2 + (q.Z - z) ^ 2 < 14 * 14 then
						ok = false
						break
					end
				end
			end
			if ok then
				local h = hash(salt, 15)
				local kind = h < 0.35 and "Fir" or (h < 0.6 and "Oak" or (h < 0.8 and "Poplar" or (h < 0.92 and "Birch" or "Maple")))
				TownKit.Tree(model, O + Vector3.new(x, GROUND_Y, z), size, salt, kind, { Lawn = true })
				table.insert(placed, Vector3.new(x, 0, z))
				n += 1
			end
		end
	end
end

----------------------------------------------------------------------
-- (v9.8, CITY98) Parcs : emplacements du mobilier construit côté client
----------------------------------------------------------------------

-- Zones tenues libres pour les autres (fête foraine derrière la mairie et
-- son allée ; repère : centre de la ville, 8 parcelles, tailles fixes)
local function inKeepOut(geo: TownKit.Geo, p: Vector3, r: number): boolean
	local rel = p - geo.Origin
	-- fête foraine + allée derrière la mairie (FAIR98 : x -55..55, z -176..-92)
	if rel.X > -58 - r and rel.X < 58 + r and rel.Z > -179 - r and rel.Z < -89 + r then
		return true
	end
	-- chemins latéraux (x = ±39) et axe central jusqu'à la mairie
	if math.abs(rel.X) < 10 + r and rel.Z > -100 - r and rel.Z < -60 + r then
		return true
	end
	if math.abs(math.abs(rel.X) - 39) < 4 + r and rel.Z > -100 - r and rel.Z < -70 + r then
		return true
	end
	return false
end

local function lifeParks(geo: TownKit.Geo, r0: number): { any }
	local O = geo.Origin
	local placedList = {}
	local wanted = {
		{ Kind = "MarketSquare", R = 15, Count = 1 },
		{ Kind = "Statue", R = 6, Count = 2 },
		{ Kind = "ChessTables", R = 6, Count = 1 },
		{ Kind = "Statue", R = 6, Count = 1 },
	}
	local salt = 0
	for _, w in ipairs(wanted) do
		local placed = 0
		for _ = 1, 500 do
			if placed >= w.Count then
				break
			end
			salt += 1
			local a = hash(salt, 91) * math.pi * 2
			local r = r0 + w.R + math.sqrt(hash(salt, 92)) * (geo.Inner - r0 - 2 * w.R - 6)
			local p = O + Vector3.new(math.sin(a) * r, 0, math.cos(a) * r)
			if geo.IsFree(p, w.R) and not inKeepOut(geo, p, w.R) then
				-- (tourné vers le centre de la ville)
				local cf = CFrame.lookAt(p + Vector3.new(0, GROUND_Y, 0), Vector3.new(O.X, O.Y + GROUND_Y, O.Z))
				TownKit.LifeSpot(w.Kind, cf, salt)
				geo.Reserve(p, w.R)
				placed += 1
				table.insert(placedList, { Pos = p, R = w.R, Name = w.Kind, Dest = w.Kind == "MarketSquare" and 16 or nil })
			end
		end
	end
	return placedList
end

----------------------------------------------------------------------
-- (v9.9, CITY99) PLUS DE ZONE MORTE : nouveaux lieux dans les coins vides
-- de l'anneau (construits côté client : TownDistricts, via TownStreetLife)
-- et ALLÉES qui relient chaque lieu au réseau (trottoirs du boulevard,
-- des rues, allées existantes) : on n'arrive plus nulle part par la pelouse.
----------------------------------------------------------------------

-- La place la plus VIDE de l'anneau intérieur pour un objet de rayon `r`
-- (le plus loin possible de tout ce qui est déjà réservé)
local function emptiest(geo: TownKit.Geo, r: number, r0: number): Vector3?
	local O = geo.Origin
	local best, bestScore = nil, -math.huge
	local rMin, rMax = r0 + r, geo.Inner - r - 4
	if rMax < rMin then
		return nil
	end
	for deg = 0, 358, 2 do
		local ang = math.rad(deg)
		local d = rMin
		while d <= rMax do
			local p = O + Vector3.new(math.sin(ang) * d, 0, math.cos(ang) * d)
			if geo.IsFree(p, r) and not inKeepOut(geo, p, r) then
				local clear = 60
				for _, z in ipairs(geo.Reserved) do
					local dd = Vector3.new(p.X - z.P.X, 0, p.Z - z.P.Z).Magnitude - z.R - r
					if dd < clear then
						clear = dd
					end
				end
				if clear > bestScore then
					best, bestScore = p, clear
				end
			end
			d += 4
		end
	end
	return best
end

type Feature = { Pos: Vector3, R: number, Name: string, Dest: number?, Sign: boolean? }
type Seg = { A: Vector3, B: Vector3 }

-- Réseau piéton existant (segments au sol)
local function networkSegments(geo: TownKit.Geo, footpaths: { Seg }): { Seg }
	local segs: { Seg } = {}
	local O = geo.Origin
	local m = geo.Slots
	-- trottoir intérieur du boulevard (polygone, au milieu du trottoir)
	local rv = (geo.Inner + 1.5) / math.cos(geo.HalfAngle)
	for k = 0, m - 1 do
		local a1 = geo.SlotAngle(k) - geo.HalfAngle
		local a2 = geo.SlotAngle(k) + geo.HalfAngle
		table.insert(segs, { A = O + Vector3.new(math.sin(a1) * rv, 0, math.cos(a1) * rv), B = O + Vector3.new(math.sin(a2) * rv, 0, math.cos(a2) * rv) })
	end
	-- trottoirs extérieurs des rues radiales
	for _, slot in ipairs(geo.Streets) do
		local d = geo.Dir(geo.SlotAngle(slot))
		local side = Vector3.new(d.Z, 0, -d.X)
		local w = slot == 0 and 20 or 12
		for _, sx in ipairs({ -1, 1 }) do
			table.insert(segs, { A = O + d * geo.StreetStart + side * (sx * w), B = O + d * geo.Inner + side * (sx * w) })
		end
	end
	for _, f in ipairs(footpaths) do
		table.insert(segs, f)
	end
	return segs
end

local function closestOnSeg(a: Vector3, b: Vector3, p: Vector3): Vector3
	local ab = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
	local t = ab.Magnitude > 1e-3 and math.clamp(Vector3.new(p.X - a.X, 0, p.Z - a.Z):Dot(ab) / ab:Dot(ab), 0, 1) or 0
	return Vector3.new(a.X, 0, a.Z) + ab * t
end

-- Relie `f` au réseau par l'allée pavée la plus courte qui ne traverse rien
-- (réserves des autres lieux, rues) ; renvoie le point d'arrivée ou nil
local function connect(geo: TownKit.Geo, segs: { Seg }, f: Feature, seed: number): Vector3?
	local p = Vector3.new(f.Pos.X, 0, f.Pos.Z)
	local best: { Vector3 }? = nil
	local bestLen = math.huge
	-- (le point le plus proche de chaque segment, puis des points décalés
	-- le long du segment : une allée en biais contourne un obstacle)
	local cands = {}
	for _, sgm in ipairs(segs) do
		local q0 = closestOnSeg(sgm.A, sgm.B, p)
		local a0 = Vector3.new(sgm.A.X, 0, sgm.A.Z)
		local ab = Vector3.new(sgm.B.X - sgm.A.X, 0, sgm.B.Z - sgm.A.Z)
		local L = ab.Magnitude
		table.insert(cands, q0)
		if L > 1 then
			local t0 = (q0 - a0).Magnitude
			for _, dt in ipairs({ -8, 8, -16, 16, -26, 26 }) do
				local t = t0 + dt
				if t > 0 and t < L then
					table.insert(cands, a0 + ab.Unit * t)
				end
			end
		end
	end
	for _, q in ipairs(cands) do
		local dir = q - p
		local len = dir.Magnitude
		if len > f.R + 1 and len - f.R < bestLen and len - f.R < 130 then
			local e = p + dir.Unit * (f.R - 0.5)
			-- libre : aucune autre réserve traversée, ni rue (sauf aux deux bouts)
			local ok = true
			local total = (q - e).Magnitude
			local t = 2
			while t < total - 4 do
				local x = e + (q - e).Unit * t
				local wx = Vector3.new(x.X, geo.Origin.Y, x.Z)
				if not geo.IsFree(wx, 1.2) then
					-- (IsFree regarde aussi les réserves : on ignore celle du lieu lui-même)
					local own = true
					for _, z in ipairs(geo.Reserved) do
						local dz = Vector3.new(x.X - z.P.X, 0, x.Z - z.P.Z).Magnitude
						if dz < z.R + 1.2 and Vector3.new(z.P.X - p.X, 0, z.P.Z - p.Z).Magnitude > f.R + 1 then
							own = false
							break
						end
					end
					local flatX = Vector3.new(x.X - geo.Origin.X, 0, x.Z - geo.Origin.Z)
					local street = false
					for _, slot in ipairs(geo.Streets) do
						local d = geo.Dir(geo.SlotAngle(slot))
						local along = flatX:Dot(d)
						local sideD = math.abs(flatX.X * d.Z - flatX.Z * d.X)
						if along > 0 and sideD < (slot == 0 and 22 or 14) then
							street = true
							break
						end
					end
					if not own or street or flatX.Magnitude < WorldLayout.PLAZA_R + 26 or geo.PolyRadius(wx) > geo.Inner - 2 then
						ok = false
						break
					end
				end
				t += 2
			end
			if ok then
				best = { e, q }
				bestLen = len - f.R
			end
		end
	end
	if not best then
		return nil
	end
	local e, q = best[1], best[2]
	local y = geo.Origin.Y + GROUND_Y
	local total = (q - e).Magnitude
	local n = math.max(1, math.ceil(total / 30))
	for i = 0, n - 1 do
		local a = e:Lerp(q, i / n)
		local b = e:Lerp(q, (i + 1) / n)
		local mid = (a + b) / 2
		local cf = CFrame.lookAt(Vector3.new(mid.X, y, mid.Z), Vector3.new(b.X, y, b.Z)) * CFrame.Angles(0, math.pi / 2, 0)
		TownKit.LifeSpot("Walkway", cf, seed * 10 + i, Vector3.new((b - a).Magnitude + 0.02, 2, 4.5))
	end
	for t = 0, total, 5 do
		local x = e:Lerp(q, t / math.max(total, 1))
		geo.Reserve(Vector3.new(x.X, geo.Origin.Y, x.Z), 3)
	end
	table.insert(segs, { A = e, B = q })
	-- poteau indicateur au départ de l'allée (côté réseau)
	if f.Sign then
		local side = Vector3.new(-(q - e).Unit.Z, 0, (q - e).Unit.X)
		local at = q - (q - e).Unit * 3 + side * 3.4
		TownKit.LifeSpot("Direction", CFrame.new(Vector3.new(at.X, y, at.Z)), seed)
	end
	return q
end

----------------------------------------------------------------------
-- Construction
----------------------------------------------------------------------

function TownNature.Build(folder: Instance, geo: TownKit.Geo): number
	local nature = Instance.new("Folder")
	nature.Name = "Nature"
	nature.Parent = folder
	local O = geo.Origin
	-- pré (sous tout le reste) et murs invisibles
	-- (v9.8, CITY98) 4 quarts de 2048 x 2048 (taille maximale d'une pièce)
	-- au lieu d'un disque de rayon 1000 : les montagnes et la ville
	-- lointaine des grandes villes (12 parcelles, jusqu'à ~1050 studs) ne
	-- dépassent plus du pré. Côtés jointifs, sans chevauchement.
	for _, qx in ipairs({ -1, 1 }) do
		for _, qz in ipairs({ -1, 1 }) do
			part(nature, "Meadow", Vector3.new(2048, 4, 2048), CFrame.new(O + Vector3.new(qx * 1024, GROUND_Y - 2, qz * 1024)), C.Grass, M.Grass, "solid")
		end
	end
	local walls = 40
	for i = 1, walls do
		local a = (i - 0.5) / walls * math.pi * 2
		local p = O + Vector3.new(math.sin(a) * geo.Town, 30, math.cos(a) * geo.Town)
		part(nature, "Edge", Vector3.new(2 * math.pi * geo.Town / walls + 4, 64, 2), CFrame.lookAt(p, O + Vector3.new(0, 30, 0)), C.White, M.SmoothPlastic, "ghost")
	end
	-- quartiers de l'anneau
	local aR = geo.SlotAngle(geo.SideR)
	local aL = geo.SlotAngle(geo.SideL)
	local r0 = WorldLayout.PLAZA_R + 30
	local depth = geo.Inner - r0
	local mid = r0 + depth / 2
	local function frame(angle: number, dist: number): CFrame
		local p = geo.At(angle, dist)
		return CFrame.lookAt(p, Vector3.new(O.X, p.Y, O.Z))
	end
	-- (v9.7) un seul grand plan d'eau, un peu plus large que l'ancien disque
	local lakeR = math.min(math.clamp(depth / 2 - 12, 20, 42) * 1.15, depth / 2 - 18)
	local lakeAngle, lakeDist = (aR + math.pi) / 2 + 0.05, mid + 4
	local bridgeFoot = lake(nature, geo, geo.At(lakeAngle, lakeDist), lakeR)
	local anchors = {
		{ lakeAngle, lakeDist - lakeR - 4, bridgeFoot },
		{ aR * 0.42, r0 + 22 - 16 },
		{ (aL + math.pi * 2) / 2, r0 + 24 - 18 },
		{ (math.pi + aL) / 2 + 0.06, r0 + 22 - 14 },
	}
	-- (v9.9, CITY99) lieux à relier au réseau par une allée + repères des
	-- poteaux indicateurs
	local features: { Feature } = {}
	local function faceCenter(p: Vector3): CFrame
		return CFrame.lookAt(p, Vector3.new(O.X, p.Y, O.Z))
	end
	playground(nature, geo, frame(aR * 0.42, r0 + 22))
	TownKit.LifeSpot("Dest", frame(aR * 0.42, r0 + 22), 5)
	local picnicCF = frame(aR * 0.62, math.min(geo.Inner - 14, r0 + 50))
	picnic(nature, geo, picnicCF, 3)
	table.insert(features, { Pos = picnicCF.Position, R = 9, Name = "Picnic" })
	market(nature, geo, frame((aL + math.pi * 2) / 2, r0 + 24))
	TownKit.LifeSpot("Dest", frame((aL + math.pi * 2) / 2, r0 + 24), 16)
	-- (v9.9, FAIR99 : la fête foraine réserve ses nouveaux manèges AVANT la
	-- nature ; jardin fleuri et terrain de basket vont ailleurs si leur place
	-- est prise)
	local gardenCF = frame((math.pi + aL) / 2 + 0.06, r0 + 22)
	local gardenMoved = false
	if not geo.IsFree((gardenCF * CFrame.new(0, 0, 3)).Position, 16) then
		local p = emptiest(geo, 16, r0)
		if p then
			gardenCF = faceCenter(p) * CFrame.new(0, 0, -3)
			gardenMoved = true
		else
			gardenCF = nil :: any
		end
	end
	if gardenCF then
		flowerGarden(nature, geo, gardenCF)
		TownKit.LifeSpot("Dest", gardenCF, 14)
		if gardenMoved then
			table.insert(features, { Pos = (gardenCF * CFrame.new(0, 0, 3)).Position, R = 16, Name = "FlowerGarden", Sign = true })
		end
	end
	if depth > 70 then
		local courtCF = frame((math.pi + aL) / 2 - 0.05, geo.Inner - 18)
		if not geo.IsFree(courtCF.Position, 17) then
			local p = emptiest(geo, 17, r0)
			courtCF = p and faceCenter(p) or nil :: any
		end
		if courtCF then
			court(nature, geo, courtCF)
			table.insert(features, { Pos = courtCF.Position, R = 17, Name = "Court", Dest = 12 })
		end
	end
	-- grandes villes : terrain de foot + champ de tulipes là où il y a de la place
	if depth > 110 then
		local soccerDone = false
		for _, spot in ipairs({ { (aL + math.pi * 2) / 2 + 0.04, geo.Inner - 34 }, { aR * 0.55, geo.Inner - 34 }, { (aR + math.pi) / 2, geo.Inner - 30 } }) do
			local p = geo.At(spot[1], spot[2])
			if geo.IsFree(p, 26) then
				soccer(nature, geo, frame(spot[1], spot[2]))
				TownKit.LifeSpot("Dest", frame(spot[1], spot[2]), 12)
				table.insert(anchors, { spot[1], spot[2] - 24 })
				soccerDone = true
				break
			end
		end
		-- (v9.9, CITY99) places prévues prises (nouveaux manèges de la fête) :
		-- le terrain de foot va dans le coin le plus vide, relié par une allée
		if not soccerDone then
			local p = emptiest(geo, 26, r0)
			if p then
				local cf = faceCenter(p + Vector3.new(0, 0, 0))
				soccer(nature, geo, cf)
				TownKit.LifeSpot("Dest", cf, 12)
				table.insert(features, { Pos = p, R = 23, Name = "Soccer", Sign = true })
			end
		end
		for _, spot in ipairs({ { aR * 0.3, geo.Inner - 30 }, { (math.pi + aL) / 2 - 0.1, mid + 10 }, { (aL + math.pi * 2) / 2 - 0.12, mid + 16 } }) do
			local p = geo.At(spot[1], spot[2])
			if geo.IsFree(p, 22) then
				tulips(nature, geo, frame(spot[1], spot[2]))
				table.insert(features, { Pos = p, R = 14, Name = "Tulips" })
				break
			end
		end
	end
	-- allées en gravier : de l'arrière des boutiques de la place vers chaque lieu
	local paths = TownKit.Model(nature, "Footpaths")
	local footSegs: { Seg } = {}
	for i, anchor in ipairs(anchors) do
		-- (v9.9 : pas d'allée vers l'ancienne place du jardin fleuri s'il a bougé)
		if not (i == 4 and (gardenMoved or not gardenCF)) then
			local a0, b0 = geo.At(anchor[1], r0 - 1), anchor[3] or geo.At(anchor[1], anchor[2])
			footpath(paths, geo, a0, b0, i)
			table.insert(footSegs, { A = Vector3.new(a0.X, 0, a0.Z), B = Vector3.new(b0.X, 0, b0.Z) })
		end
	end
	-- (v9.7) kiosque du parc + massif fleuri et buissons au départ des allées
	for _, spot in ipairs({ { aR * 0.86, r0 + 18 }, { lakeAngle - 0.3, r0 + 14 }, { aR * 0.2, r0 + 44 } }) do
		local p = geo.At(spot[1], spot[2])
		if geo.IsFree(p, 11) then
			gazebo(nature, geo, frame(spot[1], spot[2]))
			table.insert(features, { Pos = p, R = 8, Name = "Gazebo" })
			break
		end
	end
	local greens = TownKit.Model(nature, "ParkGreens")
	for i, anchor in ipairs(anchors) do
		for _, s in ipairs({ -1, 1 }) do
			local p = geo.At(anchor[1] + s * 0.05, r0 + 4)
			if i == 1 and s > 0 and geo.IsFree(p, 5) then
				TownKit.FlowerBed(greens, p + Vector3.new(0, GROUND_Y - 0.3, 0), 3.4, 40 + i)
				geo.Reserve(p, 5)
			elseif geo.IsFree(p, 3) then
				TownKit.Bush(greens, p + Vector3.new(0, GROUND_Y, 0), 2.4 + hash(i, s + 3), 30 + i * 2 + s, (i + s) % 2 == 0 and TownKit.FLOWERS[i % #TownKit.FLOWERS + 1] or nil)
				geo.Reserve(p, 3)
			end
		end
	end
	-- (v9.8, CITY98) statues, petit marché, tables d'échecs (construits côté client)
	for _, f in ipairs(lifeParks(geo, r0)) do
		table.insert(features, f)
	end
	-- (v9.9, CITY99) NOUVEAUX LIEUX dans les coins les plus vides : skatepark,
	-- jardins partagés, coin ping-pong / pétanque / fitness (client : TownDistricts)
	for i, d in ipairs({
		{ Kind = "SkatePark", R = 19, Dest = 9 },
		{ Kind = "CommunityGarden", R = 17, Dest = 10 },
		{ Kind = "SportsCorner", R = 15, Dest = 17 },
	}) do
		local p = emptiest(geo, d.R, r0)
		if p then
			local cf = faceCenter(p + Vector3.new(0, GROUND_Y, 0))
			TownKit.LifeSpot(d.Kind, cf, 900 + i)
			geo.Reserve(p, d.R)
			table.insert(features, { Pos = p, R = d.R, Name = d.Kind, Dest = d.Dest, Sign = true })
		end
	end
	-- repères des lieux (poteaux indicateurs) : lac, fête foraine
	TownKit.LifeSpot("Dest", CFrame.new(geo.At(lakeAngle, lakeDist)), 4)
	local fairCF = WorldLayout.FairCFrame()
	TownKit.LifeSpot("Dest", fairCF * CFrame.new(0, 0, -WorldLayout.FAIR_D / 2), 2)
	-- ALLÉES : chaque lieu est relié au réseau (du plus proche au plus loin)
	local segs = networkSegments(geo, footSegs)
	table.sort(features, function(a, b)
		return (a.Pos - O).Magnitude < (b.Pos - O).Magnitude
	end)
	local linked = 0
	local unlinked = {}
	for i, f in ipairs(features) do
		if f.Dest then
			TownKit.LifeSpot("Dest", CFrame.new(f.Pos), f.Dest)
		end
		if connect(geo, segs, f, 950 + i) then
			linked += 1
		else
			table.insert(unlinked, f.Name)
		end
	end
	nature:SetAttribute("Linked", linked)
	nature:SetAttribute("Unlinked", table.concat(unlinked, ","))
	nature:SetAttribute("Features", #features)
	local trees = scatterTrees(nature, geo, math.clamp(math.floor(depth * 0.28), 22, geo.Slots >= 11 and 46 or 36))
	belt(nature, geo)
	hills(nature, geo)
	TownBuildings.Skyline(nature, O, math.rad(125), math.rad(235), math.min(geo.Town, 1520) + 320, 20) -- (v10 : borné au pré)
	-- (v9.8, CITY98) publie les emplacements du mobilier client + chemins des passants
	TownKit.PublishLife(folder.Parent or folder)
	return trees
end

return TownNature
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="392">
          <Properties>
            <string name="Name">TownNetwork</string>
            <string name="Source"><![CDATA[--[[
	TownNetwork (ModuleScript)
	Emplacement : ServerScriptService > Services > World > TownNetwork

	🛣️ (v10, LAYOUT10) Le RÉSEAU ROUTIER de la grande ville, côté SERVEUR :
	uniquement les coques PHYSIQUES (on roule / on marche dessus), en peu de
	pièces, construites une fois depuis WorldLayout.RoadGraph :
	  - avenues, ceinture, rues des quartiers, route de l'entrée, rue du
	    marché : chaussée (Asphalt) + trottoirs surélevés (dessus WALK_Y) ;
	    un carré d'asphalte à chaque carrefour, des coins de trottoir, et le
	    trottoir continue devant les carrefours en T ;
	  - AUTOROUTE (anneau, 2 x 2 voies, HIGHWAY_W) : dalles le long de l'axe
	    (virages en cordes qui se chevauchent, hauteurs alternées de 0,03
	    pour éviter tout z-fight) ;
	  - bretelles (1 voie, 0,06 au-dessus : raccord sans marche sensible) ;
	  - 4 PONTS des échangeurs : tablier qui suit WorldLayout.BridgeProfile
	    (mêmes stations que le graphe : les voitures de la circulation roulent
	    dessus), garde-corps sur la partie haute, culées + pile centrale ;
	  - ronds-points au bout des routes extérieures (aire de repos / belvédères) ;
	  - PLATEAU de la colline des manoirs (WorldLayout District.Plateau).
	Les rues du centre-ville (avenue "rambla", rues latérales) restent celles
	de TownStreets (arêtes "Downtown" : sautées ici).
	Tout le détail visuel est CÔTÉ CLIENT : ici on publie seulement les
	emplacements TownKit.LifeSpot "RoadSurface" / "CurbLine" / "Pavers"
	(tronçons de 40 studs, format de TownRoads, CITY) et "Zebra" (passages
	piétons de WorldLayout.RoadGraph.Crossings). Marquages, glissières,
	lampadaires, portiques, murs antibruit, piles décorées : CITY10.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WorldLayout = require(ReplicatedStorage.Shared.WorldLayout)
local TownKit = require(script.Parent.TownKit)

local TownNetwork = {}

local M = TownKit.M
local C = TownKit.C
local part = TownKit.Part

local ROAD_Y = WorldLayout.ROAD_Y
local WALK_Y = WorldLayout.WALK_Y
local GROUND_Y = WorldLayout.GROUND_Y
local ROAD_T = 0.7 -- épaisseur de la chaussée (comme TownStreets)
local WALK_T = 1.3 -- épaisseur des trottoirs
local CHUNK = 40
local CURB_H = WALK_Y + 0.03 - ROAD_Y

-- Demi-largeurs RÉELLES des rues du centre-ville (TownStreets) : avenue
-- "rambla" (voies jusqu'à 15) et rues latérales (8)
local DOWNTOWN_HALF_AVENUE = 15
local DOWNTOWN_HALF_STREET = 8

type Node = WorldLayout.RoadNode
type Edge = WorldLayout.RoadEdge

-- Bras d'un carrefour : direction (unité, à plat) depuis le nœud, demi-largeur, trottoir
type Arm = { Edge: Edge, DX: number, DZ: number, Half: number, Walk: number, Special: boolean }

local function flatDir(a: WorldLayout.RoadPoint, b: WorldLayout.RoadPoint): (number, number, number)
	local dx, dz = b.X - a.X, b.Z - a.Z
	local len = math.sqrt(dx * dx + dz * dz)
	if len < 1e-6 then
		return 0, -1, 0
	end
	return dx / len, dz / len, len
end

local function isDowntown(e: Edge): boolean
	return e.Kind == "Downtown"
end

-- Demi-largeur physique d'une arête (rues du centre-ville : TownStreets)
local function halfOf(e: Edge): number
	if e.Kind == "Downtown" then
		local p1, p2 = e.Points[1], e.Points[#e.Points]
		-- (avenue d'entrée sur l'axe x = 0 ; rues latérales sur z = 0)
		if math.abs(p1.X) < 1 and math.abs(p2.X) < 1 then
			return DOWNTOWN_HALF_AVENUE
		end
		return DOWNTOWN_HALF_STREET
	end
	return e.Width / 2
end

-- Repère au sol au point `p` (repère ville), X le long de (dx, dz)
local function alongFrame(p: WorldLayout.RoadPoint, dx: number, dz: number, y: number?): CFrame
	local base = WorldLayout.CityPoint(p.X, y or 0, p.Z)
	return CFrame.lookAt(base, base + Vector3.new(dz, 0, -dx))
end

-- Tronçons client (TownRoads) : un emplacement `kind` tous les <= 40 studs
local function chunks(kind: string, F: CFrame, x0: number, x1: number, y: number, z: number, sy: number, sz: number, seed: number, turn: boolean?)
	local len = x1 - x0
	if len <= 1 then
		return
	end
	local n = math.max(1, math.ceil(len / CHUNK))
	for i = 0, n - 1 do
		local a = x0 + i * len / n
		local cf = F * CFrame.new(a + len / n / 2, y, z)
		if turn then
			cf = cf * CFrame.Angles(0, math.pi, 0)
		end
		TownKit.LifeSpot(kind, cf, seed + i * 7, Vector3.new(len / n, sy, sz))
	end
end

-- Dalle entre deux points (repère ville), dessus à la hauteur des points
-- + `lift`, largeur `w`, épaisseur `t` ; `ext0` / `ext1` : allongement aux bouts
local function slab(parent: Instance, name: string, a: WorldLayout.RoadPoint, b: WorldLayout.RoadPoint, w: number, t: number, lift: number, color: Color3, material: Enum.Material, profile: string, ext0: number?, ext1: number?): BasePart?
	local pa = WorldLayout.CityPoint(a.X, a.Y + lift, a.Z)
	local pb = WorldLayout.CityPoint(b.X, b.Y + lift, b.Z)
	local d = pb - pa
	local len = d.Magnitude
	if len < 0.2 then
		return nil
	end
	local u = d / len
	local e0, e1 = ext0 or 0, ext1 or 0
	pa -= u * e0
	pb += u * e1
	local mid = (pa + pb) / 2
	-- repère : -Z le long de la route, Y ~ vers le haut (perpendiculaire à la pente)
	local look = CFrame.lookAt(mid, pb)
	local up = look.UpVector
	local center = mid - up * (t / 2)
	return part(parent, name, Vector3.new(w, t, len + e0 + e1), CFrame.lookAt(center, center + look.LookVector, up), color, material, profile)
end

-- Point décalé latéralement (à droite du sens a -> b) de `off`
local function offsetPoint(p: WorldLayout.RoadPoint, dx: number, dz: number, off: number): WorldLayout.RoadPoint
	-- droite de (dx, dz) = (-dz, dx)
	return { X = p.X - dz * off, Y = p.Y, Z = p.Z + dx * off }
end

-- Polyligne coupée : garde la partie entre les abscisses s0 et s1 (à plat)
local function trimPolyline(points: { WorldLayout.RoadPoint }, s0: number, s1: number): { WorldLayout.RoadPoint }
	local out: { WorldLayout.RoadPoint } = {}
	local acc = 0
	for i = 2, #points do
		local a, b = points[i - 1], points[i]
		local _, _, len = flatDir(a, b)
		local segA, segB = acc, acc + len
		if segB > s0 and segA < s1 and len > 1e-6 then
			local t0 = math.clamp((s0 - segA) / len, 0, 1)
			local t1 = math.clamp((s1 - segA) / len, 0, 1)
			local function lerp(t: number): WorldLayout.RoadPoint
				return { X = a.X + (b.X - a.X) * t, Y = a.Y + (b.Y - a.Y) * t, Z = a.Z + (b.Z - a.Z) * t }
			end
			if #out == 0 then
				table.insert(out, lerp(t0))
			end
			table.insert(out, lerp(t1))
		end
		acc = segB
	end
	return out
end

local function flatLength(points: { WorldLayout.RoadPoint }): number
	local len = 0
	for i = 2, #points do
		local _, _, l = flatDir(points[i - 1], points[i])
		len += l
	end
	return len
end

----------------------------------------------------------------------
-- Carrefours
----------------------------------------------------------------------

type Box = { HX: number, HZ: number, Walk: number, Arms: { Arm }, NoWalk: boolean, Build: boolean }

local function armsOf(graph: WorldLayout.RoadGraph): { [string]: { Arm } }
	local arms: { [string]: { Arm } } = {}
	for _, e in ipairs(graph.Edges) do
		if not e.Highway and e.Kind ~= "Roundabout" then
			for _, endId in ipairs({ e.A, e.B }) do
				local pts = WorldLayout.EdgePoints(e, endId)
				local dx, dz = flatDir(pts[1], pts[2])
				arms[endId] = arms[endId] or {}
				table.insert(arms[endId], {
					Edge = e,
					DX = dx,
					DZ = dz,
					Half = halfOf(e),
					Walk = e.Sidewalk,
					Special = e.Ramp or e.Bridge,
				})
			end
		end
	end
	return arms
end

local function boxOf(node: Node, arms: { Arm }): Box
	local hx, hz, walk = 0, 0, 0
	local noWalk = false
	local build = false
	for _, arm in ipairs(arms) do
		-- (nœuds de l'autoroute : seulement des bretelles -> pas de carré)
		if arm.Edge.Kind ~= "Downtown" and not arm.Special then
			build = true
		end
		if arm.Special then
			noWalk = true
		elseif math.abs(arm.DZ) >= math.abs(arm.DX) then
			hx = math.max(hx, arm.Half) -- (bras nord-sud : largeur en x)
		else
			hz = math.max(hz, arm.Half)
		end
		walk = math.max(walk, arm.Walk)
	end
	if hx == 0 then
		hx = hz
	end
	if hz == 0 then
		hz = hx
	end
	return { HX = hx, HZ = hz, Walk = walk, Arms = arms, NoWalk = noWalk, Build = build and #arms >= 2 }
end

-- Longueur à retirer au bout d'une arête qui arrive dans le carré du carrefour
local function trimFor(box: Box?, arm: Arm): number
	if not box or not box.Build then
		return 0
	end
	if math.abs(arm.DZ) >= math.abs(arm.DX) then
		return box.HZ
	end
	return box.HX
end

local function buildJunction(parent: Instance, node: Node, box: Box)
	local cx, cz = node.X, node.Z
	local y = node.Y
	-- carré d'asphalte
	local p = WorldLayout.CityPoint(cx, y - ROAD_T / 2, cz)
	part(parent, "Junction", Vector3.new(2 * box.HX, ROAD_T, 2 * box.HZ), CFrame.new(p), C.Asphalt, M.Asphalt, "solid")
	if box.NoWalk or box.Walk <= 0 then
		return
	end
	local w = box.Walk
	local wy = y - ROAD_Y + WALK_Y
	-- coins de trottoir
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			local q = WorldLayout.CityPoint(cx + sx * (box.HX + w / 2), wy - WALK_T / 2, cz + sz * (box.HZ + w / 2))
			part(parent, "WalkCorner", Vector3.new(w, WALK_T, w), CFrame.new(q), C.Walk, M.Pavement, "solid")
		end
	end
	-- côtés sans bras : le trottoir continue devant le carrefour
	local has = { N = false, S = false, E = false, W = false }
	for _, arm in ipairs(box.Arms) do
		if math.abs(arm.DZ) >= math.abs(arm.DX) then
			if arm.DZ > 0 then
				has.S = true
			else
				has.N = true
			end
		else
			if arm.DX > 0 then
				has.E = true
			else
				has.W = true
			end
		end
	end
	if not has.S then
		part(parent, "WalkSide", Vector3.new(2 * box.HX, WALK_T, w), CFrame.new(WorldLayout.CityPoint(cx, wy - WALK_T / 2, cz + box.HZ + w / 2)), C.Walk, M.Pavement, "solid")
	end
	if not has.N then
		part(parent, "WalkSide", Vector3.new(2 * box.HX, WALK_T, w), CFrame.new(WorldLayout.CityPoint(cx, wy - WALK_T / 2, cz - box.HZ - w / 2)), C.Walk, M.Pavement, "solid")
	end
	if not has.E then
		part(parent, "WalkSide", Vector3.new(w, WALK_T, 2 * box.HZ), CFrame.new(WorldLayout.CityPoint(cx + box.HX + w / 2, wy - WALK_T / 2, cz)), C.Walk, M.Pavement, "solid")
	end
	if not has.W then
		part(parent, "WalkSide", Vector3.new(w, WALK_T, 2 * box.HZ), CFrame.new(WorldLayout.CityPoint(cx - box.HX - w / 2, wy - WALK_T / 2, cz)), C.Walk, M.Pavement, "solid")
	end
end

----------------------------------------------------------------------
-- Routes de la ville
----------------------------------------------------------------------

local graphNodes: { [string]: Node } = {}

local function buildCityEdge(parent: Instance, e: Edge, boxes: { [string]: Box }, arms: { [string]: { Arm } }, seed: number)
	local pts = e.Points
	local total = flatLength(pts)
	local armA, armB
	for _, arm in ipairs(arms[e.A] or {}) do
		if arm.Edge == e then
			armA = arm
		end
	end
	for _, arm in ipairs(arms[e.B] or {}) do
		if arm.Edge == e then
			armB = arm
		end
	end
	local s0 = armA and trimFor(boxes[e.A], armA) or 0
	local s1 = total - (armB and trimFor(boxes[e.B], armB) or 0)
	if s1 - s0 < 0.5 then
		return
	end
	local road = trimPolyline(pts, s0, s1)
	local half = e.Width / 2
	for i = 2, #road do
		slab(parent, "Asphalt", road[i - 1], road[i], e.Width, ROAD_T, 0, C.Asphalt, M.Asphalt, "solid")
	end
	-- trottoirs (raccourcis près des échangeurs : les bretelles arrivent au carrefour)
	local w = e.Sidewalk
	if w > 0 and not e.Bridge then
		-- (bretelles au carrefour, anneau d'un rond-point : trottoir arrêté avant)
		local function stop(id: string): number
			local node = graphNodes[id]
			if (boxes[id] and boxes[id].NoWalk) or (node and node.Kind == "Roundabout") then
				return 40
			end
			return 0
		end
		-- (coins de trottoir du carrefour : w x w au-delà du carré)
		local function corner(id: string): number
			local b = boxes[id]
			return (b and b.Build and not b.NoWalk and b.Walk > 0) and b.Walk or 0
		end
		local k0 = s0 + math.max(stop(e.A), corner(e.A))
		local k1 = s1 - math.max(stop(e.B), corner(e.B))
		if k1 - k0 > 1 then
			local walkPts = trimPolyline(pts, k0, k1)
			for i = 2, #walkPts do
				local a, b = walkPts[i - 1], walkPts[i]
				local dx, dz = flatDir(a, b)
				for _, side in ipairs({ -1, 1 }) do
					local off = side * (half + w / 2)
					slab(parent, "Sidewalk", offsetPoint(a, dx, dz, off), offsetPoint(b, dx, dz, off), w, WALK_T, WALK_Y - ROAD_Y, C.Walk, M.Pavement, "solid")
				end
			end
		end
	end
	-- détails client (seulement les tronçons à plat : les emplacements ne
	-- portent que le cap)
	for i = 2, #road do
		local a, b = road[i - 1], road[i]
		if math.abs(a.Y - b.Y) < 0.01 then
			local dx, dz, len = flatDir(a, b)
			local F = alongFrame(a, dx, dz, a.Y - ROAD_Y)
			chunks("RoadSurface", F, 1, len - 1, ROAD_Y, 0, 2, e.Width, seed * 100 + i)
			if w > 0 then
				-- (F : +Z = à DROITE du sens ; bordure de gauche retournée)
				chunks("CurbLine", F, 0, len, ROAD_Y, half - 0.05, CURB_H, 0, seed * 100 + 20 + i)
				chunks("CurbLine", F, 0, len, ROAD_Y, -half + 0.05, CURB_H, 0, seed * 100 + 40 + i, true)
				local wIn = w - 0.85
				chunks("Pavers", F, 1, len - 1, WALK_Y, half + 0.85 + wIn / 2, 0, wIn, seed * 100 + 60 + i)
				chunks("Pavers", F, 1, len - 1, WALK_Y, -half - 0.85 - wIn / 2, 0, wIn, seed * 100 + 80 + i)
			end
		end
	end
end

----------------------------------------------------------------------
-- Autoroute, bretelles, ponts
----------------------------------------------------------------------

-- Polyligne en dalles : chaque bout de dalle dépasse de w/2·tan(angle/2)
-- dans les virages (pas de trou au bord extérieur) ; hauteurs alternées
-- (0 / +0,03) pour que deux dalles qui se chevauchent ne soient jamais au
-- même niveau
local function polylineSlabs(parent: Instance, name: string, pts: { WorldLayout.RoadPoint }, w: number, t: number, lift: number, color: Color3, material: Enum.Material, parity0: number): number
	local n = #pts
	local count = 0
	local function turnAt(i: number): number
		if i <= 1 or i >= n then
			return 0
		end
		local ax, az = flatDir(pts[i - 1], pts[i])
		local bx, bz = flatDir(pts[i], pts[i + 1])
		local dot = math.clamp(ax * bx + az * bz, -1, 1)
		return math.acos(dot)
	end
	for i = 2, n do
		local e0 = w / 2 * math.tan(turnAt(i - 1) / 2) + (turnAt(i - 1) > 1e-3 and 0.2 or 0)
		local e1 = w / 2 * math.tan(turnAt(i) / 2) + (turnAt(i) > 1e-3 and 0.2 or 0)
		local parity = (parity0 + i) % 2
		if slab(parent, name, pts[i - 1], pts[i], w, t, lift + parity * 0.03, color, material, "solid", e0, e1) then
			count += 1
		end
	end
	return count
end

local function buildHighway(parent: Instance, graph: WorldLayout.RoadGraph, count: number)
	local model = TownKit.Model(parent, "Highway")
	-- l'anneau complet (une seule polyligne fermée, parité continue)
	local hw = WorldLayout.HighwayPath(count)
	-- (départ au milieu du côté sud, dans une ligne droite : aucun virage au raccord)
	local startP = { X = 0, Y = ROAD_Y, Z = WorldLayout.HighwayR(count) }
	local ordered: { WorldLayout.RoadPoint } = { startP }
	for i = 1, #hw do
		table.insert(ordered, hw[i])
	end
	table.insert(ordered, startP)
	polylineSlabs(model, "Carriageway", ordered, WorldLayout.HIGHWAY_W, 1, 0, C.Asphalt, M.Asphalt, 0)
	-- bretelles (0,06 au-dessus : jamais au niveau de l'autoroute ni du carrefour)
	for _, e in ipairs(graph.Edges) do
		if e.Ramp then
			polylineSlabs(model, "Ramp", e.Points, WorldLayout.RAMP_W, 1, 0.06, C.Asphalt, M.Asphalt, 0)
		end
	end
end

local function buildBridges(parent: Instance, graph: WorldLayout.RoadGraph)
	for _, e in ipairs(graph.Edges) do
		if e.Bridge then
			local model = TownKit.Model(parent, "Bridge")
			-- (les 10 premiers / derniers studs sont dans le carré des carrefours)
			local pts = trimPolyline(e.Points, 10, flatLength(e.Points) - 10)
			local deckW = e.Width + 2 * e.Sidewalk
			for i = 2, #pts do
				local a, b = pts[i - 1], pts[i]
				slab(model, "Deck", a, b, deckW, 1.2, 0, C.Asphalt, M.Asphalt, "solid")
				-- garde-corps là où le tablier est haut (plus de 1,5 stud)
				if math.min(a.Y, b.Y) > ROAD_Y + 1.5 then
					local dx, dz = flatDir(a, b)
					for _, side in ipairs({ -1, 1 }) do
						-- (0,05 en retrait : aucune face confondue avec le chant du tablier)
						local off = side * (deckW / 2 - 0.45)
						slab(model, "Parapet", offsetPoint(a, dx, dz, off), offsetPoint(b, dx, dz, off), 0.8, 2.6, 2.6, C.Stone, M.Concrete, "solid")
					end
				end
			end
			-- culées (aux bouts du tablier plat) + pile sur le terre-plein central
			local mid = pts[math.floor(#pts / 2) + 1]
			local first, last = pts[1], pts[#pts]
			local dx, dz = flatDir(first, last)
			local half = WorldLayout.BRIDGE_HALF
			local top = ROAD_Y + WorldLayout.BRIDGE_Y - 1.2
			local cx, cz = (first.X + last.X) / 2, (first.Z + last.Z) / 2
			for _, n in ipairs({ -half + 1.6, 0, half - 1.6 }) do
				local h = top - GROUND_Y
				local q = WorldLayout.CityPoint(cx + dx * n, GROUND_Y + h / 2, cz + dz * n)
				local thick = n == 0 and 3 or 3.2
				part(model, n == 0 and "Pier" or "Abutment", Vector3.new(n == 0 and deckW - 6 or deckW, h - 0.02, thick), CFrame.lookAt(q, q + Vector3.new(dx, 0, dz)), C.StoneDark, M.Concrete, "solid")
			end
			local _ = mid
		end
	end
end

-- Ronds-points au bout des routes extérieures (asphalte + îlot)
local function buildRoundabouts(parent: Instance, count: number)
	for _, ix in ipairs(WorldLayout.INTERCHANGES) do
		local H = WorldLayout.HighwayR(count) + WorldLayout.OUTSIDE_END
		local p = WorldLayout.CityPoint(ix.NX * H, 0, ix.NZ * H)
		local model = TownKit.Model(parent, "Roundabout")
		-- (Disc : `center` = milieu du DESSUS)
		TownKit.Disc(model, "Ring", p + Vector3.new(0, ROAD_Y + 0.06, 0), 29, ROAD_T, C.Asphalt, M.Asphalt, "solid")
		TownKit.Disc(model, "Island", p + Vector3.new(0, WALK_Y + 0.06, 0), 14, WALK_T, C.Curb, M.Concrete, "solid")
		TownKit.Disc(model, "IslandGrass", p + Vector3.new(0, WALK_Y + 0.12, 0), 13, 0.2, C.Lawn, M.Grass, "deco")
		TownKit.LifeSpot("Roundabout", CFrame.new(p + Vector3.new(0, ROAD_Y + 0.06, 0)), 8100 + (ix.NX + 2) * 10 + ix.NZ, Vector3.new(14, 0, 29))
		TownKit.Tree(model, p + Vector3.new(0, WALK_Y + 0.2, 0), 15, 8200 + ix.NX * 3 + ix.NZ, "Cherry", { Tier = 1, Lawn = true })
	end
end

-- Plateau de la colline des manoirs (sol surélevé, sous les parcelles et les rues)
local function buildPlateaus(parent: Instance, count: number)
	for _, d in ipairs(WorldLayout.Districts(count)) do
		local p = d.Plateau
		if p and d.Rise > 0 then
			local model = TownKit.Model(parent, "Plateau_" .. d.Id)
			local top = GROUND_Y + d.Rise
			local h = top + 2 -- (enterré de 2 studs sous le pré)
			local q = WorldLayout.CityPoint(p.X, top - h / 2, p.Z)
			local ground = part(model, "Hill", Vector3.new(p.W, h, p.D), CFrame.new(q), C.Grass, M.Grass, "solid")
			ground:SetAttribute("District", d.Id)
			-- talus : 4 bords en pente douce (coins de roche)
			local slope = 6
			for _, side in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
				local sx, sz = side[1], side[2]
				local len = sx ~= 0 and p.D or p.W
				local cx = p.X + sx * (p.W / 2 + slope / 2)
				local cz = p.Z + sz * (p.D / 2 + slope / 2)
				local base = WorldLayout.CityPoint(cx, GROUND_Y + d.Rise / 2 - 0.05, cz)
				-- WedgePart : pente vers -Z local ; on tourne -Z vers l'extérieur
				local out = Vector3.new(sx, 0, sz)
				TownKit.Wedge(model, "Bank", Vector3.new(len, d.Rise - 0.1, slope), CFrame.lookAt(base, base + out), C.GrassDark, M.Grass, "solid")
			end
		end
	end
end

----------------------------------------------------------------------
-- Construction
----------------------------------------------------------------------

function TownNetwork.Build(folder: Instance, geo: TownKit.Geo): Folder
	local count = geo.Count
	local graph = WorldLayout.RoadGraph(count)
	graphNodes = graph.Nodes
	local root = Instance.new("Folder")
	root.Name = "Network"
	root.Parent = folder
	local before = TownKit.Stats.Parts
	buildPlateaus(root, count)
	local roads = TownKit.Model(root, "Roads")
	local arms = armsOf(graph)
	local boxes: { [string]: Box } = {}
	for id, list in pairs(arms) do
		local node = graph.Nodes[id]
		if node and node.Kind ~= "Roundabout" then
			local box = boxOf(node, list)
			boxes[id] = box
			if box.Build then
				buildJunction(roads, node, box)
			end
		end
	end
	for i, e in ipairs(graph.Edges) do
		if not e.Highway and not e.Ramp and not e.Bridge and e.Kind ~= "Roundabout" and not isDowntown(e) then
			buildCityEdge(roads, e, boxes, arms, 9000 + i)
		end
	end
	buildHighway(root, graph, count)
	buildBridges(root, graph)
	buildRoundabouts(root, count)
	-- passages piétons (client)
	for i, cr in ipairs(graph.Crossings) do
		local c, s = math.cos(cr.Yaw), math.sin(cr.Yaw)
		-- sens de la route = LookVector de Yaw ; la bande traverse la chaussée
		local ux, uz = -s, -c
		local p = WorldLayout.CityPoint(cr.X, cr.Y, cr.Z)
		TownKit.LifeSpot("Zebra", CFrame.lookAt(p, p + Vector3.new(-uz, 0, ux)), math.floor(cr.Length * 10 + 0.5) + 0 * i)
	end
	root:SetAttribute("Parts", TownKit.Stats.Parts - before)
	root:SetAttribute("Edges", #graph.Edges)
	return root
end

return TownNetwork
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="393">
          <Properties>
            <string name="Name">TownPark</string>
            <string name="Source"><![CDATA[--[[
	TownPark (ModuleScript)
	Emplacement : ServerScriptService > Services > World > TownPark

	🛝 Aire de jeux de Dopamine Town, côté SERVEUR (v9.9, PARK99).
	Le serveur ne pose que le SQUELETTE qui doit exister pour tout le monde :
	  - le sol souple, les murs invisibles de la clôture (portillon côté place),
	    les volumes où l'on marche (plancher de la tour, glissière, tourniquet,
	    corps des jeux à ressort) et un mur d'escalade (TrussPart invisible :
	    on y grimpe "pour de vrai", comme une échelle Roblox) ;
	  - les SIÈGES (Seat invisibles, ancrés) des jeux qui bougent : 3
	    balançoires, 2 places du tape-cul, 4 du tourniquet, 2 jeux à ressort,
	    et les 2 bancs des parents (2 places chacun) ;
	  - les invites (E) : "Se balancer" / "Monter" / "S'asseoir" sur les
	    sièges (le serveur assoit : Seat:Sit), et "Glisser" / "Traverser" /
	    "Creuser" sur des repères invisibles (gérées par le CLIENT : ParkPlay
	    anime alors l'avatar : échelle + glissade, barres de singe, pelle).
	Tout le décor réaliste (portique, chaînes, tour, glissière, chevaux,
	clôture, bac à sable...) est construit côté CLIENT près de l'avatar
	(ParkPlay, appelé par TownGreenery : attribut NearDetail "Playground").

	Mouvement : quand le 1er enfant monte sur un jeu (ou le dernier descend),
	le serveur pose sur le Model du jeu les attributs On / T0 / A0 / W0
	(ParkMotion.Transition) ; chaque client en déduit la même pose, à chaque
	image, et déplace localement le siège (l'avatar assis suit, sans à-coup).

	+ TownPark.BenchPrompts(folder) : invite "S'asseoir" (E) sur les bancs du
	  parc (Models "Bench" de TownKit.Bench sous `folder`).

	API (TownNature.playground) :
	  TownPark.Build(model, g)   g = centre de l'aire au sol, -Z vers la place
	  TownPark.BenchPrompts(folder)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ParkMotion = require(ReplicatedStorage.Shared.ParkMotion)
local TownKit = require(script.Parent.TownKit)

local TownPark = {}

local M = TownKit.M
local part = TownKit.Part

local PROMPT_RANGE = 8
local SIT_RANGE = 14 -- (studs) l'avatar doit être tout près
local COOLDOWN = 0.5 -- (s) entre deux demandes d'un même joueur
local RUBBER = Color3.fromRGB(214, 112, 96)

local lastAsk: { [Player]: number } = {}

local function serverNow(): number
	return workspace:GetServerTimeNow()
end

-- Pièce invisible (repère, siège) : ni vue, ni visée, ni touchée
local function hidden(p: BasePart): BasePart
	p.Transparency = 1
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	return p
end

-- Invite (textes anglais ; ParkPlay les traduit : attributs LocAction / LocObject)
local function prompt(host: BasePart, action: string, object: string, kind: string?): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.Name = "ParkPrompt"
	p.ActionText = action
	p.ObjectText = object
	p.KeyboardKeyCode = Enum.KeyCode.E
	p.HoldDuration = 0
	p.MaxActivationDistance = PROMPT_RANGE
	p.RequiresLineOfSight = false
	p.Style = Enum.ProximityPromptStyle.Default
	p:SetAttribute("LocAction", action)
	p:SetAttribute("LocObject", object)
	if kind then
		p:SetAttribute("ParkAction", kind)
	end
	p.Parent = host
	return p
end

local function characterOf(player: Player): (Model?, Humanoid?, BasePart?)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not character or not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
		return nil, nil, nil
	end
	return character, humanoid, root
end

----------------------------------------------------------------------
-- Jeux (Model + sièges) et leurs attributs de mouvement
----------------------------------------------------------------------

type Piece = { Model: Model, Kind: string, Seats: { Seat } }

local function writeState(model: Model, s: ParkMotion.State)
	model:SetAttribute("On", s.On)
	model:SetAttribute("T0", s.T0)
	model:SetAttribute("A0", s.A0)
	model:SetAttribute("W0", s.W0)
end

local function riders(piece: Piece): number
	local n = 0
	for _, seat in ipairs(piece.Seats) do
		if seat.Parent and seat.Occupant then
			n += 1
		end
	end
	return n
end

local function refresh(piece: Piece)
	if not piece.Model.Parent or piece.Kind == "Bench" then
		return
	end
	local on = riders(piece) > 0
	local s = ParkMotion.StateOf(piece.Model)
	if s.On ~= on then
		writeState(piece.Model, ParkMotion.Transition(piece.Kind, s, serverNow(), on))
	end
end

local function newPiece(parent: Instance, name: string, kind: string): Piece
	local model = Instance.new("Model")
	model.Name = name
	model:SetAttribute("ParkKind", kind)
	if kind ~= "Bench" then
		writeState(model, { On = false, T0 = 0, A0 = 0, W0 = 0 })
	end
	model.Parent = parent
	return { Model = model, Kind = kind, Seats = {} }
end

-- Siège invisible `slot` du jeu `piece`, dessus en `topCF` (repère monde)
local ACTIONS = {
	Swing = { "Swing", "Swing seat" },
	Seesaw = { "Ride", "Seesaw" },
	Merry = { "Ride", "Merry-go-round" },
	Spring = { "Ride", "Spring rider" },
	Bench = { "Sit", "Bench" },
}

local function addSeat(piece: Piece, slot: number, topCF: CFrame, size: Vector3)
	local seat = part(piece.Model, "ParkSeat", size, topCF * CFrame.new(0, -size.Y / 2, 0), Color3.fromRGB(255, 255, 255), M.SmoothPlastic, "deco", "Seat") :: Seat
	hidden(seat)
	seat:SetAttribute("ParkSlot", slot)
	if piece.Kind == "Bench" then
		seat:SetAttribute("SitKind", "bench") -- (SitAnimator : pose + attentes du banc)
	else
		seat:SetAttribute("SitKind", "ride")
		seat:SetAttribute("ParkPose", true) -- (ParkPlay anime l'enfant : mains sur les chaînes...)
	end
	table.insert(piece.Seats, seat)
	local texts = ACTIONS[piece.Kind] or ACTIONS.Bench
	local p = prompt(seat, texts[1], texts[2], "Sit")
	p.Triggered:Connect(function(player: Player)
		local now = os.clock()
		if lastAsk[player] and now - lastAsk[player] < COOLDOWN then
			return
		end
		lastAsk[player] = now
		local _, humanoid, root = characterOf(player)
		if not humanoid or not root or not seat.Parent or humanoid.SeatPart ~= nil or seat.Occupant ~= nil then
			return
		end
		if (root.Position - seat.Position).Magnitude > SIT_RANGE then
			return
		end
		pcall(seat.Sit, seat, humanoid)
	end)
	seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		refresh(piece)
	end)
end

-- Repère invisible d'une invite gérée par le client
local function anchor(model: Instance, name: string, cf: CFrame, action: string, object: string, kind: string, range: number?)
	local a = hidden(part(model, name, Vector3.new(1, 1, 1), cf, Color3.fromRGB(255, 255, 255), M.SmoothPlastic, "deco"))
	local p = prompt(a, action, object, kind)
	p.MaxActivationDistance = range or 6
	return a
end

----------------------------------------------------------------------
-- Construction
----------------------------------------------------------------------

function TownPark.Build(model: Model, g: CFrame)
	local W, D = ParkMotion.W, ParkMotion.D
	-- sol souple (dessus à FLOOR_TOP)
	part(model, "SoftFloor", Vector3.new(W, 0.3, D), g * CFrame.new(0, ParkMotion.FLOOR_TOP - 0.15, 0), RUBBER, M.Rubber, "solid")
	-- murs invisibles de la clôture (portillon ouvert face à la place)
	local hw, hd = W / 2 + 0.6, D / 2 + 0.6
	local gate = ParkMotion.GATE
	local function wall(a: Vector3, b: Vector3)
		local mid = (a + b) / 2
		local len = (b - a).Magnitude
		part(model, "FenceWall", Vector3.new(0.4, 2.8, len), g * CFrame.lookAt(mid + Vector3.new(0, 1.4, 0), b + Vector3.new(0, 1.4, 0)), Color3.fromRGB(255, 255, 255), M.SmoothPlastic, "ghost")
	end
	wall(Vector3.new(-hw, 0, hd), Vector3.new(hw, 0, hd))
	wall(Vector3.new(-hw, 0, -hd), Vector3.new(-hw, 0, hd))
	wall(Vector3.new(hw, 0, -hd), Vector3.new(hw, 0, hd))
	wall(Vector3.new(-hw, 0, -hd), Vector3.new(-gate - 0.3, 0, -hd))
	wall(Vector3.new(gate + 0.3, 0, -hd), Vector3.new(hw, 0, -hd))

	-- 🛝 toboggan : plancher de la tour, glissière (on peut marcher dessus),
	-- mur d'escalade (-X) grimpable, invites "Glisser"
	local S = ParkMotion.SLIDE
	local tower = g * ParkMotion.SlideTower()
	local slideModel = newPiece(model, "Slide", "Slide").Model
	local deck = part(slideModel, "TowerDeck", Vector3.new(S.Deck, 0.4, S.Deck), tower * CFrame.new(0, S.DeckTop - 0.2, 0), RUBBER, M.WoodPlanks, "ghost")
	deck.CanQuery = true
	local P = S.Profile
	local zA, yA = P[3][1], P[3][2]
	local zB, yB = P[4][1], P[4][2]
	local a = tower * Vector3.new(0, yA - 0.2, zA)
	local b = tower * Vector3.new(0, yB - 0.2, zB)
	part(slideModel, "ChuteSlope", Vector3.new(1.8, 0.3, (b - a).Magnitude + 0.6), CFrame.lookAt((a + b) / 2, b), RUBBER, M.SmoothPlastic, "ghost")
	part(slideModel, "ChuteOut", Vector3.new(1.8, 0.3, P[#P][1] - P[4][1] + 0.3), tower * CFrame.new(0, (P[5][2] + P[6][2]) / 2 - 0.2, (P[4][1] + P[#P][1]) / 2 + 0.15), RUBBER, M.SmoothPlastic, "ghost")
	local truss = Instance.new("TrussPart")
	truss.Name = "ClimbWall"
	truss.Anchored = true
	truss.Size = Vector3.new(2, 6, 2)
	truss.CFrame = tower * CFrame.new(-S.Deck / 2 - 1.05, 3, 0)
	truss.Transparency = 1
	truss.CanTouch = false
	truss.CanQuery = false
	truss.CastShadow = false
	truss.Parent = slideModel
	anchor(slideModel, "SlideLadder", tower * CFrame.new(0, 2.6, S.LadderZ - 1.2), "Slide", "Slide tower", "Slide", 7)
	anchor(slideModel, "SlideTop", tower * CFrame.new(0, S.DeckTop + 2.2, 0.8), "Slide", "Slide tower", "SlideTop", 5)

	-- 🐒 barres de singe (invites aux deux bouts, côté sol)
	local Mk = ParkMotion.MONKEY
	local monkeyModel = newPiece(model, "MonkeyBars", "Monkey").Model
	anchor(monkeyModel, "MonkeyA", g * CFrame.new(Mk.X0 - 1.1, 2.6, Mk.Z), "Cross", "Monkey bars", "MonkeyA", 6)
	anchor(monkeyModel, "MonkeyB", g * CFrame.new(Mk.X1 + 1.1, 2.6, Mk.Z), "Cross", "Monkey bars", "MonkeyB", 6)

	-- 🏖️ bac à sable
	local sandModel = newPiece(model, "Sandbox", "Sand").Model
	anchor(sandModel, "SandSpot", g * CFrame.new(ParkMotion.SAND.Center + Vector3.new(0, 1.2, 0)), "Dig", "Sandbox", "Dig", 7)

	-- 🎠 balançoires
	for i = 1, #ParkMotion.SWING.Xs do
		local piece = newPiece(model, "Swing" .. i, "Swing")
		piece.Model:SetAttribute("ParkIndex", i)
		addSeat(piece, 1, g * ParkMotion.SwingSeat(i, 0), Vector3.new(1.8, 0.2, 1.0))
	end
	-- ⚖️ tape-cul
	local seesaw = newPiece(model, "Seesaw", "Seesaw")
	local restAngle = ParkMotion.SeesawAngle(0, 0)
	for k = 1, 2 do
		addSeat(seesaw, k, g * ParkMotion.SeesawSeat(k, restAngle), Vector3.new(1.4, 0.2, 1.2))
	end
	-- 🌀 tourniquet (plateau : on peut y monter à pied)
	local merry = newPiece(model, "Merry", "Merry")
	local mc = ParkMotion.MERRY
	local deckDisc = TownKit.Disc(merry.Model, "MerryDeck", (g * CFrame.new(mc.Center + Vector3.new(0, mc.DeckTop, 0))).Position, mc.Radius, 0.7, RUBBER, M.Metal, "ghost")
	deckDisc.CanQuery = true
	for k = 1, mc.Seats do
		addSeat(merry, k, g * ParkMotion.MerrySeat(k, 0), Vector3.new(1.3, 0.2, 1.1))
	end
	-- 🐴 jeux à ressort (corps : bloc invisible pour ne pas passer à travers)
	for i = 1, #ParkMotion.SPRINGS do
		local piece = newPiece(model, "Spring" .. i, "Spring")
		piece.Model:SetAttribute("ParkIndex", i)
		part(piece.Model, "SpringBody", Vector3.new(1.3, 1.6, 2.6), g * ParkMotion.SpringBase(i) * CFrame.new(0, 1.3, 0), RUBBER, M.SmoothPlastic, "ghost")
		addSeat(piece, 1, g * ParkMotion.SpringSeat(i, 0, 0), Vector3.new(1.1, 0.2, 1.2))
	end
	-- 🪑 bancs des parents (2 places par banc)
	for bi = 1, #ParkMotion.BENCHES do
		local piece = newPiece(model, "ParkBench" .. bi, "Bench")
		piece.Model:SetAttribute("ParkIndex", bi)
		for k = 1, #ParkMotion.BENCH.Places do
			addSeat(piece, k, g * ParkMotion.BenchSeat(bi, k), Vector3.new(2.1, 0.2, 1.5))
		end
		part(piece.Model, "BenchBlock", Vector3.new(ParkMotion.BENCH.Length, ParkMotion.BENCH.SeatTop - 0.1, 1.5), g * ParkMotion.BenchFrame(bi) * CFrame.new(0, (ParkMotion.BENCH.SeatTop - 0.1) / 2, 0.1), RUBBER, M.Wood, "ghost")
	end
end

----------------------------------------------------------------------
-- Bancs du parc (TownKit.Bench) : invite "S'asseoir" (E)
----------------------------------------------------------------------

function TownPark.BenchPrompts(folder: Instance)
	for _, d in ipairs(folder:GetDescendants()) do
		if d:IsA("Seat") and d.Name == "Seat" and d.Parent and d.Parent.Name == "Bench" and not d:FindFirstChild("ParkPrompt") then
			local seat = d
			local p = prompt(seat, "Sit", "Bench", "Sit")
			p.MaxActivationDistance = 7
			p.Triggered:Connect(function(player: Player)
				local now = os.clock()
				if lastAsk[player] and now - lastAsk[player] < COOLDOWN then
					return
				end
				lastAsk[player] = now
				local _, humanoid, root = characterOf(player)
				if not humanoid or not root or not seat.Parent or humanoid.SeatPart ~= nil or seat.Occupant ~= nil then
					return
				end
				if (root.Position - seat.Position).Magnitude > SIT_RANGE then
					return
				end
				pcall(seat.Sit, seat, humanoid)
			end)
		end
	end
end

Players.PlayerRemoving:Connect(function(player)
	lastAsk[player] = nil
end)

return TownPark
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="394">
          <Properties>
            <string name="Name">TownPlaza</string>
            <string name="Source"><![CDATA[--[[
	TownPlaza (ModuleScript)
	Emplacement : ServerScriptService > Services > World > TownPlaza

	⛲ La place centrale de Dopamine Town (v9.4) :
	  - pavage en pierre avec anneaux et soleil rayonnant (motifs de pavés) ;
	  - FONTAINE monumentale : bassin à margelle, eau transparente, deux
	    vasques, jets animés (particules) et, au sommet, la mascotte :
	    un CERVEAU rose kawaii qui crache de l'eau ;
	  - kiosque à musique, manège, chariot à ballons, parterres de fleurs,
	    arbres en bacs, bancs (vrais Seat), lampadaires reliés par des
	    guirlandes lumineuses ;
	  - couronne de BOUTIQUES tout autour (TownBuildings) en laissant libres
	    les débouchés des rues et la mairie (au fond, face à l'avenue).
	v9.6 (SHOPS96) : la couronne commence par les 6 BOUTIQUES OÙ L'ON ENTRE
	(TownShops : animalerie, jouets, cuisine, meubles, setup, jardinerie ;
	intérieurs construits par le client, ShopInteriors), complétées par des
	boutiques de décor fermées ; lumières adoucies (plus de "flash") :
	lumière de la fontaine 1, ampoules des guirlandes plus petites, plus de
	néon sur les grandes surfaces.
v9.7 (PLAZA97) : chaque pièce maîtresse refaite, "10x mieux", réaliste
et stylisée :
  - pavage : rose des vents en mosaïque (8 pointes bicolores), pastilles
    de pierre sous le manège et le kiosque ;
  - FONTAINE à trois niveaux : margelle à 12 pans (pierre + couronnement
    rose), bassin, pied, vasque basse à bord festonné et rideau d'eau,
    balustre, vasque haute, et la mascotte CERVEAU refaite (deux lobes,
    circonvolutions, grands yeux brillants, joues, bouche ouverte, bras
    levés, petits pieds) ; 8 jets en arc, ronds dans l'eau, pupitre ;
  - KIOSQUE à musique octogonal : socle, plancher, marches, 8 colonnes,
    garde-corps à balustres, frise, toit en pyramide à 8 pans bicolores,
    épi de faîtage, pupitres et grosse caisse ;
  - MANÈGE : socle à deux marches + guérite "🎠" ; la partie qui TOURNE
    (plateau, jupe, fût à miroirs, 10 chevaux qui montent et descendent,
    2 carrosses, auvent rayé festonné, ampoules) est construite et animée
    par le client (Client/World/TownPlazaFx) : attributs "Fx…" du dossier
    Plaza ;
  - chariot à ballons (ballons animés côté client), stand de GLACES, stand
    de BARBE À PAPA, coin du musicien de rue (sans PNJ), dessins à la
    craie (marelle, cœurs), parterres de fleurs en vrais massifs,
    lampadaires à deux lanternes (TownKit.Light la nuit, TownKit.Glow) ;
  - guirlandes lumineuses, fanions, pigeons : côté client (TownPlazaFx).
  Budget : 5 vraies lumières (fontaine, kiosque, manège, 2 lampadaires).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WorldLayout = require(ReplicatedStorage.Shared.WorldLayout)
local TownKit = require(script.Parent.TownKit)
local TownBuildings = require(script.Parent.TownBuildings)
local TownShops = require(script.Parent.TownShops)
local TownFair = require(script.Parent.TownFair) -- (v9.8, FAIR98) manège où l'on monte, bornes des stands
-- (v9.9, CITY99) 🎸 scène de musique (MUSIC99) à la place de l'ancien kiosque
local okMusic, TownMusic = pcall(function()
	local mod = script.Parent:FindFirstChild("TownMusic")
	return mod and require(mod) :: any or nil
end)

local TownPlaza = {}

local M = TownKit.M
local C = TownKit.C
local part = TownKit.Part

local WALK_Y = WorldLayout.WALK_Y
local R = WorldLayout.PLAZA_R
local FACADE_R = R + 4 -- façades des boutiques de la place

local function emitter(host: BasePart, props: { [string]: any })
	local e = Instance.new("ParticleEmitter")
	e.Name = "Water"
	e.Color = ColorSequence.new(Color3.fromRGB(214, 244, 255), Color3.fromRGB(255, 255, 255))
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(0.7, 0.35), NumberSequenceKeypoint.new(1, 1) })
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0.8) })
	e.LightEmission = 0.15
	e.Acceleration = Vector3.new(0, -24, 0)
	for key, value in pairs(props) do
		(e :: any)[key] = value
	end
	e.Parent = host
	return e
end

-- (v9.7) Triangle rectangle en WedgePart : angle droit en `p0`, un côté le
-- long de `u` (longueur l1), l'autre le long de `v` (longueur l2, v ⟂ u),
-- épaisseur `t` de part et d'autre du plan. (Un WedgePart a son angle droit
-- en (y = -h/2, z = +d/2) et ses côtés le long de +Y et de -Z.)
local function tri(parent: Instance, name: string, p0: Vector3, u: Vector3, v: Vector3, l1: number, l2: number, t: number, color: Color3, material: Enum.Material?, profile: string?): BasePart
	local Y = u
	local Z = -v
	local X = Y:Cross(Z)
	local center = p0 + u * (l1 / 2) + v * (l2 / 2)
	return TownKit.Wedge(parent, name, Vector3.new(t, l1, l2), CFrame.fromMatrix(center, X, Y, Z), color, material, profile)
end

-- Direction horizontale d'angle `a` dans le repère `F` (0 = avant, -Z local)
local function dirIn(F: CFrame, a: number): Vector3
	return F:VectorToWorldSpace(Vector3.new(math.sin(a), 0, -math.cos(a)))
end

-- Toit en pyramide à `n` pans (2 coins par pan) : bord du toit à l'apothème
-- `e` (hauteur y0 dans F), sommet à la hauteur y1 ; couleurs alternées
local function pyramid(parent: Instance, name: string, F: CFrame, n: number, e: number, y0: number, y1: number, t: number, colors: { Color3 }, material: Enum.Material, profile: string?)
	local apex = (F * CFrame.new(0, y1, 0)).Position
	local half = e * math.tan(math.pi / n)
	for k = 0, n - 1 do
		local nrm = dirIn(F, k / n * math.pi * 2)
		local side = Vector3.new(0, 1, 0):Cross(nrm).Unit
		local M = (F * CFrame.new(0, y0, 0)).Position + nrm * e
		local w = apex - M
		local len = w.Magnitude
		local color = colors[k % #colors + 1]
		tri(parent, name, M, w.Unit, side, len, half, t, color, material, profile)
		tri(parent, name, M, w.Unit, -side, len, half, t, color, material, profile)
	end
end

----------------------------------------------------------------------
-- Pavage
----------------------------------------------------------------------

local function paving(folder: Instance, O: Vector3)
	local model = TownKit.Model(folder, "Paving")
	local base = O + Vector3.new(0, WALK_Y, 0)
	TownKit.Disc(model, "Plaza", base, R, 1.3, C.Paving, M.Cobblestone, "solid")
	TownKit.Disc(model, "RingRose", base + Vector3.new(0, 0.03, 0), R - 4, 0.4, C.PavingRose, M.Cobblestone, "deco")
	TownKit.Disc(model, "RingInner", base + Vector3.new(0, 0.06, 0), R - 5.5, 0.4, C.Paving, M.Cobblestone, "deco")
	-- (v9.7) ROSE DES VENTS en mosaïque autour de la fontaine : 8 pointes
	-- (4 longues vers l'avenue, les rues et la mairie, 4 courtes vers le
	-- manège / le kiosque), chacune en deux demi-pointes claire / foncée
	-- (effet de relief) ; le cœur est caché sous le parvis de la fontaine.
	-- Hauteurs des dessus : pavage 0,06 < rose 0,09 < anneau 0,12 < parvis
	-- 0,15 (jamais deux faces à moins de 0,03).
	local up = Vector3.new(0, 1, 0)
	local center = base + Vector3.new(0, 0.09 - 0.05, 0)
	local light = { Color3.fromRGB(246, 238, 250), Color3.fromRGB(252, 236, 238) }
	local dark = { Color3.fromRGB(176, 158, 216), Color3.fromRGB(222, 150, 170) }
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		local d = Vector3.new(math.sin(a), 0, math.cos(a))
		local side = up:Cross(d).Unit
		local long = k % 2 == 0
		local len, half = long and 45 or 31, long and 7.5 or 5.5
		tri(model, "Compass", center, d, side, len, half, 0.1, light[k % 2 + 1], M.Slate, "deco")
		tri(model, "Compass", center, d, -side, len, half, 0.1, dark[k % 2 + 1], M.Slate, "deco")
	end
	TownKit.Disc(model, "FountainRing", base + Vector3.new(0, 0.12, 0), 21.5, 0.4, C.PavingLilac, M.Cobblestone, "deco")
	TownKit.Disc(model, "FountainApron", base + Vector3.new(0, 0.15, 0), 20, 0.4, C.Stone, M.Slate, "deco")
end

-- Pastille de pierre (sous le manège / le kiosque) : dessus à +0,14
local function pad(folder: Instance, center: Vector3, radius: number)
	TownKit.Disc(folder, "Pad", center + Vector3.new(0, 0.14, 0), radius, 0.4, Color3.fromRGB(232, 220, 226), M.Slate, "deco")
end

----------------------------------------------------------------------
-- Fontaine + cerveau mascotte
----------------------------------------------------------------------

-- (v9.7) La mascotte refaite : un cerveau dodu et kawaii, debout sur la
-- vasque haute, bras levés ("youpi !"). `cf` = centre du cerveau, visage
-- vers -Z local. Deux lobes (2 boules chacun : un peu plus long que haut),
-- 18 circonvolutions en relief, 12 sillons, sillon central, grands yeux
-- brillants, joues, bouche ouverte + langue, bras, mains, jambes, pieds.
-- 53 pièces.
local BRAIN_FEET = 2.625 -- (studs) du centre du cerveau au dessous des pieds
local function brain(model: Instance, cf: CFrame)
	local pink = Color3.fromRGB(255, 152, 198)
	local pinkDeep = Color3.fromRGB(240, 116, 172)
	local fold = Color3.fromRGB(214, 88, 148)
	local R0 = 1.8 -- rayon des boules des lobes
	local function at(x: number, y: number, z: number): Vector3
		return (cf * CFrame.new(x, y, z)).Position
	end
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			local lobe = TownKit.Ball(model, "Lobe", at(sx * 1.05, 0, sz * 0.55), R0 * 2, pink, M.SmoothPlastic, "decoS")
			lobe.Reflectance = 0.04
		end
		-- circonvolutions : bosses posées sur la surface des lobes (depuis
		-- la boule avant (-) ou arrière (+)), jamais sur le visage
		local bumps = {
			{ -1, 0.25, 0.95, -0.3 },
			{ 1, 0.3, 0.95, 0.35 },
			{ -1, 0.8, 0.55, -0.25 },
			{ 1, 0.85, 0.5, 0.45 },
			{ 1, 0.2, 0.7, 0.7 },
			{ 1, 0.95, 0, 0.3 },
			{ 1, 0.5, 0.35, 0.8 },
			{ -1, 0.6, 0.8, 0.15 },
			{ 1, 0.65, 0.75, -0.1 },
		}
		for i, b in ipairs(bumps) do
			local c = Vector3.new(sx * 1.05, 0, b[1] * 0.55)
			local d = Vector3.new(sx * b[2], b[3], b[4]).Unit
			local p = c + d * (R0 - 0.35)
			TownKit.Ball(model, "Fold", at(p.X, p.Y, p.Z), i % 3 == 0 and 1.3 or 1.5, i % 2 == 0 and pinkDeep or pink, M.SmoothPlastic, "deco")
		end
		-- œil (noir) + 2 reflets (du même côté pour les deux yeux)
		TownKit.Ball(model, "Eye", at(sx * 0.95, 0, -2.1), 0.95, Color3.fromRGB(58, 34, 64), M.SmoothPlastic, "deco")
		TownKit.Ball(model, "Shine", at(sx * 0.95 + 0.17, 0.2, -2.45), 0.34, C.White, M.SmoothPlastic, "deco")
		TownKit.Ball(model, "Shine2", at(sx * 0.95 - 0.15, -0.16, -2.5), 0.16, C.White, M.SmoothPlastic, "deco")
		-- joue : pastille posée sur la courbe du lobe avant
		local lc = Vector3.new(sx * 1.05, 0, -0.55)
		local bd = Vector3.new(sx * 0.55, -0.35, -0.76).Unit
		local bp = at(lc.X + bd.X * (R0 + 0.03), lc.Y + bd.Y * (R0 + 0.03), lc.Z + bd.Z * (R0 + 0.03))
		local bw = cf:VectorToWorldSpace(bd)
		local blush = part(model, "Blush", Vector3.new(0.1, 0.8, 0.8), CFrame.lookAt(bp, bp + bw) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(255, 112, 150), M.SmoothPlastic, "deco")
		;(blush :: Part).Shape = Enum.PartType.Cylinder
		-- bras levés + mains, jambes + pieds
		TownKit.Rod(model, "Arm", at(sx * 2.55, -0.5, -0.2), at(sx * 3.5, 0.9, -0.55), 0.5, pink, M.SmoothPlastic, "deco")
		TownKit.Ball(model, "Hand", at(sx * 3.6, 1.05, -0.6), 0.75, pink, M.SmoothPlastic, "deco")
		TownKit.Rod(model, "Leg", at(sx * 0.75, -1.3, -0.2), at(sx * 0.8, -2.2, -0.35), 0.55, pinkDeep, M.SmoothPlastic, "deco")
		TownKit.Ball(model, "Foot", at(sx * 0.82, -2.2, -0.45), 0.85, pinkDeep, M.SmoothPlastic, "deco")
	end
	-- sillons (petites tiges foncées posées sur la surface : on lit enfin
	-- un CERVEAU et pas deux boules) + sillon entre les deux hémisphères
	local grooves = {
		{ -1, { 0.15, 1, -0.35 }, { 0.7, 0.7, -0.2 } },
		{ -1, { 0.2, 0.62, -0.75 }, { 0.75, 0.45, -0.55 } },
		{ -1, { 0.9, 0.35, -0.25 }, { 0.95, -0.1, -0.3 } },
		{ 1, { 0.15, 1, 0.3 }, { 0.75, 0.65, 0.25 } },
		{ 1, { 0.4, 0.6, 0.7 }, { 0.85, 0.2, 0.5 } },
		{ 1, { 0.2, 0.3, 0.95 }, { 0.6, -0.2, 0.8 } },
	}
	for _, sx in ipairs({ -1, 1 }) do
		for _, gr in ipairs(grooves) do
			local c = Vector3.new(sx * 1.05, 0, gr[1] * 0.55)
			local a = c + Vector3.new(sx * gr[2][1], gr[2][2], gr[2][3]).Unit * (R0 + 0.05)
			local b = c + Vector3.new(sx * gr[3][1], gr[3][2], gr[3][3]).Unit * (R0 + 0.05)
			TownKit.Rod(model, "Groove", at(a.X, a.Y, a.Z), at(b.X, b.Y, b.Z), 0.2, fold, M.SmoothPlastic, "deco")
		end
	end
	part(model, "Fissure", Vector3.new(0.22, 0.3, 3.2), cf * CFrame.new(0, 1.3, 0.3), fold, M.SmoothPlastic, "deco")
	-- bouche ouverte + langue
	TownKit.Ball(model, "Mouth", at(0, -0.7, -1.85), 0.6, Color3.fromRGB(120, 36, 70), M.SmoothPlastic, "deco")
	TownKit.Ball(model, "Tongue", at(0, -0.86, -2.02), 0.34, Color3.fromRGB(255, 108, 132), M.SmoothPlastic, "deco")
end

local function fountain(folder: Instance, O: Vector3): BasePart
	local model = TownKit.Model(folder, "Fountain")
	local base = O + Vector3.new(0, WALK_Y + 0.15, 0)
	local marble = Color3.fromRGB(250, 244, 240)
	local rose = Color3.fromRGB(232, 178, 188)
	local stone = Color3.fromRGB(206, 196, 192)
	local bronze = Color3.fromRGB(196, 150, 92)
	local basinR = 13.6
	local function y(h: number): Vector3
		return base + Vector3.new(0, h, 0)
	end
	-- (v9.7) Hauteurs (au-dessus du parvis) : marche 0,5 ; fond 0,8 ; eau
	-- 2,5 ; margelle 2,8 + couronnement 3,2 ; vasque basse 7,0 (eau 7,1) ;
	-- vasque haute 10,9 (eau 11,0) ; tambour 12,05 ; cerveau au-dessus.
	-- marche de pierre tout autour
	TownKit.Disc(model, "Step", y(0.5), 15.4, 0.5, stone, M.Slate, "solid")
	-- margelle à 12 pans + couronnement rose (on peut s'y asseoir / grimper)
	local n = 12
	local w = 2 * basinR * math.tan(math.pi / n)
	for i = 0, n - 1 do
		local a = (i + 0.5) / n * math.pi * 2
		local d = Vector3.new(math.sin(a), 0, math.cos(a))
		local p = base + d * basinR + Vector3.new(0, 1.65, 0)
		local wall = CFrame.lookAt(p, p + d)
		part(model, "Rim", Vector3.new(w + 0.5, 2.3, 1.4), wall, marble, M.Marble, "solid")
		part(model, "RimCap", Vector3.new(w + 0.9, 0.4, 2.1), wall * CFrame.new(0, 1.35, -0.1), rose, M.Marble, "decoS")
	end
	-- fond du bassin, eau transparente, ronds dans l'eau
	TownKit.Disc(model, "PoolFloor", y(0.8), 13.1, 0.3, C.WaterDeep, M.Slate, "solid")
	local water = TownKit.Disc(model, "Water", y(2.5), 13, 0.4, C.Water, M.Glass, "deco")
	water.Transparency = 0.35
	water.Reflectance = 0.1
	for k = 0, 3 do
		local a = (k + 0.5) / 4 * math.pi * 2
		local ripple = TownKit.Disc(model, "Ripple", y(2.54) + Vector3.new(math.sin(a) * 6.9, 0, math.cos(a) * 6.9), 1.1, 0.06, Color3.fromRGB(236, 248, 255), M.SmoothPlastic, "deco")
		ripple.Transparency = 0.45
	end
	-- pied central, vasque basse festonnée + rideau d'eau
	TownKit.Column(model, "PedestalFoot", y(0.8), 0.9, 5.4, marble, M.Marble, "solid")
	TownKit.Column(model, "Pedestal", y(1.7), 3.9, 3.4, marble, M.Marble, "solid")
	TownKit.Column(model, "PedestalRing", y(5.6), 0.4, 4, rose, M.Marble, "deco")
	TownKit.Column(model, "BowlFoot", y(6), 0.5, 5.4, marble, M.Marble, "deco")
	local bowl = TownKit.Disc(model, "Bowl", y(7), 6.2, 0.5, marble, M.Marble, "decoS")
	local bowlWater = TownKit.Disc(model, "BowlWater", y(7.1), 5.7, 0.08, C.Water, M.Glass, "deco")
	bowlWater.Transparency = 0.25
	for k = 0, 13 do
		local a = k / 14 * math.pi * 2
		TownKit.Ball(model, "Scallop", y(7.05) + Vector3.new(math.sin(a) * 5.95, 0, math.cos(a) * 5.95), 1, rose, M.Marble, "deco")
	end
	local curtain = TownKit.Column(model, "Curtain", y(2.5), 4.35, 12.6, Color3.fromRGB(200, 236, 255), M.Glass, "deco")
	curtain.Transparency = 0.8
	-- balustre, vasque haute festonnée + son rideau
	TownKit.Column(model, "Shaft", y(6.9), 2.9, 1.5, marble, M.Marble, "deco")
	TownKit.Ball(model, "Knob", y(8.4), 2.2, marble, M.Marble, "deco")
	TownKit.Column(model, "UpperFoot", y(9.8), 0.5, 3, marble, M.Marble, "deco")
	TownKit.Disc(model, "UpperBowl", y(10.9), 3.3, 0.6, marble, M.Marble, "deco")
	local upperWater = TownKit.Disc(model, "UpperWater", y(11), 2.9, 0.06, C.Water, M.Glass, "deco")
	upperWater.Transparency = 0.25
	for k = 0, 9 do
		local a = k / 10 * math.pi * 2
		TownKit.Ball(model, "Scallop", y(10.95) + Vector3.new(math.sin(a) * 3.1, 0, math.cos(a) * 3.1), 0.7, rose, M.Marble, "deco")
	end
	local curtain2 = TownKit.Column(model, "Curtain", y(7.1), 3.65, 6.7, Color3.fromRGB(200, 236, 255), M.Glass, "deco")
	curtain2.Transparency = 0.8
	-- tambour doré, puis le cerveau mascotte (regarde l'entrée : +Z)
	TownKit.Column(model, "Drum", y(10.8), 1, 1.8, marble, M.Marble, "deco")
	TownKit.Column(model, "DrumTop", y(11.8), 0.25, 2.2, C.Yellow, M.Metal, "deco")
	local brainP = y(12.05 + BRAIN_FEET)
	brain(model, CFrame.lookAt(brainP, brainP + Vector3.new(0, 0, 10)))
	-- rideau d'eau de la vasque basse + jet du cerveau + 8 jets en arc
	emitter(bowl, {
		Shape = Enum.ParticleEmitterShape.Disc,
		ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface,
		ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward,
		EmissionDirection = Enum.NormalId.Top,
		Rate = 40,
		Speed = NumberRange.new(1, 2),
		Lifetime = NumberRange.new(0.9, 1.1),
		SpreadAngle = Vector2.new(8, 8),
	})
	-- (le cerveau crache un jet doux par le sommet du crâne)
	local nozzle = part(model, "Nozzle", Vector3.new(0.6, 0.6, 0.6), CFrame.new(brainP + Vector3.new(0, 2.1, 0)), C.White, M.SmoothPlastic, "deco")
	nozzle.Transparency = 1
	emitter(nozzle, {
		EmissionDirection = Enum.NormalId.Top,
		Rate = 26,
		Speed = NumberRange.new(10, 12),
		Lifetime = NumberRange.new(1.2, 1.4),
		SpreadAngle = Vector2.new(8, 8),
	})
	emitter(upperWater, {
		Shape = Enum.ParticleEmitterShape.Disc,
		ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface,
		ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward,
		EmissionDirection = Enum.NormalId.Top,
		Rate = 18,
		Speed = NumberRange.new(0.8, 1.4),
		Lifetime = NumberRange.new(0.7, 0.9),
		SpreadAngle = Vector2.new(8, 8),
	})
	-- 8 buses de bronze sur la margelle : jets en arc vers le centre
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		local p = y(2.62) + Vector3.new(math.sin(a) * 12.3, 0, math.cos(a) * 12.3)
		local jet = part(model, "Jet", Vector3.new(0.55, 0.3, 0.55), CFrame.lookAt(p, Vector3.new(base.X, p.Y, base.Z)) * CFrame.Angles(math.rad(-40), 0, 0), bronze, M.Metal, "deco")
		emitter(jet, {
			EmissionDirection = Enum.NormalId.Top,
			Rate = 12,
			Speed = NumberRange.new(9, 10.5),
			Lifetime = NumberRange.new(0.95, 1.1),
			SpreadAngle = Vector2.new(3, 3),
		})
	end
	-- lumière sous l'eau (1 vraie lumière, douce, la nuit seulement)
	TownKit.Light(water, Color3.fromRGB(150, 220, 255), 18, 0.8)
	-- pupitre de pierre + plaque de bronze inclinée (face à l'avenue)
	local lp = y(0) + Vector3.new(0, 0, 17.2)
	local desk = CFrame.lookAt(lp, lp + Vector3.new(0, 0, 1))
	part(model, "Lectern", Vector3.new(1.3, 2.2, 0.8), desk * CFrame.new(0, 1.1, 0), stone, M.Slate, "prop")
	local plaque = part(model, "Plaque", Vector3.new(3.4, 1.5, 0.2), desk * CFrame.new(0, 2.75, 0.05) * CFrame.Angles(math.rad(35), 0, 0), bronze, M.Metal, "deco")
	local _, body = TownKit.Surface(plaque, Enum.NormalId.Front, 60, nil, 90, 0.4)
	TownKit.Label(body, "Text", "🧠 The Dopamine Fountain", 0.05, 0.12, 0.9, 0.76, Color3.fromRGB(84, 52, 36), Enum.Font.FredokaOne, true)
	return water
end

----------------------------------------------------------------------
-- Kiosque, manège, ballons, guirlandes
----------------------------------------------------------------------

-- (v9.9, CITY99) le kiosque à musique octogonal (v9.7) est remplacé par la
-- scène de musique de MUSIC99 (TownMusic.Build, appelé par TownPlaza.Build).

-- (v9.7) MANÈGE : ici seulement ce qui NE tourne PAS (socle à deux
-- marches, guérite à tickets, lumière douce). Le plateau, les chevaux, les
-- carrosses et l'auvent sont construits et animés par chaque client
-- (TownPlazaFx) à partir de l'attribut "FxCarouselCF" du dossier Plaza
-- (centre du DESSUS du socle, avant vers le centre de la place).
local CAROUSEL_TOP = 1.2 -- (studs) dessus du socle (le plateau tournant pose dessus)
local function carousel(folder: Instance, F: CFrame): CFrame
	local model = TownKit.Model(folder, "Carousel")
	local center = F.Position
	TownKit.Column(model, "Plinth", center, 0.6, 20.4, Color3.fromRGB(196, 184, 214), M.Slate, "solid")
	TownKit.Column(model, "Platform", center + Vector3.new(0, 0.6, 0), CAROUSEL_TOP - 0.6, 18.6, C.PavingLilac, M.Marble, "solid")
	-- lumière douce au cœur de l'auvent (hôte invisible ; la nuit seulement)
	local anchor = part(model, "LightAnchor", Vector3.new(1, 1, 1), F * CFrame.new(0, CAROUSEL_TOP + 7.3, 0), C.White, M.SmoothPlastic, "deco")
	anchor.Transparency = 1
	TownKit.Light(anchor, Color3.fromRGB(255, 212, 170), 20, 0.9)
	-- guérite à tickets (devant, à droite en arrivant de la place)
	local booth = F * CFrame.new(-8.5, 0, -12) * CFrame.Angles(0, math.rad(20), 0)
	local pinkBooth = Color3.fromRGB(255, 176, 206)
	local boothPart = part(model, "Booth", Vector3.new(2.8, 3.2, 2.4), booth * CFrame.new(0, 1.6, 0), pinkBooth, M.WoodPlanks, "solid")
	part(model, "BoothWindow", Vector3.new(1.8, 1.1, 0.1), booth * CFrame.new(0, 2.25, -1.24), C.GlassDark, M.Glass, "deco").Transparency = 0.3
	part(model, "BoothShelf", Vector3.new(2.2, 0.14, 0.6), booth * CFrame.new(0, 1.62, -1.45), C.Cream, M.Wood, "deco")
	part(model, "BoothRoof", Vector3.new(3.4, 0.35, 3), booth * CFrame.new(0, 3.38, 0), C.Cream, M.SmoothPlastic, "deco")
	-- petit toit en pointe rayé (comme l'auvent du manège) + boule dorée
	pyramid(model, "BoothCap", booth * CFrame.new(0, 3.555, 0), 4, 1.45, 0, 1.7, 0.1, { Color3.fromRGB(255, 132, 180), C.Cream }, M.Fabric, "deco")
	TownKit.Ball(model, "BoothFinial", (booth * CFrame.new(0, 5.3, 0)).Position, 0.45, C.Yellow, M.Metal, "deco")
	local sign = part(model, "BoothSign", Vector3.new(2.6, 0.9, 0.12), booth * CFrame.new(0, 4.1, -1.62), C.Cream, M.SmoothPlastic, "deco")
	local _, body = TownKit.Surface(sign, Enum.NormalId.Front, 50, Color3.fromRGB(255, 244, 232), 120, 0.4)
	TownKit.Label(body, "Text", "🎠 Carousel", 0.04, 0.08, 0.92, 0.84, Color3.fromRGB(196, 64, 124), Enum.Font.FredokaOne, true)
	-- (v9.8, FAIR98) on MONTE sur le manège : 12 places (10 chevaux + 2
	-- carrosses, sièges ancrés qui suivent le plateau : TownFair / FairRides),
	-- invite "Monter" à la guérite ; le client (TownPlazaFx) les lisse
	local pcallOk, pcallErr = pcall(TownFair.AddPlazaCarousel, model, F * CFrame.new(0, CAROUSEL_TOP, 0), boothPart)
	if not pcallOk then
		warn("[TownPlaza] manège : " .. tostring(pcallErr))
	end
	return F * CFrame.new(0, CAROUSEL_TOP, 0)
end

-- (v9.7) Chariot du marchand de ballons : caisse en bois à bande rose,
-- 2 roues à moyeu, poignée, béquille, mât (les ballons, eux, flottent et
-- se balancent côté client, attachés au sommet du mât : attribut
-- "FxBalloonTie"), bouteille d'hélium, pancarte "🎈 Balloons".
-- `cf` au sol, avant (-Z) vers les clients. Renvoie le point d'attache.
local function balloonCart(folder: Instance, cf: CFrame): Vector3
	local model = TownKit.Model(folder, "BalloonCart")
	part(model, "Cart", Vector3.new(3.6, 2, 2.2), cf * CFrame.new(0, 1.9, 0), C.Cream, M.WoodPlanks, "solid")
	part(model, "Stripe", Vector3.new(3.7, 0.5, 2.3), cf * CFrame.new(0, 2.3, 0), C.Pink, M.SmoothPlastic, "deco")
	part(model, "Counter", Vector3.new(3.9, 0.2, 2.5), cf * CFrame.new(0, 3, 0), C.WoodLight, M.Wood, "deco")
	for _, x in ipairs({ -1.95, 1.95 }) do
		local w = part(model, "Wheel", Vector3.new(0.3, 2, 2), cf * CFrame.new(x, 1, 0.3), C.Metal, M.Rubber, "deco")
		;(w :: Part).Shape = Enum.PartType.Cylinder
		local hub = part(model, "Hub", Vector3.new(0.45, 0.5, 0.5), cf * CFrame.new(x, 1, 0.3), C.Yellow, M.Metal, "deco")
		;(hub :: Part).Shape = Enum.PartType.Cylinder
	end
	part(model, "Leg", Vector3.new(0.25, 0.9, 0.25), cf * CFrame.new(0, 0.45, -0.8), C.Metal, M.Metal, "deco")
	TownKit.Rod(model, "Handle", (cf * CFrame.new(-1.3, 3.1, 2)).Position, (cf * CFrame.new(1.3, 3.1, 2)).Position, 0.16, C.Metal, M.Metal, "deco")
	for _, x in ipairs({ -1.3, 1.3 }) do

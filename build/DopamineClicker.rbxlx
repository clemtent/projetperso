		["Puzzle"] = "Casse-tête",
		["Tic-Tac-Toe"] = "Morpion",
		["Three in a row wins. Quick and sneaky!"] = "Trois alignés pour gagner. Rapide et rusé !",
		["Strategy"] = "Stratégie",
		["Connect 4"] = "Puissance 4",
		["Drop your discs and line up four"] = "Lâche tes jetons et aligne-en quatre",
		["Reaction Duel"] = "Duel de réflexes",

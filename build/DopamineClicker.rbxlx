	------------------------------------------------------------------
	-- Obstacles et pièces
	------------------------------------------------------------------
	local objects = {} -- { Kind, Lane, Z, Frame, Width, Height, Lift, Phase }

	local function spawnTrain(lane: number)
		local color = TRAIN_COLORS[random:NextInteger(1, #TRAIN_COLORS)]
		local face = Create("Frame", {
			Name = "Train",
			AnchorPoint = Vector2.new(0.5, 1),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Parent = screen,
		})
		UIUtil.Corner(face, UDim.new(0.12, 0))
		UIUtil.Gradient(face, ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(185, 185, 195)), 90)
		local windshield = Create("Frame", {
			Position = UDim2.fromScale(0.1, 0.1),
			Size = UDim2.fromScale(0.8, 0.32),
			BackgroundColor3 = Color3.fromRGB(40, 52, 76),
			BorderSizePixel = 0,
			Parent = face,
		})
		UIUtil.Corner(windshield, UDim.new(0.2, 0))
		UIUtil.Gradient(windshield, ColorSequence.new(Color3.fromRGB(140, 220, 255), Color3.fromRGB(60, 80, 120)), 60)
		Create("Frame", {
			Position = UDim2.fromScale(0, 0.52),
			Size = UDim2.fromScale(1, 0.09),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.15,
			BorderSizePixel = 0,
			Parent = face,
		})
		for _, lightX in ipairs({ 0.2, 0.8 }) do
			local light = Create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(lightX, 0.75),
				Size = UDim2.fromScale(0.17, 0.13),
				BackgroundColor3 = Color3.fromRGB(255, 246, 170),
				BorderSizePixel = 0,
				Parent = face,
			})
			UIUtil.Corner(light, UDim.new(1, 0))
		end
		table.insert(objects, { Kind = "Train", Lane = lane, Z = Z_FAR, Frame = face, Width = 98, Height = 118, Lift = 0, Phase = 0 })
	end

	local function spawnBarrier(lane: number)
		local root = Create("Frame", {
			Name = "Barrier",
			AnchorPoint = Vector2.new(0.5, 1),
			BackgroundTransparency = 1,
			Parent = screen,
		})
		for _, legX in ipairs({ 0.14, 0.86 }) do
			Create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.fromScale(legX, 0.45),
				Size = UDim2.fromScale(0.08, 0.55),
				BackgroundColor3 = Color3.fromRGB(70, 70, 82),
				BorderSizePixel = 0,
				Parent = root,
			})
		end
		local board = Create("Frame", {
			Size = UDim2.fromScale(1, 0.55),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			ZIndex = 2,
			Parent = root,
		})
		UIUtil.Corner(board, UDim.new(0.2, 0))
		-- Rayures rouges et blanches (dégradé à bords nets)
		local keypoints = {}
		local stripes = 6
		for i = 0, stripes - 1 do
			local c = (i % 2 == 0) and Color3.fromRGB(232, 36, 48) or Color3.new(1, 1, 1)
			table.insert(keypoints, ColorSequenceKeypoint.new(i / stripes, c))
			table.insert(keypoints, ColorSequenceKeypoint.new(math.min(1, (i + 1) / stripes - 0.001), c))
		end
		keypoints[#keypoints] = ColorSequenceKeypoint.new(1, keypoints[#keypoints].Value)
		UIUtil.Gradient(board, ColorSequence.new(keypoints), 20)
		table.insert(objects, { Kind = "Barrier", Lane = lane, Z = Z_FAR, Frame = root, Width = 94, Height = 44, Lift = 0, Phase = 0 })
	end

	local function spawnCoin(lane: number, z: number)
		local coin = Create("Frame", {
			Name = "Coin",
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = Color3.fromRGB(255, 208, 40),
			BorderSizePixel = 0,
			Parent = screen,
		})
		UIUtil.Corner(coin, UDim.new(1, 0))
		UIUtil.Gradient(coin, ColorSequence.new(Color3.fromRGB(255, 250, 200), Color3.fromRGB(255, 176, 20)), 90)
		local inner = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.55, 0.55),
			BackgroundColor3 = Color3.fromRGB(230, 150, 10),
			BackgroundTransparency = 0.35,
			BorderSizePixel = 0,
			Parent = coin,
		})
		UIUtil.Corner(inner, UDim.new(1, 0))
		table.insert(objects, { Kind = "Coin", Lane = lane, Z = z, Frame = coin, Width = 24, Height = 24, Lift = 26, Phase = random:NextNumber(0, 6) })
	end

	local function spawnWave()
		local free = random:NextInteger(1, 3)
		local kinds = {}
		for lane = 1, 3 do
			if lane ~= free then
				local roll = random:NextNumber()
				if roll < 0.45 then
					spawnTrain(lane)
					kinds[lane] = "Train"
				elseif roll < 0.8 then
					spawnBarrier(lane)
					kinds[lane] = "Barrier"
				end
			end
		end
		-- Pièces : souvent sur la voie libre, parfois derrière une barrière
		local coinLane = free
		if random:NextNumber() < 0.3 then
			local other = random:NextInteger(1, 3)
			if kinds[other] ~= "Train" then
				coinLane = other
			end
		end
		for k = 0, random:NextInteger(3, 5) - 1 do
			spawnCoin(coinLane, Z_FAR + 0.45 + k * 0.42)
		end
	end

	local function removeObject(index: number)
		local object = objects[index]
		table.remove(objects, index)
		if object and object.Frame then
			object.Frame:Destroy()
		end
	end

	local function clearObjects()
		for i = #objects, 1, -1 do
			removeObject(i)
		end
	end

	------------------------------------------------------------------
	-- État de la partie
	------------------------------------------------------------------
	local speed = BASE_SPEED
	local runTime = 0
	local scroll = 0 -- défilement total (pour traverses / lampadaires)
	local waveTravel = WAVE_GAP * 0.6
	local coins = 0
	local distance = 0
	local shownDistance = -1
	local best = 0
	local state = "run" -- "run" | "crash"
	local crashTime = 0
	local lane = 2 -- voie visée
	local heroX = LANES[2] -- position latérale actuelle (monde)
	local jumpTime = JUMP_TIME -- >= JUMP_TIME : au sol
	local jumpScale = 1
	local phase = 0
	local decideTimer = 0
	local blunderAt = os.clock() + random:NextNumber(45, 90)
	local captionTimer = random:NextNumber(4, 8)
	local videoTime = 0
	local shownSecond = -1
	local clock = 0

	local function currentLane(): number
		local bestLane, bestDist = 2, math.huge
		for i, laneX in ipairs(LANES) do
			local d = math.abs(heroX - laneX)
			if d < bestDist then
				bestLane, bestDist = i, d
			end
		end
		return bestLane
	end

	-- Premier objet d'un type dans une voie, entre deux profondeurs
	local function findInLane(laneIndex: number, kind: string, zMin: number, zMax: number)
		for _, object in ipairs(objects) do
			if object.Kind == kind and object.Lane == laneIndex and object.Z >= zMin and object.Z <= zMax then
				return object
			end
		end
		return nil
	end

	local function coinsAhead(laneIndex: number): number
		local count = 0
		for _, object in ipairs(objects) do
			if object.Kind == "Coin" and object.Lane == laneIndex and object.Z > CHAR_Z and object.Z < CHAR_Z + 3.5 then
				count += 1
			end
		end
		return count
	end

	local function laneSafe(laneIndex: number): boolean
		return findInLane(laneIndex, "Train", CHAR_Z - 0.35, CHAR_Z + LOOK_AHEAD + 0.6) == nil
	end

	local function startJump(scale: number)
		if jumpTime < JUMP_TIME then
			return
		end
		jumpTime = 0
		jumpScale = scale
	end

	local function goToLane(target: number)
		if target ~= lane then
			lane = target
			startJump(0.45) -- petit saut d'esquive
		end
	end

	local function showCaption(text: string)
		caption.Text = text
		caption.TextTransparency = 0
		captionStroke.Transparency = 0
		captionScale.Scale = 0.4
		UIUtil.Tween(captionScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		task.delay(2.6, function()
			if ctx.IsAlive() and caption.Text == text then
				UIUtil.Tween(caption, 0.3, { TextTransparency = 1 })
				UIUtil.Tween(captionStroke, 0.3, { Transparency = 1 })
			end
		end)
	end

	local function collectCoin(index: number)
		local object = objects[index]
		table.remove(objects, index)
		coins += 1
		coinLabel.Text = tostring(coins)
		coinScale.Scale = 1.25
		UIUtil.Tween(coinScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
		if coins % 25 == 0 then
			if effectsOn() then
				ctx.Effects.Burst(screen, UDim2.fromOffset(40, 20), Color3.fromRGB(255, 208, 40), 6)
			end
			showCaption(coins .. " pièces !! 🤑")
		end
		local frame = object.Frame
		UIUtil.Tween(frame, 0.35, { Position = UDim2.fromOffset(20, 20), Size = UDim2.fromOffset(12, 12), BackgroundTransparency = 0.4 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Debris:AddItem(frame, 0.4)
	end

	local function crash()
		if state == "crash" then
			return
		end
		state = "crash"
		crashTime = 0
		best = math.max(best, math.floor(distance))
		flash.BackgroundTransparency = 0.1
		UIUtil.Tween(flash, 0.45, { BackgroundTransparency = 1 })
		UIUtil.Tween(hero, 0.35, { Rotation = 80 }, Enum.EasingStyle.Back)
		crashSub.Text = CRASH_LINES[random:NextInteger(1, #CRASH_LINES)]
		crashTitle.Text = "💥 AÏE !"
		crashTitleScale.Scale = 0.3
		UIUtil.Tween(crashTitleScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
		UIUtil.Tween(crashTitle, 0.15, { TextTransparency = 0 })
		UIUtil.Tween(crashTitleStroke, 0.15, { Transparency = 0 })
		UIUtil.Tween(crashSub, 0.3, { TextTransparency = 0 })
		UIUtil.Tween(crashSubStroke, 0.3, { Transparency = 0 })
	end

	local function restart()
		state = "run"
		clearObjects()
		speed = BASE_SPEED
		runTime = 0
		waveTravel = WAVE_GAP * 0.4
		coins = 0
		coinLabel.Text = "0"
		distance = 0
		lane = 2
		heroX = LANES[2]
		jumpTime = JUMP_TIME
		hero.Rotation = 0
		bestLabel.Text = best > 0 and ("Record : " .. best .. " m") or ""
		blunderAt = os.clock() + random:NextNumber(45, 90)
		UIUtil.Tween(crashTitle, 0.25, { TextTransparency = 1 })
		UIUtil.Tween(crashTitleStroke, 0.25, { Transparency = 1 })
		UIUtil.Tween(crashSub, 0.25, { TextTransparency = 1 })
		UIUtil.Tween(crashSubStroke, 0.25, { Transparency = 1 })
		showCaption("nouvelle partie 🔁")
	end

	------------------------------------------------------------------
	-- Boucle d'animation
	------------------------------------------------------------------
	ctx.OnRender(function(dt: number)
		dt = math.min(dt, 0.1)
		clock += dt

		-- Nuages
		for _, cloud in ipairs(clouds) do
			cloud.X -= cloud.Speed * dt
			if cloud.X < -50 then
				cloud.X = SW + 50
			end
			cloud.Frame.Position = UDim2.fromOffset(cloud.X, cloud.Y)
		end

		-- Barre de lecture (boucle)
		videoTime = (videoTime + dt) % VIDEO_LENGTH
		local ratio = videoTime / VIDEO_LENGTH
		progressFill.Size = UDim2.fromScale(ratio, 1)
		progressKnob.Position = UDim2.fromScale(ratio, 0.5)
		local second = math.floor(videoTime)
		if second ~= shownSecond then
			shownSecond = second
			timeLabel.Text = string.format("0:%02d / 0:%02d", second, VIDEO_LENGTH)
		end

		-- Vitesse du monde
		if state == "run" then
			runTime += dt
			speed = math.min(MAX_SPEED, BASE_SPEED + runTime * SPEED_RAMP)
		else
			speed = math.max(0, speed - dt * 12)
		end
		local travel = speed * dt
		scroll += travel
		distance += travel * 8

		-- Traverses
		local tieSpan = TIE_COUNT * TIE_GAP
		for _, tie in ipairs(ties) do
			local z = 0.95 + ((tie.Index - 1) * TIE_GAP - scroll) % tieSpan
			local top = HY + G / (z + TIE_DEPTH)
			local bottom = HY + G / z
			local frame = tie.Frame
			if top > SH then
				frame.Visible = false
			else
				frame.Visible = true
				frame.Position = UDim2.fromOffset(CX + tie.X / z, top)
				frame.Size = UDim2.fromOffset(92 / z, math.max(1, bottom - top))
			end
		end

		-- Lampadaires
		local poleSpan = POLE_COUNT * POLE_GAP
		for _, pole in ipairs(poles) do
			local z = 0.7 + ((pole.Index - 1) * POLE_GAP + (pole.Sign > 0 and POLE_GAP * 0.5 or 0) - scroll) % poleSpan
			local px, py = project(pole.Sign * POLE_X, 0, z)
			local zIndex = depthZ(z)
			pole.Pole.Position = UDim2.fromOffset(px, py)
			pole.Pole.Size = UDim2.fromOffset(math.max(1, 6 / z), 124 / z)
			pole.Pole.ZIndex = zIndex
			local ax, ay = project(pole.Sign * POLE_X, 120, z)
			pole.Arm.Position = UDim2.fromOffset(ax, ay)
			pole.Arm.Size = UDim2.fromOffset(34 / z, math.max(1, 4 / z))
			pole.Arm.ZIndex = zIndex
		end

		-- Nouvelles vagues
		if state == "run" then
			waveTravel += travel
			if waveTravel >= WAVE_GAP then
				waveTravel -= WAVE_GAP
				spawnWave()
			end
		end

		-- Décisions du coureur
		local effLane = currentLane()
		if state == "run" then
			if findInLane(lane, "Train", CHAR_Z - 0.3, CHAR_Z + LOOK_AHEAD) then
				-- Un train arrive : on cherche la meilleure voie libre
				local bestLane, bestScore = nil, -math.huge
				for candidate = 1, 3 do
					if candidate ~= lane and laneSafe(candidate) then
						local score = -math.abs(candidate - lane) + coinsAhead(candidate) * 0.3 + random:NextNumber() * 0.1
						if score > bestScore then
							bestLane, bestScore = candidate, score
						end
					end
				end
				if bestLane then
					goToLane(bestLane)
				end
			else
				decideTimer -= dt
				if decideTimer <= 0 then
					decideTimer = random:NextNumber(0.25, 0.5)
					-- Va chercher les pièces (une voie à la fois)
					local here = coinsAhead(lane)
					for _, step in ipairs({ -1, 1 }) do
						local candidate = lane + step
						if candidate >= 1 and candidate <= 3 and laneSafe(candidate) and coinsAhead(candidate) > here and random:NextNumber() < 0.75 then
							goToLane(candidate)
							break
						end
					end
				end
			end

			-- Barrière juste devant : on saute (sauf quand c'est l'heure de la bêtise)
			local reach = CHAR_Z + 0.2 + speed * 0.1
			local barrier = findInLane(effLane, "Barrier", CHAR_Z, reach) or findInLane(lane, "Barrier", CHAR_Z, reach)
			if barrier then
				if blunderAt == math.huge or os.clock() >= blunderAt then
					blunderAt = math.huge -- il "oublie" de sauter
				elseif jumpTime >= JUMP_TIME then
					startJump(1)
				elseif jumpScale < 1 then
					-- Petit saut d'esquive en cours : on le transforme en grand saut
					if jumpTime > 0.3 then
						jumpTime = 0
					end
					jumpScale = 1
				end
			end
		end

		-- Mouvement latéral + saut
		local targetX = LANES[lane]
		heroX += (targetX - heroX) * math.min(1, dt * 14)
		local height = 0
		if jumpTime < JUMP_TIME then
			jumpTime += dt
			height = math.sin(math.pi * math.clamp(jumpTime / JUMP_TIME, 0, 1)) * JUMP_HEIGHT * jumpScale
		end

		-- Objets (déplacement, collisions)
		for i = #objects, 1, -1 do
			local object = objects[i]
			object.Z -= travel
			if object.Z < Z_NEAR then
				removeObject(i)
			else
				local z = object.Z
				local frame = object.Frame
				local gx, gy = project(LANES[object.Lane], object.Lift, z)
				local width = object.Width / z
				if object.Kind == "Coin" then
					width *= math.max(0.18, math.abs(math.cos(clock * 5 + object.Phase)))
				end
				frame.Visible = z <= Z_FAR + 2.5
				frame.Position = UDim2.fromOffset(gx, gy)
				frame.Size = UDim2.fromOffset(width, object.Height / z)
				frame.ZIndex = depthZ(z)

				if state == "run" and object.Lane == effLane and math.abs(z - CHAR_Z) < 0.12 then
					if object.Kind == "Coin" then
						collectCoin(i)
					elseif object.Kind == "Barrier" and height < 14 and z <= CHAR_Z then
						crash()
					elseif object.Kind == "Train" and z <= CHAR_Z + 0.05 then
						crash()
					end
				end
			end
		end

		-- Dessin du coureur
		local screenX = CX + heroX / CHAR_Z
		local running = state == "run"
		if running then
			phase += dt * (10 + speed * 2)
		end
		local bob = running and math.abs(math.sin(phase)) * 3 or 0
		hero.Position = UDim2.fromOffset(screenX, groundY - height - bob + (running and 0 or 10))
		if running then
			hero.Rotation = math.clamp((targetX - heroX) * 0.12, -14, 14)
		end
		if height > 2 then
			legL.Position = UDim2.fromScale(0.32, 0.6)
			legR.Position = UDim2.fromScale(0.68, 0.6)
			armL.Rotation = -150
			armR.Rotation = 150
		else
			local swing = math.sin(phase)
			legL.Position = UDim2.fromScale(0.32, 0.66 + swing * 0.05)
			legR.Position = UDim2.fromScale(0.68, 0.66 - swing * 0.05)
			armL.Rotation = swing * 35
			armR.Rotation = swing * 35
		end
		local shadowScale = 1 - math.clamp(height / JUMP_HEIGHT, 0, 1) * 0.45
		shadow.Position = UDim2.fromOffset(screenX, groundY - 2)
		shadow.Size = UDim2.fromOffset(40 * shadowScale, 10 * shadowScale)

		-- Distance affichée
		local meters = math.floor(distance)
		if meters ~= shownDistance then
			shownDistance = meters
			distanceLabel.Text = meters .. " m"
		end

		-- Chute : pause, puis nouvelle partie
		if state == "crash" then
			crashTime += dt
			local shake = crashTime < 0.3 and (0.3 - crashTime) * 20 or 0
			device.Position = UDim2.fromOffset(random:NextNumber(-shake, shake), random:NextNumber(-shake, shake))
			if crashTime >= 2.2 then
				device.Position = UDim2.new()
				restart()
			end
		end

		-- Sous-titres de temps en temps
		captionTimer -= dt
		if captionTimer <= 0 then
			captionTimer = random:NextNumber(9, 16)
			if state == "run" then
				showCaption(CAPTIONS[random:NextInteger(1, #CAPTIONS)])
			end
		end
	end)
end

function Runner.Stop(_ctx)
	-- Tout est dans ctx.Container (détruit par le StimulusManager)
end

return Runner
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Stocks</string>
            <string name="Source"><![CDATA[--[[
	Stocks (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > Stocks

	Carte "bourse" (slot R1, 288x190) : cours en direct de l'action DOPA
	(commun à tout le serveur, voir StockService) avec un graphique en
	ligne qui défile en douceur, le prix, la variation en %, une petite
	humeur ("🚀 Vers la lune !", "🐻 Aïe aïe aïe"...), le portefeuille du
	joueur (valeur, plus/moins-value, prix moyen d'achat sur le graphique)
	et les boutons Acheter 10 % / 50 % / 100 % et Vendre tout.

	Les achats / ventes passent par la RemoteFunction "StockTrade" : le
	serveur valide tout, on affiche juste son message.
]]

local Stocks = {}
Stocks.Slot = "R1"

-- Dimensions (pixels "design") : la carte est rentrée de 2 px pour que le
-- contour ne soit pas coupé par le slot (ClipsDescendants)
local CARD_W = 284
local CHART_X, CHART_Y = 10, 34
local CHART_W, CHART_H = CARD_W - 20, 78
local PLOT_LEFT, PLOT_TOP = 6, 9
local PLOT_W = CHART_W - PLOT_LEFT - 46 -- place à droite pour les étiquettes min / max
local PLOT_H = CHART_H - 18
local LINE_THICKNESS = 2.5
local SLIDE_TIME = 0.35 -- durée du glissement quand un nouveau point arrive

local UP_COLOR = Color3.fromRGB(22, 170, 80)
local DOWN_COLOR = Color3.fromRGB(225, 45, 55)
local FLAT_COLOR = Color3.fromRGB(120, 120, 130)
local BUY_COLOR = Color3.fromRGB(28, 160, 78)
local AVG_COLOR = Color3.fromRGB(30, 136, 229)

-- Humeur du marché selon la variation sur le graphique
local function getMood(change: number): string
	if change >= 0.05 then
		return "🚀 Vers la lune !"
	elseif change >= 0.015 then
		return "🐂 Ça monte !"
	elseif change <= -0.05 then
		return "💀 C'est la chute..."
	elseif change <= -0.015 then
		return "🐻 Aïe aïe aïe"
	end
	return "😐 Ça stagne..."
end

-- Petites phrases après une transaction réussie
local BUY_JOKES = { "📈 Investi !", "🤑 Pari osé !", "💼 Trader pro", "🙏 Pourvu que ça monte" }
local SELL_JOKES = { "💰 Vendu !", "💸 Encaissé !", "😎 Bien joué", "🏃 On se retire" }

local function formatPrice(price: number): string
	if price >= 1000 then
		return string.format("%.0f", price)
	end
	return string.format("%.2f", price)
end

local function formatPercent(ratio: number): string
	return string.format("%+.1f %%", ratio * 100)
end

function Stocks.Start(ctx)
	local UI = ctx.UIUtil
	local Theme = ctx.Theme
	local Format = ctx.Format
	local stockConfig = ctx.Config.Stocks
	local maxPoints = math.max(2, stockConfig.HistoryLength or 60)
	local random = Random.new()

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	local function formatAmount(value: number): string
		if value < 1e6 then
			return Format.WithSpaces(value)
		end
		return Format.Format(value)
	end

	------------------------------------------------------------------
	-- Carte
	------------------------------------------------------------------
	local card = UI.Create("Frame", {
		Name = "Card",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -4, 1, -4),
		BackgroundColor3 = Theme.Colors.Card,
		BorderSizePixel = 0,
		Parent = ctx.Container,
	})
	UI.Corner(card, 14)
	UI.Stroke(card, Theme.Colors.CardBorder, 2)

	-- En-tête : titre, prix, variation
	UI.Label({
		Name = "Title",
		Text = "📈 " .. tostring(stockConfig.Symbol or "DOPA"),
		Font = Theme.Fonts.Title,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(10, 6),
		Size = UDim2.fromOffset(92, 22),
		MaxTextSize = 19,
		Parent = card,
	})

	local priceLabel = UI.Label({
		Name = "Price",
		Text = "--",
		Font = Theme.Fonts.Number,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -78, 0, 5),
		Size = UDim2.fromOffset(104, 24),
		MaxTextSize = 21,
		Parent = card,
	})
	local priceScale = UI.Create("UIScale", { Parent = priceLabel })

	local changePill = UI.Create("Frame", {
		Name = "Change",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 7),
		Size = UDim2.fromOffset(62, 20),
		BackgroundColor3 = FLAT_COLOR,
		BorderSizePixel = 0,
		Parent = card,
	})
	UI.Corner(changePill, UDim.new(1, 0))
	local changeLabel = UI.Label({
		Text = "0.0 %",
		Font = Theme.Fonts.Number,
		TextColor3 = Theme.Colors.TextLight,
		Size = UDim2.new(1, -8, 1, -4),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		MaxTextSize = 13,
		Parent = changePill,
	})

	------------------------------------------------------------------
	-- Graphique
	------------------------------------------------------------------
	local chart = UI.Create("Frame", {
		Name = "Chart",
		Position = UDim2.fromOffset(CHART_X, CHART_Y),
		Size = UDim2.fromOffset(CHART_W, CHART_H),
		BackgroundColor3 = Color3.fromRGB(246, 248, 250),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = card,
	})
	UI.Corner(chart, 8)
	UI.Stroke(chart, Color3.fromRGB(210, 214, 220), 1)

	-- Lignes de repère
	for i = 0, 2 do
		UI.Create("Frame", {
			Name = "Grid",
			Position = UDim2.fromOffset(PLOT_LEFT, PLOT_TOP + math.floor(PLOT_H * i / 2)),
			Size = UDim2.fromOffset(PLOT_W, 1),
			BackgroundColor3 = Color3.fromRGB(222, 226, 232),
			BorderSizePixel = 0,
			ZIndex = 1,
			Parent = chart,
		})
	end

	local function axisLabel(y: number): TextLabel
		return UI.Label({
			Text = "",
			Font = Theme.Fonts.Mono,
			TextColor3 = Theme.Colors.TextDim,
			TextXAlignment = Enum.TextXAlignment.Right,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -4, 0, y),
			Size = UDim2.fromOffset(42, 12),
			MaxTextSize = 10,
			ZIndex = 2,
			Parent = chart,
		})
	end
	local maxLabel = axisLabel(PLOT_TOP)
	local minLabel = axisLabel(PLOT_TOP + PLOT_H)

	-- Prix moyen d'achat du joueur (ligne bleue)
	local avgLine = UI.Create("Frame", {
		Name = "AvgLine",
		Position = UDim2.fromOffset(PLOT_LEFT, 0),
		Size = UDim2.fromOffset(PLOT_W, 1),
		BackgroundColor3 = AVG_COLOR,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 2,
		Parent = chart,
	})
	UI.Label({
		Text = "ton prix moyen",
		Font = Theme.Fonts.Body,
		TextColor3 = AVG_COLOR,
		TextXAlignment = Enum.TextXAlignment.Left,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromOffset(2, -1),
		Size = UDim2.fromOffset(80, 10),
		MaxTextSize = 9,
		ZIndex = 2,
		Parent = avgLine,
	})

	-- Réserve de segments (réutilisés à chaque mise à jour)
	local segments: { Frame } = {}
	local function getSegment(index: number): Frame
		local segment = segments[index]
		if not segment then
			segment = UI.Create("Frame", {
				Name = "Segment",
				AnchorPoint = Vector2.new(0.5, 0.5),
				BorderSizePixel = 0,
				BackgroundColor3 = FLAT_COLOR,
				ZIndex = 3,
				Parent = chart,
			})
			UI.Corner(segment, UDim.new(1, 0))
			segments[index] = segment
		end
		return segment
	end

	-- Point "en direct" au bout de la courbe (+ anneau qui pulse)
	local dotRing = UI.Create("Frame", {
		Name = "DotRing",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(9, 9),
		BackgroundColor3 = FLAT_COLOR,
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 4,
		Parent = chart,
	})
	UI.Corner(dotRing, UDim.new(1, 0))
	local dotRingScale = UI.Create("UIScale", { Parent = dotRing })
	local dot = UI.Create("Frame", {
		Name = "Dot",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(8, 8),
		BackgroundColor3 = FLAT_COLOR,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 5,
		Parent = chart,
	})
	UI.Corner(dot, UDim.new(1, 0))
	UI.Stroke(dot, Color3.new(1, 1, 1), 1.5)

	-- Humeur du marché (petite étiquette en haut à gauche)
	local moodLabel = UI.Create("TextLabel", {
		Name = "Mood",
		Text = "⏳ Ouverture...",
		Font = Theme.Fonts.Title,
		TextSize = 11,
		TextColor3 = Theme.Colors.Text,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 16),
		Position = UDim2.fromOffset(5, 4),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		ZIndex = 6,
		Parent = chart,
	})
	UI.Corner(moodLabel, 6)
	UI.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 5),
		PaddingRight = UDim.new(0, 5),
		Parent = moodLabel,
	})

	local loadingLabel = UI.Label({
		Text = "Chargement du cours... ⏳",
		TextColor3 = Theme.Colors.TextDim,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 6),
		Size = UDim2.fromOffset(200, 18),
		MaxTextSize = 13,
		ZIndex = 6,
		Parent = chart,
	})

	------------------------------------------------------------------
	-- Portefeuille
	------------------------------------------------------------------
	local holdings = UI.Create("Frame", {
		Name = "Holdings",
		Position = UDim2.fromOffset(10, 116),
		Size = UDim2.fromOffset(CHART_W, 28),
		BackgroundColor3 = Theme.Colors.PanelLight,
		BorderSizePixel = 0,
		Parent = card,
	})
	UI.Corner(holdings, 8)
	local valueLabel = UI.Label({
		Name = "Value",
		Text = "",
		RichText = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(8, 4),
		Size = UDim2.new(0.55, -8, 1, -8),
		MaxTextSize = 14,
		Parent = holdings,
	})
	local profitLabel = UI.Label({
		Name = "Profit",
		Text = "",
		Font = Theme.Fonts.Number,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 4),
		Size = UDim2.new(0.45, -8, 1, -8),
		MaxTextSize = 13,
		Parent = holdings,
	})

	------------------------------------------------------------------
	-- Boutons
	------------------------------------------------------------------
	local function hasFraction(value: number): boolean
		for _, fraction in ipairs(stockConfig.Fractions or {}) do
			if math.abs(fraction - value) < 1e-6 then
				return true
			end
		end
		return false
	end

	-- Fractions d'achat affichées : 10 %, 50 %, 100 % (si le serveur les accepte)
	local buyFractions = {}
	for _, fraction in ipairs({ 0.1, 0.5, 1 }) do
		if hasFraction(fraction) then
			table.insert(buyFractions, fraction)
		end
	end
	if #buyFractions == 0 then
		for i, fraction in ipairs(stockConfig.Fractions or {}) do
			if i > 3 then
				break
			end
			table.insert(buyFractions, fraction)
		end
	end

	local buttonRow = UI.Create("Frame", {
		Name = "Buttons",
		Position = UDim2.fromOffset(10, 150),
		Size = UDim2.fromOffset(CHART_W, 30),
		BackgroundTransparency = 1,
		Parent = card,
	})
	UI.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 4),
		Parent = buttonRow,
	})

	local sellWidth = 72
	local buyWidth = math.floor((CHART_W - sellWidth - 4 * #buyFractions) / math.max(1, #buyFractions))

	local function makeButton(text: string, color: Color3, width: number, order: number): TextButton
		local button = UI.NeonButton({
			Name = "Trade",
			Text = text,
			Color = color,
			Size = UDim2.fromOffset(width, 30),
			CornerRadius = 9,
			StrokeThickness = 1.5,
			MaxTextSize = 14,
			LayoutOrder = order,
			Parent = buttonRow,
		})
		local padding = button:FindFirstChildOfClass("UIPadding")
		if padding then
			padding.PaddingLeft = UDim.new(0, 3)
			padding.PaddingRight = UDim.new(0, 3)
		end
		return button
	end

	local buyButtons: { TextButton } = {}
	for i, fraction in ipairs(buyFractions) do
		local text = "📈 " .. tostring(math.floor(fraction * 100 + 0.5)) .. "%"
		local button = makeButton(text, BUY_COLOR, buyWidth, i)
		button:SetAttribute("Fraction", fraction)
		table.insert(buyButtons, button)
	end
	local sellButton = makeButton("💸 Vendre", Theme.Colors.Red, sellWidth, 10)

	------------------------------------------------------------------
	-- Données et rendu
	------------------------------------------------------------------
	local values: { number } = {}
	local prevLast = 0 -- dernier prix AVANT la mise à jour (pour animer la fin de courbe)
	local slideStart = -math.huge
	local rangeMin, rangeMax = 0, 1
	local targetMin, targetMax = 0, 1
	local lineColor = FLAT_COLOR
	local displayPrice = 0
	local targetPrice = 0
	local dirty = true

	local function getHoldings(): (number, number)
		local data = ctx.State.Data
		local stock = data and data.Stock
		if type(stock) ~= "table" then
			return 0, 0
		end
		return tonumber(stock.Shares) or 0, tonumber(stock.CostBasis) or 0
	end

	-- Recalcule la plage verticale visée (avec une petite marge)
	local function computeRange()
		local lo, hi = math.huge, -math.huge
		for _, value in ipairs(values) do
			lo = math.min(lo, value)
			hi = math.max(hi, value)
		end
		if lo == math.huge then
			lo, hi = 0, 1
		end
		local span = hi - lo
		local minSpan = math.max(hi * 0.02, 0.5)
		if span < minSpan then
			local mid = (hi + lo) / 2
			lo, hi = mid - minSpan / 2, mid + minSpan / 2
			span = minSpan
		end
		targetMin = lo - span * 0.12
		targetMax = hi + span * 0.12
	end

	local function redraw(alpha: number)
		local count = #values
		if count < 2 then
			for _, segment in ipairs(segments) do
				segment.Visible = false
			end
			dot.Visible = false
			dotRing.Visible = false
			avgLine.Visible = false
			loadingLabel.Visible = true
			return
		end
		loadingLabel.Visible = false

		local spacing = PLOT_W / (maxPoints - 1)
		local span = math.max(rangeMax - rangeMin, 1e-6)
		local offset = (1 - alpha) * spacing
		local prevX, prevY = 0, 0
		for i = 1, count do
			local value = values[i]
			if i == count then
				value = prevLast + (value - prevLast) * alpha
			end
			local x = PLOT_LEFT + PLOT_W - (count - i) * spacing + offset
			local y = PLOT_TOP + PLOT_H * (1 - (value - rangeMin) / span)
			if i > 1 then
				local segment = getSegment(i - 1)
				local dx, dy = x - prevX, y - prevY
				local length = math.sqrt(dx * dx + dy * dy)
				segment.Position = UDim2.fromOffset((x + prevX) / 2, (y + prevY) / 2)
				segment.Size = UDim2.fromOffset(length + LINE_THICKNESS * 0.6, LINE_THICKNESS)
				segment.Rotation = math.deg(math.atan2(dy, dx))
				segment.BackgroundColor3 = lineColor
				segment.Visible = true
			end
			prevX, prevY = x, y
		end
		for j = count, #segments do
			segments[j].Visible = false
		end

		dot.Position = UDim2.fromOffset(prevX, prevY)
		dot.BackgroundColor3 = lineColor
		dot.Visible = true
		dotRing.Position = dot.Position
		dotRing.BackgroundColor3 = lineColor
		dotRing.Visible = true

		-- Prix moyen d'achat (seulement s'il est dans le cadre)
		local shares, costBasis = getHoldings()
		if shares > 1e-9 and costBasis > 0 then
			local average = costBasis / shares
			local y = PLOT_TOP + PLOT_H * (1 - (average - rangeMin) / span)
			avgLine.Position = UDim2.fromOffset(PLOT_LEFT, math.floor(y))
			avgLine.Visible = y >= 2 and y <= CHART_H - 2
		else
			avgLine.Visible = false
		end

		maxLabel.Text = formatPrice(rangeMax)
		minLabel.Text = formatPrice(math.max(0, rangeMin))
	end

	-- Texte du portefeuille (valeur + plus/moins-value)
	local function refreshHoldings()
		local shares, costBasis = getHoldings()
		local price = targetPrice
		if shares <= 1e-9 then
			valueLabel.Text = '💼 <font color="#777777">Aucune action</font>'
			profitLabel.Text = "Achète bas, vends haut 😏"
			profitLabel.TextColor3 = Theme.Colors.TextDim
			profitLabel.Font = Theme.Fonts.Body
		else
			local value = shares * price
			local sharesText = shares < 100 and string.format("%.2f", shares) or Format.Format(shares)
			valueLabel.Text = "💼 <b>" .. formatAmount(value) .. '</b> <font color="#777777">· ' .. sharesText .. " act.</font>"
			local profit = value - costBasis
			local ratio = costBasis > 0 and profit / costBasis or 0
			local sign = profit >= 0 and "+" or "-"
			profitLabel.Text = formatPercent(ratio) .. " (" .. sign .. formatAmount(math.abs(profit)) .. ")"
			profitLabel.TextColor3 = profit >= 0 and UP_COLOR or DOWN_COLOR
			profitLabel.Font = Theme.Fonts.Number
		end

		-- Boutons : grisés si impossible
		local data = ctx.State.Data
		local dopamine = data and tonumber(data.Dopamine) or 0
		for _, button in ipairs(buyButtons) do
			UI.SetButtonEnabled(button, dopamine >= 1)
		end
		UI.SetButtonEnabled(sellButton, shares > 1e-9)
	end

	local function applyStock(stock)
		if type(stock) ~= "table" then
			return
		end
		local history = type(stock.History) == "table" and stock.History or {}
		local previousLast = values[#values]
		local newValues = {}
		local first = math.max(1, #history - maxPoints + 1)
		for i = first, #history do
			local value = tonumber(history[i])
			if value then
				table.insert(newValues, value)
			end
		end
		local price = tonumber(stock.Price)
		if #newValues == 0 and price then
			newValues = { price }
		end
		values = newValues

		local last = values[#values] or price or 0
		prevLast = previousLast or last
		targetPrice = price or last
		if displayPrice == 0 then
			displayPrice = targetPrice
		end

		-- Animation : la courbe glisse d'un cran vers la gauche
		if previousLast ~= nil then
			slideStart = os.clock()
		else
			slideStart = -math.huge
		end

		-- Variation sur la fenêtre affichée
		local firstValue = values[1] or last
		local change = firstValue > 0 and (last - firstValue) / firstValue or 0
		if change > 0.0005 then
			lineColor = UP_COLOR
		elseif change < -0.0005 then
			lineColor = DOWN_COLOR
		else
			lineColor = FLAT_COLOR
		end
		changePill.BackgroundColor3 = lineColor
		changeLabel.Text = formatPercent(change)
		if #values >= 2 then
			local mood = getMood(change)
			if moodLabel.Text ~= mood then
				moodLabel.Text = mood
				moodLabel.Rotation = random:NextNumber(-6, 6)
				UI.Tween(moodLabel, 0.4, { Rotation = 0 }, Enum.EasingStyle.Back)
			end
		end

		-- Petit "flash" du prix
		if previousLast ~= nil and last ~= previousLast then
			priceLabel.TextColor3 = last > previousLast and UP_COLOR or DOWN_COLOR
			UI.Tween(priceLabel, 0.7, { TextColor3 = Theme.Colors.Text })
			priceScale.Scale = 1.12
			UI.Tween(priceScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		end

		computeRange()
		if previousLast == nil then
			rangeMin, rangeMax = targetMin, targetMax
		end
		dirty = true
		refreshHoldings()
	end

	applyStock(ctx.State.Stock)
	ctx.Connect(ctx.State.StockChanged, applyStock)
	ctx.Connect(ctx.State.Changed, function()
		refreshHoldings()
		dirty = true
	end)
	refreshHoldings()

	-- Rendu : glissement, plage lissée, prix qui "compte", anneau qui pulse
	local clock = 0
	ctx.OnRender(function(dt: number)
		clock += dt
		local elapsed = os.clock() - slideStart
		local alpha = 1
		if elapsed < SLIDE_TIME then
			local t = math.clamp(elapsed / SLIDE_TIME, 0, 1)
			alpha = 1 - (1 - t) * (1 - t) -- ease out
			dirty = true
		end

		local k = math.min(1, dt * 6)
		if math.abs(rangeMin - targetMin) > 1e-4 or math.abs(rangeMax - targetMax) > 1e-4 then
			rangeMin += (targetMin - rangeMin) * k
			rangeMax += (targetMax - rangeMax) * k
			dirty = true
		end

		if dirty then
			dirty = false
			redraw(alpha)
		end

		if math.abs(displayPrice - targetPrice) > 0.004 then
			displayPrice += (targetPrice - displayPrice) * math.min(1, dt * 8)
			if math.abs(displayPrice - targetPrice) <= 0.004 then
				displayPrice = targetPrice
			end
			priceLabel.Text = formatPrice(displayPrice)
		elseif priceLabel.Text == "--" and targetPrice > 0 then
			priceLabel.Text = formatPrice(targetPrice)
		end

		local pulse = (clock % 1.2) / 1.2
		dotRingScale.Scale = 1 + pulse * 1.6
		dotRing.BackgroundTransparency = 0.45 + pulse * 0.55
	end)

	------------------------------------------------------------------
	-- Transactions
	------------------------------------------------------------------
	local busy = false
	local lastTrade = 0
	local cooldown = tonumber(stockConfig.TradeCooldown) or 0.5

	-- Texte flottant + pièces au-dessus du bouton cliqué
	local function feedback(button: TextButton, text: string, color: Color3)
		-- Conversion pixels écran -> pixels "design" de la carte (UIScale)
		local scale = card.AbsoluteSize.X / CARD_W
		local x = CARD_W / 2
		if scale > 0 then
			x = (button.AbsolutePosition.X + button.AbsoluteSize.X / 2 - card.AbsolutePosition.X) / scale
		end
		x = math.clamp(x, 60, CARD_W - 60)
		ctx.FloatText(card, UDim2.fromOffset(x, 136), text, color, 22)
		if effectsOn() then
			ctx.Effects.Burst(card, UDim2.fromOffset(x, 150), Theme.Colors.Gold, 8)
		end
	end

	local function trade(action: string, fraction: number, button: TextButton)
		if busy or os.clock() - lastTrade < cooldown then
			UI.Shake(button)
			return
		end
		if button:GetAttribute("Enabled") == false then
			ctx.Sound.Play("Error")
			UI.Shake(button)
			if action == "sell" then
				ctx.Notify("Tu n'as aucune action à vendre 🤷", Theme.Colors.Red)
			else
				ctx.Notify("Pas assez de Dopamine pour investir 😅", Theme.Colors.Red)
			end
			return
		end
		busy = true
		lastTrade = os.clock()
		task.spawn(function()
			local ok, success, message = pcall(function()
				return ctx.Net.Function("StockTrade"):InvokeServer(action, fraction)
			end)
			busy = false
			if not ctx.IsAlive() then
				return
			end
			if ok and success then
				ctx.Sound.Play("Cash", action == "sell" and 1.15 or 1)
				local jokes = action == "sell" and SELL_JOKES or BUY_JOKES
				local text = jokes[random:NextInteger(1, #jokes)]
				feedback(button, text, action == "sell" and Theme.Colors.Gold or UP_COLOR)
				ctx.Notify(type(message) == "string" and message or text, action == "sell" and Theme.Colors.Gold or UP_COLOR)
			else
				ctx.Sound.Play("Error")
				UI.Shake(button)
				local text = ok and type(message) == "string" and message or "La bourse ne répond pas... 😵"
				ctx.Notify(text, Theme.Colors.Red)
			end
		end)
	end

	for _, button in ipairs(buyButtons) do
		local fraction = button:GetAttribute("Fraction") :: number
		ctx.Connect(button.Activated, function()
			trade("buy", fraction, button)
		end)
	end
	ctx.Connect(sellButton.Activated, function()
		trade("sell", 1, sellButton)
	end)
end

return Stocks
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Weather</string>
            <string name="Source"><![CDATA[--[[
	Weather (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > Weather

	Orage miniature : deux petits nuages mignons (avec une tête !) dérivent
	en haut de l'écran, de part et d'autre de la colonne centrale, et font
	tomber une petite pluie. Quand le SERVEUR envoie un Spawn "Lightning",
	un éclair en zigzag (dessiné en code : contour sombre, cœur jaune, halo)
	tombe d'un nuage fâché en (X, Y), avec flash et tonnerre. Il faut
	cliquer dessus avant qu'il ne disparaisse (Lifetime) : ClaimSpawn, et
	le "+X" confirmé (OnBonus "Lightning") s'affiche à l'impact.
]]

local Debris = game:GetService("Debris")

local Weather = {}
Weather.Slot = "Overlay"

local MAX_BOLTS = 3
local CLOUD_W = 112
local CLOUD_H = 58
local DROPS_PER_CLOUD = 10
local DROPS_LOW_EFFECTS = 4
local RAIN_FALL = 70 -- distance de chute des gouttes (pixels "design")

local BOLT_W = 150
local BOLT_H = 232
local BOLT_TOP = 48 -- départ de l'éclair (sous le petit nuage)
local BOLT_IMPACT = 198 -- point d'impact dans le cadre de l'éclair
local BOLT_ANCHOR_Y = BOLT_IMPACT / BOLT_H

local TAGS = { "⚡ attrape !", "⚡ vite !", "⚡ zap ?", "⚡ clique !", "⚡ ici !" }
local CHEERS = { "ÉLECTRISANT !", "ZAP !", "QUEL RÉFLEXE !", "FOUDROYANT !", "CHOC !", "100 000 VOLTS !" }

function Weather.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local container: Frame = ctx.Container
	local random = Random.new()

	local yellow = Theme.Colors.Yellow
	local boltCore = Color3.fromRGB(255, 244, 150)
	local boltOutline = Color3.fromRGB(70, 45, 0)
	local cloudColor = Color3.fromRGB(176, 186, 202)
	local cloudAngry = Color3.fromRGB(120, 128, 146)
	local stormColor = Color3.fromRGB(96, 104, 122)
	local rainColor = Color3.fromRGB(80, 150, 225)
	local faceColor = Color3.fromRGB(40, 40, 50)

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	local function circle(parent: Instance, x: number, y: number, diameter: number, color: Color3, zIndex: number): Frame
		local frame = UIUtil.Create("Frame", {
			Size = UDim2.fromOffset(diameter, diameter),
			Position = UDim2.fromOffset(x, y),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			ZIndex = zIndex,
			Parent = parent,
		})
		UIUtil.Corner(frame, UDim.new(1, 0))
		return frame
	end

	-- Segment de droite (cadre tourné) entre deux points
	local function line(parent: Instance, a: Vector2, b: Vector2, thickness: number, color: Color3, zIndex: number, transparency: number?): Frame
		local delta = b - a
		local middle = (a + b) / 2
		local frame = UIUtil.Create("Frame", {
			Size = UDim2.fromOffset(delta.Magnitude + thickness, thickness),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(middle.X, middle.Y),
			Rotation = math.deg(math.atan2(delta.Y, delta.X)),
			BackgroundColor3 = color,
			BackgroundTransparency = transparency or 0,
			BorderSizePixel = 0,
			ZIndex = zIndex,
			Parent = parent,
		})
		UIUtil.Corner(frame, UDim.new(1, 0))
		return frame
	end

	------------------------------------------------------------------
	-- Nuage mignon (bouffées rondes + petite tête)
	------------------------------------------------------------------
	local function makeCloud(parent: Instance, color: Color3, zIndex: number)
		local root = UIUtil.Create("Frame", {
			Name = "Cloud",
			Size = UDim2.fromOffset(CLOUD_W, CLOUD_H),
			BackgroundTransparency = 1,
			ZIndex = zIndex,
			Parent = parent,
		})
		local puffs = {
			circle(root, 10, 12, 36, color, zIndex),
			circle(root, 32, 0, 48, color, zIndex),
			circle(root, 62, 8, 40, color, zIndex),
			circle(root, 80, 22, 30, color, zIndex),
		}
		local base = UIUtil.Create("Frame", {
			Size = UDim2.fromOffset(96, 30),
			Position = UDim2.fromOffset(8, 26),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			ZIndex = zIndex,
			Parent = root,
		})
		UIUtil.Corner(base, UDim.new(1, 0))
		table.insert(puffs, base)
		-- Reflet clair sur le dessus
		local shine = circle(root, 42, 6, 18, Color3.new(1, 1, 1), zIndex + 1)
		shine.BackgroundTransparency = 0.55

		-- Visage
		local eyeL = UIUtil.Create("Frame", {
			Size = UDim2.fromOffset(6, 8),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(46, 34),
			BackgroundColor3 = faceColor,
			BorderSizePixel = 0,
			ZIndex = zIndex + 2,
			Parent = root,
		})
		UIUtil.Corner(eyeL, UDim.new(1, 0))
		local eyeR = eyeL:Clone()
		eyeR.Position = UDim2.fromOffset(66, 34)
		eyeR.Parent = root
		local mouth = UIUtil.Create("Frame", {
			Size = UDim2.fromOffset(10, 4),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(56, 44),
			BackgroundColor3 = faceColor,
			BorderSizePixel = 0,
			ZIndex = zIndex + 2,
			Parent = root,
		})
		UIUtil.Corner(mouth, UDim.new(1, 0))
		local cheekL = circle(root, 34, 38, 9, Color3.fromRGB(255, 130, 160), zIndex + 1)
		cheekL.BackgroundTransparency = 0.45
		local cheekR = circle(root, 69, 38, 9, Color3.fromRGB(255, 130, 160), zIndex + 1)
		cheekR.BackgroundTransparency = 0.45
		-- Sourcils fâchés (cachés par défaut)
		local browL = UIUtil.Create("Frame", {
			Size = UDim2.fromOffset(11, 3),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(45, 26),
			Rotation = 25,
			BackgroundColor3 = faceColor,
			BorderSizePixel = 0,
			Visible = false,
			ZIndex = zIndex + 2,
			Parent = root,
		})
		local browR = browL:Clone()
		browR.Position = UDim2.fromOffset(67, 26)
		browR.Rotation = -25
		browR.Parent = root

		return {
			Root = root,
			Puffs = puffs,
			EyeL = eyeL,
			EyeR = eyeR,
			Mouth = mouth,
			Brows = { browL, browR },
			Color = color,
			Angry = false,
		}
	end

	local function setAngry(cloud, angry: boolean, normalColor: Color3, angryColor: Color3)
		if cloud.Angry == angry then
			return
		end
		cloud.Angry = angry
		for _, brow in ipairs(cloud.Brows) do
			brow.Visible = angry
		end
		for _, puff in ipairs(cloud.Puffs) do
			puff.BackgroundColor3 = angry and angryColor or normalColor
		end
		-- Bouche : ronde ("oh !") si fâché, petit sourire sinon
		cloud.Mouth.Size = angry and UDim2.fromOffset(8, 8) or UDim2.fromOffset(10, 4)
	end

	------------------------------------------------------------------
	-- Nuages d'ambiance (à gauche et à droite de la colonne centrale)
	------------------------------------------------------------------
	local ambient = {}
	local ranges = {
		{ Min = 0.015, Max = 0.17, Anchor = 0 },
		{ Min = 0.83, Max = 0.985, Anchor = 1 },
	}
	local dropCount = effectsOn() and DROPS_PER_CLOUD or DROPS_LOW_EFFECTS
	for index, range in ipairs(ranges) do
		local cloud = makeCloud(container, cloudColor, 5)
		cloud.Root.AnchorPoint = Vector2.new(range.Anchor, 0)
		cloud.Range = range
		cloud.Phase = random:NextNumber(0, math.pi * 2) + index
		cloud.NextBlink = os.clock() + random:NextNumber(1, 4)
		cloud.BlinkUntil = 0
		cloud.AngryUntil = 0
		cloud.Drops = {}
		for _ = 1, dropCount do
			local drop = UIUtil.Create("Frame", {
				Size = UDim2.fromOffset(2, 10),
				AnchorPoint = Vector2.new(0.5, 0),
				Rotation = 12,
				BackgroundColor3 = rainColor,
				BorderSizePixel = 0,
				ZIndex = 4,
				Parent = cloud.Root,
			})
			table.insert(cloud.Drops, {
				Frame = drop,
				X = random:NextNumber(16, CLOUD_W - 16),
				Y = random:NextNumber(0, RAIN_FALL),
				Speed = random:NextNumber(90, 140),
			})
		end
		table.insert(ambient, cloud)
	end

	------------------------------------------------------------------
	-- Éclairs
	------------------------------------------------------------------
	local bolts: { [string]: any } = {}
	local boltCount = 0
	local positions: { [string]: UDim2 } = {}
	local lastPosition = UDim2.fromScale(0.5, 0.5)

	local function fadeAll(root: Instance, duration: number)
		for _, item in ipairs(root:GetDescendants()) do
			if item:IsA("TextLabel") then
				UIUtil.Tween(item, duration, { TextTransparency = 1, BackgroundTransparency = 1 })
			elseif item:IsA("Frame") then
				UIUtil.Tween(item, duration, { BackgroundTransparency = 1 })
			elseif item:IsA("UIStroke") then
				UIUtil.Tween(item, duration, { Transparency = 1 })
			end
		end
	end

	local function removeBolt(bolt, claimed: boolean)
		if bolt.Done then
			return
		end
		bolt.Done = true
		bolts[bolt.Id] = nil
		boltCount -= 1
		if claimed then
			UIUtil.Tween(bolt.Scale, 0.3, { Scale = 1.35 }, Enum.EasingStyle.Quad)
		else
			UIUtil.Tween(bolt.Scale, 0.35, { Scale = 0.85 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end
		fadeAll(bolt.Root, 0.3)
		Debris:AddItem(bolt.Root, 0.4)
	end

	-- Le nuage d'ambiance le plus proche se fâche
	local function angerNearestCloud(x: number)
		local best, bestDistance = nil, math.huge
		for _, cloud in ipairs(ambient) do
			local center = (cloud.Range.Min + cloud.Range.Max) / 2
			local distance = math.abs(center - x)
			if distance < bestDistance then
				best, bestDistance = cloud, distance
			end
		end
		if best then
			best.AngryUntil = os.clock() + 1.4
		end
	end

	local function spawnBolt(info)
		if not ctx.IsAlive() or type(info) ~= "table" or type(info.Id) ~= "string" then
			return
		end
		if bolts[info.Id] or boltCount >= MAX_BOLTS then
			return
		end
		local x = math.clamp(tonumber(info.X) or 0.5, 0.06, 0.94)
		local y = math.clamp(tonumber(info.Y) or 0.5, 0.1, 0.92)
		local lifetime = math.max(1, tonumber(info.Lifetime) or 2.5)
		local variant = math.floor(tonumber(info.Variant) or 1)
		local shape = Random.new(variant) -- forme déterministe selon la variante

		-- Décalage pour que le petit nuage ne sorte pas par le haut
		local extra = math.max(0, BOLT_IMPACT + 34 - y * 720)
		local position = UDim2.new(x, 0, y, extra)

		local root = UIUtil.Create("TextButton", {
			Name = "Lightning",
			Size = UDim2.fromOffset(BOLT_W, BOLT_H),
			AnchorPoint = Vector2.new(0.5, BOLT_ANCHOR_Y),
			Position = position,
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Text = "",
			ZIndex = 30,
			Parent = container,
		})
		local scale = UIUtil.Create("UIScale", { Scale = 1, Parent = root })

		-- Petit nuage d'orage, fâché
		local storm = makeCloud(root, stormColor, 36)
		storm.Root.Position = UDim2.fromOffset((BOLT_W - CLOUD_W) / 2, 0)
		setAngry(storm, true, stormColor, stormColor)

		-- Points du zigzag
		local points = {}
		local steps = 6
		for i = 0, steps do
			local py = BOLT_TOP + (BOLT_IMPACT - BOLT_TOP) * i / steps
			local px = BOLT_W / 2
			if i > 0 and i < steps then
				local side = (i % 2 == 1) and 1 or -1
				if variant % 2 == 0 then
					side = -side
				end
				px += side * shape:NextNumber(10, 24)
			elseif i == steps then
				px += shape:NextNumber(-6, 6)
			end
			table.insert(points, Vector2.new(px, py))
		end

		-- Segments : halo, contour sombre, cœur jaune (révélés un par un)
		local steps2: { { Frame } } = {}
		local cores: { Frame } = {}
		local glows: { Frame } = {}
		local function addSegment(a: Vector2, b: Vector2, width: number)
			local glow = line(root, a, b, width + 14, yellow, 31, 0.7)
			local outline = line(root, a, b, width + 4, boltOutline, 32)
			local core = line(root, a, b, width, boltCore, 33)
			glow.Visible, outline.Visible, core.Visible = false, false, false
			table.insert(steps2, { glow, outline, core })
			table.insert(cores, core)
			table.insert(glows, glow)
		end
		for i = 1, #points - 1 do
			addSegment(points[i], points[i + 1], 6)
			-- Petite branche sur le 2e coude
			if i == 2 then
				local from = points[3]
				local side = (from.X > BOLT_W / 2) and 1 or -1
				local mid = from + Vector2.new(side * 26, 22)
				addSegment(from, mid, 3)
				addSegment(mid, mid + Vector2.new(side * 8, 18), 2)
			end
		end

		-- Impact : halo + anneau qui pulse
		local impact = points[#points]
		local impactGlow = circle(root, impact.X - 22, impact.Y - 22, 44, yellow, 30)
		impactGlow.BackgroundTransparency = 0.5
		local ring = UIUtil.Create("Frame", {
			Size = UDim2.fromOffset(64, 64),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(impact.X, impact.Y),
			BackgroundTransparency = 1,
			ZIndex = 30,
			Parent = root,
		})
		UIUtil.Corner(ring, UDim.new(1, 0))
		local ringStroke = UIUtil.Stroke(ring, yellow, 3, 0.1)
		local ringScale = UIUtil.Create("UIScale", { Parent = ring })

		-- Étiquette
		local tag = UIUtil.Label({
			Text = TAGS[random:NextInteger(1, #TAGS)],
			Font = Theme.Fonts.Title,
			TextColor3 = Theme.Colors.TextDark,
			BackgroundColor3 = yellow,
			BackgroundTransparency = 0,
			Size = UDim2.fromOffset(92, 22),
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromOffset(BOLT_W / 2, BOLT_IMPACT + 10),
			MaxTextSize = 15,
			ZIndex = 38,
			Parent = root,
		})
		UIUtil.Corner(tag, UDim.new(1, 0))
		UIUtil.Stroke(tag, Theme.Colors.Border, 1.5, 0.1)

		local bolt = {
			Id = info.Id,
			Root = root,
			Scale = scale,
			Cores = cores,
			Glows = glows,
			ImpactGlow = impactGlow,
			RingScale = ringScale,
			RingStroke = ringStroke,
			Storm = storm,
			Base = position,
			Born = os.clock(),
			Lifetime = lifetime,
			Done = false,
		}
		bolts[info.Id] = bolt
		boltCount += 1

		-- Frappe : le zigzag se dessine de haut en bas
		task.spawn(function()
			for _, group in ipairs(steps2) do
				if bolt.Done or not root.Parent then
					return
				end
				for _, frame in ipairs(group) do
					frame.Visible = true
				end
				task.wait(0.02)
			end
		end)

		ctx.Sound.Play("Thunder", 0.8 + random:NextNumber() * 0.2)
		if effectsOn() then
			ctx.Effects.Flash(Color3.fromRGB(255, 250, 215), 0.3)
		end
		angerNearestCloud(x)

		-- Clic : on attrape l'éclair
		ctx.Connect(root.Activated, function()
			if bolt.Done or not ctx.IsAlive() then
				return
			end
			local impactPosition = UDim2.new(x, 0, y, extra)
			positions[bolt.Id] = impactPosition
			lastPosition = impactPosition
			ctx.ClaimSpawn(bolt.Id)
			ctx.Sound.Play("Thunder", 1.5)
			if effectsOn() then
				ctx.Effects.Burst(container, impactPosition, yellow, 18)
				ctx.Effects.Burst(container, impactPosition, nil, 8)
			end
			removeBolt(bolt, true)
			local id = bolt.Id
			task.delay(6, function()
				positions[id] = nil
			end)
		end)
	end

	------------------------------------------------------------------
	-- Animation (une seule connexion)
	------------------------------------------------------------------
	ctx.OnRender(function(dt: number)
		dt = math.min(dt, 0.1)
		local now = os.clock()

		-- Nuages d'ambiance
		for _, cloud in ipairs(ambient) do
			local range = cloud.Range
			local drift = 0.5 + 0.5 * math.sin(now * 0.08 + cloud.Phase)
			local sx = range.Min + (range.Max - range.Min) * drift
			local bob = math.sin(now * 0.9 + cloud.Phase) * 3
			local angry = now < cloud.AngryUntil
			local shake = angry and math.sin(now * 60) * 2 or 0
			cloud.Root.Position = UDim2.new(sx, shake, 0, 36 + bob)
			setAngry(cloud, angry, cloudColor, cloudAngry)

			-- Clignement des yeux
			if now >= cloud.NextBlink then
				cloud.BlinkUntil = now + 0.12
				cloud.NextBlink = now + random:NextNumber(2.5, 5.5)
			end
			local eyeHeight = (now < cloud.BlinkUntil) and 1 or 8
			if cloud.EyeL.Size.Y.Offset ~= eyeHeight then
				cloud.EyeL.Size = UDim2.fromOffset(6, eyeHeight)
				cloud.EyeR.Size = UDim2.fromOffset(6, eyeHeight)
			end

			-- Pluie
			for _, drop in ipairs(cloud.Drops) do
				drop.Y += drop.Speed * dt
				if drop.Y > RAIN_FALL then
					drop.Y = 0
					drop.X = random:NextNumber(16, CLOUD_W - 16)
				end
				drop.Frame.Position = UDim2.fromOffset(drop.X - drop.Y * 0.2, CLOUD_H - 8 + drop.Y)
				drop.Frame.BackgroundTransparency = 0.25 + 0.75 * (drop.Y / RAIN_FALL)
			end
		end

		-- Éclairs
		for _, bolt in pairs(bolts) do
			local age = now - bolt.Born
			local left = bolt.Lifetime - age
			if left <= 0 then
				removeBolt(bolt, false)
			else
				-- Scintillement
				local flicker = random:NextNumber(0, 0.25)
				for _, core in ipairs(bolt.Cores) do
					core.BackgroundTransparency = flicker
				end
				local glowAlpha = 0.6 + math.sin(now * 25) * 0.15
				for _, glow in ipairs(bolt.Glows) do
					glow.BackgroundTransparency = glowAlpha
				end
				bolt.ImpactGlow.BackgroundTransparency = 0.45 + math.sin(now * 12) * 0.15
				-- Anneau qui s'agrandit en boucle
				local cycle = (age * 1.6) % 1
				bolt.RingScale.Scale = 0.6 + cycle * 0.9
				bolt.RingStroke.Transparency = cycle
				-- Le petit nuage tremble de colère
				bolt.Storm.Root.Position = UDim2.fromOffset((BOLT_W - CLOUD_W) / 2 + math.sin(now * 50) * 1.5, 0)
				-- Presque fini : clignote
				if left < 0.6 then
					bolt.Root.Position = bolt.Base + UDim2.fromOffset(math.sin(now * 40) * 2, 0)
				end
			end
		end
	end)

	ctx.OnSpawn("Lightning", spawnBolt)

	-- Bonus confirmé : "+X ⚡" à l'impact
	ctx.OnBonus("Lightning", function(payload)
		if not ctx.IsAlive() then
			return
		end
		local position = (payload.SpawnId and positions[payload.SpawnId]) or lastPosition
		ctx.FloatText(container, position, "+" .. ctx.Format.Format(tonumber(payload.Amount) or 0) .. " ⚡", Theme.Colors.Gold, 44)
		ctx.FloatText(container, position + UDim2.fromOffset(0, 44), CHEERS[random:NextInteger(1, #CHEERS)], Theme.Colors.Orange, 24)
	end)
end

function Weather.Stop(_ctx)
	-- Nuages et éclairs vivent dans ctx.Container (détruit par le StimulusManager)
end

return Weather
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">StimulusManager</string>
          <string name="Source"><![CDATA[--[[
	StimulusManager (ModuleScript)
	Emplacement : ReplicatedStorage > Client > StimulusManager

	Fait apparaître / disparaître les "stimuli" (Client > Stimuli > <Feature>)
	selon les Features débloquées par le joueur :
	  - Feature possédée + module présent + pas encore lancé : crée le cadre
	    (selon Module.Slot, voir Slots), construit le "ctx", lance
	    Module.Start(ctx) dans son propre thread (protégé par pcall) et fait
	    "pop" le cadre ;
	  - Feature perdue (après l'océan) : ctx mort, connexions coupées,
	    Module.Stop(ctx) (si présent), cadre détruit ;
	  - Notify "Detox" : joue la cinématique Stimuli > Ocean (Ocean.Play(ctx)) ;
	  - Notify "Bonus" : transmis aux abonnés ctx.OnBonus(Source, ...).

	Contrat d'un module stimulus :
		local Module = {}
		Module.Slot = "L3"                -- ou "Overlay" / "Background"
		function Module.Start(ctx) end    -- construit l'UI dans ctx.Container
		function Module.Stop(ctx) end     -- optionnel
		return Module

	Champs du ctx : Feature, Container, Overlay, State, Config, Formulas,
	Format, Net, Theme, UIUtil, Effects, Sound, DVDMath, Notify, FloatText,
	GetLevel, HasFeature, ClaimSpawn, Interact, OnSpawn, OnBonus, Connect,
	OnRender, IsAlive, SetDarkMode (+ bonus : Slot, Interface, Random,
	EffectsEnabled, et pour l'océan : Payload, Rebirths, Multiplier).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Formulas = require(Shared.Formulas)
local Net = require(Shared.Net)
local NumberFormatter = require(Shared.NumberFormatter)
local DVDMath = require(Shared.DVDMath)

local Client = script.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local Interface = require(Client.Interface)
local ClientState = require(Client.ClientState)
local Effects = require(Client.Effects)
local SoundManager = require(Client.SoundManager)
local Slots = require(Client.Slots)
local Notifications = require(Client.Components.Notifications)

local StimulusManager = {}

type Record = {
	Feature: string,
	Module: any,
	Ctx: any,
	Container: Frame,
	Slot: string,
	Alive: boolean,
	Dark: boolean,
	Connections: { any },
}

local modules: { [string]: any } = {} -- [nom] = module chargé, ou false si erreur
local running: { [string]: Record } = {}
local bonusSubscribers: { [string]: { { Record: Record, Callback: (any) -> () } } } = {}
local oceanPlaying = false
local initialized = false

----------------------------------------------------------------------
-- Chargement des modules
----------------------------------------------------------------------

local function getStimuliFolder(): Instance?
	return Client:FindFirstChild("Stimuli")
end

local function loadModule(name: string): any?
	local cached = modules[name]
	if cached ~= nil then
		return cached or nil
	end
	local folder = getStimuliFolder()
	local moduleScript = folder and folder:FindFirstChild(name)
	if not moduleScript or not moduleScript:IsA("ModuleScript") then
		return nil -- pas (encore) de module : on ignore silencieusement
	end
	local ok, result = pcall(require, moduleScript)
	if not ok or type(result) ~= "table" then
		warn("[StimulusManager] Impossible de charger Stimuli." .. name .. " : " .. tostring(result))
		modules[name] = false
		return nil
	end
	modules[name] = result
	return result
end

----------------------------------------------------------------------
-- Mode sombre : actif si au moins un stimulus vivant le demande
----------------------------------------------------------------------

local function refreshDarkMode()
	local dark = false
	for _, record in pairs(running) do
		if record.Dark then
			dark = true
			break
		end
	end
	ClientState.SetDarkMode(dark)
end

----------------------------------------------------------------------
-- Construction du ctx
----------------------------------------------------------------------

local DEAD_CONNECTION = {
	Connected = false,
	Disconnect = function() end,
}

local function newContext(feature: string, container: Frame, slot: string): (any, Record)
	local record: Record = {
		Feature = feature,
		Module = nil,
		Ctx = nil,
		Container = container,
		Slot = slot,
		Alive = true,
		Dark = false,
		Connections = {},
	}

	local ctx = {}
	record.Ctx = ctx

	ctx.Feature = feature
	ctx.Slot = slot
	ctx.Container = container
	ctx.Overlay = Interface.Layers.Overlay
	ctx.Interface = Interface
	ctx.State = ClientState
	ctx.Config = Config
	ctx.Formulas = Formulas
	ctx.Format = NumberFormatter
	ctx.Net = Net
	ctx.Theme = Theme
	ctx.UIUtil = UIUtil
	ctx.Effects = Effects
	ctx.Sound = SoundManager
	ctx.DVDMath = DVDMath
	ctx.Random = Random.new()

	function ctx.IsAlive(): boolean
		return record.Alive
	end

	-- Petit bandeau en bas de l'écran
	function ctx.Notify(text: string, color: Color3?)
		Notifications.Toast(text, color)
	end

	-- Texte "+X" flottant
	function ctx.FloatText(parent: GuiObject, position: UDim2, text: string, color: Color3?, size: number?)
		Effects.FloatingText(parent, position, text, color, size)
	end

	function ctx.GetLevel(upgradeId: string): number
		return ClientState.GetLevel(upgradeId)
	end

	function ctx.HasFeature(name: string): boolean
		return ClientState.HasFeature(name)
	end

	-- Vrai si le joueur n'a pas coupé les effets (particules)
	function ctx.EffectsEnabled(): boolean
		local data = ClientState.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	function ctx.ClaimSpawn(id: string)
		if type(id) ~= "string" then
			return
		end
		Net.Event("SpawnClick"):FireServer(id)
	end

	function ctx.Interact(kind: string, arg: any?)
		Net.Event("Interact"):FireServer(kind, arg)
	end

	-- Connexion suivie (fonctionne avec RBXScriptSignal ET Shared/Signal)
	function ctx.Connect(signal: any, callback: (...any) -> ()): any
		if not record.Alive or signal == nil then
			return DEAD_CONNECTION
		end
		local connection = signal:Connect(function(...)
			if record.Alive then
				callback(...)
			end
		end)
		table.insert(record.Connections, connection)
		return connection
	end

	-- Appelé à chaque image (RenderStepped) ; une erreur coupe la connexion (un seul avertissement)
	function ctx.OnRender(callback: (dt: number) -> ()): any
		local connection
		connection = ctx.Connect(RunService.RenderStepped, function(dt: number)
			local ok, err = pcall(callback, dt)
			if not ok then
				warn("[Stimuli." .. feature .. "] Erreur dans OnRender (boucle arrêtée) : " .. tostring(err))
				if connection then
					connection:Disconnect()
				end
			end
		end)
		return connection
	end

	-- Objets qui apparaissent (étoile, éclair, notif, mail) d'un type donné
	function ctx.OnSpawn(kind: string, callback: (info: any) -> ()): any
		return ctx.Connect(ClientState.SpawnReceived, function(info)
			if info.Kind == kind then
				callback(info)
			end
		end)
	end

	-- Récompenses "Bonus" envoyées par le serveur pour une source donnée
	function ctx.OnBonus(source: string, callback: (payload: any) -> ()): any
		if not record.Alive then
			return DEAD_CONNECTION
		end
		local list = bonusSubscribers[source]
		if not list then
			list = {}
			bonusSubscribers[source] = list
		end
		local entry = { Record = record, Callback = callback }
		table.insert(list, entry)
		local connection = {
			Connected = true,
			Disconnect = function(self)
				local current = bonusSubscribers[source]
				if current then
					local index = table.find(current, entry)
					if index then
						table.remove(current, index)
					end
				end
				if type(self) == "table" then
					self.Connected = false
				end
			end,
		}
		table.insert(record.Connections, connection)
		return connection
	end

	-- Mode sombre (utilisé par le mode néon). Toujours accepté (même dans Stop).
	function ctx.SetDarkMode(enabled: boolean)
		record.Dark = enabled == true and record.Alive
		refreshDarkMode()
	end

	return ctx, record
end

-- Tue un ctx : plus vivant, toutes ses connexions coupées
local function killRecord(record: Record)
	record.Alive = false
	for _, connection in ipairs(record.Connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	table.clear(record.Connections)
end

----------------------------------------------------------------------
-- Démarrage / arrêt d'un stimulus
----------------------------------------------------------------------

local function startFeature(feature: string, module: any)
	local slot = module.Slot
	if type(slot) ~= "string" or not Slots.IsValid(slot) then
		warn("[StimulusManager] Stimuli." .. feature .. " : Slot invalide (" .. tostring(slot) .. "), Overlay utilisé")
		slot = "Overlay"
	end
	local layer = Interface.Layers[Slots.GetLayerName(slot)]
	if not layer then
		return
	end

	local container = Slots.Create(slot, nil)
	container.Name = feature
	local upgradeId = Config.FeatureToUpgrade[feature]
	local upgrade = upgradeId and Config.UpgradesById[upgradeId]
	container.ZIndex = upgrade and upgrade.Order or 1 -- ordre d'empilement stable
	local fullCanvas = slot == "Overlay" or slot == "Background"
	local popScale: UIScale? = nil
	if not fullCanvas then
		popScale = UIUtil.Create("UIScale", { Name = "PopScale", Scale = 0.3, Parent = container })
	end
	container.Parent = layer

	local ctx, record = newContext(feature, container, slot)
	record.Module = module
	running[feature] = record

	task.spawn(function()
		local ok, err = pcall(module.Start, ctx)
		if not ok then
			warn("[StimulusManager] Erreur dans Stimuli." .. feature .. ".Start : " .. tostring(err))
		end
	end)

	-- Apparition "pop"
	local scale = popScale
	if scale then
		UIUtil.Tween(scale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
		task.delay(0.5, function()
			if scale.Parent then
				scale:Destroy()
			end
		end)
	end
end

local function stopFeature(feature: string)
	local record = running[feature]
	if not record then
		return
	end
	running[feature] = nil
	killRecord(record)

	local module = record.Module
	if module and type(module.Stop) == "function" then
		local ok, err = pcall(module.Stop, record.Ctx)
		if not ok then
			warn("[StimulusManager] Erreur dans Stimuli." .. feature .. ".Stop : " .. tostring(err))
		end
	end
	record.Dark = false
	refreshDarkMode()

	-- Disparition (petit rétrécissement pour les slots, immédiate sinon)
	local container = record.Container
	if record.Slot == "Overlay" or record.Slot == "Background" then
		container:Destroy()
	else
		local scale = container:FindFirstChild("PopScale") :: UIScale?
		if not scale then
			scale = UIUtil.Create("UIScale", { Name = "PopScale", Parent = container })
		end
		UIUtil.Tween(scale :: UIScale, 0.25, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		task.delay(0.3, function()
			container:Destroy()
		end)
	end
end

-- Compare les Features possédées avec les stimuli lancés
local function applyFeatures()
	if not ClientState.Data then
		return
	end
	-- Arrêt de ce qui n'est plus possédé
	local toStop = {}
	for feature in pairs(running) do
		if not ClientState.HasFeature(feature) then
			table.insert(toStop, feature)
		end
	end
	for _, feature in ipairs(toStop) do
		stopFeature(feature)
	end
	-- Démarrage dans l'ordre des améliorations (empilement stable)
	for _, upgrade in ipairs(Config.Upgrades) do
		local feature = upgrade.Feature
		if feature and not running[feature] and ClientState.HasFeature(feature) then
			local module = loadModule(feature)
			if module and type(module.Start) == "function" then
				startFeature(feature, module)
			end
		end
	end
end

----------------------------------------------------------------------
-- Cinématique de l'océan
----------------------------------------------------------------------

local function fallbackOcean(container: Frame, payload)
	-- Version minimale si Stimuli > Ocean n'existe pas
	local sea = UIUtil.Create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(0, 140, 200),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = container,
	})
	UIUtil.Gradient(sea, ColorSequence.new(Color3.fromRGB(170, 225, 255), Color3.fromRGB(0, 90, 160)), 90)
	local label = UIUtil.Label({
		Text = "Respire...",
		Font = Theme.Fonts.Title,
		TextColor3 = Color3.new(1, 1, 1),
		TextTransparency = 1,
		Size = UDim2.new(0.8, 0, 0, 80),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		ZIndex = 3,
		MaxTextSize = 64,
		Parent = sea,
	})
	SoundManager.Play("Detox", 1)
	UIUtil.Tween(sea, 1, { BackgroundTransparency = 0 })
	task.wait(1)
	UIUtil.Tween(label, 0.8, { TextTransparency = 0 })
	task.wait(2)
	label.Text = "Rebirth " .. NumberFormatter.Multiplier(tonumber(payload.Multiplier) or 1)
	task.wait(1.5)
	UIUtil.Tween(label, 0.8, { TextTransparency = 1 })
	UIUtil.Tween(sea, 1, { BackgroundTransparency = 1 })
	task.wait(1)
end

local function playOcean(payload)
	if oceanPlaying then
		return
	end
	local layer = Interface.Layers.Cinematic
	if not layer then
		return
	end
	oceanPlaying = true

	local container = UIUtil.Create("Frame", {
		Name = "Ocean",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Active = true,
		Parent = layer,
	})
	-- Bloque les clics pendant la cinématique
	UIUtil.Create("TextButton", {
		Name = "InputBlocker",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 0,
		Parent = container,
	})

	local ctx, record = newContext("Ocean", container, "Cinematic")
	ctx.Payload = payload
	ctx.Rebirths = tonumber(payload.Rebirths) or 0
	ctx.Multiplier = tonumber(payload.Multiplier) or 1
	local module = loadModule("Ocean")
	record.Module = module

	local finished = false
	local function finish()
		if finished then
			return
		end
		finished = true
		oceanPlaying = false
		killRecord(record)
		container:Destroy()
	end

	task.spawn(function()
		local ok, err
		if module and type(module.Play) == "function" then
			ok, err = pcall(module.Play, ctx)
		else
			ok, err = pcall(fallbackOcean, container, payload)
		end
		if not ok then
			warn("[StimulusManager] Erreur dans la cinématique de l'océan : " .. tostring(err))
		end
		finish()
	end)
	task.delay(10, finish)
end

----------------------------------------------------------------------
-- API
----------------------------------------------------------------------

-- Traitement des notifications qui concernent les stimuli (Bonus, Detox)
function StimulusManager.HandleNotify(payload)
	local kind = payload.Type
	if kind == "Bonus" then
		SoundManager.Play("Bonus", 1.2 + math.random() * 0.2)
		local list = payload.Source and bonusSubscribers[payload.Source]
		local delivered = false
		if list then
			for _, entry in ipairs(table.clone(list)) do
				if entry.Record.Alive then
					delivered = true
					task.spawn(function()
						local ok, err = pcall(entry.Callback, payload)
						if not ok then
							warn("[Stimuli." .. entry.Record.Feature .. "] Erreur dans OnBonus : " .. tostring(err))
						end
					end)
				end
			end
		end
		-- Personne n'écoute : petit texte au centre (ou toast du serveur)
		if not delivered then
			local amount = tonumber(payload.Amount)
			local layer = Effects.GetLayer()
			if amount and layer then
				Effects.FloatingText(layer, UDim2.new(0.5, 0, 0, 200), "+" .. NumberFormatter.Format(amount), Theme.Colors.Gold, 40)
			elseif payload.Text then
				Notifications.Toast(payload.Text, Theme.Colors.Gold)
			end
		end
	elseif kind == "Detox" then
		playOcean(payload)
	end
end

-- Liste des stimuli lancés (debug)
function StimulusManager.GetRunning(): { string }
	local list = {}
	for feature in pairs(running) do
		table.insert(list, feature)
	end
	table.sort(list)
	return list
end

-- Relance l'évaluation (ex. après ajout d'un module)
function StimulusManager.Refresh()
	applyFeatures()
end

function StimulusManager.Init()
	if initialized then
		return
	end
	initialized = true

	ClientState.FeaturesChanged:Connect(applyFeatures)

	-- Le dossier Stimuli (ou certains modules) peut arriver après nous
	local function watchFolder(folder: Instance)
		folder.ChildAdded:Connect(function()
			task.defer(applyFeatures)
		end)
	end
	local folder = getStimuliFolder()
	if folder then
		watchFolder(folder)
	else
		local connection
		connection = Client.ChildAdded:Connect(function(child)
			if child.Name == "Stimuli" then
				connection:Disconnect()
				watchFolder(child)
				task.defer(applyFeatures)
			end
		end)
	end

	applyFeatures()
end

return StimulusManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">Theme</string>
          <string name="Source"><![CDATA[--[[
	Theme (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Theme

	Direction artistique : "basique" et clair (fond blanc → gris clair,
	bouton gris, texte noir, cartes blanches à bord noir, pastilles rouges).
	L'écran se remplit ensuite de "stimuli" colorés, et le mode néon passe
	l'interface en sombre (voir Theme.DarkColors).
	Change les couleurs et polices ici pour modifier TOUTE l'interface.
]]

local Theme = {}

local function hex(value: string): Color3
	return Color3.fromHex(value)
end

Theme.Colors = {
	-- Fond
	Background = hex("#FFFFFF"),
	BackgroundBottom = hex("#E2E2E2"),

	-- Texte
	Text = hex("#111111"),
	TextDim = hex("#5A5A5A"),
	TextLight = hex("#FFFFFF"),
	TextDark = hex("#111111"),

	-- Contours, boutons, cartes
	Border = hex("#1E1E1E"),
	Button = hex("#F4F4F4"),
	ButtonBottom = hex("#D5D5D5"),
	Card = hex("#FFFFFF"),
	CardBorder = hex("#1A1A1A"),
	Disabled = hex("#B8B8B8"),
	Shadow = hex("#000000"),
	Panel = hex("#FFFFFF"),
	PanelLight = hex("#F2F2F2"),

	-- Couleurs vives
	Red = hex("#E3262B"),
	Green = hex("#3DDC3D"),
	Purple = hex("#8B32E0"),
	Blue = hex("#1E88E5"),
	Orange = hex("#FF8A1A"),
	Yellow = hex("#FFD21F"),
	Pink = hex("#FF3E8A"),
	Cyan = hex("#00C2E0"),
	Gold = hex("#FFC21A"),
	Dark = hex("#2A2A2A"),
}

-- Anciennes clés (v1) gardées pour compatibilité
Theme.Colors.BackgroundTop = Theme.Colors.Background
Theme.Colors.BackgroundMid = Theme.Colors.PanelLight

-- Couleurs utilisées quand le mode sombre (néon) est actif
Theme.DarkColors = {
	Text = hex("#FFFFFF"),
	TextDim = hex("#C9C3E6"),
	Card = hex("#16121F"),
	CardTransparency = 0.25,
	CardBorder = hex("#FFFFFF"),
	Background = hex("#0B0912"),
}

Theme.Fonts = {
	Title = Enum.Font.BuilderSansBold, -- titres
	Body = Enum.Font.BuilderSansMedium, -- textes
	Number = Enum.Font.BuilderSansBold, -- compteurs
	Mono = Enum.Font.RobotoMono, -- chiffres alignés (bourse...)
}

-- Résolution de référence : toute l'interface est pensée en 1280x720,
-- puis mise à l'échelle automatiquement (UIScale) selon l'écran.
Theme.DesignResolution = Vector2.new(1280, 720)
Theme.MinScale = 0.45
Theme.MaxScale = 1.6

-- Dégradé néon (rose -> violet -> cyan), utilisé par le mode néon
Theme.NeonGradient = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 46, 136)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(157, 78, 221)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 240, 255)),
})

-- Luminosité perçue (0 = noir, 1 = blanc) : sert à choisir un texte lisible
function Theme.Luminance(color: Color3): number
	return 0.299 * color.R + 0.587 * color.G + 0.114 * color.B
end

-- Texte lisible (noir ou blanc) sur un fond de couleur `color`
function Theme.ContrastText(color: Color3): Color3
	return Theme.Luminance(color) > 0.62 and Theme.Colors.TextDark or Theme.Colors.TextLight
end

return Theme
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">UIUtil</string>
          <string name="Source"><![CDATA[--[[
	UIUtil (ModuleScript)
	Emplacement : ReplicatedStorage > Client > UIUtil

	Fonctions utilitaires pour créer l'interface en code : création
	d'instances, coins arrondis, contours, dégradés, boutons animés,
	pastilles ("pills"), badges rouges, ombres...
]]

local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)

local UIUtil = {}

-- Crée une instance avec ses propriétés et ses enfants.
-- Le Parent est appliqué en dernier (meilleures performances).
function UIUtil.Create(className: string, props: { [string]: any }?, children: { Instance }?): any
	local instance = Instance.new(className)
	local parent = nil
	if props then
		for key, value in pairs(props) do
			if key == "Parent" then
				parent = value
			else
				(instance :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function UIUtil.Corner(parent: Instance, radius: (number | UDim)?): UICorner
	local value = radius or 12
	return UIUtil.Create("UICorner", {
		CornerRadius = (typeof(value) == "UDim") and value or UDim.new(0, value :: number),
		Parent = parent,
	})
end

function UIUtil.Stroke(parent: Instance, color: Color3?, thickness: number?, transparency: number?): UIStroke
	return UIUtil.Create("UIStroke", {
		Color = color or Theme.Colors.Border,
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

function UIUtil.Gradient(parent: Instance, color: ColorSequence?, rotation: number?): UIGradient
	return UIUtil.Create("UIGradient", {
		Color = color or Theme.NeonGradient,
		Rotation = rotation or 0,
		Parent = parent,
	})
end

function UIUtil.Padding(parent: Instance, pixels: number): UIPadding
	local padding = UDim.new(0, pixels)
	return UIUtil.Create("UIPadding", {
		PaddingTop = padding,
		PaddingBottom = padding,
		PaddingLeft = padding,
		PaddingRight = padding,
		Parent = parent,
	})
end

-- Lance une animation (Tween) et la renvoie
function UIUtil.Tween(
	instance: Instance,
	duration: number,
	props: { [string]: any },
	style: Enum.EasingStyle?,
	direction: Enum.EasingDirection?
): Tween
	local tween = TweenService:Create(
		instance,
		TweenInfo.new(duration, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
		props
	)
	tween:Play()
	return tween
end

-- Texte simple, transparent, avec la police du thème.
-- MaxTextSize limite la taille du texte (TextScaled) pour éviter les textes géants.
function UIUtil.Label(props: { [string]: any }): TextLabel
	local maxTextSize = props.MaxTextSize or 48
	local finalProps = {
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		TextColor3 = Theme.Colors.Text,
		TextScaled = true,
		Text = "",
	}
	for key, value in pairs(props) do
		if key ~= "MaxTextSize" then
			finalProps[key] = value
		end
	end
	local label = UIUtil.Create("TextLabel", finalProps)
	UIUtil.Create("UITextSizeConstraint", { MaxTextSize = maxTextSize, MinTextSize = 6, Parent = label })
	return label
end

-- Ajoute les animations de survol / appui à n'importe quel bouton
function UIUtil.AnimateButton(button: GuiButton, hoverScale: number?, pressScale: number?)
	local uiScale = button:FindFirstChild("AnimScale") :: UIScale?
	if not uiScale then
		uiScale = UIUtil.Create("UIScale", { Name = "AnimScale", Parent = button })
	end
	local scale = uiScale :: UIScale
	local hover = hoverScale or 1.06
	local press = pressScale or 0.92
	local hovering = false

	button.MouseEnter:Connect(function()
		hovering = true
		UIUtil.Tween(scale, 0.15, { Scale = hover }, Enum.EasingStyle.Back)
	end)
	button.MouseLeave:Connect(function()
		hovering = false
		UIUtil.Tween(scale, 0.15, { Scale = 1 })
	end)
	button.MouseButton1Down:Connect(function()
		UIUtil.Tween(scale, 0.08, { Scale = press })
	end)
	button.MouseButton1Up:Connect(function()
		UIUtil.Tween(scale, 0.25, { Scale = hovering and hover or 1 }, Enum.EasingStyle.Back)
	end)
end

-- Bouton standard (fond coloré, léger contour, animé).
-- Garde son nom v1 "NeonButton" : le style suit simplement le thème.
function UIUtil.NeonButton(props: { [string]: any }): TextButton
	local color = props.Color or Theme.Colors.Pink
	local button = UIUtil.Create("TextButton", {
		Name = props.Name or "NeonButton",
		Size = props.Size or UDim2.fromOffset(160, 48),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = color,
		AutoButtonColor = false,
		Font = props.Font or Theme.Fonts.Title,
		Text = props.Text or "",
		TextColor3 = props.TextColor3 or Theme.ContrastText(color),
		TextScaled = true,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	})
	UIUtil.Corner(button, props.CornerRadius or 12)
	UIUtil.Stroke(button, props.StrokeColor or Theme.Colors.Border, props.StrokeThickness or 2, props.StrokeTransparency or 0.1)
	UIUtil.Create("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize or 26, Parent = button })
	UIUtil.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
		PaddingTop = UDim.new(0, 4),
		PaddingBottom = UDim.new(0, 4),
		Parent = button,
	})
	-- Léger dégradé pour un effet "bouton"
	UIUtil.Gradient(button, ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(215, 215, 215)), 90)
	button:SetAttribute("BaseColor", color)
	button:SetAttribute("Enabled", true)
	UIUtil.AnimateButton(button)
	return button
end

-- Active / grise un bouton (garde sa couleur d'origine en attribut).
-- Le bouton reste cliquable : l'appelant joue un son "erreur" + secousse
-- s'il est désactivé (meilleur retour pour le joueur).
function UIUtil.SetButtonEnabled(button: GuiButton, enabled: boolean)
	local baseColor = button:GetAttribute("BaseColor") or Theme.Colors.Pink
	button.BackgroundColor3 = enabled and baseColor or Theme.Colors.Disabled
	if button:IsA("TextButton") then
		button.TextTransparency = enabled and 0 or 0.35
	end
	button:SetAttribute("Enabled", enabled)
end

-- Petite animation "non !" (secousse) sur un élément
function UIUtil.Shake(guiObject: GuiObject)
	if guiObject:GetAttribute("Shaking") then
		return -- déjà en train de trembler : on ne décale pas la position d'origine
	end
	guiObject:SetAttribute("Shaking", true)
	local origin = guiObject.Position
	task.spawn(function()
		for i = 1, 6 do
			if not guiObject.Parent then
				break
			end
			local offset = (i % 2 == 0) and 6 or -6
			guiObject.Position = origin + UDim2.fromOffset(offset, 0)
			task.wait(0.03)
		end
		guiObject.Position = origin
		guiObject:SetAttribute("Shaking", nil)
	end)
end

----------------------------------------------------------------------
-- Ajouts v2
----------------------------------------------------------------------

-- Ombre douce sous un cadre (un cadre noir transparent décalé, derrière)
function UIUtil.Shadow(frame: GuiObject, offset: number?, transparency: number?): Frame?
	local parent = frame.Parent
	if not parent then
		return nil
	end
	local shift = offset or 4
	local shadow = UIUtil.Create("Frame", {
		Name = frame.Name .. "Shadow",
		Size = frame.Size,
		AnchorPoint = frame.AnchorPoint,
		Position = frame.Position + UDim2.fromOffset(0, shift),
		BackgroundColor3 = Theme.Colors.Shadow,
		BackgroundTransparency = transparency or 0.85,
		BorderSizePixel = 0,
		ZIndex = math.max(0, frame.ZIndex - 1),
		LayoutOrder = frame.LayoutOrder,
		Parent = parent,
	})
	local corner = frame:FindFirstChildOfClass("UICorner")
	if corner then
		UIUtil.Corner(shadow, corner.CornerRadius)
	end
	return shadow
end

-- Badge rouge rond (compteur) accroché en haut à droite d'un élément
function UIUtil.Badge(parent: GuiObject, size: number?): TextLabel
	local diameter = size or 24
	local badge = UIUtil.Create("TextLabel", {
		Name = "Badge",
		Size = UDim2.fromOffset(diameter, diameter),
		AutomaticSize = Enum.AutomaticSize.X,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -4, 0, 4),
		BackgroundColor3 = Theme.Colors.Red,
		Font = Theme.Fonts.Number,
		Text = "",
		TextColor3 = Theme.Colors.TextLight,
		TextSize = math.floor(diameter * 0.62),
		ZIndex = parent.ZIndex + 5,
		Visible = false,
		Parent = parent,
	})
	UIUtil.Corner(badge, UDim.new(1, 0))
	UIUtil.Stroke(badge, Theme.Colors.TextLight, 2)
	UIUtil.Create("UIPadding", {
		PaddingLeft = UDim.new(0, math.floor(diameter * 0.25)),
		PaddingRight = UDim.new(0, math.floor(diameter * 0.25)),
		Parent = badge,
	})
	return badge
end

-- Met à jour un badge : caché si 0, sinon affiche le nombre (ou un texte)
function UIUtil.SetBadge(badge: TextLabel, value: number | string)
	if type(value) == "number" then
		badge.Visible = value > 0
		badge.Text = value > 99 and "99+" or tostring(math.floor(value))
	else
		badge.Visible = value ~= ""
		badge.Text = value
	end
end

-- Pastille arrondie ("pill") à largeur automatique, comme
-- "🛒 Boutique" ou "⚙️". props : Text, Color, TextColor3, Height, TextSize,
-- LayoutOrder, Name, Parent, Round (true = cercle).
function UIUtil.PillButton(props: { [string]: any }): TextButton
	local color = props.Color or Theme.Colors.Dark
	local height = props.Height or 36
	local round = props.Round == true
	local button = UIUtil.Create("TextButton", {
		Name = props.Name or "Pill",
		Size = UDim2.fromOffset(round and height or 0, height),
		AutomaticSize = round and Enum.AutomaticSize.None or Enum.AutomaticSize.X,
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = color,
		AutoButtonColor = false,
		Font = props.Font or Theme.Fonts.Title,
		Text = props.Text or "",
		TextColor3 = props.TextColor3 or Theme.ContrastText(color),
		TextSize = props.TextSize or math.floor(height * 0.5),
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	})
	UIUtil.Corner(button, UDim.new(1, 0))
	UIUtil.Stroke(button, props.StrokeColor or Theme.Colors.Border, props.StrokeThickness or 1.5, props.StrokeTransparency or 0.2)
	if not round then
		UIUtil.Create("UIPadding", {
			PaddingLeft = UDim.new(0, math.floor(height * 0.45)),
			PaddingRight = UDim.new(0, math.floor(height * 0.45)),
			Parent = button,
		})
	end
	UIUtil.Gradient(button, ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(222, 222, 222)), 90)
	button:SetAttribute("BaseColor", color)
	button:SetAttribute("Enabled", true)
	UIUtil.AnimateButton(button, 1.05, 0.93)
	return button
end

-- Bouton "basique" gris clair à contour fin (style du bouton "Clique-moi")
function UIUtil.BasicButton(props: { [string]: any }): TextButton
	local button = UIUtil.Create("TextButton", {
		Name = props.Name or "BasicButton",
		Size = props.Size or UDim2.fromOffset(160, 48),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = Color3.new(1, 1, 1),
		AutoButtonColor = false,
		Font = props.Font or Theme.Fonts.Body,
		Text = props.Text or "",
		TextColor3 = props.TextColor3 or Theme.Colors.Text,
		TextSize = props.TextSize or 22,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	})
	UIUtil.Corner(button, props.CornerRadius or 10)
	UIUtil.Stroke(button, Theme.Colors.Border, props.StrokeThickness or 1.5, 0)
	UIUtil.Gradient(button, ColorSequence.new(Theme.Colors.Button, Theme.Colors.ButtonBottom), 90)
	button:SetAttribute("BaseColor", Color3.new(1, 1, 1))
	button:SetAttribute("Enabled", true)
	UIUtil.AnimateButton(button, 1.04, 0.94)
	return button
end

-- Déconnecte toutes les connexions d'une liste (RBXScriptConnection ou Signal) puis la vide
function UIUtil.DisconnectAll(connections: { any })
	for _, connection in ipairs(connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	table.clear(connections)
end

return UIUtil
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="46">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	Config (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > Config

	TOUTE la configuration du jeu est ici : améliorations (et ce qu'elles
	débloquent à l'écran), succès, quêtes, événements, bourse, casino,
	coffres, objets cosmétiques, sons... Modifie les valeurs librement.

	Principe du jeu (style "Stimulation Clicker") : l'écran commence tout
	simple (un bouton, un compteur). Chaque amélioration achetée ajoute
	quelque chose à l'écran (logo DVD, fil d'actu, coureur, presse...),
	jusqu'à la surcharge totale. Puis on peut "Aller à l'océan" (rebirth).

	Ce module est lu par le serveur ET par le client. Le serveur reste la
	seule source de vérité : modifier ce fichier côté client ne change rien.
]]

local Config = {}

----------------------------------------------------------------------
-- Réglages généraux
----------------------------------------------------------------------
Config.Game = {
	CurrencyName = "Dopamine",
	MaxClicksPerSecond = 20, -- anti-triche : au-delà, les clics sont ignorés
	PassiveTickRate = 0.25, -- intervalle (s) entre deux ajouts de gains passifs
	SyncRate = 0.2, -- intervalle (s) entre deux envois de l'état au client
	MaxDopamine = 1e300, -- plafond de sécurité (évite l'infini)
}

----------------------------------------------------------------------
-- Combo (débloqué par l'amélioration "Combo") : cliquer vite remplit une
-- jauge 0-100 qui multiplie les clics.
----------------------------------------------------------------------
Config.Combo = {
	GainPerClick = 5, -- points de jauge gagnés par clic
	DecayPerSecond = 15, -- points perdus par seconde (il faut > 3 clics/s pour monter)
	MaxMultiplier = 3, -- multiplicateur quand la jauge est pleine
}

----------------------------------------------------------------------
-- Barre d'améliorations (sous le compteur)
----------------------------------------------------------------------
Config.UpgradeBar = {
	RevealAhead = 5, -- nombre d'améliorations PAS ENCORE achetées visibles en avance
}

----------------------------------------------------------------------
-- Améliorations
--
--   Id          : identifiant unique (ne pas changer après publication)
--   Name, Icon  : nom et emoji affichés sur la carte
--   Description : texte de l'infobulle ; "%s" est remplacé par Value formatée
--   Cost        : prix du niveau 1 ; CostGrowth : prix x CostGrowth à chaque niveau
--   MaxLevel    : niveau maximum (1 = achat unique ; nil = infini)
--   Effect      : "Click"            +Value Dopamine par clic (par niveau)
--                 "PerSecond"        +Value Dopamine par seconde (par niveau)
--                 "DVD"              +1 logo DVD rebondissant (par niveau)
--                 "BounceMultiplier" gain par rebond x Value (par niveau)
--                 "ClickMultiplier"  gain par clic x Value (par niveau)
--                 "Multiplier"       TOUS les gains x Value (par niveau)
--                 "Feature"          aucun effet économique, débloque juste Feature
--                 "Detox"            "Aller à l'océan" = rebirth (prix : Config.Rebirth)
--   Feature     : ce que l'amélioration fait apparaître à l'écran / débloque
--                 (nom d'un module client dans Client > Stimuli, ou d'un menu)
--   Permanent   : true = conservée après "Aller à l'océan" (menus utiles)
--   Color       : couleur de la carte en mode "Icônes HD"
--
-- Équilibrage (simulé : 5 clics/s, ~50 % des bonus attrapés, on achète
-- toujours l'amélioration abordable la moins chère) : une nouveauté à
-- l'écran toutes les 1 à 3 min, jamais plus de ~3 min sans achat, 1re
-- visite à l'océan après ~70 min ; la 2e partie est ~2x plus rapide.
----------------------------------------------------------------------

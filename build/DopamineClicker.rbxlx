-- Objet inconnu (future mise à jour) : butte fleurie + icône
local function fallback(kit: any, x: number, d: number, entry: any)
	local mound = kit:CylY("GardenMound", x, 0, d, 4, 0.8, LEAF, M.Grass, DECO)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "GardenDecor"
	billboard.Size = UDim2.fromScale(4, 4)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 2.6, 0)
	billboard.MaxDistance = 160
	billboard.LightInfluence = 0
	billboard.Adornee = mound
	billboard.Parent = mound
	local icon = Instance.new("TextLabel")
	icon.BackgroundTransparency = 1
	icon.Size = UDim2.fromScale(1, 1)
	icon.Font = Enum.Font.GothamBold
	icon.TextScaled = true
	icon.Text = tostring(entry and entry.Icon or "🌷")
	icon.Parent = billboard
end

function HouseGarden.Has(id: string): boolean
	return MAKERS[id] ~= nil
end

-- (v9.8 GARDEN98) une déco du jardin dessinée au centre du repère du kit
-- (x = 0, d = 0, devant vers la rue = -d) : GardenBuilder la pose où le
-- joueur l'a mise (mode édition du jardin)
function HouseGarden.BuildDecor(kit: any, id: string)
	local maker = MAKERS[id]
	if maker then
		maker(kit, 0, 0)
	else
		local byId = Config.HouseLooksById and Config.HouseLooksById.Garden or {}
		fallback(kit, 0, 0, byId[id])
	end
end

-- (v9.8 GARDEN98) la déco du jardin n'est plus dessinée avec la façade :
-- GardenBuilder la pose (places libres choisies par le joueur, mêmes
-- modèles). HouseFacade garde l'appel : il ne fait plus rien.
HouseGarden.DECOR_IN_GARDEN = true

-- Déco choisie : GardenSlots places réparties entre x0 et x1 (comme la 2D),
-- à la profondeur d ; avoidCenter : on laisse la fontaine / l'allée libres
function HouseGarden.Decorations(kit: any, ids: { string }?, x0: number, x1: number, d: number, avoidCenter: boolean?)
	if HouseGarden.DECOR_IN_GARDEN then
		return
	end
	local list = type(ids) == "table" and ids or {}
	local slots = tonumber((Config.House :: any).GardenSlots) or 6
	local byId = Config.HouseLooksById and Config.HouseLooksById.Garden or {}
	local margin = (x1 - x0) * 0.07
	local spacing = (x1 - x0 - margin * 2) / math.max(1, slots)
	local clear = if avoidCenter then 9 else 4.5
	for index = 1, slots do
		local id = list[index]
		local entry = type(id) == "string" and byId[id] or nil
		if entry then
			local x = x0 + margin + (index - 0.5) * spacing
			if math.abs(x) < clear then
				x = (if x < 0 then -1 else 1) * clear
			end
			local maker = MAKERS[id :: string]
			if maker then
				local ok, err = pcall(maker, kit, x, d)
				if not ok then
					warn("[World] Jardin " .. tostring(id) .. " : " .. tostring(err))
				end
			else
				fallback(kit, x, d, entry)
			end
		end
	end
end

----------------------------------------------------------------------
-- v9.8 (GARDEN98) 🪴 OBJETS DE JARDIN (Config.Garden.Pieces) : de vrais
-- modèles réalistes (pots en terre cuite, urne en pierre, rosiers,
-- hortensias, lavande, lanterne, nichoir, panier suspendu, massif rond,
-- banc, potager, table de pique-nique, cadran solaire, arche de roses,
-- balancelle, statue d'ange, kiosque blanc, fontaine à étages) + les
-- aménagements offerts par les agrandissements (serre, bassin aux carpes).
-- Dessinés au centre du repère du kit (x = 0, d = 0), devant vers la rue
-- (-d) ; `variant` (n° de l'exemplaire) change un peu les couleurs.
-- Anti-scintillement : jamais deux faces confondues (écarts >= 0,02).
----------------------------------------------------------------------

local TERRA = Color3.fromRGB(184, 92, 58)
local TERRA_DARK = Color3.fromRGB(146, 70, 46)
local EARTH = Color3.fromRGB(78, 54, 38)
local LEAF_D = Color3.fromRGB(52, 104, 50)
local LEAF_M = Color3.fromRGB(78, 136, 62)
local LEAF_L = Color3.fromRGB(116, 168, 78)
local PALE_STONE = Color3.fromRGB(204, 198, 186)
local GREY_STONE = Color3.fromRGB(150, 146, 140)
local BRONZE = Color3.fromRGB(146, 108, 58)
local WOOD_N = Color3.fromRGB(150, 104, 66)
local WOOD_W = Color3.fromRGB(136, 122, 104) -- bois grisé
local PAINT = Color3.fromRGB(244, 242, 236)
local IRON = Color3.fromRGB(44, 42, 48)
local GLASS = Color3.fromRGB(196, 226, 236)

local BLOOMS = {
	Color3.fromRGB(206, 36, 64), -- rouge
	Color3.fromRGB(250, 132, 170), -- rose
	Color3.fromRGB(252, 248, 240), -- blanc
	Color3.fromRGB(255, 200, 62), -- jaune
	Color3.fromRGB(150, 104, 206), -- violet
	Color3.fromRGB(255, 142, 64), -- orange
}

local function L(x: number, y: number, d: number): CFrame
	return CFrame.new(x, y, -d)
end

-- Repère en (x, y, d) dont l'axe X suit la direction (tx, td) du plan du sol
-- (pierres d'une margelle : le long du cercle)
local function along(x: number, y: number, d: number, tx: number, td: number): CFrame
	local dir = Vector3.new(tx, 0, -td)
	if dir.Magnitude < 1e-4 then
		return L(x, y, d)
	end
	dir = dir.Unit
	return CFrame.fromMatrix(Vector3.new(x, y, -d), dir, Vector3.new(0, 1, 0), dir:Cross(Vector3.new(0, 1, 0)))
end

-- Ovale (Part + SpecialMesh "Sphere")
local function egg(kit: any, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, opts: any?): BasePart
	local part = kit:Part(name, size, cf, color, material or M.SmoothPlastic, opts or DECO)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = part
	return part
end

-- Tube d'un point à un autre (repère du kit : { x, y, d })
local function rod(kit: any, name: string, a: Vector3, b: Vector3, diameter: number, color: Color3, material: Enum.Material?, opts: any?): BasePart
	local pa, pb = Vector3.new(a.X, a.Y, -a.Z), Vector3.new(b.X, b.Y, -b.Z)
	local delta = pb - pa
	local length = math.max(0.05, delta.Magnitude)
	local dir = delta.Magnitude > 0.01 and delta.Unit or Vector3.new(0, 1, 0)
	local up = math.abs(dir.Y) > 0.95 and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0)
	local cf = CFrame.lookAt((pa + pb) / 2, (pa + pb) / 2 + dir, up) * CFrame.Angles(0, math.pi / 2, 0)
	local o = table.clone(opts or DECO)
	o.Shape = Enum.PartType.Cylinder
	return kit:Part(name, Vector3.new(length, diameter, diameter), cf, color, material or M.SmoothPlastic, o)
end

-- Touffe de feuillage (plusieurs ovales) + fleurs piquées dessus
local function shrub(kit: any, rng: Random, x: number, y: number, d: number, w: number, h: number, leaves: { Color3 }, bloom: Color3?, blooms: number, bloomSize: number)
	local n = 4
	for k = 1, n do
		local a = k / n * math.pi * 2 + rng:NextNumber(0, 0.6)
		local r = w * 0.2
		egg(kit, "Leaves", Vector3.new(w * 0.62, h * 0.7, w * 0.62), L(x + math.cos(a) * r, y + h * 0.36, d + math.sin(a) * r), leaves[(k - 1) % #leaves + 1], M.LeafyGrass)
	end
	egg(kit, "Leaves", Vector3.new(w * 0.7, h * 0.8, w * 0.7), L(x, y + h * 0.5, d), leaves[1], M.LeafyGrass)
	if bloom then
		for k = 1, blooms do
			local a = rng:NextNumber(0, math.pi * 2)
			local t = rng:NextNumber(0.35, 1)
			local px = x + math.cos(a) * w * 0.38 * t
			local pd = d + math.sin(a) * w * 0.38 * t
			local py = y + h * (0.45 + 0.5 * math.sqrt(math.max(0, 1 - t * t * 0.8)))
			kit:Ball("Bloom", px, py, pd, bloomSize * rng:NextNumber(0.85, 1.15), bloom:Lerp(WHITE, rng:NextNumber(0, 0.15)), M.SmoothPlastic, DECO)
		end
	end
end

type PieceMaker = (kit: any, variant: number) -> ()
local PIECES: { [string]: PieceMaker } = {}

PIECES.TerracottaPot = function(kit, variant)
	local rng = Random.new(variant * 17 + 3)
	kit:CylY("Saucer", 0, 0, 0, 1.75, 0.12, TERRA_DARK, M.Concrete, DECO)
	kit:CylY("Pot", 0, 0.1, 0, 1.36, 1.02, TERRA, M.Concrete, DECO)
	kit:CylY("PotTaper", 0, 0.06, 0, 1.12, 0.3, TERRA:Lerp(EARTH, 0.1), M.Concrete, DECO)
	kit:CylY("PotRim", 0, 1.08, 0, 1.66, 0.3, TERRA:Lerp(WHITE, 0.08), M.Concrete, DECO)
	kit:CylY("Soil", 0, 1.2, 0, 1.44, 0.22, EARTH, M.Ground, DECO)
	local bloom = BLOOMS[(variant - 1) % #BLOOMS + 1]
	shrub(kit, rng, 0, 1.2, 0, 1.5, 1.2, { LEAF_M, LEAF_D }, bloom, 9, 0.3)
end

PIECES.SteppingStones = function(kit, variant)
	local rng = Random.new(variant * 31 + 5)
	for k = 0, 3 do
		local dk = -2.55 + k * 1.72
		local size = 1.55 + rng:NextNumber(0, 0.45)
		local x = (k % 2 == 0 and -0.25 or 0.25) + rng:NextNumber(-0.1, 0.1)
		local stone = kit:Part("SteppingStone", Vector3.new(0.14 + k * 0.004, size, size * rng:NextNumber(0.82, 0.95)), L(x, 0.02 + k * 0.004, dk) * CFrame.Angles(0, rng:NextNumber(0, 3), math.pi / 2),
			GREY_STONE:Lerp(PALE_STONE, rng:NextNumber(0, 0.6)), M.Slate, { Shadow = false, Shape = Enum.PartType.Cylinder })
		stone.CastShadow = false
	end
end

PIECES.FlowerUrn = function(kit, variant)
	local rng = Random.new(variant * 13 + 7)
	kit:Box("UrnPlinth", -0.7, 0.7, 0, 0.5, -0.7, 0.7, PALE_STONE, M.Limestone, SOLID)
	kit:Box("UrnPlinthCap", -0.78, 0.78, 0.5, 0.62, -0.78, 0.78, PALE_STONE:Lerp(WHITE, 0.15), M.Limestone, DECO)
	kit:CylY("UrnFoot", 0, 0.62, 0, 0.66, 0.5, PALE_STONE, M.Limestone, DECO)
	kit:CylY("UrnNeck", 0, 1.1, 0, 0.9, 0.2, PALE_STONE:Lerp(GREY_STONE, 0.3), M.Limestone, DECO)
	egg(kit, "UrnBowl", Vector3.new(2, 1.05, 2), L(0, 1.62, 0), PALE_STONE, M.Limestone)
	kit:CylY("UrnRim", 0, 1.98, 0, 2.14, 0.2, PALE_STONE:Lerp(WHITE, 0.2), M.Limestone, DECO)
	kit:CylY("Soil", 0, 2.02, 0, 1.86, 0.2, EARTH, M.Ground, DECO)
	local bloom = BLOOMS[(variant % #BLOOMS) + 1]
	shrub(kit, rng, 0, 2.1, 0, 1.7, 1.2, { LEAF_M, LEAF_D }, bloom, 10, 0.3)
	-- lierre qui retombe
	for k = 1, 5 do
		local a = k / 5 * math.pi * 2 + 0.4
		egg(kit, "Ivy", Vector3.new(0.34, 0.9, 0.3), L(math.cos(a) * 0.98, 1.72, math.sin(a) * 0.98) * CFrame.Angles(0, -a, 0.15), LEAF_D:Lerp(LEAF_L, k % 2 * 0.3), M.LeafyGrass)
	end
end

PIECES.RoseBush = function(kit, variant)
	local rng = Random.new(variant * 7 + 11)
	local bloom = ({ BLOOMS[1], BLOOMS[2], BLOOMS[3], Color3.fromRGB(255, 176, 120) })[(variant - 1) % 4 + 1]
	egg(kit, "Mulch", Vector3.new(2.7, 0.2, 2.6), L(0, 0.02, 0), EARTH:Lerp(WOOD_N, 0.3), M.Ground)
	shrub(kit, rng, 0, 0, 0, 2.5, 2.2, { LEAF_D, LEAF_M, LEAF_D }, bloom, 14, 0.4)
	-- quelques boutons plus clairs
	for _ = 1, 4 do
		local a = rng:NextNumber(0, math.pi * 2)
		kit:Ball("Bud", math.cos(a) * 0.8, 1.7 + rng:NextNumber(0, 0.4), math.sin(a) * 0.8, 0.22, bloom:Lerp(WHITE, 0.35), M.SmoothPlastic, DECO)
	end
end

PIECES.GardenLantern = function(kit, _variant)
	kit:CylY("LanternBase", 0, 0, 0, 0.9, 0.24, IRON, M.Metal, SOLID)
	kit:CylY("LanternPost", 0, 0.2, 0, 0.22, 2.9, IRON, M.Metal, DECO)
	kit:CylY("LanternCollar", 0, 3.05, 0, 0.5, 0.14, IRON, M.Metal, DECO)
	kit:Box("LanternFloor", -0.36, 0.36, 3.17, 3.27, -0.36, 0.36, IRON, M.Metal, DECO)
	kit:Box("LanternGlass", -0.3, 0.3, 3.27, 4.03, -0.3, 0.3, Color3.fromRGB(255, 232, 180), M.Glass, { Shadow = false, T = 0.35 })
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			kit:Box("LanternFrame", sx * 0.34 - 0.04, sx * 0.34 + 0.04, 3.27, 4.03, sz * 0.34 - 0.04, sz * 0.34 + 0.04, IRON, M.Metal, DECO)
		end
	end
	local bulb = kit:Ball("LanternBulb", 0, 3.6, 0, 0.3, Color3.fromRGB(255, 214, 150), M.SmoothPlastic, DECO)
	bulb:SetAttribute("NightGlow", true)
	kit:Box("LanternCap", -0.44, 0.44, 4.03, 4.13, -0.44, 0.44, IRON, M.Metal, DECO)
	kit:Cone("LanternRoof", 0, 4.12, 0, 0.5, 0.42, 4, IRON, M.Metal)
	kit:Ball("LanternFinial", 0, 4.6, 0, 0.16, IRON, M.Metal, DECO)
end

PIECES.LavenderPlanter = function(kit, variant)
	local rng = Random.new(variant * 19 + 2)
	local wood = WOOD_W:Lerp(WOOD_N, (variant % 3) * 0.3)
	for _, sx in ipairs({ -1, 1 }) do
		kit:Box("PlanterFoot", sx * 2.1 - 0.2, sx * 2.1 + 0.2, 0, 0.23, -0.75, 0.75, wood:Lerp(IRON, 0.3), M.Wood, DECO)
	end
	for row = 0, 2 do
		local y0 = 0.2 + row * 0.34
		kit:Box("PlanterBoard", -2.3, 2.3, y0, y0 + 0.32, -0.85, -0.7, wood:Lerp(WHITE, row * 0.04), M.WoodPlanks, DECO)
		kit:Box("PlanterBoard", -2.3, 2.3, y0, y0 + 0.32, 0.7, 0.85, wood:Lerp(WHITE, row * 0.04), M.WoodPlanks, DECO)
		kit:Box("PlanterBoard", -2.3, -2.15, y0, y0 + 0.32, -0.7, 0.7, wood:Lerp(WHITE, row * 0.04), M.WoodPlanks, DECO)
		kit:Box("PlanterBoard", 2.15, 2.3, y0, y0 + 0.32, -0.7, 0.7, wood:Lerp(WHITE, row * 0.04), M.WoodPlanks, DECO)
	end
	kit:Box("PlanterCap", -2.38, 2.38, 1.22, 1.3, -0.93, -0.62, wood:Lerp(WHITE, 0.12), M.Wood, DECO)
	kit:Box("PlanterCap", -2.38, 2.38, 1.22, 1.3, 0.62, 0.93, wood:Lerp(WHITE, 0.12), M.Wood, DECO)
	kit:Box("Soil", -2.12, 2.12, 0.25, 1.12, -0.67, 0.67, EARTH, M.Ground, DECO)
	local lavender = Color3.fromRGB(146, 112, 196)
	for k = 0, 3 do
		local x = -1.6 + k * 1.07
		egg(kit, "LavenderTuft", Vector3.new(1.0, 0.7, 1.0), L(x, 1.3, 0), Color3.fromRGB(120, 150, 110), M.LeafyGrass)
		for s = 1, 5 do
			local a = s / 5 * math.pi * 2 + rng:NextNumber(0, 0.5)
			local lean = CFrame.Angles(math.sin(a) * 0.25, 0, math.cos(a) * 0.25)
			local base = L(x + math.cos(a) * 0.25, 1.45, math.sin(a) * 0.25) * lean
			kit:Part("LavenderStem", Vector3.new(0.06, 0.9, 0.06), base * CFrame.new(0, 0.45, 0), Color3.fromRGB(110, 140, 96), M.SmoothPlastic, DECO)
			egg(kit, "Lavender", Vector3.new(0.2, 0.62, 0.2), base * CFrame.new(0, 1.12, 0), lavender:Lerp(WHITE, rng:NextNumber(0, 0.2)), M.Fabric)
		end
	end
end

PIECES.HydrangeaBush = function(kit, variant)
	local rng = Random.new(variant * 23 + 1)
	local hues = { Color3.fromRGB(120, 150, 232), Color3.fromRGB(236, 150, 196), Color3.fromRGB(176, 136, 222), Color3.fromRGB(244, 244, 248) }
	local bloom = hues[(variant - 1) % #hues + 1]
	egg(kit, "Mulch", Vector3.new(3.2, 0.2, 3.1), L(0, 0.02, 0), EARTH:Lerp(WOOD_N, 0.3), M.Ground)
	shrub(kit, rng, 0, 0, 0, 3.0, 2.4, { LEAF_M, LEAF_D }, nil, 0, 0)
	for k = 1, 8 do
		local a = k / 8 * math.pi * 2 + rng:NextNumber(0, 0.4)
		local r = rng:NextNumber(0.6, 1.1)
		kit:Ball("Hydrangea", math.cos(a) * r, 1.7 + rng:NextNumber(0, 0.6), math.sin(a) * r, rng:NextNumber(0.75, 0.95), bloom:Lerp(WHITE, rng:NextNumber(0, 0.18)), M.Fabric, DECO)
	end
end

PIECES.BirdHouse = function(kit, variant)
	local paint = ({ Color3.fromRGB(120, 170, 200), Color3.fromRGB(226, 120, 110), PAINT, Color3.fromRGB(150, 190, 120) })[(variant - 1) % 4 + 1]
	kit:Box("BirdPost", -0.13, 0.13, 0, 3.5, -0.13, 0.13, WOOD_W, M.Wood, DECO)
	kit:Box("BirdFloor", -0.62, 0.62, 3.5, 3.6, -0.62, 0.62, WOOD_N, M.Wood, DECO)
	kit:Box("BirdBox", -0.5, 0.5, 3.6, 4.5, -0.5, 0.5, paint, M.WoodPlanks, DECO)
	-- pignon + toit à deux pentes
	kit:Part("BirdGable", Vector3.new(0.98, 0.45, 0.5), L(0.245, 4.72, 0) * CFrame.Angles(0, -math.pi / 2, 0), paint, M.WoodPlanks, DECO, "WedgePart")
	kit:Part("BirdGable", Vector3.new(0.98, 0.45, 0.5), L(-0.245, 4.72, 0) * CFrame.Angles(0, math.pi / 2, 0), paint, M.WoodPlanks, DECO, "WedgePart")
	for _, s in ipairs({ -1, 1 }) do
		kit:SlabX("BirdRoof", 0, { s * 0.72, 4.4 }, { 0, 5.0 }, 1.3, 0.1, Color3.fromRGB(96, 70, 60), M.WoodPlanks, DECO)
		local _ = s
	end
	kit:CylD("BirdHole", 0, 4.15, -0.52, 0.34, 0.06, Color3.fromRGB(30, 22, 18), M.SmoothPlastic, DECO)
	kit:CylD("BirdPerch", 0, 3.85, -0.62, 0.07, 0.3, WOOD_N, M.Wood, DECO)
	-- petite mésange posée
	local blue, yellow = Color3.fromRGB(70, 110, 180), Color3.fromRGB(240, 204, 70)
	egg(kit, "Bird", Vector3.new(0.3, 0.3, 0.44), L(0.25, 3.72, -0.72), yellow, M.SmoothPlastic)
	kit:Ball("BirdHead", 0.25, 3.94, -0.86, 0.22, blue, M.SmoothPlastic, DECO)
	kit:Part("BirdTail", Vector3.new(0.08, 0.06, 0.3), L(0.25, 3.76, -0.48), blue, M.SmoothPlastic, DECO)
end

PIECES.HangingBasket = function(kit, variant)
	local rng = Random.new(variant * 29 + 3)
	kit:CylY("HookPost", 0, 0, 0, 0.14, 4.4, IRON, M.Metal, DECO)
	-- crosse
	rod(kit, "Hook", Vector3.new(0, 4.4, 0), Vector3.new(0.35, 4.75, 0), 0.12, IRON, M.Metal)
	rod(kit, "Hook", Vector3.new(0.35, 4.75, 0), Vector3.new(0.8, 4.78, 0), 0.12, IRON, M.Metal)
	rod(kit, "Hook", Vector3.new(0.8, 4.78, 0), Vector3.new(0.95, 4.55, 0), 0.12, IRON, M.Metal)
	for k = 0, 2 do
		local a = k / 3 * math.pi * 2
		rod(kit, "Chain", Vector3.new(0.95, 4.5, 0), Vector3.new(0.95 + math.cos(a) * 0.5, 3.25, math.sin(a) * 0.5), 0.04, IRON, M.Metal)
	end
	egg(kit, "Basket", Vector3.new(1.2, 0.9, 1.2), L(0.95, 3.1, 0), Color3.fromRGB(150, 110, 70), M.Fabric)
	local bloom = BLOOMS[(variant + 1) % #BLOOMS + 1]
	shrub(kit, rng, 0.95, 3.1, 0, 1.3, 0.8, { LEAF_M }, bloom, 8, 0.24)
	for k = 1, 4 do
		local a = k / 4 * math.pi * 2 + 0.3
		egg(kit, "Trailing", Vector3.new(0.3, 0.8, 0.3), L(0.95 + math.cos(a) * 0.55, 2.8, math.sin(a) * 0.55), LEAF_D, M.LeafyGrass)
		kit:Ball("Bloom", 0.95 + math.cos(a) * 0.6, 2.55, math.sin(a) * 0.6, 0.22, bloom, M.SmoothPlastic, DECO)
	end
end

PIECES.RoundFlowerBed = function(kit, variant)
	local rng = Random.new(variant * 37 + 9)
	local radius = 2.7
	for k = 0, 13 do
		local a = k / 14 * math.pi * 2
		local cf = along(math.cos(a) * radius, 0.21, math.sin(a) * radius, -math.sin(a), math.cos(a))
		kit:Part("BedStone", Vector3.new(1.18, 0.42 + (k % 3) * 0.1, 0.42), cf, GREY_STONE:Lerp(PALE_STONE, (k % 4) / 4), M.Slate, DECO)
	end
	kit:CylY("BedSoil", 0, 0, 0, radius * 2 - 0.3, 0.36, EARTH, M.Ground, DECO)
	-- cercle extérieur de petites fleurs, puis un cœur plus haut
	local outer = BLOOMS[(variant - 1) % #BLOOMS + 1]
	local inner = BLOOMS[(variant + 2) % #BLOOMS + 1]
	for k = 0, 9 do
		local a = k / 10 * math.pi * 2
		egg(kit, "Tuft", Vector3.new(0.8, 0.5, 0.8), L(math.cos(a) * 1.95, 0.45, math.sin(a) * 1.95), LEAF_M, M.LeafyGrass)
		kit:Ball("Bloom", math.cos(a) * 1.95, 0.72, math.sin(a) * 1.95, 0.34, outer:Lerp(WHITE, rng:NextNumber(0, 0.15)), M.SmoothPlastic, DECO)
	end
	shrub(kit, rng, 0, 0.3, 0, 2.2, 1.6, { LEAF_D, LEAF_M }, inner, 10, 0.34)
end

PIECES.GardenBench = function(kit, variant)
	local wood = ({ Color3.fromRGB(170, 120, 78), WOOD_W, Color3.fromRGB(120, 150, 110) })[(variant - 1) % 3 + 1]
	HouseGarden.Bench(kit, 0, 0, wood)
end

PIECES.VegetablePatch = function(kit, variant)
	local rng = Random.new(variant * 41 + 4)
	local wood = WOOD_W
	for _, side in ipairs({ -1, 1 }) do
		kit:Box("PatchBoard", -3.2, 3.2, 0, 0.6, side * 1.9 - 0.12, side * 1.9 + 0.12, wood, M.WoodPlanks, SOLID)
		kit:Box("PatchBoard", side * 3.08 - 0.12, side * 3.08 + 0.12, 0, 0.6, -1.78, 1.78, wood, M.WoodPlanks, SOLID)
	end
	kit:Box("PatchSoil", -2.94, 2.94, 0.02, 0.5, -1.76, 1.76, EARTH:Lerp(Color3.new(0, 0, 0), 0.1), M.Ground, DECO)
	-- rangée 1 : salades ; rangée 2 : carottes ; rangée 3 : tomates tuteurées
	for k = 0, 4 do
		local x = -2.4 + k * 1.2
		egg(kit, "Lettuce", Vector3.new(0.9, 0.55, 0.9), L(x, 0.62, -1.15), Color3.fromRGB(150, 200, 96):Lerp(LEAF_M, rng:NextNumber(0, 0.4)), M.LeafyGrass)
		for s = 0, 2 do
			kit:Part("CarrotLeaf", Vector3.new(0.06, 0.7, 0.18), L(x + (s - 1) * 0.16, 0.85, 0) * CFrame.Angles(0, s, (s - 1) * 0.35), Color3.fromRGB(96, 170, 70), M.LeafyGrass, DECO)
		end
		kit:Ball("Carrot", x, 0.5, 0, 0.22, Color3.fromRGB(240, 130, 40), M.SmoothPlastic, DECO)
	end
	for k = 0, 2 do
		local x = -2 + k * 2
		kit:Box("TomatoStake", x - 0.05, x + 0.05, 0.4, 2.6, 1.15, 1.25, WOOD_N, M.Wood, DECO)
		egg(kit, "TomatoPlant", Vector3.new(0.9, 1.8, 0.8), L(x, 1.4, 1.1), LEAF_D, M.LeafyGrass)
		for s = 1, 4 do
			local a = s * 1.7 + k
			kit:Ball("Tomato", x + math.cos(a) * 0.36, 0.9 + s * 0.32, 1.1 + math.sin(a) * 0.32, 0.26, Color3.fromRGB(214, 44, 36), M.SmoothPlastic, DECO)
		end
	end
end

PIECES.PicnicTable = function(kit, variant)
	local wood = ({ Color3.fromRGB(166, 116, 74), WOOD_W })[(variant - 1) % 2 + 1]
	-- plateau (5 planches) et bancs (2 planches de chaque côté) ; v9.9 (PARK99,
	-- échelle SCALE99) : plateau à 2,3 (2,66), bancs à 1,45 (1,64)
	for k = 0, 4 do
		local d0 = -1.3 + k * 0.53
		kit:Box("TableBoard", -2.6, 2.6, 2.14, 2.3, d0, d0 + 0.49, wood:Lerp(WHITE, (k % 2) * 0.05), M.WoodPlanks, if k == 2 then SOLID else DECO)
	end
	for _, side in ipairs({ -1, 1 }) do
		for k = 0, 1 do
			local d0 = side * 2.05 - 0.45 + k * 0.46
			kit:Box("BenchBoard", -2.6, 2.6, 1.31, 1.45, d0, d0 + 0.42, wood, M.WoodPlanks, DECO)
		end
	end
	-- pieds en A + traverses
	for _, sx in ipairs({ -1.9, 1.9 }) do
		for _, side in ipairs({ -1, 1 }) do
			rod(kit, "TableLeg", Vector3.new(sx, 0, side * 1.95), Vector3.new(sx, 2.14, side * 0.35), 0.24, wood:Lerp(IRON, 0.15), M.Wood)
		end
		kit:Box("TableBrace", sx - 0.12, sx + 0.12, 1.17, 1.31, -2.4, 2.4, wood:Lerp(IRON, 0.15), M.Wood, DECO)
	end
	local block = kit:Box("TableBlock", -2.6, 2.6, 0, 1.31, -2.4, 2.4, wood, M.Wood, SOLID)
	block.Transparency = 1
	block.CastShadow = false
end

PIECES.Sundial = function(kit, _variant)
	kit:CylY("SundialStep", 0, 0, 0, 2.3, 0.3, GREY_STONE, M.Slate, SOLID)
	kit:CylY("SundialBase", 0, 0.3, 0, 1.3, 0.3, PALE_STONE, M.Limestone, DECO)
	kit:CylY("SundialColumn", 0, 0.6, 0, 0.8, 1.9, PALE_STONE, M.Limestone, DECO)
	kit:CylY("SundialTop", 0, 2.5, 0, 1.4, 0.24, PALE_STONE:Lerp(WHITE, 0.2), M.Limestone, DECO)
	kit:CylY("SundialDial", 0, 2.74, 0, 1.2, 0.07, BRONZE, M.Metal, DECO)
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		kit:Box("HourMark", math.cos(a) * 0.5 - 0.035, math.cos(a) * 0.5 + 0.035, 2.82, 2.85, math.sin(a) * 0.5 - 0.035, math.sin(a) * 0.5 + 0.035, BRONZE:Lerp(IRON, 0.5), M.Metal, DECO)
	end
	kit:Part("Gnomon", Vector3.new(0.05, 0.5, 0.55), L(0, 3.06, 0.05), BRONZE, M.Metal, DECO, "WedgePart")
end

-- Arche de roses (on passe dessous, le long de d)
local function roseArch(kit: any, variant: number, width: number)
	local rng = Random.new(variant * 43 + 8)
	local half = width / 2
	local bloom = ({ BLOOMS[2], BLOOMS[1], BLOOMS[3] })[(variant - 1) % 3 + 1]
	for _, sx in ipairs({ -1, 1 }) do
		for _, sd in ipairs({ -0.75, 0.75 }) do
			kit:Box("ArchPost", sx * half - 0.1, sx * half + 0.1, 0, 5.2, sd - 0.1, sd + 0.1, PAINT, M.Wood, if sd < 0 then SOLID else DECO)
		end
		for k = 0, 4 do
			kit:Box("ArchLattice", sx * half - 0.05, sx * half + 0.05, 0.6 + k * 1, 0.68 + k * 1, -0.68, 0.68, PAINT, M.Wood, DECO)
		end
	end
	-- arc : 9 segments
	local n = 9
	for k = 0, n - 1 do
		local a0, a1 = k / n * math.pi, (k + 1) / n * math.pi
		for _, sd in ipairs({ -0.75, 0.75 }) do
			rod(kit, "ArchBow", Vector3.new(math.cos(a0) * half, 5.2 + math.sin(a0) * 1.4, sd), Vector3.new(math.cos(a1) * half, 5.2 + math.sin(a1) * 1.4, sd), 0.16, PAINT, M.Wood)
		end
		local am = (a0 + a1) / 2
		kit:Box("ArchSlat", math.cos(am) * half - 0.06, math.cos(am) * half + 0.06, 5.12 + math.sin(am) * 1.4, 5.24 + math.sin(am) * 1.4, -0.85, 0.85, PAINT, M.Wood, DECO)
	end
	-- rosier grimpant
	for _, sx in ipairs({ -1, 1 }) do
		for k = 0, 4 do
			local y = 0.8 + k * 1.1
			egg(kit, "ClimbingLeaves", Vector3.new(0.7, 1.2, 1.5), L(sx * (half + 0.05), y, rng:NextNumber(-0.3, 0.3)), k % 2 == 0 and LEAF_D or LEAF_M, M.LeafyGrass)
			kit:Ball("Rose", sx * (half + 0.35), y + 0.2, rng:NextNumber(-0.6, 0.6), 0.3, bloom, M.SmoothPlastic, DECO)
		end
	end
	for k = 1, 7 do
		local a = k / 8 * math.pi
		egg(kit, "ClimbingLeaves", Vector3.new(1.1, 0.6, 1.6), L(math.cos(a) * half, 5.35 + math.sin(a) * 1.4, 0), LEAF_M, M.LeafyGrass)
		kit:Ball("Rose", math.cos(a) * half, 5.7 + math.sin(a) * 1.4, rng:NextNumber(-0.6, 0.6), 0.32, bloom, M.SmoothPlastic, DECO)
	end
end

PIECES.RoseArbor = function(kit, variant)
	roseArch(kit, variant, 4.6)
end

PIECES.GardenSwing = function(kit, variant)
	local wood = ({ Color3.fromRGB(170, 120, 78), PAINT })[(variant - 1) % 2 + 1]
	-- portique en A
	for _, sx in ipairs({ -2.6, 2.6 }) do
		for _, side in ipairs({ -1, 1 }) do
			rod(kit, "SwingLeg", Vector3.new(sx, 0, side * 1.55), Vector3.new(sx, 5.3, 0), 0.3, wood, M.Wood)
		end
		kit:Box("SwingBrace", sx - 0.1, sx + 0.1, 1.6, 1.8, -1.1, 1.1, wood, M.Wood, DECO)
	end
	kit:Box("SwingBeam", -2.9, 2.9, 5.3, 5.62, -0.16, 0.16, wood, M.Wood, DECO)
	-- balancelle (assise + dossier + coussins) suspendue par 4 cordes ; v9.9
	-- (PARK99, SCALE99) : coussin à 1,5 (1,98) ; GardenBuilder la fait se
	-- balancer quand quelqu'un s'y assoit (pièces "Swing*" autour de la poutre)
	local cushion = ({ Color3.fromRGB(230, 120, 120), Color3.fromRGB(120, 170, 210), Color3.fromRGB(240, 220, 150) })[(variant - 1) % 3 + 1]
	kit:Box("SwingSeat", -1.6, 1.6, 1.12, 1.3, -0.55, 0.55, wood, M.WoodPlanks, DECO)
	kit:Box("SwingCushion", -1.5, 1.5, 1.3, 1.5, -0.48, 0.48, cushion, M.Fabric, DECO)
	kit:Part("SwingBack", Vector3.new(3.2, 1.1, 0.14), L(0, 1.87, 0.62) * CFrame.Angles(-math.rad(12), 0, 0), wood, M.WoodPlanks, DECO)
	kit:Part("SwingBackCushion", Vector3.new(3.0, 0.9, 0.16), L(0, 1.92, 0.46) * CFrame.Angles(-math.rad(12), 0, 0), cushion:Lerp(WHITE, 0.1), M.Fabric, DECO)
	for _, sx in ipairs({ -1.5, 1.5 }) do
		for _, sd in ipairs({ -0.45, 0.45 }) do
			rod(kit, "SwingRope", Vector3.new(sx, 5.3, 0), Vector3.new(sx, 1.3, sd), 0.06, Color3.fromRGB(200, 180, 140), M.Fabric)
		end
	end
end

PIECES.StoneStatue = function(kit, _variant)
	local stone = Color3.fromRGB(214, 210, 202)
	kit:Box("StatuePlinth", -1.1, 1.1, 0, 1.5, -1.1, 1.1, GREY_STONE:Lerp(PALE_STONE, 0.4), M.Limestone, SOLID)
	kit:Box("StatueCap", -1.22, 1.22, 1.5, 1.7, -1.22, 1.22, PALE_STONE, M.Limestone, DECO)
	-- robe (cône par tranches), buste, tête, bras croisés, ailes
	for k = 0, 3 do
		kit:CylY("StatueRobe", 0, 1.7 + k * 0.55, 0, 1.4 - k * 0.2, 0.58, stone, M.Marble, DECO)
	end
	egg(kit, "StatueChest", Vector3.new(0.9, 0.9, 0.7), L(0, 4.2, 0), stone, M.Marble)
	kit:Ball("StatueHead", 0, 4.95, -0.05, 0.62, stone, M.Marble, DECO)
	egg(kit, "StatueHair", Vector3.new(0.68, 0.5, 0.66), L(0, 5.1, 0.04), stone:Lerp(GREY_STONE, 0.15), M.Marble)
	for _, s in ipairs({ -1, 1 }) do
		kit:Part("StatueArm", Vector3.new(0.22, 0.8, 0.24), L(s * 0.3, 4.05, -0.3) * CFrame.Angles(math.rad(50), 0, s * math.rad(55)), stone, M.Marble, DECO)
		egg(kit, "StatueWing", Vector3.new(0.18, 1.9, 1.1), L(s * 0.62, 4.4, 0.55) * CFrame.Angles(math.rad(-20), s * math.rad(-25), s * math.rad(-18)), stone:Lerp(WHITE, 0.1), M.Marble)
	end
	-- mousse au pied
	for k = 0, 3 do
		local a = k * 1.6
		egg(kit, "Moss", Vector3.new(0.9, 0.3, 0.6), L(math.cos(a) * 1.15, 0.1, math.sin(a) * 1.15), LEAF_D, M.Grass)
	end
end

PIECES.Gazebo = function(kit, _variant)
	local sides = 8
	local r = 4.7
	kit:CylY("GazeboBase", 0, 0, 0, r * 2 + 0.6, 0.4, GREY_STONE, M.Slate, SOLID)
	kit:CylY("GazeboDeck", 0, 0.38, 0, r * 2, 0.3, Color3.fromRGB(176, 136, 96), M.WoodPlanks, SOLID)
	for k = 0, sides - 1 do
		local a = (k + 0.5) / sides * math.pi * 2
		local x, dd = math.cos(a) * (r - 0.3), math.sin(a) * (r - 0.3)
		kit:Box("GazeboPost", x - 0.16, x + 0.16, 0.68, 6.2, dd - 0.16, dd + 0.16, PAINT, M.Wood, SOLID)
		-- garde-corps (sauf l'entrée, face à la rue : côté -d)
		local a2 = (k + 1.5) / sides * math.pi * 2
		local x2, d2 = math.cos(a2) * (r - 0.3), math.sin(a2) * (r - 0.3)
		local midA = (k + 1) / sides * math.pi * 2
		local isEntrance = math.sin(midA) < -0.9
		if not isEntrance then
			rod(kit, "GazeboRail", Vector3.new(x, 2.4, dd), Vector3.new(x2, 2.4, d2), 0.14, PAINT, M.Wood)
			rod(kit, "GazeboRail", Vector3.new(x, 1.2, dd), Vector3.new(x2, 1.2, d2), 0.1, PAINT, M.Wood)
			for s = 1, 3 do
				local t = s / 4
				local bx, bd = x + (x2 - x) * t, dd + (d2 - dd) * t
				kit:Box("GazeboBaluster", bx - 0.05, bx + 0.05, 0.68, 2.34, bd - 0.05, bd + 0.05, PAINT, M.Wood, DECO)
			end
		end
		-- lambrequin sous le toit
		rod(kit, "GazeboFascia", Vector3.new(x, 6.1, dd), Vector3.new(x2, 6.1, d2), 0.3, PAINT, M.Wood)
	end
	kit:CylY("GazeboRing", 0, 6.1, 0, r * 2 + 0.2, 0.3, PAINT, M.Wood, DECO)
	kit:Cone("GazeboRoof", 0, 6.4, 0, r + 0.8, 3.2, sides, Color3.fromRGB(96, 130, 120), M.Slate)
	kit:CylY("GazeboFinialBase", 0, 9.45, 0, 0.5, 0.3, PAINT, M.Wood, DECO)
	kit:Ball("GazeboFinial", 0, 9.9, 0, 0.44, BRONZE, M.Metal, DECO)
	-- banc circulaire au fond
	for k = 1, 3 do
		local a = (k + 1) / sides * math.pi * 2
		local x, dd = math.cos(a) * (r - 1.1), math.sin(a) * (r - 1.1)
		-- (v9.9 PARK99 : assise à 1,45 au-dessus du plancher, sur un pied)
		kit:Part("GazeboSeat", Vector3.new(2.6, 0.16, 0.8), along(x, 2.05, dd, -math.sin(a), math.cos(a)), Color3.fromRGB(176, 136, 96), M.WoodPlanks, DECO)
		kit:Part("GazeboSeatLeg", Vector3.new(1.8, 1.28, 0.5), along(x, 1.33, dd, -math.sin(a), math.cos(a)) * CFrame.new(0, 0, 0.05), PAINT, M.Wood, DECO)
	end
end

PIECES.TieredFountain = function(kit, _variant)
	local stone = PALE_STONE
	local water = Color3.fromRGB(120, 180, 210)
	-- bassin octogonal (8 margelles) + eau
	local r = 4.3
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		local side = 2 * r * math.tan(math.pi / 8) + 0.02 * (k % 2)
		kit:Part("FountainRim", Vector3.new(side, 1.1 + (k % 2) * 0.1, 0.6), along(math.cos(a) * r, 0.55, math.sin(a) * r, -math.sin(a), math.cos(a)), stone, M.Limestone, SOLID)
	end
	kit:CylY("FountainFloor", 0, 0.04, 0, r * 2 - 0.2, 0.28, GREY_STONE, M.Slate, DECO)
	kit:CylY("FountainWater", 0, 0.3, 0, r * 2 - 0.3, 0.55, water, M.Glass, { Shadow = false, T = 0.3 })
	kit:CylY("FountainColumn", 0, 0.3, 0, 1.1, 2.6, stone, M.Limestone, SOLID)
	egg(kit, "FountainBowl1", Vector3.new(4.4, 1.0, 4.4), L(0, 2.9, 0), stone, M.Limestone)
	kit:CylY("FountainRim1", 0, 3.2, 0, 4.5, 0.22, stone:Lerp(WHITE, 0.2), M.Limestone, DECO)
	kit:CylY("FountainWater1", 0, 3.26, 0, 4.1, 0.24, water, M.Glass, { Shadow = false, T = 0.25 })
	kit:CylY("FountainColumn2", 0, 3.45, 0, 0.6, 1.5, stone, M.Limestone, DECO)
	egg(kit, "FountainBowl2", Vector3.new(2.2, 0.6, 2.2), L(0, 5.0, 0), stone, M.Limestone)
	kit:CylY("FountainRim2", 0, 5.18, 0, 2.3, 0.16, stone:Lerp(WHITE, 0.2), M.Limestone, DECO)
	kit:CylY("FountainWater2", 0, 5.24, 0, 2.0, 0.18, water, M.Glass, { Shadow = false, T = 0.25 })
	kit:CylY("FountainTop", 0, 5.4, 0, 0.36, 0.8, stone, M.Limestone, DECO)
	local spout = kit:Ball("FountainSpout", 0, 6.3, 0, 0.44, stone, M.Limestone, DECO)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "FountainSpray"
	emitter.Color = ColorSequence.new(Color3.fromRGB(230, 246, 255), Color3.fromRGB(170, 214, 240))
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.18), NumberSequenceKeypoint.new(1, 0.08) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 0.85) })
	emitter.Lifetime = NumberRange.new(0.7, 0.95)
	emitter.Speed = NumberRange.new(4.5, 5.5)
	emitter.SpreadAngle = Vector2.new(16, 16)
	emitter.Acceleration = Vector3.new(0, -16, 0)
	emitter.Rate = 14
	emitter.LightInfluence = 1
	emitter.Parent = spout
	-- rideaux d'eau des vasques (fines gouttes)
	for index, y in ipairs({ 3.3, 5.25 }) do
		local anchor = kit:Ball("FountainDrip", 0, y, 0, 0.2, stone, M.Limestone, { Shadow = false, T = 1 })
		local drip = Instance.new("ParticleEmitter")
		drip.Name = "FountainCurtain"
		drip.Color = ColorSequence.new(Color3.fromRGB(220, 240, 255))
		drip.Size = NumberSequence.new(0.1)
		drip.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0.9) })
		drip.Lifetime = NumberRange.new(0.35, 0.5)
		drip.Speed = NumberRange.new(index == 1 and 5 or 3, index == 1 and 5.5 or 3.4)
		drip.SpreadAngle = Vector2.new(180, 0)
		drip.EmissionDirection = Enum.NormalId.Right
		drip.Acceleration = Vector3.new(0, -18, 0)
		drip.Rate = 16
		drip.LightInfluence = 1
		drip.Parent = anchor
	end
end

-- Serre (bonus du niveau 2) : armature, vitres, toit à deux pans, étagères de pots
PIECES.Greenhouse = function(kit, _variant)
	local frame = Color3.fromRGB(236, 238, 236)
	local w, dp, h = 9.6, 6.6, 4.6
	kit:Box("GreenhouseBase", -w / 2 - 0.2, w / 2 + 0.2, 0, 0.5, -dp / 2 - 0.2, dp / 2 + 0.2, Color3.fromRGB(170, 110, 90), M.Brick, SOLID)
	kit:Box("GreenhouseFloor", -w / 2 + 0.2, w / 2 - 0.2, 0.5, 0.56, -dp / 2 + 0.2, dp / 2 - 0.2, GREY_STONE, M.Slate, DECO)
	local glassOpts = { Shadow = false, T = 0.6 }
	-- murs vitrés (porte au milieu de la face avant)
	for _, side in ipairs({ -1, 1 }) do
		kit:Box("GreenhouseGlass", -w / 2 + 0.1, w / 2 - 0.1, 0.5, h, side * dp / 2 - 0.04, side * dp / 2 + 0.04, GLASS, M.Glass, if side > 0 then glassOpts else { Shadow = false, T = 0.62 })
		kit:Box("GreenhouseGlass", side * w / 2 - 0.04, side * w / 2 + 0.04, 0.5, h, -dp / 2 + 0.1, dp / 2 - 0.1, GLASS, M.Glass, glassOpts)
	end
	-- montants
	for k = 0, 6 do
		local x = -w / 2 + k * w / 6
		for _, side in ipairs({ -1, 1 }) do
			kit:Box("GreenhouseMullion", x - 0.08, x + 0.08, 0.5, h, side * dp / 2 - 0.1, side * dp / 2 + 0.1, frame, M.Metal, DECO)
		end
	end
	for k = 1, 3 do
		local dk = -dp / 2 + k * dp / 4
		for _, sx in ipairs({ -1, 1 }) do
			kit:Box("GreenhouseMullion", sx * w / 2 - 0.1, sx * w / 2 + 0.1, 0.5, h, dk - 0.08, dk + 0.08, frame, M.Metal, DECO)
		end
	end
	for _, y in ipairs({ 0.55, h - 0.1 }) do
		kit:Box("GreenhouseRail", -w / 2 - 0.12, w / 2 + 0.12, y, y + 0.14, -dp / 2 - 0.12, -dp / 2 + 0.12, frame, M.Metal, DECO)
		kit:Box("GreenhouseRail", -w / 2 - 0.12, w / 2 + 0.12, y, y + 0.14, dp / 2 - 0.12, dp / 2 + 0.12, frame, M.Metal, DECO)
	end
	-- toit vitré à deux pans + faîtage
	for _, side in ipairs({ -1, 1 }) do
		kit:Slab("GreenhouseRoof", 0, { h, side * (dp / 2 + 0.25) }, { h + 2, 0 }, w + 0.3, 0.08, GLASS, M.Glass, { Shadow = false, T = 0.55 })
		for k = 0, 6 do
			local x = -w / 2 + k * w / 6
			kit:Slab("GreenhouseRafter", x, { h + 0.14, side * (dp / 2 + 0.25) }, { h + 2.14, 0 }, 0.14, 0.14, frame, M.Metal, DECO)
		end
		kit:Triangle("GreenhouseGable", { side * w / 2, h, -dp / 2 }, { side * w / 2, h, dp / 2 }, { side * w / 2, h + 2, 0 }, 0.06, GLASS, M.Glass, { Shadow = false, T = 0.6 })
	end
	kit:Box("GreenhouseRidge", -w / 2 - 0.2, w / 2 + 0.2, h + 1.98, h + 2.18, -0.12, 0.12, frame, M.Metal, DECO)
	-- étagères + pots à l'intérieur
	for _, side in ipairs({ -1, 1 }) do
		local dd = side * (dp / 2 - 0.9)
		kit:Box("GreenhouseShelf", -w / 2 + 0.6, w / 2 - 0.6, 1.9, 2.02, dd - 0.6, dd + 0.6, WOOD_N, M.WoodPlanks, DECO)
		for _, sx in ipairs({ -1, 1 }) do
			kit:Box("GreenhouseShelfLeg", sx * (w / 2 - 0.8) - 0.08, sx * (w / 2 - 0.8) + 0.08, 0.56, 1.9, dd - 0.08, dd + 0.08, WOOD_N, M.Wood, DECO)
		end
		for k = 0, 5 do
			local x = -w / 2 + 1.3 + k * (w - 2.6) / 5
			kit:CylY("GreenhousePot", x, 2.02, dd, 0.6, 0.5, TERRA, M.Concrete, DECO)
			egg(kit, "GreenhousePlant", Vector3.new(0.8, 0.8 + (k % 3) * 0.25, 0.8), L(x, 2.75, dd), (k % 2 == 0) and LEAF_M or LEAF_L, M.LeafyGrass)
			if k % 2 == 1 then
				kit:Ball("Bloom", x + 0.15, 3.1, dd, 0.26, BLOOMS[k % #BLOOMS + 1], M.SmoothPlastic, DECO)
			end
		end
	end
end

-- Bassin aux carpes (bonus du niveau 3) : margelle de pierres, eau, nénuphars ;
-- les carpes (modèles "Koi") nagent (GardenBuilder les anime)
PIECES.KoiPond = function(kit, variant)
	local rng = Random.new(variant * 53 + 6)
	local rx, rd = 4.2, 2.7
	for k = 0, 17 do
		local a = k / 18 * math.pi * 2
		local cf = along(math.cos(a) * rx, 0.21, math.sin(a) * rd, -math.sin(a) * rx, math.cos(a) * rd)
		kit:Part("PondStone", Vector3.new(1.3, 0.42 + (k % 3) * 0.1, 0.7), cf, GREY_STONE:Lerp(PALE_STONE, rng:NextNumber(0, 0.7)), M.Slate, DECO)
	end
	egg(kit, "PondBed", Vector3.new(rx * 2 - 0.2, 0.3, rd * 2 - 0.2), L(0, -0.05, 0), Color3.fromRGB(52, 76, 70), M.Slate)
	local water = kit:Part("PondWater", Vector3.new(rx * 2 - 0.4, 0.06, rd * 2 - 0.4), L(0, 0.3, 0), Color3.fromRGB(70, 130, 140), M.Glass, { Shadow = false, T = 0.35 })
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = Vector3.new(1, 1, 1)
	mesh.Parent = water
	for k = 1, 5 do
		local x, dd = rng:NextNumber(-2.8, 2.8), rng:NextNumber(-1.6, 1.6)
		kit:Part("LilyPad", Vector3.new(0.05, 1.0, 1.0), L(x, 0.35 + k * 0.004, dd) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(70, 140, 70), M.SmoothPlastic, { Shadow = false, Shape = Enum.PartType.Cylinder })
		if k % 2 == 1 then
			kit:Ball("LilyFlower", x + 0.1, 0.48, dd, 0.3, Color3.fromRGB(255, 200, 220), M.SmoothPlastic, DECO)
		end
	end
	-- iris au bord
	for _, spot in ipairs({ { -4.2, 1.8 }, { 4.0, -2.0 } }) do
		for s = 0, 4 do
			kit:Part("Iris", Vector3.new(0.08, 1.4, 0.24), L(spot[1] + (s - 2) * 0.16, 0.9, spot[2]) * CFrame.Angles(0, s, (s - 2) * 0.12), LEAF_M, M.LeafyGrass, DECO)
		end
		kit:Ball("IrisFlower", spot[1], 1.7, spot[2], 0.34, Color3.fromRGB(120, 100, 210), M.SmoothPlastic, DECO)
	end
	-- carpes koï (animées)
	for k = 1, 3 do
		local color = ({ Color3.fromRGB(255, 120, 40), Color3.fromRGB(250, 246, 240), Color3.fromRGB(240, 70, 50) })[k]
		local fish = egg(kit, "Koi", Vector3.new(0.34, 0.2, 0.9), L(0, 0.2, 0), color, M.SmoothPlastic)
		fish:SetAttribute("KoiIndex", k)
	end
end

-- Arche de roses offerte (niveau 1) : plus large, on y passe à deux
PIECES.RoseArch = function(kit, variant)
	roseArch(kit, variant + 1, 4.8)
end

function HouseGarden.HasPiece(id: string): boolean
	return PIECES[id] ~= nil
end

-- (v9.8 GARDEN98) objet de jardin (ou aménagement bonus) au centre du kit
function HouseGarden.BuildPiece(kit: any, id: string, variant: number?)
	local maker = PIECES[id]
	if maker then
		maker(kit, math.max(1, math.floor(tonumber(variant) or 1)))
	else
		fallback(kit, 0, 0, { Icon = "🪴" })
	end
end

return HouseGarden
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="203">
          <Properties>
            <string name="Name">HouseKit</string>
            <string name="Source"><![CDATA[--[[
	HouseKit (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > HouseKit

	🚶 Dopamine Town (v9.4) : petit kit de construction des maisons 3D, dans
	le repère LOCAL d'une maison (WorldLayout) : x vers la droite du visiteur,
	y vers le haut (0 = sol de la parcelle), d = profondeur depuis la façade
	(d > 0 = dans la maison, d < 0 = jardin de devant).
	Toutes les pièces sont ancrées, CanTouch = false ; la déco (Solid = false)
	ne bloque ni les avatars ni les rayons ; petites pièces sans ombre.
	Le kit COMPTE ses pièces (kit.Stats.Count ; budget : manoir < 1200) et
	ses vraies lumières (kit.Stats.Lights <= MaxLights).

	API :
	  HouseKit.new(houseCF, folder) -> Kit
	  kit:Box(name, x0, x1, y0, y1, d0, d1, color, material?, opts?) -> BasePart
	  kit:Part(name, size, localCF, color, material?, opts?, className?) -> BasePart
	      (localCF : repère local, axe Z = -d ; voir kit.L)
	  kit.L(x, y, d) -> CFrame local ; kit:World(x, y, d) -> Vector3
	  kit:CylY / CylX / CylD (cylindres verticaux / le long de x / de d)
	  kit:Ball(name, x, y, d, diameter, color, material?, opts?)
	  kit:Slab(name, a, b, width, thick, color, material?, opts?)  (plaque
	      inclinée entre deux points a, b du plan (x fixe) : a = {y, d})
	  kit:Cone(name, x, y0, d, radius, height, sides, color, material?) (flèche
	      à N pans : toits coniques des tours)
	  kit:WallX(name, x0, x1, y0, y1, d0, d1, holes, color, material?, opts?)
	  kit:Light(part, color, range, brightness, kind?) (budget de lumières)
	  kit:Text(part, face, text, color, font?, pps?)  (SurfaceGui)
	  kit:Sub(offsetCF) -> Kit  (même dossier / compteurs, repère décalé)
]]

local HouseKit = {}
HouseKit.__index = HouseKit

local M = Enum.Material

export type Opts = {
	Solid: boolean?, -- collision + rayons (false par défaut pour la déco)
	Query: boolean?, -- rayons seulement (défaut = Solid)
	Shadow: boolean?, -- ombre portée (défaut : true pour les grosses pièces)
	T: number?, -- transparence
	Shape: Enum.PartType?,
}

-- (v10 HOUSE10) Phase = phase de construction ("Foundation" | "Walls" | "Roof" |
-- "Openings" | "Garden") notée en attribut BuildPhase sur chaque pièce créée
-- (animation de construction de CONSTRUCT10)
export type Stats = { Count: number, Lights: number, MaxLights: number, Phase: string? }

export type Kit = typeof(setmetatable({} :: {
	CF: CFrame,
	Folder: Instance,
	Stats: Stats,
	L: (x: number, y: number, d: number) -> CFrame,
}, HouseKit))

-- Hauteur du dessus de la pelouse des parcelles (TownMap) : le jardin de
-- devant est posé dessus (HouseKit.Sub)
HouseKit.LAWN = 0.45

local function localCF(x: number, y: number, d: number): CFrame
	return CFrame.new(x, y, -d)
end

function HouseKit.new(houseCF: CFrame, folder: Instance, maxLights: number?): Kit
	local self = setmetatable({
		CF = houseCF,
		Folder = folder,
		Stats = { Count = 0, Lights = 0, MaxLights = maxLights or 4 },
		L = localCF,
	}, HouseKit)
	return self
end

-- Kit décalé (même dossier, mêmes compteurs) : ex. le jardin posé sur la pelouse
function HouseKit.Sub(self: Kit, offset: CFrame, folder: Instance?): Kit
	return setmetatable({
		CF = self.CF * offset,
		Folder = folder or self.Folder,
		Stats = self.Stats,
		L = localCF,
	}, HouseKit)
end

function HouseKit.World(self: Kit, x: number, y: number, d: number): Vector3
	return self.CF * Vector3.new(x, y, -d)
end

-- Pièce au repère local `localCF` (axe Z local = -d)
function HouseKit.Part(self: Kit, name: string, size: Vector3, localCF: CFrame, color: Color3, material: Enum.Material?, opts: Opts?, className: string?): BasePart
	local o: Opts = opts or {}
	local p = Instance.new((className or "Part") :: any) :: BasePart
	p.Name = name
	p.Anchored = true
	p.Size = Vector3.new(math.max(0.05, size.X), math.max(0.05, size.Y), math.max(0.05, size.Z))
	p.CFrame = self.CF * localCF
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	local solid = o.Solid == true
	p.CanCollide = solid
	p.CanQuery = if o.Query ~= nil then o.Query else solid
	p.CanTouch = false
	if o.T then
		p.Transparency = o.T
	end
	local shadow = o.Shadow
	if shadow == nil then
		-- petites pièces : pas d'ombre (performance)
		shadow = math.max(p.Size.X, p.Size.Y, p.Size.Z) > 4
	end
	p.CastShadow = shadow
	if o.Shape and p:IsA("Part") then
		(p :: Part).Shape = o.Shape
	end
	local phase = self.Stats.Phase
	if phase then
		p:SetAttribute("BuildPhase", phase)
	end
	p.Parent = self.Folder
	self.Stats.Count += 1
	return p
end

-- Boîte alignée sur la maison : x0..x1, y0..y1, d0..d1
function HouseKit.Box(self: Kit, name: string, x0: number, x1: number, y0: number, y1: number, d0: number, d1: number, color: Color3, material: Enum.Material?, opts: Opts?): BasePart
	local size = Vector3.new(math.abs(x1 - x0), math.abs(y1 - y0), math.abs(d1 - d0))
	return self:Part(name, size, CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, -(d0 + d1) / 2), color, material, opts)
end

-- Cylindre vertical (pied en y0)
function HouseKit.CylY(self: Kit, name: string, x: number, y0: number, d: number, diameter: number, height: number, color: Color3, material: Enum.Material?, opts: Opts?): BasePart
	return self:Part(name, Vector3.new(height, diameter, diameter), CFrame.new(x, y0 + height / 2, -d) * CFrame.Angles(0, 0, math.pi / 2), color, material,
		HouseKit.With(opts, Enum.PartType.Cylinder))
end

-- Cylindre le long de x (centre x, y, d)
function HouseKit.CylX(self: Kit, name: string, x: number, y: number, d: number, diameter: number, length: number, color: Color3, material: Enum.Material?, opts: Opts?): BasePart
	return self:Part(name, Vector3.new(length, diameter, diameter), CFrame.new(x, y, -d), color, material, HouseKit.With(opts, Enum.PartType.Cylinder))
end

-- Cylindre le long de d (centre x, y, d) : disques face à la rue (horloges, hublots)
function HouseKit.CylD(self: Kit, name: string, x: number, y: number, d: number, diameter: number, length: number, color: Color3, material: Enum.Material?, opts: Opts?): BasePart
	return self:Part(name, Vector3.new(length, diameter, diameter), CFrame.new(x, y, -d) * CFrame.Angles(0, math.pi / 2, 0), color, material,
		HouseKit.With(opts, Enum.PartType.Cylinder))
end

function HouseKit.Ball(self: Kit, name: string, x: number, y: number, d: number, diameter: number, color: Color3, material: Enum.Material?, opts: Opts?): BasePart
	return self:Part(name, Vector3.new(diameter, diameter, diameter), CFrame.new(x, y, -d), color, material, HouseKit.With(opts, Enum.PartType.Ball))
end

function HouseKit.With(opts: Opts?, shape: Enum.PartType): Opts
	local o: any = opts and table.clone(opts) or {}
	o.Shape = shape
	return o
end

-- Plaque inclinée (toits, rampes, limons) entre a = {y, d} et b = {y, d},
-- centrée en x, largeur `width` (le long de x), épaisseur `thick` SOUS la
-- ligne a-b (le dessus de la plaque passe exactement par a et b)
function HouseKit.Slab(self: Kit, name: string, x: number, a: { number }, b: { number }, width: number, thick: number, color: Color3, material: Enum.Material?, opts: Opts?): BasePart
	local pa = Vector3.new(x, a[1], -a[2])
	local pb = Vector3.new(x, b[1], -b[2])
	local along = pb - pa
	local length = along.Magnitude
	local dir = along.Unit
	local right = Vector3.new(1, 0, 0)
	local up = dir:Cross(right)
	if up.Y < 0 then
		up = -up
	end
	local center = (pa + pb) / 2 - up * (thick / 2)
	local cf = CFrame.fromMatrix(center, right, up)
	return self:Part(name, Vector3.new(width, thick, length), cf, color, material, opts)
end

-- Même chose, mais la plaque est inclinée dans le plan (x, y) à d fixe : a = {x, y}
function HouseKit.SlabX(self: Kit, name: string, d: number, a: { number }, b: { number }, depth: number, thick: number, color: Color3, material: Enum.Material?, opts: Opts?): BasePart
	local pa = Vector3.new(a[1], a[2], -d)
	local pb = Vector3.new(b[1], b[2], -d)
	local along = pb - pa
	local dir = along.Unit
	local back = Vector3.new(0, 0, 1)
	local up = back:Cross(dir)
	if up.Y < 0 then
		up = -up
	end
	local center = (pa + pb) / 2 - up * (thick / 2)
	local cf = CFrame.fromMatrix(center, dir, up)
	return self:Part(name, Vector3.new(along.Magnitude, thick, depth), cf, color, material, opts)
end

-- Flèche à `sides` pans (toit conique) : base (rayon) en y0, pointe en y0 + height
function HouseKit.Cone(self: Kit, name: string, x: number, y0: number, d: number, radius: number, height: number, sides: number, color: Color3, material: Enum.Material?)
	local n = math.max(6, sides)
	local apothem = radius * math.cos(math.pi / n)
	local half = radius * math.sin(math.pi / n) -- demi-côté de la base
	local slant = math.sqrt(apothem * apothem + height * height)
	local center = Vector3.new(x, y0, -d)
	local apex = center + Vector3.new(0, height, 0)
	for index = 0, n - 1 do
		local angle = index / n * math.pi * 2
		local u = Vector3.new(math.cos(angle), 0, math.sin(angle)) -- vers l'extérieur
		local b = Vector3.new(-math.sin(angle), 0, math.cos(angle)) -- le long de la base
		local mid = center + u * apothem
		local m = (apex - mid).Unit
		-- chaque pan = deux coins (WedgePart) : angle droit au milieu de la base,
		-- un côté vers la pointe (Y), l'autre vers un coin de la base (-Z)
		for _, s in ipairs({ -1, 1 }) do
			local zAxis = -b * s
			local xAxis = m:Cross(zAxis)
			local pos = mid + m * (slant / 2) + b * s * (half / 2)
			self:Part(name, Vector3.new(0.3, slant, half), CFrame.fromMatrix(pos, xAxis, m, zAxis), color, material, { Shadow = true }, "WedgePart")
		end
	end
end

-- Triangle quelconque (points du repère local { x, y, d }) en deux coins
-- (WedgePart) d'épaisseur `thick`, la face "dessus" passant par les 3 points
-- (le côté `up` = direction qui doit être au-dessus, ex. le ciel pour un toit)
function HouseKit.Triangle(self: Kit, name: string, p1: { number }, p2: { number }, p3: { number }, thick: number, color: Color3, material: Enum.Material?, opts: Opts?)
	local v = { Vector3.new(p1[1], p1[2], -p1[3]), Vector3.new(p2[1], p2[2], -p2[3]), Vector3.new(p3[1], p3[2], -p3[3]) }
	-- base = plus long côté ; C = sommet opposé ; H = pied de la hauteur
	local best, bi = -1, 1
	for i = 1, 3 do
		local a, b = v[i], v[i % 3 + 1]
		local len = (b - a).Magnitude
		if len > best then
			best, bi = len, i
		end
	end
	local A, B, Cc = v[bi], v[bi % 3 + 1], v[(bi + 1) % 3 + 1]
	local ab = (B - A).Unit
	local H = A + ab * (Cc - A):Dot(ab)
	local normal = (B - A):Cross(Cc - A).Unit
	if normal.Y < 0 then
		normal = -normal
	end
	local offset = -normal * (thick / 2)
	local o: Opts = opts and table.clone(opts) or {}
	if o.Shadow == nil then
		o.Shadow = true
	end
	local height = (Cc - H).Magnitude
	if height < 0.02 then
		return
	end
	local yAxis = (Cc - H).Unit
	for _, P in ipairs({ A, B }) do
		local base = (P - H).Magnitude
		if base > 0.02 then
			local zAxis = (H - P).Unit
			local xAxis = yAxis:Cross(zAxis)
			local pos = H + (Cc - H) / 2 + (P - H) / 2 + offset
			self:Part(name, Vector3.new(thick, height, base), CFrame.fromMatrix(pos, xAxis, yAxis, zAxis), color, material, o, "WedgePart")
		end
	end
end

-- Mur plein le long de x avec des ouvertures `holes` = { { x0, x1, y0, y1 } }
function HouseKit.WallX(self: Kit, name: string, x0: number, x1: number, y0: number, y1: number, d0: number, d1: number, holes: { { number } }, color: Color3,
	material: Enum.Material?, opts: Opts?)
	local sorted = table.clone(holes)
	table.sort(sorted, function(a, b)
		return a[1] < b[1]
	end)
	local cursor = x0
	local function block(ax: number, bx: number, ay: number, by: number)
		if bx - ax < 0.05 or by - ay < 0.05 then
			return
		end
		self:Box(name, ax, bx, ay, by, d0, d1, color, material, opts)
	end
	for _, hole in ipairs(sorted) do
		local hx0, hx1 = math.max(x0, hole[1]), math.min(x1, hole[2])
		if hx1 > hx0 and hx0 >= cursor - 0.01 then
			block(cursor, hx0, y0, y1)
			block(hx0, hx1, y0, math.max(y0, hole[3]))
			block(hx0, hx1, math.min(y1, hole[4]), y1)
			cursor = hx1
		end
	end
	block(cursor, x1, y0, y1)
end

-- Mur plein le long de d (côtés, cloisons de la cage) à x0..x1, avec des
-- ouvertures `holes` = { { d0, d1, y0, y1 } }
function HouseKit.WallD(self: Kit, name: string, x0: number, x1: number, y0: number, y1: number, d0: number, d1: number, holes: { { number } }, color: Color3,
	material: Enum.Material?, opts: Opts?)
	local sorted = table.clone(holes)
	table.sort(sorted, function(a, b)
		return a[1] < b[1]
	end)
	local cursor = d0
	local function block(ad: number, bd: number, ay: number, by: number)
		if bd - ad < 0.05 or by - ay < 0.05 then
			return
		end
		self:Box(name, x0, x1, ay, by, ad, bd, color, material, opts)
	end
	for _, hole in ipairs(sorted) do
		local h0, h1 = math.max(d0, hole[1]), math.min(d1, hole[2])
		if h1 > h0 and h0 >= cursor - 0.01 then
			block(cursor, h0, y0, y1)
			block(h0, h1, y0, math.max(y0, hole[3]))
			block(h0, h1, math.min(y1, hole[4]), y1)
			cursor = h1
		end
	end
	block(cursor, d1, y0, y1)
end

-- Vraie lumière (PointLight / SpotLight), dans la limite du budget de la maison
function HouseKit.Light(self: Kit, part: BasePart, color: Color3, range: number, brightness: number, kind: string?): Light?
	local stats = self.Stats
	if stats.Lights >= stats.MaxLights then
		return nil
	end
	stats.Lights += 1
	local light = Instance.new((kind or "PointLight") :: any) :: Light
	light.Color = color
	light.Brightness = brightness
	light.Shadows = false
	;(light :: any).Range = range
	light.Parent = part
	return light
end

-- Texte sur une face (SurfaceGui)
function HouseKit.Text(_self: Kit, part: BasePart, face: Enum.NormalId, text: string, color: Color3, font: Enum.Font?, pps: number?, maxDistance: number?): TextLabel
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Text"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pps or 40
	gui.LightInfluence = 0.3
	gui.MaxDistance = maxDistance or 160
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(0.92, 0.84)
	label.Position = UDim2.fromScale(0.04, 0.08)
	label.Font = font or Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	label.Text = text
	label.Parent = gui
	return label
end

return HouseKit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="204">
          <Properties>
            <string name="Name">HouseLod</string>
            <string name="Source"><![CDATA[--[[
	HouseLod (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > HouseLod

	(v10 HOUSE10) 🏡 Niveaux de détail des maisons LOINTAINES (50 maisons en
	ville, fluide sur téléphone) :
	  - "Mid" (~250 à ~600 studs) : volume du bâtiment, vraies fenêtres
	    (cadre + vitre, une pièce chacune, volets si peu de fenêtres), porte,
	    toit de la bonne forme SANS détails (HouseDetail.Roof Detail = false),
	    cheminées, tours / fronton du manoir, clôtures et haies en blocs,
	    garage, arbres simplifiés ; ~60 à ~170 pièces ;
	  - "Far" (au-delà) : imposteur : bloc des murs, bandeaux de fenêtres par
	    étage, toit en 2 coins (ou bloc), tours du manoir ; <= ~12 pièces.
	Mêmes couleurs / formes que l'extérieur complet (HouseFacade.Resolve) :
	pas de "saut" visible quand on s'approche. La nuit, les vitres du Mid et
	les bandeaux du Far s'allument comme les vraies fenêtres (Glow.Part).

	API :
	  HouseLod.Build(kit, size, looks, level) -> { Glows = { [slot] = { Glow } }, Style, Arch }
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WorldLayout = require(ReplicatedStorage.Shared.WorldLayout)
local HouseDetail = require(script.Parent.HouseDetail)
local HouseFacade = require(script.Parent.HouseFacade)
local HouseKit = require(script.Parent.HouseKit)

local HouseLod = {}

local M = Enum.Material
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local GLASS_DAY = Color3.fromRGB(78, 100, 124)
local LEAF = Color3.fromRGB(104, 164, 96)
local TRUNK = Color3.fromRGB(128, 96, 74)
local DECO = { Shadow = false }

export type Result = { Glows: { [number]: { any } }, Style: string, Arch: string }

local function glow(result: Result, slot: number, part: BasePart)
	local list = result.Glows[slot]
	if not list then
		list = {}
		result.Glows[slot] = list
	end
	table.insert(list, { Part = part, Day = part.Color, DayMat = part.Material })
end

function HouseLod.Build(kit: any, size: any, looks: any, level: string): Result
	local spec = HouseFacade.Resolve(size, looks)
	local style, arch = spec.Style, spec.Arch
	local dims = WorldLayout.Dims(size)
	local T = WorldLayout.WALL_T
	local L, R = dims.Left - T, dims.Left + dims.Width + T
	local depth = dims.Depth
	local top = WorldLayout.FloorY(dims.Floors) + WorldLayout.WALL_H
	local hall0, hall1 = WorldLayout.HallSpan(size)
	local doorX = WorldLayout.DoorX(size)
	local result: Result = { Glows = {}, Style = style, Arch = arch }
	local wall, trim, roof = spec.Wall, spec.Trim, spec.Roof
	local g = kit:Sub(CFrame.new(0, HouseKit.LAWN, 0))
	local mansion = style == "Mansion" and arch == "Classic"
	local cottage = style == "Cottage" and arch == "Classic"

	-- corps du bâtiment (+ soubassement)
	kit:Box("LodBody", L, R, 0.05, top + 0.65, -0.3, depth + 0.3, wall, spec.WallMat, { Solid = true, Shadow = true })
	kit:Box("LodPlinth", L - 0.3, R + 0.3, -0.05, WorldLayout.PLINTH, -0.6, depth + 0.6, Color3.fromRGB(200, 194, 188), M.Concrete, DECO)

	if level == "Far" then
		-- bandeaux de fenêtres (devant / derrière), un par étage
		for floor = 1, dims.Floors do
			local y = WorldLayout.FloorY(floor)
			local front = kit:Box("LodWindows", L + 2, R - 2, y + 2.6, y + 8.6, -0.5, -0.3, GLASS_DAY, M.SmoothPlastic, DECO)
			glow(result, 0, front)
			kit:Box("LodWindows", L + 2, R - 2, y + 2.6, y + 8.6, depth + 0.3, depth + 0.5, GLASS_DAY, M.SmoothPlastic, DECO)
		end
		-- toit : 2 coins (pentes) ou un bloc plat
		local shape = spec.RoofShape
		if shape == "Flat" then
			kit:Box("LodRoof", L - 0.3, R + 0.3, top + 0.65, top + 1.6, -0.6, depth + 0.6, roof:Lerp(BLACK, 0.2), M.SmoothPlastic, DECO)
		else
			local rise = if shape == "Mansard" then 9 else depth * 0.36
			local x0, x1 = L, if cottage or style == "Townhouse" and arch == "Classic" then hall0 + 0.4 else R
			local up = Vector3.new(0, 1, 0)
			HouseDetail.Wedge(kit, "LodRoof", HouseDetail.V((x0 + x1) / 2, top + 0.65 + rise / 2, depth / 4 - 0.4), up, Vector3.new(0, 0, -1),
				Vector3.new(x1 - x0 + 2, rise, depth / 2 + 1.2), roof, spec.RoofMat, { Solid = true, Shadow = true })
			HouseDetail.Wedge(kit, "LodRoof", HouseDetail.V((x0 + x1) / 2, top + 0.65 + rise / 2, depth * 3 / 4 + 0.4), up, Vector3.new(0, 0, 1),
				Vector3.new(x1 - x0 + 2, rise, depth / 2 + 1.2), roof, spec.RoofMat, { Solid = true, Shadow = true })
		end
		if mansion then
			for _, s in ipairs({ -1, 1 }) do
				local tx = if s < 0 then L - 1 else R + 1
				kit:CylY("LodTower", tx, -0.15, 0.5, 14, top + 3.15, wall, spec.WallMat, { Solid = true })
				kit:Cone("LodTowerRoof", tx, top + 3.9, 0.5, 8.6, 12, 6, roof, spec.RoofMat)
			end
		end
		return result
	end

	-- ░░ Mid ░░
	-- fenêtres (cadre + vitre) des pièces, devant et derrière
	local count = 0
	for floor = 1, dims.Floors do
		for column = 1, dims.Columns do
			count += #HouseFacade.WindowRects(size, column, floor, spec)
		end
	end
	local shutters = spec.Shutters ~= "None" and count <= 16
	for floor = 1, dims.Floors do
		for column = 1, dims.Columns do
			local slot = (floor - 1) * dims.Columns + column
			for _, r in ipairs(HouseFacade.WindowRects(size, column, floor, spec)) do
				kit:Box("LodFrame", r[1] - 0.35, r[2] + 0.35, r[3] - 0.35, r[4] + 0.35, -0.42, -0.3, trim, M.SmoothPlastic, DECO)
				local pane = kit:Box("LodGlass", r[1], r[2], r[3], r[4], -0.48, -0.4, GLASS_DAY, M.SmoothPlastic, DECO)
				glow(result, slot, pane)
				if shutters then
					local w = math.min((r[2] - r[1]) / 2, 2.8)
					kit:Box("LodShutter", r[1] - 0.45 - w, r[1] - 0.45, r[3], r[4], -0.55, -0.3, spec.ShutterColor, M.Wood, DECO)
					kit:Box("LodShutter", r[2] + 0.45, r[2] + 0.45 + w, r[3], r[4], -0.55, -0.3, spec.ShutterColor, M.Wood, DECO)
				end
			end
			local b = HouseFacade.BackWindowRect(size, column, floor)
			local back = kit:Box("LodGlass", b[1], b[2], b[3], b[4], depth + 0.3, depth + 0.42, GLASS_DAY, M.SmoothPlastic, DECO)
			glow(result, slot, back)
		end
	end
	-- porte + perron
	local y1 = WorldLayout.FloorY(1)
	kit:Box("LodDoorFrame", doorX - 3.8, doorX + 3.8, y1, y1 + WorldLayout.DOOR_H + 0.6, -0.42, -0.3, trim, M.SmoothPlastic, DECO)
	kit:Box("LodDoor", doorX - 3.2, doorX + 3.2, y1, y1 + WorldLayout.DOOR_H - 0.1, -0.5, -0.4, spec.DoorColor, M.Wood, DECO)
	kit:Box("LodSteps", doorX - 5, doorX + 5, 0, y1 - 0.05, -4.5, -0.3, Color3.fromRGB(206, 200, 194), M.Limestone, { Solid = true, Shadow = false })
	-- volumes propres aux styles
	local roofX0, roofX1 = L, R
	if cottage then
		local annexTop = top + 3.2
		kit:Box("LodAnnex", hall0, hall1 + T + 0.05, top + 0.4, annexTop, -0.35, depth + 0.35, wall:Lerp(Color3.fromRGB(255, 126, 182), 0.1), spec.WallMat, { Solid = true })
		HouseDetail.GableX(kit, "LodAnnexGable", -0.3, depth + 0.3, hall0 - 0.9, hall1 + T + 0.9, annexTop, annexTop + 5.5, roof, spec.RoofMat, { Solid = true })
		roofX1 = hall0 + 0.4
	elseif style == "Townhouse" and arch == "Classic" then
		roofX1 = hall0 + 0.4
		kit:Box("LodCornice", L - 0.9, R + 0.9, top - 0.2, top + 1.1, -1.3, depth + 0.5, trim, M.Plaster, DECO)
	elseif mansion then
		kit:Box("LodCornice", L - 1, R + 1, top - 0.2, top + 1.3, -1.5, depth + 0.5, trim, M.Limestone, DECO)
		HouseDetail.GableX(kit, "LodPediment", -0.3, 1.5, doorX - 17, doorX + 17, top + 1.3, top + 12.3, trim, M.Limestone, { Solid = true })
		for _, s in ipairs({ -1, 1 }) do
			local tx = if s < 0 then L - 1 else R + 1
			kit:CylY("LodTower", tx, -0.15, 0.5, 14, top + 3.15, wall:Lerp(Color3.fromRGB(255, 126, 182), 0.06), spec.WallMat, { Solid = true })
			kit:CylY("LodTowerCrown", tx, top - 0.3, 0.5, 15.6, 1.2, trim, M.Limestone, DECO)
			kit:Cone("LodTowerRoof", tx, top + 3.9, 0.5, 8.6, 12, 6, roof, spec.RoofMat)
			for floor = 1, dims.Floors do
				local y = WorldLayout.FloorY(floor)
				local pane = kit:Box("LodGlass", tx - 1.8, tx + 1.8, y + 2.4, y + 8, -6.9, -6.4, GLASS_DAY, M.SmoothPlastic, DECO)
				glow(result, 0, pane)
			end
		end
	elseif arch == "Modern" then
		kit:Box("LodCladding", hall0 - 0.4, hall1 + T + 0.4, WorldLayout.PLINTH, top + 2.4, -1.1, depth + 0.45, Color3.fromRGB(176, 124, 82), M.WoodPlanks, { Solid = true })
	elseif style == "Loft" and spec.RoofShape == "Flat" then
		kit:Box("LodParapet", L, R, top + 0.65, top + 3.2, -0.3, depth + 0.3, wall, spec.WallMat, DECO)
		kit:Box("LodCoping", L - 0.4, R + 0.4, top + 3.2, top + 3.7, -0.7, depth + 0.7, Color3.fromRGB(216, 212, 208), M.Concrete, DECO)
		kit:CylY("LodTank", L + (R - L) * 0.2, top + 3.7, depth * 0.5, 6.4, 6, Color3.fromRGB(150, 110, 78), M.WoodPlanks, DECO)
	end
	-- toit (forme choisie, sans détails)
	if not (style == "Loft" and arch == "Classic" and spec.RoofShape == "Flat") then
		local info = HouseDetail.Roof(kit, roofX0, roofX1, -0.3, depth + 0.3, top + 0.65, {
			Shape = spec.RoofShape,
			Color = roof,
			Material = spec.RoofMat,
			Kind = spec.RoofKind,
			Over = if arch == "Chalet" then 3.2 else 1.6,
			Pitch = if arch == "Chalet" then 0.62 elseif arch == "Modern" then 0.35 else 0.75,
			Rise = if spec.RoofShape == "Mansard" then 9 else nil,
			Inset = 5,
			Fascia = trim,
			Wall = wall,
			WallMat = spec.WallMat,
			Detail = false,
			Parapet = spec.Parapet,
		})
		if spec.Chimney ~= "None" then
			local cx = roofX0 + (roofX1 - roofX0) * 0.7
			local cd = depth * 0.55
			local ytop = math.max(info.Ridge + 2.2, info.Surface(cx, cd) + 3)
			kit:Box("LodChimney", cx - 1.3, cx + 1.3, top + 0.7, ytop, cd - 1.3, cd + 1.3, if spec.Chimney == "Stone" then Color3.fromRGB(176, 168, 158) else Color3.fromRGB(168, 84, 66),
				M.Brick, DECO)
		end
	end
	-- garage attenant
	if style ~= "Mansion" and spec.Garage ~= "None" then
		local x0 = dims.Left + dims.Width + T + 0.05
		kit:Box("LodGarage", x0, x0 + 17, 0, 11, 1.2, 21, wall, spec.WallMat, { Solid = true })
		kit:Box("LodGarageDoor", x0 + 2, x0 + 14, 0.25, 8.2, 1.05, 1.2, trim:Lerp(WHITE, 0.5), M.SmoothPlastic, DECO)
	end
	-- jardin : clôture de devant, côtés, haie du fond, 2 arbres
	local fence = spec.Fence
	local fenceColor = if fence == "Picket" then Color3.fromRGB(250, 250, 246) elseif fence == "Hedge" then Color3.fromRGB(78, 138, 74)
		elseif fence == "Iron" then HouseDetail.IRON elseif fence == "Stone" then Color3.fromRGB(190, 182, 170) else Color3.fromRGB(150, 110, 76)
	local fenceMat = if fence == "Hedge" then M.Grass elseif fence == "Stone" then M.Cobblestone elseif fence == "Iron" then M.Metal else M.WoodPlanks
	local half = WorldLayout.PLOT_W / 2 - 0.4
	if fence ~= "None" then
		local f0, f1 = if mansion then L - 7 else dims.Left - 4, if mansion then R + 7 else dims.Left + dims.Width + 4
		g:Box("LodFence", f0, doorX - 2.4, 0, 2.6, -21.15, -20.85, fenceColor, fenceMat, DECO)
		g:Box("LodFence", doorX + 2.4, f1, 0, 2.6, -21.15, -20.85, fenceColor, fenceMat, DECO)
		for _, s in ipairs({ -1, 1 }) do
			g:Box("LodFence", s * half - 0.15, s * half + 0.15, 0, 2.6, -24, 51.4, fenceColor, fenceMat, DECO)
		end
	end
	g:Box("LodHedge", -half + 0.4, half - 0.4, 0, 2.6, 51.95, 53.35, Color3.fromRGB(78, 138, 74), M.Grass, DECO)
	for _, s in ipairs({ -1, 1 }) do
		local x = s * (half - 5)
		g:CylY("LodTrunk", x, 0, -24.5, 1, 7, TRUNK, M.Wood, DECO)
		g:Ball("LodLeaves", x, 9, -24.5, 7.5, LEAF, M.Grass, DECO)
	end
	return result
end

return HouseLod
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="205">
          <Properties>
            <string name="Name">HouseStairs</string>
            <string name="Source"><![CDATA[--[[
	HouseStairs (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > HouseStairs

	🚶 Dopamine Town : la CAGE D'ESCALIER / le HALL d'entrée d'une maison 3D
	(dans la travée où la maison 2D dessine l'entrée, WorldLayout.HallSpan).

	(v9.9 HOUSE99 — "l'escalier est au milieu de l'entrée, ça n'a aucun sens,
	il n'y a plus de place") : tout est repensé, pour chaque style et chaque
	étage, manoir compris :
	  - l'escalier LONGE LE MUR DE DROITE de la cage (WorldLayout.StairSpan),
	    une volée droite par étage, empilées ; le COULOIR d'entrée à gauche
	    (WorldLayout.CorridorSpan, ~7,4 studs) va de la porte d'entrée à la
	    porte de derrière sans rien au milieu ;
	  - vrai escalier : 18 marches de 0,72 (giron ~1,06, ~34° ; manoir ~38°),
	    girons avec nez qui dépasse, contremarches, tapis d'escalier (sur le
	    giron ET la contremarche), limon à la française côté couloir, limon de
	    mur, sous-face en plâtre, balustres (2 par marche), main courante,
	    main courante murale sur consoles, poteaux de départ / d'arrivée ;
	    loft : escalier industriel (limons d'acier, marches épaisses en chêne,
	    contremarches ouvertes, garde-corps à lisses) ;
	  - collision : rampe lisse INVISIBLE sur la ligne du milieu des marches
	    (pieds à ± une demi-marche, jamais bloqué) + garde invisible côté vide ;
	  - à chaque étage un PALIER : le couloir mène aux passages des pièces et au
	    départ de la volée suivante ; trémie bordée d'un garde-corps ;
	  - hall d'entrée meublé à la taille des avatars (SCALE99 : table 2,3 à
	    2,8 ; meubles hauts 5,5 à 6,2) : console avec lampe, bouquet et
	    vide-poche, grand miroir, porte-manteau avec manteau / chapeau /
	    parapluie, tapis de couloir, plante, banc, tableau, placard sous
	    l'escalier ; manoir = grand vestibule (lustre, guéridon et bouquet) ;
	  - sols par style : tomettes (chaumière), damier noir et blanc (maison de
	    ville), béton ciré (loft), marbre à cabochons (manoir) ; parquet aux
	    étages ; murs enduit + lambris ; hauteur libre >= 8,5 partout.
	Coût : la COQUE (sols, trémies, murs : toujours là, avec l'extérieur) est
	séparée de l'INTÉRIEUR (escalier, garde-corps, meubles, lampes) qui est
	construit en flux comme les pièces (HouseBuilder : seulement quand on est
	près) -> l'extérieur du manoir reste sous son budget.

	API :
	  HouseStairs.BuildShell(kit, size) -> { Parts }
	  HouseStairs.BuildInterior(kit, size) -> { Ramps: { BasePart }, Parts, Lights }
	  HouseStairs.Build(kit, size, colors?) -> { Ramps, Holes, Parts }  (les deux)
	  HouseStairs.Palette(size) -> Palette (couleurs du hall par style)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WorldLayout = require(ReplicatedStorage.Shared.WorldLayout)
local Locale = require(ReplicatedStorage.Shared.Locale)

local HouseStairs = {}

local M = Enum.Material
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local BRASS = Color3.fromRGB(214, 172, 96)
local CEILING = Color3.fromRGB(255, 250, 244)
local SKIN = WorldLayout.HALL_SKIN
local RAIL_H = 2.9 -- hauteur de la main courante au-dessus du nez des marches
local GUARD_H = 3.1 -- garde-corps des paliers

export type Palette = {
	Style: string,
	Floor1: Color3,
	Floor1Mat: Enum.Material,
	Tile2: Color3,
	Pattern: string, -- "Grid" | "Checker" | "Diamond" | "Joints"
	Upper: Color3,
	UpperMat: Enum.Material,
	Wall: Color3,
	WallMat: Enum.Material,
	Dado: Color3,
	DadoMat: Enum.Material,
	Trim: Color3,
	Tread: Color3,
	TreadMat: Enum.Material,
	Riser: Color3,
	Runner: Color3?,
	Rail: Color3,
	RailMat: Enum.Material,
	Baluster: Color3,
	BalusterMat: Enum.Material,
	Stringer: Color3,
	StringerMat: Enum.Material,
	Newel: Color3,
	Accent: Color3,
	Open: boolean, -- escalier industriel (contremarches ouvertes, lisses)
}


-- Petites réactions quand on clique sur un titre
local REACTIONS = { "😂", "🤯", "😱", "🤔", "👀", "🙃", "😮", "🧐", "📰", "😳" }

function NewsTicker.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local Format = ctx.Format
	local container: Frame = ctx.Container
	local overlay: Frame = ctx.Overlay
	local random = Random.new()

	local red = Color3.fromRGB(220, 26, 38)
	local darkRed = Color3.fromRGB(140, 8, 18)
	local navy = Color3.fromRGB(14, 20, 42)
	local navyLight = Color3.fromRGB(30, 42, 78)
	local yellow = Theme.Colors.Yellow
	local white = Color3.new(1, 1, 1)

	-- Police gras + italique (BuilderSans)
	local italicFont = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold, Enum.FontStyle.Italic)
	local boldFont = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.ExtraBold, Enum.FontStyle.Normal)

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	local function frame(props: { [string]: any }): Frame
		props.BorderSizePixel = 0
		if props.BackgroundTransparency == nil and props.BackgroundColor3 == nil then
			props.BackgroundTransparency = 1
		end
		return UIUtil.Create("Frame", props)
	end

	local function text(props: { [string]: any }, fontFace: Font?): TextLabel
		props.BackgroundTransparency = props.BackgroundTransparency or 1
		local label = UIUtil.Create("TextLabel", props)
		if fontFace then
			label.FontFace = fontFace
		end
		return label
	end

	------------------------------------------------------------------
	-- Titres "dynamiques" (utilisent l'état du joueur en direct)
	------------------------------------------------------------------
	local function data(): any
		return ctx.State.Data
	end

	local function stat(name: string): number
		local current = data()
		local stats = current and current.Stats
		return (stats and tonumber(stats[name])) or 0
	end

	local function field(name: string): number
		local current = data()
		return (current and tonumber(current[name])) or 0
	end

	local function playerName(): string
		local player = Players.LocalPlayer
		local name = player and player.DisplayName or Locale.T("SOMEONE")
		return string.upper(name)
	end

	local function big(value: number): string
		if value < 1e6 then
			return Format.WithSpaces(value)
		end
		return Format.Format(value)
	end

	-- Chaque générateur renvoie (rubrique, texte) ou nil s'il n'a rien à dire
	local DYNAMIC: { () -> (string?, string?) } = {
		function()
			return "BOURSE", Locale.T("RECORD: %s OWNS %s DOPAMINE, THE NEIGHBORS ARE WORRIED", playerName(), big(field("Dopamine")))
		end,
		function()
			local perSecond = field("PerSecond")
			if perSecond <= 0 then
				return nil
			end
			return "BOURSE", Locale.T("RECORD OUTPUT: %s DOPAMINE PER SECOND, SMILE FACTORIES RUNNING AT FULL SPEED", big(perSecond))
		end,
		function()
			return "INSOLITE", Locale.T("THE “CLICK ME” BUTTON HAS BEEN CLICKED %s TIMES, IT'S ASKING FOR A VACATION", big(stat("TotalClicks")))
		end,
		function()
			return "PEOPLE", Locale.T("EXCLUSIVE: %s HASN'T BLINKED IN 20 MINUTES", playerName())
		end,
		function()
			return "PEOPLE", Locale.T("INTERVIEW: %s CLAIMS THEY CAN “QUIT ANYTIME”", playerName())
		end,
		function()
			local rebirths = field("Rebirths")
			if rebirths <= 0 then
				return "SANTE", Locale.T("%s HAS NEVER BEEN TO THE OCEAN, THE SEAGULLS ARE WORRIED", playerName())
			end
			return "SANTE", Locale.T("%s HAS BEEN TO THE OCEAN %s TIMES... AND ALWAYS COMES BACK TO CLICK", playerName(), big(rebirths))
		end,
		function()
			local current = data()
			local screen = current and current.ScreenTime
			local today = screen and tonumber(screen.Today)
			if not today or today < 60 then
				return nil
			end
			return "SANTE", Locale.T("SCREEN TIME: %s HAS SPENT %s STARING AT A BUTTON TODAY", playerName(), string.upper(Format.Time(today)))
		end,
		function()
			local count = stat("LightningClicks")
			if count <= 0 then
				return nil
			end
			return "SPORT", Locale.T("%s LIGHTNING BOLTS CAUGHT BARE-HANDED: %s IS NOW A LEGEND", big(count), playerName())
		end,
		function()
			local count = stat("BubblesPopped")
			if count <= 0 then
				return nil
			end
			return "INSOLITE", Locale.T("%s BUBBLES POPPED: BUBBLE WRAP MAKERS THANK %s", big(count), playerName())
		end,
		function()
			local count = stat("SlotSpins")
			if count <= 0 then
				return nil
			end
			return "BOURSE", Locale.T("LUCKY MACHINE: %s FREE SPINS BY %s, THE MACHINE NEEDS A NAP", big(count), playerName())
		end,
		function()
			local count = stat("EmailsRead")
			if count <= 0 then
				return nil
			end
			return "TECH", Locale.T("%s EMAILS READ BY %s, AND THERE ARE STILL MORE", big(count), playerName())
		end,
		function()
			local count = stat("Bounces")
			if count <= 0 then
				return nil
			end
			return "SPORT", Locale.T("THE LOGO HAS BOUNCED %s TIMES, IT'S DIZZY BUT STILL AIMING FOR THE CORNER", big(count))
		end,
		function()
			local count = stat("DVDCorners")
			if count <= 0 then
				return nil
			end
			return "URGENT", Locale.T("HISTORIC: THE LOGO HIT THE CORNER %s TIMES AND %s SAW IT LIVE", big(count), playerName())
		end,
		function()
			local count = stat("PressCrushes")
			if count <= 0 then
				return nil
			end
			return "INSOLITE", Locale.T("INDUSTRY: %s THINGS CRUSHED BY %s, THE PRESS ASKS FOR A DAY OFF", big(count), playerName())
		end,
		function()
			local count = stat("GardenHarvests")
			if count <= 0 then
				return nil
			end
			return "CULTURE", Locale.T("GARDENING: %s FLOWERS HARVESTED BY %s, THE BEES WANT A RAISE", big(count), playerName())
		end,
		function()
			local count = stat("MinigamesWon")
			if count <= 0 then
				return nil
			end
			return "SPORT", Locale.T("ARCADE: %s WINS %s GAMES, THE HIGH-SCORE TABLE IS SHAKING", playerName(), big(count))
		end,
		function()
			local tickets = field("Tickets")
			if tickets <= 0 then
				return nil
			end
			return "BOURSE", Locale.T("ARCADE: %s HAS %s TICKETS, THE PRIZE COUNTER IS NERVOUS", playerName(), big(tickets))
		end,
		function()
			local ok, rank, total = pcall(ctx.State.GetServerRank)
			if not ok or type(rank) ~= "number" or type(total) ~= "number" or total < 2 then
				return nil
			end
			if rank == 1 then
				return "POLITIQUE", Locale.T("LEADERBOARD: %s IS #1 ON THE SERVER, OTHER PLAYERS DEMAND A RECOUNT", playerName())
			end
			return "POLITIQUE", Locale.T("LEADERBOARD: %s IS #%s OUT OF %s, TENSION IS RISING", playerName(), tostring(rank), tostring(total))
		end,
		function()
			local multiplier = field("RebirthMultiplier")
			if multiplier <= 1 then
				return nil
			end
			return "BOURSE", Locale.T("REBIRTH MULTIPLIER: %s, ECONOMISTS ARE BAFFLED", string.upper(Format.Multiplier(multiplier)))
		end,
		function()
			local rush = ctx.State.Rush
			if type(rush) ~= "table" or not rush.Active then
				return nil
			end
			local name = type(rush.Name) == "string" and rush.Name ~= "" and string.upper(rush.Name) or "RUSH"
			return "URGENT", Locale.T("RIGHT NOW: %s %s! EVERYONE'S CLICKING!", name, string.upper(Format.Multiplier(tonumber(rush.Multiplier) or 1)))
		end,
	}

	-- Paquets mélangés : chaque titre passe une fois avant de revenir
	local deck: { any } = {}
	local dynamicDeck: { any } = {}
	local function shuffle(list: { any })
		for i = #list, 2, -1 do
			local j = random:NextInteger(1, i)
			list[i], list[j] = list[j], list[i]
		end
	end

	local function nextDynamic(): (string?, string?)
		for _ = 1, #DYNAMIC do
			if #dynamicDeck == 0 then
				for _, generator in ipairs(DYNAMIC) do
					table.insert(dynamicDeck, generator)
				end
				shuffle(dynamicDeck)
			end
			local generator = table.remove(dynamicDeck)
			local ok, category, message = pcall(generator)
			if ok and type(category) == "string" and type(message) == "string" then
				return category, message
			end
		end
		return nil, nil
	end

	local function nextHeadline(): (string, string)
		if random:NextNumber() < DYNAMIC_CHANCE then
			local category, message = nextDynamic()
			if category and message then
				return category, message
			end
		end
		local headlines = Locale.Pick(HEADLINES)
		if #deck == 0 then
			for _, entry in ipairs(headlines) do
				table.insert(deck, entry)
			end
			shuffle(deck)
		end
		local entry = table.remove(deck) or headlines[1]
		return entry[1], entry[2]
	end

	------------------------------------------------------------------
	-- Construction du bandeau
	------------------------------------------------------------------
	-- Fond du défilé (bleu nuit, liseré rouge en bas)
	local strip = frame({ Name = "Strip", Size = UDim2.fromScale(1, 1), BackgroundColor3 = white, ZIndex = 1, Parent = container })
	UIUtil.Gradient(strip, ColorSequence.new(navyLight, navy), 90)
	frame({ Name = "TopLine", Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = white, BackgroundTransparency = 0.8, ZIndex = 6, Parent = container })
	frame({ Name = "BottomLine", Size = UDim2.new(1, 0, 0, 2), Position = UDim2.new(0, 0, 1, -2), BackgroundColor3 = red, ZIndex = 6, Parent = container })

	-- Zone de défilement (une piste qui glisse)
	local clip = frame({
		Name = "Clip",
		Size = UDim2.new(1, -(LEFT_W + CLOCK_W + SEGMENT_W), 1, 0),
		Position = UDim2.fromOffset(LEFT_W, 0),
		ClipsDescendants = true,
		ZIndex = 2,
		Parent = container,
	})
	local track = frame({ Name = "Track", Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = clip })

	-- Logo de la chaîne (reflet qui passe de temps en temps)
	local logo = frame({ Name = "Channel", Size = UDim2.new(0, LOGO_W, 1, 0), BackgroundColor3 = white, ClipsDescendants = true, ZIndex = 4, Parent = container })
	UIUtil.Gradient(logo, ColorSequence.new(Color3.fromRGB(255, 70, 80), darkRed), 90)
	text({
		Size = UDim2.new(1, 0, 1, -6),
		Text = "DC24",
		TextColor3 = white,
		TextSize = 17,
		ZIndex = 6,
		Parent = logo,
	}, boldFont)
	local logoBar = frame({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -5), Size = UDim2.fromOffset(34, 3), BackgroundColor3 = white, ZIndex = 6, Parent = logo })
	UIUtil.Corner(logoBar, 1)
	local logoGleam = frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, -30, 0.5, 0), Size = UDim2.fromOffset(16, 60), Rotation = 20, BackgroundColor3 = white, BackgroundTransparency = 0.6, ZIndex = 7, Parent = logo })
	frame({ Position = UDim2.new(1, -1, 0, 0), Size = UDim2.new(0, 1, 1, 0), BackgroundColor3 = white, BackgroundTransparency = 0.6, ZIndex = 7, Parent = logo })

	-- Badge "● DIRECT"
	local live = frame({ Name = "Live", Position = UDim2.fromOffset(LOGO_W, 0), Size = UDim2.new(0, LIVE_W, 1, 0), BackgroundColor3 = white, ZIndex = 4, Parent = container })
	UIUtil.Gradient(live, ColorSequence.new(Color3.fromRGB(40, 14, 20), Color3.fromRGB(18, 6, 10)), 90)
	local liveDot = frame({ Name = "LiveDot", Size = UDim2.fromOffset(9, 9), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 12, 0.5, 0), BackgroundColor3 = Color3.fromRGB(255, 50, 60), ZIndex = 6, Parent = live })
	UIUtil.Corner(liveDot, UDim.new(1, 0))
	local liveHalo = frame({ Size = UDim2.fromOffset(9, 9), AnchorPoint = Vector2.new(0.5, 0.5), Position = liveDot.Position, BackgroundColor3 = Color3.fromRGB(255, 50, 60), BackgroundTransparency = 0.5, ZIndex = 5, Parent = live })
	UIUtil.Corner(liveHalo, UDim.new(1, 0))
	local liveHaloScale = UIUtil.Create("UIScale", { Parent = liveHalo })
	text({
		Size = UDim2.new(1, -22, 1, 0),
		Position = UDim2.fromOffset(20, 0),
		Text = Locale.T("LIVE"),
		TextColor3 = white,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextScaled = true,
		ZIndex = 6,
		Parent = live,
	}, boldFont)
	UIUtil.Create("UITextSizeConstraint", { MaxTextSize = 13, MinTextSize = 8, Parent = live:FindFirstChildOfClass("TextLabel") })

	-- Cartouche de rubrique (blanc, bord droit en biais)
	local flashText = Locale.T("NEWS FLASH")
	local tag = frame({ Name = "FlashInfo", Position = UDim2.fromOffset(LOGO_W + LIVE_W, 0), Size = UDim2.new(0, TAG_W, 1, 0), BackgroundColor3 = white, ClipsDescendants = false, ZIndex = 4, Parent = container })
	local slant = frame({ Name = "Slant", Size = UDim2.fromOffset(20, HEIGHT + 20), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Rotation = 18, BackgroundColor3 = white, ZIndex = 4, Parent = tag })
	frame({ Size = UDim2.fromOffset(5, HEIGHT + 20), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, 12, 0.5, 0), Rotation = 18, BackgroundColor3 = red, ZIndex = 3, Parent = tag })
	-- Barre de couleur de la rubrique (à gauche du cartouche)
	local tagBar = frame({ Position = UDim2.fromOffset(0, 0), Size = UDim2.new(0, 4, 1, 0), BackgroundColor3 = red, ZIndex = 5, Parent = tag })
	local tagClip = frame({ Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -8, 1, 0), ClipsDescendants = true, ZIndex = 5, Parent = tag })
	local tagLabel = text({
		Name = "Title",
		Size = UDim2.fromScale(1, 1),
		Text = flashText,
		TextColor3 = red,
		TextSize = 16,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 5,
		Parent = tagClip,
	}, italicFont)
	UIUtil.Create("UITextSizeConstraint", { MaxTextSize = 16, MinTextSize = 9, Parent = tagLabel })

	-- Segment de droite (météo / marchés / production)
	local segment = frame({ Name = "Segment", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -CLOCK_W, 0, 0), Size = UDim2.new(0, SEGMENT_W, 1, 0), BackgroundColor3 = white, ClipsDescendants = true, ZIndex = 4, Parent = container })
	UIUtil.Gradient(segment, ColorSequence.new(Color3.fromRGB(38, 52, 96), Color3.fromRGB(20, 28, 56)), 90)
	frame({ Size = UDim2.new(0, 1, 1, 0), BackgroundColor3 = white, BackgroundTransparency = 0.7, ZIndex = 6, Parent = segment })
	-- Deux panneaux qui se relaient (glissement vertical)
	local panels = {}
	for i = 1, 2 do
		local panel = frame({ Size = UDim2.fromScale(1, 1), Position = UDim2.fromScale(0, i == 1 and 0 or 1), ZIndex = 5, Parent = segment })
		local icon = text({ Size = UDim2.new(0, 22, 1, 0), Position = UDim2.fromOffset(6, 0), Text = "", TextSize = 15, ZIndex = 6, Parent = panel })
		local name = text({
			Size = UDim2.new(1, -32, 0, 11),
			Position = UDim2.fromOffset(30, 3),
			Text = "",
			Font = Theme.Fonts.Title,
			TextColor3 = Color3.fromRGB(190, 204, 235),
			TextSize = 10,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 6,
			Parent = panel,
		})
		local value = text({
			Size = UDim2.new(1, -32, 0, 13),
			Position = UDim2.fromOffset(30, 15),
			Text = "",
			Font = Theme.Fonts.Number,
			TextColor3 = white,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			RichText = true,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 6,
			Parent = panel,
		})
		panels[i] = { Frame = panel, Icon = icon, Name = name, Value = value }
	end

	-- Horloge
	local clockBox = frame({ Name = "Clock", AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, CLOCK_W, 1, 0), BackgroundColor3 = white, ZIndex = 4, Parent = container })
	UIUtil.Gradient(clockBox, ColorSequence.new(Color3.fromRGB(255, 70, 80), darkRed), 90)
	local clockLabel = text({ Name = "Time", Size = UDim2.fromScale(1, 1), Font = Theme.Fonts.Mono, Text = "--:--", TextColor3 = white, TextSize = 15, ZIndex = 6, Parent = clockBox })

	-- Voile de flash (alerte) au-dessus de tout le bandeau
	local flashVeil = frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = white, BackgroundTransparency = 1, ZIndex = 8, Parent = container })

	-- Bouton invisible qui couvre tout le bandeau (clic / survol)
	local button = UIUtil.Create("TextButton", {
		Name = "HitArea",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 10,
		Parent = container,
	})

	------------------------------------------------------------------
	-- Mise en page selon la largeur (segment masqué si l'écran est étroit)
	------------------------------------------------------------------
	local segmentShown = true
	local function designWidthOf(guiObject: GuiObject): number
		local absHeight = container.AbsoluteSize.Y
		if absHeight <= 0 then
			return 1280
		end
		return guiObject.AbsoluteSize.X * (HEIGHT / absHeight)
	end

	local function refreshLayout()
		local width = designWidthOf(container)
		local show = width >= SEGMENT_MIN_WIDTH
		-- Largeur du bloc droit, lue par Email (compteur "non lus" juste à gauche)
		container:SetAttribute("RightInset", CLOCK_W + (show and SEGMENT_W or 0))
		if show ~= segmentShown then
			segmentShown = show
			segment.Visible = show
			clip.Size = UDim2.new(1, -(LEFT_W + CLOCK_W + (show and SEGMENT_W or 0)), 1, 0)
		end
	end
	ctx.Connect(container:GetPropertyChangedSignal("AbsoluteSize"), refreshLayout)
	container:SetAttribute("RightInset", CLOCK_W + SEGMENT_W)
	task.defer(refreshLayout)

	------------------------------------------------------------------
	-- Segment : météo, marchés, production du joueur
	------------------------------------------------------------------
	local weatherIndex = random:NextInteger(1, #WEATHER)
	local temperature = random:NextInteger(WEATHER[weatherIndex].Min, WEATHER[weatherIndex].Max)
	local indexValues = {}
	for i = 1, #INDICES.en do
		indexValues[i] = random:NextNumber(-3, 4)
	end
	local panelStep = 0
	local activePanel = 1

	local function fillPanel(panel)
		panelStep += 1
		local kind = panelStep % 3
		if kind == 1 then
			-- Météo (évolue doucement)
			if random:NextNumber() < 0.3 then
				weatherIndex = math.clamp(weatherIndex + random:NextInteger(-1, 1), 1, #WEATHER)
			end
			local weather = WEATHER[weatherIndex]
			temperature = math.clamp(temperature + random:NextInteger(-1, 1), weather.Min, weather.Max)
			local cities = Locale.Pick(CITIES)
			panel.Icon.Text = weather.Icon
			panel.Name.Text = string.upper(cities[random:NextInteger(1, #cities)])
			panel.Value.Text = temperature .. "°C"
		elseif kind == 2 then
			-- Indice boursier fantaisiste (marche aléatoire)
			local names = Locale.Pick(INDICES)
			local i = random:NextInteger(1, #names)
			indexValues[i] = math.clamp(indexValues[i] + random:NextNumber(-1.2, 1.2), -9.9, 9.9)
			local change = indexValues[i]
			local up = change >= 0
			panel.Icon.Text = up and "📈" or "📉"
			panel.Name.Text = names[i]
			panel.Value.Text = string.format('<font color="#%s">%s %s%.1f%%</font>', up and "3CDC6E" or "FF5A64", up and "▲" or "▼", up and "+" or "", change)
		else
			-- Production du joueur
			panel.Icon.Text = "⚡"
			panel.Name.Text = playerName()
			panel.Value.Text = Format.Format(field("PerSecond")) .. "/s"
		end
	end

	local function rotateSegment()
		if not segmentShown then
			return
		end
		local old = panels[activePanel]
		activePanel = activePanel % 2 + 1
		local new = panels[activePanel]
		fillPanel(new)
		new.Frame.Position = UDim2.fromScale(0, 1)
		UIUtil.Tween(new.Frame, 0.45, { Position = UDim2.fromScale(0, 0) }, Enum.EasingStyle.Quint)
		UIUtil.Tween(old.Frame, 0.45, { Position = UDim2.fromScale(0, -1) }, Enum.EasingStyle.Quint)
	end
	fillPanel(panels[1])

	------------------------------------------------------------------
	-- Titres qui défilent (sur la piste)
	------------------------------------------------------------------
	local items: { any } = {}
	local scroll = 0 -- position de la piste (pixels "design")

	local function measure(message: string, size: number): number
		local ok, result = pcall(function()
			return TextService:GetTextSize(message, size, Enum.Font.BuilderSansBold, Vector2.new(10000, HEIGHT))
		end)
		if ok and result then
			return result.X
		end
		return #message * size * 0.6
	end

	local function addItem(x: number)
		local categoryId, message = nextHeadline()
		local urgent = categoryId == "URGENT" or random:NextNumber() < URGENT_CHANCE
		local category = CATEGORIES[categoryId] or CATEGORIES.INSOLITE
		if urgent then
			category = CATEGORIES.URGENT
		end
		local chipText = Locale.T(category.Text)
		local chipW = measure(chipText, CHIP_TEXT_SIZE) + 14
		local textWidth = measure(message, TEXT_SIZE) + 10 -- un peu de marge pour l'italique
		local width = chipW + 8 + textWidth + SEPARATOR_W

		local itemFrame = frame({ Name = "Headline", Size = UDim2.fromOffset(width, HEIGHT), Position = UDim2.fromOffset(x, 0), ZIndex = 2, Parent = track })
		local chip = frame({ Name = "Category", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, -1), Size = UDim2.fromOffset(chipW, 17), BackgroundColor3 = category.Color, ZIndex = 3, Parent = itemFrame })
		UIUtil.Corner(chip, 4)
		local chipLabel = text({
			Size = UDim2.fromScale(1, 1),
			Font = Theme.Fonts.Title,
			Text = chipText,
			TextColor3 = urgent and Theme.Colors.TextDark or white,
			TextSize = CHIP_TEXT_SIZE,
			ZIndex = 4,
			Parent = chip,
		})
		local label = text({
			Name = "Text",
			Size = UDim2.fromOffset(textWidth, HEIGHT - 2),
			Position = UDim2.fromOffset(chipW + 8, 0),
			Text = message,
			TextColor3 = urgent and yellow or white,
			TextSize = TEXT_SIZE,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 3,
			Parent = itemFrame,
		}, italicFont)
		-- Séparateur : petit losange rouge
		local separator = frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(chipW + 8 + textWidth + SEPARATOR_W / 2, HEIGHT / 2 - 1), Size = UDim2.fromOffset(7, 7), Rotation = 45, BackgroundColor3 = red, ZIndex = 3, Parent = itemFrame })
		UIUtil.Stroke(separator, white, 1, 0.4)

		table.insert(items, {
			Frame = itemFrame,
			Label = label,
			Chip = chip,
			ChipLabel = chipLabel,
			Width = width,
			X = x, -- position sur la piste
			Urgent = urgent,
			Alerted = false,
			BaseColor = urgent and yellow or white,
			Category = category,
		})
	end

	------------------------------------------------------------------
	-- Cartouche de rubrique : suit le titre en cours de lecture
	------------------------------------------------------------------
	local shownCategory: any = nil
	local alertUntil = 0
	local alertText = ""
	local function showCategory(category: any)
		if category == shownCategory then
			return
		end
		shownCategory = category
		if os.clock() < alertUntil then
			return
		end
		tagLabel.Text = category and Locale.T(category.Text) or flashText
		local color = category and category.Color or red
		tagLabel.TextColor3 = (category and category == CATEGORIES.URGENT) and Theme.Colors.TextDark or color
		tagBar.BackgroundColor3 = color
		-- Petite glissade verticale à chaque changement
		tagLabel.Position = UDim2.fromOffset(0, 12)
		UIUtil.Tween(tagLabel, 0.25, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Back)
	end

	-- Alerte "URGENT" / "ALERTE" : le cartouche clignote en jaune
	local function triggerAlert(label: string?)
		alertUntil = os.clock() + 2.5
		alertText = label or Locale.T("URGENT!")
		tagLabel.Text = alertText
		ctx.Sound.Play("Notif", 0.8)
	end

	------------------------------------------------------------------
	-- Bandeau "ALERTE INFO" (descend sous le ticker, calque Overlay)
	------------------------------------------------------------------
	local banner = frame({
		Name = "BreakingNews",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, -BANNER_H - 20),
		Size = UDim2.fromOffset(BANNER_W, BANNER_H),
		Visible = false,
		ZIndex = 50,
		Parent = overlay,
	})
	-- Détruit avec le conteneur (arrêt du stimulus, détox)
	container.Destroying:Connect(function()
		banner:Destroy()
	end)
	local bannerShadow = frame({ Size = UDim2.new(1, 8, 1, 8), Position = UDim2.fromOffset(-4, 4), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.78, ZIndex = 50, Parent = banner })
	UIUtil.Corner(bannerShadow, 12)
	local bannerBody = frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = white, ClipsDescendants = true, ZIndex = 51, Parent = banner })
	UIUtil.Corner(bannerBody, 10)
	UIUtil.Gradient(bannerBody, ColorSequence.new(navyLight, navy), 90)
	UIUtil.Stroke(bannerBody, red, 2, 0)
	-- Bloc rouge "ALERTE / INFO EN DIRECT"
	local alertBox = frame({ Size = UDim2.new(0, 128, 1, 0), BackgroundColor3 = red, ZIndex = 52, Parent = bannerBody })
	UIUtil.Corner(alertBox, 10)
	UIUtil.Gradient(alertBox, ColorSequence.new(white, Color3.fromRGB(190, 190, 190)), 90)
	-- Coin droit carré du bloc rouge
	local alertEdge = frame({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, 12, 1, 0), BackgroundColor3 = red, ZIndex = 52, Parent = alertBox })
	local alertTitle = text({ Size = UDim2.new(1, -12, 0, 26), Position = UDim2.fromOffset(8, 6), Text = Locale.T("BREAKING"), TextColor3 = white, TextSize = 22, TextScaled = true, ZIndex = 53, Parent = alertBox }, italicFont)
	UIUtil.Create("UITextSizeConstraint", { MaxTextSize = 22, MinTextSize = 10, Parent = alertTitle })
	local alertSub = text({ Size = UDim2.new(1, -12, 0, 14), Position = UDim2.fromOffset(8, 34), Font = Theme.Fonts.Title, Text = Locale.T("NEWS ● LIVE"), TextColor3 = Color3.fromRGB(255, 225, 225), TextSize = 11, ZIndex = 53, Parent = alertBox })
	local bannerHeadline = UIUtil.Label({
		Text = "",
		Font = Theme.Fonts.Title,
		TextColor3 = white,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		Position = UDim2.fromOffset(140, 6),
		Size = UDim2.new(1, -152, 0, 30),
		MaxTextSize = 16,
		ZIndex = 52,
		Parent = bannerBody,
	})
	bannerHeadline.FontFace = italicFont
	-- Bande jaune du bas (sous-titre + heure)
	local subBand = frame({ Position = UDim2.new(0, 128, 1, -18), Size = UDim2.new(1, -128, 0, 18), BackgroundColor3 = yellow, ZIndex = 52, Parent = bannerBody })
	local bannerSub = text({
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -20, 1, 0),
		Font = Theme.Fonts.Title,
		Text = "",
		TextColor3 = Theme.Colors.TextDark,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 53,
		Parent = subBand,
	})
	-- Reflet qui balaie le bandeau
	local gleam = frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(-0.2, 0, 0.5, 0), Size = UDim2.new(0, 40, 1.6, 0), Rotation = 20, BackgroundColor3 = white, BackgroundTransparency = 0.6, ZIndex = 54, Parent = bannerBody })
	UIUtil.Create("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = gleam,
	})

	-- Bande "ALERTE INFO" qui traverse le défilé
	local sweep = frame({ Name = "BreakingSweep", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 260, 1, -6), BackgroundColor3 = yellow, Visible = false, ZIndex = 7, Parent = clip })
	UIUtil.Corner(sweep, 4)
	text({ Size = UDim2.fromScale(1, 1), Text = "⚡ " .. Locale.T("BREAKING") .. " ⚡", TextColor3 = darkRed, TextSize = 17, ZIndex = 8, Parent = sweep }, italicFont)

	local bannerUntil = 0
	local bannerToken = 0
	local flashUntil = 0
	local sweepStart = -1
	local function showBreaking()
		if not ctx.IsAlive() then
			return
		end
		-- Titre spécial : dynamique si possible, sinon un titre du paquet
		local _, message = nextDynamic()
		if not message then
			local _, fallback = nextHeadline()
			message = fallback
		end
		bannerToken += 1
		local token = bannerToken
		bannerHeadline.Text = message or ""
		local subtitles = Locale.Pick(BREAKING_SUBTITLES)
		bannerSub.Text = "● " .. clockLabel.Text .. "  ·  " .. subtitles[random:NextInteger(1, #subtitles)]
		banner.Visible = true
		banner.Position = UDim2.new(0.5, 0, 0, -BANNER_H - 20)
		UIUtil.Tween(banner, 0.5, { Position = UDim2.new(0.5, 0, 0, HEIGHT + 6) }, Enum.EasingStyle.Back)
		gleam.Position = UDim2.new(-0.2, 0, 0.5, 0)
		UIUtil.Tween(gleam, 1.1, { Position = UDim2.new(1.2, 0, 0.5, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
		bannerUntil = os.clock() + BREAKING_TIME
		-- Le bandeau flashe et la bande "ALERTE INFO" traverse le défilé
		flashUntil = os.clock() + 0.9
		sweepStart = os.clock()
		sweep.Visible = true
		triggerAlert(Locale.T("BREAKING"))
		task.delay(BREAKING_TIME, function()
			if token ~= bannerToken or not banner.Parent then
				return
			end
			UIUtil.Tween(banner, 0.35, { Position = UDim2.new(0.5, 0, 0, -BANNER_H - 20) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(0.4, function()
				if token == bannerToken and banner.Parent then
					banner.Visible = false
				end
			end)
		end)
	end

	task.spawn(function()
		local waitTime = random:NextNumber(25, 45)
		while ctx.IsAlive() do
			local finish = os.clock() + waitTime
			while ctx.IsAlive() and os.clock() < finish do
				task.wait(1)
			end
			if not ctx.IsAlive() then
				break
			end
			showBreaking()
			waitTime = random:NextNumber(BREAKING_MIN, BREAKING_MAX)
		end
	end)

	------------------------------------------------------------------
	-- Animation (une seule connexion)
	------------------------------------------------------------------
	local speed = SPEED
	local targetSpeed = SPEED

	-- Survol à la SOURIS uniquement (MouseEnter est aussi émulé par un
	-- toucher sur mobile, sans MouseLeave fiable : le bandeau resterait lent)
	local function onHover(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			targetSpeed = SLOW_SPEED
		end
	end
	ctx.Connect(button.InputBegan, onHover)
	ctx.Connect(button.InputChanged, onHover)
	ctx.Connect(button.InputEnded, function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			targetSpeed = SPEED
		end
	end)

	local segmentTimer = SEGMENT_TIME
	local gleamTimer = 2
	local lastUrgentBlink: boolean? = nil
	ctx.OnRender(function(dt: number)
		dt = math.min(dt, 0.1)
		speed += (targetSpeed - speed) * math.min(1, dt * 6)
		local clipWidth = designWidthOf(clip)
		local now = os.clock()

		-- La piste glisse (une seule propriété modifiée pour tout le défilé)
		scroll += speed * dt
		if scroll > REBASE_AT then
			-- Recentre la piste (garde des nombres petits)
			for _, item in ipairs(items) do
				item.X -= scroll
				item.Frame.Position = UDim2.fromOffset(item.X, 0)
			end
			scroll = 0
		end
		track.Position = UDim2.fromOffset(-scroll, 0)

		-- Suppression des titres sortis à gauche + titre en cours de lecture
		local blink = math.floor(now * 4) % 2 == 0
		local reading = nil
		local i = 1
		while i <= #items do
			local item = items[i]
			local screenX = item.X - scroll
			if screenX + item.Width < -4 then
				item.Frame:Destroy()
				table.remove(items, i)
			else
				if screenX <= 24 and screenX + item.Width > 24 then
					reading = item
				end
				if item.Urgent then
					-- Étiquette URGENT qui clignote
					if blink ~= lastUrgentBlink then
						item.Chip.BackgroundColor3 = blink and yellow or white
					end
					if not item.Alerted and screenX < clipWidth * 0.6 then
						item.Alerted = true
						triggerAlert()
					end
				end
				i += 1
			end
		end
		lastUrgentBlink = blink
		showCategory(reading and reading.Category or nil)

		-- Ajout de nouveaux titres à droite
		local guard = 0
		while guard < 4 and #items < MAX_ITEMS do
			local last = items[#items]
			local edge = last and (last.X + last.Width) or (scroll + clipWidth * 0.3)
			if last and edge - scroll > clipWidth + 30 then
				break
			end
			addItem(edge)
			guard += 1
		end

		-- Point "en direct" : clignote + halo qui s'élargit
		local pulse = (now % 1.2) / 1.2
		liveDot.BackgroundTransparency = (math.floor(now * 2) % 2 == 0) and 0 or 0.45
		liveHaloScale.Scale = 1 + pulse * 1.4
		liveHalo.BackgroundTransparency = 0.4 + pulse * 0.6

		-- Reflet sur le logo de la chaîne (toutes les ~6 s)
		gleamTimer -= dt
		if gleamTimer <= 0 then
			gleamTimer = 6
			logoGleam.Position = UDim2.new(0, -20, 0.5, 0)
			UIUtil.Tween(logoGleam, 0.6, { Position = UDim2.new(1, 20, 0.5, 0) }, Enum.EasingStyle.Quad)
		end

		-- Cartouche : alerte (jaune clignotant)
		if now < alertUntil then
			local fast = math.floor(now * 6) % 2 == 0
			local color = fast and yellow or white
			tag.BackgroundColor3 = color
			slant.BackgroundColor3 = color
			tagLabel.TextColor3 = fast and Theme.Colors.TextDark or red
			tagBar.BackgroundColor3 = red
			if tagLabel.Text ~= alertText then
				tagLabel.Text = alertText
			end
		elseif tag.BackgroundColor3 ~= white then
			tag.BackgroundColor3 = white
			slant.BackgroundColor3 = white
			local category = shownCategory
			shownCategory = false -- force la mise à jour
			showCategory(category)
		end

		-- Flash de tout le bandeau (alerte info)
		if now < flashUntil then
			local k = math.floor((flashUntil - now) * 7) % 2 == 0
			flashVeil.BackgroundTransparency = k and 0.55 or 1
		elseif flashVeil.BackgroundTransparency < 1 then
			flashVeil.BackgroundTransparency = 1
		end
		if sweepStart >= 0 then
			local k = (now - sweepStart) / 1.6
			if k >= 1 then
				sweepStart = -1
				sweep.Visible = false
			else
				sweep.Position = UDim2.new(1, -k * (clipWidth + 260), 0.5, 0)
			end
		end

		-- Bandeau "ALERTE INFO" : bloc rouge qui pulse
		if banner.Visible and now < bannerUntil + 0.5 then
			local slow = math.floor(now * 3) % 2 == 0
			local color = slow and red or darkRed
			alertBox.BackgroundColor3 = color
			alertEdge.BackgroundColor3 = color
			alertSub.TextTransparency = slow and 0 or 0.3
		end

		-- Segment météo / marchés
		segmentTimer -= dt
		if segmentTimer <= 0 then
			segmentTimer = SEGMENT_TIME
			rotateSegment()
		end
	end)

	-- Horloge (heure locale, deux-points qui clignotent)
	task.spawn(function()
		local colon = true
		while ctx.IsAlive() do
			local now = os.date("*t")
			if now and now.hour and now.min then
				clockLabel.Text = string.format(colon and "%02d:%02d" or "%02d %02d", now.hour, now.min)
			end
			colon = not colon
			task.wait(0.5)
		end
	end)

	------------------------------------------------------------------
	-- Clic sur un titre
	------------------------------------------------------------------
	local interaction = ctx.Config.Interactions and ctx.Config.Interactions.Headline
	local cooldown = (interaction and tonumber(interaction.Cooldown)) or 8
	local lastInteract = -math.huge
	local lastScaleX = 0.5

	ctx.Connect(button.Activated, function(input)
		-- Position X du clic (pixels réels ; milieu du bandeau par défaut)
		local px: number = clip.AbsolutePosition.X + clip.AbsoluteSize.X * 0.5
		if typeof(input) == "Instance" and input:IsA("InputObject") then
			px = input.Position.X
		end

		-- Titre sous le curseur (ou le plus proche)
		local hit, bestDistance = nil, math.huge
		for _, item in ipairs(items) do
			local absX = item.Frame.AbsolutePosition.X
			local absW = item.Frame.AbsoluteSize.X
			local distance = 0
			if px < absX then
				distance = absX - px
			elseif px > absX + absW then
				distance = px - (absX + absW)
			end
			if distance < bestDistance then
				hit, bestDistance = item, distance
			end
		end

		-- Position du clic sur la toile (échelle 0..1 de l'overlay)
		local overlayWidth = overlay.AbsoluteSize.X
		if overlayWidth > 0 then
			lastScaleX = math.clamp((px - overlay.AbsolutePosition.X) / overlayWidth, 0.05, 0.95)
		end

		ctx.Sound.Play("Click", 1.3 + random:NextNumber() * 0.2)
		if hit then
			local label = hit.Label
			label.TextColor3 = Theme.Colors.TextDark
			label.BackgroundTransparency = 0
			label.BackgroundColor3 = yellow
			label.Position = UDim2.new(label.Position.X, UDim.new(0, -3))
			UIUtil.Tween(label, 0.35, { Position = UDim2.new(label.Position.X, UDim.new(0, 0)) }, Enum.EasingStyle.Bounce)
			task.delay(0.7, function()
				if label.Parent then
					label.TextColor3 = hit.BaseColor
					UIUtil.Tween(label, 0.25, { BackgroundTransparency = 1 })
				end
			end)
		end

		-- Petite réaction sous le bandeau
		if effectsOn() then
			ctx.FloatText(overlay, UDim2.new(lastScaleX, 0, 0, 52), REACTIONS[random:NextInteger(1, #REACTIONS)], white, 30)
		end

		-- Récompense (le serveur a son propre délai ; on évite juste de spammer)
		local now = os.clock()
		if now - lastInteract >= cooldown then
			lastInteract = now
			ctx.Interact("Headline")
		end
	end)

	-- Bonus confirmé par le serveur
	ctx.OnBonus("Headline", function(payload)
		if not ctx.IsAlive() then
			return
		end
		local amount = tonumber(payload.Amount) or 0
		ctx.FloatText(overlay, UDim2.new(lastScaleX, 0, 0, 84), "+" .. Format.Format(amount), Theme.Colors.Gold, 34)
	end)
end

function NewsTicker.Stop(_ctx)
	-- Tout vit dans ctx.Container (détruit par le StimulusManager), sauf le
	-- bandeau "ALERTE INFO" (Overlay) détruit avec le conteneur ; les textes
	-- flottants de l'overlay se détruisent tout seuls.
end

return NewsTicker
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="144">
          <Properties>
            <string name="Name">Ocean</string>
            <string name="Source"><![CDATA[--[[
	Ocean (ModuleScript - cinématique, PAS une Feature)
	Emplacement : ReplicatedStorage > Client > Stimuli > Ocean

	Cinématique "Aller à l'océan" (détox / rebirth), jouée par le
	StimulusManager sur Notify { Type = "Detox" } :
	  Ocean.Play(ctx) remplit ctx.Container (plein écran, calque Cinematic)
	  et BLOQUE ~8,8 s (le manager coupe tout à 10 s), puis rend la main (le
	  manager détruit le cadre).

	v9 :
	  1. LA MARÉE MONTE : une vague (crête d'écume, embruns) monte du bas de
	     l'écran et recouvre toute l'interface en 0,45 s. La remise à zéro
	     du jeu (état envoyé juste après le Notify) se fait derrière elle.
	  2. Elle redescend et découvre, de haut en bas, un coucher de soleil
	     sur la plage : ciel dégradé, étoiles qui s'allument, soleil qui se
	     couche derrière la mer (halos, lueur de l'horizon), nuages roses
	     éclairés par dessous, voilier, mouettes, 4 couches de vagues avec
	     écume, reflets dorés du soleil sur l'eau, sable mouillé.
	  3. RESPIRATION : "Inspire..." (le cercle gonfle, la vague monte sur le
	     sable) puis "Expire..." (le cercle dégonfle, la vague redescend),
	     puis "Tout est calme."
	  4. RÉVÉLATION : flash, rayons dorés qui tournent, halo, pastille
	     "RENAISSANCE n°N", le multiplicateur qui compte de l'ancien au
	     nouveau ("x2 -> x2,5") puis rebondit, étincelles en gerbe, braises
	     qui montent ; texte "Tes gains sont multipliés pour toujours".
	  5. LA MARÉE REPART : une dernière vague recouvre la plage puis se
	     retire vers le bas et découvre l'interface toute neuve ; elle laisse
	     de l'écume qui éclate, et un reflet "propre" balaie l'écran.
	Sons inchangés : "Detox" au départ, "Bonus" à la révélation.
	Tout le décor déborde du cadre (EXTEND) pour couvrir aussi l'encoche et
	la barre du haut. Une seule boucle ctx.OnRender anime tout ; rien n'est
	créé après le départ.
]]

local Ocean = {}
Ocean.Slot = "Cinematic" -- pour la documentation : plein écran, calque Cinematic

local Locale = require(game:GetService("ReplicatedStorage").Shared.Locale)

local EXTEND = 140 -- débord du décor autour du cadre (encoche, barre du haut)
local HORIZON = 0.56
local BEACH_Y = 0.87 -- haut du sable
local TEXT_Y = 0.35 -- centre des textes
local TIDE_RISE = 0.36
local TIDE_DRAIN = 0.72
local CREST = 46 -- hauteur de la crête d'écume au-dessus de l'eau

local WHITE = Color3.new(1, 1, 1)
local INK = Color3.fromRGB(34, 26, 72) -- contour des textes

local WAVE_LAYERS = {
	{ Top = HORIZON, Color = Color3.fromRGB(164, 128, 196), Humps = 16, Speed = 0.45, Amp = 0.012, Foam = false },
	{ Top = HORIZON + 0.07, Color = Color3.fromRGB(104, 112, 196), Humps = 13, Speed = 0.6, Amp = 0.018, Foam = false },
	{ Top = HORIZON + 0.15, Color = Color3.fromRGB(56, 92, 176), Humps = 11, Speed = 0.75, Amp = 0.024, Foam = true },
	{ Top = HORIZON + 0.23, Color = Color3.fromRGB(30, 70, 150), Humps = 9, Speed = 0.9, Amp = 0.03, Foam = true },
}

local function easeOutCubic(t: number): number
	return 1 - (1 - t) ^ 3
end

local function easeInOutSine(t: number): number
	return -(math.cos(math.pi * t) - 1) / 2
end

local function easeOutBack(t: number): number
	local c = 1.7
	return 1 + (c + 1) * (t - 1) ^ 3 + c * (t - 1) ^ 2
end

function Ocean.Play(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local Create = UIUtil.Create
	local container: Frame = ctx.Container
	local random = Random.new()

	-- Données du rebirth (payload du Notify "Detox")
	local payload = type(ctx.Payload) == "table" and ctx.Payload or {}
	local multiplier = tonumber(ctx.Multiplier) or tonumber(payload.Multiplier)
	if not multiplier then
		local data = ctx.State.Data
		multiplier = (data and tonumber(data.RebirthMultiplier)) or 1
	end
	local rebirths = tonumber(ctx.Rebirths) or tonumber(payload.Rebirths) or 0
	-- Multiplicateur d'avant (pour le compteur qui monte)
	local previous = 1
	if rebirths > 1 and ctx.Formulas and type(ctx.Formulas.GetRebirthMultiplier) == "function" then
		local ok, value = pcall(ctx.Formulas.GetRebirthMultiplier, rebirths - 1)
		if ok and type(value) == "number" and value < multiplier then
			previous = value
		end
	end
	previous = math.min(previous, multiplier)

	-- Attend `seconds` ; faux si la cinématique a été coupée
	local function waitAlive(seconds: number): boolean
		local finish = os.clock() + seconds
		while os.clock() < finish do
			if not ctx.IsAlive() or not container.Parent then
				return false
			end
			task.wait()
		end
		return ctx.IsAlive() and container.Parent ~= nil
	end

	local function frame(props: { [string]: any }): Frame
		props.BorderSizePixel = 0
		return Create("Frame", props)
	end

	local function round(guiObject: GuiObject)
		UIUtil.Corner(guiObject, UDim.new(1, 0))
	end

	local function vertical(guiObject: GuiObject, keypoints: { ColorSequenceKeypoint }): UIGradient
		return Create("UIGradient", { Rotation = 90, Color = ColorSequence.new(keypoints), Parent = guiObject })
	end

	------------------------------------------------------------------
	-- Scène (cadre = zone sûre ; les éléments plein écran débordent)
	------------------------------------------------------------------
	local scene = frame({
		Name = "Scene",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 1,
		Parent = container,
	})

	-- Ciel : nuit en haut -> violet -> rose -> or à l'horizon
	local sky = frame({
		Name = "Sky",
		Position = UDim2.fromOffset(-EXTEND, -EXTEND),
		Size = UDim2.new(1, EXTEND * 2, HORIZON, EXTEND + 12),
		BackgroundColor3 = WHITE,
		ZIndex = 1,
		Parent = scene,
	})
	vertical(sky, {
		ColorSequenceKeypoint.new(0, Color3.fromRGB(28, 30, 84)),
		ColorSequenceKeypoint.new(0.3, Color3.fromRGB(84, 62, 148)),
		ColorSequenceKeypoint.new(0.58, Color3.fromRGB(214, 104, 150)),
		ColorSequenceKeypoint.new(0.8, Color3.fromRGB(255, 150, 112)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 208, 140)),
	})

	-- Étoiles (s'allument peu à peu)
	local stars = {}
	for _ = 1, 20 do
		local size = random:NextNumber(2, 4)
		local star = frame({
			Name = "Star",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(random:NextNumber(0.02, 0.98), 0, random:NextNumber(0, 0.26), -random:NextNumber(0, EXTEND * 0.8)),
			Size = UDim2.fromOffset(size, size),
			BackgroundColor3 = Color3.fromRGB(255, 250, 230),
			BackgroundTransparency = 1,
			ZIndex = 2,
			Parent = scene,
		})
		round(star)
		table.insert(stars, { Frame = star, Phase = random:NextNumber(0, math.pi * 2), Speed = random:NextNumber(1.5, 3.5), Delay = random:NextNumber(0, 1) })
	end

	-- Soleil (se couche derrière la mer) + halos
	local sunStart = HORIZON - 0.19
	local sunEnd = HORIZON + 0.035
	local sunHolder = frame({
		Name = "Sun",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, sunStart),
		Size = UDim2.fromOffset(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = scene,
	})
	local halos = {}
	for _, info in ipairs({ { 520, 0.9 }, { 330, 0.8 }, { 210, 0.62 } }) do
		local halo = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(info[1], info[1]),
			BackgroundColor3 = Color3.fromRGB(255, 196, 140),
			BackgroundTransparency = info[2],
			ZIndex = 3,
			Parent = sunHolder,
		})
		round(halo)
		table.insert(halos, { Frame = halo, Base = info[2] })
	end
	local sunDisc = frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(130, 130),
		BackgroundColor3 = WHITE,
		ZIndex = 4,
		Parent = sunHolder,
	})
	round(sunDisc)
	vertical(sunDisc, {
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 250, 214)),
		ColorSequenceKeypoint.new(0.6, Color3.fromRGB(255, 208, 120)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 150, 90)),
	})

	-- Lueur de l'horizon
	local horizonGlow = frame({
		Name = "HorizonGlow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, HORIZON),
		Size = UDim2.new(1, EXTEND * 2, 0, 70),
		BackgroundColor3 = Color3.fromRGB(255, 226, 170),
		BackgroundTransparency = 0.35,
		ZIndex = 5,
		Parent = scene,
	})
	Create("UIGradient", {
		Color = ColorSequence.new(WHITE),
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = horizonGlow,
	})

	-- Nuages roses (éclairés par dessous)
	local clouds = {}
	local cloudDefs = { { 0.14, 0.14, 250, 30 }, { 0.47, 0.07, 190, 24 }, { 0.8, 0.18, 230, 28 }, { 0.3, 0.3, 170, 20 } }
	for _, def in ipairs(cloudDefs) do
		local cloud = frame({
			Name = "Cloud",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(def[1], def[2]),
			Size = UDim2.fromOffset(def[3], def[4]),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.12,
			ZIndex = 6,
			Parent = scene,
		})
		round(cloud)
		local colors = {
			ColorSequenceKeypoint.new(0, Color3.fromRGB(150, 108, 176)),
			ColorSequenceKeypoint.new(0.55, Color3.fromRGB(236, 140, 170)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 196, 150)),
		}
		vertical(cloud, colors)
		for _, puff in ipairs({ { 0.34, 1.5 }, { 0.62, 1.15 } }) do
			local size = def[4] * puff[2]
			local bubble = frame({
				AnchorPoint = Vector2.new(0.5, 0.7),
				Position = UDim2.fromScale(puff[1], 0.4),
				Size = UDim2.fromOffset(size * 1.3, size),
				BackgroundColor3 = WHITE,
				BackgroundTransparency = 0.12,
				ZIndex = 6,
				Parent = cloud,
			})
			round(bubble)
			vertical(bubble, colors)
		end
		table.insert(clouds, { Frame = cloud, X = def[1], Y = def[2], Speed = random:NextNumber(0.004, 0.009) })
	end

	-- Mouettes (deux ailes qui battent)
	local gulls = {}
	for index = 1, 3 do
		local holder = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0, 0),
			Size = UDim2.fromOffset(34, 16),
			BackgroundTransparency = 1,
			ZIndex = 7,
			Parent = scene,
		})
		local wings = {}
		for side = -1, 1, 2 do
			local wing = frame({
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0.5, side * 7, 0.5, 0),
				Size = UDim2.fromOffset(16, 3),
				BackgroundColor3 = Color3.fromRGB(58, 40, 86),
				ZIndex = 7,
				Parent = holder,
			})
			round(wing)
			table.insert(wings, { Frame = wing, Side = side })
		end
		table.insert(gulls, {
			Frame = holder,
			Wings = wings,
			Phase = random:NextNumber(0, math.pi * 2),
			Speed = random:NextNumber(0.045, 0.07),
			X = -0.04 - index * 0.09,
			Y = 0.16 + index * 0.055,
		})
	end

	------------------------------------------------------------------
	-- Mer : couches de vagues (bosses arrondies + corps + écume)
	------------------------------------------------------------------
	local layers = {}
	for index, def in ipairs(WAVE_LAYERS) do
		local z = index == 1 and 8 or 8 + index -- (le voilier est entre la 1re et la 2e couche)
		local layer = frame({
			Name = "Wave",
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.5, def.Top),
			Size = UDim2.new(1.3, EXTEND * 2, 1 - def.Top, EXTEND + 30),
			BackgroundTransparency = 1,
			ZIndex = z,
			Parent = scene,
		})
		local body = frame({
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = def.Color,
			ZIndex = z,
			Parent = layer,
		})
		vertical(body, {
			ColorSequenceKeypoint.new(0, WHITE),
			ColorSequenceKeypoint.new(0.4, Color3.fromRGB(210, 210, 230)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 150, 190)),
		})
		for hump = 1, def.Humps do
			local bump = frame({
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale((hump - 0.5) / def.Humps, 0),
				Size = UDim2.fromScale(1.12 / def.Humps, 1),
				BackgroundColor3 = def.Color,
				ZIndex = z,
				Parent = layer,
			})
			Create("UIAspectRatioConstraint", {
				AspectRatio = 3.4,
				DominantAxis = Enum.DominantAxis.Width,
				Parent = bump,
			})
			round(bump)
		end
		if def.Foam then
			-- Petits traits d'écume sur la crête
			for foamIndex = 1, 7 do
				local foam = frame({
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.new(foamIndex / 8 + random:NextNumber(-0.03, 0.03), 0, 0, random:NextNumber(-6, 4)),
					Size = UDim2.fromOffset(random:NextInteger(40, 90), 3),
					BackgroundColor3 = WHITE,
					BackgroundTransparency = 0.45,
					ZIndex = z,
					Parent = layer,
				})
				round(foam)
			end
		end
		table.insert(layers, { Frame = layer, Def = def, Phase = random:NextNumber(0, math.pi * 2) })
	end

	-- Voilier sur l'horizon (silhouette)
	local boat = frame({
		Name = "Boat",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.74, 0, HORIZON, 3),
		Size = UDim2.fromOffset(30, 30),
		BackgroundTransparency = 1,
		ZIndex = 9,
		Parent = scene,
	})
	local hull = frame({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.fromOffset(28, 5),
		BackgroundColor3 = Color3.fromRGB(56, 36, 80),
		ZIndex = 9,
		Parent = boat,
	})
	UIUtil.Corner(hull, 3)
	local sail = frame({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0.5, 1, 1, -6),
		Size = UDim2.fromOffset(18, 18),
		BackgroundColor3 = Color3.fromRGB(70, 46, 96),
		ZIndex = 9,
		Parent = boat,
	})
	-- Voile triangulaire : moitié d'un carré (dégradé à bord net)
	Create("UIGradient", {
		Color = ColorSequence.new(WHITE),
		Rotation = 45,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.495, 0),
			NumberSequenceKeypoint.new(0.505, 1),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = sail,
	})
	frame({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -4),
		Size = UDim2.fromOffset(2, 24),
		BackgroundColor3 = Color3.fromRGB(56, 36, 80),
		ZIndex = 9,
		Parent = boat,
	})

	-- Reflets dorés du soleil sur l'eau (chemin de lumière)
	local glints = {}
	for index = 1, 12 do
		local depth = index / 12
		local glint = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5 + random:NextNumber(-0.04, 0.04) * (0.4 + depth), 0, HORIZON + 0.015 + depth * (BEACH_Y - HORIZON - 0.05), 0),
			Size = UDim2.fromOffset(math.floor(18 + depth * 60 * random:NextNumber(0.6, 1.2)), 3),
			BackgroundColor3 = Color3.fromRGB(255, 226, 150),
			BackgroundTransparency = 1,
			ZIndex = 13,
			Parent = scene,
		})
		round(glint)
		table.insert(glints, { Frame = glint, Phase = random:NextNumber(0, math.pi * 2), Speed = random:NextNumber(1.5, 3.2) })
	end

	------------------------------------------------------------------
	-- Plage : sable, sable mouillé, nappe d'eau qui monte et descend
	------------------------------------------------------------------
	local sand = frame({
		Name = "Sand",
		Position = UDim2.new(0, -EXTEND, BEACH_Y, 0),
		Size = UDim2.new(1, EXTEND * 2, 1 - BEACH_Y, EXTEND),
		BackgroundColor3 = WHITE,
		ZIndex = 14,
		Parent = scene,
	})
	vertical(sand, {
		ColorSequenceKeypoint.new(0, Color3.fromRGB(214, 170, 136)),
		ColorSequenceKeypoint.new(0.3, Color3.fromRGB(240, 196, 150)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(226, 172, 124)),
	})
	-- Nappe (translucide) + ligne d'écume à son bord
	local swash = frame({
		Name = "Swash",
		Position = UDim2.new(0, -EXTEND, BEACH_Y, -4),
		Size = UDim2.new(1, EXTEND * 2, 0, 30),
		BackgroundColor3 = Color3.fromRGB(96, 206, 226),
		BackgroundTransparency = 0.25,
		ZIndex = 15,
		Parent = scene,
	})
	Create("UIGradient", {
		Color = ColorSequence.new(WHITE),
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.1),
			NumberSequenceKeypoint.new(0.8, 0.45),
			NumberSequenceKeypoint.new(1, 0.7),
		}),
		Parent = swash,
	})
	local swashFoam = frame({
		Name = "SwashFoam",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 5),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.1,
		ZIndex = 16,
		Parent = swash,
	})
	round(swashFoam)
	for dot = 1, 14 do
		local size = random:NextInteger(5, 11)
		local bubble = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(dot / 15 + random:NextNumber(-0.02, 0.02), 0, 1, random:NextNumber(-3, 2)),
			Size = UDim2.fromOffset(size, size * 0.7),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.2,
			ZIndex = 16,
			Parent = swash,
		})
		round(bubble)
	end
	local swashHeight = 30 -- hauteur de la nappe (animée : respiration)

	------------------------------------------------------------------
	-- Respiration (cercle) + textes
	------------------------------------------------------------------
	local ring = frame({
		Name = "Breath",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, TEXT_Y),
		Size = UDim2.fromOffset(190, 190),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 1,
		ZIndex = 20,
		Parent = scene,
	})
	round(ring)
	local ringStroke = UIUtil.Stroke(ring, WHITE, 3, 1)
	local ringScale = Create("UIScale", { Scale = 0.6, Parent = ring })
	local ringInner = frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.72, 0.72),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 1,
		ZIndex = 20,
		Parent = ring,
	})
	round(ringInner)

	local function label(props: { [string]: any }): (TextLabel, UIStroke)
		local thickness = props.StrokeThickness or 2
		props.StrokeThickness = nil
		local text = UIUtil.Label(props)
		local stroke = UIUtil.Stroke(text, INK, thickness, 1)
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		return text, stroke
	end

	local mainText, mainStroke = label({
		Name = "MainText",
		Text = "",
		Font = Theme.Fonts.Title,
		TextColor3 = WHITE,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, TEXT_Y),
		Size = UDim2.new(0.8, 0, 0, 70),
		MaxTextSize = 56,
		TextTransparency = 1,
		ZIndex = 22,
		Parent = scene,
	})

	local function showText(textLabel: TextLabel, stroke: UIStroke, text: string, duration: number)
		textLabel.Text = text
		UIUtil.Tween(textLabel, duration, { TextTransparency = 0 }, Enum.EasingStyle.Sine)
		UIUtil.Tween(stroke, duration, { Transparency = 0.3 }, Enum.EasingStyle.Sine)
	end

	local function hideText(textLabel: TextLabel, stroke: UIStroke, duration: number)
		UIUtil.Tween(textLabel, duration, { TextTransparency = 1 }, Enum.EasingStyle.Sine)
		UIUtil.Tween(stroke, duration, { Transparency = 1 }, Enum.EasingStyle.Sine)
	end

	------------------------------------------------------------------
	-- Révélation : rayons, halo, pastille, multiplicateur, sous-titre
	------------------------------------------------------------------
	local reveal = frame({
		Name = "Reveal",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, TEXT_Y),
		Size = UDim2.fromOffset(10, 10),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 24,
		Parent = scene,
	})
	local rays = frame({
		Name = "Rays",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(640, 640),
		BackgroundTransparency = 1,
		ZIndex = 24,
		Parent = reveal,
	})
	local rayBars = {}
	for index = 1, 10 do
		local bar = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(0, index % 2 == 0 and 30 or 18, 1, 0),
			Rotation = (index - 1) * 18,
			BackgroundColor3 = Color3.fromRGB(255, 226, 140),
			BackgroundTransparency = 0.5,
			ZIndex = 24,
			Parent = rays,
		})
		Create("UIGradient", {
			Color = ColorSequence.new(WHITE),
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.5, 0.2),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = bar,
		})
		table.insert(rayBars, bar)
	end
	local raysScale = Create("UIScale", { Scale = 0.2, Parent = rays })
	local glow = frame({
		Name = "Glow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(300, 300),
		BackgroundColor3 = Color3.fromRGB(255, 240, 200),
		BackgroundTransparency = 0.72,
		ZIndex = 25,
		Parent = reveal,
	})
	round(glow)
	local glowScale = Create("UIScale", { Scale = 0.3, Parent = glow })

	local badge = frame({
		Name = "Badge",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, -92),
		Size = UDim2.fromOffset(250, 40),
		BackgroundColor3 = WHITE,
		ZIndex = 27,
		Parent = reveal,
	})
	round(badge)
	UIUtil.Gradient(badge, ColorSequence.new(Color3.fromRGB(255, 236, 150), Color3.fromRGB(255, 176, 60)), 90)
	UIUtil.Stroke(badge, WHITE, 2.5, 0)
	local badgeScale = Create("UIScale", { Scale = 0.2, Parent = badge })
	UIUtil.Label({
		Name = "BadgeText",
		Text = Locale.T("REBIRTH #%s", tostring(math.max(1, math.floor(rebirths + 0.5)))),
		Font = Theme.Fonts.Title,
		TextColor3 = Color3.fromRGB(80, 40, 20),
		Position = UDim2.fromOffset(12, 4),
		Size = UDim2.new(1, -24, 1, -8),
		MaxTextSize = 26,
		ZIndex = 28,
		Parent = badge,
	})

	local multText, multStroke = label({
		Name = "Multiplier",
		Text = ctx.Format.Multiplier(previous),
		Font = Enum.Font.LuckiestGuy,
		TextColor3 = WHITE,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 8),
		Size = UDim2.fromOffset(520, 120),
		MaxTextSize = 108,
		ZIndex = 27,
		StrokeThickness = 5,
		Parent = reveal,
	})
	multText.TextTransparency = 0
	multStroke.Transparency = 0.05
	UIUtil.Gradient(multText, ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 252, 220)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 216, 90)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 150, 40)),
	}), 90)
	local multScale = Create("UIScale", { Scale = 0.3, Parent = multText })

	local subText, subStroke = label({
		Name = "SubText",
		Text = Locale.T("Your gains are multiplied forever 🌊"),
		Font = Theme.Fonts.Title,
		TextColor3 = WHITE,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 92),
		Size = UDim2.fromOffset(640, 36),
		MaxTextSize = 30,
		TextTransparency = 1,
		ZIndex = 27,
		Parent = reveal,
	})

	-- Étincelles (gerbe à la révélation, puis braises qui montent ; réserve)
	local SPARKS = 18
	local sparks = {}
	for index = 1, SPARKS do
		local spark = UIUtil.Label({
			Name = "Spark",
			Text = index % 3 == 0 and "✨" or "✦",
			TextColor3 = index % 2 == 0 and Color3.fromRGB(255, 226, 120) or WHITE,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(26, 26),
			MaxTextSize = 26,
			TextTransparency = 1,
			Visible = false,
			ZIndex = 29,
			Parent = scene,
		})
		sparks[index] = { Label = spark, Age = 1, Life = 1, X = 0, Y = 0, VX = 0, VY = 0, Spin = 0 }
	end
	local nextSpark = 1

	local function emitSpark(x: number, y: number, vx: number, vy: number, life: number)
		local spark = sparks[nextSpark]
		nextSpark = nextSpark % SPARKS + 1
		spark.Age = 0
		spark.Life = life
		spark.X, spark.Y, spark.VX, spark.VY = x, y, vx, vy
		spark.Spin = random:NextNumber(-200, 200)
		spark.Label.Visible = true
	end

	-- Flash blanc de la révélation
	local flash = frame({
		Name = "Flash",
		Position = UDim2.fromOffset(-EXTEND, -EXTEND),
		Size = UDim2.new(1, EXTEND * 2, 1, EXTEND * 2),
		BackgroundColor3 = Color3.fromRGB(255, 248, 230),
		BackgroundTransparency = 1,
		ZIndex = 30,
		Parent = scene,
	})

	------------------------------------------------------------------
	-- Écume laissée sur l'interface quand la marée repart (éclate)
	------------------------------------------------------------------
	local FOAM_COUNT = 26
	local foams = {}
	for _ = 1, FOAM_COUNT do
		local size = random:NextInteger(9, 26)
		local foam = frame({
			Name = "Foam",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(random:NextNumber(0.03, 0.97), random:NextNumber(0.04, 0.96)),
			Size = UDim2.fromOffset(size, size),
			BackgroundColor3 = Color3.fromRGB(214, 244, 255),
			BackgroundTransparency = 0.45,
			Visible = false,
			ZIndex = 2,
			Parent = container,
		})
		round(foam)
		local stroke = UIUtil.Stroke(foam, Color3.fromRGB(96, 186, 232), 1.5, 0.2)
		local foamShine = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.34, 0.32),
			Size = UDim2.fromScale(0.34, 0.24),
			Rotation = -35,
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.1,
			ZIndex = 2,
			Parent = foam,
		})
		round(foamShine)
		table.insert(foams, {
			Frame = foam,
			Stroke = stroke,
			Scale = Create("UIScale", { Parent = foam }),
			Y = foam.Position.Y.Scale,
			State = "Hidden", -- Hidden -> Shown -> Popping -> Done
			PopAt = 0,
			Age = 0,
		})
	end

	-- Reflet "tout propre" qui balaie l'écran à la fin
	local shine = frame({
		Name = "CleanShine",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(-0.2, 0.5),
		Size = UDim2.new(0, 90, 1.6, 0),
		Rotation = 18,
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.55,
		Visible = false,
		ZIndex = 2,
		Parent = container,
	})
	Create("UIGradient", {
		Color = ColorSequence.new(WHITE),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = shine,
	})

	------------------------------------------------------------------
	-- La marée (vague plein écran, crête d'écume en haut)
	------------------------------------------------------------------
	local tide = frame({
		Name = "Tide",
		Position = UDim2.new(0, -EXTEND, 1, EXTEND + CREST),
		Size = UDim2.new(1, EXTEND * 2, 1, EXTEND * 2 + CREST * 2),
		BackgroundColor3 = WHITE,
		ZIndex = 3,
		Parent = container,
	})
	vertical(tide, {
		ColorSequenceKeypoint.new(0, Color3.fromRGB(120, 226, 236)),
		ColorSequenceKeypoint.new(0.08, Color3.fromRGB(40, 176, 210)),
		ColorSequenceKeypoint.new(0.45, Color3.fromRGB(20, 110, 180)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(12, 56, 130)),
	})
	-- Reflets obliques dans l'eau
	for index = 1, 5 do
		local streak = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(index / 6, 0.3 + (index % 3) * 0.15),
			Size = UDim2.fromOffset(random:NextInteger(120, 260), 5),
			Rotation = -8,
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.8,
			ZIndex = 3,
			Parent = tide,
		})
		round(streak)
	end
	-- Crête : bande d'écume, bosses arrondies, embruns
	local crestBand = frame({
		Name = "Crest",
		Size = UDim2.new(1, 0, 0, 16),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.05,
		ZIndex = 4,
		Parent = tide,
	})
	crestBand.Position = UDim2.fromOffset(0, 0)
	-- Deux rangées de bouillons d'écume (grands et clairs derrière, petits devant)
	for rowIndex, rowDef in ipairs({ { Count = 18, Min = 60, Max = 96, Y = -6, T = 0.3 }, { Count = 30, Min = 26, Max = 54, Y = 6, T = 0.02 } }) do
		for index = 1, rowDef.Count do
			local size = random:NextInteger(rowDef.Min, rowDef.Max)
			local bump = frame({
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new((index - 0.5) / rowDef.Count, random:NextNumber(-10, 10), 0, rowDef.Y + random:NextNumber(-5, 5)),
				Size = UDim2.fromOffset(size, size * random:NextNumber(0.55, 0.75)),
				BackgroundColor3 = rowIndex == 1 and Color3.fromRGB(226, 248, 252) or WHITE,
				BackgroundTransparency = rowDef.T,
				ZIndex = 4,
				Parent = tide,
			})
			round(bump)
		end
	end
	for _ = 1, 30 do
		local size = random:NextInteger(5, 14)
		local spray = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(random:NextNumber(0, 1), 0, 0, -random:NextNumber(18, CREST + 10)),
			Size = UDim2.fromOffset(size, size),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = random:NextNumber(0.1, 0.5),
			ZIndex = 4,
			Parent = tide,
		})
		round(spray)
	end

	local tidePhase = "Idle" -- Idle | Rise | Drain
	local tideT = 0
	local tideTop = 1.2 -- position du haut de la vague (0 = haut de l'écran, 1 = bas)
	local finalDrain = false

	local function setTide(top: number)
		tideTop = top
		-- top : 0 -> haut du débord, 1 -> bas du débord (en proportion + débords)
		tide.Position = UDim2.new(0, -EXTEND, top, (top * 2 - 1) * (EXTEND + CREST))
	end
	setTide(1)

	------------------------------------------------------------------
	-- Animation continue (une seule boucle)
	------------------------------------------------------------------
	local time = 0
	local sunProgress = 0 -- 0..1 : coucher du soleil
	local starLevel = 0 -- 0..1 : étoiles visibles
	local breath = 0 -- -1..1 : nappe de la plage (respiration)
	local breathTarget = 0
	local revealAge = -1
	local counting = -1
	local sparkClock = 0
	local shineAge = -1

	ctx.OnRender(function(dt: number)
		time += dt

		-- Marée
		if tidePhase == "Rise" then
			tideT = math.min(1, tideT + dt / TIDE_RISE)
			setTide(1 - easeOutCubic(tideT))
		elseif tidePhase == "Drain" then
			tideT = math.min(1, tideT + dt / TIDE_DRAIN)
			setTide(easeInOutSine(tideT) * 1.02)
			if tideT >= 1 then
				tidePhase = "Idle"
				tide.Visible = false
			end
		end

		-- Écume laissée derrière (fin) : apparaît quand l'eau la découvre, puis éclate
		if finalDrain then
			local height = container.AbsoluteSize.Y / math.max(0.01, ctx.Interface.Scale or 1)
			local edge = tideTop * height + (tideTop * 2 - 1) * (EXTEND + CREST) - CREST
			for _, foam in ipairs(foams) do
				if foam.State == "Hidden" then
					if edge > foam.Y * height + 10 then
						foam.State = "Shown"
						foam.Frame.Visible = true
						foam.PopAt = time + random:NextNumber(0.1, 0.5)
					end
				elseif foam.State == "Shown" then
					if time >= foam.PopAt then
						foam.State = "Popping"
						foam.Age = 0
					end
				elseif foam.State == "Popping" then
					foam.Age = math.min(1, foam.Age + dt / 0.2)
					foam.Scale.Scale = 1 + 0.7 * foam.Age
					foam.Frame.BackgroundTransparency = 0.45 + 0.55 * foam.Age
					foam.Stroke.Transparency = 0.2 + 0.8 * foam.Age
					if foam.Age >= 1 then
						foam.State = "Done"
						foam.Frame.Visible = false
					end
				end
			end
		end
		if shineAge >= 0 then
			shineAge += dt
			local p = math.min(1, shineAge / 0.65)
			shine.Visible = p < 1
			shine.Position = UDim2.fromScale(-0.15 + 1.3 * easeInOutSine(p), 0.5)
		end

		if not scene.Visible then
			return
		end

		-- Vagues (va-et-vient)
		for _, layer in ipairs(layers) do
			local def = layer.Def
			local x = 0.5 + math.sin(time * def.Speed + layer.Phase) * def.Amp
			local y = def.Top + math.sin(time * def.Speed * 1.4 + layer.Phase) * 0.005
			layer.Frame.Position = UDim2.fromScale(x, y)
		end
		-- Reflets dorés
		for _, glint in ipairs(glints) do
			glint.Frame.BackgroundTransparency = 0.2 + (math.sin(time * glint.Speed + glint.Phase) + 1) * 0.36
		end
		-- Nuages, soleil, étoiles
		for _, cloud in ipairs(clouds) do
			cloud.X += cloud.Speed * dt
			cloud.Frame.Position = UDim2.fromScale(cloud.X, cloud.Y)
		end
		sunProgress = math.min(1, sunProgress + dt / 8.5)
		sunHolder.Position = UDim2.fromScale(0.5, sunStart + (sunEnd - sunStart) * easeInOutSine(sunProgress))
		for index, halo in ipairs(halos) do
			halo.Frame.BackgroundTransparency = halo.Base + 0.03 * math.sin(time * 1.2 + index)
		end
		starLevel = math.min(1, starLevel + dt / 6)
		for _, star in ipairs(stars) do
			local level = math.clamp(starLevel * 1.6 - star.Delay * 0.6, 0, 1)
			star.Frame.BackgroundTransparency = 1 - level * (0.55 + 0.45 * (0.5 + 0.5 * math.sin(time * star.Speed + star.Phase)))
		end
		-- Mouettes
		for _, gull in ipairs(gulls) do
			gull.X += gull.Speed * dt
			local bob = math.sin(time * 1.3 + gull.Phase) * 0.01
			gull.Frame.Position = UDim2.fromScale(gull.X, gull.Y + bob)
			local flap = 16 + math.sin(time * 6 + gull.Phase) * 16
			for _, wing in ipairs(gull.Wings) do
				wing.Frame.Rotation = -wing.Side * flap
			end
		end
		-- Voilier qui dérive et tangue
		boat.Position = UDim2.new(0.74 - time * 0.004, 0, HORIZON, 3 + math.sin(time * 1.6) * 1.2)
		boat.Rotation = math.sin(time * 1.3) * 3
		-- Nappe d'eau sur le sable (suit la respiration)
		breath += (breathTarget - breath) * math.min(1, dt * 1.8)
		local height = 26 + breath * 22 + math.sin(time * 1.1) * 3
		if math.abs(height - swashHeight) > 0.2 then
			swashHeight = height
			swash.Size = UDim2.new(1, EXTEND * 2, 0, swashHeight)
		end

		-- Révélation : rayons qui tournent, halo qui pulse, compteur, étincelles
		if revealAge >= 0 then
			revealAge += dt
			rays.Rotation = time * 14
			glowScale.Scale = (0.3 + 0.7 * easeOutBack(math.min(1, revealAge / 0.5))) * (1 + 0.06 * math.sin(time * 3))
			if counting >= 0 then
				counting = math.min(1, counting + dt / 0.9)
				local value = previous + (multiplier - previous) * easeOutCubic(counting)
				multText.Text = ctx.Format.Multiplier(counting >= 1 and multiplier or value)
				if counting >= 1 then
					counting = -1
					multScale.Scale = 1.28
					UIUtil.Tween(multScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
					for _ = 1, 8 do
						local angle = random:NextNumber(0, math.pi * 2)
						local speed = random:NextNumber(260, 420)
						emitSpark(0.5, TEXT_Y, math.cos(angle) * speed, math.sin(angle) * speed - 60, random:NextNumber(0.7, 1))
					end
				end
			end
			-- Braises qui montent
			sparkClock += dt
			if sparkClock >= 0.14 then
				sparkClock = 0
				emitSpark(random:NextNumber(0.2, 0.8), TEXT_Y + random:NextNumber(0.12, 0.3), random:NextNumber(-20, 20), -random:NextNumber(60, 130), random:NextNumber(1.2, 1.8))
			end
		end
		-- Étincelles (position en échelle + vitesse en pixels)
		for _, spark in ipairs(sparks) do
			if spark.Age < 1 then
				spark.Age = math.min(1, spark.Age + dt / spark.Life)
				local t = spark.Age * spark.Life
				local drag = 1 - spark.Age * 0.5
				spark.Label.Position = UDim2.new(spark.X, spark.VX * t * drag, spark.Y, spark.VY * t * drag + 120 * t * t)
				spark.Label.Rotation = spark.Spin * t
				spark.Label.TextTransparency = spark.Age ^ 1.6
				if spark.Age >= 1 then
					spark.Label.Visible = false
				end
			end
		end
	end)

	------------------------------------------------------------------
	-- Déroulé (~8,8 s)
	------------------------------------------------------------------
	-- 1. La marée monte et recouvre l'interface
	ctx.Sound.Play("Detox", 1)
	tidePhase, tideT = "Rise", 0
	if not waitAlive(TIDE_RISE + 0.06) then
		return
	end
	-- 2. Derrière la vague : la plage au coucher du soleil ; la vague redescend
	scene.Visible = true
	tidePhase, tideT = "Drain", 0
	if not waitAlive(0.3) then
		return
	end

	-- 3. Respiration
	UIUtil.Tween(ringStroke, 0.5, { Transparency = 0.25 })
	UIUtil.Tween(ring, 0.5, { BackgroundTransparency = 0.9 })
	UIUtil.Tween(ringInner, 0.5, { BackgroundTransparency = 0.93 })
	showText(mainText, mainStroke, Locale.T("Breathe in..."), 0.5)
	breathTarget = 1
	UIUtil.Tween(ringScale, 1.6, { Scale = 1.22 }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	if not waitAlive(1.6) then
		return
	end
	mainText.Text = Locale.T("Breathe out...")
	breathTarget = -0.6
	UIUtil.Tween(ringScale, 1.4, { Scale = 0.7 }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	if not waitAlive(1.4) then
		return
	end

	-- "Tout est calme."
	UIUtil.Tween(ringStroke, 0.4, { Transparency = 1 })
	UIUtil.Tween(ring, 0.4, { BackgroundTransparency = 1 })
	UIUtil.Tween(ringInner, 0.4, { BackgroundTransparency = 1 })
	breathTarget = 0
	hideText(mainText, mainStroke, 0.25)
	if not waitAlive(0.25) then
		return
	end
	showText(mainText, mainStroke, Locale.T("All is calm."), 0.4)
	if not waitAlive(0.8) then
		return
	end
	hideText(mainText, mainStroke, 0.25)
	if not waitAlive(0.25) then
		return
	end

	-- 4. Révélation du nouveau multiplicateur
	flash.BackgroundTransparency = 0.25
	UIUtil.Tween(flash, 0.7, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
	reveal.Visible = true
	revealAge = 0
	UIUtil.Tween(raysScale, 0.6, { Scale = 1 }, Enum.EasingStyle.Back)
	UIUtil.Tween(badgeScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	multScale.Scale = 0.3
	UIUtil.Tween(multScale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
	for _ = 1, 10 do
		local angle = random:NextNumber(0, math.pi * 2)
		local speed = random:NextNumber(180, 380)
		emitSpark(0.5, TEXT_Y, math.cos(angle) * speed, math.sin(angle) * speed - 40, random:NextNumber(0.8, 1.2))
	end
	ctx.Sound.Play("Bonus", 0.8)
	if not waitAlive(0.35) then
		return
	end
	counting = 0
	UIUtil.Tween(subText, 0.5, { TextTransparency = 0 }, Enum.EasingStyle.Sine)
	UIUtil.Tween(subStroke, 0.5, { Transparency = 0.3 }, Enum.EasingStyle.Sine)
	if not waitAlive(1.5) then
		return
	end

	-- 5. La marée revient, puis se retire en découvrant l'interface toute neuve
	tide.Visible = true
	tidePhase, tideT = "Rise", 0
	if not waitAlive(TIDE_RISE + 0.06) then
		return
	end
	scene.Visible = false
	finalDrain = true
	tidePhase, tideT = "Drain", 0
	if not waitAlive(TIDE_DRAIN) then
		return
	end
	shineAge = 0
	waitAlive(0.75)
end

return Ocean
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="145">
          <Properties>
            <string name="Name">PhoneNotifs</string>
            <string name="Source"><![CDATA[--[[
	PhoneNotifs (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > PhoneNotifs

	Notifications de téléphone (décidées par le SERVEUR via l'événement
	Spawn "Notif") : une bannière arrondie façon smartphone glisse depuis
	la gauche (icône d'appli, nom, "maintenant", message drôle choisi par
	info.Variant), vibre un peu, et s'empile en haut à gauche (3 au max).
	Un clic = ClaimSpawn (le serveur valide) ; la bannière s'en va toute
	seule à la fin de sa durée de vie (petite barre de temps en bas).
	Le bonus confirmé (OnBonus "Notif") s'affiche en "+X" sur la bannière.
]]

local Debris = game:GetService("Debris")

local Locale = require(game:GetService("ReplicatedStorage").Shared.Locale)

local PhoneNotifs = {}
PhoneNotifs.Slot = "Overlay"

local CARD_W = 288
local CARD_H = 68
local GAP = 8
local LEFT = 16
local TOP = 44
local MAX_VISIBLE = 3

-- Icône, nom de l'appli, couleur de l'icône, message (une liste par langue, même ordre)
local NOTIFS = {
	en = {
		{ Icon = "💬", App = "Messages", Color = Color3.fromRGB(52, 199, 89), Text = "Mom: did you eat?" },
		{ Icon = "📦", App = "Parcel Express", Color = Color3.fromRGB(255, 149, 0), Text = "Your package is on its way! (It got lost, but enthusiastically)" },
		{ Icon = "❤️", App = "Photos", Color = Color3.fromRGB(255, 62, 138), Text = "+3 likes on your photo of toast" },
		{ Icon = "💧", App = "Health", Color = Color3.fromRGB(0, 194, 224), Text = "Reminder: drink some water 💧" },
		{ Icon = "⛈️", App = "Weather", Color = Color3.fromRGB(30, 136, 229), Text = "Lightning likely. Remember to catch it ⚡" },
		{ Icon = "🔋", App = "Battery", Color = Color3.fromRGB(227, 38, 43), Text = "Battery at 3%. Same, honestly." },
		{ Icon = "⏰", App = "Alarm", Color = Color3.fromRGB(255, 138, 26), Text = "You snoozed your alarm 14 times. Impressive." },
		{ Icon = "👟", App = "Step Counter", Color = Color3.fromRGB(61, 200, 61), Text = "12 steps today. Personal best?" },
		{ Icon = "🌱", App = "Smart Plant", Color = Color3.fromRGB(40, 170, 80), Text = "I'm thirsty. Love you. — Your plant" },
		{ Icon = "🍕", App = "Pizza Minute", Color = Color3.fromRGB(255, 120, 40), Text = "Your pizza arrives in 5 minutes (it has for 40 minutes)" },
		{ Icon = "📅", App = "Calendar", Color = Color3.fromRGB(227, 38, 43), Text = "Reminder: do nothing from 2 to 6 p.m." },
		{ Icon = "👵", App = "Grandma", Color = Color3.fromRGB(139, 50, 224), Text = "Grandma sent 27 photos of her cat" },
		{ Icon = "🔒", App = "Security", Color = Color3.fromRGB(60, 60, 70), Text = "New sign-in from your toaster. Was this you?" },
		{ Icon = "⬇️", App = "Software Update", Color = Color3.fromRGB(30, 136, 229), Text = "Update available: 0.2 MB of amazing new features" },
		{ Icon = "🧊", App = "Smart Fridge", Color = Color3.fromRGB(0, 194, 224), Text = "There's one yogurt left. It's staring at you." },
		{ Icon = "🐱", App = "Living Room Cam", Color = Color3.fromRGB(255, 170, 40), Text = "Motion detected: it's the cat. Again." },
		{ Icon = "🎮", App = "Games", Color = Color3.fromRGB(139, 50, 224), Text = "Your friend invited you to play... 3 years ago" },
		{ Icon = "🏦", App = "Bank", Color = Color3.fromRGB(42, 42, 42), Text = "Your Dopamine balance is excellent. Everything else, less so." },
		{ Icon = "✨", App = "Horoscope", Color = Color3.fromRGB(255, 62, 138), Text = "Aries: today, click. A lot." },
		{ Icon = "📸", App = "Memories", Color = Color3.fromRGB(255, 194, 26), Text = "5 years ago today: you were already clicking." },
		{ Icon = "🎵", App = "Music", Color = Color3.fromRGB(255, 45, 85), Text = "Your song of the summer, played 842 times. You OK?" },
		{ Icon = "🦷", App = "Dentist", Color = Color3.fromRGB(90, 160, 255), Text = "Don't forget your appointment. Yes, that one." },
		{ Icon = "👍", App = "Social Network", Color = Color3.fromRGB(30, 110, 230), Text = "Someone liked your comment from 2019" },
		{ Icon = "🌙", App = "Sleep", Color = Color3.fromRGB(88, 86, 214), Text = "It's late. Put the phone down. (No? Okay.)" },
		{ Icon = "🧦", App = "Socks & Co", Color = Color3.fromRGB(227, 38, 43), Text = "Your left sock is on sale!" },
		{ Icon = "🍪", App = "Cookies", Color = Color3.fromRGB(190, 120, 60), Text = "This site uses cookies. Real ones. Chocolate chip." },
		{ Icon = "🤖", App = "Assistant", Color = Color3.fromRGB(0, 170, 200), Text = "Sorry, I didn't understand “5 more minutes”." },
		{ Icon = "🦆", App = "Rubber Duck", Color = Color3.fromRGB(255, 200, 0), Text = "Quack. (You have 1 new quack.)" },
	},
	fr = {
		{ Icon = "💬", App = "Messages", Color = Color3.fromRGB(52, 199, 89), Text = "Maman : t'as mangé ?" },
		{ Icon = "📦", App = "Colis Express", Color = Color3.fromRGB(255, 149, 0), Text = "Ton colis est en route ! (il s'est perdu, mais avec enthousiasme)" },
		{ Icon = "❤️", App = "Photos", Color = Color3.fromRGB(255, 62, 138), Text = "+3 likes sur ta photo de tartine" },
		{ Icon = "💧", App = "Santé", Color = Color3.fromRGB(0, 194, 224), Text = "Rappel : boire de l'eau 💧" },
		{ Icon = "⛈️", App = "Météo", Color = Color3.fromRGB(30, 136, 229), Text = "Risque d'éclairs. Pense à les attraper ⚡" },
		{ Icon = "🔋", App = "Batterie", Color = Color3.fromRGB(227, 38, 43), Text = "Batterie à 3 %. Moi aussi, je suis fatigué." },
		{ Icon = "⏰", App = "Réveil", Color = Color3.fromRGB(255, 138, 26), Text = "Tu as repoussé ton réveil 14 fois. Bravo." },
		{ Icon = "👟", App = "Podomètre", Color = Color3.fromRGB(61, 200, 61), Text = "12 pas aujourd'hui. Record personnel ?" },
		{ Icon = "🌱", App = "Plante connectée", Color = Color3.fromRGB(40, 170, 80), Text = "J'ai soif. Bisous. — Ta plante" },
		{ Icon = "🍕", App = "Pizza Minute", Color = Color3.fromRGB(255, 120, 40), Text = "Ta pizza arrive dans 5 minutes (depuis 40 minutes)" },
		{ Icon = "📅", App = "Calendrier", Color = Color3.fromRGB(227, 38, 43), Text = "Rappel : ne rien faire de 14 h à 18 h" },
		{ Icon = "👵", App = "Mamie", Color = Color3.fromRGB(139, 50, 224), Text = "Mamie a envoyé 27 photos de son chat" },
		{ Icon = "🔒", App = "Sécurité", Color = Color3.fromRGB(60, 60, 70), Text = "Nouvelle connexion depuis ton grille-pain. C'était toi ?" },
		{ Icon = "⬇️", App = "Mise à jour", Color = Color3.fromRGB(30, 136, 229), Text = "Mise à jour dispo : 0,2 Mo de nouveautés incroyables" },
		{ Icon = "🧊", App = "Frigo connecté", Color = Color3.fromRGB(0, 194, 224), Text = "Il reste un yaourt. Il te regarde." },
		{ Icon = "🐱", App = "Caméra du salon", Color = Color3.fromRGB(255, 170, 40), Text = "Mouvement détecté : c'est le chat. Encore." },
		{ Icon = "🎮", App = "Jeux", Color = Color3.fromRGB(139, 50, 224), Text = "Ton ami t'a invité à jouer... il y a 3 ans" },
		{ Icon = "🏦", App = "Banque", Color = Color3.fromRGB(42, 42, 42), Text = "Ton solde de Dopamine est excellent. Le reste, moins." },
		{ Icon = "✨", App = "Horoscope", Color = Color3.fromRGB(255, 62, 138), Text = "Bélier : aujourd'hui, clique. Beaucoup." },
		{ Icon = "📸", App = "Souvenirs", Color = Color3.fromRGB(255, 194, 26), Text = "Il y a 5 ans aujourd'hui : tu cliquais déjà." },
		{ Icon = "🎵", App = "Musique", Color = Color3.fromRGB(255, 45, 85), Text = "Ta chanson de l'été écoutée 842 fois. Ça va ?" },
		{ Icon = "🦷", App = "Dentiste", Color = Color3.fromRGB(90, 160, 255), Text = "N'oublie pas ton rendez-vous. Oui, celui-là." },
		{ Icon = "👍", App = "Réseau social", Color = Color3.fromRGB(30, 110, 230), Text = "Quelqu'un a aimé ton commentaire de 2019" },
		{ Icon = "🌙", App = "Sommeil", Color = Color3.fromRGB(88, 86, 214), Text = "Il est tard. Pose le téléphone. (Non ? D'accord.)" },
		{ Icon = "🧦", App = "Chaussettes & Co", Color = Color3.fromRGB(227, 38, 43), Text = "Ta chaussette gauche est en promo !" },
		{ Icon = "🍪", App = "Cookies", Color = Color3.fromRGB(190, 120, 60), Text = "Ce site utilise des cookies. Des vrais. Au chocolat." },
		{ Icon = "🤖", App = "Assistant", Color = Color3.fromRGB(0, 170, 200), Text = "Désolé, je n'ai pas compris « encore 5 minutes »." },
		{ Icon = "🦆", App = "Canard de bain", Color = Color3.fromRGB(255, 200, 0), Text = "Coin. (Tu as 1 nouveau coin.)" },
	},
}

-- Choix déterministe selon la variante envoyée par le serveur
local function pick(list: { any }, variant: any): any
	local v = math.floor(tonumber(variant) or 1)
	return list[(v - 1) % #list + 1]
end

-- Majuscules qui gardent les accents ("Podomètre" -> "PODOMÈTRE")
local ACCENTS = { ["é"] = "É", ["è"] = "È", ["ê"] = "Ê", ["ë"] = "Ë", ["à"] = "À", ["â"] = "Â", ["ç"] = "Ç",
	["î"] = "Î", ["ï"] = "Ï", ["ô"] = "Ô", ["ù"] = "Ù", ["û"] = "Û" }
local function upper(text: string): string
	local result = string.upper(text)
	for small, big in pairs(ACCENTS) do
		result = string.gsub(result, small, big)
	end
	return result
end

function PhoneNotifs.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local container: Frame = ctx.Container
	local random = Random.new()

	local cards: { any } = {} -- du plus récent (en haut) au plus ancien
	local byId: { [string]: any } = {}
	local positions: { [string]: UDim2 } = {} -- pour placer le "+X" du bonus
	local lastPosition = UDim2.fromOffset(LEFT + CARD_W / 2, TOP + CARD_H / 2)

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	local function slotY(index: number): number
		return TOP + (index - 1) * (CARD_H + GAP)
	end

	-- Replace les bannières dans la pile
	local function layout()
		for index, card in ipairs(cards) do
			local target = UDim2.fromOffset(LEFT, slotY(index))
			if card.Entered then
				UIUtil.Tween(card.Root, 0.3, { Position = target }, Enum.EasingStyle.Quad)
			else
				card.Entered = true
				card.Root.Position = UDim2.fromOffset(-CARD_W - 30, slotY(index))
				UIUtil.Tween(card.Root, 0.45, { Position = target }, Enum.EasingStyle.Back)
			end
		end
	end

	local function dismiss(card, claimed: boolean)
		if card.Done then
			return
		end
		card.Done = true
		local index = table.find(cards, card)
		if index then
			table.remove(cards, index)
		end
		byId[card.Id] = nil
		layout()

		local root = card.Root
		root.Active = false
		if claimed then
			-- "Ouverture" : petit gonflement puis disparition
			UIUtil.Tween(card.Scale, 0.12, { Scale = 1.06 }, Enum.EasingStyle.Quad)
			task.delay(0.12, function()
				if root.Parent then
					UIUtil.Tween(card.Scale, 0.25, { Scale = 0.6 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
					UIUtil.Tween(card.Group, 0.25, { GroupTransparency = 1 })
					UIUtil.Tween(card.Shadow, 0.25, { BackgroundTransparency = 1 })
					UIUtil.Tween(card.Outline, 0.25, { Transparency = 1 })
				end
			end)
		else
			-- Ignorée : repart vers la gauche
			UIUtil.Tween(root, 0.35, { Position = root.Position - UDim2.fromOffset(CARD_W + 40, 0) }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			UIUtil.Tween(card.Group, 0.35, { GroupTransparency = 0.6 })
		end
		Debris:AddItem(root, 0.5)
	end

	local function spawnNotif(info)
		if not ctx.IsAlive() or type(info) ~= "table" or type(info.Id) ~= "string" or byId[info.Id] then
			return
		end
		-- Trop de bannières : la plus ancienne laisse sa place
		while #cards >= MAX_VISIBLE do
			dismiss(cards[#cards], false)
		end

		local data = pick(Locale.Pick(NOTIFS), info.Variant)
		local lifetime = math.max(1.5, tonumber(info.Lifetime) or 6)
		local variant = math.floor(tonumber(info.Variant) or 1)

		local root = UIUtil.Create("TextButton", {
			Name = "Notif",
			Size = UDim2.fromOffset(CARD_W, CARD_H),
			Position = UDim2.fromOffset(-CARD_W - 30, TOP),
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Text = "",
			ZIndex = 30,
			Parent = container,
		})
		local scale = UIUtil.Create("UIScale", { Parent = root })

		-- Ombre douce
		local shadow = UIUtil.Create("Frame", {
			Name = "Shadow",
			Size = UDim2.fromScale(1, 1),
			Position = UDim2.fromOffset(0, 4),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.82,
			BorderSizePixel = 0,
			ZIndex = 30,
			Parent = root,
		})
		UIUtil.Corner(shadow, 18)

		-- Carte (CanvasGroup : permet de tout faire disparaître d'un coup)
		local group = UIUtil.Create("CanvasGroup", {
			Name = "Card",
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.fromRGB(250, 250, 252),
			BorderSizePixel = 0,
			ZIndex = 31,
			Parent = root,
		})
		UIUtil.Corner(group, 18)
		-- Contour fin (hors du CanvasGroup pour ne pas être rogné)
		local outline = UIUtil.Create("Frame", {
			Name = "Outline",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			ZIndex = 36,
			Parent = root,
		})
		UIUtil.Corner(outline, 18)
		local outlineStroke = UIUtil.Stroke(outline, Theme.Colors.Border, 1.5, 0.7)

		-- Icône de l'appli
		local icon = UIUtil.Create("Frame", {
			Name = "Icon",
			Size = UDim2.fromOffset(44, 44),
			Position = UDim2.fromOffset(11, (CARD_H - 44) / 2),
			BackgroundColor3 = data.Color,
			BorderSizePixel = 0,
			ZIndex = 32,
			Parent = group,
		})
		UIUtil.Corner(icon, 11)
		UIUtil.Gradient(icon, ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(205, 205, 205)), 90)
		UIUtil.Label({
			Text = data.Icon,
			Size = UDim2.fromScale(0.72, 0.72),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			MaxTextSize = 30,
			ZIndex = 33,
			Parent = icon,
		})

		-- Pastille rouge (nombre de notifs "non lues" de l'appli)
		local badge = UIUtil.Label({
			Text = tostring(variant % 9 + 1),
			Font = Theme.Fonts.Number,
			TextColor3 = Color3.new(1, 1, 1),
			BackgroundColor3 = Theme.Colors.Red,
			BackgroundTransparency = 0,
			Size = UDim2.fromOffset(18, 18),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0, 11 + 44 - 2, 0, (CARD_H - 44) / 2 + 3),
			MaxTextSize = 13,
			ZIndex = 34,
			Parent = group,
		})
		UIUtil.Corner(badge, UDim.new(1, 0))

		-- Nom de l'appli + "maintenant"
		UIUtil.Create("TextLabel", {
			Name = "App",
			Size = UDim2.fromOffset(CARD_W - 66 - 86, 18),
			Position = UDim2.fromOffset(66, 9),
			BackgroundTransparency = 1,
			Font = Theme.Fonts.Title,
			Text = upper(data.App),
			TextColor3 = Theme.Colors.TextDim,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 32,
			Parent = group,
		})
		UIUtil.Create("TextLabel", {
			Name = "Time",
			Size = UDim2.fromOffset(76, 18),
			Position = UDim2.fromOffset(CARD_W - 86, 9),
			BackgroundTransparency = 1,
			Font = Theme.Fonts.Body,
			Text = Locale.T("now"),
			TextColor3 = Theme.Colors.TextDim,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Right,
			ZIndex = 32,
			Parent = group,
		})

		-- Message
		UIUtil.Label({
			Name = "Message",
			Text = data.Text,
			Font = Theme.Fonts.Body,
			TextColor3 = Theme.Colors.TextDark,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Size = UDim2.fromOffset(CARD_W - 66 - 12, 34),
			Position = UDim2.fromOffset(66, 27),
			MaxTextSize = 16,
			ZIndex = 32,
			Parent = group,
		})

		-- Barre de temps restant
		local timeBar = UIUtil.Create("Frame", {
			Name = "TimeBar",
			Size = UDim2.fromOffset(CARD_W - 32, 3),
			Position = UDim2.fromOffset(16, CARD_H - 5),
			BackgroundColor3 = data.Color,
			BackgroundTransparency = 0.25,
			BorderSizePixel = 0,
			ZIndex = 33,
			Parent = group,
		})
		UIUtil.Corner(timeBar, UDim.new(1, 0))
		UIUtil.Tween(timeBar, lifetime, { Size = UDim2.fromOffset(0, 3) }, Enum.EasingStyle.Linear)

		local card = {
			Id = info.Id,
			Root = root,
			Scale = scale,
			Group = group,
			Shadow = shadow,
			Outline = outlineStroke,
			Color = data.Color,
			Expires = os.clock() + lifetime,
			Entered = false,
			Done = false,
		}
		byId[card.Id] = card
		table.insert(cards, 1, card)
		layout()

		ctx.Sound.Play("Notif", 0.95 + random:NextNumber() * 0.25)

		-- Vibration du téléphone (petite secousse en rotation)
		task.spawn(function()
			task.wait(0.35)
			for i = 1, 8 do
				if card.Done or not root.Parent or not ctx.IsAlive() then
					break
				end
				root.Rotation = (i % 2 == 0) and 1.6 or -1.6
				task.wait(0.035)
			end
			if root.Parent then
				root.Rotation = 0
			end
		end)

		-- Clic : on "ouvre" la notification
		ctx.Connect(root.Activated, function()
			if card.Done or not ctx.IsAlive() then
				return
			end
			local index = table.find(cards, card) or 1
			local position = UDim2.fromOffset(LEFT + CARD_W / 2, slotY(index) + CARD_H / 2)
			positions[card.Id] = position
			lastPosition = position
			ctx.ClaimSpawn(card.Id)
			ctx.Sound.Play("Click", 1.5)
			if effectsOn() then
				ctx.Effects.Burst(container, position, card.Color, 10)
			end
			dismiss(card, true)
			local id = card.Id
			task.delay(6, function()
				positions[id] = nil
			end)
		end)
	end

	-- Disparition automatique à la fin de la durée de vie
	ctx.OnRender(function()
		if #cards == 0 then
			return
		end
		local now = os.clock()
		for i = #cards, 1, -1 do
			local card = cards[i]
			if card and not card.Done and now >= card.Expires then
				dismiss(card, false)
			end
		end
	end)

	ctx.OnSpawn("Notif", spawnNotif)

	-- Bonus confirmé : "+X" sur la bannière
	ctx.OnBonus("Notif", function(payload)
		if not ctx.IsAlive() then
			return
		end
		local position = (payload.SpawnId and positions[payload.SpawnId]) or lastPosition
		ctx.FloatText(container, position, "+" .. ctx.Format.Format(tonumber(payload.Amount) or 0), Theme.Colors.Green, 34)
	end)
end

function PhoneNotifs.Stop(_ctx)
	-- Les bannières vivent dans ctx.Container (détruit par le StimulusManager)
end

return PhoneNotifs
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="146">
          <Properties>
            <string name="Name">Pinwheel</string>
            <string name="Source"><![CDATA[--[[
	Pinwheel (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > Pinwheel

	Un moulin à vent en papier illustré, planté dans un petit pot "kawaii"
	sur une colline, devant un ciel pastel (soleil, nuages qui passent).
	  - 4 pales vernies : grand triangle ombré (dégradé) + rabat plus clair
	    (le "pli" de la feuille), ligne de pliure brillante, petits pois ;
	    moyeu en perle avec reflet.
	  - Bâton en bois (dégradé + veines), pot en terre cuite avec un
	    visage, terre, deux feuilles et une petite fleur.
	  - Tourne en continu, avec des coups de vent de temps en temps. Plus
	    ça tourne vite, plus un disque "flou" coloré apparaît et des
	    lignes de vent traversent la carte (réserve recyclée, aucune
	    création d'instance par image).
	  - Clic / toucher = on souffle dessus : grosse accélération qui retombe
	    doucement, étincelles autour du moyeu... et à très haute vitesse, il
	    essaie de décoller. Chaque souffle envoie Interact("Spin") (limité
	    côté client à la recharge du serveur) ; le bonus arrive par
	    OnBonus("Spin").
	  - Pastille "compteur" en haut à gauche : petit cadran dont l'aiguille
	    et la couleur suivent la vitesse, et les tours / minute.
	v9 - "Énergie éolienne" (amélioration WindPower, 10 niveaux, lue avec
	ctx.GetLevel("WindPower"), mise à jour en direct) :
	  - une éolienne de plus sur les collines à chaque niveau (1 à 6 :
	    grandes devant, plus petites et voilées au loin), qui sort de terre
	    avec des étincelles et un coup de vent ; niveaux 7 à 10 : elles
	    grandissent et un feu rouge clignote en haut ; au niveau 10, de
	    petits éclairs d'énergie jaillissent des moyeux ;
	  - le moulin tourne plus vite au repos (+28 °/s par niveau), les coups
	    de vent sont plus fréquents, des lignes de vent traversent la carte
	    en continu (plus nombreuses à chaque niveau), les nuages filent.
	Performances : le décor (CanvasGroup redessiné à chaque changement :
	nuages, soleil, éoliennes) n'est mis à jour que 30 fois par seconde.
]]

local Locale = require(game:GetService("ReplicatedStorage").Shared.Locale)

local Pinwheel = {}
Pinwheel.Slot = "CL"

local BLADE = 42 -- côté du carré d'une pale (portée = BLADE * √2)
local BASE_SPEED = 70 -- degrés / seconde au repos
local BOOST = 540 -- ajout de vitesse par souffle
local MAX_SPEED = 2600
local DECAY = 0.9 -- vitesse de retour au calme
local WIND_POOL = 10 -- lignes de vent recyclées
local WIND_SPEED_PER_LEVEL = 28 -- vitesse de repos en plus par niveau de WindPower
local SPARKLE_POOL = 6 -- étincelles recyclées

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)

local BLADE_COLORS = {
	Color3.fromRGB(255, 84, 112), -- framboise
	Color3.fromRGB(255, 196, 46), -- miel
	Color3.fromRGB(64, 156, 255), -- ciel
	Color3.fromRGB(70, 206, 140), -- menthe
}

-- Éoliennes (une par niveau de WindPower, 1 à 6) : x, sol (y du haut de la
-- colline à cet endroit), hauteur du mât, colline ("Far" = gauche, "Near" = droite)
local TURBINES = {
	{ X = 22, Ground = 145, H = 46, Hill = "Far", Haze = 0 },
	{ X = 146, Ground = 150, H = 42, Hill = "Near", Haze = 0 },
	{ X = 46, Ground = 146, H = 31, Hill = "Far", Haze = 0.25 },
	{ X = 124, Ground = 148, H = 29, Hill = "Near", Haze = 0.25 },
	{ X = 9, Ground = 146, H = 25, Hill = "Far", Haze = 0.4 },
	{ X = 159, Ground = 152, H = 25, Hill = "Near", Haze = 0.4 },
}

local LIFT_TEXTS = {
	en = { "It's gonna take off! 🚁", "Hold on tight!", "Too much wind!!", "WHOOOOSH" },
	fr = { "Il va décoller ! 🚁", "Accroche-toi !", "Trop de vent !!", "WOUUUSH" },
}

-- Transparence "demi-carré" : une moitié opaque, l'autre invisible (bord net)
local function halfTransparency(opaqueFirst: boolean): NumberSequence
	local a, b = 0, 1
	if not opaqueFirst then
		a, b = 1, 0
	end
	return NumberSequence.new({
		NumberSequenceKeypoint.new(0, a),
		NumberSequenceKeypoint.new(0.495, a),
		NumberSequenceKeypoint.new(0.505, b),
		NumberSequenceKeypoint.new(1, b),
	})
end

-- Trait qui s'estompe aux deux bouts (lignes de vent, pliures)
local FADE_ENDS = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 1),
	NumberSequenceKeypoint.new(0.3, 0.1),
	NumberSequenceKeypoint.new(0.7, 0.1),
	NumberSequenceKeypoint.new(1, 1),
})

function Pinwheel.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local Create = UIUtil.Create
	local container: Frame = ctx.Container
	local random = Random.new()
	local spinConfig = ctx.Config.Interactions.Spin
	local cooldown = (spinConfig and spinConfig.Cooldown) or 2

	-- Taille de la carte = slot - 2 x 2 px (marge pour que son contour ne soit pas coupé)
	local slotSize = ctx.GetSlotSize and ctx.GetSlotSize() or Vector2.new(170, 170)
	local width = (slotSize.X > 0 and slotSize.X or 170) - 4
	local height = (slotSize.Y > 0 and slotSize.Y or 170) - 4
	local hubX, hubY = width / 2, math.floor(height * 0.41)
	local reach = math.ceil(BLADE * math.sqrt(2))

	-- Texte flottant dessiné dans le calque Overlay : il monte de 100 px et
	-- serait coupé par le slot (ClipsDescendants). `point` = position en
	-- pixels "design" dans `guiObject` (qui fait `designW` de large).
	local function floatOnOverlay(guiObject: GuiObject, designW: number, point: Vector2, text: string, color: Color3?, size: number?)
		local ratio = guiObject.AbsoluteSize.X / math.max(1, designW)
		local canvas = ctx.Interface.ScreenToCanvas(guiObject.AbsolutePosition + point * ratio)
		ctx.FloatText(ctx.Overlay, UDim2.fromOffset(canvas.X, canvas.Y), text, color, size)
	end

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	-- Petit cadre sans bordure
	local function frame(props: { [string]: any }): Frame
		props.BorderSizePixel = 0
		return Create("Frame", props)
	end

	-- Cadre centré sur (x, y)
	local function centered(props: { [string]: any }, x: number, y: number, w: number, h: number): Frame
		props.AnchorPoint = Vector2.new(0.5, 0.5)
		props.Position = UDim2.fromOffset(x, y)
		props.Size = UDim2.fromOffset(w, h)
		return frame(props)
	end

	local function round(guiObject: GuiObject)
		UIUtil.Corner(guiObject, UDim.new(1, 0))
	end

	------------------------------------------------------------------
	-- Carte : ciel pastel, soleil, nuages, collines
	------------------------------------------------------------------
	local card = frame({
		Name = "Card",
		-- 2 px de marge : le contour de la carte n'est pas coupé par le slot
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -4, 1, -4),
		BackgroundColor3 = WHITE,
		ClipsDescendants = true,
		Parent = container,
	})
	UIUtil.Corner(card, 18)
	UIUtil.Stroke(card, Theme.Colors.CardBorder, 2)
	UIUtil.Gradient(card, ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(148, 204, 255)),
		ColorSequenceKeypoint.new(0.6, Color3.fromRGB(214, 232, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 226, 234)),
	}), 90)
	local cardScale = Create("UIScale", { Parent = card })
	-- Décor (soleil, nuages, collines) dans un CanvasGroup arrondi : ClipsDescendants
	-- découpe en rectangle, les collines dépasseraient des coins arrondis de la carte
	local scenery = Create("CanvasGroup", {
		Name = "Scenery",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = card,
	})
	UIUtil.Corner(scenery, 18)

	-- Soleil (halo qui respire)
	local sunGlow = centered({ Name = "SunGlow", BackgroundColor3 = Color3.fromRGB(255, 240, 170), BackgroundTransparency = 0.6, ZIndex = 1, Parent = scenery }, width - 24, 24, 46, 46)
	round(sunGlow)
	local sun = centered({ Name = "Sun", BackgroundColor3 = Color3.fromRGB(255, 214, 90), ZIndex = 1, Parent = scenery }, width - 24, 24, 22, 22)
	round(sun)
	UIUtil.Gradient(sun, ColorSequence.new(Color3.fromRGB(255, 246, 190), Color3.fromRGB(255, 200, 80)), 45)

	-- Nuages (3 boules chacun) qui passent lentement
	local clouds = {}
	for i = 1, 2 do
		local cloud = centered({
			Name = "Cloud",
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.05,
			ZIndex = 1,
			Parent = scenery,
		}, 0, 0, i == 1 and 40 or 32, i == 1 and 13 or 11)
		round(cloud)
		for p = 1, 2 do
			local puff = frame({
				Name = "Puff",
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.fromScale(p == 1 and 0.36 or 0.64, 0.55),
				Size = UDim2.fromScale(p == 1 and 0.46 or 0.36, p == 1 and 1.35 or 1.05),
				BackgroundColor3 = WHITE,
				BackgroundTransparency = 0.05,
				ZIndex = 1,
				Parent = cloud,
			})
			round(puff)
		end
		table.insert(clouds, {
			Frame = cloud,
			X = width * (i == 1 and 0.22 or 0.7),
			Y = i == 1 and 22 or 50,
			Speed = random:NextNumber(3, 6),
		})
	end

	-- Collines (une claire au fond, une plus foncée devant)
	-- (ZIndex : éoliennes de gauche 2 < colline du fond 3 < éoliennes de droite 4 < colline de devant 5)
	local farHill = centered({ Name = "FarHill", BackgroundColor3 = Color3.fromRGB(150, 222, 150), ZIndex = 3, Parent = scenery }, width * 0.18, height + 14, 170, 70)
	round(farHill)
	local hill = centered({ Name = "Hill", BackgroundColor3 = WHITE, ZIndex = 5, Parent = scenery }, width * 0.62, height + 22, 240, 80)
	round(hill)
	UIUtil.Gradient(hill, ColorSequence.new(Color3.fromRGB(120, 214, 120), Color3.fromRGB(62, 160, 90)), 90)

	------------------------------------------------------------------
	-- v9 : éoliennes sur les collines (WindPower), cachées au départ
	------------------------------------------------------------------
	local HAZE = Color3.fromRGB(200, 224, 250) -- voile bleuté des éoliennes lointaines
	local turbines = {}
	for index, def in ipairs(TURBINES) do
		local blade = math.floor(def.H * 0.46 + 0.5)
		local hubSize = math.max(3, math.floor(def.H * 0.11))
		local tone = WHITE:Lerp(HAZE, def.Haze)
		local shade = Color3.fromRGB(164, 178, 204):Lerp(HAZE, def.Haze)
		local z = def.Hill == "Far" and 2 or 4
		-- Cadre ancré en bas au centre (pied du mât, caché par la colline) :
		-- le UIScale le fait grandir vers le haut
		local root = frame({
			Name = "Turbine" .. index,
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromOffset(def.X, def.Ground + 6),
			Size = UDim2.fromOffset(blade * 2, def.H + 6 + blade),
			BackgroundTransparency = 1,
			Visible = false,
			ZIndex = z,
			Parent = scenery,
		})
		local scale = Create("UIScale", { Parent = root })
		local tower = frame({
			Name = "Tower",
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromOffset(blade, blade),
			Size = UDim2.fromOffset(math.max(2, def.H * 0.075), def.H + 6),
			BackgroundColor3 = WHITE,
			ZIndex = z,
			Parent = root,
		})
		UIUtil.Gradient(tower, ColorSequence.new(tone, shade), 0)
		local nacelle = frame({
			Name = "Nacelle",
			AnchorPoint = Vector2.new(0.3, 0.5),
			Position = UDim2.fromOffset(blade, blade),
			Size = UDim2.fromOffset(hubSize * 2.4, hubSize * 1.3),
			BackgroundColor3 = tone:Lerp(shade, 0.35),
			ZIndex = z,
			Parent = root,
		})
		UIUtil.Corner(nacelle, 2)
		-- Rotor : 3 pales (chaque pale dans un carré tourné, centré sur le moyeu)
		local rotorFrame = frame({
			Name = "Blades",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(blade, blade),
			Size = UDim2.fromOffset(blade * 2, blade * 2),
			BackgroundTransparency = 1,
			ZIndex = z,
			Parent = root,
		})
		for bladeIndex = 0, 2 do
			local holder = frame({
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Rotation = bladeIndex * 120,
				ZIndex = z,
				Parent = rotorFrame,
			})
			local bladeFrame = frame({
				Name = "Blade",
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(math.max(1.5, def.H * 0.06), blade),
				BackgroundColor3 = WHITE,
				ZIndex = z,
				Parent = holder,
			})
			UIUtil.Gradient(bladeFrame, ColorSequence.new(shade, tone), 0)
		end
		local turbineHub = centered({ Name = "Hub", BackgroundColor3 = tone, ZIndex = z, Parent = root }, blade, blade, hubSize, hubSize)
		round(turbineHub)
		UIUtil.Stroke(turbineHub, shade:Lerp(BLACK, 0.25), 1, 0.3)
		-- Feu d'obstacle rouge (niveaux 7+), en haut de la nacelle
		local lamp = centered({
			Name = "Lamp",
			BackgroundColor3 = Color3.fromRGB(255, 56, 70),
			Visible = false,
			ZIndex = z,
			Parent = root,
		}, blade + hubSize * 0.8, blade - hubSize * 0.75, 3, 3)
		round(lamp)
		turbines[index] = {
			Root = root,
			Scale = scale,
			Rotor = rotorFrame,
			Lamp = lamp,
			Def = def,
			Angle = random:NextNumber(0, 120),
			Speed = random:NextNumber(0.85, 1.15),
			Shown = false,
		}
	end

	------------------------------------------------------------------
	-- Pot, terre, plante et bâton en bois
	------------------------------------------------------------------
	local potTop = height - 38
	local stick = frame({
		Name = "Stick",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromOffset(hubX, hubY),
		Size = UDim2.fromOffset(7, potTop - hubY + 6),
		BackgroundColor3 = WHITE,
		ZIndex = 3,
		Parent = card,
	})
	UIUtil.Corner(stick, 3)
	UIUtil.Gradient(stick, ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(246, 214, 160)),
		ColorSequenceKeypoint.new(0.45, Color3.fromRGB(226, 176, 110)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(158, 104, 58)),
	}), 0)
	-- Veines du bois
	for i, spec in ipairs({ { 2, 0.15, 0.55 }, { 4.5, 0.4, 0.5 } }) do
		frame({
			Name = "Grain" .. i,
			Position = UDim2.new(0, spec[1], spec[2], 0),
			Size = UDim2.new(0, 1, spec[3], 0),
			BackgroundColor3 = Color3.fromRGB(130, 82, 40),
			BackgroundTransparency = 0.55,
			ZIndex = 3,
			Parent = stick,
		})
	end

	-- Plante : deux feuilles + une petite fleur sur sa tige
	local LEAF = ColorSequence.new(Color3.fromRGB(150, 230, 120), Color3.fromRGB(56, 160, 80))
	for side = -1, 1, 2 do
		local leaf = frame({
			Name = "Leaf",
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromOffset(hubX + side * 12, potTop + 3),
			Size = UDim2.fromOffset(10, 22),
			Rotation = side * 38,
			BackgroundColor3 = WHITE,
			ZIndex = 4,
			Parent = card,
		})
		round(leaf)
		UIUtil.Gradient(leaf, LEAF, 90)
	end
	local flowerX, flowerY = hubX - 22, potTop - 24
	frame({
		Name = "Stem",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromOffset(flowerX + 2, flowerY),
		Size = UDim2.fromOffset(2, potTop - flowerY + 2),
		Rotation = -10,
		BackgroundColor3 = Color3.fromRGB(70, 170, 90),
		ZIndex = 4,
		Parent = card,
	})
	local flower = centered({ Name = "Flower", BackgroundTransparency = 1, ZIndex = 5, Parent = card }, flowerX, flowerY, 16, 16)
	for p = 0, 3 do
		local a = math.rad(p * 90 + 45)
		local petal = centered({
			Name = "Petal",
			BackgroundColor3 = Color3.fromRGB(255, 150, 196),
			ZIndex = 5,
			Parent = flower,
		}, 8 + math.cos(a) * 4, 8 + math.sin(a) * 4, 8, 8)
		round(petal)
	end
	local flowerHeart = centered({ Name = "Heart", BackgroundColor3 = Color3.fromRGB(255, 220, 80), ZIndex = 6, Parent = flower }, 8, 8, 6, 6)
	round(flowerHeart)

	-- Pot en terre cuite (rebord + corps + terre + petit visage)
	local TERRACOTTA = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(246, 160, 116)),
		ColorSequenceKeypoint.new(0.55, Color3.fromRGB(222, 118, 80)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(170, 82, 56)),
	})
	local potBody = frame({
		Name = "Pot",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromOffset(hubX, potTop + 6),
		Size = UDim2.fromOffset(40, 26),
		BackgroundColor3 = WHITE,
		ZIndex = 5,
		Parent = card,
	})
	UIUtil.Corner(potBody, 9)
	UIUtil.Gradient(potBody, TERRACOTTA, 0)
	UIUtil.Stroke(potBody, Color3.fromRGB(120, 60, 40), 1.5, 0.35)
	-- Visage "kawaii" peint sur le pot
	for side = -1, 1, 2 do
		local eye = centered({ Name = "Eye", BackgroundColor3 = Color3.fromRGB(80, 40, 36), ZIndex = 6, Parent = potBody }, 20 + side * 7, 12, 3.5, 4)
		round(eye)
	end
	local smile = centered({ Name = "Smile", BackgroundTransparency = 1, ZIndex = 6, Parent = potBody }, 20, 14, 7, 7)
	round(smile)
	local smileStroke = UIUtil.Stroke(smile, Color3.fromRGB(80, 40, 36), 1.5, 0)
	UIUtil.Create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(WHITE),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.55, 1),
			NumberSequenceKeypoint.new(0.62, 0),
			NumberSequenceKeypoint.new(1, 0),
		}),
		Parent = smileStroke,
	})

	local rim = frame({
		Name = "Rim",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromOffset(hubX, potTop),
		Size = UDim2.fromOffset(48, 10),
		BackgroundColor3 = WHITE,
		ZIndex = 6,
		Parent = card,
	})
	UIUtil.Corner(rim, 4)
	UIUtil.Gradient(rim, ColorSequence.new(Color3.fromRGB(250, 170, 126), Color3.fromRGB(196, 96, 64)), 90)
	UIUtil.Stroke(rim, Color3.fromRGB(120, 60, 40), 1.5, 0.35)
	local soil = centered({ Name = "Soil", BackgroundColor3 = Color3.fromRGB(92, 58, 42), ZIndex = 6, Parent = rim }, 24, 2, 38, 5)
	round(soil)

	------------------------------------------------------------------
	-- Rotor : 4 pales (triangle ombré + rabat clair + pliure + pois)
	------------------------------------------------------------------
	local rotorHolder = frame({
		Name = "RotorHolder",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(hubX, hubY),
		Size = UDim2.fromOffset(reach * 2, reach * 2),
		BackgroundTransparency = 1,
		ZIndex = 7,
		Parent = card,
	})
	-- Ombre douce de la roue sur le ciel
	local rotorShadow = centered({
		Name = "Shadow",
		BackgroundColor3 = BLACK,
		BackgroundTransparency = 0.93,
		ZIndex = 1,
		Parent = rotorHolder,
	}, reach + 3, reach + 5, reach * 1.7, reach * 1.7)
	round(rotorShadow)

	local rotor = frame({
		Name = "Rotor",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = rotorHolder,
	})
	local foldSize = math.floor(BLADE * 0.8)
	for index, color in ipairs(BLADE_COLORS) do
		local bladeHolder = frame({
			Name = "Blade" .. index,
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Rotation = (index - 1) * 90,
			ZIndex = 2,
			Parent = rotor,
		})
		-- Triangle principal (moitié bas-gauche du carré, sommet au moyeu) :
		-- sombre dans le creux de la courbure, vif près de la pliure
		local main = frame({
			Name = "Main",
			Position = UDim2.fromOffset(reach, reach),
			Size = UDim2.fromOffset(BLADE, BLADE),
			BackgroundColor3 = WHITE,
			ZIndex = 2,
			Parent = bladeHolder,
		})
		local mainGradient = UIUtil.Gradient(main, ColorSequence.new({
			ColorSequenceKeypoint.new(0, color:Lerp(BLACK, 0.3)),
			ColorSequenceKeypoint.new(0.3, color),
			ColorSequenceKeypoint.new(0.5, color:Lerp(WHITE, 0.25)),
			ColorSequenceKeypoint.new(1, color),
		}), -45)
		mainGradient.Transparency = halfTransparency(true)
		-- Petits pois blancs (dans le triangle : y > x)
		for d, spec in ipairs({ { 0.24, 0.7, 6 }, { 0.5, 0.86, 4 } }) do
			local dot = centered({
				Name = "Dot" .. d,
				BackgroundColor3 = WHITE,
				BackgroundTransparency = 0.3,
				ZIndex = 3,
				Parent = main,
			}, BLADE * spec[1], BLADE * spec[2], spec[3], spec[3])
			round(dot)
		end
		-- Rabat (moitié haut-droite d'un carré plus petit) : papier plié, plus clair
		local fold = frame({
			Name = "Fold",
			Position = UDim2.fromOffset(reach, reach),
			Size = UDim2.fromOffset(foldSize, foldSize),
			BackgroundColor3 = WHITE,
			ZIndex = 4,
			Parent = bladeHolder,
		})
		local foldGradient = UIUtil.Gradient(fold, ColorSequence.new({
			ColorSequenceKeypoint.new(0, color:Lerp(WHITE, 0.7)),
			ColorSequenceKeypoint.new(0.5, color:Lerp(WHITE, 0.62)),
			ColorSequenceKeypoint.new(1, color:Lerp(WHITE, 0.18)),
		}), -45)
		foldGradient.Transparency = halfTransparency(false)
		-- Pliure brillante (diagonale du moyeu vers la pointe)
		local creaseLength = foldSize * math.sqrt(2)
		local crease = frame({
			Name = "Crease",
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromOffset(reach + foldSize / 2 - creaseLength / 2, reach + foldSize / 2),
			Size = UDim2.fromOffset(creaseLength, 2),
			Rotation = 45,
			BackgroundColor3 = WHITE,
			ZIndex = 5,
			Parent = bladeHolder,
		})
		UIUtil.Create("UIGradient", { Color = ColorSequence.new(WHITE), Transparency = FADE_ENDS, Parent = crease })
	end

	-- Disque "flou" coloré (apparaît quand ça tourne vite)
	local blur = centered({
		Name = "Blur",
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 1,
		ZIndex = 6,
		Parent = rotorHolder,
	}, reach, reach, reach * 1.85, reach * 1.85)
	round(blur)
	local blurColors = {}
	for i, color in ipairs(BLADE_COLORS) do
		table.insert(blurColors, ColorSequenceKeypoint.new((i - 1) / #BLADE_COLORS, color:Lerp(WHITE, 0.35)))
	end
	table.insert(blurColors, ColorSequenceKeypoint.new(1, BLADE_COLORS[1]:Lerp(WHITE, 0.35)))
	local blurGradient = UIUtil.Gradient(blur, ColorSequence.new(blurColors), 0)
	local blurStroke = UIUtil.Stroke(blur, WHITE, 3, 1)

	-- Moyeu : rosace + perle vernie + reflet
	local rosette = centered({ Name = "Rosette", BackgroundColor3 = WHITE, BackgroundTransparency = 0.15, ZIndex = 7, Parent = rotorHolder }, reach, reach, 24, 24)
	round(rosette)
	local hub = centered({ Name = "Hub", BackgroundColor3 = WHITE, ZIndex = 8, Parent = rotorHolder }, reach, reach, 16, 16)
	round(hub)
	UIUtil.Gradient(hub, ColorSequence.new(Color3.fromRGB(255, 236, 244), Color3.fromRGB(236, 90, 130)), 45)
	UIUtil.Stroke(hub, Color3.fromRGB(120, 30, 60), 1.5, 0.2)
	local hubShine = centered({ Name = "Shine", BackgroundColor3 = WHITE, BackgroundTransparency = 0.1, ZIndex = 9, Parent = hub }, 5.5, 5.5, 5, 4)
	round(hubShine)

	------------------------------------------------------------------
	-- Lignes de vent + étincelles (réserves recyclées)
	------------------------------------------------------------------
	local winds = {}
	for i = 1, WIND_POOL do
		local line = frame({
			Name = "Wind" .. i,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(30, 2),
			BackgroundColor3 = Color3.fromRGB(246, 252, 255),
			Visible = false,
			ZIndex = 11,
			Parent = card,
		})
		round(line)
		UIUtil.Create("UIGradient", { Color = ColorSequence.new(WHITE), Transparency = FADE_ENDS, Parent = line })
		winds[i] = { Frame = line, Active = false, X = 0, Y = 0, Speed = 0, Life = 0, MaxLife = 1, Phase = 0 }
	end

	local function spawnWind()
		for _, wind in ipairs(winds) do
			if not wind.Active then
				wind.Active = true
				wind.X = -20
				wind.Y = random:NextNumber(12, height - 50)
				wind.Speed = random:NextNumber(220, 320)
				wind.MaxLife = (width + 40) / wind.Speed
				wind.Life = 0
				wind.Phase = random:NextNumber(0, math.pi * 2)
				wind.Frame.Size = UDim2.fromOffset(random:NextNumber(22, 40), 2)
				wind.Frame.Visible = true
				return
			end
		end
	end

	local sparkles: { TextLabel } = {}
	local SPARKLE_COLORS = { Color3.fromRGB(255, 214, 60), WHITE, Color3.fromRGB(255, 150, 196) }
	for i = 1, SPARKLE_POOL do
		local sparkle = UIUtil.Create("TextLabel", {
			Name = "Sparkle" .. i,
			Text = "✦",
			Font = Theme.Fonts.Title,
			TextSize = 16,
			TextColor3 = SPARKLE_COLORS[(i - 1) % #SPARKLE_COLORS + 1],
			TextStrokeColor3 = Color3.fromRGB(200, 120, 40),
			TextStrokeTransparency = 0.6,
			TextTransparency = 1,
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(hubX, hubY),
			Size = UDim2.fromOffset(20, 20),
			ZIndex = 13,
			Parent = card,
		})
		sparkles[i] = sparkle
	end
	local nextSparkle = 1

	-- Gerbe d'étincelles autour du moyeu (ou d'un autre point : x, y, portée)
	local function sparkleBurst(count: number, x: number?, y: number?, reach: number?)
		local originX, originY = x or hubX, y or hubY
		local far = reach or 56
		for _ = 1, count do
			local sparkle = sparkles[nextSparkle]
			nextSparkle = nextSparkle % #sparkles + 1
			local a = random:NextNumber(0, math.pi * 2)
			local distance = random:NextNumber(far * 0.6, far)
			sparkle.Position = UDim2.fromOffset(originX, originY)
			sparkle.TextTransparency = 0
			sparkle.TextStrokeTransparency = 0.6
			sparkle.TextSize = random:NextInteger(12, 18)
			sparkle.Rotation = 0
			UIUtil.Tween(sparkle, random:NextNumber(0.45, 0.65), {
				Position = UDim2.fromOffset(originX + math.cos(a) * distance, originY + math.sin(a) * distance),
				TextTransparency = 1,
				TextStrokeTransparency = 1,
				Rotation = random:NextNumber(-120, 120),
				TextSize = 6,
			}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		end
	end

	------------------------------------------------------------------
	-- Pastilles : compteur (cadran + tr/min), indice, décollage
	------------------------------------------------------------------
	local chip = frame({
		Name = "RpmChip",
		Position = UDim2.fromOffset(6, 6),
		Size = UDim2.fromOffset(72, 18),
		BackgroundColor3 = Color3.fromRGB(34, 28, 58),
		BackgroundTransparency = 0.08,
		ZIndex = 12,
		Parent = card,
	})
	round(chip)
	UIUtil.Gradient(chip, ColorSequence.new(WHITE, Color3.fromRGB(170, 170, 190)), 90)
	UIUtil.Stroke(chip, WHITE, 1, 0.55)
	local dial = centered({ Name = "Dial", BackgroundColor3 = Color3.fromRGB(18, 14, 34), ZIndex = 12, Parent = chip }, 10, 9, 12, 12)
	round(dial)
	local dialStroke = UIUtil.Stroke(dial, Theme.Colors.Green, 1.5, 0)
	local needle = frame({
		Name = "Needle",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(1.5, 5),
		BackgroundColor3 = WHITE,
		ZIndex = 13,
		Parent = dial,
	})
	local rpmFormat = Locale.T("%d rpm")
	local rpmLabel = UIUtil.Label({
		Name = "Rpm",
		Text = Locale.T("%d rpm", 12),
		Font = Theme.Fonts.Number,
		TextColor3 = WHITE,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(20, 2),
		Size = UDim2.new(1, -24, 1, -4),
		MaxTextSize = 11,
		ZIndex = 13,
		Parent = chip,
	})

	local hint = UIUtil.Label({
		Name = "Hint",
		Text = Locale.T("Blow! 🌬️"),
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.TextDark,
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.05,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromOffset(width - 6, height - 24),
		Size = UDim2.fromOffset(54, 18),
		MaxTextSize = 11,
		ZIndex = 12,
		Parent = card,
	})
	round(hint)
	local hintStroke = UIUtil.Stroke(hint, Theme.Colors.Border, 1, 0.5)

	local liftLabel = UIUtil.Label({
		Name = "Lift",
		Text = "",
		Font = Enum.Font.LuckiestGuy,
		TextColor3 = Theme.Colors.Yellow,
		TextTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromOffset(hubX, 28),
		Size = UDim2.fromOffset(width - 16, 18),
		MaxTextSize = 15,
		ZIndex = 14,
		Parent = card,
	})
	local liftStroke = UIUtil.Stroke(liftLabel, Theme.Colors.TextDark, 2, 1)
	liftStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual

	------------------------------------------------------------------
	-- Interaction (toute la carte est cliquable)
	------------------------------------------------------------------
	local button = Create("TextButton", {
		Name = "Blow",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 20,
		Parent = card,
	})

	local speed = BASE_SPEED
	local baseSpeed = BASE_SPEED -- vitesse de repos (monte avec WindPower)
	local angle = random:NextNumber(0, 90)
	local lastInteract = -math.huge
	local gustTimer = random:NextNumber(5, 10)
	local rpmTimer = 0
	local windTimer = 0
	local lifting = false
	local blown = false
	local clock = 0

	local function blow()
		speed = math.min(MAX_SPEED, speed + BOOST)
		cardScale.Scale = 0.94
		UIUtil.Tween(cardScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		ctx.Sound.Play("Open", random:NextNumber(1.1, 1.4))
		local fx = effectsOn()
		for _ = 1, fx and 3 or 1 do
			spawnWind()
		end
		sparkleBurst(fx and 4 or 2)
		-- Petit "pop" du moyeu
		hub.Size = UDim2.fromOffset(21, 21)
		UIUtil.Tween(hub, 0.3, { Size = UDim2.fromOffset(16, 16) }, Enum.EasingStyle.Back)
		if not blown then
			blown = true
			UIUtil.Tween(hint, 0.3, { TextTransparency = 1, BackgroundTransparency = 1 })
			UIUtil.Tween(hintStroke, 0.3, { Transparency = 1 })
		end
		local now = os.clock()
		if now - lastInteract >= cooldown then
			lastInteract = now
			ctx.Interact("Spin")
		end
	end
	ctx.Connect(button.Activated, blow)

	ctx.OnBonus("Spin", function(payload)
		local amount = tonumber(payload.Amount)
		if amount then
			floatOnOverlay(card, width, Vector2.new(hubX, hubY - 30), "+" .. ctx.Format.Format(amount), Theme.Colors.Gold, 26)
		end
	end)

	------------------------------------------------------------------
	-- v9 : niveau d'énergie éolienne (WindPower), appliqué en direct
	------------------------------------------------------------------
	local windLevel = -1
	local ambientWind = 0
	local sceneryClock = 0
	local energyClock = 0
	local lampOn = false

	-- Position du moyeu d'une éolienne (coordonnées de la carte)
	local function turbineHub(turbine): (number, number)
		local def = turbine.Def
		return def.X, def.Ground + 6 - (def.H + 6) * turbine.Scale.Scale
	end

	local function applyWind(level: number, animate: boolean)
		level = math.clamp(math.floor(level), 0, 10)
		if level == windLevel then
			return
		end
		local previousLevel = windLevel
		windLevel = level
		baseSpeed = BASE_SPEED + level * WIND_SPEED_PER_LEVEL
		-- Niveaux 7 à 10 : les éoliennes grandissent
		local grow = 1 + 0.08 * math.max(0, level - #TURBINES)
		for index, turbine in ipairs(turbines) do
			local show = level >= index
			turbine.Lamp.Visible = show and level >= 7
			if show and not turbine.Shown then
				turbine.Shown = true
				turbine.Root.Visible = true
				if animate then
					-- Sort de terre avec des étincelles
					turbine.Scale.Scale = 0.05
					UIUtil.Tween(turbine.Scale, 0.7, { Scale = grow }, Enum.EasingStyle.Back)
					local def = turbine.Def
					sparkleBurst(effectsOn() and 5 or 2, def.X, def.Ground - def.H * 0.7, 26)
				else
					turbine.Scale.Scale = grow
				end
			elseif show then
				if animate and math.abs(turbine.Scale.Scale - grow) > 0.001 then
					UIUtil.Tween(turbine.Scale, 0.5, { Scale = grow }, Enum.EasingStyle.Back)
				else
					turbine.Scale.Scale = grow
				end
			elseif turbine.Shown then
				turbine.Shown = false
				turbine.Root.Visible = false
			end
		end
		-- Niveau acheté : coup de vent pour qu'on le voie
		if animate and previousLevel >= 0 and level > previousLevel then
			speed = math.min(MAX_SPEED, speed + 450)
			for _ = 1, effectsOn() and 4 or 1 do
				spawnWind()
			end
		end
	end
	applyWind(tonumber(ctx.GetLevel("WindPower")) or 0, false)
	ctx.Connect(ctx.State.Changed, function()
		applyWind(tonumber(ctx.GetLevel("WindPower")) or 0, true)
	end)

	------------------------------------------------------------------
	-- Animation
	------------------------------------------------------------------
	local restPosition = UDim2.fromOffset(hubX, hubY)
	local SLOW_COLOR = Theme.Colors.Green
	local MID_COLOR = Theme.Colors.Yellow
	local FAST_COLOR = Theme.Colors.Red

	ctx.OnRender(function(dt: number)
		dt = math.min(dt, 0.1)
		clock += dt
		local fx = effectsOn()

		-- Coups de vent naturels
		gustTimer -= dt
		if gustTimer <= 0 then
			gustTimer = random:NextNumber(6, 12) / (1 + math.max(0, windLevel) * 0.12)
			speed = math.min(MAX_SPEED, speed + random:NextNumber(150, 300))
			if fx then
				spawnWind()
				spawnWind()
			end
		end

		-- Retour progressif au calme
		speed = baseSpeed + (speed - baseSpeed) * math.exp(-dt * DECAY)
		angle = (angle + speed * dt) % 360
		rotor.Rotation = angle

		-- Disque flou coloré (tourne avec la roue)
		local fast = math.clamp((speed - 450) / 1500, 0, 1)
		blur.BackgroundTransparency = 1 - fast * 0.5
		blurStroke.Transparency = 1 - fast * 0.6
		blurGradient.Rotation = angle

		-- Lignes de vent continues quand ça tourne vite
		if fx and speed > 700 then
			windTimer -= dt * (speed / 900)
			if windTimer <= 0 then
				windTimer = random:NextNumber(0.16, 0.3)
				spawnWind()
			end
		end
		-- v9 : vent ambiant (WindPower) : lignes de vent de plus en plus fréquentes
		if fx and windLevel > 0 then
			ambientWind -= dt * (0.25 + windLevel * 0.3)
			if ambientWind <= 0 then
				ambientWind = random:NextNumber(0.7, 1.3)
				spawnWind()
			end
		end
		-- Éoliennes : les pales tournent avec le vent, feux rouges (7+), éclairs d'énergie (10)
		if windLevel > 0 then
			local turbineSpin = 70 + windLevel * 16 + math.max(0, speed - baseSpeed) * 0.12
			for _, turbine in ipairs(turbines) do
				if turbine.Shown then
					turbine.Angle = (turbine.Angle + turbineSpin * turbine.Speed * dt) % 360
				end
			end
			if windLevel >= 7 then
				local on = (clock % 1.4) < 0.3
				if on ~= lampOn then
					lampOn = on
					for _, turbine in ipairs(turbines) do
						turbine.Lamp.BackgroundTransparency = on and 0 or 0.75
					end
				end
			end
			if windLevel >= 10 and fx then
				energyClock -= dt
				if energyClock <= 0 then
					energyClock = random:NextNumber(0.5, 1.1)
					local turbine = turbines[random:NextInteger(1, #turbines)]
					if turbine.Shown then
						local x, y = turbineHub(turbine)
						sparkleBurst(1, x, y, 16)
					end
				end
			end
		end
		for _, wind in ipairs(winds) do
			if wind.Active then
				wind.Life += dt
				wind.X += wind.Speed * dt
				local life = wind.Life / wind.MaxLife
				if life >= 1 then
					wind.Active = false
					wind.Frame.Visible = false
				else
					local wave = math.sin(wind.Phase + wind.Life * 9) * 4
					wind.Frame.Position = UDim2.fromOffset(wind.X, wind.Y + wave)
					wind.Frame.Rotation = math.cos(wind.Phase + wind.Life * 9) * 8
					wind.Frame.BackgroundTransparency = 0.15 + 0.85 * life * life
				end
			end
		end

		-- Décollage (tremble et monte un peu quand c'est très rapide)
		local liftAmount = math.clamp((speed - 1500) / 1000, 0, 1)
		if liftAmount > 0 then
			rotorHolder.Position = UDim2.fromOffset(
				hubX + random:NextNumber(-1.5, 1.5) * liftAmount,
				hubY - liftAmount * 6 + random:NextNumber(-1.5, 1.5) * liftAmount
			)
			stick.Rotation = math.sin(clock * 40) * 2 * liftAmount
		elseif rotorHolder.Position ~= restPosition then
			rotorHolder.Position = restPosition
			stick.Rotation = 0
		end
		if liftAmount > 0.3 and not lifting then
			lifting = true
			local liftTexts = Locale.Pick(LIFT_TEXTS)
			liftLabel.Text = liftTexts[random:NextInteger(1, #liftTexts)]
			UIUtil.Tween(liftLabel, 0.2, { TextTransparency = 0 })
			UIUtil.Tween(liftStroke, 0.2, { Transparency = 0 })
		elseif liftAmount < 0.1 and lifting then
			lifting = false
			UIUtil.Tween(liftLabel, 0.4, { TextTransparency = 1 })
			UIUtil.Tween(liftStroke, 0.4, { Transparency = 1 })
		end

		-- Nuages, soleil, fleur qui se balance dans le vent
		for _, cloud in ipairs(clouds) do
			cloud.X += cloud.Speed * dt * (1 + math.max(0, windLevel) * 0.15)
			if cloud.X > width + 30 then
				cloud.X = -30
			end
		end
		-- Décor (CanvasGroup redessiné à chaque changement) : 30 fois par seconde
		sceneryClock += dt
		if sceneryClock >= 1 / 30 then
			sceneryClock = 0
			for _, cloud in ipairs(clouds) do
				cloud.Frame.Position = UDim2.fromOffset(cloud.X, cloud.Y)
			end
			sunGlow.BackgroundTransparency = 0.6 + 0.12 * math.sin(clock * 1.3)
			for _, turbine in ipairs(turbines) do
				if turbine.Shown then
					turbine.Rotor.Rotation = turbine.Angle
				end
			end
		end
		flower.Rotation = math.sin(clock * (1.5 + fast * 6)) * (6 + fast * 14)

		-- Compteur : aiguille, couleur du cadran, tours / minute (degrés/s ÷ 6)
		local ratio = math.clamp((speed - BASE_SPEED) / (MAX_SPEED - BASE_SPEED), 0, 1)
		needle.Rotation = -120 + ratio * 240
		rpmTimer -= dt
		if rpmTimer <= 0 then
			rpmTimer = 0.12
			rpmLabel.Text = string.format(rpmFormat, math.floor(speed / 6 + 0.5))
			dialStroke.Color = ratio < 0.5 and SLOW_COLOR:Lerp(MID_COLOR, ratio * 2) or MID_COLOR:Lerp(FAST_COLOR, (ratio - 0.5) * 2)
		end

		-- L'indice "Souffle !" se dandine tant qu'on n'a pas soufflé
		if not blown then
			hint.Rotation = math.sin(clock * 3) * 4
		end
	end)
end

function Pinwheel.Stop(_ctx)
	-- Tout est dans ctx.Container (détruit par le StimulusManager)
end

return Pinwheel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="147">
          <Properties>
            <string name="Name">Press</string>
            <string name="Source"><![CDATA[--[[
	Press (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > Press

	Une vraie petite chaîne d'écrasement, en boucle, très satisfaisante :
	  - un tapis roulant (bande qui défile, rouleaux qui tournent, pieds)
	    amène les objets un par un sous la presse ; la file d'attente est
	    variée (macarons, canette, pastèque, gâteau, cadeau, gelée, éponge,
	    Rubik's cube, canard, ballon, pot de peinture... + objets propres au
	    palier), tous DESSINÉS en Frames : ils se déforment vraiment ;
	  - la presse : deux colonnes ombrées façon métal, traverse avec bande
	    d'accent et boulons, vérin (chemise + tige chromée), plateau guidé
	    par les colonnes, enclume ; centrale hydraulique à gauche (moteur,
	    réservoir avec voyant d'huile), deux flexibles jusqu'au vérin,
	    manomètres gradués (aiguille qui grimpe dans le rouge) ;
	  - le cycle : chargement (le tapis avance), descente, compression (l'objet
	    se tasse et s'élargit en tremblant), CRUNCH (écrasement avec rebond,
	    onde de choc, éclats, étincelles, vapeur, poussière, secousse de la
	    MACHINE seulement : la carte et son contour ne bougent pas), remontée,
	    et la galette repart sur le tapis vers le bac à gauche.

	10 paliers visuels, un par niveau de "Presse hydraulique" (ctx.GetLevel("Press")) :
	  1 bois rustique, 2 chêne & fer, 3 acier, 4 acier bleu, 5 industrielle
	  (gyrophare, vapeur), 6 usine (afficheur numérique), 7 or, 8 or royal
	  (rubis), 9 diamant (cristaux), 10 diamant néon (contours arc-en-ciel).
	Pastille "Niv. X · palier" + animation au changement de palier. La
	vitesse augmente avec le niveau.

	"Presse turbo" (Feature PressStart) : pupitre avec un gros bouton START
	(Interact("Press"), recharge côté serveur, jauge de recharge affichée) ;
	le bonus s'affiche via OnBonus("Press"). Sans turbo : panneau "Attention
	aux doigts".

	Performance : une seule boucle OnRender ; particules, bouffées de vapeur
	et cris "CRUNCH!" viennent de réserves réutilisées (aucune création
	d'instance par image) ; rien n'est animé quand la carte est cachée.
	Mise en page : tout reste à l'intérieur de la carte (ClipsDescendants),
	contour jamais coupé (voir Slots.ClipMargin).
]]

local Debris = game:GetService("Debris")

local Locale = require(game:GetService("ReplicatedStorage").Shared.Locale)

local Press = {}
Press.Slot = "C3"

----------------------------------------------------------------------
-- Géométrie (pixels "design" dans la carte de 380 x 264 : slot de 384 x 268
-- moins 2 px de marge de chaque côté pour que le contour ne soit pas coupé)
----------------------------------------------------------------------
local HEADER_H = 32
local MX = 170 -- axe de la presse
local FLOOR_Y = 246 -- sol de l'atelier
local BELT_Y = 206 -- dessus du tapis (bas des objets)
local BELT_H = 8
local BELT_X0, BELT_X1 = 64, 384 -- le tapis sort par le bord droit de la carte
local CROWN_Y, CROWN_H = 50, 26 -- traverse du haut
local CYL_Y = 36 -- haut du vérin
local PLATE_TOP = CROWN_Y + CROWN_H + 6 -- plateau en position haute
local PLATE_H = 22
local PLATE_W = 160
local PILLAR_W = 18
local PILLAR_X = { MX - 80 - PILLAR_W, MX + 80 } -- bord gauche de chaque colonne
-- Pas du tapis : l'objet en attente est posé À DROITE de la colonne et des
-- guides du plateau (jamais devant eux), le suivant arrive du bord de la carte
local SPACING = 152

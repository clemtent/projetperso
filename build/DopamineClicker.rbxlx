----------------------------------------------------------------------
-- Paliers visuels (un par niveau)
----------------------------------------------------------------------
type Localized = { en: string, fr: string }

type TierStyle = {
	Name: Localized,
	Shout: Localized,
	Icon: string,
	Chip: Color3,
	ChipText: Color3,
	WallTop: Color3,
	WallBottom: Color3,
	Seam: Color3,
	Floor: Color3,
	CardStroke: Color3,
	Title: Color3,
	Frame: Color3, -- couleur principale de la machine
	AccentA: Color3, -- bandes d'accent (rayures)
	AccentB: Color3,
	Chrome: Color3, -- tige du vérin
	Hose: Color3,
	Fitting: Color3,
	Bolt: Color3,
	Outline: Color3,
	Debris: { Color3 },
	Drawn: { string }, -- objets dessinés propres au palier
	Emoji: { EmojiItem },
	Wood: boolean?,
	Rope: boolean?,
	Bands: boolean?,
	Rivets: boolean?,
	Gauge2: boolean?,
	Beacon: boolean?,
	Steam: boolean?,
	Digital: boolean?,
	Shine: boolean?,
	Sparkle: Color3?,
	Gems: boolean?,
	Crystal: boolean?,
	Neon: boolean?,
	Dark: boolean?, -- carte sombre (texte clair)
}


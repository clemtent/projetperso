	local flash = label({ Name = "Flash", Parent = root, Text = "", TextSize = 30, Color = CYAN, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(600, 44), ZIndex = 11 })

			ProductId = 3714962804, PriceHint = 85, Kind = "Tickets", Tickets = 50, Tag = "⭐ POPULAR" },
		{ Id = "Tickets100", Name = "Ticket crate", Icon = "📦", Description = "100 arcade tickets",

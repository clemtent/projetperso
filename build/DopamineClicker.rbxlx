		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundTransparency = 1,
		Rotation = 8,
		ZIndex = 6,
		Parent = armPivot,
	})
	local armRod = UIUtil.Create("Frame", {
		Size = UDim2.new(0, 3, 0, 58),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		BackgroundColor3 = Color3.fromRGB(215, 215, 230),
		BorderSizePixel = 0,
		ZIndex = 6,
		Parent = arm,
	})
	UIUtil.Corner(armRod, UDim.new(1, 0))
	local head = UIUtil.Create("Frame", {
		Size = UDim2.fromOffset(9, 14),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromOffset(2, 56),
		BackgroundColor3 = Color3.fromRGB(240, 240, 250),
		ZIndex = 7,
		Parent = arm,
	})
	UIUtil.Corner(head, 3)
	UIUtil.Stroke(head, Color3.fromRGB(60, 56, 80), 1, 0.2)

	-- Textes
	local textLeft = 142
	local status = UIUtil.Label({
		Name = "Status",
		Font = Theme.Fonts.Title,
		Text = "",
		TextColor3 = LAVENDER,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -(textLeft + 190), 0, 14),
		Position = UDim2.fromOffset(textLeft + 14, 18),
		MaxTextSize = 12,
		ZIndex = 3,
		Parent = card,
	})
	local dot = UIUtil.Create("Frame", {
		Name = "Live",
		Size = UDim2.fromOffset(8, 8),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromOffset(textLeft, 25),
		BackgroundColor3 = Color3.fromRGB(90, 240, 150),
		ZIndex = 3,
		Parent = card,
	})
	UIUtil.Corner(dot, UDim.new(1, 0))
	local title = UIUtil.Label({
		Name = "Title",
		Font = Theme.Fonts.Title,
		Text = "",
		TextColor3 = WHITE,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -(textLeft + 176), 0, 26),
		Position = UDim2.fromOffset(textLeft, 34),
		MaxTextSize = 23,
		ZIndex = 3,
		Parent = card,
	})
	local meta = UIUtil.Label({
		Name = "Meta",
		Text = "",
		TextColor3 = LAVENDER,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -(textLeft + 176), 0, 16),
		Position = UDim2.fromOffset(textLeft, 62),
		MaxTextSize = 14,
		ZIndex = 3,
		Parent = card,
	})
	-- Visualiseur (barres en bas, du milieu vers les bords)
	local viz = UIUtil.Create("Frame", {
		Name = "Visualizer",
		Size = UDim2.new(1, -(textLeft + 176), 0, 30),
		Position = UDim2.fromOffset(textLeft, 86),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = card,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		HorizontalAlignment = Enum.HorizontalAlignment.Left,
		Padding = UDim.new(0, 3),
		Parent = viz,
	})
	local bars = {}
	for index = 1, BAR_COUNT do
		local bar = UIUtil.Create("Frame", {
			Name = "Bar" .. index,
			Size = UDim2.new(1 / BAR_COUNT, -3, 0.08, 0),
			BackgroundColor3 = PLAYER_ACCENT:Lerp(PLAYER_ACCENT2, (index - 1) / (BAR_COUNT - 1)),
			BorderSizePixel = 0,
			LayoutOrder = index,
			ZIndex = 3,
			Parent = viz,
		})
		UIUtil.Corner(bar, 2)
		UIUtil.Create("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new(0, 0.35),
			Parent = bar,
		})
		table.insert(bars, bar)
		barLevels[index] = 0.08
	end

	-- Commandes précédent / lecture-pause / suivant (icônes dessinées)
	local prev = playerButton(card, "Previous", "Prev", 40, -146, false, function()
		if type(SoundManager.PreviousTrack) == "function" and SoundManager.PreviousTrack() then
			SoundManager.Play("Open", 1.1)
		end
	end)
	local play = playerButton(card, "PlayPause", "PlayPause", 56, -92, true, function()
		if not ClientState.HasFeature("Lofi") then
			Notifications.Toast(Locale.T("🔒 Unlocks with 🎧 %s", Locale.T("Lofi Beats")), Theme.Colors.Purple)
			return
		end
		local newValue = not current.Music
		Settings.Apply("Music", newValue)
		SoundManager.Play("Open", newValue and 1.3 or 0.8)
		saveSetting("Music", newValue)
	end)
	local nextButton = playerButton(card, "Next", "Next", 40, -38, false, function()
		if SoundManager.NextTrack() then
			SoundManager.Play("Open", 1.25)
		end
	end)

	player = {
		Card = card,
		Vinyl = vinyl,
		VinylLabel = label,
		VinylGradient = labelGradient,
		VinylIcon = icon,
		Arm = arm,
		Status = status,
		StatusDot = dot,
		Title = title,
		Meta = meta,
		Bars = bars,
		Play = play,
		Prev = prev,
		Next = nextButton,
	}
end

-- Carte d'un morceau de la liste (ou "Aléatoire" si key == "Shuffle")
local function buildTrackCard(parent: Instance, key: string, name: string, subtitle: string, art, order: number, wide: boolean)
	local card = UIUtil.Create("TextButton", {
		Name = "Track_" .. key,
		Size = wide and UDim2.new(1, 0, 0, 56) or UDim2.new(),
		BackgroundColor3 = Theme.Colors.Card,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = order,
		Parent = parent,
	})
	UIUtil.Corner(card, Theme.Radius.M)
	local stroke = UIUtil.Stroke(card, ROW_BORDER, 1.5)
	UIUtil.AnimateButton(card, 1.02, 0.97)

	local cover = UIUtil.Create("Frame", {
		Name = "Cover",
		Size = UDim2.fromOffset(40, 40),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 8, 0.5, 0),
		BackgroundColor3 = WHITE,
		ZIndex = 2,
		Parent = card,
	})
	cover:SetAttribute("DarkSkinIgnore", true)
	UIUtil.Corner(cover, Theme.Radius.M)
	UIUtil.Gradient(cover, ColorSequence.new(art.A, art.B), 45)
	UIUtil.Label({
		Text = art.Icon,
		Size = UDim2.new(1, -12, 1, -12),
		Position = UDim2.fromOffset(6, 6),
		MaxTextSize = 22,
		ZIndex = 3,
		Parent = cover,
	})
	local nameLabel = UIUtil.Label({
		Name = "TrackName",
		Text = name,
		Font = Theme.Fonts.Title,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -110, 0, 20),
		Position = UDim2.fromOffset(58, 8),
		MaxTextSize = 16,
		ZIndex = 2,
		Parent = card,
	})
	local sub = UIUtil.Label({
		Name = "Sub",
		Text = subtitle,
		TextColor3 = Theme.Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -110, 0, 15),
		Position = UDim2.fromOffset(58, 30),
		MaxTextSize = 13,
		ZIndex = 2,
		Parent = card,
	})
	-- Coche du choix actuel
	local check = UIUtil.Create("Frame", {
		Name = "Check",
		Size = UDim2.fromOffset(24, 24),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		BackgroundColor3 = Theme.Colors.Purple,
		Visible = false,
		ZIndex = 2,
		Parent = card,
	})
	UIUtil.Corner(check, UDim.new(1, 0))
	UIUtil.Icon("Check", { Size = 14, Thickness = 3, Color = Theme.Colors.TextLight, ZIndex = 3, Parent = check })
	-- Mini-égaliseur "en cours"
	local eqHolder = UIUtil.Create("Frame", {
		Name = "Eq",
		Size = UDim2.fromOffset(18, 16),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = card,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		Padding = UDim.new(0, 2),
		Parent = eqHolder,
	})
	local eq = {}
	for index = 1, 4 do
		local bar = UIUtil.Create("Frame", {
			Size = UDim2.fromOffset(3, 4),
			BackgroundColor3 = Theme.Colors.Purple:Lerp(Theme.Colors.Pink, (index - 1) / 3),
			BorderSizePixel = 0,
			LayoutOrder = index,
			Visible = false,
			ZIndex = 2,
			Parent = eqHolder,
		})
		UIUtil.Corner(bar, 1)
		table.insert(eq, bar)
	end

	local row: TrackRow = { Key = key, Card = card, Stroke = stroke, Check = check, Name = nameLabel, Sub = sub, Eq = eq, Hovered = false }
	card.MouseEnter:Connect(function()
		row.Hovered = true
		paintTracks()
	end)
	card.MouseLeave:Connect(function()
		row.Hovered = false
		paintTracks()
	end)
	card.Activated:Connect(function()
		if type(SoundManager.SetMusicTrack) ~= "function" then
			return
		end
		local wasSelected = getMusicMode() == key
		if SoundManager.SetMusicTrack(key) then
			SoundManager.Play("Open", wasSelected and 1 or 1.2)
			-- Choisir un morceau relance la musique si elle était coupée
			if not current.Music and ClientState.HasFeature("Lofi") then
				Settings.Apply("Music", true)
				saveSetting("Music", true)
			end
		end
	end)
	table.insert(trackRows, row)
end

local function buildMusic(content: Instance)
	local section = buildSection(content, 1, "🎧", Locale.T("Lofi music"), Locale.T("Pick your soundtrack, saved automatically"), Theme.Colors.Purple)

	buildPlayerCard(section)

	-- Interrupteur + volume (morceau en cours dans le sous-titre)
	local musicRow, musicSubtitle = buildRow(section, 2, 96, "🎵", Locale.T("Music"), Theme.Colors.Purple)
	musicInfo = musicSubtitle
	buildToggle(musicRow, "Music")
	sliders.Music = buildSlider(musicRow, SoundManager.GetMusicVolume(), Theme.Colors.Purple, function(value)
		SoundManager.SetMusicVolume(value)
	end)

	divider(section, 3)

	-- Bandeau "verrouillé" (musique pas encore débloquée : le choix est gardé)
	local banner = UIUtil.Create("Frame", {
		Name = "LockBanner",
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundColor3 = Color3.fromRGB(255, 244, 226),
		LayoutOrder = 4,
		Visible = false,
		Parent = section,
	})
	UIUtil.Corner(banner, Theme.Radius.M)
	UIUtil.Stroke(banner, Theme.Colors.Orange, 1.2, 0.4)
	UIUtil.Label({
		Text = Locale.T("🔒 Buy 🎧 %s to hear it. Your pick is kept!", Locale.T("Lofi Beats")),
		TextColor3 = Theme.Colors.Orange:Lerp(BLACK, 0.45),
		Font = Theme.Fonts.Title,
		Size = UDim2.new(1, -20, 1, -12),
		Position = UDim2.fromOffset(10, 6),
		MaxTextSize = 14,
		Parent = banner,
	})
	lockBanner = banner

	-- Liste des morceaux
	local listHeader = UIUtil.Create("Frame", {
		Name = "PlaylistHeader",
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 1,
		LayoutOrder = 5,
		Parent = section,
	})
	UIUtil.Label({
		Text = Locale.T("🎶 Playlist"),
		Font = Theme.Fonts.Title,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -16, 0, 20),
		Position = UDim2.fromOffset(8, 2),
		MaxTextSize = 17,
		Parent = listHeader,
	})
	UIUtil.Label({
		Text = Locale.T("Tap a track to play it on repeat, or shuffle them all"),
		TextColor3 = Theme.Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -16, 0, 15),
		Position = UDim2.fromOffset(8, 23),
		MaxTextSize = 13,
		Parent = listHeader,
	})

	local playlist = type(SoundManager.GetPlaylist) == "function" and SoundManager.GetPlaylist() or {}
	local shuffleHolder = UIUtil.Create("Frame", {
		Name = "ShuffleHolder",
		Size = UDim2.new(1, 0, 0, 60),
		BackgroundTransparency = 1,
		LayoutOrder = 6,
		Parent = section,
	})
	UIUtil.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 4),
		PaddingRight = UDim.new(0, 4),
		PaddingTop = UDim.new(0, 2),
		Parent = shuffleHolder,
	})
	buildTrackCard(
		shuffleHolder,
		"Shuffle",
		Locale.T("Shuffle"),
		Locale.T("All %d tracks, random order", #playlist),
		SHUFFLE_ART,
		0,
		true
	)

	local grid = UIUtil.Create("Frame", {
		Name = "Tracks",
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 7,
		Parent = section,
	})
	UIUtil.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 4),
		PaddingRight = UDim.new(0, 4),
		PaddingTop = UDim.new(0, 2),
		PaddingBottom = UDim.new(0, 2),
		Parent = grid,
	})
	UIUtil.Create("UIGridLayout", {
		CellSize = UDim2.new(0.5, -5, 0, 56),
		CellPadding = UDim2.fromOffset(10, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})
	for _, track in ipairs(playlist) do
		buildTrackCard(grid, track.Key, track.Name, Locale.T("Track %d", track.Index), artFor(track.Key, track.Index), track.Index, false)
	end
	if #playlist == 0 then
		grid.Visible = false
		shuffleHolder.Visible = false
	end
end

local function buildGame(content: Instance)
	local section = buildSection(content, 6, "🎮", Locale.T("Game"), Locale.T("Credits and version"), SECTION_GAME)

	-- Crédits et version
	local credits = UIUtil.Create("Frame", {
		Name = "Credits",
		Size = UDim2.new(1, 0, 0, 64),
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Parent = section,
	})
	local logo = UIUtil.Create("Frame", {
		Size = UDim2.fromOffset(44, 44),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 14, 0.5, 0),
		BackgroundColor3 = WHITE,
		Parent = credits,
	})
	UIUtil.Corner(logo, UDim.new(1, 0))
	UIUtil.Stroke(logo, SECTION_GAME, 1.5, 0.4)
	UIUtil.SoftGradient(logo, Theme.Colors.Pink, 90)
	UIUtil.Label({
		Text = "🧠",
		Size = UDim2.new(1, -12, 1, -12),
		Position = UDim2.fromOffset(6, 6),
		MaxTextSize = 24,
		Parent = logo,
	})
	UIUtil.Label({
		Text = "Dopamine Clicker",
		Font = Theme.Fonts.Title,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -170, 0, 20),
		Position = UDim2.fromOffset(70, 12),
		MaxTextSize = 17,
		Parent = credits,
	})
	UIUtil.Label({
		Text = Locale.T("A Roblox game  •  thanks for playing 💙"),
		TextColor3 = Theme.Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -170, 0, 16),
		Position = UDim2.fromOffset(70, 34),
		MaxTextSize = 13,
		Parent = credits,
	})
	local versionChip = UIUtil.Chip({
		Name = "Version",
		Text = Locale.T("Version %s", VERSION),
		Color = SECTION_GAME,
		TextColor3 = Theme.Colors.TextLight,
		Height = 26,
		TextSize = 13,
		Parent = credits,
	})
	versionChip.AnchorPoint = Vector2.new(1, 0.5)
	versionChip.Position = UDim2.new(1, -12, 0.5, 0)
end

function Settings.Build(panel: Frame)
	-- Contenu défilant (tout ne tient pas toujours en hauteur)
	local content = UIUtil.Create("ScrollingFrame", {
		Name = "Scroll",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = Theme.Colors.Dark,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = panel,
	})
	UIUtil.Create("UIPadding", {
		PaddingTop = UDim.new(0, 2),
		PaddingLeft = UDim.new(0, 2),
		PaddingRight = UDim.new(0, 12),
		PaddingBottom = UDim.new(0, 8),
		Parent = content,
	})
	UIUtil.Create("UIListLayout", {
		Padding = UDim.new(0, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = content,
	})

	buildAudio(content)
	buildMusic(content)
	buildDisplay(content)
	buildGraphics(content)
	buildLanguage(content)
	buildGame(content)

	UIUtil.Create("TextLabel", {
		Name = "Tip",
		Text = Locale.T("Tip: every upgrade adds something to the screen. How far will you go?"),
		TextColor3 = Theme.Colors.TextDim,
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		TextSize = 14,
		TextWrapped = true,
		Size = UDim2.new(1, 0, 0, 30),
		LayoutOrder = 10,
		Parent = content,
	})

	-- Infos musique en direct
	SoundManager.TrackChanged:Connect(refreshMusicInfo)
	SoundManager.MusicStateChanged:Connect(refreshMusicInfo)
	SoundManager.VolumeChanged:Connect(function(musicVolume: number, effectsVolume: number)
		-- (volumes changés ailleurs : on recale les curseurs)
		local music = sliders.Music
		local sound = sliders.Sound
		if music then
			music.Set(musicVolume)
		end
		if sound then
			sound.Set(effectsVolume)
		end
	end)
	ClientState.FeaturesChanged:Connect(refreshMusicInfo)
	if SoundManager.MusicChanged then
		SoundManager.MusicChanged:Connect(refreshMusicInfo)
	end
	refreshMusicInfo()
	stepPlayer(1)
end

function Settings.OnOpen()
	refreshMusicInfo()
	-- Lecteur animé seulement quand la fenêtre est ouverte
	if not equalizerConnection then
		equalizerConnection = RunService.Heartbeat:Connect(stepPlayer)
	end
	-- (v9.8) temps en ville à jour
	if graphicsControls then
		pcall(graphicsControls.Refresh)
	end
end

function Settings.OnClose()
	local connection = equalizerConnection
	if connection then
		connection:Disconnect()
		equalizerConnection = nil
	end
end

-- Au chargement, on applique les réglages sauvegardés (une seule fois) ;
-- le son du clic suit ensuite l'état du serveur (sauf pendant une sauvegarde)
local applied = false
function Settings.Update(data)
	if type(data) ~= "table" or type(data.Settings) ~= "table" then
		return
	end
	-- v9.8 🎨 réglages Graphismes sauvegardés -> qualité lue par la ville
	GraphicsQuality.SetSaved(data.Settings)
	if not applied then
		applied = true
		for _, key in ipairs({ "Sound", "Music", "Effects" }) do
			Settings.Apply(key, data.Settings[key] ~= false)
		end
	end
	-- Mode sombre : appliqué par ClientState, on recale juste l'interrupteur
	local dark = ClientState.IsUserDarkMode()
	if current.DarkMode ~= dark then
		current.DarkMode = dark
		local ui = toggles.DarkMode
		if ui then
			paintToggle(ui, dark, true)
		end
	end
	-- Langue sauvegardée (sauf pendant une sauvegarde)
	local tabs = languageTabs
	if tabs and not languageSaving then
		local saved = ClientState.GetLanguageSetting()
		if languageChosen == nil or languageChosen == saved then
			languageChosen = nil
			if tabs.GetSelected() ~= saved then
				tabs.Select(saved, true)
			end
		end
	end
	local clickSound = data.Settings.ClickSound
	if not clickSaving and type(clickSound) == "string" and clickSound ~= SoundManager.GetClickSound() then
		SoundManager.SetClickSound(clickSound)
	end
end

return Settings
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="91">
            <Properties>
              <string name="Name">Themes</string>
              <string name="Source"><![CDATA[--[[
	Themes (ModuleScript) — boutique de thèmes (fonds d'écran)
	Emplacement : ReplicatedStorage > Client > Components > Panels > Themes

	Grille de cartes (Config.Themes) avec un mini-aperçu animé de chaque
	fond (le VRAI décor du fond d'écran en miniature, Background.BuildPreview), son nom, son prix en Dopamine et/ou un bouton "💎" (Game Pass
	Robux), un badge "👑 VIP" pour les thèmes Premium, et l'état
	possédé / équipé (ClientState.Data.Themes).
	- Achat / équipement : RemoteFunction "ThemeShop" ("buy" | "equip", id).
	- Robux : MarketplaceService:PromptGamePassPurchase (le serveur vérifie
	  l'achat et débloque le thème).
	Les thèmes sont conservés pour toujours (même après l'océan).
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Client = script.Parent.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local ClientState = require(Client.ClientState)
local Effects = require(Client.Effects)
local SoundManager = require(Client.SoundManager)
local Notifications = require(script.Parent.Parent.Notifications)
local NeedDopamine = require(script.Parent.Parent.NeedDopamine)
local Background = require(script.Parent.Parent.Background)
local Config = require(ReplicatedStorage.Shared.Config)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Net = require(ReplicatedStorage.Shared.Net)
local Locale = require(ReplicatedStorage.Shared.Locale)

-- Title / Subtitle en anglais : traduits par PanelManager
local Themes = {
	Title = "🎨 Themes",
	Subtitle = "Change the game's background",
	Color = Theme.Colors.Cyan,
	Size = Vector2.new(760, 540),
}

local ROBUX_COLOR = Theme.Colors.Robux or Theme.Colors.Green
local PREMIUM_COLOR = Theme.Colors.Premium or Theme.Colors.Gold
local WHITE = Color3.new(1, 1, 1)

type Card = {
	Theme: any,
	Card: Frame,
	Stroke: UIStroke,
	Primary: TextButton,
	Robux: TextButton,
	Status: TextLabel,
	Check: Frame,
	Lock: TextLabel,
	Action: string, -- action du bouton principal : "equip" | "buy" | "vip" | "robux" | "locked" | "none"
}

local header: TextLabel
local cards: { [string]: Card } = {}
local previews: { Background.Preview } = {}
local animation: RBXScriptConnection? = nil
local busy = false

----------------------------------------------------------------------
-- Outils
----------------------------------------------------------------------

local function getThemesData(data): ({ [string]: boolean }, string)
	local themes = data and data.Themes
	local owned = (type(themes) == "table" and themes.Owned) or { Classic = true }
	local equipped = (type(themes) == "table" and themes.Equipped) or "Classic"
	return owned, equipped
end

local function getDopamine(): number
	local ok, value = pcall(ClientState.GetConfirmedDopamine)
	if ok and type(value) == "number" then
		return value
	end
	local data = ClientState.Data
	return (data and data.Dopamine) or 0
end

local function vipPassId(): number
	local pass = Config.GamePassesById and Config.GamePassesById.VIP
	return (pass and tonumber(pass.GamePassId)) or 0
end

-- Petite étiquette arrondie (ex. "👑 VIP")
local function chip(parent: Instance, text: string, color: Color3, props: { [string]: any }): Frame
	local frame = UIUtil.Create("Frame", {
		Name = props.Name or "Chip",
		Size = UDim2.fromOffset(0, 20),
		AutomaticSize = Enum.AutomaticSize.X,
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		Position = props.Position or UDim2.new(),
		BackgroundColor3 = color,
		ZIndex = 4,
		Parent = parent,
	})
	UIUtil.Corner(frame, UDim.new(1, 0))
	UIUtil.Stroke(frame, Theme.Colors.Border, 1, 0.5)
	UIUtil.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 7),
		PaddingRight = UDim.new(0, 7),
		Parent = frame,
	})
	UIUtil.Create("TextLabel", {
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = text,
		TextColor3 = Theme.ContrastText(color),
		TextSize = 12,
		ZIndex = 5,
		Parent = frame,
	})
	return frame
end

----------------------------------------------------------------------
-- Mini-aperçu du fond : le vrai décor animé, en miniature
----------------------------------------------------------------------

local function buildPreviewDecor(preview: GuiObject, theme)
	local ok, result = pcall(Background.BuildPreview, preview, theme.Id)
	if ok then
		table.insert(previews, result)
	else
		warn("[Themes] Aperçu impossible pour " .. tostring(theme.Id) .. " : " .. tostring(result))
	end

	-- Voile doux derrière le bouton (lisibilité)
	local veil = UIUtil.Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.46),
		Size = UDim2.fromOffset(120, 56),
		BackgroundColor3 = theme.Dark and Color3.new(0, 0, 0) or WHITE,
		BackgroundTransparency = 0.55,
		BorderSizePixel = 0,
		ZIndex = 4,
		Parent = preview,
	})
	UIUtil.Corner(veil, UDim.new(1, 0))
	UIUtil.Create("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.3, 0.4),
			NumberSequenceKeypoint.new(0.7, 0.4),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = veil,
	})

	-- Mini bouton "Clique-moi" (montre la lisibilité du thème)
	local dark = theme.Dark == true
	local mini = UIUtil.Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(66, 22),
		BackgroundColor3 = dark and Theme.DarkColors.Card or WHITE,
		BackgroundTransparency = dark and 0.2 or 0,
		ZIndex = 5,
		Parent = preview,
	})
	UIUtil.Corner(mini, 7)
	UIUtil.Stroke(mini, dark and WHITE or Theme.Colors.Border, 1, dark and 0.5 or 0.2)
	if not dark then
		UIUtil.Gradient(mini, ColorSequence.new(Theme.Colors.Button, Theme.Colors.ButtonBottom), 90)
	end
	UIUtil.Create("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		Text = Locale.T("Click me"),
		TextColor3 = dark and WHITE or Theme.Colors.Text,
		TextSize = 11,
		ZIndex = 6,
		Parent = mini,
	})
	UIUtil.Create("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.42, 13),
		Size = UDim2.fromOffset(90, 14),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = "123 " .. Locale.T("Dopamine"),
		TextColor3 = dark and WHITE or Theme.Colors.Text,
		TextSize = 11,
		ZIndex = 5,
		Parent = preview,
	})
end

----------------------------------------------------------------------
-- Actions
----------------------------------------------------------------------

local function popCard(card: Card)
	local scale = card.Card:FindFirstChild("PopScale") :: UIScale?
	if scale then
		scale.Scale = 1.07
		UIUtil.Tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	end
end

local function invoke(action: string, themeId: string): (boolean, string?)
	local ok, success, message = pcall(function()
		return Net.Function("ThemeShop"):InvokeServer(action, themeId)
	end)
	if not ok then
		return false, Locale.T("Network error, try again.")
	end
	return success == true, message and tostring(message) or nil
end

local function request(action: string, theme)
	if busy then
		return
	end
	busy = true
	local ok, message = invoke(action, theme.Id)
	local card = cards[theme.Id]
	if ok and action == "buy" then
		-- Acheté : on l'équipe tout de suite
		SoundManager.Play("Buy", 1.1)
		Effects.Confetti(50)
		Notifications.Toast(Locale.T("%s: yours forever!", theme.Icon .. " " .. Locale.T(theme.Name)), Theme.Colors.Green, 4, Locale.T("New theme"))
		-- (le serveur l'équipe automatiquement après l'achat)
	elseif ok then
		SoundManager.Play("Open", 1.25)
		Notifications.Toast(Locale.T("🎨 Theme equipped: %s", theme.Icon .. " " .. Locale.T(theme.Name)), Theme.Colors.Cyan, 2.5)
	else
		SoundManager.Play("Error", 0.7)
		-- Refus "pas assez de Dopamine" du serveur : on propose d'en avoir (vrai manque)
		local context = { Icon = theme.Icon, Name = Locale.T(theme.Name) }
		if not (action == "buy" and NeedDopamine.OfferRefusal(message, tonumber(theme.Cost), nil, context)) then
			Notifications.Toast(message or Locale.T("Not possible right now."), Theme.Colors.Red)
		end
		if card then
			UIUtil.Shake(card.Primary)
		end
	end
	busy = false
	if ok and card then
		popCard(card)
	end
end

-- Ouvre la fenêtre d'achat Roblox d'un Game Pass
local function promptPass(passId: number, what: string)
	if passId == 0 then
		SoundManager.Play("Error", 0.7)
		if RunService:IsStudio() then
			Notifications.Toast(Locale.T("Add the Game Pass ID in Config (%s)", what), Theme.Colors.Orange, 4)
		else
			Notifications.Toast(Locale.T("Coming soon!"), Theme.Colors.Orange)
		end
		return
	end
	local ok, err = pcall(function()
		MarketplaceService:PromptGamePassPurchase(Players.LocalPlayer, passId)
	end)
	if not ok then
		warn("[Themes] PromptGamePassPurchase : " .. tostring(err))
		Notifications.Toast(Locale.T("The Roblox store isn't responding, try again."), Theme.Colors.Red)
	end
end

local function onPrimary(card: Card)
	local theme = card.Theme
	local action = card.Action
	if action == "equip" then
		task.spawn(request, "equip", theme)
	elseif action == "buy" then
		-- Trop cher (calculé à l'instant) : "Pas assez de Dopamine" à CHAQUE clic
		local missing = (tonumber(theme.Cost) or 0) - getDopamine()
		if missing > 0 then
			SoundManager.Play("Error", 0.7)
			UIUtil.Shake(card.Primary)
			NeedDopamine.Offer(missing, function()
				Notifications.Toast(Locale.T("You need %s more Dopamine", NumberFormatter.Format(missing)), Theme.Colors.Red)
			end, { Icon = theme.Icon, Name = Locale.T(theme.Name) })
			return
		end
		task.spawn(request, "buy", theme)
	elseif action == "vip" then
		promptPass(vipPassId(), "Monetization.GamePasses VIP")
	elseif action == "robux" then
		promptPass(tonumber(theme.GamePassId) or 0, "Themes." .. theme.Id .. ".GamePassId")
	elseif action == "locked" then
		-- v9.3 : thème réservé aux visites à l'océan (le serveur refuse aussi)
		SoundManager.Play("Error", 0.7)
		UIUtil.Shake(card.Primary)
		local required = tonumber(theme.RequiresRebirths) or 0
		Notifications.Toast(required == 1 and Locale.T("🔒 after 1 ocean visit") or Locale.T("🔒 after %d ocean visits", required), Theme.Colors.Purple)
	else
		popCard(card) -- déjà équipé
	end
end

----------------------------------------------------------------------
-- Construction
----------------------------------------------------------------------

local function buildCard(list: ScrollingFrame, theme)
	-- Support transparent (dans la grille) : porte la carte et son ombre
	local cell = UIUtil.Create("Frame", {
		Name = theme.Id,
		BackgroundTransparency = 1,
		LayoutOrder = theme.Order or 0,
		Parent = list,
	})
	local card = UIUtil.Create("Frame", {
		Name = "Card",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Colors.Card,
		ZIndex = 2,
		Parent = cell,
	})
	UIUtil.Corner(card, 16)
	local stroke = UIUtil.Stroke(card, Theme.Colors.CardBorder, 1.5, 0.15)
	UIUtil.Create("UIScale", { Name = "PopScale", Parent = card })
	pcall(UIUtil.Shadow, card, 4, 0.82)

	-- Aperçu (CanvasGroup : le décor est coupé aux coins arrondis)
	local preview = UIUtil.Create("CanvasGroup", {
		Name = "Preview",
		Position = UDim2.fromOffset(8, 8),
		Size = UDim2.new(1, -16, 0, 104),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = card,
	})
	-- L'aperçu montre les vraies couleurs du thème (pas d'habillage sombre)
	preview:SetAttribute("DarkSkinIgnore", true)
	UIUtil.Corner(preview, 11)
	UIUtil.Stroke(preview, Theme.Colors.Border, 1, 0.75)
	-- (un UIGradient directement sur le CanvasGroup teinterait tout son contenu)
	local sky = UIUtil.Create("Frame", {
		Name = "Sky",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 1,
		Parent = preview,
	})
	UIUtil.Gradient(sky, ColorSequence.new(theme.Top, theme.Bottom), 90)
	buildPreviewDecor(preview, theme)

	if theme.Premium then
		chip(preview, "👑 VIP", PREMIUM_COLOR, { Position = UDim2.fromOffset(6, 6) })
	end
	local check = UIUtil.Create("Frame", {
		Name = "Check",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -6, 0, 6),
		Size = UDim2.fromOffset(22, 22),
		BackgroundColor3 = Theme.Colors.Green,
		Visible = false,
		ZIndex = 6,
		Parent = preview,
	})
	UIUtil.Corner(check, UDim.new(1, 0))
	UIUtil.Stroke(check, WHITE, 2)
	UIUtil.Icon("Check", { Size = 14, Thickness = 3, Color = WHITE, ZIndex = 7, Parent = check })
	local lock = UIUtil.Create("TextLabel", {
		Name = "Lock",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -4, 1, -2),
		Size = UDim2.fromOffset(22, 22),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		Text = "🔒",
		TextSize = 14,
		ZIndex = 6,
		Parent = preview,
	})

	-- Nom + statut
	UIUtil.Create("TextLabel", {
		Name = "Name",
		Position = UDim2.fromOffset(10, 118),
		Size = UDim2.new(1, -20, 0, 20),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = theme.Icon .. " " .. Locale.T(theme.Name),
		TextColor3 = Theme.Colors.Text,
		TextSize = 16,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 2,
		Parent = card,
	})
	local status = UIUtil.Create("TextLabel", {
		Name = "Status",
		Position = UDim2.fromOffset(10, 138),
		Size = UDim2.new(1, -20, 0, 16),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		Text = "",
		TextColor3 = Theme.Colors.TextDim,
		TextSize = 13,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 2,
		Parent = card,
	})

	-- Boutons : action principale + "💎" (Game Pass du thème)
	local primary = UIUtil.NeonButton({
		Name = "Primary",
		Text = "",
		Size = UDim2.new(1, -16, 0, 34),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 8, 1, -8),
		Color = Theme.Colors.Green,
		CornerRadius = 17,
		MaxTextSize = 15,
		ZIndex = 2,
		Parent = card,
	})
	local robux = UIUtil.NeonButton({
		Name = "Robux",
		Text = "💎",
		Size = UDim2.fromOffset(40, 34),
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -8, 1, -8),
		Color = ROBUX_COLOR,
		CornerRadius = 17,
		MaxTextSize = 17,
		ZIndex = 2,
		Parent = card,
	})
	robux.Visible = false

	local entry: Card = {
		Theme = theme,
		Card = card,
		Stroke = stroke,
		Primary = primary,
		Robux = robux,
		Status = status,
		Check = check,
		Lock = lock,
		Action = "none",
	}
	cards[theme.Id] = entry

	primary.Activated:Connect(function()
		onPrimary(entry)
	end)
	robux.Activated:Connect(function()
		promptPass(tonumber(theme.GamePassId) or 0, "Themes." .. theme.Id .. ".GamePassId")
	end)

	-- Survol : la carte se soulève un peu
	card.MouseEnter:Connect(function()
		UIUtil.Tween(card, 0.15, { Position = UDim2.fromOffset(0, -3) })
	end)
	card.MouseLeave:Connect(function()
		UIUtil.Tween(card, 0.15, { Position = UDim2.fromOffset(0, 0) })
	end)
end

-- Progression / prix qui bougent avec la Dopamine : rafraîchi aussi entre deux états complets
Themes.RefreshOnTick = true

function Themes.Build(content: Frame)
	header = UIUtil.Create("TextLabel", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 24),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		Text = "",
		TextColor3 = Theme.Colors.TextDim,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = content,
	})

	local list = UIUtil.Create("ScrollingFrame", {
		Name = "List",
		Size = UDim2.new(1, 0, 1, -30),
		Position = UDim2.fromOffset(0, 30),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Colors.Cyan,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = content,
	})
	UIUtil.Create("UIPadding", {
		PaddingTop = UDim.new(0, 6),
		PaddingLeft = UDim.new(0, 4),
		PaddingRight = UDim.new(0, 12),
		PaddingBottom = UDim.new(0, 10),
		Parent = list,
	})
	UIUtil.Create("UIGridLayout", {
		CellSize = UDim2.new(0.25, -9, 0, 214),
		CellPadding = UDim2.fromOffset(12, 14),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = list,
	})

	for _, theme in ipairs(Config.Themes) do
		buildCard(list, theme)
	end

	-- Achat Robux terminé (le serveur vérifie et débloque le thème)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if player ~= Players.LocalPlayer or not purchased then
			return
		end
		for _, theme in ipairs(Config.Themes) do
			if theme.GamePassId ~= 0 and theme.GamePassId == passId then
				SoundManager.Play("Buy", 1.1)
				Effects.Confetti(60)
				Notifications.Toast(
					Locale.T("%s unlocked, thank you!", theme.Icon .. " " .. Locale.T(theme.Name)),
					ROBUX_COLOR,
					4,
					Locale.T("💎 Purchase successful")
				)
				return
			end
		end
	end)
end

function Themes.Update(data)
	local owned, equipped = getThemesData(data)
	local dopamine = getDopamine()
	local isVIP = data and data.IsVIP == true
	local rebirths = (data and tonumber(data.Rebirths)) or 0
	local ownedCount = 0

	for id, card in pairs(cards) do
		local theme = card.Theme
		local cost = tonumber(theme.Cost)
		local passId = tonumber(theme.GamePassId) or 0
		local isOwned = owned[id] == true
		local isEquipped = isOwned and equipped == id
		if isOwned then
			ownedCount += 1
		end

		local primary = card.Primary
		local showRobux = false
		card.Check.Visible = isEquipped
		card.Lock.Visible = not isOwned

		if isEquipped then
			card.Action = "none"
			primary.Text = Locale.T("✅ Equipped")
			primary:SetAttribute("BaseColor", Theme.Colors.ButtonBottom)
			UIUtil.SetButtonEnabled(primary, true)
			primary.TextColor3 = Theme.Colors.Text
			card.Status.Text = Locale.T("Your current background")
			card.Status.TextColor3 = Theme.Colors.Green
			card.Stroke.Color = Theme.Colors.Green
			card.Stroke.Thickness = 3
			card.Stroke.Transparency = 0
		elseif isOwned then
			card.Action = "equip"
			primary.Text = Locale.T("Equip")
			primary:SetAttribute("BaseColor", Theme.Colors.Blue)
			UIUtil.SetButtonEnabled(primary, true)
			primary.TextColor3 = Theme.Colors.TextLight
			card.Status.Text = (theme.Premium and isVIP) and Locale.T("👑 Included with VIP") or Locale.T("✅ Owned")
			card.Status.TextColor3 = Theme.Colors.TextDim
			card.Stroke.Color = Theme.Colors.CardBorder
			card.Stroke.Thickness = 1.5
			card.Stroke.Transparency = 0.15
		else
			card.Stroke.Color = Theme.Colors.CardBorder
			card.Stroke.Thickness = 1.5
			card.Stroke.Transparency = 0.15
			local required = tonumber(theme.RequiresRebirths) or 0
			if required > rebirths then
				-- v9.3 : débloqué par les visites à l'océan (grisé, non achetable)
				card.Action = "locked"
				primary.Text = required == 1 and Locale.T("🔒 after 1 ocean visit") or Locale.T("🔒 after %d ocean visits", required)
				primary:SetAttribute("BaseColor", Color3.fromRGB(214, 232, 244))
				UIUtil.SetButtonEnabled(primary, false)
				primary.TextColor3 = Theme.Colors.Text
				primary.TextTransparency = 0.1
				card.Status.Text = Locale.T("🌊 Ocean reward")
				card.Status.TextColor3 = Theme.Colors.TextDim
			elseif cost then
				-- Achetable en Dopamine (et peut-être aussi en Robux)
				local affordable = dopamine >= cost
				card.Action = "buy"
				primary.Text = cost <= 0 and Locale.T("Free") or ("💧 " .. NumberFormatter.Format(cost))
				primary:SetAttribute("BaseColor", Theme.Colors.Green)
				UIUtil.SetButtonEnabled(primary, affordable)
				primary.TextColor3 = Theme.Colors.TextDark
				showRobux = passId ~= 0
				if theme.Premium then
					card.Status.Text = Locale.T("Or free with the VIP pass")
				elseif showRobux then
					card.Status.Text = Locale.T("Dopamine or 💎 Robux")
				else
					card.Status.Text = affordable and Locale.T("You can afford it!") or Locale.T("Not enough Dopamine yet")
				end
				card.Status.TextColor3 = affordable and Theme.Colors.TextDim or Theme.Colors.Red
			elseif passId ~= 0 then
				-- Uniquement en Robux (Game Pass du thème)
				card.Action = "robux"
				primary.Text = "💎 Robux"
				primary:SetAttribute("BaseColor", ROBUX_COLOR)
				UIUtil.SetButtonEnabled(primary, true)
				primary.TextColor3 = Theme.Colors.TextLight
				card.Status.Text = theme.Premium and Locale.T("Robux or VIP pass") or Locale.T("Robux exclusive")
				card.Status.TextColor3 = Theme.Colors.TextDim
			elseif theme.Premium then
				-- Uniquement avec le pass VIP
				card.Action = "vip"
				primary.Text = Locale.T("👑 VIP Pass")
				primary:SetAttribute("BaseColor", PREMIUM_COLOR)
				UIUtil.SetButtonEnabled(primary, true)
				primary.TextColor3 = Theme.Colors.TextDark
				card.Status.Text = Locale.T("VIP exclusive")
				card.Status.TextColor3 = Theme.Colors.TextDim
			else
				card.Action = "none"
				primary.Text = Locale.T("Soon")
				primary:SetAttribute("BaseColor", Theme.Colors.Disabled)
				UIUtil.SetButtonEnabled(primary, false)
				card.Status.Text = Locale.T("Not on sale yet")
				card.Status.TextColor3 = Theme.Colors.TextDim
			end
		end

		card.Robux.Visible = showRobux
		primary.Size = showRobux and UDim2.new(1, -62, 0, 34) or UDim2.new(1, -16, 0, 34)
	end

	header.Text = Locale.T(
		"%d / %d themes unlocked  •  kept forever, even after the ocean 🌊%s",
		ownedCount,
		#Config.Themes,
		isVIP and "  •  👑 VIP" or ""
	)
end

-- Animation des aperçus seulement quand la fenêtre est ouverte
function Themes.OnOpen()
	if animation then
		return
	end
	animation = RunService.Heartbeat:Connect(function(dt: number)
		for _, preview in ipairs(previews) do
			preview.Update(dt)
		end
	end)
end

function Themes.OnClose()
	local connection = animation
	if connection then
		connection:Disconnect()
		animation = nil
	end
end

return Themes
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="92">
          <Properties>
            <string name="Name">UpgradeBar</string>
            <string name="Source"><![CDATA[--[[
	UpgradeBar (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > UpgradeBar

	La rangée de cartes d'amélioration sous le compteur (Formulas.GetVisibleUpgrades).
	v8 — cartes "boutique" lisibles d'un coup d'œil :
	  - plaque d'icône colorée (couleur de l'amélioration) avec reflet ;
	  - pastille de niveau sur la plaque + fine barre de progression
	    niveau / niveau max ;
	  - pastille de PRIX en bas : verte quand on peut payer, sinon grise avec
	    une jauge qui se remplit à mesure que la Dopamine monte (on voit
	    combien il reste avant de pouvoir acheter) ;
	  - achat : la carte s'écrase puis rebondit, reflet qui balaie la carte,
	    plaque qui saute, "Nv 4" qui s'envole, étincelles de sa couleur ;
	  - carte "🔒 teaser" (v9 : vraie carte "océan" — mer en dégradé, vagues,
	    hublot + cadenas + "+N", aperçu des icônes) ÉPINGLÉE au bout de la
	    rangée, hors du défilement (toujours visible, jamais coupée), quand de
	    nouvelles améliorations arrivent après la prochaine visite à l'océan
	    (Formulas.GetNextRebirthUnlocks) ; clic = la rangée montre la carte
	    "Aller à l'océan" ;
	  - v9 : carte abordable = anneau vert + halo ; trop chère = contour doux
	    et plaque estompée ; niveau presque au max = barre dorée ; niveau max
	    atteint = la carte brille en or avec "MAX ✓" avant de partir ;
	  - infobulle : nom, niveau, description, amélioration requise
	    (Requires), prix + ce qu'il manque ;
	  - PC : survol = infobulle, clic = achat ; tactile : 1er appui =
	    infobulle avec "Acheter", 2e appui = achat ; "Aller à l'océan"
	    demande toujours une confirmation ;
	  - carte trop chère (PC ET tactile, "Aller à l'océan" compris) :
	    NeedDopamine.Offer à CHAQUE clic ; refus du serveur ("pas assez de
	    Dopamine" alors que le client croyait pouvoir payer) :
	    NeedDopamine.OfferRefusal avec le vrai manque.
	L'état "abordable" suit ClientState.Changed ET ClientState.DopamineChanged
	(s'il existe), limité à 4 mises à jour par seconde (+ filet de sécurité
	lent pour les clics prédits).
	Les cartes sont dessinées en 100 x 100 puis mises à l'échelle (UIScale) :
	plus petites sur téléphone, rangée limitée à la place entre les slots.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Client = script.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local Interface = require(Client.Interface)
local ClientState = require(Client.ClientState)
local Effects = require(Client.Effects)
local SoundManager = require(Client.SoundManager)
local Notifications = require(script.Parent.Notifications)
local NeedDopamine = require(script.Parent.NeedDopamine)
local PanelManager = require(script.Parent.PanelManager)
local Slots = require(Client.Slots)
local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Net = require(ReplicatedStorage.Shared.Net)
local Locale = require(ReplicatedStorage.Shared.Locale)

local UpgradeBar = {}

local DESIGN = 100 -- taille "design" d'une carte (mise à l'échelle ensuite)
local TEASER_WIDTH = 184 -- largeur "design" de la carte teaser (texte + icônes)
local TEASER_COMPACT_WIDTH = 116 -- teaser compact (rangée étroite : téléphone serré)
local TEASER_COMPACT_BELOW = 520 -- (px) rangée plus étroite : teaser compact
local TEASER_MAX_PEEK = 5 -- icônes des nouveautés montrées (large)
local TEASER_COMPACT_PEEK = 3
local MAX_WIDTH = 660 -- largeur max de la rangée (au-delà : défilement horizontal)
local GAP = 12
local CARD_SIZE = 100
local MIN_CARD_SIZE = 80
local PHONE_CARD_SIZE = 84 -- téléphone : cartes un peu plus petites (la toile est déjà agrandie)
local PHONE_MIN_CARD_SIZE = 72
local PAD_TOP = 8
local PAD_SIDE = 8
local REFRESH_INTERVAL = 0.25 -- (s) au plus 4 mises à jour "abordable" par seconde
local SAFETY_INTERVAL = 1 -- (s) filet de sécurité (clics prédits sans nouvel état)
UpgradeBar.Height = CARD_SIZE + PAD_TOP + 8

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local PRICE_OK = Color3.fromRGB(70, 222, 110)
local PRICE_TRACK = Color3.fromRGB(236, 236, 240)
local PRICE_FILL = Color3.fromRGB(150, 225, 170)
local OCEAN = Color3.fromRGB(0, 140, 200)
local AFFORD_EDGE = Color3.fromRGB(34, 197, 94) -- anneau "tu peux l'acheter"
local AFFORD_GLOW = Color3.fromRGB(74, 222, 128)
local CARD_EDGE = Color3.fromRGB(198, 202, 214) -- contour doux (trop cher)
local MAX_GOLD = Color3.fromRGB(255, 190, 20)

-- Mesures selon l'appareil : (taille de carte, taille min, largeur max de la rangée)
local function metrics(): (number, number, number)
	if Interface.IsPhone() then
		local clear = Slots.GetCenterClearWidth() - PAD_SIDE * 2
		return PHONE_CARD_SIZE, PHONE_MIN_CARD_SIZE, math.clamp(clear, 340, MAX_WIDTH)
	end
	return CARD_SIZE, MIN_CARD_SIZE, MAX_WIDTH
end

-- Traduction des textes de Config (anglais -> langue du joueur)
local function translate(text: string): string
	return Locale.T(text)
end

type Card = {
	Upgrade: any,
	Holder: Frame,
	Fit: UIScale,
	Button: TextButton,
	Stroke: UIStroke,
	Gradient: UIGradient,
	Plate: Frame,
	PlateScale: UIScale,
	Icon: TextLabel,
	LevelChip: Frame,
	LevelText: TextLabel,
	LevelTrack: Frame,
	LevelFill: Frame,
	Price: Frame,
	PriceFill: Frame,
	PriceText: TextLabel,
	PriceStroke: UIStroke,
	Shine: UIGradient,
	PopScale: UIScale,
	HD: Frame,
	Rays: Frame,
	Glow: Frame,
	Level: number,
	Affordable: boolean?,
	Removing: boolean,
}

local bar: Frame
local scroll: ScrollingFrame
local cards: { [string]: Card } = {}
local random = Random.new()

-- Rangée (cartes qui défilent + teaser épinglé au bout)
local row: Frame

-- Carte "teaser" (améliorations verrouillées jusqu'à la prochaine visite à l'océan)
local teaser: Frame
local teaserFitFrame: Frame
local teaserFit: UIScale
local teaserButton: TextButton
local teaserTitle: TextLabel
local teaserText: TextLabel
local teaserPlate: Frame
local teaserBadge: TextLabel
local teaserPeek: Frame
local teaserPeekSlots: { Frame } = {}
local teaserWaves: { Frame } = {}
local teaserBubbles: { Frame } = {}
local teaserGate: number? = nil
local teaserCount = 0
local teaserCompact = false
local teaserDesignWidth = TEASER_WIDTH

-- Infobulle
local tooltip: TextButton
local tipName: TextLabel
local tipLevel: TextLabel
local tipDesc: TextLabel
local tipNeeds: TextLabel
local tipCost: TextLabel
local tipMissing: TextLabel
local tipButton: TextButton
local tipAccent: Frame -- liseré de couleur en haut (couleur de l'amélioration)
local tipBar: Frame -- jauge "presque abordable"
local tipBarFill: Frame
local tipUpgradeId: string? = nil -- Id de la carte, ou "__teaser"
local tipPinned = false -- vrai si ouverte par appui (tactile) ou confirmation
local TEASER_ID = "__teaser"

-- Entrées
local lastInputTouch = UserInputService.TouchEnabled and not UserInputService.MouseEnabled
local lastUiTapClock = 0
local hdEnabled = false
local darkMode = false

-- Mises à jour "abordable" (limitées)
local lastAffordRefresh = 0
local affordScheduled = false

----------------------------------------------------------------------
-- Utilitaires
----------------------------------------------------------------------

local function formatAmount(value: number): string
	if value >= 1e6 then
		return NumberFormatter.Format(value)
	elseif value < 10 and value % 1 ~= 0 then
		return NumberFormatter.Format(value)
	end
	return NumberFormatter.WithSpaces(value)
end

local function getRebirths(): number
	local data = ClientState.Data
	return (data and data.Rebirths) or 0
end

local function getCost(upgrade): number
	return Formulas.GetUpgradeCost(upgrade, ClientState.GetLevel(upgrade.Id), getRebirths())
end

local function getDopamine(): number
	return ClientState.GetConfirmedDopamine()
end

local function canAfford(upgrade): boolean
	return getDopamine() >= getCost(upgrade) - 1e-6
end

local function isRepeatable(upgrade): boolean
	return upgrade.MaxLevel ~= 1
end

local function upgradeColor(upgrade): Color3
	if upgrade.Effect == "Detox" then
		return OCEAN
	end
	return upgrade.Color or Theme.Colors.Blue
end

----------------------------------------------------------------------
-- Infobulle
----------------------------------------------------------------------

local function hideTooltip()
	tipUpgradeId = nil
	tipPinned = false
	if tooltip then
		tooltip.Visible = false
	end
end

-- Place l'infobulle sous `target` (en coordonnées de son calque : sur
-- téléphone, le calque Panels commence Interface.SafeTop sous la toile)
local function placeTooltip(target: GuiObject)
	local topLeft = Interface.ScreenToCanvas(target.AbsolutePosition) - Vector2.new(0, Interface.SafeTop or 0)
	local size = target.AbsoluteSize / Interface.Scale
	local canvas = Interface.CanvasSize
	local halfWidth = tooltip.AbsoluteSize.X / Interface.Scale / 2
	if halfWidth <= 0 then
		halfWidth = 150
	end
	local x = math.clamp(topLeft.X + size.X / 2, halfWidth + 8, canvas.X - halfWidth - 8)
	tooltip.Position = UDim2.fromOffset(x, topLeft.Y + size.Y + 10)
end

local function refreshTeaserTooltip()
	if not teaserGate or not teaser.Visible then
		hideTooltip()
		return
	end
	local names = {}
	for _, upgrade in ipairs(Config.Upgrades) do
		if (upgrade.RequiresRebirths or 0) == teaserGate then
			table.insert(names, upgrade.Icon .. " " .. Locale.T(upgrade.Name))
		end
	end
	tipName.Text = Locale.T("🔒 Coming after the ocean")
	tipAccent.BackgroundColor3 = OCEAN
	tipBar.Visible = false
	tipLevel.Visible = true
	tipLevel.Text = Locale.T("Unlocks at %d ocean visits (you: %d)", teaserGate, getRebirths())
	tipDesc.Text = table.concat(names, "\n")
	tipNeeds.Visible = false
	tipCost.Text = Locale.T("🌊 Go to the ocean to unlock them")
	tipCost.TextColor3 = OCEAN
	tipMissing.Visible = false
	tipButton.Visible = false
	placeTooltip(teaserButton)
end

local function refreshTooltip()
	local id = tipUpgradeId
	if not id then
		return
	end
	if id == TEASER_ID then
		refreshTeaserTooltip()
		return
	end
	local card = cards[id]
	if not card or card.Removing or not card.Holder.Parent then
		hideTooltip()
		return
	end
	local upgrade = card.Upgrade
	local level = ClientState.GetLevel(upgrade.Id)
	local cost = getCost(upgrade)
	local dopamine = getDopamine()
	local affordable = dopamine >= cost - 1e-6

	tipName.Text = upgrade.Icon .. "  " .. Locale.T(upgrade.Name)
	tipAccent.BackgroundColor3 = upgradeColor(upgrade)
	tipDesc.Text = Formulas.DescribeUpgrade(upgrade, NumberFormatter.Format, getRebirths(), translate)
	if upgrade.Effect == "Detox" then
		local rebirths = getRebirths()
		tipLevel.Visible = rebirths > 0
		tipLevel.Text = Locale.T("Ocean visits: %s", tostring(rebirths))
	elseif isRepeatable(upgrade) then
		tipLevel.Visible = true
		tipLevel.Text = upgrade.MaxLevel and Locale.T("Level %d / %d", level, upgrade.MaxLevel) or Locale.T("Level %d", level)
	else
		tipLevel.Visible = true
		tipLevel.Text = Locale.T("One-time purchase")
	end
	-- Amélioration "d'un carré" (Requires) : on rappelle ce qu'elle améliore
	local required = upgrade.Requires and Config.UpgradesById and Config.UpgradesById[upgrade.Requires]
	if not required and upgrade.Requires then
		for _, other in ipairs(Config.Upgrades) do
			if other.Id == upgrade.Requires then
				required = other
				break
			end
		end
	end
	tipNeeds.Visible = required ~= nil
	if required then
		tipNeeds.Text = Locale.T("Upgrades: %s", required.Icon .. " " .. Locale.T(required.Name))
	end
	tipCost.Text = Locale.T("Cost: %s Dopamine", formatAmount(cost))
	tipCost.TextColor3 = affordable and Theme.Colors.RobuxDark or Theme.Colors.Red
	tipMissing.Visible = not affordable
	tipBar.Visible = not affordable
	if not affordable then
		local ratio = cost > 0 and math.clamp(dopamine / cost, 0, 0.99) or 0
		local percent = math.floor(ratio * 100)
		tipMissing.Text = Locale.T("%d%% there • %s missing", percent, NumberFormatter.Format(cost - dopamine))
		tipBarFill.Size = UDim2.fromScale(math.max(ratio, 0.03), 1)
	end

	local needsButton = tipPinned
	tipButton.Visible = needsButton
	if needsButton then
		if upgrade.Effect == "Detox" then
			tipButton.Text = Locale.T("🌊 Let's go")
		elseif affordable then
			tipButton.Text = Locale.T("Buy")
		else
			tipButton.Text = Locale.T("💎 Get Dopamine")
		end
		-- (trop cher : le bouton reste actif et propose la boutique Dopamine)
		tipButton:SetAttribute("BaseColor", affordable and Theme.Colors.Green or Theme.Colors.Robux)
		UIUtil.SetButtonEnabled(tipButton, true)
		tipButton.TextColor3 = affordable and Theme.Colors.TextDark or Theme.Colors.TextLight
	end
	placeTooltip(card.Button)
end

local function showTooltip(upgradeId: string, pinned: boolean)
	local changed = tipUpgradeId ~= upgradeId
	tipUpgradeId = upgradeId
	tipPinned = pinned
	tooltip.Visible = true
	refreshTooltip()
	if changed then
		local scale = tooltip:FindFirstChildOfClass("UIScale")
		if scale then
			scale.Scale = 0.85
			UIUtil.Tween(scale, 0.15, { Scale = 1 }, Enum.EasingStyle.Back)
		end
	end
end

local function buildTooltip(layer: Frame)
	-- TextButton (sans texte) : un appui DANS l'infobulle ne traverse pas vers les
	-- stimuli en dessous et ne la ferme pas
	tooltip = UIUtil.Create("TextButton", {
		Name = "UpgradeTooltip",
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromOffset(290, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Theme.Colors.Card,
		Visible = false,
		ZIndex = 5,
		Parent = layer,
	})
	UIUtil.Corner(tooltip, 16)
	-- v9 : contour doux + léger dégradé (plus de contour noir)
	UIUtil.Stroke(tooltip, CARD_EDGE, 1.5, 0)
	UIUtil.Gradient(tooltip, ColorSequence.new(WHITE, Color3.fromRGB(244, 245, 249)), 90)
	UIUtil.Create("UIScale", { Parent = tooltip })
	UIUtil.Shadow(tooltip, 5, 0.8, 3)
	UIUtil.Create("UIPadding", {
		PaddingTop = UDim.new(0, 10),
		PaddingBottom = UDim.new(0, 12),
		PaddingLeft = UDim.new(0, 14),
		PaddingRight = UDim.new(0, 14),
		Parent = tooltip,
	})
	UIUtil.Create("UIListLayout", {
		Padding = UDim.new(0, 4),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = tooltip,
	})

	local function textLine(name: string, lineOrder: number, font: Enum.Font, textSize: number, color: Color3): TextLabel
		local line = UIUtil.Create("TextLabel", {
			Name = name,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			Font = font,
			TextSize = textSize,
			TextColor3 = color,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Text = "",
			LayoutOrder = lineOrder,
			ZIndex = 6,
			Parent = tooltip,
		})
		line:SetAttribute("BaseTextSize", textSize)
		return line
	end

	-- Liseré de la couleur de l'amélioration
	tipAccent = UIUtil.Create("Frame", {
		Name = "Accent",
		Size = UDim2.new(1, 0, 0, 4),
		BackgroundColor3 = Theme.Colors.Blue,
		BorderSizePixel = 0,
		LayoutOrder = 0,
		ZIndex = 6,
		Parent = tooltip,
	})
	UIUtil.Corner(tipAccent, UDim.new(1, 0))
	tipName = textLine("Name", 1, Theme.Fonts.Title, 21, Theme.Colors.Text)
	tipLevel = textLine("Level", 2, Theme.Fonts.Title, 14, Theme.Colors.Purple)
	tipDesc = textLine("Description", 3, Theme.Fonts.Body, 16, Theme.Colors.TextDim)
	tipNeeds = textLine("Needs", 4, Theme.Fonts.Body, 14, Theme.Colors.TextDim)
	-- Fine ligne de séparation avant le prix
	UIUtil.Create("Frame", {
		Name = "Divider",
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = Theme.Colors.Divider,
		BorderSizePixel = 0,
		LayoutOrder = 5,
		ZIndex = 6,
		Parent = tooltip,
	})
	tipCost = textLine("Cost", 6, Theme.Fonts.Title, 17, Theme.Colors.Text)
	tipMissing = textLine("Missing", 7, Theme.Fonts.Body, 14, Theme.Colors.TextDim)
	-- Jauge "tu y es presque" (seulement quand c'est trop cher)
	tipBar = UIUtil.Create("Frame", {
		Name = "Progress",
		Size = UDim2.new(1, 0, 0, 8),
		BackgroundColor3 = PRICE_TRACK,
		LayoutOrder = 8,
		ClipsDescendants = true,
		Visible = false,
		ZIndex = 6,
		Parent = tooltip,
	})
	UIUtil.Corner(tipBar, UDim.new(1, 0))
	tipBarFill = UIUtil.Create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 7,
		Parent = tipBar,
	})
	tipBarFill:SetAttribute("DarkSkinIgnore", true)
	UIUtil.Corner(tipBarFill, UDim.new(1, 0))
	UIUtil.Gradient(tipBarFill, ColorSequence.new(Color3.fromRGB(134, 239, 172), AFFORD_EDGE), 0)

	tipButton = UIUtil.PillButton({
		Name = "Buy",
		Text = Locale.T("Buy"),
		Color = Theme.Colors.Green,
		TextColor3 = Theme.Colors.TextDark,
		Height = 38,
		TextSize = 18,
		LayoutOrder = 9,
		ZIndex = 6,
		Parent = tooltip,
	})
	tipButton.Visible = false
end

----------------------------------------------------------------------
-- Style des cartes
----------------------------------------------------------------------

-- Reflet qui balaie la carte (0,5 s), caché le reste du temps
local function sweep(card: Card)
	local frame = card.Shine.Parent :: Frame
	frame.Visible = true
	card.Shine.Offset = Vector2.new(-1, 0)
	UIUtil.Tween(card.Shine, 0.45, { Offset = Vector2.new(1, 0) }, Enum.EasingStyle.Quad)
	local token = (frame:GetAttribute("Sweep") or 0) + 1
	frame:SetAttribute("Sweep", token)
	task.delay(0.5, function()
		if frame:GetAttribute("Sweep") == token then
			frame.Visible = false
		end
	end)
end

-- Prix + jauge "presque abordable" + contour (appelé au plus 4 fois / s)
local function styleAffordability(card: Card, animate: boolean)
	local upgrade = card.Upgrade
	local cost = getCost(upgrade)
	local dopamine = getDopamine()
	local affordable = dopamine >= cost - 1e-6
	local progress = cost > 0 and math.clamp(dopamine / cost, 0, 1) or 1

	local priceText = "💧 " .. NumberFormatter.Format(cost)
	if card.PriceText.Text ~= priceText then
		card.PriceText.Text = priceText
	end
	if affordable then
		card.Price.BackgroundColor3 = PRICE_OK
		card.PriceFill.Visible = false
		card.PriceText.TextColor3 = Theme.Colors.TextDark
		card.PriceStroke.Color = Color3.fromRGB(20, 120, 50)
		card.PriceStroke.Transparency = 0.2
	else
		card.Price.BackgroundColor3 = darkMode and Color3.fromRGB(60, 60, 72) or PRICE_TRACK
		card.PriceFill.Visible = progress > 0.02
		local target = UDim2.fromScale(progress, 1)
		if animate and card.PriceFill.Size ~= target then
			UIUtil.Tween(card.PriceFill, REFRESH_INTERVAL, { Size = target }, Enum.EasingStyle.Linear)
		else
			card.PriceFill.Size = target
		end
		card.PriceText.TextColor3 = darkMode and Theme.DarkColors.TextDim or Theme.Colors.TextDim
		card.PriceStroke.Color = Theme.Colors.CardBorder
		card.PriceStroke.Transparency = 0.75
	end

	-- v9 : abordable = anneau vert + halo ; sinon contour gris doux, plaque estompée
	if affordable then
		card.Stroke.Color = AFFORD_EDGE
		card.Stroke.Thickness = 2.5
		card.Stroke.Transparency = 0
	else
		card.Stroke.Color = darkMode and Theme.DarkColors.CardBorder
			or (hdEnabled and upgradeColor(upgrade):Lerp(BLACK, 0.35) or CARD_EDGE)
		card.Stroke.Thickness = 1.5
		card.Stroke.Transparency = darkMode and 0.62 or 0
	end
	card.Glow.Visible = affordable
	card.Icon.TextTransparency = affordable and 0 or 0.25
	card.Plate.BackgroundTransparency = affordable and 0 or 0.3

	-- Devient abordable : petit "pop" pour attirer l'œil
	if card.Affordable == false and affordable and animate and tipUpgradeId ~= upgrade.Id then
		card.PopScale.Scale = 1.1
		UIUtil.Tween(card.PopScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
		sweep(card)
	end
	card.Affordable = affordable
end

local function styleCard(card: Card)
	local upgrade = card.Upgrade
	local button = card.Button
	local color = upgradeColor(upgrade)

	if hdEnabled then
		button.BackgroundColor3 = WHITE
		button.BackgroundTransparency = darkMode and 0.1 or 0
		card.Gradient.Enabled = true
		card.Gradient.Color = ColorSequence.new(color:Lerp(WHITE, 0.55), color:Lerp(WHITE, 0.15))
		card.HD.Visible = true
	else
		card.HD.Visible = false
		card.Gradient.Enabled = true
		-- Carte blanche avec un très léger voile de sa couleur en bas
		card.Gradient.Color = ColorSequence.new(WHITE, color:Lerp(WHITE, 0.86))
		if darkMode then
			button.BackgroundColor3 = Theme.DarkColors.Card
			button.BackgroundTransparency = Theme.DarkColors.CardTransparency
			card.Gradient.Enabled = false
		else
			button.BackgroundColor3 = Theme.Colors.Card
			button.BackgroundTransparency = 0
		end
	end
	-- (contour : voir styleAffordability, selon abordable ou non)
	styleAffordability(card, false)
end

local function styleAll()
	for _, card in pairs(cards) do
		if not card.Removing then
			styleCard(card)
		end
	end
end

-- Niveau : pastille sur la plaque + barre de progression
local function styleLevel(card: Card, data)
	local upgrade = card.Upgrade
	local level = Formulas.GetLevel(data, upgrade.Id)
	if upgrade.Effect == "Detox" then
		local rebirths = data.Rebirths or 0
		card.LevelChip.Visible = rebirths > 0
		card.LevelText.Text = "🌊" .. tostring(rebirths)
		card.LevelTrack.Visible = false
	elseif isRepeatable(upgrade) then
		card.LevelChip.Visible = level > 0
		card.LevelText.Text = tostring(level)
		card.LevelTrack.Visible = upgrade.MaxLevel ~= nil
		if upgrade.MaxLevel then
			local ratio = math.clamp(level / upgrade.MaxLevel, 0, 1)
			card.LevelFill.Size = UDim2.fromScale(ratio, 1)
			-- Presque au max : la barre (et la pastille) passent à l'or
			local nearMax = level >= upgrade.MaxLevel - 1 and level > 0
			card.LevelFill.BackgroundColor3 = nearMax and MAX_GOLD or upgradeColor(upgrade):Lerp(BLACK, 0.1)
			card.LevelChip.BackgroundColor3 = nearMax and MAX_GOLD:Lerp(BLACK, 0.25) or Theme.Colors.Dark
		end
	else
		card.LevelChip.Visible = false
		card.LevelTrack.Visible = false
	end
end

----------------------------------------------------------------------
-- Achat
----------------------------------------------------------------------

local function burstAt(card: Card, color: Color3?)
	local layer = Effects.GetLayer()
	if layer and card.Button.Parent then
		Effects.Burst(layer, Interface.CanvasPosition(card.Button), color, 14)
	end
end

local function failFeedback(card: Card?)
	SoundManager.Play("Error", 0.7)
	if card then
		UIUtil.Shake(card.Button)
	end
end

-- Animation d'achat : écrasement + rebond, reflet qui balaie, plaque qui saute
local function buyAnimation(card: Card, newLevel: number?)
	card.PopScale.Scale = 0.86
	UIUtil.Tween(card.PopScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Elastic)
	card.PlateScale.Scale = 1.35
	UIUtil.Tween(card.PlateScale, 0.5, { Scale = 1 }, Enum.EasingStyle.Elastic)
	sweep(card)
	local layer = Effects.GetLayer()
	if layer and card.Button.Parent and newLevel and isRepeatable(card.Upgrade) and card.Upgrade.Effect ~= "Detox" then
		Effects.Pop(layer, Interface.CanvasPosition(card.Button, Vector2.new(0, -46)), Locale.T("Lv %d", newLevel), {
			Color = Theme.Colors.Green,
			Size = 22,
			Style = "Bonus",
			Rise = 50,
		})
	end
end

-- Ce qu'on essaie d'acheter (affiché dans la fenêtre "Pas assez de Dopamine")
local function purchaseContext(upgrade)
	return { Icon = upgrade.Icon, Name = Locale.T(upgrade.Name), Color = upgradeColor(upgrade) }
end

-- Achat refusé faute de Dopamine : fenêtre "Pas assez de Dopamine" À CHAQUE fois
local function offerDopamine(card: Card)
	local upgrade = card.Upgrade
	hideTooltip()
	NeedDopamine.Offer(getCost(upgrade) - getDopamine(), nil, purchaseContext(upgrade))
end

local function buy(upgradeId: string)
	lastUiTapClock = os.clock()
	local card = cards[upgradeId]
	if not card or card.Removing then
		return
	end
	local upgrade = card.Upgrade
	if not canAfford(upgrade) then
		failFeedback(card)
		offerDopamine(card)
		return
	end
	local previousLevel = ClientState.GetLevel(upgrade.Id)
	local cost = getCost(upgrade)
	task.spawn(function()
		local ok, success, message = pcall(function()
			return Net.Function("BuyUpgrade"):InvokeServer(upgradeId)
		end)
		if ok and success then
			SoundManager.Play("Buy", 0.95 + random:NextNumber(0, 0.15))
			burstAt(card, upgradeColor(upgrade))
			buyAnimation(card, previousLevel + 1)
			if upgrade.Effect == "Detox" then
				hideTooltip()
			end
		else
			failFeedback(card)
			if not ok then
				Notifications.Toast(Locale.T("Network error, try again."), Theme.Colors.Red)
			elseif NeedDopamine.OfferRefusal(message, cost, nil, purchaseContext(upgrade)) then
				-- Le serveur n'avait pas encore compté tous les clics : vrai manque proposé
				hideTooltip()
			elseif type(message) == "string" and message ~= "" then
				local layer = Effects.GetLayer()
				if layer and card.Button.Parent then
					Effects.Pop(layer, Interface.CanvasPosition(card.Button, Vector2.new(0, -40)), message, { Color = Theme.Colors.Red, Size = 20, Style = "Text" })
				end
			end
		end
	end)
end

----------------------------------------------------------------------
-- Création / suppression des cartes
----------------------------------------------------------------------

local function createCard(upgrade): Card
	local color = upgradeColor(upgrade)
	local holder = UIUtil.Create("Frame", {
		Name = upgrade.Id,
		Size = UDim2.fromOffset(CARD_SIZE, CARD_SIZE),
		BackgroundTransparency = 1,
		Parent = scroll,
	})
	-- Cadre "design" 100 x 100 mis à l'échelle de la carte
	local fitFrame = UIUtil.Create("Frame", {
		Name = "Fit",
		Size = UDim2.fromOffset(DESIGN, DESIGN),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundTransparency = 1,
		Parent = holder,
	})
	local fit = UIUtil.Create("UIScale", { Name = "FitScale", Parent = fitFrame })

	-- Halo vert derrière la carte quand on peut l'acheter
	local glow = UIUtil.Create("Frame", {
		Name = "Glow",
		Size = UDim2.new(1, 10, 1, 10),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundColor3 = AFFORD_GLOW,
		BackgroundTransparency = 0.72,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 0,
		Parent = fitFrame,
	})
	glow:SetAttribute("DarkSkinIgnore", true)
	UIUtil.Corner(glow, 22)

	local button = UIUtil.Create("TextButton", {
		Name = "Card",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Colors.Card,
		AutoButtonColor = false,
		Text = "",
		ClipsDescendants = false,
		Parent = fitFrame,
	})
	UIUtil.Corner(button, 18)
	local stroke = UIUtil.Stroke(button, Theme.Colors.CardBorder, 2)
	local gradient = UIUtil.Gradient(button, ColorSequence.new(WHITE, color:Lerp(WHITE, 0.86)), 90)
	local popScale = UIUtil.Create("UIScale", { Name = "PopScale", Parent = button })
	-- (ombre de 2 + 2 px : tient sous la carte, jamais coupée par la barre)
	UIUtil.Shadow(button, 2, 0.84, 1)

	-- Décor "Icônes HD" : rayons qui tournent derrière la plaque
	local hd = UIUtil.Create("Frame", {
		Name = "HD",
		Size = UDim2.new(1, -8, 1, -8),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Visible = false,
		ZIndex = 1,
		Parent = button,
	})
	UIUtil.Corner(hd, 14)
	local rays = UIUtil.Create("Frame", {
		Name = "Rays",
		Size = UDim2.fromScale(1.6, 1.6),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.36),
		BackgroundTransparency = 1,
		ZIndex = 1,
		Parent = hd,
	})
	for i = 0, 5 do
		UIUtil.Create("Frame", {
			Size = UDim2.new(0, 12, 1, 0),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Rotation = i * 30,
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.72,
			BorderSizePixel = 0,
			ZIndex = 1,
			Parent = rays,
		})
	end

	-- Plaque d'icône (couleur de l'amélioration)
	local plate = UIUtil.Create("Frame", {
		Name = "Plate",
		Size = UDim2.fromOffset(54, 54),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromOffset(50, 7),
		BackgroundColor3 = WHITE,
		ZIndex = 2,
		Parent = button,
	})
	UIUtil.Corner(plate, 16)
	UIUtil.Stroke(plate, color:Lerp(BLACK, 0.35), 1.5, 0.15)
	UIUtil.Gradient(plate, ColorSequence.new(color:Lerp(WHITE, 0.62), color:Lerp(WHITE, 0.18)), 90)
	local plateScale = UIUtil.Create("UIScale", { Name = "PlateScale", Parent = plate })
	local gloss = UIUtil.Create("Frame", {
		Name = "Gloss",
		Size = UDim2.new(1, -8, 0.42, 0),
		Position = UDim2.fromOffset(4, 3),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.55,
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = plate,
	})
	UIUtil.Corner(gloss, 12)
	UIUtil.Create("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new(0.1, 1),
		Parent = gloss,
	})
	local icon = UIUtil.Create("TextLabel", {
		Name = "Icon",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		Text = upgrade.Icon,
		TextSize = 34,
		TextColor3 = Theme.Colors.Text,
		ZIndex = 4,
		Parent = plate,
	})

	-- Pastille de niveau (coin de la plaque)
	local levelChip = UIUtil.Create("Frame", {
		Name = "LevelChip",
		Size = UDim2.fromOffset(22, 20),
		AutomaticSize = Enum.AutomaticSize.X,
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.fromOffset(71, 3),
		BackgroundColor3 = Theme.Colors.Dark,
		Visible = false,
		ZIndex = 6,
		Parent = button,
	})
	UIUtil.Corner(levelChip, UDim.new(1, 0))
	UIUtil.Stroke(levelChip, WHITE, 1.5, 0)
	UIUtil.Gradient(levelChip, ColorSequence.new(WHITE, Color3.fromRGB(190, 190, 190)), 90)
	UIUtil.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 5),
		PaddingRight = UDim.new(0, 5),
		Parent = levelChip,
	})
	local levelText = UIUtil.Create("TextLabel", {
		Name = "Level",
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Number,
		Text = "",
		TextSize = 13,
		TextColor3 = Theme.Colors.TextLight,
		ZIndex = 7,
		Parent = levelChip,
	})

	-- Barre de progression des niveaux
	local levelTrack = UIUtil.Create("Frame", {
		Name = "LevelTrack",
		Size = UDim2.fromOffset(62, 5),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromOffset(50, 65),
		BackgroundColor3 = Color3.fromRGB(226, 226, 232),
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 2,
		Parent = button,
	})
	UIUtil.Corner(levelTrack, UDim.new(1, 0))
	local levelFill = UIUtil.Create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = color:Lerp(BLACK, 0.1),
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = levelTrack,
	})
	UIUtil.Corner(levelFill, UDim.new(1, 0))

	-- Pastille de prix (jauge "presque abordable" dessous)
	local price = UIUtil.Create("Frame", {
		Name = "Price",
		Size = UDim2.fromOffset(88, 23),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromOffset(50, 95),
		BackgroundColor3 = PRICE_TRACK,
		ClipsDescendants = true,
		ZIndex = 3,
		Parent = button,
	})
	UIUtil.Corner(price, UDim.new(1, 0))
	local priceStroke = UIUtil.Stroke(price, Theme.Colors.CardBorder, 1, 0.75)
	-- Relief + reflet (au-dessus de la jauge, sous le texte)
	UIUtil.Gradient(price, UIUtil.ButtonShading, 90)
	UIUtil.Gloss(price, 0.45).ZIndex = 4
	local priceFill = UIUtil.Create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = PRICE_FILL,
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = price,
	})
	UIUtil.Corner(priceFill, UDim.new(1, 0))
	local priceText = UIUtil.Create("TextLabel", {
		Name = "PriceText",
		Size = UDim2.new(1, -8, 1, 0),
		Position = UDim2.fromOffset(4, 0),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Number,
		Text = "",
		TextSize = 15,
		TextScaled = true,
		TextColor3 = Theme.Colors.TextDark,
		ZIndex = 5,
		Parent = price,
	})
	UIUtil.Create("UITextSizeConstraint", { MaxTextSize = 15, MinTextSize = 9, Parent = priceText })

	-- Reflet qui balaie la carte (achat / devient abordable)
	local shineFrame = UIUtil.Create("Frame", {
		Name = "Shine",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		Visible = false, -- montré seulement pendant le balayage
		ZIndex = 8,
		Parent = button,
	})
	UIUtil.Corner(shineFrame, 18)
	local shine = UIUtil.Create("UIGradient", {
		Rotation = 20,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.4, 1),
			NumberSequenceKeypoint.new(0.5, 0.3),
			NumberSequenceKeypoint.new(0.6, 1),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Offset = Vector2.new(1, 0), -- hors de la carte au repos
		Parent = shineFrame,
	})

	local card: Card = {
		Upgrade = upgrade,
		Holder = holder,
		Fit = fit,
		Button = button,
		Stroke = stroke,
		Gradient = gradient,
		Plate = plate,
		PlateScale = plateScale,
		Icon = icon,
		LevelChip = levelChip,
		LevelText = levelText,
		LevelTrack = levelTrack,
		LevelFill = levelFill,
		Price = price,
		PriceFill = priceFill,
		PriceText = priceText,
		PriceStroke = priceStroke,
		Shine = shine,
		PopScale = popScale,
		HD = hd,
		Rays = rays,
		Glow = glow,
		Level = ClientState.GetLevel(upgrade.Id),
		Affordable = nil,
		Removing = false,
	}

	-- Survol (PC)
	button.MouseEnter:Connect(function()
		if lastInputTouch or tipPinned then
			return
		end
		showTooltip(upgrade.Id, false)
		UIUtil.Tween(popScale, 0.12, { Scale = 1.06 }, Enum.EasingStyle.Back)
	end)
	button.MouseLeave:Connect(function()
		UIUtil.Tween(popScale, 0.12, { Scale = 1 })
		if tipUpgradeId == upgrade.Id and not tipPinned then
			hideTooltip()
		end
	end)

	-- Clic / appui
	button.Activated:Connect(function()
		lastUiTapClock = os.clock()
		-- Trop cher : fenêtre "Pas assez de Dopamine" tout de suite, à CHAQUE
		-- clic (tactile et "Aller à l'océan" compris : rien à confirmer)
		if not canAfford(upgrade) then
			buy(upgrade.Id)
			return
		end
		local needsConfirm = upgrade.Effect == "Detox"
		if lastInputTouch or needsConfirm then
			if tipUpgradeId == upgrade.Id and tipPinned and not needsConfirm then
				buy(upgrade.Id)
			else
				showTooltip(upgrade.Id, true)
				SoundManager.Play("Click", 1.3)
			end
		else
			-- Une infobulle épinglée (ex. confirmation de l'océan) sur une AUTRE
			-- carte : on la ferme, sinon elle resterait bloquée à l'écran
			if tipPinned and tipUpgradeId ~= upgrade.Id then
				hideTooltip()
				showTooltip(upgrade.Id, false)
			end
			buy(upgrade.Id)
		end
	end)

	styleCard(card)
	return card
end

-- `maxed` : la carte part parce qu'elle a atteint son niveau max (plusieurs
-- niveaux) : elle brille en or avec "MAX ✓" avant de s'effacer
local function removeCard(id: string, maxed: boolean?)
	local card = cards[id]
	if not card or card.Removing then
		return
	end
	card.Removing = true
	cards[id] = nil
	if tipUpgradeId == id then
		hideTooltip()
	end
	local delay = 0
	if maxed and card.Button.Parent then
		delay = 0.55
		card.Stroke.Color = MAX_GOLD
		card.Stroke.Thickness = 3
		card.Glow.BackgroundColor3 = MAX_GOLD
		card.Glow.Visible = true
		card.PopScale.Scale = 1.12
		UIUtil.Tween(card.PopScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
		sweep(card)
		local layer = Effects.GetLayer()
		if layer then
			Effects.Pop(layer, Interface.CanvasPosition(card.Button, Vector2.new(0, -48)), Locale.T("MAX ✅"), {
				Color = MAX_GOLD,
				Size = 24,
				Style = "Bonus",
				Rise = 46,
			})
		end
	end
	task.delay(delay, function()
		UIUtil.Tween(card.PopScale, 0.25, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		task.delay(0.3, function()
			card.Holder:Destroy()
		end)
	end)
end

----------------------------------------------------------------------
-- Carte teaser (🔒 nouveautés après la prochaine visite à l'océan)
----------------------------------------------------------------------

--[[
	v9 : une vraie carte "océan", de la même famille que les autres cartes
	(même hauteur, même mise à l'échelle), ÉPINGLÉE au bout de la rangée
	(hors du défilement : toujours visible, jamais coupée) :
	  - mer en dégradé (bleu profond -> turquoise), rayons de lumière,
	    vagues festonnées qui ondulent, petites bulles qui montent ;
	  - hublot givré avec un cadenas + pastille dorée "+N" ;
	  - "N nouveautés" + "après ta prochaine visite à l'océan" ;
	  - aperçu des icônes des nouveautés (Config.Upgrades dont
	    RequiresRebirths = le prochain palier) dans des bulles givrées ;
	  - version compacte si la rangée est étroite (téléphone serré).
	Survol / appui : infobulle détaillée ; clic : la rangée défile jusqu'à la
	carte "Aller à l'océan", qui saute pour se montrer.
]]
local SEA_TOP = Color3.fromRGB(10, 62, 138)
local SEA_MID = Color3.fromRGB(14, 120, 196)
local SEA_BOTTOM = Color3.fromRGB(28, 186, 210)
local WAVE_BACK = Color3.fromRGB(34, 156, 214)
local WAVE_FRONT = Color3.fromRGB(96, 214, 236)
local SEA_EDGE = Color3.fromRGB(8, 46, 104)
local SEA_TEXT = Color3.fromRGB(214, 244, 255)
local GOLD = Color3.fromRGB(255, 200, 46)

-- Bande de vague festonnée (rangée de cercles sur le haut d'une bande)
local function buildWave(parent: Instance, name: string, color: Color3, height: number, bottom: number, zIndex: number): Frame
	local band = UIUtil.Create("Frame", {
		Name = name,
		Size = UDim2.new(1.5, 0, 0, height),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, bottom),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		ZIndex = zIndex,
		Parent = parent,
	})
	local crests = 16
	for index = 0, crests - 1 do
		local crest = UIUtil.Create("Frame", {
			Name = "Crest" .. index,
			Size = UDim2.fromOffset(24, 24),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(index / (crests - 1), 0, 0, 4),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			ZIndex = zIndex,
			Parent = band,
		})
		UIUtil.Corner(crest, UDim.new(1, 0))
	end
	return band
end

local function buildTeaser()
	teaser = UIUtil.Create("Frame", {
		Name = "Teaser",
		Size = UDim2.fromOffset(TEASER_WIDTH, CARD_SIZE),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = row,
	})
	-- Couleurs de l'océan gardées en mode sombre
	teaser:SetAttribute("DarkSkinIgnore", true)
	teaserFitFrame = UIUtil.Create("Frame", {
		Name = "Fit",
		Size = UDim2.fromOffset(TEASER_WIDTH, DESIGN),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		BackgroundTransparency = 1,
		Parent = teaser,
	})
	teaserFit = UIUtil.Create("UIScale", { Name = "FitScale", Parent = teaserFitFrame })
	teaserButton = UIUtil.Create("TextButton", {
		Name = "Card",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = SEA_MID,
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		Parent = teaserFitFrame,
	})
	UIUtil.Corner(teaserButton, 18)
	local stroke = UIUtil.Stroke(teaserButton, SEA_EDGE, 2, 0)
	stroke.Name = "TeaserStroke"
	UIUtil.Shadow(teaserButton, 3, 0.8, 1, 2)
	local teaserPop = UIUtil.Create("UIScale", { Name = "PopScale", Parent = teaserButton })

	-- La mer (CanvasGroup : tout le décor est coupé aux coins arrondis)
	local sea = UIUtil.Create("CanvasGroup", {
		Name = "Sea",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 1,
		Parent = teaserButton,
	})
	UIUtil.Corner(sea, 18)
	-- (un UIGradient directement sur le CanvasGroup teinterait tout son contenu)
	local water = UIUtil.Create("Frame", {
		Name = "Water",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 1,
		Parent = sea,
	})
	UIUtil.Gradient(water, ColorSequence.new({
		ColorSequenceKeypoint.new(0, SEA_TOP),
		ColorSequenceKeypoint.new(0.55, SEA_MID),
		ColorSequenceKeypoint.new(1, SEA_BOTTOM),
	}), 70)
	-- Rayons de lumière (depuis la surface, en haut à droite)
	for index, spec in ipairs({ { 0.66, 26, 0.88 }, { 0.8, 14, 0.9 }, { 0.93, 20, 0.92 } }) do
		UIUtil.Create("Frame", {
			Name = "Ray" .. index,
			Size = UDim2.new(0, spec[2], 2, 0),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(spec[1], 0.1),
			Rotation = 24,
			BackgroundColor3 = WHITE,
			BackgroundTransparency = spec[3],
			BorderSizePixel = 0,
			ZIndex = 2,
			Parent = sea,
		})
	end
	-- Petites bulles qui montent
	table.clear(teaserBubbles)
	for index, spec in ipairs({ { 0.56, 6 }, { 0.74, 4 }, { 0.9, 7 } }) do
		local bubble = UIUtil.Create("Frame", {
			Name = "Bubble" .. index,
			Size = UDim2.fromOffset(spec[2], spec[2]),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(spec[1], 0.7),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.45,
			BorderSizePixel = 0,
			ZIndex = 3,
			Parent = sea,
		})
		bubble:SetAttribute("X", spec[1])
		bubble:SetAttribute("Phase", index * 0.37)
		UIUtil.Corner(bubble, UDim.new(1, 0))
		table.insert(teaserBubbles, bubble)
	end
	-- Vagues (arrière, avant) + écume
	table.clear(teaserWaves)
	table.insert(teaserWaves, buildWave(sea, "WaveBack", WAVE_BACK, 30, 2, 4))
	table.insert(teaserWaves, buildWave(sea, "WaveFront", WAVE_FRONT, 18, 4, 5))

	-- Hublot givré + cadenas + pastille "+N"
	teaserPlate = UIUtil.Create("Frame", {
		Name = "Porthole",
		Size = UDim2.fromOffset(44, 44),
		Position = UDim2.fromOffset(10, 10),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.72,
		ZIndex = 6,
		Parent = teaserButton,
	})
	UIUtil.Corner(teaserPlate, UDim.new(1, 0))
	UIUtil.Stroke(teaserPlate, WHITE, 2.5, 0.1)
	UIUtil.Create("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new(0, 0.5),
		Parent = teaserPlate,
	})
	UIUtil.Create("TextLabel", {
		Name = "Lock",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		Text = "🔒",
		TextSize = 23,
		ZIndex = 7,
		Parent = teaserPlate,
	})
	teaserBadge = UIUtil.Create("TextLabel", {
		Name = "Count",
		Size = UDim2.fromOffset(0, 20),
		AutomaticSize = Enum.AutomaticSize.X,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -2, 0, 3),
		BackgroundColor3 = GOLD,
		Font = Theme.Fonts.Number,
		Text = "+1",
		TextColor3 = Color3.fromRGB(80, 44, 0),
		TextSize = 13,
		ZIndex = 8,
		Parent = teaserPlate,
	})
	UIUtil.Corner(teaserBadge, UDim.new(1, 0))
	UIUtil.Stroke(teaserBadge, WHITE, 1.5, 0)
	UIUtil.Create("UIPadding", { PaddingLeft = UDim.new(0, 5), PaddingRight = UDim.new(0, 5), Parent = teaserBadge })

	-- Textes (blancs, bordés de bleu nuit : lisibles sur la mer)
	teaserTitle = UIUtil.Create("TextLabel", {
		Name = "Title",
		Size = UDim2.fromOffset(TEASER_WIDTH - 80, 20),
		Position = UDim2.fromOffset(70, 11),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = "",
		TextColor3 = WHITE,
		TextSize = 17,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 6,
		Parent = teaserButton,
	})
	UIUtil.Create("UITextSizeConstraint", { MaxTextSize = 17, MinTextSize = 9, Parent = teaserTitle })
	local titleStroke = UIUtil.Stroke(teaserTitle, SEA_EDGE, 1.5, 0.35)
	titleStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	teaserText = UIUtil.Create("TextLabel", {
		Name = "Text",
		Size = UDim2.fromOffset(TEASER_WIDTH - 80, 28),
		Position = UDim2.fromOffset(70, 32),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = "",
		TextColor3 = SEA_TEXT,
		TextSize = 13,
		TextWrapped = true,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 6,
		Parent = teaserButton,
	})
	UIUtil.Create("UITextSizeConstraint", { MaxTextSize = 13, MinTextSize = 8, Parent = teaserText })

	-- Aperçu des nouveautés : icônes dans des bulles givrées
	teaserPeek = UIUtil.Create("Frame", {
		Name = "Peek",
		Size = UDim2.fromOffset(TEASER_WIDTH - 20, 26),
		Position = UDim2.fromOffset(10, 66),
		BackgroundTransparency = 1,
		ZIndex = 6,
		Parent = teaserButton,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 5),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = teaserPeek,
	})
	table.clear(teaserPeekSlots)
	for index = 1, TEASER_MAX_PEEK do
		local slot = UIUtil.Create("Frame", {
			Name = "Peek" .. index,
			Size = UDim2.fromOffset(25, 25),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.2,
			LayoutOrder = index,
			Visible = false,
			ZIndex = 6,
			Parent = teaserPeek,
		})
		UIUtil.Corner(slot, UDim.new(1, 0))
		UIUtil.Stroke(slot, WHITE, 1.5, 0.2)
		UIUtil.Gradient(slot, ColorSequence.new(WHITE, Color3.fromRGB(200, 236, 250)), 90)
		UIUtil.Create("TextLabel", {
			Name = "Icon",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Font = Theme.Fonts.Title,
			Text = "",
			TextColor3 = SEA_EDGE,
			TextSize = 15,
			ZIndex = 7,
			Parent = slot,
		})
		table.insert(teaserPeekSlots, slot)
	end

	teaserButton.MouseEnter:Connect(function()
		if lastInputTouch or tipPinned then
			return
		end
		showTooltip(TEASER_ID, false)
		UIUtil.Tween(teaserPop, 0.12, { Scale = 1.04 }, Enum.EasingStyle.Back)
	end)
	teaserButton.MouseLeave:Connect(function()
		UIUtil.Tween(teaserPop, 0.12, { Scale = 1 })
		if tipUpgradeId == TEASER_ID and not tipPinned then
			hideTooltip()
		end
	end)
	teaserButton.Activated:Connect(function()
		lastUiTapClock = os.clock()
		SoundManager.Play("Click", 1.2)
		teaserPop.Scale = 0.94
		UIUtil.Tween(teaserPop, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		showTooltip(TEASER_ID, lastInputTouch)
		-- Montre la carte "Aller à l'océan" (c'est elle qui débloque tout ça)
		for _, card in pairs(cards) do
			if card.Upgrade.Effect == "Detox" and not card.Removing then
				local view = scroll.Size.X.Offset
				local target = math.clamp(card.Holder.Position.X.Offset - (view - card.Holder.Size.X.Offset) / 2, 0, math.max(0, scroll.CanvasSize.X.Offset - view))
				UIUtil.Tween(scroll, 0.45, { CanvasPosition = Vector2.new(target, 0) }, Enum.EasingStyle.Quint)
				task.delay(0.35, function()
					if card.Removing then
						return
					end
					card.PopScale.Scale = 1.14
					UIUtil.Tween(card.PopScale, 0.5, { Scale = 1 }, Enum.EasingStyle.Elastic)
					sweep(card)
				end)
				break
			end
		end
	end)
end

local refreshTeaser: (data: any) -> ()
local teaserData: any = nil

-- Place le contenu du teaser : large (texte + 5 icônes) ou compact
local function setTeaserCompact(compact: boolean)
	if compact == teaserCompact and teaserDesignWidth == (compact and TEASER_COMPACT_WIDTH or TEASER_WIDTH) then
		return
	end
	teaserCompact = compact
	local width = compact and TEASER_COMPACT_WIDTH or TEASER_WIDTH
	teaserDesignWidth = width
	teaserFitFrame.Size = UDim2.fromOffset(width, DESIGN)
	if compact then
		teaserPlate.Size = UDim2.fromOffset(40, 40)
		teaserPlate.AnchorPoint = Vector2.new(0.5, 0)
		teaserPlate.Position = UDim2.new(0.5, 0, 0, 7)
		teaserTitle.Size = UDim2.fromOffset(width - 12, 16)
		teaserTitle.Position = UDim2.fromOffset(6, 50)
		teaserTitle.TextXAlignment = Enum.TextXAlignment.Center
		teaserText.Visible = false
		teaserPeek.Size = UDim2.fromOffset(width - 12, 24)
		teaserPeek.Position = UDim2.fromOffset(6, 69)
	else
		teaserPlate.Size = UDim2.fromOffset(44, 44)
		teaserPlate.AnchorPoint = Vector2.zero
		teaserPlate.Position = UDim2.fromOffset(10, 10)
		teaserTitle.Size = UDim2.fromOffset(width - 80, 20)
		teaserTitle.Position = UDim2.fromOffset(70, 11)
		teaserTitle.TextXAlignment = Enum.TextXAlignment.Left
		teaserText.Visible = true
		teaserText.Size = UDim2.fromOffset(width - 80, 28)
		teaserPeek.Size = UDim2.fromOffset(width - 20, 26)
		teaserPeek.Position = UDim2.fromOffset(10, 66)
	end
	local layoutObject = teaserPeek:FindFirstChildOfClass("UIListLayout")
	if layoutObject then
		layoutObject.HorizontalAlignment = compact and Enum.HorizontalAlignment.Center or Enum.HorizontalAlignment.Left
	end
	-- Textes et nombre d'icônes selon la version
	if teaserData then
		refreshTeaser(teaserData)
	end
end

refreshTeaser = function(data)
	teaserData = data
	local gate, count = Formulas.GetNextRebirthUnlocks(data)
	teaserGate = gate
	teaserCount = count
	local show = gate ~= nil and count > 0
	teaser.Visible = show
	if not show then
		if tipUpgradeId == TEASER_ID then
			hideTooltip()
		end
		return
	end
	local rebirths = tonumber(data.Rebirths) or 0
	local visits = math.max(1, (gate :: number) - rebirths)
	teaserBadge.Text = "+" .. tostring(count)
	if teaserCompact then
		teaserTitle.Text = Locale.T("After the ocean 🌊")
	else
		teaserTitle.Text = count == 1 and Locale.T("1 new upgrade") or Locale.T("%d new upgrades", count)
	end
	if visits <= 1 then
		teaserText.Text = Locale.T("after your next visit to the ocean")
	else
		teaserText.Text = Locale.T("after %d more visits to the ocean", visits)
	end
	-- Aperçu : les icônes des nouveautés (+N s'il y en a trop)
	local icons = {}
	for _, upgrade in ipairs(Config.Upgrades) do
		if (upgrade.RequiresRebirths or 0) == gate then
			table.insert(icons, upgrade.Icon)
		end
	end
	local room = teaserCompact and TEASER_COMPACT_PEEK or TEASER_MAX_PEEK
	local shown = #icons > room and room - 1 or #icons
	for index, slot in ipairs(teaserPeekSlots) do
		local label = slot:FindFirstChild("Icon") :: TextLabel?
		if index <= shown then
			slot.Visible = true
			if label then
				label.Text = icons[index]
				label.TextSize = 15
			end
		elseif index == shown + 1 and #icons > shown then
			slot.Visible = true
			if label then
				label.Text = "+" .. tostring(#icons - shown)
				label.TextSize = 12
			end
		else
			slot.Visible = false
		end
	end
end

-- Vagues et bulles du teaser (≈ 20 fois par seconde, seulement s'il est visible)
local teaserClock = 0
local function animateTeaser(dt: number)
	teaserClock += dt
	if teaserClock < 0.05 then
		return
	end
	local t = os.clock()
	teaserClock = 0
	local back, front = teaserWaves[1], teaserWaves[2]
	if back and front then
		back.Position = UDim2.new(0.5, math.sin(t * 0.9) * 12, 1, 2)
		front.Position = UDim2.new(0.5, math.sin(t * 1.3 + 1.7) * -16, 1, 4)
	end
	for _, bubble in ipairs(teaserBubbles) do
		local phase = ((tonumber(bubble:GetAttribute("Phase")) or 0) + t * 0.22) % 1
		local x = tonumber(bubble:GetAttribute("X")) or 0.5
		bubble.Position = UDim2.new(x, math.sin(t * 3 + x * 9) * 3, 0.78 - phase * 0.8, 0)
		bubble.BackgroundTransparency = 0.35 + phase * 0.6
	end
end

----------------------------------------------------------------------
-- Mise en page
----------------------------------------------------------------------

-- Place les cartes (centrées ; défilement si trop large) et le teaser, épinglé
-- au bout de la rangée. Les cartes de `created` arrivent en glissant du bas.
local function layout(list: { any }, created: { [string]: boolean })
	local count = #list
	local cardSize, minCardSize, maxWidth = metrics()
	local teaserOn = teaser.Visible
	if teaserOn then
		setTeaserCompact(maxWidth < TEASER_COMPACT_BELOW)
	end
	local slots = count + (teaserOn and teaserDesignWidth / DESIGN or 0)
	local gaps = math.max(0, count + (teaserOn and 1 or 0) - 1)
	local size = cardSize
	if slots > 0 then
		size = math.clamp(math.floor((maxWidth - GAP * gaps) / slots), minCardSize, cardSize)
	end
	local scale = size / DESIGN
	-- Hauteur de la barre selon l'appareil
	local barHeight = cardSize + PAD_TOP + 8
	UpgradeBar.Height = barHeight
	if bar.Size.Y.Offset ~= barHeight then
		bar.Size = UDim2.new(1, 0, 0, barHeight)
	end
	local teaserWidth = teaserOn and math.floor(teaserDesignWidth * scale) or 0
	-- Zone qui défile : les cartes, dans la place laissée par le teaser
	local contentWidth = count * size + math.max(0, count - 1) * GAP + PAD_SIDE * 2
	local budget = maxWidth + PAD_SIDE * 2 - (teaserOn and (teaserWidth + GAP) or 0)
	local viewWidth = math.min(contentWidth, math.max(budget, size + PAD_SIDE * 2))
	scroll.Size = UDim2.new(0, viewWidth, 1, 0)
	scroll.CanvasSize = UDim2.fromOffset(contentWidth, 0)
	scroll.ScrollBarThickness = contentWidth > viewWidth + 1 and 4 or 0
	row.Size = UDim2.new(0, viewWidth + (teaserOn and (teaserWidth + GAP) or 0), 1, 0)

	local y = PAD_TOP + (cardSize - size)
	for index, upgrade in ipairs(list) do
		local card = cards[upgrade.Id]
		if card then
			local x = PAD_SIDE + (index - 1) * (size + GAP)
			local target = UDim2.fromOffset(x, y)
			local targetSize = UDim2.fromOffset(size, size)
			card.Fit.Scale = scale
			if created[upgrade.Id] then
				card.Holder.Size = targetSize
				card.Holder.Position = target + UDim2.fromOffset(0, 40)
				card.PopScale.Scale = 0.2
				UIUtil.Tween(card.Holder, 0.4, { Position = target }, Enum.EasingStyle.Back)
				UIUtil.Tween(card.PopScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
			elseif card.Holder.Position ~= target or card.Holder.Size ~= targetSize then
				UIUtil.Tween(card.Holder, 0.3, { Position = target, Size = targetSize })
			end
		end
	end
	if teaserOn then
		teaserFit.Scale = scale
		teaser.Size = UDim2.fromOffset(teaserWidth, size)
		-- (la zone qui défile finit par PAD_SIDE d'air : même écart que entre deux cartes)
		teaser.Position = UDim2.fromOffset(viewWidth - PAD_SIDE + GAP, y)
	end
end

----------------------------------------------------------------------
-- Mises à jour
----------------------------------------------------------------------

-- "Abordable" : prix, jauges, contours (au plus 4 fois par seconde)
local function refreshAffordability()
	lastAffordRefresh = os.clock()
	for _, card in pairs(cards) do
		if not card.Removing then
			styleAffordability(card, true)
		end
	end
	if tipUpgradeId then
		refreshTooltip()
	end
end

-- Demande une mise à jour "abordable" (regroupées : 4 par seconde au plus)
local function requestAffordability()
	if affordScheduled then
		return
	end
	local delay = REFRESH_INTERVAL - (os.clock() - lastAffordRefresh)
	if delay <= 0 then
		refreshAffordability()
		return
	end
	affordScheduled = true
	task.delay(delay, function()
		affordScheduled = false
		refreshAffordability()
	end)
end

local function refresh(data)
	local visible = Formulas.GetVisibleUpgrades(data)
	local wanted = {}
	for _, upgrade in ipairs(visible) do
		wanted[upgrade.Id] = true
	end

	-- Cartes qui disparaissent (achat unique terminé, niveau max, océan...)
	local toRemove = {}
	for id in pairs(cards) do
		if not wanted[id] then
			table.insert(toRemove, id)
		end
	end
	for _, id in ipairs(toRemove) do
		local card = cards[id]
		local upgrade = card and card.Upgrade
		local maxed = upgrade ~= nil
			and isRepeatable(upgrade)
			and upgrade.Effect ~= "Detox"
			and Formulas.IsMaxed(upgrade, Formulas.GetLevel(data, id))
		removeCard(id, maxed)
	end

	-- Nouvelles cartes
	local created = {}
	for _, upgrade in ipairs(visible) do
		if not cards[upgrade.Id] then
			cards[upgrade.Id] = createCard(upgrade)
			created[upgrade.Id] = true
		end
	end

	refreshTeaser(data)
	layout(visible, created)

	for _, upgrade in ipairs(visible) do
		local card = cards[upgrade.Id]
		if card then
			local level = Formulas.GetLevel(data, upgrade.Id)
			styleLevel(card, data)
			-- "Pop" de la pastille quand le niveau augmente
			if level > card.Level and not created[upgrade.Id] then
				UIUtil.Pop(card.LevelChip, 1.6, 0.4)
			end
			card.Level = level
			styleCard(card)
		end
	end
	lastAffordRefresh = os.clock()

	if tipUpgradeId then
		refreshTooltip()
	end
end

----------------------------------------------------------------------
-- Construction
----------------------------------------------------------------------

-- `parent` : cadre de la colonne centrale ; `tooltipLayer` : calque plein écran
-- au-dessus des stimuli (pour l'infobulle)
function UpgradeBar.Build(parent: GuiObject, tooltipLayer: Frame): Frame
	bar = UIUtil.Create("Frame", {
		Name = "UpgradeBar",
		Size = UDim2.new(1, 0, 0, UpgradeBar.Height),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	-- Rangée centrée : cartes (défilent si besoin) + carte teaser toujours
	-- visible au bout (jamais coupée ni cachée par le défilement)
	row = UIUtil.Create("Frame", {
		Name = "Row",
		Size = UDim2.new(0, MAX_WIDTH, 1, 0),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		BackgroundTransparency = 1,
		Parent = bar,
	})
	scroll = UIUtil.Create("ScrollingFrame", {
		Name = "Cards",
		Size = UDim2.new(0, MAX_WIDTH, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollingDirection = Enum.ScrollingDirection.X,
		ScrollBarThickness = 0,
		ScrollBarImageColor3 = Theme.Colors.Dark,
		CanvasSize = UDim2.fromOffset(0, 0),
		ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
		Parent = row,
	})
	buildTeaser()

	buildTooltip(tooltipLayer)
	tooltip.Activated:Connect(function()
		lastUiTapClock = os.clock()
	end)
	tipButton.Activated:Connect(function()
		lastUiTapClock = os.clock()
		local id = tipUpgradeId
		if not id or id == TEASER_ID then
			return
		end
		-- (trop cher : buy propose la boutique Dopamine via NeedDopamine)
		buy(id)
	end)

	-- Type d'entrée (tactile ou souris)
	UserInputService.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.Touch then
			lastInputTouch = true
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
			lastInputTouch = false
		end
	end)
	UserInputService.InputChanged:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseMovement and not UserInputService.TouchEnabled then
			lastInputTouch = false
		end
	end)
	-- Appui ailleurs : on ferme l'infobulle "épinglée"
	UserInputService.InputEnded:Connect(function(input: InputObject)
		local inputType = input.UserInputType
		if inputType ~= Enum.UserInputType.Touch and inputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		local stamp = os.clock()
		task.delay(0.15, function()
			if tipPinned and lastUiTapClock < stamp - 0.25 then
				hideTooltip()
			end
		end)
	end)

	PanelManager.Opened:Connect(hideTooltip)
	-- La fenêtre "Pas assez de Dopamine" s'ouvre : l'infobulle s'efface
	NeedDopamine.Shown:Connect(hideTooltip)

	-- Écran qui change : cartes, largeur et infobulle réajustées
	local function applyDevice()
		local touch = Interface.IsTouch()
		tooltip.Size = UDim2.fromOffset(touch and 330 or 290, 0)
		-- Bouton "Acheter" : zone tactile de 44 px au moins
		tipButton.Size = UDim2.fromOffset(0, touch and Theme.TouchTarget or 38)
		tipButton.TextSize = touch and 20 or 18
		for _, line in ipairs({ tipName, tipLevel, tipDesc, tipNeeds, tipCost, tipMissing }) do
			local base = line:GetAttribute("BaseTextSize") or 16
			line.TextSize = touch and base + 3 or base
		end
		if ClientState.Data then
			refresh(ClientState.Data)
		end
	end
	Interface.DeviceChanged:Connect(applyDevice)
	Slots.Changed:Connect(applyDevice)
	applyDevice()

	-- Mises à jour : état complet (structure) + ticks légers de Dopamine
	ClientState.Changed:Connect(refresh)
	local dopamineChanged = (ClientState :: any).DopamineChanged
	local hasTicks = type(dopamineChanged) == "table" and type(dopamineChanged.Connect) == "function"
	if hasTicks then
		dopamineChanged:Connect(requestAffordability)
	end
	ClientState.FeaturesChanged:Connect(function()
		hdEnabled = ClientState.HasFeature("HDIcons")
		styleAll()
	end)
	ClientState.DarkModeChanged:Connect(function(dark: boolean)
		darkMode = dark
		styleAll()
	end)
	darkMode = ClientState.DarkMode

	-- Rotation des rayons HD (seulement avec les Icônes HD) + filet de sécurité
	-- "abordable" (clics prédits, ou pas encore de ticks légers : 4 fois / s)
	local safety = hasTicks and SAFETY_INTERVAL or REFRESH_INTERVAL
	RunService.RenderStepped:Connect(function(dt: number)
		-- Vagues du teaser (en pause quand une fenêtre recouvre la barre)
		if teaser.Visible and not PanelManager.IsOpen() then
			animateTeaser(dt)
		end
		if hdEnabled then
			local rotation = (os.clock() * 25) % 360
			for _, card in pairs(cards) do
				card.Rays.Rotation = rotation
			end
		end
		if os.clock() - lastAffordRefresh >= safety then
			requestAffordability()
		end
	end)

	if ClientState.Data then
		refresh(ClientState.Data)
	end
	return bar
end

-- Masque l'infobulle (ex. clic sur le gros bouton)
function UpgradeBar.HideTooltip()
	if not tipPinned then
		hideTooltip()
	end
end

-- Nombre de nouveautés annoncées par la carte teaser (0 si aucune)
function UpgradeBar.GetTeaserCount(): number
	return teaser and teaser.Visible and teaserCount or 0
end

return UpgradeBar
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="93">
        <Properties>
          <string name="Name">DarkSkin</string>
          <string name="Source"><![CDATA[--[[
	DarkSkin (ModuleScript)
	Emplacement : ReplicatedStorage > Client > DarkSkin

	"Habillage sombre" automatique de l'interface claire. Toute l'interface
	est construite avec la palette claire (Theme.Colors) ; quand le mode
	sombre est actif (ClientState.DarkMode : réglage ⚙️ du joueur, thème
	sombre ou mode néon), DarkSkin repeint les éléments des cadres
	enregistrés (Register) :
	  - fonds blancs / gris clairs -> gris très foncés (Theme.DarkUI),
	    les fonds pastel -> version sombre teintée ;
	  - textes noirs / gris foncés -> blanc cassé / gris clair, SEULEMENT
	    s'ils sont posés sur un fond qui devient sombre (un texte noir sur
	    une pastille jaune reste noir) ;
	  - contours noirs -> contours gris plus doux ;
	  - les couleurs vives (boutons verts, badges rouges...) ne changent pas.
	Les couleurs d'origine sont gardées en attributs ("DS_*") et remises
	quand le mode sombre s'arrête. Les changements faits ensuite par le code
	(ex. texte qui passe au rouge) sont suivis automatiquement.

	Un élément (et tout ce qu'il contient) peut être exclu avec l'attribut
	"DarkSkinIgnore" = true (ex. miniatures des thèmes).

	API : DarkSkin.Register(root), DarkSkin.SetEnabled(bool), DarkSkin.IsEnabled(),
	      DarkSkin.MapBackground(color), DarkSkin.MapText(color) (utilitaires).
]]

local Theme = require(script.Parent.Theme)

local DarkSkin = {}

local P = Theme.DarkUI
local WHITE = Color3.new(1, 1, 1)

local enabled = false
local roots: { [Instance]: boolean } = {}
-- Objets déjà "branchés" (écouteurs de propriétés) : clés faibles
local bound: { [Instance]: boolean } = setmetatable({}, { __mode = "k" }) :: any

-- Attributs : couleur d'origine (claire) et couleur appliquée (sombre)
local ATTR = {
	BackgroundColor3 = { "DS_Bg", "DS_BgOut" },
	TextColor3 = { "DS_Text", "DS_TextOut" },
	PlaceholderColor3 = { "DS_Ph", "DS_PhOut" },
	Color = { "DS_Stroke", "DS_StrokeOut" },
	ScrollBarImageColor3 = { "DS_Scroll", "DS_ScrollOut" },
}

----------------------------------------------------------------------
-- Couleurs
----------------------------------------------------------------------

local function luminance(color: Color3): number
	return Theme.Luminance(color)
end

local function saturation(color: Color3): number
	local _, s, _ = color:ToHSV()
	return s
end

-- Fond "clair" qui doit devenir sombre : blanc / gris clair, ou pastel très clair
local function isLightSurface(color: Color3): boolean
	local l = luminance(color)
	local s = saturation(color)
	if l >= 0.6 and s < 0.12 then
		return true
	end
	return l >= 0.86 and s < 0.4
end

-- Fond (couleur claire) -> fond sombre. Les autres couleurs ne changent pas.
function DarkSkin.MapBackground(color: Color3): Color3
	local l = luminance(color)
	local s = saturation(color)
	if isLightSurface(color) then
		-- Plus c'était clair, plus ça devient foncé (blanc -> carte sombre)
		local t = math.clamp((1 - l) / 0.4, 0, 1)
		local neutral = P.Card:Lerp(P.Raised, t)
		if s >= 0.05 then
			local h = color:ToHSV()
			local tinted = Color3.fromHSV(h, 0.45, P.TintedDark)
			return neutral:Lerp(tinted, math.clamp(s * 1.6, 0, 0.7))
		end
		return neutral
	end
	-- Gris foncés (pastilles "Dark") : un peu relevés pour rester visibles
	if s < 0.12 and l >= 0.12 and l < 0.35 then
		return color:Lerp(P.Raised, 0.35)
	end
	return color
end

-- Texte (couleur claire d'origine) posé sur un fond devenu sombre
function DarkSkin.MapText(color: Color3): Color3
	local l = luminance(color)
	local s = saturation(color)
	if s < 0.25 then
		if l < 0.25 then
			return P.Text
		elseif l < 0.55 then
			return P.TextDim
		end
		return color
	end
	-- Couleur foncée (vert foncé, bordeaux...) : éclaircie pour rester lisible
	if l < 0.4 then
		return color:Lerp(WHITE, 0.45)
	end
	return color
end

-- Contour (UIStroke en mode bordure)
local function mapStroke(color: Color3): Color3
	local l = luminance(color)
	local s = saturation(color)
	if s < 0.15 then
		if l < 0.35 then
			return P.Border
		elseif l >= 0.72 and l < 0.985 then
			return P.Divider
		end
	end
	return color
end

local function mapScroll(color: Color3): Color3
	if saturation(color) < 0.15 and luminance(color) < 0.45 then
		return P.Scroll
	end
	return color
end

----------------------------------------------------------------------
-- Analyse de l'arbre
----------------------------------------------------------------------

local function isIgnored(instance: Instance): boolean
	local node: Instance? = instance
	while node do
		if node:GetAttribute("DarkSkinIgnore") == true then
			return true
		end
		if roots[node] then
			return false
		end
		node = node.Parent
	end
	return false
end

-- Couleur de fond d'origine (claire) d'un objet
local function originalBg(guiObject: GuiObject): Color3
	local stored = guiObject:GetAttribute("DS_Bg")
	if typeof(stored) == "Color3" then
		return stored
	end
	return guiObject.BackgroundColor3
end

-- Dégradé coloré (ex. bouton aux couleurs d'un skin, carte "premium") :
-- le fond est alors donné par le dégradé, on n'y touche pas
local function hasColoredGradient(guiObject: Instance): boolean
	local gradient = guiObject:FindFirstChildOfClass("UIGradient")
	if not gradient or not gradient.Enabled then
		return false
	end
	for _, keypoint in ipairs(gradient.Color.Keypoints) do
		if saturation(keypoint.Value) > 0.2 then
			return true
		end
	end
	return false
end

-- Le fond de cet objet doit-il être assombri ?
local function shouldMapBg(guiObject: GuiObject): boolean
	return isLightSurface(originalBg(guiObject)) and not hasColoredGradient(guiObject)
end

-- Le texte de cet objet est-il posé sur un fond qui devient sombre ?
-- (premier ancêtre au fond visible ; aucun = fond du jeu, sombre aussi)
local function textOnDarkenedBg(textObject: GuiObject): boolean
	local node: Instance? = textObject
	while node and node:IsA("GuiObject") do
		local gui = node :: GuiObject
		if gui.BackgroundTransparency < 0.6 and gui.Visible then
			local bg = originalBg(gui)
			if hasColoredGradient(gui) then
				return false
			end
			if isLightSurface(bg) then
				return true
			end
			-- Fond foncé : le texte y est déjà clair (on ne touche qu'aux textes foncés)
			if luminance(bg) < 0.35 and saturation(bg) < 0.25 then
				return true
			end
			return false
		end
		if roots[node] then
			break
		end
		node = node.Parent
	end
	return true
end

----------------------------------------------------------------------
-- Application
----------------------------------------------------------------------

-- Applique (ou retire) la couleur sombre d'une propriété
local function applyProperty(instance: Instance, property: string, mapper: (Color3) -> Color3)
	local names = ATTR[property]
	local originalName, outName = names[1], names[2]
	local stored = instance:GetAttribute(originalName)
	if enabled then
		local original: Color3
		if typeof(stored) == "Color3" then
			original = stored
		else
			original = (instance :: any)[property]
			instance:SetAttribute(originalName, original)
		end
		local mapped = mapper(original)
		instance:SetAttribute(outName, mapped)
		if (instance :: any)[property] ~= mapped then
			(instance :: any)[property] = mapped
		end
	elseif typeof(stored) == "Color3" then
		instance:SetAttribute(originalName, nil)
		instance:SetAttribute(outName, nil)
		if (instance :: any)[property] ~= stored then
			(instance :: any)[property] = stored
		end
	end
end

local function identity(color: Color3): Color3
	return color
end

local function refreshText(guiObject: GuiObject)
	if not (guiObject:IsA("TextLabel") or guiObject:IsA("TextButton") or guiObject:IsA("TextBox")) then
		return
	end
	local mapper = textOnDarkenedBg(guiObject) and DarkSkin.MapText or identity
	applyProperty(guiObject, "TextColor3", mapper)
	if guiObject:IsA("TextBox") then
		applyProperty(guiObject, "PlaceholderColor3", mapper)
	end
end

local function refreshBg(guiObject: GuiObject)
	local mapper = shouldMapBg(guiObject) and DarkSkin.MapBackground or function(color: Color3): Color3
		-- Gris foncé (pastille "Dark") : légèrement relevé
		if saturation(color) < 0.12 and luminance(color) >= 0.12 and luminance(color) < 0.35 then
			return DarkSkin.MapBackground(color)
		end
		return color
	end
	applyProperty(guiObject, "BackgroundColor3", mapper)
end

local function processObject(instance: Instance)
	if instance:IsA("GuiObject") then
		refreshBg(instance)
		refreshText(instance)
		if instance:IsA("ScrollingFrame") then
			applyProperty(instance, "ScrollBarImageColor3", mapScroll)
		end
	elseif instance:IsA("UIStroke") then
		-- Contour de TEXTE (Contextual sur un texte) : on n'y touche pas
		local parent = instance.Parent
		local isTextOutline = instance.ApplyStrokeMode == Enum.ApplyStrokeMode.Contextual
			and parent ~= nil
			and (parent:IsA("TextLabel") or parent:IsA("TextButton") or parent:IsA("TextBox"))
		if not isTextOutline then
			applyProperty(instance, "Color", mapStroke)
		end
	end
end

-- Suit les changements faits par le code (nouvelle couleur "claire")
local function watchProperty(instance: Instance, property: string, onChange: () -> ())
	local outName = ATTR[property][2]
	instance:GetPropertyChangedSignal(property):Connect(function()
		if not enabled then
			return
		end
		local current = (instance :: any)[property]
		if current == instance:GetAttribute(outName) then
			return -- c'est notre propre couleur
		end
		instance:SetAttribute(ATTR[property][1], current)
		onChange()
	end)
end

-- Le fond d'un objet a (peut-être) changé de nature : on le repeint, lui et ses textes
local function refreshSurface(gui: GuiObject)
	refreshBg(gui)
	refreshText(gui)
	for _, descendant in ipairs(gui:GetDescendants()) do
		if descendant:IsA("GuiObject") and bound[descendant] then
			refreshText(descendant)
		end
	end
end

local function bind(instance: Instance)
	if bound[instance] then
		return
	end
	bound[instance] = true
	if instance:IsA("UIGradient") then
		-- Dégradé qui devient coloré (skin du bouton, cartes "HD"...) ou neutre :
		-- le fond de son parent doit être réévalué
		local function onGradientChanged()
			local parent = instance.Parent
			if enabled and parent and parent:IsA("GuiObject") and not isIgnored(parent) then
				refreshSurface(parent)
			end
		end
		instance:GetPropertyChangedSignal("Color"):Connect(onGradientChanged)
		instance:GetPropertyChangedSignal("Enabled"):Connect(onGradientChanged)
		return
	end
	if instance:IsA("GuiObject") then
		local gui = instance :: GuiObject
		-- Le fond a changé : ses textes (lui-même et ses enfants directs) aussi
		watchProperty(gui, "BackgroundColor3", function()
			refreshSurface(gui)
		end)
		if gui:IsA("TextLabel") or gui:IsA("TextButton") or gui:IsA("TextBox") then
			watchProperty(gui, "TextColor3", function()
				refreshText(gui)
			end)
		end
		if gui:IsA("ScrollingFrame") then
			watchProperty(gui, "ScrollBarImageColor3", function()
				applyProperty(gui, "ScrollBarImageColor3", mapScroll)
			end)
		end
	elseif instance:IsA("UIStroke") then
		watchProperty(instance, "Color", function()
			processObject(instance)
		end)
	end
end

local function handle(instance: Instance)
	local isGradient = instance:IsA("UIGradient")
	if not (instance:IsA("GuiObject") or instance:IsA("UIStroke") or isGradient) then
		return
	end
	if isIgnored(instance) then
		return
	end
	if enabled then
		bind(instance)
	end
	if isGradient then
		-- Dégradé ajouté après son parent : le fond du parent est réévalué
		local parent = instance.Parent
		if parent and parent:IsA("GuiObject") and bound[parent] then
			refreshSurface(parent)
		end
		return
	end
	processObject(instance)
end

local function processRoot(root: Instance)
	handle(root)
	for _, descendant in ipairs(root:GetDescendants()) do
		handle(descendant)
	end
end

----------------------------------------------------------------------
-- API
----------------------------------------------------------------------

-- Ajoute un cadre (et tout ce qu'il contient, même ajouté plus tard) à l'habillage
function DarkSkin.Register(root: Instance)
	if roots[root] then
		return
	end
	roots[root] = true
	root.DescendantAdded:Connect(function(descendant)
		if enabled and roots[root] then
			handle(descendant)
		end
	end)
	root.Destroying:Connect(function()
		roots[root] = nil
	end)
	if enabled then
		processRoot(root)
	end
end

-- Active / coupe le mode sombre de l'interface
function DarkSkin.SetEnabled(value: boolean)
	local newValue = value == true
	if newValue == enabled then
		return
	end
	enabled = newValue
	for root in pairs(roots) do
		if root.Parent then
			processRoot(root)
		end
	end
end

function DarkSkin.IsEnabled(): boolean
	return enabled
end

return DarkSkin
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="94">
        <Properties>
          <string name="Name">Effects</string>
          <string name="Source"><![CDATA[--[[
	Effects (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Effects

	Effets visuels 2D : textes flottants "+X", particules, confettis,
	flash d'écran, gros messages. (Les ParticleEmitter ne fonctionnent pas
	dans les interfaces, on anime donc de petits Frames.)
	Le réglage "Effets" (SetEnabled) coupe particules et confettis.
]]

local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")

local Theme = require(script.Parent.Theme)
local UIUtil = require(script.Parent.UIUtil)

local Effects = {}

local layer: Frame? = nil -- calque plein écran pour les effets
local enabled = true -- paramètre "Effets" (particules / confettis)
local random = Random.new()
local activeParticles = 0 -- confettis en cours (les particules de Burst sont comptées à part)
local MAX_PARTICLES = 160 -- limite pour les petits appareils
local MAX_TEXTS = 60

local CONFETTI_COLORS = {
	Theme.Colors.Pink,
	Theme.Colors.Cyan,
	Theme.Colors.Purple,
	Theme.Colors.Yellow,
	Theme.Colors.Green,
	Theme.Colors.Orange,
	Theme.Colors.Red,
	Theme.Colors.Blue,
}

function Effects.Init(effectsLayer: Frame)
	layer = effectsLayer
end

function Effects.SetEnabled(value: boolean)
	enabled = value
end

function Effects.IsEnabled(): boolean
	return enabled
end

-- Calque plein écran des effets (nil avant Init)
function Effects.GetLayer(): Frame?
	return layer
end

-- Dans un emplacement de stimulus (calque "Slots", ClipsDescendants = true), un
-- texte qui monte de 100 px serait coupé : on le redessine dans le calque
-- "Overlay" (non coupé, sous les menus) à la même position à l'écran.
local function unclip(parent: GuiObject, position: UDim2): (GuiObject, UDim2)
	local root = layer and layer.Parent
	local slots = root and root:FindFirstChild("Slots")
	local overlay = root and root:FindFirstChild("Overlay")
	if not root or not slots or not overlay or not overlay:IsA("GuiObject") or not parent:IsDescendantOf(slots) then
		return parent, position
	end
	local clipped = false
	local node: Instance? = parent
	while node and node ~= slots do
		if node:IsA("GuiObject") and node.ClipsDescendants then
			clipped = true
			break
		end
		node = node.Parent
	end
	if not clipped then
		return parent, position
	end
	local uiScale = root:FindFirstChildOfClass("UIScale")
	local scale = uiScale and uiScale.Scale or 1
	if scale <= 0 then
		return parent, position
	end
	-- Les décalages (Offset) sont agrandis par TOUS les UIScale au-dessus du
	-- parent (toile + échelle du slot sur téléphone)
	local factor = 1
	local node2: Instance? = parent
	while node2 and node2 ~= root.Parent do
		local nodeScale = node2:FindFirstChildOfClass("UIScale")
		if nodeScale then
			factor *= nodeScale.Scale
		end
		node2 = node2.Parent
	end
	local absolute = parent.AbsolutePosition
		+ parent.AbsoluteSize * Vector2.new(position.X.Scale, position.Y.Scale)
		+ Vector2.new(position.X.Offset, position.Y.Offset) * factor
	local canvas = (absolute - overlay.AbsolutePosition) / scale
	return overlay, UDim2.fromOffset(canvas.X, canvas.Y)
end

----------------------------------------------------------------------
-- Moteur des textes flottants et des particules (réserve d'objets)
-- Au lieu de créer / détruire un TextLabel (et 3 tweens) à chaque "+X",
-- on recycle des objets et UNE seule connexion RenderStepped les anime
-- (coupée dès qu'il n'y a plus rien à animer).
----------------------------------------------------------------------

type Float = {
	Label: TextLabel,
	Stroke: UIStroke,
	Scale: UIScale,
	Gradient: UIGradient,
	Start: UDim2,
	Age: number,
	Life: number,
	Rise: number,
	Drift: number,
	Tilt: number,
	Peak: number,
	Shake: number,
	BaseStroke: number,
}

type Particle = {
	Frame: Frame,
	Start: UDim2,
	DX: number,
	DY: number,
	Age: number,
	Life: number,
	Size: number,
}

local floatPool: { Float } = {}
local floats: { Float } = {}
local particlePool: { Particle } = {}
local particles: { Particle } = {}
local loop: RBXScriptConnection? = nil
local POOL_KEEP = 40 -- objets gardés en réserve au maximum (par type)

-- Styles : couleurs des dégradés "critique" / "bonus"
local CRIT_TOP = Color3.fromRGB(255, 250, 190)
local CRIT_BOTTOM = Color3.fromRGB(255, 150, 0)
local NUMBER_FONT = Enum.Font.FredokaOne -- chiffres ronds et lisibles
local WHITE = Color3.new(1, 1, 1)

local function easeOutCubic(t: number): number
	local u = 1 - t
	return 1 - u * u * u
end

local function easeOutBack(t: number): number
	local c1 = 1.70158
	local c3 = c1 + 1
	local u = t - 1
	return 1 + c3 * u * u * u + c1 * u * u
end

-- Remet un objet en réserve (ou le jette si son parent a été détruit entre-temps)
local function park(instance: Instance, pool: { any }, entry: any)
	local ok = pcall(function()
		instance.Parent = nil
	end)
	if ok and #pool < POOL_KEEP then
		table.insert(pool, entry)
	elseif not ok then
		pcall(function()
			instance:Destroy()
		end)
	else
		instance:Destroy()
	end
end

local function step(dt: number)
	-- Textes
	local index = 1
	while index <= #floats do
		local item = floats[index]
		item.Age += dt
		local age = item.Age
		if age >= item.Life or not item.Label.Parent then
			table.remove(floats, index)
			park(item.Label, floatPool, item)
		else
			local t = age / item.Life
			-- Échelle : "pop" rapide, léger rebond, puis rétrécit un peu
			local scale
			if age < 0.14 then
				scale = 0.35 + (item.Peak - 0.35) * easeOutBack(age / 0.14)
			elseif age < 0.3 then
				scale = item.Peak + (1 - item.Peak) * ((age - 0.14) / 0.16)
			else
				scale = 1 - 0.12 * ((t - 0.3 / item.Life) / (1 - 0.3 / item.Life))
			end
			item.Scale.Scale = math.max(0.05, scale)
			-- Trajectoire : monte en ralentissant, légère courbe sur le côté
			local rise = easeOutCubic(t)
			local x = item.Drift * (t * 0.6 + rise * 0.4)
			local y = -item.Rise * rise
			item.Label.Position = item.Start + UDim2.fromOffset(x, y)
			-- Inclinaison qui se redresse (+ secousse des coups critiques)
			local rotation = item.Tilt * (1 - rise)
			if item.Shake > 0 and age < 0.35 then
				rotation += math.sin(age * 70) * item.Shake * (1 - age / 0.35)
			end
			item.Label.Rotation = rotation
			-- Fondu sur la fin
			local fade = t < 0.6 and 0 or (t - 0.6) / 0.4
			item.Label.TextTransparency = fade
			item.Stroke.Transparency = math.min(1, fade * 1.1 + (1 - item.BaseStroke))
			index += 1
		end
	end
	-- Particules
	index = 1
	while index <= #particles do
		local item = particles[index]
		item.Age += dt
		if item.Age >= item.Life or not item.Frame.Parent then
			table.remove(particles, index)
			park(item.Frame, particlePool, item)
		else
			local t = item.Age / item.Life
			local move = 1 - (1 - t) ^ 4
			item.Frame.Position = item.Start + UDim2.fromOffset(item.DX * move, item.DY * move + 30 * t * t)
			local size = item.Size + (2 - item.Size) * t
			item.Frame.Size = UDim2.fromOffset(size, size)
			item.Frame.BackgroundTransparency = t * t
			index += 1
		end
	end
	if #floats == 0 and #particles == 0 and loop then
		loop:Disconnect()
		loop = nil
	end
end

local function ensureLoop()
	if not loop then
		loop = RunService.RenderStepped:Connect(step)
	end
end

local function newFloat(): Float
	local label = UIUtil.Create("TextLabel", {
		Name = "FloatText",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Font = NUMBER_FONT,
		Text = "",
		TextSize = 30,
		TextColor3 = WHITE,
		ZIndex = 50,
	})
	local stroke = UIUtil.Stroke(label, Theme.Colors.TextDark, 2)
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	local scale = UIUtil.Create("UIScale", { Parent = label })
	local gradient = UIUtil.Gradient(label, ColorSequence.new(CRIT_TOP, CRIT_BOTTOM), 90)
	gradient.Enabled = false
	return {
		Label = label,
		Stroke = stroke,
		Scale = scale,
		Gradient = gradient,
		Start = UDim2.new(),
		Age = 0,
		Life = 1,
		Rise = 90,
		Drift = 0,
		Tilt = 0,
		Peak = 1.15,
		Shake = 0,
		BaseStroke = 1,
	}
end

--[[
	Texte flottant (réserve d'objets). options :
	  Color  : couleur du texte (défaut : texte du thème)
	  Size   : taille en pixels (défaut 34)
	  Style  : "Normal" | "Crit" (dégradé doré, plus gros, secousse) |
	           "Bonus" (dégradé de la couleur, plus gros) | "Text" (phrase)
	  Rise   : hauteur de montée (défaut selon la taille)
]]
function Effects.Pop(parent: GuiObject, position: UDim2, text: string, options: { [string]: any }?)
	if not parent or not parent.Parent then
		return
	end
	local opts = options or {}
	parent, position = unclip(parent, position)
	local style = tostring(opts.Style or "Normal")
	local size = tonumber(opts.Size) or 34
	local color: Color3 = opts.Color or Theme.Colors.Text

	-- Trop de textes : on recycle le plus ancien (les nouveaux gains s'affichent toujours)
	local item: Float
	if #floats >= MAX_TEXTS then
		item = table.remove(floats, 1) :: Float
	else
		item = table.remove(floatPool) or newFloat()
	end
	local label = item.Label
	local ok = pcall(function()
		label.Parent = parent
	end)
	if not ok then
		item = newFloat()
		label = item.Label
		label.Parent = parent
	end

	local crit = style == "Crit"
	local bonus = style == "Bonus"
	local sentence = style == "Text" or not string.find(text, "^[%+%-]?%d") and not string.find(text, "^%+")
	if crit or bonus then
		size = math.max(size, 38)
	end
	label.Font = sentence and Theme.Fonts.Title or NUMBER_FONT
	label.Text = text
	label.TextSize = math.floor(size + 0.5)
	label.Size = UDim2.fromOffset(math.floor(size * 8), math.floor(size * 1.3))
	label.ZIndex = (crit or bonus) and 52 or 50
	label.TextTransparency = 0
	label.Rotation = 0

	-- Couleur + contour contrasté (épais pour les gros chiffres)
	if crit then
		label.TextColor3 = WHITE
		item.Gradient.Color = ColorSequence.new(CRIT_TOP, CRIT_BOTTOM)
		item.Gradient.Enabled = true
		item.Stroke.Color = Color3.fromRGB(90, 30, 0)
	elseif bonus then
		label.TextColor3 = WHITE
		item.Gradient.Color = ColorSequence.new(color:Lerp(WHITE, 0.55), color)
		item.Gradient.Enabled = true
		item.Stroke.Color = color:Lerp(Color3.new(0, 0, 0), 0.65)
	else
		label.TextColor3 = color
		item.Gradient.Enabled = false
		item.Stroke.Color = Theme.Luminance(color) > 0.5 and Theme.Colors.TextDark or WHITE
	end
	item.Stroke.Thickness = size >= 40 and 3 or (size >= 26 and 2.5 or 2)
	item.BaseStroke = (crit or bonus or Theme.Luminance(color) > 0.5) and 1 or 0.85
	item.Stroke.Transparency = 1 - item.BaseStroke

	-- Trajectoire aléatoire (légère courbe)
	item.Start = position
	item.Age = 0
	item.Life = (crit or bonus) and 1.35 or (sentence and 1.25 or 0.95)
	item.Rise = tonumber(opts.Rise) or math.clamp(size * 2.6, 70, 150)
	local side = random:NextNumber() < 0.5 and -1 or 1
	item.Drift = side * random:NextNumber(8, 34)
	item.Tilt = side * random:NextNumber(3, 9)
	item.Peak = crit and 1.4 or (bonus and 1.3 or 1.15)
	item.Shake = crit and 6 or 0
	item.Scale.Scale = 0.35
	label.Position = position

	table.insert(floats, item)
	ensureLoop()
end

-- Texte "+X" qui monte et disparaît (API historique, utilisée par les stimuli) :
-- un gros nombre doré (taille >= 40) prend le style "critique"
function Effects.FloatingText(parent: GuiObject, position: UDim2, text: string, color: Color3?, size: number?)
	local height = size or 34
	local style = "Normal"
	if height >= 40 and string.find(text, "^%+") then
		style = (color == nil or color == Theme.Colors.Gold or color == Theme.Colors.Yellow) and "Crit" or "Bonus"
	end
	Effects.Pop(parent, position, text, { Color = color, Size = height, Style = style })
end

-- Couleur / style d'un gain selon sa taille par rapport à une référence
-- (ex. la valeur d'un clic) : (couleur, style)
function Effects.AmountStyle(amount: number, reference: number, dark: boolean?): (Color3, string)
	local ratio = reference > 0 and amount / reference or 1
	if ratio >= 2.5 then
		return Theme.Colors.Gold, "Crit"
	elseif ratio >= 1.8 then
		return Theme.Colors.Orange, "Normal"
	elseif ratio >= 1.25 then
		return Color3.fromRGB(255, 196, 40), "Normal"
	end
	return dark and Theme.Colors.TextLight or Theme.Colors.Text, "Normal"
end

-- Explosion de petites particules rondes autour d'un point (réserve d'objets)
function Effects.Burst(parent: GuiObject, position: UDim2, color: Color3?, count: number?)
	if not enabled or not parent or not parent.Parent then
		return
	end
	for _ = 1, count or 8 do
		if #particles >= MAX_PARTICLES then
			return
		end
		local item: Particle? = table.remove(particlePool)
		if item then
			local ok = pcall(function()
				(item :: Particle).Frame.Parent = parent
			end)
			if not ok then
				item = nil
			end
		end
		if not item then
			local frame = UIUtil.Create("Frame", {
				Name = "Particle",
				AnchorPoint = Vector2.new(0.5, 0.5),
				BorderSizePixel = 0,
				ZIndex = 40,
				Parent = parent,
			})
			UIUtil.Corner(frame, UDim.new(1, 0))
			item = { Frame = frame, Start = position, DX = 0, DY = 0, Age = 0, Life = 0.5, Size = 8 }
		end
		local particle = item :: Particle
		local size = random:NextInteger(6, 14)
		local angle = random:NextNumber(0, math.pi * 2)
		local distance = random:NextNumber(50, 140)
		particle.Start = position
		particle.DX = math.cos(angle) * distance
		particle.DY = math.sin(angle) * distance
		particle.Age = 0
		particle.Life = random:NextNumber(0.4, 0.7)
		particle.Size = size
		particle.Frame.Position = position
		particle.Frame.Size = UDim2.fromOffset(size, size)
		particle.Frame.BackgroundTransparency = 0
		particle.Frame.BackgroundColor3 = color or CONFETTI_COLORS[random:NextInteger(1, #CONFETTI_COLORS)]
		table.insert(particles, particle)
	end
	ensureLoop()
end

-- Pluie de confettis sur tout l'écran
function Effects.Confetti(count: number?)
	local target = layer
	if not enabled or not target then
		return
	end
	for _ = 1, count or 80 do
		if activeParticles >= MAX_PARTICLES then
			return
		end
		activeParticles += 1
		local piece = UIUtil.Create("Frame", {
			Size = UDim2.fromOffset(random:NextInteger(8, 16), random:NextInteger(14, 24)),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(random:NextNumber(0, 1), 0, 0, random:NextInteger(-200, -20)),
			Rotation = random:NextNumber(0, 360),
			BackgroundColor3 = CONFETTI_COLORS[random:NextInteger(1, #CONFETTI_COLORS)],
			BorderSizePixel = 0,
			ZIndex = 90,
			Parent = target,
		})
		local duration = random:NextNumber(1.6, 3)
		local start = piece.Position
		UIUtil.Tween(piece, duration, {
			Position = UDim2.new(start.X.Scale + random:NextNumber(-0.15, 0.15), 0, 1.1, 0),
			Rotation = piece.Rotation + random:NextNumber(-720, 720),
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(duration, function()
			activeParticles -= 1
			piece:Destroy()
		end)
	end
end

-- Flash coloré de tout l'écran
function Effects.Flash(color: Color3?, strength: number?)
	local target = layer
	if not target then
		return
	end
	local flash = UIUtil.Create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = color or Color3.new(1, 1, 1),
		BackgroundTransparency = 1 - (strength or 0.6),
		BorderSizePixel = 0,
		ZIndex = 95,
		Parent = target,
	})
	UIUtil.Tween(flash, 0.6, { BackgroundTransparency = 1 })
	Debris:AddItem(flash, 0.7)
end

-- Gros message au centre de l'écran (jackpot, rush...)
function Effects.BigMessage(text: string, color: Color3?, duration: number?)
	local target = layer
	if not target then
		return
	end
	local label = UIUtil.Label({
		Text = text,
		Font = Theme.Fonts.Title,
		TextColor3 = color or Theme.Colors.Yellow,
		Size = UDim2.new(0.9, 0, 0, 110),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		ZIndex = 100,
		MaxTextSize = 90,
		Parent = target,
	})
	local stroke = UIUtil.Stroke(label, Theme.Colors.TextDark, 4)
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual

	local scale = UIUtil.Create("UIScale", { Scale = 0.1, Parent = label })
	UIUtil.Tween(scale, 0.5, { Scale = 1 }, Enum.EasingStyle.Elastic)

	-- Petit clignotement de couleur
	task.spawn(function()
		local colors = { color or Theme.Colors.Yellow, Theme.Colors.Cyan, Theme.Colors.Pink, Theme.Colors.Green }
		local index = 0
		local finish = os.clock() + (duration or 2.5)
		while label.Parent and os.clock() < finish do
			index = index % #colors + 1
			label.TextColor3 = colors[index]
			task.wait(0.12)
		end
		if not label.Parent then
			return
		end
		UIUtil.Tween(label, 0.4, { TextTransparency = 1 })
		UIUtil.Tween(stroke, 0.4, { Transparency = 1 })
		task.wait(0.4)
		label:Destroy()
	end)
end

return Effects
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="95">
        <Properties>
          <string name="Name">Interface</string>
          <string name="Source"><![CDATA[--[[
	Interface (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Interface

	Crée la ScreenGui et la "toile virtuelle" responsive :
	  - toute l'interface est pensée pour un écran de 1280x720 ;
	  - un UIScale agrandit / réduit l'ensemble selon l'écran réel
	    (PC, mobile, tablette) ;
	  - le cadre "Root" s'étire pour toujours couvrir toute la zone sûre
	    (hors encoche et barre Roblox ; sa taille en pixels "design" est
	    donc >= 1280x720 dans un sens) ;
	  - une ScreenGui de fond séparée remplit tout l'écran (couleurs du
	    thème équipé, ou fond sombre du mode néon).

	Calques (du plus bas au plus haut), tous plein écran, transparents et
	non "Active" (les clics passent à travers) :
	  Background < Slots < Main < Overlay < Panels < Toasts < Effects < Cinematic

	v5 : profil d'appareil (Interface.Device = "Phone" | "Tablet" | "Desktop",
	signal Interface.DeviceChanged). Sur téléphone / tablette, la toile de
	référence est plus petite (Theme.DeviceResolutions : 960x540, 1120x630) :
	tout est donc affiché plus gros. Les composants s'adaptent (colonne
	centrale, fenêtres, bandeaux) et les emplacements des stimuli rétrécissent
	si besoin (voir Slots). Sur PC rien ne change (toile 1280x720).

	v9.1 (plein écran) : les deux ScreenGui couvrent TOUT l'écran
	(ScreenInsets = None, SafeAreaCompatibility = None, ClipToDeviceSafeArea
	= false : sinon Roblox découpe le fond à l'encoche et laisse des bandes).
	La toile "Root" est placée par nous dans l'écran :
	  - PC / tablette : exactement la zone sûre "CoreUI" (comme avant) ;
	  - téléphone : la zone sûre de l'appareil un peu rognée (on garde juste
	    de quoi éviter l'encoche et la barre d'accueil), et le haut de la toile
	    remonte DANS la barre Roblox : la rangée du bandeau d'actualités
	    (30 px "design") occupe la partie libre de la barre, à droite des
	    boutons Roblox (GuiService.TopbarInset), le reste commence sous eux.
	Les zones sûres sont MESURÉES (ScreenGui-sondes en DeviceSafeInsets /
	CoreUISafeInsets) : aucune valeur d'appareil n'est devinée.
	Interface.Bleed = marges (pixels "design") entre la toile et les bords de
	l'écran : le calque Background les recouvre (fond de bord à bord) et
	Interface.ApplyBleed(objet) étend n'importe quel cadre "plein écran" (voiles
	sombres des fenêtres : les "Dimmer" des calques Panels / Toasts / Overlay
	sont étendus automatiquement). Interface.TickerInsets = { Left, Right } :
	partie de la rangée du bandeau cachée par les boutons Roblox (voir Slots).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")

local Theme = require(script.Parent.Theme)
local UIUtil = require(script.Parent.UIUtil)
local Signal = require(ReplicatedStorage.Shared.Signal)
local Config = require(ReplicatedStorage.Shared.Config)
local ClientState = require(script.Parent.ClientState)

local Interface = {}

Interface.ScreenGui = nil :: ScreenGui?
Interface.Root = nil :: Frame?
Interface.Layers = {} :: { [string]: Frame }
Interface.Scale = 1
Interface.CanvasSize = Theme.DesignResolution -- taille de la toile en pixels "design"
Interface.ScaleChanged = Signal.new() -- (scale, canvasSize)
Interface.Device = "Desktop" -- "Phone" | "Tablet" | "Desktop"
Interface.DeviceChanged = Signal.new() -- (device)
Interface.DesignResolution = Theme.DesignResolution -- toile de référence de l'appareil
-- Marges (pixels "design") entre la toile et les bords de l'écran (zones non sûres)
Interface.Bleed = { Left = 0, Top = 0, Right = 0, Bottom = 0 }
-- Rangée du bandeau (y ∈ [0, 30] de la toile) : largeur cachée par les boutons Roblox
Interface.TickerInsets = { Left = 0, Right = 0 }
-- Hauteur (pixels "design") en haut de la toile qui passe sous la barre Roblox
-- (téléphone : la rangée du bandeau ; 0 ailleurs). Les calques Panels et
-- Toasts commencent dessous : fenêtres et popups restent hors des boutons Roblox.
Interface.SafeTop = 0

-- Forçage du profil (tests dans Studio) : nil = détection automatique
local deviceOverride: string? = nil
local updateScaleFn: (() -> ())? = nil

-- Profil d'appareil : téléphone = tactile ET petit écran (< 500 px de côté),
-- tablette = tactile et plus grand, sinon PC (un PC tactile avec souris reste "Desktop")
local function detectDevice(): string
	if deviceOverride then
		return deviceOverride
	end
	local touch = UserInputService.TouchEnabled and not UserInputService.MouseEnabled
	if not touch then
		return "Desktop"
	end
	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
	if math.min(viewport.X, viewport.Y) < 500 then
		return "Phone"
	end
	return "Tablet"
end

Interface.LayerOrder = { "Background", "Slots", "Main", "Overlay", "Panels", "Toasts", "Effects", "Cinematic" }

-- Téléphone : part des marges de l'appareil (encoche, barre d'accueil) que la
-- toile garde. L'encoche ne fait qu'une trentaine de pixels de profondeur au
-- milieu d'un bord et iOS annonce la même marge des DEUX côtés : on en garde
-- ~45 % (jamais moins que marge - 26 px) ; en bas ~30 % (le trait d'accueil
-- ne gêne que les glissements, pas les touchers).
local function phoneSide(inset: number): number
	if inset <= 0 then
		return 0
	end
	return math.max(math.floor(inset * 0.45 + 0.5), inset - 26)
end
local function phoneBottom(inset: number): number
	if inset <= 0 then
		return 0
	end
	return math.floor(inset * 0.3 + 0.5)
end
-- Rangée du bandeau d'actualités en haut de la toile (pixels "design", = Slots)
local TICKER_ROW = 30
-- Le contenu sous le bandeau commence à (bas de la barre Roblox - 4 px) :
-- les boutons Roblox (44 px) s'arrêtent ~7 px au-dessus du bas de la barre
local TOPBAR_OVERLAP = 4
-- Largeur libre minimale (pixels écran) dans la barre pour y mettre le bandeau
local MIN_TOPBAR_ROOM = 240

-- ScreenGui "plein écran" réglée explicitement (ordre des propriétés : sans
-- effet de bord de IgnoreGuiInset sur ScreenInsets)
local function makeScreenGui(name: string, insets: Enum.ScreenInsets, displayOrder: number, parent: Instance): ScreenGui
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = insets == Enum.ScreenInsets.None
	gui.ScreenInsets = insets
	gui.SafeAreaCompatibility = Enum.SafeAreaCompatibility.None
	gui.ClipToDeviceSafeArea = false
	gui.DisplayOrder = displayOrder
	gui.Parent = parent
	return gui
end

-- Marges (pixels écran) d'une ScreenGui-sonde par rapport à l'écran entier
local function probeInsets(probe: ScreenGui, full: Vector2): (number, number, number, number)
	local position = probe.AbsolutePosition
	local size = probe.AbsoluteSize
	if size.X < 1 or size.Y < 1 then
		return 0, 0, 0, 0
	end
	local left = math.max(0, position.X)
	local top = math.max(0, position.Y)
	return left, top, math.max(0, full.X - left - size.X), math.max(0, full.Y - top - size.Y)
end

-- Zone libre de la barre Roblox (pixels écran) : minX, maxX, bas ; nil si inconnue
local function topbarFree(): (number?, number?, number?)
	local ok, rect = pcall(function()
		return GuiService.TopbarInset
	end)
	if not ok or typeof(rect) ~= "Rect" and type(rect) ~= "table" then
		return nil, nil, nil
	end
	local r = rect :: any
	local height = r.Height
	if type(height) ~= "number" or height <= 0 or type(r.Width) ~= "number" or r.Width <= 0 then
		return nil, nil, nil
	end
	return r.Min.X, r.Max.X, r.Max.Y
end

-- Cadres étendus jusqu'aux bords de l'écran (voir Interface.ApplyBleed)
local bleedTargets: { [GuiObject]: boolean } = setmetatable({}, { __mode = "k" }) :: any
local BLEED_NAMES = { Dimmer = true, MailDimmer = true }
-- Calques qui commencent sous Interface.SafeTop
local SHIFTED_LAYERS = { "Panels", "Toasts" }

local function applyBleedTo(object: GuiObject)
	local b = Interface.Bleed
	-- Dans un calque décalé (Panels / Toasts), le parent commence SafeTop plus bas
	local shift = 0
	for _, name in ipairs(SHIFTED_LAYERS) do
		local layer = Interface.Layers[name]
		if layer and object ~= layer and object:IsDescendantOf(layer) then
			shift = Interface.SafeTop
		end
	end
	object.AnchorPoint = Vector2.zero
	object.Position = UDim2.fromOffset(-b.Left, -(b.Top + shift))
	object.Size = UDim2.new(1, b.Left + b.Right, 1, b.Top + b.Bottom + shift)
end

function Interface.Build(): ScreenGui
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui
	-- Le jeu se joue en paysage sur mobile
	playerGui.ScreenOrientation = Enum.ScreenOrientation.LandscapeSensor

	for _, name in ipairs({ "DopamineGui", "DopamineBackdrop", "DopamineSafeProbe", "DopamineCoreProbe" }) do
		local old = playerGui:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end

	-- Fond plein écran (sous l'encoche / la barre Roblox) : simple couleur,
	-- pour ne jamais voir le monde 3D autour de la zone sûre
	-- (ClipToDeviceSafeArea = false : sinon Roblox coupe le fond à l'encoche)
	local backdropGui = makeScreenGui("DopamineBackdrop", Enum.ScreenInsets.None, 0, playerGui)
	local backdrop = UIUtil.Create("Frame", {
		Name = "Backdrop",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Active = false,
		Size = UDim2.fromScale(1, 1),
		Parent = backdropGui,
	})
	local backdropGradient = UIUtil.Gradient(backdrop, ColorSequence.new(Theme.Colors.Background, Theme.Colors.BackgroundBottom), 90)
	local lastKey = ""
	local function applyBackdrop()
		local data = ClientState.Data
		local themeId = (data and type(data.Themes) == "table" and data.Themes.Equipped) or "Classic"
		local theme = Config.ThemesById[themeId]
		local dark = ClientState.DarkMode
		-- Mode sombre du joueur : seul le thème Classique passe en fond sombre
		-- (les autres thèmes gardent leur fond ; le néon reste presque noir)
		local userDarkClassic = ClientState.HasDarkSource("User") and themeId == "Classic"
		local neonDark = dark and not userDarkClassic and (ClientState.HasDarkSource("Stimuli") or ClientState.HasDarkSource("Main"))
		local key = tostring(themeId) .. (dark and ":dark" or ":light") .. (userDarkClassic and ":user" or "") .. (neonDark and ":neon" or "")
		if key == lastKey then
			return
		end
		lastKey = key
		if userDarkClassic and not neonDark then
			backdrop.BackgroundColor3 = Color3.new(1, 1, 1)
			backdropGradient.Color = ColorSequence.new(Theme.DarkUI.Background, Theme.DarkUI.BackgroundBottom)
			backdropGradient.Enabled = true
		elseif theme and (theme.Dark or not neonDark) then
			-- Couleurs du thème (sombre ou clair)
			backdrop.BackgroundColor3 = Color3.new(1, 1, 1)
			backdropGradient.Color = ColorSequence.new(theme.Top, theme.Bottom)
			backdropGradient.Enabled = true
		elseif dark then
			-- Mode néon sur un thème clair : fond presque noir
			backdrop.BackgroundColor3 = Theme.DarkColors.Background
			backdropGradient.Enabled = false
		else
			backdrop.BackgroundColor3 = Color3.new(1, 1, 1)
			backdropGradient.Color = ColorSequence.new(Theme.Colors.Background, Theme.Colors.BackgroundBottom)
			backdropGradient.Enabled = true
		end
	end
	ClientState.DarkModeChanged:Connect(applyBackdrop)
	ClientState.DarkSourcesChanged:Connect(applyBackdrop)
	ClientState.Changed:Connect(applyBackdrop)
	applyBackdrop()

	-- L'interface couvre tout l'écran ; la toile (Root) est placée par
	-- updateScale selon les zones sûres mesurées par deux sondes vides
	local screenGui = makeScreenGui("DopamineGui", Enum.ScreenInsets.None, 1, playerGui)
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	local safeProbe = makeScreenGui("DopamineSafeProbe", Enum.ScreenInsets.DeviceSafeInsets, -1, playerGui)
	local coreProbe = makeScreenGui("DopamineCoreProbe", Enum.ScreenInsets.CoreUISafeInsets, -1, playerGui)

	-- Toile virtuelle mise à l'échelle
	local root = UIUtil.Create("Frame", {
		Name = "Root",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(Theme.DesignResolution.X, Theme.DesignResolution.Y),
		ZIndex = 2,
		Parent = screenGui,
	})
	local uiScale = UIUtil.Create("UIScale", { Parent = root })

	for index, name in ipairs(Interface.LayerOrder) do
		Interface.Layers[name] = UIUtil.Create("Frame", {
			Name = name,
			BackgroundTransparency = 1,
			Active = false,
			Size = UDim2.fromScale(1, 1),
			ZIndex = index,
			Parent = root,
		})
	end
	-- Le calque Background déborde jusqu'aux bords de l'écran (fond de bord à
	-- bord) ; Slots.Create y recale les cadres des stimuli sur la toile
	local backgroundLayer = Interface.Layers.Background
	bleedTargets[backgroundLayer] = true
	-- Cinématiques (ex. "Ocean") : leurs cadres plein-calque couvrent tout l'écran
	Interface.Layers.Cinematic.ChildAdded:Connect(function(child)
		if child:IsA("GuiObject") and child.Size == UDim2.fromScale(1, 1) then
			Interface.ApplyBleed(child)
		end
	end)
	-- Voiles sombres des fenêtres / popups ("Dimmer") : tout l'écran aussi
	for _, name in ipairs({ "Overlay", "Panels", "Toasts" }) do
		Interface.Layers[name].DescendantAdded:Connect(function(object)
			if BLEED_NAMES[object.Name] and object:IsA("GuiObject") then
				Interface.ApplyBleed(object)
			end
		end)
	end

	-- Recalcule l'échelle et la place de la toile quand l'écran, les zones
	-- sûres ou la barre Roblox changent
	local function updateScale()
		local full = screenGui.AbsoluteSize
		if full.X < 1 or full.Y < 1 then
			return
		end
		local device = detectDevice()
		local design = Theme.DeviceResolutions[device] or Theme.DesignResolution
		local dl, dt, dr, db = probeInsets(safeProbe, full)
		local cl, ct, cr, cb = probeInsets(coreProbe, full)
		local tbMin, tbMax, tbBottom = topbarFree()

		local left, top, right, bottom = cl, ct, cr, cb
		local tickerLeft, tickerRight = 0, 0
		local scale
		local reclaim = false
		if device == "Phone" then
			left, right, bottom = phoneSide(dl), phoneSide(dr), phoneBottom(db)
			top = dt
			local barBottom = tbBottom or math.max(ct, dt)
			-- Bandeau dans la partie libre de la barre Roblox (s'il y a la place)
			reclaim = tbMin ~= nil and tbMax ~= nil and tbBottom ~= nil and (tbMax :: number) - (tbMin :: number) >= MIN_TOPBAR_ROOM
			if reclaim then
				-- haut de la toile = bas de la barre - overlap - bandeau (x échelle)
				local k = math.min((full.X - left - right) / design.X, (full.Y - bottom - barBottom + TOPBAR_OVERLAP) / (design.Y - TICKER_ROW))
				scale = math.clamp(k, Theme.MinScale, Theme.MaxScale)
				top = math.max(dt, barBottom - TOPBAR_OVERLAP - TICKER_ROW * scale)
			else
				top = math.max(dt, barBottom)
			end
		end
		local available = Vector2.new(full.X - left - right, full.Y - top - bottom)
		if available.X < 1 or available.Y < 1 then
			return
		end
		if not scale then
			scale = math.clamp(math.min(available.X / design.X, available.Y / design.Y), Theme.MinScale, Theme.MaxScale)
		end
		local canvas = Vector2.new(available.X / scale, available.Y / scale)
		if reclaim then
			-- Partie de la rangée du bandeau cachée par les boutons Roblox
			tickerLeft = math.max(0, ((tbMin :: number) + 6 - left) / scale)
			if (tbMax :: number) < full.X - dr - 20 then
				tickerRight = math.max(0, (left + available.X - (tbMax :: number) + 6) / scale)
			end
			if canvas.X - tickerLeft - tickerRight < 420 then
				tickerLeft, tickerRight = 0, 0
			end
		end
		local deviceChanged = device ~= Interface.Device
		Interface.Device = device
		Interface.DesignResolution = design
		Interface.Scale = scale
		Interface.CanvasSize = canvas
		Interface.Bleed = {
			Left = left / scale,
			Top = top / scale,
			Right = right / scale,
			Bottom = bottom / scale,
		}
		Interface.TickerInsets = { Left = tickerLeft, Right = tickerRight }
		local safeTop = reclaim and TICKER_ROW or 0
		Interface.SafeTop = safeTop
		for _, name in ipairs(SHIFTED_LAYERS) do
			local layer = Interface.Layers[name]
			layer.Position = UDim2.fromOffset(0, safeTop)
			layer.Size = UDim2.new(1, 0, 1, -safeTop)
		end
		uiScale.Scale = scale
		-- Root fait (zone utile / échelle) pour la couvrir exactement une fois agrandi
		root.Position = UDim2.fromOffset(left, top)
		root.Size = UDim2.fromOffset(canvas.X, canvas.Y)
		for object in pairs(bleedTargets) do
			if object.Parent then
				applyBleedTo(object)
			end
		end
		if deviceChanged then
			Interface.DeviceChanged:Fire(device)
		end
		Interface.ScaleChanged:Fire(scale, canvas)
	end
	updateScaleFn = updateScale

	screenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateScale)
	for _, probe in ipairs({ safeProbe, coreProbe }) do
		probe:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateScale)
		probe:GetPropertyChangedSignal("AbsolutePosition"):Connect(updateScale)
	end
	pcall(function()
		GuiService:GetPropertyChangedSignal("TopbarInset"):Connect(updateScale)
	end)
	-- Tactile / souris qui apparaissent (tablette + clavier...) : on revérifie le profil
	UserInputService.LastInputTypeChanged:Connect(function()
		if detectDevice() ~= Interface.Device then
			updateScale()
		end
	end)
	Interface.Device = detectDevice()
	updateScale()

	Interface.ScreenGui = screenGui
	Interface.Root = root
	return screenGui
end

-- Étend un cadre "plein écran" (Size 1,1 dans un parent qui couvre la toile,
-- ex. un voile sombre) jusqu'aux bords réels de l'écran, et le tient à jour.
function Interface.ApplyBleed(object: GuiObject)
	bleedTargets[object] = true
	applyBleedTo(object)
end

-- Vrai sur téléphone (interface compacte : une seule ligne de menus, etc.)
function Interface.IsPhone(): boolean
	return Interface.Device == "Phone"
end

-- Vrai sur téléphone ou tablette (écran tactile sans souris)
function Interface.IsTouch(): boolean
	return Interface.Device ~= "Desktop"
end

-- Force un profil ("Phone" | "Tablet" | "Desktop") pour tester dans Studio ; nil = auto
function Interface.SetDeviceOverride(device: string?)
	if device ~= nil and Theme.DeviceResolutions[device] == nil then
		return
	end
	deviceOverride = device
	local update = updateScaleFn
	if update then
		update()
	end
end

-- Convertit une position écran (pixels réels, ex. AbsolutePosition) en
-- position sur la toile (pixels "design").
function Interface.ScreenToCanvas(point: Vector2): Vector2
	local root = Interface.Root
	if not root then
		return point
	end
	return (point - root.AbsolutePosition) / Interface.Scale
end

-- Centre d'un élément, en coordonnées de la toile (pour placer des effets
-- dans un calque plein écran, ex. Effects.Burst(layer, UDim2.fromOffset(...)))
function Interface.GetCanvasCenter(guiObject: GuiObject): Vector2
	return Interface.ScreenToCanvas(guiObject.AbsolutePosition + guiObject.AbsoluteSize / 2)
end

-- Même chose, mais sous forme de UDim2 prête à l'emploi
function Interface.CanvasPosition(guiObject: GuiObject, offset: Vector2?): UDim2
	local center = Interface.GetCanvasCenter(guiObject) + (offset or Vector2.zero)
	return UDim2.fromOffset(center.X, center.Y)
end

return Interface
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="96">
        <Properties>
          <string name="Name">Minigames</string>
        </Properties>
        <Item class="ModuleScript" referent="97">
          <Properties>
            <string name="Name">DuelKit</string>
            <string name="Source"><![CDATA[--[[
	DuelKit (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Minigames > DuelKit

	Petits outils partagés par les duels de l'arcade (Duel_*) :
	  - Label(props)            : texte néon (police du thème) ;
	  - Banner(parent, api)     : bandeau d'état en haut du plateau ("À toi !", "Bob réfléchit...") ;
	  - Countdown(parent)       : gros compte à rebours 3, 2, 1 (début des jeux en manches) ;
	  - Pulse(instance, props)  : animation douce en boucle (une seule Tween, rien par image) ;
	  - Track(api, duel, fn)    : suit l'état du duel (duelUpdate / duelEnd) et appelle fn(état, genre).
	Ce n'est PAS un jeu : le panneau Arcade ne charge que les modules "Solo_*" / "Duel_*".
]]

local TweenService = game:GetService("TweenService")

local Client = script.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)

local Kit = {}

local WHITE = Color3.new(1, 1, 1)

function Kit.Label(props)
	local label = UIUtil.Create("TextLabel", {
		Name = props.Name or "Label",
		BackgroundTransparency = 1,
		Font = props.Font or Theme.Fonts.Title,
		Text = props.Text or "",
		TextColor3 = props.Color or WHITE,
		TextSize = props.TextSize or 16,
		TextXAlignment = props.XAlign or Enum.TextXAlignment.Center,
		TextYAlignment = props.YAlign or Enum.TextYAlignment.Center,
		TextWrapped = props.Wrapped == true,
		Size = props.Size or UDim2.new(1, 0, 0, 20),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		ZIndex = props.ZIndex or 30,
		Parent = props.Parent,
	})
	return label
end

-- Animation en boucle aller-retour (coupée par Stop / Destroy de l'objet)
function Kit.Pulse(instance: Instance, props, duration: number?): Tween
	local tween = TweenService:Create(
		instance,
		TweenInfo.new(duration or 0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		props
	)
	tween:Play()
	return tween
end

-- Bandeau d'état (pastille arrondie en haut, texte + couleur)
function Kit.Banner(parent: Instance, zIndex: number?)
	local z = zIndex or 30
	local frame = UIUtil.Create("Frame", {
		Name = "Banner",
		Size = UDim2.fromOffset(0, 34),
		AutomaticSize = Enum.AutomaticSize.X,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		BackgroundColor3 = Color3.fromRGB(40, 26, 84),
		ZIndex = z,
		Parent = parent,
	})
	UIUtil.Corner(frame, UDim.new(1, 0))
	local stroke = UIUtil.Stroke(frame, WHITE, 2, 0.2)
	UIUtil.Create("UIPadding", { PaddingLeft = UDim.new(0, 18), PaddingRight = UDim.new(0, 18), Parent = frame })
	local label = UIUtil.Create("TextLabel", {
		Name = "Text",
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = "",
		TextColor3 = WHITE,
		TextSize = 17,
		ZIndex = z + 1,
		Parent = frame,
	})
	local scale = UIUtil.Create("UIScale", { Parent = frame })
	local banner = {}
	function banner.Set(text: string, color: Color3, pop: boolean?)
		if label.Text == text and stroke.Color == color then
			return
		end
		label.Text = text
		stroke.Color = color
		frame.BackgroundColor3 = color:Lerp(Color3.fromRGB(24, 14, 48), 0.72)
		if pop then
			scale.Scale = 1.15
			UIUtil.Tween(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		end
	end
	banner.Frame = frame
	return banner
end

-- Gros compte à rebours (3, 2, 1) au centre
function Kit.Countdown(parent: Instance, zIndex: number?)
	local z = zIndex or 40
	local label = Kit.Label({
		Name = "Countdown",
		Text = "",
		TextSize = 96,
		Font = Theme.Fonts.Number,
		Color = Color3.fromRGB(255, 216, 74),
		Size = UDim2.fromOffset(200, 120),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		ZIndex = z,
		Parent = parent,
	})
	label.Visible = false
	UIUtil.Create("UIStroke", { Color = Color3.fromRGB(255, 79, 176), Thickness = 3, Parent = label })
	local scale = UIUtil.Create("UIScale", { Parent = label })
	local token = 0
	local countdown = {}
	-- Affiche seconds, seconds-1, ... 1 puis "GO!"
	function countdown.Run(seconds: number, sound: ((string, number?) -> ())?)
		token += 1
		local mine = token
		local whole = math.max(1, math.ceil(seconds - 0.05))
		local offset = seconds - (whole - 1) - 1
		label.Visible = true
		local function show(value: string)
			if token ~= mine then
				return
			end
			label.Text = value
			scale.Scale = 1.6
			label.TextTransparency = 0
			UIUtil.Tween(scale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
			if sound then
				sound("Click", value == "GO!" and 1.6 or 1.1)
			end
		end
		for index = 0, whole - 1 do
			task.delay(math.max(0, offset) + index, show, tostring(whole - index))
		end
		task.delay(math.max(0, offset) + whole, function()
			show("GO!")
			task.delay(0.5, function()
				if token == mine then
					label.Visible = false
				end
			end)
		end)
	end
	function countdown.Hide()
		token += 1
		label.Visible = false
	end
	return countdown
end

-- Suit l'état du duel : callback(état, genre) à chaque mise à jour du MÊME duel
function Kit.Track(api, callback: (any, string) -> ())
	local duelId = api.Duel and api.Duel.Id
	return api.OnEvent(function(kind: string, payload)
		if (kind == "duelUpdate" or kind == "duelEnd" or kind == "duelStart") and type(payload) == "table" and payload.Id == duelId then
			callback(payload, kind)
		end
	end)
end

return Kit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="98">
          <Properties>
            <string name="Name">Duel_Connect4</string>
            <string name="Source"><![CDATA[--[[
	Duel_Connect4 (ModuleScript) — 🔴 Puissance 4 en duel
	Emplacement : ReplicatedStorage > Client > Minigames > Duel_Connect4

	Grille 7 x 6 (ArcadeConfig.Logic) : on choisit une COLONNE, le serveur fait
	tomber le jeton (case la plus basse libre), vérifie le tour et les 4
	alignés. Jetons roses (place 1) / cyan (place 2), chute animée avec
	rebond, jeton fantôme au survol de la colonne, jetons gagnants qui brillent.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent
local UIUtil = require(Client.UIUtil)
local Kit = require(script.Parent.DuelKit)
local ArcadeConfig = require(ReplicatedStorage.Shared.ArcadeConfig)

local Game = { Id = "Connect4", Kind = "Duel" }

local Logic = ArcadeConfig.Logic
local COLS, ROWS = Logic.C4Cols, Logic.C4Rows
local WHITE = Color3.new(1, 1, 1)
local HOLE = Color3.fromRGB(18, 10, 40)

function Game.Build(container: Frame, api)
	local T = api.T
	local colors = api.Colors
	local seatColors = api.SeatColors or { colors.Pink, colors.Cyan }
	local duel = api.Duel
	local you = api.Seat or 1
	local connections = {}
	local pulses = {}
	local pending = false

	local banner = Kit.Banner(container, 30)

	local area = UIUtil.Create("Frame", {
		Name = "Area",
		Size = UDim2.new(1, -40, 1, -64),
		Position = UDim2.fromOffset(20, 52),
		BackgroundTransparency = 1,
		ZIndex = 22,
		Parent = container,
	})
	-- Cadre : rangée "lanceur" (jeton fantôme) + grille bleue
	local frame = UIUtil.Create("Frame", {
		Name = "Frame",
		Size = UDim2.fromScale(1, 1),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = 22,
		Parent = area,
	})
	-- 7 colonnes x (6 lignes + 0,8 de lanceur)
	UIUtil.Create("UIAspectRatioConstraint", { AspectRatio = COLS / (ROWS + 0.8), Parent = frame })
	UIUtil.Create("UISizeConstraint", { MaxSize = Vector2.new(470, 460), Parent = frame })
	local launcherShare = 0.8 / (ROWS + 0.8)

	local grid = UIUtil.Create("Frame", {
		Name = "Grid",
		Size = UDim2.fromScale(1, 1 - launcherShare),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		BackgroundColor3 = WHITE,
		ZIndex = 24,
		Parent = frame,
	})
	UIUtil.Corner(grid, 18)
	UIUtil.Stroke(grid, Color3.fromRGB(160, 170, 255), 2.5, 0.1)
	UIUtil.Create("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(120, 110, 255), Color3.fromRGB(50, 34, 170)),
		Rotation = 90,
		Parent = grid,
	})

	-- Couche des jetons (derrière la grille : on les voit par les trous)
	local discsLayer = UIUtil.Create("Frame", {
		Name = "Discs",
		Size = UDim2.fromScale(1, 1 - launcherShare),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		BackgroundTransparency = 1,
		ZIndex = 26,
		Parent = frame,
	})

	local cellW, cellH = 1 / COLS, 1 / ROWS
	local function cellPosition(row: number, col: number): UDim2
		return UDim2.fromScale((col - 0.5) * cellW, (row - 0.5) * cellH)
	end

	-- Trous (anneaux sombres)
	for row = 1, ROWS do
		for col = 1, COLS do
			local hole = UIUtil.Create("Frame", {
				Name = "Hole",
				Size = UDim2.fromScale(cellW * 0.78, cellH * 0.78),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = cellPosition(row, col),
				BackgroundColor3 = HOLE,
				BackgroundTransparency = 0.05,
				ZIndex = 25,
				Parent = grid,
			})
			UIUtil.Corner(hole, UDim.new(1, 0))
			UIUtil.Stroke(hole, Color3.fromRGB(30, 20, 110), 2, 0.2)
		end
	end

	local function makeDisc(parent: Instance, seat: number, ghost: boolean): Frame
		local color = seatColors[seat]
		local disc = UIUtil.Create("Frame", {
			Name = "Disc",
			Size = UDim2.fromScale(cellW * 0.74, cellH * 0.74),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = color,
			BackgroundTransparency = ghost and 0.5 or 0,
			ZIndex = 27,
			Parent = parent,
		})
		UIUtil.Corner(disc, UDim.new(1, 0))
		UIUtil.Stroke(disc, color:Lerp(WHITE, 0.5), 2, ghost and 0.5 or 0.1)
		UIUtil.Create("UIGradient", {
			Color = ColorSequence.new(color:Lerp(WHITE, 0.35), color:Lerp(Color3.new(0, 0, 0), 0.15)),
			Rotation = 60,
			Parent = disc,
		})
		local shine = UIUtil.Create("Frame", {
			Size = UDim2.fromScale(0.32, 0.18),
			Position = UDim2.fromScale(0.22, 0.16),
			Rotation = -25,
			BackgroundColor3 = WHITE,
			BackgroundTransparency = ghost and 0.8 or 0.45,
			ZIndex = 28,
			Parent = disc,
		})
		UIUtil.Corner(shine, UDim.new(1, 0))
		return disc
	end

	-- Jeton fantôme au-dessus de la colonne survolée
	local launcher = UIUtil.Create("Frame", {
		Name = "Launcher",
		Size = UDim2.fromScale(1, launcherShare),
		BackgroundTransparency = 1,
		ZIndex = 26,
		Parent = frame,
	})
	local ghost = makeDisc(launcher, you, true)
	ghost.Size = UDim2.fromScale(cellW * 0.7, 0.9)
	UIUtil.Create("UIAspectRatioConstraint", { AspectRatio = 1, Parent = ghost })
	ghost.Position = UDim2.fromScale(0.5 * cellW, 0.5)
	ghost.Visible = false
	-- Flèche vers le bas DESSINÉE (le caractère ▼ n'existe pas dans les polices Roblox)
	UIUtil.Icon("Down", { Name = "Arrow", Size = 14, Color = seatColors[you], Transparency = 0.1, AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, 2), ZIndex = 29, Parent = ghost })

	local discs = {} -- [index] = Frame
	local function myTurn(): boolean
		return duel and not duel.Over and duel.Phase == "play" and duel.Turn == you
	end

	local hoverCol: number? = nil
	local function showGhost(col: number?)
		hoverCol = col
		if col and myTurn() and not pending then
			ghost.Visible = true
			ghost.Position = UDim2.fromScale((col - 0.5) * cellW, 0.5)
		else
			ghost.Visible = false
		end
	end

	-- Chute d'un jeton : de la rangée du lanceur jusqu'à sa case
	local function dropDisc(index: number, seat: number, animate: boolean)
		local row = math.floor((index - 1) / COLS) + 1
		local col = (index - 1) % COLS + 1
		local disc = makeDisc(discsLayer, seat, false)
		disc.Name = "Disc" .. index
		local target = cellPosition(row, col)
		if animate then
			disc.Position = UDim2.fromScale((col - 0.5) * cellW, -0.5 * cellH)
			UIUtil.Tween(disc, 0.25 + row * 0.06, { Position = target }, Enum.EasingStyle.Bounce)
		else
			disc.Position = target
		end
		discs[index] = disc
	end

	-- Colonnes cliquables (au-dessus de tout, transparentes)
	for col = 1, COLS do
		local button = UIUtil.Create("TextButton", {
			Name = "Col" .. col,
			Size = UDim2.fromScale(cellW, 1),
			Position = UDim2.fromScale((col - 1) * cellW, 0),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Text = "",
			ZIndex = 35,
			Parent = frame,
		})
		table.insert(connections, button.MouseEnter:Connect(function()
			showGhost(col)
			if myTurn() then
				button.BackgroundTransparency = 0.93
			end
		end))
		table.insert(connections, button.MouseLeave:Connect(function()
			button.BackgroundTransparency = 1
			if hoverCol == col then
				showGhost(nil)
			end
		end))
		table.insert(connections, button.Activated:Connect(function()
			if not myTurn() or pending then
				api.Sounds.Play("Error", 0.8)
				return
			end
			if not Logic.C4Drop(duel.Board, col) then
				api.Sounds.Play("Error", 0.8)
				UIUtil.Shake(button)
				return
			end
			pending = true
			ghost.Visible = false
			api.Sounds.Play("Pop", 1.15)
			task.spawn(function()
				local ok, message = api.Move(col)
				pending = false
				if not ok and type(message) == "string" then
					api.Notify(message, colors.Red)
				end
			end)
		end))
	end

	local function render(state, kind: string?)
		duel = state
		local board = state.Board or {}
		for index = 1, COLS * ROWS do
			local seat = board[index] or 0
			if seat ~= 0 and not discs[index] then
				dropDisc(index, seat, kind ~= "duelStart")
				if index == state.Last and seat ~= you then
					api.Sounds.Play("Pop", 0.9)
				end
			end
		end
		if state.Line then
			local winners = {}
			for _, index in ipairs(state.Line) do
				winners[index] = true
				local disc = discs[index]
				if disc then
					local stroke = disc:FindFirstChildOfClass("UIStroke")
					if stroke then
						stroke.Color = WHITE
						stroke.Thickness = 4
						stroke.Transparency = 0
						table.insert(pulses, Kit.Pulse(stroke, { Transparency = 0.7 }, 0.4))
					end
				end
			end
			for index, disc in pairs(discs) do
				if not winners[index] then
					disc.BackgroundTransparency = 0.45
				end
			end
		end
		showGhost(hoverCol)
		if state.Over then
			if state.Winner == you then
				banner.Set(T("🏆 Four in a row! You win!"), colors.Yellow, kind == "duelEnd")
			elseif state.Winner == 0 then
				banner.Set(T("🤝 Draw!"), colors.Cyan, kind == "duelEnd")
			else
				banner.Set(T("💔 You lose..."), colors.Red, kind == "duelEnd")
			end
		elseif state.Turn == you then
			banner.Set(T("Your turn! Pick a column"), seatColors[you], true)
		else
			local other = state.Players and state.Players[3 - you]
			banner.Set(T("%s is thinking...", other and other.Name or "?"), seatColors[3 - you], false)
		end
	end

	render(duel, "duelStart")
	table.insert(connections, Kit.Track(api, render))

	return {
		Destroy = function()
			for _, tween in ipairs(pulses) do
				tween:Cancel()
			end
			UIUtil.DisconnectAll(connections)
			area:Destroy()
			banner.Frame:Destroy()
		end,
	}
end

return Game
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="99">
          <Properties>
            <string name="Name">Duel_ReactionDuel</string>
            <string name="Source"><![CDATA[--[[
	Duel_ReactionDuel (ModuleScript) — ⚡ Duel de réflexes
	Emplacement : ReplicatedStorage > Client > Minigames > Duel_ReactionDuel

	Un gros bouton rond : "Attends..." (violet) puis "TAPE !" (vert) quand le
	SERVEUR donne le départ. Le premier qui tape gagne la manche (le serveur
	mesure le temps et compense la latence) ; taper trop tôt = faux départ, le
	point va à l'adversaire. Premier à ArcadeConfig WinScore points.
	Clavier : barre d'espace (ordinateur).
]]

local UserInputService = game:GetService("UserInputService")

local Client = script.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local Kit = require(script.Parent.DuelKit)

local Game = { Id = "ReactionDuel", Kind = "Duel" }

local WHITE = Color3.new(1, 1, 1)
local WAIT_COLOR = Color3.fromRGB(120, 60, 220)
local GO_COLOR = Color3.fromRGB(60, 225, 120)
local IDLE_COLOR = Color3.fromRGB(70, 56, 130)

function Game.Build(container: Frame, api)
	local T = api.T
	local colors = api.Colors
	local seatColors = api.SeatColors or { colors.Pink, colors.Cyan }
	local duel = api.Duel
	local you = api.Seat or 1
	local connections = {}
	local tapped = false
	local lastRound = -1
	local lastPhase = ""
	local goAt = 0

	local banner = Kit.Banner(container, 30)
	local countdown = Kit.Countdown(container, 45)

	local area = UIUtil.Create("Frame", {
		Name = "Area",
		Size = UDim2.new(1, -40, 1, -110),
		Position = UDim2.fromOffset(20, 52),
		BackgroundTransparency = 1,
		ZIndex = 22,
		Parent = container,
	})
	-- Support carré (halo + gros bouton rond, frères : le bouton reste au-dessus du halo)
	local holder = UIUtil.Create("Frame", {
		Name = "PadHolder",
		Size = UDim2.fromScale(1, 1),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = 22,
		Parent = area,
	})
	UIUtil.Create("UIAspectRatioConstraint", { AspectRatio = 1, Parent = holder })
	UIUtil.Create("UISizeConstraint", { MaxSize = Vector2.new(250, 250), Parent = holder })
	local halo = UIUtil.Create("Frame", {
		Name = "Halo",
		Size = UDim2.fromScale(1.22, 1.22),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundColor3 = WAIT_COLOR,
		BackgroundTransparency = 0.8,
		ZIndex = 23,
		Parent = holder,
	})
	UIUtil.Corner(halo, UDim.new(1, 0))
	local pad = UIUtil.Create("TextButton", {
		Name = "Pad",
		Size = UDim2.fromScale(1, 1),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundColor3 = IDLE_COLOR,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 24,
		Parent = holder,
	})
	UIUtil.Corner(pad, UDim.new(1, 0))
	local padStroke = UIUtil.Stroke(pad, WHITE, 4, 0.15)
	UIUtil.Create("UIGradient", { Color = ColorSequence.new(WHITE, Color3.fromRGB(170, 170, 200)), Rotation = 90, Parent = pad })
	local padScale = UIUtil.Create("UIScale", { Parent = pad })
	local padIcon = Kit.Label({ Text = "⚡", TextSize = 60, Size = UDim2.fromScale(1, 0.4), Position = UDim2.fromScale(0, 0.14), ZIndex = 26, Parent = pad })
	local padText = Kit.Label({ Text = "", TextSize = 30, Font = Theme.Fonts.Number, Size = UDim2.fromScale(0.9, 0.2),
		Position = UDim2.fromScale(0.05, 0.56), ZIndex = 26, Parent = pad })
	UIUtil.Create("UIStroke", { Color = Color3.fromRGB(30, 10, 60), Thickness = 2, Transparency = 0.3, Parent = padText })
	local haloPulse = Kit.Pulse(halo, { BackgroundTransparency = 0.55 }, 0.6)

	-- Ligne du bas : manche, aide, temps
	local info = Kit.Label({ Text = "", TextSize = 16, Color = colors.TextDim, Size = UDim2.new(1, -40, 0, 22),
		AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -34), ZIndex = 30, Parent = container })
	local times = Kit.Label({ Text = "", TextSize = 18, Color = colors.Yellow, Size = UDim2.new(1, -40, 0, 24),
		AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), ZIndex = 30, Parent = container })

	local function setPad(color: Color3, icon: string, label: string)
		pad.BackgroundColor3 = color
		halo.BackgroundColor3 = color
		padIcon.Text = icon
		padText.Text = label
	end

	local function nameOf(seat: number): string
		if seat == you then
			return T("You")
		end
		local other = duel.Players and duel.Players[seat]
		return other and other.Name or "?"
	end

	local function tap()
		if not duel or duel.Over or tapped then
			return
		end
		if duel.Phase ~= "wait" and duel.Phase ~= "go" then
			return
		end
		tapped = true
		padScale.Scale = 0.9
		UIUtil.Tween(padScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
		if duel.Phase == "go" then
			api.Sounds.Play("Pop", 1.4)
			local mine = os.clock() - goAt
			times.Text = T("Your tap: %s s", string.format("%.3f", mine))
		end
		task.spawn(api.Move, "tap")
	end

	table.insert(connections, pad.Activated:Connect(tap))
	table.insert(connections, UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.Space then
			tap()
		end
	end))

	local function render(state, kind: string?)
		duel = state
		local phase = state.Phase or ""
		local round = state.Round or 0
		local newPhase = phase ~= lastPhase or round ~= lastRound
		lastPhase, lastRound = phase, round
		local winScore = state.WinScore or 3
		info.Text = round > 0 and T("Round %d • first to %d points", round, winScore) or T("First to %d points", winScore)

		if state.Over then
			countdown.Hide()
			local won = state.Winner == you
			setPad(won and colors.Yellow or (state.Winner == 0 and colors.Cyan or colors.Red), won and "🏆" or (state.Winner == 0 and "🤝" or "💔"),
				won and T("WINNER!") or (state.Winner == 0 and T("DRAW") or T("DEFEAT")))
			banner.Set(won and T("🏆 Fastest fingers in the arcade!") or (state.Winner == 0 and T("🤝 Draw!") or T("💔 Too slow this time...")),
				won and colors.Yellow or colors.Red, kind == "duelEnd")
			return
		end
		if phase == "intro" then
			setPad(IDLE_COLOR, "⚡", T("Ready?"))
			banner.Set(T("Tap the moment it turns GREEN!"), colors.Yellow, false)
			if newPhase then
				countdown.Run(state.PhaseLeft or 3, api.Sounds.Play)
			end
		elseif phase == "wait" then
			if newPhase then
				tapped = false
				times.Text = ""
			end
			setPad(WAIT_COLOR, "✋", tapped and T("Too early!") or T("Wait..."))
			banner.Set(T("Wait for it... don't tap yet!"), colors.Purple, newPhase)
		elseif phase == "go" then
			if newPhase then
				goAt = os.clock()
				api.Sounds.Play("Bonus", 1.3)
				padScale.Scale = 1.12
				UIUtil.Tween(padScale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)
			end
			setPad(GO_COLOR, "👆", tapped and T("Tapped!") or T("TAP!"))
			banner.Set(T("GO GO GO!"), GO_COLOR, newPhase)
		elseif phase == "result" then
			local result = state.RoundResult or {}
			local winner = result.Winner or 0
			if result.Void then
				setPad(IDLE_COLOR, "💤", T("Nobody tapped"))
				banner.Set(T("Round replayed"), colors.TextDim, newPhase)
			elseif result.FalseStart then
				local cheater = result.FalseStart
				setPad(cheater == you and colors.Red or colors.Green, cheater == you and "😵" or "😏",
					cheater == you and T("False start!") or T("Point for you!"))
				banner.Set(T("False start by %s!", nameOf(cheater)), colors.Orange, newPhase)
			else
				local won = winner == you
				setPad(won and colors.Green or colors.Red, won and "⚡" or "🐢", won and T("Point!") or T("Too slow!"))
				banner.Set(T("%s wins the round!", nameOf(winner)), seatColors[winner] or colors.Yellow, newPhase)
				local t = result.Times or {}
				local mineTime, theirTime = t[you] or -1, t[3 - you] or -1
				local function fmt(value: number): string
					return value >= 0 and string.format("%.3f s", value) or "—"
				end
				times.Text = T("You: %s   •   %s: %s", fmt(mineTime), nameOf(3 - you), fmt(theirTime))
				if newPhase then
					api.Sounds.Play(won and "Bonus" or "Error", won and 1.1 or 0.8)
				end
			end
		end
		padStroke.Color = phase == "go" and WHITE or Color3.fromRGB(220, 200, 255)
	end

	render(duel, "duelStart")
	table.insert(connections, Kit.Track(api, render))

	return {
		Destroy = function()
			haloPulse:Cancel()
			countdown.Hide()
			UIUtil.DisconnectAll(connections)
			area:Destroy()
			info:Destroy()
			times:Destroy()
			banner.Frame:Destroy()
		end,
	}
end

return Game
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="100">
          <Properties>
            <string name="Name">Duel_SpotRace</string>
            <string name="Source"><![CDATA[--[[
	Duel_SpotRace (ModuleScript) — 🔎 Course "Trouve l'intrus"
	Emplacement : ReplicatedStorage > Client > Minigames > Duel_SpotRace

	Les deux joueurs voient la MÊME grille d'emojis (envoyée par le serveur) :
	un seul est différent. Le premier qui le touche marque le point. Une
	erreur bloque le joueur un court instant (vérifié par le serveur). Les
	grilles grandissent (4x4, 5x5, 6x6). Premier à WinScore points.
	Les cases sont réutilisées d'une manche à l'autre (pas de recréation).
]]

local Client = script.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local Kit = require(script.Parent.DuelKit)

local Game = { Id = "SpotRace", Kind = "Duel" }

local WHITE = Color3.new(1, 1, 1)
local CELL = Color3.fromRGB(48, 34, 100)
local MAX_SIZE = 6

function Game.Build(container: Frame, api)
	local T = api.T
	local colors = api.Colors
	local seatColors = api.SeatColors or { colors.Pink, colors.Cyan }
	local duel = api.Duel
	local you = api.Seat or 1
	local connections = {}
	local lockedUntil = 0
	local lastKey = ""

	local banner = Kit.Banner(container, 30)
	local countdown = Kit.Countdown(container, 45)

	local area = UIUtil.Create("Frame", {
		Name = "Area",
		Size = UDim2.new(1, -40, 1, -92),
		Position = UDim2.fromOffset(20, 52),
		BackgroundTransparency = 1,
		ZIndex = 22,
		Parent = container,
	})
	local board = UIUtil.Create("Frame", {
		Name = "Board",
		Size = UDim2.fromScale(1, 1),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundColor3 = Color3.fromRGB(26, 16, 56),
		ZIndex = 22,
		Parent = area,
	})
	UIUtil.Create("UIAspectRatioConstraint", { AspectRatio = 1, Parent = board })
	UIUtil.Create("UISizeConstraint", { MaxSize = Vector2.new(380, 380), Parent = board })
	UIUtil.Corner(board, 18)
	local boardStroke = UIUtil.Stroke(board, colors.Green, 2.5, 0.15)
	UIUtil.Create("UIPadding", {
		PaddingLeft = UDim.new(0.03, 0), PaddingRight = UDim.new(0.03, 0),
		PaddingTop = UDim.new(0.03, 0), PaddingBottom = UDim.new(0.03, 0),
		Parent = board,
	})
	local gridLayout = UIUtil.Create("UIGridLayout", {
		CellSize = UDim2.new(0.25, -6, 0.25, -6),
		CellPadding = UDim2.fromOffset(6, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Parent = board,
	})
	-- Voile "bloqué" après une erreur
	local lock = UIUtil.Create("TextLabel", {
		Name = "Lock",
		Size = UDim2.fromScale(1, 1),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundColor3 = Color3.fromRGB(60, 10, 30),
		BackgroundTransparency = 0.35,
		Font = Theme.Fonts.Number,
		Text = "🔒",
		TextColor3 = WHITE,
		TextSize = 48,
		Visible = false,
		ZIndex = 40,
		Parent = area,
	})
	UIUtil.Create("UIAspectRatioConstraint", { AspectRatio = 1, Parent = lock })
	UIUtil.Create("UISizeConstraint", { MaxSize = Vector2.new(380, 380), Parent = lock })
	UIUtil.Corner(lock, 18)

	local info = Kit.Label({ Text = "", TextSize = 15, Color = colors.TextDim, Size = UDim2.new(1, -40, 0, 22),
		AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -8), ZIndex = 30, Parent = container })

	-- Réserve de 36 cases (6 x 6), seules Size x Size sont visibles
	local cells = {}
	local function onCell(index: number)
		if not duel or duel.Over or duel.Phase ~= "play" then
			return
		end
		local now = os.clock()
		if now < lockedUntil then
			api.Sounds.Play("Error", 0.7)
			return
		end
		local cell = cells[index]
		api.Sounds.Play("Click", 1.3)
		task.spawn(function()
			local ok, result = api.Move(index)
			if type(result) == "table" and (result.Wrong or result.Locked) then
				local seconds = tonumber(result.Locked) or 1
				lockedUntil = os.clock() + seconds
				api.Sounds.Play("Error", 0.8)
				cell.BackgroundColor3 = colors.Red
				UIUtil.Shake(cell)
				lock.Visible = true
				lock.Text = "🔒"
				task.delay(seconds, function()
					if os.clock() >= lockedUntil - 0.01 then
						lock.Visible = false
						if cell.Parent then
							cell.BackgroundColor3 = CELL
						end
					end
				end)
			elseif ok and type(result) == "table" and result.Found then
				api.Sounds.Play("Bonus", 1.2)
			end
		end)
	end
	for index = 1, MAX_SIZE * MAX_SIZE do
		local cell = UIUtil.Create("TextButton", {
			Name = "Cell" .. index,
			BackgroundColor3 = CELL,
			AutoButtonColor = false,
			Font = Theme.Fonts.Title,
			Text = "",
			TextScaled = true,
			TextColor3 = WHITE,
			LayoutOrder = index,
			Visible = false,
			ZIndex = 24,
			Parent = board,
		})
		UIUtil.Corner(cell, 10)
		UIUtil.Stroke(cell, Color3.fromRGB(120, 100, 210), 1.5, 0.55)
		UIUtil.Create("UIPadding", {
			PaddingLeft = UDim.new(0.14, 0), PaddingRight = UDim.new(0.14, 0),
			PaddingTop = UDim.new(0.14, 0), PaddingBottom = UDim.new(0.14, 0),
			Parent = cell,
		})
		cells[index] = cell
		table.insert(connections, cell.Activated:Connect(function()
			onCell(index)
		end))
	end

	local function resetCells(size: number)
		gridLayout.CellSize = UDim2.new(1 / size, -6, 1 / size, -6)
		for index, cell in ipairs(cells) do
			cell.Visible = index <= size * size
			cell.BackgroundColor3 = CELL
			cell.TextTransparency = 0
			local stroke = cell:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Color = Color3.fromRGB(120, 100, 210)
				stroke.Thickness = 1.5
				stroke.Transparency = 0.55
			end
		end
	end

	local function nameOf(seat: number): string
		if seat == you then
			return T("You")
		end
		local other = duel.Players and duel.Players[seat]
		return other and other.Name or "?"
	end

	local function render(state, kind: string?)
		duel = state
		local phase = state.Phase or ""
		local round = state.Round or 0
		local key = phase .. ":" .. round
		local changed = key ~= lastKey
		lastKey = key
		local winScore = state.WinScore or 4
		info.Text = round > 0 and T("Round %d • first to %d finds", round, winScore) or T("First to %d finds", winScore)

		if phase == "intro" then
			resetCells(4)
			for index = 1, 16 do
				cells[index].Text = "❔"
				cells[index].TextTransparency = 0.5
			end
			banner.Set(T("Find the odd emoji before your rival!"), colors.Green, false)
			if changed then
				countdown.Run(state.PhaseLeft or 3, api.Sounds.Play)
			end
		elseif phase == "play" and state.Grid then
			if changed then
				countdown.Hide()
				lock.Visible = false
				lockedUntil = 0
				local grid = state.Grid
				resetCells(grid.Size)
				for index, emoji in ipairs(grid.Cells) do
					local cell = cells[index]
					if cell then
						cell.Text = emoji
					end
				end
				board.Size = UDim2.fromScale(0.92, 0.92)
				UIUtil.Tween(board, 0.25, { Size = UDim2.fromScale(1, 1) }, Enum.EasingStyle.Back)
				api.Sounds.Play("Pop", 1)
			end
			banner.Set(T("Find the odd one out!"), colors.Green, changed)
			boardStroke.Color = colors.Green
		elseif phase == "result" then
			local result = state.RoundResult or {}
			local winner = result.Winner or 0
			local odd = result.Odd
			if odd and cells[odd] then
				local color = winner == 0 and colors.Yellow or seatColors[winner]
				local cell = cells[odd]
				cell.BackgroundColor3 = color:Lerp(CELL, 0.35)
				local stroke = cell:FindFirstChildOfClass("UIStroke")
				if stroke then
					stroke.Color = WHITE
					stroke.Thickness = 3
					stroke.Transparency = 0
				end
				if changed then
					UIUtil.Pop(cell, 1.4, 0.4)
				end
				for index, other in ipairs(cells) do
					if index ~= odd then
						other.TextTransparency = 0.6
					end
				end
			end
			lock.Visible = false
			if result.Void then
				banner.Set(T("Time's up! Here it was"), colors.Yellow, changed)
			elseif winner == you then
				banner.Set(T("Found it! +1 point (%ss)", tostring(result.Time or "?")), colors.Green, changed)
				if changed then
					api.Sounds.Play("Bonus", 1.25)
				end
			else
				banner.Set(T("%s was faster!", nameOf(winner)), seatColors[winner] or colors.Red, changed)
				if changed then
					api.Sounds.Play("Error", 0.8)
				end
			end
			boardStroke.Color = winner == 0 and colors.Yellow or (seatColors[winner] or colors.Green)
		end
		if state.Over then
			countdown.Hide()
			lock.Visible = false
			local won = state.Winner == you
			banner.Set(won and T("🏆 Eagle eyes! You win!") or (state.Winner == 0 and T("🤝 Draw!") or T("💔 You lose...")),
				won and colors.Yellow or colors.Red, kind == "duelEnd")
		end
	end

	render(duel, "duelStart")
	table.insert(connections, Kit.Track(api, render))

	return {
		Destroy = function()
			countdown.Hide()
			UIUtil.DisconnectAll(connections)
			area:Destroy()
			info:Destroy()
			banner.Frame:Destroy()
		end,
	}
end

return Game
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="101">
          <Properties>
            <string name="Name">Duel_TicTacToe</string>
            <string name="Source"><![CDATA[--[[
	Duel_TicTacToe (ModuleScript) — ⭕ Morpion en duel
	Emplacement : ReplicatedStorage > Client > Minigames > Duel_TicTacToe

	Plateau néon 3 x 3 : la place 1 joue ✕ (rose), la place 2 joue ◯ (cyan).
	Le client envoie seulement la case choisie (api.Move) ; le serveur vérifie
	le tour, la case libre et la victoire, puis renvoie l'état (duelUpdate).
	Aperçu immédiat du coup (semi-transparent) en attendant la réponse.
]]

local Client = script.Parent.Parent
local UIUtil = require(Client.UIUtil)
local Kit = require(script.Parent.DuelKit)

local Game = { Id = "TicTacToe", Kind = "Duel" }

local WHITE = Color3.new(1, 1, 1)
local CELL = Color3.fromRGB(44, 30, 92)
local CELL_HOVER = Color3.fromRGB(64, 46, 128)

function Game.Build(container: Frame, api)
	local T = api.T
	local colors = api.Colors
	local seatColors = api.SeatColors or { colors.Pink, colors.Cyan }
	local duel = api.Duel
	local you = api.Seat or 1
	local connections = {}
	local pulses = {}
	local pending: number? = nil

	local banner = Kit.Banner(container, 30)

	-- Plateau carré centré sous le bandeau
	local area = UIUtil.Create("Frame", {
		Name = "Area",
		Size = UDim2.new(1, -40, 1, -70),
		Position = UDim2.fromOffset(20, 56),
		BackgroundTransparency = 1,
		ZIndex = 22,
		Parent = container,
	})
	local board = UIUtil.Create("Frame", {
		Name = "Board",
		Size = UDim2.fromScale(1, 1),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundColor3 = Color3.fromRGB(28, 18, 60),
		ZIndex = 22,
		Parent = area,
	})
	UIUtil.Create("UIAspectRatioConstraint", { AspectRatio = 1, Parent = board })
	UIUtil.Create("UISizeConstraint", { MaxSize = Vector2.new(360, 360), Parent = board })
	UIUtil.Corner(board, 20)
	local boardStroke = UIUtil.Stroke(board, colors.Purple, 2.5, 0.1)
	UIUtil.Create("UIGradient", { Color = ColorSequence.new(seatColors[1], seatColors[2]), Rotation = 45, Parent = boardStroke })
	UIUtil.Create("UIPadding", {
		PaddingLeft = UDim.new(0.035, 0), PaddingRight = UDim.new(0.035, 0),
		PaddingTop = UDim.new(0.035, 0), PaddingBottom = UDim.new(0.035, 0),
		Parent = board,
	})
	UIUtil.Create("UIGridLayout", {
		CellSize = UDim2.new(1 / 3, -8, 1 / 3, -8),
		CellPadding = UDim2.new(0, 12, 0, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Parent = board,
	})

	-- Marques : ✕ = deux barres croisées, ◯ = anneau
	local function drawMark(cell: GuiObject, seat: number, ghost: boolean)
		local old = cell:FindFirstChild("Mark")
		if old then
			old:Destroy()
		end
		local color = seatColors[seat]
		local mark = UIUtil.Create("Frame", {
			Name = "Mark",
			Size = UDim2.fromScale(0.62, 0.62),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			BackgroundTransparency = 1,
			ZIndex = 25,
			Parent = cell,
		})
		local alpha = ghost and 0.55 or 0
		if seat == 1 then
			for _, rotation in ipairs({ 45, -45 }) do
				local bar = UIUtil.Create("Frame", {
					Size = UDim2.new(1.2, 0, 0.2, 0),
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromScale(0.5, 0.5),
					Rotation = rotation,
					BackgroundColor3 = color,
					BackgroundTransparency = alpha,
					ZIndex = 26,
					Parent = mark,
				})
				UIUtil.Corner(bar, UDim.new(1, 0))
				UIUtil.Stroke(bar, color:Lerp(WHITE, 0.55), 2, math.max(alpha, 0.2))
			end
		else
			local ring = UIUtil.Create("Frame", {
				Size = UDim2.fromScale(1, 1),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				BackgroundTransparency = 1,
				ZIndex = 26,
				Parent = mark,
			})
			UIUtil.Corner(ring, UDim.new(1, 0))
			local stroke = UIUtil.Stroke(ring, color, 12, alpha)
			stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			local inner = UIUtil.Create("Frame", {
				Size = UDim2.fromScale(0.62, 0.62),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				BackgroundTransparency = 1,
				ZIndex = 27,
				Parent = ring,
			})
			UIUtil.Corner(inner, UDim.new(1, 0))
			UIUtil.Stroke(inner, color:Lerp(WHITE, 0.55), 2, math.max(alpha, 0.35))
		end
		local scale = UIUtil.Create("UIScale", { Scale = 0.3, Parent = mark })
		UIUtil.Tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
		return mark
	end

	local cells = {}
	local shown = table.create(9, 0) -- marques déjà dessinées (confirmées)

	local function myTurn(): boolean
		return duel and not duel.Over and duel.Phase == "play" and duel.Turn == you
	end

	for index = 1, 9 do
		local cell = UIUtil.Create("TextButton", {
			Name = "Cell" .. index,
			BackgroundColor3 = CELL,
			AutoButtonColor = false,
			Text = "",
			LayoutOrder = index,
			ZIndex = 23,
			Parent = board,
		})
		UIUtil.Corner(cell, 16)
		UIUtil.Stroke(cell, Color3.fromRGB(110, 84, 200), 1.5, 0.45)
		UIUtil.Gradient(cell, ColorSequence.new(WHITE, Color3.fromRGB(200, 196, 230)), 90)
		cells[index] = cell
		table.insert(connections, cell.MouseEnter:Connect(function()
			if myTurn() and duel.Board[index] == 0 and not pending then
				cell.BackgroundColor3 = CELL_HOVER
			end
		end))
		table.insert(connections, cell.MouseLeave:Connect(function()
			cell.BackgroundColor3 = CELL
		end))
		table.insert(connections, cell.Activated:Connect(function()
			if not myTurn() or duel.Board[index] ~= 0 or pending then
				api.Sounds.Play("Error", 0.8)
				UIUtil.Shake(cell)
				return
			end
			pending = index
			cell.BackgroundColor3 = CELL
			local ghost = drawMark(cell, you, true)
			api.Sounds.Play("Pop", 1.2)
			task.spawn(function()
				local ok, message = api.Move(index)
				if pending == index then
					pending = nil
				end
				if not ok then
					if ghost.Parent then
						ghost:Destroy()
					end
					if type(message) == "string" then
						api.Notify(message, colors.Red)
					end
				end
			end)
		end))
	end

	-- Dessine l'état reçu du serveur
	local function render(state, kind: string?)
		duel = state
		local marks = state.Board or {}
		for index = 1, 9 do
			local seat = marks[index] or 0
			local cell = cells[index]
			if seat ~= shown[index] then
				shown[index] = seat
				if seat ~= 0 then
					drawMark(cell, seat, false)
					if index == state.Last and seat ~= you then
						api.Sounds.Play("Pop", 0.95)
					end
				else
					local mark = cell:FindFirstChild("Mark")
					if mark then
						mark:Destroy()
					end
				end
			end
		end
		-- Ligne gagnante
		if state.Line then
			local winners = {}
			for _, index in ipairs(state.Line) do
				winners[index] = true
			end
			local color = seatColors[state.Winner] or colors.Yellow
			for index, cell in ipairs(cells) do
				if winners[index] then
					cell.BackgroundColor3 = color:Lerp(CELL, 0.45)
					local stroke = cell:FindFirstChildOfClass("UIStroke")
					if stroke then
						stroke.Color = color:Lerp(WHITE, 0.3)
						stroke.Transparency = 0
						stroke.Thickness = 3
						table.insert(pulses, Kit.Pulse(stroke, { Transparency = 0.6 }, 0.45))
					end
				else
					cell.BackgroundTransparency = 0.45
				end
			end
		end
		-- Bandeau
		if state.Over then
			if state.Winner == you then
				banner.Set(T("🏆 You win!"), colors.Yellow, kind == "duelEnd")
			elseif state.Winner == 0 then
				banner.Set(T("🤝 Draw!"), colors.Cyan, kind == "duelEnd")
			else
				banner.Set(T("💔 You lose..."), colors.Red, kind == "duelEnd")
			end
		elseif state.Turn == you then
			banner.Set(T("Your turn! Tap a square"), seatColors[you], true)
		else
			local other = state.Players and state.Players[3 - you]
			banner.Set(T("%s is thinking...", other and other.Name or "?"), seatColors[3 - you], false)
		end
	end

	render(duel, "duelStart")
	table.insert(connections, Kit.Track(api, render))

	return {
		Destroy = function()
			for _, tween in ipairs(pulses) do
				tween:Cancel()
			end
			UIUtil.DisconnectAll(connections)
			area:Destroy()
			banner.Frame:Destroy()
		end,
	}
end

return Game
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="102">
          <Properties>
            <string name="Name">Solo_Game2048</string>
            <string name="Source"><![CDATA[--[[
	Solo_Game2048 (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Minigames > Solo_Game2048

	🔢 2048 de l'arcade : fais glisser les tuiles (flèches / ZQSD / WASD ou
	glissé du doigt), deux tuiles égales fusionnent. Atteins la tuile
	objectif de ta difficulté !
	Les nouvelles tuiles viennent d'une graine donnée par le SERVEUR
	(Solo_Logic) : à la fin, le client envoie ses coups ("URDL...") et le
	serveur rejoue la partie pour calculer le vrai score.
	Tuiles réutilisées (pool), glissements animés dans la boucle commune.
]]

local Kit = require(script.Parent.Solo_Kit)
local Logic = Kit.Logic
local C = Kit.Colors
local create = Kit.Create

local SLIDE_TIME = 0.11
local SIZE = Logic.Games.Game2048.Size

-- Couleurs des tuiles (fond, texte)
local TILE_STYLE = {
	[2] = { Color3.fromRGB(255, 236, 250), Color3.fromRGB(110, 70, 150) },
	[4] = { Color3.fromRGB(255, 210, 236), Color3.fromRGB(120, 60, 140) },
	[8] = { Color3.fromRGB(255, 166, 204), C.White },
	[16] = { Color3.fromRGB(255, 132, 176), C.White },
	[32] = { Color3.fromRGB(255, 112, 140), C.White },
	[64] = { Color3.fromRGB(255, 86, 110), C.White },
	[128] = { Color3.fromRGB(255, 208, 90), Color3.fromRGB(120, 70, 20) },
	[256] = { Color3.fromRGB(120, 232, 170), Color3.fromRGB(20, 90, 60) },
	[512] = { Color3.fromRGB(100, 210, 255), Color3.fromRGB(20, 70, 110) },
	[1024] = { Color3.fromRGB(170, 140, 255), C.White },
	[2048] = { Color3.fromRGB(255, 200, 60), C.White },
}
local BIG_STYLE = { Color3.fromRGB(60, 30, 110), C.Yellow }

local Module = { Id = "Game2048", Kind = "Solo" }

function Module.Build(container: Frame, api)
	local kit
	local startGame: (string) -> ()
	local function T(text: string, ...): string
		return Kit.Translate(api, text, ...)
	end

	local st = {
		Sim = nil :: any,
		Rules = nil :: any,
		Moves = {} :: { string },
		Token = nil,
		Generation = 0,
		Playing = false,
		Anim = nil :: any, -- glissement en cours
		Clock = 0,
	}
	local tiles = {} -- [case] = tuile affichée
	local pool = {}

	kit = Kit.new(container, api, {
		Id = "Game2048",
		Primary = "Score",
		SmallA = "Next ⭐",
		SmallB = "Top tile",
		Details = function(_, rules)
			return T("Goal: the %s tile", tostring(rules.Target))
				.. "\n⭐ " .. rules.Thresholds[1] .. "  ·  ⭐⭐ " .. rules.Thresholds[2] .. "  ·  ⭐⭐⭐ " .. rules.Thresholds[3]
		end,
		BestText = function(value)
			return Kit.FormatNumber(value) .. " " .. T("pts")
		end,
		ScoreText = function(result)
			local text = "🔢 " .. Kit.FormatNumber(tonumber(result.Score) or 0) .. " " .. T("pts")
			if type(result.MaxTile) == "number" then
				text ..= "  ·  🏅 " .. tostring(result.MaxTile)
			end
			return text
		end,
		NoStarHint = function(rules)
			return T("Make a %s tile for your first ⭐!", tostring(rules.Thresholds[1]))
		end,
		LoseTitle = "No more moves!",
		OnPlay = function(difficulty)
			startGame(difficulty)
		end,
		OnPicker = function()
			st.Generation += 1
			st.Playing = false
		end,
		QuitArg = function()
			return { Moves = table.concat(st.Moves) }
		end,
	})
	kit.PickerHelp.Text = kit.Touch and T("Swipe to slide the tiles · Same numbers merge")
		or T("Arrow keys / WASD to slide · Same numbers merge")

	----------------------------------------------------------------------
	-- Plateau
	----------------------------------------------------------------------
	local board = create("Frame", {
		Name = "Board",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(40, 28, 88),
		ZIndex = 3,
		Parent = kit.Area,
	})
	Kit.Corner(board, 18)
	Kit.Stroke(board, kit.Accent, 2.5, 0.2)
	Kit.Gradient(board, Color3.fromRGB(64, 44, 128), Color3.fromRGB(34, 22, 74), 90)
	create("UIAspectRatioConstraint", { AspectRatio = 1, Parent = board })
	local grid = create("Frame", {
		Name = "Grid",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -14, 1, -14),
		BackgroundTransparency = 1,
		ZIndex = 4,
		Parent = board,
	})
	for index = 1, SIZE * SIZE do
		local x = (index - 1) % SIZE
		local y = (index - 1) // SIZE
		local slot = create("Frame", {
			Name = "Slot" .. index,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale((x + 0.5) / SIZE, (y + 0.5) / SIZE),
			Size = UDim2.fromScale(0.92 / SIZE, 0.92 / SIZE),
			BackgroundColor3 = Color3.fromRGB(24, 16, 56),
			BackgroundTransparency = 0.35,
			ZIndex = 4,
			Parent = grid,
		})
		Kit.Corner(slot, UDim.new(0.16, 0))
	end

	-- "Fin de partie" (encaisser)
	local finishButton = Kit.Button({
		Name = "Finish",
		Text = "🏁 " .. T("Finish"),
		Color = C.CardLight,
		Size = UDim2.new(1, 0, 0, 40),
		MaxTextSize = 17,
		ZIndex = 3,
		Parent = kit.Extra,
	})

	local function cellCenter(index: number): UDim2
		local x = (index - 1) % SIZE
		local y = (index - 1) // SIZE
		return UDim2.fromScale((x + 0.5) / SIZE, (y + 0.5) / SIZE)
	end

	local function styleTile(tile, value: number)
		tile.Value = value
		local style = TILE_STYLE[value] or BIG_STYLE
		tile.Frame.BackgroundColor3 = style[1]
		tile.Gradient.Color = ColorSequence.new(style[1]:Lerp(C.White, 0.3), style[1]:Lerp(C.Black, 0.08))
		tile.Text.Text = tostring(value)
		tile.Text.TextColor3 = style[2]
		local digits = #tostring(value)
		tile.Text.Size = UDim2.fromScale(digits >= 4 and 0.84 or (digits == 3 and 0.78 or 0.6), 0.6)
		tile.Stroke.Color = value >= 128 and C.White or style[1]:Lerp(C.White, 0.5)
		tile.Stroke.Transparency = value >= 128 and 0.1 or 0.4
		tile.Glow.Visible = value >= 128
		tile.Glow.BackgroundColor3 = style[1]
		tile.Rainbow.Enabled = value == 2048
	end

	local function takeTile()
		for _, tile in ipairs(pool) do
			if not tile.Used then
				tile.Used = true
				tile.Frame.Visible = true
				return tile
			end
		end
		local frame = create("Frame", {
			Name = "Tile",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromScale(0.92 / SIZE, 0.92 / SIZE),
			ZIndex = 6,
			Parent = grid,
		})
		Kit.Corner(frame, UDim.new(0.16, 0))
		local stroke = Kit.Stroke(frame, C.White, 2, 0.4)
		local gradientObj = create("UIGradient", { Rotation = 90, Parent = frame })
		local glow = create("Frame", {
			Name = "Glow",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(1.16, 1.16),
			BackgroundTransparency = 0.75,
			Visible = false,
			ZIndex = 5,
			Parent = frame,
		})
		Kit.Corner(glow, UDim.new(0.2, 0))
		local rainbow = create("UIGradient", {
			Enabled = false,
			Rotation = 45,
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 120, 200)),
				ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 220, 90)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(100, 220, 255)),
			}),
			Parent = glow,
		})
		local shine = create("Frame", {
			Position = UDim2.fromScale(0.1, 0.07),
			Size = UDim2.fromScale(0.5, 0.1),
			BackgroundColor3 = C.White,
			BackgroundTransparency = 0.6,
			ZIndex = 7,
			Parent = frame,
		})
		Kit.Corner(shine, UDim.new(1, 0))
		local text = Kit.Label({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.53),
			Size = UDim2.fromScale(0.6, 0.6),
			MaxTextSize = 44,
			ZIndex = 8,
			Parent = frame,
		})
		local tile = {
			Frame = frame,
			Stroke = stroke,
			Gradient = gradientObj,
			Glow = glow,
			Rainbow = rainbow,
			Text = text,
			Scale = create("UIScale", { Parent = frame }),
			Used = true,
			Value = 0,
		}
		table.insert(pool, tile)
		return tile
	end

	local function releaseTile(tile)
		tile.Used = false
		tile.Frame.Visible = false
	end

	local function spawnTile(index: number, value: number)
		local tile = takeTile()
		styleTile(tile, value)
		tile.Frame.Position = cellCenter(index)
		tile.Scale.Scale = 0.1
		Kit.Tween(tile.Scale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)
		tiles[index] = tile
	end

	local function clearTiles()
		for _, tile in ipairs(pool) do
			releaseTile(tile)
		end
		table.clear(tiles)
	end

	local function rebuildFromSim()
		clearTiles()
		local sim = st.Sim
		for index = 1, SIZE * SIZE do
			local value = sim.Cells[index]
			if value > 0 then
				local tile = takeTile()
				styleTile(tile, value)
				tile.Frame.Position = cellCenter(index)
				tile.Scale.Scale = 1
				tiles[index] = tile
			end
		end
	end

	----------------------------------------------------------------------
	-- Coups
	----------------------------------------------------------------------
	kit:UseRating(44)
	local function refreshHud()
		local sim = st.Sim
		if not sim or not st.Rules then
			return
		end
		kit:SetRatingFromScore(sim.MaxTile, st.Rules.Thresholds)
		kit:SetStat("Primary", Kit.FormatNumber(sim.Score))
		kit:SetStat("A", kit:NextStarText(sim.MaxTile, st.Rules.Thresholds))
		kit:SetStat("B", "🏅 " .. tostring(sim.MaxTile))
	end

	-- Termine l'animation en cours tout de suite (coup suivant très rapide)
	local function completeAnim()
		local anim = st.Anim
		if not anim then
			return
		end
		st.Anim = nil
		for _, move in ipairs(anim.Moving) do
			move.Tile.Frame.Position = cellCenter(move.To)
		end
		for _, tile in ipairs(anim.Dying) do
			releaseTile(tile)
		end
		local best = 0
		for _, entry in ipairs(anim.Upgrades) do
			styleTile(entry.Tile, entry.Value)
			entry.Tile.Scale.Scale = 1.22
			Kit.Tween(entry.Tile.Scale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)
			best = math.max(best, entry.Value)
			if entry.Value >= 128 then
				kit:Burst(entry.Tile.Frame, (TILE_STYLE[entry.Value] or BIG_STYLE)[1], 10)
			end
		end
		if anim.Spawn then
			spawnTile(anim.Spawn[1], anim.Spawn[2])
		end
		if best > 0 then
			kit:Sound("Pop", 0.9 + math.min(math.log(best, 2), 11) * 0.05)
		end
	end

	local function endRun(generation: number, reason: string)
		st.Playing = false
		if reason == "target" then
			kit:Mood("🥳", T("You made the %s tile!", tostring(st.Rules.Target)))
			kit:Confetti(20)
		elseif reason == "stuck" then
			kit:Mood("😵", T("No more moves!"))
			kit:Shake(board, 6)
		else
			kit:Mood("😊", T("Nice run!"))
		end
		local token = st.Token
		local moves = table.concat(st.Moves)
		task.spawn(function()
			local ok, result = kit:Invoke("solo:finish", { Token = token, Moves = moves })
			if generation ~= st.Generation or not kit.Alive then
				return
			end
			if not ok or type(result) ~= "table" then
				kit:Notify(type(result) == "string" and result or T("Something went wrong"), C.Red)
				kit:ShowPicker()
				return
			end
			task.wait(0.8)
			if generation == st.Generation then
				kit:ShowResult(result)
			end
		end)
	end

	local function play(dir: number)
		if not st.Playing or not st.Sim then
			return
		end
		completeAnim()
		local sim = st.Sim
		local previousMax = sim.MaxTile
		local moved, info = Logic.G2048Move(sim, dir)
		if not moved then
			kit:Shake(board, 3)
			return
		end
		table.insert(st.Moves, Logic.G2048Chars[dir])
		-- Prépare le glissement
		local anim = { T = 0, Moving = {}, Dying = {}, Upgrades = {}, Spawn = info.Spawn }
		local newTiles = {}
		for _, slide in ipairs(info.Slides) do
			local from, to, value, merged = slide[1], slide[2], slide[3], slide[4]
			local tile = tiles[from]
			if tile then
				table.insert(anim.Moving, { Tile = tile, From = from, To = to })
				if merged then
					table.insert(anim.Dying, tile)
					local survivor = newTiles[to]
					if survivor then
						table.insert(anim.Upgrades, { Tile = survivor, Value = value * 2 })
					end
				else
					newTiles[to] = tile
				end
			end
		end
		tiles = newTiles
		st.Anim = anim
		if info.Gain > 0 then
			kit:SetStat("Primary", Kit.FormatNumber(sim.Score), true)
			kit:Float(board, "+" .. tostring(info.Gain), C.Yellow)
		end
		refreshHud()
		if sim.MaxTile > previousMax then
			kit:SetStat("B", "🏅 " .. tostring(sim.MaxTile), true)
			for index, threshold in ipairs(st.Rules.Thresholds) do
				if sim.MaxTile == threshold and index < 3 then
					kit:Mood("🤩", T("%d ⭐ unlocked!", index))
					kit:Sound("Bonus")
				end
			end
		end
		local generation = st.Generation
		if sim.MaxTile >= st.Rules.Target then
			task.delay(SLIDE_TIME + 0.15, function()
				if generation == st.Generation and st.Playing then
					completeAnim()
					endRun(generation, "target")
				end
			end)
		elseif not Logic.G2048CanMove(sim) then
			task.delay(SLIDE_TIME + 0.3, function()
				if generation == st.Generation and st.Playing then
					completeAnim()
					endRun(generation, "stuck")
				end
			end)
		end
	end

	kit:OnKey(function(key)
		local dir = Kit.KeyDirections[key]
		if dir then
			play(dir)
		end
	end)
	kit:OnSwipe(board, play)

	finishButton.Activated:Connect(function()
		if not st.Playing then
			return
		end
		kit:Sound("Click")
		completeAnim()
		endRun(st.Generation, "finish")
	end)

	function startGame(difficulty: string)
		local rules = kit.GameRules.Difficulties[difficulty]
		st.Generation += 1
		local generation = st.Generation
		st.Rules = rules
		st.Moves = {}
		st.Token = nil
		st.Playing = false
		st.Anim = nil
		clearTiles()
		st.Sim = Logic.G2048New(1, SIZE)
		st.Sim.Cells = table.create(SIZE * SIZE, 0)
		st.Sim.MaxTile = 0
		refreshHud()
		kit:Mood("😊", T("Slide to merge equal tiles. Goal: %s!", tostring(rules.Target)))
		kit:Sound("Open")
		task.spawn(function()
			local reply = kit:StartSession()
			if generation ~= st.Generation then
				return
			end
			if not reply or type(reply.Seed) ~= "number" then
				kit:ShowPicker()
				return
			end
			st.Token = reply.Token
			st.Sim = Logic.G2048New(reply.Seed, SIZE)
			clearTiles()
			for _, initial in ipairs(st.Sim.Initial) do
				if initial[1] then
					spawnTile(initial[1], initial[2])
				end
			end
			st.Playing = true
			refreshHud()
		end)
	end

	-- Boucle : glissements
	kit:OnFrame(function(dt)
		local anim = st.Anim
		if not anim then
			return
		end
		anim.T += dt
		local k = math.min(anim.T / SLIDE_TIME, 1)
		local eased = 1 - (1 - k) * (1 - k)
		for _, move in ipairs(anim.Moving) do
			local ax, ay = (move.From - 1) % SIZE, (move.From - 1) // SIZE
			local bx, by = (move.To - 1) % SIZE, (move.To - 1) // SIZE
			move.Tile.Frame.Position = UDim2.fromScale(
				(ax + (bx - ax) * eased + 0.5) / SIZE,
				(ay + (by - ay) * eased + 0.5) / SIZE
			)
		end
		if k >= 1 then
			completeAnim()
		end
	end)

	-- Premier affichage : une jolie grille d'exemple
	st.Rules = Logic.Games.Game2048.Difficulties.Normal
	st.Sim = Logic.G2048New(1, SIZE)
	st.Sim.Cells = { 2, 4, 8, 0, 0, 16, 32, 0, 0, 0, 64, 128, 0, 0, 0, 256 }
	st.Sim.MaxTile = 256
	rebuildFromSim()
	refreshHud()
	kit:Mood("😊", T("Slide to merge equal tiles."), false)
	kit:ShowPicker()

	return {
		Destroy = function()
			st.Generation += 1
			st.Playing = false
			kit:Destroy()
		end,
	}
end

return Module
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="103">
          <Properties>
            <string name="Name">Solo_Kit</string>
            <string name="Source"><![CDATA[--[[
	Solo_Kit (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Minigames > Solo_Kit

	🕹️ Boîte à outils commune aux mini-jeux SOLO de l'arcade (style
	"arcade kawaii" sur fond néon sombre) :
	  - colonne de gauche (HUD) : icône + nom du jeu, difficulté, record,
	    une grosse tuile (score...) et deux petites, zone "Extra" pour les
	    commandes propres au jeu, boutons ↻ Rejouer / 🎚️ Difficulté ;
	  - zone de jeu (Area) : le module du jeu y construit son plateau ;
	  - écran de choix de la difficulté (3 cartes : détails, récompense, record) ;
	  - écran de fin (étoiles, score, record 🏅, 🎟️ tickets, 🏆 trophée et 🧠 Dopamine gagnés) ;
	  - compte à rebours 3-2-1, confettis et "+1" (cadres RÉUTILISÉS),
	    secousse, UNE seule boucle d'animation (RenderStepped) par jeu.

	Utilisation (dans un module Solo_<Id>) :
	  local kit = Kit.new(container, api, spec)
	  spec = { Id, Details(difficulty, rules) -> string, Help, Primary, SmallA, SmallB,
	           OnPlay(difficulty), OnPicker(), BestText(value) -> string,
	           ScoreText(result) -> string, NoStarHint(rules) -> string? }
	  kit:OnFrame(fn(dt)) / kit:SetStat("Primary" | "A" | "B", texte) / kit:ShowResult(result)
	  kit:Invoke(action, arg) (ne plante jamais) / kit:Burst(guiObject, couleur) / kit:Destroy()
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Logic = require(script.Parent.Solo_Logic)

local NumberFormatter = nil
do
	local shared = ReplicatedStorage:FindFirstChild("Shared")
	local module = shared and shared:FindFirstChild("NumberFormatter")
	if module then
		local ok, result = pcall(require, module)
		if ok then
			NumberFormatter = result
		end
	end
end

-- 🏆 trophées par victoire solo récompensée (ArcadeConfig.Trophies.PerSoloWin)
local TROPHIES_PER_WIN = 1
do
	local shared = ReplicatedStorage:FindFirstChild("Shared")
	local module = shared and shared:FindFirstChild("ArcadeConfig")
	if module then
		local ok, result = pcall(require, module)
		if ok and type(result) == "table" and type(result.Trophies) == "table" then
			TROPHIES_PER_WIN = tonumber(result.Trophies.PerSoloWin) or TROPHIES_PER_WIN
		end
	end
end

local Kit = {}
Kit.__index = Kit
Kit.Logic = Logic

-- Palette "néon kawaii" (fond sombre, couleurs pastel lumineuses)
local C = {
	BgTop = Color3.fromRGB(44, 24, 92),
	BgBottom = Color3.fromRGB(18, 11, 44),
	Card = Color3.fromRGB(46, 30, 94),
	CardLight = Color3.fromRGB(66, 46, 128),
	CardDark = Color3.fromRGB(28, 18, 62),
	Text = Color3.fromRGB(255, 255, 255),
	TextDim = Color3.fromRGB(190, 176, 240),
	Pink = Color3.fromRGB(255, 102, 190),
	Cyan = Color3.fromRGB(86, 228, 255),
	Yellow = Color3.fromRGB(255, 218, 84),
	Mint = Color3.fromRGB(96, 242, 178),
	Lilac = Color3.fromRGB(178, 142, 255),
	Orange = Color3.fromRGB(255, 160, 84),
	Red = Color3.fromRGB(255, 86, 118),
	Gold = Color3.fromRGB(255, 200, 60),
	White = Color3.new(1, 1, 1),
	Black = Color3.new(0, 0, 0),
}
Kit.Colors = C
Kit.FontTitle = Enum.Font.FredokaOne
Kit.FontBody = Enum.Font.BuilderSansBold

local CONFETTI = { C.Pink, C.Cyan, C.Yellow, C.Mint, C.Lilac, C.Orange }

-- Mémorise la dernière difficulté choisie par jeu (le temps de la session)
local lastDifficulty: { [string]: string } = {}

----------------------------------------------------------------------
-- Petits constructeurs
----------------------------------------------------------------------

local function create(className: string, props: { [string]: any }?, children: { Instance }?): any
	local instance = Instance.new(className)
	local parent = nil
	if props then
		for key, value in pairs(props) do
			if key == "Parent" then
				parent = value
			else
				(instance :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end
Kit.Create = create

local function corner(parent: Instance, radius: number | UDim)
	return create("UICorner", {
		CornerRadius = typeof(radius) == "UDim" and radius or UDim.new(0, radius :: number),
		Parent = parent,
	})
end
Kit.Corner = corner

local function stroke(parent: Instance, color: Color3, thickness: number?, transparency: number?)
	return create("UIStroke", {
		Color = color,
		Thickness = thickness or 1.5,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end
Kit.Stroke = stroke

local function gradient(parent: Instance, a: Color3, b: Color3, rotation: number?)
	return create("UIGradient", {
		Color = ColorSequence.new(a, b),
		Rotation = rotation or 90,
		Parent = parent,
	})
end
Kit.Gradient = gradient

local function label(props: { [string]: any }): TextLabel
	local maxSize = props.MaxTextSize or 28
	props.MaxTextSize = nil
	local final = {
		BackgroundTransparency = 1,
		Font = Kit.FontTitle,
		TextColor3 = C.Text,
		TextScaled = true,
		Text = "",
	}
	for key, value in pairs(props) do
		final[key] = value
	end
	local l = create("TextLabel", final)
	create("UITextSizeConstraint", { MaxTextSize = maxSize, MinTextSize = 6, Parent = l })
	return l
end
Kit.Label = label

local function tween(instance: Instance, duration: number, goal: { [string]: any }, style: Enum.EasingStyle?, direction: Enum.EasingDirection?)
	local t = TweenService:Create(instance, TweenInfo.new(duration, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), goal)
	t:Play()
	return t
end
Kit.Tween = tween

-- Bouton "bonbon" : dégradé, contour clair, léger relief, animation d'appui
local function candyButton(props: { [string]: any }): TextButton
	local color = props.Color or C.Pink
	local button = create("TextButton", {
		Name = props.Name or "Button",
		Size = props.Size or UDim2.fromOffset(120, 36),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = color,
		AutoButtonColor = false,
		Font = Kit.FontTitle,
		Text = props.Text or "",
		TextColor3 = props.TextColor3 or C.White,
		TextScaled = true,
		ZIndex = props.ZIndex or 1,
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	})
	corner(button, props.Radius or 12)
	stroke(button, color:Lerp(C.White, 0.55), 1.5, 0.15)
	gradient(button, color:Lerp(C.White, 0.28), color:Lerp(C.Black, 0.12), 90)
	create("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize or 18, MinTextSize = 6, Parent = button })
	create("UIPadding", {
		PaddingLeft = UDim.new(0, 6),
		PaddingRight = UDim.new(0, 6),
		PaddingTop = UDim.new(0, 4),
		PaddingBottom = UDim.new(0, 4),
		Parent = button,
	})
	local scale = create("UIScale", { Name = "Press", Parent = button })
	button.MouseEnter:Connect(function()
		tween(scale, 0.12, { Scale = 1.05 }, Enum.EasingStyle.Back)
	end)
	button.MouseLeave:Connect(function()
		tween(scale, 0.12, { Scale = 1 })
	end)
	button.MouseButton1Down:Connect(function()
		tween(scale, 0.07, { Scale = 0.93 })
	end)
	button.MouseButton1Up:Connect(function()
		tween(scale, 0.18, { Scale = 1 }, Enum.EasingStyle.Back)
	end)
	return button
end
Kit.Button = candyButton

----------------------------------------------------------------------
-- Formats
----------------------------------------------------------------------

function Kit.FormatNumber(value: number): string
	if NumberFormatter and type(NumberFormatter.Format) == "function" then
		local ok, text = pcall(NumberFormatter.Format, value)
		if ok and type(text) == "string" then
			return text
		end
	end
	return tostring(math.floor(value + 0.5))
end

function Kit.FormatClock(seconds: number): string
	local total = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", total // 60, total % 60)
end

-- Temps précis au dixième ("42.3s" ou "1:02.3")
function Kit.FormatTime(seconds: number): string
	local s = math.max(0, seconds)
	if s < 60 then
		return string.format("%.1fs", s)
	end
	return string.format("%d:%04.1f", math.floor(s / 60), s % 60)
end

----------------------------------------------------------------------
-- Construction
----------------------------------------------------------------------

function Kit.new(container: Frame, api, spec)
	local self = setmetatable({}, Kit)
	self.Api = api or {}
	self.Spec = spec
	self.Id = spec.Id
	self.Alive = true
	self.Connections = {}
	self.FrameFns = {}
	self.Entry = (type(self.Api.Game) == "table" and self.Api.Game) or {}
	self.GameRules = Logic.Games[spec.Id]
	self.Difficulty = lastDifficulty[spec.Id] or "Normal"
	self.Bests = {}
	self.Accent = self.Entry.Color or C.Pink
	self.Accent2 = self.Entry.Accent or C.Lilac
	self.Touch = UserInputService.TouchEnabled

	local root = create("Frame", {
		Name = "Solo_" .. spec.Id,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.BgBottom,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = container,
	})
	root:SetAttribute("DarkSkinIgnore", true)
	corner(root, 16)
	gradient(root, C.BgTop, C.BgBottom, 90)
	self.Root = root
	self:_BuildDecor()
	self:_BuildHud()

	-- Zone de jeu (le module y construit son plateau)
	local area = create("Frame", {
		Name = "Area",
		Position = UDim2.fromOffset(222, 10),
		Size = UDim2.new(1, -232, 1, -20),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = root,
	})
	self.Area = area

	-- Calque des effets (confettis, "+1")
	self.Fx = create("Frame", {
		Name = "Fx",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 20,
		Parent = root,
	})
	self.Particles = {}
	self.Floats = {}
	self:_BuildCountdown()
	self:_BuildPicker()
	self:_BuildResult()

	-- UNE seule boucle d'animation pour tout le jeu
	table.insert(self.Connections, RunService.RenderStepped:Connect(function(dt)
		self:_Step(math.min(dt, 0.1))
	end))

	-- Records par difficulté (affichés sur le sélecteur)
	task.spawn(function()
		local ok, info = self:Invoke("solo:info", nil)
		if ok and type(info) == "table" and type(info.Best) == "table" and self.Alive then
			for key, value in pairs(info.Best) do
				if type(key) == "string" and type(value) == "number" then
					self.Bests[key] = value
				end
			end
			self:_RefreshPicker()
			self:_RefreshTitle()
		end
	end)
	return self
end

-- Petites étoiles / bulles de décor (fixes : aucun coût par image)
function Kit:_BuildDecor()
	local decor = create("Frame", {
		Name = "Decor",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 1,
		Parent = self.Root,
	})
	local rng = Logic.Rng(#self.Id * 131 + 7)
	for index = 1, 22 do
		local size = 2 + rng.Int(0, 3)
		local dot = create("Frame", {
			Size = UDim2.fromOffset(size, size),
			Position = UDim2.fromScale(rng.Next(), rng.Next()),
			BackgroundColor3 = CONFETTI[index % #CONFETTI + 1],
			BackgroundTransparency = 0.45 + rng.Next() * 0.35,
			BorderSizePixel = 0,
			ZIndex = 1,
			Parent = decor,
		})
		corner(dot, UDim.new(1, 0))
	end
	-- Grand halo de la couleur du jeu, en bas à droite
	local glow = create("Frame", {
		Size = UDim2.fromScale(0.9, 1.3),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.72, 0.95),
		BackgroundColor3 = self.Accent,
		BackgroundTransparency = 0.82,
		BorderSizePixel = 0,
		ZIndex = 1,
		Parent = decor,
	})
	corner(glow, UDim.new(1, 0))
	create("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = glow,
	})
end

-- Tuile de stat (étiquette + valeur)
local function statTile(parent: Instance, name: string, position: UDim2, size: UDim2, big: boolean, accent: Color3)
	local tile = create("Frame", {
		Name = name,
		Position = position,
		Size = size,
		BackgroundColor3 = C.Card,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = parent,
	})
	corner(tile, 12)
	stroke(tile, accent, 1.5, 0.45)
	gradient(tile, C.CardLight, C.CardDark, 90)
	local caption = label({
		Name = "Caption",
		Position = UDim2.new(0, 10, 0, big and 6 or 4),
		Size = UDim2.new(1, -20, 0, big and 14 or 12),
		Font = Kit.FontBody,
		TextColor3 = C.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = big and 13 or 11,
		ZIndex = 3,
		Parent = tile,
	})
	local value = label({
		Name = "Value",
		Position = UDim2.new(0, 10, 0, big and 20 or 16),
		Size = UDim2.new(1, -20, 1, big and -24 or -19),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = big and 36 or 20,
		Text = "-",
		ZIndex = 3,
		Parent = tile,
	})
	create("UIScale", { Name = "Pop", Parent = value })
	return tile, caption, value
end

function Kit:_BuildHud()
	local spec = self.Spec
	local hud = create("Frame", {
		Name = "Hud",
		Position = UDim2.fromOffset(10, 10),
		Size = UDim2.new(0, 202, 1, -20),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = self.Root,
	})
	self.Hud = hud

	-- Carte titre : icône + nom + difficulté / record
	local title = create("Frame", {
		Name = "Title",
		Size = UDim2.new(1, 0, 0, 58),
		BackgroundColor3 = C.Card,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = hud,
	})
	corner(title, 14)
	gradient(title, self.Accent:Lerp(C.CardDark, 0.35), self.Accent2:Lerp(C.CardDark, 0.55), 20)
	stroke(title, self.Accent:Lerp(C.White, 0.4), 1.5, 0.3)
	local bubble = create("Frame", {
		Name = "Icon",
		Position = UDim2.fromOffset(8, 8),
		Size = UDim2.fromOffset(42, 42),
		BackgroundColor3 = C.White,
		BackgroundTransparency = 0.82,
		ZIndex = 3,
		Parent = title,
	})
	corner(bubble, UDim.new(1, 0))
	stroke(bubble, C.White, 1.5, 0.55)
	label({
		Size = UDim2.fromScale(0.78, 0.78),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Text = self.Entry.Icon or self.GameRules.Icon,
		MaxTextSize = 30,
		ZIndex = 4,
		Parent = bubble,
	})
	self.TitleName = label({
		Position = UDim2.fromOffset(58, 8),
		Size = UDim2.new(1, -64, 0, 22),
		Text = self:T(self.Entry.Name or self.GameRules.Name),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 21,
		ZIndex = 3,
		Parent = title,
	})
	self.TitleSub = label({
		Position = UDim2.fromOffset(58, 32),
		Size = UDim2.new(1, -64, 0, 16),
		Font = Kit.FontBody,
		TextColor3 = C.White,
		TextTransparency = 0.15,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 13,
		ZIndex = 3,
		Parent = title,
	})

	-- Tuiles de stats
	local primary, primaryCaption, primaryValue =
		statTile(hud, "Primary", UDim2.fromOffset(0, 66), UDim2.new(1, 0, 0, 64), true, self.Accent)
	local tileA, captionA, valueA = statTile(hud, "A", UDim2.fromOffset(0, 138), UDim2.new(0.5, -4, 0, 48), false, C.Cyan)
	local tileB, captionB, valueB = statTile(hud, "B", UDim2.new(0.5, 4, 0, 138), UDim2.new(0.5, -4, 0, 48), false, C.Yellow)
	primaryCaption.Text = self:T(spec.Primary or "Score")
	captionA.Text = self:T(spec.SmallA or "Next ⭐")
	captionB.Text = self:T(spec.SmallB or "Time")
	self.Stats = {
		Primary = { Tile = primary, Value = primaryValue },
		A = { Tile = tileA, Value = valueA },
		B = { Tile = tileB, Value = valueB },
	}

	-- Zone libre pour les commandes du jeu (drapeau, fin de partie...)
	self.Extra = create("Frame", {
		Name = "Extra",
		Position = UDim2.fromOffset(0, 194),
		Size = UDim2.new(1, 0, 1, -296),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = hud,
	})

	-- Petit compagnon kawaii (humeur + conseil), en bas de la zone Extra
	local buddy = create("Frame", {
		Name = "Buddy",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, -44),
		Size = UDim2.new(1, 0, 0, 54),
		BackgroundColor3 = C.CardDark,
		BackgroundTransparency = 0.25,
		ZIndex = 2,
		Parent = hud,
	})
	corner(buddy, 14)
	stroke(buddy, self.Accent2, 1, 0.6)
	local face = create("Frame", {
		Name = "Face",
		Position = UDim2.fromOffset(6, 6),
		Size = UDim2.fromOffset(42, 42),
		BackgroundColor3 = C.Yellow,
		ZIndex = 3,
		Parent = buddy,
	})
	corner(face, UDim.new(1, 0))
	gradient(face, C.Yellow:Lerp(C.White, 0.35), C.Orange, 90)
	stroke(face, C.White, 1.5, 0.4)
	local faceText = label({
		Size = UDim2.fromScale(0.86, 0.86),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Text = "😊",
		MaxTextSize = 30,
		ZIndex = 4,
		Parent = face,
	})
	local faceScale = create("UIScale", { Parent = face })
	local tip = label({
		Name = "Tip",
		Position = UDim2.fromOffset(54, 5),
		Size = UDim2.new(1, -60, 1, -10),
		Font = Kit.FontBody,
		TextColor3 = C.White,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 13,
		ZIndex = 3,
		Parent = buddy,
	})
	self.Buddy = { Frame = buddy, Face = face, FaceText = faceText, Scale = faceScale, Tip = tip, Bob = 0 }

	-- Boutons du bas
	local restart = candyButton({
		Name = "Restart",
		Text = "🔄 " .. self:T("Restart"),
		Color = self.Accent,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(0.5, -4, 0, 36),
		MaxTextSize = 15,
		ZIndex = 3,
		Parent = hud,
	})
	local difficulty = candyButton({
		Name = "Difficulty",
		Text = "🎚️ " .. self:T("Level"),
		Color = C.CardLight,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.fromScale(1, 1),
		Size = UDim2.new(0.5, -4, 0, 36),
		MaxTextSize = 15,
		ZIndex = 3,
		Parent = hud,
	})
	restart.Activated:Connect(function()
		self:Sound("Click")
		self:Play(self.Difficulty)
	end)
	difficulty.Activated:Connect(function()
		self:Sound("Click")
		self:ShowPicker()
	end)
	self:_RefreshTitle()
	-- Petit écran : on cache le compagnon pour laisser la place aux commandes
	table.insert(self.Connections, hud:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:_Relayout()
	end))
	task.defer(function()
		if self.Alive then
			self:_Relayout()
		end
	end)
end

-- Hauteur du HUD en pixels "design" -> mode compact (sans compagnon) si < 352
function Kit:_Relayout()
	local title = self.Hud:FindFirstChild("Title")
	local unit = title and title.AbsoluteSize.Y / 58 or 0
	if unit <= 0 then
		return
	end
	local compact = self.Hud.AbsoluteSize.Y / unit < 352
	self.Buddy.Frame.Visible = not compact
	self.Extra.Size = UDim2.new(1, 0, 1, compact and -238 or -296)
	local rating = self.Rating
	if rating then
		local height = self:ExtraHeight()
		rating.Frame.Visible = height <= 0 or height >= rating.Top + 41
	end
end

function Kit:_RefreshTitle()
	local info = Logic.DifficultyInfo[self.Difficulty]
	local text = (info and info.Icon or "") .. " " .. self:T(info and info.Name or self.Difficulty)
	local best = self.Bests[self.Id .. ":" .. self.Difficulty]
	if best then
		text ..= "  ·  🏅 " .. self:BestText(best)
	end
	self.TitleSub.Text = text
end

function Kit:BestText(value: number): string
	if self.Spec.BestText then
		return self.Spec.BestText(value)
	end
	return Kit.FormatNumber(value)
end

-- Compte à rebours 3, 2, 1, GO!
function Kit:_BuildCountdown()
	local holder = create("Frame", {
		Name = "Countdown",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Black,
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 30,
		Parent = self.Area,
	})
	local text = label({
		Size = UDim2.fromScale(0.5, 0.4),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Text = "3",
		MaxTextSize = 110,
		TextStrokeTransparency = 0.4,
		TextStrokeColor3 = self.Accent,
		ZIndex = 31,
		Parent = holder,
	})
	self.CountdownFrame = holder
	self.CountdownText = text
	self.CountdownScale = create("UIScale", { Parent = text })
end

function Kit:Countdown(onDone: () -> ())
	self.CountdownId = (self.CountdownId or 0) + 1
	local id = self.CountdownId
	local holder = self.CountdownFrame
	holder.Visible = true
	holder.BackgroundTransparency = 0.55
	task.spawn(function()
		for _, step in ipairs({ "3", "2", "1", "GO!" }) do
			if not self.Alive or self.CountdownId ~= id then
				return
			end
			self.CountdownText.Text = step == "GO!" and self:T("GO!") or step
			self.CountdownText.TextColor3 = step == "GO!" and C.Mint or C.White
			self.CountdownScale.Scale = 1.6
			tween(self.CountdownScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
			self:Sound(step == "GO!" and "Bonus" or "Click", step == "GO!" and 1.2 or 1)
			task.wait(step == "GO!" and 0.35 or 0.6)
		end
		if not self.Alive or self.CountdownId ~= id then
			return
		end
		holder.Visible = false
		onDone()
	end)
end

function Kit:CancelCountdown()
	self.CountdownId = (self.CountdownId or 0) + 1
	self.CountdownFrame.Visible = false
end

----------------------------------------------------------------------
-- Sélecteur de difficulté
----------------------------------------------------------------------

function Kit:_BuildPicker()
	local spec = self.Spec
	local picker = create("TextButton", {
		Name = "Picker",
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.BgBottom,
		BackgroundTransparency = 0.04,
		Visible = false,
		ZIndex = 40,
		Parent = self.Root,
	})
	corner(picker, 16)
	gradient(picker, C.BgTop, C.BgBottom, 90)
	self.Picker = picker

	-- En-tête
	local header = create("Frame", {
		Name = "Header",
		Position = UDim2.fromOffset(0, 12),
		Size = UDim2.new(1, 0, 0, 74),
		BackgroundTransparency = 1,
		ZIndex = 41,
		Parent = picker,
	})
	local icon = create("Frame", {
		Name = "Icon",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromOffset(46, 46),
		BackgroundColor3 = self.Accent,
		ZIndex = 42,
		Parent = header,
	})
	corner(icon, UDim.new(1, 0))
	gradient(icon, self.Accent:Lerp(C.White, 0.25), self.Accent2, 45)
	stroke(icon, C.White, 2, 0.35)
	label({
		Size = UDim2.fromScale(0.72, 0.72),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Text = self.Entry.Icon or self.GameRules.Icon,
		MaxTextSize = 30,
		ZIndex = 43,
		Parent = icon,
	})
	self.PickerIconScale = create("UIScale", { Parent = icon })
	label({
		Position = UDim2.fromOffset(20, 48),
		Size = UDim2.new(1, -40, 0, 24),
		Text = self:T("Choose your level"),
		MaxTextSize = 22,
		ZIndex = 42,
		Parent = header,
	})

	-- 3 cartes
	local row = create("Frame", {
		Name = "Cards",
		Position = UDim2.fromOffset(20, 94),
		Size = UDim2.new(1, -40, 1, -130),
		BackgroundTransparency = 1,
		ZIndex = 41,
		Parent = picker,
	})
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 14),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = row,
	})
	self.PickerCards = {}
	for order, difficulty in ipairs(Logic.DifficultyOrder) do
		local info = Logic.DifficultyInfo[difficulty]
		local rules = self.GameRules.Difficulties[difficulty]
		local card = create("TextButton", {
			Name = difficulty,
			Text = "",
			AutoButtonColor = false,
			Size = UDim2.new(1 / 3, -10, 1, 0),
			BackgroundColor3 = C.Card,
			LayoutOrder = order,
			ZIndex = 42,
			Parent = row,
		})
		create("UISizeConstraint", { MaxSize = Vector2.new(210, 230), Parent = card })
		corner(card, 16)
		gradient(card, C.CardLight, C.CardDark, 90)
		local cardStroke = stroke(card, info.Color, 2, 0.2)
		local scale = create("UIScale", { Parent = card })
		-- Bandeau coloré en haut
		local band = create("Frame", {
			Name = "Band",
			Size = UDim2.new(1, 0, 0, 44),
			BackgroundColor3 = info.Color,
			BorderSizePixel = 0,
			ZIndex = 43,
			Parent = card,
		})
		corner(band, 16)
		gradient(band, info.Color:Lerp(C.White, 0.25), info.Color:Lerp(C.Black, 0.1), 90)
		-- (bas du bandeau carré)
		create("Frame", {
			Position = UDim2.new(0, 0, 1, -14),
			Size = UDim2.new(1, 0, 0, 14),
			BackgroundColor3 = info.Color:Lerp(C.Black, 0.08),
			BorderSizePixel = 0,
			ZIndex = 43,
			Parent = band,
		})
		label({
			Position = UDim2.fromOffset(10, 6),
			Size = UDim2.new(1, -20, 0, 32),
			Text = info.Icon .. " " .. self:T(info.Name),
			MaxTextSize = 22,
			TextStrokeTransparency = 0.7,
			ZIndex = 44,
			Parent = band,
		})
		local details = label({
			Name = "Details",
			Position = UDim2.new(0, 10, 0, 50),
			Size = UDim2.new(1, -20, 1, -126),
			Font = Kit.FontBody,
			TextColor3 = C.White,
			TextWrapped = true,
			LineHeight = 1.15,
			Text = spec.Details and spec.Details(difficulty, rules, self) or "",
			MaxTextSize = 16,
			ZIndex = 43,
			Parent = card,
		})
		local reward = create("Frame", {
			Name = "Reward",
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -40),
			Size = UDim2.new(1, -16, 0, 30),
			BackgroundColor3 = C.CardDark,
			BackgroundTransparency = 0.2,
			ZIndex = 43,
			Parent = card,
		})
		corner(reward, UDim.new(1, 0))
		stroke(reward, C.Gold, 1, 0.5)
		local rewardText = label({
			Size = UDim2.new(1, -12, 1, -8),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Font = Kit.FontTitle,
			TextColor3 = C.Yellow,
			MaxTextSize = 15,
			ZIndex = 44,
			Parent = reward,
		})
		local best = label({
			Name = "Best",
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -10),
			Size = UDim2.new(1, -16, 0, 22),
			Font = Kit.FontBody,
			TextColor3 = C.TextDim,
			MaxTextSize = 13,
			ZIndex = 43,
			Parent = card,
		})
		card.MouseEnter:Connect(function()
			tween(scale, 0.15, { Scale = 1.04 }, Enum.EasingStyle.Back)
			cardStroke.Transparency = 0
		end)
		card.MouseLeave:Connect(function()
			tween(scale, 0.15, { Scale = 1 })
			cardStroke.Transparency = 0.2
		end)
		card.Activated:Connect(function()
			if not self.Picker.Visible then
				return
			end
			self:Sound("Click")
			self:Play(difficulty)
		end)
		self.PickerCards[difficulty] = { Card = card, Best = best, Reward = rewardText, Details = details, Scale = scale }
	end

	self.PickerHelp = label({
		Name = "Help",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Size = UDim2.new(1, -40, 0, 20),
		Font = Kit.FontBody,
		TextColor3 = C.TextDim,
		Text = spec.Help or "",
		MaxTextSize = 13,
		ZIndex = 41,
		Parent = picker,
	})
	self:_RefreshPicker()
end

function Kit:_RefreshPicker()
	for difficulty, entry in pairs(self.PickerCards) do
		local tickets, seconds = Logic.Reward(tonumber(self.Entry.Tickets) or 0, tonumber(self.Entry.RewardSeconds) or 0, difficulty, 3)
		if tickets > 0 or seconds > 0 then
			entry.Reward.Text = self:T("Up to 🎟️ %s · 🏆 %s · 🧠 %s", tostring(tickets), tostring(TROPHIES_PER_WIN), tostring(seconds) .. "s")
		else
			entry.Reward.Text = "🎟️ 🏆 🧠"
		end
		local best = self.Bests[self.Id .. ":" .. difficulty]
		entry.Best.Text = best and ("🏅 " .. self:T("Best: %s", self:BestText(best))) or self:T("No record yet")
		entry.Card.BackgroundTransparency = 0
		local selected = difficulty == self.Difficulty
		entry.Best.TextColor3 = selected and C.White or C.TextDim
	end
end

function Kit:ShowPicker()
	self:CancelCountdown()
	self:HideResult()
	if self.Spec.OnPicker then
		self.Spec.OnPicker()
	end
	self:_RefreshPicker()
	local picker = self.Picker
	picker.Visible = true
	self.PickerIconScale.Scale = 0.6
	tween(self.PickerIconScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	for index, difficulty in ipairs(Logic.DifficultyOrder) do
		local entry = self.PickerCards[difficulty]
		entry.Scale.Scale = 0.85
		task.delay(0.04 * index, function()
			if self.Alive then
				tween(entry.Scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
			end
		end)
	end
end

function Kit:HidePicker()
	self.Picker.Visible = false
end

-- Lance une partie (sélecteur, bouton ↻, "Rejouer")
function Kit:Play(difficulty: string)
	if not self.GameRules.Difficulties[difficulty] then
		difficulty = "Normal"
	end
	self.Difficulty = difficulty
	lastDifficulty[self.Id] = difficulty
	self:HidePicker()
	self:HideResult()
	self:CancelCountdown()
	self:_RefreshTitle()
	self.Finished = false
	self.Token = nil
	if self.Spec.OnPlay then
		self.Spec.OnPlay(difficulty)
	end
end

-- Démarre la session serveur ; renvoie la réponse (ou nil + message affiché)
function Kit:StartSession(extra: { [string]: any }?)
	local arg = { Game = self.Id, Difficulty = self.Difficulty }
	if extra then
		for key, value in pairs(extra) do
			arg[key] = value
		end
	end
	self.StartSeq = (self.StartSeq or 0) + 1
	local seq = self.StartSeq
	local ok, reply = self:Invoke("solo:start", arg)
	if not self.Alive or seq ~= self.StartSeq then
		return nil
	end
	if not ok or type(reply) ~= "table" or reply.Token == nil then
		self:Notify(type(reply) == "string" and reply or self:T("Something went wrong"), C.Red)
		return nil
	end
	self.Token = reply.Token
	self.Finished = false
	if type(reply.Best) == "number" then
		self.Bests[self.Id .. ":" .. self.Difficulty] = reply.Best
	end
	self:_RefreshTitle()
	return reply
end

----------------------------------------------------------------------
-- Écran de fin
----------------------------------------------------------------------

function Kit:_BuildResult()
	local overlay = create("TextButton", {
		Name = "Result",
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Black,
		BackgroundTransparency = 0.35,
		Visible = false,
		ZIndex = 50,
		Parent = self.Root,
	})
	corner(overlay, 16)
	local card = create("Frame", {
		Name = "Card",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 420, 1, -24),
		BackgroundColor3 = C.Card,
		ZIndex = 51,
		Parent = overlay,
	})
	create("UISizeConstraint", { MaxSize = Vector2.new(420, 330), Parent = card })
	corner(card, 20)
	gradient(card, C.CardLight, C.CardDark, 90)
	local cardStroke = stroke(card, self.Accent, 2.5, 0.1)
	local scale = create("UIScale", { Parent = card })

	local title = label({
		Name = "Title",
		Position = UDim2.new(0, 16, 0.04, 0),
		Size = UDim2.new(1, -32, 0.14, 0),
		MaxTextSize = 34,
		TextStrokeTransparency = 0.5,
		ZIndex = 52,
		Parent = card,
	})
	-- Étoiles
	local starsRow = create("Frame", {
		Name = "Stars",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.2),
		Size = UDim2.new(0.62, 0, 0.2, 0),
		BackgroundTransparency = 1,
		ZIndex = 52,
		Parent = card,
	})
	local stars = {}
	for index = 1, 3 do
		local holder = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale((index - 0.5) / 3, index == 2 and 0.45 or 0.58),
			Size = UDim2.fromScale(index == 2 and 0.36 or 0.3, index == 2 and 1.05 or 0.9),
			BackgroundTransparency = 1,
			ZIndex = 52,
			Parent = starsRow,
		})
		create("UIAspectRatioConstraint", { AspectRatio = 1, Parent = holder })
		local star = label({
			Size = UDim2.fromScale(1, 1),
			Text = "⭐",
			MaxTextSize = 60,
			ZIndex = 53,
			Parent = holder,
		})
		local starScale = create("UIScale", { Parent = holder })
		stars[index] = { Label = star, Scale = starScale, Holder = holder }
	end
	local score = label({
		Name = "Score",
		Position = UDim2.new(0, 16, 0.43, 0),
		Size = UDim2.new(1, -32, 0.1, 0),
		MaxTextSize = 24,
		ZIndex = 52,
		Parent = card,
	})
	local best = label({
		Name = "Best",
		Position = UDim2.new(0, 16, 0.535, 0),
		Size = UDim2.new(1, -32, 0.065, 0),
		Font = Kit.FontBody,
		TextColor3 = C.TextDim,
		MaxTextSize = 15,
		RichText = true,
		ZIndex = 52,
		Parent = card,
	})
	-- Récompenses
	local rewards = create("Frame", {
		Name = "Rewards",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.62),
		Size = UDim2.new(1, -32, 0.1, 0),
		BackgroundTransparency = 1,
		ZIndex = 52,
		Parent = card,
	})
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 10),
		Parent = rewards,
	})
	local function chip(name: string, color: Color3, order: number)
		local frame = create("Frame", {
			Name = name,
			Size = UDim2.new(0.42, 0, 1, 0),
			BackgroundColor3 = color:Lerp(C.CardDark, 0.78),
			LayoutOrder = order,
			ZIndex = 53,
			Parent = rewards,
		})
		corner(frame, UDim.new(1, 0))
		stroke(frame, color, 1.5, 0.2)
		local text = label({
			Size = UDim2.new(1, -16, 1, -6),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			TextColor3 = color:Lerp(C.White, 0.35),
			MaxTextSize = 20,
			ZIndex = 54,
			Parent = frame,
		})
		return frame, text
	end
	local ticketChip, ticketText = chip("Tickets", C.Yellow, 1)
	local trophyChip, trophyText = chip("Trophies", C.Cyan, 2)
	local dopaChip, dopaText = chip("Dopamine", C.Pink, 3)
	local note = label({
		Name = "Note",
		Position = UDim2.new(0, 20, 0.735, 0),
		Size = UDim2.new(1, -40, 0.075, 0),
		Font = Kit.FontBody,
		TextColor3 = C.TextDim,
		TextWrapped = true,
		MaxTextSize = 13,
		ZIndex = 52,
		Parent = card,
	})
	-- Boutons
	local again = candyButton({
		Name = "Again",
		Text = "🔄 " .. self:T("Play again"),
		Color = self.Accent,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 18, 0.96, 0),
		Size = UDim2.new(0.5, -24, 0.13, 0),
		MaxTextSize = 18,
		ZIndex = 53,
		Parent = card,
	})
	local change = candyButton({
		Name = "Change",
		Text = "🎚️ " .. self:T("Change level"),
		Color = C.CardLight,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -18, 0.96, 0),
		Size = UDim2.new(0.5, -24, 0.13, 0),
		MaxTextSize = 18,
		ZIndex = 53,
		Parent = card,
	})
	again.Activated:Connect(function()
		self:Sound("Click")
		self:Play(self.Difficulty)
	end)
	change.Activated:Connect(function()
		self:Sound("Click")
		self:ShowPicker()
	end)
	self.ResultUI = {
		Overlay = overlay,
		Card = card,
		Stroke = cardStroke,
		Scale = scale,
		Title = title,
		Stars = stars,
		Score = score,
		Best = best,
		TicketChip = ticketChip,
		TicketText = ticketText,
		TrophyChip = trophyChip,
		TrophyText = trophyText,
		DopaChip = dopaChip,
		DopaText = dopaText,
		Note = note,
	}
end

local RESULT_TITLES = { [0] = "Game over", [1] = "Well played!", [2] = "Great job!", [3] = "Perfect!" }

function Kit:ShowResult(result)
	if not self.Alive or type(result) ~= "table" then
		return
	end
	self.Finished = true
	self.Token = nil
	local ui = self.ResultUI
	local stars = math.clamp(math.floor(tonumber(result.Stars) or 0), 0, 3)
	local won = stars >= 1
	if type(result.Rejected) == "string" then
		ui.Title.Text = self:T("Too fast!") .. " 🤔"
	else
		ui.Title.Text = self:T(won and RESULT_TITLES[stars] or (self.Spec.LoseTitle or RESULT_TITLES[0]))
			.. (won and " 🎉" or " 💫")
	end
	ui.Title.TextColor3 = won and C.Yellow or C.White
	ui.Stroke.Color = won and C.Yellow or self.Accent
	ui.Score.Text = self.Spec.ScoreText and self.Spec.ScoreText(result) or tostring(result.Score or 0)
	local bestText = ""
	if type(result.Best) == "number" then
		self.Bests[self.Id .. ":" .. self.Difficulty] = result.Best
		bestText = "🏅 " .. self:T("Best: %s", self:BestText(result.Best))
		if result.NewBest then
			bestText ..= '  <font color="#FFDA54"><b>' .. self:T("NEW RECORD!") .. "</b></font>"
		end
	end
	ui.Best.Text = bestText
	local tickets = tonumber(result.Tickets) or 0
	local trophies = tonumber(result.Trophies) or 0
	local dopamine = tonumber(result.Dopamine) or 0
	ui.TicketText.Text = "🎟️ +" .. Kit.FormatNumber(tickets)
	ui.TrophyText.Text = "🏆 +" .. Kit.FormatNumber(trophies)
	ui.DopaText.Text = "🧠 +" .. Kit.FormatNumber(dopamine)
	ui.TicketChip.Visible = won
	ui.DopaChip.Visible = won
	-- 🏆 trophée gagné (mises des duels) : 3 pastilles plus étroites
	local showTrophy = won and trophies > 0
	ui.TrophyChip.Visible = showTrophy
	local chipWidth = showTrophy and 0.3 or 0.42
	for _, chipFrame in ipairs({ ui.TicketChip, ui.TrophyChip, ui.DopaChip }) do
		chipFrame.Size = UDim2.new(chipWidth, 0, 1, 0)
	end
	local note = ""
	if type(result.Rejected) == "string" then
		note = self:T(result.Rejected)
	elseif result.Capped then
		note = self:T("Daily rewards reached for this game. Come back tomorrow!")
	elseif not won then
		local hint = self.Spec.NoStarHint and self.Spec.NoStarHint(self.GameRules.Difficulties[self.Difficulty], result)
		note = hint or self:T("Earn at least 1 ⭐ to win rewards!")
	elseif stars < 3 then
		note = self:T("Harder levels and more ⭐ give bigger rewards!")
	end
	ui.Note.Text = note
	ui.Note.Position = UDim2.new(0, 20, won and 0.735 or 0.64, 0)
	ui.Note.Size = UDim2.new(1, -40, won and 0.075 or 0.12, 0)
	self:_RefreshTitle()

	ui.Overlay.Visible = true
	ui.Overlay.BackgroundTransparency = 1
	tween(ui.Overlay, 0.25, { BackgroundTransparency = 0.35 })
	ui.Scale.Scale = 0.7
	tween(ui.Scale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	for index, star in ipairs(ui.Stars) do
		local lit = index <= stars
		star.Label.TextTransparency = lit and 0 or 0.72
		star.Label.TextColor3 = C.White
		star.Scale.Scale = 0
		task.delay(0.25 + index * 0.18, function()
			if not self.Alive or not ui.Overlay.Visible then
				return
			end
			tween(star.Scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
			if lit then
				self:Sound("Pop", 0.9 + index * 0.15)
				self:Burst(star.Holder, C.Yellow, 7)
			end
		end)
	end
	if won then
		self:Sound(stars >= 3 and "Jackpot" or "SlotWin")
		task.delay(0.2, function()
			if self.Alive then
				self:Confetti(26)
			end
		end)
	else
		self:Sound("Error")
	end
end

function Kit:HideResult()
	self.ResultUI.Overlay.Visible = false
end

----------------------------------------------------------------------
-- HUD
----------------------------------------------------------------------

function Kit:SetStat(key: string, text: string, pop: boolean?)
	local stat = self.Stats[key]
	if not stat then
		return
	end
	if stat.Value.Text ~= text then
		stat.Value.Text = text
		if pop then
			local s = stat.Value:FindFirstChild("Pop")
			if s then
				s.Scale = 1.25
				tween(s, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
			end
		end
	end
end

function Kit:SetCaption(key: string, text: string)
	local stat = self.Stats[key]
	if stat then
		local caption = stat.Tile:FindFirstChild("Caption")
		if caption then
			caption.Text = text
		end
	end
end

-- Humeur du compagnon (emoji) + petit conseil ; bounce = petit saut
function Kit:Mood(emoji: string, tip: string?, bounce: boolean?)
	local buddy = self.Buddy
	buddy.FaceText.Text = emoji
	if tip then
		buddy.Tip.Text = tip
	end
	if bounce ~= false then
		buddy.Scale.Scale = 1.25
		tween(buddy.Scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	end
end

-- Hauteur (en pixels "design") de la zone Extra : sert à n'afficher un
-- widget que s'il tient (téléphone : zone plus petite)
function Kit:ExtraHeight(): number
	local title = self.Hud:FindFirstChild("Title")
	local unit = title and title.AbsoluteSize.Y / 58 or 0
	if unit <= 0 then
		return 0
	end
	return self.Extra.AbsoluteSize.Y / unit
end

-- Jauge d'étoiles (étoiles gagnées + progression vers la suivante), dans la zone Extra
function Kit:UseRating(top: number, caption: string?)
	local frame = create("Frame", {
		Name = "Rating",
		Position = UDim2.fromOffset(0, top),
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundColor3 = C.Card,
		BackgroundTransparency = 0.15,
		ZIndex = 2,
		Parent = self.Extra,
	})
	corner(frame, 12)
	stroke(frame, C.Yellow, 1.5, 0.55)
	gradient(frame, C.CardLight, C.CardDark, 90)
	label({
		Position = UDim2.fromOffset(10, 4),
		Size = UDim2.new(0.42, -10, 0, 12),
		Font = Kit.FontBody,
		TextColor3 = C.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = self:T(caption or "Stars"),
		MaxTextSize = 11,
		ZIndex = 3,
		Parent = frame,
	})
	local stars = {}
	for index = 1, 3 do
		local star = label({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.44 + (index - 1) * 0.18, 8, 0.44, 0),
			Size = UDim2.fromOffset(26, 26),
			Text = "⭐",
			TextTransparency = 0.75,
			MaxTextSize = 22,
			ZIndex = 3,
			Parent = frame,
		})
		stars[index] = { Label = star, Scale = create("UIScale", { Parent = star }), Lit = false }
	end
	local bar = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -5),
		Size = UDim2.new(1, -20, 0, 5),
		BackgroundColor3 = C.CardDark,
		ZIndex = 3,
		Parent = frame,
	})
	corner(bar, UDim.new(1, 0))
	local fill = create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = C.Yellow,
		ZIndex = 4,
		Parent = bar,
	})
	corner(fill, UDim.new(1, 0))
	gradient(fill, self.Accent:Lerp(C.White, 0.2), C.Yellow, 0)
	self.Rating = { Frame = frame, Stars = stars, Fill = fill, Top = top }
	-- Cachée si la zone est trop petite (téléphone)
	task.defer(function()
		if self.Alive then
			self:_Relayout()
		end
	end)
end

-- stars : 0..3 ; progress : 0..1 vers l'étoile suivante (nil = barre pleine)
function Kit:SetRating(stars: number, progress: number?)
	local rating = self.Rating
	if not rating then
		return
	end
	for index, star in ipairs(rating.Stars) do
		local lit = index <= stars
		if lit ~= star.Lit then
			star.Lit = lit
			star.Label.TextTransparency = lit and 0 or 0.75
			if lit then
				star.Scale.Scale = 1.6
				tween(star.Scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
			end
		end
	end
	local value = stars >= 3 and 1 or math.clamp(progress or 1, 0, 1)
	rating.Fill.Size = UDim2.fromScale(value, 1)
end

-- Étoiles + progression pour un score "plus grand = mieux"
function Kit:SetRatingFromScore(value: number, thresholds: { number })
	local stars = 0
	for index, threshold in ipairs(thresholds) do
		if value >= threshold then
			stars = index
		end
	end
	local progress = 1
	if stars < 3 then
		local low = stars > 0 and thresholds[stars] or 0
		local high = thresholds[stars + 1]
		progress = (value - low) / math.max(1, high - low)
	end
	self:SetRating(stars, progress)
end

-- Texte "Prochaine ⭐" pour les jeux à seuils
function Kit:NextStarText(value: number, thresholds: { number }, format: ((number) -> string)?): string
	for index, threshold in ipairs(thresholds) do
		if value < threshold then
			return string.rep("⭐", index - 1) .. (format and format(threshold) or tostring(threshold))
		end
	end
	return "⭐⭐⭐"
end

----------------------------------------------------------------------
-- Effets (cadres réutilisés)
----------------------------------------------------------------------

-- Position (échelle 0..1 dans Root) du centre d'un objet
function Kit:RootPoint(guiObject: GuiObject): Vector2
	local root = self.Root
	local size = root.AbsoluteSize
	if size.X <= 0 or size.Y <= 0 then
		return Vector2.new(0.5, 0.5)
	end
	local center = guiObject.AbsolutePosition + guiObject.AbsoluteSize / 2 - root.AbsolutePosition
	return Vector2.new(center.X / size.X, center.Y / size.Y)
end

local function takeFromPool(pool, make)
	for _, item in ipairs(pool) do
		if not item.Active then
			return item
		end
	end
	if #pool >= 64 then
		return nil
	end
	local item = make()
	table.insert(pool, item)
	return item
end

-- Petite explosion de confettis autour d'un objet
function Kit:Burst(guiObject: GuiObject?, color: Color3?, count: number?)
	local origin = guiObject and self:RootPoint(guiObject) or Vector2.new(0.5, 0.5)
	local root = self.Root
	local aspect = root.AbsoluteSize.Y > 0 and root.AbsoluteSize.X / root.AbsoluteSize.Y or 2
	for _ = 1, count or 8 do
		local particle = takeFromPool(self.Particles, function()
			local frame = create("Frame", {
				Size = UDim2.fromOffset(7, 7),
				AnchorPoint = Vector2.new(0.5, 0.5),
				BorderSizePixel = 0,
				Visible = false,
				ZIndex = 21,
				Parent = self.Fx,
			})
			corner(frame, 2)
			return { Frame = frame, Active = false }
		end)
		if not particle then
			break
		end
		local angle = math.random() * math.pi * 2
		local speed = 0.18 + math.random() * 0.3
		particle.Active = true
		particle.X, particle.Y = origin.X, origin.Y
		particle.VX = math.cos(angle) * speed / aspect
		particle.VY = math.sin(angle) * speed - 0.25
		particle.Life = 0.55 + math.random() * 0.35
		particle.Age = 0
		particle.Spin = (math.random() - 0.5) * 720
		local frame = particle.Frame
		frame.BackgroundColor3 = (color and math.random() < 0.6) and color or CONFETTI[math.random(1, #CONFETTI)]
		local size = math.random(5, 9)
		frame.Size = UDim2.fromOffset(size, size)
		frame.Visible = true
	end
end

-- Pluie de confettis depuis le haut (victoire)
function Kit:Confetti(count: number)
	local root = self.Root
	local aspect = root.AbsoluteSize.Y > 0 and root.AbsoluteSize.X / root.AbsoluteSize.Y or 2
	for _ = 1, count do
		local particle = takeFromPool(self.Particles, function()
			local frame = create("Frame", {
				Size = UDim2.fromOffset(7, 7),
				AnchorPoint = Vector2.new(0.5, 0.5),
				BorderSizePixel = 0,
				Visible = false,
				ZIndex = 21,
				Parent = self.Fx,
			})
			corner(frame, 2)
			return { Frame = frame, Active = false }
		end)
		if not particle then
			break
		end
		particle.Active = true
		particle.X = math.random()
		particle.Y = -0.05 - math.random() * 0.2
		particle.VX = (math.random() - 0.5) * 0.12 / aspect
		particle.VY = 0.25 + math.random() * 0.25
		particle.Life = 1.6 + math.random() * 0.6
		particle.Age = 0
		particle.Spin = (math.random() - 0.5) * 540
		local frame = particle.Frame
		frame.BackgroundColor3 = CONFETTI[math.random(1, #CONFETTI)]
		frame.Size = UDim2.fromOffset(math.random(5, 9), math.random(8, 12))
		frame.Visible = true
	end
end

-- Texte qui monte et s'efface ("+1", "-2"...)
function Kit:Float(guiObject: GuiObject?, text: string, color: Color3?)
	local origin = guiObject and self:RootPoint(guiObject) or Vector2.new(0.5, 0.5)
	local item = takeFromPool(self.Floats, function()
		local l = label({
			Size = UDim2.fromOffset(90, 30),
			AnchorPoint = Vector2.new(0.5, 0.5),
			MaxTextSize = 26,
			TextStrokeTransparency = 0.3,
			Visible = false,
			ZIndex = 22,
			Parent = self.Fx,
		})
		return { Label = l, Active = false }
	end)
	if not item then
		return
	end
	item.Active = true
	item.X, item.Y = origin.X, origin.Y
	item.Age = 0
	item.Life = 0.8
	local l = item.Label
	l.Text = text
	l.TextColor3 = color or C.White
	l.TextStrokeColor3 = C.BgBottom
	l.Visible = true
end

-- Secousse d'un objet (position d'origine gardée)
function Kit:Shake(guiObject: GuiObject, strength: number?)
	if self.ShakeTarget and self.ShakeTarget ~= guiObject then
		self.ShakeTarget.Position = self.ShakeOrigin
	end
	if self.ShakeTarget ~= guiObject then
		self.ShakeOrigin = guiObject.Position
	end
	self.ShakeTarget = guiObject
	self.ShakeTime = 0.35
	self.ShakeStrength = strength or 6
end

function Kit:_Step(dt: number)
	if not self.Alive then
		return
	end
	for _, fn in ipairs(self.FrameFns) do
		local ok, err = pcall(fn, dt)
		if not ok then
			warn("[Solo_" .. self.Id .. "] " .. tostring(err))
		end
	end
	-- Confettis
	for _, particle in ipairs(self.Particles) do
		if particle.Active then
			particle.Age += dt
			if particle.Age >= particle.Life then
				particle.Active = false
				particle.Frame.Visible = false
			else
				particle.VY += 0.9 * dt
				particle.X += particle.VX * dt
				particle.Y += particle.VY * dt
				local frame = particle.Frame
				frame.Position = UDim2.fromScale(particle.X, particle.Y)
				frame.Rotation += particle.Spin * dt
				frame.BackgroundTransparency = math.clamp((particle.Age / particle.Life - 0.6) * 2.5, 0, 1)
			end
		end
	end
	-- Textes flottants
	for _, item in ipairs(self.Floats) do
		if item.Active then
			item.Age += dt
			local k = item.Age / item.Life
			if k >= 1 then
				item.Active = false
				item.Label.Visible = false
			else
				item.Label.Position = UDim2.fromScale(item.X, item.Y - 0.08 * k)
				item.Label.TextTransparency = math.clamp((k - 0.5) * 2, 0, 1)
				item.Label.TextStrokeTransparency = 0.3 + 0.7 * math.clamp((k - 0.5) * 2, 0, 1)
			end
		end
	end
	-- Compagnon qui respire doucement
	local buddy = self.Buddy
	buddy.Bob += dt
	buddy.FaceText.Rotation = math.sin(buddy.Bob * 2.2) * 6

	-- Secousse
	if self.ShakeTarget then
		self.ShakeTime -= dt
		local target = self.ShakeTarget
		if self.ShakeTime <= 0 then
			target.Position = self.ShakeOrigin
			self.ShakeTarget = nil
		else
			local amount = self.ShakeStrength * (self.ShakeTime / 0.35)
			target.Position = self.ShakeOrigin
				+ UDim2.fromOffset(math.random(-100, 100) / 100 * amount, math.random(-100, 100) / 100 * amount)
		end
	end
end

function Kit:OnFrame(fn: (number) -> ())
	table.insert(self.FrameFns, fn)
end

----------------------------------------------------------------------
-- Entrées, sons, textes
----------------------------------------------------------------------

-- Touches (flèches / ZQSD / WASD) -> direction 1 haut, 2 droite, 3 bas, 4 gauche
local KEY_DIRECTIONS = {
	[Enum.KeyCode.Up] = 1,
	[Enum.KeyCode.W] = 1,
	[Enum.KeyCode.Z] = 1,
	[Enum.KeyCode.Right] = 2,
	[Enum.KeyCode.D] = 2,
	[Enum.KeyCode.Down] = 3,
	[Enum.KeyCode.S] = 3,
	[Enum.KeyCode.Left] = 4,
	[Enum.KeyCode.A] = 4,
	[Enum.KeyCode.Q] = 4,
}
Kit.KeyDirections = KEY_DIRECTIONS

-- Clavier (ignoré pendant la saisie dans le chat / une zone de texte)
function Kit:OnKey(callback: (Enum.KeyCode) -> ())
	table.insert(self.Connections, UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not self.Alive or input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		if UserInputService:GetFocusedTextBox() then
			return
		end
		callback(input.KeyCode)
	end))
end

-- Glissés du doigt / de la souris sur un objet -> direction
function Kit:OnSwipe(target: GuiObject, callback: (number) -> ())
	local start: Vector2? = nil
	table.insert(self.Connections, target.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			start = Vector2.new(input.Position.X, input.Position.Y)
		end
	end))
	local function finish(input)
		if not start then
			return
		end
		if input.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		local delta = Vector2.new(input.Position.X, input.Position.Y) - start
		start = nil
		if delta.Magnitude < 24 then
			return
		end
		if math.abs(delta.X) > math.abs(delta.Y) then
			callback(delta.X > 0 and 2 or 4)
		else
			callback(delta.Y > 0 and 3 or 1)
		end
	end
	table.insert(self.Connections, UserInputService.InputEnded:Connect(finish))
end

function Kit:Invoke(action: string, arg: any): (boolean, any)
	local invoke = self.Api.Invoke
	if type(invoke) ~= "function" then
		return false, nil
	end
	local ok, success, result = pcall(invoke, action, arg)
	if not ok then
		return false, nil
	end
	return success == true, result
end

function Kit:Sound(name: string, pitch: number?)
	local sounds = self.Api.Sounds
	if type(sounds) == "table" and type(sounds.Play) == "function" then
		pcall(sounds.Play, name, pitch)
	end
end

function Kit:Notify(text: string, color: Color3?)
	if type(self.Api.Notify) == "function" then
		pcall(self.Api.Notify, text, color)
	end
end

function Kit:T(text: string, ...): string
	return Kit.Translate(self.Api, text, ...)
end

-- Traduction sans instance (utilisable avant la fin de Kit.new)
function Kit.Translate(api, text: string, ...): string
	local translate = type(api) == "table" and api.T or nil
	if type(translate) == "function" then
		local ok, result = pcall(translate, text, ...)
		if ok and type(result) == "string" then
			return result
		end
	end
	if select("#", ...) > 0 then
		local ok, result = pcall(string.format, text, ...)
		if ok then
			return result
		end
	end
	return text
end

function Kit:Destroy()
	if not self.Alive then
		return
	end
	self.Alive = false
	-- Partie en cours : on la termine côté serveur (sans attendre)
	local token = self.Token
	if token and not self.Finished and self.Spec.QuitArg then
		local arg = self.Spec.QuitArg()
		if type(arg) == "table" then
			arg.Token = token
			task.spawn(function()
				pcall(self.Api.Invoke, "solo:finish", arg)
			end)
		end
	end
	for _, connection in ipairs(self.Connections) do
		connection:Disconnect()
	end
	table.clear(self.Connections)
	table.clear(self.FrameFns)
	self.Root:Destroy()
end

return Kit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="104">
          <Properties>
            <string name="Name">Solo_Logic</string>
            <string name="Source"><![CDATA[--[[
	Solo_Logic (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Minigames > Solo_Logic

	🕹️ Logique PURE des mini-jeux solo de l'arcade (aucune instance Roblox,
	aucun service) : partagée par le serveur (Services > Arcade > SoloGames :
	validation, rejeu des parties) et par les modules clients Solo_* (même
	simulation des deux côtés => mêmes résultats, aucune désynchronisation).

	Contenu :
	  - Logic.Rng(seed)          : générateur pseudo-aléatoire déterministe (xorshift32)
	  - Logic.Games              : règles, difficultés, récompenses, plafonds du jour
	  - Logic.Stars / Reward     : étoiles (0 à 3) et récompenses d'une partie
	  - Démineur                 : génération (1er clic sûr), révélation en cascade
	  - Memory                   : paquet de paires
	  - Tape-taupe               : programme des taupes (graine)
	  - Snake                    : simulation pas à pas (graine)
	  - 2048                     : simulation des coups (graine)

	Les récompenses sont des 🎟️ tickets, un 🏆 trophée (jamais achetable) et
	des SECONDES de production de Dopamine (aucune mise, aucun hasard payant :
	jeux d'adresse).
]]

local Logic = {}

----------------------------------------------------------------------
-- Générateur pseudo-aléatoire déterministe (identique client / serveur)
----------------------------------------------------------------------

export type Rng = {
	Next: () -> number,
	Int: (a: number, b: number) -> number,
}

function Logic.Rng(seed: number?): Rng
	local state = math.floor(tonumber(seed) or 1) % 4294967296
	if state ~= state or state <= 0 then
		state = 2654435769
	end
	local function step(): number
		state = bit32.bxor(state, bit32.lshift(state, 13))
		state = bit32.bxor(state, bit32.rshift(state, 17))
		state = bit32.bxor(state, bit32.lshift(state, 5))
		return state
	end
	-- Quelques tours à vide : deux graines proches donnent des suites différentes
	for _ = 1, 6 do
		step()
	end
	local rng = {}
	function rng.Next(): number
		return step() / 4294967296
	end
	function rng.Int(a: number, b: number): number
		if b <= a then
			return a
		end
		return a + math.floor(rng.Next() * (b - a + 1))
	end
	return rng
end

----------------------------------------------------------------------
-- Règles des jeux (paramètres de chaque difficulté)
--   Les récompenses de BASE (Tickets, RewardSeconds, DailyRewarded) sont
--   dans Shared > ArcadeConfig (GamesById[Id]) : une victoire donne la base
--   (api.RewardWin), puis un bonus selon la difficulté et les étoiles
--   (Logic.Multiplier, jamais plus de parties récompensées par jour).
--   MinSeconds : durée minimale d'une victoire récompensée (anti-triche).
----------------------------------------------------------------------

Logic.DifficultyOrder = { "Easy", "Normal", "Hard" }
Logic.DifficultyInfo = {
	Easy = { Name = "Easy", Icon = "🌱", Color = Color3.fromRGB(96, 206, 140) },
	Normal = { Name = "Normal", Icon = "⭐", Color = Color3.fromRGB(255, 170, 60) },
	Hard = { Name = "Hard", Icon = "🔥", Color = Color3.fromRGB(240, 84, 120) },
}
Logic.SessionTimeout = 1800 -- une partie abandonnée expire après 30 min
Logic.GameOrder = { "Minesweeper", "Memory", "Simon", "WhackAMole", "Snake", "Game2048" }

Logic.Games = {
	Minesweeper = {
		Name = "Minesweeper",
		Icon = "💣",
		BestLower = true, -- record = meilleur temps (en secondes)
		Difficulties = {
			Easy = { Cols = 8, Rows = 8, Mines = 10, Fast = 45, Ok = 100, MinSeconds = 2 },
			Normal = { Cols = 12, Rows = 10, Mines = 20, Fast = 110, Ok = 240, MinSeconds = 5 },
			Hard = { Cols = 16, Rows = 12, Mines = 38, Fast = 240, Ok = 480, MinSeconds = 10 },
		},
	},
	Memory = {
		Name = "Memory",
		Icon = "🃏",
		BestLower = true, -- record = moins de coups
		Difficulties = {
			Easy = { Cols = 4, Rows = 3, Pairs = 6, MinSeconds = 4 },
			Normal = { Cols = 4, Rows = 4, Pairs = 8, MinSeconds = 6 },
			Hard = { Cols = 6, Rows = 4, Pairs = 12, MinSeconds = 10 },
		},
	},
	Simon = {
		Name = "Simon",
		Icon = "🎵",
		MaxRounds = 30,
		Difficulties = {
			Easy = { Pads = 4, Step = 0.6, Thresholds = { 3, 6, 9 } },
			Normal = { Pads = 4, Step = 0.45, Thresholds = { 4, 8, 12 } },
			Hard = { Pads = 6, Step = 0.38, Thresholds = { 5, 9, 13 } },
		},
	},
	WhackAMole = {
		Name = "Whack-a-Mole",
		Icon = "🔨",
		Holes = 9,
		Duration = 30,
		Difficulties = {
			Easy = { Every = 0.95, Up = 1.35, Gold = 0.08, Bomb = 0.08, Fractions = { 0.35, 0.55, 0.75 } },
			Normal = { Every = 0.72, Up = 1.05, Gold = 0.1, Bomb = 0.12, Fractions = { 0.35, 0.55, 0.75 } },
			Hard = { Every = 0.52, Up = 0.8, Gold = 0.12, Bomb = 0.15, Fractions = { 0.35, 0.55, 0.75 } },
		},
	},
	Snake = {
		Name = "Snake",
		Icon = "🐍",
		MaxTicks = 30000,
		Difficulties = {
			Easy = { Cols = 14, Rows = 10, Tick = 0.16, Wrap = true, Thresholds = { 5, 12, 20 } },
			Normal = { Cols = 16, Rows = 11, Tick = 0.125, Wrap = false, Thresholds = { 6, 14, 24 } },
			Hard = { Cols = 18, Rows = 12, Tick = 0.095, Wrap = false, Thresholds = { 8, 16, 28 } },
		},
	},
	Game2048 = {
		Name = "2048",
		Icon = "🔢",
		Size = 4,
		MaxMoves = 8000,
		MinMoveSeconds = 0.05, -- 20 coups / s maximum
		Difficulties = {
			Easy = { Target = 256, Thresholds = { 64, 128, 256 } },
			Normal = { Target = 512, Thresholds = { 128, 256, 512 } },
			Hard = { Target = 2048, Thresholds = { 512, 1024, 2048 } },
		},
	},
}

-- v9.8 (DESK98) 🏃 "Desk Runner" (bureau gamer, simulation : Shared >
-- DeskRunnerLogic ; rejoué par SoloGames). Pas dans GameOrder : jamais
-- listé dans le panneau Arcade. Mêmes seuils que DeskRunnerLogic.Rules.
Logic.Games.DeskRunner = {
	Name = "Desk Runner",
	Icon = "🏃",
	MaxTicks = 18000,
	Hidden = true,
	Difficulties = {
		Normal = { Thresholds = { 400, 1000, 2000 } },
	},
}

-- Règles d'une difficulté (nil si inconnue : arguments "poubelle")
function Logic.GetRules(gameId: any, difficulty: any): (any, any)
	if type(gameId) ~= "string" or type(difficulty) ~= "string" then
		return nil, nil
	end
	local game = Logic.Games[gameId]
	if not game then
		return nil, nil
	end
	local rules = game.Difficulties[difficulty]
	if not rules then
		return nil, nil
	end
	return game, rules
end

-- Étoiles d'un score "plus grand = mieux" (seuils croissants)
local function starsFromThresholds(value: number, thresholds: { number }): (number, number)
	local stars = 0
	for index, threshold in ipairs(thresholds) do
		if value >= threshold then
			stars = index
		end
	end
	local progress = 0
	if stars == 0 and thresholds[1] and thresholds[1] > 0 then
		progress = math.clamp(value / thresholds[1], 0, 1)
	end
	return stars, progress
end
Logic.StarsFromThresholds = starsFromThresholds

-- Étoiles d'une partie : metrics dépend du jeu (voir chaque jeu plus bas)
function Logic.Stars(gameId: string, rules: any, metrics: any): (number, number)
	if gameId == "Minesweeper" then
		if metrics.Won then
			local t = metrics.Time or math.huge
			return (t <= rules.Fast and 3) or (t <= rules.Ok and 2) or 1, 1
		end
		return 0, math.clamp(metrics.Progress or 0, 0, 1)
	elseif gameId == "Memory" then
		if metrics.Won then
			local moves = metrics.Moves or math.huge
			if moves <= math.ceil(rules.Pairs * 1.5) then
				return 3, 1
			elseif moves <= math.ceil(rules.Pairs * 2.25) then
				return 2, 1
			end
			return 1, 1
		end
		return 0, math.clamp(metrics.Progress or 0, 0, 1)
	elseif gameId == "Simon" or gameId == "Snake" or gameId == "DeskRunner" then
		return starsFromThresholds(metrics.Score or 0, rules.Thresholds)
	elseif gameId == "WhackAMole" then
		local max = math.max(1, metrics.Max or 1)
		local fractions = rules.Fractions
		local thresholds = {}
		for index, fraction in ipairs(fractions) do
			thresholds[index] = math.max(1, math.floor(max * fraction + 0.5))
		end
		return starsFromThresholds(metrics.Score or 0, thresholds)
	elseif gameId == "Game2048" then
		return starsFromThresholds(metrics.MaxTile or 0, rules.Thresholds)
	end
	return 0, 0
end

-- Multiplicateur de la récompense de base [difficulté][étoiles]
Logic.Multiplier = {
	Easy = { 1, 1, 1.25 },
	Normal = { 1, 1.25, 1.5 },
	Hard = { 1.25, 1.75, 2.25 },
}

-- Récompense totale d'une victoire : (tickets, secondes) à partir de la base
-- ArcadeConfig (baseTickets, baseSeconds). 0 étoile = rien.
function Logic.Reward(baseTickets: number, baseSeconds: number, difficulty: string, stars: number): (number, number)
	local row = Logic.Multiplier[difficulty]
	if not row or not stars or stars < 1 then
		return 0, 0
	end
	local factor = row[math.clamp(math.floor(stars), 1, 3)]
	return math.floor((baseTickets or 0) * factor + 0.5), math.floor((baseSeconds or 0) * factor + 0.5)
end

----------------------------------------------------------------------
-- 💣 Démineur (généré et révélé par le SERVEUR uniquement)
----------------------------------------------------------------------

-- Voisins (8 directions) d'une case (index 1..cols*rows, ligne par ligne)
function Logic.Neighbors(cols: number, rows: number, index: number): { number }
	local list = {}
	local x = (index - 1) % cols
	local y = (index - 1) // cols
	for dy = -1, 1 do
		for dx = -1, 1 do
			if dx ~= 0 or dy ~= 0 then
				local nx, ny = x + dx, y + dy
				if nx >= 0 and nx < cols and ny >= 0 and ny < rows then
					table.insert(list, ny * cols + nx + 1)
				end
			end
		end
	end
	return list
end

-- Plateau vide (les mines sont posées au premier clic)
function Logic.MineBoard(cols: number, rows: number, mines: number)
	return {
		Cols = cols,
		Rows = rows,
		MineCount = mines,
		Mines = nil :: { [number]: boolean }?,
		Counts = {} :: { [number]: number },
		Revealed = {} :: { [number]: boolean },
		RevealedCount = 0,
		SafeTotal = cols * rows - mines,
	}
end

-- Pose les mines en évitant la case cliquée et ses voisines (1er clic sûr,
-- et toujours une petite zone qui s'ouvre). randomInt(a, b) : entier aléatoire.
function Logic.MinePlace(board, safeIndex: number, randomInt: (number, number) -> number)
	local cols, rows = board.Cols, board.Rows
	local total = cols * rows
	local excluded = { [safeIndex] = true }
	for _, n in ipairs(Logic.Neighbors(cols, rows, safeIndex)) do
		excluded[n] = true
	end
	local candidates = {}
	for index = 1, total do
		if not excluded[index] then
			table.insert(candidates, index)
		end
	end
	if #candidates < board.MineCount then
		-- plateau trop petit : on n'exclut que la case cliquée
		candidates = {}
		for index = 1, total do
			if index ~= safeIndex then
				table.insert(candidates, index)
			end
		end
	end
	local mines = {}
	local count = math.min(board.MineCount, #candidates)
	-- Mélange partiel (Fisher-Yates) : les `count` premières cases = mines
	for k = 1, count do
		local j = randomInt(k, #candidates)
		candidates[k], candidates[j] = candidates[j], candidates[k]
		mines[candidates[k]] = true
	end
	board.Mines = mines
	board.MineCount = count
	board.SafeTotal = total - count
	for index = 1, total do
		local n = 0
		for _, neighbor in ipairs(Logic.Neighbors(cols, rows, index)) do
			if mines[neighbor] then
				n += 1
			end
		end
		board.Counts[index] = n
	end
end

-- Révèle une case (cascade sur les zéros). Renvoie (liste des cases
-- nouvellement révélées, boom: boolean).
function Logic.MineReveal(board, index: number): ({ number }, boolean)
	local mines = board.Mines
	if not mines or board.Revealed[index] then
		return {}, false
	end
	if mines[index] then
		return { index }, true
	end
	local opened = {}
	local stack = { index }
	board.Revealed[index] = true
	while #stack > 0 do
		local current = table.remove(stack)
		table.insert(opened, current)
		board.RevealedCount += 1
		if board.Counts[current] == 0 then
			for _, neighbor in ipairs(Logic.Neighbors(board.Cols, board.Rows, current)) do
				if not board.Revealed[neighbor] and not mines[neighbor] then
					board.Revealed[neighbor] = true
					table.insert(stack, neighbor)
				end
			end
		end
	end
	return opened, false
end

function Logic.MineWon(board): boolean
	return board.Mines ~= nil and board.RevealedCount >= board.SafeTotal
end

----------------------------------------------------------------------
-- 🃏 Memory (paquet gardé par le SERVEUR, cartes révélées une à une)
----------------------------------------------------------------------

Logic.MemorySymbols = {
	{ "🍓", Color3.fromRGB(255, 120, 140) },
	{ "🐱", Color3.fromRGB(255, 190, 110) },
	{ "🌈", Color3.fromRGB(140, 170, 255) },
	{ "🍩", Color3.fromRGB(255, 150, 200) },
	{ "🦄", Color3.fromRGB(200, 150, 255) },
	{ "🌸", Color3.fromRGB(255, 170, 205) },
	{ "🐸", Color3.fromRGB(120, 210, 130) },
	{ "🍉", Color3.fromRGB(255, 110, 120) },
	{ "⭐", Color3.fromRGB(255, 205, 70) },
	{ "🐼", Color3.fromRGB(160, 160, 175) },
	{ "🍭", Color3.fromRGB(255, 130, 220) },
	{ "🎀", Color3.fromRGB(255, 105, 160) },
	{ "🐙", Color3.fromRGB(250, 130, 110) },
	{ "🍒", Color3.fromRGB(230, 70, 90) },
	{ "🌙", Color3.fromRGB(120, 130, 220) },
	{ "🧁", Color3.fromRGB(240, 160, 190) },
}

-- Paquet mélangé : liste de pairs*2 index de symboles
function Logic.MemoryDeck(pairs: number, randomInt: (number, number) -> number): { number }
	local pool = {}
	for index = 1, #Logic.MemorySymbols do
		pool[index] = index
	end
	for k = 1, math.min(pairs, #pool) do
		local j = randomInt(k, #pool)
		pool[k], pool[j] = pool[j], pool[k]
	end
	local deck = {}
	for k = 1, math.min(pairs, #pool) do
		table.insert(deck, pool[k])
		table.insert(deck, pool[k])
	end
	for k = #deck, 2, -1 do
		local j = randomInt(1, k)
		deck[k], deck[j] = deck[j], deck[k]
	end
	return deck
end

----------------------------------------------------------------------
-- 🔨 Tape-taupe : programme déterministe des apparitions (graine)
--   Kind : 1 = taupe (+1), 2 = taupe dorée (+3), 3 = bombe (-2)
----------------------------------------------------------------------

Logic.WhackValues = { 1, 3, -2 }

function Logic.WhackSchedule(seed: number, rules: any, holes: number, duration: number)
	local rng = Logic.Rng(seed)
	local schedule = {}
	local busyUntil = {}
	for hole = 1, holes do
		busyUntil[hole] = -1
	end
	local maxScore = 0
	local t = 0.7
	while t < duration - 0.5 and #schedule < 400 do
		local free = {}
		for hole = 1, holes do
			if busyUntil[hole] < t - 0.12 then
				table.insert(free, hole)
			end
		end
		if #free > 0 then
			local hole = free[rng.Int(1, #free)]
			-- Plus rapide vers la fin de la partie
			local rush = 1 - 0.28 * (t / duration)
			local up = math.min(rules.Up * rush * (0.85 + 0.3 * rng.Next()), duration - t)
			local roll = rng.Next()
			local kind = 1
			if roll < rules.Bomb then
				kind = 3
			elseif roll < rules.Bomb + rules.Gold then
				kind = 2
				up *= 0.8 -- les dorées filent plus vite
			end
			table.insert(schedule, { T = t, Hole = hole, Up = up, Kind = kind })
			busyUntil[hole] = t + up
			if Logic.WhackValues[kind] > 0 then
				maxScore += Logic.WhackValues[kind]
			end
		end
		local rush = 1 - 0.3 * (t / duration)
		t += rules.Every * rush * (0.7 + 0.6 * rng.Next())
	end
	return schedule, maxScore
end

-- Score d'une liste de coups (index dans le programme). Ignore les doublons
-- et les index invalides. elapsed (optionnel) : taupes pas encore sorties refusées.
function Logic.WhackScore(schedule, hits: any, elapsed: number?): (number, number)
	local score = 0
	local counted = 0
	local seen = {}
	if type(hits) ~= "table" then
		return 0, 0
	end
	for _, index in ipairs(hits) do
		if type(index) == "number" and index == index and index % 1 == 0 and not seen[index] then
			local mole = schedule[index]
			if mole and (elapsed == nil or mole.T <= elapsed + 0.5) then
				seen[index] = true
				counted += 1
				score += Logic.WhackValues[mole.Kind] or 0
			end
		end
		if counted >= #schedule then
			break
		end
	end
	return math.max(0, score), counted
end

----------------------------------------------------------------------
-- 🐍 Snake : simulation pas à pas (graine pour les fruits)
--   Directions : 1 = haut, 2 = droite, 3 = bas, 4 = gauche
----------------------------------------------------------------------

Logic.Directions = { { 0, -1 }, { 1, 0 }, { 0, 1 }, { -1, 0 } }

local function snakePlaceFood(s)
	local total = s.Cols * s.Rows
	local free = total - #s.Body
	if free <= 0 then
		s.Food = nil
		s.Full = true
		return
	end
	local k = s.Rng.Int(1, free)
	for index = 1, total do
		if not s.Occupied[index] then
			k -= 1
			if k == 0 then
				s.Food = index
				return
			end
		end
	end
end

function Logic.SnakeNew(seed: number, rules: any)
	local cols, rows = rules.Cols, rules.Rows
	local y = rows // 2
	local s = {
		Cols = cols,
		Rows = rows,
		Wrap = rules.Wrap == true,
		Rng = Logic.Rng(seed),
		Body = {} :: { number },
		Occupied = {} :: { [number]: number },
		Dir = 2,
		Tick = 0,
		Score = 0,
		Alive = true,
		Full = false,
		Food = nil :: number?,
	}
	for x = 4, 2, -1 do
		local index = y * cols + x
		table.insert(s.Body, index)
		s.Occupied[index] = (s.Occupied[index] or 0) + 1
	end
	snakePlaceFood(s)
	return s
end

-- Change de direction (refusé : même direction ou demi-tour). true si pris en compte.
function Logic.SnakeTurn(s, dir: any): boolean
	if type(dir) ~= "number" or not Logic.Directions[dir] then
		return false
	end
	if dir == s.Dir or (dir - s.Dir) % 4 == 2 then
		return false
	end
	s.Dir = dir
	return true
end

-- Avance d'une case. Renvoie "eat", "dead" ou nil.
function Logic.SnakeStep(s): string?
	if not s.Alive then
		return "dead"
	end
	s.Tick += 1
	local head = s.Body[1]
	local x = (head - 1) % s.Cols
	local y = (head - 1) // s.Cols
	local d = Logic.Directions[s.Dir]
	local nx, ny = x + d[1], y + d[2]
	if s.Wrap then
		nx %= s.Cols
		ny %= s.Rows
	elseif nx < 0 or nx >= s.Cols or ny < 0 or ny >= s.Rows then
		s.Alive = false
		return "dead"
	end
	local nextIndex = ny * s.Cols + nx + 1
	local eating = nextIndex == s.Food
	if not eating then
		-- la queue avance d'abord (on peut suivre sa propre queue)
		local tail = table.remove(s.Body)
		local left = (s.Occupied[tail] or 1) - 1
		s.Occupied[tail] = left > 0 and left or nil
	end
	if s.Occupied[nextIndex] then
		s.Alive = false
		return "dead"
	end
	table.insert(s.Body, 1, nextIndex)
	s.Occupied[nextIndex] = (s.Occupied[nextIndex] or 0) + 1
	if eating then
		s.Score += 1
		snakePlaceFood(s)
		if s.Full then
			s.Alive = false
			return "dead"
		end
		return "eat"
	end
	return nil
end

-- Durée d'un pas (le serpent accélère un peu à chaque fruit)
function Logic.SnakeInterval(rules: any, score: number): number
	return rules.Tick * math.max(0.62, 1 - 0.012 * score)
end

-- Rejoue une partie : turns = { tick1, dir1, tick2, dir2, ... } (tick
-- croissants), ticks = nombre de pas joués. Renvoie (score, pas simulés,
-- durée minimale théorique en secondes).
function Logic.SnakeReplay(seed: number, rules: any, turns: any, ticks: number, maxTicks: number)
	local s = Logic.SnakeNew(seed, rules)
	local list = type(turns) == "table" and turns or {}
	local cursor = 1
	local minDuration = 0
	local limit = math.clamp(math.floor(tonumber(ticks) or 0), 0, maxTicks)
	while s.Alive and s.Tick < limit do
		local nextTick = s.Tick + 1
		-- saute les virages "dans le passé" (liste mal triée = ignorée)
		while type(list[cursor]) == "number" and list[cursor] < nextTick do
			cursor += 2
		end
		if list[cursor] == nextTick then
			Logic.SnakeTurn(s, list[cursor + 1])
			cursor += 2
		end
		minDuration += Logic.SnakeInterval(rules, s.Score)
		Logic.SnakeStep(s)
	end
	return s.Score, s.Tick, minDuration, s
end

----------------------------------------------------------------------
-- 🔢 2048 : simulation (graine pour les nouvelles tuiles)
--   Directions : 1 = haut, 2 = droite, 3 = bas, 4 = gauche
----------------------------------------------------------------------

local function spawnTile(s)
	local free = {}
	for index = 1, s.Size * s.Size do
		if s.Cells[index] == 0 then
			table.insert(free, index)
		end
	end
	if #free == 0 then
		return nil, nil
	end
	local index = free[s.Rng.Int(1, #free)]
	local value = s.Rng.Next() < 0.9 and 2 or 4
	s.Cells[index] = value
	s.MaxTile = math.max(s.MaxTile, value)
	return index, value
end

function Logic.G2048New(seed: number, size: number?)
	local n = size or 4
	local s = { Size = n, Cells = {} :: { number }, Score = 0, MaxTile = 0, Moves = 0, Rng = Logic.Rng(seed) }
	for index = 1, n * n do
		s.Cells[index] = 0
	end
	local a, av = spawnTile(s)
	local b, bv = spawnTile(s)
	s.Initial = { { a, av }, { b, bv } }
	return s
end

-- Index des cases d'une ligne, dans le sens du mouvement
local function lineCells(size: number, dir: number, line: number): { number }
	local cells = {}
	for k = 1, size do
		local row, col
		if dir == 4 then -- gauche
			row, col = line, k
		elseif dir == 2 then -- droite
			row, col = line, size - k + 1
		elseif dir == 1 then -- haut
			row, col = k, line
		else -- bas
			row, col = size - k + 1, line
		end
		cells[k] = (row - 1) * size + col
	end
	return cells
end

-- Joue un coup. Renvoie (a bougé, infos d'animation) ; infos =
-- { Slides = { {from, to, value, merged} }, Spawn = {index, value}, Gain }
function Logic.G2048Move(s, dir: any)
	if type(dir) ~= "number" or dir < 1 or dir > 4 or dir % 1 ~= 0 then
		return false, nil
	end
	local size = s.Size
	local new = table.create(size * size, 0)
	local slides = {}
	local gain = 0
	for line = 1, size do
		local cells = lineCells(size, dir, line)
		local target = 1
		local lastValue, lastMerged = 0, true
		for k = 1, size do
			local from = cells[k]
			local value = s.Cells[from]
			if value ~= 0 then
				if value == lastValue and not lastMerged then
					local to = cells[target - 1]
					new[to] = value * 2
					gain += value * 2
					lastMerged = true
					table.insert(slides, { from, to, value, true })
				else
					local to = cells[target]
					new[to] = value
					lastValue = value
					lastMerged = false
					target += 1
					table.insert(slides, { from, to, value, false })
				end
			end
		end
	end
	local moved = false
	for index = 1, size * size do
		if new[index] ~= s.Cells[index] then
			moved = true
			break
		end
	end
	if not moved then
		return false, nil
	end
	s.Cells = new
	s.Score += gain
	s.Moves += 1
	for index = 1, size * size do
		if new[index] > s.MaxTile then
			s.MaxTile = new[index]
		end
	end
	local spawnIndex, spawnValue = spawnTile(s)
	return true, { Slides = slides, Spawn = spawnIndex and { spawnIndex, spawnValue } or nil, Gain = gain }
end

function Logic.G2048CanMove(s): boolean
	local size = s.Size
	for index = 1, size * size do
		local value = s.Cells[index]
		if value == 0 then
			return true
		end
		local col = (index - 1) % size
		if col < size - 1 and s.Cells[index + 1] == value then
			return true
		end
		if index + size <= size * size and s.Cells[index + size] == value then
			return true
		end
	end
	return false
end

Logic.G2048Letters = { U = 1, R = 2, D = 3, L = 4 }
Logic.G2048Chars = { "U", "R", "D", "L" }

-- Rejoue une suite de coups ("URDL..."). S'arrête à l'objectif ou au blocage.
function Logic.G2048Replay(seed: number, rules: any, size: number, moves: any, maxMoves: number)
	local s = Logic.G2048New(seed, size)
	local text = type(moves) == "string" and moves or ""
	local played = 0
	for k = 1, math.min(#text, maxMoves) do
		if s.MaxTile >= rules.Target then
			break
		end
		local dir = Logic.G2048Letters[string.sub(text, k, k)]
		if dir then
			local moved = Logic.G2048Move(s, dir)
			if moved then
				played += 1
			end
		end
	end
	return s, played
end

return Logic
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="105">
          <Properties>
            <string name="Name">Solo_Memory</string>
            <string name="Source"><![CDATA[--[[
	Solo_Memory (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Minigames > Solo_Memory

	🃏 Memory de l'arcade : retrouve toutes les paires. Le paquet est gardé
	par le SERVEUR : chaque carte retournée est demandée au serveur (le
	client ne connaît jamais les cartes cachées). Moins de coups = plus
	d'étoiles ; le record est le meilleur temps.
]]

local Kit = require(script.Parent.Solo_Kit)
local Logic = Kit.Logic
local C = Kit.Colors
local create = Kit.Create

local CARD_RATIO = 0.8 -- largeur / hauteur d'une carte
local FLIP_TIME = 0.26

local Module = { Id = "Memory", Kind = "Solo" }

function Module.Build(container: Frame, api)
	local kit
	local startGame: (string) -> ()
	local function T(text: string, ...): string
		return Kit.Translate(api, text, ...)
	end

	local st = {
		Cols = 4,
		Rows = 4,
		Pairs = 8,
		Found = 0,
		Moves = 0,
		Token = nil,
		Done = true,
		Started = nil :: number?,
		Clock = 0,
		Generation = 0,
		InFlight = 0,
		Open = {} :: { number }, -- cartes retournées non appariées (max 2)
		CloseAt = nil :: number?,
		Streak = 0,
	}
	local cards = {}

	kit = Kit.new(container, api, {
		Id = "Memory",
		Primary = "Moves",
		SmallA = "Pairs",
		SmallB = "Time",
		Details = function(_, rules)
			return string.format("%d × %d  ·  ", rules.Cols, rules.Rows) .. T("%d pairs", rules.Pairs)
				.. "\n" .. T("⭐⭐⭐ in %d moves max", math.ceil(rules.Pairs * 1.5))
				.. "\n" .. T("⭐⭐ in %d moves max", math.ceil(rules.Pairs * 2.25))
		end,
		BestText = Kit.FormatTime,
		ScoreText = function(result)
			local text = "🃏 " .. T("%s moves", tostring(result.Score or 0))
			if result.Won or result.Rejected then
				text ..= "  ·  ⏱️ " .. Kit.FormatTime(tonumber(result.Time) or 0)
			end
			return text
		end,
		OnPlay = function(difficulty)
			startGame(difficulty)
		end,
		OnPicker = function()
			st.Done = true
		end,
		QuitArg = function()
			return {}
		end,
	})
	kit.PickerHelp.Text = T("Flip two cards: same picture = a pair. Fewer moves, more ⭐!")

	----------------------------------------------------------------------
	-- Plateau
	----------------------------------------------------------------------
	local board = create("Frame", {
		Name = "Board",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = kit.Area,
	})
	local aspect = create("UIAspectRatioConstraint", { AspectRatio = 1, Parent = board })

	local function paintBack(card)
		card.Face.BackgroundColor3 = kit.Accent
		card.Gradient.Color = ColorSequence.new(kit.Accent:Lerp(C.White, 0.2), kit.Accent2)
		card.Gradient.Rotation = 45
		card.Stroke.Color = C.White
		card.Stroke.Transparency = 0.45
		card.Emoji.Text = "✨"
		card.Emoji.TextColor3 = C.White
		card.Emoji.TextTransparency = 0.25
		card.Emoji.Size = UDim2.fromScale(0.42, 0.42)
		card.Inner.Visible = true
	end

	local function paintFace(card, symbol: number, matched: boolean)
		local entry = Logic.MemorySymbols[symbol] or Logic.MemorySymbols[1]
		local color = entry[2]
		card.Face.BackgroundColor3 = color
		card.Gradient.Color = ColorSequence.new(color:Lerp(C.White, 0.72), color:Lerp(C.White, 0.35))
		card.Gradient.Rotation = 90
		card.Stroke.Color = matched and C.Yellow or color:Lerp(C.White, 0.3)
		card.Stroke.Transparency = matched and 0 or 0.1
		card.Emoji.Text = entry[1]
		card.Emoji.TextTransparency = 0
		card.Emoji.Size = UDim2.fromScale(0.72, 0.72)
		card.Inner.Visible = false
	end

	local onCard

	local function makeCard(index: number)
		local button = create("TextButton", {
			Name = "Card" .. index,
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			ZIndex = 4,
			Parent = board,
		})
		local face = create("Frame", {
			Name = "Face",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(1, -8, 1, -8),
			BackgroundColor3 = kit.Accent,
			ZIndex = 4,
			Parent = button,
		})
		Kit.Corner(face, UDim.new(0.14, 0))
		local stroke = Kit.Stroke(face, C.White, 2, 0.45)
		local gradientObj = create("UIGradient", { Rotation = 45, Parent = face })
		-- Liseré intérieur du dos de carte
		local inner = create("Frame", {
			Name = "Inner",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.78, 0.82),
			BackgroundTransparency = 1,
			ZIndex = 5,
			Parent = face,
		})
		Kit.Corner(inner, UDim.new(0.14, 0))
		Kit.Stroke(inner, C.White, 1.5, 0.6)
		local emoji = Kit.Label({
			Name = "Emoji",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.42, 0.42),
			Text = "✨",
			MaxTextSize = 64,
			ZIndex = 6,
			Parent = face,
		})
		local scale = create("UIScale", { Parent = face })
		local card = {
			Button = button,
			Face = face,
			Stroke = stroke,
			Gradient = gradientObj,
			Inner = inner,
			Emoji = emoji,
			Scale = scale,
			Index = index,
			State = "Back", -- Back | Open | Matched
			Symbol = nil :: number?,
			Flip = nil :: any,
		}
		paintBack(card)
		button.Activated:Connect(function()
			onCard(card.Index)
		end)
		button.MouseEnter:Connect(function()
			if card.State == "Back" and not st.Done then
				Kit.Tween(scale, 0.12, { Scale = 1.05 })
			end
		end)
		button.MouseLeave:Connect(function()
			Kit.Tween(scale, 0.12, { Scale = 1 })
		end)
		return card
	end

	local function layout()
		local total = st.Cols * st.Rows
		aspect.AspectRatio = (st.Cols * CARD_RATIO) / st.Rows
		for index = 1, math.max(total, #cards) do
			local card = cards[index]
			if index <= total then
				if not card then
					card = makeCard(index)
					cards[index] = card
				end
				local x = (index - 1) % st.Cols
				local y = (index - 1) // st.Cols
				card.Button.Position = UDim2.fromScale(x / st.Cols, y / st.Rows)
				card.Button.Size = UDim2.fromScale(1 / st.Cols, 1 / st.Rows)
				card.Button.Visible = true
				card.State = "Back"
				card.Symbol = nil
				card.Flip = nil
				card.Face.Size = UDim2.new(1, -8, 1, -8)
				card.Scale.Scale = 1
				paintBack(card)
			elseif card then
				card.Button.Visible = false
			end
		end
	end

	-- Retourne une carte (animation dans la boucle commune)
	local function flip(card, toFace: boolean, symbol: number?, matched: boolean?, delay: number?)
		card.Flip = { T = -(delay or 0), ToFace = toFace, Symbol = symbol, Matched = matched == true, Swapped = false }
	end

	kit:UseRating(0, "Rating")
	local function refreshHud()
		local three, two = math.ceil(st.Pairs * 1.5), math.ceil(st.Pairs * 2.25)
		local rating = st.Moves <= three and 3 or (st.Moves <= two and 2 or 1)
		local budget = rating == 3 and three or (rating == 2 and two or st.Moves)
		local floor = rating == 3 and 0 or (rating == 2 and three or st.Moves)
		kit:SetRating(rating, 1 - (st.Moves - floor) / math.max(1, budget - floor))
		kit:SetStat("Primary", tostring(st.Moves))
		kit:SetStat("A", string.format("%d / %d", st.Found, st.Pairs))
		kit:SetStat("B", Kit.FormatClock(st.Clock))
	end

	local function closeOpen()
		for _, index in ipairs(st.Open) do
			local card = cards[index]
			if card and card.State == "Open" then
				card.State = "Back"
				flip(card, false)
			end
		end
		st.Open = {}
		st.CloseAt = nil
	end

	----------------------------------------------------------------------
	-- Partie
	----------------------------------------------------------------------
	function startGame(difficulty: string)
		local rules = kit.GameRules.Difficulties[difficulty]
		st.Generation += 1
		local generation = st.Generation
		st.Cols, st.Rows, st.Pairs = rules.Cols, rules.Rows, rules.Pairs
		st.Found, st.Moves, st.Streak = 0, 0, 0
		st.Token = nil
		st.Done = false
		st.Started = nil
		st.Clock = 0
		st.InFlight = 0
		st.Open = {}
		st.CloseAt = nil
		layout()
		refreshHud()
		-- petite distribution animée
		for index = 1, st.Cols * st.Rows do
			local card = cards[index]
			card.Scale.Scale = 0.2
			task.delay(0.02 * index, function()
				if kit.Alive and generation == st.Generation then
					Kit.Tween(card.Scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
				end
			end)
		end
		kit:Sound("Open")
		kit:Mood("😊", T("Find all the pairs. Fewer moves = more ⭐!"))
		task.spawn(function()
			local reply = kit:StartSession()
			if generation ~= st.Generation then
				return
			end
			if not reply then
				st.Done = true
				kit:ShowPicker()
				return
			end
			st.Token = reply.Token
		end)
	end

	local function finish(result)
		st.Done = true
		kit:Mood("🥳", T("All pairs found!"))
		task.delay(0.9, function()
			if kit.Alive and st.Done then
				kit:ShowResult(result)
			end
		end)
	end

	local function applyReply(reply, generation: number)
		if type(reply) ~= "table" or reply.Ignored then
			return
		end
		local card = cards[reply.Cell]
		if not card then
			return
		end
		card.Symbol = reply.Symbol
		if reply.Other == nil then
			flip(card, true, reply.Symbol, false)
			return
		end
		local other = cards[reply.Other]
		st.Moves = tonumber(reply.Moves) or st.Moves + 1
		if reply.Match then
			st.Found = tonumber(reply.Pairs) or st.Found + 1
			st.Streak += 1
			card.State = "Matched"
			flip(card, true, reply.Symbol, true)
			if other then
				other.State = "Matched"
				paintFace(other, other.Symbol or reply.Symbol, true)
			end
			st.Open = {}
			task.delay(FLIP_TIME, function()
				if not kit.Alive or generation ~= st.Generation then
					return
				end
				for _, c in ipairs({ card, other }) do
					if c then
						c.Scale.Scale = 1.18
						Kit.Tween(c.Scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
						kit:Burst(c.Face, (Logic.MemorySymbols[c.Symbol or 1] or {})[2], 8)
					end
				end
				kit:Float(card.Face, "+1", C.Yellow)
				kit:Sound("Bonus", 1 + math.min(st.Streak, 5) * 0.08)
			end)
			if st.Streak >= 2 then
				kit:Mood("🤩", T("Combo x%d!", st.Streak))
			else
				kit:Mood("😍", T("A pair! Keep going."))
			end
			kit:SetStat("A", string.format("%d / %d", st.Found, st.Pairs), true)
		else
			st.Streak = 0
			flip(card, true, reply.Symbol, false)
			st.CloseAt = os.clock() + FLIP_TIME + 0.75
			kit:Mood("🤔", T("Not a pair... remember them!"), false)
		end
		refreshHud()
		kit:SetStat("Primary", tostring(st.Moves), true)
		if reply.Done then
			finish(reply.Result)
		end
	end

	function onCard(index: number)
		if st.Done or not st.Token then
			return
		end
		local card = cards[index]
		if not card or card.State ~= "Back" then
			return
		end
		-- deux cartes ratées encore visibles : on les referme tout de suite
		if #st.Open >= 2 then
			closeOpen()
		end
		if #st.Open >= 2 or st.InFlight >= 2 then
			return
		end
		if not st.Started then
			st.Started = os.clock()
		end
		card.State = "Open"
		table.insert(st.Open, index)
		card.Scale.Scale = 0.9
		kit:Sound("Click", 1.1)
		st.InFlight += 1
		local token, generation = st.Token, st.Generation
		task.spawn(function()
			local ok, reply = kit:Invoke("solo:move", { Token = token, Cell = index })
			if generation ~= st.Generation or not kit.Alive then
				return
			end
			st.InFlight -= 1
			Kit.Tween(card.Scale, 0.15, { Scale = 1 })
			if not ok then
				card.State = "Back"
				local position = table.find(st.Open, index)
				if position then
					table.remove(st.Open, position)
				end
				kit:Notify(type(reply) == "string" and reply or T("Something went wrong"), C.Red)
				return
			end
			applyReply(reply, generation)
		end)
	end

	----------------------------------------------------------------------
	-- Boucle : retournements, fermeture automatique, chrono
	----------------------------------------------------------------------
	local hudTimer = 0
	kit:OnFrame(function(dt)
		for _, card in ipairs(cards) do
			local anim = card.Flip
			if anim then
				anim.T += dt
				if anim.T >= 0 then
					local k = math.min(anim.T / FLIP_TIME, 1)
					if k >= 0.5 and not anim.Swapped then
						anim.Swapped = true
						if anim.ToFace and anim.Symbol then
							paintFace(card, anim.Symbol, anim.Matched)
						else
							paintBack(card)
						end
					end
					local sx = math.abs(math.cos(math.pi * k))
					card.Face.Size = UDim2.new(math.max(sx, 0.02), -8 * sx, 1, -8)
					if k >= 1 then
						card.Flip = nil
						card.Face.Size = UDim2.new(1, -8, 1, -8)
					end
				end
			end
		end
		if st.CloseAt and os.clock() >= st.CloseAt then
			closeOpen()
		end
		if st.Started and not st.Done then
			st.Clock = os.clock() - st.Started
		end
		hudTimer += dt
		if hudTimer >= 0.25 then
			hudTimer = 0
			kit:SetStat("B", Kit.FormatClock(st.Clock))
		end
	end)

	st.Cols, st.Rows, st.Pairs = 4, 3, 6
	layout()
	refreshHud()
	kit:Mood("😊", T("Flip two cards to find a pair."), false)
	kit:ShowPicker()

	return {
		Destroy = function()
			st.Generation += 1
			kit:Destroy()
		end,
	}
end

return Module
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="106">
          <Properties>
            <string name="Name">Solo_Minesweeper</string>
            <string name="Source"><![CDATA[--[[
	Solo_Minesweeper (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Minigames > Solo_Minesweeper

	💣 Démineur de l'arcade. Le SERVEUR génère le plateau au premier clic
	(premier clic toujours sûr) et révèle les cases : le client ne connaît
	jamais les mines avant la fin de la partie.
	Commandes : clic / toucher = creuser ; clic droit, appui long ou mode
	🚩 = drapeau ; clic sur un chiffre entouré de ses drapeaux = ouvre les
	voisines ("accord") ; touche F = mode drapeau.
]]

local Kit = require(script.Parent.Solo_Kit)
local Logic = Kit.Logic
local C = Kit.Colors
local create = Kit.Create

local NUMBER_COLORS = {
	Color3.fromRGB(110, 205, 255),
	Color3.fromRGB(110, 240, 160),
	Color3.fromRGB(255, 120, 190),
	Color3.fromRGB(190, 150, 255),
	Color3.fromRGB(255, 170, 90),
	Color3.fromRGB(90, 230, 220),
	Color3.fromRGB(255, 255, 255),
	Color3.fromRGB(200, 200, 215),
}
local HIDDEN_A = Color3.fromRGB(176, 146, 255)
local HIDDEN_B = Color3.fromRGB(160, 128, 248)
local OPEN_COLOR = Color3.fromRGB(34, 22, 74)

local Module = { Id = "Minesweeper", Kind = "Solo" }

function Module.Build(container: Frame, api)
	local kit
	local st = {
		Cols = 8,
		Rows = 8,
		Mines = 10,
		State = {} :: { [number]: number }, -- 0 cachée, 1 ouverte, 2 drapeau
		Numbers = {} :: { [number]: number },
		Flags = 0,
		Token = nil,
		Done = true,
		Started = nil :: number?,
		Clock = 0,
		FlagMode = false,
		Queue = {} :: { any },
		QueueTime = 0,
		Generation = 0,
	}
	local cells = {} -- pool de cases (réutilisées d'une partie à l'autre)

	local startGame: (string) -> ()
	local function T(text: string, ...): string
		return Kit.Translate(api, text, ...)
	end

	kit = Kit.new(container, api, {
		Id = "Minesweeper",
		Primary = "Mines left",
		SmallA = "Stars",
		SmallB = "Time",
		Help = "",
		Details = function(_, rules)
			return string.format("%d × %d  ·  %d 💣", rules.Cols, rules.Rows, rules.Mines)
				.. "\n" .. T("⭐⭐⭐ under %s", Kit.FormatClock(rules.Fast))
				.. "\n" .. T("⭐⭐ under %s", Kit.FormatClock(rules.Ok))
		end,
		BestText = Kit.FormatTime,
		ScoreText = function(result)
			if result.Won or result.Rejected then
				return "⏱️ " .. Kit.FormatTime(tonumber(result.Score) or 0)
			end
			return T("Boom! A mine woke up 💥")
		end,
		NoStarHint = function()
			return T("Tip: numbers tell how many mines touch the cell.")
		end,
		OnPlay = function(difficulty)
			startGame(difficulty)
		end,
		OnPicker = function()
			st.Done = true
		end,
		QuitArg = function()
			return {}
		end,
	})
	kit.PickerHelp.Text = kit.Touch and T("Tap to dig · Hold or use 🚩 to flag") or T("Click to dig · Right-click to flag · F = flag mode")

	----------------------------------------------------------------------
	-- Plateau
	----------------------------------------------------------------------
	local board = create("Frame", {
		Name = "Board",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.CardDark,
		ZIndex = 3,
		Parent = kit.Area,
	})
	Kit.Corner(board, 14)
	Kit.Stroke(board, kit.Accent, 2, 0.35)
	local aspect = create("UIAspectRatioConstraint", { AspectRatio = 1, Parent = board })
	local grid = create("Frame", {
		Name = "Grid",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -12, 1, -12),
		BackgroundTransparency = 1,
		ZIndex = 4,
		Parent = board,
	})

	-- Mode drapeau (utile au toucher)
	local flagButton = Kit.Button({
		Name = "FlagMode",
		Text = "⛏️ " .. T("Dig mode"),
		Color = C.CardLight,
		Size = UDim2.new(1, 0, 0, 40),
		MaxTextSize = 17,
		ZIndex = 3,
		Parent = kit.Extra,
	})
	local function refreshFlagButton()
		flagButton.Text = st.FlagMode and ("🚩 " .. T("Flag mode")) or ("⛏️ " .. T("Dig mode"))
		local color = st.FlagMode and C.Red or C.CardLight
		flagButton.BackgroundColor3 = color
		local g = flagButton:FindFirstChildOfClass("UIGradient")
		if g then
			g.Color = ColorSequence.new(color:Lerp(C.White, 0.28), color:Lerp(C.Black, 0.12))
		end
	end
	flagButton.Activated:Connect(function()
		st.FlagMode = not st.FlagMode
		kit:Sound("Click")
		refreshFlagButton()
		kit:Mood(st.FlagMode and "🚩" or "😊", st.FlagMode and T("Flag mode: taps place flags.") or T("Dig mode: taps open cells."))
	end)

	----------------------------------------------------------------------
	-- Cases
	----------------------------------------------------------------------
	local onPrimary, toggleFlag

	local function paintCell(index: number)
		local cell = cells[index]
		if not cell then
			return
		end
		local state = st.State[index] or 0
		local x = (index - 1) % st.Cols
		local y = (index - 1) // st.Cols
		if state == 1 then
			local n = st.Numbers[index] or 0
			cell.Tile.BackgroundColor3 = OPEN_COLOR
			cell.Tile.BackgroundTransparency = (x + y) % 2 == 0 and 0.05 or 0.25
			cell.Gradient.Enabled = false
			cell.Stroke.Transparency = 0.85
			cell.Text.Text = n > 0 and tostring(n) or ""
			cell.Text.TextColor3 = NUMBER_COLORS[n] or C.White
		else
			cell.Tile.BackgroundColor3 = (x + y) % 2 == 0 and HIDDEN_A or HIDDEN_B
			cell.Tile.BackgroundTransparency = 0
			cell.Gradient.Enabled = true
			cell.Stroke.Transparency = 0.55
			cell.Text.Text = state == 2 and "🚩" or ""
			cell.Text.TextColor3 = C.White
		end
	end

	local function makeCell(index: number)
		local button = create("TextButton", {
			Name = "Cell" .. index,
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			ZIndex = 5,
			Parent = grid,
		})
		local tile = create("Frame", {
			Name = "Tile",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(1, -3, 1, -3),
			BackgroundColor3 = HIDDEN_A,
			ZIndex = 5,
			Parent = button,
		})
		Kit.Corner(tile, UDim.new(0.18, 0))
		local stroke = Kit.Stroke(tile, C.White, 1, 0.55)
		local gradientObj = create("UIGradient", {
			Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(200, 190, 235)),
			Rotation = 90,
			Parent = tile,
		})
		local text = Kit.Label({
			Size = UDim2.fromScale(0.8, 0.8),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			MaxTextSize = 26,
			ZIndex = 6,
			Parent = tile,
		})
		local scale = create("UIScale", { Parent = tile })
		local cell = { Button = button, Tile = tile, Stroke = stroke, Gradient = gradientObj, Text = text, Scale = scale, Index = index }
		-- Appui long (toucher) = drapeau
		local pressId = 0
		local suppress = false
		button.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then
				pressId += 1
				local id = pressId
				task.delay(0.42, function()
					if pressId == id and kit.Alive then
						suppress = true
						toggleFlag(cell.Index)
					end
				end)
			end
		end)
		button.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then
				pressId += 1
			end
		end)
		button.Activated:Connect(function()
			if suppress then
				suppress = false
				return
			end
			onPrimary(cell.Index)
		end)
		button.MouseButton2Click:Connect(function()
			toggleFlag(cell.Index)
		end)
		button.MouseEnter:Connect(function()
			if (st.State[cell.Index] or 0) ~= 1 and not st.Done then
				tile.BackgroundColor3 = tile.BackgroundColor3:Lerp(C.White, 0.18)
			end
		end)
		button.MouseLeave:Connect(function()
			paintCell(cell.Index)
		end)
		return cell
	end

	local function layout()
		local total = st.Cols * st.Rows
		aspect.AspectRatio = st.Cols / st.Rows
		for index = 1, math.max(total, #cells) do
			local cell = cells[index]
			if index <= total then
				if not cell then
					cell = makeCell(index)
					cells[index] = cell
				end
				local x = (index - 1) % st.Cols
				local y = (index - 1) // st.Cols
				cell.Button.Position = UDim2.fromScale(x / st.Cols, y / st.Rows)
				cell.Button.Size = UDim2.fromScale(1 / st.Cols, 1 / st.Rows)
				cell.Button.Visible = true
				cell.Scale.Scale = 1
				paintCell(index)
			elseif cell then
				cell.Button.Visible = false
			end
		end
	end

	local function refreshHud()
		kit:SetStat("Primary", "💣 " .. tostring(st.Mines - st.Flags))
		local rules = kit.GameRules.Difficulties[kit.Difficulty]
		local t = st.Clock
		if t <= rules.Fast then
			kit:SetStat("A", "⭐⭐⭐ " .. Kit.FormatClock(rules.Fast - t))
		elseif t <= rules.Ok then
			kit:SetStat("A", "⭐⭐ " .. Kit.FormatClock(rules.Ok - t))
		else
			kit:SetStat("A", "⭐")
		end
		kit:SetStat("B", Kit.FormatClock(t))
	end

	----------------------------------------------------------------------
	-- Partie
	----------------------------------------------------------------------
	function startGame(difficulty: string)
		local rules = kit.GameRules.Difficulties[difficulty]
		st.Generation += 1
		local generation = st.Generation
		st.Cols, st.Rows, st.Mines = rules.Cols, rules.Rows, rules.Mines
		st.State = {}
		st.Numbers = {}
		st.Flags = 0
		st.Token = nil
		st.Done = false
		st.Started = nil
		st.Clock = 0
		st.Queue = {}
		st.QueueTime = 0
		layout()
		refreshHud()
		kit:Sound("Open")
		kit:Mood("😊", T("The first cell is always safe. Good luck!"))
		task.spawn(function()
			local reply = kit:StartSession()
			if generation ~= st.Generation then
				return
			end
			if not reply then
				st.Done = true
				kit:ShowPicker()
				return
			end
			st.Token = reply.Token
		end)
	end

	-- Révélation en vague (depuis la case cliquée)
	local function queueReveal(list, numbers, origin: number)
		local ox = (origin - 1) % st.Cols
		local oy = (origin - 1) // st.Cols
		for k, index in ipairs(list) do
			local x = (index - 1) % st.Cols
			local y = (index - 1) // st.Cols
			local distance = math.sqrt((x - ox) ^ 2 + (y - oy) ^ 2)
			st.Numbers[index] = numbers[k]
			if st.State[index] == 2 then
				st.Flags -= 1
			end
			st.State[index] = 1
			table.insert(st.Queue, { Index = index, At = st.QueueTime + math.min(distance * 0.022, 0.45) })
		end
	end

	local function revealMines(mines: { number }, won: boolean, boomCell: number?)
		local mineSet = {}
		for k, index in ipairs(mines) do
			mineSet[index] = true
			local cell = cells[index]
			if cell then
				task.delay((index == boomCell and 0 or 0.12 + k * 0.035), function()
					if not kit.Alive or not cell.Button.Visible then
						return
					end
					cell.Gradient.Enabled = false
					cell.Tile.BackgroundTransparency = 0
					if won then
						cell.Tile.BackgroundColor3 = Color3.fromRGB(255, 190, 225)
						cell.Text.Text = "🌸"
					else
						cell.Tile.BackgroundColor3 = index == boomCell and C.Red or Color3.fromRGB(120, 50, 110)
						cell.Text.Text = index == boomCell and "💥" or "💣"
					end
					cell.Scale.Scale = 0.4
					Kit.Tween(cell.Scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
				end)
			end
		end
		if not won then
			-- Drapeaux mal placés
			for index, state in pairs(st.State) do
				if state == 2 and not mineSet[index] and cells[index] then
					cells[index].Text.Text = "❌"
				end
			end
		end
	end

	local function applyReply(reply, origin: number)
		if type(reply) ~= "table" then
			return
		end
		if type(reply.Cells) == "table" and type(reply.Numbers) == "table" and #reply.Cells > 0 then
			queueReveal(reply.Cells, reply.Numbers, origin)
			kit:Sound("Pop", 0.9 + math.min(#reply.Cells, 30) / 60)
			if #reply.Cells >= 12 then
				kit:Mood("🤩", T("Wow, a big opening!"))
			else
				kit:Mood("😊", nil, false)
			end
		end
		if reply.Done then
			st.Done = true
			local mines = type(reply.Mines) == "table" and reply.Mines or {}
			if reply.Boom then
				kit:Sound("Thunder")
				kit:Shake(board, 9)
				kit:Mood("😵", T("Boom! Numbers show how many mines touch a cell."))
				revealMines(mines, false, reply.Cell)
				task.delay(1.4, function()
					if kit.Alive and st.Done then
						kit:ShowResult(reply.Result)
					end
				end)
			else
				-- les drapeaux posés restent : on les compte comme trouvés
				st.Flags = st.Mines
				kit:Mood("😎", T("All clear! The mines turned into flowers."))
				refreshHud()
				task.delay(0.35, function()
					if kit.Alive then
						revealMines(mines, true, nil)
						kit:Burst(board, C.Pink, 16)
					end
				end)
				task.delay(1.3, function()
					if kit.Alive and st.Done then
						kit:ShowResult(reply.Result)
					end
				end)
			end
		end
	end

	local function send(list: { number }, origin: number)
		if st.Done or not st.Token then
			return
		end
		local token = st.Token
		local generation = st.Generation
		if not st.Started then
			st.Started = os.clock()
		end
		for _, index in ipairs(list) do
			local cell = cells[index]
			if cell then
				cell.Scale.Scale = 0.86
			end
		end
		kit:Mood("😮", nil, false)
		task.spawn(function()
			local arg = #list == 1 and { Token = token, Cell = list[1] } or { Token = token, Cells = list }
			local ok, reply = kit:Invoke("solo:move", arg)
			if generation ~= st.Generation or not kit.Alive then
				return
			end
			for _, index in ipairs(list) do
				local cell = cells[index]
				if cell and (st.State[index] or 0) ~= 1 then
					Kit.Tween(cell.Scale, 0.15, { Scale = 1 })
				end
			end
			if not ok then
				kit:Notify(type(reply) == "string" and reply or T("Something went wrong"), C.Red)
				return
			end
			applyReply(reply, origin)
		end)
	end

	function onPrimary(index: number)
		if st.Done or not st.Token then
			return
		end
		local state = st.State[index] or 0
		if st.FlagMode and state ~= 1 then
			toggleFlag(index)
			return
		end
		if state == 2 then
			kit:Sound("Error")
			return
		end
		if state == 0 then
			send({ index }, index)
			return
		end
		-- Accord : chiffre entouré d'autant de drapeaux -> ouvre les voisines
		local number = st.Numbers[index] or 0
		if number <= 0 then
			return
		end
		local flags, hidden = 0, {}
		for _, neighbor in ipairs(Logic.Neighbors(st.Cols, st.Rows, index)) do
			local s = st.State[neighbor] or 0
			if s == 2 then
				flags += 1
			elseif s == 0 then
				table.insert(hidden, neighbor)
			end
		end
		if flags == number and #hidden > 0 then
			send(hidden, index)
		elseif #hidden > 0 then
			for _, neighbor in ipairs(hidden) do
				local cell = cells[neighbor]
				if cell then
					cell.Scale.Scale = 0.85
					Kit.Tween(cell.Scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
				end
			end
		end
	end

	function toggleFlag(index: number)
		if st.Done or not st.Token then
			return
		end
		local state = st.State[index] or 0
		if state == 1 then
			return
		end
		if state == 2 then
			st.State[index] = 0
			st.Flags -= 1
		else
			st.State[index] = 2
			st.Flags += 1
		end
		paintCell(index)
		local cell = cells[index]
		if cell then
			cell.Scale.Scale = 1.25
			Kit.Tween(cell.Scale, 0.22, { Scale = 1 }, Enum.EasingStyle.Back)
		end
		kit:Sound("Click", state == 2 and 0.9 or 1.15)
		refreshHud()
	end

	kit:OnKey(function(key)
		if key == Enum.KeyCode.F then
			st.FlagMode = not st.FlagMode
			refreshFlagButton()
			kit:Sound("Click")
		end
	end)

	-- Boucle : vague de révélation + chrono
	local hudTimer = 0
	kit:OnFrame(function(dt)
		st.QueueTime += dt
		if #st.Queue > 0 then
			local keep = {}
			for _, item in ipairs(st.Queue) do
				if item.At <= st.QueueTime then
					local cell = cells[item.Index]
					if cell then
						paintCell(item.Index)
						cell.Scale.Scale = 0.55
						Kit.Tween(cell.Scale, 0.22, { Scale = 1 }, Enum.EasingStyle.Back)
					end
				else
					table.insert(keep, item)
				end
			end
			st.Queue = keep
		end
		if st.Started and not st.Done then
			st.Clock = os.clock() - st.Started
		end
		hudTimer += dt
		if hudTimer >= 0.2 then
			hudTimer = 0
			refreshHud()
		end
	end)

	-- Premier affichage : plateau décoratif + choix de la difficulté
	st.Cols, st.Rows = 8, 8
	layout()
	refreshHud()
	kit:Mood("😊", kit.Touch and T("Hold a cell to flag it") or T("Right-click a cell to flag it"), false)
	kit:ShowPicker()

	return {
		Destroy = function()
			st.Generation += 1
			kit:Destroy()
		end,
	}
end

return Module
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="107">
          <Properties>
            <string name="Name">Solo_Simon</string>
            <string name="Source"><![CDATA[--[[
	Solo_Simon (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Minigames > Solo_Simon

	🎵 Simon de l'arcade : regarde la séquence de pastilles kawaii qui
	s'allument, puis rejoue-la. Une couleur de plus à chaque manche.
	La séquence est tirée par le SERVEUR, qui vérifie chaque manche (et
	qu'elle n'a pas été rejouée plus vite qu'humainement possible).
	Touches 1 à 6 = pastilles.
]]

local Kit = require(script.Parent.Solo_Kit)
local C = Kit.Colors
local create = Kit.Create

local PAD_COLORS = {
	Color3.fromRGB(255, 96, 170),
	Color3.fromRGB(80, 214, 255),
	Color3.fromRGB(255, 212, 70),
	Color3.fromRGB(90, 232, 150),
	Color3.fromRGB(176, 130, 255),
	Color3.fromRGB(255, 150, 80),
}
local PAD_PITCH = { 0.8, 0.95, 1.1, 1.25, 1.42, 1.6 }
local KEYS = {
	[Enum.KeyCode.One] = 1,
	[Enum.KeyCode.Two] = 2,
	[Enum.KeyCode.Three] = 3,
	[Enum.KeyCode.Four] = 4,
	[Enum.KeyCode.Five] = 5,
	[Enum.KeyCode.Six] = 6,
	[Enum.KeyCode.KeypadOne] = 1,
	[Enum.KeyCode.KeypadTwo] = 2,
	[Enum.KeyCode.KeypadThree] = 3,
	[Enum.KeyCode.KeypadFour] = 4,
	[Enum.KeyCode.KeypadFive] = 5,
	[Enum.KeyCode.KeypadSix] = 6,
}

local Module = { Id = "Simon", Kind = "Solo" }

function Module.Build(container: Frame, api)
	local kit
	local startGame: (string) -> ()
	local function T(text: string, ...): string
		return Kit.Translate(api, text, ...)
	end

	local st = {
		Pads = 4,
		Step = 0.45,
		Sequence = {} :: { number },
		Inputs = {} :: { number },
		Phase = "Idle", -- Idle | Watch | Input | Wait | Over
		Token = nil,
		Round = 0,
		Generation = 0,
	}
	local pads = {}

	kit = Kit.new(container, api, {
		Id = "Simon",
		Primary = "Round",
		SmallA = "Next ⭐",
		SmallB = "Speed",
		Details = function(_, rules)
			return T("%d pads · a note every %ss", rules.Pads, string.format("%.2f", rules.Step))
				.. "\n" .. T("⭐ %d rounds · ⭐⭐ %d · ⭐⭐⭐ %d", rules.Thresholds[1], rules.Thresholds[2], rules.Thresholds[3])
		end,
		BestText = function(value)
			return T("%s rounds", tostring(value))
		end,
		ScoreText = function(result)
			return "🎵 " .. T("%s rounds", tostring(result.Score or 0))
		end,
		NoStarHint = function(rules)
			return T("Reach round %d for your first ⭐!", rules.Thresholds[1])
		end,
		LoseTitle = "Oops!",
		OnPlay = function(difficulty)
			startGame(difficulty)
		end,
		OnPicker = function()
			st.Generation += 1
			st.Phase = "Idle"
		end,
		QuitArg = function()
			return {}
		end,
	})
	kit.PickerHelp.Text = kit.Touch and T("Watch the pads light up, then tap them in the same order")
		or T("Watch the pads light up, then click them in the same order (keys 1-6)")

	----------------------------------------------------------------------
	-- Plateau : bandeau d'état + pastilles
	----------------------------------------------------------------------
	local status = create("Frame", {
		Name = "Status",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.new(0.62, 0, 0, 38),
		BackgroundColor3 = C.CardDark,
		BackgroundTransparency = 0.1,
		ZIndex = 3,
		Parent = kit.Area,
	})
	Kit.Corner(status, UDim.new(1, 0))
	local statusStroke = Kit.Stroke(status, kit.Accent, 2, 0.2)
	local statusText = Kit.Label({
		Size = UDim2.new(1, -24, 1, -10),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		MaxTextSize = 20,
		ZIndex = 4,
		Parent = status,
	})
	local statusScale = create("UIScale", { Parent = status })
	local function setStatus(text: string, color: Color3)
		statusText.Text = text
		statusStroke.Color = color
		statusScale.Scale = 1.08
		Kit.Tween(statusScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	end

	local board = create("Frame", {
		Name = "Board",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.new(1, 0, 1, -48),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = kit.Area,
	})
	local grid = create("Frame", {
		Name = "Grid",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = board,
	})
	local aspect = create("UIAspectRatioConstraint", { AspectRatio = 1, Parent = grid })

	local onPad

	local function makePad(index: number)
		local color = PAD_COLORS[index]
		local button = create("TextButton", {
			Name = "Pad" .. index,
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			ZIndex = 4,
			Parent = grid,
		})
		-- Halo (visible quand la pastille s'allume)
		local glow = create("Frame", {
			Name = "Glow",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(1.02, 1.02),
			BackgroundColor3 = color,
			BackgroundTransparency = 1,
			ZIndex = 4,
			Parent = button,
		})
		Kit.Corner(glow, UDim.new(0.3, 0))
		local body = create("Frame", {
			Name = "Body",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.86, 0.86),
			BackgroundColor3 = color,
			ZIndex = 5,
			Parent = button,
		})
		Kit.Corner(body, UDim.new(0.28, 0))
		local bodyStroke = Kit.Stroke(body, color:Lerp(C.White, 0.55), 3, 0.3)
		local bodyGradient = create("UIGradient", {
			Color = ColorSequence.new(color:Lerp(C.White, 0.3), color:Lerp(C.Black, 0.25)),
			Rotation = 90,
			Parent = body,
		})
		-- Reflet
		local shine = create("Frame", {
			Position = UDim2.fromScale(0.14, 0.1),
			Size = UDim2.fromScale(0.36, 0.14),
			BackgroundColor3 = C.White,
			BackgroundTransparency = 0.55,
			ZIndex = 6,
			Parent = body,
		})
		Kit.Corner(shine, UDim.new(1, 0))
		-- Visage kawaii : yeux, joues, bouche
		local face = create("Frame", {
			Name = "Face",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.58),
			Size = UDim2.fromScale(0.56, 0.3),
			BackgroundTransparency = 1,
			ZIndex = 6,
			Parent = body,
		})
		local eyes = {}
		for side = 0, 1 do
			local eye = create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(side == 0 and 0.2 or 0.8, 0.3),
				Size = UDim2.fromScale(0.16, 0.5),
				BackgroundColor3 = Color3.fromRGB(40, 24, 60),
				ZIndex = 7,
				Parent = face,
			})
			Kit.Corner(eye, UDim.new(1, 0))
			local spark = create("Frame", {
				Position = UDim2.fromScale(0.22, 0.14),
				Size = UDim2.fromScale(0.42, 0.34),
				BackgroundColor3 = C.White,
				ZIndex = 8,
				Parent = eye,
			})
			Kit.Corner(spark, UDim.new(1, 0))
			local cheek = create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(side == 0 and 0.02 or 0.98, 0.78),
				Size = UDim2.fromScale(0.2, 0.26),
				BackgroundColor3 = Color3.fromRGB(255, 120, 150),
				BackgroundTransparency = 0.35,
				ZIndex = 7,
				Parent = face,
			})
			Kit.Corner(cheek, UDim.new(1, 0))
			eyes[side + 1] = eye
		end
		local mouth = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.78),
			Size = UDim2.fromScale(0.14, 0.2),
			BackgroundColor3 = Color3.fromRGB(40, 24, 60),
			ZIndex = 7,
			Parent = face,
		})
		Kit.Corner(mouth, UDim.new(1, 0))
		local keyHint = Kit.Label({
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.fromScale(0.94, 0.95),
			Size = UDim2.fromScale(0.2, 0.16),
			Text = tostring(index),
			TextColor3 = C.White,
			TextTransparency = 0.35,
			MaxTextSize = 18,
			Visible = not kit.Touch,
			ZIndex = 7,
			Parent = body,
		})
		local scale = create("UIScale", { Parent = body })
		local pad = {
			Button = button,
			Body = body,
			Glow = glow,
			Stroke = bodyStroke,
			Gradient = bodyGradient,
			Eyes = eyes,
			Mouth = mouth,
			Scale = scale,
			Color = color,
			Index = index,
			Light = 0, -- secondes d'allumage restantes
			Key = keyHint,
		}
		button.Activated:Connect(function()
			onPad(pad.Index)
		end)
		return pad
	end

	for index = 1, 6 do
		pads[index] = makePad(index)
	end

	local function layout()
		local cols = st.Pads == 6 and 3 or 2
		local rows = 2
		aspect.AspectRatio = cols / rows
		for index, pad in ipairs(pads) do
			if index <= st.Pads then
				local x = (index - 1) % cols
				local y = (index - 1) // cols
				pad.Button.Position = UDim2.fromScale(x / cols, y / rows)
				pad.Button.Size = UDim2.fromScale(1 / cols, 1 / rows)
				pad.Button.Visible = true
			else
				pad.Button.Visible = false
			end
		end
	end

	local function light(index: number, duration: number)
		local pad = pads[index]
		if not pad then
			return
		end
		pad.Light = duration
		pad.Scale.Scale = 1.1
		Kit.Tween(pad.Scale, math.min(duration, 0.3), { Scale = 1 }, Enum.EasingStyle.Back)
		kit:Sound("Pop", PAD_PITCH[index])
	end

	local function speedText(step: number): string
		local icon = step >= 0.55 and "🐢" or (step >= 0.42 and "🐇" or "⚡")
		return icon .. " " .. string.format("%.2fs", step)
	end

	kit:UseRating(0)
	local function refreshHud()
		local rules = kit.GameRules.Difficulties[kit.Difficulty]
		kit:SetRatingFromScore(st.Round, rules.Thresholds)
		kit:SetStat("Primary", tostring(math.max(1, #st.Sequence)))
		kit:SetStat("A", kit:NextStarText(st.Round, rules.Thresholds))
		kit:SetStat("B", speedText(st.Step))
	end

	----------------------------------------------------------------------
	-- Déroulement
	----------------------------------------------------------------------
	local function playSequence(generation: number)
		st.Phase = "Watch"
		st.Inputs = {}
		setStatus("👀 " .. T("Watch closely!"), C.Cyan)
		kit:Mood("🤓", T("Remember the order..."), false)
		refreshHud()
		task.wait(0.7)
		for _, index in ipairs(st.Sequence) do
			if generation ~= st.Generation or not kit.Alive then
				return
			end
			light(index, st.Step * 0.62)
			task.wait(st.Step)
		end
		if generation ~= st.Generation or not kit.Alive then
			return
		end
		st.Phase = "Input"
		setStatus("🎵 " .. T("Your turn! %d notes", #st.Sequence), kit.Accent)
		kit:Mood("😊", T("Your turn! Tap the pads in order."), false)
	end

	local function gameOver(result, expected: number?)
		st.Phase = "Over"
		setStatus("💫 " .. T("Oops! Wrong pad"), C.Red)
		kit:Mood("😵", T("So close! Try again?"))
		kit:Shake(grid, 7)
		kit:Sound("Error")
		-- montre la bonne pastille
		if expected then
			task.spawn(function()
				for _ = 1, 3 do
					task.wait(0.28)
					if not kit.Alive then
						return
					end
					local pad = pads[expected]
					if pad then
						pad.Light = 0.18
					end
				end
			end)
		end
		task.delay(1.4, function()
			if kit.Alive and st.Phase == "Over" then
				kit:ShowResult(result)
			end
		end)
	end

	local function submit(generation: number)
		st.Phase = "Wait"
		local token = st.Token
		local inputs = table.clone(st.Inputs)
		task.spawn(function()
			local ok, reply = kit:Invoke("solo:move", { Token = token, Inputs = inputs })
			if generation ~= st.Generation or not kit.Alive then
				return
			end
			if not ok or type(reply) ~= "table" then
				-- (trop rapide : on rejoue la même manche)
				kit:Notify(type(reply) == "string" and reply or T("Something went wrong"), C.Red)
				task.wait(0.6)
				if generation == st.Generation then
					playSequence(generation)
				end
				return
			end
			if reply.Wrong then
				gameOver(reply.Result, tonumber(reply.Expected))
				return
			end
			st.Round = tonumber(reply.Round) or st.Round + 1
			refreshHud()
			kit:SetStat("A", kit:NextStarText(st.Round, kit.GameRules.Difficulties[kit.Difficulty].Thresholds), true)
			if reply.Done then
				st.Phase = "Over"
				setStatus("🏆 " .. T("Maximum reached!"), C.Yellow)
				kit:Mood("🥳", T("Incredible memory!"))
				task.delay(1, function()
					if kit.Alive then
						kit:ShowResult(reply.Result)
					end
				end)
				return
			end
			setStatus("✨ " .. T("Great!"), C.Mint)
			kit:Burst(grid, C.Mint, 10)
			kit:Sound("Bonus", 1 + math.min(st.Round, 10) * 0.03)
			if type(reply.Sequence) == "table" then
				st.Sequence = reply.Sequence
			end
			kit:SetStat("Primary", tostring(#st.Sequence), true)
			task.wait(0.6)
			if generation == st.Generation then
				playSequence(generation)
			end
		end)
	end

	function onPad(index: number)
		if index > st.Pads then
			return
		end
		if st.Phase ~= "Input" then
			if st.Phase ~= "Over" and st.Phase ~= "Idle" then
				local pad = pads[index]
				pad.Scale.Scale = 0.94
				Kit.Tween(pad.Scale, 0.2, { Scale = 1 })
			end
			return
		end
		light(index, 0.22)
		table.insert(st.Inputs, index)
		local position = #st.Inputs
		if st.Sequence[position] ~= index then
			submit(st.Generation) -- le serveur confirme l'erreur
			return
		end
		kit:Float(pads[index].Body, "🎵", pads[index].Color)
		if position >= #st.Sequence then
			submit(st.Generation)
		end
	end

	function startGame(difficulty: string)
		local rules = kit.GameRules.Difficulties[difficulty]
		st.Generation += 1
		local generation = st.Generation
		st.Pads = rules.Pads
		st.Step = rules.Step
		st.Sequence = {}
		st.Inputs = {}
		st.Round = 0
		st.Phase = "Idle"
		st.Token = nil
		layout()
		refreshHud()
		setStatus("⏳ " .. T("Get ready..."), C.TextDim)
		kit:Mood("😊", T("Watch, then repeat!"))
		kit:Sound("Open")
		task.spawn(function()
			local reply = kit:StartSession()
			if generation ~= st.Generation then
				return
			end
			if not reply or type(reply.Sequence) ~= "table" then
				kit:ShowPicker()
				return
			end
			st.Token = reply.Token
			st.Sequence = reply.Sequence
			st.Step = tonumber(reply.Step) or st.Step
			playSequence(generation)
		end)
	end

	kit:OnKey(function(key)
		local index = KEYS[key]
		if index then
			onPad(index)
		end
	end)

	-- Boucle : allumage des pastilles
	kit:OnFrame(function(dt)
		for index, pad in ipairs(pads) do
			if index <= st.Pads then
				local lit = pad.Light > 0
				if lit then
					pad.Light -= dt
				end
				local on = pad.Light > 0
				if on ~= pad.On then
					pad.On = on
					pad.Glow.BackgroundTransparency = on and 0.45 or 1
					pad.Glow.Size = on and UDim2.fromScale(1.02, 1.02) or UDim2.fromScale(0.9, 0.9)
					pad.Gradient.Color = on and ColorSequence.new(C.White, pad.Color:Lerp(C.White, 0.3))
						or ColorSequence.new(pad.Color:Lerp(C.White, 0.3), pad.Color:Lerp(C.Black, 0.25))
					pad.Stroke.Color = on and C.White or pad.Color:Lerp(C.White, 0.55)
					pad.Stroke.Transparency = on and 0 or 0.3
					-- yeux fermés (^^) quand elle chante
					for _, eye in ipairs(pad.Eyes) do
						eye.Size = on and UDim2.fromScale(0.2, 0.18) or UDim2.fromScale(0.16, 0.5)
					end
					pad.Mouth.Size = on and UDim2.fromScale(0.2, 0.42) or UDim2.fromScale(0.14, 0.2)
				end
			end
		end
	end)

	st.Pads = 4
	layout()
	refreshHud()
	setStatus("🎵 " .. T("Simon says..."), kit.Accent)
	kit:Mood("😊", T("Watch, then repeat!"), false)
	kit:ShowPicker()

	return {
		Destroy = function()
			st.Generation += 1
			kit:Destroy()
		end,
	}
end

return Module
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="108">
          <Properties>
            <string name="Name">Solo_Snake</string>
            <string name="Source"><![CDATA[--[[
	Solo_Snake (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Minigames > Solo_Snake

	🐍 Snake de l'arcade : un serpent kawaii mange des fruits et grandit.
	Flèches / ZQSD / WASD, glissé du doigt sur le plateau, ou croix
	directionnelle (écrans tactiles).
	La simulation est celle de Solo_Logic (graine donnée par le SERVEUR) :
	à la fin, le client envoie ses virages { pas, direction } et le serveur
	rejoue la partie pour calculer le vrai score.
	Mouvement fluide : les anneaux glissent entre deux cases (interpolation).
]]

local Kit = require(script.Parent.Solo_Kit)
local UIUtil = require(script.Parent.Parent.UIUtil)
local Logic = Kit.Logic
local C = Kit.Colors
local create = Kit.Create

local FRUITS = { "🍓", "🍒", "🍑", "🍉", "🍇", "🍎", "🍍", "🥝" }
local HEAD_COLOR = Color3.fromRGB(110, 240, 170)
local TAIL_COLOR = Color3.fromRGB(70, 190, 255)
local DPAD_WIDTH = 150

local Module = { Id = "Snake", Kind = "Solo" }

function Module.Build(container: Frame, api)
	local kit
	local startGame: (string) -> ()
	local function T(text: string, ...): string
		return Kit.Translate(api, text, ...)
	end

	local st = {
		Sim = nil :: any,
		Rules = nil :: any,
		Running = false,
		Acc = 0,
		Interval = 0.12,
		Queue = {} :: { number },
		Turns = {} :: { number },
		Prev = {} :: { number }, -- case précédente de chaque anneau (interpolation)
		Token = nil,
		Generation = 0,
		Clock = 0,
		Cols = 16,
		Rows = 11,
	}
	local segments = {}
	local tiles = {}

	kit = Kit.new(container, api, {
		Id = "Snake",
		Primary = "Snacks",
		SmallA = "Next ⭐",
		SmallB = "Time",
		Details = function(_, rules)
			local walls = rules.Wrap and T("No walls: go through the edges") or T("Walls hurt!")
			return string.format("%d × %d  ·  ", rules.Cols, rules.Rows) .. walls
				.. "\n" .. T("⭐ %d snacks · ⭐⭐ %d · ⭐⭐⭐ %d", rules.Thresholds[1], rules.Thresholds[2], rules.Thresholds[3])
		end,
		BestText = function(value)
			return T("%s snacks", tostring(value))
		end,
		ScoreText = function(result)
			return "🍓 " .. T("%s snacks", tostring(result.Score or 0)) .. "  ·  ⏱️ " .. Kit.FormatClock(st.Clock)
		end,
		NoStarHint = function(rules)
			return T("Eat %d snacks for your first ⭐!", rules.Thresholds[1])
		end,
		LoseTitle = "Ouch!",
		OnPlay = function(difficulty)
			startGame(difficulty)
		end,
		OnPicker = function()
			st.Generation += 1
			st.Running = false
		end,
		QuitArg = function()
			local sim = st.Sim
			return { Turns = st.Turns, Ticks = sim and sim.Tick or 0 }
		end,
	})
	kit.PickerHelp.Text = kit.Touch and T("Swipe on the board or use the arrows to steer")
		or T("Arrow keys / WASD to steer · Eat snacks, avoid your tail")

	----------------------------------------------------------------------
	-- Plateau
	----------------------------------------------------------------------
	local holder = create("Frame", {
		Name = "BoardHolder",
		Size = UDim2.new(1, kit.Touch and -DPAD_WIDTH or 0, 1, 0),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = kit.Area,
	})
	local board = create("Frame", {
		Name = "Board",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(34, 26, 78),
		ClipsDescendants = true,
		ZIndex = 3,
		Parent = holder,
	})
	Kit.Corner(board, 14)
	Kit.Stroke(board, kit.Accent, 2.5, 0.2)
	local aspect = create("UIAspectRatioConstraint", { AspectRatio = 16 / 11, Parent = board })
	local tileLayer = create("Frame", {
		Name = "Tiles",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = board,
	})
	local snakeLayer = create("Frame", {
		Name = "Snake",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = board,
	})
	local food = Kit.Label({
		Name = "Food",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = "🍓",
		MaxTextSize = 40,
		ZIndex = 6,
		Parent = board,
	})
	local foodScale = create("UIScale", { Parent = food })
	local foodTime = 0

	-- Cases en damier (seulement les cases claires : moitié moins de cadres)
	local function buildTiles()
		for _, tile in ipairs(tiles) do
			tile.Visible = false
		end
		local count = 0
		for y = 0, st.Rows - 1 do
			for x = 0, st.Cols - 1 do
				if (x + y) % 2 == 0 then
					count += 1
					local tile = tiles[count]
					if not tile then
						tile = create("Frame", {
							BackgroundColor3 = Color3.fromRGB(52, 40, 108),
							BorderSizePixel = 0,
							ZIndex = 3,
							Parent = tileLayer,
						})
						tiles[count] = tile
					end
					tile.Position = UDim2.fromScale(x / st.Cols, y / st.Rows)
					tile.Size = UDim2.fromScale(1 / st.Cols, 1 / st.Rows)
					tile.Visible = true
				end
			end
		end
	end

	-- Anneaux du serpent (réutilisés)
	local function getSegment(index: number)
		local segment = segments[index]
		if segment then
			return segment
		end
		local frame = create("Frame", {
			Name = "Seg" .. index,
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = HEAD_COLOR,
			BorderSizePixel = 0,
			ZIndex = 5,
			Parent = snakeLayer,
		})
		Kit.Corner(frame, UDim.new(0.42, 0))
		segment = { Frame = frame }
		if index == 1 then
			frame.ZIndex = 7
			Kit.Stroke(frame, C.White, 1.5, 0.4)
			segment.Eyes = {}
			for side = 1, 2 do
				local eye = create("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Size = UDim2.fromScale(0.34, 0.34),
					BackgroundColor3 = C.White,
					ZIndex = 8,
					Parent = frame,
				})
				Kit.Corner(eye, UDim.new(1, 0))
				local pupil = create("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromScale(0.55, 0.55),
					Size = UDim2.fromScale(0.55, 0.55),
					BackgroundColor3 = Color3.fromRGB(30, 20, 50),
					ZIndex = 9,
					Parent = eye,
				})
				Kit.Corner(pupil, UDim.new(1, 0))
				segment.Eyes[side] = { Eye = eye, Pupil = pupil }
			end
			segment.Blush = {}
			for side = 1, 2 do
				local blush = create("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Size = UDim2.fromScale(0.22, 0.14),
					BackgroundColor3 = Color3.fromRGB(255, 130, 170),
					BackgroundTransparency = 0.25,
					ZIndex = 8,
					Parent = frame,
				})
				Kit.Corner(blush, UDim.new(1, 0))
				segment.Blush[side] = blush
			end
		end
		segments[index] = segment
		return segment
	end

	local function cellXY(index: number): (number, number)
		return (index - 1) % st.Cols, (index - 1) // st.Cols
	end

	-- Couleurs + yeux (à chaque pas)
	local function styleSnake()
		local sim = st.Sim
		local length = #sim.Body
		for index = 1, math.max(length, #segments) do
			local segment = segments[index]
			if index <= length then
				segment = getSegment(index)
				local k = length > 1 and (index - 1) / (length - 1) or 0
				segment.Frame.BackgroundColor3 = HEAD_COLOR:Lerp(TAIL_COLOR, k)
				local size = index == 1 and 1.08 or (0.96 - 0.22 * k)
				segment.Frame.Size = UDim2.fromScale(size / st.Cols, size / st.Rows)
				segment.Frame.Visible = true
			elseif segment then
				segment.Frame.Visible = false
			end
		end
		-- yeux tournés vers la direction
		local head = getSegment(1)
		local d = Logic.Directions[sim.Dir]
		local fx, fy = d[1], d[2]
		local sx, sy = -fy, fx -- perpendiculaire
		for side = 1, 2 do
			local sign = side == 1 and -1 or 1
			local eye = head.Eyes[side]
			eye.Eye.Position = UDim2.fromScale(0.5 + fx * 0.14 + sx * 0.22 * sign, 0.5 + fy * 0.14 + sy * 0.22 * sign)
			eye.Pupil.Position = UDim2.fromScale(0.5 + fx * 0.18, 0.5 + fy * 0.18)
			local blush = head.Blush[side]
			blush.Position = UDim2.fromScale(0.5 - fx * 0.12 + sx * 0.34 * sign, 0.5 - fy * 0.12 + sy * 0.34 * sign)
		end
	end

	local function placeFood()
		local sim = st.Sim
		if not sim.Food then
			food.Visible = false
			return
		end
		local x, y = cellXY(sim.Food)
		food.Position = UDim2.fromScale((x + 0.5) / st.Cols, (y + 0.5) / st.Rows)
		food.Size = UDim2.fromScale(0.95 / st.Cols, 0.95 / st.Rows)
		food.Text = FRUITS[sim.Score % #FRUITS + 1]
		food.Visible = true
		foodScale.Scale = 0.2
		Kit.Tween(foodScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	end

	-- Position interpolée des anneaux
	local function drawSnake(alpha: number)
		local sim = st.Sim
		if not sim then
			return
		end
		for index, cell in ipairs(sim.Body) do
			local segment = segments[index]
			if segment then
				local x, y = cellXY(cell)
				local prev = st.Prev[index] or cell
				local px, py = cellXY(prev)
				if math.abs(px - x) > 1 or math.abs(py - y) > 1 then
					px, py = x, y -- traversée d'un bord : pas d'interpolation
				end
				local ix = px + (x - px) * alpha
				local iy = py + (y - py) * alpha
				segment.Frame.Position = UDim2.fromScale((ix + 0.5) / st.Cols, (iy + 0.5) / st.Rows)
			end
		end
	end

	----------------------------------------------------------------------
	-- Commandes
	----------------------------------------------------------------------
	local function steer(dir: number)
		if not st.Running then
			return
		end
		local last = st.Queue[#st.Queue] or (st.Sim and st.Sim.Dir)
		if dir == last or (last and (dir - last) % 4 == 2) then
			return
		end
		if #st.Queue < 2 then
			table.insert(st.Queue, dir)
		end
	end

	kit:OnKey(function(key)
		local dir = Kit.KeyDirections[key]
		if dir then
			steer(dir)
		end
	end)
	kit:OnSwipe(board, steer)

	-- Croix directionnelle (écrans tactiles)
	if kit.Touch then
		local pad = create("Frame", {
			Name = "DPad",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.fromScale(1, 0.5),
			Size = UDim2.fromOffset(DPAD_WIDTH - 12, DPAD_WIDTH - 12),
			BackgroundColor3 = C.CardDark,
			BackgroundTransparency = 0.3,
			ZIndex = 3,
			Parent = kit.Area,
		})
		Kit.Corner(pad, UDim.new(1, 0))
		Kit.Stroke(pad, kit.Accent, 1.5, 0.5)
		-- Flèches DESSINÉES (triangles) : les polices Roblox n'ont pas ▲ ▶ ▼ ◀
		local ARROW_KINDS = { "Up", "Right", "Down", "Left" }
		local arrows = { { 0.5, 0.17 }, { 0.83, 0.5 }, { 0.5, 0.83 }, { 0.17, 0.5 } }
		for dir, info in ipairs(arrows) do
			local button = Kit.Button({
				Name = "Dir" .. dir,
				Text = "",
				Color = kit.Accent,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(info[1], info[2]),
				Size = UDim2.fromScale(0.34, 0.34),
				Radius = 12,
				MaxTextSize = 22,
				ZIndex = 4,
				Parent = pad,
			})
			UIUtil.Icon(ARROW_KINDS[dir], { Name = "Arrow", Size = 18, Color = C.White, ZIndex = 5, Parent = button })
			button.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
					steer(dir)
				end
			end)
		end
	end

	----------------------------------------------------------------------
	-- Partie
	----------------------------------------------------------------------
	kit:UseRating(0)
	local function refreshHud()
		local sim = st.Sim
		local score = sim and sim.Score or 0
		kit:SetStat("Primary", "🍓 " .. tostring(score))
		if st.Rules then
			kit:SetStat("A", kit:NextStarText(score, st.Rules.Thresholds))
			kit:SetRatingFromScore(score, st.Rules.Thresholds)
		end
		kit:SetStat("B", Kit.FormatClock(st.Clock))
	end

	local function die(generation: number)
		st.Running = false
		kit:Sound("Thunder")
		kit:Shake(board, 8)
		kit:Mood("😵", T("Bonk! Watch your tail."))
		local head = segments[1]
		if head then
			head.Frame.BackgroundColor3 = C.Red
		end
		local sim = st.Sim
		local token = st.Token
		local turns = table.clone(st.Turns)
		task.spawn(function()
			local ok, result = kit:Invoke("solo:finish", { Token = token, Turns = turns, Ticks = sim.Tick })
			if generation ~= st.Generation or not kit.Alive then
				return
			end
			if not ok or type(result) ~= "table" then
				kit:Notify(type(result) == "string" and result or T("Something went wrong"), C.Red)
				kit:ShowPicker()
				return
			end
			task.wait(0.9)
			if generation == st.Generation then
				kit:ShowResult(result)
			end
		end)
	end

	local function tick(generation: number)
		local sim = st.Sim
		-- virage en attente
		local dir = table.remove(st.Queue, 1)
		if dir and Logic.SnakeTurn(sim, dir) then
			table.insert(st.Turns, sim.Tick + 1)
			table.insert(st.Turns, dir)
		end
		st.Prev = table.clone(sim.Body)
		-- l'anneau ajouté en mangeant part de la queue
		local event = Logic.SnakeStep(sim)
		st.Interval = Logic.SnakeInterval(st.Rules, sim.Score)
		if event == "dead" then
			if sim.Full then
				kit:Mood("🏆", T("The board is full. Legendary!"))
			end
			drawSnake(1)
			die(generation)
			return
		end
		if #st.Prev < #sim.Body then
			table.insert(st.Prev, st.Prev[#st.Prev])
		end
		styleSnake()
		if event == "eat" then
			kit:Burst(food, C.Pink, 8)
			kit:Float(food, "+1", C.Yellow)
			kit:Sound("Pop", 1 + math.min(sim.Score, 20) * 0.02)
			placeFood()
			kit:SetStat("Primary", "🍓 " .. tostring(sim.Score), true)
			refreshHud()
			local rules = st.Rules
			for index, threshold in ipairs(rules.Thresholds) do
				if sim.Score == threshold then
					kit:Mood("🤩", T("%d ⭐ unlocked!", index))
					kit:Sound("Bonus")
				end
			end
		end
	end

	function startGame(difficulty: string)
		local rules = kit.GameRules.Difficulties[difficulty]
		st.Generation += 1
		local generation = st.Generation
		st.Rules = rules
		st.Cols, st.Rows = rules.Cols, rules.Rows
		st.Running = false
		st.Queue = {}
		st.Turns = {}
		st.Clock = 0
		st.Acc = 0
		st.Token = nil
		aspect.AspectRatio = st.Cols / st.Rows
		buildTiles()
		-- aperçu (graine locale) en attendant la vraie graine du serveur
		st.Sim = Logic.SnakeNew(1, rules)
		st.Prev = table.clone(st.Sim.Body)
		st.Interval = Logic.SnakeInterval(rules, 0)
		styleSnake()
		drawSnake(1)
		food.Visible = false
		refreshHud()
		kit:Mood("😊", rules.Wrap and T("No walls here: slide through the edges!") or T("Eat snacks, avoid walls and your tail."))
		task.spawn(function()
			local reply = kit:StartSession()
			if generation ~= st.Generation then
				return
			end
			if not reply or type(reply.Seed) ~= "number" then
				kit:ShowPicker()
				return
			end
			st.Token = reply.Token
			st.Sim = Logic.SnakeNew(reply.Seed, rules)
			st.Prev = table.clone(st.Sim.Body)
			styleSnake()
			drawSnake(1)
			placeFood()
		end)
		kit:Countdown(function()
			local waited = 0
			while not st.Token and waited < 5 and generation == st.Generation do
				waited += task.wait(0.1)
			end
			if not st.Token or generation ~= st.Generation then
				return
			end
			st.Running = true
			st.Acc = 0
		end)
	end

	-- Boucle : pas de simulation + interpolation + fruit qui danse
	local hudTimer = 0
	kit:OnFrame(function(dt)
		foodTime += dt
		if food.Visible then
			food.Rotation = math.sin(foodTime * 4) * 10
		end
		if not st.Running then
			return
		end
		st.Clock += dt
		st.Acc += dt
		local generation = st.Generation
		local steps = 0
		while st.Running and st.Acc >= st.Interval and steps < 4 do
			st.Acc -= st.Interval
			steps += 1
			tick(generation)
		end
		if st.Running then
			drawSnake(math.clamp(st.Acc / st.Interval, 0, 1))
		end
		hudTimer += dt
		if hudTimer >= 0.25 then
			hudTimer = 0
			kit:SetStat("B", Kit.FormatClock(st.Clock))
		end
	end)

	-- Premier affichage
	local preview = Logic.Games.Snake.Difficulties.Normal
	st.Rules = preview
	st.Cols, st.Rows = preview.Cols, preview.Rows
	aspect.AspectRatio = st.Cols / st.Rows
	buildTiles()
	st.Sim = Logic.SnakeNew(3, preview)
	st.Prev = table.clone(st.Sim.Body)
	styleSnake()
	drawSnake(1)
	placeFood()
	refreshHud()
	kit:Mood("😊", T("Eat snacks, avoid walls and your tail."), false)
	kit:ShowPicker()

	return {
		Destroy = function()
			st.Generation += 1
			st.Running = false
			kit:Destroy()
		end,
	}
end

return Module
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="109">
          <Properties>
            <string name="Name">Solo_WhackAMole</string>
            <string name="Source"><![CDATA[--[[
	Solo_WhackAMole (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Minigames > Solo_WhackAMole

	🔨 Tape-taupe de l'arcade : 30 secondes pour tapoter les taupes kawaii.
	Taupe = +1, taupe dorée 👑 = +3, bombe 💣 = -2.
	Les apparitions suivent un programme tiré d'une graine donnée par le
	SERVEUR (Solo_Logic.WhackSchedule) : à la fin, le client envoie la liste
	des taupes touchées et le serveur recalcule le score.
]]

local Kit = require(script.Parent.Solo_Kit)
local Logic = Kit.Logic
local C = Kit.Colors
local create = Kit.Create

local RISE = 0.12 -- durée de la sortie / rentrée d'une taupe
local MOLE_COLOR = Color3.fromRGB(196, 140, 104)
local GOLD_COLOR = Color3.fromRGB(255, 206, 70)
local BOMB_COLOR = Color3.fromRGB(58, 48, 78)

local Module = { Id = "WhackAMole", Kind = "Solo" }

function Module.Build(container: Frame, api)
	local kit
	local startGame: (string) -> ()
	local function T(text: string, ...): string
		return Kit.Translate(api, text, ...)
	end

	local gameRules = Logic.Games.WhackAMole
	local st = {
		Schedule = {} :: { any },
		MaxScore = 1,
		Thresholds = { 1, 2, 3 },
		Hits = {} :: { number },
		HitSet = {} :: { [number]: boolean },
		Score = 0,
		Running = false,
		Clock = 0,
		Cursor = 1,
		Token = nil,
		Generation = 0,
		Duration = gameRules.Duration,
	}
	local holes = {}

	kit = Kit.new(container, api, {
		Id = "WhackAMole",
		Primary = "Score",
		SmallA = "Next ⭐",
		SmallB = "Time left",
		Details = function(difficulty, rules)
			local speed = difficulty == "Easy" and T("Chill moles") or (difficulty == "Normal" and T("Quick moles") or T("Turbo moles"))
			return speed .. "  ·  " .. T("%ds", gameRules.Duration)
				.. "\n🐹 +1   👑 +3   💣 -2"
				.. "\n" .. T("⭐⭐⭐ = %d%% of the moles", math.floor(rules.Fractions[3] * 100))
		end,
		BestText = function(value)
			return T("%s pts", tostring(value))
		end,
		ScoreText = function(result)
			return "🔨 " .. T("%s pts", tostring(result.Score or 0))
		end,
		NoStarHint = function()
			return T("Golden moles are worth 3 points!")
		end,
		LoseTitle = "Time's up!",
		OnPlay = function(difficulty)
			startGame(difficulty)
		end,
		OnPicker = function()
			st.Generation += 1
			st.Running = false
		end,
		QuitArg = function()
			return { Hits = st.Hits }
		end,
	})
	kit.PickerHelp.Text = T("Bonk the moles before they hide · Golden = +3 · Avoid the bombs!")

	----------------------------------------------------------------------
	-- Pré carré : 3 x 3 terriers
	----------------------------------------------------------------------
	local field = create("Frame", {
		Name = "Field",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(96, 200, 130),
		ZIndex = 3,
		Parent = kit.Area,
	})
	Kit.Corner(field, 22)
	Kit.Gradient(field, Color3.fromRGB(130, 226, 150), Color3.fromRGB(60, 160, 110), 90)
	Kit.Stroke(field, Color3.fromRGB(200, 255, 210), 3, 0.3)
	create("UIAspectRatioConstraint", { AspectRatio = 1.3, Parent = field })
	-- pelouse tondue (bandes) + quelques fleurs sur les bords (décor fixe)
	for index = 0, 5 do
		create("Frame", {
			Position = UDim2.fromScale(0, index / 6),
			Size = UDim2.fromScale(1, 1 / 12),
			BackgroundColor3 = C.White,
			BackgroundTransparency = 0.9,
			BorderSizePixel = 0,
			ZIndex = 3,
			Parent = field,
		})
	end
	for index, spot in ipairs({ { 0.035, 0.3 }, { 0.965, 0.42 }, { 0.03, 0.72 }, { 0.97, 0.86 }, { 0.06, 0.06 }, { 0.94, 0.06 } }) do
		Kit.Label({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(spot[1], spot[2]),
			Size = UDim2.fromScale(0.045, 0.06),
			Text = ({ "🌼", "🌸", "🍀", "🌷" })[index % 4 + 1],
			MaxTextSize = 18,
			ZIndex = 3,
			Parent = field,
		})
	end
	local timeBar = create("Frame", {
		Name = "TimeBar",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.new(0.8, 0, 0, 10),
		BackgroundColor3 = Color3.fromRGB(30, 70, 50),
		BackgroundTransparency = 0.3,
		ZIndex = 4,
		Parent = field,
	})
	Kit.Corner(timeBar, UDim.new(1, 0))
	local timeFill = create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Yellow,
		ZIndex = 5,
		Parent = timeBar,
	})
	Kit.Corner(timeFill, UDim.new(1, 0))
	Kit.Gradient(timeFill, C.Yellow, C.Orange, 0)

	local grid = create("Frame", {
		Name = "Grid",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -8),
		Size = UDim2.new(1, -24, 1, -34),
		BackgroundTransparency = 1,
		ZIndex = 4,
		Parent = field,
	})

	local onHole

	-- Dessine une taupe kawaii (ou une bombe) dans `parent`
	local function makeMole(parent: Frame)
		local mole = create("Frame", {
			Name = "Mole",
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.5, 1),
			Size = UDim2.fromScale(0.8, 0.95),
			BackgroundColor3 = MOLE_COLOR,
			ZIndex = 6,
			Parent = parent,
		})
		Kit.Corner(mole, UDim.new(0.48, 0))
		local gradientObj = create("UIGradient", {
			Color = ColorSequence.new(MOLE_COLOR:Lerp(C.White, 0.25), MOLE_COLOR:Lerp(C.Black, 0.15)),
			Rotation = 90,
			Parent = mole,
		})
		local belly = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.5, 0.52),
			Size = UDim2.fromScale(0.62, 0.6),
			BackgroundColor3 = Color3.fromRGB(250, 222, 196),
			ZIndex = 7,
			Parent = mole,
		})
		Kit.Corner(belly, UDim.new(0.5, 0))
		local eyes = {}
		local cheeks = {}
		for side = 0, 1 do
			local eye = create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(side == 0 and 0.32 or 0.68, 0.3),
				Size = UDim2.fromScale(0.13, 0.12),
				BackgroundColor3 = Color3.fromRGB(40, 24, 40),
				ZIndex = 8,
				Parent = mole,
			})
			Kit.Corner(eye, UDim.new(1, 0))
			local spark = create("Frame", {
				Position = UDim2.fromScale(0.2, 0.12),
				Size = UDim2.fromScale(0.45, 0.42),
				BackgroundColor3 = C.White,
				ZIndex = 9,
				Parent = eye,
			})
			Kit.Corner(spark, UDim.new(1, 0))
			local cheek = create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(side == 0 and 0.2 or 0.8, 0.44),
				Size = UDim2.fromScale(0.16, 0.08),
				BackgroundColor3 = Color3.fromRGB(255, 130, 160),
				BackgroundTransparency = 0.3,
				ZIndex = 8,
				Parent = mole,
			})
			Kit.Corner(cheek, UDim.new(1, 0))
			eyes[side + 1] = eye
			cheeks[side + 1] = cheek
		end
		local nose = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.42),
			Size = UDim2.fromScale(0.16, 0.1),
			BackgroundColor3 = Color3.fromRGB(255, 120, 150),
			ZIndex = 9,
			Parent = mole,
		})
		Kit.Corner(nose, UDim.new(1, 0))
		local icon = Kit.Label({
			Name = "Icon",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.36),
			Size = UDim2.fromScale(0.9, 0.62),
			Text = "",
			MaxTextSize = 60,
			ZIndex = 10,
			Parent = mole,
		})
		local crown = Kit.Label({
			Name = "Crown",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.08),
			Size = UDim2.fromScale(0.5, 0.24),
			Text = "👑",
			Visible = false,
			MaxTextSize = 30,
			ZIndex = 10,
			Parent = mole,
		})
		local scale = create("UIScale", { Parent = mole })
		local outline = Kit.Stroke(mole, C.Red, 2.5, 0)
		outline.Enabled = false
		return {
			Frame = mole,
			Cheeks = cheeks,
			Outline = outline,
			Gradient = gradientObj,
			Belly = belly,
			Eyes = eyes,
			Nose = nose,
			Icon = icon,
			Crown = crown,
			Scale = scale,
		}
	end

	local function styleMole(mole, kind: number)
		local bomb = kind == 3
		local color = kind == 2 and GOLD_COLOR or (bomb and BOMB_COLOR or MOLE_COLOR)
		mole.Frame.BackgroundColor3 = color
		mole.Gradient.Color = ColorSequence.new(color:Lerp(C.White, 0.25), color:Lerp(C.Black, 0.15))
		mole.Belly.Visible = not bomb
		mole.Nose.Visible = not bomb
		for _, eye in ipairs(mole.Eyes) do
			eye.Visible = not bomb
			eye.Size = UDim2.fromScale(0.13, 0.12)
		end
		mole.Frame.Visible = true
		mole.Icon.Text = bomb and "💣" or ""
		mole.Crown.Visible = kind == 2
		for _, cheek in ipairs(mole.Cheeks) do
			cheek.Visible = not bomb
		end
		-- contour : rouge = danger, doré = bonus
		mole.Outline.Enabled = kind ~= 1
		mole.Outline.Color = bomb and C.Red or C.White
	end

	for index = 1, gameRules.Holes do
		local x = (index - 1) % 3
		local y = (index - 1) // 3
		local cell = create("TextButton", {
			Name = "Hole" .. index,
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			Position = UDim2.fromScale(x / 3, y / 3),
			Size = UDim2.fromScale(1 / 3, 1 / 3),
			ZIndex = 5,
			Parent = grid,
		})
		-- Terrier : monticule + trou sombre
		local mound = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromScale(0.5, 0.97),
			Size = UDim2.fromScale(0.7, 0.4),
			BackgroundColor3 = Color3.fromRGB(150, 100, 70),
			ZIndex = 5,
			Parent = cell,
		})
		Kit.Corner(mound, UDim.new(0.5, 0))
		Kit.Gradient(mound, Color3.fromRGB(176, 124, 88), Color3.fromRGB(120, 78, 54), 90)
		local hole = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.4),
			Size = UDim2.fromScale(0.8, 0.56),
			BackgroundColor3 = Color3.fromRGB(46, 26, 22),
			ZIndex = 6,
			Parent = mound,
		})
		Kit.Corner(hole, UDim.new(0.5, 0))
		Kit.Gradient(hole, Color3.fromRGB(20, 10, 10), Color3.fromRGB(70, 40, 32), 90)
		-- Zone de sortie de la taupe (coupée au niveau du trou)
		local clip = create("Frame", {
			Name = "Clip",
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromScale(0.5, 0.73),
			Size = UDim2.fromScale(0.6, 0.72),
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			ZIndex = 6,
			Parent = cell,
		})
		local mole = makeMole(clip)
		local hammer = Kit.Label({
			Name = "Hammer",
			AnchorPoint = Vector2.new(0.2, 0.8),
			Position = UDim2.fromScale(0.72, 0.35),
			Size = UDim2.fromScale(0.42, 0.42),
			Text = "🔨",
			Visible = false,
			MaxTextSize = 44,
			ZIndex = 12,
			Parent = cell,
		})
		local entry = {
			Cell = cell,
			Mole = mole,
			Hammer = hammer,
			Index = index,
			Current = nil :: number?, -- index de la taupe dans le programme
			HammerTime = 0,
			Squash = 0,
		}
		holes[index] = entry
		cell.Activated:Connect(function()
			onHole(entry.Index)
		end)
	end

	----------------------------------------------------------------------
	-- Partie
	----------------------------------------------------------------------
	kit:UseRating(0)
	local function refreshHud()
		kit:SetRatingFromScore(st.Score, st.Thresholds)
		kit:SetStat("Primary", tostring(st.Score))
		kit:SetStat("A", kit:NextStarText(st.Score, st.Thresholds))
		kit:SetStat("B", tostring(math.max(0, math.ceil(st.Duration - st.Clock))) .. "s")
		timeFill.Size = UDim2.fromScale(math.clamp(1 - st.Clock / st.Duration, 0, 1), 1)
	end

	local function finish(generation: number)
		st.Running = false
		kit:Mood("⏰", T("Time's up!"))
		kit:Sound("Bonus")
		local token = st.Token
		local hits = table.clone(st.Hits)
		task.spawn(function()
			local ok, result = kit:Invoke("solo:finish", { Token = token, Hits = hits })
			if generation ~= st.Generation or not kit.Alive then
				return
			end
			if not ok or type(result) ~= "table" then
				kit:Notify(type(result) == "string" and result or T("Something went wrong"), C.Red)
				kit:ShowPicker()
				return
			end
			task.wait(0.4)
			kit:ShowResult(result)
		end)
	end

	function onHole(index: number)
		local entry = holes[index]
		if not st.Running or not entry then
			return
		end
		entry.HammerTime = 0.22
		entry.Hammer.Visible = true
		local moleIndex = entry.Current
		if not moleIndex or st.HitSet[moleIndex] then
			kit:Sound("Click", 0.8)
			return
		end
		local mole = st.Schedule[moleIndex]
		st.HitSet[moleIndex] = true
		table.insert(st.Hits, moleIndex)
		local value = Logic.WhackValues[mole.Kind] or 0
		st.Score = math.max(0, st.Score + value)
		entry.Squash = 0.25
		if mole.Kind == 3 then
			kit:Float(entry.Cell, "-2", C.Red)
			kit:Sound("Thunder")
			kit:Shake(field, 8)
			kit:Mood("😖", T("Ouch, a bomb! Avoid them."))
		elseif mole.Kind == 2 then
			kit:Float(entry.Cell, "+3", C.Yellow)
			kit:Burst(entry.Cell, C.Yellow, 12)
			kit:Sound("Cash")
			kit:Mood("🤑", T("Golden mole! +3"))
		else
			kit:Float(entry.Cell, "+1", C.White)
			kit:Burst(entry.Cell, MOLE_COLOR, 6)
			kit:Sound("Pop", 0.9 + math.random() * 0.3)
		end
		kit:SetStat("Primary", tostring(st.Score), true)
		refreshHud()
	end

	function startGame(difficulty: string)
		local rules = kit.GameRules.Difficulties[difficulty]
		st.Generation += 1
		local generation = st.Generation
		st.Running = false
		st.Schedule = {}
		st.Hits = {}
		st.HitSet = {}
		st.Score = 0
		st.Clock = 0
		st.Cursor = 1
		st.Token = nil
		for _, entry in ipairs(holes) do
			entry.Current = nil
			entry.Mole.Frame.Position = UDim2.fromScale(0.5, 1)
			entry.Mole.Frame.Visible = false
			entry.Mole.Crown.Visible = false
		end
		refreshHud()
		kit:Mood("😊", T("Bonk the moles! Golden = +3, avoid bombs."))
		task.spawn(function()
			local reply = kit:StartSession()
			if generation ~= st.Generation then
				return
			end
			if not reply or type(reply.Seed) ~= "number" then
				kit:ShowPicker()
				return
			end
			st.Token = reply.Token
			st.Duration = tonumber(reply.Duration) or gameRules.Duration
			st.Schedule, st.MaxScore = Logic.WhackSchedule(reply.Seed, rules, gameRules.Holes, st.Duration)
			st.Thresholds = {}
			for index, fraction in ipairs(rules.Fractions) do
				st.Thresholds[index] = math.max(1, math.floor(st.MaxScore * fraction + 0.5))
			end
			refreshHud()
		end)
		kit:Countdown(function()
			if generation ~= st.Generation then
				return
			end
			-- (si le serveur n'a pas encore répondu, on attend un peu)
			local waited = 0
			while not st.Token and waited < 5 and generation == st.Generation do
				waited += task.wait(0.1)
			end
			if not st.Token or generation ~= st.Generation then
				return
			end
			st.Running = true
			kit:Mood("😆", T("Go go go!"), false)
		end)
	end

	-- Boucle : programme des taupes, animations, chrono
	local hudTimer = 0
	kit:OnFrame(function(dt)
		for _, entry in ipairs(holes) do
			if entry.HammerTime > 0 then
				entry.HammerTime -= dt
				entry.Hammer.Rotation = -50 + 70 * math.clamp(1 - entry.HammerTime / 0.22, 0, 1)
				if entry.HammerTime <= 0 then
					entry.Hammer.Visible = false
				end
			end
		end
		if not st.Running then
			return
		end
		st.Clock += dt
		local t = st.Clock
		-- nouvelles taupes
		local schedule = st.Schedule
		while st.Cursor <= #schedule and schedule[st.Cursor].T <= t do
			local mole = schedule[st.Cursor]
			local entry = holes[mole.Hole]
			if entry then
				entry.Current = st.Cursor
				styleMole(entry.Mole, mole.Kind)
				entry.Squash = 0
			end
			st.Cursor += 1
		end
		-- position des taupes visibles
		for _, entry in ipairs(holes) do
			local moleIndex = entry.Current
			if moleIndex then
				local mole = schedule[moleIndex]
				local age = t - mole.T
				local hit = st.HitSet[moleIndex]
				local frame = entry.Mole.Frame
				if age >= mole.Up or (hit and entry.Squash <= 0) then
					entry.Current = nil
					frame.Position = UDim2.fromScale(0.5, 1)
					frame.Visible = false
					entry.Mole.Crown.Visible = false
				else
					local up
					if hit then
						entry.Squash -= dt
						up = math.clamp(entry.Squash / 0.25, 0, 1)
						for _, eye in ipairs(entry.Mole.Eyes) do
							eye.Size = UDim2.fromScale(0.16, 0.04)
						end
					else
						up = math.min(age / RISE, (mole.Up - age) / RISE, 1)
					end
					up = math.clamp(up, 0, 1)
					frame.Position = UDim2.fromScale(0.5, 1 - 0.9 * up)
				end
			end
		end
		hudTimer += dt
		if hudTimer >= 0.1 then
			hudTimer = 0
			refreshHud()
			if st.Duration - t <= 5 and st.Duration - t > 4.9 then
				kit:Mood("⏰", T("Hurry up!"), true)
			end
		end
		if t >= st.Duration then
			for _, entry in ipairs(holes) do
				entry.Current = nil
				entry.Mole.Frame.Position = UDim2.fromScale(0.5, 1)
				entry.Mole.Frame.Visible = false
				entry.Mole.Crown.Visible = false
			end
			finish(st.Generation)
		end
	end)

	-- Premier affichage : quelques taupes qui saluent derrière le sélecteur
	for index, kind in pairs({ [2] = 1, [4] = 2, [9] = 3 }) do
		styleMole(holes[index].Mole, kind)
		holes[index].Mole.Frame.Position = UDim2.fromScale(0.5, 0.12)
	end
	refreshHud()
	kit:Mood("😊", T("Bonk the moles! Golden = +3, avoid bombs."), false)
	kit:ShowPicker()

	return {
		Destroy = function()
			st.Generation += 1
			kit:Destroy()
		end,
	}
end

return Module
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="110">
        <Properties>
          <string name="Name">Slots</string>
          <string name="Source"><![CDATA[--[[
	Slots (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Slots

	Emplacements nommés de l'écran (toile de 1280x720 pixels "design") où
	les stimuli (Client > Stimuli) viennent se placer.

	Ancrage horizontal :
	  "L" = décalage depuis le bord gauche, "R" = depuis le bord droit,
	  "C" = centré (X = décalage du CENTRE du slot par rapport au centre),
	  "T" = toute la largeur.
	Verticalement, les slots de la moitié haute sont accrochés en haut et
	ceux de la moitié basse en bas : sur un écran plus haut que 16:9
	(tablette), l'espace libre se retrouve au milieu.

	Spéciaux : "Overlay" (plein écran, calque Overlay) et "Background"
	(plein écran, calque Background, sous tout le reste).

	La colonne centrale (bouton, compteur, améliorations) occupe
	x ∈ [centre-300, centre+300], y ∈ [30, 425] : elle doit rester lisible.

	v5 (téléphones / tablettes) : la toile y est plus petite (tout est plus
	gros), donc chaque slot reçoit une échelle (UIScale "SlotScale" sur son
	cadre, voir Slots.GetScale) pour ne pas recouvrir la colonne centrale.
	Le cadre garde sa taille "design" (288x190...) : les stimuli se
	construisent comme avant, tout est simplement réduit. Sur PC l'échelle
	vaut 1 et les positions sont exactement celles du tableau.
	Slots.Changed est déclenché quand la mise en page change (rotation...).
	Marge de découpe : le cadre d'un slot (qui découpe son contenu) déborde de
	Slots.ClipMargin px tout autour de la zone "design", compensés par un
	UIPadding : le contenu garde exactement sa place, mais le contour (UIStroke,
	dessiné À L'EXTÉRIEUR des cartes, et jamais réduit par les UIScale) n'est
	plus coupé, même sur téléphone. Taille "design" : Slots.GetDesignSize(name).

	v9.1 (plein écran) : le calque Background déborde de la toile jusqu'aux
	bords de l'écran (Interface.Bleed). Les cadres "Background" des stimuli
	restent recalés sur la toile (leurs coordonnées = pixels "design" de la
	toile, comme avant), sauf les fonds purement décoratifs de
	Slots.BleedBackgrounds (ex. NeonMode) qui couvrent tout l'écran. Le slot
	"Ticker" évite la partie de la barre Roblox occupée par ses boutons
	(Interface.TickerInsets, non nul sur téléphone où le bandeau vit dans la
	barre Roblox).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Signal = require(ReplicatedStorage.Shared.Signal)

local Slots = {}

Slots.DesignHeight = 720
Slots.Changed = Signal.new() -- () : échelles / positions recalculées

-- { Anchor, X, Y, W, H } (H = 0 et Anchor "T" : toute la largeur)
Slots.Definitions = {
	Ticker = { Anchor = "T", X = 0, Y = 0, W = 0, H = 30 },
	L1 = { Anchor = "L", X = 16, Y = 40, W = 288, H = 190 },
	R1 = { Anchor = "R", X = 16, Y = 40, W = 288, H = 190 },
	L2 = { Anchor = "L", X = 16, Y = 240, W = 288, H = 180 },
	R2 = { Anchor = "R", X = 16, Y = 240, W = 288, H = 180 },
	CL = { Anchor = "C", X = -250, Y = 40, W = 170, H = 170 },
	CR = { Anchor = "C", X = 250, Y = 40, W = 170, H = 170 },
	L3 = { Anchor = "L", X = 16, Y = 436, W = 384, H = 268 },
	C3 = { Anchor = "C", X = 0, Y = 436, W = 384, H = 268 },
	R3 = { Anchor = "R", X = 16, Y = 436, W = 384, H = 268 },
}

local TICKER_HEIGHT = 30
-- Marge de découpe autour d'un slot (pixels "design", voir en-tête) : 6 px
-- = 2 px à l'écran avec l'échelle la plus petite (téléphone, ~0.35)
Slots.ClipMargin = 6
-- Bas de la colonne centrale (pixels "design") sur téléphone / tablette
local PHONE_COLUMN_BOTTOM = 388
local TABLET_COLUMN_BOTTOM = 456
local bound = false

-- Mise en page actuelle : { Device, Canvas, Scales = { [slot] = number }, CenterOffset = number }
local layout = {
	Device = "Desktop",
	Canvas = Vector2.new(1280, 720),
	Scales = {} :: { [string]: number },
	CenterOffset = 250, -- décalage horizontal de CL / CR (centre du slot)
}

-- Cadres créés par Slots.Create (pour les replacer si l'écran change)
local frames: { [Frame]: string } = setmetatable({}, { __mode = "k" }) :: any
-- Cadres "Background" (recalés sur la toile dans le calque qui déborde)
local backgroundFrames: { [Frame]: boolean } = setmetatable({}, { __mode = "k" }) :: any
-- Débords de la toile (pixels "design") et parties cachées de la rangée du bandeau
local bleed = { Left = 0, Top = 0, Right = 0, Bottom = 0 }
local tickerInsets = { Left = 0, Right = 0 }

-- Stimuli "Background" purement décoratifs, à mise en page 100 % relative
-- (Scale) : leur cadre couvre tout l'écran au lieu de la seule toile
Slots.BleedBackgrounds = { NeonMode = true }

-- Vrai si `name` est un emplacement connu (y compris Overlay / Background)
function Slots.IsValid(name: string): boolean
	return Slots.Definitions[name] ~= nil or name == "Overlay" or name == "Background"
end

-- Nom du calque de l'Interface où doit aller ce slot
function Slots.GetLayerName(name: string): string
	if name == "Overlay" then
		return "Overlay"
	elseif name == "Background" then
		return "Background"
	end
	return "Slots"
end

-- Échelle d'un slot (1 sur PC ; plus petite sur téléphone / tablette)
function Slots.GetScale(name: string): number
	return layout.Scales[name] or 1
end

-- Profil actuel ("Phone" | "Tablet" | "Desktop")
function Slots.GetDevice(): string
	return layout.Device
end

-- Calcule les échelles selon l'appareil et la taille de la toile (pixels "design").
-- Téléphone : la colonne centrale occupe le centre (voir GetCenterClearWidth)
-- et descend jusqu'à y ≈ 388 (toile de 540 de haut) ; tablette : ±340 et y ≈ 456.
local function computeLayout(device: string, canvas: Vector2)
	local scales: { [string]: number } = {}
	local centerOffset = 250
	local W, H = canvas.X, canvas.Y
	if device == "Phone" then
		-- Côtés : 0.75 (L1/L2/R1/R2), un peu moins si l'écran est étroit
		local side = math.clamp((W / 2 - 250) / 304, 0.6, 0.75)
		-- Rangée du bas : sous la colonne (qui finit vers y = 380)
		local bottomRoom = math.max(120, H - 12 - PHONE_COLUMN_BOTTOM)
		local center = math.clamp(bottomRoom / 268, 0.45, 0.62)
		local low = math.clamp(math.min(bottomRoom / 268 + 0.04, (W / 2 - 12 - 192 * center) / 400), 0.45, 0.66)
		local corner = math.clamp(side * 0.9, 0.55, 0.68)
		for _, name in ipairs({ "L1", "R1", "L2", "R2" }) do
			scales[name] = side
		end
		scales.L3, scales.R3, scales.C3 = low, low, center
		scales.CL, scales.CR = corner, corner
		-- CL / CR : entre les slots de côté et le bouton
		local sideEdge = (16 + 288) * side
		centerOffset = math.clamp(W / 2 - sideEdge - 8 - 85 * corner, 180, 250)
	elseif device == "Tablet" then
		local side = math.clamp((W / 2 - 340 - 8) / 304, 0.6, 1)
		local bottom = math.clamp(math.min((W / 2 - 8) / 592, (H - 16 - TABLET_COLUMN_BOTTOM) / 268), 0.55, 1)
		for _, name in ipairs({ "L1", "R1", "L2", "R2" }) do
			scales[name] = side
		end
		scales.L3, scales.R3, scales.C3 = bottom, bottom, bottom
		scales.CL, scales.CR = side, side
		local sideEdge = (16 + 288) * side
		centerOffset = math.clamp(W / 2 - sideEdge - 8 - 85 * side, 190, 250)
	end
	layout.Device = device
	layout.Canvas = canvas
	layout.Scales = scales
	layout.CenterOffset = centerOffset
end

-- Taille "design" de la zone d'un slot (sans la marge de découpe)
function Slots.GetDesignSize(name: string): Vector2
	local def = Slots.Definitions[name]
	if not def then
		return Vector2.new(0, 0)
	end
	return Vector2.new(def.W, def.H)
end

-- Position (centre, AnchorPoint 0.5/0.5) et taille du cadre d'un slot : zone
-- "design" + marge de découpe (la taille réelle = taille x Slots.GetScale(name))
function Slots.GetPlacement(name: string): (UDim2, UDim2)
	local def = Slots.Definitions[name]
	if not def then
		return UDim2.fromScale(0.5, 0.5), UDim2.fromScale(1, 1)
	end
	local k = Slots.GetScale(name)

	local centerY = def.Y + def.H / 2
	local yUDim
	if centerY > Slots.DesignHeight / 2 then
		-- accroché en bas : marge (et hauteur) réduites de la même façon
		local bottomMargin = Slots.DesignHeight - (def.Y + def.H)
		yUDim = UDim.new(1, -(bottomMargin * k + def.H * k / 2))
	else
		-- accroché en haut, sous le bandeau d'actualités
		local top = def.Y
		if k ~= 1 and def.Anchor ~= "T" then
			top = TICKER_HEIGHT + (def.Y - TICKER_HEIGHT) * k
		end
		yUDim = UDim.new(0, top + def.H * k / 2)
	end

	local xUDim
	local size
	if def.Anchor == "T" then
		-- (téléphone : pas sous les boutons Roblox de la barre du haut)
		local cutLeft, cutRight = tickerInsets.Left, tickerInsets.Right
		xUDim = UDim.new(0.5, (cutLeft - cutRight) / 2)
		size = UDim2.new(1, -(cutLeft + cutRight), 0, def.H)
	elseif def.Anchor == "L" then
		xUDim = UDim.new(0, (def.X + def.W / 2) * k)
		size = UDim2.fromOffset(def.W + Slots.ClipMargin * 2, def.H + Slots.ClipMargin * 2)
	elseif def.Anchor == "R" then
		xUDim = UDim.new(1, -(def.X + def.W / 2) * k)
		size = UDim2.fromOffset(def.W + Slots.ClipMargin * 2, def.H + Slots.ClipMargin * 2)
	else -- "C"
		local offset = def.X
		if k ~= 1 and def.X ~= 0 then
			offset = (def.X < 0 and -1 or 1) * layout.CenterOffset
		end
		xUDim = UDim.new(0.5, offset)
		size = UDim2.fromOffset(def.W + Slots.ClipMargin * 2, def.H + Slots.ClipMargin * 2)
	end
	return UDim2.new(xUDim, yUDim), size
end

-- Replace un cadre de slot (position + UIScale "SlotScale")
local function place(frame: Frame, name: string)
	local position, size = Slots.GetPlacement(name)
	frame.Position = position
	frame.Size = size
	local scale = frame:FindFirstChild("SlotScale")
	if scale and scale:IsA("UIScale") and not frame:GetAttribute("SlotAnimating") then
		scale.Scale = Slots.GetScale(name)
	end
end

-- Cadre "Background" : recalé sur la toile (ou tout l'écran pour les fonds
-- décoratifs de Slots.BleedBackgrounds, reconnus à leur nom de stimulus)
local function placeBackground(frame: Frame)
	frame.AnchorPoint = Vector2.zero
	if Slots.BleedBackgrounds[frame.Name] then
		frame.Position = UDim2.new()
		frame.Size = UDim2.fromScale(1, 1)
	else
		frame.Position = UDim2.fromOffset(bleed.Left, bleed.Top)
		frame.Size = UDim2.new(1, -(bleed.Left + bleed.Right), 1, -(bleed.Top + bleed.Bottom))
	end
end

-- Recalcule la mise en page (appelé par Slots.Bind quand l'écran change).
-- `interfaceBleed` / `interfaceTicker` : Interface.Bleed / Interface.TickerInsets
function Slots.UpdateLayout(device: string, canvas: Vector2, interfaceBleed: any?, interfaceTicker: any?)
	if type(interfaceBleed) == "table" then
		bleed = interfaceBleed
	end
	if type(interfaceTicker) == "table" then
		tickerInsets = interfaceTicker
	end
	computeLayout(device, canvas)
	for frame, name in pairs(frames) do
		if frame.Parent then
			place(frame, name)
		end
	end
	for frame in pairs(backgroundFrames) do
		if frame.Parent then
			placeBackground(frame)
		end
	end
	Slots.Changed:Fire()
end

-- Largeur (pixels "design") laissée libre au centre par les slots de côté
-- (L1/L2/R1/R2) : la colonne centrale ne doit pas dépasser. Sur PC : 1280 - 2 x 312.
function Slots.GetCenterClearWidth(): number
	local side = layout.Scales.L1 or 1
	return layout.Canvas.X - 2 * ((16 + 288) * side + 8)
end

-- Branche la mise en page sur l'Interface (profil d'appareil + taille de la toile).
-- Plusieurs appels possibles (un seul branchement).
function Slots.Bind(interface: any)
	if bound then
		return
	end
	bound = true
	local function update()
		Slots.UpdateLayout(interface.Device or "Desktop", interface.CanvasSize or Vector2.new(1280, 720), interface.Bleed, interface.TickerInsets)
	end
	interface.ScaleChanged:Connect(update)
	interface.DeviceChanged:Connect(update)
	update()
end

-- Crée le cadre (transparent) d'un slot dans `parent`.
-- Slots réels : ClipsDescendants = true + UIScale "SlotScale" (échelle du slot).
-- Overlay / Background : plein écran.
function Slots.Create(name: string, parent: Instance?): Frame
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.Active = false
	frame.AnchorPoint = Vector2.new(0.5, 0.5)

	if name == "Overlay" or name == "Background" or not Slots.Definitions[name] then
		if not Slots.IsValid(name) then
			warn("[Slots] Emplacement inconnu : " .. tostring(name) .. " (plein écran utilisé)")
		end
		frame.Position = UDim2.fromScale(0.5, 0.5)
		frame.Size = UDim2.fromScale(1, 1)
		frame.ClipsDescendants = false
		if name == "Background" then
			-- Le calque Background déborde de la toile : on s'y recale
			backgroundFrames[frame] = true
			placeBackground(frame)
			frame:GetPropertyChangedSignal("Name"):Connect(function()
				placeBackground(frame)
			end)
		end
	else
		frame.ClipsDescendants = true
		if Slots.Definitions[name].Anchor ~= "T" then
			local scale = Instance.new("UIScale")
			scale.Name = "SlotScale"
			scale.Scale = Slots.GetScale(name)
			scale.Parent = frame
			-- Compense la marge de découpe : le contenu reste dans la zone "design"
			local margin = UDim.new(0, Slots.ClipMargin)
			local padding = Instance.new("UIPadding")
			padding.Name = "SlotMargin"
			padding.PaddingLeft = margin
			padding.PaddingRight = margin
			padding.PaddingTop = margin
			padding.PaddingBottom = margin
			padding.Parent = frame
		end
		place(frame, name)
		frames[frame] = name
	end

	frame.Parent = parent
	return frame
end

return Slots
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="111">
        <Properties>
          <string name="Name">SoundManager</string>
          <string name="Source"><![CDATA[--[[
	SoundManager (ModuleScript)
	Emplacement : ReplicatedStorage > Client > SoundManager

	Joue les sons et la musique (côté client uniquement).
	- Sons : IDs dans Config.Sounds, joués avec SoundManager.Play(nom, hauteur).
	- Musique : vraie playlist lofi (Config.Music.Playlist). Les pistes avec
	  Id = "" sont ignorées ; ordre mélangé si Config.Music.Shuffle ; fondu
	  enchaîné entre deux morceaux ; passe au suivant à la fin d'un morceau
	  ou si un morceau ne se charge pas ; la playlist tourne en boucle.

	La musique ne joue que si le réglage "Musique" est activé
	(SetMusicEnabled) ET qu'elle est autorisée (SetMusicAllowed : ClientMain
	l'autorise quand le joueur possède la Feature "Lofi").

	Volumes (0 à 1, gardés en mémoire pour la session) : SetMusicVolume /
	SetEffectsVolume, appliqués via deux SoundGroups ("Musique", "Effets").

	Son du clic (v4) : le joueur choisit son son de clic dans ⚙️ Paramètres
	(Config.ClickSounds, sauvegardé côté serveur dans Settings.ClickSound).
	SoundManager.PlayClick(hauteur) joue le son choisi pour le gros bouton
	(repli : Config.Sounds.Click). Play("Click") reste le petit clic de l'interface.

	Signaux :
	  SoundManager.TrackChanged (nom?, sound?)  : un nouveau morceau commence
	                                             (nil, nil quand la musique s'arrête)
	  SoundManager.MusicStateChanged (joue)      : la musique démarre / s'arrête
	  SoundManager.VolumeChanged (musique, effets)
	  SoundManager.ClickSoundChanged (id)        : le son du clic a changé
	  SoundManager.MusicChanged ()               : v8, morceau / lecture / choix changé

	v8 — choix de la musique (⚙️ Paramètres) : réglage Settings.MusicTrack =
	"Shuffle" (toute la playlist, ordre mélangé) ou la Key d'un morceau (ce
	morceau en boucle). Appliqué au chargement (premier état), sauvegardé par
	SetMusicTrack / NextTrack / PreviousTrack (SetSetting "MusicTrack").
	  GetMusicInfo() -> { Key, Name, Index, Count, Playing, Mode, Loading }?
	  SetMusicTrack(key) ("Shuffle" | Key), NextTrack(), PreviousTrack(),
	  GetMusicMode(), GetPlaylist() -> { { Key, Name, Index } }.
	Les effets sonores (SFX) ne changent pas.
]]

local ContentProvider = game:GetService("ContentProvider")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Signal = require(ReplicatedStorage.Shared.Signal)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Net = require(ReplicatedStorage.Shared.Net)
local ClientState = require(script.Parent.ClientState)

local SoundManager = {}

-- Nom affiché d'un morceau, dans la langue du joueur ("Track 2" sans nom)
local function trackName(track): string
	if track.Name then
		return Locale.T(track.Name)
	end
	return Locale.T("Track %d", track.Index or 1)
end

SoundManager.TrackChanged = Signal.new() -- (name: string?, sound: Sound?)
SoundManager.MusicStateChanged = Signal.new() -- (playing: boolean)
SoundManager.VolumeChanged = Signal.new() -- (musicVolume, effectsVolume)
SoundManager.ClickSoundChanged = Signal.new() -- (clickSoundId)
SoundManager.MusicChanged = Signal.new() -- () : morceau, lecture ou choix de musique changé

local MIN_INTERVAL = 0.035 -- évite d'empiler 20 fois le même son dans la même image
local CROSSFADE = 2.5 -- durée (s) du fondu enchaîné entre deux morceaux
local FADE_IN = 1.5 -- fondu à la reprise
local FADE_OUT = 1 -- fondu à la coupure
local LOAD_TIMEOUT = 10 -- (s) au-delà, un morceau qui ne charge pas est sauté
local RETRY_DELAY = 30 -- (s) si AUCUN morceau ne charge, on réessaie plus tard

local soundEnabled = true
local musicEnabled = true -- réglage du joueur
local musicAllowed = false -- Feature "Lofi" possédée
local musicVolume = math.clamp(tonumber(Config.Music and Config.Music.DefaultVolume) or 0.35, 0, 1)
local effectsVolume = 1

local folder: Folder? = nil
local effectsGroup: SoundGroup? = nil
local musicGroup: SoundGroup? = nil
local templates: { [string]: Sound } = {}
local lastPlayed: { [string]: number } = {}

-- Sons de clic au choix (Config.ClickSounds)
local DEFAULT_CLICK_SOUND = "Default"
local clickTemplates: { [string]: Sound } = {} -- [Id] = modèle de son
local clickSoundId = DEFAULT_CLICK_SOUND
local lastClick = 0

-- Playlist
type Track = { Name: string?, Index: number?, Id: string, Key: string? }
local tracks: { Track } = {} -- pistes valides (Id non vide)
local SHUFFLE = "Shuffle"
local musicMode = SHUFFLE -- "Shuffle" ou la Key du morceau choisi (joué en boucle)
local modeLocalUntil = 0 -- choix local récent : on ignore l'état serveur (sauvegarde en cours)
local modeSaveToken = 0
local order: { number } = {} -- ordre de lecture (indices dans `tracks`)
local orderPosition = 0
local current: Sound? = nil
local currentTrack: Track? = nil
local generation = 0 -- change à chaque nouveau morceau (annule les attentes périmées)
local pauseToken = 0 -- change à chaque coupure / reprise (annule un fondu de coupure périmé)
local playing = false -- état "la musique joue" (pour MusicStateChanged)
local failures = 0 -- échecs de chargement d'affilée
local retryAt = 0 -- os.clock() avant lequel on ne relance pas (tout a échoué)
local warnedEmpty = false

----------------------------------------------------------------------
-- Outils
----------------------------------------------------------------------

-- "123" ou 123 -> "rbxassetid://123" ; sinon l'ID tel quel ("" si invalide)
local function normalizeId(id: any): string
	if type(id) == "number" then
		return id > 0 and ("rbxassetid://" .. tostring(math.floor(id))) or ""
	end
	if type(id) ~= "string" then
		return ""
	end
	local trimmed = string.gsub(id, "^%s*(.-)%s*$", "%1")
	if trimmed == "" or trimmed == "0" then
		return ""
	end
	if string.match(trimmed, "^%d+$") then
		return "rbxassetid://" .. trimmed
	end
	return trimmed
end

local function fade(sound: Sound, volume: number, duration: number): Tween
	local tween = TweenService:Create(sound, TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
		Volume = volume,
	})
	tween:Play()
	return tween
end

-- Fait disparaître un morceau en douceur puis le détruit
local function fadeAndDestroy(sound: Sound, duration: number)
	local tween = fade(sound, 0, duration)
	tween.Completed:Once(function()
		sound:Destroy()
	end)
	-- Filet de sécurité si le tween est interrompu
	Debris:AddItem(sound, duration + 1)
end

local function shouldPlay(): boolean
	return musicEnabled and musicAllowed and #tracks > 0
end

local function setPlaying(value: boolean)
	if playing ~= value then
		playing = value
		SoundManager.MusicStateChanged:Fire(value)
		SoundManager.MusicChanged:Fire()
	end
end

-- Nouvel ordre de lecture (mélangé si demandé, sans rejouer tout de suite le dernier)
local function buildOrder()
	local last = order[#order]
	table.clear(order)
	for index = 1, #tracks do
		table.insert(order, index)
	end
	if Config.Music.Shuffle and #order > 1 then
		local random = Random.new()
		for i = #order, 2, -1 do
			local j = random:NextInteger(1, i)
			order[i], order[j] = order[j], order[i]
		end
		if last and order[1] == last then
			order[1], order[#order] = order[#order], order[1]
		end
	end
	orderPosition = 0
end

-- Indice (dans `tracks`) du morceau choisi, ou nil en mode aléatoire
local function fixedIndex(): number?
	if musicMode == SHUFFLE then
		return nil
	end
	for index, track in ipairs(tracks) do
		if track.Key == musicMode then
			return index
		end
	end
	return nil
end

local function nextTrackIndex(): number?
	if #tracks == 0 then
		return nil
	end
	local fixed = fixedIndex()
	if fixed then
		return fixed
	end
	orderPosition += 1
	if orderPosition > #order then
		buildOrder()
		orderPosition = 1
	end
	return order[orderPosition]
end

----------------------------------------------------------------------
-- Lecture
----------------------------------------------------------------------

local startNext: (crossfade: number, forcedIndex: number?) -> ()

-- Surveille le chargement d'un morceau : s'il ne charge pas à temps, on passe au suivant
local function watchLoading(sound: Sound, myGeneration: number)
	task.spawn(function()
		local started = os.clock()
		while not sound.IsLoaded and os.clock() - started < LOAD_TIMEOUT do
			task.wait(0.25)
			if generation ~= myGeneration or not sound.Parent then
				return
			end
		end
		if generation ~= myGeneration or not sound.Parent then
			return
		end
		if sound.IsLoaded then
			failures = 0
			return
		end
		-- Échec : morceau suivant (ou pause si tout échoue)
		failures += 1
		warn("[SoundManager] Musique impossible à charger : " .. sound.SoundId .. " (morceau suivant)")
		if failures >= #tracks then
			failures = 0
			retryAt = os.clock() + RETRY_DELAY
			if current == sound then
				current = nil
				currentTrack = nil
				sound:Destroy()
				setPlaying(false)
				SoundManager.TrackChanged:Fire(nil, nil)
			end
			return
		end
		if shouldPlay() then
			startNext(0.5)
		end
	end)
end

-- Lance le morceau suivant (ou `forcedIndex`) avec un fondu enchaîné
startNext = function(crossfade: number, forcedIndex: number?)
	local group = musicGroup
	local parent = folder
	if not group or not parent then
		return
	end
	local index = forcedIndex or nextTrackIndex()
	if not index or not tracks[index] then
		return
	end
	local track = tracks[index]
	generation += 1
	local displayName = trackName(track)
	local myGeneration = generation

	-- L'ancien morceau s'efface
	local old = current
	if old then
		fadeAndDestroy(old, math.max(0.2, crossfade))
	end

	local sound = Instance.new("Sound")
	sound.Name = "Music_" .. tostring(track.Name or track.Index)
	sound.SoundId = track.Id
	sound.Volume = 0
	-- Un seul morceau, ou un morceau choisi : il boucle tout seul
	sound.Looped = #tracks == 1 or fixedIndex() == index
	sound.SoundGroup = group
	sound.Parent = parent
	current = sound
	currentTrack = track

	sound.Ended:Connect(function()
		-- Fin naturelle (si le fondu anticipé n'a pas déjà pris le relais)
		if generation == myGeneration and current == sound and shouldPlay() then
			startNext(0.3)
		end
	end)

	sound:Play()
	fade(sound, 1, math.max(0.2, crossfade))
	watchLoading(sound, myGeneration)
	setPlaying(true)
	SoundManager.TrackChanged:Fire(displayName, sound)
	SoundManager.MusicChanged:Fire()
end

-- Démarre / reprend / coupe la musique selon les réglages
local function refreshMusic()
	local sound = current
	if shouldPlay() then
		if os.clock() < retryAt then
			return
		end
		if sound then
			if not playing or not sound.IsPlaying then
				pauseToken += 1 -- annule un éventuel fondu de coupure en cours
				if not sound.IsPlaying then
					sound.Volume = 0
					sound:Resume()
				end
				fade(sound, 1, FADE_IN)
				setPlaying(true)
			end
		else
			startNext(FADE_IN)
		end
	else
		if RunService:IsStudio() and musicEnabled and musicAllowed and #tracks == 0 and not warnedEmpty then
			warnedEmpty = true
			warn("[SoundManager] Aucune musique : ajoute des IDs dans Config.Music.Playlist")
		end
		if sound and sound.IsPlaying and playing then
			pauseToken += 1
			local myToken = pauseToken
			local tween = fade(sound, 0, FADE_OUT)
			tween.Completed:Once(function()
				-- Pause (on reprend au même endroit), sauf si la musique est revenue entre-temps
				if pauseToken == myToken and current == sound and not shouldPlay() then
					sound:Pause()
				end
			end)
		end
		setPlaying(false)
	end
end

----------------------------------------------------------------------
-- API
----------------------------------------------------------------------

-- Crée un "modèle" de son pour chaque entrée de Config.Sounds + la playlist
function SoundManager.Init()
	local old = SoundService:FindFirstChild("DopamineSounds")
	if old then
		old:Destroy()
	end
	local newFolder = Instance.new("Folder")
	newFolder.Name = "DopamineSounds"
	newFolder.Parent = SoundService
	folder = newFolder

	local fx = Instance.new("SoundGroup")
	fx.Name = "Effets"
	fx.Volume = effectsVolume
	fx.Parent = newFolder
	effectsGroup = fx

	local mu = Instance.new("SoundGroup")
	mu.Name = "Musique"
	mu.Volume = musicVolume
	mu.Parent = newFolder
	musicGroup = mu

	table.clear(templates)
	local toPreload = {}
	for name, info in pairs(Config.Sounds) do
		local id = normalizeId(info.Id)
		if id ~= "" then
			local sound = Instance.new("Sound")
			sound.Name = name
			sound.SoundId = id
			sound.Volume = info.Volume or 0.5
			sound.SoundGroup = fx
			sound.Parent = newFolder
			templates[name] = sound
			table.insert(toPreload, sound)
		end
	end

	-- Sons de clic au choix
	table.clear(clickTemplates)
	for _, entry in ipairs(Config.ClickSounds or {}) do
		local id = normalizeId(entry.Sound)
		if type(entry.Id) == "string" and id ~= "" then
			local sound = Instance.new("Sound")
			sound.Name = "ClickSound_" .. entry.Id
			sound.SoundId = id
			sound.Volume = tonumber(entry.Volume) or 0.5
			sound.SoundGroup = fx
			sound.Parent = newFolder
			clickTemplates[entry.Id] = sound
			table.insert(toPreload, sound)
		end
	end

	-- Playlist : on garde seulement les pistes avec un ID
	table.clear(tracks)
	local playlist = (Config.Music and Config.Music.Playlist) or {}
	for index, entry in ipairs(playlist) do
		local id = normalizeId(entry.Id)
		if id ~= "" then
			table.insert(tracks, {
				Name = entry.Name and tostring(entry.Name) or nil,
				Index = index,
				Id = id,
				Key = type(entry.Key) == "string" and entry.Key or ("Track" .. index),
			})
		end
	end
	buildOrder()

	-- Préchargement en arrière-plan (évite un petit délai au premier clic)
	task.spawn(function()
		pcall(function()
			ContentProvider:PreloadAsync(toPreload)
		end)
	end)

	-- Surveillance : fondu enchaîné un peu avant la fin du morceau,
	-- et nouvel essai si tout avait échoué au chargement
	task.spawn(function()
		while true do
			task.wait(0.25)
			local sound = current
			if shouldPlay() then
				if not sound and os.clock() >= retryAt and retryAt > 0 then
					retryAt = 0
					refreshMusic()
				elseif sound and #tracks > 1 and not sound.Looped and sound.IsPlaying and sound.IsLoaded then
					local length = sound.TimeLength
					if length > CROSSFADE * 3 and sound.TimePosition >= length - CROSSFADE then
						startNext(CROSSFADE)
					end
				end
			end
		end
	end)

	-- Choix de la musique sauvegardé (Settings.MusicTrack), appliqué à chaque
	-- état complet sauf juste après un choix local (sauvegarde en cours)
	local function followSetting(data)
		-- Musique autorisée avec "Lofi Beats" : suivi ici aussi, car le premier
		-- état arrive souvent AVANT que ClientMain branche FeaturesChanged
		-- (la musique ne démarrait alors qu'au prochain achat)
		local allowed = ClientState.HasFeature("Lofi")
		if allowed ~= musicAllowed then
			SoundManager.SetMusicAllowed(allowed)
		end
		if os.clock() < modeLocalUntil or type(data) ~= "table" or type(data.Settings) ~= "table" then
			return
		end
		local saved = data.Settings.MusicTrack
		if type(saved) == "string" and saved ~= musicMode then
			SoundManager.SetMusicTrack(saved, true)
		end
	end
	ClientState.Changed:Connect(followSetting)
	if ClientState.Data then
		followSetting(ClientState.Data)
	end

	refreshMusic()
end

-- Joue un modèle de son (clone temporaire)
local function playTemplate(template: Sound, pitch: number)
	local sound = template:Clone()
	sound.PlaybackSpeed = pitch
	sound.Parent = SoundService
	sound:Play()
	Debris:AddItem(sound, math.max(2, sound.TimeLength / math.max(0.1, sound.PlaybackSpeed) + 0.5))
end

-- Joue un son. `pitch` change la hauteur (1 = normal).
function SoundManager.Play(name: string, pitch: number?)
	if not soundEnabled or effectsVolume <= 0 or name == "Music" then
		return
	end
	local template = templates[name]
	if not template then
		return
	end
	local now = os.clock()
	if now - (lastPlayed[name] or 0) < MIN_INTERVAL then
		return
	end
	lastPlayed[name] = now
	playTemplate(template, pitch or 1)
end

----------------------------------------------------------------------
-- Son du clic (v4)
----------------------------------------------------------------------

-- Choisit le son du clic (Id de Config.ClickSounds ; inconnu = "Default")
function SoundManager.SetClickSound(id: string)
	local newId = (type(id) == "string" and clickTemplates[id] ~= nil) and id or DEFAULT_CLICK_SOUND
	if newId == clickSoundId then
		return
	end
	clickSoundId = newId
	SoundManager.ClickSoundChanged:Fire(newId)
end

function SoundManager.GetClickSound(): string
	return clickSoundId
end

-- Joue le son de clic choisi (gros bouton). `pitch` : hauteur (1 = normal).
-- Les sons de clavier gardent une hauteur plus naturelle (variation réduite).
function SoundManager.PlayClick(pitch: number?)
	if not soundEnabled or effectsVolume <= 0 then
		return
	end
	local template = clickTemplates[clickSoundId]
	if not template then
		SoundManager.Play("Click", pitch)
		return
	end
	local now = os.clock()
	if now - lastClick < MIN_INTERVAL then
		return
	end
	lastClick = now
	local speed = pitch or 1
	if clickSoundId ~= DEFAULT_CLICK_SOUND then
		speed = 1 + (speed - 1) * 0.35
	end
	playTemplate(template, speed)
end

-- Fait écouter un son de clic (bouton ▶ des paramètres), même s'il n'est pas choisi
function SoundManager.PreviewClickSound(id: string)
	if not soundEnabled or effectsVolume <= 0 then
		return
	end
	local template = clickTemplates[id]
	if template then
		playTemplate(template, 1)
	else
		SoundManager.Play("Click", 1)
	end
end

-- v9.1 GEAR : son de touche (Config.ClickSounds Keyboard1..5) joué par les
-- claviers cliquables, avec hauteur ; limité comme PlayClick
local lastKey = 0
function SoundManager.PlayKeySound(id: string, pitch: number?)
	if not soundEnabled or effectsVolume <= 0 then
		return
	end
	local template = clickTemplates[id]
	if not template then
		return
	end
	local now = os.clock()
	if now - lastKey < MIN_INTERVAL then
		return
	end
	lastKey = now
	playTemplate(template, pitch or 1)
end

function SoundManager.SetSoundEnabled(enabled: boolean)
	soundEnabled = enabled == true
end

function SoundManager.IsSoundEnabled(): boolean
	return soundEnabled
end

-- Réglage "Musique" du joueur
function SoundManager.SetMusicEnabled(enabled: boolean)
	musicEnabled = enabled == true
	refreshMusic()
end

function SoundManager.IsMusicEnabled(): boolean
	return musicEnabled
end

-- Autorisation de la musique (Feature "Lofi")
function SoundManager.SetMusicAllowed(allowed: boolean)
	musicAllowed = allowed == true
	refreshMusic()
end

function SoundManager.IsMusicAllowed(): boolean
	return musicAllowed
end

-- Vrai si un morceau est en train de jouer
function SoundManager.IsMusicPlaying(): boolean
	return playing
end

-- Vrai si la playlist contient au moins un morceau avec un ID
function SoundManager.HasPlaylist(): boolean
	return #tracks > 0
end

-- Volume de la musique (0 à 1)
function SoundManager.SetMusicVolume(volume: number)
	musicVolume = math.clamp(tonumber(volume) or 0, 0, 1)
	local group = musicGroup
	if group then
		group.Volume = musicVolume
	end
	SoundManager.VolumeChanged:Fire(musicVolume, effectsVolume)
end

function SoundManager.GetMusicVolume(): number
	return musicVolume
end

-- Volume des effets sonores (0 à 1)
function SoundManager.SetEffectsVolume(volume: number)
	effectsVolume = math.clamp(tonumber(volume) or 0, 0, 1)
	local group = effectsGroup
	if group then
		group.Volume = effectsVolume
	end
	SoundManager.VolumeChanged:Fire(musicVolume, effectsVolume)
end

function SoundManager.GetEffectsVolume(): number
	return effectsVolume
end

----------------------------------------------------------------------
-- Choix de la musique (v8)
----------------------------------------------------------------------

-- Sauvegarde le choix côté serveur (dernier choix seulement, 3 essais)
local function saveMusicMode()
	modeSaveToken += 1
	local token = modeSaveToken
	local value = musicMode
	modeLocalUntil = os.clock() + 6
	task.delay(0.4, function()
		for attempt = 1, 3 do
			if token ~= modeSaveToken then
				return -- un choix plus récent a pris le relais
			end
			local ok, success = pcall(function()
				return Net.Function("SetSetting"):InvokeServer("MusicTrack", value)
			end)
			if ok and success == true then
				local data = ClientState.Data
				if data and type(data.Settings) == "table" then
					data.Settings.MusicTrack = value
				end
				return
			end
			if attempt < 3 then
				task.wait(0.4)
			end
		end
	end)
end

-- Vrai si `key` est "Shuffle" ou la Key d'un morceau de la playlist
local function isValidMode(key: any): boolean
	if key == SHUFFLE then
		return true
	end
	for _, track in ipairs(tracks) do
		if track.Key == key then
			return true
		end
	end
	return false
end

-- Choisit la musique : "Shuffle" (toute la playlist) ou la Key d'un morceau
-- (joué en boucle). `fromServer` = vrai : pas de sauvegarde (valeur déjà
-- sauvegardée). Renvoie vrai si le choix est valide.
function SoundManager.SetMusicTrack(key: string, fromServer: boolean?): boolean
	if not isValidMode(key) then
		return false
	end
	local changed = key ~= musicMode
	musicMode = key
	if not fromServer then
		saveMusicMode()
	end
	local fixed = fixedIndex()
	local sound = current
	if fixed then
		if sound and currentTrack == tracks[fixed] then
			sound.Looped = true -- déjà en cours : il boucle désormais
		elseif shouldPlay() then
			failures = 0
			retryAt = 0
			startNext(0.8, fixed)
		elseif sound then
			-- Musique coupée : on oublie le morceau en pause, le choix
			-- démarrera à la reprise
			generation += 1
			current = nil
			currentTrack = nil
			sound:Destroy()
		end
	elseif changed then
		-- Retour à l'aléatoire : le morceau en cours continue, puis la playlist
		if sound then
			sound.Looped = #tracks == 1
		end
		buildOrder()
	end
	SoundManager.MusicChanged:Fire()
	return true
end

-- Choix actuel : "Shuffle" ou la Key du morceau choisi
function SoundManager.GetMusicMode(): string
	return musicMode
end

-- Playlist (pistes avec un ID) : { { Key, Name (traduit), Index } }
function SoundManager.GetPlaylist(): { { Key: string, Name: string, Index: number } }
	local list = {}
	for index, track in ipairs(tracks) do
		table.insert(list, { Key = track.Key or ("Track" .. index), Name = trackName(track), Index = index })
	end
	return list
end

-- Morceau en cours (ou choisi) : { Key, Name, Index, Count, Playing, Mode, Loading } ;
-- nil si la playlist est vide
function SoundManager.GetMusicInfo(): { [string]: any }?
	if #tracks == 0 then
		return nil
	end
	local track = currentTrack
	local index = 0
	if track then
		index = table.find(tracks, track) or 0
	else
		index = fixedIndex() or 0
		track = tracks[index]
	end
	local sound = current
	return {
		Key = track and track.Key or nil,
		Name = track and trackName(track) or nil,
		Index = index,
		Count = #tracks,
		Playing = playing,
		Mode = musicMode,
		Loading = sound ~= nil and playing and not sound.IsLoaded,
	}
end

-- Passe au morceau suivant (fondu court). Morceau choisi : on choisit le
-- suivant de la playlist (sauvegardé). Renvoie vrai si c'est fait.
function SoundManager.NextTrack(): boolean
	if #tracks == 0 then
		return false
	end
	local fixed = fixedIndex()
	if fixed then
		local nextIndex = fixed % #tracks + 1
		return SoundManager.SetMusicTrack(tracks[nextIndex].Key or SHUFFLE)
	end
	if not shouldPlay() then
		return false
	end
	failures = 0
	retryAt = 0
	startNext(0.8)
	return true
end

-- Revient au morceau précédent (même logique que NextTrack)
function SoundManager.PreviousTrack(): boolean
	if #tracks == 0 then
		return false
	end
	local fixed = fixedIndex()
	if fixed then
		local previousIndex = (fixed - 2) % #tracks + 1
		return SoundManager.SetMusicTrack(tracks[previousIndex].Key or SHUFFLE)
	end
	if not shouldPlay() then
		return false
	end
	failures = 0
	retryAt = 0
	-- Mode aléatoire : on recule de deux crans dans l'ordre (nextTrackIndex avance d'un)
	if #order > 0 then
		orderPosition = ((orderPosition - 2) % #order)
	end
	startNext(0.8)
	return true
end

-- Morceau actuel : (nom, Sound) ou (nil, nil) si aucun
function SoundManager.GetCurrentTrack(): (string?, Sound?)
	local track = currentTrack
	if not track or not current then
		return nil, nil
	end
	return trackName(track), current
end

return SoundManager
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="112">
        <Properties>
          <string name="Name">Stimuli</string>
        </Properties>
        <Item class="ModuleScript" referent="113">
          <Properties>
            <string name="Name">Aurora</string>
            <string name="Source"><![CDATA[--[[
	Aurora (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > Aurora

	🌌 Aurore boréale (gains x2, après 2 visites à l'océan) : deux rideaux
	d'aurore pendent du haut du ciel sur toute la largeur de l'écran. Chaque
	rideau est fait de bandes verticales arrondies (les « plis » du rideau :
	violet en haut qui se fond dans le ciel -> turquoise -> ourlet vert
	lumineux et arrondi en bas) qui ondulent lentement, avec quelques
	étoiles au-dessus.
	L'ourlet dessine une arche : juste au-dessus du bouton au centre (jamais
	sur le compteur), il descend le long des couloirs entre les cartes sur
	les côtés : c'est là que le fond se voit en fin de partie.
	Effet d'ambiance (pas de place réservée, sous les cartes). Clair :
	couleurs aquarelle plus profondes ; sombre : couleurs néon.
	≤ 12 images/s, ~63 instances, rien créé par image.
]]

local Cosmos = script.Parent:WaitForChild("Cosmos")
local Kit = require(Cosmos:WaitForChild("Kit"))
local Zones = require(Cosmos:WaitForChild("Zones"))

local Aurora = {}
Aurora.Slot = "Background"

local STARS = 5
local TOP = 22 -- haut des bandes (sous le bandeau d'actualités)
local HEM_CENTRE = 60 -- ourlet au centre : juste au-dessus du bouton
local HEM_DIP = 150 -- de combien l'ourlet descend vers les bords

type Curtain = {
	Count: number,
	Lift: number, -- décalage de l'ourlet (px)
	Amp: number,
	Speed: number,
	Phase: number,
	Widen: number, -- largeur d'une bande / pas
	Frames: { Frame },
	Seeds: { number },
}

local function palette(dark: boolean, index: number): { Color3 }
	-- { haut, milieu, ourlet }
	if dark then
		return if index == 1
			then { Color3.fromRGB(170, 110, 255), Color3.fromRGB(70, 210, 255), Color3.fromRGB(100, 255, 180) }
			else { Color3.fromRGB(255, 110, 210), Color3.fromRGB(140, 120, 255), Color3.fromRGB(110, 240, 255) }
	end
	return if index == 1
		then { Color3.fromRGB(150, 96, 236), Color3.fromRGB(40, 166, 228), Color3.fromRGB(30, 196, 140) }
		else { Color3.fromRGB(230, 90, 186), Color3.fromRGB(120, 100, 236), Color3.fromRGB(40, 190, 220) }
end

function Aurora.Start(ctx)
	Zones.Attach(ctx)
	local random = Random.new()
	local effects = Kit.Effects(ctx)
	local dark = Kit.IsDark(ctx)
	local container: Frame = ctx.Container

	local root: Frame? = nil
	local curtains: { Curtain } = {}
	local stars: { { Frame: Frame, Phase: number } } = {}
	local canvas = Zones.GetCanvas()

	-- Hauteur de l'ourlet à l'abscisse x (arche : haut au centre, bas sur les côtés)
	local function hem(x: number, lift: number): number
		local half = canvas.X / 2
		local ratio = math.clamp(math.abs(x - half) / half, 0, 1)
		return HEM_CENTRE + lift + HEM_DIP * ratio ^ 1.6
	end

	local function build()
		if root then
			root:Destroy()
		end
		table.clear(curtains)
		table.clear(stars)
		canvas = Zones.GetCanvas()
		local holder = Kit.Box(container, { Name = "Aurora", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 })
		root = holder

		local specs = {
			{ Count = 11, Lift = 0, Amp = 10, Speed = 0.45, Widen = 1.35, Alpha = if dark then 0.38 else 0.46 },
			{ Count = 8, Lift = -18, Amp = 8, Speed = -0.32, Widen = 1.1, Alpha = if dark then 0.5 else 0.56 },
		}
		for index, spec in ipairs(specs) do
			local colors = palette(dark, index)
			local curtain: Curtain = {
				Count = spec.Count,
				Lift = spec.Lift,
				Amp = spec.Amp,
				Speed = spec.Speed,
				Phase = random:NextNumber(0, 6),
				Widen = spec.Widen,
				Frames = {},
				Seeds = {},
			}
			-- Bande : haut transparent -> milieu turquoise -> ourlet lumineux arrondi
			local sequence = Kit.Colors({ 0, colors[1], 0.55, colors[2], 1, colors[3] })
			local fade = Kit.Fade({ 0, 1, 0.42, 0.64, 0.84, 0.12, 1, 0.3 })
			for _ = 1, spec.Count do
				local strip = Kit.Box(holder, {
					Name = "Fold",
					AnchorPoint = Vector2.new(0.5, 1),
					Color = Color3.new(1, 1, 1),
					Alpha = spec.Alpha,
					ZIndex = index,
				})
				Kit.Corner(strip, UDim.new(0.5, 0))
				Kit.Gradient(strip, sequence, fade, 90)
				table.insert(curtain.Frames, strip)
				table.insert(curtain.Seeds, random:NextNumber(0, 6))
			end
			table.insert(curtains, curtain)
		end

		-- Étoiles du ciel
		for _ = 1, STARS do
			local star = Kit.Diamond(
				holder,
				random:NextNumber(0.05, 0.95) * canvas.X,
				random:NextNumber(32, 52),
				random:NextInteger(3, 5),
				if dark then Kit.Rgb(255, 255, 255) else Kit.Rgb(255, 190, 80),
				0,
				4
			)
			table.insert(stars, { Frame = star, Phase = random:NextNumber(0, 6) })
		end
	end

	-- Place les bandes le long de l'ourlet (onde qui avance)
	local function layout(t: number)
		local width = canvas.X
		for _, curtain in ipairs(curtains) do
			local step = width / (curtain.Count - 1)
			local phase = curtain.Phase + t * curtain.Speed
			for s, strip in ipairs(curtain.Frames) do
				local seed = curtain.Seeds[s]
				local x = (s - 1) * step + math.sin(t * 0.35 + seed) * step * 0.12
				local bottom = hem(x, curtain.Lift) + math.sin(phase + s * 0.9) * curtain.Amp
				strip.Position = UDim2.fromOffset(x, bottom)
				strip.Size = UDim2.fromOffset(step * curtain.Widen, math.max(24, bottom - TOP - 6 + math.sin(t * 0.8 + seed * 2) * 8))
			end
		end
	end

	build()
	layout(0)
	Kit.WatchTheme(ctx, function(isDark)
		dark = isDark
		build()
		layout(0)
	end)
	ctx.Connect(Zones.Changed, function()
		local now = Zones.GetCanvas()
		if math.abs(now.X - canvas.X) > 1 then
			canvas = now
			layout(0)
		end
	end)

	Kit.Loop(ctx, 12, function(_dt, t)
		if effects then
			layout(t)
		end
		for _, star in ipairs(stars) do
			star.Frame.BackgroundTransparency = 0.2 + 0.7 * (0.5 + 0.5 * math.sin(t * 1.8 + star.Phase))
		end
	end)
end

return Aurora
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="114">
          <Properties>
            <string name="Name">BubbleWrap</string>
            <string name="Source"><![CDATA[--[[
	BubbleWrap (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > BubbleWrap

	v9 : un VRAI papier bulle.
	  - Feuille de plastique translucide (reflets en biais) posée sur un
	    fond de carton ; 8 x 5 bulles en quinconce, centrées.
	  - Chaque bulle est un dôme brillant : ombre douce portée sur la
	    feuille, dôme translucide (bords plus opaques et bleutés = la
	    réfraction du plastique), gros reflet en haut à gauche, petit reflet
	    en bas à droite, liseré clair.
	  - POP : la bulle gonfle sous le doigt puis se dégonfle en rebondissant
	    et se froisse (plus d'ombre, plastique laiteux, deux plis qui se
	    creusent), bouffée d'air, anneau qui s'élargit et petits traits "pop"
	    qui partent en étoile. Les bulles éclatées restent aplaties jusqu'à
	    la feuille suivante.
	  - clic / toucher sur une bulle = POP ; sur PC, maintenir le clic et
	    "glisser" sur les bulles ; au survol, la bulle se soulève un peu ;
	  - chaque bulle éclatée envoie Interact("Bubble"). Le serveur ne renvoie
	    pas de notification : le "+X" affiché est prédit côté client
	    (gain par clic x Config.Interactions.Bubble.ClickFraction) ;
	  - limite côté client (seau de jetons) pour ne jamais dépasser
	    MaxPerSecond : au-delà, la bulle résiste (petit tremblement) ;
	  - quand tout est éclaté : la feuille part, un message apparaît sur le
	    carton, une feuille neuve arrive en glissant, ses bulles se gonflent
	    en vague et un reflet balaie la feuille.
	  - Pastille compteur (en-tête) : bulles éclatées pendant la session ;
	    son remplissage bleu = avancement de la feuille en cours.
	Sons inchangés : "Pop" à chaque bulle éclatée, "Open" à chaque feuille.
	Les bulles et les effets sont créés une seule fois puis réutilisés ;
	UNE boucle OnRender (animations des bulles, effets, vague) qui ne fait
	rien au repos.
]]

local UserInputService = game:GetService("UserInputService")

local Locale = require(game:GetService("ReplicatedStorage").Shared.Locale)

local BubbleWrap = {}
BubbleWrap.Slot = "L2"

local COLUMNS = 8
local ROWS = 5
local DIAMETER = 26
local PITCH_X = 31 -- quinconce : les rangées impaires sont décalées de PITCH_X / 2
local PITCH_Y = 27
local WINDOW_X = 8 -- fenêtre (feuille) dans la carte
local WINDOW_Y = 30
local FX_POOL = 6 -- effets de "pop" recyclés
local BURST_LINES = 6 -- traits "pop" par effet
local POP_TIME = 0.34 -- rebond d'une bulle qui éclate
local INFLATE_TIME = 0.34 -- gonflage d'une bulle neuve
local FX_TIME = 0.42 -- durée d'un effet de pop
local HOVER_SCALE = 1.07
local FLAT_SCALE = 0.88 -- bulle éclatée (aplatie)
local SHEET_PAD = 1 -- la feuille déborde d'1 px de la fenêtre (pas de liseré de carton)

local WHITE = Color3.new(1, 1, 1)

-- Dôme intact : bord haut-gauche blanc, milieu transparent, bord bas-droite bleuté
local DOME_COLOR = Color3.fromRGB(238, 247, 255)
local DOME_TRANSPARENCY = 0.2
local DOME_GRADIENT_COLOR = ColorSequence.new({
	ColorSequenceKeypoint.new(0, WHITE),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(226, 240, 253)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(146, 188, 228)),
})
local DOME_GRADIENT_TRANSPARENCY = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0.02),
	NumberSequenceKeypoint.new(0.35, 0.34),
	NumberSequenceKeypoint.new(0.68, 0.4),
	NumberSequenceKeypoint.new(1, 0),
})
local DOME_STROKE = Color3.fromRGB(160, 200, 236)
local SHADOW_REST = 0.76

-- Bulle éclatée : plastique laiteux, plat, liseré froissé
local FLAT_COLOR = Color3.fromRGB(240, 244, 250)
local FLAT_TRANSPARENCY = 0.42
local FLAT_GRADIENT_COLOR = ColorSequence.new(WHITE, Color3.fromRGB(206, 216, 232))
local FLAT_GRADIENT_TRANSPARENCY = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0.15),
	NumberSequenceKeypoint.new(0.5, 0.45),
	NumberSequenceKeypoint.new(1, 0.2),
})
local FLAT_STROKE = Color3.fromRGB(176, 192, 214)
local WRINKLE_DARK = Color3.fromRGB(138, 160, 192) -- pli (creux)
local WRINKLE_LIGHT = WHITE -- pli (arête qui brille)

-- Trait qui s'estompe aux deux bouts (reflets en biais de la feuille)
local SHEEN = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 1),
	NumberSequenceKeypoint.new(0.5, 0.55),
	NumberSequenceKeypoint.new(1, 1),
})

local CAPTIONS = {
	en = {
		"Again! 🔁",
		"Fresh sheet 📦",
		"Bubble delivery!",
		"Want some more?",
		"Pop pop pop!",
		"That sheet was innocent.",
		"Zero bubble survivors.",
		"It's therapeutic.",
	},
	fr = {
		"Encore ! 🔁",
		"Nouvelle feuille 📦",
		"Livraison de bulles !",
		"Tu en veux encore ?",
		"Pop pop pop !",
		"La feuille était innocente.",
		"Zéro bulle survivante.",
		"C'est thérapeutique.",
	},
}

local function easeOutCubic(t: number): number
	return 1 - (1 - t) ^ 3
end

local function easeOutBack(t: number): number
	local c = 1.9
	return 1 + (c + 1) * (t - 1) ^ 3 + c * (t - 1) ^ 2
end

function BubbleWrap.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local Create = UIUtil.Create
	local container: Frame = ctx.Container
	local random = Random.new()
	local bubbleConfig = ctx.Config.Interactions.Bubble or {}
	local maxPerSecond = bubbleConfig.MaxPerSecond or 12
	local clickFraction = bubbleConfig.ClickFraction or 0.5

	-- Seau de jetons (un peu sous la limite serveur, pour ne jamais être refusé)
	local capacity = math.max(1, math.floor(maxPerSecond * 0.75))
	local refillRate = maxPerSecond * 0.9
	local tokens = capacity
	local lastRefill = os.clock()

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	local function round(guiObject: GuiObject)
		UIUtil.Corner(guiObject, UDim.new(1, 0))
	end

	-- Taille "design" de la carte et de la fenêtre (slot 288 x 180)
	local slotSize = ctx.GetSlotSize and ctx.GetSlotSize() or Vector2.new(288, 180)
	local cardW = (slotSize.X > 0 and slotSize.X or 288) - 4
	local cardH = (slotSize.Y > 0 and slotSize.Y or 180) - 4
	local windowW = cardW - WINDOW_X * 2
	local windowH = cardH - WINDOW_Y - 6

	------------------------------------------------------------------
	-- Carte + en-tête (petite bulle dessinée, titre, pastille compteur)
	------------------------------------------------------------------
	local card = Create("Frame", {
		Name = "Card",
		-- 2 px de marge : le contour de la carte n'est pas coupé par le slot
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -4, 1, -4),
		BackgroundColor3 = Theme.Colors.Card,
		BorderSizePixel = 0,
		Parent = container,
	})
	UIUtil.Corner(card, 18)
	UIUtil.Stroke(card, Theme.Colors.CardBorder, 2)
	UIUtil.Gradient(card, ColorSequence.new(WHITE, Color3.fromRGB(236, 242, 250)), 90)

	-- Icône : une bulle brillante
	local icon = Create("Frame", {
		Name = "Icon",
		Position = UDim2.fromOffset(12, 6),
		Size = UDim2.fromOffset(17, 17),
		BackgroundColor3 = DOME_COLOR,
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = card,
	})
	round(icon)
	Create("UIGradient", { Rotation = 45, Color = DOME_GRADIENT_COLOR, Parent = icon })
	UIUtil.Stroke(icon, Color3.fromRGB(96, 150, 206), 1.5, 0)
	local iconShine = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.34, 0.32),
		Size = UDim2.fromOffset(7, 4),
		Rotation = -40,
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 6,
		Parent = icon,
	})
	round(iconShine)

	UIUtil.Label({
		Name = "Title",
		Text = Locale.T("BUBBLE WRAP"),
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.TextDark,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(35, 4),
		Size = UDim2.fromOffset(150, 22),
		MaxTextSize = 15,
		ZIndex = 5,
		Parent = card,
	})

	-- Pastille : fond clair, remplissage bleu (= avancement de la feuille), compteur
	local pill = Create("Frame", {
		Name = "Counter",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -9, 0, 5),
		Size = UDim2.fromOffset(74, 20),
		BackgroundColor3 = Color3.fromRGB(232, 243, 255),
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = card,
	})
	round(pill)
	UIUtil.Stroke(pill, Color3.fromRGB(96, 150, 206), 1.5, 0)
	local pillScale = Create("UIScale", { Parent = pill })
	local pillFill = Create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = pill,
	})
	round(pillFill)
	UIUtil.Gradient(pillFill, ColorSequence.new(Color3.fromRGB(140, 205, 255), Color3.fromRGB(70, 150, 235)), 0)
	local counterLabel = UIUtil.Label({
		Name = "Count",
		Text = "💥 0",
		Font = Theme.Fonts.Number,
		TextColor3 = Theme.Colors.TextDark,
		Position = UDim2.fromOffset(4, 1),
		Size = UDim2.new(1, -8, 1, -2),
		MaxTextSize = 14,
		ZIndex = 6,
		Parent = pill,
	})

	------------------------------------------------------------------
	-- Fenêtre : carton (visible quand la feuille part) + feuille de plastique
	------------------------------------------------------------------
	local window = Create("Frame", {
		Name = "Window",
		Position = UDim2.fromOffset(WINDOW_X, WINDOW_Y),
		Size = UDim2.new(1, -WINDOW_X * 2, 1, -(WINDOW_Y + 6)),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 2,
		Parent = card,
	})
	UIUtil.Gradient(window, ColorSequence.new(Color3.fromRGB(226, 196, 150), Color3.fromRGB(204, 168, 118)), 90)
	UIUtil.Stroke(window, Color3.fromRGB(150, 176, 206), 1, 0.3)
	-- Lignes du carton ondulé
	for index = 1, 3 do
		Create("Frame", {
			Name = "Groove",
			Position = UDim2.new(0, 0, index / 4, 0),
			Size = UDim2.new(1, 0, 0, 1),
			BackgroundColor3 = Color3.fromRGB(176, 136, 90),
			BackgroundTransparency = 0.6,
			BorderSizePixel = 0,
			ZIndex = 1,
			Parent = window,
		})
	end

	-- Message de fin de feuille (sur le carton)
	local caption = UIUtil.Label({
		Name = "Caption",
		Text = "",
		Font = Enum.Font.LuckiestGuy,
		TextColor3 = Theme.Colors.Blue,
		TextTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -20, 0, 34),
		MaxTextSize = 26,
		ZIndex = 1,
		Parent = window,
	})
	local captionStroke = UIUtil.Stroke(caption, WHITE, 2.5, 1)
	captionStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual

	local sheetRest = UDim2.fromOffset(-SHEET_PAD, -SHEET_PAD)
	local sheet = Create("Frame", {
		Name = "Sheet",
		Position = sheetRest,
		Size = UDim2.new(1, SHEET_PAD * 2, 1, SHEET_PAD * 2),
		BackgroundColor3 = Color3.fromRGB(222, 238, 252),
		BackgroundTransparency = 0.06,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = window,
	})
	UIUtil.Gradient(sheet, ColorSequence.new({
		ColorSequenceKeypoint.new(0, WHITE),
		ColorSequenceKeypoint.new(0.55, Color3.fromRGB(236, 245, 253)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(206, 224, 242)),
	}), 55)

	-- Reflets en biais du plastique (fixes) + un reflet qui balaie la feuille neuve
	local function sheenBand(name: string, x: number, width: number, transparency: number): Frame
		local band = Create("Frame", {
			Name = name,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(x, windowH / 2),
			Size = UDim2.fromOffset(width, windowH * 1.5),
			Rotation = 32,
			BackgroundColor3 = WHITE,
			BackgroundTransparency = transparency,
			BorderSizePixel = 0,
			ZIndex = 3,
			Parent = sheet,
		})
		Create("UIGradient", { Rotation = 90, Color = ColorSequence.new(WHITE), Transparency = SHEEN, Parent = band })
		return band
	end
	sheenBand("Sheen", windowW * 0.28, 22, 0.35)
	sheenBand("Sheen", windowW * 0.36, 7, 0.4)
	sheenBand("Sheen", windowW * 0.78, 14, 0.5)
	local sweep = sheenBand("Sweep", -40, 30, 0.1)
	sweep.Visible = false

	------------------------------------------------------------------
	-- Bulles (créées une fois, réutilisées pour chaque feuille)
	------------------------------------------------------------------
	local bubbles = {}
	local poppedCount = 0
	local sessionPops = 0
	local regenerating = false
	local gridW = (COLUMNS - 1) * PITCH_X + PITCH_X / 2 + DIAMETER
	local gridH = (ROWS - 1) * PITCH_Y + DIAMETER
	local originX = SHEET_PAD + (windowW - gridW) / 2 + DIAMETER / 2
	local originY = SHEET_PAD + (windowH - gridH) / 2 + DIAMETER / 2

	local function bubblePosition(row: number, column: number): (number, number)
		local x = originX + column * PITCH_X + ((row % 2 == 1) and PITCH_X / 2 or 0)
		local y = originY + row * PITCH_Y
		return x, y
	end

	-- Animations en cours (bulles qui éclatent / se gonflent)
	local animating = {}

	local function startAnim(bubble, kind: string, delay: number)
		bubble.Anim = kind
		bubble.AnimT = -delay
		if not bubble.Listed then
			bubble.Listed = true
			table.insert(animating, bubble)
		end
	end

	local function restScale(bubble): number
		return bubble.Hover and HOVER_SCALE or 1
	end

	-- Aspect "dôme intact"
	local function setDomeLook(bubble)
		local button = bubble.Button
		button.BackgroundColor3 = DOME_COLOR
		button.BackgroundTransparency = DOME_TRANSPARENCY
		bubble.Gradient.Color = DOME_GRADIENT_COLOR
		bubble.Gradient.Transparency = DOME_GRADIENT_TRANSPARENCY
		bubble.Stroke.Color = DOME_STROKE
		bubble.Stroke.Transparency = 0.1
		local shadow = bubble.Shadow
		shadow.Position = UDim2.fromOffset(bubble.X + 1.5, bubble.Y + 2.5)
		shadow.BackgroundTransparency = SHADOW_REST
		local highlight = bubble.Highlight
		highlight.Position = UDim2.fromScale(0.34, 0.3)
		highlight.Size = UDim2.fromOffset(9, 5)
		highlight.Rotation = -40
		highlight.BackgroundColor3 = WHITE
		highlight.BackgroundTransparency = 0.02
		local reflex = bubble.Reflex
		reflex.Position = UDim2.fromScale(0.7, 0.74)
		reflex.Size = UDim2.fromOffset(5, 2.5)
		reflex.Rotation = -40
		reflex.BackgroundColor3 = WHITE
		reflex.BackgroundTransparency = 0.45
	end

	-- Aspect "éclatée" : plastique laiteux, deux plis (la longueur des plis est animée)
	local function setFlatLook(bubble)
		local button = bubble.Button
		button.BackgroundColor3 = FLAT_COLOR
		button.BackgroundTransparency = FLAT_TRANSPARENCY
		bubble.Gradient.Color = FLAT_GRADIENT_COLOR
		bubble.Gradient.Transparency = FLAT_GRADIENT_TRANSPARENCY
		bubble.Stroke.Color = FLAT_STROKE
		bubble.Stroke.Transparency = 0.3
		bubble.Shadow.Position = UDim2.fromOffset(bubble.X + 0.5, bubble.Y + 1)
		-- Deux plis presque parallèles, décalés de part et d'autre du centre
		-- (une arête claire, un creux plus sombre) : du plastique froissé
		local angle = random:NextNumber(0, 180)
		local normal = math.rad(angle + 90)
		local shift = random:NextNumber(2.5, 4)
		local highlight = bubble.Highlight
		highlight.Position = UDim2.new(0.5, -math.cos(normal) * shift, 0.5, -math.sin(normal) * shift)
		highlight.Rotation = angle
		highlight.BackgroundColor3 = WRINKLE_LIGHT
		highlight.BackgroundTransparency = 0.05
		local reflex = bubble.Reflex
		reflex.Position = UDim2.new(0.5, math.cos(normal) * shift * 0.8, 0.5, math.sin(normal) * shift * 0.8)
		reflex.Rotation = angle + random:NextNumber(-28, 28)
		reflex.BackgroundColor3 = WRINKLE_DARK
		reflex.BackgroundTransparency = 0.35
		bubble.CreaseA = DIAMETER * random:NextNumber(0.5, 0.64)
		bubble.CreaseB = DIAMETER * random:NextNumber(0.42, 0.56)
	end

	local function setCreases(bubble, amount: number)
		bubble.Highlight.Size = UDim2.fromOffset(math.max(1, bubble.CreaseA * amount), 1.6)
		bubble.Reflex.Size = UDim2.fromOffset(math.max(1, bubble.CreaseB * amount), 1.3)
	end

	-- Vrai si un jeton est disponible (et le consomme)
	local function takeToken(): boolean
		local now = os.clock()
		tokens = math.min(capacity, tokens + (now - lastRefill) * refillRate)
		lastRefill = now
		if tokens >= 1 then
			tokens -= 1
			return true
		end
		return false
	end

	------------------------------------------------------------------
	-- Effets de "pop" : réserve recyclée (anneau, bouffée d'air, traits en
	-- étoile), animée par la boucle (aucune création pendant le jeu)
	------------------------------------------------------------------
	local fxPool = {}
	for index = 1, FX_POOL do
		local ring = Create("Frame", {
			Name = "PopRing",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(DIAMETER, DIAMETER),
			BackgroundTransparency = 1,
			Visible = false,
			ZIndex = 8,
			Parent = sheet,
		})
		round(ring)
		local puff = Create("Frame", {
			Name = "PopPuff",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(DIAMETER, DIAMETER),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Visible = false,
			ZIndex = 7,
			Parent = sheet,
		})
		round(puff)
		local lines = {}
		for line = 1, BURST_LINES do
			local frame = Create("Frame", {
				Name = "PopLine",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(6, 2),
				BackgroundColor3 = (line % 2 == 0) and WHITE or Color3.fromRGB(120, 186, 246),
				BorderSizePixel = 0,
				Visible = false,
				ZIndex = 9,
				Parent = sheet,
			})
			round(frame)
			lines[line] = { Frame = frame, Angle = 0, Reach = 14 }
		end
		fxPool[index] = {
			Ring = ring,
			RingStroke = UIUtil.Stroke(ring, Color3.fromRGB(110, 184, 246), 2, 0.1),
			Puff = puff,
			Lines = lines,
			Full = false,
			Age = 1,
			X = 0,
			Y = 0,
		}
	end
	local nextFx = 1
	local activeFx = 0

	local function popEffects(x: number, y: number)
		local fx = fxPool[nextFx]
		nextFx = nextFx % FX_POOL + 1
		if fx.Age >= 1 then
			activeFx += 1
		end
		fx.Age = 0
		fx.X, fx.Y = x, y
		fx.Full = effectsOn()
		fx.Ring.Position = UDim2.fromOffset(x, y)
		fx.Ring.Size = UDim2.fromOffset(DIAMETER, DIAMETER)
		fx.RingStroke.Transparency = 0.1
		fx.Ring.Visible = true
		fx.Puff.Visible = fx.Full
		local base = random:NextNumber(0, math.pi * 2)
		for index, line in ipairs(fx.Lines) do
			line.Angle = base + (index - 1) * (math.pi * 2 / BURST_LINES) + random:NextNumber(-0.25, 0.25)
			line.Reach = random:NextNumber(11, 17)
			line.Frame.Rotation = math.deg(line.Angle)
			line.Frame.Visible = fx.Full
		end
	end

	local function stepEffects(dt: number)
		if activeFx <= 0 then
			return
		end
		for _, fx in ipairs(fxPool) do
			if fx.Age < 1 then
				fx.Age = math.min(1, fx.Age + dt / FX_TIME)
				local age = fx.Age
				local eased = easeOutCubic(age)
				local size = DIAMETER * (1 + 1.1 * eased)
				fx.Ring.Size = UDim2.fromOffset(size, size)
				fx.RingStroke.Transparency = 0.1 + 0.9 * age
				fx.RingStroke.Thickness = 0.6 + 1.6 * (1 - age)
				if fx.Full then
					local puffAge = math.min(1, age / 0.45)
					local puffSize = DIAMETER * (0.7 + 0.8 * easeOutCubic(puffAge))
					fx.Puff.Size = UDim2.fromOffset(puffSize, puffSize)
					fx.Puff.BackgroundTransparency = 0.3 + 0.7 * puffAge
					for _, line in ipairs(fx.Lines) do
						local reach = DIAMETER * 0.5 + line.Reach * eased
						line.Frame.Position = UDim2.fromOffset(fx.X + math.cos(line.Angle) * reach, fx.Y + math.sin(line.Angle) * reach)
						line.Frame.Size = UDim2.fromOffset(1.5 + 6 * (1 - age), 2)
						line.Frame.BackgroundTransparency = age ^ 1.5
					end
				end
				if fx.Age >= 1 then
					fx.Ring.Visible = false
					fx.Puff.Visible = false
					for _, line in ipairs(fx.Lines) do
						line.Frame.Visible = false
					end
					activeFx -= 1
				end
			end
		end
	end

	------------------------------------------------------------------
	-- Pop !
	------------------------------------------------------------------
	local regenerate -- (déclarée plus bas)

	local function updateCounter()
		counterLabel.Text = "💥 " .. tostring(sessionPops)
		local total = math.max(1, #bubbles)
		UIUtil.Tween(pillFill, 0.18, { Size = UDim2.fromScale(math.clamp(poppedCount / total, 0, 1), 1) }, Enum.EasingStyle.Quad)
	end

	local function pop(bubble)
		if bubble.Popped or regenerating or not ctx.IsAlive() then
			return
		end
		if not takeToken() then
			-- Trop vite : la bulle résiste
			if bubble.Anim == nil then
				bubble.Scale.Scale = 0.9
				UIUtil.Tween(bubble.Scale, 0.2, { Scale = restScale(bubble) }, Enum.EasingStyle.Back)
			end
			return
		end
		bubble.Popped = true
		bubble.Hover = false
		poppedCount += 1
		sessionPops += 1

		ctx.Interact("Bubble")
		ctx.Sound.Play("Pop", random:NextNumber(0.9, 1.35))

		-- Gonfle sous le doigt, éclate, se dégonfle en rebondissant et se froisse
		setFlatLook(bubble)
		setCreases(bubble, 0)
		bubble.Scale.Scale = 1.2
		startAnim(bubble, "Pop", 0)
		popEffects(bubble.X, bubble.Y)

		-- "+X" prédit
		local data = ctx.State.Data
		local value = (data and tonumber(data.ClickValue) or 0) * clickFraction
		if value > 0 then
			local sheetOffset = sheet.Position.X.Offset
			ctx.FloatText(
				container,
				UDim2.fromOffset(2 + WINDOW_X + sheetOffset + bubble.X, 2 + WINDOW_Y - SHEET_PAD + bubble.Y - 12),
				"+" .. ctx.Format.Format(value),
				Theme.Colors.Blue,
				18
			)
		end

		updateCounter()
		pillScale.Scale = 1.14
		UIUtil.Tween(pillScale, 0.22, { Scale = 1 }, Enum.EasingStyle.Back)

		if poppedCount >= #bubbles then
			regenerate()
		end
	end

	for row = 0, ROWS - 1 do
		for column = 0, COLUMNS - 1 do
			local x, y = bubblePosition(row, column)
			-- Ombre douce portée sur la feuille
			local shadow = Create("Frame", {
				Name = "BubbleShadow",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(x + 1.5, y + 2.5),
				Size = UDim2.fromOffset(DIAMETER, DIAMETER),
				BackgroundColor3 = Color3.fromRGB(70, 104, 146),
				BackgroundTransparency = SHADOW_REST,
				BorderSizePixel = 0,
				ZIndex = 4,
				Parent = sheet,
			})
			round(shadow)
			-- Dôme (le bouton)
			local button = Create("TextButton", {
				Name = "Bubble",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(x, y),
				Size = UDim2.fromOffset(DIAMETER, DIAMETER),
				BackgroundColor3 = DOME_COLOR,
				BackgroundTransparency = DOME_TRANSPARENCY,
				AutoButtonColor = false,
				Text = "",
				ZIndex = 5,
				Parent = sheet,
			})
			round(button)
			local gradient = Create("UIGradient", { Rotation = 45, Color = DOME_GRADIENT_COLOR, Parent = button })
			local stroke = UIUtil.Stroke(button, DOME_STROKE, 1, 0.1)
			local scale = Create("UIScale", { Parent = button })
			local highlight = Create("Frame", {
				Name = "Highlight",
				AnchorPoint = Vector2.new(0.5, 0.5),
				BorderSizePixel = 0,
				ZIndex = 6,
				Parent = button,
			})
			round(highlight)
			local reflex = Create("Frame", {
				Name = "Reflex",
				AnchorPoint = Vector2.new(0.5, 0.5),
				BorderSizePixel = 0,
				ZIndex = 6,
				Parent = button,
			})
			round(reflex)
			local bubble = {
				Button = button,
				Gradient = gradient,
				Stroke = stroke,
				Scale = scale,
				Shadow = shadow,
				Highlight = highlight,
				Reflex = reflex,
				X = x,
				Y = y,
				Row = row,
				Column = column,
				Popped = false,
				Hover = false,
				Anim = nil :: string?,
				AnimT = 0,
				Listed = false,
				CreaseA = DIAMETER * 0.66,
				CreaseB = DIAMETER * 0.42,
			}
			setDomeLook(bubble)
			table.insert(bubbles, bubble)

			ctx.Connect(button.MouseButton1Down, function()
				pop(bubble)
			end)
			-- Glisser en maintenant le clic (souris) ; sinon la bulle se soulève
			ctx.Connect(button.MouseEnter, function()
				if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
					pop(bubble)
				elseif not bubble.Popped then
					bubble.Hover = true
					if bubble.Anim == nil then
						bubble.Scale.Scale = HOVER_SCALE
					end
				end
			end)
			ctx.Connect(button.MouseLeave, function()
				if bubble.Hover then
					bubble.Hover = false
					if bubble.Anim == nil and not bubble.Popped then
						bubble.Scale.Scale = 1
					end
				end
			end)
		end
	end

	-- Avance les animations des bulles (rebond du pop, gonflage)
	local function stepBubbles(dt: number)
		if #animating == 0 then
			return
		end
		local index = 1
		while index <= #animating do
			local bubble = animating[index]
			local finished = false
			bubble.AnimT += dt
			local t = bubble.AnimT
			if bubble.Anim == "Pop" then
				if t >= POP_TIME then
					bubble.Scale.Scale = FLAT_SCALE
					setCreases(bubble, 1)
					bubble.Shadow.BackgroundTransparency = 0.94
					finished = true
				else
					-- Rebond amorti autour de la taille "aplatie"
					bubble.Scale.Scale = FLAT_SCALE + (1.2 - FLAT_SCALE) * math.exp(-t * 13) * math.cos(t * 27)
					setCreases(bubble, math.clamp((t - 0.03) / 0.12, 0, 1))
					bubble.Shadow.BackgroundTransparency = SHADOW_REST + (0.94 - SHADOW_REST) * math.clamp(t / 0.12, 0, 1)
				end
			elseif bubble.Anim == "Inflate" then
				if t >= INFLATE_TIME then
					setDomeLook(bubble)
					bubble.Scale.Scale = restScale(bubble)
					finished = true
				elseif t >= 0 then
					local p = t / INFLATE_TIME
					bubble.Scale.Scale = 0.3 + 0.7 * easeOutBack(p)
					bubble.Highlight.BackgroundTransparency = 1 - 0.98 * p
					bubble.Reflex.BackgroundTransparency = 1 - 0.55 * p
					bubble.Shadow.BackgroundTransparency = 1 - (1 - SHADOW_REST) * p
				end
			else
				finished = true
			end
			if finished then
				bubble.Anim = nil
				bubble.Listed = false
				animating[index] = animating[#animating]
				animating[#animating] = nil
			else
				index += 1
			end
		end
	end

	------------------------------------------------------------------
	-- Nouvelle feuille
	------------------------------------------------------------------
	local sweepAge = -1 -- < 0 : pas de reflet qui balaie

	regenerate = function()
		if regenerating then
			return
		end
		regenerating = true
		task.spawn(function()
			task.wait(0.35)
			if not ctx.IsAlive() then
				return
			end
			-- Message sur le carton, visible pendant que la feuille glisse
			local captions = Locale.Pick(CAPTIONS)
			caption.Text = captions[random:NextInteger(1, #captions)]
			caption.TextTransparency = 0
			captionStroke.Transparency = 0
			UIUtil.Tween(sheet, 0.35, { Position = UDim2.fromOffset(-(windowW + 10), -SHEET_PAD) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			ctx.Sound.Play("Open", 0.9)
			task.wait(0.75)
			if not ctx.IsAlive() then
				return
			end
			-- Feuille neuve : bulles "à plat", elles se gonflent en vague en arrivant
			for _, bubble in ipairs(bubbles) do
				bubble.Popped = false
				bubble.Hover = false
				setDomeLook(bubble)
				bubble.Scale.Scale = 0.3
				bubble.Highlight.BackgroundTransparency = 1
				bubble.Reflex.BackgroundTransparency = 1
				bubble.Shadow.BackgroundTransparency = 1
				startAnim(bubble, "Inflate", 0.16 + bubble.Column * 0.035 + bubble.Row * 0.025)
			end
			poppedCount = 0
			updateCounter()
			sheet.Position = UDim2.fromOffset(windowW + 10, -SHEET_PAD)
			UIUtil.Tween(sheet, 0.45, { Position = sheetRest }, Enum.EasingStyle.Back)
			UIUtil.Tween(caption, 0.3, { TextTransparency = 1 })
			UIUtil.Tween(captionStroke, 0.3, { Transparency = 1 })
			sweepAge = -0.3
			task.wait(0.45)
			regenerating = false
		end)
	end

	------------------------------------------------------------------
	-- Boucle : animations des bulles, effets, reflet qui balaie, et petite
	-- vague de "respiration" des bulles intactes (pour donner envie),
	-- seulement si le papier bulle est visible.
	------------------------------------------------------------------
	local WAVE_STEP = 0.04 -- décalage par colonne
	local WAVE_TIME = 0.3
	local waveAge = -1 -- < 0 : pas de vague en cours
	local nextWave = os.clock() + random:NextNumber(4, 7)

	ctx.OnRender(function(dt: number)
		stepEffects(dt)
		stepBubbles(dt)

		if sweepAge > -0.5 then
			sweepAge += dt
			if sweepAge >= 0.7 then
				sweepAge = -1
				sweep.Visible = false
			elseif sweepAge >= 0 then
				sweep.Visible = true
				sweep.Position = UDim2.fromOffset(-40 + (windowW + 80) * easeOutCubic(sweepAge / 0.7), windowH / 2)
			end
		end

		local now = os.clock()
		if waveAge < 0 then
			if now >= nextWave then
				nextWave = now + random:NextNumber(4, 7)
				if not regenerating and ctx.GetVisibility() == "Visible" then
					waveAge = 0
				end
			end
			return
		end
		waveAge += dt
		local finished = true
		for index, bubble in ipairs(bubbles) do
			if not bubble.Popped and bubble.Anim == nil then
				local t = waveAge - ((index - 1) % COLUMNS) * WAVE_STEP
				local rest = restScale(bubble)
				if t < WAVE_TIME then
					finished = false
					if t >= 0 then
						bubble.Scale.Scale = rest + 0.07 * math.sin(t / WAVE_TIME * math.pi)
					end
				elseif bubble.Scale.Scale ~= rest then
					bubble.Scale.Scale = rest
				end
			end
		end
		if finished then
			waveAge = -1
		end
	end)
end

function BubbleWrap.Stop(_ctx)
	-- Tout est dans ctx.Container (détruit par le StimulusManager)
end

return BubbleWrap
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="115">
          <Properties>
            <string name="Name">Casino</string>
            <string name="Source"><![CDATA[--[[
	Casino (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > Casino

	🎰 Machine chanceuse (slot R2, 288x180) : des tours GRATUITS, jamais de
	mise. Un jeton s'obtient toutes les Config.Casino.TokenInterval secondes
	de jeu (max MaxTokens) ; chaque tour en coûte un et rapporte des
	SECONDES de production (paire, triple, ou petit lot de consolation).
	  - carrosserie bordeaux laquée, liseré or, fronton "LUCKY MACHINE" et
	    ampoules en chenillard (autour de la vitrine aussi) qui s'affolent
	    en arc-en-ciel quand on gagne ;
	  - 3 rouleaux en verre bombé : flou de mouvement pendant la rotation
	    (symboles fantômes + traînées), arrêt élastique un par un ;
	  - levier chromé (on peut le tirer) ;
	  - compteur de jetons + jauge de recharge et minuteur ("+1 dans 0:42") ;
	  - écran LED (messages) + bouton "📜 Gains" : table des gains avec la
	    valeur RÉELLE de chaque combinaison (selon ta production actuelle) ;
	  - gain : halo des symboles gagnants, pièces qui tombent ; gros lot :
	    bannière à rayons tournants, flash, confettis.
	Le résultat vient TOUJOURS du serveur (CasinoSpin) ; le client prédit
	seulement la jauge de recharge entre deux états (State.Data.Casino).
	Fermée (State.Data.CasinoEnabled = false) : pancarte "FERMÉ".
]]

local Casino = {}
Casino.Slot = "R2"

local Locale = require(game:GetService("ReplicatedStorage").Shared.Locale)

-- Dimensions (pixels "design") : la carrosserie est rentrée de 2 px pour
-- que son contour ne soit pas coupé par le slot
local W = 284
local H = 176

-- Vitrine des rouleaux (intérieur) et son cadre chromé à ampoules
local WINDOW_X, WINDOW_Y = 13, 35
local WINDOW_W, WINDOW_H = 204, 68
local CHROME_PAD = 7
local REEL_GAP = 4
local REEL_W = math.floor((WINDOW_W - 8 - REEL_GAP * 2) / 3)
local REEL_H = WINDOW_H - 8
local CELL_H = 40 -- hauteur d'un symbole sur le rouleau
local STRIP_LENGTH = 24 -- symboles par bande (recyclés en boucle)
local MAX_SPEED = 22 -- symboles / seconde
local BLUR_SPEED = 7 -- au-delà : flou de mouvement
local MIN_SPIN_TIME = 0.8

local LED_Y = 115
local ROW_Y = 135
local ROW_H = 37
local MAX_COINS = 12

local GOLD = Color3.fromRGB(255, 200, 60)
local GOLD_LIGHT = Color3.fromRGB(255, 240, 170)
local GOLD_DARK = Color3.fromRGB(170, 110, 20)
local CHROME_LIGHT = Color3.fromRGB(250, 250, 255)
local CHROME_DARK = Color3.fromRGB(120, 124, 138)
local LACQUER_TOP = Color3.fromRGB(196, 28, 58)
local LACQUER_BOTTOM = Color3.fromRGB(92, 6, 28)
local LED_BG = Color3.fromRGB(22, 6, 10)
local LED_TEXT = Color3.fromRGB(255, 176, 60)
local WHITE = Color3.new(1, 1, 1)
local BAD = Color3.fromRGB(255, 150, 150)

local MISS_TEXTS = {
	en = {
		"Nothing lined up… a little consolation 🍬",
		"Almost! Here's a tiny treat 🍭",
		"The reels were shy this time 🙈",
		"No match, but never empty-handed ✨",
		"Warm-up spin! 🔥",
	},
	fr = {
		"Rien d'aligné… un petit lot de consolation 🍬",
		"Presque ! Voilà une petite douceur 🍭",
		"Les rouleaux étaient timides 🙈",
		"Pas de paire, mais jamais les mains vides ✨",
		"Tour d'échauffement ! 🔥",
	},
}

local WIN_TEXTS = {
	en = {
		"WINNER! 🎉",
		"Lucky you! 🍀",
		"Lady Luck is smiling 😎",
		"Dopamine waterfall! 🤑",
	},
	fr = {
		"GAGNÉ ! 🎉",
		"Quelle chance ! 🍀",
		"La chance te sourit 😎",
		"Dopamine en cascade ! 🤑",
	},
}

local ATTRACT_TEXTS = {
	en = {
		"Free spins, no bet! 🍀",
		"Every spin wins something ✨",
		"Tap 📜 to see the prizes",
		"Pull the lever! 🕹️",
	},
	fr = {
		"Tours gratuits, aucune mise ! 🍀",
		"Chaque tour rapporte quelque chose ✨",
		"Touche 📜 pour voir les gains",
		"Tire le levier ! 🕹️",
	},
}

-- Recul "Back" plus doux que la version standard (petit rebond à l'arrêt)
local function easeOutSoftBack(t: number): number
	local c1 = 0.9
	local c3 = c1 + 1
	local u = t - 1
	return 1 + c3 * u * u * u + c1 * u * u
end

local function clockText(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

function Casino.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local Create = UIUtil.Create
	local Format = ctx.Format
	local config = ctx.Config.Casino
	local symbols = config.Symbols
	local symbolsById = ctx.Config.CasinoSymbolsById
	local container: Frame = ctx.Container
	local random = Random.new()

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	-- Visible à l'écran ? (ctx.IsVisible si le manager le fournit)
	local function isVisible(): boolean
		local fn = ctx.IsVisible
		if type(fn) == "function" then
			local ok, result = pcall(fn)
			return not ok or result ~= false
		end
		return true
	end

	-- Petits constructeurs
	local function frame(props: { [string]: any }): Frame
		props.BorderSizePixel = 0
		if props.BackgroundTransparency == nil and props.BackgroundColor3 == nil then
			props.BackgroundTransparency = 1
		end
		return Create("Frame", props)
	end

	local function round(guiObject: Instance, radius: number?)
		UIUtil.Corner(guiObject, radius and UDim.new(0, radius) or UDim.new(1, 0))
	end

	local function vGradient(parent: Instance, keypoints: { { number | Color3 } }, rotation: number?): UIGradient
		local list = {}
		for _, point in ipairs(keypoints) do
			table.insert(list, ColorSequenceKeypoint.new(point[1] :: number, point[2] :: Color3))
		end
		return UIUtil.Gradient(parent, ColorSequence.new(list), rotation or 90)
	end

	local function fade(parent: Instance, points: { { number } }, rotation: number?): UIGradient
		local list = {}
		for _, point in ipairs(points) do
			table.insert(list, NumberSequenceKeypoint.new(point[1], point[2]))
		end
		return Create("UIGradient", { Rotation = rotation or 90, Transparency = NumberSequence.new(list), Parent = parent })
	end

	-- Contour doré dégradé (UIGradient sous l'UIStroke)
	local function goldStroke(parent: Instance, thickness: number): UIStroke
		local stroke = UIUtil.Stroke(parent, WHITE, thickness, 0)
		vGradient(stroke, { { 0, GOLD_LIGHT }, { 0.45, GOLD }, { 1, GOLD_DARK } }, 90)
		return stroke
	end

	-- Gain estimé (en Dopamine) pour `seconds` de production, avec les stats actuelles
	local function rewardFor(seconds: number): number
		local data = ctx.State.Data
		local stats = {
			PerSecond = (data and tonumber(data.PerSecond)) or 0,
			ClickValue = (data and tonumber(data.ClickValue)) or 0,
		}
		local missSeconds = math.max(1, config.MissRewardSeconds or 1)
		local minimum = (config.MinReward or 0) * math.max(1, seconds / missSeconds)
		local ok, amount = pcall(ctx.Formulas.ScaledReward, stats, seconds, minimum)
		return ok and amount or minimum
	end

	------------------------------------------------------------------
	-- Carrosserie
	------------------------------------------------------------------
	local card = frame({
		Name = "Machine",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(W, H),
		BackgroundColor3 = WHITE,
		ZIndex = 1,
		Parent = container,
	})
	round(card, 18)
	vGradient(card, { { 0, LACQUER_TOP }, { 0.55, Color3.fromRGB(150, 16, 44) }, { 1, LACQUER_BOTTOM } })
	goldStroke(card, 2)

	-- Reflet laqué (bande claire en haut)
	local sheen = frame({
		Name = "Sheen",
		Size = UDim2.new(1, -8, 0.42, 0),
		Position = UDim2.fromOffset(4, 3),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.88,
		ZIndex = 1,
		Parent = card,
	})
	round(sheen, 15)
	fade(sheen, { { 0, 0.2 }, { 1, 1 } })

	------------------------------------------------------------------
	-- Fronton : titre doré + ampoules
	------------------------------------------------------------------
	local marquee = frame({
		Name = "Marquee",
		Position = UDim2.fromOffset(7, 5),
		Size = UDim2.fromOffset(W - 14, 24),
		BackgroundColor3 = WHITE,
		ZIndex = 2,
		Parent = card,
	})
	round(marquee, 9)
	vGradient(marquee, { { 0, Color3.fromRGB(64, 8, 24) }, { 1, Color3.fromRGB(26, 2, 10) } })
	goldStroke(marquee, 1.5)

	local titleLabel = UIUtil.Label({
		Name = "Title",
		Text = Locale.T("⭐ LUCKY MACHINE ⭐"),
		Font = Theme.Fonts.Title,
		TextColor3 = WHITE,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(170, 20),
		MaxTextSize = 17,
		ZIndex = 4,
		Parent = marquee,
	})
	local titleGradient = vGradient(titleLabel, { { 0, GOLD_LIGHT }, { 0.5, GOLD }, { 1, Color3.fromRGB(230, 140, 20) } })
	local titleStroke = UIUtil.Stroke(titleLabel, Color3.fromRGB(70, 20, 0), 1.2, 0)
	titleStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	local titleScale = Create("UIScale", { Parent = titleLabel })

	-- Ampoules : une seule Frame chacune, le "halo" est son UIStroke
	local bulbs: { { Frame: Frame, Stroke: UIStroke, Order: number } } = {}
	local function addBulb(parent: Instance, x: number, y: number, size: number, order: number)
		local bulb = frame({
			Name = "Bulb",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(x, y),
			Size = UDim2.fromOffset(size, size),
			BackgroundColor3 = GOLD,
			ZIndex = 4,
			Parent = parent,
		})
		round(bulb)
		local stroke = UIUtil.Stroke(bulb, GOLD, 2, 0.55)
		table.insert(bulbs, { Frame = bulb, Stroke = stroke, Order = order })
	end
	-- Fronton : 4 de chaque côté du titre
	local marqueeW = W - 14
	for k = 0, 3 do
		addBulb(marquee, 10 + k * 11, 12, 5, k)
		addBulb(marquee, marqueeW - 10 - k * 11, 12, 5, k)
	end

	------------------------------------------------------------------
	-- Vitrine : cadre chromé (avec ampoules) + verre
	------------------------------------------------------------------
	local chrome = frame({
		Name = "Chrome",
		Position = UDim2.fromOffset(WINDOW_X - CHROME_PAD, WINDOW_Y - CHROME_PAD),
		Size = UDim2.fromOffset(WINDOW_W + CHROME_PAD * 2, WINDOW_H + CHROME_PAD * 2),
		BackgroundColor3 = WHITE,
		ZIndex = 2,
		Parent = card,
	})
	round(chrome, 12)
	vGradient(chrome, { { 0, CHROME_LIGHT }, { 0.35, Color3.fromRGB(190, 194, 206) }, { 0.5, CHROME_DARK }, { 0.7, Color3.fromRGB(210, 214, 224) }, { 1, Color3.fromRGB(150, 154, 168) } })
	UIUtil.Stroke(chrome, Color3.fromRGB(50, 10, 20), 1, 0.2)
	-- Ampoules dans le cadre (haut et bas), numérotées dans le sens du chenillard
	local chromeW = WINDOW_W + CHROME_PAD * 2
	local chromeH = WINDOW_H + CHROME_PAD * 2
	local bulbCount = 12
	for k = 0, bulbCount - 1 do
		local x = 12 + k * (chromeW - 24) / (bulbCount - 1)
		addBulb(chrome, x, 3.5, 4, k)
		addBulb(chrome, chromeW - x, chromeH - 3.5, 4, bulbCount + k)
	end
	-- Ordre du chenillard
	table.sort(bulbs, function(a, b)
		return a.Order < b.Order
	end)

	local window = frame({
		Name = "Window",
		Position = UDim2.fromOffset(WINDOW_X, WINDOW_Y),
		Size = UDim2.fromOffset(WINDOW_W, WINDOW_H),
		BackgroundColor3 = Color3.fromRGB(16, 4, 8),
		ZIndex = 3,
		Parent = card,
	})
	round(window, 8)
	local windowStroke = UIUtil.Stroke(window, GOLD, 1.5, 0.3)

	local reels = {}
	local function wrap(index: number): number
		return ((index - 1) % STRIP_LENGTH) + 1
	end

	for r = 1, 3 do
		local reelFrame = frame({
			Name = "Reel" .. r,
			Position = UDim2.fromOffset(4 + (r - 1) * (REEL_W + REEL_GAP), 4),
			Size = UDim2.fromOffset(REEL_W, REEL_H),
			BackgroundColor3 = WHITE,
			ClipsDescendants = true,
			ZIndex = 4,
			Parent = window,
		})
		round(reelFrame, 6)
		-- Cylindre : ivoire au centre, plus sombre en haut / en bas
		vGradient(reelFrame, {
			{ 0, Color3.fromRGB(160, 150, 140) },
			{ 0.28, Color3.fromRGB(240, 234, 222) },
			{ 0.5, Color3.fromRGB(255, 253, 246) },
			{ 0.72, Color3.fromRGB(240, 234, 222) },
			{ 1, Color3.fromRGB(160, 150, 140) },
		})

		-- Halo de victoire derrière le symbole du milieu
		local glow = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(REEL_W / 2, REEL_H / 2),
			Size = UDim2.fromOffset(REEL_W - 4, CELL_H - 2),
			BackgroundColor3 = GOLD,
			BackgroundTransparency = 1,
			ZIndex = 4,
			Parent = reelFrame,
		})
		round(glow, 8)
		fade(glow, { { 0, 0.6 }, { 0.5, 0 }, { 1, 0.6 } }, 0)

		-- Bande de symboles (mélangés)
		local strip = {}
		for i = 1, STRIP_LENGTH do
			strip[i] = symbols[((i - 1) % #symbols) + 1].Id
		end
		for i = STRIP_LENGTH, 2, -1 do
			local j = random:NextInteger(1, i)
			strip[i], strip[j] = strip[j], strip[i]
		end

		-- 4 symboles visibles (recyclés) + 2 "fantômes" chacun pour le flou
		local labels = {}
		for k = 1, 4 do
			local label = UIUtil.Label({
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(REEL_W, CELL_H - 6),
				Position = UDim2.fromOffset(REEL_W / 2, REEL_H / 2),
				Font = Theme.Fonts.Title,
				MaxTextSize = 30,
				ZIndex = 5,
				Parent = reelFrame,
			})
			local ghosts = {}
			for g = -1, 1, 2 do
				local ghost = UIUtil.Label({
					AnchorPoint = Vector2.new(0.5, 0.5),
					Size = UDim2.fromScale(1, 1),
					Position = UDim2.new(0.5, 0, 0.5, g * CELL_H * 0.22),
					Font = Theme.Fonts.Title,
					MaxTextSize = 30,
					TextTransparency = 0.72,
					Visible = false,
					ZIndex = 5,
					Parent = label,
				})
				table.insert(ghosts, ghost)
			end
			labels[k] = { Label = label, Ghosts = ghosts, Shown = "" }
		end

		-- Traînées de mouvement (visibles seulement à grande vitesse)
		local streaks = frame({
			Name = "Streaks",
			Size = UDim2.fromScale(1, 1),
			Visible = false,
			ZIndex = 6,
			Parent = reelFrame,
		})
		for s = 1, 3 do
			local line = frame({
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.new(s / 4, 0, 0, 0),
				Size = UDim2.new(0, 2, 1, 0),
				BackgroundColor3 = WHITE,
				BackgroundTransparency = 0.55,
				ZIndex = 6,
				Parent = streaks,
			})
			fade(line, { { 0, 1 }, { 0.5, 0.2 }, { 1, 1 } })
		end
		local tint = frame({
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.fromRGB(255, 250, 235),
			BackgroundTransparency = 0.55,
			ZIndex = 6,
			Parent = streaks,
		})
		fade(tint, { { 0, 0.3 }, { 0.5, 0.8 }, { 1, 0.3 } })

		-- Ombre intérieure (haut / bas) pour la profondeur
		local shade = frame({
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.new(0, 0, 0),
			ZIndex = 7,
			Parent = reelFrame,
		})
		fade(shade, { { 0, 0.15 }, { 0.25, 0.85 }, { 0.5, 1 }, { 0.75, 0.85 }, { 1, 0.15 } })
		-- Reflet de la vitre (bande blanche en haut)
		local glass = frame({
			Position = UDim2.fromOffset(3, 2),
			Size = UDim2.new(1, -6, 0, 13),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.55,
			ZIndex = 8,
			Parent = reelFrame,
		})
		round(glass, 5)
		fade(glass, { { 0, 0.1 }, { 1, 1 } })

		reels[r] = {
			Frame = reelFrame,
			Glow = glow,
			Strip = strip,
			Labels = labels,
			Streaks = streaks,
			Blurred = false,
			Pos = random:NextInteger(1, STRIP_LENGTH),
			Speed = 0,
			Mode = "idle", -- "idle" | "spin" | "stop"
			StopFrom = 0,
			StopTo = 0,
			StopT = 0,
			StopDur = 1,
			Scale = Create("UIScale", { Parent = reelFrame }),
		}
	end

	-- Séparateurs chromés entre les rouleaux
	for r = 1, 2 do
		local separator = frame({
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromOffset(4 + r * (REEL_W + REEL_GAP) - REEL_GAP / 2, 3),
			Size = UDim2.fromOffset(3, WINDOW_H - 6),
			BackgroundColor3 = WHITE,
			ZIndex = 9,
			Parent = window,
		})
		round(separator, 2)
		UIUtil.Gradient(separator, ColorSequence.new(CHROME_LIGHT, CHROME_DARK), 0)
	end

	-- Ligne de gain : halo + trait + flèches
	local paylineGlow = frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -4, 0, 12),
		BackgroundColor3 = Color3.fromRGB(255, 70, 70),
		BackgroundTransparency = 0.5,
		ZIndex = 9,
		Parent = window,
	})
	fade(paylineGlow, { { 0, 1 }, { 0.5, 0.2 }, { 1, 1 } })
	local payline = frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -4, 0, 2),
		BackgroundColor3 = Color3.fromRGB(255, 60, 60),
		BackgroundTransparency = 0.25,
		ZIndex = 10,
		Parent = window,
	})
	local arrows = {}
	for side = 0, 1 do
		-- (triangles DESSINÉS : ▶ ◀ n'existent pas dans les polices Roblox)
		local arrow = UIUtil.Icon(side == 0 and "Right" or "Left", {
			Size = 11,
			Color = GOLD,
			AnchorPoint = Vector2.new(side, 0.5),
			Position = UDim2.new(side, side == 0 and -8 or 8, 0.5, 0),
			ZIndex = 10,
			Parent = window,
		})
		table.insert(arrows, arrow)
	end

	-- Affiche la bande d'un rouleau selon sa position (symbole `Pos` au centre)
	local function renderReel(reel)
		local base = math.floor(reel.Pos)
		local blur = reel.Speed > BLUR_SPEED
		local blurChanged = blur ~= reel.Blurred
		reel.Blurred = blur
		if blurChanged then
			reel.Streaks.Visible = blur
		end
		for k = 1, 4 do
			local index = base - 1 + (k - 1)
			local entry = reel.Labels[k]
			local label = entry.Label
			local id = reel.Strip[wrap(index)]
			if entry.Shown ~= id then
				entry.Shown = id
				local symbol = symbolsById[id]
				local icon = symbol and symbol.Icon or "?"
				label.Text = icon
				for _, ghost in ipairs(entry.Ghosts) do
					ghost.Text = icon
				end
			end
			-- Les indices plus grands sont au-dessus : la bande descend
			label.Position = UDim2.fromOffset(REEL_W / 2, REEL_H / 2 - (index - reel.Pos) * CELL_H)
			if blurChanged then
				label.TextTransparency = blur and 0.38 or 0
				for _, ghost in ipairs(entry.Ghosts) do
					ghost.Visible = blur
				end
			end
		end
	end

	for _, reel in ipairs(reels) do
		renderReel(reel)
	end

	------------------------------------------------------------------
	-- Levier chromé
	------------------------------------------------------------------
	local leverX = WINDOW_X + WINDOW_W + CHROME_PAD + (W - (WINDOW_X + WINDOW_W + CHROME_PAD)) / 2
	local leverBottom = 96
	local knobTop = 44
	local stickLength = leverBottom - knobTop

	-- Rainure (où le levier descend) et support chromé
	local groove = frame({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromOffset(leverX, knobTop - 4),
		Size = UDim2.fromOffset(10, leverBottom - knobTop + 8),
		BackgroundColor3 = Color3.fromRGB(40, 4, 14),
		BackgroundTransparency = 0.35,
		ZIndex = 2,
		Parent = card,
	})
	round(groove, 5)
	local mount = frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(leverX, leverBottom + 4),
		Size = UDim2.fromOffset(30, 20),
		BackgroundColor3 = WHITE,
		ZIndex = 3,
		Parent = card,
	})
	round(mount, 6)
	vGradient(mount, { { 0, CHROME_LIGHT }, { 0.5, Color3.fromRGB(170, 174, 188) }, { 1, CHROME_DARK } })
	UIUtil.Stroke(mount, Color3.fromRGB(40, 8, 16), 1, 0.3)
	local mountSlot = frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(8, 12),
		BackgroundColor3 = Color3.fromRGB(30, 30, 36),
		ZIndex = 4,
		Parent = mount,
	})
	round(mountSlot, 4)

	local stick = frame({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromOffset(leverX, leverBottom + 2),
		Size = UDim2.fromOffset(6, stickLength),
		BackgroundColor3 = WHITE,
		ZIndex = 5,
		Parent = card,
	})
	round(stick, 3)
	UIUtil.Gradient(stick, ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(150, 154, 168)),
		ColorSequenceKeypoint.new(0.35, CHROME_LIGHT),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(110, 114, 128)),
	}), 0)

	local knob = frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(leverX, knobTop),

		["An animated frame around your avatar"] = "Un cadre animé autour de ton avatar",

		-- Boutique Robux : onglets, sections, cartes
		["♾️ Passes"] = "♾️ Passes",
		["💧 Dopamine"] = "💧 Dopamine",
		["⚡ Boosts"] = "⚡ Boosts",

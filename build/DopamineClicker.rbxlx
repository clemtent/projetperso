	})
	local versionChip = UIUtil.Chip({
		Name = "Version",
		Text = Locale.T("Version %s", VERSION),
		Color = SECTION_GAME,
		TextColor3 = Theme.Colors.TextLight,
		Height = 26,
		TextSize = 13,
		Parent = credits,
	})
	versionChip.AnchorPoint = Vector2.new(1, 0.5)
	versionChip.Position = UDim2.new(1, -12, 0.5, 0)
end

function Settings.Build(panel: Frame)
	-- Contenu défilant (tout ne tient pas toujours en hauteur)
	local content = UIUtil.Create("ScrollingFrame", {
		Name = "Scroll",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = Theme.Colors.Dark,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = panel,
	})
	UIUtil.Create("UIPadding", {
		PaddingTop = UDim.new(0, 2),
		PaddingLeft = UDim.new(0, 2),
		PaddingRight = UDim.new(0, 12),
		PaddingBottom = UDim.new(0, 8),
		Parent = content,
	})
	UIUtil.Create("UIListLayout", {
		Padding = UDim.new(0, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = content,
	})

	buildAudio(content)
	buildDisplay(content)
	buildLanguage(content)
	buildGame(content)

	UIUtil.Create("TextLabel", {
		Name = "Tip",
		Text = Locale.T("Tip: every upgrade adds something to the screen. How far will you go?"),
		TextColor3 = Theme.Colors.TextDim,
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		TextSize = 14,
		TextWrapped = true,
		Size = UDim2.new(1, 0, 0, 30),
		LayoutOrder = 10,
		Parent = content,
	})

	-- Infos musique en direct
	SoundManager.TrackChanged:Connect(refreshMusicInfo)
	SoundManager.MusicStateChanged:Connect(refreshMusicInfo)
	SoundManager.VolumeChanged:Connect(function(musicVolume: number, effectsVolume: number)
		-- (volumes changés ailleurs : on recale les curseurs)
		local music = sliders.Music
		local sound = sliders.Sound
		if music then
			music.Set(musicVolume)
		end
		if sound then
			sound.Set(effectsVolume)
		end
	end)
	ClientState.FeaturesChanged:Connect(refreshMusicInfo)
	refreshMusicInfo()
	stepEqualizer()
end

function Settings.OnOpen()
	refreshMusicInfo()
	-- Égaliseur animé seulement quand la fenêtre est ouverte
	if not equalizerConnection then
		equalizerConnection = RunService.Heartbeat:Connect(stepEqualizer)
	end
end

function Settings.OnClose()
	local connection = equalizerConnection
	if connection then
		connection:Disconnect()
		equalizerConnection = nil
	end
end

-- Au chargement, on applique les réglages sauvegardés (une seule fois) ;
-- le son du clic suit ensuite l'état du serveur (sauf pendant une sauvegarde)
local applied = false
function Settings.Update(data)
	if type(data) ~= "table" or type(data.Settings) ~= "table" then
		return
	end
	if not applied then
		applied = true
		for _, key in ipairs({ "Sound", "Music", "Effects" }) do
			Settings.Apply(key, data.Settings[key] ~= false)
		end
	end
	-- Mode sombre : appliqué par ClientState, on recale juste l'interrupteur
	local dark = ClientState.IsUserDarkMode()
	if current.DarkMode ~= dark then
		current.DarkMode = dark
		local ui = toggles.DarkMode
		if ui then
			paintToggle(ui, dark, true)
		end
	end
	-- Langue sauvegardée (sauf pendant une sauvegarde)
	local tabs = languageTabs
	if tabs and not languageSaving then
		local saved = ClientState.GetLanguageSetting()
		if languageChosen == nil or languageChosen == saved then
			languageChosen = nil
			if tabs.GetSelected() ~= saved then
				tabs.Select(saved, true)
			end
		end
	end
	local clickSound = data.Settings.ClickSound
	if not clickSaving and type(clickSound) == "string" and clickSound ~= SoundManager.GetClickSound() then
		SoundManager.SetClickSound(clickSound)
	end
end

return Settings
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="29">
            <Properties>
              <string name="Name">Themes</string>
              <string name="Source"><![CDATA[--[[
	Themes (ModuleScript) — boutique de thèmes (fonds d'écran)
	Emplacement : ReplicatedStorage > Client > Components > Panels > Themes

	Grille de cartes (Config.Themes) avec un mini-aperçu animé de chaque
	fond (le VRAI décor du fond d'écran en miniature, Background.BuildPreview), son nom, son prix en Dopamine et/ou un bouton "💎" (Game Pass
	Robux), un badge "👑 VIP" pour les thèmes Premium, et l'état
	possédé / équipé (ClientState.Data.Themes).
	- Achat / équipement : RemoteFunction "ThemeShop" ("buy" | "equip", id).
	- Robux : MarketplaceService:PromptGamePassPurchase (le serveur vérifie
	  l'achat et débloque le thème).
	Les thèmes sont conservés pour toujours (même après l'océan).
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Client = script.Parent.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local ClientState = require(Client.ClientState)
local Effects = require(Client.Effects)
local SoundManager = require(Client.SoundManager)
local Notifications = require(script.Parent.Parent.Notifications)
local Background = require(script.Parent.Parent.Background)
local Config = require(ReplicatedStorage.Shared.Config)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Net = require(ReplicatedStorage.Shared.Net)
local Locale = require(ReplicatedStorage.Shared.Locale)

-- Title / Subtitle en anglais : traduits par PanelManager
local Themes = {
	Title = "🎨 Themes",
	Subtitle = "Change the game's background",
	Color = Theme.Colors.Cyan,
	Size = Vector2.new(760, 540),
}

local ROBUX_COLOR = Theme.Colors.Robux or Theme.Colors.Green
local PREMIUM_COLOR = Theme.Colors.Premium or Theme.Colors.Gold
local WHITE = Color3.new(1, 1, 1)

type Card = {
	Theme: any,
	Card: Frame,
	Stroke: UIStroke,
	Primary: TextButton,
	Robux: TextButton,
	Status: TextLabel,
	Check: Frame,
	Lock: TextLabel,
	Action: string, -- action du bouton principal : "equip" | "buy" | "vip" | "robux" | "none"
}

local header: TextLabel
local cards: { [string]: Card } = {}
local previews: { Background.Preview } = {}
local animation: RBXScriptConnection? = nil
local busy = false

----------------------------------------------------------------------
-- Outils
----------------------------------------------------------------------

local function getThemesData(data): ({ [string]: boolean }, string)
	local themes = data and data.Themes
	local owned = (type(themes) == "table" and themes.Owned) or { Classic = true }
	local equipped = (type(themes) == "table" and themes.Equipped) or "Classic"
	return owned, equipped
end

local function getDopamine(): number
	local ok, value = pcall(ClientState.GetConfirmedDopamine)
	if ok and type(value) == "number" then
		return value
	end
	local data = ClientState.Data
	return (data and data.Dopamine) or 0
end

local function vipPassId(): number
	local pass = Config.GamePassesById and Config.GamePassesById.VIP
	return (pass and tonumber(pass.GamePassId)) or 0
end

-- Petite étiquette arrondie (ex. "👑 VIP")
local function chip(parent: Instance, text: string, color: Color3, props: { [string]: any }): Frame
	local frame = UIUtil.Create("Frame", {
		Name = props.Name or "Chip",
		Size = UDim2.fromOffset(0, 20),
		AutomaticSize = Enum.AutomaticSize.X,
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		Position = props.Position or UDim2.new(),
		BackgroundColor3 = color,
		ZIndex = 4,
		Parent = parent,
	})
	UIUtil.Corner(frame, UDim.new(1, 0))
	UIUtil.Stroke(frame, Theme.Colors.Border, 1, 0.5)
	UIUtil.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 7),
		PaddingRight = UDim.new(0, 7),
		Parent = frame,
	})
	UIUtil.Create("TextLabel", {
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = text,
		TextColor3 = Theme.ContrastText(color),
		TextSize = 12,
		ZIndex = 5,
		Parent = frame,
	})
	return frame
end

----------------------------------------------------------------------
-- Mini-aperçu du fond : le vrai décor animé, en miniature
----------------------------------------------------------------------

local function buildPreviewDecor(preview: GuiObject, theme)
	local ok, result = pcall(Background.BuildPreview, preview, theme.Id)
	if ok then
		table.insert(previews, result)
	else
		warn("[Themes] Aperçu impossible pour " .. tostring(theme.Id) .. " : " .. tostring(result))
	end

	-- Voile doux derrière le bouton (lisibilité)
	local veil = UIUtil.Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.46),
		Size = UDim2.fromOffset(120, 56),
		BackgroundColor3 = theme.Dark and Color3.new(0, 0, 0) or WHITE,
		BackgroundTransparency = 0.55,
		BorderSizePixel = 0,
		ZIndex = 4,
		Parent = preview,
	})
	UIUtil.Corner(veil, UDim.new(1, 0))
	UIUtil.Create("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.3, 0.4),
			NumberSequenceKeypoint.new(0.7, 0.4),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = veil,
	})

	-- Mini bouton "Clique-moi" (montre la lisibilité du thème)
	local dark = theme.Dark == true
	local mini = UIUtil.Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(66, 22),
		BackgroundColor3 = dark and Theme.DarkColors.Card or WHITE,
		BackgroundTransparency = dark and 0.2 or 0,
		ZIndex = 5,
		Parent = preview,
	})
	UIUtil.Corner(mini, 7)
	UIUtil.Stroke(mini, dark and WHITE or Theme.Colors.Border, 1, dark and 0.5 or 0.2)
	if not dark then
		UIUtil.Gradient(mini, ColorSequence.new(Theme.Colors.Button, Theme.Colors.ButtonBottom), 90)
	end
	UIUtil.Create("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		Text = Locale.T("Click me"),
		TextColor3 = dark and WHITE or Theme.Colors.Text,
		TextSize = 11,
		ZIndex = 6,
		Parent = mini,
	})
	UIUtil.Create("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.42, 13),
		Size = UDim2.fromOffset(90, 14),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = "123 " .. Locale.T("Dopamine"),
		TextColor3 = dark and WHITE or Theme.Colors.Text,
		TextSize = 11,
		ZIndex = 5,
		Parent = preview,
	})
end

----------------------------------------------------------------------
-- Actions
----------------------------------------------------------------------

local function popCard(card: Card)
	local scale = card.Card:FindFirstChild("PopScale") :: UIScale?
	if scale then
		scale.Scale = 1.07
		UIUtil.Tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	end
end

local function invoke(action: string, themeId: string): (boolean, string?)
	local ok, success, message = pcall(function()
		return Net.Function("ThemeShop"):InvokeServer(action, themeId)
	end)
	if not ok then
		return false, Locale.T("Network error, try again.")
	end
	return success == true, message and tostring(message) or nil
end

local function request(action: string, theme)
	if busy then
		return
	end
	busy = true
	local ok, message = invoke(action, theme.Id)
	local card = cards[theme.Id]
	if ok and action == "buy" then
		-- Acheté : on l'équipe tout de suite
		SoundManager.Play("Buy", 1.1)
		Effects.Confetti(50)
		Notifications.Toast(Locale.T("%s: yours forever!", theme.Icon .. " " .. Locale.T(theme.Name)), Theme.Colors.Green, 4, Locale.T("New theme"))
		-- (le serveur l'équipe automatiquement après l'achat)
	elseif ok then
		SoundManager.Play("Open", 1.25)
		Notifications.Toast(Locale.T("🎨 Theme equipped: %s", theme.Icon .. " " .. Locale.T(theme.Name)), Theme.Colors.Cyan, 2.5)
	else
		SoundManager.Play("Error", 0.7)
		Notifications.Toast(message or Locale.T("Not possible right now."), Theme.Colors.Red)
		if card then
			UIUtil.Shake(card.Primary)
		end
	end
	busy = false
	if ok and card then
		popCard(card)
	end
end

-- Ouvre la fenêtre d'achat Roblox d'un Game Pass
local function promptPass(passId: number, what: string)
	if passId == 0 then
		SoundManager.Play("Error", 0.7)
		if RunService:IsStudio() then
			Notifications.Toast(Locale.T("Add the Game Pass ID in Config (%s)", what), Theme.Colors.Orange, 4)
		else
			Notifications.Toast(Locale.T("Coming soon!"), Theme.Colors.Orange)
		end
		return
	end
	local ok, err = pcall(function()
		MarketplaceService:PromptGamePassPurchase(Players.LocalPlayer, passId)
	end)
	if not ok then
		warn("[Themes] PromptGamePassPurchase : " .. tostring(err))
		Notifications.Toast(Locale.T("The Roblox store isn't responding, try again."), Theme.Colors.Red)
	end
end

local function onPrimary(card: Card)
	local theme = card.Theme
	local action = card.Action
	if action == "equip" then
		task.spawn(request, "equip", theme)
	elseif action == "buy" then
		if not card.Primary:GetAttribute("Enabled") then
			SoundManager.Play("Error", 0.7)
			UIUtil.Shake(card.Primary)
			local missing = math.max(0, (tonumber(theme.Cost) or 0) - getDopamine())
			Notifications.Toast(Locale.T("You need %s more Dopamine", NumberFormatter.Format(missing)), Theme.Colors.Red)
			return
		end
		task.spawn(request, "buy", theme)
	elseif action == "vip" then
		promptPass(vipPassId(), "Monetization.GamePasses VIP")
	elseif action == "robux" then
		promptPass(tonumber(theme.GamePassId) or 0, "Themes." .. theme.Id .. ".GamePassId")
	else
		popCard(card) -- déjà équipé
	end
end

----------------------------------------------------------------------
-- Construction
----------------------------------------------------------------------

local function buildCard(list: ScrollingFrame, theme)
	-- Support transparent (dans la grille) : porte la carte et son ombre
	local cell = UIUtil.Create("Frame", {
		Name = theme.Id,
		BackgroundTransparency = 1,
		LayoutOrder = theme.Order or 0,
		Parent = list,
	})
	local card = UIUtil.Create("Frame", {
		Name = "Card",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Colors.Card,
		ZIndex = 2,
		Parent = cell,
	})
	UIUtil.Corner(card, 16)
	local stroke = UIUtil.Stroke(card, Theme.Colors.CardBorder, 1.5, 0.15)
	UIUtil.Create("UIScale", { Name = "PopScale", Parent = card })
	pcall(UIUtil.Shadow, card, 4, 0.82)

	-- Aperçu (CanvasGroup : le décor est coupé aux coins arrondis)
	local preview = UIUtil.Create("CanvasGroup", {
		Name = "Preview",
		Position = UDim2.fromOffset(8, 8),
		Size = UDim2.new(1, -16, 0, 104),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = card,
	})
	-- L'aperçu montre les vraies couleurs du thème (pas d'habillage sombre)
	preview:SetAttribute("DarkSkinIgnore", true)
	UIUtil.Corner(preview, 11)
	UIUtil.Stroke(preview, Theme.Colors.Border, 1, 0.75)
	-- (un UIGradient directement sur le CanvasGroup teinterait tout son contenu)
	local sky = UIUtil.Create("Frame", {
		Name = "Sky",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 1,
		Parent = preview,
	})
	UIUtil.Gradient(sky, ColorSequence.new(theme.Top, theme.Bottom), 90)
	buildPreviewDecor(preview, theme)

	if theme.Premium then
		chip(preview, "👑 VIP", PREMIUM_COLOR, { Position = UDim2.fromOffset(6, 6) })
	end
	local check = UIUtil.Create("Frame", {
		Name = "Check",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -6, 0, 6),
		Size = UDim2.fromOffset(22, 22),
		BackgroundColor3 = Theme.Colors.Green,
		Visible = false,
		ZIndex = 6,
		Parent = preview,
	})
	UIUtil.Corner(check, UDim.new(1, 0))
	UIUtil.Stroke(check, WHITE, 2)
	UIUtil.Create("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = "✓",
		TextColor3 = WHITE,
		TextSize = 15,
		ZIndex = 7,
		Parent = check,
	})
	local lock = UIUtil.Create("TextLabel", {
		Name = "Lock",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -4, 1, -2),
		Size = UDim2.fromOffset(22, 22),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		Text = "🔒",
		TextSize = 14,
		ZIndex = 6,
		Parent = preview,
	})

	-- Nom + statut
	UIUtil.Create("TextLabel", {
		Name = "Name",
		Position = UDim2.fromOffset(10, 118),
		Size = UDim2.new(1, -20, 0, 20),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = theme.Icon .. " " .. Locale.T(theme.Name),
		TextColor3 = Theme.Colors.Text,
		TextSize = 16,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 2,
		Parent = card,
	})
	local status = UIUtil.Create("TextLabel", {
		Name = "Status",
		Position = UDim2.fromOffset(10, 138),
		Size = UDim2.new(1, -20, 0, 16),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		Text = "",
		TextColor3 = Theme.Colors.TextDim,
		TextSize = 13,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 2,
		Parent = card,
	})

	-- Boutons : action principale + "💎" (Game Pass du thème)
	local primary = UIUtil.NeonButton({
		Name = "Primary",
		Text = "",
		Size = UDim2.new(1, -16, 0, 34),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 8, 1, -8),
		Color = Theme.Colors.Green,
		CornerRadius = 17,
		MaxTextSize = 15,
		ZIndex = 2,
		Parent = card,
	})
	local robux = UIUtil.NeonButton({
		Name = "Robux",
		Text = "💎",
		Size = UDim2.fromOffset(40, 34),
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -8, 1, -8),
		Color = ROBUX_COLOR,
		CornerRadius = 17,
		MaxTextSize = 17,
		ZIndex = 2,
		Parent = card,
	})
	robux.Visible = false

	local entry: Card = {
		Theme = theme,
		Card = card,
		Stroke = stroke,
		Primary = primary,
		Robux = robux,
		Status = status,
		Check = check,
		Lock = lock,
		Action = "none",
	}
	cards[theme.Id] = entry

	primary.Activated:Connect(function()
		onPrimary(entry)
	end)
	robux.Activated:Connect(function()
		promptPass(tonumber(theme.GamePassId) or 0, "Themes." .. theme.Id .. ".GamePassId")
	end)

	-- Survol : la carte se soulève un peu
	card.MouseEnter:Connect(function()
		UIUtil.Tween(card, 0.15, { Position = UDim2.fromOffset(0, -3) })
	end)
	card.MouseLeave:Connect(function()
		UIUtil.Tween(card, 0.15, { Position = UDim2.fromOffset(0, 0) })
	end)
end

function Themes.Build(content: Frame)
	header = UIUtil.Create("TextLabel", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 24),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		Text = "",
		TextColor3 = Theme.Colors.TextDim,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = content,
	})

	local list = UIUtil.Create("ScrollingFrame", {
		Name = "List",
		Size = UDim2.new(1, 0, 1, -30),
		Position = UDim2.fromOffset(0, 30),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Colors.Cyan,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = content,
	})
	UIUtil.Create("UIPadding", {
		PaddingTop = UDim.new(0, 6),
		PaddingLeft = UDim.new(0, 4),
		PaddingRight = UDim.new(0, 12),
		PaddingBottom = UDim.new(0, 10),
		Parent = list,
	})
	UIUtil.Create("UIGridLayout", {
		CellSize = UDim2.new(0.25, -9, 0, 214),
		CellPadding = UDim2.fromOffset(12, 14),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = list,
	})

	for _, theme in ipairs(Config.Themes) do
		buildCard(list, theme)
	end

	-- Achat Robux terminé (le serveur vérifie et débloque le thème)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if player ~= Players.LocalPlayer or not purchased then
			return
		end
		for _, theme in ipairs(Config.Themes) do
			if theme.GamePassId ~= 0 and theme.GamePassId == passId then
				SoundManager.Play("Buy", 1.1)
				Effects.Confetti(60)
				Notifications.Toast(
					Locale.T("%s unlocked, thank you!", theme.Icon .. " " .. Locale.T(theme.Name)),
					ROBUX_COLOR,
					4,
					Locale.T("💎 Purchase successful")
				)
				return
			end
		end
	end)
end

function Themes.Update(data)
	local owned, equipped = getThemesData(data)
	local dopamine = getDopamine()
	local isVIP = data and data.IsVIP == true
	local ownedCount = 0

	for id, card in pairs(cards) do
		local theme = card.Theme
		local cost = tonumber(theme.Cost)
		local passId = tonumber(theme.GamePassId) or 0
		local isOwned = owned[id] == true
		local isEquipped = isOwned and equipped == id
		if isOwned then
			ownedCount += 1
		end

		local primary = card.Primary
		local showRobux = false
		card.Check.Visible = isEquipped
		card.Lock.Visible = not isOwned

		if isEquipped then
			card.Action = "none"
			primary.Text = Locale.T("✔ Equipped")
			primary:SetAttribute("BaseColor", Theme.Colors.ButtonBottom)
			UIUtil.SetButtonEnabled(primary, true)
			primary.TextColor3 = Theme.Colors.Text
			card.Status.Text = Locale.T("Your current background")
			card.Status.TextColor3 = Theme.Colors.Green
			card.Stroke.Color = Theme.Colors.Green
			card.Stroke.Thickness = 3
			card.Stroke.Transparency = 0
		elseif isOwned then
			card.Action = "equip"
			primary.Text = Locale.T("Equip")
			primary:SetAttribute("BaseColor", Theme.Colors.Blue)
			UIUtil.SetButtonEnabled(primary, true)
			primary.TextColor3 = Theme.Colors.TextLight
			card.Status.Text = (theme.Premium and isVIP) and Locale.T("👑 Included with VIP") or Locale.T("✔ Owned")
			card.Status.TextColor3 = Theme.Colors.TextDim
			card.Stroke.Color = Theme.Colors.CardBorder
			card.Stroke.Thickness = 1.5
			card.Stroke.Transparency = 0.15
		else
			card.Stroke.Color = Theme.Colors.CardBorder
			card.Stroke.Thickness = 1.5
			card.Stroke.Transparency = 0.15
			if cost then
				-- Achetable en Dopamine (et peut-être aussi en Robux)
				local affordable = dopamine >= cost
				card.Action = "buy"
				primary.Text = cost <= 0 and Locale.T("Free") or ("💧 " .. NumberFormatter.Format(cost))
				primary:SetAttribute("BaseColor", Theme.Colors.Green)
				UIUtil.SetButtonEnabled(primary, affordable)
				primary.TextColor3 = Theme.Colors.TextDark
				showRobux = passId ~= 0
				if theme.Premium then
					card.Status.Text = Locale.T("Or free with the VIP pass")
				elseif showRobux then
					card.Status.Text = Locale.T("Dopamine or 💎 Robux")
				else
					card.Status.Text = affordable and Locale.T("You can afford it!") or Locale.T("Not enough Dopamine yet")
				end
				card.Status.TextColor3 = affordable and Theme.Colors.TextDim or Theme.Colors.Red
			elseif passId ~= 0 then
				-- Uniquement en Robux (Game Pass du thème)
				card.Action = "robux"
				primary.Text = "💎 Robux"
				primary:SetAttribute("BaseColor", ROBUX_COLOR)
				UIUtil.SetButtonEnabled(primary, true)
				primary.TextColor3 = Theme.Colors.TextLight
				card.Status.Text = theme.Premium and Locale.T("Robux or VIP pass") or Locale.T("Robux exclusive")
				card.Status.TextColor3 = Theme.Colors.TextDim
			elseif theme.Premium then
				-- Uniquement avec le pass VIP
				card.Action = "vip"
				primary.Text = Locale.T("👑 VIP Pass")
				primary:SetAttribute("BaseColor", PREMIUM_COLOR)
				UIUtil.SetButtonEnabled(primary, true)
				primary.TextColor3 = Theme.Colors.TextDark
				card.Status.Text = Locale.T("VIP exclusive")
				card.Status.TextColor3 = Theme.Colors.TextDim
			else
				card.Action = "none"
				primary.Text = Locale.T("Soon")
				primary:SetAttribute("BaseColor", Theme.Colors.Disabled)
				UIUtil.SetButtonEnabled(primary, false)
				card.Status.Text = Locale.T("Not on sale yet")
				card.Status.TextColor3 = Theme.Colors.TextDim
			end
		end

		card.Robux.Visible = showRobux
		primary.Size = showRobux and UDim2.new(1, -62, 0, 34) or UDim2.new(1, -16, 0, 34)
	end

	header.Text = Locale.T(
		"%d / %d themes unlocked  •  kept forever, even after the ocean 🌊%s",
		ownedCount,
		#Config.Themes,
		isVIP and "  •  👑 VIP" or ""
	)
end

-- Animation des aperçus seulement quand la fenêtre est ouverte
function Themes.OnOpen()
	if animation then
		return
	end
	animation = RunService.Heartbeat:Connect(function(dt: number)
		for _, preview in ipairs(previews) do
			preview.Update(dt)
		end
	end)
end

function Themes.OnClose()
	local connection = animation
	if connection then
		connection:Disconnect()
		animation = nil
	end
end

return Themes
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">UpgradeBar</string>
            <string name="Source"><![CDATA[--[[
	UpgradeBar (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > UpgradeBar

	La rangée de cartes carrées sous le compteur (Formulas.GetVisibleUpgrades) :
	  - carte blanche à bord noir, gros emoji, pastille rouge = niveau
	    (améliorations à plusieurs niveaux) ;
	  - carte "fanée" si on ne peut pas se la payer ;
	  - infobulle : nom, description, coût (rouge si trop cher) ;
	  - PC : survol = infobulle, clic = achat ;
	  - tactile : 1er appui = infobulle avec un bouton "Acheter", 2e appui
	    (ou "Acheter") = achat ;
	  - "Aller à l'océan" demande toujours une confirmation ;
	  - style "Icônes HD" (Feature HDIcons) : cartes brillantes colorées ;
	  - mode sombre : cartes sombres translucides, texte blanc ;
	  - finitions : ombre douce sous les cartes et l'infobulle, petit "pop"
	    quand une carte devient abordable.
	v5 : noms / descriptions traduits (Locale.T sur les textes anglais de
	Config) ; sur téléphone : cartes plus petites (84), rangée limitée à la
	place entre les slots de côté, infobulle plus large avec de plus gros
	textes ; tout se réajuste quand l'écran change.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Client = script.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local Interface = require(Client.Interface)
local ClientState = require(Client.ClientState)
local Effects = require(Client.Effects)
local SoundManager = require(Client.SoundManager)
local Notifications = require(script.Parent.Notifications)
local PanelManager = require(script.Parent.PanelManager)
local Slots = require(Client.Slots)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Net = require(ReplicatedStorage.Shared.Net)
local Locale = require(ReplicatedStorage.Shared.Locale)

local UpgradeBar = {}

local MAX_WIDTH = 660 -- largeur max de la rangée (au-delà : défilement horizontal)
local GAP = 14
local CARD_SIZE = 100
local MIN_CARD_SIZE = 78
local PHONE_CARD_SIZE = 84 -- téléphone : cartes un peu plus petites (la toile est déjà agrandie)
local PHONE_MIN_CARD_SIZE = 70
local PAD_TOP = 10 -- place pour les pastilles qui dépassent
local PAD_SIDE = 10
UpgradeBar.Height = CARD_SIZE + PAD_TOP + 6

-- Mesures selon l'appareil : (taille de carte, taille min, largeur max de la rangée)
local function metrics(): (number, number, number)
	if Interface.IsPhone() then
		local clear = Slots.GetCenterClearWidth() - PAD_SIDE * 2
		return PHONE_CARD_SIZE, PHONE_MIN_CARD_SIZE, math.clamp(clear, 340, MAX_WIDTH)
	end
	return CARD_SIZE, MIN_CARD_SIZE, MAX_WIDTH
end

-- Traduction des textes de Config (anglais -> langue du joueur)
local function translate(text: string): string
	return Locale.T(text)
end

type Card = {
	Upgrade: any,
	Holder: Frame,
	Button: TextButton,
	Stroke: UIStroke,
	Gradient: UIGradient,
	Icon: TextLabel,
	Badge: TextLabel,
	PopScale: UIScale,
	HD: Frame,
	Level: number,
	Affordable: boolean,
	Removing: boolean,
}

local bar: Frame
local scroll: ScrollingFrame
local cards: { [string]: Card } = {}
local random = Random.new()

-- Infobulle
local tooltip: TextButton
local tipName: TextLabel
local tipDesc: TextLabel
local tipLevel: TextLabel
local tipCost: TextLabel
local tipButton: TextButton
local tipUpgradeId: string? = nil
local tipPinned = false -- vrai si ouverte par appui (tactile) ou confirmation

-- Entrées
local lastInputTouch = UserInputService.TouchEnabled and not UserInputService.MouseEnabled
local lastUiTapClock = 0
local hdEnabled = false
local darkMode = false

----------------------------------------------------------------------
-- Utilitaires
----------------------------------------------------------------------

local function formatAmount(value: number): string
	if value >= 1e6 then
		return NumberFormatter.Format(value)
	elseif value < 10 and value % 1 ~= 0 then
		return NumberFormatter.Format(value)
	end
	return NumberFormatter.WithSpaces(value)
end

local function getRebirths(): number
	local data = ClientState.Data
	return (data and data.Rebirths) or 0
end

local function getCost(upgrade): number
	return Formulas.GetUpgradeCost(upgrade, ClientState.GetLevel(upgrade.Id), getRebirths())
end

local function canAfford(upgrade): boolean
	return ClientState.GetConfirmedDopamine() >= getCost(upgrade) - 1e-6
end

local function isRepeatable(upgrade): boolean
	return upgrade.MaxLevel ~= 1
end

----------------------------------------------------------------------
-- Infobulle
----------------------------------------------------------------------

local function hideTooltip()
	tipUpgradeId = nil
	tipPinned = false
	if tooltip then
		tooltip.Visible = false
	end
end

local function refreshTooltip()
	local id = tipUpgradeId
	if not id then
		return
	end
	local card = cards[id]
	if not card or card.Removing or not card.Holder.Parent then
		hideTooltip()
		return
	end
	local upgrade = card.Upgrade
	local level = ClientState.GetLevel(upgrade.Id)
	local cost = getCost(upgrade)
	local affordable = canAfford(upgrade)

	tipName.Text = upgrade.Icon .. "  " .. Locale.T(upgrade.Name)
	tipDesc.Text = Formulas.DescribeUpgrade(upgrade, NumberFormatter.Format, getRebirths(), translate)
	if upgrade.Effect == "Detox" then
		local rebirths = getRebirths()
		tipLevel.Visible = rebirths > 0
		tipLevel.Text = Locale.T("Ocean visits: %s", tostring(rebirths))
	elseif isRepeatable(upgrade) then
		tipLevel.Visible = true
		tipLevel.Text = upgrade.MaxLevel and Locale.T("Level %d / %d", level, upgrade.MaxLevel) or Locale.T("Level %d", level)
	else
		tipLevel.Visible = false
	end
	tipCost.Text = Locale.T("Cost: %s Dopamine", formatAmount(cost))
	tipCost.TextColor3 = affordable and Theme.Colors.Text or Theme.Colors.Red

	local needsButton = tipPinned
	tipButton.Visible = needsButton
	if needsButton then
		tipButton.Text = upgrade.Effect == "Detox" and Locale.T("🌊 Let's go") or Locale.T("Buy")
		UIUtil.SetButtonEnabled(tipButton, affordable)
	end

	-- Placement sous la carte (en coordonnées de la toile)
	local topLeft = Interface.ScreenToCanvas(card.Button.AbsolutePosition)
	local size = card.Button.AbsoluteSize / Interface.Scale
	local canvas = Interface.CanvasSize
	local halfWidth = tooltip.AbsoluteSize.X / Interface.Scale / 2
	if halfWidth <= 0 then
		halfWidth = 140
	end
	local x = math.clamp(topLeft.X + size.X / 2, halfWidth + 8, canvas.X - halfWidth - 8)
	tooltip.Position = UDim2.fromOffset(x, topLeft.Y + size.Y + 10)
end

local function showTooltip(upgradeId: string, pinned: boolean)
	local changed = tipUpgradeId ~= upgradeId
	tipUpgradeId = upgradeId
	tipPinned = pinned
	tooltip.Visible = true
	refreshTooltip()
	if changed then
		local scale = tooltip:FindFirstChildOfClass("UIScale")
		if scale then
			scale.Scale = 0.85
			UIUtil.Tween(scale, 0.15, { Scale = 1 }, Enum.EasingStyle.Back)
		end
	end
end

local function buildTooltip(layer: Frame)
	-- TextButton (sans texte) : un appui DANS l'infobulle ne traverse pas vers les
	-- stimuli en dessous et ne la ferme pas
	tooltip = UIUtil.Create("TextButton", {
		Name = "UpgradeTooltip",
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromOffset(280, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Theme.Colors.Card,
		Visible = false,
		ZIndex = 5,
		Parent = layer,
	})
	UIUtil.Corner(tooltip, 14)
	UIUtil.Stroke(tooltip, Theme.Colors.CardBorder, 1.5, 0.05)
	UIUtil.Create("UIScale", { Parent = tooltip })
	UIUtil.Shadow(tooltip, 5, 0.8, 3)
	UIUtil.Create("UIPadding", {
		PaddingTop = UDim.new(0, 10),
		PaddingBottom = UDim.new(0, 12),
		PaddingLeft = UDim.new(0, 14),
		PaddingRight = UDim.new(0, 14),
		Parent = tooltip,
	})
	UIUtil.Create("UIListLayout", {
		Padding = UDim.new(0, 4),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = tooltip,
	})

	local function textLine(order: number, font: Enum.Font, textSize: number, color: Color3): TextLabel
		return UIUtil.Create("TextLabel", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			Font = font,
			TextSize = textSize,
			TextColor3 = color,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Text = "",
			LayoutOrder = order,
			ZIndex = 6,
			Parent = tooltip,
		})
	end

	tipName = textLine(1, Theme.Fonts.Title, 21, Theme.Colors.Text)
	tipDesc = textLine(2, Theme.Fonts.Body, 16, Theme.Colors.TextDim)
	tipLevel = textLine(3, Theme.Fonts.Body, 15, Theme.Colors.TextDim)
	tipName:SetAttribute("BaseTextSize", 21)
	tipDesc:SetAttribute("BaseTextSize", 16)
	tipLevel:SetAttribute("BaseTextSize", 15)
	-- Fine ligne de séparation avant le prix
	UIUtil.Create("Frame", {
		Name = "Divider",
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = Theme.Colors.Divider,
		BorderSizePixel = 0,
		LayoutOrder = 3,
		ZIndex = 6,
		Parent = tooltip,
	})
	tipCost = textLine(4, Theme.Fonts.Title, 17, Theme.Colors.Text)
	tipCost:SetAttribute("BaseTextSize", 17)

	tipButton = UIUtil.PillButton({
		Name = "Buy",
		Text = Locale.T("Buy"),
		Color = Theme.Colors.Green,
		TextColor3 = Theme.Colors.TextDark,
		Height = 38,
		TextSize = 18,
		LayoutOrder = 5,
		ZIndex = 6,
		Parent = tooltip,
	})
	tipButton.Visible = false
end

----------------------------------------------------------------------
-- Achat
----------------------------------------------------------------------

local function burstAt(card: Card, color: Color3?)
	local layer = Effects.GetLayer()
	if layer and card.Button.Parent then
		Effects.Burst(layer, Interface.CanvasPosition(card.Button), color, 12)
	end
end

local function failFeedback(card: Card?)
	SoundManager.Play("Error", 0.7)
	if card then
		UIUtil.Shake(card.Button)
	end
end

local function buy(upgradeId: string)
	lastUiTapClock = os.clock()
	local card = cards[upgradeId]
	if not card or card.Removing then
		return
	end
	local upgrade = card.Upgrade
	if not canAfford(upgrade) then
		failFeedback(card)
		return
	end
	task.spawn(function()
		local ok, success, message = pcall(function()
			return Net.Function("BuyUpgrade"):InvokeServer(upgradeId)
		end)
		if ok and success then
			SoundManager.Play("Buy", 0.95 + random:NextNumber(0, 0.15))
			burstAt(card, upgrade.Color)
			if upgrade.Effect == "Detox" then
				hideTooltip()
			end
		else
			failFeedback(card)
			if not ok then
				Notifications.Toast(Locale.T("Network error, try again."), Theme.Colors.Red)
			elseif type(message) == "string" and message ~= "" then
				local layer = Effects.GetLayer()
				if layer and card.Button.Parent then
					Effects.FloatingText(layer, Interface.CanvasPosition(card.Button, Vector2.new(0, -40)), message, Theme.Colors.Red, 20)
				end
			end
		end
	end)
end

----------------------------------------------------------------------
-- Style des cartes
----------------------------------------------------------------------

local function styleCard(card: Card)
	local upgrade = card.Upgrade
	local affordable = canAfford(upgrade)
	local button = card.Button

	if hdEnabled then
		local color: Color3 = upgrade.Color or Theme.Colors.Blue
		button.BackgroundColor3 = Color3.new(1, 1, 1)
		button.BackgroundTransparency = darkMode and 0.1 or 0
		card.Gradient.Enabled = true
		card.Gradient.Color = ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.45), color)
		card.HD.Visible = true
	else
		card.Gradient.Enabled = false
		card.HD.Visible = false
		if darkMode then
			button.BackgroundColor3 = Theme.DarkColors.Card
			button.BackgroundTransparency = Theme.DarkColors.CardTransparency
		else
			button.BackgroundColor3 = Theme.Colors.Card
			button.BackgroundTransparency = 0
		end
	end
	card.Stroke.Color = darkMode and Theme.DarkColors.CardBorder or Theme.Colors.CardBorder
	card.Stroke.Transparency = affordable and 0 or 0.45
	card.Icon.TextTransparency = affordable and 0 or 0.5
end

local function styleAll()
	for _, card in pairs(cards) do
		if not card.Removing then
			styleCard(card)
		end
	end
end

----------------------------------------------------------------------
-- Création / suppression des cartes
----------------------------------------------------------------------

local function createCard(upgrade): Card
	local holder = UIUtil.Create("Frame", {
		Name = upgrade.Id,
		Size = UDim2.fromOffset(CARD_SIZE, CARD_SIZE),
		BackgroundTransparency = 1,
		Parent = scroll,
	})

	local button = UIUtil.Create("TextButton", {
		Name = "Card",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Colors.Card,
		AutoButtonColor = false,
		Text = "",
		ClipsDescendants = false,
		Parent = holder,
	})
	UIUtil.Corner(button, 18)
	local stroke = UIUtil.Stroke(button, Theme.Colors.CardBorder, 2)
	local gradient = UIUtil.Gradient(button, ColorSequence.new(Color3.new(1, 1, 1)), 90)
	gradient.Enabled = false
	local popScale = UIUtil.Create("UIScale", { Name = "PopScale", Parent = button })
	UIUtil.Shadow(button, 3, 0.84, 2)

	-- Décor "Icônes HD" : rayons qui tournent, anneau blanc, reflet brillant
	local hd = UIUtil.Create("Frame", {
		Name = "HD",
		Size = UDim2.new(1, -8, 1, -8),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Visible = false,
		ZIndex = 1,
		Parent = button,
	})
	UIUtil.Corner(hd, 14)
	local rays = UIUtil.Create("Frame", {
		Name = "Rays",
		Size = UDim2.fromScale(1.6, 1.6),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = 1,
		Parent = hd,
	})
	for i = 0, 5 do
		UIUtil.Create("Frame", {
			Size = UDim2.new(0, 12, 1, 0),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Rotation = i * 30,
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.72,
			BorderSizePixel = 0,
			ZIndex = 1,
			Parent = rays,
		})
	end
	local ring = UIUtil.Create("Frame", {
		Name = "Ring",
		Size = UDim2.fromScale(0.7, 0.7),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.65,
		ZIndex = 2,
		Parent = hd,
	})
	UIUtil.Corner(ring, UDim.new(1, 0))
	UIUtil.Stroke(ring, Color3.new(1, 1, 1), 3)
	local gloss = UIUtil.Create("Frame", {
		Name = "Gloss",
		Size = UDim2.new(1, 0, 0.45, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		ZIndex = 4,
		Parent = hd,
	})
	UIUtil.Create("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = gloss,
	})

	local icon = UIUtil.Label({
		Name = "Icon",
		Text = upgrade.Icon,
		Size = UDim2.fromScale(0.62, 0.62),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		ZIndex = 3,
		MaxTextSize = 60,
		Parent = button,
	})

	local badge = UIUtil.Badge(holder, 26)
	badge.Position = UDim2.new(1, -6, 0, 4)

	local card: Card = {
		Upgrade = upgrade,
		Holder = holder,
		Button = button,
		Stroke = stroke,
		Gradient = gradient,
		Icon = icon,
		Badge = badge,
		PopScale = popScale,
		HD = hd,
		Level = ClientState.GetLevel(upgrade.Id),
		Affordable = canAfford(upgrade),
		Removing = false,
	}

	-- Survol (PC)
	button.MouseEnter:Connect(function()
		if lastInputTouch or tipPinned then
			return
		end
		showTooltip(upgrade.Id, false)
		UIUtil.Tween(popScale, 0.12, { Scale = 1.06 }, Enum.EasingStyle.Back)
	end)
	button.MouseLeave:Connect(function()
		UIUtil.Tween(popScale, 0.12, { Scale = 1 })
		if tipUpgradeId == upgrade.Id and not tipPinned then
			hideTooltip()
		end
	end)

	-- Clic / appui
	button.Activated:Connect(function()
		lastUiTapClock = os.clock()
		local needsConfirm = upgrade.Effect == "Detox"
		if lastInputTouch or needsConfirm then
			if tipUpgradeId == upgrade.Id and tipPinned and not needsConfirm then
				buy(upgrade.Id)
			else
				showTooltip(upgrade.Id, true)
				SoundManager.Play("Click", 1.3)
			end
		else
			-- Une infobulle épinglée (ex. confirmation de l'océan) sur une AUTRE
			-- carte : on la ferme, sinon elle resterait bloquée à l'écran
			if tipPinned and tipUpgradeId ~= upgrade.Id then
				hideTooltip()
				showTooltip(upgrade.Id, false)
			end
			buy(upgrade.Id)
		end
	end)

	styleCard(card)
	return card
end

local function removeCard(id: string)
	local card = cards[id]
	if not card or card.Removing then
		return
	end
	card.Removing = true
	cards[id] = nil
	if tipUpgradeId == id then
		hideTooltip()
	end
	UIUtil.Tween(card.PopScale, 0.25, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	task.delay(0.3, function()
		card.Holder:Destroy()
	end)
end

-- Place les cartes (centrées ; défilement si trop large).
-- Les cartes de `created` arrivent en glissant depuis le bas.
local function layout(order: { any }, created: { [string]: boolean })
	local count = #order
	local cardSize, minCardSize, maxWidth = metrics()
	local size = cardSize
	if count > 0 then
		size = math.clamp(math.floor((maxWidth - GAP * (count - 1)) / count), minCardSize, cardSize)
	end
	-- Hauteur de la barre selon l'appareil
	local barHeight = cardSize + PAD_TOP + 6
	UpgradeBar.Height = barHeight
	if bar.Size.Y.Offset ~= barHeight then
		bar.Size = UDim2.new(1, 0, 0, barHeight)
	end
	local contentWidth = count * size + math.max(0, count - 1) * GAP + PAD_SIDE * 2
	local viewWidth = math.min(contentWidth, maxWidth + PAD_SIDE * 2)
	scroll.Size = UDim2.new(0, viewWidth, 1, 0)
	scroll.CanvasSize = UDim2.fromOffset(contentWidth, 0)
	scroll.ScrollBarThickness = contentWidth > viewWidth + 1 and 4 or 0

	for index, upgrade in ipairs(order) do
		local card = cards[upgrade.Id]
		if card then
			local x = PAD_SIDE + (index - 1) * (size + GAP)
			local y = PAD_TOP + (cardSize - size)
			local target = UDim2.fromOffset(x, y)
			local targetSize = UDim2.fromOffset(size, size)
			if created[upgrade.Id] then
				card.Holder.Size = targetSize
				card.Holder.Position = target + UDim2.fromOffset(0, 40)
				card.PopScale.Scale = 0.2
				UIUtil.Tween(card.Holder, 0.4, { Position = target }, Enum.EasingStyle.Back)
				UIUtil.Tween(card.PopScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
			elseif card.Holder.Position ~= target or card.Holder.Size ~= targetSize then
				UIUtil.Tween(card.Holder, 0.3, { Position = target, Size = targetSize })
			end
		end
	end
end

local function refresh(data)
	local visible = Formulas.GetVisibleUpgrades(data)
	local wanted = {}
	for _, upgrade in ipairs(visible) do
		wanted[upgrade.Id] = true
	end

	-- Cartes qui disparaissent (achat unique terminé, niveau max, océan...)
	local toRemove = {}
	for id in pairs(cards) do
		if not wanted[id] then
			table.insert(toRemove, id)
		end
	end
	for _, id in ipairs(toRemove) do
		removeCard(id)
	end

	-- Nouvelles cartes
	local created = {}
	for _, upgrade in ipairs(visible) do
		if not cards[upgrade.Id] then
			cards[upgrade.Id] = createCard(upgrade)
			created[upgrade.Id] = true
		end
	end

	layout(visible, created)

	for _, upgrade in ipairs(visible) do
		local card = cards[upgrade.Id]
		if card then
			-- Pastille : niveau (améliorations à plusieurs niveaux) ou nombre de visites à l'océan
			local level = Formulas.GetLevel(data, upgrade.Id)
			if upgrade.Effect == "Detox" then
				UIUtil.SetBadge(card.Badge, data.Rebirths or 0)
			elseif isRepeatable(upgrade) then
				UIUtil.SetBadge(card.Badge, level)
			else
				UIUtil.SetBadge(card.Badge, 0)
			end

			-- "Pop" quand le niveau augmente
			if level > card.Level and not created[upgrade.Id] then
				card.PopScale.Scale = 1.25
				UIUtil.Tween(card.PopScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
				card.Badge.Size = UDim2.fromOffset(34, 34)
				UIUtil.Tween(card.Badge, 0.3, { Size = UDim2.fromOffset(26, 26) }, Enum.EasingStyle.Back)
			end
			card.Level = level
			styleCard(card)
		end
	end

	if tipUpgradeId then
		refreshTooltip()
	end
end

----------------------------------------------------------------------
-- Construction
----------------------------------------------------------------------

-- `parent` : cadre de la colonne centrale ; `tooltipLayer` : calque plein écran
-- au-dessus des stimuli (pour l'infobulle)
function UpgradeBar.Build(parent: GuiObject, tooltipLayer: Frame): Frame
	bar = UIUtil.Create("Frame", {
		Name = "UpgradeBar",
		Size = UDim2.new(1, 0, 0, UpgradeBar.Height),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	scroll = UIUtil.Create("ScrollingFrame", {
		Name = "Cards",
		Size = UDim2.new(0, MAX_WIDTH, 1, 0),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollingDirection = Enum.ScrollingDirection.X,
		ScrollBarThickness = 0,
		ScrollBarImageColor3 = Theme.Colors.Dark,
		CanvasSize = UDim2.fromOffset(0, 0),
		ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
		Parent = bar,
	})

	buildTooltip(tooltipLayer)
	tooltip.Activated:Connect(function()
		lastUiTapClock = os.clock()
	end)
	tipButton.Activated:Connect(function()
		lastUiTapClock = os.clock()
		local id = tipUpgradeId
		if not id then
			return
		end
		local card = cards[id]
		if not tipButton:GetAttribute("Enabled") then
			failFeedback(card)
			return
		end
		buy(id)
	end)

	-- Type d'entrée (tactile ou souris)
	UserInputService.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.Touch then
			lastInputTouch = true
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
			lastInputTouch = false
		end
	end)
	UserInputService.InputChanged:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseMovement and not UserInputService.TouchEnabled then
			lastInputTouch = false
		end
	end)
	-- Appui ailleurs : on ferme l'infobulle "épinglée"
	UserInputService.InputEnded:Connect(function(input: InputObject)
		local inputType = input.UserInputType
		if inputType ~= Enum.UserInputType.Touch and inputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		local stamp = os.clock()
		task.delay(0.15, function()
			if tipPinned and lastUiTapClock < stamp - 0.25 then
				hideTooltip()
			end
		end)
	end)

	PanelManager.Opened:Connect(hideTooltip)

	-- Écran qui change : cartes, largeur et infobulle réajustées
	local function applyDevice()
		local touch = Interface.IsTouch()
		tooltip.Size = UDim2.fromOffset(touch and 330 or 280, 0)
		-- Bouton "Acheter" : zone tactile de 44 px au moins
		tipButton.Size = UDim2.fromOffset(0, touch and Theme.TouchTarget or 38)
		tipButton.TextSize = touch and 20 or 18
		for _, line in ipairs({ tipName, tipDesc, tipLevel, tipCost }) do
			local base = line:GetAttribute("BaseTextSize") or 16
			line.TextSize = touch and base + 3 or base
		end
		if ClientState.Data then
			refresh(ClientState.Data)
		end
	end
	Interface.DeviceChanged:Connect(applyDevice)
	Slots.Changed:Connect(applyDevice)
	applyDevice()

	-- Mises à jour
	ClientState.Changed:Connect(refresh)
	ClientState.FeaturesChanged:Connect(function()
		hdEnabled = ClientState.HasFeature("HDIcons")
		styleAll()
	end)
	ClientState.DarkModeChanged:Connect(function(dark: boolean)
		darkMode = dark
		styleAll()
	end)
	darkMode = ClientState.DarkMode

	-- Affordabilité (10 fois par seconde) + rotation des rayons HD
	local accumulator = 0
	RunService.RenderStepped:Connect(function(dt: number)
		if hdEnabled then
			local rotation = (os.clock() * 25) % 360
			for _, card in pairs(cards) do
				local rays = card.HD:FindFirstChild("Rays") :: Frame?
				if rays then
					rays.Rotation = rotation
				end
			end
		end
		accumulator += dt
		if accumulator < 0.1 then
			return
		end
		accumulator = 0
		for _, card in pairs(cards) do
			if not card.Removing then
				local affordable = canAfford(card.Upgrade)
				card.Icon.TextTransparency = affordable and 0 or 0.5
				card.Stroke.Transparency = affordable and 0 or 0.45
				-- Devient abordable : petit "pop" pour attirer l'œil
				if affordable and not card.Affordable and tipUpgradeId ~= card.Upgrade.Id then
					card.PopScale.Scale = 1.1
					UIUtil.Tween(card.PopScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
				end
				card.Affordable = affordable
			end
		end
		if tipUpgradeId then
			refreshTooltip()
		end
	end)

	if ClientState.Data then
		refresh(ClientState.Data)
	end
	return bar
end

-- Masque l'infobulle (ex. clic sur le gros bouton)
function UpgradeBar.HideTooltip()
	if not tipPinned then
		hideTooltip()
	end
end

return UpgradeBar
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">DarkSkin</string>
          <string name="Source"><![CDATA[--[[
	DarkSkin (ModuleScript)
	Emplacement : ReplicatedStorage > Client > DarkSkin

	"Habillage sombre" automatique de l'interface claire. Toute l'interface
	est construite avec la palette claire (Theme.Colors) ; quand le mode
	sombre est actif (ClientState.DarkMode : réglage ⚙️ du joueur, thème
	sombre ou mode néon), DarkSkin repeint les éléments des cadres
	enregistrés (Register) :
	  - fonds blancs / gris clairs -> gris très foncés (Theme.DarkUI),
	    les fonds pastel -> version sombre teintée ;
	  - textes noirs / gris foncés -> blanc cassé / gris clair, SEULEMENT
	    s'ils sont posés sur un fond qui devient sombre (un texte noir sur
	    une pastille jaune reste noir) ;
	  - contours noirs -> contours gris plus doux ;
	  - les couleurs vives (boutons verts, badges rouges...) ne changent pas.
	Les couleurs d'origine sont gardées en attributs ("DS_*") et remises
	quand le mode sombre s'arrête. Les changements faits ensuite par le code
	(ex. texte qui passe au rouge) sont suivis automatiquement.

	Un élément (et tout ce qu'il contient) peut être exclu avec l'attribut
	"DarkSkinIgnore" = true (ex. miniatures des thèmes).

	API : DarkSkin.Register(root), DarkSkin.SetEnabled(bool), DarkSkin.IsEnabled(),
	      DarkSkin.MapBackground(color), DarkSkin.MapText(color) (utilitaires).
]]

local Theme = require(script.Parent.Theme)

local DarkSkin = {}

local P = Theme.DarkUI
local WHITE = Color3.new(1, 1, 1)

local enabled = false
local roots: { [Instance]: boolean } = {}
-- Objets déjà "branchés" (écouteurs de propriétés) : clés faibles
local bound: { [Instance]: boolean } = setmetatable({}, { __mode = "k" }) :: any

-- Attributs : couleur d'origine (claire) et couleur appliquée (sombre)
local ATTR = {
	BackgroundColor3 = { "DS_Bg", "DS_BgOut" },
	TextColor3 = { "DS_Text", "DS_TextOut" },
	PlaceholderColor3 = { "DS_Ph", "DS_PhOut" },
	Color = { "DS_Stroke", "DS_StrokeOut" },
	ScrollBarImageColor3 = { "DS_Scroll", "DS_ScrollOut" },
}

----------------------------------------------------------------------
-- Couleurs
----------------------------------------------------------------------

local function luminance(color: Color3): number
	return Theme.Luminance(color)
end

local function saturation(color: Color3): number
	local _, s, _ = color:ToHSV()
	return s
end

-- Fond "clair" qui doit devenir sombre : blanc / gris clair, ou pastel très clair
local function isLightSurface(color: Color3): boolean
	local l = luminance(color)
	local s = saturation(color)
	if l >= 0.6 and s < 0.12 then
		return true
	end
	return l >= 0.86 and s < 0.4
end

-- Fond (couleur claire) -> fond sombre. Les autres couleurs ne changent pas.
function DarkSkin.MapBackground(color: Color3): Color3
	local l = luminance(color)
	local s = saturation(color)
	if isLightSurface(color) then
		-- Plus c'était clair, plus ça devient foncé (blanc -> carte sombre)
		local t = math.clamp((1 - l) / 0.4, 0, 1)
		local neutral = P.Card:Lerp(P.Raised, t)
		if s >= 0.05 then
			local h = color:ToHSV()
			local tinted = Color3.fromHSV(h, 0.45, P.TintedDark)
			return neutral:Lerp(tinted, math.clamp(s * 1.6, 0, 0.7))
		end
		return neutral
	end
	-- Gris foncés (pastilles "Dark") : un peu relevés pour rester visibles
	if s < 0.12 and l >= 0.12 and l < 0.35 then
		return color:Lerp(P.Raised, 0.35)
	end
	return color
end

-- Texte (couleur claire d'origine) posé sur un fond devenu sombre
function DarkSkin.MapText(color: Color3): Color3
	local l = luminance(color)
	local s = saturation(color)
	if s < 0.25 then
		if l < 0.25 then
			return P.Text
		elseif l < 0.55 then
			return P.TextDim
		end
		return color
	end
	-- Couleur foncée (vert foncé, bordeaux...) : éclaircie pour rester lisible
	if l < 0.4 then
		return color:Lerp(WHITE, 0.45)
	end
	return color
end

-- Contour (UIStroke en mode bordure)
local function mapStroke(color: Color3): Color3
	local l = luminance(color)
	local s = saturation(color)
	if s < 0.15 then
		if l < 0.35 then
			return P.Border
		elseif l >= 0.72 and l < 0.985 then
			return P.Divider
		end
	end
	return color
end

local function mapScroll(color: Color3): Color3
	if saturation(color) < 0.15 and luminance(color) < 0.45 then
		return P.Scroll
	end
	return color
end

----------------------------------------------------------------------
-- Analyse de l'arbre
----------------------------------------------------------------------

local function isIgnored(instance: Instance): boolean
	local node: Instance? = instance
	while node do
		if node:GetAttribute("DarkSkinIgnore") == true then
			return true
		end
		if roots[node] then
			return false
		end
		node = node.Parent
	end
	return false
end

-- Couleur de fond d'origine (claire) d'un objet
local function originalBg(guiObject: GuiObject): Color3
	local stored = guiObject:GetAttribute("DS_Bg")
	if typeof(stored) == "Color3" then
		return stored
	end
	return guiObject.BackgroundColor3
end

-- Dégradé coloré (ex. bouton aux couleurs d'un skin, carte "premium") :
-- le fond est alors donné par le dégradé, on n'y touche pas
local function hasColoredGradient(guiObject: Instance): boolean
	local gradient = guiObject:FindFirstChildOfClass("UIGradient")
	if not gradient or not gradient.Enabled then
		return false
	end
	for _, keypoint in ipairs(gradient.Color.Keypoints) do
		if saturation(keypoint.Value) > 0.2 then
			return true
		end
	end
	return false
end

-- Le fond de cet objet doit-il être assombri ?
local function shouldMapBg(guiObject: GuiObject): boolean
	return isLightSurface(originalBg(guiObject)) and not hasColoredGradient(guiObject)
end

-- Le texte de cet objet est-il posé sur un fond qui devient sombre ?
-- (premier ancêtre au fond visible ; aucun = fond du jeu, sombre aussi)
local function textOnDarkenedBg(textObject: GuiObject): boolean
	local node: Instance? = textObject
	while node and node:IsA("GuiObject") do
		local gui = node :: GuiObject
		if gui.BackgroundTransparency < 0.6 and gui.Visible then
			local bg = originalBg(gui)
			if hasColoredGradient(gui) then
				return false
			end
			if isLightSurface(bg) then
				return true
			end
			-- Fond foncé : le texte y est déjà clair (on ne touche qu'aux textes foncés)
			if luminance(bg) < 0.35 and saturation(bg) < 0.25 then
				return true
			end
			return false
		end
		if roots[node] then
			break
		end
		node = node.Parent
	end
	return true
end

----------------------------------------------------------------------
-- Application
----------------------------------------------------------------------

-- Applique (ou retire) la couleur sombre d'une propriété
local function applyProperty(instance: Instance, property: string, mapper: (Color3) -> Color3)
	local names = ATTR[property]
	local originalName, outName = names[1], names[2]
	local stored = instance:GetAttribute(originalName)
	if enabled then
		local original: Color3
		if typeof(stored) == "Color3" then
			original = stored
		else
			original = (instance :: any)[property]
			instance:SetAttribute(originalName, original)
		end
		local mapped = mapper(original)
		instance:SetAttribute(outName, mapped)
		if (instance :: any)[property] ~= mapped then
			(instance :: any)[property] = mapped
		end
	elseif typeof(stored) == "Color3" then
		instance:SetAttribute(originalName, nil)
		instance:SetAttribute(outName, nil)
		if (instance :: any)[property] ~= stored then
			(instance :: any)[property] = stored
		end
	end
end

local function identity(color: Color3): Color3
	return color
end

local function refreshText(guiObject: GuiObject)
	if not (guiObject:IsA("TextLabel") or guiObject:IsA("TextButton") or guiObject:IsA("TextBox")) then
		return
	end
	local mapper = textOnDarkenedBg(guiObject) and DarkSkin.MapText or identity
	applyProperty(guiObject, "TextColor3", mapper)
	if guiObject:IsA("TextBox") then
		applyProperty(guiObject, "PlaceholderColor3", mapper)
	end
end

local function refreshBg(guiObject: GuiObject)
	local mapper = shouldMapBg(guiObject) and DarkSkin.MapBackground or function(color: Color3): Color3
		-- Gris foncé (pastille "Dark") : légèrement relevé
		if saturation(color) < 0.12 and luminance(color) >= 0.12 and luminance(color) < 0.35 then
			return DarkSkin.MapBackground(color)
		end
		return color
	end
	applyProperty(guiObject, "BackgroundColor3", mapper)
end

local function processObject(instance: Instance)
	if instance:IsA("GuiObject") then
		refreshBg(instance)
		refreshText(instance)
		if instance:IsA("ScrollingFrame") then
			applyProperty(instance, "ScrollBarImageColor3", mapScroll)
		end
	elseif instance:IsA("UIStroke") then
		-- Contour de TEXTE (Contextual sur un texte) : on n'y touche pas
		local parent = instance.Parent
		local isTextOutline = instance.ApplyStrokeMode == Enum.ApplyStrokeMode.Contextual
			and parent ~= nil
			and (parent:IsA("TextLabel") or parent:IsA("TextButton") or parent:IsA("TextBox"))
		if not isTextOutline then
			applyProperty(instance, "Color", mapStroke)
		end
	end
end

-- Suit les changements faits par le code (nouvelle couleur "claire")
local function watchProperty(instance: Instance, property: string, onChange: () -> ())
	local outName = ATTR[property][2]
	instance:GetPropertyChangedSignal(property):Connect(function()
		if not enabled then
			return
		end
		local current = (instance :: any)[property]
		if current == instance:GetAttribute(outName) then
			return -- c'est notre propre couleur
		end
		instance:SetAttribute(ATTR[property][1], current)
		onChange()
	end)
end

-- Le fond d'un objet a (peut-être) changé de nature : on le repeint, lui et ses textes
local function refreshSurface(gui: GuiObject)
	refreshBg(gui)
	refreshText(gui)
	for _, descendant in ipairs(gui:GetDescendants()) do
		if descendant:IsA("GuiObject") and bound[descendant] then
			refreshText(descendant)
		end
	end
end

local function bind(instance: Instance)
	if bound[instance] then
		return
	end
	bound[instance] = true
	if instance:IsA("UIGradient") then
		-- Dégradé qui devient coloré (skin du bouton, cartes "HD"...) ou neutre :
		-- le fond de son parent doit être réévalué
		local function onGradientChanged()
			local parent = instance.Parent
			if enabled and parent and parent:IsA("GuiObject") and not isIgnored(parent) then
				refreshSurface(parent)
			end
		end
		instance:GetPropertyChangedSignal("Color"):Connect(onGradientChanged)
		instance:GetPropertyChangedSignal("Enabled"):Connect(onGradientChanged)
		return
	end
	if instance:IsA("GuiObject") then
		local gui = instance :: GuiObject
		-- Le fond a changé : ses textes (lui-même et ses enfants directs) aussi
		watchProperty(gui, "BackgroundColor3", function()
			refreshSurface(gui)
		end)
		if gui:IsA("TextLabel") or gui:IsA("TextButton") or gui:IsA("TextBox") then
			watchProperty(gui, "TextColor3", function()
				refreshText(gui)
			end)
		end
		if gui:IsA("ScrollingFrame") then
			watchProperty(gui, "ScrollBarImageColor3", function()
				applyProperty(gui, "ScrollBarImageColor3", mapScroll)
			end)
		end
	elseif instance:IsA("UIStroke") then
		watchProperty(instance, "Color", function()
			processObject(instance)
		end)
	end
end

local function handle(instance: Instance)
	local isGradient = instance:IsA("UIGradient")
	if not (instance:IsA("GuiObject") or instance:IsA("UIStroke") or isGradient) then
		return
	end
	if isIgnored(instance) then
		return
	end
	if enabled then
		bind(instance)
	end
	if isGradient then
		-- Dégradé ajouté après son parent : le fond du parent est réévalué
		local parent = instance.Parent
		if parent and parent:IsA("GuiObject") and bound[parent] then
			refreshSurface(parent)
		end
		return
	end
	processObject(instance)
end

local function processRoot(root: Instance)
	handle(root)
	for _, descendant in ipairs(root:GetDescendants()) do
		handle(descendant)
	end
end

----------------------------------------------------------------------
-- API
----------------------------------------------------------------------

-- Ajoute un cadre (et tout ce qu'il contient, même ajouté plus tard) à l'habillage
function DarkSkin.Register(root: Instance)
	if roots[root] then
		return
	end
	roots[root] = true
	root.DescendantAdded:Connect(function(descendant)
		if enabled and roots[root] then
			handle(descendant)
		end
	end)
	root.Destroying:Connect(function()
		roots[root] = nil
	end)
	if enabled then
		processRoot(root)
	end
end

-- Active / coupe le mode sombre de l'interface
function DarkSkin.SetEnabled(value: boolean)
	local newValue = value == true
	if newValue == enabled then
		return
	end
	enabled = newValue
	for root in pairs(roots) do
		if root.Parent then
			processRoot(root)
		end
	end
end

function DarkSkin.IsEnabled(): boolean
	return enabled
end

return DarkSkin
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">Effects</string>
          <string name="Source"><![CDATA[--[[
	Effects (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Effects

	Effets visuels 2D : textes flottants "+X", particules, confettis,
	flash d'écran, gros messages. (Les ParticleEmitter ne fonctionnent pas
	dans les interfaces, on anime donc de petits Frames.)
	Le réglage "Effets" (SetEnabled) coupe particules et confettis.
]]

local Debris = game:GetService("Debris")

local Theme = require(script.Parent.Theme)
local UIUtil = require(script.Parent.UIUtil)

local Effects = {}

local layer: Frame? = nil -- calque plein écran pour les effets
local enabled = true -- paramètre "Effets" (particules / confettis)
local random = Random.new()
local activeParticles = 0
local activeTexts = 0
local MAX_PARTICLES = 160 -- limite pour les petits appareils
local MAX_TEXTS = 60

local CONFETTI_COLORS = {
	Theme.Colors.Pink,
	Theme.Colors.Cyan,
	Theme.Colors.Purple,
	Theme.Colors.Yellow,
	Theme.Colors.Green,
	Theme.Colors.Orange,
	Theme.Colors.Red,
	Theme.Colors.Blue,
}

function Effects.Init(effectsLayer: Frame)
	layer = effectsLayer
end

function Effects.SetEnabled(value: boolean)
	enabled = value
end

function Effects.IsEnabled(): boolean
	return enabled
end

-- Calque plein écran des effets (nil avant Init)
function Effects.GetLayer(): Frame?
	return layer
end

-- Dans un emplacement de stimulus (calque "Slots", ClipsDescendants = true), un
-- texte qui monte de 100 px serait coupé : on le redessine dans le calque
-- "Overlay" (non coupé, sous les menus) à la même position à l'écran.
local function unclip(parent: GuiObject, position: UDim2): (GuiObject, UDim2)
	local root = layer and layer.Parent
	local slots = root and root:FindFirstChild("Slots")
	local overlay = root and root:FindFirstChild("Overlay")
	if not root or not slots or not overlay or not overlay:IsA("GuiObject") or not parent:IsDescendantOf(slots) then
		return parent, position
	end
	local clipped = false
	local node: Instance? = parent
	while node and node ~= slots do
		if node:IsA("GuiObject") and node.ClipsDescendants then
			clipped = true
			break
		end
		node = node.Parent
	end
	if not clipped then
		return parent, position
	end
	local uiScale = root:FindFirstChildOfClass("UIScale")
	local scale = uiScale and uiScale.Scale or 1
	if scale <= 0 then
		return parent, position
	end
	-- Les décalages (Offset) sont agrandis par TOUS les UIScale au-dessus du
	-- parent (toile + échelle du slot sur téléphone)
	local factor = 1
	local node2: Instance? = parent
	while node2 and node2 ~= root.Parent do
		local nodeScale = node2:FindFirstChildOfClass("UIScale")
		if nodeScale then
			factor *= nodeScale.Scale
		end
		node2 = node2.Parent
	end
	local absolute = parent.AbsolutePosition
		+ parent.AbsoluteSize * Vector2.new(position.X.Scale, position.Y.Scale)
		+ Vector2.new(position.X.Offset, position.Y.Offset) * factor
	local canvas = (absolute - overlay.AbsolutePosition) / scale
	return overlay, UDim2.fromOffset(canvas.X, canvas.Y)
end

-- Texte "+X" qui monte et disparaît
function Effects.FloatingText(parent: GuiObject, position: UDim2, text: string, color: Color3?, size: number?)
	if activeTexts >= MAX_TEXTS or not parent or not parent.Parent then
		return
	end
	parent, position = unclip(parent, position)
	activeTexts += 1
	local height = size or 34
	local textColor = color or Theme.Colors.Text
	local label = UIUtil.Label({
		Text = text,
		Font = Theme.Fonts.Number,
		TextColor3 = textColor,
		Size = UDim2.fromOffset(height * 6, height),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = position,
		Rotation = random:NextNumber(-10, 10),
		ZIndex = 50,
		MaxTextSize = height,
		Parent = parent,
	})
	-- Contour contrasté : blanc autour d'un texte foncé, noir autour d'un texte clair
	local strokeColor = Theme.Luminance(textColor) > 0.5 and Theme.Colors.TextDark or Theme.Colors.TextLight
	local stroke = UIUtil.Stroke(label, strokeColor, 2)
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual

	local scale = UIUtil.Create("UIScale", { Scale = 0.4, Parent = label })
	UIUtil.Tween(scale, 0.18, { Scale = 1.1 }, Enum.EasingStyle.Back)
	UIUtil.Tween(label, 0.9, {
		Position = position + UDim2.fromOffset(random:NextNumber(-30, 30), -100),
		TextTransparency = 1,
	}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	UIUtil.Tween(stroke, 0.9, { Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(1, function()
		activeTexts -= 1
		label:Destroy()
	end)
end

-- Explosion de petites particules rondes autour d'un point
function Effects.Burst(parent: GuiObject, position: UDim2, color: Color3?, count: number?)
	if not enabled or not parent or not parent.Parent then
		return
	end
	for _ = 1, count or 8 do
		if activeParticles >= MAX_PARTICLES then
			return
		end
		activeParticles += 1
		local size = random:NextInteger(6, 14)
		local particle = UIUtil.Create("Frame", {
			Size = UDim2.fromOffset(size, size),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = position,
			BackgroundColor3 = color or CONFETTI_COLORS[random:NextInteger(1, #CONFETTI_COLORS)],
			BorderSizePixel = 0,
			ZIndex = 40,
			Parent = parent,
		})
		UIUtil.Corner(particle, UDim.new(1, 0))

		local angle = random:NextNumber(0, math.pi * 2)
		local distance = random:NextNumber(50, 140)
		local duration = random:NextNumber(0.4, 0.7)
		UIUtil.Tween(particle, duration, {
			Position = position + UDim2.fromOffset(math.cos(angle) * distance, math.sin(angle) * distance),
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(2, 2),
		}, Enum.EasingStyle.Quart)
		task.delay(duration, function()
			activeParticles -= 1
			particle:Destroy()
		end)
	end
end

-- Pluie de confettis sur tout l'écran
function Effects.Confetti(count: number?)
	local target = layer
	if not enabled or not target then
		return
	end
	for _ = 1, count or 80 do
		if activeParticles >= MAX_PARTICLES then
			return
		end
		activeParticles += 1
		local piece = UIUtil.Create("Frame", {
			Size = UDim2.fromOffset(random:NextInteger(8, 16), random:NextInteger(14, 24)),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(random:NextNumber(0, 1), 0, 0, random:NextInteger(-200, -20)),
			Rotation = random:NextNumber(0, 360),
			BackgroundColor3 = CONFETTI_COLORS[random:NextInteger(1, #CONFETTI_COLORS)],
			BorderSizePixel = 0,
			ZIndex = 90,
			Parent = target,
		})
		local duration = random:NextNumber(1.6, 3)
		local start = piece.Position
		UIUtil.Tween(piece, duration, {
			Position = UDim2.new(start.X.Scale + random:NextNumber(-0.15, 0.15), 0, 1.1, 0),
			Rotation = piece.Rotation + random:NextNumber(-720, 720),
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(duration, function()
			activeParticles -= 1
			piece:Destroy()
		end)
	end
end

-- Flash coloré de tout l'écran
function Effects.Flash(color: Color3?, strength: number?)
	local target = layer
	if not target then
		return
	end
	local flash = UIUtil.Create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = color or Color3.new(1, 1, 1),
		BackgroundTransparency = 1 - (strength or 0.6),
		BorderSizePixel = 0,
		ZIndex = 95,
		Parent = target,
	})
	UIUtil.Tween(flash, 0.6, { BackgroundTransparency = 1 })
	Debris:AddItem(flash, 0.7)
end

-- Gros message au centre de l'écran (jackpot, rush...)
function Effects.BigMessage(text: string, color: Color3?, duration: number?)
	local target = layer
	if not target then
		return
	end
	local label = UIUtil.Label({
		Text = text,
		Font = Theme.Fonts.Title,
		TextColor3 = color or Theme.Colors.Yellow,
		Size = UDim2.new(0.9, 0, 0, 110),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		ZIndex = 100,
		MaxTextSize = 90,
		Parent = target,
	})
	local stroke = UIUtil.Stroke(label, Theme.Colors.TextDark, 4)
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual

	local scale = UIUtil.Create("UIScale", { Scale = 0.1, Parent = label })
	UIUtil.Tween(scale, 0.5, { Scale = 1 }, Enum.EasingStyle.Elastic)

	-- Petit clignotement de couleur
	task.spawn(function()
		local colors = { color or Theme.Colors.Yellow, Theme.Colors.Cyan, Theme.Colors.Pink, Theme.Colors.Green }
		local index = 0
		local finish = os.clock() + (duration or 2.5)
		while label.Parent and os.clock() < finish do
			index = index % #colors + 1
			label.TextColor3 = colors[index]
			task.wait(0.12)
		end
		if not label.Parent then
			return
		end
		UIUtil.Tween(label, 0.4, { TextTransparency = 1 })
		UIUtil.Tween(stroke, 0.4, { Transparency = 1 })
		task.wait(0.4)
		label:Destroy()
	end)
end

return Effects
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">Interface</string>
          <string name="Source"><![CDATA[--[[
	Interface (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Interface

	Crée la ScreenGui et la "toile virtuelle" responsive :
	  - toute l'interface est pensée pour un écran de 1280x720 ;
	  - un UIScale agrandit / réduit l'ensemble selon l'écran réel
	    (PC, mobile, tablette) ;
	  - le cadre "Root" s'étire pour toujours couvrir toute la zone sûre
	    (hors encoche et barre Roblox ; sa taille en pixels "design" est
	    donc >= 1280x720 dans un sens) ;
	  - une ScreenGui de fond séparée remplit tout l'écran (couleurs du
	    thème équipé, ou fond sombre du mode néon).

	Calques (du plus bas au plus haut), tous plein écran, transparents et
	non "Active" (les clics passent à travers) :
	  Background < Slots < Main < Overlay < Panels < Toasts < Effects < Cinematic

	v5 : profil d'appareil (Interface.Device = "Phone" | "Tablet" | "Desktop",
	signal Interface.DeviceChanged). Sur téléphone / tablette, la toile de
	référence est plus petite (Theme.DeviceResolutions : 960x540, 1120x630) :
	tout est donc affiché plus gros. Les composants s'adaptent (colonne
	centrale, fenêtres, bandeaux) et les emplacements des stimuli rétrécissent
	si besoin (voir Slots). Sur PC rien ne change (toile 1280x720).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Theme = require(script.Parent.Theme)
local UIUtil = require(script.Parent.UIUtil)
local Signal = require(ReplicatedStorage.Shared.Signal)
local Config = require(ReplicatedStorage.Shared.Config)
local ClientState = require(script.Parent.ClientState)

local Interface = {}

Interface.ScreenGui = nil :: ScreenGui?
Interface.Root = nil :: Frame?
Interface.Layers = {} :: { [string]: Frame }
Interface.Scale = 1
Interface.CanvasSize = Theme.DesignResolution -- taille de la toile en pixels "design"
Interface.ScaleChanged = Signal.new() -- (scale, canvasSize)
Interface.Device = "Desktop" -- "Phone" | "Tablet" | "Desktop"
Interface.DeviceChanged = Signal.new() -- (device)
Interface.DesignResolution = Theme.DesignResolution -- toile de référence de l'appareil

-- Forçage du profil (tests dans Studio) : nil = détection automatique
local deviceOverride: string? = nil
local updateScaleFn: (() -> ())? = nil

-- Profil d'appareil : téléphone = tactile ET petit écran (< 500 px de côté),
-- tablette = tactile et plus grand, sinon PC (un PC tactile avec souris reste "Desktop")
local function detectDevice(): string
	if deviceOverride then
		return deviceOverride
	end
	local touch = UserInputService.TouchEnabled and not UserInputService.MouseEnabled
	if not touch then
		return "Desktop"
	end
	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
	if math.min(viewport.X, viewport.Y) < 500 then
		return "Phone"
	end
	return "Tablet"
end

Interface.LayerOrder = { "Background", "Slots", "Main", "Overlay", "Panels", "Toasts", "Effects", "Cinematic" }

function Interface.Build(): ScreenGui
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui
	-- Le jeu se joue en paysage sur mobile
	playerGui.ScreenOrientation = Enum.ScreenOrientation.LandscapeSensor

	for _, name in ipairs({ "DopamineGui", "DopamineBackdrop" }) do
		local old = playerGui:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end

	-- Fond plein écran (sous l'encoche / la barre Roblox) : simple couleur,
	-- pour ne jamais voir le monde 3D autour de la zone sûre
	local backdropGui = UIUtil.Create("ScreenGui", {
		Name = "DopamineBackdrop",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 0,
		Parent = playerGui,
	})
	local backdrop = UIUtil.Create("Frame", {
		Name = "Backdrop",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Active = false,
		Size = UDim2.fromScale(1, 1),
		Parent = backdropGui,
	})
	local backdropGradient = UIUtil.Gradient(backdrop, ColorSequence.new(Theme.Colors.Background, Theme.Colors.BackgroundBottom), 90)
	local lastKey = ""
	local function applyBackdrop()
		local data = ClientState.Data
		local themeId = (data and type(data.Themes) == "table" and data.Themes.Equipped) or "Classic"
		local theme = Config.ThemesById[themeId]
		local dark = ClientState.DarkMode
		-- Mode sombre du joueur : seul le thème Classique passe en fond sombre
		-- (les autres thèmes gardent leur fond ; le néon reste presque noir)
		local userDarkClassic = ClientState.HasDarkSource("User") and themeId == "Classic"
		local neonDark = dark and not userDarkClassic and (ClientState.HasDarkSource("Stimuli") or ClientState.HasDarkSource("Main"))
		local key = tostring(themeId) .. (dark and ":dark" or ":light") .. (userDarkClassic and ":user" or "") .. (neonDark and ":neon" or "")
		if key == lastKey then
			return
		end
		lastKey = key
		if userDarkClassic and not neonDark then
			backdrop.BackgroundColor3 = Color3.new(1, 1, 1)
			backdropGradient.Color = ColorSequence.new(Theme.DarkUI.Background, Theme.DarkUI.BackgroundBottom)
			backdropGradient.Enabled = true
		elseif theme and (theme.Dark or not neonDark) then
			-- Couleurs du thème (sombre ou clair)
			backdrop.BackgroundColor3 = Color3.new(1, 1, 1)
			backdropGradient.Color = ColorSequence.new(theme.Top, theme.Bottom)
			backdropGradient.Enabled = true
		elseif dark then
			-- Mode néon sur un thème clair : fond presque noir
			backdrop.BackgroundColor3 = Theme.DarkColors.Background
			backdropGradient.Enabled = false
		else
			backdrop.BackgroundColor3 = Color3.new(1, 1, 1)
			backdropGradient.Color = ColorSequence.new(Theme.Colors.Background, Theme.Colors.BackgroundBottom)
			backdropGradient.Enabled = true
		end
	end
	ClientState.DarkModeChanged:Connect(applyBackdrop)
	ClientState.DarkSourcesChanged:Connect(applyBackdrop)
	ClientState.Changed:Connect(applyBackdrop)
	applyBackdrop()

	-- L'interface du jeu reste dans la zone sûre : ni sous l'encoche des
	-- téléphones, ni sous les boutons Roblox de la barre du haut
	local screenGui = UIUtil.Create("ScreenGui", {
		Name = "DopamineGui",
		ResetOnSpawn = false,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
		DisplayOrder = 1,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	}) :: ScreenGui

	-- Toile virtuelle mise à l'échelle
	local root = UIUtil.Create("Frame", {
		Name = "Root",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(Theme.DesignResolution.X, Theme.DesignResolution.Y),
		ZIndex = 2,
		Parent = screenGui,
	})
	local uiScale = UIUtil.Create("UIScale", { Parent = root })

	for index, name in ipairs(Interface.LayerOrder) do
		Interface.Layers[name] = UIUtil.Create("Frame", {
			Name = name,
			BackgroundTransparency = 1,
			Active = false,
			Size = UDim2.fromScale(1, 1),
			ZIndex = index,
			Parent = root,
		})
	end

	-- Recalcule l'échelle quand la zone sûre (taille de la ScreenGui) change
	local function updateScale()
		local available = screenGui.AbsoluteSize
		if available.X < 1 or available.Y < 1 then
			return
		end
		local device = detectDevice()
		local design = Theme.DeviceResolutions[device] or Theme.DesignResolution
		local scale = math.clamp(math.min(available.X / design.X, available.Y / design.Y), Theme.MinScale, Theme.MaxScale)
		local canvas = Vector2.new(available.X / scale, available.Y / scale)
		local deviceChanged = device ~= Interface.Device
		Interface.Device = device
		Interface.DesignResolution = design
		Interface.Scale = scale
		Interface.CanvasSize = canvas
		uiScale.Scale = scale
		-- Root fait (zone sûre / échelle) pour la couvrir exactement une fois agrandi
		root.Size = UDim2.fromOffset(canvas.X, canvas.Y)
		if deviceChanged then
			Interface.DeviceChanged:Fire(device)
		end
		Interface.ScaleChanged:Fire(scale, canvas)
	end
	updateScaleFn = updateScale

	screenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateScale)
	-- Tactile / souris qui apparaissent (tablette + clavier...) : on revérifie le profil
	UserInputService.LastInputTypeChanged:Connect(function()
		if detectDevice() ~= Interface.Device then
			updateScale()
		end
	end)
	Interface.Device = detectDevice()
	updateScale()

	Interface.ScreenGui = screenGui
	Interface.Root = root
	return screenGui
end

-- Vrai sur téléphone (interface compacte : une seule ligne de menus, etc.)
function Interface.IsPhone(): boolean
	return Interface.Device == "Phone"
end

-- Vrai sur téléphone ou tablette (écran tactile sans souris)
function Interface.IsTouch(): boolean
	return Interface.Device ~= "Desktop"
end

-- Force un profil ("Phone" | "Tablet" | "Desktop") pour tester dans Studio ; nil = auto
function Interface.SetDeviceOverride(device: string?)
	if device ~= nil and Theme.DeviceResolutions[device] == nil then
		return
	end
	deviceOverride = device
	local update = updateScaleFn
	if update then
		update()
	end
end

-- Convertit une position écran (pixels réels, ex. AbsolutePosition) en
-- position sur la toile (pixels "design").
function Interface.ScreenToCanvas(point: Vector2): Vector2
	local root = Interface.Root
	if not root then
		return point
	end
	return (point - root.AbsolutePosition) / Interface.Scale
end

-- Centre d'un élément, en coordonnées de la toile (pour placer des effets
-- dans un calque plein écran, ex. Effects.Burst(layer, UDim2.fromOffset(...)))
function Interface.GetCanvasCenter(guiObject: GuiObject): Vector2
	return Interface.ScreenToCanvas(guiObject.AbsolutePosition + guiObject.AbsoluteSize / 2)
end

-- Même chose, mais sous forme de UDim2 prête à l'emploi
function Interface.CanvasPosition(guiObject: GuiObject, offset: Vector2?): UDim2
	local center = Interface.GetCanvasCenter(guiObject) + (offset or Vector2.zero)
	return UDim2.fromOffset(center.X, center.Y)
end

return Interface
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">Slots</string>
          <string name="Source"><![CDATA[--[[
	Slots (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Slots

	Emplacements nommés de l'écran (toile de 1280x720 pixels "design") où
	les stimuli (Client > Stimuli) viennent se placer.

	Ancrage horizontal :
	  "L" = décalage depuis le bord gauche, "R" = depuis le bord droit,
	  "C" = centré (X = décalage du CENTRE du slot par rapport au centre),
	  "T" = toute la largeur.
	Verticalement, les slots de la moitié haute sont accrochés en haut et
	ceux de la moitié basse en bas : sur un écran plus haut que 16:9
	(tablette), l'espace libre se retrouve au milieu.

	Spéciaux : "Overlay" (plein écran, calque Overlay) et "Background"
	(plein écran, calque Background, sous tout le reste).

	La colonne centrale (bouton, compteur, améliorations) occupe
	x ∈ [centre-300, centre+300], y ∈ [30, 425] : elle doit rester lisible.

	v5 (téléphones / tablettes) : la toile y est plus petite (tout est plus
	gros), donc chaque slot reçoit une échelle (UIScale "SlotScale" sur son
	cadre, voir Slots.GetScale) pour ne pas recouvrir la colonne centrale.
	Le cadre garde sa taille "design" (288x190...) : les stimuli se
	construisent comme avant, tout est simplement réduit. Sur PC l'échelle
	vaut 1 et les positions sont exactement celles du tableau.
	Slots.Changed est déclenché quand la mise en page change (rotation...).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Signal = require(ReplicatedStorage.Shared.Signal)

local Slots = {}

Slots.DesignHeight = 720
Slots.Changed = Signal.new() -- () : échelles / positions recalculées

-- { Anchor, X, Y, W, H } (H = 0 et Anchor "T" : toute la largeur)
Slots.Definitions = {
	Ticker = { Anchor = "T", X = 0, Y = 0, W = 0, H = 30 },
	L1 = { Anchor = "L", X = 16, Y = 40, W = 288, H = 190 },
	R1 = { Anchor = "R", X = 16, Y = 40, W = 288, H = 190 },
	L2 = { Anchor = "L", X = 16, Y = 240, W = 288, H = 180 },
	R2 = { Anchor = "R", X = 16, Y = 240, W = 288, H = 180 },
	CL = { Anchor = "C", X = -250, Y = 40, W = 170, H = 170 },
	CR = { Anchor = "C", X = 250, Y = 40, W = 170, H = 170 },
	L3 = { Anchor = "L", X = 16, Y = 436, W = 384, H = 268 },
	C3 = { Anchor = "C", X = 0, Y = 436, W = 384, H = 268 },
	R3 = { Anchor = "R", X = 16, Y = 436, W = 384, H = 268 },
}

local TICKER_HEIGHT = 30
-- Bas de la colonne centrale (pixels "design") sur téléphone / tablette
local PHONE_COLUMN_BOTTOM = 388
local TABLET_COLUMN_BOTTOM = 456
local bound = false

-- Mise en page actuelle : { Device, Canvas, Scales = { [slot] = number }, CenterOffset = number }
local layout = {
	Device = "Desktop",
	Canvas = Vector2.new(1280, 720),
	Scales = {} :: { [string]: number },
	CenterOffset = 250, -- décalage horizontal de CL / CR (centre du slot)
}

-- Cadres créés par Slots.Create (pour les replacer si l'écran change)
local frames: { [Frame]: string } = setmetatable({}, { __mode = "k" }) :: any

-- Vrai si `name` est un emplacement connu (y compris Overlay / Background)
function Slots.IsValid(name: string): boolean
	return Slots.Definitions[name] ~= nil or name == "Overlay" or name == "Background"
end

-- Nom du calque de l'Interface où doit aller ce slot
function Slots.GetLayerName(name: string): string
	if name == "Overlay" then
		return "Overlay"
	elseif name == "Background" then
		return "Background"
	end
	return "Slots"
end

-- Échelle d'un slot (1 sur PC ; plus petite sur téléphone / tablette)
function Slots.GetScale(name: string): number
	return layout.Scales[name] or 1
end

-- Profil actuel ("Phone" | "Tablet" | "Desktop")
function Slots.GetDevice(): string
	return layout.Device
end

-- Calcule les échelles selon l'appareil et la taille de la toile (pixels "design").
-- Téléphone : la colonne centrale occupe le centre (voir GetCenterClearWidth)
-- et descend jusqu'à y ≈ 388 (toile de 540 de haut) ; tablette : ±340 et y ≈ 456.
local function computeLayout(device: string, canvas: Vector2)
	local scales: { [string]: number } = {}
	local centerOffset = 250
	local W, H = canvas.X, canvas.Y
	if device == "Phone" then
		-- Côtés : 0.75 (L1/L2/R1/R2), un peu moins si l'écran est étroit
		local side = math.clamp((W / 2 - 250) / 304, 0.6, 0.75)
		-- Rangée du bas : sous la colonne (qui finit vers y = 380)
		local bottomRoom = math.max(120, H - 12 - PHONE_COLUMN_BOTTOM)
		local center = math.clamp(bottomRoom / 268, 0.45, 0.62)
		local low = math.clamp(math.min(bottomRoom / 268 + 0.04, (W / 2 - 12 - 192 * center) / 400), 0.45, 0.66)
		local corner = math.clamp(side * 0.9, 0.55, 0.68)
		for _, name in ipairs({ "L1", "R1", "L2", "R2" }) do
			scales[name] = side
		end
		scales.L3, scales.R3, scales.C3 = low, low, center
		scales.CL, scales.CR = corner, corner
		-- CL / CR : entre les slots de côté et le bouton
		local sideEdge = (16 + 288) * side
		centerOffset = math.clamp(W / 2 - sideEdge - 8 - 85 * corner, 180, 250)
	elseif device == "Tablet" then
		local side = math.clamp((W / 2 - 340 - 8) / 304, 0.6, 1)
		local bottom = math.clamp(math.min((W / 2 - 8) / 592, (H - 16 - TABLET_COLUMN_BOTTOM) / 268), 0.55, 1)
		for _, name in ipairs({ "L1", "R1", "L2", "R2" }) do
			scales[name] = side
		end
		scales.L3, scales.R3, scales.C3 = bottom, bottom, bottom
		scales.CL, scales.CR = side, side
		local sideEdge = (16 + 288) * side
		centerOffset = math.clamp(W / 2 - sideEdge - 8 - 85 * side, 190, 250)
	end
	layout.Device = device
	layout.Canvas = canvas
	layout.Scales = scales
	layout.CenterOffset = centerOffset
end

-- Position (centre, AnchorPoint 0.5/0.5) et taille "design" d'un slot
-- (la taille réelle = taille x Slots.GetScale(name))
function Slots.GetPlacement(name: string): (UDim2, UDim2)
	local def = Slots.Definitions[name]
	if not def then
		return UDim2.fromScale(0.5, 0.5), UDim2.fromScale(1, 1)
	end
	local k = Slots.GetScale(name)

	local centerY = def.Y + def.H / 2
	local yUDim
	if centerY > Slots.DesignHeight / 2 then
		-- accroché en bas : marge (et hauteur) réduites de la même façon
		local bottomMargin = Slots.DesignHeight - (def.Y + def.H)
		yUDim = UDim.new(1, -(bottomMargin * k + def.H * k / 2))
	else
		-- accroché en haut, sous le bandeau d'actualités
		local top = def.Y
		if k ~= 1 and def.Anchor ~= "T" then
			top = TICKER_HEIGHT + (def.Y - TICKER_HEIGHT) * k
		end
		yUDim = UDim.new(0, top + def.H * k / 2)
	end

	local xUDim
	local size
	if def.Anchor == "T" then
		xUDim = UDim.new(0.5, 0)
		size = UDim2.new(1, 0, 0, def.H)
	elseif def.Anchor == "L" then
		xUDim = UDim.new(0, (def.X + def.W / 2) * k)
		size = UDim2.fromOffset(def.W, def.H)
	elseif def.Anchor == "R" then
		xUDim = UDim.new(1, -(def.X + def.W / 2) * k)
		size = UDim2.fromOffset(def.W, def.H)
	else -- "C"
		local offset = def.X
		if k ~= 1 and def.X ~= 0 then
			offset = (def.X < 0 and -1 or 1) * layout.CenterOffset
		end
		xUDim = UDim.new(0.5, offset)
		size = UDim2.fromOffset(def.W, def.H)
	end
	return UDim2.new(xUDim, yUDim), size
end

-- Replace un cadre de slot (position + UIScale "SlotScale")
local function place(frame: Frame, name: string)
	local position, size = Slots.GetPlacement(name)
	frame.Position = position
	frame.Size = size
	local scale = frame:FindFirstChild("SlotScale")
	if scale and scale:IsA("UIScale") and not frame:GetAttribute("SlotAnimating") then
		scale.Scale = Slots.GetScale(name)
	end
end

-- Recalcule la mise en page (appelé par Slots.Bind quand l'écran change)
function Slots.UpdateLayout(device: string, canvas: Vector2)
	computeLayout(device, canvas)
	for frame, name in pairs(frames) do
		if frame.Parent then
			place(frame, name)
		end
	end
	Slots.Changed:Fire()
end

-- Largeur (pixels "design") laissée libre au centre par les slots de côté
-- (L1/L2/R1/R2) : la colonne centrale ne doit pas dépasser. Sur PC : 1280 - 2 x 312.
function Slots.GetCenterClearWidth(): number
	local side = layout.Scales.L1 or 1
	return layout.Canvas.X - 2 * ((16 + 288) * side + 8)
end

-- Branche la mise en page sur l'Interface (profil d'appareil + taille de la toile).
-- Plusieurs appels possibles (un seul branchement).
function Slots.Bind(interface: any)
	if bound then
		return
	end
	bound = true
	local function update()
		Slots.UpdateLayout(interface.Device or "Desktop", interface.CanvasSize or Vector2.new(1280, 720))
	end
	interface.ScaleChanged:Connect(update)
	interface.DeviceChanged:Connect(update)
	update()
end

-- Crée le cadre (transparent) d'un slot dans `parent`.
-- Slots réels : ClipsDescendants = true + UIScale "SlotScale" (échelle du slot).
-- Overlay / Background : plein écran.
function Slots.Create(name: string, parent: Instance?): Frame
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.Active = false
	frame.AnchorPoint = Vector2.new(0.5, 0.5)

	if name == "Overlay" or name == "Background" or not Slots.Definitions[name] then
		if not Slots.IsValid(name) then
			warn("[Slots] Emplacement inconnu : " .. tostring(name) .. " (plein écran utilisé)")
		end
		frame.Position = UDim2.fromScale(0.5, 0.5)
		frame.Size = UDim2.fromScale(1, 1)
		frame.ClipsDescendants = false
	else
		frame.ClipsDescendants = true
		if Slots.Definitions[name].Anchor ~= "T" then
			local scale = Instance.new("UIScale")
			scale.Name = "SlotScale"
			scale.Scale = Slots.GetScale(name)
			scale.Parent = frame
		end
		place(frame, name)
		frames[frame] = name
	end

	frame.Parent = parent
	return frame
end

return Slots
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">SoundManager</string>
          <string name="Source"><![CDATA[--[[
	SoundManager (ModuleScript)
	Emplacement : ReplicatedStorage > Client > SoundManager

	Joue les sons et la musique (côté client uniquement).
	- Sons : IDs dans Config.Sounds, joués avec SoundManager.Play(nom, hauteur).
	- Musique : vraie playlist lofi (Config.Music.Playlist). Les pistes avec
	  Id = "" sont ignorées ; ordre mélangé si Config.Music.Shuffle ; fondu
	  enchaîné entre deux morceaux ; passe au suivant à la fin d'un morceau
	  ou si un morceau ne se charge pas ; la playlist tourne en boucle.

	La musique ne joue que si le réglage "Musique" est activé
	(SetMusicEnabled) ET qu'elle est autorisée (SetMusicAllowed : ClientMain
	l'autorise quand le joueur possède la Feature "Lofi").

	Volumes (0 à 1, gardés en mémoire pour la session) : SetMusicVolume /
	SetEffectsVolume, appliqués via deux SoundGroups ("Musique", "Effets").

	Son du clic (v4) : le joueur choisit son son de clic dans ⚙️ Paramètres
	(Config.ClickSounds, sauvegardé côté serveur dans Settings.ClickSound).
	SoundManager.PlayClick(hauteur) joue le son choisi pour le gros bouton
	(repli : Config.Sounds.Click). Play("Click") reste le petit clic de l'interface.

	Signaux :
	  SoundManager.TrackChanged (nom?, sound?)  : un nouveau morceau commence
	                                             (nil, nil quand la musique s'arrête)
	  SoundManager.MusicStateChanged (joue)      : la musique démarre / s'arrête
	  SoundManager.VolumeChanged (musique, effets)
	  SoundManager.ClickSoundChanged (id)        : le son du clic a changé
]]

local ContentProvider = game:GetService("ContentProvider")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Signal = require(ReplicatedStorage.Shared.Signal)
local Locale = require(ReplicatedStorage.Shared.Locale)

local SoundManager = {}

-- Nom affiché d'un morceau, dans la langue du joueur ("Track 2" sans nom)
local function trackName(track): string
	if track.Name then
		return Locale.T(track.Name)
	end
	return Locale.T("Track %d", track.Index or 1)
end

SoundManager.TrackChanged = Signal.new() -- (name: string?, sound: Sound?)
SoundManager.MusicStateChanged = Signal.new() -- (playing: boolean)
SoundManager.VolumeChanged = Signal.new() -- (musicVolume, effectsVolume)
SoundManager.ClickSoundChanged = Signal.new() -- (clickSoundId)

local MIN_INTERVAL = 0.035 -- évite d'empiler 20 fois le même son dans la même image
local CROSSFADE = 2.5 -- durée (s) du fondu enchaîné entre deux morceaux
local FADE_IN = 1.5 -- fondu à la reprise
local FADE_OUT = 1 -- fondu à la coupure
local LOAD_TIMEOUT = 10 -- (s) au-delà, un morceau qui ne charge pas est sauté
local RETRY_DELAY = 30 -- (s) si AUCUN morceau ne charge, on réessaie plus tard

local soundEnabled = true
local musicEnabled = true -- réglage du joueur
local musicAllowed = false -- Feature "Lofi" possédée
local musicVolume = math.clamp(tonumber(Config.Music and Config.Music.DefaultVolume) or 0.35, 0, 1)
local effectsVolume = 1

local folder: Folder? = nil
local effectsGroup: SoundGroup? = nil
local musicGroup: SoundGroup? = nil
local templates: { [string]: Sound } = {}
local lastPlayed: { [string]: number } = {}

-- Sons de clic au choix (Config.ClickSounds)
local DEFAULT_CLICK_SOUND = "Default"
local clickTemplates: { [string]: Sound } = {} -- [Id] = modèle de son
local clickSoundId = DEFAULT_CLICK_SOUND
local lastClick = 0

-- Playlist
type Track = { Name: string?, Index: number?, Id: string }
local tracks: { Track } = {} -- pistes valides (Id non vide)
local order: { number } = {} -- ordre de lecture (indices dans `tracks`)
local orderPosition = 0
local current: Sound? = nil
local currentTrack: Track? = nil
local generation = 0 -- change à chaque nouveau morceau (annule les attentes périmées)
local pauseToken = 0 -- change à chaque coupure / reprise (annule un fondu de coupure périmé)
local playing = false -- état "la musique joue" (pour MusicStateChanged)
local failures = 0 -- échecs de chargement d'affilée
local retryAt = 0 -- os.clock() avant lequel on ne relance pas (tout a échoué)
local warnedEmpty = false

----------------------------------------------------------------------
-- Outils
----------------------------------------------------------------------

-- "123" ou 123 -> "rbxassetid://123" ; sinon l'ID tel quel ("" si invalide)
local function normalizeId(id: any): string
	if type(id) == "number" then
		return id > 0 and ("rbxassetid://" .. tostring(math.floor(id))) or ""
	end
	if type(id) ~= "string" then
		return ""
	end
	local trimmed = string.gsub(id, "^%s*(.-)%s*$", "%1")
	if trimmed == "" or trimmed == "0" then
		return ""
	end
	if string.match(trimmed, "^%d+$") then
		return "rbxassetid://" .. trimmed
	end
	return trimmed
end

local function fade(sound: Sound, volume: number, duration: number): Tween
	local tween = TweenService:Create(sound, TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
		Volume = volume,
	})
	tween:Play()
	return tween
end

-- Fait disparaître un morceau en douceur puis le détruit
local function fadeAndDestroy(sound: Sound, duration: number)
	local tween = fade(sound, 0, duration)
	tween.Completed:Once(function()
		sound:Destroy()
	end)
	-- Filet de sécurité si le tween est interrompu
	Debris:AddItem(sound, duration + 1)
end

local function shouldPlay(): boolean
	return musicEnabled and musicAllowed and #tracks > 0
end

local function setPlaying(value: boolean)
	if playing ~= value then
		playing = value
		SoundManager.MusicStateChanged:Fire(value)
	end
end

-- Nouvel ordre de lecture (mélangé si demandé, sans rejouer tout de suite le dernier)
local function buildOrder()
	local last = order[#order]
	table.clear(order)
	for index = 1, #tracks do
		table.insert(order, index)
	end
	if Config.Music.Shuffle and #order > 1 then
		local random = Random.new()
		for i = #order, 2, -1 do
			local j = random:NextInteger(1, i)
			order[i], order[j] = order[j], order[i]
		end
		if last and order[1] == last then
			order[1], order[#order] = order[#order], order[1]
		end
	end
	orderPosition = 0
end

local function nextTrackIndex(): number?
	if #tracks == 0 then
		return nil
	end
	orderPosition += 1
	if orderPosition > #order then
		buildOrder()
		orderPosition = 1
	end
	return order[orderPosition]
end

----------------------------------------------------------------------
-- Lecture
----------------------------------------------------------------------

local startNext: (crossfade: number) -> ()

-- Surveille le chargement d'un morceau : s'il ne charge pas à temps, on passe au suivant
local function watchLoading(sound: Sound, myGeneration: number)
	task.spawn(function()
		local started = os.clock()
		while not sound.IsLoaded and os.clock() - started < LOAD_TIMEOUT do
			task.wait(0.25)
			if generation ~= myGeneration or not sound.Parent then
				return
			end
		end
		if generation ~= myGeneration or not sound.Parent then
			return
		end
		if sound.IsLoaded then
			failures = 0
			return
		end
		-- Échec : morceau suivant (ou pause si tout échoue)
		failures += 1
		warn("[SoundManager] Musique impossible à charger : " .. sound.SoundId .. " (morceau suivant)")
		if failures >= #tracks then
			failures = 0
			retryAt = os.clock() + RETRY_DELAY
			if current == sound then
				current = nil
				currentTrack = nil
				sound:Destroy()
				setPlaying(false)
				SoundManager.TrackChanged:Fire(nil, nil)
			end
			return
		end
		if shouldPlay() then
			startNext(0.5)
		end
	end)
end

-- Lance le morceau suivant avec un fondu enchaîné
startNext = function(crossfade: number)
	local group = musicGroup
	local parent = folder
	if not group or not parent then
		return
	end
	local index = nextTrackIndex()
	if not index then
		return
	end
	local track = tracks[index]
	generation += 1
	local displayName = trackName(track)
	local myGeneration = generation

	-- L'ancien morceau s'efface
	local old = current
	if old then
		fadeAndDestroy(old, math.max(0.2, crossfade))
	end

	local sound = Instance.new("Sound")
	sound.Name = "Music_" .. tostring(track.Name or track.Index)
	sound.SoundId = track.Id
	sound.Volume = 0
	sound.Looped = #tracks == 1 -- un seul morceau : il boucle tout seul
	sound.SoundGroup = group
	sound.Parent = parent
	current = sound
	currentTrack = track

	sound.Ended:Connect(function()
		-- Fin naturelle (si le fondu anticipé n'a pas déjà pris le relais)
		if generation == myGeneration and current == sound and shouldPlay() then
			startNext(0.3)
		end
	end)

	sound:Play()
	fade(sound, 1, math.max(0.2, crossfade))
	watchLoading(sound, myGeneration)
	setPlaying(true)
	SoundManager.TrackChanged:Fire(displayName, sound)
end

-- Démarre / reprend / coupe la musique selon les réglages
local function refreshMusic()
	local sound = current
	if shouldPlay() then
		if os.clock() < retryAt then
			return
		end
		if sound then
			if not playing or not sound.IsPlaying then
				pauseToken += 1 -- annule un éventuel fondu de coupure en cours
				if not sound.IsPlaying then
					sound.Volume = 0
					sound:Resume()
				end
				fade(sound, 1, FADE_IN)
				setPlaying(true)
			end
		else
			startNext(FADE_IN)
		end
	else
		if RunService:IsStudio() and musicEnabled and musicAllowed and #tracks == 0 and not warnedEmpty then
			warnedEmpty = true
			warn("[SoundManager] Aucune musique : ajoute des IDs dans Config.Music.Playlist")
		end
		if sound and sound.IsPlaying and playing then
			pauseToken += 1
			local myToken = pauseToken
			local tween = fade(sound, 0, FADE_OUT)
			tween.Completed:Once(function()
				-- Pause (on reprend au même endroit), sauf si la musique est revenue entre-temps
				if pauseToken == myToken and current == sound and not shouldPlay() then
					sound:Pause()
				end
			end)
		end
		setPlaying(false)
	end
end

----------------------------------------------------------------------
-- API
----------------------------------------------------------------------

-- Crée un "modèle" de son pour chaque entrée de Config.Sounds + la playlist
function SoundManager.Init()
	local old = SoundService:FindFirstChild("DopamineSounds")
	if old then
		old:Destroy()
	end
	local newFolder = Instance.new("Folder")
	newFolder.Name = "DopamineSounds"
	newFolder.Parent = SoundService
	folder = newFolder

	local fx = Instance.new("SoundGroup")
	fx.Name = "Effets"
	fx.Volume = effectsVolume
	fx.Parent = newFolder
	effectsGroup = fx

	local mu = Instance.new("SoundGroup")
	mu.Name = "Musique"
	mu.Volume = musicVolume
	mu.Parent = newFolder
	musicGroup = mu

	table.clear(templates)
	local toPreload = {}
	for name, info in pairs(Config.Sounds) do
		local id = normalizeId(info.Id)
		if id ~= "" then
			local sound = Instance.new("Sound")
			sound.Name = name
			sound.SoundId = id
			sound.Volume = info.Volume or 0.5
			sound.SoundGroup = fx
			sound.Parent = newFolder
			templates[name] = sound
			table.insert(toPreload, sound)
		end
	end

	-- Sons de clic au choix
	table.clear(clickTemplates)
	for _, entry in ipairs(Config.ClickSounds or {}) do
		local id = normalizeId(entry.Sound)
		if type(entry.Id) == "string" and id ~= "" then
			local sound = Instance.new("Sound")
			sound.Name = "ClickSound_" .. entry.Id
			sound.SoundId = id
			sound.Volume = tonumber(entry.Volume) or 0.5
			sound.SoundGroup = fx
			sound.Parent = newFolder
			clickTemplates[entry.Id] = sound
			table.insert(toPreload, sound)
		end
	end

	-- Playlist : on garde seulement les pistes avec un ID
	table.clear(tracks)
	local playlist = (Config.Music and Config.Music.Playlist) or {}
	for index, entry in ipairs(playlist) do
		local id = normalizeId(entry.Id)
		if id ~= "" then
			table.insert(tracks, { Name = entry.Name and tostring(entry.Name) or nil, Index = index, Id = id })
		end
	end
	buildOrder()

	-- Préchargement en arrière-plan (évite un petit délai au premier clic)
	task.spawn(function()
		pcall(function()
			ContentProvider:PreloadAsync(toPreload)
		end)
	end)

	-- Surveillance : fondu enchaîné un peu avant la fin du morceau,
	-- et nouvel essai si tout avait échoué au chargement
	task.spawn(function()
		while true do
			task.wait(0.25)
			local sound = current
			if shouldPlay() then
				if not sound and os.clock() >= retryAt and retryAt > 0 then
					retryAt = 0
					refreshMusic()
				elseif sound and #tracks > 1 and sound.IsPlaying and sound.IsLoaded then
					local length = sound.TimeLength
					if length > CROSSFADE * 3 and sound.TimePosition >= length - CROSSFADE then
						startNext(CROSSFADE)
					end
				end
			end
		end
	end)

	refreshMusic()
end

-- Joue un modèle de son (clone temporaire)
local function playTemplate(template: Sound, pitch: number)
	local sound = template:Clone()
	sound.PlaybackSpeed = pitch
	sound.Parent = SoundService
	sound:Play()
	Debris:AddItem(sound, math.max(2, sound.TimeLength / math.max(0.1, sound.PlaybackSpeed) + 0.5))
end

-- Joue un son. `pitch` change la hauteur (1 = normal).
function SoundManager.Play(name: string, pitch: number?)
	if not soundEnabled or effectsVolume <= 0 or name == "Music" then
		return
	end
	local template = templates[name]
	if not template then
		return
	end
	local now = os.clock()
	if now - (lastPlayed[name] or 0) < MIN_INTERVAL then
		return
	end
	lastPlayed[name] = now
	playTemplate(template, pitch or 1)
end

----------------------------------------------------------------------
-- Son du clic (v4)
----------------------------------------------------------------------

-- Choisit le son du clic (Id de Config.ClickSounds ; inconnu = "Default")
function SoundManager.SetClickSound(id: string)
	local newId = (type(id) == "string" and clickTemplates[id] ~= nil) and id or DEFAULT_CLICK_SOUND
	if newId == clickSoundId then
		return
	end
	clickSoundId = newId
	SoundManager.ClickSoundChanged:Fire(newId)
end

function SoundManager.GetClickSound(): string
	return clickSoundId
end

-- Joue le son de clic choisi (gros bouton). `pitch` : hauteur (1 = normal).
-- Les sons de clavier gardent une hauteur plus naturelle (variation réduite).
function SoundManager.PlayClick(pitch: number?)
	if not soundEnabled or effectsVolume <= 0 then
		return
	end
	local template = clickTemplates[clickSoundId]
	if not template then
		SoundManager.Play("Click", pitch)
		return
	end
	local now = os.clock()
	if now - lastClick < MIN_INTERVAL then
		return
	end
	lastClick = now
	local speed = pitch or 1
	if clickSoundId ~= DEFAULT_CLICK_SOUND then
		speed = 1 + (speed - 1) * 0.35
	end
	playTemplate(template, speed)
end

-- Fait écouter un son de clic (bouton ▶ des paramètres), même s'il n'est pas choisi
function SoundManager.PreviewClickSound(id: string)
	if not soundEnabled or effectsVolume <= 0 then
		return
	end
	local template = clickTemplates[id]
	if template then
		playTemplate(template, 1)
	else
		SoundManager.Play("Click", 1)
	end
end

function SoundManager.SetSoundEnabled(enabled: boolean)
	soundEnabled = enabled == true
end

function SoundManager.IsSoundEnabled(): boolean
	return soundEnabled
end

-- Réglage "Musique" du joueur
function SoundManager.SetMusicEnabled(enabled: boolean)
	musicEnabled = enabled == true
	refreshMusic()
end

function SoundManager.IsMusicEnabled(): boolean
	return musicEnabled
end

-- Autorisation de la musique (Feature "Lofi")
function SoundManager.SetMusicAllowed(allowed: boolean)
	musicAllowed = allowed == true
	refreshMusic()
end

function SoundManager.IsMusicAllowed(): boolean
	return musicAllowed
end

-- Vrai si un morceau est en train de jouer
function SoundManager.IsMusicPlaying(): boolean
	return playing
end

-- Vrai si la playlist contient au moins un morceau avec un ID
function SoundManager.HasPlaylist(): boolean
	return #tracks > 0
end

-- Volume de la musique (0 à 1)
function SoundManager.SetMusicVolume(volume: number)
	musicVolume = math.clamp(tonumber(volume) or 0, 0, 1)
	local group = musicGroup
	if group then
		group.Volume = musicVolume
	end
	SoundManager.VolumeChanged:Fire(musicVolume, effectsVolume)
end

function SoundManager.GetMusicVolume(): number
	return musicVolume
end

-- Volume des effets sonores (0 à 1)
function SoundManager.SetEffectsVolume(volume: number)
	effectsVolume = math.clamp(tonumber(volume) or 0, 0, 1)
	local group = effectsGroup
	if group then
		group.Volume = effectsVolume
	end
	SoundManager.VolumeChanged:Fire(musicVolume, effectsVolume)
end

function SoundManager.GetEffectsVolume(): number
	return effectsVolume
end

-- Passe au morceau suivant (fondu court). Renvoie vrai si c'est fait.
function SoundManager.NextTrack(): boolean
	if not shouldPlay() then
		return false
	end
	failures = 0
	retryAt = 0
	startNext(0.8)
	return true
end

-- Morceau actuel : (nom, Sound) ou (nil, nil) si aucun
function SoundManager.GetCurrentTrack(): (string?, Sound?)
	local track = currentTrack
	if not track or not current then
		return nil, nil
	end
	return trackName(track), current
end

return SoundManager
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="36">
        <Properties>
          <string name="Name">Stimuli</string>
        </Properties>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">BubbleWrap</string>
            <string name="Source"><![CDATA[--[[
	BubbleWrap (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > BubbleWrap

	Une feuille de papier bulle (8 x 5 bulles, en quinconce) :
	  - clic / toucher sur une bulle = POP (son à hauteur aléatoire, bulle
	    qui gonfle puis s'aplatit, onde, gouttelettes, "+X") ;
	  - sur PC, on peut aussi maintenir le clic et "glisser" sur les bulles ;
	  - chaque bulle éclatée envoie Interact("Bubble"). Le serveur ne renvoie
	    pas de notification : le "+X" affiché est prédit côté client
	    (gain par clic x Config.Interactions.Bubble.ClickFraction) ;
	  - limite côté client (seau de jetons) pour ne jamais dépasser
	    MaxPerSecond : au-delà, la bulle résiste (petit tremblement) ;
	  - quand tout est éclaté, la feuille part et une neuve arrive en glissant.
	Les 40 bulles sont créées une seule fois puis réutilisées.
]]

local Debris = game:GetService("Debris")
local UserInputService = game:GetService("UserInputService")

local Locale = require(game:GetService("ReplicatedStorage").Shared.Locale)

local BubbleWrap = {}
BubbleWrap.Slot = "L2"

local COLUMNS = 8
local ROWS = 5
local PITCH_X = 32
local PITCH_Y = 28
local DIAMETER = 26

local CAPTIONS = {
	en = {
		"Again! 🔁",
		"Fresh sheet 📦",
		"Bubble delivery!",
		"Want some more?",
		"Pop pop pop!",
		"That sheet was innocent.",
		"Zero bubble survivors.",
		"It's therapeutic.",
	},
	fr = {
		"Encore ! 🔁",
		"Nouvelle feuille 📦",
		"Livraison de bulles !",
		"Tu en veux encore ?",
		"Pop pop pop !",
		"La feuille était innocente.",
		"Zéro bulle survivante.",
		"C'est thérapeutique.",
	},
}

function BubbleWrap.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local Create = UIUtil.Create
	local container: Frame = ctx.Container
	local random = Random.new()
	local bubbleConfig = ctx.Config.Interactions.Bubble or {}
	local maxPerSecond = bubbleConfig.MaxPerSecond or 12
	local clickFraction = bubbleConfig.ClickFraction or 0.5

	-- Seau de jetons (un peu sous la limite serveur, pour ne jamais être refusé)
	local capacity = math.max(1, math.floor(maxPerSecond * 0.75))
	local refillRate = maxPerSecond * 0.9
	local tokens = capacity
	local lastRefill = os.clock()

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	------------------------------------------------------------------
	-- Carte + en-tête
	------------------------------------------------------------------
	local card = Create("Frame", {
		Name = "Card",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Colors.Card,
		BorderSizePixel = 0,
		Parent = container,
	})
	UIUtil.Corner(card, 18)
	UIUtil.Stroke(card, Theme.Colors.CardBorder, 2)

	UIUtil.Label({
		Text = Locale.T("🔘 BUBBLE WRAP"),
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.TextDark,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(12, 5),
		Size = UDim2.fromOffset(160, 20),
		MaxTextSize = 15,
		ZIndex = 5,
		Parent = card,
	})
	local counterLabel = UIUtil.Label({
		Text = "💥 0",
		Font = Theme.Fonts.Number,
		TextColor3 = Theme.Colors.TextDark,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 5),
		Size = UDim2.fromOffset(90, 20),
		MaxTextSize = 15,
		ZIndex = 5,
		Parent = card,
	})
	local counterScale = Create("UIScale", { Parent = counterLabel })

	-- Fenêtre (découpe la feuille quand elle glisse)
	local window = Create("Frame", {
		Name = "Window",
		Position = UDim2.fromOffset(8, 28),
		Size = UDim2.new(1, -16, 1, -34),
		BackgroundColor3 = Color3.fromRGB(236, 240, 246),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 2,
		Parent = card,
	})

	local sheet = Create("Frame", {
		Name = "Sheet",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(222, 240, 255),
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = window,
	})
	UIUtil.Gradient(sheet, ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(210, 226, 240)), 60)

	-- Message de fin de feuille
	local caption = UIUtil.Label({
		Text = "",
		Font = Enum.Font.LuckiestGuy,
		TextColor3 = Theme.Colors.Blue,
		TextTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -20, 0, 34),
		MaxTextSize = 28,
		ZIndex = 1,
		Parent = window,
	})
	local captionStroke = UIUtil.Stroke(caption, Color3.new(1, 1, 1), 2.5, 1)
	captionStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual

	------------------------------------------------------------------
	-- Bulles (créées une fois, réutilisées pour chaque feuille)
	------------------------------------------------------------------
	local bubbleFill = Color3.fromRGB(242, 250, 255)
	local bubbleStroke = Color3.fromRGB(140, 190, 228)
	local bubbles = {}
	local poppedCount = 0
	local sessionPops = 0
	local regenerating = false

	local function bubblePosition(row: number, column: number): (number, number)
		local x = 16 + column * PITCH_X + ((row % 2 == 1) and PITCH_X / 2 or 0)
		local y = 16 + row * PITCH_Y
		return x, y
	end

	local function resetBubble(bubble)
		bubble.Popped = false
		local button = bubble.Button
		button.BackgroundTransparency = 0.05
		bubble.Scale.Scale = 1
		bubble.Stroke.Color = bubbleStroke
		bubble.Stroke.Transparency = 0
		local shine = bubble.Shine
		shine.Position = UDim2.fromScale(0.34, 0.3)
		shine.Size = UDim2.fromScale(0.36, 0.22)
		shine.Rotation = -30
		shine.BackgroundColor3 = Color3.new(1, 1, 1)
		shine.BackgroundTransparency = 0.05
	end

	local function setPoppedLook(bubble)
		local button = bubble.Button
		button.BackgroundTransparency = 0.6
		bubble.Stroke.Color = Color3.fromRGB(120, 158, 196)
		bubble.Stroke.Transparency = 0.35
		-- Le reflet devient un pli
		local shine = bubble.Shine
		shine.Position = UDim2.fromScale(0.5, 0.5)
		shine.Size = UDim2.fromScale(0.62, 0.08)
		shine.Rotation = random:NextNumber(20, 60)
		shine.BackgroundColor3 = Color3.fromRGB(130, 170, 206)
		shine.BackgroundTransparency = 0.25
	end

	-- Vrai si un jeton est disponible (et le consomme)
	local function takeToken(): boolean
		local now = os.clock()
		tokens = math.min(capacity, tokens + (now - lastRefill) * refillRate)
		lastRefill = now
		if tokens >= 1 then
			tokens -= 1
			return true
		end
		return false
	end

	local function popEffects(x: number, y: number)
		-- Onde
		local ring = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(x, y),
			Size = UDim2.fromOffset(DIAMETER, DIAMETER),
			BackgroundTransparency = 1,
			ZIndex = 6,
			Parent = sheet,
		})
		UIUtil.Corner(ring, UDim.new(1, 0))
		local ringStroke = UIUtil.Stroke(ring, Color3.fromRGB(110, 180, 240), 2, 0.1)
		UIUtil.Tween(ring, 0.25, { Size = UDim2.fromOffset(DIAMETER * 1.8, DIAMETER * 1.8) })
		UIUtil.Tween(ringStroke, 0.25, { Transparency = 1 })
		Debris:AddItem(ring, 0.3)

		-- Gouttelettes d'air (si effets actifs)
		if effectsOn() then
			for _ = 1, 3 do
				local angle = random:NextNumber(0, math.pi * 2)
				local distance = random:NextNumber(12, 22)
				local drop = Create("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromOffset(x, y),
					Size = UDim2.fromOffset(4, 4),
					BackgroundColor3 = Color3.new(1, 1, 1),
					BorderSizePixel = 0,
					ZIndex = 7,
					Parent = sheet,
				})
				UIUtil.Corner(drop, UDim.new(1, 0))
				UIUtil.Stroke(drop, Color3.fromRGB(120, 180, 230), 1)
				UIUtil.Tween(drop, 0.3, {
					Position = UDim2.fromOffset(x + math.cos(angle) * distance, y + math.sin(angle) * distance),
					BackgroundTransparency = 1,
				})
				Debris:AddItem(drop, 0.35)
			end
		end
	end

	local regenerate -- (déclarée plus bas)

	local function pop(bubble)
		if bubble.Popped or regenerating or not ctx.IsAlive() then
			return
		end
		if not takeToken() then
			-- Trop vite : la bulle résiste
			bubble.Scale.Scale = 0.9
			UIUtil.Tween(bubble.Scale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)
			return
		end
		bubble.Popped = true
		poppedCount += 1
		sessionPops += 1

		ctx.Interact("Bubble")
		ctx.Sound.Play("Pop", random:NextNumber(0.9, 1.35))

		-- Gonfle puis s'aplatit
		bubble.Scale.Scale = 1.22
		UIUtil.Tween(bubble.Scale, 0.22, { Scale = 0.84 }, Enum.EasingStyle.Back)
		setPoppedLook(bubble)
		popEffects(bubble.X, bubble.Y)

		-- "+X" prédit
		local data = ctx.State.Data
		local value = (data and tonumber(data.ClickValue) or 0) * clickFraction
		if value > 0 then
			local sheetOffset = sheet.Position.X.Offset
			ctx.FloatText(
				container,
				UDim2.fromOffset(8 + sheetOffset + bubble.X, 28 + bubble.Y - 10),
				"+" .. ctx.Format.Format(value),
				Theme.Colors.Blue,
				18
			)
		end

		counterLabel.Text = "💥 " .. sessionPops
		counterScale.Scale = 1.15
		UIUtil.Tween(counterScale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)

		if poppedCount >= #bubbles then
			regenerate()
		end
	end

	for row = 0, ROWS - 1 do
		for column = 0, COLUMNS - 1 do
			local x, y = bubblePosition(row, column)
			local button = Create("TextButton", {
				Name = "Bubble",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(x, y),
				Size = UDim2.fromOffset(DIAMETER, DIAMETER),
				BackgroundColor3 = bubbleFill,
				BackgroundTransparency = 0.05,
				AutoButtonColor = false,
				Text = "",
				ZIndex = 4,
				Parent = sheet,
			})
			UIUtil.Corner(button, UDim.new(1, 0))
			UIUtil.Gradient(button, ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(186, 218, 244)), 90)
			local stroke = UIUtil.Stroke(button, bubbleStroke, 1.5)
			local scale = Create("UIScale", { Parent = button })
			local shine = Create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				BorderSizePixel = 0,
				ZIndex = 5,
				Parent = button,
			})
			UIUtil.Corner(shine, UDim.new(1, 0))
			local bubble = { Button = button, Stroke = stroke, Scale = scale, Shine = shine, X = x, Y = y, Popped = false }
			resetBubble(bubble)
			table.insert(bubbles, bubble)

			ctx.Connect(button.MouseButton1Down, function()
				pop(bubble)
			end)
			-- Glisser en maintenant le clic (souris)
			ctx.Connect(button.MouseEnter, function()
				if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
					pop(bubble)
				end
			end)
		end
	end

	------------------------------------------------------------------
	-- Nouvelle feuille
	------------------------------------------------------------------
	regenerate = function()
		if regenerating then
			return
		end
		regenerating = true
		task.spawn(function()
			task.wait(0.35)
			if not ctx.IsAlive() then
				return
			end
			-- Message au milieu, visible pendant que la feuille glisse
			local captions = Locale.Pick(CAPTIONS)
			caption.Text = captions[random:NextInteger(1, #captions)]
			caption.TextTransparency = 0
			captionStroke.Transparency = 0
			local width = (container.Size.X.Offset > 0 and container.Size.X.Offset or 288) - 16
			UIUtil.Tween(sheet, 0.35, { Position = UDim2.fromOffset(-(width + 10), 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			ctx.Sound.Play("Open", 0.9)
			task.wait(0.75)
			if not ctx.IsAlive() then
				return
			end
			for _, bubble in ipairs(bubbles) do
				resetBubble(bubble)
			end
			poppedCount = 0
			sheet.Position = UDim2.fromOffset(width + 10, 0)
			UIUtil.Tween(sheet, 0.45, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Back)
			UIUtil.Tween(caption, 0.3, { TextTransparency = 1 })
			UIUtil.Tween(captionStroke, 0.3, { Transparency = 1 })
			task.wait(0.45)
			regenerating = false
		end)
	end

	-- Petite vague de "respiration" des bulles intactes (pour donner envie)
	task.spawn(function()
		while ctx.IsAlive() do
			task.wait(random:NextNumber(4, 7))
			if not ctx.IsAlive() then
				break
			end
			if not regenerating then
				for index, bubble in ipairs(bubbles) do
					if not bubble.Popped then
						task.delay((index % COLUMNS) * 0.04, function()
							if ctx.IsAlive() and not bubble.Popped then
								bubble.Scale.Scale = 1.08
								UIUtil.Tween(bubble.Scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Sine)
							end
						end)
					end
				end
			end
		end
	end)
end

function BubbleWrap.Stop(_ctx)
	-- Tout est dans ctx.Container (détruit par le StimulusManager)
end

return BubbleWrap
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Casino</string>
            <string name="Source"><![CDATA[--[[
	Casino (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > Casino

	Machine à sous "de luxe" (UNIQUEMENT avec la Dopamine du jeu) dans le
	slot R2 (288x180) :
	  - carrosserie bordeaux laquée, cadre chromé et liseré or dégradé ;
	  - fronton lumineux : titre doré + ampoules en chenillard (arc-en-ciel
	    en folie quand on gagne) ;
	  - 3 rouleaux en verre bombé (ombre de cylindre, reflet de vitre,
	    séparateurs chromés) avec une ligne de gain lumineuse et flèches ;
	  - écran LED (mise, messages) + bouton "GAINS" qui déroule la table
	    des paiements (paires / triples de Config.Casino + taux de retour) ;
	  - jetons de poker (Config.Casino.BetFractions en %) : le jeton choisi
	    se soulève et brille ;
	  - gros bouton "JOUER" + levier chromé animé (tirage, rebond élastique) ;
	  - gain : halo des symboles gagnants, pièces qui tombent ; JACKPOT
	    (x25 et plus) : bannière à rayons tournants, flash, confettis.
	Le résultat vient TOUJOURS du serveur (CasinoSpin) : les rouleaux se
	lancent tout de suite puis s'arrêtent un par un sur les symboles reçus
	(petit suspense si les deux premiers sont identiques).
	Fermée (State.Data.CasinoEnabled = false, ex. quand le jeu vend de la
	Dopamine contre des Robux) : panneau "FERMÉ" par-dessus la machine,
	et CasinoSpin n'est JAMAIS appelé.
]]

local Casino = {}
Casino.Slot = "R2"

local Locale = require(game:GetService("ReplicatedStorage").Shared.Locale)

-- Dimensions (pixels "design") : la carrosserie est rentrée de 2 px pour
-- que son contour ne soit pas coupé par le slot (ClipsDescendants)
local W = 284
local H = 176

local WINDOW_X, WINDOW_Y = 8, 36
local WINDOW_W, WINDOW_H = 230, 70
local REEL_GAP = 4
local REEL_W = math.floor((WINDOW_W - 10 - REEL_GAP * 2) / 3)
local REEL_H = WINDOW_H - 10
local CELL_H = 40 -- hauteur d'un symbole sur le rouleau
local STRIP_LENGTH = 24 -- symboles par bande (recyclés en boucle)
local MAX_SPEED = 20 -- symboles / seconde
local MIN_SPIN_TIME = 0.8

local LED_Y = 110
local ROW_Y = 131
local CHIP_SIZE = 34
local MAX_CHIPS = 4
local BULBS_PER_SIDE = 8 -- 2 rangées x 4 de chaque côté du titre
local MAX_COINS = 12

local GOLD = Color3.fromRGB(255, 200, 60)
local GOLD_LIGHT = Color3.fromRGB(255, 240, 170)
local GOLD_DARK = Color3.fromRGB(170, 110, 20)
local CHROME_LIGHT = Color3.fromRGB(250, 250, 255)
local CHROME_DARK = Color3.fromRGB(120, 124, 138)
local LACQUER_TOP = Color3.fromRGB(196, 28, 58)
local LACQUER_BOTTOM = Color3.fromRGB(92, 6, 28)
local LED_BG = Color3.fromRGB(22, 6, 10)
local LED_TEXT = Color3.fromRGB(255, 176, 60)
local WHITE = Color3.new(1, 1, 1)

-- Couleurs des jetons (fond, centre)
local CHIP_COLORS = {
	{ Color3.fromRGB(240, 240, 244), Color3.fromRGB(255, 255, 255) },
	{ Color3.fromRGB(214, 36, 50), Color3.fromRGB(245, 90, 100) },
	{ Color3.fromRGB(30, 110, 220), Color3.fromRGB(90, 160, 250) },
	{ Color3.fromRGB(28, 28, 34), Color3.fromRGB(70, 70, 82) },
}

local LOSS_TEXTS = {
	en = {
		"So close! (not really)",
		"The house always wins 🏠",
		"Try again, it'll hit… maybe",
		"Your Dopamine went on vacation 🏖️",
		"Ouch. Let's call that a test run.",
		"The brain said no 🧠❌",
		"That was just practice… oh wait, no.",
		"The reels have stage fright today",
	},
	fr = {
		"Presque ! (non)",
		"La maison gagne toujours 🏠",
		"Retente, ça va passer… peut-être",
		"Ta Dopamine est partie en vacances 🏖️",
		"Aïe. On dira que c'était un test.",
		"Le cerveau a dit non 🧠❌",
		"C'était pour du beurre… ah non.",
		"Les rouleaux ont le trac aujourd'hui",
	},
}

local WIN_TEXTS = {
	en = {
		"WINNER! 🎉",
		"Now we're rolling! 💸",
		"Lady Luck is smiling 😎",
		"Dopamine waterfall! 🤑",
	},
	fr = {
		"GAGNÉ ! 🎉",
		"Ça tourne bien ! 💸",
		"La chance te sourit 😎",
		"Dopamine en cascade ! 🤑",
	},
}

local ATTRACT_TEXTS = {
	en = {
		"Try your luck! 🍀",
		"Pair = money back (almost)",
		"No Robux here, promise 🤞",
		"Tap PAYOUTS to see the prizes 📜",
	},
	fr = {
		"Tente ta chance ! 🍀",
		"Paire = remboursé (ou presque)",
		"Aucun Robux ici, promis 🤞",
		"Touche GAINS pour voir les gains 📜",
	},
}

-- Recul "Back" plus doux que la version standard (petit rebond à l'arrêt)
local function easeOutSoftBack(t: number): number
	local c1 = 0.9
	local c3 = c1 + 1
	local u = t - 1
	return 1 + c3 * u * u * u + c1 * u * u
end

local function percentText(fraction: number): string
	local percent = fraction * 100
	local rounded = math.floor(percent + 0.5)
	if math.abs(percent - rounded) < 1e-6 then
		return tostring(rounded) .. "%"
	end
	return string.format("%.1f%%", percent)
end

function Casino.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local Create = UIUtil.Create
	local Format = ctx.Format
	local config = ctx.Config.Casino
	local symbols = config.Symbols
	local symbolsById = ctx.Config.CasinoSymbolsById
	local container: Frame = ctx.Container
	local random = Random.new()

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	local function getDopamine(): number
		local data = ctx.State.Data
		return (data and tonumber(data.Dopamine)) or 0
	end

	-- Petits constructeurs
	local function frame(props: { [string]: any }): Frame
		props.BorderSizePixel = 0
		if props.BackgroundTransparency == nil and props.BackgroundColor3 == nil then
			props.BackgroundTransparency = 1
		end
		return Create("Frame", props)
	end

	local function round(guiObject: Instance, radius: number?)
		UIUtil.Corner(guiObject, radius and UDim.new(0, radius) or UDim.new(1, 0))
	end

	local function vGradient(parent: Instance, keypoints: { { number | Color3 } }, rotation: number?): UIGradient
		local list = {}
		for _, point in ipairs(keypoints) do
			table.insert(list, ColorSequenceKeypoint.new(point[1] :: number, point[2] :: Color3))
		end
		return UIUtil.Gradient(parent, ColorSequence.new(list), rotation or 90)
	end

	-- Contour doré dégradé (UIGradient sous l'UIStroke)
	local function goldStroke(parent: Instance, thickness: number): UIStroke
		local stroke = UIUtil.Stroke(parent, WHITE, thickness, 0)
		vGradient(stroke, { { 0, GOLD_LIGHT }, { 0.45, GOLD }, { 1, GOLD_DARK } }, 90)
		return stroke
	end

	------------------------------------------------------------------
	-- Carrosserie
	------------------------------------------------------------------
	local card = frame({
		Name = "Machine",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(W, H),
		BackgroundColor3 = WHITE,
		ZIndex = 1,
		Parent = container,
	})
	round(card, 18)
	vGradient(card, { { 0, LACQUER_TOP }, { 0.55, Color3.fromRGB(150, 16, 44) }, { 1, LACQUER_BOTTOM } })
	goldStroke(card, 2.5)

	-- Reflet laqué (bande claire en diagonale)
	local sheen = frame({
		Name = "Sheen",
		Size = UDim2.new(1, -8, 0.5, 0),
		Position = UDim2.fromOffset(4, 3),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.86,
		ZIndex = 1,
		Parent = card,
	})
	round(sheen, 15)
	Create("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = sheen,
	})

	-- Texte flottant dessiné dans le calque Overlay : il monte de 100 px et
	-- serait coupé par le slot (ClipsDescendants). `point` = position en
	-- pixels "design" dans la carrosserie.
	local function floatOnOverlay(point: Vector2, text: string, color: Color3?, size: number?)
		local ratio = card.AbsoluteSize.X / W
		local canvas = ctx.Interface.ScreenToCanvas(card.AbsolutePosition + point * ratio)
		ctx.FloatText(ctx.Overlay, UDim2.fromOffset(canvas.X, canvas.Y), text, color, size)
	end

	------------------------------------------------------------------
	-- Fronton : titre doré + ampoules en chenillard
	------------------------------------------------------------------
	local marquee = frame({
		Name = "Marquee",
		Position = UDim2.fromOffset(8, 5),
		Size = UDim2.fromOffset(W - 16, 27),
		BackgroundColor3 = WHITE,
		ZIndex = 2,
		Parent = card,
	})
	round(marquee, 9)
	vGradient(marquee, { { 0, Color3.fromRGB(60, 8, 22) }, { 1, Color3.fromRGB(26, 2, 10) } })
	goldStroke(marquee, 1.5)

	local titleLabel = UIUtil.Label({
		Name = "Title",
		Text = "★ DOPA SLOTS ★",
		Font = Theme.Fonts.Title,
		TextColor3 = WHITE,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(128, 22),
		MaxTextSize = 17,
		ZIndex = 4,
		Parent = marquee,
	})
	local titleGradient = vGradient(titleLabel, { { 0, GOLD_LIGHT }, { 0.5, GOLD }, { 1, Color3.fromRGB(230, 140, 20) } })
	local titleStroke = UIUtil.Stroke(titleLabel, Color3.fromRGB(70, 20, 0), 1.2, 0)
	titleStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	local titleScale = Create("UIScale", { Parent = titleLabel })

	-- Ampoules : une seule Frame chacune, le "halo" est son UIStroke
	local bulbs: { { Frame: Frame, Stroke: UIStroke } } = {}
	local marqueeW = W - 16
	for side = 0, 1 do
		for column = 0, BULBS_PER_SIDE / 2 - 1 do
			for row = 0, 1 do
				local x
				if side == 0 then
					x = 12 + column * 16 + row * 8
				else
					x = marqueeW - 12 - (BULBS_PER_SIDE / 2 - 1 - column) * 16 - (1 - row) * 8
				end
				local bulb = frame({
					Name = "Bulb",
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromOffset(x, row == 0 and 8 or 19),
					Size = UDim2.fromOffset(6, 6),
					BackgroundColor3 = GOLD,
					ZIndex = 3,
					Parent = marquee,
				})
				round(bulb)
				local stroke = UIUtil.Stroke(bulb, GOLD, 2, 0.55)
				table.insert(bulbs, { Frame = bulb, Stroke = stroke })
			end
		end
	end
	-- Ordre du chenillard : de gauche à droite
	table.sort(bulbs, function(a, b)
		return a.Frame.Position.X.Offset < b.Frame.Position.X.Offset
	end)

	------------------------------------------------------------------
	-- Fenêtre des rouleaux : cadre chromé + verre
	------------------------------------------------------------------
	local chrome = frame({
		Name = "Chrome",
		Position = UDim2.fromOffset(WINDOW_X - 3, WINDOW_Y - 3),
		Size = UDim2.fromOffset(WINDOW_W + 6, WINDOW_H + 6),
		BackgroundColor3 = WHITE,
		ZIndex = 2,
		Parent = card,
	})
	round(chrome, 12)
	vGradient(chrome, { { 0, CHROME_LIGHT }, { 0.35, Color3.fromRGB(190, 194, 206) }, { 0.5, CHROME_DARK }, { 0.7, Color3.fromRGB(210, 214, 224) }, { 1, Color3.fromRGB(150, 154, 168) } })
	UIUtil.Stroke(chrome, Color3.fromRGB(50, 10, 20), 1, 0.2)

	local window = frame({
		Name = "Window",
		Position = UDim2.fromOffset(WINDOW_X, WINDOW_Y),
		Size = UDim2.fromOffset(WINDOW_W, WINDOW_H),
		BackgroundColor3 = Color3.fromRGB(16, 4, 8),
		ZIndex = 3,
		Parent = card,
	})
	round(window, 9)
	local windowStroke = UIUtil.Stroke(window, GOLD, 1.5, 0.3)

	local reels = {}
	local function wrap(index: number): number
		return ((index - 1) % STRIP_LENGTH) + 1
	end

	for r = 1, 3 do
		local reelFrame = frame({
			Name = "Reel" .. r,
			Position = UDim2.fromOffset(5 + (r - 1) * (REEL_W + REEL_GAP), 5),
			Size = UDim2.fromOffset(REEL_W, REEL_H),
			BackgroundColor3 = WHITE,
			ClipsDescendants = true,
			ZIndex = 4,
			Parent = window,
		})
		round(reelFrame, 6)
		-- Cylindre : ivoire au centre, plus sombre en haut / en bas
		vGradient(reelFrame, {
			{ 0, Color3.fromRGB(170, 160, 150) },
			{ 0.28, Color3.fromRGB(240, 234, 222) },
			{ 0.5, Color3.fromRGB(255, 253, 246) },
			{ 0.72, Color3.fromRGB(240, 234, 222) },
			{ 1, Color3.fromRGB(170, 160, 150) },
		})

		-- Halo de victoire derrière le symbole du milieu
		local glow = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(REEL_W / 2, REEL_H / 2),
			Size = UDim2.fromOffset(REEL_W - 4, CELL_H - 2),
			BackgroundColor3 = GOLD,
			BackgroundTransparency = 1,
			ZIndex = 4,
			Parent = reelFrame,
		})
		round(glow, 8)
		Create("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.6),
				NumberSequenceKeypoint.new(0.5, 0),
				NumberSequenceKeypoint.new(1, 0.6),
			}),
			Parent = glow,
		})

		-- Bande de symboles (mélangés)
		local strip = {}
		for i = 1, STRIP_LENGTH do
			strip[i] = symbols[((i - 1) % #symbols) + 1].Id
		end
		for i = STRIP_LENGTH, 2, -1 do
			local j = random:NextInteger(1, i)
			strip[i], strip[j] = strip[j], strip[i]
		end

		local labels = {}
		for k = 1, 4 do
			local label = UIUtil.Label({
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(REEL_W, CELL_H - 4),
				Position = UDim2.fromOffset(REEL_W / 2, REEL_H / 2),
				Font = Theme.Fonts.Title,
				MaxTextSize = 30,
				ZIndex = 5,
				Parent = reelFrame,
			})
			labels[k] = { Label = label, Shown = "" }
		end

		-- Ombre intérieure (haut / bas) pour la profondeur
		local shade = frame({
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.new(0, 0, 0),
			ZIndex = 6,
			Parent = reelFrame,
		})
		Create("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.15),
				NumberSequenceKeypoint.new(0.25, 0.85),
				NumberSequenceKeypoint.new(0.5, 1),
				NumberSequenceKeypoint.new(0.75, 0.85),
				NumberSequenceKeypoint.new(1, 0.15),
			}),
			Parent = shade,
		})
		-- Reflet de la vitre (bande blanche en haut)
		local glass = frame({
			Position = UDim2.fromOffset(3, 2),
			Size = UDim2.new(1, -6, 0, 14),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.55,
			ZIndex = 7,
			Parent = reelFrame,
		})
		round(glass, 5)
		Create("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.1),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = glass,
		})

		reels[r] = {
			Frame = reelFrame,
			Glow = glow,
			Strip = strip,
			Labels = labels,
			Pos = random:NextInteger(1, STRIP_LENGTH),
			Speed = 0,
			Mode = "idle", -- "idle" | "spin" | "stop"
			StopFrom = 0,
			StopTo = 0,
			StopT = 0,
			StopDur = 1,
			Scale = Create("UIScale", { Parent = reelFrame }),
		}
	end

	-- Séparateurs chromés entre les rouleaux
	for r = 1, 2 do
		local separator = frame({
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromOffset(5 + r * (REEL_W + REEL_GAP) - REEL_GAP / 2, 3),
			Size = UDim2.fromOffset(3, WINDOW_H - 6),
			BackgroundColor3 = WHITE,
			ZIndex = 8,
			Parent = window,
		})
		round(separator, 2)
		UIUtil.Gradient(separator, ColorSequence.new(CHROME_LIGHT, CHROME_DARK), 0)
	end

	-- Ligne de gain : halo + trait + flèches
	local paylineGlow = frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -4, 0, 12),
		BackgroundColor3 = Color3.fromRGB(255, 70, 70),
		BackgroundTransparency = 0.5,
		ZIndex = 8,
		Parent = window,
	})
	Create("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = paylineGlow,
	})
	local payline = frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -4, 0, 2),
		BackgroundColor3 = Color3.fromRGB(255, 60, 60),
		BackgroundTransparency = 0.2,
		ZIndex = 9,
		Parent = window,
	})
	local arrows = {}
	for side = 0, 1 do
		local arrow = UIUtil.Label({
			Text = side == 0 and "▶" or "◀",
			Font = Theme.Fonts.Title,
			TextColor3 = GOLD,
			AnchorPoint = Vector2.new(side, 0.5),
			Position = UDim2.new(side, side == 0 and -12 or 12, 0.5, 0),
			Size = UDim2.fromOffset(10, 14),
			MaxTextSize = 11,
			ZIndex = 9,
			Parent = window,
		})
		table.insert(arrows, arrow)
	end

	-- Affiche la bande d'un rouleau selon sa position (symbole `Pos` au centre)
	local function renderReel(reel)
		local base = math.floor(reel.Pos)
		local blur = reel.Speed > 8
		for k = 1, 4 do
			local index = base - 1 + (k - 1)
			local entry = reel.Labels[k]
			local label = entry.Label
			local id = reel.Strip[wrap(index)]
			if entry.Shown ~= id then
				entry.Shown = id
				local symbol = symbolsById[id]
				label.Text = symbol and symbol.Icon or "?"
			end
			-- Les indices plus grands sont au-dessus : la bande descend
			label.Position = UDim2.fromOffset(REEL_W / 2, REEL_H / 2 - (index - reel.Pos) * CELL_H)
			label.TextTransparency = blur and 0.4 or 0
		end
	end

	for _, reel in ipairs(reels) do
		renderReel(reel)
	end

	------------------------------------------------------------------
	-- Levier chromé
	------------------------------------------------------------------
	local leverX = WINDOW_X + WINDOW_W + (W - (WINDOW_X + WINDOW_W)) / 2
	local leverBottom = 94
	local knobTop = 44
	local stickLength = leverBottom - knobTop

	-- Support (boîtier chromé fixé sur le côté)
	local mount = frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(leverX, leverBottom + 4),
		Size = UDim2.fromOffset(26, 20),
		BackgroundColor3 = WHITE,
		ZIndex = 3,
		Parent = card,
	})
	round(mount, 6)
	vGradient(mount, { { 0, CHROME_LIGHT }, { 0.5, Color3.fromRGB(170, 174, 188) }, { 1, CHROME_DARK } })
	UIUtil.Stroke(mount, Color3.fromRGB(40, 8, 16), 1, 0.3)
	local slot = frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(8, 12),
		BackgroundColor3 = Color3.fromRGB(30, 30, 36),
		ZIndex = 4,
		Parent = mount,
	})
	round(slot, 4)

	local stick = frame({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromOffset(leverX, leverBottom + 2),
		Size = UDim2.fromOffset(6, stickLength),
		BackgroundColor3 = WHITE,
		ZIndex = 5,
		Parent = card,
	})
	round(stick, 3)
	UIUtil.Gradient(stick, ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(150, 154, 168)),
		ColorSequenceKeypoint.new(0.35, CHROME_LIGHT),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(110, 114, 128)),
	}), 0)

	local knob = frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(leverX, knobTop),
		Size = UDim2.fromOffset(22, 22),
		BackgroundColor3 = WHITE,
		ZIndex = 6,
		Parent = card,
	})
	round(knob)
	UIUtil.Gradient(knob, ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 110, 110)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(225, 20, 36)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(110, 0, 12)),
	}), 60)
	UIUtil.Stroke(knob, Color3.fromRGB(70, 0, 8), 1.2, 0.1)
	local knobShine = frame({
		Position = UDim2.fromOffset(5, 3),
		Size = UDim2.fromOffset(8, 5),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.2,
		Rotation = -25,
		ZIndex = 7,
		Parent = knob,
	})
	round(knobShine)

	local leverButton = Create("TextButton", {
		Name = "Lever",
		Position = UDim2.fromOffset(leverX - 18, knobTop - 14),
		Size = UDim2.fromOffset(36, leverBottom - knobTop + 28),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 12,
		Parent = card,
	})

	local function pullLever()
		local down = leverBottom - 8
		UIUtil.Tween(knob, 0.16, { Position = UDim2.fromOffset(leverX, down) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		UIUtil.Tween(stick, 0.16, { Size = UDim2.fromOffset(6, leverBottom + 2 - down) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(0.2, function()
			if knob.Parent and stick.Parent then
				UIUtil.Tween(knob, 0.8, { Position = UDim2.fromOffset(leverX, knobTop) }, Enum.EasingStyle.Elastic)
				UIUtil.Tween(stick, 0.8, { Size = UDim2.fromOffset(6, stickLength) }, Enum.EasingStyle.Elastic)
			end
		end)
	end

	-- Survol du levier : la boule brille un peu
	ctx.Connect(leverButton.MouseEnter, function()
		UIUtil.Tween(knob, 0.15, { Size = UDim2.fromOffset(25, 25) }, Enum.EasingStyle.Back)
	end)
	ctx.Connect(leverButton.MouseLeave, function()
		UIUtil.Tween(knob, 0.15, { Size = UDim2.fromOffset(22, 22) })
	end)

	------------------------------------------------------------------
	-- Écran LED (mise, résultat, blagues) + bouton "GAINS"
	------------------------------------------------------------------
	local led = frame({
		Name = "Led",
		Position = UDim2.fromOffset(8, LED_Y),
		Size = UDim2.fromOffset(W - 16, 17),
		BackgroundColor3 = LED_BG,
		ZIndex = 3,
		Parent = card,
	})
	round(led, 5)
	UIUtil.Stroke(led, Color3.fromRGB(0, 0, 0), 1, 0.3)
	local info = UIUtil.Label({
		Name = "Info",
		Text = "",
		Font = Theme.Fonts.Title,
		TextColor3 = LED_TEXT,
		Position = UDim2.fromOffset(6, 1),
		Size = UDim2.new(1, -60, 1, -2),
		MaxTextSize = 13,
		ZIndex = 4,
		Parent = led,
	})
	local infoLockUntil = 0

	local function setInfo(text: string, color: Color3?, lockSeconds: number?)
		info.Text = text
		info.TextColor3 = color or LED_TEXT
		if lockSeconds then
			infoLockUntil = os.clock() + lockSeconds
		end
	end

	local payButton = Create("TextButton", {
		Name = "Paytable",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -2, 0.5, 0),
		Size = UDim2.fromOffset(50, 13),
		BackgroundColor3 = WHITE,
		AutoButtonColor = false,
		Font = Theme.Fonts.Title,
		Text = Locale.T("📜 PAYOUTS"),
		TextColor3 = Color3.fromRGB(60, 20, 0),
		TextSize = 10,
		ZIndex = 5,
		Parent = led,
	})
	round(payButton)
	vGradient(payButton, { { 0, GOLD_LIGHT }, { 1, GOLD } })

	------------------------------------------------------------------
	-- Table des paiements (se déroule par-dessus les rouleaux)
	------------------------------------------------------------------
	local paytable = frame({
		Name = "PaytablePanel",
		Position = UDim2.fromOffset(WINDOW_X, WINDOW_Y - 4),
		Size = UDim2.fromOffset(WINDOW_W, WINDOW_H + 8),
		BackgroundColor3 = Color3.fromRGB(20, 4, 10),
		BackgroundTransparency = 0.04,
		Visible = false,
		ZIndex = 14,
		Parent = card,
	})
	round(paytable, 9)
	goldStroke(paytable, 1.5)
	local paytableScale = Create("UIScale", { Parent = paytable })

	local sorted = table.clone(symbols)
	table.sort(sorted, function(a, b)
		return (a.Triple or 0) > (b.Triple or 0)
	end)
	for index, symbol in ipairs(sorted) do
		if index > 6 then
			break
		end
		local column = (index - 1) % 2
		local row = math.floor((index - 1) / 2)
		UIUtil.Label({
			Text = string.format("%s%s%s <font color=\"#FFD24A\">%s</font>  %s%s %s",
				symbol.Icon, symbol.Icon, symbol.Icon, Format.Multiplier(symbol.Triple or 0),
				symbol.Icon, symbol.Icon, Format.Multiplier(symbol.Pair or 0)),
			RichText = true,
			Font = Theme.Fonts.Title,
			TextColor3 = WHITE,
			TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.fromOffset(8 + column * (WINDOW_W / 2 - 4), 4 + row * 18),
			Size = UDim2.fromOffset(WINDOW_W / 2 - 12, 17),
			MaxTextSize = 12,
			ZIndex = 15,
			Parent = paytable,
		})
	end
	local rtpText = Locale.T("Pair = small win · Triple = big win")
	local rtpOk, rtp = pcall(function()
		return ctx.Formulas.GetCasinoRTP()
	end)
	if rtpOk and type(rtp) == "number" and rtp > 0 then
		rtpText = Locale.T("Average return: %d %% · the house wins a little 🏠", math.floor(rtp * 100 + 0.5))
	end
	UIUtil.Label({
		Text = rtpText,
		Font = Theme.Fonts.Body,
		TextColor3 = Color3.fromRGB(255, 220, 170),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -3),
		Size = UDim2.new(1, -16, 0, 14),
		MaxTextSize = 11,
		ZIndex = 15,
		Parent = paytable,
	})

	local paytableOpen = false
	local paytableToken = 0
	local function setPaytable(open: boolean)
		if paytableOpen == open then
			return
		end
		paytableOpen = open
		paytableToken += 1
		local token = paytableToken
		if open then
			paytable.Visible = true
			paytableScale.Scale = 0.6
			UIUtil.Tween(paytableScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
			task.delay(7, function()
				if token == paytableToken and paytableOpen then
					setPaytable(false)
				end
			end)
		else
			UIUtil.Tween(paytableScale, 0.15, { Scale = 0.6 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(0.15, function()
				if token == paytableToken and paytable.Parent then
					paytable.Visible = false
				end
			end)
		end
	end
	ctx.Connect(payButton.Activated, function()
		ctx.Sound.Play("Click", 1.2)
		setPaytable(not paytableOpen)
	end)

	------------------------------------------------------------------
	-- Jetons de mise + bouton JOUER
	------------------------------------------------------------------
	local fractions = config.BetFractions or { 0.01 }
	local selected = math.min(1, #fractions)
	local chips = {}

	local function currentBet(): number
		local fraction = fractions[selected] or 0.01
		return math.max(config.MinBet or 1, math.floor(getDopamine() * fraction))
	end

	local playLabel: TextLabel? = nil
	local betLabel: TextLabel? = nil
	local function refreshBetLabel()
		if betLabel then
			betLabel.Text = Locale.T("Bet %s", Format.Format(currentBet()))
		end
	end

	local function refreshChips()
		for index, chip in ipairs(chips) do
			local isSelected = index == selected
			chip.Stroke.Color = isSelected and GOLD or Color3.fromRGB(20, 20, 24)
			chip.Stroke.Thickness = isSelected and 2.5 or 1.2
			UIUtil.Tween(chip.Scale, 0.25, { Scale = isSelected and 1.1 or 0.94 }, Enum.EasingStyle.Back)
			UIUtil.Tween(chip.Button, 0.25, { Position = UDim2.new(0.5, 0, 0.5, isSelected and -4 or 0) }, Enum.EasingStyle.Back)
			UIUtil.Tween(chip.Shadow, 0.25, {
				BackgroundTransparency = isSelected and 0.72 or 0.6,
				Size = UDim2.fromOffset(isSelected and 26 or 30, 7),
			})
		end
		refreshBetLabel()
	end

	local chipCount = math.min(#fractions, MAX_CHIPS)
	for index = 1, chipCount do
		local fraction = fractions[index]
		local colors = CHIP_COLORS[index] or CHIP_COLORS[1]
		local holder = frame({
			Name = "ChipHolder" .. index,
			Position = UDim2.fromOffset(8 + (index - 1) * (CHIP_SIZE + 5), ROW_Y),
			Size = UDim2.fromOffset(CHIP_SIZE + 2, 40),
			ZIndex = 4,
			Parent = card,
		})
		-- Ombre au sol (ellipse)
		local shadow = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, 18),
			Size = UDim2.fromOffset(30, 7),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.6,
			ZIndex = 4,
			Parent = holder,
		})
		round(shadow)
		local chip = Create("TextButton", {
			Name = "Chip",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(CHIP_SIZE, CHIP_SIZE),
			BackgroundColor3 = colors[1],
			AutoButtonColor = false,
			Text = "",
			ZIndex = 5,
			Parent = holder,
		})
		round(chip)
		local stroke = UIUtil.Stroke(chip, Color3.fromRGB(20, 20, 24), 1.2, 0)
		-- Plaquettes blanches sur la tranche (4 encoches)
		local spotColor = index == 1 and Color3.fromRGB(214, 36, 50) or WHITE
		for spot = 0, 3 do
			local angle = math.rad(spot * 90 + 45)
			frame({
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0.5, math.cos(angle) * 13.5, 0.5, math.sin(angle) * 13.5),
				Size = UDim2.fromOffset(7, 4),
				Rotation = spot * 90 + 45 + 90,
				BackgroundColor3 = spotColor,
				ZIndex = 6,
				Parent = chip,
			})
		end
		local inner = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(CHIP_SIZE - 12, CHIP_SIZE - 12),
			BackgroundColor3 = WHITE,
			ZIndex = 6,
			Parent = chip,
		})
		round(inner)
		UIUtil.Gradient(inner, ColorSequence.new(colors[2], colors[1]), 90)
		UIUtil.Stroke(inner, spotColor, 1, 0.35)
		UIUtil.Label({
			Text = percentText(fraction),
			Font = Theme.Fonts.Number,
			TextColor3 = Theme.ContrastText(colors[1]),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.9, 0.62),
			MaxTextSize = 11,
			ZIndex = 7,
			Parent = inner,
		})
		local scale = Create("UIScale", { Scale = 0.94, Parent = chip })
		chips[index] = { Button = chip, Stroke = stroke, Scale = scale, Shadow = shadow }

		ctx.Connect(chip.Activated, function()
			if selected == index then
				return
			end
			selected = index
			refreshChips()
			ctx.Sound.Play("Click", 1.3 + index * 0.08)
			setInfo(Locale.T("Bet: %s Dopamine", Format.Format(currentBet())), GOLD_LIGHT, 1.5)
		end)
	end

	-- Bouton JOUER (rouge laqué, contour doré, reflet)
	local playX = 8 + chipCount * (CHIP_SIZE + 5) + 4
	local playButton = Create("TextButton", {

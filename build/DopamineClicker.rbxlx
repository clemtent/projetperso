        <Item class="ModuleScript" referent="200">
          <Properties>
            <string name="Name">README</string>
            <string name="Source"><![CDATA[--[[
	Lang (dossier de traductions) — ModuleScript d'exemple
	Emplacement : ReplicatedStorage > Shared > Lang > README

	Chaque ModuleScript de ce dossier renvoie une table
	{ fr = { ["Texte anglais exact"] = "Texte français" } }.
	Locale.luau les fusionne toutes. Pour traduire une nouvelle phrase,
	ajoute simplement une ligne dans le fichier de la bonne zone.
]]

return { fr = {} }
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="201">
        <Properties>
          <string name="Name">Locale</string>
          <string name="Source"><![CDATA[--[[
	Locale (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > Locale

	Traduction du jeu. La langue de référence du code est l'ANGLAIS :
	on écrit Locale.T("Click me!") et le joueur francophone voit
	"Clique-moi !".

	- Langue détectée automatiquement : français si la langue Roblox du
	  joueur commence par "fr" (fr-fr, fr-ca...), sinon anglais.
	- Le joueur peut forcer la langue dans ⚙️ (réglage "Language" :
	  "Auto" | "en" | "fr", sauvegardé côté serveur).
	- Traductions françaises : chaque ModuleScript du dossier Shared > Lang
	  renvoie { fr = { ["English text"] = "Texte français", ... } }.
	  Une phrase sans traduction reste en anglais (jamais d'erreur).
	- Textes avec valeurs : Locale.T("+%s per click", Format(value))
	  (string.format est appliqué APRÈS la traduction : garde les mêmes %s).
	- Gros contenus (titres, mails, chat...) : Locale.Pick({ en = {...}, fr = {...} }).

	Serveur : Locale.TFor(Locale.ForPlayer(player), "text", ...).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Locale = {}

Locale.Languages = { "en", "fr" }
Locale.Default = "en"

local dictionaries: { [string]: { [string]: string } }? = nil
local currentLanguage: string? = nil
local listeners = {}

-- Charge (une fois) tous les dictionnaires du dossier Lang
local function getDictionaries(): { [string]: { [string]: string } }
	local loaded = dictionaries
	if loaded then
		return loaded
	end
	local merged = { fr = {} }
	local folder = script.Parent:FindFirstChild("Lang")
	if folder then
		for _, child in ipairs(folder:GetChildren()) do
			if child:IsA("ModuleScript") then
				local ok, result = pcall(require, child)
				if ok and type(result) == "table" then
					for lang, entries in pairs(result) do
						if type(entries) == "table" then
							merged[lang] = merged[lang] or {}
							for source, translated in pairs(entries) do
								merged[lang][source] = translated
							end
						end
					end
				else
					warn("[Locale] Dictionnaire invalide : " .. child:GetFullName(), result)
				end
			end
		end
	end
	dictionaries = merged
	return merged
end

-- "fr-fr" / "fr_CA" / "fr" -> "fr" ; tout le reste -> "en"
function Locale.Detect(localeId: string?): string
	if type(localeId) == "string" and string.lower(string.sub(localeId, 1, 2)) == "fr" then
		return "fr"
	end
	return "en"
end

-- Réglage "Auto" | "en" | "fr" + langue Roblox -> langue finale
function Locale.Resolve(setting: string?, localeId: string?): string
	if setting == "en" or setting == "fr" then
		return setting
	end
	return Locale.Detect(localeId)
end

-- Langue d'un joueur (serveur) : réglage sauvegardé sinon langue Roblox
function Locale.ForPlayer(player: Player, setting: string?): string
	return Locale.Resolve(setting, player.LocaleId)
end

-- Langue actuelle (client) : détectée au premier appel
function Locale.GetLanguage(): string
	local lang = currentLanguage
	if lang then
		return lang
	end
	local detected = Locale.Default
	if RunService:IsClient() then
		local player = Players.LocalPlayer
		if player then
			detected = Locale.Detect(player.LocaleId)
		end
	end
	currentLanguage = detected
	return detected
end

-- Change la langue (client). Les fonctions abonnées avec OnChanged sont appelées.
function Locale.SetLanguage(lang: string)
	if lang ~= "en" and lang ~= "fr" then
		return
	end
	if currentLanguage == lang then
		return
	end
	currentLanguage = lang
	for _, callback in ipairs(listeners) do
		task.spawn(callback, lang)
	end
end

function Locale.OnChanged(callback: (string) -> ())
	table.insert(listeners, callback)
end

function Locale.IsFrench(): boolean
	return Locale.GetLanguage() == "fr"
end

-- Traduit un texte anglais dans la langue `lang`, puis applique string.format
function Locale.TFor(lang: string, text: string, ...): string
	local result = text
	if lang ~= "en" then
		local dict = getDictionaries()[lang]
		local translated = dict and dict[text]
		if type(translated) == "string" then
			result = translated
		end
	end
	if select("#", ...) > 0 then
		local ok, formatted = pcall(string.format, result, ...)
		if ok then
			return formatted
		end
		local okSource, formattedSource = pcall(string.format, text, ...)
		return okSource and formattedSource or result
	end
	return result
end

-- Traduit dans la langue actuelle (client)
function Locale.T(text: string, ...): string
	return Locale.TFor(Locale.GetLanguage(), text, ...)
end

-- Choisit la version de la langue actuelle dans { en = x, fr = y }
function Locale.Pick(variants, lang: string?)
	if type(variants) ~= "table" then
		return variants
	end
	local chosen = variants[lang or Locale.GetLanguage()]
	if chosen == nil then
		chosen = variants.en
	end
	return chosen
end

return Locale
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="202">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--[[
	Net (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > Net

	Centralise les RemoteEvents / RemoteFunctions.
	- Le SERVEUR appelle Net.Setup() au démarrage : il crée automatiquement le
	  dossier ReplicatedStorage > Remotes et tous les remotes listés ci-dessous.
	  => Tu n'as RIEN à créer à la main.
	- Le CLIENT utilise Net.Event("Nom") / Net.Function("Nom") qui attendent
	  que le remote existe.

	Sens de communication :
	  C -> S : le client DEMANDE, le serveur valide TOUT.
	  S -> C : le serveur informe le client.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

Net.Events = {
	"ClientReady", -- C -> S () : l'interface est prête, envoie-moi tout
	"Click", -- C -> S () : un clic sur le bouton
	"StateUpdate", -- S -> C (state) : état complet du joueur
	"StateTick", -- S -> C (tick) : petite mise à jour fréquente (Dopamine, clics...) entre deux états complets
	"Notify", -- S -> C (payload) : succès, quêtes, bonus, jackpot, détox...
	"DVDSetup", -- S -> C ({ Logos = { params... } }) : trajectoires des logos DVD
	"DVDResize", -- C -> S (w, h) : taille d'un logo à l'écran (fraction de l'écran)
	"DVDClick", -- C -> S (index) : clic sur le logo numéro `index`
	"DVDCorner", -- C -> S (index, k) : le logo `index` a touché un coin au rebond k
	"Spawn", -- S -> C (info) : un objet à cliquer apparaît (étoile, éclair, notif, mail)
	"SpawnClick", -- C -> S (id) : le joueur a cliqué cet objet
	"Interact", -- C -> S (kind, arg) : papier bulle, moulin, titre du fil d'actu, presse
	"EventUpdate", -- S -> C (rush) : début / fin d'un Dopamine Rush
	"LeaderboardUpdate", -- S -> C (top) : top du classement
	"ArcadeEvent", -- S <-> C (kind, payload) : arcade en temps réel (invitations, coups des duels...)
	"FriendMailEvent", -- S -> C ("New", mail filtré) : un mail d'ami Roblox arrive (FriendMailService)
}

Net.Functions = {
	"BuyUpgrade", -- C -> S (upgradeId) -> (succès, message)
	"ClaimDaily", -- C -> S () -> (succès, message)
	"SetSetting", -- C -> S (nom, valeur) -> succès
	"CasinoSpin", -- C -> S () -> (succès, résultat | message) : tour GRATUIT (1 jeton) de la machine chanceuse
	"OpenChest", -- C -> S () -> (succès, résultat | message)
	"ItemShop", -- C -> S ("buy" | "equip" | "unequip", cosmeticId) -> (succès, message)
	"ThemeShop", -- C -> S ("buy" | "equip", themeId) -> (succès, message)
	"House", -- C -> S (action, argument) -> (succès, message) : maison (achats, papier peint, sol, disposition)
	"Garden", -- C -> S (action, argument) -> (succès, résultat | message) : jardin de Dopamine
	"Arcade", -- C -> S (action, argument) -> (succès, résultat | message) : mini-jeux, tickets, duels
	"FilterText", -- C -> S (purpose "Live" | "Mail", texte) -> (succès, { Text, Topics } | message) : texte tapé, filtré par Roblox
	"FriendMail", -- C -> S (action, argument) -> (succès, résultat | message, état?) : mails entre amis Roblox (FriendMailService)
	"DebugCommand", -- C -> S (commande, argument) -> (succès, message) : UNIQUEMENT dans Studio
}

local FOLDER_NAME = "Remotes"

-- Serveur uniquement : crée tous les remotes
function Net.Setup()
	assert(RunService:IsServer(), "Net.Setup() doit être appelé par le serveur")

	local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = FOLDER_NAME
		folder.Parent = ReplicatedStorage
	end

	for _, name in ipairs(Net.Events) do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end

	for _, name in ipairs(Net.Functions) do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = folder
		end
	end
end

local function getFolder(): Instance
	return ReplicatedStorage:WaitForChild(FOLDER_NAME)
end

function Net.Event(name: string): RemoteEvent
	return getFolder():WaitForChild(name) :: RemoteEvent
end

function Net.Function(name: string): RemoteFunction
	return getFolder():WaitForChild(name) :: RemoteFunction
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="203">
        <Properties>
          <string name="Name">NumberFormatter</string>
          <string name="Source"><![CDATA[--[[
	NumberFormatter (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > NumberFormatter

	Formate les grands nombres : 1 234 -> "1.23K", 5 600 000 -> "5.6M", etc.
]]

local NumberFormatter = {}

-- Suffixes : K = mille, M = million, B = milliard, T = billion, puis notation anglaise courte
local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc", "UDc", "DDc", "TDc", "QaDc", "QiDc", "SxDc", "SpDc", "OcDc", "NoDc", "Vg" }

-- Retire les zéros inutiles : "1.50" -> "1.5", "2.00" -> "2"
local function trimZeros(text: string): string
	if string.find(text, "%.") then
		text = string.gsub(text, "0+$", "")
		text = string.gsub(text, "%.$", "")
	end
	return text
end

-- Format court avec suffixe (ex. 1.23M)
function NumberFormatter.Format(value: number, decimals: number?): string
	decimals = decimals or 2
	if value ~= value then
		return "0" -- NaN
	end
	if value == math.huge then
		return "∞"
	end

	local sign = value < 0 and "-" or ""
	value = math.abs(value)

	if value < 1000 then
		-- Petits nombres : entier, ou une décimale si < 10 (ex. 2.5)
		if value < 10 and value % 1 ~= 0 then
			return sign .. trimZeros(string.format("%.1f", math.floor(value * 10) / 10))
		end
		return sign .. tostring(math.floor(value))
	end

	local tier = math.floor(math.log10(value) / 3)
	-- Corrige les petites erreurs d'arrondi de log10 (ex. 999.999...)
	if value / (10 ^ (tier * 3)) >= 1000 then
		tier += 1
	elseif value / (10 ^ (tier * 3)) < 1 then
		tier -= 1
	end
	if tier >= #SUFFIXES then
		-- Au-delà des suffixes connus : notation scientifique
		return sign .. string.format("%.2e", value)
	end

	local scaled = value / (10 ^ (tier * 3))
	-- On tronque (au lieu d'arrondir) pour ne jamais afficher plus que ce qu'on a
	local factor = 10 ^ (decimals :: number)
	-- (petite marge : 1e29 / 1e27 donne 99.9999999 en virgule flottante)
	scaled = math.floor(scaled * factor + 1e-6) / factor
	return sign .. trimZeros(string.format("%." .. tostring(decimals) .. "f", scaled)) .. SUFFIXES[tier + 1]
end

-- Format avec séparateurs de milliers (ex. 1 234 567), pour les petits nombres
function NumberFormatter.WithSpaces(value: number): string
	local text = tostring(math.floor(value))
	local result = string.reverse(text)
	result = string.gsub(result, "(%d%d%d)", "%1 ")
	result = string.reverse(result)
	return (string.gsub(result, "^%s+", ""))
end

-- Durée en secondes -> "1h 05m", "4m 12s", "9s"
function NumberFormatter.Time(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then
		return string.format("%dh %02dm", h, m)
	elseif m > 0 then
		return string.format("%dm %02ds", m, s)
	end
	return string.format("%ds", s)
end

-- Multiplicateur lisible : 2 -> "x2", 1.5 -> "x1.5"
function NumberFormatter.Multiplier(value: number): string
	if value >= 1000 then
		return "x" .. NumberFormatter.Format(value)
	end
	return "x" .. trimZeros(string.format("%.2f", value))
end

return NumberFormatter
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="204">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[--[[
	Signal (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > Signal

	Petit système d'événements (comme un BindableEvent, mais sans copier les
	tables passées en argument). Utilisé côté client pour prévenir l'interface
	qu'un nouvel état est arrivé.
]]

local Signal = {}
Signal.__index = Signal

export type Connection = { Disconnect: (self: Connection) -> () }

function Signal.new()
	return setmetatable({ _listeners = {} }, Signal)
end

-- Ajoute une fonction appelée à chaque :Fire(...)
function Signal:Connect(callback: (...any) -> ())
	local listeners = self._listeners
	local entry = { Callback = callback }
	table.insert(listeners, entry)

	return {
		Disconnect = function()
			local index = table.find(listeners, entry)
			if index then
				table.remove(listeners, index)
			end
		end,
	}
end

-- Appelle toutes les fonctions connectées (chacune dans son propre thread)
function Signal:Fire(...)
	for _, entry in ipairs(table.clone(self._listeners)) do
		task.spawn(entry.Callback, ...)
	end
end

return Signal
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="205">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="206">
      <Properties>
        <string name="Name">Main</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	Main (Script)
	Emplacement : ServerScriptService > Main

	Point d'entrée du serveur :
	  1. crée les RemoteEvents / RemoteFunctions (Net.Setup) ;
	  2. initialise puis démarre tous les services ;
	  3. gère l'arrivée et le départ des joueurs.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
Net.Setup() -- AVANT tout le reste : les clients attendent ces remotes

-- Jeu 100 % interface 2D : pas de personnage (sinon il bouge en fond avec ZQSD / espace)
Players.CharacterAutoLoads = false

local ServicesFolder = script.Parent:WaitForChild("Services")

-- Ordre important : les données d'abord, puis le jeu, puis le reste
-- (PlayerReady est appelé dans cet ordre : QuestService a besoin des stats,
-- DVDService crée les logos avant la synchro complète)
-- (MonetizationService vérifie les Game Passes, ThemeService en a besoin)
-- (HouseService corrige la maison avant QuestService : le confort compte dans les stats)
local ORDER = {
	"DataService",
	"GameService",
	"MonetizationService",
	"ThemeService",
	"EventService",
	"DVDService",
	"InteractService",
	"CasinoService",
	"LootService",
	"GardenService",
	"MinigameService",
	"ChatService",
	"FriendMailService", -- mails entre amis Roblox (après ChatService ; lit data.FriendMail)
	"CosmeticService",
	"HouseService",
	"QuestService",
	"AchievementService",
	"DailyRewardService",
	"LeaderboardService",
	"DebugService",
}

local services = {}
for _, name in ipairs(ORDER) do
	services[name] = require(ServicesFolder:WaitForChild(name))
end

-- Init : chaque service reçoit la liste des autres (évite les require circulaires)
for _, name in ipairs(ORDER) do
	local service = services[name]
	if service.Init then
		service:Init(services)
	end
end

for _, name in ipairs(ORDER) do
	local service = services[name]
	if service.Start then
		service:Start()
	end
end

----------------------------------------------------------------------
-- Joueurs
----------------------------------------------------------------------

local function onPlayerAdded(player: Player)
	local data = services.DataService:LoadAsync(player)
	if not data or not player.Parent then
		return
	end

	for _, name in ipairs(ORDER) do
		local service = services[name]
		if service.PlayerReady then
			local ok, err = pcall(service.PlayerReady, service, player, data)
			if not ok then
				warn("[Main] Erreur PlayerReady dans " .. name .. " :", err)
			end
		end
	end

	services.GameService:SendFullSync(player)
end

local function onPlayerRemoving(player: Player)
	for _, name in ipairs(ORDER) do
		local service = services[name]
		if service.PlayerRemoving then
			local ok, err = pcall(service.PlayerRemoving, service, player)
			if not ok then
				warn("[Main] Erreur PlayerRemoving dans " .. name .. " :", err)
			end
		end
	end
	services.DataService:ReleaseAsync(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)

-- Joueurs déjà présents (arrive parfois dans Studio)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="207">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="ModuleScript" referent="208">
        <Properties>
          <string name="Name">AchievementService</string>
          <string name="Source"><![CDATA[--[[
	AchievementService (ModuleScript)
	Emplacement : ServerScriptService > Services > AchievementService

	Vérifie les succès (définis dans Config.Achievements) et donne les
	récompenses. Appelé automatiquement par GameService quand l'état change.
	Si un succès a un BadgeId (Config.AchievementBadges), le vrai badge
	Roblox est aussi donné (BadgeService), y compris pour les succès déjà
	débloqués avant que le badge existe (vérifié à la connexion).
]]

local BadgeService = game:GetService("BadgeService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)

local AchievementService = {}

local services

function AchievementService:Init(allServices)
	services = allServices
end

-- Donne le badge Roblox d'un succès (en arrière-plan, jamais bloquant)
local function awardBadge(player: Player, achievement)
	local badgeId = achievement.BadgeId
	if type(badgeId) ~= "number" or badgeId <= 0 then
		return
	end
	task.spawn(function()
		local okHas, has = pcall(function()
			return BadgeService:UserHasBadgeAsync(player.UserId, badgeId)
		end)
		if okHas and has then
			return
		end
		local ok, err = pcall(function()
			BadgeService:AwardBadge(player.UserId, badgeId)
		end)
		if not ok then
			warn("[AchievementService] Badge " .. tostring(badgeId) .. " non donné :", err)
		end
	end)
end

-- À la connexion : badges des succès déjà débloqués (si le badge a été ajouté après)
function AchievementService:PlayerReady(player: Player, data)
	for _, achievement in ipairs(Config.Achievements) do
		if data.Achievements[achievement.Id] then
			awardBadge(player, achievement)
		end
	end
end

-- Valeur actuelle d'une statistique (dans data.Stats, ou à la racine comme Rebirths)
function AchievementService:GetStatValue(data, statName: string): number
	local value = data.Stats[statName]
	if value == nil then
		value = data[statName]
	end
	return (type(value) == "number") and value or 0
end

function AchievementService:Check(player: Player)
	local data = services.DataService:GetData(player)
	if not data then
		return
	end

	for _, achievement in ipairs(Config.Achievements) do
		if not data.Achievements[achievement.Id] then
			local value = self:GetStatValue(data, achievement.Stat)
			if value >= achievement.Goal then
				data.Achievements[achievement.Id] = true
				services.GameService:AddDopamine(player, achievement.Reward, false)
				-- Id envoyé : le client peut afficher Locale.T(Config.AchievementsById[Id].Name).
				-- Title, Text et Name sont déjà dans la langue du joueur.
				local name = services.GameService:T(player, achievement.Name)
				services.GameService:Notify(player, {
					Type = "Achievement",
					Icon = achievement.Icon,
					Title = services.GameService:T(player, "ACHIEVEMENT UNLOCKED!"),
					Text = achievement.Icon .. " " .. name .. "  (+" .. NumberFormatter.Format(achievement.Reward) .. ")",
					Id = achievement.Id,
					Name = name,
					Reward = achievement.Reward,
					BadgeAwarded = achievement.BadgeId > 0,
				})
				awardBadge(player, achievement)
			end
		end
	end
end

return AchievementService
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="209">
        <Properties>
          <string name="Name">Arcade</string>
        </Properties>
        <Item class="ModuleScript" referent="210">
          <Properties>
            <string name="Name">SoloGames</string>
            <string name="Source"><![CDATA[--[[
	SoloGames (ModuleScript)
	Emplacement : ServerScriptService > Services > Arcade > SoloGames

	🕹️ Mini-jeux SOLO de l'arcade, côté serveur (anti-triche) :
	  💣 Minesweeper, 🃏 Memory, 🎵 Simon, 🔨 WhackAMole, 🐍 Snake, 🔢 Game2048.

	Appelé par MinigameService pour toute action "solo:..." :
	  SoloGames.Handle(player, data, action, arg, api) -> (ok, résultat | message)

	Principe : une seule partie en cours par joueur (session en mémoire,
	jamais sauvegardée). Chaque partie a un jeton (Token) à renvoyer.
	  - Démineur, Memory, Simon : le SERVEUR garde le plateau / le paquet /
	    la séquence et répond coup par coup (le client ne voit jamais les
	    mines ni les cartes cachées).
	  - Tape-taupe, Snake, 2048 : le serveur donne une graine (Seed), le
	    client joue avec la même simulation (Client > Minigames > Solo_Logic)
	    et envoie à la fin le journal de la partie ; le serveur la REJOUE et
	    vérifie les durées (impossible d'annoncer un faux score).

	Protocole (arg = table ; toute valeur invalide est refusée sans erreur) :
	  solo:info   nil                                  -> { Best = { ["Id:Diff"] = n } }
	  solo:start  { Game, Difficulty }                 -> { Token, Game, Difficulty, Best, ... (selon le jeu) }
	  solo:move   { Token, ... }                       -> selon le jeu (Démineur, Memory, Simon)
	  solo:finish { Token, ... }                       -> { Done = true, Won, Stars, Score, Tickets, Trophies, Dopamine, ... }
	  (voir le détail en bas de chaque section)

	Récompenses : une victoire (>= 1 étoile) appelle api.RewardWin (base
	ArcadeConfig : tickets, 🏆 trophée, Dopamine, stat MinigamesWon, parties
	récompensées par jour, record), puis ajoute un bonus selon la difficulté et les étoiles
	(Solo_Logic.Multiplier) tant que le quota du jour n'est pas atteint.
	Records par difficulté : data.Arcade.Solo.Best["Id:Diff"] (nettoyé ici).
	L'onglet Records de l'arcade (data.Arcade.Best) reçoit le score du mode
	RECORD_DIFFICULTY ("Normal") pour que les records restent comparables.
]]

local SoloGames = {}

local RECORD_DIFFICULTY = "Normal"
local MAX_BEST_ENTRIES = 64

----------------------------------------------------------------------
-- Dépendances (résolues sans jamais bloquer ; injectables pour les tests)
----------------------------------------------------------------------

local Logic = nil
local ArcadeConfig = nil

local function resolveModules()
	if Logic then
		return
	end
	local ok, err = pcall(function()
		local ReplicatedStorage = game:GetService("ReplicatedStorage")
		local folder = ReplicatedStorage:WaitForChild("Client", 10):WaitForChild("Minigames", 10)
		Logic = require(folder:WaitForChild("Solo_Logic", 10))
		local shared = ReplicatedStorage:FindFirstChild("Shared")
		local config = shared and shared:FindFirstChild("ArcadeConfig")
		if config then
			ArcadeConfig = require(config)
		end
	end)
	if not ok then
		warn("[SoloGames] Solo_Logic introuvable : " .. tostring(err))
	end
end

-- Tests hors Roblox : SoloGames._Inject(logicModule, arcadeConfig)
function SoloGames._Inject(logicModule, arcadeConfig)
	Logic = logicModule
	ArcadeConfig = arcadeConfig
end

-- Hasard du serveur (plateaux secrets : Démineur, Memory, Simon, graines)
local serverRandom = nil
local function randomInt(a: number, b: number): number
	if b <= a then
		return a
	end
	if serverRandom == nil then
		local ok, rng = pcall(function()
			return Random.new()
		end)
		serverRandom = ok and rng or false
	end
	if serverRandom then
		return serverRandom:NextInteger(a, b)
	end
	return math.random(a, b)
end

----------------------------------------------------------------------
-- Sessions (une partie en cours par joueur, en mémoire seulement)
----------------------------------------------------------------------

local sessions = {}
local tokenCounter = 0

pcall(function()
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		sessions[player] = nil
	end)
end)

function SoloGames.Cleanup(player)
	sessions[player] = nil
end

-- Tests : session en cours d'un joueur (lecture seule)
function SoloGames._GetSession(player)
	return sessions[player]
end

local function now(api): number
	if type(api.Now) == "function" then
		local ok, value = pcall(api.Now)
		if ok and type(value) == "number" and value == value then
			return value
		end
	end
	return os.clock()
end

local function T(api, player, text: string, ...): string
	if type(api.T) == "function" then
		local ok, result = pcall(api.T, player, text, ...)
		if ok and type(result) == "string" then
			return result
		end
	end
	if select("#", ...) > 0 then
		local ok, result = pcall(string.format, text, ...)
		if ok then
			return result
		end
	end
	return text
end

-- Entier valide dans [lo, hi] (sinon nil) : protège contre NaN, 1e999, "1"...
local function int(value: any, lo: number, hi: number): number?
	if type(value) ~= "number" or value ~= value or value % 1 ~= 0 or value < lo or value > hi then
		return nil
	end
	return value
end

----------------------------------------------------------------------
-- Données : records par difficulté (data.Arcade.Solo)
----------------------------------------------------------------------

local function soloData(data)
	if type(data.Arcade) ~= "table" then
		data.Arcade = {}
	end
	local solo = data.Arcade.Solo
	if type(solo) ~= "table" then
		solo = {}
		data.Arcade.Solo = solo
	end
	if type(solo.Best) ~= "table" then
		solo.Best = {}
	end
	-- Nettoyage : seulement "Jeu:Difficulté" connus, nombres finis >= 0
	local count = 0
	for key, value in pairs(solo.Best) do
		local valid = false
		if type(key) == "string" and type(value) == "number" and value == value and value >= 0 and value < 1e12 then
			local gameId, difficulty = string.match(key, "^(%w+):(%w+)$")
			valid = gameId ~= nil and Logic.GetRules(gameId, difficulty) ~= nil
		end
		if valid then
			count += 1
		end
		if not valid or count > MAX_BEST_ENTRIES then
			solo.Best[key] = nil
		end
	end
	for key in pairs(solo) do
		if key ~= "Best" then
			solo[key] = nil
		end
	end
	return solo
end

local function bestKey(session): string
	return session.Game .. ":" .. session.Difficulty
end

-- Met à jour le record perso ; renvoie (record, nouveau record ?)
local function updateBest(data, session, value: number?, lower: boolean): (number?, boolean)
	local solo = soloData(data)
	local key = bestKey(session)
	local old = solo.Best[key]
	if type(value) ~= "number" or value ~= value or value < 0 then
		return old, false
	end
	local better = old == nil or (lower and value < old) or (not lower and value > old)
	if better and (lower or value > 0) then
		solo.Best[key] = value
		return value, true
	end
	return old, false
end

----------------------------------------------------------------------
-- Fin de partie : stats, récompenses, records
----------------------------------------------------------------------

local function arcadeEntry(api, gameId: string)
	local config = (type(api.Config) == "table" and api.Config) or ArcadeConfig
	local byId = config and config.GamesById
	return type(byId) == "table" and byId[gameId] or nil
end

local function callApi(api, name: string, ...)
	local fn = api[name]
	if type(fn) ~= "function" then
		return false, nil
	end
	local ok, result = pcall(fn, ...)
	if not ok then
		warn("[SoloGames] api." .. name .. " : " .. tostring(result))
		return false, nil
	end
	return true, result
end

-- metrics : { Score (affiché), Record (valeur de record, optionnelle), Stars,
-- Lower (record "plus petit = mieux"), Rejected (message anti-triche) }
local function conclude(player, data, api, session, metrics)
	session.Done = true
	if sessions[player] == session then
		sessions[player] = nil
	end
	local stars = math.clamp(math.floor(metrics.Stars or 0), 0, 3)
	local elapsed = now(api) - (session.FirstMove or session.Started)
	local result = {
		Done = true,
		Game = session.Game,
		Difficulty = session.Difficulty,
		Won = stars >= 1,
		Stars = stars,
		Score = metrics.Score or 0,
		Time = math.floor(elapsed * 10) / 10,
		Tickets = 0,
		Trophies = 0,
		Dopamine = 0,
		Capped = false,
		Record = false,
		NewBest = false,
	}
	-- Une partie compte si le joueur a vraiment joué
	if session.Moves > 0 or metrics.Played then
		callApi(api, "CountPlay", player, session.Game)
	end
	if metrics.Rejected then
		result.Won = false
		result.Stars = 0
		result.Rejected = metrics.Rejected
		result.Best = soloData(data).Best[bestKey(session)]
		return result
	end
	if stars >= 1 then
		local recordValue = session.Difficulty == RECORD_DIFFICULTY and (metrics.Record or metrics.Score) or nil
		local entry = arcadeEntry(api, session.Game)
		local baseTickets = entry and tonumber(entry.Tickets) or 0
		local baseSeconds = entry and tonumber(entry.RewardSeconds) or 0
		local okReward, reward = callApi(api, "RewardWin", player, session.Game, recordValue)
		if okReward and type(reward) == "table" then
			result.Tickets = tonumber(reward.Tickets) or 0
			result.Trophies = tonumber(reward.Trophies) or 0 -- 🏆 (mises des duels, jamais achetables)
			result.Dopamine = tonumber(reward.Dopamine) or 0
			result.Capped = reward.Capped == true
			result.Record = reward.Record == true
		elseif type(api.RewardWin) ~= "function" then
			-- Ancien contrat : récompense de base à la main
			local _, granted = callApi(api, "GrantTickets", player, baseTickets)
			local _, amount = callApi(api, "GrantDopamineSeconds", player, baseSeconds)
			callApi(api, "AddStat", player, "MinigamesWon", 1)
			result.Tickets = tonumber(granted) or 0
			result.Dopamine = tonumber(amount) or 0
		end
		-- Bonus de difficulté / étoiles (pas de bonus si le quota du jour est atteint)
		if not result.Capped then
			local totalTickets, totalSeconds = Logic.Reward(baseTickets, baseSeconds, session.Difficulty, stars)
			local bonusTickets = math.max(0, totalTickets - baseTickets)
			local bonusSeconds = math.max(0, totalSeconds - baseSeconds)
			if bonusTickets > 0 then
				local _, granted = callApi(api, "GrantTickets", player, bonusTickets)
				result.Tickets += tonumber(granted) or 0
			end
			if bonusSeconds > 0 then
				local _, amount = callApi(api, "GrantDopamineSeconds", player, bonusSeconds)
				result.Dopamine += tonumber(amount) or 0
			end
		end
	end
	-- Record perso de cette difficulté (temps : seulement les victoires)
	local bestValue = metrics.Record or metrics.Score
	if metrics.Lower and stars < 1 then
		bestValue = nil
	end
	result.Best, result.NewBest = updateBest(data, session, bestValue, metrics.Lower == true)
	return result
end

local function newSession(player, gameId: string, difficulty: string, gameRules, rules, api)
	tokenCounter += 1
	local session = {
		Game = gameId,
		Difficulty = difficulty,
		GameRules = gameRules,
		Rules = rules,
		Token = tokenCounter * 1000 + randomInt(0, 999),
		Started = now(api),
		Moves = 0,
		Done = false,
	}
	sessions[player] = session
	return session
end

----------------------------------------------------------------------
-- 💣 Démineur
--   start  -> { Cols, Rows, Mines }
--   move   { Token, Cell = i } ou { Token, Cells = { i, ... } (<= 9, "accord") }
--          -> { Cells = { i... }, Numbers = { n... } }  (+ Boom, Cell, Mines = { i... }, Done, Result en fin)
--   finish { Token } -> abandon (défaite)
----------------------------------------------------------------------

local Minesweeper = {}

function Minesweeper.Start(session, reply)
	local rules = session.Rules
	session.Board = Logic.MineBoard(rules.Cols, rules.Rows, rules.Mines)
	reply.Cols = rules.Cols
	reply.Rows = rules.Rows
	reply.Mines = rules.Mines
end

local function allMines(board): { number }
	local list = {}
	for index in pairs(board.Mines or {}) do
		table.insert(list, index)
	end
	table.sort(list)
	return list
end

-- Chrono à partir du premier coup (comme le démineur classique)
local function playTime(session, api): number
	return math.floor((now(api) - (session.FirstMove or session.Started)) * 10) / 10
end

local function mineMetrics(session, api, won: boolean)
	local board = session.Board
	local elapsed = playTime(session, api)
	local stars = Logic.Stars("Minesweeper", session.Rules, {
		Won = won,
		Time = elapsed,
		Progress = board.SafeTotal > 0 and board.RevealedCount / board.SafeTotal or 0,
	})
	local metrics = { Stars = stars, Score = elapsed, Record = elapsed, Lower = true }
	if won and elapsed < (session.Rules.MinSeconds or 0) then
		metrics.Rejected = "Too fast! This run can't be rewarded."
	end
	return metrics
end

function Minesweeper.Move(player, data, api, session, arg)
	local board = session.Board
	local total = board.Cols * board.Rows
	local list = {}
	if type(arg.Cells) == "table" then
		for k = 1, 9 do
			local cell = int(arg.Cells[k], 1, total)
			if cell then
				table.insert(list, cell)
			end
		end
	else
		local cell = int(arg.Cell, 1, total)
		if cell then
			table.insert(list, cell)
		end
	end
	if #list == 0 then
		return false, T(api, player, "Invalid move")
	end
	if not board.Mines then
		Logic.MinePlace(board, list[1], randomInt)
		session.FirstMove = now(api)
	end
	session.Moves += 1
	local reply = { Cells = {}, Numbers = {} }
	for _, cell in ipairs(list) do
		local opened, boom = Logic.MineReveal(board, cell)
		if boom then
			reply.Boom = true
			reply.Cell = cell
			reply.Mines = allMines(board)
			reply.Done = true
			local metrics = mineMetrics(session, api, false)
			if metrics.Rejected then
				metrics.Rejected = nil
			end
			reply.Result = conclude(player, data, api, session, metrics)
			return true, reply
		end
		for _, index in ipairs(opened) do
			table.insert(reply.Cells, index)
			table.insert(reply.Numbers, board.Counts[index])
		end
	end
	if Logic.MineWon(board) then
		reply.Won = true
		reply.Mines = allMines(board)
		reply.Done = true
		reply.Result = conclude(player, data, api, session, mineMetrics(session, api, true))
	end
	return true, reply
end

function Minesweeper.Finish(player, data, api, session, _arg)
	return true, conclude(player, data, api, session, { Stars = 0, Score = 0, Lower = true })
end

----------------------------------------------------------------------
-- 🃏 Memory
--   start  -> { Cols, Rows, Pairs }
--   move   { Token, Cell = i } -> { Cell, Symbol } (1re carte) ou
--          { Cell, Symbol, Other, Match, Pairs, Moves } (2e carte) (+ Done, Result à la fin)
--          { Ignored = true } si la carte est déjà ouverte / trouvée
--   finish { Token } -> abandon
----------------------------------------------------------------------

local Memory = {}

function Memory.Start(session, reply)
	local rules = session.Rules
	session.Deck = Logic.MemoryDeck(rules.Pairs, randomInt)
	session.Matched = {}
	session.Found = 0
	session.Turns = 0
	session.Open = nil
	reply.Cols = rules.Cols
	reply.Rows = rules.Rows
	reply.Pairs = rules.Pairs
end

function Memory.Move(player, data, api, session, arg)
	local cell = int(arg.Cell, 1, #session.Deck)
	if not cell then
		return false, T(api, player, "Invalid move")
	end
	if session.Matched[cell] or session.Open == cell then
		return true, { Ignored = true, Cell = cell }
	end
	session.Moves += 1
	session.FirstMove = session.FirstMove or now(api)
	local symbol = session.Deck[cell]
	if not session.Open then
		session.Open = cell
		return true, { Cell = cell, Symbol = symbol }
	end
	local other = session.Open
	session.Open = nil
	session.Turns += 1
	local match = session.Deck[other] == symbol
	if match then
		session.Matched[cell] = true
		session.Matched[other] = true
		session.Found += 1
	end
	local reply = { Cell = cell, Symbol = symbol, Other = other, Match = match, Pairs = session.Found, Moves = session.Turns }
	if session.Found >= session.Rules.Pairs then
		local elapsed = playTime(session, api)
		local stars = Logic.Stars("Memory", session.Rules, { Won = true, Moves = session.Turns })
		local metrics = { Stars = stars, Score = session.Turns, Record = elapsed, Lower = true }
		if elapsed < (session.Rules.MinSeconds or 0) then
			metrics.Rejected = "Too fast! This run can't be rewarded."
		end
		reply.Done = true
		reply.Result = conclude(player, data, api, session, metrics)
	end
	return true, reply
end

function Memory.Finish(player, data, api, session, _arg)
	return true, conclude(player, data, api, session, { Stars = 0, Score = session.Turns or 0, Lower = true })
end

----------------------------------------------------------------------
-- 🎵 Simon
--   start  -> { Pads, Step, MaxRounds, Sequence = { pad } }
--   move   { Token, Inputs = { pad, ... } } (la manche entière, ou jusqu'à l'erreur)
--          -> { Round, Sequence } (manche réussie : séquence complète suivante)
--          -> { Wrong = true, Expected, Done, Result } (erreur = fin)
--   finish { Token } -> arrêt (score = manches réussies)
----------------------------------------------------------------------

local Simon = {}

function Simon.Start(session, reply, api)
	local rules = session.Rules
	session.Sequence = { randomInt(1, rules.Pads) }
	session.SentAt = now(api)
	session.Rounds = 0
	reply.Pads = rules.Pads
	reply.Step = rules.Step
	reply.MaxRounds = session.GameRules.MaxRounds
	reply.Sequence = table.clone(session.Sequence)
end

local function simonEnd(player, data, api, session)
	local score = session.Rounds
	local stars = Logic.Stars("Simon", session.Rules, { Score = score })
	return conclude(player, data, api, session, { Stars = stars, Score = score })
end

function Simon.Move(player, data, api, session, arg)
	local inputs = arg.Inputs
	local sequence = session.Sequence
	if type(inputs) ~= "table" then
		return false, T(api, player, "Invalid move")
	end
	local count = 0
	for k = 1, #sequence do
		local value = inputs[k]
		if value == nil then
			break
		end
		count = k
		local pad = int(value, 1, session.Rules.Pads)
		if pad ~= sequence[k] then
			session.Moves += 1
			local reply = { Wrong = true, Expected = sequence[k], Index = k, Done = true }
			reply.Result = simonEnd(player, data, api, session)
			return true, reply
		end
	end
	if count < #sequence then
		return false, T(api, player, "Invalid move")
	end
	-- Anti-robot : il faut au moins le temps de voir la séquence et de la rejouer
	local elapsed = now(api) - session.SentAt
	local minimum = #sequence * session.Rules.Step * 0.85 + #sequence * 0.07
	if elapsed < minimum then
		return false, T(api, player, "Too fast!")
	end
	session.Moves += 1
	session.Rounds = #sequence
	if session.Rounds >= session.GameRules.MaxRounds then
		return true, { Round = session.Rounds, Done = true, Result = simonEnd(player, data, api, session) }
	end
	table.insert(sequence, randomInt(1, session.Rules.Pads))
	session.SentAt = now(api)
	return true, { Round = session.Rounds, Sequence = table.clone(sequence) }
end

function Simon.Finish(player, data, api, session, _arg)
	return true, simonEnd(player, data, api, session)
end

----------------------------------------------------------------------
-- 🔨 Tape-taupe (programme des taupes = Solo_Logic.WhackSchedule(Seed))
--   start  -> { Seed, Holes, Duration }
--   finish { Token, Hits = { index dans le programme, ... } } (après Duration s)
----------------------------------------------------------------------

local Whack = {}

function Whack.Start(session, reply)
	local gameRules = session.GameRules
	session.Seed = randomInt(1, 2147483646)
	reply.Seed = session.Seed
	reply.Holes = gameRules.Holes
	reply.Duration = gameRules.Duration
end

function Whack.Finish(player, data, api, session, arg)
	local gameRules = session.GameRules
	local elapsed = now(api) - session.Started
	local schedule, maxScore = Logic.WhackSchedule(session.Seed, session.Rules, gameRules.Holes, gameRules.Duration)
	local hits = type(arg.Hits) == "table" and arg.Hits or {}
	local score, counted = Logic.WhackScore(schedule, hits, elapsed)
	session.Moves += counted
	if elapsed < gameRules.Duration - 1.5 then
		-- partie arrêtée avant la fin : pas de victoire
		return true, conclude(player, data, api, session, { Stars = 0, Score = score, Played = counted > 0 })
	end
	local stars = Logic.Stars("WhackAMole", session.Rules, { Score = score, Max = maxScore })
	return true, conclude(player, data, api, session, { Stars = stars, Score = score, Played = true })
end

----------------------------------------------------------------------
-- 🐍 Snake (rejoué avec Solo_Logic.SnakeReplay)
--   start  -> { Seed, Cols, Rows, Tick, Wrap }
--   finish { Token, Turns = { tick1, dir1, tick2, dir2, ... }, Ticks = pas joués }
----------------------------------------------------------------------

local Snake = {}

function Snake.Start(session, reply)
	local rules = session.Rules
	session.Seed = randomInt(1, 2147483646)
	reply.Seed = session.Seed
	reply.Cols = rules.Cols
	reply.Rows = rules.Rows
	reply.Tick = rules.Tick
	reply.Wrap = rules.Wrap
end

function Snake.Finish(player, data, api, session, arg)
	local gameRules = session.GameRules
	local maxTicks = gameRules.MaxTicks
	local turns = {}
	if type(arg.Turns) == "table" then
		local last = 0
		for k = 1, math.min(#arg.Turns, 12000), 2 do
			local tick = int(arg.Turns[k], 1, maxTicks)
			local dir = int(arg.Turns[k + 1], 1, 4)
			if not tick or not dir or tick <= last then
				break -- journal abîmé : on garde le début
			end
			last = tick
			table.insert(turns, tick)
			table.insert(turns, dir)
		end
	end
	local ticks = int(arg.Ticks, 0, maxTicks) or 0
	local score, played, minDuration = Logic.SnakeReplay(session.Seed, session.Rules, turns, ticks, maxTicks)
	session.Moves += played
	local elapsed = now(api) - session.Started
	local stars = Logic.Stars("Snake", session.Rules, { Score = score })
	local metrics = { Stars = stars, Score = score, Played = played > 0 }
	if elapsed < minDuration * 0.8 - 1 then
		metrics.Rejected = "Too fast! This run can't be rewarded."
	end
	return true, conclude(player, data, api, session, metrics)
end

----------------------------------------------------------------------
-- 🔢 2048 (rejoué avec Solo_Logic.G2048Replay)
--   start  -> { Seed, Size, Target }
--   finish { Token, Moves = "URDL..." (coups qui ont bougé) }
----------------------------------------------------------------------

local G2048 = {}

function G2048.Start(session, reply)
	session.Seed = randomInt(1, 2147483646)
	reply.Seed = session.Seed
	reply.Size = session.GameRules.Size
	reply.Target = session.Rules.Target
end

function G2048.Finish(player, data, api, session, arg)
	local gameRules = session.GameRules
	local moves = arg.Moves
	if type(moves) ~= "string" or #moves > gameRules.MaxMoves + 16 then
		moves = ""
	end
	local state, played = Logic.G2048Replay(session.Seed, session.Rules, gameRules.Size, moves, gameRules.MaxMoves)
	session.Moves += played
	local elapsed = now(api) - session.Started
	local stars = Logic.Stars("Game2048", session.Rules, { MaxTile = state.MaxTile })
	local metrics = { Stars = stars, Score = state.Score, Played = played > 0 }
	if elapsed + 1 < played * gameRules.MinMoveSeconds then
		metrics.Rejected = "Too fast! This run can't be rewarded."
	end
	local result = conclude(player, data, api, session, metrics)
	result.MaxTile = state.MaxTile
	return true, result
end

----------------------------------------------------------------------
-- Routage
----------------------------------------------------------------------

local HANDLERS = {
	Minesweeper = Minesweeper,
	Memory = Memory,
	Simon = Simon,
	WhackAMole = Whack,
	Snake = Snake,
	Game2048 = G2048,
}

-- Abandon silencieux de la partie en cours (nouvelle partie lancée)
local function dropSession(player, data, api)
	local session = sessions[player]
	if session and not session.Done then
		conclude(player, data, api, session, { Stars = 0, Score = 0, Lower = true })
	end
	sessions[player] = nil
end

local function activeSession(player, api, arg)
	local session = sessions[player]
	if not session or type(arg) ~= "table" or arg.Token ~= session.Token then
		return nil, T(api, player, "This game is over. Start a new one!")
	end
	if now(api) - session.Started > Logic.SessionTimeout then
		sessions[player] = nil
		return nil, T(api, player, "This game is over. Start a new one!")
	end
	return session, nil
end

local function dispatch(player, data, action: string, arg, api)
	if action == "solo:info" then
		local best = table.clone(soloData(data).Best)
		return true, { Best = best }
	end

	if action == "solo:start" then
		if type(arg) ~= "table" then
			return false, T(api, player, "Invalid request")
		end
		local gameRules, rules = Logic.GetRules(arg.Game, arg.Difficulty)
		local handler = HANDLERS[arg.Game]
		if not gameRules or not handler then
			return false, T(api, player, "Unknown game")
		end
		dropSession(player, data, api)
		local session = newSession(player, arg.Game, arg.Difficulty, gameRules, rules, api)
		local reply = { Token = session.Token, Game = session.Game, Difficulty = session.Difficulty }
		handler.Start(session, reply, api)
		reply.Best = soloData(data).Best[bestKey(session)]
		return true, reply
	end

	if action == "solo:move" then
		local session, message = activeSession(player, api, arg)
		if not session then
			return false, message
		end
		local handler = HANDLERS[session.Game]
		if not handler.Move then
			return false, T(api, player, "Invalid move")
		end
		return handler.Move(player, data, api, session, arg)
	end

	if action == "solo:finish" then
		local session, message = activeSession(player, api, arg)
		if not session then
			return false, message
		end
		return HANDLERS[session.Game].Finish(player, data, api, session, arg)
	end

	return false, T(api, player, "Invalid request")
end

function SoloGames.Handle(player, data, action, arg, api)
	if type(api) ~= "table" then
		return false, "Invalid request"
	end
	if type(action) ~= "string" or type(data) ~= "table" or player == nil then
		return false, T(api, player, "Invalid request")
	end
	resolveModules()
	if not Logic then
		return false, T(api, player, "Arcade unavailable, try again later")
	end
	local ok, success, result = pcall(dispatch, player, data, action, arg, api)
	if not ok then
		warn("[SoloGames] " .. tostring(action) .. " : " .. tostring(success))
		return false, T(api, player, "Something went wrong")
	end
	return success, result
end

return SoloGames
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="211">
        <Properties>
          <string name="Name">CasinoService</string>
          <string name="Source"><![CDATA[--[[
	CasinoService (ModuleScript)
	Emplacement : ServerScriptService > Services > CasinoService

	🎰 Machine chanceuse (débloquée par l'amélioration "Lucky Machine").
	Tours GRATUITS : on ne mise JAMAIS rien (la Dopamine s'achète en Robux,
	donc aucun pari avec elle : règles Roblox sur les jeux d'argent).
	  - Jetons : 1 toutes les Config.Casino.TokenInterval secondes de jeu
	    (au plus MaxTokens). StartTokens offerts une seule fois quand la
	    machine est débloquée (data.Casino.Tokens = -1 : jamais initialisé).
	  - Un tour coûte 1 jeton. Le SERVEUR tire les 3 symboles (selon leur
	    poids) ; le gain vaut des SECONDES de production
	    (Formulas.GetCasinoRewardSeconds -> Formulas.ScaledReward) : paire,
	    triple, ou petit lot de consolation (MissRewardSeconds).
	  - Fermée seulement si Config.Casino.Enabled = false (ou si
	    Config.Monetization.DisableCasinoWhenSelling est forcé à true).
	Le client ne fait qu'afficher l'animation puis le résultat reçu.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Locale = require(ReplicatedStorage.Shared.Locale)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Net = require(ReplicatedStorage.Shared.Net)
local RateLimiter = require(script.Parent.RateLimiter)

local CasinoService = {}

local services
local random = Random.new()
local settings = Config.Casino

local CHARGE_RATE = 1 -- (s) fréquence de la recharge des jetons
local BIG_WIN_SECONDS = 240 -- à partir de ce gain (en secondes), tout le serveur est prévenu

function CasinoService:Init(allServices)
	services = allServices
end

local function isValidNumber(value: any): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

-- Répare data.Casino (sauvegarde abîmée) et donne les jetons de départ
-- la première fois que la machine est possédée. Renvoie true si ça a changé.
local function ensure(data): boolean
	local casino = data.Casino
	if type(casino) ~= "table" then
		casino = { Tokens = -1, Progress = 0 }
		data.Casino = casino
	end
	local changed = false
	if not isValidNumber(casino.Tokens) then
		casino.Tokens = -1
	end
	if not isValidNumber(casino.Progress) then
		casino.Progress = 0
	end
	casino.Progress = math.clamp(casino.Progress, 0, 1)
	if casino.Tokens < 0 then
		casino.Tokens = -1
		if Formulas.HasFeature(data, settings.Feature) then
			casino.Tokens = math.clamp(math.floor(settings.StartTokens or 0), 0, settings.MaxTokens)
			casino.Progress = 0
			changed = true
		end
	else
		casino.Tokens = math.clamp(math.floor(casino.Tokens), 0, settings.MaxTokens)
	end
	if casino.Tokens >= settings.MaxTokens then
		casino.Progress = 0
	end
	return changed
end

-- Recharge : `elapsed` secondes de jeu. Renvoie true si un jeton a été gagné.
local function charge(data, elapsed: number): boolean
	local changed = ensure(data)
	local casino = data.Casino
	if casino.Tokens < 0 or not Formulas.HasFeature(data, settings.Feature) then
		return changed
	end
	if casino.Tokens >= settings.MaxTokens then
		casino.Progress = 0
		return changed
	end
	casino.Progress += elapsed / math.max(1, settings.TokenInterval)
	while casino.Progress >= 1 and casino.Tokens < settings.MaxTokens do
		casino.Progress -= 1
		casino.Tokens += 1
		changed = true
	end
	if casino.Tokens >= settings.MaxTokens then
		casino.Progress = 0
	end
	return changed
end

-- Ajoute des jetons (commandes de test, récompenses éventuelles)
function CasinoService:AddTokens(player: Player, count: number)
	local data = services.DataService:GetData(player)
	if not data or not isValidNumber(count) then
		return
	end
	ensure(data)
	data.Casino.Tokens = math.clamp(math.max(0, data.Casino.Tokens) + math.floor(count), 0, settings.MaxTokens)
	services.GameService:SendState(player)
end

-- Champs ajoutés à l'état envoyé au client (voir GameService:BuildState)
function CasinoService:GetClientState(_player: Player, data)
	ensure(data)
	local casino = data.Casino
	return {
		Casino = {
			Tokens = math.max(0, casino.Tokens),
			Progress = casino.Progress,
			Max = settings.MaxTokens,
			Interval = settings.TokenInterval,
		},
	}
end

-- Tire un symbole au hasard selon son poids
local function pickSymbol(): string
	local total = 0
	for _, symbol in ipairs(settings.Symbols) do
		total += symbol.Weight
	end
	local roll = random:NextNumber(0, total)
	for _, symbol in ipairs(settings.Symbols) do
		roll -= symbol.Weight
		if roll <= 0 then
			return symbol.Id
		end
	end
	return settings.Symbols[#settings.Symbols].Id
end

-- Texte dans la langue du joueur
local function T(player: Player, text: string, ...): string
	return services.GameService:T(player, text, ...)
end

local function formatWait(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

local function onSpin(player: Player, _ignored: any)
	local data = services.DataService:GetData(player)
	if not data or not services.GameService:IsReady(player) then
		return false, T(player, "Loading...")
	end
	if not services.MonetizationService:IsCasinoEnabled() then
		return false, T(player, "The lucky machine is closed")
	end
	if not Formulas.HasFeature(data, settings.Feature) then
		return false, T(player, "The lucky machine isn't unlocked yet")
	end
	-- Petite marge pour la latence réseau
	if not RateLimiter.Check(player, "CasinoSpin", math.max(0, settings.Cooldown - 0.1)) then
		return false, T(player, "The machine is still spinning...")
	end
	ensure(data)
	local casino = data.Casino
	if casino.Tokens < 1 then
		local wait = (1 - casino.Progress) * settings.TokenInterval
		return false, T(player, "No tokens left! Next one in %s", formatWait(wait))
	end

	local reels = { pickSymbol(), pickSymbol(), pickSymbol() }
	local matched = Formulas.GetCasinoMultiplier(reels)
	local seconds = Formulas.GetCasinoRewardSeconds(reels)
	local missSeconds = math.max(1, settings.MissRewardSeconds or 1)
	local minimum = (settings.MinReward or 0) * math.max(1, seconds / missSeconds)
	local reward = Formulas.ScaledReward(services.GameService:GetStats(player), seconds, minimum)

	casino.Tokens -= 1
	data.Stats.SlotSpins += 1
	if matched > 0 then
		data.Stats.SlotWins += 1
	end
	services.GameService:AddDopamine(player, reward, true)
	services.QuestService:Progress(player, "Casino", 1)
	services.GameService:SendState(player)

	if matched >= BIG_WIN_SECONDS then
		local displayName, formatted = player.DisplayName, NumberFormatter.Format(reward)
		services.GameService:NotifyAll(function(lang)
			return {
				Type = "Info",
				Text = Locale.TFor(lang, "🎰 %s hit the jackpot on the lucky machine (+%s)!", displayName, formatted),
			}
		end, player)
	end

	return true, {
		Symbols = reels,
		Reels = reels, -- (ancien nom)
		Reward = reward,
		Seconds = seconds,
		Win = matched > 0,
		Big = matched >= BIG_WIN_SECONDS,
		Tokens = casino.Tokens,
		Progress = casino.Progress,
		Max = settings.MaxTokens,
		Interval = settings.TokenInterval,
	}
end

function CasinoService:Start()
	Net.Function("CasinoSpin").OnServerInvoke = onSpin

	-- Recharge des jetons avec le temps de jeu (indépendante du tick passif)
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(CHARGE_RATE)
			local now = os.clock()
			local elapsed = math.min(now - last, 5) -- pas d'énorme rattrapage après un gel
			last = now
			for _, player in ipairs(Players:GetPlayers()) do
				local data = services.DataService:GetData(player)
				if data and services.GameService:IsReady(player) then
					local ok, changed = pcall(charge, data, elapsed)
					if not ok then
						warn("[CasinoService] Recharge des jetons de " .. player.Name .. " :", changed)
					elseif changed then
						-- Nouveau jeton : état complet (au plus 1 fois / TokenInterval)
						services.GameService:SendState(player)
					end
				end
			end
		end
	end)
end

return CasinoService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="212">
        <Properties>
          <string name="Name">ChatService</string>
          <string name="Source"><![CDATA[--[[
	ChatService (ModuleScript)
	Emplacement : ServerScriptService > Services > ChatService

	Texte TAPÉ par le joueur (chat du live, mails écrits) : obligatoirement
	passé par le filtre de Roblox (TextService) avant d'être affiché, même
	au joueur lui-même.

	RemoteFunction "FilterText" (purpose, text) -> (ok, résultat | message)
	  purpose : "Live" (message du chat du live) ou "Mail" (mail écrit)
	  résultat : { Text = texte filtré pour CE joueur, Topics = { sujets } }
	  Les sujets (ChatTopics.Detect) servent aux faux spectateurs /
	  correspondants pour répondre "en fonction de ce qu'il a dit" ; v9 : si
	  le filtre a masqué des mots, les sujets viennent du texte FILTRÉ (on ne
	  réagit jamais à un mot censuré). Le texte brut n'est jamais renvoyé ni
	  montré à personne.
	Anti-spam : 1 message / 1,2 s (live), 1 / 2 s (mail) ; longueur limitée.
	Si le filtre échoue (panne Roblox), le message n'est PAS affiché.
]]

local TextService = game:GetService("TextService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local ChatTopics = require(Shared.ChatTopics)

local RateLimiter = require(script.Parent.RateLimiter)

local ChatService = {}

local services = nil

local PURPOSES = {
	Live = { MaxLength = 120, Interval = 1.2 },
	Mail = { MaxLength = 400, Interval = 2 },
}

function ChatService:Init(allServices)
	services = allServices
end

local function T(player: Player, text: string, ...): string
	local game = services and services.GameService
	if game and game.T then
		return game:T(player, text, ...)
	end
	return string.format(text, ...)
end

-- Nettoie le texte reçu : caractères de contrôle retirés, espaces réduits
local function clean(text: string, maxLength: number): string
	text = string.gsub(text, "[%c]", " ")
	text = string.gsub(text, "%s+", " ")
	text = string.gsub(text, "^%s+", "")
	text = string.gsub(text, "%s+$", "")
	if utf8.len(text) == nil then
		return "" -- UTF-8 invalide : refusé
	end
	if (utf8.len(text) :: number) > maxLength then
		local cut = utf8.offset(text, maxLength + 1)
		if cut then
			text = string.sub(text, 1, cut - 1)
		end
	end
	return text
end

local function onFilter(player: Player, purpose: any, text: any)
	local settings = type(purpose) == "string" and PURPOSES[purpose] or nil
	if not settings or type(text) ~= "string" then
		return false, T(player, "Invalid message")
	end
	if #text > settings.MaxLength * 4 then
		return false, T(player, "Message too long")
	end
	if not RateLimiter.Check(player, "FilterText_" .. purpose, settings.Interval) then
		return false, T(player, "Slow down a little!")
	end
	local cleaned = clean(text, settings.MaxLength)
	if cleaned == "" then
		return false, T(player, "Invalid message")
	end
	local ok, filtered = pcall(function()
		local result = TextService:FilterStringAsync(cleaned, player.UserId, Enum.TextFilterContext.PublicChat)
		return result:GetNonChatStringForUserAsync(player.UserId)
	end)
	if not ok or type(filtered) ~= "string" then
		return false, T(player, "Message could not be sent, try again")
	end
	-- Sujets : sur le texte tel que le joueur a le droit de le dire. Si le
	-- filtre a masqué des mots (#####), on ne réagit qu'à ce qui reste lisible
	-- (jamais à un mot censuré).
	local topics = ChatTopics.Detect(filtered == cleaned and cleaned or filtered)
	return true, { Text = filtered, Topics = topics }
end

function ChatService:Start()
	Net.Function("FilterText").OnServerInvoke = onFilter
end

return ChatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="213">
        <Properties>
          <string name="Name">CosmeticService</string>
          <string name="Source"><![CDATA[--[[
	CosmeticService (ModuleScript)
	Emplacement : ServerScriptService > Services > CosmeticService

	Boutique d'objets (débloquée par l'amélioration "Boutique d'objets") :
	chapeaux (emoji posé sur le bouton) et skins (couleurs du bouton).
	Les objets achetés sont gardés pour toujours et donnent chacun un petit
	bonus de gains permanent (Config.CosmeticBonus).
	RemoteFunction ItemShop ("buy" | "equip" | "unequip", cosmeticId).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Net = require(ReplicatedStorage.Shared.Net)
local RateLimiter = require(script.Parent.RateLimiter)

local CosmeticService = {}

local services

function CosmeticService:Init(allServices)
	services = allServices
end

-- Texte dans la langue du joueur
local function T(player: Player, text: string, ...): string
	return services.GameService:T(player, text, ...)
end

local function onItemShop(player: Player, action: any, cosmeticId: any)
	if not RateLimiter.Check(player, "ItemShop", 0.2) then
		return false, T(player, "Slow down!")
	end
	local data = services.DataService:GetData(player)
	if not data or not services.GameService:IsReady(player) then
		return false, T(player, "Loading...")
	end
	if not Formulas.HasFeature(data, "ItemShop") then
		return false, T(player, "The shop isn't unlocked yet")
	end
	if type(action) ~= "string" or type(cosmeticId) ~= "string" or #cosmeticId > 64 then
		return false, T(player, "Invalid request")
	end
	local cosmetic = Config.CosmeticsById[cosmeticId]
	if not cosmetic then
		return false, T(player, "Unknown item")
	end

	local cosmetics = data.Cosmetics
	local slot = cosmetic.Slot
	if slot ~= "Hat" and slot ~= "Skin" then
		return false, T(player, "Invalid item")
	end
	local name = T(player, cosmetic.Name)

	if action == "buy" then
		if cosmetics.Owned[cosmeticId] then
			return false, T(player, "You already own this item")
		end
		if (cosmetic.RequiresRebirths or 0) > (data.Rebirths or 0) then
			return false, T(player, "🔒 Unlocked after %d visits to the ocean", cosmetic.RequiresRebirths)
		end
		if data.Dopamine < cosmetic.Cost then
			return false, T(player, "Not enough %s", Config.Game.CurrencyName)
		end
		data.Dopamine -= cosmetic.Cost
		cosmetics.Owned[cosmeticId] = true
		cosmetics.Equipped[slot] = cosmeticId -- équipé tout de suite
		data.Stats.CosmeticsBought += 1
		services.GameService:SendState(player)
		return true, T(player, "%s %s bought! (%s)", cosmetic.Icon, name, NumberFormatter.Format(cosmetic.Cost))
	elseif action == "equip" then
		if not cosmetics.Owned[cosmeticId] then
			return false, T(player, "You don't own this item")
		end
		cosmetics.Equipped[slot] = cosmeticId
		services.GameService:SendState(player)
		return true, T(player, "%s %s equipped", cosmetic.Icon, name)
	elseif action == "unequip" then
		cosmetics.Equipped[slot] = ""
		services.GameService:SendState(player)
		return true, T(player, "%s %s removed", cosmetic.Icon, name)
	end
	return false, T(player, "Invalid request")
end

function CosmeticService:Start()
	Net.Function("ItemShop").OnServerInvoke = onItemShop
end

return CosmeticService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="214">
        <Properties>
          <string name="Name">DVDService</string>
          <string name="Source"><![CDATA[--[[
	DVDService (ModuleScript)
	Emplacement : ServerScriptService > Services > DVDService

	Logos DVD rebondissants (un par niveau de l'amélioration "Logo DVD").
	Le SERVEUR choisit la trajectoire de chaque logo (position, vitesse, heure
	de départ) et l'envoie au client, qui ne fait que l'afficher. Comme les
	trajectoires sont déterministes (voir DVDMath), le serveur peut :
	  - compter lui-même les rebonds (gain passif à chaque rebond) ;
	  - vérifier si un coin a vraiment été touché : un tricheur ne peut pas
	    inventer de jackpot.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DVDMath = require(ReplicatedStorage.Shared.DVDMath)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Locale = require(ReplicatedStorage.Shared.Locale)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Net = require(ReplicatedStorage.Shared.Net)
local RateLimiter = require(script.Parent.RateLimiter)

local DVDService = {}

local services
local random = Random.new()

-- Taille par défaut d'un logo (fraction de l'écran), corrigée dès que le
-- client envoie la vraie taille (DVDResize)
local DEFAULT_W = Config.DVD.LogoSize.X / 1280
local DEFAULT_H = Config.DVD.LogoSize.Y / 720
-- Zone de déplacement "de référence" : les gains de rebond sont ramenés à
-- cette taille, quelle que soit la taille envoyée par le client
local DEFAULT_RX, DEFAULT_RY = 1 - DEFAULT_W, 1 - DEFAULT_H
-- Après un redimensionnement, aucun coin n'est accepté pendant ce délai
-- (sinon le client pourrait choisir une taille qui "fabrique" un coin)
local RESIZE_CORNER_LOCK = 10
-- Temps minimum entre deux jackpots d'un même joueur (sécurité anti-abus)
local JACKPOT_COOLDOWN = 45

--[[
	[Player] = {
		Logos = { { Params, ClaimedCorners = { [k] = true }, LastBX, LastBY, Frac } },
		W, H = taille commune des logos,
		Carry = rebonds pas encore comptés (avant un changement de trajectoire),
		LastClick = os.clock() du dernier clic récompensé (recharge commune),
		LastResize = os.clock() du dernier redimensionnement appliqué,
		LastJackpot = os.clock() du dernier jackpot payé,
	}
]]
local states = {}

function DVDService:Init(allServices)
	services = allServices
end

local function now(): number
	return workspace:GetServerTimeNow()
end

-- Nouvelle trajectoire aléatoire (angle entre 25° et 65° pour éviter les
-- trajectoires trop horizontales ou verticales)
local function randomParams(w: number, h: number): DVDMath.Params
	local angle = math.rad(random:NextNumber(25, 65))
	local variation = Config.DVD.SpeedVariation or 0
	local speed = Config.DVD.Speed * (1 + random:NextNumber(-variation, variation))
	local signX = random:NextNumber() < 0.5 and -1 or 1
	local signY = random:NextNumber() < 0.5 and -1 or 1
	return {
		X0 = random:NextNumber(0, math.max(0, 1 - w)),
		Y0 = random:NextNumber(0, math.max(0, 1 - h)),
		VX = math.cos(angle) * speed * signX,
		VY = math.sin(angle) * speed * signY,
		T0 = now(),
		W = w,
		H = h,
	}
end

-- (Re)définit la trajectoire d'un logo en repartant les compteurs de rebonds
local function setParams(logo, params: DVDMath.Params)
	logo.Params = params
	logo.ClaimedCorners = {} -- nouvelle trajectoire = nouveaux numéros de rebond
	logo.LastBX, logo.LastBY = DVDMath.BounceIndex(params, now())
end

local function newLogo(w: number, h: number)
	local logo = { Frac = 0 }
	setParams(logo, randomParams(w, h))
	return logo
end

-- Rebonds d'un logo depuis le dernier comptage (plafonnés).
-- Chaque rebond est pondéré par (zone réelle / zone de référence) : un logo
-- plus gros (zone plus petite) rebondit plus souvent mais chaque rebond vaut
-- moins, donc la taille envoyée par le client ne change pas les gains.
local function countBounces(logo, t: number): number
	local params = logo.Params
	local bx, by = DVDMath.BounceIndex(params, t)
	local rx, ry = DVDMath.Ranges(params)
	local weighted = math.abs(bx - logo.LastBX) * rx / DEFAULT_RX + math.abs(by - logo.LastBY) * ry / DEFAULT_RY
	logo.LastBX, logo.LastBY = bx, by
	if weighted ~= weighted or weighted == math.huge then
		return 0
	end
	-- On garde la partie décimale pour le prochain comptage
	logo.Frac = (logo.Frac or 0) + weighted
	local whole = math.floor(logo.Frac)
	logo.Frac -= whole
	return math.min(whole, Config.DVD.MaxBouncesPerTick)
end

-- Avant de changer une trajectoire : on met de côté les rebonds pas encore comptés
local function flushBounces(state)
	local t = now()
	for _, logo in ipairs(state.Logos) do
		state.Carry += countBounces(logo, t)
	end
	state.Carry = math.min(state.Carry, Config.DVD.MaxBouncesPerTick * math.max(1, #state.Logos))
end

-- Nombre de logos que le joueur doit avoir (niveau de "Logo DVD")
local function desiredCount(player: Player): number
	local data = services.DataService:GetData(player)
	if not data then
		return 0
	end
	return Formulas.ComputeStats(data).DVDCount
end

local function isValidIndex(state, index: any): boolean
	return type(index) == "number" and index == math.floor(index) and index >= 1 and index <= #state.Logos
end

----------------------------------------------------------------------
-- API
----------------------------------------------------------------------

function DVDService:SendSetup(player: Player)
	local state = states[player]
	if not state then
		return
	end
	local list = {}
	for _, logo in ipairs(state.Logos) do
		local p = logo.Params
		table.insert(list, { X0 = p.X0, Y0 = p.Y0, VX = p.VX, VY = p.VY, T0 = p.T0, W = p.W, H = p.H })
	end
	Net.Event("DVDSetup"):FireClient(player, { Logos = list })
end

-- Ajoute / retire des logos pour correspondre au niveau de l'amélioration.
-- Les logos existants gardent leur trajectoire. Renvoie true si ça a changé.
function DVDService:SyncLogos(player: Player): boolean
	local state = states[player]
	if not state then
		return false
	end
	local wanted = desiredCount(player)
	local logos = state.Logos
	if #logos == wanted then
		return false
	end
	flushBounces(state)
	while #logos < wanted do
		table.insert(logos, newLogo(state.W, state.H))
	end
	while #logos > wanted do
		table.remove(logos)
	end
	self:SendSetup(player)
	return true
end

-- Détox / reset : tous les logos disparaissent (puis on recrée ceux encore dus)
function DVDService:Reset(player: Player)
	local state = states[player]
	if not state then
		return
	end
	state.Logos = {}
	state.Carry = 0
	state.LastClick = 0
	if not self:SyncLogos(player) then
		self:SendSetup(player) -- toujours prévenir le client (liste vide)
	end
end

-- Appelé par le tick passif de GameService : nombre total de rebonds
-- (tous les logos, horizontaux + verticaux) depuis le dernier appel
function DVDService:CollectBounces(player: Player, t: number): number
	local state = states[player]
	if not state then
		return 0
	end
	local total = state.Carry
	state.Carry = 0
	for _, logo in ipairs(state.Logos) do
		total += countBounces(logo, t)
	end
	return total
end

function DVDService:PlayerReady(player: Player)
	states[player] = {
		Logos = {},
		W = DEFAULT_W,
		H = DEFAULT_H,
		Carry = 0,
		LastClick = 0,
		-- -math.huge (et pas 0) : os.clock() peut être petit juste après le démarrage du serveur
		LastResize = -math.huge,
		LastJackpot = -math.huge,
		PendingResize = nil, -- taille reçue trop tôt, appliquée plus tard
		ResizeScheduled = false,
	}
	-- Crée les logos déjà achetés (le client recevra DVDSetup avec la synchro complète)
	local wanted = desiredCount(player)
	for _ = 1, wanted do
		table.insert(states[player].Logos, newLogo(DEFAULT_W, DEFAULT_H))
	end
end

function DVDService:PlayerRemoving(player: Player)
	states[player] = nil
end

----------------------------------------------------------------------
-- Remotes
----------------------------------------------------------------------

-- Applique une nouvelle taille à tous les logos en gardant la position et
-- la direction actuelles de chacun (pour qu'aucun logo ne "saute")
local function applyResize(player: Player, state, w: number, h: number)
	if math.abs(w - state.W) < 1e-4 and math.abs(h - state.H) < 1e-4 then
		return -- rien ne change
	end
	flushBounces(state)
	state.W, state.H = w, h
	state.LastResize = os.clock()
	local t = now()
	for _, logo in ipairs(state.Logos) do
		local params = logo.Params
		local x, y = DVDMath.Position(params, t)
		local dirX, dirY = DVDMath.Directions(params, t)
		-- Borné juste AVANT le bord : un logo collé au bord ne compte pas un
		-- faux rebond et ne se retrouve pas pile sur un "coin"
		setParams(logo, {
			X0 = math.clamp(x, 0, math.max(0, 1 - w - 1e-6)),
			Y0 = math.clamp(y, 0, math.max(0, 1 - h - 1e-6)),
			VX = math.abs(params.VX) * dirX,
			VY = math.abs(params.VY) * dirY,
			T0 = t,
			W = w,
			H = h,
		})
	end
	DVDService:SendSetup(player)
end

-- Le client indique la taille d'un logo à l'écran (en fraction de l'écran).
-- Trop rapproché (< 0.5 s) : la dernière taille reçue est appliquée un peu plus tard.
local function onResize(player: Player, w: any, h: any)
	local state = states[player]
	if not state then
		return
	end
	if type(w) ~= "number" or type(h) ~= "number" or w ~= w or h ~= h then
		return
	end
	w = math.clamp(w, 0.03, 0.5)
	h = math.clamp(h, 0.03, 0.5)

	if RateLimiter.Check(player, "DVDResize", 0.5) then
		state.PendingResize = nil
		applyResize(player, state, w, h)
		return
	end
	state.PendingResize = { W = w, H = h }
	if state.ResizeScheduled then
		return
	end
	state.ResizeScheduled = true
	task.delay(0.55, function()
		state.ResizeScheduled = false
		local pending = state.PendingResize
		state.PendingResize = nil
		-- Le joueur a pu partir (ou tout a été réinitialisé) entre-temps
		if pending and states[player] == state then
			applyResize(player, state, pending.W, pending.H)
		end
	end)
end

-- Clic sur un logo : petit bonus, avec un temps de recharge commun à tous les logos
local function onClick(player: Player, index: any)
	local state = states[player]
	local data = services.DataService:GetData(player)
	if not state or not data or not isValidIndex(state, index) then
		return
	end
	local clock = os.clock()
	-- 0.3 s de tolérance pour la latence
	if clock - state.LastClick < Config.DVD.ClickCooldown - 0.3 then
		return
	end
	state.LastClick = clock

	local reward = Formulas.ScaledReward(
		services.GameService:GetStats(player),
		Config.DVD.ClickRewardSeconds,
		Config.DVD.ClickMinReward
	)
	data.Stats.DVDClicks += 1
	services.GameService:AddDopamine(player, reward, true)
	services.GameService:Notify(player, {
		Type = "Bonus",
		Source = "DVD",
		Amount = reward,
		Index = index,
	})
end

-- Le client signale un coin du logo `index` au rebond horizontal numéro k : on VÉRIFIE
local function onCorner(player: Player, index: any, k: any)
	local state = states[player]
	local data = services.DataService:GetData(player)
	if not state or not data or not isValidIndex(state, index) then
		return
	end
	if type(k) ~= "number" or k ~= math.floor(k) or math.abs(k) > 1e9 then
		return
	end
	if not RateLimiter.Check(player, "DVDCorner" .. index, 0.3) then
		return
	end
	local clock = os.clock()
	-- Trajectoire tout juste imposée par un redimensionnement, ou jackpot trop récent : refusé
	if clock - state.LastResize < RESIZE_CORNER_LOCK or clock - state.LastJackpot < JACKPOT_COOLDOWN then
		return
	end
	local logo = state.Logos[index]
	if logo.ClaimedCorners[k] then
		return -- déjà récompensé
	end

	local params = logo.Params
	local bounceTime = DVDMath.BounceTimeX(params, k)
	local t = now()
	-- Le rebond doit avoir eu lieu récemment (et nettement après le début de la
	-- trajectoire : un "rebond" pile au départ n'est qu'un logo posé contre le bord)
	if bounceTime ~= bounceTime or bounceTime < params.T0 + 0.25 or bounceTime > t + 0.5 or bounceTime < t - 5 then
		return
	end
	if not DVDMath.IsCornerAtBounceX(params, k, Config.DVD.CornerTolerance) then
		return -- pas un vrai coin : tentative de triche ou erreur d'arrondi
	end

	logo.ClaimedCorners[k] = true
	state.LastJackpot = clock
	local reward = Formulas.ScaledReward(
		services.GameService:GetStats(player),
		Config.DVD.JackpotRewardSeconds,
		Config.DVD.JackpotMinReward
	)
	data.Stats.DVDCorners += 1
	services.GameService:AddDopamine(player, reward, true)
	services.GameService:Notify(player, {
		Type = "Jackpot",
		Amount = reward,
		Index = index,
		Text = services.GameService:T(player, "📀 PERFECT CORNER! +%s", NumberFormatter.Format(reward)),
	})
	local displayName = player.DisplayName
	services.GameService:NotifyAll(function(lang)
		return {
			Type = "Info",
			Text = Locale.TFor(lang, "📀 %s hit the PERFECT CORNER!", displayName),
		}
	end, player)
end

-- TEST (Studio) : place le 1er logo pour qu'il touche un coin dans ~2 secondes
function DVDService:DebugCorner(player: Player): boolean
	local state = states[player]
	if not state or #state.Logos == 0 then
		return false
	end
	flushBounces(state)
	-- Test : on lève les sécurités anti-abus des jackpots
	state.LastResize, state.LastJackpot = -math.huge, -math.huge
	local logo = state.Logos[1]
	local params = logo.Params
	local rangeX, rangeY = DVDMath.Ranges(params)
	local speedX, speedY = math.abs(params.VX), math.abs(params.VY)
	local delay = math.min(2, rangeX * 0.9 / speedX, rangeY * 0.9 / speedY)
	setParams(logo, {
		X0 = rangeX - speedX * delay,
		Y0 = rangeY - speedY * delay,
		VX = speedX,
		VY = speedY,
		T0 = now(),
		W = params.W,
		H = params.H,
	})
	self:SendSetup(player)
	return true
end

function DVDService:Start()
	Net.Event("DVDResize").OnServerEvent:Connect(onResize)
	Net.Event("DVDClick").OnServerEvent:Connect(onClick)
	Net.Event("DVDCorner").OnServerEvent:Connect(onCorner)
end

return DVDService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="215">
        <Properties>
          <string name="Name">DailyRewardService</string>
          <string name="Source"><![CDATA[--[[
	DailyRewardService (ModuleScript)
	Emplacement : ServerScriptService > Services > DailyRewardService

	Récompense quotidienne : 1 fois par jour (jour UTC). Revenir le jour
	suivant augmente la série (streak) et donc la récompense.
	L'heure utilisée est celle du SERVEUR (impossible à tricher en changeant
	l'heure de son PC). Nécessite la Feature "Daily" (amélioration "Calendrier").
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Net = require(ReplicatedStorage.Shared.Net)
local RateLimiter = require(script.Parent.RateLimiter)

local DailyRewardService = {}

local services
local SECONDS_PER_DAY = 86400

function DailyRewardService:Init(allServices)
	services = allServices
end

local function today(): number
	return math.floor(os.time() / SECONDS_PER_DAY)
end

-- Série qu'aurait le joueur s'il réclamait maintenant
local function nextStreak(data): number
	if data.Daily.LastDay == today() - 1 then
		return data.Daily.Streak + 1
	end
	return 1
end

local function computeReward(stats, streak: number): number
	local bonusDays = math.min(streak, Config.Daily.MaxStreakBonus) - 1
	local seconds = Config.Daily.BaseRewardSeconds + bonusDays * Config.Daily.StreakBonusSeconds
	return Formulas.ScaledReward(stats, seconds, Config.Daily.MinReward * math.min(streak, Config.Daily.MaxStreakBonus))
end

-- Infos affichées par le client
function DailyRewardService:GetInfo(player: Player, stats)
	local data = services.DataService:GetData(player)
	local available = data.Daily.LastDay < today()
	local streak = available and nextStreak(data) or data.Daily.Streak
	return {
		Available = available,
		Streak = streak,
		Reward = computeReward(stats, streak),
		-- secondes avant le prochain jour UTC
		NextIn = (today() + 1) * SECONDS_PER_DAY - os.time(),
	}
end

-- Texte dans la langue du joueur
local function T(player: Player, text: string, ...): string
	return services.GameService:T(player, text, ...)
end

local function onClaim(player: Player)
	if not RateLimiter.Check(player, "Daily", 1) then
		return false, T(player, "Slow down!")
	end
	local data = services.DataService:GetData(player)
	if not data or not services.GameService:IsReady(player) then
		return false, T(player, "Loading...")
	end
	if not Formulas.HasFeature(data, "Daily") then
		return false, T(player, "The calendar isn't unlocked yet")
	end
	if data.Daily.LastDay >= today() then
		return false, T(player, "Already claimed today, come back tomorrow!")
	end

	local streak = nextStreak(data)
	local reward = computeReward(services.GameService:GetStats(player), streak)

	data.Daily.LastDay = today()
	data.Daily.Streak = streak
	data.Stats.DailyClaims += 1
	services.GameService:AddDopamine(player, reward, false)
	services.GameService:SendState(player)

	return true, T(player, "Day %d: +%s %s!", streak, NumberFormatter.Format(reward), Config.Game.CurrencyName)
end

function DailyRewardService:Start()
	Net.Function("ClaimDaily").OnServerInvoke = onClaim
end

return DailyRewardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="216">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--[[
	DataService (ModuleScript)
	Emplacement : ServerScriptService > Services > DataService

	Chargement / sauvegarde des données des joueurs avec DataStoreService
	(format "version 2", magasin Config.DataStore.Name) :
	  - pcall + plusieurs tentatives (retry) avec attente croissante ;
	  - sauvegarde à la sortie du joueur, toutes les 60 secondes (au plus),
	    après certaines actions importantes (détox, achat Robux) et à la
	    fermeture du serveur (BindToClose) ;
	  - data.LastOnline (os.time) est mis à jour à chaque sauvegarde : au
	    chargement, l'absence (en secondes) sert au gain hors-ligne
	    (GameService, voir TakeOfflineSeconds) ;
	  - si le chargement échoue, on NE sauvegarde PAS (pour ne jamais écraser
	    une vraie sauvegarde avec des données vides).
]]

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local FriendMailRules = require(ReplicatedStorage.Shared.FriendMailRules)
local Locale = require(ReplicatedStorage.Shared.Locale)

local DataService = {}

-- Profils chargés : [Player] = { Data = table, CanSave = bool, Saving = bool, Releasing = bool,
--   OfflineSeconds = secondes d'absence depuis la dernière sauvegarde (0 = rien à donner) }
local profiles = {}

-- Données d'un nouveau joueur (version 2). Toute nouvelle clé ajoutée ici
-- sera automatiquement ajoutée aux anciennes sauvegardes (voir reconcile).
local TEMPLATE = {
	Version = 2,
	Dopamine = 0,
	Rebirths = 0,
	Upgrades = {}, -- [upgradeId] = niveau
	Achievements = {}, -- [achievementId] = true
	Quests = {}, -- liste des quêtes actives
	Daily = { LastDay = 0, Streak = 0 },
	-- ClickSound = Id de Config.ClickSounds ; Language = "Auto" | "en" | "fr"
	-- ("Auto" = langue de Roblox du joueur) ; DarkMode = mode sombre de l'interface ;
	-- MusicTrack = "Shuffle" (aléatoire) ou Key d'une musique de Config.Music.Playlist
	Settings = { Sound = true, Music = true, Effects = true, ClickSound = "Default", Language = "Auto", DarkMode = false,
		MusicTrack = "Shuffle" },
	Cosmetics = {
		Owned = {}, -- [cosmeticId] = true
		Equipped = { Hat = "", Skin = "" }, -- "" = rien d'équipé
	},
	Stock = { Shares = 0, CostBasis = 0 }, -- ancienne bourse (remboursée puis vidée)
	Casino = { Tokens = -1, Progress = 0 }, -- 🎰 jetons de tours gratuits (-1 = jamais initialisé)
	Garden = {}, -- 🌻 parterres du jardin (voir GardenService)
	Tickets = 0, -- 🎟️ tickets d'arcade (gagnés en jouant ou achetés en Robux ; boutique à tickets, jamais misés)
	Trophies = 0, -- 🏆 trophées d'arcade (gagnés UNIQUEMENT en jouant, jamais achetables ni convertibles : mises des duels)
	Arcade = {}, -- 🕹️ mini-jeux (records, limites du jour : voir MinigameService)
	Chests = { Stored = 0, Progress = 0 }, -- coffres mystère
	ScreenTime = {}, -- ["numéro du jour UTC"] = secondes jouées ce jour-là
	Themes = {
		Owned = { Classic = true }, -- [themeId] = true (achetés, gardés pour toujours)
		Equipped = "Classic",
	},
	Boost = { Multiplier = 1, EndsAt = 0 }, -- boost acheté (EndsAt = os.time() de fin)
	-- 🏠 Maison (Config.House), gardée pour toujours (même après l'océan).
	-- Items = { [itemId] = nombre possédé } ; Rooms = pièces (voir HouseService :
	-- vide ici, HouseService crée le salon de départ ou convertit l'ancienne
	-- maison à une pièce)
	House = {
		Size = Config.House.Sizes[1].Id,
		OwnedSizes = { [Config.House.Sizes[1].Id] = true },
		OwnedWallpapers = { [Config.House.Wallpapers[1].Id] = true },
		OwnedFloors = { [Config.House.Floors[1].Id] = true },
		Items = {},
		Rooms = {},
		NextRoom = 2,
	},
	Purchases = {}, -- PurchaseId (texte) des 50 derniers achats Robux traités (anti-doublon)
	LastOnline = 0, -- os.time() de la dernière sauvegarde / sortie (0 = jamais)
	LiveFollowed = false, -- abonné au live ASMR pendant cette partie (remis à false à la détox)
	-- 💌 Mails entre amis Roblox (FriendMailService) : dernier envoi d'un
	-- nouveau mail / d'une réponse (os.time(), anti-spam gardé d'une partie à
	-- l'autre) et expéditeurs bloqués { ["UserId"] = true }
	FriendMail = { LastNew = 0, LastReply = 0, Blocked = {} },
	Stats = {
		TotalClicks = 0,
		LifetimeDopamine = 0, -- Dopamine gagnée depuis toujours (classement)
		UpgradesBought = 0,
		CombosMaxed = 0,
		DVDClicks = 0,
		DVDCorners = 0,
		Bounces = 0,
		GoldenClicks = 0,
		LightningClicks = 0,
		NotifsOpened = 0,
		EmailsRead = 0,
		BubblesPopped = 0,
		Spins = 0,
		HeadlinesClicked = 0,
		PressCrushes = 0,
		SlotSpins = 0,
		SlotWins = 0,
		StockTrades = 0,
		GardenHarvests = 0,
		MinigamesPlayed = 0,
		MinigamesWon = 0,
		DuelsWon = 0,
		ChestsOpened = 0,
		CosmeticsBought = 0,
		QuestsCompleted = 0,
		DailyClaims = 0,
		PlaySeconds = 0,
		RobuxPurchases = 0,
		ThemesBought = 0,
		Donations = 0, -- dons du live cliqués
		Follows = 0, -- abonnements au live
		ButterCrunches = 0, -- croquées de beurre
		OfflineEarned = 0, -- Dopamine gagnée hors-ligne
		HouseItemsBought = 0, -- objets de maison achetés
		HouseComfort = 0, -- meilleur confort de maison atteint
	},
}

local services -- rempli par Init

local dataStore: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStore.Name)
	end)
	if ok then
		dataStore = result
	else
		warn("[DataService] DataStore indisponible (place non publiée ?) :", result)
	end
end

----------------------------------------------------------------------
-- Utilitaires
----------------------------------------------------------------------

local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for key, inner in pairs(value) do
		copy[key] = deepCopy(inner)
	end
	return copy
end

-- Ajoute les clés manquantes (nouvelle version du jeu) sans toucher aux
-- existantes. Une valeur du mauvais type (sauvegarde corrompue) est remplacée.
local function reconcile(data, template)
	for key, value in pairs(template) do
		local current = data[key]
		if current == nil or type(current) ~= type(value) or (type(value) == "number" and current ~= current) then
			data[key] = deepCopy(value)
		elseif type(value) == "table" and next(value) ~= nil then
			reconcile(current, value)
		end
	end
	return data
end

-- Erreurs pour lesquelles réessayer ne sert à rien (ex. Studio sans accès aux API)
local function isFatalError(message: string): boolean
	return string.find(message, "StudioAccessToApisNotAllowed", 1, true) ~= nil
		or string.find(message, "publish", 1, true) ~= nil
		or string.find(message, "403", 1, true) ~= nil
end

-- Exécute `callback` avec pcall et réessaie en cas d'échec
local function retry(description: string, callback: () -> any): (boolean, any)
	local lastError
	for attempt = 1, Config.DataStore.MaxRetries do
		local ok, result = pcall(callback)
		if ok then
			return true, result
		end
		lastError = result
		warn(string.format("[DataService] %s : échec (tentative %d) : %s", description, attempt, tostring(result)))
		if isFatalError(tostring(result)) then
			warn("[DataService] Active 'Enable Studio Access to API Services' (Game Settings > Security) et publie le jeu.")
			break
		end
		if attempt < Config.DataStore.MaxRetries then
			task.wait(2 ^ attempt) -- 2s, 4s, 8s...
		end
	end
	return false, lastError
end

-- Plafond de l'absence prise en compte (sécurité contre une date abîmée) : 1 an
local MAX_OFFLINE_SECONDS = 365 * 86400
-- Sauvegarde automatique : au plus toutes les 60 secondes
local AUTOSAVE_INTERVAL = math.min(Config.DataStore.AutoSaveInterval, 60)

local function isValidNumber(value): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

-- Secondes écoulées depuis `lastOnline` (0 si jamais connecté ou date invalide)
local function offlineSecondsSince(lastOnline): number
	if not isValidNumber(lastOnline) or lastOnline <= 0 then
		return 0
	end
	return math.clamp(os.time() - lastOnline, 0, MAX_OFFLINE_SECONDS)
end

local function keyFor(player: Player): string
	return "Player_" .. player.UserId
end

----------------------------------------------------------------------
-- API
----------------------------------------------------------------------

function DataService:Init(allServices)
	services = allServices
end

-- Charge les données d'un joueur (bloquant). Renvoie la table de données.
function DataService:LoadAsync(player: Player)
	local canSave = dataStore ~= nil
	local data

	if dataStore then
		local store = dataStore :: DataStore
		local ok, result = retry("Chargement de " .. player.Name, function()
			return store:GetAsync(keyFor(player))
		end)
		if ok then
			data = (type(result) == "table") and result or nil
		else
			-- Échec total : on joue avec des données vides mais sans sauvegarder
			canSave = false
		end
	end

	data = reconcile(data or deepCopy(TEMPLATE), TEMPLATE)
	data.Version = TEMPLATE.Version
	-- 🏆 Trophées : entier >= 0 (sauvegarde abîmée corrigée)
	if not isValidNumber(data.Trophies) or data.Trophies < 0 then
		data.Trophies = 0
	end
	data.Trophies = math.floor(data.Trophies)
	-- 💌 Mails entre amis : horodatages valides (jamais dans le futur), blocages propres
	data.FriendMail = FriendMailRules.SanitizeData(data.FriendMail, os.time())

	-- Absence depuis la dernière sauvegarde (gain hors-ligne donné par
	-- GameService quand le client est prêt), puis on repart de maintenant
	local offlineSeconds = offlineSecondsSince(data.LastOnline)
	data.LastOnline = os.time()

	-- Le joueur a pu partir pendant le chargement
	if not player.Parent then
		return nil
	end

	profiles[player] = {
		Data = data,
		CanSave = canSave,
		Saving = false,
		Releasing = false,
		OfflineSeconds = offlineSeconds,
	}

	if not canSave then
		local language = Locale.ForPlayer(player, data.Settings.Language)
		task.defer(function()
			services.GameService:Notify(player, {
				Type = "Error",
				Text = Locale.TFor(language, "⚠️ Saving is unavailable: your progress won't be saved."),
			})
		end)
	end

	return data
end

function DataService:GetData(player: Player)
	local profile = profiles[player]
	return profile and profile.Data
end

-- Renvoie (une seule fois) les secondes d'absence calculées au chargement
function DataService:TakeOfflineSeconds(player: Player): number
	local profile = profiles[player]
	if not profile then
		return 0
	end
	local seconds = profile.OfflineSeconds or 0
	profile.OfflineSeconds = 0
	return seconds
end

function DataService:GetLoadedPlayers(): { Player }
	local list = {}
	for player in pairs(profiles) do
		table.insert(list, player)
	end
	return list
end

-- Remet les données d'un joueur à zéro (commande de test /reset), SAUF les
-- réglages et la liste des achats Robux traités (anti-doublon). La table est vidée "sur place" : les autres services qui ont
-- gardé une référence vers elle restent valides.
function DataService:ResetData(player: Player): boolean
	local profile = profiles[player]
	if not profile then
		return false
	end
	local data = profile.Data
	local settings = deepCopy(data.Settings)
	local purchases = deepCopy(data.Purchases)
	for key in pairs(data) do
		data[key] = nil
	end
	for key, value in pairs(TEMPLATE) do
		data[key] = deepCopy(value)
	end
	if type(settings) == "table" then
		data.Settings = reconcile(settings, TEMPLATE.Settings)
	end
	if type(purchases) == "table" then
		data.Purchases = purchases
	end
	data.LastOnline = os.time()
	profile.OfflineSeconds = 0
	return true
end

-- true si les données de ce joueur peuvent être sauvegardées
-- (DataStore disponible et chargement réussi)
function DataService:CanSave(player: Player): boolean
	local profile = profiles[player]
	return profile ~= nil and profile.CanSave and dataStore ~= nil
end

-- Sauvegarde les données d'un joueur (bloquant).
-- `waitIfBusy` = true : si une sauvegarde est déjà en cours, on attend qu'elle
-- finisse puis on sauvegarde à nouveau (utilisé après un achat Robux : la
-- sauvegarde en cours ne contient peut-être pas l'achat).
function DataService:SaveAsync(player: Player, waitIfBusy: boolean?): boolean
	local profile = profiles[player]
	if not profile or not profile.CanSave or not dataStore then
		return false
	end
	if profile.Saving and waitIfBusy then
		local waited = 0
		while profile.Saving and waited < 30 do
			waited += task.wait(0.1)
		end
	end
	if profile.Saving then
		return false -- une sauvegarde est déjà en cours
	end

	profile.Saving = true
	local data = profile.Data
	data.LastOnline = os.time() -- dernière présence connue (gain hors-ligne)
	local store = dataStore :: DataStore
	local ok = retry("Sauvegarde de " .. player.Name, function()
		store:UpdateAsync(keyFor(player), function()
			return data
		end)
	end)
	profile.Saving = false
	return ok
end

-- Sauvegarde puis oublie le joueur (à la sortie)
function DataService:ReleaseAsync(player: Player)
	local profile = profiles[player]
	if not profile then
		return
	end
	-- Déjà en cours de libération (PlayerRemoving puis BindToClose) : rien à refaire
	if profile.Releasing then
		return
	end
	profile.Releasing = true
	-- Si une sauvegarde automatique est en cours, on attend qu'elle finisse
	local waited = 0
	while profile.Saving and waited < 10 do
		waited += task.wait(0.1)
	end
	self:SaveAsync(player)
	profiles[player] = nil
end

function DataService:Start()
	-- Sauvegarde périodique
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for player in pairs(profiles) do
				task.spawn(function()
					self:SaveAsync(player)
				end)
			end
		end
	end)

	-- Fermeture du serveur : on sauvegarde tout le monde en parallèle
	game:BindToClose(function()
		-- On libère TOUS les profils chargés, y compris ceux des joueurs déjà
		-- sortis de la liste Players (leur sauvegarde de sortie peut être en cours)
		for player, profile in pairs(profiles) do
			if not profile.Releasing then
				task.spawn(function()
					self:ReleaseAsync(player)
				end)
			end
		end
		-- On attend aussi les sauvegardes lancées par PlayerRemoving :
		-- ReleaseAsync retire le profil de la table quand il a fini
		local start = os.clock()
		while next(profiles) ~= nil and os.clock() - start < 25 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="217">
        <Properties>
          <string name="Name">DebugService</string>
          <string name="Source"><![CDATA[--[[
	DebugService (ModuleScript)
	Emplacement : ServerScriptService > Services > DebugService

	Commandes de TEST, actives UNIQUEMENT dans Roblox Studio (jamais dans le
	jeu publié). Trois façons de les lancer, qui passent toutes par le MÊME
	exécuteur (runCommand) :
	  - le chat (TextChatCommand côté serveur + Player.Chatted pour l'ancien chat) ;
	  - la RemoteFunction DebugCommand (commande, argument) -> (succès, message),
	    utilisée par le panneau "🛠️ Test" et les commandes de chat du client.
	    Hors Studio, elle répond toujours (false, message) sans rien faire.
	Commandes :
	  /give 1e6         -> donne de la Dopamine (ici 1 million)
	  /rush             -> lance un Dopamine Rush
	  /daily            -> rend la récompense quotidienne à nouveau disponible
	  /save             -> force une sauvegarde
	  /corner           -> le 1er logo DVD touchera un coin dans ~2 secondes
	  /unlockall        -> toutes les améliorations au max (sauf l'océan)
	  /spawn golden     -> fait apparaître un objet (golden, lightning, notif, email, donation)
	  /golden           -> raccourci de /spawn golden
	  /detox            -> va à l'océan gratuitement
	  /chest 3          -> ajoute des coffres mystère
	  /reset            -> remet toutes les données à zéro (sauf les réglages)
	  /pass vip         -> active / désactive un Game Pass pour tester (x10, x2, autoclick, vip)
	  /boost 5 60       -> boost x5 pendant 60 secondes
	  /theme kawaii     -> donne et équipe un thème
	  /offline 7200     -> simule un retour après 7200 s d'absence (gain hors-ligne)
	  /lang fr          -> langue du jeu : auto, en ou fr (appliquée au prochain lancement)
	  /house            -> 🏠 toutes les tailles, papiers peints, sols et 1 exemplaire de chaque objet
	  /help             -> liste des commandes
	Les messages sont écrits en anglais puis traduits dans la langue du
	joueur (Locale.TFor, traductions dans Shared > Lang > FR_Server).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")

local Config = require(ReplicatedStorage.Shared.Config)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Net = require(ReplicatedStorage.Shared.Net)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)

local DebugService = {}

local services

local IS_STUDIO = RunService:IsStudio()
local MAX_OFFLINE_SECONDS = 30 * 86400 -- /offline : 30 jours au maximum
-- Même commande reçue par deux chemins différents (chat serveur + RF du
-- client) en moins de DUPLICATE_WINDOW secondes : exécutée une seule fois
local DUPLICATE_WINDOW = 1

-- "golden" -> "Golden" (le chat est mis en minuscules)
local spawnKinds = {}
for kind in pairs(Config.Spawners) do
	spawnKinds[string.lower(kind)] = kind
end

-- "vip" -> "VIP", "kawaii" -> "Kawaii" (le chat est mis en minuscules)
local passIds = {}
for _, pass in ipairs(Config.Monetization.GamePasses) do
	passIds[string.lower(pass.Id)] = pass.Id
end
local themeIds = {}
for _, theme in ipairs(Config.Themes) do
	themeIds[string.lower(theme.Id)] = theme.Id
end

local function listIds(map): string
	local list = {}
	for lower in pairs(map) do
		table.insert(list, lower)
	end
	table.sort(list)
	return table.concat(list, ", ")
end

-- Noms des commandes (déclarées comme TextChatCommand dans Studio)
local COMMAND_NAMES = {
	"give", "rush", "daily", "save", "corner", "unlockall", "spawn", "golden", "detox", "chest", "reset",
	"pass", "boost", "theme", "offline", "lang", "house", "help", "aide",
}

-- Aide : "%s" = types d'objets de /spawn
local HELP = "/give /rush /daily /save /corner /unlockall /spawn <%s> /detox /chest /reset"
	.. " /pass <id> /boost <mult> <seconds> /theme <id> /offline <seconds> /lang <auto|en|fr>"

-- /lang : argument (minuscules) -> valeur de Settings.Language
local LANGUAGE_ARGS = { auto = "Auto", en = "en", fr = "fr" }

function DebugService:Init(allServices)
	services = allServices
end

-- Texte dans la langue du joueur
local function T(player: Player, text: string, ...): string
	return services.GameService:T(player, text, ...)
end

local function helpText(player: Player): string
	return T(player, HELP, listIds(spawnKinds))
end

local function info(player: Player, text: string)
	services.GameService:Notify(player, { Type = "Info", Text = "🛠️ " .. text })
end

----------------------------------------------------------------------
-- Exécuteur commun : renvoie (succès, message)
----------------------------------------------------------------------

local function runCommand(player: Player, command: string, argument: string, second: string): (boolean, string)
	local gameService = services.GameService
	local data = services.DataService:GetData(player)
	if not data or not gameService:IsReady(player) then
		return false, T(player, "Loading...")
	end

	if command == "give" then
		local amount = tonumber(argument) or 1e6
		if amount ~= amount or amount <= 0 or amount == math.huge then
			return false, T(player, "Invalid amount")
		end
		gameService:AddDopamine(player, amount, false)
		return true, "+" .. NumberFormatter.Format(amount) .. " " .. Config.Game.CurrencyName
	elseif command == "rush" then
		if services.EventService:StartRush() then
			return true, T(player, "Dopamine Rush started!")
		end
		return false, T(player, "A Rush is already running")
	elseif command == "daily" then
		data.Daily.LastDay = 0
		gameService:MarkDirty(player)
		return true, T(player, "Daily gift available")
	elseif command == "save" then
		local ok = services.DataService:SaveAsync(player, true)
		return ok, ok and T(player, "💾 Saved!") or T(player, "💾 Couldn't save (see the Output)")
	elseif command == "corner" then
		if services.DVDService:DebugCorner(player) then
			return true, T(player, "Corner in ~2 seconds...")
		end
		return false, T(player, "You need at least one DVD logo")
	elseif command == "unlockall" then
		for _, upgrade in ipairs(Config.Upgrades) do
			if upgrade.Effect ~= "Detox" then
				local level = data.Upgrades[upgrade.Id] or 0
				data.Upgrades[upgrade.Id] = upgrade.MaxLevel or math.max(level, 1)
			end
		end
		services.QuestService:Regenerate(player)
		gameService:RefreshAfterUpgradeChange(player)
		return true, T(player, "Everything unlocked!")
	elseif command == "spawn" or command == "golden" then
		local kind = (command == "golden") and "Golden" or spawnKinds[argument]
		if not kind then
			return false, T(player, "Unknown type: %s", listIds(spawnKinds))
		end
		if not services.EventService:Spawn(player, kind) then
			return false, T(player, "Too many %s objects on screen", kind)
		end
		return true, T(player, "%s object sent", kind)
	elseif command == "detox" then
		gameService:Detox(player)
		return true, T(player, "🌊 Free detox")
	elseif command == "chest" then
		local count = math.floor(tonumber(argument) or 1)
		if count ~= count or count < 1 or count == math.huge then
			count = 1
		end
		services.LootService:AddChests(player, count)
		return true, T(player, "Chests added")
	elseif command == "reset" then
		services.DataService:ResetData(player)
		gameService:ResetCombo(player)
		services.EventService:ClearSpawns(player)
		services.DVDService:Reset(player)
		services.QuestService:PlayerReady(player, data)
		gameService:SendFullSync(player)
		return true, T(player, "Data reset")
	elseif command == "pass" then
		local passId = passIds[argument]
		if not passId then
			return false, T(player, "Unknown pass: %s", listIds(passIds))
		end
		local owned = services.MonetizationService:DebugTogglePass(player, passId)
		if owned == nil then
			return false, T(player, "Couldn't toggle this pass")
		end
		gameService:SendState(player)
		return true, owned and T(player, "Pass %s enabled", passId) or T(player, "Pass %s disabled", passId)
	elseif command == "boost" then
		local multiplier = tonumber(argument) or 2
		local seconds = tonumber(second) or 60
		if multiplier ~= multiplier or multiplier < 1 or multiplier > 1000
			or seconds ~= seconds or seconds < 0 or seconds > 7 * 86400 then
			return false, T(player, "Usage: /boost <mult 1-1000> <seconds>")
		end
		data.Boost = { Multiplier = multiplier, EndsAt = os.time() + math.floor(seconds) }
		gameService:SendState(player)
		return true, T(player, "Boost x%s for %d s", tostring(multiplier), math.floor(seconds))
	elseif command == "theme" then
		local themeId = themeIds[argument]
		if not themeId or not services.ThemeService:DebugGrant(player, themeId) then
			return false, T(player, "Unknown theme: %s", listIds(themeIds))
		end
		gameService:SendState(player)
		return true, T(player, "Theme %s given and equipped", themeId)
	elseif command == "offline" then
		local seconds = tonumber(argument) or 7200
		if seconds ~= seconds or seconds <= 0 or seconds > MAX_OFFLINE_SECONDS then
			return false, T(player, "Usage: /offline <seconds 1-%s>", tostring(MAX_OFFLINE_SECONDS))
		end
		local amount = gameService:GrantOffline(player, math.floor(seconds), true)
		if amount <= 0 then
			return false, T(player, "Nothing earned (no production or away < %s s)", tostring(Config.Offline.MinSeconds))
		end
		return true, T(player, "Offline simulated: +%s %s", NumberFormatter.Format(amount), Config.Game.CurrencyName)
	elseif command == "lang" then
		local language = LANGUAGE_ARGS[argument]
		if not language then
			return false, T(player, "Usage: /lang <auto|en|fr>")
		end
		data.Settings.Language = language
		gameService:MarkDirty(player)
		-- Message dans la NOUVELLE langue (celle du prochain lancement)
		return true, Locale.TFor(Locale.ForPlayer(player, language),
			"🌐 Language: %s (takes effect after rejoining)", language)
	elseif command == "house" then
		if not services.HouseService:DebugGrantAll(player) then
			return false, T(player, "Loading...")
		end
		return true, T(player, "🏠 Everything in the house shop unlocked!")
	elseif command == "help" or command == "aide" then
		return true, helpText(player)
	end
	return false, T(player, "Unknown command. %s", helpText(player))
end

----------------------------------------------------------------------
-- Entrée commune (chat et RemoteFunction)
----------------------------------------------------------------------

-- Dernière commande exécutée par joueur (anti-doublon entre les chemins)
local lastRun: { [Player]: { Line: string, Clock: number, Source: string } } = {}

-- Découpe "/give 1e6" ou "boost 5 60" en (commande, argument, second)
local function parse(line: string): (string?, string, string)
	local command, argument, second = string.match(string.lower(line), "^%s*/?(%a+)%s*(%S*)%s*(%S*)")
	return command, argument or "", second or ""
end

-- `source` = "chat" ou "remote". Doublon ignoré si la même ligne arrive dans
-- la seconde par un autre chemin (ou deux fois par le chat) ; deux clics
-- rapides sur le même bouton du panneau de test restent exécutés.
-- 3e valeur renvoyée : true si c'était un doublon (rien n'a été exécuté).
local function execute(player: Player, line: string, source: string): (boolean, string, boolean)
	local command, argument, second = parse(line)
	if not command then
		return false, T(player, "Invalid command"), false
	end
	local normalized = command .. " " .. argument .. " " .. second
	local clock = os.clock()
	local last = lastRun[player]
	if last and last.Line == normalized and clock - last.Clock < DUPLICATE_WINDOW
		and (last.Source ~= source or source == "chat") then
		return true, T(player, "(already run)"), true
	end
	lastRun[player] = { Line = normalized, Clock = clock, Source = source }

	local ok, success, message = pcall(runCommand, player, command, argument, second)
	if not ok then
		warn("[DebugService] Erreur de la commande /" .. command .. " :", success)
		return false, T(player, "Error: %s", tostring(success)), false
	end
	return success, message, false
end

-- Message de chat : exécuté s'il ressemble à une commande "/xxx", résultat en notification
local function handleChat(player: Player, message: string)
	if not string.match(message, "^%s*/%a") then
		return
	end
	local ok, text, duplicate = execute(player, message, "chat")
	if not duplicate then
		info(player, (ok and "" or "❌ ") .. text)
	end
end

-- RemoteFunction DebugCommand (command: string, arg: string?) -> (ok, message)
local function onDebugCommand(player: Player, command: any, argument: any): (boolean, string)
	if not IS_STUDIO then
		return false, T(player, "Test commands are only available in Studio")
	end
	if type(command) ~= "string" or #command == 0 or #command > 64 then
		return false, T(player, "Invalid command")
	end
	if argument ~= nil and (type(argument) ~= "string" or #argument > 64) then
		return false, T(player, "Invalid argument")
	end
	local ok, message = execute(player, command .. " " .. (argument or ""), "remote")
	return ok, message
end

----------------------------------------------------------------------
-- Cycle de vie
----------------------------------------------------------------------

function DebugService:Start()
	-- Toujours branchée (sinon l'appel du client resterait bloqué), mais ne
	-- fait rien hors de Studio
	Net.Function("DebugCommand").OnServerInvoke = onDebugCommand

	if not IS_STUDIO then
		return
	end
	-- Avec le nouveau chat (TextChatService), un message "/xxx" inconnu peut ne
	-- jamais arriver à Player.Chatted : on déclare donc de vraies commandes.
	local ok, err = pcall(function()
		local folder = Instance.new("Folder")
		folder.Name = "DopamineDebugCommands"
		for _, name in ipairs(COMMAND_NAMES) do
			local command = Instance.new("TextChatCommand")
			command.Name = "Debug_" .. name
			command.PrimaryAlias = "/" .. name
			command.Triggered:Connect(function(textSource: TextSource, text: string)
				local player = Players:GetPlayerByUserId(textSource.UserId)
				if player and services.DataService:GetData(player) then
					handleChat(player, text)
				end
			end)
			command.Parent = folder
		end
		folder.Parent = TextChatService
	end)
	if not ok then
		warn("[DebugService] Impossible de déclarer les commandes de chat :", err)
	end
end

function DebugService:PlayerReady(player: Player)
	if not IS_STUDIO then
		return
	end
	-- Ancien chat (LegacyChatService) : Player.Chatted suffit
	player.Chatted:Connect(function(message: string)
		handleChat(player, message)
	end)
end

function DebugService:PlayerRemoving(player: Player)
	lastRun[player] = nil
end

return DebugService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="218">
        <Properties>
          <string name="Name">EventService</string>
          <string name="Source"><![CDATA[--[[
	EventService (ModuleScript)
	Emplacement : ServerScriptService > Services > EventService

	Événements aléatoires :
	  - "Dopamine Rush" : x2 sur tous les gains pendant 30 s, pour TOUT le serveur ;
	  - objets à cliquer vite (Config.Spawners) : étoile dorée, éclair,
	    notification de téléphone, e-mail, don du live. Chaque type apparaît
	    chez un joueur seulement s'il possède la Feature correspondante
	    (et, si RequiresFollow, seulement s'il est abonné au live :
	    data.LiveFollowed).
	Le serveur décide quand ils arrivent et valide les clics.
]]

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Net = require(ReplicatedStorage.Shared.Net)

local EventService = {}

local services
local random = Random.new()

-- Dans Studio, les événements arrivent plus vite pour pouvoir les tester
local speedup = RunService:IsStudio() and Config.Events.StudioSpeedup or 1

local SPAWN_GRACE = 0.5 -- marge (s) pour la latence réseau
local SCHEDULER_STEP = 0.25 -- intervalle (s) de la boucle des apparitions

local rush = {
	Active = false,
	EndsAt = 0, -- heure serveur (workspace:GetServerTimeNow())
	Token = 0, -- change à chaque (re)programmation de la fin du Rush
}

--[[
	Apparitions par joueur :
	[Player] = {
		Pending = { [id] = { Kind, ExpiresAt } }, -- objets affichés, pas encore cliqués
		NextAt = { [kind] = os.clock() de la prochaine apparition (nil = Feature absente) },
	}
]]
local spawnStates = {}

function EventService:Init(allServices)
	services = allServices
end

----------------------------------------------------------------------
-- Dopamine Rush (global)
----------------------------------------------------------------------

function EventService:GetMultiplier(): number
	return rush.Active and Config.Events.Rush.Multiplier or 1
end

local function rushPayload()
	return {
		Active = rush.Active,
		EndsAt = rush.EndsAt,
		Name = Config.Events.Rush.Name,
		Multiplier = Config.Events.Rush.Multiplier,
	}
end

function EventService:SendState(player: Player)
	Net.Event("EventUpdate"):FireClient(player, rushPayload())
end

-- Programme la fin du Rush en cours (un jeton évite qu'une ancienne fin
-- programmée coupe un Rush prolongé entre-temps)
local function scheduleRushEnd()
	rush.Token += 1
	local token = rush.Token
	local remaining = math.max(0, rush.EndsAt - workspace:GetServerTimeNow())
	task.delay(remaining, function()
		if rush.Token ~= token or not rush.Active then
			return
		end
		rush.Active = false
		Net.Event("EventUpdate"):FireAllClients(rushPayload())
		services.GameService:MarkAllDirty()
	end)
end

-- Lance un Dopamine Rush (aussi utilisé par la commande de test /rush).
-- `extend` = true (Rush acheté avec des Robux) : si un Rush est déjà en
-- cours, il est prolongé de sa durée au lieu d'être ignoré.
-- Renvoie true si un Rush a été lancé ou prolongé.
function EventService:StartRush(extend: boolean?): boolean
	local settings = Config.Events.Rush
	if rush.Active then
		if not extend then
			return false
		end
		rush.EndsAt += settings.Duration
		scheduleRushEnd()
		Net.Event("EventUpdate"):FireAllClients(rushPayload())
		services.GameService:MarkAllDirty()
		services.GameService:NotifyAll(function(lang)
			return {
				Type = "Rush",
				Text = Locale.TFor(lang, "⚡ %s extended by %s s!", Locale.TFor(lang, settings.Name), tostring(settings.Duration)),
			}
		end)
		return true
	end
	rush.Active = true
	rush.EndsAt = workspace:GetServerTimeNow() + settings.Duration
	scheduleRushEnd()
	Net.Event("EventUpdate"):FireAllClients(rushPayload())
	services.GameService:MarkAllDirty()
	services.GameService:NotifyAll(function(lang)
		return {
			Type = "Rush",
			Text = Locale.TFor(lang, "⚡ %s: x%s for %s s!", Locale.TFor(lang, settings.Name),
				tostring(settings.Multiplier), tostring(settings.Duration)),
		}
	end)
	return true
end

----------------------------------------------------------------------
-- Objets à cliquer (Config.Spawners)
----------------------------------------------------------------------

-- Retire les objets expirés et renvoie le nombre d'objets encore en attente pour ce type
local function cleanPending(state, kind: string): number
	local clock = os.clock()
	local count = 0
	for id, spawn in pairs(state.Pending) do
		if clock > spawn.ExpiresAt + SPAWN_GRACE then
			state.Pending[id] = nil
		elseif spawn.Kind == kind then
			count += 1
		end
	end
	return count
end

-- Fait apparaître un objet chez un joueur (ignore la Feature : utilisé aussi par /spawn).
-- Renvoie false si trop d'objets de ce type sont déjà affichés.
function EventService:Spawn(player: Player, kind: string): boolean
	local state = spawnStates[player]
	local settings = Config.Spawners[kind]
	if not state or not settings then
		return false
	end
	if cleanPending(state, kind) >= Config.MaxPendingSpawnsPerKind then
		return false
	end

	local id = HttpService:GenerateGUID(false)
	state.Pending[id] = {
		Kind = kind,
		ExpiresAt = os.clock() + settings.Lifetime,
	}
	Net.Event("Spawn"):FireClient(player, {
		Kind = kind,
		Id = id,
		X = random:NextNumber(0.08, 0.72),
		Y = random:NextNumber(0.15, 0.85),
		Lifetime = settings.Lifetime,
		Variant = random:NextInteger(1, 1000),
	})
	return true
end

-- Ancien nom (v1), gardé pour compatibilité
function EventService:SpawnGolden(player: Player)
	return self:Spawn(player, "Golden")
end

-- Oublie tous les objets en attente (détox, reset)
function EventService:ClearSpawns(player: Player)
	local state = spawnStates[player]
	if state then
		state.Pending = {}
		state.NextAt = {}
	end
end

local function randomDelay(settings): number
	return random:NextNumber(settings.MinInterval, settings.MaxInterval) / speedup
end

-- Le joueur remplit-il les conditions de ce type d'objet ?
local function isSpawnerUnlocked(data, settings): boolean
	if not Formulas.HasFeature(data, settings.Feature) then
		return false
	end
	if settings.RequiresFollow and data.LiveFollowed ~= true then
		return false -- dons du live : seulement après "Suivre"
	end
	return true
end

-- Boucle unique qui planifie les apparitions de chaque type pour chaque joueur
-- (équivaut à une boucle par joueur et par type, sans créer de threads)
local function schedulerStep()
	local clock = os.clock()
	for player, state in pairs(spawnStates) do
		local data = services.DataService:GetData(player)
		if data and services.GameService:IsReady(player) then
			for kind, settings in pairs(Config.Spawners) do
				if not isSpawnerUnlocked(data, settings) then
					state.NextAt[kind] = nil -- pas débloqué : rien ne se prépare
				elseif state.NextAt[kind] == nil then
					-- Tout juste débloqué (ou arrivée du joueur) : le premier arrive plus vite
					state.NextAt[kind] = clock + randomDelay(settings) * 0.5
				elseif clock >= state.NextAt[kind] then
					state.NextAt[kind] = clock + randomDelay(settings)
					EventService:Spawn(player, kind)
				end
			end
		end
	end
end

-- Pas de limite de fréquence ici : chaque id est à usage unique (supprimé de
-- Pending dès le premier clic), donc deux clics rapides légitimes passent
local function onSpawnClick(player: Player, id: any)
	local state = spawnStates[player]
	if not state or type(id) ~= "string" or #id > 64 then
		return
	end
	local spawn = state.Pending[id]
	if not spawn then
		return
	end
	state.Pending[id] = nil
	if os.clock() > spawn.ExpiresAt + SPAWN_GRACE then
		return -- trop tard
	end

	local data = services.DataService:GetData(player)
	local settings = Config.Spawners[spawn.Kind]
	if not data or not settings then
		return
	end
	local reward = Formulas.ScaledReward(services.GameService:GetStats(player), settings.RewardSeconds, settings.MinReward)
	if settings.Stat then
		data.Stats[settings.Stat] = (data.Stats[settings.Stat] or 0) + 1
	end
	services.GameService:AddDopamine(player, reward, true)
	services.QuestService:Progress(player, "Spawns", 1)
	services.GameService:Notify(player, {
		Type = "Bonus",
		Source = spawn.Kind,
		Amount = reward,
		SpawnId = id,
	})
end

----------------------------------------------------------------------
-- Cycle de vie
----------------------------------------------------------------------

function EventService:PlayerReady(player: Player)
	spawnStates[player] = { Pending = {}, NextAt = {} }
end

function EventService:PlayerRemoving(player: Player)
	spawnStates[player] = nil
end

function EventService:Start()
	Net.Event("SpawnClick").OnServerEvent:Connect(onSpawnClick)

	-- Boucle des apparitions (par joueur et par type)
	task.spawn(function()
		while true do
			task.wait(SCHEDULER_STEP)
			local ok, err = pcall(schedulerStep)
			if not ok then
				warn("[EventService] Erreur des apparitions :", err)
			end
		end
	end)

	-- Boucle des Dopamine Rush (globaux)
	task.spawn(function()
		local settings = Config.Events.Rush
		while true do
			task.wait(random:NextNumber(settings.MinInterval, settings.MaxInterval) / speedup)
			self:StartRush()
			task.wait(settings.Duration)
		end
	end)
end

return EventService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="219">
        <Properties>
          <string name="Name">FriendMailService</string>
          <string name="Source"><![CDATA[--[[
	FriendMailService (ModuleScript)
	Emplacement : ServerScriptService > Services > FriendMailService

	Dopamail entre AMIS Roblox (vrais joueurs) : écrire à un ami, qu'il soit
	sur ce serveur, sur un autre serveur du jeu ou hors ligne, et lui répondre.
	Ces mails ne rapportent JAMAIS de Dopamine.

	Règles (toutes vérifiées ICI, jamais confiées au client) :
	  - le destinataire est un ami Roblox du joueur (liste GetFriendsAsync en
	    cache, sinon player:IsFriendsWithAsync) ;
	  - le joueur a le droit de discuter (TextChatService:CanUserChatAsync) et
	    la paire expéditeur -> destinataire aussi
	    (TextChatService:CanUsersDirectChatAsync, sinon CanUsersChatAsync) :
	    réglages de confidentialité, d'âge et contrôle parental respectés.
	    Un "non" net = refusé tout de suite. Réponse inconnue (API qui ne sait
	    pas répondre pour un destinataire absent du serveur) = accepté si
	    l'expéditeur a le droit de discuter ; le contrôle de la paire est
	    REFAIT à la livraison (destinataire présent) : refusé -> mail supprimé ;
	  - anti-spam persistant (data.FriendMail, sauvegardé : se reconnecter ne
	    remet rien à zéro) : 1 nouveau mail / 10 min, 1 réponse à un mail
	    d'ami reçu / 2 min (une seule réponse par mail reçu) ;
	  - longueurs : objet 60, texte 300 caractères (FriendMailRules).

	Filtrage (règle Roblox) :
	  - le texte BRUT n'est gardé que côté serveur (DataStore "FriendMail_v1",
	    une clé par destinataire) et n'est jamais envoyé à personne ;
	  - à la LIVRAISON, sur le serveur du destinataire (il y est donc présent) :
	    TextService:FilterStringAsync(brut, expéditeur, PrivateChat) puis
	    GetChatForUserAsync(destinataire). Pourquoi la variante "chat" : un
	    mail d'ami est un message privé d'un utilisateur à UN autre
	    utilisateur précis ; Roblox demande PrivateChat + GetChatForUserAsync
	    pour ces messages (le filtre s'adapte aux deux comptes : âge,
	    réglages). GetNonChatString* est prévu pour du texte "hors
	    conversation" (noms d'objets, panneaux...), ce qui n'est pas le cas ;
	  - secours (API refusée, expéditeur hors ligne...) : à l'ENVOI, pendant
	    que l'expéditeur est sur son serveur, on calcule aussi
	    GetNonChatStringForBroadcastAsync (la version la plus stricte, valable
	    pour tout le monde), gardée à côté du brut (BS / BB). Si le filtre par
	    destinataire échoue à la livraison, c'est ELLE qui est montrée, jamais
	    le brut. Filtre "pour tout le monde" en échec à l'envoi = envoi refusé.
	    Sans aucune version filtrée = mail NON montré, nouvel essai plus tard ;
	  - la copie "Envoyés" de l'expéditeur passe par le chemin habituel
	    (RemoteFunction "FilterText", purpose "Mail", côté client).

	Livraison :
	  - même serveur : immédiate ;
	  - autre serveur : MessagingService, sujet "FriendMail", petit message
	    { To = UserId, Id = id du mail } ; le serveur du destinataire relit sa
	    boîte (DataStore, sans cache) et livre ;
	  - hors ligne : la boîte (UpdateAsync, ajout, 30 mails max, rien de plus
	    de 30 jours) est lue à la prochaine connexion : mails non lus.
	  + relecture de secours toutes les 3 minutes (message perdu, filtre en
	    panne...). Tout est sous pcall avec nouvelles tentatives, budgets
	    DataStore vérifiés ; dans Studio sans accès aux API, rien ne casse :
	    le client affiche "indisponible dans Studio".

	Remotes :
	  RemoteFunction "FriendMail" (action, argument) -> (ok, résultat | message, état?)
	    "Status" -> état { Enabled, Reason, NewIn, ReplyIn, NewInterval, ReplyInterval }
	    "Friends" -> { Friends = { { Id, Name, Display } }, Status }
	    "Inbox" -> { Mails = { mail filtré }, Loaded, Status }
	    "Send" { To, Subject, Body, ReplyTo? } -> { Id, Where = "Server" | "Away", Status }
	    "Read" id | "Delete" id | "Report" id (cache + bloque l'expéditeur)
	    "Block" userId | "Unblock" userId -> { Blocked = { [userId] = true } }
	  RemoteEvent "FriendMailEvent" S -> C ("New", mail filtré)
	    mail filtré = { Id, From, Name, Display, Subject, Body, Time, Age, Read, Replied, IsReply }
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Rules = require(Shared.FriendMailRules)

local RateLimiter = require(script.Parent.RateLimiter)

local FriendMailService = {}

local STORE_NAME = "FriendMail_v1"
local TOPIC = "FriendMail"
local FRIENDS_TTL = 600 -- liste d'amis gardée 10 min
local FRIENDS_MAX = 250
local PAIR_TTL = 300 -- résultat d'un contrôle "peuvent discuter" gardé 5 min
local FLUSH_DELAY = 10 -- regroupe les changements (lu, supprimé...) avant d'écrire
local POLL_INTERVAL = 180 -- relecture de secours de la boîte
local RETRY_INTERVAL = 60 -- relecture plus tôt si un mail n'a pas pu être livré
local MAX_ATTEMPTS = 3

-- Délais anti-spam des appels (secondes), par action
local CALL_INTERVALS = {
	Status = 0.5,
	Friends = 2,
	Inbox = 1,
	Send = 1.5,
	Read = 0.1,
	Delete = 0.2,
	Report = 0.5,
	Block = 0.5,
	Unblock = 0.5,
}

local services = nil
local store: DataStore? = nil
-- "Unknown" (pas encore essayé) | "Ok" | "Studio" (API coupées dans Studio) | "Down"
local storeState = "Unknown"
local messagingReady = false
local sessions: { [Player]: any } = {}
local inflight = 0 -- écritures en cours (sortie d'un joueur, fermeture du serveur)

----------------------------------------------------------------------
-- Utilitaires
----------------------------------------------------------------------

local function T(player: Player, text: string, ...): string
	local game = services and services.GameService
	if game and game.T then
		return game:T(player, text, ...)
	end
	return string.format(text, ...)
end

local function getData(player: Player): any
	local dataService = services and services.DataService
	return dataService and dataService:GetData(player)
end

-- Données anti-spam / blocages du joueur (créées si absentes)
local function friendState(player: Player): any
	local data = getData(player)
	if not data then
		return nil
	end
	if type(data.FriendMail) ~= "table" then
		data.FriendMail = Rules.SanitizeData(nil, os.time())
	end
	if type(data.FriendMail.Blocked) ~= "table" then
		data.FriendMail.Blocked = {}
	end
	return data.FriendMail
end

-- Erreurs pour lesquelles réessayer ne sert à rien (Studio sans API, place non publiée)
local function isFatal(message: string): boolean
	return string.find(message, "StudioAccessToApisNotAllowed", 1, true) ~= nil
		or string.find(message, "publish", 1, true) ~= nil
		or string.find(message, "403", 1, true) ~= nil
end

local function markFatal()
	storeState = RunService:IsStudio() and "Studio" or "Down"
end

-- pcall + nouvelles tentatives avec attente croissante (1 s, 2 s...)
local function retry(description: string, callback: () -> any): (boolean, any)
	local lastError = nil
	for attempt = 1, MAX_ATTEMPTS do
		local ok, result = pcall(callback)
		if ok then
			return true, result
		end
		lastError = result
		if isFatal(tostring(result)) then
			markFatal()
			break
		end
		warn(string.format("[FriendMailService] %s : échec (tentative %d) : %s", description, attempt, tostring(result)))
		if attempt < MAX_ATTEMPTS then
			task.wait(2 ^ (attempt - 1))
		end
	end
	return false, lastError
end

-- Budget DataStore restant pour ce type de requête (inconnu = on tente)
local function hasBudget(requestType: Enum.DataStoreRequestType): boolean
	local ok, budget = pcall(function()
		return DataStoreService:GetRequestBudgetForRequestType(requestType)
	end)
	if not ok or type(budget) ~= "number" then
		return true
	end
	return budget >= 1
end

local function keyFor(userId: number): string
	return "Inbox_" .. tostring(userId)
end

-- Lecture SANS le cache de 4 s du DataStore (un mail vient d'arriver)
local function freshOptions(): any
	local ok, options = pcall(function()
		local value = Instance.new("DataStoreGetOptions")
		value.UseCache = false
		return value
	end)
	return ok and options or nil
end

local function unavailableReason(): string?
	if storeState == "Studio" or (store == nil and RunService:IsStudio()) then
		return "Studio"
	end
	if store == nil or storeState == "Down" then
		return "Down"
	end
	return nil
end

local function unavailableText(player: Player, reason: string): string
	if reason == "Studio" then
		return T(player, "Friend mail is unavailable in Studio")
	end
	return T(player, "Friend mail is unavailable right now")
end

local function statusFor(player: Player)
	local state = friendState(player)
	local now = os.time()
	local _, newIn = Rules.Check(state, now, false)
	local _, replyIn = Rules.Check(state, now, true)
	local reason = unavailableReason()
	return {
		Enabled = reason == nil,
		Reason = reason,
		NewIn = newIn,
		ReplyIn = replyIn,
		NewInterval = Rules.NewInterval,
		ReplyInterval = Rules.ReplyInterval,
	}
end

local function newSession(): any
	return {
		Inbox = {}, -- enregistrements BRUTS (jamais envoyés)
		Shown = {}, -- [id] = mail filtré déjà livré au client
		Ops = { Delete = {}, Read = {}, Replied = {} }, -- changements à écrire
		Pairs = {}, -- ["de>à"] = { Value, At } (peuvent discuter ?)
		Loaded = false,
		Dirty = false,
		Flushing = false,
		FlushQueued = false,
		RefreshQueued = false,
		Delivering = false,
		DeliverAgain = false,
		Failed = false,
		LastPoll = os.clock(),
		Friends = nil,
		FriendSet = nil,
		FriendsAt = 0,
		FriendsLoading = false,
		Sending = false,
	}
end

-- Changements à appliquer à la boîte stockée (+ expéditeurs bloqués)
local function opsFor(player: Player?, session): any
	local state = player and friendState(player)
	return {
		Delete = session.Ops.Delete,
		Read = session.Ops.Read,
		Replied = session.Ops.Replied,
		-- (joueur parti : copie de ses blocages faite à sa sortie)
		Blocked = (state and state.Blocked) or session.BlockedCopy or {},
	}
end

local function findRecord(session, id: any): any
	if type(id) ~= "string" then
		return nil
	end
	for _, record in ipairs(session.Inbox) do
		if record.Id == id then
			return record
		end
	end
	return nil
end

----------------------------------------------------------------------
-- Contrôles Roblox (amis, droit de discuter, filtre)
----------------------------------------------------------------------

-- Amis du joueur (paginé, en cache 10 min). nil si l'API a échoué.
local function fetchFriends(player: Player, session): { any }?
	if session.Friends and os.clock() - session.FriendsAt < FRIENDS_TTL then
		return session.Friends
	end
	local waited = 0
	while session.FriendsLoading and waited < 15 do
		waited += task.wait(0.2)
	end
	if session.Friends and os.clock() - session.FriendsAt < FRIENDS_TTL then
		return session.Friends
	end
	session.FriendsLoading = true
	local list: { any } = {}
	local ok = false
	for attempt = 1, 2 do
		list = {}
		ok = pcall(function()
			local pages = Players:GetFriendsAsync(player.UserId)
			while true do
				for _, item in ipairs(pages:GetCurrentPage()) do
					local id, name, display = Rules.ReadFriend(item)
					if id and #list < FRIENDS_MAX then
						table.insert(list, { Id = id, Name = name, Display = display })
					end
				end
				if pages.IsFinished or #list >= FRIENDS_MAX then
					break
				end
				pages:AdvanceToNextPageAsync()
			end
		end)
		if ok or attempt == 2 then
			break
		end
		task.wait(1)
	end
	session.FriendsLoading = false
	if not ok then
		return nil
	end
	local set = {}
	for _, friend in ipairs(list) do
		set[friend.Id] = true
	end
	session.Friends = list
	session.FriendSet = set
	session.FriendsAt = os.clock()
	return list
end

local function isFriend(player: Player, session, userId: number): boolean?
	if session.FriendSet and session.FriendSet[userId] and os.clock() - session.FriendsAt < FRIENDS_TTL then
		return true
	end
	local ok, result = pcall(function()
		return player:IsFriendsWithAsync(userId)
	end)
	if ok and type(result) == "boolean" then
		return result
	end
	return nil
end

-- Le joueur a-t-il le droit de discuter (réglages du compte) ? nil = inconnu
local function canUserChat(userId: number): boolean?
	local ok, result = pcall(function()
		return TextChatService:CanUserChatAsync(userId)
	end)
	if ok and type(result) == "boolean" then
		return result
	end
	return nil
end

-- `fromId` peut-il écrire en privé à `toId` ? true / false / nil (inconnu).
-- CanUsersDirectChatAsync est fait pour les messages directs (1 à 1) ;
-- CanUsersChatAsync en secours si l'API précédente n'est pas disponible.
local function canUsersChat(fromId: number, toId: number): boolean?
	local ok, result = pcall(function()
		return TextChatService:CanUsersDirectChatAsync(fromId, { toId })
	end)
	if ok and type(result) == "table" then
		return table.find(result, toId) ~= nil
	end
	local okPair, allowed = pcall(function()
		return TextChatService:CanUsersChatAsync(fromId, toId)
	end)
	if okPair and type(allowed) == "boolean" then
		return allowed
	end
	return nil
end

-- Même contrôle, gardé 5 min dans la session (par sens : "de>à" ; seulement
-- les réponses sûres)
local function pairAllowed(session, fromId: number, toId: number): boolean?
	local key = tostring(fromId) .. ">" .. tostring(toId)
	local cached = session.Pairs[key]
	if cached and os.clock() - cached.At < PAIR_TTL then
		return cached.Value
	end
	local value = canUsersChat(fromId, toId)
	if value ~= nil then
		session.Pairs[key] = { Value = value, At = os.clock() }
	end
	return value
end

-- Texte brut -> version filtrée "pour tout le monde" (la plus stricte),
-- calculée à l'ENVOI (l'expéditeur est là). nil = échec : envoi refusé.
local function filterBroadcast(raw: string, fromId: number): string?
	if raw == "" then
		return ""
	end
	local ok, text = pcall(function()
		local result = TextService:FilterStringAsync(raw, fromId, Enum.TextFilterContext.PrivateChat)
		return result:GetNonChatStringForBroadcastAsync()
	end)
	if ok and type(text) == "string" then
		return text
	end
	return nil
end

-- Texte brut -> texte filtré POUR le destinataire (nil = échec)
local function filterFor(raw: string, fromId: number, toId: number): string?
	if raw == "" then
		return ""
	end
	local ok, text = pcall(function()
		local result = TextService:FilterStringAsync(raw, fromId, Enum.TextFilterContext.PrivateChat)
		return result:GetChatForUserAsync(toId)
	end)
	if ok and type(text) == "string" then
		return text
	end
	return nil
end

----------------------------------------------------------------------
-- Boîte de réception (DataStore) : lecture, écriture, livraison
----------------------------------------------------------------------

local function flushSession(userId: number, session, player: Player?)
	if not session.Dirty or session.Flushing or not store then
		return
	end
	if not hasBudget(Enum.DataStoreRequestType.UpdateAsync) then
		return
	end
	local dataStore = store :: DataStore
	session.Flushing = true
	session.Dirty = false
	local ops = opsFor(player, session)
	local ok = retry("Écriture de la boîte " .. tostring(userId), function()
		dataStore:UpdateAsync(keyFor(userId), function(old)
			return Rules.ApplyOps(old, ops, os.time())
		end)
	end)
	session.Flushing = false
	if not ok then
		session.Dirty = true -- nouvel essai au prochain passage
	end
end

-- Écriture comptée : la fermeture du serveur attend qu'elle finisse
local function trackedFlush(userId: number, session, player: Player?)
	inflight += 1
	pcall(flushSession, userId, session, player)
	inflight -= 1
end

local function markDirty(player: Player, session)
	session.Dirty = true
	if session.FlushQueued then
		return
	end
	session.FlushQueued = true
	task.delay(FLUSH_DELAY, function()
		session.FlushQueued = false
		if sessions[player] == session then
			flushSession(player.UserId, session, player)
		end
	end)
end

local function removeFromSession(session, predicate: (any) -> boolean): number
	local removed = 0
	for index = #session.Inbox, 1, -1 do
		local record = session.Inbox[index]
		if predicate(record) then
			table.remove(session.Inbox, index)
			session.Shown[record.Id] = nil
			removed += 1
		end
	end
	return removed
end

-- Copie envoyée au client : + Age (secondes depuis l'envoi, calculées ici :
-- l'heure du client n'entre pas en jeu)
local function withAge(mail): any
	local copy = table.clone(mail)
	copy.Age = math.max(0, os.time() - mail.Time)
	return copy
end

-- Filtre puis envoie UN mail au client (s'il ne l'a pas déjà)
local function deliver(player: Player, session, record): boolean
	if session.Shown[record.Id] then
		return true
	end
	local state = friendState(player)
	if state and state.Blocked[tostring(record.F)] then
		return true -- expéditeur bloqué : jamais montré
	end
	local allowed = pairAllowed(session, record.F, player.UserId)
	if allowed == false then
		-- Réglages de confidentialité / d'âge : jamais montré, retiré de la boîte
		session.Ops.Delete[record.Id] = true
		removeFromSession(session, function(other)
			return other.Id == record.Id
		end)
		markDirty(player, session)
		return true
	elseif allowed == nil then
		return false
	end
	-- Filtre pour CE destinataire ; en échec, la version "pour tout le
	-- monde" faite à l'envoi (jamais le brut)
	local subject = Rules.ShownText(filterFor(record.S, record.F, player.UserId), record.BS)
	local body = subject ~= nil and Rules.ShownText(filterFor(record.B, record.F, player.UserId), record.BB) or nil
	if subject == nil or body == nil or not player.Parent or sessions[player] ~= session then
		return false -- aucune version filtrée : pas montré, nouvel essai plus tard
	end
	local out = {
		Id = record.Id,
		From = record.F,
		Name = type(record.N) == "string" and record.N or "",
		Display = type(record.D) == "string" and record.D or "",
		Subject = subject,
		Body = body,
		Time = record.T,
		Read = record.Rd == true or session.Ops.Read[record.Id] == true,
		Replied = record.Rp == true or session.Ops.Replied[record.Id] == true,
		IsReply = record.R ~= nil,
	}
	session.Shown[record.Id] = out
	Net.Event("FriendMailEvent"):FireClient(player, "New", withAge(out))
	return true
end

-- Livre tous les mails pas encore montrés (un seul passage à la fois)
local function deliverAll(player: Player)
	local session = sessions[player]
	if not session then
		return
	end
	if session.Delivering then
		session.DeliverAgain = true
		return
	end
	session.Delivering = true
	repeat
		session.DeliverAgain = false
		local failed = false
		local list = table.clone(session.Inbox)
		for _, record in ipairs(list) do
			if sessions[player] ~= session then
				break
			end
			if not deliver(player, session, record) then
				failed = true
			end
		end
		session.Failed = failed
	until not session.DeliverAgain or sessions[player] ~= session
	session.Delivering = false
end

-- (Re)lit la boîte du joueur ; `fresh` = sans cache (un mail vient d'arriver)
local function loadInbox(player: Player, fresh: boolean): boolean
	local session = sessions[player]
	if not session or not store or unavailableReason() == "Studio" then
		return false
	end
	if not hasBudget(Enum.DataStoreRequestType.GetAsync) then
		return false
	end
	local dataStore = store :: DataStore
	session.LastPoll = os.clock()
	local options = fresh and freshOptions() or nil
	local ok, value = retry("Lecture de la boîte de " .. player.Name, function()
		if options then
			return dataStore:GetAsync(keyFor(player.UserId), options)
		end
		return dataStore:GetAsync(keyFor(player.UserId))
	end)
	if not ok then
		return false
	end
	if storeState == "Unknown" then
		storeState = "Ok"
	end
	if sessions[player] ~= session then
		return false
	end
	session.Inbox = Rules.ApplyOps(value, opsFor(player, session), os.time())
	session.Loaded = true
	deliverAll(player)
	return true
end

local function queueRefresh(player: Player, delay: number)
	local session = sessions[player]
	if not session or session.RefreshQueued then
		return
	end
	session.RefreshQueued = true
	task.delay(delay, function()
		if sessions[player] == session then
			session.RefreshQueued = false
			loadInbox(player, true)
		end
	end)
end

-- Message d'un autre serveur : un mail attend un joueur d'ici
local function onMessage(message: any)
	local data = type(message) == "table" and message.Data or nil
	if type(data) ~= "table" or not Rules.ValidUserId(data.To) then
		return
	end
	local player = Players:GetPlayerByUserId(data.To)
	if player and sessions[player] then
		queueRefresh(player, 1.5)
	end
end

----------------------------------------------------------------------
-- Envoi
----------------------------------------------------------------------

local function doSend(player: Player, session, args): (boolean, any)
	local toId = args.To
	local subject = Rules.Clean(args.Subject, Rules.SubjectMax)
	local body = Rules.Clean(args.Body, Rules.BodyMax)
	if subject == "" and body == "" then
		return false, T(player, "Write something first ✍️")
	end

	-- Réponse : à un mail reçu de CE destinataire, une seule fois
	local original = nil
	if args.ReplyTo ~= nil then
		original = findRecord(session, args.ReplyTo)
		if not original or original.F ~= toId then
			return false, T(player, "This mail can't be answered anymore")
		end
		if original.Rp or session.Ops.Replied[original.Id] then
			return false, T(player, "You already answered this mail")
		end
	end
	local replying = original ~= nil

	local state = friendState(player)
	if not state then
		return false, T(player, "Message could not be sent, try again")
	end
	local allowedNow, remaining = Rules.Check(state, os.time(), replying)
	if not allowedNow then
		return false, T(player, "Next friend mail in %s", Rules.Countdown(remaining))
	end

	local friend = isFriend(player, session, toId)
	if friend == false then
		return false, T(player, "You can only mail your Roblox friends")
	elseif friend == nil then
		return false, T(player, "Friend mail is unavailable right now")
	end
	local canChat = canUserChat(player.UserId)
	if canChat == false then
		return false, T(player, "Your account settings don't allow private messages")
	elseif canChat == nil then
		return false, T(player, "Friend mail is unavailable right now")
	end
	-- "Non" net : refusé. Inconnu (destinataire sur un autre serveur ou hors
	-- ligne) : accepté, la paire est contrôlée à la livraison
	local pair = pairAllowed(session, player.UserId, toId)
	if pair == false then
		return false, T(player, "This friend can't receive messages (privacy settings)")
	end

	-- Version filtrée "pour tout le monde" (secours de la livraison)
	local broadcastSubject = filterBroadcast(subject, player.UserId)
	local broadcastBody = broadcastSubject ~= nil and filterBroadcast(body, player.UserId) or nil
	if broadcastSubject == nil or broadcastBody == nil then
		return false, T(player, "Message could not be sent, try again")
	end

	if not store or not hasBudget(Enum.DataStoreRequestType.UpdateAsync) then
		return false, T(player, "Friend mail is busy, try again in a minute")
	end
	local dataStore = store :: DataStore
	local now = os.time()
	local record = {
		Id = HttpService:GenerateGUID(false),
		F = player.UserId,
		N = player.Name,
		D = player.DisplayName,
		S = subject,
		B = body,
		BS = broadcastSubject,
		BB = broadcastBody,
		T = now,
		R = original and original.Id or nil,
	}
	local ok = retry("Envoi d'un mail à " .. tostring(toId), function()
		dataStore:UpdateAsync(keyFor(toId), function(old)
			return Rules.Append(old, record, os.time())
		end)
	end)
	if not ok then
		return false, T(player, "Message could not be sent, try again")
	end

	-- Envoyé : l'anti-spam compte (sauvegardé avec les données du joueur)
	if replying then
		state.LastReply = now
		original.Rp = true
		session.Ops.Replied[original.Id] = true
		local shown = session.Shown[original.Id]
		if shown then
			shown.Replied = true
		end
		markDirty(player, session)
	else
		state.LastNew = now
	end

	-- Livraison : tout de suite (même serveur) ou message aux autres serveurs
	local target = Players:GetPlayerByUserId(toId)
	local targetSession = target and sessions[target]
	if target and targetSession then
		targetSession.Inbox = Rules.Append(targetSession.Inbox, table.clone(record), os.time())
		task.spawn(deliverAll, target)
	elseif messagingReady then
		task.spawn(function()
			pcall(function()
				MessagingService:PublishAsync(TOPIC, { To = toId, Id = record.Id })
			end)
		end)
	end
	return true, { Id = record.Id, Where = targetSession and "Server" or "Away" }
end

----------------------------------------------------------------------
-- RemoteFunction "FriendMail"
----------------------------------------------------------------------

local function sortedShown(session): { any }
	local list = {}
	for _, mail in pairs(session.Shown) do
		table.insert(list, withAge(mail))
	end
	table.sort(list, function(a, b)
		return a.Time > b.Time
	end)
	return list
end

local function onInvoke(player: Player, action: any, arg: any)
	local session = sessions[player]
	local interval = type(action) == "string" and CALL_INTERVALS[action] or nil
	if not session or not interval then
		return false, T(player, "Invalid message")
	end
	if not RateLimiter.Check(player, "FriendMail_" .. action, interval) then
		return false, T(player, "Slow down a little!"), statusFor(player)
	end

	if action == "Status" then
		return true, statusFor(player)
	elseif action == "Inbox" then
		return true, { Mails = sortedShown(session), Loaded = session.Loaded, Status = statusFor(player) }
	elseif action == "Friends" then
		local reason = unavailableReason()
		local list = fetchFriends(player, session)
		if not list then
			return false, T(player, "Couldn't load your friends"), statusFor(player)
		end
		local state = friendState(player)
		return true, { Friends = list, Blocked = state and state.Blocked or {}, Status = statusFor(player), Reason = reason }
	elseif action == "Send" then
		local reason = unavailableReason()
		if reason then
			return false, unavailableText(player, reason), statusFor(player)
		end
		if type(arg) ~= "table" or not Rules.ValidUserId(arg.To) or arg.To == player.UserId then
			return false, T(player, "Invalid message"), statusFor(player)
		end
		if type(arg.Subject) ~= "string" or type(arg.Body) ~= "string" or (arg.ReplyTo ~= nil and type(arg.ReplyTo) ~= "string") then
			return false, T(player, "Invalid message"), statusFor(player)
		end
		if session.Sending then
			return false, T(player, "Slow down a little!"), statusFor(player)
		end
		session.Sending = true
		local okCall, ok, result = pcall(doSend, player, session, arg)
		session.Sending = false
		if not okCall then
			warn("[FriendMailService] Envoi : " .. tostring(ok))
			return false, T(player, "Message could not be sent, try again"), statusFor(player)
		end
		if ok then
			result.Status = statusFor(player)
			return true, result
		end
		return false, result, statusFor(player)
	elseif action == "Read" then
		local record = findRecord(session, arg)
		if record and not record.Rd then
			record.Rd = true
			session.Ops.Read[record.Id] = true
			local shown = session.Shown[record.Id]
			if shown then
				shown.Read = true
			end
			markDirty(player, session)
		end
		return true, true
	elseif action == "Delete" or action == "Report" then
		local record = findRecord(session, arg)
		if not record then
			return false, T(player, "This mail can't be answered anymore")
		end
		session.Ops.Delete[record.Id] = true
		removeFromSession(session, function(other)
			return other.Id == record.Id
		end)
		local state = friendState(player)
		if action == "Report" and state then
			-- Signaler : rien n'est envoyé ailleurs ; le mail est caché et
			-- l'expéditeur bloqué pour CE joueur
			state.Blocked[tostring(record.F)] = true
			removeFromSession(session, function(other)
				return other.F == record.F
			end)
		end
		markDirty(player, session)
		return true, { Blocked = state and state.Blocked or {} }
	elseif action == "Block" or action == "Unblock" then
		local state = friendState(player)
		if not state or not Rules.ValidUserId(arg) then
			return false, T(player, "Invalid message")
		end
		local key = tostring(arg)
		if action == "Block" then
			local count = 0
			for _ in pairs(state.Blocked) do
				count += 1
			end
			if count >= Rules.BlockMax and not state.Blocked[key] then
				return false, T(player, "Too many blocked players")
			end
			state.Blocked[key] = true
			removeFromSession(session, function(other)
				return other.F == arg
			end)
			markDirty(player, session)
		else
			state.Blocked[key] = nil
			queueRefresh(player, 1)
		end
		return true, { Blocked = state.Blocked }
	end
	return false, T(player, "Invalid message")
end

----------------------------------------------------------------------
-- Cycle de vie
----------------------------------------------------------------------

function FriendMailService:Init(allServices)
	services = allServices
end

function FriendMailService:Start()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[FriendMailService] DataStore indisponible (place non publiée ?) :", result)
		markFatal()
	end

	Net.Function("FriendMail").OnServerInvoke = onInvoke

	-- Messages des autres serveurs (quelques essais, rien de grave sinon :
	-- la relecture de secours livre quand même)
	task.spawn(function()
		for attempt = 1, 3 do
			local subscribed, err = pcall(function()
				return MessagingService:SubscribeAsync(TOPIC, onMessage)
			end)
			if subscribed then
				messagingReady = true
				return
			end
			if isFatal(tostring(err)) then
				return
			end
			task.wait(5 * attempt)
		end
	end)

	-- Relecture de secours + écritures en retard
	task.spawn(function()
		while true do
			task.wait(20)
			local clock = os.clock()
			for player, session in pairs(sessions) do
				if session.Dirty and not session.FlushQueued and not session.Flushing then
					task.spawn(flushSession, player.UserId, session, player)
				end
				local wait = session.Failed and RETRY_INTERVAL or POLL_INTERVAL
				if clock - session.LastPoll >= wait and not session.RefreshQueued then
					queueRefresh(player, math.random() * 5)
				end
			end
		end
	end)

	-- Fermeture du serveur : on écrit ce qui reste
	game:BindToClose(function()
		for player, session in pairs(sessions) do
			if session.Dirty then
				task.spawn(trackedFlush, player.UserId, session, player)
			end
		end
		local start = os.clock()
		while inflight > 0 and os.clock() - start < 15 do
			task.wait(0.1)
		end
	end)
end

function FriendMailService:PlayerReady(player: Player, _data)
	local session = newSession()
	sessions[player] = session
	task.spawn(loadInbox, player, false)
end

function FriendMailService:PlayerRemoving(player: Player)
	local session = sessions[player]
	sessions[player] = nil
	if session and session.Dirty then
		-- (ses données sont encore là : DataService les libère après nous)
		session.BlockedCopy = table.clone(opsFor(player, session).Blocked)
		task.spawn(trackedFlush, player.UserId, session, nil)
	end
end

return FriendMailService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="220">
        <Properties>
          <string name="Name">GameService</string>
          <string name="Source"><![CDATA[--[[
	GameService (ModuleScript)
	Emplacement : ServerScriptService > Services > GameService

	Cœur du jeu, 100 % côté serveur :
	  - clics (limite de clics/seconde, combo calculé par le serveur si la
	    Feature "Combo" est débloquée) ;
	  - achats d'améliorations (le serveur vérifie le prix et l'argent) et
	    "Aller à l'océan" (détox = rebirth) ;
	  - gains passifs (voir le pipeline ci-dessous) ;
	  - temps d'écran (par session, par jour UTC, total) ;
	  - envoi de l'état au client : état COMPLET (StateUpdate) seulement quand
	    quelque chose de "structurel" change (achat, quête terminée, coffre
	    gagné, réglage...), sinon un petit "StateTick" (Dopamine, ClickSeq,
	    avancement des quêtes / du coffre) : voir "Synchronisation" plus bas ;
	  - leaderstats (liste des joueurs en haut à droite) ;
	  - Dopamine hors-ligne : l'absence est calculée au chargement
	    (DataService:TakeOfflineSeconds), le gain est donné et notifié
	    (Notify { Type = "Offline" }) seulement quand le client est prêt
	    (ClientReady), pour que la fenêtre "Bon retour !" s'affiche.
	    Si le joueur part avant, le gain est donné sans notification.

	Pipeline du tick passif (toutes les Config.Game.PassiveTickRate secondes,
	pour chaque joueur chargé) :
	  1. Dopamine/s : PerSecond x temps écoulé -> AddDopamine ;
	  2. Rebonds DVD : DVDService:CollectBounces renvoie le nombre de rebonds
	     depuis le dernier tick (tous les logos, 2 axes, plafonné) ;
	     gain = rebonds x BounceValue, Stats.Bounces, quête "Bounces" ;
	  3. Temps de jeu : Stats.PlaySeconds, temps de la session et
	     ScreenTime["jour UTC"] (on ne garde que Config.ScreenTime.DaysKept jours) ;
	  4. Coffres : LootService:Charge remplit la jauge du coffre mystère ;
	  5. Auto-clic (Game Pass) : AutoClicksPerSecond clics/s, même gain qu'un
	     clic sans combo, comptés dans Stats.TotalClicks.
	Les stats (Rush et bonus compris) sont recalculées une seule fois par
	joueur et par tick. Bonus = produit des multiplicateurs des Game Passes
	possédés x boost actif (MonetizationService) x confort de la maison
	(HouseService, objets posés dans 🏠).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Formulas = require(Shared.Formulas)
local Locale = require(Shared.Locale)
local NumberFormatter = require(Shared.NumberFormatter)
local Net = require(Shared.Net)
local RateLimiter = require(script.Parent.RateLimiter)

local GameService = {}

local services -- toutes les autres services (rempli par Init)

-- Données "de session" (non sauvegardées) : [Player] = session
local sessions = {}

-- Réglages booléens acceptés par SetSetting (+ "ClickSound" et "Language", voir plus bas)
local VALID_SETTINGS = { Sound = true, Music = true, Effects = true, DarkMode = true }
-- Langues acceptées pour Settings.Language ("Auto" = langue de Roblox)
local VALID_LANGUAGES = { Auto = true, en = true, fr = true }
local DEFAULT_LANGUAGE = "Auto"
-- Sons de clic existants : [Id] = true
local CLICK_SOUNDS = {}
for _, clickSound in ipairs(Config.ClickSounds) do
	CLICK_SOUNDS[clickSound.Id] = true
end
local DEFAULT_CLICK_SOUND = "Default"
-- Musiques au choix : "Shuffle" (aléatoire) ou la Key d'une piste de Config.Music.Playlist
local MUSIC_TRACKS = { Shuffle = true }
for _, track in ipairs(Config.Music.Playlist) do
	if type(track.Key) == "string" then
		MUSIC_TRACKS[track.Key] = true
	end
end

-- Clients qui ont envoyé ClientReady (l'interface peut afficher les notifications).
-- Peut arriver AVANT la fin du chargement des données : on le retient à part.
local readyClients: { [Player]: boolean } = {}
local SECONDS_PER_DAY = 86400

----------------------------------------------------------------------
-- Utilitaires
----------------------------------------------------------------------

local function isValidNumber(value): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function currentDay(): number
	return math.floor(os.time() / SECONDS_PER_DAY)
end

local function createLeaderstats(player: Player)
	if player:FindFirstChild("leaderstats") then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"

	-- StringValue pour afficher "1.5M" au lieu d'un nombre illisible
	local dopamine = Instance.new("StringValue")
	dopamine.Name = Config.Game.CurrencyName
	dopamine.Value = "0"
	dopamine.Parent = folder

	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Value = 0
	rebirths.Parent = folder

	folder.Parent = player
end

local function updateLeaderstats(player: Player, data)
	local folder = player:FindFirstChild("leaderstats")
	if not folder then
		return
	end
	local dopamine = folder:FindFirstChild(Config.Game.CurrencyName) :: StringValue?
	local rebirths = folder:FindFirstChild("Rebirths") :: IntValue?
	if dopamine then
		local text = NumberFormatter.Format(data.Dopamine)
		if dopamine.Value ~= text then
			dopamine.Value = text
		end
	end
	if rebirths and rebirths.Value ~= data.Rebirths then
		rebirths.Value = data.Rebirths
	end
end

-- Temps d'écran : supprime les jours trop anciens (et les clés invalides)
local function pruneScreenTime(data)
	local screenTime = data.ScreenTime
	local oldest = currentDay() - Config.ScreenTime.DaysKept + 1
	for key, value in pairs(screenTime) do
		local day = tonumber(key)
		if type(key) ~= "string" or not day or day < oldest or not isValidNumber(value) then
			screenTime[key] = nil
		end
	end
end

-- Corrige une sauvegarde abîmée ou devenue incohérente avec la config
-- (niveau max baissé, objet cosmétique supprimé...)
local function sanitizeData(data)
	for upgradeId, level in pairs(data.Upgrades) do
		local upgrade = Config.UpgradesById[upgradeId]
		if not upgrade or not isValidNumber(level) or level <= 0 or upgrade.Effect == "Detox" then
			data.Upgrades[upgradeId] = nil
		elseif upgrade.MaxLevel and level > upgrade.MaxLevel then
			data.Upgrades[upgradeId] = upgrade.MaxLevel
		else
			data.Upgrades[upgradeId] = math.floor(level)
		end
	end

	local cosmetics = data.Cosmetics
	for _, slot in ipairs({ "Hat", "Skin" }) do
		local id = cosmetics.Equipped[slot]
		local cosmetic = type(id) == "string" and Config.CosmeticsById[id]
		if not cosmetic or cosmetic.Slot ~= slot or not cosmetics.Owned[id] then
			cosmetics.Equipped[slot] = ""
		end
	end

	local chests = data.Chests
	chests.Stored = math.clamp(math.floor(chests.Stored), 0, Config.LootBox.MaxStored)
	chests.Progress = math.clamp(chests.Progress, 0, 1)

	if not isValidNumber(data.Dopamine) or data.Dopamine < 0 then
		data.Dopamine = 0
	end
	if type(data.Stock) ~= "table" then
		data.Stock = { Shares = 0, CostBasis = 0 }
	end
	if not isValidNumber(data.Stock.Shares) or data.Stock.Shares < 0 then
		data.Stock.Shares = 0
		data.Stock.CostBasis = 0
	end

	pruneScreenTime(data)

	-- Son de clic supprimé de la config -> son par défaut
	if type(data.Settings.ClickSound) ~= "string" or not CLICK_SOUNDS[data.Settings.ClickSound] then
		data.Settings.ClickSound = DEFAULT_CLICK_SOUND
	end
	-- Musique retirée de la config -> aléatoire
	if type(data.Settings.MusicTrack) ~= "string" or not MUSIC_TRACKS[data.Settings.MusicTrack] then
		data.Settings.MusicTrack = "Shuffle"
	end
	-- Niveaux au-delà du maximum (ex. 10 logos DVD -> 5 maintenant)
	for upgradeId, level in pairs(data.Upgrades) do
		local upgrade = Config.UpgradesById[upgradeId]
		if upgrade and upgrade.MaxLevel and type(level) == "number" and level > upgrade.MaxLevel then
			data.Upgrades[upgradeId] = upgrade.MaxLevel
		end
	end
	-- Ancienne bourse retirée : les actions encore détenues sont remboursées une fois
	if isValidNumber(data.Stock.Shares) and data.Stock.Shares > 0 then
		local price = (Config.Stocks and tonumber(Config.Stocks.StartPrice)) or 0
		data.Dopamine = math.min(Config.Game.MaxDopamine, data.Dopamine + data.Stock.Shares * price)
	end
	data.Stock.Shares = 0
	data.Stock.CostBasis = 0
	-- Langue inconnue (sauvegarde abîmée) -> automatique
	if type(data.Settings.Language) ~= "string" or not VALID_LANGUAGES[data.Settings.Language] then
		data.Settings.Language = DEFAULT_LANGUAGE
	end
	-- Abonné au live sans posséder le live (sauvegarde incohérente)
	if data.LiveFollowed and not Formulas.HasFeature(data, "LiveStream") then
		data.LiveFollowed = false
	end
end

----------------------------------------------------------------------
-- API utilisée par les autres services
----------------------------------------------------------------------

function GameService:Init(allServices)
	services = allServices
end

function GameService:IsReady(player: Player): boolean
	return sessions[player] ~= nil
end

function GameService:GetSession(player: Player)
	return sessions[player]
end

-- Le joueur possède-t-il cette Feature (débloquée par une amélioration) ?
function GameService:HasFeature(player: Player, feature: string): boolean
	local data = services.DataService:GetData(player)
	return data ~= nil and Formulas.HasFeature(data, feature)
end

-- Calcule les statistiques actuelles du joueur (gain/clic, gain/s...)
-- Bonus = Game Passes x boost actif x confort de la maison 🏠
function GameService:GetStats(player: Player)
	local data = services.DataService:GetData(player)
	return Formulas.ComputeStats(
		data,
		services.EventService:GetMultiplier(),
		services.MonetizationService:GetBonusMultiplier(player) * services.HouseService:GetBonus(player)
	)
end

-- Ajoute de la Dopamine (façon normale de gagner de l'argent dans le jeu)
-- countForQuests = false pour ne pas faire avancer les quêtes "Gagne X"
function GameService:AddDopamine(player: Player, amount: number, countForQuests: boolean?)
	local data = services.DataService:GetData(player)
	if not data or not isValidNumber(amount) or amount <= 0 then
		return
	end
	local maxValue = Config.Game.MaxDopamine
	data.Dopamine = math.min(maxValue, data.Dopamine + amount)
	data.Stats.LifetimeDopamine = math.min(maxValue, data.Stats.LifetimeDopamine + amount)
	if countForQuests ~= false then
		-- Quêtes "Gagne X" : leur avancement part dans le petit tick ; un état
		-- complet seulement si une quête a été terminée (nouvelle quête)
		local before = data.Stats.QuestsCompleted
		self:RunLight(player, services.QuestService.Progress, services.QuestService, player, "Earn", amount)
		if data.Stats.QuestsCompleted ~= before then
			self:MarkDirty(player)
		end
	end
	self:MarkTick(player)
end

-- Quelque chose de "structurel" a changé : l'état COMPLET partira au
-- prochain envoi (Config.Game.SyncRate). Pendant RunLight, le changement
-- est rétrogradé en petit tick (l'appelant décide lui-même).
function GameService:MarkDirty(player: Player)
	local session = sessions[player]
	if session then
		if session.Light > 0 then
			session.TickDirty = true
		else
			session.Dirty = true
		end
	end
end

-- Seules des valeurs "légères" ont changé (Dopamine, clics, avancement des
-- quêtes ou du coffre) : un petit StateTick suffit
function GameService:MarkTick(player: Player)
	local session = sessions[player]
	if session then
		session.TickDirty = true
	end
end

function GameService:MarkAllDirty()
	for _, session in pairs(sessions) do
		session.Dirty = true
	end
end

-- Appelle fn(...) en rétrogradant ses MarkDirty en petits ticks (appels
-- fréquents : quêtes "Gagne X", jauge du coffre, succès). Les erreurs sont
-- relancées après avoir rétabli le compteur.
function GameService:RunLight(player: Player, fn: (...any) -> ...any, ...)
	local session = sessions[player]
	if not session then
		fn(...)
		return
	end
	session.Light += 1
	local ok, err = pcall(fn, ...)
	session.Light = math.max(0, session.Light - 1)
	if not ok then
		error(err, 0)
	end
end

-- Langue d'un joueur ("en" | "fr") : réglage Settings.Language sinon langue Roblox
function GameService:GetLanguage(player: Player): string
	local data = services and services.DataService:GetData(player)
	local settings = data and data.Settings
	return Locale.ForPlayer(player, settings and settings.Language)
end

-- Traduit un texte anglais dans la langue du joueur (puis string.format)
-- Ex. : GameService:T(player, "Not enough %s", "Dopamine")
function GameService:T(player: Player, text: string, ...): string
	return Locale.TFor(self:GetLanguage(player), text, ...)
end

-- Envoie une notification à un joueur
-- payload = { Type = "Info" | "Error" | "Achievement" | "Quest" | "Bonus" | "Jackpot" | "Rush" | "Unlock" | "Detox" | "Purchase", ... }
-- Le Text éventuel doit déjà être dans la langue du joueur (GameService:T).
function GameService:Notify(player: Player, payload)
	Net.Event("Notify"):FireClient(player, payload)
end

-- Notifie tous les joueurs (sauf `except`, optionnel).
-- `payload` peut être une table (identique pour tous) ou une fonction
-- (langue) -> table, appelée pour chaque joueur afin que le texte soit
-- dans SA langue : NotifyAll(function(lang) return { Text = Locale.TFor(lang, ...) } end)
function GameService:NotifyAll(payload: any, except: Player?)
	local remote = Net.Event("Notify")
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= except then
			local message = payload
			if type(payload) == "function" then
				local ok, result = pcall(payload, self:GetLanguage(other))
				message = ok and result or nil
			end
			if type(message) == "table" then
				remote:FireClient(other, message)
			end
		end
	end
end

-- Temps d'écran envoyé au client
function GameService:GetScreenTime(player: Player)
	local data = services.DataService:GetData(player)
	local session = sessions[player]
	local today = currentDay()
	local days = {}
	for offset = Config.ScreenTime.DaysKept - 1, 0, -1 do
		table.insert(days, data.ScreenTime[tostring(today - offset)] or 0)
	end
	return {
		Session = session and session.SessionSeconds or 0,
		Today = data.ScreenTime[tostring(today)] or 0,
		Total = data.Stats.PlaySeconds,
		Days = days, -- du plus ancien à aujourd'hui
	}
end

-- Construit l'état envoyé au client (tout ce que l'interface doit afficher)
function GameService:BuildState(player: Player)
	local data = services.DataService:GetData(player)
	local session = sessions[player]
	local stats = self:GetStats(player)
	local monetization = services.MonetizationService
	local boostMultiplier, boostRemaining = monetization:GetBoost(data)
	local offlineRate, offlineMaxSeconds = Formulas.GetOfflineSettings(data)
	local houseComfort = Formulas.GetHouseComfort(data)

	local state = {
		Dopamine = data.Dopamine,
		Rebirths = data.Rebirths,
		Upgrades = data.Upgrades,
		Features = Formulas.GetFeatures(data),
		Achievements = data.Achievements,
		Quests = data.Quests,
		Stats = data.Stats,
		Settings = data.Settings, -- { Sound, Music, Effects, ClickSound, Language, DarkMode }
		LiveFollowed = data.LiveFollowed == true, -- abonné au live (bouton "Suivre")

		ClickValue = stats.ClickValue,
		PerSecond = stats.PerSecond,
		BounceValue = stats.BounceValue,
		DVDCount = stats.DVDCount,
		GlobalMultiplier = stats.GlobalMultiplier,
		ClickMultiplier = stats.ClickMultiplier,
		UpgradeMultiplier = stats.UpgradeMultiplier,
		RebirthMultiplier = stats.RebirthMultiplier,
		AchievementMultiplier = stats.AchievementMultiplier,
		CosmeticMultiplier = stats.CosmeticMultiplier,
		EventMultiplier = stats.EventMultiplier,
		BonusMultiplier = monetization:GetBonusMultiplier(player), -- Game Passes x boost actif (sans la maison)
		ComboEnabled = Formulas.HasFeature(data, "Combo"),

		RebirthCost = Formulas.GetRebirthCost(data.Rebirths),
		NextRebirthMultiplier = Formulas.GetRebirthMultiplier(data.Rebirths + 1),

		Daily = services.DailyRewardService:GetInfo(player, stats),
		Chests = {
			Stored = data.Chests.Stored,
			Progress = data.Chests.Progress,
			Max = Config.LootBox.MaxStored,
		},
		Cosmetics = data.Cosmetics,
		ScreenTime = self:GetScreenTime(player),

		-- Thèmes et boutique Robux
		Themes = services.ThemeService:GetState(player), -- { Owned = { [id] = true }, Equipped = id }
		Passes = monetization:GetOwnedPasses(player), -- { [passId] = true }
		Boost = { Multiplier = boostMultiplier, Remaining = math.max(0, math.floor(boostRemaining)) },
		CasinoEnabled = monetization:IsCasinoEnabled(),
		IsVIP = monetization:IsVIP(player),

		-- 🏠 Maison (gardée pour toujours) : données, confort des objets posés
		-- et multiplicateur de gains (ex. 1.23 = +23 %, déjà compris dans GlobalMultiplier)
		House = data.House,
		HouseComfort = houseComfort,
		HouseBonus = Formulas.GetHouseBonus(houseComfort),

		-- Dopamine hors-ligne : taux (0..1) de la production et durée max prise en compte
		Offline = { Rate = offlineRate, MaxSeconds = offlineMaxSeconds },

		-- Nombre de clics reçus par le serveur (sert au client pour sa prédiction)
		ClickSeq = session and session.ClickSeq or 0,
	}
	-- Champs ajoutés par les autres services (machine chanceuse, jardin,
	-- arcade...) : service:GetClientState(player, data) -> { [champ] = valeur }
	for name, service in pairs(services) do
		if type(service) == "table" and type(service.GetClientState) == "function" then
			local ok, extra = pcall(service.GetClientState, service, player, data)
			if ok and type(extra) == "table" then
				for key, value in pairs(extra) do
					if state[key] == nil then
						state[key] = value
					end
				end
			elseif not ok then
				warn("[GameService] GetClientState de " .. tostring(name) .. " :", extra)
			end
		end
	end
	return state
end

-- Avancement des quêtes (pour savoir s'il a changé depuis le dernier envoi)
local function questProgressKey(data): string
	local parts = {}
	for index, quest in ipairs(data.Quests) do
		parts[index] = tostring(quest.Progress)
	end
	return table.concat(parts, ",")
end

-- Jauge du coffre arrondie au pourcent (ce que le client affiche)
local function chestKey(data): number
	local chests = data.Chests
	return chests.Stored * 1000 + math.floor((chests.Progress or 0) * 100)
end

-- Mémorise ce qui vient d'être envoyé (le prochain tick n'envoie que ce qui change)
local function rememberSent(session, data)
	session.SentQuests = questProgressKey(data)
	session.SentChest = chestKey(data)
	session.SentClicks = data.Stats.TotalClicks
end

function GameService:SendState(player: Player)
	local session = sessions[player]
	local data = services.DataService:GetData(player)
	if not session or not data then
		return
	end
	session.Dirty = false
	session.TickDirty = false
	session.Stale = false
	session.LastFull = os.clock()
	Net.Event("StateUpdate"):FireClient(player, self:BuildState(player))
	rememberSent(session, data)
	updateLeaderstats(player, data)
end

-- Petit état fréquent entre deux états complets. Toujours : Dopamine et
-- ClickSeq ; seulement si changé : clics totaux, avancement des quêtes
-- ({ progrès dans l'ordre de data.Quests }) et coffre ({ Stored, Progress }).
function GameService:BuildTick(player: Player, session, data)
	local tick: { [string]: any } = {
		Dopamine = data.Dopamine,
		ClickSeq = session.ClickSeq,
	}
	local clicks = data.Stats.TotalClicks
	if clicks ~= session.SentClicks then
		tick.TotalClicks = clicks
	end
	local quests = questProgressKey(data)
	if quests ~= session.SentQuests then
		local progress = {}
		for index, quest in ipairs(data.Quests) do
			progress[index] = quest.Progress
		end
		tick.QuestProgress = progress
	end
	if chestKey(data) ~= session.SentChest then
		tick.Chests = { Stored = data.Chests.Stored, Progress = data.Chests.Progress }
	end
	return tick
end

function GameService:SendTick(player: Player)
	local session = sessions[player]
	local data = services.DataService:GetData(player)
	if not session or not data then
		return
	end
	session.TickDirty = false
	Net.Event("StateTick"):FireClient(player, self:BuildTick(player, session, data))
	rememberSent(session, data)
	-- Liste des joueurs : texte "1.5M" (ne change pas à chaque tick)
	updateLeaderstats(player, data)
end

-- Dopamine hors-ligne : calcule le gain pour `seconds` d'absence (production
-- sans Rush ni boost, avec les Game Passes et le confort de la maison), le donne (sans faire avancer les
-- quêtes) et, si `notify`, envoie la fenêtre "Bon retour !" au client.
-- Renvoie le montant donné (0 si rien).
function GameService:GrantOffline(player: Player, seconds: number, notify: boolean?): number
	local data = services.DataService:GetData(player)
	if not data or not isValidNumber(seconds) or seconds <= 0 then
		return 0
	end
	local permanentBonus = services.MonetizationService:GetPassMultiplier(player) * services.HouseService:GetBonus(player)
	local stats = Formulas.ComputeStats(data, 1, permanentBonus)
	local reward = Formulas.GetOfflineReward(data, stats.PerSecond, seconds)
	if not isValidNumber(reward) or reward <= 0 then
		return 0
	end
	local rate, maxSeconds = Formulas.GetOfflineSettings(data)

	self:AddDopamine(player, reward, false)
	data.Stats.OfflineEarned = math.min(Config.Game.MaxDopamine, data.Stats.OfflineEarned + reward)

	if notify and sessions[player] then
		self:SendState(player) -- le compteur inclut déjà le gain quand la fenêtre s'ouvre
		self:Notify(player, {
			Type = "Offline",
			Amount = reward,
			Seconds = math.floor(seconds), -- durée réelle de l'absence (non plafonnée)
			Rate = rate, -- 0..1
			MaxSeconds = maxSeconds, -- durée max prise en compte
			Text = self:T(player, "😴 Welcome back! +%s %s earned while you were away",
				NumberFormatter.Format(reward), Config.Game.CurrencyName),
		})
	end
	return reward
end

-- Donne le gain hors-ligne en attente, seulement si le client est prêt.
-- On attend d'abord (5 s max) la vérification des Game Passes pour que leurs
-- multiplicateurs comptent. Si le joueur part pendant l'attente,
-- PlayerRemoving donne le gain (PendingOffline n'est remis à 0 qu'au don).
local OFFLINE_PASS_WAIT = 5
local function deliverPendingOffline(player: Player)
	local session = sessions[player]
	if not session or not readyClients[player] or session.PendingOffline <= 0 or session.OfflineDelivering then
		return
	end
	session.OfflineDelivering = true
	task.spawn(function()
		services.MonetizationService:WaitForPassChecks(player, OFFLINE_PASS_WAIT)
		session.OfflineDelivering = false
		if sessions[player] ~= session then
			return -- parti entre-temps : déjà donné par PlayerRemoving
		end
		local seconds = session.PendingOffline
		session.PendingOffline = 0 -- avant tout : jamais donné deux fois
		if seconds > 0 then
			local ok, err = pcall(GameService.GrantOffline, GameService, player, seconds, true)
			if not ok then
				warn("[GameService] Erreur du gain hors-ligne pour " .. player.Name .. " :", err)
			end
		end
	end)
end

-- Envoie tout ce dont le client a besoin (état, logos DVD, Rush, classement,
-- bourse) puis le gain hors-ligne si le client est prêt
function GameService:SendFullSync(player: Player)
	if not sessions[player] then
		return
	end
	self:SendState(player)
	services.DVDService:SendSetup(player)
	services.EventService:SendState(player)
	services.LeaderboardService:SendTo(player)
	deliverPendingOffline(player)
end

-- Remet le combo à zéro (détox, reset...)
function GameService:ResetCombo(player: Player)
	local session = sessions[player]
	if session then
		session.Combo = 0
		session.ComboMaxed = false
	end
end

-- "Aller à l'océan" : remet la progression à zéro contre un multiplicateur
-- permanent. On garde : succès, stats, cosmétiques, cadeau, réglages,
-- coffres, temps d'écran, quêtes, la maison 🏠 (data.House n'est pas
-- touchée) et les améliorations "Permanent".
function GameService:Detox(player: Player)
	local data = services.DataService:GetData(player)
	if not data or not sessions[player] then
		return
	end

	local kept = {}
	for upgradeId, level in pairs(data.Upgrades) do
		local upgrade = Config.UpgradesById[upgradeId]
		if upgrade and upgrade.Permanent then
			kept[upgradeId] = level
		end
	end

	data.Dopamine = 0
	data.Upgrades = kept
	if type(data.Stock) == "table" then
		data.Stock.Shares = 0
		data.Stock.CostBasis = 0
	end
	data.Rebirths += 1
	data.LiveFollowed = false -- le live repart de zéro : il faudra se réabonner
	self:ResetCombo(player)

	services.DVDService:Reset(player)
	services.EventService:ClearSpawns(player)
	-- Nouvelles quêtes adaptées à la production (redevenue petite) après la détox
	services.QuestService:Regenerate(player)

	local multiplier = Formulas.GetRebirthMultiplier(data.Rebirths)
	self:Notify(player, {
		Type = "Detox",
		Rebirths = data.Rebirths,
		Multiplier = multiplier,
	})
	local displayName, rebirths = player.DisplayName, tostring(data.Rebirths)
	self:NotifyAll(function(lang)
		return {
			Type = "Info",
			Text = Locale.TFor(lang, "🌊 %s went to the ocean (x%s)", displayName, rebirths),
		}
	end, player)
	self:SendState(player)

	-- Étape importante : on sauvegarde tout de suite (sans bloquer l'appelant)
	task.spawn(function()
		services.DataService:SaveAsync(player, true)
	end)
end

-- Appelé après un changement d'améliorations fait "à la main" (commandes de test)
function GameService:RefreshAfterUpgradeChange(player: Player)
	services.DVDService:SyncLogos(player)
	self:SendState(player)
end

----------------------------------------------------------------------
-- Cycle de vie du joueur (appelé par Main)
----------------------------------------------------------------------

function GameService:PlayerReady(player: Player, data)
	local now = os.clock()
	sessions[player] = {
		ClickSeq = 0,
		Combo = 0, -- jauge de combo (0-100)
		ComboMaxed = false, -- déjà compté comme "combo max" ?
		LastClick = now,
		Tokens = Config.Game.MaxClicksPerSecond, -- anti-autoclick (seau de jetons)
		LastRefill = now,
		SessionSeconds = 0, -- temps de jeu de cette session
		PendingOffline = services.DataService:TakeOfflineSeconds(player), -- absence à récompenser
		OfflineDelivering = false, -- don du gain hors-ligne programmé
		Dirty = true, -- état COMPLET à envoyer (changement structurel)
		TickDirty = false, -- petit StateTick à envoyer (Dopamine, clics...)
		Stale = false, -- des valeurs secondaires (stats...) ont bougé depuis le dernier état complet
		LastFull = 0, -- os.clock() du dernier état complet
		Light = 0, -- > 0 pendant RunLight (MarkDirty -> petit tick)
		AchievementCount = -1, -- succès débloqués (pour détecter un nouveau succès)
		SentQuests = "", -- avancement des quêtes déjà envoyé
		SentChest = -1, -- jauge du coffre déjà envoyée
		SentClicks = -1, -- clics totaux déjà envoyés
	}
	sanitizeData(data)
	createLeaderstats(player)
end

function GameService:PlayerRemoving(player: Player)
	-- Gain hors-ligne jamais notifié (client jamais prêt) : donné quand même,
	-- avant la sauvegarde de sortie (Main appelle ReleaseAsync après)
	local session = sessions[player]
	if session and session.PendingOffline > 0 then
		local seconds = session.PendingOffline
		session.PendingOffline = 0
		local ok, err = pcall(self.GrantOffline, self, player, seconds, false)
		if not ok then
			warn("[GameService] Erreur du gain hors-ligne pour " .. player.Name .. " :", err)
		end
	end
	sessions[player] = nil
	readyClients[player] = nil
end

----------------------------------------------------------------------
-- Actions des joueurs (toujours validées ici)
----------------------------------------------------------------------

local function onClick(player: Player)
	local session = sessions[player]
	local data = services.DataService:GetData(player)
	if not session or not data then
		return
	end

	-- Compté même si refusé : le client s'en sert pour corriger sa prédiction
	session.ClickSeq += 1
	session.TickDirty = true

	-- Seau de jetons : on regagne MaxClicksPerSecond jetons par seconde
	local now = os.clock()
	local maxClicks = Config.Game.MaxClicksPerSecond
	session.Tokens = math.min(maxClicks, session.Tokens + (now - session.LastRefill) * maxClicks)
	session.LastRefill = now
	if session.Tokens < 1 then
		return -- trop de clics : ignoré (autoclicker / exploit)
	end
	session.Tokens -= 1

	data.Stats.TotalClicks += 1

	-- Combo calculé par le serveur (le client ne fait que l'afficher),
	-- seulement si l'amélioration "Combo" est achetée
	local comboMultiplier = 1
	if Formulas.HasFeature(data, "Combo") then
		session.Combo = Formulas.StepCombo(session.Combo, now - session.LastClick)
		if session.Combo >= 100 and not session.ComboMaxed then
			session.ComboMaxed = true
			data.Stats.CombosMaxed += 1
			services.QuestService:Progress(player, "Combo", 1)
		elseif session.Combo < 50 then
			session.ComboMaxed = false
		end
		comboMultiplier = Formulas.GetComboMultiplier(session.Combo)
	else
		session.Combo = 0
		session.ComboMaxed = false
	end
	session.LastClick = now

	local stats = GameService:GetStats(player)
	GameService:AddDopamine(player, stats.ClickValue * comboMultiplier, true)
	services.QuestService:Progress(player, "Clicks", 1)
end

local function onBuyUpgrade(player: Player, upgradeId: any)
	if not RateLimiter.Check(player, "Buy", 0.05) then
		return false, GameService:T(player, "Slow down!")
	end
	local data = services.DataService:GetData(player)
	if not data or not sessions[player] then
		return false, GameService:T(player, "Loading...")
	end
	if type(upgradeId) ~= "string" or #upgradeId > 64 then
		return false, GameService:T(player, "Invalid request")
	end
	local upgrade = Config.UpgradesById[upgradeId]
	if not upgrade then
		return false, GameService:T(player, "Unknown upgrade")
	end

	local level = data.Upgrades[upgradeId] or 0
	if Formulas.IsMaxed(upgrade, level) then
		return false, GameService:T(player, "Max level reached")
	end
	if not Formulas.IsUpgradeUnlocked(data, upgrade) then
		return false, GameService:T(player, "Locked for now")
	end
	local cost = Formulas.GetUpgradeCost(upgrade, level, data.Rebirths)
	if not isValidNumber(cost) or data.Dopamine < cost then
		return false, GameService:T(player, "Not enough %s", Config.Game.CurrencyName)
	end

	-- "Aller à l'océan" : la détox
	if upgrade.Effect == "Detox" then
		if not RateLimiter.Check(player, "Detox", 2) then
			return false, GameService:T(player, "Slow down!")
		end
		GameService:Detox(player)
		local multiplier = NumberFormatter.Multiplier(Formulas.GetRebirthMultiplier(data.Rebirths))
		return true, GameService:T(player, "🌊 Breathe... Permanent earnings %s", multiplier)
	end

	data.Dopamine -= cost
	data.Upgrades[upgradeId] = level + 1
	data.Stats.UpgradesBought += 1
	services.QuestService:Progress(player, "Buy", 1)

	if upgrade.Feature and level == 0 then
		GameService:Notify(player, {
			Type = "Unlock",
			Feature = upgrade.Feature,
			UpgradeId = upgrade.Id,
			Text = GameService:T(player, "✨ New: %s %s!", upgrade.Icon, GameService:T(player, upgrade.Name)),
		})
		if upgrade.Feature == "Quests" then
			-- Les quêtes deviennent visibles : on en propose des toutes neuves, à l'échelle
			services.QuestService:Regenerate(player)
		end
	end

	services.DVDService:SyncLogos(player)
	GameService:SendState(player)
	return true, GameService:T(player, "%s %s level %d", upgrade.Icon, GameService:T(player, upgrade.Name), level + 1)
end

local function onSetSetting(player: Player, name: any, value: any)
	if type(name) ~= "string" then
		return false
	end
	if name == "ClickSound" then
		-- Son de clic : l'Id doit exister dans Config.ClickSounds
		if type(value) ~= "string" or #value > 64 or not CLICK_SOUNDS[value] then
			return false
		end
	elseif name == "MusicTrack" then
		-- Musique : "Shuffle" ou la Key d'une piste de Config.Music.Playlist
		if type(value) ~= "string" or #value > 32 or not MUSIC_TRACKS[value] then
			return false
		end
	elseif name == "Language" then
		-- Langue : "Auto" | "en" | "fr" (appliquée par le client au prochain lancement)
		if type(value) ~= "string" or not VALID_LANGUAGES[value] then
			return false
		end
	elseif not VALID_SETTINGS[name] or type(value) ~= "boolean" then
		return false
	end
	-- Une limite par réglage : couper le son puis les effets rapidement reste possible
	if not RateLimiter.Check(player, "Setting" .. name, 0.2) then
		return false
	end
	local data = services.DataService:GetData(player)
	if not data then
		return false
	end
	data.Settings[name] = value
	GameService:MarkDirty(player)
	return true
end

----------------------------------------------------------------------
-- Tick passif (voir le pipeline en haut du fichier)
----------------------------------------------------------------------

local function passiveTick(player: Player, session, elapsed: number)
	local data = services.DataService:GetData(player)
	if not data then
		return
	end
	local stats = GameService:GetStats(player)

	-- 1. Dopamine par seconde
	if stats.PerSecond > 0 then
		GameService:AddDopamine(player, stats.PerSecond * elapsed, true)
	end

	-- 2. Rebonds des logos DVD
	local bounces = services.DVDService:CollectBounces(player, workspace:GetServerTimeNow())
	if bounces > 0 then
		data.Stats.Bounces += bounces
		GameService:AddDopamine(player, stats.BounceValue * bounces, true)
		services.QuestService:Progress(player, "Bounces", bounces)
	end

	-- 3. Temps de jeu / temps d'écran
	local before = math.floor(session.SessionSeconds)
	session.SessionSeconds += elapsed
	data.Stats.PlaySeconds += elapsed
	local key = tostring(currentDay())
	local screenTime = data.ScreenTime
	if screenTime[key] == nil then
		screenTime[key] = 0
		pruneScreenTime(data) -- nouveau jour : on oublie le plus ancien
	end
	screenTime[key] += elapsed
	if math.floor(session.SessionSeconds) ~= before then
		-- Le client extrapole le temps d'écran : l'état complet périodique suffit
		session.Stale = true
	end

	-- 4. Coffre mystère : la jauge part dans le petit tick, un nouveau coffre
	-- plein déclenche un état complet
	local storedBefore = data.Chests.Stored
	GameService:RunLight(player, services.LootService.Charge, services.LootService, player, data, elapsed)
	if data.Chests.Stored ~= storedBefore then
		GameService:MarkDirty(player)
	end

	-- 5. Auto-clic (Game Pass) : comme un clic normal, sans combo
	local autoClicks = services.MonetizationService:TakeAutoClicks(player, elapsed)
	if autoClicks > 0 then
		data.Stats.TotalClicks += autoClicks
		GameService:AddDopamine(player, stats.ClickValue * autoClicks, true)
	end
end

----------------------------------------------------------------------
-- Démarrage : branchements des remotes + boucles
----------------------------------------------------------------------

function GameService:Start()
	Net.Event("Click").OnServerEvent:Connect(onClick)
	Net.Event("ClientReady").OnServerEvent:Connect(function(player)
		-- Retenu même si les données chargent encore : Main enverra la synchro
		-- complète (et le gain hors-ligne) à la fin du chargement
		if player.Parent then
			readyClients[player] = true
		end
		if RateLimiter.Check(player, "ClientReady", 2) then
			self:SendFullSync(player)
		end
	end)
	Net.Function("BuyUpgrade").OnServerInvoke = onBuyUpgrade
	Net.Function("SetSetting").OnServerInvoke = onSetSetting

	-- Gains passifs
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(Config.Game.PassiveTickRate)
			local now = os.clock()
			-- plafond : évite un énorme rattrapage après un gel du serveur
			local elapsed = math.min(now - last, 5)
			last = now
			for player, session in pairs(sessions) do
				local ok, err = pcall(passiveTick, player, session, elapsed)
				if not ok then
					warn("[GameService] Erreur du tick passif pour " .. player.Name .. " :", err)
				end
			end
		end
	end)

	-- Synchronisation vers les clients (toutes les Config.Game.SyncRate s) :
	--   - état COMPLET (StateUpdate) si quelque chose de structurel a changé
	--     (Dirty), ou toutes les FULL_REFRESH s si des valeurs secondaires
	--     (stats, temps d'écran...) ont bougé ;
	--   - sinon petit StateTick (Dopamine, ClickSeq, quêtes, coffre) si besoin.
	-- Avant : l'état complet (maison, quêtes, stats...) partait 5 fois par
	-- seconde dès qu'un gain passif existait (source de lag réseau / client).
	local FULL_REFRESH = 10
	local function countAchievements(data): number
		local count = 0
		for _, unlocked in pairs(data.Achievements) do
			if unlocked then
				count += 1
			end
		end
		return count
	end
	task.spawn(function()
		while true do
			task.wait(Config.Game.SyncRate)
			local now = os.clock()
			for player, session in pairs(sessions) do
				if session.Dirty or session.TickDirty or session.Stale then
					local ok, err = pcall(function()
						local data = services.DataService:GetData(player)
						if not data then
							return
						end
						-- Succès : un nouveau succès = état complet (médaille, bonus)
						services.AchievementService:Check(player)
						local achievements = countAchievements(data)
						if achievements ~= session.AchievementCount then
							if session.AchievementCount >= 0 then
								session.Dirty = true
							end
							session.AchievementCount = achievements
						end
						if session.TickDirty then
							session.Stale = true
						end
						if session.Dirty or (session.Stale and now - session.LastFull >= FULL_REFRESH) then
							self:SendState(player)
						elseif session.TickDirty then
							self:SendTick(player)
						end
					end)
					if not ok then
						session.Dirty = false
						session.TickDirty = false
						warn("[GameService] Erreur d'envoi de l'état pour " .. player.Name .. " :", err)
					end
				end
			end
		end
	end)

	-- Petit rappel dans la console du serveur
	print(string.format("[Dopamine Clicker] Serveur prêt (%d joueur(s))", #Players:GetPlayers()))
end

return GameService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="221">
        <Properties>
          <string name="Name">GardenService</string>
          <string name="Source"><![CDATA[--[[
	GardenService (ModuleScript)
	Emplacement : ServerScriptService > Services > GardenService

	🌻 Jardin de Dopamine (Config.Garden, Feature "Garden" ; remplace la bourse).
	  - Parterres : Config.Garden.BasePlots + niveau de l'amélioration
	    "Flower Beds" (Feature "GardenPlots") : Formulas.GetGardenPlotCount.
	  - Chaque parterre fait pousser une fleur tirée au hasard (Weight) ;
	    elle est prête GrowSeconds après avoir été plantée. Les dates sont
	    celles du SERVEUR (os.time) et sont gardées dans data.Garden.Plots :
	    le jardin pousse même quand on n'est pas là.
	  - RemoteFunction "Garden" :
	      "harvest", index  -> cueille UNE fleur (seulement si elle est prête)
	      "harvestAll"      -> cueille toutes les fleurs prêtes
	    Gain = RewardSeconds de production (Formulas.ScaledReward, au moins
	    MinReward), puis un nouveau bulbe est planté automatiquement.
	  - Envoyé au client par GetClientState :
	      Garden = { Plots = { { Flower, PlantedAt, ReadyAt } }, Now = os.time() }
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Locale = require(ReplicatedStorage.Shared.Locale)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Net = require(ReplicatedStorage.Shared.Net)
local RateLimiter = require(script.Parent.RateLimiter)

local GardenService = {}

local services
local random = Random.new()
local settings = Config.Garden

local MAX_PLOTS = 24 -- garde-fou (sauvegarde abîmée, configuration extrême)
local RARE_BROADCAST_WEIGHT = 3 -- fleurs au plus aussi rares que ça : annoncées au serveur

local flowersById = {}
for _, flower in ipairs(settings.Flowers) do
	flowersById[flower.Id] = flower
end

function GardenService:Init(allServices)
	services = allServices
end

local function isValidNumber(value: any): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

-- Tire une fleur au hasard selon son poids
local function pickFlower()
	local total = 0
	for _, flower in ipairs(settings.Flowers) do
		total += flower.Weight
	end
	local roll = random:NextNumber(0, total)
	for _, flower in ipairs(settings.Flowers) do
		roll -= flower.Weight
		if roll <= 0 then
			return flower
		end
	end
	return settings.Flowers[1]
end

local function plant(now: number)
	local flower = pickFlower()
	return { Flower = flower.Id, PlantedAt = now, ReadyAt = now + flower.GrowSeconds }
end

-- Nombre de parterres du joueur
local function plotCount(data): number
	return math.clamp(math.floor(Formulas.GetGardenPlotCount(data)), 1, MAX_PLOTS)
end

-- Répare data.Garden (types, fleurs retirées de la config, dates impossibles)
-- et ajuste le nombre de parterres. Ne fait rien sans la Feature.
local function sanitize(data)
	if type(data.Garden) ~= "table" then
		data.Garden = {}
	end
	local garden = data.Garden
	if type(garden.Plots) ~= "table" then
		garden.Plots = {}
	end
	if not Formulas.HasFeature(data, settings.Feature) then
		return
	end
	local now = os.time()
	local count = plotCount(data)
	local plots = garden.Plots
	-- Appelé à chaque état envoyé : on ne recrée un parterre que s'il est abîmé
	for index = 1, count do
		local plot = plots[index]
		local flower = type(plot) == "table" and flowersById[plot.Flower]
		if not flower or not isValidNumber(plot.PlantedAt) then
			plots[index] = plant(now)
		elseif plot.PlantedAt > now or plot.PlantedAt ~= math.floor(plot.PlantedAt) or plot.ReadyAt ~= plot.PlantedAt + flower.GrowSeconds then
			-- Date dans le futur (horloge d'un autre serveur) ou incohérente : recalculée
			local plantedAt = math.min(math.floor(plot.PlantedAt), now)
			plots[index] = { Flower = flower.Id, PlantedAt = plantedAt, ReadyAt = plantedAt + flower.GrowSeconds }
		end
	end
	-- Parterres en trop (après l'océan, "Flower Beds" repart de zéro) ou clés parasites
	for key in pairs(plots) do
		if type(key) ~= "number" or key < 1 or key > count or key ~= math.floor(key) then
			plots[key] = nil
		end
	end
end

-- Champs ajoutés à l'état envoyé au client (voir GameService:BuildState)
function GardenService:GetClientState(_player: Player, data)
	sanitize(data)
	-- (la table est copiée par le RemoteEvent : on peut l'envoyer telle quelle)
	local owned = Formulas.HasFeature(data, settings.Feature)
	return {
		Garden = { Plots = owned and data.Garden.Plots or {}, Now = os.time() },
	}
end

-- Texte dans la langue du joueur
local function T(player: Player, text: string, ...): string
	return services.GameService:T(player, text, ...)
end

local function formatWait(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

-- Cueille la fleur du parterre `index` (déjà vérifiée prête). Renvoie le gain.
local function harvestPlot(player: Player, data, index: number, stats, now: number)
	local plot = data.Garden.Plots[index]
	local flower = flowersById[plot.Flower]
	local minimum = (settings.MinReward or 0) * math.max(1, flower.RewardSeconds / 10)
	local amount = Formulas.ScaledReward(stats, flower.RewardSeconds, minimum)
	data.Garden.Plots[index] = plant(now)
	data.Stats.GardenHarvests = (tonumber(data.Stats.GardenHarvests) or 0) + 1
	services.GameService:AddDopamine(player, amount, true)
	return flower, amount
end

local function announceRare(player: Player, flower, amount: number)
	if flower.Weight > RARE_BROADCAST_WEIGHT then
		return
	end
	local displayName, formatted = player.DisplayName, NumberFormatter.Format(amount)
	services.GameService:NotifyAll(function(lang)
		return {
			Type = "Info",
			Text = Locale.TFor(lang, "🌸 %s picked a %s in their garden (+%s)!", displayName, Locale.TFor(lang, flower.Name), formatted),
		}
	end, player)
end

local function onGarden(player: Player, action: any, arg: any)
	if action ~= "harvest" and action ~= "harvestAll" then
		return false, T(player, "Invalid request")
	end
	local interval = action == "harvestAll" and 1 or math.max(0.05, (settings.HarvestCooldown or 0.3) - 0.1)
	if not RateLimiter.Check(player, "Garden_" .. action, interval) then
		return false, T(player, "Slow down!")
	end
	local data = services.DataService:GetData(player)
	if not data or not services.GameService:IsReady(player) then
		return false, T(player, "Loading...")
	end
	if not Formulas.HasFeature(data, settings.Feature) then
		return false, T(player, "The garden isn't unlocked yet")
	end
	sanitize(data)

	local now = os.time()
	local plots = data.Garden.Plots
	local stats = services.GameService:GetStats(player)

	if action == "harvest" then
		local index = tonumber(arg)
		if not index or index ~= math.floor(index) or index < 1 or index > #plots then
			return false, T(player, "Invalid request")
		end
		local plot = plots[index]
		if now < plot.ReadyAt then
			return false, T(player, "Still growing... ready in %s", formatWait(plot.ReadyAt - now))
		end
		local flower, amount = harvestPlot(player, data, index, stats, now)
		services.QuestService:Progress(player, "Harvest", 1)
		services.GameService:SendState(player)
		announceRare(player, flower, amount)
		return true, {
			Plot = index,
			Flower = flower.Id,
			Reward = amount,
			Harvested = { { Plot = index, Flower = flower.Id, Reward = amount } },
			Plots = data.Garden.Plots,
			Now = now,
		}
	end

	-- "harvestAll"
	local harvested = {}
	local total = 0
	for index, plot in ipairs(plots) do
		if now >= plot.ReadyAt then
			local flower, amount = harvestPlot(player, data, index, stats, now)
			total += amount
			table.insert(harvested, { Plot = index, Flower = flower.Id, Reward = amount })
			announceRare(player, flower, amount)
		end
	end
	if #harvested == 0 then
		return false, T(player, "Nothing is ready yet 🌱")
	end
	services.QuestService:Progress(player, "Harvest", #harvested)
	services.GameService:SendState(player)
	return true, {
		Reward = total,
		Harvested = harvested,
		Plots = data.Garden.Plots,
		Now = now,
	}
end

function GardenService:PlayerReady(_player: Player, data)
	sanitize(data)
end

function GardenService:Start()
	Net.Function("Garden").OnServerInvoke = onGarden
end

return GardenService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="222">
        <Properties>
          <string name="Name">HouseService</string>
          <string name="Source"><![CDATA[--[[
	HouseService (ModuleScript)
	Emplacement : ServerScriptService > Services > HouseService

	🏠 Ma maison (Config.House) : une maison de poupée à plusieurs pièces,
	gardée pour toujours (même après l'océan).
	  - la maison (taille) est une grille Floors x Columns de pièces ; on en
	    achète une plus grande avec la Dopamine ;
	  - chaque pièce a un type (salon, chambre, cuisine...), un emplacement
	    dans la grille (déplaçable), son papier peint, son sol et ses objets ;
	  - on achète des pièces (prix x RoomCostGrowth par pièce), des objets
	    (prix x CostGrowth par exemplaire), des papiers peints et des sols ;
	  - le client envoie la disposition des pièces ("saveLayout"), le
	    serveur vérifie TOUT (objets possédés toutes pièces confondues,
	    nombre max par pièce, zones mur/sol) ;
	  - le Confort des objets posés (x1,5 pour les objets "préférés" de leur
	    pièce : harmonie) donne un bonus sur TOUS les gains.

	Données : data.House = {
		Size = "Studio",
		OwnedSizes = { [id] = true }, OwnedWallpapers = { [id] = true }, OwnedFloors = { [id] = true },
		Items = { [itemId] = nombre possédé },
		Rooms = { { Id = "R1", Type = "Living", Slot = 1..MaxRooms, Wallpaper = id, Floor = id,
			Placed = { { I = itemId, X = 0..1, Y = 0..1, S = 0.6..1.6, Z = 0..999, F = true? }, ... } }, ... },
		NextRoom = 2, -- prochain numéro d'Id de pièce
		-- v9.1 🎨 personnalisation (Config.HouseLookKinds) :
		OwnedTrims / OwnedMoods / OwnedViews / OwnedFacades / OwnedRoofs /
		OwnedRoofStyles / OwnedGarden = { [id] = true },
		Facade = id, Roof = id, RoofStyle = id, -- extérieur
		Garden = { id, ... }, -- déco du jardin affichée (GardenSlots max)
	}
	Chaque pièce a aussi Trim (boiseries), Mood (ambiance) et View (vue par la
	fenêtre) ; un objet posé peut avoir C = couleur (Config.House.Tints ;
	les couleurs verrouillées par les visites à l'océan sont retirées).
	Anciennes sauvegardes : tout ce qui manque prend la 1re entrée (gratuite).
	F (facultatif) = objet retourné gauche <-> droite (chaise tournée vers la
	table...). Petits objets posés SUR un meuble : Formulas.CanGoOnFurniture
	(Y jusqu'à Config.House.TabletopMinY), même règle que l'éditeur.
	Emplacement (Slot) : (étage - 1) x Columns + colonne ; étage 1 = rez-de-chaussée.
	Les anciennes sauvegardes (une seule pièce : Wallpaper / Floor / Placed)
	deviennent un salon.
	Stats : HouseItemsBought, HouseComfort (meilleur confort atteint).

	RemoteFunction House (action, argument) -> (succès, message) :
	  "buyItem" itemId | "buySize" sizeId | "setSize" sizeId
	  "buyRoom" typeId | { Type, Slot? }
	  "moveRoom" { Room, Slot }   (échange si l'emplacement est pris)
	  "setRoomType" { Room, Type }
	  "buyWallpaper" / "setWallpaper" / "buyFloor" / "setFloor" { Room, Id } (ou Id seul = 1re pièce)
	  "saveLayout" { Rooms = { [roomId] = { { I, X, Y, S, Z, F?, C? }, ... } } }  (ou { Room, Placed })
	  "buyLook" { Kind, Id, Room? }  achète (et applique) une personnalisation
	  "setLook" { Kind, Id, Room?, On? }  applique une personnalisation possédée
	    (Kind "Garden" : On = true / false pose / range la déco du jardin)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Net = require(ReplicatedStorage.Shared.Net)
local RateLimiter = require(script.Parent.RateLimiter)

local HouseService = {}

local services

local HOUSE = Config.House
local DEFAULT_SIZE = HOUSE.Sizes[1].Id
local DEFAULT_WALLPAPER = HOUSE.Wallpapers[1].Id
local DEFAULT_FLOOR = HOUSE.Floors[1].Id

local DEFAULT_ROOM_TYPE = HOUSE.RoomTypes[1].Id
local ROOM_LOOKS = { "Trim", "Mood", "View" }

local MAX_ID_LENGTH = 64
local MAX_ROOM_ID_LENGTH = 16
local BUY_INTERVAL = 0.1 -- secondes entre deux achats / changements
local LAYOUT_INTERVAL = 0.5 -- secondes entre deux sauvegardes de disposition
local MIN_SCALE, MAX_SCALE = 0.6, 1.6
local MAX_Z = 999
-- Zones : objets "Wall" en haut (Y <= WallRatio), objets "Floor" en bas
-- (Y >= WallRatio x 0.85 : un peu de marge pour les objets posés contre le mur)
local WALL_MAX_Y = HOUSE.WallRatio
local FLOOR_MIN_Y = HOUSE.WallRatio * 0.85

----------------------------------------------------------------------
-- Utilitaires
----------------------------------------------------------------------

local function isValidNumber(value): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

-- Arrondi (sauvegarde plus légère)
local function round(value: number, step: number): number
	return math.floor(value / step + 0.5) * step
end

local LOOK_KINDS = Config.HouseLookKinds
local GARDEN_SLOTS = HOUSE.GardenSlots or 6

local function numberOr(value, default: number): number
	if isValidNumber(value) then
		return value
	end
	return default
end

-- Texte dans la langue du joueur
local function T(player: Player, text: string, ...): string
	return services.GameService:T(player, text, ...)
end

-- Un objet posé, corrigé : coordonnées bornées, dans la bonne zone.
-- F = true : dessin retourné (miroir gauche <-> droite), absent sinon.
-- Couleur d'un objet posé : id connu et débloqué (visites à l'océan), sinon nil
local function tintOf(entry, rebirths: number): string?
	local id = entry.C
	if type(id) ~= "string" or #id > MAX_ID_LENGTH then
		return nil
	end
	local tint = Config.HouseTintsById[id]
	if not tint or Formulas.GetHouseRequiredRebirths(tint) > rebirths then
		return nil
	end
	return id
end

local function normalizeEntry(entry, item, rebirths: number?)
	local minY, maxY = FLOOR_MIN_Y, 1
	if item.Placement == "Wall" then
		minY, maxY = 0, WALL_MAX_Y
	else
		-- Petit objet qui peut être posé SUR un meuble (table, étagère, lit...) :
		-- il peut monter plus haut que le sol (même règle que le client)
		minY = math.min(FLOOR_MIN_Y, Formulas.GetHouseFloorMinY(item))
	end
	local x = math.clamp(numberOr(entry.X, 0.5), 0, 1)
	local y = math.clamp(numberOr(entry.Y, (minY + maxY) / 2), minY, maxY)
	local s = math.clamp(numberOr(entry.S, 1), MIN_SCALE, MAX_SCALE)
	local z = math.clamp(math.floor(numberOr(entry.Z, 0)), 0, MAX_Z)
	return {
		I = item.Id,
		X = round(x, 0.0001),
		Y = math.clamp(round(y, 0.0001), minY, maxY),
		S = math.clamp(round(s, 0.001), MIN_SCALE, MAX_SCALE),
		Z = z,
		F = entry.F == true or nil,
		C = tintOf(entry, rebirths or 0),
	}
end

-- Garde les `maxItems` premiers objets posés d'une pièce ; renvoie le nombre rangé
local function trimPlaced(room, maxItems: number): number
	local removed = 0
	while #room.Placed > maxItems do
		table.remove(room.Placed)
		removed += 1
	end
	return removed
end

-- Changement de taille : les objets gardent leur place "en px" autour du
-- centre de la pièce (la déco ne s'étire pas dans une maison plus grande).
-- Si la déco ne tient pas dans la nouvelle largeur, on la resserre à la place.
local LAYOUT_MARGIN = 0.05 -- marge gauche / droite (fraction de la largeur)
local function refitLayout(room, oldSize, newSize)
	local oldWidth = tonumber(oldSize and oldSize.Width) or 1
	local newWidth = tonumber(newSize and newSize.Width) or 1
	if oldWidth <= 0 or newWidth <= 0 or oldWidth == newWidth or #room.Placed == 0 then
		return
	end
	-- Étendue actuelle de la déco (en largeurs de "studio")
	local minX, maxX = math.huge, -math.huge
	for _, entry in ipairs(room.Placed) do
		local px = (entry.X - 0.5) * oldWidth
		minX = math.min(minX, px)
		maxX = math.max(maxX, px)
	end
	local half = (0.5 - LAYOUT_MARGIN) * newWidth
	local factor = 1
	local spread = math.max(-minX, maxX)
	if spread > half and spread > 0 then
		factor = half / spread -- trop large : on resserre autour du centre
	end
	for _, entry in ipairs(room.Placed) do
		local px = (entry.X - 0.5) * oldWidth * factor
		entry.X = round(math.clamp(0.5 + px / newWidth, 0, 1), 0.0001)
	end
end

----------------------------------------------------------------------
-- Pièces
----------------------------------------------------------------------

-- Emplacement -> (étage, colonne) et inverse, pour une grille de `columns`
local function slotToCell(slot: number, columns: number): (number, number)
	return math.floor((slot - 1) / columns) + 1, (slot - 1) % columns + 1
end

local function cellToSlot(floor: number, column: number, columns: number): number
	return (floor - 1) * columns + column
end

local function findRoom(house, roomId: any)
	if type(roomId) ~= "string" then
		return nil
	end
	for _, room in ipairs(house.Rooms) do
		if room.Id == roomId then
			return room
		end
	end
	return nil
end

local function roomAtSlot(house, slot: number)
	for _, room in ipairs(house.Rooms) do
		if room.Slot == slot then
			return room
		end
	end
	return nil
end

-- Premier emplacement libre (rez-de-chaussée d'abord), nil si la maison est pleine
local function firstFreeSlot(house, maxRooms: number): number?
	for slot = 1, maxRooms do
		if not roomAtSlot(house, slot) then
			return slot
		end
	end
	return nil
end

-- Style de départ d'une pièce : celui du type s'il est possédé, sinon le 1er
local function defaultStyles(house, roomType): (string, string)
	local wallpaper = roomType.Wallpaper
	if type(wallpaper) ~= "string" or not house.OwnedWallpapers[wallpaper] then
		wallpaper = DEFAULT_WALLPAPER
	end
	local floor = roomType.Floor
	if type(floor) ~= "string" or not house.OwnedFloors[floor] then
		floor = DEFAULT_FLOOR
	end
	return wallpaper, floor
end

local function newRoom(house, typeId: string, slot: number)
	local roomType = Formulas.GetRoomType(typeId)
	local id = "R" .. tostring(house.NextRoom)
	house.NextRoom += 1
	local wallpaper, floor = defaultStyles(house, roomType)
	return { Id = id, Type = roomType.Id, Slot = slot, Wallpaper = wallpaper, Floor = floor,
		Trim = HOUSE.Trims[1].Id, Mood = HOUSE.Moods[1].Id, View = HOUSE.Views[1].Id, Placed = {} }
end

-- Déménagement : chaque pièce garde son étage / sa colonne si possible,
-- sinon elle prend le premier emplacement libre ; la déco est recalée pour
-- la nouvelle largeur de pièce et les objets en trop sont rangés.
local function refitRooms(house, oldSize, newSize): number
	local stored = 0
	local taken = {}
	local pending = {}
	for _, room in ipairs(house.Rooms) do
		local floor, column = slotToCell(room.Slot, oldSize.Columns)
		if floor <= newSize.Floors and column <= newSize.Columns then
			local slot = cellToSlot(floor, column, newSize.Columns)
			if not taken[slot] then
				taken[slot] = true
				room.Slot = slot
			else
				table.insert(pending, room)
			end
		else
			table.insert(pending, room)
		end
	end
	for _, room in ipairs(pending) do
		for slot = 1, newSize.MaxRooms do
			if not taken[slot] then
				taken[slot] = true
				room.Slot = slot
				break
			end
		end
	end
	for _, room in ipairs(house.Rooms) do
		refitLayout(room, oldSize, newSize)
		stored += trimPlaced(room, newSize.RoomItems)
	end
	return stored
end

-- Met à jour le meilleur confort atteint (stat)
local function updateComfortStat(data)
	local comfort = Formulas.GetHouseComfort(data)
	local stats = data.Stats
	if not isValidNumber(stats.HouseComfort) or comfort > stats.HouseComfort then
		stats.HouseComfort = comfort
	end
end

-- Garde seulement les ids connus (valeur true) d'une table { [id] = true }
local function cleanOwnedMap(map, lookup)
	local clean = {}
	if type(map) == "table" then
		for id, value in pairs(map) do
			if value == true and type(id) == "string" and lookup[id] then
				clean[id] = true
			end
		end
	end
	return clean
end

-- Objets posés d'une pièce, corrigés : connus, pas plus que possédés
-- (`used` compte les exemplaires déjà posés dans les autres pièces), au
-- plus `maxItems`
local function cleanPlaced(list, owned, used, maxItems: number, rebirths: number)
	local placed = {}
	if type(list) ~= "table" then
		return placed
	end
	for _, entry in ipairs(list) do
		if #placed >= maxItems then
			break
		end
		local id = type(entry) == "table" and entry.I or nil
		local item = type(id) == "string" and Config.HouseItemsById[id] or nil
		if item and (used[id] or 0) < (owned[id] or 0) then
			used[id] = (used[id] or 0) + 1
			table.insert(placed, normalizeEntry(entry, item, rebirths))
		end
	end
	return placed
end

-- Corrige une sauvegarde abîmée ou devenue incohérente avec la config
-- (et transforme l'ancienne maison à une pièce en maison à pièces)
local function sanitizeHouse(data)
	local house = data.House

	house.OwnedSizes = cleanOwnedMap(house.OwnedSizes, Config.HouseSizesById)
	house.OwnedSizes[DEFAULT_SIZE] = true
	house.OwnedWallpapers = cleanOwnedMap(house.OwnedWallpapers, Config.HouseWallpapersById)
	house.OwnedWallpapers[DEFAULT_WALLPAPER] = true
	house.OwnedFloors = cleanOwnedMap(house.OwnedFloors, Config.HouseFloorsById)
	house.OwnedFloors[DEFAULT_FLOOR] = true

	if type(house.Size) ~= "string" or not house.OwnedSizes[house.Size] then
		house.Size = DEFAULT_SIZE
	end
	local rebirths = numberOr(data.Rebirths, 0)

	-- (v9.1) Personnalisation : entrées connues, la 1re gratuite toujours possédée
	for _, def in pairs(LOOK_KINDS) do
		local owned = cleanOwnedMap(house[def.Owned], def.ById)
		if def.Scope ~= "Garden" then
			owned[def.List[1].Id] = true
		end
		house[def.Owned] = owned
		if def.Scope == "House" then
			local value = house[def.Field]
			if type(value) ~= "string" or not owned[value] then
				house[def.Field] = def.List[1].Id
			end
		elseif def.Scope == "Garden" then
			local garden, seen = {}, {}
			if type(house.Garden) == "table" then
				for _, id in ipairs(house.Garden) do
					if #garden >= GARDEN_SLOTS then
						break
					end
					if type(id) == "string" and owned[id] and not seen[id] then
						seen[id] = true
						table.insert(garden, id)
					end
				end
			end
			house.Garden = garden
		end
	end

	-- Objets possédés : nombres entiers > 0, jamais plus que MaxOwned
	local items = {}
	if type(house.Items) == "table" then
		for id, count in pairs(house.Items) do
			local item = type(id) == "string" and Config.HouseItemsById[id] or nil
			if item and isValidNumber(count) and count >= 1 then
				local n = math.floor(count)
				if item.MaxOwned then
					n = math.min(n, item.MaxOwned)
				end
				items[id] = n
			end
		end
	end
	house.Items = items

	-- Ancienne sauvegarde (une seule pièce) -> un salon
	if type(house.Rooms) ~= "table" or #house.Rooms == 0 then
		house.Rooms = {
			{
				Id = "R1",
				Type = DEFAULT_ROOM_TYPE,
				Slot = 1,
				Wallpaper = house.Wallpaper,
				Floor = house.Floor,
				Placed = house.Placed,
			},
		}
	end
	house.Wallpaper = nil
	house.Floor = nil
	house.Placed = nil

	-- Trop de pièces pour la maison actuelle (sauvegarde abîmée) : on prend
	-- la plus petite maison possédée où elles tiennent
	local size = Formulas.GetHouseSize(data)
	if #house.Rooms > size.MaxRooms then
		for _, candidate in ipairs(HOUSE.Sizes) do
			if house.OwnedSizes[candidate.Id] and candidate.MaxRooms >= #house.Rooms then
				house.Size = candidate.Id
				size = candidate
				break
			end
		end
	end

	-- Pièces : Id unique, type connu, emplacement unique dans la grille,
	-- styles possédés, objets vérifiés (toutes pièces confondues)
	local rooms, ids, slots, used = {}, {}, {}, {}
	local highest = 0
	for _, raw in ipairs(house.Rooms) do
		if #rooms >= size.MaxRooms then
			break
		end
		if type(raw) == "table" then
			local id = raw.Id
			if type(id) ~= "string" or #id == 0 or #id > MAX_ROOM_ID_LENGTH or ids[id] then
				id = nil
			end
			local slot = raw.Slot
			if not isValidNumber(slot) or slot % 1 ~= 0 or slot < 1 or slot > size.MaxRooms or slots[slot] then
				slot = nil
			end
			local roomType = Formulas.GetRoomType(raw.Type)
			local fallbackWallpaper, fallbackFloor = defaultStyles(house, roomType)
			local room = {
				Id = id or "",
				Type = roomType.Id,
				Slot = slot or 0,
				Wallpaper = (type(raw.Wallpaper) == "string" and house.OwnedWallpapers[raw.Wallpaper]) and raw.Wallpaper
					or fallbackWallpaper,
				Floor = (type(raw.Floor) == "string" and house.OwnedFloors[raw.Floor]) and raw.Floor or fallbackFloor,
				Placed = cleanPlaced(raw.Placed, items, used, size.RoomItems, rebirths),
			}
			-- (v9.1) boiseries / ambiance / vue : possédées, sinon la 1re (gratuite)
			for _, kind in ipairs(ROOM_LOOKS) do
				local def = LOOK_KINDS[kind]
				local value = raw[def.Field]
				room[def.Field] = (type(value) == "string" and house[def.Owned][value]) and value or def.List[1].Id
			end
			if id then
				ids[id] = true
				local number = tonumber(string.match(id, "^R(%d+)$"))
				if number then
					highest = math.max(highest, number)
				end
			end
			if slot then
				slots[slot] = true
			end
			table.insert(rooms, room)
		end
	end
	if #rooms == 0 then
		table.insert(rooms, { Id = "R1", Type = DEFAULT_ROOM_TYPE, Slot = 1, Wallpaper = DEFAULT_WALLPAPER, Floor = DEFAULT_FLOOR,
			Trim = HOUSE.Trims[1].Id, Mood = HOUSE.Moods[1].Id, View = HOUSE.Views[1].Id, Placed = {} })
		highest = 1
	end
	if not isValidNumber(house.NextRoom) or house.NextRoom <= highest then
		house.NextRoom = highest + 1
	end
	house.NextRoom = math.floor(house.NextRoom)
	for _, room in ipairs(rooms) do
		if room.Id == "" then
			room.Id = "R" .. tostring(house.NextRoom)
			house.NextRoom += 1
		end
		if room.Slot == 0 then
			for slot = 1, size.MaxRooms do
				if not slots[slot] then
					slots[slot] = true
					room.Slot = slot
					break
				end
			end
		end
	end
	house.Rooms = rooms

	if not isValidNumber(data.Stats.HouseItemsBought) or data.Stats.HouseItemsBought < 0 then
		data.Stats.HouseItemsBought = 0
	end
	updateComfortStat(data)
end

----------------------------------------------------------------------
-- API utilisée par les autres services
----------------------------------------------------------------------

function HouseService:Init(allServices)
	services = allServices
end

-- Confort actuel (objets posés)
function HouseService:GetComfort(player: Player): number
	local data = services.DataService:GetData(player)
	if not data then
		return 0
	end
	return Formulas.GetHouseComfort(data)
end

-- Multiplicateur de gains de la maison (1 = aucun bonus)
function HouseService:GetBonus(player: Player): number
	return Formulas.GetHouseBonus(self:GetComfort(player))
end

-- Commande de test /house (Studio) : toutes les tailles, papiers peints,
-- sols, et au moins un exemplaire de chaque objet
function HouseService:DebugGrantAll(player: Player): boolean
	local data = services.DataService:GetData(player)
	if not data then
		return false
	end
	local house = data.House
	for _, size in ipairs(HOUSE.Sizes) do
		house.OwnedSizes[size.Id] = true
	end
	for _, wallpaper in ipairs(HOUSE.Wallpapers) do
		house.OwnedWallpapers[wallpaper.Id] = true
	end
	for _, floor in ipairs(HOUSE.Floors) do
		house.OwnedFloors[floor.Id] = true
	end
	for _, item in ipairs(HOUSE.Items) do
		house.Items[item.Id] = math.max(house.Items[item.Id] or 0, 1)
	end
	for _, def in pairs(LOOK_KINDS) do
		for _, entry in ipairs(def.List) do
			house[def.Owned][entry.Id] = true
		end
	end
	-- La plus grande maison, avec une pièce de chaque type (gratuit)
	local biggest = HOUSE.Sizes[#HOUSE.Sizes]
	refitRooms(house, Formulas.GetHouseSize(data), biggest)
	house.Size = biggest.Id
	for _, roomType in ipairs(HOUSE.RoomTypes) do
		local slot = firstFreeSlot(house, biggest.MaxRooms)
		if not slot then
			break
		end
		local exists = false
		for _, room in ipairs(house.Rooms) do
			if room.Type == roomType.Id then
				exists = true
				break
			end
		end
		if not exists then
			table.insert(house.Rooms, newRoom(house, roomType.Id, slot))
		end
	end
	updateComfortStat(data)
	services.GameService:SendState(player)
	return true
end

----------------------------------------------------------------------
-- Actions (RemoteFunction House)
----------------------------------------------------------------------

local function buyItem(player: Player, data, itemId: string): (boolean, string)
	local item = Config.HouseItemsById[itemId]
	if not item then
		return false, T(player, "Unknown house item")
	end
	local house = data.House
	local owned = house.Items[itemId] or 0
	local name = T(player, item.Name)
	if item.MaxOwned and owned >= item.MaxOwned then
		return false, T(player, "You can't have more %s %s", item.Icon, name)
	end
	if not Formulas.IsHouseEntryUnlocked(data, item) then
		return false, T(player, "🔒 Unlocked after %d visits to the ocean", Formulas.GetHouseRequiredRebirths(item))
	end
	local price = Formulas.GetHouseItemPrice(item, owned)
	if not isValidNumber(price) or price < 0 or data.Dopamine < price then
		return false, T(player, "Not enough %s", Config.Game.CurrencyName)
	end
	data.Dopamine -= price
	house.Items[itemId] = owned + 1
	data.Stats.HouseItemsBought += 1
	services.GameService:SendState(player)
	return true, T(player, "%s %s added to your house! (%s)", item.Icon, name, NumberFormatter.Format(price))
end

-- Emménage dans une taille possédée (les pièces gardent leur place si possible)
local function moveInto(player: Player, data, size): (boolean, string)
	local house = data.House
	if #house.Rooms > size.MaxRooms then
		return false, T(player, "Too many rooms for this house (max %d)", size.MaxRooms)
	end
	local stored = refitRooms(house, Formulas.GetHouseSize(data), size)
	house.Size = size.Id
	updateComfortStat(data)
	services.GameService:SendState(player)
	local name = T(player, size.Name)
	if stored > 0 then
		return true, T(player, "%s Welcome to your %s! (%d items stored)", size.Icon, name, stored)
	end
	return true, T(player, "%s Welcome to your %s!", size.Icon, name)
end

local function buySize(player: Player, data, sizeId: string): (boolean, string)
	local size = Config.HouseSizesById[sizeId]
	if not size then
		return false, T(player, "Unknown house size")
	end
	local house = data.House
	if house.OwnedSizes[sizeId] then
		return false, T(player, "You already own this house")
	end
	if not Formulas.IsHouseEntryUnlocked(data, size) then
		return false, T(player, "🔒 Unlocked after %d visits to the ocean", Formulas.GetHouseRequiredRebirths(size))
	end
	if not isValidNumber(size.Cost) or size.Cost < 0 or data.Dopamine < size.Cost then
		return false, T(player, "Not enough %s", Config.Game.CurrencyName)
	end
	data.Dopamine -= size.Cost
	house.OwnedSizes[sizeId] = true
	-- On emménage tout de suite si la nouvelle maison est plus grande
	local current = Formulas.GetHouseSize(data)
	if size.Order > current.Order and #house.Rooms <= size.MaxRooms then
		refitRooms(house, current, size)
		house.Size = sizeId
		updateComfortStat(data)
	end
	services.GameService:SendState(player)
	return true, T(player, "%s %s unlocked! (%s)", size.Icon, T(player, size.Name), NumberFormatter.Format(size.Cost))
end

local function setSize(player: Player, data, sizeId: string): (boolean, string)
	local size = Config.HouseSizesById[sizeId]
	if not size then
		return false, T(player, "Unknown house size")
	end
	if not data.House.OwnedSizes[sizeId] then
		return false, T(player, "You don't own this house yet")
	end
	return moveInto(player, data, size)
end

-- Nouvelle pièce (argument : typeId, ou { Type, Slot? })
local function buyRoom(player: Player, data, argument: any): (boolean, string)
	local typeId, wantedSlot = argument, nil
	if type(argument) == "table" then
		typeId, wantedSlot = argument.Type, argument.Slot
	end
	if type(typeId) ~= "string" or not Config.HouseRoomTypesById[typeId] then
		return false, T(player, "Unknown room type")
	end
	local house = data.House
	local size = Formulas.GetHouseSize(data)
	if #house.Rooms >= size.MaxRooms then
		return false, T(player, "Your house is full: move to a bigger house!")
	end
	local slot: number? = nil
	if wantedSlot ~= nil then
		if not isValidNumber(wantedSlot) or wantedSlot % 1 ~= 0 or wantedSlot < 1 or wantedSlot > size.MaxRooms then
			return false, T(player, "Invalid request")
		end
		if roomAtSlot(house, wantedSlot) then
			return false, T(player, "This spot is already taken")
		end
		slot = wantedSlot
	else
		slot = firstFreeSlot(house, size.MaxRooms)
	end
	if not slot then
		return false, T(player, "Your house is full: move to a bigger house!")
	end
	local price = Formulas.GetRoomCost(#house.Rooms)
	if not isValidNumber(price) or price < 0 or data.Dopamine < price then
		return false, T(player, "Not enough %s", Config.Game.CurrencyName)
	end
	data.Dopamine -= price
	local room = newRoom(house, typeId, slot)
	table.insert(house.Rooms, room)
	services.GameService:SendState(player)
	local roomType = Formulas.GetRoomType(typeId)
	return true, T(player, "%s New room: %s! (%s)", roomType.Icon, T(player, roomType.Name), NumberFormatter.Format(price))
end

-- Déplace une pièce dans la grille (échange avec la pièce déjà là)
local function moveRoom(player: Player, data, argument: any): (boolean, string)
	if type(argument) ~= "table" then
		return false, T(player, "Invalid request")
	end
	local house = data.House
	local room = findRoom(house, argument.Room)
	local slot = argument.Slot
	local size = Formulas.GetHouseSize(data)
	if not room or not isValidNumber(slot) or slot % 1 ~= 0 or slot < 1 or slot > size.MaxRooms then
		return false, T(player, "Invalid request")
	end
	if room.Slot == slot then
		return true, T(player, "🏠 Room moved")
	end
	local other = roomAtSlot(house, slot)
	if other then
		other.Slot = room.Slot
	end
	room.Slot = slot
	services.GameService:SendState(player)
	return true, T(player, "🏠 Room moved")
end

-- Change le type d'une pièce (gratuit ; les objets restent)
local function setRoomType(player: Player, data, argument: any): (boolean, string)
	if type(argument) ~= "table" then
		return false, T(player, "Invalid request")
	end
	local room = findRoom(data.House, argument.Room)
	local typeId = argument.Type
	if not room or type(typeId) ~= "string" or not Config.HouseRoomTypesById[typeId] then
		return false, T(player, "Invalid request")
	end
	room.Type = typeId
	updateComfortStat(data)
	services.GameService:SendState(player)
	local roomType = Formulas.GetRoomType(typeId)
	return true, T(player, "%s This room is now: %s", roomType.Icon, T(player, roomType.Name))
end

-- Papier peint et sol : même logique (kind = "Wallpaper" | "Floor")
local SKINS = {
	Wallpaper = {
		Lookup = Config.HouseWallpapersById,
		OwnedKey = "OwnedWallpapers",
		Unknown = "Unknown wallpaper",
		AlreadyOwned = "You already own this wallpaper",
		NotOwned = "You don't own this wallpaper",
		Bought = "🎨 %s %s wallpaper bought! (%s)",
		Applied = "🎨 %s %s wallpaper applied",
	},
	Floor = {
		Lookup = Config.HouseFloorsById,
		OwnedKey = "OwnedFloors",
		Unknown = "Unknown floor",
		AlreadyOwned = "You already own this floor",
		NotOwned = "You don't own this floor",
		Bought = "🧱 %s %s floor bought! (%s)",
		Applied = "🧱 %s %s floor applied",
	},
}

-- Argument d'un style : { Room, Id } (ou Id seul = 1re pièce)
local function skinTarget(house, argument: any): (any, any)
	if type(argument) == "string" then
		return house.Rooms[1], argument
	end
	if type(argument) == "table" and type(argument.Id) == "string" and #argument.Id <= MAX_ID_LENGTH then
		return findRoom(house, argument.Room), argument.Id
	end
	return nil, nil
end

local function buySkin(player: Player, data, kind: string, argument: any): (boolean, string)
	local skin = SKINS[kind]
	local house = data.House
	local room, id = skinTarget(house, argument)
	if not room or not id then
		return false, T(player, "Invalid request")
	end
	local entry = skin.Lookup[id]
	if not entry then
		return false, T(player, skin.Unknown)
	end
	local owned = house[skin.OwnedKey]
	if owned[id] then
		return false, T(player, skin.AlreadyOwned)
	end
	if not Formulas.IsHouseEntryUnlocked(data, entry) then
		return false, T(player, "🔒 Unlocked after %d visits to the ocean", Formulas.GetHouseRequiredRebirths(entry))
	end
	if not isValidNumber(entry.Cost) or entry.Cost < 0 or data.Dopamine < entry.Cost then
		return false, T(player, "Not enough %s", Config.Game.CurrencyName)
	end
	data.Dopamine -= entry.Cost
	owned[id] = true
	room[kind] = id -- appliqué tout de suite à la pièce
	services.GameService:SendState(player)
	return true, T(player, skin.Bought, entry.Icon or "", T(player, entry.Name), NumberFormatter.Format(entry.Cost))
end

local function setSkin(player: Player, data, kind: string, argument: any): (boolean, string)
	local skin = SKINS[kind]
	local house = data.House
	local room, id = skinTarget(house, argument)
	if not room or not id then
		return false, T(player, "Invalid request")
	end
	local entry = skin.Lookup[id]
	if not entry then
		return false, T(player, skin.Unknown)
	end
	if not house[skin.OwnedKey][id] then
		return false, T(player, skin.NotOwned)
	end
	room[kind] = id
	services.GameService:SendState(player)
	return true, T(player, skin.Applied, entry.Icon or "", T(player, entry.Name))
end

-- Vérifie une liste d'objets posés venue du client (vraie liste 1..n)
local function readPlacedList(player: Player, list: any, maxItems: number, rebirths: number): ({ any }?, string?)
	if type(list) ~= "table" then
		return nil, T(player, "Invalid request")
	end
	local count = 0
	for key in pairs(list) do
		count += 1
		if count > maxItems then
			return nil, T(player, "Too many items in this room (max %d)", maxItems)
		end
		if type(key) ~= "number" or key % 1 ~= 0 or key < 1 then
			return nil, T(player, "Invalid request")
		end
	end
	local result = {}
	for index = 1, count do
		local entry = list[index]
		if type(entry) ~= "table" then
			return nil, T(player, "Invalid request")
		end
		local id = entry.I
		if type(id) ~= "string" or #id > MAX_ID_LENGTH then
			return nil, T(player, "Invalid request")
		end
		local item = Config.HouseItemsById[id]
		if not item then
			return nil, T(player, "Unknown house item")
		end
		table.insert(result, normalizeEntry(entry, item, rebirths))
	end
	return result, nil
end

-- Nouvelle disposition de une ou plusieurs pièces (déplacer un objet d'une
-- pièce à l'autre = les deux pièces dans le même envoi). Tout est vérifié,
-- puis les listes REMPLACENT les anciennes.
local function saveLayout(player: Player, data, argument: any): (boolean, string)
	if type(argument) ~= "table" then
		return false, T(player, "Invalid request")
	end
	local house = data.House
	local size = Formulas.GetHouseSize(data)
	local lists = argument.Rooms
	if lists == nil and argument.Room ~= nil then
		lists = { [argument.Room] = argument.Placed }
	end
	if type(lists) ~= "table" then
		return false, T(player, "Invalid request")
	end

	local updates = {}
	local count = 0
	for roomId, list in pairs(lists) do
		count += 1
		if count > size.MaxRooms then
			return false, T(player, "Invalid request")
		end
		local room = findRoom(house, roomId)
		if not room then
			return false, T(player, "Unknown room")
		end
		local placed, message = readPlacedList(player, list, size.RoomItems, numberOr(data.Rebirths, 0))
		if not placed then
			return false, message or T(player, "Invalid request")
		end
		updates[room] = placed
	end

	-- Exemplaires posés, toutes pièces confondues (nouvelles listes comprises)
	local used = {}
	for _, room in ipairs(house.Rooms) do
		for _, entry in ipairs(updates[room] or room.Placed) do
			used[entry.I] = (used[entry.I] or 0) + 1
		end
	end
	for id, n in pairs(used) do
		if n > (house.Items[id] or 0) then
			local item = Config.HouseItemsById[id]
			return false, T(player, "You don't own enough %s %s", item.Icon, T(player, item.Name))
		end
	end

	for room, placed in pairs(updates) do
		room.Placed = placed
	end
	updateComfortStat(data)
	services.GameService:SendState(player)
	return true, T(player, "🏠 Layout saved")
end

----------------------------------------------------------------------
-- (v9.1) Personnalisation : boiseries, ambiance, vue (par pièce), façade,
-- toit, motif du toit (maison), déco du jardin (liste)
----------------------------------------------------------------------

-- Argument { Kind, Id, Room?, On? } -> (définition du genre, entrée, pièce?)
local function lookTarget(house, argument: any)
	if type(argument) ~= "table" or type(argument.Kind) ~= "string" or type(argument.Id) ~= "string"
		or #argument.Id > MAX_ID_LENGTH then
		return nil, nil, nil
	end
	local def = LOOK_KINDS[argument.Kind]
	if not def then
		return nil, nil, nil
	end
	local entry = def.ById[argument.Id]
	local room = nil
	if def.Scope == "Room" then
		room = if argument.Room == nil then house.Rooms[1] else findRoom(house, argument.Room)
	end
	return def, entry, room
end

-- Applique une entrée possédée ; Garden : On (défaut true) pose / range
local function applyLook(player: Player, house, def, entry, room, on: boolean): (boolean, string?)
	if def.Scope == "Room" then
		room[def.Field] = entry.Id
	elseif def.Scope == "House" then
		house[def.Field] = entry.Id
	else
		local index = table.find(house.Garden, entry.Id)
		if on and not index then
			if #house.Garden >= GARDEN_SLOTS then
				return false, T(player, "Your garden is full (max %d): put something away first", GARDEN_SLOTS)
			end
			table.insert(house.Garden, entry.Id)
		elseif not on and index then
			table.remove(house.Garden, index)
		end
	end
	return true, nil
end

local function buyLook(player: Player, data, argument: any): (boolean, string)
	local house = data.House
	local def, entry, room = lookTarget(house, argument)
	if not def then
		return false, T(player, "Invalid request")
	end
	if not entry then
		return false, T(player, "Unknown style")
	end
	if def.Scope == "Room" and not room then
		return false, T(player, "Unknown room")
	end
	local owned = house[def.Owned]
	if owned[entry.Id] then
		return false, T(player, "You already own this style")
	end
	if not Formulas.IsHouseEntryUnlocked(data, entry) then
		return false, T(player, "🔒 Unlocked after %d visits to the ocean", Formulas.GetHouseRequiredRebirths(entry))
	end
	local cost = entry.Cost
	if not isValidNumber(cost) or cost < 0 or data.Dopamine < cost then
		return false, T(player, "Not enough %s", Config.Game.CurrencyName)
	end
	data.Dopamine -= cost
	owned[entry.Id] = true
	-- appliqué tout de suite (jardin plein : acheté quand même, rangé)
	applyLook(player, house, def, entry, room, true)
	services.GameService:SendState(player)
	return true, T(player, "🎨 %s %s is yours! (%s)", entry.Icon or "", T(player, entry.Name), NumberFormatter.Format(cost))
end

local function setLook(player: Player, data, argument: any): (boolean, string)
	local house = data.House
	local def, entry, room = lookTarget(house, argument)
	if not def then
		return false, T(player, "Invalid request")
	end
	if not entry then
		return false, T(player, "Unknown style")
	end
	if def.Scope == "Room" and not room then
		return false, T(player, "Unknown room")
	end
	if not house[def.Owned][entry.Id] then
		return false, T(player, "You don't own this style yet")
	end
	local ok, message = applyLook(player, house, def, entry, room, argument.On ~= false)
	if not ok then
		return false, message or T(player, "Invalid request")
	end
	services.GameService:SendState(player)
	return true, T(player, "🎨 %s %s applied", entry.Icon or "", T(player, entry.Name))
end

local STRING_ACTIONS = { buyItem = true, buySize = true, setSize = true }

local function onHouse(player: Player, action: any, argument: any)
	if type(action) ~= "string" or #action > 32 then
		return false, T(player, "Invalid request")
	end
	local isLayout = action == "saveLayout"
	if isLayout then
		if not RateLimiter.Check(player, "HouseLayout", LAYOUT_INTERVAL) then
			return false, T(player, "Slow down!")
		end
	elseif not RateLimiter.Check(player, "House", BUY_INTERVAL) then
		return false, T(player, "Slow down!")
	end
	local data = services.DataService:GetData(player)
	if not data or not services.GameService:IsReady(player) then
		return false, T(player, "Loading...")
	end
	if isLayout then
		return saveLayout(player, data, argument)
	end

	if STRING_ACTIONS[action] then
		if type(argument) ~= "string" or #argument == 0 or #argument > MAX_ID_LENGTH then
			return false, T(player, "Invalid request")
		end
		if action == "buyItem" then
			return buyItem(player, data, argument)
		elseif action == "buySize" then
			return buySize(player, data, argument)
		end
		return setSize(player, data, argument)
	end
	if type(argument) ~= "string" and type(argument) ~= "table" then
		return false, T(player, "Invalid request")
	end
	if action == "buyRoom" then
		return buyRoom(player, data, argument)
	elseif action == "moveRoom" then
		return moveRoom(player, data, argument)
	elseif action == "setRoomType" then
		return setRoomType(player, data, argument)
	elseif action == "buyWallpaper" then
		return buySkin(player, data, "Wallpaper", argument)
	elseif action == "setWallpaper" then
		return setSkin(player, data, "Wallpaper", argument)
	elseif action == "buyFloor" then
		return buySkin(player, data, "Floor", argument)
	elseif action == "setFloor" then
		return setSkin(player, data, "Floor", argument)
	elseif action == "buyLook" then
		return buyLook(player, data, argument)
	elseif action == "setLook" then
		return setLook(player, data, argument)
	end
	return false, T(player, "Invalid request")
end

----------------------------------------------------------------------
-- Cycle de vie
----------------------------------------------------------------------

function HouseService:PlayerReady(_player: Player, data)
	sanitizeHouse(data)
end

function HouseService:Start()
	Net.Function("House").OnServerInvoke = function(player: Player, action: any, argument: any)
		local ok, success, message = pcall(onHouse, player, action, argument)
		if not ok then
			warn("[HouseService] Erreur pour " .. player.Name .. " :", success)
			return false, T(player, "Invalid request")
		end
		return success, message
	end
end

return HouseService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="223">
        <Properties>
          <string name="Name">InteractService</string>
          <string name="Source"><![CDATA[--[[
	InteractService (ModuleScript)
	Emplacement : ServerScriptService > Services > InteractService

	Interactions "satisfaisantes" avec les éléments de l'écran
	(RemoteEvent Interact, réglages dans Config.Interactions) :
	  - "Bubble", "Butter" : papier bulle / beurre croustillant. Seau de
	                 jetons (MaxPerSecond), gain = gain par clic x ClickFraction,
	                 SANS notification (le client affiche lui-même le "+X") ;
	  - "Follow"   : bouton "Suivre" du live (OneTime) : UNE fois par partie
	                 (data.LiveFollowed, remis à false à la détox), gain = X
	                 secondes de production, notification "Bonus" ; les dons
	                 du live (spawner "Donation") ne viennent qu'après ;
	  - "Spin", "Headline", "Press" : temps de recharge, gain = X secondes de
	                 production, notification "Bonus".
	Chaque interaction exige la Feature correspondante.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Net = require(ReplicatedStorage.Shared.Net)

local InteractService = {}

local services
local COOLDOWN_TOLERANCE = 0.2 -- marge (s) pour la latence réseau

-- [Player] = { Tokens = { [kind] = n }, LastRefill = { [kind] = clock }, LastUse = { [kind] = clock } }
local states = {}

-- Interactions "une seule fois par partie" : [kind] = clé booléenne dans data
local ONE_TIME_FLAGS = {
	Follow = "LiveFollowed",
}

function InteractService:Init(allServices)
	services = allServices
end

-- Seau de jetons : true si l'action est autorisée
local function takeToken(state, kind: string, perSecond: number): boolean
	local clock = os.clock()
	local tokens = state.Tokens[kind] or perSecond
	local last = state.LastRefill[kind] or clock
	tokens = math.min(perSecond, tokens + (clock - last) * perSecond)
	state.LastRefill[kind] = clock
	if tokens < 1 then
		state.Tokens[kind] = tokens
		return false
	end
	state.Tokens[kind] = tokens - 1
	return true
end

local function onInteract(player: Player, kind: any, _arg: any)
	local state = states[player]
	if not state or type(kind) ~= "string" then
		return
	end
	local settings = Config.Interactions[kind]
	if not settings then
		return
	end
	local data = services.DataService:GetData(player)
	if not data or not Formulas.HasFeature(data, settings.Feature) then
		return
	end

	local stats = services.GameService:GetStats(player)

	if settings.MaxPerSecond then
		-- Papier bulle : beaucoup de petits gains, pas de notification
		if not takeToken(state, kind, settings.MaxPerSecond) then
			return
		end
		if settings.Stat then
			data.Stats[settings.Stat] = (data.Stats[settings.Stat] or 0) + 1
		end
		services.GameService:AddDopamine(player, stats.ClickValue * (settings.ClickFraction or 1), true)
		if kind == "Bubble" then
			services.QuestService:Progress(player, "Bubbles", 1)
		end
		return
	end

	-- Une seule fois par partie (ex. s'abonner au live)
	if settings.OneTime then
		local flag = ONE_TIME_FLAGS[kind]
		if not flag or data[flag] == true then
			return -- déjà fait (ou interaction sans drapeau connu : refusée)
		end
		data[flag] = true
		local reward = Formulas.ScaledReward(stats, settings.RewardSeconds or 1, settings.MinReward or 1)
		if settings.Stat then
			data.Stats[settings.Stat] = (data.Stats[settings.Stat] or 0) + 1
		end
		services.GameService:AddDopamine(player, reward, true)
		services.GameService:SendState(player) -- le client voit tout de suite "✔ Abonné"
		services.GameService:Notify(player, {
			Type = "Bonus",
			Source = kind,
			Amount = reward,
		})
		return
	end

	-- Autres interactions : temps de recharge + notification
	local clock = os.clock()
	local last = state.LastUse[kind]
	if last and clock - last < (settings.Cooldown or 1) - COOLDOWN_TOLERANCE then
		return
	end
	state.LastUse[kind] = clock

	local reward = Formulas.ScaledReward(stats, settings.RewardSeconds or 1, settings.MinReward or 1)
	if settings.Stat then
		data.Stats[settings.Stat] = (data.Stats[settings.Stat] or 0) + 1
	end
	services.GameService:AddDopamine(player, reward, true)
	services.GameService:Notify(player, {
		Type = "Bonus",
		Source = kind,
		Amount = reward,
	})
end

function InteractService:PlayerReady(player: Player)
	states[player] = { Tokens = {}, LastRefill = {}, LastUse = {} }
end

function InteractService:PlayerRemoving(player: Player)
	states[player] = nil
end

function InteractService:Start()
	Net.Event("Interact").OnServerEvent:Connect(onInteract)
end

return InteractService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="224">
        <Properties>
          <string name="Name">LeaderboardService</string>
          <string name="Source"><![CDATA[--[[
	LeaderboardService (ModuleScript)
	Emplacement : ServerScriptService > Services > LeaderboardService

	Classement disponible pour tout le monde dès le début (pas d'amélioration) :
	  - "Global" : top de tous les serveurs sur la Dopamine totale gagnée,
	    avec un OrderedDataStore (Config.Leaderboard.StoreName) ;
	  - "GlobalRebirths" : top de tous les serveurs sur le nombre de
	    renaissances (visites à l'océan), second OrderedDataStore
	    (Config.Leaderboard.RebirthStoreName) ;
	  - "Server" : classement EN DIRECT des joueurs de ce serveur (Dopamine
	    actuelle), envoyé à tout le monde toutes les 2 secondes.
	Les deux tops mondiaux sont écrits puis relus toutes les
	Config.Leaderboard.UpdateInterval secondes (et au départ d'un joueur).

	Événement LeaderboardUpdate :
	  {
	    Global         = { { Rank, UserId, Name, Value, Rebirths? } }, -- Value = Dopamine gagnée
	    GlobalRebirths = { { Rank, UserId, Name, Value, Dopamine? } }, -- Value = renaissances
	    Server         = { { Rank, UserId, Name, Dopamine, Lifetime, Rebirths } }, -- Dopamine décroissante
	  }
	Les champs "croisés" (Rebirths d'un top Dopamine, Dopamine d'un top
	renaissances) sont remplis quand on les connaît : joueur présent, présent
	dans l'autre top, ou lu dans l'autre store (avec cache et budget).

	Astuce : un OrderedDataStore n'accepte que des entiers (max ~9.2e18),
	alors que la Dopamine peut dépasser 1e30. On stocke donc
	log10(valeur) * 1 000 000 (un entier), puis on refait l'inverse à la lecture.
	L'ordre du classement reste exactement le même. Les renaissances, elles,
	sont stockées telles quelles (entier).
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)

local LeaderboardService = {}

local services
local dopamineStore: OrderedDataStore? = nil
local rebirthStore: OrderedDataStore? = nil
local cachedTop = {} -- dernier top mondial Dopamine connu
local cachedRebirthTop = {} -- dernier top mondial renaissances connu
local nameCache = {} -- [userId] = nom
local lastSubmitted = {} -- [userId] = { Dopamine = encodé, Rebirths = entier } (évite les écritures inutiles)
local crossCache = {} -- [clé] = { Value = number?, Time = os.clock() } (valeurs lues dans l'autre store)
local lastWarn = {} -- [clé] = os.clock() du dernier avertissement

local SERVER_RANKING_INTERVAL = 2 -- secondes entre deux envois du classement du serveur
local WARN_COOLDOWN = 300 -- un même avertissement au plus toutes les 5 minutes
local MIN_GET_BUDGET = 20 -- on garde de la marge de lecture pour les sauvegardes des joueurs
local MAX_INTEGER = 2 ^ 53 -- au-delà, un entier n'est plus exact

-- Avertissement limité (évite de remplir la console dans Studio sans accès aux API)
local function warnThrottled(key: string, ...)
	local now = os.clock()
	if lastWarn[key] and now - lastWarn[key] < WARN_COOLDOWN then
		return
	end
	lastWarn[key] = now
	warn("[LeaderboardService]", ...)
end

local function openStore(name: any): OrderedDataStore?
	if type(name) ~= "string" or name == "" then
		return nil
	end
	local ok, result = pcall(function()
		return DataStoreService:GetOrderedDataStore(name)
	end)
	if ok then
		return result
	end
	warn("[LeaderboardService] Classement " .. name .. " indisponible :", result)
	return nil
end

dopamineStore = openStore(Config.Leaderboard.StoreName)
rebirthStore = openStore(Config.Leaderboard.RebirthStoreName)

local function isValidNumber(value): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function safeNumber(value): number
	return isValidNumber(value) and value or 0
end

-- Dopamine -> entier du store (log10)
local function encode(value: number): number
	return math.floor(math.log10(math.max(0, safeNumber(value)) + 1) * 1e6)
end

-- Entier du store -> Dopamine
local function decode(stored: any): number
	local number = tonumber(stored)
	if not number or not isValidNumber(number) then
		return 0
	end
	local value = 10 ^ (number / 1e6) - 1
	return isValidNumber(value) and math.max(0, value) or 0
end

-- Renaissances -> entier du store (tel quel, borné)
local function encodeRebirths(value: any): number
	return math.floor(math.clamp(safeNumber(value), 0, MAX_INTEGER))
end

local function getName(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		nameCache[userId] = player.DisplayName
		return player.DisplayName
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	if ok and type(name) == "string" then
		nameCache[userId] = name
		return name
	end
	return "Player " .. userId -- nom de secours (envoyé à tous : laissé en anglais)
end

-- Valeurs à envoyer pour un joueur (nil si ses données ne sont pas chargées)
local function readScores(player: Player): (number?, number?)
	local data = services and services.DataService:GetData(player)
	if type(data) ~= "table" then
		return nil, nil
	end
	local stats = type(data.Stats) == "table" and data.Stats or {}
	return encode(stats.LifetimeDopamine), encodeRebirths(data.Rebirths)
end

function LeaderboardService:Init(allServices)
	services = allServices
end

----------------------------------------------------------------------
-- Classement du serveur (en direct)
----------------------------------------------------------------------

local function buildServerRanking()
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local data = services.DataService:GetData(player)
		if type(data) == "table" then
			local stats = type(data.Stats) == "table" and data.Stats or {}
			table.insert(list, {
				UserId = player.UserId,
				Name = player.DisplayName,
				Dopamine = safeNumber(data.Dopamine),
				Lifetime = safeNumber(stats.LifetimeDopamine),
				Rebirths = safeNumber(data.Rebirths),
			})
		end
	end
	table.sort(list, function(a, b)
		if a.Dopamine ~= b.Dopamine then
			return a.Dopamine > b.Dopamine
		end
		if a.Lifetime ~= b.Lifetime then
			return a.Lifetime > b.Lifetime
		end
		return a.UserId < b.UserId
	end)
	for rank, entry in ipairs(list) do
		entry.Rank = rank
	end
	return list
end

-- Contenu de LeaderboardUpdate
local function buildPayload()
	return {
		Global = cachedTop,
		GlobalRebirths = cachedRebirthTop,
		Server = buildServerRanking(),
	}
end

function LeaderboardService:SendTo(player: Player)
	Net.Event("LeaderboardUpdate"):FireClient(player, buildPayload())
end

-- Envoie le classement (tops mondiaux en cache + serveur en direct) à tout le monde
function LeaderboardService:Broadcast()
	if #Players:GetPlayers() == 0 then
		return
	end
	Net.Event("LeaderboardUpdate"):FireAllClients(buildPayload())
end

----------------------------------------------------------------------
-- Classements mondiaux (OrderedDataStore)
----------------------------------------------------------------------

-- Écrit une valeur dans un store (pcall) ; vrai si réussi
local function writeScore(store: OrderedDataStore?, key: string, value: number, label: string): boolean
	if not store then
		return false
	end
	local target = store :: OrderedDataStore
	local ok, err = pcall(function()
		target:SetAsync(key, value)
	end)
	if not ok then
		warnThrottled("write" .. label, "Échec d'envoi du score (" .. label .. ") :", err)
	end
	return ok
end

-- Écrit les scores déjà lus (Dopamine encodée, renaissances) d'un joueur
local function submitScores(userId: number, dopamine: number, rebirths: number)
	local key = "P_" .. userId
	local previous = lastSubmitted[userId] or {}
	local submitted = { Dopamine = previous.Dopamine, Rebirths = previous.Rebirths }
	lastSubmitted[userId] = submitted
	if dopamine > 0 and previous.Dopamine ~= dopamine then
		if writeScore(dopamineStore, key, dopamine, "Dopamine") then
			submitted.Dopamine = dopamine
		end
	end
	-- Pas de renaissance : inutile d'encombrer le top avec des zéros
	-- (sauf si un score a déjà été écrit, pour le corriger)
	if (rebirths > 0 or previous.Rebirths ~= nil) and previous.Rebirths ~= rebirths then
		if writeScore(rebirthStore, key, rebirths, "Rebirths") then
			submitted.Rebirths = rebirths
		end
	end
end

-- Écrit les scores d'un joueur dans les deux classements
function LeaderboardService:SubmitAsync(player: Player)
	local dopamine, rebirths = readScores(player)
	if dopamine == nil or rebirths == nil then
		return
	end
	submitScores(player.UserId, dopamine, rebirths)
end

-- Lit un top (pcall) : liste { { UserId, Stored } } ou nil si échec
local function readTop(store: OrderedDataStore?, label: string): { { UserId: number, Stored: number } }?
	if not store then
		return nil
	end
	local target = store :: OrderedDataStore
	local ok, result = pcall(function()
		local pages = target:GetSortedAsync(false, Config.Leaderboard.Size)
		return pages:GetCurrentPage()
	end)
	if not ok or type(result) ~= "table" then
		warnThrottled("read" .. label, "Échec de lecture du classement (" .. label .. ") :", result)
		return nil
	end
	local list = {}
	for _, entry in ipairs(result) do
		local key = type(entry) == "table" and entry.key
		local stored = type(entry) == "table" and tonumber(entry.value)
		local userId = type(key) == "string" and tonumber(string.sub(key, 3)) or nil
		if userId and stored and stored > 0 then
			table.insert(list, { UserId = userId, Stored = stored })
		end
	end
	return list
end

-- Valeur d'un joueur dans l'autre store (cache + budget de lecture).
-- Renvoie (valeur brute ou nil, connue) : "connue" = lecture réussie
-- (valeur nil = aucun score écrit), faux = impossible de savoir pour l'instant.
local function lookupStored(store: OrderedDataStore?, label: string, userId: number): (number?, boolean)
	if not store then
		return nil, false
	end
	local cacheKey = label .. "_" .. userId
	local cached = crossCache[cacheKey]
	local cacheTime = tonumber(Config.Leaderboard.CrossLookupCacheTime) or 300
	if cached and os.clock() - cached.Time < cacheTime then
		return cached.Value, true
	end
	local budgetOk, budget = pcall(function()
		return DataStoreService:GetRequestBudgetForRequestType(Enum.DataStoreRequestType.GetAsync)
	end)
	if not budgetOk or type(budget) ~= "number" or budget < MIN_GET_BUDGET then
		if cached then
			return cached.Value, true -- valeur un peu ancienne, mieux que rien
		end
		return nil, false
	end
	local target = store :: OrderedDataStore
	local ok, value = pcall(function()
		return target:GetAsync("P_" .. userId)
	end)
	if not ok then
		warnThrottled("lookup" .. label, "Échec de lecture d'un score (" .. label .. ") :", value)
		if cached then
			return cached.Value, true
		end
		return nil, false
	end
	local number = tonumber(value)
	crossCache[cacheKey] = { Value = number, Time = os.clock() }
	return number, true
end

-- Lit les deux tops, complète les valeurs croisées, puis envoie à tout le monde
function LeaderboardService:RefreshAsync()
	local dopamineTop = readTop(dopamineStore, "Dopamine")
	local rebirthTop = readTop(rebirthStore, "Rebirths")

	-- Valeurs connues sans requête : joueurs présents et entrées de l'autre top
	local knownDopamine = {} -- [userId] = Dopamine gagnée (décodée)
	local knownRebirths = {} -- [userId] = renaissances
	for _, player in ipairs(Players:GetPlayers()) do
		local data = services.DataService:GetData(player)
		if type(data) == "table" then
			local stats = type(data.Stats) == "table" and data.Stats or {}
			knownDopamine[player.UserId] = safeNumber(stats.LifetimeDopamine)
			knownRebirths[player.UserId] = encodeRebirths(data.Rebirths)
		end
	end
	for _, entry in ipairs(dopamineTop or {}) do
		if knownDopamine[entry.UserId] == nil then
			knownDopamine[entry.UserId] = decode(entry.Stored)
		end
	end
	for _, entry in ipairs(rebirthTop or {}) do
		if knownRebirths[entry.UserId] == nil then
			knownRebirths[entry.UserId] = entry.Stored
		end
	end

	if dopamineTop then
		local top = {}
		for rank, entry in ipairs(dopamineTop) do
			local rebirths = knownRebirths[entry.UserId]
			if rebirths == nil then
				-- Absent du top renaissances : on lit son score (0 si jamais écrit)
				local stored, known = lookupStored(rebirthStore, "Rebirths", entry.UserId)
				if known then
					rebirths = stored or 0
				end
			end
			table.insert(top, {
				Rank = rank,
				UserId = entry.UserId,
				Name = getName(entry.UserId),
				Value = decode(entry.Stored),
				Rebirths = rebirths,
			})
		end
		cachedTop = top
	end

	if rebirthTop then
		local top = {}
		for rank, entry in ipairs(rebirthTop) do
			local dopamine = knownDopamine[entry.UserId]
			if dopamine == nil then
				local stored, known = lookupStored(dopamineStore, "Dopamine", entry.UserId)
				if known then
					dopamine = stored and decode(stored) or 0
				end
			end
			table.insert(top, {
				Rank = rank,
				UserId = entry.UserId,
				Name = getName(entry.UserId),
				Value = entry.Stored,
				Dopamine = dopamine,
			})
		end
		cachedRebirthTop = top
	end

	self:Broadcast()
end

function LeaderboardService:PlayerRemoving(player: Player)
	-- Scores lus tout de suite (les données sont libérées juste après)
	local userId = player.UserId
	local dopamine, rebirths = readScores(player)
	if dopamine == nil or rebirths == nil then
		lastSubmitted[userId] = nil
		return
	end
	task.spawn(function()
		submitScores(userId, dopamine, rebirths)
		lastSubmitted[userId] = nil
	end)
end

function LeaderboardService:Start()
	-- Classement du serveur en direct
	task.spawn(function()
		while true do
			task.wait(SERVER_RANKING_INTERVAL)
			local ok, err = pcall(self.Broadcast, self)
			if not ok then
				warn("[LeaderboardService] Échec d'envoi du classement du serveur :", err)
			end
		end
	end)

	-- Classements mondiaux (OrderedDataStore)
	task.spawn(function()
		task.wait(5) -- laisse le temps aux premiers joueurs de charger
		while true do
			local ok, err = pcall(function()
				for _, player in ipairs(services.DataService:GetLoadedPlayers()) do
					self:SubmitAsync(player)
				end
				self:RefreshAsync()
			end)
			if not ok then
				warn("[LeaderboardService] Erreur du classement mondial :", err)
			end
			task.wait(Config.Leaderboard.UpdateInterval)
		end
	end)
end

return LeaderboardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="225">
        <Properties>
          <string name="Name">LootService</string>
          <string name="Source"><![CDATA[--[[
	LootService (ModuleScript)
	Emplacement : ServerScriptService > Services > LootService

	Coffre mystère (débloqué par l'amélioration "Coffre mystère") :
	  - se remplit avec le temps de jeu (Charge, appelé par le tick passif
	    de GameService) : 1 coffre toutes les ChargeInterval secondes, au
	    maximum MaxStored coffres en réserve ;
	  - le joueur l'ouvre avec la RemoteFunction OpenChest : le serveur tire
	    la rareté (poids de Config.LootBox.Tiers) et donne la récompense.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Locale = require(ReplicatedStorage.Shared.Locale)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Net = require(ReplicatedStorage.Shared.Net)
local RateLimiter = require(script.Parent.RateLimiter)

local LootService = {}

local services
local random = Random.new()
local settings = Config.LootBox

function LootService:Init(allServices)
	services = allServices
end

-- Remplit la jauge du coffre (appelé à chaque tick passif)
function LootService:Charge(player: Player, data, elapsed: number)
	if not Formulas.HasFeature(data, settings.Feature) then
		return
	end
	local chests = data.Chests
	if chests.Stored >= settings.MaxStored then
		chests.Progress = 0
		return
	end
	chests.Progress += elapsed / settings.ChargeInterval
	while chests.Progress >= 1 and chests.Stored < settings.MaxStored do
		chests.Progress -= 1
		chests.Stored += 1
	end
	if chests.Stored >= settings.MaxStored then
		chests.Progress = 0
	end
	services.GameService:MarkDirty(player)
end

-- Ajoute des coffres (commande de test /chest)
function LootService:AddChests(player: Player, count: number)
	local data = services.DataService:GetData(player)
	if not data then
		return
	end
	data.Chests.Stored = math.clamp(data.Chests.Stored + count, 0, settings.MaxStored)
	services.GameService:MarkDirty(player)
end

-- Tire une rareté selon les poids
local function pickTier()
	local total = 0
	for _, tier in ipairs(settings.Tiers) do
		total += tier.Weight
	end
	local roll = random:NextNumber(0, total)
	for _, tier in ipairs(settings.Tiers) do
		roll -= tier.Weight
		if roll <= 0 then
			return tier
		end
	end
	return settings.Tiers[1]
end

-- Texte dans la langue du joueur
local function T(player: Player, text: string, ...): string
	return services.GameService:T(player, text, ...)
end

local function onOpen(player: Player)
	local data = services.DataService:GetData(player)
	if not data or not services.GameService:IsReady(player) then
		return false, T(player, "Loading...")
	end
	if not Formulas.HasFeature(data, settings.Feature) then
		return false, T(player, "The mystery chest isn't unlocked yet")
	end
	if data.Chests.Stored < 1 then
		return false, T(player, "No chests to open, be patient...")
	end
	if not RateLimiter.Check(player, "OpenChest", settings.OpenCooldown) then
		return false, T(player, "Slow down!")
	end

	local tier = pickTier()
	local amount = Formulas.ScaledReward(services.GameService:GetStats(player), tier.RewardSeconds, 100)

	data.Chests.Stored -= 1
	data.Stats.ChestsOpened += 1
	services.GameService:AddDopamine(player, amount, true)
	services.QuestService:Progress(player, "Chests", 1)
	services.GameService:SendState(player)

	if tier.Id == "Legendary" then
		local displayName, formatted = player.DisplayName, NumberFormatter.Format(amount)
		services.GameService:NotifyAll(function(lang)
			return {
				Type = "Info",
				Text = Locale.TFor(lang, "📦 %s opened a %s chest (+%s)!", displayName, Locale.TFor(lang, tier.Name), formatted),
			}
		end, player)
	end

	return true, { Tier = tier.Id, Amount = amount }
end

function LootService:Start()
	Net.Function("OpenChest").OnServerInvoke = onOpen
end

return LootService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="226">
        <Properties>
          <string name="Name">MinigameService</string>
          <string name="Source"><![CDATA[--[[
	MinigameService (ModuleScript)
	Emplacement : ServerScriptService > Services > MinigameService

	🕹️ Arcade (amélioration "Arcade", Feature "Minigames") : mini-jeux solo,
	🎟️ tickets, 🏆 trophées et duels entre joueurs du serveur. 100 % côté serveur.

	RemoteFunction "Arcade" (action, argument) -> (succès, résultat | message) :
	  - "solo:*"    : routé vers Services > Arcade > SoloGames.Handle(player, data,
	                  action, arg, api) (jeux solo, écrits à part ; chargé avec
	                  pcall : son absence ne casse jamais l'arcade) ;
	  - "lobby"     : joueurs du serveur qui ont l'arcade, invitations, duel en cours ;
	  - "invite"    : { Target = UserId, Game = Id, Stake = 🏆 trophées } ;
	  - "cancel" / "accept" / "decline" (Id d'invitation) ;
	  - "move"      : { Id = duel, Move = coup } ; "forfeit" (abandon) ;
	  - "buy"       : Id d'un objet de la boutique à tickets ; "badge" : équipe un badge.
	    Refus faute de tickets : (false, { Text, Missing = tickets manquants,
	    Currency = "Tickets" }) -> le client propose d'en acheter (NeedTickets).
	RemoteEvent "ArcadeEvent" (S -> C) : "invite", "inviteClosed", "duelStart",
	  "duelUpdate", "duelEnd" (payload = invitation ou état du duel VU par ce joueur).

	Deux monnaies (règles Roblox : on ne mise JAMAIS une monnaie achetable) :
	  - 🎟️ tickets (data.Tickets) : boutique à tickets. Gagnés en jouant
	    (plafond par jour) ou achetés en Robux (packs : MonetizationService
	    appelle GrantPurchasedTickets). Jamais misés ;
	  - 🏆 trophées (data.Trophies) : MISES des duels. Gagnés UNIQUEMENT en
	    jouant (victoires solo / duel récompensées, plafond par jour) + un
	    cadeau de bienvenue ; jamais achetables, jamais convertibles.

	Duels :
	  - invitation d'un joueur du serveur (pas soi-même), mise identique pour
	    les deux (en 🏆, vérifiée ici pour les DEUX joueurs), délai
	    d'expiration, refus, annulation ;
	  - à l'acceptation : les deux mises sont prises (séquestre), revérifiées ;
	  - état du jeu gardé ICI : coups validés (tour, case libre...), victoire
	    détectée ici (ArcadeConfig.Logic), temps par coup, durée max ;
	  - gagnant : les deux mises (x2, en 🏆) + Dopamine (secondes de
	    production) + tickets bonus + 1 🏆 bonus (le prix NE dépend PAS de la
	    mise) ; perdant : perd sa mise ; égalité : mises rendues ;
	  - déconnexion ou abandon : le joueur qui part perd ;
	  - anti-abus : limites de duels par jour contre le MÊME joueur (et
	    récompenses limitées), cadence des invitations, pas de duel contre soi.

	data.Arcade = { Day, DayTickets, DayTrophies, DayRewards = { [jeu] = n }, DayPairs = { [UserId] = n },
	  DayPairRewards = { [UserId] = n }, DayShop = { [objet] = n }, Best = { [jeu] = record },
	  Plays / Wins / Losses / Draws = { [jeu] = n }, Badges = { [id] = true }, Badge = id,
	  History = { dernier duel en premier ; K = "T" : mise en 🏆 }, TicketsEarned, TrophiesEarned,
	  TicketsBought, Welcomed, TrophyGift }
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Formulas = require(Shared.Formulas)
local Locale = require(Shared.Locale)
local NumberFormatter = require(Shared.NumberFormatter)
local Net = require(Shared.Net)
local ArcadeConfig = require(Shared.ArcadeConfig)
local RateLimiter = require(script.Parent.RateLimiter)

local MinigameService = {}

local services
local random = Random.new()
local Logic = ArcadeConfig.Logic
local DUELS = ArcadeConfig.Duels
local TICKETS = ArcadeConfig.Tickets
local TROPHIES = ArcadeConfig.Trophies
local SECONDS_PER_DAY = 86400
local HISTORY_SIZE = 8

local arcadeEvent: RemoteEvent? = nil

-- Joueurs dont les tickets / records ont changé pendant l'action en cours (état complet à renvoyer)
local changed: { [Player]: boolean } = {}

-- Invitations : [id] = { Id, From, To, Game, Stake, ExpiresAt }
local invites = {}
-- Duels en cours : [id] = duel ; [Player] = duel
local duels = {}
local duelOf: { [Player]: any } = {}
local lastInviteAt: { [Player]: number } = {}
local declinedAt: { [Player]: { [number]: number } } = {}
local nextId = 0

----------------------------------------------------------------------
-- Utilitaires
----------------------------------------------------------------------

local function isValidNumber(value): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function T(player: Player, text: string, ...): string
	return services.GameService:T(player, text, ...)
end

local function newId(prefix: string): string
	nextId += 1
	return string.format("%s%d_%d", prefix, nextId, random:NextInteger(100, 999))
end

local function getData(player: Player)
	return services.DataService:GetData(player)
end

local function asTable(value)
	return type(value) == "table" and value or {}
end

-- Données d'arcade propres (sauvegarde abîmée corrigée) + remise à zéro des limites du jour
local function ensureArcade(data)
	local arcade = data.Arcade
	if type(arcade) ~= "table" then
		arcade = {}
		data.Arcade = arcade
	end
	if not isValidNumber(data.Tickets) or data.Tickets < 0 then
		data.Tickets = 0
	end
	data.Tickets = math.floor(math.min(data.Tickets, TICKETS.Max))
	if not isValidNumber(data.Trophies) or data.Trophies < 0 then
		data.Trophies = 0
	end
	data.Trophies = math.floor(math.min(data.Trophies, TROPHIES.Max))
	for _, key in ipairs({ "Best", "Plays", "Wins", "Losses", "Draws", "Badges", "History" }) do
		arcade[key] = asTable(arcade[key])
	end
	if type(arcade.Badge) ~= "string" or not arcade.Badges[arcade.Badge] or not ArcadeConfig.ShopById[arcade.Badge] then
		arcade.Badge = ""
	end
	for _, key in ipairs({ "TicketsEarned", "TrophiesEarned", "TicketsBought" }) do
		if not isValidNumber(arcade[key]) then
			arcade[key] = 0
		end
	end
	local day = math.floor(os.time() / SECONDS_PER_DAY)
	if arcade.Day ~= day then
		arcade.Day = day
		arcade.DayTickets = 0
		arcade.DayTrophies = 0
		arcade.DayRewards = {}
		arcade.DayPairs = {}
		arcade.DayPairRewards = {}
		arcade.DayShop = {}
	else
		arcade.DayTickets = isValidNumber(arcade.DayTickets) and arcade.DayTickets or 0
		arcade.DayTrophies = isValidNumber(arcade.DayTrophies) and arcade.DayTrophies or 0
		for _, key in ipairs({ "DayRewards", "DayPairs", "DayPairRewards", "DayShop" }) do
			arcade[key] = asTable(arcade[key])
		end
	end
	return arcade
end

local function hasArcade(player: Player): boolean
	local data = getData(player)
	return data ~= nil and services.GameService:IsReady(player) and Formulas.HasFeature(data, ArcadeConfig.Feature)
end

local function badgeIcon(data): string
	local arcade = data and data.Arcade
	local item = arcade and type(arcade.Badge) == "string" and ArcadeConfig.ShopById[arcade.Badge]
	return item and item.Icon or ""
end

local function playerInfo(player: Player)
	local data = getData(player)
	return {
		UserId = player.UserId,
		Name = player.DisplayName,
		User = player.Name,
		Badge = badgeIcon(data),
		Trophies = data and isValidNumber(data.Trophies) and math.floor(data.Trophies) or 0,
	}
end

local function fire(player: Player, kind: string, payload)
	if arcadeEvent and player.Parent == Players then
		arcadeEvent:FireClient(player, kind, payload)
	end
end

local function incr(map, key, amount: number?)
	map[key] = (tonumber(map[key]) or 0) + (amount or 1)
end

----------------------------------------------------------------------
-- Tickets, trophées, Dopamine, stats (aussi exposés aux jeux solo via `api`)
----------------------------------------------------------------------

-- Ajoute / retire des 🎟️ tickets SANS plafond du jour (achats en tickets, cadeau, packs Robux)
local function moveTickets(player: Player, amount: number): number
	local data = getData(player)
	if not data or not isValidNumber(amount) then
		return 0
	end
	ensureArcade(data)
	local before = data.Tickets
	data.Tickets = math.clamp(math.floor(before + amount), 0, TICKETS.Max)
	changed[player] = true
	return data.Tickets - before
end

-- Tickets GAGNÉS (récompenses) : plafonnés par jour. Renvoie le nombre vraiment donné.
local function grantTickets(player: Player, amount: number): number
	local data = getData(player)
	if not data then
		return 0
	end
	local arcade = ensureArcade(data)
	local granted = Logic.CappedGrant(amount, arcade.DayTickets, TICKETS.DailyCap)
	if granted <= 0 then
		return 0
	end
	granted = moveTickets(player, granted)
	arcade.DayTickets += granted
	arcade.TicketsEarned += granted
	return granted
end

-- Ajoute / retire des 🏆 trophées SANS plafond du jour (mises en séquestre, pots, remboursements, cadeau)
local function moveTrophies(player: Player, amount: number): number
	local data = getData(player)
	if not data or not isValidNumber(amount) then
		return 0
	end
	ensureArcade(data)
	local before = data.Trophies
	data.Trophies = math.clamp(math.floor(before + amount), 0, TROPHIES.Max)
	changed[player] = true
	return data.Trophies - before
end

-- Trophées GAGNÉS en jouant : plafonnés par jour. Renvoie le nombre vraiment donné.
local function grantTrophies(player: Player, amount: number): number
	local data = getData(player)
	if not data then
		return 0
	end
	local arcade = ensureArcade(data)
	local granted = Logic.CappedGrant(amount, arcade.DayTrophies, TROPHIES.DailyCap)
	if granted <= 0 then
		return 0
	end
	granted = moveTrophies(player, granted)
	arcade.DayTrophies += granted
	arcade.TrophiesEarned += granted
	return granted
end

-- Dopamine = `seconds` de production (comme les autres bonus du jeu)
local function grantDopamineSeconds(player: Player, seconds: number, countForQuests: boolean?): number
	if not isValidNumber(seconds) or seconds <= 0 or not getData(player) then
		return 0
	end
	local stats = services.GameService:GetStats(player)
	local amount = Formulas.ScaledReward(stats, math.min(seconds, 3600), ArcadeConfig.MinDopamineReward)
	if not isValidNumber(amount) or amount <= 0 then
		return 0
	end
	services.GameService:AddDopamine(player, amount, countForQuests ~= false)
	changed[player] = true
	return amount
end

local function addStat(player: Player, stat: string, amount: number?)
	local data = getData(player)
	if not data or type(stat) ~= "string" or type(data.Stats) ~= "table" then
		return
	end
	local value = amount or 1
	if not isValidNumber(value) then
		return
	end
	data.Stats[stat] = (tonumber(data.Stats[stat]) or 0) + value
	changed[player] = true
end

-- Record d'un jeu (game.Record "High" = plus grand, "Low" = plus petit) -> nouveau record ?
local function recordScore(player: Player, gameId: string, score: number): boolean
	local data = getData(player)
	local entry = ArcadeConfig.GamesById[gameId]
	if not data or not entry or not isValidNumber(score) then
		return false
	end
	local arcade = ensureArcade(data)
	local best = arcade.Best[gameId]
	local better = best == nil or (entry.Record == "Low" and score < best) or (entry.Record ~= "Low" and score > best)
	if better then
		arcade.Best[gameId] = score
		changed[player] = true
	end
	return better
end

-- Une partie récompensée de plus aujourd'hui pour ce jeu ? (consomme si oui)
local function takeDailyReward(player: Player, gameId: string): boolean
	local data = getData(player)
	local entry = ArcadeConfig.GamesById[gameId]
	if not data or not entry then
		return false
	end
	local arcade = ensureArcade(data)
	local used = tonumber(arcade.DayRewards[gameId]) or 0
	if used >= (entry.DailyRewarded or 10) then
		return false
	end
	arcade.DayRewards[gameId] = used + 1
	changed[player] = true
	return true
end

local function countPlay(player: Player, gameId: string)
	local data = getData(player)
	if not data or not ArcadeConfig.GamesById[gameId] then
		return
	end
	incr(ensureArcade(data).Plays, gameId)
	addStat(player, "MinigamesPlayed", 1)
end

-- Victoire en solo : récompense (si pas encore au plafond du jour), record, stats
local function rewardWin(player: Player, gameId: string, score: number?)
	local data = getData(player)
	local entry = ArcadeConfig.GamesById[gameId]
	local result = { Tickets = 0, Trophies = 0, Dopamine = 0, Record = false, Capped = false }
	if not data or not entry then
		return result
	end
	local arcade = ensureArcade(data)
	incr(arcade.Wins, gameId)
	if score ~= nil then
		result.Record = recordScore(player, gameId, score)
	end
	if takeDailyReward(player, gameId) then
		result.Tickets = grantTickets(player, entry.Tickets or 0)
		result.Trophies = grantTrophies(player, TROPHIES.PerSoloWin)
		result.Dopamine = grantDopamineSeconds(player, entry.RewardSeconds or 0, true)
		addStat(player, "MinigamesWon", 1)
	else
		result.Capped = true
	end
	changed[player] = true
	return result
end

-- API donnée aux jeux solo (Services > Arcade > SoloGames)
local soloApi = {
	GrantDopamineSeconds = function(player: Player, seconds: number): number
		return grantDopamineSeconds(player, seconds, true)
	end,
	GrantTickets = grantTickets,
	GrantTrophies = grantTrophies,
	AddStat = addStat,
	Notify = function(player: Player, payload)
		services.GameService:Notify(player, payload)
	end,
	T = function(player: Player, text: string, ...): string
		return T(player, text, ...)
	end,
	Now = function(): number
		return os.clock()
	end,
	Config = ArcadeConfig,
	CountPlay = countPlay,
	RecordScore = recordScore,
	TakeDailyReward = takeDailyReward,
	RewardWin = rewardWin,
}

----------------------------------------------------------------------
-- Jeux solo (module écrit à part, chargé prudemment)
----------------------------------------------------------------------

local soloModule = nil
local soloWarned = false

local function getSolo()
	if soloModule then
		return soloModule
	end
	local folder = script.Parent:FindFirstChild("Arcade")
	local moduleScript = folder and folder:FindFirstChild("SoloGames")
	if not moduleScript or not moduleScript:IsA("ModuleScript") then
		return nil
	end
	local ok, result = pcall(require, moduleScript)
	if ok and type(result) == "table" and type(result.Handle) == "function" then
		soloModule = result
		if type(result.Init) == "function" then
			pcall(result.Init, soloApi)
		end
		return result
	end
	if not soloWarned then
		soloWarned = true
		warn("[MinigameService] SoloGames indisponible :", result)
	end
	return nil
end

----------------------------------------------------------------------
-- Invitations
----------------------------------------------------------------------

local function inviteView(invite)
	return {
		Id = invite.Id,
		From = playerInfo(invite.From),
		To = playerInfo(invite.To),
		Game = invite.Game,
		Stake = invite.Stake,
		Seconds = math.max(0, math.floor(invite.ExpiresAt - os.clock() + 0.5)),
		Total = DUELS.InviteSeconds,
	}
end

local function closeInvite(invite, reason: string?)
	if invites[invite.Id] ~= invite then
		return
	end
	invites[invite.Id] = nil
	if reason then
		local payload = { Id = invite.Id, Reason = reason, From = invite.From.DisplayName, To = invite.To.DisplayName, Game = invite.Game }
		fire(invite.From, "inviteClosed", payload)
		fire(invite.To, "inviteClosed", payload)
	end
end

-- Ferme toutes les invitations d'un joueur (envoyées et reçues)
local function closeInvitesOf(player: Player, reason: string)
	for _, invite in pairs(invites) do
		if invite.From == player or invite.To == player then
			closeInvite(invite, reason)
		end
	end
end

local function outgoingOf(player: Player)
	for _, invite in pairs(invites) do
		if invite.From == player then
			return invite
		end
	end
	return nil
end

local function incomingOf(player: Player)
	local list = {}
	for _, invite in pairs(invites) do
		if invite.To == player then
			table.insert(list, invite)
		end
	end
	table.sort(list, function(a, b)
		return a.ExpiresAt < b.ExpiresAt
	end)
	return list
end

local function pairCount(data, other: Player, key: string): number
	return tonumber(ensureArcade(data)[key][tostring(other.UserId)]) or 0
end

----------------------------------------------------------------------
-- Duels : état, vue, fin
----------------------------------------------------------------------

local function gameOf(duel)
	return ArcadeConfig.GamesById[duel.Game]
end

-- État du duel vu par `viewer` (rien de secret : ni l'intrus avant la fin de manche, ni l'heure du GO)
local function snapshot(duel, viewer: Player?)
	local now = os.clock()
	local entry = gameOf(duel)
	local view = {
		Id = duel.Id,
		Game = duel.Game,
		Stake = duel.Stake,
		Pot = duel.Pot,
		You = viewer and duel.Seats[viewer] or 0,
		Players = duel.Infos,
		Turn = duel.Turn,
		TurnLeft = duel.TurnEndsAt and math.max(0, duel.TurnEndsAt - now) or nil,
		TurnSeconds = entry.TurnSeconds,
		Scores = { duel.Scores[1], duel.Scores[2] },
		WinScore = entry.WinScore,
		Round = duel.Round,
		Phase = duel.Phase,
		PhaseLeft = duel.PhaseEndsAt and math.max(0, duel.PhaseEndsAt - now) or nil,
		Moves = duel.Moves,
		Over = duel.Over,
		Winner = duel.Winner,
		Reason = duel.Reason,
	}
	if duel.Game == "TicTacToe" or duel.Game == "Connect4" then
		view.Board = duel.Board
		view.Last = duel.Last
		view.Line = duel.Line
	elseif duel.Game == "ReactionDuel" then
		view.RoundResult = duel.RoundResult
	elseif duel.Game == "SpotRace" then
		local grid = duel.Grid
		if grid then
			view.Grid = { Size = grid.Size, Cells = grid.Cells }
		end
		view.RoundResult = duel.RoundResult
		local seat = viewer and duel.Seats[viewer]
		local locked = seat and duel.Locked and duel.Locked[seat] or 0
		view.Locked = math.max(0, locked - now)
	end
	return view
end

local function broadcast(duel, kind: string)
	for _, player in ipairs(duel.Players) do
		fire(player, kind, snapshot(duel, player))
	end
end

local function pushHistory(data, entry)
	local history = ensureArcade(data).History
	table.insert(history, 1, entry)
	while #history > HISTORY_SIZE do
		table.remove(history)
	end
end

-- Fin du duel : winnerSeat = 1 | 2, ou 0 (égalité : mises rendues)
local function endDuel(duel, winnerSeat: number, reason: string)
	if duel.Over then
		return
	end
	duel.Over = true
	duel.Winner = winnerSeat
	duel.Reason = reason
	duel.Token += 1
	duel.TurnEndsAt = nil
	duel.PhaseEndsAt = nil
	duels[duel.Id] = nil
	for _, player in ipairs(duel.Players) do
		if duelOf[player] == duel then
			duelOf[player] = nil
		end
	end

	local entry = gameOf(duel)
	local results = {}
	-- Mises en 🏆 (déjà en séquestre) : gagnant x2, perdant rien, égalité rendue
	local payouts = Logic.StakePayouts(duel.Stake, winnerSeat)
	for seat, player in ipairs(duel.Players) do
		local data = getData(player)
		local other = duel.Players[3 - seat]
		-- Trophies = gain / perte de la mise ; Bonus = 🎟️ bonus ; TrophyBonus = 🏆 bonus
		local result = { Outcome = "Draw", Reason = reason, Trophies = 0, Bonus = 0, TrophyBonus = 0, Dopamine = 0, Rewarded = false }
		results[seat] = result
		if data then
			local arcade = ensureArcade(data)
			addStat(player, "MinigamesPlayed", 1)
			incr(arcade.Plays, duel.Game)
			if payouts[seat] > 0 then
				moveTrophies(player, payouts[seat])
			end
			if winnerSeat == 0 then
				incr(arcade.Draws, duel.Game)
			elseif winnerSeat == seat then
				result.Outcome = "Win"
				result.Trophies = payouts[seat] - duel.Stake
				incr(arcade.Wins, duel.Game)
				local key = tostring(other.UserId)
				local rewardedToday = tonumber(arcade.DayPairRewards[key]) or 0
				if rewardedToday < DUELS.PairRewardedPerDay and duel.Moves >= DUELS.MinMovesForReward then
					-- Prix de la victoire : identique quelle que soit la mise (même en duel amical)
					arcade.DayPairRewards[key] = rewardedToday + 1
					result.Rewarded = true
					result.Bonus = grantTickets(player, TICKETS.DuelWinBonus)
					result.TrophyBonus = grantTrophies(player, TROPHIES.PerDuelWin)
					result.Dopamine = grantDopamineSeconds(player, entry.RewardSeconds or 30, true)
					addStat(player, "MinigamesWon", 1)
					addStat(player, "DuelsWon", 1)
				end
			else
				result.Outcome = "Lose"
				result.Trophies = -duel.Stake
				incr(arcade.Losses, duel.Game)
			end
			pushHistory(data, {
				G = duel.Game,
				O = duel.Infos[3 - seat].Name,
				R = result.Outcome == "Win" and "W" or (result.Outcome == "Lose" and "L" or "D"),
				S = duel.Stake,
				K = "T", -- mise en 🏆 trophées (les anciens duels, sans K, étaient en tickets)
				T = os.time(),
			})
			changed[player] = true
		end
	end

	for seat, player in ipairs(duel.Players) do
		local view = snapshot(duel, player)
		view.Result = results[seat]
		fire(player, "duelEnd", view)
		if player.Parent == Players and services.GameService:IsReady(player) then
			changed[player] = nil
			services.GameService:SendState(player)
		end
	end

	-- Gros duel : tout le serveur est prévenu
	if winnerSeat ~= 0 and duel.Stake >= (DUELS.AnnounceStake or 5) then
		local winnerName = duel.Infos[winnerSeat].Name
		local loserName = duel.Infos[3 - winnerSeat].Name
		local pot = tostring(duel.Pot)
		local gameName = entry.Name
		services.GameService:NotifyAll(function(lang)
			return {
				Type = "Info",
				Text = Locale.TFor(lang, "⚔️ %s beat %s at %s and won %s 🏆!", winnerName, loserName, Locale.TFor(lang, gameName), pot),
			}
		end)
	end
end

-- Temps pour jouer (jeux au tour par tour) : trop lent = défaite
local function armTurn(duel)
	local entry = gameOf(duel)
	local seconds = entry.TurnSeconds or 20
	duel.Token += 1
	local token = duel.Token
	duel.TurnEndsAt = os.clock() + seconds
	task.delay(seconds + 0.35, function()
		if not duel.Over and duel.Token == token then
			endDuel(duel, 3 - duel.Turn, "timeout")
		end
	end)
end

----------------------------------------------------------------------
-- Jeux en manches (Reaction Duel, Spot Race)
----------------------------------------------------------------------

local nextRound -- (duel) déclaré plus bas

-- Fin d'une manche : points, puis manche suivante ou fin du duel
local function finishRound(duel)
	if duel.Over then
		return
	end
	local entry = gameOf(duel)
	duel.Phase = "result"
	duel.Token += 1
	local token = duel.Token
	local result = duel.RoundResult or { Winner = 0 }
	local winner = result.Winner or 0
	if winner > 0 then
		duel.Scores[winner] += 1
		duel.Moves += 1
	end
	duel.PhaseEndsAt = os.clock() + DUELS.ResultSeconds
	broadcast(duel, "duelUpdate")
	local champion = Logic.RoundsWinner(duel.Scores, entry.WinScore or 3)
	task.delay(champion > 0 and 1.4 or DUELS.ResultSeconds, function()
		if duel.Over or duel.Token ~= token then
			return
		end
		if champion > 0 then
			endDuel(duel, champion, "score")
		else
			nextRound(duel)
		end
	end)
end

-- (lecture de la phase hors du raffinement de type de l'analyseur : elle change entre deux délais)
local function phaseOf(duel): string
	return duel.Phase
end

local function maxRounds(duel): number
	return duel.Game == "ReactionDuel" and DUELS.Reaction.MaxRounds or DUELS.Spot.MaxRounds
end

-- Réaction : le premier appui valide est connu, on attend `Window` pour départager avec la latence
local function reactionResolve(duel, token: number)
	if duel.Over or duel.Token ~= token or duel.Phase ~= "go" then
		return
	end
	local t1, t2 = duel.Taps[1], duel.Taps[2]
	local winner = 0
	if t1 and (not t2 or t1 <= t2) then
		winner = 1
	elseif t2 then
		winner = 2
	end
	duel.RoundResult = { Winner = winner, Times = { t1 or -1, t2 or -1 } }
	finishRound(duel)
end

nextRound = function(duel: any)
	if duel.Over then
		return
	end
	if duel.Round >= maxRounds(duel) then
		-- Trop de manches : le meilleur score gagne, sinon égalité
		local s1, s2 = duel.Scores[1], duel.Scores[2]
		endDuel(duel, s1 > s2 and 1 or (s2 > s1 and 2 or 0), "rounds")
		return
	end
	duel.Round += 1
	duel.RoundResult = nil
	duel.Token += 1
	local token = duel.Token

	if duel.Game == "ReactionDuel" then
		local settings = DUELS.Reaction
		duel.Phase = "wait"
		duel.Taps = {}
		duel.PhaseEndsAt = nil
		broadcast(duel, "duelUpdate")
		task.delay(random:NextNumber(settings.MinDelay, settings.MaxDelay), function()
			if duel.Over or duel.Token ~= token or duel.Phase ~= "wait" then
				return
			end
			duel.Phase = "go"
			duel.GoAt = os.clock()
			broadcast(duel, "duelUpdate")
			task.delay(settings.RoundTimeout, function()
				if not duel.Over and duel.Token == token and phaseOf(duel) == "go" then
					duel.RoundResult = { Winner = 0, Void = true }
					finishRound(duel)
				end
			end)
		end)
	else
		local settings = DUELS.Spot
		duel.Grid = Logic.SpotMakeGrid(function(a: number, b: number): number
			return random:NextInteger(a, b)
		end, duel.Round)
		duel.Phase = "play"
		duel.GridAt = os.clock()
		duel.Locked = { 0, 0 }
		duel.PhaseEndsAt = os.clock() + settings.RoundTimeout
		broadcast(duel, "duelUpdate")
		task.delay(settings.RoundTimeout, function()
			if not duel.Over and duel.Token == token and duel.Phase == "play" then
				duel.RoundResult = { Winner = 0, Void = true, Odd = duel.Grid.Odd }
				finishRound(duel)
			end
		end)
	end
end

----------------------------------------------------------------------
-- Début d'un duel
----------------------------------------------------------------------

local INTRO_SECONDS = 3

local function startDuel(gameId: string, a: Player, b: Player, stake: number)
	-- Places tirées au hasard (la place 1 commence au morpion / puissance 4)
	local first, second = a, b
	if random:NextInteger(1, 2) == 2 then
		first, second = b, a
	end
	local duel = {
		Id = newId("D"),
		Game = gameId,
		Stake = stake,
		Pot = stake * 2,
		Players = { first, second },
		Seats = { [first] = 1, [second] = 2 },
		Infos = { playerInfo(first), playerInfo(second) },
		Turn = 1,
		Scores = { 0, 0 },
		Round = 0,
		Moves = 0,
		Token = 0,
		Over = false,
		Winner = 0,
		StartedAt = os.clock(),
	}
	duels[duel.Id] = duel
	duelOf[first] = duel
	duelOf[second] = duel

	-- Compteurs anti-farm (des deux côtés)
	for seat, player in ipairs(duel.Players) do
		local data = getData(player)
		if data then
			incr(ensureArcade(data).DayPairs, tostring(duel.Players[3 - seat].UserId))
		end
	end

	if gameId == "TicTacToe" then
		duel.Board = table.create(9, 0)
		duel.Phase = "play"
		armTurn(duel)
	elseif gameId == "Connect4" then
		duel.Board = table.create(Logic.C4Cols * Logic.C4Rows, 0)
		duel.Phase = "play"
		armTurn(duel)
	else
		duel.Phase = "intro"
		duel.PhaseEndsAt = os.clock() + INTRO_SECONDS
		local token = duel.Token
		task.delay(INTRO_SECONDS, function()
			if not duel.Over and duel.Token == token then
				nextRound(duel)
			end
		end)
	end

	broadcast(duel, "duelStart")

	-- Duel trop long : égalité, mises rendues
	task.delay(DUELS.MaxDuelSeconds, function()
		if not duel.Over then
			endDuel(duel, 0, "time")
		end
	end)
	return duel
end

----------------------------------------------------------------------
-- Coups
----------------------------------------------------------------------

local function pingOf(player: Player): number
	local ok, ping = pcall(function()
		return player:GetNetworkPing()
	end)
	if ok and isValidNumber(ping) then
		return math.clamp(ping, 0, DUELS.Reaction.MaxPingComp)
	end
	return 0
end

-- Coup d'un jeu au tour par tour (morpion, puissance 4)
local function playBoardMove(player: Player, duel, seat: number, move): (boolean, string?)
	if duel.Phase ~= "play" or duel.Turn ~= seat then
		return false, T(player, "Not your turn!")
	end
	local index
	if duel.Game == "TicTacToe" then
		if type(move) ~= "number" or move ~= math.floor(move) or move < 1 or move > 9 or duel.Board[move] ~= 0 then
			return false, T(player, "Invalid move")
		end
		index = move
	else
		index = Logic.C4Drop(duel.Board, move)
		if not index then
			return false, T(player, "This column is full")
		end
	end
	duel.Board[index] = seat
	duel.Last = index
	duel.Moves += 1

	local winner, line
	if duel.Game == "TicTacToe" then
		winner, line = Logic.TicTacToeWinner(duel.Board)
	else
		winner, line = Logic.C4Winner(duel.Board)
	end
	if winner ~= 0 then
		duel.Line = line
		endDuel(duel, winner, "line")
		return true, nil
	end
	if Logic.IsFull(duel.Board, #duel.Board) then
		endDuel(duel, 0, "draw")
		return true, nil
	end
	duel.Turn = 3 - seat
	armTurn(duel)
	broadcast(duel, "duelUpdate")
	return true, nil
end

local function playReactionTap(player: Player, duel, seat: number): (boolean, any)
	local settings = DUELS.Reaction
	if duel.Phase == "wait" then
		-- Faux départ : le point va à l'adversaire
		duel.RoundResult = { Winner = 3 - seat, FalseStart = seat }
		finishRound(duel)
		return true, { FalseStart = true }
	elseif duel.Phase == "go" then
		if duel.Taps[seat] then
			return true, nil
		end
		local reaction = os.clock() - duel.GoAt - pingOf(player)
		if reaction < settings.MinHuman then
			-- Impossible pour un humain : appui envoyé avant d'avoir vu le GO
			duel.RoundResult = { Winner = 3 - seat, FalseStart = seat }
			finishRound(duel)
			return true, { FalseStart = true }
		end
		duel.Taps[seat] = math.floor(reaction * 1000 + 0.5) / 1000
		local token = duel.Token
		if duel.Taps[3 - seat] then
			reactionResolve(duel, token)
		elseif not duel.WindowArmed or duel.WindowArmed ~= token then
			duel.WindowArmed = token
			task.delay(settings.Window, reactionResolve, duel, token)
		end
		return true, { Time = duel.Taps[seat] }
	end
	return false, nil
end

local function playSpot(player: Player, duel, seat: number, move): (boolean, any)
	local settings = DUELS.Spot
	local grid = duel.Grid
	if duel.Phase ~= "play" or not grid then
		return false, nil
	end
	if type(move) ~= "number" or move ~= math.floor(move) or move < 1 or move > #grid.Cells then
		return false, T(player, "Invalid move")
	end
	local now = os.clock()
	if now < (duel.Locked[seat] or 0) then
		return false, { Locked = duel.Locked[seat] - now }
	end
	if now - duel.GridAt < settings.MinFind then
		return false, nil -- trop rapide pour un humain (la grille vient d'arriver)
	end
	if move == grid.Odd then
		duel.RoundResult = { Winner = seat, Odd = grid.Odd, Time = math.floor((now - duel.GridAt) * 100 + 0.5) / 100 }
		finishRound(duel)
		return true, { Found = true }
	end
	duel.Locked[seat] = now + settings.WrongLock
	return true, { Wrong = true, Locked = settings.WrongLock }
end

----------------------------------------------------------------------
-- Actions
----------------------------------------------------------------------

local ACTIONS = {}

function ACTIONS.lobby(player: Player, _data, _arg)
	local list = {}
	local outgoing = outgoingOf(player)
	local myData = getData(player)
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player and other.UserId ~= player.UserId and hasArcade(other) then
			local info = playerInfo(other)
			info.Busy = duelOf[other] ~= nil
			info.Invited = outgoing ~= nil and outgoing.To == other
			info.PairLeft = math.max(0, DUELS.PairDailyLimit - pairCount(myData, other, "DayPairs"))
			table.insert(list, info)
		end
	end
	table.sort(list, function(a, b)
		return string.lower(a.Name) < string.lower(b.Name)
	end)
	local incoming = {}
	for _, invite in ipairs(incomingOf(player)) do
		table.insert(incoming, inviteView(invite))
	end
	local duel = duelOf[player]
	return true, {
		Players = list,
		Incoming = incoming,
		Outgoing = outgoing and inviteView(outgoing) or nil,
		Duel = duel and snapshot(duel, player) or nil,
	}
end

function ACTIONS.invite(player: Player, data, arg)
	if type(arg) ~= "table" then
		return false, T(player, "Invalid request")
	end
	local gameId, stake, targetId = arg.Game, arg.Stake, arg.Target
	local entry = type(gameId) == "string" and ArcadeConfig.GamesById[gameId]
	if not entry or entry.Kind ~= "Duel" then
		return false, T(player, "Unknown game")
	end
	if type(stake) ~= "number" or not ArcadeConfig.StakesSet[stake] then
		return false, T(player, "Invalid stake")
	end
	if type(targetId) ~= "number" then
		return false, T(player, "Invalid request")
	end
	local target = Players:GetPlayerByUserId(targetId)
	if not target or target == player or target.UserId == player.UserId then
		return false, T(player, "You can't duel yourself!")
	end
	if not hasArcade(target) then
		return false, T(player, "%s doesn't have the arcade yet", target.DisplayName)
	end
	if duelOf[player] then
		return false, T(player, "Finish your current duel first")
	end
	if duelOf[target] then
		return false, T(player, "%s is already in a duel", target.DisplayName)
	end
	local now = os.clock()
	if now - (lastInviteAt[player] or -math.huge) < DUELS.InviteCooldown then
		return false, T(player, "Slow down!")
	end
	local declined = declinedAt[player] and declinedAt[player][target.UserId]
	if declined and now - declined < DUELS.DeclineCooldown then
		return false, T(player, "%s just said no. Try again in a moment", target.DisplayName)
	end
	local targetData = getData(target)
	if not targetData then
		return false, T(player, "This player has left")
	end
	if pairCount(data, target, "DayPairs") >= DUELS.PairDailyLimit or pairCount(targetData, player, "DayPairs") >= DUELS.PairDailyLimit then
		return false, T(player, "You've dueled %s a lot today. Come back tomorrow!", target.DisplayName)
	end
	-- Mise en 🏆 trophées (jamais en tickets : ils s'achètent en Robux)
	ensureArcade(targetData)
	local stakeOk, why = Logic.CheckStake(stake, data.Trophies, targetData.Trophies)
	if not stakeOk then
		if why == "self" then
			return false, T(player, "Not enough trophies: win arcade games to earn some!")
		elseif why == "other" then
			return false, T(player, "%s doesn't have enough trophies for this stake", target.DisplayName)
		end
		return false, T(player, "Invalid stake")
	end
	local previous = outgoingOf(player)
	if previous then
		closeInvite(previous, "cancelled")
	end
	if #incomingOf(target) >= DUELS.MaxIncoming then
		return false, T(player, "%s already has too many invitations", target.DisplayName)
	end
	-- Invitation croisée déjà en attente : on l'accepte directement ? Non : chacun choisit, on garde les deux.
	lastInviteAt[player] = now
	local invite = {
		Id = newId("I"),
		From = player,
		To = target,
		Game = entry.Id,
		Stake = stake,
		ExpiresAt = now + DUELS.InviteSeconds,
	}
	invites[invite.Id] = invite
	task.delay(DUELS.InviteSeconds, function()
		if invites[invite.Id] == invite then
			closeInvite(invite, "expired")
		end
	end)
	fire(target, "invite", inviteView(invite))
	return true, { Invite = inviteView(invite), Text = T(player, "Invitation sent to %s", target.DisplayName) }
end

function ACTIONS.cancel(player: Player, _data, _arg)
	local invite = outgoingOf(player)
	if invite then
		closeInvite(invite, "cancelled")
	end
	return true, nil
end

function ACTIONS.decline(player: Player, _data, id)
	local invite = type(id) == "string" and invites[id]
	if not invite or invite.To ~= player then
		return false, T(player, "This invitation has expired")
	end
	declinedAt[invite.From] = declinedAt[invite.From] or {}
	declinedAt[invite.From][player.UserId] = os.clock()
	closeInvite(invite, "declined")
	return true, nil
end

function ACTIONS.accept(player: Player, data, id)
	local invite = type(id) == "string" and invites[id]
	if not invite or invite.To ~= player then
		return false, T(player, "This invitation has expired")
	end
	local from = invite.From
	local fromData = getData(from)
	if from.Parent ~= Players or not fromData or not hasArcade(from) then
		closeInvite(invite, "left")
		return false, T(player, "This player has left")
	end
	if duelOf[player] then
		return false, T(player, "Finish your current duel first")
	end
	if duelOf[from] then
		closeInvite(invite, "busy")
		return false, T(player, "%s is already in a duel", from.DisplayName)
	end
	if pairCount(data, from, "DayPairs") >= DUELS.PairDailyLimit or pairCount(fromData, player, "DayPairs") >= DUELS.PairDailyLimit then
		closeInvite(invite, "limit")
		return false, T(player, "You've dueled %s a lot today. Come back tomorrow!", from.DisplayName)
	end
	-- Mise revérifiée au moment d'accepter (les soldes ont pu changer)
	local stake = invite.Stake
	ensureArcade(fromData)
	local stakeOk, why = Logic.CheckStake(stake, data.Trophies, fromData.Trophies)
	if not stakeOk then
		if why == "self" then
			return false, T(player, "Not enough trophies: win arcade games to earn some!")
		end
		closeInvite(invite, "trophies")
		return false, T(player, "%s doesn't have enough trophies anymore", from.DisplayName)
	end
	closeInvite(invite, "accepted")
	-- Les deux joueurs ne sont plus disponibles : leurs autres invitations tombent
	closeInvitesOf(player, "busy")
	closeInvitesOf(from, "busy")
	-- Séquestre : les deux mises (🏆) sont prises maintenant
	if stake > 0 then
		moveTrophies(player, -stake)
		moveTrophies(from, -stake)
	end
	local duel = startDuel(invite.Game, from, player, stake)
	if changed[from] then
		changed[from] = nil
		services.GameService:SendState(from)
	end
	return true, snapshot(duel, player)
end

function ACTIONS.move(player: Player, _data, arg)
	local duel = duelOf[player]
	if type(arg) ~= "table" or not duel or arg.Id ~= duel.Id or duel.Over then
		return false, T(player, "This duel is over")
	end
	local seat = duel.Seats[player]
	if not seat then
		return false, T(player, "Invalid request")
	end
	if duel.Game == "TicTacToe" or duel.Game == "Connect4" then
		return playBoardMove(player, duel, seat, arg.Move)
	elseif duel.Game == "ReactionDuel" then
		return playReactionTap(player, duel, seat)
	elseif duel.Game == "SpotRace" then
		return playSpot(player, duel, seat, arg.Move)
	end
	return false, T(player, "Invalid request")
end

function ACTIONS.forfeit(player: Player, _data, id)
	local duel = duelOf[player]
	if not duel or (id ~= nil and id ~= duel.Id) then
		return false, T(player, "This duel is over")
	end
	endDuel(duel, 3 - duel.Seats[player], "forfeit")
	return true, nil
end

function ACTIONS.buy(player: Player, data, itemId)
	local item = type(itemId) == "string" and ArcadeConfig.ShopById[itemId]
	if not item then
		return false, T(player, "Unknown item")
	end
	if not RateLimiter.Check(player, "ArcadeBuy", 0.3) then
		return false, T(player, "Slow down!")
	end
	local arcade = ensureArcade(data)
	if item.Kind == "Badge" and arcade.Badges[item.Id] then
		return false, T(player, "You already own this item")
	end
	if item.MaxPerDay and (tonumber(arcade.DayShop[item.Id]) or 0) >= item.MaxPerDay then
		return false, T(player, "Sold out for today. Come back tomorrow!")
	end
	if data.Tickets < item.Price then
		-- Le client propose alors d'en acheter (fenêtre NeedTickets)
		return false, { Text = T(player, "Not enough tickets"), Missing = item.Price - data.Tickets, Currency = "Tickets" }
	end
	local name = T(player, item.Name)
	local text
	if item.Kind == "Boost" then
		local monetization = services.MonetizationService
		local current, remaining = monetization:GetBoost(data)
		-- Un autre boost (ex. acheté avec des Robux) est actif : on ne l'écrase pas
		if remaining > 0 and math.abs(current - item.Multiplier) > 1e-6 then
			return false, T(player, "Another boost is already running")
		end
		moveTickets(player, -item.Price)
		monetization:AddBoost(data, item.Multiplier, item.Duration)
		text = T(player, "%s %s activated!", item.Icon, name)
	elseif item.Kind == "Dopamine" then
		moveTickets(player, -item.Price)
		local amount = grantDopamineSeconds(player, item.Seconds, false)
		text = T(player, "%s +%s %s", item.Icon, NumberFormatter.Format(amount), Config.Game.CurrencyName)
	elseif item.Kind == "Badge" then
		moveTickets(player, -item.Price)
		arcade.Badges[item.Id] = true
		arcade.Badge = item.Id -- équipé tout de suite
		text = T(player, "%s %s bought and equipped!", item.Icon, name)
	else
		return false, T(player, "Invalid item")
	end
	incr(arcade.DayShop, item.Id)
	changed[player] = true
	return true, { Text = text, Tickets = data.Tickets }
end

function ACTIONS.badge(player: Player, data, badgeId)
	local arcade = ensureArcade(data)
	if badgeId == "" or badgeId == nil then
		arcade.Badge = ""
		changed[player] = true
		return true, T(player, "Badge removed")
	end
	local item = type(badgeId) == "string" and ArcadeConfig.ShopById[badgeId]
	if not item or item.Kind ~= "Badge" or not arcade.Badges[badgeId] then
		return false, T(player, "You don't own this item")
	end
	arcade.Badge = badgeId
	changed[player] = true
	return true, T(player, "%s %s equipped", item.Icon, T(player, item.Name))
end

----------------------------------------------------------------------
-- Point d'entrée (RemoteFunction "Arcade")
----------------------------------------------------------------------

local function onArcade(player: Player, action: any, arg: any)
	if type(action) ~= "string" or #action > 48 then
		return false, T(player, "Invalid request")
	end
	-- ~30 appels / s max (les jeux de rapidité cliquent vite)
	if not RateLimiter.Check(player, "Arcade", 0.03) then
		return false, T(player, "Slow down!")
	end
	local data = getData(player)
	if not data or not services.GameService:IsReady(player) then
		return false, T(player, "Loading...")
	end
	if not Formulas.HasFeature(data, ArcadeConfig.Feature) then
		return false, T(player, "The arcade isn't unlocked yet")
	end
	local arcade = ensureArcade(data)
	-- Cadeaux de bienvenue (une seule fois chacun ; les trophées sont aussi
	-- offerts aux joueurs qui avaient déjà l'arcade avant leur arrivée)
	if not arcade.Welcomed then
		arcade.Welcomed = true
		moveTickets(player, TICKETS.StartTickets)
	end
	if not arcade.TrophyGift then
		arcade.TrophyGift = true
		moveTrophies(player, TROPHIES.WelcomeGift)
	end

	local okCall, ok, result
	if string.sub(action, 1, 5) == "solo:" then
		local solo = getSolo()
		if not solo then
			return false, T(player, "This game is coming soon!")
		end
		okCall, ok, result = pcall(solo.Handle, player, data, action, arg, soloApi)
	else
		local handler = ACTIONS[action]
		if not handler then
			return false, T(player, "Invalid request")
		end
		okCall, ok, result = pcall(handler, player, data, arg)
	end
	if not okCall then
		warn("[MinigameService] Erreur dans l'action " .. action .. " :", ok)
		ok, result = false, T(player, "Something went wrong")
	end
	if changed[player] then
		changed[player] = nil
		services.GameService:SendState(player)
	end
	return ok == true, result
end

----------------------------------------------------------------------
-- Cycle de vie
----------------------------------------------------------------------

function MinigameService:Init(allServices)
	services = allServices
end

-- Champs ajoutés à l'état envoyé au client (GameService:BuildState)
function MinigameService:GetClientState(player: Player, data)
	local arcade = ensureArcade(data)
	return {
		Tickets = data.Tickets,
		Trophies = data.Trophies,
		Arcade = {
			Badge = arcade.Badge,
			Badges = arcade.Badges,
			Best = arcade.Best,
			Plays = arcade.Plays,
			Wins = arcade.Wins,
			Losses = arcade.Losses,
			Draws = arcade.Draws,
			History = arcade.History,
			TicketsEarned = arcade.TicketsEarned,
			TrophiesEarned = arcade.TrophiesEarned,
			DayTickets = arcade.DayTickets,
			DailyCap = TICKETS.DailyCap,
			DayTrophies = arcade.DayTrophies,
			TrophyCap = TROPHIES.DailyCap,
			DayRewards = arcade.DayRewards,
			DayShop = arcade.DayShop,
			InDuel = duelOf[player] ~= nil,
		},
	}
end

-- 🎟️ Tickets achetés en Robux (appelé par MonetizationService dans
-- ProcessReceipt, APRÈS la vérification de l'achat) : ajoutés au même solde
-- que les tickets gagnés, sans plafond du jour. -> (ajoutés, nouveau solde)
function MinigameService:GrantPurchasedTickets(player: Player, amount: number): (number, number)
	local data = getData(player)
	if not data or not isValidNumber(amount) or amount <= 0 or amount ~= math.floor(amount) then
		error("montant de tickets invalide : " .. tostring(amount))
	end
	local arcade = ensureArcade(data)
	local added = moveTickets(player, amount)
	arcade.TicketsBought += added
	changed[player] = nil -- (MonetizationService renvoie l'état complet lui-même)
	return added, data.Tickets
end

function MinigameService:PlayerReady(_player: Player, data)
	ensureArcade(data)
end

function MinigameService:PlayerRemoving(player: Player)
	-- Le joueur qui part perd son duel
	local duel = duelOf[player]
	if duel and not duel.Over then
		local seat = duel.Seats[player]
		if seat then
			endDuel(duel, 3 - seat, "left")
		end
	end
	closeInvitesOf(player, "left")
	duelOf[player] = nil
	changed[player] = nil
	lastInviteAt[player] = nil
	declinedAt[player] = nil
	local solo = soloModule
	if solo then
		for _, name in ipairs({ "PlayerRemoving", "Cleanup" }) do
			if type(solo[name]) == "function" then
				pcall(solo[name], player)
			end
		end
	end
end

function MinigameService:Start()
	arcadeEvent = Net.Event("ArcadeEvent")
	Net.Function("Arcade").OnServerInvoke = onArcade
	-- Préchargement des jeux solo (sans bloquer : une erreur est seulement signalée)
	task.defer(getSolo)
	-- Fermeture du serveur : duels en cours annulés, mises rendues (avant la sauvegarde)
	game:BindToClose(function()
		for _, duel in pairs(duels) do
			pcall(endDuel, duel, 0, "shutdown")
		end
	end)
end

-- (tests / debug) logique interne accessible sans passer par le réseau
MinigameService._Internal = {
	Snapshot = snapshot,
	EndDuel = endDuel,
	RewardWin = rewardWin,
}

return MinigameService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="227">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source"><![CDATA[--[[
	MonetizationService (ModuleScript)
	Emplacement : ServerScriptService > Services > MonetizationService

	💎 Boutique Robux (offres dans Config.Monetization) :
	  - Game Passes : possession vérifiée par le SERVEUR à l'arrivée du joueur
	    (UserOwnsGamePassAsync, 1 nouvel essai si Roblox ne répond pas) puis
	    après chaque achat (PromptGamePassPurchaseFinished). Multiplicateurs
	    (x2, x10, VIP), auto-clic, thèmes Premium (VIP) et thèmes vendus en
	    Game Pass (Config.Themes[].GamePassId) ;
	  - Developer Products : ProcessReceipt (défini UNE seule fois ici).
	    Chaque achat n'est accordé qu'une fois : son PurchaseId est gardé dans
	    data.Purchases et sauvegardé AVANT de répondre "PurchaseGranted" à Roblox ;
	    types : Dopamine, Boost, ServerRush, Tickets (🎟️ tickets d'arcade,
	    même solde data.Tickets que MinigameService), Combo (🎟️ + Dopamine).
	    Un type absent de Config.Monetization.ReadyKinds (ex. "Stylish",
	    pas encore codé) n'est jamais accordé (Roblox réessaiera plus tard) ;
	  - Boost temporaire (data.Boost, conservé si le joueur revient avant la fin).
	Le client ne fait qu'OUVRIR la fenêtre d'achat Roblox : il ne peut rien
	s'accorder lui-même.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Locale = require(ReplicatedStorage.Shared.Locale)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)

local MonetizationService = {}

local services

local MAX_PURCHASES_KEPT = 50 -- nombre de PurchaseId gardés (anti-doublon)
local MAX_BOOST_MULTIPLIER = 1000 -- sécurité contre une sauvegarde abîmée

--[[
	Possession par joueur (session, jamais sauvegardée : Roblox fait foi) :
	[Player] = {
		Passes = { [passId de Config.Monetization.GamePasses] = true },
		Themes = { [themeId] = true }, -- thèmes vendus en Game Pass
		Debug = { [passId] = true | false }, -- commande de test /pass (Studio)
		AutoClickCarry = number, -- fraction de clic automatique en attente
		PendingChecks = number, -- vérifications Roblox encore en cours (arrivée)
	}
]]
local owners = {}

-- PurchaseId en cours de traitement (évite deux traitements simultanés)
local processing = {}

-- Index : ID Roblox du Game Pass -> offres / thèmes concernés
local passesByGamePassId = {}
local themesByGamePassId = {}
for _, pass in ipairs(Config.Monetization.GamePasses) do
	if type(pass.GamePassId) == "number" and pass.GamePassId ~= 0 then
		passesByGamePassId[pass.GamePassId] = passesByGamePassId[pass.GamePassId] or {}
		table.insert(passesByGamePassId[pass.GamePassId], pass)
	end
end
for _, theme in ipairs(Config.Themes) do
	if type(theme.GamePassId) == "number" and theme.GamePassId ~= 0 then
		themesByGamePassId[theme.GamePassId] = themesByGamePassId[theme.GamePassId] or {}
		table.insert(themesByGamePassId[theme.GamePassId], theme)
	end
end

local function isValidNumber(value): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

function MonetizationService:Init(allServices)
	services = allServices
end

-- Texte dans la langue du joueur
local function T(player: Player, text: string, ...): string
	return services.GameService:T(player, text, ...)
end

----------------------------------------------------------------------
-- 🎰 Machine chanceuse : tours GRATUITS (jetons gagnés en jouant, aucune
-- mise), donc toujours ouverte quand Config.Casino.Enabled = true, même si
-- de la Dopamine se vend en Robux. DisableCasinoWhenSelling = true permet
-- quand même de la fermer dans ce cas.
----------------------------------------------------------------------

function MonetizationService:IsCasinoEnabled(): boolean
	if Config.Casino.Enabled ~= true then
		return false
	end
	if Config.Monetization.DisableCasinoWhenSelling == true and Config.IsSellingForRobux then
		return false
	end
	return true
end

----------------------------------------------------------------------
-- Game Passes
----------------------------------------------------------------------

-- Vérifie auprès de Roblox (pcall + 1 nouvel essai). Renvoie nil si Roblox
-- n'a pas répondu (on ne change alors rien).
local function checkOwnership(player: Player, gamePassId: number): boolean?
	for attempt = 1, 2 do
		local ok, result = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(player.UserId, gamePassId)
		end)
		if ok then
			return result == true
		end
		warn(string.format("[MonetizationService] Vérification du Game Pass %d pour %s impossible (essai %d) : %s",
			gamePassId, player.Name, attempt, tostring(result)))
		if attempt == 1 then
			task.wait(2)
		end
	end
	return nil
end

-- Le joueur possède-t-il l'offre `passId` (Config.Monetization.GamePasses) ?
function MonetizationService:OwnsPass(player: Player, passId: string): boolean
	local owner = owners[player]
	if not owner then
		return false
	end
	local override = owner.Debug[passId]
	if override ~= nil then
		return override
	end
	return owner.Passes[passId] == true
end

-- { [passId] = true } des Game Passes possédés (copie envoyée au client)
function MonetizationService:GetOwnedPasses(player: Player): { [string]: boolean }
	local result = {}
	for _, pass in ipairs(Config.Monetization.GamePasses) do
		if self:OwnsPass(player, pass.Id) then
			result[pass.Id] = true
		end
	end
	return result
end

-- VIP = possède un pass qui débloque les thèmes Premium (le pass "VIP")
function MonetizationService:IsVIP(player: Player): boolean
	for _, pass in ipairs(Config.Monetization.GamePasses) do
		if (pass.UnlockPremiumThemes or pass.Id == "VIP") and self:OwnsPass(player, pass.Id) then
			return true
		end
	end
	return false
end

-- Le joueur possède-t-il le Game Pass propre à ce thème ?
function MonetizationService:OwnsThemePass(player: Player, themeId: string): boolean
	local owner = owners[player]
	return owner ~= nil and owner.Themes[themeId] == true
end

-- Clics automatiques par seconde (pass "Auto-clic")
function MonetizationService:GetAutoClicksPerSecond(player: Player): number
	local total = 0
	for _, pass in ipairs(Config.Monetization.GamePasses) do
		local rate = pass.AutoClicksPerSecond
		if isValidNumber(rate) and rate > 0 and self:OwnsPass(player, pass.Id) then
			total += rate
		end
	end
	return total
end

-- Nombre de clics automatiques à faire pendant `elapsed` secondes (garde la fraction restante)
function MonetizationService:TakeAutoClicks(player: Player, elapsed: number): number
	local owner = owners[player]
	local rate = self:GetAutoClicksPerSecond(player)
	if not owner or rate <= 0 or not isValidNumber(elapsed) or elapsed <= 0 then
		if owner then
			owner.AutoClickCarry = 0
		end
		return 0
	end
	local carry = owner.AutoClickCarry + rate * elapsed
	local clicks = math.floor(carry)
	owner.AutoClickCarry = carry - clicks
	return clicks
end

----------------------------------------------------------------------
-- Boost temporaire et multiplicateur bonus
----------------------------------------------------------------------

-- Boost actif : (multiplicateur, secondes restantes). (1, 0) si aucun.
function MonetizationService:GetBoost(data): (number, number)
	local boost = data and data.Boost
	if type(boost) ~= "table" or not isValidNumber(boost.Multiplier) or not isValidNumber(boost.EndsAt) then
		return 1, 0
	end
	local remaining = boost.EndsAt - os.time()
	if remaining <= 0 or boost.Multiplier <= 1 then
		return 1, 0
	end
	return boost.Multiplier, remaining
end

-- Produit des multiplicateurs des Game Passes possédés (sans le boost :
-- sert aussi au gain hors-ligne, un boost ne dure pas pendant l'absence)
function MonetizationService:GetPassMultiplier(player: Player): number
	local multiplier = 1
	for _, pass in ipairs(Config.Monetization.GamePasses) do
		if isValidNumber(pass.Multiplier) and pass.Multiplier > 0 and self:OwnsPass(player, pass.Id) then
			multiplier *= pass.Multiplier
		end
	end
	return multiplier
end

-- Produit des multiplicateurs des Game Passes possédés x boost actif
function MonetizationService:GetBonusMultiplier(player: Player): number
	local data = services.DataService:GetData(player)
	local boostMultiplier = self:GetBoost(data)
	return self:GetPassMultiplier(player) * boostMultiplier
end

-- Ajoute un boost : si un boost au moins aussi fort est actif, on le
-- prolonge ; sinon le nouveau boost remplace l'ancien.
function MonetizationService:AddBoost(data, multiplier: number, duration: number)
	local now = os.time()
	local currentMultiplier, remaining = self:GetBoost(data)
	if remaining > 0 and currentMultiplier >= multiplier then
		data.Boost.EndsAt = now + remaining + duration
	else
		data.Boost = { Multiplier = multiplier, EndsAt = now + duration }
	end
end

-- Accorde un Game Pass (après vérification serveur ou achat confirmé par Roblox)
local function grantGamePass(player: Player, gamePassId: number, purchased: boolean)
	local owner = owners[player]
	if not owner then
		return
	end
	local names = {}
	for _, pass in ipairs(passesByGamePassId[gamePassId] or {}) do
		if not owner.Passes[pass.Id] then
			owner.Passes[pass.Id] = true
			table.insert(names, pass.Icon .. " " .. T(player, pass.Name))
		end
	end
	for _, theme in ipairs(themesByGamePassId[gamePassId] or {}) do
		if not owner.Themes[theme.Id] then
			owner.Themes[theme.Id] = true
			table.insert(names, T(player, "%s %s theme", theme.Icon, T(player, theme.Name)))
		end
	end
	if #names == 0 then
		return
	end

	local data = services.DataService:GetData(player)
	if purchased and data then
		data.Stats.RobuxPurchases += 1
		-- Un thème acheté en Game Pass est équipé tout de suite
		local themes = themesByGamePassId[gamePassId]
		if themes and themes[1] and type(data.Themes) == "table" then
			data.Themes.Equipped = themes[1].Id
		end
	end
	if purchased then
		services.GameService:Notify(player, {
			Type = "Purchase",
			Kind = "Pass",
			Id = (passesByGamePassId[gamePassId] and passesByGamePassId[gamePassId][1].Id) or nil,
			Text = T(player, "💎 Thank you! %s unlocked!", table.concat(names, ", ")),
		})
	end
	services.GameService:MarkDirty(player)
end

-- Vérifie tous les Game Passes configurés (en parallèle) pour ce joueur
local function checkAllPasses(player: Player)
	local ids = {}
	for gamePassId in pairs(passesByGamePassId) do
		ids[gamePassId] = true
	end
	for gamePassId in pairs(themesByGamePassId) do
		ids[gamePassId] = true
	end
	local owner = owners[player]
	for gamePassId in pairs(ids) do
		if owner then
			owner.PendingChecks += 1
		end
		task.spawn(function()
			local ok, owned = pcall(checkOwnership, player, gamePassId)
			if ok and owned and owners[player] then
				grantGamePass(player, gamePassId, false)
			end
			if owner then
				owner.PendingChecks -= 1
			end
		end)
	end
end

-- Attend (au plus `timeout` secondes) la fin des vérifications des Game
-- Passes lancées à l'arrivée du joueur (utilisé avant le gain hors-ligne)
function MonetizationService:WaitForPassChecks(player: Player, timeout: number)
	local start = os.clock()
	while os.clock() - start < timeout do
		local owner = owners[player]
		if not owner or owner.PendingChecks <= 0 then
			return
		end
		task.wait(0.1)
	end
end

local function onGamePassPurchaseFinished(player: Player, gamePassId: number, wasPurchased: boolean)
	if typeof(player) ~= "Instance" or not player:IsA("Player") or type(gamePassId) ~= "number" then
		return
	end
	if not passesByGamePassId[gamePassId] and not themesByGamePassId[gamePassId] then
		return -- pas une offre de ce jeu
	end
	if not owners[player] then
		return
	end
	-- On revérifie auprès de Roblox (jamais de confiance aveugle) :
	--  - possédé -> accordé ;
	--  - Roblox ne répond pas mais achat annoncé -> accordé pour cette session
	--    (rien n'est sauvegardé : tout est revérifié à la prochaine connexion) ;
	--  - "pas possédé" juste après un achat -> on réessaie (cache Roblox) ;
	--    dans Studio les achats sont simulés : on se fie à l'événement.
	local purchased = wasPurchased == true
	local owned = checkOwnership(player, gamePassId)
	if owned == false and purchased then
		for _ = 1, 2 do
			task.wait(3)
			if not owners[player] then
				return
			end
			owned = checkOwnership(player, gamePassId)
			if owned ~= false then
				break
			end
		end
	end
	if owned == true or (owned == nil and purchased) or (purchased and RunService:IsStudio()) then
		grantGamePass(player, gamePassId, purchased)
	end
end

----------------------------------------------------------------------
-- Developer Products (ProcessReceipt)
----------------------------------------------------------------------

local function hasProcessed(data, purchaseId: string): boolean
	for _, id in ipairs(data.Purchases) do
		if id == purchaseId then
			return true
		end
	end
	return false
end

local function recordPurchase(data, purchaseId: string)
	table.insert(data.Purchases, purchaseId)
	while #data.Purchases > MAX_PURCHASES_KEPT do
		table.remove(data.Purchases, 1)
	end
	data.Stats.RobuxPurchases += 1
end

-- 🎟️ Tickets achetés : même solde que les tickets gagnés (MinigameService).
-- -> (tickets ajoutés, nouveau solde)
local function addPurchasedTickets(player: Player, data, amount: number): (number, number)
	local minigames = services.MinigameService
	if minigames and type(minigames.GrantPurchasedTickets) == "function" then
		return minigames:GrantPurchasedTickets(player, amount)
	end
	-- (secours si l'arcade n'est pas chargée : même champ data.Tickets)
	local before = (isValidNumber(data.Tickets) and data.Tickets >= 0) and math.floor(data.Tickets) or 0
	data.Tickets = before + amount
	return amount, data.Tickets
end

-- Nombre entier de tickets d'une offre (Tickets / Combo), sinon erreur
local function ticketAmount(product): number
	local amount = product.Tickets
	if not isValidNumber(amount) or amount <= 0 or amount ~= math.floor(amount) then
		error("nombre de tickets invalide pour " .. tostring(product.Id))
	end
	return amount
end

-- Accorde le contenu d'un produit. Renvoie (texte de remerciement, titre
-- optionnel du bandeau, tickets ajoutés optionnels).
-- Tout est calculé AVANT de modifier les données (pas d'accord à moitié).
local function grantProduct(player: Player, data, product): (string, string?, number?)
	local kind = product.Kind
	local ready = Config.Monetization.ReadyKinds
	if type(ready) == "table" and not ready[kind] then
		error("type de produit pas encore codé : " .. tostring(kind))
	end
	if kind == "Tickets" then
		local amount = ticketAmount(product)
		local added, balance = addPurchasedTickets(player, data, amount)
		return T(player, "💎 Thank you! %s %s: +%s 🎟️ tickets (you have %s)", product.Icon, T(player, product.Name),
			NumberFormatter.Format(added), NumberFormatter.Format(balance)),
			T(player, "🎟️ +%s TICKETS!", NumberFormatter.Format(added)),
			added
	elseif kind == "Combo" then
		-- Tout est vérifié d'abord ; la Dopamine (seule étape qui peut échouer)
		-- est donnée AVANT les tickets (simple addition) : jamais à moitié
		local tickets = ticketAmount(product)
		local stats = services.GameService:GetStats(player)
		local amount = Formulas.ScaledReward(stats, product.Seconds or 0, product.Minimum or 0)
		if not isValidNumber(amount) or amount <= 0 then
			error("montant invalide pour " .. tostring(product.Id))
		end
		services.GameService:AddDopamine(player, amount, false)
		local added = addPurchasedTickets(player, data, tickets)
		return T(player, "💎 Thank you! %s %s: +%s 🎟️ tickets and +%s %s", product.Icon, T(player, product.Name),
			NumberFormatter.Format(added), NumberFormatter.Format(amount), Config.Game.CurrencyName),
			T(player, "🎁 COMBO UNLOCKED!"),
			added
	elseif kind == "Dopamine" then
		local stats = services.GameService:GetStats(player)
		local amount = Formulas.ScaledReward(stats, product.Seconds or 0, product.Minimum or 0)
		if not isValidNumber(amount) or amount <= 0 then
			error("montant invalide pour " .. tostring(product.Id))
		end
		-- Compté comme gagné (classement), mais ne fait pas avancer les quêtes
		services.GameService:AddDopamine(player, amount, false)
		return T(player, "💎 Thank you! %s %s: +%s %s", product.Icon, T(player, product.Name),
			NumberFormatter.Format(amount), Config.Game.CurrencyName)
	elseif kind == "Boost" then
		local multiplier, duration = product.Multiplier, product.Duration
		if not isValidNumber(multiplier) or multiplier <= 1 or not isValidNumber(duration) or duration <= 0 then
			error("boost mal configuré : " .. tostring(product.Id))
		end
		MonetizationService:AddBoost(data, multiplier, duration)
		local _, remaining = MonetizationService:GetBoost(data)
		return T(player, "💎 Thank you! %s %s active (%d min left)", product.Icon, T(player, product.Name),
			math.ceil(remaining / 60))
	elseif kind == "ServerRush" then
		services.EventService:StartRush(true)
		local displayName = player.DisplayName
		services.GameService:NotifyAll(function(lang)
			return {
				Type = "Info",
				Text = Locale.TFor(lang, "🎉 %s is treating the whole server to a Dopamine Rush!", displayName),
			}
		end, player)
		return T(player, "💎 Thank you! %s Rush started for the whole server!", product.Icon)
	end
	error("type de produit inconnu : " .. tostring(kind))
end

local function processReceipt(receiptInfo)
	local purchaseId = tostring(receiptInfo.PurchaseId)
	local product = Config.ProductsByProductId[receiptInfo.ProductId]
	if not product then
		warn("[MonetizationService] Produit inconnu (ProductId " .. tostring(receiptInfo.ProductId) .. ") : ajoute-le dans Config.Monetization.Products")
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	local data = player and services.DataService:GetData(player)
	if not player or not data or not services.GameService:IsReady(player) then
		-- Joueur absent ou pas encore chargé : Roblox réessaiera plus tard
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	-- Déjà accordé (et sauvegardé avec l'achat) : on confirme sans rien redonner
	if hasProcessed(data, purchaseId) then
		if processing[purchaseId] then
			return Enum.ProductPurchaseDecision.NotProcessedYet -- sauvegarde encore en cours
		end
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	if processing[purchaseId] then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	-- Sans sauvegarde possible (chargement raté), on n'accorde rien en jeu
	-- publié : Roblox redemandera à la prochaine connexion. Dans Studio
	-- (DataStore souvent indisponible), on accorde quand même pour tester.
	local canSave = services.DataService:CanSave(player)
	if not canSave and not RunService:IsStudio() then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	-- Accord + enregistrement du PurchaseId, sans aucune attente entre les deux
	local ok, result, title, tickets = pcall(grantProduct, player, data, product)
	if not ok then
		warn("[MonetizationService] Erreur en accordant " .. tostring(product.Id) .. " :", result)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	recordPurchase(data, purchaseId)

	services.GameService:Notify(player, {
		Type = "Purchase",
		Kind = "Product",
		Id = product.Id,
		Text = result,
		Title = title, -- (nil = titre par défaut du bandeau)
		Tickets = tickets, -- 🎟️ ajoutés (packs de tickets, combos)
	})
	services.GameService:SendState(player)

	if not canSave then
		return Enum.ProductPurchaseDecision.PurchaseGranted -- Studio sans DataStore
	end

	-- On ne confirme à Roblox qu'une fois l'achat sauvegardé. En cas d'échec,
	-- Roblox réessaiera : le PurchaseId est déjà enregistré, on ne redonnera
	-- rien (et si la sauvegarde n'a jamais eu lieu, l'achat sera réaccordé).
	processing[purchaseId] = true
	local saved = false
	local saveOk, saveResult = pcall(function()
		return services.DataService:SaveAsync(player, true)
	end)
	saved = saveOk and saveResult == true
	processing[purchaseId] = nil
	if not saved then
		warn("[MonetizationService] Sauvegarde après l'achat " .. purchaseId .. " impossible : Roblox réessaiera")
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

----------------------------------------------------------------------
-- Données sauvegardées (Boost, Purchases)
----------------------------------------------------------------------

local function sanitizeData(data)
	local boost = data.Boost
	if not isValidNumber(boost.Multiplier) or not isValidNumber(boost.EndsAt)
		or boost.Multiplier < 1 or boost.Multiplier > MAX_BOOST_MULTIPLIER or boost.EndsAt <= os.time() then
		data.Boost = { Multiplier = 1, EndsAt = 0 }
	end

	local purchases = {}
	for _, id in ipairs(data.Purchases) do
		if type(id) == "string" then
			table.insert(purchases, id)
		end
	end
	while #purchases > MAX_PURCHASES_KEPT do
		table.remove(purchases, 1)
	end
	data.Purchases = purchases
end

----------------------------------------------------------------------
-- Commande de test /pass (Studio uniquement, appelée par DebugService)
----------------------------------------------------------------------

function MonetizationService:DebugTogglePass(player: Player, passId: string): boolean?
	local owner = owners[player]
	if not owner or not Config.GamePassesById[passId] then
		return nil
	end
	local owned = not self:OwnsPass(player, passId)
	owner.Debug[passId] = owned
	services.GameService:MarkDirty(player)
	return owned
end

----------------------------------------------------------------------
-- Cycle de vie
----------------------------------------------------------------------

function MonetizationService:PlayerReady(player: Player, data)
	owners[player] = { Passes = {}, Themes = {}, Debug = {}, AutoClickCarry = 0, PendingChecks = 0 }
	sanitizeData(data)
	checkAllPasses(player)
end

function MonetizationService:PlayerRemoving(player: Player)
	owners[player] = nil
end

function MonetizationService:Start()
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId, wasPurchased)
		local ok, err = pcall(onGamePassPurchaseFinished, player, gamePassId, wasPurchased)
		if not ok then
			warn("[MonetizationService] Erreur après l'achat d'un Game Pass :", err)
		end
	end)

	MarketplaceService.ProcessReceipt = function(receiptInfo)
		local ok, decision = pcall(processReceipt, receiptInfo)
		if ok and decision then
			return decision
		end
		warn("[MonetizationService] Erreur ProcessReceipt :", decision)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	if Config.Casino.Enabled and not self:IsCasinoEnabled() then
		print("[Dopamine Clicker] DisableCasinoWhenSelling = true : la machine chanceuse est fermée.")
	end
end

return MonetizationService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="228">
        <Properties>
          <string name="Name">QuestService</string>
          <string name="Source"><![CDATA[--[[
	QuestService (ModuleScript)
	Emplacement : ServerScriptService > Services > QuestService

	Quêtes simples (ex. "Fais 50 clics"). Le joueur a toujours
	Config.Quests.ActiveCount quêtes actives. Une quête terminée donne sa
	récompense automatiquement et est remplacée par une nouvelle.
	  - Un modèle avec une Feature n'est proposé que si le joueur la possède.
	  - Les quêtes n'avancent qu'une fois le menu "Quêtes" débloqué.
	  - Types : Clicks, Earn, Buy, Bounces, Bubbles, Spawns, Combo, Casino, Chests.
	  - Les quêtes sont gardées après une détox.
	  - Chaque quête contient Type, Goal, Progress, Reward et Text. Text est
	    écrit dans la langue du joueur (compatibilité) ; le client devrait
	    plutôt afficher Locale.T(Config.Quests.Pool[Type].Text, Format(Goal))
	    (voir QuestService.GetTemplate / FormatText).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Locale = require(ReplicatedStorage.Shared.Locale)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)

local QuestService = {}

local services
local random = Random.new()

local QUESTS_FEATURE = "Quests"

-- Types de quêtes existants (d'après la config) : [Type] = modèle
local validTypes = {}
local templatesByType = {}
for _, template in ipairs(Config.Quests.Pool) do
	validTypes[template.Type] = true
	templatesByType[template.Type] = template
end

-- Modèle (Config.Quests.Pool) d'un type de quête
function QuestService.GetTemplate(questType: string)
	return templatesByType[questType]
end

-- Texte d'une quête dans la langue `lang` (ex. "Click 50 times" / "Fais 50 clics")
function QuestService.FormatText(lang: string, questType: string, goal: number): string
	local template = templatesByType[questType]
	if not template then
		return ""
	end
	return Locale.TFor(lang, template.Text, NumberFormatter.Format(goal))
end

function QuestService:Init(allServices)
	services = allServices
end

local function isTemplateAvailable(data, template): boolean
	return template.Feature == nil or Formulas.HasFeature(data, template.Feature)
end

-- Crée une nouvelle quête en évitant les types déjà actifs
local function generateQuest(player: Player, data, activeQuests)
	local usedTypes = {}
	for _, quest in ipairs(activeQuests) do
		usedTypes[quest.Type] = true
	end

	local available = {}
	local candidates = {}
	for _, template in ipairs(Config.Quests.Pool) do
		if isTemplateAvailable(data, template) then
			table.insert(available, template)
			if not usedTypes[template.Type] then
				table.insert(candidates, template)
			end
		end
	end
	if #candidates == 0 then
		candidates = (#available > 0) and available or Config.Quests.Pool
	end

	local template = candidates[random:NextInteger(1, #candidates)]
	local stats = services.GameService:GetStats(player)

	local goal
	if template.GoalSeconds then
		-- Objectif "à l'échelle" : X secondes de production
		local seconds = template.GoalSeconds[random:NextInteger(1, #template.GoalSeconds)]
		goal = Formulas.ScaledReward(stats, seconds, template.MinGoal or 100)
	else
		goal = template.Goals[random:NextInteger(1, #template.Goals)]
	end

	return {
		Type = template.Type,
		Goal = goal,
		Progress = 0,
		-- Texte dans la langue du joueur (le client peut le recalculer depuis Type + Goal)
		Text = QuestService.FormatText(services.GameService:GetLanguage(player), template.Type, goal),
		Reward = Formulas.ScaledReward(stats, template.RewardSeconds, template.MinReward),
	}
end

local function isValidQuest(quest): boolean
	return type(quest) == "table"
		and type(quest.Type) == "string"
		and validTypes[quest.Type] == true
		and type(quest.Goal) == "number"
		and type(quest.Progress) == "number"
		and type(quest.Text) == "string"
		and type(quest.Reward) == "number"
end

-- Complète la liste des quêtes si nécessaire (nouveau joueur, config modifiée...)
function QuestService:PlayerReady(player: Player, data)
	-- Nettoie les quêtes invalides ou dont le type n'existe plus dans la config
	local cleaned = {}
	for _, quest in ipairs(data.Quests) do
		if isValidQuest(quest) and #cleaned < Config.Quests.ActiveCount then
			table.insert(cleaned, quest)
		end
	end
	data.Quests = cleaned

	-- Texte réécrit dans la langue actuelle du joueur (elle a pu changer depuis
	-- la dernière partie, ou venir d'une ancienne sauvegarde en français)
	local lang = Locale.ForPlayer(player, data.Settings.Language)
	for _, quest in ipairs(data.Quests) do
		quest.Text = QuestService.FormatText(lang, quest.Type, quest.Goal)
	end

	while #data.Quests < Config.Quests.ActiveCount do
		table.insert(data.Quests, generateQuest(player, data, data.Quests))
	end
end

-- Remplace toutes les quêtes par des nouvelles (à l'échelle de la production actuelle)
function QuestService:Regenerate(player: Player)
	local data = services.DataService:GetData(player)
	if not data then
		return
	end
	data.Quests = {}
	while #data.Quests < Config.Quests.ActiveCount do
		table.insert(data.Quests, generateQuest(player, data, data.Quests))
	end
	services.GameService:MarkDirty(player)
end

-- Fait avancer les quêtes d'un type donné
function QuestService:Progress(player: Player, questType: string, amount: number)
	local data = services.DataService:GetData(player)
	if not data or type(amount) ~= "number" or amount ~= amount or amount <= 0 then
		return
	end
	if not Formulas.HasFeature(data, QUESTS_FEATURE) then
		return -- menu des quêtes pas encore débloqué
	end

	local completed = {}
	for index, quest in ipairs(data.Quests) do
		if quest.Type == questType and quest.Progress < quest.Goal then
			quest.Progress = math.min(quest.Goal, quest.Progress + amount)
			if quest.Progress >= quest.Goal then
				table.insert(completed, index)
			end
		end
	end

	if #completed == 0 then
		return
	end

	-- D'abord on remplace les quêtes terminées, ENSUITE on donne les récompenses
	-- (évite de modifier la liste pendant qu'on la parcourt)
	local rewards = {}
	for _, index in ipairs(completed) do
		local quest = data.Quests[index]
		table.insert(rewards, quest)
		data.Stats.QuestsCompleted += 1
		local others = table.clone(data.Quests)
		table.remove(others, index)
		data.Quests[index] = generateQuest(player, data, others)
	end

	local lang = services.GameService:GetLanguage(player)
	for _, quest in ipairs(rewards) do
		services.GameService:AddDopamine(player, quest.Reward, false)
		services.GameService:Notify(player, {
			Type = "Quest",
			Title = Locale.TFor(lang, "QUEST COMPLETE!"),
			Text = "📜 " .. QuestService.FormatText(lang, quest.Type, quest.Goal)
				.. "  (+" .. NumberFormatter.Format(quest.Reward) .. ")",
			-- Pour que le client puisse réécrire le texte lui-même
			QuestType = quest.Type,
			Goal = quest.Goal,
			Reward = quest.Reward,
		})
	end
	services.GameService:MarkDirty(player)
end

return QuestService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="229">
        <Properties>
          <string name="Name">RateLimiter</string>
          <string name="Source"><![CDATA[--[[
	RateLimiter (ModuleScript)
	Emplacement : ServerScriptService > Services > RateLimiter

	Anti-spam simple : empêche un joueur d'appeler une action plus souvent
	que l'intervalle donné (protection contre les exploits qui spamment
	les RemoteEvents).
]]

local Players = game:GetService("Players")

local RateLimiter = {}

-- [Player] = { [clé] = dernière heure d'appel }
local lastCalls = {}

-- Renvoie true si l'action est autorisée, false si le joueur va trop vite
function RateLimiter.Check(player: Player, key: string, interval: number): boolean
	local now = os.clock()
	local playerCalls = lastCalls[player]
	if not playerCalls then
		playerCalls = {}
		lastCalls[player] = playerCalls
	end

	local last = playerCalls[key]
	if last and now - last < interval then
		return false
	end
	playerCalls[key] = now
	return true
end

Players.PlayerRemoving:Connect(function(player)
	lastCalls[player] = nil
end)

return RateLimiter
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="230">
        <Properties>
          <string name="Name">ThemeService</string>
          <string name="Source"><![CDATA[--[[
	ThemeService (ModuleScript)
	Emplacement : ServerScriptService > Services > ThemeService

	Thèmes (fonds d'écran, Config.Themes), gardés pour toujours (même après
	l'océan). Un thème est possédé s'il a été acheté avec la Dopamine
	(data.Themes.Owned), si c'est un thème Premium et que le joueur est VIP,
	ou si le joueur possède le Game Pass du thème (vérifié par
	MonetizationService). RemoteFunction ThemeShop ("buy" | "equip", themeId).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Net = require(ReplicatedStorage.Shared.Net)
local RateLimiter = require(script.Parent.RateLimiter)

local ThemeService = {}

local services

local DEFAULT_THEME = Config.ThemesById.Classic and "Classic" or (Config.Themes[1] and Config.Themes[1].Id) or "Classic"

local function isValidNumber(value): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

function ThemeService:Init(allServices)
	services = allServices
end

-- Le joueur possède-t-il ce thème (achat, VIP ou Game Pass) ?
function ThemeService:Owns(player: Player, themeId: string): boolean
	local theme = Config.ThemesById[themeId]
	if not theme then
		return false
	end
	local data = services.DataService:GetData(player)
	if data and data.Themes.Owned[themeId] == true then
		return true
	end
	if theme.Premium and services.MonetizationService:IsVIP(player) then
		return true
	end
	return services.MonetizationService:OwnsThemePass(player, themeId)
end

-- État envoyé au client : { Owned = { [id] = true }, Equipped = id }
function ThemeService:GetState(player: Player)
	local owned = {}
	for _, theme in ipairs(Config.Themes) do
		if self:Owns(player, theme.Id) then
			owned[theme.Id] = true
		end
	end
	-- Le thème équipé n'est pas effacé des données s'il n'est plus possédé
	-- (vérification des Game Passes pas encore finie) : on affiche juste le thème par défaut.
	local data = services.DataService:GetData(player)
	local equipped = data and data.Themes.Equipped
	if type(equipped) ~= "string" or not owned[equipped] then
		equipped = DEFAULT_THEME
	end
	return { Owned = owned, Equipped = equipped }
end

-- Texte dans la langue du joueur
local function T(player: Player, text: string, ...): string
	return services.GameService:T(player, text, ...)
end

local function onThemeShop(player: Player, action: any, themeId: any)
	if not RateLimiter.Check(player, "ThemeShop", 0.2) then
		return false, T(player, "Slow down!")
	end
	local data = services.DataService:GetData(player)
	if not data or not services.GameService:IsReady(player) then
		return false, T(player, "Loading...")
	end
	if type(action) ~= "string" or type(themeId) ~= "string" or #themeId > 64 then
		return false, T(player, "Invalid request")
	end
	local theme = Config.ThemesById[themeId]
	if not theme then
		return false, T(player, "Unknown theme")
	end
	local themes = data.Themes
	local name = T(player, theme.Name)

	if action == "buy" then
		if ThemeService:Owns(player, themeId) then
			return false, T(player, "You already own this theme")
		end
		local cost = theme.Cost
		if cost == nil then
			if theme.Premium then
				return false, T(player, "This theme is unlocked with Robux (or the VIP pass)")
			end
			return false, T(player, "This theme is unlocked with Robux")
		end
		if not isValidNumber(cost) or cost < 0 then
			return false, T(player, "Theme unavailable")
		end
		if data.Dopamine < cost then
			return false, T(player, "Not enough %s", Config.Game.CurrencyName)
		end
		data.Dopamine -= cost
		themes.Owned[themeId] = true
		themes.Equipped = themeId -- équipé tout de suite
		data.Stats.ThemesBought += 1
		services.GameService:SendState(player)
		return true, T(player, "%s %s theme bought! (%s)", theme.Icon, name, NumberFormatter.Format(cost))
	elseif action == "equip" then
		if not ThemeService:Owns(player, themeId) then
			return false, T(player, "You don't own this theme")
		end
		themes.Equipped = themeId
		services.GameService:SendState(player)
		return true, T(player, "%s %s theme equipped", theme.Icon, name)
	end
	return false, T(player, "Invalid request")
end

-- Commande de test /theme (Studio) : donne et équipe un thème
function ThemeService:DebugGrant(player: Player, themeId: string): boolean
	local data = services.DataService:GetData(player)
	if not data or not Config.ThemesById[themeId] then
		return false
	end
	data.Themes.Owned[themeId] = true
	data.Themes.Equipped = themeId
	services.GameService:MarkDirty(player)
	return true
end

-- Corrige une sauvegarde abîmée (thème supprimé de la config...)
function ThemeService:PlayerReady(player: Player, data)
	local themes = data.Themes
	for id, value in pairs(themes.Owned) do
		if value ~= true or type(id) ~= "string" or not Config.ThemesById[id] then
			themes.Owned[id] = nil
		end
	end
	themes.Owned[DEFAULT_THEME] = true
	if type(themes.Equipped) ~= "string" or not Config.ThemesById[themes.Equipped] then
		themes.Equipped = DEFAULT_THEME
	end
end

function ThemeService:Start()
	Net.Function("ThemeShop").OnServerInvoke = onThemeShop
end

return ThemeService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="231">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="232">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="233">
        <Properties>
          <string name="Name">ClientMain</string>
          <string name="Source"><![CDATA[--[[
	ClientMain (LocalScript)
	Emplacement : StarterPlayer > StarterPlayerScripts > ClientMain

	Point d'entrée du client : construit toute l'interface en code, lance
	le gestionnaire de stimuli et branche les RemoteEvents. Aucune logique
	de gain ici : le client affiche et envoie des DEMANDES, le serveur décide.
	Un écran de chargement (LoadingScreen) couvre tout jusqu'au premier état.
	v4 : fenêtre "Bon retour !" (gain hors-ligne), panneau "🛠️ Test" et
	commandes de chat de test (/give, /unlockall...) UNIQUEMENT dans Studio.
	v5 : langue (anglais par défaut, français automatique) choisie AVANT de
	construire l'interface : on attend le premier état (3 s au plus) pour
	lire le réglage "Language", sinon langue Roblox du joueur. Mode sombre
	(DarkSkin) appliqué à la colonne centrale, aux fenêtres et aux bandeaux.
	Maison : fenêtre "🏠 Ma maison" (Panels > House), ouverte par le bouton
	🏠 à droite de "Click me" (chargée sans bloquer le reste en cas d'erreur).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local GuiService = game:GetService("GuiService")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")

local Client = ReplicatedStorage:WaitForChild("Client")
local Components = Client:WaitForChild("Components")
local Panels = Components:WaitForChild("Panels")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Net = require(Shared:WaitForChild("Net"))
local Locale = require(Shared:WaitForChild("Locale"))
local Interface = require(Client:WaitForChild("Interface"))
local ClientState = require(Client:WaitForChild("ClientState"))
local SoundManager = require(Client:WaitForChild("SoundManager"))
local DarkSkin = require(Client:WaitForChild("DarkSkin"))
local LoadingScreen = require(Components:WaitForChild("LoadingScreen"))

local FIRST_STATE_WAIT = 3 -- (s) attente max du premier état avant de choisir la langue

-- Le sac à dos (outils) ne sert à rien ici. La liste des joueurs (leaderstats)
-- et la fenêtre de chat recouvriraient les emplacements R1 / L1 et captureraient
-- les clics : le jeu a déjà son propre classement.
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
end)
-- (Dans Studio on garde le chat : il sert à taper les commandes de test /give, /rush...)
if not RunService:IsStudio() then
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, false)
	end)
	pcall(function()
		TextChatService.ChatWindowConfiguration.Enabled = false
	end)
end
-- Pas de joystick / bouton de saut tactiles : ils prendraient les appuis
-- destinés aux emplacements du bas (Runner, Lofi...)
pcall(function()
	GuiService.TouchControlsEnabled = false
end)

-- 1. Services de base
SoundManager.Init()
ClientState.Init()

-- 2. Écran et calques (+ écran de chargement par-dessus, jusqu'au premier état)
Interface.Build()
LoadingScreen.Show()

-- Mode sombre de l'interface (réglage ⚙️, thème sombre ou mode néon)
ClientState.DarkModeChanged:Connect(DarkSkin.SetEnabled)
DarkSkin.SetEnabled(ClientState.DarkMode)

-- 3. Langue : réglage sauvegardé (premier état) sinon langue Roblox du joueur,
-- choisie AVANT de construire l'interface (pas de reconstruction ensuite)
if not ClientState.IsLoaded then
	local received = false
	local connection = ClientState.Loaded:Connect(function()
		received = true
	end)
	local started = os.clock()
	while not received and os.clock() - started < FIRST_STATE_WAIT do
		task.wait(0.05)
	end
	connection:Disconnect()
end
Locale.SetLanguage(ClientState.ResolveLanguage())

-- Modules d'interface (chargés après le choix de la langue)
local Effects = require(Client:WaitForChild("Effects"))
local Slots = require(Client:WaitForChild("Slots"))
local StimulusManager = require(Client:WaitForChild("StimulusManager"))
local Background = require(Components:WaitForChild("Background"))
local Notifications = require(Components:WaitForChild("Notifications"))
local PanelManager = require(Components:WaitForChild("PanelManager"))
local CenterColumn = require(Components:WaitForChild("CenterColumn"))
local OfflinePopup = require(Components:WaitForChild("OfflinePopup"))
local AchievementPopup = require(Components:WaitForChild("AchievementPopup"))
local NeedDopamine = require(Components:WaitForChild("NeedDopamine"))
local DebugTools = require(Components:WaitForChild("DebugTools"))

local layers = Interface.Layers
Effects.Init(layers.Effects)
Background.Build(layers.Background)
DarkSkin.Register(layers.Main)
DarkSkin.Register(layers.Panels)
DarkSkin.Register(layers.Toasts)

-- 4. Toasts et fenêtres
Notifications.Build(layers.Toasts)
OfflinePopup.Build(layers.Toasts)
AchievementPopup.Build(layers.Toasts)
NeedDopamine.Build(layers.Toasts)
require(Components:WaitForChild("OfferPopup")).Build(layers.Toasts) -- 💎 offres Robux discrètes (Config.Monetization.Offers)
PanelManager.Build(layers.Panels)
PanelManager.Register("ScreenTime", require(Panels:WaitForChild("ScreenTime")))
PanelManager.Register("ItemShop", require(Panels:WaitForChild("ItemShop")))
PanelManager.Register("Achievements", require(Panels:WaitForChild("Achievements")))
PanelManager.Register("Quests", require(Panels:WaitForChild("Quests")))
PanelManager.Register("Leaderboard", require(Panels:WaitForChild("Leaderboard")))
PanelManager.Register("Daily", require(Panels:WaitForChild("Daily")))
PanelManager.Register("Settings", require(Panels:WaitForChild("Settings")))
PanelManager.Register("RobuxShop", require(Panels:WaitForChild("RobuxShop")))

-- 🏠 Ma maison : une erreur de chargement ne doit pas bloquer le reste de l'interface
do
	local ok, module = pcall(require, Panels:WaitForChild("House"))
	if ok and type(module) == "table" then
		PanelManager.Register("House", module)
	else
		warn("[ClientMain] Erreur au chargement du panneau House : " .. tostring(module))
	end
end

-- 🕹️ Arcade (mini-jeux, duels) : chargée sans bloquer le reste en cas d'erreur
do
	local arcadeModule = Panels:FindFirstChild("Arcade")
	if arcadeModule and arcadeModule:IsA("ModuleScript") then
		local ok, module = pcall(require, arcadeModule)
		if ok and type(module) == "table" then
			PanelManager.Register("Arcade", module)
		else
			warn("[ClientMain] Erreur au chargement du panneau Arcade : " .. tostring(module))
		end
	end
end

-- Outils de test : UNIQUEMENT dans Studio (panneau "🛠️ Test" + commandes de chat)
if DebugTools.Enabled then
	local debugModule = Panels:FindFirstChild("Debug")
	if debugModule and debugModule:IsA("ModuleScript") then
		local ok, module = pcall(require, debugModule)
		if ok and type(module) == "table" then
			PanelManager.Register("Debug", module)
		else
			warn("[ClientMain] Erreur au chargement du panneau Debug : " .. tostring(module))
		end
	end
	DebugTools.OpenPanel = function()
		if PanelManager.IsRegistered("Debug") then
			PanelManager.Open("Debug")
		end
	end
	DebugTools.RegisterChatCommands()
end

-- Panneau des thèmes : chargé à part (sans bloquer le reste de l'interface)
task.spawn(function()
	local moduleScript = Panels:WaitForChild("Themes", 15)
	if not moduleScript or not moduleScript:IsA("ModuleScript") then
		warn("[ClientMain] Panneau Themes introuvable")
		return
	end
	local ok, module = pcall(require, moduleScript)
	if ok and type(module) == "table" then
		PanelManager.Register("Themes", module)
	else
		warn("[ClientMain] Erreur au chargement du panneau Themes : " .. tostring(module))
	end
end)

-- 5. Colonne centrale (bouton, compteur, menus, améliorations).
-- (les emplacements des stimuli s'adaptent d'abord à l'écran : la colonne
-- en a besoin sur téléphone)
-- L'infobulle des améliorations va dans le calque Panels (au-dessus des stimuli).
Slots.Bind(Interface)
CenterColumn.Build(layers.Main, layers.Panels, layers.Effects)

-- 6. Stimuli (tout ce qui apparaît à l'écran avec les améliorations)
StimulusManager.Init()

-- 7. Notifications du serveur : toasts + stimuli (bonus, océan)
ClientState.SetNotifyHandler(function(payload)
	Notifications.Handle(payload)
	StimulusManager.HandleNotify(payload)
end)
ClientState.RushChanged:Connect(function(rush)
	Background.SetRush(rush.Active == true)
end)

-- 8. Musique : seulement avec "Lofi Beats" (le réglage Musique est géré par le panneau Paramètres)
ClientState.FeaturesChanged:Connect(function()
	SoundManager.SetMusicAllowed(ClientState.HasFeature("Lofi"))
end)

-- 9. Au premier état reçu : on ouvre le cadeau du jour s'il est disponible
-- (après l'écran de chargement, et après la fenêtre "Bon retour !" si elle est là)
local firstState
firstState = ClientState.Changed:Connect(function(data)
	firstState:Disconnect()
	if ClientState.HasFeature("Daily") and data.Daily and data.Daily.Available then
		task.delay(2.6, function()
			if OfflinePopup.IsVisible() then
				while OfflinePopup.IsVisible() do
					task.wait(0.25)
				end
				task.wait(0.4)
			end
			if not PanelManager.IsOpen() then
				PanelManager.Open("Daily")
			end
		end)
	end
end)

-- 10. On prévient le serveur que l'interface est prête
Net.Event("ClientReady"):FireServer()
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>

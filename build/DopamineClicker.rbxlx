----------------------------------------------------------------------
-- Trajectoire : voie extérieure du boulevard (polygone arrondi aux angles)
----------------------------------------------------------------------

local function townFolder(): Instance?
	return workspace:FindFirstChild("DopamineTown")
end

local function plotCount(town: Instance?): number
	local count = town and town:GetAttribute("PlotCount")
	return type(count) == "number" and count or WorldLayout.PlotCount(Players.MaxPlayers)
end

-- (v10) Trajectoire d'un circuit : polyligne fermée (repère ville), un
-- décalage de voie et une limitation par tronçon ; décalage à droite du sens
-- (onglet aux sommets), virages arrondis (Bézier), pas de 8 studs au plus
local LIMIT_AHEAD = { 40, 90, 150 }

local function pathFromLoop(pts: { any }, offsets: { number }, speeds: { number }): Path
	local O = WorldLayout.Origin()
	local n = #pts
	-- sommets décalés
	local shifted: { Vector3 } = {}
	local vSpeed: { number } = {}
	for i = 1, n do
		local prev = pts[(i - 2) % n + 1]
		local cur = pts[i]
		local nxt = pts[i % n + 1]
		local function normal(a: any, b: any): (number, number)
			local dx, dz = b.X - a.X, b.Z - a.Z
			local len = math.sqrt(dx * dx + dz * dz)
			if len < 1e-6 then
				return 0, 0
			end
			return -dz / len, dx / len -- (à droite du sens)
		end
		local nax, naz = normal(prev, cur)
		local nbx, nbz = normal(cur, nxt)
		local oa = offsets[(i - 2) % n + 1]
		local ob = offsets[i]
		local dot = nax * nbx + naz * nbz
		local k = 1 / math.max(0.3, 1 + dot)
		local ox = (nax * oa + nbx * ob) * k
		local oz = (naz * oa + nbz * ob) * k
		if nax == 0 and naz == 0 then
			ox, oz = nbx * ob, nbz * ob
		elseif nbx == 0 and nbz == 0 then
			ox, oz = nax * oa, naz * oa
		end
		shifted[i] = Vector3.new(O.X + cur.X + ox, O.Y + cur.Y, O.Z + cur.Z + oz)
		vSpeed[i] = math.min(speeds[(i - 2) % n + 1], speeds[i])
	end
	-- virages arrondis + lignes droites découpées
	local out: { Vector3 } = {}
	local outSpeed: { number } = {}
	local cornerIdx: { { I: number, Turn: number } } = {}
	local function push(p: Vector3, sp: number)
		table.insert(out, p)
		table.insert(outSpeed, sp)
	end
	local cuts: { { A: Vector3, B: Vector3 } } = {}
	for i = 1, n do
		local prev = shifted[(i - 2) % n + 1]
		local c = shifted[i]
		local nxt = shifted[i % n + 1]
		local dIn = c - prev
		local dOut = nxt - c
		local lenIn, lenOut = dIn.Magnitude, dOut.Magnitude
		local turn = 0
		if lenIn > 1e-3 and lenOut > 1e-3 then
			local fin, fout = Vector3.new(dIn.X, 0, dIn.Z), Vector3.new(dOut.X, 0, dOut.Z)
			if fin.Magnitude > 1e-3 and fout.Magnitude > 1e-3 then
				turn = math.acos(math.clamp(fin.Unit:Dot(fout.Unit), -1, 1))
			end
		end
		local radius = if turn > math.rad(8) then math.min(if turn > math.rad(60) then 14 else 30, lenIn * 0.45, lenOut * 0.45) else 0
		if radius > 0.5 then
			cuts[i] = { A = c - dIn.Unit * radius, B = c + dOut.Unit * radius }
		else
			cuts[i] = { A = c, B = c }
		end
	end
	for i = 1, n do
		local c = shifted[i]
		local cut = cuts[i]
		local nxtCut = cuts[i % n + 1]
		local sp = vSpeed[i]
		if cut.A ~= cut.B then
			local prev = shifted[(i - 2) % n + 1]
			local nxt = shifted[i % n + 1]
			local dIn = (c - prev).Unit
			local dOut = (nxt - c).Unit
			if math.acos(math.clamp(Vector3.new(dIn.X, 0, dIn.Z).Unit:Dot(Vector3.new(dOut.X, 0, dOut.Z).Unit), -1, 1)) > math.rad(30) then
				table.insert(cornerIdx, { I = #out + 5, Turn = if dIn:Cross(dOut).Y > 0 then -1 else 1 })
			end
			for j = 0, 9 do
				local t = j / 10
				local u = 1 - t
				push(cut.A * (u * u) + c * (2 * u * t) + cut.B * (t * t), sp)
			end
		else
			push(c, sp)
		end
		-- ligne droite jusqu'au prochain virage (pas <= 8 studs)
		local startP, endP = cut.B, nxtCut.A
		local len = (endP - startP).Magnitude
		local steps = math.max(1, math.floor(len / 8))
		local segSpeed = speeds[i]
		for j = 1, steps - 1 do
			push(startP:Lerp(endP, j / steps), segSpeed)
		end
	end
	local cum = { 0 }
	for i = 2, #out do
		cum[i] = cum[i - 1] + (out[i] - out[i - 1]).Magnitude
	end
	local total = cum[#out] + (out[1] - out[#out]).Magnitude
	local cornerList = {}
	for _, c in ipairs(cornerIdx) do
		table.insert(cornerList, { S = cum[math.min(c.I, #cum)] or 0, Turn = c.Turn })
	end
	return { Points = out, Cum = cum, Length = total, Corners = cornerList, Speeds = outSpeed }
end

local function r2(v: number): number
	return math.floor(v * 2 + 0.5) / 2
end

local function nodeId(x: number, z: number): string
	return "n" .. r2(x) .. "_" .. r2(z)
end

-- Boucle de waypoints (ids de nœuds) -> points + décalages + limitations + clés d'arêtes
local function loopFrom(count: number, waypoints: { string }, laneOverride: number?): ({ any }?, { number }?, { number }?, { [string]: boolean }?)
	local pts: { any } = {}
	local offs: { number } = {}
	local speeds: { number } = {}
	local keys: { [string]: boolean } = {}
	local graph = WorldLayout.RoadGraph(count)
	-- (bretelles : leur polyligne part de la VOIE de l'autoroute, pas de l'axe
	-- du nœud : on ne repasse jamais par le centre du nœud)
	local lastWasNode = false
	for w = 1, #waypoints do
		local a, b = waypoints[w], waypoints[w % #waypoints + 1]
		local edges, nodes = WorldLayout.RoutePath(count, a, b)
		if not edges or not nodes then
			return nil, nil, nil, nil
		end
		for k, e in ipairs(edges) do
			local from = nodes[k]
			local ep = table.clone(WorldLayout.EdgePoints(e, from))
			local fromNode = graph.Nodes[from]
			local toNode = graph.Nodes[nodes[k + 1]]
			local startsAtNode = fromNode ~= nil and (ep[1].X - fromNode.X) ^ 2 + (ep[1].Z - fromNode.Z) ^ 2 < 0.25
			local endsAtNode = toNode ~= nil and (ep[#ep].X - toNode.X) ^ 2 + (ep[#ep].Z - toNode.Z) ^ 2 < 0.25
			if #pts > 0 then
				if not startsAtNode and lastWasNode then
					-- le point du nœud est remplacé par le départ réel de l'arête
					table.remove(pts)
					table.remove(offs)
					table.remove(speeds)
				elseif startsAtNode and not lastWasNode then
					table.remove(ep, 1)
				end
			end
			lastWasNode = endsAtNode
			local off = laneOverride
			if not off then
				if e.OneWay then
					off = e.LaneOffsets[1] or 0
				elseif e.Highway then
					off = e.LaneOffsets[#e.LaneOffsets] or 21.5
				else
					off = e.Width / 4
				end
			end
			keys[e.A .. "|" .. e.B] = true
			keys[e.B .. "|" .. e.A] = true
			-- voie de droite : décalage appliqué à la polyligne de l'arête (onglets internes)
			if off ~= 0 and #ep >= 2 then
				local shiftedEp = {}
				for i = 1, #ep do
					local pa = ep[math.max(1, i - 1)]
					local pb = ep[math.min(#ep, i + 1)]
					local c = ep[i]
					local function nrm(p0: any, p1: any): (number, number)
						local dx, dz = p1.X - p0.X, p1.Z - p0.Z
						local len = math.sqrt(dx * dx + dz * dz)
						if len < 1e-6 then
							return 0, 0
						end
						return -dz / len, dx / len
					end
					local n1x, n1z = nrm(pa, c)
					local n2x, n2z = nrm(c, pb)
					if i == 1 then
						n1x, n1z = n2x, n2z
					elseif i == #ep then
						n2x, n2z = n1x, n1z
					end
					local miter = 1 / math.max(0.3, 1 + n1x * n2x + n1z * n2z)
					shiftedEp[i] = { X = c.X + (n1x + n2x) * off * miter, Y = c.Y, Z = c.Z + (n1z + n2z) * off * miter }
				end
				ep = shiftedEp
			end
			off = 0
			for i = 1, #ep do
				local p = ep[i]
				local last = pts[#pts]
				if not last or (last.X - p.X) ^ 2 + (last.Z - p.Z) ^ 2 > 0.01 then
					table.insert(pts, p)
					table.insert(offs, off)
					table.insert(speeds, e.Speed)
				else
					offs[#offs] = off
					speeds[#speeds] = e.Speed
				end
			end
		end
	end
	-- (boucle fermée : le dernier point = le premier)
	local first, last = pts[1], pts[#pts]
	if #pts > 1 and (first.X - last.X) ^ 2 + (first.Z - last.Z) ^ 2 < 0.01 then
		table.remove(pts)
		table.remove(offs)
		table.remove(speeds)
	end
	if #pts < 3 then
		return nil, nil, nil, nil
	end
	return pts, offs, speeds, keys
end

-- Circuits de la ville (v10) : boulevard, autoroute (2 sens, 2 voies),
-- ceinture, tour d'autoroute, une boucle par quartier
local function buildCircuits(count: number): { Circuit }
	local list: { Circuit } = {}
	local B, R = WorldLayout.DOWNTOWN_B, WorldLayout.BeltR(count)
	local low = lowDetail()
	local function add(id: string, pts: { any }?, offs: { number }?, speeds: { number }?, keys: { [string]: boolean }?, cruise: number, n: number, kinds: { any }, bus: boolean?)
		if not pts or not offs or not speeds or not keys then
			return
		end
		local ok, p = pcall(pathFromLoop, pts, offs, speeds)
		if ok and p and p.Length > 50 then
			table.insert(list, {
				Id = id,
				Path = p,
				Cruise = cruise,
				Keys = keys,
				Blocked = false,
				Count = if low then math.max(1, math.ceil(n / 2)) else n,
				Kinds = kinds,
				Bus = bus == true,
			})
		end
	end
	-- 1. boulevard du centre-ville (voie extérieure, comme avant)
	do
		local pts, offs, speeds, keys = loopFrom(count, { nodeId(B, B), nodeId(B, -B), nodeId(-B, -B), nodeId(-B, B) })
		add("Downtown", pts, offs, speeds, keys, TownTraffic.SPEED, 6, TRAFFIC, true)
	end
	-- 2. autoroute : sens extérieur (voie lente + voie rapide) et sens intérieur
	do
		local hw = WorldLayout.HighwayPath(count)
		local g = WorldLayout.RoadGraph(count)
		local keys: { [string]: boolean } = {}
		for _, e in ipairs(g.Edges) do
			if e.Highway then
				keys[e.A .. "|" .. e.B] = true
				keys[e.B .. "|" .. e.A] = true
			end
		end
		local lanes = WorldLayout.HIGHWAY_LANES
		local fwd, rev = {}, {}
		for i = 1, #hw do
			fwd[i] = hw[i]
			rev[i] = hw[#hw - i + 1]
		end
		local function const(v: number, n: number): { number }
			local t = table.create(n, v)
			return t
		end
		local sp = WorldLayout.SPEED.Highway
		add("HighwaySlow", fwd, const(lanes[2], #fwd), const(sp, #fwd), keys, 46, 3, {
			{ "Van", Color3.fromRGB(246, 246, 246) }, { "Pickup", Color3.fromRGB(70, 90, 120) }, { "Van", Color3.fromRGB(230, 200, 90) },
		})
		add("HighwayFast", fwd, const(lanes[1], #fwd), const(sp, #fwd), keys, 62, 3, {
			{ "SportsCar", Color3.fromRGB(220, 30, 40) }, { "SUV", Color3.fromRGB(40, 40, 46) }, { "Hatchback", Color3.fromRGB(210, 214, 220) },
		})
		add("HighwayBack", rev, const(lanes[2], #rev), const(sp, #rev), keys, 54, 4, {
			{ "SUV", Color3.fromRGB(176, 182, 192) }, { "Van", Color3.fromRGB(246, 244, 240) }, { "CityCar", Color3.fromRGB(56, 90, 170) }, { "Limo", Color3.fromRGB(38, 38, 48) },
		})
	end
	-- 3. avenue de ceinture
	do
		local pts, offs, speeds, keys = loopFrom(count, { nodeId(R, R), nodeId(R, -R), nodeId(-R, -R), nodeId(-R, R) })
		add("Belt", pts, offs, speeds, keys, 34, 3, TRAFFIC)
	end
	-- 4. tour d'autoroute : bretelle d'entrée sud, autoroute, sortie ouest, retour
	do
		local anchors = WorldLayout.RaceAnchors(count)
		local H = WorldLayout.HighwayR(count)
		local T = WorldLayout.RAMP_T
		-- (sud : t = +X ; -T = (-T, H) ; ouest : t = +Z ; +T = (-H, T))
		-- (puis le pont de l'échangeur ouest, l'autre sens de l'autoroute et le pont sud)
		local wp = { anchors.RampSCity, nodeId(-T, H), nodeId(-H, T), anchors.RampWCity, anchors.RampWOut }
		if wp[1] and wp[4] and wp[5] then
			local pts, offs, speeds, keys = loopFrom(count, wp)
			add("HighwayTour", pts, offs, speeds, keys, 50, 2, {
				{ "Hatchback", Color3.fromRGB(34, 110, 76) }, { "BubbleCar", Color3.fromRGB(255, 150, 196) },
			})
		end
	end
	-- 4b. l'arrivée : rond-point du dépose-minute (derrière la porte), route de
	-- l'entrée, ceinture, avenue est, rue du marché (jamais de demi-tour)
	do
		local cz = WorldLayout.GateDistance(count) + WorldLayout.ARRIVAL_LOOP
		local rr = WorldLayout.ARRIVAL_LOOP_R
		local mz = WorldLayout.MARKET_STREET_Z
		local wp = { nodeId(0, cz - rr), nodeId(0, R), nodeId(B, R), nodeId(B, mz), nodeId(0, mz) }
		local pts, offs, speeds, keys = loopFrom(count, wp)
		add("Arrival", pts, offs, speeds, keys, 24, 3, TRAFFIC)
	end
	-- 5. une boucle par quartier (ses rues + les avenues autour)
	for _, d in ipairs(WorldLayout.Districts(count)) do
		if #d.Plots > 0 and #d.Streets > 0 then
			local s1 = d.Streets[1]
			local s2 = d.Streets[#d.Streets]
			local alongX = math.abs(s1.Z1 - s1.Z0) < 1e-6
			local wp
			if s1 ~= s2 then
				wp = { nodeId(s1.X0, s1.Z0), nodeId(s1.X1, s1.Z1), nodeId(s2.X1, s2.Z1), nodeId(s2.X0, s2.Z0) }
			else
				-- (une seule rue : on revient par l'avenue du bord de la case)
				local b = d.Bounds
				local h = WorldLayout.GRID_HALF
				if alongX then
					local edgeZ = b.Z - b.D / 2 - h
					wp = { nodeId(s1.X0, s1.Z0), nodeId(s1.X1, s1.Z1), nodeId(s1.X1, edgeZ), nodeId(s1.X0, edgeZ) }
				else
					local edgeX = b.X - b.W / 2 - h
					wp = { nodeId(s1.X0, s1.Z0), nodeId(s1.X1, s1.Z1), nodeId(edgeX, s1.Z1), nodeId(edgeX, s1.Z0) }
				end
			end
			local pts, offs, speeds, keys = loopFrom(count, wp)
			add("District_" .. d.Id, pts, offs, speeds, keys, 22, 2, TRAFFIC)
		end
	end
	return list
end

-- Point de la trajectoire à l'abscisse curviligne s (boucle)
local function pointAt(p: Path, s: number): Vector3
	s = s % p.Length
	local cum = p.Cum
	local lo, hi = 1, #cum
	while hi - lo > 1 do
		local mid = (lo + hi) // 2
		if cum[mid] <= s then
			lo = mid
		else
			hi = mid
		end
	end
	if s >= cum[#cum] then
		lo = #cum
	end
	local a = p.Points[lo]
	local b = p.Points[lo % #p.Points + 1]
	local segEnd = if lo == #cum then p.Length else cum[lo + 1]
	local t = (s - cum[lo]) / math.max(1e-6, segEnd - cum[lo])
	return a:Lerp(b, math.clamp(t, 0, 1))
end

-- Repère au sol (avant = -Z = sens de marche) ; la direction vient d'une base
-- de ±`look` studs (virages lissés)
local function frameAt(p: Path, s: number, look: number?): CFrame
	local d = look or 3
	-- (v9.9) position filtrée sur ±2 studs : plus d'angles vifs entre les
	-- points de la polyligne (trajectoire C1, sans à-coups de direction)
	local pos = (pointAt(p, s - 2) + pointAt(p, s) * 2 + pointAt(p, s + 2)) / 4
	local ahead = pointAt(p, s + d)
	local back = pointAt(p, s - d)
	local dir = ahead - back
	if dir.Magnitude < 1e-3 then
		return CFrame.new(pos)
	end
	return CFrame.lookAt(pos, pos + Vector3.new(dir.X, 0, dir.Z))
end

local function headingOf(cf: CFrame): number
	local l = cf.LookVector
	return math.atan2(-l.X, -l.Z)
end

-- Abscisse du point de la trajectoire le plus proche de `p`
local function nearestS(pa: Path, p: Vector3): number
	local best, bestS = math.huge, 0
	for i, q in ipairs(pa.Points) do
		local d = (q - p).Magnitude
		if d < best then
			best, bestS = d, pa.Cum[i]
		end
	end
	return bestS
end

----------------------------------------------------------------------
-- Véhicules qui roulent
----------------------------------------------------------------------

local function ghost(model: Model)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
		end
	end
end

-- clignotants (4 petits feux orange, éteints = invisibles) + feux stop
local function addLights(model: Model): ({ [number]: { BasePart } }, { BasePart })
	local pivot = model:GetPivot()
	local length = tonumber(model:GetAttribute("Length")) or 12
	local width = tonumber(model:GetAttribute("Width")) or 5.5
	local height = tonumber(model:GetAttribute("Height")) or 5
	local y = math.clamp(height * 0.42, 1.8, 3.4)
	local blinkers: { [number]: { BasePart } } = { [-1] = {}, [1] = {} }
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			local p = Instance.new("Part")
			p.Name = "Blinker"
			p.Size = Vector3.new(0.16, 0.24, 0.5)
			p.CFrame = pivot * CFrame.new(sx * (width / 2 + 0.03), y, sz * (length / 2 - 0.6))
			p.Color = AMBER
			p.Material = Enum.Material.Neon
			p.Transparency = 1
			p.CastShadow = false
			p.Parent = model
			table.insert(blinkers[sx], p)
		end
	end
	local brakes = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Name == "Taillight" then
			d:SetAttribute("OffColor", d.Color)
			d:SetAttribute("OffMaterial", d.Material.Name)
			table.insert(brakes, d)
		end
	end
	return blinkers, brakes
end

-- (Re)construit le modèle d'un véhicule au niveau de détail voulu
local function buildVehicleModel(v: Vehicle, lod: number)
	local old = v.Model
	local model: Model
	if v.IsBus then
		model = VehicleModels.Bus({ Detail = "Light", T = Locale.T })
		model.Name = "TrafficBus"
	else
		model = CarModels.Build(v.Kind, v.Color, { Detail = if lod >= 2 then "Mid" else "Low", Stripe = v.Stripe })
		model.Name = "TrafficCar"
	end
	local pivot = if old and old.Parent then old:GetPivot() else CFrame.new()
	model:PivotTo(CFrame.new())
	local blinkers, brakes = addLights(model)
	ghost(model)
	local rig = CarModels.WheelRig(model)
	v.Rig = rig
	v.Blinkers = blinkers
	v.LightKey = nil
	v.LightRig = nil
	if type((CarModels :: any).LightRig) == "function" and type((CarModels :: any).SetLights) == "function" then
		local okRig, lightRig = pcall((CarModels :: any).LightRig, model)
		if okRig and type(lightRig) == "table" and (#lightRig.Brake + #lightRig.Blink + #lightRig.Head) > 0 then
			v.LightRig = lightRig
		end
	end
	v.Brakes = brakes
	v.BlinkSide = 0
	v.Braking = false
	v.Lod = lod
	-- battants de portes (bus)
	local doors: { DoorLeaf } = {}
	for index, part in ipairs(rig.Body) do
		local door = part:GetAttribute("Door")
		if type(door) == "number" then
			table.insert(doors, { Index = index, Leaf = tonumber(part:GetAttribute("Leaf")) or 1, Door = door })
		end
	end
	v.Doors = doors
	v.DoorOffs = {}
	local length = tonumber(model:GetAttribute("Length")) or 12
	v.HalfLen = length / 2
	v.HalfWidth = (tonumber(model:GetAttribute("Width")) or 5.5) / 2
	local front, back = math.huge, -math.huge
	for _, w in ipairs(rig.Wheels) do
		front = math.min(front, w.Center.Position.Z)
		back = math.max(back, w.Center.Position.Z)
	end
	v.Base = if back > front then back - front else length * 0.6
	model:PivotTo(pivot)
	for i, part in ipairs(rig.Parts) do
		rig.Frames[i] = part.CFrame
	end
	model.Parent = folder
	v.Model = model
	v.Placed = false
	if old and old ~= model then
		old:Destroy()
	end
end

local function addVehicle(kind: string, color: Color3, stripe: boolean, s: number, isBus: boolean, circuit: Circuit?)
	local v: Vehicle = {
		Path = if circuit then circuit.Path else path :: Path,
		Circuit = circuit,
		Hidden = false,
		LightRig = nil,
		LightKey = nil,
		Model = nil :: any,
		Rig = nil,
		Kind = kind,
		Color = color,
		Stripe = stripe,
		Lod = 1,
		S = s,
		Speed = 0,
		Accel = 0,
		Cruise = if isBus then TownTraffic.BUS_SPEED elseif circuit then circuit.Cruise * (0.92 + 0.16 * ((#vehicles * 37) % 11) / 10) else TownTraffic.SPEED,
		HalfLen = 6,
		HalfWidth = 2.8,
		Base = 7,
		IsBus = isBus,
		StopClock = 0,
		LastStopLap = -1,
		Placed = false,
		Skip = 0,
		Blinkers = { [-1] = {}, [1] = {} },
		Brakes = {},
		BlinkSide = 0,
		Braking = false,
		StopLaps = {},
		Spin = 0,
		Steer = 0,
		Heading = nil,
		Pitch = 0,
		Roll = 0,
		Kneel = 0,
		DoorOpen = 0,
		Doors = {},
		DoorOffs = {},
	}
	buildVehicleModel(v, if isBus then 0 else 1)
	table.insert(vehicles, v)
end

local function spawnTraffic()
	-- (v10) chaque circuit reçoit ses véhicules, régulièrement espacés
	for ci, c in ipairs(circuits) do
		local n = c.Count
		local step = c.Path.Length / math.max(1, n)
		local first = 1
		if c.Bus then
			addVehicle("Bus", Color3.new(1, 1, 1), false, step * 0.35, true, c)
			first = 2
		end
		for i = first, n do
			local entry = c.Kinds[(i + ci) % #c.Kinds + 1]
			addVehicle(entry[1], entry[2], (i + ci) % 3 == 0, step * (i - 1 + 0.35), false, c)
		end
	end
end

-- (v10) Courses : les circuits qui passent par une route bloquée sont vidés
local raceModule: any = nil
local function refreshRaceBlocks(count: number)
	local attr = workspace:GetAttribute("DopamineRaceRoutes")
	local active = type(attr) == "string" and attr ~= ""
	local blockedKeys: { [string]: boolean } = {}
	if active then
		if raceModule == nil then
			raceModule = false
			local mod = ReplicatedStorage.Shared:FindFirstChild("RaceRoutes")
			if mod and mod:IsA("ModuleScript") then
				local ok, result = pcall(require, mod)
				if ok and type(result) == "table" then
					raceModule = result
				end
			end
		end
		if raceModule and type(raceModule.BlockedEdgeKeys) == "function" then
			local ok, keys = pcall(raceModule.BlockedEdgeKeys, count)
			if ok and type(keys) == "table" then
				blockedKeys = keys
			end
		end
	end
	for _, c in ipairs(circuits) do
		local blocked = false
		if active then
			for key in pairs(c.Keys) do
				if blockedKeys[key] then
					blocked = true
					break
				end
			end
		end
		c.Blocked = blocked
	end
	for _, v in ipairs(vehicles) do
		local hide = v.Circuit ~= nil and (v.Circuit :: Circuit).Blocked
		if hide ~= v.Hidden then
			v.Hidden = hide
			if v.Model then
				v.Model.Parent = if hide then nil else folder
			end
			v.Placed = false
		end
	end
end

-- Passants de TownPeople (s'ils existent) : les voitures s'arrêtent devant eux
local peopleModule: any = nil
local function peoplePositions(): { Vector3 }
	if peopleModule == nil then
		peopleModule = false
		local module = script.Parent:FindFirstChild("TownPeople")
		if module and module:IsA("ModuleScript") then
			local ok, result = pcall(require, module)
			if ok and type(result) == "table" then
				peopleModule = result
			end
		end
	end
	if peopleModule and type(peopleModule.Positions) == "function" then
		local ok, list = pcall(peopleModule.Positions)
		if ok and type(list) == "table" then
			return list
		end
	end
	return {}
end

-- Positions des personnages (piétons ET conducteurs) + passants
local function refreshBlockers()
	table.clear(blockers)
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			table.insert(blockers, root.Position)
		end
	end
	for _, pos in ipairs(peoplePositions()) do
		if typeof(pos) == "Vector3" then
			table.insert(blockers, pos)
		end
	end
end

-- Quelqu'un sur le passage piéton de l'entrée (ou tout près) ?
local function zebraBusy(): boolean
	local z = zebra
	if not z then
		return false
	end
	for _, pos in ipairs(blockers) do
		local rel = z.CF:PointToObjectSpace(pos)
		if math.abs(rel.X) < 9 and math.abs(rel.Z) < 13 and math.abs(rel.Y) < 10 then
			return true
		end
	end
	return false
end

-- Distance libre devant un véhicule (personnages dans sa voie)
local function clearAhead(v: Vehicle, cf: CFrame, reach: number?): number
	local best = math.huge
	local limit = reach or 28
	for _, pos in ipairs(blockers) do
		local rel = cf:PointToObjectSpace(pos)
		local along = -rel.Z - v.HalfLen
		if along > -v.HalfLen and along < limit and math.abs(rel.X) < v.HalfWidth + 2.5 and math.abs(rel.Y) < 10 then
			best = math.min(best, math.max(0, along))
		end
	end
	return best
end

-- Pose complète : caisse (suspension, génuflexion du bus, portes) + roues
local function poseVehicle(v: Vehicle, pivot: CFrame)
	local rig = v.Rig
	if not rig then
		return
	end
	local frames = rig.Frames
	local lift = 1.0
	local heave = -0.38 * v.Kneel
	local roll = v.Roll - 0.028 * v.Kneel -- (bus : penché côté trottoir, +X)
	local bob = CFrame.new(0, lift + heave, 0) * CFrame.Angles(v.Pitch, 0, roll) * CFrame.new(0, -lift, 0)
	local body = pivot * bob
	local offs = v.DoorOffs
	local i = 0
	for k, off in ipairs(rig.BodyOff) do
		i += 1
		local door = offs[k]
		frames[i] = if door then body * door * off else body * off
	end
	local spinCF = CFrame.Angles(-v.Spin, 0, 0)
	local steerCF = CFrame.Angles(0, v.Steer, 0)
	for _, set in ipairs(rig.Wheels) do
		local c = pivot * set.Center
		local steered = if set.Front then c * steerCF else c
		local spun = steered * spinCF
		for _, off in ipairs(set.SpinOff) do
			i += 1
			frames[i] = spun * off
		end
		for _, off in ipairs(set.SteerOff) do
			i += 1
			frames[i] = steered * off
		end
	end
	workspace:BulkMoveTo(rig.Parts, frames, Enum.BulkMoveMode.FireCFrameChanged)
end

-- Portes du bus : 0 fermées -> 0,35 battants sortis -> 1 glissés
local function updateDoors(v: Vehicle)
	table.clear(v.DoorOffs)
	if #v.Doors == 0 or v.DoorOpen <= 0.001 then
		return
	end
	local o = v.DoorOpen
	local out = 0.2 * math.clamp(o / 0.35, 0, 1)
	local slide = 1.2 * math.clamp((o - 0.35) / 0.65, 0, 1)
	for _, leaf in ipairs(v.Doors) do
		v.DoorOffs[leaf.Index] = CFrame.new(out, 0, leaf.Leaf * slide)
	end
end

local function stepTraffic(dt: number, camPos: Vector3?)
	if #vehicles == 0 then
		return
	end
	rebuiltThisFrame = false
	local range = TownTraffic.MOVE_RANGE * detailScale()
	for _, v in ipairs(vehicles) do
		local p = v.Path
		if v.Hidden or not p then
			continue
		end
		local L = p.Length
		local ideal = L / math.max(1, if v.Circuit then (v.Circuit :: Circuit).Count else #vehicles)
		-- véhicule suivant (même circuit) = plus petite avance positive
		local ahead = math.huge
		local aheadHalf = 0
		for _, o in ipairs(vehicles) do
			if o ~= v and o.Path == p then
				local gap = (o.S - v.S) % L
				if gap < ahead then
					ahead = gap
					aheadHalf = o.HalfLen
				end
			end
		end
		local gap = ahead - v.HalfLen - aheadHalf
		-- vitesse voulue : s'espacer peu à peu (plus vite si le trou devant est grand)
		local target = v.Cruise * (0.85 + 0.3 * math.clamp(gap / ideal, 0, 1))
		if gap < 18 then
			target = math.min(target, math.max(0, (gap - 5) / 13) * v.Cruise)
		end
		-- (v10) limitation de la route (points du circuit)
		local speeds = p.Speeds
		if speeds then
			local lo, hi = 1, #p.Cum
			local sm = v.S % L
			while hi - lo > 1 do
				local mid = (lo + hi) // 2
				if p.Cum[mid] <= sm then
					lo = mid
				else
					hi = mid
				end
			end
			local limit = speeds[lo]
			if limit then
				target = math.min(target, limit)
			end
			-- (v10) on ralentit AVANT une route plus lente (sortie d'autoroute,
			-- bretelle) : v <= sqrt(v_lim² + 2·a·d), a = 5 studs/s²
			for _, d in ipairs(LIMIT_AHEAD) do
				local sa = (v.S + d) % L
				local a0, a1 = 1, #p.Cum
				while a1 - a0 > 1 do
					local mid = (a0 + a1) // 2
					if p.Cum[mid] <= sa then
						a0 = mid
					else
						a1 = mid
					end
				end
				local la = speeds[a0]
				if la then
					target = math.min(target, math.sqrt(la * la + 10 * d))
				end
			end
		end
		local cf = frameAt(p, v.S)
		-- personne devant ? (v10, PHYS10) portée selon la vitesse, freinage normal, urgence si trop près
		local reach = if ImpactRules then ImpactRules.BrakeLookahead(v.Speed) else 28
		local free = clearAhead(v, cf, reach)
		local urgent = false
		local maxDecel: number? = nil
		if ImpactRules then
			if free < reach then
				local tgt, decel, urg = ImpactRules.BrakeTarget(free, v.Speed, v.Cruise)
				target = math.min(target, tgt)
				urgent, maxDecel = urg, decel
			end
		elseif free < 26 then
			target = math.min(target, math.max(0, (free - 4) / 20) * v.Cruise)
			urgent = free < 12
		end
		-- passage piéton de l'entrée (circuit du boulevard)
		local z = if p == path then zebra else nil
		if z then
			local toZebra = (z.S - v.S) % L - v.HalfLen - 9
			if toZebra > -2 and toZebra < 22 and zebraBusy() then
				target = math.min(target, math.max(0, toZebra - 1) / 21 * v.Cruise)
			end
		end
		-- ralentir dans les virages (la courbure se lit sur ±8 studs)
		local h0 = headingOf(frameAt(p, v.S - 4, 4))
		local h1 = headingOf(frameAt(p, v.S + 4, 4))
		local dh = (h1 - h0 + math.pi) % (2 * math.pi) - math.pi
		local curvature = dh / 8
		target = math.min(target, v.Cruise * (1 - math.clamp(math.abs(curvature) * 6, 0, 0.35)))
		-- arrêts de bus (une fois par tour à chaque arrêt : entrée + carrefours)
		if v.IsBus and p == path then
			if v.StopClock > 0 then
				v.StopClock -= dt
				target = 0
			else
				local stops = { busStopS }
				for _, st in ipairs(sideStops) do
					table.insert(stops, st)
				end
				for k, stopS in ipairs(stops) do
					if stopS then
						local lap = math.floor((v.S + 30 - stopS) / L)
						local toStop = (stopS - v.S) % L
						if toStop > L - 3 then
							toStop -= L -- (arrêt dépassé de peu : on s'arrête quand même)
						end
						if toStop < 30 and v.StopLaps[k] ~= lap then
							-- freinage régulier (≈ 2,4 studs/s²) jusqu'au point d'arrêt
							target = math.min(target, math.sqrt(math.max(0, toStop) * 2 * 2.4))
							if toStop < 0.6 and v.Speed < 1.5 then
								v.StopClock = if k == 1 then TownTraffic.BUS_STOP_TIME else TownTraffic.SIDE_STOP_TIME
								v.StopLaps[k] = lap
								v.LastStopLap = lap
							end
						end
					end
				end
			end
			-- génuflexion + portes : s'agenouiller, ouvrir, fermer, se relever
			local stopped = v.StopClock > 0 and v.Speed < 0.3
			local wantKneel = if stopped then 1 else 0
			local wantDoors = if stopped and v.StopClock > 1.4 and v.Kneel > 0.7 then 1 else 0
			if wantDoors == 0 and v.DoorOpen > 0.01 then
				wantKneel = 1 -- (on ne se relève qu'une fois les portes fermées)
			end
			v.DoorOpen += math.clamp(wantDoors - v.DoorOpen, -dt / 1.1, dt / 1.1)
			v.Kneel += math.clamp(wantKneel - v.Kneel, -dt / 1.2, dt / 1.2)
			if v.DoorOpen > 0.01 or v.Kneel > 0.05 then
				target = 0
			end
			updateDoors(v)
		end
		-- clignotant avant les virages du boulevard
		local blink = 0
		for _, c in ipairs(p.Corners) do
			local toCorner = (c.S - v.S) % L
			local past = (v.S - c.S) % L
			if toCorner < TownTraffic.BLINK_AHEAD + v.HalfLen or past < 6 then
				blink = c.Turn
			end
		end
		-- accélération / freinage doux : accélération voulue, puis à-coup limité
		local wantAccel
		if target > v.Speed then
			wantAccel = math.min((target - v.Speed) * 1.2, 2.5 + 3 * math.clamp(v.Speed / v.Cruise, 0, 1))
		else
			-- (ImpactRules.BrakeTarget renvoie une décélération NÉGATIVE : on prend sa valeur absolue)
			local decelMax = if maxDecel then math.abs(maxDecel) else (if urgent then 26 else 9)
			if not urgent then
				decelMax = math.min(decelMax, 9)
			end
			wantAccel = math.max((target - v.Speed) * 1.8, -decelMax)
		end
		local jerk = if urgent then 80 else 14
		v.Accel += math.clamp(wantAccel - v.Accel, -jerk * dt, jerk * dt)
		local before = v.Speed
		v.Speed = math.max(0, v.Speed + v.Accel * dt)
		if v.Speed <= 0 and v.Accel < 0 then
			v.Accel = 0
		end
		if v.Speed > target and target <= 0.01 and v.Speed < 0.15 then
			v.Speed = 0
		end
		v.S += v.Speed * dt -- (non bouclé : sert à compter les tours des arrêts de bus)
		-- feux stop quand on freine (ou à l'arrêt), clignotants (2 Hz)
		local braking = v.Speed < before - 0.02 or (v.Speed < 0.3 and target < 0.5)
		if braking ~= v.Braking then
			v.Braking = braking
			for _, b in ipairs(v.Brakes) do
				b.Color = if braking then BRAKE_ON else (b:GetAttribute("OffColor") or b.Color)
				local off = b:GetAttribute("OffMaterial")
				local ok, mat = pcall(function()
					return (Enum.Material :: any)[off]
				end)
				b.Material = if braking then Enum.Material.Neon elseif ok and mat then mat else Enum.Material.SmoothPlastic
			end
		end
		local on = blink ~= 0 and (os.clock() * 2) % 1 < 0.55
		local side = if on then blink else 0
		-- (v10, CARS10) vrais feux du modèle : stop, clignotants, phares la nuit
		if v.LightRig then
			local clock = Lighting.ClockTime
			local head = clock < 6.6 or clock > 18.2
			local key = (if braking then "B" else "b") .. side .. (if head then "H" else "h")
			if key ~= v.LightKey then
				v.LightKey = key
				pcall(CarModels.SetLights, v.LightRig, { Brake = braking, Blink = side, Head = head })
			end
		end
		if side ~= v.BlinkSide then
			v.BlinkSide = side
			for _, sx in ipairs({ -1, 1 }) do
				for _, b in ipairs(v.Blinkers[sx]) do
					b.Transparency = if sx == side then 0 else 1
				end
			end
		end
		-- roues : rotation + braquage ; caisse : tangage / roulis
		local pivot = frameAt(p, v.S)
		local heading = headingOf(pivot)
		local yawRate = 0
		if v.Heading then
			yawRate = ((heading - v.Heading + math.pi) % (2 * math.pi) - math.pi) / math.max(dt, 1e-3)
		end
		v.Heading = heading
		local radius = if v.Rig and v.Rig.Wheels[1] then v.Rig.Wheels[1].Radius else 1
		v.Spin = (v.Spin + v.Speed / math.max(0.3, radius) * dt) % (math.pi * 2)
		local steerTarget = math.clamp(math.atan(v.Base * curvature), -TownTraffic.MAX_STEER, TownTraffic.MAX_STEER)
		v.Steer += (steerTarget - v.Steer) * math.clamp(dt * 6, 0, 1)
		local pitchTarget = math.clamp(v.Accel * 0.0028, -0.032, 0.022)
		local rollTarget = math.clamp(-v.Speed * yawRate * 0.0035, -0.035, 0.035)
		local k = math.clamp(dt * 5, 0, 1)
		v.Pitch += (pitchTarget - v.Pitch) * k
		v.Roll += (rollTarget - v.Roll) * k
		-- niveau de détail (voitures) : "Mid" près de la caméra
		local dist = if camPos then (pivot.Position - camPos).Magnitude else 0
		if not v.IsBus and not rebuiltThisFrame then
			local want = v.Lod
			if dist < TownTraffic.MID_IN * detailScale() then
				want = 2
			elseif dist > TownTraffic.MID_OUT * detailScale() then
				want = 1
			end
			if want ~= v.Lod then
				rebuiltThisFrame = true
				buildVehicleModel(v, want)
			end
		end
		-- déplacement des pièces : chaque image près de la caméra, ~20 Hz plus loin
		local near = camPos == nil or dist < range
		if near then
			local smooth = camPos == nil or dist < TownTraffic.SMOOTH_RANGE
			v.Skip += 1
			if smooth or v.Skip >= 3 or not v.Placed then
				v.Skip = 0
				-- (petite vibration de la route, proportionnelle à la vitesse)
				local noise = math.sin(os.clock() * 11 + v.S) * 0.012 * math.clamp(v.Speed / 20, 0, 1)
				poseVehicle(v, pivot * CFrame.new(0, noise, 0))
				v.Placed = true
			end
		end
	end
end

----------------------------------------------------------------------
-- Décor en flux (places du serveur) + voitures garées du serveur
----------------------------------------------------------------------

local function buildSpot(spot: Spot, lod: number): Model?
	local c = spot.Config
	local kind = spot.Kind
	local color = c:GetAttribute("Color")
	local variant = c:GetAttribute("Variant")
	local model: Model? = nil
	if kind == "Car" then
		local roof = c:GetAttribute("RoofColor")
		model = CarModels.Build(tostring(c:GetAttribute("CarId") or "CityCar"), color, {
			Detail = if lod >= 2 then "Mid" else "Low",
			Stripe = c:GetAttribute("Stripe") == true,
			RoofColor = if typeof(roof) == "Color3" then roof else nil,
		})
	elseif kind == "Bus" then
		model = VehicleModels.Bus({ Detail = if variant == "Light" then "Light" else "Full", T = Locale.T })
	elseif kind == "DeliveryVan" then
		model = VehicleModels.DeliveryVan({ T = Locale.T })
	elseif kind == "Bike" then
		model = VehicleModels.Bike({ Kind = variant, Color = color })
	elseif kind == "KickScooter" then
		model = VehicleModels.KickScooter({ Color = color })
	elseif kind == "Scooter" then
		model = VehicleModels.Scooter({ Color = color })
	end
	if model then
		model:PivotTo(spot.CF)
		model.Parent = folder
	end
	return model
end

local function readSpots()
	table.clear(spots)
	local town = townFolder()
	local list = town and town:FindFirstChild("VehicleSpots")
	if not list then
		return
	end
	for _, c in ipairs(list:GetChildren()) do
		local cf = c:GetAttribute("CF")
		local kind = c:GetAttribute("Kind")
		if typeof(cf) == "CFrame" and type(kind) == "string" then
			table.insert(spots, { Config = c, Kind = kind, CF = cf, Model = nil, Lod = 0 })
		end
	end
end

local function setLocalHidden(model: Instance, hidden: boolean)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.LocalTransparencyModifier = if hidden then 1 else 0
		elseif d:IsA("SurfaceGui") then
			d.Enabled = not hidden
		end
	end
end

-- voitures garées construites par le serveur (TownKit.Car : version "Low")
local function readParked()
	for _, pk in ipairs(parked) do
		if pk.Local then
			pk.Local:Destroy()
		end
		if pk.Server.Parent then
			setLocalHidden(pk.Server, false)
		end
	end
	table.clear(parked)
	local town = townFolder()
	if not town then
		return
	end
	for _, d in ipairs(town:GetDescendants()) do
		if d:IsA("Model") and type(d:GetAttribute("CarKind")) == "string" then
			local kind = d:GetAttribute("CarKind") :: string
			local spec = CarModels.Specs[kind]
			if spec then
				local color = Color3.new(1, 1, 1)
				for _, q in ipairs(d:GetDescendants()) do
					if q:IsA("BasePart") and q:GetAttribute("Paint") then
						color = q.Color
						break
					end
				end
				local scale = Vector3.new(
					(tonumber(d:GetAttribute("Width")) or spec.W) / spec.W,
					(tonumber(d:GetAttribute("Height")) or spec.Roof) / spec.Roof,
					(tonumber(d:GetAttribute("Length")) or spec.L) / spec.L
				)
				table.insert(parked, { Server = d, Local = nil, Kind = kind, Color = color, Scale = scale })
			end
		end
	end
end

local function stepSpots(center: Vector3)
	local builds = 0
	local mid = TownTraffic.PARKED_IN * detailScale()
	local midOut = TownTraffic.PARKED_OUT * detailScale()
	for _, spot in ipairs(spots) do
		local d = (spot.CF.Position - center).Magnitude
		if spot.Model then
			if d > TownTraffic.SPOT_OUT or not spot.Model.Parent then
				spot.Model:Destroy()
				spot.Model = nil
				spot.Lod = 0
			elseif spot.Kind == "Car" and builds < 2 and ((spot.Lod < 2 and d < mid) or (spot.Lod >= 2 and d > midOut)) then
				-- (v9.9) changement de niveau de détail
				local lod = if d < mid then 2 else 1
				local ok, model = pcall(buildSpot, spot, lod)
				if ok and model then
					spot.Model:Destroy()
					spot.Model = model
					spot.Lod = lod
				end
				builds += 1
			end
		elseif d < TownTraffic.SPOT_IN and builds < 2 then
			local lod = if d < mid then 2 else 1
			local ok, model = pcall(buildSpot, spot, lod)
			if ok then
				spot.Model = model
				spot.Lod = lod
			else
				warn("[TownTraffic] " .. tostring(model))
			end
			builds += 1
		end
	end
	-- voitures garées du serveur : version "Mid" locale quand on s'approche
	for _, pk in ipairs(parked) do
		local server = pk.Server
		if not server.Parent then
			if pk.Local then
				pk.Local:Destroy()
				pk.Local = nil
			end
		else
			local d = (server:GetPivot().Position - center).Magnitude
			if pk.Local and d > midOut then
				pk.Local:Destroy()
				pk.Local = nil
				setLocalHidden(server, false)
			elseif not pk.Local and d < mid and builds < 2 then
				builds += 1
				local ok, model = pcall(CarModels.Build, pk.Kind, pk.Color, { Detail = "Mid", Scale = pk.Scale })
				if ok and model then
					ghost(model)
					model:PivotTo(server:GetPivot())
					model.Name = "ParkedCar"
					model.Parent = folder
					pk.Local = model
					setLocalHidden(server, true)
				end
			end
		end
	end
end

----------------------------------------------------------------------
-- API
----------------------------------------------------------------------

local function cameraPos(): Vector3?
	local camera = workspace.CurrentCamera
	return camera and camera.CFrame.Position or nil
end

local function focusPos(): Vector3?
	if focus then
		return focus
	end
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root.Position
	end
	return cameraPos()
end

function TownTraffic.Start(_options: any?)
	if started then
		return
	end
	started = true
	local old = workspace:FindFirstChild(TownTraffic.FOLDER_NAME)
	if old then
		old:Destroy()
	end
	local f = Instance.new("Folder")
	f.Name = TownTraffic.FOLDER_NAME
	f.Parent = workspace
	folder = f
	local town = townFolder()
	local count = plotCount(town)
	-- (v10) circuits du graphe routier ; le 1er = boulevard du centre-ville
	circuits = buildCircuits(count)
	local p = circuits[1] and circuits[1].Id == "Downtown" and circuits[1].Path or nil
	if not p then
		warn("[TownTraffic] circuit du boulevard introuvable")
		return
	end
	path = p
	-- passage piéton de l'entrée (côté 0, au milieu de la chaussée) + arrêt de bus
	local A = WorldLayout.RingRoadRadius(count)
	local O = WorldLayout.Origin()
	local side0 = CFrame.lookAt(O + Vector3.new(0, WorldLayout.ROAD_Y, A), O + Vector3.new(0, WorldLayout.ROAD_Y, A - 1))
	zebra = { CF = side0, S = nearestS(p, (side0 * CFrame.new(0, 0, WorldLayout.ROAD_W / 4)).Position) }
	busStopS = nearestS(p, (side0 * CFrame.new(26, 0, WorldLayout.ROAD_W / 4)).Position)
	-- 2 autres arrêts : aux carrefours des rues latérales (1/4 et 3/4 du tour)
	table.clear(sideStops)
	local m = WorldLayout.PlotSlots(count)
	local sideR = math.max(1, math.floor(m / 4 + 0.5))
	for _, slot in ipairs({ sideR, m - sideR }) do
		local a = slot / m * math.pi * 2
		local dirv = Vector3.new(math.sin(a), 0, math.cos(a))
		local at = O + dirv * (A + WorldLayout.ROAD_W / 4)
		local tangent = Vector3.new(dirv.Z, 0, -dirv.X)
		table.insert(sideStops, nearestS(p, at + tangent * 22))
	end
	spawnTraffic()
	readSpots()
	readParked()
	local list = town and town:FindFirstChild("VehicleSpots")
	if list then
		table.insert(connections, list.ChildAdded:Connect(function()
			task.defer(function()
				if started then
					for _, s in ipairs(spots) do
						if s.Model then
							s.Model:Destroy()
						end
					end
					readSpots()
				end
			end)
		end))
	end
	refreshBlockers()
	local parkedClock = 0
	table.insert(connections, RunService.Heartbeat:Connect(function(dt: number)
		sensorClock += dt
		spotClock += dt
		parkedClock += dt
		if sensorClock >= 0.1 then
			sensorClock = 0
			refreshBlockers()
		end
		raceClock += dt
		if raceClock >= 1 then
			raceClock = 0
			pcall(refreshRaceBlocks, count)
		end
		-- (v9.9) à chaque image : mouvement lisse (dt borné)
		local ok, err = pcall(stepTraffic, math.min(dt, 0.1), cameraPos())
		if not ok then
			warn("[TownTraffic] " .. tostring(err))
		end
		if parkedClock >= 5 then
			-- (les voitures du serveur peuvent arriver après nous)
			parkedClock = 0
			local count0 = #parked
			local n = 0
			local t = townFolder()
			if t then
				for _, d in ipairs(t:GetDescendants()) do
					if d:IsA("Model") and d:GetAttribute("CarKind") then
						n += 1
					end
				end
			end
			if n ~= count0 then
				readParked()
			end
		end
		if spotClock >= 0.5 then
			spotClock = 0
			local center = focusPos()
			if center then
				local okS, errS = pcall(stepSpots, center)
				if not okS then
					warn("[TownTraffic] " .. tostring(errS))
				end
			end
		end
	end))
end

-- (crochet TownClient, 4 fois / s) : position de l'avatar pour le flux
function TownTraffic.Step(rootPosition: Vector3?)
	if typeof(rootPosition) == "Vector3" then
		focus = rootPosition
	end
end

function TownTraffic.Stop()
	if not started then
		return
	end
	started = false
	for _, c in ipairs(connections) do
		c:Disconnect()
	end
	table.clear(connections)
	for _, pk in ipairs(parked) do
		if pk.Server.Parent then
			setLocalHidden(pk.Server, false)
		end
	end
	table.clear(parked)
	table.clear(vehicles)
	table.clear(circuits)
	table.clear(spots)
	table.clear(blockers)
	path = nil
	zebra = nil
	busStopS = nil
	table.clear(sideStops)
	focus = nil
	sensorClock, spotClock = 0, 0
	if folder then
		folder:Destroy()
		folder = nil
	end
end

function TownTraffic.IsRunning(): boolean
	return started
end

-- (tests / émulateur)
function TownTraffic.Debug(): any
	return {
		Vehicles = vehicles,
		Circuits = circuits,
		RefreshRaceBlocks = refreshRaceBlocks,
		Spots = spots,
		Parked = parked,
		Path = function()
			return path
		end,
		Zebra = function()
			return zebra
		end,
		SideStops = sideStops,
		BusStop = function()
			return busStopS
		end,
		StepTraffic = stepTraffic,
		StepSpots = stepSpots,
		Blockers = blockers,
		RefreshBlockers = refreshBlockers,
		FrameAt = function(s: number): CFrame?
			return path and frameAt(path, s) or nil
		end,
	}
end

return TownTraffic
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="245">
          <Properties>
            <string name="Name">Weather3D</string>
            <string name="Source"><![CDATA[--[[
	Weather3D (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > Weather3D

	v9.8 (REALISM98) 🌦️ météo de Dopamine Town, côté client, AUCUN son.
	  - Cycle DÉTERMINISTE (heure du serveur : workspace:GetServerTimeNow())
	    -> tous les joueurs ont le même temps au même moment. Le temps est
	    découpé en épisodes de 10 min tirés au sort (hachage entier 32 bits,
	    identique sur PC / mobile) :
	      Clear 30 % · Cloudy 22 % · Showers 22 % · Rain 16 % · Storm 10 %
	    (jamais deux orages de suite). Chaque épisode suit un scénario doux :
	    ciel qui se couvre -> pluie fine -> pluie -> (orage) -> éclaircie
	    avec arc-en-ciel -> dégagé. Le début d'un épisode se fond dans la fin
	    du précédent (aucun saut).
	  - Pluie : fines gouttes (Parts minces, déplacées en lot 30 fois / s
	    au plus) dans une boîte autour de la caméra, ancrées au MONDE (on
	    peut marcher dessous), inclinées par le vent ; elles s'arrêtent sur
	    le sol, les toits, les auvents (grille de hauteurs par lancer de
	    rayon, en cache) et y font des éclaboussures (anneaux).
	  - Sol mouillé : routes / trottoirs / pavés de la ville plus sombres et
	    un peu brillants (Color + Reflectance, remis EXACTEMENT à l'arrêt) ;
	    flaques (ellipses sombres et réfléchissantes) qui grandissent après
	    une vraie pluie puis sèchent ; ronds de pluie dessus.
	  - Orage : ciel plus sombre (TownAtmosphere), éclairs DOUX : bref
	    voile (TownAtmosphere : ColorCorrection +0,07 au plus, jamais de
	    "flash bang") + parfois un éclair lointain dessiné (pas de Neon).
	  - Éclaircie : arc-en-ciel discret à l'opposé du soleil (le jour).
	  - Pas de pluie à l'intérieur : quand la caméra est dans une maison /
	    boutique (boîtes intérieures InteriorCF / InteriorSize des boutiques,
	    sinon plafond + murs autour par lancers de rayons, ou la sonde
	    donnée par SetIndoorProbe), les gouttes sont masquées.
	  - Réglages 🎨 (Shared/GraphicsQuality) : Météo On/Off (Off = beau temps
	    fixe, rien d'affiché), intensité de la pluie (Low / Medium / High),
	    Reflets "All" = sol mouillé et flaques plus brillants.
	Budget : ≤ 240 gouttes (High), 36 éclaboussures, 16 flaques, 8 morceaux
	d'éclair, arc-en-ciel 120 pièces seulement pendant l'éclaircie. Travail
	par image : gouttes + éclaboussures (30 Hz max, BulkMoveTo) ; le reste
	2 à 4 fois / s.

	API :
	  Weather3D.Start(opts?)  opts = { IsNight: (() -> boolean)? }
	  Weather3D.Stop()        (tout retiré, sol remis)
	  Weather3D.Step(dt)
	  Weather3D.State() -> { Kind, Phase, Cloud, Rain, Storm, Rainbow, Wet, Puddles, Flash, Indoor, Enabled }
	  Weather3D.At(t) -> même table (sans Flash / Indoor), fonction PURE du temps
	  Weather3D.FlashAt(t, storm) -> 0..1
	  Weather3D.KindOf(index) -> string   (épisode n° index)
	  Weather3D.SetIndoorProbe(fn?)       fn(position) -> boolean
	  Weather3D.SetForcedTime(t?)         (tests / rendus : heure imposée)
	  Weather3D.EPISODE (s)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GraphicsQuality = require(ReplicatedStorage.Shared.GraphicsQuality)

local Weather3D = {}

local EPISODE = 600 -- (s) un épisode de météo
Weather3D.EPISODE = EPISODE
local KINDS = { "Clear", "Cloudy", "Showers", "Rain", "Storm" }
local WEIGHTS = { 0.30, 0.22, 0.22, 0.16, 0.10 }
Weather3D.KINDS = KINDS

-- Gouttes
local DROPS_BASE = 160 -- (Medium ; x0,5 Low ; x1,5 High)
local DROPS_MAX = 240
local BOX_R = 24 -- demi-côté de la boîte de pluie autour de la caméra
local BOX_UP, BOX_DOWN = 26, 18
local FALL_SPEED = 72
local CELL = 4 -- grille des hauteurs d'arrêt (studs)
local SPLASH_MAX = 36
local SPLASH_LIFE = 0.3
local SPLASH_RANGE = 28
local PUDDLE_MAX = 16
local PUDDLE_CELL = 15
local PUDDLE_RANGE = 46
local STEP_RATE = 1 / 30
local PARK = CFrame.new(0, 3000, 0) -- pièces au repos (hors de vue)
-- Place de repos PROPRE à chaque pièce (famille, n°) : deux pièces au repos ne se
-- superposent jamais (pas de faces confondues, même hors de vue)
local function parkAt(kind: number, index: number): CFrame
	return PARK * CFrame.new(index * 2.5, kind * 40, 0)
end

local DROP_COLOR = Color3.fromRGB(206, 218, 234)
local SPLASH_COLOR = Color3.fromRGB(214, 226, 240)
local PUDDLE_COLOR = Color3.fromRGB(62, 72, 86)
local BOLT_COLOR = Color3.fromRGB(222, 230, 255)
local RAINBOW = {
	Color3.fromRGB(255, 96, 96),
	Color3.fromRGB(255, 196, 92),
	Color3.fromRGB(124, 222, 124),
	Color3.fromRGB(96, 152, 255),
	Color3.fromRGB(172, 112, 232),
}

-- Sols "durs" qui se mouillent (routes, trottoirs, pavés, dalles)
local HARD: { [Enum.Material]: boolean } = {
	[Enum.Material.Asphalt] = true,
	[Enum.Material.Concrete] = true,
	[Enum.Material.Pavement] = true,
	[Enum.Material.Cobblestone] = true,
	[Enum.Material.Slate] = true,
	[Enum.Material.Brick] = true,
	[Enum.Material.Granite] = true,
	[Enum.Material.Limestone] = true,
	[Enum.Material.Sandstone] = true,
	[Enum.Material.Basalt] = true,
	[Enum.Material.Rock] = true,
	[Enum.Material.Marble] = true,
}
Weather3D.HARD = HARD

----------------------------------------------------------------------
-- Hasard déterministe (entiers 32 bits exacts : pas de math.sin / random)
----------------------------------------------------------------------

local TWO32 = 4294967296

-- (a * b) mod 2^32, exact en double (moitiés de 16 bits)
local function mul32(a: number, b: number): number
	local aHi = math.floor(a / 65536)
	local aLo = a % 65536
	return ((aHi * b % 65536) * 65536 + aLo * b) % TWO32
end

-- Hachage d'un entier (peut être négatif ou grand) -> [0, 1)
local function hash01(n: number): number
	local h = math.floor(n) % TWO32
	h = bit32.bxor(h, bit32.rshift(h, 16))
	h = mul32(h, 0x45D9F3B)
	h = bit32.bxor(h, bit32.rshift(h, 16))
	h = mul32(h, 0x45D9F3B)
	h = bit32.bxor(h, bit32.rshift(h, 16))
	return h / TWO32
end
Weather3D.Hash = hash01

----------------------------------------------------------------------
-- Scénarios (fonctions pures de la phase 0..1 d'un épisode)
----------------------------------------------------------------------

local function clamp01(x: number): number
	return math.clamp(x, 0, 1)
end

local function smooth(x: number): number
	x = clamp01(x)
	return x * x * (3 - 2 * x)
end

-- 0 avant a, 1 après b (en douceur)
local function ramp(x: number, a: number, b: number): number
	return smooth((x - a) / (b - a))
end

-- monte de a0 à a1, reste, redescend de b0 à b1
local function plateau(x: number, a0: number, a1: number, b0: number, b1: number): number
	return ramp(x, a0, a1) * (1 - ramp(x, b0, b1))
end

type Sample = { Cloud: number, Rain: number, Storm: number, Rainbow: number }

local function profile(kind: string, p: number): Sample
	local wobble = 0.04 * math.sin(p * math.pi * 4)
	if kind == "Cloudy" then
		return { Cloud = 0.34 + 0.46 * plateau(p, 0.08, 0.3, 0.72, 0.95) + wobble, Rain = 0, Storm = 0, Rainbow = 0 }
	elseif kind == "Showers" then
		local cloud = 0.34 + 0.5 * plateau(p, 0.04, 0.24, 0.62, 0.86)
		local rain = 0.2 * plateau(p, 0.22, 0.3, 0.6, 0.66) + 0.26 * plateau(p, 0.3, 0.38, 0.52, 0.6)
		return { Cloud = cloud, Rain = rain, Storm = 0, Rainbow = plateau(p, 0.64, 0.7, 0.84, 0.92) }
	elseif kind == "Rain" then
		local cloud = 0.34 + 0.58 * plateau(p, 0.04, 0.2, 0.72, 0.9)
		local rain = 0.3 * plateau(p, 0.2, 0.27, 0.74, 0.8) + 0.55 * plateau(p, 0.27, 0.38, 0.66, 0.74)
		return { Cloud = cloud, Rain = rain, Storm = 0, Rainbow = plateau(p, 0.78, 0.83, 0.92, 0.98) }
	elseif kind == "Storm" then
		local cloud = 0.34 + 0.63 * plateau(p, 0.04, 0.18, 0.74, 0.9)
		local rain = 0.45 * plateau(p, 0.18, 0.26, 0.76, 0.82) + 0.55 * plateau(p, 0.26, 0.36, 0.64, 0.74)
		local storm = plateau(p, 0.3, 0.4, 0.6, 0.68)
		return { Cloud = cloud, Rain = rain, Storm = storm, Rainbow = plateau(p, 0.8, 0.85, 0.93, 0.99) }
	end
	return { Cloud = 0.3 + wobble, Rain = 0, Storm = 0, Rainbow = 0 }
end

-- Tirage brut d'un épisode (sans la règle "pas deux orages")
local function rawKind(index: number): string
	local r = hash01(index * 7 + 1013)
	local acc = 0
	for i, w in ipairs(WEIGHTS) do
		acc += w
		if r < acc then
			return KINDS[i]
		end
	end
	return KINDS[1]
end

function Weather3D.KindOf(index: number): string
	local kind = rawKind(index)
	if kind == "Storm" and rawKind(index - 1) == "Storm" then
		return "Rain"
	end
	return kind
end

local function blended(t: number): (string, number, Sample)
	local index = math.floor(t / EPISODE)
	local phase = (t - index * EPISODE) / EPISODE
	local kind = Weather3D.KindOf(index)
	local sample = profile(kind, phase)
	-- début d'épisode fondu avec la fin du précédent (6 % = 36 s)
	if phase < 0.06 then
		local before = profile(Weather3D.KindOf(index - 1), 1)
		local k = smooth(phase / 0.06)
		sample = {
			Cloud = before.Cloud + (sample.Cloud - before.Cloud) * k,
			Rain = before.Rain + (sample.Rain - before.Rain) * k,
			Storm = before.Storm + (sample.Storm - before.Storm) * k,
			Rainbow = before.Rainbow + (sample.Rainbow - before.Rainbow) * k,
		}
	end
	return kind, phase, sample
end

export type WeatherState = {
	Kind: string,
	Phase: number,
	Cloud: number,
	Rain: number,
	Storm: number,
	Rainbow: number,
	Wet: number,
	Puddles: number,
	Flash: number,
	Indoor: boolean,
	Enabled: boolean,
}

-- Météo à l'instant t (secondes, heure du serveur) : fonction PURE
function Weather3D.At(t: number): WeatherState
	local kind, phase, sample = blended(t)
	-- sol mouillé : suit la pluie tout de suite, sèche en ~3 min ;
	-- flaques : seulement après une vraie pluie, sèchent plus lentement
	local wet, puddles = 0, 0
	for k = 0, 24 do
		local dt = k * 10
		local _, _, past = blended(t - dt)
		wet = math.max(wet, past.Rain * 1.4 * math.exp(-dt / 150))
		puddles = math.max(puddles, clamp01((past.Rain - 0.22) / 0.5) * math.exp(-dt / 240))
	end
	return {
		Kind = kind,
		Phase = phase,
		Cloud = clamp01(sample.Cloud),
		Rain = clamp01(sample.Rain),
		Storm = clamp01(sample.Storm),
		Rainbow = clamp01(sample.Rainbow),
		Wet = clamp01(wet),
		Puddles = clamp01(puddles),
		Flash = 0,
		Indoor = false,
		Enabled = true,
	}
end

-- Éclairs : un tirage toutes les 5 s pendant l'orage ; deux pulsations
-- brèves (0,09 s de montée, ~0,3 s de descente), la 2e plus faible
local FLASH_SLOT = 5
local function pulse(x: number): number
	if x < 0 then
		return 0
	elseif x < 0.06 then
		return x / 0.06
	end
	return math.max(0, 1 - (x - 0.06) / 0.28)
end

function Weather3D.FlashAt(t: number, storm: number): (number, number?)
	if storm <= 0.3 then
		return 0, nil
	end
	local best, slotOf = 0, nil
	for back = 0, 1 do
		local slot = math.floor(t / FLASH_SLOT) - back
		if hash01(slot * 3 + 77) < 0.5 * storm then
			local at = slot * FLASH_SLOT + hash01(slot * 5 + 11) * (FLASH_SLOT - 1)
			local x = t - at
			local f = math.max(pulse(x), 0.55 * pulse(x - 0.2))
			if f > best then
				best, slotOf = f, slot
			end
		end
	end
	return clamp01(best * math.min(1, storm * 1.2)), slotOf
end

----------------------------------------------------------------------
-- Rendu (client)
----------------------------------------------------------------------

type Drop = { Part: BasePart, Seed: number, Phase: number, Speed: number, Len: number, Landed: number, Park: CFrame }
type Splash = { Part: BasePart, Age: number, Size: number, Park: CFrame }
type Puddle = { Part: BasePart, Key: string, Base: Vector3, W: number, D: number }
type WetRec = { Part: BasePart, Color: Color3, Reflectance: number }

local active = false
local options: any = {}
local folder: Folder? = nil
local drops: { Drop } = {}
local shownDrops = 0
local splashes: { Splash } = {}
local splashFree: { Splash } = {}
local puddles: { [string]: Puddle } = {}
local puddlePool: { BasePart } = {}
local puddleParks: { [BasePart]: CFrame } = {}
local puddleParkCount = 0
local heights: { [number]: number } = {}
local heightCount = 0
local RAYS_PER_STEP = 24
local raysLeft = RAYS_PER_STEP
local wetList: { WetRec } = {}
local wetApplied = 0
local wetCursor = 0
local wetTarget = 0
local bolt: { BasePart } = {}
local boltSlot: number? = nil
local rainbowParts: { BasePart } = {}
local rainbowShown = 0
local indoorProbe: ((Vector3) -> boolean)? = nil
local shopBoxes: { { CF: CFrame, Size: Vector3 } } = {}
local forcedTime: number? = nil
local stepClock = 0
local slowClock = 0
local puddleClock = 0
local indoorClock = 0
local shopClock = 0
local state: WeatherState = Weather3D.At(0)
local indoor = false
local rayParams: any = nil
local qualityConn: any = nil

local function now(): number
	local forced = forcedTime
	if forced then
		return forced
	end
	local ok, t = pcall(function()
		return workspace:GetServerTimeNow()
	end)
	return ok and t or os.clock()
end

local function camera(): Camera?
	return workspace.CurrentCamera
end

local function newPart(name: string, size: Vector3, color: Color3, transparency: number, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Locked = true
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Transparency = transparency
	p.CFrame = PARK
	return p
end

-- Lancer de rayon vers le bas (sans la pluie ni le personnage) ; nil si rien
local function castDown(x: number, z: number, top: number): RaycastResult?
	local ok, result = pcall(function()
		local params = rayParams
		if params == nil then
			params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			rayParams = params
		end
		local list: { Instance } = {}
		if folder then
			table.insert(list, folder)
		end
		local character = Players.LocalPlayer and Players.LocalPlayer.Character
		if character then
			table.insert(list, character)
		end
		params.FilterDescendantsInstances = list
		return workspace:Raycast(Vector3.new(x, top, z), Vector3.new(0, -260, 0), params)
	end)
	if ok then
		return result
	end
	return nil
end

-- Hauteur d'arrêt des gouttes (sol / toit / auvent) : grille en cache
local function heightAt(x: number, z: number, camY: number): number
	local ix, iz = math.floor(x / CELL), math.floor(z / CELL)
	local key = ix * 65536 + iz
	local cached = heights[key]
	if cached then
		return cached
	end
	if heightCount > 900 then
		table.clear(heights)
		heightCount = 0
	end
	-- (au plus RAYS_PER_STEP nouveaux lancers par passe : caméra qui file = sol supposé)
	if raysLeft <= 0 then
		return camY - BOX_DOWN
	end
	raysLeft -= 1
	local hit = castDown((ix + 0.5) * CELL, (iz + 0.5) * CELL, camY + 80)
	local y = hit and hit.Position.Y or (camY - BOX_DOWN)
	heights[key] = y
	heightCount += 1
	return y
end

----------------------------------------------------------------------
-- Gouttes + éclaboussures
----------------------------------------------------------------------

local function ensureDrops(count: number)
	local parent = folder
	if not parent then
		return
	end
	while #drops < count do
		local i = #drops + 1
		local len = 1.7 + hash01(i * 13 + 5) * 1.3
		local part = newPart("RainDrop", Vector3.new(0.065, len, 0.065), DROP_COLOR, 0.38)
		part.CFrame = parkAt(0, i)
		part.Parent = parent
		table.insert(drops, {
			Part = part,
			Seed = i * 7919,
			Phase = hash01(i * 31 + 7),
			Speed = FALL_SPEED * (0.9 + 0.2 * hash01(i * 17 + 3)),
			Len = len,
			Landed = -1,
			Park = parkAt(0, i),
		})
	end
end

local function spawnSplash(position: Vector3, size: number)
	local s = table.remove(splashFree)
	if not s then
		if #splashes >= SPLASH_MAX or not folder then
			return
		end
		local park = parkAt(1, #splashes + #splashFree + 1)
		local part = newPart("RainSplash", Vector3.new(0.04, 0.2, 0.2), SPLASH_COLOR, 0.4)
		part.Shape = Enum.PartType.Cylinder
		part.CFrame = park
		part.Parent = folder
		s = { Part = part, Age = 0, Size = size, Park = park }
	end
	local splash = s :: Splash
	splash.Age = 0
	splash.Size = size
	splash.Part.CFrame = CFrame.new(position + Vector3.new(0, 0.03, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	table.insert(splashes, splash)
end

local function stepSplashes(dt: number)
	local i = 1
	while i <= #splashes do
		local s = splashes[i]
		s.Age += dt
		local k = s.Age / SPLASH_LIFE
		if k >= 1 then
			s.Part.CFrame = s.Park
			table.insert(splashFree, s)
			table.remove(splashes, i)
		else
			local d = s.Size * (0.25 + 0.75 * k)
			s.Part.Size = Vector3.new(0.04, d, d)
			s.Part.Transparency = 0.35 + 0.65 * k
			i += 1
		end
	end
end

local function wrap(value: number, center: number, half: number): number
	local span = half * 2
	return center - half + ((value - (center - half)) % span)
end

local function stepDrops(t: number, cam: CFrame, rain: number, storm: number)
	local q = GraphicsQuality.Get()
	local want = math.floor(math.min(DROPS_MAX, DROPS_BASE * q.RainScale) * rain + 0.5)
	if indoor or not q.Weather then
		want = 0
	end
	if want > #drops then
		ensureDrops(want)
	end
	local camPos = cam.Position
	local top = camPos.Y + BOX_UP
	local height = BOX_UP + BOX_DOWN
	local windX, windZ = 3 + 9 * storm, 1.5 + 4 * storm
	-- (axe Y de la goutte le long de sa vitesse : vent + chute)
	local tilt = CFrame.Angles(-math.atan2(windZ, FALL_SPEED), 0, math.atan2(windX, FALL_SPEED))
	local parts, cframes = {}, {}
	for i = 1, #drops do
		local d = drops[i]
		local cf = d.Park
		if i <= want then
			local s = t * d.Speed + d.Phase * height
			local cycle = math.floor(s / height)
			local fall = s - cycle * height
			local fallTime = fall / d.Speed
			local wx = (hash01(d.Seed + cycle * 2) - 0.5) * 2 * BOX_R + windX * fallTime
			local wz = (hash01(d.Seed + cycle * 2 + 1) - 0.5) * 2 * BOX_R + windZ * fallTime
			-- ancrée au monde : une grille de 2 x BOX_R studs repliée autour de la caméra
			local x = wrap(wx + math.floor(camPos.X / (2 * BOX_R)) * 2 * BOX_R, camPos.X, BOX_R)
			local z = wrap(wz + math.floor(camPos.Z / (2 * BOX_R)) * 2 * BOX_R, camPos.Z, BOX_R)
			local y = top - fall
			local stop = heightAt(x, z, camPos.Y)
			local near = (Vector3.new(x, y, z) - camPos).Magnitude < 3.5 -- (collée à la caméra : une grosse barre)
			if y - d.Len * 0.5 > stop then
				if not near then
					cf = CFrame.new(x, y, z) * tilt
				end
			elseif d.Landed ~= cycle then
				d.Landed = cycle
				local dx, dz = x - camPos.X, z - camPos.Z
				if dx * dx + dz * dz < SPLASH_RANGE * SPLASH_RANGE and stop > camPos.Y - BOX_DOWN + 0.5 then
					spawnSplash(Vector3.new(x, stop, z), 0.6 + 0.5 * hash01(d.Seed + cycle))
				end
			end
		end
		if i <= want or i <= shownDrops then
			table.insert(parts, d.Part)
			table.insert(cframes, cf)
		end
	end
	shownDrops = want
	if #parts > 0 then
		local ok = pcall(function()
			workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
		end)
		if not ok then
			for i, part in ipairs(parts) do
				part.CFrame = cframes[i]
			end
		end
	end
end

----------------------------------------------------------------------
-- Sol mouillé (Color / Reflectance des sols durs de la ville)
----------------------------------------------------------------------

local function collectWet()
	table.clear(wetList)
	local town = workspace:FindFirstChild("DopamineTown")
	if not town then
		return
	end
	for _, d in ipairs(town:GetDescendants()) do
		if d:IsA("BasePart") and HARD[d.Material] and (tonumber(d.Transparency) or 0) < 0.5 and typeof(d.Color) == "Color3" then
			local size = d.Size
			local up = d.CFrame.UpVector.Y
			if up > 0.9 and size.Y <= 4 and size.X * size.Z >= 24 then
				table.insert(wetList, { Part = d, Color = d.Color, Reflectance = tonumber(d.Reflectance) or 0 })
				if #wetList >= 2500 then
					break
				end
			end
		end
	end
end

local function paintWet(rec: WetRec, wet: number, gloss: number)
	local part = rec.Part
	if part.Parent == nil then
		return
	end
	part.Color = rec.Color:Lerp(rec.Color:Lerp(Color3.new(0.1, 0.11, 0.13), 0.5), 0.55 * wet)
	part.Reflectance = rec.Reflectance + gloss * wet
end

-- Peint le sol mouillé par tranches (300 pièces par appel au plus)
local function stepWet()
	if #wetList == 0 then
		return
	end
	local q = GraphicsQuality.Get()
	local gloss = q.Reflections == "All" and 0.16 or 0.07
	if wetCursor == 0 then
		if math.abs(wetTarget - wetApplied) < 0.02 then
			return
		end
		wetApplied = wetTarget
		wetCursor = 1
	end
	local last = math.min(#wetList, wetCursor + 299)
	for i = wetCursor, last do
		paintWet(wetList[i], wetApplied, gloss)
	end
	wetCursor = last < #wetList and last + 1 or 0
end

local function restoreWet()
	for _, rec in ipairs(wetList) do
		if rec.Part.Parent then
			rec.Part.Color = rec.Color
			rec.Part.Reflectance = rec.Reflectance
		end
	end
	table.clear(wetList)
	wetApplied = 0
	wetTarget = 0
	wetCursor = 0
end

----------------------------------------------------------------------
-- Flaques (grille du monde autour de la caméra, sur les sols durs)
----------------------------------------------------------------------

-- (cache par case, y compris "pas de flaque ici" : un lancer de rayon par case)
local puddleCells: { [string]: any } = {}
local puddleCellCount = 0

local function puddleLookup(ix: number, iz: number, camY: number): (Vector3?, number, number, number)
	local seed = ix * 92821 + iz * 68917
	if hash01(seed) > 0.55 then
		return nil, 0, 0, 0
	end
	local x = (ix + 0.2 + 0.6 * hash01(seed + 1)) * PUDDLE_CELL
	local z = (iz + 0.2 + 0.6 * hash01(seed + 2)) * PUDDLE_CELL
	local hit = castDown(x, z, camY + 40)
	if not hit then
		return nil, 0, 0, 0
	end
	local inst = hit.Instance
	local town = workspace:FindFirstChild("DopamineTown")
	if not (inst:IsA("BasePart") and HARD[inst.Material] and town and inst:IsDescendantOf(town)) then
		return nil, 0, 0, 0
	end
	if hit.Normal.Y < 0.95 then
		return nil, 0, 0, 0
	end
	local w = 3 + 4.5 * hash01(seed + 3)
	local d = w * (0.55 + 0.35 * hash01(seed + 4))
	return hit.Position, w, d, hash01(seed + 5) * math.pi
end

local function puddleAt(ix: number, iz: number, camY: number): (Vector3?, number, number, number)
	local key = ix .. ":" .. iz
	local cached = puddleCells[key]
	if cached == nil then
		if puddleCellCount > 600 then
			table.clear(puddleCells)
			puddleCellCount = 0
		end
		local pos, w, d, yaw = puddleLookup(ix, iz, camY)
		cached = pos and { pos, w, d, yaw } or false
		puddleCells[key] = cached
		puddleCellCount += 1
	end
	if cached == false then
		return nil, 0, 0, 0
	end
	return cached[1], cached[2], cached[3], cached[4]
end

local function stepPuddles(camPos: Vector3, level: number)
	local q = GraphicsQuality.Get()
	local want: { [string]: boolean } = {}
	if level > 0.03 and q.Weather then
		local cx, cz = math.floor(camPos.X / PUDDLE_CELL), math.floor(camPos.Z / PUDDLE_CELL)
		local r = math.ceil(PUDDLE_RANGE / PUDDLE_CELL)
		local count = 0
		for ix = cx - r, cx + r do
			for iz = cz - r, cz + r do
				local key = ix .. ":" .. iz
				local dx, dz = (ix + 0.5) * PUDDLE_CELL - camPos.X, (iz + 0.5) * PUDDLE_CELL - camPos.Z
				if dx * dx + dz * dz <= PUDDLE_RANGE * PUDDLE_RANGE and count < PUDDLE_MAX then
					local existing = puddles[key]
					if existing then
						want[key] = true
						count += 1
					else
						local pos, w, d, yaw = puddleAt(ix, iz, camPos.Y)
						if pos then
							local part = table.remove(puddlePool)
							if not part and folder then
								local p = newPart("Puddle", Vector3.new(1, 0.06, 1), PUDDLE_COLOR, 0.3)
								puddleParkCount += 1
								puddleParks[p] = parkAt(2, puddleParkCount)
								local mesh = Instance.new("SpecialMesh")
								mesh.MeshType = Enum.MeshType.Sphere
								mesh.Parent = p
								p.Parent = folder
								part = p
							end
							if part then
								part.CFrame = CFrame.new(pos + Vector3.new(0, 0.012, 0)) * CFrame.Angles(0, yaw, 0)
								puddles[key] = { Part = part, Key = key, Base = pos, W = w, D = d }
								want[key] = true
								count += 1
							end
						end
					end
				end
			end
		end
	end
	local reflect = q.Reflections == "All" and 0.38 or 0.2
	for key, puddle in pairs(puddles) do
		if want[key] then
			local k = 0.35 + 0.65 * level
			puddle.Part.Size = Vector3.new(puddle.W * k, 0.06, puddle.D * k)
			puddle.Part.Transparency = 1 - (0.78 * math.min(1, level * 1.6))
			puddle.Part.Reflectance = reflect
		else
			puddle.Part.CFrame = puddleParks[puddle.Part] or PARK
			table.insert(puddlePool, puddle.Part)
			puddles[key] = nil
		end
	end
end

-- Ronds de pluie sur les flaques
local function rippleOnPuddles(rain: number)
	if rain < 0.05 or indoor then
		return
	end
	for _, puddle in pairs(puddles) do
		if hash01(math.floor(os.clock() * 7) + #puddle.Key * 31 + puddle.Base.X) < rain * 0.8 then
			local a = hash01(math.floor(os.clock() * 13) + puddle.Base.Z) * math.pi * 2
			local r = hash01(math.floor(os.clock() * 11) + puddle.Base.X) * 0.35
			local offset = Vector3.new(math.cos(a) * puddle.W * r, 0.02, math.sin(a) * puddle.D * r)
			spawnSplash(puddle.Base + offset, 0.7 + 0.5 * rain)
		end
	end
end

----------------------------------------------------------------------
-- Éclair lointain (quelques morceaux fins, pas de Neon) + arc-en-ciel
----------------------------------------------------------------------

local function ensureBolt()
	if #bolt > 0 or not folder then
		return
	end
	for i = 1, 8 do
		local part = newPart("Lightning", Vector3.new(1.4, 1, 1.4), BOLT_COLOR, 1)
		part.CFrame = parkAt(3, i)
		part.Parent = folder
		bolt[i] = part
	end
end

local function stepBolt(t: number, flash: number, slot: number?, camPos: Vector3)
	if #bolt == 0 then
		return
	end
	if flash <= 0.02 or slot == nil or hash01(slot * 9 + 5) > 0.55 then
		if boltSlot ~= nil then
			boltSlot = nil
			for i, part in ipairs(bolt) do
				part.Transparency = 1
				part.CFrame = parkAt(3, i)
			end
		end
		return
	end
	if boltSlot ~= slot then
		boltSlot = slot
		local yaw = hash01(slot * 13 + 1) * math.pi * 2
		local dist = 380 + 140 * hash01(slot * 13 + 2)
		local base = camPos + Vector3.new(math.cos(yaw) * dist, 0, math.sin(yaw) * dist)
		local p = base + Vector3.new(0, 250, 0)
		local side = Vector3.new(-math.sin(yaw), 0, math.cos(yaw))
		for i, part in ipairs(bolt) do
			local nextP = base + Vector3.new(0, 250 - i * (250 / #bolt), 0) + side * ((hash01(slot * 17 + i) - 0.5) * 46)
			local length = (nextP - p).Magnitude
			part.Size = Vector3.new(1.3 - i * 0.08, length + 0.6, 1.3 - i * 0.08)
			part.CFrame = CFrame.lookAt((p + nextP) / 2, nextP) * CFrame.Angles(math.pi / 2, 0, 0)
			p = nextP
		end
	end
	for _, part in ipairs(bolt) do
		part.Transparency = 1 - 0.75 * flash
	end
end

local function sunDirection(): Vector3
	local ok, dir = pcall(function()
		return game:GetService("Lighting"):GetSunDirection()
	end)
	if ok and typeof(dir) == "Vector3" and dir.Magnitude > 0.1 then
		return dir.Unit
	end
	return Vector3.new(0.45, 0.6, 0.66).Unit
end

local function clearRainbow()
	for _, part in ipairs(rainbowParts) do
		part:Destroy()
	end
	table.clear(rainbowParts)
	rainbowShown = 0
end

local RB_DIST, RB_SEGMENTS = 700, 24
local function stepRainbow(amount: number, camPos: Vector3)
	local night = options.IsNight and options.IsNight() == true
	if amount < 0.03 or night or indoor or not GraphicsQuality.Get().Weather then
		if #rainbowParts > 0 then
			clearRainbow()
		end
		return
	end
	-- à l'opposé du soleil ; centre au plus 20° sous l'horizon (arc visible)
	local sun = sunDirection()
	local flat = Vector3.new(-sun.X, 0, -sun.Z)
	if flat.Magnitude < 0.05 then
		flat = Vector3.new(0, 0, 1)
	end
	flat = flat.Unit
	local depress = math.rad(math.min(20, math.deg(math.asin(math.clamp(sun.Y, -1, 1)))))
	local dir = (flat * math.cos(depress) - Vector3.new(0, math.sin(depress), 0)).Unit
	local center = camPos + dir * RB_DIST
	local e1 = Vector3.new(0, 1, 0):Cross(dir).Unit
	local e2 = dir:Cross(e1).Unit
	if e2.Y < 0 then
		e2 = -e2
	end
	if #rainbowParts == 0 and folder then
		for band = 1, #RAINBOW do
			for seg = 1, RB_SEGMENTS do
				local part = newPart("Rainbow", Vector3.new(1, 1, 1), RAINBOW[band], 1)
				part.CFrame = parkAt(4, (band - 1) * RB_SEGMENTS + seg)
				part:SetAttribute("Band", band)
				part:SetAttribute("Seg", seg)
				part.Parent = folder
				table.insert(rainbowParts, part)
			end
		end
	end
	local parts, cframes = {}, {}
	local outer = RB_DIST * math.tan(math.rad(42))
	local bandW = RB_DIST * math.tan(math.rad(0.45))
	for _, part in ipairs(rainbowParts) do
		local band = part:GetAttribute("Band") :: number
		local seg = part:GetAttribute("Seg") :: number
		local r = outer - (band - 0.5) * bandW
		local a0 = (seg - 1) / RB_SEGMENTS * math.pi
		local a1 = seg / RB_SEGMENTS * math.pi
		local am = (a0 + a1) / 2
		local radial = e1 * math.cos(am) + e2 * math.sin(am)
		local tangent = -e1 * math.sin(am) + e2 * math.cos(am)
		-- (bandes décalées de 0,8 stud en profondeur, largeur exacte : jamais deux
		-- faces de couleurs différentes dans le même plan)
		local pos = center + radial * r + dir * ((band - 1) * 0.8)
		local length = r * (a1 - a0) * 1.04
		if part.Size.Y ~= length then
			part.Size = Vector3.new(bandW, length, 0.6)
		end
		table.insert(parts, part)
		table.insert(cframes, CFrame.fromMatrix(pos, radial, tangent))
	end
	pcall(function()
		workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end)
	local transparency = 1 - 0.4 * smooth(amount)
	if math.abs(transparency - rainbowShown) > 0.01 then
		rainbowShown = transparency
		for _, part in ipairs(rainbowParts) do
			part.Transparency = transparency
		end
	end
end

----------------------------------------------------------------------
-- Intérieur ? (pas de pluie dans les maisons / boutiques)
----------------------------------------------------------------------

local function collectShops()
	table.clear(shopBoxes)
	local function scan(root: Instance?)
		if not root then
			return
		end
		for _, d in ipairs(root:GetDescendants()) do
			if d:IsA("Model") then
				local cf = d:GetAttribute("InteriorCF")
				local size = d:GetAttribute("InteriorSize")
				if typeof(cf) == "CFrame" and typeof(size) == "Vector3" then
					table.insert(shopBoxes, { CF = cf, Size = size })
				end
			end
		end
	end
	scan(workspace:FindFirstChild("DopamineTown"))
end

local function inShop(p: Vector3): boolean
	for _, box in ipairs(shopBoxes) do
		local rel = box.CF:PointToObjectSpace(p)
		if math.abs(rel.X) <= box.Size.X / 2 and math.abs(rel.Z) <= box.Size.Z / 2 and rel.Y >= -1 and rel.Y <= box.Size.Y + 0.5 then
			return true
		end
	end
	return false
end

local function castFrom(origin: Vector3, direction: Vector3): RaycastResult?
	local ok, result = pcall(function()
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local list: { Instance } = {}
		if folder then
			table.insert(list, folder)
		end
		local character = Players.LocalPlayer and Players.LocalPlayer.Character
		if character then
			table.insert(list, character)
		end
		params.FilterDescendantsInstances = list
		return workspace:Raycast(origin, direction, params)
	end)
	return ok and result or nil
end

-- Sonde par défaut : un plafond au-dessus ET des murs d'une maison sur 3 côtés
local function defaultIndoor(p: Vector3): boolean
	if inShop(p) then
		return true
	end
	local houses = workspace:FindFirstChild("TownHouses")
	if not houses then
		return false
	end
	local up = castFrom(p, Vector3.new(0, 40, 0))
	if not (up and up.Instance:IsDescendantOf(houses)) then
		return false
	end
	local walls = 0
	for _, dir in ipairs({ Vector3.new(30, 0, 0), Vector3.new(-30, 0, 0), Vector3.new(0, 0, 30), Vector3.new(0, 0, -30) }) do
		local hit = castFrom(p, dir)
		if hit and hit.Instance:IsDescendantOf(houses) then
			walls += 1
		end
	end
	return walls >= 3
end

function Weather3D.SetIndoorProbe(fn: ((Vector3) -> boolean)?)
	indoorProbe = fn
end

function Weather3D.IsIndoor(): boolean
	return indoor
end

----------------------------------------------------------------------
-- Cycle de vie
----------------------------------------------------------------------

function Weather3D.SetForcedTime(t: number?)
	forcedTime = t
	slowClock = 1e9
	puddleClock = 1e9
end

function Weather3D.State(): WeatherState
	return state
end

local function disabledState(): WeatherState
	return {
		Kind = "Clear",
		Phase = 0,
		Cloud = 0.3,
		Rain = 0,
		Storm = 0,
		Rainbow = 0,
		Wet = 0,
		Puddles = 0,
		Flash = 0,
		Indoor = indoor,
		Enabled = false,
	}
end

function Weather3D.Start(opts: any?)
	if active then
		return
	end
	active = true
	options = opts or {}
	local f = Instance.new("Folder")
	f.Name = "DopamineWeather"
	f.Parent = workspace
	folder = f
	stepClock, slowClock, puddleClock, indoorClock, shopClock = 0, 1e9, 1e9, 1e9, 0
	indoor = false
	collectWet()
	collectShops()
	ensureBolt()
	state = GraphicsQuality.Get().Weather and Weather3D.At(now()) or disabledState()
	qualityConn = GraphicsQuality.Changed:Connect(function()
		slowClock = 1e9
		puddleClock = 1e9
		wetApplied = -1 -- (repeindre avec le nouveau brillant)
	end)
end

function Weather3D.Stop()
	if not active then
		return
	end
	active = false
	if qualityConn then
		qualityConn:Disconnect()
		qualityConn = nil
	end
	restoreWet()
	clearRainbow()
	local f = folder
	folder = nil
	if f then
		f:Destroy()
	end
	table.clear(drops)
	table.clear(splashes)
	table.clear(splashFree)
	table.clear(puddles)
	table.clear(puddlePool)
	table.clear(puddleParks)
	puddleParkCount = 0
	table.clear(bolt)
	table.clear(heights)
	heightCount = 0
	table.clear(puddleCells)
	puddleCellCount = 0
	shownDrops = 0
	boltSlot = nil
	state = disabledState()
end

function Weather3D.IsActive(): boolean
	return active
end

function Weather3D.Step(dt: number)
	if not active then
		return
	end
	local cam = camera()
	if not cam then
		return
	end
	local camCF = cam.CFrame
	local t = now()
	local q = GraphicsQuality.Get()
	-- météo (2 fois / s) : état + sol mouillé
	slowClock += dt
	if slowClock >= 0.5 then
		slowClock = 0
		if q.Weather then
			local s = Weather3D.At(t)
			s.Indoor = indoor
			state = s
		else
			state = disabledState()
		end
		wetTarget = state.Wet
		shopClock += 0.5
		if shopClock >= 12 then
			shopClock = 0
			collectShops()
		end
	end
	stepWet()
	-- intérieur ? (4 fois / s)
	indoorClock += dt
	if indoorClock >= 0.25 then
		indoorClock = 0
		local probe = indoorProbe
		local ok, result = pcall(function()
			if probe then
				return probe(camCF.Position) == true or inShop(camCF.Position)
			end
			return defaultIndoor(camCF.Position)
		end)
		indoor = ok and result == true
		state.Indoor = indoor
	end
	-- éclairs (chaque image pendant l'orage)
	local flash, slot = 0, nil
	if state.Storm > 0.3 and q.Weather then
		flash, slot = Weather3D.FlashAt(t, state.Storm)
	end
	state.Flash = flash
	stepBolt(t, flash, slot, camCF.Position)
	-- gouttes + éclaboussures (30 Hz au plus)
	stepClock += dt
	if stepClock >= STEP_RATE then
		local elapsed = stepClock
		stepClock = 0
		if state.Rain > 0.005 or shownDrops > 0 then
			raysLeft = RAYS_PER_STEP
			stepDrops(t, camCF, state.Rain, state.Storm)
		end
		if #splashes > 0 then
			stepSplashes(elapsed)
		end
	end
	-- flaques + arc-en-ciel (2 fois / s)
	puddleClock += dt
	if puddleClock >= 0.5 then
		puddleClock = 0
		stepPuddles(camCF.Position, q.Weather and state.Puddles or 0)
		rippleOnPuddles(state.Rain)
		stepRainbow(state.Rainbow, camCF.Position)
	end
end

-- (tests) nombres d'objets visibles
function Weather3D.Counts(): { [string]: number }
	local p = 0
	for _ in pairs(puddles) do
		p += 1
	end
	return { Drops = shownDrops, Splashes = #splashes, Puddles = p, Wet = #wetList, Rainbow = #rainbowParts, Bolt = boltSlot and #bolt or 0 }
end

return Weather3D
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="246">
          <Properties>
            <string name="Name">WorldLink</string>
            <string name="Source"><![CDATA[--[[
	WorldLink (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > WorldLink

	🚶 Dopamine Town : petit lien SANS dépendance entre les boutons de
	l'interface du clicker (pastille "🚶 Town" de la colonne centrale, bouton
	"🚶 Walk in 3D" de la fenêtre Maison) et le mode ville (TownClient, qui
	s'enregistre ici au démarrage). Si la ville n'est pas chargée, les
	boutons ne font rien (Available() = false) : rien ne casse.

	API :
	  WorldLink.Enter(options?)        options = { Slot = number? (pièce), Visit = UserId? }
	  WorldLink.Available() -> boolean
	  WorldLink.IsInTown() -> boolean
	  WorldLink.SetHandler(enter, isInTown)   (TownClient)
]]

local WorldLink = {}

local enterHandler: ((options: any) -> ())? = nil
local inTownHandler: (() -> boolean)? = nil

function WorldLink.SetHandler(enter: (options: any) -> (), isInTown: () -> boolean)
	enterHandler = enter
	inTownHandler = isInTown
end

function WorldLink.Available(): boolean
	return enterHandler ~= nil
end

function WorldLink.IsInTown(): boolean
	local handler = inTownHandler
	if not handler then
		return false
	end
	local ok, result = pcall(handler)
	return ok and result == true
end

function WorldLink.Enter(options: any?)
	local handler = enterHandler
	if not handler then
		return
	end
	local ok, err = pcall(handler, options or {})
	if not ok then
		warn("[WorldLink] " .. tostring(err))
	end
end

return WorldLink
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
    <Item class="Folder" referent="247">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="248">
        <Properties>
          <string name="Name">ArcadeConfig</string>
          <string name="Source"><![CDATA[--[[
	ArcadeConfig (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > ArcadeConfig

	🕹️ Réglages de l'Arcade (amélioration "Arcade", Feature "Minigames") :
	  - Games      : liste des mini-jeux (Kind = "Solo" | "Duel"). Le client
	                 charge le module Client > Minigames > "<Kind>_<Id>"
	                 (ex. Solo_Minesweeper, Duel_TicTacToe) ;
	  - Tickets    : 🎟️ tickets d'arcade, la monnaie de la BOUTIQUE à tickets.
	                 Gagnés en jouant (plafond par jour) OU achetés en Robux
	                 (packs de la boutique Robux, Config.Monetization) ;
	                 ils ne se misent JAMAIS en duel ;
	  - Trophies   : 🏆 trophées, la monnaie des MISES de duel. Gagnés
	                 UNIQUEMENT en jouant (+ petit cadeau de bienvenue),
	                 jamais achetables, jamais convertibles (ni en tickets, ni
	                 en Dopamine, ni en quoi que ce soit d'achetable) : règles
	                 Roblox, on ne parie jamais une monnaie achetable ;
	  - Duels      : mises en 🏆 trophées, délais, limites anti-abus ;
	  - Shop       : boutique à tickets (petits boosts, Dopamine, badges).
	  - Logic      : règles PURES des duels (victoire au morpion, puissance 4,
	                 grilles de "Trouve l'intrus", mises, plafonds du jour),
	                 partagées par le serveur (qui décide) et le client (qui
	                 affiche) ; testées par tests/run_tests.py.

	Tous les textes (Name, Description...) sont en ANGLAIS : traduits avec
	Locale (dictionnaires Shared > Lang > FR_V8_Arcade, FR_V9_Arcade).
]]

local ArcadeConfig = {}

ArcadeConfig.Feature = "Minigames" -- Feature débloquée par l'amélioration "Arcade"

----------------------------------------------------------------------
-- 🎮 Jeux
----------------------------------------------------------------------
-- Champs communs : Id, Kind ("Solo" | "Duel"), Name, Icon, Description,
--   Color (couleur de la carte), Accent (2e couleur du dégradé), Tagline.
-- Solo (utilisés par Services > Arcade > SoloGames) :
--   Tickets         : 🎟️ gagnés par partie gagnée (plafonnés par Tickets.DailyCap)
--                     (+ Trophies.PerSoloWin 🏆, plafonnés par Trophies.DailyCap)
--   RewardSeconds   : Dopamine gagnée (secondes de production) par victoire
--   DailyRewarded   : nombre de parties RÉCOMPENSÉES par jour pour ce jeu
--   Record          : "High" (plus grand = mieux) | "Low" (plus petit = mieux, ex. un temps)
--   RecordFormat    : "Score" | "Time" (affichage du record dans l'onglet Records)
-- Duel :
--   RewardSeconds   : Dopamine du gagnant (secondes de production), en plus du pot
--   TurnSeconds     : temps pour jouer un coup (jeux au tour par tour)
--   WinScore        : points pour gagner (jeux en manches)
ArcadeConfig.Games = {
	-- Jeux solo (modules écrits par ARCADESOLO : Client > Minigames > Solo_<Id>)
	{ Id = "Minesweeper", Kind = "Solo", Name = "Minesweeper", Icon = "💣", Tagline = "Classic",
		Description = "Clear the board without waking a single mine",
		Color = Color3.fromRGB(255, 92, 170), Accent = Color3.fromRGB(140, 70, 255),
		Tickets = 4, RewardSeconds = 45, DailyRewarded = 12, Record = "Low", RecordFormat = "Time" },
	{ Id = "Memory", Kind = "Solo", Name = "Memory", Icon = "🃏", Tagline = "Brain",
		Description = "Flip the cards and find every pair",
		Color = Color3.fromRGB(120, 110, 255), Accent = Color3.fromRGB(60, 200, 255),
		Tickets = 3, RewardSeconds = 30, DailyRewarded = 15, Record = "Low", RecordFormat = "Time" },
	{ Id = "Simon", Kind = "Solo", Name = "Simon Says", Icon = "🎵", Tagline = "Rhythm",
		Description = "Repeat the glowing sequence, longer every round",
		Color = Color3.fromRGB(255, 190, 40), Accent = Color3.fromRGB(255, 90, 120),
		Tickets = 3, RewardSeconds = 30, DailyRewarded = 15, Record = "High", RecordFormat = "Score" },
	{ Id = "WhackAMole", Kind = "Solo", Name = "Whack-a-Mole", Icon = "🔨", Tagline = "Reflex",
		Description = "Bonk the moles before they hide again",
		Color = Color3.fromRGB(90, 210, 120), Accent = Color3.fromRGB(20, 170, 190),
		Tickets = 3, RewardSeconds = 30, DailyRewarded = 15, Record = "High", RecordFormat = "Score" },
	{ Id = "Snake", Kind = "Solo", Name = "Snake", Icon = "🐍", Tagline = "Retro",
		Description = "Eat the snacks, grow longer, don't bite your tail",
		Color = Color3.fromRGB(60, 220, 170), Accent = Color3.fromRGB(40, 120, 255),
		Tickets = 3, RewardSeconds = 30, DailyRewarded = 15, Record = "High", RecordFormat = "Score" },
	{ Id = "Game2048", Kind = "Solo", Name = "2048", Icon = "🔢", Tagline = "Puzzle",
		Description = "Slide and merge the tiles up to 2048",
		Color = Color3.fromRGB(255, 140, 60), Accent = Color3.fromRGB(255, 70, 140),
		Tickets = 4, RewardSeconds = 45, DailyRewarded = 10, Record = "High", RecordFormat = "Score" },

	-- Duels contre un joueur du serveur (Client > Minigames > Duel_<Id>)
	{ Id = "TicTacToe", Kind = "Duel", Name = "Tic-Tac-Toe", Icon = "⭕", Tagline = "Strategy",
		Description = "Three in a row wins. Quick and sneaky!",
		Color = Color3.fromRGB(255, 70, 160), Accent = Color3.fromRGB(0, 210, 255),
		RewardSeconds = 45, TurnSeconds = 15 },
	{ Id = "Connect4", Kind = "Duel", Name = "Connect 4", Icon = "🔴", Tagline = "Strategy",
		Description = "Drop your discs and line up four",
		Color = Color3.fromRGB(80, 100, 255), Accent = Color3.fromRGB(255, 200, 40),
		RewardSeconds = 75, TurnSeconds = 20 },
	{ Id = "ReactionDuel", Kind = "Duel", Name = "Reaction Duel", Icon = "⚡", Tagline = "Reflex",
		Description = "Wait for GO... then tap faster than your rival",
		Color = Color3.fromRGB(255, 200, 30), Accent = Color3.fromRGB(255, 80, 60),
		RewardSeconds = 45, WinScore = 3 },
	{ Id = "SpotRace", Kind = "Duel", Name = "Spot Race", Icon = "🔎", Tagline = "Race",
		Description = "Race to find the odd emoji out, grid after grid",
		Color = Color3.fromRGB(40, 210, 160), Accent = Color3.fromRGB(150, 80, 255),
		RewardSeconds = 60, WinScore = 4 },
}

----------------------------------------------------------------------
-- 🎟️ Tickets
----------------------------------------------------------------------
ArcadeConfig.Tickets = {
	Icon = "🎟️",
	Max = 9999999, -- solde maximum (sécurité ; assez grand pour ne jamais "manger" des tickets achetés)
	DailyCap = 150, -- tickets GAGNÉS par jour en jouant (solo + bonus de victoire en duel ; les achats ne comptent pas)
	DuelWinBonus = 3, -- tickets bonus du gagnant d'un duel récompensé (même montant quelle que soit la mise)
	StartTickets = 10, -- petit cadeau de bienvenue à l'ouverture de l'arcade
}

----------------------------------------------------------------------
-- 🏆 Trophées (mises des duels)
----------------------------------------------------------------------
-- Gagnés UNIQUEMENT en jouant : jamais vendus contre des Robux, jamais
-- échangés contre des tickets, de la Dopamine ou autre chose d'achetable.
-- Le prix d'une victoire en duel (Dopamine + tickets bonus) ne dépend PAS
-- de la mise : miser des trophées ne rapporte que des trophées.
ArcadeConfig.Trophies = {
	Icon = "🏆",
	Max = 999999, -- solde maximum (sécurité)
	WelcomeGift = 10, -- cadeau de bienvenue (une seule fois, aussi pour les joueurs qui avaient déjà l'arcade)
	PerSoloWin = 1, -- par partie solo gagnée ET récompensée (quota du jour du jeu)
	PerDuelWin = 1, -- par duel gagné ET récompensé (limites anti-farm par joueur)
	DailyCap = 20, -- trophées GAGNÉS par jour (les mises gagnées ne comptent pas)
}

-- Récompense minimale en Dopamine (quand la production est encore petite)
ArcadeConfig.MinDopamineReward = 200

----------------------------------------------------------------------
-- ⚔️ Duels
----------------------------------------------------------------------
ArcadeConfig.Duels = {
	Stakes = { 0, 1, 2, 5, 10 }, -- mises possibles (🏆 trophées, chaque joueur ; 0 = duel amical)
	AnnounceStake = 5, -- mise (🏆) à partir de laquelle tout le serveur apprend le résultat
	InviteSeconds = 30, -- une invitation expire après ce délai
	InviteCooldown = 2, -- (s) entre deux invitations envoyées
	DeclineCooldown = 20, -- (s) avant de réinviter quelqu'un qui a refusé
	MaxIncoming = 3, -- invitations en attente max pour un joueur
	MaxDuelSeconds = 300, -- un duel trop long se termine en égalité (mises rendues)
	PairDailyLimit = 10, -- duels par jour contre le MÊME joueur (anti-farm)
	PairRewardedPerDay = 4, -- duels par jour contre le même joueur qui donnent Dopamine + tickets bonus + stats
	MinMovesForReward = 2, -- abandon / déconnexion avant ce nombre de coups : pas de Dopamine (mais le pot est gagné)
	ResultSeconds = 2.5, -- pause entre deux manches (jeux en manches)
	Reaction = {
		MinDelay = 1.6, -- délai aléatoire avant le "GO!"
		MaxDelay = 4.2,
		RoundTimeout = 3, -- personne n'a tapé : manche rejouée
		Window = 0.12, -- (s) attente après le 1er appui pour départager avec la latence
		MinHuman = 0.08, -- temps de réaction impossible (après compensation) = faux départ
		MaxPingComp = 0.2, -- compensation de latence max (s)
		MaxRounds = 9,
	},
	Spot = {
		MaxRounds = 9,
		RoundTimeout = 20, -- personne n'a trouvé : nouvelle grille
		WrongLock = 1.2, -- (s) bloqué après une erreur
		MinFind = 0.25, -- (s) plus rapide = pas humain (clic refusé)
	},
}

----------------------------------------------------------------------
-- 🛍️ Boutique à tickets
----------------------------------------------------------------------
-- Kind :
--   "Dopamine" : Seconds de production tout de suite
--   "Boost"    : boost de gains Multiplier pendant Duration secondes (système de boost existant ;
--                refusé si un boost DIFFÉRENT est déjà actif, pour ne rien écraser)
--   "Badge"    : badge d'arcade (emblème affiché à côté de ton nom dans les duels) — exclusif à l'arcade
-- MaxPerDay : achats maximum par jour (optionnel)
ArcadeConfig.Shop = {
	{ Id = "Snack", Kind = "Dopamine", Name = "Dopamine Snack", Icon = "🍬", Price = 20, Seconds = 90,
		Description = "90 seconds of production, right now", MaxPerDay = 10 },
	{ Id = "Feast", Kind = "Dopamine", Name = "Dopamine Feast", Icon = "🍱", Price = 90, Seconds = 480,
		Description = "8 minutes of production, right now", MaxPerDay = 5 },
	{ Id = "MiniBoost", Kind = "Boost", Name = "Mini Boost x2", Icon = "⏱️", Price = 60, Multiplier = 2, Duration = 180,
		Description = "Earnings x2 for 3 minutes", MaxPerDay = 3 },
	{ Id = "Joystick", Kind = "Badge", Name = "Joystick", Icon = "🕹️", Price = 30, Description = "A badge for true arcade fans" },
	{ Id = "Invader", Kind = "Badge", Name = "Space Invader", Icon = "👾", Price = 75, Description = "Beep boop. Pew pew." },
	{ Id = "NeonKitty", Kind = "Badge", Name = "Neon Kitty", Icon = "😺", Price = 120, Description = "Cute, fast and a little bit smug" },
	{ Id = "Rainbow", Kind = "Badge", Name = "Rainbow Star", Icon = "🌈", Price = 200, Description = "Shine on the duel board" },
	{ Id = "Dragon", Kind = "Badge", Name = "Pixel Dragon", Icon = "🐉", Price = 400, Description = "Legendary duelist aura" },
	{ Id = "Crown", Kind = "Badge", Name = "Arcade Crown", Icon = "👑", Price = 800, Description = "Only for the kings and queens of the arcade" },
}

----------------------------------------------------------------------
-- Index
----------------------------------------------------------------------
ArcadeConfig.GamesById = {}
ArcadeConfig.SoloGames = {}
ArcadeConfig.DuelGames = {}
for index, entry in ipairs(ArcadeConfig.Games) do
	entry.Order = index
	ArcadeConfig.GamesById[entry.Id] = entry
	if entry.Kind == "Solo" then
		table.insert(ArcadeConfig.SoloGames, entry)
	else
		table.insert(ArcadeConfig.DuelGames, entry)
	end
end
-- v9.8 (DESK98) 🎮 "Desk Runner" : course façon Subway jouée sur l'écran du
-- bureau gamer de la maison (Client > World > DeskGames). Jeu solo CACHÉ :
-- absent de Games / SoloGames (le panneau Arcade ne le liste pas), mêmes
-- plafonds du jour et même échelle de récompenses que les autres jeux solo.
ArcadeConfig.GamesById.DeskRunner = { Id = "DeskRunner", Kind = "Solo", Hidden = true, Name = "Desk Runner", Icon = "🏃", Tagline = "Runner",
	Description = "Dodge the trains on your gaming desk",
	Color = Color3.fromRGB(255, 120, 60), Accent = Color3.fromRGB(80, 160, 255),
	Tickets = 3, RewardSeconds = 30, DailyRewarded = 12, Record = "High", RecordFormat = "Score", Order = 99 }
ArcadeConfig.ShopById = {}
for index, item in ipairs(ArcadeConfig.Shop) do
	item.Order = index
	ArcadeConfig.ShopById[item.Id] = item
end
ArcadeConfig.StakesSet = {}
for _, stake in ipairs(ArcadeConfig.Duels.Stakes) do
	ArcadeConfig.StakesSet[stake] = true
end

-- Nom du module client d'un jeu : "Solo_Minesweeper", "Duel_TicTacToe"
function ArcadeConfig.ModuleName(entry): string
	return tostring(entry.Kind) .. "_" .. tostring(entry.Id)
end

----------------------------------------------------------------------
-- Logic : règles pures des duels (aucune API Roblox : testables hors jeu)
----------------------------------------------------------------------
local Logic = {}
ArcadeConfig.Logic = Logic

-- Morpion : plateau = 9 cases (0 = vide, 1 / 2 = joueur), index 1..9 ligne par ligne
Logic.TicTacToeLines = {
	{ 1, 2, 3 }, { 4, 5, 6 }, { 7, 8, 9 },
	{ 1, 4, 7 }, { 2, 5, 8 }, { 3, 6, 9 },
	{ 1, 5, 9 }, { 3, 5, 7 },
}

-- -> (gagnant 0 | 1 | 2, ligne gagnante { a, b, c } ?)
function Logic.TicTacToeWinner(board: { number }): (number, { number }?)
	for _, line in ipairs(Logic.TicTacToeLines) do
		local a = board[line[1]]
		if a ~= 0 and a ~= nil and a == board[line[2]] and a == board[line[3]] then
			return a, line
		end
	end
	return 0, nil
end

function Logic.IsFull(board: { number }, size: number): boolean
	for index = 1, size do
		if board[index] == 0 or board[index] == nil then
			return false
		end
	end
	return true
end

-- Puissance 4 : 7 colonnes x 6 lignes, index = (ligne - 1) * 7 + colonne, ligne 1 = EN HAUT
Logic.C4Cols = 7
Logic.C4Rows = 6

function Logic.C4Index(row: number, col: number): number
	return (row - 1) * Logic.C4Cols + col
end

-- Case où tombe un jeton lâché dans `col` (la plus basse libre) ; nil si colonne pleine / invalide
function Logic.C4Drop(board: { number }, col: number): number?
	if type(col) ~= "number" or col ~= math.floor(col) or col < 1 or col > Logic.C4Cols then
		return nil
	end
	for row = Logic.C4Rows, 1, -1 do
		local index = Logic.C4Index(row, col)
		if board[index] == 0 then
			return index
		end
	end
	return nil
end

-- -> (gagnant 0 | 1 | 2, cases gagnantes { index... } ?)
function Logic.C4Winner(board: { number }): (number, { number }?)
	local cols, rows = Logic.C4Cols, Logic.C4Rows
	local directions = { { 0, 1 }, { 1, 0 }, { 1, 1 }, { 1, -1 } }
	for row = 1, rows do
		for col = 1, cols do
			local seat = board[Logic.C4Index(row, col)]
			if seat ~= 0 then
				for _, dir in ipairs(directions) do
					local cells = { Logic.C4Index(row, col) }
					for step = 1, 3 do
						local r, c = row + dir[1] * step, col + dir[2] * step
						if r < 1 or r > rows or c < 1 or c > cols or board[Logic.C4Index(r, c)] ~= seat then
							break
						end
						table.insert(cells, Logic.C4Index(r, c))
					end
					if #cells == 4 then
						return seat, cells
					end
				end
			end
		end
	end
	return 0, nil
end

-- Trouve l'intrus : paires d'emojis presque identiques (base, intrus)
Logic.SpotPairs = {
	{ "😺", "😸" }, { "🍎", "🍏" }, { "🌕", "🌖" }, { "💙", "💜" }, { "🐶", "🐱" },
	{ "⭐", "🌟" }, { "🍩", "🍪" }, { "🐸", "🐢" }, { "🌸", "🌺" }, { "🍓", "🍒" },
	{ "🐧", "🐦" }, { "🎈", "🎀" }, { "🧁", "🍰" }, { "🐻", "🐼" }, { "🍋", "🍊" },
}

-- Taille de la grille selon la manche (4x4 -> 5x5 -> 6x6)
function Logic.SpotGridSize(round: number): number
	if round <= 2 then
		return 4
	elseif round <= 4 then
		return 5
	end
	return 6
end

-- Nouvelle grille : rng(a, b) -> entier dans [a, b]
-- -> { Size, Cells = { emoji... }, Odd = index de l'intrus }
function Logic.SpotMakeGrid(rng: (number, number) -> number, round: number)
	local size = Logic.SpotGridSize(round)
	local pair = Logic.SpotPairs[rng(1, #Logic.SpotPairs)]
	local swap = rng(1, 2) == 2
	local base, odd = pair[swap and 2 or 1], pair[swap and 1 or 2]
	local count = size * size
	local oddIndex = rng(1, count)
	local cells = table.create(count, base)
	cells[oddIndex] = odd
	return { Size = size, Cells = cells, Odd = oddIndex }
end

-- Le duel en manches est-il fini ? -> gagnant 0 | 1 | 2
function Logic.RoundsWinner(scores: { number }, winScore: number): number
	if (scores[1] or 0) >= winScore then
		return 1
	elseif (scores[2] or 0) >= winScore then
		return 2
	end
	return 0
end

----------------------------------------------------------------------
-- Monnaies de l'arcade (règles pures, utilisées par MinigameService)
----------------------------------------------------------------------

local function isCount(value): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

-- Monnaie GAGNÉE avec un plafond par jour : combien on donne vraiment
-- (entier >= 0, jamais plus que la place restante aujourd'hui)
function Logic.CappedGrant(amount: number, earnedToday: number, dailyCap: number): number
	if not isCount(amount) or amount <= 0 or not isCount(dailyCap) then
		return 0
	end
	local room = math.max(0, math.floor(dailyCap - (isCount(earnedToday) and earnedToday or 0)))
	return math.max(0, math.min(math.floor(amount), room))
end

-- Mise d'un duel acceptable ? stake doit être dans Duels.Stakes, et les deux
-- joueurs doivent pouvoir la payer avec leurs 🏆 trophées.
-- -> (true) ou (false, "invalid" | "self" | "other")
function Logic.CheckStake(stake: any, myBalance: number, otherBalance: number): (boolean, string?)
	if type(stake) ~= "number" or not ArcadeConfig.StakesSet[stake] then
		return false, "invalid"
	end
	if not isCount(myBalance) or myBalance < stake then
		return false, "self"
	end
	if not isCount(otherBalance) or otherBalance < stake then
		return false, "other"
	end
	return true, nil
end

-- Fin d'un duel : ce que RÉCUPÈRE chaque place (les mises sont déjà en
-- séquestre). Gagnant = les deux mises (x2), perdant = rien, égalité
-- (winnerSeat = 0) = chacun récupère sa mise.
function Logic.StakePayouts(stake: number, winnerSeat: number): { number }
	local safe = isCount(stake) and math.max(0, math.floor(stake)) or 0
	if winnerSeat == 1 then
		return { safe * 2, 0 }
	elseif winnerSeat == 2 then
		return { 0, safe * 2 }
	end
	return { safe, safe }
end

-- Packs de tickets (entrées de Config.Monetization.Products, champ Tickets) :
-- le plus PETIT pack qui couvre `missing`, sinon le plus gros. nil si aucun.
function Logic.PickTicketPack(missing: number, packs: { any }): any
	local best, biggest = nil, nil
	for _, pack in ipairs(packs) do
		local amount = type(pack) == "table" and tonumber(pack.Tickets) or nil
		if amount and amount > 0 then
			if amount >= missing and (best == nil or amount < best.Tickets) then
				best = pack
			end
			if biggest == nil or amount > biggest.Tickets then
				biggest = pack
			end
		end
	end
	return best or biggest
end

return ArcadeConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="249">
        <Properties>
          <string name="Name">CarModels</string>
          <string name="Source"><![CDATA[--[[
	CarModels (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > CarModels

	🚗 Les voitures de Dopamine Town, construites en pièces : utilisé par le
	SERVEUR (voitures garées de la ville, TownKit.Car ; voiture qu'on conduit,
	CarService) ET par le CLIENT (circulation, concession, garage du manoir,
	fenêtre "Mes voitures"). Pur : que des Instances, aucun service.

	8 modèles :
	  BubbleCar : petite citadine ronde kawaii (phares ronds chromés, toit blanc) ;
	  CityCar   : citadine 3 portes (type 500) ;
	  Hatchback : compacte 5 portes (type Golf), becquet ;
	  Pickup    : pick-up (cabine + benne ouverte, grosses roues) ;
	  SUV       : SUV compact (barres de toit, protections noires) ;
	  Van       : combi bicolore (face en V, galerie + planche de surf) ;
	  SportsCar : roadster décapotable (bossages derrière les sièges) ;
	  Limo      : grande berline 3 volumes (calandre chromée, 3 vitres).

	v9.9 (CARS99) "100x plus réalistes" — la carrosserie est une vraie COQUE :
	  - PROPORTIONS réelles (1 m ≈ 2,97 studs, avatar 5,2) : empattement et
	    porte-à-faux de vraies voitures, garde au sol ~0,45, roues de ~0,65 m
	    DANS leurs passages de roue (plus de roues qui dépassent), ceinture de
	    caisse plus haute, pavillon plus bas, montants inclinés (tumblehome :
	    les vitres rentrent vers le toit) ;
	  - la coque (capot, pare-brise, toit, lunette, coffre, épaules, ailes,
	    coins arrondis vus de dessus) est un MAILLAGE de triangles (2 coins
	    WedgePart par triangle, face extérieure exactement sur la surface :
	    aucun jour, aucun z-fighting) tendu entre des SECTIONS le long de la
	    voiture ; flancs verticaux découpés en arc autour des roues (arches
	    lisses), passages de roue noirs, bas de caisse ;
	  - vitres teintées (Transparency + Reflectance), montants A/B/C, joints
	    de portes, poignées, rétroviseurs (coque, miroir, clignotant),
	    essuie-glaces, gouttières, antenne requin, trappe à carburant ;
	  - blocs optiques (boîtier, réflecteur chromé, 2 projecteurs, feu de
	    jour, glace claire, répétiteur d'angle) ; feux arrière (glace rouge,
	    barre, recul, clignotant, bandeau), 3e feu stop, plaques, logos ;
	  - pneus avec flanc, jantes (lèvre, voile sombre, rayons), disques de
	    frein, étriers ; habitacle (sièges + appuie-tête, banquette, planche
	    de bord, écran, volant sur sa colonne, console, ciel de toit) ;
	  - peinture vernie (Reflectance 0,1 en "Full").
	NIVEAUX DE DÉTAIL (opts.Detail) :
	  "Full" (≤ ~400 pièces : sa voiture, concession, garage, aperçu),
	  "Mid"  (≤ ~120 : circulation, voitures garées près de la caméra),
	  "Low"  (≤ ~45 : loin / serveur),
	  "Parked" = "Low" (ancien nom : voitures garées du serveur, budget de la
	  ville ; TownTraffic les remplace par "Mid" près de la caméra).
	ROUES ANIMABLES : chaque pièce d'une roue porte l'attribut "Wheel" (index
	dans WheelPositions) et "Spin" = true si elle tourne avec la roue (l'étrier
	ne fait que braquer). En "Full", 2 pivots invisibles par roue ("WheelSteer",
	"WheelSpin") : CarService les relie par des Motor6D et CarClient règle
	leur Transform (rotation + braquage) sur TOUS les clients.
	Pas de lumière, pas de Neon, pas de son (le client ajoute de petits phares
	la nuit à SA voiture seulement).

	API (inchangée) :
	  CarModels.Build(carId, color?, opts?) -> Model
	    color : Color3 | Id de Config.Cars.Colors | nil (couleur par défaut)
	    opts  : { Detail = "Full" | "Mid" | "Low" | "Parked", Plate = "TEXTE"?,
	              Scale = number | Vector3 (x = largeur, y = hauteur, z = longueur),
	              Stripe = true | Color3 ?, RoofColor = Color3 ? }
	    Repère : pivot = centre du DESSOUS (au sol), avant vers -Z. Tout est
	    ANCRÉ ; PrimaryPart "Root" = boîte de collision invisible (seule pièce
	    CanCollide), les autres pièces sont du décor (CanCollide / CanQuery /
	    CanTouch false). Attributs : CarId, CarKind, Length, Width, Height,
	    SeatCF (CFrame du siège du conducteur, repère du pivot), WheelRadius,
	    Lod (3 / 2 / 1), PartCount.
	  CarModels.Dimensions(carId) -> Vector3 (largeur, hauteur, longueur)
	  CarModels.WheelPositions(carId) -> { Vector3 } (centres des roues, repère du pivot)
	  CarModels.ColorOf(carId, color?) -> Color3
	  CarModels.LockReason(data, carId) -> string? (nil = débloquée ; texte traduit)
	  CarModels.Kinds : ids des modèles
	  CarModels.Handling(carId) -> { Speed, Accel, Grip, Comfort, Stars }
	  CarModels.Repaint(model, carId, color?) (repeint les pièces "Paint")
	  CarModels.WheelRig(model) -> rig (v9.9) : pour animer un modèle ANCRÉ
	    (circulation, plateau tournant) : { Body = { parts }, BodyOff = { CFrame },
	    Wheels = { { Center: CFrame, Front: boolean, Radius: number,
	    Spin = { parts }, SpinOff = { CFrame }, Steer = { parts }, SteerOff = { CFrame } } } }
	    (décalages dans le repère du pivot / du centre de la roue).
	  CarModels.PoseRig(rig, pivot, spin, steer, bob?) -> (parts, frames) : pose
	    complète (à passer à workspace:BulkMoveTo) ; bob = CFrame de caisse
	    (tangage / roulis / pompage de la suspension).

	v10 (CARS10) "10x plus réalistes et personnalisables" :
	  - SILHOUETTES : proportions réelles (plus basses, roues plus grandes,
	    jour de roue serré), nez et poupe ARRONDIS de profil (le capot plonge
	    en quart de cercle, le coffre retombe), coins arrondis vus de dessus,
	    capot / toit / vitres BOMBÉS (deux pans qui se rejoignent au milieu),
	    épaules arrondies, ceinture qui monte vers l'arrière ; phares modernes
	    fins et étirés dans l'angle (sourcil de feu de jour, projecteurs, sans
	    chrome), calandre entre les phares, bouclier avec grande prise d'air,
	    feux arrière fins étirés dans l'angle (même soin devant / derrière).
	  - ATELIER (opts.Mods = { [Kind] = Id } de Config.Cars.Mods) : finition
	    (brillant / métallisé / mat / nacré), toit bicolore (dont carbone),
	    8 jantes (Mesh, Split, Turbine, Deep dish, Retro, Star, Sport...),
	    couleur des jantes, pneus (taille basse, flanc blanc, liseré rouge,
	    tout-terrain), lame avant, bas de caisse, ailerons (lèvre, canard,
	    aileron, GT), vitres teintées, néon sous caisse (Neon doux, aucune
	    lumière), sellerie. Mid garde les ailerons, bas de caisse, néon,
	    couleurs ; Low la peinture.
	  - Budgets mesurés : Full 400..530 pièces (options comprises), Mid
	    140..170, Low ~37.
	API v10 (en plus) :
	  CarModels.Stats(carIdOrKind, tuning?) -> Stats (TopSpeed studs/s, Accel,
	    Brake, Coast, Grip, DriftGrip, TurnRate, Stability, Comfort, ZeroToTop,
	    Rating 100..999, Class "D".."S", Stars) : conduite (CarClient) et
	    courses (RACE10). tuning = { Engine, Tyres, Suspension } (0..3).
	  CarModels.CleanTuning(t) / TuningOf(data, carId)
	  CarModels.PriceFor(carId, factor) -> prix en Dopamine (Config.Cars.MinPrice)
	  CarModels.CleanMods(mods) / ModOf(mods, kind) / EncodeMods(mods) -> "K=Id;..."
	    / DecodeMods(text)
	  CarModels.LightRig(model) -> rig ; CarModels.SetLights(rig, { Brake, Reverse,
	    Blink = -1|0|1, Hazard, Head }) : feux stop / recul / clignotants /
	    phares en Neon (côté client, local ; Blink / Hazard = état allumé du
	    moment, l'appelant fait la cadence).
	  Attributs en plus : Finish, Mods (texte encodé).
]]

local Config = require(script.Parent.Config)

local CarModels = {}

local M = Enum.Material
local PI = math.pi
local V3 = Vector3.new

export type Spec = {
	L: number, -- longueur
	W: number, -- largeur (flancs)
	WheelD: number, -- diamètre des roues
	TyreW: number, -- largeur des pneus
	Clear: number, -- dessous de la carrosserie (garde au sol)
	Low: number, -- dessus du flanc vertical (au-dessus des arches)
	Belt: number, -- ligne de ceinture (bas des vitres) au milieu
	Roof: number, -- dessus du toit (sommet du pare-brise pour le roadster)
	AxleF: number, -- z de l'essieu avant
	AxleR: number, -- z de l'essieu arrière
	Ws: number, -- pied du pare-brise
	R0: number, -- avant du toit
	R1: number, -- arrière du toit
	Rw: number, -- pied de la lunette arrière
	Inset: number, -- rentré du bord du toit (de chaque côté)
	HoodF: number, -- hauteur du capot à l'avant
	HoodR: number, -- hauteur du capot au pied du pare-brise
	Deck: number, -- hauteur du coffre / du hayon (benne : dessus des ridelles)
	BeltRise: number, -- montée de la ceinture de l'avant à l'arrière
	Tumble: number, -- rentré du bas des vitres
	NoseR: number, -- rayon des coins avant (vu de dessus)
	TailR: number, -- rayon des coins arrière
	NoseLow: number?, -- dessus du flanc au nez (roadster : nez plongeant)
	Doors: number, -- 2 ou 4
	Style: string,
}

local SPECS: { [string]: Spec } = {
	BubbleCar = { L = 9.2, W = 5.2, WheelD = 2.0, TyreW = 0.78, Clear = 0.45, Low = 2.35, Belt = 2.95, Roof = 4.6, AxleF = -2.75, AxleR = 2.8, Ws = -2.55, R0 = -0.6, R1 = 2.65, Rw = 4.15, Inset = 0.8, HoodF = 2.3, HoodR = 2.75, Deck = 3.0, BeltRise = 0, Tumble = 0.34, NoseR = 1.1, TailR = 1.0, NoseLow = 1.95, Doors = 2, Style = "Bubble" },
	CityCar = { L = 10.6, W = 5.1, WheelD = 2.05, TyreW = 0.82, Clear = 0.42, Low = 2.4, Belt = 2.95, Roof = 4.55, AxleF = -3.2, AxleR = 3.45, Ws = -2.75, R0 = -0.55, R1 = 3.3, Rw = 4.85, Inset = 0.78, HoodF = 2.3, HoodR = 2.8, Deck = 3.05, BeltRise = 0.08, Tumble = 0.32, NoseR = 0.95, TailR = 0.85, NoseLow = 1.95, Doors = 2, Style = "City" },
	Hatchback = { L = 12.2, W = 5.4, WheelD = 2.2, TyreW = 0.9, Clear = 0.42, Low = 2.45, Belt = 3.0, Roof = 4.5, AxleF = -3.8, AxleR = 3.85, Ws = -3.25, R0 = -0.6, R1 = 3.95, Rw = 5.7, Inset = 0.8, HoodF = 2.35, HoodR = 2.85, Deck = 3.1, BeltRise = 0.12, Tumble = 0.34, NoseR = 0.9, TailR = 0.95, NoseLow = 2.0, Doors = 4, Style = "Hatch" },
	Pickup = { L = 13, W = 6.0, WheelD = 2.6, TyreW = 1.05, Clear = 0.75, Low = 3.1, Belt = 3.7, Roof = 5.5, AxleF = -4.1, AxleR = 3.95, Ws = -2.9, R0 = -1.1, R1 = 1.5, Rw = 1.5, Inset = 0.55, HoodF = 3.3, HoodR = 3.6, Deck = 3.75, BeltRise = 0, Tumble = 0.28, NoseR = 0.7, TailR = 0.5, NoseLow = 2.95, Doors = 2, Style = "Pickup" },
	SUV = { L = 12.8, W = 5.8, WheelD = 2.45, TyreW = 1.0, Clear = 0.62, Low = 2.85, Belt = 3.45, Roof = 5.3, AxleF = -3.9, AxleR = 4.0, Ws = -3.2, R0 = -0.8, R1 = 4.7, Rw = 5.85, Inset = 0.72, HoodF = 3.0, HoodR = 3.35, Deck = 3.6, BeltRise = 0.1, Tumble = 0.32, NoseR = 0.85, TailR = 0.9, NoseLow = 2.65, Doors = 4, Style = "SUV" },
	Van = { L = 13, W = 5.8, WheelD = 2.2, TyreW = 0.88, Clear = 0.52, Low = 2.55, Belt = 3.35, Roof = 6.0, AxleF = -4.3, AxleR = 4.15, Ws = -5.4, R0 = -4.0, R1 = 6.1, Rw = 6.42, Inset = 0.5, HoodF = 2.75, HoodR = 3.2, Deck = 3.5, BeltRise = 0, Tumble = 0.3, NoseR = 1.0, TailR = 0.85, NoseLow = 2.4, Doors = 2, Style = "Van" },
	SportsCar = { L = 12.8, W = 5.9, WheelD = 2.15, TyreW = 1.1, Clear = 0.32, Low = 2.35, Belt = 2.7, Roof = 3.65, AxleF = -3.9, AxleR = 3.75, Ws = -1.35, R0 = -0.25, R1 = 1.8, Rw = 2.3, Inset = 0.5, HoodF = 1.95, HoodR = 2.45, Deck = 2.65, BeltRise = 0.1, Tumble = 0.3, NoseR = 1.2, TailR = 1.2, NoseLow = 1.65, Doors = 2, Style = "Sports" },
	Limo = { L = 15.2, W = 5.7, WheelD = 2.25, TyreW = 0.92, Clear = 0.45, Low = 2.5, Belt = 3.05, Roof = 4.6, AxleF = -4.95, AxleR = 4.85, Ws = -3.5, R0 = -1.0, R1 = 3.5, Rw = 5.0, Inset = 0.78, HoodF = 2.5, HoodR = 2.9, Deck = 3.15, BeltRise = 0, Tumble = 0.32, NoseR = 0.9, TailR = 1.0, NoseLow = 2.2, Doors = 4, Style = "Limo" },
}
CarModels.Specs = SPECS
CarModels.Kinds = { "BubbleCar", "CityCar", "Hatchback", "Pickup", "SUV", "Van", "SportsCar", "Limo" }

-- Couleurs fixes
local GLASS = Color3.fromRGB(84, 104, 126) -- verre teinté (transparence automatique)
local GLASS_T = 0.45
local TRIM = Color3.fromRGB(30, 31, 36) -- plastique noir
local TYRE = Color3.fromRGB(28, 28, 32)
local SIDEWALL = Color3.fromRGB(44, 44, 50)
local CHROME = Color3.fromRGB(214, 218, 226)
local LAMP = Color3.fromRGB(255, 250, 232)
local LENS = Color3.fromRGB(226, 236, 246)
local TAIL = Color3.fromRGB(196, 24, 40)
local TAIL_IN = Color3.fromRGB(255, 90, 100)
local AMBER = Color3.fromRGB(255, 160, 50)
local PLATE = Color3.fromRGB(248, 248, 244)
local PLATE_BAND = Color3.fromRGB(40, 80, 190)
local SEAT = Color3.fromRGB(58, 52, 58)
local WHITE = Color3.new(1, 1, 1)
local DISC = Color3.fromRGB(128, 130, 138)
local CAL_RED = Color3.fromRGB(212, 40, 52)
local CAL_DARK = Color3.fromRGB(70, 70, 80)
local HOUSING = Color3.fromRGB(22, 22, 28)
local DRL = Color3.fromRGB(255, 252, 244)
local REVERSE = Color3.fromRGB(236, 236, 240)
local SCREEN = Color3.fromRGB(30, 60, 96)
local GRAPHITE = Color3.fromRGB(52, 54, 62)
local GAP = Color3.fromRGB(18, 18, 22)
local HEADLINER = Color3.fromRGB(206, 202, 196)
local LINER = Color3.fromRGB(16, 16, 20)
local CARPET = Color3.fromRGB(40, 38, 42)

local function kindOf(carId: string?): string
	if type(carId) == "string" then
		if SPECS[carId] then
			return carId
		end
		local car = Config.CarsById and Config.CarsById[carId]
		if car and type(car.Kind) == "string" and SPECS[car.Kind] then
			return car.Kind
		end
	end
	return "CityCar"
end

function CarModels.Dimensions(carId: string?): Vector3
	local s = SPECS[kindOf(carId)]
	return Vector3.new(s.W, s.Roof, s.L)
end

-- (v9.9) roues DANS les passages : face extérieure du pneu 0,22 en retrait du
-- flanc (la jante bombée et le cache-moyeu arrivent à l'aplomb de la caisse)
function CarModels.WheelPositions(carId: string?): { Vector3 }
	local s = SPECS[kindOf(carId)]
	local x = s.W / 2 - s.TyreW / 2 - 0.22
	local out = {}
	for _, z in ipairs({ s.AxleF, s.AxleR }) do
		for _, sx in ipairs({ -1, 1 }) do
			table.insert(out, Vector3.new(sx * x, s.WheelD / 2, z))
		end
	end
	return out
end

function CarModels.ColorOf(carId: string?, color: any?): Color3
	if typeof(color) == "Color3" then
		return color
	end
	local byId = Config.CarColorsById or {}
	if type(color) == "string" and byId[color] then
		return byId[color].Color
	end
	local car = type(carId) == "string" and Config.CarsById and Config.CarsById[carId] or nil
	local default = car and byId[car.DefaultColor]
	if default then
		return default.Color
	end
	return Color3.fromRGB(255, 150, 196)
end

-- Comportement au volant par modèle (multiplicateurs de la conduite de
-- CarClient : vitesse max, accélération, adhérence) + confort, et notes de 1
-- à 5 étoiles (fenêtre "Mes voitures", pupitres de la concession)
export type Handling = { Speed: number, Accel: number, Grip: number, Comfort: number, Stars: { Speed: number, Accel: number, Grip: number, Comfort: number } }
local HANDLING: { [string]: { number } } = {
	BubbleCar = { 0.8, 0.9, 1.05, 3 },
	CityCar = { 0.88, 1.0, 1.1, 3 },
	Hatchback = { 0.95, 1.05, 1.05, 3 },
	Pickup = { 0.92, 0.9, 0.85, 3 },
	SUV = { 0.95, 0.9, 0.9, 5 },
	Van = { 0.85, 0.8, 0.85, 4 },
	SportsCar = { 1.16, 1.35, 1.2, 2 },
	Limo = { 1.0, 0.85, 0.8, 5 },
}
function CarModels.Handling(carId: string?): Handling
	local h = HANDLING[kindOf(carId)] or HANDLING.CityCar
	local function stars(v: number): number
		return math.clamp(math.floor(v + 0.5), 1, 5)
	end
	return {
		Speed = h[1],
		Accel = h[2],
		Grip = h[3],
		Comfort = h[4],
		Stars = { Speed = stars((h[1] - 0.7) / 0.1), Accel = stars((h[2] - 0.7) / 0.13), Grip = stars((h[3] - 0.7) / 0.1), Comfort = stars(h[4]) },
	}
end

----------------------------------------------------------------------
-- 🏁 (v10, CARS10) PERFORMANCES + PRÉPARATION (lu par CarClient pour la
-- conduite et par RACE10 pour les courses : IA, validation serveur)
----------------------------------------------------------------------
export type Tuning = { Engine: number, Tyres: number, Suspension: number }
export type Stats = {
	CarId: string,
	Kind: string,
	Tuning: Tuning,
	TopSpeed: number, -- studs/s (marche avant, à fond, sur le plat)
	Reverse: number, -- studs/s
	Accel: number, -- studs/s² au démarrage (s'essouffle vers TopSpeed)
	Brake: number, -- studs/s² en freinant
	Coast: number, -- studs/s² sans rien toucher
	Grip: number, -- adhérence latérale (1/s : vitesse de résorption de la glisse)
	DriftGrip: number, -- adhérence en dérapage (1/s)
	TurnRate: number, -- rad/s max (à vitesse moyenne)
	Stability: number, -- 0..1 : part du virage gardée à pleine vitesse
	Comfort: number, -- 1..5
	ZeroToTop: number, -- s de 0 à 95 % de TopSpeed (simulation du même modèle que CarClient)
	Rating: number, -- indice de performance 100..999 (appariement, IA)
	Class: string, -- "D" | "C" | "B" | "A" | "S"
	Stars: { Speed: number, Accel: number, Grip: number, Comfort: number },
}

local BASE_ACCEL, BASE_BRAKE, BASE_COAST, BASE_TURN = 24, 60, 14, 1.9

local function kindOfPublic(carId: string?): string
	return kindOf(carId)
end

-- Préparation propre (niveaux entiers 0..MaxLevel)
function CarModels.CleanTuning(tuning: any): Tuning
	local maxLevel = (Config.Cars.Tuning and Config.Cars.Tuning.MaxLevel) or 3
	local out = { Engine = 0, Tyres = 0, Suspension = 0 }
	if type(tuning) == "table" then
		for key in pairs(out) do
			local v = tonumber(tuning[key])
			if v and v == v then
				out[key] = math.clamp(math.floor(v), 0, maxLevel)
			end
		end
	end
	return out :: Tuning
end

-- Préparation d'une voiture dans les données d'un joueur (data.Cars.Tuning)
function CarModels.TuningOf(data: any, carId: string): Tuning
	local cars = type(data) == "table" and data.Cars
	local all = type(cars) == "table" and cars.Tuning
	return CarModels.CleanTuning(type(all) == "table" and all[carId] or nil)
end

-- Temps de 0 à 95 % de la vitesse max avec le modèle d'accélération de
-- CarClient (accélération x (1 - 0,55 (v / vmax)²))
local function zeroToTop(top: number, accel: number): number
	local v, t = 0, 0
	local dt = 1 / 30
	while v < top * 0.95 and t < 60 do
		v += accel * (1 - 0.55 * (v / top) ^ 2) * dt
		t += dt
	end
	return t
end

-- Performances d'une voiture (carId ou Kind) avec sa préparation.
-- Déterministe, pur, identique serveur / client.
function CarModels.Stats(carId: string?, tuning: any?): Stats
	local kind = kindOfPublic(carId)
	local h = HANDLING[kind] or HANDLING.CityCar
	local t = CarModels.CleanTuning(tuning)
	local maxSpeed = tonumber(Config.Cars.MaxSpeed) or 50
	local top = maxSpeed * h[1] * (1 + 0.1 * t.Engine)
	local accel = BASE_ACCEL * h[2] * (1 + 0.12 * t.Engine)
	local brake = BASE_BRAKE * (0.9 + 0.1 * h[3]) * (1 + 0.1 * t.Tyres)
	local grip = 10 * h[3] * (1 + 0.08 * t.Tyres + 0.03 * t.Suspension)
	local driftGrip = 3 * h[3] * (1 + 0.1 * t.Suspension + 0.04 * t.Tyres)
	local turn = BASE_TURN * (0.92 + 0.08 * h[3]) * (1 + 0.05 * t.Suspension)
	local stability = math.clamp(0.6 + 0.05 * t.Suspension + 0.03 * t.Tyres, 0, 0.9)
	local z = zeroToTop(top, accel)
	-- indice : vitesse 45 %, accélération 30 %, tenue 25 % (100..999)
	local speedN = top / (maxSpeed * 1.35)
	local accelN = accel / (BASE_ACCEL * 1.9)
	local gripN = (grip / 10 + turn / BASE_TURN) / 2 / 1.5
	local rating = math.clamp(math.floor(100 + 900 * (0.45 * speedN + 0.3 * accelN + 0.25 * gripN) ^ 1.6 + 0.5), 100, 999)
	local class = if rating >= 750 then "S" elseif rating >= 600 then "A" elseif rating >= 490 then "B" elseif rating >= 400 then "C" else "D"
	local function stars(v: number): number
		return math.clamp(math.floor(v + 0.5), 1, 5)
	end
	return {
		CarId = type(carId) == "string" and carId or kind,
		Kind = kind,
		Tuning = t,
		TopSpeed = top,
		Reverse = tonumber(Config.Cars.ReverseSpeed) or 18,
		Accel = accel,
		Brake = brake,
		Coast = BASE_COAST,
		Grip = grip,
		DriftGrip = driftGrip,
		TurnRate = turn,
		Stability = stability,
		Comfort = h[4],
		ZeroToTop = z,
		Rating = rating,
		Class = class,
		Stars = {
			Speed = stars((top / maxSpeed - 0.7) / 0.1),
			Accel = stars((accel / BASE_ACCEL - 0.7) / 0.13),
			Grip = stars((grip / 10 - 0.7) / 0.1),
			Comfort = stars(h[4]),
		},
	} :: Stats
end

-- Prix d'une option / d'un niveau pour une voiture (Price x prix de la
-- voiture, au moins MinPrice, arrondi à 2 chiffres significatifs ; 0 = gratuit)
function CarModels.PriceFor(carId: string, factor: number?): number
	local f = tonumber(factor) or 0
	if f <= 0 then
		return 0
	end
	local car = Config.CarsById and Config.CarsById[carId]
	local base = car and tonumber(car.Cost) or 1e6
	local price = math.max(tonumber(Config.Cars.MinPrice) or 0, base * f)
	local unit = 10 ^ math.max(0, math.floor(math.log10(price)) - 1)
	return math.floor(price / unit + 0.5) * unit
end

-- 🎨 (v10) Options visuelles d'une voiture (data.Cars.Mods[carId]) : on ne
-- garde que les clés connues de Config.Cars.Mods avec un Id connu, et pas
-- les valeurs d'origine (1re entrée). Tables compactes, sûres.
function CarModels.CleanMods(mods: any): { [string]: string }
	local out = {}
	if type(mods) ~= "table" then
		return out
	end
	local byKind = Config.CarModsById or {}
	for kind, list in pairs(Config.Cars.Mods or {}) do
		local id = mods[kind]
		if type(id) == "string" and byKind[kind] and byKind[kind][id] and list[1] and list[1].Id ~= id then
			out[kind] = id
		end
	end
	return out
end

-- Valeur d'une option (Id ; l'origine si absente)
function CarModels.ModOf(mods: any, kind: string): string
	local id = type(mods) == "table" and mods[kind]
	local byKind = Config.CarModsById and Config.CarModsById[kind]
	if type(id) == "string" and byKind and byKind[id] then
		return id
	end
	local list = Config.Cars.Mods and Config.Cars.Mods[kind]
	return list and list[1] and list[1].Id or ""
end

-- Texte compact pour un attribut répliqué : "Rims=Mesh;Tint=Dark" (et retour)
function CarModels.EncodeMods(mods: any): string
	local clean = CarModels.CleanMods(mods)
	local keys = {}
	for kind in pairs(clean) do
		table.insert(keys, kind)
	end
	table.sort(keys)
	local parts = {}
	for _, kind in ipairs(keys) do
		table.insert(parts, kind .. "=" .. clean[kind])
	end
	return table.concat(parts, ";")
end
function CarModels.DecodeMods(text: any): { [string]: string }
	local raw = {}
	if type(text) == "string" then
		for kind, id in string.gmatch(text, "(%w+)=(%w+)") do
			raw[kind] = id
		end
	end
	return CarModels.CleanMods(raw)
end

-- (v10) finitions : teinte (nacré, mat) et brillance (Reflectance) par niveau de détail
local FINISH_GLOSS: { [string]: { number } } = {
	Gloss = { 0.03, 0.08, 0.15 },
	Metallic = { 0.05, 0.16, 0.3 },
	Pearl = { 0.04, 0.12, 0.24 },
	Matte = { 0, 0, 0 },
}
local function finishColor(c: Color3, finish: any): Color3
	if finish == "Pearl" then
		return c:Lerp(Color3.fromRGB(255, 244, 252), 0.1)
	elseif finish == "Matte" then
		return c:Lerp(Color3.fromRGB(120, 120, 124), 0.08)
	elseif finish == "Metallic" then
		return c:Lerp(Color3.fromRGB(20, 20, 26), 0.06)
	end
	return c
end
-- vitres teintées : couleur, transparence
local TINTS: { [string]: { any } } = {
	Clear = { GLASS, GLASS_T },
	Light = { Color3.fromRGB(66, 82, 100), 0.36 },
	Dark = { Color3.fromRGB(40, 48, 60), 0.26 },
	Limo = { Color3.fromRGB(20, 22, 28), 0.12 },
}

-- Repeint un modèle déjà construit (pièces marquées "Paint") : pour changer
-- de couleur SANS reconstruire (fenêtre "Mes voitures", concession)
function CarModels.Repaint(model: Instance, carId: string?, color: any?)
	local paint = finishColor(CarModels.ColorOf(carId, color), model:GetAttribute("Finish"))
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d:GetAttribute("Paint") then
			d.Color = paint
		end
	end
	if model:IsA("Model") then
		model:SetAttribute("PaintColor", paint)
	end
end

-- 🔒 Raison du verrou (nil = débloquée) : visites à l'océan
function CarModels.LockReason(data: any, carId: string): string?
	local car = Config.CarsById and Config.CarsById[carId]
	if not car then
		return "?"
	end
	local need = tonumber(car.RequiresRebirths) or 0
	local have = type(data) == "table" and tonumber(data.Rebirths) or 0
	if (have or 0) >= need then
		return nil
	end
	local text = "🔒 Unlocked after %d visits to the ocean"
	local okLocale, Locale = pcall(require, script.Parent:FindFirstChild("Locale") :: any)
	if okLocale and type(Locale) == "table" and type(Locale.T) == "function" then
		return Locale.T(text, need)
	end
	return string.format(text, need)
end

----------------------------------------------------------------------
-- Pièces (repère local : sol au centre, avant vers -Z)
----------------------------------------------------------------------

type B = {
	Model: Model,
	S: Vector3, -- échelle
	Count: number,
	Paint: Color3,
	Gloss: number, -- Reflectance de la peinture
	Lod: number, -- 3 Full, 2 Mid, 1 Low
	WheelTag: number?, -- (roues) index de la roue en cours
	Spin: boolean?, -- (roues) la pièce tourne avec la roue
	PaintMat: Enum.Material?, -- (v10) finition mate : matériau de la peinture
	GlassColor: Color3, -- (v10) teinte des vitres
	GlassT: number, -- (v10) transparence des vitres
}

local function newPart(b: B, className: string, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material, shadow: boolean?): BasePart
	local p = Instance.new(className :: any) :: BasePart
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = shadow == true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = Vector3.new(math.max(0.05, size.X), math.max(0.05, size.Y), math.max(0.05, size.Z))
	p.CFrame = cf
	p.Color = color
	p.Material = material
	if color == b.Paint then
		p:SetAttribute("Paint", true)
		if material == M.SmoothPlastic then
			p.Reflectance = b.Gloss
			if b.PaintMat then
				p.Material = b.PaintMat
			end
		end
	elseif color == GLASS then
		p.Color = b.GlassColor
		p.Transparency = b.GlassT
		p.Reflectance = if b.Lod >= 3 then 0.2 else 0.12
	end
	if b.WheelTag then
		p:SetAttribute("Wheel", b.WheelTag)
		if b.Spin then
			p:SetAttribute("Spin", true)
		end
	end
	p.Parent = b.Model
	b.Count += 1
	return p
end

-- point local -> point du modèle (échelle)
local function P(b: B, x: number, y: number, z: number): Vector3
	return Vector3.new(x * b.S.X, y * b.S.Y, z * b.S.Z)
end
local function PV(b: B, v: Vector3): Vector3
	return Vector3.new(v.X * b.S.X, v.Y * b.S.Y, v.Z * b.S.Z)
end

-- Bloc aligné : bornes x0..x1, y0..y1, z0..z1
local function box(b: B, name: string, x0: number, x1: number, y0: number, y1: number, z0: number, z1: number, color: Color3, material: Enum.Material?, shadow: boolean?): BasePart
	local s = b.S
	return newPart(b, "Part", name, Vector3.new(math.abs(x1 - x0) * s.X, math.abs(y1 - y0) * s.Y, math.abs(z1 - z0) * s.Z),
		CFrame.new(P(b, (x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2)), color, material or M.SmoothPlastic, shadow)
end

-- Coin (WedgePart) : haut du côté +Z (dos) si `highBack`, sinon côté -Z
local function wedge(b: B, name: string, x0: number, x1: number, y0: number, y1: number, z0: number, z1: number, highBack: boolean, color: Color3, material: Enum.Material?, shadow: boolean?): BasePart
	local s = b.S
	local cf = CFrame.new(P(b, (x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2))
	if not highBack then
		cf *= CFrame.Angles(0, PI, 0)
	end
	return newPart(b, "WedgePart", name, Vector3.new(math.abs(x1 - x0) * s.X, math.abs(y1 - y0) * s.Y, math.abs(z1 - z0) * s.Z), cf, color, material or M.SmoothPlastic, shadow)
end

-- Plaque inclinée entre deux points (y, z) du plan de côté, à l'abscisse x
local function slab(b: B, name: string, x: number, width: number, y0: number, z0: number, y1: number, z1: number, thick: number, color: Color3, material: Enum.Material?): BasePart
	local a = P(b, x, y0, z0)
	local c = P(b, x, y1, z1)
	local len = (c - a).Magnitude
	local cf = CFrame.lookAt((a + c) / 2, c)
	return newPart(b, "Part", name, Vector3.new(width * b.S.X, thick * b.S.Y, len), cf, color, material or M.SmoothPlastic)
end

-- Cylindre couché le long de X (roues)
local function cylX(b: B, name: string, x: number, y: number, z: number, length: number, diameter: number, color: Color3, material: Enum.Material?, shadow: boolean?): BasePart
	local m = math.min(b.S.Y, b.S.Z)
	local p = newPart(b, "Part", name, Vector3.new(length * b.S.X, diameter * m, diameter * m), CFrame.new(P(b, x, y, z)), color, material or M.SmoothPlastic, shadow)
	;(p :: Part).Shape = Enum.PartType.Cylinder
	return p
end

-- Cylindre le long de Z (phares ronds, échappements)
local function cylZ(b: B, name: string, x: number, y: number, z: number, length: number, diameter: number, color: Color3, material: Enum.Material?): BasePart
	local m = math.min(b.S.X, b.S.Y)
	local p = newPart(b, "Part", name, Vector3.new(length * b.S.Z, diameter * m, diameter * m), CFrame.new(P(b, x, y, z)) * CFrame.Angles(0, PI / 2, 0), color, material or M.SmoothPlastic)
	;(p :: Part).Shape = Enum.PartType.Cylinder
	return p
end

-- Cylindre debout (axe Y)
local function cylY(b: B, name: string, x: number, y: number, z: number, height: number, diameter: number, color: Color3, material: Enum.Material?): BasePart
	local m = math.min(b.S.X, b.S.Z)
	local p = newPart(b, "Part", name, Vector3.new(height * b.S.Y, diameter * m, diameter * m), CFrame.new(P(b, x, y, z)) * CFrame.Angles(0, 0, PI / 2), color, material or M.SmoothPlastic)
	;(p :: Part).Shape = Enum.PartType.Cylinder
	return p
end

-- Bloc tourné autour de X (arches, rayons, étriers) : centre, taille, angle (rad)
local function boxRotX(b: B, name: string, x: number, y: number, z: number, sx: number, sy: number, sz: number, angle: number, color: Color3, material: Enum.Material?): BasePart
	local m = math.min(b.S.Y, b.S.Z)
	return newPart(b, "Part", name, Vector3.new(sx * b.S.X, sy * m, sz * m), CFrame.new(P(b, x, y, z)) * CFrame.Angles(angle, 0, 0), color, material or M.SmoothPlastic)
end

-- Ellipsoïde (SpecialMesh "Sphere" qui remplit la pièce). Taille = extents.
local function ell(b: B, name: string, x: number, y: number, z: number, sx: number, sy: number, sz: number, color: Color3, material: Enum.Material?, rot: CFrame?): BasePart
	local cf = CFrame.new(P(b, x, y, z))
	if rot then
		cf *= rot
	end
	local p = newPart(b, "Part", name, Vector3.new(sx * b.S.X, sy * b.S.Y, sz * b.S.Z), cf, color, material or M.SmoothPlastic)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

-- Tige (cylindre) entre deux points du repère local
local function rod(b: B, name: string, a: Vector3, c: Vector3, diameter: number, color: Color3, material: Enum.Material?): BasePart?
	local pa, pc = PV(b, a), PV(b, c)
	local len = (pc - pa).Magnitude
	if len < 0.03 then
		return nil
	end
	local m = math.min(b.S.X, b.S.Y)
	local cf = CFrame.lookAt((pa + pc) / 2, pc) * CFrame.Angles(0, PI / 2, 0)
	local p = newPart(b, "Part", name, Vector3.new(len, diameter * m, diameter * m), cf, color, material or M.SmoothPlastic)
	;(p :: Part).Shape = Enum.PartType.Cylinder
	return p
end

-- Bande plate posée sur une surface (montants, joints) : de `a` à `c`, face
-- vers `n` (normale extérieure), largeur `w`, épaisseur `t` (enfoncée de moitié)
local function strip(b: B, name: string, a: Vector3, c: Vector3, n: Vector3, w: number, t: number, color: Color3, material: Enum.Material?, lift: number?): BasePart?
	local pa, pc = PV(b, a), PV(b, c)
	local d = pc - pa
	if d.Magnitude < 0.03 then
		return nil
	end
	local dir = d.Unit
	local nn = (n - dir * n:Dot(dir))
	if nn.Magnitude < 1e-3 then
		return nil
	end
	nn = nn.Unit
	local x = nn:Cross(dir).Unit
	return newPart(b, "Part", name, Vector3.new(w, t, d.Magnitude), CFrame.fromMatrix((pa + pc) / 2 + nn * (lift or 0), x, nn, -dir), color, material or M.SmoothPlastic)
end

----------------------------------------------------------------------
-- Maillage : triangles en 2 coins (WedgePart), quadrilatères
----------------------------------------------------------------------

-- Triangle a, b, c (repère local) : face extérieure SUR le plan du triangle,
-- épaisseur vers l'intérieur (côté de `ref`). 0, 1 ou 2 coins.
local function tri(b: B, name: string, pa: Vector3, pb: Vector3, pc: Vector3, color: Color3, material: Enum.Material, thick: number, ref: Vector3)
	local a, bb, c = PV(b, pa), PV(b, pb), PV(b, pc)
	local ab, ac, bc = bb - a, c - a, c - bb
	local dab, dac, dbc = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
	if dab > dac and dab > dbc then
		a, c = c, a
	elseif dac > dbc and dac > dab then
		a, bb = bb, a
	end
	ab, ac, bc = bb - a, c - a, c - bb
	local cross = ac:Cross(ab)
	if cross.Magnitude < 1e-5 or bc.Magnitude < 1e-3 then
		return
	end
	local right = cross.Unit
	local back = bc.Unit
	local up = bc:Cross(right).Unit
	local height = math.abs(ab:Dot(up))
	if height < 0.02 then
		return
	end
	local n = right
	if ((a + bb + c) / 3 - PV(b, ref)):Dot(n) < 0 then
		n = -n
	end
	local shift = -n * thick / 2
	local l1 = math.abs(ab:Dot(back))
	if l1 > 0.025 then
		newPart(b, "WedgePart", name, Vector3.new(thick, height, l1), CFrame.fromMatrix((a + bb) / 2 + shift, right, up, back), color, material)
	end
	local l2 = math.abs(ac:Dot(back))
	if l2 > 0.025 then
		newPart(b, "WedgePart", name, Vector3.new(thick, height, l2), CFrame.fromMatrix((a + c) / 2 + shift, -right, up, -back), color, material)
	end
end

-- Rectangle c1 -> c2 (côté u), c1 -> c4 (côté v, perpendiculaire) : 1 bloc
local function rect(b: B, name: string, c1: Vector3, c2: Vector3, c4: Vector3, color: Color3, material: Enum.Material, thick: number, ref: Vector3)
	local su, sv = PV(b, c2 - c1), PV(b, c4 - c1)
	local n = su:Cross(sv).Unit
	local center = PV(b, (c2 + c4) / 2)
	local sign = if (center - PV(b, ref)):Dot(n) < 0 then -1 else 1
	newPart(b, "Part", name, Vector3.new(su.Magnitude, sv.Magnitude, thick), CFrame.fromMatrix(center - n * sign * thick / 2, su.Unit, sv.Unit), color, material)
end

-- Trapèze (p1p2 parallèle à p4p3) : rectangle + coins rectangles (≤ 3 pièces)
local function trapezoid(b: B, name: string, p1: Vector3, p2: Vector3, p3: Vector3, p4: Vector3, color: Color3, material: Enum.Material, thick: number, ref: Vector3): boolean
	local u = p2 - p1
	local len = u.Magnitude
	local w = p3 - p4
	if len < 0.02 or w.Magnitude < 0.02 then
		return false
	end
	local ud = u / len
	if w.Unit:Dot(ud) < 0.99966 then -- (v10 : ~1,5° de tolérance)
		return false
	end
	-- (v10) quadrilatère vrillé (non plan) : pas un trapèze -> 2 triangles
	local nrm = u:Cross(p4 - p1)
	if nrm.Magnitude > 1e-4 and math.abs((p3 - p1):Dot(nrm.Unit)) > 0.03 then
		return false
	end
	local s4 = (p4 - p1):Dot(ud)
	local s3 = (p3 - p1):Dot(ud)
	local hv = (p4 - p1) - ud * s4
	if hv.Magnitude < 0.02 then
		return false
	end
	-- (v10) éclats de triangle minuscules (< SLIVER) : le bloc déborde un
	-- peu à la place (invisible, 2 à 4 pièces de moins par quadrilatère)
	local SLIVER = 0.08
	local a0 = if s4 > SLIVER then s4 elseif s4 < -SLIVER then 0 else math.min(0, s4)
	local a1 = if s3 < len - SLIVER then s3 elseif s3 > len + SLIVER then len else math.max(len, s3)
	if a1 - a0 < 0.02 then
		return false
	end
	local q1, q2 = p1 + ud * a0, p1 + ud * a1
	rect(b, name, q1, q2, q1 + hv, color, material, thick, ref)
	if s4 > SLIVER then
		tri(b, name, p1, q1, p4, color, material, thick, ref)
	elseif s4 < -SLIVER then
		tri(b, name, p1, p4, p1 + hv, color, material, thick, ref)
	end
	if s3 < len - SLIVER then
		tri(b, name, p2, q2, p3, color, material, thick, ref)
	elseif s3 > len + SLIVER then
		tri(b, name, p2, p3, p2 + hv, color, material, thick, ref)
	end
	return true
end

-- Quadrilatère p1 p2 p3 p4 (dans l'ordre) : 1 bloc si c'est un rectangle,
-- rectangle + coins si deux côtés sont parallèles, sinon 2 triangles
-- (coupés par la plus courte diagonale)
local function quad(b: B, name: string, p1: Vector3, p2: Vector3, p3: Vector3, p4: Vector3, color: Color3, material: Enum.Material, thick: number, ref: Vector3)
	local u, v = p2 - p1, p4 - p1
	if u.Magnitude > 0.02 and v.Magnitude > 0.02 and (p3 - (p2 + v)).Magnitude < 0.004 and math.abs(u.Unit:Dot(v.Unit)) < 0.002 then
		rect(b, name, p1, p2, p4, color, material, thick, ref)
		return
	end
	if trapezoid(b, name, p1, p2, p3, p4, color, material, thick, ref) or trapezoid(b, name, p2, p3, p4, p1, color, material, thick, ref) then
		return
	end
	if (p3 - p1).Magnitude <= (p4 - p2).Magnitude then
		tri(b, name, p1, p2, p3, color, material, thick, ref)
		tri(b, name, p1, p3, p4, color, material, thick, ref)
	else
		tri(b, name, p1, p2, p4, color, material, thick, ref)
		tri(b, name, p2, p3, p4, color, material, thick, ref)
	end
end

-- Coin (WedgePart) dans le plan du flanc (x0..x1) : triangle rectangle entre
-- la corde (za, ya) -> (zb, yb) et l'horizontale y = max(ya, yb) (au-dessus)
local function chordWedge(b: B, name: string, x0: number, x1: number, za: number, ya: number, zb: number, yb: number, color: Color3, material: Enum.Material)
	local ymax, ymin = math.max(ya, yb), math.min(ya, yb)
	if ymax - ymin < 0.02 or math.abs(zb - za) < 0.02 then
		return
	end
	local cf = CFrame.new(P(b, (x0 + x1) / 2, (ya + yb) / 2, (za + zb) / 2))
	if yb > ya then
		cf *= CFrame.Angles(PI, 0, 0)
	else
		cf *= CFrame.Angles(0, 0, PI)
	end
	newPart(b, "WedgePart", name, Vector3.new(math.abs(x1 - x0) * b.S.X, (ymax - ymin) * b.S.Y, math.abs(zb - za) * b.S.Z), cf, color, material)
end

----------------------------------------------------------------------
-- Géométrie d'un modèle : profils le long de z
----------------------------------------------------------------------

type Geo = {
	zF: number,
	zB: number,
	r: number,
	ra: number,
	aF0: number,
	aF1: number,
	aR0: number,
	aR1: number,
	noseR: number,
	tailR: number,
	noseLow: number,
	hoodF: number,
	sill: number,
	cowl: number,
	noseRoll: number,
	tailRoll: number,
	planX: (number) -> number,
	flankTop: (number) -> number,
	topY: (number) -> number,
	topE: (number) -> number,
	crown: (number) -> number,
	p2: (number) -> (number, number),
	ref: (number) -> Vector3,
}

-- c = bombé du dessus (le milieu est à t + c : capot, toit, vitres galbés)
type St = { z: number, t: number, e: number, bx: number, by: number, fx: number, fy: number, c: number }

local function lerp(a: number, c: number, u: number): number
	return a + (c - a) * u
end

local function makeGeo(s: Spec, lod: number?): Geo
	local g = {} :: any
	local hw = s.W / 2
	g.zF, g.zB = -s.L / 2, s.L / 2
	g.r = s.WheelD / 2
	-- (v10) jour de roue plus serré (arches collées au pneu, plus réaliste)
	g.ra = g.r + 0.14
	g.aF0, g.aF1 = s.AxleF - g.ra, s.AxleF + g.ra
	g.aR0, g.aR1 = s.AxleR - g.ra, s.AxleR + g.ra
	g.noseR = math.max(0.3, math.min(s.NoseR, g.aF0 - g.zF - 0.08))
	g.tailR = math.max(0.3, math.min(s.TailR, g.zB - g.aR1 - 0.08))
	g.noseLow = s.NoseLow or s.Low
	g.hoodF = math.max(s.HoodF, g.noseLow + 0.26)
	g.sill = s.Clear + 0.1
	g.cowl = 0.35
	local sports = s.Style == "Sports"
	local pickup = s.Style == "Pickup"
	local zF, zB = g.zF, g.zB
	-- (v10) nez et poupe ARRONDIS de profil : le capot plonge en quart de
	-- cercle vers le bouclier, le coffre / hayon retombe vers le pare-chocs
	g.noseRoll = math.clamp(g.hoodF - g.noseLow - 0.16, 0, 0.34)
	g.tailRoll = if pickup then 0 else math.clamp(s.Deck - s.Low - 0.18, 0, 0.3)

	-- demi-largeur vue de dessus (coins arrondis en quart de cercle)
	function g.planX(z: number): number
		if z < zF + g.noseR then
			local u = math.clamp((z - zF) / g.noseR, 0, 1)
			return hw - g.noseR * (1 - math.sin(math.acos(1 - u)))
		elseif z > zB - g.tailR then
			local u = math.clamp((zB - z) / g.tailR, 0, 1)
			return hw - g.tailR * (1 - math.sin(math.acos(1 - u)))
		end
		return hw
	end
	-- dessus du flanc vertical (aile qui plonge vers le nez)
	function g.flankTop(z: number): number
		local n2 = zF + g.noseR
		if z <= n2 then
			return g.noseLow
		elseif z < g.aF0 then
			local u = (z - n2) / math.max(0.01, g.aF0 - n2)
			return lerp(g.noseLow, s.Low, 1 - (1 - u) ^ 2)
		end
		return s.Low
	end
	-- ceinture (bas des vitres) dans l'habitacle
	local rise = if (lod or 3) >= 3 then s.BeltRise else 0 -- (Mid : ceinture droite, vitres rectangulaires)
	local function belt(z: number): number
		local u = math.clamp((z - s.Ws) / math.max(0.01, s.Rw - s.Ws), 0, 1)
		return lerp(s.Belt - rise / 2, s.Belt + rise / 2, u)
	end
	-- arrondi (quart de cercle) : 1 au bord, 0 à `len` du bord
	local function roll(d: number, len: number): number
		local u = math.clamp(d / math.max(0.05, len), 0, 1)
		return 1 - math.sin(u * PI / 2)
	end
	-- dessus (axe) : capot, auvent, pare-brise, toit bombé, lunette, coffre
	function g.topY(z: number): number
		local wsC = s.Ws - g.cowl
		if z <= wsC then
			local u = math.clamp((z - zF) / math.max(0.01, wsC - zF), 0, 1)
			return g.hoodF + (s.HoodR - 0.03 - g.hoodF) * (1 - (1 - u) ^ 2) - g.noseRoll * roll(z - zF, g.noseR * 0.9)
		elseif z <= s.Ws then
			return s.HoodR
		elseif z <= s.R0 then
			-- pare-brise légèrement galbé (plus raide en haut)
			local u = (z - s.Ws) / math.max(0.01, s.R0 - s.Ws)
			return lerp(s.HoodR + 0.06, s.Roof - 0.04, u + 0.12 * u * (1 - u))
		elseif sports and z < s.Rw then
			return belt(z) -- cockpit ouvert
		elseif pickup and z > s.R1 + 0.01 then
			return s.Deck -- benne ouverte
		elseif z <= s.R1 then
			return s.Roof - 0.04
		elseif z <= s.Rw then
			local u = (z - s.R1) / math.max(0.01, s.Rw - s.R1)
			return lerp(s.Roof - 0.04, s.Deck, u - 0.1 * u * (1 - u))
		end
		local u = (z - s.Rw) / math.max(0.01, zB - s.Rw)
		return s.Deck - 0.08 * u * u - g.tailRoll * roll(zB - z, g.tailR * 0.9)
	end
	-- demi-largeur du dessus (capot, toit, coffre) : le bord du bombé
	function g.topE(z: number): number
		local e = hw - s.Inset
		if sports and z < s.Ws - g.cowl then
			e = hw - 1.0
		elseif sports and z >= s.R0 and z < s.Rw then
			e = hw - s.Tumble
		elseif pickup and z > s.R1 + 0.01 then
			e = g.planX(z) - 0.1
		elseif z < s.Ws or z > s.Rw then
			-- capot / coffre plus larges que le toit (épaules pleines)
			e = hw - s.Inset * 0.72
		end
		return math.min(e, g.planX(z) - 0.1 - (if pickup and z > s.R1 + 0.01 then 0 else 0.36))
	end
	-- bombé au milieu du dessus
	function g.crown(z: number): number
		if sports and z >= s.R0 and z < s.Rw then
			return 0
		elseif pickup and z > s.R1 + 0.01 then
			return 0
		elseif z < s.Ws - g.cowl then
			return if z - zF < 0.05 then 0.02 else 0.09
		elseif z < s.Ws then
			return 0.05
		elseif z < s.R0 then
			return 0.08
		elseif z <= s.R1 then
			return 0.13
		elseif z <= s.Rw then
			return 0.08
		end
		return if zB - z < 0.05 then 0.02 else 0.07
	end
	-- épaule / ceinture (x, y) : arête de l'aile, bas des vitres
	function g.p2(z: number): (number, number)
		local px = g.planX(z)
		local t = g.topY(z)
		if z < s.Ws then
			if sports then
				return px - 0.2, t + 0.16 -- ailes plus hautes que le capot
			end
			-- (v10) épaule arrondie : l'arête descend moins près du nez
			return px - 0.04, t - math.min(0.24, (t - g.flankTop(z)) * 0.55)
		elseif pickup and z > s.R1 + 0.01 then
			return px - 0.1, s.Deck
		elseif z <= s.Rw then
			return math.min(hw - s.Tumble, px - 0.13), belt(z)
		end
		return px - 0.04, t - math.min(0.24, (t - g.flankTop(z)) * 0.55)
	end
	-- point intérieur (orientation des triangles)
	function g.ref(z: number): Vector3
		return Vector3.new(0, s.Clear + 0.3, math.clamp(z, zF + 2, zB - 2))
	end
	return g :: Geo
end

-- Sections le long de la voiture (plus nombreuses en "Full")
local function stations(s: Spec, g: Geo, lod: number): { St }
	local list: { { z: number, pri: number } } = {}
	local function add(z: number, pri: number)
		table.insert(list, { z = z, pri = pri })
	end
	add(g.zF, 3)
	add(g.zF + g.noseR, 2)
	-- coins arrondis : une section intermédiaire (45°) en "Full"
	local angles = if lod >= 3 then { PI / 4 } else {}
	for _, a in ipairs(angles) do
		add(g.zF + g.noseR * (1 - math.cos(a)), 1)
	end
	local wsC = s.Ws - g.cowl
	if lod >= 3 then
		if wsC - (g.zF + g.noseR) > 2.2 then
			add((g.zF + g.noseR + wsC) / 2, 1)
		end
		add(wsC, 1)
	end
	add(s.Ws, 3)
	add(s.R0, 3)
	add(s.R1, 3)
	add(s.Rw, 3)
	local t2 = g.zB - g.tailR
	if lod >= 3 and t2 - s.Rw > 2.2 then
		add((s.Rw + t2) / 2, 1)
	end
	add(t2, 2)
	for _, a in ipairs(angles) do
		add(g.zB - g.tailR * (1 - math.cos(a)), 1)
	end
	add(g.zB, 3)
	table.sort(list, function(a, c)
		return a.z < c.z
	end)
	-- sections trop proches : on garde la plus importante
	local i = 1
	while i < #list do
		local a, c = list[i], list[i + 1]
		if c.z - a.z < 0.14 then
			if c.pri > a.pri then
				table.remove(list, i)
			else
				table.remove(list, i + 1)
			end
		else
			i += 1
		end
	end
	local out: { St } = {}
	for _, item in ipairs(list) do
		local z = item.z
		local bx, by = g.p2(z)
		table.insert(out, { z = z, t = g.topY(z), e = g.topE(z), bx = bx, by = by, fx = g.planX(z), fy = g.flankTop(z), c = if lod >= 3 then g.crown(z) else 0 })
	end
	return out
end

-- Section interpolée en z (montants, joints)
local function sectionAt(st: { St }, z: number): St
	for i = 1, #st - 1 do
		local a, c = st[i], st[i + 1]
		if z >= a.z and z <= c.z then
			local u = (z - a.z) / math.max(1e-4, c.z - a.z)
			return { z = z, t = lerp(a.t, c.t, u), e = lerp(a.e, c.e, u), bx = lerp(a.bx, c.bx, u), by = lerp(a.by, c.by, u), fx = lerp(a.fx, c.fx, u), fy = lerp(a.fy, c.fy, u), c = lerp(a.c, c.c, u) }
		end
	end
	return if z < st[1].z then st[1] else st[#st]
end

-- (v10) hauteur du dessus BOMBÉ à l'abscisse x (Mid / Low : plat)
local function topAt(S: St, x: number): number
	return S.t + S.c * math.max(0, 1 - math.abs(x) / math.max(0.05, S.e))
end

----------------------------------------------------------------------
-- Roues
----------------------------------------------------------------------

-- (v10) Design = dessin de jante (Config.Cars.Mods.Rims), Tyre = style de pneu
type WheelLook = { Rim: Color3, Dish: Color3, Cap: Color3, Caliper: Color3, Spokes: number, Design: string, Tyre: string }

local WHITEWALL = Color3.fromRGB(240, 238, 232)

-- Roue : pneu + flanc, lèvre de jante, voile sombre, disque, étrier, rayons,
-- cache-moyeu. Couches depuis la face extérieure du pneu, espacées de ≥ 0,02.
local function wheel(b: B, s: Spec, index: number, x: number, z: number, look: WheelLook)
	local D = s.WheelD
	local r = D / 2
	local side = if x > 0 then 1 else -1
	local lod = b.Lod
	b.WheelTag = index
	b.Spin = true
	local tw = s.TyreW
	cylX(b, "Tyre", x, r, z, tw, D, TYRE, M.Rubber, true)
	local face = x + side * tw / 2
	local function layer(name: string, out: number, thick: number, diameter: number, color: Color3, material: Enum.Material): BasePart
		return cylX(b, name, face + side * (out - thick / 2), r, z, thick, diameter, color, material)
	end
	local tyre = look.Tyre
	local design = look.Design
	-- pneu taille basse : jante plus grande, flanc plus fin
	local rimK = if tyre == "LowProfile" then 0.76 else 0.66
	if lod <= 1 then
		layer("Rim", 0.05, 0.1, D * (rimK - 0.04), look.Rim, M.Metal)
		b.WheelTag = nil
		b.Spin = nil
		return
	end
	if lod == 2 then
		if tyre == "Whitewall" then
			layer("Whitewall", 0.03, 0.06, D * 0.84, WHITEWALL, M.Rubber)
		end
		layer("Rim", 0.07, 0.1, D * (rimK - 0.04), look.Rim, M.Metal)
		-- une barre sombre à travers la jante : on voit la roue tourner
		boxRotX(b, "Spoke", face + side * 0.1, r, z, 0.06, D * 0.12, D * (rimK - 0.16), 0, look.Dish, M.Metal)
		b.WheelTag = nil
		b.Spin = nil
		return
	end
	layer("Sidewall", 0.04, 0.1, D - 0.12, SIDEWALL, M.Rubber)
	-- flanc décoré
	if tyre == "Whitewall" then
		layer("Whitewall", 0.07, 0.04, D * 0.84, WHITEWALL, M.Rubber)
	elseif tyre == "RedLine" then
		-- liseré rouge fin juste autour de la jante
		layer("RedLine", 0.075, 0.03, D * (rimK + 0.05), CAL_RED, M.Rubber)
	elseif tyre == "OffRoad" then
		-- pneu tout-terrain : pavés de la bande de roulement
		for k = 0, 7 do
			local a = (k + 0.5) / 8 * 2 * PI
			boxRotX(b, "Tread", x, r + math.cos(a) * (r - 0.03), z + math.sin(a) * (r - 0.03), tw + 0.06, 0.16, D * 0.2, a, TYRE, M.Rubber)
		end
	end
	local deep = design == "DeepDish"
	-- lèvre (plus large et polie pour la jante "Deep dish"), voile, disque
	-- ("Deep dish" : large lèvre polie, petit voile sombre au centre)
	layer("RimLip", 0.1, 0.1, D * rimK, look.Rim, M.Metal).Reflectance = if deep then 0.4 else 0.25
	layer("RimDish", 0.14, 0.1, D * (rimK - (if deep then 0.2 else 0.08)), look.Dish, M.Metal)
	layer("BrakeDisc", 0.18, 0.1, D * (if deep then rimK - 0.3 else rimK * 0.66), DISC, M.Metal)
	-- étrier (braque sans tourner)
	b.Spin = false
	local ca = math.rad(40)
	local cr = D * (if deep then rimK - 0.3 else rimK * 0.66) * 0.36
	boxRotX(b, "Caliper", face + side * 0.195, r + math.cos(ca) * cr, z + math.sin(ca) * cr, 0.05, D * 0.1, D * 0.2, ca, look.Caliper)
	b.Spin = true
	-- rayons : rayon intérieur r0, extérieur r1 (sous la lèvre), largeur w,
	-- torsion (angle entre le pied et la tête du rayon : jantes "turbine", "mesh")
	local out = 0.235
	local r1 = D * (rimK / 2 - 0.02)
	local function spoke(a: number, r0: number, rEnd: number, w: number, twist: number)
		local y0, z0 = math.cos(a) * r0, math.sin(a) * r0
		local y1, z1 = math.cos(a + twist) * rEnd, math.sin(a + twist) * rEnd
		local dy, dz = y1 - y0, z1 - z0
		local len = math.sqrt(dy * dy + dz * dz)
		if len < 0.05 then
			return
		end
		boxRotX(b, "Spoke", face + side * out, r + (y0 + y1) / 2, z + (z0 + z1) / 2, 0.05, w, len, math.atan2(dz, dy) - PI / 2, look.Rim, M.Metal)
	end
	if design == "Retro" then
		-- enjoliveur plein (rétro) : disque, jonc, moyeu
		layer("Hubcap", 0.26, 0.06, D * (rimK - 0.1), look.Rim, M.Metal).Reflectance = 0.35
		layer("HubcapRing", 0.31, 0.04, D * (rimK - 0.24), look.Dish, M.Metal)
	elseif design == "Mesh" then
		for k = 0, 7 do
			local a = k / 8 * 2 * PI
			spoke(a, D * 0.08, r1, D * 0.032, 0.42)
			spoke(a, D * 0.08, r1, D * 0.032, -0.42)
		end
	elseif design == "Split" then
		for k = 0, 5 do
			local a = k / 6 * 2 * PI
			spoke(a - 0.1, D * 0.08, r1, D * 0.04, 0.05)
			spoke(a + 0.1, D * 0.08, r1, D * 0.04, -0.05)
		end
	elseif design == "Turbine" then
		for k = 0, 9 do
			spoke(k / 10 * 2 * PI, D * 0.08, r1, D * 0.075, 0.55)
		end
	elseif design == "Star" then
		for k = 0, 2 do
			spoke(k / 3 * 2 * PI, D * 0.06, r1, D * 0.17, 0)
		end
	elseif design == "Sport" then
		for k = 0, 4 do
			spoke(k / 5 * 2 * PI, D * 0.08, r1, D * 0.1, 0.12)
		end
	elseif deep then
		for k = 0, 4 do
			spoke(k / 5 * 2 * PI, D * 0.06, D * (rimK / 2 - 0.1), D * 0.08, 0)
		end
	else
		-- jante d'origine du modèle (look.Spokes rayons droits)
		local n = look.Spokes
		for k = 0, n - 1 do
			spoke(k / n * 2 * PI, D * 0.08, r1, if n >= 10 then D * 0.045 else D * 0.075, 0)
		end
	end
	layer("HubCap", if design == "Retro" then 0.36 else 0.3, 0.08, D * 0.18, look.Cap, M.Metal)
	-- pivots invisibles (CarService : Motor6D ; CarClient : rotation / braquage)
	b.Spin = false
	local steer = box(b, "WheelSteer", x - 0.1, x + 0.1, r - 0.1, r + 0.1, z - 0.1, z + 0.1, WHITE, M.SmoothPlastic)
	steer.Transparency = 1
	b.Spin = true
	local spin = box(b, "WheelSpin", x - 0.1, x + 0.1, r - 0.1, r + 0.1, z - 0.1, z + 0.1, WHITE, M.SmoothPlastic)
	spin.Transparency = 1
	b.WheelTag = nil
	b.Spin = nil
end

----------------------------------------------------------------------
-- Plaque d'immatriculation
----------------------------------------------------------------------

local function plate(b: B, name: string, z: number, y: number, facing: number, band: boolean, text: string?)
	local p = box(b, name, -0.85, 0.85, y - 0.22, y + 0.22, z - 0.03, z + 0.03, PLATE, M.SmoothPlastic)
	if band then
		-- (bande bleue 0,03 en avant de la plaque : jamais coplanaire)
		box(b, name .. "Band", -0.85, -0.63, y - 0.22, y + 0.22, z + 0.045 * facing - 0.015, z + 0.045 * facing + 0.015, PLATE_BAND, M.SmoothPlastic)
	end
	if text and text ~= "" then
		local gui = Instance.new("SurfaceGui")
		gui.Name = "PlateText"
		gui.Face = if facing > 0 then Enum.NormalId.Back else Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 40
		gui.LightInfluence = 1
		gui.MaxDistance = 60
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.new(0.8, 0, 1, 0)
		label.Position = UDim2.fromScale(0.16, 0)
		label.Font = Enum.Font.GothamBlack
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(30, 30, 40)
		label.Text = string.upper(string.sub(text, 1, 8))
		label.Parent = gui
		gui.Parent = p
	end
end

----------------------------------------------------------------------
-- Construction
----------------------------------------------------------------------

local function lodOf(detail: any): number
	if detail == "Mid" then
		return 2
	elseif detail == "Low" or detail == "Parked" then
		return 1
	end
	return 3
end

-- Version "Low" (loin / serveur) : volumes simples, ~30-45 pièces
local function buildLow(b: B, s: Spec, g: Geo, paint: Color3, roofColor: Color3, look: WheelLook)
	local hw = s.W / 2
	local style = s.Style
	local archTop = g.r + g.ra
	local low = s.Low
	-- bas de caisse découpé autour des roues (+ coins d'arche abattus)
	box(b, "Body", -hw + 0.15, hw - 0.15, g.sill, g.noseLow, g.zF, g.zF + 0.4, paint)
	box(b, "Body", -hw, hw, g.sill, low, g.zF + 0.4, g.aF0, paint, M.SmoothPlastic, true)
	box(b, "Body", -hw, hw, g.sill, low, g.aF1, g.aR0, paint, M.SmoothPlastic, true)
	box(b, "Body", -hw, hw, g.sill, low, g.aR1, g.zB - 0.4, paint, M.SmoothPlastic, true)
	box(b, "Body", -hw + 0.15, hw - 0.15, g.sill, low, g.zB - 0.4, g.zB, paint)
	for _, a in ipairs({ { g.aF0, g.aF1 }, { g.aR0, g.aR1 } }) do
		box(b, "Body", -hw, hw, archTop, low, a[1], a[2], paint)
		local c = math.min(0.5, low - archTop + 0.4)
		wedge(b, "Body", -hw, hw, archTop - c + 0.25, archTop, a[1], a[1] + c, false, paint)
		wedge(b, "Body", -hw, hw, archTop - c + 0.25, archTop, a[2] - c, a[2], true, paint)
		box(b, "WheelWell", -hw + s.TyreW + 0.25, hw - s.TyreW - 0.25, g.sill + 0.1, archTop, a[1], a[2], LINER)
	end
	-- capot, habitacle, coffre / benne
	local hoodTop = s.HoodR
	wedge(b, "Hood", -hw + 0.1, hw - 0.1, low, hoodTop, g.zF + 0.15, s.Ws, true, paint)
	box(b, "Upper", -hw, hw, low, s.Belt, s.Ws, if style == "Pickup" then s.R1 else s.Rw, paint)
	if style == "Pickup" then
		box(b, "Bed", -hw, hw, low, s.Deck, s.R1, g.zB - 0.1, paint)
		box(b, "BedFloor", -hw + 0.3, hw - 0.3, s.Deck - 0.05, s.Deck + 0.05, s.R1 + 0.3, g.zB - 0.4, TRIM)
	elseif g.zB - 0.1 - s.Rw > 0.1 then
		box(b, "Deck", -hw, hw, low, s.Deck, s.Rw, g.zB - 0.1, paint)
	end
	-- vitres + toit
	local gw = hw - s.Inset
	if style == "Sports" then
		wedge(b, "Windshield", -gw, gw, s.Belt, s.Roof, s.Ws + 0.05, s.R0, true, GLASS, M.Glass)
		box(b, "Cockpit", -hw + 0.4, hw - 0.4, low, s.Belt + 0.04, s.R0, s.R1, TRIM) -- (v9.9) dessus 0,04 au-dessus de la caisse : plus de z-fight
	else
		wedge(b, "Windshield", -gw, gw, s.Belt, s.Roof - 0.12, s.Ws + 0.05, s.R0, true, GLASS, M.Glass)
		box(b, "SideGlass", -gw, gw, s.Belt, s.Roof - 0.12, s.R0, s.R1, GLASS, M.Glass)
		box(b, "Roof", -gw + 0.05, gw - 0.05, s.Roof - 0.12, s.Roof, s.R0 - 0.05, s.R1 + 0.05, roofColor)
		if s.Rw - s.R1 > 0.1 then
			wedge(b, "RearGlass", -gw, gw, s.Belt, s.Roof - 0.12, s.R1, s.Rw, false, GLASS, M.Glass)
		else
			box(b, "RearWall", -gw, gw, s.Belt, s.Roof - 0.12, s.R1 - 0.02, s.R1 + 0.1, paint)
		end
	end
	-- phares, feux, calandre, plaque, rétroviseurs
	for _, sx in ipairs({ -1, 1 }) do
		local x0, x1 = sx * hw * 0.42, sx * (hw - 0.35)
		box(b, "Headlight", math.min(x0, x1), math.max(x0, x1), g.noseLow - 0.45, g.noseLow - 0.05, g.zF - 0.04, g.zF + 0.2, LAMP, M.Glass)
		box(b, "Taillight", math.min(x0, x1), math.max(x0, x1), low - 0.45, low - 0.08, g.zB - 0.2, g.zB + 0.04, TAIL, M.Glass)
		ell(b, "Mirror", sx * (hw + 0.2), s.Belt + 0.25, s.Ws + 0.45, 0.55, 0.4, 0.42, paint)
	end
	box(b, "Grille", -hw * 0.36, hw * 0.36, g.sill + 0.25, g.noseLow - 0.15, g.zF - 0.03, g.zF + 0.2, TRIM)
	box(b, "PlateRear", -0.8, 0.8, g.sill + 0.25, g.sill + 0.65, g.zB - 0.1, g.zB + 0.04, PLATE)
end

function CarModels.Build(carId: string?, color: any?, opts: any?): Model
	local options = type(opts) == "table" and opts or {}
	local kind = kindOf(carId)
	local s = SPECS[kind]
	local paint = CarModels.ColorOf(type(carId) == "string" and carId or kind, color)
	local lod = lodOf(options.Detail)
	local full = lod >= 3
	local scale = Vector3.new(1, 1, 1)
	if typeof(options.Scale) == "Vector3" then
		scale = options.Scale
	elseif type(options.Scale) == "number" and options.Scale > 0 then
		scale = Vector3.new(options.Scale, options.Scale, options.Scale)
	end
	local model = Instance.new("Model")
	model.Name = "Car_" .. kind
	-- (v10, CARS10) options de l'atelier (Config.Cars.Mods ; inconnues ignorées)
	local mods = CarModels.CleanMods(options.Mods)
	local function mod(kindName: string): string
		return CarModels.ModOf(mods, kindName)
	end
	local finish = mod("Finish")
	paint = finishColor(paint, finish)
	local tint = TINTS[mod("Tint")] or TINTS.Clear
	local b: B = {
		Model = model,
		S = scale,
		Count = 0,
		Paint = paint,
		Gloss = (FINISH_GLOSS[finish] or FINISH_GLOSS.Gloss)[lod],
		Lod = lod,
		PaintMat = if finish == "Matte" then M.Plastic else nil,
		GlassColor = tint[1],
		GlassT = tint[2],
	}
	local g = makeGeo(s, lod)
	local style = s.Style
	local hw = s.W / 2
	local zF, zB = g.zF, g.zB
	local sports = style == "Sports"
	local pickup = style == "Pickup"
	local offroad = style == "SUV" or style == "Pickup"
	local twoBox = style == "City" or style == "Hatch" or style == "SUV" or style == "Bubble" or style == "Van"
	local r, ra = g.r, g.ra

	-- teinte de contraste (bandes, toit bicolore)
	local lum = paint.R * 0.3 + paint.G * 0.59 + paint.B * 0.11
	local contrast = if lum > 0.62 then GRAPHITE else Color3.fromRGB(250, 248, 244)
	local stripe: Color3? = nil
	if typeof(options.Stripe) == "Color3" then
		stripe = options.Stripe
	elseif options.Stripe == true or (full and options.Stripe == nil and (style == "Sports" or style == "Hatch")) then
		stripe = contrast
	end
	local roofColor = paint
	if typeof(options.RoofColor) == "Color3" then
		roofColor = options.RoofColor
	elseif style == "Bubble" or style == "Van" then
		roofColor = WHITE:Lerp(paint, 0.06)
	elseif style == "City" then
		-- (v9.9) toit bicolore de citadine (blanc ou graphite selon la teinte)
		roofColor = contrast
	elseif (style == "Hatch" or style == "SUV") and lum > 0.22 then
		roofColor = Color3.fromRGB(34, 35, 42) -- toit noir brillant
	end
	-- (v10) toit bicolore choisi à l'atelier
	local roofMat = M.SmoothPlastic
	local roofMod = mod("Roof")
	if roofMod == "Body" then
		roofColor = paint
	elseif roofMod == "Carbon" then
		roofColor = Color3.fromRGB(30, 31, 36)
		roofMat = M.Fabric -- (tissage : effet fibre de carbone)
	elseif roofMod ~= "Auto" and Config.CarColorsById and Config.CarColorsById[roofMod] then
		roofColor = finishColor(Config.CarColorsById[roofMod].Color, finish)
	end
	-- (v10) sellerie
	local interior = Config.CarModsById and Config.CarModsById.Interior and Config.CarModsById.Interior[mod("Interior")]
	local seatCol = interior and interior.Color or SEAT
	local seatCol2 = seatCol:Lerp(Color3.new(1, 1, 1), 0.12)
	-- jantes par modèle
	local look: WheelLook = { Rim = CHROME, Dish = GRAPHITE, Cap = CHROME, Caliper = CAL_DARK, Spokes = 5, Design = "Stock", Tyre = "Road" }
	if style == "Bubble" then
		look = { Rim = WHITE, Dish = Color3.fromRGB(200, 202, 210), Cap = CHROME, Caliper = CAL_DARK, Spokes = 8, Design = "Stock", Tyre = "Road" }
	elseif sports then
		look = { Rim = GRAPHITE, Dish = HOUSING, Cap = CHROME, Caliper = CAL_RED, Spokes = 10, Design = "Stock", Tyre = "Road" }
	elseif style == "Limo" then
		look = { Rim = CHROME, Dish = GRAPHITE, Cap = GRAPHITE, Caliper = CAL_DARK, Spokes = 10, Design = "Stock", Tyre = "Road" }
	elseif offroad then
		look = { Rim = Color3.fromRGB(190, 194, 202), Dish = GRAPHITE, Cap = GRAPHITE, Caliper = CAL_DARK, Spokes = 6, Design = "Stock", Tyre = "Road" }
	elseif style == "Van" then
		look = { Rim = WHITE, Dish = Color3.fromRGB(190, 192, 200), Cap = CHROME, Caliper = CAL_DARK, Spokes = 5, Design = "Stock", Tyre = "Road" }
	elseif style == "Hatch" then
		look = { Rim = CHROME, Dish = HOUSING, Cap = GRAPHITE, Caliper = CAL_RED, Spokes = 5, Design = "Stock", Tyre = "Road" }
	end
	-- (v10) jantes, couleur des jantes, pneus de l'atelier
	look.Design = mod("Rims")
	look.Tyre = mod("Tyre")
	local rimMod = mod("RimColor")
	if rimMod == "Body" then
		look.Rim = paint
	elseif rimMod ~= "Auto" then
		local entry = Config.CarModsById and Config.CarModsById.RimColor and Config.CarModsById.RimColor[rimMod]
		if entry and typeof(entry.Color) == "Color3" then
			look.Rim = entry.Color
			look.Cap = if rimMod == "Chrome" then GRAPHITE else CHROME
		end
	end
	if look.Design == "Turbine" or look.Design == "Mesh" then
		look.Dish = HOUSING
	end

	-- boîte de collision (surélevée : les bordures passent dessous)
	local rootBottom = math.max(s.Clear, 0.95)
	local rootTop = math.max(s.Belt, rootBottom + 1.2)
	local root = box(b, "Root", -hw + 0.1, hw - 0.1, rootBottom, rootTop, zF + 0.2, zB - 0.2, WHITE, M.SmoothPlastic)
	root:SetAttribute("Paint", nil)
	root.Transparency = 1
	root.CanCollide = true
	root.CanQuery = true
	model.PrimaryPart = root
	root.PivotOffset = CFrame.new(0, -((rootBottom + rootTop) / 2) * scale.Y, 0)

	-- siège du conducteur
	local seatTop = math.min(s.Roof - 3.65, s.Clear + 1.85)
	local seatZ = s.R0 + (s.R1 - s.R0) * 0.42
	if style == "Van" then
		seatTop = 2.35
		seatZ = s.R0 + 1.35
	elseif pickup then
		seatZ = s.R0 + 1.35
	elseif sports then
		seatTop = s.Clear + 0.6
		seatZ = s.R1 - 0.95
	elseif style == "Limo" then
		seatZ = s.R0 + 1.45
	elseif style == "Bubble" then
		seatZ = s.R0 + 1.35
	end
	local seatX = -s.W * 0.2

	if lod <= 1 then
		buildLow(b, s, g, paint, roofColor, look)
	else
		local st = stations(s, g, lod)
		local thick = 0.14
		local gThick = 0.06
		----------------------------------------------------------------
		-- ░ coque : dessus, arête (vitres), épaule, coins ░
		----------------------------------------------------------------
		local wsC = s.Ws - g.cowl
		for i = 1, #st - 1 do
			local A, C = st[i], st[i + 1]
			local zm = (A.z + C.z) / 2
			local ref = g.ref(zm)
			local topCol, topMat = paint, M.SmoothPlastic
			local b1Col, b1Mat = paint, M.SmoothPlastic
			local skipTop, skipB1 = false, false
			local region
			if zm < wsC then
				region = "hood"
				if style == "Van" then
					topCol = roofColor -- (combi bicolore : capot blanc)
					b1Col = roofColor
				end
			elseif zm < s.Ws then
				region = "cowl"
				topCol = TRIM
			elseif zm < s.R0 then
				region = "wind"
				topCol, topMat = GLASS, M.Glass
				b1Col, b1Mat = GLASS, M.Glass
				if sports then
					skipB1 = true
				end
			elseif sports and zm < s.Rw then
				region = "cockpit"
				skipTop, skipB1 = true, true
			elseif pickup and zm > s.R1 then
				region = "bed"
				skipTop, skipB1 = true, true
			elseif zm < s.R1 then
				region = "roof"
				topCol, topMat = roofColor, roofMat
				b1Col, b1Mat = GLASS, M.Glass
			elseif zm < s.Rw then
				region = "rear"
				topCol, topMat = GLASS, M.Glass
				if twoBox then
					b1Col, b1Mat = GLASS, M.Glass
				end
			else
				region = "deck"
			end
			local merged = lod == 2 and (region == "hood" or region == "deck" or region == "cowl")
			local th = if topMat == M.Glass then gThick else thick
			-- dessus (trapèze : 1 bloc + 2 coins)
			if not skipTop and (A.c > 0.005 or C.c > 0.005) then
				-- (v10) dessus BOMBÉ : deux pans qui se rejoignent au milieu
				for _, sx in ipairs({ -1, 1 }) do
					quad(b, "Top", V3(0, A.t + A.c, A.z), V3(sx * A.e, A.t, A.z), V3(sx * C.e, C.t, C.z), V3(0, C.t + C.c, C.z), topCol, topMat, th, ref)
				end
			elseif not skipTop then
				local e1, e2 = A.e, C.e
				local m = math.min(e1, e2)
				quad(b, "Top", V3(-m, A.t, A.z), V3(m, A.t, A.z), V3(m, C.t, C.z), V3(-m, C.t, C.z), topCol, topMat, th, ref)
				if math.abs(e1 - e2) > 0.02 then
					for _, sx in ipairs({ -1, 1 }) do
						if e1 > e2 then
							tri(b, "Top", V3(sx * m, A.t, A.z), V3(sx * e1, A.t, A.z), V3(sx * m, C.t, C.z), topCol, topMat, th, ref)
						else
							tri(b, "Top", V3(sx * m, A.t, A.z), V3(sx * m, C.t, C.z), V3(sx * e2, C.t, C.z), topCol, topMat, th, ref)
						end
					end
				end
			end
			for _, sx in ipairs({ -1, 1 }) do
				local a1, a2, a3 = V3(sx * A.e, A.t, A.z), V3(sx * A.bx, A.by, A.z), V3(sx * A.fx, A.fy, A.z)
				local c1, c2, c3 = V3(sx * C.e, C.t, C.z), V3(sx * C.bx, C.by, C.z), V3(sx * C.fx, C.fy, C.z)
				if merged then
					quad(b, "Body", a1, a3, c3, c1, paint, M.SmoothPlastic, thick, ref)
				else
					if not skipB1 then
						quad(b, if b1Mat == M.Glass then "Window" else "Pillar", a1, a2, c2, c1, b1Col, b1Mat, if b1Mat == M.Glass then gThick else thick, ref)
					end
					quad(b, "Shoulder", a2, a3, c3, c2, paint, M.SmoothPlastic, thick, ref)
				end
				-- coins arrondis (flanc vertical sous l'épaule)
				if C.z <= zF + g.noseR + 1e-3 or A.z >= zB - g.tailR - 1e-3 then
					quad(b, "Corner", a3, V3(sx * A.fx, g.sill, A.z), V3(sx * C.fx, g.sill, C.z), c3, paint, M.SmoothPlastic, thick, ref)
				end
			end
		end

		----------------------------------------------------------------
		-- ░ flancs verticaux découpés autour des roues ░
		----------------------------------------------------------------
		local fth = 0.16
		local archN = if full then 4 else 3
		for _, sx in ipairs({ -1, 1 }) do
			local x0, x1 = sx * hw, sx * (hw - fth)
			local lo, hi = math.min(x0, x1), math.max(x0, x1)
			local function piece(z0: number, z1: number)
				if z1 - z0 < 0.02 then
					return
				end
				local t0, t1 = g.flankTop(z0), g.flankTop(z1)
				local tl = math.min(t0, t1)
				box(b, "Flank", lo, hi, g.sill, tl, z0, z1, paint, M.SmoothPlastic, true)
				if math.abs(t0 - t1) > 0.02 then
					wedge(b, "Flank", lo, hi, tl, math.max(t0, t1), z0, z1, t1 > t0, paint)
				end
			end
			local function arch(axle: number)
				for k = 0, archN - 1 do
					local a0 = -PI / 2 + k * PI / archN
					local a1 = a0 + PI / archN
					local za, ya = axle + ra * math.sin(a0), r + ra * math.cos(a0)
					local zb, yb = axle + ra * math.sin(a1), r + ra * math.cos(a1)
					local ymax = math.max(ya, yb)
					if s.Low - ymax > 0.02 then
						box(b, "ArchPanel", lo, hi, ymax, s.Low, za, zb, paint)
					end
					chordWedge(b, "ArchPanel", lo, hi, za, ya, zb, yb, paint, M.SmoothPlastic)
				end
				-- protections noires d'arches des tout-terrain
				if full then -- (v10) jonc d'aile couleur caisse sur les autres
					local lipT = if offroad then 0.32 else 0.1
					local lipOut = if offroad then 0.1 else 0.045
					local lipCol = if offroad then TRIM else paint
					local lipMat = if offroad then M.Plastic else M.SmoothPlastic
					local rr = ra + lipT / 2
					local n = 4
					for k = 0, n - 1 do
						local a = -PI / 2 + (k + 0.5) * PI / n
						local ex0, ex1 = sx * (hw - 0.1), sx * (hw + lipOut)
						-- (jonc couleur caisse : jamais au-dessus du flanc, sinon il dépasse sur l'aile)
						local topY = r + (rr + lipT / 2) / math.cos(PI / (2 * n)) * math.max(math.abs(math.cos(a - PI / (2 * n))), math.abs(math.cos(a + PI / (2 * n))))
						if not offroad and topY > g.flankTop(axle + math.sin(a) * rr) - 0.03 then
							continue
						end
						boxRotX(b, "ArchLip", (ex0 + ex1) / 2, r + math.cos(a) * rr, axle + math.sin(a) * rr, math.abs(ex1 - ex0), lipT, 2 * rr * math.tan(PI / (2 * n)) + 0.02, a, lipCol, lipMat)
					end
				end
			end
			piece(zF + g.noseR, g.aF0)
			arch(s.AxleF)
			piece(g.aF1, g.aR0)
			arch(s.AxleR)
			piece(g.aR1, zB - g.tailR)
			-- (v9.9) ligne de caractère : arête ombrée entre le flanc et l'épaule
			rod(b, "Crease", V3(sx * hw, s.Low - 0.03, g.aF0), V3(sx * hw, s.Low - 0.03, zB - g.tailR), 0.07, paint:Lerp(Color3.new(0, 0, 0), 0.3))
			-- bas de caisse (noir) entre les roues
			if full and mod("Skirts") == "None" then
				local r0x, r1x = sx * (hw - 0.1), sx * (hw + (if offroad then 0.1 else 0.035))
				box(b, "Rocker", math.min(r0x, r1x), math.max(r0x, r1x), g.sill - 0.04, g.sill + (if offroad then 0.45 else 0.3), g.aF1 + 0.05, g.aR0 - 0.05, TRIM, M.Plastic)
			end
		end
		-- passages de roue sombres (on ne voit pas dans la caisse)
		for _, pos in ipairs(CarModels.WheelPositions(kind)) do
			local sx = if pos.X > 0 then 1 else -1
			cylX(b, "WheelWell", sx * (math.abs(pos.X) - s.TyreW / 2 - 0.13), r, pos.Z, 0.08, ra * 2 + 0.1, LINER)
			if full then
				-- toit du passage de roue (vu dans le jour au-dessus du pneu)
				local inner, outer = math.max(math.abs(pos.X) - s.TyreW / 2 - 0.1, g.topE(pos.Z) + 0.12), hw - fth - 0.08
				if outer - inner > 0.1 then
					box(b, "WheelWell", sx * inner, sx * outer, r + ra + 0.05, r + ra + 0.13, pos.Z - ra * 0.75, pos.Z + ra * 0.75, LINER)
				end
			end
		end
		-- plancher (sous la voiture, entre les roues)
		box(b, "Floor", -hw + s.TyreW + 0.5, hw - s.TyreW - 0.5, s.Clear + 0.05, g.sill + 0.02, zF + 0.7, zB - 0.7, LINER)

		----------------------------------------------------------------
		-- ░ faces avant / arrière (bouclier) ░
		----------------------------------------------------------------
		local function endFace(S: St, zf: number, dir: number)
			-- dir = -1 : avant (face vers -Z) ; +1 : arrière
			local zin = zf - dir * 0.24
			local ref = V3(0, (S.fy + S.t) / 2, zf - dir * 1.5)
			box(b, "Fascia", -S.fx, S.fx, g.sill, S.fy, math.min(zf, zin), math.max(zf, zin), paint, M.SmoothPlastic, true)
			if lod < 3 and not pickup then
				-- (Mid : 2 blocs, sous la coque)
				local yb = math.min(S.by, S.t)
				if yb - S.fy > 0.03 then
					box(b, "Fascia", -S.bx, S.bx, S.fy, yb, math.min(zf, zin), math.max(zf, zin), paint)
				end
				if S.t - yb > 0.03 then
					box(b, "Fascia", -S.e, S.e, yb, S.t, math.min(zf, zin), math.max(zf, zin), paint)
				end
				return
			end
			if S.t - S.fy > 0.03 and not (pickup and dir > 0) then
				quad(b, "Fascia", V3(-S.e, S.fy, zf), V3(S.e, S.fy, zf), V3(S.e, S.t, zf), V3(-S.e, S.t, zf), paint, M.SmoothPlastic, 0.2, ref)
			end
			for _, sx in ipairs({ -1, 1 }) do
				if pickup and dir > 0 then
					quad(b, "Fascia", V3(sx * S.fx, S.fy, zf), V3(sx * S.bx, S.by, zf), V3(sx * 0.001, S.by, zf), V3(sx * 0.001, S.fy, zf), paint, M.SmoothPlastic, 0.2, ref)
				else
					quad(b, "Fascia", V3(sx * S.e, S.fy, zf), V3(sx * S.fx, S.fy, zf), V3(sx * S.bx, S.by, zf), V3(sx * S.e, S.t, zf), paint, M.SmoothPlastic, 0.2, ref)
				end
			end
		end
		endFace(st[1], zF, -1)
		endFace(st[#st], zB, 1)
		-- lèvres de pare-chocs (noires, sous les boucliers)
		local nfx, tfx = st[1].fx, st[#st].fx
		box(b, "BumperLip", -nfx + 0.1, nfx - 0.1, s.Clear, g.sill + 0.06, zF + 0.06, zF + 0.6, TRIM, M.Plastic)
		box(b, "BumperLip", -tfx + 0.1, tfx - 0.1, s.Clear, g.sill + 0.06, zB - 0.6, zB - 0.06, TRIM, M.Plastic)

		----------------------------------------------------------------
		-- ░ avant (v9.9 passe visuelle) : un VRAI visage, en couches
		-- espacées de ≥ 0,04 (aucun z-fighting) : jupe noire + prise d'air
		-- + antibrouillards cerclés + lame argent, plaque sur le bouclier,
		-- calandre (cadre chromé, grille, barres, logo), blocs optiques
		-- (cerclage chromé, boîtier noir, projecteurs, feu de jour en L,
		-- glace claire, retour sur l'angle, répétiteur) ░
		----------------------------------------------------------------
		local fy = g.noseLow
		local N0 = st[1]
		local N1 = if st[2] and st[2].z < zF + g.noseR - 0.01 then st[2] else nil
		local round = style == "Bubble" or style == "Van"
		-- (v10) bouclier moderne : jupe basse noire + grande prise d'air
		-- (maille), plaque sur le bouclier peint, antibrouillards sans chrome
		local valTop = g.sill + (if sports then 0.4 elseif round then 0.55 else 0.44)
		box(b, "Valance", -nfx + 0.08, nfx - 0.08, g.sill - 0.05, valTop, zF - 0.06, zF + 0.1, TRIM, M.Plastic)
		if full and style ~= "SUV" then
			box(b, "SkidStrip", -nfx + 0.35, nfx - 0.35, g.sill + 0.03, g.sill + 0.1, zF - 0.1, zF - 0.02, GRAPHITE, M.Metal).Reflectance = 0.2
		end
		local iw = math.min(if sports then s.W * 0.32 else s.W * 0.26, nfx - 0.7)
		box(b, "Intake", -iw, iw, g.sill + 0.14, valTop - 0.06, zF - 0.1, zF + 0.05, HOUSING, M.DiamondPlate)
		if full then
			local iy = (g.sill + 0.14 + valTop - 0.06) / 2
			box(b, "IntakeBar", -iw + 0.06, iw - 0.06, iy - 0.025, iy + 0.025, zF - 0.14, zF + 0.02, GRAPHITE, M.Metal)
			for _, sx in ipairs({ -1, 1 }) do
				local fx = sx * math.min(iw + 0.36, nfx - 0.3)
				local fyL = (g.sill + valTop) / 2 + 0.02
				cylZ(b, "FogRing", fx, fyL, zF - 0.07, 0.06, 0.3, if round then CHROME else GRAPHITE, M.Metal)
				cylZ(b, "FogLight", fx, fyL, zF - 0.11, 0.06, 0.2, LAMP, M.SmoothPlastic)
			end
		end
		if round then
			plate(b, "PlateFront", zF - 0.05, valTop + 0.22, -1, full, nil)
			-- phares ronds rétro (cerclage chromé, boîtier, lampe, point de feu de jour)
			local d = if style == "Van" then 0.95 else 1.0
			local ly = if style == "Van" then fy - 0.35 else fy - 0.3
			for _, sx in ipairs({ -1, 1 }) do
				local x = sx * (nfx - 0.62)
				cylZ(b, "HeadlightRim", x, ly, zF - 0.05, 0.14, d, CHROME, M.Metal)
				cylZ(b, "Headlight", x, ly, zF - 0.13, 0.06, d - 0.2, LAMP, M.SmoothPlastic).Reflectance = 0.15
				if full then
					cylZ(b, "HeadlightDot", x, ly, zF - 0.18, 0.06, d * 0.32, DRL, M.SmoothPlastic)
					local lens = cylZ(b, "HeadlightLens", x, ly, zF - 0.23, 0.04, d - 0.14, LENS, M.Glass)
					lens.Transparency = 0.7
					lens.Reflectance = 0.3
					cylZ(b, "Indicator", sx * (nfx - 0.12), ly - 0.6, zF - 0.04, 0.1, 0.26, AMBER, M.SmoothPlastic):SetAttribute("Side", sx)
				end
			end
			-- pare-chocs chromé rétro (barre) + calandre "sourire"
			if full then
				cylX(b, "BumperBar", 0, valTop - 0.06, zF - 0.14, nfx * 2 - 0.3, 0.26, CHROME, M.Metal).Reflectance = 0.3
				for _, sx in ipairs({ -1, 1 }) do
					box(b, "BumperGuard", sx * 0.95 - 0.08, sx * 0.95 + 0.08, valTop - 0.2, valTop + 0.35, zF - 0.24, zF - 0.1, CHROME, M.Metal)
				end
			end
			if style == "Van" then
				-- grand logo rond sur la face avant blanche (bicolore)
				local uy0 = ly + 0.45
				if N0.t - 0.05 - uy0 > 0.12 then
					box(b, "FrontUpper", -N0.e, N0.e, uy0, N0.t - 0.05, zF - 0.04, zF + 0.08, roofColor)
				end
				if full then
					cylZ(b, "Badge", 0, ly + 0.3, zF - 0.06, 0.06, 0.62, CHROME, M.Metal)
					cylZ(b, "BadgeCore", 0, ly + 0.3, zF - 0.1, 0.04, 0.4, roofColor, M.SmoothPlastic)
				end
			elseif full then
				-- petite calandre chromée "sourire" + logo
				box(b, "GrilleFrame", -0.7, 0.7, fy - 0.36, fy - 0.12, zF - 0.05, zF + 0.05, CHROME, M.Metal)
				box(b, "Grille", -0.62, 0.62, fy - 0.32, fy - 0.16, zF - 0.09, zF + 0.04, HOUSING, M.DiamondPlate)
				cylZ(b, "Badge", 0, fy - 0.24, zF - 0.13, 0.06, 0.3, CHROME, M.Metal)
			end
		else
			-- (v10) blocs optiques MODERNES : fins, hauts, étirés jusque dans
			-- l'angle arrondi ; boîtier fumé, 2 projecteurs, sourcil de feu de
			-- jour sur toute la largeur, glace claire, répétiteur ; pas de chrome
			local lh = if sports then 0.34 elseif pickup then 0.6 elseif offroad then 0.52 elseif style == "Limo" then 0.46 else 0.42
			local ly1 = fy + math.max(0.04, math.min(0.12, (N0.t - fy) * 0.5))
			for _ = 1, 3 do
				for _, yref in ipairs({ N0.fy, N0.by, N0.t, math.min(N0.by, N0.t) }) do
					if math.abs(ly1 - yref) < 0.045 then
						ly1 = yref - 0.05
					end
				end
			end
			local ly0 = ly1 - lh
			local lw = if sports then s.W * 0.22 else s.W * 0.2
			local xi = math.max(nfx - lw, 0.55)
			for _, sx in ipairs({ -1, 1 }) do
				local hx0, hx1 = sx * xi, sx * (nfx - 0.02)
				local lo, hi = math.min(hx0, hx1), math.max(hx0, hx1)
				box(b, "HeadlightHousing", lo, hi, ly0, ly1, zF - 0.07, zF + 0.08, HOUSING)
				if full then
					local width = hi - lo
					local two = width >= 0.9
					local pd = math.min(0.3, lh - 0.14, if two then width * 0.3 else width * 0.5)
					local py = ly0 + (lh - 0.08) / 2
					for _, f in ipairs(if two then { 0.3, 0.68 } else { 0.5 }) do
						local px = lerp(sx * xi, sx * nfx, f)
						cylZ(b, "ProjectorRing", px, py, zF - 0.1, 0.04, pd + 0.08, GRAPHITE, M.Metal)
						cylZ(b, "Projector", px, py, zF - 0.14, 0.04, pd, LAMP, M.SmoothPlastic).Reflectance = 0.2
					end
					-- sourcil de feu de jour (haut du bloc)
					box(b, "HeadlightDRL", lo + 0.04, hi - 0.03, ly1 - 0.1, ly1 - 0.03, zF - 0.13, zF - 0.05, DRL)
					local lens = box(b, "HeadlightLens", lo - 0.01, hi + 0.01, ly0 - 0.01, ly1 + 0.01, zF - 0.2, zF - 0.17, LENS, M.Glass)
					lens.Transparency = 0.8
					lens.Reflectance = 0.3
					local ind = box(b, "Indicator", if sx > 0 then hi - 0.3 else lo + 0.06, if sx > 0 then hi - 0.06 else lo + 0.3, ly0 + 0.05, ly0 + 0.14, zF - 0.13, zF - 0.05, AMBER)
					ind:SetAttribute("Side", sx)
					-- l'optique continue dans l'angle arrondi (boîtier + filet de feu de jour)
					if N1 then
						local dx, dz = N1.fx - N0.fx, N1.z - zF
						local nrm = V3(sx * dz, 0, -dx)
						local ym = (ly0 + ly1) / 2
						local a0 = V3(sx * (N0.fx - 0.01), ym, zF + 0.01)
						local c0 = V3(sx * (N1.fx - 0.03), ym, N1.z - 0.01)
						strip(b, "HeadlightWrap", a0, c0, nrm, lh, 0.08, HOUSING, M.SmoothPlastic, 0.04)
						strip(b, "HeadlightWrapDRL", a0 + V3(0, lh * 0.5 - 0.065, 0), c0 + V3(0, lh * 0.5 - 0.065, 0), nrm, 0.07, 0.06, DRL, M.SmoothPlastic, 0.1)
					end
				else
					box(b, "Headlight", lo + 0.05, hi - 0.05, ly0 + 0.05, ly1 - 0.05, zF - 0.11, zF - 0.03, LAMP, M.SmoothPlastic)
				end
			end
			-- calandre entre les phares : cadre, maille, barres, logo
			local gw = if sports then 0 else xi - 0.12
			local gy0, gy1 = ly0 - 0.06, ly1 - 0.04
			if style == "Limo" then
				gy0 = ly0 - 0.3
			elseif offroad then
				gy0, gy1 = ly0 - 0.34, ly1 + 0.02
			end
			if gw > 0.2 then
				local frameCol = if offroad or style == "Limo" or style == "City" then CHROME else GRAPHITE
				box(b, "GrilleFrame", -gw, gw, gy0, gy1, zF - 0.05, zF + 0.1, frameCol, M.Metal).Reflectance = 0.2
				box(b, "Grille", -gw + 0.07, gw - 0.07, gy0 + 0.06, gy1 - 0.06, zF - 0.09, zF + 0.05, HOUSING, M.DiamondPlate)
				if full then
					if style == "Limo" then
						for k = -4, 4 do
							local x = k * gw / 5
							box(b, "GrilleBar", x - 0.03, x + 0.03, gy0 + 0.06, gy1 - 0.06, zF - 0.13, zF - 0.03, CHROME, M.Metal)
						end
					else
						for k = 1, 2 do
							local y = gy0 + (gy1 - gy0) * k / 3
							box(b, "GrilleBar", -gw + 0.09, gw - 0.09, y - 0.025, y + 0.025, zF - 0.13, zF - 0.03, if offroad or style == "City" then CHROME else GRAPHITE, M.Metal)
						end
					end
					cylZ(b, "Badge", 0, (gy0 + gy1) / 2, zF - 0.16, 0.05, 0.32, CHROME, M.Metal)
					cylZ(b, "BadgeCore", 0, (gy0 + gy1) / 2, zF - 0.2, 0.04, 0.2, Color3.fromRGB(40, 80, 190), M.SmoothPlastic)
				end
			elseif full then
				-- roadster : pas de calandre, logo sur le museau
				cylZ(b, "Badge", 0, ly1 - 0.08, zF - 0.04, 0.05, 0.3, CHROME, M.Metal)
			end
			-- plaque sur le bouclier peint, entre la calandre et la prise d'air
			local py = math.clamp((valTop + gy0) / 2, valTop + 0.25, math.max(valTop + 0.25, gy0 - 0.25))
			plate(b, "PlateFront", zF - 0.17, py, -1, full, nil)
		end
		-- bas de caisse avant : Mid → phares simples déjà posés

		----------------------------------------------------------------
		-- ░ arrière : feux (cerclage, glace, barres intérieures, recul,
		-- clignotant, retour sur l'angle), jupe noire + catadioptres,
		-- échappements, plaque, jonc chromé, logo ░
		----------------------------------------------------------------
		local T0 = st[#st]
		local T1 = if st[#st - 1] and st[#st - 1].z > zB - g.tailR + 0.01 then st[#st - 1] else nil
		local tfy = T0.fy
		local tailTop = math.min(tfy + math.max(0.05, (T0.by - tfy) * 0.6), T0.t - 0.08)
		-- (v10) jamais à moins de 0,05 d'une arête du bouclier (pas de z-fight en Mid)
		for _ = 1, 3 do
			for _, yref in ipairs({ T0.fy, T0.by, T0.t, math.min(T0.by, T0.t) }) do
				if math.abs(tailTop - yref) < 0.045 then
					tailTop = yref - 0.05
				end
			end
		end
		-- (v10) feux fins et étirés (jusque dans l'angle arrondi)
		local tailBot = tailTop - (if sports then 0.36 elseif style == "Bubble" then 0.52 else 0.44)
		local tailIn = math.max(0.7, tfx - s.W * 0.2)
		if pickup then
			tailBot, tailTop = s.Low - 0.3, s.Deck - 0.35
		elseif style == "Van" then
			tailBot, tailTop = tfy - 0.25, tfy + 0.55
		end
		local rValTop = g.sill + 0.5
		for _, sx in ipairs({ -1, 1 }) do
			local tx0, tx1 = sx * (if pickup then tfx - 0.6 elseif style == "Van" then s.W * 0.2 else tailIn), sx * (tfx - 0.04)
			local lo, hi = math.min(tx0, tx1), math.max(tx0, tx1)
			if full then
				box(b, "TailBezel", lo - 0.05, hi + 0.04, tailBot - 0.05, tailTop + 0.04, zB - 0.1, zB + 0.03, HOUSING)
			end
			box(b, "Taillight", lo, hi, tailBot, tailTop, zB - 0.1, zB + 0.07, TAIL, M.SmoothPlastic)
			if full then
				-- barres lumineuses intérieures (en C) + recul + clignotant
				box(b, "TailBar", lo + 0.07, hi - 0.07, tailTop - 0.17, tailTop - 0.1, zB + 0.03, zB + 0.11, TAIL_IN, M.SmoothPlastic)
				local vx0, vx1 = if sx > 0 then hi - 0.14 else lo + 0.07, if sx > 0 then hi - 0.07 else lo + 0.14
				if tailTop - 0.17 - (tailBot + 0.26) > 0.08 then
					box(b, "TailBar", vx0, vx1, tailBot + 0.26, tailTop - 0.17, zB + 0.03, zB + 0.11, TAIL_IN, M.SmoothPlastic)
				end
				local rv0, rv1 = if sx > 0 then lo + 0.07 else hi - 0.4, if sx > 0 then lo + 0.4 else hi - 0.07
				box(b, "ReverseLight", rv0, rv1, tailBot + 0.06, tailBot + 0.22, zB + 0.03, zB + 0.11, REVERSE, M.SmoothPlastic)
				local ind = box(b, "RearIndicator", if sx > 0 then hi - 0.38 else lo + 0.07, if sx > 0 then hi - 0.07 else lo + 0.38, tailBot + 0.06, tailBot + 0.22, zB + 0.03, zB + 0.11, AMBER)
				ind:SetAttribute("Side", sx)
				local wTop = math.min(tailTop, tfy - 0.04)
				if T1 and not pickup and wTop - tailBot > 0.2 then
					local a0 = V3(sx * (T0.fx - 0.01), (tailBot + wTop) / 2, zB - 0.01)
					local c0 = V3(sx * (T1.fx - 0.03), (tailBot + wTop) / 2, T1.z + 0.01)
					local dx, dz = T1.fx - T0.fx, zB - T1.z
					local nrm = V3(sx * dz, 0, dx)
					strip(b, "TailWrap", a0, c0, nrm, wTop - tailBot, 0.08, TAIL, M.SmoothPlastic, 0.04)
					strip(b, "TailWrapBar", a0 + V3(0, (wTop - tailBot) * 0.5 - 0.1, 0), c0 + V3(0, (wTop - tailBot) * 0.5 - 0.1, 0), nrm, 0.07, 0.06, TAIL_IN, M.SmoothPlastic, 0.1)
				end
				-- catadioptre rouge au coin de la jupe
				local cx0, cx1 = sx * (tfx - 0.45), sx * (tfx - 0.2)
				box(b, "Reflector", math.min(cx0, cx1), math.max(cx0, cx1), g.sill + 0.15, g.sill + 0.27, zB + 0.04, zB + 0.1, TAIL, M.SmoothPlastic)
			end
		end
		if full and (style == "City" or style == "Hatch" or style == "SUV" or style == "Limo") then
			local bw = tailIn - 0.06
			box(b, "TailLightBar", -bw, bw, tailTop - 0.14, tailTop - 0.08, zB - 0.02, zB + 0.1, TAIL_IN, M.SmoothPlastic)
			box(b, "TailBlack", -bw + 0.05, bw - 0.05, tailTop - 0.2, tailTop, zB - 0.05, zB + 0.045, HOUSING)
		end
		-- jupe arrière noire (diffuseur) sur toute la largeur
		box(b, "Diffuser", -tfx + 0.08, tfx - 0.08, g.sill - 0.05, rValTop, zB - 0.06, zB + 0.06, TRIM, M.Plastic)
		plate(b, "PlateRear", zB + 0.05, rValTop + 0.3, 1, full, options.Plate)
		if full and not sports and not pickup then
			-- jonc chromé au-dessus de la plaque
			box(b, "TrunkChrome", -0.95, 0.95, rValTop + 0.6, rValTop + 0.66, zB - 0.02, zB + 0.05, CHROME, M.Metal)
		end
		local twin = sports or style == "Hatch" or style == "Limo"
		for _, sx in ipairs(if twin then { -1, 1 } else { 1 }) do
			cylZ(b, "Exhaust", sx * s.W * 0.3, g.sill + 0.18, zB + 0.12, 0.34, 0.28, CHROME, M.Metal).Reflectance = 0.3
			if full then
				cylZ(b, "ExhaustInner", sx * s.W * 0.3, g.sill + 0.18, zB + 0.26, 0.06, 0.18, HOUSING, M.SmoothPlastic)
			end
		end
		if full then
			cylZ(b, "BadgeRear", 0, math.min(tailTop + 0.12, T0.t - 0.14), zB + 0.03, 0.05, 0.26, CHROME, M.Metal)
		end

		----------------------------------------------------------------
		-- ░ vitrage : montants, gouttières, joncs, essuie-glaces ░
		----------------------------------------------------------------
		if not sports then
			local Aw, Ar = sectionAt(st, s.Ws), sectionAt(st, s.R0)
			local Rr = sectionAt(st, s.R1)
			for _, sx in ipairs({ -1, 1 }) do
				-- montant A (arête pare-brise / vitre latérale)
				rod(b, "PillarA", V3(sx * Aw.e, Aw.t, Aw.z), V3(sx * Ar.e, Ar.t, Ar.z), if full then 0.2 else 0.16, HOUSING)
				-- montant B (et C1 pour la limousine), noirs
				local pillars: { number } = {}
				if s.Doors == 4 or style == "Limo" then
					table.insert(pillars, s.R0 + (s.R1 - s.R0) * (if style == "Limo" then 0.36 else 0.48))
					if style == "Limo" then
						table.insert(pillars, s.R0 + (s.R1 - s.R0) * 0.7)
					end
				elseif style == "Van" then
					table.insert(pillars, s.R0 + 2.4)
					table.insert(pillars, s.R0 + 6.2)
				elseif not pickup then
					table.insert(pillars, s.R0 + (s.R1 - s.R0) * 0.68)
				end
				for _, pz in ipairs(pillars) do
					local S = sectionAt(st, pz)
					local a, c = V3(sx * S.bx, S.by, pz), V3(sx * S.e, S.t, pz)
					-- (combi : larges montants blancs, bicolore)
					local van = style == "Van"
					strip(b, "PillarB", a, c, V3(sx, 0.3, 0), if van then 0.6 else 0.32, 0.08, if van then roofColor else HOUSING, nil, 0.05)
				end
				-- montant C (vitre de custode des SUV / combis)
				if twoBox and s.Rw - s.R1 > 0.2 then
					strip(b, "PillarC", V3(sx * Rr.bx, Rr.by, s.R1 + 0.05), V3(sx * Rr.e, Rr.t, s.R1 + 0.05), V3(sx, 0.3, 0), 0.4, 0.08, HOUSING, nil, 0.05)
				end
				if style == "Van" then
					-- montant de custode blanc à l'arrière du combi
					local Sd = sectionAt(st, s.R1 - 0.45)
					strip(b, "PillarD", V3(sx * Sd.bx, Sd.by, Sd.z), V3(sx * Sd.e, Sd.t, Sd.z), V3(sx, 0.3, 0), 0.8, 0.08, roofColor, nil, 0.05)
				end
				if full then
					-- gouttière (arête du toit) + jonc de ceinture
					rod(b, "DripRail", V3(sx * (Ar.e + 0.06), Ar.t - 0.12, s.R0), V3(sx * (Rr.e + 0.06), Rr.t - 0.12, s.R1), 0.07, if style == "Limo" then CHROME else HOUSING, if style == "Limo" then M.Metal else M.SmoothPlastic)
					local endZ = if pickup then s.R1 - 0.05 else s.Rw - 0.05
					local Be = sectionAt(st, endZ)
					local chromeBelt = not pickup and style ~= "Van"
					rod(b, "BeltTrim", V3(sx * Aw.bx, Aw.by, s.Ws + 0.05), V3(sx * Be.bx, Be.by, endZ), 0.09, if chromeBelt then CHROME else HOUSING, if chromeBelt then M.Metal else M.SmoothPlastic)
					-- arête du toit arrondie (couleur du toit) au-dessus de la gouttière
					rod(b, "RoofEdge", V3(sx * (Ar.e - 0.02), Ar.t - 0.04, s.R0 + 0.05), V3(sx * (Rr.e - 0.02), Rr.t - 0.04, s.R1 - 0.05), 0.16, roofColor)
				end
			end
			if full then
				-- essuie-glaces posés sur le pare-brise
				local dy, dz = Ar.t - Aw.t, s.R0 - s.Ws
				local nrm = V3(0, dz, -dy).Unit * 0.05
				local cw = sectionAt(st, (s.Ws + s.R0) / 2).c
				local function onGlass(x: number, y: number): Vector3
					return V3(x, y, s.Ws + (y - Aw.t) / dy * dz) + nrm + V3(0, cw * math.max(0, 1 - math.abs(x) / math.max(0.1, Aw.e)), 0)
				end
				local ww = Aw.e * 2
				for _, x in ipairs({ -ww * 0.42, ww * 0.02 }) do
					rod(b, "Wiper", onGlass(x, Aw.t + 0.12), onGlass(x + ww * 0.36, Aw.t + 0.3), 0.06, GAP)
				end
				-- antenne requin
				if not pickup and style ~= "Van" then
					local Sa = sectionAt(st, s.R1 - 0.6)
					wedge(b, "Antenna", -0.1, 0.1, topAt(Sa, 0) - 0.02, topAt(Sa, 0) + 0.2, s.R1 - 1.0, s.R1 - 0.45, true, if roofColor == paint then paint else HOUSING)
				end
				-- essuie-glace arrière (hayon)
				if twoBox and s.Rw - s.R1 > 0.15 then
					local Rw2 = sectionAt(st, s.Rw)
					local rdy, rdz = Rr.t - Rw2.t, s.Rw - s.R1
					local rn = V3(0, rdz, rdy).Unit * 0.05
					local function onRear(x: number, u: number): Vector3
						local cr = lerp(Rw2.c, Rr.c, u) * math.max(0, 1 - math.abs(x) / math.max(0.1, Rr.e))
						return V3(x, lerp(Rw2.t, Rr.t, u) + cr, lerp(s.Rw, s.R1, u)) + rn
					end
					cylZ(b, "RearWiperPivot", 0, lerp(Rw2.t, Rr.t, 0.1) + lerp(Rw2.c, Rr.c, 0.1) + 0.05, lerp(s.Rw, s.R1, 0.1) + 0.08, 0.1, 0.16, GAP)
					rod(b, "RearWiper", onRear(0, 0.12), onRear(-Rr.e * 0.55, 0.62), 0.06, GAP)
				end
				-- 3e feu stop (haut du hayon)
				if twoBox then
					box(b, "BrakeLight3", -0.5, 0.5, Rr.t + Rr.c * 0.8 - 0.12, Rr.t + Rr.c * 0.8 - 0.04, s.R1 + 0.04, s.R1 + 0.14, TAIL, M.Glass)
				end
			end
		else
			-- roadster : cadre du pare-brise, arceaux, bossages, cockpit
			local Aw, Ar = sectionAt(st, s.Ws), sectionAt(st, s.R0)
			for _, sx in ipairs({ -1, 1 }) do
				rod(b, "WindshieldFrame", V3(sx * Aw.e, Aw.t, Aw.z), V3(sx * Ar.e, Ar.t, Ar.z), 0.16, HOUSING)
			end
			rod(b, "WindshieldTop", V3(-Ar.e, Ar.t, Ar.z), V3(Ar.e, Ar.t, Ar.z), 0.16, HOUSING)
			local cx = hw - s.Tumble - 0.02
			box(b, "CockpitTub", -cx, cx, s.Clear + 0.2, s.Belt - 0.1, s.R0 - 0.1, s.Rw, TRIM, M.Fabric)
			box(b, "Bulkhead", -cx, cx, s.Belt - 0.1, s.Deck + 0.02, s.R1, s.Rw + 0.05, paint)
			for _, sx in ipairs({ -1, 1 }) do
				ell(b, "Fairing", sx * s.W * 0.2, s.Deck, s.Rw + 0.9, 1.1, 0.9, 2.4, paint)
				if full then
					-- arceau de sécurité derrière chaque siège
					local hx = sx * s.W * 0.2
					rod(b, "RollHoop", V3(hx - 0.45, s.Deck, s.Rw + 0.1), V3(hx - 0.35, s.Deck + 0.95, s.Rw + 0.1), 0.14, CHROME, M.Metal)
					rod(b, "RollHoop", V3(hx + 0.45, s.Deck, s.Rw + 0.1), V3(hx + 0.35, s.Deck + 0.95, s.Rw + 0.1), 0.14, CHROME, M.Metal)
					rod(b, "RollHoop", V3(hx - 0.35, s.Deck + 0.95, s.Rw + 0.1), V3(hx + 0.35, s.Deck + 0.95, s.Rw + 0.1), 0.14, CHROME, M.Metal)
				end
			end
			if full then
				-- becquet arrière (queue de canard) + prises d'air latérales
				if mod("Spoiler") == "Stock" then
					wedge(b, "Ducktail", -hw + 0.8, hw - 0.8, s.Deck - 0.12, s.Deck + 0.08, zB - 1.3, zB - 0.4, true, paint)
				end
				for _, sx in ipairs({ -1, 1 }) do
					local ix0, ix1 = sx * (hw - 0.08), sx * (hw + 0.05)
					box(b, "SideIntake", math.min(ix0, ix1), math.max(ix0, ix1), g.sill + 0.6, s.Low - 0.35, s.R1, g.aR0 - 0.2, HOUSING)
				end
			end
		end

		----------------------------------------------------------------
		-- ░ rétroviseurs ░
		----------------------------------------------------------------
		local Aw = sectionAt(st, s.Ws + 0.45)
		for _, sx in ipairs({ -1, 1 }) do
			local mz = s.Ws + (if sports then 0.55 else 0.45)
			local my = Aw.by + 0.34
			ell(b, "Mirror", sx * (hw + 0.28), my, mz, 0.66, 0.44, 0.48, if style == "Hatch" or style == "SUV" or pickup then TRIM else paint)
			if full then
				local ax0, ax1 = sx * (Aw.bx - 0.05), sx * (hw + 0.05)
				box(b, "MirrorArm", math.min(ax0, ax1), math.max(ax0, ax1), my - 0.2, my - 0.08, mz - 0.08, mz + 0.08, HOUSING)
				local gx0, gx1 = sx * (hw + 0.06), sx * (hw + 0.5)
				box(b, "MirrorGlass", math.min(gx0, gx1), math.max(gx0, gx1), my - 0.15, my + 0.15, mz + 0.2, mz + 0.28, CHROME, M.Glass).Reflectance = 0.5
				local mi = ell(b, "MirrorBlinker", sx * (hw + 0.56), my - 0.06, mz - 0.02, 0.1, 0.1, 0.24, AMBER)
				mi:SetAttribute("Side", sx)
			end
		end

		----------------------------------------------------------------
		-- ░ détails "Full" : joints de portes, poignées, trappe, intérieur ░
		----------------------------------------------------------------
		if full then
			local function archY(z: number): number
				for _, ax in ipairs({ s.AxleF, s.AxleR }) do
					local dz = z - ax
					if math.abs(dz) < ra then
						return r + math.sqrt(ra * ra - dz * dz)
					end
				end
				return g.sill
			end
			local seams: { number } = {}
			local handles: { number } = {}
			if style == "Van" then
				seams = { s.Ws + 0.25, s.R0 + 2.4, s.R0 + 6.2 }
				handles = { s.R0 + 2.2, s.R0 + 6.0 }
			elseif pickup then
				seams = { s.Ws + 0.2, s.R1 - 0.1 }
				handles = { s.R1 - 0.45 }
			elseif s.Doors == 4 then
				local bz = s.R0 + (s.R1 - s.R0) * (if style == "Limo" then 0.36 else 0.48)
				local rz = if style == "Limo" then s.R0 + (s.R1 - s.R0) * 0.7 else math.min(s.R1 - 0.1, g.aR0 + 0.2)
				seams = { s.Ws + 0.2, bz, rz }
				handles = { bz - 0.4, rz - 0.4 }
			else
				local bz = if sports then s.R1 - 0.35 else s.R0 + (s.R1 - s.R0) * 0.68
				seams = { s.Ws + (if sports then 0.5 else 0.2), bz }
				handles = { bz - 0.45 }
			end
			for _, sx in ipairs({ -1, 1 }) do
				for _, z in ipairs(seams) do
					local y0 = math.max(g.sill + 0.25, archY(z) + 0.05)
					local S = sectionAt(st, z)
					local x0, x1 = sx * (hw - 0.02), sx * (hw + 0.012)
					if S.fy - y0 > 0.1 then
						box(b, "DoorSeam", math.min(x0, x1), math.max(x0, x1), y0, S.fy - 0.02, z - 0.022, z + 0.022, GAP)
					end
					-- (sur l'épaule, jusqu'à la ceinture)
					rod(b, "DoorSeam", V3(sx * (S.fx + 0.004), S.fy, z), V3(sx * (S.bx + 0.004), S.by, z), 0.045, GAP)
				end
				for _, z in ipairs(handles) do
					local S = sectionAt(st, z)
					local hx0, hx1 = sx * (hw - 0.03), sx * (hw + 0.07)
					box(b, "Handle", math.min(hx0, hx1), math.max(hx0, hx1), S.fy - 0.3, S.fy - 0.18, z - 0.3, z + 0.1, CHROME, M.Metal).Reflectance = 0.3
				end
			end
			-- trappe à carburant (côté droit, au-dessus de la roue arrière)
			local fz = math.min(g.aR0 - 0.45, s.Rw - 0.4)
			local fsx = if sports then -1 else 1
			cylX(b, "FuelCap", fsx * (hw + 0.004), s.Low - 0.35, if pickup or sports then g.aR1 + 0.5 else fz, 0.03, 0.42, paint:Lerp(GAP, 0.15))

			-- ░ habitacle ░
			local wc = hw - s.Tumble - 0.12
			local roofIn = s.Roof - 0.3
			box(b, "Carpet", -wc, wc, g.sill + 0.02, g.sill + 0.12, s.Ws + 0.3, if pickup then s.R1 - 0.1 else s.Rw - 0.2, CARPET, M.Fabric)
			local function seat(x: number, z: number, top: number, w: number, tall: boolean)
				box(b, "SeatCushion", x - w, x + w, math.max(top - 0.35, g.sill + 0.16), top, z - 0.75, z + 0.45, seatCol, M.Fabric)
				local backTop = math.min(top + 2.2, roofIn - 0.35)
				slab(b, "SeatBack", x, w * 2, top - 0.05, z + 0.62, backTop, z + 0.95, 0.34, seatCol, M.Fabric)
				if tall then
					box(b, "Headrest", x - 0.36, x + 0.36, backTop + 0.05, math.min(backTop + 0.5, roofIn - 0.05), z + 0.85, z + 1.15, seatCol2, M.Fabric)
				end
			end
			seat(seatX, seatZ, seatTop, 0.62, true)
			seat(-seatX, seatZ, seatTop, 0.62, true)
			if style ~= "Sports" and not pickup and style ~= "Van" then
				local rz = seatZ + 2.35
				if style == "Limo" then
					rz = seatZ + 3.2
				end
				local lim = if twoBox then s.R1 + 0.4 else s.Rw - 0.3
				if rz + 1.0 < lim then
					seat(0, rz, seatTop + 0.05, wc - 0.1, false)
				end
			end
			if style == "Van" then
				-- coin salon du combi : banquette + petite table
				box(b, "VanBench", -wc + 0.1, wc - 0.1, seatTop - 0.35, seatTop, s.R1 - 2.6, s.R1 - 1.3, seatCol2, M.Fabric)
				slab(b, "VanBenchBack", 0, wc * 2 - 0.2, seatTop, s.R1 - 1.25, seatTop + 1.9, s.R1 - 0.95, 0.3, seatCol2, M.Fabric)
				box(b, "VanTable", -1.0, 1.0, seatTop + 0.6, seatTop + 0.72, s.R1 - 4.4, s.R1 - 3.2, Color3.fromRGB(196, 160, 120), M.Wood)
			end
			-- planche de bord, écran, compteurs, volant, console
			local dashZ0 = s.Ws + 0.12
			local dashZ1 = s.Ws + (if style == "Van" then 0.9 else 1.05)
			local by0 = sectionAt(st, s.Ws + 0.1).by
			box(b, "Dashboard", -wc, wc, by0 - 0.55, by0 + 0.06, dashZ0, dashZ1, TRIM)
			box(b, "DashTop", -wc + 0.1, wc - 0.1, by0 + 0.06, by0 + 0.12, dashZ0 + 0.1, dashZ1 - 0.2, GRAPHITE, M.Fabric)
			box(b, "Screen", -0.5, 0.5, by0 + 0.12, by0 + 0.52, dashZ1 - 0.45, dashZ1 - 0.37, SCREEN, M.Glass)
			local swZ = math.min(seatZ - 1.45, dashZ1 + 0.35)
			local sw = cylZ(b, "SteeringWheel", seatX, by0 + 0.08, swZ, 0.1, 1.0, HOUSING)
			sw.CFrame = sw.CFrame * CFrame.Angles(0, 0, math.rad(-22))
			cylZ(b, "WheelHub", seatX, by0 + 0.08, swZ + 0.08, 0.1, 0.32, GRAPHITE)
			rod(b, "SteeringColumn", V3(seatX, by0 - 0.25, dashZ1 - 0.1), V3(seatX, by0 + 0.02, swZ + 0.1), 0.16, GRAPHITE)
			if style ~= "Van" then
				box(b, "Console", -0.32, 0.32, g.sill + 0.12, seatTop - 0.05, dashZ1 - 0.02, seatZ + 0.3, TRIM)
				ell(b, "GearKnob", 0, seatTop + 0.18, seatZ - 0.8, 0.2, 0.24, 0.2, CHROME, M.Metal)
			end
			if not sports then
				-- ciel de toit clair
				box(b, "Headliner", -(hw - s.Inset - 0.25), hw - s.Inset - 0.25, roofIn - 0.08, roofIn - 0.02, s.R0 + 0.35, s.R1 - 0.35, HEADLINER, M.Fabric)
			end
		end

		----------------------------------------------------------------
		-- ░ bande bicolore (option) ░
		----------------------------------------------------------------
		if stripe then
			if sports then
				-- deux bandes de course sur le capot (suivent la courbe) + le coffre
				for _, sx in ipairs({ -1, 1 }) do
					local x = sx * 0.4
					local prev: St? = nil
					for _, S in ipairs(st) do
						if S.z > s.Ws - g.cowl + 0.01 then
							break
						end
						if prev and S.z - prev.z > 0.05 then
							strip(b, "Stripe", V3(x, topAt(prev, x) + 0.01, prev.z + 0.02), V3(x, topAt(S, x) + 0.01, S.z), V3(0, 1, 0), 0.4, 0.04, stripe :: Color3)
						end
						prev = S
					end
					box(b, "Stripe", x - 0.2, x + 0.2, s.Deck - 0.02, s.Deck + 0.02, s.Rw + 2.2, zB - 1.4, stripe :: Color3)
				end
			elseif style ~= "Van" and style ~= "Bubble" then
				-- filet latéral sur le flanc (entre les roues)
				for _, sx in ipairs({ -1, 1 }) do
					local x0, x1 = sx * (hw - 0.02), sx * (hw + 0.018)
					local y = s.Low - 0.55
					box(b, "Stripe", math.min(x0, x1), math.max(x0, x1), y - 0.07, y + 0.07, g.aF1 + 0.2, g.aR0 - 0.2, stripe :: Color3)
				end
			end
		end

		----------------------------------------------------------------
		-- ░ particularités de chaque modèle ░
		----------------------------------------------------------------
		if style == "Bubble" and full then
			-- roue de secours ronde à l'arrière (housse couleur carrosserie)
			cylZ(b, "SpareWheel", 0, s.Low + 0.2, zB + 0.25, 0.42, 1.5, TYRE, M.Rubber)
			cylZ(b, "SpareCover", 0, s.Low + 0.2, zB + 0.48, 0.1, 1.2, WHITE:Lerp(paint, 0.3))
		elseif style == "Hatch" and mod("Spoiler") == "Stock" then
			local Rr = sectionAt(st, s.R1)
			box(b, "Spoiler", -Rr.e + 0.1, Rr.e - 0.1, Rr.t + Rr.c - 0.02, Rr.t + Rr.c + 0.1, s.R1 - 0.05, s.R1 + 0.5, GRAPHITE)
		elseif style == "SUV" then
			local R0s, R1s = sectionAt(st, s.R0 + 0.4), sectionAt(st, s.R1 - 0.4)
			for _, sx in ipairs({ -1, 1 }) do
				local x = sx * (R0s.e - 0.25)
				rod(b, "RoofRail", V3(x, topAt(R0s, x) + 0.12, R0s.z), V3(x, topAt(R1s, x) + 0.12, R1s.z), 0.16, HOUSING, M.Metal)
				if full then
					for _, zz in ipairs({ R0s.z, R1s.z }) do
						local Sz = sectionAt(st, zz)
						box(b, "RailFoot", x - 0.08, x + 0.08, topAt(Sz, x) - 0.02, topAt(Sz, x) + 0.1, zz - 0.15, zz + 0.15, HOUSING)
					end
				end
			end
			if full then
				box(b, "SkidPlate", -s.W * 0.28, s.W * 0.28, s.Clear - 0.06, g.sill + 0.12, zF - 0.12, zF + 0.5, CHROME, M.Metal)
				box(b, "SkidPlateR", -s.W * 0.25, s.W * 0.25, s.Clear - 0.06, g.sill + 0.12, zB - 0.5, zB + 0.12, CHROME, M.Metal)
			end
		elseif pickup then
			-- benne : plancher, parois intérieures, face avant, hayon ; paroi arrière de la cabine
			local bz0, bz1 = s.R1 + 0.02, zB - 0.25
			local bedY = s.Low - 0.3
			local ix = hw - 0.28
			box(b, "BedFloor", -ix, ix, bedY - 0.1, bedY, bz0, bz1, GRAPHITE, M.DiamondPlate)
			for _, sx in ipairs({ -1, 1 }) do
				local x0, x1 = sx * ix, sx * (ix + 0.1)
				box(b, "BedWall", math.min(x0, x1), math.max(x0, x1), bedY, s.Deck - 0.02, bz0, bz1, paint)
				local rx0, rx1 = sx * (ix - 0.04), sx * (hw - 0.06)
				box(b, "BedRail", math.min(rx0, rx1), math.max(rx0, rx1), s.Deck - 0.02, s.Deck + 0.1, bz0, zB - 0.1, HOUSING, M.Plastic)
			end
			box(b, "BedFront", -ix, ix, bedY, s.Deck, bz0, bz0 + 0.12, paint)
			box(b, "Tailgate", -ix, ix, bedY, s.Deck - 0.04, bz1, zB - 0.1, paint)
			local cw = hw - s.Inset
			-- paroi arrière de la cabine = cadre autour de la lunette (on voit l'habitacle)
			local gx, cy0, cy1 = cw - 0.45, s.Deck + 0.35, s.Roof - 0.45
			box(b, "CabBack", -cw, cw, s.Deck, cy0, s.R1 - 0.02, s.R1 + 0.1, paint)
			box(b, "CabBack", -cw, cw, cy1, s.Roof - 0.12, s.R1 - 0.02, s.R1 + 0.1, paint)
			for _, sx in ipairs({ -1, 1 }) do
				box(b, "CabBack", math.min(sx * gx, sx * cw), math.max(sx * gx, sx * cw), cy0, cy1, s.R1 - 0.02, s.R1 + 0.1, paint)
			end
			box(b, "CabGlass", -gx - 0.05, gx + 0.05, cy0 - 0.05, cy1 + 0.05, s.R1 + 0.02, s.R1 + 0.06, GLASS, M.Glass)
			if full then
				for k = -2, 2 do
					box(b, "BedRib", k * 0.9 - 0.08, k * 0.9 + 0.08, bedY, bedY + 0.06, bz0 + 0.3, bz1 - 0.3, CHROME, M.Metal)
				end
				box(b, "TailgateHandle", -0.4, 0.4, s.Deck - 0.45, s.Deck - 0.3, zB - 0.12, zB - 0.04, HOUSING)
				box(b, "TowHitch", -0.22, 0.22, g.sill - 0.02, g.sill + 0.2, zB - 0.1, zB + 0.45, GRAPHITE, M.Metal)
				-- marchepieds
				for _, sx in ipairs({ -1, 1 }) do
					local sx0, sx1 = sx * (hw - 0.2), sx * (hw + 0.3)
					box(b, "SideStep", math.min(sx0, sx1), math.max(sx0, sx1), g.sill - 0.18, g.sill - 0.04, g.aF1 + 0.2, g.aR0 - 0.2, GRAPHITE, M.DiamondPlate)
				end
			end
		elseif style == "Van" then
			-- gros logo rond, galerie + planche de surf
			if full then
				local vy = fy + 0.15
				cylZ(b, "Badge", 0, vy - 0.55, zF - 0.05, 0.06, 0.7, CHROME, M.Metal)
				local Rr = sectionAt(st, s.R0 + 1)
				for _, z in ipairs({ s.R0 + 1.4, s.R1 - 1.4 }) do
					box(b, "RackBar", -Rr.e + 0.2, Rr.e - 0.2, s.Roof + Rr.c + 0.02, s.Roof + Rr.c + 0.2, z - 0.1, z + 0.1, HOUSING, M.Metal)
				end
				local boardL = math.min(s.R1 - s.R0 - 1.2, 7.2)
				local bc = (s.R0 + s.R1) / 2
				local surf = Color3.fromRGB(120, 220, 230)
				box(b, "Surfboard", -0.7, 0.7, s.Roof + Rr.c + 0.2, s.Roof + Rr.c + 0.34, bc - boardL / 2 + 0.7, bc + boardL / 2 - 0.4, surf)
				cylY(b, "SurfboardNose", 0, s.Roof + Rr.c + 0.27, bc - boardL / 2 + 0.7, 0.14, 1.4, surf)
				box(b, "SurfboardStripe", -0.1, 0.1, s.Roof + Rr.c + 0.34, s.Roof + Rr.c + 0.37, bc - boardL / 2 + 0.9, bc + boardL / 2 - 0.55, Color3.fromRGB(255, 150, 196))
				-- rail de porte coulissante
				local rx0, rx1 = hw - s.Inset + 0.02, hw - s.Inset + 0.1
				local Sr = sectionAt(st, s.R0 + 4)
				box(b, "SlideRail", rx0, rx1, Sr.by + 0.95, Sr.by + 1.02, s.R0 + 2.5, s.R0 + 6.1, HOUSING, M.Metal)
			end
		elseif style == "Limo" then
			if full then
				ell(b, "Ornament", 0, topAt(sectionAt(st, zF + 0.6), 0) + 0.12, zF + 0.6, 0.14, 0.3, 0.14, CHROME, M.Metal)
				for _, sx in ipairs({ -1, 1 }) do
					local cx0, cx1 = sx * (hw - 0.02), sx * (hw + 0.05)
					box(b, "ChromeSill", math.min(cx0, cx1), math.max(cx0, cx1), g.sill + 0.32, g.sill + 0.4, g.aF1 + 0.1, g.aR0 - 0.1, CHROME, M.Metal)
				end
			end
		end

		----------------------------------------------------------------
		-- ░ (v10, CARS10) KIT CARROSSERIE de l'atelier : lame avant, bas de
		-- caisse, aileron, néon sous caisse (Mid : aileron, bas de caisse,
		-- néon ; Full : tout) ░
		----------------------------------------------------------------
		local kitNfx = st[1].fx
		local splitter = mod("Splitter")
		if full and splitter ~= "None" then
			local race = splitter == "Race"
			local y0 = s.Clear - (if race then 0.06 else 0.02)
			local sp = box(b, "Splitter", -kitNfx + (if race then 0.05 else 0.2), kitNfx - (if race then 0.05 else 0.2), y0, s.Clear + 0.04, zF - (if race then 0.42 else 0.22), zF + 0.3, HOUSING, M.SmoothPlastic)
			sp.Reflectance = 0.1
			if race then
				-- dérives aux extrémités + ailettes (canards) sur les coins du bouclier
				for _, sx in ipairs({ -1, 1 }) do
					local x0, x1 = sx * (kitNfx - 0.05), sx * (kitNfx - 0.13)
					box(b, "SplitterFin", math.min(x0, x1), math.max(x0, x1), s.Clear + 0.04, s.Clear + 0.3, zF - 0.4, zF - 0.02, HOUSING)
					local cx0, cx1 = sx * (kitNfx - 0.1), sx * (kitNfx + 0.25)
					wedge(b, "Canard", math.min(cx0, cx1), math.max(cx0, cx1), g.sill + 0.5, g.sill + 0.62, zF - 0.02, zF + 0.5, true, HOUSING)
				end
			end
		end
		local skirts = mod("Skirts") == "Sport"
		if skirts then
			for _, sx in ipairs({ -1, 1 }) do
				local x0, x1 = sx * (hw - 0.06), sx * (hw + 0.1)
				box(b, "SideSkirt", math.min(x0, x1), math.max(x0, x1), g.sill - 0.12, g.sill + 0.34, g.aF1 + 0.06, g.aR0 - 0.06, paint)
				if full and not pickup then -- (le pick-up a déjà ses marchepieds)
					local l0, l1 = sx * (hw - 0.02), sx * (hw + 0.14)
					box(b, "SkirtLip", math.min(l0, l1), math.max(l0, l1), g.sill - 0.16, g.sill - 0.08, g.aF1 + 0.1, g.aR0 - 0.1, HOUSING, M.Plastic)
				end
			end
		end
		-- aileron : sur l'arête du toit (2 volumes) ou sur le coffre (3 volumes)
		local spoiler = mod("Spoiler")
		if spoiler ~= "Stock" and spoiler ~= "None" and (full or spoiler == "Wing" or spoiler == "GT") then
			local roofMount = twoBox
			local carbon = Color3.fromRGB(30, 31, 36)
			if roofMount then
				local Rr = sectionAt(st, s.R1)
				local yTop = Rr.t + Rr.c
				local e = Rr.e
				if spoiler == "Lip" then
					wedge(b, "Spoiler", -e + 0.12, e - 0.12, yTop - 0.02, yTop + 0.12, s.R1 - 0.1, s.R1 + 0.5, false, paint)
				elseif spoiler == "Duck" then
					-- grand becquet de pavillon (dessus plat + dessous en biseau)
					box(b, "Spoiler", -e + 0.08, e - 0.08, yTop - 0.02, yTop + 0.08, s.R1 - 0.15, s.R1 + 0.6, paint)
					wedge(b, "Spoiler", -e + 0.08, e - 0.08, yTop - 0.22, yTop - 0.02, s.R1 + 0.2, s.R1 + 0.6, true, paint)
				else
					local gt = spoiler == "GT"
					local lift = if gt then 0.5 else 0.28
					local bladeCol = if gt then carbon else paint
					for _, sx in ipairs({ -1, 1 }) do
						local px = sx * (e - 0.45)
						box(b, "WingPost", px - 0.05, px + 0.05, Rr.t + Rr.c * 0.4 - 0.02, yTop + lift, s.R1 - 0.1, s.R1 + 0.2, HOUSING)
					end
					local blade = box(b, "Wing", -e - (if gt then 0.1 else -0.05), e + (if gt then 0.1 else -0.05), yTop + lift, yTop + lift + 0.1, s.R1 - 0.25, s.R1 + (if gt then 0.75 else 0.55), bladeCol, if gt then M.Fabric else M.SmoothPlastic)
					blade.CFrame = blade.CFrame * CFrame.Angles(math.rad(-6), 0, 0)
					if gt and full then
						for _, sx in ipairs({ -1, 1 }) do
							local ex = sx * (e + 0.14)
							box(b, "WingPlate", ex - 0.04, ex + 0.04, yTop + lift - 0.2, yTop + lift + 0.26, s.R1 - 0.35, s.R1 + 0.8, carbon, M.Fabric)
						end
					end
				end
			else
				local deckZ = zB - 0.75
				local Sd = sectionAt(st, deckZ)
				local deckY = if pickup then s.Deck + 0.1 else topAt(Sd, 0)
				local e = if pickup then hw - 0.3 else Sd.e
				if spoiler == "Lip" then
					wedge(b, "Spoiler", -e + 0.15, e - 0.15, deckY - 0.04, deckY + 0.12, zB - 0.75, zB - 0.25, true, paint)
				elseif spoiler == "Duck" then
					wedge(b, "Spoiler", -e + 0.1, e - 0.1, deckY - 0.08, deckY + 0.22, zB - 1.4, zB - 0.3, true, paint)
				else
					local gt = spoiler == "GT"
					local lift = if gt then 0.95 else 0.6
					local bladeCol = if gt then carbon else paint
					local wz0, wz1 = zB - (if gt then 1.35 else 1.1), zB - 0.3
					for _, sx in ipairs({ -1, 1 }) do
						local px = sx * math.min(e - 0.3, hw * 0.55)
						box(b, "WingPost", px - 0.06, px + 0.06, deckY - 0.06, deckY + lift, wz0 + 0.3, wz0 + 0.62, HOUSING)
					end
					local half = (if gt then hw - 0.15 else hw - 0.5)
					local blade = box(b, "Wing", -half, half, deckY + lift, deckY + lift + 0.1, wz0, wz1, bladeCol, if gt then M.Fabric else M.SmoothPlastic)
					blade.CFrame = blade.CFrame * CFrame.Angles(math.rad(-8), 0, 0)
					if gt and full then
						for _, sx in ipairs({ -1, 1 }) do
							local ex = sx * (half + 0.05)
							box(b, "WingPlate", ex - 0.04, ex + 0.04, deckY + lift - 0.25, deckY + lift + 0.3, wz0 - 0.1, wz1 + 0.05, carbon, M.Fabric)
						end
					end
				end
			end
		end
		-- néon doux sous la caisse (Neon translucide, AUCUNE lumière)
		local glow = Config.CarModsById and Config.CarModsById.Glow and Config.CarModsById.Glow[mod("Glow")]
		if glow and typeof(glow.Color) == "Color3" then
			local gy0, gy1 = math.max(0.12, s.Clear - 0.12), math.max(0.18, s.Clear - 0.05)
			local parts = {}
			for _, sx in ipairs({ -1, 1 }) do
				local x0, x1 = sx * (hw - 0.3), sx * (hw - 0.16)
				table.insert(parts, box(b, "Underglow", math.min(x0, x1), math.max(x0, x1), gy0, gy1, g.aF1 + 0.1, g.aR0 - 0.1, glow.Color, M.Neon))
			end
			if full then
				table.insert(parts, box(b, "Underglow", -kitNfx + 0.5, kitNfx - 0.5, gy0, gy1, zF + 0.5, zF + 0.64, glow.Color, M.Neon))
				table.insert(parts, box(b, "Underglow", -st[#st].fx + 0.5, st[#st].fx - 0.5, gy0, gy1, zB - 0.64, zB - 0.5, glow.Color, M.Neon))
			end
			for _, q in ipairs(parts) do
				q.Transparency = 0.3
				q:SetAttribute("Glow", true)
			end
		end
	end

	-- ░ roues ░
	for index, pos in ipairs(CarModels.WheelPositions(kind)) do
		wheel(b, s, index, pos.X, pos.Z, look)
	end

	-- attributs (siège du conducteur : repère du pivot)
	model:SetAttribute("CarId", type(carId) == "string" and carId or kind)
	model:SetAttribute("CarKind", kind)
	model:SetAttribute("Length", s.L * scale.Z)
	model:SetAttribute("Width", s.W * scale.X)
	model:SetAttribute("Height", s.Roof * scale.Y)
	model:SetAttribute("WheelRadius", s.WheelD / 2 * math.min(scale.Y, scale.Z))
	model:SetAttribute("SeatCF", CFrame.new(P(b, seatX, seatTop, seatZ)))
	model:SetAttribute("Lod", lod)
	model:SetAttribute("PartCount", b.Count)
	-- (v10) finition (Repaint la garde) et options de l'atelier
	model:SetAttribute("Finish", finish)
	model:SetAttribute("Mods", CarModels.EncodeMods(mods))
	return model
end

----------------------------------------------------------------------
-- 🚦 (v10) FEUX : stop, recul, clignotants, phares (côté CLIENT, local :
-- CarClient pour les voitures des joueurs ; TownTraffic peut s'en servir).
-- On passe les glaces en Neon (plus clair) quand le feu est allumé :
-- aucune lumière, aucun son.
----------------------------------------------------------------------
export type LightEntry = { Part: BasePart, Color: Color3, Material: Enum.Material, Side: number }
export type LightRig = {
	Brake: { LightEntry },
	Reverse: { LightEntry },
	Blink: { LightEntry },
	Head: { LightEntry },
	State: { [string]: any },
}

local LIGHT_KIND: { [string]: string } = {
	Taillight = "Brake",
	TailWrap = "Brake",
	TailBar = "Brake",
	TailWrapBar = "Brake",
	TailLightBar = "Brake",
	BrakeLight3 = "Brake",
	ReverseLight = "Reverse",
	Indicator = "Blink",
	RearIndicator = "Blink",
	MirrorBlinker = "Blink",
	HeadlightDRL = "Head",
	HeadlightWrapDRL = "Head",
	Projector = "Head",
	Headlight = "Head",
	HeadlightDot = "Head",
	FogLight = "Head",
}
local LIGHT_ON: { [string]: Color3 } = {
	Brake = Color3.fromRGB(255, 46, 64),
	Reverse = Color3.fromRGB(255, 255, 255),
	Blink = Color3.fromRGB(255, 170, 40),
	Head = Color3.fromRGB(255, 250, 236),
}

function CarModels.LightRig(model: Instance): LightRig
	local rig: LightRig = { Brake = {}, Reverse = {}, Blink = {}, Head = {}, State = {} }
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local kind = LIGHT_KIND[d.Name]
			if kind then
				local side = tonumber(d:GetAttribute("Side")) or (if d.Position.X > 0 then 1 else -1)
				table.insert((rig :: any)[kind], { Part = d, Color = d.Color, Material = d.Material, Side = side })
			end
		end
	end
	return rig
end

-- state = { Brake = bool, Reverse = bool, Blink = -1 | 0 | 1 (côté, déjà
-- cadencé par l'appelant), Hazard = bool, Head = bool } ; ne touche une pièce
-- que si son état change (bon marché, appelable 10 fois / s)
function CarModels.SetLights(rig: LightRig, state: any)
	local function apply(kind: string, list: { LightEntry }, wantFor: (LightEntry) -> boolean)
		for _, e in ipairs(list) do
			local on = wantFor(e)
			local key = e.Part
			if rig.State[key] ~= on then
				rig.State[key] = on
				if on then
					e.Part.Material = Enum.Material.Neon
					e.Part.Color = LIGHT_ON[kind]:Lerp(e.Color, 0.25)
				else
					e.Part.Material = e.Material
					e.Part.Color = e.Color
				end
			end
		end
	end
	local brake = state.Brake == true
	local reverse = state.Reverse == true
	local blink = tonumber(state.Blink) or 0
	local hazard = state.Hazard == true
	local head = state.Head == true
	apply("Brake", rig.Brake, function()
		return brake
	end)
	apply("Reverse", rig.Reverse, function()
		return reverse
	end)
	apply("Blink", rig.Blink, function(e: LightEntry)
		return hazard or (blink ~= 0 and e.Side == blink)
	end)
	apply("Head", rig.Head, function()
		return head
	end)
end

----------------------------------------------------------------------
-- Animation des roues d'un modèle ANCRÉ (circulation, vitrines)
----------------------------------------------------------------------

export type WheelSet = {
	Center: CFrame,
	Front: boolean,
	Radius: number,
	Spin: { BasePart },
	SpinOff: { CFrame },
	Steer: { BasePart },
	SteerOff: { CFrame },
}
export type Rig = { Body: { BasePart }, BodyOff: { CFrame }, Wheels: { WheelSet }, Parts: { BasePart }, Frames: { CFrame } }

function CarModels.WheelRig(model: Model): Rig
	-- (générique : toute maquette dont les pièces de roue portent "Wheel" /
	-- "Spin" ; le centre et le rayon de chaque roue = ceux de son pneu "Tyre")
	local pivot = model:GetPivot()
	local groups: { [number]: { BasePart } } = {}
	local tyres: { [number]: BasePart } = {}
	local body: { BasePart } = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local w = d:GetAttribute("Wheel")
			if type(w) == "number" then
				groups[w] = groups[w] or {}
				table.insert(groups[w], d)
				if d.Name == "Tyre" and not tyres[w] then
					tyres[w] = d
				end
			else
				table.insert(body, d)
			end
		end
	end
	local rig: Rig = { Body = body, BodyOff = {}, Wheels = {}, Parts = {}, Frames = {} }
	for _, p in ipairs(body) do
		table.insert(rig.BodyOff, pivot:ToObjectSpace(p.CFrame))
		table.insert(rig.Parts, p)
	end
	local indices = {}
	for index in pairs(groups) do
		table.insert(indices, index)
	end
	table.sort(indices)
	for _, index in ipairs(indices) do
		local tyre = tyres[index]
		local list = groups[index]
		if not tyre then
			-- (pas de pneu : pièces fixées au corps)
			for _, p in ipairs(list) do
				table.insert(rig.Body, p)
				table.insert(rig.BodyOff, pivot:ToObjectSpace(p.CFrame))
				table.insert(rig.Parts, p)
			end
		else
			local center = CFrame.new(pivot:PointToObjectSpace(tyre.Position))
			local set: WheelSet = { Center = center, Front = center.Position.Z < 0, Radius = tyre.Size.Y / 2, Spin = {}, SpinOff = {}, Steer = {}, SteerOff = {} }
			local world = pivot * center
			for _, p in ipairs(list) do
				local off = world:ToObjectSpace(p.CFrame)
				if p:GetAttribute("Spin") then
					table.insert(set.Spin, p)
					table.insert(set.SpinOff, off)
				else
					table.insert(set.Steer, p)
					table.insert(set.SteerOff, off)
				end
			end
			table.insert(rig.Wheels, set)
		end
	end
	-- (ordre de rig.Parts = celui de PoseRig : corps, puis chaque roue)
	table.clear(rig.Parts)
	for _, p in ipairs(rig.Body) do
		table.insert(rig.Parts, p)
	end
	for _, set in ipairs(rig.Wheels) do
		for _, p in ipairs(set.Spin) do
			table.insert(rig.Parts, p)
		end
		for _, p in ipairs(set.Steer) do
			table.insert(rig.Parts, p)
		end
	end
	for i = 1, #rig.Parts do
		rig.Frames[i] = rig.Parts[i].CFrame
	end
	return rig
end

-- Pose : pivot (monde), rotation des roues `spin` (rad), braquage `steer`
-- (rad, roues avant), `bob` = CFrame de caisse (suspension). Renvoie les
-- listes à passer à workspace:BulkMoveTo.
function CarModels.PoseRig(rig: Rig, pivot: CFrame, spin: number, steer: number, bob: CFrame?): ({ BasePart }, { CFrame })
	local frames = rig.Frames
	local i = 0
	local body = if bob then pivot * bob else pivot
	for _, off in ipairs(rig.BodyOff) do
		i += 1
		frames[i] = body * off
	end
	local spinCF = CFrame.Angles(-spin, 0, 0)
	for _, set in ipairs(rig.Wheels) do
		local c = pivot * set.Center
		local steered = if set.Front and steer ~= 0 then c * CFrame.Angles(0, steer, 0) else c
		local spun = steered * spinCF
		for _, off in ipairs(set.SpinOff) do
			i += 1
			frames[i] = spun * off
		end
		for _, off in ipairs(set.SteerOff) do
			i += 1
			frames[i] = steered * off
		end
	end
	return rig.Parts, frames
end

return CarModels
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="250">
        <Properties>
          <string name="Name">ChatTopics</string>
          <string name="Source"><![CDATA[--[[
	ChatTopics (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > ChatTopics

	Devine de quoi parle un message tapé par le joueur (chat du live, mails)
	pour que les faux spectateurs / correspondants répondent "en fonction de
	ce qu'il a dit". Utilisé par le SERVEUR (Services > ChatService) : le
	résultat (une liste de sujets) est renvoyé au client avec le texte filtré.

	ChatTopics.Detect(text) -> { "Greeting", "Question", ... } (ordre =
	importance, sans doublon, 4 au plus). Mots-clés anglais ET français
	(argot de chat compris : "slt", "cc", "mdr", "ptdr", "wsh", "lol", "gg"...),
	sans accents, en minuscules, et emojis.
	Forme des mots-clés :
	  - "mot"        : mot entier ("hi" ne trouve pas "hit") ; les lettres
	                   répétées sont tolérées ("hellooo", "coucouuu", "mdrrr",
	                   "byee" trouvent "hello", "coucou", "mdr", "bye") ;
	  - "debut*"     : début de mot ("haha*" trouve "hahahaha", "ador*" trouve
	                   "adorable") ;
	  - "deux mots"  : expression, mots entiers dans l'ordre ("bonne nuit",
	                   "how old", "je t aime" : l'apostrophe sépare les mots) ;
	  - symbole / emoji : cherché tel quel ("?", "<3", "😂").
	ChatTopics.Negations annule un sujet quand une expression est trouvée
	("pas nul" n'est pas méchant).
	v9 : beaucoup plus de mots (argot FR/EN, emojis), lettres répétées,
	débuts de mots, expressions entières, négations ; "chat" retiré des
	animaux (c'est aussi le chat du live !) ; "test" retiré de l'école.
]]

local ChatTopics = {}

-- Sujet -> mots-clés (voir l'en-tête pour leur forme)
ChatTopics.Keywords = {
	Greeting = {
		"hi", "hii", "hello", "helo", "hey", "heya", "yo", "sup", "wassup", "wsp", "hiya", "howdy", "greetings", "hallo",
		"hola", "bonjour", "bjr", "salut", "slt", "coucou", "cc", "kikou", "bonsoir", "bsr", "wesh", "wsh", "gm",
		"good morning", "good evening", "good afternoon", "👋", "🙋",
	},
	Bye = {
		"bye", "goodbye", "bye bye", "byebye", "cya", "see ya", "see you", "later", "laters", "ttyl", "gtg", "g2g", "gn",
		"goodnight", "good night", "night", "aurevoir", "au revoir", "revoir", "ciao", "tchao", "adieu", "bonne nuit",
		"a plus", "a+", "a toute", "a demain", "a bientot", "bonne soiree", "bonne journee", "je dois y aller", "je vais y aller",
		"je file", "brb",
	},
	Love = {
		"love", "loves", "loved", "lovely", "luv", "ily", "ilysm", "cute", "cutie", "adorable", "kawaii", "aime", "aimes",
		"aimer", "ador*", "mignon", "mignonne", "chou", "choupi", "mims", "coeur", "coeurs", "bisou", "bisous", "jtm",

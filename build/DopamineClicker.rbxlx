		ZIndex = 20,
		Visible = false,
		Parent = stage,
	})
	previewChip.AnchorPoint = Vector2.new(0.5, 0)
	previewChip.Position = UDim2.new(0.5, 0, 0, 6)

	-- Astuce en mode édition
	editHint = UIUtil.Chip({

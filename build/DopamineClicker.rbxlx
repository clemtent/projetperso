-- Pot de miel : miel qui coule, cuillère en bois, abeille qui vole
Art.HoneyPot = function(body, kit, _item)
	local C = kit.C
	local pot = Color3.fromRGB(255, 205, 120)
	local honey = Color3.fromRGB(250, 170, 40)
	kit.Line(body, 58, 40, 76, 12, 3, C.WoodDark, 0, 1)
	local dip = kit.Blob(body, 78, 10, 10, 12, C.WoodLight, { Z = 2, Rotation = 30 })
	kit.Box(dip, 0, 4, 10, 1.4, C.WoodDark, 0.3, 2)
	kit.Box(dip, 0, 7.5, 10, 1.4, C.WoodDark, 0.3, 2)
	local p = kit.Blob(body, 50, 70, 64, 54, pot, { Z = 2, Shine = true })
	kit.Part(body, 30, 36, 40, 12, kit.Darken(pot, 0.06), { Radius = 5, Z = 3 })
	kit.Blob(body, 50, 38, 34, 7, honey, { Z = 4, Outline = false })
	for _, d in ipairs({ { 34, 12 }, { 44, 20 }, { 58, 9 }, { 66, 15 } }) do
		drip(body, kit, d[1], 40, 6, d[2], honey, 4)
	end
	kit.Box(p, 4, 22, 56, 2, kit.Darken(pot, 0.2), 0.5, 2)
	kit.Face(body, 50, 72, 26, { Eyes = "big", Mouth = "smile", Z = 5 })
	local bee = kit.Group(body, 6, 16, 22, 18, 7)
	kit.Blob(bee, 9, 4, 8, 7, WHITE, { Z = 1, T = 0.3 })
	kit.Blob(bee, 14, 4, 8, 7, WHITE, { Z = 1, T = 0.3 })
	local b = kit.Blob(bee, 11, 11, 16, 12, C.Butter, { Z = 2 })
	kit.Box(b, 5, 0, 2.2, 12, C.Ink, 0.1, 2)
	kit.Box(b, 10, 0, 2.2, 12, C.Ink, 0.1, 2)
	kit.Circle(b, 13.4, 4.5, 2, 2, C.Ink, 0, 3)
	kit.Animate(bee, "Bob", 2.5, 1, 0.3)
	return nil
end

-- Bento : riz souriant + umeboshi, tamagoyaki, saucisse pieuvre, brocoli
Art.BentoBox = function(body, kit, _item)
	local C = kit.C
	local box = Color3.fromRGB(255, 160, 185)
	local lid = kit.Part(body, 14, 22, 72, 30, kit.Lighten(box, 0.25), { Radius = 8, Z = 1, Rotation = -7 })
	kit.Box(lid, 30, 0, 10, 30, C.Sky, 0.1, 2)
	kit.Part(body, 6, 44, 88, 38, kit.Darken(box, 0.05), { Radius = 8, Z = 2 })
	kit.Part(body, 11, 48, 40, 28, WHITE, { Radius = 5, Z = 3, Outline = kit.OutlineOf(C.Cream) })
	kit.Blob(body, 21, 55, 9, 9, C.PinkDeep, { Z = 5, Shine = true })
	kit.Blob(body, 23, 51, 5, 3, C.LeafDark, { Z = 6, Outline = false, Rotation = -20 })
	kit.Face(body, 32, 64, 22, { Eyes = "happy", Mouth = "smile", Z = 4 })
	kit.Part(body, 54, 48, 36, 28, C.Cream, { Radius = 5, Z = 3 })
	for _, x in ipairs({ 57, 67 }) do
		local tama = kit.Part(body, x, 51, 10, 11, C.Butter, { Radius = 3, Z = 4 })
		kit.Box(tama, 2, 3, 6, 1.2, C.Orange, 0.3, 2)
		kit.Box(tama, 2, 6.5, 6, 1.2, C.Orange, 0.3, 2)
	end
	-- Saucisse pieuvre
	local red = Color3.fromRGB(245, 110, 110)
	for i = 0, 3 do
		kit.Part(body, 76.5 + i * 3.2, 58, 2.6, 7, red, { Radius = -1, Z = 4, Thickness = 1 })
	end
	local octo = kit.Blob(body, 82, 55, 13, 11, red, { Z = 5, Shine = true })
	kit.Circle(octo, 4, 5.5, 1.8, 1.8, C.Ink, 0, 3)
	kit.Circle(octo, 9, 5.5, 1.8, 1.8, C.Ink, 0, 3)
	for i = 0, 2 do
		kit.Blob(body, 60 + i * 5, 70 - (i % 2) * 2, 7, 7, C.Leaf, { Z = 4 + i % 2 })
	end
	strawberry(body, kit, 82, 71, 9, 4)
	local front = kit.Part(body, 6, 76, 88, 22, box, { Radius = 8, Z = 6, Shine = true })
	kit.Box(front, 36, 0, 16, 22, C.Sky, 0.1, 2)
	kit.Heart(front, 44, 11, 8, WHITE, 0, 3)
	return nil
end

-- Bocal à cookies : couvercle ourson, cookies au chocolat derrière le verre
Art.CookieJar = function(body, kit, _item)
	local C = kit.C
	local cookie = Color3.fromRGB(235, 175, 100)
	local chip = Color3.fromRGB(110, 70, 55)
	local function oneCookie(cx, cy, w, z)
		local c = kit.Blob(body, cx, cy, w, w * 0.8, cookie, { Z = z })
		for _, p in ipairs({ { 0.3, 0.35 }, { 0.62, 0.3 }, { 0.48, 0.65 }, { 0.75, 0.62 } }) do
			kit.Circle(c, w * p[1], w * 0.8 * p[2], 3, 2.6, chip, 0, 2)
		end
		return c
	end
	kit.Part(body, 20, 38, 60, 60, C.Glass, { Radius = 16, Z = 1, T = 0.4, Outline = false })
	oneCookie(36, 86, 26, 2)
	oneCookie(63, 84, 26, 2)
	oneCookie(47, 68, 26, 2)
	oneCookie(64, 57, 22, 2)
	local jar = kit.Part(body, 20, 38, 60, 60, C.Glass, { Radius = 16, Z = 3, T = 0.85, Shade = false })
	kit.Shine(jar, 6, 10, 5, 36, 3, 0.25)
	kit.Shine(jar, 50, 40, 3, 10, 3, 0.4)
	local pink = Color3.fromRGB(255, 175, 200)
	for _, x in ipairs({ 32, 68 }) do
		kit.Blob(body, x, 20, 13, 13, pink, { Z = 4 })
		kit.Circle(body, x, 20, 6, 6, C.PinkSoft, 0, 5)
	end
	kit.Blob(body, 50, 30, 50, 22, pink, { Z = 5, Shine = true })
	kit.Part(body, 18, 34, 64, 8, kit.Darken(pink, 0.08), { Radius = 4, Z = 6 })
	kit.Face(body, 50, 30, 18, { Eyes = "dot", Mouth = "cat", Z = 7 })
	oneCookie(88, 92, 18, 8)
	return nil
end

----------------------------------------------------------------------
-- Gros électroménager
----------------------------------------------------------------------

-- Frigo rétro menthe : congélateur souriant, aimants, dessin et liste
Art.Fridge = function(body, kit, _item)
	local C = kit.C
	local mint = Color3.fromRGB(170, 230, 212)
	local door = kit.Lighten(mint, 0.25)
	for _, x in ipairs({ 22, 70 }) do
		kit.Part(body, x, 92, 8, 8, C.GreyDark, { Radius = 2, Z = 1 })
	end
	local fridge = kit.Part(body, 14, 2, 72, 92, mint, { Radius = 16, Z = 2, Shade = 0.15 })
	kit.Shine(fridge, 4, 14, 3.5, 60, 3, 0.4)
	local top = kit.Part(body, 18, 6, 64, 28, door, { Radius = 12, Z = 3, Shine = true })
	local main = kit.Part(body, 18, 37, 64, 51, door, { Radius = 12, Z = 3 })
	kit.Part(body, 70, 14, 5, 13, C.Cream, { Radius = -1, Z = 4, Shine = true })
	kit.Part(body, 70, 43, 5, 24, C.Cream, { Radius = -1, Z = 4, Shine = true })
	kit.Face(top, 26, 14, 26, { Eyes = "big", Mouth = "cat", Z = 3 })
	kit.Part(body, 22, 88, 56, 4, kit.Darken(mint, 0.15), { Radius = 2, Z = 3 })
	-- Aimants et papiers
	kit.Heart(main, 11, 9, 9, C.Pink, 0, 5)
	kit.Sparkle(main, 42, 8, 10, C.Yellow, 0, 5)
	local photo = kit.Part(main, 6, 17, 22, 24, WHITE, { Radius = 2, Z = 3, Rotation = -6 })
	local pic = kit.Box(photo, 2.5, 2.5, 17, 14, C.Sky, 0, 2)
	kit.Circle(pic, 13, 4, 5, 5, C.Yellow, 0, 2)
	kit.Blob(pic, 6, 14, 18, 10, C.Leaf, { Z = 2, Outline = false, Shade = false })
	kit.Heart(photo, 11, 20, 4, C.Pink, 0, 3)
	kit.Circle(main, 17, 18, 5, 5, C.Red, 0, 5)
	local note = kit.Part(main, 32, 20, 18, 22, C.Butter, { Radius = 2, Z = 3, Rotation = 5 })
	for i = 0, 2 do
		kit.Box(note, 3, 6 + i * 5, 12 - i * 3, 1.4, C.GreyDark, 0.4, 2)
	end
	kit.Circle(main, 41, 21, 5, 5, C.Lilac, 0, 5)
	kit.Blob(main, 25, 46, 6, 6, C.Mint, { Z = 5 })
	kit.Blob(main, 33, 46, 6, 6, C.Sky, { Z = 5 })
	kit.Blob(main, 41, 46, 6, 6, C.Pink, { Z = 5 })
	return nil
end

-- Cuisinière rose rétro : horloge, poêle + œuf, casserole souriante, four chaud
Art.Stove = function(body, kit, _item)
	local C = kit.C
	local pink = Color3.fromRGB(255, 185, 208)
	local back = kit.Part(body, 10, 8, 80, 30, kit.Lighten(pink, 0.4), { Radius = 8, Z = 1 })
	local clock = kit.Blob(back, 40, 9, 13, 13, WHITE, { Z = 2 })
	kit.Line(clock, 6.5, 6.5, 6.5, 3, 1.4, C.Ink, 0, 2)
	kit.Line(clock, 6.5, 6.5, 9.5, 6.5, 1.4, C.Ink, 0, 2)
	-- Poêle et œuf
	kit.Line(body, 6, 26, 18, 30, 3.5, C.WoodDark, 0, 4)
	kit.Part(body, 16, 28, 30, 8, C.GreyDark, { Radius = 4, Z = 4 })
	kit.Blob(body, 31, 28, 30, 7, Color3.fromRGB(90, 86, 100), { Z = 4, Outline = false })
	kit.Blob(body, 31, 26, 20, 6, WHITE, { Z = 5 })
	kit.Blob(body, 31, 25, 8, 5, C.Yellow, { Z = 6, Shine = true })
	-- Casserole souriante
	kit.Part(body, 56, 20, 7, 4, C.Lilac, { Radius = 2, Z = 4 })
	kit.Part(body, 87, 20, 7, 4, C.Lilac, { Radius = 2, Z = 4 })
	local pot = kit.Part(body, 60, 14, 29, 22, C.Lilac, { Radius = 6, Z = 5, Shine = true })
	kit.Blob(body, 74.5, 14, 33, 7, kit.Lighten(C.Lilac, 0.3), { Z = 6 })
	kit.Blob(body, 74.5, 10, 7, 5, C.Pink, { Z = 7 })
	kit.Face(pot, 14.5, 13, 17, { Eyes = "happy", Mouth = "smile", Z = 3 })
	steam(body, kit, 68, 8, 16, 0)
	steam(body, kit, 81, 6, 14, 1.3)
	-- Corps et four
	kit.Part(body, 6, 36, 88, 7, WHITE, { Radius = 3, Z = 3 })
	local stove = kit.Part(body, 8, 40, 84, 54, pink, { Radius = 10, Z = 2 })
	kit.Shine(stove, 3, 6, 3, 30, 3, 0.4)
	for _, x in ipairs({ 12, 24, 60, 72 }) do
		local knob = kit.Blob(stove, x, 9, 8, 8, WHITE, { Z = 3 })
		kit.Line(knob, 4, 4, 4, 1.5, 1.4, C.PinkDeep, 0, 2)
	end
	local screen = kit.Part(stove, 34, 5, 16, 8, Color3.fromRGB(80, 60, 80), { Radius = 2, Z = 3 })
	kit.Heart(screen, 8, 4, 5, C.Pink, 0, 2)
	local oven = kit.Part(body, 14, 56, 72, 34, kit.Lighten(pink, 0.3), { Radius = 8, Z = 3 })
	kit.Part(oven, 6, 3, 60, 5, C.Cream, { Radius = -1, Z = 3, Shine = true })
	local window = kit.Part(oven, 9, 11, 54, 19, Color3.fromRGB(110, 60, 75), { Radius = 6, Z = 2 })
	local warm = kit.Box(window, 3, 3, 48, 13, C.Orange, 0.55, 2)
	kit.Round(warm, 4)
	kit.Animate(warm, "Pulse", 0.25, 0.8, 0)
	kit.Box(window, 8, 13, 38, 1.6, C.GreyDark, 0, 3)
	for _, x in ipairs({ 15, 27, 39 }) do
		kit.Blob(window, x, 10.5, 9, 5, C.Butter, { Z = 3, Thickness = 1 })
	end
	kit.Line(window, 38, 4, 46, 12, 2, WHITE, 0.6, 4)
	for _, x in ipairs({ 14, 78 }) do
		kit.Part(body, x, 92, 8, 7, C.GreyDark, { Radius = 2, Z = 1 })
	end
	return nil
end

----------------------------------------------------------------------
-- Grands plats et desserts de fête
----------------------------------------------------------------------

-- Plateau de sushis : geta en bois, nigiris saumon / thon, makis, wasabi
Art.SushiPlatter = function(body, kit, _item)
	local C = kit.C
	for _, x in ipairs({ 14, 76 }) do
		kit.Part(body, x, 86, 10, 12, C.WoodDark, { Radius = 2, Z = 1 })
	end
	kit.Part(body, 4, 66, 92, 16, C.WoodLight, { Radius = 4, Z = 2 })
	kit.Part(body, 4, 78, 92, 10, C.Wood, { Radius = 4, Z = 3, Shine = true })
	local function nigiri(cx, fish, stripes, z, eyes)
		kit.Blob(body, cx, 67, 26, 13, WHITE, { Z = z })
		local f = kit.Part(body, cx - 15, 55, 30, 12, fish, { Radius = 6, Z = z + 1, Rotation = -4, Shine = true })
		for _, x in ipairs({ 9, 16, 23 }) do
			local l = kit.Box(f, x, 1, 1.6, 10, stripes, 0.2, 2)
			l.Rotation = 20
		end
		kit.Face(body, cx, 63, 14, { Eyes = eyes, Mouth = "smile", Z = z + 2 })
	end
	nigiri(20, Color3.fromRGB(255, 160, 120), WHITE, 4, "happy")
	nigiri(47, Color3.fromRGB(240, 95, 115), Color3.fromRGB(255, 160, 170), 4, "dot")
	for _, x in ipairs({ 72, 88 }) do
		kit.Blob(body, x, 63, 16, 16, Color3.fromRGB(50, 70, 60), { Z = 4 })
		kit.Circle(body, x, 62, 11, 11, WHITE, 0, 5)
		kit.Circle(body, x - 1, 62, 5, 5, C.Orange, 0, 6)
		kit.Circle(body, x + 2, 61, 3, 3, C.Leaf, 0, 6)
	end
	kit.Blob(body, 68, 76, 10, 6, C.Leaf, { Z = 7, Shine = true })
	for i = 0, 2 do
		kit.Blob(body, 80 + i * 4, 76 - (i % 2), 7, 5, C.PinkSoft, { Z = 7 + i, Rotation = -20 + i * 20 })
	end
	kit.Heart(body, 24, 76, 6, C.Pink, 0, 7)
	return nil
end

-- Gâteau d'anniversaire : 2 étages, coulures, bougies qui vacillent (lueur)
Art.BirthdayCake = function(body, kit, _item)
	local C = kit.C
	local pink = Color3.fromRGB(255, 180, 205)
	local cream = Color3.fromRGB(255, 246, 228)
	kit.Part(body, 40, 94, 20, 5, C.Gold, { Radius = 2, Z = 1 })
	kit.Blob(body, 50, 94, 92, 8, C.LilacSoft, { Z = 2 })
	local low = kit.Part(body, 12, 58, 76, 36, pink, { Radius = 10, Z = 3, Shine = true })
	kit.Part(body, 11, 56, 78, 9, WHITE, { Radius = 5, Z = 4 })
	for _, d in ipairs({ { 17, 9 }, { 28, 5 }, { 40, 11 }, { 58, 6 }, { 70, 10 }, { 82, 6 } }) do
		drip(body, kit, d[1], 60, 5, d[2], WHITE, 4)
	end
	for i = 0, 5 do
		kit.Circle(body, 18 + i * 12.8, 92, 7, 6, WHITE, 0, 5)
	end
	for _, p in ipairs({ { 10, 26, C.Sky, 30 }, { 62, 22, C.Butter, -30 }, { 66, 30, C.Mint, 60 }, { 6, 16, C.Lilac, -50 } }) do
		local sp = kit.Box(low, p[1], p[2], 5, 1.8, p[3], 0, 3)
		sp.Rotation = p[4]
		kit.Round(sp)
	end
	kit.Face(low, 38, 20, 26, { Eyes = "happy", Mouth = "o", Z = 3 })
	-- Bougies
	for i, p in ipairs({ { 38, C.Mint }, { 50, C.Pink }, { 62, C.Lilac } }) do
		local x = p[1]
		local candle = kit.Part(body, x - 2.5, 12 + (i % 2) * 3, 5, 24, p[2], { Radius = 2, Z = 5 })
		kit.Box(candle, 0, 6, 5, 2, WHITE, 0.3, 2)
		kit.Box(candle, 0, 13, 5, 2, WHITE, 0.3, 2)
		local flame = kit.Blob(body, x, 6 + (i % 2) * 3, 7, 10, C.Orange, { Z = 6, Outline = false })
		kit.Blob(flame, 3.5, 6, 3.5, 5, C.Butter, { Z = 2, Outline = false, Shade = false })
		kit.Animate(flame, "Flicker", 0.25, 1, i * 1.7)
	end
	local top = kit.Part(body, 26, 32, 48, 26, cream, { Radius = 8, Z = 6, Shine = true })
	kit.Heart(top, 24, 15, 10, C.Pink, 0, 3)
	kit.Part(body, 25, 30, 50, 8, pink, { Radius = 4, Z = 7 })
	for _, d in ipairs({ { 32, 7 }, { 46, 4 }, { 58, 8 }, { 68, 5 } }) do
		drip(body, kit, d[1], 34, 4.5, d[2], pink, 7)
	end
	kit.Blob(body, 18, 53, 9, 9, C.Red, { Z = 8, Shine = true })
	kit.Blob(body, 82, 53, 9, 9, C.Red, { Z = 8, Shine = true })
	return { Glow = Color3.fromRGB(255, 200, 120) }
end

-- Tour de pancakes : sirop d'érable qui coule, beurre, fraise, myrtilles
Art.PancakeTower = function(body, kit, _item)
	local C = kit.C
	local cake = Color3.fromRGB(242, 190, 115)
	local syrup = Color3.fromRGB(200, 115, 50)
	kit.Blob(body, 50, 94, 90, 10, C.Sky, { Z = 1 })
	for i = 0, 5 do
		local jitter = ({ 0, -2, 2, -1, 1, -2 })[i + 1]
		local pc = kit.Part(body, 14 + jitter, 83 - i * 8, 72, 11, cake, { Radius = -1, Z = 2 + i, Shade = false })
		kit.Gradient(pc, Color3.fromRGB(255, 240, 210), Color3.fromRGB(215, 175, 140), 90)
	end
	kit.Blob(body, 50, 44, 64, 9, syrup, { Z = 9, Outline = false })
	for _, d in ipairs({ { 22, 22 }, { 36, 10 }, { 60, 14 }, { 76, 30 } }) do
		drip(body, kit, d[1], 44, 5.5, d[2], syrup, 9)
	end
	kit.Part(body, 42, 32, 16, 10, C.Butter, { Radius = 3, Z = 10, Shine = true })
	strawberry(body, kit, 30, 38, 11, 10)
	kit.Circle(body, 68, 40, 8, 8, C.Blue, 0, 10)
	kit.Circle(body, 74, 42, 7, 7, C.Navy, 0, 10)
	kit.Face(body, 50, 73, 22, { Eyes = "dot", Mouth = "smile", Z = 9 })
	return nil
end

-- Sucette géante arc-en-ciel sur son pot à bonbons (tourbillon qui tourne)
Art.GiantLollipop = function(body, kit, _item)
	local C = kit.C
	kit.Part(body, 47, 50, 6, 34, WHITE, { Radius = 3, Z = 2 })
	for _, y in ipairs({ 60, 70 }) do
		kit.Line(body, 47.5, y + 3, 52.5, y - 1, 1.8, C.Pink, 0, 3)
	end
	local potColor = Color3.fromRGB(190, 225, 250)
	for _, p in ipairs({ { 38, 78, C.Pink }, { 50, 76, C.Butter }, { 62, 78, C.Mint } }) do
		kit.Blob(body, p[1], p[2], 10, 10, p[3], { Z = 3 })
	end
	kit.Part(body, 28, 78, 44, 8, kit.Lighten(potColor, 0.3), { Radius = 4, Z = 5 })
	local pot = kit.Part(body, 32, 84, 36, 15, potColor, { Radius = 6, Z = 4, Shine = true })
	kit.Heart(pot, 18, 7.5, 7, C.Pink, 0, 3)
	kit.Blob(body, 50, 30, 60, 60, WHITE, { Z = 4, Outline = C.PinkDeep, Thickness = 2 })
	local swirl = kit.Pivot(body, 50, 30, 5)
	local colors = { C.Pink, C.Butter, C.Mint, C.Sky, C.Lilac, C.Peach }
	for i = 0, 5 do
		local a = math.rad(i * 60)
		local petal = kit.Box(swirl, 0, 0, 26, 12, colors[i + 1], 0, 1)
		petal.AnchorPoint = Vector2.new(0.5, 0.5)
		petal.Position = UDim2.fromOffset(math.cos(a) * 14, math.sin(a) * 14)
		petal.Rotation = i * 60 + 35
		kit.Round(petal)
	end
	kit.Animate(swirl, "Spin", 1, 0.06, 0)
	kit.Blob(body, 50, 30, 22, 22, WHITE, { Z = 6, Outline = kit.OutlineOf(C.PinkSoft) })
	kit.Face(body, 50, 31, 18, { Eyes = "big", Mouth = "cat", Z = 7 })
	kit.Shine(body, 30, 10, 12, 6, 8, 0.3)
	kit.Blob(body, 43, 62, 14, 9, C.PinkDeep, { Z = 6, Rotation = 20 })
	kit.Blob(body, 57, 62, 14, 9, C.PinkDeep, { Z = 6, Rotation = -20 })
	kit.Blob(body, 50, 62, 6, 6, C.Pink, { Z = 7 })
	kit.Sparkle(body, 86, 14, 10, C.Butter, 0, 8)
	kit.Sparkle(body, 12, 46, 8, C.Sky, 0, 8)
	return nil
end

-- Chariot à glaces : auvent rayé, vitrine de bacs, grande coupe glacée
Art.SundaeBar = function(body, kit, _item)
	local C = kit.C
	local mint = Color3.fromRGB(185, 235, 218)
	for _, x in ipairs({ 11, 85 }) do
		kit.Part(body, x, 8, 4, 52, WHITE, { Radius = 2, Z = 1 })
	end
	local awning = kit.Part(body, 4, -2, 92, 13, C.Pink, { Radius = 6, Z = 4 })
	for i = 0, 3 do
		kit.Box(awning, 8 + i * 22, 0, 11, 13, WHITE, 0.1, 2)
	end
	for i = 0, 5 do
		kit.Blob(body, 11.7 + i * 15.3, 11, 15.3, 9, if i % 2 == 0 then C.Pink else WHITE, { Z = 3 })
	end
	for _, x in ipairs({ 20, 80 }) do
		kit.Blob(body, x, 93, 13, 13, C.GreyDark, { Z = 2 })
		kit.Circle(body, x, 93, 5, 5, C.Grey, 0, 3)
	end
	local cart = kit.Part(body, 8, 58, 84, 34, mint, { Radius = 8, Z = 3, Shine = true })
	for _, p in ipairs({ { 22, C.Pink }, { 42, Color3.fromRGB(150, 100, 80) }, { 62, C.Butter } }) do
		kit.Blob(cart, p[1], 18, 16, 10, p[2], { Z = 2 })
	end
	local glass = kit.Part(cart, 8, 10, 68, 18, C.Glass, { Radius = 5, Z = 3, T = 0.55 })
	kit.Shine(glass, 4, 3, 16, 3, 2, 0.3)
	kit.Part(body, 4, 54, 92, 8, C.Cream, { Radius = 4, Z = 5 })
	-- Coupe glacée
	kit.Blob(body, 50, 54, 20, 5, C.LilacSoft, { Z = 6 })
	kit.Part(body, 48, 46, 4, 8, C.LilacSoft, { Radius = 1, Z = 6 })
	kit.Line(body, 60, 30, 68, 14, 3.2, Color3.fromRGB(120, 75, 60), 0, 6)
	kit.Line(body, 62.5, 25, 64.5, 21, 3.4, C.Butter, 0, 6)
	kit.Blob(body, 40, 33, 21, 18, C.Pink, { Z = 7, Shine = true })
	kit.Blob(body, 60, 33, 21, 18, C.Mint, { Z = 7 })
	local mid = kit.Blob(body, 50, 24, 21, 18, C.Butter, { Z = 8, Shine = true })
	kit.Face(mid, 10.5, 10.5, 14, { Eyes = "happy", Mouth = "smile", Z = 3 })
	kit.Blob(body, 50, 14.5, 13, 8, WHITE, { Z = 9 })
	kit.Blob(body, 50, 9, 7, 7, C.Red, { Z = 10, Shine = true })
	local coupe = kit.Group(body, 29, 40, 42, 12, 9, true)
	local cg = kit.Circle(coupe, 21, 0, 42, 24, C.LilacSoft, 0, 1)
	kit.Stroke(cg, kit.OutlineOf(C.Lilac), 1.6)
	kit.Box(coupe, 8, 3, 26, 2, WHITE, 0.3, 2)
	kit.Part(body, 28, 38, 44, 4, kit.Lighten(C.Lilac, 0.5), { Radius = -1, Z = 10 })
	-- Bocal de vermicelles et cornet
	local jar = kit.Part(body, 13, 40, 13, 15, C.Glass, { Radius = 3, Z = 6, T = 0.3 })
	for _, p in ipairs({ { 3, 5, C.Pink }, { 8, 8, C.Sky }, { 4, 11, C.Butter }, { 9, 3, C.Mint } }) do
		kit.Box(jar, p[1], p[2], 3, 1.6, p[3], 0, 2)
	end
	kit.Part(body, 12, 36, 15, 5, C.Pink, { Radius = 2, Z = 7 })
	kit.TriangleDown(body, 83, 40, 12, 14, C.WoodLight, 6, 0, 6)
	kit.Blob(body, 83, 37, 14, 11, C.Lilac, { Z = 7, Shine = true })
	return nil
end

-- Fontaine à chocolat : 3 plateaux, rideaux de chocolat, fraises et guimauves
Art.ChocolateFountain = function(body, kit, _item)
	local C = kit.C
	local choco = Color3.fromRGB(160, 95, 70)
	local metal = Color3.fromRGB(255, 200, 220)
	kit.Part(body, 47, 8, 6, 66, C.Gold, { Radius = 3, Z = 1 })
	-- Socle rempli de chocolat
	local base = kit.Part(body, 16, 72, 68, 24, metal, { Radius = 10, Z = 2, Shine = true })
	kit.Box(base, 4, 16, 60, 2, WHITE, 0.5, 2)
	kit.Blob(body, 50, 72, 70, 12, kit.Lighten(metal, 0.3), { Z = 3 })
	kit.Blob(body, 50, 72, 60, 7, choco, { Z = 4, Outline = false })
	kit.Face(base, 34, 11, 24, { Eyes = "happy", Mouth = "smile", Z = 3 })
	-- Plateaux et rideaux
	local tiers = { { 18, 22 }, { 36, 36 }, { 54, 50 } }
	for i, t in ipairs(tiers) do
		local y, w = t[1], t[2]
		local nextY = if i < #tiers then tiers[i + 1][1] else 72
		local curtain = kit.Part(body, 50 - w / 2 + 1, y, w - 2, nextY - y, choco, { Radius = 2, Z = 3 + i * 2, Outline = false, T = 0.3 })
		kit.Box(curtain, w * 0.22, 3, 1.8, nextY - y - 6, WHITE, 0.7, 2)
		kit.Box(curtain, w * 0.62, 5, 1.8, nextY - y - 9, WHITE, 0.75, 2)
		kit.Animate(curtain, "Pulse", 0.15, 1, i)
		kit.Blob(body, 50, y + 2, w + 4, 8, metal, { Z = 4 + i * 2 })
		kit.Blob(body, 50, y, w, 5, choco, { Z = 4 + i * 2, Outline = C.Gold, Thickness = 1.4 })
	end
	kit.Blob(body, 50, 10, 9, 9, metal, { Z = 12, Shine = true })
	kit.Heart(body, 50, 3, 9, C.Pink, 0, 12)
	-- Brochettes de fraises et guimauves
	kit.Line(body, 8, 96, 14, 64, 1.8, C.WoodLight, 0, 12)
	strawberry(body, kit, 14, 62, 10, 13)
	kit.Blob(body, 14, 66, 10, 5, choco, { Z = 13, Outline = false })
	kit.Line(body, 92, 96, 86, 64, 1.8, C.WoodLight, 0, 12)
	kit.Part(body, 81, 57, 10, 9, C.PinkSoft, { Radius = 3, Z = 13 })
	kit.Part(body, 81, 64, 10, 5, choco, { Radius = 2, Z = 14, Outline = false })
	kit.Sparkle(body, 22, 30, 8, C.Butter, 0, 12)
	return nil
end

-- Machine à glace pilée : manivelle qui tourne, bloc de glace, dôme aux sirops
Art.ShavedIceMachine = function(body, kit, _item)
	local C = kit.C
	local blue = Color3.fromRGB(170, 222, 245)
	kit.Part(body, 6, 88, 88, 10, kit.Darken(blue, 0.08), { Radius = 5, Z = 2, Shine = true })
	kit.Part(body, 10, 18, 18, 72, blue, { Radius = 7, Z = 2 })
	local arm = kit.Part(body, 10, 10, 74, 18, blue, { Radius = 9, Z = 3, Shine = true })
	kit.Heart(arm, 16, 9, 7, C.Pink, 0, 3)
	-- Manivelle
	kit.Part(body, 56, 4, 8, 8, kit.Darken(blue, 0.1), { Radius = 2, Z = 2 })
	local crank = kit.Pivot(body, 60, 5, 4)
	kit.Blob(crank, 0, 0, 12, 12, C.Pink, { Z = 2, Shine = true })
	kit.Line(crank, 0, 0, 14, -5, 3, C.PinkDeep, 0, 1)
	kit.Blob(crank, 14, -5, 7, 7, WHITE, { Z = 3 })
	kit.Animate(crank, "Spin", 1, 0.25, 0)
	-- Bloc de glace sous le bras
	kit.Part(body, 56, 27, 8, 4, C.GreyDark, { Radius = 1, Z = 2 })
	local ice = kit.Part(body, 48, 30, 24, 17, Color3.fromRGB(195, 238, 255), { Radius = 3, Z = 3, Outline = kit.OutlineOf(C.Sky), Shade = 0.2 })
	kit.Box(ice, 0, 0, 24, 5, WHITE, 0.35, 2)
	kit.Line(ice, 4, 8, 4, 13, 2, WHITE, 0.2, 2)
	kit.Sparkle(ice, 18, 10, 7, WHITE, 0, 3)
	kit.Part(body, 46, 46, 28, 4, C.Grey, { Radius = 2, Z = 4 })
	for i = 0, 2 do
		local flake = kit.Circle(body, 54 + i * 6, 53 + (i % 2) * 3, 2.6, 2.6, WHITE, 0, 3)
		kit.Animate(flake, "Bob", 1.5, 1.4, i)
	end
	-- Montagne de glace pilée aux sirops dans sa coupe
	local dome = kit.Blob(body, 60, 70, 40, 30, WHITE, { Z = 4, Outline = kit.OutlineOf(C.Sky) })
	kit.Blob(dome, 11, 14, 18, 18, C.Pink, { Z = 2, T = 0.3, Outline = false })
	kit.Blob(dome, 29, 14, 18, 18, C.Sky, { Z = 2, T = 0.3, Outline = false })
	kit.Blob(dome, 20, 6, 16, 10, C.Butter, { Z = 2, T = 0.2, Outline = false })
	kit.Face(dome, 20, 16, 17, { Eyes = "dot", Mouth = "cat", Z = 3 })
	kit.Blob(body, 60, 56, 7, 7, C.Red, { Z = 6, Shine = true })
	local bowl = kit.Group(body, 36, 76, 48, 12, 5, true)
	local cup = kit.Circle(bowl, 24, 0, 48, 24, C.LilacSoft, 0, 1)
	kit.Stroke(cup, kit.OutlineOf(C.Lilac), 1.6)
	kit.Box(bowl, 6, 3, 36, 2.4, C.Pink, 0.2, 2)
	kit.Part(body, 35, 74, 50, 4, kit.Lighten(C.Lilac, 0.5), { Radius = -1, Z = 6 })
	kit.Part(body, 52, 86, 16, 3, C.Lilac, { Radius = 1, Z = 4 })
	-- Fanion 氷
	local flag = kit.Part(body, 12, 38, 14, 24, WHITE, { Radius = 2, Z = 4 })
	kit.Box(flag, 0, 17, 14, 7, C.Blue, 0.1, 2)
	kit.Text(flag, "氷", 7, 9, 10, C.Red, 3)
	-- Bouteille de sirop
	kit.Part(body, 84, 64, 4, 7, WHITE, { Radius = 1, Z = 3 })
	kit.Part(body, 80, 70, 12, 18, C.Pink, { Radius = 4, Z = 4, Shine = true })
	kit.Heart(body, 86, 81, 6, WHITE, 0, 5)
	kit.Sparkle(body, 90, 38, 8, C.Sky, 0, 7)
	kit.Sparkle(body, 36, 56, 6, WHITE, 0, 7)
	return nil
end

return Art
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="25">
              <Properties>
                <string name="Name">Lights</string>
                <string name="Source"><![CDATA[--[[
	Lights (ModuleScript) — dessins des lumières 💡
	Emplacement : ReplicatedStorage > Client > Components > House > Art > Lights
	Contrat : voir HouseArt (boîte 100 x 100, pieds en bas pour les objets au sol).
	Chaque lumière renvoie Glow (halo dessiné par la pièce, plus fort la nuit).
]]

local Art = {}

local WHITE = Color3.new(1, 1, 1)

----------------------------------------------------------------------
-- Aides partagées
----------------------------------------------------------------------

-- Silhouette : formes collées avec UN seul contour (calque contour dessous,
-- calque couleur dessus). shapes = { { x, y, w, h, rayon? (nil = ovale) } }
local function silhouette(parent, kit, shapes, color, z, thick)
	local holder = kit.Group(parent, 0, 0, 100, 100, z)
	local ink = kit.OutlineOf(color)
	local t = thick or 1.6
	for _, s in ipairs(shapes) do
		local edge = kit.Box(holder, s[1] - t, s[2] - t, s[3] + t * 2, s[4] + t * 2, ink, 0, 1)
		kit.Round(edge, if s[5] then s[5] + t else -1)
	end
	for _, s in ipairs(shapes) do
		local fill = kit.Box(holder, s[1], s[2], s[3], s[4], color, 0, 2)
		kit.Round(fill, s[5] or -1)
	end
	return holder
end

-- Fait "pulser" tous les morceaux d'un conteneur (cœur, étincelle, triangle...)
local function pulseAll(kit, holder, amp, speed, phase)
	for _, child in ipairs(holder:GetChildren()) do
		if child:IsA("GuiObject") then
			kit.Animate(child, "Pulse", amp, speed, phase)
		end
	end
end

-- Suspension : fil qui monte jusqu'à y = -60, pivot en haut du fil (tout
-- l'objet se balance). Renvoie un calque en coordonnées de la boîte.
local function hang(body, kit, bottom, cordColor, amp, phase)
	local pivot = kit.Pivot(body, 50, -60, 2)
	local layer = kit.Group(pivot, -50, 60, 100, 100, 1)
	kit.Line(layer, 50, -60, 50, bottom, 1.8, cordColor, 0, 1)
	kit.Animate(pivot, "Sway", amp, 0.7, phase)
	return layer
end

-- Petite flamme en goutte (pointe en haut), base en (cx, baseY)
local function flame(parent, kit, cx, baseY, size, z, phase)
	local C = kit.C
	local holder = kit.Group(parent, 0, 0, 100, 100, z)
	local w, h = size * 0.62, size
	local outer = kit.Circle(holder, cx, baseY - w / 2, w, w, C.Orange, 0, 2)
	local tip = kit.Diamond(holder, cx, baseY - w * 0.95, w * 0.62, C.Orange, 0, 2)
	local inner = kit.Circle(holder, cx, baseY - w * 0.42, w * 0.55, w * 0.62, C.Butter, 0, 3)
	local core = kit.Diamond(holder, cx, baseY - w * 0.78, w * 0.34, C.Butter, 0, 3)
	kit.Animate(outer, "Flicker", 0.22, 1, phase)
	kit.Animate(tip, "Flicker", 0.3, 1, phase + 0.4)
	kit.Animate(inner, "Flicker", 0.15, 1.2, phase + 0.8)
	kit.Animate(core, "Flicker", 0.2, 1.1, phase + 1.3)
	return holder, h
end

-- Étoile dodue à 5 branches : carrés arrondis (une pointe vers l'extérieur)
-- autour d'un disque ; un seul contour (calque contour + calque couleur)
local function star(parent, kit, cx, cy, radius, color, z, ink)
	local holder = kit.Group(parent, 0, 0, 100, 100, z)
	ink = ink or kit.OutlineOf(color)
	local t = 1.8
	local side = radius * 0.64
	local dist = radius - side / math.sqrt(2) - side * 0.04
	for layer = 1, 2 do
		local grow = if layer == 1 then t * 2 else 0
		local fill = if layer == 1 then ink else color
		for index = 0, 4 do
			local a = math.rad(index * 72)
			local arm = kit.Box(holder, 0, 0, side + grow, side + grow, fill, 0, layer)
			arm.AnchorPoint = Vector2.new(0.5, 0.5)
			arm.Position = UDim2.fromOffset(cx + math.sin(a) * dist, cy - math.cos(a) * dist)
			arm.Rotation = 45 + index * 72
			kit.Round(arm, radius * 0.06 + grow / 2)
		end
		kit.Circle(holder, cx, cy, radius * 1.04 + grow, radius * 1.04 + grow, fill, 0, layer)
	end
	return holder
end

----------------------------------------------------------------------
-- Dessins
----------------------------------------------------------------------

-- Bougie parfumée : bougie rose qui coule, petite flamme, soucoupe
Art.ScentedCandle = function(body, kit, _item)
	local C = kit.C
	local wax = Color3.fromRGB(255, 186, 212)
	kit.Part(body, 14, 88, 72, 12, C.Lilac, { Radius = -1, Z = 2, Shine = true }) -- soucoupe
	kit.Part(body, 28, 44, 44, 50, wax, { Radius = 9, Z = 3, Shine = true })
	-- cire fondue sur le dessus (avec 2 coulures)
	silhouette(body, kit, {
		{ 26, 38, 48, 14, 7 },
		{ 31, 44, 8, 18 },
		{ 56, 44, 7, 13 },
	}, Color3.fromRGB(255, 226, 238), 4)
	kit.Face(body, 50, 74, 28, { Eyes = "happy", Mouth = "smile", Z = 5 })
	kit.Line(body, 50, 39, 50, 31, 2.6, C.Ink, 0, 5) -- mèche
	local glow = kit.Circle(body, 50, 18, 34, 34, C.Butter, 0.72, 1)
	kit.Animate(glow, "Pulse", 0.18, 0.9, 0.3)
	flame(body, kit, 50, 33, 26, 6, 0.2)
	return { Glow = Color3.fromRGB(255, 200, 120) }
end

-- Ampoule suspendue : douille lilas, ampoule jaune avec filament cœur et visage
Art.HangingBulb = function(body, kit, _item)
	local C = kit.C
	local layer = hang(body, kit, 22, C.Ink, 4, 0.5)
	local glow = kit.Circle(layer, 50, 58, 66, 66, C.Butter, 0.8, 1)
	kit.Animate(glow, "Pulse", 0.15, 0.8, 0)
	kit.Part(layer, 40, 16, 20, 18, C.Lilac, { Radius = 4, Z = 5, Shine = true }) -- douille
	kit.Line(layer, 41, 23, 59, 23, 1.6, kit.OutlineOf(C.Lilac), 0.3, 6)
	kit.Line(layer, 41, 28, 59, 28, 1.6, kit.OutlineOf(C.Lilac), 0.3, 6)
	kit.Part(layer, 41, 30, 18, 12, C.Butter, { Radius = 4, Z = 2 }) -- col
	local bulb = kit.Blob(layer, 50, 58, 46, 46, C.Butter, { Z = 3 })
	kit.Gradient(bulb, Color3.fromRGB(255, 252, 225), Color3.fromRGB(255, 220, 140), 90)
	kit.Shine(layer, 32, 42, 7, 12, 5, 0.25)
	kit.Line(layer, 46, 33, 47.5, 44, 1.4, C.Orange, 0, 4)
	kit.Line(layer, 54, 33, 52.5, 44, 1.4, C.Orange, 0, 4)
	kit.Heart(layer, 50, 46, 9, C.Orange, 0, 4)
	kit.Face(layer, 50, 64, 26, { Eyes = "happy", Mouth = "smile", Z = 5 })
	return { Glow = Color3.fromRGB(255, 236, 150), WallShadow = Vector2.new(0.4, 0.45) }
end

-- Guirlande : 2 festons de fil vert, ampoules pastel qui scintillent
Art.FairyLights = function(body, kit, _item)
	local C = kit.C
	local colors = {
		Color3.fromRGB(255, 130, 185),
		Color3.fromRGB(255, 214, 100),
		Color3.fromRGB(120, 225, 185),
		Color3.fromRGB(180, 150, 255),
		Color3.fromRGB(255, 165, 120),
		Color3.fromRGB(130, 195, 255),
	}
	local function wireAt(u)
		return -4 + u * 108, 20 + 26 * math.abs(math.sin(u * math.pi * 2))
	end
	local segments = 12
	local px, py = wireAt(0)
	for index = 1, segments do
		local x, y = wireAt(index / segments)
		kit.Line(body, px, py, x, y, 2, C.LeafDark, 0, 2)
		px, py = x, y
	end
	for _, u in ipairs({ 0, 0.5, 1 }) do
		local x, y = wireAt(u)
		kit.Circle(body, x, y, 6, 6, C.PinkDeep, 0, 3) -- punaise
	end
	local index = 0
	for _, swoop in ipairs({ 0, 0.5 }) do
		for _, v in ipairs({ 0.16, 0.39, 0.61, 0.84 }) do
			local x, y = wireAt(swoop + v * 0.5)
			local color = colors[index % #colors + 1]
			local halo = kit.Circle(body, x, y + 9, 18, 18, color, 0.75, 1)
			kit.Part(body, x - 3, y - 1.5, 6, 5, C.LeafDark, { Radius = 1.5, Z = 4, Outline = false, Shade = false })
			local bulb = kit.Part(body, x - 5, y + 3, 10, 13, color, { Radius = -1, Z = 3, Thickness = 1.2 })
			kit.Shine(bulb, 2, 2.5, 2.5, 4, 3, 0.3)
			kit.Animate(bulb, "Pulse", 0.4, 1.1, index * 1.7)
			kit.Animate(halo, "Pulse", 0.25, 1.1, index * 1.7)
			index += 1
		end
	end
	return { Glow = Color3.fromRGB(255, 220, 170), WallShadow = Vector2.new(0, 0) }
end

-- Lanterne en papier : boule corail à côtes, chapeaux dorés, pompon, visage
Art.PaperLantern = function(body, kit, _item)
	local C = kit.C
	local red = Color3.fromRGB(255, 125, 135)
	local layer = hang(body, kit, 24, Color3.fromRGB(200, 70, 90), 3, 1.1)
	kit.Part(layer, 38, 22, 24, 8, C.Gold, { Radius = 3, Z = 5, Shine = true })
	kit.Part(layer, 38, 74, 24, 8, C.Gold, { Radius = 3, Z = 5 })
	local lantern = kit.Blob(layer, 50, 52, 64, 50, red, { Z = 3, Shine = true })
	kit.Gradient(lantern, Color3.fromRGB(255, 205, 190), Color3.fromRGB(235, 185, 185), 90)
	local inside = kit.Circle(layer, 50, 54, 34, 28, C.Butter, 0.55, 4)
	kit.Animate(inside, "Pulse", 0.25, 0.8, 0.6)
	for _, w in ipairs({ 44, 20 }) do
		kit.Blob(layer, 50, 52, w, 50, red, { T = 1, Z = 4, Outline = kit.Darken(red, 0.18), Thickness = 1.2, Shade = false })
	end
	kit.Face(layer, 50, 56, 24, { Eyes = "happy", Mouth = "cat", Z = 6 })
	kit.Line(layer, 50, 82, 50, 88, 2, C.Gold, 0, 2)
	kit.Part(layer, 46, 87, 8, 14, C.PinkDeep, { Radius = 3, Z = 3 }) -- pompon
	kit.Circle(layer, 50, 87, 6, 6, C.Gold, 0, 4)
	return { Glow = Color3.fromRGB(255, 140, 120), WallShadow = Vector2.new(0.55, 0.55) }
end

-- Grand lampadaire : pied menthe, abat-jour rose à franges, tirette
Art.FloorLamp = function(body, kit, _item)
	local C = kit.C
	local shade = Color3.fromRGB(255, 180, 210)
	kit.Part(body, 28, 90, 44, 10, C.Mint, { Radius = -1, Z = 2, Shine = true })
	kit.Part(body, 47, 34, 6, 58, C.MintSoft, { Radius = 3, Z = 1 })
	kit.Blob(body, 50, 62, 12, 7, C.Mint, { Z = 2 })
	kit.Blob(body, 50, 38, 16, 9, C.Butter, { Z = 2, Outline = false })
	-- dôme (moitié haute d'un ovale) + bordure + franges
	local dome = kit.Group(body, 18, 4, 64, 32, 3, true)
	kit.Blob(dome, 32, 32, 56, 56, shade, { Shine = true })
	kit.Part(body, 18, 30, 64, 9, kit.Lighten(shade, 0.25), { Radius = -1, Z = 4 })
	for index = 0, 5 do
		kit.Circle(body, 25 + index * 10, 41, 7, 7, C.PinkDeep, 0, 3)
	end
	kit.Heart(body, 50, 20, 11, C.PinkDeep, 0, 5)
	kit.Line(body, 68, 39, 68, 52, 1.2, C.GreyDark, 0, 2)
	kit.Circle(body, 68, 53, 4.5, 4.5, C.Gold, 0, 3)
	return { Glow = Color3.fromRGB(255, 225, 160) }
end

-- Petite lampe à huile (diya) : coupelle pêche à pois, bec, flamme
Art.OilLamp = function(body, kit, _item)
	local C = kit.C
	local clay = Color3.fromRGB(255, 176, 140)
	kit.Part(body, 38, 88, 24, 12, kit.Darken(clay, 0.08), { Radius = 4, Z = 2 })
	local bowl = kit.Group(body, 12, 60, 76, 32, 3, true)
	kit.Blob(bowl, 38, 0, 72, 60, clay, { Shine = false })
	kit.Blob(body, 49, 61, 76, 13, kit.Lighten(clay, 0.2), { Z = 4 }) -- rebord
	kit.Blob(body, 49, 61, 60, 7, Color3.fromRGB(240, 190, 90), { Z = 5, Outline = false, Shade = false }) -- huile
	kit.Part(body, 72, 53, 20, 11, kit.Lighten(clay, 0.2), { Radius = -1, Z = 5, Rotation = -12 }) -- bec
	for _, x in ipairs({ 24, 76 }) do
		kit.Circle(body, x, 74, 5, 5, C.PinkSoft, 0, 5)
	end
	kit.Face(body, 50, 76, 24, { Eyes = "happy", Mouth = "smile", Z = 6 })
	kit.Line(body, 86, 55, 88, 49, 2.4, C.Ink, 0, 6)
	local glow = kit.Circle(body, 88, 36, 30, 30, C.Butter, 0.72, 1)
	kit.Animate(glow, "Pulse", 0.2, 0.9, 1)
	flame(body, kit, 88, 51, 24, 7, 0.7)
	return { Glow = Color3.fromRGB(255, 196, 110) }
end

-- Veilleuse étoile : grosse étoile dodue avec visage endormi, socle nuage
Art.StarNightLight = function(body, kit, _item)
	local C = kit.C
	local halo = kit.Circle(body, 50, 46, 84, 84, C.Butter, 0.78, 1)
	kit.Animate(halo, "Pulse", 0.15, 0.6, 0)
	star(body, kit, 50, 50, 47, C.Butter, 2, kit.Darken(C.Gold, 0.15))
	kit.Shine(body, 36, 36, 8, 5, 5, 0.3)
	kit.Face(body, 50, 52, 30, { Eyes = "closed", Mouth = "smile", Z = 6 })
	kit.Part(body, 28, 86, 44, 14, C.Lilac, { Radius = 6, Z = 7, Shine = true }) -- socle
	kit.Circle(body, 50, 93, 5, 5, C.Butter, 0, 8)
	return { Glow = Color3.fromRGB(255, 232, 140) }
end

-- Lampe feu d'artifice : rayons pastel autour d'un cœur doré, pointes qui scintillent
Art.SparklerLights = function(body, kit, _item)
	local C = kit.C
	local colors = { C.Gold, C.Pink, C.Lilac, C.Mint, C.Sky, C.Orange }
	local wheel = kit.Pivot(body, 50, 50, 2)
	for index = 0, 11 do
		local a = math.rad(index * 30)
		local long = index % 2 == 0
		local r2 = if long then 42 else 31
		local sx, sy = math.sin(a), -math.cos(a)
		local color = colors[index % #colors + 1]
		kit.Line(wheel, sx * 13, sy * 13, sx * r2, sy * r2, if long then 3.4 else 2.6, color, 0, 1)
		local tip = kit.Circle(wheel, sx * (r2 + 4), sy * (r2 + 4), if long then 7 else 5, if long then 7 else 5, kit.Lighten(color, 0.3), 0, 2)
		kit.Animate(tip, "Pulse", 0.7, 1.4, index * 0.8)
	end
	kit.Animate(wheel, "Spin", 1, 0.03, 0)
	kit.Blob(body, 50, 50, 24, 24, C.Butter, { Z = 4, Shine = true })
	kit.Sparkle(body, 50, 50, 16, C.Orange, 0, 5)
	for _, p in ipairs({ { 22, 20 }, { 80, 78 } }) do
		local sp = kit.Sparkle(body, p[1], p[2], 10, WHITE, 0, 5)
		pulseAll(kit, sp, 0.8, 1.2, p[1] * 0.1)
	end
	return { Glow = Color3.fromRGB(255, 220, 160), WallShadow = Vector2.new(0.5, 0.5) }
end

-- Lampe nuage : nuage moelleux endormi avec breloques (cœur, goutte, étoile)
Art.CloudLamp = function(body, kit, _item)
	local C = kit.C
	local charms = {
		{ 32, 84, C.Pink, "heart" },
		{ 50, 90, C.Sky, "drop" },
		{ 68, 82, C.Butter, "star" },
	}
	for index, c in ipairs(charms) do
		local pivot = kit.Pivot(body, c[1], 60, 1)
		local len = c[2] - 60
		kit.Line(pivot, 0, 0, 0, len - 3, 1.2, C.GreyDark, 0.2, 1)
		if c[4] == "heart" then
			kit.Heart(pivot, 0, len + 1, 11, c[3], 0, 2)
		elseif c[4] == "drop" then
			kit.Circle(pivot, 0, len + 2, 9, 9, c[3], 0, 2)
			kit.Diamond(pivot, 0, len - 1.5, 6.4, c[3], 0, 2)
		else
			kit.Sparkle(pivot, 0, len + 1, 13, C.Gold, 0, 2)
		end
		kit.Animate(pivot, "Sway", 6, 0.9, index * 1.3)
	end
	local cloud = kit.Group(body, 0, 0, 100, 100, 3)
	silhouette(cloud, kit, {
		{ 10, 44, 80, 30 },
		{ 18, 34, 34, 34 },
		{ 38, 20, 40, 40 },
		{ 62, 34, 28, 28 },
	}, Color3.fromRGB(255, 252, 240), 1, 2)
	local warm = kit.Circle(cloud, 52, 50, 56, 30, C.Butter, 0.72, 2)
	kit.Animate(warm, "Pulse", 0.3, 0.7, 0)
	kit.Shine(cloud, 44, 26, 12, 5, 3, 0.2)
	kit.Face(cloud, 50, 54, 30, { Eyes = "closed", Mouth = "smile", Z = 4 })
	kit.Animate(cloud, "Bob", 1.5, 0.6, 0.2)
	return { Glow = Color3.fromRGB(255, 244, 200), WallShadow = Vector2.new(0.8, 0.45) }
end

-- Enseigne néon : plaque violette, gros cœur néon rose et petit cœur lilas
Art.NeonHeart = function(body, kit, _item)
	local C = kit.C
	local plate = Color3.fromRGB(78, 56, 118)
	kit.Part(body, 8, 12, 84, 72, plate, { Radius = 14, Z = 2, Shade = 0.2 })
	for _, p in ipairs({ { 14, 18 }, { 86, 18 }, { 14, 78 }, { 86, 78 } }) do
		kit.Circle(body, p[1], p[2], 4, 4, C.Grey, 0, 3)
	end
	local function neon(cx, cy, size, tube, core, z, phase)
		local glow = kit.Heart(body, cx, cy, size + 6, tube, 0.55, z)
		pulseAll(kit, glow, 0.3, 1, phase)
		kit.Heart(body, cx, cy, size, tube, 0, z)
		kit.Heart(body, cx, cy, size - 5, core, 0, z)
		kit.Heart(body, cx, cy, size - 10, tube, 0, z)
		kit.Heart(body, cx, cy, size - 16, plate, 0, z)
	end
	neon(44, 46, 54, C.Heart, C.PinkSoft, 4, 0)
	neon(68, 62, 30, C.Lilac, C.LilacSoft, 5, 1.5)
	kit.Line(body, 70, 84, 76, 100, 1.6, C.GreyDark, 0, 1) -- fil électrique
	return { Glow = Color3.fromRGB(255, 90, 170), WallShadow = Vector2.new(0.84, 0.72) }
end

-- Lampe lune : sphère crème à cratères sur socle en bois, lune qui dort
Art.MoonLamp = function(body, kit, _item)
	local C = kit.C
	local moonColor = Color3.fromRGB(255, 244, 205)
	kit.Part(body, 30, 84, 40, 16, C.WoodLight, { Radius = 6, Z = 2, Shine = true })
	kit.Blob(body, 50, 84, 36, 8, C.Wood, { Z = 3 })
	local moon = kit.Blob(body, 50, 50, 66, 66, moonColor, { Z = 4, Shade = 0.1 })
	moon.AnchorPoint = Vector2.new(0.5, 0.5)
	moon.Position = UDim2.fromOffset(50, 50)
	local crater = kit.Darken(moonColor, 0.1)
	for _, c in ipairs({ { 18, 18, 12 }, { 50, 16, 8 }, { 14, 44, 7 }, { 52, 50, 11 }, { 30, 56, 6 } }) do
		kit.Circle(moon, c[1], c[2], c[3], c[3], crater, 0.25, 2)
	end
	kit.Shine(moon, 10, 8, 12, 6, 3, 0.3)
	kit.Face(moon, 34, 36, 32, { Eyes = "closed", Mouth = "smile", Z = 4 })
	kit.Animate(moon, "Breathe", 0.015, 0.6, 0)
	kit.Sparkle(body, 86, 22, 12, C.Butter, 0, 5)
	kit.Sparkle(body, 14, 30, 8, C.Butter, 0, 5)
	return { Glow = Color3.fromRGB(255, 244, 200) }
end

-- Boule à facettes : suspendue, facettes pastel, reflets qui tournent autour
Art.DiscoBall = function(body, kit, _item)
	local C = kit.C
	local layer = hang(body, kit, 18, C.GreyDark, 2, 0.3)
	kit.Part(layer, 44, 14, 12, 9, C.Grey, { Radius = 3, Z = 4 })
	local ball = kit.Blob(layer, 50, 50, 58, 58, Color3.fromRGB(226, 222, 240), { Z = 3, Shade = 0.2 })
	local tile = kit.Darken(C.Grey, 0.25)
	for _, dy in ipairs({ -19, -9.5, 0, 9.5, 19 }) do
		local half = math.sqrt(29 * 29 - dy * dy) - 1.5
		kit.Line(ball, 29 - half, 29 + dy, 29 + half, 29 + dy, 1.1, tile, 0.35, 2)
	end
	for _, w in ipairs({ 20, 42 }) do
		kit.Blob(ball, 29, 29, w, 58, WHITE, { T = 1, Z = 2, Outline = tile, Thickness = 1.1, Shade = false })
	end
	local pastel = { C.Pink, C.Sky, C.Butter, C.Mint, C.Lilac, WHITE }
	for index, p in ipairs({ { 16, 14 }, { 34, 24 }, { 22, 36 }, { 42, 38 }, { 30, 48 }, { 12, 26 } }) do
		local sq = kit.Box(ball, p[1], p[2], 7, 7, pastel[index], 0.05, 3)
		kit.Round(sq, 1.5)
		kit.Animate(sq, "Pulse", 0.8, 1.3, index * 1.1)
	end
	kit.Shine(ball, 12, 9, 12, 7, 4, 0.2)
	local spin = kit.Pivot(layer, 50, 50, 5)
	for index = 0, 3 do
		local a = math.rad(index * 90 + 25)
		local r = if index % 2 == 0 then 40 else 37
		local sp = kit.Sparkle(spin, math.sin(a) * r, -math.cos(a) * r, if index % 2 == 0 then 11 else 8, pastel[index + 1], 0, 1)
		pulseAll(kit, sp, 0.5, 1.5, index)
	end
	kit.Animate(spin, "Spin", 1, 0.08, 0)
	return { Glow = Color3.fromRGB(230, 200, 255), WallShadow = Vector2.new(0.55, 0.55) }
end

-- Projecteur arc-en-ciel : petit projecteur mignon qui dessine un arc-en-ciel
Art.RainbowProjector = function(body, kit, _item)
	local C = kit.C
	local arc = kit.Group(body, 2, 4, 96, 54, 2, true)
	local bands = {
		Color3.fromRGB(255, 140, 155),
		Color3.fromRGB(255, 190, 130),
		Color3.fromRGB(255, 230, 140),
		Color3.fromRGB(150, 225, 180),
		Color3.fromRGB(150, 200, 255),
		Color3.fromRGB(190, 160, 250),
	}
	for index, color in ipairs(bands) do
		local r = 40 - (index - 1) * 5
		local ring = kit.Circle(arc, 48, 54, r * 2, r * 2, color, 1, 1)
		kit.Stroke(ring, color, 5, 0.05)
	end
	local beam = kit.TriangleDown(body, 50, 42, 30, 28, C.Butter, 1, 0.72, 7)
	pulseAll(kit, beam, 0.18, 0.8, 0)
	for index, x in ipairs({ 12, 88 }) do
		local puff = kit.Group(body, x - 50, 0, 100, 100, 4)
		silhouette(puff, kit, {
			{ 36, 52, 28, 12 },
			{ 40, 45, 14, 14 },
			{ 48, 42, 14, 16 },
		}, WHITE, 1, 1.4)
		kit.Animate(puff, "Bob", 1.2, 0.8, index * 1.7)
	end
	-- projecteur
	kit.Part(body, 30, 66, 40, 28, C.PinkSoft, { Radius = 12, Z = 5, Shine = true })
	kit.Part(body, 34, 92, 8, 6, C.Pink, { Radius = 2, Z = 4 })
	kit.Part(body, 58, 92, 8, 6, C.Pink, { Radius = 2, Z = 4 })
	kit.Blob(body, 50, 66, 18, 10, C.Lilac, { Z = 6 })
	kit.Blob(body, 50, 65, 10, 5, WHITE, { Z = 7, Outline = false, Shade = false })
	kit.Face(body, 50, 82, 24, { Eyes = "dot", Mouth = "smile", Z = 6 })
	return { Glow = Color3.fromRGB(200, 160, 255), WallShadow = Vector2.new(0.4, 0.3) }
end

-- Lampe à lave : socle lilas, fiole rose où flottent des bulles de lave
Art.LavaLamp = function(body, kit, _item)
	local C = kit.C
	kit.Part(body, 29, 76, 42, 24, C.Purple, { Radius = 10, Z = 2, Shine = true }) -- socle
	kit.Part(body, 33, 72, 34, 6, C.Gold, { Radius = -1, Z = 4 })
	kit.Part(body, 38, 6, 24, 12, C.Purple, { Radius = 6, Z = 4 }) -- chapeau
	kit.Part(body, 36, 15, 28, 4, C.Gold, { Radius = -1, Z = 5 })
	local glass = kit.Part(body, 32, 16, 36, 58, Color3.fromRGB(255, 190, 220), { Radius = 15, Z = 3, Shade = false, Outline = C.Purple })
	kit.Gradient(glass, Color3.fromRGB(250, 235, 255), WHITE, 90)
	local lava = kit.Group(body, 34, 18, 32, 54, 4, true)
	local blobColor = Color3.fromRGB(255, 120, 150)
	for index, b in ipairs({ { 16, 12, 11, 12 }, { 11, 27, 14, 15 }, { 21, 38, 10, 9 }, { 16, 54, 30, 14 } }) do
		local blob = kit.Circle(lava, b[1], b[2], b[3], b[4], blobColor, 0, 1)
		kit.Gradient(blob, Color3.fromRGB(255, 225, 170), WHITE, 90)
		if index < 4 then
			kit.Animate(blob, "Bob", 3 + index, 0.35, index * 1.9)
		end
	end
	kit.Shine(body, 37, 26, 4, 22, 6, 0.4)
	kit.Face(body, 50, 88, 22, { Eyes = "dot", Mouth = "smile", Color = C.White, Z = 5 })
	return { Glow = Color3.fromRGB(255, 120, 90) }
end

-- Lampe OVNI : soucoupe suspendue, petit alien dans la bulle, rayon vert
Art.UFOLamp = function(body, kit, _item)
	local C = kit.C
	local layer = hang(body, kit, 26, C.GreyDark, 3, 2)
	local beam = kit.Box(layer, 34, 62, 32, 34, C.Mint, 0.35, 1)
	kit.Round(beam, 10)
	kit.Fade(beam, 0, 1, 90)
	kit.Animate(beam, "Pulse", 0.3, 0.9, 0)
	for index, p in ipairs({ { 44, 76 }, { 56, 84 } }) do
		local sp = kit.Sparkle(layer, p[1], p[2], 7, WHITE, 0, 2)
		pulseAll(kit, sp, 0.8, 1.2, index * 1.5)
	end
	-- alien
	kit.Line(layer, 50, 30, 50, 24, 1.4, C.LeafDark, 0, 2)
	kit.Circle(layer, 50, 24, 5, 5, C.Pink, 0, 2)
	kit.Blob(layer, 50, 40, 20, 18, C.Mint, { Z = 3 })
	kit.Face(layer, 50, 41, 16, { Eyes = "big", Mouth = "smile", Z = 4 })
	local dome = kit.Blob(layer, 50, 42, 36, 36, C.Glass, { Z = 5, T = 0.55, Shade = false })
	kit.Stroke(dome, C.Sky, 1.6, 0)
	kit.Shine(layer, 38, 30, 6, 9, 6, 0.3)
	kit.Blob(layer, 50, 56, 84, 22, C.Lilac, { Z = 7, Shine = true })
	kit.Blob(layer, 50, 62, 34, 10, C.Purple, { Z = 6 })
	local lights = { C.Butter, C.Pink, C.Mint, C.Pink, C.Butter }
	for index, x in ipairs({ 22, 36, 50, 64, 78 }) do
		local y = 57 + math.abs(x - 50) * -0.06
		local dot = kit.Circle(layer, x, y, 6, 6, lights[index], 0, 8)
		kit.Animate(dot, "Pulse", 0.7, 1.6, index * 0.9)
	end
	return { Glow = Color3.fromRGB(150, 255, 200), WallShadow = Vector2.new(0.7, 0.35) }
end

-- Lustre en cristal : bras dorés en U, 4 bougies, gouttes de cristal scintillantes
Art.CrystalChandelier = function(body, kit, _item)
	local C = kit.C
	local gold = C.Gold
	local layer = hang(body, kit, 12, gold, 2, 0.8)
	kit.Line(layer, 50, 14, 50, 50, 4, gold, 0, 2)
	kit.Part(layer, 43, 12, 14, 7, gold, { Radius = 3, Z = 3 })
	kit.Circle(layer, 50, 32, 7, 7, gold, 0, 3)
	kit.Circle(layer, 50, 42, 5, 5, C.PinkSoft, 0, 3)
	-- bras en U (traits : pas de découpe dans un objet qui se balance)
	local function arm(x0, x1, top, depth, thick, count)
		local half = (x1 - x0) / 2
		local function yAt(x)
			local u = (x - x0 - half) / half
			return top + depth * (1 - u * u)
		end
		local px = x0
		for index = 1, count do
			local x = x0 + (x1 - x0) * index / count
			kit.Line(layer, px, yAt(px), x, yAt(x), thick, gold, 0, 3)
			px = x
		end
		return yAt
	end
	local armY = arm(14, 86, 46, 20, 3.6, 6)
	arm(30, 70, 54, 10, 3, 4)
	kit.Blob(layer, 50, 54, 22, 14, gold, { Z = 4, Shine = true })
	-- gouttes de cristal (pendues au grand bras)
	local crystals = { C.LilacSoft, C.Glass, C.PinkSoft, C.Glass, C.LilacSoft }
	for index, d in ipairs({ { 22, 8 }, { 36, 10 }, { 50, 14 }, { 64, 10 }, { 78, 8 } }) do
		local top = armY(d[1])
		kit.Line(layer, d[1], top, d[1], top + d[2] - 3, 1, gold, 0.3, 2)
		local gem = kit.Diamond(layer, d[1], top + d[2] + 1, 8, crystals[index], 0, 3)
		kit.Stroke(gem, C.Sky, 1, 0.1)
		kit.Animate(gem, "Pulse", 0.5, 1.4, index * 1.2)
	end
	-- bougies
	for index, x in ipairs({ 14, 30, 70, 86 }) do
		local y = if index == 1 or index == 4 then 46 else 54
		kit.Part(layer, x - 3, y - 12, 6, 12, C.Cream, { Radius = 2, Z = 4 })
		kit.Blob(layer, x, y, 13, 6, gold, { Z = 5 })
		flame(layer, kit, x, y - 12, 12, 5, index * 0.9)
	end
	for index, p in ipairs({ { 30, 24 }, { 8, 72 }, { 92, 70 } }) do
		local sp = kit.Sparkle(layer, p[1], p[2], if index == 1 then 11 else 9, WHITE, 0, 6)
		pulseAll(kit, sp, 0.8, 1.1, index * 1.4)
	end
	return { Glow = Color3.fromRGB(190, 230, 255), WallShadow = Vector2.new(0.7, 0.5) }
end

-- Soleil de poche : soleil joufflu aux grands yeux, rayons qui tournent doucement
Art.PocketSun = function(body, kit, _item)
	local C = kit.C
	local halo = kit.Circle(body, 50, 50, 100, 100, C.Butter, 0.75, 1)
	kit.Animate(halo, "Pulse", 0.15, 0.7, 0)
	local rays = kit.Pivot(body, 50, 50, 2)
	for index = 0, 11 do
		local a = index * 30
		local long = index % 2 == 0
		local len = if long then 18 else 12
		local w = if long then 9 else 7
		local dist = if long then 40 else 38
		local cx = math.sin(math.rad(a)) * dist
		local cy = -math.cos(math.rad(a)) * dist
		kit.Part(rays, cx - w / 2, cy - len / 2, w, len, if long then C.Orange else C.Yellow, { Radius = -1, Rotation = a, Z = 1 })
	end
	kit.Animate(rays, "Spin", 1, 0.03, 0)
	local sun = kit.Blob(body, 50, 50, 66, 66, C.Yellow, { Z = 3, Shade = false })
	sun.AnchorPoint = Vector2.new(0.5, 0.5)
	sun.Position = UDim2.fromOffset(50, 50)
	kit.Gradient(sun, Color3.fromRGB(255, 245, 190), Color3.fromRGB(255, 205, 120), 90)
	kit.Shine(sun, 12, 9, 16, 8, 3, 0.25)
	kit.Face(sun, 33, 36, 40, { Eyes = "big", Mouth = "smile", Z = 3 })
	kit.Animate(sun, "Breathe", 0.02, 0.8, 0)
	for index, p in ipairs({ { 12, 14, 12 }, { 90, 24, 9 }, { 86, 88, 12 } }) do
		local sp = kit.Sparkle(body, p[1], p[2], p[3], WHITE, 0, 5)
		pulseAll(kit, sp, 0.8, 1.1, index * 1.3)
	end
	local puff = kit.Cloud(body, 20, 96, 30, WHITE, 0, 6)
	kit.Animate(puff, "Drift", 2, 0.5, 0)
	return { Glow = Color3.fromRGB(255, 214, 90), WallShadow = Vector2.new(0.7, 0.7) }
end

return Art
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="26">
              <Properties>
                <string name="Name">Luxe98</string>
                <string name="Source"><![CDATA[--[[
	Luxe98 (ModuleScript) — (v9.8 CATALOG98) 💎 objets de luxe et objets
	"incroyables" (tunnel aquarium, cascade intérieure, dragon d'or, mini
	montagnes russes...), grand lustre, dôme planétarium, et les télés XXL /
	l'écran de home cinéma du "Dopamine Setup"
	Emplacement : ReplicatedStorage > Client > Components > House > Art > Luxe98
	Contrat : voir HouseArt (boîte 100 x 100, pieds en bas pour les objets au
	sol, objets muraux centrés).

	Style : rendu "autocollant" du jeu, mais matières de luxe réalistes
	(marbre veiné, or, velours, laque blanche, verre, eau). Les dessus
	(lits, méridienne, billard, fauteuils, trône) sont déclarés dans
	House/HouseSurfaces (mêmes hauteurs que les modèles 3D de House3DLuxe).
]]

local Art = {}

local rgb = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)
local GOLD = rgb(236, 190, 70)
local GOLD_DARK = rgb(180, 136, 40)
local GOLD_LIGHT = rgb(255, 226, 130)
local MARBLE = rgb(242, 240, 238)
local MARBLE_VEIN = rgb(186, 184, 196)
local VELVET = rgb(120, 60, 150)
local VELVET_DARK = rgb(84, 40, 110)
local WALNUT = rgb(120, 78, 52)
local WALNUT_DARK = rgb(84, 54, 38)
local IRON = rgb(60, 62, 72)
local IRON_DARK = rgb(34, 36, 44)
local STEEL = rgb(190, 196, 208)
local WATER = rgb(80, 180, 230)
local WATER_DEEP = rgb(30, 110, 190)
local WATER_LIGHT = rgb(170, 230, 250)
local STONE = rgb(150, 146, 140)
local STONE_DARK = rgb(104, 100, 98)
local LEAF = rgb(84, 150, 84)
local LEAF_DARK = rgb(52, 110, 62)
local CYAN = rgb(60, 222, 255)
local MAGENTA = rgb(255, 84, 196)
local RED = rgb(220, 60, 60)
local AMBER = rgb(255, 196, 110)
local FIRE = rgb(255, 140, 50)
local SCREEN = rgb(24, 26, 44)

----------------------------------------------------------------------
-- Petits outils
----------------------------------------------------------------------

-- Petit poisson (vers la droite si dir = 1)
local function fish(kit, parent, cx, cy, size, color, dir, z)
	local g = kit.Pivot(parent, cx, cy, z or 4)
	kit.Blob(g, 0, 0, size, size * 0.6, color, { Z = 2, Thickness = 1, Shine = true })
	kit.Triangle(g, -dir * size * 0.55, -size * 0.3, size * 0.4, size * 0.6, kit.Darken(color, 0.1), 1)
	kit.Circle(g, dir * size * 0.25, -size * 0.06, size * 0.14, size * 0.14, rgb(30, 30, 40), 0, 3)
	kit.Animate(g, "Drift", 3 * dir, 0.6, cx * 0.1)
	return g
end

-- Bulles qui montent (animées)
local function bubbles(kit, parent, x, y, n, z)
	for k = 0, n - 1 do
		local b = kit.Circle(parent, x + (k % 2) * 3, y - k * 7, 3 + k % 2, 3 + k % 2, WHITE, 0.45, z or 5)
		kit.Stroke(b, WATER_LIGHT, 0.8, 0.3)
		kit.Animate(b, "Bob", 2, 1.2, k * 0.8 + x * 0.1)
	end
end

-- Pied griffe doré
local function clawFoot(kit, parent, cx, y, w, z)
	kit.Blob(parent, cx, y - w * 0.3, w, w * 0.8, GOLD, { Z = z or 1, Shine = true })
end

-- Veines du marbre
local function veins(kit, parent, w, h, z)
	kit.Line(parent, w * 0.1, h * 0.2, w * 0.45, h * 0.6, 1, MARBLE_VEIN, 0.3, z or 2)
	kit.Line(parent, w * 0.45, h * 0.6, w * 0.8, h * 0.35, 1, MARBLE_VEIN, 0.4, z or 2)
	kit.Line(parent, w * 0.6, h * 0.9, w * 0.9, h * 0.7, 0.8, MARBLE_VEIN, 0.5, z or 2)
end

----------------------------------------------------------------------
-- 💎 Luxe
----------------------------------------------------------------------

-- Méridienne en velours (dossier arrondi à gauche, capitons, pieds dorés) : dessus y = 62
Art.VelvetChaise = function(body, kit, _item)
	for _, x in ipairs({ 14, 86 }) do
		kit.Part(body, x - 2, 88, 4, 11, GOLD, { Radius = 2, Z = 1 })
	end
	kit.Part(body, 6, 26, 30, 64, VELVET, { Radius = 15, Z = 2, Shine = true })
	for row = 0, 3 do
		kit.Circle(body, 14 + (row % 2) * 7, 38 + row * 10, 2.4, 2.4, VELVET_DARK, 0, 3)
		kit.Circle(body, 28 - (row % 2) * 7, 38 + row * 10, 2.4, 2.4, VELVET_DARK, 0, 3)
	end
	kit.Part(body, 8, 66, 88, 24, VELVET_DARK, { Radius = 10, Z = 3 })
	kit.Part(body, 10, 58, 86, 14, VELVET, { Radius = 7, Z = 4, Shine = true })
	kit.Part(body, 10, 88, 86, 3, GOLD, { Radius = 1, Z = 5 })
	kit.Part(body, 26, 50, 22, 12, rgb(236, 210, 120), { Radius = 6, Z = 5, Rotation = -10 }) -- coussin
	return nil
end

-- Statue de marbre (buste antique sur colonne cannelée)
Art.MarbleStatue = function(body, kit, _item)
	kit.Part(body, 24, 90, 52, 10, MARBLE, { Radius = 2, Z = 1, Shine = true })
	local column = kit.Part(body, 32, 52, 36, 40, MARBLE, { Radius = 2, Z = 2, Shine = true })
	for k = 1, 4 do
		kit.Box(column, k * 7, 2, 1.4, 36, MARBLE_VEIN, 0.4, 2)
	end
	kit.Part(body, 28, 48, 44, 6, MARBLE, { Radius = 2, Z = 3 })
	-- buste
	local bust = kit.Part(body, 30, 30, 40, 20, MARBLE, { Radius = 10, Z = 4, Shine = true })
	veins(kit, bust, 40, 20, 2)
	kit.Part(body, 44, 22, 12, 10, MARBLE, { Radius = 4, Z = 4 })
	local head = kit.Blob(body, 50, 14, 22, 26, MARBLE, { Z = 5, Shine = true })
	-- profil : nez, couronne de laurier
	kit.Line(head, 8, 12, 10, 15, 1.2, MARBLE_VEIN, 0, 2)
	for k = 0, 4 do
		kit.Blob(body, 40 + k * 5, 4 + math.abs(k - 2) * 1.2, 6, 4, rgb(210, 190, 120), { Z = 6, Rotation = (k - 2) * 20 })
	end
	return nil
end

-- Lit king size (tête de lit capitonnée haute, parure satinée) : dessus y = 60
Art.KingBed = function(body, kit, _item)
	kit.Part(body, 2, 14, 18, 80, rgb(236, 226, 214), { Radius = 8, Z = 1, Shine = true })
	for row = 0, 5 do
		kit.Circle(body, 8 + (row % 2) * 6, 22 + row * 11, 2.4, 2.4, rgb(196, 180, 164), 0, 2)
	end
	kit.Part(body, 4, 76, 94, 20, WALNUT, { Radius = 4, Z = 2, Shine = true })
	for _, x in ipairs({ 10, 92 }) do
		kit.Part(body, x - 3, 94, 6, 6, GOLD, { Radius = 2, Z = 1 })
	end
	kit.Part(body, 8, 62, 90, 16, WHITE, { Radius = 6, Z = 3 })
	local duvet = kit.Part(body, 38, 58, 60, 24, rgb(90, 70, 130), { Radius = 7, Z = 4, Shine = true })
	kit.Box(duvet, 0, 3, 12, 18, rgb(236, 220, 180), 0, 2)
	kit.Part(body, 70, 74, 28, 10, GOLD, { Radius = 4, Z = 5 }) -- plaid
	kit.Blob(body, 26, 56, 24, 16, WHITE, { Z = 5, Shine = true })
	kit.Blob(body, 30, 52, 20, 14, rgb(236, 220, 180), { Z = 6, Shine = true })
	kit.Blob(body, 34, 58, 12, 9, rgb(90, 70, 130), { Z = 7 })
	return nil
end

-- Billard (tapis vert, poches, bandes en bois, queue, boules) : dessus y = 44
Art.PoolTable = function(body, kit, _item)
	for _, x in ipairs({ 12, 50, 88 }) do
		local legPart = kit.Part(body, x - 5, 50, 10, 44, WALNUT_DARK, { Radius = 3, Z = 1, Shine = true })
		kit.Box(legPart, 0, 18, 10, 3, GOLD, 0, 2)
		kit.Part(body, x - 7, 92, 14, 7, WALNUT_DARK, { Radius = 3, Z = 1 })
	end
	local frame = kit.Part(body, 2, 42, 96, 14, WALNUT, { Radius = 4, Z = 2, Shine = true })
	kit.Box(frame, 4, 5, 88, 1.6, GOLD, 0.2, 2)
	local felt = kit.Part(body, 6, 38, 88, 7, rgb(30, 130, 80), { Radius = 3, Z = 3 })
	kit.Box(felt, 0, 0, 88, 1.4, rgb(60, 170, 110), 0, 2)
	for _, x in ipairs({ 6, 50, 94 }) do
		kit.Circle(body, x, 42, 7, 7, IRON_DARK, 0, 4)
	end
	-- boules + queue
	local colors = { rgb(250, 250, 240), rgb(240, 200, 40), RED, rgb(40, 90, 200), rgb(30, 30, 30), rgb(120, 50, 150) }
	for index, c in ipairs(colors) do
		kit.Circle(body, 28 + index * 7, 35 - (index % 2), 6, 6, c, 0, 5)
	end
	kit.Line(body, 10, 30, 30, 36, 2, rgb(214, 180, 120), 0, 6)
	kit.Line(body, 58, 24, 92, 34, 2.4, rgb(214, 180, 120), 0, 6)
	kit.Line(body, 90, 33.4, 93, 34.4, 2.4, IRON_DARK, 0, 7)
	-- lampe de billard au-dessus
	kit.Line(body, 30, 0, 30, 8, 1, IRON, 0, 1)
	kit.Line(body, 70, 0, 70, 8, 1, IRON, 0, 1)
	kit.Part(body, 22, 8, 56, 8, rgb(30, 90, 60), { Radius = 4, Z = 2, Shine = true })
	local glow = kit.Box(body, 26, 16, 48, 3, AMBER, 0.3, 2)
	kit.Animate(glow, "Pulse", 0.2, 1, 0)
	return { Glow = AMBER }
end

-- Géode d'améthyste géante (coquille de pierre, cristaux violets, socle)
Art.AmethystGeode = function(body, kit, _item)
	kit.Part(body, 26, 88, 48, 12, IRON_DARK, { Radius = 3, Z = 1, Shine = true })
	kit.Part(body, 34, 80, 32, 10, IRON, { Radius = 2, Z = 1 })
	local shell = kit.Blob(body, 50, 46, 70, 76, STONE, { Z = 2, Shine = true })
	kit.Blob(shell, 35, 38, 58, 64, rgb(236, 230, 240), { Z = 2, Outline = false })
	local inner = kit.Blob(shell, 35, 38, 50, 56, rgb(110, 60, 160), { Z = 3, Outline = false })
	local purples = { rgb(170, 110, 230), rgb(140, 80, 210), rgb(200, 150, 250), rgb(120, 70, 190) }
	local n = 0
	for row = 0, 4 do
		for col = 0, 3 do
			n += 1
			local d = kit.Diamond(inner, 8 + col * 11 + (row % 2) * 5, 8 + row * 10, 8 + (n % 3) * 2, purples[(n % #purples) + 1], 0, 2 + n % 2)
			local _ = d
		end
	end
	local glow = kit.Circle(inner, 25, 28, 30, 30, rgb(220, 180, 255), 0.6, 4)
	kit.Animate(glow, "Pulse", 0.25, 0.8, 0)
	kit.Sparkle(body, 64, 24, 10, WHITE, 0, 6)
	kit.Sparkle(body, 38, 58, 7, WHITE, 0, 6)
	return { Glow = rgb(200, 150, 250) }
end

-- Cheminée murale design (longue flamme derrière la vitre, pierre)
Art.ModernFireplace = function(body, kit, _item)
	local slab = kit.Part(body, 2, 22, 96, 56, rgb(64, 64, 70), { Radius = 3, Z = 1, Shine = true })
	kit.Box(slab, 0, 0, 96, 6, rgb(90, 90, 96), 0, 2)
	local box = kit.Part(body, 8, 38, 84, 28, rgb(20, 18, 22), { Radius = 2, Z = 2, Outline = STEEL, Thickness = 2 })
	-- lit de galets + flammes
	for k = 0, 9 do
		kit.Blob(box, 6 + k * 8, 25, 9, 5, k % 2 == 0 and rgb(200, 196, 190) or rgb(150, 146, 144), { Z = 3, Outline = false })
	end
	for k = 0, 7 do
		local flame = kit.Blob(box, 9 + k * 10, 16, 8, 16 + (k % 3) * 3, k % 2 == 0 and FIRE or rgb(255, 200, 80), { Z = 2, Outline = false, T = 0.1 })
		kit.Animate(flame, "Flicker", 0.25, 1, k * 0.7)
	end
	local glass = kit.Box(box, 0, 0, 84, 28, WHITE, 0.88, 4)
	local _ = glass
	kit.Line(box, 6, 22, 20, 4, 2, WHITE, 0.7, 5)
	return { Glow = FIRE, WallShadow = Vector2.new(96, 56) }
end

-- Rangée de fauteuils de cinéma (3 sièges cuir rouge, porte-gobelets) : dessus y = 62
Art.CinemaRecliners = function(body, kit, _item)
	local leather = rgb(170, 40, 50)
	kit.Part(body, 2, 90, 96, 9, IRON_DARK, { Radius = 3, Z = 1 })
	for index = 0, 2 do
		local x = 4 + index * 32
		kit.Part(body, x + 2, 24, 26, 44, leather, { Radius = 10, Z = 2, Shine = true })
		kit.Part(body, x + 5, 28, 20, 18, kit.Darken(leather, 0.15), { Radius = 8, Z = 3 })
		kit.Part(body, x + 2, 58, 26, 18, leather, { Radius = 7, Z = 4, Shine = true })
		kit.Part(body, x + 4, 74, 22, 16, kit.Darken(leather, 0.2), { Radius = 5, Z = 3 }) -- repose-pieds
	end
	for index = 0, 3 do
		local x = 2 + index * 32
		kit.Part(body, x - 2, 46, 8, 44, rgb(40, 36, 40), { Radius = 3, Z = 5, Shine = true })
		kit.Circle(body, x + 2, 48, 5, 5, IRON, 0, 6) -- porte-gobelet
	end
	-- pop-corn
	kit.Part(body, 62, 36, 8, 10, WHITE, { Radius = 1, Z = 6 })
	kit.Box(body, 62, 38, 2, 8, RED, 0, 7)
	kit.Box(body, 66, 38, 2, 8, RED, 0, 7)
	for k = 0, 3 do
		kit.Circle(body, 63 + k * 2, 35 - k % 2, 4, 4, rgb(255, 240, 190), 0, 7)
	end
	local led = kit.Box(body, 4, 88, 92, 2, AMBER, 0.2, 2)
	kit.Animate(led, "Pulse", 0.3, 1, 0)
	return nil
end

-- Piano de concert blanc (couvercle ouvert, clavier, pédales dorées)
Art.WhitePiano = function(body, kit, _item)
	for _, x in ipairs({ 18, 82 }) do
		kit.Part(body, x - 4, 58, 8, 40, rgb(236, 236, 240), { Radius = 3, Z = 1, Shine = true })
		kit.Circle(body, x, 97, 7, 5, GOLD, 0, 2)
	end
	-- couvercle levé + béquille
	kit.Line(body, 70, 50, 70, 16, 2, GOLD, 0, 1)
	local lid = kit.Part(body, 14, 8, 80, 10, WHITE, { Radius = 5, Z = 2, Rotation = -14, Shine = true })
	local _ = lid
	local case = kit.Part(body, 6, 34, 90, 26, WHITE, { Radius = 12, Z = 3, Shine = true })
	kit.Box(case, 6, 4, 70, 1.4, GOLD, 0.2, 2)
	-- clavier
	local keys = kit.Part(body, 4, 54, 50, 9, WHITE, { Radius = 2, Z = 4, Outline = rgb(150, 150, 160) })
	for k = 0, 11 do
		kit.Box(keys, 2 + k * 4, 0, 0.6, 9, rgb(170, 170, 180), 0, 2)
		if k % 7 ~= 2 and k % 7 ~= 6 then
			kit.Box(keys, 4.4 + k * 4, 0, 2, 5, rgb(30, 30, 36), 0, 3)
		end
	end
	-- lyre + pédales
	kit.Part(body, 42, 76, 8, 14, rgb(236, 236, 240), { Radius = 2, Z = 2 })
	for k = 0, 2 do
		kit.Part(body, 40 + k * 4, 90, 3, 5, GOLD, { Radius = 1, Z = 3 })
	end
	kit.Text(body, "♪", 80, 26, 12, GOLD_DARK, 5)
	return nil
end

-- Jacuzzi (cuve ronde, eau turquoise, bulles, marches, LED) : assis dedans
Art.Jacuzzi = function(body, kit, _item)
	kit.Part(body, 0, 60, 100, 40, rgb(236, 230, 220), { Radius = 10, Z = 1, Shine = true })
	for k = 0, 5 do
		kit.Box(body, 4 + k * 16, 64, 1, 34, rgb(214, 204, 190), 0, 2)
	end
	kit.Part(body, 2, 54, 96, 10, rgb(210, 200, 186), { Radius = 5, Z = 3 })
	local water = kit.Part(body, 8, 44, 84, 14, WATER, { Radius = 7, Z = 4, T = 0.1, Shine = true })
	kit.Gradient(water, WATER_LIGHT, WATER_DEEP, 90)
	for k = 0, 5 do
		local foam = kit.Blob(water, 10 + k * 13, 3, 12, 6, WHITE, { Z = 3, Outline = false, T = 0.2 })
		kit.Animate(foam, "Breathe", 0.12, 1.4, k)
	end
	bubbles(kit, body, 30, 42, 4, 6)
	bubbles(kit, body, 66, 40, 4, 6)
	-- LED bleue + marches
	local led = kit.Box(body, 10, 70, 80, 2, CYAN, 0.2, 3)
	kit.Animate(led, "Pulse", 0.4, 1, 0)
	kit.Part(body, 36, 90, 28, 8, rgb(214, 204, 190), { Radius = 2, Z = 4 })
	-- serviettes roulées + bougie
	kit.Part(body, 76, 46, 16, 8, WHITE, { Radius = 4, Z = 5 })
	kit.Part(body, 78, 40, 12, 7, rgb(160, 210, 230), { Radius = 3, Z = 6 })
	kit.Part(body, 10, 44, 6, 8, rgb(250, 240, 220), { Radius = 2, Z = 5 })
	local flame = kit.Blob(body, 13, 42, 3, 5, FIRE, { Z = 6, Outline = false })
	kit.Animate(flame, "Flicker", 0.3, 1, 0)
	return { Glow = CYAN }
end

-- Mur d'aquarium (grand bassin encastré, coraux, poissons, lumière)
Art.AquariumWall = function(body, kit, _item)
	local frame = kit.Part(body, 2, 4, 96, 96, IRON_DARK, { Radius = 4, Z = 1, Shine = true })
	local tank = kit.Part(frame, 4, 8, 88, 76, WATER, { Radius = 2, Z = 2, Outline = false })
	kit.Gradient(tank, WATER_LIGHT, WATER_DEEP, 90)
	local clip = kit.Group(tank, 0, 0, 88, 76, 3, true)
	-- sable + coraux + algues
	kit.Blob(clip, 44, 78, 100, 20, rgb(236, 214, 160), { Z = 1, Outline = false })
	for index, s in ipairs({ { 12, rgb(255, 110, 120) }, { 30, rgb(255, 170, 80) }, { 60, rgb(200, 110, 230) }, { 78, rgb(255, 130, 160) } }) do
		for k = 0, 2 do
			kit.Line(clip, s[1], 70, s[1] + (k - 1) * 6, 54 - k * 3, 3, s[2], 0, 2)
		end
		local _ = index
	end
	for _, x in ipairs({ 22, 48, 70 }) do
		local weed = kit.Line(clip, x, 72, x + 2, 36, 3, LEAF, 0, 1)
		kit.Animate(weed, "Sway", 4, 0.8, x)
	end
	fish(kit, clip, 24, 22, 12, rgb(255, 150, 40), 1, 4)
	fish(kit, clip, 62, 32, 10, rgb(255, 220, 60), -1, 4)
	fish(kit, clip, 40, 44, 14, rgb(60, 140, 255), 1, 4)
	fish(kit, clip, 74, 14, 9, rgb(255, 100, 140), -1, 4)
	fish(kit, clip, 14, 40, 8, WHITE, -1, 4)
	bubbles(kit, clip, 80, 60, 5, 5)
	-- rayons de lumière
	for k = 0, 2 do
		local ray = kit.Box(clip, 10 + k * 28, 0, 10, 76, WHITE, 0.85, 5)
		ray.Rotation = 12
	end
	kit.Part(body, 2, 4, 96, 8, rgb(60, 62, 70), { Radius = 3, Z = 3 })
	kit.Part(body, 2, 88, 96, 12, rgb(80, 64, 50), { Radius = 3, Z = 3, Shine = true })
	return { Glow = WATER_LIGHT }
end

-- Mini montagnes russes (maquette : rails, looping, wagonnets qui roulent)
Art.RollercoasterModel = function(body, kit, _item)
	kit.Part(body, 2, 90, 96, 10, rgb(60, 140, 90), { Radius = 4, Z = 1, Shine = true })
	-- piliers
	for _, spec in ipairs({ { 14, 60 }, { 30, 30 }, { 46, 50 }, { 84, 44 } }) do
		kit.Part(body, spec[1] - 1.5, spec[2], 3, 90 - spec[2], rgb(230, 230, 240), { Radius = 1, Z = 2 })
	end
	-- rail (points reliés)
	local rail = { { 4, 80 }, { 14, 60 }, { 24, 34 }, { 30, 28 }, { 36, 34 }, { 46, 50 }, { 56, 66 }, { 66, 72 }, { 74, 66 }, { 78, 54 },
		{ 76, 40 }, { 70, 34 }, { 64, 40 }, { 66, 52 }, { 76, 58 }, { 88, 44 }, { 96, 36 } }
	for index = 1, #rail - 1 do
		local a, c = rail[index], rail[index + 1]
		kit.Line(body, a[1], a[2], c[1], c[2], 3.4, RED, 0, 3)
		kit.Line(body, a[1], a[2] + 2.4, c[1], c[2] + 2.4, 1.2, rgb(160, 30, 40), 0, 3)
	end
	-- 3 wagonnets sur la descente
	for k = 0, 2 do
		local x = 38 + k * 6
		local y = 38 + k * 9
		local car = kit.Part(body, x - 3, y - 6, 7, 6, k == 0 and rgb(255, 214, 60) or rgb(60, 160, 255), { Radius = 2, Z = 5, Rotation = 55 })
		kit.Circle(car, 3.5, -1, 3.4, 3.4, rgb(240, 200, 170), 0, 2)
	end
	-- entrée + drapeaux
	kit.Part(body, 4, 76, 16, 14, rgb(255, 230, 180), { Radius = 2, Z = 4 })
	kit.Triangle(body, 12, 66, 20, 10, rgb(236, 72, 120), 5)
	local flag = kit.Box(body, 96, 30, 6, 4, rgb(255, 214, 60), 0, 5)
	kit.Animate(flag, "Sway", 8, 1.2, 0)
	return nil
end

-- Trône en or (dossier haut sculpté, velours rouge, lions) : dessus y = 58
Art.GoldThrone = function(body, kit, _item)
	kit.Part(body, 14, 92, 72, 8, GOLD_DARK, { Radius = 3, Z = 1, Shine = true }) -- estrade
	local back = kit.Part(body, 24, 2, 52, 62, GOLD, { Radius = 14, Z = 2, Shine = true })
	kit.Part(back, 8, 12, 36, 44, rgb(170, 30, 50), { Radius = 10, Z = 2, Shine = true })
	kit.Diamond(back, 26, 30, 8, GOLD_LIGHT, 0, 3)
	-- couronne en haut du dossier
	for k = 0, 2 do
		kit.Triangle(body, 38 + k * 12, -6, 10, 12, GOLD, 3)
		kit.Circle(body, 38 + k * 12, -6, 5, 5, rgb(236, 72, 100), 0, 4)
	end
	kit.Part(body, 22, 56, 56, 12, rgb(170, 30, 50), { Radius = 6, Z = 4, Shine = true })
	kit.Part(body, 20, 66, 60, 26, GOLD, { Radius = 6, Z = 3, Shine = true })
	for _, x in ipairs({ 22, 78 }) do
		kit.Part(body, x - 8, 40, 16, 30, GOLD, { Radius = 7, Z = 5, Shine = true }) -- accoudoirs
		kit.Blob(body, x, 40, 16, 14, GOLD_LIGHT, { Z = 6, Shine = true }) -- tête de lion
		kit.Circle(body, x, 42, 5, 4, GOLD_DARK, 0, 7)
		clawFoot(kit, body, x, 94, 12, 4)
	end
	kit.Sparkle(body, 88, 14, 10, GOLD_LIGHT, 0, 8)
	kit.Sparkle(body, 12, 30, 7, WHITE, 0, 8)
	return { Glow = GOLD_LIGHT }
end

-- Cascade intérieure (mur de pierre, eau qui tombe, bassin, plantes)
Art.IndoorWaterfall = function(body, kit, _item)
	local wall = kit.Part(body, 8, 2, 84, 80, STONE, { Radius = 4, Z = 1, Shine = true })
	for index, s in ipairs({ { 10, 10, 20 }, { 50, 8, 24 }, { 28, 30, 18 }, { 62, 34, 20 }, { 12, 54, 22 }, { 56, 58, 18 } }) do
		kit.Part(wall, s[1], s[2], s[3], 14, index % 2 == 0 and STONE_DARK or rgb(170, 164, 156), { Radius = 5, Z = 2, Thickness = 1 })
	end
	-- nappe d'eau (bandes qui descendent)
	local fall = kit.Group(body, 30, 6, 40, 76, 3, true)
	kit.Box(fall, 0, 0, 40, 76, WATER, 0.25, 1)
	for k = 0, 5 do
		local streak = kit.Box(fall, 3 + k * 6.4, 0, 2, 30, WATER_LIGHT, 0.3, 2)
		kit.Animate(streak, "Bob", 10, 1.4 + k * 0.1, k)
	end
	-- bassin
	kit.Part(body, 0, 80, 100, 20, STONE_DARK, { Radius = 6, Z = 4, Shine = true })
	local pool = kit.Part(body, 6, 78, 88, 8, WATER, { Radius = 4, Z = 5, Shine = true })
	kit.Gradient(pool, WATER_LIGHT, WATER_DEEP, 90)
	for k = 0, 3 do
		local splash = kit.Blob(body, 38 + k * 8, 78, 8, 5, WHITE, { Z = 6, Outline = false, T = 0.3 })
		kit.Animate(splash, "Breathe", 0.2, 1.6, k)
	end
	-- fougères de chaque côté
	for _, x in ipairs({ 10, 90 }) do
		for k = 0, 2 do
			kit.Blob(body, x + (k - 1) * 5, 74 - k * 6, 10, 20, k % 2 == 0 and LEAF or LEAF_DARK, { Z = 7, Rotation = (k - 1) * 25 })
		end
	end
	return { Glow = WATER_LIGHT }
end

-- Lit capsule spatiale (coque blanche, hublot, néon bleu) : on s'y couche
Art.CapsuleBed = function(body, kit, _item)
	kit.Part(body, 6, 90, 88, 8, IRON, { Radius = 3, Z = 1 })
	local shell = kit.Part(body, 2, 22, 96, 72, rgb(240, 242, 248), { Radius = 34, Z = 2, Shine = true })
	kit.Box(shell, 8, 60, 80, 2, rgb(200, 204, 214), 0, 2)
	local inner = kit.Part(shell, 10, 12, 76, 44, rgb(40, 50, 90), { Radius = 20, Z = 2 })
	-- étoiles dans le ciel de la capsule
	for k = 0, 7 do
		local star = kit.Circle(inner, 8 + (k * 17) % 60, 6 + (k * 11) % 20, 2, 2, WHITE, 0.1, 2)
		kit.Animate(star, "Pulse", 0.6, 1, k)
	end
	kit.Part(inner, 4, 28, 68, 14, rgb(200, 210, 240), { Radius = 6, Z = 3 }) -- matelas
	kit.Part(inner, 30, 24, 42, 16, rgb(90, 120, 220), { Radius = 6, Z = 4 }) -- couette
	kit.Blob(inner, 18, 30, 16, 10, WHITE, { Z = 4 })
	local neon = kit.Part(shell, 10, 58, 76, 2, CYAN, { Radius = 1, Z = 3, Outline = false })
	kit.Animate(neon, "Pulse", 0.4, 1, 0)
	-- panneau de contrôle + écusson
	kit.Part(body, 80, 30, 12, 20, IRON_DARK, { Radius = 3, Z = 4 })
	for k = 0, 2 do
		kit.Circle(body, 86, 35 + k * 5, 3, 3, ({ RED, CYAN, rgb(140, 240, 110) })[k + 1], 0, 5)
	end
	kit.Text(body, "🚀", 50, 84, 10, WHITE, 5)
	return { Glow = CYAN }
end

-- Statue de dragon d'or (corps enroulé, ailes, perle)
Art.DragonStatue = function(body, kit, _item)
	kit.Part(body, 10, 88, 80, 12, rgb(60, 50, 50), { Radius = 3, Z = 1, Shine = true })
	kit.Part(body, 16, 84, 68, 6, GOLD_DARK, { Radius = 2, Z = 2 })
	-- ailes
	for _, dir in ipairs({ -1, 1 }) do
		local wing = kit.Pivot(body, 50 + dir * 10, 40, 2)
		for k = 0, 3 do
			local rib = kit.Line(wing, 0, 0, dir * (26 - k * 4), -24 + k * 10, 2, GOLD_DARK, 0, 1)
			local _ = rib
		end
		kit.Triangle(wing, dir * 16, -24, 26, 30, GOLD, 1, 0.1)
		kit.Animate(wing, "Sway", 3, 0.8, dir)
	end
	-- corps (anneaux)
	local coil = { { 30, 78, 26 }, { 50, 74, 28 }, { 70, 70, 24 }, { 62, 56, 22 }, { 46, 50, 22 }, { 42, 36, 20 } }
	for index, s in ipairs(coil) do
		local seg = kit.Blob(body, s[1], s[2], s[3], s[3] * 0.8, GOLD, { Z = 3 + index % 2, Shine = true })
		for k = 0, 2 do
			kit.Box(seg, s[3] * 0.2 + k * s[3] * 0.2, s[3] * 0.1, 2, 2, GOLD_DARK, 0.2, 2)
		end
	end
	-- tête
	local head = kit.Blob(body, 50, 22, 28, 20, GOLD, { Z = 6, Shine = true })
	kit.Circle(head, 20, 8, 5, 5, RED, 0, 3)
	kit.Line(head, 22, 16, 30, 16, 1.4, GOLD_DARK, 0, 3)
	kit.Triangle(body, 40, 6, 6, 10, GOLD_DARK, 7)
	kit.Triangle(body, 50, 4, 6, 10, GOLD_DARK, 7)
	-- moustaches
	kit.Line(body, 62, 26, 80, 32, 1.4, GOLD_LIGHT, 0, 7)
	kit.Line(body, 62, 28, 76, 38, 1.4, GOLD_LIGHT, 0, 7)
	-- perle
	local pearl = kit.Circle(body, 84, 60, 12, 12, rgb(240, 236, 255), 0, 6)
	kit.Shine(pearl, 2, 2, 4, 3, 3, 0.2)
	local halo = kit.Circle(body, 84, 60, 20, 20, rgb(200, 220, 255), 0.6, 5)
	kit.Animate(halo, "Pulse", 0.3, 1, 0)
	return { Glow = GOLD_LIGHT }
end

-- Tunnel aquarium (arche de verre où l'on passe dessous, poissons, raie)
Art.AquariumTunnel = function(body, kit, _item)
	local arch = kit.Part(body, 0, 4, 100, 96, IRON_DARK, { Radius = 48, Z = 1, Shine = true })
	local water = kit.Part(arch, 4, 4, 92, 92, WATER, { Radius = 44, Z = 2, Outline = false })
	kit.Gradient(water, WATER_LIGHT, WATER_DEEP, 90)
	local clip = kit.Group(water, 0, 0, 92, 92, 3, true)
	-- raie manta + poissons + tortue
	local ray = kit.Pivot(clip, 46, 20, 4)
	kit.Diamond(ray, 0, 0, 20, rgb(60, 70, 110), 0, 1)
	kit.Line(ray, 0, 6, 0, 20, 1.4, rgb(60, 70, 110), 0, 1)
	kit.Animate(ray, "Drift", 10, 0.4, 0)
	fish(kit, clip, 18, 36, 10, rgb(255, 150, 40), 1, 5)
	fish(kit, clip, 72, 40, 12, rgb(255, 220, 60), -1, 5)
	fish(kit, clip, 30, 16, 8, rgb(255, 100, 140), 1, 5)
	fish(kit, clip, 64, 12, 9, WHITE, -1, 5)
	local turtle = kit.Pivot(clip, 76, 24, 5)
	kit.Blob(turtle, 0, 0, 16, 11, rgb(100, 150, 90), { Z = 2, Shine = true })
	kit.Blob(turtle, 9, -1, 6, 5, rgb(140, 180, 110), { Z = 1 })
	kit.Animate(turtle, "Bob", 2, 0.7, 0)
	bubbles(kit, clip, 12, 60, 4, 6)
	bubbles(kit, clip, 82, 64, 4, 6)
	-- le passage (tunnel sous l'eau) : sol + arche intérieure en verre
	local passage = kit.Part(clip, 22, 50, 48, 50, rgb(170, 220, 240), { Radius = 24, Z = 6, T = 0.35, Outline = rgb(220, 240, 255), Thickness = 2 })
	kit.Box(passage, 0, 36, 48, 14, rgb(60, 70, 90), 0, 2)
	kit.Box(passage, 22, 36, 4, 14, rgb(90, 100, 120), 0, 3)
	for k = 0, 2 do
		kit.Box(clip, 22, 60 + k * 10, 48, 1, WHITE, 0.6, 7)
	end
	kit.Part(body, 0, 92, 100, 8, rgb(70, 72, 84), { Radius = 3, Z = 3 })
	return { Glow = WATER_LIGHT }
end

----------------------------------------------------------------------
-- 💡 Lumières de luxe
----------------------------------------------------------------------

-- Dôme planétarium (demi-sphère étoilée qui tourne, socle)
Art.PlanetariumDome = function(body, kit, _item)
	kit.Part(body, 26, 84, 48, 14, IRON_DARK, { Radius = 5, Z = 1, Shine = true })
	kit.Part(body, 44, 60, 12, 26, IRON, { Radius = 3, Z = 2 })
	local halo = kit.Circle(body, 50, 44, 90, 70, rgb(120, 100, 255), 0.8, 1)
	kit.Animate(halo, "Pulse", 0.12, 0.8, 0)
	local dome = kit.Circle(body, 50, 44, 70, 70, rgb(30, 30, 80), 0, 3)
	kit.Stroke(dome, rgb(150, 130, 255), 2, 0)
	local sky = kit.Pivot(dome, 35, 35, 2)
	for k = 0, 13 do
		local a = k * 2.4
		local r = 6 + (k * 7) % 26
		kit.Sparkle(sky, math.cos(a) * r, math.sin(a) * r, 3 + k % 3 * 2, k % 3 == 0 and rgb(255, 230, 150) or WHITE, 0, 1)
	end
	kit.Circle(sky, 14, -12, 10, 10, rgb(255, 170, 100), 0, 2) -- planète
	kit.Animate(sky, "Spin", 1, 0.05, 0)
	kit.Shine(dome, 14, 10, 18, 7, 4, 0.55)
	return { Glow = rgb(150, 130, 255) }
end

-- Grand lustre en cristal (étages de pampilles, bougies, chaîne dorée)
Art.GrandChandelier = function(body, kit, _item)
	kit.Line(body, 50, 0, 50, 14, 2, GOLD_DARK, 0, 1)
	kit.Part(body, 42, 12, 16, 6, GOLD, { Radius = 3, Z = 2 })
	local bulbs = {}
	for tier = 0, 2 do
		local w = 40 + tier * 26
		local y = 26 + tier * 18
		kit.Part(body, 50 - w / 2, y, w, 5, GOLD, { Radius = 3, Z = 3 + tier, Shine = true })
		local n = 3 + tier * 2
		for k = 0, n - 1 do
			local x = 50 - w / 2 + 4 + k * (w - 8) / math.max(1, n - 1)
			local drop = kit.Diamond(body, x, y + 11, 5, rgb(220, 240, 255), 0.1, 6)
			kit.Line(body, x, y + 4, x, y + 9, 0.8, rgb(220, 240, 255), 0.2, 5)
			kit.Animate(drop, "Sway", 6, 0.8, x)
			-- bougie + flamme
			kit.Part(body, x - 1.5, y - 7, 3, 7, rgb(250, 244, 230), { Radius = 1, Z = 4 + tier })
			local flame = kit.Blob(body, x, y - 9, 3.4, 5, AMBER, { Z = 7, Outline = false })
			kit.Animate(flame, "Flicker", 0.3, 1, x)
			table.insert(bulbs, flame)
		end
	end
	for k = 0, 4 do
		kit.Line(body, 50, 18, 20 + k * 15, 62, 1, GOLD_DARK, 0.3, 2)
	end
	local drop = kit.Diamond(body, 50, 86, 10, rgb(220, 240, 255), 0, 8)
	kit.Animate(drop, "Sway", 4, 0.6, 0)
	local halo = kit.Circle(body, 50, 50, 100, 70, AMBER, 0.8, 1)
	table.insert(bulbs, halo)
	return { Glow = AMBER, Bulbs = bulbs, WallShadow = Vector2.new(0, 0) }
end

----------------------------------------------------------------------
-- 📺 Télés XXL et écran de home cinéma (Dopamine Setup, DESK98)
----------------------------------------------------------------------

-- Scène "live" du clicker sur un écran (streameur, chat, compteur)
local function liveScene(kit, screen, w, h)
	local clip = kit.Group(screen, 0, 0, w, h, 2, true)
	kit.Box(clip, 0, 0, w, h, rgb(60, 40, 110), 0, 1)
	kit.Gradient(kit.Box(clip, 0, 0, w, h, WHITE, 0, 1), rgb(120, 80, 220), rgb(236, 90, 170), 90)
	-- streameur
	kit.Blob(clip, w * 0.34, h * 0.95, w * 0.34, h * 0.5, rgb(60, 60, 90), { Z = 2, Outline = false })
	kit.Circle(clip, w * 0.34, h * 0.5, w * 0.18, w * 0.18, rgb(255, 214, 180), 0, 3)
	kit.Box(clip, w * 0.24, h * 0.36, w * 0.2, h * 0.08, rgb(90, 60, 50), 0, 4)
	-- chat du live
	local chat = kit.Box(clip, w * 0.66, h * 0.1, w * 0.3, h * 0.8, rgb(20, 20, 40), 0.35, 3)
	kit.Round(chat, 3)
	for k = 0, 3 do
		kit.Box(chat, 3, 4 + k * h * 0.17, w * 0.24 - (k % 2) * 6, 2.4, k % 2 == 0 and CYAN or MAGENTA, 0.1, 2)
	end
	local live = kit.Box(clip, 4, 4, 22, 9, RED, 0, 5)
	kit.Round(live, 2)
	kit.Text(live, "LIVE", 11, 4.5, 6, WHITE, 2)
	kit.Animate(live, "Pulse", 0.5, 2, 0)
	kit.Text(clip, "👁 12.4K", w * 0.2, h - 8, 6, WHITE, 5)
end

-- Télé cinéma XXL sur pied (bords ultra-fins, barre de son, pieds chromés)
Art.SetupTVCinemaXXL = function(body, kit, _item)
	for _, x in ipairs({ 16, 84 }) do
		kit.Line(body, x, 86, x + (x < 50 and -6 or 6), 99, 3, STEEL, 0, 1)
	end
	local panel = kit.Part(body, 0, 22, 100, 60, rgb(20, 20, 26), { Radius = 2, Z = 2, Outline = rgb(90, 92, 100), Thickness = 1.2 })
	local screen = kit.Part(panel, 1.5, 1.5, 97, 57, SCREEN, { Radius = 1, Z = 2, Outline = false, Shade = false })
	liveScene(kit, screen, 97, 57)
	kit.Line(screen, 60, 4, 80, 30, 6, WHITE, 0.88, 6)
	kit.Part(body, 14, 86, 72, 7, rgb(40, 40, 48), { Radius = 3, Z = 3, Shine = true })
	kit.Box(body, 18, 88, 64, 3, rgb(70, 70, 84), 0, 4)
	kit.Text(body, "XXL", 90, 16, 8, CYAN, 4)
	return { Glow = rgb(170, 110, 255) }
end

-- Télé murale XXL (très fine, ambilight derrière, sans pied)
Art.SetupTVWallXXL = function(body, kit, _item)
	local halo = kit.Part(body, -4, 12, 108, 70, CYAN, { Radius = 12, Z = 1, T = 0.72, Outline = false, Shade = false })
	kit.Animate(halo, "Pulse", 0.15, 1, 0)
	local panel = kit.Part(body, 0, 18, 100, 60, rgb(20, 20, 26), { Radius = 2, Z = 2, Outline = rgb(90, 92, 100), Thickness = 1.2 })
	local screen = kit.Part(panel, 1.5, 1.5, 97, 57, SCREEN, { Radius = 1, Z = 2, Outline = false, Shade = false })
	liveScene(kit, screen, 97, 57)
	kit.Line(screen, 60, 4, 80, 30, 6, WHITE, 0.88, 6)
	kit.Box(body, 46, 76, 8, 1.2, STEEL, 0, 3)
	return { Glow = CYAN, WallShadow = Vector2.new(100, 60) }
end

-- Écran de home cinéma (toile géante bordée de noir, carter enroulable,
-- petit projecteur suspendu qui éclaire la toile)
Art.SetupCinemaScreen = function(body, kit, _item)
	kit.Part(body, -2, 6, 104, 8, rgb(40, 40, 48), { Radius = 4, Z = 2, Shine = true })
	local border = kit.Part(body, 0, 12, 100, 66, rgb(16, 16, 20), { Radius = 1, Z = 1, Outline = false })
	local canvas = kit.Part(border, 3, 3, 94, 60, WHITE, { Radius = 1, Z = 2, Outline = false, Shade = false })
	liveScene(kit, canvas, 94, 60)
	kit.Box(body, 46, 78, 8, 6, rgb(40, 40, 48), 0, 2) -- poignée de la toile
	-- projecteur suspendu (coin haut droit) + son faisceau
	kit.Line(body, 90, -6, 90, 2, 1.4, IRON, 0, 4)
	kit.Part(body, 80, 0, 20, 9, rgb(236, 238, 244), { Radius = 3, Z = 5, Shine = true })
	local lens = kit.Circle(body, 84, 5, 6, 6, rgb(60, 100, 160), 0, 6)
	kit.Animate(lens, "Pulse", 0.3, 1.2, 0)
	kit.Line(body, 82, 8, 50, 44, 18, WHITE, 0.9, 3)
	kit.Text(body, "🎬", 8, 86, 10, WHITE, 5)
	return { Glow = rgb(170, 110, 255), WallShadow = Vector2.new(100, 66) }
end

return Art
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="27">
              <Properties>
                <string name="Name">Modern98</string>
                <string name="Source"><![CDATA[--[[
	Modern98 (ModuleScript) — (v9.8 CATALOG98) meubles modernes, loft
	industriel, déco, lumières, plantes, tech, cuisine, coin gamer et sport
	Emplacement : ReplicatedStorage > Client > Components > House > Art > Modern98
	Contrat : voir HouseArt (boîte 100 x 100, pieds en bas pour les objets au
	sol, objets muraux centrés).

	Style : le même rendu "autocollant" que le reste (contours doux, reflets,
	ombrages) mais en couleurs RÉALISTES (chêne, noyer, acier, béton, cuir,
	marbre, verre fumé) : ce ne sont pas des objets kawaii, donc pas de
	visages. Les dessus des tables, étagères, sièges et lits sont déclarés
	dans House/HouseSurfaces (mêmes coordonnées que les dessins et que les
	modèles 3D de House3DLuxe).
]]

local Art = {}

local rgb = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)
local OAK = rgb(214, 172, 120)
local OAK_DARK = rgb(170, 128, 84)
local WALNUT = rgb(128, 84, 56)
local WALNUT_DARK = rgb(92, 60, 42)
local STEEL = rgb(186, 192, 204)
local STEEL_DARK = rgb(112, 118, 132)
local IRON = rgb(64, 66, 76)
local IRON_DARK = rgb(40, 42, 50)
local CONCRETE = rgb(176, 174, 170)
local LEATHER = rgb(142, 80, 50)
local LEATHER_DARK = rgb(104, 56, 36)
local LINEN = rgb(226, 220, 208)
local GREIGE = rgb(176, 168, 158)
local SLATE = rgb(92, 104, 122)
local MARBLE = rgb(240, 238, 236)
local MARBLE_VEIN = rgb(188, 186, 194)
local GLASS = rgb(186, 222, 236)
local LEAF = rgb(84, 150, 84)
local LEAF_DARK = rgb(52, 110, 62)
local LEAF_LIGHT = rgb(128, 190, 110)
local TERRACOTTA = rgb(206, 116, 80)
local CERAMIC = rgb(236, 232, 226)
local SCREEN = rgb(30, 36, 60)
local CYAN = rgb(60, 222, 255)
local MAGENTA = rgb(255, 84, 196)
local LIME = rgb(140, 240, 110)
local RED = rgb(226, 64, 70)
local ORANGE = rgb(255, 150, 60)
local AMBER = rgb(255, 196, 110)
local BLUE = rgb(70, 130, 220)
local GREEN_FELT = rgb(40, 140, 90)

----------------------------------------------------------------------
-- Petits outils
----------------------------------------------------------------------

-- Pied fin (tube) de meuble moderne
local function leg(kit, parent, x, top, bottom, w, color, z)
	return kit.Part(parent, x - w / 2, top, w, bottom - top, color, { Radius = math.max(1, w / 2), Z = z or 1, Thickness = 1.2 })
end

-- Pot (bas y = bas du pot), largeur en haut `w`, hauteur `h`
local function pot(kit, parent, cx, bottom, w, h, color, z)
	local zz = z or 3
	local body = kit.Part(parent, cx - w * 0.42, bottom - h, w * 0.84, h, color, { Radius = 5, Z = zz, Shine = true })
	kit.Part(parent, cx - w / 2, bottom - h - 2, w, 6, kit.Lighten(color, 0.12), { Radius = 3, Z = zz + 1 })
	return body
end

-- Feuille ovale inclinée (centre cx, cy)
local function leaf(kit, parent, cx, cy, w, h, color, rotation, z)
	local l = kit.Blob(parent, cx, cy, w, h, color, { Z = z or 4, Rotation = rotation, Thickness = 1.2 })
	kit.Line(l, w * 0.5, h * 0.12, w * 0.5, h * 0.88, 1, kit.Darken(color, 0.25), 0.3, 2)
	return l
end

-- Rangée de livres sur une étagère (bas = y), de x0 à x1
local function books(kit, parent, x0, x1, y, maxH, seed, z)
	local colors = { rgb(176, 64, 64), rgb(60, 96, 150), rgb(220, 190, 120), rgb(70, 120, 90), rgb(120, 80, 140), rgb(236, 226, 206), rgb(200, 120, 70) }
	local x = x0
	local n = seed
	while x < x1 - 3 do
		n += 1
		local w = 3 + (n * 7) % 3
		local h = maxH * (0.7 + ((n * 13) % 5) * 0.07)
		if x + w > x1 then
			break
		end
		if n % 9 == 0 then
			-- un livre penché
			kit.Part(parent, x + 1, y - h + 2, w, h - 1, colors[(n % #colors) + 1], { Radius = 1, Z = z, Rotation = 14, Thickness = 1, Shade = false })
			x += w + 3
		else
			kit.Part(parent, x, y - h, w, h, colors[(n % #colors) + 1], { Radius = 1, Z = z, Thickness = 1, Shade = 0.18 })
			x += w + 0.6
		end
	end
end

-- Écran lumineux (néons gamer)
local function glowScreen(kit, parent, x, y, w, h, top, bottom, z)
	local s = kit.Part(parent, x, y, w, h, top, { Radius = 2, Z = z, Outline = IRON_DARK, Thickness = 1.4, Shade = false })
	kit.Gradient(s, WHITE, kit.Lighten(bottom, 0.1), 90)
	s.BackgroundColor3 = top
	return s
end

----------------------------------------------------------------------
-- 🛋️ Moderne / minimaliste / loft
----------------------------------------------------------------------

-- Chaise blanche (vue de face) : dessus d'assise en y = 56
Art.SimpleChair = function(body, kit, _item)
	for _, x in ipairs({ 26, 74 }) do
		leg(kit, body, x, 58, 100, 5, OAK, 1)
	end
	kit.Line(body, 30, 84, 70, 84, 3, OAK_DARK, 0, 1)
	kit.Part(body, 26, 8, 48, 30, WHITE, { Radius = 12, Z = 2, Shine = true })
	for _, x in ipairs({ 32, 68 }) do
		leg(kit, body, x, 34, 56, 4, OAK, 1)
	end
	kit.Part(body, 18, 52, 64, 10, rgb(248, 248, 246), { Radius = 5, Z = 3, Shine = true })
	return nil
end

-- Portemanteau sur pied (manteau, écharpe, chapeau)
Art.CoatRack = function(body, kit, _item)
	kit.Blob(body, 50, 97, 40, 7, WALNUT_DARK, { Z = 1 })
	for _, dx in ipairs({ -16, 16 }) do
		kit.Line(body, 50, 86, 50 + dx, 98, 3, WALNUT, 0, 1)
	end
	leg(kit, body, 50, 10, 94, 5, WALNUT, 2)
	for _, dx in ipairs({ -1, 1 }) do
		kit.Line(body, 50, 16, 50 + dx * 12, 10, 3, WALNUT, 0, 3)
		kit.Circle(body, 50 + dx * 12, 10, 5, 5, OAK, 0, 4)
	end
	kit.Circle(body, 50, 8, 7, 7, OAK, 0, 4)
	-- manteau camel
	local coat = kit.Part(body, 32, 14, 22, 50, rgb(196, 150, 96), { Radius = 6, Z = 5, Shine = true })
	kit.Line(coat, 11, 2, 11, 48, 1.2, rgb(150, 110, 70), 0.2, 2)
	for i = 0, 2 do
		kit.Circle(coat, 14, 16 + i * 10, 2.4, 2.4, WALNUT_DARK, 0, 3)
	end
	-- écharpe rayée + chapeau
	local scarf = kit.Part(body, 54, 14, 8, 36, rgb(200, 60, 70), { Radius = 3, Z = 6 })
	for i = 0, 3 do
		kit.Box(scarf, 0, 5 + i * 8, 8, 2, WHITE, 0.2, 2)
	end
	kit.Blob(body, 66, 16, 24, 6, rgb(60, 60, 72), { Z = 6 })
	kit.Part(body, 59, 4, 14, 12, rgb(60, 60, 72), { Radius = 5, Z = 7, Shine = true })
	kit.Box(body, 59, 11, 14, 2.5, rgb(170, 60, 60), 0, 8)
	return nil
end

-- Table d'appoint tonneau (métal peint, cerclages) : dessus en y = 30
Art.BarrelTable = function(body, kit, _item)
	local drum = kit.Part(body, 16, 32, 68, 66, rgb(48, 96, 120), { Radius = 10, Z = 1, Shine = true })
	kit.Gradient(drum, WHITE, rgb(170, 180, 190), 0)
	for _, y in ipairs({ 8, 30, 52 }) do
		kit.Box(drum, 0, y, 68, 3, rgb(34, 70, 90), 0, 2)
	end
	kit.Text(drum, "DOPA", 34, 42, 10, rgb(240, 220, 170), 3)
	kit.Part(body, 12, 26, 76, 8, OAK, { Radius = 4, Z = 2, Shine = true })
	return nil
end

-- Tabouret de bar moderne (pied tulipe, assise cuir) : dessus en y = 30
Art.ModernBarStool = function(body, kit, _item)
	kit.Blob(body, 50, 96, 40, 8, STEEL_DARK, { Z = 1, Shine = true })
	leg(kit, body, 50, 36, 94, 6, STEEL, 2)
	kit.Blob(body, 50, 70, 30, 5, STEEL, { Z = 3 })
	kit.Part(body, 36, 34, 28, 5, STEEL_DARK, { Radius = 2, Z = 3 })
	kit.Part(body, 28, 8, 44, 14, LEATHER, { Radius = 7, Z = 3, Shine = true })
	kit.Part(body, 26, 24, 48, 10, LEATHER, { Radius = 5, Z = 4, Shine = true })
	return nil
end

-- Bureau minimaliste en chêne (pieds épingles, tiroir fin) : dessus en y = 42
Art.OakDesk = function(body, kit, _item)
	for _, x in ipairs({ 8, 92 }) do
		kit.Line(body, x, 46, x - (x < 50 and -3 or 3), 99, 3, IRON, 0, 1)
		kit.Line(body, x + (x < 50 and 8 or -8), 46, x - (x < 50 and -3 or 3), 99, 3, IRON, 0, 1)
	end
	local drawer = kit.Part(body, 52, 46, 36, 9, OAK_DARK, { Radius = 2, Z = 2 })
	kit.Box(drawer, 13, 4, 10, 1.6, IRON_DARK, 0, 2)
	kit.Part(body, 1, 40, 98, 7, OAK, { Radius = 3, Z = 3, Shine = true })
	kit.Box(body, 6, 41.5, 60, 1.2, WHITE, 0.55, 4)
	return nil
end

-- Meuble média en noyer (portes cannées, pieds compas) : dessus en y = 60
Art.MediaConsole = function(body, kit, _item)
	for _, x in ipairs({ 10, 90 }) do
		kit.Line(body, x, 88, x + (x < 50 and -4 or 4), 99, 3, WALNUT_DARK, 0, 1)
	end
	local case = kit.Part(body, 2, 60, 96, 30, WALNUT, { Radius = 4, Z = 2, Shine = true })
	for index = 0, 2 do
		local door = kit.Part(case, 3 + index * 30.6, 3, 29, 24, kit.Lighten(WALNUT, 0.08), { Radius = 2, Z = 2, Thickness = 1.2 })
		-- cannage (lignes croisées)
		for k = 0, 4 do
			kit.Box(door, 3, 3 + k * 4.4, 23, 1, rgb(214, 186, 140), 0.35, 2)
		end
		kit.Box(door, index == 1 and 25 or 2, 9, 1.8, 6, rgb(210, 180, 110), 0, 3)
	end
	kit.Part(body, 1, 57, 98, 5, WALNUT_DARK, { Radius = 2, Z = 3 })
	return nil
end

-- Table basse en verre (plateau fumé, piètement acier) : dessus en y = 62
Art.GlassCoffeeTable = function(body, kit, _item)
	for _, x in ipairs({ 10, 90 }) do
		kit.Part(body, x - 3, 64, 6, 34, STEEL, { Radius = 2, Z = 1, Shine = true })
	end
	kit.Part(body, 8, 94, 84, 4, STEEL_DARK, { Radius = 2, Z = 1 })
	local shelf = kit.Part(body, 10, 80, 80, 4, GLASS, { Radius = 2, Z = 2, T = 0.35 })
	local _ = shelf
	-- livres + plateau décoratif sur l'étagère du bas
	kit.Part(body, 22, 74, 20, 6, rgb(60, 96, 150), { Radius = 1, Z = 3 })
	kit.Part(body, 24, 70, 16, 4, rgb(236, 226, 206), { Radius = 1, Z = 4 })
	local top = kit.Part(body, 1, 60, 98, 6, rgb(170, 214, 228), { Radius = 3, Z = 4, T = 0.2, Shine = true })
	kit.Box(top, 6, 1, 50, 1.2, WHITE, 0.3, 2)
	return nil
end

-- Étagère industrielle en tubes noirs + planches brutes (4 niveaux)
Art.LoftShelf = function(body, kit, _item)
	for _, x in ipairs({ 8, 92 }) do
		kit.Part(body, x - 2.5, 4, 5, 96, IRON_DARK, { Radius = 2, Z = 3, Shine = true })
		for _, y in ipairs({ 8, 34, 60, 86 }) do
			kit.Circle(body, x, y + 3, 7, 7, IRON, 0, 4)
		end
	end
	for index, y in ipairs({ 8, 34, 60, 86 }) do
		local plank = kit.Part(body, 4, y, 92, 6, rgb(176, 130, 88), { Radius = 1, Z = 2, Shine = true })
		kit.Box(plank, 20, 2.5, 30, 0.8, WALNUT, 0.5, 2)
		kit.Box(plank, 60, 1.6, 22, 0.8, WALNUT, 0.5, 2)
		if index == 2 then
			books(kit, body, 14, 50, 34, 20, 3, 1)
			kit.Part(body, 62, 22, 14, 12, TERRACOTTA, { Radius = 4, Z = 1 })
			leaf(kit, body, 66, 16, 8, 12, LEAF, -20, 1)
			leaf(kit, body, 72, 15, 8, 12, LEAF_DARK, 20, 1)
		elseif index == 3 then
			kit.Part(body, 16, 46, 22, 14, rgb(120, 118, 114), { Radius = 3, Z = 1 }) -- boîte en métal
			books(kit, body, 46, 86, 60, 20, 11, 1)
		elseif index == 4 then
			kit.Part(body, 20, 72, 26, 14, rgb(200, 170, 120), { Radius = 3, Z = 1 }) -- panier
			kit.Box(body, 22, 76, 22, 1.2, rgb(160, 120, 80), 0, 2)
			kit.Circle(body, 70, 80, 14, 12, rgb(90, 90, 96), 0, 1) -- globe industriel
		end
	end
	return nil
end

-- Lit plateforme bas (vue de profil, tête de lit capitonnée) : dessus y = 70
Art.PlatformBed = function(body, kit, _item)
	kit.Part(body, 2, 36, 12, 52, GREIGE, { Radius = 5, Z = 1, Shine = true })
	for k = 0, 2 do
		kit.Box(body, 4, 42 + k * 14, 8, 1.2, kit.Darken(GREIGE, 0.2), 0, 2)
	end
	kit.Part(body, 4, 84, 94, 12, OAK, { Radius = 3, Z = 2, Shine = true })
	kit.Box(body, 10, 96, 84, 3, OAK_DARK, 0, 1)
	kit.Part(body, 8, 72, 88, 14, WHITE, { Radius = 5, Z = 3 })
	local duvet = kit.Part(body, 36, 68, 62, 18, rgb(124, 140, 150), { Radius = 6, Z = 4, Shine = true })
	kit.Box(duvet, 0, 2, 10, 14, rgb(210, 214, 216), 0, 2)
	kit.Blob(body, 24, 68, 22, 12, WHITE, { Z = 5, Shine = true })
	kit.Blob(body, 26, 64, 16, 10, rgb(214, 196, 170), { Z = 6 })
	return nil
end

-- Table d'atelier loft (plateau massif, tréteaux acier, étau) : dessus y = 40
Art.Workbench = function(body, kit, _item)
	for _, x in ipairs({ 14, 86 }) do
		kit.Line(body, x - 8, 99, x, 44, 4, IRON, 0, 1)
		kit.Line(body, x + 8, 99, x, 44, 4, IRON, 0, 1)
	end
	kit.Part(body, 8, 76, 84, 5, IRON_DARK, { Radius = 2, Z = 2 })
	-- caisse à outils sur la barre
	kit.Part(body, 60, 64, 22, 12, RED, { Radius = 3, Z = 3, Shine = true })
	kit.Part(body, 66, 60, 10, 5, IRON, { Radius = 2, Z = 2 })
	local top = kit.Part(body, 1, 38, 98, 9, rgb(186, 140, 94), { Radius = 2, Z = 4, Shine = true })
	for k = 1, 5 do
		kit.Box(top, k * 16, 0, 0.8, 9, rgb(150, 106, 70), 0.3, 2)
	end
	return nil
end

-- Canapé d'angle moderne (tissu gris chiné, pieds bois) : dessus y = 64
Art.SectionalSofa = function(body, kit, _item)
	local fabric = rgb(150, 156, 164)
	for _, x in ipairs({ 8, 50, 92 }) do
		kit.Part(body, x - 2, 92, 4, 8, WALNUT, { Radius = 1, Z = 1 })
	end
	kit.Part(body, 2, 36, 96, 34, kit.Darken(fabric, 0.1), { Radius = 8, Z = 2 })
	-- dossiers (3 coussins)
	for index = 0, 2 do
		kit.Part(body, 6 + index * 30, 30, 30, 32, fabric, { Radius = 9, Z = 3, Shine = true })
	end
	-- méridienne à droite (plus avancée)
	kit.Part(body, 2, 62, 96, 30, kit.Darken(fabric, 0.05), { Radius = 8, Z = 4 })
	for index = 0, 2 do
		kit.Part(body, 6 + index * 30, 60, 30, 12, kit.Lighten(fabric, 0.08), { Radius = 6, Z = 5, Shine = true })
	end
	kit.Part(body, 66, 64, 32, 28, fabric, { Radius = 8, Z = 6, Shine = true })
	-- coussins déco
	kit.Part(body, 10, 44, 18, 16, rgb(214, 170, 90), { Radius = 5, Z = 6, Rotation = -8 })
	kit.Part(body, 26, 46, 16, 14, LINEN, { Radius = 5, Z = 6, Rotation = 6 })
	return nil
end

-- Canapé Chesterfield (cuir, capitons, accoudoirs roulés) : dessus y = 62
Art.Chesterfield = function(body, kit, _item)
	for _, x in ipairs({ 10, 90 }) do
		kit.Circle(body, x, 95, 6, 8, WALNUT_DARK, 0, 1)
	end
	local back = kit.Part(body, 8, 26, 84, 40, LEATHER, { Radius = 10, Z = 2, Shine = true })
	for row = 0, 2 do
		for col = 0, 6 do
			kit.Circle(back, 8 + col * 11.5 + (row % 2) * 5.5, 8 + row * 10, 2.4, 2.4, LEATHER_DARK, 0, 2)
		end
	end
	kit.Part(body, 10, 60, 80, 32, LEATHER_DARK, { Radius = 8, Z = 3 })
	kit.Part(body, 12, 58, 38, 14, LEATHER, { Radius = 6, Z = 4, Shine = true })
	kit.Part(body, 50, 58, 38, 14, LEATHER, { Radius = 6, Z = 4, Shine = true })
	for _, x in ipairs({ 2, 82 }) do
		local arm = kit.Part(body, x, 42, 16, 50, LEATHER, { Radius = 8, Z = 5, Shine = true })
		kit.Blob(arm, 8, 7, 18, 14, kit.Lighten(LEATHER, 0.1), { Z = 2 })
		for k = 0, 3 do
			kit.Circle(arm, 8, 18 + k * 8, 2, 2, LEATHER_DARK, 0, 3)
		end
	end
	return nil
end

-- Mur de bibliothèque (noyer, 4 niveaux, échelle) : dessus + 3 rayons
Art.BookshelfWall = function(body, kit, _item)
	local frame = kit.Part(body, 2, 2, 96, 98, WALNUT, { Radius = 3, Z = 1, Shine = true })
	kit.Box(frame, 4, 4, 88, 90, WALNUT_DARK, 0, 2)
	for _, y in ipairs({ 28, 52, 76 }) do
		kit.Part(body, 4, y, 92, 4, WALNUT, { Radius = 1, Z = 3 })
	end
	kit.Part(body, 48, 6, 4, 92, WALNUT, { Radius = 1, Z = 3 })
	books(kit, body, 7, 46, 28, 20, 1, 4)
	books(kit, body, 55, 94, 28, 20, 5, 4)
	books(kit, body, 7, 34, 52, 19, 9, 4)
	kit.Blob(body, 40, 48, 8, 8, rgb(230, 200, 120), { Z = 4 }) -- globe doré
	books(kit, body, 55, 94, 52, 19, 2, 4)
	books(kit, body, 7, 46, 76, 20, 6, 4)
	books(kit, body, 55, 80, 76, 20, 4, 4)
	kit.Part(body, 82, 66, 10, 10, CERAMIC, { Radius = 4, Z = 4 })
	books(kit, body, 7, 46, 97, 18, 8, 4)
	books(kit, body, 55, 94, 97, 18, 12, 4)
	-- échelle de bibliothèque sur son rail
	kit.Box(body, 4, 8, 92, 2, rgb(210, 180, 110), 0, 5)
	for _, dx in ipairs({ 0, 12 }) do
		kit.Line(body, 62 + dx, 8, 70 + dx, 100, 2.4, rgb(210, 180, 110), 0, 6)
	end
	for k = 1, 6 do
		local t = k / 7
		kit.Line(body, 62 + 8 * t, 8 + 92 * t, 74 + 8 * t, 8 + 92 * t, 2, rgb(210, 180, 110), 0, 6)
	end
	return nil
end

-- Îlot de cuisine en marbre (plateau veiné, façade bois, tabourets) : dessus y = 40
Art.MarbleIsland = function(body, kit, _item)
	local base = kit.Part(body, 4, 44, 92, 54, rgb(66, 84, 96), { Radius = 3, Z = 1, Shine = true })
	for index = 0, 3 do
		local door = kit.Part(base, 3 + index * 22, 4, 20, 46, rgb(78, 98, 112), { Radius = 2, Z = 2, Thickness = 1.1 })
		kit.Box(door, 8, 4, 4, 1.6, rgb(210, 180, 110), 0, 2)
	end
	local top = kit.Part(body, 1, 38, 98, 8, MARBLE, { Radius = 2, Z = 3, Shine = true })
	kit.Line(top, 10, 2, 40, 6, 1, MARBLE_VEIN, 0.2, 2)
	kit.Line(top, 50, 6, 80, 1, 1, MARBLE_VEIN, 0.3, 2)
	-- corbeille de fruits + planche
	kit.Part(body, 60, 34, 24, 4, OAK, { Radius = 2, Z = 4 })
	for index, c in ipairs({ ORANGE, rgb(120, 190, 80), RED }) do
		kit.Circle(body, 18 + index * 7, 33, 8, 8, c, 0, 4)
	end
	return nil
end


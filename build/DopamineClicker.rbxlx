	bowl.CastShadow = false
	local water = b.Egg(0, 36, 0, 70, 50, 70, rgb(140, 205, 255), M.Glass)
	water.Transparency = 0.45
	water.CastShadow = false
	b.Egg(0, 10, 0, 50, 8, 50, rgb(250, 230, 180), M.Sand)
	b.EggR(CFrame.new(-14, 22, -6) * CFrame.Angles(0, 0, 0.1), 4, 18, 4, rgb(90, 200, 120), M.SmoothPlastic)
	b.Egg(4, 42, 4, 26, 18, 12, fish, M.SmoothPlastic)
	b.EggR(CFrame.new(-12, 42, 4) * CFrame.Angles(0, 0, 0.6), 12, 14, 3, lighten(fish, 0.2), M.SmoothPlastic)
	b.Ball(12, 45, 10, 4, INK, M.SmoothPlastic)
	b.Ball(20, 52, 8, 4, WHITE, M.Glass)
	b.Ball(24, 60, 6, 3, WHITE, M.Glass)
	b.Footprint(80, 80, 82)
end

R.Axolotl = function(b, _ctx)
	local pink = vivid(b, 1, rgb(255, 170, 200))
	local frame = rgb(90, 80, 110)
	b.Round(0, 0, 0, 96, 8, 54, 4, frame, M.SmoothPlastic)
	local glass = b.Box(0, 8, 0, 94, 60, 52, GLASS, M.Glass)
	glass.Transparency = 0.7
	glass.CastShadow = false
	local water = b.Box(0, 8, 0, 90, 52, 48, rgb(120, 200, 230), M.Glass)
	water.Transparency = 0.5
	water.CastShadow = false
	b.Box(0, 8, 0, 90, 5, 48, rgb(240, 220, 180), M.Sand)
	b.Box(0, 68, 0, 98, 4, 56, frame, M.SmoothPlastic)
	for _, x in ipairs({ -30, 32 }) do
		for index = 0, 2 do
			b.EggR(CFrame.new(x + index * 5 - 5, 26, -12) * CFrame.Angles(0, 0, (index - 1) * 0.25), 4, 30, 4, rgb(90, 190, 120), M.SmoothPlastic)
		end
	end
	-- axolotl
	b.Egg(0, 24, 6, 36, 14, 16, pink, M.SmoothPlastic)
	b.Egg(18, 28, 6, 18, 16, 18, pink, M.SmoothPlastic)
	b.EggR(CFrame.new(-22, 24, 6) * CFrame.Angles(0, 0, 0.2), 16, 8, 3, lighten(pink, 0.2), M.SmoothPlastic)
	for _, side in ipairs({ -1, 1 }) do
		for index = 0, 2 do
			b.EggR(CFrame.new(14, 34 + index * 2, 6 + side * (7 + index)) * CFrame.Angles(side * 0.5, 0, 0.4 - index * 0.4), 3, 10, 3, rgb(255, 110, 150), M.SmoothPlastic)
		end
		b.Ball(24, 30, 6 + side * 5, 3, INK, M.SmoothPlastic)
		b.Egg(4 + side * 8, 18, 6 + side * 7, 6, 4, 6, pink, M.SmoothPlastic)
	end
	b.Footprint(98, 56, 72)
end

----------------------------------------------------------------------
-- v9.8 (GARDEN98) 🐾 ANIMAUX RÉALISTES ARTICULÉS
-- Les vrais animaux (catégorie Pets) ne sont plus des peluches assises :
-- de vraies proportions (corps allongé sur 4 pattes, cou, museau, queue),
-- des couleurs de pelage naturelles (golden retriever, chaton calico, chat
-- tigré gris, renard roux aux chaussettes noires, lapin blanc, hérisson,
-- tortue, poussin, caneton, manchot, chouette, bébé dragon), des yeux
-- brillants (globe sombre, iris des chats / de la chouette, reflet).
-- Chaque pièce appartient à une ARTICULATION (nom "J_<articulation>_...") et
-- chaque articulation a un repère invisible "Joint_<articulation>" (pivot) :
-- Client/World/PetRoam anime ces modèles (marche, trot, sauts, dandinement,
-- vol, assis, couché, sieste) sans rien reconstruire. Au repos (maison 2D en
-- 3D, animalerie, pièce), l'animal est simplement debout.
-- Repère des recettes : 100 unités = la boîte 2D, +z = devant.
----------------------------------------------------------------------

-- Nomme une pièce d'après son articulation
local function jn(part: BasePart, joint: string, name: string): BasePart
	part.Name = "J_" .. joint .. "_" .. name
	return part
end

-- Pivot invisible d'une articulation
local function marker(b: Builder, joint: string, x: number, y: number, z: number)
	local p = b.Ball(x, y, z, 1, WHITE, M.SmoothPlastic)
	p.Transparency = 1
	p.CastShadow = false
	p.Name = "Joint_" .. joint
end

-- Œil réaliste : globe sombre brillant (+ iris coloré et pupille), reflet
local function realEye(b: Builder, joint: string, x: number, y: number, z: number, size: number, iris: Color3?, slit: boolean?)
	local globe = b.Ball(x, y, z, size, iris or rgb(34, 24, 20), M.SmoothPlastic)
	globe.Reflectance = 0.15
	jn(globe, joint, "Eye")
	if iris then
		local pupil = b.EggR(CFrame.new(x, y, z + size * 0.36), slit and size * 0.22 or size * 0.55, size * (slit and 0.8 or 0.55), size * 0.3, rgb(16, 12, 12), M.SmoothPlastic)
		jn(pupil, joint, "Eye")
	end
	local shine = b.Ball(x + size * 0.18, y + size * 0.2, z + size * 0.4, size * 0.26, WHITE, M.SmoothPlastic)
	jn(shine, joint, "Eye")
end

export type QuadSpec = {
	L: number, W: number, BH: number, H: number, LegW: number,
	Head: { number }, -- largeur, hauteur, profondeur du crâne
	Snout: { number }, -- longueur, largeur, hauteur du museau
	Neck: number, -- longueur du cou (vers l'avant/le haut)
	Main: Color3, Belly: Color3, Legs: Color3?, Paws: Color3?, Muzzle: Color3?, Nose: Color3,
	Ears: string, EarColor: Color3?, EarIn: Color3?, EarSize: number,
	Tail: string, TailColor: Color3?, TailTip: Color3?, TailLen: number,
	Eye: number, Iris: Color3?, Slit: boolean?,
	Patches: { any }?, Tongue: boolean?, Whiskers: boolean?,
}

-- Quadrupède (chien, chat, renard, dragon...) : renvoie le centre de la tête
local function quad(b: Builder, s: QuadSpec)
	local L, W, BH, H = s.L, s.W, s.BH, s.H
	local bodyY = H - BH / 2
	local legColor = s.Legs or s.Main
	local paws = s.Paws or legColor
	-- tronc : dos, poitrail, arrière-train, ventre clair
	jn(b.Egg(0, bodyY, -L * 0.04, W, BH, L * 0.92, s.Main, M.Fabric), "Body", "Torso")
	jn(b.Egg(0, bodyY + BH * 0.02, L * 0.3, W * 1.02, BH * 1.02, L * 0.42, s.Main, M.Fabric), "Body", "Chest")
	jn(b.Egg(0, bodyY + BH * 0.04, -L * 0.33, W * 0.98, BH * 0.98, L * 0.38, s.Main, M.Fabric), "Body", "Hips")
	jn(b.Egg(0, bodyY - BH * 0.2, L * 0.04, W * 0.78, BH * 0.62, L * 0.7, s.Belly, M.Fabric), "Body", "Belly")
	for index, patch in ipairs(s.Patches or {}) do
		jn(b.Egg(patch[1], patch[2], patch[3], patch[4], patch[5], patch[6], patch[7], M.Fabric), "Body", "Patch" .. index)
	end
	-- pattes : épaule / hanche = pivot ; cuisse, jambe, patte
	local legTop = bodyY - BH * 0.12
	for _, spot in ipairs({ { "LegFL", -1, 1 }, { "LegFR", 1, 1 }, { "LegBL", -1, -1 }, { "LegBR", 1, -1 } }) do
		local joint, sx, sz = spot[1], spot[2], spot[3]
		local x, z = sx * W * 0.3, sz * L * 0.33
		marker(b, joint, x, legTop, z)
		local thigh = sz < 0 and 1.35 or 1.1
		jn(b.Egg(x, legTop - legTop * 0.2, z - sz * s.LegW * 0.1, s.LegW * thigh, legTop * 0.62, s.LegW * thigh * 1.15, sz < 0 and s.Main or legColor, M.Fabric), joint, "Upper")
		jn(b.Tube(x, legTop * 0.6, z, x, s.LegW * 0.45, z + s.LegW * 0.08, s.LegW * 0.74, legColor, M.Fabric), joint, "Lower")
		jn(b.Egg(x, s.LegW * 0.28, z + s.LegW * 0.22, s.LegW * 0.78, s.LegW * 0.56, s.LegW * 1.05, paws, M.Fabric), joint, "Paw")
	end
	-- cou + tête (pivot à la base du cou)
	local neckZ = L * 0.44
	local neckY = bodyY + BH * 0.18
	marker(b, "Head", 0, neckY, neckZ)
	local hw, hh, hd = s.Head[1], s.Head[2], s.Head[3]
	local hx, hy, hz = 0, neckY + s.Neck * 0.75 + hh * 0.2, neckZ + s.Neck * 0.55 + hd * 0.25
	jn(b.Tube(0, neckY - BH * 0.05, neckZ - L * 0.05, hx, hy - hh * 0.2, hz - hd * 0.25, math.min(W, hw) * 0.72, s.Main, M.Fabric), "Head", "Neck")
	jn(b.Egg(hx, hy, hz, hw, hh, hd, s.Main, M.Fabric), "Head", "Skull")
	local sl, sw, sh = s.Snout[1], s.Snout[2], s.Snout[3]
	local muzzle = s.Muzzle or s.Main
	local sy, sz = hy - hh * 0.2, hz + hd * 0.34 + sl * 0.32
	jn(b.Egg(hx, sy, sz, sw, sh, sl + hd * 0.3, muzzle, M.Fabric), "Head", "Snout")
	jn(b.Egg(hx, sy - sh * 0.28, sz - sl * 0.08, sw * 0.8, sh * 0.5, sl + hd * 0.2, s.Belly, M.Fabric), "Head", "Chin")
	local nose = b.EggR(CFrame.new(hx, sy + sh * 0.26, sz + (sl + hd * 0.3) * 0.46), sw * 0.42, sh * 0.34, sh * 0.32, s.Nose, M.SmoothPlastic)
	nose.Reflectance = 0.1
	jn(nose, "Head", "Nose")
	if s.Tongue then
		jn(b.EggR(CFrame.new(hx, sy - sh * 0.46, sz + sl * 0.28) * CFrame.Angles(0.5, 0, 0), sw * 0.34, sh * 0.5, sh * 0.16, rgb(236, 110, 130), M.SmoothPlastic), "Head", "Tongue")
	end
	if s.Whiskers then
		for _, side in ipairs({ -1, 1 }) do
			for _, dy in ipairs({ -1, 1 }) do
				jn(b.BoxR(CFrame.new(hx + side * sw * 0.62, sy + dy * sh * 0.08, sz + sl * 0.2) * CFrame.Angles(0, side * 0.35, dy * side * 0.08), sw * 0.8, 0.5, 0.5, rgb(250, 248, 244)), "Head", "Whisker")
			end
		end
	end
	for _, side in ipairs({ -1, 1 }) do
		realEye(b, "Head", hx + side * hw * 0.24, hy + hh * 0.08, hz + hd * 0.4, s.Eye, s.Iris, s.Slit)
	end
	-- oreilles
	local earColor = s.EarColor or s.Main
	local es = s.EarSize
	for _, side in ipairs({ -1, 1 }) do
		local ex, ey, ez = hx + side * hw * 0.3, hy + hh * 0.42, hz - hd * 0.1
		if s.Ears == "Floppy" then
			jn(b.EggR(CFrame.new(hx + side * hw * 0.48, hy + hh * 0.05, hz - hd * 0.05) * CFrame.Angles(0, 0, side * 0.25), es * 0.38, es, es * 0.24, earColor, M.Fabric), "Head", "Ear")
		elseif s.Ears == "Pointy" then
			local cf = CFrame.new(ex, ey + es * 0.4, ez) * CFrame.Angles(0, 0, -side * 0.22)
			jn(b.Part("WedgePart", cf * CFrame.new(0, 0, -es * 0.12), Vector3.new(es * 0.62, es, es * 0.24), earColor, M.Fabric, "Oreille"), "Head", "Ear")
			jn(b.Part("WedgePart", cf * CFrame.Angles(0, math.pi, 0) * CFrame.new(0, 0, -es * 0.12), Vector3.new(es * 0.62, es, es * 0.24), earColor, M.Fabric, "Oreille"), "Head", "Ear")
			if s.EarIn then
				jn(b.Part("WedgePart", cf * CFrame.new(0, -es * 0.1, es * 0.13) * CFrame.Angles(0, math.pi, 0), Vector3.new(es * 0.36, es * 0.66, 0.6), s.EarIn, M.Fabric, "Oreille"), "Head", "EarIn")
			end
		elseif s.Ears == "Long" then
			local cf = CFrame.new(hx + side * hw * 0.18, hy + hh * 0.4 + es * 0.44, hz - hd * 0.12) * CFrame.Angles(-0.18, 0, -side * 0.12)
			jn(b.EggR(cf, hw * 0.28, es, hw * 0.14, earColor, M.Fabric), "Head", "Ear")
			if s.EarIn then
				jn(b.EggR(cf * CFrame.new(0, -es * 0.02, hw * 0.05), hw * 0.15, es * 0.78, hw * 0.06, s.EarIn, M.Fabric), "Head", "EarIn")
			end
		elseif s.Ears == "Round" then
			jn(b.Egg(ex, ey, ez, es, es, es * 0.5, earColor, M.Fabric), "Head", "Ear")
		end
	end
	-- queue (pivot à la base)
	local tailY, tailZ = bodyY + BH * 0.12, -L * 0.5
	marker(b, "Tail", 0, tailY, tailZ)
	local tc = s.TailColor or s.Main
	local tl = s.TailLen
	if s.Tail == "Wag" then
		jn(b.EggR(CFrame.new(0, tailY + tl * 0.22, tailZ - tl * 0.28) * CFrame.Angles(-0.7, 0, 0), W * 0.3, tl * 0.62, W * 0.3, tc, M.Fabric), "Tail", "Base")
		jn(b.EggR(CFrame.new(0, tailY + tl * 0.62, tailZ - tl * 0.62) * CFrame.Angles(-0.35, 0, 0), W * 0.26, tl * 0.46, W * 0.26, tc, M.Fabric), "Tail", "Tip")
		jn(b.Ball(0, tailY + tl * 0.8, tailZ - tl * 0.72, W * 0.15, s.TailTip or tc, M.Fabric), "Tail", "End")
	elseif s.Tail == "Cat" then
		jn(b.Tube(0, tailY, tailZ, 0, tailY + tl * 0.35, tailZ - tl * 0.42, W * 0.24, tc, M.Fabric), "Tail", "Base")
		jn(b.Tube(0, tailY + tl * 0.35, tailZ - tl * 0.42, 0, tailY + tl * 0.85, tailZ - tl * 0.5, W * 0.22, tc, M.Fabric), "Tail", "Mid")
		jn(b.Tube(0, tailY + tl * 0.85, tailZ - tl * 0.5, 0, tailY + tl * 1.05, tailZ - tl * 0.4, W * 0.2, s.TailTip or tc, M.Fabric), "Tail", "Tip")
	elseif s.Tail == "Bushy" then
		jn(b.EggR(CFrame.new(0, tailY - tl * 0.05, tailZ - tl * 0.42) * CFrame.Angles(-0.9, 0, 0), W * 0.52, tl * 0.9, W * 0.52, tc, M.Fabric), "Tail", "Brush")
		jn(b.EggR(CFrame.new(0, tailY - tl * 0.3, tailZ - tl * 0.8) * CFrame.Angles(-1.1, 0, 0), W * 0.38, tl * 0.32, W * 0.38, s.TailTip or tc, M.Fabric), "Tail", "Tip")
	elseif s.Tail == "Pom" then
		jn(b.Ball(0, tailY, tailZ - W * 0.08, W * 0.42, s.TailTip or WHITE, M.Fabric), "Tail", "Pom")
	elseif s.Tail == "Spiky" then
		jn(b.Tube(0, tailY, tailZ, 0, tailY - tl * 0.25, tailZ - tl * 0.6, W * 0.34, tc, M.SmoothPlastic), "Tail", "Base")
		jn(b.Tube(0, tailY - tl * 0.25, tailZ - tl * 0.6, tl * 0.18, tailY - tl * 0.38, tailZ - tl * 1.05, W * 0.2, tc, M.SmoothPlastic), "Tail", "Tip")
		jn(b.Part("WedgePart", CFrame.new(tl * 0.2, tailY - tl * 0.38, tailZ - tl * 1.12) * CFrame.Angles(0, 0, math.pi / 2), Vector3.new(W * 0.1, W * 0.36, W * 0.36), s.TailTip or tc, M.SmoothPlastic, "Pointe"), "Tail", "Spade")
	elseif s.Tail == "Stub" then
		jn(b.EggR(CFrame.new(0, tailY - BH * 0.1, tailZ - W * 0.05) * CFrame.Angles(-0.6, 0, 0), W * 0.2, W * 0.34, W * 0.2, tc, M.SmoothPlastic), "Tail", "Stub")
	end
	return hx, hy, hz
end

-- Oiseau (poussin, caneton, manchot, chouette) : pattes LegL / LegR, ailes WingL / WingR
local function realBird(b: Builder, kind: string)
	local feather, belly, bill, feet, eyeSize, iris
	local bodyW, bodyH, bodyD, bodyY, headD, headY, headZ, legH
	if kind == "Penguin" then
		feather, belly, bill, feet = rgb(34, 38, 48), rgb(246, 244, 238), rgb(236, 120, 50), rgb(236, 130, 60)
		bodyW, bodyH, bodyD, bodyY = 44, 68, 40, 42
		headD, headY, headZ, legH, eyeSize = 34, 84, 4, 8, 4.4
	elseif kind == "Owl" then
		feather, belly, bill, feet = rgb(150, 110, 72), rgb(226, 206, 170), rgb(90, 80, 70), rgb(200, 170, 100)
		bodyW, bodyH, bodyD, bodyY = 50, 58, 44, 38
		headD, headY, headZ, legH, eyeSize, iris = 46, 76, 2, 10, 12, rgb(250, 170, 40)
	elseif kind == "Duckling" then
		feather, belly, bill, feet = rgb(250, 214, 80), rgb(255, 234, 150), rgb(240, 150, 40), rgb(240, 150, 40)
		bodyW, bodyH, bodyD, bodyY = 46, 40, 56, 30
		headD, headY, headZ, legH, eyeSize = 34, 58, 16, 12, 4.8
	else -- Chick
		feather, belly, bill, feet = rgb(255, 222, 92), rgb(255, 238, 160), rgb(250, 160, 50), rgb(250, 160, 60)
		bodyW, bodyH, bodyD, bodyY = 48, 44, 50, 32
		headD, headY, headZ, legH, eyeSize = 36, 62, 10, 14, 5
	end
	jn(b.Egg(0, bodyY, 0, bodyW, bodyH, bodyD, feather, M.Fabric), "Body", "Body")
	jn(b.Egg(0, bodyY - bodyH * 0.06, bodyD * 0.2, bodyW * 0.7, bodyH * 0.78, bodyD * 0.62, belly, M.Fabric), "Body", "Belly")
	if kind == "Owl" then
		for k = 0, 4 do
			jn(b.Egg((k % 2 - 0.5) * 10, bodyY + 8 - k * 7, bodyD * 0.48, 5, 3, 1.6, rgb(160, 120, 80), M.Fabric), "Body", "Speckle")
		end
	elseif kind == "Duckling" then
		jn(b.EggR(CFrame.new(0, bodyY + 6, -bodyD * 0.45) * CFrame.Angles(0.6, 0, 0), 14, 16, 10, feather, M.Fabric), "Body", "TailTuft")
	end
	-- pattes
	for _, side in ipairs({ -1, 1 }) do
		local joint = side < 0 and "LegL" or "LegR"
		local x = side * bodyW * 0.2
		marker(b, joint, x, legH + 4, 0)
		jn(b.Tube(x, legH + 4, 0, x, 2, bodyD * 0.04, kind == "Owl" and 5 or 3, feet, M.SmoothPlastic), joint, "Shin")
		jn(b.Egg(x, 1.6, bodyD * 0.12, kind == "Penguin" and 14 or 10, 3, kind == "Penguin" and 18 or 13, feet, M.SmoothPlastic), joint, "Foot")
	end
	-- ailes / ailerons
	for _, side in ipairs({ -1, 1 }) do
		local joint = side < 0 and "WingL" or "WingR"
		local x = side * bodyW * 0.46
		marker(b, joint, x, bodyY + bodyH * 0.22, bodyD * 0.05)
		local wing = kind == "Penguin" and feather or feather:Lerp(rgb(0, 0, 0), kind == "Owl" and 0.15 or 0.05)
		jn(b.EggR(CFrame.new(x, bodyY - bodyH * 0.02, -bodyD * 0.05) * CFrame.Angles(0.25, 0, side * 0.12), bodyW * 0.18, bodyH * (kind == "Penguin" and 0.66 or 0.56), bodyD * 0.62, wing, M.Fabric), joint, "Wing")
	end
	-- tête
	marker(b, "Head", 0, headY - headD * 0.35, headZ)
	jn(b.Ball(0, headY, headZ, headD, feather, M.Fabric), "Head", "Head")
	if kind == "Penguin" then
		jn(b.Egg(0, headY - 4, headZ + 8, headD * 0.72, headD * 0.6, headD * 0.5, belly, M.Fabric), "Head", "Face")
		for _, side in ipairs({ -1, 1 }) do
			jn(b.Egg(side * headD * 0.36, headY - 10, headZ + 2, 8, 6, 12, rgb(250, 200, 70), M.Fabric), "Head", "Patch")
		end
	elseif kind == "Owl" then
		for _, side in ipairs({ -1, 1 }) do
			jn(b.Egg(side * headD * 0.2, headY, headZ + headD * 0.36, headD * 0.44, headD * 0.46, 6, belly, M.Fabric), "Head", "Disc")
			jn(b.Part("WedgePart", CFrame.new(side * headD * 0.32, headY + headD * 0.5, headZ - 2) * CFrame.Angles(0, 0, -side * 0.3), Vector3.new(8, 13, 7), feather:Lerp(rgb(0, 0, 0), 0.2), M.Fabric, "Aigrette"), "Head", "Tuft")
		end
	end
	local eyeZ = headZ + headD * (kind == "Owl" and 0.42 or 0.36)
	local eyeX = headD * (kind == "Owl" and 0.2 or 0.26)
	for _, side in ipairs({ -1, 1 }) do
		realEye(b, "Head", side * eyeX, headY + (kind == "Owl" and 0 or 3), eyeZ, eyeSize, iris, false)
	end
	if kind == "Duckling" then
		jn(b.Egg(0, headY - 4, headZ + headD * 0.5 + 5, 13, 5, 16, bill, M.SmoothPlastic), "Head", "Bill")
	elseif kind == "Owl" then
		jn(b.Part("WedgePart", CFrame.new(0, headY - 6, headZ + headD * 0.5) * CFrame.Angles(-math.pi / 2, 0, 0), Vector3.new(5, 5, 7), bill, M.SmoothPlastic, "Bec"), "Head", "Beak")
	else
		jn(b.Part("WedgePart", CFrame.new(0, headY - 3, headZ + headD * 0.5 + (kind == "Penguin" and 5 or 2)) * CFrame.Angles(-math.pi / 2, 0, 0), Vector3.new(7, kind == "Penguin" and 12 or 7, 5), bill, M.SmoothPlastic, "Bec"), "Head", "Beak")
	end
	if kind == "Chick" then
		for index = -1, 1 do
			jn(b.EggR(CFrame.new(index * 3, headY + headD * 0.5, headZ) * CFrame.Angles(0, 0, index * 0.4), 3, 9, 3, feather, M.Fabric), "Head", "Fluff")
		end
	end
	-- (queue fixe au corps : pas d'articulation, mais un pivot pour l'animation)
	marker(b, "Tail", 0, bodyY, -bodyD * 0.45)
end

-- Espèces : tables de proportions (unités de la boîte 2D) et pelages naturels
local REAL: { [string]: (b: Builder) -> () } = {}

REAL.Puppy = function(b)
	-- golden retriever : doré, museau et poitrail plus clairs, oreilles tombantes
	local gold = rgb(212, 158, 88)
	local cream = rgb(240, 214, 170)
	quad(b, {
		L = 60, W = 28, BH = 28, H = 56, LegW = 12, Head = { 28, 26, 30 }, Snout = { 20, 16, 14 }, Neck = 16,
		Main = gold, Belly = cream, Legs = gold, Muzzle = rgb(226, 182, 120), Nose = rgb(40, 30, 28),
		Ears = "Floppy", EarColor = rgb(184, 124, 64), EarSize = 20, Tail = "Wag", TailColor = gold, TailTip = cream, TailLen = 34,
		Eye = 5.4, Tongue = true,
	})
	-- collier + médaille
	jn(b.Egg(0, 62, 30, 22, 5, 20, rgb(214, 50, 70), M.Fabric), "Head", "Collar")
	jn(b.Ball(0, 58, 40, 5, GOLD, M.Metal), "Head", "Tag")
	b.Footprint(44, 100, 92)
end

REAL.Kitten = function(b)
	-- chaton calico : blanc, taches rousses et noires
	local white = rgb(246, 242, 236)
	quad(b, {
		L = 58, W = 22, BH = 24, H = 44, LegW = 9, Head = { 28, 25, 26 }, Snout = { 7, 12, 9 }, Neck = 10,
		Main = white, Belly = rgb(252, 250, 246), Legs = white, Muzzle = white, Nose = rgb(236, 140, 150),
		Ears = "Pointy", EarColor = rgb(230, 140, 60), EarIn = rgb(250, 196, 200), EarSize = 13, Tail = "Cat", TailColor = rgb(230, 140, 60), TailTip = rgb(50, 40, 40), TailLen = 40,
		Eye = 6.2, Iris = rgb(150, 190, 70), Slit = true, Whiskers = true,
		Patches = { { -5, 39.2, -8, 16, 10.8, 24, rgb(230, 140, 60) }, { 6, 39.2, 12, 12, 10.8, 16, rgb(52, 44, 44) }, { 0, 39.2, -22, 16, 10.8, 16, rgb(52, 44, 44) } },
	})
	b.Footprint(36, 96, 84)
end

REAL.SleepyCat = function(b)
	-- chat tigré gris : rayures foncées, ventre crème, yeux ambrés
	local grey = rgb(150, 148, 150)
	local stripe = rgb(96, 92, 96)
	quad(b, {
		L = 62, W = 24, BH = 26, H = 46, LegW = 9.5, Head = { 29, 26, 27 }, Snout = { 7, 12, 9 }, Neck = 10,
		Main = grey, Belly = rgb(236, 230, 220), Legs = grey, Muzzle = rgb(226, 222, 216), Nose = rgb(220, 130, 140),
		Ears = "Pointy", EarColor = grey, EarIn = rgb(240, 196, 200), EarSize = 13, Tail = "Cat", TailColor = grey, TailTip = stripe, TailLen = 42,
		Eye = 6.4, Iris = rgb(230, 170, 60), Slit = true, Whiskers = true,
		Patches = { { 0, 40.8, 8, 19, 11.7, 5, stripe }, { 0, 40.8, -4, 19.4, 11.7, 5, stripe }, { 0, 40.8, -16, 19, 11.7, 5, stripe } },
	})
	b.Footprint(38, 100, 86)
end

REAL.Fox = function(b)
	-- renard roux : poitrail et bout de queue blancs, chaussettes noires
	local red = rgb(214, 104, 44)
	local white = rgb(248, 244, 236)
	quad(b, {
		L = 62, W = 22, BH = 24, H = 48, LegW = 8.5, Head = { 26, 22, 26 }, Snout = { 20, 12, 10 }, Neck = 14,
		Main = red, Belly = white, Legs = red, Paws = rgb(44, 34, 32), Muzzle = white, Nose = rgb(30, 24, 24),
		Ears = "Pointy", EarColor = rgb(60, 40, 34), EarIn = white, EarSize = 18, Tail = "Bushy", TailColor = red, TailTip = white, TailLen = 46,
		Eye = 5, Iris = rgb(200, 150, 40), Slit = true,
		Patches = { { 0, 34, 20, 14, 18, 16, white } },
	})
	b.Footprint(40, 110, 90)
end

REAL.Bunny = function(b)
	-- lapin blanc aux yeux sombres, intérieur des oreilles rose
	local fur = rgb(246, 244, 240)
	quad(b, {
		L = 50, W = 34, BH = 36, H = 44, LegW = 11, Head = { 30, 28, 28 }, Snout = { 6, 16, 12 }, Neck = 6,
		Main = fur, Belly = rgb(252, 250, 248), Legs = fur, Muzzle = fur, Nose = rgb(240, 150, 160),
		Ears = "Long", EarColor = fur, EarIn = rgb(250, 190, 196), EarSize = 42, Tail = "Pom", TailTip = WHITE, TailLen = 8,
		Eye = 6, Whiskers = true,
	})
	-- grosses cuisses arrière
	for _, side in ipairs({ -1, 1 }) do
		jn(b.Egg(side * 13, 20, -14, 12, 22, 24, fur, M.Fabric), side < 0 and "LegBL" or "LegBR", "Haunch")
	end
	b.Footprint(40, 80, 90)
end

REAL.Hedgehog = function(b)
	local spines = rgb(112, 86, 66)
	local face = rgb(232, 210, 178)
	quad(b, {
		L = 54, W = 40, BH = 30, H = 34, LegW = 8, Head = { 22, 20, 22 }, Snout = { 14, 10, 8 }, Neck = 4,
		Main = face, Belly = face, Legs = rgb(200, 170, 140), Muzzle = face, Nose = rgb(30, 24, 24),
		Ears = "Round", EarColor = rgb(210, 180, 150), EarSize = 7, Tail = "Stub", TailColor = face, TailLen = 4,
		Eye = 4.4,
	})
	-- manteau de piquants
	jn(b.Egg(0, 26, -6, 44, 32, 58, spines, M.Fabric), "Body", "Coat")
	for row = 0, 3 do
		for k = 0, 6 do
			local a = (k / 6 - 0.5) * 2.6
			local y = 30 + math.cos(a) * 12 - row * 2
			local z = 10 - row * 11
			jn(b.Part("WedgePart", CFrame.new(math.sin(a) * 19, y, z) * CFrame.Angles(-0.9, 0, -a * 0.7), Vector3.new(4, 10, 5), (row + k) % 2 == 0 and rgb(90, 66, 50) or rgb(236, 220, 196), M.Fabric, "Piquant"), "Body", "Spine")
		end
	end
	b.Footprint(50, 80, 56)
end

REAL.Turtle = function(b)
	local shell = rgb(104, 122, 62)
	local skin = rgb(150, 160, 96)
	quad(b, {
		L = 44, W = 34, BH = 16, H = 22, LegW = 11, Head = { 16, 14, 18 }, Snout = { 4, 10, 8 }, Neck = 14,
		Main = skin, Belly = rgb(214, 200, 140), Legs = skin, Muzzle = skin, Nose = rgb(60, 70, 40),
		Ears = "None", EarSize = 0, Tail = "Stub", TailColor = skin, TailLen = 6, Eye = 3.6,
	})
	-- carapace bombée + écailles
	jn(b.Egg(0, 24, -2, 60, 30, 66, shell, M.SmoothPlastic), "Body", "Shell")
	jn(b.Egg(0, 17, -2, 64, 6, 70, rgb(80, 96, 50), M.SmoothPlastic), "Body", "Rim")
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		jn(b.Egg(math.cos(a) * 16, 33, math.sin(a) * 18 - 2, 14, 5, 13, rgb(126, 140, 74), M.SmoothPlastic), "Body", "Scute")
	end
	jn(b.Egg(0, 38.5, -2, 15, 4, 15, rgb(126, 140, 74), M.SmoothPlastic), "Body", "Scute")
	b.Footprint(66, 90, 40)
end

REAL.Dragon = function(b)
	local scale = rgb(126, 88, 196)
	local belly = rgb(250, 212, 140)
	local wing = rgb(200, 150, 240)
	local hx, hy, hz = quad(b, {
		L = 54, W = 28, BH = 28, H = 46, LegW = 11, Head = { 28, 24, 30 }, Snout = { 18, 16, 12 }, Neck = 18,
		Main = scale, Belly = belly, Legs = scale, Paws = rgb(96, 64, 150), Muzzle = scale, Nose = rgb(70, 40, 110),
		Ears = "None", EarSize = 0, Tail = "Spiky", TailColor = scale, TailTip = wing, TailLen = 46,
		Eye = 6, Iris = rgb(250, 190, 40), Slit = true,
	})
	for _, side in ipairs({ -1, 1 }) do
		jn(b.Tube(hx + side * 7, hy + 10, hz - 8, hx + side * 11, hy + 22, hz - 16, 5, belly, M.SmoothPlastic), "Head", "Horn")
		-- ailes (voiles) sur les épaules
		local joint = side < 0 and "WingL" or "WingR"
		marker(b, joint, side * 10, 52, 12)
		jn(b.Tube(side * 10, 52, 12, side * 34, 70, 0, 3.5, scale, M.SmoothPlastic), joint, "Bone")
		jn(b.Part("WedgePart", CFrame.new(side * 22, 58, 2) * CFrame.Angles(0.15, side * -0.35, side * -0.7), Vector3.new(1.6, 26, 24), wing, M.SmoothPlastic, "Aile"), joint, "Sail")
	end
	for index = 0, 3 do
		jn(b.Part("WedgePart", CFrame.new(0, 60 - index * 2, 16 - index * 12), Vector3.new(2.5, 7, 7), wing, M.SmoothPlastic, "Plaque"), "Body", "Plate")
	end
	b.Footprint(56, 110, 100)
end

REAL.Chick = function(b)
	realBird(b, "Chick")
	b.Footprint(56, 60, 82)
end
REAL.Duckling = function(b)
	realBird(b, "Duckling")
	b.Footprint(52, 72, 76)
end
REAL.Penguin = function(b)
	realBird(b, "Penguin")
	b.Footprint(56, 52, 100)
end
REAL.Owl = function(b)
	realBird(b, "Owl")
	b.Footprint(58, 54, 100)
end

-- Espèces qui se promènent (PetRoam) : même liste que les recettes réalistes
House3DCritters.ROAMERS = {}
for id in pairs(REAL) do
	House3DCritters.ROAMERS[id] = true
end

-- (les animaux réalistes remplacent les anciennes figurines assises ; les
-- peluches gardent leur style)
for id, build in pairs(REAL) do
	R[id] = function(b: Builder, _ctx: any)
		build(b)
	end
end

----------------------------------------------------------------------
-- Branchement
----------------------------------------------------------------------

-- Animaux qui respirent (pas les bocaux / la roue)
local PETS = { "Chick", "SleepyCat", "Turtle", "Puppy", "Bunny", "Parrot", "Fox", "Dragon", "Kitten", "Hedgehog", "Duckling", "Penguin", "Owl" }

function House3DCritters.Register(recipes: { [string]: any }, _family: { [string]: any }, _helpers: any, flags: any)
	for id, recipe in pairs(R) do
		recipes[id] = recipe
	end
	for _, id in ipairs(PETS) do
		flags.Pets[id] = true
	end
end

return House3DCritters
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="42">
            <Properties>
              <string name="Name">House3DFloor</string>
              <string name="Source"><![CDATA[--[[
	House3DFloor (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > House3DFloor

	Motifs des sols de la vue 3D (House3D), dessinés À PLAT (vue de dessus) :
	dans la pièce 2D, HousePatterns dessine le sol déjà en perspective (les
	rangées grandissent vers l'avant) ; posé sur un vrai sol 3D, ce dessin
	aurait une double perspective. On reprend donc les mêmes motifs et les
	mêmes couleurs (A / B du style), mais en grille régulière : c'est la
	caméra 3D qui fait la perspective.
	  Motifs : Plain, Checker, Wood, Tiles, Carpet, Marble, Herringbone
	  (+ v9.1 : Terrazzo, Mosaic, Grass, Clouds, Starry ; v9.2 : Concrete,
	  Court, Turf, TreadPlate, Road, Lava ; motif inconnu = uni).
	  + la pelouse du socle (herbe, touffes et petites fleurs, comme la
	    pelouse sous la maison en 2D).
	Uniquement des Frames (comme HousePatterns) ; `container` doit couper
	son contenu (ClipsDescendants). Coordonnées en px de maquette.

	API :
	  House3DFloor.Paint(container, largeur, profondeur, style, unit?)
	  House3DFloor.Lawn(container, largeur, profondeur, bordure)
]]

local HousePatterns = require(script.Parent.HousePatterns)

local House3DFloor = {}

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local Box = HousePatterns.Box
local Circle = HousePatterns.Circle
local Round = HousePatterns.Round

type Style = { Pattern: string, A: Color3, B: Color3 }
type Painter = (holder: Frame, w: number, h: number, a: Color3, b: Color3, u: number) -> ()

-- Pseudo-aléatoire stable (même dessin à chaque ouverture)
local function noise(a: number, b: number): number
	local value = math.sin(a * 12.9898 + b * 78.233) * 43758.5453
	return value - math.floor(value)
end

local FLOOR: { [string]: Painter } = {}
local FLOWERS_3D = {
	Color3.fromRGB(255, 126, 182),
	Color3.fromRGB(255, 226, 130),
	WHITE,
	Color3.fromRGB(183, 148, 246),
}

-- Uni : grandes bandes douces + quelques reflets
FLOOR.Plain = function(holder, w, h, a, b, u)
	local band = 96 * u
	local index = 0
	local y = 0
	while y < h do
		if index % 2 == 1 then
			Box(holder, 0, y, w, band, b, 0.6)
		end
		y += band
		index += 1
	end
	for i = 1, 5 do
		local cx = w * (i / 6) + (noise(i, 2) - 0.5) * 60 * u
		local cy = h * (0.2 + 0.6 * noise(i, 3))
		Circle(holder, cx, cy, 130 * u, 60 * u, a:Lerp(WHITE, 0.6), 0.6)
	end
end

-- Damier (carreaux de 64 px) + léger reflet
FLOOR.Checker = function(holder, w, h, _a, b, u)
	local cell = 64 * u
	local rows = math.ceil(h / cell)
	local cols = math.ceil(w / cell)
	-- (centré : la pièce commence et finit sur des demi-carreaux réguliers)
	local ox = (w - cols * cell) / 2
	for row = 0, rows - 1 do
		for col = 0, cols - 1 do
			if (row + col) % 2 == 0 then
				Box(holder, ox + col * cell, row * cell, cell, cell + 0.5, b)
			end
		end
	end
	Box(holder, 0, 0, w, h * 0.3, WHITE, 0.9)
end

-- Parquet : lames horizontales, joints décalés, nuances et veines
FLOOR.Wood = function(holder, w, h, a, b, u)
	local row = 30 * u
	local seam = b:Lerp(BLACK, 0.2)
	local index = 0
	local y = 0
	while y < h do
		local x = -noise(index, 1) * 200 * u
		local plank = 0
		while x < w do
			local length = (170 + noise(index, plank) * 110) * u
			if (plank + index) % 2 == 0 then
				Box(holder, x, y, length, row, b, 0.5)
			end
			Box(holder, x, y, math.max(1, 2 * u), row, seam, 0.3)
			if noise(plank + 3, index) > 0.55 then
				Box(holder, x + length * 0.2, y + row * 0.45, length * 0.4, math.max(1, 1.2 * u), a:Lerp(b, 0.8), 0.45)
			end
			x += length
			plank += 1
		end
		Box(holder, 0, y, w, math.max(1, 2 * u), seam, 0.3)
		y += row
		index += 1
	end
end

-- Carrelage : joints couleur B, reflets dans quelques carreaux
FLOOR.Tiles = function(holder, w, h, _a, b, u)
	local cell = 70 * u
	local grout = 3 * u
	local x = (w % cell) / 2
	local col = 0
	while x < w do
		local line = Box(holder, x - grout / 2, 0, grout, h, b)
		line.Size = UDim2.new(0, grout, 1, 0)
		x += cell
		col += 1
	end
	local y = 0
	local row = 0
	while y < h do
		Box(holder, 0, y - grout / 2, w, grout, b)
		local cx = (w % cell) / 2
		local index = 0
		while cx < w do
			if (row + index) % 3 == 0 then
				local shine = Box(holder, cx + cell * 0.14, y + cell * 0.14, cell * 0.26, 4 * u, WHITE, 0.45)
				Round(shine)
			end
			cx += cell
			index += 1
		end
		y += cell
		row += 1
	end
end

-- Moquette : bandes douces + petites touffes
FLOOR.Carpet = function(holder, w, h, a, b, u)
	local band = 44 * u
	local index = 0
	local y = 0
	while y < h do
		if index % 2 == 0 then
			Box(holder, 0, y, w, band, b, 0.35)
		else
			local step = 70 * u
			local x = noise(index, 9) * step
			while x < w do
				local size = (5 + 3 * noise(x, index)) * u
				Circle(holder, x, y + band * 0.5, size * 1.8, size, a:Lerp(WHITE, 0.45), 0.35)
				x += step * (0.8 + noise(x, index) * 0.6)
			end
		end
		y += band
		index += 1
	end
end

-- Marbre : grandes dalles + veines fines
FLOOR.Marble = function(holder, w, h, a, b, u)
	local cell = 150 * u
	local vein = b:Lerp(BLACK, 0.12)
	local row = 0
	local y = 0
	while y < h do
		local col = 0
		local x = (w % cell) / 2 - cell
		while x < w do
			if (row + col) % 2 == 0 then
				Box(holder, x, y, cell, cell, b, 0.7)
			end
			Box(holder, x, y, math.max(1, 1.5 * u), cell, vein, 0.45)
			local n = noise(col + 11, row)
			local length = cell * (0.4 + 0.3 * n)
			local line = Box(holder, 0, 0, length, math.max(1, 1.4 * u), vein, 0.35)
			line.AnchorPoint = Vector2.new(0.5, 0.5)
			line.Position = UDim2.fromOffset(x + cell * (0.35 + 0.3 * n), y + cell * (0.3 + 0.4 * noise(row, col)))
			line.Rotation = (n - 0.5) * 70
			x += cell
			col += 1
		end
		Box(holder, 0, y, w, math.max(1, 1.5 * u), vein, 0.45)
		y += cell
		row += 1
	end
	Box(holder, 0, 0, w, h * 0.25, a:Lerp(WHITE, 0.8), 0.6)
end

-- Bâtons rompus : blocs de 2 lames, alternés horizontal / vertical
FLOOR.Herringbone = function(holder, w, h, a, b, u)
	local cell = 52 * u
	local seam = b:Lerp(BLACK, 0.25)
	local alt = a:Lerp(b, 0.55)
	local gap = math.max(1, 1.6 * u)
	local row = 0
	local y = 0
	while y < h do
		local col = 0
		local x = (w % cell) / 2 - cell
		while x < w do
			local horizontal = (row + col) % 2 == 0
			local block = Box(holder, x + gap / 2, y + gap / 2, cell - gap, cell - gap, horizontal and a or alt)
			if horizontal then
				Box(block, 0, (cell - gap) / 2 - gap / 2, cell - gap, gap, seam, 0.3)
			else
				Box(block, (cell - gap) / 2 - gap / 2, 0, gap, cell - gap, seam, 0.3)
			end
			x += cell
			col += 1
		end
		y += cell
		row += 1
	end
end

-- v9.1 : Terrazzo (éclats colorés), Mosaic (petits carreaux), Grass (herbe),
-- Clouds (nuages), Starry (ciel étoilé)
FLOOR.Terrazzo = function(holder, w, h, a, b, u)
	local chips = { b, b:Lerp(WHITE, 0.4), a:Lerp(BLACK, 0.18), Color3.fromRGB(255, 170, 190), Color3.fromRGB(150, 205, 255) }
	local step = 26 * u
	local index = 0
	local y = step / 2
	while y < h do
		local x = step / 2 + noise(index, 1) * step
		while x < w do
			index += 1
			local size = (5 + 7 * noise(index, 2)) * u
			local chip = Box(holder, x, y + (noise(index, 3) - 0.5) * step, size * 1.4, size, chips[index % #chips + 1], 0.1)
			chip.Rotation = noise(index, 4) * 180
			Round(chip, UDim.new(0.35, 0))
			x += step * (0.7 + noise(index, 5) * 0.8)
		end
		y += step
	end
end

FLOOR.Mosaic = function(holder, w, h, a, b, u)
	local cell = 22 * u
	local colors = { a, b, a:Lerp(b, 0.5), b:Lerp(WHITE, 0.35) }
	local row = 0
	local y = 0
	while y < h do
		local col = 0
		local x = 0
		while x < w do
			local color = colors[(row * 3 + col + math.floor(noise(row, col) * 3)) % #colors + 1]
			Box(holder, x + 1 * u, y + 1 * u, cell - 2 * u, cell - 2 * u, color, 0)
			x += cell
			col += 1
		end
		y += cell
		row += 1
	end
end

FLOOR.Grass = function(holder, w, h, a, b, u)
	local step = 34 * u
	local index = 0
	local y = step / 2
	while y < h do
		local x = noise(index, 7) * step
		while x < w do
			index += 1
			Circle(holder, x, y, step * 0.7, step * 0.34, index % 2 == 0 and b or a:Lerp(b, 0.5), 0.25)
			if noise(index, 8) > 0.82 then
				local petal = FLOWERS_3D[index % #FLOWERS_3D + 1]
				Circle(holder, x + step * 0.2, y - step * 0.1, 7 * u, 7 * u, petal, 0, 2)
			end
			x += step * (0.6 + noise(index, 9) * 0.7)
		end
		y += step * 0.7
	end
end

FLOOR.Clouds = function(holder, w, h, a, b, u)
	local step = 150 * u
	local index = 0
	local y = step * 0.4
	while y < h + step * 0.3 do
		local x = (index % 2) * step * 0.5
		while x < w + step * 0.3 do
			index += 1
			HousePatterns.Cloud(holder, x, y, step * (0.55 + noise(index, 1) * 0.25), b, 0.25, 1)
			x += step
		end
		y += step * 0.6
	end
	Box(holder, 0, 0, w, h, a:Lerp(WHITE, 0.6), 0.85)
end

FLOOR.Starry = function(holder, w, h, a, b, u)
	local step = 60 * u
	local index = 0
	local y = step / 2
	while y < h do
		local x = noise(index, 3) * step
		while x < w do
			index += 1
			local size = (8 + 10 * noise(index, 4)) * u
			HousePatterns.Sparkle(holder, x, y + (noise(index, 5) - 0.5) * step * 0.6, size, b, 0.1, 2)
			if noise(index, 6) > 0.6 then
				Circle(holder, x + step * 0.4, y + step * 0.25, 3 * u, 3 * u, a:Lerp(WHITE, 0.7), 0.2, 2)
			end
			x += step * (0.7 + noise(index, 7) * 0.8)
		end
		y += step * 0.8
	end
end

-- v9.2 : sols "sport / gamer" (vus de dessus, la caméra 3D fait la perspective)
-- Anneau (contour seul) centré
local function ring(parent: Instance, cx: number, cy: number, w: number, h: number, color: Color3, thickness: number, z: number?): Frame
	local frame = Box(parent, cx - w / 2, cy - h / 2, w, h, color, 1, z)
	Round(frame)
	local line = Instance.new("UIStroke")
	line.Color = color
	line.Thickness = thickness
	line.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	line.Parent = frame
	return frame
end

-- Béton : grandes dalles, joints, mouchetures, quelques fissures
FLOOR.Concrete = function(holder, w, h, a, b, u)
	local cell = 140 * u
	local seam = b:Lerp(BLACK, 0.15)
	local x = (w % cell) / 2
	while x < w do
		Box(holder, x, 0, math.max(1, 2 * u), h, seam, 0.35)
		x += cell
	end
	local y = cell * 0.6
	while y < h do
		Box(holder, 0, y, w, math.max(1, 2 * u), seam, 0.35)
		y += cell
	end
	for index = 1, math.floor(w * h / (900 * u * u)) do
		local size = (2 + 3 * noise(index, 1)) * u
		Circle(holder, noise(index, 2) * w, noise(index, 3) * h, size, size, index % 3 == 0 and a:Lerp(WHITE, 0.4) or b, 0.45)
	end
	for index = 1, 6 do
		local crack = Box(holder, noise(index, 4) * w, noise(index, 5) * h, (40 + 50 * noise(index, 6)) * u, math.max(1, 1.2 * u), seam, 0.3)
		crack.Rotation = (noise(index, 7) - 0.5) * 120
	end
end

-- Terrain de basket : parquet + lignes blanches (bords, milieu, rond central, raquettes)
FLOOR.Court = function(holder, w, h, a, b, u)
	FLOOR.Wood(holder, w, h, a, a:Lerp(BLACK, 0.08), u)
	local line = math.max(2, 5 * u)
	local m = 24 * u
	local frame = Box(holder, m, m, w - 2 * m, h - 2 * m, b, 1, 3)
	local stroke = Instance.new("UIStroke")
	stroke.Color = b
	stroke.Thickness = line
	stroke.Parent = frame
	Box(holder, w / 2 - line / 2, m, line, h - 2 * m, b, 0, 3)
	ring(holder, w / 2, h / 2, 130 * u, 130 * u, b, line, 3)
	Circle(holder, w / 2, h / 2, 36 * u, 36 * u, Color3.fromRGB(240, 110, 60), 0.1, 3)
	for _, side in ipairs({ -1, 1 }) do
		local keyW, keyH = 150 * u, 150 * u
		local kx = side < 0 and m or w - m - keyW
		Box(holder, kx, h / 2 - keyH / 2, keyW, keyH, Color3.fromRGB(240, 110, 60), 0.55, 2)
		local key = Box(holder, kx, h / 2 - keyH / 2, keyW, keyH, b, 1, 3)
		local keyStroke = Instance.new("UIStroke")
		keyStroke.Color = b
		keyStroke.Thickness = line
		keyStroke.Parent = key
		ring(holder, side < 0 and m + keyW or w - m - keyW, h / 2, 110 * u, 110 * u, b, line, 3)
		ring(holder, side < 0 and m or w - m, h / 2, 520 * u, h * 0.86, b, line, 3)
	end
end

-- Pelouse de foot : bandes de tonte, lignes blanches, rond central
FLOOR.Turf = function(holder, w, h, a, b, u)
	local band = 60 * u
	local x = 0
	local index = 0
	while x < w do
		Box(holder, x, 0, band, h, index % 2 == 0 and b or a:Lerp(WHITE, 0.08), index % 2 == 0 and 0.2 or 0.5)
		x += band
		index += 1
	end
	local white = Color3.fromRGB(250, 252, 255)
	local line = math.max(2, 4 * u)
	local m = 20 * u
	local frame = Box(holder, m, m, w - 2 * m, h - 2 * m, white, 1, 3)
	local stroke = Instance.new("UIStroke")
	stroke.Color = white
	stroke.Thickness = line
	stroke.Parent = frame
	Box(holder, w / 2 - line / 2, m, line, h - 2 * m, white, 0, 3)
	ring(holder, w / 2, h / 2, 150 * u, 150 * u, white, line, 3)
	Circle(holder, w / 2, h / 2, 10 * u, 10 * u, white, 0, 3)
	for _, side in ipairs({ -1, 1 }) do
		local bw, bh = 120 * u, 230 * u
		local box = Box(holder, side < 0 and m or w - m - bw, h / 2 - bh / 2, bw, bh, white, 1, 3)
		local boxStroke = Instance.new("UIStroke")
		boxStroke.Color = white
		boxStroke.Thickness = line
		boxStroke.Parent = box
	end
end

-- Tôle larmée : petits reliefs en diagonale, alternés
FLOOR.TreadPlate = function(holder, w, h, a, b, u)
	local step = 26 * u
	local row = 0
	local y = step / 2
	while y < h do
		local col = 0
		local x = step / 2
		while x < w do
			local bar = Box(holder, x - 7 * u, y - 2 * u, 14 * u, 4 * u, (row + col) % 2 == 0 and b or a:Lerp(WHITE, 0.3), 0.1)
			bar.Rotation = (row + col) % 2 == 0 and 45 or -45
			Round(bar)
			x += step
			col += 1
		end
		y += step
		row += 1
	end
	Box(holder, 0, 0, w, h * 0.3, WHITE, 0.88)
end

-- Route : asphalte, pointillés jaunes au milieu, bords blancs, passage piéton
FLOOR.Road = function(holder, w, h, a, b, u)
	for index = 1, math.floor(w * h / (700 * u * u)) do
		local size = (2 + 2 * noise(index, 1)) * u
		Circle(holder, noise(index, 2) * w, noise(index, 3) * h, size, size, a:Lerp(WHITE, 0.2 + 0.2 * noise(index, 4)), 0.4)
	end
	local white = Color3.fromRGB(245, 245, 245)
	Box(holder, 0, 18 * u, w, 5 * u, white, 0.1, 2)
	Box(holder, 0, h - 23 * u, w, 5 * u, white, 0.1, 2)
	local x = 20 * u
	while x < w do
		Box(holder, x, h / 2 - 4 * u, 50 * u, 8 * u, b, 0, 2)
		x += 90 * u
	end
	local cross = w * 0.72
	for index = 0, 6 do
		Box(holder, cross, 34 * u + index * (h - 68 * u) / 7, 70 * u, (h - 68 * u) / 14, white, 0.05, 3)
	end
end

-- Lave : roche sombre en plaques, fissures et flaques qui brillent
FLOOR.Lava = function(holder, w, h, a, b, u)
	local glow = b:Lerp(Color3.fromRGB(255, 220, 90), 0.35)
	for index = 1, 26 do
		local cx, cy = noise(index, 1) * w, noise(index, 2) * h
		local length = (60 + 90 * noise(index, 3)) * u
		local crack = Box(holder, cx, cy, length, (3 + 3 * noise(index, 4)) * u, b, 0, 2)
		crack.Rotation = noise(index, 5) * 180
		Round(crack)
		local core = Box(holder, cx + length * 0.2, cy, length * 0.5, 1.5 * u, glow, 0, 3)
		core.Rotation = crack.Rotation
	end
	for index = 1, 8 do
		local size = (26 + 30 * noise(index, 6)) * u
		local pool = Circle(holder, noise(index, 7) * w, noise(index, 8) * h, size * 1.4, size, b, 0.05, 2)
		pool.Name = "Pool"
		Circle(holder, noise(index, 7) * w, noise(index, 8) * h, size * 0.8, size * 0.5, glow, 0, 3)
	end
	for index = 1, 30 do
		local size = (5 + 6 * noise(index, 9)) * u
		Circle(holder, noise(index, 10) * w, noise(index, 11) * h, size, size, a:Lerp(WHITE, 0.12), 0.3)
	end
end

-- Sol à plat dans `container` (largeur x profondeur en px de maquette) ;
-- le haut du conteneur = le fond de la pièce (côté mur)
function House3DFloor.Paint(container: Frame, width: number, depth: number, style: Style?, unit: number?)
	local old = container:FindFirstChild("Pattern")
	if old then
		old:Destroy()
	end
	local holder = Instance.new("Frame")
	holder.Name = "Pattern"
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.Size = UDim2.fromScale(1, 1)
	holder.ZIndex = 1
	if style then
		container.BackgroundColor3 = style.A
		local painter = FLOOR[style.Pattern] or FLOOR.Plain
		local ok, err = pcall(painter, holder, width, depth, style.A, style.B, unit or 1)
		if not ok then
			warn("[House3DFloor] Motif " .. tostring(style.Pattern) .. " : " .. tostring(err))
		end
	end
	holder.Parent = container
end

-- Pelouse du socle (px de la toile) : herbe en dégradé, touffes, fleurs le
-- long des bords (`border` = largeur de la bande visible autour de la pièce)
local GRASS = Color3.fromRGB(150, 222, 150)
local GRASS_DARK = Color3.fromRGB(108, 190, 118)
local FLOWERS = {
	Color3.fromRGB(255, 126, 182),
	Color3.fromRGB(255, 226, 130),
	WHITE,
	Color3.fromRGB(183, 148, 246),
}

function House3DFloor.Lawn(container: Frame, width: number, depth: number, border: number)
	container.BackgroundColor3 = GRASS
	local shade = Box(container, 0, 0, width, depth, WHITE, 0, 1)
	shade.Size = UDim2.fromScale(1, 1)
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 90
	gradient.Color = ColorSequence.new(Color3.fromRGB(170, 232, 168), Color3.fromRGB(136, 208, 140))
	gradient.Parent = shade
	-- Touffes d'herbe et fleurs sur toute la bordure (le milieu est sous la maison)
	local step = math.max(10, border * 0.55)
	local index = 0
	local function spot(x: number, y: number)
		index += 1
		local n = noise(index, 4)
		Circle(container, x, y, step * 0.55, step * 0.32, GRASS:Lerp(GRASS_DARK, 0.4 + n * 0.3), 0.15, 2)
		if n > 0.45 then
			local petal = FLOWERS[index % #FLOWERS + 1]
			local r = step * 0.1
			local fx = x + step * 0.3
			local fy = y - step * 0.05
			for _, d in ipairs({ Vector2.new(-1, 0), Vector2.new(1, 0), Vector2.new(0, -1), Vector2.new(0, 1) }) do
				Circle(container, fx + d.X * r, fy + d.Y * r, r * 1.6, r * 1.6, petal, 0, 3)
			end
			Circle(container, fx, fy, r * 1.1, r * 1.1, Color3.fromRGB(255, 200, 120), 0, 4)
		end
	end
	local x = step * 0.5
	while x < width do
		spot(x + (noise(x, 1) - 0.5) * step * 0.4, border * (0.3 + 0.4 * noise(x, 2)))
		spot(x + (noise(x, 3) - 0.5) * step * 0.4, depth - border * (0.3 + 0.4 * noise(x, 5)))
		x += step
	end
	local y = border
	while y < depth - border do
		spot(border * (0.3 + 0.4 * noise(y, 6)), y)
		spot(width - border * (0.3 + 0.4 * noise(y, 7)), y)
		y += step
	end
end

return House3DFloor
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">House3DKit</string>
              <string name="Source"><![CDATA[--[[
	House3DKit (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > House3DKit

	Boîte à outils de la vue 3D (House3D) et du monde : construit les VRAIS
	objets 3D (Parts de taille normale : blocs, boules, cylindres, pentes,
	ovales = Part + SpecialMesh "Sphere", tubes d'un point à un autre, blocs
	arrondis, coussins, formes plates en relief : cœurs, étoiles, triangles,
	chemins de tubes). v9.3 : plus aucun carton découpé (SurfaceGui) pour
	les objets ; seul b.Art (affiches, vue d'une fenêtre) pose un dessin 2D
	sur une face, par-dessus un panneau déjà coloré.

	Repère d'un objet ("unités") : la boîte de dessin 2D de l'objet fait
	100 x 100 unités ; en 3D, 1 unité = K studs (K = taille à l'écran x 0.05
	/ 100). x = vers la droite (-50 .. 50), y = vers le haut depuis le sol
	(0 .. 100 = hauteur de la boîte 2D), z = vers l'avant (vers la caméra
	quand l'objet regarde la pièce). Les dessus des meubles (HouseSurfaces)
	sont à la même hauteur qu'en 2D : ce qui est posé dessus tombe juste.

	Couleurs : la palette d'un objet est lue dans SON dessin 2D (HouseArt :
	les couleurs qui couvrent le plus de surface d'abord), puis passe par la
	variante de couleur de l'objet (HouseTints, si le module existe).

	API :
	  House3DKit.Paint(item, entry, night) -> Painted   (dessin 2D hors écran + palette)
	  House3DKit.Palette(painted) -> { Color3 }
	  House3DKit.Builder(parent, origin, k, mirror, map, palette, stretch?) -> Builder
	    (v9.9 SCALE99 : stretch = élargissement horizontal x/z, voir House3DScale)
	  House3DKit.Triangle / Heart / Star / StarSoft / HeartPoints / StarPoints / Path / Frame (formes)
	  House3DKit.NewPart(className, name, size, cframe, color, material?, transparency?) -> BasePart
	  House3DKit.Surface(part, face, canvasSize, lightInfluence) -> SurfaceGui
	  House3DKit.Separate(parts) -> number   (v9.6 : écarte les faces confondues, anti-scintillement)
	  House3DKit.Wood / Dist / Darken / Lighten / Pick (couleurs)
	  v9.8 (RECIPES98, objets "20x plus réalistes") :
	  House3DKit.Vary(color, seed, amount) -> Color3   (variation déterministe : veinage, dos de livres)
	  House3DKit.Gap(b, units?) -> number              (écart minimal entre faces superposées, anti-scintillement)
	  House3DKit.Chrome(part, reflectance?) -> part    (métal poli)
	  House3DKit.Bevel(b, x, y, z, w, h, d, e, color, material?) -> BasePart   (bloc au dessus chanfreiné)
	  House3DKit.Handle(b, x, y, z, length, vertical, color?)                 (poignée barre sur 2 plots)
	  House3DKit.Leg(b, x, y, z, d, h, color, material?, foot?)               (pied fuselé + patin)
	  House3DKit.SeatCushion(b, x, y, z, w, h, d, color, piping?)             (assise aux bords roulés, passepoil)
	  House3DKit.PillowR(b, cframe, w, h, d, color, material?)                (coussin moelleux orienté)
	  House3DKit.Leaf(b, x, y, z, length, width, yaw, pitch, color, rib?)      (feuille ovale orientée)
	  House3DKit.Books(b, x0, x1, y, zFront, depth, maxH, colors, seed)        (rangée de livres variés)
	  House3DKit.Bulb(b, x, y, z, d, color, range, brightness?)               (ampoule douce, Brightness <= 1)
	  House3DKit.Mirror(b, x, y, z, w, h, shape?) -> BasePart                 (miroir tagué Mirror = true)
	  House3DKit.Planks(b, x, y, z, w, h, d, n, color, material?, seed?)      (lames de bois aux teintes variées)
	  House3DKit.Polish(b, fromIndex) / House3DKit.Polished(recipe)            (reflets du métal, du verre, du marbre)
]]

local HouseArt = require(script.Parent.HouseArt)

local House3DKit = {}

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local BUTTER = Color3.fromRGB(255, 226, 130)
local MIN_SIZE = 0.03 -- (studs) plus petite dimension d'une pièce
local CARD_MARGIN_X = 28 -- marges du carton (unités) : halos, débords
local CARD_MARGIN_TOP = 36
local CARD_MARGIN_BOTTOM = 4
local CARD_MARGIN_WALL = 26
local CARD_RES = 4 -- px de toile par unité
-- (Roblox : une SurfaceGui neuve a MaxDistance = 1000 -> on le fixe nous-mêmes)
House3DKit.MAX_DISTANCE = 3000

export type Painted = {
	Item: any,
	Content: Frame, -- boîte + marges (unités), hors écran
	Wall: boolean,
	UnitsW: number,
	UnitsH: number,
	MarginTop: number,
	MarginBottom: number,
	Glow: Color3?,
	Flat: boolean,
	Colors: { Color3 },
}

export type Top = { X: number, Y: number, Z: number, W: number, D: number }

export type Builder = {
	K: number,
	Stretch: number, -- (v9.9 SCALE99) élargissement horizontal (1 = aucun)
	Mirror: boolean,
	Parts: { BasePart },
	Locals: { CFrame },
	Lights: { Light },
	Glows: { BasePart },
	Tops: { [number]: Top },
	Width: number,
	Depth: number,
	Height: number,
	Pal: { Color3 },
	Painted: Painted?,
	PaintFn: (() -> Painted?)?,
	Item: any?,
	P: (index: number, fallback: Color3) -> Color3,
	Map: (color: Color3) -> Color3,
	Part: (className: string, cframe: CFrame, size: Vector3, color: Color3, material: Enum.Material?, name: string?) -> BasePart,
	Box: (x: number, y: number, z: number, w: number, h: number, d: number, color: Color3, material: Enum.Material?) -> BasePart,
	BoxR: (cframe: CFrame, w: number, h: number, d: number, color: Color3, material: Enum.Material?) -> BasePart,
	Ball: (x: number, y: number, z: number, diameter: number, color: Color3, material: Enum.Material?) -> BasePart,
	Cyl: (x: number, y: number, z: number, diameter: number, height: number, color: Color3, material: Enum.Material?) -> BasePart,
	CylX: (x: number, y: number, z: number, diameter: number, length: number, color: Color3, material: Enum.Material?) -> BasePart,
	CylZ: (x: number, y: number, z: number, diameter: number, length: number, color: Color3, material: Enum.Material?) -> BasePart,
	Wedge: (x: number, y: number, z: number, w: number, h: number, d: number, color: Color3, facing: string, material: Enum.Material?) -> BasePart,
	Egg: (x: number, y: number, z: number, w: number, h: number, d: number, color: Color3, material: Enum.Material?) -> BasePart,
	EggR: (cframe: CFrame, w: number, h: number, d: number, color: Color3, material: Enum.Material?) -> BasePart,
	Tube: (x0: number, y0: number, z0: number, x1: number, y1: number, z1: number, diameter: number, color: Color3, material: Enum.Material?) -> BasePart,
	Round: (x: number, y: number, z: number, w: number, h: number, d: number, r: number, color: Color3, material: Enum.Material?) -> BasePart,
	Cushion: (x: number, y: number, z: number, w: number, h: number, d: number, color: Color3, material: Enum.Material?) -> BasePart,
	Seat: (x: number, y: number, z: number, w: number, d: number) -> (),
	SeatAt: { X: number, Y: number, Z: number, W: number, D: number }?,
	Flags: { [string]: any },
	Light: (part: BasePart, color: Color3, range: number, brightness: number) -> (),
	Neon: (part: BasePart) -> (),
	Top: (index: number, x: number, y: number, z: number, w: number, d: number) -> (),
	Footprint: (w: number, d: number, h: number) -> (),
	Art: (x: number, y: number, z: number, w: number, h: number, zoom: number) -> BasePart,
}

----------------------------------------------------------------------
-- Couleurs
----------------------------------------------------------------------

function House3DKit.Darken(color: Color3, amount: number): Color3
	return color:Lerp(BLACK, amount)
end

function House3DKit.Lighten(color: Color3, amount: number): Color3
	return color:Lerp(WHITE, amount)
end

function House3DKit.Dist(a: Color3, b: Color3): number
	local dr, dg, db = a.R - b.R, a.G - b.G, a.B - b.B
	return math.sqrt(dr * dr * 0.3 + dg * dg * 0.59 + db * db * 0.11)
end

-- Couleur de la palette qui ressemble à du bois (sinon `fallback`)
function House3DKit.Wood(palette: { Color3 }, fallback: Color3): Color3
	for _, color in ipairs(palette) do
		local h, s, v = color:ToHSV()
		if h >= 0.02 and h <= 0.13 and s >= 0.18 and s <= 0.75 and v >= 0.35 and v <= 0.95 then
			return color
		end
	end
	return fallback
end

-- Première couleur de la palette qui vérifie `test`
function House3DKit.Pick(palette: { Color3 }, test: (h: number, s: number, v: number) -> boolean, fallback: Color3): Color3
	for _, color in ipairs(palette) do
		local h, s, v = color:ToHSV()
		if test(h, s, v) then
			return color
		end
	end
	return fallback
end

----------------------------------------------------------------------
-- Pièces
----------------------------------------------------------------------

function House3DKit.NewPart(className: string, name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?, transparency: number?): BasePart
	local part = Instance.new(className) :: BasePart
	part.Name = name
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = material or Enum.Material.SmoothPlastic
	part.Color = color
	part.Transparency = transparency or 0
	part.Size = Vector3.new(math.max(MIN_SIZE, size.X), math.max(MIN_SIZE, size.Y), math.max(MIN_SIZE, size.Z))
	part.CFrame = cframe
	return part
end

-- Toile sur une face (taille fixe en px ; normale, jamais géante)
function House3DKit.Surface(part: BasePart, face: Enum.NormalId, canvasSize: Vector2, lightInfluence: number): SurfaceGui
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Canvas" .. face.Name
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.CanvasSize = Vector2.new(math.max(8, math.floor(canvasSize.X + 0.5)), math.max(8, math.floor(canvasSize.Y + 0.5)))
	gui.LightInfluence = lightInfluence
	gui.Brightness = 1
	gui.AlwaysOnTop = false
	gui.MaxDistance = House3DKit.MAX_DISTANCE
	gui.ClipsDescendants = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = part
	return gui
end

-- Miroir gauche <-> droite d'une rotation (conjugaison par diag(-1, 1, 1))
local function mirrorCFrame(cf: CFrame): CFrame
	local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
	return CFrame.new(-x, y, z, r00, -r01, -r02, -r10, r11, r12, -r20, r21, r22)
end

local WEDGE_YAW: { [string]: number } = {
	Back = 0, -- (WedgePart de Roblox : la pente regarde -Z)
	Front = math.pi,
	Right = -math.pi / 2,
	Left = math.pi / 2,
}

-- (v9.9 SCALE99) Élargissement horizontal d'une pièce (unités) : la position
-- et les axes de la pièce passent par diag(s, 1, s). Chaque côté prend la
-- longueur de son axe transformé ; l'axe le plus long garde sa direction
-- exacte (tube, pied, planche), puis Gram-Schmidt. Rotations autour de la
-- verticale : exactes ; pièces inclinées : très proche (s <= 1,5).
local function stretchPart(cframe: CFrame, size: Vector3, s: number): (CFrame, Vector3)
	local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cframe:GetComponents()
	local axes = {
		Vector3.new(r00 * s, r10, r20 * s),
		Vector3.new(r01 * s, r11, r21 * s),
		Vector3.new(r02 * s, r12, r22 * s),
	}
	local lengths = { axes[1].Magnitude, axes[2].Magnitude, axes[3].Magnitude }
	local sizes = { size.X * lengths[1], size.Y * lengths[2], size.Z * lengths[3] }
	-- ordre : le plus long d'abord
	local p = 1
	for i = 2, 3 do
		if sizes[i] > sizes[p] + 1e-6 then
			p = i
		end
	end
	local q = p % 3 + 1
	local other = q % 3 + 1
	if other ~= p and sizes[other] > sizes[q] + 1e-6 then
		q = other
	end
	local r = 6 - p - q
	local units: { Vector3 } = { Vector3.zero, Vector3.zero, Vector3.zero }
	units[p] = axes[p] / math.max(1e-6, lengths[p])
	local projected = axes[q] - units[p] * axes[q]:Dot(units[p])
	if projected.Magnitude < 1e-4 then
		return CFrame.new(x * s, y, z * s) * cframe.Rotation, Vector3.new(sizes[1], sizes[2], sizes[3])
	end
	units[q] = projected.Unit
	-- (repère direct : X = Y x Z, Y = Z x X, Z = X x Y)
	if (p == 1 and q == 2) or (p == 2 and q == 3) or (p == 3 and q == 1) then
		units[r] = units[p]:Cross(units[q])
	else
		units[r] = units[q]:Cross(units[p])
	end
	local cf = CFrame.fromMatrix(Vector3.new(x * s, y, z * s), units[1], units[2], units[3])
	return cf, Vector3.new(sizes[1], sizes[2], sizes[3])
end

-- (v9.9) Boule / cylindre élargis : ils restent ronds (diamètre moyen)
local function roundAgain(part: BasePart, ball: boolean)
	local size = part.Size
	if ball then
		local d = (size.X + size.Y + size.Z) / 3
		part.Size = Vector3.new(d, d, d)
	else
		local d = (size.Y + size.Z) / 2
		part.Size = Vector3.new(size.X, d, d)
	end
end

-- Constructeur d'un objet : pièces en unités, dans le repère `origin`
function House3DKit.Builder(parent: Instance, origin: CFrame, k: number, mirror: boolean, map: ((Color3) -> Color3)?, palette: { Color3 }?, stretch: number?): Builder
	local b = {} :: Builder
	-- (v9.9 SCALE99) `stretch` = élargissement horizontal (x, z) en plus de k ;
	-- b.K = la plus petite des deux échelles (épaisseurs minimales des recettes)
	local wide = math.clamp(tonumber(stretch) or 1, 0.5, 2)
	if math.abs(wide - 1) < 0.001 then
		wide = 1
	end
	b.K = k * math.min(1, wide)
	b.Stretch = wide
	b.Mirror = mirror
	b.Parts = {}
	b.Locals = {}
	b.Lights = {}
	b.Glows = {}
	b.Tops = {}
	b.Width, b.Depth, b.Height = 100, 60, 100
	local mapper = map or function(color: Color3): Color3
		return color
	end
	b.Map = mapper
	local pal = {}
	for _, color in ipairs(palette or {}) do
		table.insert(pal, mapper(color))
	end
	b.Pal = pal
	b.P = function(index: number, fallback: Color3): Color3
		return pal[index] or mapper(fallback)
	end

	b.Part = function(className: string, cframe: CFrame, size: Vector3, color: Color3, material: Enum.Material?, name: string?): BasePart
		local localCF, partSize
		if wide ~= 1 then
			localCF, partSize = stretchPart(cframe, size, wide)
			localCF = CFrame.new(localCF.X * k, localCF.Y * k, localCF.Z * k) * localCF.Rotation
			partSize *= k
		else
			localCF = CFrame.new(cframe.X * k, cframe.Y * k, cframe.Z * k) * cframe.Rotation
			partSize = size * k
		end
		if mirror then
			localCF = mirrorCFrame(localCF)
		end
		local part = House3DKit.NewPart(className, name or "Piece", partSize, origin * localCF, color, material)
		part.Parent = parent
		table.insert(b.Parts, part)
		table.insert(b.Locals, localCF)
		return part
	end
	b.Box = function(x: number, y: number, z: number, w: number, h: number, d: number, color: Color3, material: Enum.Material?): BasePart
		return b.Part("Part", CFrame.new(x, y + h / 2, z), Vector3.new(w, h, d), color, material)
	end
	b.BoxR = function(cframe: CFrame, w: number, h: number, d: number, color: Color3, material: Enum.Material?): BasePart
		return b.Part("Part", cframe, Vector3.new(w, h, d), color, material)
	end
	b.Ball = function(x: number, y: number, z: number, diameter: number, color: Color3, material: Enum.Material?): BasePart
		local part = b.Part("Part", CFrame.new(x, y, z), Vector3.new(diameter, diameter, diameter), color, material, "Boule")
		;(part :: Part).Shape = Enum.PartType.Ball
		if wide ~= 1 then
			roundAgain(part, true)
		end
		return part
	end
	-- Cylindre debout (y = bas)
	b.Cyl = function(x: number, y: number, z: number, diameter: number, height: number, color: Color3, material: Enum.Material?): BasePart
		local part = b.Part("Part", CFrame.new(x, y + height / 2, z) * CFrame.Angles(0, 0, math.pi / 2), Vector3.new(height, diameter, diameter), color, material, "Cylindre")
		;(part :: Part).Shape = Enum.PartType.Cylinder
		if wide ~= 1 then
			roundAgain(part, false)
		end
		return part
	end
	-- Cylindre couché gauche-droite (centre)
	b.CylX = function(x: number, y: number, z: number, diameter: number, length: number, color: Color3, material: Enum.Material?): BasePart
		local part = b.Part("Part", CFrame.new(x, y, z), Vector3.new(length, diameter, diameter), color, material, "Cylindre")
		;(part :: Part).Shape = Enum.PartType.Cylinder
		if wide ~= 1 then
			roundAgain(part, false)
		end
		return part
	end
	-- Cylindre couché avant-arrière (centre)
	b.CylZ = function(x: number, y: number, z: number, diameter: number, length: number, color: Color3, material: Enum.Material?): BasePart
		local part = b.Part("Part", CFrame.new(x, y, z) * CFrame.Angles(0, math.pi / 2, 0), Vector3.new(length, diameter, diameter), color, material, "Cylindre")
		;(part :: Part).Shape = Enum.PartType.Cylinder
		if wide ~= 1 then
			roundAgain(part, false)
		end
		return part
	end
	-- Coin en pente (y = bas) ; `facing` = où regarde la pente
	b.Wedge = function(x: number, y: number, z: number, w: number, h: number, d: number, color: Color3, facing: string, material: Enum.Material?): BasePart
		local yaw = WEDGE_YAW[facing] or 0
		local size = (facing == "Left" or facing == "Right") and Vector3.new(d, h, w) or Vector3.new(w, h, d)
		return b.Part("WedgePart", CFrame.new(x, y + h / 2, z) * CFrame.Angles(0, yaw, 0), size, color, material, "Pente")
	end
	-- Ellipsoïde (centre x, y, z) : Part + SpecialMesh "Sphere" (une Ball de
	-- Roblox est toujours ronde : taille uniforme forcée ; le maillage
	-- Sphere, lui, suit la taille de la pièce sur les 3 axes)
	b.EggR = function(cframe: CFrame, w: number, h: number, d: number, color: Color3, material: Enum.Material?): BasePart
		local part = b.Part("Part", cframe, Vector3.new(w, h, d), color, material, "Ovale")
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = part
		return part
	end
	b.Egg = function(x: number, y: number, z: number, w: number, h: number, d: number, color: Color3, material: Enum.Material?): BasePart
		if math.abs(w - h) < 0.01 and math.abs(h - d) < 0.01 then
			return b.Ball(x, y, z, w, color, material)
		end
		return b.EggR(CFrame.new(x, y, z), w, h, d, color, material)
	end
	-- Tube (cylindre) d'un point à un autre (pieds, tiges, anses, bras...)
	b.Tube = function(x0: number, y0: number, z0: number, x1: number, y1: number, z1: number, diameter: number, color: Color3, material: Enum.Material?): BasePart
		local a, c = Vector3.new(x0, y0, z0), Vector3.new(x1, y1, z1)
		local delta = c - a
		local length = math.max(0.01, delta.Magnitude)
		local direction = length > 0.01 and delta / length or Vector3.new(0, 1, 0)
		local up = math.abs(direction.Y) > 0.95 and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0)
		-- (le cylindre de Roblox est couché sur X : on aligne X sur le tube)
		local cf = CFrame.lookAt((a + c) / 2, (a + c) / 2 + direction, up) * CFrame.Angles(0, math.pi / 2, 0)
		local part = b.Part("Part", cf, Vector3.new(length, diameter, diameter), color, material, "Tube")
		;(part :: Part).Shape = Enum.PartType.Cylinder
		if wide ~= 1 then
			roundAgain(part, false)
		end
		return part
	end
	-- Bloc aux arêtes verticales arrondies (y = bas) : 2 blocs + 4 cylindres
	b.Round = function(x: number, y: number, z: number, w: number, h: number, d: number, r: number, color: Color3, material: Enum.Material?): BasePart
		r = math.clamp(r, 0.2, math.min(w, d) / 2 - 0.05)
		local main = b.Box(x, y, z, w - 2 * r, h, d, color, material)
		b.Box(x, y, z, w, h, d - 2 * r, color, material)
		for _, sx in ipairs({ -1, 1 }) do
			for _, sz in ipairs({ -1, 1 }) do
				b.Cyl(x + sx * (w / 2 - r), y, z + sz * (d / 2 - r), 2 * r, h, color, material)
			end
		end
		return main
	end
	-- Coussin moelleux (y = bas) : cœur en bloc + enveloppe ovale
	b.Cushion = function(x: number, y: number, z: number, w: number, h: number, d: number, color: Color3, material: Enum.Material?): BasePart
		local core = b.Box(x, y + h * 0.12, z, w * 0.9, h * 0.72, d * 0.86, color, material or Enum.Material.Fabric)
		b.Egg(x, y + h / 2, z, w, h, d, color, material or Enum.Material.Fabric)
		return core
	end
	-- Place assise (unités, face vers +z) : un personnage peut s'y asseoir (monde)
	b.Seat = function(x: number, y: number, z: number, w: number, d: number)
		b.SeatAt = { X = mirror and -x or x, Y = y, Z = z, W = w, D = d }
	end
	b.Flags = {}
	b.Light = function(part: BasePart, color: Color3, range: number, brightness: number)
		local light = Instance.new("PointLight")
		light.Color = color
		light.Range = math.clamp(range, 2, 60)
		light.Brightness = brightness
		light.Shadows = false
		light.Parent = part
		table.insert(b.Lights, light)
	end
	-- Pièce lumineuse (abat-jour, ampoule, écran) : Neon, plus fort la nuit
	b.Neon = function(part: BasePart)
		part.Material = Enum.Material.Neon
		part.CastShadow = false
		table.insert(b.Glows, part)
	end
	b.Top = function(index: number, x: number, y: number, z: number, w: number, d: number)
		b.Tops[index] = { X = mirror and -x or x, Y = y, Z = z, W = w, D = d }
	end
	b.Footprint = function(w: number, d: number, h: number)
		b.Width, b.Depth, b.Height = w, d, h
	end
	-- Panneau (y = bas) qui montre le dessin 2D de l'objet sur sa face avant
	-- (vue d'une fenêtre, tableau...) ; `zoom` > 1 = on ne garde que le centre
	local artUsed = false
	b.Art = function(x: number, y: number, z: number, w: number, h: number, zoom: number): BasePart
		local panel = b.Box(x, y, z, w, h, 1, b.P(1, WHITE), Enum.Material.SmoothPlastic)
		panel.CastShadow = false
		local painted = b.Painted
		if not painted and b.PaintFn then
			painted = b.PaintFn()
			b.Painted = painted
		end
		if not painted then
			return panel
		end
		local canvas = Vector2.new(math.max(16, w * CARD_RES), math.max(16, h * CARD_RES))
		local gui = House3DKit.Surface(panel, Enum.NormalId.Back, canvas, 0.5)
		local content = artUsed and painted.Content:Clone() or painted.Content
		artUsed = true
		local scale = CARD_RES * zoom
		local marginX = (painted.UnitsW - 100) / 2
		content.Position = UDim2.fromOffset(canvas.X / 2 - (marginX + 50) * scale, canvas.Y / 2 - (painted.MarginTop + 50) * scale)
		local uiScale = Instance.new("UIScale")
		uiScale.Scale = scale
		uiScale.Parent = content
		content.Parent = gui
		return panel
	end
	return b
end

----------------------------------------------------------------------
-- v9.6 : anti-scintillement (z-fighting). Deux faces de pièces DIFFÉRENTES
-- (couleur / matière / transparence) dans le même plan, du même côté, qui se
-- recouvrent : Roblox les dessine en alternance ("bugs de texture" vus par
-- le joueur). Separate écarte la plus petite des deux de SEP_GAP studs vers
-- l'extérieur (la pièce grandit de ce côté-là, rien ne s'ouvre ni ne flotte).
----------------------------------------------------------------------

local SEP_GAP = 0.035 -- (studs) écart visé entre deux faces du même côté
local SEP_NEAR = 0.025 -- en dessous : faces "confondues"
local SEP_OVERLAP = 0.02 -- (studs²) recouvrement minimal pris en compte

type SepFace = { Part: BasePart, Axis: number, N: Vector3, D: number, U0: number, U1: number, V0: number, V1: number, Area: number }

local function sepBasis(n: Vector3): (Vector3, Vector3)
	local u = n:Cross(math.abs(n.Y) < 0.9 and Vector3.new(0, 1, 0) or Vector3.new(1, 0, 0)).Unit
	return u, n:Cross(u)
end

-- Faces planes d'une pièce (bloc : 6 ; cylindre : 2 disques ; pente : dessous, dos, côtés)
local function sepFaces(part: BasePart, out: { SepFace })
	if part.Transparency >= 0.99 then
		return
	end
	local shape = "Block"
	if part:IsA("WedgePart") then
		shape = "Wedge"
	elseif part:IsA("Part") then
		local partShape = (part :: Part).Shape
		if partShape == Enum.PartType.Ball then
			return
		elseif partShape == Enum.PartType.Cylinder then
			shape = "Cylinder"
		elseif partShape ~= Enum.PartType.Block then
			return
		end
	else
		return
	end
	local cf, size = part.CFrame, part.Size
	local axes = { cf.RightVector, cf.UpVector, -cf.LookVector }
	local half = { size.X / 2, size.Y / 2, size.Z / 2 }
	for axis = 1, 3 do
		for _, sign in ipairs({ 1, -1 }) do
			local keep = true
			if shape == "Cylinder" then
				keep = axis == 1
			elseif shape == "Wedge" then
				keep = (axis == 2 and sign < 0) or (axis == 3 and sign > 0) or axis == 1
			end
			if keep then
				local n = axes[axis] * sign
				local center = cf.Position + n * half[axis]
				local b, c = axis == 1 and 2 or 1, axis == 3 and 2 or 3
				local hb, hc = axes[b] * half[b], axes[c] * half[c]
				if shape == "Cylinder" then
					local r = math.min(size.Y, size.Z) / 2
					hb, hc = axes[2] * r, axes[3] * r
				end
				local u, v = sepBasis(n)
				local u0, u1, v0, v1 = math.huge, -math.huge, math.huge, -math.huge
				for _, corner in ipairs({ center + hb + hc, center + hb - hc, center - hb + hc, center - hb - hc }) do
					local pu, pv = corner:Dot(u), corner:Dot(v)
					u0, u1 = math.min(u0, pu), math.max(u1, pu)
					v0, v1 = math.min(v0, pv), math.max(v1, pv)
				end
				table.insert(out, { Part = part, Axis = axis, N = n, D = n:Dot(center), U0 = u0, U1 = u1, V0 = v0, V1 = v1, Area = (u1 - u0) * (v1 - v0) })
			end
		end
	end
end

local function sepDiffers(a: BasePart, b: BasePart): boolean
	if a.Material ~= b.Material or math.abs(a.Transparency - b.Transparency) > 0.05 then
		return true
	end
	local ca, cb = a.Color, b.Color
	return math.max(math.abs(ca.R - cb.R), math.abs(ca.G - cb.G), math.abs(ca.B - cb.B)) > 3 / 255
end

-- Écarte les faces confondues d'une liste de pièces (un objet, une coque de
-- pièce...) ; renvoie le nombre de faces déplacées
function House3DKit.Separate(parts: { BasePart }, fixed: { [BasePart]: boolean }?): number
	local still = fixed or {}
	local order: { [BasePart]: number } = {}
	for index, part in ipairs(parts) do
		order[part] = index
	end
	local function keyOf(n: Vector3, slot: number): string
		return string.format("%d,%d,%d,%d", math.floor(n.X * 50 + 0.5), math.floor(n.Y * 50 + 0.5), math.floor(n.Z * 50 + 0.5), slot)
	end
	local function overlaps(a: SepFace, b: SepFace, minimum: number): boolean
		local ou = math.min(a.U1, b.U1) - math.max(a.U0, b.U0)
		local ov = math.min(a.V1, b.V1) - math.max(a.V0, b.V0)
		return ou > 0 and ov > 0 and ou * ov > minimum
	end
	local moved = 0
	for _ = 1, 8 do
		local faces: { SepFace } = {}
		for _, part in ipairs(parts) do
			sepFaces(part, faces)
		end
		local buckets: { [string]: { SepFace } } = {}
		local function add(face: SepFace)
			local key = keyOf(face.N, math.floor(face.D / 0.05))
			local list = buckets[key]
			if not list then
				list = {}
				buckets[key] = list
			end
			table.insert(list, face)
		end
		for _, face in ipairs(faces) do
			add(face)
		end
		-- une face voisine (autre pièce, autre couleur) trop près du plan `d` ?
		local function clashes(face: SepFace, d: number): boolean
			for ek = -1, 1 do
				for _, other in ipairs(buckets[keyOf(face.N, math.floor(d / 0.05) + ek)] or {}) do
					if other.Part ~= face.Part and other.N:Dot(face.N) > 0.999 and math.abs(other.D - d) < SEP_NEAR
						and overlaps(other, face, 0) and sepDiffers(other.Part, face.Part) then
						return true
					end
				end
			end
			return false
		end
		local touched: { [BasePart]: boolean } = {}
		local fixes = 0
		for _, a in ipairs(faces) do
			local slot = math.floor(a.D / 0.05)
			for dk = -1, 1 do
				for _, b in ipairs(buckets[keyOf(a.N, slot + dk)] or {}) do
					if b.Part ~= a.Part and not touched[a.Part] and not touched[b.Part] and a.N:Dot(b.N) > 0.999
						and math.abs(a.D - b.D) < SEP_NEAR and overlaps(a, b, SEP_OVERLAP) and sepDiffers(a.Part, b.Part) then
						-- la plus petite face avance (à aire égale : la pièce ajoutée après) ;
						-- une pièce "fixe" (mur, sol...) ne bouge jamais
						local small, large = a, b
						if b.Area < a.Area or (b.Area == a.Area and (order[b.Part] or 0) > (order[a.Part] or 0)) then
							small, large = b, a
						end
						if still[small.Part] then
							small, large = large, small
						end
						if not still[small.Part] then
							-- plan visé : SEP_GAP devant la grande face, loin de toute autre
							-- face voisine (deux corrections ne se recollent pas)
							local target = math.max(small.D, large.D) + SEP_GAP
							for _ = 1, 8 do
								if not clashes(small, target) then
									break
								end
								target += SEP_GAP
							end
							local grow = target - small.D
							local part = small.Part
							local extra = small.Axis == 1 and Vector3.new(grow, 0, 0) or (small.Axis == 2 and Vector3.new(0, grow, 0) or Vector3.new(0, 0, grow))
							part.Size += extra
							part.CFrame = part.CFrame + small.N * (grow / 2)
							touched[part] = true
							fixes += 1
							-- (le nouveau plan compte tout de suite pour les corrections suivantes)
							add({ Part = part, Axis = small.Axis, N = small.N, D = target, U0 = small.U0, U1 = small.U1, V0 = small.V0, V1 = small.V1, Area = small.Area })
						end
					end
				end
			end
		end
		moved += fixes
		if fixes == 0 then
			break
		end
	end
	return moved
end

----------------------------------------------------------------------
-- Formes plates en relief (plan x-y, épaisseur vers +z) : cœurs, étoiles,
-- triangles, et tubes le long d'un chemin (néons, guirlandes, anses...)
----------------------------------------------------------------------

-- Triangle isocèle centré en (cx, cy), pointe vers `angle` (0 = vers le haut)
function House3DKit.Triangle(b: Builder, cx: number, cy: number, z: number, base: number, height: number, angle: number, thick: number, color: Color3, material: Enum.Material?)
	local cf = CFrame.new(cx, cy, z + thick / 2) * CFrame.Angles(0, 0, angle) * CFrame.Angles(0, math.pi / 2, 0)
	local half = base / 2
	b.Part("WedgePart", cf * CFrame.new(0, 0, -half / 2), Vector3.new(thick, height, half), color, material, "Pointe")
	b.Part("WedgePart", cf * CFrame.Angles(0, math.pi, 0) * CFrame.new(0, 0, -half / 2), Vector3.new(thick, height, half), color, material, "Pointe")
end

-- Cœur plat : un carré tourné + deux disques (largeur totale `size`)
function House3DKit.Heart(b: Builder, cx: number, cy: number, z: number, size: number, thick: number, color: Color3, material: Enum.Material?)
	local side = size / 1.707
	local oy = cy - side * 0.0735
	b.BoxR(CFrame.new(cx, oy, z + thick / 2) * CFrame.Angles(0, 0, math.pi / 4), side, side, thick, color, material)
	local offset = side / (2 * math.sqrt(2))
	for _, sx in ipairs({ -1, 1 }) do
		b.CylZ(cx + sx * offset, oy + offset, z + thick / 2, side, thick, color, material)
	end
end

-- Étoile plate à 5 branches (rayon extérieur `radius`)
function House3DKit.Star(b: Builder, cx: number, cy: number, z: number, radius: number, thick: number, color: Color3, material: Enum.Material?)
	b.CylZ(cx, cy, z + thick / 2, radius * 0.9, thick, color, material)
	for index = 0, 4 do
		local angle = index * math.pi * 2 / 5
		local d = radius * 0.62
		House3DKit.Triangle(b, cx - math.sin(angle) * d, cy + math.cos(angle) * d, z, radius * 0.62, radius * 0.72, angle, thick, color, material)
	end
end

-- Étoile "douce" (5 branches ovales + cœur rond) : 6 pièces seulement
function House3DKit.StarSoft(b: Builder, cx: number, cy: number, z: number, radius: number, thick: number, color: Color3, material: Enum.Material?): BasePart
	local core = b.CylZ(cx, cy, z + thick / 2, radius * 0.8, thick, color, material)
	for index = 0, 4 do
		local angle = index * math.pi * 2 / 5
		local d = radius * 0.5
		b.EggR(CFrame.new(cx - math.sin(angle) * d, cy + math.cos(angle) * d, z + thick / 2) * CFrame.Angles(0, 0, angle), radius * 0.5, radius, thick, color, material)
	end
	return core
end

-- Points d'un cœur (contour) / d'une étoile (contour), plan x-y
function House3DKit.HeartPoints(cx: number, cy: number, z: number, size: number, count: number): { { number } }
	local points = {}
	for index = 0, count do
		local t = index / count * math.pi * 2
		local x = 16 * math.sin(t) ^ 3
		local y = 13 * math.cos(t) - 5 * math.cos(2 * t) - 2 * math.cos(3 * t) - math.cos(4 * t)
		table.insert(points, { cx + x * size / 34, cy + (y + 2) * size / 34, z })
	end
	return points
end
function House3DKit.StarPoints(cx: number, cy: number, z: number, radius: number, inner: number): { { number } }
	local points = {}
	for index = 0, 10 do
		local angle = index * math.pi / 5
		local r = index % 2 == 0 and radius or radius * inner
		table.insert(points, { cx - math.sin(angle) * r, cy + math.cos(angle) * r, z })
	end
	return points
end

-- Tubes le long d'un chemin (+ petites boules aux coudes)
function House3DKit.Path(b: Builder, points: { { number } }, diameter: number, color: Color3, material: Enum.Material?, neon: boolean?, noJoints: boolean?): { BasePart }
	local parts = {}
	for index = 1, #points - 1 do
		local a, c = points[index], points[index + 1]
		local tube = b.Tube(a[1], a[2], a[3], c[1], c[2], c[3], diameter, color, material)
		table.insert(parts, tube)
		if index > 1 and not noJoints then
			table.insert(parts, b.Ball(a[1], a[2], a[3], diameter, color, material))
		end
	end
	if neon then
		for _, part in ipairs(parts) do
			b.Neon(part)
		end
	end
	return parts
end

-- Cadre rectangulaire (4 baguettes), y = bas
function House3DKit.Frame(b: Builder, x: number, y: number, z: number, w: number, h: number, bar: number, depth: number, color: Color3, material: Enum.Material?)
	b.Box(x, y, z, w, bar, depth, color, material)
	b.Box(x, y + h - bar, z, w, bar, depth, color, material)
	b.Box(x - w / 2 + bar / 2, y + bar, z, bar, h - 2 * bar, depth, color, material)
	b.Box(x + w / 2 - bar / 2, y + bar, z, bar, h - 2 * bar, depth, color, material)
end

----------------------------------------------------------------------
-- v9.8 (RECIPES98) : aides "réalistes" pour les recettes. Toutes en unités
-- de la recette (repère du Builder, +z = devant), y = bas sauf mention.
----------------------------------------------------------------------

local MAT = Enum.Material

-- Variation déterministe d'une couleur (planches, livres, feuilles...) :
-- même `seed` = même teinte (les maisons de tous les joueurs se ressemblent)
function House3DKit.Vary(color: Color3, seed: number, amount: number): Color3
	local t = math.sin(seed * 12.9898 + 78.233) * 43758.5453
	t = (t - math.floor(t)) * 2 - 1
	if t >= 0 then
		return color:Lerp(WHITE, t * amount)
	end
	return color:Lerp(BLACK, -t * amount)
end

-- Écart minimal (unités) entre deux faces parallèles superposées (façade
-- devant un fond, panneau en relief...) : au moins 0,034 stud à l'échelle
-- de l'objet, sinon Separate les écarterait en cascade
function House3DKit.Gap(b: Builder, units: number?): number
	return math.max(units or 0.8, 0.034 / math.max(b.K, 1e-3))
end

-- Métal poli / chromé (reflet du ciel de Roblox)
function House3DKit.Chrome(part: BasePart, reflectance: number?): BasePart
	part.Reflectance = reflectance or 0.3
	return part
end

-- Bloc au dessus chanfreiné (y = bas) : les 4 arêtes du dessus sont
-- biseautées de `e` (6 pièces), comme un plateau / un dessus de meuble
function House3DKit.Bevel(b: Builder, x: number, y: number, z: number, w: number, h: number, d: number, e: number, color: Color3, material: Enum.Material?): BasePart
	e = math.clamp(e, 0.2, math.min(h, w / 2, d / 2) * 0.9)
	local main = b.Box(x, y, z, w, h - e, d, color, material)
	b.Box(x, y + h - e, z, w - 2 * e, e, d - 2 * e, color, material)
	b.Wedge(x, y + h - e, z + d / 2 - e / 2, w, e, e, color, "Front", material)
	b.Wedge(x, y + h - e, z - d / 2 + e / 2, w, e, e, color, "Back", material)
	b.Wedge(x + w / 2 - e / 2, y + h - e, z, e, e, d - 2 * e, color, "Right", material)
	b.Wedge(x - w / 2 + e / 2, y + h - e, z, e, e, d - 2 * e, color, "Left", material)
	return main
end

-- Poignée en barre sur deux plots (centre x, y ; z = la face du meuble) :
-- barre chromée à l'horizontale (ou debout si `vertical`)
function House3DKit.Handle(b: Builder, x: number, y: number, z: number, length: number, vertical: boolean, color: Color3?)
	local metal = color or Color3.fromRGB(206, 210, 222)
	local t = math.max(0.9, length * 0.09)
	local out = t * 2.2
	local parts = {}
	if vertical then
		table.insert(parts, b.Tube(x, y - length / 2, z + out, x, y + length / 2, z + out, t, metal, MAT.Metal))
		for _, s in ipairs({ -1, 1 }) do
			table.insert(parts, b.CylZ(x, y + s * length * 0.36, z + out / 2, t * 0.8, out, metal, MAT.Metal))
		end
	else
		table.insert(parts, b.CylX(x, y, z + out, t, length, metal, MAT.Metal))
		for _, s in ipairs({ -1, 1 }) do
			table.insert(parts, b.CylZ(x + s * length * 0.36, y, z + out / 2, t * 0.8, out, metal, MAT.Metal))
		end
	end
	for _, part in ipairs(parts) do
		part.Reflectance = 0.3
	end
end

-- Pied fuselé (y = bas) : fût du haut, fût affiné du bas, patin (3 pièces)
function House3DKit.Leg(b: Builder, x: number, y: number, z: number, d: number, h: number, color: Color3, material: Enum.Material?, foot: Color3?)
	local footH = math.min(h * 0.08, d * 0.6)
	b.Cyl(x, y + h * 0.45, z, d, h * 0.55, color, material or MAT.Wood)
	b.Cyl(x, y + footH, z, d * 0.74, h * 0.45 - footH, color, material or MAT.Wood)
	local cap = b.Cyl(x, y, z, d * 0.8, footH, foot or Color3.fromRGB(196, 160, 90), MAT.Metal)
	cap.Reflectance = 0.2
end

-- Coussin d'assise (y = bas) : bloc aux bords roulés devant / derrière et un
-- passepoil sur le devant (4 pièces)
function House3DKit.SeatCushion(b: Builder, x: number, y: number, z: number, w: number, h: number, d: number, color: Color3, piping: Color3?): BasePart
	local r = math.min(h, d * 0.45)
	local main = b.Box(x, y, z, w, h, d - r, color, MAT.Fabric)
	b.CylX(x, y + h / 2, z + d / 2 - r / 2, h, w, color, MAT.Fabric)
	b.CylX(x, y + h / 2, z - d / 2 + r / 2, h, w, color, MAT.Fabric)
	if piping then
		local pipe = math.max(0.8, h * 0.1)
		b.CylX(x, y + h / 2, z + d / 2 - pipe * 0.35, pipe, w + 0.2, piping, MAT.Fabric)
	end
	return main
end

-- Coussin moelleux orienté (centre = cframe, épaisseur d vers +z local) :
-- bloc aux bords haut / bas roulés + ventre bombé devant et derrière (4 pièces)
function House3DKit.PillowR(b: Builder, cframe: CFrame, w: number, h: number, d: number, color: Color3, material: Enum.Material?): BasePart
	local mat = material or MAT.Fabric
	local r = math.min(d, h * 0.45)
	local core = b.BoxR(cframe, w, h - r, r, color, mat)
	for _, sy in ipairs({ -1, 1 }) do
		local roll = b.Part("Part", cframe * CFrame.new(0, sy * (h - r) / 2, 0), Vector3.new(w, r, r), color, mat, "Cylindre")
		;(roll :: Part).Shape = Enum.PartType.Cylinder
		if b.Stretch ~= 1 then
			roundAgain(roll, false)
		end
	end
	b.EggR(cframe, w * 0.92, h * 0.86, math.max(d, r * 1.3), color, mat)
	return core
end

-- Feuille : ovale aplati qui part de (x, y, z) dans la direction (yaw autour
-- de y, puis pitch : > 0 vers le bas, < 0 vers le haut) ; nervure en option
function House3DKit.Leaf(b: Builder, x: number, y: number, z: number, length: number, width: number, yaw: number, pitch: number, color: Color3, rib: Color3?): BasePart
	local cf = CFrame.new(x, y, z) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0) * CFrame.new(0, 0, length / 2)
	local thick = math.max(0.5, width * 0.09)
	local leaf = b.EggR(cf, width, thick, length, color, MAT.SmoothPlastic)
	leaf.Name = "Feuille"
	if rib then
		b.BoxR(cf * CFrame.new(0, thick * 0.3, 0), math.max(0.4, width * 0.06), thick * 0.5, length * 0.86, rib, MAT.SmoothPlastic)
	end
	return leaf
end

-- Rangée de livres entre x0 et x1, posés en y, dos (face +z) en zFront :
-- épaisseurs, hauteurs et teintes variées, bandeaux dorés, un livre penché
function House3DKit.Books(b: Builder, x0: number, x1: number, y: number, zFront: number, depth: number, maxH: number, colors: { Color3 }, seed: number): number
	local x = x0
	local n = 0
	local gold = Color3.fromRGB(236, 196, 96)
	while x < x1 - 3 do
		n += 1
		local s = seed * 31 + n * 7
		local bw = 2.4 + ((s * 13) % 7) * 0.45
		if x + bw > x1 then
			break
		end
		local bh = maxH * (0.72 + ((s * 5) % 6) * 0.05)
		local bd = depth * (0.82 + ((s * 3) % 4) * 0.05)
		local color = House3DKit.Vary(colors[(s % #colors) + 1], s, 0.18)
		if x > x0 + (x1 - x0) * 0.72 and (s % 3) == 0 and x + bh * 0.5 < x1 then
			-- livre penché contre le précédent
			local angle = -0.42
			local cx = x + math.sin(-angle) * bh / 2 + bw / 2
			b.BoxR(CFrame.new(cx, y + math.cos(angle) * bh / 2 + math.abs(math.sin(angle)) * bw / 2, zFront - bd / 2) * CFrame.Angles(0, 0, angle), bw, bh, bd, color, MAT.SmoothPlastic)
			break
		end
		b.Box(x + bw / 2, y, zFront - bd / 2, bw, bh, bd, color, MAT.SmoothPlastic)
		if (s % 3) ~= 0 then
			-- bandeaux du dos (titre doré), en léger relief
			local g = House3DKit.Gap(b, 0.5)
			b.Box(x + bw / 2, y + bh * 0.72, zFront + g / 2 - 0.25, bw * 0.8, math.max(0.6, bh * 0.08), g + 0.5, gold, MAT.SmoothPlastic)
		end
		x += bw + 0.25
	end
	return n
end

-- Ampoule douce : boule lumineuse + PointLight (Brightness plafonnée à 1)
function House3DKit.Bulb(b: Builder, x: number, y: number, z: number, d: number, color: Color3, range: number, brightness: number?): BasePart
	local bulb = b.Ball(x, y, z, d, color)
	b.Neon(bulb)
	b.Light(bulb, color, range, math.min(1, brightness or 0.9))
	return bulb
end

-- Miroir (centre x, y ; z = plan de la glace, face vers +z = la pièce).
-- Contrat REALISM98 : une pièce "Mirror" (bloc fin), attributs Mirror = true,
-- MirrorFace = "Front" (normale = LookVector, vers la pièce) et MirrorShape
-- ("Rect" / "Oval"). Rect : cette pièce EST la glace (Reflectance = reflet
-- statique quand les reflets sont coupés) ; Oval : une glace ovale visible
-- et la pièce Mirror invisible juste devant (la SurfaceGui s'y pose).
function House3DKit.Mirror(b: Builder, x: number, y: number, z: number, w: number, h: number, shape: string?): BasePart
	local glassColor = Color3.fromRGB(214, 228, 238)
	local oval = shape == "Oval"
	local thin = 0.8
	if oval then
		local glass
		if math.abs(w - h) < 0.01 then
			glass = b.CylZ(x, y, z - thin / 2, w, thin, glassColor, MAT.Glass)
		else
			glass = b.EggR(CFrame.new(x, y, z - thin / 2), w, h, thin, glassColor, MAT.Glass)
		end
		glass.Name = "Glace"
		glass.Reflectance = 0.45
		glass.CastShadow = false
	end
	local k = math.max(b.K, 1e-3)
	local gap = oval and math.max(1.2, 0.05 / k) or 0
	local mirror = b.Part("Part", CFrame.new(x, y, z + gap - thin / 2) * CFrame.Angles(0, math.pi, 0), Vector3.new(w, h, thin), glassColor, MAT.Glass, "Mirror")
	mirror.Reflectance = 0.45
	mirror.CastShadow = false
	if oval then
		-- (ovale : la pièce taguée couvre le rectangle de l'ovale, invisible ;
		-- REALISM98 découpe l'image en ovale : MirrorShape = "Oval")
		mirror.Transparency = 1
	end
	mirror:SetAttribute("Mirror", true)
	mirror:SetAttribute("MirrorFace", "Front")
	mirror:SetAttribute("MirrorShape", oval and "Oval" or "Rect")
	return mirror
end

-- Finition "réaliste" des pièces créées depuis `fromIndex` : le métal
-- brille (reflet), le verre reflète un peu, le marbre est légèrement lustré
-- (seulement si la recette n'a pas déjà choisi un reflet)
local POLISH: { [Enum.Material]: number } = {
	[MAT.Metal] = 0.2,
	[MAT.DiamondPlate] = 0.15,
	[MAT.Glass] = 0.12,
	[MAT.Marble] = 0.04,
}
function House3DKit.Polish(b: Builder, fromIndex: number)
	for index = fromIndex + 1, #b.Parts do
		local part = b.Parts[index]
		local reflect = POLISH[part.Material]
		if reflect and part.Reflectance == 0 then
			part.Reflectance = reflect
		end
	end
end

-- Recette "polie" : la recette, puis Polish sur ses pièces
function House3DKit.Polished(recipe: (b: Builder, ctx: any) -> ()): (b: Builder, ctx: any) -> ()
	return function(b: Builder, ctx: any)
		local before = #b.Parts
		recipe(b, ctx)
		House3DKit.Polish(b, before)
	end
end

-- Lames de bois côte à côte le long de x (y = bas) : teintes légèrement
-- différentes, comme un vrai plateau en planches
function House3DKit.Planks(b: Builder, x: number, y: number, z: number, w: number, h: number, d: number, n: number, color: Color3, material: Enum.Material?, seed: number?)
	local pw = w / n
	for index = 1, n do
		local px = x - w / 2 + (index - 0.5) * pw
		b.Box(px, y, z, pw, h, d, House3DKit.Vary(color, (seed or 1) * 17 + index, 0.08), material or MAT.Wood)
	end
end

----------------------------------------------------------------------
-- Dessin 2D hors écran (palette, cartons)
----------------------------------------------------------------------

function House3DKit.Paint(item: any, entry: any, tint: ((root: Instance) -> ())?): Painted
	local wall = item.Placement == "Wall"
	local marginTop = wall and CARD_MARGIN_WALL or CARD_MARGIN_TOP
	local marginBottom = wall and CARD_MARGIN_WALL or CARD_MARGIN_BOTTOM
	local content = Instance.new("Frame")
	content.Name = tostring(item.Id)
	content.BackgroundTransparency = 1
	content.BorderSizePixel = 0
	content.Size = UDim2.fromOffset(100 + CARD_MARGIN_X * 2, 100 + marginTop + marginBottom)
	local body = Instance.new("Frame")
	body.Name = "Body"
	body.BackgroundTransparency = 1
	body.BorderSizePixel = 0
	body.Position = UDim2.fromOffset(CARD_MARGIN_X, marginTop)
	body.Size = UDim2.fromOffset(100, 100)
	body.ZIndex = 3
	body.Parent = content
	local painted = HouseArt.Paint(body, item, true)
	local detail: HouseArt.Result = painted or {}
	if painted == nil or detail.ShowEmoji == true then
		local emojiScale = detail.EmojiScale or 1
		local emoji = Instance.new("TextLabel")
		emoji.Name = "Emoji"
		emoji.AnchorPoint = Vector2.new(0.5, 0.5)
		emoji.Position = UDim2.fromScale(0.5, detail.EmojiY or (wall and 0.5 or 0.54))
		emoji.Size = UDim2.fromOffset(100 * emojiScale, 100 * emojiScale)
		emoji.BackgroundTransparency = 1
		emoji.Font = Enum.Font.BuilderSansMedium
		emoji.Text = tostring(item.Icon or "")
		emoji.TextColor3 = WHITE
		emoji.TextSize = math.floor(88 * emojiScale)
		emoji.TextYAlignment = wall and Enum.TextYAlignment.Center or Enum.TextYAlignment.Bottom
		emoji.ZIndex = 9
		emoji.Parent = body
	end
	if tint then
		pcall(tint, body)
	end
	if type(entry) == "table" and entry.F == true then
		pcall(HouseArt.Mirror, body, {}, 50)
	end
	local result: Painted = {
		Item = item,
		Content = content,
		Wall = wall,
		UnitsW = 100 + CARD_MARGIN_X * 2,
		UnitsH = 100 + marginTop + marginBottom,
		MarginTop = marginTop,
		MarginBottom = marginBottom,
		Glow = detail.Glow or (item.Category == "Lights" and BUTTER or nil),
		Flat = detail.Flat == true and not wall,
		Colors = {},
	}
	result.Colors = House3DKit.Palette(result)
	return result
end

-- Palette : couleurs du dessin, de la plus grande surface à la plus petite
function House3DKit.Palette(painted: Painted): { Color3 }
	local areas: { [string]: { Color: Color3, Area: number } } = {}
	local body = painted.Content:FindFirstChild("Body")
	if not body then
		return {}
	end
	for _, object in ipairs(body:GetDescendants()) do
		if object:IsA("Frame") and object.BackgroundTransparency < 0.5 and object.Visible then
			local size = object.Size
			local area = math.abs(size.X.Offset * size.Y.Offset)
			if area > 0 then
				local color = object.BackgroundColor3
				local key = string.format("%d_%d_%d", math.floor(color.R * 15 + 0.5), math.floor(color.G * 15 + 0.5), math.floor(color.B * 15 + 0.5))
				local slot = areas[key]
				if slot then
					slot.Area += area
				else
					areas[key] = { Color = color, Area = area }
				end
			end
		end
	end
	local list = {}
	for _, slot in pairs(areas) do
		table.insert(list, slot)
	end
	table.sort(list, function(a, b)
		return a.Area > b.Area
	end)
	local colors = {}
	for index = 1, math.min(8, #list) do
		table.insert(colors, list[index].Color)
	end
	return colors
end

return House3DKit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">House3DLayout</string>
              <string name="Source"><![CDATA[--[[
	House3DLayout (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > House3DLayout

	Passage 2D -> 3D des objets d'une pièce (v9.3), partagé par la vue 3D
	(House3DScene) et le monde (House3DScene.PlaceItems) :
	  - chaque objet posé devient un vrai modèle 3D (House3DRecipes.BuildModel) ;
	  - X de la pièce 2D -> x (les murs de côté en perspective de la pièce 2D
	    sont retirés), Y -> profondeur (les objets du fond vont contre le mur),
	    objets muraux à leur hauteur sur le mur du fond ;
	  - objets posés SUR un meuble (HouseSurfaces.SupportOf) : sur son vrai
	    dessus 3D ; chaises rangées à une table (HouseSurfaces.SeatedAt) :
	    de côté / derrière / devant, tournées vers elle ; F = miroir ;
	  - objets au sol qui se chevauchent : le suivant avance un peu.

	Repère de la pièce (`frame`) : x vers la droite (centré), y vers le haut
	(0 = dessus du sol), z vers l'avant (0 = face intérieure du mur du fond,
	D = bord avant). Les modèles regardent l'avant de la pièce (+z).

	API :
	  House3DLayout.Dims(sizeDef, px, depth, wallHeight?) -> Dims
	  House3DLayout.Entries(room) -> ({ Placed }, { index dans room.Placed })
	  House3DLayout.Prepare(entry, order, dims, options) -> Build?
	  House3DLayout.Layout(builds, dims, frame)       (Build.Pivot = pivot du modèle)
]]

local HouseCommon = require(script.Parent.HouseCommon)
local HouseSurfaces = require(script.Parent.HouseSurfaces)
local House3DRecipes = require(script.Parent.House3DRecipes)

type Placed = HouseCommon.Placed

local House3DLayout = {}

local ROOM_BASE_WIDTH = 760 -- (= HouseRoom.BASE_WIDTH)
local ROOM_HEIGHT = 440 -- (= HouseRoom.HEIGHT)
local SIDE_PX = 42 -- murs de côté en perspective de la pièce 2D (HouseRoom)
local DEPTH_CURVE = 1.35 -- (Y 2D -> profondeur) les objets du fond vont vraiment contre le mur
local TURN = CFrame.Angles(0, math.pi, 0) -- modèle (devant -Z) <-> repère de recette (devant +Z)

export type Dims = {
	PX: number, -- studs par px de la pièce 2D
	RoomWpx: number,
	RoomHpx: number,
	WallPx: number,
	WallRatio: number,
	W: number, -- (studs) largeur intérieure
	D: number, -- profondeur
	WH: number, -- hauteur des murs
}

export type Build = {
	Entry: Placed,
	Item: any,
	Model: Model,
	Data: House3DRecipes.ItemData,
	K: number,
	Kind: string, -- "Wall" | "Flat" | "Floor"
	Parent: Build?,
	Relation: string?, -- "On" | "At"
	SeatKind: string?,
	SurfaceIndex: number,
	Surface: any?,
	Origin: CFrame, -- repère de la recette (devant +z de la pièce)
	Pivot: CFrame, -- pivot du modèle (= Origin tourné d'un demi-tour)
	X: number,
	Z: number,
	FW: number, -- empreinte (studs) une fois tourné
	FD: number,
	Yaw: number,
	Placed: boolean,
	Order: number,
}

local function finite(value: any, default: number): number
	local number = tonumber(value)
	if number == nil or number ~= number or number == math.huge or number == -math.huge then
		return default
	end
	return number
end

function House3DLayout.Dims(sizeDef: any, px: number, depth: number, wallHeight: number?): Dims
	local config = HouseCommon.Config
	local widthFactor = type(sizeDef) == "table" and tonumber(sizeDef.Width) or 1
	local roomWpx = math.floor(ROOM_BASE_WIDTH * (widthFactor or 1) + 0.5)
	local wallRatio = tonumber(config.WallRatio) or 0.46
	local wallPx = math.floor(ROOM_HEIGHT * wallRatio + 0.5)
	return {
		PX = px,
		RoomWpx = roomWpx,
		RoomHpx = ROOM_HEIGHT,
		WallPx = wallPx,
		WallRatio = wallRatio,
		W = roomWpx * px,
		D = depth,
		WH = wallHeight or wallPx * px,
	}
end

-- Rotation libre d'un objet (entry.R, degrés, multiple de 15 entre 15 et
-- 345 ; nil = 0). Ajoutée par le monde (Dopamine Town)
function House3DLayout.Rotation(value: any): number?
	local degrees = tonumber(value)
	if degrees == nil or degrees ~= degrees then
		return nil
	end
	degrees = math.floor(degrees / 15 + 0.5) * 15 % 360
	if degrees == 0 then
		return nil
	end
	return degrees
end

-- Objets posés valides d'une pièce (valeurs bornées ; objets inconnus ignorés)
function House3DLayout.Entries(room: any): ({ Placed }, { number })
	local entries: { Placed } = {}
	local indices: { number } = {}
	local list = type(room) == "table" and room.Placed or nil
	if type(list) ~= "table" then
		return entries, indices
	end
	for position, raw in ipairs(list) do
		if type(raw) == "table" and type(raw.I) == "string" and HouseCommon.ItemsById[raw.I] then
			local entry: any = {
				I = raw.I,
				X = math.clamp(finite(raw.X, 0.5), 0, 1),
				Y = math.clamp(finite(raw.Y, 0.8), 0, 1),
				S = math.clamp(finite(raw.S, 1), 0.2, 3),
				Z = finite(raw.Z, 0),
				F = raw.F == true or nil,
				C = type(raw.C) == "string" and raw.C or nil,
				R = House3DLayout.Rotation(raw.R),
			}
			table.insert(entries, entry)
			table.insert(indices, position)
		end
	end
	return entries, indices
end

-- 1. modèle 3D d'un objet (pas encore placé)
function House3DLayout.Prepare(entry: Placed, order: number, dims: Dims, options: House3DRecipes.BuildOptions?): Build?
	local item = HouseCommon.ItemsById[entry.I]
	if not item then
		return nil
	end
	local opts: any = table.clone(options or {})
	opts.Scale = dims.PX
	local model, data = House3DRecipes.BuildModel(entry.I, entry, opts)
	if not model or not data then
		return nil
	end
	local wall = item.Placement == "Wall"
	return {
		Entry = entry,
		Item = item,
		Model = model,
		Data = data,
		K = data.K,
		Kind = wall and "Wall" or (data.Info.Flat and "Flat" or "Floor"),
		Parent = nil,
		Relation = nil,
		SeatKind = nil,
		SurfaceIndex = 1,
		Surface = nil,
		Origin = CFrame.identity,
		Pivot = CFrame.identity,
		X = 0,
		Z = 0,
		FW = data.FW,
		FD = data.FD,
		Yaw = 0,
		Placed = false,
		Order = order,
	}
end

-- 2. relations (posé sur / rangé à) et positions dans le repère `frame`
function House3DLayout.Layout(builds: { Build }, dims: Dims, frame: CFrame)
	local W, D, WH, PX = dims.W, dims.D, dims.WH, dims.PX
	local roomWpx, roomHpx, wallPx = dims.RoomWpx, dims.RoomHpx, dims.WallPx
	local function at(x: number, y: number, z: number): CFrame
		return frame * CFrame.new(x, y, z)
	end
	-- 2D (px de la pièce) -> 3D : les murs de côté 2D prennent SIDE_PX en perspective
	local function mapX(x: number, t: number, half: number): number
		local sidePx = SIDE_PX * (1 - math.clamp(t, 0, 1))
		local px = (x * roomWpx - sidePx) / math.max(1, roomWpx - 2 * sidePx) * roomWpx
		local studs = (px - roomWpx / 2) * PX
		local limit = math.max(0, W / 2 - half - 0.1)
		return math.clamp(studs, -limit, limit)
	end
	local function depthOf(y: number): number
		return math.clamp((y - dims.WallRatio) / math.max(0.05, 1 - dims.WallRatio), 0, 1)
	end

	local byEntry: { [Placed]: Build } = {}
	local list: { Placed } = {}
	for _, build in ipairs(builds) do
		byEntry[build.Entry] = build
		table.insert(list, build.Entry)
	end
	for _, build in ipairs(builds) do
		if build.Kind ~= "Wall" then
			local okSupport, support = pcall(HouseSurfaces.SupportOf, build.Entry, list, roomWpx, roomHpx)
			local supportEntry = okSupport and type(support) == "table" and support.Entry or nil
			if supportEntry and byEntry[supportEntry] and supportEntry ~= build.Entry then
				build.Parent = byEntry[supportEntry]
				build.Relation = "On"
				build.Surface = support
				build.SurfaceIndex = tonumber(support.Index) or 1
				if build.Kind == "Flat" then
					build.Kind = "Floor"
				end
			elseif build.Kind == "Floor" then
				local okSeat, seat = pcall(HouseSurfaces.SeatedAt, build.Entry, list, roomWpx, roomHpx)
				local tableEntry = okSeat and type(seat) == "table" and seat.Table or nil
				if tableEntry and byEntry[tableEntry] and tableEntry ~= build.Entry then
					build.Parent = byEntry[tableEntry]
					build.Relation = "At"
					build.SeatKind = tostring(seat.Kind)
				end
			end
		end
	end
	-- (boucles éventuelles coupées)
	for _, build in ipairs(builds) do
		local node = build
		local steps = 0
		while node.Parent and steps < 8 do
			node = node.Parent :: Build
			steps += 1
		end
		if steps >= 8 then
			build.Parent = nil
			build.Relation = nil
		end
	end

	-- Racines au sol : du fond vers l'avant ; on écarte ce qui se chevauche
	local roots: { Build } = {}
	for _, build in ipairs(builds) do
		if build.Parent == nil then
			table.insert(roots, build)
		end
	end
	table.sort(roots, function(a, b)
		if a.Entry.Y ~= b.Entry.Y then
			return a.Entry.Y < b.Entry.Y
		end
		return a.Order < b.Order
	end)
	local placedFloor: { Build } = {}
	local wallRank = 0
	for _, build in ipairs(roots) do
		local entry = build.Entry
		if build.Kind == "Wall" then
			local half = math.min(build.FW / 2, W / 2)
			build.X = mapX(entry.X, 0, half)
			local centerY = math.clamp((wallPx - entry.Y * roomHpx) * PX, 0.4, WH - 0.2)
			wallRank += 1
			build.Z = 0.02 + wallRank * 0.01
			build.Origin = at(build.X, centerY - 50 * build.K, build.Z)
		else
			local t = depthOf(entry.Y)
			local seat = HouseSurfaces.Seat(entry.I)
			if seat and seat.View == "Side" then
				-- (chaise de profil en 2D : un peu tournée vers où elle regarde)
				build.Yaw = entry.F and -math.rad(35) or math.rad(35)
			end
			local fw, fd = build.FW, build.FD
			build.X = mapX(entry.X, t, fw / 2)
			local zFront = (t ^ DEPTH_CURVE) * D
			local z
			if build.Data.Info.Wall and t < 0.55 then
				z = fd / 2 + 0.08
			else
				z = math.clamp(zFront - fd / 2, fd / 2 + 0.08, math.max(fd / 2 + 0.08, D - fd / 2 - 0.1))
			end
			if build.Kind == "Floor" then
				-- chevauchement avec un objet déjà posé : on avance un peu
				for _ = 1, 6 do
					local moved = false
					for _, other in ipairs(placedFloor) do
						local overlapX = math.abs(other.X - build.X) < (other.FW + fw) / 2 - 0.15
						local overlapZ = math.abs(other.Z - z) < (other.FD + fd) / 2
						if overlapX and overlapZ then
							local pushed = other.Z + (other.FD + fd) / 2 + 0.05
							if pushed + fd / 2 <= D + 0.5 then
								z = pushed
								moved = true
							end
						end
					end
					if not moved then
						break
					end
				end
				table.insert(placedFloor, build)
			end
			build.Z = z
			local lift = build.Kind == "Flat" and 0.01 + (#placedFloor % 5) * 0.004 or 0
			build.Origin = at(build.X, lift, z) * CFrame.Angles(0, build.Yaw, 0)
		end
		build.Placed = true
	end

	-- Membres des groupes (posés sur / rangés à)
	local rotation = frame.Rotation
	local function place(build: Build, guard: number)
		if build.Placed or guard > 10 then
			return
		end
		local parent = build.Parent
		if not parent then
			build.Placed = true
			return
		end
		place(parent, guard + 1)
		local entry = build.Entry
		if build.Relation == "On" then
			local surface = build.Surface
			local centerX = surface and ((tonumber(surface.L) or entry.X) + (tonumber(surface.R) or entry.X)) / 2 or parent.Entry.X
			local dx = (entry.X - centerX) * roomWpx * PX
			local top = parent.Data.Tops[build.SurfaceIndex] or parent.Data.Tops[1]
			local base: CFrame
			if top then
				local k = parent.K
				dx = math.clamp(dx, -top.W * k / 2, top.W * k / 2)
				base = parent.Origin * CFrame.new(top.X * k, top.Y * k, top.Z * k)
			else
				base = parent.Origin * CFrame.new(0, parent.Data.H, 0)
			end
			local world = base.Position + frame.RightVector * dx
			local rel = frame:PointToObjectSpace(world)
			build.X = rel.X
			build.Z = rel.Z
			build.Origin = CFrame.new(world) * rotation
		else
			-- chaise à une table : de côté (tournée vers elle), derrière ou devant
			local tableX, tableZ = parent.X, parent.Z
			local tw, td = parent.FW, parent.FD
			local cd = build.FD
			local tuck = math.min(cd * 0.3, 0.8)
			local kind = build.SeatKind or "Front"
			local x, z, yaw = tableX, tableZ, 0
			local dx = (entry.X - parent.Entry.X) * roomWpx * PX
			if kind == "Left" then
				x = tableX - tw / 2 - cd / 2 + tuck
				yaw = math.pi / 2
			elseif kind == "Right" then
				x = tableX + tw / 2 + cd / 2 - tuck
				yaw = -math.pi / 2
			elseif kind == "Behind" then
				x = tableX + math.clamp(dx, -tw / 2, tw / 2)
				z = tableZ - td / 2 - cd / 2 + tuck
				yaw = 0
			else
				x = tableX + math.clamp(dx, -tw / 2, tw / 2)
				z = tableZ + td / 2 + cd / 2 - tuck
				yaw = math.pi
			end
			x = math.clamp(x, -W / 2 + 0.3, W / 2 - 0.3)
			z = math.clamp(z, 0.3, D + 0.6)
			build.X, build.Z, build.Yaw = x, z, yaw
			build.Origin = at(x, 0, z) * CFrame.Angles(0, yaw, 0)
		end
		build.Placed = true
	end
	for _, build in ipairs(builds) do
		place(build, 0)
	end
	-- Rotation libre (entry.R) autour du centre de l'empreinte (objets au
	-- sol ; une chaise rangée à une table y reste tournée si R est absent).
	-- v9.6 : ce qui est posé sur un meuble / rangé à une table tourne AVEC
	-- lui (autour du pivot du meuble), puis selon sa propre rotation.
	local unrotated: { [Build]: CFrame } = {}
	for _, build in ipairs(builds) do
		unrotated[build] = build.Origin
	end
	local function spin(build: Build): CFrame
		local degrees = (build.Entry :: any).R
		if build.Kind ~= "Wall" and type(degrees) == "number" and degrees ~= 0 then
			local origin = unrotated[build]
			return origin * CFrame.Angles(0, math.rad(degrees), 0) * origin:Inverse()
		end
		return CFrame.identity
	end
	for _, build in ipairs(builds) do
		local cframe = spin(build) * unrotated[build]
		local node = build.Parent
		local guard = 0
		while node and guard < 10 do
			cframe = spin(node) * cframe
			node = node.Parent
			guard += 1
		end
		build.Origin = cframe
		build.Pivot = cframe * TURN
	end
end

return House3DLayout
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">House3DLuxe</string>
              <string name="Source"><![CDATA[--[[
	House3DLuxe (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > House3DLuxe

	(v9.8 CATALOG98) Modèles 3D des 65 nouveaux objets de la maison : moderne /
	minimaliste, loft industriel, déco, lumières, plantes, tech, cuisine,
	coin gamer, sport, 💎 luxe et objets "incroyables" (tunnel aquarium,
	cascade intérieure, dragon d'or, mini montagnes russes...). Les télés XXL
	et l'écran de home cinéma (catégorie Setup) sont dessinés par
	House3DSetup (DESK98), pas ici.

	Mêmes conventions que House3DRecipes (Register) : House3DKit.Builder,
	boîte 2D = 100 unités, y = hauteur depuis le sol, +z = le devant (le
	modèle final de BuildModel regarde -Z) ; objets muraux : z = 0 = le mur,
	y = 100 - y du dessin 2D. Les dessus (b.Top) sont aux hauteurs de
	HouseSurfaces (ctx.TopY) : ce qu'on pose dessus tombe juste. Les sièges
	(b.Seat) donnent une "SeatPart" dans le monde.
	Matières réalistes (bois, métal, cuir, tissu, marbre, verre) ; lumières
	douces (b.Light : Brightness <= 0.9, portée courte) ; Neon réservé aux
	petites pièces (ampoules, bandes LED, écrans).

	Branché par House3DRecipes : loadFamilies("House3DLuxe").
]]

local House3DKit = require(script.Parent.House3DKit)
-- (v9.9 SCALE99) aiguilles à l'heure réelle
local House3DTime = require(script.Parent.House3DTime)

type Builder = House3DKit.Builder

local House3DLuxe = {}

local M = Enum.Material
local rgb = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)
local OAK = rgb(214, 172, 120)
local OAK_DARK = rgb(170, 128, 84)
local WALNUT = rgb(128, 84, 56)
local WALNUT_DARK = rgb(92, 60, 42)
local STEEL = rgb(186, 192, 204)
local STEEL_DARK = rgb(112, 118, 132)
local IRON = rgb(64, 66, 76)
local IRON_DARK = rgb(40, 42, 50)
local CONCRETE = rgb(176, 174, 170)
local LEATHER = rgb(142, 80, 50)
local LINEN = rgb(226, 220, 208)
local GREIGE = rgb(176, 168, 158)
local MARBLE = rgb(240, 238, 236)
local MARBLE_VEIN = rgb(188, 186, 194)
local GLASS = rgb(186, 222, 236)
local LEAF = rgb(84, 150, 84)
local LEAF_DARK = rgb(52, 110, 62)
local LEAF_LIGHT = rgb(128, 190, 110)
local TERRACOTTA = rgb(206, 116, 80)
local CERAMIC = rgb(236, 232, 226)
local SCREEN = rgb(30, 36, 60)
local CYAN = rgb(60, 222, 255)
local MAGENTA = rgb(255, 84, 196)
local LIME = rgb(140, 240, 110)
local RED = rgb(226, 64, 70)
local ORANGE = rgb(255, 150, 60)
local AMBER = rgb(255, 214, 150)
local BLUE = rgb(70, 130, 220)
local GOLD = rgb(236, 190, 70)
local GOLD_DARK = rgb(180, 136, 40)
local GOLD_LIGHT = rgb(255, 226, 130)
local VELVET = rgb(120, 60, 150)
local WATER = rgb(80, 180, 230)
local WATER_DEEP = rgb(30, 110, 190)
local STONE = rgb(150, 146, 140)
local STONE_DARK = rgb(104, 100, 98)
local FIRE = rgb(255, 150, 60)
local FELT = rgb(30, 130, 80)
local darken = House3DKit.Darken
local lighten = House3DKit.Lighten

local R: { [string]: (b: Builder, ctx: any) -> () } = {}

----------------------------------------------------------------------
-- Petits outils
----------------------------------------------------------------------

local function glass(part: BasePart, transparency: number): BasePart
	part.Transparency = transparency
	part.CastShadow = false
	return part
end

-- Pièce lumineuse (Neon, pas d'ombre) : petites pièces seulement
local function glow(b: Builder, part: BasePart): BasePart
	b.Neon(part)
	return part
end

-- Rangée de livres posés sur une planche (bas = y), de x0 à x1, contre z
local BOOK_COLORS = { rgb(176, 64, 64), rgb(60, 96, 150), rgb(220, 190, 120), rgb(70, 120, 90), rgb(120, 80, 140), rgb(236, 226, 206), rgb(200, 120, 70) }
local function books(b: Builder, x0: number, x1: number, y: number, z: number, depth: number, maxH: number, seed: number)
	local x = x0
	local n = seed
	while x < x1 - 3 do
		n += 1
		local w = 3 + (n * 7) % 3
		local h = maxH * (0.7 + ((n * 13) % 5) * 0.07)
		if x + w > x1 then
			break
		end
		b.Box(x + w / 2, y, z, w - 0.3, h, depth, BOOK_COLORS[(n % #BOOK_COLORS) + 1], M.SmoothPlastic)
		x += w + 0.4
	end
end

-- Pot (bas = sol) avec terre ; renvoie le haut de la terre
local function pot(b: Builder, x: number, z: number, w: number, h: number, color: Color3, material: Enum.Material?): number
	b.Cyl(x, 0, z, w * 0.84, h - 3, color, material or M.SmoothPlastic)
	b.Cyl(x, h - 4, z, w, 4, lighten(color, 0.1), material or M.SmoothPlastic)
	b.Cyl(x, h - 3.2, z, w * 0.84, 2.6, rgb(92, 66, 48), M.Ground)
	return h - 0.6
end

-- Feuille plate (ovale fin) au bout d'une tige, orientée par (yaw, pitch)
local function leafAt(b: Builder, x: number, y: number, z: number, w: number, h: number, color: Color3, yaw: number, tilt: number)
	b.EggR(CFrame.new(x, y, z) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(0, 0, tilt), w, h, 2.2, color, M.SmoothPlastic)
end

-- Petit poisson (ovale + queue) orienté vers +x (dir = 1) ou -x
local function fish(b: Builder, x: number, y: number, z: number, size: number, color: Color3, dir: number)
	b.Egg(x, y, z, size, size * 0.56, size * 0.34, color, M.SmoothPlastic)
	b.Wedge(x - dir * size * 0.62, y - size * 0.2, z, size * 0.34, size * 0.4, size * 0.12, darken(color, 0.1), dir > 0 and "Left" or "Right", M.SmoothPlastic)
	b.Ball(x + dir * size * 0.26, y + size * 0.06, z + size * 0.14, size * 0.12, rgb(30, 30, 40), M.SmoothPlastic)
end

-- Coussin carré posé (y = bas)
local function pillow(b: Builder, x: number, y: number, z: number, w: number, h: number, d: number, color: Color3, lean: number?)
	b.EggR(CFrame.new(x, y + h / 2, z) * CFrame.Angles(lean or 0, 0, 0), w, h, d, color, M.Fabric)
end

----------------------------------------------------------------------
-- 🛋️ Moderne / minimaliste / loft
----------------------------------------------------------------------

R.SimpleChair = function(b, ctx)
	local seat = ctx.TopY(1, 44)
	local wood = b.Map(OAK)
	local white = b.Map(rgb(248, 248, 246))
	for _, sx in ipairs({ -1, 1 }) do
		b.Tube(sx * 22, 0, 18, sx * 20, seat - 4, 14, 5, wood, M.Wood)
		b.Tube(sx * 22, 0, -18, sx * 20, seat - 4, -14, 5, wood, M.Wood)
		b.Tube(sx * 18, seat, -16, sx * 16, seat + 30, -20, 4, wood, M.Wood)
	end
	b.Tube(-21, 14, 16.5, 21, 14, 16.5, 3, darken(wood, 0.1), M.Wood)
	b.Round(0, seat - 6, 0, 62, 6, 42, 8, white, M.SmoothPlastic)
	-- dossier incurvé (3 plaques)
	for index = -1, 1 do
		b.BoxR(CFrame.new(index * 15.5, seat + 36, -21 + math.abs(index) * 2.5) * CFrame.Angles(-0.12, -index * 0.28, 0), 16, 24, 3, white, M.SmoothPlastic)
	end
	b.Top(1, 0, seat, 2, 56, 36)
	b.Footprint(64, 46, seat + 48)
end

R.CoatRack = function(b, _ctx)
	local wood = b.Map(WALNUT)
	b.Cyl(0, 0, 0, 36, 3, darken(wood, 0.2), M.Wood)
	for index = 0, 2 do
		local a = index / 3 * math.pi * 2
		b.Tube(0, 14, 0, math.cos(a) * 16, 2, math.sin(a) * 16, 3, wood, M.Wood)
	end
	b.Cyl(0, 3, 0, 5, 90, wood, M.Wood)
	b.Ball(0, 94, 0, 8, b.Map(OAK), M.Wood)
	for index = 0, 3 do
		local a = index / 4 * math.pi * 2 + 0.4
		b.Tube(0, 84, 0, math.cos(a) * 10, 90, math.sin(a) * 10, 2.4, wood, M.Wood)
		b.Ball(math.cos(a) * 10, 90, math.sin(a) * 10, 4, b.Map(OAK), M.Wood)
	end
	-- manteau camel suspendu (côté gauche), écharpe rayée, chapeau
	local coat = b.Map(rgb(196, 150, 96))
	b.EggR(CFrame.new(-9, 62, 3) * CFrame.Angles(0, 0, 0.08), 18, 46, 12, coat, M.Fabric)
	b.Box(-9, 36, 3, 16, 12, 11, coat, M.Fabric)
	for index = 0, 2 do
		b.Ball(-4, 50 + index * 9, 9.2, 2.2, WALNUT_DARK, M.SmoothPlastic)
	end
	b.Box(8, 52, 4, 7, 34, 3, rgb(200, 60, 70), M.Fabric)
	for index = 0, 3 do
		b.Box(8, 56 + index * 8, 5.8, 7.4, 2, 0.8, WHITE, M.Fabric)
	end
	b.Cyl(12, 88, 6, 22, 1.6, rgb(60, 60, 72), M.Fabric)
	b.Cyl(12, 89.4, 6, 13, 9, rgb(60, 60, 72), M.Fabric)
	b.Cyl(12, 89.6, 6, 13.6, 2.2, rgb(170, 60, 60), M.Fabric)
	b.Footprint(40, 40, 100)
end

R.BarrelTable = function(b, ctx)
	local top = ctx.TopY(1, 70)
	local paint = b.Map(rgb(48, 96, 120))
	b.Cyl(0, 0, 0, 64, top - 4, paint, M.Metal)
	for _, y in ipairs({ 6, top * 0.45, top - 12 }) do
		b.Cyl(0, y, 0, 66, 2.5, darken(paint, 0.25), M.Metal)
	end
	-- étiquette peinte "DOPA" (plaque bombée à l'avant)
	b.Box(0, top * 0.55, 31.4, 26, 10, 1, rgb(240, 220, 170), M.SmoothPlastic)
	b.Box(0, top * 0.55 + 3.5, 32.1, 20, 2, 0.6, paint, M.SmoothPlastic)
	b.Cyl(0, top - 4, 0, 76, 4, b.Map(OAK), M.Wood)
	b.Top(1, 0, top, 0, 70, 70)
	b.Footprint(76, 76, top)
end

R.ModernBarStool = function(b, ctx)
	local seat = ctx.TopY(1, 70)
	local leather = b.Map(LEATHER)
	b.Cyl(0, 0, 0, 38, 2.5, STEEL_DARK, M.Metal)
	b.Cyl(0, 2.5, 0, 6, seat - 8, STEEL, M.Metal)
	-- repose-pieds en anneau (8 tubes)
	local ring = 14
	for index = 0, 7 do
		local a0, a1 = index / 8 * math.pi * 2, (index + 1) / 8 * math.pi * 2
		b.Tube(math.cos(a0) * ring, 28, math.sin(a0) * ring, math.cos(a1) * ring, 28, math.sin(a1) * ring, 2.4, STEEL, M.Metal)
	end
	for index = 0, 1 do
		local a = index * math.pi
		b.Tube(0, 28, 0, math.cos(a + 0.8) * ring, 28, math.sin(a + 0.8) * ring, 2, STEEL, M.Metal)
	end
	b.Cyl(0, seat - 9, 0, 34, 3, STEEL_DARK, M.Metal)
	b.Cyl(0, seat - 6, 0, 44, 6, leather, M.Leather)
	-- petit dossier bas
	b.BoxR(CFrame.new(0, seat + 6, -19) * CFrame.Angles(-0.15, 0, 0), 40, 12, 4, leather, M.Leather)
	for _, sx in ipairs({ -1, 1 }) do
		b.Tube(sx * 14, seat - 5, -16, sx * 14, seat + 2, -19, 3, STEEL, M.Metal)
	end
	b.Top(1, 0, seat, 2, 36, 34)
	b.Footprint(46, 46, seat + 13)
end

R.OakDesk = function(b, ctx)
	local top = ctx.TopY(1, 58)
	local x0, x1 = ctx.Span(1, -48, 48)
	local w, depth = x1 - x0, 50
	local oak = b.Map(OAK)
	-- pieds "épingle" (2 tiges par pied)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			local x, z = sx * (w / 2 - 6), sz * (depth / 2 - 5)
			b.Tube(x, 0, z, x - sx * 2, top - 5, z - sz * 5, 1.8, IRON, M.Metal)
			b.Tube(x, 0, z, x - sx * 8, top - 5, z, 1.8, IRON, M.Metal)
		end
	end
	-- tiroir fin sous le plateau (à droite)
	b.Box(w * 0.2, top - 13, 2, w * 0.36, 8, depth - 8, OAK_DARK, M.Wood)
	b.Box(w * 0.2, top - 10, depth / 2 - 1.5, 10, 1.4, 1, IRON_DARK, M.Metal)
	b.Box(0, top - 5, 0, w, 5, depth, oak, M.Wood)
	b.Top(1, (x0 + x1) / 2, top, 0, w, depth)
	b.Footprint(w, depth, top)
end

R.MediaConsole = function(b, ctx)
	local top = ctx.TopY(1, 40)
	local walnut = b.Map(WALNUT)
	local depth = 38
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			b.Tube(sx * 40, 11, sz * 13, sx * 44, 0, sz * 15, 3, WALNUT_DARK, M.Wood)
		end
	end
	b.Box(0, 10, 0, 96, top - 13, depth, walnut, M.Wood)
	for index = -1, 1 do
		local x = index * 31
		b.Box(x, 12, depth / 2, 29, top - 17, 1, lighten(walnut, 0.08), M.Wood)
		-- cannage (lattes claires)
		for k = 0, 4 do
			b.Box(x, 15 + k * (top - 22) / 5, depth / 2 + 0.6, 24, 1, 0.4, rgb(214, 186, 140), M.Fabric)
		end
		b.Box(x + (index == 0 and 12 or -12), 20, depth / 2 + 1, 1.6, 6, 1, GOLD, M.Metal)
	end
	b.Box(0, top - 3, 0, 98, 3, depth + 2, darken(walnut, 0.2), M.Wood)
	b.Top(1, 0, top, 0, 94, depth)
	b.Footprint(98, depth + 2, top)
end

R.GlassCoffeeTable = function(b, ctx)
	local top = ctx.TopY(1, 38)
	local depth = 56
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			b.Box(sx * 43, 0, sz * 23, 4, top - 3, 4, STEEL, M.Metal)
		end
		b.Box(sx * 43, 0, 0, 4, 3, depth - 8, STEEL_DARK, M.Metal)
	end
	glass(b.Box(0, top * 0.36, 0, 82, 2, depth - 12, GLASS, M.Glass), 0.4)
	-- livres + bougie sur l'étagère du bas
	b.Box(-18, top * 0.36 + 2, 4, 20, 3, 14, rgb(60, 96, 150), M.SmoothPlastic)
	b.Box(-18, top * 0.36 + 5, 4, 16, 2.4, 12, rgb(236, 226, 206), M.SmoothPlastic)
	b.Cyl(14, top * 0.36 + 2, -6, 8, 8, CERAMIC, M.SmoothPlastic)
	glass(b.Box(0, top - 3, 0, 98, 3, depth, b.Map(rgb(170, 214, 228)), M.Glass), 0.3)
	b.Top(1, 0, top, 0, 94, depth - 4)
	b.Footprint(98, depth, top)
end

R.LoftShelf = function(b, ctx)
	local depth = 30
	local levels = { ctx.TopY(1, 92), ctx.TopY(2, 66), ctx.TopY(3, 40), ctx.TopY(4, 14) }
	local plank = b.Map(rgb(176, 130, 88))
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			b.Cyl(sx * 42, 0, sz * (depth / 2 - 3), 4.5, levels[1] + 4, IRON_DARK, M.Metal)
		end
	end
	for index, y in ipairs(levels) do
		b.Box(0, y - 4, 0, 92, 4, depth, plank, M.WoodPlanks)
		for _, sx in ipairs({ -1, 1 }) do
			b.Box(sx * 42, y - 7, 0, 3, 3, depth - 2, IRON, M.Metal) -- traverse sous la planche
		end
		b.Top(index, 0, y, depth * 0.2, 80, depth * 0.55)
	end
	-- déco au fond des rayons (le devant reste libre)
	books(b, -36, 0, levels[2], -8, 12, 18, 3)
	b.Cyl(22, levels[2], -7, 12, 12, TERRACOTTA, M.SmoothPlastic)
	b.Egg(19, levels[2] + 17, -7, 8, 12, 3, LEAF, M.SmoothPlastic)
	b.Egg(25, levels[2] + 16, -7, 8, 12, 3, LEAF_DARK, M.SmoothPlastic)
	b.Box(-24, levels[3], -7, 22, 13, 14, rgb(120, 118, 114), M.Metal)
	books(b, 2, 36, levels[3], -8, 12, 18, 11)
	b.Box(-20, levels[4], -6, 26, 12, 16, rgb(200, 170, 120), M.Fabric)
	b.Ball(22, levels[4] + 7, -6, 13, rgb(90, 90, 96), M.Metal)
	b.Footprint(94, depth, levels[1])
end

R.PlatformBed = function(b, ctx)
	local top = ctx.TopY(1, 30)
	local depth = 80
	local oak = b.Map(OAK)
	local duvet = b.Map(rgb(124, 140, 150))
	b.Box(2, 0, 0, 84, 3, depth - 10, OAK_DARK, M.Wood) -- socle en retrait
	b.Box(2, 3, 0, 94, 10, depth, oak, M.Wood)
	b.Box(2, 13, 0, 90, top - 13, depth - 4, WHITE, M.Fabric)
	b.Box(12, top - 6, 0, 68, 7, depth - 2, duvet, M.Fabric)
	b.Box(-19, top - 5.6, 0, 8, 7, depth - 1, rgb(210, 214, 216), M.Fabric)
	-- tête de lit capitonnée (à gauche)
	b.Round(-44, 3, 0, 10, 50, depth, 4, b.Map(GREIGE), M.Fabric)
	for k = 0, 2 do
		b.Box(-38.6, 16 + k * 12, 0, 0.8, 1.2, depth - 8, darken(GREIGE, 0.2), M.Fabric)
	end
	for _, z in ipairs({ -depth * 0.24, depth * 0.24 }) do
		b.EggR(CFrame.new(-32, top + 4, z) * CFrame.Angles(0, 0, -0.35), 18, 9, depth * 0.4, WHITE, M.Fabric)
	end
	b.EggR(CFrame.new(-26, top + 3, 0) * CFrame.Angles(0, 0, -0.3), 12, 8, 18, rgb(214, 196, 170), M.Fabric)
	b.Top(1, 6, top + 1, 0, 76, depth - 10)
	b.Footprint(100, depth, 53)
end

R.Workbench = function(b, ctx)
	local top = ctx.TopY(1, 60)
	local depth = 50
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			b.Tube(sx * 36 - 8, 0, sz * 20, sx * 36, top - 6, sz * 18, 4, IRON, M.Metal)
			b.Tube(sx * 36 + 8, 0, sz * 20, sx * 36, top - 6, sz * 18, 4, IRON, M.Metal)
		end
	end
	b.Box(0, 22, 0, 72, 4, 38, IRON_DARK, M.Metal) -- étagère basse
	b.Box(18, 26, 2, 22, 12, 14, RED, M.Metal) -- caisse à outils
	b.Box(18, 38, 2, 10, 3, 3, IRON, M.Metal)
	b.Box(0, top - 7, 0, 98, 7, depth, b.Map(rgb(186, 140, 94)), M.WoodPlanks)
	-- étau à droite
	b.Box(40, top, depth / 2 - 6, 10, 6, 10, rgb(60, 110, 160), M.Metal)
	b.Tube(40, top + 3, depth / 2 - 1, 40, top + 3, depth / 2 + 6, 1.6, STEEL, M.Metal)
	b.Top(1, -4, top, 0, 84, depth)
	b.Footprint(98, depth, top + 6)
end

-- Canapé moderne : base, dossiers, coussins ; `chaise` = méridienne à droite
local function modernSofa(b: Builder, seat: number, fabric: Color3, chaise: boolean)
	local depth = 46
	for _, x in ipairs({ -44, 0, 44 }) do
		for _, z in ipairs({ -18, 18 }) do
			b.Cyl(x, 0, z, 4, 5, WALNUT, M.Wood)
		end
	end
	b.Box(0, 5, 0, 98, seat - 14, depth, darken(fabric, 0.12), M.Fabric)
	for index = -1, 1 do
		b.Cushion(index * 31, seat - 10, 4, 31, 10, depth - 12, lighten(fabric, 0.06), M.Fabric)
		b.BoxR(CFrame.new(index * 31, seat + 12, -depth / 2 + 6) * CFrame.Angles(-0.12, 0, 0), 30, 26, 10, fabric, M.Fabric)
	end
	b.Box(0, 5, -depth / 2 + 3, 98, seat + 14, 6, darken(fabric, 0.08), M.Fabric)
	if chaise then
		-- méridienne : prolonge l'assise vers l'avant, côté droit
		b.Box(32, 5, depth / 2 + 12, 34, seat - 14, 24, darken(fabric, 0.12), M.Fabric)
		b.Cushion(32, seat - 10, depth / 2 + 10, 33, 10, 26, lighten(fabric, 0.06), M.Fabric)
	else
		for _, sx in ipairs({ -1, 1 }) do
			b.Box(sx * 46, 5, 0, 7, seat, depth, fabric, M.Fabric)
		end
	end
	-- coussins déco
	pillow(b, -36, seat - 2, -8, 16, 16, 6, b.Map(rgb(214, 170, 90)), -0.3)
	pillow(b, -20, seat - 2, -9, 14, 14, 6, LINEN, -0.25)
end

R.SectionalSofa = function(b, ctx)
	local seat = ctx.TopY(1, 36)
	modernSofa(b, seat, b.Map(rgb(150, 156, 164)), true)
	b.Top(1, 0, seat, 4, 84, 30)
	b.Footprint(98, 82, seat + 26)
end

R.Chesterfield = function(b, ctx)
	local seat = ctx.TopY(1, 38)
	local leather = b.Map(LEATHER)
	local dark = darken(leather, 0.25)
	local depth = 48
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			b.Ball(sx * 40, 3, sz * 18, 7, WALNUT_DARK, M.Wood)
		end
	end
	b.Box(0, 5, 0, 82, seat - 12, depth, dark, M.Leather)
	b.Cushion(-19, seat - 9, 4, 38, 10, depth - 10, leather, M.Leather)
	b.Cushion(19, seat - 9, 4, 38, 10, depth - 10, leather, M.Leather)
	-- dossier capitonné
	b.Box(0, 5, -depth / 2 + 5, 84, seat + 26, 10, leather, M.Leather)
	for row = 0, 2 do
		for col = 0, 6 do
			b.Ball(-36 + col * 12 + (row % 2) * 6, seat + 4 + row * 8, -depth / 2 + 10.2, 2.4, dark, M.Leather)
		end
	end
	-- accoudoirs roulés
	for _, sx in ipairs({ -1, 1 }) do
		b.Box(sx * 44, 5, 0, 12, seat + 8, depth, leather, M.Leather)
		b.CylZ(sx * 44, seat + 12, 1, 16, depth + 2, lighten(leather, 0.06), M.Leather)
		for k = 0, 3 do
			b.Ball(sx * 44, seat - 2 - k * 6, depth / 2 + 0.4, 2, dark, M.Leather)
		end
	end
	b.Top(1, 0, seat, 4, 72, 36)
	b.Footprint(100, depth + 2, seat + 31)
end

R.BookshelfWall = function(b, ctx)
	local depth = 28
	local levels = { ctx.TopY(1, 96), ctx.TopY(2, 72), ctx.TopY(3, 48), ctx.TopY(4, 24) }
	local walnut = b.Map(WALNUT)
	b.Box(0, 0, -depth / 2 + 1.5, 94, levels[1], 3, WALNUT_DARK, M.Wood) -- fond
	for _, sx in ipairs({ -1, 1 }) do
		b.Box(sx * 46, 0, 0, 4, levels[1], depth, walnut, M.Wood)
	end
	b.Box(0, 0, 0, 3, levels[1] - 4, depth, walnut, M.Wood) -- montant central
	b.Box(0, levels[1] - 4, 0, 96, 4, depth, walnut, M.Wood)
	b.Box(0, 0, 0, 88, 4, depth, walnut, M.Wood) -- socle
	for index = 2, 4 do
		b.Box(0, levels[index] - 3, 0, 88, 3, depth, walnut, M.Wood)
	end
	-- livres au fond des rayons (le devant reste libre pour poser des objets)
	local z = -5
	books(b, -43, -3, levels[2], z, 14, 19, 1)
	books(b, 3, 43, levels[2], z, 14, 19, 5)
	books(b, -43, -16, levels[3], z, 14, 18, 9)
	b.Ball(-9, levels[3] + 4, z, 8, GOLD, M.Metal)
	books(b, 3, 43, levels[3], z, 14, 18, 2)
	books(b, -43, -3, levels[4], z, 14, 19, 6)
	books(b, 3, 28, levels[4], z, 14, 19, 4)
	b.Cyl(36, levels[4], z, 9, 11, CERAMIC, M.SmoothPlastic)
	books(b, -43, -3, 4, z, 14, 17, 8)
	books(b, 3, 43, 4, z, 14, 17, 12)
	-- échelle de bibliothèque sur son rail doré
	b.CylX(0, levels[1] - 8, depth / 2 + 3, 2, 92, GOLD, M.Metal)
	for _, dx in ipairs({ 0, 12 }) do
		b.Tube(16 + dx, levels[1] - 8, depth / 2 + 3, 22 + dx, 0, depth / 2 + 18, 2.4, rgb(210, 180, 110), M.Wood)
	end
	for k = 1, 6 do
		local t = k / 7
		local y = levels[1] - 8 - t * (levels[1] - 8)
		b.CylX(22 + 6 * t, y, depth / 2 + 3 + 15 * t, 2, 12, rgb(210, 180, 110), M.Wood)
	end
	for index = 1, 4 do
		b.Top(index, 0, levels[index], index == 1 and 0 or depth * 0.25, 84, index == 1 and depth or depth * 0.45)
	end
	b.Footprint(96, depth + 30, levels[1])
end

R.MarbleIsland = function(b, ctx)
	local top = ctx.TopY(1, 60)
	local depth = 56
	local base = b.Map(rgb(66, 84, 96))
	b.Box(0, 0, 0, 92, 3, depth - 8, IRON_DARK, M.Metal) -- plinthe en retrait
	b.Box(0, 3, 0, 92, top - 7, depth - 6, base, M.Wood)
	for index = 0, 3 do
		local x = -34.5 + index * 23
		b.Box(x, 6, (depth - 6) / 2, 21, top - 14, 1, lighten(base, 0.08), M.Wood)
		b.Box(x + 6, top - 16, (depth - 6) / 2 + 0.8, 5, 1.6, 1, GOLD, M.Metal)
	end
	b.Box(0, top - 4, 0, 98, 4, depth, MARBLE, M.Marble)
	-- veines (fines incrustations sur le dessus, 0.06 plus haut)
	b.BoxR(CFrame.new(-18, top + 0.03, 6) * CFrame.Angles(0, 0.4, 0), 30, 0.06, 1, MARBLE_VEIN, M.Marble)
	b.BoxR(CFrame.new(20, top + 0.03, -10) * CFrame.Angles(0, -0.3, 0), 26, 0.06, 1, MARBLE_VEIN, M.Marble)
	-- corbeille de fruits + planche à découper
	b.Box(26, top, -12, 24, 2, 14, OAK, M.Wood)
	b.Cyl(-28, top, -10, 18, 4, CERAMIC, M.SmoothPlastic)
	for index, c in ipairs({ ORANGE, rgb(120, 190, 80), RED }) do
		b.Ball(-32 + index * 4, top + 6, -10 + (index % 2) * 3, 7, c, M.SmoothPlastic)
	end
	b.Top(1, 0, top, 4, 90, depth - 16)
	b.Footprint(98, depth, top)
end


-- Rangée de marchandise sur un emplacement d'étagère resté vide
local function stockRow(shop: Shop, parent: Instance, slot: Slot, seed: number)
	local specs = STOCK[shop.Id]
	if not specs then
		return
	end
	local spec = specs[(seed % #specs) + 1]
	local shape, w, h, d, pitch = spec[1] :: string, spec[2] :: number, spec[3] :: number, spec[4] :: number, spec[5] :: number
	local colors = spec[6] :: { Color3 }
	local captions = spec[7] :: { string }?
	h = math.min(h, slot.MaxH - 0.1)
	local count = math.max(1, math.floor(slot.MaxW / pitch))
	local x0 = -((count - 1) * pitch) / 2
	-- (au fond de l'emplacement, un peu en retrait du bord : jamais au bord)
	local z = math.min(slot.MaxD / 2 - d / 2, 0.2)
	for i = 0, count - 1 do
		local color = colors[((seed + math.floor(i / 2)) % #colors) + 1]
		local x = x0 + i * pitch
		local base = slot.CF * CFrame.new(x, 0, z)
		if shape == "Can" or shape == "Pot" or shape == "Vase" or shape == "Plates" then
			-- (pile d'assiettes : une seule pièce)
			local height = shape == "Plates" and 0.45 or h
			local n = 1
			for k = 0, n - 1 do
				local p = newPart(parent, shape, Vector3.new(height, w, w), base * CFrame.new(0, 0.02 + height / 2 + k * (height + 0.02), 0) * CFrame.Angles(0, 0, math.rad(90)), color, shape == "Can" and M.Metal or (shape == "Pot" and shop.Id == "Garden" and M.Slate or M.SmoothPlastic))
				;(p :: Part).Shape = Enum.PartType.Cylinder
			end
			if shape == "Pot" and shop.Id == "Garden" then
				local leaves = newPart(parent, "Leaves", Vector3.new(w * 1.2, w * 1.2, w * 1.2), base * CFrame.new(0, h + w * 0.45, 0), rgb(90, 170, 90), M.Grass)
				;(leaves :: Part).Shape = Enum.PartType.Ball
			elseif shape == "Vase" then
				local neck = newPart(parent, "VaseNeck", Vector3.new(0.3, w * 0.55, w * 0.55), base * CFrame.new(0, h + 0.17, 0) * CFrame.Angles(0, 0, math.rad(90)), color, M.SmoothPlastic)
				;(neck :: Part).Shape = Enum.PartType.Cylinder
			end
		elseif shape == "Ball" then
			local p = newPart(parent, "Ball", Vector3.new(w, w, w), base * CFrame.new(0, 0.02 + w / 2, 0), color, M.SmoothPlastic)
			;(p :: Part).Shape = Enum.PartType.Ball
		else
			local p = newPart(parent, shape, Vector3.new(w, h, d), base * CFrame.new(0, 0.02 + h / 2, 0), color, (shape == "Bag" or shape == "Cushion") and M.Fabric or M.SmoothPlastic)
			if captions and i % 2 == 0 then
				printLabel(shop, p, captions[((seed + i) % #captions) + 1], "✨", color)
			end
		end
	end
end

-- Nom de rayon d'une catégorie (en-têtes des étagères)
local function categoryCaption(id: string, fallback: string): string
	for _, c in ipairs(HouseCommon.Config.Categories or {}) do
		if tostring(c.Id) == id then
			return tostring(c.Icon or "") .. " " .. Locale.T(tostring(c.Name))
		end
	end
	return fallback
end

-- (v9.9) horloges (ClockKit, paresseux)
local clockKit: any = nil
local function Clocks(): any?
	if clockKit == nil then
		clockKit = optional(script.Parent, "ClockKit") or false
	end
	return clockKit or nil
end

-- (v9.9, SHOPS99) COMPTOIR-CAISSE 20x : caisson à panneaux moulurés sur
-- plinthe en retrait, plateau en marbre à nez arrondi, caisse tactile sur
-- pied (écran côté vendeur·se, logo côté client), TPE, imprimante à tickets
-- (le ticket sort), sacs en papier, bocal de bonbons, plante, chevalet
-- « Merci ! », horloge murale à l'heure réelle ; un·e client·e au comptoir
-- qui discute puis paie (animations alternées)
local COUNTER_TOP = 2.95
local function counter(shop: Shop, parent: Instance)
	local t = shop.Theme
	local F = shop.F
	local D = shop.Size.Z
	local z0, z1 = D - 4.6, D - 2.5
	local ink = rgb(40, 40, 48)
	box(parent, "Counter", F, -4.4, 4.4, 0.45, 2.8, z0, z1, t.Shelf, t.ShelfMat, true)
	box(parent, "CounterPlinth", F, -4.25, 4.25, 0.1, 0.48, z0 + 0.15, z1 - 0.15, ink, M.SmoothPlastic)
	for _, x in ipairs({ -2.85, 0, 2.85 }) do
		-- panneaux moulurés (cadre + panneau central en retrait)
		box(parent, "CounterPanel", F, x - 1.3, x + 1.3, 0.7, 2.55, z0 - 0.08, z0 + 0.02, t.Accent, M.SmoothPlastic)
		box(parent, "CounterPanelInset", F, x - 1.05, x + 1.05, 0.95, 2.3, z0 - 0.12, z0 - 0.06, t.Accent:Lerp(WHITE, 0.25), M.SmoothPlastic)
	end
	local top = box(parent, "CounterTop", F, -4.65, 4.65, 2.8, COUNTER_TOP, z0 - 0.25, z1 + 0.15, rgb(246, 244, 240), M.Marble)
	top.Reflectance = 0.05
	local nose = newPart(parent, "CounterNose", Vector3.new(9.3, 0.2, 0.2), F * CFrame.new(0, 2.875, z0 - 0.25), rgb(246, 244, 240), M.Marble)
	;(nose :: Part).Shape = Enum.PartType.Cylinder
	-- caisse tactile sur pied (écran vers le·la vendeur·se, logo vers le client)
	cylinder(parent, "PosFoot", F, 2.2, COUNTER_TOP - 0.02, z0 + 1.2, 0.08, 0.6, ink, M.Metal)
	cylinder(parent, "PosStem", F, 2.2, COUNTER_TOP, z0 + 1.2, 0.55, 0.1, ink, M.Metal)
	local P = F * CFrame.new(2.2, COUNTER_TOP + 0.95, z0 + 1.25) * CFrame.Angles(math.rad(-18), math.pi, 0)
	local pos = newPart(parent, "PosTablet", Vector3.new(1.3, 0.85, 0.07), P, rgb(30, 30, 36), M.SmoothPlastic)
	do
		local g = Instance.new("SurfaceGui")
		g.Name = "Screen"
		g.Face = Enum.NormalId.Front
		g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		g.PixelsPerStud = 120
		g.LightInfluence = 0.1
		g.MaxDistance = 40
		g.Parent = pos
		local bg = Instance.new("Frame")
		bg.Size = UDim2.fromScale(0.94, 0.9)
		bg.Position = UDim2.fromScale(0.03, 0.05)
		bg.BackgroundColor3 = rgb(246, 246, 252)
		bg.BorderSizePixel = 0
		bg.Parent = g
		local head = Instance.new("Frame")
		head.Size = UDim2.fromScale(1, 0.2)
		head.BackgroundColor3 = t.Accent
		head.BorderSizePixel = 0
		head.Parent = bg
		for r = 0, 2 do
			for c = 0, 3 do
				local tile = Instance.new("Frame")
				tile.Position = UDim2.fromScale(0.04 + c * 0.24, 0.27 + r * 0.24)
				tile.Size = UDim2.fromScale(0.2, 0.19)
				tile.BackgroundColor3 = t.Accent:Lerp(WHITE, 0.2 + ((r + c) % 3) * 0.2)
				tile.BorderSizePixel = 0
				tile.Parent = bg
				local tc = Instance.new("UICorner")
				tc.CornerRadius = UDim.new(0.15, 0)
				tc.Parent = tile
			end
		end
		local logo = Instance.new("SurfaceGui")
		logo.Name = "Logo"
		logo.Face = Enum.NormalId.Back
		logo.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		logo.PixelsPerStud = 60
		logo.LightInfluence = 0.5
		logo.MaxDistance = 40
		logo.Parent = pos
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Size = UDim2.fromScale(0.8, 0.6)
		l.Position = UDim2.fromScale(0.1, 0.2)
		l.Font = Enum.Font.FredokaOne
		l.TextScaled = true
		l.Text = "🧠 Dopa Pay"
		l.TextColor3 = rgb(200, 200, 214)
		l.Parent = logo
	end
	-- TPE (vers le client) + imprimante à tickets
	local T = F * CFrame.new(3.7, COUNTER_TOP + 0.2, z0 + 0.35) * CFrame.Angles(math.rad(25), 0, 0)
	box(parent, "TPE", T, -0.18, 0.18, -0.22, 0.22, -0.07, 0.07, rgb(40, 40, 48), M.SmoothPlastic)
	sign(parent, "TPEScreen", Vector3.new(0.28, 0.16, 0.05), T * CFrame.new(0, 0.1, -0.075), rgb(210, 236, 250), "💳", rgb(40, 40, 60), 160)
	box(parent, "TPEKeys", T, -0.14, 0.14, -0.19, -0.02, -0.095, -0.055, rgb(90, 90, 100), M.SmoothPlastic)
	box(parent, "Printer", F, 0.6, 1.1, COUNTER_TOP - 0.02, COUNTER_TOP + 0.3, z0 + 1.3, z0 + 1.9, rgb(236, 236, 240), M.SmoothPlastic)
	local paper = newPart(parent, "Receipt", Vector3.new(0.32, 0.5, 0.01), F * CFrame.new(0.85, COUNTER_TOP + 0.52, z0 + 1.32) * CFrame.Angles(math.rad(-15), 0, 0), WHITE, M.SmoothPlastic)
	local _ = paper
	-- sacs en papier (pile + un sac debout), bocal de bonbons, plante, chevalet
	for k = 0, 2 do
		box(parent, "PaperBag", F, -4.25, -3.05, COUNTER_TOP - 0.02 + k * 0.06, COUNTER_TOP + 0.05 + k * 0.06, z0 + 0.8, z0 + 1.6, k == 1 and t.Accent:Lerp(WHITE, 0.4) or rgb(206, 170, 126), M.Fabric)
	end
	box(parent, "ShoppingBag", F, -0.5, 0.3, COUNTER_TOP - 0.02, COUNTER_TOP + 1.0, z0 + 1.2, z0 + 1.65, t.Accent, M.Fabric)
	box(parent, "BagHandle", F, -0.3, 0.1, COUNTER_TOP + 0.97, COUNTER_TOP + 1.3, z0 + 1.4, z0 + 1.45, t.Accent:Lerp(Color3.new(0, 0, 0), 0.3), M.Fabric)
	local jar = cylinder(parent, "CandyJar", F, -1.3, COUNTER_TOP - 0.02, z0 + 0.45, 0.75, 0.62, rgb(230, 240, 250), M.Glass)
	jar.Transparency = 0.55
	for k = 0, 2 do
		ball(parent, "Lollipop", F, -1.42 + k * 0.12, COUNTER_TOP + 0.22 + (k % 2) * 0.16, z0 + 0.45 + (k - 1) * 0.1, 0.24, ({ rgb(255, 110, 150), rgb(255, 214, 80), rgb(120, 200, 255) })[k + 1], M.SmoothPlastic)
	end
	cylinder(parent, "JarLid", F, -1.3, COUNTER_TOP + 0.72, z0 + 0.45, 0.1, 0.66, t.Accent, M.SmoothPlastic)
	cylinder(parent, "PlantPot", F, 4.15, COUNTER_TOP - 0.02, z1 - 0.35, 0.5, 0.5, rgb(236, 226, 214), M.SmoothPlastic)
	ball(parent, "PlantLeaves", F, 4.15, COUNTER_TOP + 0.75, z1 - 0.35, 0.8, rgb(84, 160, 96), M.Grass)
	local tent = sign(parent, "ThankYou", Vector3.new(1.1, 0.5, 0.05), F * CFrame.new(-0.2, COUNTER_TOP + 0.24, z0 - 0.05) * CFrame.Angles(math.rad(-14), 0, 0), WHITE, Locale.T("Thank you! 😊"), t.Accent, 80)
	local _ = tent
	-- panneau "🛍️ Voir tout" (sur le comptoir)
	sign(parent, "SeeAll", Vector3.new(3.2, 1.3, 0.12), F * CFrame.new(-2.7, COUNTER_TOP + 1.15, z0 + 1.9) * CFrame.Angles(math.rad(-10), 0, 0), WHITE, Locale.T("🛍️ See everything"), t.Accent, 60)
	box(parent, "SignFoot", F, -3.3, -2.1, COUNTER_TOP - 0.02, COUNTER_TOP + 0.5, z0 + 1.7, z0 + 2.05, rgb(200, 196, 210), M.Metal)
	-- vendeur·se derrière le comptoir : vrai personnage animé (NPCModels)
	local kz = D - 1.55
	local style = (shop.Id == "Furniture" or shop.Id == "Setup") and "salesperson" or (shop.Id == "Kitchen" and "baker" or "cashier")
	local seed = 0
	for i = 1, #shop.Id do
		seed += string.byte(shop.Id, i)
	end
	shopActor(shop, parent, style, seed, F * CFrame.new(-0.2, 0.12, kz), style == "salesperson" and "type" or "idle", { Shirt = t.Keeper })
	local actors = (shop :: any).Actors
	if actors and actors[#actors] then
		-- (v9.9) le·la vendeur·se alterne : tape sur la caisse, discute
		actors[#actors].Cycle = { "type", "talk", "idle" }
	end
	-- (v9.9) un·e client·e au comptoir (discute, puis paie par carte)
	if shopActor(shop, parent, "shopper", seed + 91, F * CFrame.new(1.8, 0.12, z0 - 1.25) * CFrame.Angles(0, math.pi, 0), "talk", { Prop = "bag" }) then
		local list = (shop :: any).Actors
		list[#list].Cycle = { "talk", "idle", "type" }
	end
	-- horloge murale à l'heure réelle au-dessus de l'enseigne du fond
	local clocks = Clocks()
	if clocks then
		local ok, c = pcall(clocks.Build, parent, F * CFrame.new(0, shop.Size.Y - 0.95, D - 0.3), 1.3, { Style = "Wall", Numerals = "Arabic", Case = t.Accent:Lerp(Color3.new(0, 0, 0), 0.35), MaxDistance = 60, Name = "ShopClock" })
		if ok and c then
			(shop :: any).Clock = c
		end
	end
	-- grande enseigne du fond
	local shopDef = ShopUI.SHOPS[shop.Id]
	sign(parent, "BackSign", Vector3.new(11, 2, 0.15), F * CFrame.new(0, 8.6, D - 0.2 - 2 * GAP - 0.2), WHITE, Locale.T(shopDef and shopDef.Name or shop.Id), t.Accent, 30)
	-- invite "🛍️ Voir tout" au comptoir
	local anchor = newPart(parent, "CatalogPoint", Vector3.new(1, 1, 1), F * CFrame.new(0, 3.9, z0 - 0.4), WHITE, M.SmoothPlastic)
	anchor.Transparency = 1
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "CatalogPrompt"
	prompt.ActionText = Locale.T("🛍️ See everything")
	prompt.ObjectText = Locale.T(shopDef and shopDef.Name or shop.Id)
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 7
	prompt.RequiresLineOfSight = false
	prompt.Parent = anchor
	local counterPos = anchor.Position
	shop.Counter = counterPos
	prompt.Triggered:Connect(function()
		ShopUI.OpenShop(shop.Id, { Anchor = counterPos })
	end)
end

-- Suspensions + les 2 vraies lumières (éteintes tant qu'on n'est pas dedans)
local function lamps(shop: Shop, parent: Instance, spots: { { number } })
	local t = shop.Theme
	local F = shop.F
	local H = shop.Size.Y
	for index, spot in ipairs(spots) do
		local x, z = spot[1], spot[2]
		-- (v9.8) suspension plate : cordon, cache-piton, abat-jour en disque, diffuseur
		box(parent, "LampCord", F, x - 0.04, x + 0.04, H - 1.25, H - 0.25, z - 0.04, z + 0.04, rgb(60, 60, 70), M.SmoothPlastic)
		cylinder(parent, "LampCanopy", F, x, H - 0.25, z, 0.15, 0.7, WHITE, M.SmoothPlastic)
		local shade = cylinder(parent, "LampShade", F, x, H - 1.6, z, 0.35, 2.4, t.Accent, M.SmoothPlastic)
		shade.CastShadow = false
		cylinder(parent, "LampRim", F, x, H - 1.25, z, 0.06, 1.2, t.Accent:Lerp(WHITE, 0.3), M.SmoothPlastic)
		local bulb = cylinder(parent, "LampBulb", F, x, H - 1.66, z, 0.06, 2.1, t.Lamp, M.SmoothPlastic)
		if index <= 2 then
			local light = Instance.new("PointLight")
			light.Name = "ShopLight"
			light.Color = t.Lamp
			light.Brightness = 1
			light.Range = shop.Kind == "Cars" and 22 or 16
			light.Shadows = false
			light.Enabled = shop.LightsOn
			light.Parent = bulb
			table.insert(shop.Lights, light)
		end
	end
end

-- Déco propre à chaque métier
local function themeDecor(shop: Shop, parent: Instance)
	local t = shop.Theme
	local F = shop.F
	local D = shop.Size.Z
	local id = shop.Id
	-- tapis d'entrée
	box(parent, "EntryMat", F, -2.6, 2.6, 0.17, 0.22, 0.6, 3, t.Accent, M.Fabric)
	if id == "Pets" then
		-- empreintes de pattes au sol, bac à balles, coussin géant
		for i = 0, 5 do
			local x, z = (i % 2 == 0 and -0.9 or 0.9), 4 + i * 2.3
			cylinder(parent, "Paw", F, x, 0.17, z, 0.04, 0.8, rgb(170, 130, 96), M.SmoothPlastic)
		end
		cylinder(parent, "PetBed", F, 0, 0.1, D - 7, 0.5, 3.2, rgb(255, 196, 170), M.Fabric)
		ball(parent, "Yarn", F, 1.5, 0.55, D - 6.4, 0.9, rgb(236, 110, 150), M.Fabric)
		ball(parent, "Ball", F, -1.3, 0.5, D - 7.2, 0.8, rgb(120, 190, 255), M.SmoothPlastic)
	elseif id == "Toys" then
		-- dalles arc-en-ciel dans l'allée + gros nounours au coin
		local colors = { rgb(255, 150, 170), rgb(255, 214, 120), rgb(160, 226, 170), rgb(150, 200, 255), rgb(200, 170, 250) }
		for i = 1, 5 do
			box(parent, "RainbowTile", F, -2.6, 2.6, 0.17, 0.21, 3.2 + i * 2.6, 3.2 + i * 2.6 + 2.4, colors[i], M.SmoothPlastic)
		end
		local bx, bz = -3.6, D - 6.5
		ball(parent, "TeddyBody", F, bx, 1.4, bz, 2.6, rgb(206, 150, 104), M.Fabric)
		ball(parent, "TeddyHead", F, bx, 3.3, bz, 1.9, rgb(206, 150, 104), M.Fabric)
		for _, sx in ipairs({ -1, 1 }) do
			ball(parent, "TeddyEar", F, bx + sx * 0.75, 4.1, bz, 0.7, rgb(186, 130, 90), M.Fabric)
		end
		ball(parent, "TeddyMuzzle", F, bx, 3.1, bz - 0.85, 0.7, rgb(246, 214, 180), M.Fabric)
	elseif id == "Kitchen" then
		-- damier au sol + casseroles suspendues
		for i = 0, 5 do
			for j = 0, 1 do
				if (i + j) % 2 == 0 then
					box(parent, "FloorCheck", F, -2.6 + j * 2.6, j * 2.6, 0.17, 0.21, 4 + i * 2.4, 6.4 + i * 2.4, rgb(236, 130, 146), M.Marble)
				end
			end
		end
		local H = shop.Size.Y
		-- (au-dessus du comptoir, à droite : ne cache pas l'enseigne du fond)
		box(parent, "PotRail", F, 5.6, 10.4, H - 1.9, H - 1.75, D - 4.6, D - 4.45, rgb(200, 196, 210), M.Metal)
		for i = 0, 3 do
			cylinder(parent, "Pot", F, 6.3 + i * 1.2, H - 3.1, D - 4.52, 0.8, 1.05, rgb(214, 120, 90):Lerp(rgb(200, 196, 210), i % 2 * 0.6), M.Metal)
		end
	elseif id == "Furniture" then
		-- tapis sous les estrades du centre
		box(parent, "Runner", F, -2.2, 2.2, 0.17, 0.22, 3.4, D - 5.2, rgb(214, 170, 140), M.Fabric)
	elseif id == "Setup" then
		-- bandes "RGB" (couleurs douces, pas de néon) le long des murs
		local colors = { rgb(255, 120, 200), rgb(120, 200, 255), rgb(160, 255, 200) }
		for i, sx in ipairs({ -1, 1 }) do
			box(parent, "RGBStrip", F, sx * 13.55, sx * 13.6, 9.6, 9.8, 1, D - 1, colors[i], M.SmoothPlastic)
		end
		box(parent, "RGBStripBack", F, -13, 13, 9.6, 9.8, D - 0.45, D - 0.4, colors[3], M.SmoothPlastic)
	elseif id == "Garden" then
		-- paniers suspendus + arrosoir
		local H = shop.Size.Y
		for _, spot in ipairs({ { -9.6, 5.2 }, { 9.6, 5.2 }, { -9.6, 11.6 }, { 9.6, 11.6 } }) do
			local x, z = spot[1], spot[2]
			box(parent, "BasketCord", F, x - 0.04, x + 0.04, H - 2.2, H - 0.1, z - 0.04, z + 0.04, rgb(150, 120, 90), M.SmoothPlastic)
			cylinder(parent, "Basket", F, x, H - 3, z, 0.8, 1.6, rgb(190, 140, 90), M.WoodPlanks)
			ball(parent, "Trailing", F, x, H - 2.9, z, 1.9, rgb(96, 170, 92), M.Grass)
		end
		cylinder(parent, "WateringCan", F, 2.6, 0.15, D - 6.4, 1.1, 1, rgb(120, 180, 230), M.Metal)
	end
end

-- Estrades du centre (disques) et estrades "salon" le long des murs
local function stages(shop: Shop, parent: Instance, plan: Plan)
	local t = shop.Theme
	local F = shop.F
	for _, spot in ipairs(plan.PodiumSpots) do
		cylinder(parent, "Podium", F, spot.X, 0.1, spot.Z, 0.6, 5, t.Podium, M.SmoothPlastic, true)
		cylinder(parent, "PodiumRim", F, spot.X, 0.04, spot.Z, 0.29, 5.3, t.Accent, M.SmoothPlastic)
	end
	for _, pf in ipairs(plan.Platforms) do
		local hwid, hd = pf.W / 2, pf.Dp / 2
		box(parent, "Platform", pf.CF, -hwid, hwid, 0.1, 0.5, -hd, hd, t.Podium, M.WoodPlanks, true)
		box(parent, "PlatformRug", pf.CF, -hwid + 0.5, hwid - 0.5, 0.5, 0.5 + 0.06, -hd + 0.4, hd - 0.4, t.Accent:Lerp(WHITE, 0.55), M.Fabric)
	end
end

----------------------------------------------------------------------
-- Concession : voitures sur les plateaux, bureau de vente
----------------------------------------------------------------------

-- (v9.8, CARS98) le décor de la concession est dans DealerShowroom (grand
-- hall 70 x 50, plateau tournant, vendeur, pupitres…) : ici, on délègue
local dealerModule: any = nil
local function Dealer(): any
	if dealerModule == nil then
		dealerModule = optional(script.Parent, "DealerShowroom") or false
	end
	return dealerModule or nil
end

local function dealerCtx(): any
	return {
		AddTag = addTag,
		Entries = (ShopUI.ShopEntries("Cars")),
		Stats = stats,
		OpenCatalog = function(anchor: Vector3)
			ShopUI.OpenShop("Cars", { Anchor = anchor })
		end,
	}
end

local function carsFront(shop: Shop, parent: Instance): { () -> () }
	local dealer = Dealer()
	if dealer and type(dealer.FrontJobs) == "function" then
		local ok, jobs = pcall(dealer.FrontJobs, shop, parent, dealerCtx())
		if ok and type(jobs) == "table" then
			return jobs
		end
		warn("[ShopInteriors] concession : " .. tostring(jobs))
	end
	return {}
end

local function carsFull(shop: Shop, parent: Instance): { () -> () }
	local dealer = Dealer()
	if dealer and type(dealer.FullJobs) == "function" then
		local ok, jobs = pcall(dealer.FullJobs, shop, parent, dealerCtx())
		if ok and type(jobs) == "table" then
			return jobs
		end
		warn("[ShopInteriors] concession : " .. tostring(jobs))
	end
	return {}
end

----------------------------------------------------------------------
-- Construction par niveaux
----------------------------------------------------------------------

local function tierFolder(shop: Shop, level: number): Folder
	local existing = shop.Tiers[level]
	if existing and existing.Parent then
		return existing
	end
	local f = Instance.new("Folder")
	f.Name = shop.Id .. (level == 1 and "_Front" or "_Full")
	f.Parent = folder
	shop.Tiers[level] = f
	return f
end

local function jobsFor(shop: Shop, level: number): { () -> () }
	local parent = tierFolder(shop, level)
	local jobs: { () -> () } = {}
	if shop.Kind == "Cars" then
		if level == 1 then
			-- (v9.8) habillage propre à la concession (mur vitré côté porte de la ville)
			for _, job in ipairs(carsFront(shop, parent)) do
				table.insert(jobs, job)
			end
		else
			for _, job in ipairs(carsFull(shop, parent)) do
				table.insert(jobs, job)
			end
		end
		return jobs
	end
	local plan = shop.Plan
	if not plan then
		plan = makePlan(shop)
		shop.Plan = plan
	end
	local placements = assign(shop, plan)
	if level == 1 then
		table.insert(jobs, function()
			lining(shop, parent)
			windowDisplays(shop, parent, plan)
		end)
		for _, p in ipairs(placements) do
			if p.Slot.Kind == "Window" then
				table.insert(jobs, function()
					placeDisplay(shop, parent, p.Slot, p.Entry, false)
				end)
			end
		end
		return jobs
	end
	table.insert(jobs, function()
		local shopDef = ShopUI.SHOPS[shop.Id]
		local tabs = shopDef and shopDef.Tabs or {}
		for i, unit in ipairs(plan.ShelfUnits) do
			local tab = tabs[((i - 1) % math.max(1, #tabs)) + 1]
			local caption = tab and categoryCaption(tab, Locale.T(shopDef and shopDef.Name or shop.Id)) or nil
			shelfUnit(parent, unit, shop.Theme, caption)
		end
	end)
	table.insert(jobs, function()
		stages(shop, parent, plan)
		counter(shop, parent)
	end)
	table.insert(jobs, function()
		lamps(shop, parent, { { 0, 6.2 }, { 0, 13.6 } })
		themeDecor(shop, parent)
	end)
	-- étiquettes des objets des vitrines (déjà construits au niveau 1)
	table.insert(jobs, function()
		for _, d in ipairs(shop.Displays) do
			if not d.Tag then
				for _, p in ipairs(placements) do
					if p.Slot.Kind == "Window" and p.Entry == d.Entry then
						local height = 1.5
						local fp = d.Model and d.Model:GetAttribute("Footprint")
						if typeof(fp) == "Vector3" then
							height = fp.Y
						end
						addTag(shop, parent, d, p.Slot.Tag, (p.Slot.CF * CFrame.new(0, height / 2, 0)).Position)
					end
				end
			end
		end
	end)
	for _, p in ipairs(placements) do
		if p.Slot.Kind ~= "Window" then
			table.insert(jobs, function()
				placeDisplay(shop, parent, p.Slot, p.Entry, true)
			end)
		end
	end
	-- (v9.8, MARKET98) rayons pleins : marchandise du métier sur les
	-- emplacements d'étagère restés vides (plus de planches nues)
	local used: { [Slot]: boolean } = {}
	for _, p in ipairs(placements) do
		used[p.Slot] = true
	end
	local empty = {}
	for _, slot in ipairs(plan.Shelf) do
		if not used[slot] then
			table.insert(empty, slot)
		end
	end
	table.insert(jobs, function()
		local s: any = shop
		s.Prints = 0
		for i, slot in ipairs(empty) do
			stockRow(shop, parent, slot, i * 7 + #shop.Id)
		end
	end)
	-- (v9.8) clients : un·e qui se promène dans l'allée, un·e qui regarde un rayon
	table.insert(jobs, function()
		local F = shop.F
		local D = shop.Size.Z
		local wide = shop.Theme.Sides == "Platforms"
		local ax = wide and 4.8 or 2.6
		local path = {}
		for _, q in ipairs({ { -ax, 4.4 }, { -ax, D - 6.6 }, { ax, D - 6.6 }, { ax, 4.4 } }) do
			table.insert(path, (F * CFrame.new(q[1], 0.12, q[2])).Position)
		end
		shopActor(shop, parent, "shopper", 300 + #shop.Id * 13, CFrame.lookAt(path[1], path[2]), "walk", { Prop = "bag" }, path)
		local back = shop.Size.X / 2 - 0.45
		if wide then
			shopActor(shop, parent, "elder", 400 + #shop.Id, F * CFrame.new(back - 4.9, 0.12, D * 0.5) * FACE_PX, "idle", { Prop = "none" })
		else
			shopActor(shop, parent, "shopper", 410 + #shop.Id, F * CFrame.new(-(back - SHELF_DEPTH - 1.1), 0.12, D * 0.45) * FACE_NX, "idle", { Prop = "phone" })
		end
	end)
	return jobs
end

local function detachDisplay(d: Display)
	if d.Live then
		local live = optional(script.Parent, "LiveProps")
		if live and type(live.Detach) == "function" then
			pcall(live.Detach, d.Live)
		end
		d.Live = nil
	end
end

-- Détruit les niveaux > `level`
local function downgrade(shop: Shop, level: number)
	for tier = 2, level + 1, -1 do
		local f = shop.Tiers[tier]
		if f then
			-- objets exposés de ce niveau
			local keep = {}
			for _, d in ipairs(shop.Displays) do
				local inTier = (d.Model and d.Model:IsDescendantOf(f)) or false
				if d.Tag and d.Tag:IsDescendantOf(f) then
					d.Tag = nil
					d.Prompt = nil
					d.Labels = {}
				end
				if inTier then
					detachDisplay(d)
				else
					table.insert(keep, d)
				end
			end
			shop.Displays = keep
			if tier == 2 then
				table.clear(shop.Lights)
				shop.LightsOn = false
				shop.Counter = nil
				local s: any = shop
				s.Actors = nil
				s.Clock = nil
				if s.Night and s.NightParent and s.NightParent.Parent then
					s.Night.Parent = s.NightParent
				end
			elseif tier == 1 then
				local s: any = shop
				s.Night, s.NightParent, s.Spill = nil, nil, nil
			end
			f:Destroy()
			shop.Tiers[tier] = nil
			stats.Destroyed += 1
		end
	end
	if shop.Building > level then
		shop.Jobs = nil
		shop.Building = 0
	end
	shop.Level = math.min(shop.Level, level)
end

----------------------------------------------------------------------
-- Portes coulissantes
----------------------------------------------------------------------

local function stepDoors(shop: Shop, positions: { Vector3 })
	if #shop.Doors == 0 then
		return
	end
	local door = shop.DoorCF.Position
	local near = false
	for _, p in ipairs(positions) do
		if (p - door).Magnitude < DOOR_RANGE then
			near = true
			break
		end
	end
	for _, d in ipairs(shop.Doors) do
		if d.IsOpen ~= near then
			d.IsOpen = near
			local goal = near and d.Open or d.Closed
			local ok = pcall(function()
				TweenService:Create(d.Part, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = goal }):Play()
			end)
			if not ok then
				d.Part.CFrame = goal
			end
		end
	end
end

----------------------------------------------------------------------
-- Boucle
----------------------------------------------------------------------

local function characterPositions(): { Vector3 }
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			table.insert(list, root.Position)
		end
	end
	return list
end

local function localPosition(): Vector3?
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root.Position
	end
	return focus
end

local function flatDistance(a: Vector3, b: Vector3): number
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

-- Dans la boîte intérieure (un peu élargie) ?
local function inside(shop: Shop, p: Vector3): boolean
	local rel = shop.InteriorCF:PointToObjectSpace(p)
	local s = shop.Size
	return math.abs(rel.X) < s.X / 2 + 0.5 and math.abs(rel.Z) < s.Z / 2 + 0.5 and rel.Y > -2 and rel.Y < s.Y + 2
end

-- (v9.6.1) étiquettes de prix : seulement dans la boutique où l'on est, et
-- les MAX_TAGS plus proches (plus de panneaux empilés les uns sur les autres)
local MAX_TAGS = 5
local function updateTags(position: Vector3)
	local candidates: { { d: Display, dist: number } } = {}
	for _, shop in ipairs(shops) do
		local here = inside(shop, position)
		for _, d in ipairs(shop.Displays) do
			local bb = d.Billboard
			if bb and bb.Parent and d.Tag then
				local dist = (d.Tag.Position - position).Magnitude
				local isCar = d.Entry.Kind == "Car"
				if (here or isCar) and dist <= (isCar and 40 or TAG_DISTANCE) then
					table.insert(candidates, { d = d, dist = dist })
				else
					bb.Enabled = false
				end
			end
		end
	end
	table.sort(candidates, function(a, b)
		return a.dist < b.dist
	end)
	local shown = 0
	for _, c in ipairs(candidates) do
		local isCar = c.d.Entry.Kind == "Car"
		local show = isCar or shown < MAX_TAGS
		if show and not isCar then
			shown += 1
		end
		(c.d.Billboard :: BillboardGui).Enabled = show
	end
end

local function decide(position: Vector3)
	-- niveau voulu par boutique (hystérésis), 3 complètes au plus
	local wantFull = {}
	for _, shop in ipairs(shops) do
		local d = flatDistance(position, shop.InteriorCF.Position)
		local target = 0
		local s: any = shop
		if d <= FULL_RANGE or (shop.Level >= 2 and d <= FULL_DROP) then
			target = 2
		elseif d <= FRONT_RANGE or (shop.Level >= 1 and d <= FRONT_DROP) then
			target = 1
		end
		s.Target = target
		s.Distance = d
		if target == 2 then
			table.insert(wantFull, shop)
		end
	end
	table.sort(wantFull, function(a, b)
		return (a :: any).Distance < (b :: any).Distance
	end)
	for index = MAX_FULL + 1, #wantFull do
		local extra: any = wantFull[index]
		extra.Target = 1
	end
	-- (v9.9) vraies lumières : allumées dès qu'on approche de la vitrine
	-- (≤ 32 studs) ou qu'on est dedans, pour les 2 boutiques les plus proches
	local near = {}
	for _, shop in ipairs(shops) do
		local target = (shop :: any).Target
		if shop.Level > target or shop.Building > target then
			downgrade(shop, target)
		end
		local d = flatDistance(position, shop.DoorCF.Position)
		if shop.Level >= 2 and (inside(shop, position) or d <= 32) then
			table.insert(near, shop)
		end
	end
	table.sort(near, function(a, b)
		return flatDistance(position, a.DoorCF.Position) < flatDistance(position, b.DoorCF.Position)
	end)
	local night = false
	pcall(function()
		local ct = game:GetService("Lighting").ClockTime
		night = ct < 6.4 or ct > 17.8
	end)
	for _, shop in ipairs(shops) do
		local on = table.find(near, shop) ~= nil and (table.find(near, shop) :: number) <= 2
		if on ~= shop.LightsOn then
			shop.LightsOn = on
			for _, light in ipairs(shop.Lights) do
				light.Enabled = on
			end
		end
		local spill = (shop :: any).Spill
		if spill and spill.Parent and spill.Enabled ~= night then
			spill.Enabled = night
		end
	end
	-- prochaine construction : la boutique la plus proche qui en a besoin
	local busy = false
	for _, shop in ipairs(shops) do
		if shop.Building > 0 then
			busy = true
		end
	end
	if not busy then
		local best: Shop? = nil
		for _, shop in ipairs(shops) do
			if (shop :: any).Target > shop.Level and (not best or (shop :: any).Distance < (best :: any).Distance) then
				best = shop
			end
		end
		if best then
			local level = best.Level + 1
			best.Building = level
			best.Jobs = jobsFor(best, level)
			;(best :: any).JobIndex = 1
		end
	end
end

local function runJobs()
	local started_ = os.clock()
	for _, shop in ipairs(shops) do
		local jobs = shop.Jobs
		if jobs then
			local index = (shop :: any).JobIndex or 1
			repeat
				local job = jobs[index]
				if job then
					local ok, err = pcall(job)
					if not ok then
						warn("[ShopInteriors] " .. shop.Id .. " : " .. tostring(err))
					end
				end
				index += 1
			until index > #jobs or os.clock() - started_ > STEP_BUDGET
			;(shop :: any).JobIndex = index
			if index > #jobs then
				shop.Jobs = nil
				shop.Level = shop.Building
				shop.Building = 0
				-- (v9.9) l'intérieur complet remplace les silhouettes « vues de dehors »
				local night = (shop :: any).Night
				if night and shop.Level >= 2 then
					night.Parent = nil
				end
				stats.Built += 1
				dirty = true
			end
			return -- (une boutique à la fois)
		end
	end
end

local function refreshAll()
	for _, shop in ipairs(shops) do
		for _, d in ipairs(shop.Displays) do
			if d.Tag then
				refreshDisplay(d)
			end
		end
	end
end

function ShopInteriors.Step(position: Vector3?)
	if typeof(position) == "Vector3" then
		focus = position
	end
end

-- (v9.8) personnages : ~24 images/s, seulement dans les boutiques proches
local ANIM_EVERY = 1 / 24
local animClock = 0
local function animateShops(position: Vector3, now: number)
	local N = NPC()
	if not N then
		return
	end
	for _, shop in ipairs(shops) do
		local actors = (shop :: any).Actors
		if actors and shop.Level >= 2 and flatDistance(position, shop.InteriorCF.Position) <= 45 then
			for _, a in ipairs(actors) do
				if a.Model.Parent then
					if a.Path and a.Length > 0 then
						local p, dir = pathAt(a.Path, ((now + a.Offset) * a.Speed) % a.Length)
						local cf = CFrame.lookAt(p, p + Vector3.new(dir.X, 0, dir.Z))
						-- (racine placée directement : jamais de PivotTo répété)
						local root = a.Model.PrimaryPart
						if root then
							root.CFrame = cf
						else
							a.Model:PivotTo(cf)
						end
					end
					local anim = a.Anim
					if a.Cycle then
						-- (v9.9) anims alternées toutes les 5 s (vendeur·se, client·e au comptoir)
						anim = a.Cycle[math.floor((now + a.Offset) / 5) % #a.Cycle + 1]
					end
					pcall(N.Animate, a.Model, anim, now + a.Offset)
				end
			end
			-- (v9.9) horloge murale
			local c = (shop :: any).Clock
			if c and Clocks() then
				pcall(clockKit.Update, c)
			end
		end
	end
end

local function heartbeat(dt: number)
	if not started then
		return
	end
	runJobs()
	animClock += dt
	if animClock >= ANIM_EVERY then
		animClock = 0
		local here = localPosition()
		if here then
			animateShops(here, os.clock())
		end
	end
	clock += dt
	if clock < STEP_EVERY then
		return
	end
	clock = 0
	local position = localPosition()
	if position then
		decide(position)
		pcall(updateTags, position)
	end
	local positions = characterPositions()
	for _, shop in ipairs(shops) do
		if shop.Level >= 1 or shop.Building >= 1 then
			stepDoors(shop, positions)
		end
	end
	if dirty then
		dirty = false
		refreshAll()
	end
end

----------------------------------------------------------------------
-- Démarrer / arrêter
----------------------------------------------------------------------

local function discover(): { Shop }
	local list = {}
	local town = workspace:FindFirstChild("DopamineTown")
	local container = town and town:FindFirstChild("Shops")
	if not container then
		return list
	end
	for _, model in ipairs(container:GetChildren()) do
		local id = model:GetAttribute("ShopId")
		local interiorCF = model:GetAttribute("InteriorCF")
		local size = model:GetAttribute("InteriorSize")
		local doorCF = model:GetAttribute("DoorCF")
		if model:IsA("Model") and type(id) == "string" and typeof(interiorCF) == "CFrame" and typeof(size) == "Vector3" and typeof(doorCF) == "CFrame" then
			local kind = model:GetAttribute("ShopKind") == "Cars" and "Cars" or "Items"
			local shop: Shop = {
				Model = model,
				Id = id,
				Kind = kind,
				Theme = THEMES[id] or THEMES.Pets,
				InteriorCF = interiorCF,
				Size = size,
				DoorCF = doorCF,
				F = interiorCF * CFrame.new(0, 0, -size.Z / 2),
				Level = 0,
				Tiers = {},
				Jobs = nil,
				Building = 0,
				Plan = nil,
				Displays = {},
				Lights = {},
				LightsOn = false,
				Doors = {},
				Counter = nil,
			}
			for _, child in ipairs(model:GetChildren()) do
				local slide = child:GetAttribute("SlideX")
				if child:IsA("BasePart") and child.Name == "DoorPanel" and type(slide) == "number" then
					local closed = child.CFrame
					table.insert(shop.Doors, { Part = child, Closed = closed, Open = closed * CFrame.new(slide, 0, 0), IsOpen = false })
				end
			end
			table.insert(list, shop)
		end
	end
	return list
end

function ShopInteriors.Start(options: { Toast: ((string, Color3?) -> ())? }?)
	if started then
		return
	end
	started = true
	ShopUI.SetToast(options and options.Toast or nil)
	local old = workspace:FindFirstChild(FOLDER_NAME)
	if old then
		old:Destroy()
	end
	local f = Instance.new("Folder")
	f.Name = FOLDER_NAME
	f.Parent = workspace
	folder = f
	shops = discover()
	clock = STEP_EVERY
	table.insert(conns, RunService.Heartbeat:Connect(heartbeat))
	table.insert(conns, ClientState.Changed:Connect(function()
		dirty = true
	end))
	table.insert(conns, ShopUI.Bought:Connect(function()
		dirty = true
	end))
end

function ShopInteriors.Stop()
	if not started then
		return
	end
	started = false
	for _, c in ipairs(conns) do
		c:Disconnect()
	end
	table.clear(conns)
	ShopUI.Close()
	ShopUI.SetToast(nil)
	for _, shop in ipairs(shops) do
		downgrade(shop, 0)
		for _, d in ipairs(shop.Doors) do
			if d.Part.Parent then
				d.Part.CFrame = d.Closed
			end
		end
	end
	table.clear(shops)
	if folder then
		folder:Destroy()
		folder = nil
	end
	focus = nil
end

function ShopInteriors.Debug(): any
	return {
		Shops = shops,
		Stats = stats,
		Folder = folder,
		Refresh = refreshAll,
		Animate = function(position: Vector3, now: number)
			animateShops(position, now)
		end,
		Decide = function(position: Vector3)
			decide(position)
		end,
		RunAll = function()
			for _ = 1, 4000 do
				local pending = false
				for _, shop in ipairs(shops) do
					if shop.Jobs then
						pending = true
					end
				end
				if not pending then
					break
				end
				runJobs()
			end
		end,
		Buy = function(shop: any, index: number)
			local d = shop.Displays[index]
			if d then
				buyDisplay(d)
			end
		end,
	}
end

return ShopInteriors
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="224">
          <Properties>
            <string name="Name">ShopUI</string>
            <string name="Source"><![CDATA[--[[
	ShopUI (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > ShopUI

	🛍️ Dopamine Town (v9.6, SHOPS96) : le CATALOGUE des boutiques de la ville
	(ScreenGui "TownShopGui", à part du HUD de la ville) et la logique
	d'achat partagée avec les objets exposés en 3D (ShopInteriors).
	  - une fenêtre par boutique : en-tête (icône, nom, Dopamine), onglets
	    des catégories de la boutique, grille de cartes (dessin 2D de
	    l'objet peint par petits paquets, ou vraie voiture 3D dans un
	    ViewportFrame), prix du prochain exemplaire, exemplaires possédés,
	    raison du verrou (visites à l'océan / amélioration du clicker),
	    bouton Acheter ; pied de page "✏️ Place tes achats chez toi" ;
	  - se ferme avec la croix dessinée (UIUtil.CloseButton), un clic hors
	    de la fenêtre, Échap, ou en s'éloignant du comptoir ;
	  - mise à l'échelle comme le HUD (PC / tablette / téléphone).
	Achats (ShopUI.Purchase, à appeler dans un task.spawn : ça attend le
	serveur) : vérifications locales (verrou, MAX, Dopamine), puis
	  "Item" : RemoteFunction House ("buyItem", id) ;
	  "Look" : House ("buyLook", { Kind = "Garden", Id }) (déco du jardin) ;
	  "Car"  : RemoteFunction Car ("buy", id) (GARAGE96) ;
	son existant "Buy" / "Error" (SoundManager, aucun nouveau son), petit
	message (toast du HUD de la ville), astuce "Place-le chez toi : ✏️
	Meubles", et le signal ShopUI.Bought. Faute de Dopamine : message
	"Il te manque X" (la fenêtre "Get Dopamine" du clicker est masquée en
	ville).

	API (require paresseux sans effet de bord ; l'interface est construite
	à la 1re ouverture) :
	  ShopUI.OpenShop(shopId, options?)  "Pets" | "Kitchen" | "Furniture" | "Setup" |
	                                     "Garden" | "Toys" | "Cars"
	      options : { Tab = catégorie?, Anchor = Vector3? (se ferme si
	      l'avatar s'en éloigne de plus de 18 studs) }
	  ShopUI.OpenCategory(categoryId?)   la boutique qui vend cette catégorie
	                                     (onglet choisi) ; nil -> "🛍️ Tout"
	  ShopUI.Close() / ShopUI.IsOpen()
	  ShopUI.Bought : Signal (itemId, kind)   après un achat RÉUSSI
	  ShopUI.Closed : Signal ()
	  ShopUI.SetToast(fn?)               fn(text, color?) (toast du HUD)
	  ShopUI.Entry(kind, id) -> Entry?   ShopUI.Price / Owned / LockText /
	  ShopUI.IsMaxed / ShopUI.ShopEntries(shopId) / ShopUI.ShopOf(categoryId)
	  ShopUI.Purchase(entry) -> boolean  (attend le serveur)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TextService = game:GetService("TextService")

local Client = script.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local ClientState = require(Client.ClientState)
local SoundManager = require(Client.SoundManager)
local Config = require(ReplicatedStorage.Shared.Config)
local Locale = require(ReplicatedStorage.Shared.Locale)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Net = require(ReplicatedStorage.Shared.Net)
local Signal = require(ReplicatedStorage.Shared.Signal)
local HouseCommon = require(Client.Components.House.HouseCommon)

local ShopUI = {}

ShopUI.Bought = Signal.new()
ShopUI.Closed = Signal.new()

local PINK = Color3.fromRGB(255, 110, 170)
local PINK_DEEP = Color3.fromRGB(236, 72, 140)
local LILAC = Color3.fromRGB(170, 140, 245)
local MINT = Color3.fromRGB(64, 196, 150)
local INK = Color3.fromRGB(92, 58, 96)
local CARD = Color3.fromRGB(255, 250, 253)
local WHITE = Color3.new(1, 1, 1)
local GREY = Color3.fromRGB(176, 170, 190)
local RED = Color3.fromRGB(226, 80, 90)
local GREEN = Color3.fromRGB(70, 190, 120)

local ANCHOR_RANGE = 18 -- (studs) on s'éloigne du comptoir -> la fenêtre se ferme
local PAINT_PER_FRAME = 3 -- vignettes peintes par image

----------------------------------------------------------------------
-- Boutiques et onglets
----------------------------------------------------------------------

export type ShopDef = { Id: string, Name: string, Icon: string, Accent: Color3, Tabs: { string }, Blurb: string }

ShopUI.SHOPS = {
	Pets = { Id = "Pets", Name = "🐾 Pet Shop", Icon = "🐾", Accent = Color3.fromRGB(86, 176, 150), Tabs = { "Pets" },
		Blurb = "Cats, dogs, bunnies, fish… a new friend for your house" },
	Toys = { Id = "Toys", Name = "🧸 Toy Shop", Icon = "🧸", Accent = Color3.fromRGB(236, 104, 140), Tabs = { "Toys", "Sports", "Adventure" },
		Blurb = "Plushies, games, sports and adventure" },
	Kitchen = { Id = "Kitchen", Name = "🍰 Kitchen & Home", Icon = "🍰", Accent = Color3.fromRGB(214, 90, 110), Tabs = { "Kitchen" },
		Blurb = "Everything for a sweet kitchen" },
	Furniture = { Id = "Furniture", Name = "🛋️ Furniture & Decor", Icon = "🛋️", Accent = Color3.fromRGB(160, 116, 84),
		Tabs = { "Furniture", "Decor", "Lights", "Luxury", "Doors", "Windows" }, Blurb = "Sofas, beds, lamps, frames, doors and windows" },
	Setup = { Id = "Setup", Name = "🖥️ Setup Store", Icon = "🖥️", Accent = Color3.fromRGB(106, 90, 210), Tabs = { "Setup", "Electronics", "Gaming" },
		Blurb = "Desks, screens, TVs, hi-fi and gaming gear" },
	Garden = { Id = "Garden", Name = "🪴 Garden Centre", Icon = "🪴", Accent = Color3.fromRGB(84, 160, 96), Tabs = { "Plants", "SetupPlants", "GardenDecor" },
		Blurb = "Plants, dopamine flowers and garden decor" },
	Cars = { Id = "Cars", Name = "🚗 Car Dealership", Icon = "🚗", Accent = Color3.fromRGB(236, 72, 120), Tabs = { "Cars" },
		Blurb = "Buy a car, then drive it around town" },
} :: { [string]: ShopDef }
ShopUI.ORDER = { "Pets", "Toys", "Kitchen", "Furniture", "Setup", "Garden", "Cars" }

-- Catégorie de la maison -> boutique qui la vend
local SHOP_OF: { [string]: string } = {}
for _, id in ipairs(ShopUI.ORDER) do
	for _, tab in ipairs(ShopUI.SHOPS[id].Tabs) do
		SHOP_OF[tab] = id
	end
end

function ShopUI.ShopOf(categoryId: string?): string?
	return categoryId and SHOP_OF[categoryId] or nil
end

local function isSetupPlant(id: string): boolean
	return string.sub(id, 1, 10) == "SetupPlant"
end

export type Entry = { Kind: string, Id: string, Name: string, Icon: string, Def: any, Category: string }

local entryCache: { [string]: Entry } = {}

function ShopUI.Entry(kind: string, id: string): Entry?
	local key = kind .. ":" .. id
	local cached = entryCache[key]
	if cached then
		return cached
	end
	local def: any = nil
	local category = ""
	if kind == "Item" then
		def = HouseCommon.ItemsById[id]
		category = def and (isSetupPlant(id) and "SetupPlants" or tostring(def.Category)) or ""
	elseif kind == "Look" then
		local looks = (Config :: any).HouseLooksById
		def = looks and looks.Garden and looks.Garden[id]
		category = "GardenDecor"
	elseif kind == "Car" then
		local cars = (Config :: any).CarsById
		def = cars and cars[id]
		category = "Cars"
	end
	if type(def) ~= "table" then
		return nil
	end
	local entry: Entry = { Kind = kind, Id = id, Name = tostring(def.Name or id), Icon = tostring(def.Icon or "🎁"), Def = def, Category = category }
	entryCache[key] = entry
	return entry
end

-- Définition d'un onglet : nom, icône, entrées (triées par prix)
local function tabInfo(tabId: string): (string, string)
	local category = HouseCommon.CategoriesById[tabId]
	if category then
		return Locale.T(category.Name), tostring(category.Icon)
	elseif tabId == "SetupPlants" then
		return Locale.T("Dopamine plants"), "🌼"
	elseif tabId == "GardenDecor" then
		return Locale.T("Garden decor"), "🌷"
	elseif tabId == "Cars" then
		return Locale.T("All cars"), "🚗"
	end
	return tabId, "🛍️"
end

local tabCache: { [string]: { Entry } } = {}
local function tabEntries(tabId: string): { Entry }
	local cached = tabCache[tabId]
	if cached then
		return cached
	end
	local list: { Entry } = {}
	if tabId == "GardenDecor" then
		for _, look in ipairs((Config.House :: any).GardenDecor or {}) do
			local entry = ShopUI.Entry("Look", look.Id)
			if entry then
				table.insert(list, entry)
			end
		end
	elseif tabId == "Cars" then
		local cars = (Config :: any).Cars
		for _, car in ipairs(cars and cars.List or {}) do
			local entry = ShopUI.Entry("Car", car.Id)
			if entry then
				table.insert(list, entry)
			end
		end
	else
		for _, item in ipairs(HouseCommon.Config.Items) do
			local id = tostring(item.Id)
			local match
			if tabId == "SetupPlants" then
				match = isSetupPlant(id)
			else
				match = item.Category == tabId and not isSetupPlant(id)
			end
			if match then
				local entry = ShopUI.Entry("Item", id)
				if entry then
					table.insert(list, entry)
				end
			end
		end
	end
	local base: { [Entry]: number } = {}
	for index, entry in ipairs(list) do
		base[entry] = (tonumber(entry.Def.Cost) or 0) + index * 1e-6
	end
	table.sort(list, function(a, b)
		return base[a] < base[b]
	end)
	tabCache[tabId] = list
	return list
end
-- (v9.7, BUILDINGS97) entrées d'un onglet / d'une catégorie (triées par prix) :
-- rayons du supermarché (MarketInterior)
ShopUI.TabEntries = tabEntries

-- Toutes les entrées d'une boutique (par onglet, dans l'ordre)
function ShopUI.ShopEntries(shopId: string): { Entry }
	local shop = ShopUI.SHOPS[shopId]
	local list = {}
	for _, tab in ipairs(shop and shop.Tabs or {}) do
		for _, entry in ipairs(tabEntries(tab)) do
			table.insert(list, entry)
		end
	end
	return list
end

----------------------------------------------------------------------
-- Prix, possession, verrous
----------------------------------------------------------------------

local function carModels(): any?
	local module = ReplicatedStorage.Shared:FindFirstChild("CarModels")
	if not module then
		return nil
	end
	local ok, result = pcall(require, module)
	return ok and type(result) == "table" and result or nil
end

local function house(): any
	return HouseCommon.GetHouse(ClientState.Data)
end

local function carsData(): any
	local data = ClientState.Data
	local cars = type(data) == "table" and data.Cars or nil
	return type(cars) == "table" and cars or {}
end

function ShopUI.Price(entry: Entry): number
	if entry.Kind == "Item" then
		return HouseCommon.Price(entry.Def, HouseCommon.Owned(house(), entry.Id))
	end
	return tonumber(entry.Def.Cost) or 0
end

function ShopUI.Owned(entry: Entry): number
	if entry.Kind == "Item" then
		return HouseCommon.Owned(house(), entry.Id)
	elseif entry.Kind == "Look" then
		return HouseCommon.OwnsLook(house(), "Garden", entry.Id) and 1 or 0
	end
	local owned = carsData().Owned
	return type(owned) == "table" and owned[entry.Id] == true and 1 or 0
end

function ShopUI.IsMaxed(entry: Entry): boolean
	if entry.Kind == "Item" then
		return HouseCommon.IsMaxed(entry.Def, ShopUI.Owned(entry))
	end
	return ShopUI.Owned(entry) > 0
end

-- Raison du verrou (texte traduit, sans cadenas) ou nil
function ShopUI.LockText(entry: Entry): string?
	local data = ClientState.Data
	if entry.Kind == "Car" then
		local cm = carModels()
		if cm and type(cm.LockReason) == "function" then
			local ok, text = pcall(cm.LockReason, data, entry.Id)
			if ok and type(text) == "string" and text ~= "" then
				return (string.gsub(text, "^🔒%s*", ""))
			end
			return nil
		end
	end
	local _, text = HouseCommon.LockReason(data, entry.Def)
	return text
end

function ShopUI.IsSelected(entry: Entry): boolean
	return entry.Kind == "Car" and carsData().Selected == entry.Id
end

local function fmt(value: number): string
	return NumberFormatter.Format(math.floor(value + 0.5))
end
ShopUI.Format = fmt

----------------------------------------------------------------------
-- Messages
----------------------------------------------------------------------

local toastFn: ((string, Color3?) -> ())? = nil
local ui: any = nil -- interface (construite à la 1re ouverture)
local buildGui: () -> any -- (défini plus bas)

function ShopUI.SetToast(fn: ((string, Color3?) -> ())?)
	toastFn = fn
end

local function ensureGui(): any
	if ui then
		return ui
	end
	ui = buildGui()
	return ui
end

local function toast(text: string, color: Color3?)
	if toastFn then
		local ok = pcall(toastFn :: any, text, color)
		if ok then
			return
		end
	end
	local gui = ensureGui()
	gui.ShowToast(text, color)
end

-- Ligne d'état dans la fenêtre (si ouverte) + toast
local function status(text: string, color: Color3)
	if ui and ui.Open then
		ui.SetStatus(text, color)
	end
	toast(text, color)
end

----------------------------------------------------------------------
-- Achats
----------------------------------------------------------------------

local busy = false

local function invokeCar(action: string, id: string): (boolean, string?, any)
	local ok, success, message, extra = pcall(function()
		return Net.Function("Car"):InvokeServer(action, id)
	end)
	if not ok then
		return false, Locale.T("Network error, try again."), nil
	end
	return success == true, message ~= nil and tostring(message) or nil, extra
end

local function needDopamine(missing: number)
	status(Locale.T("You need %s more Dopamine", fmt(math.max(1, missing))) .. "  " .. Locale.T("👆 Click to earn more!"), PINK_DEEP)
end

-- Achète `entry` (attend le serveur) ; true si c'est fait
function ShopUI.Purchase(entry: Entry): boolean
	if busy then
		return false
	end
	local lock = ShopUI.LockText(entry)
	if lock then
		SoundManager.Play("Error", 0.7)
		status("🔒 " .. lock, LILAC)
		return false
	end
	if ShopUI.IsMaxed(entry) then
		SoundManager.Play("Error", 0.7)
		if entry.Kind == "Item" then
			status(Locale.T("You can't have more %s %s", entry.Icon, Locale.T(entry.Name)), LILAC)
		else
			status(Locale.T("✅ Already yours!"), MINT)
		end
		return false
	end
	local price = ShopUI.Price(entry)
	local have = HouseCommon.Dopamine()
	if have < price then
		SoundManager.Play("Error", 0.7)
		needDopamine(price - have)
		return false
	end
	busy = true
	local ok, message, extra
	if entry.Kind == "Item" then
		ok, message = HouseCommon.Invoke("buyItem", entry.Id)
	elseif entry.Kind == "Look" then
		ok, message = HouseCommon.Invoke("buyLook", { Kind = "Garden", Id = entry.Id })
	else
		ok, message, extra = invokeCar("buy", entry.Id)
	end
	busy = false
	if not ok then
		SoundManager.Play("Error", 0.7)
		if type(extra) == "number" and extra > 0 then
			needDopamine(extra)
		else
			status(message or Locale.T("Not possible right now."), RED)
		end
		return false
	end
	SoundManager.Play("Buy", 1.1)
	toast(message or (entry.Icon .. " " .. Locale.T(entry.Name)), GREEN)
	if entry.Kind == "Item" then
		toast(Locale.T("Place it at home: ✏️ Furniture"), LILAC)
	elseif entry.Kind == "Car" then
		toast(Locale.T("🚗 Drive it with the 🚗 My car button"), LILAC)
	end
	if ui and ui.Open then
		ui.SetStatus(message or "", GREEN)
		ui.Dirty = true
	end
	local fired = pcall(function()
		ShopUI.Bought:Fire(entry.Id, entry.Kind)
	end)
	if not fired then
		warn("[ShopUI] Bought")
	end
	return true
end

-- Voiture possédée : la choisir (celle qui sort avec "🚗 Ma voiture")
function ShopUI.SelectCar(entry: Entry): boolean
	if busy then
		return false
	end
	busy = true
	local ok, message = invokeCar("select", entry.Id)
	busy = false
	SoundManager.Play(ok and "Pop" or "Error", ok and 1.1 or 0.7)
	status(message or (ok and Locale.T("🚗 Selected!") or Locale.T("Not possible right now.")), ok and GREEN or RED)
	if ui then
		ui.Dirty = true
	end
	return ok
end

----------------------------------------------------------------------
-- Interface
----------------------------------------------------------------------

local function textWidth(text: string, size: number, font: Enum.Font?): number
	local ok, bounds = pcall(function()
		return TextService:GetTextSize(text, size, font or Theme.Fonts.Title, Vector2.new(4000, 200))
	end)
	if ok and typeof(bounds) == "Vector2" then
		return bounds.X
	end
	return (utf8.len(text) or #text) * size * 0.55
end

local function label(props: { [string]: any }): TextLabel
	return UIUtil.Create("TextLabel", {
		Name = props.Name or "Label",
		BackgroundTransparency = 1,
		Font = props.Font or Theme.Fonts.Title,
		TextColor3 = props.Color or INK,
		TextSize = props.TextSize or 16,
		TextXAlignment = props.XAlign or Enum.TextXAlignment.Center,
		TextYAlignment = props.YAlign or Enum.TextYAlignment.Center,
		TextWrapped = props.Wrap == true,
		TextTruncate = props.Wrap == true and Enum.TextTruncate.None or Enum.TextTruncate.AtEnd,
		Text = props.Text or "",
		Size = props.Size or UDim2.fromScale(1, 1),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		ZIndex = props.ZIndex or 2,
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	})
end

type Card = {
	Entry: Entry,
	Frame: Frame,
	Thumb: Frame,
	Price: TextLabel,
	Owned: TextLabel,
	Lock: TextLabel,
	Button: TextButton,
	Painted: boolean,
}

buildGui = function(): any
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local old = playerGui:FindFirstChild("TownShopGui")
	if old then
		old:Destroy()
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "TownShopGui"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 25
	gui.Enabled = true
	gui.Parent = playerGui
	local root = UIUtil.Create("Frame", { Name = "Root", BackgroundTransparency = 1, Size = UDim2.fromOffset(1100, 620), Parent = gui })
	local scale = UIUtil.Create("UIScale", { Parent = root })

	local self: any = {
		Gui = gui,
		Root = root,
		Open = false,
		Dirty = false,
		Shop = nil :: ShopDef?,
		Tab = "",
		Cards = {} :: { Card },
		Queue = {} :: { Card },
		Anchor = nil :: Vector3?,
		Phone = false,
		Conns = {} :: { RBXScriptConnection },
		Clock = 0,
		StatusUntil = 0,
	}

	-- petits messages (si le HUD de la ville n'en fournit pas)
	local toasts = UIUtil.Create("Frame", { Name = "Toasts", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 70),
		Size = UDim2.fromOffset(640, 140), ZIndex = 40, Parent = root })
	UIUtil.Create("UIListLayout", { FillDirection = Enum.FillDirection.Vertical, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder, Parent = toasts })
	local toastCount = 0
	function self.ShowToast(text: string, color: Color3?)
		toastCount += 1
		local frame = UIUtil.Create("Frame", { Name = "Toast", Size = UDim2.fromOffset(math.min(textWidth(text, 18) + 40, 640), 40), BackgroundColor3 = color or INK,
			BackgroundTransparency = 0.08, LayoutOrder = toastCount, ZIndex = 40, Parent = toasts })
		UIUtil.Corner(frame, UDim.new(1, 0))
		label({ Name = "Text", Text = text, Color = WHITE, TextSize = 18, Size = UDim2.new(1, -24, 1, 0), Position = UDim2.fromOffset(12, 0), ZIndex = 41, Parent = frame })
		task.delay(3.4, function()
			frame:Destroy()
		end)
	end

	-- voile + fenêtre
	local dimmer = UIUtil.Create("TextButton", { Name = "Dimmer", Size = UDim2.new(1, 400, 1, 400), Position = UDim2.fromOffset(-200, -200),
		BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.5, AutoButtonColor = false, Text = "", Visible = false, ZIndex = 20, Parent = root })
	local card = UIUtil.Create("Frame", { Name = "ShopCard", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.52), Size = UDim2.fromOffset(860, 540),
		BackgroundColor3 = CARD, Visible = false, ZIndex = 21, Parent = root })
	UIUtil.Corner(card, 26)
	local cardStroke = UIUtil.Stroke(card, LILAC, 3, 0)
	UIUtil.SinkClicks(card)
	UIUtil.Gradient(card, ColorSequence.new(WHITE, Color3.fromRGB(248, 240, 255)), 90)
	-- bandeau coloré en haut (couleur de la boutique)
	local band = UIUtil.Create("Frame", { Name = "Band", Size = UDim2.new(1, 0, 0, 86), BackgroundColor3 = PINK, ZIndex = 21, Parent = card })
	UIUtil.Corner(band, 26)
	local bandGradient = UIUtil.Gradient(band, ColorSequence.new(WHITE, Color3.fromRGB(214, 214, 214)), 90)
	local bandFill = UIUtil.Create("Frame", { Name = "BandFill", Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 1, -30), BackgroundColor3 = PINK,
		BorderSizePixel = 0, ZIndex = 21, Parent = band })
	local bubble = UIUtil.Create("Frame", { Name = "IconBubble", Size = UDim2.fromOffset(62, 62), Position = UDim2.fromOffset(16, 12), BackgroundColor3 = WHITE,
		ZIndex = 22, Parent = card })
	UIUtil.Corner(bubble, UDim.new(1, 0))
	UIUtil.Stroke(bubble, WHITE, 3, 0.2)
	local icon = label({ Name = "Icon", Text = "🛍️", TextSize = 36, Font = Enum.Font.BuilderSansMedium, ZIndex = 23, Parent = bubble })
	local title = label({ Name = "Title", Text = "", Color = WHITE, TextSize = 28, XAlign = Enum.TextXAlignment.Left, Size = UDim2.new(1, -330, 0, 36),
		Position = UDim2.fromOffset(92, 12), ZIndex = 22, Parent = card })
	UIUtil.Create("UIStroke", { Color = Color3.fromRGB(90, 50, 90), Thickness = 1.5, Transparency = 0.55, Parent = title })
	local subtitle = label({ Name = "Subtitle", Text = "", Color = WHITE, TextSize = 15, Font = Theme.Fonts.Body, XAlign = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -330, 0, 22), Position = UDim2.fromOffset(92, 48), ZIndex = 22, Parent = card })
	local wallet = UIUtil.Create("Frame", { Name = "Wallet", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -70, 0, 22), Size = UDim2.fromOffset(190, 42),
		BackgroundColor3 = WHITE, ZIndex = 22, Parent = card })
	UIUtil.Corner(wallet, UDim.new(1, 0))
	UIUtil.Stroke(wallet, Color3.fromRGB(255, 200, 226), 2, 0)
	local walletText = label({ Name = "Amount", Text = "🧠 0", Color = PINK_DEEP, TextSize = 20, Size = UDim2.new(1, -16, 1, 0), Position = UDim2.fromOffset(8, 0),
		ZIndex = 23, Parent = wallet })
	local close = UIUtil.CloseButton({ Name = "CloseShop", Size = 42, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 22), ZIndex = 24, Hitbox = 0 })
	close.Parent = card
	-- onglets
	local tabs = UIUtil.Create("ScrollingFrame", { Name = "Tabs", Position = UDim2.fromOffset(16, 96), Size = UDim2.new(1, -32, 0, 44), BackgroundTransparency = 1,
		BorderSizePixel = 0, ScrollBarThickness = 0, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.X, ScrollingDirection = Enum.ScrollingDirection.X,
		ZIndex = 22, Parent = card })
	UIUtil.Create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Center, Parent = tabs })
	UIUtil.Create("UIPadding", { PaddingLeft = UDim.new(0, 2), PaddingRight = UDim.new(0, 2), Parent = tabs })
	-- grille
	local grid = UIUtil.Create("ScrollingFrame", { Name = "Grid", Position = UDim2.fromOffset(14, 148), Size = UDim2.new(1, -28, 1, -196), BackgroundTransparency = 1,
		BorderSizePixel = 0, ScrollBarThickness = 7, ScrollBarImageColor3 = LILAC, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y, ZIndex = 22, Parent = card })
	local gridLayout = UIUtil.Create("UIGridLayout", { CellSize = UDim2.fromOffset(156, 222), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = grid })
	UIUtil.Create("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 8), PaddingRight = UDim.new(0, 6), Parent = grid })
	-- pied : astuce + état
	local footer = label({ Name = "Hint", Text = "", Color = INK, TextSize = 15, Font = Theme.Fonts.Body, XAlign = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -40, 0, 34), Position = UDim2.new(0, 22, 1, -44), ZIndex = 22, Parent = card })
	local statusPill = UIUtil.Create("Frame", { Name = "Status", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -8), Size = UDim2.fromOffset(400, 34),
		BackgroundColor3 = PINK_DEEP, Visible = false, ZIndex = 30, Parent = card })
	UIUtil.Corner(statusPill, UDim.new(1, 0))
	local statusText = label({ Name = "Text", Text = "", Color = WHITE, TextSize = 16, Size = UDim2.new(1, -20, 1, 0), Position = UDim2.fromOffset(10, 0), ZIndex = 31,
		Parent = statusPill })

	function self.SetStatus(text: string, color: Color3)
		if text == "" then
			statusPill.Visible = false
			return
		end
		statusText.Text = text
		statusPill.BackgroundColor3 = color
		statusPill.Size = UDim2.fromOffset(math.min(textWidth(text, 16) + 40, card.AbsoluteSize.X / math.max(0.01, scale.Scale) - 40), 34)
		statusPill.Visible = true
		self.StatusUntil = os.clock() + 3.2
	end

	----------------------------------------------------------------
	-- Cartes
	----------------------------------------------------------------

	local function buttonFor(c: Card)
		local entry = c.Entry
		local button = c.Button
		local lock = ShopUI.LockText(entry)
		local owned = ShopUI.Owned(entry)
		local color, text
		if lock then
			color, text = LILAC, "🔒"
		elseif entry.Kind == "Car" and owned > 0 then
			if ShopUI.IsSelected(entry) then
				color, text = MINT, Locale.T("✅ Selected")
			else
				color, text = PINK, Locale.T("🚗 Choose")
			end
		elseif ShopUI.IsMaxed(entry) then
			color, text = GREY, entry.Kind == "Item" and "MAX" or Locale.T("✅ Yours")
		else
			local affordable = HouseCommon.Dopamine() >= ShopUI.Price(entry)
			color, text = affordable and GREEN or Color3.fromRGB(236, 150, 90), Locale.T("Buy")
		end
		if button:GetAttribute("BaseColor") ~= color then
			button.BackgroundColor3 = color
			button:SetAttribute("BaseColor", color)
			local stroke = button:FindFirstChild("ButtonStroke")
			if stroke and stroke:IsA("UIStroke") then
				stroke.Color = UIUtil.EdgeColor(color)
			end
		end
		button.Text = text
	end

	local function refreshCard(c: Card)
		local entry = c.Entry
		local lock = ShopUI.LockText(entry)
		local owned = ShopUI.Owned(entry)
		local maxed = ShopUI.IsMaxed(entry)
		c.Price.Text = (maxed and entry.Kind ~= "Item") and "" or ("🧠 " .. fmt(ShopUI.Price(entry)))
		c.Price.TextColor3 = HouseCommon.Dopamine() >= ShopUI.Price(entry) and PINK_DEEP or Color3.fromRGB(200, 120, 90)
		c.Lock.Text = lock and ("🔒 " .. lock) or ""
		c.Lock.Visible = lock ~= nil
		c.Price.Visible = lock == nil
		if owned > 0 then
			c.Owned.Text = entry.Kind == "Item" and ("✅ x" .. owned) or "✅"
			c.Owned.Visible = true
			c.Owned.Size = UDim2.fromOffset(textWidth(c.Owned.Text, 14) + 18, 24)
		else
			c.Owned.Visible = false
		end
		c.Thumb.BackgroundTransparency = lock and 0.35 or 0
		buttonFor(c)
	end

	local function paint(c: Card)
		if c.Painted then
			return
		end
		c.Painted = true
		local entry = c.Entry
		local ok, err = pcall(function()
			if entry.Kind == "Item" then
				local HouseArt = require(Client.Components.House.HouseArt) :: any
				HouseArt.Thumbnail(c.Thumb, entry.Def, 100, 24)
			elseif entry.Kind == "Look" then
				local HouseArt = require(Client.Components.House.HouseArt) :: any
				local holder = UIUtil.Create("Frame", { Name = "Art", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
					Size = UDim2.fromOffset(100, 100), ZIndex = 24, Parent = c.Thumb })
				local body = UIUtil.Create("Frame", { Name = "Body", BackgroundTransparency = 1, Size = UDim2.fromOffset(100, 100), ZIndex = 24, Parent = holder })
				UIUtil.Create("UIScale", { Scale = 0.9, Parent = body })
				local result = HouseArt.PaintGarden(body, entry.Def, true)
				if result == nil and #body:GetChildren() <= 1 then
					label({ Name = "Emoji", Text = entry.Icon, TextSize = 60, Font = Enum.Font.BuilderSansMedium, ZIndex = 25, Parent = holder })
				end
			else
				-- vraie voiture 3D (CarModels) dans un ViewportFrame
				local cm = carModels()
				local vp = UIUtil.Create("ViewportFrame", { Name = "Car3D", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 24, Parent = c.Thumb })
				vp.Ambient = Color3.fromRGB(200, 196, 214)
				vp.LightColor = Color3.fromRGB(255, 250, 240)
				vp.LightDirection = Vector3.new(-1, -1.4, -0.6)
				if cm and type(cm.Build) == "function" then
					local model = cm.Build(entry.Id, nil, { Detail = "Mid" })
					local camera = Instance.new("Camera")
					camera.FieldOfView = 30
					local size = typeof(model:GetAttribute("Length")) == "number" and model:GetAttribute("Length") or 12
					model:PivotTo(CFrame.new(0, 0, 0) * CFrame.Angles(0, math.rad(-35), 0))
					model.Parent = vp
					local dist = size * 2.05
					camera.CFrame = CFrame.lookAt(Vector3.new(dist * 0.55, size * 0.45, -dist * 0.85), Vector3.new(0, size * 0.13, 0))
					camera.Parent = vp
					vp.CurrentCamera = camera
				else
					label({ Name = "Emoji", Text = entry.Icon, TextSize = 60, Font = Enum.Font.BuilderSansMedium, ZIndex = 25, Parent = c.Thumb })
				end
			end
		end)
		if not ok then
			warn("[ShopUI] vignette " .. entry.Id .. " : " .. tostring(err))
		end
	end

	local function makeCard(entry: Entry, order: number): Card
		-- (téléphone : vignette plus basse, carte plus compacte)
		local thumbH = self.Phone and 84 or 112
		local nameY = thumbH + 8
		local frame = UIUtil.Create("Frame", { Name = "Card_" .. entry.Id, BackgroundColor3 = WHITE, LayoutOrder = order, ZIndex = 23, Parent = grid })
		UIUtil.Corner(frame, 18)
		UIUtil.Stroke(frame, Color3.fromRGB(236, 222, 250), 2, 0)
		local thumb = UIUtil.Create("Frame", { Name = "Thumb", Size = UDim2.new(1, -12, 0, thumbH), Position = UDim2.fromOffset(6, 6),
			BackgroundColor3 = entry.Kind == "Car" and Color3.fromRGB(236, 240, 252) or HouseCommon.CategoryTint(entry.Kind == "Item" and tostring(entry.Def.Category) or "Plants"),
			ZIndex = 23, ClipsDescendants = true, Parent = frame })
		UIUtil.Corner(thumb, 14)
		local owned = label({ Name = "Owned", Text = "", Color = WHITE, TextSize = 14, Size = UDim2.fromOffset(44, 24), Position = UDim2.fromOffset(12, 12), ZIndex = 27,
			Parent = frame })
		owned.BackgroundColor3 = MINT
		owned.BackgroundTransparency = 0
		UIUtil.Corner(owned, UDim.new(1, 0))
		label({ Name = "Name", Text = entry.Icon .. " " .. Locale.T(entry.Name), Color = INK, TextSize = self.Phone and 14 or 15, Wrap = true, Size = UDim2.new(1, -14, 0, 36),
			Position = UDim2.fromOffset(7, nameY), ZIndex = 24, Parent = frame })
		local price = label({ Name = "Price", Text = "", Color = PINK_DEEP, TextSize = 17, Size = UDim2.new(1, -14, 0, 20), Position = UDim2.fromOffset(7, nameY + 37),
			ZIndex = 24, Parent = frame })
		local lock = label({ Name = "Lock", Text = "", Color = Color3.fromRGB(130, 100, 200), TextSize = 12, Font = Theme.Fonts.Body, Wrap = true,
			Size = UDim2.new(1, -14, 0, 26), Position = UDim2.fromOffset(7, nameY + 33), ZIndex = 24, Parent = frame })
		local button = UIUtil.PillButton({ Name = "Buy", Text = Locale.T("Buy"), Color = GREEN, Height = 30, TextSize = 16, ZIndex = 24, AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -7), Parent = frame })
		button.AutomaticSize = Enum.AutomaticSize.None
		button.Size = UDim2.new(1, -24, 0, 30)
		local c: Card = { Entry = entry, Frame = frame, Thumb = thumb, Price = price, Owned = owned, Lock = lock, Button = button, Painted = false }
		button.Activated:Connect(function()
			if entry.Kind == "Car" and ShopUI.Owned(entry) > 0 and ShopUI.LockText(entry) == nil then
				task.spawn(ShopUI.SelectCar, entry)
				return
			end
			task.spawn(function()
				local okBuy = ShopUI.Purchase(entry)
				if not okBuy then
					UIUtil.Shake(button)
				else
					UIUtil.Pop(frame, 1.08, 0.25)
				end
				refreshCard(c)
			end)
		end)
		refreshCard(c)
		return c
	end

	local function clearCards()
		for _, c in ipairs(self.Cards) do
			c.Frame:Destroy()
		end
		table.clear(self.Cards)
		table.clear(self.Queue)
	end

	local tabButtons: { [string]: TextButton } = {}
	local function selectTab(tabId: string)
		self.Tab = tabId
		for id, button in pairs(tabButtons) do
			local on = id == tabId
			local color = on and (self.Shop and self.Shop.Accent or PINK) or WHITE
			button.BackgroundColor3 = color
			button:SetAttribute("BaseColor", color)
			button.TextColor3 = on and WHITE or INK
		end
		clearCards()
		local list = tabEntries(tabId)
		for index, entry in ipairs(list) do
			local c = makeCard(entry, index)
			table.insert(self.Cards, c)
			table.insert(self.Queue, c)
		end
		grid.CanvasPosition = Vector2.zero
		local shop = self.Shop
		local name = tabInfo(tabId)
		subtitle.Text = string.format("%s  ·  %s", Locale.T(shop and shop.Blurb or ""), Locale.T("%s items", tostring(#list)))
		if tabId == "Cars" then
			subtitle.Text = string.format("%s  ·  %s", Locale.T(shop and shop.Blurb or ""), Locale.T("%s cars", tostring(#list)))
		end
		local _ = name
	end

	local function buildTabs(shop: ShopDef, first: string)
		for _, child in ipairs(tabs:GetChildren()) do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		table.clear(tabButtons)
		for index, tabId in ipairs(shop.Tabs) do
			local name, tabIcon = tabInfo(tabId)
			local text = string.format("%s %s  %d", tabIcon, name, #tabEntries(tabId))
			local button = UIUtil.PillButton({ Name = "Tab_" .. tabId, Text = text, Color = WHITE, Height = 38, TextSize = 17, LayoutOrder = index, ZIndex = 23,
				TextColor3 = INK, Parent = tabs })
			button.AutomaticSize = Enum.AutomaticSize.None
			button.Size = UDim2.fromOffset(textWidth(text, 17) + 40, 38)
			button.Activated:Connect(function()
				if self.Tab ~= tabId then
					SoundManager.Play("Click", 1.1)
					selectTab(tabId)
				end
			end)
			tabButtons[tabId] = button
		end
		tabs.Visible = #shop.Tabs > 1
		grid.Position = UDim2.fromOffset(14, #shop.Tabs > 1 and 148 or 100)
		grid.Size = UDim2.new(1, -28, 1, #shop.Tabs > 1 and -196 or -148)
		selectTab(first)
	end

	local function layout()
		local size = gui.AbsoluteSize
		if size.X < 10 or size.Y < 10 then
			return
		end
		local touch = UserInputService.TouchEnabled and not UserInputService.MouseEnabled
		local phone = touch and math.min(size.X, size.Y) < 500
		self.Phone = phone
		local designW, designH = phone and 820 or 1100, phone and 430 or 620
		local s = math.clamp(math.min(size.X / designW, size.Y / designH), 0.45, 1.35)
		scale.Scale = s
		root.Size = UDim2.fromOffset(size.X / s, size.Y / s)
		local rootW, rootH = size.X / s, size.Y / s
		card.Size = UDim2.fromOffset(math.min(900, rootW - 24), math.min(phone and 420 or 560, rootH - 16))
		gridLayout.CellSize = phone and UDim2.fromOffset(140, 192) or UDim2.fromOffset(156, 222)
		footer.Visible = not phone
	end
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout)
	layout()

	local function updateWallet()
		walletText.Text = "🧠 " .. fmt(HouseCommon.Dopamine())
	end

	function self.Show(shop: ShopDef, tab: string, anchor: Vector3?)
		self.Shop = shop
		self.Anchor = anchor
		band.BackgroundColor3 = shop.Accent
		bandFill.BackgroundColor3 = shop.Accent
		bandGradient.Enabled = true
		cardStroke.Color = shop.Accent
		icon.Text = shop.Icon
		title.Text = Locale.T(shop.Name)
		footer.Text = shop.Id == "Cars" and Locale.T("🚗 Your cars wait in your garage: take one out with 🚗 My car")
			or Locale.T("✏️ Your purchases go to your inventory: place them at home with ✏️ Furniture")
		statusPill.Visible = false
		-- (si la ville a masqué l'interface à une entrée précédente)
		gui.Enabled = true
		updateWallet()
		layout()
		dimmer.Visible = true
		card.Visible = true
		self.Open = true
		buildTabs(shop, tab)
		UIUtil.Pop(card, 0.92, 0.2)
	end

	function self.Hide()
		if not self.Open then
			return
		end
		self.Open = false
		dimmer.Visible = false
		card.Visible = false
		clearCards()
	end

	local function requestClose()
		(ShopUI :: any).Close()
	end
	dimmer.Activated:Connect(requestClose)
	close.Activated:Connect(requestClose)
	UserInputService.InputBegan:Connect(function(input)
		if self.Open and input.KeyCode == Enum.KeyCode.Escape then
			requestClose()
		end
	end)
	ClientState.Changed:Connect(function()
		if self.Open then
			self.Dirty = true
		end
	end)
	RunService.Heartbeat:Connect(function(dt)
		if not self.Open then
			return
		end
		-- vignettes : quelques-unes par image
		local painted = 0
		while painted < PAINT_PER_FRAME and self.Queue[1] do
			paint(table.remove(self.Queue, 1) :: Card)
			painted += 1
		end
		self.Clock += dt
		if self.Clock < 0.25 then
			return
		end
		self.Clock = 0
		updateWallet()
		if self.Dirty then
			self.Dirty = false
			for _, c in ipairs(self.Cards) do
				refreshCard(c)
			end
		end
		if statusPill.Visible and os.clock() > self.StatusUntil then
			statusPill.Visible = false
		end
		-- on s'éloigne du comptoir : la fenêtre se ferme
		local anchor = self.Anchor
		local character = Players.LocalPlayer.Character
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
		if anchor and rootPart and rootPart:IsA("BasePart") and (rootPart.Position - anchor).Magnitude > ANCHOR_RANGE then
			(ShopUI :: any).Close()
		end
	end)
	return self
end

----------------------------------------------------------------------
-- Ouvrir / fermer
----------------------------------------------------------------------

-- "🛍️ Tout" : toutes les catégories d'objets de la maison
local ALL_SHOP: ShopDef = { Id = "All", Name = "🛍️ Town catalog", Icon = "🛍️", Accent = PINK, Tabs = {}, Blurb = "Every item of every shop" }
do
	for _, category in ipairs(HouseCommon.Config.Categories or {}) do
		table.insert(ALL_SHOP.Tabs, tostring(category.Id))
	end
	table.insert(ALL_SHOP.Tabs, "SetupPlants")
end
-- (v9.7, BUILDINGS97) "🛒 MégaDopa" : le supermarché vend TOUT (catalogue
-- complet de la maison + déco du jardin), ouvert aux caisses
local MARKET_SHOP: ShopDef = { Id = "Market", Name = "🛒 MegaDopa", Icon = "🛒", Accent = Color3.fromRGB(236, 72, 140), Tabs = table.clone(ALL_SHOP.Tabs),
	Blurb = "Everything for your home, at brainy prices" }
table.insert(MARKET_SHOP.Tabs, "GardenDecor")
ShopUI.MARKET = MARKET_SHOP

function ShopUI.OpenShop(shopId: string, options: { Tab: string?, Anchor: Vector3? }?)
	local shop: ShopDef? = ShopUI.SHOPS[shopId]
	if shopId == "All" then
		shop = ALL_SHOP
	elseif shopId == "Market" then
		shop = MARKET_SHOP
	end
	if not shop then
		return
	end
	local tab = options and options.Tab
	if not tab or not table.find(shop.Tabs, tab) then
		tab = shop.Tabs[1]
	end
	local gui = ensureGui()
	if gui.Open then
		gui.Hide()
	end
	SoundManager.Play("Open", 1.1)
	gui.Show(shop, tab :: string, options and options.Anchor)
end

function ShopUI.OpenCategory(categoryId: string?)
	local shopId = ShopUI.ShopOf(categoryId)
	if shopId then
		ShopUI.OpenShop(shopId, { Tab = categoryId })
	else
		ShopUI.OpenShop("All", { Tab = categoryId })
	end
end

function ShopUI.Close()
	if ui and ui.Open then
		ui.Hide()
		pcall(function()
			ShopUI.Closed:Fire()
		end)
	end
end

function ShopUI.IsOpen(): boolean
	return ui ~= nil and ui.Open == true
end

-- (tests / rendus) état interne
function ShopUI.Debug(): any
	return ui
end

return ShopUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="225">
          <Properties>
            <string name="Name">SitAnimator</string>
            <string name="Source"><![CDATA[--[[
	SitAnimator (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > SitAnimator

	v9.8 🪑 S'asseoir "pour de vrai" dans Dopamine Town (SEAT98).
	Les animations ne peuvent pas être téléversées : tout est PROCÉDURAL, calculé
	chaque image côté client sur les Motor6D du personnage (R15 ET R6).

	  1. Tirer la chaise (chaises, chaises de bureau, tabourets) : l'invite
	     "S'asseoir" -> la chaise glisse en arrière (~1 stud, moins si un mur
	     est derrière), l'avatar s'avance devant l'assise (Humanoid:MoveTo,
	     court, avec délai max), puis on demande le siège au serveur
	     ("sit", inchangé). Une fois assis, la chaise (et le siège du serveur,
	     localement) revient doucement vers la table avec l'avatar dessus.
	     En se levant : la chaise recule puis se range toute seule.
	     Bureau gamer : seule la chaise bouge (pièces autour de l'assise).
	  2. Transitions douces : en s'asseyant, le corps part de là où il était
	     debout (position, orientation, pose) et descend sur le siège en se
	     penchant un peu en avant ; en se levant, la pose assise se fond dans
	     la pose debout.
	  3. Animations d'attente (après 8 à 15 s assis, puis toutes les 5 à 10 s) :
	     regarder autour, s'étirer, se pencher en arrière (mains derrière la
	     tête), croiser les jambes, balancer les pieds, regarder son téléphone
	     (petit téléphone dans la main), piquer du nez (canapé), dormir
	     (allongé sur un lit, 💤), bras en l'air (manèges). Respiration
	     légère en continu. Au bureau (vu des autres) : mains sur le clavier.
	  4. Les autres joueurs : le serveur met sur son siège "SitKind" et
	     "SitAt" (heure serveur) ; chaque client anime alors les joueurs
	     assis proches (≤ 60 studs, ≤ 6) avec le MÊME tirage (graine =
	     UserId + SitAt) : tout le monde voit à peu près la même chose, sans
	     nouveau remote. Leur chaise se range aussi chez nous.

	Robustesse (jamais de pose cassée) :
	  - on n'écrit que Motor6D.Transform (jamais C0/C1), dans RunService.Stepped
	    (après l'Animator) : l'animation de Roblox reprend la main dès qu'on
	    arrête d'écrire ; la base est relue chaque image (si l'Animator n'a pas
	    réécrit un joint, on repart de la dernière base connue : aucun cumul) ;
	  - arrêt : se lever (saut, bouton, serveur), bouger (le pas reprend le
	    compte à zéro), émote (piste de priorité Action), mode bureau
	    (DeskMode.IsActive / Changed : l'avatar y est masqué), mort, retrait
	    du personnage, sortie de la ville (Stop) ; toute erreur -> tout est
	    remis et le module se coupe (avertissement unique) ;
	  - les chaises reviennent EXACTEMENT à leur place (CFrame d'origine) ; si
	    quelqu'un d'autre a déplacé la chaise entre-temps (mode édition,
	    reconstruction de la pièce), on n'y touche plus.

	v9.9 (REALISM99) :
	  - ASSIS = plus aucune invite "S'asseoir" (maisons, bancs, parc,
	    jardin, manèges) : portée des invites mise à 0 tant que
	    Humanoid.SeatPart existe, remise en se levant (voir stepPrompts) ;
	    convention pour les nouveaux sièges : nom SitPrompt / ParkPrompt /
	    SeatPrompt / BenchPrompt / GardenSeatPrompt, ou attribut
	    SitPrompt = true sur l'invite ;
	  - (PARK99) sièges des jeux du parc (attribut ParkPose) : animés par
	    ParkPlay seul, pas par ce module.

	API (appelée par TownClient) :
	  SitAnimator.Start()     à l'entrée en ville
	  SitAnimator.Stop()      à la sortie (tout est remis)
	  SitAnimator.Approach(model, seatPart, sit)
	      remplace l'appel direct au serveur dans l'invite "S'asseoir" :
	      tire la chaise, avance l'avatar, puis appelle sit(cf, kind)
	      (cf = même CFrame qu'avant : dessus de la SeatPart ; kind = "chair",
	      "desk", "stool", "sofa", "bed", "bench", "seat")
	  SitAnimator.KindOf(model?, seat?) -> string
	  SitAnimator.Debug() -> état interne (tests)
	  SitAnimator.HiddenPrompts() -> { [ProximityPrompt]: portée d'origine } (tests)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Locale = require(ReplicatedStorage.Shared.Locale)

local SitAnimator = {}

----------------------------------------------------------------------
-- Réglages
----------------------------------------------------------------------

local PULL: { [string]: number } = { chair = 1.1, desk = 1.2, stool = 0.6 } -- (studs) chaise tirée
local PULL_TIME = 0.35 -- (s) la chaise recule
local SIT_TIME = 0.6 -- (s) descente sur le siège
local TUCK_DELAY = 0.5 -- (s) après l'assise, la chaise revient…
local TUCK_TIME = 0.55 -- …en tant de temps
local STAND_TIME = 0.4 -- (s) fondu de la pose assise vers la pose debout
local STAND_OUT = 0.3 -- (s) en se levant, la chaise recule…
local STAND_BACK = 0.55 -- …attend…
local STAND_IN = 0.45 -- …et se range
local APPROACH_MAX = 1.6 -- (s) au plus pour s'avancer devant la chaise
local SEAT_WAIT = 3 -- (s) le serveur n'a pas assis l'avatar : on range la chaise
local FIRST_IDLE = { 8, 15 } -- (s) première animation d'attente
local IDLE_GAP = { 5, 10 } -- (s) entre deux animations
local REMOTE_RADIUS = 60 -- (studs) autres joueurs animés…
local REMOTE_MAX = 6 -- …au plus
local SCAN_INTERVAL = 0.35 -- (s) recherche des autres joueurs assis / émotes
local PAUSE_SPEED = 4 -- (1/s) fondu vers / depuis la pause (bureau, émote)
local MOVE_THRESHOLD = 0.1
local TELEPORT = 10 -- (studs) au-delà : pas de glissé depuis la position debout

local KINDS: { [string]: boolean } = { chair = true, desk = true, stool = true, sofa = true, bed = true, bench = true, seat = true, ride = true }

-- Nature d'un meuble d'après son identifiant (premier mot trouvé)
local KIND_RULES: { { string } } = {
	{ "petbed", "sofa" },
	{ "hammock", "bed" },
	{ "bed", "bed" },
	{ "futon", "bed" },
	{ "sofa", "sofa" },
	{ "couch", "sofa" },
	{ "sectional", "sofa" },
	{ "loveseat", "sofa" },
	{ "divan", "sofa" },
	{ "throne", "sofa" },
	{ "armchair", "sofa" },
	{ "recliner", "sofa" },
	{ "eggchair", "sofa" },
	{ "rocking", "sofa" },
	{ "beanbag", "sofa" },
	{ "pouf", "sofa" },
	{ "cushion", "sofa" },
	{ "cinema", "sofa" },
	{ "bench", "bench" },
	{ "stool", "stool" },
	{ "setupdesk", "desk" },
	{ "rig", "seat" },
	{ "cockpit", "seat" },
	{ "chair", "chair" },
}

local IDENTITY = CFrame.identity
local UP = Vector3.new(0, 1, 0)
local rad = math.rad

----------------------------------------------------------------------
-- Petits outils
----------------------------------------------------------------------

local function clamp01(x: number): number
	return math.clamp(x, 0, 1)
end

local function smooth(x: number): number
	x = clamp01(x)
	return x * x * (3 - 2 * x)
end

local function now(): number
	return os.clock()
end

local function serverNow(): number
	local ok, t = pcall(function()
		return workspace:GetServerTimeNow()
	end)
	return ok and type(t) == "number" and t or os.clock()
end

-- Générateur pseudo-aléatoire DÉTERMINISTE (même suite sur tous les clients)
local function makeRng(seed: number): () -> number
	local state = math.floor(math.abs(seed)) % 2147483646 + 1
	for _ = 1, 3 do
		state = (state * 48271) % 2147483647
	end
	return function(): number
		state = (state * 48271) % 2147483647
		return state / 2147483647
	end
end

local function sameCF(a: CFrame, b: CFrame): boolean
	local c1 = { a:GetComponents() }
	local c2 = { b:GetComponents() }
	for i = 1, 12 do
		if math.abs(c1[i] - c2[i]) > 1e-4 then
			return false
		end
	end
	return true
end

-- Manette de Roblox (PlayerModule) : vecteur de déplacement même assis
local controlsTried = false
local controls: any = nil
local function moveMagnitude(humanoid: Humanoid?): number
	local magnitude = 0
	if humanoid then
		local direction = humanoid.MoveDirection
		magnitude = typeof(direction) == "Vector3" and direction.Magnitude or 0
	end
	if not controlsTried then
		controlsTried = true
		pcall(function()
			local player = Players.LocalPlayer
			local scripts = player and player:FindFirstChild("PlayerScripts")
			local module = scripts and scripts:FindFirstChild("PlayerModule")
			if module and module:IsA("ModuleScript") then
				controls = (require(module) :: any):GetControls()
			end
		end)
	end
	if controls then
		local ok, vector = pcall(function()
			return controls:GetMoveVector()
		end)
		if ok and typeof(vector) == "Vector3" then
			magnitude = math.max(magnitude, vector.Magnitude)
		end
	end
	return magnitude
end

-- 🖥️ DeskMode (DESK98) : chargé paresseusement, en pcall
local deskTried = false
local deskModule: any = nil
local function desk(): any
	if not deskTried then
		deskTried = true
		pcall(function()
			local module = script.Parent:FindFirstChild("DeskMode")
			if module and module:IsA("ModuleScript") then
				local result = require(module) :: any
				if type(result) == "table" then
					deskModule = result
				end
			end
		end)
	end
	return deskModule
end

local function deskActive(): boolean
	local d = desk()
	if not d or type(d.IsActive) ~= "function" then
		return false
	end
	local ok, result = pcall(d.IsActive)
	return ok and result == true
end

----------------------------------------------------------------------
-- Nature du siège
----------------------------------------------------------------------

local function kindFromId(itemId: string): string?
	local id = string.lower(itemId)
	for _, rule in ipairs(KIND_RULES) do
		if string.find(id, rule[1], 1, true) then
			return rule[2]
		end
	end
	return nil
end

function SitAnimator.KindOf(model: Instance?, seat: Instance?): string
	for _, holder in ipairs({ seat, model }) do
		if holder then
			local tagged = holder:GetAttribute("SitKind")
			if type(tagged) == "string" and KINDS[tagged] then
				return tagged
			end
		end
	end
	if model then
		local id = model:GetAttribute("ItemId")
		local kind = type(id) == "string" and kindFromId(id) or nil
		if kind then
			return kind
		end
	end
	if seat and seat:IsA("BasePart") then
		if string.sub(seat.Name, 1, 9) == "TownSeat_" then
			return "seat"
		end
		-- siège d'un manège (FAIR98) : ancêtre nommé comme un manège, ou siège qui bouge
		local node: Instance? = seat.Parent
		for _ = 1, 6 do
			if not node or node == workspace then
				break
			end
			local tagged = node:GetAttribute("SitKind")
			if type(tagged) == "string" and KINDS[tagged] then
				return tagged
			end
			local name = string.lower(node.Name)
			if string.find(name, "ride", 1, true) or string.find(name, "fair", 1, true) or string.find(name, "carousel", 1, true)
				or string.find(name, "wheel", 1, true) or string.find(name, "manege", 1, true) or string.find(name, "swing", 1, true) then
				return "ride"
			end
			node = node.Parent
		end
		if not seat.Anchored then
			return "ride"
		end
		return "bench"
	end
	return "seat"
end

----------------------------------------------------------------------
-- 🪑 Chaises qui glissent (tirer / ranger)
----------------------------------------------------------------------

type Step = { To: number, Dur: number, Wait: number, Started: boolean? }
type Chair = {
	Key: BasePart, -- SeatPart du meuble
	Parts: { BasePart },
	Origins: { CFrame },
	Dir: Vector3, -- vers l'arrière de la chaise (unitaire, horizontal)
	Offset: number,
	From: number,
	Steps: { Step },
	StepT: number,
	Hold: boolean, -- gardée tirée (on attend l'assise)
	Seat: BasePart?, -- siège du serveur déplacé avec la chaise (localement)
	SeatOrigin: CFrame?,
}

local chairs: { [BasePart]: Chair } = {}

local function modelOfSeatPart(seatPart: BasePart): Model?
	local node: Instance? = seatPart.Parent
	for _ = 1, 4 do
		if not node then
			return nil
		end
		if node:IsA("Model") and node:GetAttribute("ItemId") ~= nil then
			return node
		end
		node = node.Parent
	end
	local parent = seatPart.Parent
	return (parent and parent:IsA("Model")) and parent or nil
end

-- Pièces de la chaise : tout le modèle, ou (bureau gamer) seulement celles
-- autour de l'assise (la chaise fait partie du modèle du bureau)
local function chairParts(model: Model, seatPart: BasePart, kind: string): { BasePart }
	local list = {}
	if kind ~= "desk" then
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then
				table.insert(list, d)
			end
		end
		return list
	end
	local seatCF = seatPart.CFrame
	local radius = math.max(seatPart.Size.X, seatPart.Size.Z) * 0.62 + 0.3
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Name ~= "Root" and d.Name ~= "Hitbox" and d.Name ~= "Screen" then
			local lp = seatCF:PointToObjectSpace(d.Position)
			local flat = math.sqrt(lp.X * lp.X + lp.Z * lp.Z)
			-- (plateau du bureau : large ; chaise : pièces courtes proches de l'assise)
			if flat <= radius and math.max(d.Size.X, d.Size.Z) <= radius * 2.4 and lp.Z > -radius * 0.9 then
				table.insert(list, d)
			end
		end
	end
	return list
end

local function dropChair(chair: Chair)
	if chairs[chair.Key] == chair then
		chairs[chair.Key] = nil
	end
end

-- Place la chaise à `offset` studs vers l'arrière ; false = quelqu'un d'autre
-- l'a bougée (on la laisse tranquille)
local function setOffset(chair: Chair, offset: number): boolean
	local parts, cframes = {}, {}
	local checked = false
	for i, part in ipairs(chair.Parts) do
		if part.Parent then
			local origin = chair.Origins[i]
			if not checked then
				checked = true
				local expected = origin.Position + chair.Dir * chair.Offset
				if (part.Position - expected).Magnitude > 0.08 then
					dropChair(chair)
					return false
				end
			end
			table.insert(parts, part)
			table.insert(cframes, origin + chair.Dir * offset)
		end
	end
	if #parts == 0 then
		dropChair(chair)
		return false
	end
	local ok = pcall(function()
		workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end)
	if not ok then
		for i, part in ipairs(parts) do
			part.CFrame = cframes[i]
		end
	end
	local seat = chair.Seat
	local seatOrigin = chair.SeatOrigin
	if seat and seatOrigin then
		if seat.Parent then
			pcall(function()
				seat.CFrame = seatOrigin + chair.Dir * offset
			end)
		else
			chair.Seat = nil
			chair.SeatOrigin = nil
		end
	end
	chair.Offset = offset
	return true
end

local function chairFor(model: Model?, seatPart: BasePart?, kind: string): Chair?
	if not model or not seatPart or not PULL[kind] or not seatPart.Parent then
		return nil
	end
	local existing = chairs[seatPart]
	if existing then
		return existing
	end
	local look = seatPart.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.05 then
		return nil
	end
	local parts = chairParts(model, seatPart, kind)
	if #parts == 0 then
		return nil
	end
	local origins = {}
	for i, part in ipairs(parts) do
		origins[i] = part.CFrame
	end
	local chair: Chair = {
		Key = seatPart,
		Parts = parts,
		Origins = origins,
		Dir = -flat.Unit,
		Offset = 0,
		From = 0,
		Steps = {},
		StepT = 0,
		Hold = false,
		Seat = nil,
		SeatOrigin = nil,
	}
	chairs[seatPart] = chair
	return chair
end

local function chairTo(chair: Chair, to: number, duration: number, wait: number?)
	table.insert(chair.Steps, { To = to, Dur = math.max(0.05, duration), Wait = wait or 0 })
end

-- Place libre derrière la chaise (mur, autre meuble) : on ne recule pas dedans
local function freePull(chair: Chair, seatPart: BasePart, wanted: number, ignore: { Instance }): number
	local ok, result = pcall(function()
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = ignore
		local back = math.max(seatPart.Size.Z, seatPart.Size.X) * 0.5 + 0.35
		local origin = seatPart.Position + UP * 1.2
		local hit = workspace:Raycast(origin, chair.Dir * (back + wanted + 0.3), params)
		if hit then
			return math.clamp((hit.Position - origin).Magnitude - back - 0.3, 0, wanted)
		end
		return wanted
	end)
	return ok and type(result) == "number" and result or wanted
end

local function stepChairs(dt: number)
	for _, chair in pairs(chairs) do
		local step = chair.Steps[1]
		if not step then
			if chair.Offset == 0 and not chair.Hold then
				dropChair(chair)
			end
		else
			chair.StepT += dt
			if chair.StepT >= step.Wait then
				if not step.Started then
					step.Started = true
					chair.From = chair.Offset
				end
				local a = clamp01((chair.StepT - step.Wait) / step.Dur)
				local value = chair.From + (step.To - chair.From) * smooth(a)
				if a >= 1 then
					value = step.To
				end
				if setOffset(chair, value) and a >= 1 then
					table.remove(chair.Steps, 1)
					chair.StepT = 0
				end
			end
		end
	end
end

local function restoreChairs()
	for _, chair in pairs(chairs) do
		chair.Hold = false
		table.clear(chair.Steps)
		if chair.Offset ~= 0 then
			pcall(setOffset, chair, 0)
		end
		dropChair(chair)
	end
	table.clear(chairs)
end

-- Meuble (modèle + SeatPart) sous un siège du serveur, dans les maisons construites ici
local function furnitureAt(position: Vector3): (Model?, BasePart?)
	local ok, parts = pcall(function()
		local params = OverlapParams.new()
		local houses = workspace:FindFirstChild("TownHouses")
		if houses then
			params.FilterType = Enum.RaycastFilterType.Include
			params.FilterDescendantsInstances = { houses }
		end
		return workspace:GetPartBoundsInRadius(position, 1.6, params)
	end)
	if not ok or type(parts) ~= "table" then
		return nil, nil
	end
	local best: BasePart? = nil
	local bestDistance = math.huge
	for _, part in ipairs(parts) do
		if part.Name == "SeatPart" then
			local distance = (part.Position - position).Magnitude
			if distance < bestDistance then
				best, bestDistance = part, distance
			end
		end
	end
	if not best then
		return nil, nil
	end
	return modelOfSeatPart(best), best
end

----------------------------------------------------------------------
-- 🦴 Squelette (R15 / R6)
----------------------------------------------------------------------

local R15_JOINTS: { [string]: { string } } = {
	Root = { "LowerTorso", "Root" },
	Waist = { "UpperTorso", "Waist" },
	Neck = { "Head", "Neck" },
	RShoulder = { "RightUpperArm", "RightShoulder" },
	RElbow = { "RightLowerArm", "RightElbow" },
	RWrist = { "RightHand", "RightWrist" },
	LShoulder = { "LeftUpperArm", "LeftShoulder" },
	LElbow = { "LeftLowerArm", "LeftElbow" },
	LWrist = { "LeftHand", "LeftWrist" },
	RHip = { "RightUpperLeg", "RightHip" },
	RKnee = { "RightLowerLeg", "RightKnee" },
	RAnkle = { "RightFoot", "RightAnkle" },
	LHip = { "LeftUpperLeg", "LeftHip" },
	LKnee = { "LeftLowerLeg", "LeftKnee" },
	LAnkle = { "LeftFoot", "LeftAnkle" },
}
local R6_JOINTS: { [string]: { string } } = {
	Root = { "HumanoidRootPart", "RootJoint" },
	Neck = { "Torso", "Neck" },
	RShoulder = { "Torso", "Right Shoulder" },
	LShoulder = { "Torso", "Left Shoulder" },
	RHip = { "Torso", "Right Hip" },
	LHip = { "Torso", "Left Hip" },
}

type Joint = {
	Motor: Motor6D,
	C0: CFrame,
	C0r: CFrame,
	C0rInv: CFrame,
	Base: CFrame?, -- dernière pose de l'Animator
	Written: CFrame?, -- dernière valeur écrite par nous
}

type Limb = { P: Vector3, L1: number, L2: number }

type Rig = {
	R6: boolean,
	Joints: { [string]: Joint },
	Root: BasePart,
	Head: BasePart?,
	Hand: BasePart?, -- main droite (téléphone)
	Scale: number,
	Arms: { [string]: Limb },
	Legs: { [string]: Limb },
	Torso: BasePart?,
}

local function limbOf(joints: { [string]: Joint }, a: string, b: string, c: string?, r6: boolean, scale: number): Limb?
	local j1 = joints[a]
	if not j1 then
		return nil
	end
	local l1, l2 = 1.6 * scale, 0
	if not r6 and c then
		local j2, j3 = joints[b], joints[c]
		if not j2 or not j3 then
			return nil
		end
		l1 = (j1.Motor.C1.Position - j2.C0.Position).Magnitude
		l2 = (j2.Motor.C1.Position - j3.C0.Position).Magnitude
		if l1 < 0.1 or l2 < 0.1 then
			return nil
		end
	end
	return { P = j1.C0.Position, L1 = l1, L2 = l2 }
end

local function rigOf(character: Model, humanoid: Humanoid): Rig?
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return nil
	end
	local r6 = humanoid.RigType == Enum.HumanoidRigType.R6
	local joints: { [string]: Joint } = {}
	for key, spec in pairs(r6 and R6_JOINTS or R15_JOINTS) do
		local part = character:FindFirstChild(spec[1])
		local motor = part and part:FindFirstChild(spec[2])
		if motor and motor:IsA("Motor6D") then
			local c0 = motor.C0
			joints[key] = { Motor = motor, C0 = c0, C0r = c0.Rotation, C0rInv = c0.Rotation:Inverse(), Base = nil, Written = nil }
		end
	end
	if not joints.Root then
		return nil
	end
	local torso = character:FindFirstChild(r6 and "Torso" or "UpperTorso")
	local scale = 1
	if torso and torso:IsA("BasePart") then
		scale = math.clamp(torso.Size.Y / (r6 and 2 or 1.6), 0.5, 2)
	end
	local head = character:FindFirstChild("Head")
	local hand = character:FindFirstChild(r6 and "Right Arm" or "RightHand")
	local rig: Rig = {
		R6 = r6,
		Joints = joints,
		Root = root,
		Head = (head and head:IsA("BasePart")) and head or nil,
		Hand = (hand and hand:IsA("BasePart")) and hand or nil,
		Scale = scale,
		Arms = {},
		Legs = {},
		Torso = (torso and torso:IsA("BasePart")) and torso or nil,
	}
	rig.Arms.R = limbOf(joints, "RShoulder", "RElbow", "RWrist", r6, scale) :: any
	rig.Arms.L = limbOf(joints, "LShoulder", "LElbow", "LWrist", r6, scale) :: any
	rig.Legs.R = limbOf(joints, "RHip", "RKnee", "RAnkle", r6, scale) :: any
	rig.Legs.L = limbOf(joints, "LHip", "LKnee", "LAnkle", r6, scale) :: any
	return rig
end

----------------------------------------------------------------------
-- Poses : couches appliquées sur la pose de l'Animator
--   Abs(key, R, w) : orientation du membre (repère du parent) ; Add : rotation
--   ajoutée autour de l'articulation (repère du parent) ; w = poids 0..1
----------------------------------------------------------------------

type Pose = { Rig: Rig, Work: { [string]: CFrame } }

local function abs(pose: Pose, key: string, r: CFrame, w: number)
	local joint = pose.Rig.Joints[key]
	if not joint or w <= 0.001 then
		return
	end
	local current = pose.Work[key] or IDENTITY
	pose.Work[key] = current:Lerp(joint.C0rInv * r * joint.C0r, math.min(w, 1))
end

local function add(pose: Pose, key: string, r: CFrame, w: number)
	if w <= 0.001 then
		return
	end
	local joint = pose.Rig.Joints[key]
	if not joint then
		-- R6 : pas de "Waist" -> le buste entier tourne, les jambes restent
		if key == "Waist" and pose.Rig.R6 then
			add(pose, "Root", r, w)
			local back = r:Inverse()
			add(pose, "RHip", back, w)
			add(pose, "LHip", back, w)
		end
		return
	end
	local weighted = w >= 1 and r or IDENTITY:Lerp(r, w)
	local current = pose.Work[key] or IDENTITY
	pose.Work[key] = (joint.C0rInv * weighted * joint.C0r) * current
end

-- Orientation d'un segment : -Y le long de `dir`, "devant" (-Z) vers `front`
local function frameAlong(dir: Vector3, front: Vector3): CFrame
	local y = -dir.Unit
	local z = -(front - dir.Unit * front:Dot(dir.Unit))
	if z.Magnitude < 1e-3 then
		z = Vector3.new(0, 0, 1)
		z = z - dir.Unit * z:Dot(dir.Unit)
		if z.Magnitude < 1e-3 then
			z = Vector3.new(1, 0, 0)
		end
	end
	z = z.Unit
	local x = y:Cross(z)
	return CFrame.fromMatrix(Vector3.zero, x, y, z)
end

-- IK à deux segments (bras / jambe R15) dans le repère du parent : la main
-- (poignet) ou la cheville vise `target`, le coude / genou part vers `pole`.
-- bend = 1 (bras : le coude plie vers -Z) ou -1 (jambe : le genou plie vers +Z)
local function ik2(limb: Limb, target: Vector3, pole: Vector3, bend: number): (CFrame, number)
	local d = target - limb.P
	local dn = d.Magnitude > 1e-4 and d.Unit or Vector3.new(0, -1, 0)
	local l1, l2 = limb.L1, limb.L2
	local dist = math.clamp(d.Magnitude, math.abs(l1 - l2) + 0.05, l1 + l2 - 0.02)
	local cosA = math.clamp((l1 * l1 + dist * dist - l2 * l2) / (2 * l1 * dist), -1, 1)
	local a = math.acos(cosA)
	local perp = pole - dn * pole:Dot(dn)
	if perp.Magnitude < 1e-3 then
		perp = Vector3.new(0, 0, -1) - dn * (-dn.Z)
		if perp.Magnitude < 1e-3 then
			perp = Vector3.new(1, 0, 0)
		end
	end
	perp = perp.Unit
	local u = dn * math.cos(a) + perp * math.sin(a)
	local elbow = limb.P + u * l1
	local f = limb.P + dn * dist - elbow
	f = f.Magnitude > 1e-4 and f.Unit or u
	local flex = math.acos(math.clamp(u:Dot(f), -1, 1))
	local b = f - u * f:Dot(u)
	if b.Magnitude < 1e-3 then
		b = -perp
	else
		b = b.Unit
	end
	local y = -u
	local z = bend > 0 and -b or b
	local x = y:Cross(z)
	return CFrame.fromMatrix(Vector3.zero, x, y, z), flex
end

-- Bras : la main vise `target` (repère du buste, depuis son centre, studs d'un
-- avatar standard, mis à l'échelle), coude vers `pole`
local function reach(pose: Pose, side: string, target: Vector3, pole: Vector3, w: number)
	local rig = pose.Rig
	local limb = rig.Arms[side]
	if not limb or w <= 0.001 then
		return
	end
	local shoulder = side == "R" and "RShoulder" or "LShoulder"
	local t = target * rig.Scale
	if rig.R6 then
		abs(pose, shoulder, frameAlong(t - limb.P, Vector3.new(0, 0, -1)), w)
		return
	end
	local r, flex = ik2(limb, t, pole, 1)
	abs(pose, shoulder, r, w)
	abs(pose, side == "R" and "RElbow" or "LElbow", CFrame.Angles(flex, 0, 0), w)
	abs(pose, side == "R" and "RWrist" or "LWrist", IDENTITY, w)
end

-- Jambe : la cheville vise hanche + `offset` (repère du bassin), genou vers `pole`
local function stride(pose: Pose, side: string, offset: Vector3, pole: Vector3, w: number)
	local rig = pose.Rig
	local limb = rig.Legs[side]
	if not limb or w <= 0.001 then
		return
	end
	local hip = side == "R" and "RHip" or "LHip"
	local t = limb.P + offset * rig.Scale
	if rig.R6 then
		abs(pose, hip, frameAlong(t - limb.P, Vector3.new(0, 0, -1)), w)
		return
	end
	local r, flex = ik2(limb, t, pole, -1)
	abs(pose, hip, r, w)
	abs(pose, side == "R" and "RKnee" or "LKnee", CFrame.Angles(-flex, 0, 0), w)
end

----------------------------------------------------------------------
-- Animations d'attente
----------------------------------------------------------------------

type Anim = any
type Clip = {
	Name: string,
	Duration: number,
	FadeIn: number,
	FadeOut: number,
	Apply: (pose: Pose, t: number, d: number, w: number, anim: Anim) -> (),
}

local function wave(t: number, period: number): number
	return math.sin(2 * math.pi * t / period)
end

local CLIPS: { [string]: Clip } = {}

-- 👀 regarder autour de soi
CLIPS.Look = {
	Name = "Look",
	Duration = 5,
	FadeIn = 0.5,
	FadeOut = 0.6,
	Apply = function(pose, t, d, w)
		local u = t / d
		local yaw = 52 * math.sin(2 * math.pi * u) * smooth(u * 4) * smooth((1 - u) * 4)
		local pitch = 6 * math.sin(4 * math.pi * u)
		add(pose, "Neck", CFrame.Angles(rad(pitch), rad(yaw), 0), w)
		add(pose, "Waist", CFrame.Angles(0, rad(yaw * 0.28), 0), w)
	end,
}

-- 🙆 s'étirer (bras au-dessus de la tête, dos cambré, bâillement)
CLIPS.Stretch = {
	Name = "Stretch",
	Duration = 4.4,
	FadeIn = 0.9,
	FadeOut = 1.1,
	Apply = function(pose, t, _d, w)
		local sway = wave(t, 2.2)
		reach(pose, "R", Vector3.new(0.55 + 0.05 * sway, 3.05, 0.05), Vector3.new(1, 0.2, 0.6), w)
		reach(pose, "L", Vector3.new(-0.55 + 0.05 * sway, 3.05, 0.05), Vector3.new(-1, 0.2, 0.6), w)
		add(pose, "Waist", CFrame.Angles(rad(9), rad(4 * sway), 0), w)
		add(pose, "Neck", CFrame.Angles(rad(20), 0, 0), w)
	end,
}

-- 😌 se pencher en arrière, mains derrière la tête
CLIPS.Lean = {
	Name = "Lean",
	Duration = 7,
	FadeIn = 0.9,
	FadeOut = 0.9,
	Apply = function(pose, t, _d, w, anim)
		local back = anim.Kind == "sofa" and 20 or 13
		add(pose, "Waist", CFrame.Angles(rad(back + 1.5 * wave(t, 3.5)), 0, 0), w)
		add(pose, "Neck", CFrame.Angles(rad(-back * 0.45), rad(6 * wave(t, 5)), 0), w)
		reach(pose, "R", Vector3.new(0.32, 1.35, 0.55), Vector3.new(1, 0.1, -0.2), w)
		reach(pose, "L", Vector3.new(-0.32, 1.35, 0.55), Vector3.new(-1, 0.1, -0.2), w)
	end,
}

-- 🦵 croiser les jambes (la droite sur la gauche)
CLIPS.Cross = {
	Name = "Cross",
	Duration = 8,
	FadeIn = 0.8,
	FadeOut = 0.8,
	Apply = function(pose, t, _d, w)
		local tap = 0.06 * wave(t, 1.3)
		stride(pose, "R", Vector3.new(-0.62, -0.72 + tap, -1.55), Vector3.new(-0.4, 1, -1), w)
		add(pose, "Waist", CFrame.Angles(rad(3), rad(-5), 0), w)
		add(pose, "Neck", CFrame.Angles(0, rad(4), 0), w)
		-- mains posées sur le genou
		reach(pose, "R", Vector3.new(0.05, -1.05, -1.2), Vector3.new(1, -0.4, 0.3), w * 0.8)
		reach(pose, "L", Vector3.new(-0.2, -1.1, -1.15), Vector3.new(-1, -0.4, 0.3), w * 0.8)
	end,
}

-- 🦶 balancer les pieds
CLIPS.Swing = {
	Name = "Swing",
	Duration = 5,
	FadeIn = 0.5,
	FadeOut = 0.6,
	Apply = function(pose, t, _d, w, anim)
		local s = wave(t, 1.1)
		if anim.Rig.R6 then
			add(pose, "RHip", CFrame.Angles(rad(12 * s), 0, 0), w)
			add(pose, "LHip", CFrame.Angles(rad(-12 * s), 0, 0), w)
		else
			add(pose, "RKnee", CFrame.Angles(rad(24 * s), 0, 0), w)
			add(pose, "LKnee", CFrame.Angles(rad(-24 * s), 0, 0), w)
			add(pose, "RAnkle", CFrame.Angles(rad(10 * s), 0, 0), w)
			add(pose, "LAnkle", CFrame.Angles(rad(-10 * s), 0, 0), w)
		end
		add(pose, "Neck", CFrame.Angles(rad(-4), rad(8 * wave(t, 2.6)), 0), w)
	end,
}

-- 📱 regarder son téléphone (petit téléphone dans la main droite)
CLIPS.Phone = {
	Name = "Phone",
	Duration = 8,
	FadeIn = 0.7,
	FadeOut = 0.7,
	Apply = function(pose, t, _d, w, anim)
		local tap = 0.03 * math.max(0, wave(t, 0.45))
		reach(pose, "R", Vector3.new(0.28, -0.05 + tap, -0.85), Vector3.new(0.6, -1, 0.5), w)
		reach(pose, "L", Vector3.new(-0.12, -0.15, -0.8), Vector3.new(-0.6, -1, 0.5), w)
		add(pose, "Neck", CFrame.Angles(rad(-26 + 3 * wave(t, 3.1)), rad(4), 0), w)
		add(pose, "Waist", CFrame.Angles(rad(-4), 0, 0), w)
		anim.WantPhone = w > 0.25
	end,
}

-- 😪 piquer du nez (canapé) : la tête tombe doucement… et se relève d'un coup
CLIPS.Doze = {
	Name = "Doze",
	Duration = 7,
	FadeIn = 0.8,
	FadeOut = 0.4,
	Apply = function(pose, t, d, w, anim)
		local drop = smooth(t / (d - 0.9)) * (1 - smooth((t - (d - 0.9)) / 0.25))
		add(pose, "Neck", CFrame.Angles(rad(-32 * drop), rad(10 * drop), 0), w)
		add(pose, "Waist", CFrame.Angles(rad(6 * drop), 0, 0), w)
		anim.WantZzz = drop > 0.5 and w > 0.5
	end,
}

-- 😴 dormir (lit) : allongé sur le dos, mains sur le ventre, respiration, 💤
CLIPS.Sleep = {
	Name = "Sleep",
	Duration = 24,
	FadeIn = 1.4,
	FadeOut = 1.4,
	Apply = function(pose, t, _d, w, anim)
		local bed = anim.Bed
		local drop = bed and bed.Drop or 0.6
		-- (repère tourné du lit ; la pose de base a déjà tourné et reculé le corps)
		local yaw = CFrame.Angles(0, rad(bed and bed.Yaw or 0), 0)
		local sitShift = CFrame.new(0, 0, bed and bed.SitShift or 0)
		add(pose, "Root", yaw * CFrame.new(0, -drop, bed and bed.Shift or 0) * CFrame.Angles(rad(86), 0, 0) * sitShift:Inverse() * yaw:Inverse(), w)
		abs(pose, "RHip", CFrame.Angles(rad(4), 0, rad(3)), w)
		abs(pose, "LHip", CFrame.Angles(rad(4), 0, rad(-3)), w)
		abs(pose, "RKnee", CFrame.Angles(rad(-5), 0, 0), w)
		abs(pose, "LKnee", CFrame.Angles(rad(-5), 0, 0), w)
		-- bras le long du corps, posés sur le matelas
		local down = anim.Rig.R6 and -1.7 or -0.85
		reach(pose, "R", Vector3.new(1.25, down, -0.12), Vector3.new(1, 0, 1), w)
		reach(pose, "L", Vector3.new(-1.25, down, -0.12), Vector3.new(-1, 0, 1), w)
		add(pose, "Neck", CFrame.Angles(rad(-10), rad(18), 0), w)
		add(pose, "Waist", CFrame.Angles(rad(1.8 * wave(t, 4.2)), 0, 0), w)
		anim.WantZzz = w > 0.6
	end,
}

-- 🙌 bras en l'air (manège)
CLIPS.Hands = {
	Name = "Hands",
	Duration = 3.4,
	FadeIn = 0.4,
	FadeOut = 0.6,
	Apply = function(pose, t, _d, w)
		local s = wave(t, 0.8)
		reach(pose, "R", Vector3.new(1.2 + 0.1 * s, 2.9, -0.3), Vector3.new(1, 0, 0.5), w)
		reach(pose, "L", Vector3.new(-1.2 - 0.1 * s, 2.9, -0.3), Vector3.new(-1, 0, 0.5), w)
		add(pose, "Neck", CFrame.Angles(rad(12), rad(10 * s), 0), w)
	end,
}

-- Programme par nature de siège : { clip, poids }
local PROGRAM: { [string]: { { any } } } = {
	-- (chaise à une table : pas de jambes croisées, le genou passerait dans le plateau)
	chair = { { "Look", 3 }, { "Stretch", 2 }, { "Phone", 3 }, { "Lean", 2 }, { "Swing", 1 } },
	desk = { { "Look", 2 }, { "Stretch", 3 }, { "Lean", 2 }, { "Phone", 1 } },
	stool = { { "Look", 3 }, { "Swing", 3 }, { "Phone", 2 }, { "Stretch", 1 } },
	sofa = { { "Lean", 3 }, { "Cross", 2 }, { "Phone", 3 }, { "Stretch", 2 }, { "Look", 2 }, { "Doze", 2 } },
	bench = { { "Look", 3 }, { "Cross", 2 }, { "Stretch", 2 }, { "Swing", 1 }, { "Phone", 2 }, { "Lean", 1 } },
	bed = { { "Sleep", 5 }, { "Stretch", 2 }, { "Phone", 2 }, { "Look", 1 } },
	ride = { { "Hands", 3 }, { "Look", 2 }, { "Swing", 2 } },
	seat = { { "Look", 3 }, { "Stretch", 2 }, { "Phone", 2 }, { "Cross", 1 } },
}

local function pickClip(kind: string, rng: () -> number, last: string?): Clip
	local list = PROGRAM[kind] or PROGRAM.seat
	local function draw(): string
		local total = 0
		for _, entry in ipairs(list) do
			total += entry[2]
		end
		local x = rng() * total
		for _, entry in ipairs(list) do
			x -= entry[2]
			if x <= 0 then
				return entry[1]
			end
		end
		return list[#list][1]
	end
	local name = draw()
	if name == last and #list > 1 then
		name = draw()
	end
	return CLIPS[name] or CLIPS.Look
end

----------------------------------------------------------------------
-- Personnages animés
----------------------------------------------------------------------

type Sched = { Rng: () -> number, Next: number, Clip: Clip?, Start: number, Stop: number, Last: string?, Kind: string }

local anims: { [Model]: Anim } = {}
local started = false
local failed = false
local connections: { RBXScriptConnection } = {}
local deskConnection: RBXScriptConnection? = nil
local propsFolder: Folder? = nil
local pending: any = nil -- approche en cours (joueur local)
local lastStand: CFrame? = nil -- HRP du joueur local debout (image précédente)
local lastStandT: { [string]: CFrame } = {}
local scanClock = 0

local function newSched(seed: number, from: number, kind: string): Sched
	local rng = makeRng(seed)
	return { Rng = rng, Next = from + FIRST_IDLE[1] + rng() * (FIRST_IDLE[2] - FIRST_IDLE[1]), Clip = nil, Start = 0, Stop = 0, Last = nil, Kind = kind }
end

local function advanceSched(sched: Sched, elapsed: number)
	for _ = 1, 400 do
		local clip = sched.Clip
		if clip and elapsed >= sched.Stop then
			sched.Last = clip.Name
			sched.Clip = nil
			sched.Next = sched.Stop + IDLE_GAP[1] + sched.Rng() * (IDLE_GAP[2] - IDLE_GAP[1])
		elseif not clip and elapsed >= sched.Next then
			local picked = pickClip(sched.Kind, sched.Rng, sched.Last)
			sched.Clip = picked
			sched.Start = sched.Next
			sched.Stop = sched.Next + picked.Duration
		else
			return
		end
	end
end

local function propsParent(): Instance
	local folder = propsFolder
	if folder and folder.Parent then
		return folder
	end
	local created = Instance.new("Folder")
	created.Name = "SitAnimatorProps"
	created.Parent = workspace
	propsFolder = created
	return created
end

local PHONE_TEXTS = { "❤️ New like!", "💬 New message", "📈 Dopamine +12%", "🎮 Your turn!" }

local function makePhone(anim: Anim): BasePart
	local phone = Instance.new("Part")
	phone.Name = "SitPhone"
	phone.Size = Vector3.new(0.34, 0.62, 0.06)
	phone.Color = Color3.fromRGB(34, 32, 44)
	phone.Material = Enum.Material.SmoothPlastic
	phone.Anchored = true
	phone.CanCollide = false
	phone.CanTouch = false
	phone.CanQuery = false
	phone.CastShadow = false
	local screen = Instance.new("SurfaceGui")
	screen.Name = "Screen"
	screen.Face = Enum.NormalId.Front
	screen.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	screen.PixelsPerStud = 160
	screen.LightInfluence = 0.2
	screen.Brightness = 1
	screen.MaxDistance = 40
	screen.Parent = phone
	local glass = Instance.new("Frame")
	glass.Size = UDim2.new(1, -6, 1, -8)
	glass.Position = UDim2.fromOffset(3, 4)
	glass.BackgroundColor3 = Color3.fromRGB(255, 170, 210)
	glass.BorderSizePixel = 0
	glass.Parent = screen
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = glass
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, -6, 0.5, 0)
	label.Position = UDim2.new(0, 3, 0.25, 0)
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextWrapped = true
	label.TextColor3 = Color3.fromRGB(60, 30, 70)
	label.Text = Locale.T(PHONE_TEXTS[(anim.PhoneN or 0) % #PHONE_TEXTS + 1])
	label.Parent = glass
	phone.Parent = propsParent()
	return phone
end

local function makeZzz(anim: Anim): BillboardGui?
	local head = anim.Rig.Head
	if not head then
		return nil
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "SitZzz"
	gui.Adornee = head
	gui.Size = UDim2.fromScale(1.6, 1.6)
	gui.StudsOffset = Vector3.new(0.9, 1.3, 0)
	gui.MaxDistance = 45
	gui.LightInfluence = 0
	gui.Brightness = 1
	local label = Instance.new("TextLabel")
	label.Name = "Z"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Text = "💤"
	label.Parent = gui
	gui.Parent = propsParent()
	return gui
end

local function clearProps(anim: Anim)
	if anim.Phone then
		pcall(anim.Phone.Destroy, anim.Phone)
		anim.Phone = nil
	end
	if anim.Zzz then
		pcall(anim.Zzz.Destroy, anim.Zzz)
		anim.Zzz = nil
	end
end

-- Lit : on s'y allonge dans le sens de la longueur, tête vers la tête de lit
local function bedInfo(anim: Anim)
	local seat: BasePart = anim.Seat
	local model: Model? = anim.Model
	local rig: Rig = anim.Rig
	-- Yaw : lacet du corps ; Drop : descente du bassin couché ; SitShift / Shift :
	-- recul du bassin (vers la tête de lit) assis / couché, dans le repère tourné
	local info = { Yaw = 0, Drop = 0.6, SitShift = 0, Shift = 0 }
	-- bassin -> centre de la tête, pose de repos (chaîne Root, Waist, Neck du rig)
	local headDist = 0
	for _, key in ipairs({ "Root", "Waist", "Neck" }) do
		local joint = rig.Joints[key]
		if joint then
			headDist += (key ~= "Root" and math.abs(joint.C0.Y) or 0) + math.abs(joint.Motor.C1.Y)
		end
	end
	headDist = math.clamp(headDist, 1, 5)
	-- hauteur : le dos à ~0,5 stud au-dessus du matelas
	pcall(function()
		local root = rig.Joints.Root
		local pivot = (rig.Root.CFrame * root.C0).Position
		local top = (seat.CFrame * CFrame.new(0, seat.Size.Y / 2, 0)).Position
		info.Drop = math.clamp(pivot.Y - top.Y - 0.55 * rig.Scale, 0, 2.5)
	end)
	if model then
		pcall(function()
			local frame = seat.CFrame
			local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
			local highL, highR, highF, highB = 0, 0, 0, 0
			local parts = {}
			for _, d in ipairs(model:GetDescendants()) do
				if d:IsA("BasePart") and d.Transparency < 1 then
					local rel = frame:ToObjectSpace(d.CFrame)
					local p = rel.Position
					minX, maxX = math.min(minX, p.X), math.max(maxX, p.X)
					minZ, maxZ = math.min(minZ, p.Z), math.max(maxZ, p.Z)
					table.insert(parts, { p, d.Size, rel })
				end
			end
			for _, entry in ipairs(parts) do
				local p: Vector3, size: Vector3 = entry[1], entry[2]
				local top = p.Y + size.Y / 2
				if p.X < minX + (maxX - minX) * 0.25 then
					highL = math.max(highL, top)
				elseif p.X > maxX - (maxX - minX) * 0.25 then
					highR = math.max(highR, top)
				end
				if p.Z < minZ + (maxZ - minZ) * 0.25 then
					highF = math.max(highF, top)
				elseif p.Z > maxZ - (maxZ - minZ) * 0.25 then
					highB = math.max(highB, top)
				end
			end
			if (maxX - minX) > (maxZ - minZ) * 1.15 then
				-- lit "de profil" : tête du côté le plus haut (tête de lit)
				info.Yaw = highR >= highL and 90 or -90
			else
				info.Yaw = highF > highB + 0.3 and 180 or 0
			end
			-- bord du lit côté tête : assis, le dos contre la tête de lit ;
			-- couché, la tête sur l'oreiller (jamais dans la tête de lit)
			local h = CFrame.Angles(0, rad(info.Yaw), 0):VectorToWorldSpace(Vector3.new(0, 0, 1))
			local edge = -math.huge
			for _, entry in ipairs(parts) do
				local p: Vector3, size: Vector3, rel: CFrame = entry[1], entry[2], entry[3]
				-- (demi-épaisseur de la pièce tournée le long de h)
				local half = math.abs(rel.RightVector:Dot(h)) * size.X / 2 + math.abs(rel.UpVector:Dot(h)) * size.Y / 2
					+ math.abs(rel.LookVector:Dot(h)) * size.Z / 2
				edge = math.max(edge, p:Dot(h) + half)
			end
			if edge > -math.huge then
				info.SitShift = math.clamp(edge - 0.5 - 0.65 * rig.Scale, 0, 3)
				info.Shift = math.clamp(edge - 0.5 - 0.7 * rig.Scale - headDist, -4, 3)
			end
		end)
	end
	return info
end

-- Pose de base selon le siège (lit : assis dans le lit, jambes allongées ;
-- bureau vu des autres : mains sur le clavier)
local function applyKindBase(pose: Pose, anim: Anim, w: number, t: number)
	if anim.Kind == "bed" then
		local bed = anim.Bed
		if bed then
			add(pose, "Root", CFrame.Angles(0, rad(bed.Yaw), 0) * CFrame.new(0, 0, bed.SitShift), w)
		end
		abs(pose, "RHip", CFrame.Angles(rad(86), 0, rad(2)), w)
		abs(pose, "LHip", CFrame.Angles(rad(86), 0, rad(-2)), w)
		abs(pose, "RKnee", CFrame.Angles(rad(-6), 0, 0), w)
		abs(pose, "LKnee", CFrame.Angles(rad(-6), 0, 0), w)
		abs(pose, "RAnkle", CFrame.Angles(rad(-20), 0, 0), w)
		abs(pose, "LAnkle", CFrame.Angles(rad(-20), 0, 0), w)
		reach(pose, "R", Vector3.new(0.75, -1.25, -0.75), Vector3.new(1, 0, 0.3), w * 0.9)
		reach(pose, "L", Vector3.new(-0.75, -1.25, -0.75), Vector3.new(-1, 0, 0.3), w * 0.9)
	elseif anim.Kind == "desk" and not anim.Local then
		local k = 0.04 * wave(t, 0.23)
		reach(pose, "R", Vector3.new(0.45, -0.55 + k, -1.45), Vector3.new(1, -1, 0.3), w)
		reach(pose, "L", Vector3.new(-0.45, -0.55 - k, -1.45), Vector3.new(-1, -1, 0.3), w)
		add(pose, "Neck", CFrame.Angles(rad(-6), 0, 0), w)
		add(pose, "Waist", CFrame.Angles(rad(-5), 0, 0), w)
	end
end

local function restoreJoints(anim: Anim)
	local rig: Rig? = anim.Rig
	if not rig then
		return
	end
	for _, joint in pairs(rig.Joints) do
		if joint.Written and joint.Motor.Parent then
			pcall(function()
				joint.Motor.Transform = joint.Base or IDENTITY
			end)
		end
		joint.Written = nil
		joint.Base = nil
	end
end

local function removeAnim(anim: Anim)
	restoreJoints(anim)
	clearProps(anim)
	if anims[anim.Character] == anim then
		anims[anim.Character] = nil
	end
end

local function seedOf(userId: number, seat: Instance): (number, number)
	local at = seat:GetAttribute("SitAt")
	local sitAt = type(at) == "number" and at or serverNow()
	return userId * 7919 + math.floor(sitAt * 10) % 1000003, sitAt
end

-- Le personnage vient de s'asseoir sur `seat`
local function beginSit(character: Model, humanoid: Humanoid, seat: BasePart, isLocal: boolean, player: Player?)
	local old = anims[character]
	if old then
		removeAnim(old)
	end
	local rig = rigOf(character, humanoid)
	if not rig then
		return
	end
	local info = nil
	if isLocal and pending and (pending.CF.Position - seat.Position).Magnitude < 2.5 then
		info = pending
	end
	local model: Model? = info and info.Model or nil
	local seatPart: BasePart? = info and info.SeatPart or nil
	if not model and string.sub(seat.Name, 1, 9) == "TownSeat_" then
		model, seatPart = furnitureAt(seat.Position)
	end
	local kind = info and info.Kind or SitAnimator.KindOf(model, seat)
	if not KINDS[kind] then
		kind = "seat"
	end
	local userId = player and player.UserId or 0
	local seed, sitAt = seedOf(userId, seat)
	local anim: Anim = {
		Character = character,
		Humanoid = humanoid,
		Rig = rig,
		Seat = seat,
		Model = model,
		SeatPart = seatPart,
		Kind = kind,
		Local = isLocal,
		Player = player,
		Phase = "sit",
		PhaseT = 0,
		Start = {},
		From = {},
		SitAt = sitAt,
		Seed = seed,
		Resets = 0,
		Pause = 1,
		PauseTarget = 1,
		TrackClock = 0,
		PhoneN = seed % 4,
		WantPhone = false,
		WantZzz = false,
	}
	-- (tirage depuis l'assise : un client qui arrive plus tard retombe sur le même programme)
	anim.Sched = newSched(seed, 0, kind)
	if kind == "bed" then
		anim.Bed = bedInfo(anim)
	end
	-- pose de départ : celle de l'image précédente (debout)
	for key, joint in pairs(rig.Joints) do
		anim.Start[key] = (isLocal and lastStandT[key]) or joint.Motor.Transform
	end
	-- glissé depuis là où l'on était debout (joueur local)
	local standCF = isLocal and lastStand or nil
	if standCF and (standCF.Position - rig.Root.Position).Magnitude < TELEPORT then
		anim.StandCF = standCF
	end
	anims[character] = anim
	-- 🪑 chaise : glisse vers la table avec l'avatar (siège du serveur déplacé localement)
	local chair: Chair? = info and info.Chair or nil
	if not chair and seatPart and PULL[kind] and model then
		chair = chairFor(model, seatPart, kind)
		if chair and chair.Offset == 0 and #chair.Steps == 0 then
			local pull = freePull(chair, seatPart, PULL[kind], { model, character })
			if pull > 0.15 then
				setOffset(chair, pull)
			end
		end
	end
	if chair and chairs[chair.Key] == chair then
		chair.Hold = false
		table.clear(chair.Steps)
		chair.Seat = seat
		chair.SeatOrigin = seat.CFrame
		if chair.Offset > 0 then
			setOffset(chair, chair.Offset)
			chairTo(chair, 0, TUCK_TIME, TUCK_DELAY)
		end
	end
	anim.Chair = chair
	if info then
		pending = nil
	end
end

-- Le personnage se lève
local function beginStand(anim: Anim)
	if anim.Phase == "stand" then
		return
	end
	anim.Phase = "stand"
	anim.PhaseT = 0
	for key, joint in pairs(anim.Rig.Joints) do
		anim.From[key] = joint.Written or joint.Motor.Transform
	end
	clearProps(anim)
	-- la chaise recule un peu puis se range
	local model, seatPart = anim.Model, anim.SeatPart
	if model and seatPart and PULL[anim.Kind] and seatPart.Parent then
		local chair = chairFor(model, seatPart, anim.Kind)
		if chair then
			chair.Seat = nil
			chair.SeatOrigin = nil
			table.clear(chair.Steps)
			local pull = freePull(chair, seatPart, PULL[anim.Kind] * 0.7, { model, anim.Character })
			if pull > 0.15 then
				chairTo(chair, pull, STAND_OUT, 0)
				chairTo(chair, 0, STAND_IN, STAND_BACK)
			else
				chairTo(chair, 0, 0.2, 0)
			end
		end
	end
end

-- Remet l'horloge des animations d'attente à zéro (le joueur a bougé…)
local function resetIdle(anim: Anim)
	anim.Resets += 1
	local elapsed = math.max(0, serverNow() - anim.SitAt)
	anim.Sched = newSched(anim.Seed + anim.Resets * 104729, elapsed, anim.Kind)
end

-- L'animation d'attente en cours s'efface vite (au lieu de s'arrêter net)
local function fadeCurrent(anim: Anim)
	local clip = anim.Sched.Clip
	if not clip then
		return
	end
	local ct = math.max(0, serverNow() - anim.SitAt) - anim.Sched.Start
	local d = clip.Duration
	anim.Fading = { Clip = clip, T = ct, W = smooth(ct / clip.FadeIn) * smooth((d - ct) / clip.FadeOut) }
end

-- Une émote (piste Action ou plus) joue-t-elle ?
local function emotePlaying(humanoid: Humanoid): boolean
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		return false
	end
	local ok, tracks = pcall(function()
		return animator:GetPlayingAnimationTracks()
	end)
	if not ok or type(tracks) ~= "table" then
		return false
	end
	for _, track in ipairs(tracks) do
		local priority = track.Priority
		if priority == Enum.AnimationPriority.Action or priority == Enum.AnimationPriority.Action2
			or priority == Enum.AnimationPriority.Action3 or priority == Enum.AnimationPriority.Action4 then
			if track.IsPlaying and track.WeightCurrent > 0.3 then
				return true
			end
		end
	end
	return false
end

local function updateProps(anim: Anim)
	local rig: Rig = anim.Rig
	-- 📱 téléphone : devant la main droite, écran tourné vers la tête
	if anim.WantPhone and anim.Pause > 0.5 and rig.Hand and rig.Head then
		local phone = anim.Phone
		if not phone or not phone.Parent then
			anim.PhoneN = (anim.PhoneN or 0) + 1
			phone = makePhone(anim)
			anim.Phone = phone
		end
		local hand = rig.Hand
		local handPos = hand.Position
		if rig.R6 then
			handPos = (hand.CFrame * CFrame.new(0, -hand.Size.Y / 2 + 0.2, 0)).Position
		end
		local head = rig.Head.Position
		local look = head - handPos
		if look.Magnitude > 0.1 then
			local at = handPos + look.Unit * 0.22 + UP * 0.12
			phone.CFrame = CFrame.lookAt(at, head, rig.Root.CFrame.UpVector)
		end
	elseif anim.Phone then
		pcall(anim.Phone.Destroy, anim.Phone)
		anim.Phone = nil
	end
	-- 💤 bulle au-dessus de la tête
	if anim.WantZzz and anim.Pause > 0.5 then
		local zzz = anim.Zzz
		if not zzz or not zzz.Parent then
			zzz = makeZzz(anim)
			anim.Zzz = zzz
		end
		if zzz then
			local t = now() % 2.4 / 2.4
			zzz.StudsOffset = Vector3.new(0.9 + 0.2 * t, 1.1 + 1.1 * t, 0)
			local label = zzz:FindFirstChild("Z")
			if label and label:IsA("TextLabel") then
				label.TextTransparency = math.clamp(t * 1.4 - 0.4, 0, 1)
			end
		end
	elseif anim.Zzz then
		pcall(anim.Zzz.Destroy, anim.Zzz)
		anim.Zzz = nil
	end
end

-- Une image d'un personnage animé ; false = terminé (retiré)
local function stepAnim(anim: Anim, dt: number): boolean
	local character: Model = anim.Character
	local humanoid: Humanoid = anim.Humanoid
	local rig: Rig = anim.Rig
	if not character.Parent or not humanoid.Parent or humanoid.Health <= 0 or not rig.Root.Parent then
		removeAnim(anim)
		return false
	end
	anim.PhaseT += dt
	-- toujours assis sur ce siège ?
	if anim.Phase ~= "stand" and (humanoid.SeatPart ~= anim.Seat or not anim.Seat.Parent) then
		beginStand(anim)
	end
	-- pause : bureau (joueur local), émote
	anim.TrackClock -= dt
	if anim.TrackClock <= 0 then
		anim.TrackClock = SCAN_INTERVAL
		anim.Emote = emotePlaying(humanoid)
	end
	local paused = anim.Emote == true or (anim.Local and deskActive())
	anim.PauseTarget = paused and 0 or 1
	if anim.Pause < anim.PauseTarget then
		anim.Pause = math.min(anim.PauseTarget, anim.Pause + dt * PAUSE_SPEED)
	elseif anim.Pause > anim.PauseTarget then
		anim.Pause = math.max(anim.PauseTarget, anim.Pause - dt * PAUSE_SPEED)
	end
	-- bouger (joueur local), pause : l'animation d'attente s'efface, on recompte
	local moved = anim.Local and anim.Phase == "seated" and moveMagnitude(humanoid) > MOVE_THRESHOLD
	if (moved or paused) and (anim.Sched.Clip or moved) then
		fadeCurrent(anim)
		resetIdle(anim)
	end
	-- bases lues sur l'Animator
	local pose: Pose = { Rig = rig, Work = {} }
	for key, joint in pairs(rig.Joints) do
		local current = joint.Motor.Transform
		local base = current
		if joint.Written and joint.Base and sameCF(current, joint.Written) then
			base = joint.Base
		end
		joint.Base = base
		pose.Work[key] = base
	end
	anim.WantPhone = false
	anim.WantZzz = false
	local t = now()
	if anim.Phase == "stand" then
		local a = smooth(anim.PhaseT / STAND_TIME)
		for key, joint in pairs(rig.Joints) do
			local from = anim.From[key]
			if from and a < 1 then
				local value = from:Lerp(pose.Work[key], a)
				joint.Motor.Transform = value
				joint.Written = value
			end
		end
		if anim.PhaseT >= STAND_TIME then
			removeAnim(anim)
			return false
		end
		return true
	end
	local w = anim.Pause
	applyKindBase(pose, anim, w, t)
	-- respiration
	add(pose, "Waist", CFrame.Angles(rad(0.9 * wave(t, 4.1)), 0, 0), w)
	-- animation d'attente (même tirage chez tout le monde)
	local elapsed = math.max(0, serverNow() - anim.SitAt)
	if anim.Phase == "seated" then
		advanceSched(anim.Sched, elapsed)
		local clip = anim.Sched.Clip
		if clip then
			local ct = elapsed - anim.Sched.Start
			local d = clip.Duration
			local env = smooth(ct / clip.FadeIn) * smooth((d - ct) / clip.FadeOut)
			clip.Apply(pose, ct, d, env * w, anim)
		end
		-- animation interrompue (le joueur a bougé, pause) : fondu de sortie rapide
		local fading = anim.Fading
		if fading then
			fading.T += dt
			fading.W -= dt / 0.35
			if fading.W <= 0 or fading.T >= fading.Clip.Duration then
				anim.Fading = nil
			else
				fading.Clip.Apply(pose, fading.T, fading.Clip.Duration, fading.W, anim)
			end
		end
	end
	-- transition d'assise : on part de la pose debout, on se penche en avant en descendant
	if anim.Phase == "sit" then
		local a = anim.PhaseT / SIT_TIME
		local e = smooth(a)
		add(pose, "Waist", CFrame.Angles(rad(-20 * math.sin(math.pi * clamp01(a))), 0, 0), 1)
		reach(pose, "R", Vector3.new(0.9, -0.9, -0.5), Vector3.new(1, -0.5, 0.5), 0.35 * math.sin(math.pi * clamp01(a)))
		reach(pose, "L", Vector3.new(-0.9, -0.9, -0.5), Vector3.new(-1, -0.5, 0.5), 0.35 * math.sin(math.pi * clamp01(a)))
		-- racine : de la position debout vers le siège
		local root = rig.Joints.Root
		local standCF: CFrame? = anim.StandCF
		if standCF and not anim.RootStart then
			local rel = rig.Root.CFrame:Inverse() * standCF
			anim.RootStart = root.C0:Inverse() * rel * root.C0 * (anim.Start.Root or IDENTITY)
		end
		for key, joint in pairs(rig.Joints) do
			local from = (key == "Root" and anim.RootStart) or anim.Start[key]
			local target = pose.Work[key]
			local value = (from and e < 1) and from:Lerp(target, e) or target
			joint.Motor.Transform = value
			joint.Written = value
		end
		if a >= 1 then
			anim.Phase = "seated"
			anim.PhaseT = 0
		end
		updateProps(anim)
		return true
	end
	-- (en pause complète, rien à écrire : l'Animator garde la main)
	local idle = w <= 0 and anim.Fading == nil
	for _, joint in pairs(rig.Joints) do
		if idle then
			joint.Written = nil
		end
	end
	if not idle then
		for key, joint in pairs(rig.Joints) do
			local value = pose.Work[key]
			joint.Motor.Transform = value
			joint.Written = value
		end
	end
	updateProps(anim)
	return true
end

----------------------------------------------------------------------
-- Boucle
----------------------------------------------------------------------

local function localCharacter(): (Model?, Humanoid?, BasePart?)
	local player = Players.LocalPlayer
	local character = player and player.Character
	if not character then
		return nil, nil, nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	return character, humanoid, (root and root:IsA("BasePart")) and root or nil
end

-- (v9.9 PARK99) les sièges des jeux du parc (balançoire, tape-cul, tourniquet,
-- jeux à ressort : attribut ParkPose) sont animés par ParkPlay seul
local function isSittable(seat: Instance?): boolean
	return seat ~= nil and seat:IsA("Seat") and seat:GetAttribute("ParkPose") ~= true
end

----------------------------------------------------------------------
-- (v9.9 REALISM99) Assis : plus AUCUNE invite "S'asseoir"
-- Tant que l'avatar local est sur un siège (Humanoid.SeatPart), toutes les
-- invites de type "s'asseoir / s'allonger / monter" (sièges des maisons,
-- bancs, jeux du parc, sièges du jardin, manèges) sont cachées ; elles
-- reviennent quand il se lève. On NE touche PAS à Enabled (d'autres modules
-- s'en servent : mode édition, manèges, voitures) : on met leur portée
-- (MaxActivationDistance) à 0 et on remet la valeur d'origine ensuite.
-- Reconnues : nom (SitPrompt, ParkPrompt, SeatPrompt, BenchPrompt,
-- GardenSeatPrompt), attribut SitPrompt = true (convention pour les
-- nouveaux sièges), invite de manège (FairPrompt + RideId), ou texte
-- "S'asseoir" / "S'allonger".
----------------------------------------------------------------------

local SIT_PROMPT_NAMES: { [string]: boolean } = {
	SitPrompt = true,
	ParkPrompt = true,
	SeatPrompt = true,
	BenchPrompt = true,
	GardenSeatPrompt = true,
}
local PROMPT_EVERY = 0.2 -- (s) nouvelles invites apparues pendant qu'on est assis
local knownPrompts: { [ProximityPrompt]: boolean } = setmetatable({} :: any, { __mode = "k" })
local hiddenPrompts: { [ProximityPrompt]: number } = {} -- invite -> portée d'origine
local promptsHidden = false
local promptClock = 0
local promptConn: RBXScriptConnection? = nil
local sitTexts: { [string]: boolean }? = nil

local function isSitPrompt(prompt: ProximityPrompt): boolean
	if SIT_PROMPT_NAMES[prompt.Name] or prompt:GetAttribute("SitPrompt") == true then
		return true
	end
	if prompt.Name == "FairPrompt" and prompt:GetAttribute("RideId") ~= nil then
		return true
	end
	if not sitTexts then
		local texts: { [string]: boolean } = { ["Sit"] = true, ["Lie down"] = true, ["S'asseoir"] = true, ["S'allonger"] = true }
		pcall(function()
			texts[Locale.T("Sit")] = true
			texts[Locale.T("Lie down")] = true
		end)
		sitTexts = texts
	end
	return (sitTexts :: { [string]: boolean })[prompt.ActionText] == true
end

local function notePrompt(d: Instance)
	if d:IsA("ProximityPrompt") then
		knownPrompts[d] = true
	end
end

local function hidePrompts()
	for prompt in pairs(knownPrompts) do
		if prompt.Parent == nil then
			knownPrompts[prompt] = nil
		elseif hiddenPrompts[prompt] == nil and isSitPrompt(prompt) then
			local distance = prompt.MaxActivationDistance
			if distance > 0 then
				hiddenPrompts[prompt] = distance
				prompt.MaxActivationDistance = 0
			end
		end
	end
end

local function showPrompts()
	for prompt, distance in pairs(hiddenPrompts) do
		-- (quelqu'un d'autre a changé la portée entre-temps : on la lui laisse)
		if prompt.Parent and prompt.MaxActivationDistance == 0 then
			prompt.MaxActivationDistance = distance
		end
	end
	table.clear(hiddenPrompts)
end

-- Appelé à chaque image : assis -> invites cachées ; debout -> remises
local function stepPrompts(dt: number, seated: boolean)
	if seated then
		promptClock -= dt
		if not promptsHidden or promptClock <= 0 then
			promptsHidden = true
			promptClock = PROMPT_EVERY
			hidePrompts()
		end
	elseif promptsHidden then
		promptsHidden = false
		showPrompts()
	end
end

local function startPrompts()
	if promptConn then
		return
	end
	for _, d in ipairs(workspace:GetDescendants()) do
		notePrompt(d)
	end
	promptConn = workspace.DescendantAdded:Connect(notePrompt)
end

local function stopPrompts()
	if promptConn then
		promptConn:Disconnect()
		promptConn = nil
	end
	promptsHidden = false
	pcall(showPrompts)
	table.clear(knownPrompts)
end

-- (tests) les invites cachées (assis)
function SitAnimator.HiddenPrompts(): { [ProximityPrompt]: number }
	return hiddenPrompts
end

-- Autres joueurs assis près de nous (et fin de ceux qui sont partis)
local function scanRemote()
	local _, _, myRoot = localCharacter()
	local center = myRoot and myRoot.Position
	local count = 0
	for _, anim in pairs(anims) do
		if not anim.Local then
			count += 1
		end
	end
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= Players.LocalPlayer then
			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if character and humanoid and root and root:IsA("BasePart") then
				local anim = anims[character]
				local near = center ~= nil and (root.Position - center).Magnitude <= REMOTE_RADIUS
				local seat = humanoid.SeatPart
				if anim then
					if not near and anim.Phase ~= "stand" then
						removeAnim(anim)
						count -= 1
					end
				elseif near and isSittable(seat) and count < REMOTE_MAX and humanoid.Health > 0 then
					beginSit(character, humanoid, seat :: BasePart, false, player)
					local created = anims[character]
					if created then
						-- (chez nous : ni glissé depuis la position debout, ni long fondu)
						created.StandCF = nil
						created.Phase = "sit"
						count += 1
					end
				end
			end
		end
	end
end

local function step(dt: number)
	if not started then
		return
	end
	-- (v9.9) invites "S'asseoir" cachées tant qu'on est assis (même si
	-- l'animation s'est coupée sur une erreur)
	pcall(function()
		local _, humanoid = localCharacter()
		stepPrompts(dt, humanoid ~= nil and humanoid.SeatPart ~= nil and humanoid.Health > 0)
	end)
	if failed then
		return
	end
	local ok, err = pcall(function()
		local character, humanoid, root = localCharacter()
		if character and humanoid and root then
			local anim = anims[character]
			local seat = humanoid.SeatPart
			if not anim and isSittable(seat) and humanoid.Health > 0 then
				beginSit(character, humanoid, seat :: BasePart, true, Players.LocalPlayer)
			elseif not seat and not anim then
				-- debout : pose et position retenues pour la prochaine assise
				lastStand = root.CFrame
				for key, spec in pairs(humanoid.RigType == Enum.HumanoidRigType.R6 and R6_JOINTS or R15_JOINTS) do
					local part = character:FindFirstChild(spec[1])
					local motor = part and part:FindFirstChild(spec[2])
					if motor and motor:IsA("Motor6D") then
						lastStandT[key] = motor.Transform
					end
				end
			end
		end
		scanClock -= dt
		if scanClock <= 0 then
			scanClock = SCAN_INTERVAL
			scanRemote()
		end
		for _, anim in pairs(anims) do
			stepAnim(anim, dt)
		end
		stepChairs(dt)
	end)
	if not ok then
		failed = true
		warn("[SitAnimator] " .. tostring(err))
		for _, anim in pairs(anims) do
			pcall(removeAnim, anim)
		end
		table.clear(anims)
		pcall(restoreChairs)
	end
end

----------------------------------------------------------------------
-- API
----------------------------------------------------------------------

-- Invite "S'asseoir" : tirer la chaise, s'avancer, puis sit(cf, kind)
function SitAnimator.Approach(model: Model?, seatPart: BasePart, sit: (cf: CFrame, kind: string) -> ())
	local cf = seatPart.CFrame * CFrame.new(0, seatPart.Size.Y / 2, 0)
	local kind = SitAnimator.KindOf(model, seatPart)
	local character, humanoid, root = localCharacter()
	if not started or failed or not character or not humanoid or not root or humanoid.SeatPart ~= nil or not model then
		sit(cf, kind)
		return
	end
	if pending and now() - pending.At < APPROACH_MAX + SEAT_WAIT then
		return -- (déjà en route vers une chaise)
	end
	local chair: Chair? = nil
	local ok = pcall(function()
		chair = chairFor(model, seatPart, kind)
	end)
	if not ok then
		chair = nil
	end
	local look = seatPart.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	flat = flat.Magnitude > 0.05 and flat.Unit or Vector3.new(0, 0, -1)
	local pull = 0
	if chair then
		pull = freePull(chair, seatPart, PULL[kind] or 0, { model, character })
		if pull > 0.15 then
			chair.Hold = true
			table.clear(chair.Steps)
			chairTo(chair, pull, PULL_TIME, 0)
		else
			pull = 0
		end
	end
	local info = { Model = model, SeatPart = seatPart, CF = cf, Kind = kind, Chair = chair, At = now() }
	pending = info
	task.spawn(function()
		-- s'avancer devant l'assise (chaise tirée) : quelques pas au plus
		-- (devant l'assise de la chaise tirée ; la chaise recule vers -flat)
		local front = cf.Position - flat * pull + flat * (math.max(seatPart.Size.Z, 0.6) / 2 + 0.55)
		local target = Vector3.new(front.X, root.Position.Y, front.Z)
		local distance = (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(target.X, 0, target.Z)).Magnitude
		local cancelled = false
		if kind ~= "desk" and kind ~= "bed" and distance > 1.2 and distance < 12 then
			pcall(function()
				humanoid:MoveTo(target)
			end)
			local speed = math.max(8, humanoid.WalkSpeed)
			local limit = math.min(APPROACH_MAX, distance / speed + 0.4)
			local t0 = now()
			task.wait(0.05)
			while now() - t0 < limit do
				if pending ~= info or not started then
					cancelled = true
					break
				end
				if humanoid.Health <= 0 or not root.Parent or humanoid.Jump then
					cancelled = true
					break
				end
				if moveMagnitude(nil) > MOVE_THRESHOLD then
					cancelled = true
					break
				end
				local flatPos = Vector3.new(root.Position.X, 0, root.Position.Z)
				if (flatPos - Vector3.new(target.X, 0, target.Z)).Magnitude < 0.8 then
					break
				end
				task.wait(0.05)
			end
		elseif chair and pull > 0 then
			task.wait(PULL_TIME * 0.7)
		end
		if cancelled or pending ~= info or not started then
			if pending == info then
				pending = nil
			end
			if chair and chairs[chair.Key] == chair then
				chair.Hold = false
				chairTo(chair, 0, TUCK_TIME, 0)
			end
			return
		end
		sit(cf, kind)
		-- le serveur a refusé (trop loin…) : on range la chaise
		task.delay(SEAT_WAIT, function()
			if pending == info then
				pending = nil
				if chair and chairs[chair.Key] == chair and chair.Hold then
					chair.Hold = false
					chairTo(chair, 0, TUCK_TIME, 0)
				end
			end
		end)
	end)
end

local function onDeskChanged(active: any)
	if active == true then
		return
	end
	-- sortie du mode bureau encore assis : on recompte
	for _, anim in pairs(anims) do
		if anim.Local then
			resetIdle(anim)
		end
	end
end

function SitAnimator.Start()
	if started then
		return
	end
	started = true
	failed = false
	scanClock = 0
	pcall(startPrompts)
	table.insert(connections, RunService.Stepped:Connect(function(_time: number, dt: number)
		step(dt)
	end))
	local d = desk()
	if d and type(d.Changed) == "table" and deskConnection == nil then
		pcall(function()
			deskConnection = d.Changed:Connect(onDeskChanged)
		end)
	end
	local player = Players.LocalPlayer
	if player then
		table.insert(connections, player.CharacterRemoving:Connect(function(character: Model)
			local anim = anims[character]
			if anim then
				removeAnim(anim)
			end
			lastStand = nil
			table.clear(lastStandT)
			pending = nil
		end))
	end
end

function SitAnimator.Stop()
	if not started then
		return
	end
	started = false
	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	table.clear(connections)
	stopPrompts()
	if deskConnection then
		pcall(function()
			(deskConnection :: any):Disconnect()
		end)
		deskConnection = nil
	end
	for _, anim in pairs(anims) do
		pcall(removeAnim, anim)
	end
	table.clear(anims)
	pcall(restoreChairs)
	pending = nil
	lastStand = nil
	table.clear(lastStandT)
	if propsFolder then
		propsFolder:Destroy()
		propsFolder = nil
	end
end

-- (tests) état interne
function SitAnimator.Debug(): any
	return {
		Started = started,
		Failed = failed,
		Anims = anims,
		Chairs = chairs,
		Pending = function()
			return pending
		end,
		Step = step,
		Clips = CLIPS,
		Program = PROGRAM,
		KindFromId = kindFromId,
		Force = function(character: Model, clipName: string, elapsed: number?)
			-- (tests) impose une animation d'attente à un personnage assis
			local anim = anims[character]
			local clip = CLIPS[clipName]
			if anim and clip then
				anim.Phase = "seated"
				local e = elapsed or 0
				local nowElapsed = math.max(0, serverNow() - anim.SitAt)
				anim.Sched.Clip = clip
				anim.Sched.Start = nowElapsed - e
				anim.Sched.Stop = anim.Sched.Start + clip.Duration
			end
		end,
	}
end

return SitAnimator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="226">
          <Properties>
            <string name="Name">StimulusScreen</string>
            <string name="Source"><![CDATA[--[[
	StimulusScreen (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > StimulusScreen

	v9.8 🖥️ Les écrans 3D des objets "Dopamine Setup" montrent le VRAI
	contenu du clicker : le module stimulus du clicker (Client > Stimuli) est
	lancé DANS la toile SurfaceGui de l'écran, avec un "ctx" bac à sable :
	  - "Runner" : Stimuli.Runner (même course, mêmes dessins, même animation) ;
	    le cadre "téléphone" déborde de la toile (on ne voit que l'image) ;
	  - "Live"   : Stimuli.LiveStream (la streameuse, le chat, les réactions),
	    centré, avec un fond de page de streaming sur les côtés ;
	  - "DVD"    : Stimuli.DVD (les logos du clicker, mêmes positions que
	    l'écran du clicker : même calcul DVDMath à l'heure du serveur) sur
	    un fond de télé ;
	  - "News"   : plateau du flash info (LiveScreens) + le VRAI bandeau
	    Stimuli.NewsTicker en bas (et ses "ALERTE INFO" par-dessus).
	Bac à sable : AUCUN appel serveur (Interact, ClaimSpawn, Net -> muets),
	AUCUN son (ctx.Sound muet), AUCUN effet partagé (ctx.Effects / FloatText
	muets : les réserves de cadres d'Effects sont communes avec le clicker),
	pas d'apparitions (dons, bonus). La toile est inerte (SurfaceGui.Active =
	false, posée par LiveProps) : on regarde, on ne clique pas dedans.
	Le rendu est piloté par LiveProps (Step(dt), ≤ 30 images / s, seulement
	les écrans proches : voir LiveProps.REAL_MAX / REAL_DISTANCE).

	API :
	  StimulusScreen.Supports(kind) -> boolean
	  StimulusScreen.Canvas(kind, aspect) -> Vector2        (taille de toile conseillée)
	  StimulusScreen.New(kind, gui, canvas) -> Screen?      (nil : module absent / erreur)
	  screen:Step(dt)   screen:Destroy()   screen.Failed (erreur pendant le rendu)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LiveScreens = require(script.Parent.LiveScreens)

local StimulusScreen = {}

local Client = script.Parent.Parent

local rgb = Color3.fromRGB

export type Screen = {
	Kind: string,
	Root: Frame,
	Real: boolean,
	Failed: boolean,
	Step: (self: Screen, dt: number) -> (),
	Destroy: (self: Screen) -> (),
}

----------------------------------------------------------------------
-- Modules du client (chargés à la demande, jamais bloquants)
----------------------------------------------------------------------

local cache: { [string]: any } = {}
local function lazy(key: string, loader: () -> any): any
	local cached = cache[key]
	if cached ~= nil then
		return cached or nil
	end
	local ok, result = pcall(loader)
	cache[key] = (ok and result) or false
	return cache[key] or nil
end

local function clientModule(name: string): any
	return lazy(name, function()
		local module = Client:FindFirstChild(name)
		return module and module:IsA("ModuleScript") and require(module) :: any or nil
	end)
end

local function sharedModule(name: string): any
	return lazy("Shared." .. name, function()
		local module = ReplicatedStorage.Shared:FindFirstChild(name)
		return module and module:IsA("ModuleScript") and require(module) :: any or nil
	end)
end

local function stimulus(name: string): any
	return lazy("Stimuli." .. name, function()
		local folder = Client:FindFirstChild("Stimuli")
		local module = folder and folder:FindFirstChild(name)
		if module and module:IsA("ModuleScript") then
			local loaded = require(module) :: any
			if type(loaded) == "table" and type(loaded.Start) == "function" then
				return loaded
			end
		end
		return nil
	end)
end

----------------------------------------------------------------------
-- Bac à sable : son, réseau et effets plein écran muets
----------------------------------------------------------------------

local function noop(...: any): any
	return nil
end

-- Son muet : toute fonction appelée ne fait rien (jamais de son en plus)
local SILENT = setmetatable({}, {
	__index = function()
		return noop
	end,
})

-- Réseau muet : les écrans 3D n'envoient RIEN au serveur (pas de DVDResize,
-- DVDCorner, Interact...) : l'écran du clicker reste la seule source
local DEAD_REMOTE = {
	FireServer = noop,
	InvokeServer = noop,
	OnClientEvent = { Connect = function()
		return { Connected = false, Disconnect = noop }
	end },
}
local FAKE_NET = setmetatable({
	Event = function()
		return DEAD_REMOTE
	end,
	Function = function()
		return DEAD_REMOTE
	end,
}, {
	__index = function()
		return noop
	end,
})

-- Effets : AUCUN effet partagé du clicker (Effects garde des réserves de
-- cadres réutilisés : un cadre détruit avec un écran 3D ferait planter les
-- effets du clicker ensuite, "Parent property locked") -> muets ici
local SAFE_EFFECTS = setmetatable({}, {
	__index = function()
		return noop
	end,
})

local DEAD_CONNECTION = { Connected = false, Disconnect = noop }

type Sandbox = { Ctx: any, Renders: { (dt: number) -> () }, Connections: { any }, Alive: boolean }

local function sandbox(feature: string, module: any, container: Frame, overlay: Frame, design: Vector2): Sandbox
	local ClientState = clientModule("ClientState")
	local box: Sandbox = { Ctx = nil, Renders = {}, Connections = {}, Alive = true }
	local ctx: { [string]: any } = {}
	ctx.Feature = feature
	ctx.Slot = module.Slot
	ctx.Container = container
	ctx.Overlay = overlay
	ctx.State = ClientState
	ctx.Config = sharedModule("Config")
	ctx.Formulas = sharedModule("Formulas")
	ctx.Format = sharedModule("NumberFormatter")
	ctx.DVDMath = sharedModule("DVDMath")
	ctx.Net = FAKE_NET
	ctx.Theme = clientModule("Theme")
	ctx.UIUtil = clientModule("UIUtil")
	ctx.Effects = SAFE_EFFECTS
	ctx.Sound = SILENT
	ctx.Random = Random.new()
	ctx.World3D = true -- (un stimulus peut savoir qu'il est sur un écran 3D)
	function ctx.IsAlive(): boolean
		return box.Alive
	end
	function ctx.GetSlotScale(): number
		return 1
	end
	function ctx.GetSlotSize(): Vector2
		return design
	end
	ctx.Notify = noop
	ctx.FloatText = noop
	function ctx.GetLevel(upgradeId: string): number
		local ok, value = pcall(ClientState.GetLevel, upgradeId)
		return ok and tonumber(value) or 0
	end
	function ctx.HasFeature(name: string): boolean
		local ok, value = pcall(ClientState.HasFeature, name)
		return ok and value == true
	end
	function ctx.EffectsEnabled(): boolean
		local data = ClientState and ClientState.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end
	ctx.ClaimSpawn = noop
	ctx.Interact = noop
	function ctx.Connect(signal: any, callback: (...any) -> ()): any
		if not box.Alive or signal == nil then
			return DEAD_CONNECTION
		end
		local connection = signal:Connect(function(...)
			if box.Alive then
				callback(...)
			end
		end)
		table.insert(box.Connections, connection)
		return connection
	end
	function ctx.OnRender(callback: (dt: number) -> ()): any
		if not box.Alive then
			return DEAD_CONNECTION
		end
		table.insert(box.Renders, callback)
		local connection = { Connected = true }
		function connection.Disconnect(self: any)
			local index = table.find(box.Renders, callback)
			if index then
				table.remove(box.Renders, index)
			end
			if type(self) == "table" then
				self.Connected = false
			end
		end
		return connection
	end
	function ctx.GetVisibility(): string
		return box.Alive and "Visible" or "Hidden"
	end
	function ctx.IsVisible(): boolean
		return box.Alive
	end
	function ctx.OnVisibilityChanged(_callback: any): any
		return DEAD_CONNECTION
	end
	function ctx.OnSpawn(_kind: string, _callback: any): any
		return DEAD_CONNECTION -- (dons, étoiles... : seulement dans le clicker)
	end
	function ctx.OnBonus(_source: string, _callback: any): any
		return DEAD_CONNECTION
	end
	ctx.SetDarkMode = noop
	box.Ctx = ctx
	return box
end

local function killSandbox(box: Sandbox, module: any)
	if not box.Alive then
		return
	end
	box.Alive = false
	for _, connection in ipairs(box.Connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	table.clear(box.Connections)
	table.clear(box.Renders)
	if type(module.Stop) == "function" then
		pcall(module.Stop, box.Ctx)
	end
end

----------------------------------------------------------------------
-- Cadres
----------------------------------------------------------------------

local function frame(parent: Instance, name: string, position: UDim2, size: UDim2, color: Color3, z: number?, transparency: number?): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.BorderSizePixel = 0
	f.Position = position
	f.Size = size
	f.BackgroundColor3 = color
	f.BackgroundTransparency = transparency or 0
	f.ZIndex = z or 1
	f.Parent = parent
	return f
end

local function gradient(parent: GuiObject, a: Color3, b: Color3, rotation: number)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(a, b)
	g.Rotation = rotation
	g.Parent = parent
end

----------------------------------------------------------------------
-- Tailles
----------------------------------------------------------------------

local RUNNER_H = 200 -- hauteur "design" du coureur (le slot du clicker fait 190)
local RUNNER_MARGIN = 6 -- liseré + cadre "téléphone" du stimulus, hors toile
local LIVE_W, LIVE_H = 384, 268 -- slot L3 du clicker
local DVD_W = 900 -- (écran "design" plus petit que celui du clicker : logos de 150 x 80 bien visibles)
local TICKER_H = 30 -- slot Ticker

local SUPPORTED = { Runner = "Runner", Live = "LiveStream", DVD = "DVD", News = "NewsTicker" }

function StimulusScreen.Supports(kind: string): boolean
	local name = SUPPORTED[kind]
	return name ~= nil and stimulus(name) ~= nil
end

function StimulusScreen.Canvas(kind: string, aspect: number): Vector2
	local a = math.clamp(aspect, 0.3, 4)
	if kind == "Runner" then
		return Vector2.new(math.floor(RUNNER_H * a + 0.5), RUNNER_H)
	elseif kind == "Live" then
		if a >= LIVE_W / LIVE_H then
			return Vector2.new(math.floor(LIVE_H * a + 0.5), LIVE_H)
		end
		return Vector2.new(LIVE_W, math.floor(LIVE_W / a + 0.5))
	elseif kind == "DVD" then
		return Vector2.new(560, math.floor(560 / a + 0.5))
	end
	return Vector2.new(360, math.floor(360 / a + 0.5))
end

-- Lance le stimulus `name` dans `container` ; renvoie son bac à sable
local function launch(name: string, container: Frame, overlay: Frame, design: Vector2): (Sandbox?, any)
	local module = stimulus(name)
	if not module then
		return nil, nil
	end
	local box = sandbox(name, module, container, overlay, design)
	local ok, err = pcall(module.Start, box.Ctx)
	if not ok then
		warn("[StimulusScreen] " .. name .. ".Start : " .. tostring(err))
		killSandbox(box, module)
		return nil, nil
	end
	return box, module
end

----------------------------------------------------------------------
-- Construction d'un écran
----------------------------------------------------------------------

function StimulusScreen.New(kind: string, gui: SurfaceGui, canvas: Vector2): Screen?
	local name = SUPPORTED[kind]
	if not name or not stimulus(name) then
		return nil
	end
	local W, H = canvas.X, canvas.Y
	local root = frame(gui, "Stimulus_" .. kind, UDim2.fromOffset(0, 0), UDim2.fromOffset(W, H), rgb(8, 8, 16))
	root.ClipsDescendants = true
	local light: LiveScreens.Screen? = nil
	local box: Sandbox?, module: any = nil, nil

	if kind == "Runner" then
		-- le coureur remplit la toile ; son cadre de "téléphone" déborde (coupé)
		local design = Vector2.new(W + RUNNER_MARGIN * 2, H + RUNNER_MARGIN * 2)
		local container = frame(root, "Container", UDim2.fromOffset(-RUNNER_MARGIN, -RUNNER_MARGIN), UDim2.fromOffset(design.X, design.Y), rgb(0, 0, 0), 2, 1)
		box, module = launch(name, container, container, design)
	elseif kind == "Live" then
		-- page de streaming : fond + halo, le live du clicker au centre
		gradient(root, rgb(34, 20, 58), rgb(12, 8, 24), 90)
		local scale = math.min(W / LIVE_W, H / LIVE_H)
		local cw, ch = LIVE_W * scale, LIVE_H * scale
		local halo = frame(root, "Halo", UDim2.fromOffset((W - cw) / 2 - 6, (H - ch) / 2 - 6), UDim2.fromOffset(cw + 12, ch + 12), rgb(170, 90, 255), 1, 0.7)
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 18)
		corner.Parent = halo
		if W - cw > 40 then
			-- bords : pastilles "EN DIRECT" et cœurs qui rappellent l'appli
			for _, side in ipairs({ 0, 1 }) do
				local x = side == 0 and 6 or (W + cw) / 2 + 6
				local w = (W - cw) / 2 - 12
				local stack = frame(root, "Side", UDim2.fromOffset(x, 10), UDim2.fromOffset(w, H - 20), rgb(255, 255, 255), 1, 0.94)
				local stackCorner = Instance.new("UICorner")
				stackCorner.CornerRadius = UDim.new(0, 8)
				stackCorner.Parent = stack
				for k = 0, 3 do
					local dot = frame(stack, "Dot", UDim2.new(0.5, -math.min(8, w / 3), 0, 10 + k * 28), UDim2.fromOffset(math.min(16, w / 1.5), math.min(16, w / 1.5)),
						k == 0 and rgb(236, 50, 80) or rgb(190, 150, 255), 2, k == 0 and 0 or 0.5)
					local dotCorner = Instance.new("UICorner")
					dotCorner.CornerRadius = UDim.new(1, 0)
					dotCorner.Parent = dot
				end
			end
		end
		local holder = frame(root, "Holder", UDim2.fromOffset((W - cw) / 2, (H - ch) / 2), UDim2.fromOffset(LIVE_W, LIVE_H), rgb(0, 0, 0), 2, 1)
		local uiScale = Instance.new("UIScale")
		uiScale.Scale = scale
		uiScale.Parent = holder
		box, module = launch(name, holder, holder, Vector2.new(LIVE_W, LIVE_H))
	elseif kind == "DVD" then
		-- fond de télé (le DVD du clicker est posé sur le fond de l'appli)
		gradient(root, rgb(18, 16, 40), rgb(4, 4, 12), 90)
		local vignette = frame(root, "Vignette", UDim2.fromOffset(0, 0), UDim2.fromScale(1, 1), rgb(0, 0, 0), 2, 0.4)
		local vg = Instance.new("UIGradient")
		vg.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.3),
			NumberSequenceKeypoint.new(0.5, 1),
			NumberSequenceKeypoint.new(1, 0.3),
		})
		vg.Parent = vignette
		local scale = W / DVD_W
		local design = Vector2.new(DVD_W, math.floor(H / scale + 0.5))
		local holder = frame(root, "Holder", UDim2.fromOffset(0, 0), UDim2.fromOffset(design.X, design.Y), rgb(0, 0, 0), 3, 1)
		local uiScale = Instance.new("UIScale")
		uiScale.Scale = scale
		uiScale.Parent = holder
		box, module = launch(name, holder, holder, design)
	elseif kind == "News" then
		-- plateau du flash info (dessiné) + vrai bandeau du clicker
		local ok, screen = pcall(LiveScreens.New, "News", gui, canvas)
		if ok and screen then
			light = screen
			screen.Root.Parent = root
			screen.Root.ZIndex = 1
		end
		local barH = math.floor(H * 0.14 + 0.5)
		local scale = barH / TICKER_H
		local design = Vector2.new(math.floor(W / scale + 0.5), TICKER_H)
		local bar = frame(root, "Ticker", UDim2.fromOffset(0, H - barH), UDim2.fromOffset(design.X, TICKER_H), rgb(20, 16, 34), 20)
		local barScale = Instance.new("UIScale")
		barScale.Scale = scale
		barScale.Parent = bar
		-- "ALERTE INFO" : calque de toute la toile (même échelle que le bandeau)
		local overlay = frame(root, "Overlay", UDim2.fromOffset(0, 0), UDim2.fromOffset(design.X, math.floor(H / scale + 0.5)), rgb(0, 0, 0), 30, 1)
		local overlayScale = Instance.new("UIScale")
		overlayScale.Scale = scale
		overlayScale.Parent = overlay
		box, module = launch(name, bar, overlay, design)
	end

	if not box then
		if light then
			pcall(light.Destroy, light)
		end
		root:Destroy()
		return nil
	end
	local sandboxRef: Sandbox = box
	local screen = {} :: Screen
	screen.Kind = kind
	screen.Root = root
	screen.Real = true
	screen.Failed = false
	function screen.Step(self: Screen, dt: number)
		if self.Failed then
			return
		end
		if light then
			light:Step(dt)
		end
		for _, callback in ipairs(sandboxRef.Renders) do
			local ok, err = pcall(callback, dt)
			if not ok then
				warn("[StimulusScreen] " .. tostring(name) .. " : " .. tostring(err))
				self.Failed = true
				return
			end
		end
	end
	function screen.Destroy(_self: Screen)
		killSandbox(sandboxRef, module)
		if light then
			pcall(light.Destroy, light)
		end
		root:Destroy()
	end
	return screen
end

return StimulusScreen
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="227">
          <Properties>
            <string name="Name">TownArrival</string>
            <string name="Source"><![CDATA[--[[
	TownArrival (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > TownArrival

	🎬 Dopamine Town : l'arrivée.
	  - Intro(...) : court survol de la ville par la caméra (~4,2 s, 1re
	    arrivée de la session seulement, passable) : on part haut au-dessus
	    de la ville, on tourne autour de la place en descendant, et on finit
	    juste DERRIÈRE l'avatar, à la porte de la ville, regard vers la place.
	    Caméra Scriptable pendant le survol, rendue à Roblox (Custom) à la fin.
	  - Guide : (v9.6) plus AUCUNE ligne ni repère à l'écran ; il suit la
	    distance jusqu'à sa porte ; la petite boussole du HUD est calculée
	    ici (Bearing).
	Rien n'est créé par image : le survol ne fait que des calculs de CFrame,
	le guide (distance) se met à jour ~4 fois / s.
]]

local RunService = game:GetService("RunService")

local TownArrival = {}

local UP = Vector3.new(0, 1, 0)
local INTRO_TIME = 4.4
local END_BACK, END_UP, END_AHEAD = 14, 7, 26

----------------------------------------------------------------------
-- Chemin du survol
----------------------------------------------------------------------

-- Chemin précalculé (une fois) : points denses + longueurs cumulées
export type Path = {
	Plaza: Vector3,
	Points: { Vector3 },
	Lengths: { number },
	Total: number,
	ApproachAt: number, -- longueur où commence la descente dans l'axe
	EndLook: Vector3,
	EndCFrame: CFrame,
}

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local APPROACH = 80 -- (studs) on arrive dans l'axe de l'avenue, depuis l'extérieur…
local APPROACH_UP = 24 -- … à cette hauteur (sous l'arche du portail : ~22+ au centre)
local ORBIT_TURN = math.rad(140)
local DENSE = 220

local function catmull(p0: Vector3, p1: Vector3, p2: Vector3, p3: Vector3, t: number): Vector3
	local t2, t3 = t * t, t * t * t
	return (p1 * 2 + (p2 - p0) * t + (p0 * 2 - p1 * 5 + p2 * 4 - p3) * t2 + (p1 * 3 - p0 - p2 * 3 + p3) * t3) * 0.5
end

-- entrance : CFrame d'arrivée (pieds), plaza : centre de la place.
-- 1) grand tour haut autour de la place (vue d'ensemble), en se
--    rapprochant ; 2) on se place dans l'axe de l'avenue, DEHORS, et on
--    glisse tout droit en descendant, à travers l'arche du portail,
--    jusque derrière l'avatar (jamais de travers dans les tours).
function TownArrival.MakePath(entrance: CFrame, plaza: Vector3): Path
	local e = entrance.Position
	local toPlaza = flat(plaza - e)
	local forward = toPlaza.Magnitude > 12 and toPlaza.Unit or flat(entrance.LookVector)
	if forward.Magnitude < 0.01 then
		forward = Vector3.new(0, 0, -1)
	end
	forward = forward.Unit
	local camEnd = e - forward * END_BACK + UP * END_UP
	local lookEnd = e + forward * END_AHEAD + UP * 3
	local approach = e - forward * (END_BACK + APPROACH) + UP * APPROACH_UP
	local rel = flat(approach - plaza)
	local radiusA = math.max(rel.Magnitude, 40)
	local angleA = math.atan2(rel.Z, rel.X)
	local startRadius = radiusA * 1.15
	local startHeight = math.max(150, radiusA * 0.45)
	-- points de contrôle
	local control: { Vector3 } = {}
	local steps = 14
	for i = 0, steps do
		local s = i / steps
		local angle = angleA + ORBIT_TURN * (1 - s)
		local radius = startRadius + (radiusA - startRadius) * s
		local height = APPROACH_UP + (startHeight - APPROACH_UP) * (1 - s ^ 2.2)
		table.insert(control, Vector3.new(plaza.X + math.cos(angle) * radius, e.Y + height, plaza.Z + math.sin(angle) * radius))
	end
	local orbitCount = #control
	for i = 1, 6 do
		table.insert(control, approach:Lerp(camEnd, i / 6))
	end
	-- (extrémités prolongées pour la spline)
	local first = control[1] * 2 - control[2]
	local last = control[#control] * 2 - control[#control - 1]
	local points: { Vector3 } = {}
	local segments = #control - 1
	for i = 0, DENSE do
		local f = i / DENSE * segments
		local k = math.min(math.floor(f), segments - 1)
		local t = f - k
		local p0 = k >= 1 and control[k] or first
		local p1 = control[k + 1]
		local p2 = control[k + 2]
		local p3 = control[k + 3] or last
		table.insert(points, catmull(p0, p1, p2, p3, t))
	end
	points[#points] = camEnd
	local lengths: { number } = { 0 }
	local total = 0
	local approachAt = 0
	local approachIndex = math.floor((orbitCount - 1) / segments * DENSE + 0.5) + 1
	for i = 2, #points do
		total += (points[i] - points[i - 1]).Magnitude
		lengths[i] = total
		if i == approachIndex then
			approachAt = total
		end
	end
	return {
		Plaza = plaza,
		Points = points,
		Lengths = lengths,
		Total = math.max(total, 1),
		ApproachAt = approachAt,
		EndLook = lookEnd,
		EndCFrame = CFrame.lookAt(camEnd, lookEnd),
	}
end

local function easeInOut(t: number): number
	return 0.5 - 0.5 * math.cos(math.pi * math.clamp(t, 0, 1))
end

-- Caméra au temps t (0..1) du survol (vitesse régulière le long du chemin)
function TownArrival.CameraAt(path: Path, t: number): CFrame
	if t >= 1 then
		return path.EndCFrame
	end
	local target = easeInOut(t) * path.Total
	local lengths, points = path.Lengths, path.Points
	-- recherche dichotomique du segment
	local lo, hi = 1, #lengths
	while hi - lo > 1 do
		local mid = (lo + hi) // 2
		if lengths[mid] <= target then
			lo = mid
		else
			hi = mid
		end
	end
	local span = lengths[hi] - lengths[lo]
	local f = span > 0 and (target - lengths[lo]) / span or 0
	local position = points[lo]:Lerp(points[hi], f)
	-- regard : la place, puis (dans l'axe) le bout de l'avenue devant l'avatar
	local blend = 0
	if target > path.ApproachAt then
		blend = easeInOut((target - path.ApproachAt) / math.max(1, path.Total - path.ApproachAt))
	end
	local look = path.Plaza:Lerp(path.EndLook, blend)
	return CFrame.lookAt(position, look)
end

----------------------------------------------------------------------
-- Survol (intro)
----------------------------------------------------------------------

export type Intro = {
	Skip: (self: Intro) -> (),
	Cancel: (self: Intro) -> (),
	IsRunning: (self: Intro) -> boolean,
	Elapsed: number,
}

-- options : Camera, Path, Duration?, OnProgress?(t), OnDone(skipped: boolean)
function TownArrival.Intro(options: any): any
	local camera: Camera = options.Camera
	local path: Path = options.Path
	local duration = options.Duration or INTRO_TIME
	local intro = { Elapsed = 0, Running = true }
	local connection: RBXScriptConnection? = nil
	local previousFov = camera.FieldOfView

	local function finish(skipped: boolean, handBack: boolean)
		if not intro.Running then
			return
		end
		intro.Running = false
		if connection then
			connection:Disconnect()
			connection = nil
		end
		pcall(function()
			camera.FieldOfView = previousFov
		end)
		if handBack then
			pcall(function()
				camera.CFrame = path.EndCFrame
			end)
		end
		local done = options.OnDone
		if done then
			local ok, err = pcall(done, skipped)
			if not ok then
				warn("[TownArrival] " .. tostring(err))
			end
		end
	end

	function intro.Skip(_self: any)
		finish(true, true)
	end
	function intro.Cancel(_self: any)
		-- (sortie de la ville pendant le survol : on ne touche plus à la caméra)
		intro.Running = false
		if connection then
			connection:Disconnect()
			connection = nil
		end
	end
	function intro.IsRunning(_self: any): boolean
		return intro.Running
	end

	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = 62
	camera.CFrame = TownArrival.CameraAt(path, 0)
	connection = RunService.RenderStepped:Connect(function(dt: number)
		if not intro.Running then
			return
		end
		intro.Elapsed += dt
		local t = intro.Elapsed / duration
		camera.CFrame = TownArrival.CameraAt(path, t)
		-- (le champ de vision se resserre un peu à la fin : effet "atterrissage")
		camera.FieldOfView = 62 + (previousFov - 62) * easeInOut((t - 0.6) / 0.4)
		local progress = options.OnProgress
		if progress then
			progress(math.clamp(t, 0, 1))
		end
		if t >= 1 then
			finish(false, true)
		end
	end)
	return intro
end

----------------------------------------------------------------------
-- Guide vers sa maison
----------------------------------------------------------------------

local Guide = {}
Guide.__index = Guide

-- v9.6 (FIXES96) : le joueur ne veut PLUS de ligne à l'écran vers sa maison.
-- L'arc lumineux (Beam) et le repère flottant "🏠 Ta maison" (toujours
-- devant, à travers les murs) sont supprimés. Le guide ne fait plus que
-- suivre la distance jusqu'à sa porte (message "voici ta maison" à
-- l'arrivée) ; la petite boussole du HUD et le bouton "🏠 Rentrer" restent.
-- (API inchangée pour TownClient : Start / Attach / Update / Stop /
-- IsActive / Destroy ; plus aucune Instance créée.)
function TownArrival.Guide(_parent: Instance): any
	local self = setmetatable({
		Target = nil :: Vector3?,
		Beam = nil, -- (toujours nil : plus d'arc)
		Active = false,
		Distance = math.huge,
	}, Guide)
	return self
end

function Guide.Build(self: any, target: Vector3)
	self.Target = target
end

function Guide.Start(self: any, character: Model?, target: Vector3)
	self:Build(target)
	self.Active = true
	self.Distance = math.huge
	self:Attach(character)
end

-- (nouveau personnage : rien à rattacher, il n'y a plus d'arc)
function Guide.Attach(_self: any, _character: Model?) end

-- ~4 fois / s : distance (à plat) jusqu'à sa porte
function Guide.Update(self: any, from: Vector3?): number
	local target = self.Target
	if not self.Active or not target or not from then
		return math.huge
	end
	local distance = (flat(target - from)).Magnitude
	self.Distance = distance
	return distance
end

function Guide.Stop(self: any)
	self.Active = false
end

function Guide.IsActive(self: any): boolean
	return self.Active
end

function Guide.Destroy(self: any)
	self:Stop()
	self.Target = nil
end

-- Angle (degrés, 0 = droit devant, + = à droite) de la cible vue de la caméra
function TownArrival.Bearing(camera: Camera, from: Vector3, target: Vector3): number
	local look = flat(camera.CFrame.LookVector)
	local to = flat(target - from)
	if look.Magnitude < 0.01 or to.Magnitude < 0.01 then
		return 0
	end
	look, to = look.Unit, to.Unit
	local cross = look.X * to.Z - look.Z * to.X
	local dot = look:Dot(to)
	return math.deg(math.atan2(cross, dot))
end

return TownArrival
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="228">
          <Properties>
            <string name="Name">TownAtmosphere</string>
            <string name="Source"><![CDATA[--[[
	TownAtmosphere (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > TownAtmosphere

	🌤️ Dopamine Town : ambiance réaliste (côté client, remise EXACTEMENT à
	la sortie).
	  - Lighting : soleil d'après-midi chaud, ombres nettes, lumière
	    ambiante douce, reflets d'environnement (Lighting.Technology n'est
	    pas modifiable par un script : on garde celle du lieu) ;
	  - Atmosphere (brume de distance, halo du soleil), ciel Roblox par
	    défaut (Sky sans textures : soleil, lune, étoiles), nuages (Clouds
	    dans Terrain), ColorCorrection, SunRays, Bloom doux, léger flou de
	    profondeur au loin ;
	  - jour / nuit : suit le réglage ⚙️ "Mode sombre" du joueur (nuit
	    étoilée, lampadaires) ; le jour, lent cycle du soleil (matin ->
	    fin d'après-midi -> matin, 16 min), jamais la nuit par surprise ;
	    passage jour <-> nuit en fondu (~2,5 s) ;
	  - AUCUN son.
	v9.8 (REALISM98) 🌦️ météo + 🎨 réglages "Graphismes / Mode réaliste" :
	  - la météo de Weather3D (cycle commun à tous les joueurs) s'ajoute au
	    jour / nuit : ciel couvert (soleil plus faible, ombres douces, plus
	    de lumière ambiante, nuages Cover / Density / couleur), pluie (brume
	    Atmosphere plus dense, couleurs un peu désaturées, sols qui
	    brillent : EnvironmentSpecularScale), orage (plus sombre, lampadaires
	    allumés), éclairs DOUX : ColorCorrection +0,07 au plus (jamais
	    au-delà de +0,08), nuages éclaircis un instant ;
	  - Graphismes : Effets Off = Bloom / SunRays / flou lointain coupés ;
	    Ombres Low = GlobalShadows coupé ; Mode réaliste = matières un peu
	    plus riches (reflets d'environnement +0,08, ombres un peu plus
	    nettes) ;
	  - démarre / arrête Weather3D (pluie, flaques, sol mouillé) et les
	    miroirs (Reflections.Acquire("Town") / Release).
	v9.9 (REALISM99) 🕐 "Heure du jour" (Graphismes, clé GfxTime, pour CE
	joueur seulement : Lighting est local) :
	  - Auto : comme avant (nuit = réglage ⚙️ "Mode sombre"), mais le lent
	    cycle du soleil suit l'heure du SERVEUR (même soleil pour tous) ;
	  - Jour : plein jour fixe (12 h 50) ; Nuit : nuit étoilée ;
	  - Coucher de soleil : 17 h 50, lumière dorée douce (table SUNSET :
	    Brightness ≤ 1,3, pas d'éblouissement), brume orangée, lampadaires
	    allumés ;
	  - fondus doux (~2,5 s) entre les 4 ; la météo s'ajoute par-dessus ;
	    tout est remis à la sortie (les clés de Lighting sont sauvegardées).
	Travail : Step(dt) : Weather3D.Step, éclairage recalculé 2 fois / s
	(5 fois / s pendant un fondu), l'éclair seul à chaque image.

	API : TownAtmosphere.Apply(saved) / Restore(saved) / Step(dt) /
	      SetNight(on) / IsNight() / Weather() -> état de Weather3D
	      TimeMode() -> "Auto" | "Day" | "Sunset" | "Night" ; Dusk() -> 0..1
	saved = { Lighting = {}, Effects = {}, Moved = {} } (table de TownClient)
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GraphicsQuality = require(ReplicatedStorage.Shared.GraphicsQuality)

-- (v9.8) modules du même dossier, chargés en pcall : la ville marche sans eux
local function optional(name: string): any
	local module = script.Parent:FindFirstChild(name)
	if module and module:IsA("ModuleScript") then
		local ok, result = pcall(require, module)
		if ok and type(result) == "table" then
			return result
		end
		warn("[TownAtmosphere] " .. name .. " : " .. tostring(result))
	end
	return nil
end
local Weather3D = optional("Weather3D")
local Reflections = optional("Reflections")

local TownAtmosphere = {}

local CYCLE_PERIOD = 16 * 60 -- (s) aller-retour du soleil
local DAY_CLOCK, DAY_SWING = 13.4, 3.2 -- 10,2 h .. 16,6 h
local NIGHT_CLOCK = 21.3
local NOON_CLOCK = 12.85 -- (v9.9) "Jour" : plein jour fixe
local SUNSET_CLOCK = 17.85 -- (v9.9) "Coucher de soleil" : soleil bas, doré
local FADE_TIME = 2.5

-- Réglages de Lighting (jour / nuit) : mêmes clés dans les deux
-- v9.6 (FIXES96) "FLASH BANG" en vrai Roblox (Future / ShadowMap) : la v9.4
-- cumulait Brightness 3 + ExposureCompensation positive + ColorShift_Top
-- presque blanc (s'AJOUTE à la lumière du soleil) + reflets d'environnement
-- à 1 (plastique lisse / verre / métal qui éblouissent) + halo Atmosphere
-- (Glare 0.45, Haze 1.4) + Bloom de nuit à seuil bas (0.95 : chaque pièce
-- Neon devenait un phare). Valeurs douces et naturelles (tableau avant /
-- après dans le rapport v9.6) :
local DAY: { [string]: any } = {
	Brightness = 1.8, -- (3)
	Ambient = Color3.fromRGB(72, 70, 80), -- (96, 92, 106) intérieurs moins "cramés"
	OutdoorAmbient = Color3.fromRGB(118, 116, 126), -- (132, 128, 142)
	ColorShift_Top = Color3.fromRGB(46, 38, 30), -- (255, 238, 220) léger ton chaud, plus un 2e soleil
	ColorShift_Bottom = Color3.fromRGB(0, 0, 0), -- (40, 32, 48)
	EnvironmentDiffuseScale = 0.45, -- (1)
	EnvironmentSpecularScale = 0.35, -- (1) plus de reflets aveuglants
	ExposureCompensation = -0.15, -- (+0.15)
	ShadowSoftness = 0.25, -- (0.18)
	FogColor = Color3.fromRGB(206, 214, 228),
}
local NIGHT: { [string]: any } = {
	Brightness = 0.9, -- (1.4)
	Ambient = Color3.fromRGB(40, 40, 58), -- (58, 56, 88)
	OutdoorAmbient = Color3.fromRGB(62, 66, 100), -- (78, 82, 128)
	ColorShift_Top = Color3.fromRGB(22, 26, 46), -- (170, 184, 255)
	ColorShift_Bottom = Color3.fromRGB(0, 0, 0), -- (20, 16, 40)
	EnvironmentDiffuseScale = 0.3, -- (0.7)
	EnvironmentSpecularScale = 0.3, -- (1)
	ExposureCompensation = -0.1, -- (+0.35)
	ShadowSoftness = 0.35, -- (0.3)
	FogColor = Color3.fromRGB(34, 38, 68),
}
-- (v9.9) coucher de soleil : chaud et DOUX (Brightness 1,25 < jour 1,8)
local SUNSET: { [string]: any } = {
	Brightness = 1.25,
	Ambient = Color3.fromRGB(78, 62, 72),
	OutdoorAmbient = Color3.fromRGB(138, 108, 110),
	ColorShift_Top = Color3.fromRGB(72, 42, 20),
	ColorShift_Bottom = Color3.fromRGB(0, 0, 0),
	EnvironmentDiffuseScale = 0.4,
	EnvironmentSpecularScale = 0.33,
	ExposureCompensation = -0.1,
	ShadowSoftness = 0.3,
	FogColor = Color3.fromRGB(232, 176, 150),
}
-- (fixés une fois, sans fondu)
local FIXED: { [string]: any } = {
	GlobalShadows = true,
	GeographicLatitude = 38,
	FogStart = 800,
	FogEnd = 4000,
	ClockTime = DAY_CLOCK,
}

-- Effets : valeurs jour / nuit (v9.6 : halo, bloom et rayons très adoucis)
local EFFECTS = {
	Atmosphere = {
		Class = "Atmosphere",
		-- (Glare 0.45 -> 0.1, Haze 1.4 -> 0.7, Density 0.3 -> 0.26)
		Day = { Density = 0.26, Offset = 0.2, Color = Color3.fromRGB(206, 206, 220), Decay = Color3.fromRGB(106, 112, 134), Glare = 0.1, Haze = 0.7 },
		-- (Haze 1.1 -> 0.6)
		Night = { Density = 0.32, Offset = 0.1, Color = Color3.fromRGB(62, 68, 108), Decay = Color3.fromRGB(30, 28, 62), Glare = 0, Haze = 0.6 },
	},
	ColorCorrection = {
		Class = "ColorCorrectionEffect",
		-- (Brightness 0.01 -> -0.02, Contrast 0.08 -> 0.05)
		Day = { Saturation = 0.06, Contrast = 0.05, Brightness = -0.02, TintColor = Color3.fromRGB(255, 250, 244) },
		-- (Brightness 0.02 -> -0.03)
		Night = { Saturation = 0, Contrast = 0.06, Brightness = -0.03, TintColor = Color3.fromRGB(226, 230, 255) },
	},
	Bloom = {
		Class = "BloomEffect",
		-- (0.35 / 28 / 1.3 -> seules les vraies sources de lumière fleurissent)
		Day = { Intensity = 0.2, Size = 18, Threshold = 1.8 },
		-- (0.8 / 32 / 0.95 = le "flash" de nuit -> 0.3 / 20 / 1.5)
		Night = { Intensity = 0.3, Size = 20, Threshold = 1.5 },
	},
	SunRays = {
		Class = "SunRaysEffect",
		-- (0.07 / 0.55)
		Day = { Intensity = 0.04, Spread = 0.35 },
		Night = { Intensity = 0, Spread = 0.2 },
	},
	DepthOfField = {
		Class = "DepthOfFieldEffect",
		Day = { FarIntensity = 0.12, FocusDistance = 70, InFocusRadius = 90, NearIntensity = 0 },
		Night = { FarIntensity = 0.16, FocusDistance = 60, InFocusRadius = 80, NearIntensity = 0 },
	},
}
-- (v9.9) effets au coucher de soleil (mêmes clés que Day)
local SUNSET_FX: { [string]: { [string]: any } } = {
	Atmosphere = { Density = 0.3, Offset = 0.15, Color = Color3.fromRGB(236, 172, 142), Decay = Color3.fromRGB(138, 88, 112), Glare = 0.22, Haze = 1.0 },
	ColorCorrection = { Saturation = 0.1, Contrast = 0.05, Brightness = -0.02, TintColor = Color3.fromRGB(255, 236, 218) },
	Bloom = { Intensity = 0.22, Size = 20, Threshold = 1.7 },
	SunRays = { Intensity = 0.05, Spread = 0.4 },
	DepthOfField = { FarIntensity = 0.14, FocusDistance = 65, InFocusRadius = 85, NearIntensity = 0 },
}
TownAtmosphere.DAY = DAY
TownAtmosphere.NIGHT = NIGHT
TownAtmosphere.SUNSET = SUNSET
TownAtmosphere.SUNSET_FX = SUNSET_FX
TownAtmosphere.EFFECTS = EFFECTS
local EFFECT_ORDER = { "Atmosphere", "ColorCorrection", "Bloom", "SunRays", "DepthOfField" }

-- v9.8 🌦️ météo : cibles "ciel couvert" (k = couverture), "pluie" (r), "orage" (s)
local OVERCAST = {
	OutdoorAmbient = Color3.fromRGB(134, 136, 146),
	FogColor = Color3.fromRGB(172, 178, 190),
	AtmoColor = Color3.fromRGB(184, 190, 200),
	AtmoDecay = Color3.fromRGB(122, 128, 142),
	Tint = Color3.fromRGB(236, 242, 255),
	Clouds = Color3.fromRGB(172, 176, 186),
}
local STORM = {
	OutdoorAmbient = Color3.fromRGB(96, 100, 114),
	Clouds = Color3.fromRGB(112, 116, 130),
}
local FLASH_CC = 0.07 -- éclair : ColorCorrection.Brightness en plus (doux)
local FLASH_CC_MAX = 0.08 -- plafond absolu (pas de "flash bang")
TownAtmosphere.FLASH_CC_MAX = FLASH_CC_MAX

local active = false
local created: { Instance } = {}
local effects: { [string]: Instance } = {}
local clouds: Clouds? = nil
local night = false
local mix = 0 -- 0 = jour, 1 = nuit (fondu)
local dusk = 0 -- (v9.9) 0 = jour, 1 = coucher de soleil (fondu)
local elapsed = 0
local clockTimer = 0
local mixTimer = 0
local ccBase = 0 -- ColorCorrection.Brightness sans éclair
local cloudBase = Color3.new(1, 1, 1) -- couleur des nuages sans éclair
local lastFlash = 0
local weatherWarned = false
local qualityConn: any = nil

local function lerp(a: any, b: any, t: number): any
	if typeof(a) == "Color3" then
		return (a :: Color3):Lerp(b, t)
	elseif type(a) == "number" then
		return a + (b - a) * t
	end
	return t < 0.5 and a or b
end

local function set(instance: Instance, key: string, value: any)
	pcall(function()
		(instance :: any)[key] = value
	end)
end

local function smooth(t: number): number
	return t * t * (3 - 2 * t)
end

----------------------------------------------------------------------
-- v9.6 : lampes de la ville allumées LA NUIT seulement. Le serveur
-- (TownKit) marque ses vraies lumières "NightOnly" et les verres de
-- lanterne "NightGlow" : le jour, lumières éteintes et verre mat
-- (SmoothPlastic) au lieu de Neon ; remis tels quels à la sortie.
-- (DescendantAdded : pièces qui arrivent plus tard avec le streaming)
----------------------------------------------------------------------

local lightSaved: { [Instance]: boolean } = {}
local glowSaved: { [Instance]: Enum.Material } = {}
local lampsOn = false
local townConnection: RBXScriptConnection? = nil

local function trackLamp(d: Instance)
	if d:IsA("Light") then
		if d:GetAttribute("NightOnly") == true then
			if lightSaved[d] == nil then
				lightSaved[d] = (d :: Light).Enabled
			end
			(d :: Light).Enabled = lampsOn
		end
	elseif d:IsA("BasePart") and d:GetAttribute("NightGlow") == true then
		if glowSaved[d] == nil then
			glowSaved[d] = (d :: BasePart).Material
		end
		(d :: BasePart).Material = lampsOn and Enum.Material.Neon or Enum.Material.SmoothPlastic
	end
end

local function setLamps(on: boolean)
	if lampsOn == on then
		return
	end
	lampsOn = on
	for light in pairs(lightSaved) do
		if light.Parent then
			(light :: Light).Enabled = on
		end
	end
	for part in pairs(glowSaved) do
		if part.Parent then
			(part :: BasePart).Material = on and Enum.Material.Neon or Enum.Material.SmoothPlastic
		end
	end
end

local function watchLamps()
	local town = workspace:FindFirstChild("DopamineTown")
	if not town then
		return
	end
	for _, d in ipairs(town:GetDescendants()) do
		trackLamp(d)
	end
	townConnection = town.DescendantAdded:Connect(trackLamp)
end

local function restoreLamps()
	if townConnection then
		townConnection:Disconnect()
		townConnection = nil
	end
	for light, enabled in pairs(lightSaved) do
		if light.Parent then
			(light :: Light).Enabled = enabled
		end
	end
	for part, material in pairs(glowSaved) do
		if part.Parent then
			(part :: BasePart).Material = material
		end
	end
	table.clear(lightSaved)
	table.clear(glowSaved)
end

-- (tests) lampes allumées ?
function TownAtmosphere.LampsOn(): boolean
	return lampsOn
end

-- (v9.9) réglage "Heure du jour" de ce joueur
local function timeMode(): string
	local ok, mode = pcall(function()
		return GraphicsQuality.Get().TimeOfDay
	end)
	if ok and (mode == "Day" or mode == "Sunset" or mode == "Night") then
		return mode
	end
	return "Auto"
end

-- Nuit voulue : réglage "Heure du jour", sinon "Mode sombre" (Auto)
local function wantNight(): boolean
	local mode = timeMode()
	if mode == "Night" then
		return true
	elseif mode == "Day" or mode == "Sunset" then
		return false
	end
	return night
end

-- Temps du cycle du soleil (Auto) : l'heure du serveur (même soleil pour tous)
local function cycleTime(): number
	local ok, t = pcall(function()
		return workspace:GetServerTimeNow()
	end)
	if ok and type(t) == "number" then
		return t
	end
	return elapsed
end

-- Heure du soleil : cycle doux le jour (Auto) ou midi fixe (Jour), coucher
-- de soleil, nuit fixe ; mélangée pendant les fondus
local function clockNow(): number
	local day
	if timeMode() == "Day" then
		day = NOON_CLOCK
	else
		day = DAY_CLOCK + DAY_SWING * math.sin(cycleTime() / CYCLE_PERIOD * math.pi * 2)
	end
	day += (SUNSET_CLOCK - day) * smooth(dusk)
	local m = smooth(mix)
	return day + (NIGHT_CLOCK - day) * m
end

-- (v9.8) état de la météo (beau temps si Weather3D est absent)
local function weatherState(): any
	if Weather3D and Weather3D.IsActive() then
		return Weather3D.State()
	end
	return { Cloud = 0.3, Rain = 0, Storm = 0, Wet = 0, Flash = 0, Enabled = false }
end

-- Valeurs finales = jour / nuit (fondu) + météo + réglages 🎨
local function applyMix()
	local m = smooth(mix)
	local w = weatherState()
	local q = GraphicsQuality.Get()
	-- couverture : 0 = ciel dégagé, 1 = tout gris
	local k = smooth(math.clamp((w.Cloud - 0.35) / 0.6, 0, 1))
	local r, s = w.Rain, w.Storm
	local d = smooth(dusk)
	local L: { [string]: any } = {}
	for key, dayValue in pairs(DAY) do
		L[key] = lerp(lerp(dayValue, SUNSET[key], d), NIGHT[key], m)
	end
	L.Brightness *= 1 - 0.3 * k - 0.15 * s
	L.OutdoorAmbient = (L.OutdoorAmbient :: Color3):Lerp(OVERCAST.OutdoorAmbient, 0.55 * k * (1 - m)):Lerp(STORM.OutdoorAmbient, 0.6 * s * (1 - m))
	L.ColorShift_Top = (L.ColorShift_Top :: Color3):Lerp(Color3.new(0, 0, 0), k)
	L.ShadowSoftness = lerp(L.ShadowSoftness, 0.8, k)
	L.EnvironmentSpecularScale += 0.28 * w.Wet
	L.ExposureCompensation -= 0.1 * s
	L.FogColor = (L.FogColor :: Color3):Lerp(OVERCAST.FogColor, k * (1 - m))
	if q.Realistic then
		L.EnvironmentSpecularScale += 0.08
		L.EnvironmentDiffuseScale += 0.1
		L.ShadowSoftness = math.max(0.12, L.ShadowSoftness - 0.05)
	end
	for key, value in pairs(L) do
		set(Lighting, key, value)
	end
	set(Lighting, "GlobalShadows", q.Shadows ~= "Low")
	for name, spec in pairs(EFFECTS) do
		local instance = effects[name]
		if instance then
			local E: { [string]: any } = {}
			local sunsetFx = SUNSET_FX[name] or spec.Day
			for key, dayValue in pairs(spec.Day) do
				E[key] = lerp(lerp(dayValue, sunsetFx[key], d), (spec.Night :: any)[key], m)
			end
			if name == "Atmosphere" then
				E.Density += 0.14 * r + 0.05 * k
				E.Haze += 1.3 * r
				E.Glare *= 1 - k
				E.Color = (E.Color :: Color3):Lerp(OVERCAST.AtmoColor, k * (1 - m))
				E.Decay = (E.Decay :: Color3):Lerp(OVERCAST.AtmoDecay, k * (1 - m))
			elseif name == "ColorCorrection" then
				E.Saturation -= 0.18 * k
				E.Contrast += 0.02 * s
				E.Brightness -= 0.02 * s
				E.TintColor = (E.TintColor :: Color3):Lerp(OVERCAST.Tint, 0.6 * k)
				ccBase = E.Brightness
				E.Brightness = ccBase + math.min(FLASH_CC * lastFlash, FLASH_CC_MAX)
			elseif name == "SunRays" then
				E.Intensity *= 1 - k
			end
			for key, value in pairs(E) do
				set(instance, key, value)
			end
			-- Graphismes > Effets : halo, rayons, flou lointain
			if name == "Bloom" or name == "SunRays" or name == "DepthOfField" then
				set(instance, "Enabled", q.Effects)
			end
		end
	end
	local cloud = clouds
	if cloud then
		local color = Color3.fromRGB(255, 255, 255):Lerp(OVERCAST.Clouds, k):Lerp(STORM.Clouds, s)
		cloudBase = color:Lerp(Color3.fromRGB(90, 96, 140), m)
		set(cloud, "Color", cloudBase:Lerp(Color3.new(1, 1, 1), 0.5 * lastFlash))
		local cover = w.Enabled and (0.25 + 0.7 * w.Cloud) or 0.52
		set(cloud, "Cover", lerp(cover, math.max(0.4, cover - 0.1), m))
		set(cloud, "Density", 0.5 + 0.45 * math.clamp(w.Cloud, 0, 1))
	end
	set(Lighting, "ClockTime", clockNow())
	-- (orage : les lampadaires s'allument aussi le jour)
	-- (v9.9 : et au coucher de soleil)
	setLamps(m >= 0.5 or s > 0.55 or d >= 0.5)
end

-- (v9.8) éclair : seulement la ColorCorrection et les nuages, à chaque image
local function applyFlash(flash: number)
	local cc = effects.ColorCorrection
	if cc then
		set(cc, "Brightness", ccBase + math.min(FLASH_CC * flash, FLASH_CC_MAX))
	end
	local cloud = clouds
	if cloud then
		set(cloud, "Color", cloudBase:Lerp(Color3.new(1, 1, 1), 0.5 * flash))
	end
end

local function remember(saved: any, key: string)
	if saved.Lighting[key] ~= nil then
		return
	end
	local ok, current = pcall(function()
		return (Lighting :: any)[key]
	end)
	if ok then
		saved.Lighting[key] = current
	end
end

local function terrain(): Instance?
	local ok, result = pcall(function()
		return workspace:FindFirstChildOfClass("Terrain")
	end)
	return ok and result or nil
end

function TownAtmosphere.Apply(saved: any)
	if active then
		return
	end
	active = true
	elapsed = 0
	clockTimer = 0
	mixTimer = 0
	mix = wantNight() and 1 or 0
	dusk = timeMode() == "Sunset" and 1 or 0
	lampsOn = mix >= 0.5
	-- 1) valeurs actuelles gardées (remise exacte)
	for key in pairs(DAY) do
		remember(saved, key)
	end
	for key in pairs(FIXED) do
		remember(saved, key)
	end
	-- 2) effets / ciels du lieu mis de côté
	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("PostEffect") then
			table.insert(saved.Effects, { Instance = child, Enabled = child.Enabled })
			child.Enabled = false
		elseif child:IsA("Sky") or child:IsA("Atmosphere") then
			table.insert(saved.Moved, { Instance = child, Parent = Lighting })
			child.Parent = nil
		end
	end
	local ground = terrain()
	if ground then
		for _, child in ipairs(ground:GetChildren()) do
			if child:IsA("Clouds") then
				table.insert(saved.Moved, { Instance = child, Parent = ground })
				child.Parent = nil
			end
		end
	end
	-- 3) nos réglages
	for key, value in pairs(FIXED) do
		set(Lighting, key, value)
	end
	local sky = Instance.new("Sky")
	sky.Name = "DopamineTownSky"
	-- (textures par défaut de Roblox : aucun identifiant à charger)
	set(sky, "SunAngularSize", 11)
	set(sky, "MoonAngularSize", 9)
	set(sky, "StarCount", 3000)
	set(sky, "CelestialBodiesShown", true)
	sky.Parent = Lighting
	table.insert(created, sky)
	for _, name in ipairs(EFFECT_ORDER) do
		local spec = EFFECTS[name]
		local ok, instance = pcall(function()
			local i = Instance.new(spec.Class :: any)
			i.Name = "DopamineTown" .. name
			return i
		end)
		if ok and instance then
			for key, value in pairs(spec.Day) do
				set(instance, key, value)
			end
			instance.Parent = Lighting
			effects[name] = instance
			table.insert(created, instance)
		end
	end
	if ground then
		local ok, cloud = pcall(function()
			local c = Instance.new("Clouds")
			c.Name = "DopamineTownClouds"
			c.Cover = 0.52
			c.Density = 0.62
			c.Color = Color3.fromRGB(255, 255, 255)
			return c
		end)
		if ok and cloud then
			cloud.Parent = ground
			clouds = cloud
			table.insert(created, cloud)
		end
	end
	watchLamps()
	-- v9.8 🌦️ météo + 🪞 miroirs (pcall : une erreur n'empêche pas la ville)
	lastFlash = 0
	if Weather3D then
		local okW, errW = pcall(Weather3D.Start, {
			IsNight = function()
				return mix >= 0.5
			end,
		})
		if not okW then
			warn("[TownAtmosphere] Weather3D.Start : " .. tostring(errW))
		end
	end
	if Reflections then
		local okR, errR = pcall(Reflections.Acquire, "Town")
		if not okR then
			warn("[TownAtmosphere] Reflections : " .. tostring(errR))
		end
	end
	-- Graphismes changés en ville : appliqués tout de suite
	qualityConn = GraphicsQuality.Changed:Connect(function()
		if active then
			applyMix()
		end
	end)
	applyMix()
end

function TownAtmosphere.Restore(saved: any)
	if not active then
		return
	end
	active = false
	if qualityConn then
		qualityConn:Disconnect()
		qualityConn = nil
	end
	if Weather3D then
		pcall(Weather3D.Stop)
	end
	if Reflections then
		pcall(Reflections.Release, "Town")
	end
	lastFlash = 0
	for _, instance in ipairs(created) do
		pcall(instance.Destroy, instance)
	end
	table.clear(created)
	table.clear(effects)
	clouds = nil
	restoreLamps()
	for key, value in pairs(saved.Lighting) do
		set(Lighting, key, value)
	end
	for _, effect in ipairs(saved.Effects) do
		pcall(function()
			(effect.Instance :: any).Enabled = effect.Enabled
		end)
	end
	for _, entry in ipairs(saved.Moved) do
		pcall(function()
			entry.Instance.Parent = entry.Parent
		end)
	end
end

function TownAtmosphere.SetNight(on: boolean)
	night = on == true
end

function TownAtmosphere.IsNight(): boolean
	return wantNight()
end

-- (v9.9) réglage "Heure du jour" et fondu du coucher de soleil (tests)
function TownAtmosphere.TimeMode(): string
	return timeMode()
end
function TownAtmosphere.Dusk(): number
	return dusk
end

-- (tests) valeur du fondu jour -> nuit
function TownAtmosphere.Mix(): number
	return mix
end

-- (v9.8) météo en cours (Weather3D.State() ; beau temps sans Weather3D)
function TownAtmosphere.Weather(): any
	return weatherState()
end

function TownAtmosphere.Step(dt: number)
	if not active then
		return
	end
	elapsed += dt
	-- v9.8 🌦️ pluie, flaques, éclairs (Weather3D) : une seule alerte en cas d'erreur
	if Weather3D then
		local okW, errW = pcall(Weather3D.Step, dt)
		if not okW and not weatherWarned then
			weatherWarned = true
			warn("[TownAtmosphere] Weather3D.Step : " .. tostring(errW))
		end
		local flash = Weather3D.State().Flash or 0
		if flash > 0 or lastFlash > 0 then
			lastFlash = flash
			applyFlash(flash)
		end
	end
	local target = wantNight() and 1 or 0
	local duskTarget = timeMode() == "Sunset" and 1 or 0
	if mix ~= target or dusk ~= duskTarget then
		mixTimer += dt
		if mixTimer >= 0.2 then
			local step = mixTimer / FADE_TIME
			mixTimer = 0
			if mix < target then
				mix = math.min(target, mix + step)
			else
				mix = math.max(target, mix - step)
			end
			if dusk < duskTarget then
				dusk = math.min(duskTarget, dusk + step)
			else
				dusk = math.max(duskTarget, dusk - step)
			end
			applyMix()
		end
		return
	end
	-- heure du soleil + météo : 2 fois / s (changements lents)
	clockTimer += dt
	if clockTimer >= 0.5 then
		clockTimer = 0
		applyMix()
	end
end

return TownAtmosphere
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="229">
          <Properties>
            <string name="Name">TownClient</string>
            <string name="Source"><![CDATA[--[[
	TownClient (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > TownClient

	🚶 Dopamine Town, côté client (lancé par ClientMain : TownClient.Init()).
	  - Entrer (WorldLink.Enter, bouton de la colonne centrale ou de la
	    fenêtre Maison) : les fenêtres du clicker se ferment, TOUTES les
	    ScreenGui du joueur sont masquées (sauf le HUD de la ville) et remises
	    EXACTEMENT à la sortie ; le serveur charge le personnage devant sa
	    porte (WorldService) ; éclairage pastel de la ville (Lighting +
	    Atmosphere / ciel / couleurs / halo, tout remis à la sortie), caméra
	    Roblox par défaut qui suit l'avatar (zoom 0,5 à 40 studs), manette
	    tactile et saut sur mobile, chat + bulles au-dessus des têtes ;
	  - maisons de TOUS les joueurs construites ici (HouseBuilder) d'après les
	    instantanés du serveur ; intérieurs en flux autour du joueur (une
	    pièce à la fois, sur plusieurs images) ;
	  - portes (s'ouvrent à l'approche si le propriétaire accueille ce
	    joueur), bandeau de la maison où l'on est, ❤️, visites, émotes,
	    s'asseoir (invite -> le serveur crée un Seat), étiquettes de nom
	    (pseudo + 🌊 visites à l'océan + ❤️) ;
	  - édition des meubles de SA maison (FurnitureEdit) ;
	  - Sortir ("⬅ Clicker") : fondu, le personnage est retiré, tout est remis.
	v9.4 (ENTRY94) :
	  - arrivée : écran de chargement (barre = maisons construites), puis
	    1re fois de la session un survol de la ville (TownArrival, ~4 s,
	    passable) qui finit derrière l'avatar posé à la PORTE de la ville
	    (attribut "EntranceCF" de TOWN94) ; boussole discrète dans le HUD,
	    "🏠 Rentrer" (v9.6 : plus d'arc lumineux ni de repère à l'écran) ;
	  - émotes (TownEmotes) : la piste est gardée et s'arrête en bougeant,
	    en sautant, avec une autre émote, le bouton ■, en s'asseyant, en
	    mode édition, en sortant, à la mort / au retrait du personnage ;
	    "Se lever" quand on est assis (par terre ou sur un siège) ;
	  - ambiance réaliste (TownAtmosphere) : jour / nuit selon le réglage
	    "Mode sombre", remise EXACTE à la sortie.
	Les gains passifs continuent (serveur) ; le bouton 👆 du HUD clique comme
	le gros bouton (ClientState.Click).
	Travail par image : presque rien (compteur 10 fois / s, portes et bandeau
	5 fois / s, flux 4 fois / s, étiquettes 1 fois / s).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local GuiService = game:GetService("GuiService")
local StarterGui = game:GetService("StarterGui")
local TextChatService = game:GetService("TextChatService")

local Client = script.Parent.Parent
local Components = Client:WaitForChild("Components")
local ClientState = require(Client.ClientState)
local Net = require(ReplicatedStorage.Shared.Net)
local Locale = require(ReplicatedStorage.Shared.Locale)
local WorldLayout = require(ReplicatedStorage.Shared.WorldLayout)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local WorldLink = require(script.Parent.WorldLink)
local HouseBuilder = require(script.Parent.HouseBuilder)
local TownHud = require(script.Parent.TownHud)
local FurnitureEdit = require(script.Parent.FurnitureEdit)
local TownEmotes = require(script.Parent.TownEmotes)

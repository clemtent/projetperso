		Position = UDim2.fromScale(0.5, 0.53),
		Size = UDim2.fromScale(0.94, 0.2),
		ZIndex = 4,
	}, CAP_DARK, UDim.new(0.5, 0))
	outline(hero.Visor, 0.4)
	-- mèche de cheveux sur la nuque (se balance : pivot centré sur l'attache)
	hero.Tuft = frame({

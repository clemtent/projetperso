local function tierForLevel(level: number): number
	return math.clamp(math.floor(level), 1, #TIERS)
end

-- Tirage pondéré d'un objet dessiné "général" (Weight > 0)
local GENERAL: { Drawn } = {}
local GENERAL_WEIGHT = 0
for _, def in pairs(DRAWN) do
	if def.Weight > 0 then
		table.insert(GENERAL, def)
		GENERAL_WEIGHT += def.Weight
	end
end
table.sort(GENERAL, function(a, b)
	return a.Id < b.Id
end)

function Press.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local Create = UIUtil.Create
	local container: Frame = ctx.Container
	local random = Random.new()
	local cooldown = (ctx.Config.Interactions.Press and ctx.Config.Interactions.Press.Cooldown) or 3

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	-- La carte est-elle visible ? (si le StimulusManager sait le dire)
	local function visible(): boolean
		local isVisible = ctx.IsVisible
		if type(isVisible) ~= "function" then
			return true
		end
		local ok, result = pcall(isVisible)
		return not ok or result ~= false
	end

	local function currentLevel(): number
		return math.max(1, ctx.GetLevel("Press") or 1)
	end

	local function speedFactor(): number
		return 1 + (currentLevel() - 1) * 0.2
	end

	------------------------------------------------------------------
	-- Carte (fixe, contour toujours net) = mur de l'atelier + sol
	------------------------------------------------------------------
	local card = Create("Frame", {
		Name = "Card",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -4, 1, -4),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ClipsDescendants = true, -- rien ne dépasse jamais du cadre
		Parent = container,
	})
	UIUtil.Corner(card, 18)
	local cardStroke = UIUtil.Stroke(card, Theme.Colors.CardBorder, 2)
	-- Le fond de la carte = le sol ; le mur est une plaque arrondie en haut
	-- (ClipsDescendants ne coupe pas les coins arrondis : rien de carré ne
	-- doit toucher les coins de la carte)
	UIUtil.Gradient(card, seq(WHITE, rgb(150, 150, 150)), 90)

	local function box(props: { [string]: any }, radius: (number | UDim)?): Frame
		props.BorderSizePixel = 0
		local frame = Create("Frame", props)
		if radius then
			UIUtil.Corner(frame, radius)
		end
		return frame
	end

	local wall = box({ Name = "Wall", Size = UDim2.new(1, 0, 0, FLOOR_Y), BackgroundColor3 = WHITE, ZIndex = 1, Parent = card }, 18)
	local wallGradient = UIUtil.Gradient(wall, seq(TIERS[1].WallTop, TIERS[1].WallBottom), 90)
	local wallFoot = box({ Position = UDim2.fromOffset(0, FLOOR_Y - 20), Size = UDim2.new(1, 0, 0, 20), BackgroundColor3 = WHITE, ZIndex = 1, Parent = card })
	local wallFootGradient = UIUtil.Gradient(wallFoot, seq(TIERS[1].WallBottom, TIERS[1].WallBottom), 90)

	-- Joints de panneaux muraux (recolorés selon le palier)
	local seams: { Frame } = {}
	for i = 1, 5 do
		table.insert(seams, box({ Position = UDim2.fromOffset(i * 64 - 8, HEADER_H + 4), Size = UDim2.fromOffset(1, FLOOR_Y - HEADER_H - 4), BackgroundColor3 = TIERS[1].Seam, BackgroundTransparency = 0.5, ZIndex = 2, Parent = card }))
	end
	table.insert(seams, box({ Position = UDim2.fromOffset(0, 150), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = TIERS[1].Seam, BackgroundTransparency = 0.5, ZIndex = 2, Parent = card }))

	-- Sol (= fond de la carte) + bande de sécurité
	local floor = box({ Name = "Floor", Position = UDim2.fromOffset(0, FLOOR_Y), Size = UDim2.new(1, 0, 1, -FLOOR_Y), BackgroundTransparency = 1, ZIndex = 2, Parent = card })
	local floorTape = box({ Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, 0, 0, 3), BackgroundColor3 = WHITE, ZIndex = 1, Parent = floor })
	local floorTapeStripes = stripeFill(floorTape, 40, rgb(255, 200, 30), INK, 0)
	-- Grille néon au sol (palier 10)
	local floorGrid = box({ Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, ZIndex = 1, Parent = floor })
	for i = 1, 10 do
		box({ Position = UDim2.fromOffset(i * 34, 0), Size = UDim2.new(0, 1, 1, 0), BackgroundColor3 = rgb(255, 60, 200), BackgroundTransparency = 0.45, ZIndex = 1, Parent = floorGrid })
	end
	box({ Position = UDim2.fromOffset(20, 9), Size = UDim2.new(1, -40, 0, 1), BackgroundColor3 = rgb(0, 230, 255), BackgroundTransparency = 0.45, ZIndex = 1, Parent = floorGrid })

	-- La machine ("rig") : seule elle tremble au CRUNCH
	local rig = Create("Frame", {
		Name = "Rig",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = card,
	})

	local function rbox(props: { [string]: any }, radius: (number | UDim)?): Frame
		if props.Parent == nil then
			props.Parent = rig
		end
		return box(props, radius)
	end

	local function dot(parent: Instance, x: number, y: number, size: number, color: Color3, z: number): Frame
		return box({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(size, size), BackgroundColor3 = color, ZIndex = z, Parent = parent }, UDim.new(1, 0))
	end

	------------------------------------------------------------------
	-- En-tête : titre, pastille de palier, compteur, vitesse
	------------------------------------------------------------------
	local titleLabel = UIUtil.Label({
		Text = Locale.T("🗜️ PRESS"),
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.TextDark,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(14, 7),
		Size = UDim2.fromOffset(92, 20),
		MaxTextSize = 16,
		ZIndex = 30,
		Parent = card,
	})
	-- Pilule de LARGEUR FIXE (texte réduit si besoin) : elle ne peut jamais
	-- chevaucher le titre ni le compteur, quelle que soit la police / langue
	local tierChip = box({
		Name = "TierChip",
		Position = UDim2.fromOffset(110, 7),
		Size = UDim2.fromOffset(172, 20),
		BackgroundColor3 = TIERS[1].Chip,
		ZIndex = 30,
		Parent = card,
	}, UDim.new(1, 0))
	local tierChipStroke = UIUtil.Stroke(tierChip, WHITE, 1.5, 0.35)
	UIUtil.Gradient(tierChip, seq(WHITE, rgb(215, 215, 215)), 90)
	-- Pastille ronde "niveau" à gauche de la pilule
	local levelBadge = box({ AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0), Size = UDim2.fromOffset(15, 15), BackgroundColor3 = WHITE, ZIndex = 31, Parent = tierChip }, UDim.new(1, 0))
	local levelBadgeLabel = Create("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Number,
		Text = "",
		TextColor3 = INK,
		TextSize = 10,
		ZIndex = 32,
		Parent = levelBadge,
	})
	local tierChipLabel = UIUtil.Label({
		Name = "Label",
		Position = UDim2.fromOffset(22, 3),
		Size = UDim2.new(1, -30, 1, -6),
		Font = Theme.Fonts.Title,
		Text = "",
		TextColor3 = WHITE,
		MaxTextSize = 12,
		ZIndex = 32,
		Parent = tierChip,
	})
	local tierChipScale = Create("UIScale", { Parent = tierChip })
	local counterLabel = UIUtil.Label({
		Text = "💥 0",
		Font = Theme.Fonts.Number,
		TextColor3 = Theme.Colors.TextDark,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 4),
		Size = UDim2.fromOffset(70, 18),
		MaxTextSize = 16,
		ZIndex = 30,
		Parent = card,
	})
	local counterScale = Create("UIScale", { Parent = counterLabel })
	local speedLabel = UIUtil.Label({
		Text = "⚡ x1",
		Font = Theme.Fonts.Number,
		TextColor3 = Theme.Colors.Orange,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 21),
		Size = UDim2.fromOffset(60, 12),
		MaxTextSize = 11,
		ZIndex = 30,
		Parent = card,
	})

	------------------------------------------------------------------
	-- Manomètre gradué (aiguille = cadre pivot à faire tourner)
	------------------------------------------------------------------
	local function makeGauge(parent: Instance, cx: number, cy: number, size: number, z: number): (Frame, Frame, UIStroke)
		local face = box({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(cx, cy), Size = UDim2.fromOffset(size, size), BackgroundColor3 = WHITE, ZIndex = z, Parent = parent }, UDim.new(1, 0))
		UIUtil.Gradient(face, seq(WHITE, rgb(214, 218, 228)), 90)
		local bezel = UIUtil.Stroke(face, INK, size >= 20 and 2.5 or 2)
		local ticks = size >= 20 and 7 or 5
		for i = 0, ticks - 1 do
			local pivot = Create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Rotation = -120 + i * (240 / (ticks - 1)),
				ZIndex = z + 1,
				Parent = face,
			})
			local redZone = i >= ticks - 2
			box({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.07), Size = UDim2.new(0, redZone and 2 or 1, 0.17, 0), BackgroundColor3 = redZone and RED or INK, ZIndex = z + 1, Parent = pivot })
		end
		local needle = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Rotation = -120,
			ZIndex = z + 2,
			Parent = face,
		})
		box({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, 0.55), Size = UDim2.new(0, 2, 0.46, 0), BackgroundColor3 = RED, ZIndex = z + 2, Parent = needle }, 1)
		box({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.22, 0.22), BackgroundColor3 = INK, ZIndex = z + 3, Parent = face }, UDim.new(1, 0))
		-- Reflet de la vitre
		box({ Position = UDim2.fromScale(0.16, 0.1), Size = UDim2.fromScale(0.44, 0.22), BackgroundColor3 = WHITE, BackgroundTransparency = 0.5, Rotation = -25, ZIndex = z + 3, Parent = face }, UDim.new(1, 0))
		return face, needle, bezel
	end

	------------------------------------------------------------------
	-- Calques de la machine (voir Z en haut du fichier)
	------------------------------------------------------------------
	local function layer(name: string, z: number): Frame
		return Create("Frame", { Name = name, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = z, Parent = rig })
	end
	-- L'éclat est découpé entre l'en-tête et le sol (cadre jamais tourné :
	-- la découpe fonctionne aussi dans Roblox, même si l'éclat, lui, tourne)
	local burstLayer = Create("Frame", { Name = "Burst", Position = UDim2.fromOffset(0, HEADER_H), Size = UDim2.new(1, 0, 0, FLOOR_Y - HEADER_H), BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = Z.Burst, Parent = rig })
	local decorBack = layer("DecorBack", Z.DecorBack)
	local hoseLayer = layer("Hoses", Z.Hose)
	local unit = layer("Unit", Z.Unit)
	local decorPillar = layer("DecorPillar", Z.PillarDecor)
	local decorCrown = layer("DecorCrown", Z.CrownDecor)
	local decorBolster = layer("DecorBolster", Z.BolsterDecor)

	------------------------------------------------------------------
	-- Flexible hydraulique (courbe de Bézier en petits segments)
	------------------------------------------------------------------
	local hoseSegments: { Frame } = {}
	local fittings: { Frame } = {}
	local function hose(p0: Vector2, p1: Vector2, p2: Vector2, p3: Vector2, thickness: number)
		local steps = 10
		local previous = p0
		for i = 1, steps do
			local t = i / steps
			local u = 1 - t
			local point = p0 * (u * u * u) + p1 * (3 * u * u * t) + p2 * (3 * u * t * t) + p3 * (t * t * t)
			local delta = point - previous
			local middle = (point + previous) / 2
			local segment = box({
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(middle.X, middle.Y),
				Size = UDim2.fromOffset(delta.Magnitude + thickness * 0.7, thickness),
				Rotation = math.deg(math.atan2(delta.Y, delta.X)),
				BackgroundColor3 = TIERS[1].Hose,
				ZIndex = 1,
				Parent = hoseLayer,
			}, UDim.new(1, 0))
			table.insert(hoseSegments, segment)
			previous = point
		end
		for _, p in ipairs({ p0, p3 }) do
			table.insert(fittings, box({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(p.X, p.Y), Size = UDim2.fromOffset(thickness + 4, thickness + 4), BackgroundColor3 = TIERS[1].Fitting, ZIndex = 2, Parent = hoseLayer }, 2))
		end
	end

	------------------------------------------------------------------
	-- Centrale hydraulique (à gauche) : moteur + réservoir + voyant d'huile
	------------------------------------------------------------------
	local motor = box({ Position = UDim2.fromOffset(16, 66), Size = UDim2.fromOffset(40, 26), BackgroundColor3 = WHITE, ZIndex = 2, Parent = unit }, 6)
	local motorGradient = UIUtil.Gradient(motor, stripes(8, rgb(120, 126, 140), rgb(90, 96, 110)), 90)
	local motorStroke = UIUtil.Stroke(motor, INK, 1.5, 0.3)
	box({ Position = UDim2.fromOffset(11, 72), Size = UDim2.fromOffset(6, 14), BackgroundColor3 = rgb(70, 74, 86), ZIndex = 1, Parent = unit }, 2)
	local tank = box({ Position = UDim2.fromOffset(12, 92), Size = UDim2.fromOffset(48, 62), BackgroundColor3 = WHITE, ZIndex = 3, Parent = unit }, 7)
	local tankGradient = UIUtil.Gradient(tank, cylinderSeq(TIERS[1].Frame), 0)
	local tankStroke = UIUtil.Stroke(tank, TIERS[1].Outline, 1.5, 0.2)
	-- Voyant d'huile (niveau qui bouge avec la pression)
	local sight = box({ Position = UDim2.fromOffset(40, 100), Size = UDim2.fromOffset(10, 46), BackgroundColor3 = rgb(30, 34, 44), ClipsDescendants = true, ZIndex = 4, Parent = unit }, 3)
	UIUtil.Stroke(sight, WHITE, 1, 0.5)
	local oil = box({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 0.6), BackgroundColor3 = rgb(255, 180, 40), ZIndex = 5, Parent = sight }, 2)
	UIUtil.Gradient(oil, seq(rgb(255, 230, 140), rgb(230, 130, 20)), 90)
	local _, tankNeedle = makeGauge(unit, 25, 114, 18, 5)
	-- Pieds du réservoir
	for _, x in ipairs({ 16, 50 }) do
		box({ Position = UDim2.fromOffset(x, 153), Size = UDim2.fromOffset(6, 7), BackgroundColor3 = rgb(60, 64, 74), ZIndex = 2, Parent = unit }, 1)
	end
	-- Deux flexibles PARALLÈLES jusqu'au vérin, au-dessus de la traverse
	-- (ils ne se croisent pas et ne passent derrière rien)
	hose(Vector2.new(26, 68), Vector2.new(26, 38), Vector2.new(40, 40), Vector2.new(MX - 28, 40), 5)
	hose(Vector2.new(44, 68), Vector2.new(44, 47), Vector2.new(56, 47), Vector2.new(MX - 28, 47), 4)

	------------------------------------------------------------------
	-- La presse
	------------------------------------------------------------------
	-- Colonnes (ombrées comme des cylindres) + pieds
	local pillars: { { Frame: Frame, Gradient: UIGradient, Stroke: UIStroke } } = {}
	for _, x in ipairs(PILLAR_X) do
		local pillar = rbox({ Position = UDim2.fromOffset(x, CROWN_Y + 4), Size = UDim2.fromOffset(PILLAR_W, FLOOR_Y - CROWN_Y - 8), BackgroundColor3 = WHITE, ZIndex = Z.Pillar }, 3)
		local gradient = UIUtil.Gradient(pillar, cylinderSeq(TIERS[1].Frame), 0)
		local stroke = UIUtil.Stroke(pillar, TIERS[1].Outline, 1, 0.35)
		table.insert(pillars, { Frame = pillar, Gradient = gradient, Stroke = stroke })
	end
	local feet: { Frame } = {}
	for _, x in ipairs(PILLAR_X) do
		local foot = rbox({ Position = UDim2.fromOffset(x - 6, FLOOR_Y - 7), Size = UDim2.fromOffset(PILLAR_W + 12, 8), BackgroundColor3 = WHITE, ZIndex = Z.Pillar }, 2)
		table.insert(feet, foot)
	end
	local feetGradients: { UIGradient } = {}
	for _, foot in ipairs(feet) do
		table.insert(feetGradients, UIUtil.Gradient(foot, beamSeq(TIERS[1].Frame), 90))
	end

	-- Vérin (chemise + fond) au-dessus de la traverse
	local housing = rbox({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromOffset(MX, CYL_Y), Size = UDim2.fromOffset(60, CROWN_Y - CYL_Y + 4), BackgroundColor3 = WHITE, ZIndex = Z.Housing }, 5)
	local housingGradient = UIUtil.Gradient(housing, cylinderSeq(TIERS[1].Frame), 0)
	local housingStroke = UIUtil.Stroke(housing, TIERS[1].Outline, 1.5, 0.25)
	local cap = rbox({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromOffset(MX, CYL_Y + 3), Size = UDim2.fromOffset(68, 6), BackgroundColor3 = WHITE, ZIndex = Z.Housing }, 2)
	local capGradient = UIUtil.Gradient(cap, beamSeq(TIERS[1].Frame), 90)

	-- Traverse
	local CROWN_X, CROWN_W = MX - 114, 228
	local crown = rbox({ Position = UDim2.fromOffset(CROWN_X, CROWN_Y), Size = UDim2.fromOffset(CROWN_W, CROWN_H), BackgroundColor3 = WHITE, ClipsDescendants = true, ZIndex = Z.Crown }, 6)
	local crownGradient = UIUtil.Gradient(crown, beamSeq(TIERS[1].Frame), 90)
	local crownStroke = UIUtil.Stroke(crown, TIERS[1].Outline, 2, 0.1)
	-- Bande d'accent (s'arrête avant le panneau des manomètres)
	local GAUGE_PANEL_X, GAUGE_PANEL_W = 162, 60 -- (repère de la traverse)
	local crownStripe = box({ Position = UDim2.fromOffset(8, 9), Size = UDim2.fromOffset(GAUGE_PANEL_X - 14, 8), BackgroundColor3 = WHITE, ZIndex = 2, Parent = crown }, 2)
	local crownStripes = stripeFill(crownStripe, 16, TIERS[1].AccentA, TIERS[1].AccentB, 35)
	-- Panneau des manomètres ENCASTRÉ dans la traverse (plus rien ne dépasse)
	local gaugePanel = box({ Position = UDim2.fromOffset(GAUGE_PANEL_X, 2), Size = UDim2.fromOffset(GAUGE_PANEL_W, CROWN_H - 4), BackgroundColor3 = rgb(36, 40, 50), ZIndex = 10, Parent = crown }, 5)
	local gaugePanelStroke = UIUtil.Stroke(gaugePanel, INK, 1, 0.3)
	local _, mainNeedle, mainBezel = makeGauge(gaugePanel, 15, (CROWN_H - 4) / 2, 18, 2)
	-- Second manomètre (paliers >= 4) ; sinon un voyant "prêt"
	local gauge2, gauge2Needle = makeGauge(gaugePanel, GAUGE_PANEL_W - 15, (CROWN_H - 4) / 2, 18, 2)
	local panelLamp = box({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(GAUGE_PANEL_W - 15, (CROWN_H - 4) / 2), Size = UDim2.fromOffset(10, 10), BackgroundColor3 = Theme.Colors.Green, ZIndex = 2, Parent = gaugePanel }, UDim.new(1, 0))
	UIUtil.Stroke(panelLamp, INK, 1)

	-- Tige chromée (derrière la traverse et le plateau)
	local rod = rbox({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromOffset(MX, CROWN_Y + CROWN_H - 2), Size = UDim2.fromOffset(20, 10), BackgroundColor3 = WHITE, ZIndex = Z.Rod })
	local rodGradient = UIUtil.Gradient(rod, cylinderSeq(TIERS[1].Chrome), 0)
	-- Joint (bague) sous la traverse
	local gland = rbox({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromOffset(MX, CROWN_Y + CROWN_H - 1), Size = UDim2.fromOffset(30, 6), BackgroundColor3 = WHITE, ZIndex = Z.Gland }, 2)
	local glandGradient = UIUtil.Gradient(gland, beamSeq(TIERS[1].Frame), 90)

	-- Plateau (guidé par les colonnes) + éclair blanc au choc : DEVANT les objets
	local plate = rbox({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromOffset(MX, PLATE_TOP), Size = UDim2.fromOffset(PLATE_W, PLATE_H), BackgroundColor3 = WHITE, ZIndex = Z.Plate }, 4)
	local plateGradient = UIUtil.Gradient(plate, beamSeq(TIERS[1].Frame), 90)
	local plateStroke = UIUtil.Stroke(plate, TIERS[1].Outline, 1.5, 0.2)
	local plateStripe = box({ Position = UDim2.fromOffset(8, 4), Size = UDim2.new(1, -16, 0, 6), BackgroundColor3 = WHITE, ZIndex = 6, Parent = plate }, 2)
	local plateStripes = stripeFill(plateStripe, 16, TIERS[1].AccentA, TIERS[1].AccentB, 35)
	-- Semelle (plus sombre, en dessous)
	local die = box({ Position = UDim2.new(0, 10, 1, -5), Size = UDim2.new(1, -20, 0, 5), BackgroundColor3 = rgb(60, 64, 76), ZIndex = 6, Parent = plate }, 1)
	local guides: { Frame } = {}
	for _, side in ipairs({ -1, 1 }) do
		local guide = box({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, side * (PLATE_W / 2 + 1), 0.5, 0),
			Size = UDim2.fromOffset(PILLAR_W + 10, PLATE_H + 6),
			BackgroundColor3 = WHITE,
			ZIndex = 7,
			Parent = plate,
		}, 4)
		UIUtil.Stroke(guide, INK, 1, 0.5)
		table.insert(guides, guide)
	end
	local guideGradients: { UIGradient } = {}
	for _, guide in ipairs(guides) do
		table.insert(guideGradients, UIUtil.Gradient(guide, beamSeq(TIERS[1].Frame), 90))
	end
	local plateFlash = box({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BackgroundTransparency = 1, ZIndex = 9, Parent = plate }, 4)
	-- Traits de vitesse au-dessus du plateau (descente rapide)
	local speedLines: { Frame } = {}
	for i, x in ipairs({ -52, -18, 18, 52 }) do
		table.insert(speedLines, box({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, x, 0, -3), Size = UDim2.fromOffset(3, 10 + (i % 2) * 6), BackgroundColor3 = WHITE, BackgroundTransparency = 1, ZIndex = 1, Parent = plate }, UDim.new(1, 0)))
	end

	-- Enclume (sous le tapis) avec bande d'accent
	local bolster = rbox({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromOffset(MX, BELT_Y + BELT_H - 1), Size = UDim2.fromOffset(176, FLOOR_Y - BELT_Y - BELT_H + 1), BackgroundColor3 = WHITE, ZIndex = Z.Bolster }, 3)
	local bolsterGradient = UIUtil.Gradient(bolster, beamSeq(TIERS[1].Frame), 90)
	local bolsterStroke = UIUtil.Stroke(bolster, TIERS[1].Outline, 1.5, 0.2)
	local bolsterStripe = box({ Position = UDim2.fromOffset(6, 12), Size = UDim2.new(1, -12, 0, 8), BackgroundColor3 = WHITE, ZIndex = 5, Parent = bolster }, 2)
	local bolsterStripes = stripeFill(bolsterStripe, 18, TIERS[1].AccentA, TIERS[1].AccentB, 35)
	local led = box({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -12, 0, 6), Size = UDim2.fromOffset(6, 6), BackgroundColor3 = Theme.Colors.Green, ZIndex = 6, Parent = bolster }, UDim.new(1, 0))

	------------------------------------------------------------------
	-- Tapis roulant : bande qui défile, châssis, rouleaux, pieds
	------------------------------------------------------------------
	local belt = rbox({ Position = UDim2.fromOffset(BELT_X0, BELT_Y), Size = UDim2.fromOffset(BELT_X1 - BELT_X0, BELT_H), BackgroundColor3 = rgb(40, 42, 50), ClipsDescendants = true, ZIndex = Z.Belt }, 3)
	local BELT_PERIOD = 12
	local beltStripes = box({ Size = UDim2.new(1, BELT_PERIOD * 2, 1, 0), BackgroundColor3 = WHITE, ZIndex = 1, Parent = belt })
	stripeFill(beltStripes, math.floor((BELT_X1 - BELT_X0 + BELT_PERIOD * 2) / (BELT_PERIOD / 2)), rgb(74, 78, 92), rgb(44, 46, 56), 0)
	box({ Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = WHITE, BackgroundTransparency = 0.8, ZIndex = 2, Parent = belt })
	-- Châssis (devant les rouleaux) : à droite de l'enclume et petit bout à gauche
	local steel = rgb(96, 104, 120)
	local frames = {
		rbox({ Position = UDim2.fromOffset(MX + 88, BELT_Y + BELT_H), Size = UDim2.fromOffset(BELT_X1 - MX - 88, 12), BackgroundColor3 = WHITE, ZIndex = Z.BeltFrame }, 3),
		rbox({ Position = UDim2.fromOffset(BELT_X0, BELT_Y + BELT_H), Size = UDim2.fromOffset(MX - 88 - BELT_X0, 12), BackgroundColor3 = WHITE, ZIndex = Z.BeltFrame }, 3),
	}
	for _, f in ipairs(frames) do
		UIUtil.Gradient(f, beamSeq(steel), 90)
	end
	-- Rouleaux (moyeux qui tournent quand la bande avance)
	local rollers: { Frame } = {}
	for _, x in ipairs({ BELT_X0 + 9, MX + 102, MX + 130, MX + 158, MX + 186 }) do
		local hub = rbox({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(x, BELT_Y + BELT_H + 6), Size = UDim2.fromOffset(9, 9), BackgroundColor3 = rgb(200, 206, 216), ZIndex = Z.Roller }, UDim.new(1, 0))
		UIUtil.Stroke(hub, rgb(50, 54, 64), 1)
		box({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, -2, 0, 2), BackgroundColor3 = rgb(60, 64, 76), ZIndex = 2, Parent = hub })
		box({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 2, 1, -2), BackgroundColor3 = rgb(60, 64, 76), ZIndex = 2, Parent = hub })
		table.insert(rollers, hub)
	end
	-- Pieds du tapis + entretoise
	for _, x in ipairs({ MX + 112, MX + 190 }) do
		rbox({ Position = UDim2.fromOffset(x, BELT_Y + BELT_H + 12), Size = UDim2.fromOffset(7, FLOOR_Y - BELT_Y - BELT_H - 12), BackgroundColor3 = rgb(80, 86, 100), ZIndex = Z.BeltLegs }, 1)
	end
	rbox({ Position = UDim2.fromOffset(MX + 112, FLOOR_Y - 12), Size = UDim2.fromOffset(78, 4), BackgroundColor3 = rgb(80, 86, 100), ZIndex = Z.BeltLegs }, 1)

	------------------------------------------------------------------
	-- Bac de récupération (à gauche, son bord SOUS le bout du tapis)
	------------------------------------------------------------------
	rbox({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromOffset(BIN_X, BIN_TOP), Size = UDim2.fromOffset(BIN_W, FLOOR_Y - BIN_TOP), BackgroundColor3 = rgb(40, 90, 56), ZIndex = Z.BinBack }, 5)
	local binFront = rbox({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromOffset(BIN_X, BIN_TOP + 8), Size = UDim2.fromOffset(BIN_W + 4, FLOOR_Y - BIN_TOP - 8), BackgroundColor3 = rgb(70, 150, 96), ZIndex = Z.BinFront }, 5)
	UIUtil.Gradient(binFront, cylinderSeq(rgb(70, 150, 96)), 0)
	UIUtil.Stroke(binFront, rgb(30, 80, 46), 1.5)
	UIUtil.Label({
		Text = "♻️",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.55),
		Size = UDim2.fromOffset(20, 20),
		MaxTextSize = 18,
		ZIndex = 2,
		Parent = binFront,
	})
	rbox({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromOffset(BIN_X, BIN_TOP + 5), Size = UDim2.fromOffset(BIN_W + 8, 6), BackgroundColor3 = rgb(50, 120, 72), ZIndex = Z.BinRim }, 3)
	local binFill = rbox({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromOffset(BIN_X, BIN_TOP + 10), Size = UDim2.fromOffset(BIN_W - 12, 0), BackgroundColor3 = rgb(180, 140, 90), ZIndex = Z.BinFill }, PILL)
	local binScale = Create("UIScale", { Parent = binFront })

	------------------------------------------------------------------
	-- Éclat "BD" derrière la machine au CRUNCH (rayons + étoile, réutilisés)
	------------------------------------------------------------------
	local BURST_Y = BELT_Y - 36
	local burst = box({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(MX, BURST_Y - HEADER_H), Size = UDim2.fromOffset(250, 250), BackgroundTransparency = 1, Visible = false, ZIndex = 1, Parent = burstLayer })
	local burstScale = Create("UIScale", { Parent = burst })
	local burstStars: { Frame } = {}
	local burstStrokes: { UIStroke } = {}
	for i = 1, 2 do
		local star = box({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(92, 92), Rotation = (i - 1) * 45, BackgroundColor3 = rgb(255, 214, 60), ZIndex = 2, Parent = burst }, 8)
		table.insert(burstStars, star)
		table.insert(burstStrokes, UIUtil.Stroke(star, rgb(255, 140, 30), 2.5, 0.2))
	end
	local burstRays: { Frame } = {}
	for i = 1, RAY_COUNT do
		local pivot = box({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1), Rotation = (i - 1) * (360 / RAY_COUNT) + 7, BackgroundTransparency = 1, ZIndex = 1, Parent = burst })
		local long = i % 2 == 1
		table.insert(burstRays, box({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, long and 0 or 0.12), Size = UDim2.new(0, long and 12 or 8, 0.5, long and -30 or -44), BackgroundColor3 = long and WHITE or rgb(255, 214, 60), ZIndex = 1, Parent = pivot }, UDim.new(1, 0)))
	end

	------------------------------------------------------------------
	-- Pupitre (à droite) : bouton START (Presse turbo) ou panneau d'avertissement
	------------------------------------------------------------------
	local console = rbox({ Name = "Console", Position = UDim2.fromOffset(CONSOLE_X, CONSOLE_Y), Size = UDim2.fromOffset(CONSOLE_W, CONSOLE_H), BackgroundColor3 = WHITE, ZIndex = Z.Console }, 10)
	UIUtil.Gradient(console, seq(rgb(84, 90, 104), rgb(44, 48, 58)), 90)
	local consoleStroke = UIUtil.Stroke(console, INK, 2)
	for _, pos in ipairs({ Vector2.new(6, 6), Vector2.new(CONSOLE_W - 6, 6), Vector2.new(6, CONSOLE_H - 6), Vector2.new(CONSOLE_W - 6, CONSOLE_H - 6) }) do
		dot(console, pos.X, pos.Y, 4, rgb(170, 176, 190), 13)
	end
	-- Voyant d'état (vert = prêt, rouge = en pression)
	local statusLamp = dot(console, 14, 14, 8, Theme.Colors.Green, 14)
	UIUtil.Stroke(statusLamp, INK, 1)

	-- Sans turbo : panneau "Attention aux doigts"
	local warning = box({ Name = "Warning", Position = UDim2.fromOffset(8, 24), Size = UDim2.new(1, -16, 1, -32), BackgroundColor3 = rgb(255, 206, 40), ZIndex = 13, Parent = console }, 6)
	UIUtil.Stroke(warning, INK, 1.5)
	UIUtil.Label({
		Text = "⚠️",
		Position = UDim2.fromOffset(0, 2),
		Size = UDim2.new(1, 0, 0, 24),
		MaxTextSize = 22,
		ZIndex = 14,
		Parent = warning,
	})
	UIUtil.Label({
		Text = Locale.T("KEEP FINGERS CLEAR"),
		Font = Theme.Fonts.Title,
		TextColor3 = INK,
		Position = UDim2.fromOffset(4, 26),
		Size = UDim2.new(1, -8, 1, -30),
		MaxTextSize = 11,
		TextWrapped = true,
		ZIndex = 14,
		Parent = warning,
	})
	local consoleTitle = UIUtil.Label({
		Text = Locale.T("SAFETY"),
		Font = Theme.Fonts.Title,
		TextColor3 = rgb(220, 226, 236),
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(22, 7),
		Size = UDim2.new(1, -30, 0, 14),
		MaxTextSize = 11,
		ZIndex = 14,
		Parent = console,
	})

	-- Avec turbo : bouton champignon rouge + jauge de recharge
	local startGroup = box({ Name = "StartGroup", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 13, Visible = false, Parent = console })
	local buttonBase = box({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(CONSOLE_W / 2, 52), Size = UDim2.fromOffset(58, 58), BackgroundColor3 = rgb(30, 32, 40), ZIndex = 13, Parent = startGroup }, UDim.new(1, 0))
	UIUtil.Stroke(buttonBase, rgb(120, 126, 140), 1.5)
	local buttonSide = box({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(CONSOLE_W / 2, 54), Size = UDim2.fromOffset(48, 48), BackgroundColor3 = rgb(150, 16, 24), ZIndex = 14, Parent = startGroup }, UDim.new(1, 0))
	local startButton = Create("TextButton", {
		Name = "Start",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(CONSOLE_W / 2, 49),
		Size = UDim2.fromOffset(48, 48),
		BackgroundColor3 = RED,
		AutoButtonColor = false,
		Font = Enum.Font.LuckiestGuy,
		Text = "START",
		TextColor3 = WHITE,
		TextSize = 13,
		ZIndex = 15,
		Parent = startGroup,
	})
	UIUtil.Corner(startButton, UDim.new(1, 0))
	UIUtil.Stroke(startButton, rgb(120, 10, 18), 1.5)
	UIUtil.Gradient(startButton, seq(WHITE, rgb(200, 200, 200)), 90)
	local startTextStroke = UIUtil.Stroke(startButton, rgb(110, 0, 10), 1.2)
	startTextStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	box({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.08), Size = UDim2.fromScale(0.56, 0.22), BackgroundColor3 = WHITE, BackgroundTransparency = 0.55, ZIndex = 16, Parent = startButton }, UDim.new(1, 0))
	-- Jauge de recharge
	local chargeBack = box({ Position = UDim2.fromOffset(10, CONSOLE_H - 12), Size = UDim2.new(1, -20, 0, 5), BackgroundColor3 = rgb(24, 26, 32), ZIndex = 14, Parent = startGroup }, UDim.new(1, 0))
	local chargeFill = box({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.Colors.Green, ZIndex = 15, Parent = chargeBack }, UDim.new(1, 0))
	local startScale = Create("UIScale", { Parent = startButton })

	local function refreshStartVisibility()
		local owned = ctx.HasFeature("PressStart")
		startGroup.Visible = owned
		warning.Visible = not owned
		consoleTitle.Text = owned and Locale.T("TURBO") or Locale.T("SAFETY")
	end
	refreshStartVisibility()
	if ctx.State.FeaturesChanged then
		ctx.Connect(ctx.State.FeaturesChanged, refreshStartVisibility)
	end

	------------------------------------------------------------------
	-- Réserves réutilisées : particules, bouffées de vapeur, cris
	------------------------------------------------------------------
	-- Découpe SOUS l'en-tête : aucune particule / vapeur ne passe sur le titre,
	-- la pastille ou le compteur (le cadre n'est jamais tourné : la découpe
	-- de Roblox fonctionne). Les coordonnées restent celles de la machine.
	local fxClip = Create("Frame", { Name = "FXClip", Position = UDim2.fromOffset(0, HEADER_H), Size = UDim2.new(1, 0, 1, -HEADER_H), BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = Z.FX, Parent = rig })
	local fx = Create("Frame", { Name = "FX", Position = UDim2.fromOffset(0, -HEADER_H), Size = UDim2.new(1, 0, 1, HEADER_H), BackgroundTransparency = 1, ZIndex = 1, Parent = fxClip })
	-- Onde de choc + éclair d'impact (réutilisés)
	local impactFlash = box({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(MX, BELT_Y - 6), Size = UDim2.fromOffset(170, 44), BackgroundColor3 = rgb(255, 250, 220), BackgroundTransparency = 1, ZIndex = 1, Parent = fx }, UDim.new(1, 0))
	local shockRing = box({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(MX, BELT_Y), Size = UDim2.fromOffset(20, 6), BackgroundTransparency = 1, ZIndex = 2, Parent = fx }, UDim.new(1, 0))
	local shockStroke = UIUtil.Stroke(shockRing, WHITE, 3, 1)

	type Particle = {
		Frame: Frame,
		Corner: UICorner,
		Active: boolean,
		X: number,
		Y: number,
		VX: number,
		VY: number,
		Life: number,
		MaxLife: number,
		Size: number,
		Gravity: number,
		Spin: number,
		Streak: boolean,
	}
	local particles: { Particle } = {}
	local activeParticles = 0

	local function getParticle(): Particle?
		for _, particle in ipairs(particles) do
			if not particle.Active then
				return particle
			end
		end
		if #particles >= PARTICLE_MAX then
			return nil
		end
		local frame = box({ AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(4, 4), BackgroundColor3 = WHITE, Visible = false, ZIndex = 13, Parent = fx })
		local corner = UIUtil.Corner(frame, 2)
		local particle: Particle = {
			Frame = frame, Corner = corner, Active = false,
			X = 0, Y = 0, VX = 0, VY = 0, Life = 0, MaxLife = 1, Size = 4, Gravity = 0, Spin = 0, Streak = false,
		}
		table.insert(particles, particle)
		return particle
	end

	local function emit(x: number, y: number, vx: number, vy: number, size: number, color: Color3, life: number, gravity: number, round: boolean, streak: boolean?)
		local particle = getParticle()
		if not particle then
			return
		end
		particle.Active = true
		activeParticles += 1
		particle.X, particle.Y, particle.VX, particle.VY = x, y, vx, vy
		particle.Life, particle.MaxLife = life, life
		particle.Size = size
		particle.Gravity = gravity
		particle.Spin = random:NextNumber(-600, 600)
		particle.Streak = streak == true
		local frame = particle.Frame
		frame.BackgroundColor3 = color
		frame.BackgroundTransparency = 0
		frame.Rotation = random:NextNumber(0, 90)
		frame.Size = UDim2.fromOffset(size, size)
		particle.Corner.CornerRadius = round and UDim.new(1, 0) or UDim.new(0, 2)
		frame.Position = UDim2.fromOffset(x, y)
		frame.Visible = true
	end

	local function updateParticles(dt: number)
		if activeParticles <= 0 then
			return
		end
		for _, particle in ipairs(particles) do
			if particle.Active then
				particle.Life -= dt
				if particle.Life <= 0 then
					particle.Active = false
					activeParticles -= 1
					particle.Frame.Visible = false
				else
					particle.VY += particle.Gravity * dt
					particle.X += particle.VX * dt
					particle.Y += particle.VY * dt
					-- Collisions : les éclats rebondissent sur le tapis / le sol au
					-- lieu de traverser l'enclume ; ceux qui tombent dans le bac y
					-- disparaissent ; les bords de la carte les renvoient.
					if particle.Gravity > 0 then
						local ground = FLOOR_Y - particle.Size / 2
						if particle.X >= BELT_X0 and particle.X <= BELT_X1 then
							ground = BELT_Y - particle.Size / 2
						elseif particle.X < BIN_X + BIN_W / 2 + 4 then
							ground = BIN_TOP + 6
						end
						if particle.Y > ground and particle.VY > 0 then
							if particle.Streak or ground == BIN_TOP + 6 then
								particle.Life = math.min(particle.Life, 0.05)
							elseif particle.VY > 90 then
								particle.VY = -particle.VY * 0.32
								particle.VX *= 0.6
								particle.Spin *= 0.5
							else
								particle.VY = 0
								particle.VX *= 0.5
								particle.Spin = 0
								particle.Gravity = 0
								particle.Life = math.min(particle.Life, 0.35)
							end
							particle.Y = ground
						end
					end
					if (particle.X < 8 and particle.VX < 0) or (particle.X > 372 and particle.VX > 0) then
						particle.VX = -particle.VX * 0.4
					end
					local frame = particle.Frame
					frame.Position = UDim2.fromOffset(particle.X, particle.Y)
					local k = particle.Life / particle.MaxLife
					if particle.Streak then
						frame.Rotation = math.deg(math.atan2(particle.VY, particle.VX))
						frame.Size = UDim2.fromOffset(2 + particle.Size * k * 2.2, 2)
					else
						frame.Rotation += particle.Spin * dt
					end
					if k < 0.35 then
						frame.BackgroundTransparency = 1 - k / 0.35
					end
				end
			end
		end
	end

	type Puff = { Frame: Frame, Active: boolean, X: number, Y: number, DX: number, DY: number, Size: number, Life: number, MaxLife: number }
	local puffs: { Puff } = {}
	for _ = 1, PUFF_MAX do
		local frame = box({ AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(10, 10), BackgroundColor3 = WHITE, BackgroundTransparency = 1, Visible = false, ZIndex = 12, Parent = fx }, UDim.new(1, 0))
		table.insert(puffs, { Frame = frame, Active = false, X = 0, Y = 0, DX = 0, DY = 0, Size = 10, Life = 0, MaxLife = 1 })
	end
	local activePuffs = 0

	local function puff(x: number, y: number, size: number, dx: number, dy: number, color: Color3?)
		for _, p in ipairs(puffs) do
			if not p.Active then
				p.Active = true
				activePuffs += 1
				p.X, p.Y, p.DX, p.DY, p.Size = x, y, dx, dy, size
				p.Life, p.MaxLife = 0.75, 0.75
				p.Frame.BackgroundColor3 = color or WHITE
				p.Frame.Visible = true
				return
			end
		end
	end

	local function updatePuffs(dt: number)
		if activePuffs <= 0 then
			return
		end
		for _, p in ipairs(puffs) do
			if p.Active then
				p.Life -= dt
				if p.Life <= 0 then
					p.Active = false
					activePuffs -= 1
					p.Frame.Visible = false
				else
					local t = easeOut(1 - p.Life / p.MaxLife)
					local size = p.Size * (1 + 1.3 * t)
					p.Frame.Position = UDim2.fromOffset(p.X + p.DX * t, p.Y + p.DY * t)
					p.Frame.Size = UDim2.fromOffset(size, size)
					p.Frame.BackgroundTransparency = 0.3 + 0.7 * t
				end
			end
		end
	end

	-- Cris "CRUNCH!" (2 étiquettes utilisées à tour de rôle)
	type Shout = { Label: TextLabel, Stroke: UIStroke, Scale: UIScale, Life: number, Y: number, Peak: number }
	local shouts: { Shout } = {}
	for _ = 1, SHOUT_COUNT do
		local label = UIUtil.Label({
			Text = "",
			Font = Enum.Font.LuckiestGuy,
			TextColor3 = rgb(255, 220, 50),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(MX, 130),
			Size = UDim2.fromOffset(230, 40),
			MaxTextSize = 36,
			Visible = false,
			ZIndex = 20,
			Parent = card,
		})
		local stroke = UIUtil.Stroke(label, INK, 3.5)
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		-- Lettres "BD" : haut clair, bas plus foncé
		UIUtil.Gradient(label, seq(WHITE, rgb(255, 196, 150)), 90)
		local scale = Create("UIScale", { Parent = label })
		table.insert(shouts, { Label = label, Stroke = stroke, Scale = scale, Life = 0, Y = 130, Peak = 1.1 })
	end
	local shoutIndex = 0

	local bannerLife = 0 -- annonce de palier en cours : pas de cri par-dessus
	local function shout(text: string, color: Color3?, y: number?, banner: boolean?)
		if bannerLife > 0 and not banner then
			return
		end
		-- Un seul cri lisible à la fois : le précédent s'efface aussitôt
		for _, other in ipairs(shouts) do
			if other.Life > 0.12 then
				other.Life = 0.12
			end
		end
		if banner then
			bannerLife = 1
		end
		shoutIndex = shoutIndex % SHOUT_COUNT + 1
		local s = shouts[shoutIndex]
		local long = (utf8.len(text) or #text) > 12
		s.Y = y or 128
		s.Life = 1
		-- Les phrases longues grossissent moins : elles restent entre le
		-- réservoir et le pupitre
		local length = utf8.len(text) or #text
		s.Peak = long and 0.92 or (length > 8 and 1 or 1.1)
		local label = s.Label
		label.Text = text
		label.TextColor3 = color or rgb(255, 220, 50)
		label.Size = UDim2.fromOffset(long and 236 or 210, long and 28 or 40)
		local constraint = label:FindFirstChildOfClass("UITextSizeConstraint")
		if constraint then
			constraint.MaxTextSize = long and 22 or 36
		end
		label.Rotation = random:NextNumber(-8, 8)
		label.Position = UDim2.fromOffset(MX, s.Y)
		label.TextTransparency = 0
		s.Stroke.Transparency = 0
		s.Scale.Scale = 0.3
		label.Visible = true
	end

	local function updateShouts(dt: number)
		if bannerLife > 0 then
			bannerLife -= dt
		end
		for _, s in ipairs(shouts) do
			if s.Life > 0 then
				s.Life -= dt
				local age = 1 - s.Life
				if s.Life <= 0 then
					s.Label.Visible = false
				else
					-- Apparition "coup de poing" (dépasse puis se pose, en tremblant)
					-- puis montée en fondu
					if age < 0.12 then
						s.Scale.Scale = 0.3 + easeOutBack(age / 0.12) * (s.Peak * 1.23 - 0.3)
					elseif age < 0.3 then
						s.Scale.Scale = s.Peak * (1.23 - 0.23 * easeOut((age - 0.12) / 0.18))
					else
						s.Scale.Scale = s.Peak
					end
					if age < 0.3 then
						local jitter = (0.3 - age) * 8
						s.Label.Position = UDim2.fromOffset(MX + random:NextNumber(-jitter, jitter), s.Y + random:NextNumber(-jitter, jitter))
					elseif age > 0.55 then
						local k = (age - 0.55) / 0.45
						s.Label.Position = UDim2.fromOffset(MX, s.Y - 26 * k)
						s.Label.TextTransparency = k
						s.Stroke.Transparency = k
					end
				end
			end
		end
	end

	------------------------------------------------------------------
	-- Paliers : couleurs + décors
	------------------------------------------------------------------
	local tierIndex = 0
	local shownLevel = 0
	local tierAnim = {
		Twinkles = {} :: { TextLabel },
		Beacon = nil :: Frame?,
		BeaconBeam = nil :: Frame?,
		Shine = nil :: Frame?,
		Glow = nil :: Frame?,
		Digital = nil :: TextLabel?,
		DigitalValue = -1,
		SteamTimer = 1,
		NeonStrokes = {} :: { UIStroke },
	}

	-- Un rivet / une gemme de la traverse tomberait-il sur le panneau des manomètres ?
	local function onGaugePanel(x: number): boolean
		local left = CROWN_X + GAUGE_PANEL_X
		return x > left - 5 and x < left + GAUGE_PANEL_W + 5
	end

	-- Gemme taillée (carré tourné à 45°)
	local function gem(parent: Instance, x: number, y: number, size: number, color: Color3, rim: Color3): UIStroke
		local g = box({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(size, size), Rotation = 45, BackgroundColor3 = color, ZIndex = 2, Parent = parent }, 2)
		UIUtil.Gradient(g, seq(lighter(color, 0.6), color, darker(color, 0.25)), 45)
		local stroke = UIUtil.Stroke(g, rim, 1.5)
		box({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.35, 0.35), Size = UDim2.fromScale(0.3, 0.3), BackgroundColor3 = WHITE, BackgroundTransparency = 0.2, ZIndex = 3, Parent = g }, 1)
		return stroke
	end

	-- Chaque décor va dans le calque de la pièce qu'il habille : sur les
	-- colonnes (sous le plateau et les objets), sur la traverse, sur l'enclume,
	-- ou au mur (derrière toute la machine). Plus rien ne "perce" un objet.
	local function buildDecor(index: number)
		local style = TIERS[index]
		decorBack:ClearAllChildren()
		decorPillar:ClearAllChildren()
		decorCrown:ClearAllChildren()
		decorBolster:ClearAllChildren()
		if tierAnim.Shine then
			tierAnim.Shine:Destroy()
		end
		tierAnim.Twinkles = {}
		tierAnim.Beacon = nil
		tierAnim.BeaconBeam = nil
		tierAnim.Shine = nil
		tierAnim.Glow = nil
		tierAnim.Digital = nil
		tierAnim.DigitalValue = -1
		tierAnim.NeonStrokes = {}

		if style.Wood then
			-- Veinage du bois sur les colonnes
			for _, x in ipairs(PILLAR_X) do
				for _, gx in ipairs({ 5, 11 }) do
					box({ Position = UDim2.fromOffset(x + gx, CROWN_Y + 30), Size = UDim2.fromOffset(1, FLOOR_Y - CROWN_Y - 50), BackgroundColor3 = darker(style.Frame, 0.3), BackgroundTransparency = 0.5, ZIndex = 1, Parent = decorPillar })
				end
			end
		end
		if style.Rope then
			-- Cordes enroulées sur les colonnes
			for _, x in ipairs(PILLAR_X) do
				for _, y in ipairs({ 118, 184 }) do
					local rope = box({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(x + PILLAR_W / 2, y), Size = UDim2.fromOffset(PILLAR_W + 6, 10), BackgroundColor3 = WHITE, ZIndex = 2, Parent = decorPillar }, 3)
					UIUtil.Gradient(rope, stripes(7, rgb(232, 204, 146), rgb(184, 146, 90)), 60)
				end
			end
			for _, x in ipairs({ MX - 104, MX - 60, MX + 60, MX + 104 }) do
				if not onGaugePanel(x) then
					dot(decorCrown, x, CROWN_Y + 4, 4, style.Bolt, 3)
				end
			end
		end
		if style.Bands then
			-- Ferrures sur les colonnes
			for _, x in ipairs(PILLAR_X) do
				for _, y in ipairs({ 118, 160, 198 }) do
					local band = box({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(x + PILLAR_W / 2, y), Size = UDim2.fromOffset(PILLAR_W + 4, 7), BackgroundColor3 = WHITE, ZIndex = 2, Parent = decorPillar }, 1)
					UIUtil.Gradient(band, beamSeq(rgb(84, 86, 96)), 90)
					dot(band, (PILLAR_W + 4) / 2, 3.5, 3, rgb(170, 174, 184), 3)
				end
			end
		end
		if style.Rivets then
			for i = 0, 8 do
				local x = MX - 104 + i * 26
				if not onGaugePanel(x) then
					dot(decorCrown, x, CROWN_Y + 4, 3, style.Bolt, 3)
					dot(decorCrown, x, CROWN_Y + CROWN_H - 4, 3, style.Bolt, 3)
				end
			end
		end
		if style.Beacon then
			-- Gyrophare posé SUR la traverse (bout droit)
			local bx = CROWN_X + CROWN_W - 16
			local baseColor = style.Neon and rgb(255, 60, 200) or rgb(255, 150, 20)
			local beam = box({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(bx, CROWN_Y - 8), Size = UDim2.fromOffset(34, 6), BackgroundColor3 = baseColor, BackgroundTransparency = 0.5, ZIndex = 1, Parent = decorCrown }, UDim.new(1, 0))
			box({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromOffset(bx, CROWN_Y + 1), Size = UDim2.fromOffset(16, 4), BackgroundColor3 = rgb(50, 52, 60), ZIndex = 2, Parent = decorCrown }, 1)
			local beacon = box({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromOffset(bx, CROWN_Y - 2), Size = UDim2.fromOffset(13, 11), BackgroundColor3 = baseColor, ZIndex = 3, Parent = decorCrown }, 5)
			UIUtil.Gradient(beacon, seq(WHITE, rgb(210, 210, 210)), 90)
			UIUtil.Stroke(beacon, darker(baseColor, 0.45), 1)
			tierAnim.Beacon = beacon
			tierAnim.BeaconBeam = beam
		end
		if style.Digital then
			-- Afficheur numérique de pression (gauche de la traverse)
			local screen = box({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(CROWN_X + 34, CROWN_Y + CROWN_H / 2), Size = UDim2.fromOffset(44, 14), BackgroundColor3 = rgb(10, 16, 12), ZIndex = 4, Parent = decorCrown }, 3)
			UIUtil.Stroke(screen, rgb(120, 130, 140), 1)
			tierAnim.Digital = Create("TextLabel", {
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Font = Theme.Fonts.Mono,
				Text = "0000",
				TextColor3 = rgb(80, 255, 140),
				TextSize = 11,
				ZIndex = 5,
				Parent = screen,
			})
		end
		if style.Shine then
			-- Reflet qui passe sur la traverse (découpé par la traverse)
			local shineFrame = box({ Position = UDim2.fromOffset(-40, 3), Size = UDim2.new(0, 34, 1, -6), BackgroundColor3 = WHITE, ZIndex = 8, Parent = crown })
			local gradient = UIUtil.Gradient(shineFrame, ColorSequence.new(WHITE), 20)
			gradient.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.5, 0.3),
				NumberSequenceKeypoint.new(1, 1),
			})
			tierAnim.Shine = shineFrame
		end
		if style.Sparkle then
			-- Étincelles AU MUR (derrière la machine et les objets)
			for _, pos in ipairs({ Vector2.new(50, 184), Vector2.new(MX - 46, 118), Vector2.new(MX + 46, 138), Vector2.new(286, 144), Vector2.new(MX + 58, 40) }) do
				local star = UIUtil.Label({
					Text = "✨",
					Font = Theme.Fonts.Title,
					TextColor3 = style.Sparkle,
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromOffset(pos.X, pos.Y),
					Size = UDim2.fromOffset(16, 16),
					MaxTextSize = 16,
					ZIndex = 2,
					Parent = decorBack,
				})
				table.insert(tierAnim.Twinkles, star)
			end
		end
		if style.Gems then
			-- Rubis sur la traverse et l'enclume
			for _, x in ipairs({ MX - 90, MX - 30, MX + 30 }) do
				gem(decorCrown, x, CROWN_Y + CROWN_H / 2, 10, rgb(220, 20, 60), rgb(255, 220, 120))
			end
			for _, x in ipairs({ MX - 70, MX + 70 }) do
				gem(decorBolster, x, FLOOR_Y - 9, 9, rgb(220, 20, 60), rgb(255, 220, 120))
			end
		end
		if style.Crystal then
			-- Diamants sertis (traverse + enclume) et amas de cristaux sur la traverse
			local rim = style.Neon and style.Outline or WHITE
			for _, x in ipairs({ MX - 90, MX - 30, MX + 30 }) do
				local stroke = gem(decorCrown, x, CROWN_Y + CROWN_H / 2, 10, rgb(150, 225, 255), rim)
				if style.Neon then
					table.insert(tierAnim.NeonStrokes, stroke)
				end
			end
			for _, x in ipairs({ MX - 70, MX + 70 }) do
				gem(decorBolster, x, FLOOR_Y - 9, 9, rgb(150, 225, 255), rim)
			end
			for j, spec in ipairs({ { -9, 12, -22 }, { 0, 19, 0 }, { 9, 13, 22 } }) do
				local shard = box({
					AnchorPoint = Vector2.new(0.5, 1),
					Position = UDim2.fromOffset(MX + 58 + spec[1], CROWN_Y + 2),
					Size = UDim2.fromOffset(8, spec[2]),
					Rotation = spec[3],
					BackgroundColor3 = rgb(180, 240, 255),
					BackgroundTransparency = 0.05,
					ZIndex = 1 + j % 2,
					Parent = decorCrown,
				}, 3)
				UIUtil.Gradient(shard, seq(WHITE, rgb(120, 200, 255)), 90)
				local stroke = UIUtil.Stroke(shard, rim, 1, 0.2)
				if style.Neon then
					table.insert(tierAnim.NeonStrokes, stroke)
				end
			end
		end
		if style.Neon then
			-- Lueur sous l'enclume
			tierAnim.Glow = box({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(MX, FLOOR_Y), Size = UDim2.fromOffset(230, 12), BackgroundColor3 = rgb(0, 230, 255), BackgroundTransparency = 0.5, ZIndex = 1, Parent = decorBack }, UDim.new(1, 0))
		end
	end

	local function applyTier(index: number)
		local style = TIERS[index]
		card.BackgroundColor3 = style.Floor
		local footTop = style.WallTop:Lerp(style.WallBottom, (FLOOR_Y - 20) / FLOOR_Y)
		wallGradient.Color = seq(style.WallTop, style.WallBottom)
		wallFootGradient.Color = seq(footTop, style.WallBottom)
		cardStroke.Color = style.CardStroke
		for _, seam in ipairs(seams) do
			seam.BackgroundColor3 = style.Seam
		end
		floorGrid.Visible = style.Neon == true
		if style.Neon then
			floorTapeStripes.SetColors(rgb(0, 230, 255), rgb(255, 60, 200))
		else
			floorTapeStripes.SetColors(rgb(255, 200, 30), INK)
		end
		titleLabel.TextColor3 = style.Title
		counterLabel.TextColor3 = style.Title
		speedLabel.TextColor3 = style.Dark and rgb(255, 190, 90) or Theme.Colors.Orange

		local outlineT = style.Neon and 0 or 0.3
		local outlineW = style.Neon and 2 or 1
		for _, pillar in ipairs(pillars) do
			pillar.Gradient.Color = style.Wood and stripes(5, lighter(style.Frame, 0.12), darker(style.Frame, 0.1)) or cylinderSeq(style.Frame)
			pillar.Gradient.Rotation = 0
			pillar.Stroke.Color = style.Outline
			pillar.Stroke.Thickness = outlineW
			pillar.Stroke.Transparency = outlineT
		end
		for _, gradient in ipairs(feetGradients) do
			gradient.Color = beamSeq(style.Frame)
		end
		housingGradient.Color = cylinderSeq(style.Frame)
		housingStroke.Color = style.Outline
		capGradient.Color = beamSeq(darker(style.Frame, 0.1))
		crownGradient.Color = style.Wood and stripes(6, lighter(style.Frame, 0.1), darker(style.Frame, 0.08)) or beamSeq(style.Frame)
		crownGradient.Rotation = 90
		crownStroke.Color = style.Outline
		crownStroke.Thickness = style.Neon and 2.5 or 2
		crownStripes.SetColors(style.AccentA, style.AccentB)
		rodGradient.Color = cylinderSeq(style.Chrome)
		glandGradient.Color = beamSeq(darker(style.Frame, 0.15))
		plateGradient.Color = beamSeq(style.Frame)
		plateStroke.Color = style.Outline
		plateStroke.Thickness = style.Neon and 2 or 1.5
		plateStripes.SetColors(style.AccentA, style.AccentB)
		for _, gradient in ipairs(guideGradients) do
			gradient.Color = beamSeq(darker(style.Frame, 0.12))
		end
		die.BackgroundColor3 = darker(style.Frame, 0.55)
		bolsterGradient.Color = beamSeq(darker(style.Frame, 0.05))
		bolsterStroke.Color = style.Outline
		bolsterStripes.SetColors(style.AccentA, style.AccentB)
		motorGradient.Color = stripes(8, lighter(style.Frame, 0.1), darker(style.Frame, 0.25))
		motorStroke.Color = style.Outline
		tankGradient.Color = cylinderSeq(darker(style.Frame, 0.05))
		tankStroke.Color = style.Outline
		for _, segment in ipairs(hoseSegments) do
			segment.BackgroundColor3 = style.Hose
		end
		for _, fitting in ipairs(fittings) do
			fitting.BackgroundColor3 = style.Fitting
		end
		gauge2.Visible = style.Gauge2 == true
		panelLamp.Visible = style.Gauge2 ~= true
		mainBezel.Color = style.Neon and style.Outline or INK
		gaugePanelStroke.Color = style.Neon and style.Outline or INK
		gaugePanelStroke.Transparency = style.Neon and 0 or 0.3
		consoleStroke.Color = style.Neon and style.Outline or INK
		tierChip.BackgroundColor3 = style.Chip
		tierChipLabel.TextColor3 = style.ChipText
		tierChipStroke.Color = style.Dark and style.Chip or WHITE
		buildDecor(index)
		if style.Neon then
			for _, pillar in ipairs(pillars) do
				table.insert(tierAnim.NeonStrokes, pillar.Stroke)
			end
			table.insert(tierAnim.NeonStrokes, crownStroke)
			table.insert(tierAnim.NeonStrokes, plateStroke)
			table.insert(tierAnim.NeonStrokes, bolsterStroke)
			table.insert(tierAnim.NeonStrokes, housingStroke)
		end
	end

	-- Petit flash blanc sur toute la carte (changement de palier)
	local function flashCard()
		local flash = box({
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.2,
			ZIndex = 40,
			Parent = card,
		}, 18)
		UIUtil.Tween(flash, 0.6, { BackgroundTransparency = 1 })
		Debris:AddItem(flash, 0.65)
	end

	local function refreshLevel(celebrate: boolean)
		local level = currentLevel()
		if level == shownLevel then
			return
		end
		local newTier = tierForLevel(level)
		local tierChanged = newTier ~= tierIndex
		shownLevel = level
		tierIndex = newTier
		local style = TIERS[newTier]
		levelBadgeLabel.Text = style.Icon
		tierChipLabel.Text = Locale.T("Lv. %s", tostring(level)) .. " · " .. Locale.Pick(style.Name)
		if tierChanged then
			applyTier(newTier)
		end
		if celebrate then
			tierChipScale.Scale = 1.35
			UIUtil.Tween(tierChipScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
			if tierChanged then
				flashCard()
				ctx.Sound.Play("Buy", 1.1)
				if effectsOn() then
					for _ = 1, 18 do
						local angle = random:NextNumber(0, math.pi * 2)
						local speed = random:NextNumber(80, 200)
						emit(MX, 130, math.cos(angle) * speed, math.sin(angle) * speed - 60, random:NextInteger(4, 7), pickFrom({ style.Chip, style.AccentA, WHITE }, random), random:NextNumber(0.6, 1), 260, false)
					end
				end
				shout(style.Icon .. " " .. Locale.Pick(style.Shout), rgb(255, 226, 70), 124, true)
			end
		end
	end

	------------------------------------------------------------------
	-- Objets : construction
	------------------------------------------------------------------
	local kit: Kit = {
		Part = function(parent, x, y, w, h, color, z, radius, transparency)
			local frame = box({
				Position = UDim2.fromScale(x, y),
				Size = UDim2.fromScale(w, h),
				BackgroundColor3 = color,
				BackgroundTransparency = transparency or 0,
				ZIndex = z or 2,
				Parent = parent,
			})
			if radius then
				UIUtil.Corner(frame, radius)
			end
			return frame
		end,
		Gradient = function(frame, color, rotation)
			return UIUtil.Gradient(frame, color, rotation or 0)
		end,
		Stroke = function(frame, color, thickness, transparency)
			return UIUtil.Stroke(frame, color, thickness or 1, transparency or 0)
		end,
		Random = random,
	}

	type Entry = {
		Holder: Frame,
		W: number,
		H: number,
		X: number,
		Words: Words,
		Colors: { Color3 },
		Main: Color3,
		Special: string?,
		Wobble: number,
		Built: Built?,
		Label: TextLabel?,
		Splat: Frame?,
		Icon: string?,
		NoPile: boolean?,
		Regrow: boolean?,
		Puddle: Frame?,
		Dropped: boolean?,
	}

	local lastKind = ""

	local function newEntry(x: number): Entry
		local style = TIERS[math.max(1, tierIndex)]
		local roll = random:NextNumber()
		local drawn: Drawn? = nil
		local emoji: EmojiItem? = nil
		for _ = 1, 3 do
			roll = random:NextNumber()
			drawn, emoji = nil, nil
			if roll < 0.22 and #style.Drawn > 0 then
				drawn = DRAWN[pickFrom(style.Drawn, random)]
			elseif roll < 0.36 and #style.Emoji > 0 then
				emoji = pickFrom(style.Emoji, random)
			elseif roll < 0.86 then
				local target = random:NextNumber() * GENERAL_WEIGHT
				for _, def in ipairs(GENERAL) do
					target -= def.Weight
					if target <= 0 then
						drawn = def
						break
					end
				end
				drawn = drawn or GENERAL[1]
			else
				emoji = pickFrom(EMOJI_ITEMS, random)
			end
			local kind = drawn and drawn.Id or (emoji and emoji.Icon) or ""
			if kind ~= lastKind then
				lastKind = kind
				break
			end
		end

		local holder = box({
			Name = "Item",
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromOffset(x, BELT_Y),
			Size = UDim2.fromOffset(60, 60),
			BackgroundTransparency = 1,
			ZIndex = Z.Item,
			Parent = rig,
		})
		-- Flaque (jus, peinture...) qui apparaît sous la galette au CRUNCH
		local function addPuddle(color: Color3): Frame
			local puddle = box({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 2), Size = UDim2.new(1.3, 0, 0, 6), BackgroundColor3 = color, BackgroundTransparency = 0.1, Visible = false, ZIndex = 1, Parent = holder }, PILL)
			UIUtil.Gradient(puddle, seq(lighter(color, 0.3), darker(color, 0.2)), 90)
			return puddle
		end
		if drawn then
			local w, h = math.floor(drawn.W * ITEM_SCALE + 0.5), math.floor(drawn.H * ITEM_SCALE + 0.5)
			holder.Size = UDim2.fromOffset(w, h)
			local built = drawn.Build(kit, holder)
			return {
				Holder = holder, W = w, H = h, X = x, Words = drawn.Words,
				Colors = built.Colors, Main = built.Main, Special = drawn.Special, Wobble = drawn.Wobble or 1.5, Built = built,
				Puddle = (drawn.Juice or drawn.Id == "Jelly" or drawn.Id == "Paint") and addPuddle(drawn.Juice or built.Main) or nil,
			}
		end
		local item = emoji or EMOJI_ITEMS[1]
		local size = math.floor(58 * ITEM_SCALE + 0.5)
		holder.Size = UDim2.fromOffset(size, size)
		local label = UIUtil.Label({ Text = item.Icon, Size = UDim2.fromScale(1, 1), MaxTextSize = 64, ZIndex = 3, Parent = holder })
		local splat = box({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = item.Color, Visible = false, ZIndex = 2, Parent = holder }, PILL)
		UIUtil.Stroke(splat, darker(item.Color, 0.35), 1.5)
		UIUtil.Gradient(splat, SHADE_V, 90)
		return {
			Holder = holder, W = size, H = size, X = x, Words = item.Words,
			Colors = { item.Color, lighter(item.Color, 0.35) }, Main = item.Color, Wobble = 1.5,
			Label = label, Splat = splat, Icon = item.Icon, Puddle = addPuddle(item.Color),
		}
	end

	local function placeEntry(entry: Entry, x: number)
		entry.X = x
		entry.Holder.Position = UDim2.fromOffset(x, BELT_Y)
	end

	------------------------------------------------------------------
	-- Bac : la galette tombe dedans
	------------------------------------------------------------------
	local binCount = 0
	local function dropIntoBin(entry: Entry)
		local holder = entry.Holder
		if entry.NoPile or not holder.Parent then
			holder:Destroy()
			return
		end
		-- Chute : devant le fond du bac, DERRIÈRE sa face (Z.Item < Z.BinFront)
		UIUtil.Tween(holder, 0.35, {
			Position = UDim2.fromOffset(BIN_X, BIN_TOP + 26),
			Size = UDim2.fromOffset(BIN_W - 10, 7),
			Rotation = random:NextNumber(-25, 25),
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(0.36, function()
			holder:Destroy()
			if not ctx.IsAlive() then
				return
			end
			binCount += 1
			local level = binCount % 6
			binFill.BackgroundColor3 = darker(entry.Main, 0.1)
			binFill.Size = UDim2.fromOffset(BIN_W - 12, level * 2 + (level > 0 and 4 or 0))
			binScale.Scale = 1.06
			UIUtil.Tween(binScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
			if effectsOn() then
				puff(BIN_X, BIN_TOP + 4, 10, 0, -14, rgb(230, 230, 230))
			end
			if level == 0 then
				-- Bac plein : il tasse tout d'un coup
				binFill.Size = UDim2.fromOffset(BIN_W - 12, 16)
				UIUtil.Tween(binFill, 0.4, { Size = UDim2.fromOffset(BIN_W - 12, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			end
		end)
	end

	------------------------------------------------------------------
	-- Effets du CRUNCH
	------------------------------------------------------------------
	local shakeTime = 0
	local shakePower = 1

	-- Éclats projetés SUR LES CÔTÉS depuis la fente plateau / tapis (ils
	-- retombent et rebondissent sur le tapis, voir updateParticles)
	local function crumbs(colors: { Color3 }, count: number, halfWidth: number)
		for i = 1, count do
			local color = colors[random:NextInteger(1, #colors)]
			if random:NextNumber() < 0.15 then
				color = WHITE
			end
			local dir = i % 2 == 0 and -1 or 1
			emit(MX + dir * random:NextNumber(halfWidth * 0.6, halfWidth + 4), BELT_Y - random:NextNumber(3, 9), dir * random:NextNumber(70, 250), -random:NextNumber(60, 240), random:NextInteger(4, 8), color, random:NextNumber(0.7, 1.1), 700, random:NextNumber() < 0.4)
		end
	end

	local function sparks(colors: { Color3 }, count: number, halfWidth: number)
		for i = 1, count do
			local dir = i % 2 == 0 and -1 or 1
			local angle = dir > 0 and random:NextNumber(-0.75, -0.1) or random:NextNumber(-math.pi + 0.1, -math.pi + 0.75)
			local speed = random:NextNumber(170, 330)
			emit(MX + dir * (halfWidth + 2), BELT_Y - 4, math.cos(angle) * speed, math.sin(angle) * speed, 5, colors[random:NextInteger(1, #colors)], random:NextNumber(0.25, 0.45), 320, false, true)
		end
	end

	local function shockwave(color: Color3)
		shockRing.Size = UDim2.fromOffset(40, 8)
		shockStroke.Color = color
		shockStroke.Transparency = 0
		UIUtil.Tween(shockRing, 0.35, { Size = UDim2.fromOffset(300, 36) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		UIUtil.Tween(shockStroke, 0.35, { Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		impactFlash.BackgroundTransparency = 0.25
		UIUtil.Tween(impactFlash, 0.25, { BackgroundTransparency = 1 })
	end

	-- Éclat "BD" : étoile + rayons derrière la machine (animé dans OnRender)
	local BURST_LIFE = 0.5
	local burstLife = 0
	local function startBurst(starColor: Color3, rayColor: Color3)
		burstLife = BURST_LIFE
		for _, star in ipairs(burstStars) do
			star.BackgroundColor3 = starColor
			star.BackgroundTransparency = 0.05
		end
		for _, stroke in ipairs(burstStrokes) do
			stroke.Color = darker(starColor, 0.25)
			stroke.Transparency = 0.2
		end
		for i, ray in ipairs(burstRays) do
			ray.BackgroundColor3 = i % 2 == 1 and rayColor or starColor
			ray.BackgroundTransparency = 0
		end
		burstScale.Scale = 0.35
		burst.Rotation = random:NextNumber(-12, 12)
		burst.Visible = true
	end

	local function updateBurst(dt: number)
		if burstLife <= 0 then
			return
		end
		burstLife -= dt
		if burstLife <= 0 then
			burst.Visible = false
			return
		end
		local age = 1 - burstLife / BURST_LIFE
		burstScale.Scale = 0.35 + 0.85 * easeOut(math.min(1, age * 2.2))
		local fade = age < 0.45 and 0 or (age - 0.45) / 0.55
		for _, star in ipairs(burstStars) do
			star.BackgroundTransparency = 0.05 + 0.95 * fade
		end
		for _, stroke in ipairs(burstStrokes) do
			stroke.Transparency = 0.2 + 0.8 * fade
		end
		for _, ray in ipairs(burstRays) do
			ray.BackgroundTransparency = fade
		end
	end

	------------------------------------------------------------------
	-- Cycle de la presse (machine à états, pilotée par OnRender)
	------------------------------------------------------------------
	local phase = "Idle"
	local phaseTime = 0
	local phaseDuration = 0
	local queue: { Entry } = {}
	local current: Entry? = nil -- objet sous la presse
	local outgoing: Entry? = nil -- galette qui repart sur le tapis
	local plateY = PLATE_TOP
	local phaseStartPlate = PLATE_TOP
	local squeezeDepth = 0
	local turbo = false
	local pendingTurbo = false
	local crushed = 0
	local pressure = 0
	local cooldownEnd = 0
	local shownCooldown = ""
	local beltOffset = 0
	local beltBase = 0
	local factor = 1
	type Mover = { Entry: Entry, From: number, To: number }
	local movers: { Mover } = {}

	local function setPhase(name: string)
		phase = name
		phaseTime = 0
		phaseStartPlate = plateY
		local speedMul = factor
		if turbo and (name == "Descend" or name == "Squeeze") then
			speedMul *= 4
		end
		phaseDuration = (DURATIONS[name] or 0.5) / speedMul
	end

	-- Le tapis avance d'un pas (SPACING) : la galette part vers le bac,
	-- l'objet en attente passe sous la presse, un nouvel objet entre par la
	-- droite de la carte (jamais par le haut : il passait derrière le pupitre)
	local function loadNext()
		factor = speedFactor()
		speedLabel.Text = "⚡ x" .. (math.floor(factor * 10 + 0.5) / 10)
		table.clear(movers)
		if outgoing then
			table.insert(movers, { Entry = outgoing, From = MX, To = MX - SPACING })
		end
		while #queue < #SLOT_X do
			table.insert(queue, newEntry(SLOT_X[#queue + 1]))
		end
		current = table.remove(queue, 1)
		if current then
			table.insert(movers, { Entry = current, From = current.X, To = MX })
		end
		local incoming = newEntry(ENTRY_X)
		table.insert(queue, incoming)
		for i, entry in ipairs(queue) do
			table.insert(movers, { Entry = entry, From = entry.X, To = SLOT_X[i] })
		end
		beltBase = beltOffset
		setPhase("Load")
	end

	-- La galette arrive au bout du tapis : elle bascule dans le bac
	local function checkOutgoing()
		local entry = outgoing
		if entry and not entry.Dropped and entry.X <= BELT_X0 + 4 then
			entry.Dropped = true
			dropIntoBin(entry)
		end
	end

	local function finishLoad()
		for _, mover in ipairs(movers) do
			if not mover.Entry.Dropped then
				placeEntry(mover.Entry, mover.To)
			end
		end
		table.clear(movers)
		checkOutgoing()
		outgoing = nil
	end

	local function itemHeight(): number
		if current then
			return current.Holder.Size.Y.Offset
		end
		return 0
	end

	-- Le moment CRUNCH
	local function onCrunch()
		local entry = current
		if not entry then
			return
		end
		local effects = effectsOn()
		local style = TIERS[math.max(1, tierIndex)]
		crushed += 1
		counterLabel.Text = "💥 " .. crushed
		counterScale.Scale = 1.35
		UIUtil.Tween(counterScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		ctx.Sound.Play("Crush", random:NextNumber(0.85, 1.15) * (turbo and 0.85 or 1))

		-- Secousse de la machine (plus forte aux paliers élevés et en turbo)
		shakeTime = turbo and 0.42 or 0.3
		shakePower = 1.2 + (tierIndex - 1) * 0.06 + (turbo and 0.4 or 0)
		local halfWidth = entry.W * 0.8

		local words = Locale.Pick(entry.Words)
		local word = words[random:NextInteger(1, #words)]
		if turbo then
			word = "TURBO " .. word
		end
		shout(word, turbo and rgb(255, 90, 60) or nil, nil)

		plateFlash.BackgroundTransparency = 0.15
		UIUtil.Tween(plateFlash, 0.3, { BackgroundTransparency = 1 })
		shockwave(style.Neon and rgb(0, 230, 255) or WHITE)
		-- Grand éclat BD derrière la presse (couleurs du palier)
		startBurst(style.Sparkle or rgb(255, 214, 60), style.Dark and style.Chip or rgb(255, 140, 40))
		if entry.Puddle then
			entry.Puddle.Visible = true
		end

		local debrisColors = table.clone(entry.Colors)
		for _, color in ipairs(style.Debris) do
			table.insert(debrisColors, color)
		end
		crumbs(debrisColors, effects and (turbo and 20 or 14) or 4, halfWidth)
		if effects then
			-- Poussière au ras du tapis + vapeur du vérin
			for _, dir in ipairs({ -1, 1 }) do
				puff(MX + dir * (halfWidth + 6), BELT_Y - 6, 13, dir * 52, -14, style.Dark and rgb(170, 170, 190) or rgb(236, 236, 240))
			end
			if style.Steam or style.Neon then
				puff(MX + 34, CYL_Y + 8, 10, 26, -18)
				puff(MX - 34, CYL_Y + 8, 10, -26, -18)
			end
			if style.Sparkle then
				sparks({ style.Sparkle, WHITE }, style.Neon and 14 or 9, halfWidth)
			elseif turbo or tierIndex >= 3 then
				sparks({ rgb(255, 200, 60), rgb(255, 250, 200) }, turbo and 8 or 4, halfWidth)
			end
		end

		if entry.Label then
			entry.Label.Visible = false
			if entry.Splat then
				entry.Splat.Visible = true
			end
			if effects then
				-- Morceaux de l'emoji qui s'envolent
				for _ = 1, 2 do
					local bit = UIUtil.Label({
						Text = entry.Icon or "",
						AnchorPoint = Vector2.new(0.5, 0.5),
						Position = UDim2.fromOffset(MX, BELT_Y - 8),
						Size = UDim2.fromOffset(20, 20),
						MaxTextSize = 20,
						ZIndex = 12,
						Parent = fx,
					})
					UIUtil.Tween(bit, 0.55, {
						Position = UDim2.fromOffset(MX + random:NextNumber(-110, 110), BELT_Y - random:NextNumber(40, 90)),
						Rotation = random:NextNumber(-360, 360),
						TextTransparency = 1,
					}, Enum.EasingStyle.Quad)
					Debris:AddItem(bit, 0.6)
				end
			end
		end
		local built = entry.Built
		if built and built.Fillings then
			-- Macarons : la crème déborde
			for _, filling in ipairs(built.Fillings) do
				UIUtil.Tween(filling, 0.15, { Size = UDim2.fromScale(1.14, 0.3) }, Enum.EasingStyle.Back)
			end
		end
		if entry.Special == "Melon" and built and built.Body then
			-- Pastèque : l'intérieur rouge apparaît
			if built.Gradient then
				built.Gradient.Enabled = false
			end
			built.Body.BackgroundColor3 = rgb(236, 60, 72)
			if built.Stroke then
				built.Stroke.Color = rgb(40, 132, 48)
				built.Stroke.Thickness = 3
			end
			if effects then
				crumbs({ rgb(30, 30, 30), rgb(255, 90, 100) }, 6, halfWidth)
			end
		elseif entry.Special == "Pop" then
			entry.Holder.Visible = false
			entry.NoPile = true
			if effects then
				for _ = 1, 14 do
					local dir = random:NextNumber() < 0.5 and -1 or 1
					emit(MX + dir * random:NextNumber(10, halfWidth), BELT_Y - 8, dir * random:NextNumber(60, 220), -random:NextNumber(80, 260), 5, pickFrom(entry.Colors, random), random:NextNumber(0.7, 1.1), 420, false)
				end
			end
		elseif entry.Special == "Paint" and effects then
			for _ = 1, 10 do
				local dir = random:NextNumber() < 0.5 and -1 or 1
				emit(MX + dir * random:NextNumber(halfWidth * 0.5, halfWidth), BELT_Y - 6, dir * random:NextNumber(80, 240), -random:NextNumber(40, 200), random:NextInteger(5, 9), entry.Main, random:NextNumber(0.6, 0.9), 600, true)
			end
		end
	end

	local function onRise()
		local entry = current
		current = nil
		if not entry then
			return
		end
		if entry.Special == "Sponge" then
			-- L'éponge reprend sa forme en SUIVANT le plateau (elle ne passe
			-- jamais derrière lui), voir la phase "Rise"... puis repart quand même
			entry.Regrow = true
			shout(Locale.T("...and it's back"), rgb(120, 220, 255), 98)
		end
		outgoing = entry
	end

	------------------------------------------------------------------
	-- Bouton START : écrasement manuel
	------------------------------------------------------------------
	ctx.Connect(startButton.MouseButton1Down, function()
		startButton.Position = UDim2.fromOffset(CONSOLE_W / 2, 53)
	end)
	ctx.Connect(startButton.MouseButton1Up, function()
		startButton.Position = UDim2.fromOffset(CONSOLE_W / 2, 49)
	end)
	ctx.Connect(startButton.MouseLeave, function()
		startButton.Position = UDim2.fromOffset(CONSOLE_W / 2, 49)
	end)
	ctx.Connect(startButton.Activated, function()
		if not ctx.HasFeature("PressStart") then
			return
		end
		local now = os.clock()
		if now < cooldownEnd then
			ctx.Sound.Play("Error", 1)
			UIUtil.Shake(startGroup)
			return
		end
		cooldownEnd = now + cooldown
		ctx.Interact("Press")
		ctx.Sound.Play("Click", 0.7)
		startScale.Scale = 0.85
		UIUtil.Tween(startScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		if phase == "Descend" or phase == "Squeeze" then
			turbo = true
			-- Accélère la phase en cours (en gardant la progression)
			local progress = phaseDuration > 0 and phaseTime / phaseDuration or 1
			phaseDuration /= 4
			phaseTime = progress * phaseDuration
		else
			pendingTurbo = true
		end
	end)

	ctx.OnBonus("Press", function(payload)
		local amount = tonumber(payload.Amount)
		if amount then
			ctx.FloatText(container, UDim2.fromOffset(MX, 110), "+" .. ctx.Format.Format(amount), Theme.Colors.Gold, 30)
		end
	end)

	------------------------------------------------------------------
	-- Palier initial + suivi du niveau
	------------------------------------------------------------------
	refreshLevel(false)
	ctx.Connect(ctx.State.Changed, function()
		refreshLevel(true)
	end)

	for i = 1, #SLOT_X do
		table.insert(queue, newEntry(SLOT_X[i]))
	end

	------------------------------------------------------------------
	-- Boucle (une seule connexion)
	------------------------------------------------------------------
	loadNext()

	local clock = 0
	local speedFade = 1
	local shownSpeedFade = 1
	local lastRollerOffset = -1
	local lastPressure = -1
	ctx.OnRender(function(dt: number)
		dt = math.min(dt, 0.1)
		if not visible() then
			return
		end
		clock += dt
		phaseTime += dt
		local t = phaseDuration > 0 and math.clamp(phaseTime / phaseDuration, 0, 1) or 1
		local targetPressure = 0

		if phase == "Load" then
			plateY = PLATE_TOP
			local e = easeInOut(t)
			for _, mover in ipairs(movers) do
				if not mover.Entry.Dropped then
					placeEntry(mover.Entry, mover.From + (mover.To - mover.From) * e)
				end
			end
			checkOutgoing()
			beltOffset = beltBase + SPACING * e
			if t >= 1 then
				finishLoad()
				turbo = pendingTurbo
				pendingTurbo = false
				squeezeDepth = current and current.H * 0.24 or 0
				setPhase("Descend")
			end
		elseif phase == "Descend" then
			-- Élan (le plateau remonte un peu) puis descente qui ACCÉLÈRE : il
			-- claque sur l'objet
			local contact = BELT_Y - itemHeight() - PLATE_H
			if t < 0.2 then
				plateY = phaseStartPlate - 5 * easeOut(t / 0.2)
			else
				local u = (t - 0.2) / 0.8
				plateY = phaseStartPlate - 5 + (contact - phaseStartPlate + 5) * u * u * u
			end
			-- (seulement loin sous la traverse : les traits ne la chevauchent jamais)
			speedFade = plateY > PLATE_TOP + 26 and 0.2 or 1
			targetPressure = 0.15 + 0.2 * t
			if t >= 1 then
				setPhase("Squeeze")
			end
		elseif phase == "Squeeze" then
			local entry = current
			if entry then
				-- Se tasse en tremblant, s'élargit un peu
				local height = entry.H - squeezeDepth * (t * t)
				local wobble = math.sin(clock * 60) * entry.Wobble * t
				entry.Holder.Size = UDim2.fromOffset(entry.W * (1 + 0.12 * t) + wobble, height)
				if entry.Label then
					entry.Label.Rotation = random:NextNumber(-6, 6) * t
				end
			end
			plateY = BELT_Y - itemHeight() - PLATE_H
			targetPressure = 0.4 + 0.5 * t
			shakeTime = math.max(shakeTime, 0.03 * t)
			if t >= 1 then
				setPhase("Crunch")
				onCrunch()
			end
		elseif phase == "Crunch" then
			-- Écrasé d'un coup, un peu plus bas que la galette finale
			local squashed = FLAT_H * 0.6
			local entry = current
			if entry then
				local startH = entry.H - squeezeDepth
				local height = startH + (squashed - startH) * t
				entry.Holder.Size = UDim2.fromOffset(entry.W * (1.12 + 0.55 * t), height)
				if entry.Label then
					entry.Label.Rotation = 0
				end
				plateY = BELT_Y - height - PLATE_H
			else
				plateY = BELT_Y - squashed - PLATE_H
			end
			targetPressure = 1
			if t >= 1 then
				setPhase("Hold")
			end
		elseif phase == "Hold" then
			-- Petit rebond de la galette (et du plateau) : "boing"
			local squashed = FLAT_H * 0.6
			local height = squashed + (FLAT_H - squashed) * easeOutBack(t)
			local entry = current
			if entry then
				entry.Holder.Size = UDim2.fromOffset(entry.W * (1.67 - 0.17 * easeOut(t)), height)
			end
			plateY = BELT_Y - height - PLATE_H
			targetPressure = 0.9
			if t >= 1 then
				setPhase("Rise")
				onRise()
				turbo = false
			end
		elseif phase == "Rise" then
			plateY = phaseStartPlate + (PLATE_TOP - phaseStartPlate) * easeOut(t)
			local sponge = outgoing
			if sponge and sponge.Regrow then
				local room = BELT_Y - plateY - PLATE_H
				local height = math.min(sponge.H, room)
				local k = math.clamp((height - FLAT_H) / math.max(1, sponge.H - FLAT_H), 0, 1)
				sponge.Holder.Size = UDim2.fromOffset(sponge.W * (1.5 - 0.5 * k), height)
			end
			targetPressure = 0.1
			if t >= 1 then
				plateY = PLATE_TOP
				loadNext()
			end
		end

		-- Traits de vitesse au-dessus du plateau
		if phase ~= "Descend" then
			speedFade = 1
		end
		if speedFade ~= shownSpeedFade then
			shownSpeedFade = speedFade
			for _, line in ipairs(speedLines) do
				line.BackgroundTransparency = speedFade
			end
		end

		-- Plateau + tige
		plate.Position = UDim2.fromOffset(MX, plateY)
		rod.Size = UDim2.fromOffset(20, math.max(4, plateY - (CROWN_Y + CROWN_H) + 4))

		-- Pression : manomètres, voyant d'huile, afficheur, voyants
		pressure += (targetPressure - pressure) * math.min(1, dt * 8)
		if math.abs(pressure - lastPressure) > 0.002 then
			lastPressure = pressure
			mainNeedle.Rotation = -120 + pressure * 240
			tankNeedle.Rotation = -120 + pressure * 220
			if gauge2.Visible then
				gauge2Needle.Rotation = -120 + pressure * 200
			end
			oil.Size = UDim2.fromScale(1, 0.72 - pressure * 0.3)
			local digital = tierAnim.Digital
			if digital then
				local value = math.floor(pressure * 3200 / 50) * 50
				if value ~= tierAnim.DigitalValue then
					tierAnim.DigitalValue = value
					digital.Text = string.format("%04d", value)
				end
			end
		end
		local pressing = phase == "Squeeze" or phase == "Crunch" or phase == "Hold"
		local lampColor = pressing and RED or Theme.Colors.Green
		if led.BackgroundColor3 ~= lampColor then
			led.BackgroundColor3 = lampColor
			statusLamp.BackgroundColor3 = lampColor
			panelLamp.BackgroundColor3 = lampColor
		end

		-- Tapis + rouleaux (seulement quand la bande bouge)
		if beltOffset ~= lastRollerOffset then
			lastRollerOffset = beltOffset
			beltStripes.Position = UDim2.fromOffset(-(beltOffset % BELT_PERIOD), 0)
			local angle = (beltOffset / 4.5) * 57.3
			for _, roller in ipairs(rollers) do
				roller.Rotation = angle
			end
		end

		updateParticles(dt)
		updatePuffs(dt)
		updateShouts(dt)
		updateBurst(dt)

		-- Animations du palier
		local style = TIERS[math.max(1, tierIndex)]
		for i, star in ipairs(tierAnim.Twinkles) do
			local wave = 0.5 + 0.5 * math.sin(clock * 3 + i * 1.9)
			star.TextTransparency = 0.1 + (1 - wave) * 0.8
			star.Rotation = math.sin(clock + i) * 15
		end
		local beacon = tierAnim.Beacon
		local beam = tierAnim.BeaconBeam
		if beacon and beam then
			-- Gyrophare : faisceau qui tourne (largeur qui oscille) + éclat
			local spin = math.sin(clock * 7)
			beam.Size = UDim2.fromOffset(10 + math.abs(spin) * 34, 5)
			beam.BackgroundTransparency = 0.35 + (1 - math.abs(spin)) * 0.55
			beacon.BackgroundTransparency = spin > 0 and 0 or 0.25
		end
		local shineFrame = tierAnim.Shine
		if shineFrame then
			local sweep = (clock * 0.45) % 1.6 -- passe puis marque une pause
			shineFrame.Position = UDim2.fromOffset(-40 + sweep * 200, 3)
		end
		local glow = tierAnim.Glow
		if glow then
			glow.BackgroundTransparency = 0.45 + 0.3 * math.sin(clock * 4)
		end
		if style.Neon then
			-- Contours néon qui changent de couleur
			local hue = (clock * 0.12) % 1
			local neon = Color3.fromHSV(hue, 0.75, 1)
			for _, stroke in ipairs(tierAnim.NeonStrokes) do
				stroke.Color = neon
			end
			cardStroke.Color = Color3.fromHSV((hue + 0.5) % 1, 0.7, 1)
		end
		if style.Steam and effectsOn() then
			-- Vapeur qui s'échappe du vérin de temps en temps
			tierAnim.SteamTimer -= dt
			if tierAnim.SteamTimer <= 0 then
				tierAnim.SteamTimer = random:NextNumber(1.2, 2.6)
				puff(MX + 32, CYL_Y + 4, 7, random:NextNumber(4, 14), -22)
			end
		end

		-- Secousse de la machine (la carte, le mur et le contour restent immobiles)
		if shakeTime > 0 then
			shakeTime -= dt
			local strength = math.clamp(shakeTime * 18, 0.6, 3) * math.min(shakePower, 1.5)
			rig.Position = UDim2.fromOffset(random:NextNumber(-strength, strength), random:NextNumber(-strength, strength))
		elseif rig.Position ~= UDim2.new() then
			rig.Position = UDim2.new()
		end

		-- Recharge du bouton START
		if startGroup.Visible then
			local remaining = cooldownEnd - os.clock()
			local text = remaining > 0 and string.format("%.1f", remaining) or "START"
			if text ~= shownCooldown then
				shownCooldown = text
				startButton.Text = text
				startButton.BackgroundColor3 = remaining > 0 and rgb(150, 110, 112) or RED
				buttonSide.BackgroundColor3 = remaining > 0 and rgb(96, 70, 72) or rgb(150, 16, 24)
				local k = remaining > 0 and math.clamp(1 - remaining / cooldown, 0, 1) or 1
				chargeFill.Size = UDim2.fromScale(k, 1)
				chargeFill.BackgroundColor3 = remaining > 0 and rgb(255, 190, 40) or Theme.Colors.Green
			end
		end
	end)
end

function Press.Stop(_ctx)
	-- Tout est dans ctx.Container (détruit par le StimulusManager)
end

return Press
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="162">
          <Properties>
            <string name="Name">QuantumFinger</string>
            <string name="Source"><![CDATA[--[[
	QuantumFinger (ModuleScript - stimulus) — amélioration "Doigt quantique"
	(10 niveaux, après 3 visites à l'océan)
	Emplacement : ReplicatedStorage > Client > Stimuli > QuantumFinger

	Le doigt est en "superposition" : des copies fantômes translucides (cyan,
	magenta, violet...) l'entourent en éventail, juste DERRIÈRE la vraie main
	(Stimuli/Finger). À chaque clic elles tapent aussi, en cascade, et des
	fantômes se "téléportent" autour du bouton pour le taper d'ailleurs, puis
	disparaissent (réutilisés : rien n'est créé pendant les clics).
	Chaque niveau ajoute quelque chose :
	  1 un fantôme               2 deux fantômes (cyan + magenta)
	  3 + un fantôme téléporté qui tape le bouton d'ailleurs
	  4 trois fantômes           5 effet "glitch" pendant les taps
	  6 quatre fantômes + 2 téléportés       7 champ quantique (anneau + électrons)
	  8 cinq fantômes            9 trois téléportés
	  10 six fantômes, couleurs arc-en-ciel
	Sans le doigt musclé, le doigt quantique prend sa propre place (GearLayout).
	Au repos : de temps en temps, les fantômes "décohèrent" (petit saut).
]]

local Gear = script.Parent:WaitForChild("Gear")
local GearKit = require(Gear:WaitForChild("GearKit"))
local GearLayout = require(Gear:WaitForChild("GearLayout"))
local HandArt = require(Gear:WaitForChild("HandArt"))

local QuantumFinger = {}
QuantumFinger.Slot = "Background" -- sous l'interface (fantômes téléportés : calque Overlay)

local FOOTPRINT = 90
local GLITCH_COLORS = {
	Color3.fromRGB(80, 226, 255),
	Color3.fromRGB(255, 84, 214),
	Color3.fromRGB(158, 116, 255),
	Color3.fromRGB(110, 255, 170),
	Color3.fromRGB(255, 214, 80),
	Color3.fromRGB(255, 120, 120),
}

local active: { [any]: () -> () } = {}

local function ghostCount(level: number): number
	return math.min(6, 1 + math.floor(level / 2))
end

local function teleportCount(level: number): number
	if level >= 9 then
		return 3
	elseif level >= 6 then
		return 2
	elseif level >= 3 then
		return 1
	end
	return 0
end

function QuantumFinger.Start(ctx)
	local animator = GearKit.Animator(ctx)
	local random = ctx.Random
	-- Derrière la vraie main (conteneur du doigt musclé : ZIndex 1107), au-dessus
	-- des fonds animés du calque Background (voir GearPiece)
	ctx.Container.ZIndex = 1106
	local fx = GearKit.FXLayer(ctx, "Gear_QuantumFingerFX")

	local level = math.max(1, GearKit.Level(ctx, "QuantumFinger"))
	local host: any = nil -- placement suivi (doigt musclé, ou le nôtre)
	local ownPlacement: any = nil
	local ownRegistered = false
	local alive = true

	-- Groupe des fantômes (suit le doigt)
	local group = Instance.new("Frame")
	group.Name = "Gear_QuantumGhosts"
	group.BackgroundTransparency = 1
	group.AnchorPoint = Vector2.new(0.5, 0.5)
	group.Size = UDim2.fromOffset(FOOTPRINT, FOOTPRINT)
	group.Visible = false
	group.ZIndex = 2
	local groupScale = Instance.new("UIScale")
	groupScale.Parent = group
	group.Parent = ctx.Container

	type GhostSlot = { Aim: Frame, Ghost: HandArt.Ghost, Offset: Vector2, Turn: number }
	local ghosts: { GhostSlot } = {}
	local field: Frame? = nil
	local electrons: { Frame } = {}
	local aimAngle, dir, reach = 0, Vector2.new(0, -1), 12

	-- Fantômes téléportés (sur la toile), réutilisés
	local teleports = {}
	for index = 1, 3 do
		local holder = Instance.new("Frame")
		holder.Name = "Teleport" .. index
		holder.BackgroundTransparency = 1
		holder.AnchorPoint = Vector2.new(0.5, 0.5)
		holder.Size = UDim2.fromOffset(HandArt.Size, HandArt.Size)
		holder.Visible = false
		holder.ZIndex = 30
		local scale = Instance.new("UIScale")
		scale.Parent = holder
		local ghost = HandArt.BuildGhost(holder, GLITCH_COLORS[index], 8, "Ghost")
		holder.Parent = fx
		table.insert(teleports, { Holder = holder, Scale = scale, Ghost = ghost })
	end

	local function tintFor(index: number): Color3
		if level >= 10 then
			return GearKit.Rainbow((index - 1) / 6 + 0.5, 0.65, 1)
		end
		return GLITCH_COLORS[(index - 1) % #GLITCH_COLORS + 1]
	end

	-- Éventail des fantômes derrière la main (perpendiculaire à la visée)
	local function layoutGhosts()
		local n = #ghosts
		local perp = Vector2.new(-dir.Y, dir.X)
		for index, slot in ipairs(ghosts) do
			local k = index - (n + 1) / 2
			if n == 1 then
				k = 0.8
			end
			-- (éventail serré : les fantômes restent près de la place du doigt)
			local spread = n <= 1 and 12 or math.min(11, 36 / (n - 1))
			local offset = perp * (k * spread) - dir * (5 + math.abs(k) * 3)
			slot.Offset = offset
			slot.Turn = k * (n <= 2 and 12 or 9)
			slot.Aim.Position = UDim2.new(0.5, offset.X, 0.5, offset.Y)
			slot.Aim.Rotation = aimAngle + slot.Turn
		end
	end

	local function build()
		for _, slot in ipairs(ghosts) do
			animator:Stop(slot.Aim)
			slot.Aim:Destroy()
		end
		table.clear(ghosts)
		if field then
			field:Destroy()
			field = nil
		end
		table.clear(electrons)
		local fingerLevel = math.max(1, GearKit.Level(ctx, "Finger"))
		local count = ghostCount(level)
		-- Sans vrai doigt : un fantôme de plus, au centre, plus visible
		local standalone = not GearLayout.IsRegistered("Finger")
		for index = 1, count do
			local aimFrame = Instance.new("Frame")
			aimFrame.Name = "GhostAim"
			aimFrame.BackgroundTransparency = 1
			aimFrame.AnchorPoint = Vector2.new(0.5, 0.5)
			aimFrame.Position = UDim2.fromScale(0.5, 0.5)
			aimFrame.Size = UDim2.fromOffset(HandArt.Size, HandArt.Size)
			aimFrame.ZIndex = 2
			local ghost = HandArt.BuildGhost(aimFrame, tintFor(index), fingerLevel)
			ghost.ArtScale.Scale *= 0.94
			aimFrame.Parent = group
			table.insert(ghosts, { Aim = aimFrame, Ghost = ghost, Offset = Vector2.zero, Turn = 0 })
		end
		if standalone then
			local aimFrame = Instance.new("Frame")
			aimFrame.Name = "GhostCore"
			aimFrame.BackgroundTransparency = 1
			aimFrame.AnchorPoint = Vector2.new(0.5, 0.5)
			aimFrame.Position = UDim2.fromScale(0.5, 0.5)
			aimFrame.Size = UDim2.fromOffset(HandArt.Size, HandArt.Size)
			aimFrame.ZIndex = 3
			local ghost = HandArt.BuildGhost(aimFrame, Color3.fromRGB(170, 240, 255), 8)
			for _, part in ipairs(ghost.Parts) do
				part.BackgroundTransparency = 0.12
			end
			aimFrame.Parent = group
			table.insert(ghosts, 1, { Aim = aimFrame, Ghost = ghost, Offset = Vector2.zero, Turn = 0 })
		end
		-- Champ quantique : anneau + électrons
		if level >= 7 then
			local ring = Instance.new("Frame")
			ring.Name = "Field"
			ring.BackgroundTransparency = 1
			ring.AnchorPoint = Vector2.new(0.5, 0.5)
			ring.Position = UDim2.fromScale(0.5, 0.5)
			ring.Size = UDim2.fromOffset(FOOTPRINT * 1.02, FOOTPRINT * 1.02)
			ring.ZIndex = 1
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0.5, 0)
			corner.Parent = ring
			local stroke = Instance.new("UIStroke")
			stroke.Color = Color3.fromRGB(120, 230, 255)
			stroke.Thickness = 1.5
			stroke.Transparency = 0.45
			stroke.Parent = ring
			if level >= 10 then
				local gradient = Instance.new("UIGradient")
				gradient.Color = GearKit.RainbowSequence(0, 0.7)
				gradient.Parent = stroke
			end
			for index = 1, 3 do
				local dot = GearKit.Box(ring, 0, 0, 7, 7, GLITCH_COLORS[index], {
					Name = "Electron",
					Anchor = Vector2.new(0.5, 0.5),
					Radius = "round",
					Z = 2,
				})
				GearKit.Box(dot, 2, 2, 3, 3, Color3.new(1, 1, 1), { Name = "Core", Radius = "round", Z = 3 })
				table.insert(electrons, dot)
			end
			ring.Parent = group
			field = ring
		end
		layoutGhosts()
	end

	-- Électrons : sauts quantiques (positions au hasard sur l'anneau)
	local function jumpElectrons()
		for _, dot in ipairs(electrons) do
			local angle = random:NextNumber(0, math.pi * 2)
			dot.Position = UDim2.fromScale(0.5 + 0.5 * math.cos(angle), 0.5 + 0.5 * math.sin(angle))
		end
	end

	local function apply(placement: any)
		host = placement
		if not placement then
			group.Visible = false
			return
		end
		local artScale = HandArt.Features(math.max(1, GearKit.Level(ctx, "Finger"))).Scale
		local reachCanvas
		aimAngle, dir, reachCanvas = HandArt.Aim(placement, artScale)
		reach = reachCanvas / math.max(placement.Scale, 0.05)
		local first = not group.Visible
		group.Visible = true
		group.Position = UDim2.fromOffset(placement.CX, placement.CY)
		groupScale.Scale = placement.Scale
		layoutGhosts()
		jumpElectrons()
		if first then
			animator:Play("appear", 0.5, function(t)
				groupScale.Scale = placement.Scale * math.max(0.01, GearKit.Ease.OutBack(t))
			end)
		end
	end

	-- Hôte : le doigt musclé s'il existe, sinon notre propre place
	local function updateHost()
		if not alive then
			return
		end
		if GearLayout.IsRegistered("Finger") then
			if ownRegistered then
				ownRegistered = false
				ownPlacement = nil
				GearLayout.Unregister("QuantumFinger")
				build()
			end
			apply(GearLayout.GetPlacement("Finger"))
		else
			if not ownRegistered then
				ownRegistered = true
				GearLayout.Register("QuantumFinger", {
					Size = Vector2.new(FOOTPRINT, FOOTPRINT),
					Priority = 1.5,
					MinScale = 0.42,
					MaxScale = 1,
					Near = 60,
					Anchor = function(button, _canvas)
						return Vector2.new(button.X0 - 50, (button.Y0 + button.Y1) / 2 + 6)
					end,
					OnPlace = function(placement)
						ownPlacement = placement
						apply(placement)
					end,
				})
				build()
			end
			apply(ownPlacement)
		end
	end

	build()
	updateHost()
	ctx.Connect(GearLayout.Changed, function(id)
		if id == "Finger" or id == "QuantumFinger" then
			updateHost()
		end
	end)

	-- Nouveau niveau (doigt quantique OU doigt musclé : taille des fantômes)
	local fingerLevel = GearKit.Level(ctx, "Finger")
	ctx.Connect(ctx.State.Changed, function()
		local newLevel = math.max(1, GearKit.Level(ctx, "QuantumFinger"))
		local newFinger = GearKit.Level(ctx, "Finger")
		if newLevel ~= level or newFinger ~= fingerLevel then
			level = newLevel
			fingerLevel = newFinger
			build()
			if host then
				apply(host)
			end
		end
	end)

	-- Tap d'un fantôme téléporté autour du bouton
	local function teleportTap(entry: any, delay: number)
		local button = GearKit.GetButtonRect()
		if not button then
			return
		end
		local center = GearKit.Center(button)
		local halfW, halfH = (button.X1 - button.X0) / 2, (button.Y1 - button.Y0) / 2
		-- Un point sur une ellipse autour du bouton (plutôt au-dessus / sur les côtés)
		local angle = random:NextNumber(-math.pi * 0.95, math.pi * 0.15)
		local position = Vector2.new(center.X + math.cos(angle) * (halfW + 34), center.Y + math.sin(angle) * (halfH + 34))
		local angleToButton = GearKit.AimAngle(position, center)
		local toward = GearKit.AngleDir(angleToButton)
		local holder = entry.Holder
		local scale = entry.Scale
		local ghostScale = 0.62
		local tip = (HandArt.Size / 2 - HandArt.TipY) * entry.Ghost.ArtScale.Scale * ghostScale
		local gap = math.max(0, GearKit.RayToRect(position + toward * tip, toward, button))
		local strike = math.min(gap + 2, 40)
		holder.Rotation = angleToButton
		animator:Play(holder, 0.42 + delay, function(t)
			local k = math.clamp((t * (0.42 + delay) - delay) / 0.42, 0, 1)
			holder.Visible = k > 0 and k < 1
			if k <= 0 then
				return
			end
			local grow = math.min(1, k / 0.18)
			local fade = k > 0.75 and (k - 0.75) / 0.25 or 0
			scale.Scale = ghostScale * (0.4 + 0.6 * grow) * (1 - 0.3 * fade)
			local push = k < 0.45 and GearKit.Ease.InQuad(math.clamp((k - 0.15) / 0.3, 0, 1)) or 1 - GearKit.Ease.OutQuad((k - 0.45) / 0.55)
			local jitter = level >= 5 and (random:NextNumber(-2, 2)) or 0
			local p = position + toward * strike * push
			holder.Position = UDim2.fromOffset(p.X + jitter, p.Y)
			for _, part in ipairs(entry.Ghost.Parts) do
				part.BackgroundTransparency = 0.42 + 0.58 * math.max(fade, 1 - grow)
			end
		end, function()
			holder.Visible = false
		end)
	end

	local function onClick()
		if not host or not group.Visible then
			return
		end
		-- Les fantômes tapent en cascade
		for index, slot in ipairs(ghosts) do
			local aimFrame = slot.Aim
			local delay = index * 0.028
			local base = slot.Offset
			animator:Play(aimFrame, 0.2 + delay, function(t)
				local k = math.clamp((t * (0.2 + delay) - delay) / 0.2, 0, 1)
				local offset
				if k < 0.28 then
					offset = GearKit.Ease.InQuad(k / 0.28)
				elseif k < 0.42 then
					offset = 1
				else
					offset = 1 - GearKit.Ease.OutQuad((k - 0.42) / 0.58)
				end
				local jitter = Vector2.zero
				if level >= 5 and k > 0 and k < 0.6 then
					jitter = Vector2.new(random:NextNumber(-2.5, 2.5), random:NextNumber(-2.5, 2.5))
				end
				local d = base + dir * reach * offset + jitter
				aimFrame.Position = UDim2.new(0.5, d.X, 0.5, d.Y)
			end, function()
				aimFrame.Position = UDim2.new(0.5, base.X, 0.5, base.Y)
			end)
		end
		if #electrons > 0 then
			jumpElectrons()
		end
		if GearKit.EffectsOn(ctx) then
			for index = 1, teleportCount(level) do
				teleportTap(teleports[index], (index - 1) * 0.05)
			end
		end
	end

	ctx.Connect(ctx.State.Clicked, function()
		if ctx.IsVisible() then
			onClick()
		end
	end)

	-- Au repos : décohérence (les fantômes sautent un instant)
	GearKit.Every(ctx, 3, 5, function()
		if not host or not group.Visible then
			return
		end
		for _, slot in ipairs(ghosts) do
			local aimFrame = slot.Aim
			local base = slot.Offset
			local shift = Vector2.new(random:NextNumber(-5, 5), random:NextNumber(-5, 5))
			animator:Play(aimFrame, 0.3, function(t)
				local on = t < 0.5
				local d = base + (on and shift or Vector2.zero)
				aimFrame.Position = UDim2.new(0.5, d.X, 0.5, d.Y)
				aimFrame.Rotation = aimAngle + slot.Turn + (on and shift.X or 0)
			end, function()
				aimFrame.Position = UDim2.new(0.5, base.X, 0.5, base.Y)
				aimFrame.Rotation = aimAngle + slot.Turn
			end)
		end
		jumpElectrons()
	end)

	active[ctx] = function()
		alive = false
		if ownRegistered then
			ownRegistered = false
			GearLayout.Unregister("QuantumFinger")
		end
		if fx.Parent then
			fx:Destroy()
		end
	end
end

function QuantumFinger.Stop(ctx)
	local cleanup = active[ctx]
	active[ctx] = nil
	if cleanup then
		cleanup()
	end
end

return QuantumFinger
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="163">
          <Properties>
            <string name="Name">Runner</string>
            <string name="Source"><![CDATA[--[[
	Runner (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > Runner

	Un "jeu de course infini" façon jeu mobile qui tourne tout seul dans le
	coin en haut à gauche (slot L1, 288x190). v8 :
	  - ciel qui suit un cycle jour / coucher de soleil / nuit / aube (4 min) :
	    soleil qui traverse le ciel puis se couche derrière la ville, lune et
	    étoiles qui scintillent la nuit, nuages teintés selon l'heure ;
	  - ville en parallaxe sur deux plans : silhouettes lointaines dans la
	    brume + immeubles détaillés (façade, flanc ombré, grilles de fenêtres
	    qui s'allument la nuit, antennes, châteaux d'eau) ;
	  - voie en perspective : murs de soutènement (margelle, bordure, piliers,
	    graffitis), arbres derrière les murs, lampadaires (qui éclairent le sol
	    la nuit), trottoirs, ballast, lits de voie sombres, traverses et rails
	    en deux tons qui défilent ;
	  - obstacles : trains détaillés (face avant, flanc et toit en vraie
	    perspective, girouette lumineuse, phares), barrières basses (saut),
	    hautes (glissade), paires de cônes (saut) ;
	  - pièces qui tournent (anneau, reflet, éclat) ; bonus aimant 🧲,
	    pièces x2 et jetpack 🚀, chacun avec son effet visuel ;
	  - HUD : pièces (+ badge x2), distance, record de la session, combo,
	    jauges des bonus ; petits événements ("Beau saut !", "De justesse !")
	    et, de temps en temps, une chute, un écran de fin de course puis une
	    nouvelle partie (le record est gardé pendant la session).
	v9 ("encore mieux") :
	  - coureur plus grand, contours façon dessin animé : bras et jambes
	    articulés (pivots), bras opposés aux jambes, épaules qui tournent,
	    sac à dos à ressort, porte-clés qui se balance, capuche qui rebondit ;
	    figures pendant les sauts (groupé, vrille, étoile) ; il se retourne de
	    temps en temps (visage, clignement des yeux) et réagit : yeux ronds
	    quand un train le frôle, ravi avec un bonus, sonné (yeux en croix,
	    étoiles autour de la tête) après une chute ; bulle d'émoji ;
	  - baskets = amélioration "RunnerShoes" (0 à 10), visibles et mises à
	    jour en direct (ctx.State.Changed) : usées, blanches, sport, lacets de
	    couleur, montantes, semelles néon (halo au sol, traînée lumineuse
	    qui suit les changements de voie), ailes aux talons, bottes à
	    réaction, bottes-fusées en feu ; poussière / étincelles / plumes /
	    braises selon le niveau ; badge "👟 Niv. X" dans le HUD ; un peu plus
	    de vitesse à chaque niveau ; "Nouvelles baskets !" à l'achat ;
	  - décor : grande roue et tour de télévision au loin (lumières la nuit),
	    oiseaux, enseigne "DOPA", pont routier qui passe au-dessus de la voie
	    (ombre sur les rails), vitres des trains allumées la nuit, ombres de
	    contact, vignette ;
	  - pièces ramassées qui filent vers le compteur ; écran de fin avec
	    bandeau "Perdu" et bouton "Rejouer" qui s'enfonce tout seul.
	Tout est dessiné avec des Frames créées une seule fois puis recyclées
	(~800 instances en tout, modificateurs compris ; aucune création pendant
	la partie). Une seule boucle OnRender, en pause quand la carte n'est pas
	visible ; décor d'ambiance à 30 images/s ; couleurs jour / nuit
	recalculées 5 fois par seconde, et seulement pendant les transitions ;
	les propriétés inchangées ne sont pas réécrites (visibilité mémorisée).
	Purement visuel : aucun appel serveur. Tout dérive de la taille du slot.
]]

local Locale = require(game:GetService("ReplicatedStorage").Shared.Locale)

local Runner = {}
Runner.Slot = "L1"

-- Record de la session (le module reste en mémoire : survit aux redémarrages du stimulus)
local sessionBest = 0

----------------------------------------------------------------------
-- Réglages. Unités "monde" : 1 unité = 1 pixel à la profondeur z = 1
-- pour un écran de 280 px de large (tout est ensuite mis à l'échelle).
----------------------------------------------------------------------

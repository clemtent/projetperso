function HouseStairs.Palette(size: any): Palette
	return PALETTES[WorldLayout.StyleOf(size)] or PALETTES.Cottage
end

export type Colors = { Wall: Color3, Trim: Color3, Accent: Color3 }
export type Result = { Ramps: { BasePart }, Holes: { { number } }, Parts: number }
export type InteriorResult = { Ramps: { BasePart }, Parts: number, Lights: number }

local function floorName(floor: number): string
	if floor <= 1 then
		return Locale.T("Ground floor")
	end
	return Locale.T("Floor %s", tostring(floor - 1))
end

-- Géométrie d'une volée (repère local de la maison ; y relatif au sol de l'étage)
type Run = {
	S0: number, -- limon côté couloir (x)
	S1: number, -- face intérieure du mur de droite (x)
	D0: number, -- 1re contremarche (d)
	D1: number, -- dernière contremarche = arrivée (d)
	G: number, -- giron
	R: number, -- hauteur de marche
	N: number, -- contremarches
	Cos: number, -- cosinus de la pente
	Hole0: number, -- début de la trémie du dessus (d)
}

local function runOf(size: any): Run
	local s0, s1 = WorldLayout.StairSpan(size)
	local d0, d1, g, r = WorldLayout.StairRun(size)
	local h0 = WorldLayout.StairHole(size)
	return { S0 = s0, S1 = s1, D0 = d0, D1 = d1, G = g, R = r, N = WorldLayout.STAIR_RISERS, Cos = g / math.sqrt(g * g + r * r), Hole0 = h0 }
end

-- ligne des nez de marche (hauteur au-dessus du sol de l'étage)
local function nosing(run: Run, d: number): number
	return run.R + (d - run.D0) * run.R / run.G
end

----------------------------------------------------------------------
-- COQUE (toujours construite) : sols, trémies, murs, plafond
----------------------------------------------------------------------

-- Motif du dallage du rez-de-chaussée (SurfaceGui sur le dessus : aucune pièce)
local function floorPattern(part: BasePart, w: number, dLen: number, pal: Palette)
	local pps = 16
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Tiles"
	gui.Face = Enum.NormalId.Top
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pps
	gui.LightInfluence = 1
	gui.MaxDistance = 90
	gui.Parent = part
	local W, H = w * pps, dLen * pps
	local function rect(x: number, y: number, rw: number, rh: number, color: Color3, transparency: number, rotation: number?)
		local f = Instance.new("Frame")
		f.BorderSizePixel = 0
		f.BackgroundColor3 = color
		f.BackgroundTransparency = transparency
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = UDim2.fromOffset(x, y)
		f.Size = UDim2.fromOffset(rw, rh)
		f.Rotation = rotation or 0
		f.Parent = gui
	end
	local pattern = pal.Pattern
	if pattern == "Checker" then
		-- damier noir et blanc (carreaux de 2 studs) + joints fins
		local t = 2 * pps
		local nx, ny = math.ceil(W / t), math.ceil(H / t)
		for i = 0, nx - 1 do
			for j = 0, ny - 1 do
				if (i + j) % 2 == 1 then
					local cw = math.min(t, W - i * t)
					local ch = math.min(t, H - j * t)
					rect(i * t + cw / 2, j * t + ch / 2, cw, ch, pal.Tile2, 0)
				end
			end
		end
	elseif pattern == "Diamond" then
		-- marbre blanc, joints gris clair, cabochons gris aux croisements (3 studs)
		local t = 3 * pps
		for i = 1, math.floor(W / t) do
			rect(i * t, H / 2, 2, H, pal.Tile2, 0.55)
		end
		for j = 1, math.floor(H / t) do
			rect(W / 2, j * t, W, 2, pal.Tile2, 0.55)
		end
		for i = 0, math.floor(W / t) do
			for j = 0, math.floor(H / t) do
				rect(i * t, j * t, 14, 14, pal.Tile2, 0, 45)
			end
		end
	elseif pattern == "Joints" then
		-- béton ciré : joints sciés tous les 4 studs
		local t = 4 * pps
		for i = 1, math.floor(W / t) do
			rect(i * t, H / 2, 2, H, pal.Tile2, 0.35)
		end
		for j = 1, math.floor(H / t) do
			rect(W / 2, j * t, W, 2, pal.Tile2, 0.35)
		end
	else
		-- tomettes : carreaux de 1,5 stud, joints crème
		local t = 1.5 * pps
		for i = 1, math.floor(W / t) do
			rect(i * t, H / 2, 3, H, pal.Tile2, 0.1)
		end
		for j = 1, math.floor(H / t) do
			rect(W / 2, j * t, W, 3, pal.Tile2, 0.1)
		end
	end
end

-- Plancher de l'étage `floor` dans la cage (trémie si une volée y arrive)
local function shellFloor(kit: any, size: any, floor: number, pal: Palette)
	local h0, h1 = WorldLayout.HallSpan(size)
	local run = runOf(size)
	local y = WorldLayout.FloorY(floor)
	local T = WorldLayout.WALL_T
	local dFront, dBack = T, T + WorldLayout.DEPTH
	if floor == 1 then
		-- soubassement plein + dallage (jusque sous la porte)
		-- (v9.6 z-fighting : commence DERRIÈRE la façade (d = T))
		kit:Box("HallBase", h0, h1, 0, y - 0.2, dFront + 0.05, dBack - 0.05, Color3.fromRGB(226, 214, 222), M.Concrete, { Solid = true, Shadow = false })
		local tiles = kit:Box("HallTiles", h0, h1, y - 0.2, y, dFront, dBack, pal.Floor1, pal.Floor1Mat, { Solid = true, Shadow = false })
		floorPattern(tiles, h1 - h0, dBack - dFront, pal)
		return
	end
	-- morceaux autour de la trémie : couloir (toute la profondeur), bande de
	-- l'escalier devant la trémie et derrière l'arrivée
	local pieces = {
		{ h0, run.S0, dFront, dBack },
		{ run.S0, h1, dFront, run.Hole0 },
		{ run.S0, h1, run.D1 + 0.12, dBack },
	}
	for _, r in ipairs(pieces) do
		kit:Box("HallSlab", r[1], r[2], y - WorldLayout.SLAB, y - 0.2, r[3], r[4], CEILING, M.SmoothPlastic, { Solid = true, Shadow = false })
		kit:Box("HallFloor", r[1], r[2], y - 0.2, y, r[3], r[4], pal.Upper, pal.UpperMat, { Solid = true, Shadow = false })
	end
	-- bandeau du mur le long de la trémie (entre les peaux de deux étages : on
	-- voyait le plancher de la pièce voisine par la fente)
	kit:Box("HoleFascia", h1 - SKIN, h1, y - WorldLayout.SLAB, y, run.Hole0, run.D1 + 0.12, pal.Wall, pal.WallMat, { Shadow = false })
end

-- Murs intérieurs de la cage (peau : enduit + lambris), passages vers les pièces
local function shellWalls(kit: any, size: any, floor: number, pal: Palette)
	local h0, h1 = WorldLayout.HallSpan(size)
	local y = WorldLayout.FloorY(floor)
	local T, D = WorldLayout.WALL_T, WorldLayout.DEPTH
	local dFront, dBack = T, T + D
	local passages = WorldLayout.HallPassages(size)
	for _, side in ipairs({ "Left", "Right" }) do
		local face = if side == "Left" then h0 else h1
		local x0, x1 = if side == "Left" then face else face - SKIN, if side == "Left" then face + SKIN else face
		local span = passages[side]
		local holes = if span then { { span[1], span[2], y, y + WorldLayout.PASS_H } } else {}
		if side == "Right" or pal.Open then
			-- mur de l'escalier (ou loft) : enduit / briques sur toute la hauteur
			kit:WallD("HallWall", x0, x1, y, y + WorldLayout.WALL_H, dFront, dBack, holes, pal.Wall, pal.WallMat, { Solid = false, Shadow = false })
		else
			kit:WallD("HallWall", x0, x1, y + 3.4, y + WorldLayout.WALL_H, dFront, dBack, holes, pal.Wall, pal.WallMat, { Solid = false, Shadow = false })
			kit:WallD("HallDado", x0, x1, y, y + 3.4, dFront, dBack, holes, pal.Dado, pal.DadoMat, { Solid = false, Shadow = false })
		end
	end
end

function HouseStairs.BuildShell(kit: any, size: any): { Parts: number }
	local dims = WorldLayout.Dims(size)
	local pal = HouseStairs.Palette(size)
	local before = kit.Stats.Count
	for floor = 1, dims.Floors do
		shellFloor(kit, size, floor, pal)
		shellWalls(kit, size, floor, pal)
	end
	-- Plafond du dernier étage
	-- (v9.6 / v9.7 z-fighting : descend de 0,1 sous la dalle de toit de la
	-- façade, s'arrête contre la face intérieure des murs du hall)
	local h0, h1 = WorldLayout.HallSpan(size)
	local top = WorldLayout.FloorY(dims.Floors) + WorldLayout.WALL_H
	kit:Box("HallCeiling", h0 + SKIN, h1 - SKIN, top - 0.1, top + 0.5, WorldLayout.WALL_T, WorldLayout.WALL_T + WorldLayout.DEPTH, CEILING, M.SmoothPlastic,
		{ Solid = true, Shadow = false })
	return { Parts = kit.Stats.Count - before }
end

----------------------------------------------------------------------
-- INTÉRIEUR (en flux) : escalier, garde-corps, moulures, meubles, lampes
----------------------------------------------------------------------

-- Une volée : de l'étage `floor` à l'étage `floor + 1`
local function flight(kit: any, size: any, floor: number, pal: Palette, ramps: { BasePart })
	local run = runOf(size)
	local y0 = WorldLayout.FloorY(floor)
	local S0, S1, D0, D1, G, R, N = run.S0, run.S1, run.D0, run.D1, run.G, run.R, run.N
	local STORY = WorldLayout.STORY
	local function nose(d: number): number
		return y0 + nosing(run, d)
	end
	local stringIn = S0 + 0.3 -- face intérieure du limon côté couloir
	local wallIn = S1 - 0.2 -- face du limon de mur
	local open = pal.Open

	-- 1. Rampe de collision (invisible) : ligne du MILIEU des marches (parallèle
	-- aux nez, = WorldLayout.StairHeight), de (D0 - G/2, sol) au milieu de la
	-- dernière marche, prolongée sous le sol ; puis un bout plus raide qui
	-- rejoint le palier AU RAS à l'arrivée (D1), et un petit plat jusqu'au plancher
	local slope = R / G
	local rx0, rx1 = stringIn + 0.05, wallIn - 0.05
	local extra = 0.8
	local knee = D1 - G / 2
	local rampPart = kit:Slab("StairRamp", (rx0 + rx1) / 2, { y0 - extra * slope, D0 - G / 2 - extra }, { y0 + STORY - R, knee }, rx1 - rx0, 1, WHITE,
		M.SmoothPlastic, { Solid = true, Query = true, T = 1, Shadow = false })
	rampPart:SetAttribute("StairFloor", floor)
	table.insert(ramps, rampPart)
	local rampEnd = kit:Slab("StairRamp", (rx0 + rx1) / 2, { y0 + STORY - R, knee }, { y0 + STORY, D1 }, rx1 - rx0, 0.6, WHITE, M.SmoothPlastic,
		{ Solid = true, Query = true, T = 1, Shadow = false })
	table.insert(ramps, rampEnd)
	local flat = kit:Box("StairRampTop", rx0, rx1, y0 + STORY - 0.6, y0 + STORY, D1, D1 + 0.12, WHITE, M.SmoothPlastic,
		{ Solid = true, Query = true, T = 1, Shadow = false })
	table.insert(ramps, flat)
	-- garde invisible côté vide (on ne tombe pas du côté du couloir) :
	-- de 1,5 sous les nez à la hauteur de la main courante
	-- (boîtes verticales de 2 studs : rien ne dépasse sur le palier d'arrivée)
	local g0 = D0 - 0.4
	while g0 < D1 - 0.05 do
		local g1 = math.min(g0 + 2, D1)
		kit:Box("StairGuard", S0, S0 + 0.3, nose(g0) - 1.2, nose(g1) + RAIL_H + 0.2, g0, g1, WHITE, M.SmoothPlastic, { Solid = true, Query = false, T = 1, Shadow = false })
		g0 = g1
	end

	-- 2. Marches visibles (décor, sans collision)
	local tx0, tx1 = stringIn - 0.05, wallIn + 0.05 -- (les bouts entrent dans les limons : aucune face commune)
	local rx = (tx0 + tx1) / 2
	local runnerW = math.min(2.6, (tx1 - tx0) - 1.1)
	local treadT = if open then 0.3 else 0.2
	for i = 1, N do
		local d = D0 + (i - 1) * G
		local top = y0 + i * R
		if not open then
			-- contremarche (posée sur le giron du dessous)
			kit:Box("Riser", tx0, tx1, top - R, top - treadT, d, d + 0.12, pal.Riser, M.SmoothPlastic, { Shadow = false })
			if pal.Runner then
				-- tapis sur la contremarche (devant elle)
				kit:Box("RunnerRiser", rx - runnerW / 2, rx + runnerW / 2, top - R + (if i > 1 then 0.05 else 0), top - treadT, d - 0.05, d, pal.Runner, M.Fabric,
					{ Shadow = false })
			end
		end
		if i < N then
			-- giron : nez de 0,1 devant la contremarche, jusque sous la suivante
			kit:Box("Tread", tx0, tx1, top - treadT, top, d - (if open then 0.05 else 0.1), d + G + (if open then -0.05 else 0.12), pal.Tread, pal.TreadMat,
				{ Shadow = false })
			if pal.Runner then
				kit:Box("Runner", rx - runnerW / 2, rx + runnerW / 2, top, top + 0.05, d - 0.05, d + G, pal.Runner, M.Fabric, { Shadow = false })
			end
		else
			-- nez du palier d'arrivée (le plancher du palier commence à D1 + 0,12)
			kit:Box("Nosing", tx0, tx1, top - treadT, top, d - 0.1, d + 0.12, pal.Tread, pal.TreadMat, { Shadow = false })
		end
	end

	-- 3. Limons + sous-face
	-- limon côté couloir : 0,3 d'épaisseur, 0,35 au-dessus des nez, 1,4 de haut
	local sTop0, sTop1 = nose(D0 - 0.5) + 0.35, y0 + STORY + 0.35
	kit:Slab("Stringer", S0 + 0.15, { sTop0, D0 - 0.5 }, { sTop1, D1 + 0.12 }, 0.3, 1.4 * run.Cos, pal.Stringer, pal.StringerMat, { Shadow = true })
	-- limon de mur (plinthe rampante)
	kit:Slab("WallStringer", S1 - 0.1, { nose(D0 - 0.5) + 0.45, D0 - 0.5 }, { y0 + STORY + 0.45, D1 + 0.12 }, 0.2, 1.2 * run.Cos, pal.Stringer, pal.StringerMat,
		{ Shadow = false })
	if not open then
		-- sous-face (plâtre) : sous les coins des marches (ligne des nez - R)
		kit:Slab("Soffit", (stringIn + wallIn) / 2, { nose(D0) - R - 0.08, D0 }, { y0 + STORY - R - 0.08, D1 + 0.12 }, wallIn - stringIn, 0.3, CEILING,
			M.SmoothPlastic, { Shadow = false })
	end

	-- 4. Garde-corps côté couloir : main courante, balustres (2 par marche),
	-- poteau de départ (boule) et d'arrivée
	local railX = S0 + 0.15
	local rail0, rail1 = D0 - 0.3, D1 - 0.2
	kit:Slab("Handrail", railX, { nose(rail0) + RAIL_H + 0.12, rail0 }, { nose(rail1) + RAIL_H + 0.12, rail1 }, 0.34, 0.24 * run.Cos, pal.Rail, pal.RailMat,
		{ Shadow = false })
	if open then
		-- loft : 3 lisses d'acier parallèles à la main courante + un montant toutes les 3 marches
		for k = 1, 3 do
			local h = RAIL_H * k / 4 + 0.2
			kit:Slab("RailBar", railX, { nose(rail0) + h, rail0 }, { nose(rail1) + h, rail1 }, 0.1, 0.1, pal.Baluster, pal.BalusterMat, { Shadow = false })
		end
		for i = 2, N - 1, 3 do
			local d = D0 + (i - 0.5) * G
			local base = nose(d) + 0.35
			kit:Box("RailPost", railX - 0.07, railX + 0.07, base, nose(d) + RAIL_H, d - 0.07, d + 0.07, pal.Baluster, pal.BalusterMat, { Shadow = false })
		end
	else
		for i = 1, N - 1 do
			for _, f in ipairs({ 0.25, 0.75 }) do
				local d = D0 + (i - 1 + f) * G
				local base = nose(d) + 0.35
				local top = nose(d) + RAIL_H
				if pal.Style == "Mansion" then
					kit:CylY("Baluster", railX, base, d, 0.2, top - base, pal.Baluster, pal.BalusterMat, { Shadow = false })
				else
					kit:Box("Baluster", railX - 0.075, railX + 0.075, base, top, d - 0.075, d + 0.075, pal.Baluster, pal.BalusterMat, { Shadow = false })
				end
			end
		end
	end
	-- poteau de départ (sur le sol, devant la 1re marche) : fût + chapeau + boule
	local nd0, nd1 = D0 - 0.62, D0 - 0.08
	kit:Box("Newel", railX - 0.27, railX + 0.27, y0, y0 + RAIL_H + 0.9, nd0, nd1, pal.Newel, pal.RailMat, { Solid = true, Shadow = false })
	kit:Box("NewelCap", railX - 0.34, railX + 0.34, y0 + RAIL_H + 0.9, y0 + RAIL_H + 1.05, nd0 - 0.07, nd1 + 0.07, pal.Rail, pal.RailMat, { Shadow = false })
	kit:Ball("NewelBall", railX, y0 + RAIL_H + 1.28, (nd0 + nd1) / 2, 0.46, pal.Accent, M.Metal, { Shadow = false })
	-- poteau d'arrivée (sur le palier du dessus, côté couloir)
	local ay = y0 + STORY
	kit:Box("NewelTop", railX - 0.25, railX + 0.25, ay - 0.9, ay + GUARD_H + 0.35, D1 - 0.2, D1 + 0.3, pal.Newel, pal.RailMat, { Solid = true, Shadow = false })
	kit:Box("NewelTopCap", railX - 0.32, railX + 0.32, ay + GUARD_H + 0.35, ay + GUARD_H + 0.5, D1 - 0.27, D1 + 0.37, pal.Rail, pal.RailMat, { Shadow = false })
	-- main courante murale sur 3 consoles (laiton), côté mur
	local wx = S1 - 0.42
	kit:Slab("WallRail", wx, { nose(D0 + 0.6) + RAIL_H, D0 + 0.6 }, { nose(D1 - 0.8) + RAIL_H, D1 - 0.8 }, 0.18, 0.16 * run.Cos, pal.Rail, pal.RailMat, { Shadow = false })
	for _, f in ipairs({ 0.12, 0.5, 0.88 }) do
		local d = D0 + 0.6 + f * (D1 - 0.8 - D0 - 0.6)
		local y = nose(d) + RAIL_H - 0.28
		kit:Box("WallRailBracket", wx + 0.02, S1 - 0.02, y - 0.06, y + 0.06, d - 0.06, d + 0.06, pal.Accent, M.Metal, { Shadow = false })
	end
end

-- Garde-corps du palier de l'étage `floor` autour de la trémie (volée du dessous)
local function landingGuard(kit: any, size: any, floor: number, floors: number, pal: Palette)
	local run = runOf(size)
	local y = WorldLayout.FloorY(floor)
	local x = run.S0 + 0.15
	local a, b = run.Hole0, run.D1 - 0.2
	local above = floor < floors -- une volée monte au-dessus de la trémie
	-- limon de la volée du dessus (repère de cet étage) : dessous à nez - 1,05
	local function limit(d: number): number
		if not above then
			return GUARD_H
		end
		return math.min(GUARD_H, nosing(run, d) + 0.35 - 1.4 - 0.08)
	end
	-- lisse basse (sur le plancher) + collision invisible
	kit:Box("GuardBase", x - 0.13, x + 0.13, y - 0.03, y + 0.22, a, b, pal.Trim, M.Wood, { Solid = true, Shadow = false })
	kit:Box("GuardWall", x - 0.15, x + 0.15, y, y + GUARD_H + 0.2, a, b, WHITE, M.SmoothPlastic, { Solid = true, Query = false, T = 1, Shadow = false })
	-- main courante là où elle passe sous le limon du dessus
	local railStart = a
	if above then
		railStart = run.D0 + (GUARD_H + 0.3 - run.R - 0.35 + 1.4) / run.R * run.G
	end
	if b - railStart > 0.5 then
		kit:Box("GuardRail", x - 0.17, x + 0.17, y + GUARD_H, y + GUARD_H + 0.24, railStart, b, pal.Rail, pal.RailMat, { Solid = true, Shadow = false })
	end
	local count = math.max(2, math.floor((b - a) / 0.75))
	for i = 0, count do
		local d = a + 0.2 + i * (b - a - 0.4) / count
		local top = limit(d)
		if top > 0.6 then
			if pal.Open then
				if i % 3 == 0 then
					kit:Box("GuardBaluster", x - 0.06, x + 0.06, y + 0.22, y + top, d - 0.06, d + 0.06, pal.Baluster, pal.BalusterMat, { Shadow = false })
				end
			elseif pal.Style == "Mansion" then
				kit:CylY("GuardBaluster", x, y + 0.22, d, 0.2, top - 0.22, pal.Baluster, pal.BalusterMat, { Shadow = false })
			else
				kit:Box("GuardBaluster", x - 0.075, x + 0.075, y + 0.22, y + top, d - 0.075, d + 0.075, pal.Baluster, pal.BalusterMat, { Shadow = false })
			end
		end
	end
	if pal.Open and b - railStart > 0.5 then
		for k = 1, 2 do
			local h = GUARD_H * k / 3
			kit:Box("GuardBar", x - 0.05, x + 0.05, y + h - 0.05, y + h + 0.05, math.max(railStart, a), b, pal.Baluster, pal.BalusterMat, { Shadow = false })
		end
	end
	-- poteau au bout de la trémie
	kit:Box("GuardPost", x - 0.25, x + 0.25, y, y + GUARD_H + 0.45, a - 0.25, a + 0.25, pal.Newel, pal.RailMat, { Solid = true, Shadow = false })
	if not above then
		-- dernier étage : garde-corps en travers, au bout de la trémie
		kit:Box("GuardRail", run.S0 + 0.3, run.S1, y + GUARD_H, y + GUARD_H + 0.24, a - 0.17, a + 0.17, pal.Rail, pal.RailMat, { Solid = true, Shadow = false })
		kit:Box("GuardBase", run.S0 + 0.3, run.S1, y - 0.03, y + 0.22, a - 0.12, a + 0.12, pal.Trim, M.Wood, { Solid = true, Shadow = false })
		for i = 1, 4 do
			local bx = run.S0 + 0.3 + i * (run.S1 - run.S0 - 0.3) / 5
			kit:Box("GuardBaluster", bx - 0.075, bx + 0.075, y + 0.22, y + GUARD_H, a - 0.075, a + 0.075, pal.Baluster, pal.BalusterMat, { Shadow = false })
		end
	end
end

-- Moulures de l'étage : cimaise + plinthes (mur de gauche), chambranles des passages
local function trims(kit: any, size: any, floor: number, pal: Palette)
	local h0, h1 = WorldLayout.HallSpan(size)
	local y = WorldLayout.FloorY(floor)
	local T, D = WorldLayout.WALL_T, WorldLayout.DEPTH
	local dFront, dBack = T, T + D
	local passages = WorldLayout.HallPassages(size)
	local run = runOf(size)
	for _, side in ipairs({ "Left", "Right" }) do
		local sx = if side == "Left" then 1 else -1
		local face = if side == "Left" then h0 + SKIN else h1 - SKIN
		local r0, r1 = math.min(face + sx * 0.03, face + sx * 0.28), math.max(face + sx * 0.03, face + sx * 0.28)
		local span = passages[side]
		local holes = if span then { { span[1], span[2], y, y + WorldLayout.PASS_H } } else {}
		if side == "Left" then
			if not pal.Open then
				kit:WallD("ChairRail", r0, r1, y + 3.3, y + 3.55, dFront, dBack, holes, pal.Trim, M.Wood, { Shadow = false })
			end
			kit:WallD("Skirting", r0, r1, y, y + 0.6, dFront, dBack, holes, pal.Trim, M.Wood, { Shadow = false })
		else
			-- mur de l'escalier : plinthe seulement devant la volée et après l'arrivée
			local pieces = { { dFront, run.D0 - 0.6 } }
			if span then
				table.insert(pieces, { run.D1 + 0.2, span[1] - 0.45 })
				table.insert(pieces, { span[2] + 0.45, dBack })
			else
				table.insert(pieces, { run.D1 + 0.2, dBack })
			end
			for _, piece in ipairs(pieces) do
				if piece[2] - piece[1] > 0.3 then
					kit:Box("Skirting", r0, r1, y, y + 0.6, piece[1], piece[2], pal.Trim, M.Wood, { Shadow = false })
				end
			end
		end
		if span then
			-- chambranle du passage (déborde de 0,04 dans l'ouverture)
			kit:Box("PassFrame", r0, r1, y, y + WorldLayout.PASS_H + 0.3, span[1] - 0.4, span[1] + 0.04, pal.Trim, M.Wood, { Shadow = false })
			kit:Box("PassFrame", r0, r1, y, y + WorldLayout.PASS_H + 0.3, span[2] - 0.04, span[2] + 0.4, pal.Trim, M.Wood, { Shadow = false })
			kit:Box("PassFrame", r0, r1, y + WorldLayout.PASS_H - 0.04, y + WorldLayout.PASS_H + 0.45, span[1] - 0.4, span[2] + 0.4, pal.Trim, M.Wood,
				{ Shadow = false })
		end
	end
end

-- Petite plaque GRAVÉE (laiton sur bois) : nom de l'étage + flèches
local function plaque(kit: any, size: any, floor: number, wall: number, p0: number, p1: number)
	local y = WorldLayout.FloorY(floor)
	kit:Box("FloorPlaqueBoard", wall, wall + 0.14, y + 4.35, y + 5.95, p0, p1, Color3.fromRGB(120, 78, 58), M.Wood, { Shadow = false })
	local plate = kit:Box("FloorPlaque", wall + 0.14, wall + 0.2, y + 4.5, y + 5.8, p0 + 0.15, p1 - 0.15, Color3.fromRGB(226, 184, 96), M.Metal, { Shadow = false })
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Engraving"
	gui.Face = Enum.NormalId.Right
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 60
	gui.LightInfluence = 1
	gui.MaxDistance = 60
	gui.Parent = plate
	local ink = Color3.fromRGB(78, 50, 32)
	local function line(text: string, y0: number, h: number, font: Enum.Font)
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(0.9, h)
		label.Position = UDim2.fromScale(0.05, y0)
		label.Font = font
		label.TextScaled = true
		label.TextColor3 = ink
		label.TextStrokeColor3 = Color3.fromRGB(255, 236, 190)
		label.TextStrokeTransparency = 0.55
		label.Text = text
		label.Parent = gui
	end
	line(floorName(floor), 0.1, 0.5, Enum.Font.Garamond)
	local hints = {}
	if floor > 1 then
		table.insert(hints, "⬇️ " .. floorName(floor - 1))
	end
	if floor < WorldLayout.Dims(size).Floors then
		table.insert(hints, "⬆️ " .. floorName(floor + 1))
	end
	if #hints > 0 then
		line(table.concat(hints, "   "), 0.62, 0.28, Enum.Font.GothamMedium)
	end
	for _, d in ipairs({ p0 + 0.08, p1 - 0.08 }) do
		kit:Ball("PlaqueScrew", wall + 0.17, y + 5.15, d, 0.12, Color3.fromRGB(246, 196, 84), M.Metal, { Shadow = false })
	end
end

-- Tableau encadré (mur de gauche) : toile peinte (dégradé ciel / collines)
local function painting(kit: any, wall: number, y0: number, y1: number, d0: number, d1: number, frame: Color3, seed: number)
	kit:Box("PictureFrame", wall, wall + 0.16, y0, y1, d0, d1, frame, M.Wood, { Shadow = false })
	local canvas = kit:Box("PictureCanvas", wall + 0.16, wall + 0.2, y0 + 0.3, y1 - 0.3, d0 + 0.3, d1 - 0.3, WHITE, M.SmoothPlastic, { Shadow = false })
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Art"
	gui.Face = Enum.NormalId.Right
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 24
	gui.LightInfluence = 1
	gui.MaxDistance = 70
	gui.Parent = canvas
	local skies = {
		{ Color3.fromRGB(255, 196, 170), Color3.fromRGB(150, 196, 240) },
		{ Color3.fromRGB(190, 220, 255), Color3.fromRGB(255, 226, 236) },
		{ Color3.fromRGB(255, 214, 150), Color3.fromRGB(222, 170, 220) },
	}
	local sky = skies[(seed - 1) % #skies + 1]
	local bg = Instance.new("Frame")
	bg.BorderSizePixel = 0
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = WHITE
	bg.Parent = gui
	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new(sky[2], sky[1])
	grad.Rotation = 90
	grad.Parent = bg
	-- soleil + collines (cercles aplatis)
	local function blob(x: number, y: number, w: number, h: number, color: Color3)
		local f = Instance.new("Frame")
		f.BorderSizePixel = 0
		f.BackgroundColor3 = color
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = UDim2.fromScale(x, y)
		f.Size = UDim2.fromScale(w, h)
		f.Parent = gui
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0.5, 0)
		c.Parent = f
	end
	blob(0.72, 0.3, 0.16, 0.2, Color3.fromRGB(255, 244, 200))
	blob(0.25, 0.95, 0.9, 0.6, Color3.fromRGB(120, 176, 110))
	blob(0.8, 1.0, 0.9, 0.5, Color3.fromRGB(96, 150, 96))
end

-- Plante en pot haute (pot, terre, feuillage en boules)
local function plant(kit: any, x: number, y: number, d: number, pot: Color3)
	kit:CylY("PlantPot", x, y, d, 1.3, 1.8, pot, M.SmoothPlastic, { Solid = true, Shadow = false })
	kit:CylY("PlantPotRim", x, y + 1.8, d, 1.45, 0.2, pot:Lerp(WHITE, 0.15), M.SmoothPlastic, { Shadow = false })
	kit:CylY("PlantSoil", x, y + 1.72, d, 1.15, 0.2, Color3.fromRGB(96, 70, 52), M.Ground, { Shadow = false })
	kit:CylY("PlantStem", x, y + 1.8, d, 0.16, 2.2, Color3.fromRGB(110, 86, 60), M.Wood, { Shadow = false })
	local leaf = Color3.fromRGB(76, 150, 88)
	for k, spec in ipairs({ { 0, 4.3, 0, 1.9 }, { 0.55, 3.6, 0.3, 1.4 }, { -0.5, 3.4, -0.35, 1.3 }, { 0.2, 5.1, -0.2, 1.2 }, { -0.4, 4.6, 0.45, 1.1 } }) do
		kit:Ball("PlantLeaves", x + spec[1], y + spec[2], d + spec[3], spec[4], leaf:Lerp(Color3.fromRGB(40, 110, 60), (k % 3) * 0.2), M.Grass, { Shadow = false })
	end
end

-- Placard sous la première volée (panneau en pente + petite porte + bout)
local function underStair(kit: any, size: any, pal: Palette)
	local run = runOf(size)
	local y0 = WorldLayout.FloorY(1)
	local x = run.S0 + 0.16
	-- dessous du limon (repère du sol) = nez + 0,35 - 1,4
	local function under(d: number): number
		return nosing(run, d) + 0.35 - 1.4
	end
	local dA = run.D0 + (1.05 - 0.35 + 0.3 - run.R) / run.R * run.G -- là où le dessous du limon est à 0,3
	local dB = run.D0 + (7.2 + 1.05 - run.R) / run.R * run.G -- là où il est à 7,2
	dB = math.min(dB, run.D1 - 3)
	local hA, hB = under(dA), under(dB)
	local panel = if pal.Style == "Mansion" then pal.Trim else pal.Dado
	-- partie rectangulaire (sous hA) + triangle (WedgePart : haut vers le fond)
	kit:Box("UnderStairLow", x - 0.12, x + 0.12, y0, y0 + hA, dA, dB, panel, M.Wood, { Solid = true, Shadow = false })
	local length = dB - dA
	local height = hB - hA
	local center = CFrame.new(x, y0 + hA + height / 2, -(dA + length / 2)) * CFrame.Angles(0, math.pi, 0)
	kit:Part("UnderStair", Vector3.new(0.24, height, length), center, panel, M.Wood, { Solid = true }, "WedgePart")
	-- bout du placard (côté fond), du sol au dessous du limon
	kit:Box("UnderStairEnd", x - 0.12, run.S1 - 0.02, y0, y0 + hB, dB, dB + 0.24, panel, M.Wood, { Solid = true, Shadow = false })
	-- petite porte (décor) + poignée + chambranle
	local door0, door1 = dB - 3.3, dB - 0.7
	local doorTop = math.min(y0 + 5.6, y0 + under(door0) - 0.25)
	kit:Box("ClosetDoor", x - 0.18, x - 0.12, y0 + 0.1, doorTop, door0, door1, panel:Lerp(pal.Trim, 0.5), M.Wood, { Shadow = false })
	kit:Box("ClosetFrame", x - 0.2, x - 0.12, doorTop, doorTop + 0.2, door0 - 0.15, door1 + 0.15, pal.Trim, M.Wood, { Shadow = false })
	kit:Ball("ClosetKnob", x - 0.26, y0 + 2.9, door0 + 0.35, 0.22, pal.Accent, M.Metal, { Shadow = false })
end

-- Hall d'entrée meublé (rez-de-chaussée)
local function foyer(kit: any, size: any, pal: Palette)
	local run = runOf(size)
	local y = WorldLayout.FloorY(1)
	local T = WorldLayout.WALL_T
	local c0, c1 = WorldLayout.CorridorSpan(size)
	local _, h1 = WorldLayout.HallSpan(size)
	local dBack = T + WorldLayout.DEPTH
	local passages = WorldLayout.HallPassages(size)
	local left = passages.Left
	local pass0 = if left then left[1] else dBack
	local wood = if pal.Style == "Loft" then Color3.fromRGB(60, 60, 68) else Color3.fromRGB(128, 84, 58)
	local woodMat = if pal.Style == "Loft" then M.Metal else M.Wood
	local mansion = pal.Style == "Mansion"

	-- paillasson intérieur + tapis de couloir (bordure + centre)
	local door = WorldLayout.DoorX(size)
	kit:Box("DoorMat", door - 2, door + 2, y, y + 0.05, T + 0.4, T + 2, Color3.fromRGB(150, 112, 78), M.Fabric, { Shadow = false })
	local rug = if pal.Runner then pal.Runner else Color3.fromRGB(150, 120, 96)
	local rx0, rx1 = c0 + 2, c1 - 1.1
	kit:Box("HallRugBorder", rx0, rx1, y, y + 0.05, T + 3.2, dBack - 2.8, rug:Lerp(BLACK, 0.25), M.Fabric, { Shadow = false })
	kit:Box("HallRug", rx0 + 0.4, rx1 - 0.4, y + 0.05, y + 0.08, T + 3.6, dBack - 3.2, rug:Lerp(Color3.fromRGB(250, 236, 220), 0.35), M.Fabric, { Shadow = false })
	-- paillasson de la porte de derrière
	local backX = WorldLayout.BackDoorX(size)
	kit:Box("BackDoorMat", backX - 2, backX + 2, y, y + 0.05, dBack - 1.9, dBack - 0.2, Color3.fromRGB(150, 112, 78), M.Fabric, { Shadow = false })

	if mansion then
		-- grand vestibule : guéridon rond + grand bouquet, au milieu du couloir
		local gx, gd = (c0 + c1) / 2, T + 5.2
		kit:CylY("FoyerTableBase", gx, y + 0.08, gd, 1.4, 0.2, pal.Accent, M.Metal, { Solid = true, Shadow = false })
		kit:CylY("FoyerTableLeg", gx, y + 0.28, gd, 0.45, 2.22, Color3.fromRGB(112, 50, 42), M.Wood, { Solid = true, Shadow = false })
		kit:CylY("FoyerTableTop", gx, y + 2.5, gd, 2.4, 0.22, Color3.fromRGB(240, 234, 232), M.Marble, { Solid = true, Shadow = true })
		kit:CylY("FoyerVase", gx, y + 2.72, gd, 0.8, 1.3, Color3.fromRGB(246, 244, 250), M.Glass, { Shadow = false })
		local blooms = { Color3.fromRGB(255, 150, 190), WHITE, Color3.fromRGB(255, 214, 120), Color3.fromRGB(236, 72, 140), Color3.fromRGB(200, 170, 250) }
		for k = 0, 6 do
			local a = k / 7 * math.pi * 2
			local r = if k == 0 then 0 else 0.55
			kit:Ball("FoyerBloom", gx + math.cos(a) * r, y + 4.35 + (k % 2) * 0.25 - (if k == 0 then -0.3 else 0), gd + math.sin(a) * r, 0.62,
				blooms[k % #blooms + 1], M.SmoothPlastic, { Shadow = false })
		end
		kit:Ball("FoyerLeaves", gx, y + 4.1, gd, 1.6, Color3.fromRGB(86, 150, 90), M.Grass, { Shadow = false })
		-- deux grandes urnes de part et d'autre du passage de gauche
		if left then
			for _, d in ipairs({ left[1] - 1.1, left[2] + 1.1 }) do
				kit:CylY("Urn", c0 + 0.9, y, d, 1.1, 2.6, Color3.fromRGB(246, 242, 250), M.Marble, { Solid = true, Shadow = false })
				kit:Ball("UrnPlant", c0 + 0.9, y + 3.2, d, 1.5, Color3.fromRGB(80, 146, 92), M.Grass, { Shadow = false })
			end
		end
	else
		-- console contre le mur de gauche (2,7 de haut) + tiroir + tablette basse
		local k0, k1 = T + 1.6, math.min(T + 6.4, pass0 - 1.1)
		local kx0, kx1 = c0 + 0.32, c0 + 1.55
		local topY = y + 2.7
		kit:Box("ConsoleTop", kx0, kx1 + 0.08, topY - 0.16, topY, k0 - 0.08, k1 + 0.08, wood, woodMat, { Solid = true, Shadow = true })
		kit:Box("ConsoleApron", kx0 + 0.08, kx1 - 0.02, topY - 0.62, topY - 0.16, k0 + 0.1, k1 - 0.1, wood, woodMat, { Solid = true, Shadow = false })
		kit:Box("ConsoleDrawer", kx1 - 0.02, kx1 + 0.02, topY - 0.56, topY - 0.22, k0 + 0.5, k1 - 0.5, wood:Lerp(WHITE, 0.08), woodMat, { Shadow = false })
		for _, d in ipairs({ (k0 * 2 + k1) / 3, (k0 + k1 * 2) / 3 }) do
			kit:Ball("ConsoleKnob", kx1 + 0.06, topY - 0.39, d, 0.14, pal.Accent, M.Metal, { Shadow = false })
		end
		for _, lx in ipairs({ kx0 + 0.2, kx1 - 0.2 }) do
			for _, ld in ipairs({ k0 + 0.2, k1 - 0.2 }) do
				kit:Box("ConsoleLeg", lx - 0.09, lx + 0.09, y, topY - 0.62, ld - 0.09, ld + 0.09, wood, woodMat, { Solid = true, Shadow = false })
			end
		end
		kit:Box("ConsoleShelf", kx0 + 0.1, kx1 - 0.1, y + 0.55, y + 0.67, k0 + 0.12, k1 - 0.12, wood, woodMat, { Shadow = false })
		-- sur la console : lampe (pied, abat-jour, ampoule), bouquet, vide-poche
		local ld = k0 + 0.8
		kit:CylY("ConsoleLampBase", (kx0 + kx1) / 2, topY, ld, 0.55, 0.12, pal.Accent, M.Metal, { Shadow = false })
		kit:CylY("ConsoleLampStem", (kx0 + kx1) / 2, topY + 0.12, ld, 0.12, 1.2, pal.Accent, M.Metal, { Shadow = false })
		kit:CylY("ConsoleLampShade", (kx0 + kx1) / 2, topY + 1.2, ld, 0.95, 0.8, Color3.fromRGB(255, 244, 226), M.Fabric, { Shadow = false })
		kit:Ball("ConsoleLampBulb", (kx0 + kx1) / 2, topY + 1.3, ld, 0.3, Color3.fromRGB(255, 226, 170), M.Neon, { Shadow = false })
		local vd = k1 - 0.8
		kit:CylY("ConsoleVase", (kx0 + kx1) / 2, topY, vd, 0.5, 0.9, Color3.fromRGB(120, 170, 200), M.Glass, { Shadow = false })
		for k, c in ipairs({ Color3.fromRGB(255, 150, 190), Color3.fromRGB(255, 226, 130), WHITE }) do
			kit:Ball("ConsoleBloom", (kx0 + kx1) / 2 + (k - 2) * 0.22, topY + 1.1 + (k % 2) * 0.18, vd + (k - 2) * 0.12, 0.34, c, M.SmoothPlastic, { Shadow = false })
		end
		kit:CylY("KeyBowl", (kx0 + kx1) / 2, topY, (k0 + k1) / 2, 0.7, 0.16, Color3.fromRGB(236, 220, 200), M.SmoothPlastic, { Shadow = false })
		-- grand miroir au-dessus (cadre + verre réfléchissant statique)
		local m0, m1 = k0 + 0.5, k1 - 0.5
		local my0, my1 = topY + 1.4, topY + 5.2
		kit:Box("HallMirrorFrame", c0, c0 + 0.14, my0, my1, m0, m1, pal.Accent, M.Metal, { Shadow = false })
		local glass = kit:Box("HallMirror", c0 + 0.14, c0 + 0.18, my0 + 0.22, my1 - 0.22, m0 + 0.22, m1 - 0.22, Color3.fromRGB(206, 218, 228), M.Glass,
			{ Shadow = false })
		glass.Reflectance = 0.35
	end

	-- porte-manteau (coin avant droit, devant la 1re marche, hors du battant)
	local cx, cd = h1 - SKIN - 1.05, T + 1.35
	if cd + 0.7 < run.D0 - 0.7 then
		kit:CylY("CoatStandBase", cx, y, cd, 1.3, 0.14, wood, woodMat, { Solid = true, Shadow = false })
		kit:CylY("CoatStandPole", cx, y + 0.14, cd, 0.22, 5.6, wood, woodMat, { Solid = true, Shadow = false })
		kit:Ball("CoatStandTop", cx, y + 5.85, cd, 0.36, wood, woodMat, { Shadow = false })
		for k = 0, 3 do
			local a = k / 4 * math.pi * 2 + math.pi / 4
			kit:Box("CoatHook", cx + math.cos(a) * 0.3 - 0.07, cx + math.cos(a) * 0.3 + 0.07, y + 5.05, y + 5.25, cd + math.sin(a) * 0.3 - 0.07,
				cd + math.sin(a) * 0.3 + 0.07, pal.Accent, M.Metal, { Shadow = false })
		end
		-- manteau (épaules + pan), écharpe, chapeau, parapluie
		local coat = if mansion then Color3.fromRGB(150, 40, 70) else Color3.fromRGB(196, 150, 104)
		kit:Box("Coat", cx - 0.55, cx + 0.15, y + 2.4, y + 4.9, cd - 0.62, cd - 0.2, coat, M.Fabric, { Shadow = false })
		kit:Ball("CoatShoulder", cx - 0.2, y + 4.85, cd - 0.41, 0.62, coat, M.Fabric, { Shadow = false })
		kit:Box("Scarf", cx + 0.1, cx + 0.34, y + 3.4, y + 5.1, cd + 0.12, cd + 0.36, Color3.fromRGB(236, 110, 140), M.Fabric, { Shadow = false })
		kit:CylY("HatBrim", cx, y + 5.95, cd, 0.9, 0.06, Color3.fromRGB(70, 60, 64), M.Fabric, { Shadow = false })
		kit:CylY("HatCrown", cx, y + 6.0, cd, 0.56, 0.4, Color3.fromRGB(70, 60, 64), M.Fabric, { Shadow = false })
		kit:Box("Umbrella", cx + 0.3, cx + 0.48, y + 0.14, y + 3.1, cd + 0.3, cd + 0.48, Color3.fromRGB(60, 90, 150), M.Fabric, { Shadow = false })
		kit:Box("UmbrellaHandle", cx + 0.3, cx + 0.48, y + 3.1, y + 3.4, cd + 0.3, cd + 0.66, Color3.fromRGB(90, 60, 44), M.Wood, { Shadow = false })
	end

	-- banc de rangement + coussin (mur de gauche, derrière le passage)
	local b0 = (if left then left[2] else T + 10) + (if mansion then 2.2 else 1.2)
	local b1 = math.min(b0 + 4.4, dBack - 3.4)
	if b1 - b0 > 2.5 and mansion then
		painting(kit, c0, y + 3.9, y + 8.4, b0, b1, pal.Accent, 2)
	elseif b1 - b0 > 2.5 then
		kit:Box("HallBench", c0 + 0.32, c0 + 1.7, y, y + 1.2, b0, b1, wood, woodMat, { Solid = true, Shadow = true })
		kit:Box("HallBenchCushion", c0 + 0.4, c0 + 1.62, y + 1.2, y + 1.45, b0 + 0.1, b1 - 0.1, if pal.Runner then pal.Runner:Lerp(WHITE, 0.45) else Color3.fromRGB(236, 214, 190),
			M.Fabric, { Shadow = false })
		-- deux paires de chaussures sous le banc
		for k = 0, 1 do
			local sd = b0 + 0.8 + k * 1.6
			kit:Box("Shoe", c0 + 0.8, c0 + 1.55, y, y + 0.3, sd - 0.2, sd + 0.2, if k == 0 then Color3.fromRGB(236, 110, 140) else Color3.fromRGB(80, 70, 76), M.Fabric,
				{ Shadow = false })
		end
		painting(kit, c0, y + 4.2, y + 7.6, b0 + 0.2, b1 - 0.2, wood, 1)
	end
	-- plante haute (coin arrière gauche, à côté de la porte de derrière)
	plant(kit, c0 + 1.05, y, dBack - 1.2, if pal.Style == "Loft" then Color3.fromRGB(70, 70, 78) else Color3.fromRGB(236, 226, 214))
	-- placard sous l'escalier (sauf loft : escalier ouvert, un vélo dessous)
	if WorldLayout.Dims(size).Floors >= 2 then
		if pal.Open then
			local bd = run.D0 + 9
			kit:CylX("BikeWheel", run.S0 + 2.1, y + 1.1, bd - 1.4, 2.2, 0.16, Color3.fromRGB(30, 30, 34), M.Rubber, { Shadow = false })
			kit:CylX("BikeWheel", run.S0 + 2.1, y + 1.1, bd + 1.4, 2.2, 0.16, Color3.fromRGB(30, 30, 34), M.Rubber, { Shadow = false })
			kit:Slab("BikeFrame", run.S0 + 2.1, { y + 2.3, bd - 1.3 }, { y + 2.3, bd + 1.2 }, 0.14, 0.14, Color3.fromRGB(236, 110, 90), M.Metal, { Shadow = false })
			kit:Slab("BikeFrame", run.S0 + 2.1, { y + 2.3, bd - 0.4 }, { y + 1.1, bd + 1.4 }, 0.14, 0.14, Color3.fromRGB(236, 110, 90), M.Metal, { Shadow = false })
			kit:Box("BikeSeat", run.S0 + 1.95, run.S0 + 2.25, y + 2.5, y + 2.65, bd - 0.9, bd - 0.2, Color3.fromRGB(30, 30, 34), M.Fabric, { Shadow = false })
		else
			underStair(kit, size, pal)
		end
	end
end

-- Lampe de plafond d'un étage (lanterne / lustre / plafonnier)
local function ceilingLamp(kit: any, size: any, floor: number, pal: Palette, withLight: boolean)
	local c0, c1 = WorldLayout.CorridorSpan(size)
	local y = WorldLayout.FloorY(floor) + WorldLayout.WALL_H
	local x = (c0 + c1) / 2
	local d = if floor == 1 then WorldLayout.WALL_T + 5.4 else WorldLayout.WALL_T + WorldLayout.DEPTH / 2
	local warm = Color3.fromRGB(255, 226, 180)
	local bulb: BasePart
	if pal.Style == "Mansion" and floor == 1 then
		-- lustre : rosace, tige, anneau doré, 6 bougies à ampoule, pampilles
		kit:CylY("ChandelierRose", x, y - 0.2, d, 1.4, 0.2, pal.Trim, M.SmoothPlastic, { Shadow = false })
		kit:Box("ChandelierRod", x - 0.07, x + 0.07, y - 2.4, y - 0.2, d - 0.07, d + 0.07, pal.Accent, M.Metal, { Shadow = false })
		kit:Ball("ChandelierHub", x, y - 2.75, d, 0.7, pal.Accent, M.Metal, { Shadow = false })
		for k = 0, 5 do
			local a = k / 6 * math.pi * 2
			local bx, bd = x + math.cos(a) * 1.5, d + math.sin(a) * 1.5
			-- bras fin du moyeu à la bougie (plus de disque plein vu d'en dessous)
			kit:Part("ChandelierArm", Vector3.new(1.5, 0.1, 0.1), CFrame.new(x + math.cos(a) * 0.75, y - 2.72, -(d + math.sin(a) * 0.75)) * CFrame.Angles(0, a, 0),
				pal.Accent, M.Metal, { Shadow = false })
			kit:CylY("ChandelierCup", bx, y - 2.75, bd, 0.42, 0.12, pal.Accent, M.Metal, { Shadow = false })
			kit:CylY("ChandelierCandle", bx, y - 2.55, bd, 0.2, 0.45, WHITE, M.SmoothPlastic, { Shadow = false })
			local flame = kit:Ball("ChandelierBulb", bx, y - 1.95, bd, 0.28, Color3.fromRGB(255, 232, 186), M.Neon, { Shadow = false })
			if k == 0 then
				bulb = flame
			end
			kit:Ball("ChandelierCrystal", x + math.cos(a + 0.5) * 1.2, y - 3.15, d + math.sin(a + 0.5) * 1.2, 0.22, Color3.fromRGB(236, 244, 255), M.Glass,
				{ Shadow = false })
		end
		bulb = bulb or kit:Ball("ChandelierBulb", x, y - 2.95, d, 0.3, warm, M.Neon, { Shadow = false })
	elseif floor == 1 then
		-- lanterne suspendue : rosace, chaîne, cage + verre, ampoule
		kit:CylY("LanternRose", x, y - 0.2, d, 1, 0.2, pal.Trim, M.SmoothPlastic, { Shadow = false })
		kit:Box("LanternChain", x - 0.05, x + 0.05, y - 2, y - 0.2, d - 0.05, d + 0.05, pal.Accent, M.Metal, { Shadow = false })
		kit:Box("LanternCap", x - 0.55, x + 0.55, y - 2.25, y - 2, d - 0.55, d + 0.55, pal.Accent, M.Metal, { Shadow = false })
		kit:Box("LanternGlass", x - 0.45, x + 0.45, y - 3.5, y - 2.25, d - 0.45, d + 0.45, Color3.fromRGB(255, 246, 226), M.Glass, { T = 0.45, Shadow = false })
		kit:Box("LanternBottom", x - 0.55, x + 0.55, y - 3.7, y - 3.5, d - 0.55, d + 0.55, pal.Accent, M.Metal, { Shadow = false })
		bulb = kit:Ball("LanternBulb", x, y - 2.85, d, 0.4, warm, M.Neon, { Shadow = false })
	else
		-- plafonnier du palier (vasque en verre dépoli)
		kit:CylY("CeilingRose", x, y - 0.15, d, 1.3, 0.15, pal.Trim, M.SmoothPlastic, { Shadow = false })
		bulb = kit:Ball("LandingLamp", x, y - 0.35, d, 1.1, Color3.fromRGB(255, 240, 214), M.SmoothPlastic, { Shadow = false })
	end
	if withLight then
		kit:Light(bulb, Color3.fromRGB(255, 222, 176), 20, 0.8)
	end
end

function HouseStairs.BuildInterior(kit: any, size: any): InteriorResult
	local dims = WorldLayout.Dims(size)
	local floors = dims.Floors
	local pal = HouseStairs.Palette(size)
	local ramps: { BasePart } = {}
	local before = kit.Stats.Count
	local c0 = WorldLayout.CorridorSpan(size)
	local passages = WorldLayout.HallPassages(size)
	local left = passages.Left
	local T = WorldLayout.WALL_T
	for floor = 1, floors do
		trims(kit, size, floor, pal)
		if floor < floors then
			flight(kit, size, floor, pal, ramps)
		end
		if floor >= 2 then
			landingGuard(kit, size, floor, floors, pal)
		end
		-- plaque gravée aux étages (mur de gauche, derrière le passage : on la
		-- voit en arrivant par l'escalier)
		if floor >= 2 then
			local p0 = (if left then left[2] else T + 12) + 0.8
			plaque(kit, size, floor, c0, p0, p0 + 2.6)
		end
		ceilingLamp(kit, size, floor, pal, floor <= 2)
		if floor >= 2 then
			-- palier : tableau (mur de gauche, devant) + plante (coin du fond) + tapis
			painting(kit, c0, WorldLayout.FloorY(floor) + 4.2, WorldLayout.FloorY(floor) + 7.4, T + 1.6, T + 5.6, if pal.Style == "Mansion" then pal.Accent else pal.Rail,
				floor)
			plant(kit, c0 + 1.05, WorldLayout.FloorY(floor), T + WorldLayout.DEPTH - 1.2, if pal.Style == "Loft" then Color3.fromRGB(70, 70, 78) else Color3.fromRGB(236, 226, 214))
			local cx0, cx1 = WorldLayout.CorridorSpan(size)
			local y = WorldLayout.FloorY(floor)
			local rug = if pal.Runner then pal.Runner else Color3.fromRGB(150, 120, 96)
			kit:Box("LandingRug", cx0 + 1.4, cx1 - 1.2, y, y + 0.05, T + 7, T + WorldLayout.DEPTH - 3, rug:Lerp(Color3.fromRGB(250, 236, 220), 0.3), M.Fabric,
				{ Shadow = false })
		end
	end
	foyer(kit, size, pal)
	return { Ramps = ramps, Parts = kit.Stats.Count - before, Lights = kit.Stats.Lights }
end

-- (compat) coque + intérieur dans le même kit
function HouseStairs.Build(kit: any, size: any, _colors: Colors?): Result
	local before = kit.Stats.Count
	HouseStairs.BuildShell(kit, size)
	local inside = HouseStairs.BuildInterior(kit, size)
	local holes = {}
	local h0, h1 = WorldLayout.StairHole(size)
	for floor = 2, WorldLayout.Dims(size).Floors do
		table.insert(holes, { floor, h0, h1 })
	end
	return { Ramps = inside.Ramps, Holes = holes, Parts = kit.Stats.Count - before }
end

return HouseStairs
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="206">
          <Properties>
            <string name="Name">HouseToggles</string>
            <string name="Source"><![CDATA[--[[
	HouseToggles (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > HouseToggles

	🚶 Dopamine Town (v9.8, HOUSE98) : ce qui s'allume, s'éteint, s'ouvre et
	se ferme dans une pièce de la maison 3D :
	  - 🪟 RIDEAUX d'une fenêtre (v9.9 HOUSE99 : refaits) : tringle ronde à
	    anneaux, voilages translucides + doubles rideaux jusqu'au sol en 5
	    plis (alternés en relief et en teinte), drapés sur le côté par une
	    embrasse quand ils sont ouverts ; animation douce (Sine, plis décalés) ;
	  - 💡 INTERRUPTEUR mural : plaque + bascule qui pivote (haut = allumé) ;
	  - groupe de LUMIÈRES d'une pièce (plafonnier + lampes posées) : fondu de
	    la luminosité des vraies lumières, ampoules "Neon" qui s'éteignent
	    (matière + couleur gardées pour les rallumer).
	Tout est décor (ancré, sans collision, sans ombre) ; aucune interface ici :
	HouseBuilder pose les invites (ProximityPrompt) et sauvegarde l'état.

	API :
	  HouseToggles.Curtains(parent, cf, width, height, color, rodColor, open, opts?) -> Curtain
	      opts.Drop = distance du centre de la fenêtre à l'ourlet (rideaux jusqu'au sol)
	      cf = centre de la fenêtre sur la face INTÉRIEURE du mur, RightVector
	      le long de la fenêtre, LookVector = de la pièce VERS le mur
	  curtain:Set(open, animate)
	  HouseToggles.Switch(parent, cf, on) -> Switch   (cf : sur le mur, LookVector vers le mur)
	  switch:Set(on, animate)
	  HouseToggles.Lights() -> Lights ; lights:Add(light) ; lights:AddGlow(part)
	  lights:Collect(model, onlyLamps) ; lights:Set(on, animate)
]]

local TweenService = game:GetService("TweenService")

local HouseToggles = {}

local M = Enum.Material
local CURTAIN_TIME = 0.95
local SWITCH_TIME = 0.12
local FADE_TIME = 0.35

local function tween(instance: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?)
	local ok = pcall(function()
		TweenService:Create(instance, TweenInfo.new(time, style or Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), goal):Play()
	end)
	if not ok then
		for key, value in pairs(goal) do
			(instance :: any)[key] = value
		end
	end
end

local function decor(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		p.Shape = shape
	end
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.Parent = parent
	return p
end

----------------------------------------------------------------------
-- 🪟 Rideaux (v9.9 HOUSE99 : "100x plus réalistes")
----------------------------------------------------------------------
-- Une fenêtre = tringle ronde (embouts à boule, 2 supports), anneaux qui
-- glissent sur la tringle, 2 VOILAGES (translucides, contre la vitre) et 2
-- DOUBLES RIDEAUX jusqu'au sol, chacun en 5 plis de 2 morceaux (au-dessus /
-- au-dessous de l'embrasse) : plis alternés en profondeur et en teinte ;
-- ouverts = drapés sur le côté, serrés par une EMBRASSE (bande) puis évasés
-- en bas ; fermés = tombés droits jusqu'au milieu. Animation douce (Sine
-- InOut, plis légèrement décalés), tout en CFrame + Size (TweenService).
-- Le tissu garde une teinte moyenne (jamais une plaque sombre).

export type Curtain = {
	Parts: { BasePart },
	Open: { { CFrame: CFrame, Size: Vector3, T: number? } },
	Closed: { { CFrame: CFrame, Size: Vector3, T: number? } },
	Delays: { number },
	IsOpen: boolean,
	Anchor: BasePart,
	Strips: { BasePart }, -- (compat v9.8 : les plis)
	Set: (self: Curtain, open: boolean, animate: boolean) -> (),
}

export type CurtainOptions = {
	Drop: number?, -- distance du centre de la fenêtre à l'ourlet (défaut : jusque sous l'appui)
}

local Curtain = {}
Curtain.__index = Curtain

local FOLD_COUNT = 5

function Curtain.Set(self: Curtain, open: boolean, animate: boolean)
	self.IsOpen = open
	local goals = open and self.Open or self.Closed
	for index, part in ipairs(self.Parts) do
		local goal = goals[index]
		if part.Parent then
			if animate then
				local props: { [string]: any } = { CFrame = goal.CFrame, Size = goal.Size }
				if goal.T ~= nil then
					props.Transparency = goal.T
				end
				local delayTime = self.Delays[index] or 0
				local ok = pcall(function()
					TweenService:Create(part, TweenInfo.new(CURTAIN_TIME, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 0, false, delayTime), props):Play()
				end)
				if not ok then
					part.CFrame = goal.CFrame
					part.Size = goal.Size
					if goal.T ~= nil then
						part.Transparency = goal.T
					end
				end
			else
				part.CFrame = goal.CFrame
				part.Size = goal.Size
				if goal.T ~= nil then
					part.Transparency = goal.T
				end
			end
		end
	end
end

-- Teinte du tissu : jamais trop sombre ni criarde (tissu éclairé par la pièce)
local function fabricTone(color: Color3): Color3
	local h, sat, v = color:ToHSV()
	return Color3.fromHSV(h, math.min(sat, 0.62), math.clamp(v, 0.62, 0.97))
end

function HouseToggles.Curtains(parent: Instance, cf: CFrame, width: number, height: number, color: Color3, rodColor: Color3, open: boolean,
	options: CurtainOptions?): Curtain
	local w, h = math.max(1, width), math.max(1, height)
	local opts: CurtainOptions = options or {}
	local base = fabricTone(color)
	local shade = base:Lerp(Color3.new(0, 0, 0), 0.16)
	local light = base:Lerp(Color3.new(1, 1, 1), 0.1)
	-- (repère de `cf` : +X le long de la fenêtre, +Z = vers la pièce)
	local rodOut = 0.95 -- tringle à 0,95 du mur (plis au-delà de l'appui intérieur)
	local rodY = h / 2 + 0.75
	local side = 2.2 -- les rideaux ouverts se rangent à côté de la fenêtre
	local rodLength = w + 2 * (side + 0.25)
	local function at(x: number, y: number, z: number): CFrame
		return cf * CFrame.new(x, y, z)
	end
	local rod = decor(parent, "CurtainRod", Vector3.new(rodLength, 0.16, 0.16), at(0, rodY, rodOut), rodColor, M.Metal, Enum.PartType.Cylinder)
	rod.Reflectance = 0.12
	for _, s in ipairs({ -1, 1 }) do
		decor(parent, "CurtainFinial", Vector3.new(0.38, 0.38, 0.38), at(s * (rodLength / 2 + 0.12), rodY, rodOut), rodColor, M.Metal, Enum.PartType.Ball)
		-- support (du mur à la tringle)
		decor(parent, "CurtainBracket", Vector3.new(0.12, 0.14, rodOut + 0.05), at(s * (rodLength / 2 - 0.45), rodY + 0.04, rodOut / 2), rodColor, M.Metal)
	end
	local parts: { BasePart } = {}
	local openGoals, closedGoals = {}, {}
	local delays: { number } = {}
	local folds: { BasePart } = {}
	local function add(part: BasePart, openGoal: any, closedGoal: any, delayTime: number)
		table.insert(parts, part)
		table.insert(openGoals, openGoal)
		table.insert(closedGoals, closedGoal)
		table.insert(delays, delayTime)
	end
	-- un morceau de pli : du point a (haut) au point b (bas), dans le plan de la fenêtre
	local function segment(ax: number, ay: number, bx: number, by: number, z: number, widthA: number, widthB: number): { CFrame: CFrame, Size: Vector3 }
		local dx, dy = bx - ax, by - ay
		local length = math.max(0.1, math.sqrt(dx * dx + dy * dy))
		local roll = math.atan2(dx, -dy)
		return {
			CFrame = at((ax + bx) / 2, (ay + by) / 2, z) * CFrame.Angles(0, 0, roll),
			Size = Vector3.new(math.max(0.12, (widthA + widthB) / 2 + 0.05), length, 0.1),
		}
	end
	local top = rodY - 0.24
	local bottom = -(opts.Drop or (h / 2 + 0.8)) + 0.1
	local tieY = bottom + 0.42 * (top - bottom)
	local F = FOLD_COUNT
	for panel, s in ipairs({ -1, 1 }) do
		local outer = s * (w / 2 + side)
		local inner = -s * 0.1 -- fermés : se croisent de 0,1 au milieu
		local closedW = math.abs(outer - inner) / F
		local openTop, tieW, botW = 2.0 / F, 0.62 / F, 1.55 / F
		local tieCenter = outer - s * 0.8
		local zPanel = rodOut + (if panel == 2 then 0.035 else 0) -- (pas de faces confondues au milieu)
		for f = 1, F do
			local z = zPanel + (if f % 2 == 0 then 0.11 else -0.02)
			local tone = if f % 2 == 0 then shade elseif f == F then light else base
			-- fermés : tombés droits
			local cx = outer - s * (f - 0.5) * closedW
			local closedUp = segment(cx, top, cx, tieY, z, closedW, closedW)
			local closedLow = segment(cx, tieY, cx, bottom, z, closedW, closedW)
			-- ouverts : haut serré sous la tringle, embrasse, bas évasé
			local xTop = outer - s * (f - 0.5) * openTop
			local xTie = tieCenter + s * 0.31 - s * (f - 0.5) * tieW
			local xBot = outer + s * 0.05 - s * (f - 0.5) * botW
			local openUp = segment(xTop, top, xTie, tieY, z, openTop, tieW)
			local openLow = segment(xTie, tieY, xBot, bottom, z, tieW, botW)
			for k, pair in ipairs({ { openUp, closedUp }, { openLow, closedLow } }) do
				local part = decor(parent, "Curtain", pair[2].Size, pair[2].CFrame, tone, M.Fabric)
				table.insert(folds, part)
				-- (le pli du bord mène le mouvement, les autres suivent)
				add(part, pair[1], pair[2], (F - f) * 0.03 + (k - 1) * 0.02)
			end
		end
		-- anneaux sur la tringle (3 par rideau)
		for r = 1, 3 do
			local xOpen = outer - s * (0.25 + (r - 1) * 0.8)
			local xClosed = outer - s * (0.3 + (r - 1) * (math.abs(outer - inner) - 0.6) / 2)
			local ring = decor(parent, "CurtainRing", Vector3.new(0.08, 0.34, 0.34), at(xClosed, rodY, rodOut), rodColor, M.Metal, Enum.PartType.Cylinder)
			add(ring, { CFrame = at(xOpen, rodY, rodOut), Size = ring.Size }, { CFrame = ring.CFrame, Size = ring.Size }, (3 - r) * 0.05)
		end
		-- embrasse : visible quand ils sont ouverts
		local band = decor(parent, "CurtainTieBack", Vector3.new(0.9, 0.24, 0.34), at(tieCenter, tieY, zPanel + 0.05), base:Lerp(rodColor, 0.5), M.Fabric)
		add(band, { CFrame = band.CFrame, Size = band.Size, T = 0 }, { CFrame = band.CFrame, Size = band.Size, T = 1 }, 0)
		-- voilage (translucide, contre la vitre) : suit les rideaux
		local sheerOuter = s * (w / 2 + 1.4)
		local zSheer = rodOut - 0.22 + (if panel == 2 then 0.03 else 0)
		local sheerH = top - bottom
		local sheer = decor(parent, "CurtainSheer", Vector3.new(1, sheerH, 0.05), at(0, (top + bottom) / 2, zSheer), Color3.fromRGB(252, 250, 246), M.Fabric)
		sheer.Transparency = 0.62
		local closedSheerW = math.abs(sheerOuter) + 0.08
		add(sheer, { CFrame = at(sheerOuter - s * 0.5, (top + bottom) / 2, zSheer), Size = Vector3.new(1, sheerH, 0.05) },
			{ CFrame = at(sheerOuter - s * closedSheerW / 2, (top + bottom) / 2, zSheer), Size = Vector3.new(closedSheerW, sheerH, 0.05) }, 0.12)
	end
	-- point d'accroche de l'invite (milieu de la fenêtre, dans la pièce)
	local anchor = decor(parent, "CurtainPrompt", Vector3.new(0.4, 0.4, 0.4), cf * CFrame.new(0, 0, 1.6), color, M.SmoothPlastic)
	anchor.Transparency = 1
	local self = setmetatable({
		Parts = parts,
		Open = openGoals,
		Closed = closedGoals,
		Delays = delays,
		IsOpen = open,
		Anchor = anchor,
		Strips = folds,
	}, Curtain) :: any
	self:Set(open, false)
	return self
end

----------------------------------------------------------------------
-- 💡 Interrupteur
----------------------------------------------------------------------

export type Switch = {
	Plate: BasePart,
	Rocker: BasePart,
	Base: CFrame,
	IsOn: boolean,
	Set: (self: Switch, on: boolean, animate: boolean) -> (),
}

local Switch = {}
Switch.__index = Switch

local TILT = math.rad(14)

function Switch.Set(self: Switch, on: boolean, animate: boolean)
	self.IsOn = on
	-- bascule : haut enfoncé = allumé (on appuie en haut)
	local goal = self.Base * CFrame.Angles(if on then -TILT else TILT, 0, 0)
	if animate then
		tween(self.Rocker, SWITCH_TIME, { CFrame = goal }, Enum.EasingStyle.Quad)
	else
		self.Rocker.CFrame = goal
	end
	local led = self.Plate:FindFirstChild("Led")
	if led and led:IsA("BasePart") then
		led.Color = if on then Color3.fromRGB(255, 214, 140) else Color3.fromRGB(120, 200, 255)
	end
end

function HouseToggles.Switch(parent: Instance, cf: CFrame, on: boolean): Switch
	-- (repère de `cf` : +Z = vers la pièce ; la plaque dépasse du mur de 0,01..0,09)
	local plate = decor(parent, "SwitchPlate", Vector3.new(0.62, 0.95, 0.08), cf * CFrame.new(0, 0, 0.05), Color3.fromRGB(252, 248, 244), M.SmoothPlastic)
	plate.CanQuery = true -- (clic / invite)
	local rocker = decor(parent, "SwitchRocker", Vector3.new(0.3, 0.44, 0.12), cf * CFrame.new(0, 0, 0.12), Color3.fromRGB(255, 255, 255), M.SmoothPlastic)
	-- petit voyant (repère dans le noir), sous la bascule
	decor(plate, "Led", Vector3.new(0.1, 0.06, 0.03), cf * CFrame.new(0, -0.36, 0.1), Color3.fromRGB(255, 214, 140), M.SmoothPlastic)
	local self = setmetatable({
		Plate = plate,
		Rocker = rocker,
		Base = cf * CFrame.new(0, 0, 0.12),
		IsOn = on,
	}, Switch) :: any
	self:Set(on, false)
	return self
end

----------------------------------------------------------------------
-- Groupe de lumières d'une pièce
----------------------------------------------------------------------

export type Lights = {
	Items: { { Light: Light, Base: number } },
	Glows: { { Part: BasePart, Material: Enum.Material, Color: Color3 } },
	IsOn: boolean,
	Add: (self: Lights, light: Light) -> (),
	AddGlow: (self: Lights, part: BasePart) -> (),
	Collect: (self: Lights, root: Instance, glows: boolean) -> number,
	Set: (self: Lights, on: boolean, animate: boolean) -> (),
}

local LightGroup = {}
LightGroup.__index = LightGroup

function LightGroup.Add(self: Lights, light: Light)
	local base = tonumber(light:GetAttribute("BaseBrightness")) or light.Brightness
	light:SetAttribute("BaseBrightness", base)
	table.insert(self.Items, { Light = light, Base = base })
end

function LightGroup.AddGlow(self: Lights, part: BasePart)
	table.insert(self.Glows, { Part = part, Material = part.Material, Color = part.Color })
end

-- Toutes les vraies lumières sous `root` (+ ses pièces "Neon" si `glows`)
function LightGroup.Collect(self: Lights, root: Instance, glows: boolean): number
	local count = 0
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("PointLight") or d:IsA("SpotLight") or d:IsA("SurfaceLight") then
			self:Add(d :: Light)
			count += 1
		elseif glows and d:IsA("BasePart") and d.Material == M.Neon then
			self:AddGlow(d)
		end
	end
	return count
end

function LightGroup.Set(self: Lights, on: boolean, animate: boolean)
	self.IsOn = on
	for _, entry in ipairs(self.Items) do
		local light = entry.Light
		if light.Parent then
			if on then
				light.Enabled = true
				if animate then
					light.Brightness = 0
					tween(light, FADE_TIME, { Brightness = entry.Base })
				else
					light.Brightness = entry.Base
				end
			elseif animate then
				tween(light, FADE_TIME, { Brightness = 0 })
				task.delay(FADE_TIME + 0.05, function()
					if not self.IsOn and light.Parent then
						light.Enabled = false
					end
				end)
			else
				light.Brightness = 0
				light.Enabled = false
			end
		end
	end
	for _, glow in ipairs(self.Glows) do
		local part = glow.Part
		if part.Parent then
			if on then
				part.Material = glow.Material
				part.Color = glow.Color
			else
				-- ampoule éteinte : verre dépoli un peu grisé
				part.Material = M.SmoothPlastic
				part.Color = glow.Color:Lerp(Color3.fromRGB(150, 146, 160), 0.45)
			end
		end
	end
end

function HouseToggles.Lights(): Lights
	return setmetatable({ Items = {}, Glows = {}, IsOn = true }, LightGroup) :: any
end

return HouseToggles
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="207">
          <Properties>
            <string name="Name">Knockdown</string>
            <string name="Source"><![CDATA[--[[
	Knockdown (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > Knockdown

	💥 v10 (PHYS10) : se faire renverser, façon DESSIN ANIMÉ, côté client.
	Règles et chiffres : Shared/ImpactRules ; serveur : ImpactService.

	  1. RENVERSÉ (choc >= 12 studs/s) : ragdoll (Motor6D -> BallSocket /
	     charnières, R15 et R6), élan dans le sens de la voiture + vers le
	     haut, petite culbute ; ⭐ étoiles qui tournent autour de la tête ;
	     après 2,5 s au sol : ANIMATION pour se relever (sur le dos : on
	     ramène les genoux, on s'assoit, on se redresse ; sur le ventre : on
	     pousse sur les bras, à genoux, debout), puis les commandes reviennent.
	     Jamais de mort, jamais de perte de vie.
	  2. TITUBE (choc léger, 4,5 à 12 studs/s) : petite poussée, le buste
	     bascule, les bras battent l'air, on se rattrape.
	  3. CIRCULATION D'AMBIANCE (TownTraffic, locale) : ses voitures
	     deviennent SOLIDES pour nous (boîte racine, groupe "voitures") et
	     on les détecte ici, à chaque image (les voitures des joueurs : le
	     serveur). On tombe tout de suite et on prévient le serveur (ragdoll
	     répliqué + étoiles chez les autres).
	  4. LES AUTRES JOUEURS : leurs étoiles, leur "se relever" et leur
	     titubement sont animés ici aussi (attributs du personnage, heure du
	     serveur), le corps au sol vient de la physique répliquée.
	  5. PNJ : une voiture qui arrive vite -> le passant saute de côté (ou se
	     fait bousculer s'il est trop tard) : ImpactRules.StartNpcReact,
	     appliqué par NPCModels.Animate. Jamais inerte pour de bon.
	  6. DESCENDRE DE VOITURE : on sort par la portière (côté conducteur, ou
	     l'autre côté, ou derrière si c'est bouché) et, ~1 s, on ne cogne pas
	     SA voiture (groupe "Riders") : jamais coincé dans la carrosserie.
	  Robuste : toute erreur -> tout est remis (articulations, groupes,
	  vitesse de marche) ; Stop() remet tout.

	Crochets TownClient :
	  - à l'entrée en ville : Knockdown.Start({ Toast = toast })
	  - à la sortie         : Knockdown.Stop()
	(le module a ses propres Heartbeat / Stepped : rien à appeler en flux)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")

local Net = require(ReplicatedStorage.Shared.Net)
local ImpactRules = require(ReplicatedStorage.Shared.ImpactRules)
local Locale = require(ReplicatedStorage.Shared.Locale)

local Knockdown = {}

Knockdown.TRAFFIC_FOLDER = "TownTraffic"
Knockdown.CARS_FOLDER = "DopamineCars"
Knockdown.MOVER_TAG = "DopamineMover"
Knockdown.FX_FOLDER = "DopaKnockFx"
Knockdown.SCAN_INTERVAL = 0.25 -- (s) liste des véhicules / des autres joueurs
Knockdown.NPC_INTERVAL = 0.1 -- (s) réactions des PNJ
Knockdown.NPC_MIN_SPEED = 6 -- (studs/s) un PNJ réagit aux voitures plus rapides
Knockdown.NEAR = 70 -- (studs) véhicules testés pour nous renverser
Knockdown.OTHERS_RADIUS = 120 -- (studs) autres joueurs animés…
Knockdown.OTHERS_MAX = 8 -- …au plus
Knockdown.GRACE_MAX = 3 -- (s) au plus en groupe "Riders" après être descendu

local LocalPlayer = Players.LocalPlayer

type Mover = { Model: Model, Traffic: boolean, Pos: Vector3?, T: number, Vel: Vector3, Solid: boolean }
type Anim = { Kind: string, T0: number, FaceUp: boolean, Lx: number, Lz: number, Rig: any }
type Self = {
	Down: boolean,
	KnockAt: number?,
	UpAt: number?,
	StumbleAt: number?,
	Ragdoll: any,
	Anim: Anim?,
	Lock: { WalkSpeed: number, JumpPower: number, JumpHeight: number }?,
}

local started = false
local disabled = false
local options: any = nil
local connections: { RBXScriptConnection } = {}
local charConnections: { RBXScriptConnection } = {}
local remote: RemoteEvent? = nil
local fxFolder: Folder? = nil
local me: Self = { Down = false }
local movers: { [Model]: Mover } = {}
local moverList: { Mover } = {}
local others: { [Model]: Anim } = {}
local stars: { [Model]: { Gui: BillboardGui, Labels: { TextLabel }, T0: number } } = {}
local scanClock, npcClock = 0, 0
local lastSeat: BasePart? = nil
local grace: { Until: number, Car: Model, Parts: { [BasePart]: string } }? = nil
local pendingExit: Model? = nil
local debugLog: { string } = {}

----------------------------------------------------------------------
-- Outils
----------------------------------------------------------------------

local function log(text: string)
	table.insert(debugLog, text)
	if #debugLog > 40 then
		table.remove(debugLog, 1)
	end
end

local function toast(text: string)
	if options and type(options.Toast) == "function" then
		pcall(options.Toast, Locale.T(text))
	end
end

local function serverNow(): number
	return workspace:GetServerTimeNow()
end

local function charParts(): (Model?, Humanoid?, BasePart?)
	local character = LocalPlayer.Character
	if not character or not character.Parent then
		return nil, nil, nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
		return nil, nil, nil
	end
	return character, humanoid, root
end

local function fire(...)
	local r = remote
	if r then
		local args = table.pack(...)
		pcall(function()
			r:FireServer(table.unpack(args, 1, args.n))
		end)
	end
end

local safeZones: { ImpactRules.Zone } = {}
local zonesClock = -math.huge
local function inSafeZone(pos: Vector3): boolean
	local t = os.clock()
	if t - zonesClock > 5 then
		zonesClock = t
		local ok, list = pcall(ImpactRules.CollectSafeZones, workspace:FindFirstChild("DopamineTown"))
		if ok then
			safeZones = list
		end
	end
	return ImpactRules.InSafeZone(pos, safeZones)
end

-- Boîte (centre, taille) d'un véhicule : attributs du modèle, sinon la racine
local function boxOf(model: Model): (CFrame?, Vector3?)
	local root = model.PrimaryPart
	if not root then
		return nil, nil
	end
	local w = tonumber(model:GetAttribute("Width"))
	local l = tonumber(model:GetAttribute("Length"))
	local h = tonumber(model:GetAttribute("Height"))
	if w and l and h then
		local pivot = model:GetPivot()
		return pivot * CFrame.new(0, h / 2, 0), Vector3.new(w, h, l)
	end
	return root.CFrame, root.Size
end

----------------------------------------------------------------------
-- ⭐ Étoiles autour de la tête
----------------------------------------------------------------------

local STAR_COUNT = 5

local function starsOn(character: Model, t0: number)
	if stars[character] then
		stars[character].T0 = t0
		return
	end
	local head = character:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") or not fxFolder then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "KnockStars"
	gui.Adornee = head
	gui.Size = UDim2.fromScale(3.4, 1.8)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 1.25, 0)
	gui.LightInfluence = 0
	gui.MaxDistance = 140
	gui.AlwaysOnTop = false
	gui.ResetOnSpawn = false
	local labels = {}
	for i = 1, STAR_COUNT do
		local label = Instance.new("TextLabel")
		label.Name = "Star" .. i
		label.BackgroundTransparency = 1
		label.AnchorPoint = Vector2.new(0.5, 0.5)
		label.Size = UDim2.fromScale(0.26, 0.5)
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.Text = if i % 2 == 0 then "✨" else "⭐"
		label.TextColor3 = Color3.fromRGB(255, 226, 90)
		label.TextStrokeTransparency = 0.6
		label.TextStrokeColor3 = Color3.fromRGB(150, 90, 20)
		label.Parent = gui
		table.insert(labels, label)
	end
	gui.Parent = fxFolder
	stars[character] = { Gui = gui, Labels = labels, T0 = t0 }
end

local function starsOff(character: Model)
	local s = stars[character]
	if s then
		stars[character] = nil
		pcall(s.Gui.Destroy, s.Gui)
	end
end

-- orbite : ellipse vue de 3/4 (devant = plus gros, derrière = plus petit)
local function stepStars(t: number)
	for character, s in pairs(stars) do
		if not character.Parent or not s.Gui.Parent then
			starsOff(character)
		else
			local age = t - s.T0
			local fade = math.clamp(age / 0.3, 0, 1)
			for i, label in ipairs(s.Labels) do
				local a = age * 3.2 + (i - 1) / STAR_COUNT * math.pi * 2
				local depth = math.sin(a) -- (+1 devant)
				label.Position = UDim2.fromScale(0.5 + 0.4 * math.cos(a), 0.55 + 0.16 * depth)
				local scale = 0.75 + 0.3 * (depth + 1) / 2
				label.Size = UDim2.fromScale(0.26 * scale, 0.5 * scale)
				label.ZIndex = if depth > 0 then 3 else 1
				label.TextTransparency = 1 - fade * (0.55 + 0.45 * (depth + 1) / 2)
				label.Rotation = math.deg(a) * 0.5
			end
		end
	end
end

----------------------------------------------------------------------
-- Moi : renversé, titube, se relève
----------------------------------------------------------------------

local function lockMovement(humanoid: Humanoid)
	if me.Lock then
		return
	end
	me.Lock = { WalkSpeed = humanoid.WalkSpeed, JumpPower = humanoid.JumpPower, JumpHeight = humanoid.JumpHeight }
	humanoid.WalkSpeed = 0
	humanoid.JumpPower = 0
	humanoid.JumpHeight = 0
end

-- (on ne remet que ce que personne d'autre n'a changé entre-temps)
local function unlockMovement(humanoid: Humanoid?)
	local lock = me.Lock
	me.Lock = nil
	if not lock or not humanoid then
		return
	end
	if humanoid.WalkSpeed == 0 then
		humanoid.WalkSpeed = lock.WalkSpeed
	end
	if humanoid.JumpPower == 0 then
		humanoid.JumpPower = lock.JumpPower
	end
	if humanoid.JumpHeight == 0 then
		humanoid.JumpHeight = lock.JumpHeight
	end
end

local function canBeHit(humanoid: Humanoid, root: BasePart): boolean
	if humanoid.SeatPart ~= nil or humanoid.Sit then
		return false
	end
	if inSafeZone(root.Position) then
		return false
	end
	return true
end

-- Renversé ! (linear / spin : élan ; report = { Vel, Dir } si c'est la
-- circulation locale : on prévient le serveur)
-- (force : décision du serveur, qui a déjà coupé les articulations : on suit)
local function knockSelf(linear: Vector3, spin: Vector3, report: { Vel: Vector3, Dir: Vector3 }?, force: boolean?): boolean
	local character, humanoid, root = charParts()
	if not character or not humanoid or not root or me.Down then
		return false
	end
	local t = os.clock()
	if not force and (not ImpactRules.CanKnock(me, t) or not canBeHit(humanoid, root)) then
		return false
	end
	me.Down = true
	me.KnockAt = t
	me.UpAt = nil
	me.Anim = nil
	-- (le serveur a peut-être déjà coupé les articulations : pas de doublon)
	if not ImpactRules.IsRagdolled(character) then
		me.Ragdoll = ImpactRules.Ragdoll(character, { Local = true })
	end
	lockMovement(humanoid)
	pcall(function()
		humanoid:ChangeState(Enum.HumanoidStateType.Physics)
	end)
	for _, d in ipairs(character:GetChildren()) do
		if d:IsA("BasePart") then
			pcall(function()
				d.AssemblyLinearVelocity = linear
				d.AssemblyAngularVelocity = spin
			end)
		end
	end
	starsOn(character, t)
	toast("💫 Ouch! A car knocked you over!")
	if report then
		fire("traffic", "knock", report.Vel, report.Dir)
	end
	log("knock " .. string.format("%.1f", linear.Magnitude))
	return true
end

local function stumbleSelf(push: Vector3, dir: Vector3, report: { Vel: Vector3, Dir: Vector3 }?): boolean
	local character, humanoid, root = charParts()
	if not character or not humanoid or not root then
		return false
	end
	local t = os.clock()
	if not ImpactRules.CanStumble(me, t) or not canBeHit(humanoid, root) then
		return false
	end
	me.StumbleAt = t
	pcall(function()
		root.AssemblyLinearVelocity += push
	end)
	local l = root.CFrame:VectorToObjectSpace(dir)
	local flat = Vector3.new(l.X, 0, l.Z)
	flat = if flat.Magnitude > 1e-3 then flat.Unit else Vector3.new(0, 0, -1)
	me.Anim = { Kind = "stumble", T0 = t, FaceUp = false, Lx = flat.X, Lz = flat.Z, Rig = ImpactRules.RigOf(character) }
	if report then
		fire("traffic", "stumble", report.Vel, report.Dir)
	end
	log("stumble")
	return true
end

-- Se relever : articulations remises, HRP debout là où est le bassin, puis
-- l'animation procédurale ramène le corps de "allongé" à "debout"
local function beginGetUp()
	local character, humanoid, root = charParts()
	if not character or not humanoid or not root then
		me.Down = false
		return
	end
	ImpactRules.Restore(me.Ragdoll)
	me.Ragdoll = nil
	ImpactRules.QuietServerRagdoll(character)
	local rig = ImpactRules.RigOf(character)
	local faceUp = true
	if rig then
		local rootMotor = rig.Motors.Root
		local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
		if torso and torso:IsA("BasePart") and rootMotor.Part0 == root then
			local pivotW = (root.CFrame * rootMotor.C0).Position
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = { character }
			local hit = workspace:Raycast(pivotW + Vector3.new(0, 1.5, 0), Vector3.new(0, -8, 0), params)
			local groundY = if hit then hit.Position.Y else pivotW.Y - 0.55
			local standY = if rig.R6 then 3 else humanoid.HipHeight + root.Size.Y / 2
			local cf, up = ImpactRules.StandFrame(torso.CFrame, pivotW, groundY, rootMotor.C0, standY)
			faceUp = up
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			root.CFrame = cf
		end
	end
	pcall(function()
		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	end)
	me.Down = false
	me.Anim = { Kind = "getup", T0 = os.clock(), FaceUp = faceUp, Lx = 0, Lz = 0, Rig = rig }
	if rig then
		ImpactRules.ApplyPose(rig, ImpactRules.GetUpPose(0, faceUp, rig.PivotH, rig))
	end
	fire("up", faceUp)
	log("getup " .. tostring(faceUp))
end

local function endAnim()
	local anim = me.Anim
	me.Anim = nil
	if anim and anim.Rig then
		ImpactRules.ClearPose(anim.Rig)
	end
	if anim and anim.Kind == "getup" then
		me.UpAt = os.clock()
		local _, humanoid = charParts()
		unlockMovement(humanoid)
		local character = LocalPlayer.Character
		if character then
			starsOff(character)
		end
	end
end

-- Tout remettre tout de suite (sortie de la ville, erreur, nouveau personnage)
local function resetSelf(notify: boolean)
	local wasDown = me.Down
	ImpactRules.Restore(me.Ragdoll)
	me.Ragdoll = nil
	local character = LocalPlayer.Character
	if character then
		pcall(ImpactRules.QuietServerRagdoll, character)
		starsOff(character)
	end
	if me.Anim and me.Anim.Rig then
		pcall(ImpactRules.ClearPose, me.Anim.Rig)
	end
	me.Anim = nil
	local _, humanoid = charParts()
	if wasDown and humanoid then
		pcall(function()
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end)
	end
	unlockMovement(humanoid)
	me.Down = false
	if wasDown then
		me.UpAt = os.clock()
		if notify then
			fire("up", true)
		end
	end
end

-- Message du serveur (voiture d'un joueur, voiture IA…)
local function onServer(kind: any, a: any, b: any, c: any)
	if kind == "knock" and typeof(a) == "Vector3" and typeof(b) == "Vector3" then
		local ok = knockSelf(a, b, nil, true)
		if not ok then
			log("knock ignoré (déjà au sol)")
		elseif me.Ragdoll == nil then
			-- (le ragdoll du serveur n'est peut-être pas encore arrivé)
			task.delay(0.15, function()
				local character = LocalPlayer.Character
				if me.Down and character and not ImpactRules.IsRagdolled(character) then
					me.Ragdoll = ImpactRules.Ragdoll(character, { Local = true })
				end
			end)
		end
	elseif kind == "stumble" and typeof(a) == "Vector3" and typeof(b) == "Vector3" then
		stumbleSelf(a, b, nil)
	end
	local _ = c
end

----------------------------------------------------------------------
-- Véhicules : liste, vitesse, circulation solide, chocs
----------------------------------------------------------------------

local function scanMovers()
	local seen: { [Model]: boolean } = {}
	local function add(model: Instance, traffic: boolean)
		if not model:IsA("Model") or seen[model] then
			return
		end
		seen[model] = true
		local m = movers[model]
		if not m then
			m = { Model = model, Traffic = traffic, Pos = nil, T = 0, Vel = Vector3.zero, Solid = false }
			movers[model] = m
		end
		-- circulation locale : la boîte racine devient solide (groupe voitures :
		-- avatars et voitures s'y cognent, le corps au sol non)
		if traffic and not m.Solid then
			local root = model.PrimaryPart
			if root then
				m.Solid = true
				pcall(function()
					root.CanCollide = true
					root.CollisionGroup = ImpactRules.CAR_GROUP
				end)
			end
		end
	end
	local traffic = workspace:FindFirstChild(Knockdown.TRAFFIC_FOLDER)
	if traffic then
		for _, child in ipairs(traffic:GetChildren()) do
			if child:IsA("Model") and (string.sub(child.Name, 1, 7) == "Traffic" or child:GetAttribute("TrafficMover") == true) then
				add(child, true)
			end
		end
	end
	local cars = workspace:FindFirstChild(Knockdown.CARS_FOLDER)
	if cars then
		for _, child in ipairs(cars:GetChildren()) do
			add(child, false)
		end
	end
	local ok, tagged = pcall(function()
		return CollectionService:GetTagged(Knockdown.MOVER_TAG)
	end)
	if ok and type(tagged) == "table" then
		for _, model in ipairs(tagged) do
			if model:IsA("Model") and model:IsDescendantOf(workspace) then
				add(model, model:GetAttribute("ClientMover") == true)
			end
		end
	end
	table.clear(moverList)
	for model, m in pairs(movers) do
		if seen[model] and model.Parent then
			table.insert(moverList, m)
		else
			movers[model] = nil
		end
	end
end

-- Vitesse de chaque véhicule (physique, sinon dérivée de la position)
local function updateMovers(t: number)
	for _, m in ipairs(moverList) do
		local root = m.Model.PrimaryPart
		if root and root.Parent then
			local pos = m.Model:GetPivot().Position
			if not root.Anchored and not m.Traffic then
				m.Vel = root.AssemblyLinearVelocity
			elseif m.Pos then
				local dt = t - m.T
				if dt > 1e-3 then
					local raw = (pos - m.Pos) / dt
					if raw.Magnitude > 150 then
						raw = Vector3.zero -- (reconstruit / téléporté)
					end
					m.Vel = m.Vel:Lerp(raw, math.clamp(dt * 12, 0.2, 1))
				end
			end
			m.Pos = pos
			m.T = t
		end
	end
end

-- La circulation locale nous touche-t-elle ?
local function checkTraffic()
	if me.Down then
		return
	end
	local _, humanoid, root = charParts()
	if not humanoid or not root then
		return
	end
	local here = root.Position
	for _, m in ipairs(moverList) do
		if m.Traffic and m.Pos and (m.Pos - here).Magnitude < Knockdown.NEAR then
			local speed = Vector3.new(m.Vel.X, 0, m.Vel.Z).Magnitude
			if speed >= ImpactRules.STUMBLE_SPEED then
				local cf, size = boxOf(m.Model)
				if cf and size then
					local impact, dir = ImpactRules.Contact(cf, size, m.Vel, here, root.AssemblyLinearVelocity, speed * 0.05)
					if impact and dir then
						local kind = ImpactRules.Classify(impact)
						local report = { Vel = m.Vel, Dir = dir }
						if kind == "knock" then
							local linear, spin = ImpactRules.Impulse(dir, impact, root.AssemblyLinearVelocity)
							if knockSelf(linear, spin, report) then
								return
							end
						elseif kind == "stumble" then
							stumbleSelf(ImpactRules.StumblePush(dir, impact), dir, report)
						end
					end
				end
			end
		end
	end
end

-- PNJ devant une voiture rapide : saut de côté, ou bousculade s'il est trop tard
local npcOverlap: OverlapParams? = nil
local npcWarned = false
local function checkNpcs()
	local camera = workspace.CurrentCamera
	local center = camera and camera.CFrame.Position
	local _, _, myRoot = charParts()
	local center2 = if myRoot then myRoot.Position else center
	if not center or not center2 then
		return
	end
	local now = os.clock()
	local reactions = 0
	for _, m in ipairs(moverList) do
		local flat = Vector3.new(m.Vel.X, 0, m.Vel.Z)
		local speed = flat.Magnitude
		if m.Pos and speed >= Knockdown.NPC_MIN_SPEED and math.min((m.Pos - center).Magnitude, (m.Pos - center2).Magnitude) < 110 then
			local cf, size = boxOf(m.Model)
			if cf and size then
				local u = flat.Unit
				local frame = CFrame.lookAt(cf.Position, cf.Position + u)
				-- demi-longueur / demi-largeur de la boîte vues dans le sens de la marche
				local half = math.abs(u:Dot(cf.LookVector)) * size.Z / 2 + math.abs(u:Dot(cf.RightVector)) * size.X / 2
				local halfW = math.abs(frame.RightVector:Dot(cf.RightVector)) * size.X / 2 + math.abs(frame.RightVector:Dot(cf.LookVector)) * size.Z / 2
				local reach = math.clamp(speed * 0.9, 4, 30)
				local boxCenter = frame * CFrame.new(0, 0, -(half + reach) / 2)
				local params = npcOverlap
				if not params then
					params = OverlapParams.new()
					params.FilterType = Enum.RaycastFilterType.Exclude
					npcOverlap = params
				end
				local exclude: { Instance } = { m.Model }
				if LocalPlayer.Character then
					table.insert(exclude, LocalPlayer.Character)
				end
				params.FilterDescendantsInstances = exclude
				local ok, parts = pcall(function()
					return workspace:GetPartBoundsInBox(boxCenter, Vector3.new(size.X + 3.4, 8, half + reach), params)
				end)
				if ok and type(parts) == "table" then
					for _, p in ipairs(parts) do
						local npc = p.Parent
						if p.Name == "NpcCollider" and npc and npc:IsA("Model") and not ImpactRules.NpcReacting(npc, now) then
							local rel = frame:PointToObjectSpace(p.Position)
							local ahead = -rel.Z - half
							if math.abs(rel.X) < halfW + 1.8 and ahead > -1.5 then
								local side = if rel.X >= 0 then 1 else -1
								local right = frame.RightVector * side
								if ahead / speed > 0.3 then
									ImpactRules.StartNpcReact(npc, "dodge", right, now)
								else
									ImpactRules.StartNpcReact(npc, "bump", u * 0.8 + right * 0.45, now)
								end
								reactions += 1
								if reactions >= 12 then
									return
								end
							end
						end
					end
				end
			end
		end
	end
end

----------------------------------------------------------------------
-- Descendre de voiture : par la portière, sans se coincer
----------------------------------------------------------------------

local function isCarSeat(seat: BasePart?): Model?
	if not seat or not seat:IsA("VehicleSeat") then
		return nil
	end
	local model = seat:FindFirstAncestorOfClass("Model")
	if not model then
		return nil
	end
	local root = model.PrimaryPart
	if model:GetAttribute("CarId") ~= nil or (root and root.CollisionGroup == ImpactRules.CAR_GROUP) then
		return model
	end
	return nil
end

local function endGrace()
	local g = grace
	grace = nil
	if not g then
		return
	end
	for part, group in pairs(g.Parts) do
		pcall(function()
			if part.Parent and part.CollisionGroup == ImpactRules.RIDER_GROUP then
				part.CollisionGroup = group
			end
		end)
	end
end

local function startGrace(car: Model)
	local character = LocalPlayer.Character
	if not character then
		return
	end
	endGrace()
	local parts: { [BasePart]: string } = {}
	for _, d in ipairs(character:GetDescendants()) do
		if d:IsA("BasePart") and d:GetAttribute("KeepGroup") ~= true then
			parts[d] = d.CollisionGroup
			pcall(function()
				d.CollisionGroup = ImpactRules.RIDER_GROUP
			end)
		end
	end
	grace = { Until = os.clock() + Knockdown.GRACE_MAX, Car = car, Parts = parts }
end

-- l'avatar touche-t-il encore la boîte de la voiture ?
local function overlapsCar(car: Model, pos: Vector3): boolean
	local root = car.PrimaryPart
	if not root then
		return false
	end
	local rel = root.CFrame:PointToObjectSpace(pos)
	local half = root.Size / 2
	local r = ImpactRules.CHAR_RADIUS + 0.2
	return math.abs(rel.X) < half.X + r and math.abs(rel.Z) < half.Z + r and rel.Y > -half.Y - 3.2 and rel.Y < half.Y + 3
end

-- Place libre à côté de la portière (conducteur, passager, derrière)
local function exitSpot(car: Model, character: Model, humanoid: Humanoid, root: BasePart): CFrame?
	local carRoot = car.PrimaryPart
	if not carRoot then
		return nil
	end
	local seatZ = 0
	local seat = lastSeat
	if seat and seat.Parent then
		seatZ = carRoot.CFrame:PointToObjectSpace(seat.Position).Z
	end
	local hx, hz = carRoot.Size.X / 2, carRoot.Size.Z / 2
	local candidates = {
		Vector3.new(-(hx + 1.7), 0, seatZ),
		Vector3.new(hx + 1.7, 0, seatZ),
		Vector3.new(0, 0, hz + 2),
		Vector3.new(0, 0, -(hz + 2)),
	}
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = { character, car }
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = { character, car }
	overlap.RespectCanCollide = true
	local standY = if humanoid.RigType == Enum.HumanoidRigType.R6 then 3 else humanoid.HipHeight + root.Size.Y / 2
	local flatLook = Vector3.new(carRoot.CFrame.LookVector.X, 0, carRoot.CFrame.LookVector.Z)
	if flatLook.Magnitude < 1e-3 then
		flatLook = Vector3.new(0, 0, -1)
	end
	for _, off in ipairs(candidates) do
		local p = (carRoot.CFrame * CFrame.new(off)).Position
		local hit = workspace:Raycast(p + Vector3.new(0, 4, 0), Vector3.new(0, -10, 0), rayParams)
		if hit then
			local foot = hit.Position
			local okBox, list = pcall(function()
				return workspace:GetPartBoundsInBox(CFrame.new(foot + Vector3.new(0, 2.9, 0)), Vector3.new(1.8, 4.6, 1.8), overlap)
			end)
			if okBox and type(list) == "table" and #list == 0 then
				local pos = foot + Vector3.new(0, standY, 0)
				return CFrame.lookAt(pos, pos + flatLook.Unit)
			end
		end
	end
	return nil
end

local function stepGrace()
	local car = pendingExit
	if car then
		pendingExit = nil
		local character, humanoid, root = charParts()
		if character and humanoid and root and car.Parent and humanoid.SeatPart == nil and overlapsCar(car, root.Position) then
			local cf = exitSpot(car, character, humanoid, root)
			if cf then
				root.AssemblyLinearVelocity = Vector3.zero
				root.CFrame = cf
			end
		end
	end
	local g = grace
	if not g then
		return
	end
	local _, humanoid, root = charParts()
	if not root or not humanoid or humanoid.SeatPart ~= nil then
		-- (rassis : plus besoin ; parti : on remet)
		endGrace()
		return
	end
	if os.clock() > g.Until or not g.Car.Parent or not overlapsCar(g.Car, root.Position) then
		endGrace()
	end
end

local function onSeated(active: boolean, seat: BasePart?)
	if active then
		lastSeat = seat
		return
	end
	local car = isCarSeat(lastSeat)
	if car then
		startGrace(car)
		pendingExit = car
	end
	-- (lastSeat gardé : exitSpot lit la position du siège)
end

local function watchCharacter(character: Model?)
	for _, c in ipairs(charConnections) do
		c:Disconnect()
	end
	table.clear(charConnections)
	me = { Down = false }
	grace = nil
	pendingExit = nil
	lastSeat = nil
	if not character then
		return
	end
	task.spawn(function()
		local humanoid = character:WaitForChild("Humanoid", 10)
		if humanoid and humanoid:IsA("Humanoid") and started and LocalPlayer.Character == character then
			table.insert(charConnections, humanoid.Seated:Connect(function(active: boolean, seat: BasePart?)
				local ok, err = pcall(onSeated, active, seat)
				if not ok then
					warn("[Knockdown] " .. tostring(err))
				end
			end))
			if humanoid.SeatPart then
				lastSeat = humanoid.SeatPart
			end
		end
	end)
end

----------------------------------------------------------------------
-- Les autres joueurs (étoiles, se relever, tituber)
----------------------------------------------------------------------

local function scanOthers()
	local _, _, myRoot = charParts()
	local center = if myRoot then myRoot.Position else (workspace.CurrentCamera and workspace.CurrentCamera.CFrame.Position)
	local t = serverNow()
	local count = 0
	local seen: { [Model]: boolean } = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		if player ~= LocalPlayer and character and character.Parent and count < Knockdown.OTHERS_MAX then
			local root = character:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") and center and (root.Position - center).Magnitude < Knockdown.OTHERS_RADIUS then
				local knockAt = character:GetAttribute("DopaKnockAt")
				local upAt = character:GetAttribute("DopaUpAt")
				local stumbleAt = character:GetAttribute("DopaStumbleAt")
				local down = type(knockAt) == "number" and t - knockAt < ImpactRules.FAILSAFE + 1 and not (type(upAt) == "number" and upAt >= knockAt)
				local rising = type(upAt) == "number" and t - upAt < ImpactRules.GETUP_TIME and t - upAt >= -0.2
				if down or (rising and t - (upAt :: number) < ImpactRules.GETUP_TIME * 0.6) then
					starsOn(character, os.clock() - math.max(0, t - (knockAt or t)))
					seen[character] = true
				end
				local anim = others[character]
				if rising then
					if not anim or anim.Kind ~= "getup" or anim.T0 ~= upAt then
						others[character] = { Kind = "getup", T0 = upAt :: number, FaceUp = character:GetAttribute("DopaUpFace") ~= false, Lx = 0, Lz = 0, Rig = ImpactRules.RigOf(character) }
					end
					count += 1
				elseif type(stumbleAt) == "number" and t - stumbleAt < ImpactRules.STUMBLE_TIME and not down then
					if not anim or anim.Kind ~= "stumble" or anim.T0 ~= stumbleAt then
						local dir = character:GetAttribute("DopaStumbleDir")
						local l = if typeof(dir) == "Vector3" then root.CFrame:VectorToObjectSpace(dir) else Vector3.new(0, 0, -1)
						local flat = Vector3.new(l.X, 0, l.Z)
						flat = if flat.Magnitude > 1e-3 then flat.Unit else Vector3.new(0, 0, -1)
						others[character] = { Kind = "stumble", T0 = stumbleAt, FaceUp = false, Lx = flat.X, Lz = flat.Z, Rig = ImpactRules.RigOf(character) }
					end
					count += 1
				end
			end
		end
	end
	-- étoiles des autres qui ne sont plus au sol
	for character in pairs(stars) do
		if character ~= LocalPlayer.Character and not seen[character] then
			starsOff(character)
		end
	end
end

----------------------------------------------------------------------
-- Boucles
----------------------------------------------------------------------

local function poseStep()
	-- moi
	local anim = me.Anim
	local t = os.clock()
	if me.Down and me.KnockAt and t - me.KnockAt >= ImpactRules.KNOCK_TIME then
		beginGetUp()
		anim = me.Anim
	end
	if anim and anim.Rig then
		local age = t - anim.T0
		if anim.Kind == "getup" then
			if age >= ImpactRules.GETUP_TIME then
				endAnim()
			else
				ImpactRules.ApplyPose(anim.Rig, ImpactRules.GetUpPose(age / ImpactRules.GETUP_TIME, anim.FaceUp, anim.Rig.PivotH, anim.Rig))
			end
		elseif anim.Kind == "stumble" then
			if age >= ImpactRules.STUMBLE_TIME or me.Down then
				endAnim()
			else
				ImpactRules.ApplyPose(anim.Rig, ImpactRules.StumblePose(age, anim.Lx, anim.Lz))
			end
		end
	elseif anim and anim.Kind == "getup" and t - anim.T0 >= ImpactRules.GETUP_TIME then
		endAnim()
	end
	-- les autres
	local st = serverNow()
	for character, a in pairs(others) do
		local age = st - a.T0
		local rig = a.Rig
		local limit = if a.Kind == "getup" then ImpactRules.GETUP_TIME else ImpactRules.STUMBLE_TIME
		if not character.Parent or not rig or age >= limit then
			if rig then
				ImpactRules.ClearPose(rig)
			end
			others[character] = nil
		elseif age >= 0 then
			if a.Kind == "getup" then
				ImpactRules.ApplyPose(rig, ImpactRules.GetUpPose(age / limit, a.FaceUp, rig.PivotH, rig))
			else
				ImpactRules.ApplyPose(rig, ImpactRules.StumblePose(age, a.Lx, a.Lz))
			end
		end
	end
end

local function heartbeat(dt: number)
	local t = os.clock()
	scanClock += dt
	npcClock += dt
	if scanClock >= Knockdown.SCAN_INTERVAL then
		scanClock = 0
		scanMovers()
		scanOthers()
	end
	updateMovers(t)
	checkTraffic()
	if npcClock >= Knockdown.NPC_INTERVAL then
		npcClock = 0
		-- (réactions des PNJ : jamais bloquantes pour le reste)
		local okNpc, errNpc = pcall(checkNpcs)
		if not okNpc and not npcWarned then
			npcWarned = true
			warn("[Knockdown] PNJ : " .. tostring(errNpc))
		end
	end
	stepGrace()
	stepStars(t)
end

local function guarded(name: string, fn: (...any) -> ()): (...any) -> ()
	return function(...)
		if disabled then
			return
		end
		local ok, err = pcall(fn, ...)
		if not ok then
			-- (jamais de pose cassée : tout est remis, le module se coupe)
			disabled = true
			warn("[Knockdown] " .. name .. " : " .. tostring(err))
			pcall(resetSelf, true)
			pcall(endGrace)
		end
	end
end

----------------------------------------------------------------------
-- API
----------------------------------------------------------------------

function Knockdown.Start(startOptions: any?)
	if started then
		return
	end
	started = true
	disabled = false
	options = startOptions
	local old = workspace:FindFirstChild(Knockdown.FX_FOLDER)
	if old then
		old:Destroy()
	end
	local f = Instance.new("Folder")
	f.Name = Knockdown.FX_FOLDER
	f.Parent = workspace
	fxFolder = f
	task.spawn(function()
		local ok, event = pcall(Net.Event, "Impact")
		if ok and event and started then
			remote = event
			table.insert(connections, event.OnClientEvent:Connect(guarded("serveur", onServer)))
		end
	end)
	table.insert(connections, LocalPlayer.CharacterAdded:Connect(function(character: Model)
		pcall(endGrace)
		me = { Down = false }
		watchCharacter(character)
	end))
	watchCharacter(LocalPlayer.Character)
	table.insert(connections, RunService.Heartbeat:Connect(guarded("heartbeat", heartbeat)))
	table.insert(connections, RunService.Stepped:Connect(guarded("poses", function()
		poseStep()
	end)))
	scanMovers()
end

function Knockdown.Stop()
	if not started then
		return
	end
	pcall(resetSelf, true)
	pcall(endGrace)
	started = false
	for _, c in ipairs(connections) do
		c:Disconnect()
	end
	table.clear(connections)
	for _, c in ipairs(charConnections) do
		c:Disconnect()
	end
	table.clear(charConnections)
	for character, a in pairs(others) do
		if a.Rig then
			pcall(ImpactRules.ClearPose, a.Rig)
		end
		others[character] = nil
	end
	for character in pairs(stars) do
		starsOff(character)
	end
	-- (la circulation garde sa boîte solide : TownTraffic détruit ses modèles)
	table.clear(movers)
	table.clear(moverList)
	remote = nil
	pendingExit = nil
	lastSeat = nil
	if fxFolder then
		fxFolder:Destroy()
		fxFolder = nil
	end
end

function Knockdown.IsDown(): boolean
	return me.Down
end

-- (tests / émulateur)
function Knockdown.Debug(): any
	return {
		Self = function()
			return me
		end,
		Movers = moverList,
		Others = others,
		Stars = stars,
		Grace = function()
			return grace
		end,
		Log = debugLog,
		Knock = knockSelf,
		Stumble = stumbleSelf,
		BeginGetUp = beginGetUp,
		PoseStep = poseStep,
		Heartbeat = heartbeat,
		ScanMovers = scanMovers,
		ScanOthers = scanOthers,
		CheckTraffic = checkTraffic,
		CheckNpcs = checkNpcs,
		OnServer = onServer,
		OnSeated = onSeated,
		StepGrace = stepGrace,
		ExitSpot = exitSpot,
		StepStars = stepStars,
		StarsOn = starsOn,
		Disabled = function()
			return disabled
		end,
	}
end

return Knockdown
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="208">
          <Properties>
            <string name="Name">LiveProps</string>
            <string name="Source"><![CDATA[--[[
	LiveProps (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > LiveProps

	v9.5 🖥️ "Dopamine Setup" : donne VIE aux modèles 3D des objets Setup
	(House3DSetup) dans la maison de la ville ET dans l'aperçu 3D du panneau
	Maison :
	  - écrans (SurfaceGui dans le PlayerGui, Adornee = la pièce "Screen",
	    Face = Front, MaxDistance 120) : mini coureur, mini live, logo DVD,
	    flash info, LCD de la chaîne (LiveScreens) ; au plus MAX_GUIS écrans
	    dessinés en même temps (les plus proches ; le bureau du mode bureau
	    d'abord), les autres brillent d'une couleur unie ;
	  - clavier : les touches s'enfoncent, son de touche (GearClick /
	    SoundManager.PlayKeySound), VRAI clic (ClientState.Click, même chemin
	    que le gros bouton) ; souris : boutons, son du clic, vrai clic ;
	  - papier bulle : les bulles éclatent (Interact "Bubble", son "Pop",
	    limite de 12 / s comme en 2D) puis regonflent ;
	  - moulin : les ailes tournent (plus vite quand on souffle : Interact
	    "Spin", recharge de Config.Interactions.Spin) ;
	  - presse : le piston descend et écrase canard / canette / pastèque qui
	    repoussent ; gros bouton rouge = Interact "Press" (Feature PressStart,
	    recharge 3 s) ;
	  - hi-fi : vinyle / CD / bobines qui tournent, membranes et VU-mètres qui
	    battent quand la musique joue ; ▶ = musique on/off (même chemin que
	    le lecteur des ⚙️ Réglages), ⏭ = morceau suivant (SoundManager) ;
	  - écran d'infos : clic = Interact "Headline" ; coin live : voyant REC,
	    ON AIR ; plantes qui se balancent ; bandes "RGB" arc-en-ciel.
	Clics 3D : rayon depuis la caméra (souris / toucher), seulement sur les
	objets "Interactive" et à ≤ 14 studs du personnage (sauf en mode bureau).
	Les récompenses du serveur ("Bonus" Spin / Press / Headline) s'envolent
	en "+X" au-dessus de l'objet.
	Performance : UNE boucle Heartbeat pour tous les objets, animations à
	30 images / s, en pause au-delà de ~60 studs du point de focus (SetFocus
	ou la caméra) ; aucune création d'instance par image (bulles "+X" en
	réserve, tableaux réutilisés).

	API :
	  LiveProps.Attach(model, itemId, context) -> handle?
	    context = { Interactive: boolean, IsOwner: boolean?, Player: Player?, OwnerId: number?,
	                PauseDistance: number?, ScreenDistance: number? }
	    (Interactive = false : aperçu 3D, pause à 250 studs, écrans visibles à 300)
	  LiveProps.Detach(handle)
	  LiveProps.AttachAll(models, context) -> { handle }   (ignore les objets non Setup)
	  LiveProps.BindHouseBuilder(HouseBuilder)             (crochets OnItemAttach / OnItemDetach : la ville)
	  LiveProps.HandleOf(model) -> handle?
	  LiveProps.DetachAll(handles)
	  LiveProps.SetFocus(position?)        (nil = la caméra)
	  LiveProps.IsLive(itemId) -> boolean
	  LiveProps.DeskNear(position, radius?) -> handle?     (bureau le plus proche)
	  LiveProps.Peripherals(deskHandle) -> { handle }       (clavier / souris posés dessus)
	  LiveProps.SetDeskFocus(handle?)      (mode bureau : écrans prioritaires, clics sans distance)
	  LiveProps.DeskUsed : Signal (handle) (invite "🖥️ Utiliser" / clic sur un écran de bureau)
	  LiveProps.Press(handle, partName)    (appui programmé : touche, bouton... pour DeskMode)
	  LiveProps.Count() -> number
	v9.8 (DESK98) :
	  - écrans : le VRAI contenu du clicker (World/StimulusScreen : Runner,
	    LiveStream, DVD, NewsTicker) sur les REAL_MAX écrans les plus proches
	    (≤ REAL_DISTANCE studs, bureau du mode bureau d'abord) ; les autres
	    gardent le dessin léger (LiveScreens) ; toiles inertes (Active = false) ;
	  - télés : clic sur l'écran = chaîne suivante (Live, DVD, Infos, Coureur) ;
	  - clavier : légendes des touches (une toile par rangée, seulement sur le
	    clavier le plus proche) ; appui "visuel" (jeu du bureau, sans clic) ;
	  - presse : tapis roulant qui amène l'objet, écrasement, éjection vers le
	    bac, manomètres, afficheur, éclats, couleurs du palier du clicker.
	  LiveProps.MainScreen(deskHandle) -> ScreenRec?    (le plus grand écran du bureau)
	  LiveProps.SetOverride(rec, override?)             (override = { Canvas(aspect), Build(gui, canvas) -> Screen })
	  LiveProps.PressVisual(handle, partName) -> boolean (touche / bouton qui s'enfonce, sans clic ni son)
	  LiveProps.SetChannel(rec, kind)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Signal = require(ReplicatedStorage.Shared.Signal)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local LiveScreens = require(script.Parent.LiveScreens)
local StimulusScreen = require(script.Parent.StimulusScreen)

local Client = script.Parent.Parent

local LiveProps = {}

LiveProps.MAX_GUIS = 8 -- écrans dessinés en même temps (tous objets confondus)
LiveProps.REAL_MAX = 3 -- écrans avec le VRAI stimulus du clicker (les plus proches)
LiveProps.REAL_DISTANCE = 40 -- (studs) au-delà : dessin léger
LiveProps.LEGEND_DISTANCE = 22 -- (studs) légendes du clavier le plus proche
LiveProps.PAUSE_DISTANCE = 45 -- (studs) au-delà : animations en pause (v9.8 : 60 -> 45)
LiveProps.SCREEN_DISTANCE = 120 -- MaxDistance des SurfaceGui
LiveProps.CLICK_DISTANCE = 14 -- (studs) personnage -> objet pour cliquer

local ANIM_STEP = 1 / 30
local MANAGE_STEP = 0.5
local HOVER_STEP = 0.1
local RGB_STEP = 1 / 15

local rgb = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)
local CYAN_SOFT = rgb(120, 200, 255)

LiveProps.DeskUsed = Signal.new()

----------------------------------------------------------------------
-- Modules du client (chargés à la demande, jamais bloquants)
----------------------------------------------------------------------

local cache: { [string]: any } = {}
local function lazy(name: string, path: { string }): any
	local cached = cache[name]
	if cached ~= nil then
		return cached or nil
	end
	local ok, result = pcall(function()
		local node: Instance = Client
		for _, step in ipairs(path) do
			local child = node:FindFirstChild(step)
			if not child then
				return nil
			end
			node = child
		end
		if node:IsA("ModuleScript") then
			return require(node) :: any
		end
		return nil
	end)
	cache[name] = (ok and result) or false
	return cache[name] or nil
end
local function clientState(): any
	return lazy("ClientState", { "ClientState" })
end
local function soundManager(): any
	return lazy("SoundManager", { "SoundManager" })
end
local function gearClick(): any
	return lazy("GearClick", { "Stimuli", "Gear", "GearClick" })
end
local function setupModule(): any
	return lazy("House3DSetup", { "Components", "House", "House3DSetup" })
end
local function settingsPanel(): any
	return lazy("Settings", { "Components", "Panels", "Settings" })
end
local function net(): any
	local cached = cache.Net
	if cached == nil then
		local ok, result = pcall(require, ReplicatedStorage.Shared.Net)
		cached = ok and result or false
		cache.Net = cached
	end
	return cached or nil
end

local function playSound(name: string, pitch: number?)
	local manager = soundManager()
	if manager and type(manager.Play) == "function" then
		pcall(manager.Play, name, pitch)
	end
end

local function hasFeature(name: string): boolean
	local state = clientState()
	if not state or type(state.HasFeature) ~= "function" then
		return false
	end
	local ok, value = pcall(state.HasFeature, name)
	return ok and value == true
end

local function levelOf(upgradeId: string): number
	local state = clientState()
	if not state or type(state.GetLevel) ~= "function" then
		return 0
	end
	local ok, value = pcall(state.GetLevel, upgradeId)
	return ok and tonumber(value) or 0
end

local function interact(kind: string, arg: any?)
	local module = net()
	if not module then
		return
	end
	pcall(function()
		module.Event("Interact"):FireServer(kind, arg)
	end)
end

local function upgradeName(upgradeId: string): string
	for _, upgrade in ipairs(Config.Upgrades or {}) do
		if upgrade.Id == upgradeId then
			return Locale.T(upgrade.Name)
		end
	end
	return upgradeId
end

----------------------------------------------------------------------
-- Types
----------------------------------------------------------------------

type Mover = { Part: BasePart, Offset: CFrame, Size: Vector3 }
type Spinner = { Pivot: BasePart, Parts: { BasePart }, Offsets: { CFrame }, CFrames: { CFrame }, Axis: string, Angle: number, Speed: number, Target: number }
type Press = { Part: BasePart, Offset: CFrame, Base: Color3, Material: Enum.Material, T: number, Depth: number }
export type Override = {
	Canvas: (aspect: number) -> Vector2,
	Build: (gui: SurfaceGui, canvas: Vector2) -> any,
}
export type ScreenRec = {
	Part: BasePart,
	Kind: string,
	Index: number,
	Handle: any,
	Gui: SurfaceGui?,
	Screen: any?, -- LiveScreens.Screen | StimulusScreen.Screen | écran d'un override
	Real: boolean, -- vrai stimulus du clicker dessiné
	RealBroken: boolean, -- le vrai stimulus a planté : dessin léger pour de bon
	Override: Override?, -- (jeu du bureau) prend l'écran
	Wings: { BasePart },
	BaseColor: Color3,
	BaseMaterial: Enum.Material,
}

export type Handle = {
	Model: Model,
	ItemId: string,
	Kind: string,
	Setup: { [string]: any },
	Interactive: boolean,
	IsOwner: boolean,
	Alive: boolean,
	Ref: BasePart,
	Paused: boolean,
	Distance: number,
	PauseDistance: number,
	ScreenDistance: number,
	Clock: number,
	Screens: { ScreenRec },
	Clickables: { BasePart },
	Roles: { [BasePart]: string },
	RGB: { BasePart },
	Movers: { [BasePart]: Mover },
	Presses: { Press },
	Spinners: { Spinner },
	State: { [string]: any },
	Connections: { any },
	Prompt: ProximityPrompt?,
	Step: ((h: Handle, dt: number) -> ())?,
	Click: ((h: Handle, part: BasePart, role: string, point: Vector3) -> ())?,
	Visual: ((h: Handle, part: BasePart) -> ())?, -- (v9.8) appui sans clic ni son
}

local handles: { Handle } = {}
local byModel: { [Model]: Handle } = {}
local screens: { ScreenRec } = {}
local focusPoint: Vector3? = nil
local focusAt = 0
local deskFocus: Handle? = nil
local heartbeat: RBXScriptConnection? = nil
local inputConnections: { RBXScriptConnection } = {}
local notifyConnection: any = nil
local clickList: { BasePart } = {}
local random = Random.new()

----------------------------------------------------------------------
-- Outils
----------------------------------------------------------------------

local function refCF(h: Handle): CFrame
	return h.Ref.CFrame
end

-- Mémorise la pose de repos d'une pièce (repère du modèle)
local function mover(h: Handle, part: BasePart): Mover
	local existing = h.Movers[part]
	if existing then
		return existing
	end
	local m: Mover = { Part = part, Offset = refCF(h):ToObjectSpace(part.CFrame), Size = part.Size }
	h.Movers[part] = m
	return m
end

local function newSpinner(pivotPart: BasePart, parts: { BasePart }, axis: string, speed: number): Spinner
	local offsets = table.create(#parts)
	local cframes = table.create(#parts)
	for index, part in ipairs(parts) do
		offsets[index] = pivotPart.CFrame:ToObjectSpace(part.CFrame)
		cframes[index] = part.CFrame
	end
	return { Pivot = pivotPart, Parts = parts, Offsets = offsets, CFrames = cframes, Axis = axis, Angle = 0, Speed = speed, Target = speed }
end

local function stepSpinner(spinner: Spinner, dt: number)
	spinner.Speed += (spinner.Target - spinner.Speed) * math.min(1, dt * 1.5)
	spinner.Angle = (spinner.Angle + spinner.Speed * dt) % (math.pi * 2)
	local a = spinner.Angle
	local rotation = spinner.Axis == "Y" and CFrame.Angles(0, a, 0) or (spinner.Axis == "X" and CFrame.Angles(a, 0, 0) or CFrame.Angles(0, 0, a))
	local base = spinner.Pivot.CFrame * rotation
	local cframes = spinner.CFrames
	for index, offset in ipairs(spinner.Offsets) do
		cframes[index] = base * offset
	end
	workspace:BulkMoveTo(spinner.Parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
end

-- Balancement (plantes) : petit angle autour du pivot
local function swaySpinner(spinner: Spinner, clock: number, amount: number)
	local base = spinner.Pivot.CFrame * CFrame.Angles(math.sin(clock * 1.3) * amount * 0.6, 0, math.sin(clock * 0.9) * amount)
	local cframes = spinner.CFrames
	for index, offset in ipairs(spinner.Offsets) do
		cframes[index] = base * offset
	end
	workspace:BulkMoveTo(spinner.Parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
end

local function findPart(model: Model, name: string): BasePart?
	local found = model:FindFirstChild(name, true)
	if found and found:IsA("BasePart") then
		return found
	end
	return nil
end

local function partsNamed(model: Model, name: string): { BasePart }
	local list = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Name == name then
			table.insert(list, d)
		end
	end
	return list
end

-- Appui (touche, bouton) : la pièce s'enfonce puis remonte (v9.8 : l'éclair
-- de couleur n'est plus du Neon ; la légende de la touche s'estompe)
local function press(h: Handle, part: BasePart, depth: number?, flash: Color3?)
	local m = mover(h, part)
	for _, p in ipairs(h.Presses) do
		if p.Part == part then
			p.T = 0
			return
		end
	end
	table.insert(h.Presses, { Part = part, Offset = m.Offset, Base = part.Color, Material = part.Material, T = 0, Depth = depth or m.Size.Y * 0.55 })
	if flash then
		part.Color = flash
	end
end

local function stepPresses(h: Handle, dt: number)
	local list = h.Presses
	if #list == 0 then
		return
	end
	local ref = refCF(h)
	local legends: { [BasePart]: TextLabel }? = h.State.LegendLabels
	for index = #list, 1, -1 do
		local p = list[index]
		p.T += dt
		local t = p.T
		local down
		if t < 0.04 then
			down = t / 0.04
		elseif t < 0.12 then
			down = 1
		else
			down = math.max(0, 1 - (t - 0.12) / 0.12)
		end
		p.Part.CFrame = ref * p.Offset * CFrame.new(0, -p.Depth * down, 0)
		local label = legends and legends[p.Part]
		if label then
			label.TextTransparency = 0.05 + 0.6 * down
		end
		if t >= 0.24 then
			p.Part.CFrame = ref * p.Offset
			p.Part.Color = p.Base
			p.Part.Material = p.Material
			if label then
				label.TextTransparency = 0.05
			end
			table.remove(list, index)
		end
	end
end

----------------------------------------------------------------------
-- "+X" et petits messages flottants (réserve de BillboardGui)
----------------------------------------------------------------------

type Floater = { Gui: BillboardGui, Label: TextLabel, T: number, Busy: boolean, Offset: Vector3 }
local floaters: { Floater } = {}
local FLOATERS = 6

local function playerGui(): Instance?
	local player = Players.LocalPlayer
	return player and player:FindFirstChildOfClass("PlayerGui") or nil
end

local function floater(): Floater?
	for _, f in ipairs(floaters) do
		if not f.Busy then
			return f
		end
	end
	if #floaters >= FLOATERS then
		-- la plus ancienne est recyclée
		local oldest = floaters[1]
		for _, f in ipairs(floaters) do
			if f.T > oldest.T then
				oldest = f
			end
		end
		return oldest
	end
	local parent = playerGui()
	if not parent then
		return nil
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "LivePropsPop"
	gui.Size = UDim2.fromOffset(160, 34)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 80
	gui.ResetOnSpawn = false
	gui.Enabled = false
	gui.Parent = parent
	local text = Instance.new("TextLabel")
	text.Name = "Text"
	text.BackgroundTransparency = 1
	text.Size = UDim2.fromScale(1, 1)
	text.Font = Enum.Font.GothamBlack
	text.TextSize = 24
	text.TextColor3 = rgb(255, 230, 90)
	text.TextStrokeColor3 = rgb(120, 40, 100)
	text.TextStrokeTransparency = 0
	text.Text = ""
	text.Parent = gui
	local f: Floater = { Gui = gui, Label = text, T = 0, Busy = false, Offset = Vector3.zero }
	table.insert(floaters, f)
	return f
end

local function popText(part: BasePart, point: Vector3, text: string, color: Color3?, size: number?)
	local f = floater()
	if not f then
		return
	end
	f.Busy = true
	f.T = 0
	f.Offset = point - part.Position
	f.Gui.Adornee = part
	f.Gui.StudsOffsetWorldSpace = f.Offset
	f.Gui.Enabled = true
	f.Label.Text = text
	f.Label.TextColor3 = color or rgb(255, 230, 90)
	f.Label.TextSize = size or 24
	f.Label.TextTransparency = 0
	f.Label.TextStrokeTransparency = 0
end

local function stepFloaters(dt: number)
	for _, f in ipairs(floaters) do
		if f.Busy then
			f.T += dt
			local t = f.T / 0.9
			if t >= 1 then
				f.Busy = false
				f.Gui.Enabled = false
				f.Gui.Adornee = nil
			else
				f.Gui.StudsOffsetWorldSpace = f.Offset + Vector3.new(0, 0.4 + t * 1.6, 0)
				f.Label.TextTransparency = math.max(0, t - 0.55) / 0.45
				f.Label.TextStrokeTransparency = f.Label.TextTransparency
			end
		end
	end
end

local function formatGain(value: number): string
	if value >= 1e6 then
		return NumberFormatter.Format(value)
	end
	if value < 10 and value % 1 ~= 0 then
		return NumberFormatter.Format(value)
	end
	return NumberFormatter.WithSpaces(value)
end

----------------------------------------------------------------------
-- Écrans (SurfaceGui dans le PlayerGui)
----------------------------------------------------------------------

local function screenOff(rec: ScreenRec)
	local tint = LiveScreens.Tints[rec.Kind] or rgb(40, 40, 70)
	-- (v9.6 : écran en veille = verre sombre mat, plus une dalle Neon)
	rec.Part.Material = Enum.Material.SmoothPlastic
	rec.Part.Color = tint:Lerp(Color3.new(0, 0, 0), 0.7)
end

local function releaseGui(rec: ScreenRec)
	local screen = rec.Screen
	if screen then
		rec.Screen = nil
		pcall(screen.Destroy, screen)
	end
	local gui = rec.Gui
	if gui then
		rec.Gui = nil
		gui:Destroy()
	end
	rec.Real = false
	if rec.Part.Parent then
		screenOff(rec)
	end
end

-- Dessine l'écran : override (jeu du bureau), vrai stimulus du clicker
-- (`real`) ou dessin léger (LiveScreens)
local function claimGui(rec: ScreenRec, real: boolean)
	if rec.Gui then
		return
	end
	local part = rec.Part
	local size = part.Size
	local aspect = size.X / math.max(0.05, size.Y)
	local override = rec.Override
	local useReal = real and not override and not rec.RealBroken and StimulusScreen.Supports(rec.Kind)
	local canvas: Vector2
	if override then
		local ok, value = pcall(override.Canvas, aspect)
		canvas = (ok and typeof(value) == "Vector2") and value or Vector2.new(400, math.floor(400 / aspect + 0.5))
	elseif useReal then
		canvas = StimulusScreen.Canvas(rec.Kind, aspect)
	else
		local width = rec.Kind == "Music" and 256 or 320
		canvas = Vector2.new(width, math.max(40, math.floor(width / aspect + 0.5)))
	end
	local gui = Instance.new("SurfaceGui")
	gui.Name = "LiveScreen_" .. rec.Kind
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.CanvasSize = canvas
	gui.LightInfluence = 0
	gui.Brightness = 1 -- (v9.6 : 1.2 -> 1, écrans pas éblouissants)
	gui.MaxDistance = rec.Handle.ScreenDistance
	gui.AlwaysOnTop = false
	gui.ClipsDescendants = true
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Active = false -- (v9.8 : toile inerte, les clics 3D passent au travers)
	gui.Adornee = part
	local screen: any = nil
	if override then
		local ok, result = pcall(override.Build, gui, canvas)
		if ok then
			screen = result
		else
			warn("[LiveProps] Écran du jeu : " .. tostring(result))
		end
	elseif useReal then
		local ok, result = pcall(StimulusScreen.New, rec.Kind, gui, canvas)
		if ok and result then
			screen = result
		else
			if not ok then
				warn("[LiveProps] Vrai écran " .. tostring(rec.Kind) .. " : " .. tostring(result))
			end
			rec.RealBroken = true
			gui:ClearAllChildren()
			local width = 320
			canvas = Vector2.new(width, math.max(40, math.floor(width / aspect + 0.5)))
			gui.CanvasSize = canvas
		end
	end
	if not screen then
		local ok, result = pcall(LiveScreens.New, rec.Kind, gui, canvas)
		if not ok then
			warn("[LiveProps] Écran " .. tostring(rec.Kind) .. " : " .. tostring(result))
			gui:Destroy()
			return
		end
		screen = result
	end
	gui.Parent = playerGui() or part
	rec.Gui = gui
	rec.Screen = screen
	rec.Real = useReal and type(screen) == "table" and screen.Real == true
	part.Material = Enum.Material.SmoothPlastic
	part.Color = Color3.new(0, 0, 0)
end

-- Qui a droit à un écran dessiné ? (les plus proches, le bureau actif et le
-- jeu du bureau d'abord) ; qui a droit au VRAI stimulus du clicker ?
local ranked: { ScreenRec } = {}
local rankDistance: { [ScreenRec]: number } = {}
local function manageScreens(focus: Vector3)
	table.clear(ranked)
	table.clear(rankDistance)
	for _, rec in ipairs(screens) do
		local h = rec.Handle
		if h.Alive and rec.Part.Parent then
			local distance = (rec.Part.Position - focus).Magnitude
			if rec.Override then
				distance = -2
			elseif h == deskFocus then
				distance = -1
			elseif h.Paused or distance > h.ScreenDistance then
				distance = math.huge
			end
			rankDistance[rec] = distance
			table.insert(ranked, rec)
		end
	end
	table.sort(ranked, function(a, b)
		return rankDistance[a] < rankDistance[b]
	end)
	-- écran planté : on repasse au dessin léger
	for _, rec in ipairs(ranked) do
		local screen = rec.Screen
		if screen and type(screen) == "table" and screen.Failed == true then
			rec.RealBroken = true
			releaseGui(rec)
		end
	end
	local wanted: { [ScreenRec]: boolean } = {}
	local wantReal: { [ScreenRec]: boolean } = {}
	local realCount = 0
	for index, rec in ipairs(ranked) do
		local distance = rankDistance[rec]
		local want = index <= LiveProps.MAX_GUIS and distance < math.huge
		wanted[rec] = want
		if want and not rec.Override and not rec.RealBroken and realCount < LiveProps.REAL_MAX and distance <= LiveProps.REAL_DISTANCE
			and rec.Handle.Interactive and StimulusScreen.Supports(rec.Kind) then
			realCount += 1
			wantReal[rec] = true
		end
	end
	for _, rec in ipairs(ranked) do
		if rec.Gui and (not wanted[rec] or (not rec.Override and rec.Real ~= (wantReal[rec] == true))) then
			releaseGui(rec)
		end
	end
	-- (au plus un vrai stimulus construit par passage : le coût est étalé)
	local built = false
	for _, rec in ipairs(ranked) do
		if wanted[rec] and not rec.Gui then
			local real = wantReal[rec] == true
			if real and built then
				real = false -- (dessin léger en attendant le prochain passage)
			end
			claimGui(rec, real)
			if rec.Real then
				built = true
			end
		end
	end
end

----------------------------------------------------------------------
-- Comportements par famille
----------------------------------------------------------------------

local BEHAVIOURS: { [string]: (h: Handle) -> () } = {}

-- 🖥️ Bureau : chaise tournée vers les écrans, invite "Utiliser", clic écran
BEHAVIOURS.Desk = function(h: Handle)
	local seat = h.Model:FindFirstChild("SeatPart")
	if seat and seat:IsA("BasePart") and seat:GetAttribute("FacesDesk") ~= true then
		-- (BuildModel oriente les places assises vers l'avant du modèle ; la
		-- chaise d'un bureau regarde les écrans, vers l'arrière)
		seat.CFrame = seat.CFrame * CFrame.Angles(0, math.pi, 0)
		seat:SetAttribute("FacesDesk", true)
	end
	if h.Interactive then
		for _, rec in ipairs(h.Screens) do
			table.insert(h.Clickables, rec.Part)
			h.Roles[rec.Part] = "Desk"
		end
		local anchor = h.Screens[math.max(1, math.ceil(#h.Screens / 2))]
		if anchor then
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "UsePrompt"
			prompt.ActionText = Locale.T("🖥️ Use")
			local item = Config.HouseItemsById and Config.HouseItemsById[h.ItemId]
			prompt.ObjectText = item and Locale.T(item.Name) or ""
			prompt.KeyboardKeyCode = Enum.KeyCode.F
			prompt.GamepadKeyCode = Enum.KeyCode.ButtonY
			prompt.MaxActivationDistance = 9
			prompt.RequiresLineOfSight = false
			prompt.HoldDuration = 0
			prompt.UIOffset = Vector2.new(0, 40)
			prompt.Parent = anchor.Part
			h.Prompt = prompt
			table.insert(h.Connections, prompt.Triggered:Connect(function()
				if h.Alive then
					LiveProps.DeskUsed:Fire(h)
				end
			end))
		end
	end
	h.Click = function(_h, _part, role, _point)
		if role == "Desk" then
			LiveProps.DeskUsed:Fire(h)
		end
	end
end

-- ⌨️ Clavier : touches -> vrais clics (v9.8 : légendes, éclair doux)
local KEY_FLASH = rgb(255, 120, 220)
local LEGEND_PPS = 320 -- pixels de toile par stud (légendes)
local LEGEND_DARK = rgb(58, 54, 80)

-- Légendes : une plaque invisible par rangée, juste au-dessus des touches,
-- avec une SurfaceGui (face Top) et un texte par touche
local function buildLegends(h: Handle)
	if h.State.LegendPlates then
		return
	end
	local keys: { BasePart } = h.State.Keys or {}
	if #keys == 0 then
		return
	end
	local ref = refCF(h)
	local rows: { [string]: { BasePart } } = {}
	local order: { string } = {}
	for _, key in ipairs(keys) do
		local rel = ref:PointToObjectSpace(h.Movers[key] and (ref * h.Movers[key].Offset).Position or key.Position)
		local rowKey = string.format("%.2f", rel.Z * 20)
		if not rows[rowKey] then
			rows[rowKey] = {}
			table.insert(order, rowKey)
		end
		table.insert(rows[rowKey], key)
	end
	local plates: { BasePart } = {}
	local labels: { [BasePart]: TextLabel } = {}
	for _, rowKey in ipairs(order) do
		local list = rows[rowKey]
		local first = list[1]
		local rotation = (ref * h.Movers[first].Offset).Rotation
		local minX, maxX, top, depth = math.huge, -math.huge, -math.huge, 0
		local frameCF = CFrame.new((ref * h.Movers[first].Offset).Position) * rotation
		for _, key in ipairs(list) do
			local rest = ref * h.Movers[key].Offset
			local rel = frameCF:PointToObjectSpace(rest.Position)
			minX = math.min(minX, rel.X - key.Size.X / 2)
			maxX = math.max(maxX, rel.X + key.Size.X / 2)
			top = math.max(top, rel.Y + key.Size.Y / 2)
			depth = math.max(depth, key.Size.Z)
		end
		local width = maxX - minX
		local plate = Instance.new("Part")
		plate.Name = "KeyLegends"
		plate.Anchored = true
		plate.CanCollide = false
		plate.CanQuery = false
		plate.CanTouch = false
		plate.CastShadow = false
		plate.Transparency = 1
		plate.Size = Vector3.new(math.max(0.05, width), 0.01, math.max(0.05, depth))
		-- (toile 0,03 stud au-dessus des touches : pas de scintillement avec leur dessus)
		plate.CFrame = frameCF * CFrame.new((minX + maxX) / 2, top + 0.025, 0)
		local canvas = Vector2.new(math.max(16, math.floor(width * LEGEND_PPS + 0.5)), math.max(8, math.floor(depth * LEGEND_PPS + 0.5)))
		local gui = Instance.new("SurfaceGui")
		gui.Name = "Legends"
		gui.Face = Enum.NormalId.Top
		gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
		gui.CanvasSize = canvas
		gui.LightInfluence = 1
		gui.Brightness = 1
		gui.MaxDistance = LiveProps.LEGEND_DISTANCE + 10
		gui.ClipsDescendants = true
		gui.Active = false
		gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		gui.Parent = plate
		for _, key in ipairs(list) do
			local legend = key:GetAttribute("Legend")
			if type(legend) == "string" and legend ~= "" then
				local rel = plate.CFrame:PointToObjectSpace((ref * h.Movers[key].Offset).Position)
				local w = key.Size.X * LEGEND_PPS
				local d = key.Size.Z * LEGEND_PPS
				local label = Instance.new("TextLabel")
				label.Name = key.Name
				label.BackgroundTransparency = 1
				label.AnchorPoint = Vector2.new(0.5, 0.5)
				label.Position = UDim2.fromOffset((rel.X / plate.Size.X + 0.5) * canvas.X, (rel.Z / plate.Size.Z + 0.5) * canvas.Y)
				label.Size = UDim2.fromOffset(w, d)
				label.Font = Enum.Font.GothamBold
				label.TextSize = math.max(6, math.floor(d * (utf8.len(legend) == 1 and 0.62 or 0.36)))
				label.TextColor3 = key:GetAttribute("KeyStyle") == "A" and LEGEND_DARK or WHITE
				label.TextTransparency = 0.05
				label.Text = legend
				label.Parent = gui
				labels[key] = label
			end
		end
		plate.Parent = h.Model
		table.insert(plates, plate)
	end
	h.State.LegendPlates = plates
	h.State.LegendLabels = labels
end

local function dropLegends(h: Handle)
	local plates = h.State.LegendPlates
	if not plates then
		return
	end
	h.State.LegendPlates = nil
	h.State.LegendLabels = nil
	for _, plate in ipairs(plates) do
		plate:Destroy()
	end
end

BEHAVIOURS.Keyboard = function(h: Handle)
	local keys: { BasePart } = {}
	local byName: { [string]: BasePart } = {}
	for _, d in ipairs(h.Model:GetDescendants()) do
		if d:IsA("BasePart") and string.sub(d.Name, 1, 4) == "Key_" then
			table.insert(keys, d)
			byName[d.Name] = d
			h.Roles[d] = "Key"
			table.insert(h.Clickables, d)
			mover(h, d)
		end
	end
	h.State.Keys = keys
	h.State.KeysByName = byName
	local base = findPart(h.Model, "KeyboardBase")
	if base then
		h.Roles[base] = "AnyKey"
		table.insert(h.Clickables, base)
	end
	local function flashFor(key: BasePart): Color3
		return key.Color:Lerp(KEY_FLASH, 0.55)
	end
	h.Visual = function(_h, part)
		press(h, part, nil, flashFor(part))
	end
	h.Click = function(_h, part, role, point)
		local key = part
		if role ~= "Key" then
			-- clic entre les touches : la touche la plus proche
			local best, bestDistance = nil, math.huge
			for _, k in ipairs(keys) do
				local distance = (k.Position - point).Magnitude
				if distance < bestDistance then
					best, bestDistance = k, distance
				end
			end
			if not best then
				return
			end
			key = best
		end
		press(h, key, nil, flashFor(key):Lerp(WHITE, random:NextNumber(0, 0.3)))
		local gear = gearClick()
		if gear then
			pcall(gear.PlayKeySound, math.max(1, levelOf("Keyboard")), 1, 0)
			local okClick, gain = pcall(gear.Click, "SetupKeyboard", nil)
			if okClick and type(gain) == "number" then
				popText(key, key.Position + Vector3.new(0, 0.2, 0), "+" .. formatGain(gain), nil, 22)
			end
		end
	end
end

-- 🖱️ Souris : boutons -> vrais clics
BEHAVIOURS.Mouse = function(h: Handle)
	for _, d in ipairs(h.Model:GetDescendants()) do
		if d:IsA("BasePart") and d.Name ~= "Root" and d.Name ~= "Hitbox" then
			table.insert(h.Clickables, d)
			h.Roles[d] = d.Name
		end
	end
	local left = findPart(h.Model, "MouseLeft")
	local right = findPart(h.Model, "MouseRight")
	h.Visual = function(_h, part)
		press(h, part, part.Size.Y * 0.5, rgb(120, 220, 255))
	end
	h.Click = function(_h, part, role, _point)
		local button = (role == "MouseRight" and right) or left
		if button then
			press(h, button, button.Size.Y * 0.5, rgb(120, 220, 255))
		end
		local gear = gearClick()
		if gear then
			pcall(gear.PlayClickSound)
			local okClick, gain = pcall(gear.Click, "SetupMouse", nil)
			if okClick and type(gain) == "number" then
				popText(button or part, (button or part).Position + Vector3.new(0, 0.3, 0), "+" .. formatGain(gain), rgb(140, 230, 255), 22)
			end
		end
	end
end

-- 🔘 Papier bulle : éclate / regonfle
BEHAVIOURS.BubbleWrap = function(h: Handle)
	local bubbles: { { Part: BasePart, Popped: boolean, Timer: number, Grow: number, Transparency: number } } = {}
	for _, d in ipairs(h.Model:GetDescendants()) do
		if d:IsA("BasePart") and string.sub(d.Name, 1, 7) == "Bubble_" then
			mover(h, d)
			table.insert(bubbles, { Part = d, Popped = false, Timer = 0, Grow = 1, Transparency = d.Transparency })
			h.Roles[d] = "Bubble"
			table.insert(h.Clickables, d)
		end
	end
	local settings = (Config.Interactions and Config.Interactions.Bubble) or {}
	local maxPerSecond = tonumber(settings.MaxPerSecond) or 12
	local tokens = maxPerSecond
	local lastRefill = os.clock()
	local function setBubble(bubble, grow: number)
		local m = h.Movers[bubble.Part]
		local s = 0.2 + 0.8 * grow
		local size = Vector3.new(m.Size.X * (1.1 - 0.1 * grow), m.Size.Y * s, m.Size.Z * (1.1 - 0.1 * grow))
		bubble.Part.Size = size
		bubble.Part.CFrame = refCF(h) * m.Offset * CFrame.new(0, -(m.Size.Y - size.Y) / 2, 0)
		bubble.Part.Transparency = bubble.Transparency + (1 - grow) * 0.45
	end
	h.Step = function(_h, dt)
		for _, bubble in ipairs(bubbles) do
			if bubble.Popped then
				bubble.Timer -= dt
				if bubble.Timer <= 0 then
					bubble.Grow = math.min(1, bubble.Grow + dt * 2.5)
					setBubble(bubble, bubble.Grow)
					if bubble.Grow >= 1 then
						bubble.Popped = false
					end
				end
			end
		end
	end
	h.Click = function(_h, part, _role, point)
		for _, bubble in ipairs(bubbles) do
			if bubble.Part == part then
				if bubble.Popped then
					return
				end
				local now = os.clock()
				tokens = math.min(maxPerSecond, tokens + (now - lastRefill) * maxPerSecond)
				lastRefill = now
				if tokens < 1 then
					return -- trop vite : la bulle résiste
				end
				tokens -= 1
				bubble.Popped = true
				bubble.Grow = 0
				bubble.Timer = random:NextNumber(5, 9)
				setBubble(bubble, 0)
				playSound("Pop", random:NextNumber(0.9, 1.35))
				if hasFeature("BubbleWrap") then
					interact("Bubble")
					local state = clientState()
					local data = state and state.Data
					local gain = (tonumber(data and data.ClickValue) or 0) * (tonumber(settings.ClickFraction) or 0.5)
					if gain > 0 then
						popText(part, point, "+" .. formatGain(gain), rgb(170, 230, 255), 20)
					end
				else
					popText(part, point, "POP!", rgb(170, 230, 255), 20)
				end
				return
			end
		end
	end
end

-- 🌀 Moulin : les ailes tournent ; souffler = Interact("Spin")
BEHAVIOURS.Windmill = function(h: Handle)
	local pivotPart = findPart(h.Model, "Pivot_Blades")
	local parts = partsNamed(h.Model, "Blade")
	for _, hub in ipairs(partsNamed(h.Model, "Blades")) do
		table.insert(parts, hub)
	end
	local spinner = pivotPart and #parts > 0 and newSpinner(pivotPart, parts, "Z", 1.1) or nil
	if spinner then
		table.insert(h.Spinners, spinner)
	end
	if h.Interactive then
		for _, d in ipairs(h.Model:GetDescendants()) do
			if d:IsA("BasePart") and d.Transparency < 1 and d.Name ~= "Hitbox" then
				table.insert(h.Clickables, d)
				h.Roles[d] = "Spin"
			end
		end
	end
	local settings = (Config.Interactions and Config.Interactions.Spin) or {}
	local cooldown = tonumber(settings.Cooldown) or 2
	local last = -math.huge
	h.Step = function(_h, dt)
		if spinner and spinner.Target > 1.1 then
			spinner.Target = math.max(1.1, spinner.Target - dt * 1.2)
		end
	end
	h.Click = function(_h, part, _role, point)
		if spinner then
			spinner.Target = math.min(9, spinner.Target + 3)
			spinner.Speed = math.max(spinner.Speed, spinner.Target * 0.7)
		end
		playSound("Open", random:NextNumber(1.1, 1.4))
		popText(part, point, "💨", WHITE, 26)
		local now = os.clock()
		if now - last >= cooldown and hasFeature("Pinwheel") then
			last = now
			interact("Spin")
			h.State.BonusSource = "Spin"
			h.State.BonusAt = now
		end
	end
end

-- 🗜️ Presse (v9.8) : le tapis amène l'objet sous la presse, descente,
-- écrasement (éclats, vapeur), remontée, la galette part au bac ; manomètres,
-- voyants, afficheur, gyrophare ; couleurs du palier de la presse du clicker
-- (niveau "Presse hydraulique" du propriétaire). Gros bouton = Interact("Press").
type Crush = { Part: BasePart, Offset: CFrame, Size: Vector3, Axis: Vector3, Transparency: number, Variant: number }
local PRESS_DURATIONS = { Load = 1.3, Settle = 0.35, Descend = 0.9, Squeeze = 0.45, Hold = 0.35, Rise = 0.8, Eject = 0.9 }
local PRESS_NEXT = { Load = "Settle", Settle = "Descend", Descend = "Squeeze", Squeeze = "Hold", Hold = "Rise", Rise = "Eject", Eject = "Load" }
local TINT_ROLES = { Frame = "Frame", FrameDark = "Dark", AccentA = "AccentA", AccentB = "AccentB", Chrome = "Chrome", Hose = "Hose", Bolt = "Bolt" }
BEHAVIOURS.Press = function(h: Handle)
	local model = h.Model
	local ramPivot = findPart(model, "Pivot_Ram")
	local anvil = findPart(model, "Pivot_Anvil")
	local footprint = model:GetAttribute("Footprint")
	local k = typeof(footprint) == "Vector3" and footprint.X / 100 or 0.05 -- studs par unité
	local ramParts = partsNamed(model, "PressRam")
	local ramOffsets = {}
	local ramCFrames = {}
	if ramPivot then
		for index, part in ipairs(ramParts) do
			ramOffsets[index] = ramPivot.CFrame:ToObjectSpace(part.CFrame)
			ramCFrames[index] = part.CFrame
		end
	end
	-- objets (une variante visible à la fois), repère de l'enclume
	local crushables: { Crush } = {}
	local variants = 0
	if anvil then
		local up = anvil.CFrame.UpVector
		for _, part in ipairs(partsNamed(model, "Crushable")) do
			local cf = part.CFrame
			local dots = { math.abs(cf.RightVector:Dot(up)), math.abs(cf.UpVector:Dot(up)), math.abs(cf.LookVector:Dot(up)) }
			local axis = Vector3.new(0, 1, 0)
			if dots[1] >= dots[2] and dots[1] >= dots[3] then
				axis = Vector3.new(1, 0, 0)
			elseif dots[3] >= dots[2] then
				axis = Vector3.new(0, 0, 1)
			end
			local variant = tonumber(part:GetAttribute("Variant")) or 1
			variants = math.max(variants, variant)
			local offset = anvil.CFrame:ToObjectSpace(cf)
			local base = tonumber(part:GetAttribute("BaseTransparency")) or part.Transparency
			table.insert(crushables, { Part = part, Offset = offset, Size = part.Size, Axis = axis, Transparency = base, Variant = variant })
		end
	end
	-- trajets (studs, repère de l'enclume : +X = vers le tapis)
	local slats = partsNamed(model, "BeltSlat")
	local slatOffsets: { CFrame } = {}
	local slatCFrames: { CFrame } = {}
	local beltMin, beltMax = math.huge, -math.huge
	if anvil then
		for index, slat in ipairs(slats) do
			local offset = anvil.CFrame:ToObjectSpace(slat.CFrame)
			slatOffsets[index] = offset
			slatCFrames[index] = slat.CFrame
			beltMin = math.min(beltMin, offset.X)
			beltMax = math.max(beltMax, offset.X)
		end
	end
	-- (objet en miroir : le tapis est de l'autre côté)
	local beltSide = (#slats == 0 or (beltMin + beltMax) / 2 >= 0) and 1 or -1
	local range = beltMax > beltMin and beltMax - beltMin or 0
	local loadDX = #slats > 0 and (beltSide > 0 and beltMax + range * 0.1 or beltMin - range * 0.1) or 40 * k
	local binDX = -34 * k * beltSide
	local binDY = -16 * k
	local slatGap = #slats > 1 and (beltMax - beltMin) / (#slats - 1) or 1
	local slatShift = 0
	-- course du coulisseau : jusqu'à la hauteur d'une galette au-dessus de l'enclume
	local travel = 0
	if ramPivot and anvil then
		local plateBottom = math.huge
		for _, part in ipairs(ramParts) do
			local rel = anvil.CFrame:PointToObjectSpace(part.Position)
			plateBottom = math.min(plateBottom, rel.Y - part.Size.Y / 2)
		end
		travel = math.max(0, plateBottom - 3 * k)
	end
	local beacon = findPart(model, "PressBeacon")
	local display = findPart(model, "PressDisplay")
	local lamps = { findPart(model, "Lamp1"), findPart(model, "Lamp2"), findPart(model, "Lamp3") }
	type Needle = { Part: BasePart, Dial: BasePart, Rel: CFrame, Value: number }
	local needles: { Needle } = {}
	for index = 1, 2 do
		local needle = findPart(model, "Gauge" .. index)
		local dial = findPart(model, "GaugeDial" .. index)
		if needle and dial then
			mover(h, needle)
			table.insert(needles, { Part = needle, Dial = dial, Rel = dial.CFrame:ToObjectSpace(needle.CFrame), Value = 0 })
		end
	end
	-- couleurs du palier (propriétaire : son niveau ; visiteur : palier par défaut)
	local tinted: { BasePart } = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and type(d:GetAttribute("Tint")) == "string" then
			table.insert(tinted, d)
		end
	end
	local style: any = nil
	local function applyTier()
		local module = setupModule()
		local tiers = module and module.PressTiers
		if type(tiers) ~= "table" then
			return
		end
		local level = h.IsOwner and levelOf("Press") or 0
		local tier = level > 0 and math.clamp(math.floor(level), 1, #tiers) or (tonumber(module.PRESS_DEFAULT_TIER) or 5)
		if h.State.Tier == tier then
			return
		end
		h.State.Tier = tier
		style = tiers[tier]
		for _, part in ipairs(tinted) do
			local key = TINT_ROLES[part:GetAttribute("Tint")]
			local color = key and style[key]
			if typeof(color) == "Color3" then
				part.Color = color
				local role = part:GetAttribute("Tint")
				if role == "Frame" or role == "FrameDark" then
					part.Material = (style.Wood and role == "Frame") and Enum.Material.Wood or (style.Crystal and Enum.Material.Glass or Enum.Material.Metal)
				end
			end
		end
	end
	applyTier()
	-- éclats + vapeur (seulement dans la ville)
	local debris: ParticleEmitter? = nil
	local steam: ParticleEmitter? = nil
	if h.Interactive and anvil then
		for _, name in ipairs({ "PressDebris", "PressSteam" }) do
			local old = anvil:FindFirstChild(name)
			if old then
				old:Destroy()
			end
		end
		local s = math.max(0.3, k * 18)
		local emitter = Instance.new("ParticleEmitter")
		emitter.Name = "PressDebris"
		emitter.Rate = 0
		emitter.Lifetime = NumberRange.new(0.35, 0.75)
		emitter.Speed = NumberRange.new(4 * s, 9 * s)
		emitter.SpreadAngle = Vector2.new(75, 75)
		emitter.Acceleration = Vector3.new(0, -35 * s, 0)
		emitter.Drag = 1.5
		emitter.Size = NumberSequence.new(0.22 * s, 0.05 * s)
		emitter.Rotation = NumberRange.new(0, 360)
		emitter.RotSpeed = NumberRange.new(-240, 240)
		emitter.LightEmission = 0
		emitter.EmissionDirection = Enum.NormalId.Top
		emitter.Parent = anvil
		debris = emitter
		local puff = Instance.new("ParticleEmitter")
		puff.Name = "PressSteam"
		puff.Rate = 0
		puff.Lifetime = NumberRange.new(0.8, 1.4)
		puff.Speed = NumberRange.new(1.5 * s, 3 * s)
		puff.SpreadAngle = Vector2.new(35, 35)
		puff.Acceleration = Vector3.new(0, 2 * s, 0)
		puff.Size = NumberSequence.new(0.5 * s, 1.4 * s)
		puff.Transparency = NumberSequence.new(0.45, 1)
		puff.Color = ColorSequence.new(rgb(245, 245, 250))
		puff.LightEmission = 0
		puff.EmissionDirection = Enum.NormalId.Top
		puff.Parent = anvil
		steam = puff
	end
	-- afficheur (compteur d'écrasements)
	local counter: TextLabel? = nil
	local crushes = 0
	if h.Interactive and display then
		local state = clientState()
		local stats = state and state.Data and state.Data.Stats
		crushes = h.IsOwner and tonumber(stats and stats.PressCrushes) or 0
		local old = display:FindFirstChild("PressCounter")
		if old then
			old:Destroy()
		end
		local gui = Instance.new("SurfaceGui")
		gui.Name = "PressCounter"
		gui.Face = Enum.NormalId.Top
		gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
		gui.CanvasSize = Vector2.new(200, 100)
		gui.LightInfluence = 0
		gui.Brightness = 1
		gui.MaxDistance = 40
		gui.Active = false
		gui.Parent = display
		local text = Instance.new("TextLabel")
		text.BackgroundTransparency = 1
		text.Size = UDim2.fromScale(1, 1)
		text.Font = Enum.Font.Code
		text.TextSize = 40
		text.TextColor3 = rgb(110, 255, 150)
		text.Text = ""
		text.Parent = gui
		counter = text
	end
	local function showCount()
		if counter then
			counter.Text = string.format("💥%06d", math.floor(crushes) % 1000000)
		end
	end
	showCount()

	local current = 1
	local phase = "Load"
	local phaseTime = random:NextNumber(0, 1)
	local turbo = false
	local pendingTurbo = false
	local cooldownEnd = 0
	local tierClock = 0
	local settings = (Config.Interactions and Config.Interactions.Press) or {}
	local cooldown = tonumber(settings.Cooldown) or 3
	local function showVariant(variant: number, transparency: number?)
		for _, c in ipairs(crushables) do
			c.Part.Transparency = c.Variant == variant and math.max(c.Transparency, transparency or 0) or 1
		end
	end
	-- pose de l'objet : écrasement `s` (1 = intact), décalage (repère de l'enclume)
	local function placeItem(s: number, slide: Vector3, gMax: number?)
		if not anvil then
			return
		end
		local g = math.min(gMax or 1.9, 1 / math.sqrt(math.max(0.15, s)))
		local base = anvil.CFrame * CFrame.new(slide)
		for _, c in ipairs(crushables) do
			if c.Variant == current then
				local o = c.Offset
				local sx = c.Axis.X > 0.5 and s or g
				local sy = c.Axis.Y > 0.5 and s or g
				local sz = c.Axis.Z > 0.5 and s or g
				c.Part.Size = Vector3.new(c.Size.X * sx, c.Size.Y * sy, c.Size.Z * sz)
				c.Part.CFrame = base * CFrame.new(o.X * g, o.Y * s, o.Z * g) * o.Rotation
			end
		end
	end
	local function setRam(drop: number)
		if not ramPivot then
			return
		end
		local base = ramPivot.CFrame * CFrame.new(0, -drop, 0)
		for index, offset in ipairs(ramOffsets) do
			ramCFrames[index] = base * offset
		end
		workspace:BulkMoveTo(ramParts, ramCFrames, Enum.BulkMoveMode.FireCFrameChanged)
	end
	local function moveBelt(dx: number)
		if not anvil or #slats == 0 then
			return
		end
		local span = slatGap * #slats
		slatShift = (slatShift + dx) % span
		local base = anvil.CFrame
		local lo = beltMin - slatGap * 0.5
		for index, offset in ipairs(slatOffsets) do
			-- (les lamelles avancent vers l'enclume et reviennent au bout du tapis)
			local x = lo + ((offset.X - beltSide * slatShift - lo) % span)
			slatCFrames[index] = base * CFrame.new(x - offset.X, 0, 0) * offset
		end
		workspace:BulkMoveTo(slats, slatCFrames, Enum.BulkMoveMode.FireCFrameChanged)
	end
	local function setLamps(on: number)
		for index, lamp in ipairs(lamps) do
			if lamp then
				lamp.Transparency = index == on and 0 or 0.72
			end
		end
	end
	local squash = 1
	showVariant(current)
	placeItem(1, Vector3.new(loadDX, 0, 0))
	h.Step = function(_h, dt)
		tierClock += dt
		if tierClock > 3 then
			tierClock = 0
			applyTier()
		end
		local speed = (turbo and 3.2 or 1) * (1 + ((h.State.Tier or 5) - 1) * 0.05)
		phaseTime += dt * speed
		local duration = PRESS_DURATIONS[phase] or 1
		local t = math.clamp(phaseTime / duration, 0, 1)
		local pressure = 0
		if phase == "Load" then
			-- le tapis amène l'objet jusqu'à l'enclume
			local eased = 1 - (1 - t) ^ 2
			placeItem(1, Vector3.new(loadDX * (1 - eased), 0, 0))
			moveBelt(dt * speed * math.abs(loadDX) / duration * (1 - t * 0.6))
			setRam(0)
			setLamps(1)
		elseif phase == "Settle" then
			placeItem(1, Vector3.zero)
			setLamps(1)
			if pendingTurbo then
				t = 1
			end
		elseif phase == "Descend" then
			local drop = travel * (t * t)
			setRam(drop)
			pressure = t * 0.7
			-- le coulisseau touche l'objet vers 60 % de la course, puis l'écrase
			local touch = 0.6
			if t > touch then
				squash = 1 - (t - touch) / (1 - touch) * 0.85
				placeItem(squash, Vector3.zero)
				pressure = 0.7 + (t - touch) / (1 - touch) * 0.3
			end
			setLamps(3)
		elseif phase == "Squeeze" then
			setRam(travel + math.sin(t * math.pi * 7) * 0.012)
			pressure = 1
			setLamps(3)
		elseif phase == "Hold" then
			setRam(travel)
			pressure = 1 - t * 0.2
			setLamps(3)
		elseif phase == "Rise" then
			setRam(travel * (1 - t) ^ 2)
			pressure = 0.8 * (1 - t)
			setLamps(2)
		elseif phase == "Eject" then
			-- la galette glisse vers le bac, tombe et s'efface
			local fall = math.max(0, t - 0.55) / 0.45
			-- (la galette se replie un peu pour passer entre les colonnes)
			placeItem(0.15, Vector3.new(binDX * math.min(1, t / 0.7), binDY * fall * fall, 0), 1.9 - 0.8 * math.min(1, t / 0.25))
			showVariant(current, math.clamp((t - 0.7) / 0.3, 0, 1))
			moveBelt(dt * speed * math.abs(loadDX) / PRESS_DURATIONS.Load * 0.5)
			setLamps(2)
		end
		-- manomètres (aiguilles qui suivent la pression, un peu de retard / tremblement)
		for index, needle in ipairs(needles) do
			local target = pressure * (index == 1 and 1 or 0.82) + (pressure > 0.95 and math.sin(h.Clock * 40) * 0.03 or 0)
			needle.Value += (target - needle.Value) * math.min(1, dt * (index == 1 and 9 or 5))
			needle.Part.CFrame = needle.Dial.CFrame * CFrame.Angles(needle.Value * 2.4, 0, 0) * needle.Rel
		end
		if beacon then
			local active = phase == "Descend" or phase == "Squeeze" or phase == "Hold"
			beacon.Transparency = active and ((math.floor(h.Clock * 6) % 2 == 0) and 0 or 0.55) or 0.25
		end
		if t >= 1 then
			local nextPhase = PRESS_NEXT[phase] or "Load"
			if phase == "Descend" then
				-- CRUNCH : éclats de la couleur du palier (+ l'objet) et son (si clic)
				squash = 0.15
				placeItem(squash, Vector3.zero)
				if debris then
					local first = style and style.Debris and style.Debris[1] or rgb(200, 205, 215)
					local itemColor = first
					for _, c in ipairs(crushables) do
						if c.Variant == current then
							itemColor = c.Part.Color
							break
						end
					end
					debris.Color = ColorSequence.new(itemColor, first)
					debris:Emit(18)
				end
				crushes += 1
				showCount()
				if h.State.Loud then
					h.State.Loud = false
					playSound("Crush", random:NextNumber(0.85, 1.15) * (turbo and 0.85 or 1))
				end
			elseif phase == "Rise" and steam and style and style.Steam then
				steam:Emit(6)
			elseif phase == "Eject" then
				-- objet suivant, remis intact au bout du tapis
				current = variants > 0 and (current % variants + 1) or 1
				squash = 1
				turbo = false
				showVariant(current)
				placeItem(1, Vector3.new(loadDX, 0, 0))
			elseif phase == "Settle" then
				turbo = pendingTurbo or turbo
				pendingTurbo = false
			end
			phase, phaseTime = nextPhase, 0
		end
	end
	if h.Interactive then
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") and d.Transparency < 1 and d.Name ~= "Hitbox" then
				table.insert(h.Clickables, d)
				h.Roles[d] = d.Name == "PressButton" and "PressButton" or "Press"
			end
		end
	end
	h.Click = function(_h, part, role, point)
		local button = role == "PressButton" and part or findPart(model, "PressButton")
		if button then
			press(h, button, button.Size.X * 0.4, nil)
		end
		if not hasFeature("PressStart") then
			-- sans "Turbo Press" : l'écrasement démarre quand même, sans bonus
			pendingTurbo = true
			popText(part, point, Locale.T("🔒 Unlocks with %s", upgradeName("PressStart")), rgb(230, 230, 240), 16)
			return
		end
		local now = os.clock()
		if now < cooldownEnd then
			playSound("Error", 1)
			return
		end
		cooldownEnd = now + cooldown
		interact("Press")
		playSound("Click", 0.7)
		h.State.Loud = true
		h.State.BonusSource = "Press"
		h.State.BonusAt = now
		if phase == "Descend" or phase == "Squeeze" or phase == "Hold" then
			turbo = true
		else
			pendingTurbo = true
			turbo = true
		end
	end
end

-- 🎧 Hi-fi : disque / bobines, membranes, VU ; ▶ et ⏭
BEHAVIOURS.HiFi = function(h: Handle)
	local vinylPivot = findPart(h.Model, "Pivot_Vinyl")
	local vinyl = partsNamed(h.Model, "Vinyl")
	local disc = vinylPivot and #vinyl > 0 and newSpinner(vinylPivot, vinyl, "Y", 3.5) or nil
	if disc then
		table.insert(h.Spinners, disc)
	end
	local spools = {}
	for index = 1, 2 do
		local p = findPart(h.Model, "Pivot_Spool" .. index)
		local list = partsNamed(h.Model, "Spool" .. index)
		if p and #list > 0 then
			local spinner = newSpinner(p, list, "Z", 4)
			table.insert(spools, spinner)
			table.insert(h.Spinners, spinner)
		end
	end
	local cones = partsNamed(h.Model, "SpeakerCone")
	for _, cone in ipairs(cones) do
		mover(h, cone)
	end
	local bars = {}
	for index = 1, 12 do
		local bar = findPart(h.Model, "VU_" .. index)
		if not bar then
			break
		end
		mover(h, bar)
		table.insert(bars, { Part = bar, Level = 0.3 })
	end
	local playButton = findPart(h.Model, "PlayButton")
	local nextButton = findPart(h.Model, "NextButton")
	local playing = true
	local checkTimer = 0
	local function musicPlaying(): boolean
		if not h.Interactive then
			return true -- aperçu : toujours en musique
		end
		local manager = soundManager()
		if manager and type(manager.IsMusicPlaying) == "function" then
			local ok, value = pcall(manager.IsMusicPlaying)
			if ok and value == true then
				return true
			end
			-- pas de musique dans la playlist : le disque tourne quand même doucement
			local okList, hasList = pcall(manager.HasPlaylist)
			return okList and hasList == false
		end
		return true
	end
	h.Step = function(_h, dt)
		checkTimer -= dt
		if checkTimer <= 0 then
			checkTimer = 0.5
			playing = musicPlaying()
			local speed = playing and 3.5 or 0
			if disc then
				disc.Target = speed
			end
			for _, spool in ipairs(spools) do
				spool.Target = playing and 4 or 0
			end
		end
		local clock = h.Clock
		local beat = playing and math.max(0, math.sin(clock * 8.4)) ^ 3 or 0
		local ref = refCF(h)
		for _, cone in ipairs(cones) do
			local m = h.Movers[cone]
			local s = 1 + beat * 0.1
			cone.Size = Vector3.new(m.Size.X * (1 + beat * 0.8), m.Size.Y * s, m.Size.Z * s)
		end
		for index, bar in ipairs(bars) do
			local target = playing and (0.2 + 0.8 * math.abs(math.sin(clock * (2.2 + index * 0.41) + index * 1.7)) * (0.6 + beat * 0.4)) or 0.08
			bar.Level += (target - bar.Level) * math.min(1, dt * 14)
			local m = h.Movers[bar.Part]
			local height = math.max(0.02, m.Size.Y * bar.Level)
			bar.Part.Size = Vector3.new(m.Size.X, height, m.Size.Z)
			bar.Part.CFrame = ref * m.Offset * CFrame.new(0, -(m.Size.Y - height) / 2, 0)
		end
	end
	if h.Interactive then
		for _, d in ipairs(h.Model:GetDescendants()) do
			if d:IsA("BasePart") and d.Transparency < 1 and d.Name ~= "Hitbox" then
				table.insert(h.Clickables, d)
				h.Roles[d] = (d.Name == "NextButton" and "Next") or "Play"
			end
		end
	end
	h.Click = function(_h, part, role, point)
		local manager = soundManager()
		if not hasFeature("Lofi") then
			popText(part, point, Locale.T("🔒 Unlocks with 🎧 %s", Locale.T("Lofi Beats")), rgb(220, 200, 255), 16)
			return
		end
		if role == "Next" then
			if nextButton then
				press(h, nextButton, nextButton.Size.Y * 0.5, rgb(200, 230, 255))
			end
			if manager and type(manager.NextTrack) == "function" then
				local ok, changed = pcall(manager.NextTrack)
				if ok and changed then
					playSound("Open", 1.25)
					popText(part, point, "⏭", WHITE, 24)
					for _, spinner in ipairs(h.Spinners) do
						spinner.Speed = 12 -- petit coup de disque
					end
				end
			end
			return
		end
		if playButton then
			press(h, playButton, playButton.Size.Y * 0.5, rgb(200, 255, 220))
		end
		-- ▶ / ❚❚ : même chemin que le lecteur des ⚙️ Réglages
		local settings = settingsPanel()
		if settings and type(settings.Get) == "function" and type(settings.Apply) == "function" then
			local okGet, current = pcall(settings.Get, "Music")
			local newValue = not (okGet and current ~= false)
			pcall(settings.Apply, "Music", newValue)
			playSound("Open", newValue and 1.3 or 0.8)
			popText(part, point, newValue and "▶" or "❚❚", WHITE, 24)
			checkTimer = 0
			task.spawn(function()
				local module = net()
				if module then
					pcall(function()
						module.Function("SetSetting"):InvokeServer("Music", newValue)
					end)
				end
			end)
		end
	end
end

-- 📰 Écran d'infos : clic = Interact("Headline")
BEHAVIOURS.NewsTV = function(h: Handle)
	local lamp = findPart(h.Model, "OnAir")
	h.Step = function(_h, _dt)
		if lamp then
			lamp.Transparency = (math.floor(h.Clock * 1.5) % 2 == 0) and 0 or 0.45
		end
	end
	if h.Interactive then
		for _, rec in ipairs(h.Screens) do
			table.insert(h.Clickables, rec.Part)
			h.Roles[rec.Part] = "Headline"
		end
	end
	local settings = (Config.Interactions and Config.Interactions.Headline) or {}
	local cooldown = tonumber(settings.Cooldown) or 8
	local last = -math.huge
	h.Click = function(_h, part, _role, point)
		local now = os.clock()
		if now - last < cooldown then
			popText(part, point, "📰", WHITE, 22)
			return
		end
		last = now
		playSound("Click", 1)
		if hasFeature("NewsTicker") then
			interact("Headline")
			h.State.BonusSource = "Headline"
			h.State.BonusAt = now
		end
		popText(part, point, "📰 !", WHITE, 22)
	end
end

-- 🎥 Coin live : voyant REC, ON AIR, anneau qui respire
BEHAVIOURS.LiveStudio = function(h: Handle)
	local rec = findPart(h.Model, "RecLight")
	local onAir = findPart(h.Model, "OnAir")
	local ring = partsNamed(h.Model, "RingLight")
	h.Step = function(_h, _dt)
		local clock = h.Clock
		if rec then
			rec.Transparency = (math.floor(clock * 1.2) % 2 == 0) and 0 or 0.7
		end
		if onAir then
			onAir.Transparency = 0.1 + (math.sin(clock * 2.5) + 1) * 0.12
		end
		local warm = rgb(255, 246, 236):Lerp(rgb(255, 214, 236), (math.sin(clock * 0.8) + 1) / 2)
		for _, part in ipairs(ring) do
			part.Color = warm
		end
	end
end

-- 📺 Télé : clic sur l'écran = chaîne suivante (v9.8) ; halo doux ("ambilight")
-- de la couleur de la chaîne
local CHANNELS = { "Live", "DVD", "News", "Runner" }
local CHANNEL_NAMES = { Live = "🔴 Live", DVD = "📀 DVD", News = "📰 News", Runner = "🏃 Runner" }
local HALO_COLORS = { Live = rgb(220, 120, 255), DVD = rgb(90, 200, 255), News = rgb(90, 140, 255), Runner = rgb(255, 190, 120) }
BEHAVIOURS.TV = function(h: Handle)
	local halo = findPart(h.Model, "Ambilight")
	local rec = h.Screens[1]
	-- (v9.8 : la télé s'allume sur le live du clicker ; le DVD est sur la chaîne suivante)
	if rec and rec.Kind == "DVD" and h.Interactive then
		rec.Kind = "Live"
	end
	if halo then
		h.Step = function(_h, _dt)
			local base = HALO_COLORS[rec and rec.Kind or "DVD"] or CYAN_SOFT
			halo.Color = base:Lerp(WHITE, 0.25 + 0.15 * math.sin(h.Clock * 0.9))
		end
	end
	if h.Interactive and rec then
		table.insert(h.Clickables, rec.Part)
		h.Roles[rec.Part] = "Channel"
	end
	local last = -math.huge
	h.Click = function(_h, part, role, point)
		if role ~= "Channel" or not rec then
			return
		end
		local now = os.clock()
		if now - last < 0.35 then
			return
		end
		last = now
		local index = table.find(CHANNELS, rec.Kind) or 0
		local kind = CHANNELS[index % #CHANNELS + 1]
		;(LiveProps :: any).SetChannel(rec, kind)
		popText(part, point, "📺 " .. Locale.T(CHANNEL_NAMES[kind] or kind), WHITE, 20)
	end
end

-- 🌼 Plante : la fleur se balance ; le lotus scintille
BEHAVIOURS.Plant = function(h: Handle)
	local pivotPart = findPart(h.Model, "Pivot_Flower")
	local parts = partsNamed(h.Model, "Flower")
	local sway = pivotPart and #parts > 0 and newSpinner(pivotPart, parts, "Z", 0) or nil
	local sparkles = partsNamed(h.Model, "Sparkle")
	for _, spark in ipairs(sparkles) do
		mover(h, spark)
	end
	local phase = random:NextNumber(0, 6)
	h.Step = function(_h, _dt)
		local clock = h.Clock + phase
		if sway then
			swaySpinner(sway, clock, 0.05)
		end
		local ref = refCF(h)
		for index, spark in ipairs(sparkles) do
			local m = h.Movers[spark]
			spark.CFrame = ref * m.Offset * CFrame.new(0, math.sin(clock * 1.6 + index) * m.Size.Y * 1.5, 0)
			spark.Transparency = 0.2 + (math.sin(clock * 3 + index * 1.3) + 1) * 0.3
		end
	end
end

----------------------------------------------------------------------
-- Boucle
----------------------------------------------------------------------

local function currentFocus(): Vector3
	if focusPoint and os.clock() - focusAt < 2 then
		return focusPoint
	end
	local camera = workspace.CurrentCamera
	if camera then
		return camera.CFrame.Position
	end
	return Vector3.zero
end

local function characterPosition(): Vector3?
	local player = Players.LocalPlayer
	local character = player and player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root.Position
	end
	return nil
end

local function rebuildClickList()
	table.clear(clickList)
	for _, h in ipairs(handles) do
		if h.Alive and h.Interactive and (h.Distance < 40 or h == deskFocus) then
			for _, part in ipairs(h.Clickables) do
				table.insert(clickList, part)
			end
		end
	end
end

local animClock, manageClock, hoverClock, rgbClock = 0, 0, 0, 0
local hover: SelectionBox? = nil
local pointer: Vector2? = nil

local function handleOf(part: Instance): Handle?
	local node: Instance? = part
	while node and node ~= workspace do
		if node:IsA("Model") then
			local h = byModel[node]
			if h then
				return h
			end
		end
		node = node.Parent
	end
	return nil
end

local function raycast(position: Vector2): (BasePart?, Vector3?, Handle?)
	if #clickList == 0 then
		return nil, nil, nil
	end
	local camera = workspace.CurrentCamera
	if not camera then
		return nil, nil, nil
	end
	local ray = camera:ScreenPointToRay(position.X, position.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = clickList
	local result = workspace:Raycast(ray.Origin, ray.Direction * 200, params)
	if not result then
		return nil, nil, nil
	end
	local part = result.Instance
	if not part:IsA("BasePart") then
		return nil, nil, nil
	end
	return part, result.Position, handleOf(part)
end

local function tryClick(position: Vector2): boolean
	local part, point, h = raycast(position)
	if not part or not point or not h or not h.Alive or not h.Interactive then
		return false
	end
	local near = h == deskFocus
	if not near and deskFocus then
		-- clavier / souris posés sur le bureau du mode bureau
		for _, other in ipairs(LiveProps.Peripherals(deskFocus)) do
			if other == h then
				near = true
			end
		end
	end
	if not near then
		local character = characterPosition()
		near = character ~= nil and (character - point).Magnitude <= LiveProps.CLICK_DISTANCE
	end
	if not near then
		popText(part, point, Locale.T("Get closer 👣"), WHITE, 18)
		return true
	end
	local role = h.Roles[part] or "Any"
	local click = h.Click
	if click then
		local ok, err = pcall(click, h, part, role, point)
		if not ok then
			warn("[LiveProps] Clic " .. h.ItemId .. " : " .. tostring(err))
		end
	end
	return true
end

local function stepHover()
	if not UserInputService.MouseEnabled or not pointer then
		return
	end
	local part, point, h = raycast(pointer :: Vector2)
	local target: BasePart? = nil
	if part and h and point then
		local character = characterPosition()
		if h == deskFocus or (character and (character - point).Magnitude <= LiveProps.CLICK_DISTANCE) then
			target = part
		end
	end
	if target then
		local box = hover
		if not box then
			local newBox = Instance.new("SelectionBox")
			newBox.Name = "LivePropsHover"
			newBox.LineThickness = 0.02
			newBox.Color3 = rgb(255, 120, 200)
			newBox.SurfaceTransparency = 1
			newBox.Parent = playerGui() or workspace
			hover = newBox
			box = newBox
		end
		if box then
			box.Adornee = target
			box.Visible = true
		end
	elseif hover then
		hover.Adornee = nil
		hover.Visible = false
	end
end

local function manage()
	local focus = currentFocus()
	for index = #handles, 1, -1 do
		local h = handles[index]
		if not h.Model.Parent or not h.Ref.Parent then
			-- modèle retiré sans Detach (reconstruction de la pièce) : on nettoie
			LiveProps.Detach(h)
		else
			h.Distance = (h.Ref.Position - focus).Magnitude
			h.Paused = h ~= deskFocus and h.Distance > h.PauseDistance
		end
	end
	manageScreens(focus)
	rebuildClickList()
	-- légendes : seulement le clavier le plus proche (ou celui du mode bureau)
	local best: Handle? = nil
	local bestDistance = LiveProps.LEGEND_DISTANCE
	local deskKeyboards: { [Handle]: boolean } = {}
	if deskFocus then
		for _, other in ipairs(LiveProps.Peripherals(deskFocus)) do
			deskKeyboards[other] = true
		end
	end
	for _, h in ipairs(handles) do
		if h.Alive and h.Kind == "Keyboard" and h.Interactive then
			local distance = deskKeyboards[h] and -1 or h.Distance
			if distance < bestDistance then
				best, bestDistance = h, distance
			end
		end
	end
	for _, h in ipairs(handles) do
		if h.Kind == "Keyboard" then
			if h == best then
				local ok, err = pcall(buildLegends, h)
				if not ok then
					warn("[LiveProps] Légendes : " .. tostring(err))
					h.State.LegendPlates = h.State.LegendPlates or {}
				end
			else
				dropLegends(h)
			end
		end
	end
end

-- Une image d'animation d'un objet (appelée dans un pcall, sans fermeture)
local function stepHandle(h: Handle, step: number, doRGB: boolean)
	for _, spinner in ipairs(h.Spinners) do
		if spinner.Speed ~= 0 or spinner.Target ~= 0 then
			stepSpinner(spinner, step)
		end
	end
	stepPresses(h, step)
	local custom = h.Step
	if custom then
		custom(h, step)
	end
	if doRGB and #h.RGB > 0 then
		for index, part in ipairs(h.RGB) do
			part.Color = Color3.fromHSV((h.Clock * 0.12 + index * 0.07) % 1, 0.72, 1)
		end
	end
	for _, rec in ipairs(h.Screens) do
		local screen = rec.Screen
		if screen then
			screen:Step(step)
		end
	end
end

local function onHeartbeat(dt: number)
	dt = math.min(dt, 0.1)
	manageClock += dt
	if manageClock >= MANAGE_STEP then
		manageClock = 0
		manage()
	end
	animClock += dt
	if animClock < ANIM_STEP then
		stepFloaters(dt)
		return
	end
	local step = animClock
	animClock = 0
	stepFloaters(step)
	rgbClock += step
	local doRGB = rgbClock >= RGB_STEP
	if doRGB then
		rgbClock = 0
	end
	for _, h in ipairs(handles) do
		if h.Alive and not h.Paused then
			h.Clock += step
			local ok, err = pcall(stepHandle, h, step, doRGB)
			if not ok then
				warn("[LiveProps] " .. h.ItemId .. " : " .. tostring(err))
				h.Paused = true
			end
		end
	end
	hoverClock += step
	if hoverClock >= HOVER_STEP then
		hoverClock = 0
		stepHover()
	end
end

local function ensureLoop()
	if not heartbeat then
		heartbeat = RunService.Heartbeat:Connect(onHeartbeat)
	end
	if #inputConnections == 0 then
		table.insert(inputConnections, UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
			if processed then
				return
			end
			local kind = input.UserInputType
			if kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch then
				tryClick(Vector2.new(input.Position.X, input.Position.Y))
			end
		end))
		table.insert(inputConnections, UserInputService.InputChanged:Connect(function(input: InputObject)
			if input.UserInputType == Enum.UserInputType.MouseMovement then
				pointer = Vector2.new(input.Position.X, input.Position.Y)
			end
		end))
	end
	if not notifyConnection then
		local state = clientState()
		if state and state.NotifyReceived and type(state.NotifyReceived.Connect) == "function" then
			-- bonus du serveur (Spin / Press / Headline) : "+X" au-dessus de l'objet
			notifyConnection = state.NotifyReceived:Connect(function(payload: any)
				if type(payload) ~= "table" or payload.Type ~= "Bonus" then
					return
				end
				local amount = tonumber(payload.Amount)
				if not amount then
					return
				end
				local now = os.clock()
				for _, h in ipairs(handles) do
					if h.Alive and h.State.BonusSource == payload.Source and now - (h.State.BonusAt or 0) < 4 then
						h.State.BonusSource = nil
						local anchor = h.Ref
						local top = h.Model:GetAttribute("Footprint")
						local lift = typeof(top) == "Vector3" and top.Y or 3
						popText(anchor, anchor.Position + Vector3.new(0, lift + 0.5, 0), "+" .. formatGain(amount), rgb(255, 214, 80), 28)
						return
					end
				end
			end)
		end
	end
end

local function stopLoop()
	if heartbeat then
		heartbeat:Disconnect()
		heartbeat = nil
	end
	for _, connection in ipairs(inputConnections) do
		connection:Disconnect()
	end
	table.clear(inputConnections)
	if notifyConnection then
		pcall(function()
			notifyConnection:Disconnect()
		end)
		notifyConnection = nil
	end
	if hover then
		hover:Destroy()
		hover = nil
	end
	for _, f in ipairs(floaters) do
		f.Gui:Destroy()
	end
	table.clear(floaters)
	table.clear(clickList)
end

----------------------------------------------------------------------
-- API
----------------------------------------------------------------------

function LiveProps.IsLive(itemId: string): boolean
	local module = setupModule()
	if module and type(module.KindOf) == "function" then
		local ok, kind = pcall(module.KindOf, itemId)
		return ok and kind ~= nil
	end
	local item = Config.HouseItemsById and Config.HouseItemsById[itemId]
	return type(item) == "table" and type(item.Setup) == "table"
end

local function setupOf(itemId: string): { [string]: any }?
	local module = setupModule()
	if module and type(module.SetupOf) == "function" then
		local ok, setup = pcall(module.SetupOf, itemId)
		if ok and type(setup) == "table" then
			return setup
		end
	end
	local item = Config.HouseItemsById and Config.HouseItemsById[itemId]
	if type(item) == "table" and type(item.Setup) == "table" then
		return item.Setup
	end
	return nil
end

function LiveProps.Attach(model: Model, itemId: string?, context: { [string]: any }?): Handle?
	if typeof(model) ~= "Instance" or not model:IsA("Model") then
		return nil
	end
	if byModel[model] then
		return byModel[model]
	end
	local id = tostring(itemId or model:GetAttribute("ItemId") or "")
	local setup = setupOf(id)
	if not setup then
		return nil
	end
	local ctx = type(context) == "table" and context or {}
	local ref = model.PrimaryPart or model:FindFirstChild("Root")
	if not ref or not ref:IsA("BasePart") then
		ref = model:FindFirstChildWhichIsA("BasePart", true)
	end
	if not ref then
		return nil
	end
	local h: Handle = {
		Model = model,
		ItemId = id,
		Kind = tostring(setup.Kind or ""),
		Setup = setup,
		Interactive = ctx.Interactive == true,
		IsOwner = ctx.IsOwner == true,
		Alive = true,
		Ref = ref :: BasePart,
		Paused = false,
		Distance = 0,
		-- (aperçu 3D du panneau : caméra en orbite plus loin, jamais en pause)
		PauseDistance = tonumber(ctx.PauseDistance) or (ctx.Interactive == true and LiveProps.PAUSE_DISTANCE or 250),
		ScreenDistance = tonumber(ctx.ScreenDistance) or (ctx.Interactive == true and LiveProps.SCREEN_DISTANCE or 300),
		Clock = random:NextNumber(0, 10),
		Screens = {},
		Clickables = {},
		Roles = {},
		RGB = {},
		Movers = {},
		Presses = {},
		Spinners = {},
		State = {},
		Connections = {},
		Prompt = nil,
		Step = nil,
		Click = nil,
		Visual = nil,
	}
	-- écrans + bandes RGB (toutes familles)
	local wings: { [number]: { BasePart } } = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			if d.Name == "Screen" then
				local rec: ScreenRec = {
					Part = d,
					Kind = tostring(d:GetAttribute("ScreenKind") or "DVD"),
					Index = tonumber(d:GetAttribute("ScreenIndex")) or (#h.Screens + 1),
					Handle = h,
					Gui = nil,
					Screen = nil,
					Real = false,
					RealBroken = false,
					Override = nil,
					Wings = {},
					BaseColor = d.Color,
					BaseMaterial = d.Material,
				}
				table.insert(h.Screens, rec)
				table.insert(screens, rec)
				screenOff(rec)
			elseif d.Name == "ScreenWing" then
				local index = tonumber(d:GetAttribute("ScreenIndex")) or 0
				wings[index] = wings[index] or {}
				table.insert(wings[index], d)
			elseif d.Name == "RGB" then
				table.insert(h.RGB, d)
			end
		end
	end
	for _, rec in ipairs(h.Screens) do
		rec.Wings = wings[rec.Index] or {}
		local tint = LiveScreens.Tints[rec.Kind]
		for _, wing in ipairs(rec.Wings) do
			if tint then
				-- (v9.8 : bords de l'écran incurvé = verre sombre légèrement teinté)
				wing.Color = tint:Lerp(Color3.new(0, 0, 0), 0.8)
				wing.Material = Enum.Material.SmoothPlastic
			end
		end
	end
	local behaviour = BEHAVIOURS[h.Kind]
	if behaviour then
		local ok, err = pcall(behaviour, h)
		if not ok then
			warn("[LiveProps] " .. id .. " : " .. tostring(err))
		end
	end
	if not h.Interactive then
		table.clear(h.Clickables)
		h.Click = nil
	end
	-- nettoyage automatique si le modèle est détruit sans Detach
	table.insert(h.Connections, model.AncestryChanged:Connect(function(_, parent)
		if parent == nil and h.Alive then
			task.defer(function()
				if h.Alive and model.Parent == nil then
					LiveProps.Detach(h)
				end
			end)
		end
	end))
	table.insert(handles, h)
	byModel[model] = h
	ensureLoop()
	manageClock = MANAGE_STEP -- écrans attribués dès la prochaine image
	return h
end

function LiveProps.Detach(handle: Handle?)
	local h = handle
	if type(h) ~= "table" or not h.Alive then
		return
	end
	h.Alive = false
	for _, connection in ipairs(h.Connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	table.clear(h.Connections)
	if h.Prompt then
		h.Prompt:Destroy()
		h.Prompt = nil
	end
	for _, rec in ipairs(h.Screens) do
		releaseGui(rec)
		local index = table.find(screens, rec)
		if index then
			table.remove(screens, index)
		end
	end
	-- pièces remises au repos (le modèle peut rester dans le monde)
	if h.Model.Parent and h.Ref.Parent then
		local ref = refCF(h)
		for part, m in pairs(h.Movers) do
			if part.Parent then
				part.Size = m.Size
				part.CFrame = ref * m.Offset
			end
		end
		for _, p in ipairs(h.Presses) do
			if p.Part.Parent then
				p.Part.Color = p.Base
				p.Part.Material = p.Material
			end
		end
	end
	table.clear(h.Presses)
	pcall(dropLegends, h)
	for _, rec in ipairs(h.Screens) do
		rec.Override = nil
	end
	if deskFocus == h then
		deskFocus = nil
	end
	local index = table.find(handles, h)
	if index then
		table.remove(handles, index)
	end
	if byModel[h.Model] == h then
		byModel[h.Model] = nil
	end
	if #handles == 0 then
		stopLoop()
	end
end

function LiveProps.AttachAll(models: { Instance }, context: { [string]: any }?): { Handle }
	local list = {}
	if type(models) ~= "table" then
		return list
	end
	for _, model in ipairs(models) do
		if typeof(model) == "Instance" and model:IsA("Model") then
			local id = model:GetAttribute("ItemId")
			if type(id) == "string" and LiveProps.IsLive(id) then
				local ok, h = pcall(LiveProps.Attach, model, id, context)
				if ok and h then
					table.insert(list, h)
				elseif not ok then
					warn("[LiveProps] " .. tostring(id) .. " : " .. tostring(h))
				end
			end
		end
	end
	return list
end

function LiveProps.DetachAll(list: { Handle }?)
	if type(list) ~= "table" then
		return
	end
	for _, h in ipairs(list) do
		pcall(LiveProps.Detach, h)
	end
end

function LiveProps.SetFocus(position: Vector3?)
	if typeof(position) == "Vector3" then
		focusPoint = position
		focusAt = os.clock()
	else
		focusPoint = nil
	end
end

function LiveProps.SetDeskFocus(handle: Handle?)
	deskFocus = (type(handle) == "table" and handle.Alive) and handle or nil
	manageClock = MANAGE_STEP
end

function LiveProps.GetDeskFocus(): Handle?
	return deskFocus
end

function LiveProps.Count(): number
	return #handles
end

function LiveProps.Handles(): { Handle }
	return table.clone(handles)
end

-- Bureau le plus proche d'un point (siège, personnage)
function LiveProps.DeskNear(position: Vector3, radius: number?): Handle?
	local best, bestDistance = nil, radius or 4
	for _, h in ipairs(handles) do
		if h.Alive and h.Kind == "Desk" then
			local seat = h.Model:FindFirstChild("SeatPart")
			local at = (seat and seat:IsA("BasePart")) and seat.Position or h.Ref.Position
			local distance = (at - position).Magnitude
			if distance < bestDistance then
				best, bestDistance = h, distance
			end
		end
	end
	return best
end

-- Clavier / souris (et autres objets Setup) posés sur le dessus d'un bureau
function LiveProps.Peripherals(desk: Handle?): { Handle }
	local list = {}
	if type(desk) ~= "table" or not desk.Alive then
		return list
	end
	local footprint = desk.Model:GetAttribute("Footprint")
	local width = typeof(footprint) == "Vector3" and footprint.X or 6
	local center = desk.Ref.CFrame
	local topCenter = desk.Model:GetAttribute("TopCenter")
	if typeof(topCenter) == "Vector3" then
		center = center * CFrame.new(topCenter)
	end
	for _, h in ipairs(handles) do
		if h ~= desk and h.Alive and (h.Kind == "Keyboard" or h.Kind == "Mouse") then
			local rel = center:PointToObjectSpace(h.Ref.Position)
			if math.abs(rel.X) <= width / 2 + 0.5 and math.abs(rel.Z) <= 3 and math.abs(rel.Y) <= 1.5 then
				table.insert(list, h)
			end
		end
	end
	return list
end

-- Handle d'un modèle (nil si le modèle n'est pas vivant)
function LiveProps.HandleOf(model: Instance?): Handle?
	if typeof(model) ~= "Instance" or not model:IsA("Model") then
		return nil
	end
	return byModel[model]
end

-- Branche LiveProps sur les crochets de HouseBuilder (OnItemAttach /
-- OnItemDetach, v9.5) : chaque objet Setup construit dans une maison de la
-- ville devient vivant et cliquable ; retiré = détaché. Idempotent ; les
-- crochets déjà posés par quelqu'un d'autre sont appelés aussi.
local boundBuilders: { [any]: boolean } = setmetatable({}, { __mode = "k" }) :: any
function LiveProps.BindHouseBuilder(builder: any)
	if type(builder) ~= "table" or boundBuilders[builder] then
		return
	end
	boundBuilders[builder] = true
	local previousAttach = builder.OnItemAttach
	local previousDetach = builder.OnItemDetach
	builder.OnItemAttach = function(house: any, slot: number, model: Model, entry: any, itemId: string)
		if type(previousAttach) == "function" then
			pcall(previousAttach, house, slot, model, entry, itemId)
		end
		if LiveProps.IsLive(itemId) then
			local player = Players.LocalPlayer
			local owner = type(house) == "table" and tonumber(house.UserId) or 0
			LiveProps.Attach(model, itemId, { Interactive = true, IsOwner = player ~= nil and owner == player.UserId, OwnerId = owner })
		end
	end
	builder.OnItemDetach = function(house: any, slot: number, model: Model, entry: any, itemId: string)
		if type(previousDetach) == "function" then
			pcall(previousDetach, house, slot, model, entry, itemId)
		end
		local h = LiveProps.HandleOf(model)
		if h then
			LiveProps.Detach(h)
		end
	end
end

-- (v9.8) Le plus grand écran d'un bureau (celui du jeu)
function LiveProps.MainScreen(desk: Handle?): ScreenRec?
	if type(desk) ~= "table" or not desk.Alive then
		return nil
	end
	local best: ScreenRec? = nil
	local bestArea = -1
	for _, rec in ipairs(desk.Screens) do
		local area = rec.Part.Size.X * rec.Part.Size.Y
		if area > bestArea + 1e-4 then
			best, bestArea = rec, area
		end
	end
	return best
end

-- (v9.8) Un écran pris par un autre contenu (jeu du bureau) ; nil = rendu
function LiveProps.SetOverride(rec: ScreenRec?, override: Override?)
	if type(rec) ~= "table" then
		return
	end
	if rec.Override == override then
		return
	end
	rec.Override = override
	releaseGui(rec)
	manageClock = MANAGE_STEP -- (redessiné à la prochaine image)
end

-- (v9.8) Chaîne d'un écran (télé) : redessiné tout de suite
function LiveProps.SetChannel(rec: ScreenRec?, kind: string)
	if type(rec) ~= "table" or type(kind) ~= "string" or rec.Kind == kind then
		return
	end
	rec.Kind = kind
	rec.RealBroken = false
	releaseGui(rec)
	manageClock = MANAGE_STEP
end

-- (v9.8) Appui visuel (jeu du bureau) : la touche / le bouton s'enfonce, sans
-- clic ni son
function LiveProps.PressVisual(handle: Handle?, partName: string): boolean
	local h = handle
	if type(h) ~= "table" or not h.Alive or not h.Visual then
		return false
	end
	local byName = h.State.KeysByName
	local part = (byName and byName[partName]) or findPart(h.Model, partName)
	if not part then
		return false
	end
	local ok = pcall(h.Visual :: any, h, part)
	return ok
end

-- Appui programmé (DeskMode : vraies touches du clavier du joueur)
function LiveProps.Press(handle: Handle?, partName: string): boolean
	local h = handle
	if type(h) ~= "table" or not h.Alive or not h.Click then
		return false
	end
	local part = findPart(h.Model, partName)
	if not part then
		return false
	end
	local ok = pcall(h.Click :: any, h, part, h.Roles[part] or "Any", part.Position)
	return ok
end

return LiveProps
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="209">
          <Properties>
            <string name="Name">LiveScreens</string>
            <string name="Source"><![CDATA[--[[
	LiveScreens (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > LiveScreens

	v9.5 🖥️ Ce qui passe sur les écrans 3D des objets "Dopamine Setup"
	(LiveProps crée la SurfaceGui, ce module la remplit et l'anime) :
	  - "Runner" : mini jeu de course façon Subway (voie en perspective,
	    traverses qui défilent, rails, pièces, trains qu'on évite, saut,
	    compteur de pièces et de distance) ;
	  - "Live"   : mini live stream (streameur qui parle et cligne des yeux,
	    badge 🔴 LIVE, spectateurs, chat qui défile, cœurs, objectif) ;
	  - "DVD"    : le logo DVD qui rebondit, change de couleur, fête les coins ;
	  - "News"   : flash info (logo, présentateur, bandeau "Breaking news",
	    titres absurdes, bandeau défilant) ;
	  - "Music"  : petit écran LCD de la chaîne hi-fi (morceau en cours,
	    égaliseur).
	Tout est dessiné UNE fois en Frames / TextLabels (≈ 30 à 60 instances par
	écran), puis seulement déplacé / recoloré : aucune création par image.
	Step(dt) est appelé par LiveProps (≤ 30 fois / s, seulement si l'écran est
	proche et visible).

	API :
	  LiveScreens.New(kind, gui: SurfaceGui, canvas: Vector2) -> Screen
	  screen:Step(dt)   screen:Destroy()
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Locale = require(ReplicatedStorage.Shared.Locale)

local LiveScreens = {}

local rgb = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local FONT_BLACK = Enum.Font.GothamBlack
local FONT_BOLD = Enum.Font.GothamBold
local FONT = Enum.Font.Gotham

export type Screen = {
	Kind: string,
	Root: Frame,
	Step: (self: Screen, dt: number) -> (),
	Destroy: (self: Screen) -> (),
}

local random = Random.new()

----------------------------------------------------------------------
-- Aides de dessin
----------------------------------------------------------------------

local function box(parent: Instance, name: string, x: number, y: number, w: number, h: number, color: Color3, z: number?, transparency: number?): Frame
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.BorderSizePixel = 0
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = transparency or 0
	frame.Position = UDim2.fromOffset(x, y)
	frame.Size = UDim2.fromOffset(w, h)
	frame.ZIndex = z or 1
	frame.Parent = parent
	return frame
end

local function round(frame: GuiObject, radius: number?)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = radius and UDim.new(0, radius) or UDim.new(1, 0)
	corner.Parent = frame
end

local function gradient(frame: GuiObject, a: Color3, b: Color3, rotation: number)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(a, b)
	g.Rotation = rotation
	g.Parent = frame
	return g
end

local function label(parent: Instance, name: string, text: string, x: number, y: number, w: number, h: number, size: number, color: Color3, font: Enum.Font?, z: number?): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundTransparency = 1
	l.BorderSizePixel = 0
	l.Position = UDim2.fromOffset(x, y)
	l.Size = UDim2.fromOffset(w, h)
	l.Font = font or FONT_BOLD
	l.Text = text
	l.TextSize = size
	l.TextColor3 = color
	l.TextStrokeTransparency = 1
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextYAlignment = Enum.TextYAlignment.Center
	l.ZIndex = z or 5
	l.Parent = parent
	return l
end

local function stroke(textLabel: TextLabel, color: Color3, transparency: number)
	textLabel.TextStrokeColor3 = color
	textLabel.TextStrokeTransparency = transparency
end

-- Trait (Frame tourné) d'un point à un autre
local function line(parent: Instance, name: string, x0: number, y0: number, x1: number, y1: number, thickness: number, color: Color3, z: number?): Frame
	local dx, dy = x1 - x0, y1 - y0
	local length = math.sqrt(dx * dx + dy * dy)
	local frame = box(parent, name, (x0 + x1) / 2, (y0 + y1) / 2, thickness, length, color, z)
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Rotation = math.deg(math.atan2(dx, -dy))
	return frame
end

local function newRoot(gui: SurfaceGui, canvas: Vector2, color: Color3): Frame
	local root = box(gui, "Live", 0, 0, canvas.X, canvas.Y, color)
	root.ClipsDescendants = true
	return root
end

local function formatInt(value: number): string
	local text = tostring(math.floor(value))
	local out = text:reverse():gsub("(%d%d%d)", "%1 "):reverse()
	return (out:gsub("^%s+", ""))
end

----------------------------------------------------------------------
-- 🏃 RUNNER : course façon Subway
----------------------------------------------------------------------

local LANES = { -1, 0, 1 }

local function newRunner(gui: SurfaceGui, canvas: Vector2): Screen
	local W, H = canvas.X, canvas.Y
	local root = newRoot(gui, canvas, rgb(120, 170, 255))
	gradient(root, rgb(96, 150, 255), rgb(255, 196, 214), 90)
	local horizon = math.floor(H * 0.4)
	local bottom = H
	local cx = W / 2
	local half = W * 0.46 -- demi-largeur de la voie en bas
	-- soleil, nuages, ville au loin
	local sun = box(root, "Sun", W * 0.78, H * 0.08, 26, 26, rgb(255, 236, 140), 2)
	round(sun)
	for index = 1, 2 do
		local cloud = box(root, "Cloud", W * (0.12 + index * 0.3), H * (0.06 + index * 0.05), 40, 10, WHITE, 2, 0.15)
		round(cloud)
	end
	local skyline = { 0.05, 0.12, 0.2, 0.3, 0.62, 0.7, 0.8, 0.9 }
	for index, x in ipairs(skyline) do
		local h = 14 + (index * 37 % 5) * 7
		local building = box(root, "Building", W * x, horizon - h, W * 0.085, h, rgb(120 + index * 6, 110, 170), 2)
		for row = 0, math.floor(h / 8) - 1 do
			box(building, "Window", 3, 3 + row * 8, W * 0.085 - 6, 3, rgb(255, 230, 150), 3, 0.35)
		end
	end
	-- sol (murs de soutènement / ballast)
	local ground = box(root, "Ground", 0, horizon, W, H - horizon, rgb(150, 130, 160), 3)
	gradient(ground, rgb(170, 150, 185), rgb(96, 86, 110), 90)
	-- bandes de la voie (traverses qui défilent)
	local BANDS = 14
	local bands: { Frame } = {}
	local bandT: { number } = {}
	for index = 1, BANDS do
		local t0 = (index - 1) / BANDS
		local t1 = index / BANDS
		local y0 = horizon + (bottom - horizon) * t0
		local y1 = horizon + (bottom - horizon) * t1
		local mid = (t0 + t1) / 2
		local w = half * 2 * (0.12 + 0.88 * mid)
		local band = box(root, "Band", cx - w / 2, y0, w, y1 - y0 + 1, rgb(110, 96, 90), 4)
		table.insert(bands, band)
		table.insert(bandT, mid)
	end
	-- rails (du point de fuite vers le bas)
	for _, k in ipairs({ -1, -0.36, 0.36, 1 }) do
		line(root, "Rail", cx + k * half * 0.12, horizon, cx + k * half * 0.96, bottom, 2, rgb(230, 226, 240), 5)
	end
	for _, k in ipairs({ -1.12, 1.12 }) do
		line(root, "Wall", cx + k * half * 0.12, horizon, cx + k * half * 1.02, bottom, 4, rgb(255, 150, 200), 5)
	end
	-- position à l'écran d'une profondeur z (0 = près, 1 = horizon)
	local function project(z: number): (number, number)
		local s = 1 / (1 + z * 6)
		local t = (s - 1 / 7) / (1 - 1 / 7)
		return horizon + (bottom - horizon) * t, 0.12 + 0.88 * t
	end
	-- pièces
	type Coin = { Frame: Frame, Lane: number, Z: number }
	local coins: { Coin } = {}
	for index = 1, 5 do
		local frame = box(root, "Coin", 0, 0, 10, 10, rgb(255, 214, 60), 8)
		frame.AnchorPoint = Vector2.new(0.5, 1)
		round(frame)
		local ring = Instance.new("UIStroke")
		ring.Color = rgb(220, 150, 20)
		ring.Thickness = 1.5
		ring.Parent = frame
		table.insert(coins, { Frame = frame, Lane = LANES[index % 3 + 1], Z = index / 5 })
	end
	-- train (face avant)
	local train = box(root, "Train", 0, 0, 40, 50, rgb(236, 70, 90), 7)
	train.AnchorPoint = Vector2.new(0.5, 1)
	round(train, 4)
	local windshield = box(train, "Windshield", 0, 0, 10, 10, rgb(170, 220, 255), 8)
	windshield.Position = UDim2.fromScale(0.12, 0.1)
	windshield.Size = UDim2.fromScale(0.76, 0.34)
	round(windshield, 3)
	local stripe = box(train, "Stripe", 0, 0, 10, 10, rgb(255, 230, 120), 8)
	stripe.Position = UDim2.fromScale(0, 0.56)
	stripe.Size = UDim2.fromScale(1, 0.08)
	for _, hx in ipairs({ 0.18, 0.7 }) do
		local lamp = box(train, "Lamp", 0, 0, 10, 10, rgb(255, 250, 200), 9)
		lamp.Position = UDim2.fromScale(hx, 0.72)
		lamp.Size = UDim2.fromScale(0.12, 0.1)
		round(lamp)
	end
	local trainLane, trainZ = 1, 1
	-- coureur
	local runner = Instance.new("Frame")
	runner.Name = "Runner"
	runner.BackgroundTransparency = 1
	runner.Size = UDim2.fromOffset(24, 34)
	runner.AnchorPoint = Vector2.new(0.5, 1)
	runner.ZIndex = 20
	runner.Parent = root
	local shadow = box(root, "Shadow", 0, 0, 22, 6, BLACK, 19, 0.6)
	shadow.AnchorPoint = Vector2.new(0.5, 0.5)
	round(shadow)
	local legs = {}
	for index, x in ipairs({ 7, 13 }) do
		local leg = box(runner, "Leg", x, 20, 5, 13, rgb(60, 70, 140), 21)
		leg.AnchorPoint = Vector2.new(0.5, 0)
		legs[index] = leg
		box(leg, "Shoe", -1, 10, 7, 4, rgb(255, 90, 140), 22)
	end
	local body = box(runner, "Body", 3, 8, 18, 15, rgb(255, 140, 60), 22)
	round(body, 4)
	box(runner, "Pack", 5, 10, 14, 10, rgb(90, 200, 160), 21)
	local head = box(runner, "Head", 6, -1, 12, 12, rgb(255, 214, 180), 23)
	round(head)
	local cap = box(runner, "Cap", 5, -2, 14, 5, rgb(60, 140, 255), 24)
	round(cap, 2)
	-- interface (pièces, distance)
	local coinsLabel = label(root, "Coins", "🪙 0", 6, 4, 100, 16, 13, WHITE, FONT_BLACK, 30)
	stroke(coinsLabel, rgb(120, 60, 20), 0.2)
	local distLabel = label(root, "Distance", "0 m", W - 106, 4, 100, 16, 13, WHITE, FONT_BLACK, 30)
	distLabel.TextXAlignment = Enum.TextXAlignment.Right
	stroke(distLabel, rgb(40, 40, 90), 0.2)
	local combo = label(root, "Combo", "+1 🪙", 0, H * 0.46, W, 18, 14, rgb(255, 240, 120), FONT_BLACK, 30)
	combo.Visible = false
	combo.TextXAlignment = Enum.TextXAlignment.Center
	stroke(combo, rgb(200, 60, 120), 0.1)

	local phase = 0
	local distance = random:NextInteger(100, 900)
	local collected = random:NextInteger(0, 40)
	local lane, laneX = 0, 0
	local textClock = 1
	local jump = 0
	local run = 0
	local comboTime = 0
	local speed = 0.55
	local screen = {} :: Screen
	screen.Kind = "Runner"
	screen.Root = root
	local laneStep = half * 0.62
	function screen.Step(_self: Screen, dt: number)
		phase = (phase + dt * speed * 7) % 2
		run += dt * 14
		distance += dt * 38
		-- traverses
		for index, band in ipairs(bands) do
			local t = bandT[index]
			local depth = 1 / (0.12 + t) + phase
			local dark = math.floor(depth * 1.3) % 2 == 0
			band.BackgroundColor3 = dark and rgb(96, 80, 76) or rgb(150, 126, 112)
		end
		-- train
		trainZ -= dt * speed * 0.8
		if trainZ < -0.08 then
			trainZ = 1
			trainLane = LANES[random:NextInteger(1, 3)]
		end
		if trainLane == lane and trainZ < 0.45 and trainZ > 0 then
			-- esquive : voie voisine libre
			lane = lane == 0 and (random:NextNumber() < 0.5 and -1 or 1) or 0
		end
		local ty, ts = project(math.max(0, trainZ))
		train.Visible = trainZ > -0.05
		train.Position = UDim2.fromOffset(cx + trainLane * laneStep * ts, ty)
		train.Size = UDim2.fromOffset(laneStep * 0.9 * ts, laneStep * 1.1 * ts)
		train.ZIndex = 7
		-- pièces
		for _, coin in ipairs(coins) do
			coin.Z -= dt * speed
			if coin.Z < 0.02 then
				if coin.Lane == lane and jump <= 0 then
					collected += 1
					comboTime = 0.6
				end
				coin.Z = 1
				coin.Lane = LANES[random:NextInteger(1, 3)]
			end
			local y, s = project(coin.Z)
			local size = 3 + 10 * s
			coin.Frame.Position = UDim2.fromOffset(cx + coin.Lane * laneStep * s, y - 2 * s)
			coin.Frame.Size = UDim2.fromOffset(size * (0.55 + 0.45 * math.abs(math.cos(run * 0.3 + coin.Z * 9))), size)
			coin.Frame.ZIndex = coin.Z < trainZ and 10 or 6
		end
		-- saut de temps en temps
		if jump <= 0 and random:NextNumber() < dt * 0.25 then
			jump = 0.7
		end
		local lift = 0
		if jump > 0 then
			jump -= dt
			local t = 1 - math.max(0, jump) / 0.7
			lift = math.sin(t * math.pi) * H * 0.18
		end
		laneX += (lane * laneStep - laneX) * math.min(1, dt * 10)
		local groundY = H - 8
		runner.Position = UDim2.fromOffset(cx + laneX, groundY - lift - math.abs(math.sin(run)) * 2)
		shadow.Position = UDim2.fromOffset(cx + laneX, groundY)
		shadow.Size = UDim2.fromOffset(22 - lift * 0.2, 6)
		legs[1].Rotation = math.sin(run) * 35
		legs[2].Rotation = -math.sin(run) * 35
		textClock += dt
		if textClock >= 0.25 then
			textClock = 0
			coinsLabel.Text = "🪙 " .. formatInt(collected)
			distLabel.Text = formatInt(distance) .. " m"
		end
		if comboTime > 0 then
			comboTime -= dt
			combo.Visible = true
			combo.TextTransparency = 1 - math.clamp(comboTime / 0.6, 0, 1)
		elseif combo.Visible then
			combo.Visible = false
		end
	end
	function screen.Destroy(_self: Screen)
		root:Destroy()
	end
	return screen
end

----------------------------------------------------------------------
-- 🔴 LIVE : mini live stream
----------------------------------------------------------------------

local CHAT_LINES = {
	"W stream 🔥", "gg!!", "lol 😂", "first!", "💖💖💖", "that setup tho 😳", "POG", "+1 🧠", "can I be a mod?", "hi from France 🇫🇷",
	"go go go", "10/10 🎉", "clicking with you 👆", "insane 🤯", "no way", "the DVD logo!!", "chat is this real", "🍿🍿",
}
local CHAT_NAMES = { "Ana", "BobbyX", "Chloé", "D_Wave", "Emma", "Farid", "Gaby99", "HugoGG", "Inès", "Jules", "KiraCat", "Léo" }
local NAME_COLORS = { rgb(255, 120, 170), rgb(120, 220, 255), rgb(255, 214, 90), rgb(140, 240, 150), rgb(200, 150, 255), rgb(255, 160, 90) }

local function newLive(gui: SurfaceGui, canvas: Vector2): Screen
	local W, H = canvas.X, canvas.Y
	local root = newRoot(gui, canvas, rgb(60, 40, 90))
	local videoW = math.floor(W * 0.66)
	local video = box(root, "Video", 0, 0, videoW, H, rgb(70, 46, 110), 2)
	gradient(video, rgb(92, 60, 150), rgb(255, 120, 190), 60)
	-- chambre du streameur : bande LED, posters, étagère
	local led = box(video, "Led", 0, math.floor(H * 0.1), videoW, 3, rgb(255, 90, 200), 3)
	box(video, "Poster", videoW * 0.08, H * 0.2, videoW * 0.16, H * 0.26, rgb(120, 220, 255), 3)
	box(video, "Poster2", videoW * 0.76, H * 0.18, videoW * 0.14, H * 0.2, rgb(255, 214, 90), 3)
	box(video, "Shelf", videoW * 0.7, H * 0.44, videoW * 0.26, 3, rgb(60, 40, 70), 3)
	local plush = box(video, "Plush", videoW * 0.76, H * 0.44 - 12, 12, 12, rgb(255, 170, 200), 3)
	round(plush)
	-- streameur (corps, tête, cheveux, yeux, bouche, casque, micro)
	local sx = videoW * 0.46
	local hoodie = box(video, "Hoodie", sx - 34, H * 0.62, 68, H * 0.5, rgb(255, 120, 170), 5)
	round(hoodie, 16)
	local head = box(video, "Head", sx - 20, H * 0.3, 40, 42, rgb(255, 214, 186), 6)
	round(head, 18)
	local hair = box(head, "Hair", -2, -4, 44, 16, rgb(90, 60, 150), 7)
	round(hair, 8)
	local eyes = {}
	for index, ex in ipairs({ 11, 25 }) do
		local eye = box(head, "Eye", ex, 18, 5, 6, rgb(40, 30, 50), 8)
		round(eye)
		eyes[index] = eye
	end
	local mouth = box(head, "Mouth", 16, 30, 9, 3, rgb(180, 60, 80), 8)
	round(mouth, 2)
	local band = box(video, "Headset", sx - 23, H * 0.26, 46, 5, rgb(40, 40, 52), 8)
	round(band, 3)
	for _, ex in ipairs({ -26, 18 }) do
		local cup = box(video, "Cup", sx + ex, H * 0.38, 9, 16, rgb(40, 40, 52), 8)
		round(cup, 4)
	end
	local mic = box(video, "Mic", sx + 22, H * 0.56, 7, 18, rgb(60, 60, 70), 8)
	round(mic, 3)
	-- badge LIVE + spectateurs
	local badge = box(video, "LiveBadge", 6, 6, 42, 16, rgb(236, 40, 60), 10)
	round(badge, 4)
	local liveText = label(badge, "Text", Locale.T("🔴 LIVE"), 0, 0, 42, 16, 10, WHITE, FONT_BLACK, 11)
	liveText.TextXAlignment = Enum.TextXAlignment.Center
	local viewersBox = box(video, "Viewers", 52, 6, 62, 16, BLACK, 10, 0.45)
	round(viewersBox, 4)
	local viewers = label(viewersBox, "Text", "👁 1 234", 0, 0, 62, 16, 10, WHITE, FONT_BOLD, 11)
	viewers.TextXAlignment = Enum.TextXAlignment.Center
	-- objectif d'abonnés
	local goal = box(video, "Goal", 6, H - 16, videoW - 12, 10, BLACK, 10, 0.5)
	round(goal, 5)
	local goalFill = box(goal, "Fill", 0, 0, 10, 10, rgb(120, 240, 170), 11)
	round(goalFill, 5)
	local goalText = label(goal, "Text", "", 0, 0, videoW - 12, 10, 8, WHITE, FONT_BOLD, 12)
	goalText.TextXAlignment = Enum.TextXAlignment.Center
	-- cœurs qui montent
	local hearts = {}
	for index = 1, 3 do
		local heart = label(video, "Heart", "💖", videoW - 26, H, 18, 18, 14, WHITE, FONT, 12)
		hearts[index] = { Label = heart, T = index * 0.7 }
	end
	-- chat (à droite)
	local chatW = W - videoW
	local chat = box(root, "Chat", videoW, 0, chatW, H, rgb(24, 20, 36), 3)
	label(chat, "Title", Locale.T("💬 Live chat"), 6, 2, chatW - 8, 16, 10, rgb(200, 190, 230), FONT_BLACK, 5)
	local LINES = 6
	local lineH = math.floor((H - 22) / LINES)
	local rows = {}
	for index = 1, LINES do
		local row = label(chat, "Line", "", 6, 20 + (index - 1) * lineH, chatW - 10, lineH, 9, WHITE, FONT, 5)
		row.RichText = true
		row.TextWrapped = true
		row.TextYAlignment = Enum.TextYAlignment.Top
		rows[index] = row
	end
	local messages: { string } = {}
	local function pushMessage()
		local name = CHAT_NAMES[random:NextInteger(1, #CHAT_NAMES)]
		local color = NAME_COLORS[random:NextInteger(1, #NAME_COLORS)]
		local text = Locale.T(CHAT_LINES[random:NextInteger(1, #CHAT_LINES)])
		local hex = string.format("#%02X%02X%02X", math.floor(color.R * 255), math.floor(color.G * 255), math.floor(color.B * 255))
		table.insert(messages, '<font color="' .. hex .. '"><b>' .. name .. "</b></font> " .. text)
		while #messages > LINES do
			table.remove(messages, 1)
		end
		for index, row in ipairs(rows) do
			row.Text = messages[index] or ""
		end
	end
	for _ = 1, LINES do
		pushMessage()
	end

	local clock = 0
	local chatTimer = 0
	local talk = 0
	local blink = 2
	local viewerCount = random:NextInteger(800, 4000)
	local follows = random:NextInteger(200, 900)
	local shownFollows = -1
	local screen = {} :: Screen
	screen.Kind = "Live"
	screen.Root = root
	function screen.Step(_self: Screen, dt: number)
		clock += dt
		chatTimer += dt
		if chatTimer > 1.1 then
			chatTimer = 0
			pushMessage()
			viewerCount = math.max(100, viewerCount + random:NextInteger(-12, 20))
			viewers.Text = "👁 " .. formatInt(viewerCount)
			if random:NextNumber() < 0.3 then
				follows += 1
			end
		end
		-- bouche qui parle, clignement, tête qui bouge
		talk += dt
		if talk > 0.12 then
			talk = 0
			mouth.Size = UDim2.fromOffset(9, random:NextInteger(2, 7))
		end
		blink -= dt
		local closed = blink < 0.12
		if blink < 0 then
			blink = random:NextNumber(2, 4)
		end
		for _, eye in ipairs(eyes) do
			eye.Size = UDim2.fromOffset(5, closed and 1 or 6)
		end
		head.Position = UDim2.fromOffset(sx - 20 + math.sin(clock * 1.7) * 2, H * 0.3 + math.sin(clock * 2.3) * 1.5)
		led.BackgroundColor3 = Color3.fromHSV((clock * 0.1) % 1, 0.7, 1)
		-- cœurs
		for _, heart in ipairs(hearts) do
			heart.T += dt
			local t = heart.T % 2.1 / 2.1
			heart.Label.Position = UDim2.fromOffset(videoW - 26 + math.sin(heart.T * 3) * 5, H * (1 - t) - 10)
			heart.Label.TextTransparency = t
		end
		-- objectif
		if follows ~= shownFollows then
			shownFollows = follows
			local goalMax = (math.floor(follows / 1000) + 1) * 1000
			local ratio = follows / goalMax
			goalFill.Size = UDim2.fromOffset(math.max(10, (videoW - 12) * ratio), 10)
			goalText.Text = Locale.T("Follower goal %s/%s", formatInt(follows), formatInt(goalMax))
		end
	end
	function screen.Destroy(_self: Screen)
		root:Destroy()
	end
	return screen
end

----------------------------------------------------------------------
-- 📀 DVD : le logo qui rebondit
----------------------------------------------------------------------

local DVD_COLORS = { rgb(255, 46, 136), rgb(0, 200, 255), rgb(157, 78, 221), rgb(40, 200, 40), rgb(255, 190, 0), rgb(255, 110, 20) }

local function newDVD(gui: SurfaceGui, canvas: Vector2): Screen
	local W, H = canvas.X, canvas.Y
	local root = newRoot(gui, canvas, rgb(10, 10, 22))
	gradient(root, rgb(16, 14, 34), rgb(6, 6, 14), 90)
	local LW, LH = math.floor(W * 0.24), math.floor(W * 0.14)
	local logo = Instance.new("Frame")
	logo.Name = "Logo"
	logo.BackgroundTransparency = 1
	logo.Size = UDim2.fromOffset(LW, LH)
	logo.ZIndex = 3
	logo.Parent = root
	local word = label(logo, "Word", "DVD", 0, 0, LW, LH * 0.6, math.floor(LH * 0.56), DVD_COLORS[1], FONT_BLACK, 4)
	word.TextXAlignment = Enum.TextXAlignment.Center
	local disc = box(logo, "Disc", LW * 0.08, LH * 0.62, LW * 0.84, LH * 0.34, DVD_COLORS[1], 4)
	round(disc)
	local video = label(disc, "Video", "VIDEO", 0, 0, LW * 0.84, LH * 0.34, math.floor(LH * 0.2), rgb(6, 6, 12), FONT_BLACK, 5)
	video.TextXAlignment = Enum.TextXAlignment.Center
	local glow = box(root, "Glow", 0, 0, LW + 16, LH + 16, DVD_COLORS[1], 2, 0.85)
	round(glow, 12)
	-- affichage "lecteur" + fête des coins
	local osd = label(root, "OSD", "▶ PLAY", 8, H - 18, 120, 14, 10, rgb(120, 255, 140), FONT_BOLD, 6)
	osd.TextTransparency = 0.3
	local corner = label(root, "Corner", Locale.T("CORNER!!! 🎉"), 0, H * 0.38, W, H * 0.24, math.floor(H * 0.16), rgb(255, 230, 90), FONT_BLACK, 8)
	corner.TextXAlignment = Enum.TextXAlignment.Center
	stroke(corner, rgb(200, 40, 120), 0)
	corner.Visible = false
	local x, y = random:NextNumber(0, W - LW), random:NextNumber(0, H - LH)
	local vx, vy = W * 0.2 * (random:NextNumber() < 0.5 and -1 or 1), H * 0.24 * (random:NextNumber() < 0.5 and -1 or 1)
	local colorIndex = 1
	local flash = 0
	local party = 0
	local played = random:NextInteger(0, 3000)
	local screen = {} :: Screen
	screen.Kind = "DVD"
	screen.Root = root
	local function setColor(index: number)
		local color = DVD_COLORS[index]
		word.TextColor3 = color
		disc.BackgroundColor3 = color
		glow.BackgroundColor3 = color
	end
	function screen.Step(_self: Screen, dt: number)
		x += vx * dt
		y += vy * dt
		local hitX, hitY = false, false
		if x <= 0 then
			x, vx, hitX = 0, math.abs(vx), true
		elseif x >= W - LW then
			x, vx, hitX = W - LW, -math.abs(vx), true
		end
		if y <= 0 then
			y, vy, hitY = 0, math.abs(vy), true
		elseif y >= H - LH then
			y, vy, hitY = H - LH, -math.abs(vy), true
		end
		if hitX or hitY then
			colorIndex = colorIndex % #DVD_COLORS + 1
			setColor(colorIndex)
			flash = 0.3
			-- presque dans le coin : on fête quand même (c'est le moment attendu)
			local nearX = x < LW * 0.12 or x > W - LW * 1.12
			local nearY = y < LH * 0.12 or y > H - LH * 1.12
			if (hitX and hitY) or (hitX and nearY) or (hitY and nearX) then
				party = 1.8
			end
		end
		logo.Position = UDim2.fromOffset(x, y)
		glow.Position = UDim2.fromOffset(x - 8, y - 8)
		if flash > 0 then
			flash -= dt
		end
		glow.BackgroundTransparency = 0.85 - math.max(0, flash) * 1.5
		if party > 0 then
			party -= dt
			corner.Visible = true
			corner.TextColor3 = Color3.fromHSV((party * 1.5) % 1, 0.6, 1)
			corner.Rotation = math.sin(party * 12) * 4
		else
			corner.Visible = false
		end
		local second = math.floor(played + dt)
		if second ~= math.floor(played) then
			osd.Text = string.format("▶ PLAY  %02d:%02d", math.floor(second / 60) % 60, second % 60)
		end
		played += dt
	end
	function screen.Destroy(_self: Screen)
		root:Destroy()
	end
	setColor(colorIndex)
	return screen
end

----------------------------------------------------------------------
-- 📰 NEWS : flash info
----------------------------------------------------------------------

local HEADLINES = {
	"LOCAL PLAYER CLICKS 10,000 TIMES, FEELS GREAT",
	"DVD LOGO FINALLY HITS THE CORNER, CROWD GOES WILD",
	"SCIENTISTS CONFIRM: BUBBLE WRAP IS STILL SATISFYING",
	"PIGEON ELECTED MAYOR, PROMISES MORE CRUMBS",
	"HYDRAULIC PRESS CRUSHES RUBBER DUCK, DUCK IS FINE",
	"WINDMILL SPINS FASTER THAN EVER, EXPERTS SAY 'WOW'",
	"DOPAMINE LEVELS AT AN ALL-TIME HIGH IN DOPAMINE TOWN",
}

local function newNews(gui: SurfaceGui, canvas: Vector2): Screen
	local W, H = canvas.X, canvas.Y
	local root = newRoot(gui, canvas, rgb(20, 40, 90))
	gradient(root, rgb(30, 70, 160), rgb(10, 20, 60), 90)
	-- décor du plateau : écrans, présentateur
	for index = 0, 3 do
		box(root, "Wall", W * (0.05 + index * 0.24), H * 0.12, W * 0.2, H * 0.3, rgb(60, 110, 200), 2, 0.4)
	end
	local anchorX = W * 0.66
	local suit = box(root, "Suit", anchorX, H * 0.44, W * 0.24, H * 0.4, rgb(40, 44, 70), 3)
	round(suit, 14)
	box(suit, "Tie", W * 0.11, 4, W * 0.02, H * 0.2, rgb(230, 50, 70), 4)
	local head = box(root, "Head", anchorX + W * 0.07, H * 0.2, W * 0.1, W * 0.1, rgb(250, 210, 180), 4)
	round(head)
	local hair = box(head, "Hair", -1, -2, W * 0.1 + 2, W * 0.035, rgb(80, 60, 50), 5)
	round(hair, 6)
	local desk = box(root, "Desk", W * 0.52, H * 0.66, W * 0.46, H * 0.1, rgb(220, 226, 240), 5)
	round(desk, 4)
	-- logo de la chaîne + direct
	local logoBox = box(root, "Logo", 8, 8, W * 0.34, H * 0.13, WHITE, 6)
	round(logoBox, 4)
	label(logoBox, "Text", "🧠 DOPA NEWS", 6, 0, W * 0.34 - 8, H * 0.13, math.floor(H * 0.075), rgb(200, 30, 60), FONT_BLACK, 7)
	local live = box(root, "Live", W - 52, 8, 44, 16, rgb(220, 30, 50), 6)
	round(live, 4)
	local liveText = label(live, "Text", Locale.T("LIVE"), 0, 0, 44, 16, 10, WHITE, FONT_BLACK, 7)
	liveText.TextXAlignment = Enum.TextXAlignment.Center
	-- bandeau "Breaking news" + titre
	local bandY = H * 0.62
	local breaking = box(root, "Breaking", 0, bandY, W * 0.4, H * 0.1, rgb(220, 30, 50), 8)
	label(breaking, "Text", Locale.T("BREAKING NEWS"), 6, 0, W * 0.4 - 8, H * 0.1, math.floor(H * 0.06), WHITE, FONT_BLACK, 9)
	local headlineBox = box(root, "Headline", 0, bandY + H * 0.1, W, H * 0.16, WHITE, 8)
	local headline = label(headlineBox, "Text", "", 8, 0, W - 16, H * 0.16, math.floor(H * 0.058), rgb(20, 24, 50), FONT_BLACK, 9)
	headline.TextWrapped = true
	-- bandeau défilant
	local ticker = box(root, "Ticker", 0, H - H * 0.12, W, H * 0.12, rgb(250, 200, 40), 8)
	local tickerText = label(ticker, "Text", "", 0, 0, W * 4, H * 0.12, math.floor(H * 0.06), rgb(30, 20, 20), FONT_BOLD, 9)
	local parts = {}
	for _, text in ipairs(HEADLINES) do
		table.insert(parts, Locale.T(text))
	end
	tickerText.Text = table.concat(parts, "   •   ")
	local tickerW = W * 4
	tickerText.Size = UDim2.fromOffset(tickerW, H * 0.12)
	local scroll = 0
	local index = random:NextInteger(1, #HEADLINES)
	local timer = 0
	local clock = 0
	headline.Text = Locale.T(HEADLINES[index])
	local screen = {} :: Screen
	screen.Kind = "News"
	screen.Root = root
	function screen.Step(_self: Screen, dt: number)
		clock += dt
		timer += dt
		if timer > 6 then
			timer = 0
			index = index % #HEADLINES + 1
			headline.Text = Locale.T(HEADLINES[index])
		end
		scroll = (scroll + dt * W * 0.18) % (tickerW * 0.8)
		tickerText.Position = UDim2.fromOffset(W - scroll, 0)
		live.BackgroundTransparency = (math.floor(clock * 2) % 2 == 0) and 0 or 0.35
		head.Position = UDim2.fromOffset(anchorX + W * 0.07 + math.sin(clock * 1.3) * 1.5, H * 0.2 + math.sin(clock * 3.1) * 0.8)
		breaking.BackgroundColor3 = rgb(220, 30, 50):Lerp(rgb(255, 80, 90), (math.sin(clock * 4) + 1) / 2)
	end
	function screen.Destroy(_self: Screen)
		root:Destroy()
	end
	return screen
end

----------------------------------------------------------------------
-- 🎵 MUSIC : écran LCD de la chaîne hi-fi
----------------------------------------------------------------------

local soundModule: any = nil
local function sound(): any
	if soundModule == nil then
		local ok, result = pcall(function()
			return require(ReplicatedStorage:WaitForChild("Client"):WaitForChild("SoundManager") :: ModuleScript) :: any
		end)
		soundModule = ok and result or false
	end
	return soundModule or nil
end

local function newMusic(gui: SurfaceGui, canvas: Vector2): Screen
	local W, H = canvas.X, canvas.Y
	local root = newRoot(gui, canvas, rgb(10, 30, 40))
	gradient(root, rgb(20, 60, 70), rgb(8, 20, 30), 90)
	local title = label(root, "Track", "", 6, 2, W * 3, H * 0.5, math.floor(H * 0.34), rgb(140, 255, 220), FONT_BOLD, 3)
	local state = label(root, "State", "▶", W - 26, 2, 22, H * 0.5, math.floor(H * 0.34), rgb(140, 255, 220), FONT_BLACK, 4)
	state.TextXAlignment = Enum.TextXAlignment.Right
	local BARS = 12
	local bars = {}
	local barW = (W - 12) / BARS
	for index = 1, BARS do
		local bar = box(root, "Eq", 6 + (index - 1) * barW, H - 4, barW - 2, 4, Color3.fromHSV(0.45 - index * 0.025, 0.7, 1), 3)
		bar.AnchorPoint = Vector2.new(0, 1)
		bars[index] = bar
	end
	local scroll = 0
	local infoTimer = 0
	local playing = true
	local levels = table.create(BARS, 0.2)
	local clock = 0
	local function refresh()
		local name = Locale.T("lofi beats 🎧 to study to")
		local manager = sound()
		if manager and type(manager.GetMusicInfo) == "function" then
			local ok, info = pcall(manager.GetMusicInfo)
			if ok and type(info) == "table" then
				if type(info.Name) == "string" then
					name = info.Name
				end
				playing = info.Playing == true
			end
		end
		title.Text = "♪ " .. name .. "   ♪ " .. name
		state.Text = playing and "▶" or "❚❚"
	end
	refresh()
	local screen = {} :: Screen
	screen.Kind = "Music"
	screen.Root = root
	function screen.Step(_self: Screen, dt: number)
		clock += dt
		infoTimer += dt
		if infoTimer > 1 then
			infoTimer = 0
			refresh()
		end
		scroll = (scroll + dt * 24) % math.max(40, W * 1.2)
		title.Position = UDim2.fromOffset(6 - scroll, 2)
		for index, bar in ipairs(bars) do
			local target = playing and (0.25 + 0.75 * math.abs(math.sin(clock * (2 + index * 0.37) + index))) or 0.08
			levels[index] += (target - levels[index]) * math.min(1, dt * 12)
			bar.Size = UDim2.fromOffset(barW - 2, math.max(2, levels[index] * H * 0.44))
		end
	end
	function screen.Destroy(_self: Screen)
		root:Destroy()
	end
	return screen
end

----------------------------------------------------------------------
-- API
----------------------------------------------------------------------

local MAKERS: { [string]: (gui: SurfaceGui, canvas: Vector2) -> Screen } = {
	Runner = newRunner,
	Live = newLive,
	DVD = newDVD,
	News = newNews,
	Music = newMusic,
}

-- Couleur "ambiante" d'un type d'écran (écran éteint au loin, bords incurvés)
LiveScreens.Tints = {
	Runner = rgb(110, 170, 255),
	Live = rgb(200, 100, 220),
	DVD = rgb(30, 30, 60),
	News = rgb(60, 110, 220),
	Music = rgb(60, 200, 170),
}

function LiveScreens.Has(kind: string): boolean
	return MAKERS[kind] ~= nil
end

function LiveScreens.New(kind: string, gui: SurfaceGui, canvas: Vector2): Screen
	local maker = MAKERS[kind] or newDVD
	return maker(gui, canvas)
end

return LiveScreens
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="210">
          <Properties>
            <string name="Name">MarketCheckout</string>
            <string name="Source"><![CDATA[--[[
	MarketCheckout (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > MarketCheckout

	🛒 MégaDopa (v9.9, SHOPS99) : les CAISSES du supermarché, 20x plus
	vraies (construites et animées pour MarketInterior, qui fournit ses
	aides de construction via MarketCheckout.Init(ctx)) :
	  - 5 caisses tenues (4 ouvertes, 1 fermée avec sangle) : meuble à
	    bandeau, plan inox, TAPIS à nervures qui défilent, rouleaux, rails,
	    cellule, barre « client suivant », scanner à plat + tour (lignes
	    laser, BIP visuel), balance, pistolet, tiroir-caisse, clavier,
	    écran caisse, afficheur client, TPE sur pied, imprimante à tickets,
	    carrousel à sacs, présentoir à bonbons, lampe numérotée à LED, poste
	    caissier (tabouret assis-debout, tapis anti-fatigue, paroi givrée) ;
	  - 4 caisses automatiques : écran tactile animé (articles, total,
	    paiement), scanner, lecteur de carte, balance + potence à sac, lampe ;
	  - personnages : caissier·ère qui scanne / encaisse / salue, FILE de
	    2 à 3 clients avec panier par caisse (le client pose ses articles,
	    paie par carte, part avec ses sacs ; la file avance ; un nouveau
	    client arrive), clients aux caisses automatiques.
	Tout est déterministe (cycle de 20 s par caisse, décalé) : aucune
	création / destruction par image, seulement des CFrame et des textes.
	Aucune vraie lumière, aucun son.

	API (MarketInterior) :
	  MarketCheckout.Init(ctx)                    aides de construction
	  MarketCheckout.Lane(m, parent, i)           une caisse (niveau complet)
	  MarketCheckout.SelfCheckout(m, parent)      caisses automatiques
	  MarketCheckout.Zone(m, parent, jobs)        personnages (zone "Checkout")
	  MarketCheckout.AnimateLane(belt, now)       une caisse, ≤ 30 i/s
	  MarketCheckout.AnimateKiosk(kiosk, now)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Locale = require(ReplicatedStorage.Shared.Locale)
local ShopUI = require(script.Parent.ShopUI)

local MarketCheckout = {}

local M = Enum.Material
local rgb = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)
local BRAND = rgb(236, 72, 140)
local BRAND2 = rgb(120, 90, 200)
local YELLOW = rgb(255, 208, 72)
local FACE_PX = CFrame.Angles(0, -math.pi / 2, 0) -- LookVector = +X

-- aides de MarketInterior (Init)
local C: any = nil
local box: any, cyl: any, cylX: any, newPart: any, label: any, text: any, corner: any
local printLabel: any, pick: any, hash: any, actor: any, hangingSign: any, NPC: any
local PALETTE: { Color3 } = {}
local FLOOR_TOP = 0.07
local LANES: { number } = {}
local OPEN_LANES = 4

function MarketCheckout.Init(ctx: any)
	C = ctx
	box, cyl, cylX, newPart = ctx.box, ctx.cyl, ctx.cylX, ctx.newPart
	label, text, corner = ctx.label, ctx.text, ctx.corner
	printLabel, pick, hash, actor, hangingSign, NPC = ctx.printLabel, ctx.pick, ctx.hash, ctx.actor, ctx.hangingSign, ctx.NPC
	PALETTE = ctx.PALETTE
	FLOOR_TOP = ctx.FLOOR_TOP
	LANES = ctx.LANES
	OPEN_LANES = ctx.OPEN_LANES
end

----------------------------------------------------------------------
-- 🛒 CAISSES (v9.9, SHOPS99) : 5 vraies caisses (4 ouvertes) + 4 caisses
-- automatiques. Repère d'une caisse L = F * (x, 0, 0) : u (x local) vers
-- l'allée des clients (+X), z vers le fond ; le client avance vers -z.
--   meuble (plinthe, bandeau, inox), TAPIS en caoutchouc à nervures qui
--   défilent, rouleaux chromés, rails, cellule photo, barre « client
--   suivant » (posée par le client, rangée par le·la caissier·ère),
--   scanner à plat + tour (vitres, lignes laser, BIP visuel), balance,
--   pistolet-scanner, clavier, écran caisse (tickets qui défilent),
--   afficheur client (TOTAL en direct), TPE sur pied (écran qui change :
--   « approchez la carte » -> « paiement accepté »), imprimante à tickets
--   (le ticket sort), tiroir-caisse, CARROUSEL À SACS qui tourne, présentoir
--   à bonbons, lampe de caisse numérotée (LED verte / rouge), poste
--   caissier (tabouret assis-debout, tapis anti-fatigue, paroi).
-- Animation déterministe (cycle de LANE_T s, décalé par caisse) : le
-- client pose ses articles, le tapis avance, chaque article passe au
-- scanner dans la main du·de la caissier·ère puis tombe dans le sac, le
-- client paie par carte, prend ses sacs et s'en va ; la file avance.
----------------------------------------------------------------------

local LANE_T = 20
local TOP_Y = 2.62 -- dessus du plan de travail inox
local BELT_Y = 2.7 -- dessus du tapis
local BELT_Z0, BELT_Z1 = 6.3, 11
local FRONT_Z = 6.75 -- premier article en attente devant le scanner
local SCAN_Z = 5.62 -- centre de la vitre du scanner
local BAG_Z = 3.95 -- axe du carrousel à sacs
local BAG_R = 0.62 -- longueur des bras du carrousel
local BELT_RUN = 1.4 * 6.4 + 6 * 0.8 -- (distance du tapis sur un cycle)

-- Articles : forme, largeur, hauteur, profondeur, couleurs, nom, prix
local ITEM_SPECS: { { any } } = {
	{ "Box", 0.5, 0.62, 0.22, { rgb(255, 170, 60), rgb(236, 72, 90), rgb(150, 110, 220) }, "Crunchy Brain", 2.99 },
	{ "Bottle", 0.26, 0.66, 0.26, { rgb(120, 200, 110), rgb(140, 200, 255), rgb(236, 60, 80) }, "Fizz", 1.49 },
	{ "Can", 0.24, 0.32, 0.24, { rgb(236, 60, 80), rgb(80, 150, 230), rgb(255, 214, 80) }, "Cola", 0.89 },
	{ "Carton", 0.3, 0.56, 0.3, { rgb(250, 250, 252), rgb(214, 236, 255) }, "Milk", 1.15 },
	{ "Bag", 0.46, 0.5, 0.2, { rgb(255, 214, 80), rgb(96, 186, 110), rgb(255, 130, 180) }, "Chips!", 1.79 },
}

-- Places de la file (u, z) : 1 paie, 2 décharge, 3 attend ; arrivée / sortie
local QUEUE = { { 2.05, 5.3 }, { 2.05, 9.3 }, { 2.25, 12.9 } }
local SPAWN = { 2.4, 17.4 }
local EXIT = { { 2.05, 1.7 }, { -4.2, 1.7 } }

local function smooth(x: number): number
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end

local function placeAt(k: number): number
	return 3.2 + (k - 1) * 0.9
end

local function scanAt(k: number): number
	return 4.2 + k * 1.4
end

local function money(v: number): string
	local s = string.format("%.2f", v)
	if Locale.IsFrench() then
		s = (string.gsub(s, "%.", ","))
	end
	return s .. " €"
end

-- Groupe de pièces rangées par rapport à un pivot (déplacé d'un bloc)
local function group(parts: { BasePart }, pivot: CFrame): any
	local offsets = table.create(#parts)
	for i, p in ipairs(parts) do
		offsets[i] = pivot:ToObjectSpace(p.CFrame)
	end
	return { Parts = parts, Offsets = offsets, Shown = true }
end

local function moveGroup(g: any, pivot: CFrame)
	local frames = table.create(#g.Parts)
	for i, o in ipairs(g.Offsets) do
		frames[i] = pivot * o
	end
	workspace:BulkMoveTo(g.Parts, frames, Enum.BulkMoveMode.FireCFrameChanged)
end

local function showGroup(g: any, on: boolean)
	if g.Shown ~= on then
		g.Shown = on
		for _, p in ipairs(g.Parts) do
			p.LocalTransparencyModifier = on and 0 or 1
		end
	end
end

-- Un article (pivot = milieu du dessous) ; 1 ou 2 pièces
local function makeItem(parent: Instance, spec: { any }, color: Color3, seed: number): any
	local kind, w, h, d = spec[1] :: string, spec[2] :: number, spec[3] :: number, spec[4] :: number
	local P = CFrame.new(0, -500, 0)
	local parts = {}
	if kind == "Bottle" or kind == "Can" then
		local body = cyl(parent, "Groceries", P, 0, 0, 0, h, w, color, kind == "Can" and M.Metal or M.Glass)
		if kind == "Bottle" then
			body.Transparency = 0.25
			table.insert(parts, cyl(parent, "GroceriesCap", P, 0, h - 0.02, 0, 0.12, w * 0.42, WHITE, M.SmoothPlastic))
		end
		table.insert(parts, 1, body)
	else
		local p = box(parent, "Groceries", P, -w / 2, w / 2, 0, h, -d / 2, d / 2, color, kind == "Bag" and M.Fabric or M.SmoothPlastic)
		if kind == "Carton" then
			-- toit du brique (arête)
			local roof = newPart(parent, "GroceriesTop", Vector3.new(w * 0.99, 0.16, 0.16), P * CFrame.new(0, h, 0) * CFrame.Angles(math.rad(45), 0, 0), color, M.SmoothPlastic)
			table.insert(parts, roof)
		elseif kind == "Box" and seed % 2 == 0 then
			printLabel(p, Enum.NormalId.Front, "Crunchy Brain", "🥣", color, 60)
		end
		table.insert(parts, 1, p)
	end
	for _, p in ipairs(parts) do
		p.LocalTransparencyModifier = 1
	end
	local g = group(parts, P)
	g.Shown = false
	return g
end

-- Panier à provisions (pivot = milieu du fond) ; ~8 pièces
local function basket(parent: Instance, seed: number): any
	local P = CFrame.new(0, -500, 0)
	local c = pick({ rgb(236, 72, 90), rgb(80, 150, 230), rgb(96, 186, 110) }, seed, 71)
	local parts = {
		box(parent, "BasketFloor", P, -0.45, 0.45, 0, 0.08, -0.28, 0.28, c, M.SmoothPlastic),
		box(parent, "BasketSide", P, -0.45, 0.45, 0.04, 0.5, -0.3, -0.25, c, M.SmoothPlastic),
		box(parent, "BasketSide", P, -0.45, 0.45, 0.04, 0.5, 0.25, 0.3, c, M.SmoothPlastic),
		box(parent, "BasketEnd", P, -0.47, -0.42, 0.04, 0.5, -0.27, 0.27, c, M.SmoothPlastic),
		box(parent, "BasketEnd", P, 0.42, 0.47, 0.04, 0.5, -0.27, 0.27, c, M.SmoothPlastic),
		box(parent, "BasketHandle", P, -0.4, 0.4, 0.78, 0.84, -0.03, 0.03, rgb(40, 40, 48), M.SmoothPlastic),
		box(parent, "BasketGoods", P, -0.35, -0.02, 0.06, 0.62, -0.18, 0.12, pick(PALETTE, seed, 73), M.SmoothPlastic),
		box(parent, "BasketGoods", P, 0.04, 0.34, 0.06, 0.44, -0.14, 0.16, pick(PALETTE, seed, 79), M.SmoothPlastic),
	}
	for _, sx in ipairs({ -1, 1 }) do
		table.insert(parts, box(parent, "BasketHandlePost", P, sx * 0.4 - 0.03, sx * 0.4 + 0.03, 0.48, 0.82, -0.03, 0.03, rgb(40, 40, 48), M.SmoothPlastic))
	end
	return group(parts, P)
end

-- Petit écran (SurfaceGui « rétroéclairé ») : renvoie le texte
local function screenText(p: BasePart, face: Enum.NormalId, pps: number, bg: Color3, color: Color3, initial: string, font: Enum.Font?): TextLabel
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Screen"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pps
	gui.LightInfluence = 0.1
	gui.MaxDistance = 45
	gui.Parent = p
	local back = Instance.new("Frame")
	back.Name = "Back"
	back.Size = UDim2.fromScale(1, 1)
	back.BackgroundColor3 = bg
	back.BorderSizePixel = 0
	back.Parent = gui
	local t = text(back, "Text", initial, 0.05, 0.06, 0.9, 0.88, color, font or Enum.Font.GothamBold)
	return t
end

local function checkoutPrompt(m: any, parent: Instance, at: CFrame)
	local anchor = newPart(parent, "CheckoutPoint", Vector3.new(1, 1, 1), at, WHITE, M.SmoothPlastic)
	anchor.Transparency = 1
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "CheckoutPrompt"
	prompt.ActionText = Locale.T("🛒 Checkout")
	prompt.ObjectText = Locale.T("🛒 MegaDopa")
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 7
	prompt.RequiresLineOfSight = false
	prompt.Parent = anchor
	local pos = anchor.Position
	table.insert(m.Checkouts, pos)
	prompt.Triggered:Connect(function()
		ShopUI.OpenShop("Market", { Anchor = pos })
	end)
end

function MarketCheckout.Lane(m: any, parent: Instance, i: number)
	local L = m.F * CFrame.new(LANES[i], 0, 0)
	local open = i <= OPEN_LANES
	local white = rgb(240, 240, 244)
	local inox = rgb(196, 200, 210)
	local graphite = rgb(52, 54, 64)
	-- meuble : caisson, plinthe en retrait, bandeau de l'enseigne côté client, plan inox
	box(parent, "CheckoutBody", L, -0.9, 0.9, FLOOR_TOP, 2.55, 3, 11.2, white, M.SmoothPlastic, true)
	box(parent, "CheckoutPlinth", L, 0.86, 0.93, FLOOR_TOP, 0.42, 3.1, 11.1, graphite, M.Metal)
	box(parent, "CheckoutBand", L, 0.88, 0.94, 1.05, 1.75, 3.2, 11, BRAND, M.SmoothPlastic)
	box(parent, "CheckoutBandLine", L, 0.9, 0.96, 1.75, 1.83, 3.2, 11, YELLOW, M.SmoothPlastic)
	local top = box(parent, "Worktop", L, -0.96, 0.96, 2.52, TOP_Y, 2.92, 11.3, inox, M.Metal)
	top.Reflectance = 0.08
	for _, z in ipairs({ 2.92, 11.3 }) do
		-- angles arrondis (côté client)
		cyl(parent, "WorktopCorner", L, 0.96, 2.52, z, TOP_Y - 2.52, 0.2, inox, M.Metal)
	end
	-- tapis : lit en caoutchouc, nervures qui défilent, rouleaux, rails, cellule
	box(parent, "Belt", L, -0.72, 0.72, 2.58, BELT_Y, BELT_Z0, BELT_Z1, rgb(30, 30, 36), M.Rubber)
	local slats = {}
	for k = 0, 5 do
		local z = BELT_Z0 + 0.3 + k * 0.75
		table.insert(slats, box(parent, "BeltRib", L, -0.68, 0.68, 2.66, 2.73, z - 0.05, z + 0.05, rgb(62, 62, 72), M.Rubber))
	end
	for _, z in ipairs({ BELT_Z0 + 0.1, BELT_Z1 - 0.1 }) do

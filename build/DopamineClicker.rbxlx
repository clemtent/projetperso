----------------------------------------------------------------------
-- Rails (grand huit, train fantôme) : construits une fois (module pur)
----------------------------------------------------------------------

local tracks: { [string]: any } = {}

local function nearestS(track: any, p: Vector3): number
	local best, bestS = math.huge, 0
	for i = 1, track.N do
		local d = (track.Pos[i] - p).Magnitude
		if d < best then
			best = d
			bestS = (i - 1) * track.Step
		end
	end
	return bestS
end

-- kind -> { Track, Profile, Cars, Gap } (profil de vitesse compris)
function FairRides.Track(kind: string): any
	local cached = tracks[kind]
	if cached then
		return cached
	end
	local entry
	if kind == "Coaster" then
		local track = FairTrack.Build(FairRides.COASTER_POINTS, { MaxBank = math.rad(26), BankGain = 10 })
		-- (s = 0 : l'arrêt en gare, le premier point)
		local lift = FairRides.COASTER_LIFT
		local profile = FairTrack.Profile(track, {
			Lift = { A = nearestS(track, lift.From), B = nearestS(track, lift.To), V = lift.V },
			G = 35, -- (1 stud ≈ 0,28 m : 9,8 m/s² ≈ 35 studs/s²)
			Friction = 0.018,
			MinV = 3,
			MaxV = 26,
			Launch = 2.6,
			Decel = 3.4,
			StartV = 0,
		})
		entry = { Track = track, Profile = profile, Cars = FairRides.COASTER_CARS, Gap = FairRides.COASTER_GAP }
	elseif kind == "Ghost" then
		local track = FairTrack.Build(FairRides.GHOST_POINTS, { MaxBank = math.rad(6), BankGain = 2 })
		local profile = FairTrack.Profile(track, { Cruise = FairRides.GHOST_SPEED, Launch = 1.6, Decel = 1.8, StartV = 0 })
		entry = { Track = track, Profile = profile, Cars = FairRides.GHOST_CARS, Gap = FairRides.GHOST_GAP }
	end
	tracks[kind] = entry
	return entry
end

-- Durée d'un tour -> cycle (embarquement + un tour)
for _, def in ipairs(FairRides.Annex) do
	if def.Kind == "Coaster" or def.Kind == "Ghost" then
		local entry = FairRides.Track(def.Kind)
		def.Cycle = { Load = def.Cycle.Load, Ramp = 0, Run = entry.Profile.Lap }
	end
end

-- Abscisse de l'avant du train à l'heure t (0 = en gare)
function FairRides.TrainS(def: any, t: number): number
	local entry = FairRides.Track(def.Kind)
	local P = FairRides.Period(def.Cycle)
	local tm = t % P
	if tm < def.Cycle.Load then
		return 0
	end
	return FairTrack.Distance(entry.Profile, tm - def.Cycle.Load)
end

-- Angle du bateau pirate : amplitude qui monte, tient, puis s'éteint
function FairRides.PirateAngle(def: any, t: number): number
	local c = def.Cycle
	local P = FairRides.Period(c)
	local tm = t % P
	if tm < c.Load then
		return 0
	end
	local u = tm - c.Load
	local run = c.Run
	local up, down = 13, 13
	local env
	if u < up then
		env = smooth(u / up)
	elseif u > run - down then
		env = smooth((run - u) / down)
	else
		env = 1
	end
	-- (période entière : l'angle revient à 0 pile à la fin)
	local cycles = math.max(1, math.floor(run / FairRides.PIRATE_PERIOD + 0.5))
	return FairRides.PIRATE_MAX * env * math.sin(u / run * cycles * TAU)
end

-- Poses de l'annexe (groupes relatifs à la Base)
function FairRides.PoseAnnex(def: any, t: number, out: { CFrame }): number
	local kind = def.Kind
	if kind == "Pirate" then
		local a = FairRides.PirateAngle(def, t)
		out[1] = CFrame.new(0, FairRides.PIRATE_PIVOT, 0) * CFrame.Angles(0, 0, a) * CFrame.new(0, -FairRides.PIRATE_ARM, 0)
		return 1
	elseif kind == "Coaster" or kind == "Ghost" then
		local entry = FairRides.Track(kind)
		local s = FairRides.TrainS(def, t)
		for k = 1, entry.Cars do
			out[k] = FairTrack.Frame(entry.Track, s - (k - 1) * entry.Gap)
		end
		return entry.Cars
	elseif kind == "Circus" then
		out[1] = CFrame.identity
		return 1
	end
	return 0
end

-- Sièges de l'annexe (Group, Local, Size ; -Z du siège = regard)
function FairRides.AnnexSeats(kind: string): { SeatSpec }
	local list: { SeatSpec } = {}
	if kind == "Pirate" then
		-- 4 rangées face au milieu, 3 places ; les bouts sont plus hauts
		for _, x in ipairs({ -7.2, -4.4, 4.4, 7.2 }) do
			local yaw = if x < 0 then math.rad(-90) else math.rad(90)
			local y = 1.25 + (math.abs(x) - 4.4) * 0.3
			for _, z in ipairs({ -1.35, 0, 1.35 }) do
				table.insert(list, { Group = 1, Local = CFrame.new(x, y, z) * CFrame.Angles(0, yaw, 0), Size = Vector3.new(1.2, 0.16, 1) })
			end
		end
	elseif kind == "Coaster" then
		for k = 1, FairRides.COASTER_CARS do
			for _, x in ipairs({ -0.7, 0.7 }) do
				table.insert(list, { Group = k, Local = CFrame.new(x, 0.95, 0.35), Size = Vector3.new(1.1, 0.16, 1) })
			end
		end
	elseif kind == "Ghost" then
		for k = 1, FairRides.GHOST_CARS do
			for _, x in ipairs({ -0.66, 0.66 }) do
				table.insert(list, { Group = k, Local = CFrame.new(x, 1.05, 0.3), Size = Vector3.new(1.1, 0.16, 1) })
			end
		end
	elseif kind == "Circus" then
		for tier = 0, FairRides.CIRCUS_TIERS - 1 do
			local r = FairRides.CIRCUS_TIER_R0 + tier * FairRides.CIRCUS_TIER_DR
			local y = FairRides.CIRCUS_SEAT_Y0 + tier * FairRides.CIRCUS_TIER_DY
			for _, arc in ipairs(FairRides.CIRCUS_ARCS) do
				local n = FairRides.CIRCUS_PER_ARC
				for i = 0, n - 1 do
					local a = math.rad(arc[1] + (arc[2] - arc[1]) * (i + 0.5) / n)
					local p = Vector3.new(math.sin(a) * r, y, math.cos(a) * r)
					table.insert(list, { Group = 1, Local = CFrame.lookAt(p, Vector3.new(0, y, 0)), Size = Vector3.new(1.3, 0.16, 1.1) })
				end
			end
		end
	end
	return list
end

----------------------------------------------------------------------
-- Placement de l'annexe (pur) : pour chaque attraction, de la plus grande
-- à la plus petite, on essaie d'abord sa place "idéale", puis toutes les
-- places d'une grille autour de la fête (4 orientations) ; on garde la
-- place libre la plus proche d'une porte de la fête. `isFree(x, z)` (repère
-- de la fête) dit si un point du sol est libre (rues, boulevard, lac…).
----------------------------------------------------------------------

-- Portes de la fête (repère de la fête) : arche, côtés (clôture ouverte)
FairRides.GATES = { Vector3.new(0, 0, -FairRides.FAIR_HALF_D - 6), Vector3.new(FairRides.FAIR_HALF_W + 2, 0, -1), Vector3.new(-FairRides.FAIR_HALF_W - 2, 0, -1) }

local function rectPoints(r: Rect, step: number, margin: number): { Vector3 }
	local pts = {}
	local x0, x1, z0, z1 = r.X0 - margin, r.X1 + margin, r.Z0 - margin, r.Z1 + margin
	local nx = math.max(1, math.ceil((x1 - x0) / step))
	local nz = math.max(1, math.ceil((z1 - z0) / step))
	for i = 0, nx do
		for k = 0, nz do
			table.insert(pts, Vector3.new(x0 + (x1 - x0) * i / nx, 0, z0 + (z1 - z0) * k / nz))
		end
	end
	return pts
end

local function corners(r: Rect, margin: number): { Vector3 }
	return {
		Vector3.new(r.X0 - margin, 0, r.Z0 - margin), Vector3.new(r.X1 + margin, 0, r.Z0 - margin),
		Vector3.new(r.X0 - margin, 0, r.Z1 + margin), Vector3.new(r.X1 + margin, 0, r.Z1 + margin),
		Vector3.new((r.X0 + r.X1) / 2, 0, (r.Z0 + r.Z1) / 2),
	}
end

-- Rectangle (repère de l'attraction) -> rectangle englobant dans la fête
local function worldBox(r: Rect, cf: CFrame, margin: number): Rect
	local x0, x1, z0, z1 = math.huge, -math.huge, math.huge, -math.huge
	for _, p in ipairs(corners(r, margin)) do
		local w = cf * p
		x0, x1 = math.min(x0, w.X), math.max(x1, w.X)
		z0, z1 = math.min(z0, w.Z), math.max(z1, w.Z)
	end
	return { X0 = x0, X1 = x1, Z0 = z0, Z1 = z1 }
end

local function overlap(a: Rect, b: Rect): boolean
	return a.X0 < b.X1 and b.X0 < a.X1 and a.Z0 < b.Z1 and b.Z0 < a.Z1
end

export type Placement = { Pos: Vector3, Yaw: number, CF: CFrame, Box: Rect }

-- isFree(x, z) : repère de la fête ; renvoie { [Id] = Placement }.
-- `looseFree` (facultatif) : 2e passe, plus permissive (ex. : sans les
-- sites de la nature qui sont posés APRÈS la fête et doivent l'éviter),
-- pour une attraction qui n'a trouvé aucune place à la 1re passe.
function FairRides.SolveAnnex(strictFree: (number, number) -> boolean, looseFree: ((number, number) -> boolean)?): { [string]: Placement }
	local isFree = strictFree
	local hw, hd = FairRides.FAIR_HALF_W, FairRides.FAIR_HALF_D
	-- la fête elle-même + le couloir derrière la mairie (on y passe)
	local taken: { Rect } = {
		{ X0 = -hw - 1.5, X1 = hw + 1.5, Z0 = -hd - 1.5, Z1 = hd + 1.5 },
		{ X0 = -60, X1 = 60, Z0 = -hd - 16, Z1 = -hd },
	}
	-- les portes de côté gardent un passage
	for _, gx in ipairs({ -1, 1 }) do
		table.insert(taken, { X0 = if gx > 0 then hw else -hw - 7, X1 = if gx > 0 then hw + 7 else -hw, Z0 = -6, Z1 = 5 })
	end
	local result: { [string]: Placement } = {}
	local function fits(def: AnnexDef, cf: CFrame): (boolean, Rect?)
		local body = worldBox(def.Body, cf, 1.5)
		local apron = worldBox(def.Apron, cf, 0.5)
		for _, r in ipairs(taken) do
			if overlap(body, r) or overlap(apron, r) then
				return false, nil
			end
		end
		-- test rapide (coins), puis complet (grille de 3 studs)
		for _, rect in ipairs({ def.Body, def.Apron }) do
			for _, p in ipairs(corners(rect, 1.5)) do
				local w = cf * p
				if not isFree(w.X, w.Z) then
					return false, nil
				end
			end
		end
		for _, rect in ipairs({ def.Body, def.Apron }) do
			for _, p in ipairs(rectPoints(rect, 3, 1.5)) do
				local w = cf * p
				if not isFree(w.X, w.Z) then
					return false, nil
				end
			end
		end
		return true, body
	end
	-- candidats (grille de 4 studs, 4 orientations) triés par coût : on
	-- s'arrête au PREMIER qui tient (rapide, ~10 000 candidats au plus)
	local function search(def: AnnexDef): (CFrame?, Rect?)
		local ideal = CFrame.new(def.Pos) * CFrame.Angles(0, math.rad(def.Yaw), 0)
		local ok, box = fits(def, ideal)
		if ok then
			return ideal, box
		end
		-- (coût calculé sans CFrame : rotations de 90° = échanges d'axes)
		local dx, dz = (def.Apron.X0 + def.Apron.X1) / 2, def.Apron.Z0
		local cands = {}
		for gx = -150, 150, 4 do
			for gz = -84, 44, 4 do
				if math.abs(gx) > hw + 4 or gz < -hd - 4 then
					for q = 0, 3 do
						local c, s = ({ 1, 0, -1, 0 })[q + 1], ({ 0, 1, 0, -1 })[q + 1]
						local px, pz = gx + dx * c + dz * s, gz - dx * s + dz * c
						local best = math.huge
						for _, g in ipairs(FairRides.GATES) do
							local ex, ez = px - g.X, pz - g.Z
							best = math.min(best, math.sqrt(ex * ex + ez * ez))
						end
						-- (entrée tournée vers la fête : un peu préférée)
						local lx, lz = -s, -c
						local m = math.sqrt(px * px + pz * pz)
						local facing = if m > 1 then (lx * -px + lz * -pz) / m else 0
						table.insert(cands, { X = gx, Z = gz, Q = q, Cost = best - facing * 6 })
					end
				end
			end
		end
		table.sort(cands, function(a, b)
			return a.Cost < b.Cost
		end)
		for _, cand in ipairs(cands) do
			local cf = CFrame.new(cand.X, 0, cand.Z) * CFrame.Angles(0, cand.Q * math.pi / 2, 0)
			local fit, b = fits(def, cf)
			if fit then
				return cf, b
			end
		end
		return nil, nil
	end
	for _, def in ipairs(FairRides.Annex) do
		isFree = strictFree
		local bestCF, bestBox = search(def)
		if not bestCF and looseFree then
			isFree = looseFree
			bestCF, bestBox = search(def)
		end
		if bestCF and bestBox then
			local yaw = math.deg(select(2, bestCF:ToOrientation()))
			result[def.Id] = { Pos = bestCF.Position, Yaw = yaw, CF = bestCF, Box = bestBox }
			table.insert(taken, bestBox)
			table.insert(taken, worldBox(def.Apron, bestCF, 0.5))
		end
	end
	return result
end

-- Boîte (repère de la fête) du corps d'une attraction placée en `cf`
function FairRides.AnnexBox(def: AnnexDef, cf: CFrame): Rect
	return worldBox(def.Body, cf, 1.5)
end

local function segmentHits(a: Vector3, b: Vector3, boxes: { Rect }, skip: Rect?): boolean
	local len = (b - a).Magnitude
	local n = math.max(1, math.ceil(len / 1.5))
	for i = 0, n do
		local p = a:Lerp(b, i / n)
		for _, r in ipairs(boxes) do
			if r ~= skip and p.X > r.X0 and p.X < r.X1 and p.Z > r.Z0 and p.Z < r.Z1 then
				return true
			end
		end
	end
	return false
end

-- Allée (repère de la fête, au sol) de la porte de la fête la plus proche
-- jusqu'au parvis de l'attraction : points { porte, coude, parvis, entrée }.
-- `boxes` = corps des autres attractions (+ la fête) à contourner.
function FairRides.AnnexPath(def: AnnexDef, cf: CFrame, boxes: { Rect }): { Vector3 }
	local door = cf * Vector3.new((def.Apron.X0 + def.Apron.X1) / 2, 0, def.Apron.Z0 + 0.5)
	local inner = cf * Vector3.new((def.Apron.X0 + def.Apron.X1) / 2, 0, (def.Apron.Z0 + def.Apron.Z1) / 2)
	local best: { Vector3 }? = nil
	local bestScore = math.huge
	for _, g in ipairs(FairRides.GATES) do
		for order = 1, 2 do
			local corner = if order == 1 then Vector3.new(door.X, 0, g.Z) else Vector3.new(g.X, 0, door.Z)
			local hits = (if segmentHits(g, corner, boxes) then 1 else 0) + (if segmentHits(corner, door, boxes) then 1 else 0)
			local score = (corner - g).Magnitude + (door - corner).Magnitude + hits * 400
			if score < bestScore then
				bestScore = score
				best = { g, corner, door, inner }
			end
		end
	end
	return best or { door, door, door, inner }
end

return FairRides
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="255">
        <Properties>
          <string name="Name">FairTrack</string>
          <string name="Source"><![CDATA[--[[
	FairTrack (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > FairTrack

	🎢 Manèges SUR RAILS de la fête (v9.9, FAIR99) : grand huit familial et
	train fantôme. Module PUR (CFrame / Vector3 seulement, aucun service) :
	le serveur (TownFair : sièges) et chaque client (FairFx : wagons, rails)
	calculent la MÊME pose à partir de l'heure du serveur.

	  - FairTrack.Build(points, opts) -> Track : spline de Catmull-Rom
	    CENTRIPÈTE fermée (jamais de boucle parasite), rééchantillonnée tous
	    les STEP studs (longueur d'arc), avec tangente, inclinaison dans les
	    virages (dévers) et repère lissé ;
	  - FairTrack.Frame(track, s) -> CFrame : repère du rail à l'abscisse s
	    (-Z = sens de la marche, +Y = dessus du rail, dévers compris) ;
	  - FairTrack.Profile(track, spec) : profil de vitesse PHYSIQUE (montée
	    à la chaîne, puis énergie : v² = v0² + 2 g (h0 - h) - frottement,
	    freins avant la gare) -> table temps(s), durée d'un tour ;
	  - FairTrack.Distance(profile, u) -> s : où est le train u secondes
	    après le départ (recherche dichotomique, interpolée : continue).
	s = 0 : l'arrêt en gare (avant du train). Le train s'y arrête pendant
	l'embarquement puis fait exactement UN tour.
]]

local FairTrack = {}

FairTrack.STEP = 0.25 -- (studs) pas du rééchantillonnage

export type Track = {
	Length: number,
	Step: number,
	N: number,
	Pos: { Vector3 },
	Look: { Vector3 },
	Up: { Vector3 },
	Height: { number },
}

export type Profile = {
	Track: Track,
	Times: { number }, -- temps (s) pour atteindre l'échantillon i (1 = gare)
	Speeds: { number }, -- vitesse (studs/s) à l'échantillon i
	Lap: number,
	MaxSpeed: number,
}

-- Catmull-Rom centripète (alpha = 0,5) entre p1 et p2
local function knot(t: number, a: Vector3, b: Vector3): number
	return t + math.max(1e-4, (b - a).Magnitude ^ 0.5)
end

local function crPoint(p0: Vector3, p1: Vector3, p2: Vector3, p3: Vector3, u: number): Vector3
	local t0 = 0
	local t1 = knot(t0, p0, p1)
	local t2 = knot(t1, p1, p2)
	local t3 = knot(t2, p2, p3)
	local t = t1 + (t2 - t1) * u
	local a1 = p0 * ((t1 - t) / (t1 - t0)) + p1 * ((t - t0) / (t1 - t0))
	local a2 = p1 * ((t2 - t) / (t2 - t1)) + p2 * ((t - t1) / (t2 - t1))
	local a3 = p2 * ((t3 - t) / (t3 - t2)) + p3 * ((t - t2) / (t3 - t2))
	local b1 = a1 * ((t2 - t) / (t2 - t0)) + a2 * ((t - t0) / (t2 - t0))
	local b2 = a2 * ((t3 - t) / (t3 - t1)) + a3 * ((t - t1) / (t3 - t1))
	return b1 * ((t2 - t) / (t2 - t1)) + b2 * ((t - t1) / (t2 - t1))
end

-- opts : { MaxBank (rad), BankGain, Sub (sous-pas par segment) }
function FairTrack.Build(points: { Vector3 }, opts: any?): Track
	local o = opts or {}
	local maxBank = o.MaxBank or math.rad(24)
	local gain = o.BankGain or 9
	local sub = o.Sub or 40
	local n = #points
	-- 1) polyligne fine
	local dense: { Vector3 } = {}
	for i = 1, n do
		local p0 = points[(i - 2) % n + 1]
		local p1 = points[i]
		local p2 = points[i % n + 1]
		local p3 = points[(i + 1) % n + 1]
		for k = 0, sub - 1 do
			table.insert(dense, crPoint(p0, p1, p2, p3, k / sub))
		end
	end
	table.insert(dense, dense[1])
	local cum = { 0 }
	for i = 2, #dense do
		cum[i] = cum[i - 1] + (dense[i] - dense[i - 1]).Magnitude
	end
	local length = cum[#dense]
	-- 2) rééchantillonnage à pas constant (longueur d'arc)
	local step = FairTrack.STEP
	local count = math.max(8, math.floor(length / step + 0.5))
	step = length / count
	local pos: { Vector3 } = {}
	local j = 1
	for i = 0, count - 1 do
		local s = i * step
		while j < #dense - 1 and cum[j + 1] < s do
			j += 1
		end
		local seg = cum[j + 1] - cum[j]
		local u = if seg > 1e-6 then (s - cum[j]) / seg else 0
		pos[i + 1] = dense[j]:Lerp(dense[j + 1], u)
	end
	-- 3) tangentes (différences centrées) et courbure horizontale -> dévers
	local look: { Vector3 } = {}
	local height: { number } = {}
	for i = 1, count do
		local a = pos[(i - 2) % count + 1]
		local b = pos[i % count + 1]
		look[i] = (b - a).Unit
		height[i] = pos[i].Y
	end
	local rawBank: { number } = {}
	local W = math.max(2, math.floor(1.5 / step))
	for i = 1, count do
		local a = look[(i - 1 - W) % count + 1]
		local b = look[(i - 1 + W) % count + 1]
		local ha = math.atan2(a.X, a.Z)
		local hb = math.atan2(b.X, b.Z)
		local d = (hb - ha + math.pi) % (2 * math.pi) - math.pi
		local curvature = d / (2 * W * step) -- rad / stud (signe : sens du virage)
		rawBank[i] = math.clamp(curvature * gain, -maxBank, maxBank)
	end
	-- lissage du dévers (moyenne glissante, fenêtre ~6 studs) : aucune secousse
	local up: { Vector3 } = {}
	local Wb = math.max(3, math.floor(3 / step))
	for i = 1, count do
		local sum = 0
		for k = -Wb, Wb do
			sum += rawBank[(i - 1 + k) % count + 1]
		end
		local bank = sum / (2 * Wb + 1)
		local fwd = look[i]
		local right = fwd:Cross(Vector3.new(0, 1, 0))
		if right.Magnitude < 1e-3 then
			right = Vector3.new(1, 0, 0)
		end
		right = right.Unit
		local flatUp = right:Cross(fwd).Unit
		-- (virage à gauche : bank > 0 -> le wagon penche vers l'intérieur,
		-- c.-à-d. vers -right)
		up[i] = (flatUp * math.cos(bank) - right * math.sin(bank)).Unit
	end
	return { Length = length, Step = step, N = count, Pos = pos, Look = look, Up = up, Height = height }
end

local function wrapIndex(track: Track, s: number): (number, number, number)
	local L = track.Length
	s = s % L
	local f = s / track.Step
	local i = math.floor(f)
	local u = f - i
	local a = i % track.N + 1
	local b = (i + 1) % track.N + 1
	return a, b, u
end

-- Repère du rail à l'abscisse s (interpolé : continu d'une image à l'autre)
function FairTrack.Frame(track: Track, s: number): CFrame
	local a, b, u = wrapIndex(track, s)
	local p = track.Pos[a]:Lerp(track.Pos[b], u)
	local fwd = track.Look[a]:Lerp(track.Look[b], u).Unit
	local up = track.Up[a]:Lerp(track.Up[b], u)
	local right = fwd:Cross(up).Unit
	up = right:Cross(fwd).Unit
	-- (-Z = avant : LookVector = fwd)
	return CFrame.fromMatrix(p, right, up, -fwd)
end

function FairTrack.Height(track: Track, s: number): number
	local a, b, u = wrapIndex(track, s)
	return track.Height[a] + (track.Height[b] - track.Height[a]) * u
end

-- spec : { Launch = accélération au départ (studs/s²), Lift = { A, B, V } (montée à
-- vitesse constante entre les abscisses A et B), G (gravité, studs/s²),
-- Friction (0..), MinV, MaxV, Decel (freinage avant la gare), StartV, Cruise = vitesse constante (train fantôme, sans gravité) }
function FairTrack.Profile(track: Track, spec: any): Profile
	local N, step, L = track.N, track.Step, track.Length
	local speeds = table.create(N + 1, 0)
	local g = spec.G or 35
	local mu = spec.Friction or 0.012
	local minV = spec.MinV or 2.2
	local maxV = spec.MaxV or 30
	local launch = spec.Launch or 3
	local lift = spec.Lift
	local cruise = spec.Cruise
	local decel = spec.Decel or 3.2
	local startV = spec.StartV or 0
	local topH, topV = 0, 0
	if lift then
		topH = FairTrack.Height(track, lift.B)
		topV = lift.V
	end
	local maxSeen = 0
	for i = 0, N do
		local s = i * step
		local v
		if cruise then
			v = cruise
		elseif lift and s <= lift.B then
			v = if s >= lift.A then lift.V else math.min(lift.V, math.sqrt(startV * startV + 2 * launch * s))
		else
			local h = FairTrack.Height(track, s)
			local e = topV * topV + 2 * g * (topH - h) - 2 * mu * g * (s - (lift and lift.B or 0))
			v = math.clamp(math.sqrt(math.max(0, e)), minV, maxV)
		end
		-- départ en douceur (train fantôme aussi)
		v = math.min(v, math.sqrt(startV * startV + 2 * launch * s))
		-- freins avant la gare : on arrive à l'arrêt en douceur
		v = math.min(v, math.sqrt(startV * startV + 2 * decel * math.max(0, L - s)))
		speeds[i + 1] = v
		maxSeen = math.max(maxSeen, v)
	end
	local times = table.create(N + 1, 0)
	times[1] = 0
	for i = 2, N + 1 do
		local vm = (speeds[i - 1] + speeds[i]) / 2
		times[i] = times[i - 1] + step / math.max(0.2, vm)
	end
	return { Track = track, Times = times, Speeds = speeds, Lap = times[N + 1], MaxSpeed = maxSeen }
end

-- u secondes après le départ -> abscisse s (0 <= s <= Length)
function FairTrack.Distance(profile: Profile, u: number): number
	local times = profile.Times
	local n = #times
	if u <= 0 then
		return 0
	end
	if u >= times[n] then
		return profile.Track.Length
	end
	local lo, hi = 1, n
	while hi - lo > 1 do
		local mid = (lo + hi) // 2
		if times[mid] <= u then
			lo = mid
		else
			hi = mid
		end
	end
	-- accélération CONSTANTE dans l'intervalle (vitesse continue : aucune
	-- secousse d'une image à l'autre, même au départ de la gare)
	local span = times[hi] - times[lo]
	local step = profile.Track.Step
	if span <= 1e-9 then
		return (lo - 1) * step
	end
	local va, vb = profile.Speeds[lo], profile.Speeds[hi]
	local tau = u - times[lo]
	local ds = va * tau + 0.5 * (vb - va) / span * tau * tau
	-- (la vitesse moyenne de l'intervalle est bornée à 0,2 : on reste dedans)
	return (lo - 1) * step + math.clamp(ds * step / math.max(1e-6, (va + vb) / 2 * span), 0, step)
end

return FairTrack
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="256">
        <Properties>
          <string name="Name">FoodModels</string>
          <string name="Source"><![CDATA[--[[
	FoodModels (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > FoodModels

	🍦 Modèles 3D de la nourriture, partagés (v9.8 FAIR98 ; v9.9 FAIR99 :
	refaits, réalistes et À LA TAILLE DE LA MAIN) :
	  - serveur (FoodService) : l'aliment TENU en main (un Tool dont la
	    pièce "Handle" est dans le poing) ;
	  - client (FairFx) : les aliments exposés sur les comptoirs des stands.

	FoodModels.Build(id, cf?, scale?) -> Model (ancré, sans collision) :
	repère = POINT DE PRISE (le centre du poing), +Y = le haut de l'aliment,
	-Z = vers l'avant (loin du mangeur). La pièce "Handle" est centrée sur ce
	point (cornet, bâton, gobelet, serviette…) ; les pièces "Bite1",
	"Bite2"… disparaissent une à une (bouchées, FoodService) ; la dernière
	bouchée finit l'aliment.
	Échelle : une main d'avatar fait ~1 stud de large ; un cornet de glace
	tenu fait ~1,5 stud de haut (v9.8 : 2,2 : trop gros, et la prise était
	sous le cornet).
	~12 à 30 pièces par aliment, aucune lumière, aucun son.

	FoodModels.GRIP : Tool.Grip conseillé (voir FoodService) : aucune
	rotation (l'aliment reste DEBOUT dans la pose "outil" R15 et R6) et le
	poing centré sur la prise.
]]

local FoodModels = {}

local M = Enum.Material
local BALL = Enum.PartType.Ball
local CYL = Enum.PartType.Cylinder
local UPRIGHT = CFrame.Angles(0, 0, math.rad(90)) -- cylindre debout (axe X -> Y)

-- (Grip = C1 de la soudure RightGrip : poignée = main * C0 * Grip⁻¹ ; ici
-- l'aliment remonte de 0,05 dans le poing et avance de 0,02 : aucune rotation)
FoodModels.GRIP = CFrame.new(0, -0.05, 0.02)

type Add = (name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?, className: string?) -> BasePart

local RECIPES: { [string]: (add: Add) -> () } = {}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

-- Cornet de glace : gaufrette conique (anneaux qui s'affinent + quadrillage),
-- 2 boules (fraise, pistache) avec leur collerette qui coule, vermicelles, cerise
RECIPES.IceCream = function(add)
	local waffle = rgb(214, 158, 92)
	local waffleDark = rgb(178, 120, 64)
	-- (cône : du bas pointu jusqu'au bord, tenu par le milieu)
	add("Handle", Vector3.new(0.34, 0.36, 0.36), CFrame.new(0, 0, 0) * UPRIGHT, waffle, M.Fabric, CYL)
	add("ConeTip", Vector3.new(0.3, 0.2, 0.2), CFrame.new(0, -0.3, 0) * UPRIGHT, waffleDark, M.Fabric, CYL)
	add("ConeLow", Vector3.new(0.14, 0.12, 0.12), CFrame.new(0, -0.5, 0) * UPRIGHT, waffleDark, M.Fabric, CYL)
	add("Cone2", Vector3.new(0.26, 0.46, 0.46), CFrame.new(0, 0.3, 0) * UPRIGHT, waffle, M.Fabric, CYL)
	add("Bite3", Vector3.new(0.18, 0.56, 0.56), CFrame.new(0, 0.52, 0) * UPRIGHT, waffle, M.Fabric, CYL)
	add("Bite3", Vector3.new(0.1, 0.62, 0.62), CFrame.new(0, 0.64, 0) * UPRIGHT, waffleDark, M.Fabric, CYL)
	-- relief de la gaufrette : fins anneaux plus foncés
	add("ConeRing", Vector3.new(0.04, 0.37, 0.37), CFrame.new(0, 0.1, 0) * UPRIGHT, waffleDark, M.Fabric, CYL)
	add("Cone2", Vector3.new(0.04, 0.47, 0.47), CFrame.new(0, 0.34, 0) * UPRIGHT, waffleDark, M.Fabric, CYL)
	add("ConeTip", Vector3.new(0.04, 0.24, 0.24), CFrame.new(0, -0.2, 0) * UPRIGHT, waffleDark, M.Fabric, CYL)
	-- boule du bas (fraise) + collerette qui coule
	local straw = rgb(255, 170, 196)
	add("Bite2", Vector3.new(0.7, 0.62, 0.7), CFrame.new(0, 0.9, 0), straw, M.SmoothPlastic, BALL)
	-- (une Ball Roblox reste ronde : collerette = disque)
	add("Bite2", Vector3.new(0.12, 0.74, 0.74), CFrame.new(0, 0.7, 0) * UPRIGHT, straw:Lerp(rgb(255, 255, 255), 0.1), M.SmoothPlastic, CYL)
	for i = 0, 2 do
		local a = math.rad(i * 130 + 25)
		add("Bite2", Vector3.new(0.14, 0.24, 0.14), CFrame.new(math.sin(a) * 0.3, 0.6, math.cos(a) * 0.3), straw, M.SmoothPlastic, BALL)
	end
	-- boule du haut (pistache) + vermicelles + cerise
	local pist = rgb(176, 222, 160)
	add("Bite1", Vector3.new(0.6, 0.54, 0.6), CFrame.new(0.02, 1.36, 0), pist, M.SmoothPlastic, BALL)
	add("Bite1", Vector3.new(0.1, 0.62, 0.62), CFrame.new(0.02, 1.16, 0) * UPRIGHT, pist:Lerp(rgb(255, 255, 255), 0.1), M.SmoothPlastic, CYL)
	local sprinkle = { rgb(236, 72, 120), rgb(80, 170, 255), rgb(255, 214, 60), rgb(255, 255, 255) }
	for i = 0, 6 do
		local a = math.rad(i * 51)
		local p = CFrame.new(math.sin(a) * 0.2, 1.56 - (i % 2) * 0.05, math.cos(a) * 0.2)
		add("Bite1", Vector3.new(0.08, 0.025, 0.025), p * CFrame.Angles(0, a, math.rad(30)), sprinkle[i % 4 + 1], M.SmoothPlastic)
	end
	add("Bite1", Vector3.new(0.17, 0.17, 0.17), CFrame.new(0.04, 1.69, 0), rgb(200, 24, 44), M.SmoothPlastic, BALL)
	add("Bite1", Vector3.new(0.025, 0.16, 0.025), CFrame.new(0.07, 1.8, 0) * CFrame.Angles(0, 0, math.rad(-20)), rgb(90, 130, 60), M.Wood)
end

-- Barbe à papa : bâton blanc + nuage duveteux (boules qui se chevauchent,
-- légèrement translucides, deux roses)
RECIPES.CandyFloss = function(add)
	add("Handle", Vector3.new(0.7, 0.09, 0.09), CFrame.new(0, 0.05, 0) * UPRIGHT, rgb(250, 246, 238), M.Wood, CYL)
	add("Stick", Vector3.new(0.5, 0.08, 0.08), CFrame.new(0, 0.6, 0) * UPRIGHT, rgb(250, 246, 238), M.Wood, CYL)
	local pinks = { rgb(255, 184, 214), rgb(255, 204, 226), rgb(248, 170, 206) }
	local puffs = {
		{ 3, Vector3.new(0, 1.05, 0), 0.72 }, { 3, Vector3.new(0.24, 0.95, 0.12), 0.5 }, { 3, Vector3.new(-0.22, 0.98, -0.1), 0.52 },
		{ 2, Vector3.new(0.18, 1.35, 0.14), 0.62 }, { 2, Vector3.new(-0.2, 1.32, 0.02), 0.6 }, { 2, Vector3.new(0.02, 1.28, -0.24), 0.52 },
		{ 1, Vector3.new(0.02, 1.62, 0.02), 0.58 }, { 1, Vector3.new(0.22, 1.56, -0.12), 0.42 }, { 1, Vector3.new(-0.18, 1.58, 0.16), 0.44 },
	}
	for i, pf in ipairs(puffs) do
		local p = add("Bite" .. pf[1], Vector3.one * pf[3], CFrame.new(pf[2]), pinks[i % #pinks + 1], M.Fabric, BALL)
		p.Transparency = 0.08
	end
end

-- Churros : cornet en papier rayé, 3 churros cannelés (étoile), sucre
RECIPES.Churros = function(add)
	add("Handle", Vector3.new(0.5, 0.42, 0.42), CFrame.new(0, 0, 0) * UPRIGHT, rgb(255, 250, 244), M.SmoothPlastic, CYL)
	add("Band", Vector3.new(0.12, 0.44, 0.44), CFrame.new(0, 0.08, 0) * UPRIGHT, rgb(226, 60, 80), M.SmoothPlastic, CYL)
	add("Band", Vector3.new(0.06, 0.44, 0.44), CFrame.new(0, -0.14, 0) * UPRIGHT, rgb(226, 60, 80), M.SmoothPlastic, CYL)
	local gold = rgb(206, 138, 70)
	local sugar = rgb(250, 240, 226)
	for i, s in ipairs({ { -0.09, 0.02, 7 }, { 0.1, 0.04, -6 }, { 0, -0.1, 1 } }) do
		local base = CFrame.new(s[1], 0.25, s[2]) * CFrame.Angles(math.rad(s[2] * 40), 0, math.rad(s[3]))
		for k, seg in ipairs({ { "Churro", 0.25 }, { "Bite2", 0.7 }, { "Bite1", 1.1 } }) do
			local name = seg[1]
			if i == 3 and k == 3 then
				name = "Bite2"
			end
			local c = base * CFrame.new(0, seg[2], 0)
			add(name, Vector3.new(0.14, 0.42, 0.14), c, gold, M.SmoothPlastic)
			add(name, Vector3.new(0.14, 0.42, 0.14), c * CFrame.Angles(0, math.rad(45), 0), gold:Lerp(rgb(160, 96, 50), 0.25), M.SmoothPlastic)
			add(name, Vector3.new(0.06, 0.04, 0.06), c * CFrame.new(0.05, 0.1 * k, 0.05), sugar, M.Sand)
		end
	end
end

-- Popcorn : boîte évasée rayée rouge / blanc, étiquette, grains qui débordent
RECIPES.Popcorn = function(add)
	add("Handle", Vector3.new(0.62, 0.72, 0.5), CFrame.new(0, 0, 0), rgb(255, 252, 246), M.SmoothPlastic)
	for _, x in ipairs({ -0.21, 0, 0.21 }) do
		add("Stripe", Vector3.new(0.09, 0.77, 0.55), CFrame.new(x, 0, 0), rgb(214, 36, 50), M.SmoothPlastic)
	end
	add("Rim", Vector3.new(0.68, 0.06, 0.56), CFrame.new(0, 0.37, 0), rgb(214, 36, 50), M.SmoothPlastic)
	add("Label", Vector3.new(0.4, 0.2, 0.02), CFrame.new(0, 0.05, -0.26), rgb(255, 214, 60), M.SmoothPlastic)
	local corn = { rgb(255, 248, 228), rgb(255, 236, 184), rgb(252, 244, 214) }
	local spots = {
		{ -0.2, 0.44, -0.12, 4 }, { 0.18, 0.45, 0.1, 4 }, { 0, 0.47, 0, 4 }, { -0.12, 0.45, 0.14, 4 }, { 0.2, 0.46, -0.14, 4 },
		{ -0.16, 0.56, 0.02, 3 }, { 0.12, 0.57, -0.04, 3 }, { 0.02, 0.58, 0.12, 3 }, { -0.04, 0.58, -0.14, 3 },
		{ 0.08, 0.68, 0.04, 2 }, { -0.1, 0.67, -0.04, 2 }, { 0.16, 0.66, 0.12, 2 },
		{ 0, 0.77, 0, 1 }, { -0.08, 0.75, 0.09, 1 }, { 0.09, 0.74, -0.08, 1 },
	}
	for i, s in ipairs(spots) do
		local size = 0.16 + (i % 3) * 0.035
		add("Bite" .. s[4], Vector3.new(size, size * 0.85, size), CFrame.new(s[1], s[2], s[3]) * CFrame.Angles(i, i * 2, 0), corn[i % 3 + 1], M.SmoothPlastic, BALL)
	end
end


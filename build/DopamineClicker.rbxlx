		ZIndex = 2,
	}, SKIN, ROUND)
	hero.Blush = frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.62),
		Size = UDim2.fromScale(0.3, 0.16),
		BackgroundColor3 = rgb(255, 128, 140),
		BackgroundTransparency = 0.35,
		ZIndex = 1,

----------------------------------------------------------------------
-- 🍦 Nourriture de Dopamine Town (v9.8, FAIR98 ; FoodService) : achetée
-- aux stands (place, fête foraine, coin gourmand), tenue en main, mangée
-- bouchée par bouchée ; la dernière bouchée donne un BOOST de Dopamine
-- (x Multiplier pendant Duration s, vérifié par le serveur).
--   Prix : PriceFactor x la valeur du boost ((Multiplier - 1) x Duration
--          secondes de production), au moins MinPrice : manger rapporte
--          un peu plus que ça ne coûte, sans remplacer les Game Passes.
--   Cumul (FoodRules.Stack) : un seul boost "nourriture" à la fois ; un
--          aliment plus fort remplace le multiplicateur (le reste est
--          converti), un aliment moins fort ou égal prolonge (converti) ;
--          jamais plus de MaxSeconds restantes, jamais plus que MaxMultiplier.
--   Items : Id, Name, Icon, Multiplier, Duration (s), Bites (bouchées),
--           Color / Crumb (miettes), Desc
----------------------------------------------------------------------
Config.Food = {
	PriceFactor = 0.7,
	MinPrice = 40,
	MaxSeconds = 300,
	MaxMultiplier = 2,
	BiteCooldown = 0.55, -- s entre deux bouchées
	BuyCooldown = 1.5, -- s entre deux achats
	BuyDistance = 16, -- studs max entre l'avatar et le stand
	Items = {
		{ Id = "IceCream", Name = "Ice cream cone", Icon = "🍦", Multiplier = 1.5, Duration = 90, Bites = 4,
			Color = Color3.fromRGB(255, 176, 206), Crumb = Color3.fromRGB(226, 176, 112), Desc = "Two scoops, strawberry and mint" },
		{ Id = "CandyFloss", Name = "Candy floss", Icon = "🍭", Multiplier = 1.5, Duration = 120, Bites = 4,
			Color = Color3.fromRGB(255, 190, 224), Crumb = Color3.fromRGB(255, 200, 230), Desc = "A pink cloud on a stick" },
		{ Id = "Churros", Name = "Churros", Icon = "🥖", Multiplier = 1.4, Duration = 150, Bites = 3,
			Color = Color3.fromRGB(214, 150, 80), Crumb = Color3.fromRGB(236, 196, 120), Desc = "Crunchy, with sugar and cinnamon" },
		{ Id = "Popcorn", Name = "Popcorn", Icon = "🍿", Multiplier = 1.3, Duration = 180, Bites = 5,
			Color = Color3.fromRGB(255, 244, 214), Crumb = Color3.fromRGB(255, 240, 190), Desc = "A striped box of buttery popcorn" },
		{ Id = "Crepe", Name = "Crêpe", Icon = "🥞", Multiplier = 1.6, Duration = 120, Bites = 4,
			Color = Color3.fromRGB(236, 196, 130), Crumb = Color3.fromRGB(120, 76, 50), Desc = "Rolled crêpe with chocolate" },
		{ Id = "PizzaSlice", Name = "Pizza slice", Icon = "🍕", Multiplier = 1.8, Duration = 90, Bites = 4,
			Color = Color3.fromRGB(255, 206, 110), Crumb = Color3.fromRGB(214, 90, 60), Desc = "Cheesy slice with pepperoni" },
		{ Id = "Taco", Name = "Taco", Icon = "🌮", Multiplier = 1.8, Duration = 100, Bites = 4,
			Color = Color3.fromRGB(240, 196, 100), Crumb = Color3.fromRGB(110, 190, 90), Desc = "Crispy shell, salad and tomato" },
		{ Id = "Milkshake", Name = "Milkshake", Icon = "🥤", Multiplier = 2, Duration = 60, Bites = 4,
			Color = Color3.fromRGB(255, 200, 220), Crumb = Color3.fromRGB(255, 236, 244), Desc = "Strawberry shake with whipped cream" },
		{ Id = "HotDog", Name = "Hot dog", Icon = "🌭", Multiplier = 1.6, Duration = 150, Bites = 4,
			Color = Color3.fromRGB(226, 110, 80), Crumb = Color3.fromRGB(236, 190, 120), Desc = "With mustard and ketchup" },
		{ Id = "CandyApple", Name = "Candy apple", Icon = "🍎", Multiplier = 1.4, Duration = 180, Bites = 3,
			Color = Color3.fromRGB(214, 36, 56), Crumb = Color3.fromRGB(255, 120, 130), Desc = "A shiny red caramel apple" },
		{ Id = "Donut", Name = "Donut", Icon = "🍩", Multiplier = 1.5, Duration = 120, Bites = 3,
			Color = Color3.fromRGB(255, 150, 196), Crumb = Color3.fromRGB(214, 160, 100), Desc = "Pink glaze and sprinkles" },
	},
}
Config.FoodById = {}
for index, food in ipairs(Config.Food.Items) do
	food.Order = index
	Config.FoodById[food.Id] = food
end

----------------------------------------------------------------------
-- 🏁 Courses de rue (v10, RACE10 ; RaceService / Shared/RaceRules /
-- Shared/RaceRoutes / Client/World/RaceClient) : 2 à 8 coureurs, des
-- pilotes IA complètent la grille jusqu'à MinGrid. Vitesses en studs/s.
--   Récompenses : secondes de production (Formulas.ScaledReward) selon la
--   place, x (1 + HumanBonus par adversaire humain, au plus MaxHumanBonus),
--   x SoloFactor sans adversaire humain ; DailyRewarded courses payées par
--   jour (ensuite : records et trophées seulement). Voir RaceRules.
--   Anti-triche (serveur) : ordre des portes, temps minimal par tronçon,
--   vitesse plausible, téléportation, être au volant de sa voiture.
----------------------------------------------------------------------
Config.Race = {
	MaxRacers = 8,
	MinGrid = 4, -- IA ajoutées jusqu'à 4 voitures sur la grille
	LobbySeconds = 20, -- attente après la 1re inscription
	LateJoinSeconds = 8, -- une inscription tardive laisse au moins 8 s
	GridSeconds = 3, -- mise en place sur la grille avant le 3-2-1
	CountdownSeconds = 3,
	FinishGrace = 35, -- s laissées aux autres après le 1er humain arrivé
	MaxSeconds = 480, -- durée max d'une course
	JoinRange = 45, -- studs : distance max du point de rendez-vous (à pied)
	ResetCooldown = 3, -- s entre deux "retour à la porte"
	OffCarGrace = 5, -- s hors de sa voiture -> abandon
	CheckpointSpacing = 170, -- studs entre deux portes
	Rewards = {
		Seconds = { 120, 80, 55 }, -- 1er, 2e, 3e (secondes de production)
		FinishSeconds = 35, -- arrivé 4e ou plus
		MinReward = 250,
		HumanBonus = 0.1, -- +10 % par adversaire humain
		MaxHumanBonus = 0.3,
		SoloFactor = 0.75, -- seulement des IA en face
		DailyRewarded = 8, -- courses récompensées par jour
	},
	Anti = {
		SpeedMargin = 1.3, -- vitesse mesurée max = vitesse de pointe x 1,3 (+ AbsSlack)
		AbsSlack = 8,
		TeleportStuds = 70, -- saut instantané -> remis à la dernière porte
		MaxStrikes = 3, -- au 3e saut : disqualifié
		SegmentFactor = 1.15, -- tronçon plus rapide que longueur / (pointe x 1,15) : disqualifié
	},
	AI = {
		LatAccel = 30, -- (studs/s²) virages
		Brake = 38, -- (studs/s²) freinage anticipé
		Skill = { 0.9, 0.93, 0.95, 0.97, 0.91, 0.94, 0.96 },
		RubberBoost = 0.06, -- au plus +6 % derrière le 1er humain (jamais au-delà de sa vitesse de pointe)
		RubberSlow = 0.1, -- au plus -10 % devant tous les humains
		RubberRange = 500, -- (studs) écart pour l'effet maximal
		FairFinish = 0.12, -- aucun élastique dans les derniers 12 % de la course
		Names = { "Nina Turbo", "Max Vroom", "Lou Drift", "Sam Nitro", "Zoé Flash", "Téo Pistons", "Lina Rocket" },
	},
	Routes = {
		{ Id = "City", Name = "City circuit", Icon = "🏙️", Laps = 2, Desc = "Two laps around downtown" },
		{ Id = "Highway", Name = "Highway sprint", Icon = "🛣️", Laps = 1, Sprint = true, Desc = "Flat out on the highway" },
		{ Id = "Districts", Name = "District loop", Icon = "🏘️", Laps = 1, Desc = "Through every district" },
		{ Id = "Night", Name = "Night race", Icon = "🌙", Laps = 1, Night = true, Desc = "The grand tour, under the stars" },
	},
}
Config.RaceRoutesById = {}
for index, route in ipairs(Config.Race.Routes) do
	route.Order = index
	Config.RaceRoutesById[route.Id] = route
end

----------------------------------------------------------------------
-- Index calculés automatiquement (ne pas modifier)
----------------------------------------------------------------------
Config.UpgradesById = {}
Config.FeatureToUpgrade = {} -- [Feature] = Id de l'amélioration qui la débloque
for index, upgrade in ipairs(Config.Upgrades) do
	upgrade.Order = index
	upgrade.CostGrowth = upgrade.CostGrowth or 1
	Config.UpgradesById[upgrade.Id] = upgrade
	if upgrade.Feature then
		Config.FeatureToUpgrade[upgrade.Feature] = upgrade.Id
	end
end

Config.AchievementsById = {}
for _, achievement in ipairs(Config.Achievements) do
	achievement.BadgeId = achievement.BadgeId or Config.AchievementBadges[achievement.Id] or 0
	Config.AchievementsById[achievement.Id] = achievement
end

Config.CosmeticsById = {}
for index, cosmetic in ipairs(Config.Cosmetics) do
	cosmetic.Order = index
	Config.CosmeticsById[cosmetic.Id] = cosmetic
end

Config.ThemesById = {}
for index, theme in ipairs(Config.Themes) do
	theme.Order = index
	Config.ThemesById[theme.Id] = theme
end

Config.GamePassesById = {}
for _, pass in ipairs(Config.Monetization.GamePasses) do
	Config.GamePassesById[pass.Id] = pass
end

Config.ProductsById = {}
Config.ProductsByProductId = {} -- [ProductId Roblox] = offre
for _, product in ipairs(Config.Monetization.Products) do
	Config.ProductsById[product.Id] = product
	if product.ProductId ~= 0 then
		Config.ProductsByProductId[product.ProductId] = product
	end
end

-- true si au moins une offre Robux est configurée (ID ~= 0)
Config.IsSellingForRobux = false
for _, pass in ipairs(Config.Monetization.GamePasses) do
	if pass.GamePassId ~= 0 then
		Config.IsSellingForRobux = true
	end
end
for _, product in ipairs(Config.Monetization.Products) do
	if product.ProductId ~= 0 then
		Config.IsSellingForRobux = true
	end
end
for _, theme in ipairs(Config.Themes) do
	if theme.GamePassId ~= 0 then
		Config.IsSellingForRobux = true
	end
end

Config.CasinoSymbolsById = {}
for _, symbol in ipairs(Config.Casino.Symbols) do
	Config.CasinoSymbolsById[symbol.Id] = symbol
end

-- 🏠 Maison
Config.HouseSizesById = {}
for index, size in ipairs(Config.House.Sizes) do
	size.Order = index -- plus grand = plus grande maison
	size.MaxRooms = size.Floors * size.Columns
	Config.HouseSizesById[size.Id] = size
end

-- Types de pièces : objets / catégories préférés en tables { [id] = true }
Config.HouseRoomTypesById = {}
for index, roomType in ipairs(Config.House.RoomTypes) do
	roomType.Order = index
	roomType.FavoriteCategories = {}
	for _, categoryId in ipairs(roomType.Categories) do
		roomType.FavoriteCategories[categoryId] = true
	end
	roomType.FavoriteItems = {}
	for _, itemId in ipairs(roomType.Items) do
		roomType.FavoriteItems[itemId] = true
	end
	Config.HouseRoomTypesById[roomType.Id] = roomType
end

Config.HouseWallpapersById = {}
for index, wallpaper in ipairs(Config.House.Wallpapers) do
	wallpaper.Order = index
	Config.HouseWallpapersById[wallpaper.Id] = wallpaper
end

Config.HouseFloorsById = {}
for index, floor in ipairs(Config.House.Floors) do
	floor.Order = index
	Config.HouseFloorsById[floor.Id] = floor
end

Config.HouseCategoriesById = {}
for index, category in ipairs(Config.House.Categories) do
	category.Order = index
	Config.HouseCategoriesById[category.Id] = category
end

Config.HouseItemsById = {}
Config.HouseItemsByCategory = {} -- [categoryId] = { objets dans l'ordre de la config }
for _, category in ipairs(Config.House.Categories) do
	Config.HouseItemsByCategory[category.Id] = {}
end
for index, item in ipairs(Config.House.Items) do
	item.Order = index
	item.CostGrowth = item.CostGrowth or 1
	Config.HouseItemsById[item.Id] = item
	local list = Config.HouseItemsByCategory[item.Category]
	if list then
		table.insert(list, item)
	end
end

-- (v9.1) Personnalisation : un "genre" par axe. Scope "Room" = choisi par
-- pièce (champ Field de la pièce), "House" = toute la maison (champ Field de
-- data.House), "Garden" = liste de déco du jardin ; Owned = table des
-- entrées achetées dans data.House ; la 1re entrée de chaque liste est
-- gratuite (Cost 0) sauf pour le jardin
Config.HouseLookKinds = {
	Trim = { List = Config.House.Trims, Owned = "OwnedTrims", Scope = "Room", Field = "Trim" },
	Mood = { List = Config.House.Moods, Owned = "OwnedMoods", Scope = "Room", Field = "Mood" },
	View = { List = Config.House.Views, Owned = "OwnedViews", Scope = "Room", Field = "View" },
	Facade = { List = Config.House.Facades, Owned = "OwnedFacades", Scope = "House", Field = "Facade" },
	Roof = { List = Config.House.Roofs, Owned = "OwnedRoofs", Scope = "House", Field = "Roof" },
	RoofStyle = { List = Config.House.RoofStyles, Owned = "OwnedRoofStyles", Scope = "House", Field = "RoofStyle" },
	Garden = { List = Config.House.GardenDecor, Owned = "OwnedGarden", Scope = "Garden", Field = "Garden" },
}
Config.HouseLooksById = {} -- [kind] = { [id] = entrée }
for kind, def in pairs(Config.HouseLookKinds) do
	local byId = {}
	for index, entry in ipairs(def.List) do
		entry.Order = index
		entry.Cost = entry.Cost or 0
		byId[entry.Id] = entry
	end
	def.ById = byId
	def.Kind = kind
	Config.HouseLooksById[kind] = byId
end
-- (v9.3) Paliers des visites à l'océan de la maison (Config.House.RebirthGates) :
-- chaque objet / style sans RequiresRebirths reçoit le palier de son prix de
-- base, puis son prix est multiplié par le Price du palier. Fait UNE fois ici
-- (serveur et client voient les mêmes prix ; BaseCost = prix d'origine).
do
	local gates = Config.House.RebirthGates
	local function priceFor(rebirths: number): number
		local price = 1
		for _, gate in ipairs(gates) do
			if rebirths >= gate.Rebirths then
				price = gate.Price or price
			end
		end
		return price
	end
	local function applyGate(entry)
		if type(entry) ~= "table" or type(entry.Cost) ~= "number" or entry.BaseCost ~= nil then
			return
		end
		entry.BaseCost = entry.Cost
		local rebirths = tonumber(entry.RequiresRebirths)
		if not rebirths then
			rebirths = 0
			for _, gate in ipairs(gates) do
				if entry.Cost >= gate.Cost then
					rebirths = math.max(rebirths, gate.Rebirths)
				end
			end
			entry.RequiresRebirths = rebirths
		end
		if entry.Cost > 0 then
			-- arrondi à 2 chiffres significatifs (prix lisibles)
			local price = entry.Cost * priceFor(rebirths)
			local unit = 10 ^ math.max(0, math.floor(math.log10(price)) - 1)
			entry.Cost = math.floor(price / unit + 0.5) * unit
		end
	end
	for _, item in ipairs(Config.House.Items) do
		applyGate(item)
	end
	for _, entry in ipairs(Config.House.Wallpapers) do
		applyGate(entry)
	end
	for _, entry in ipairs(Config.House.Floors) do
		applyGate(entry)
	end
	for _, def in pairs(Config.HouseLookKinds) do
		for _, entry in ipairs(def.List) do
			applyGate(entry)
		end
	end
end

Config.HouseTrimsById = Config.HouseLooksById.Trim
Config.HouseMoodsById = Config.HouseLooksById.Mood
Config.HouseViewsById = Config.HouseLooksById.View
Config.HouseTintsById = {}
for index, tint in ipairs(Config.House.Tints) do
	tint.Order = index
	Config.HouseTintsById[tint.Id] = tint
end

-- 🚗 Voitures (v9.6)
Config.CarsById = {}
for index, car in ipairs(Config.Cars.List) do
	car.Order = index
	Config.CarsById[car.Id] = car
end
Config.CarColorsById = {}
for index, paint in ipairs(Config.Cars.Colors) do
	paint.Order = index
	Config.CarColorsById[paint.Id] = paint
end
-- (v10, CARS10) options de l'atelier : [kind][id] = entrée ; pièces de préparation
Config.CarModsById = {}
for kind, list in pairs(Config.Cars.Mods) do
	local byId = {}
	for index, entry in ipairs(list) do
		entry.Order = index
		entry.Kind = kind
		byId[entry.Id] = entry
	end
	Config.CarModsById[kind] = byId
end
Config.CarTuningById = {}
for index, part in ipairs(Config.Cars.Tuning.Parts) do
	part.Order = index
	Config.CarTuningById[part.Id] = part
end

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="252">
        <Properties>
          <string name="Name">DVDMath</string>
          <string name="Source"><![CDATA[--[[
	DVDMath (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > DVDMath

	Mathématiques du logo DVD, partagées entre serveur et client.

	Le mouvement est DÉTERMINISTE : à partir de quelques paramètres
	(position de départ, vitesse, heure de départ), on peut calculer la
	position exacte à n'importe quel instant. Avantages :
	  - mouvement parfaitement fluide, quel que soit le nombre d'images/s ;
	  - le serveur peut vérifier qu'un "coin touché" est réel (anti-triche).

	Coordonnées normalisées : 0 = bord gauche/haut, 1 = bord droit/bas.
	Le coin haut-gauche du logo se déplace dans [0, 1 - largeurLogo].
]]

local DVDMath = {}

export type Params = {
	X0: number, -- position de départ (normalisée)
	Y0: number,
	VX: number, -- vitesse (fraction d'écran par seconde, signe = direction)
	VY: number,
	T0: number, -- heure serveur de départ (workspace:GetServerTimeNow())
	W: number, -- taille du logo (fraction de l'écran)
	H: number,
}

-- "Onde triangle" : fait rebondir une valeur qui avance tout droit entre 0 et range
function DVDMath.Triangle(u: number, range: number): number
	if range <= 0 then
		return 0
	end
	local m = u % (2 * range) -- toujours positif en Luau
	if m <= range then
		return m
	end
	return 2 * range - m
end

function DVDMath.Ranges(params: Params): (number, number)
	return math.max(0.001, 1 - params.W), math.max(0.001, 1 - params.H)
end

-- Distance "dépliée" parcourue (sans rebond) sur chaque axe au temps t
function DVDMath.Unfolded(params: Params, t: number): (number, number)
	local dt = t - params.T0
	return params.X0 + params.VX * dt, params.Y0 + params.VY * dt
end

-- Position réelle (avec rebonds) au temps t
function DVDMath.Position(params: Params, t: number): (number, number)
	local rangeX, rangeY = DVDMath.Ranges(params)
	local u, v = DVDMath.Unfolded(params, t)
	return DVDMath.Triangle(u, rangeX), DVDMath.Triangle(v, rangeY)
end

-- Numéro du "segment" entre deux rebonds sur chaque axe.
-- Quand ce numéro change, le logo vient de rebondir.
function DVDMath.BounceIndex(params: Params, t: number): (number, number)
	local rangeX, rangeY = DVDMath.Ranges(params)
	local u, v = DVDMath.Unfolded(params, t)
	return math.floor(u / rangeX), math.floor(v / rangeY)
end

-- Heure exacte du rebond horizontal numéro k (quand u = k * rangeX)
function DVDMath.BounceTimeX(params: Params, k: number): number
	local rangeX = DVDMath.Ranges(params)
	return params.T0 + (k * rangeX - params.X0) / params.VX
end

-- Au moment du rebond horizontal k, le logo est-il aussi contre un bord
-- vertical ? Si oui : COIN !
function DVDMath.IsCornerAtBounceX(params: Params, k: number, tolerance: number): boolean
	local _, rangeY = DVDMath.Ranges(params)
	local t = DVDMath.BounceTimeX(params, k)
	local _, y = DVDMath.Position(params, t)
	return y <= tolerance or y >= rangeY - tolerance
end

-- Direction actuelle (+1 / -1) sur chaque axe, utile pour garder la
-- continuité quand l'écran change de taille
function DVDMath.Directions(params: Params, t: number): (number, number)
	local rangeX, rangeY = DVDMath.Ranges(params)
	local u, v = DVDMath.Unfolded(params, t)
	local dirX = (u % (2 * rangeX) <= rangeX) and 1 or -1
	local dirY = (v % (2 * rangeY) <= rangeY) and 1 or -1
	return dirX * math.sign(params.VX), dirY * math.sign(params.VY)
end

return DVDMath
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="253">
        <Properties>
          <string name="Name">DeskRunnerLogic</string>
          <string name="Source"><![CDATA[--[[
	DeskRunnerLogic (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > DeskRunnerLogic

	v9.8 🎮 Logique PURE du "Desk Runner", le jeu de course façon Subway
	jouable sur l'écran du bureau gamer (Client > World > DeskGames). Aucune
	instance, aucun service : la MÊME simulation tourne sur le client (le
	jeu) et sur le serveur (Services > Arcade > SoloGames : rejeu de la
	partie, anti-triche comme le Snake de l'arcade).

	Monde (unités = "mètres" du jeu) :
	  - 3 voies (-1, 0, 1) ; le coureur est à la distance D de la piste ;
	  - obstacles posés à une position absolue P de la piste :
	      "Train"  : bloque la voie (on change de voie) ;
	      "Low"    : barrière basse (on saute) ;
	      "High"   : portique haut (on roule dessous) ;
	      "Coin"   : pièce (ramassée si on passe dans la voie) ;
	  - pas fixe de TICK secondes ; la vitesse augmente avec le temps.
	Entrées (une par pas au plus) : 1 = gauche, 2 = droite, 3 = saut, 4 = roulade.
	Score = distance + 10 x pièces.

	API :
	  DeskRunnerLogic.New(seed) -> State
	  DeskRunnerLogic.Input(state, action) -> boolean   (appliquée au pas suivant)
	  DeskRunnerLogic.Step(state) -> string?            ("crash", "coin" ou nil)
	  DeskRunnerLogic.Height(state) -> number           (hauteur du saut)
	  DeskRunnerLogic.Replay(seed, inputs, ticks) -> (score, coins, distance, played, minDuration)
	  DeskRunnerLogic.Stars(score) -> (stars, progress)
	  DeskRunnerLogic.Rules / GameRules                 (règles "arcade" : difficulté Normal)
]]

local DeskRunnerLogic = {}

local TICK = 1 / 30
local BASE_SPEED = 11 -- m/s au départ
local MAX_SPEED = 24
local SPEED_RAMP = 0.12 -- m/s gagnés par seconde
local JUMP_TICKS = 19 -- ~0,63 s en l'air
local JUMP_HEIGHT = 1.6
local CLEAR_HEIGHT = 0.75 -- hauteur pour passer une barrière basse
local ROLL_TICKS = 18 -- ~0,6 s au ras du sol
local HALF_BODY = 0.4 -- demi-profondeur du coureur
local AHEAD = 95 -- génération jusqu'à D + AHEAD
local BEHIND = 12 -- nettoyage derrière le coureur
local TRAIN_LEN = 9
local BAR_LEN = 0.6
local COIN_POINTS = 10
local MAX_TICKS = 18000 -- 10 minutes

DeskRunnerLogic.TICK = TICK
DeskRunnerLogic.MAX_TICKS = MAX_TICKS
DeskRunnerLogic.JUMP_HEIGHT = JUMP_HEIGHT
DeskRunnerLogic.TRAIN_LEN = TRAIN_LEN
DeskRunnerLogic.COIN_POINTS = COIN_POINTS
DeskRunnerLogic.Actions = { Left = 1, Right = 2, Jump = 3, Roll = 4 }

-- Règles au format de l'arcade (Solo_Logic.Games / SoloGames)
DeskRunnerLogic.GameRules = {
	Name = "Desk Runner",
	Icon = "🏃",
	MaxTicks = MAX_TICKS,
	Hidden = true, -- jamais listé dans le panneau Arcade (joué au bureau gamer)
	Difficulties = {
		Normal = { Thresholds = { 400, 1000, 2000 } },
	},
}
DeskRunnerLogic.Rules = DeskRunnerLogic.GameRules.Difficulties.Normal

----------------------------------------------------------------------
-- Hasard déterministe (xorshift32, identique client / serveur)
----------------------------------------------------------------------

type Rng = { State: number }

local function newRng(seed: number): Rng
	local state = math.floor(tonumber(seed) or 1) % 4294967296
	if state ~= state or state <= 0 then
		state = 2463534242
	end
	local rng = { State = state }
	for _ = 1, 6 do
		local s = rng.State
		s = bit32.bxor(s, bit32.lshift(s, 13))
		s = bit32.bxor(s, bit32.rshift(s, 17))
		s = bit32.bxor(s, bit32.lshift(s, 5))
		rng.State = s
	end
	return rng
end

local function nextFloat(rng: Rng): number
	local s = rng.State
	s = bit32.bxor(s, bit32.lshift(s, 13))
	s = bit32.bxor(s, bit32.rshift(s, 17))
	s = bit32.bxor(s, bit32.lshift(s, 5))
	rng.State = s
	return s / 4294967296
end

local function nextInt(rng: Rng, a: number, b: number): number
	if b <= a then
		return a
	end
	return a + math.floor(nextFloat(rng) * (b - a + 1))
end

----------------------------------------------------------------------
-- État
----------------------------------------------------------------------

export type Obstacle = { Id: number, Kind: string, Lane: number, P: number, Len: number, Taken: boolean, Y: number }

export type State = {
	Rng: Rng,
	Tick: number,
	Distance: number,
	Speed: number,
	Lane: number,
	JumpTick: number, -- pas écoulés depuis le début du saut (-1 = au sol)
	RollTick: number, -- pas restants de roulade (0 = debout)
	Coins: number,
	Score: number,
	Alive: boolean,
	Pending: number?, -- entrée à appliquer au prochain pas
	Obstacles: { Obstacle },
	NextRow: number, -- position de la prochaine rangée d'obstacles
	NextId: number,
	Crash: string?, -- cause du choc ("Train" | "Low" | "High")
	Row: number, -- rangées générées
}

function DeskRunnerLogic.New(seed: number): State
	return {
		Rng = newRng(seed),
		Tick = 0,
		Distance = 0,
		Speed = BASE_SPEED,
		Lane = 0,
		JumpTick = -1,
		RollTick = 0,
		Coins = 0,
		Score = 0,
		Alive = true,
		Pending = nil,
		Obstacles = {},
		NextRow = 34, -- quelques mètres tranquilles au départ
		NextId = 0,
		Crash = nil,
		Row = 0,
	}
end

local function add(s: State, kind: string, lane: number, p: number, len: number, y: number?)
	s.NextId += 1
	table.insert(s.Obstacles, { Id = s.NextId, Kind = kind, Lane = lane, P = p, Len = len, Taken = false, Y = y or 0 })
end

-- Une rangée : au moins une voie praticable ; trains, barrières, pièces
local function generateRow(s: State)
	local rng = s.Rng
	local p = s.NextRow
	s.Row += 1
	local early = s.Row <= 3
	local kinds = { "Free", "Free", "Free" }
	-- trains (jamais sur les 3 voies ; pas dans les 3 premières rangées)
	local trains = 0
	if not early then
		local roll = nextFloat(rng)
		trains = roll < 0.3 and 0 or (roll < 0.78 and 1 or 2)
	end
	local lanes = { -1, 0, 1 }
	for _ = 1, trains do
		local index = nextInt(rng, 1, #lanes)
		local lane = table.remove(lanes, index)
		kinds[lane + 2] = "Train"
	end
	-- barrières sur les voies restantes (une voie reste toujours libre de tout)
	local freeLane = lanes[nextInt(rng, 1, #lanes)]
	for _, lane in ipairs(lanes) do
		if lane ~= freeLane then
			local roll = nextFloat(rng)
			if roll < 0.42 then
				kinds[lane + 2] = "Low"
			elseif roll < 0.68 then
				kinds[lane + 2] = "High"
			end
		end
	end
	-- parfois la voie libre a aussi une barrière (il faut sauter / rouler)
	if not early and nextFloat(rng) < 0.35 then
		kinds[freeLane + 2] = nextFloat(rng) < 0.55 and "Low" or "High"
	end
	for index, kind in ipairs(kinds) do
		local lane = index - 2
		if kind == "Train" then
			add(s, "Train", lane, p, TRAIN_LEN)
		elseif kind == "Low" or kind == "High" then
			add(s, kind, lane, p, BAR_LEN)
		end
	end
	-- pièces : une file dans une voie sans train (en arc au-dessus d'une barrière basse)
	local coinLanes = {}
	for index, kind in ipairs(kinds) do
		if kind ~= "Train" then
			table.insert(coinLanes, index - 2)
		end
	end
	if #coinLanes > 0 and nextFloat(rng) < 0.8 then
		local lane = coinLanes[nextInt(rng, 1, #coinLanes)]
		local count = nextInt(rng, 3, 6)
		local overBar = kinds[lane + 2] == "Low"
		for k = 1, count do
			local cp = p - (count - k) * 1.8 + (overBar and (count / 2) * 1.8 or -2)
			local y = 0
			if overBar then
				local t = (k - 0.5) / count
				y = 4 * t * (1 - t) * 1.2
			end
			add(s, "Coin", lane, cp, 0, y)
		end
	end
	-- écart jusqu'à la rangée suivante : plus on va vite, plus il est grand
	s.NextRow = p + 15 + s.Speed * 0.42 + nextFloat(rng) * 6
end

function DeskRunnerLogic.Height(s: State): number
	if s.JumpTick < 0 then
		return 0
	end
	local t = math.clamp(s.JumpTick / JUMP_TICKS, 0, 1)
	return 4 * JUMP_HEIGHT * t * (1 - t)
end

function DeskRunnerLogic.Input(s: State, action: any): boolean
	if not s.Alive or type(action) ~= "number" or action < 1 or action > 4 or action % 1 ~= 0 then
		return false
	end
	s.Pending = action
	return true
end

local function apply(s: State, action: number)
	if action == 1 then
		s.Lane = math.max(-1, s.Lane - 1)
	elseif action == 2 then
		s.Lane = math.min(1, s.Lane + 1)
	elseif action == 3 then
		if s.JumpTick < 0 then
			s.JumpTick = 0
			s.RollTick = 0
		end
	elseif action == 4 then
		-- roulade (en l'air : on redescend tout de suite)
		s.JumpTick = -1
		s.RollTick = ROLL_TICKS
	end
end

-- Un pas de simulation ; renvoie "crash", "coin" ou nil
function DeskRunnerLogic.Step(s: State): string?
	if not s.Alive then
		return "crash"
	end
	s.Tick += 1
	local pending = s.Pending
	if pending then
		s.Pending = nil
		apply(s, pending)
	end
	local seconds = s.Tick * TICK
	s.Speed = math.min(MAX_SPEED, BASE_SPEED + SPEED_RAMP * seconds)
	s.Distance += s.Speed * TICK
	if s.JumpTick >= 0 then
		s.JumpTick += 1
		if s.JumpTick >= JUMP_TICKS then
			s.JumpTick = -1
		end
	end
	if s.RollTick > 0 then
		s.RollTick -= 1
	end
	while s.NextRow < s.Distance + AHEAD do
		generateRow(s)
	end
	local height = DeskRunnerLogic.Height(s)
	local event: string? = nil
	local d = s.Distance
	local swept = s.Speed * TICK -- (balayage : rien ne passe "entre" deux pas)
	for index = #s.Obstacles, 1, -1 do
		local o = s.Obstacles[index]
		local rel = o.P - d
		if rel + o.Len < -BEHIND then
			table.remove(s.Obstacles, index)
		elseif o.Lane == s.Lane and rel < HALF_BODY and rel + o.Len + swept > -HALF_BODY then
			if o.Kind == "Coin" then
				if not o.Taken and math.abs(height - o.Y) < 1.1 then
					o.Taken = true
					s.Coins += 1
					event = event or "coin"
				end
			elseif o.Kind == "Train" or (o.Kind == "Low" and height < CLEAR_HEIGHT) or (o.Kind == "High" and s.RollTick <= 0) then
				s.Alive = false
				s.Crash = o.Kind
				event = "crash"
				break
			end
		end
	end
	s.Score = math.floor(s.Distance) + s.Coins * COIN_POINTS
	return event
end

-- Rejoue une partie : inputs = { tick1, action1, tick2, action2, ... } (ticks croissants)
function DeskRunnerLogic.Replay(seed: number, inputs: { number }, ticks: number): (number, number, number, number, number)
	local s = DeskRunnerLogic.New(seed)
	local limit = math.clamp(math.floor(tonumber(ticks) or 0), 0, MAX_TICKS)
	local k = 1
	local count = type(inputs) == "table" and #inputs or 0
	while s.Alive and s.Tick < limit do
		local nextTick = s.Tick + 1
		while k + 1 <= count and inputs[k] == nextTick do
			DeskRunnerLogic.Input(s, inputs[k + 1])
			k += 2
		end
		-- (entrée d'un pas déjà passé : journal abîmé, on l'ignore)
		while k + 1 <= count and inputs[k] < nextTick do
			k += 2
		end
		DeskRunnerLogic.Step(s)
	end
	return s.Score, s.Coins, s.Distance, s.Tick, s.Tick * TICK
end

function DeskRunnerLogic.Stars(score: number): (number, number)
	local thresholds = DeskRunnerLogic.Rules.Thresholds
	local stars = 0
	for index, threshold in ipairs(thresholds) do
		if score >= threshold then
			stars = index
		end
	end
	local progress = stars == 0 and math.clamp(score / thresholds[1], 0, 1) or 1
	return stars, progress
end

return DeskRunnerLogic
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="254">
        <Properties>
          <string name="Name">FairRides</string>
          <string name="Source"><![CDATA[--[[
	FairRides (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > FairRides

	🎡 Fête foraine de Dopamine Town (v9.8, FAIR98) : la GÉOMÉTRIE et le
	MOUVEMENT des manèges, partagés par le serveur (TownFair : sièges
	ancrés qui bougent) et le client (FairFx : le décor, et les mêmes
	sièges lissés à chaque image ; TownPlazaFx pour le manège de la place).

	Tout mouvement est une fonction PURE de l'heure du serveur
	(workspace:GetServerTimeNow()) : le serveur et tous les clients
	calculent exactement la même pose, sans rien s'envoyer. Un manège
	tourne par CYCLES : arrêt (embarquement), accélération douce, marche,
	ralentissement ; on peut monter à tout moment (invite "Monter").

	Repères :
	  - la fête : WorldLayout.FairCFrame() (centre du sol, -Z local vers la
	    place / l'entrée), coordonnées locales x ∈ [-55, 55], z ∈ [-36, 36] ;
	  - chaque manège a son repère (Base, au sol) ; Pose() remplit des
	    "groupes" (CFrame relatifs à la Base) : plateau, nacelles,
	    chevaux… ; un siège = Base * groupe * Local.
	Pas de service Roblox ici (CFrame seulement) : testable hors jeu.
]]

local FairTrack = require(script.Parent.FairTrack)

local FairRides = {}

local TAU = math.pi * 2

----------------------------------------------------------------------
-- Cycles
----------------------------------------------------------------------

export type Cycle = { Load: number, Ramp: number, Run: number }

-- Période d'un cycle (s)
function FairRides.Period(c: Cycle): number
	return c.Load + 2 * c.Ramp + c.Run
end

-- Heure t (s) -> (avance en "secondes à pleine vitesse", vitesse 0..1,
-- phase "load" | "run", secondes avant la fin de la phase)
function FairRides.Cycle(c: Cycle, t: number): (number, number, string, number)
	local P = FairRides.Period(c)
	local tm = t % P
	local n = (t - tm) / P
	local A, H, L = c.Ramp, c.Run, c.Load
	local per = A + H -- avance d'un cycle complet
	local base = (n % 100000) * per
	if tm < L then
		return base, 0, "load", L - tm
	end
	local u = tm - L
	if u < A then
		return base + u * u / (2 * A), u / A, "run", P - tm
	end
	u -= A
	if u < H then
		return base + A / 2 + u, 1, "run", P - tm
	end
	u -= H
	local left = A - u
	return base + A / 2 + H + (A / 2 - left * left / (2 * A)), left / A, "run", P - tm
end

----------------------------------------------------------------------
-- Manège à chevaux (celui de la place ET celui de la fête) : mêmes
-- emplacements (= TownPlazaFx) : 8 au bord (r 6,6, 2 carrosses) + 4 dedans
----------------------------------------------------------------------

FairRides.CAROUSEL_BOB_SPEED = TAU / 2.6 -- une montée-descente en 2,6 s
FairRides.CAROUSEL_BOB_AMP = 0.5
FairRides.PLAZA_SPIN = TAU / 16 -- manège de la place : un tour en 16 s, sans arrêt

export type Spot = { Pos: Vector3, Fwd: Vector3, Base: CFrame, Carriage: boolean, Horse: number?, Phase: number }

local spots: { Spot }? = nil
function FairRides.CarouselSpots(): { Spot }
	if spots then
		return spots
	end
	local list = {}
	local raw = {}
	for k = 0, 7 do
		table.insert(raw, { A = k / 8 * TAU, R = 6.6, Carriage = k == 0 or k == 4 })
	end
	for k = 0, 3 do
		table.insert(raw, { A = (k + 0.25) / 4 * TAU, R = 4, Carriage = false })
	end
	local horse = 0
	for _, s in ipairs(raw) do
		local pos = Vector3.new(math.sin(s.A) * s.R, 0, math.cos(s.A) * s.R)
		local fwd = Vector3.new(math.cos(s.A), 0, -math.sin(s.A)) -- sens de la rotation
		local entry: Spot = { Pos = pos, Fwd = fwd, Base = CFrame.lookAt(pos, pos + fwd), Carriage = s.Carriage, Horse = nil, Phase = 0 }
		if not s.Carriage then
			horse += 1
			entry.Horse = horse
			entry.Phase = (horse % 2) * math.pi + horse * 0.35
		end
		table.insert(list, entry)
	end
	spots = list
	return list
end
FairRides.CAROUSEL_HORSES = 10
FairRides.HORSE_Y = 2.75 -- centre du corps d'un cheval au-dessus du plateau

-- Groupes : [1] = plateau qui tourne, [1 + k] = cheval k (qui monte et descend)
local function carouselPose(theta: number, bobClock: number, amp: number, out: { CFrame }): number
	local rot = CFrame.Angles(0, theta, 0)
	out[1] = rot
	for _, s in ipairs(FairRides.CarouselSpots()) do
		local k = s.Horse
		if k then
			local bob = amp * math.sin(bobClock * FairRides.CAROUSEL_BOB_SPEED + s.Phase)
			out[1 + k] = rot * s.Base * CFrame.new(0, FairRides.HORSE_Y + bob, 0)
		end
	end
	return 1 + FairRides.CAROUSEL_HORSES
end

-- Manège de la place (tourne sans arrêt, comme en v9.7)
function FairRides.PlazaTheta(now: number): number
	return (now * FairRides.PLAZA_SPIN) % TAU
end

----------------------------------------------------------------------
-- Définition des manèges de la fête (repère de la fête, y = 0 au sol)
----------------------------------------------------------------------

FairRides.FAIR_HALF_W = 55
FairRides.FAIR_HALF_D = 36
FairRides.GROUND = 0.15 -- dessus du sol de la fête au-dessus du pré

-- Grande roue
FairRides.FERRIS_R = 16 -- rayon des axes des nacelles
FairRides.FERRIS_HUB = 21.5 -- hauteur du moyeu
FairRides.FERRIS_N = 10
FairRides.FERRIS_DROP = 4.4 -- de l'axe d'une nacelle à son plancher
-- Tasses
FairRides.CUPS_N = 5
FairRides.CUPS_R = 6 -- rayon des tasses sur le plateau
FairRides.CUPS_DECK = 0.8 -- dessus du plateau tournant
-- Chaises volantes
FairRides.SWING_N = 12
FairRides.SWING_TOP = 12 -- hauteur de l'anneau des chaînes
FairRides.SWING_R0 = 7.5 -- rayon de l'anneau des chaînes
FairRides.SWING_L = 9.2 -- longueur des chaînes
FairRides.SWING_MAX = math.rad(38) -- inclinaison à pleine vitesse
-- Tour de chute (douce)
FairRides.TOWER_N = 8
FairRides.TOWER_R = 3.1 -- rayon des sièges (tournés vers l'extérieur)
FairRides.TOWER_LOW = 1.3 -- plancher de la nacelle en bas
FairRides.TOWER_HIGH = 29 -- ... en haut
FairRides.TOWER_H = 36 -- hauteur du mât
-- Autos tamponneuses
FairRides.BUMPER_W = 30
FairRides.BUMPER_D = 22
FairRides.BUMPER_CARS = 6

export type RideDef = {
	Id: string,
	Kind: string, -- "Carousel" | "Ferris" | "Cups" | "Swings" | "Tower" | "Bumper"
	Name: string, -- texte anglais (Locale.T)
	Icon: string,
	Pos: Vector3, -- repère de la fête
	Yaw: number, -- degrés (autour de Y)
	Cycle: Cycle,
	Speed: number, -- rad/s à pleine vitesse (ou tours)
	Gate: Vector3, -- borne "Monter" (repère de la fête)
	Exit: Vector3, -- où l'on descend (repère de la fête)
}

FairRides.Rides = {
	{ Id = "Ferris", Kind = "Ferris", Name = "Big wheel", Icon = "🎡", Pos = Vector3.new(0, 0, 24), Yaw = 0,
		Cycle = { Load = 10, Ramp = 4, Run = 60 }, Speed = TAU / 36, Gate = Vector3.new(6.5, 0, 14.5), Exit = Vector3.new(-6.5, 0, 13) },
	{ Id = "Carousel", Kind = "Carousel", Name = "Carousel", Icon = "🎠", Pos = Vector3.new(-33, 1.2, -18), Yaw = 0, -- (repère = dessus du socle, comme celui de la place)
		Cycle = { Load = 8, Ramp = 3, Run = 40 }, Speed = TAU / 14, Gate = Vector3.new(-19.8, 0, -12), Exit = Vector3.new(-19.8, 0, -23) },
	{ Id = "Cups", Kind = "Cups", Name = "Teacups", Icon = "☕", Pos = Vector3.new(33, 0, -18), Yaw = 0,
		Cycle = { Load = 8, Ramp = 3, Run = 32 }, Speed = TAU / 14, Gate = Vector3.new(19.6, 0, -12), Exit = Vector3.new(19.6, 0, -23) },
	{ Id = "Swings", Kind = "Swings", Name = "Swing ride", Icon = "🎢", Pos = Vector3.new(-36, 0, 20), Yaw = 0,
		Cycle = { Load = 8, Ramp = 4, Run = 36 }, Speed = TAU / 6.5, Gate = Vector3.new(-20.5, 0, 8.5), Exit = Vector3.new(-21, 0, 32) },
	{ Id = "Tower", Kind = "Tower", Name = "Drop tower", Icon = "🗼", Pos = Vector3.new(-17, 0, 3), Yaw = 0,
		Cycle = { Load = 10, Ramp = 0, Run = 22.2 }, Speed = 0, Gate = Vector3.new(-9.4, 0, 0), Exit = Vector3.new(-9.4, 0, 6.5) },
	{ Id = "Bumper", Kind = "Bumper", Name = "Bumper cars", Icon = "🚗", Pos = Vector3.new(35, 0, 22), Yaw = 0,
		Cycle = { Load = 8, Ramp = 0, Run = 60 }, Speed = 0, Gate = Vector3.new(19, 0, 8.5), Exit = Vector3.new(17, 0, 14) },
} :: { RideDef }

FairRides.ById = {} :: { [string]: RideDef }
for _, r in ipairs(FairRides.Rides) do
	FairRides.ById[r.Id] = r
end

-- Repère (au sol) d'un manège de la fête
function FairRides.RideBase(fairCF: CFrame, def: RideDef): CFrame
	return fairCF * CFrame.new(def.Pos) * CFrame.Angles(0, math.rad(def.Yaw), 0)
end

----------------------------------------------------------------------
-- Tour de chute : hauteur (plancher de la nacelle) et rotation
----------------------------------------------------------------------

local function smooth(u: number): number
	u = math.clamp(u, 0, 1)
	return u * u * (3 - 2 * u)
end

-- Run = 22,2 s : montée 14 s, pause 3 s, chute douce 2,2 s, remontée +
-- rebond 3 s. Renvoie (hauteur, rotation, phase, secondes avant la fin)
function FairRides.TowerState(c: Cycle, t: number): (number, number, string, number)
	local P = FairRides.Period(c)
	local tm = t % P
	local low, high = FairRides.TOWER_LOW, FairRides.TOWER_HIGH
	if tm < c.Load then
		return low, 0, "load", c.Load - tm
	end
	local u = tm - c.Load
	local left = P - tm
	if u < 14 then
		local k = smooth(u / 14)
		return low + (high - low) * k, math.pi * k, "run", left
	end
	u -= 14
	if u < 3 then
		return high, math.pi, "run", left
	end
	u -= 3
	local bottom = low + 2.4
	if u < 2.2 then
		-- chute : accélère puis freine (jamais brutale)
		local k = u / 2.2
		local e = if k < 0.6 then (k / 0.6) ^ 2 * 0.75 else 0.75 + 0.25 * smooth((k - 0.6) / 0.4)
		return high + (bottom - high) * e, math.pi, "run", left
	end
	u -= 2.2
	-- petit rebond puis on redescend doucement au quai
	local k = math.clamp(u / 3, 0, 1)
	local bounce = math.sin(k * math.pi) * 1.2 * (1 - k)
	return bottom + (low - bottom) * smooth(k) + bounce, math.pi * (1 + smooth(k)), "run", left
end

----------------------------------------------------------------------
-- Poses : remplit `out` (CFrame relatifs à la Base) ; renvoie le nombre
-- de groupes. `t` = heure du serveur.
----------------------------------------------------------------------

function FairRides.Pose(def: RideDef, t: number, out: { CFrame }): number
	local kind = def.Kind
	if kind == "PlazaCarousel" then
		return carouselPose(FairRides.PlazaTheta(t), t, FairRides.CAROUSEL_BOB_AMP, out)
	end
	if kind == "Tower" then
		local y, rot = FairRides.TowerState(def.Cycle, t)
		out[1] = CFrame.new(0, y, 0) * CFrame.Angles(0, rot, 0)
		return 1
	end
	if kind == "Pirate" or kind == "Coaster" or kind == "Ghost" or kind == "Circus" then
		return FairRides.PoseAnnex(def, t, out)
	end
	local progress, speed = FairRides.Cycle(def.Cycle, t)
	local theta = (progress * def.Speed) % TAU
	if kind == "Carousel" then
		-- (les chevaux ne montent et descendent que quand ça tourne)
		return carouselPose(theta, progress, FairRides.CAROUSEL_BOB_AMP * math.min(1, speed * 1.5 + 0.0), out)
	elseif kind == "Ferris" then
		local hub = FairRides.FERRIS_HUB
		out[1] = CFrame.new(0, hub, 0) * CFrame.Angles(0, 0, theta)
		local R, N = FairRides.FERRIS_R, FairRides.FERRIS_N
		-- petit balancement des nacelles (plus fort quand la roue accélère)
		local sway = math.rad(2.2) * speed * math.sin(progress * 1.3)
		for k = 1, N do
			local a = theta + (k - 1) / N * TAU
			-- (= moyeu * Angles(0, 0, a) appliqué au point (0, -R) : suit les rayons)
			out[1 + k] = CFrame.new(math.sin(a) * R, hub - math.cos(a) * R, 0) * CFrame.Angles(0, 0, sway)
		end
		return 1 + N
	elseif kind == "Cups" then
		local deck = CFrame.new(0, FairRides.CUPS_DECK, 0) * CFrame.Angles(0, theta, 0)
		out[1] = deck
		local spin = -progress * TAU / 4.5
		for k = 1, FairRides.CUPS_N do
			local a = (k - 1) / FairRides.CUPS_N * TAU
			out[1 + k] = deck * CFrame.new(math.sin(a) * FairRides.CUPS_R, 0, math.cos(a) * FairRides.CUPS_R) * CFrame.Angles(0, spin + a * 3, 0)
		end
		return 1 + FairRides.CUPS_N
	elseif kind == "Swings" then
		local rot = CFrame.Angles(0, theta, 0)
		out[1] = rot
		local alpha = FairRides.SWING_MAX * speed * speed
		for k = 1, FairRides.SWING_N do
			local a = (k - 1) / FairRides.SWING_N * TAU
			local pivot = rot * CFrame.Angles(0, a, 0) * CFrame.new(FairRides.SWING_R0, FairRides.SWING_TOP, 0)
			out[1 + k] = pivot * CFrame.Angles(0, 0, alpha) * CFrame.new(0, -FairRides.SWING_L, 0)
		end
		return 1 + FairRides.SWING_N
	end
	return 0
end

-- Inclinaison actuelle des chaises volantes (pour les chaînes, côté client)
function FairRides.SwingAlpha(def: RideDef, t: number): number
	local _, speed = FairRides.Cycle(def.Cycle, t)
	return FairRides.SWING_MAX * speed * speed
end

----------------------------------------------------------------------
-- Sièges : { Group, Local } (le devant du siège = -Z = regard de l'avatar)
----------------------------------------------------------------------

export type SeatSpec = { Group: number, Local: CFrame, Size: Vector3 }

local seatCache: { [string]: { SeatSpec } } = {}
function FairRides.Seats(kind: string): { SeatSpec }
	local cached = seatCache[kind]
	if cached then
		return cached
	end
	local list: { SeatSpec } = {}
	if kind == "Carousel" or kind == "PlazaCarousel" then
		for _, s in ipairs(FairRides.CarouselSpots()) do
			if s.Horse then
				-- sur la selle (dessus de la selle à +0,875 du centre du cheval)
				table.insert(list, { Group = 1 + s.Horse, Local = CFrame.new(0, 0.8, -0.05), Size = Vector3.new(1.1, 0.16, 1.2) })
			else
				-- banquette du carrosse (dos au dossier)
				table.insert(list, { Group = 1, Local = s.Base * CFrame.new(0, 0.98, 0.8), Size = Vector3.new(1.5, 0.16, 0.9) })
			end
		end
	elseif kind == "Ferris" then
		for k = 1, FairRides.FERRIS_N do
			local y = -FairRides.FERRIS_DROP + 1.45
			table.insert(list, { Group = 1 + k, Local = CFrame.new(-1.45, y, 0) * CFrame.Angles(0, math.rad(-90), 0), Size = Vector3.new(1.6, 0.16, 1.1) })
			table.insert(list, { Group = 1 + k, Local = CFrame.new(1.45, y, 0) * CFrame.Angles(0, math.rad(90), 0), Size = Vector3.new(1.6, 0.16, 1.1) })
		end
	elseif kind == "Cups" then
		for k = 1, FairRides.CUPS_N do
			table.insert(list, { Group = 1 + k, Local = CFrame.new(-1.05, 1.25, 0) * CFrame.Angles(0, math.rad(-90), 0), Size = Vector3.new(1.4, 0.16, 1) })
			table.insert(list, { Group = 1 + k, Local = CFrame.new(1.05, 1.25, 0) * CFrame.Angles(0, math.rad(90), 0), Size = Vector3.new(1.4, 0.16, 1) })
		end
	elseif kind == "Swings" then
		for k = 1, FairRides.SWING_N do
			table.insert(list, { Group = 1 + k, Local = CFrame.new(0, -0.35, 0), Size = Vector3.new(1.4, 0.16, 1.2) })
		end
	elseif kind == "Pirate" or kind == "Coaster" or kind == "Ghost" or kind == "Circus" then
		list = FairRides.AnnexSeats(kind)
	elseif kind == "Tower" then
		for k = 1, FairRides.TOWER_N do
			local a = (k - 1) / FairRides.TOWER_N * TAU
			table.insert(list, { Group = 1, Local = CFrame.Angles(0, a, 0) * CFrame.new(0, 1.35, -FairRides.TOWER_R) , Size = Vector3.new(1.5, 0.16, 1.1) })
		end
	end
	seatCache[kind] = list
	return list
end

-- CFrame (repère de la Base) du siège `index` d'après les groupes déjà calculés
function FairRides.SeatLocal(kind: string, index: number, groups: { CFrame }): CFrame
	local spec = FairRides.Seats(kind)[index]
	return groups[spec.Group] * spec.Local
end

-- Phase affichée (panneaux) : ("load" | "run", secondes restantes)
function FairRides.Phase(def: RideDef, t: number): (string, number)
	if def.Kind == "Tower" then
		local _, _, phase, left = FairRides.TowerState(def.Cycle, t)
		return phase, left
	end
	if def.Kind == "Coaster" or def.Kind == "Ghost" or def.Kind == "Pirate" then
		local P = FairRides.Period(def.Cycle)
		local tm = t % P
		if tm < def.Cycle.Load then
			return "load", def.Cycle.Load - tm
		end
		return "run", P - tm
	end
	local _, _, phase, left = FairRides.Cycle(def.Cycle, t)
	return phase, left
end

----------------------------------------------------------------------
-- Autos tamponneuses : places de départ (repère de l'arène, au sol)
----------------------------------------------------------------------

function FairRides.BumperHome(index: number): CFrame
	local col = (index - 1) % 3
	local row = math.floor((index - 1) / 3)
	return CFrame.new(-8 + col * 8, 0, -4 + row * 8) * CFrame.Angles(0, if row == 0 then 0 else math.pi, 0)
end


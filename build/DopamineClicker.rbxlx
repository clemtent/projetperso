		["Bet: %s Dopamine"] = "Mise : %s Dopamine",
		["SPIN"] = "JOUER",
		["JACKPOT!"] = "JACKPOT !",
		["🚧 CLOSED 🚧"] = "🚧 FERMÉ 🚧",
		["The slot machine is taking a break."] = "La machine à sous fait une pause.",
		["Come back later 😴"] = "Reviens plus tard 😴",
		["Closed for now 😴"] = "Fermé pour le moment 😴",
		["🎰 JACKPOT! %s"] = "🎰 JACKPOT ! %s",
		["Partly refunded (%s) 🙃"] = "Remboursé en partie (%s) 🙃",
		["You need at least %s Dopamine 😬"] = "Il faut au moins %s Dopamine 😬",
		["Spinning… 🎲"] = "Ça tourne… 🎲",
		["🤞 Come on… come on…"] = "🤞 Allez… allez…",
		["The machine is on strike 🔧"] = "La machine fait grève 🔧",
		["Triple %s = %s!"] = "Triple %s = %s !",
		["🚀 To the moon!"] = "🚀 Vers la lune !",
		["🐂 Going up!"] = "🐂 Ça monte !",
		["💀 It's crashing..."] = "💀 C'est la chute...",
		["🐻 Oof, oof, oof"] = "🐻 Aïe aïe aïe",
		["😐 Going nowhere..."] = "😐 Ça stagne...",
		["LIVE · %s fee"] = "EN DIRECT · frais %s",
		["your avg price"] = "ton prix moyen",
		["⏳ Opening..."] = "⏳ Ouverture...",
		["Loading price... ⏳"] = "Chargement du cours... ⏳",
		["▼ Sell"] = "▼ Vendre",
		["💼 <font color=\"#8C98B4\">No shares · %s fee</font>"] = "💼 <font color=\"#8C98B4\">Aucune action · frais %s</font>",
		["Buy low, sell high 😏"] = "Achète bas, vends haut 😏",
		["💼 <b>%s</b> <font color=\"#8C98B4\">· %s shares</font>"] = "💼 <b>%s</b> <font color=\"#8C98B4\">· %s act.</font>",
		["You don't have any shares to sell 🤷"] = "Tu n'as aucune action à vendre 🤷",
		["Not enough Dopamine to invest 😅"] = "Pas assez de Dopamine pour investir 😅",
		["The market isn't responding... 😵"] = "La bourse ne répond pas... 😵",
		["READY!"] = "PRÊT !",
		["🎲 Odds"] = "🎲 Chances",
		["Tap to close"] = "Touche pour fermer",
		["FULL!"] = "PLEIN !",
		["FULL"] = "PLEIN",
		["🏆 %s CHEST! %s"] = "🏆 COFFRE %s ! %s",
		["Not yet!"] = "Pas encore !",
		["The chest is stuck 🔒"] = "Le coffre est coincé 🔒",
		["VIDEO"] = "VIDÉO",
		["Breathe..."] = "Respire...",
		["All is calm."] = "Tout est calme.",
		["Ocean visit #%s • "] = "Visite n°%s à l'océan • ",

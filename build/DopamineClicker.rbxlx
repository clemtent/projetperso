		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = shine,
	})

	------------------------------------------------------------------
	-- La marée (vague plein écran, crête d'écume en haut)
	------------------------------------------------------------------
	local tide = frame({
		Name = "Tide",
		Position = UDim2.new(0, -EXTEND, 1, EXTEND + CREST),
		Size = UDim2.new(1, EXTEND * 2, 1, EXTEND * 2 + CREST * 2),
		BackgroundColor3 = WHITE,
		ZIndex = 3,
		Parent = container,
	})
	vertical(tide, {
		ColorSequenceKeypoint.new(0, Color3.fromRGB(120, 226, 236)),
		ColorSequenceKeypoint.new(0.08, Color3.fromRGB(40, 176, 210)),
		ColorSequenceKeypoint.new(0.45, Color3.fromRGB(20, 110, 180)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(12, 56, 130)),
	})
	-- Reflets obliques dans l'eau
	for index = 1, 5 do
		local streak = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(index / 6, 0.3 + (index % 3) * 0.15),
			Size = UDim2.fromOffset(random:NextInteger(120, 260), 5),
			Rotation = -8,
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.8,
			ZIndex = 3,
			Parent = tide,
		})
		round(streak)
	end
	-- Crête : bande d'écume, bosses arrondies, embruns
	local crestBand = frame({
		Name = "Crest",
		Size = UDim2.new(1, 0, 0, 16),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.05,
		ZIndex = 4,
		Parent = tide,
	})
	crestBand.Position = UDim2.fromOffset(0, 0)
	-- Deux rangées de bouillons d'écume (grands et clairs derrière, petits devant)
	for rowIndex, rowDef in ipairs({ { Count = 18, Min = 60, Max = 96, Y = -6, T = 0.3 }, { Count = 30, Min = 26, Max = 54, Y = 6, T = 0.02 } }) do
		for index = 1, rowDef.Count do
			local size = random:NextInteger(rowDef.Min, rowDef.Max)
			local bump = frame({
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new((index - 0.5) / rowDef.Count, random:NextNumber(-10, 10), 0, rowDef.Y + random:NextNumber(-5, 5)),
				Size = UDim2.fromOffset(size, size * random:NextNumber(0.55, 0.75)),
				BackgroundColor3 = rowIndex == 1 and Color3.fromRGB(226, 248, 252) or WHITE,
				BackgroundTransparency = rowDef.T,
				ZIndex = 4,
				Parent = tide,
			})
			round(bump)
		end
	end
	for _ = 1, 30 do
		local size = random:NextInteger(5, 14)
		local spray = frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(random:NextNumber(0, 1), 0, 0, -random:NextNumber(18, CREST + 10)),
			Size = UDim2.fromOffset(size, size),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = random:NextNumber(0.1, 0.5),
			ZIndex = 4,
			Parent = tide,
		})
		round(spray)
	end

	local tidePhase = "Idle" -- Idle | Rise | Drain
	local tideT = 0
	local tideTop = 1.2 -- position du haut de la vague (0 = haut de l'écran, 1 = bas)
	local finalDrain = false

	local function setTide(top: number)
		tideTop = top
		-- top : 0 -> haut du débord, 1 -> bas du débord (en proportion + débords)
		tide.Position = UDim2.new(0, -EXTEND, top, (top * 2 - 1) * (EXTEND + CREST))
	end
	setTide(1)

	------------------------------------------------------------------
	-- Animation continue (une seule boucle)
	------------------------------------------------------------------
	local time = 0
	local sunProgress = 0 -- 0..1 : coucher du soleil
	local starLevel = 0 -- 0..1 : étoiles visibles
	local breath = 0 -- -1..1 : nappe de la plage (respiration)
	local breathTarget = 0
	local revealAge = -1
	local counting = -1
	local sparkClock = 0
	local shineAge = -1

	ctx.OnRender(function(dt: number)
		time += dt

		-- Marée
		if tidePhase == "Rise" then
			tideT = math.min(1, tideT + dt / TIDE_RISE)
			setTide(1 - easeOutCubic(tideT))
		elseif tidePhase == "Drain" then
			tideT = math.min(1, tideT + dt / TIDE_DRAIN)
			setTide(easeInOutSine(tideT) * 1.02)
			if tideT >= 1 then
				tidePhase = "Idle"
				tide.Visible = false
			end
		end

		-- Écume laissée derrière (fin) : apparaît quand l'eau la découvre, puis éclate
		if finalDrain then
			local height = container.AbsoluteSize.Y / math.max(0.01, ctx.Interface.Scale or 1)
			local edge = tideTop * height + (tideTop * 2 - 1) * (EXTEND + CREST) - CREST
			for _, foam in ipairs(foams) do
				if foam.State == "Hidden" then
					if edge > foam.Y * height + 10 then
						foam.State = "Shown"
						foam.Frame.Visible = true
						foam.PopAt = time + random:NextNumber(0.1, 0.5)
					end
				elseif foam.State == "Shown" then
					if time >= foam.PopAt then
						foam.State = "Popping"
						foam.Age = 0
					end
				elseif foam.State == "Popping" then
					foam.Age = math.min(1, foam.Age + dt / 0.2)
					foam.Scale.Scale = 1 + 0.7 * foam.Age
					foam.Frame.BackgroundTransparency = 0.45 + 0.55 * foam.Age
					foam.Stroke.Transparency = 0.2 + 0.8 * foam.Age
					if foam.Age >= 1 then
						foam.State = "Done"
						foam.Frame.Visible = false
					end
				end
			end
		end
		if shineAge >= 0 then
			shineAge += dt
			local p = math.min(1, shineAge / 0.65)
			shine.Visible = p < 1
			shine.Position = UDim2.fromScale(-0.15 + 1.3 * easeInOutSine(p), 0.5)
		end

		if not scene.Visible then
			return
		end

		-- Vagues (va-et-vient)
		for _, layer in ipairs(layers) do
			local def = layer.Def
			local x = 0.5 + math.sin(time * def.Speed + layer.Phase) * def.Amp
			local y = def.Top + math.sin(time * def.Speed * 1.4 + layer.Phase) * 0.005
			layer.Frame.Position = UDim2.fromScale(x, y)
		end
		-- Reflets dorés
		for _, glint in ipairs(glints) do
			glint.Frame.BackgroundTransparency = 0.2 + (math.sin(time * glint.Speed + glint.Phase) + 1) * 0.36
		end
		-- Nuages, soleil, étoiles
		for _, cloud in ipairs(clouds) do
			cloud.X += cloud.Speed * dt
			cloud.Frame.Position = UDim2.fromScale(cloud.X, cloud.Y)
		end
		sunProgress = math.min(1, sunProgress + dt / 8.5)
		sunHolder.Position = UDim2.fromScale(0.5, sunStart + (sunEnd - sunStart) * easeInOutSine(sunProgress))
		for index, halo in ipairs(halos) do
			halo.Frame.BackgroundTransparency = halo.Base + 0.03 * math.sin(time * 1.2 + index)
		end
		starLevel = math.min(1, starLevel + dt / 6)
		for _, star in ipairs(stars) do
			local level = math.clamp(starLevel * 1.6 - star.Delay * 0.6, 0, 1)
			star.Frame.BackgroundTransparency = 1 - level * (0.55 + 0.45 * (0.5 + 0.5 * math.sin(time * star.Speed + star.Phase)))
		end
		-- Mouettes
		for _, gull in ipairs(gulls) do
			gull.X += gull.Speed * dt
			local bob = math.sin(time * 1.3 + gull.Phase) * 0.01
			gull.Frame.Position = UDim2.fromScale(gull.X, gull.Y + bob)
			local flap = 16 + math.sin(time * 6 + gull.Phase) * 16
			for _, wing in ipairs(gull.Wings) do
				wing.Frame.Rotation = -wing.Side * flap
			end
		end
		-- Voilier qui dérive et tangue
		boat.Position = UDim2.new(0.74 - time * 0.004, 0, HORIZON, 3 + math.sin(time * 1.6) * 1.2)
		boat.Rotation = math.sin(time * 1.3) * 3
		-- Nappe d'eau sur le sable (suit la respiration)
		breath += (breathTarget - breath) * math.min(1, dt * 1.8)
		local height = 26 + breath * 22 + math.sin(time * 1.1) * 3
		if math.abs(height - swashHeight) > 0.2 then
			swashHeight = height
			swash.Size = UDim2.new(1, EXTEND * 2, 0, swashHeight)
		end

		-- Révélation : rayons qui tournent, halo qui pulse, compteur, étincelles
		if revealAge >= 0 then
			revealAge += dt
			rays.Rotation = time * 14
			glowScale.Scale = (0.3 + 0.7 * easeOutBack(math.min(1, revealAge / 0.5))) * (1 + 0.06 * math.sin(time * 3))
			if counting >= 0 then
				counting = math.min(1, counting + dt / 0.9)
				local value = previous + (multiplier - previous) * easeOutCubic(counting)
				multText.Text = ctx.Format.Multiplier(counting >= 1 and multiplier or value)
				if counting >= 1 then
					counting = -1
					multScale.Scale = 1.28
					UIUtil.Tween(multScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
					for _ = 1, 8 do
						local angle = random:NextNumber(0, math.pi * 2)
						local speed = random:NextNumber(260, 420)
						emitSpark(0.5, TEXT_Y, math.cos(angle) * speed, math.sin(angle) * speed - 60, random:NextNumber(0.7, 1))
					end
				end
			end
			-- Braises qui montent
			sparkClock += dt
			if sparkClock >= 0.14 then
				sparkClock = 0
				emitSpark(random:NextNumber(0.2, 0.8), TEXT_Y + random:NextNumber(0.12, 0.3), random:NextNumber(-20, 20), -random:NextNumber(60, 130), random:NextNumber(1.2, 1.8))
			end
		end
		-- Étincelles (position en échelle + vitesse en pixels)
		for _, spark in ipairs(sparks) do
			if spark.Age < 1 then
				spark.Age = math.min(1, spark.Age + dt / spark.Life)
				local t = spark.Age * spark.Life
				local drag = 1 - spark.Age * 0.5
				spark.Label.Position = UDim2.new(spark.X, spark.VX * t * drag, spark.Y, spark.VY * t * drag + 120 * t * t)
				spark.Label.Rotation = spark.Spin * t
				spark.Label.TextTransparency = spark.Age ^ 1.6
				if spark.Age >= 1 then
					spark.Label.Visible = false
				end
			end
		end
	end)

	------------------------------------------------------------------
	-- Déroulé (~8,8 s)
	------------------------------------------------------------------
	-- 1. La marée monte et recouvre l'interface
	ctx.Sound.Play("Detox", 1)
	tidePhase, tideT = "Rise", 0
	if not waitAlive(TIDE_RISE + 0.06) then
		return
	end
	-- 2. Derrière la vague : la plage au coucher du soleil ; la vague redescend
	scene.Visible = true
	tidePhase, tideT = "Drain", 0
	if not waitAlive(0.3) then
		return
	end

	-- 3. Respiration
	UIUtil.Tween(ringStroke, 0.5, { Transparency = 0.25 })
	UIUtil.Tween(ring, 0.5, { BackgroundTransparency = 0.9 })
	UIUtil.Tween(ringInner, 0.5, { BackgroundTransparency = 0.93 })
	showText(mainText, mainStroke, Locale.T("Breathe in..."), 0.5)
	breathTarget = 1
	UIUtil.Tween(ringScale, 1.6, { Scale = 1.22 }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	if not waitAlive(1.6) then
		return
	end
	mainText.Text = Locale.T("Breathe out...")
	breathTarget = -0.6
	UIUtil.Tween(ringScale, 1.4, { Scale = 0.7 }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	if not waitAlive(1.4) then
		return
	end

	-- "Tout est calme."
	UIUtil.Tween(ringStroke, 0.4, { Transparency = 1 })
	UIUtil.Tween(ring, 0.4, { BackgroundTransparency = 1 })
	UIUtil.Tween(ringInner, 0.4, { BackgroundTransparency = 1 })
	breathTarget = 0
	hideText(mainText, mainStroke, 0.25)
	if not waitAlive(0.25) then
		return
	end
	showText(mainText, mainStroke, Locale.T("All is calm."), 0.4)
	if not waitAlive(0.8) then
		return
	end
	hideText(mainText, mainStroke, 0.25)
	if not waitAlive(0.25) then
		return
	end

	-- 4. Révélation du nouveau multiplicateur
	flash.BackgroundTransparency = 0.25
	UIUtil.Tween(flash, 0.7, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
	reveal.Visible = true
	revealAge = 0
	UIUtil.Tween(raysScale, 0.6, { Scale = 1 }, Enum.EasingStyle.Back)
	UIUtil.Tween(badgeScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	multScale.Scale = 0.3
	UIUtil.Tween(multScale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
	for _ = 1, 10 do
		local angle = random:NextNumber(0, math.pi * 2)
		local speed = random:NextNumber(180, 380)
		emitSpark(0.5, TEXT_Y, math.cos(angle) * speed, math.sin(angle) * speed - 40, random:NextNumber(0.8, 1.2))
	end
	ctx.Sound.Play("Bonus", 0.8)
	if not waitAlive(0.35) then
		return
	end
	counting = 0
	UIUtil.Tween(subText, 0.5, { TextTransparency = 0 }, Enum.EasingStyle.Sine)
	UIUtil.Tween(subStroke, 0.5, { Transparency = 0.3 }, Enum.EasingStyle.Sine)
	if not waitAlive(1.5) then
		return
	end

	-- 5. La marée revient, puis se retire en découvrant l'interface toute neuve
	tide.Visible = true
	tidePhase, tideT = "Rise", 0
	if not waitAlive(TIDE_RISE + 0.06) then
		return
	end
	scene.Visible = false
	finalDrain = true
	tidePhase, tideT = "Drain", 0
	if not waitAlive(TIDE_DRAIN) then
		return
	end
	shineAge = 0
	waitAlive(0.75)
end

return Ocean
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="159">
          <Properties>
            <string name="Name">PhoneNotifs</string>
            <string name="Source"><![CDATA[--[[
	PhoneNotifs (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > PhoneNotifs

	Notifications de téléphone (décidées par le SERVEUR via l'événement
	Spawn "Notif") : une bannière arrondie façon smartphone glisse depuis
	la gauche (icône d'appli, nom, "maintenant", message drôle choisi par
	info.Variant), vibre un peu, et s'empile en haut à gauche (3 au max).
	Un clic = ClaimSpawn (le serveur valide) ; la bannière s'en va toute
	seule à la fin de sa durée de vie (petite barre de temps en bas).
	Le bonus confirmé (OnBonus "Notif") s'affiche en "+X" sur la bannière.
]]

local Debris = game:GetService("Debris")

local Locale = require(game:GetService("ReplicatedStorage").Shared.Locale)

local PhoneNotifs = {}
PhoneNotifs.Slot = "Overlay"

local CARD_W = 288
local CARD_H = 68
local GAP = 8
local LEFT = 16
local TOP = 44
local MAX_VISIBLE = 3

-- Icône, nom de l'appli, couleur de l'icône, message (une liste par langue, même ordre)
local NOTIFS = {
	en = {
		{ Icon = "💬", App = "Messages", Color = Color3.fromRGB(52, 199, 89), Text = "Mom: did you eat?" },
		{ Icon = "📦", App = "Parcel Express", Color = Color3.fromRGB(255, 149, 0), Text = "Your package is on its way! (It got lost, but enthusiastically)" },
		{ Icon = "❤️", App = "Photos", Color = Color3.fromRGB(255, 62, 138), Text = "+3 likes on your photo of toast" },
		{ Icon = "💧", App = "Health", Color = Color3.fromRGB(0, 194, 224), Text = "Reminder: drink some water 💧" },
		{ Icon = "⛈️", App = "Weather", Color = Color3.fromRGB(30, 136, 229), Text = "Lightning likely. Remember to catch it ⚡" },
		{ Icon = "🔋", App = "Battery", Color = Color3.fromRGB(227, 38, 43), Text = "Battery at 3%. Same, honestly." },
		{ Icon = "⏰", App = "Alarm", Color = Color3.fromRGB(255, 138, 26), Text = "You snoozed your alarm 14 times. Impressive." },
		{ Icon = "👟", App = "Step Counter", Color = Color3.fromRGB(61, 200, 61), Text = "12 steps today. Personal best?" },
		{ Icon = "🌱", App = "Smart Plant", Color = Color3.fromRGB(40, 170, 80), Text = "I'm thirsty. Love you. — Your plant" },
		{ Icon = "🍕", App = "Pizza Minute", Color = Color3.fromRGB(255, 120, 40), Text = "Your pizza arrives in 5 minutes (it has for 40 minutes)" },
		{ Icon = "📅", App = "Calendar", Color = Color3.fromRGB(227, 38, 43), Text = "Reminder: do nothing from 2 to 6 p.m." },
		{ Icon = "👵", App = "Grandma", Color = Color3.fromRGB(139, 50, 224), Text = "Grandma sent 27 photos of her cat" },
		{ Icon = "🔒", App = "Security", Color = Color3.fromRGB(60, 60, 70), Text = "New sign-in from your toaster. Was this you?" },
		{ Icon = "⬇️", App = "Software Update", Color = Color3.fromRGB(30, 136, 229), Text = "Update available: 0.2 MB of amazing new features" },
		{ Icon = "🧊", App = "Smart Fridge", Color = Color3.fromRGB(0, 194, 224), Text = "There's one yogurt left. It's staring at you." },
		{ Icon = "🐱", App = "Living Room Cam", Color = Color3.fromRGB(255, 170, 40), Text = "Motion detected: it's the cat. Again." },
		{ Icon = "🎮", App = "Games", Color = Color3.fromRGB(139, 50, 224), Text = "Your friend invited you to play... 3 years ago" },
		{ Icon = "🏦", App = "Bank", Color = Color3.fromRGB(42, 42, 42), Text = "Your Dopamine balance is excellent. Everything else, less so." },
		{ Icon = "✨", App = "Horoscope", Color = Color3.fromRGB(255, 62, 138), Text = "Aries: today, click. A lot." },
		{ Icon = "📸", App = "Memories", Color = Color3.fromRGB(255, 194, 26), Text = "5 years ago today: you were already clicking." },
		{ Icon = "🎵", App = "Music", Color = Color3.fromRGB(255, 45, 85), Text = "Your song of the summer, played 842 times. You OK?" },
		{ Icon = "🦷", App = "Dentist", Color = Color3.fromRGB(90, 160, 255), Text = "Don't forget your appointment. Yes, that one." },
		{ Icon = "👍", App = "Social Network", Color = Color3.fromRGB(30, 110, 230), Text = "Someone liked your comment from 2019" },
		{ Icon = "🌙", App = "Sleep", Color = Color3.fromRGB(88, 86, 214), Text = "It's late. Put the phone down. (No? Okay.)" },
		{ Icon = "🧦", App = "Socks & Co", Color = Color3.fromRGB(227, 38, 43), Text = "Your left sock is on sale!" },
		{ Icon = "🍪", App = "Cookies", Color = Color3.fromRGB(190, 120, 60), Text = "This site uses cookies. Real ones. Chocolate chip." },
		{ Icon = "🤖", App = "Assistant", Color = Color3.fromRGB(0, 170, 200), Text = "Sorry, I didn't understand “5 more minutes”." },
		{ Icon = "🦆", App = "Rubber Duck", Color = Color3.fromRGB(255, 200, 0), Text = "Quack. (You have 1 new quack.)" },
	},
	fr = {
		{ Icon = "💬", App = "Messages", Color = Color3.fromRGB(52, 199, 89), Text = "Maman : t'as mangé ?" },
		{ Icon = "📦", App = "Colis Express", Color = Color3.fromRGB(255, 149, 0), Text = "Ton colis est en route ! (il s'est perdu, mais avec enthousiasme)" },
		{ Icon = "❤️", App = "Photos", Color = Color3.fromRGB(255, 62, 138), Text = "+3 likes sur ta photo de tartine" },
		{ Icon = "💧", App = "Santé", Color = Color3.fromRGB(0, 194, 224), Text = "Rappel : boire de l'eau 💧" },
		{ Icon = "⛈️", App = "Météo", Color = Color3.fromRGB(30, 136, 229), Text = "Risque d'éclairs. Pense à les attraper ⚡" },
		{ Icon = "🔋", App = "Batterie", Color = Color3.fromRGB(227, 38, 43), Text = "Batterie à 3 %. Moi aussi, je suis fatigué." },
		{ Icon = "⏰", App = "Réveil", Color = Color3.fromRGB(255, 138, 26), Text = "Tu as repoussé ton réveil 14 fois. Bravo." },
		{ Icon = "👟", App = "Podomètre", Color = Color3.fromRGB(61, 200, 61), Text = "12 pas aujourd'hui. Record personnel ?" },
		{ Icon = "🌱", App = "Plante connectée", Color = Color3.fromRGB(40, 170, 80), Text = "J'ai soif. Bisous. — Ta plante" },
		{ Icon = "🍕", App = "Pizza Minute", Color = Color3.fromRGB(255, 120, 40), Text = "Ta pizza arrive dans 5 minutes (depuis 40 minutes)" },
		{ Icon = "📅", App = "Calendrier", Color = Color3.fromRGB(227, 38, 43), Text = "Rappel : ne rien faire de 14 h à 18 h" },
		{ Icon = "👵", App = "Mamie", Color = Color3.fromRGB(139, 50, 224), Text = "Mamie a envoyé 27 photos de son chat" },
		{ Icon = "🔒", App = "Sécurité", Color = Color3.fromRGB(60, 60, 70), Text = "Nouvelle connexion depuis ton grille-pain. C'était toi ?" },
		{ Icon = "⬇️", App = "Mise à jour", Color = Color3.fromRGB(30, 136, 229), Text = "Mise à jour dispo : 0,2 Mo de nouveautés incroyables" },
		{ Icon = "🧊", App = "Frigo connecté", Color = Color3.fromRGB(0, 194, 224), Text = "Il reste un yaourt. Il te regarde." },
		{ Icon = "🐱", App = "Caméra du salon", Color = Color3.fromRGB(255, 170, 40), Text = "Mouvement détecté : c'est le chat. Encore." },
		{ Icon = "🎮", App = "Jeux", Color = Color3.fromRGB(139, 50, 224), Text = "Ton ami t'a invité à jouer... il y a 3 ans" },
		{ Icon = "🏦", App = "Banque", Color = Color3.fromRGB(42, 42, 42), Text = "Ton solde de Dopamine est excellent. Le reste, moins." },
		{ Icon = "✨", App = "Horoscope", Color = Color3.fromRGB(255, 62, 138), Text = "Bélier : aujourd'hui, clique. Beaucoup." },
		{ Icon = "📸", App = "Souvenirs", Color = Color3.fromRGB(255, 194, 26), Text = "Il y a 5 ans aujourd'hui : tu cliquais déjà." },
		{ Icon = "🎵", App = "Musique", Color = Color3.fromRGB(255, 45, 85), Text = "Ta chanson de l'été écoutée 842 fois. Ça va ?" },
		{ Icon = "🦷", App = "Dentiste", Color = Color3.fromRGB(90, 160, 255), Text = "N'oublie pas ton rendez-vous. Oui, celui-là." },
		{ Icon = "👍", App = "Réseau social", Color = Color3.fromRGB(30, 110, 230), Text = "Quelqu'un a aimé ton commentaire de 2019" },
		{ Icon = "🌙", App = "Sommeil", Color = Color3.fromRGB(88, 86, 214), Text = "Il est tard. Pose le téléphone. (Non ? D'accord.)" },
		{ Icon = "🧦", App = "Chaussettes & Co", Color = Color3.fromRGB(227, 38, 43), Text = "Ta chaussette gauche est en promo !" },
		{ Icon = "🍪", App = "Cookies", Color = Color3.fromRGB(190, 120, 60), Text = "Ce site utilise des cookies. Des vrais. Au chocolat." },
		{ Icon = "🤖", App = "Assistant", Color = Color3.fromRGB(0, 170, 200), Text = "Désolé, je n'ai pas compris « encore 5 minutes »." },
		{ Icon = "🦆", App = "Canard de bain", Color = Color3.fromRGB(255, 200, 0), Text = "Coin. (Tu as 1 nouveau coin.)" },
	},
}

-- Choix déterministe selon la variante envoyée par le serveur
local function pick(list: { any }, variant: any): any
	local v = math.floor(tonumber(variant) or 1)
	return list[(v - 1) % #list + 1]
end

-- Majuscules qui gardent les accents ("Podomètre" -> "PODOMÈTRE")
local ACCENTS = { ["é"] = "É", ["è"] = "È", ["ê"] = "Ê", ["ë"] = "Ë", ["à"] = "À", ["â"] = "Â", ["ç"] = "Ç",
	["î"] = "Î", ["ï"] = "Ï", ["ô"] = "Ô", ["ù"] = "Ù", ["û"] = "Û" }
local function upper(text: string): string
	local result = string.upper(text)
	for small, big in pairs(ACCENTS) do
		result = string.gsub(result, small, big)
	end
	return result
end

function PhoneNotifs.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local container: Frame = ctx.Container
	local random = Random.new()

	local cards: { any } = {} -- du plus récent (en haut) au plus ancien
	local byId: { [string]: any } = {}
	local positions: { [string]: UDim2 } = {} -- pour placer le "+X" du bonus
	local lastPosition = UDim2.fromOffset(LEFT + CARD_W / 2, TOP + CARD_H / 2)

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	local function slotY(index: number): number
		return TOP + (index - 1) * (CARD_H + GAP)
	end

	-- Replace les bannières dans la pile
	local function layout()
		for index, card in ipairs(cards) do
			local target = UDim2.fromOffset(LEFT, slotY(index))
			if card.Entered then
				UIUtil.Tween(card.Root, 0.3, { Position = target }, Enum.EasingStyle.Quad)
			else
				card.Entered = true
				card.Root.Position = UDim2.fromOffset(-CARD_W - 30, slotY(index))
				UIUtil.Tween(card.Root, 0.45, { Position = target }, Enum.EasingStyle.Back)
			end
		end
	end

	local function dismiss(card, claimed: boolean)
		if card.Done then
			return
		end
		card.Done = true
		local index = table.find(cards, card)
		if index then
			table.remove(cards, index)
		end
		byId[card.Id] = nil
		layout()

		local root = card.Root
		root.Active = false
		if claimed then
			-- "Ouverture" : petit gonflement puis disparition
			UIUtil.Tween(card.Scale, 0.12, { Scale = 1.06 }, Enum.EasingStyle.Quad)
			task.delay(0.12, function()
				if root.Parent then
					UIUtil.Tween(card.Scale, 0.25, { Scale = 0.6 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
					UIUtil.Tween(card.Group, 0.25, { GroupTransparency = 1 })
					UIUtil.Tween(card.Shadow, 0.25, { BackgroundTransparency = 1 })
					UIUtil.Tween(card.Outline, 0.25, { Transparency = 1 })
				end
			end)
		else
			-- Ignorée : repart vers la gauche
			UIUtil.Tween(root, 0.35, { Position = root.Position - UDim2.fromOffset(CARD_W + 40, 0) }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			UIUtil.Tween(card.Group, 0.35, { GroupTransparency = 0.6 })
		end
		Debris:AddItem(root, 0.5)
	end

	local function spawnNotif(info)
		if not ctx.IsAlive() or type(info) ~= "table" or type(info.Id) ~= "string" or byId[info.Id] then
			return
		end
		-- Trop de bannières : la plus ancienne laisse sa place
		while #cards >= MAX_VISIBLE do
			dismiss(cards[#cards], false)
		end

		local data = pick(Locale.Pick(NOTIFS), info.Variant)
		local lifetime = math.max(1.5, tonumber(info.Lifetime) or 6)
		local variant = math.floor(tonumber(info.Variant) or 1)

		local root = UIUtil.Create("TextButton", {
			Name = "Notif",
			Size = UDim2.fromOffset(CARD_W, CARD_H),
			Position = UDim2.fromOffset(-CARD_W - 30, TOP),
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Text = "",
			ZIndex = 30,
			Parent = container,
		})
		local scale = UIUtil.Create("UIScale", { Parent = root })

		-- Ombre douce
		local shadow = UIUtil.Create("Frame", {
			Name = "Shadow",
			Size = UDim2.fromScale(1, 1),
			Position = UDim2.fromOffset(0, 4),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.82,
			BorderSizePixel = 0,
			ZIndex = 30,
			Parent = root,
		})
		UIUtil.Corner(shadow, 18)

		-- Carte (CanvasGroup : permet de tout faire disparaître d'un coup)
		local group = UIUtil.Create("CanvasGroup", {
			Name = "Card",
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.fromRGB(250, 250, 252),
			BorderSizePixel = 0,
			ZIndex = 31,
			Parent = root,
		})
		UIUtil.Corner(group, 18)
		-- Contour fin (hors du CanvasGroup pour ne pas être rogné)
		local outline = UIUtil.Create("Frame", {
			Name = "Outline",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			ZIndex = 36,
			Parent = root,
		})
		UIUtil.Corner(outline, 18)
		local outlineStroke = UIUtil.Stroke(outline, Theme.Colors.Border, 1.5, 0.7)

		-- Icône de l'appli
		local icon = UIUtil.Create("Frame", {
			Name = "Icon",
			Size = UDim2.fromOffset(44, 44),
			Position = UDim2.fromOffset(11, (CARD_H - 44) / 2),
			BackgroundColor3 = data.Color,
			BorderSizePixel = 0,
			ZIndex = 32,
			Parent = group,
		})
		UIUtil.Corner(icon, 11)
		UIUtil.Gradient(icon, ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(205, 205, 205)), 90)
		UIUtil.Label({
			Text = data.Icon,
			Size = UDim2.fromScale(0.72, 0.72),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			MaxTextSize = 30,
			ZIndex = 33,
			Parent = icon,
		})

		-- Pastille rouge (nombre de notifs "non lues" de l'appli)
		local badge = UIUtil.Label({
			Text = tostring(variant % 9 + 1),
			Font = Theme.Fonts.Number,
			TextColor3 = Color3.new(1, 1, 1),
			BackgroundColor3 = Theme.Colors.Red,
			BackgroundTransparency = 0,
			Size = UDim2.fromOffset(18, 18),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0, 11 + 44 - 2, 0, (CARD_H - 44) / 2 + 3),
			MaxTextSize = 13,
			ZIndex = 34,
			Parent = group,
		})
		UIUtil.Corner(badge, UDim.new(1, 0))

		-- Nom de l'appli + "maintenant"
		UIUtil.Create("TextLabel", {
			Name = "App",
			Size = UDim2.fromOffset(CARD_W - 66 - 86, 18),
			Position = UDim2.fromOffset(66, 9),
			BackgroundTransparency = 1,
			Font = Theme.Fonts.Title,
			Text = upper(data.App),
			TextColor3 = Theme.Colors.TextDim,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 32,
			Parent = group,
		})
		UIUtil.Create("TextLabel", {
			Name = "Time",
			Size = UDim2.fromOffset(76, 18),
			Position = UDim2.fromOffset(CARD_W - 86, 9),
			BackgroundTransparency = 1,
			Font = Theme.Fonts.Body,
			Text = Locale.T("now"),
			TextColor3 = Theme.Colors.TextDim,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Right,
			ZIndex = 32,
			Parent = group,
		})

		-- Message
		UIUtil.Label({
			Name = "Message",
			Text = data.Text,
			Font = Theme.Fonts.Body,
			TextColor3 = Theme.Colors.TextDark,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Size = UDim2.fromOffset(CARD_W - 66 - 12, 34),
			Position = UDim2.fromOffset(66, 27),
			MaxTextSize = 16,
			ZIndex = 32,
			Parent = group,
		})

		-- Barre de temps restant
		local timeBar = UIUtil.Create("Frame", {
			Name = "TimeBar",
			Size = UDim2.fromOffset(CARD_W - 32, 3),
			Position = UDim2.fromOffset(16, CARD_H - 5),
			BackgroundColor3 = data.Color,
			BackgroundTransparency = 0.25,
			BorderSizePixel = 0,
			ZIndex = 33,
			Parent = group,
		})
		UIUtil.Corner(timeBar, UDim.new(1, 0))
		UIUtil.Tween(timeBar, lifetime, { Size = UDim2.fromOffset(0, 3) }, Enum.EasingStyle.Linear)

		local card = {
			Id = info.Id,
			Root = root,
			Scale = scale,
			Group = group,
			Shadow = shadow,
			Outline = outlineStroke,
			Color = data.Color,
			Expires = os.clock() + lifetime,
			Entered = false,
			Done = false,
		}
		byId[card.Id] = card
		table.insert(cards, 1, card)
		layout()

		ctx.Sound.Play("Notif", 0.95 + random:NextNumber() * 0.25)

		-- Vibration du téléphone (petite secousse en rotation)
		task.spawn(function()
			task.wait(0.35)
			for i = 1, 8 do
				if card.Done or not root.Parent or not ctx.IsAlive() then
					break
				end
				root.Rotation = (i % 2 == 0) and 1.6 or -1.6
				task.wait(0.035)
			end
			if root.Parent then
				root.Rotation = 0
			end
		end)

		-- Clic : on "ouvre" la notification
		ctx.Connect(root.Activated, function()
			if card.Done or not ctx.IsAlive() then
				return
			end
			local index = table.find(cards, card) or 1
			local position = UDim2.fromOffset(LEFT + CARD_W / 2, slotY(index) + CARD_H / 2)
			positions[card.Id] = position
			lastPosition = position
			ctx.ClaimSpawn(card.Id)
			ctx.Sound.Play("Click", 1.5)
			if effectsOn() then
				ctx.Effects.Burst(container, position, card.Color, 10)
			end
			dismiss(card, true)
			local id = card.Id
			task.delay(6, function()
				positions[id] = nil
			end)
		end)
	end

	-- Disparition automatique à la fin de la durée de vie
	ctx.OnRender(function()
		if #cards == 0 then
			return
		end
		local now = os.clock()
		for i = #cards, 1, -1 do
			local card = cards[i]
			if card and not card.Done and now >= card.Expires then
				dismiss(card, false)
			end
		end
	end)

	ctx.OnSpawn("Notif", spawnNotif)

	-- Bonus confirmé : "+X" sur la bannière
	ctx.OnBonus("Notif", function(payload)
		if not ctx.IsAlive() then
			return
		end
		local position = (payload.SpawnId and positions[payload.SpawnId]) or lastPosition
		ctx.FloatText(container, position, "+" .. ctx.Format.Format(tonumber(payload.Amount) or 0), Theme.Colors.Green, 34)
	end)
end

function PhoneNotifs.Stop(_ctx)
	-- Les bannières vivent dans ctx.Container (détruit par le StimulusManager)
end

return PhoneNotifs
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="160">
          <Properties>
            <string name="Name">Pinwheel</string>
            <string name="Source"><![CDATA[--[[
	Pinwheel (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > Pinwheel

	Un moulin à vent en papier illustré, planté dans un petit pot "kawaii"
	sur une colline, devant un ciel pastel (soleil, nuages qui passent).
	  - 4 pales vernies : grand triangle ombré (dégradé) + rabat plus clair
	    (le "pli" de la feuille), ligne de pliure brillante, petits pois ;
	    moyeu en perle avec reflet.
	  - Bâton en bois (dégradé + veines), pot en terre cuite avec un
	    visage, terre, deux feuilles et une petite fleur.
	  - Tourne en continu, avec des coups de vent de temps en temps. Plus
	    ça tourne vite, plus un disque "flou" coloré apparaît et des
	    lignes de vent traversent la carte (réserve recyclée, aucune
	    création d'instance par image).
	  - Clic / toucher = on souffle dessus : grosse accélération qui retombe
	    doucement, étincelles autour du moyeu... et à très haute vitesse, il
	    essaie de décoller. Chaque souffle envoie Interact("Spin") (limité
	    côté client à la recharge du serveur) ; le bonus arrive par
	    OnBonus("Spin").
	  - Pastille "compteur" en haut à gauche : petit cadran dont l'aiguille
	    et la couleur suivent la vitesse, et les tours / minute.
	v9 - "Énergie éolienne" (amélioration WindPower, 10 niveaux, lue avec
	ctx.GetLevel("WindPower"), mise à jour en direct) :
	  - une éolienne de plus sur les collines à chaque niveau (1 à 6 :
	    grandes devant, plus petites et voilées au loin), qui sort de terre
	    avec des étincelles et un coup de vent ; niveaux 7 à 10 : elles
	    grandissent et un feu rouge clignote en haut ; au niveau 10, de
	    petits éclairs d'énergie jaillissent des moyeux ;
	  - le moulin tourne plus vite au repos (+28 °/s par niveau), les coups
	    de vent sont plus fréquents, des lignes de vent traversent la carte
	    en continu (plus nombreuses à chaque niveau), les nuages filent.
	Performances : le décor (CanvasGroup redessiné à chaque changement :
	nuages, soleil, éoliennes) n'est mis à jour que 30 fois par seconde.
]]

local Locale = require(game:GetService("ReplicatedStorage").Shared.Locale)

local Pinwheel = {}
Pinwheel.Slot = "CL"

local BLADE = 42 -- côté du carré d'une pale (portée = BLADE * √2)
local BASE_SPEED = 70 -- degrés / seconde au repos
local BOOST = 540 -- ajout de vitesse par souffle
local MAX_SPEED = 2600
local DECAY = 0.9 -- vitesse de retour au calme
local WIND_POOL = 10 -- lignes de vent recyclées
local WIND_SPEED_PER_LEVEL = 28 -- vitesse de repos en plus par niveau de WindPower
local SPARKLE_POOL = 6 -- étincelles recyclées

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)

local BLADE_COLORS = {
	Color3.fromRGB(255, 84, 112), -- framboise
	Color3.fromRGB(255, 196, 46), -- miel
	Color3.fromRGB(64, 156, 255), -- ciel
	Color3.fromRGB(70, 206, 140), -- menthe
}

-- Éoliennes (une par niveau de WindPower, 1 à 6) : x, sol (y du haut de la
-- colline à cet endroit), hauteur du mât, colline ("Far" = gauche, "Near" = droite)
local TURBINES = {
	{ X = 22, Ground = 145, H = 46, Hill = "Far", Haze = 0 },
	{ X = 146, Ground = 150, H = 42, Hill = "Near", Haze = 0 },
	{ X = 46, Ground = 146, H = 31, Hill = "Far", Haze = 0.25 },
	{ X = 124, Ground = 148, H = 29, Hill = "Near", Haze = 0.25 },
	{ X = 9, Ground = 146, H = 25, Hill = "Far", Haze = 0.4 },
	{ X = 159, Ground = 152, H = 25, Hill = "Near", Haze = 0.4 },
}

local LIFT_TEXTS = {
	en = { "It's gonna take off! 🚁", "Hold on tight!", "Too much wind!!", "WHOOOOSH" },
	fr = { "Il va décoller ! 🚁", "Accroche-toi !", "Trop de vent !!", "WOUUUSH" },
}

-- Transparence "demi-carré" : une moitié opaque, l'autre invisible (bord net)
local function halfTransparency(opaqueFirst: boolean): NumberSequence
	local a, b = 0, 1
	if not opaqueFirst then
		a, b = 1, 0
	end
	return NumberSequence.new({
		NumberSequenceKeypoint.new(0, a),
		NumberSequenceKeypoint.new(0.495, a),
		NumberSequenceKeypoint.new(0.505, b),
		NumberSequenceKeypoint.new(1, b),
	})
end

-- Trait qui s'estompe aux deux bouts (lignes de vent, pliures)
local FADE_ENDS = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 1),
	NumberSequenceKeypoint.new(0.3, 0.1),
	NumberSequenceKeypoint.new(0.7, 0.1),
	NumberSequenceKeypoint.new(1, 1),
})

function Pinwheel.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local Create = UIUtil.Create
	local container: Frame = ctx.Container
	local random = Random.new()
	local spinConfig = ctx.Config.Interactions.Spin
	local cooldown = (spinConfig and spinConfig.Cooldown) or 2

	-- Taille de la carte = slot - 2 x 2 px (marge pour que son contour ne soit pas coupé)
	local slotSize = ctx.GetSlotSize and ctx.GetSlotSize() or Vector2.new(170, 170)
	local width = (slotSize.X > 0 and slotSize.X or 170) - 4
	local height = (slotSize.Y > 0 and slotSize.Y or 170) - 4
	local hubX, hubY = width / 2, math.floor(height * 0.41)
	local reach = math.ceil(BLADE * math.sqrt(2))

	-- Texte flottant dessiné dans le calque Overlay : il monte de 100 px et
	-- serait coupé par le slot (ClipsDescendants). `point` = position en
	-- pixels "design" dans `guiObject` (qui fait `designW` de large).
	local function floatOnOverlay(guiObject: GuiObject, designW: number, point: Vector2, text: string, color: Color3?, size: number?)
		local ratio = guiObject.AbsoluteSize.X / math.max(1, designW)
		local canvas = ctx.Interface.ScreenToCanvas(guiObject.AbsolutePosition + point * ratio)
		ctx.FloatText(ctx.Overlay, UDim2.fromOffset(canvas.X, canvas.Y), text, color, size)
	end

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	-- Petit cadre sans bordure
	local function frame(props: { [string]: any }): Frame
		props.BorderSizePixel = 0
		return Create("Frame", props)
	end

	-- Cadre centré sur (x, y)
	local function centered(props: { [string]: any }, x: number, y: number, w: number, h: number): Frame
		props.AnchorPoint = Vector2.new(0.5, 0.5)
		props.Position = UDim2.fromOffset(x, y)
		props.Size = UDim2.fromOffset(w, h)
		return frame(props)
	end

	local function round(guiObject: GuiObject)
		UIUtil.Corner(guiObject, UDim.new(1, 0))
	end

	------------------------------------------------------------------
	-- Carte : ciel pastel, soleil, nuages, collines
	------------------------------------------------------------------
	local card = frame({
		Name = "Card",
		-- 2 px de marge : le contour de la carte n'est pas coupé par le slot
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -4, 1, -4),
		BackgroundColor3 = WHITE,
		ClipsDescendants = true,
		Parent = container,
	})
	UIUtil.Corner(card, 18)
	UIUtil.Stroke(card, Theme.Colors.CardBorder, 2)
	UIUtil.Gradient(card, ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(148, 204, 255)),
		ColorSequenceKeypoint.new(0.6, Color3.fromRGB(214, 232, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 226, 234)),
	}), 90)
	local cardScale = Create("UIScale", { Parent = card })
	-- Décor (soleil, nuages, collines) dans un CanvasGroup arrondi : ClipsDescendants
	-- découpe en rectangle, les collines dépasseraient des coins arrondis de la carte
	local scenery = Create("CanvasGroup", {
		Name = "Scenery",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = card,
	})
	UIUtil.Corner(scenery, 18)

	-- Soleil (halo qui respire)
	local sunGlow = centered({ Name = "SunGlow", BackgroundColor3 = Color3.fromRGB(255, 240, 170), BackgroundTransparency = 0.6, ZIndex = 1, Parent = scenery }, width - 24, 24, 46, 46)
	round(sunGlow)
	local sun = centered({ Name = "Sun", BackgroundColor3 = Color3.fromRGB(255, 214, 90), ZIndex = 1, Parent = scenery }, width - 24, 24, 22, 22)
	round(sun)
	UIUtil.Gradient(sun, ColorSequence.new(Color3.fromRGB(255, 246, 190), Color3.fromRGB(255, 200, 80)), 45)

	-- Nuages (3 boules chacun) qui passent lentement
	local clouds = {}
	for i = 1, 2 do
		local cloud = centered({
			Name = "Cloud",
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.05,
			ZIndex = 1,
			Parent = scenery,
		}, 0, 0, i == 1 and 40 or 32, i == 1 and 13 or 11)
		round(cloud)
		for p = 1, 2 do
			local puff = frame({
				Name = "Puff",
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.fromScale(p == 1 and 0.36 or 0.64, 0.55),
				Size = UDim2.fromScale(p == 1 and 0.46 or 0.36, p == 1 and 1.35 or 1.05),
				BackgroundColor3 = WHITE,
				BackgroundTransparency = 0.05,
				ZIndex = 1,
				Parent = cloud,
			})
			round(puff)
		end
		table.insert(clouds, {
			Frame = cloud,
			X = width * (i == 1 and 0.22 or 0.7),
			Y = i == 1 and 22 or 50,
			Speed = random:NextNumber(3, 6),
		})
	end

	-- Collines (une claire au fond, une plus foncée devant)
	-- (ZIndex : éoliennes de gauche 2 < colline du fond 3 < éoliennes de droite 4 < colline de devant 5)
	local farHill = centered({ Name = "FarHill", BackgroundColor3 = Color3.fromRGB(150, 222, 150), ZIndex = 3, Parent = scenery }, width * 0.18, height + 14, 170, 70)
	round(farHill)
	local hill = centered({ Name = "Hill", BackgroundColor3 = WHITE, ZIndex = 5, Parent = scenery }, width * 0.62, height + 22, 240, 80)
	round(hill)
	UIUtil.Gradient(hill, ColorSequence.new(Color3.fromRGB(120, 214, 120), Color3.fromRGB(62, 160, 90)), 90)

	------------------------------------------------------------------
	-- v9 : éoliennes sur les collines (WindPower), cachées au départ
	------------------------------------------------------------------
	local HAZE = Color3.fromRGB(200, 224, 250) -- voile bleuté des éoliennes lointaines
	local turbines = {}
	for index, def in ipairs(TURBINES) do
		local blade = math.floor(def.H * 0.46 + 0.5)
		local hubSize = math.max(3, math.floor(def.H * 0.11))
		local tone = WHITE:Lerp(HAZE, def.Haze)
		local shade = Color3.fromRGB(164, 178, 204):Lerp(HAZE, def.Haze)
		local z = def.Hill == "Far" and 2 or 4
		-- Cadre ancré en bas au centre (pied du mât, caché par la colline) :
		-- le UIScale le fait grandir vers le haut
		local root = frame({
			Name = "Turbine" .. index,
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromOffset(def.X, def.Ground + 6),
			Size = UDim2.fromOffset(blade * 2, def.H + 6 + blade),
			BackgroundTransparency = 1,
			Visible = false,
			ZIndex = z,
			Parent = scenery,
		})
		local scale = Create("UIScale", { Parent = root })
		local tower = frame({
			Name = "Tower",
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromOffset(blade, blade),
			Size = UDim2.fromOffset(math.max(2, def.H * 0.075), def.H + 6),
			BackgroundColor3 = WHITE,
			ZIndex = z,
			Parent = root,
		})
		UIUtil.Gradient(tower, ColorSequence.new(tone, shade), 0)
		local nacelle = frame({
			Name = "Nacelle",
			AnchorPoint = Vector2.new(0.3, 0.5),
			Position = UDim2.fromOffset(blade, blade),
			Size = UDim2.fromOffset(hubSize * 2.4, hubSize * 1.3),
			BackgroundColor3 = tone:Lerp(shade, 0.35),
			ZIndex = z,
			Parent = root,
		})
		UIUtil.Corner(nacelle, 2)
		-- Rotor : 3 pales (chaque pale dans un carré tourné, centré sur le moyeu)
		local rotorFrame = frame({
			Name = "Blades",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(blade, blade),
			Size = UDim2.fromOffset(blade * 2, blade * 2),
			BackgroundTransparency = 1,
			ZIndex = z,
			Parent = root,
		})
		for bladeIndex = 0, 2 do
			local holder = frame({
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Rotation = bladeIndex * 120,
				ZIndex = z,
				Parent = rotorFrame,
			})
			local bladeFrame = frame({
				Name = "Blade",
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(math.max(1.5, def.H * 0.06), blade),
				BackgroundColor3 = WHITE,
				ZIndex = z,
				Parent = holder,
			})
			UIUtil.Gradient(bladeFrame, ColorSequence.new(shade, tone), 0)
		end
		local turbineHub = centered({ Name = "Hub", BackgroundColor3 = tone, ZIndex = z, Parent = root }, blade, blade, hubSize, hubSize)
		round(turbineHub)
		UIUtil.Stroke(turbineHub, shade:Lerp(BLACK, 0.25), 1, 0.3)
		-- Feu d'obstacle rouge (niveaux 7+), en haut de la nacelle
		local lamp = centered({
			Name = "Lamp",
			BackgroundColor3 = Color3.fromRGB(255, 56, 70),
			Visible = false,
			ZIndex = z,
			Parent = root,
		}, blade + hubSize * 0.8, blade - hubSize * 0.75, 3, 3)
		round(lamp)
		turbines[index] = {
			Root = root,
			Scale = scale,
			Rotor = rotorFrame,
			Lamp = lamp,
			Def = def,
			Angle = random:NextNumber(0, 120),
			Speed = random:NextNumber(0.85, 1.15),
			Shown = false,
		}
	end

	------------------------------------------------------------------
	-- Pot, terre, plante et bâton en bois
	------------------------------------------------------------------
	local potTop = height - 38
	local stick = frame({
		Name = "Stick",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromOffset(hubX, hubY),
		Size = UDim2.fromOffset(7, potTop - hubY + 6),
		BackgroundColor3 = WHITE,
		ZIndex = 3,
		Parent = card,
	})
	UIUtil.Corner(stick, 3)
	UIUtil.Gradient(stick, ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(246, 214, 160)),
		ColorSequenceKeypoint.new(0.45, Color3.fromRGB(226, 176, 110)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(158, 104, 58)),
	}), 0)
	-- Veines du bois
	for i, spec in ipairs({ { 2, 0.15, 0.55 }, { 4.5, 0.4, 0.5 } }) do
		frame({
			Name = "Grain" .. i,
			Position = UDim2.new(0, spec[1], spec[2], 0),
			Size = UDim2.new(0, 1, spec[3], 0),
			BackgroundColor3 = Color3.fromRGB(130, 82, 40),
			BackgroundTransparency = 0.55,
			ZIndex = 3,
			Parent = stick,
		})
	end

	-- Plante : deux feuilles + une petite fleur sur sa tige
	local LEAF = ColorSequence.new(Color3.fromRGB(150, 230, 120), Color3.fromRGB(56, 160, 80))
	for side = -1, 1, 2 do
		local leaf = frame({
			Name = "Leaf",
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromOffset(hubX + side * 12, potTop + 3),
			Size = UDim2.fromOffset(10, 22),
			Rotation = side * 38,
			BackgroundColor3 = WHITE,
			ZIndex = 4,
			Parent = card,
		})
		round(leaf)
		UIUtil.Gradient(leaf, LEAF, 90)
	end
	local flowerX, flowerY = hubX - 22, potTop - 24
	frame({
		Name = "Stem",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromOffset(flowerX + 2, flowerY),
		Size = UDim2.fromOffset(2, potTop - flowerY + 2),
		Rotation = -10,
		BackgroundColor3 = Color3.fromRGB(70, 170, 90),
		ZIndex = 4,
		Parent = card,
	})
	local flower = centered({ Name = "Flower", BackgroundTransparency = 1, ZIndex = 5, Parent = card }, flowerX, flowerY, 16, 16)
	for p = 0, 3 do

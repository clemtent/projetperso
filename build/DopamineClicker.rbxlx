	local eqWidth = 94
	local eq = frame({
		Name = "Equalizer",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(eqWidth, 30),
		BackgroundTransparency = 1,
		Parent = bar,
	})
	local barWidth = 5
	local barGap = (eqWidth - EQ_BARS * barWidth) / (EQ_BARS - 1)
	local eqBars: { Frame } = {}
	local eqHeights: { number } = {}
	local eqTargets: { number } = {}
	for i = 1, EQ_BARS do
		local t = (i - 1) / (EQ_BARS - 1)
		local eqBar = frame({
			Name = "Bar" .. i,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, (i - 1) * (barWidth + barGap), 1, 0),
			Size = UDim2.fromOffset(barWidth, 4),
			BackgroundColor3 = EQ_LOW:Lerp(EQ_HIGH, t),
			Parent = eq,
		})
		UI.Corner(eqBar, 2)
		eqBars[i] = eqBar
		eqHeights[i] = 0.2
		eqTargets[i] = 0.2
	end

	------------------------------------------------------------------
	-- Spectateurs + titre du morceau (alternent dans le sous-titre)
	------------------------------------------------------------------
	local viewers = random:NextInteger(8000, 14000)
	local trackIndex = random:NextInteger(1, #TRACKS)
	local showTrack = false

	local function refreshSubtitle()
		if showTrack then
			subtitle.Text = "♫ " .. TRACKS[trackIndex]
		else
			local text = viewers >= 1e6 and Format.Format(viewers) or Format.WithSpaces(viewers)
			subtitle.Text = "🔴 " .. text .. " personnes révisent (ou pas)"
		end
	end
	refreshSubtitle()

	local function refreshClock()
		-- Roblox : os.date ne gère que "*t" / "!*t" (heure locale du joueur)
		local now = os.date("*t")
		if type(now) == "table" and now.hour and now.min then
			clockLabel.Text = string.format("%02d:%02d", now.hour, now.min)
		end
	end
	refreshClock()

	task.spawn(function()
		local tick = 0
		while ctx.IsAlive() do
			task.wait(1)
			if not ctx.IsAlive() then
				break
			end
			tick += 1
			-- Spectateurs : petite marche aléatoire
			viewers = math.clamp(viewers + random:NextInteger(-40, 55), 3000, 99999)
			if tick % 6 == 0 then
				showTrack = not showTrack
				if showTrack and random:NextNumber() < 0.5 then
					trackIndex = trackIndex % #TRACKS + 1
				end
				subtitle.TextTransparency = 1
				UI.Tween(subtitle, 0.4, { TextTransparency = 0 })
			end
			refreshSubtitle()
			if tick % 10 == 0 then
				refreshClock()
			end
			-- Une fenêtre de la ville s'allume / s'éteint de temps en temps
			if #litWindows > 0 and random:NextNumber() < 0.25 then
				local lit = litWindows[random:NextInteger(1, #litWindows)]
				lit.BackgroundTransparency = lit.BackgroundTransparency < 0.5 and 1 or 0
			end
		end
	end)

	-- Étoile filante de temps en temps
	task.spawn(function()
		while ctx.IsAlive() do
			task.wait(random:NextNumber(10, 22))
			if not ctx.IsAlive() then
				break
			end
			if effectsOn() then
				local startX = random:NextNumber(10, GLASS_W * 0.5)
				shootingStar.Position = UDim2.fromOffset(startX, random:NextNumber(4, 20))
				shootingStar.BackgroundTransparency = 0
				shootingStar.Visible = true
				local travel = random:NextNumber(60, 90)
				UI.Tween(shootingStar, 0.7, {
					Position = UDim2.fromOffset(startX + travel, 4 + travel * math.tan(math.rad(18))),
					BackgroundTransparency = 1,
				}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				task.wait(0.75)
				shootingStar.Visible = false
			end
		end
	end)

	------------------------------------------------------------------
	-- Animation (une seule boucle de rendu)
	------------------------------------------------------------------
	local clock = 0
	local eqTimer = 0
	local beatCount = 0
	local rainDX = math.tan(RAIN_ANGLE)
	ctx.OnRender(function(dt: number)
		clock += dt
		local fx = effectsOn()

		-- Pluie (traits recyclés)
		for _, drop in ipairs(drops) do
			drop.Y += drop.Speed * dt
			drop.X -= drop.Speed * rainDX * dt
			if drop.Y > GLASS_H + 10 or drop.X < -10 then
				drop.Y = random:NextNumber(-24, -6)
				drop.X = random:NextNumber(0, GLASS_W + 30)
			end
			drop.Frame.Position = UDim2.fromOffset(drop.X, drop.Y)
		end

		-- Gouttes sur la vitre (glissent lentement, par à-coups)
		for _, bead in ipairs(beads) do
			local jerk = (math.sin(clock * 2 + bead.X) > 0.6) and 3 or 0.4
			bead.Y += bead.Speed * jerk * dt
			if bead.Y > GLASS_H + 6 then
				bead.Y = -6
				bead.X = random:NextNumber(8, GLASS_W - 8)
			end
			bead.Frame.Position = UDim2.fromOffset(bead.X, bead.Y)
		end

		-- Étoiles
		for _, star in ipairs(stars) do
			star.Frame.BackgroundTransparency = 0.2 + 0.7 * (0.5 + 0.5 * math.sin(clock * star.Speed + star.Phase))
		end
		moonGlow.BackgroundTransparency = 0.8 + 0.06 * math.sin(clock * 0.8)

		-- Lueur de la lampe qui "respire" (+ petit grésillement rare)
		local breath = 0.5 + 0.5 * math.sin(clock * 1.2)
		local flicker = (math.sin(clock * 37) > 0.985) and 0.06 or 0
		for i, glow in ipairs(glows) do
			glow.BackgroundTransparency = math.min(1, GLOW_ALPHA[i] + (1 - breath) * 0.05 + flicker)
		end
		bulb.BackgroundTransparency = flicker * 4

		-- Chat : respiration, queue qui ondule, "z z z"
		bodyScale.Scale = 1 + 0.035 * (0.5 + 0.5 * math.sin(clock * 1.6))
		tail.Rotation = -18 + math.sin(clock * 0.9) * 10
		for i, z in ipairs(zLabels) do
			local p = ((clock / 3.3) + (i - 1) / 3) % 1
			z.Position = UDim2.fromOffset(headX + 8 + p * 22 + math.sin(p * 6) * 3, headY - 12 - p * 44)
			z.TextSize = 9 + p * 9
			z.TextTransparency = p < 0.12 and (1 - p / 0.12) or (p * p)
		end

		-- Étudiant qui hoche la tête en rythme
		local beatPhase = (clock % BEAT) / BEAT
		local nod = math.sin(beatPhase * math.pi)
		person.Position = UDim2.fromOffset(PERSON_X, DESK_Y + 12 + nod * 3)
		person.Rotation = math.sin(clock * math.pi / BEAT) * 3
		headphones.Rotation = -person.Rotation * 0.3

		-- Notes de musique
		for i, note in ipairs(notes) do
			if fx then
				local p = ((clock / 2.6) + (i - 1) * 0.5) % 1
				note.Visible = true
				note.Position = UDim2.fromOffset(PERSON_X + 20 + p * 26, 96 - p * 50)
				note.Rotation = math.sin(p * 8) * 20
				note.TextTransparency = p < 0.15 and (1 - p / 0.15) or p
			else
				note.Visible = false
			end
		end

		-- Vapeur du café
		for i, puff in ipairs(steam) do
			if fx then
				local p = ((clock / 2.2) + (i - 1) / 3) % 1
				puff.Position = UDim2.fromOffset(mugX + math.sin(p * 7 + i) * 4, DESK_Y - 18 - p * 26)
				puff.Size = UDim2.fromOffset(4 + p * 6, 4 + p * 6)
				puff.BackgroundTransparency = 0.45 + p * 0.55
			else
				puff.BackgroundTransparency = 1
			end
		end

		-- Égaliseur : nouvelles cibles ~ 9 fois par seconde, basses sur le temps
		eqTimer -= dt
		if eqTimer <= 0 then
			eqTimer = 0.11
			local newBeat = math.floor(clock / BEAT)
			local onBeat = newBeat ~= beatCount
			beatCount = newBeat
			for i = 1, EQ_BARS do
				local low = 1 - (i - 1) / (EQ_BARS - 1)
				local base = 0.15 + random:NextNumber() * 0.55
				if onBeat then
					base += low * 0.45
				end
				eqTargets[i] = math.clamp(base, 0.1, 1)
			end
		end
		local k = math.min(1, dt * 14)
		for i, eqBar in ipairs(eqBars) do
			eqHeights[i] += (eqTargets[i] - eqHeights[i]) * k
			eqBar.Size = UDim2.fromOffset(barWidth, math.floor(3 + eqHeights[i] * 27))
		end
	end)
end

return Lofi
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">LootBox</string>
            <string name="Source"><![CDATA[--[[
	LootBox (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > LootBox

	Coffre mystère (slot CR) dessiné en code : corps en bois, couvercle,
	bandes dorées, serrure. Il se recharge avec le temps de jeu
	(State.Data.Chests : Stored / Progress / Max) :
	  - jauge "Prochain coffre" en bas (prédite en douceur côté client) ;
	  - pastille rouge = nombre de coffres en stock ;
	  - quand un coffre est prêt, il sautille et brille pour qu'on le touche.
	Clic -> OpenChest (serveur) : le coffre tremble, le couvercle saute,
	des rayons de la couleur du rang tournent, puis le rang (Commun, Rare,
	Épique, LÉGENDAIRE) et le gain s'affichent. Légendaire = gros message
	+ confettis.
]]

local Debris = game:GetService("Debris")

local LootBox = {}
LootBox.Slot = "CR"

local CHEST_Y = 84 -- centre vertical du coffre dans la carte
local RAY_COUNT = 6 -- barres (chacune donne 2 rayons opposés)
local MAX_SPARKLES = 4

local EMPTY_HINTS = {
	"Ça charge… ⏳",
	"Patience, petit scarabée",
	"Le coffre fait la sieste 😴",
}

local READY_HINTS = {
	"Touche pour ouvrir !",
	"Ouvre-moi ! 👀",
	"Qu'y a-t-il dedans ?",
}

function LootBox.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local Create = UIUtil.Create
	local Format = ctx.Format
	local config = ctx.Config.LootBox
	local container: Frame = ctx.Container
	local random = Random.new()

	local width = container.Size.X.Offset > 0 and container.Size.X.Offset or 170
	local height = container.Size.Y.Offset > 0 and container.Size.Y.Offset or 170
	local centerX = width / 2

	local gold = Theme.Colors.Gold
	local white = Color3.new(1, 1, 1)
	local wood = Color3.fromRGB(176, 104, 48)
	local woodDark = Color3.fromRGB(110, 60, 24)
	local woodLine = Color3.fromRGB(70, 36, 12)

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	local function readChests(): (number, number, number)
		local data = ctx.State.Data
		local chests = data and data.Chests
		if type(chests) ~= "table" then
			return 0, 0, config.MaxStored or 5
		end
		return tonumber(chests.Stored) or 0, tonumber(chests.Progress) or 0, tonumber(chests.Max) or config.MaxStored or 5
	end

	------------------------------------------------------------------
	-- Carte (toute la carte est cliquable)
	------------------------------------------------------------------
	local card = Create("TextButton", {
		Name = "Card",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = white,
		AutoButtonColor = false,
		Text = "",
		BorderSizePixel = 0,
		ZIndex = 1,
		Parent = container,
	})
	UIUtil.Corner(card, 18)
	UIUtil.Stroke(card, Theme.Colors.CardBorder, 2)
	UIUtil.Gradient(card, ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(234, 224, 255)), 90)
	local cardScale = Create("UIScale", { Parent = card })

	local title = UIUtil.Label({
		Text = "Coffre mystère",
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.TextDark,
		Position = UDim2.fromOffset(10, 6),
		Size = UDim2.new(1, -44, 0, 18),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 15,
		ZIndex = 2,
		Parent = card,
	})

	-- Pastille : coffres en stock
	local badge = UIUtil.Label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -20, 0, 18),
		Size = UDim2.fromOffset(28, 28),
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Colors.Red,
		Font = Theme.Fonts.Number,
		TextColor3 = white,
		Text = "0",
		MaxTextSize = 16,
		Visible = false,
		ZIndex = 12,
		Parent = card,
	})
	UIUtil.Corner(badge, UDim.new(1, 0))
	UIUtil.Stroke(badge, white, 2)
	local badgeScale = Create("UIScale", { Parent = badge })

	------------------------------------------------------------------
	-- Lueur + rayons (derrière le coffre)
	------------------------------------------------------------------
	local glow = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(centerX, CHEST_Y),
		Size = UDim2.fromOffset(112, 112),
		BackgroundColor3 = gold,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = card,
	})
	UIUtil.Corner(glow, UDim.new(1, 0))

	local rays = {}
	for index = 1, RAY_COUNT do
		local ray = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(centerX, CHEST_Y - 6),
			Size = UDim2.fromOffset(230, 16),
			BackgroundColor3 = gold,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 2,
			Parent = card,
		})
		Create("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.35, 0.35),
				NumberSequenceKeypoint.new(0.5, 0.1),
				NumberSequenceKeypoint.new(0.65, 0.35),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = ray,
		})
		rays[index] = { Frame = ray, Base = (index - 1) * (180 / RAY_COUNT) }
	end

	------------------------------------------------------------------
	-- Le coffre (groupe 96x76)
	------------------------------------------------------------------
	local chest = Create("Frame", {
		Name = "Chest",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(centerX, CHEST_Y),
		Size = UDim2.fromOffset(96, 76),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = card,
	})
	local chestScale = Create("UIScale", { Parent = chest })

	local shadow = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(48, 73),
		Size = UDim2.fromOffset(82, 10),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.82,
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = chest,
	})
	UIUtil.Corner(shadow, UDim.new(1, 0))

	-- Lumière qui sort du coffre ouvert
	local innerLight = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(48, 32),
		Size = UDim2.fromOffset(74, 12),
		BackgroundColor3 = gold,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = chest,
	})
	UIUtil.Corner(innerLight, UDim.new(1, 0))

	local body = Create("Frame", {
		Position = UDim2.fromOffset(8, 30),
		Size = UDim2.fromOffset(80, 42),
		BackgroundColor3 = white,
		BorderSizePixel = 0,
		ZIndex = 4,
		Parent = chest,
	})
	UIUtil.Corner(body, 8)
	UIUtil.Stroke(body, woodLine, 2)
	UIUtil.Gradient(body, ColorSequence.new(wood, woodDark), 90)
	-- Planches
	for _, y in ipairs({ 14, 28 }) do
		Create("Frame", {
			Position = UDim2.fromOffset(2, y),
			Size = UDim2.new(1, -4, 0, 1),
			BackgroundColor3 = woodLine,
			BackgroundTransparency = 0.5,
			BorderSizePixel = 0,
			ZIndex = 5,
			Parent = body,
		})
	end
	for _, x in ipairs({ 10, 63 }) do
		local band = Create("Frame", {
			Position = UDim2.fromOffset(x, 0),
			Size = UDim2.new(0, 7, 1, 0),
			BackgroundColor3 = gold,
			BorderSizePixel = 0,
			ZIndex = 6,
			Parent = body,
		})
		UIUtil.Gradient(band, ColorSequence.new(Color3.fromRGB(255, 240, 170), Color3.fromRGB(200, 140, 0)), 0)
	end

	local lidRest = UDim2.fromOffset(48, 34)
	local lid = Create("Frame", {
		Name = "Lid",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = lidRest,
		Size = UDim2.fromOffset(86, 28),
		BackgroundColor3 = white,
		BorderSizePixel = 0,
		ZIndex = 7,
		Parent = chest,
	})
	UIUtil.Corner(lid, 12)
	UIUtil.Stroke(lid, woodLine, 2)
	UIUtil.Gradient(lid, ColorSequence.new(Color3.fromRGB(206, 132, 70), wood), 90)
	for _, x in ipairs({ 13, 66 }) do
		local band = Create("Frame", {
			Position = UDim2.fromOffset(x, 0),
			Size = UDim2.new(0, 7, 1, 0),
			BackgroundColor3 = gold,
			BorderSizePixel = 0,
			ZIndex = 8,
			Parent = lid,
		})
		UIUtil.Gradient(band, ColorSequence.new(Color3.fromRGB(255, 240, 170), Color3.fromRGB(200, 140, 0)), 0)
	end
	-- Serrure (accrochée au couvercle : elle part avec lui)
	local lock = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 1, 2),
		Size = UDim2.fromOffset(16, 18),
		BackgroundColor3 = gold,
		BorderSizePixel = 0,
		ZIndex = 9,
		Parent = lid,
	})
	UIUtil.Corner(lock, 4)
	UIUtil.Stroke(lock, Color3.fromRGB(110, 70, 0), 1.5)
	local keyhole = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(5, 5),
		BackgroundColor3 = woodLine,
		BorderSizePixel = 0,
		ZIndex = 10,
		Parent = lock,
	})
	UIUtil.Corner(keyhole, UDim.new(1, 0))

	------------------------------------------------------------------
	-- Textes : indice, rang, gain
	------------------------------------------------------------------
	local hint = UIUtil.Label({
		Text = "",
		Font = Theme.Fonts.Body,
		TextColor3 = Theme.Colors.TextDim,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromOffset(centerX, 124),
		Size = UDim2.new(1, -16, 0, 16),
		MaxTextSize = 13,
		ZIndex = 4,
		Parent = card,
	})

	local tierLabel = UIUtil.Label({
		Text = "",
		Font = Theme.Fonts.Title,
		TextColor3 = gold,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(centerX, 20),
		Size = UDim2.new(1, -12, 0, 26),
		MaxTextSize = 22,
		TextTransparency = 1,
		ZIndex = 13,
		Parent = card,
	})
	local tierStroke = UIUtil.Stroke(tierLabel, Theme.Colors.TextDark, 2, 1)
	tierStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	local tierScale = Create("UIScale", { Parent = tierLabel })

	local amountLabel = UIUtil.Label({
		Text = "",
		Font = Theme.Fonts.Number,
		TextColor3 = Theme.Colors.TextDark,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(centerX, 131),
		Size = UDim2.new(1, -12, 0, 22),
		MaxTextSize = 20,
		TextTransparency = 1,
		ZIndex = 13,
		Parent = card,
	})
	local amountStroke = UIUtil.Stroke(amountLabel, white, 2, 1)
	amountStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual

	------------------------------------------------------------------
	-- Jauge de recharge
	------------------------------------------------------------------
	local bar = Create("Frame", {
		Name = "Charge",
		Position = UDim2.fromOffset(12, height - 26),
		Size = UDim2.new(1, -24, 0, 16),
		BackgroundColor3 = Color3.fromRGB(230, 230, 236),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 4,
		Parent = card,
	})
	UIUtil.Corner(bar, UDim.new(1, 0))
	UIUtil.Stroke(bar, Theme.Colors.Border, 1.5)
	local fill = Create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = white,
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = bar,
	})
	UIUtil.Corner(fill, UDim.new(1, 0))
	UIUtil.Gradient(fill, ColorSequence.new(Color3.fromRGB(255, 220, 60), Color3.fromRGB(255, 130, 30)), 0)
	local barText = UIUtil.Label({
		Text = "",
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.TextDark,
		Size = UDim2.new(1, -8, 1, -2),
		Position = UDim2.fromOffset(4, 1),
		MaxTextSize = 11,
		ZIndex = 6,
		Parent = bar,
	})

	------------------------------------------------------------------
	-- Suivi du stock et de la charge
	------------------------------------------------------------------
	local stored, serverProgress, maxStored = readChests()
	local progressTime = os.clock()
	local shownFill = 0
	local opening = false
	local hintIndex = random:NextInteger(1, 3)

	local function refreshBadge()
		badge.Visible = stored > 0
		badge.Text = tostring(math.floor(stored))
	end

	local function refreshHint()
		if opening then
			return
		end
		hint.TextColor3 = Theme.Colors.TextDim
		if stored >= 1 then
			hint.Text = READY_HINTS[((hintIndex - 1) % #READY_HINTS) + 1]
			hint.TextColor3 = Theme.Colors.Purple
		else
			hint.Text = EMPTY_HINTS[((hintIndex - 1) % #EMPTY_HINTS) + 1]
		end
	end

	refreshBadge()
	refreshHint()

	ctx.Connect(ctx.State.Changed, function()
		local newStored, newProgress, newMax = readChests()
		if newProgress ~= serverProgress then
			serverProgress = newProgress
			progressTime = os.clock()
		end
		maxStored = newMax
		if newStored ~= stored then
			local gained = newStored > stored
			stored = newStored
			refreshBadge()
			refreshHint()
			if gained and not opening then
				-- Nouveau coffre prêt : petit "pop" du badge
				ctx.Sound.Play("Bonus", 1.4)
				badgeScale.Scale = 1.6
				UIUtil.Tween(badgeScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
				ctx.FloatText(card, UDim2.fromOffset(centerX, CHEST_Y - 30), "+1 📦", Theme.Colors.Purple, 22)
			end
		end
	end)

	------------------------------------------------------------------
	-- Animation continue
	------------------------------------------------------------------
	local elapsed = 0
	local shakeAmount = 0 -- tremblement pendant l'ouverture
	local raysAlpha = 1 -- 1 = rayons invisibles
	local sparkles = 0
	local sparkleClock = 0
	local barLastText = ""

	local function spawnSparkle()
		if sparkles >= MAX_SPARKLES or not effectsOn() then
			return
		end
		sparkles += 1
		local star = UIUtil.Label({
			Text = random:NextNumber() < 0.5 and "✨" or "⭐",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(centerX + random:NextNumber(-52, 52), CHEST_Y + random:NextNumber(-40, 20)),
			Size = UDim2.fromOffset(18, 18),
			MaxTextSize = 16,
			ZIndex = 11,
			Parent = card,
		})
		local scale = Create("UIScale", { Scale = 0.2, Parent = star })
		UIUtil.Tween(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		UIUtil.Tween(star, 0.8, {
			TextTransparency = 1,
			Position = star.Position + UDim2.fromOffset(0, -14),
			Rotation = random:NextNumber(-40, 40),
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Debris:AddItem(star, 0.85)
		task.delay(0.85, function()
			sparkles -= 1
		end)
	end

	ctx.OnRender(function(dt: number)
		elapsed += dt

		-- Charge (prédite entre deux états du serveur)
		local target
		if stored >= maxStored then
			target = 1
		else
			target = math.clamp(serverProgress + (os.clock() - progressTime) / (config.ChargeInterval or 90), 0, 1)
		end
		shownFill += (target - shownFill) * math.min(1, dt * 6)
		if target < shownFill - 0.5 then
			shownFill = target -- nouveau cycle : on repart de zéro
		end
		fill.Size = UDim2.fromScale(shownFill, 1)
		local text = stored >= maxStored and "Plein ! Ouvre-moi 😤" or ("Prochain : " .. math.floor(target * 100) .. " %")
		if text ~= barLastText then
			barLastText = text
			barText.Text = text
		end

		-- Coffre : tremblement (ouverture) ou petit saut d'impatience
		local offsetX, offsetY, rotation = 0, 0, 0
		if shakeAmount > 0 then
			offsetX = math.sin(elapsed * 55) * shakeAmount * 0.6
			rotation = math.sin(elapsed * 47) * shakeAmount
		elseif stored >= 1 and not opening then
			local phase = elapsed % 2.2
			if phase < 0.45 then
				local hop = math.sin(phase / 0.45 * math.pi)
				offsetY = -hop * 9
				rotation = math.sin(phase / 0.45 * math.pi * 2) * 5
			end
			glow.BackgroundTransparency = 0.78 + math.sin(elapsed * 3) * 0.08
			sparkleClock += dt
			if sparkleClock > 0.55 then
				sparkleClock = 0
				spawnSparkle()
			end
		elseif not opening then
			glow.BackgroundTransparency = math.min(1, glow.BackgroundTransparency + dt)
		end
		chest.Position = UDim2.fromOffset(centerX + offsetX, CHEST_Y + offsetY)
		chest.Rotation = rotation

		-- Rayons tournants
		if raysAlpha < 1 then
			for _, ray in ipairs(rays) do
				ray.Frame.Rotation = ray.Base + elapsed * 40
				ray.Frame.BackgroundTransparency = raysAlpha
			end
		end
	end)

	-- Survol (PC)
	ctx.Connect(card.MouseEnter, function()
		UIUtil.Tween(cardScale, 0.15, { Scale = 1.03 }, Enum.EasingStyle.Back)
	end)
	ctx.Connect(card.MouseLeave, function()
		UIUtil.Tween(cardScale, 0.15, { Scale = 1 })
	end)

	------------------------------------------------------------------
	-- Ouverture
	------------------------------------------------------------------
	local function findTier(id: any)
		for index, tier in ipairs(config.Tiers) do
			if tier.Id == id then
				return tier, index
			end
		end
		return config.Tiers[1], 1
	end

	local function waitAlive(seconds: number): boolean
		local finish = os.clock() + seconds
		while os.clock() < finish do
			if not ctx.IsAlive() then
				return false
			end
			task.wait()
		end
		return ctx.IsAlive()
	end

	local function closeChest()
		UIUtil.Tween(lid, 0.35, { Position = lidRest, Rotation = 0 }, Enum.EasingStyle.Back)
		UIUtil.Tween(innerLight, 0.3, { BackgroundTransparency = 1 })
		glow.BackgroundColor3 = gold
		UIUtil.Tween(tierLabel, 0.3, { TextTransparency = 1 })
		UIUtil.Tween(tierStroke, 0.3, { Transparency = 1 })
		UIUtil.Tween(amountLabel, 0.3, { TextTransparency = 1 })
		UIUtil.Tween(amountStroke, 0.3, { Transparency = 1 })
		UIUtil.Tween(title, 0.3, { TextTransparency = 0 })
		UIUtil.Tween(hint, 0.3, { TextTransparency = 0 })
		task.spawn(function()
			local startAlpha = raysAlpha
			for i = 1, 10 do
				raysAlpha = startAlpha + (1 - startAlpha) * (i / 10)
				task.wait(0.03)
			end
			raysAlpha = 1
			for _, ray in ipairs(rays) do
				if ray.Frame.Parent then
					ray.Frame.BackgroundTransparency = 1
				end
			end
		end)
	end

	local function reveal(result)
		local tier, tierIndex = findTier(result.Tier)
		local color: Color3 = tier.Color or gold
		local amount = tonumber(result.Amount) or 0
		local amountText = "+" .. Format.Format(amount)

		shakeAmount = 0
		ctx.Sound.Play("Chest", 1)
		-- Le couvercle saute
		UIUtil.Tween(lid, 0.35, { Position = lidRest + UDim2.fromOffset(-10, -26), Rotation = -32 }, Enum.EasingStyle.Back)
		chestScale.Scale = 1.25
		UIUtil.Tween(chestScale, 0.5, { Scale = 1 }, Enum.EasingStyle.Elastic)
		innerLight.BackgroundColor3 = color
		innerLight.BackgroundTransparency = 0.1
		glow.BackgroundColor3 = color
		glow.BackgroundTransparency = 0.6
		for _, ray in ipairs(rays) do
			ray.Frame.BackgroundColor3 = color
		end
		raysAlpha = 0.35

		-- Rang + gain
		title.TextTransparency = 1
		hint.TextTransparency = 1
		tierLabel.Text = tostring(tier.Name or tier.Id)
		tierLabel.TextColor3 = color
		tierLabel.TextTransparency = 0
		tierStroke.Transparency = 0
		tierScale.Scale = 0.2
		UIUtil.Tween(tierScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
		amountLabel.Text = amountText
		amountLabel.TextTransparency = 0
		amountStroke.Transparency = 0

		if effectsOn() then
			ctx.Effects.Burst(card, UDim2.fromOffset(centerX, CHEST_Y - 10), color, 6 + tierIndex * 4)
		end
		ctx.FloatText(card, UDim2.fromOffset(centerX, CHEST_Y - 20), amountText, color, 26)

		if tier.Id == "Legendary" or tierIndex >= #config.Tiers then
			ctx.Sound.Play("Jackpot", 1)
			ctx.Effects.Flash(color, 0.5)
			ctx.Effects.BigMessage("📦 " .. tostring(tier.Name) .. " ! " .. amountText, color, 2.5)
			if effectsOn() then
				ctx.Effects.Confetti(80)
			end
		elseif tierIndex >= 3 then
			ctx.Sound.Play("SlotWin", 1.1)
			if effectsOn() then
				ctx.Effects.Confetti(30)
			end
		elseif tierIndex == 2 then
			ctx.Sound.Play("Bonus", 1.2)
		end
	end

	-- Petit "non" : le coffre gigote (UIUtil.Shake serait écrasé par l'animation)
	local function wobble()
		shakeAmount = 7
		task.delay(0.3, function()
			if not opening then
				shakeAmount = 0
			end
		end)
	end

	local function open()
		if opening or not ctx.IsAlive() then
			return
		end
		if stored < 1 then
			ctx.Sound.Play("Error", 1)
			wobble()
			hint.Text = "Pas encore de coffre ! ⏳"
			hint.TextColor3 = Theme.Colors.Red
			return
		end

		opening = true
		hint.Text = "Ouverture… 🤞"
		hint.TextColor3 = Theme.Colors.TextDark
		ctx.Sound.Play("Open", 1)

		task.spawn(function()
			local started = os.clock()
			-- Tremblement de plus en plus fort pendant l'appel serveur
			local shaking = true
			task.spawn(function()
				while shaking and ctx.IsAlive() do
					shakeAmount = math.min(10, 2 + (os.clock() - started) * 12)
					task.wait()
				end
			end)

			local callOk, success, result = pcall(function()
				return ctx.Net.Function("OpenChest"):InvokeServer()
			end)
			local ok = waitAlive(math.max(0, 0.7 - (os.clock() - started)))
			shaking = false
			shakeAmount = 0
			if not ok then
				return
			end

			if callOk and success == true and type(result) == "table" then
				reveal(result)
				if not waitAlive(2) then
					return
				end
				closeChest()
				if not waitAlive(0.35) then
					return
				end
			else
				local message = (callOk and type(result) == "string") and result or "Le coffre est coincé 🔒"
				ctx.Sound.Play("Error", 1)
				wobble()
				ctx.Notify(message, Theme.Colors.Red)
			end

			opening = false
			hintIndex += 1
			refreshHint()
		end)
	end

	ctx.Connect(card.Activated, open)

	-- Change le petit texte de temps en temps
	task.spawn(function()
		while ctx.IsAlive() do
			task.wait(6)
			if not ctx.IsAlive() then
				break
			end
			hintIndex += 1
			refreshHint()
		end
	end)
end

return LootBox
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Megaphone</string>
            <string name="Source"><![CDATA[--[[
	Megaphone (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > Megaphone

	Toutes les 4 à 9 secondes, un GROS mot d'encouragement est "crié" à
	l'écran ("INCROYABLE !!!", "LET'S GO"...) : il arrive en s'écrasant,
	tremble, laisse un écho et une onde de choc, puis s'envole.
	Crie aussi quand il se passe quelque chose de spécial (jackpot, rush,
	succès). Purement visuel : aucune récompense, aucun appel serveur.
]]

local Debris = game:GetService("Debris")

local Megaphone = {}
Megaphone.Slot = "Overlay"

local MAX_ACTIVE = 2

local WORDS = {
	"INCROYABLE !!!", "WOW", "ÉNORME", "LET'S GO", "MAGNIFIQUE", "QUEL CLIC !", "LÉGENDAIRE",
	"PHÉNOMÉNAL", "OUI OUI OUI", "C'EST FOU", "TROP FORT", "MONSTRUEUX", "INARRÊTABLE",
	"DOPAMINE !!!", "ALLEZ ALLEZ", "BRAVO CHAMPION", "IMPRESSIONNANT", "WAOUH", "ON Y CROIT",
	"RECORD ?!", "EXTRAORDINAIRE", "LA FOLIE", "PLUS VITE !", "ENCORE !!!", "GIGANTESQUE",
	"SPECTACULAIRE", "HISTORIQUE", "ÇA CLIQUE SEC", "OH LÀ LÀ", "SENSATIONNEL", "QUEL TALENT",
	"CLIQUE CLIQUE", "TU ES EN FEU", "IN-CRO-YABLE", "PERSONNE N'Y CROYAIT",
}

-- Petits commentaires (parfois) sous le mot crié
local ASIDES = {
	"(le voisin a entendu)", "(pardon pour le bruit)", "(ton chat s'est réveillé)",
	"(volume au maximum)", "(c'est le mégaphone qui parle)", "(même ta plante est fière)",
	"(on ne sait pas pourquoi on crie)", "(les piles sont presque vides)", "(ça résonne jusqu'à Brest)",
}

-- Dégradés "hype" (haut -> bas)
local PALETTES = {
	{ Color3.fromRGB(255, 236, 70), Color3.fromRGB(255, 120, 20) },
	{ Color3.fromRGB(255, 120, 200), Color3.fromRGB(157, 60, 230) },
	{ Color3.fromRGB(120, 245, 255), Color3.fromRGB(30, 110, 240) },
	{ Color3.fromRGB(150, 255, 120), Color3.fromRGB(20, 170, 70) },
	{ Color3.fromRGB(255, 150, 120), Color3.fromRGB(230, 30, 60) },
}

function Megaphone.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local container: Frame = ctx.Container
	local random = Random.new()
	local active = 0
	local lastSpecial = 0

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	-- Crie un mot à l'écran
	local function shout(word: string, palette: { Color3 }?, withAside: boolean?)
		if not ctx.IsAlive() or active >= MAX_ACTIVE then
			return
		end
		active += 1
		local colors = palette or PALETTES[random:NextInteger(1, #PALETTES)]
		local effects = effectsOn()

		-- Position au hasard autour du centre (évite les bords)
		local position = UDim2.fromScale(random:NextNumber(0.3, 0.7), random:NextNumber(0.22, 0.7))
		local holder = UIUtil.Create("Frame", {
			Name = "Shout",
			Size = UDim2.fromOffset(620, 120),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = position,
			Rotation = random:NextNumber(-9, 9),
			BackgroundTransparency = 1,
			ZIndex = 30,
			Parent = container,
		})
		local holderScale = UIUtil.Create("UIScale", { Scale = 2.6, Parent = holder })

		-- Onde de choc (anneau qui s'agrandit)
		if effects then
			local ring = UIUtil.Create("Frame", {
				Size = UDim2.fromOffset(80, 80),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = position,
				BackgroundTransparency = 1,
				ZIndex = 29,
				Parent = container,
			})
			UIUtil.Corner(ring, UDim.new(1, 0))
			local ringStroke = UIUtil.Stroke(ring, colors[2], 8, 0.1)
			task.delay(0.12, function()
				if ring.Parent then
					UIUtil.Tween(ring, 0.55, { Size = UDim2.fromOffset(620, 620) }, Enum.EasingStyle.Quart)
					UIUtil.Tween(ringStroke, 0.55, { Transparency = 1, Thickness = 1 }, Enum.EasingStyle.Quart)
				end
			end)
			Debris:AddItem(ring, 0.8)
		end

		-- Icône 📢 qui arrive par la gauche
		local icon = UIUtil.Label({
			Text = "📢",
			Size = UDim2.fromOffset(84, 84),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(0, -80, 0.5, 0),
			Rotation = -20,
			TextTransparency = 1,
			MaxTextSize = 80,
			ZIndex = 31,
			Parent = holder,
		})

		-- Le mot
		local label = UIUtil.Label({
			Text = word,
			Font = Enum.Font.LuckiestGuy,
			TextColor3 = Color3.new(1, 1, 1),
			TextTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			MaxTextSize = 96,
			ZIndex = 32,
			Parent = holder,
		})
		UIUtil.Gradient(label, ColorSequence.new(colors[1], colors[2]), 90)
		local stroke = UIUtil.Stroke(label, Theme.Colors.TextDark, 5, 1)
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		stroke.LineJoinMode = Enum.LineJoinMode.Round

		-- Petit commentaire en dessous
		local aside: TextLabel? = nil
		if withAside ~= false and random:NextNumber() < 0.4 then
			local sub = UIUtil.Label({
				Text = ASIDES[random:NextInteger(1, #ASIDES)],
				Font = Theme.Fonts.Body,
				TextColor3 = Theme.Colors.TextDark,
				BackgroundColor3 = Color3.new(1, 1, 1),
				BackgroundTransparency = 1,
				TextTransparency = 1,
				Size = UDim2.fromOffset(330, 28),
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.new(0.5, 0, 1, 2),
				MaxTextSize = 20,
				ZIndex = 33,
				Parent = holder,
			})
			UIUtil.Corner(sub, UDim.new(1, 0))
			aside = sub
		end

		ctx.Sound.Play("Megaphone", random:NextNumber(0.85, 1.15))

		-- 1) Écrasement à l'arrivée
		UIUtil.Tween(holderScale, 0.18, { Scale = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		UIUtil.Tween(label, 0.12, { TextTransparency = 0 })
		UIUtil.Tween(stroke, 0.12, { Transparency = 0 })
		UIUtil.Tween(icon, 0.25, { TextTransparency = 0, Position = UDim2.new(0, -6, 0.5, 0), Rotation = 12 }, Enum.EasingStyle.Back)

		task.spawn(function()
			task.wait(0.18)
			if not holder.Parent or not ctx.IsAlive() then
				active -= 1
				return
			end

			-- Écho (copie fantôme qui s'agrandit)
			if effects then
				local echo = UIUtil.Label({
					Text = word,
					Font = Enum.Font.LuckiestGuy,
					TextColor3 = colors[2],
					TextTransparency = 0.45,
					Size = UDim2.fromScale(1, 1),
					MaxTextSize = 96,
					ZIndex = 31,
					Parent = holder,
				})
				local echoScale = UIUtil.Create("UIScale", { Parent = echo })
				UIUtil.Tween(echoScale, 0.5, { Scale = 1.5 })
				UIUtil.Tween(echo, 0.5, { TextTransparency = 1 })
				Debris:AddItem(echo, 0.55)
			end

			if aside then
				UIUtil.Tween(aside, 0.2, { TextTransparency = 0, BackgroundTransparency = 0.1 })
			end

			-- 2) Tremblement
			local base = position
			for i = 1, 8 do
				if not holder.Parent then
					break
				end
				local strength = (9 - i) * 1.6
				holder.Position = base + UDim2.fromOffset(random:NextNumber(-strength, strength), random:NextNumber(-strength, strength))
				task.wait(0.03)
			end
			if holder.Parent then
				holder.Position = base
				-- 3) Respiration
				UIUtil.Tween(holderScale, 0.6, { Scale = 1.07 }, Enum.EasingStyle.Sine)
				UIUtil.Tween(icon, 0.6, { Rotation = -6 }, Enum.EasingStyle.Sine)
				task.wait(0.65)
			end

			-- 4) S'envole en disparaissant
			if holder.Parent then
				UIUtil.Tween(holder, 0.4, { Position = base - UDim2.fromOffset(0, 40) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				UIUtil.Tween(holderScale, 0.4, { Scale = 0.85 })
				UIUtil.Tween(label, 0.35, { TextTransparency = 1 })
				UIUtil.Tween(stroke, 0.35, { Transparency = 1 })
				UIUtil.Tween(icon, 0.35, { TextTransparency = 1 })
				if aside then
					UIUtil.Tween(aside, 0.3, { TextTransparency = 1, BackgroundTransparency = 1 })
				end
				Debris:AddItem(holder, 0.45)
			end
			active -= 1
		end)
	end

	-- Cri périodique
	task.spawn(function()
		task.wait(random:NextNumber(1.5, 3))
		while ctx.IsAlive() do
			shout(WORDS[random:NextInteger(1, #WORDS)])
			task.wait(random:NextNumber(4, 9))
		end
	end)

	-- Cris spéciaux quand il se passe quelque chose
	local specials = {
		Jackpot = { "JACKPOT !!!", PALETTES[1] },
		Rush = { "C'EST LE RUSH !!!", PALETTES[5] },
		Achievement = { "SUCCÈS !!!", PALETTES[4] },
		Unlock = { "NOUVEAUTÉ !", PALETTES[2] },
	}
	if ctx.State.NotifyReceived then
		ctx.Connect(ctx.State.NotifyReceived, function(payload)
			if type(payload) ~= "table" then
				return
			end
			local special = specials[payload.Type]
			if not special then
				return
			end
			-- Les succès restent discrets tant que la fonctionnalité n'est pas débloquée
			if payload.Type == "Achievement" and not ctx.HasFeature("Achievements") then
				return
			end
			local now = os.clock()
			if now - lastSpecial < 2 then
				return
			end
			lastSpecial = now
			shout(special[1], special[2], false)
		end)
	end
end

function Megaphone.Stop(_ctx)
	-- Tout est dans ctx.Container (détruit par le StimulusManager)
end

return Megaphone
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">NeonMode</string>
            <string name="Source"><![CDATA[--[[
	NeonMode (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > NeonMode

	Mode néon (calque Background, sous tout le reste) : reprise du fond
	animé de la v1, version "nuit électrique" :
	  - dégradé sombre qui tourne et pulse vers le rose / violet / cyan ;
	  - orbes lumineux qui dérivent lentement ;
	  - petites étoiles qui scintillent en haut ;
	  - grille rétro en perspective qui défile en bas de l'écran.
	Au démarrage, le néon "grésille" puis s'allume (comme un vrai tube),
	et l'interface passe en mode sombre (ctx.SetDarkMode). Pendant un
	Dopamine Rush, tout s'accélère et devient plus vif.
]]

local NeonMode = {}
NeonMode.Slot = "Background"

local ORB_COUNT = 10
local STAR_COUNT = 14
local H_LINES = 9 -- lignes horizontales de la grille
local V_LINES = 7 -- lignes "fuyantes" de chaque côté du centre
local HORIZON = 0.64 -- hauteur de l'horizon (fraction de l'écran)

local BASE_TOP = Color3.fromRGB(18, 6, 40)
local BASE_MID = Color3.fromRGB(44, 10, 78)
local BASE_BOTTOM = Color3.fromRGB(6, 18, 48)

function NeonMode.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Create = UIUtil.Create
	local container: Frame = ctx.Container
	local random = Random.new()

	local pink = Color3.fromRGB(255, 46, 136)
	local purple = Color3.fromRGB(157, 78, 221)
	local cyan = Color3.fromRGB(0, 240, 255)
	local orbColors = { pink, cyan, purple }

	ctx.SetDarkMode(true)

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	local function rushActive(): boolean
		local rush = ctx.State.Rush
		return type(rush) == "table" and rush.Active == true
	end

	------------------------------------------------------------------
	-- Fond dégradé
	------------------------------------------------------------------
	local frame = Create("Frame", {
		Name = "Neon",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1), -- blanc : le dégradé donne les couleurs
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 1,
		Parent = container,
	})
	local gradient = UIUtil.Gradient(frame, ColorSequence.new({
		ColorSequenceKeypoint.new(0, BASE_TOP),
		ColorSequenceKeypoint.new(0.5, BASE_MID),
		ColorSequenceKeypoint.new(1, BASE_BOTTOM),
	}), 45)

	-- Tout ce qui doit apparaître en fondu : { objet, propriété, valeur cible }
	local fades = {}
	local function addFade(instance: Instance, property: string, target: number)
		table.insert(fades, { instance, property, target })
		local object: any = instance
		object[property] = 1
	end

	------------------------------------------------------------------
	-- Orbes lumineux (comme la v1)
	------------------------------------------------------------------
	local orbs = {}
	local orbCount = effectsOn() and ORB_COUNT or math.floor(ORB_COUNT / 2)
	for _ = 1, orbCount do
		local size = random:NextInteger(140, 340)
		local orb = Create("Frame", {
			Size = UDim2.fromOffset(size, size),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(random:NextNumber(0, 1), random:NextNumber(0, 1)),
			BackgroundColor3 = orbColors[random:NextInteger(1, #orbColors)],
			BorderSizePixel = 0,
			ZIndex = 2,
			Parent = frame,
		})
		UIUtil.Corner(orb, UDim.new(1, 0))
		-- Bord qui s'efface (faux dégradé radial)
		Create("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Rotation = random:NextInteger(0, 360),
			Parent = orb,
		})
		addFade(orb, "BackgroundTransparency", random:NextNumber(0.7, 0.82))
		table.insert(orbs, orb)
	end

	-- Chaque orbe dérive vers un point au hasard, encore et encore
	for _, orb in ipairs(orbs) do
		task.spawn(function()
			while ctx.IsAlive() and orb.Parent do
				local duration = random:NextNumber(6, 12) / (rushActive() and 3 or 1)
				UIUtil.Tween(orb, duration, {
					Position = UDim2.fromScale(random:NextNumber(0, 1), random:NextNumber(0, 0.9)),
				}, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
				task.wait(duration)
			end
		end)
	end

	------------------------------------------------------------------
	-- Étoiles
	------------------------------------------------------------------
	local stars = {}
	for _ = 1, STAR_COUNT do
		local size = random:NextInteger(2, 4)
		local star = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(random:NextNumber(0.02, 0.98), random:NextNumber(0.06, HORIZON - 0.12)),
			Size = UDim2.fromOffset(size, size),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 2,
			Parent = frame,
		})
		UIUtil.Corner(star, UDim.new(1, 0))
		table.insert(stars, { Frame = star, Phase = random:NextNumber(0, math.pi * 2), Speed = random:NextNumber(1.5, 4) })
	end

	------------------------------------------------------------------
	-- Horizon + grille rétro
	------------------------------------------------------------------
	local horizonGlow = Create("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, HORIZON),
		Size = UDim2.fromScale(1, 0.14),
		BackgroundColor3 = pink,
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = frame,
	})
	Create("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(1, 0.55),
		}),
		Parent = horizonGlow,
	})
	addFade(horizonGlow, "BackgroundTransparency", 0)

	local horizonLine = Create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, HORIZON),
		Size = UDim2.new(1, 0, 0, 3),
		BackgroundColor3 = pink,
		BorderSizePixel = 0,
		ZIndex = 4,
		Parent = frame,
	})
	Create("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.9),
			NumberSequenceKeypoint.new(0.5, 0.1),
			NumberSequenceKeypoint.new(1, 0.9),
		}),
		Parent = horizonLine,
	})
	addFade(horizonLine, "BackgroundTransparency", 0)

	local grid = Create("Frame", {
		Name = "Grid",
		Position = UDim2.fromScale(0, HORIZON),
		Size = UDim2.fromScale(1, 1 - HORIZON),
		BackgroundColor3 = Color3.fromRGB(10, 0, 24),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 3,
		Parent = frame,
	})
	Create("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.5),
			NumberSequenceKeypoint.new(1, 0.2),
		}),
		Parent = grid,
	})
	addFade(grid, "BackgroundTransparency", 0)

	local hLines = {}
	for index = 1, H_LINES do
		local line = Create("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Size = UDim2.new(1, 0, 0, 2),
			BackgroundColor3 = pink,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 4,
			Parent = grid,
		})
		hLines[index] = line
	end

	local vLines = {}
	for k = -V_LINES, V_LINES do
		local line = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.new(0, 2, 1, 0),
			BackgroundColor3 = pink,
			BorderSizePixel = 0,
			ZIndex = 4,
			Parent = grid,
		})
		Create("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.95),
				NumberSequenceKeypoint.new(1, 0.35),
			}),
			Parent = line,
		})
		addFade(line, "BackgroundTransparency", 0)
		table.insert(vLines, { Frame = line, K = k })
	end

	-- Lignes fuyantes : partent du centre de l'horizon vers le bas.
	-- Calcul en "hauteurs de grille" (le rapport largeur/hauteur ne dépend
	-- pas de l'échelle de l'écran).
	local function layoutGrid()
		local absolute = grid.AbsoluteSize
		if absolute.Y < 1 then
			return
		end
		local aspect = absolute.X / absolute.Y
		for _, entry in ipairs(vLines) do
			local dx = entry.K * aspect * 0.2
			local length = math.sqrt(dx * dx + 1)
			local mid = aspect / 2 + dx / 2
			entry.Frame.Size = UDim2.new(0, 2, length, 0)
			entry.Frame.Position = UDim2.fromScale(mid / aspect, 0.5)
			entry.Frame.Rotation = -math.deg(math.atan2(dx, 1))
		end
	end
	layoutGrid()
	ctx.Connect(grid:GetPropertyChangedSignal("AbsoluteSize"), layoutGrid)

	------------------------------------------------------------------
	-- Allumage : le tube néon grésille puis s'allume
	------------------------------------------------------------------
	local brightness = 0 -- 0 = éteint, 1 = allumé (multiplie les transparences)
	local function applyBrightness(value: number)
		brightness = value
		frame.BackgroundTransparency = 1 - value
		for _, fade in ipairs(fades) do
			local instance = fade[1]
			if instance.Parent then
				local object: any = instance
				object[fade[2]] = 1 - (1 - fade[3]) * value
			end
		end
	end

	task.spawn(function()
		local steps = { 0.3, 0.05, 0.7, 0.2, 0.9, 0.5, 1 }
		for _, value in ipairs(steps) do
			if not ctx.IsAlive() then
				return
			end
			applyBrightness(value)
			task.wait(0.07)
		end
		-- Fondu final vers la pleine luminosité
		if ctx.IsAlive() then
			applyBrightness(1)
		end
	end)

	------------------------------------------------------------------
	-- Animation (dégradé, étoiles, grille)
	------------------------------------------------------------------
	local time = 0
	local gridScroll = 0
	ctx.OnRender(function(dt: number)
		local rush = rushActive()
		local speed = rush and 4 or 1
		time += dt * speed

		gradient.Rotation = (45 + time * 8) % 360
		gradient.Offset = Vector2.new(math.sin(time * 0.3) * 0.25, math.cos(time * 0.2) * 0.25)

		local pulse = (math.sin(time * 0.5) + 1) / 2
		local top = BASE_TOP:Lerp(pink, rush and 0.4 or pulse * 0.22)
		local mid = BASE_MID:Lerp(purple, pulse * 0.3)
		local bottom = BASE_BOTTOM:Lerp(cyan, rush and 0.35 or (1 - pulse) * 0.22)
		gradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, top),
			ColorSequenceKeypoint.new(0.5, mid),
			ColorSequenceKeypoint.new(1, bottom),
		})

		-- Étoiles qui scintillent
		for _, star in ipairs(stars) do
			local twinkle = (math.sin(time * star.Speed + star.Phase) + 1) / 2
			star.Frame.BackgroundTransparency = 1 - (0.25 + twinkle * 0.65) * brightness
		end

		-- Grille : les lignes horizontales avancent vers le joueur
		gridScroll = (gridScroll + dt * speed * 0.22) % 1
		local lineColor = pink:Lerp(cyan, (math.sin(time * 0.4) + 1) / 4)
		for index, line in ipairs(hLines) do
			local z = ((index - 1) / H_LINES + gridScroll) % 1
			local y = z ^ 2.1
			line.Position = UDim2.fromScale(0, y)
			line.BackgroundTransparency = 1 - (0.15 + z * 0.6) * brightness
			line.BackgroundColor3 = lineColor
		end
		for _, entry in ipairs(vLines) do
			entry.Frame.BackgroundColor3 = lineColor
		end
		horizonLine.BackgroundColor3 = lineColor
	end)

	-- Petit flash rose à l'allumage
	ctx.Effects.Flash(pink, 0.25)
end

function NeonMode.Stop(ctx)
	ctx.SetDarkMode(false)
end

return NeonMode
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">NewsTicker</string>
            <string name="Source"><![CDATA[--[[
	NewsTicker (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > NewsTicker

	Bandeau rouge "FLASH INFO" tout en haut de l'écran : des titres
	absurdes (en majuscules, gras, italique) défilent de droite à gauche,
	à l'infini, séparés par des "•". Survoler le bandeau le ralentit (pour
	lire tranquillement). Cliquer sur un titre = Interact("Headline") : le
	serveur limite les récompenses (Config.Interactions.Headline) et le
	"+X" confirmé (OnBonus "Headline") s'affiche juste sous le bandeau.
]]

local Players = game:GetService("Players")
local TextService = game:GetService("TextService")

local NewsTicker = {}
NewsTicker.Slot = "Ticker"

local HEIGHT = 30 -- hauteur du slot (pixels "design")
local LEFT_W = 136 -- bloc "FLASH INFO"
local RIGHT_W = 62 -- bloc horloge
local TEXT_SIZE = 19
local SEPARATOR_W = 46
local SPEED = 95 -- pixels "design" par seconde
local SLOW_SPEED = 28 -- vitesse quand la souris survole le bandeau
local MAX_ITEMS = 14 -- sécurité : titres vivants au maximum
local URGENT_CHANCE = 1 / 7

-- Titres absurdes (déjà en majuscules)
local HEADLINES = {
	"LES GRENOUILLES ONT DISPARU... OU PAS, IL N'EST PAS SÛR",
	"UN HOMME CLIQUE DEPUIS 3 JOURS, IL VA BIEN",
	"LES DOUCHES FROIDES SONT-ELLES LE FUTUR ?",
	"UN PIGEON ÉLU MAIRE D'UN PETIT VILLAGE, IL PROMET PLUS DE MIETTES",
	"ALERTE : LE LUNDI ARRIVE ENCORE CETTE SEMAINE",
	"DES SCIENTIFIQUES CONFIRMENT QUE LE CANAPÉ EST TRÈS CONFORTABLE",
	"UNE CHAUSSETTE RETROUVÉE APRÈS 12 ANS DE CAVALE",
	"LE WIFI TOMBE EN PANNE, UNE FAMILLE DÉCOUVRE QU'ELLE A UN JARDIN",
	"UN CHAT REFUSE DE DESCENDRE DU CLAVIER, LES NÉGOCIATIONS ÉCHOUENT",
	"LA LUNE ANNONCE UNE PAUSE CARRIÈRE, LES MARÉES INQUIÈTES",
	"UN ESCARGOT BAT LE RECORD DU MONDE DE LENTEUR... POUR LA 3E FOIS",
	"LES NUAGES EN GRÈVE : SOLEIL PAR DÉFAUT TOUTE LA SEMAINE",
	"UN BOUTON A ÉTÉ CLIQUÉ, PERSONNE NE SAIT POURQUOI",
	"LA DOPAMINE ATTEINT UN NIVEAU HISTORIQUE, LES ÉCONOMISTES APPLAUDISSENT",
	"UNE BAGUETTE DE PAIN ÉLUE MEILLEUR ACCESSOIRE DE L'ANNÉE",
	"UN POISSON ROUGE OUBLIE SON PROPRE ANNIVERSAIRE, ENCORE",
	"LES CHERCHEURS SONT FORMELS : IL FAUT BOIRE DE L'EAU",
	"UN PAPY INVENTE LE CLIC À DEUX DOIGTS, LE MONDE S'INCLINE",
	"LA MACHINE À CAFÉ DU BUREAU PORTE PLAINTE POUR SURMENAGE",
	"UN CANARD TRAVERSE LA ROUTE : ON NE SAIT TOUJOURS PAS POURQUOI",
	"LES HARICOTS VERTS SE PLAIGNENT D'ÊTRE LAISSÉS DANS L'ASSIETTE",
	"UN NUAGE EN FORME DE HAMSTER APERÇU AU-DESSUS DE LA VILLE",
	"UN EXPERT : « CLIQUER, C'EST COMME RESPIRER, MAIS AVEC LE DOIGT »",
	"UN ENFANT DEMANDE « POURQUOI ? » 400 FOIS, SES PARENTS PARTENT EN VACANCES",
	"UNE PLANTE VERTE ARROSÉE DEUX FOIS LE MÊME JOUR, ELLE EST SOUS LE CHOC",
	"LE SOLEIL SE LÈVE À L'EST, PERSONNE N'EST SURPRIS",
	"UN LOGO QUI REBONDIT FRÔLE LE COIN, LE PAYS RETIENT SON SOUFFLE",
	"RECORD : 47 ONGLETS OUVERTS, L'ORDINATEUR DEMANDE PITIÉ",
	"UNE PIZZA À L'ANANAS DIVISE UN VILLAGE, LE CONSEIL MUNICIPAL SE RÉUNIT",
	"LES ÉTOILES DORÉES SONT ÉPHÉMÈRES, RAPPELLENT LES PHILOSOPHES",
	"UN HAMSTER COURT 30 KM DANS SA ROUE, IL N'EST TOUJOURS ARRIVÉ NULLE PART",
	"LA SIESTE RECONNUE SPORT OLYMPIQUE, LA FRANCE GRANDE FAVORITE",
	"UNE MOUCHE ENTRE DANS LE SALON : PANIQUE GÉNÉRALE",
	"LE PAPIER BULLE ENFIN RECONNU COMME THÉRAPIE",
	"UN ROBOT ASPIRATEUR DEVIENT CONSCIENT, IL VEUT JUSTE ÊTRE AIMÉ",
	"SONDAGE : 100 % DES PERSONNES INTERROGÉES ONT RÉPONDU AU SONDAGE",
	"LES GRENOUILLES SONT REVENUES, ELLES ÉTAIENT JUSTE EN VACANCES",
	"UNE TARTINE TOMBE CÔTÉ BEURRE, LES SCIENTIFIQUES N'EN REVIENNENT PAS",
	"MÉTÉO : 100 % DE CHANCES QU'IL FASSE UN TEMPS",
	"UN GARÇON DIT « ENCORE 5 MINUTES », IL EST 3 HEURES DU MATIN",
	"LES CHAUSSONS EN GRÈVE : ILS EXIGENT DES PIEDS PLUS PROPRES",
	"LA BOURSE DE LA DOPAMINE MONTE, DESCEND, PUIS REMONTE. AFFAIRE À SUIVRE",
	"UN TOURNESOL SE TROMPE ET FIXE LA LAMPE DU SALON DEPUIS MARDI",
	"L'OCÉAN RAPPELLE QU'IL EST TOUJOURS LÀ, SI JAMAIS",
	"UN MOUTON COMPTE DES HUMAINS POUR S'ENDORMIR, IL EN EST À 8 MILLIARDS",
	"UNE LICORNE APERÇUE EN BANLIEUE, C'ÉTAIT UN CHEVAL AVEC UN CORNET DE GLACE",
}

-- Petites réactions quand on clique sur un titre
local REACTIONS = { "😂", "🤯", "😱", "🤔", "👀", "🙃", "😮", "🧐", "📰", "😳" }

function NewsTicker.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local container: Frame = ctx.Container
	local overlay: Frame = ctx.Overlay
	local random = Random.new()

	local red = Theme.Colors.Red
	local darkRed = Color3.fromRGB(150, 12, 18)
	local yellow = Theme.Colors.Yellow
	local white = Color3.new(1, 1, 1)

	-- Police gras + italique (BuilderSans)
	local italicFont = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold, Enum.FontStyle.Italic)

	------------------------------------------------------------------
	-- Titres "dynamiques" (utilisent l'état du joueur)
	------------------------------------------------------------------
	local function stat(name: string): number
		local data = ctx.State.Data
		local stats = data and data.Stats
		return (stats and tonumber(stats[name])) or 0
	end

	local function playerName(): string
		local player = Players.LocalPlayer
		local name = player and player.DisplayName or "QUELQU'UN"
		return string.upper(name)
	end

	local DYNAMIC = {
		function()
			local data = ctx.State.Data
			local amount = data and tonumber(data.Dopamine) or 0
			return "RECORD : UN JOUEUR POSSÈDE " .. ctx.Format.Format(amount) .. " DOPAMINE, SES VOISINS INQUIETS"
		end,
		function()
			return "LE BOUTON « CLIQUE-MOI » A ÉTÉ CLIQUÉ " .. ctx.Format.WithSpaces(stat("TotalClicks")) .. " FOIS, IL DEMANDE DES VACANCES"
		end,
		function()
			return "EXCLUSIF : " .. playerName() .. " N'A PAS CLIGNÉ DES YEUX DEPUIS 20 MINUTES"
		end,
		function()
			return "INTERVIEW : " .. playerName() .. " AFFIRME POUVOIR « ARRÊTER QUAND IL VEUT »"
		end,
	}

	-- Paquet mélangé : chaque titre passe une fois avant de revenir
	local deck: { any } = {}
	local function refillDeck()
		table.clear(deck)
		for _, text in ipairs(HEADLINES) do
			table.insert(deck, text)
		end
		for _, generator in ipairs(DYNAMIC) do
			table.insert(deck, generator)
		end
		for i = #deck, 2, -1 do
			local j = random:NextInteger(1, i)
			deck[i], deck[j] = deck[j], deck[i]
		end
	end

	local function nextHeadline(): string
		if #deck == 0 then
			refillDeck()
		end
		local entry = table.remove(deck)
		if type(entry) == "function" then
			local ok, text = pcall(entry)
			if ok and type(text) == "string" then
				return text
			end
			return HEADLINES[random:NextInteger(1, #HEADLINES)]
		end
		return entry
	end

	------------------------------------------------------------------
	-- Construction du bandeau
	------------------------------------------------------------------
	local strip = UIUtil.Create("Frame", {
		Name = "Strip",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = red,
		BorderSizePixel = 0,
		ZIndex = 1,
		Parent = container,
	})
	UIUtil.Gradient(strip, ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(200, 200, 200)), 90)
	-- Liseré sombre en bas
	UIUtil.Create("Frame", {
		Name = "BottomLine",
		Size = UDim2.new(1, 0, 0, 2),
		Position = UDim2.new(0, 0, 1, -2),
		BackgroundColor3 = darkRed,
		BorderSizePixel = 0,
		ZIndex = 6,
		Parent = container,
	})

	-- Zone de défilement
	local clip = UIUtil.Create("Frame", {
		Name = "Clip",
		Size = UDim2.new(1, -(LEFT_W + RIGHT_W), 1, 0),
		Position = UDim2.fromOffset(LEFT_W, 0),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		ZIndex = 2,
		Parent = container,
	})

	-- Bloc gauche "FLASH INFO" (blanc, bord en biais)
	local left = UIUtil.Create("Frame", {
		Name = "FlashInfo",
		Size = UDim2.new(0, LEFT_W - 12, 1, 0),
		BackgroundColor3 = white,
		BorderSizePixel = 0,
		ZIndex = 4,
		Parent = container,
	})
	local slant = UIUtil.Create("Frame", {
		Name = "Slant",
		Size = UDim2.fromOffset(22, HEIGHT + 20),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Rotation = 18,
		BackgroundColor3 = white,
		BorderSizePixel = 0,
		ZIndex = 4,
		Parent = left,
	})
	local liveDot = UIUtil.Create("Frame", {
		Name = "LiveDot",
		Size = UDim2.fromOffset(10, 10),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 14, 0.5, 0),
		BackgroundColor3 = red,
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = left,
	})
	UIUtil.Corner(liveDot, UDim.new(1, 0))
	local flashLabel = UIUtil.Create("TextLabel", {
		Name = "Title",
		Size = UDim2.new(1, -24, 1, 0),
		Position = UDim2.fromOffset(24, 0),
		BackgroundTransparency = 1,
		Text = "FLASH INFO",
		TextColor3 = red,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 5,
		Parent = left,
	})
	flashLabel.FontFace = italicFont

	-- Bloc droit : horloge
	local right = UIUtil.Create("Frame", {
		Name = "Clock",
		Size = UDim2.new(0, RIGHT_W, 1, 0),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		BackgroundColor3 = darkRed,
		BorderSizePixel = 0,
		ZIndex = 4,
		Parent = container,
	})
	local clockLabel = UIUtil.Create("TextLabel", {
		Name = "Time",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Mono,
		Text = "--:--",
		TextColor3 = white,
		TextSize = 16,
		ZIndex = 5,
		Parent = right,
	})

	-- Bouton invisible qui couvre tout le bandeau (clic / survol)
	local button = UIUtil.Create("TextButton", {
		Name = "HitArea",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 10,
		Parent = container,
	})

	------------------------------------------------------------------
	-- Titres qui défilent
	------------------------------------------------------------------
	local items: { any } = {}

	-- Pixels réels par pixel "design" (la toile est mise à l'échelle)
	local function designWidth(guiObject: GuiObject): number
		local absHeight = container.AbsoluteSize.Y
		if absHeight <= 0 then
			return 1280
		end
		return guiObject.AbsoluteSize.X * (HEIGHT / absHeight)
	end

	local function measure(text: string): number
		local ok, size = pcall(function()
			return TextService:GetTextSize(text, TEXT_SIZE, Enum.Font.BuilderSansBold, Vector2.new(10000, HEIGHT))
		end)
		if ok and size then
			return size.X + 8 -- un peu de marge pour l'italique
		end
		return #text * 11
	end

	local function addItem(x: number)
		local urgent = random:NextNumber() < URGENT_CHANCE
		local text = nextHeadline()
		if urgent then
			text = "🚨 URGENT : " .. text
		end
		local textWidth = measure(text)
		local width = textWidth + SEPARATOR_W

		local frame = UIUtil.Create("Frame", {
			Name = "Headline",
			Size = UDim2.fromOffset(width, HEIGHT),
			Position = UDim2.fromOffset(x, 0),
			BackgroundTransparency = 1,
			ZIndex = 2,
			Parent = clip,
		})
		local label = UIUtil.Create("TextLabel", {
			Name = "Text",
			Size = UDim2.fromOffset(textWidth, HEIGHT - 2),
			Position = UDim2.fromOffset(0, 0),
			BackgroundTransparency = 1,
			Text = text,
			TextColor3 = urgent and yellow or white,
			TextSize = TEXT_SIZE,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 3,
			Parent = frame,
		})
		label.FontFace = italicFont
		UIUtil.Create("TextLabel", {
			Name = "Separator",
			Size = UDim2.fromOffset(SEPARATOR_W, HEIGHT - 2),
			Position = UDim2.fromOffset(textWidth, 0),
			BackgroundTransparency = 1,
			Font = Theme.Fonts.Title,
			Text = "•",
			TextColor3 = yellow,
			TextSize = 22,
			ZIndex = 3,
			Parent = frame,
		})

		table.insert(items, {
			Frame = frame,
			Label = label,
			Width = width,
			X = x,
			Urgent = urgent,
			Alerted = false,
			BaseColor = urgent and yellow or white,
		})
	end

	-- Alerte "URGENT" : le bloc gauche clignote en jaune
	local alertUntil = 0
	local function triggerAlert()
		alertUntil = os.clock() + 2.5
		flashLabel.Text = "URGENT !"
		ctx.Sound.Play("Notif", 0.8)
	end

	local speed = SPEED
	local targetSpeed = SPEED

	ctx.Connect(button.MouseEnter, function()
		targetSpeed = SLOW_SPEED
	end)
	ctx.Connect(button.MouseLeave, function()
		targetSpeed = SPEED
	end)

	ctx.OnRender(function(dt: number)
		dt = math.min(dt, 0.1)
		speed += (targetSpeed - speed) * math.min(1, dt * 6)
		local clipWidth = designWidth(clip)

		-- Déplacement + suppression des titres sortis à gauche
		local i = 1
		while i <= #items do
			local item = items[i]
			item.X -= speed * dt
			if item.X + item.Width < -4 then
				item.Frame:Destroy()
				table.remove(items, i)
			else
				item.Frame.Position = UDim2.fromOffset(item.X, 0)
				if item.Urgent and not item.Alerted and item.X < clipWidth * 0.6 then
					item.Alerted = true
					triggerAlert()
				end
				i += 1
			end
		end

		-- Ajout de nouveaux titres à droite
		local guard = 0
		while guard < 4 and #items < MAX_ITEMS do
			local last = items[#items]
			local edge = last and (last.X + last.Width) or clipWidth * 0.3
			if last and edge > clipWidth + 30 then
				break
			end
			addItem(edge)
			guard += 1
		end

		-- Bloc gauche : point "en direct" qui clignote, alerte urgente
		local now = os.clock()
		liveDot.BackgroundTransparency = (math.floor(now * 2) % 2 == 0) and 0 or 0.7
		if now < alertUntil then
			local blink = math.floor(now * 6) % 2 == 0
			left.BackgroundColor3 = blink and yellow or white
			slant.BackgroundColor3 = left.BackgroundColor3
			flashLabel.TextColor3 = blink and Theme.Colors.TextDark or red
		elseif flashLabel.Text ~= "FLASH INFO" then
			flashLabel.Text = "FLASH INFO"
			left.BackgroundColor3 = white
			slant.BackgroundColor3 = white
			flashLabel.TextColor3 = red
		end
	end)

	-- Horloge (heure locale)
	task.spawn(function()
		while ctx.IsAlive() do
			local now = os.date("*t")
			if now and now.hour and now.min then
				clockLabel.Text = string.format("%02d:%02d", now.hour, now.min)
			end
			task.wait(5)
		end
	end)

	------------------------------------------------------------------
	-- Clic sur un titre
	------------------------------------------------------------------
	local interaction = ctx.Config.Interactions and ctx.Config.Interactions.Headline
	local cooldown = (interaction and tonumber(interaction.Cooldown)) or 8
	local lastInteract = -math.huge
	local lastScaleX = 0.5

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	ctx.Connect(button.Activated, function(input)
		-- Position X du clic (pixels réels ; milieu du bandeau par défaut)
		local px: number = clip.AbsolutePosition.X + clip.AbsoluteSize.X * 0.5
		if typeof(input) == "Instance" and input:IsA("InputObject") then
			px = input.Position.X
		end

		-- Titre sous le curseur (ou le plus proche)
		local hit, bestDistance = nil, math.huge
		for _, item in ipairs(items) do
			local absX = item.Frame.AbsolutePosition.X
			local absW = item.Frame.AbsoluteSize.X
			local distance = 0
			if px < absX then
				distance = absX - px
			elseif px > absX + absW then
				distance = px - (absX + absW)
			end
			if distance < bestDistance then
				hit, bestDistance = item, distance
			end
		end

		-- Position du clic sur la toile (échelle 0..1 de l'overlay)
		local overlayWidth = overlay.AbsoluteSize.X
		if overlayWidth > 0 then
			lastScaleX = math.clamp((px - overlay.AbsolutePosition.X) / overlayWidth, 0.05, 0.95)
		end

		ctx.Sound.Play("Click", 1.3 + random:NextNumber() * 0.2)
		if hit then
			local label = hit.Label
			label.TextColor3 = Theme.Colors.TextDark
			label.BackgroundTransparency = 0
			label.BackgroundColor3 = yellow
			label.Position = UDim2.fromOffset(0, -3)
			UIUtil.Tween(label, 0.35, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Bounce)
			task.delay(0.7, function()
				if label.Parent then
					label.TextColor3 = hit.BaseColor
					UIUtil.Tween(label, 0.25, { BackgroundTransparency = 1 })
				end
			end)
		end

		-- Petite réaction sous le bandeau
		if effectsOn() then
			ctx.FloatText(overlay, UDim2.new(lastScaleX, 0, 0, 52), REACTIONS[random:NextInteger(1, #REACTIONS)], white, 30)
		end

		-- Récompense (le serveur a son propre délai ; on évite juste de spammer)
		local now = os.clock()
		if now - lastInteract >= cooldown then
			lastInteract = now
			ctx.Interact("Headline")
		end
	end)

	-- Bonus confirmé par le serveur
	ctx.OnBonus("Headline", function(payload)
		if not ctx.IsAlive() then
			return
		end
		local amount = tonumber(payload.Amount) or 0
		ctx.FloatText(overlay, UDim2.new(lastScaleX, 0, 0, 84), "+" .. ctx.Format.Format(amount), Theme.Colors.Gold, 34)
	end)
end

function NewsTicker.Stop(_ctx)
	-- Tout vit dans ctx.Container (détruit par le StimulusManager) ;
	-- les textes flottants de l'overlay se détruisent tout seuls.
end

return NewsTicker
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Ocean</string>
            <string name="Source"><![CDATA[--[[
	Ocean (ModuleScript - cinématique, PAS une Feature)
	Emplacement : ReplicatedStorage > Client > Stimuli > Ocean

	Cinématique "Aller à l'océan" (détox / rebirth), jouée par le
	StimulusManager sur Notify { Type = "Detox" } :
	  Ocean.Play(ctx) remplit ctx.Container (plein écran, calque Cinematic)
	  et BLOQUE ~6 s, puis rend la main (le manager détruit le cadre).
	Au programme : ciel de fin de journée, soleil et son halo, nuages qui
	dérivent, 4 couches de vagues qui ondulent, reflets qui scintillent,
	deux mouettes, puis les textes "Respire..." (avec un cercle de
	respiration), "Tout est calme." et "Rebirth x<mult>".
]]

local Ocean = {}
Ocean.Slot = "Cinematic" -- pour la documentation : plein écran, calque Cinematic

local HORIZON = 0.58

local WAVE_LAYERS = {
	{ Top = HORIZON, Color = Color3.fromRGB(120, 196, 228), Humps = 14, Speed = 0.5, Amp = 0.02 },
	{ Top = HORIZON + 0.09, Color = Color3.fromRGB(78, 164, 216), Humps = 12, Speed = 0.65, Amp = 0.025 },
	{ Top = HORIZON + 0.19, Color = Color3.fromRGB(44, 128, 198), Humps = 10, Speed = 0.8, Amp = 0.03 },
	{ Top = HORIZON + 0.3, Color = Color3.fromRGB(22, 96, 170), Humps = 8, Speed = 1, Amp = 0.035 },
}

function Ocean.Play(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local Create = UIUtil.Create
	local container: Frame = ctx.Container
	local random = Random.new()
	local white = Color3.new(1, 1, 1)

	-- Données du rebirth (payload du Notify "Detox")
	local payload = type(ctx.Payload) == "table" and ctx.Payload or {}
	local multiplier = tonumber(ctx.Multiplier) or tonumber(payload.Multiplier)
	if not multiplier then
		local data = ctx.State.Data
		multiplier = (data and tonumber(data.RebirthMultiplier)) or 1
	end
	local rebirths = tonumber(ctx.Rebirths) or tonumber(payload.Rebirths) or 0

	-- Attend `seconds` ; faux si la cinématique a été coupée
	local function waitAlive(seconds: number): boolean
		local finish = os.clock() + seconds
		while os.clock() < finish do
			if not ctx.IsAlive() or not container.Parent then
				return false
			end
			task.wait()
		end
		return ctx.IsAlive() and container.Parent ~= nil
	end

	------------------------------------------------------------------
	-- Groupe (fondu de toute la scène d'un coup)
	------------------------------------------------------------------
	local scene = Create("CanvasGroup", {
		Name = "Scene",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = white,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		GroupTransparency = 1,
		ZIndex = 1,
		Parent = container,
	})

	-- Ciel
	local sky = Create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = white,
		BorderSizePixel = 0,
		ZIndex = 1,
		Parent = scene,
	})
	UIUtil.Gradient(sky, ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(116, 176, 236)),
		ColorSequenceKeypoint.new(0.35, Color3.fromRGB(190, 208, 240)),
		ColorSequenceKeypoint.new(0.52, Color3.fromRGB(255, 212, 178)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 236, 210)),
	}), 90)

	-- Soleil + halos
	local sunHolder = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, HORIZON, -10),
		Size = UDim2.fromOffset(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = scene,
	})
	for _, info in ipairs({ { 400, 0.88 }, { 260, 0.75 }, { 150, 0 } }) do
		local size, transparency = info[1], info[2]
		local disc = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(size, size),
			BackgroundColor3 = transparency == 0 and Color3.fromRGB(255, 244, 214) or Color3.fromRGB(255, 214, 160),
			BackgroundTransparency = transparency,
			BorderSizePixel = 0,
			ZIndex = 2,
			Parent = sunHolder,
		})
		UIUtil.Corner(disc, UDim.new(1, 0))
	end

	-- Nuages (3 bulles chacun)
	local clouds = {}
	for index = 1, 3 do
		local cloud = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.15 + (index - 1) * 0.33 + random:NextNumber(-0.05, 0.05), 0.12 + random:NextNumber(0, 0.16)),
			Size = UDim2.fromOffset(150, 40),
			BackgroundColor3 = white,
			BackgroundTransparency = 0.15,
			BorderSizePixel = 0,
			ZIndex = 3,
			Parent = scene,
		})
		UIUtil.Corner(cloud, UDim.new(1, 0))
		for _, puff in ipairs({ { 0.35, 56 }, { 0.62, 44 } }) do
			local bubble = Create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(puff[1], 0.2),
				Size = UDim2.fromOffset(puff[2], puff[2]),
				BackgroundColor3 = white,
				BackgroundTransparency = 0.15,
				BorderSizePixel = 0,
				ZIndex = 3,
				Parent = cloud,
			})
			UIUtil.Corner(bubble, UDim.new(1, 0))
		end
		table.insert(clouds, { Frame = cloud, Speed = random:NextNumber(0.006, 0.014) })
	end

	-- Mouettes (deux ailes qui battent)
	local gulls = {}
	for index = 1, 2 do
		local holder = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(-0.05 - (index - 1) * 0.08, 0.22 + (index - 1) * 0.07),
			Size = UDim2.fromOffset(34, 16),
			BackgroundTransparency = 1,
			ZIndex = 4,
			Parent = scene,
		})
		local wings = {}
		for side = -1, 1, 2 do
			local wing = Create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0.5, side * 7, 0.5, 0),
				Size = UDim2.fromOffset(17, 3),
				BackgroundColor3 = Color3.fromRGB(60, 64, 80),
				BorderSizePixel = 0,
				ZIndex = 4,
				Parent = holder,
			})
			UIUtil.Corner(wing, UDim.new(1, 0))
			table.insert(wings, { Frame = wing, Side = side })
		end
		table.insert(gulls, {
			Frame = holder,
			Wings = wings,
			Phase = random:NextNumber(0, math.pi * 2),
			Speed = random:NextNumber(0.13, 0.18),
			X = holder.Position.X.Scale,
			Y = holder.Position.Y.Scale,
		})
	end

	------------------------------------------------------------------
	-- Mer : couches de vagues (bosses arrondies + corps)
	------------------------------------------------------------------
	local layers = {}
	for index, def in ipairs(WAVE_LAYERS) do
		local layer = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.5, def.Top),
			Size = UDim2.fromScale(1.3, 1 - def.Top + 0.08),
			BackgroundTransparency = 1,
			ZIndex = 4 + index,
			Parent = scene,
		})
		Create("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = def.Color,
			BorderSizePixel = 0,
			ZIndex = 4 + index,
			Parent = layer,
		})
		for hump = 1, def.Humps do
			local bump = Create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale((hump - 0.5) / def.Humps, 0),
				Size = UDim2.fromScale(1.4 / def.Humps, 1),
				BackgroundColor3 = def.Color,
				BorderSizePixel = 0,
				ZIndex = 4 + index,
				Parent = layer,
			})
			Create("UIAspectRatioConstraint", {
				AspectRatio = 3,
				DominantAxis = Enum.DominantAxis.Width,
				Parent = bump,
			})
			UIUtil.Corner(bump, UDim.new(1, 0))
		end
		table.insert(layers, { Frame = layer, Def = def, Phase = random:NextNumber(0, math.pi * 2) })
	end

	-- Reflets du soleil sur l'eau
	local glints = {}
	for _ = 1, 12 do
		local glint = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5 + random:NextNumber(-0.18, 0.18), HORIZON + random:NextNumber(0.03, 0.35)),
			Size = UDim2.fromOffset(random:NextInteger(24, 70), 3),
			BackgroundColor3 = Color3.fromRGB(255, 246, 220),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 10,
			Parent = scene,
		})
		UIUtil.Corner(glint, UDim.new(1, 0))
		table.insert(glints, { Frame = glint, Phase = random:NextNumber(0, math.pi * 2), Speed = random:NextNumber(1.5, 3.5) })
	end

	------------------------------------------------------------------
	-- Textes + cercle de respiration
	------------------------------------------------------------------
	local textY = 0.32
	local ring = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, textY),
		Size = UDim2.fromOffset(170, 170),
		BackgroundColor3 = white,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 11,
		Parent = scene,
	})
	UIUtil.Corner(ring, UDim.new(1, 0))
	local ringStroke = UIUtil.Stroke(ring, white, 3, 1)
	local ringScale = Create("UIScale", { Scale = 0.6, Parent = ring })

	local mainText = UIUtil.Label({
		Text = "",
		Font = Theme.Fonts.Title,
		TextColor3 = white,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, textY),
		Size = UDim2.new(0.8, 0, 0, 84),
		MaxTextSize = 64,
		TextTransparency = 1,
		ZIndex = 12,
		Parent = scene,
	})
	local mainStroke = UIUtil.Stroke(mainText, Color3.fromRGB(30, 70, 120), 2, 1)
	mainStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	local mainScale = Create("UIScale", { Parent = mainText })

	local subText = UIUtil.Label({
		Text = "",
		Font = Theme.Fonts.Body,
		TextColor3 = white,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, textY, 62),
		Size = UDim2.new(0.8, 0, 0, 32),
		MaxTextSize = 26,
		TextTransparency = 1,
		ZIndex = 12,
		Parent = scene,
	})
	local subStroke = UIUtil.Stroke(subText, Color3.fromRGB(30, 70, 120), 1.5, 1)
	subStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual

	local function showText(label: TextLabel, stroke: UIStroke, text: string, duration: number)
		label.Text = text
		UIUtil.Tween(label, duration, { TextTransparency = 0 }, Enum.EasingStyle.Sine)
		UIUtil.Tween(stroke, duration, { Transparency = 0.35 }, Enum.EasingStyle.Sine)
	end

	local function hideText(label: TextLabel, stroke: UIStroke, duration: number)
		UIUtil.Tween(label, duration, { TextTransparency = 1 }, Enum.EasingStyle.Sine)
		UIUtil.Tween(stroke, duration, { Transparency = 1 }, Enum.EasingStyle.Sine)
	end

	------------------------------------------------------------------
	-- Animation continue (vagues, reflets, nuages, mouettes)
	------------------------------------------------------------------
	local time = 0
	ctx.OnRender(function(dt: number)
		time += dt
		for _, layer in ipairs(layers) do
			local def = layer.Def
			local x = 0.5 + math.sin(time * def.Speed + layer.Phase) * def.Amp
			local y = def.Top + math.sin(time * def.Speed * 1.4 + layer.Phase) * 0.006
			layer.Frame.Position = UDim2.fromScale(x, y)
		end
		for _, glint in ipairs(glints) do
			glint.Frame.BackgroundTransparency = 0.35 + (math.sin(time * glint.Speed + glint.Phase) + 1) * 0.32
		end
		for _, cloud in ipairs(clouds) do
			local position = cloud.Frame.Position
			cloud.Frame.Position = UDim2.fromScale(position.X.Scale + cloud.Speed * dt, position.Y.Scale)
		end
		for _, gull in ipairs(gulls) do
			gull.X += gull.Speed * dt
			local bob = math.sin(time * 1.3 + gull.Phase) * 0.012
			gull.Frame.Position = UDim2.fromScale(gull.X, gull.Y + bob)
			local flap = 18 + math.sin(time * 7 + gull.Phase) * 16
			for _, wing in ipairs(gull.Wings) do
				-- Aile gauche : bout intérieur plus bas (rotation positive), et inversement
				wing.Frame.Rotation = -wing.Side * flap
			end
		end
	end)

	------------------------------------------------------------------
	-- Déroulé (~6 s)
	------------------------------------------------------------------
	ctx.Sound.Play("Detox", 1)
	UIUtil.Tween(scene, 1, { GroupTransparency = 0 }, Enum.EasingStyle.Sine)
	UIUtil.Tween(sunHolder, 6, { Position = UDim2.new(0.5, 0, HORIZON, -40) }, Enum.EasingStyle.Sine)
	if not waitAlive(0.8) then
		return
	end

	-- "Respire..." + cercle qui gonfle (inspiration)
	showText(mainText, mainStroke, "Respire...", 0.6)
	UIUtil.Tween(ringStroke, 0.5, { Transparency = 0.4 })
	UIUtil.Tween(ringScale, 1.6, { Scale = 1.25 }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	if not waitAlive(1.6) then
		return
	end
	hideText(mainText, mainStroke, 0.4)
	UIUtil.Tween(ringScale, 0.6, { Scale = 0.8 }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	UIUtil.Tween(ringStroke, 0.6, { Transparency = 1 })
	if not waitAlive(0.4) then
		return
	end

	-- "Tout est calme."
	showText(mainText, mainStroke, "Tout est calme.", 0.5)
	if not waitAlive(1.2) then
		return
	end
	hideText(mainText, mainStroke, 0.3)
	if not waitAlive(0.3) then
		return
	end

	-- "Rebirth x<mult>"
	mainScale.Scale = 0.6
	mainText.TextColor3 = Color3.fromRGB(255, 244, 200)
	showText(mainText, mainStroke, "Rebirth " .. ctx.Format.Multiplier(multiplier), 0.35)
	UIUtil.Tween(mainScale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
	local visit = rebirths > 0 and ("Visite n°" .. rebirths .. " à l'océan • ") or ""
	showText(subText, subStroke, visit .. "tes gains sont multipliés pour toujours 🌊", 0.5)
	ctx.Sound.Play("Bonus", 0.8)
	if not waitAlive(1.3) then
		return
	end

	-- Retour au jeu
	UIUtil.Tween(scene, 0.8, { GroupTransparency = 1 }, Enum.EasingStyle.Sine)
	waitAlive(0.8)
end

return Ocean
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">PhoneNotifs</string>
            <string name="Source"><![CDATA[--[[
	PhoneNotifs (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > PhoneNotifs

	Notifications de téléphone (décidées par le SERVEUR via l'événement
	Spawn "Notif") : une bannière arrondie façon smartphone glisse depuis
	la gauche (icône d'appli, nom, "maintenant", message drôle choisi par
	info.Variant), vibre un peu, et s'empile en haut à gauche (3 au max).
	Un clic = ClaimSpawn (le serveur valide) ; la bannière s'en va toute
	seule à la fin de sa durée de vie (petite barre de temps en bas).
	Le bonus confirmé (OnBonus "Notif") s'affiche en "+X" sur la bannière.
]]

local Debris = game:GetService("Debris")

local PhoneNotifs = {}
PhoneNotifs.Slot = "Overlay"

local CARD_W = 288
local CARD_H = 68
local GAP = 8
local LEFT = 16
local TOP = 44
local MAX_VISIBLE = 3

-- Icône, nom de l'appli, couleur de l'icône, message
local NOTIFS = {
	{ Icon = "💬", App = "Messages", Color = Color3.fromRGB(52, 199, 89), Text = "Maman : t'as mangé ?" },
	{ Icon = "📦", App = "Colis Express", Color = Color3.fromRGB(255, 149, 0), Text = "Ton colis est en route ! (il s'est perdu, mais avec enthousiasme)" },
	{ Icon = "❤️", App = "Photos", Color = Color3.fromRGB(255, 62, 138), Text = "+3 likes sur ta photo de tartine" },
	{ Icon = "💧", App = "Santé", Color = Color3.fromRGB(0, 194, 224), Text = "Rappel : boire de l'eau 💧" },
	{ Icon = "⛈️", App = "Météo", Color = Color3.fromRGB(30, 136, 229), Text = "Risque d'éclairs. Pense à les attraper ⚡" },
	{ Icon = "🔋", App = "Batterie", Color = Color3.fromRGB(227, 38, 43), Text = "Batterie à 3 %. Moi aussi, je suis fatigué." },
	{ Icon = "⏰", App = "Réveil", Color = Color3.fromRGB(255, 138, 26), Text = "Tu as repoussé ton réveil 14 fois. Bravo." },
	{ Icon = "👟", App = "Podomètre", Color = Color3.fromRGB(61, 200, 61), Text = "12 pas aujourd'hui. Record personnel ?" },
	{ Icon = "🌱", App = "Plante connectée", Color = Color3.fromRGB(40, 170, 80), Text = "J'ai soif. Bisous. — Ta plante" },
	{ Icon = "🍕", App = "Pizza Minute", Color = Color3.fromRGB(255, 120, 40), Text = "Ta pizza arrive dans 5 minutes (depuis 40 minutes)" },
	{ Icon = "📅", App = "Calendrier", Color = Color3.fromRGB(227, 38, 43), Text = "Rappel : ne rien faire de 14 h à 18 h" },
	{ Icon = "👵", App = "Mamie", Color = Color3.fromRGB(139, 50, 224), Text = "Mamie a envoyé 27 photos de son chat" },
	{ Icon = "🔒", App = "Sécurité", Color = Color3.fromRGB(60, 60, 70), Text = "Nouvelle connexion depuis ton grille-pain. C'était toi ?" },
	{ Icon = "⬇️", App = "Mise à jour", Color = Color3.fromRGB(30, 136, 229), Text = "Mise à jour dispo : 0,2 Mo de nouveautés incroyables" },
	{ Icon = "🧊", App = "Frigo connecté", Color = Color3.fromRGB(0, 194, 224), Text = "Il reste un yaourt. Il te regarde." },
	{ Icon = "🐱", App = "Caméra du salon", Color = Color3.fromRGB(255, 170, 40), Text = "Mouvement détecté : c'est le chat. Encore." },
	{ Icon = "🎮", App = "Jeux", Color = Color3.fromRGB(139, 50, 224), Text = "Ton ami t'a invité à jouer... il y a 3 ans" },
	{ Icon = "🏦", App = "Banque", Color = Color3.fromRGB(42, 42, 42), Text = "Ton solde de Dopamine est excellent. Le reste, moins." },
	{ Icon = "✨", App = "Horoscope", Color = Color3.fromRGB(255, 62, 138), Text = "Bélier : aujourd'hui, clique. Beaucoup." },
	{ Icon = "📸", App = "Souvenirs", Color = Color3.fromRGB(255, 194, 26), Text = "Il y a 5 ans aujourd'hui : tu cliquais déjà." },
	{ Icon = "🎵", App = "Musique", Color = Color3.fromRGB(255, 45, 85), Text = "Ta chanson de l'été écoutée 842 fois. Ça va ?" },
	{ Icon = "🦷", App = "Dentiste", Color = Color3.fromRGB(90, 160, 255), Text = "N'oublie pas ton rendez-vous. Oui, celui-là." },
	{ Icon = "👍", App = "Réseau social", Color = Color3.fromRGB(30, 110, 230), Text = "Quelqu'un a aimé ton commentaire de 2019" },
	{ Icon = "🌙", App = "Sommeil", Color = Color3.fromRGB(88, 86, 214), Text = "Il est tard. Pose le téléphone. (Non ? D'accord.)" },
	{ Icon = "🧦", App = "Chaussettes & Co", Color = Color3.fromRGB(227, 38, 43), Text = "Ta chaussette gauche est en promo !" },
	{ Icon = "🍪", App = "Cookies", Color = Color3.fromRGB(190, 120, 60), Text = "Ce site utilise des cookies. Des vrais. Au chocolat." },
	{ Icon = "🤖", App = "Assistant", Color = Color3.fromRGB(0, 170, 200), Text = "Désolé, je n'ai pas compris « encore 5 minutes »." },
	{ Icon = "🦆", App = "Canard de bain", Color = Color3.fromRGB(255, 200, 0), Text = "Coin. (Tu as 1 nouveau coin.)" },
}

-- Choix déterministe selon la variante envoyée par le serveur
local function pick(list: { any }, variant: any): any
	local v = math.floor(tonumber(variant) or 1)
	return list[(v - 1) % #list + 1]
end

function PhoneNotifs.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local container: Frame = ctx.Container
	local random = Random.new()

	local cards: { any } = {} -- du plus récent (en haut) au plus ancien
	local byId: { [string]: any } = {}
	local positions: { [string]: UDim2 } = {} -- pour placer le "+X" du bonus
	local lastPosition = UDim2.fromOffset(LEFT + CARD_W / 2, TOP + CARD_H / 2)

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	local function slotY(index: number): number
		return TOP + (index - 1) * (CARD_H + GAP)
	end

	-- Replace les bannières dans la pile
	local function layout()
		for index, card in ipairs(cards) do
			local target = UDim2.fromOffset(LEFT, slotY(index))
			if card.Entered then
				UIUtil.Tween(card.Root, 0.3, { Position = target }, Enum.EasingStyle.Quad)
			else
				card.Entered = true
				card.Root.Position = UDim2.fromOffset(-CARD_W - 30, slotY(index))
				UIUtil.Tween(card.Root, 0.45, { Position = target }, Enum.EasingStyle.Back)
			end
		end
	end

	local function dismiss(card, claimed: boolean)
		if card.Done then
			return
		end
		card.Done = true
		local index = table.find(cards, card)
		if index then
			table.remove(cards, index)
		end
		byId[card.Id] = nil
		layout()

		local root = card.Root
		root.Active = false
		if claimed then
			-- "Ouverture" : petit gonflement puis disparition
			UIUtil.Tween(card.Scale, 0.12, { Scale = 1.06 }, Enum.EasingStyle.Quad)
			task.delay(0.12, function()
				if root.Parent then
					UIUtil.Tween(card.Scale, 0.25, { Scale = 0.6 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
					UIUtil.Tween(card.Group, 0.25, { GroupTransparency = 1 })
					UIUtil.Tween(card.Shadow, 0.25, { BackgroundTransparency = 1 })
					UIUtil.Tween(card.Outline, 0.25, { Transparency = 1 })
				end
			end)
		else
			-- Ignorée : repart vers la gauche
			UIUtil.Tween(root, 0.35, { Position = root.Position - UDim2.fromOffset(CARD_W + 40, 0) }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			UIUtil.Tween(card.Group, 0.35, { GroupTransparency = 0.6 })
		end
		Debris:AddItem(root, 0.5)
	end

	local function spawnNotif(info)
		if not ctx.IsAlive() or type(info) ~= "table" or type(info.Id) ~= "string" or byId[info.Id] then
			return
		end
		-- Trop de bannières : la plus ancienne laisse sa place
		while #cards >= MAX_VISIBLE do
			dismiss(cards[#cards], false)
		end

		local data = pick(NOTIFS, info.Variant)
		local lifetime = math.max(1.5, tonumber(info.Lifetime) or 6)
		local variant = math.floor(tonumber(info.Variant) or 1)

		local root = UIUtil.Create("TextButton", {
			Name = "Notif",
			Size = UDim2.fromOffset(CARD_W, CARD_H),
			Position = UDim2.fromOffset(-CARD_W - 30, TOP),
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Text = "",
			ZIndex = 30,
			Parent = container,
		})
		local scale = UIUtil.Create("UIScale", { Parent = root })

		-- Ombre douce
		local shadow = UIUtil.Create("Frame", {
			Name = "Shadow",
			Size = UDim2.fromScale(1, 1),
			Position = UDim2.fromOffset(0, 4),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.82,
			BorderSizePixel = 0,
			ZIndex = 30,
			Parent = root,
		})
		UIUtil.Corner(shadow, 18)

		-- Carte (CanvasGroup : permet de tout faire disparaître d'un coup)
		local group = UIUtil.Create("CanvasGroup", {
			Name = "Card",
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.fromRGB(250, 250, 252),
			BorderSizePixel = 0,
			ZIndex = 31,
			Parent = root,
		})
		UIUtil.Corner(group, 18)
		-- Contour fin (hors du CanvasGroup pour ne pas être rogné)
		local outline = UIUtil.Create("Frame", {
			Name = "Outline",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			ZIndex = 36,
			Parent = root,
		})
		UIUtil.Corner(outline, 18)
		local outlineStroke = UIUtil.Stroke(outline, Theme.Colors.Border, 1.5, 0.7)

		-- Icône de l'appli
		local icon = UIUtil.Create("Frame", {
			Name = "Icon",
			Size = UDim2.fromOffset(44, 44),
			Position = UDim2.fromOffset(11, (CARD_H - 44) / 2),
			BackgroundColor3 = data.Color,
			BorderSizePixel = 0,
			ZIndex = 32,
			Parent = group,
		})
		UIUtil.Corner(icon, 11)
		UIUtil.Gradient(icon, ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(205, 205, 205)), 90)
		UIUtil.Label({
			Text = data.Icon,
			Size = UDim2.fromScale(0.72, 0.72),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			MaxTextSize = 30,
			ZIndex = 33,
			Parent = icon,
		})

		-- Pastille rouge (nombre de notifs "non lues" de l'appli)
		local badge = UIUtil.Label({
			Text = tostring(variant % 9 + 1),
			Font = Theme.Fonts.Number,
			TextColor3 = Color3.new(1, 1, 1),
			BackgroundColor3 = Theme.Colors.Red,
			BackgroundTransparency = 0,
			Size = UDim2.fromOffset(18, 18),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0, 11 + 44 - 2, 0, (CARD_H - 44) / 2 + 3),
			MaxTextSize = 13,
			ZIndex = 34,
			Parent = group,
		})
		UIUtil.Corner(badge, UDim.new(1, 0))

		-- Nom de l'appli + "maintenant"
		UIUtil.Create("TextLabel", {
			Name = "App",
			Size = UDim2.fromOffset(CARD_W - 66 - 86, 18),
			Position = UDim2.fromOffset(66, 9),
			BackgroundTransparency = 1,
			Font = Theme.Fonts.Title,
			Text = string.upper(data.App),
			TextColor3 = Theme.Colors.TextDim,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 32,
			Parent = group,
		})
		UIUtil.Create("TextLabel", {
			Name = "Time",
			Size = UDim2.fromOffset(76, 18),
			Position = UDim2.fromOffset(CARD_W - 86, 9),
			BackgroundTransparency = 1,
			Font = Theme.Fonts.Body,
			Text = "maintenant",
			TextColor3 = Theme.Colors.TextDim,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Right,
			ZIndex = 32,
			Parent = group,
		})

		-- Message
		UIUtil.Label({
			Name = "Message",
			Text = data.Text,
			Font = Theme.Fonts.Body,
			TextColor3 = Theme.Colors.TextDark,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Size = UDim2.fromOffset(CARD_W - 66 - 12, 34),
			Position = UDim2.fromOffset(66, 27),
			MaxTextSize = 16,
			ZIndex = 32,
			Parent = group,
		})

		-- Barre de temps restant
		local timeBar = UIUtil.Create("Frame", {
			Name = "TimeBar",
			Size = UDim2.fromOffset(CARD_W - 32, 3),
			Position = UDim2.fromOffset(16, CARD_H - 5),
			BackgroundColor3 = data.Color,
			BackgroundTransparency = 0.25,
			BorderSizePixel = 0,
			ZIndex = 33,
			Parent = group,
		})
		UIUtil.Corner(timeBar, UDim.new(1, 0))
		UIUtil.Tween(timeBar, lifetime, { Size = UDim2.fromOffset(0, 3) }, Enum.EasingStyle.Linear)

		local card = {
			Id = info.Id,
			Root = root,
			Scale = scale,
			Group = group,
			Shadow = shadow,
			Outline = outlineStroke,
			Color = data.Color,
			Expires = os.clock() + lifetime,
			Entered = false,
			Done = false,
		}
		byId[card.Id] = card
		table.insert(cards, 1, card)
		layout()

		ctx.Sound.Play("Notif", 0.95 + random:NextNumber() * 0.25)

		-- Vibration du téléphone (petite secousse en rotation)
		task.spawn(function()
			task.wait(0.35)
			for i = 1, 8 do
				if card.Done or not root.Parent or not ctx.IsAlive() then
					break
				end
				root.Rotation = (i % 2 == 0) and 1.6 or -1.6
				task.wait(0.035)
			end
			if root.Parent then
				root.Rotation = 0
			end
		end)

		-- Clic : on "ouvre" la notification
		ctx.Connect(root.Activated, function()
			if card.Done or not ctx.IsAlive() then
				return
			end
			local index = table.find(cards, card) or 1
			local position = UDim2.fromOffset(LEFT + CARD_W / 2, slotY(index) + CARD_H / 2)
			positions[card.Id] = position
			lastPosition = position
			ctx.ClaimSpawn(card.Id)
			ctx.Sound.Play("Click", 1.5)
			if effectsOn() then
				ctx.Effects.Burst(container, position, card.Color, 10)
			end
			dismiss(card, true)
			local id = card.Id
			task.delay(6, function()
				positions[id] = nil
			end)
		end)
	end

	-- Disparition automatique à la fin de la durée de vie
	ctx.OnRender(function()
		if #cards == 0 then
			return
		end
		local now = os.clock()
		for i = #cards, 1, -1 do
			local card = cards[i]
			if card and not card.Done and now >= card.Expires then
				dismiss(card, false)
			end
		end
	end)

	ctx.OnSpawn("Notif", spawnNotif)

	-- Bonus confirmé : "+X" sur la bannière
	ctx.OnBonus("Notif", function(payload)
		if not ctx.IsAlive() then
			return
		end
		local position = (payload.SpawnId and positions[payload.SpawnId]) or lastPosition
		ctx.FloatText(container, position, "+" .. ctx.Format.Format(tonumber(payload.Amount) or 0), Theme.Colors.Green, 34)
	end)
end

function PhoneNotifs.Stop(_ctx)
	-- Les bannières vivent dans ctx.Container (détruit par le StimulusManager)
end

return PhoneNotifs
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Pinwheel</string>
            <string name="Source"><![CDATA[--[[
	Pinwheel (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > Pinwheel

	Un moulin à vent en papier planté dans un petit pot : 4 pales colorées
	(triangles obtenus avec des dégradés à bord net) qui tournent en continu,
	avec des coups de vent de temps en temps.
	Clic / toucher = on souffle dessus : grosse accélération qui retombe
	doucement, traits de vent, halo de vitesse... et à très haute vitesse,
	il essaie de décoller. Chaque souffle envoie Interact("Spin") (limité
	côté client à la recharge du serveur) ; le bonus arrive par OnBonus("Spin").
]]

local Debris = game:GetService("Debris")

local Pinwheel = {}
Pinwheel.Slot = "CL"

local BLADE = 44 -- côté du carré d'une pale (portée = BLADE * √2)
local BASE_SPEED = 70 -- degrés / seconde au repos
local BOOST = 540 -- ajout de vitesse par souffle
local MAX_SPEED = 2600
local DECAY = 0.9 -- vitesse de retour au calme

local BLADE_COLORS = {
	Color3.fromRGB(240, 60, 72),
	Color3.fromRGB(255, 205, 40),
	Color3.fromRGB(40, 150, 240),
	Color3.fromRGB(60, 200, 110),
}

local LIFT_TEXTS = { "Il va décoller ! 🚁", "Accroche-toi !", "Trop de vent !!", "WOUUUSH" }

-- Transparence "demi-carré" : une moitié opaque, l'autre invisible (bord net)
local function halfTransparency(opaqueFirst: boolean): NumberSequence
	local a, b = 0, 1
	if not opaqueFirst then
		a, b = 1, 0
	end
	return NumberSequence.new({
		NumberSequenceKeypoint.new(0, a),
		NumberSequenceKeypoint.new(0.495, a),
		NumberSequenceKeypoint.new(0.505, b),
		NumberSequenceKeypoint.new(1, b),
	})
end

function Pinwheel.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local Create = UIUtil.Create
	local container: Frame = ctx.Container
	local random = Random.new()
	local spinConfig = ctx.Config.Interactions.Spin
	local cooldown = (spinConfig and spinConfig.Cooldown) or 2

	local width = container.Size.X.Offset > 0 and container.Size.X.Offset or 170
	local height = container.Size.Y.Offset > 0 and container.Size.Y.Offset or 170
	local hubX, hubY = width / 2, math.floor(height * 0.435)
	local reach = math.ceil(BLADE * math.sqrt(2))

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	------------------------------------------------------------------
	-- Carte (ciel clair)
	------------------------------------------------------------------
	local card = Create("Frame", {
		Name = "Card",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Colors.Card,
		BorderSizePixel = 0,
		Parent = container,
	})
	UIUtil.Corner(card, 18)
	UIUtil.Stroke(card, Theme.Colors.CardBorder, 2)
	UIUtil.Gradient(card, ColorSequence.new(Color3.fromRGB(196, 230, 255), Color3.fromRGB(255, 255, 255)), 90)
	local cardScale = Create("UIScale", { Parent = card })

	-- Deux petits nuages qui passent
	local clouds = {}
	for i = 1, 2 do
		local cloud = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(width * (i == 1 and 0.25 or 0.8), i == 1 and 26 or 58),
			Size = UDim2.fromOffset(38, 14),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			ZIndex = 1,
			Parent = card,
		})
		UIUtil.Corner(cloud, UDim.new(1, 0))
		local puff = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromScale(0.45, 0.6),
			Size = UDim2.fromOffset(20, 16),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			ZIndex = 1,
			Parent = cloud,
		})
		UIUtil.Corner(puff, UDim.new(1, 0))
		table.insert(clouds, { Frame = cloud, X = cloud.Position.X.Offset, Y = cloud.Position.Y.Offset, Speed = random:NextNumber(3, 7) })
	end

	------------------------------------------------------------------
	-- Pot + bâton
	------------------------------------------------------------------
	local potTop = height - 26
	local stick = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromOffset(hubX, hubY),
		Size = UDim2.fromOffset(6, potTop - hubY + 2),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = card,
	})
	UIUtil.Gradient(stick, ColorSequence.new(Color3.fromRGB(236, 196, 136), Color3.fromRGB(168, 116, 64)), 0)
	local pot = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromOffset(hubX, potTop + 4),
		Size = UDim2.fromOffset(38, 20),
		BackgroundColor3 = Color3.fromRGB(208, 112, 72),
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = card,
	})
	UIUtil.Corner(pot, 5)
	UIUtil.Gradient(pot, ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 190)), 0)
	local rim = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromOffset(hubX, potTop),
		Size = UDim2.fromOffset(46, 8),
		BackgroundColor3 = Color3.fromRGB(186, 94, 58),
		BorderSizePixel = 0,
		ZIndex = 4,
		Parent = card,
	})
	UIUtil.Corner(rim, 3)
	-- Petite pousse (parce que pourquoi pas)
	UIUtil.Label({
		Text = "🌱",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromOffset(hubX + 13, potTop + 2),
		Size = UDim2.fromOffset(16, 16),
		MaxTextSize = 15,
		ZIndex = 3,
		Parent = card,
	})

	------------------------------------------------------------------
	-- Rotor : 4 pales (triangle principal + petit triangle "pli" plus clair)
	------------------------------------------------------------------
	local rotorHolder = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(hubX, hubY),
		Size = UDim2.fromOffset(reach * 2, reach * 2),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = card,
	})
	local rotor = Create("Frame", {
		Name = "Rotor",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = rotorHolder,
	})
	for index, color in ipairs(BLADE_COLORS) do
		local bladeHolder = Create("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Rotation = (index - 1) * 90,
			ZIndex = 5,
			Parent = rotor,
		})
		-- Triangle principal (moitié bas-gauche du carré, sommet au moyeu)
		local main = Create("Frame", {
			Position = UDim2.fromOffset(reach, reach),
			Size = UDim2.fromOffset(BLADE, BLADE),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			ZIndex = 5,
			Parent = bladeHolder,
		})
		local mainGradient = UIUtil.Gradient(main, ColorSequence.new(color, color:Lerp(Color3.new(0, 0, 0), 0.18)), -45)
		mainGradient.Transparency = halfTransparency(true)
		-- Pli (moitié haut-droite d'un carré plus petit, plus clair)
		local foldSize = math.floor(BLADE * 0.72)
		local fold = Create("Frame", {
			Position = UDim2.fromOffset(reach, reach),
			Size = UDim2.fromOffset(foldSize, foldSize),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			ZIndex = 6,
			Parent = bladeHolder,
		})
		local foldGradient = UIUtil.Gradient(fold, ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.55), color:Lerp(Color3.new(1, 1, 1), 0.25)), -45)
		foldGradient.Transparency = halfTransparency(false)
	end

	-- Halo de vitesse (apparaît quand ça tourne vite)
	local blur = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 8,
		Parent = rotorHolder,
	})
	UIUtil.Corner(blur, UDim.new(1, 0))
	local blurStroke = UIUtil.Stroke(blur, Color3.fromRGB(255, 255, 255), 3, 1)

	-- Moyeu (épingle)
	local hub = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 9,
		Parent = rotorHolder,
	})
	UIUtil.Corner(hub, UDim.new(1, 0))
	UIUtil.Stroke(hub, Theme.Colors.Border, 2)
	local pin = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(6, 6),
		BackgroundColor3 = Theme.Colors.Red,
		BorderSizePixel = 0,
		ZIndex = 10,
		Parent = hub,
	})
	UIUtil.Corner(pin, UDim.new(1, 0))

	------------------------------------------------------------------
	-- Textes : vitesse, indice, décollage
	------------------------------------------------------------------
	local rpmLabel = UIUtil.Label({
		Text = "12 tr/min",
		Font = Theme.Fonts.Number,
		TextColor3 = Color3.new(1, 1, 1),
		BackgroundColor3 = Theme.Colors.Dark,
		BackgroundTransparency = 0.15,
		Position = UDim2.fromOffset(6, height - 22),
		Size = UDim2.fromOffset(54, 16),
		MaxTextSize = 11,
		ZIndex = 12,
		Parent = card,
	})
	UIUtil.Corner(rpmLabel, UDim.new(1, 0))

	local hint = UIUtil.Label({
		Text = "Souffle ! 🌬️",
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.TextDark,
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromOffset(width - 6, height - 22),
		Size = UDim2.fromOffset(54, 16),
		MaxTextSize = 11,
		ZIndex = 12,
		Parent = card,
	})
	UIUtil.Corner(hint, UDim.new(1, 0))
	UIUtil.Stroke(hint, Theme.Colors.Border, 1, 0.5)

	local liftLabel = UIUtil.Label({
		Text = "",
		Font = Enum.Font.LuckiestGuy,
		TextColor3 = Theme.Colors.Yellow,
		TextTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromOffset(hubX, 3),
		Size = UDim2.fromOffset(width - 16, 18),
		MaxTextSize = 15,
		ZIndex = 14,
		Parent = card,
	})
	local liftStroke = UIUtil.Stroke(liftLabel, Theme.Colors.TextDark, 2, 1)
	liftStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual

	------------------------------------------------------------------
	-- Interaction (toute la carte est cliquable)
	------------------------------------------------------------------
	local button = Create("TextButton", {
		Name = "Blow",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 20,
		Parent = card,
	})

	local speed = BASE_SPEED
	local angle = random:NextNumber(0, 90)
	local lastInteract = -math.huge
	local gustTimer = random:NextNumber(5, 10)
	local rpmTimer = 0
	local lifting = false
	local blown = false
	local clock = 0

	-- Traits de vent qui traversent la carte
	local function windStreaks(count: number)
		for _ = 1, count do
			local y = hubY + random:NextNumber(-reach * 0.8, reach * 0.8)
			local streak = Create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(-10, y),
				Size = UDim2.fromOffset(random:NextNumber(18, 34), 3),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BackgroundTransparency = 0.1,
				BorderSizePixel = 0,
				ZIndex = 11,
				Parent = card,
			})
			UIUtil.Corner(streak, UDim.new(1, 0))
			UIUtil.Stroke(streak, Color3.fromRGB(140, 190, 230), 1, 0.3)
			UIUtil.Tween(streak, random:NextNumber(0.35, 0.55), {
				Position = UDim2.fromOffset(width + 20, y + random:NextNumber(-10, 10)),
				BackgroundTransparency = 1,
			}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			Debris:AddItem(streak, 0.6)
		end
	end

	local function blow()
		speed = math.min(MAX_SPEED, speed + BOOST)
		cardScale.Scale = 0.94
		UIUtil.Tween(cardScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		ctx.Sound.Play("Open", random:NextNumber(1.1, 1.4))
		windStreaks(effectsOn() and 3 or 1)
		if not blown then
			blown = true
			UIUtil.Tween(hint, 0.3, { TextTransparency = 1, BackgroundTransparency = 1 })
			local stroke = hint:FindFirstChildOfClass("UIStroke")
			if stroke then
				UIUtil.Tween(stroke, 0.3, { Transparency = 1 })
			end
		end
		local now = os.clock()
		if now - lastInteract >= cooldown then
			lastInteract = now
			ctx.Interact("Spin")
		end
	end
	ctx.Connect(button.Activated, blow)

	ctx.OnBonus("Spin", function(payload)
		local amount = tonumber(payload.Amount)
		if amount then
			ctx.FloatText(container, UDim2.fromOffset(hubX, hubY - 30), "+" .. ctx.Format.Format(amount), Theme.Colors.Gold, 26)
		end
	end)

	------------------------------------------------------------------
	-- Animation
	------------------------------------------------------------------
	ctx.OnRender(function(dt: number)
		dt = math.min(dt, 0.1)
		clock += dt

		-- Coups de vent naturels
		gustTimer -= dt
		if gustTimer <= 0 then
			gustTimer = random:NextNumber(6, 12)
			speed = math.min(MAX_SPEED, speed + random:NextNumber(150, 300))
			if effectsOn() then
				windStreaks(2)
			end
		end

		-- Retour progressif au calme
		speed = BASE_SPEED + (speed - BASE_SPEED) * math.exp(-dt * DECAY)
		angle = (angle + speed * dt) % 360
		rotor.Rotation = angle

		-- Halo de vitesse
		local fast = math.clamp((speed - 500) / 1600, 0, 1)
		blur.BackgroundTransparency = 1 - fast * 0.35
		blurStroke.Transparency = 1 - fast * 0.7

		-- Décollage (tremble et monte un peu quand c'est très rapide)
		local liftAmount = math.clamp((speed - 1500) / 1000, 0, 1)
		if liftAmount > 0 then
			rotorHolder.Position = UDim2.fromOffset(
				hubX + random:NextNumber(-1.5, 1.5) * liftAmount,
				hubY - liftAmount * 6 + random:NextNumber(-1.5, 1.5) * liftAmount
			)
			stick.Rotation = math.sin(clock * 40) * 2 * liftAmount
		elseif rotorHolder.Position ~= UDim2.fromOffset(hubX, hubY) then
			rotorHolder.Position = UDim2.fromOffset(hubX, hubY)
			stick.Rotation = 0
		end
		if liftAmount > 0.3 and not lifting then
			lifting = true
			liftLabel.Text = LIFT_TEXTS[random:NextInteger(1, #LIFT_TEXTS)]
			UIUtil.Tween(liftLabel, 0.2, { TextTransparency = 0 })
			UIUtil.Tween(liftStroke, 0.2, { Transparency = 0 })
		elseif liftAmount < 0.1 and lifting then
			lifting = false
			UIUtil.Tween(liftLabel, 0.4, { TextTransparency = 1 })
			UIUtil.Tween(liftStroke, 0.4, { Transparency = 1 })
		end

		-- Nuages
		for _, cloud in ipairs(clouds) do
			cloud.X += cloud.Speed * dt
			if cloud.X > width + 30 then
				cloud.X = -30
			end
			cloud.Frame.Position = UDim2.fromOffset(cloud.X, cloud.Y)
		end

		-- Compteur de tours / minute (degrés/s ÷ 6)
		rpmTimer -= dt
		if rpmTimer <= 0 then
			rpmTimer = 0.12
			rpmLabel.Text = math.floor(speed / 6 + 0.5) .. " tr/min"
		end

		-- L'indice "Souffle !" respire tant qu'on n'a pas soufflé
		if not blown then
			hint.Rotation = math.sin(clock * 3) * 4
		end
	end)
end

function Pinwheel.Stop(_ctx)
	-- Tout est dans ctx.Container (détruit par le StimulusManager)
end

return Pinwheel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Press</string>
            <string name="Source"><![CDATA[--[[
	Press (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > Press

	Une presse hydraulique qui écrase des trucs, en boucle, et c'est très
	satisfaisant :
	  - un objet arrive par le tapis roulant (piles de macarons colorés,
	    pastèque, canard en plastique, gâteau, éponge...) ;
	  - le piston descend lentement, l'objet se tasse, la machine tremble,
	    le manomètre grimpe dans le rouge... puis CRUNCH ! (miettes,
	    vapeur, secousse, onomatopée) ;
	  - la galette obtenue part sur le tas à gauche, qui finit à la poubelle,
	    et la file d'attente à droite se remplit toute seule.
	La vitesse augmente avec le niveau de l'amélioration "Presse hydraulique".
	Avec "Presse turbo" (Feature PressStart), un gros bouton START rouge
	permet d'écraser soi-même : Interact("Press") (recharge côté serveur,
	compte à rebours affiché) et le bonus s'affiche via OnBonus("Press").
]]

local Debris = game:GetService("Debris")

local Press = {}
Press.Slot = "C3"

----------------------------------------------------------------------
-- Géométrie (pixels "design" dans un slot de 384 x 268)
----------------------------------------------------------------------
local MX = 170 -- centre de la machine
local ANVIL_Y = 228 -- dessus de l'enclume (bas des objets)

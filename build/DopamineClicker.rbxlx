local HouseEditor = {}

local SAVE_DELAY = 1.5 -- (s) après la dernière modification
local RETRY_DELAY = 1.2 -- (s) nouvel essai si le serveur refuse
local SYNC_BLOCK = 2.5 -- (s) après une sauvegarde : on ignore les anciens états du serveur
local DRAG_THRESHOLD = 6 -- (px écran) en dessous : c'est un simple toucher
local DRAG_SMOOTHING = 24 -- vitesse de rattrapage du doigt (plus = plus collé)
local LIFT_SCALE = 1.1
local HISTORY_STEPS = 30
local GRID = 20 -- (px de maquette) pas de l'aimant
local NUDGE_SMALL = 4 -- (px de maquette) flèche
local NUDGE_BIG = 24 -- (px de maquette) Maj + flèche
local NUDGE_MERGE = 0.8 -- (s) flèches enchaînées = une seule étape d'annulation
local DOCK_BELOW = 760 -- (px de maquette) scène plus étroite : barre d'outils en bas de la scène

local C = HouseCommon.Colors
local P = HouseButtons.Palette
local WHITE = Color3.new(1, 1, 1)
local SEAT_TINT = Color3.fromRGB(56, 176, 140) -- étiquette "chaise à table"

export type SaveStatus = "idle" | "dirty" | "saving" | "saved" | "error"

export type Editor = {
	Changed: any, -- Signal () : disposition modifiée (confort, inventaire)
	SaveStatusChanged: any, -- Signal (status: SaveStatus)
	SelectionChanged: any, -- Signal (entry: Placed?)
	HistoryChanged: any, -- Signal () : annuler / rétablir / aimant
	SetEditing: (editing: boolean) -> (),
	IsEditing: () -> boolean,
	SetActive: (active: boolean) -> (),
	SetLive: (visible: boolean) -> (), -- pièce affichée : les animaux vivent
	GetPets: () -> HousePets.Pets,
	SetRoom: (roomId: string) -> (),
	GetRoomId: () -> string?,
	Sync: (house: HouseData, force: boolean?) -> (),
	GetLayout: () -> { Placed },
	Overrides: () -> HouseCommon.Overrides,
	Available: (itemId: string) -> number,
	CanPlace: (itemId: string) -> (boolean, string?),
	Place: (itemId: string) -> boolean,
	Select: (index: number) -> (),
	Deselect: () -> (),
	GetSelected: () -> Placed?,
	Duplicate: () -> boolean,
	Flip: () -> boolean,
	SendTo: (roomId: string) -> boolean,
	SetSendHandler: (handler: (entry: Placed) -> ()) -> (),
	SetDockHost: (host: GuiObject?) -> (), -- téléphone : la barre d'outils prend la place de l'inventaire
	Undo: () -> boolean,
	Redo: () -> boolean,
	CanUndo: () -> boolean,
	CanRedo: () -> boolean,
	SetSnap: (on: boolean) -> (),
	GetSnap: () -> boolean,
	Flush: () -> (),
	IsBusy: () -> boolean,
	Update: (dt: number) -> (),
}

-- Objet posé sur le meuble qu'on déplace (décalage en fractions de la pièce)
type Rider = { Entry: Placed, DX: number, DY: number }

type Drag = {
	Entry: Placed,
	Input: InputObject,
	Offset: Vector2,
	Target: Vector2,
	Start: Vector2,
	Moved: boolean,
	Before: { Placed },
	Riders: { Rider },
	Skip: { [Placed]: boolean },
	Tabletop: boolean, -- peut être posé sur un meuble
	IsSeat: boolean, -- chaise / tabouret : peut se ranger à une table
	Surface: HouseSurfaces.Surface?,
	Seat: HouseSurfaces.SeatSpot?,
	HintKey: string,
	WasOn: boolean, -- posé sur un meuble au début du glissement
}

-- Envoi vers une autre pièce (pour l'annuler / le rétablir)
type Cross = { Room: string, Before: { Placed }, After: { Placed } }
type Step = { Layout: { Placed }, Cross: Cross? }
type History = { Undo: { Step }, Redo: { Step } }

-- Rang de la zone : muraux derrière, objets à plat (tapis), puis le sol
local function zoneRank(sticker: Sticker): number
	if sticker.Item.Placement == "Wall" then
		return 0
	elseif sticker.Flat then
		return 1
	end
	return 2
end

local function roundTo(value: number, step: number): number
	return math.floor(value / step + 0.5) * step
end

local function signature(list: { Placed }): string
	local parts = table.create(#list)
	for index, entry in ipairs(list) do
		parts[index] = string.format("%s:%.4f:%.4f:%.3f:%d%s%s", entry.I, entry.X, entry.Y, entry.S, math.floor(entry.Z), entry.F and ":F" or "", entry.C and (":" .. entry.C) or "")
	end
	return table.concat(parts, ";")
end

local function copyEntry(entry: Placed): Placed
	return { I = entry.I, X = entry.X, Y = entry.Y, S = entry.S, Z = entry.Z, F = entry.F == true or nil, C = entry.C }
end

local function copyList(list: { Placed }): { Placed }
	local result = table.create(#list)
	for index, entry in ipairs(list) do
		result[index] = copyEntry(entry)
	end
	return result
end

-- Disposition envoyée au serveur (mêmes arrondis que lui)
local function payloadOf(list: { Placed }): { Placed }
	local payload = table.create(#list)
	for index, entry in ipairs(list) do
		payload[index] = {
			I = entry.I,
			X = roundTo(entry.X, 0.0001),
			Y = roundTo(entry.Y, 0.0001),
			S = roundTo(entry.S, 0.001),
			Z = math.clamp(math.floor(entry.Z), 0, HouseCommon.MAX_Z),
			F = entry.F == true or nil,
			C = entry.C,
		}
	end
	return payload
end

-- Aimant : partagé par toutes les pièces (et gardé entre deux ouvertures)
local snapEnabled = false

function HouseEditor.new(room: Room, notify: (text: string, color: Color3?) -> ()): Editor
	local editor: Editor
	local house: HouseData = HouseCommon.GetHouse(nil)
	local roomId: string? = nil
	local layout: { Placed } = {}
	local stickers: { [Placed]: Sticker } = {}
	local selected: Placed? = nil
	local drag: Drag? = nil
	local editing = false
	local active = false
	local dirty = false
	local saving = false
	local saveAt = 0
	local failures = 0
	local blockUntil = 0
	local lastSignature = ""
	local clock = 0
	local extras: HouseCommon.Overrides = {} -- autres pièces à sauvegarder avec la prochaine sauvegarde
	local histories: { [string]: History } = {}
	local lastNudge = 0
	local lastNudgeEntry: Placed? = nil
	local sendHandler: ((entry: Placed) -> ())? = nil
	local liveVisible = false
	local pets = HousePets.new(room)

	local changed = Signal.new()
	local saveStatusChanged = Signal.new()
	local selectionChanged = Signal.new()
	local historyChanged = Signal.new()

	----------------------------------------------------------------------
	-- Barre d'outils de sélection ("bonbons")
	----------------------------------------------------------------------

	local toolbar = UIUtil.Create("Frame", {
		Name = "Toolbar",
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 20,
		Parent = room.Overlay,
	})
	toolbar:SetAttribute("DarkSkinIgnore", true)
	local toolbarScale = UIUtil.Create("UIScale", { Parent = toolbar })
	local toolbarLayout = UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 5),
		Parent = toolbar,
	})

	-- En-tête : vignette + nom + confort, et où l'objet est posé
	local header = UIUtil.Create("Frame", {
		Name = "Header",
		Size = UDim2.fromOffset(0, 32),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		ZIndex = 21,
		Parent = toolbar,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6),
		Parent = header,
	})
	-- (conteneurs = boutons sans action : un clic dans la barre ne traverse
	-- jamais jusqu'à la pièce, qui désélectionnerait l'objet)
	local nameChip = HouseButtons.Container({
		Name = "NameChip",
		Size = UDim2.fromOffset(0, 32),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = C.PinkDeep,
		LayoutOrder = 1,
		ZIndex = 21,
		Parent = header,
	})
	UIUtil.Corner(nameChip, UDim.new(1, 0))
	UIUtil.Stroke(nameChip, WHITE, 2, 0)
	UIUtil.Gradient(nameChip, ColorSequence.new(Color3.fromRGB(255, 196, 222), WHITE), 90)
	UIUtil.Create("UIPadding", { PaddingLeft = UDim.new(0, 3), PaddingRight = UDim.new(0, 13), Parent = nameChip })
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 7),
		Parent = nameChip,
	})
	local thumb = UIUtil.Create("Frame", {
		Name = "Thumb",
		Size = UDim2.fromOffset(26, 26),
		BackgroundColor3 = WHITE,
		LayoutOrder = 1,
		ZIndex = 22,
		Parent = nameChip,
	})
	UIUtil.Corner(thumb, UDim.new(1, 0))
	UIUtil.Stroke(thumb, C.PinkSoft, 1.5, 0)
	local nameLabel = UIUtil.Create("TextLabel", {
		Name = "Label",
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = "",
		TextColor3 = WHITE,
		TextSize = 15,
		LayoutOrder = 2,
		ZIndex = 22,
		Parent = nameChip,
	})
	UIUtil.Create("UIStroke", {
		Color = C.PinkDeep:Lerp(Color3.new(0, 0, 0), 0.45),
		Thickness = 1,
		Transparency = 0.55,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		Parent = nameLabel,
	})
	local placeChip = HouseButtons.Container({
		Name = "PlaceChip",
		Size = UDim2.fromOffset(0, 26),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = C.MintSoft,
		LayoutOrder = 2,
		ZIndex = 21,
		Visible = false,
		Parent = header,
	})
	UIUtil.Corner(placeChip, UDim.new(1, 0))
	UIUtil.Stroke(placeChip, C.Mint, 1.5, 0.2)
	UIUtil.Create("UIPadding", { PaddingLeft = UDim.new(0, 11), PaddingRight = UDim.new(0, 11), Parent = placeChip })
	local placeLabel = UIUtil.Create("TextLabel", {
		Name = "Label",
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = "",
		TextColor3 = C.Ink,
		TextSize = 13,
		ZIndex = 22,
		Parent = placeChip,
	})

	-- Capsule d'outils (les clics entre les boutons ne traversent pas)
	local bar = HouseButtons.Container({
		Name = "Bar",
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundColor3 = WHITE,
		LayoutOrder = 2,
		ZIndex = 21,
		Parent = toolbar,
	})
	UIUtil.Corner(bar, 22)
	UIUtil.Stroke(bar, C.Pink, 2, 0.05)
	UIUtil.Gradient(bar, ColorSequence.new(WHITE, Color3.fromRGB(255, 232, 244)), 90)
	UIUtil.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
		PaddingTop = UDim.new(0, 6),
		PaddingBottom = UDim.new(0, 7),
		Parent = bar,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6),
		Parent = bar,
	})

	local function separator(order: number): Frame
		local line = UIUtil.Create("Frame", {
			Name = "Sep" .. order,
			Size = UDim2.fromOffset(2, 40),
			BackgroundColor3 = C.Pink,
			BackgroundTransparency = 0.55,
			BorderSizePixel = 0,
			LayoutOrder = order,
			ZIndex = 22,
			Parent = bar,
		})
		UIUtil.Corner(line, UDim.new(1, 0))
		return line
	end

	local candies: { Candy } = {}
	local function toolSize(): (number, number)
		if Interface.IsTouch() then
			return 58, 60
		end
		return 56, 56
	end
	local function tool(order: number, name: string, icon: string, caption: string, color: Color3, textColor: Color3?): Candy
		local w, h = toolSize()
		local candy = HouseButtons.Candy({
			Name = name,
			Icon = icon,
			Caption = Locale.T(caption),
			Color = color,
			TextColor = textColor,
			Width = w,
			Height = h,
			IconSize = 22,
			LayoutOrder = order,
			ZIndex = 22,
			Parent = bar,
		})
		table.insert(candies, candy)
		return candy
	end

	-- Taille : ➖ 100 % ➕ (segment)
	local sizeGroup = UIUtil.Create("Frame", {
		Name = "SizeGroup",
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundColor3 = Color3.fromRGB(243, 236, 255),
		LayoutOrder = 1,
		ZIndex = 22,
		Parent = bar,
	})
	UIUtil.Corner(sizeGroup, 18)
	UIUtil.Stroke(sizeGroup, C.Lilac, 1.5, 0.45)
	UIUtil.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 4),
		PaddingRight = UDim.new(0, 4),
		PaddingTop = UDim.new(0, 4),
		PaddingBottom = UDim.new(0, 4),
		Parent = sizeGroup,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 4),
		Parent = sizeGroup,
	})
	local function sizeButton(order: number, name: string, icon: string): Candy
		local candy = HouseButtons.Candy({
			Name = name,
			Icon = icon,
			Color = P.Lilac,
			Width = Interface.IsTouch() and 46 or 40,
			Height = Interface.IsTouch() and 50 or 46,
			Radius = 16,
			IconSize = 18,
			LayoutOrder = order,
			ZIndex = 23,
			Parent = sizeGroup,
		})
		table.insert(candies, candy)
		return candy
	end
	local smaller = sizeButton(1, "Smaller", "➖")
	local percentHolder = UIUtil.Create("Frame", {
		Name = "Percent",
		Size = UDim2.fromOffset(52, 44),
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		ZIndex = 23,
		Parent = sizeGroup,
	})
	local percentLabel = UIUtil.Create("TextLabel", {
		Name = "Value",
		Size = UDim2.new(1, 0, 0, 24),
		Position = UDim2.fromOffset(0, 3),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = "100%",
		TextColor3 = C.Ink,
		TextSize = 17,
		ZIndex = 24,
		Parent = percentHolder,
	})
	UIUtil.Create("TextLabel", {
		Name = "Caption",
		Size = UDim2.new(1, 0, 0, 14),
		Position = UDim2.fromOffset(0, 27),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = Locale.T("Size"),
		TextColor3 = C.Lilac:Lerp(C.Ink, 0.45),
		TextSize = 12,
		ZIndex = 24,
		Parent = percentHolder,
	})
	local bigger = sizeButton(3, "Bigger", "➕")
	separator(2)
	local backTool = tool(3, "Back", "⏬", "Back", P.Mint)
	local frontTool = tool(4, "Front", "⏫", "Front", P.Mint)
	separator(5)
	local flipTool = tool(6, "Flip", "↔️", "Flip", P.Sky)
	-- (v9.1) 🎨 couleur de l'objet : la rangée des couleurs remplace les outils
	local paintTool = tool(7, "Paint", "🎨", "Colour", P.Pink)
	local copyTool = tool(8, "Copy", "📑", "Copy", P.Butter)
	local sendTool = tool(9, "Send", "🚪", "Send", P.Peach)
	separator(10)
	local storeTool = tool(11, "Store", "📦", "Put away", P.Red, WHITE)
	-- (téléphone : la barre cache l'inventaire -> "OK" pour le retrouver)
	local doneTool = tool(-1, "Deselect", "✔️", "OK", P.Green, WHITE)
	doneTool.Button.Visible = false
	local doneSep = separator(0)
	doneSep.Visible = false

	HouseButtons.Tip(smaller.Button, function()
		return HouseButtons.TipText("Make smaller", "( - )")
	end)
	HouseButtons.Tip(bigger.Button, function()
		return HouseButtons.TipText("Make bigger", "( + )")
	end)
	HouseButtons.Tip(backTool.Button, function()
		return HouseButtons.TipText("Send backward", "( Page Down )")
	end)
	HouseButtons.Tip(frontTool.Button, function()
		return HouseButtons.TipText("Bring forward", "( Page Up )")
	end)
	HouseButtons.Tip(flipTool.Button, function()
		return HouseButtons.TipText("Flip left / right", "( F )")
	end)
	HouseButtons.Tip(paintTool.Button, function()
		return HouseButtons.TipText("Change the colour", "( C )")
	end)
	HouseButtons.Tip(copyTool.Button, function()
		return HouseButtons.TipText("Duplicate", "( Ctrl+D )")
	end)
	HouseButtons.Tip(sendTool.Button, function()
		return HouseButtons.TipText("Send to another room")
	end)
	HouseButtons.Tip(storeTool.Button, function()
		return HouseButtons.TipText("Put away in the inventory", "( Delete )")
	end)

	-- (v9.1) Rangée des couleurs (à la place des outils quand on clique 🎨) :
	-- ⬅ retour, couleurs d'origine, puis Config.House.Tints
	local palette = HouseButtons.Container({
		Name = "Palette",
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundColor3 = WHITE,
		LayoutOrder = 2,
		Visible = false,
		ZIndex = 21,
		Parent = toolbar,
	})
	UIUtil.Corner(palette, 22)
	UIUtil.Stroke(palette, C.Pink, 2, 0.05)
	UIUtil.Gradient(palette, ColorSequence.new(WHITE, Color3.fromRGB(255, 232, 244)), 90)
	UIUtil.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
		PaddingTop = UDim.new(0, 6),
		PaddingBottom = UDim.new(0, 7),
		Parent = palette,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 5),
		Parent = palette,
	})
	local swatchW = Interface.IsTouch() and 44 or 38
	local swatchH = Interface.IsTouch() and 50 or 44
	local paletteBack = HouseButtons.Candy({
		Name = "PaletteBack",
		Icon = "⬅️",
		Color = P.White,
		Width = swatchW,
		Height = swatchH,
		Radius = 16,
		IconSize = 18,
		LayoutOrder = 0,
		ZIndex = 22,
		Parent = palette,
	})
	table.insert(candies, paletteBack)
	type Swatch = { Id: string?, Candy: Candy }
	local swatches: { Swatch } = {}
	local function swatch(order: number, id: string?, color: Color3, icon: string): Swatch
		local candy = HouseButtons.Candy({
			Name = "Tint_" .. (id or "Original"),
			Icon = icon,
			Color = color,
			Width = swatchW,
			Height = swatchH,
			Radius = 16,
			IconSize = 16,
			LayoutOrder = order,
			ZIndex = 22,
			Parent = palette,
		})
		table.insert(candies, candy)
		local entry: Swatch = { Id = id, Candy = candy }
		table.insert(swatches, entry)
		return entry
	end
	local originalSwatch = swatch(1, nil, P.White, "🌈")
	HouseButtons.Tip(originalSwatch.Candy.Button, function()
		return HouseButtons.TipText("Original colours")
	end)
	for index, tint in ipairs(HouseCommon.Tints) do
		local entry = swatch(index + 1, tint.Id, tint.Color or P.White, "")
		HouseButtons.Tip(entry.Candy.Button, function()
			return HouseButtons.TipText((tint.Icon or "") .. " " .. HouseCommon.Name(tint))
		end)
	end
	HouseButtons.Tip(paletteBack.Button, function()
		return HouseButtons.TipText("Back to the tools")
	end)

	-- Pastille "+2 ❤️" etc. au-dessus d'un objet (calque des effets)
	local function floatAt(sticker: Sticker, text: string, color: Color3)
		local layer = Effects.GetLayer()
		if not layer or not sticker.Frame.Parent then
			return
		end
		local center = Interface.GetCanvasCenter(sticker.Body)
		Effects.FloatingText(layer, UDim2.fromOffset(center.X, center.Y - 20), text, color, 26)
	end

	local function burstAt(sticker: Sticker, color: Color3?, count: number?)
		local layer = Effects.GetLayer()
		if not layer or not sticker.Frame.Parent then
			return
		end
		local center = Interface.GetCanvasCenter(sticker.Body)
		Effects.Burst(layer, UDim2.fromOffset(center.X, center.Y), color, count or 8)
	end

	----------------------------------------------------------------------
	-- Pièce, exemplaires
	----------------------------------------------------------------------

	local function currentRoomData(): HouseCommon.Room?
		return HouseCommon.GetRoom(house, roomId)
	end

	local function roomItems(): number
		return HouseCommon.GetSize(house).RoomItems
	end

	-- Dispositions locales (pièce ouverte + envois en attente)
	local function overrides(): HouseCommon.Overrides
		local result: HouseCommon.Overrides = {}
		for id, list in pairs(extras) do
			result[id] = list
		end
		if roomId then
			result[roomId :: string] = layout
		end
		return result
	end

	local function available(itemId: string): number
		return HouseCommon.Available(house, itemId, overrides())
	end

	-- Disposition actuelle d'une autre pièce (envoi en attente, sinon serveur)
	local function layoutOfRoom(id: string): { Placed }
		if id == roomId then
			return layout
		end
		local pendingList = extras[id]
		if pendingList then
			return pendingList
		end
		local other = HouseCommon.GetRoom(house, id)
		return other and other.Placed or {}
	end

	----------------------------------------------------------------------
	-- Profondeur et barre d'outils
	----------------------------------------------------------------------

	-- Clé de tri : (zone, couche Z, Y, X) ; un objet posé sur un meuble
	-- passe juste devant ce meuble, une chaise à table juste derrière /
	-- devant elle (HouseSurfaces.Order)
	local function rankOf(entry: Placed): number
		local sticker = stickers[entry]
		return sticker and zoneRank(sticker) or 2
	end
	local function sortedEntries(): { Placed }
		return HouseSurfaces.Order(layout, room.Width, room.Height, rankOf)
	end

	-- (ZIndex espacés de 2 : les animaux qui se promènent se glissent entre deux objets)
	local function resort()
		local current = drag
		local riding: { [Placed]: number } = {}
		if current and current.Moved then
			for index, rider in ipairs(current.Riders) do
				riding[rider.Entry] = index
			end
		end
		for index, entry in ipairs(sortedEntries()) do
			local sticker = stickers[entry]
			if sticker then
				local dragged = current ~= nil and current.Entry == entry and current.Moved
				local rider = riding[entry]
				sticker.Frame.ZIndex = dragged and 5000 or (rider and 5000 + rider * 2 or index * 2 + 10)
			end
		end
		pets.Refresh(layout, stickers)
	end

	-- Rectangle d'un objet dans la pièce (px de maquette) : (gauche, haut, droite, bas)
	local function rectOf(entry: Placed): (number, number, number, number)
		local sticker = stickers[entry]
		local item = sticker and sticker.Item or HouseCommon.ItemsById[entry.I]
		local size = (item and item.Size or 80) * entry.S
		local cx = entry.X * room.Width
		local flat = sticker ~= nil and sticker.Flat
		local halfW = size * (flat and 0.7 or 0.4)
		if item and item.Placement == "Wall" then
			local cy = entry.Y * room.Height
			return cx - halfW, cy - size * 0.42, cx + halfW, cy + size * 0.42
		end
		local bottom = entry.Y * room.Height
		local top = bottom - size * (flat and 0.4 or 0.9)
		return cx - halfW, top, cx + halfW, bottom
	end

	local function overlaps(a: Placed, b: Placed): boolean
		local al, at, ar, ab = rectOf(a)
		local bl, bt, br, bb = rectOf(b)
		return al < br and bl < ar and at < bb and bt < ab
	end

	-- Barre en bas (téléphone / petite scène : à la place de l'inventaire si
	-- la fenêtre a donné un "hôte", sinon en bas de la scène) ou près de l'objet
	local docked = false
	local dockHost: GuiObject? = nil
	local function wantDocked(): boolean
		if Interface.IsPhone() then
			return true
		end
		local factor = Interface.Scale > 0 and Interface.Scale or 1
		local stageWidth = room.Stage.AbsoluteSize.X / factor
		return stageWidth > 0 and stageWidth < DOCK_BELOW
	end
	local function applyToolbarMode()
		local dock = wantDocked()
		local host = dockHost
		local parent: Instance = dock and (host or room.Stage) or room.Overlay
		if dock == docked and toolbar.Parent == parent then
			return
		end
		docked = dock
		HouseButtons.HideTipOf(toolbar)
		if host and not dock then
			host.Visible = false
		end
		doneTool.Button.Visible = dock and host ~= nil
		doneSep.Visible = doneTool.Button.Visible
		if dock then
			toolbar.Parent = parent
			toolbar.ZIndex = 25
			toolbarScale.Scale = 1
			if host then
				-- (une seule rangée : nom à gauche, outils à droite)
				toolbarLayout.FillDirection = Enum.FillDirection.Horizontal
				toolbar.AnchorPoint = Vector2.new(0.5, 0.5)
				toolbar.Position = UDim2.fromScale(0.5, 0.5)
			else
				toolbarLayout.FillDirection = Enum.FillDirection.Vertical
				toolbar.AnchorPoint = Vector2.new(0.5, 1)
				toolbar.Position = UDim2.new(0.5, 0, 1, -6)
			end
		else
			toolbarLayout.FillDirection = Enum.FillDirection.Vertical
			toolbar.Parent = room.Overlay
			toolbar.ZIndex = 20
		end
	end

	-- Taille "naturelle" (px, avant UIScale) d'un cadre à AutomaticSize,
	-- calculée depuis son contenu (listes, marges, textes) : juste dès la
	-- première image, sans attendre qu'AbsoluteSize soit mis à jour
	local function measure(gui: GuiObject): (number, number)
		local width, height = gui.Size.X.Offset, gui.Size.Y.Offset
		local auto = gui.AutomaticSize
		if auto == Enum.AutomaticSize.None then
			return width, height
		end
		local contentW, contentH = 0, 0
		if gui:IsA("TextLabel") or gui:IsA("TextButton") then
			local label = gui :: TextLabel
			if label.Text ~= "" then
				local ok, size = pcall(function()
					return TextService:GetTextSize(label.Text, label.TextSize, label.Font, Vector2.new(4000, 1000))
				end)
				if ok and typeof(size) == "Vector2" then
					contentW, contentH = size.X, size.Y
				else
					contentW, contentH = (utf8.len(label.Text) or #label.Text) * label.TextSize * 0.55, label.TextSize
				end
			end
		end
		local list = gui:FindFirstChildOfClass("UIListLayout")
		local horizontal = list ~= nil and list.FillDirection == Enum.FillDirection.Horizontal
		local count = 0
		local sumW, sumH, maxW, maxH = 0, 0, 0, 0
		for _, child in ipairs(gui:GetChildren()) do
			if child:IsA("GuiObject") and child.Visible then
				local w, h = measure(child)
				count += 1
				sumW += w
				sumH += h
				maxW = math.max(maxW, w)
				maxH = math.max(maxH, h)
			end
		end
		if list then
			local gap = list.Padding.Offset * math.max(0, count - 1)
			if horizontal then
				contentW, contentH = math.max(contentW, sumW + gap), math.max(contentH, maxH)
			else
				contentW, contentH = math.max(contentW, maxW), math.max(contentH, sumH + gap)
			end
		else
			contentW, contentH = math.max(contentW, maxW), math.max(contentH, maxH)
		end
		local padding = gui:FindFirstChildOfClass("UIPadding")
		if padding then
			contentW += padding.PaddingLeft.Offset + padding.PaddingRight.Offset
			contentH += padding.PaddingTop.Offset + padding.PaddingBottom.Offset
		end
		if auto == Enum.AutomaticSize.X or auto == Enum.AutomaticSize.XY then
			width = math.max(width, contentW)
		end
		if auto == Enum.AutomaticSize.Y or auto == Enum.AutomaticSize.XY then
			height = math.max(height, contentH)
		end
		return width, height
	end

	-- Hôte (téléphone) : visible avec la barre ; la barre rétrécit si besoin
	local function fitDockHost(visible: boolean)
		local host = dockHost
		if not host or not docked then
			return
		end
		host.Visible = visible
		if visible then
			local factor = Interface.Scale > 0 and Interface.Scale or 1
			local hostWidth = host.AbsoluteSize.X / factor
			local measuredWidth = measure(toolbar)
			local barWidth = math.max(measuredWidth, toolbar.AbsoluteSize.X / factor / math.max(0.2, toolbarScale.Scale))
			if hostWidth > 0 and barWidth > 0 then
				local wanted = math.clamp((hostWidth - 12) / barWidth, 0.5, 1)
				if math.abs(wanted - toolbarScale.Scale) > 1e-3 then
					toolbarScale.Scale = wanted
				end
			end
		end
	end

	local function positionToolbar()
		local entry = selected
		if not entry or not editing or (drag ~= nil and (drag :: Drag).Moved) then
			toolbar.Visible = false
			fitDockHost(false)
			return
		end
		local sticker = stickers[entry]
		if not sticker then
			toolbar.Visible = false
			fitDockHost(false)
			return
		end
		applyToolbarMode()
		if docked then
			toolbar.Visible = true
			fitDockHost(true)
			return
		end
		-- Tout est calculé en px de maquette de la pièce (repère de l'Overlay).
		-- La barre reste ENTIÈREMENT dans la partie visible de la pièce
		-- (pièce ∩ scène) ; si elle n'y tient pas : dans la scène ; si elle
		-- n'y tient toujours pas : elle rétrécit.
		local scale = math.max(0.2, room.Scale)
		local base = 1 / scale
		local current = math.max(0.01, toolbarScale.Scale)
		local pixelRatio = room.Frame.AbsoluteSize.X / math.max(1, room.Width)
		local toolbarSize = toolbar.AbsoluteSize
		-- taille "naturelle" de la barre (échelle de base), en px de la pièce
		-- (contenu mesuré ; AbsoluteSize peut avoir une image de retard)
		local measuredW, measuredH = measure(toolbar)
		local naturalW, naturalH = measuredW * base, measuredH * base
		if pixelRatio > 0 and toolbarSize.X > 0 and toolbarSize.Y > 0 then
			naturalW = math.max(naturalW, toolbarSize.X / pixelRatio * base / current)
			naturalH = math.max(naturalH, toolbarSize.Y / pixelRatio * base / current)
		end
		if naturalW <= 0 or naturalH <= 0 then
			naturalW, naturalH = 560 * base, 120 * base
		end
		local margin = 6 * base
		-- partie visible de la scène, dans le repère de la pièce
		local stageL, stageT, stageR, stageB = -math.huge, -math.huge, math.huge, math.huge
		if pixelRatio > 0 then
			local offset = room.Stage.AbsolutePosition - room.Frame.AbsolutePosition
			local stageSize = room.Stage.AbsoluteSize
			if stageSize.X > 0 and stageSize.Y > 0 then
				stageL, stageT = offset.X / pixelRatio, offset.Y / pixelRatio
				stageR, stageB = stageL + stageSize.X / pixelRatio, stageT + stageSize.Y / pixelRatio
			end
		end
		local function bounds(low: number, high: number, stageLow: number, stageHigh: number, size: number): (number, number)
			local a, b = math.max(low, stageLow) + margin, math.min(high, stageHigh) - margin
			if b - a >= size then
				return a, b
			end
			if stageHigh - stageLow < math.huge then
				return stageLow + margin, stageHigh - margin
			end
			return low + margin, high - margin
		end
		local left, right = bounds(0, room.Width, stageL, stageR, naturalW)
		local ceiling, floorLine = bounds(0, room.Height, stageT, stageB, naturalH)
		-- trop large / trop haute même pour la scène : on rétrécit
		local fit = 1
		if naturalW > right - left and right - left > 0 then
			fit = math.min(fit, (right - left) / naturalW)
		end
		if naturalH > floorLine - ceiling and floorLine - ceiling > 0 then
			fit = math.min(fit, (floorLine - ceiling) / naturalH)
		end
		fit = math.max(0.4, fit)
		local wanted = base * fit
		if math.abs(wanted - toolbarScale.Scale) > 1e-3 then
			toolbarScale.Scale = wanted
		end
		local w, h = naturalW * fit, naturalH * fit
		-- horizontal : centrée sur l'objet, bornée (math.clamp exige min <= max)
		local x = entry.X * room.Width - w / 2
		x = right - w >= left and math.clamp(x, left, right - w) or (left + right - w) / 2
		-- vertical : au-dessus de l'objet, sinon en dessous, sinon du côté le plus libre
		local _, top, _, bottom = rectOf(entry)
		local y
		if top - 6 - h >= ceiling then
			y = top - 6 - h
		elseif bottom + 6 + h <= floorLine then
			y = bottom + 6
		elseif top - ceiling >= floorLine - bottom then
			y = ceiling
		else
			y = floorLine - h
		end
		y = floorLine - h >= ceiling and math.clamp(y, ceiling, floorLine - h) or (ceiling + floorLine - h) / 2
		toolbar.AnchorPoint = Vector2.new(0, 0)
		toolbar.Position = UDim2.fromOffset(x, y)
		toolbar.Visible = true
	end

	-- Où est posé l'objet (étiquette "📍") : meuble porteur ou table de la chaise
	local function placeText(entry: Placed): string?
		local support = HouseSurfaces.SupportOf(entry, layout, room.Width, room.Height)
		if support then
			local furniture = HouseCommon.ItemsById[support.Entry.I]
			if furniture then
				return Locale.T("📍 On: %s", HouseCommon.Name(furniture))
			end
		end
		local seat = HouseSurfaces.SeatedAt(entry, layout, room.Width, room.Height)
		if seat then
			local furniture = HouseCommon.ItemsById[seat.Table.I]
			if furniture then
				return Locale.T("🪑 At: %s", HouseCommon.Name(furniture))
			end
		end
		return nil
	end

	local thumbItemId = ""
	local function refreshToolbarText()
		local entry = selected
		local item = entry and HouseCommon.ItemsById[entry.I]
		if not entry or not item then
			return
		end
		applyToolbarMode()
		local roomData = currentRoomData()
		local comfort = HouseCommon.PlacedComfort(roomData, item)
		local favorite = HouseCommon.IsFavorite(roomData, item)
		local text = string.format("%s  ❤️+%s%s", HouseCommon.Name(item), HouseCommon.FormatPercent(comfort), favorite and "  ✨" or "")
		if nameLabel.Text ~= text then
			nameLabel.Text = text
		end
		if thumbItemId ~= item.Id then
			thumbItemId = item.Id
			for _, child in ipairs(thumb:GetChildren()) do
				if child:IsA("GuiObject") then
					child:Destroy()
				end
			end
			HouseArt.Thumbnail(thumb, item, 26, 23)
		end
		local place = placeText(entry)
		placeChip.Visible = place ~= nil and not docked
		if place and placeLabel.Text ~= place then
			placeLabel.Text = place
		end
		percentLabel.Text = string.format("%d%%", math.floor(entry.S * 100 + 0.5))
		smaller.SetEnabled(entry.S > HouseCommon.MIN_SCALE + 1e-3)
		bigger.SetEnabled(entry.S < HouseCommon.MAX_SCALE - 1e-3)
		copyTool.SetEnabled(available(item.Id) > 0 and #layout < roomItems())
		sendTool.SetEnabled(#house.Rooms >= 2)
		flipTool.SetIcon(entry.F and "↩️" or "↔️")
		-- (v9.1) couleur choisie : ✓ ; verrouillée (visites à l'océan) : 🔒
		for _, sw in ipairs(swatches) do
			local tint = sw.Id and HouseCommon.TintsById[sw.Id] or nil
			local locked = tint ~= nil and not HouseCommon.IsUnlocked(ClientState.Data, tint)
			local chosen = entry.C == sw.Id
			sw.Candy.SetIcon(if chosen then "✔️" elseif locked then "🔒" elseif sw.Id == nil then "🌈" else "")
		end
	end

	local function setSelected(entry: Placed?)
		if selected == entry then
			if entry then
				refreshToolbarText()
			end
			positionToolbar()
			return
		end
		local previous = selected
		if previous and stickers[previous] then
			room.ShowRing(stickers[previous], false)
		end
		selected = entry
		HouseButtons.HideTipOf(toolbar)
		if entry and stickers[entry] then
			local sticker = stickers[entry]
			room.ShowRing(sticker, editing)
			refreshToolbarText()
			if editing then
				UIUtil.Pop(bar, 0.7, 0.28)
				UIUtil.Pop(nameChip, 0.6, 0.3)
			end
		end
		positionToolbar()
		-- (taille réelle de la barre connue à l'image suivante)
		task.defer(positionToolbar)
		selectionChanged:Fire(entry)
	end

	----------------------------------------------------------------------
	-- Sauvegarde automatique
	----------------------------------------------------------------------

	local doSave: () -> ()

	local function markDirty(now: boolean?)
		dirty = true
		saveAt = now and os.clock() or os.clock() + SAVE_DELAY
		saveStatusChanged:Fire("dirty")
		changed:Fire()
		if selected then
			refreshToolbarText()
		end
	end

	doSave = function()
		if saving or not dirty then
			return
		end
		local savedRoom = roomId
		if not savedRoom then
			dirty = false
			return
		end
		saving = true
		dirty = false
		-- Mêmes arrondis que le serveur : la disposition renvoyée sera identique
		for _, entry in ipairs(layout) do
			if not (drag ~= nil and (drag :: Drag).Entry == entry) then
				entry.X = roundTo(entry.X, 0.0001)
				entry.Y = roundTo(entry.Y, 0.0001)
				entry.S = roundTo(entry.S, 0.001)
				entry.Z = math.clamp(math.floor(entry.Z), 0, HouseCommon.MAX_Z)
			end
		end
		local rooms: { [string]: { Placed } } = {}
		for id, list in pairs(extras) do
			if HouseCommon.GetRoom(house, id) then
				rooms[id] = payloadOf(list)
			end
		end
		rooms[savedRoom :: string] = payloadOf(layout)
		local savedSignature = signature(layout)
		saveStatusChanged:Fire("saving")
		task.spawn(function()
			local ok, message = HouseCommon.Invoke("saveLayout", { Rooms = rooms })
			saving = false
			if ok then
				failures = 0
				blockUntil = os.clock() + SYNC_BLOCK
				if savedRoom == roomId then
					lastSignature = savedSignature
				end
				if dirty then
					saveAt = math.max(saveAt, os.clock() + 0.6)
					saveStatusChanged:Fire("dirty")
				else
					saveStatusChanged:Fire("saved")
				end
				return
			end
			failures += 1
			if failures <= 2 then
				-- Refus passager (trop rapide, réseau) : on réessaie un peu plus tard
				dirty = true
				saveAt = os.clock() + RETRY_DELAY * failures
				saveStatusChanged:Fire("dirty")
				return
			end
			failures = 0
			table.clear(extras)
			saveStatusChanged:Fire("error")
			notify(message or Locale.T("Couldn't save your room, try again."), Theme.Colors.Red)
			-- On revient à la dernière disposition connue du serveur
			blockUntil = 0
			editor.Sync(house, true)
		end)
	end

	----------------------------------------------------------------------
	-- Historique (annuler / rétablir), par pièce
	----------------------------------------------------------------------

	local function historyOf(id: string?): History?
		if not id then
			return nil
		end
		local history = histories[id :: string]
		if not history then
			history = { Undo = {}, Redo = {} }
			histories[id :: string] = history
		end
		return history
	end

	-- À appeler AVANT une modification (before = disposition avant, si déjà copiée)
	local function pushUndo(before: { Placed }?, cross: Cross?)
		local history = historyOf(roomId)
		if not history then
			return
		end
		table.insert(history.Undo, { Layout = before or copyList(layout), Cross = cross })
		while #history.Undo > HISTORY_STEPS do
			table.remove(history.Undo, 1)
		end
		table.clear(history.Redo)
		lastNudgeEntry = nil
		historyChanged:Fire()
	end

	----------------------------------------------------------------------
	-- Autocollants
	----------------------------------------------------------------------

	local endDrag: () -> ()

	local function wiggle(sticker: Sticker)
		local body = sticker.Body
		body.Rotation = -10
		UIUtil.Tween(body, 0.5, { Rotation = 0 }, Enum.EasingStyle.Elastic)
		sticker.Pop.Scale = 1.15
		UIUtil.Tween(sticker.Pop, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	end

	local function applyEntry(entry: Placed)
		local sticker = stickers[entry]
		if sticker then
			sticker.Frame.Position = UDim2.fromScale(entry.X, entry.Y)
		end
	end

	-- Objets posés sur `entry` et chaises rangées à cette table (ils le suivent)
	local function ridersOf(entry: Placed): ({ Rider }, { [Placed]: Placed })
		local riders: { Rider } = {}
		local dependents, parents = HouseSurfaces.Dependents(entry, layout, room.Width, room.Height)
		for _, other in ipairs(dependents) do
			table.insert(riders, { Entry = other, DX = other.X - entry.X, DY = other.Y - entry.Y })
		end
		return riders, parents
	end

	-- Place les objets posés sur un meuble qui bouge (et leurs autocollants)
	local function moveRiders(entry: Placed, riders: { Rider })
		for _, rider in ipairs(riders) do
			local other = rider.Entry
			other.X = entry.X + rider.DX
			other.Y = entry.Y + rider.DY
			local sticker = stickers[other]
			if sticker then
				sticker.Frame.Position = UDim2.fromScale(other.X, other.Y)
			end
		end
	end

	-- Déplace un objet et ce qui le suit d'un décalage (dx, dy)
	local function shiftGroup(entry: Placed, dx: number, dy: number, followers: { Placed })
		entry.X += dx
		entry.Y += dy
		applyEntry(entry)
		for _, other in ipairs(followers) do
			other.X += dx
			other.Y += dy
			applyEntry(other)
		end
	end

	-- Chaise rangée à `tableEntry` : se replace à la même place (après un
	-- changement de taille de la chaise ou de la table)
	local function reseat(seat: Placed, tableEntry: Placed, kind: string, followers: { Placed })
		local seatItem = HouseCommon.ItemsById[seat.I]
		if not seatItem then
			return
		end
		for _, spot in ipairs(HouseSurfaces.SeatSpots(tableEntry, seatItem, seat.S, seat.X, room.Width, room.Height)) do
			if spot.Kind == kind then
				local x, y = HouseCommon.ClampPosition(seatItem, spot.X, spot.Y, seat.S, room.Width, room.Height)
				shiftGroup(seat, x - seat.X, y - seat.Y, followers)
				return
			end
		end
	end

	-- Meuble agrandi / rétréci : ce qui est posé dessus reste sur le dessus,
	-- les chaises restent rangées à leur place autour de la table
	local function rescaleRiders(entry: Placed, item: Item, oldX: number, oldY: number, oldS: number, riders: { Rider }, parents: { [Placed]: Placed }, seats: { [Placed]: string })
		local old: Placed = { I = entry.I, X = oldX, Y = oldY, S = oldS, Z = entry.Z, F = entry.F, C = entry.C }
		-- Ce qui est posé sur une chaise suit sa chaise
		local seatOf: { [Placed]: Placed } = {}
		for _, rider in ipairs(riders) do
			local node = rider.Entry
			local depth = 0
			while parents[node] and parents[node] ~= entry and depth < 6 do
				node = parents[node]
				depth += 1
			end
			if seats[node] and node ~= rider.Entry then
				seatOf[rider.Entry] = node
			end
		end
		for seat, kind in pairs(seats) do
			local followers = {}
			for other, owner in pairs(seatOf) do
				if owner == seat then
					table.insert(followers, other)
				end
			end
			reseat(seat, entry, kind, followers)
		end
		for _, rider in ipairs(riders) do
			local other = rider.Entry
			if not seats[other] and not seatOf[other] then
				local bx, by = HouseSurfaces.RoomToBox(old, item, other.X, other.Y, room.Width, room.Height)
				other.X, other.Y = HouseSurfaces.BoxToRoom(entry, item, bx, by, room.Width, room.Height)
				local otherItem = HouseCommon.ItemsById[other.I]
				if otherItem then
					other.X, other.Y = HouseCommon.ClampPosition(otherItem, other.X, other.Y, other.S, room.Width, room.Height, true)
				end
				applyEntry(other)
			end
		end
	end

	-- Chaises rangées à cette table (et leur place)
	local function seatsOf(entry: Placed, riders: { Rider }): { [Placed]: string }
		local seats: { [Placed]: string } = {}
		if not HouseSurfaces.IsTable(entry.I) then
			return seats
		end
		for _, rider in ipairs(riders) do
			local spot = HouseSurfaces.SeatedAt(rider.Entry, layout, room.Width, room.Height)
			if spot and spot.Table == entry then
				seats[rider.Entry] = spot.Kind
			end
		end
		return seats
	end

	-- Meuble rangé / envoyé ailleurs : ce qui était posé dessus tombe par
	-- terre (petit rebond) ; les chaises autour d'une table restent où elles sont
	local function dropRiders(entry: Placed)
		local riders, parents = ridersOf(entry)
		local seats = seatsOf(entry, riders)
		for _, rider in ipairs(riders) do
			local other = rider.Entry
			-- (ce qui est sur une chaise reste sur la chaise)
			local node = other
			local onSeat = seats[other] ~= nil
			local depth = 0
			while not onSeat and parents[node] and parents[node] ~= entry and depth < 6 do
				node = parents[node]
				onSeat = seats[node] ~= nil
				depth += 1
			end
			local item = HouseCommon.ItemsById[other.I]
			local sticker = stickers[other]
			if item and not onSeat then
				local fromY = other.Y
				other.X, other.Y = HouseCommon.ClampPosition(item, other.X, entry.Y + 0.01, other.S, room.Width, room.Height)
				if sticker then
					sticker.Frame.Position = UDim2.fromScale(other.X, other.Y)
					local fall = (other.Y - fromY) * room.Height / math.max(0.2, item.Size * other.S / 100)
					sticker.Body.Position = UDim2.fromOffset(0, -fall)
					UIUtil.Tween(sticker.Body, 0.45, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Bounce)
				end
			end
		end
	end

	local function beginDrag(entry: Placed, input: InputObject)
		local pointer = room.ScreenToRoom(Vector2.new(input.Position.X, input.Position.Y))
		local riders = ridersOf(entry)
		local skip: { [Placed]: boolean } = { [entry] = true }
		for _, rider in ipairs(riders) do
			skip[rider.Entry] = true
		end
		local item = HouseCommon.ItemsById[entry.I]
		drag = {
			Entry = entry,
			Input = input,
			Offset = Vector2.new(entry.X, entry.Y) - pointer,
			Target = Vector2.new(entry.X, entry.Y),
			Start = Vector2.new(input.Position.X, input.Position.Y),
			Moved = false,
			Before = copyList(layout),
			Riders = riders,
			Skip = skip,
			Tabletop = HouseSurfaces.CanStandOn(item),
			IsSeat = HouseSurfaces.IsSeat(entry.I),
			Surface = nil,
			Seat = nil,
			HintKey = "",
			WasOn = HouseSurfaces.SupportOf(entry, layout, room.Width, room.Height) ~= nil,
		}
	end

	local function attachSticker(entry: Placed): Sticker?
		local item = HouseCommon.ItemsById[entry.I]
		if not item then
			return nil
		end
		local sticker = room.CreateSticker(item, entry)
		stickers[entry] = sticker
		sticker.Hit.InputBegan:Connect(function(input: InputObject)
			local kind = input.UserInputType
			if kind ~= Enum.UserInputType.MouseButton1 and kind ~= Enum.UserInputType.Touch then
				return
			end
			if not editing then
				-- (un animal qui dormait chez lui se réveille et vient jouer)
				pets.Poke(entry)
				wiggle(sticker)
				burstAt(sticker, C.Pink, 6)
				SoundManager.Play("Pop", 0.9 + math.random() * 0.3)
				return
			end
			local current = drag
			if current then
				-- Ancien glissement dont la fin a été perdue (bouton relâché hors de la fenêtre)
				if current.Input.UserInputState == Enum.UserInputState.End or current.Input.UserInputState == Enum.UserInputState.Cancel then
					endDrag()
				else
					return
				end
			end
			setSelected(entry)
			beginDrag(entry, input)
		end)
		sticker.Hit.MouseEnter:Connect(function()
			if editing and not drag then
				UIUtil.Tween(sticker.Pop, 0.12, { Scale = 1.05 }, Enum.EasingStyle.Back)
			end
		end)
		sticker.Hit.MouseLeave:Connect(function()
			if not drag or (drag :: Drag).Entry ~= entry then
				UIUtil.Tween(sticker.Pop, 0.12, { Scale = 1 })
			end
		end)
		return sticker
	end

	local function clearStickers()
		for _, sticker in pairs(stickers) do
			room.DestroySticker(sticker)
		end
		table.clear(stickers)
	end

	local function clearHints()
		room.SetZoneHint(nil)
		room.SetGrid(false)
		room.SetSurfaceHint(nil)
		room.ShowSurfaces(nil)
		room.SetTargetGlow(nil)
	end

	local function rebuildFrom(list: { Placed }, keepSelection: boolean?)
		local keepIndex: number? = nil
		if selected and keepSelection ~= false then
			keepIndex = table.find(layout, selected :: Placed)
		end
		drag = nil
		clearHints()
		clearStickers()
		layout = {}
		for _, entry in ipairs(list) do
			local copy = copyEntry(entry)
			if attachSticker(copy) then
				table.insert(layout, copy)
			end
		end
		selected = nil
		-- Même objet toujours là (même place dans la liste) : il reste sélectionné
		if keepIndex and layout[keepIndex] then
			setSelected(layout[keepIndex])
		else
			setSelected(nil)
		end
		resort()
		changed:Fire()
	end

	-- Garde seulement les exemplaires possédés (hors autres pièces)
	local function trimToOwned(list: { Placed }): ({ Placed }, number)
		local others = overrides()
		if roomId then
			others[roomId :: string] = {}
		end
		local kept: { Placed } = {}
		local counts: { [string]: number } = {}
		local dropped = 0
		for _, entry in ipairs(list) do
			local free = HouseCommon.Available(house, entry.I, others)
			local used = counts[entry.I] or 0
			if used < free and #kept < roomItems() then
				counts[entry.I] = used + 1
				table.insert(kept, entry)
			else
				dropped += 1
			end
		end
		return kept, dropped
	end

	----------------------------------------------------------------------
	-- Actions de la barre d'outils
	----------------------------------------------------------------------

	local function refuse(button: GuiObject, text: string?)
		SoundManager.Play("Error", 0.8)
		UIUtil.Shake(button)
		if text then
			notify(text, Theme.Colors.Orange)
		end
	end

	local function snapPoint(item: Item, x: number, y: number, s: number): (number, number)
		if snapEnabled then
			local stepX = GRID / math.max(1, room.Width)
			local stepY = GRID / math.max(1, room.Height)
			x = roundTo(x, stepX)
			y = roundTo(y, stepY)
		end
		return HouseCommon.ClampPosition(item, x, y, s, room.Width, room.Height)
	end

	local function resize(delta: number, button: GuiObject)
		local entry = selected
		local sticker = entry and stickers[entry]
		if not entry or not sticker then
			return
		end
		local newScale = math.clamp(roundTo(entry.S + delta, 0.01), HouseCommon.MIN_SCALE, HouseCommon.MAX_SCALE)
		if math.abs(newScale - entry.S) < 1e-3 then
			refuse(button)
			return
		end
		pushUndo()
		local riders, parents = ridersOf(entry)
		local seats = seatsOf(entry, riders)
		local support = HouseSurfaces.SupportOf(entry, layout, room.Width, room.Height)
		local seated = HouseSurfaces.SeatedAt(entry, layout, room.Width, room.Height)
		local oldX, oldY, oldS = entry.X, entry.Y, entry.S
		entry.S = newScale
		-- Plus grand : l'objet doit rester dans sa zone
		entry.X, entry.Y = HouseCommon.ClampPosition(sticker.Item, entry.X, entry.Y, entry.S, room.Width, room.Height, support ~= nil)
		sticker.Frame.Position = UDim2.fromScale(entry.X, entry.Y)
		if #riders > 0 then
			rescaleRiders(entry, sticker.Item, oldX, oldY, oldS, riders, parents, seats)
		end
		-- Chaise rangée à une table : elle reste bien rangée (avec ce qui est dessus)
		if seated then
			local followers = {}
			for _, rider in ipairs(riders) do
				table.insert(followers, rider.Entry)
			end
			reseat(entry, seated.Table, seated.Kind, followers)
		end
		resort()
		UIUtil.Tween(sticker.Scale, 0.2, { Scale = sticker.Item.Size * newScale / 100 }, Enum.EasingStyle.Back)
		local ringStroke = sticker.RingStroke
		if ringStroke then
			ringStroke.Thickness = 3 / math.max(0.2, sticker.Item.Size * newScale / 100)
		end
		SoundManager.Play("Click", delta > 0 and 1.2 or 0.85)
		task.delay(0.21, positionToolbar)
		markDirty()
	end

	-- Chaise rangée à une table : "devant" / "derrière" la font changer de place
	local function restackSeat(entry: Placed, forward: boolean, button: GuiObject): boolean
		local seated = HouseSurfaces.SeatedAt(entry, layout, room.Width, room.Height)
		if not seated then
			return false
		end
		local want = forward and "Front" or "Behind"
		if seated.Kind == want then
			refuse(button, forward and Locale.T("Already in front!") or Locale.T("Already at the back!"))
			return true
		end
		local item = HouseCommon.ItemsById[entry.I]
		if not item then
			return true
		end
		for _, spot in ipairs(HouseSurfaces.SeatSpots(seated.Table, item, entry.S, entry.X, room.Width, room.Height)) do
			if spot.Kind == want then
				pushUndo()
				local riders = ridersOf(entry)
				local followers = {}
				for _, rider in ipairs(riders) do
					table.insert(followers, rider.Entry)
				end
				local x, y = HouseCommon.ClampPosition(item, spot.X, spot.Y, entry.S, room.Width, room.Height)
				shiftGroup(entry, x - entry.X, y - entry.Y, followers)
				entry.Z = seated.Table.Z
				local sticker = stickers[entry]
				if sticker then
					wiggle(sticker)
				end
				resort()
				positionToolbar()
				SoundManager.Play("Click", forward and 1.15 or 0.9)
				markDirty()
				return true
			end
		end
		refuse(button, Locale.T("No room for this chair there"))
		return true
	end

	-- Devant / derrière : passe devant (ou derrière) TOUS les objets qui le chevauchent
	local function restack(forward: boolean, button: GuiObject)
		local entry = selected
		local sticker = entry and stickers[entry]
		if not entry or not sticker then
			return
		end
		if HouseSurfaces.IsSeat(entry.I) and restackSeat(entry, forward, button) then
			return
		end
		local order = sortedEntries()
		local myIndex = table.find(order, entry) or 0
		local rank = zoneRank(sticker)
		local targetZ: number? = nil
		for index, other in ipairs(order) do
			local otherSticker = stickers[other]
			if other ~= entry and otherSticker and zoneRank(otherSticker) == rank and overlaps(entry, other) then
				if forward and index > myIndex then
					targetZ = math.max(targetZ or -math.huge, other.Z + 1)
				elseif not forward and index < myIndex then
					targetZ = math.min(targetZ or math.huge, other.Z - 1)
				end
			end
		end
		if targetZ == nil then
			refuse(button, forward and Locale.T("Already in front!") or Locale.T("Already at the back!"))
			return
		end
		pushUndo()
		entry.Z = math.clamp(targetZ :: number, 0, HouseCommon.MAX_Z)
		resort()
		wiggle(sticker)
		SoundManager.Play("Click", forward and 1.15 or 0.9)
		markDirty()
	end

	-- Retourne l'objet (miroir) ; un meuble retourné emporte ce qui est
	-- posé dessus et ses chaises (elles restent tournées vers la table)
	local function flip(): boolean
		local entry = selected
		local sticker = entry and stickers[entry]
		if not entry or not sticker then
			return false
		end
		pushUndo()
		local riders = ridersOf(entry)
		local flipped = entry.F ~= true
		entry.F = flipped or nil
		room.SetFlip(sticker, flipped)
		for _, rider in ipairs(riders) do
			local other = rider.Entry
			other.X = entry.X - (other.X - entry.X)
			local info = HouseSurfaces.Seat(other.I)
			local otherSticker = stickers[other]
			if info and info.View == "Side" then
				other.F = (other.F ~= true) or nil
				if otherSticker then
					room.SetFlip(otherSticker, other.F == true)
				end
			end
			local otherItem = HouseCommon.ItemsById[other.I]
			if otherItem then
				other.X = math.clamp(other.X, 0, 1)
			end
			applyEntry(other)
		end
		wiggle(sticker)
		SoundManager.Play("Click", flipped and 1.25 or 1.05)
		resort()
		markDirty()
		return true
	end

	local function removeEntry(entry: Placed, color: Color3)
		local sticker = stickers[entry]
		local index = table.find(layout, entry)
		if not index then
			return
		end
		table.remove(layout, index)
		stickers[entry] = nil
		setSelected(nil)
		if sticker then
			burstAt(sticker, color, 8)
			UIUtil.Tween(sticker.Pop, 0.18, { Scale = 0.1 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			task.delay(0.19, function()
				room.DestroySticker(sticker)
			end)
		end
		resort()
	end

	local function store(entry: Placed)
		if not table.find(layout, entry) then
			return
		end
		pushUndo()
		dropRiders(entry)
		removeEntry(entry, C.Lilac)
		SoundManager.Play("Pop", 0.7)
		markDirty()
	end

	-- Petit déplacement au clavier (dx, dy en px de maquette)
	local function nudge(dx: number, dy: number)
		local entry = selected
		local sticker = entry and stickers[entry]
		if not entry or not sticker or drag then
			return
		end
		local now = os.clock()
		if lastNudgeEntry ~= entry or now - lastNudge > NUDGE_MERGE then
			pushUndo()
			lastNudgeEntry = entry
		end
		lastNudge = now
		local riders = ridersOf(entry)
		local x = entry.X + dx / math.max(1, room.Width)
		local y = entry.Y + dy / math.max(1, room.Height)
		local support = HouseSurfaces.SupportOf(entry, layout, room.Width, room.Height)
		if support and dy <= 0 then
			-- Posé sur un meuble : glisse le long du dessus (flèche bas = descend)
			local surface = support :: HouseSurfaces.Surface
			entry.X = math.clamp(x, surface.L, surface.R)
			entry.X, entry.Y = HouseCommon.ClampPosition(sticker.Item, entry.X, surface.Y, entry.S, room.Width, room.Height, true)
		elseif support then
			entry.X, entry.Y = snapPoint(sticker.Item, x, support.Base + 0.01, entry.S)
		else
			entry.X, entry.Y = snapPoint(sticker.Item, x, y, entry.S)
		end
		applyEntry(entry)
		moveRiders(entry, riders)
		resort()
		positionToolbar()
		markDirty()
	end

	-- Endroit libre (peu de chevauchements) dans la zone de l'objet
	local function freeSpot(item: Item, list: { Placed }): (number, number)
		local minY, maxY = HouseCommon.ZoneBounds(item.Placement)
		local best: Vector2? = nil
		local bestScore = math.huge
		local probe: Placed = { I = item.Id, X = 0.5, Y = (minY + maxY) / 2, S = 1, Z = HouseCommon.DEFAULT_Z }
		for attempt = 1, 16 do
			local x = 0.14 + math.random() * 0.72
			local y
			if item.Placement == "Wall" then
				y = minY + (maxY - minY) * (0.25 + math.random() * 0.5)
			else
				y = minY + (maxY - minY) * (0.35 + math.random() * 0.55)
			end
			probe.X, probe.Y = HouseCommon.ClampPosition(item, x, y, 1, room.Width, room.Height)
			local score = 0
			for _, other in ipairs(list) do
				if overlaps(probe, other) then
					score += 1
				end
			end
			-- Un peu de préférence pour le centre (on voit l'objet arriver)
			score += math.abs(probe.X - 0.5) * 0.4 + attempt * 0.001
			if score < bestScore then
				bestScore = score
				best = Vector2.new(probe.X, probe.Y)
			end
		end
		local spot = best or Vector2.new(0.5, (minY + maxY) / 2)
		return spot.X, spot.Y
	end

	-- Petit objet : une place libre SUR un meuble si possible (la nourriture
	-- sur une table, un coussin ou une peluche sur le lit...)
	local function surfaceSpot(item: Item): (number?, number?)
		if not HouseSurfaces.CanStandOn(item) or item.Category == "Pets" then
			return nil, nil
		end
		local height = item.Size / math.max(1, room.Height)
		local halfW = item.Size * 0.3 / math.max(1, room.Width)
		local candidates: { { Point: Vector2, Pref: number } } = {}
		local bestPref = 0
		for _, entry in ipairs(layout) do
			if HouseSurfaces.Has(entry.I) then
				local pref = HouseSurfaces.Preference(item, entry.I)
				if pref > 0 then
					for _, surface in ipairs(HouseSurfaces.Of(entry, room.Width, room.Height)) do
						if surface.Y >= HouseSurfaces.MinY() and surface.Y - height * 0.92 > -0.02 and surface.R - surface.L > halfW * 2 then
							for _, t in ipairs({ 0.2, 0.5, 0.8 }) do
								local x = surface.L + (surface.R - surface.L) * t
								local free = true
								for _, other in ipairs(layout) do
									if math.abs(other.Y - surface.Y) < 0.01 and math.abs(other.X - x) < halfW * 1.6 then
										free = false
										break
									end
								end
								if free then
									table.insert(candidates, { Point = Vector2.new(x, surface.Y), Pref = pref })
									bestPref = math.max(bestPref, pref)
								end
							end
						end
					end
				end
			end
		end
		local best: { Vector2 } = {}
		for _, candidate in ipairs(candidates) do
			if candidate.Pref == bestPref then
				table.insert(best, candidate.Point)
			end
		end
		-- (hors cuisine et coussins : pas toujours sur un meuble, sinon tout s'y entasse)
		if #best == 0 or (bestPref < 2 and item.Category ~= "Kitchen" and math.random() < 0.35) then
			return nil, nil
		end
		local pick = best[math.random(1, #best)]
		return HouseCommon.ClampPosition(item, pick.X, pick.Y, 1, room.Width, room.Height, true)
	end

	-- Chaise : une place libre à une table (côtés d'abord, puis derrière)
	local function seatSpotFor(item: Item, scale: number, except: Placed?): HouseSurfaces.SeatSpot?
		if not HouseSurfaces.IsSeat(item.Id) then
			return nil
		end
		for _, kindWanted in ipairs({ "Left", "Right", "Behind", "Front" }) do
			for _, tableEntry in ipairs(layout) do
				if HouseSurfaces.IsTable(tableEntry.I) then
					for _, spot in ipairs(HouseSurfaces.SeatSpots(tableEntry, item, scale, tableEntry.X, room.Width, room.Height)) do
						if spot.Kind == kindWanted then
							local taken = false
							for _, other in ipairs(layout) do
								if other ~= except and HouseSurfaces.IsSeat(other.I) then
									local at = HouseSurfaces.SeatedAt(other, layout, room.Width, room.Height)
									if at and at.Table == tableEntry and at.Kind == kindWanted then
										taken = true
										break
									end
								end
							end
							if not taken and spot.X > 0.03 and spot.X < 0.97 then
								return spot
							end
						end
					end
				end
			end
		end
		return nil
	end

	local function canPlace(itemId: string): (boolean, string?)
		local item = HouseCommon.ItemsById[itemId]
		if not item or not roomId then
			return false, nil
		end
		if available(itemId) <= 0 then
			return false, Locale.T("Buy one in the shop first!")
		end
		local maxItems = roomItems()
		if #layout >= maxItems then
			return false, Locale.T("This room is full (%d items)! Decorate another room 🏡", maxItems)
		end
		return true, nil
	end

	-- Nouvelle entrée dans la pièce (arrivée animée), déjà validée
	local function addEntry(entry: Placed, fromAbove: boolean)
		local item = HouseCommon.ItemsById[entry.I]
		table.insert(layout, entry)
		local sticker = attachSticker(entry)
		if sticker then
			sticker.Pop.Scale = 0.2
			UIUtil.Tween(sticker.Pop, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
			if fromAbove then
				sticker.Body.Position = UDim2.fromOffset(0, -40)
				UIUtil.Tween(sticker.Body, 0.45, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Bounce)
			end
			local comfort = HouseCommon.PlacedComfort(currentRoomData(), item)
			task.delay(0.3, function()
				burstAt(sticker, C.Pink, 10)
				floatAt(sticker, string.format("+%s ❤️", HouseCommon.FormatPercent(comfort)), C.PinkDeep)
			end)
		end
		SoundManager.Play("Pop", 1.1)
		resort()
	end

	local function place(itemId: string): boolean
		local ok, reason = canPlace(itemId)
		if not ok then
			if reason then
				notify(reason, Theme.Colors.Orange)
			end
			SoundManager.Play("Error", 0.8)
			return false
		end
		local item = HouseCommon.ItemsById[itemId]
		pushUndo()
		local x, y
		local flipped: boolean? = nil
		local z = HouseCommon.DEFAULT_Z
		local seat = seatSpotFor(item, 1, nil)
		local onX, onY = surfaceSpot(item)
		if seat then
			x, y = HouseCommon.ClampPosition(item, seat.X, seat.Y, 1, room.Width, room.Height)
			flipped = seat.F
			z = seat.Table.Z
		elseif onX and onY then
			x, y = onX, onY
		else
			x, y = freeSpot(item, layout)
			x, y = snapPoint(item, x, y, 1)
		end
		local entry: Placed = { I = itemId, X = x, Y = y, S = 1, Z = z, F = flipped }
		if not seat then
			-- Nouvelle couche au-dessus des objets qu'il chevauche
			for _, other in ipairs(layout) do
				if overlaps(entry, other) then
					entry.Z = math.max(entry.Z, other.Z)
				end
			end
		end
		addEntry(entry, true)
		if editing then
			setSelected(entry)
		end
		markDirty()
		return true
	end

	local function duplicate(): boolean
		local entry = selected
		local sticker = entry and stickers[entry]
		if not entry or not sticker then
			return false
		end
		local ok, reason = canPlace(entry.I)
		if not ok then
			refuse(copyTool.Button, available(entry.I) <= 0 and Locale.T("No other copy in your inventory: buy one in the shop!") or reason)
			return false
		end
		pushUndo()
		local item = sticker.Item
		local copy: Placed = { I = entry.I, X = entry.X, Y = entry.Y, S = entry.S, Z = math.min(HouseCommon.MAX_Z, entry.Z + 1), F = entry.F, C = entry.C }
		local offset = math.max(GRID, item.Size * entry.S * 0.35) / math.max(1, room.Width)
		local support = HouseSurfaces.SupportOf(entry, layout, room.Width, room.Height)
		local seat: HouseSurfaces.SeatSpot? = nil
		if HouseSurfaces.IsSeat(entry.I) and HouseSurfaces.SeatedAt(entry, layout, room.Width, room.Height) then
			seat = seatSpotFor(item, entry.S, nil)
		end
		if seat then
			-- Chaise à table : la copie prend une autre place autour d'une table
			copy.X, copy.Y = HouseCommon.ClampPosition(item, seat.X, seat.Y, entry.S, room.Width, room.Height)
			copy.F = seat.F
			copy.Z = seat.Table.Z
		elseif support then
			-- Posé sur un meuble : la copie reste sur le même dessus
			local x = entry.X + offset
			if x > support.R then
				x = entry.X - offset
			end
			copy.X, copy.Y = HouseCommon.ClampPosition(item, math.clamp(x, support.L, support.R), support.Y, entry.S, room.Width, room.Height, true)
		else
			local x = entry.X + offset
			if x > 0.9 then
				x = entry.X - offset
			end
			copy.X, copy.Y = snapPoint(item, x, entry.Y, entry.S)
		end
		addEntry(copy, false)
		setSelected(copy)
		markDirty()
		return true
	end

	-- Envoie l'objet sélectionné dans une autre pièce (sauvegarde des 2 pièces)
	local function sendTo(targetId: string): boolean
		local entry = selected
		local sticker = entry and stickers[entry]
		local target = HouseCommon.GetRoom(house, targetId)
		if not entry or not sticker or not target or targetId == roomId then
			return false
		end
		local targetList = copyList(layoutOfRoom(targetId))
		if #targetList >= roomItems() then
			refuse(sendTool.Button, Locale.T("This room is full (%d items)! Decorate another room 🏡", roomItems()))
			return false
		end
		local item = sticker.Item
		local before = copyList(targetList)
		local x, y = freeSpot(item, targetList)
		local z = HouseCommon.DEFAULT_Z
		for _, other in ipairs(targetList) do
			z = math.max(z, other.Z)
		end
		table.insert(targetList, { I = entry.I, X = x, Y = y, S = entry.S, Z = z, F = entry.F, C = entry.C })
		pushUndo(nil, { Room = targetId, Before = before, After = copyList(targetList) })
		extras[targetId] = targetList
		floatAt(sticker, "🚪 → " .. HouseCommon.GetRoomType(target).Icon, C.Lilac)
		dropRiders(entry)
		removeEntry(entry, C.Sky)
		SoundManager.Play("Open", 1.3)
		local roomType = HouseCommon.GetRoomType(target)
		notify(Locale.T("%s sent to %s", item.Icon .. " " .. HouseCommon.Name(item), roomType.Icon .. " " .. HouseCommon.Name(roomType)), C.Lilac)
		markDirty(true)
		return true
	end

	-- Applique une étape d'historique ; renvoie l'étape inverse
	local function applyStep(step: Step): Step
		local inverse: Step = { Layout = copyList(layout), Cross = nil }
		local cross = step.Cross
		if cross then
			local current = layoutOfRoom(cross.Room)
			-- (l'autre pièce a changé depuis : on ne touche plus à elle)
			if HouseCommon.GetRoom(house, cross.Room) and signature(current) == signature(cross.After) then
				extras[cross.Room] = copyList(cross.Before)
				inverse.Cross = { Room = cross.Room, Before = copyList(cross.After), After = copyList(cross.Before) }
			end
		end
		local list, dropped = trimToOwned(copyList(step.Layout))
		rebuildFrom(list, false)
		if dropped > 0 then
			notify(Locale.T("Some items are already used in another room"), Theme.Colors.Orange)
		end
		return inverse
	end

	local function undo(): boolean
		local history = historyOf(roomId)
		if not history or #history.Undo == 0 or drag then
			SoundManager.Play("Error", 0.7)
			return false
		end
		local step = table.remove(history.Undo) :: Step
		table.insert(history.Redo, applyStep(step))
		lastNudgeEntry = nil
		SoundManager.Play("Click", 0.8)
		markDirty(true)
		historyChanged:Fire()
		return true
	end

	local function redo(): boolean
		local history = historyOf(roomId)
		if not history or #history.Redo == 0 or drag then
			SoundManager.Play("Error", 0.7)
			return false
		end
		local step = table.remove(history.Redo) :: Step
		table.insert(history.Undo, applyStep(step))
		lastNudgeEntry = nil
		SoundManager.Play("Click", 1.1)
		markDirty(true)
		historyChanged:Fire()
		return true
	end

	smaller.Button.Activated:Connect(function()
		resize(-HouseCommon.SCALE_STEP, smaller.Button)
	end)
	bigger.Button.Activated:Connect(function()
		resize(HouseCommon.SCALE_STEP, bigger.Button)
	end)
	frontTool.Button.Activated:Connect(function()
		restack(true, frontTool.Button)
	end)
	backTool.Button.Activated:Connect(function()
		restack(false, backTool.Button)
	end)
	flipTool.Button.Activated:Connect(function()
		flip()
	end)
	-- (v9.1) 🎨 couleurs
	local function showPalette(on: boolean)
		if palette.Visible == on then
			return
		end
		HouseButtons.HideTipOf(toolbar)
		palette.Visible = on
		bar.Visible = not on
		if on then
			UIUtil.Pop(palette, 0.8, 0.25)
		end
		positionToolbar()
		task.defer(positionToolbar)
	end
	local function setTint(tintId: string?, button: GuiObject)
		local entry = selected
		local sticker = entry and stickers[entry]
		if not entry or not sticker then
			return
		end
		local tint = tintId and HouseCommon.TintsById[tintId] or nil
		if tint and not HouseCommon.IsUnlocked(ClientState.Data, tint) then
			SoundManager.Play("Error", 0.7)
			UIUtil.Shake(button)
			notify(Locale.T("🔒 Unlocked after %d visits to the ocean", HouseCommon.RequiredRebirths(tint)), C.Lilac)
			return
		end
		if entry.C == tintId then
			UIUtil.Pop(button, 1.1, 0.2)
			return
		end
		pushUndo()
		entry.C = tintId
		room.SetTint(sticker, tintId)
		room.ApplySticker(sticker)
		wiggle(sticker)
		burstAt(sticker, tint and tint.Color or C.Pink, 10)
		SoundManager.Play("Pop", 1.15)
		resort()
		markDirty()
	end
	paintTool.Button.Activated:Connect(function()
		SoundManager.Play("Click", 1.2)
		showPalette(true)
	end)
	paletteBack.Button.Activated:Connect(function()
		SoundManager.Play("Click", 0.95)
		showPalette(false)
	end)
	for _, sw in ipairs(swatches) do
		sw.Candy.Button.Activated:Connect(function()
			setTint(sw.Id, sw.Candy.Button)
		end)
	end
	selectionChanged:Connect(function(entry: Placed?)
		if not entry then
			showPalette(false)
		end
	end)
	copyTool.Button.Activated:Connect(function()
		duplicate()
	end)
	sendTool.Button.Activated:Connect(function()
		local entry = selected
		if not entry then
			return
		end
		if #house.Rooms < 2 then
			refuse(sendTool.Button, Locale.T("Buy another room first! 🏡"))
			return
		end
		local handler = sendHandler
		if handler then
			handler(entry)
		end
	end)
	storeTool.Button.Activated:Connect(function()
		local entry = selected
		if entry then
			store(entry)
		end
	end)
	doneTool.Button.Activated:Connect(function()
		SoundManager.Play("Click", 1)
		setSelected(nil)
	end)

	room.BackgroundHit.Activated:Connect(function()
		if not drag then
			setSelected(nil)
		end
	end)
	room.Changed:Connect(positionToolbar)
	room.Stage:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if selected and editing then
			positionToolbar()
		end
	end)
	-- (la taille de la barre change avec le nom / l'étiquette : on la reborne
	-- au rendu suivant ; même échelle -> même taille, pas de boucle)
	local toolbarQueued = false
	toolbar:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if toolbarQueued or not (selected and editing) then
			return
		end
		toolbarQueued = true
		task.defer(function()
			toolbarQueued = false
			positionToolbar()
		end)
	end)

	----------------------------------------------------------------------
	-- Glisser-déposer (souris + tactile)
	----------------------------------------------------------------------

	endDrag = function()
		local current = drag
		if not current then
			return
		end
		drag = nil
		local entry = current.Entry
		local sticker = stickers[entry]
		clearHints()
		if not sticker then
			return
		end
		if current.Moved then
			pushUndo(current.Before)
			entry.X, entry.Y = current.Target.X, current.Target.Y
			local seat = current.Seat
			if seat then
				-- Chaise rangée à la table : même couche que la table, tournée vers elle
				entry.Z = seat.Table.Z
				local info = HouseSurfaces.Seat(entry.I)
				if info and info.View == "Side" then
					entry.F = seat.F == true or nil
				end
			end
			room.SetFlip(sticker, entry.F == true)
			sticker.Frame.Position = UDim2.fromScale(entry.X, entry.Y)
			-- Ce qui est posé dessus suit (et reste dans la pièce)
			moveRiders(entry, current.Riders)
			for _, rider in ipairs(current.Riders) do
				local other = rider.Entry
				local otherItem = HouseCommon.ItemsById[other.I]
				if otherItem then
					local onFurniture = HouseSurfaces.CanStandOn(otherItem)
					other.X, other.Y = HouseCommon.ClampPosition(otherItem, other.X, other.Y, other.S, room.Width, room.Height, onFurniture)
					applyEntry(other)
				end
				local riderSticker = stickers[other]
				if riderSticker then
					UIUtil.Tween(riderSticker.Body, 0.16, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				end
			end
			if current.Surface or seat then
				-- Posé sur un meuble / rangée à table : petites étincelles
				task.delay(0.12, function()
					burstAt(sticker, seat and C.Mint or C.Butter, 7)
				end)
			end
			-- "Plop" : l'objet se pose avec un petit rebond
			UIUtil.Tween(sticker.Body, 0.16, { Position = UDim2.fromOffset(0, 0), Rotation = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			sticker.Pop.Scale = 0.92
			UIUtil.Tween(sticker.Pop, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
			SoundManager.Play("Pop", 1.05 + math.random() * 0.15)
			resort()
			markDirty()
		else
			UIUtil.Tween(sticker.Pop, 0.12, { Scale = 1 })
			sticker.Body.Rotation = 0
		end
		positionToolbar()
	end

	-- Texte de l'étiquette pendant un glissement
	local function hintFor(surface: HouseSurfaces.Surface?, seat: HouseSurfaces.SeatSpot?): string?
		if surface then
			local furniture = HouseCommon.ItemsById[surface.Entry.I]
			return furniture and Locale.T("✨ Put on: %s", HouseCommon.Name(furniture)) or nil
		elseif seat then
			local furniture = HouseCommon.ItemsById[seat.Table.I]
			if not furniture then
				return nil
			end
			local name = HouseCommon.Name(furniture)
			if seat.Kind == "Behind" then
				return Locale.T("🪑 Behind: %s", name)
			elseif seat.Kind == "Front" then
				return Locale.T("🪑 In front of: %s", name)
			end
			return Locale.T("🪑 At the side of: %s", name)
		end
		return nil
	end

	UserInputService.InputChanged:Connect(function(input: InputObject)
		local current = drag
		if not current or not active then
			return
		end
		local kind = input.UserInputType
		local startedWithMouse = current.Input.UserInputType == Enum.UserInputType.MouseButton1
		local matches = (kind == Enum.UserInputType.MouseMovement and startedWithMouse)
			or (kind == Enum.UserInputType.Touch and input == current.Input)
		if not matches then
			return
		end
		local position = Vector2.new(input.Position.X, input.Position.Y)
		local sticker = stickers[current.Entry]
		if not sticker then
			return
		end
		local item = sticker.Item
		if not current.Moved then
			if (position - current.Start).Magnitude < DRAG_THRESHOLD then
				return
			end
			current.Moved = true
			UIUtil.Tween(sticker.Pop, 0.15, { Scale = LIFT_SCALE }, Enum.EasingStyle.Back)
			UIUtil.Tween(sticker.Body, 0.15, { Position = UDim2.fromOffset(0, -8) })
			room.SetZoneHint(item.Placement)
			for _, rider in ipairs(current.Riders) do
				local riderSticker = stickers[rider.Entry]
				if riderSticker then
					UIUtil.Tween(riderSticker.Body, 0.15, { Position = UDim2.fromOffset(0, -8) })
				end
			end
			room.SetGrid(snapEnabled, GRID)
			-- Toutes les places possibles s'allument (petit objet)
			if current.Tabletop then
				local height = item.Size * current.Entry.S / math.max(1, room.Height)
				room.ShowSurfaces(HouseSurfaces.All(layout, height, room.Width, room.Height, current.Skip))
			end
			SoundManager.Play("Click", 1.3)
			resort()
			toolbar.Visible = false
			HouseButtons.HideTipOf(toolbar)
		end
		local pointer = room.ScreenToRoom(position) + current.Offset
		-- Petit objet au-dessus d'un meuble : il se pose SUR le meuble ;
		-- chaise près d'une table : elle se range à la table
		local surface: HouseSurfaces.Surface? = nil
		local seat: HouseSurfaces.SeatSpot? = nil
		if current.Tabletop then
			local height = item.Size * current.Entry.S / math.max(1, room.Height)
			surface = HouseSurfaces.Find(layout, pointer.X, pointer.Y, height, room.Width, room.Height, current.Skip)
		end
		if not surface and current.IsSeat then
			seat = HouseSurfaces.FindSeat(layout, current.Entry, pointer.X, pointer.Y, room.Width, room.Height, current.Skip)
		end
		local x, y
		if surface then
			x = math.clamp(pointer.X, surface.L, surface.R)
			if snapEnabled then
				x = math.clamp(roundTo(x, GRID / math.max(1, room.Width)), surface.L, surface.R)
			end
			x, y = HouseCommon.ClampPosition(item, x, surface.Y, current.Entry.S, room.Width, room.Height, true)
		elseif seat then
			x, y = HouseCommon.ClampPosition(item, seat.X, seat.Y, current.Entry.S, room.Width, room.Height)
		else
			x, y = snapPoint(item, pointer.X, pointer.Y, current.Entry.S)
		end
		-- Indices : dessus visé / place à table, meuble entouré, petit "clic"
		local key = ""
		if surface then
			key = string.format("S%s:%d", tostring(surface.Entry), surface.Index)
		elseif seat then
			key = string.format("C%s:%s", tostring(seat.Table), seat.Kind)
		end
		if key ~= current.HintKey then
			current.HintKey = key
			if key ~= "" then
				SoundManager.Play("Click", 1.45)
			end
		end
		local label = hintFor(surface, seat)
		if surface then
			room.SetSurfaceHint(surface, label, C.PinkDeep)
			room.SetTargetGlow(stickers[surface.Entry])
		elseif seat then
			room.SetSurfaceHint({ L = seat.L, R = seat.R, Y = seat.Top }, label, SEAT_TINT)
			room.SetTargetGlow(stickers[seat.Table])
		else
			room.SetSurfaceHint(nil)
			room.SetTargetGlow(nil)
		end
		-- Chaise de profil : elle se tourne vers la table (aperçu en direct)
		if current.IsSeat then
			local info = HouseSurfaces.Seat(item.Id)
			local wantFlip = current.Entry.F == true
			if seat and info and info.View == "Side" then
				wantFlip = seat.F == true
			end
			room.SetFlip(sticker, wantFlip)
		end
		current.Surface = surface
		current.Seat = seat
		current.Target = Vector2.new(x, y)
	end)

	UserInputService.InputEnded:Connect(function(input: InputObject)
		local current = drag
		if not current then
			return
		end
		local kind = input.UserInputType
		local startedWithMouse = current.Input.UserInputType == Enum.UserInputType.MouseButton1
		if (kind == Enum.UserInputType.MouseButton1 and startedWithMouse) or (kind == Enum.UserInputType.Touch and input == current.Input) then
			endDrag()
		end
	end)

	-- Raccourcis clavier (PC)
	local function isDown(a: Enum.KeyCode, b: Enum.KeyCode): boolean
		return UserInputService:IsKeyDown(a) or UserInputService:IsKeyDown(b)
	end
	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed or not active or not editing or input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		local key = input.KeyCode
		local ctrl = isDown(Enum.KeyCode.LeftControl, Enum.KeyCode.RightControl)
			or isDown(Enum.KeyCode.LeftMeta, Enum.KeyCode.RightMeta)
		local shift = isDown(Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift)
		if ctrl and key == Enum.KeyCode.Z then
			if shift then
				redo()
			else
				undo()
			end
			return
		elseif ctrl and key == Enum.KeyCode.Y then
			redo()
			return
		elseif key == Enum.KeyCode.G and not ctrl then
			editor.SetSnap(not snapEnabled)
			return
		end
		local entry = selected
		if not entry then
			return
		end
		local step = snapEnabled and GRID or (shift and NUDGE_BIG or NUDGE_SMALL)
		if ctrl and key == Enum.KeyCode.D then
			duplicate()
		elseif key == Enum.KeyCode.F and not ctrl then
			flip()
		elseif key == Enum.KeyCode.C and not ctrl then
			showPalette(not palette.Visible)
		elseif key == Enum.KeyCode.Delete or key == Enum.KeyCode.Backspace then
			store(entry)
		elseif key == Enum.KeyCode.Equals or key == Enum.KeyCode.KeypadPlus then
			resize(HouseCommon.SCALE_STEP, bigger.Button)
		elseif key == Enum.KeyCode.Minus or key == Enum.KeyCode.KeypadMinus then
			resize(-HouseCommon.SCALE_STEP, smaller.Button)
		elseif key == Enum.KeyCode.PageUp then
			restack(true, frontTool.Button)
		elseif key == Enum.KeyCode.PageDown then
			restack(false, backTool.Button)
		elseif key == Enum.KeyCode.Left then
			nudge(-step, 0)
		elseif key == Enum.KeyCode.Right then
			nudge(step, 0)
		elseif key == Enum.KeyCode.Up then
			nudge(0, -step)
		elseif key == Enum.KeyCode.Down then
			nudge(0, step)
		elseif key == Enum.KeyCode.Escape then
			setSelected(nil)
		end
	end)

	-- Taille des boutons (tactile : zones de 44 px et plus)
	Interface.DeviceChanged:Connect(function()
		local w, h = toolSize()
		for _, candy in ipairs(candies) do
			if candy.Button.Parent == bar then
				candy.SetSize(w, h)
			else
				candy.SetSize(Interface.IsTouch() and 46 or 40, Interface.IsTouch() and 50 or 46)
			end
		end
		positionToolbar()
	end)

	----------------------------------------------------------------------
	-- API
	----------------------------------------------------------------------

	editor = {
		Changed = changed,
		SaveStatusChanged = saveStatusChanged,
		SelectionChanged = selectionChanged,
		HistoryChanged = historyChanged,
		SetEditing = function(value: boolean)
			if editing == value then
				return
			end
			editing = value
			if not value then
				if drag then
					endDrag()
				end
				setSelected(nil)
			end
			-- En décoration, les animaux rentrent chez eux (on déplace leur "maison")
			pets.SetLive(liveVisible and active and not editing)
			local current = selected
			if current and stickers[current] then
				room.ShowRing(stickers[current], value)
			end
			positionToolbar()
		end,
		IsEditing = function(): boolean
			return editing
		end,
		SetLive = function(visible: boolean)
			liveVisible = visible
			pets.SetLive(visible and active and not editing)
		end,
		GetPets = function(): HousePets.Pets
			return pets
		end,
		SetActive = function(value: boolean)
			active = value
			if not value and drag then
				endDrag()
			end
			pets.SetLive(liveVisible and active and not editing)
		end,
		SetRoom = function(newRoomId: string)
			if newRoomId == roomId then
				return
			end
			if drag then
				endDrag()
			end
			-- La pièce quittée part tout de suite (avec les envois en attente)
			if dirty and not saving then
				doSave()
			elseif dirty then
				-- (sauvegarde en cours : la pièce quittée garde sa disposition locale)
				if roomId then
					extras[roomId :: string] = copyList(layout)
				end
				saveAt = os.clock()
			end
			setSelected(nil)
			roomId = newRoomId
			local pendingList = extras[newRoomId]
			local target = HouseCommon.GetRoom(house, newRoomId)
			local list = pendingList or (target and target.Placed) or {}
			extras[newRoomId] = nil
			rebuildFrom(list, false)
			lastSignature = target and signature(target.Placed) or ""
			historyChanged:Fire()
		end,
		GetRoomId = function(): string?
			return roomId
		end,
		Sync = function(newHouse: HouseData, force: boolean?)
			house = newHouse
			if force ~= true and (dirty or saving or drag ~= nil or os.clock() < blockUntil) then
				return
			end
			if not dirty and not saving then
				table.clear(extras)
			end
			local target = HouseCommon.GetRoom(newHouse, roomId)
			if not target then
				return
			end
			local serverSignature = signature(target.Placed)
			if serverSignature == lastSignature and force ~= true then
				return
			end
			if force == true then
				dirty = false
			end
			lastSignature = serverSignature
			rebuildFrom(target.Placed)
		end,
		GetLayout = function(): { Placed }
			return layout
		end,
		Overrides = overrides,
		Available = available,
		CanPlace = canPlace,
		Place = place,
		Select = function(index: number)
			local entry = layout[index]
			if entry then
				setSelected(entry)
			end
		end,
		Deselect = function()
			setSelected(nil)
		end,
		GetSelected = function(): Placed?
			return selected
		end,
		Duplicate = duplicate,
		Flip = flip,
		SendTo = sendTo,
		SetSendHandler = function(handler: (entry: Placed) -> ())
			sendHandler = handler
		end,
		SetDockHost = function(host: GuiObject?)
			local old = dockHost
			if old and old ~= host then
				old.Visible = false
			end
			dockHost = host
			docked = false
			positionToolbar()
		end,
		Undo = undo,
		Redo = redo,
		CanUndo = function(): boolean
			local history = roomId and histories[roomId :: string]
			return history ~= nil and #history.Undo > 0
		end,
		CanRedo = function(): boolean
			local history = roomId and histories[roomId :: string]
			return history ~= nil and #history.Redo > 0
		end,
		SetSnap = function(on: boolean)
			snapEnabled = on
			SoundManager.Play("Click", on and 1.3 or 0.9)
			historyChanged:Fire()
		end,
		GetSnap = function(): boolean
			return snapEnabled
		end,
		Flush = function()
			if drag then
				endDrag()
			end
			if dirty then
				doSave()
			end
		end,
		IsBusy = function(): boolean
			return dirty or saving
		end,
		Update = function(dt: number)
			clock += dt
			if liveVisible then
				pets.Update(dt)
			end
			local current = drag
			if current and current.Moved then
				local entry = current.Entry
				local sticker = stickers[entry]
				if sticker then
					local alpha = 1 - math.exp(-DRAG_SMOOTHING * dt)
					entry.X += (current.Target.X - entry.X) * alpha
					entry.Y += (current.Target.Y - entry.Y) * alpha
					sticker.Frame.Position = UDim2.fromScale(entry.X, entry.Y)
					-- Petit rebond pendant le transport (pas de rotation : certains
					-- dessins découpent leurs formes, ce qui ne marche pas si on les tourne)
					local bounce = -8 + math.sin(clock * 9) * 2.5
					sticker.Body.Position = UDim2.fromOffset(0, bounce)
					if #current.Riders > 0 then
						moveRiders(entry, current.Riders)
						for _, rider in ipairs(current.Riders) do
							local riderSticker = stickers[rider.Entry]
							if riderSticker then
								-- (même rebond, en px de maquette : dessins de tailles différentes)
								local k = sticker.Item.Size * entry.S / math.max(1, riderSticker.Item.Size * rider.Entry.S)
								riderSticker.Body.Position = UDim2.fromOffset(0, bounce * k)
							end
						end
					end
				end
			end
			-- Contour de sélection qui "respire"
			local entry = selected
			if entry and editing and stickers[entry] then
				local ring = stickers[entry].Ring
				local ringStroke = stickers[entry].RingStroke
				if ring and ringStroke then
					ring.BackgroundTransparency = 0.84 + 0.08 * math.sin(clock * 4)
					ringStroke.Transparency = 0.1 + 0.25 * (0.5 + 0.5 * math.sin(clock * 4))
				end
			end
			-- Sauvegarde automatique
			if dirty and not saving and os.clock() >= saveAt then
				doSave()
			end
		end,
	}

	return editor
end

return HouseEditor
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">HouseExterior</string>
              <string name="Source"><![CDATA[--[[
	HouseExterior (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > HouseExterior

	Façade "maison de poupée" kawaii autour de la grille des pièces : le
	bâtiment est vu de face, mur avant retiré (coupe). Uniquement des Frames.
	Quatre styles (Config.House.Sizes[].Exterior) :
	  - Cottage   : petite chaumière de conte (toit de tuiles rondes,
	    cheminée qui fume, chat sur le toit, porche, barrière, boîte aux
	    lettres, pas japonais, arbre) ;
	  - Townhouse : maison de ville pastel (toit mansardé, lucarnes, balcons
	    en fer forgé, entrée avec marquise rayée, lampadaire, vélo) ;
	  - Loft      : entrepôt de briques (cadres d'usine en acier, toit-terrasse
	    fleuri avec château d'eau et guirlande, escalier de secours, néon) ;
	  - Mansion   : vrai manoir (tours rondes à toits coniques et drapeaux,
	    fronton avec horloge-cœur, lucarnes, balustrades, colonnes, grand
	    escalier double, jardin à la française, fontaine, grille, lanternes).
	Le mode nuit teinte tout en bleu nuit (comme HouseScenery), allume les
	fenêtres et les lanternes, fait sortir les lucioles.
	(v9.1) Build(parent, size, looks?) : couleur de la façade (Facade) et du
	toit (Roof), motif du toit (RoofStyle : cœurs, pois, rayures, étoiles,
	fleurs, neige, écailles) et bande de jardin devant la maison avec la
	déco choisie (Garden, dessins GardenArt) ; SetLooks(looks) redessine la
	façade sans toucher aux pièces.

	API (contrat A) :
	  HouseExterior.CELL_H                 hauteur d'une pièce (px de maquette)
	  HouseExterior.CellWidth(size)        largeur d'une pièce
	  HouseExterior.Build(parent, size) -> Exterior
	      Frame      : racine transparente (AnchorPoint 0.5, 0.5), taille
	                   Width x Height ; l'appelant la place et la met à
	                   l'échelle avec son propre UIScale
	      Cells      : [slot] = { X, Y, W, H } (intérieur de la pièce, relatif
	                   à Frame) ; slot = (étage - 1) * Columns + colonne,
	                   étage 1 en bas, colonne 1 à gauche
	      CellLayer  : calque (au-dessus du fond de façade, sous les détails
	                   avant : dalles, colonnes, garde-corps) pour les pièces
	      SetDark(dark), Update(dt), Destroy()
	  HouseExterior.BuildBackdrop(parent, size?) -> Backdrop (facultatif)
	      ciel pastel (dégradé, nuages, soleil / lune, étoiles, collines) qui
	      remplit `parent` ; { Frame, SetDark(dark), Update(dt), Destroy() }
]]

local HouseCommon = require(script.Parent.HouseCommon)
local HouseArt = require(script.Parent.HouseArt)

type SizeDef = HouseCommon.SizeDef

local HouseExterior = {}

HouseExterior.CELL_H = 190

function HouseExterior.CellWidth(size: SizeDef): number
	return math.floor(300 * (size.Width or 1))
end

export type Rect = { X: number, Y: number, W: number, H: number }

export type Exterior = {
	Frame: Frame,
	Width: number,
	Height: number,
	Cells: { [number]: Rect },
	CellLayer: Frame,
	SetDark: (dark: boolean) -> (),
	SetLooks: (looks: any) -> (),
	Update: (dt: number) -> (),
	Destroy: () -> (),
}

export type Backdrop = {
	Frame: Frame,
	SetDark: (dark: boolean) -> (),
	Update: (dt: number) -> (),
	Destroy: () -> (),
}

----------------------------------------------------------------------
-- Palette
----------------------------------------------------------------------

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local C = HouseCommon.Colors
local INK = C.Ink
local FONT = Enum.Font.FredokaOne

local NIGHT_TINT = Color3.fromRGB(40, 36, 100) -- même voile que HouseScenery
local NIGHT_AMOUNT = 0.42
local LIT = Color3.fromRGB(255, 214, 120) -- fenêtre allumée
local LIT_SOFT = Color3.fromRGB(255, 232, 170)
local GLOW = Color3.fromRGB(255, 222, 140)

local P = {
	Grass = Color3.fromRGB(150, 222, 150),
	GrassDark = Color3.fromRGB(108, 190, 118),
	Leaf = Color3.fromRGB(128, 206, 128),
	LeafDark = Color3.fromRGB(84, 160, 100),
	Trunk = Color3.fromRGB(176, 124, 96),
	Stone = Color3.fromRGB(240, 232, 244),
	StoneDark = Color3.fromRGB(208, 194, 222),
	Pave = Color3.fromRGB(232, 222, 240),
	RoofPink = Color3.fromRGB(255, 150, 190),
	RoofPinkDark = Color3.fromRGB(226, 104, 156),
	Slate = Color3.fromRGB(190, 170, 240),
	SlateDark = Color3.fromRGB(146, 120, 210),
	Brick = Color3.fromRGB(236, 152, 146),
	BrickDark = Color3.fromRGB(208, 116, 120),
	BrickLight = Color3.fromRGB(250, 186, 176),
	Steel = Color3.fromRGB(128, 106, 156),
	SteelDark = Color3.fromRGB(96, 78, 124),
	Glass = Color3.fromRGB(196, 230, 255),
	Gold = Color3.fromRGB(246, 196, 84),
	Water = Color3.fromRGB(150, 215, 255),
	Interior = Color3.fromRGB(232, 206, 230),
}

-- (v9.1) Couleurs choisies par le joueur pendant qu'un style se dessine
-- (façade : Wall ; toit : P.RoofPink / P.Slate remplacés le temps du dessin)
local LOOK: { Wall: Color3? } = {}
-- Jardin devant la maison (déco choisie) : sa hauteur suit la largeur du
-- bâtiment (la déco reste bien visible une fois le manoir réduit à l'écran)
local function gardenHeight(width: number): number
	return math.clamp(math.floor(width * 0.1), 110, 170)
end

----------------------------------------------------------------------
-- Formes de base (même esprit que le kit de HouseArt)
----------------------------------------------------------------------

local function outlineOf(color: Color3): Color3
	return color:Lerp(INK, 0.55)
end

local function box(parent: Instance, x: number, y: number, w: number, h: number, color: Color3, t: number?, z: number?): Frame
	local frame = Instance.new("Frame")
	frame.BorderSizePixel = 0
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = t or 0
	frame.Position = UDim2.fromOffset(x, y)
	frame.Size = UDim2.fromOffset(w, h)
	frame.ZIndex = z or 1
	frame.Parent = parent
	return frame
end

-- Coins arrondis ; r = nil ou négatif -> pilule / ovale
local function round(frame: GuiObject, r: number?)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = if r == nil or r < 0 then UDim.new(1, 0) else UDim.new(0, r)
	corner.Parent = frame
end

local function stroke(frame: GuiObject, color: Color3, thickness: number?, t: number?): UIStroke
	local line = Instance.new("UIStroke")
	line.Color = color
	line.Thickness = thickness or 2
	line.Transparency = t or 0
	line.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	line.LineJoinMode = Enum.LineJoinMode.Round
	line.Parent = frame
	return line
end

-- Dégradé de couleur (multiplie le fond) ; rotation 90 = haut -> bas
local function grad(frame: GuiObject, a: Color3, b: Color3, rotation: number?): UIGradient
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(a, b)
	g.Rotation = rotation or 90
	g.Parent = frame
	return g
end

-- Fondu de transparence ; rotation 90 = haut -> bas
local function fade(frame: GuiObject, from: number, to: number, rotation: number?): UIGradient
	local g = Instance.new("UIGradient")
	g.Transparency = NumberSequence.new(from, to)
	g.Rotation = rotation or 90
	g.Parent = frame
	return g
end

-- Ombrage vertical doux (clair en haut)
local function shade(frame: GuiObject, amount: number?)
	local k = 1 - (amount or 0.1)
	grad(frame, WHITE, Color3.new(k, k, k), 90)
end

local function circle(parent: Instance, cx: number, cy: number, w: number, h: number, color: Color3, t: number?, z: number?): Frame
	local frame = box(parent, cx - w / 2, cy - h / 2, w, h, color, t, z)
	round(frame)
	return frame
end

type PartOpts = {
	R: number?, -- rayon (défaut 6) ; -1 = pilule
	Z: number?,
	T: number?,
	Line: any?, -- false = sans contour ; Color3 ; défaut = teinte foncée
	Th: number?, -- épaisseur du contour (défaut 2)
	Shade: any?, -- false = sans ombrage ; nombre = force (défaut 0.1)
}

-- Forme "autocollant" : fond + contour prune + ombrage
local function part(parent: Instance, x: number, y: number, w: number, h: number, color: Color3, options: PartOpts?): Frame
	local o: PartOpts = options or {}
	local frame = box(parent, x, y, w, h, color, o.T, o.Z)
	local r = o.R
	if r == nil then
		r = 6
	end
	if r ~= 0 then
		round(frame, r)
	end
	if o.Line ~= false then
		stroke(frame, if typeof(o.Line) == "Color3" then o.Line else outlineOf(color), o.Th or 2, 0)
	end
	if o.Shade ~= false then
		shade(frame, if type(o.Shade) == "number" then o.Shade else 0.1)
	end
	return frame
end

local function blob(parent: Instance, cx: number, cy: number, w: number, h: number, color: Color3, options: PartOpts?): Frame
	local o: PartOpts = options or {}
	return part(parent, cx - w / 2, cy - h / 2, w, h, color, { R = -1, Z = o.Z, T = o.T, Line = o.Line, Th = o.Th, Shade = o.Shade })
end

-- Trait arrondi entre deux points (cadre tourné : jamais dans un conteneur découpé)
local function line(parent: Instance, x1: number, y1: number, x2: number, y2: number, th: number, color: Color3, t: number?, z: number?): Frame
	local dx, dy = x2 - x1, y2 - y1
	local length = math.sqrt(dx * dx + dy * dy)
	local frame = box(parent, 0, 0, length + th, th, color, t, z)
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2)
	frame.Rotation = math.deg(math.atan2(dy, dx))
	round(frame)
	return frame
end

local function diamond(parent: Instance, cx: number, cy: number, side: number, color: Color3, t: number?, z: number?): Frame
	local frame = box(parent, 0, 0, side, side, color, t, z)
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromOffset(cx, cy)
	frame.Rotation = 45
	return frame
end

-- Conteneur transparent (groupe) ; clip = découpe (jamais de cadre tourné dedans)
local function group(parent: Instance, x: number, y: number, w: number, h: number, z: number?, clip: boolean?): Frame
	local frame = box(parent, x, y, w, h, WHITE, 1, z)
	frame.ClipsDescendants = clip == true
	return frame
end

-- Cœur (2 cercles + losange) dans un conteneur centré en (cx, cy)
local SQRT2 = math.sqrt(2)
local function heart(parent: Instance, cx: number, cy: number, width: number, color: Color3, t: number?, z: number?): Frame
	local holder = group(parent, cx - width / 2, cy - width / 2, width, width, z)
	local a = width / (1 + 1 / SQRT2)
	local centerY = width / 2 + a * 0.073
	local offset = a / (2 * SQRT2)
	diamond(holder, width / 2, centerY, a, color, t, 1)
	circle(holder, width / 2 - offset, centerY - offset, a, a, color, t, 1)
	circle(holder, width / 2 + offset, centerY - offset, a, a, color, t, 1)
	return holder
end

-- Étincelle à 4 branches (dans un conteneur)
local function sparkle(parent: Instance, cx: number, cy: number, size: number, color: Color3, t: number?, z: number?): Frame
	local holder = group(parent, cx - size / 2, cy - size / 2, size, size, z)
	diamond(holder, size / 2, size / 2, size * 0.36, color, t, 1)
	local thin = math.max(1, size * 0.14)
	round(box(holder, size / 2 - thin / 2, 0, thin, size, color, t, 1))
	round(box(holder, 0, size / 2 - thin / 2, size, thin, color, t, 1))
	return holder
end

-- Trapèze en tranches horizontales (toits, frontons, cônes) : largeur
-- `topW` en haut, `baseW` en bas ; teinte qui fonce doucement vers le bas
local function trapezoid(parent: Instance, cx: number, top: number, topW: number, baseW: number, h: number, color: Color3, bottomColor: Color3?, z: number?, slices: number?): Frame
	local holder = group(parent, cx - baseW / 2, top, baseW, h, z)
	local count = slices or math.clamp(math.floor(h / 7), 4, 30)
	for index = 1, count do
		local k = (index - 0.5) / count
		local w = topW + (baseW - topW) * k
		local slice = box(holder, baseW / 2 - w / 2, (index - 1) * h / count, w, h / count + 0.7, color, 0, 1)
		if bottomColor then
			slice.BackgroundColor3 = color:Lerp(bottomColor, k)
		end
	end
	return holder
end

-- Rangée de festons (demi-ovales) entre x1 et x2, centrés sur y
local function scallops(parent: Instance, x1: number, x2: number, y: number, step: number, h: number, color: Color3, t: number?, z: number?, offset: number?)
	local count = math.max(1, math.floor((x2 - x1) / step))
	local start = x1 + ((x2 - x1) - count * step) / 2 + step / 2 + (offset or 0)
	for index = 0, count - 1 do
		local x = start + index * step
		if x > x1 and x < x2 then
			circle(parent, x, y, step - 2, h, color, t, z)
		end
	end
end

-- Tuiles rondes à l'intérieur d'un trapèze (rangées décalées)
local function tileRows(parent: Instance, cx: number, top: number, topW: number, baseW: number, h: number, rows: number, tile: number, color: Color3, t: number?, z: number?)
	for row = 1, rows do
		local y = h * row / (rows + 1)
		local w = topW + (baseW - topW) * (y / h) - tile * 0.8
		scallops(parent, cx - w / 2, cx + w / 2, top + y, tile, tile * 0.5, color, t, z, (row % 2) * tile / 2)
	end
end

-- Silhouette de plusieurs ovales avec un contour commun (passe contour + passe fond)
local function cluster(parent: Instance, blobs: { { number } }, color: Color3, z: number, lineColor: Color3?, th: number?, light: boolean?)
	local ink = lineColor or outlineOf(color)
	local pad = (th or 2) * 2
	for _, b in ipairs(blobs) do
		circle(parent, b[1], b[2], b[3] + pad, b[4] + pad, ink, 0, z)
	end
	for _, b in ipairs(blobs) do
		local frame = circle(parent, b[1], b[2], b[3], b[4], color, 0, z + 1)
		shade(frame, 0.12)
	end
	if light then
		local b = blobs[1]
		circle(parent, b[1] - b[3] * 0.18, b[2] - b[4] * 0.2, b[3] * 0.34, b[4] * 0.22, WHITE, 0.55, z + 2)
	end
end

-- Pseudo-aléatoire stable
local function noise(a: number, b: number): number
	local value = math.sin(a * 12.9898 + b * 78.233) * 43758.5453
	return value - math.floor(value)
end

----------------------------------------------------------------------
-- Contexte de construction (nuit, lumières, animations)
----------------------------------------------------------------------

type Anim = (clock: number, dark: boolean) -> ()

type Ctx = {
	Back: Frame,
	Front: Frame,
	Fx: Frame,
	Lit: { [Instance]: Color3 },
	Glows: { { Frame: Frame, Night: number } },
	Anims: { Anim },
	NightOnly: { GuiObject },
	DayOnly: { GuiObject },
}

-- Ce cadre prend une couleur "allumée" la nuit (au lieu du voile bleu)
local function lit(ctx: Ctx, frame: Frame, color: Color3?)
	ctx.Lit[frame] = color or LIT
end

-- Halo de lumière (cercles concentriques), visible seulement la nuit
local function glow(ctx: Ctx, parent: Instance, cx: number, cy: number, size: number, color: Color3?, z: number?)
	local tint = color or GLOW
	for index, ring in ipairs({ { 1, 0.86 }, { 0.66, 0.78 }, { 0.38, 0.66 } }) do
		local frame = circle(parent, cx, cy, size * ring[1], size * ring[1], tint, 1, (z or 1) + index - 1)
		frame.Visible = false
		ctx.Lit[frame] = tint
		table.insert(ctx.Glows, { Frame = frame, Night = ring[2] })
	end
end

type WindowOpts = {
	Arch: boolean?, -- haut en plein cintre
	Round: boolean?, -- œil-de-bœuf
	Frame: Color3?,
	Border: number?,
	Cross: string?, -- "+" (défaut) | "|" | "-" | "none"
	Sill: boolean?,
	Z: number?,
	Glass: Color3?,
	NightColor: Color3?,
	Shine: boolean?, -- reflet (défaut true)
}

-- Fenêtre kawaii : contour, cadre, vitre (allumée la nuit), croisillon, reflet
local function window(ctx: Ctx, parent: Instance, x: number, y: number, w: number, h: number, options: WindowOpts?)
	local o: WindowOpts = options or {}
	local z = o.Z or 3
	local fc = o.Frame or C.Cream
	local ink = outlineOf(fc)
	local b = o.Border or math.max(4, math.floor(w * 0.1))
	local glassColor = o.Glass or P.Glass
	local panes: { Frame } = {}
	if o.Round then
		circle(parent, x + w / 2, y + w / 2, w + 4, w + 4, ink, 0, z)
		circle(parent, x + w / 2, y + w / 2, w, w, fc, 0, z + 1)
		table.insert(panes, circle(parent, x + w / 2, y + w / 2, w - b * 2, w - b * 2, glassColor, 0, z + 2))
		h = w
	elseif o.Arch then
		local r = w / 2
		circle(parent, x + r, y + r, w + 4, w + 4, ink, 0, z)
		box(parent, x - 2, y + r, w + 4, h - r + 2, ink, 0, z)
		circle(parent, x + r, y + r, w, w, fc, 0, z + 1)
		box(parent, x, y + r, w, h - r, fc, 0, z + 1)
		table.insert(panes, circle(parent, x + r, y + r, w - b * 2, w - b * 2, glassColor, 0, z + 2))
		table.insert(panes, box(parent, x + b, y + r, w - b * 2, h - r - b, glassColor, 0, z + 2))
	else
		part(parent, x, y, w, h, fc, { R = 4, Z = z, Line = ink, Th = 2, Shade = false })
		local pane = box(parent, x + b, y + b, w - b * 2, h - b * 2, glassColor, 0, z + 2)
		round(pane, 2)
		grad(pane, WHITE, Color3.fromRGB(235, 225, 245), 90)
		table.insert(panes, pane)
	end
	for _, pane in ipairs(panes) do
		lit(ctx, pane, o.NightColor)
	end
	local cross = o.Cross or "+"
	local top = if o.Arch then y + w * 0.3 else y + b
	if cross == "+" or cross == "|" then
		box(parent, x + w / 2 - 1.5, top, 3, y + h - b - top, fc, 0, z + 3)
	end
	if cross == "+" or cross == "-" then
		local cy = if o.Arch then y + w / 2 + (h - w / 2) * 0.35 else y + h / 2
		box(parent, x + b, cy - 1.5, w - b * 2, 3, fc, 0, z + 3)
	end
	-- Reflet
	if o.Shine == false then
		if o.Sill ~= false and not o.Round then
			part(parent, x - 5, y + h - 3, w + 10, 7, fc, { R = 3, Z = z + 4, Line = ink, Th = 1.5, Shade = false })
		end
		return
	end
	local shine = box(parent, x + b + 2, y + b + (if o.Arch or o.Round then w * 0.12 else 2), math.max(3, w * 0.16), math.max(3, h * 0.1), WHITE, 0.45, z + 3)
	round(shine)
	if o.Sill ~= false and not o.Round then
		part(parent, x - 5, y + h - 3, w + 10, 7, fc, { R = 3, Z = z + 4, Line = ink, Th = 1.5, Shade = false })
	end
end

-- Lanterne sur poteau (pied en bas à `bottom`), halo la nuit
local function postLantern(ctx: Ctx, parent: Instance, cx: number, bottom: number, height: number, z: number, color: Color3?)
	local metal = color or C.Ink:Lerp(C.Lilac, 0.35)
	part(parent, cx - 3, bottom - height, 6, height, metal, { R = 3, Z = z, Th = 1.5, Shade = false })
	part(parent, cx - 8, bottom - 8, 16, 8, metal, { R = 3, Z = z, Th = 1.5, Shade = false })
	local head = bottom - height
	glow(ctx, parent, cx, head - 12, 110, nil, z)
	part(parent, cx - 11, head - 26, 22, 26, metal, { R = 5, Z = z + 3, Th = 1.5, Shade = false })
	local glass = box(parent, cx - 7, head - 22, 14, 18, LIT_SOFT, 0, z + 4)
	round(glass, 3)
	lit(ctx, glass, LIT)
	part(parent, cx - 14, head - 32, 28, 8, metal, { R = -1, Z = z + 5, Th = 1.5, Shade = false })
	circle(parent, cx, head - 35, 7, 7, P.Gold, 0, z + 5)
end

-- Lanterne murale (accrochée à droite de x)
local function wallLantern(ctx: Ctx, parent: Instance, x: number, y: number, z: number)
	local metal = C.Ink:Lerp(C.Lilac, 0.35)
	box(parent, x, y - 2, 10, 4, metal, 0, z)
	glow(ctx, parent, x + 12, y + 8, 80, nil, z)
	part(parent, x + 4, y - 4, 16, 22, metal, { R = 4, Z = z + 3, Th = 1.5, Shade = false })
	local glass = box(parent, x + 7, y, 10, 14, LIT_SOFT, 0, z + 4)
	round(glass, 2)
	lit(ctx, glass, LIT)
	part(parent, x + 1, y - 9, 22, 7, metal, { R = -1, Z = z + 5, Th = 1.5, Shade = false })
end

-- Fumée de cheminée : 3 bouffées qui montent, grossissent et s'effacent
local function smoke(ctx: Ctx, parent: Instance, x: number, y: number, z: number)
	local puffs = {}
	for index = 1, 3 do
		table.insert(puffs, circle(parent, x, y, 14, 14, Color3.fromRGB(238, 232, 250), 0.1, z))
	end
	table.insert(ctx.Anims, function(clock)
		for index, puff in ipairs(puffs) do
			local t = (clock * 0.28 + (index - 1) / 3) % 1
			local s = 12 + t * 24
			puff.Size = UDim2.fromOffset(s, s)
			puff.Position = UDim2.fromOffset(x - s / 2 + math.sin(t * 6 + index) * 5, y - t * 64 - s / 2)
			puff.BackgroundTransparency = 0.05 + t * 0.9
		end
	end)
end

-- Drapeau qui ondule (mât + fanion en cœur) ; (x, y) = pied du mât
local function flag(ctx: Ctx, parent: Instance, x: number, y: number, height: number, color: Color3, z: number, phase: number)
	part(parent, x - 3, y - height, 6, height, C.Cream, { R = -1, Z = z, Th = 1.5, Shade = false })
	circle(parent, x, y - height - 3, 11, 11, P.Gold, 0, z + 1)
	local pivot = group(parent, x, y - height + 6, 0, 0, z + 2)
	local cloth = part(pivot, 2, -2, 62, 36, color, { R = 10, Z = 1, Th = 2, Shade = 0.15 })
	box(cloth, 0, 26, 62, 4, WHITE, 0.4, 2)
	heart(cloth, 31, 15, 18, WHITE, 0, 3)
	table.insert(ctx.Anims, function(clock)
		pivot.Rotation = math.sin(clock * 2.4 + phase) * 7 + math.sin(clock * 5.1 + phase) * 2
	end)
end

-- Lucioles (la nuit) qui flottent dans une zone
local function fireflies(ctx: Ctx, parent: Instance, x: number, y: number, w: number, h: number, count: number, z: number)
	local flies = {}
	for index = 1, count do
		local fly = circle(parent, 0, 0, 6, 6, Color3.fromRGB(255, 244, 150), 0.1, z)
		fly.Visible = false
		ctx.Lit[fly] = Color3.fromRGB(255, 244, 150)
		table.insert(ctx.NightOnly, fly)
		table.insert(flies, { Frame = fly, X = noise(index, 41), Y = noise(index, 42), Phase = noise(index, 43) * 6 })
	end
	table.insert(ctx.Anims, function(clock, dark)
		if not dark then
			return
		end
		for _, fly in ipairs(flies) do
			local fx = x + w * (fly.X + math.sin(clock * 0.35 + fly.Phase) * 0.08)
			local fy = y + h * (fly.Y + math.sin(clock * 0.5 + fly.Phase * 1.7) * 0.18)
			fly.Frame.Position = UDim2.fromOffset(fx - 3, fy - 3)
			fly.Frame.BackgroundTransparency = 0.1 + (0.5 + 0.5 * math.sin(clock * 3 + fly.Phase)) * 0.6
		end
	end)
end

-- Petite fleur (pétales + cœur)
local function flower(parent: Instance, cx: number, cy: number, size: number, color: Color3, z: number)
	blob(parent, cx, cy, size, size, color, { Z = z, Th = 1.5, Shade = false })
	circle(parent, cx, cy, size * 0.42, size * 0.42, C.Butter, 0, z + 1)
end

-- Buisson rond (3 bosses)
local function bush(parent: Instance, cx: number, bottom: number, w: number, h: number, color: Color3, z: number)
	cluster(parent, {
		{ cx, bottom - h * 0.45, w * 0.62, h * 0.9 },
		{ cx - w * 0.26, bottom - h * 0.32, w * 0.5, h * 0.64 },
		{ cx + w * 0.26, bottom - h * 0.32, w * 0.5, h * 0.64 },
	}, color, z, nil, 2, true)
end

-- Pot de fleurs + boule de buis
local function pottedBall(parent: Instance, cx: number, bottom: number, s: number, pot: Color3, z: number)
	part(parent, cx - 13 * s, bottom - 20 * s, 26 * s, 20 * s, pot, { R = 5, Z = z + 3, Th = 2 })
	part(parent, cx - 16 * s, bottom - 23 * s, 32 * s, 7 * s, pot:Lerp(WHITE, 0.2), { R = 3, Z = z + 4, Th = 2, Shade = false })
	box(parent, cx - 2 * s, bottom - 36 * s, 4 * s, 14 * s, P.Trunk, 0, z)
	blob(parent, cx, bottom - 44 * s, 36 * s, 34 * s, P.Leaf, { Z = z + 1, Line = P.LeafDark:Lerp(INK, 0.3), Shade = 0.15 })
	circle(parent, cx - 7 * s, bottom - 51 * s, 10 * s, 6 * s, WHITE, 0.55, z + 2)
end

-- Arbre (tronc + feuillage en grappe + petits fruits)
local function tree(parent: Instance, cx: number, bottom: number, s: number, z: number, fruit: Color3?)
	part(parent, cx - 9 * s, bottom - 90 * s, 18 * s, 90 * s, P.Trunk, { R = 6, Z = z, Th = 2 })
	cluster(parent, {
		{ cx, bottom - 138 * s, 120 * s, 104 * s },
		{ cx - 46 * s, bottom - 108 * s, 80 * s, 70 * s },
		{ cx + 46 * s, bottom - 108 * s, 80 * s, 70 * s },
		{ cx, bottom - 96 * s, 90 * s, 50 * s },
	}, P.Leaf, z + 1, P.LeafDark:Lerp(INK, 0.3), 2, true)
	if fruit then
		for index, point in ipairs({ { -30, -120 }, { 24, -148 }, { 40, -104 }, { -8, -100 }, { -52, -100 } }) do
			circle(parent, cx + point[1] * s, bottom + point[2] * s, 11 * s, 11 * s, fruit, 0, z + 4)
			local _ = index
		end
	end
end

-- Chat kawaii assis (pieds en bas à `bottom`, taille s), queue qui se balance
local function cat(ctx: Ctx, parent: Instance, cx: number, bottom: number, s: number, z: number)
	local fur = Color3.fromRGB(255, 236, 214)
	local ink = outlineOf(Color3.fromRGB(230, 170, 140))
	local tailPivot = group(parent, cx + 12 * s, bottom - 6 * s, 0, 0, z)
	part(tailPivot, -4 * s, -30 * s, 8 * s, 32 * s, fur, { R = -1, Z = 1, Line = ink, Th = 2, Shade = false })
	blob(parent, cx, bottom - 15 * s, 34 * s, 30 * s, fur, { Z = z + 1, Line = ink, Th = 2 })
	-- Oreilles (derrière la tête)
	for _, side in ipairs({ -1, 1 }) do
		local ear = diamond(parent, cx + side * 9 * s, bottom - 44 * s, 12 * s, fur, 0, z + 1)
		stroke(ear, ink, 2)
		diamond(parent, cx + side * 9 * s, bottom - 43 * s, 6 * s, C.PinkSoft, 0, z + 2)
	end
	blob(parent, cx, bottom - 34 * s, 32 * s, 26 * s, fur, { Z = z + 3, Line = ink, Th = 2 })
	-- Tache caramel
	circle(parent, cx + 7 * s, bottom - 41 * s, 10 * s, 7 * s, Color3.fromRGB(246, 186, 140), 0, z + 4)
	-- Yeux fermés heureux + museau + joues
	for _, side in ipairs({ -1, 1 }) do
		line(parent, cx + (side * 6 - 2.5) * s, bottom - 35 * s, cx + (side * 6 + 2.5) * s, bottom - 35 * s, 2 * s, INK, 0, z + 5)
		circle(parent, cx + side * 10 * s, bottom - 30 * s, 6 * s, 3.5 * s, C.Pink, 0.35, z + 5)
	end
	circle(parent, cx, bottom - 30 * s, 3 * s, 2 * s, INK, 0, z + 5)
	table.insert(ctx.Anims, function(clock)
		tailPivot.Rotation = math.sin(clock * 1.6) * 16 + 20
	end)
end

-- Voile d'ombre en haut de chaque pièce (intérieur du trou de la façade)
local function cellBacks(parent: Instance, cells: { [number]: Rect }, color: Color3, z: number)
	for _, r in pairs(cells) do
		local back = box(parent, r.X - 3, r.Y - 3, r.W + 6, r.H + 6, color, 0, z)
		round(back, 6)
		shade(back, 0.14)
		local shadow = box(parent, r.X - 3, r.Y - 3, r.W + 6, 34, BLACK, 0.78, z + 1)
		fade(shadow, 0, 1, 90)
	end
end

-- Grille des pièces : x0 = bord gauche de la colonne 1, yTop = haut de
-- l'étage le plus haut, gaps = écarts entre colonnes, slab = épaisseur des dalles
local function makeGrid(size: SizeDef, cellW: number, x0: number, yTop: number, gaps: { number }, slab: number): ({ [number]: Rect }, { number }, { number })
	local cells: { [number]: Rect } = {}
	local colX: { number } = {}
	local x = x0
	for column = 1, size.Columns do
		colX[column] = x
		x += cellW + (gaps[column] or 0)
	end
	local floorY: { number } = {}
	for floorIndex = 1, size.Floors do
		floorY[floorIndex] = yTop + (size.Floors - floorIndex) * (HouseExterior.CELL_H + slab)
		for column = 1, size.Columns do
			cells[(floorIndex - 1) * size.Columns + column] = { X = colX[column], Y = floorY[floorIndex], W = cellW, H = HouseExterior.CELL_H }
		end
	end
	return cells, colX, floorY
end

----------------------------------------------------------------------
-- Styles
----------------------------------------------------------------------

type Built = { Width: number, Height: number, Cells: { [number]: Rect } }

local STYLES: { [string]: (ctx: Ctx, size: SizeDef, cellW: number) -> Built } = {}

-- ░░ Cottage : chaumière de conte ░░
STYLES.Cottage = function(ctx, size, cellW)
	local back, front = ctx.Back, ctx.Front
	local cellH = HouseExterior.CELL_H
	local M, T, S = 30, 22, 26
	local left, right = 124, 170
	local cols, floors = size.Columns, size.Floors
	local bodyW = cols * cellW + (cols - 1) * T + M * 2
	local bodyX = left
	local roofTop = 86
	local roofH = 190
	local eaveY = roofTop + roofH
	local cellTop = eaveY + 18
	local gridH = floors * cellH + (floors - 1) * S
	local cellBottom = cellTop + gridH
	local groundY = cellBottom + 34
	local width = left + bodyW + right
	local height = groundY + 96
	local cx = bodyX + bodyW / 2
	local gaps = {}
	for index = 1, cols - 1 do
		gaps[index] = T
	end
	local cells, colX, floorY = makeGrid(size, cellW, bodyX + M, cellTop, gaps, S)

	local WALL = LOOK.Wall or Color3.fromRGB(255, 242, 228)
	local TIMBER = Color3.fromRGB(206, 150, 112)

	-- Pelouse (derrière la maison)
	local lawn = part(back, 6, groundY - 14, width - 12, height - groundY + 8, P.Grass, { R = 24, Z = 1, Line = P.GrassDark, Shade = 0.12 })
	local _ = lawn
	-- Arbre à gauche (derrière le mur) avec des pommes roses
	tree(back, 94, groundY + 6, 1.05, 2, C.Pink)

	-- Cheminée (derrière le toit) + fumée
	local chimneyX = cx + 150
	part(back, chimneyX, roofTop + 4, 34, 110, Color3.fromRGB(226, 142, 142), { R = 4, Z = 3 })
	for row = 0, 2 do
		box(back, chimneyX + 3, roofTop + 14 + row * 14, 28, 2, Color3.fromRGB(255, 214, 204), 0.3, 4)
	end
	part(back, chimneyX - 5, roofTop - 4, 44, 12, Color3.fromRGB(200, 116, 124), { R = 4, Z = 4 })
	smoke(ctx, back, chimneyX + 17, roofTop - 8, 3)

	-- Mur crème (plâtre) + porche à droite (derrière)
	part(back, bodyX, eaveY - 24, bodyW, groundY - eaveY + 24, WALL, { R = 12, Z = 8, Th = 2.5 })
	local annexW = 128
	local annexX = bodyX + bodyW - 14
	local annexTop = cellTop + 64
	local annexCx = annexX + annexW / 2
	part(back, annexX, annexTop, annexW, groundY - annexTop, if LOOK.Wall then LOOK.Wall:Lerp(C.Pink, 0.12) else Color3.fromRGB(255, 226, 234), { R = 8, Z = 9, Th = 2.5 })
	-- Petit pignon rose du porche (tuiles, rives, cœur, lucarne ronde)
	local gableH = 64
	local gableTop = annexTop - gableH + 6
	trapezoid(back, annexCx, gableTop, 10, annexW + 40, gableH, P.RoofPink, P.RoofPink:Lerp(P.RoofPinkDark, 0.35), 10, 12)
	for _, side in ipairs({ -1, 1 }) do
		local rake = line(back, annexCx + side * 4, gableTop + 1, annexCx + side * (annexW / 2 + 22), annexTop + 7, 11, P.RoofPinkDark, 0, 11)
		stroke(rake, P.RoofPinkDark:Lerp(INK, 0.35), 2)
	end
	heart(back, annexCx, gableTop - 8, 18, C.Heart, 0, 12)
	window(ctx, back, annexCx - 14, gableTop + 24, 28, 28, { Round = true, Z = 12, Frame = C.Cream, Border = 5 })
	scallops(back, annexX - 16, annexX + annexW + 16, annexTop + 12, 24, 12, P.RoofPinkDark, 0, 10)
	-- Porte ronde (vitre en cœur), marche, lanterne
	local doorW, doorH = 60, 106
	local doorX = annexCx - doorW / 2 - 8
	local doorTop = groundY - doorH - 6
	circle(back, doorX + doorW / 2, doorTop + doorW / 2, doorW + 12, doorW + 12, TIMBER, 0, 11)
	box(back, doorX - 6, doorTop + doorW / 2, doorW + 12, doorH - doorW / 2, TIMBER, 0, 11)
	circle(back, doorX + doorW / 2, doorTop + doorW / 2, doorW, doorW, C.Pink, 0, 12)
	local doorLow = box(back, doorX, doorTop + doorW / 2, doorW, doorH - doorW / 2, C.Pink, 0, 12)
	shade(doorLow, 0.15)
	box(back, doorX + doorW / 2 - 1, doorTop + 10, 2, doorH - 12, C.PinkDeep, 0.4, 13)
	local heartGlass = heart(back, doorX + doorW / 2, doorTop + 30, 24, P.Glass, 0, 13)
	for _, child in ipairs(heartGlass:GetChildren()) do
		lit(ctx, child :: Frame)
	end
	circle(back, doorX + doorW - 10, doorTop + doorH * 0.62, 7, 7, P.Gold, 0, 13)
	part(back, doorX - 12, groundY - 8, doorW + 24, 10, P.StoneDark, { R = 4, Z = 13, Shade = false })
	wallLantern(ctx, back, doorX + doorW + 10, doorTop + 30, 13)

	-- Toit : pan de tuiles rondes, rives, festons, faîtage, cœur
	local overhang = 36
	local baseW = bodyW + overhang * 2
	local topW = 64
	trapezoid(back, cx, roofTop, topW, baseW, roofH, P.RoofPink, P.RoofPink:Lerp(P.RoofPinkDark, 0.35), 12, 26)
	tileRows(back, cx, roofTop, topW, baseW, roofH, 3, 34, P.RoofPinkDark, 0.5, 13)
	for _, side in ipairs({ -1, 1 }) do
		local rake = line(back, cx + side * (topW / 2 - 2), roofTop + 2, cx + side * (baseW / 2 + 2), eaveY + 2, 16, P.RoofPinkDark, 0, 15)
		stroke(rake, P.RoofPinkDark:Lerp(INK, 0.35), 2)
	end
	local eave = part(back, cx - baseW / 2 - 6, eaveY - 6, baseW + 12, 14, P.RoofPinkDark, { R = -1, Z = 15, Line = P.RoofPinkDark:Lerp(INK, 0.35) })
	local _ = eave
	scallops(back, cx - baseW / 2, cx + baseW / 2, eaveY + 8, 28, 16, P.RoofPinkDark, 0, 14)
	part(back, cx - topW / 2 - 12, roofTop - 7, topW + 24, 14, P.RoofPinkDark, { R = -1, Z = 16, Line = P.RoofPinkDark:Lerp(INK, 0.35) })
	heart(back, cx, roofTop - 16, 24, C.Heart, 0, 17)
	-- Reflet doux
	round(box(back, cx - topW / 2 - 6, roofTop + 14, 70, 6, WHITE, 0.6, 14))
	-- Lucarne ronde + jardinière
	local winY = roofTop + 70
	window(ctx, back, cx - 32, winY, 64, 64, { Round = true, Z = 20, Frame = C.Cream, Border = 8 })
	part(back, cx - 46, winY + 64, 92, 18, C.Pink, { R = 5, Z = 25, Th = 2 })
	heart(back, cx, winY + 73, 11, WHITE, 0, 26)
	for index, color in ipairs({ C.Butter, WHITE, C.Lilac, C.Butter }) do
		local fx = cx - 33 + (index - 1) * 22
		circle(back, fx, winY + 62, 14, 10, P.Leaf, 0, 22)
		flower(back, fx, winY + 56 - (index % 2) * 4, 15, color, 23)
	end
	-- Chat sur le pan gauche
	local catX = cx - 170
	local slopeY = roofTop + (math.abs(catX - cx) - topW / 2) / ((baseW - topW) / 2) * roofH
	cat(ctx, back, catX, slopeY - 2, 1.45, 26)

	-- Cellules (trous de la façade)
	cellBacks(back, cells, P.Interior, 30)

	-- ░ Détails avant : poutres, poteaux, soubassement ░
	part(front, bodyX + 4, cellTop - 16, bodyW - 8, 18, TIMBER, { R = 5, Z = 2, Th = 2 })
	for index = 0, cols do
		local x = if index == 0 then bodyX + 6 elseif index == cols then bodyX + bodyW - M + 1 else colX[index] + cellW - 3
		local w = if index == 0 or index == cols then M - 7 + 3 else T + 6
		part(front, x, cellTop - 4, w, gridH + 8, TIMBER, { R = 4, Z = 3, Th = 2 })
		if index > 0 and index < cols then
			heart(front, x + w / 2, cellTop + 24, 14, C.Pink, 0, 4)
		end
	end
	for floorIndex = 2, floors do
		part(front, bodyX + 4, floorY[floorIndex] + cellH - 3, bodyW - 8, S + 6, TIMBER, { R = 5, Z = 3 })
	end
	-- Soubassement en pierres rondes + seuil
	part(front, bodyX + 2, cellBottom - 4, bodyW - 4, groundY - cellBottom + 6, P.Stone, { R = 8, Z = 4, Line = P.StoneDark:Lerp(INK, 0.3) })
	part(front, bodyX - 2, cellBottom - 6, bodyW + 4, 10, TIMBER, { R = -1, Z = 6 })
	local stoneCount = math.floor((bodyW - 20) / 46)
	for index = 0, stoneCount - 1 do
		local sx = bodyX + 22 + index * (bodyW - 44) / math.max(1, stoneCount - 1)
		local sy = cellBottom + 16 + (index % 2) * 7
		circle(front, sx, sy, 32, 13, P.StoneDark, 0.35, 5)
	end

	-- Rosier grimpant sur le poteau de gauche
	for index = 0, 5 do
		local ly = groundY - 20 - index * 30
		local lx = bodyX + 18 + (if index % 2 == 0 then -6 else 8)
		blob(front, lx, ly, 22, 14, P.Leaf, { Z = 6, Line = P.LeafDark:Lerp(INK, 0.3), Th = 1.5, Shade = 0.15 })
		if index % 2 == 1 then
			flower(front, lx - 10, ly - 8, 14, C.Pink, 7)
		end
	end

	-- ░ Jardin : buissons, pas japonais, barrière, boîte aux lettres, fleurs ░
	bush(front, bodyX + 16, groundY + 6, 70, 46, P.Leaf, 7)
	bush(front, annexX + annexW - 6, groundY + 6, 60, 40, P.Leaf, 7)
	local gateX = cx + 40
	for index = 0, 4 do
		local k = index / 4
		local sx = gateX + (doorX + doorW / 2 - gateX) * (k ^ 0.8)
		local sy = groundY + 84 - k * 72
		blob(front, sx, sy, 48 - k * 18, 17 - k * 6, P.Stone, { Z = 5, Line = P.StoneDark:Lerp(INK, 0.25), Shade = 0.2 })
	end
	-- Barrière (piquets blancs) en deux morceaux autour du portillon
	local fenceTop, fenceH = groundY + 34, 40
	local function fence(x1: number, x2: number)
		part(front, x1, fenceTop + 10, x2 - x1, 7, WHITE, { R = 3, Z = 8, Line = C.Lilac:Lerp(INK, 0.3), Th = 1.5, Shade = false })
		part(front, x1, fenceTop + 26, x2 - x1, 7, WHITE, { R = 3, Z = 8, Line = C.Lilac:Lerp(INK, 0.3), Th = 1.5, Shade = false })
		local count = math.max(2, math.floor((x2 - x1) / 22))
		for index = 0, count do
			local px = x1 + index * (x2 - x1) / count
			part(front, px - 5, fenceTop, 10, fenceH, WHITE, { R = 5, Z = 9, Line = C.Lilac:Lerp(INK, 0.3), Th = 1.5, Shade = 0.08 })
		end
	end
	fence(14, gateX - 34)
	fence(gateX + 34, math.min(width - 14, gateX + 150))
	-- Fleurs le long de la barrière
	local flowerColors = { C.Pink, C.Butter, C.Lilac, WHITE, C.Peach }
	local count = 9
	for index = 0, count - 1 do
		local fx = 30 + index * (gateX - 80) / (count - 1)
		flower(front, fx, fenceTop + fenceH + 6 + (index % 2) * 5, 13, flowerColors[index % #flowerColors + 1], 11)
	end
	-- Boîte aux lettres (à gauche du portillon)
	local mbX = gateX - 64
	part(front, mbX - 3, fenceTop - 30, 6, 64, TIMBER, { R = 2, Z = 12, Th = 1.5 })
	part(front, mbX - 20, fenceTop - 52, 40, 26, C.Pink, { R = 10, Z = 13, Th = 2 })
	heart(front, mbX - 2, fenceTop - 39, 12, WHITE, 0, 14)
	part(front, mbX + 14, fenceTop - 62, 4, 18, C.Heart, { R = 2, Z = 12, Th = 1.5, Shade = false })

	fireflies(ctx, ctx.Fx, 20, groundY - 150, width - 40, 160, 7, 1)
	return { Width = width, Height = height, Cells = cells, Roof = { CX = cx, Top = roofTop, TopW = topW, BaseW = baseW, H = roofH, Z = 13 } }
end

-- ░░ Townhouse : maison de ville pastel ░░
STYLES.Townhouse = function(ctx, size, cellW)
	local back, front = ctx.Back, ctx.Front
	local cellH = HouseExterior.CELL_H
	local M, T, S = 32, 22, 32
	local left, right = 132, 150
	local cols, floors = size.Columns, size.Floors
	local bodyW = cols * cellW + (cols - 1) * T + M * 2
	local bodyX = left
	local roofTop = 126
	local roofH = 132
	local corniceY = roofTop + roofH - 4
	local cellTop = corniceY + 44
	local gridH = floors * cellH + (floors - 1) * S
	local cellBottom = cellTop + gridH
	local groundY = cellBottom + 36
	local width = left + bodyW + right
	local height = groundY + 86
	local cx = bodyX + bodyW / 2
	local gaps = {}
	for index = 1, cols - 1 do
		gaps[index] = T
	end
	local cells, colX, floorY = makeGrid(size, cellW, bodyX + M, cellTop, gaps, S)

	local WALL = LOOK.Wall or Color3.fromRGB(196, 238, 220)
	local WALL_DARK = if LOOK.Wall then LOOK.Wall:Lerp(INK, 0.22) else Color3.fromRGB(150, 208, 186)
	local TRIM = C.Cream

	-- Trottoir, bordure, rue
	part(back, 0, groundY - 8, width, 64, P.Pave, { R = 0, Z = 1, Line = false, Shade = 0.08 })
	for index = 0, math.floor(width / 72) do
		box(back, 30 + index * 72, groundY + 4, 3, 44, P.StoneDark, 0.4, 2)
	end
	part(back, 0, groundY + 50, width, 12, P.StoneDark, { R = 0, Z = 2, Line = false, Shade = 0.15 })
	part(back, 0, groundY + 62, width, height - groundY - 62, Color3.fromRGB(176, 164, 200), { R = 0, Z = 1, Line = false, Shade = 0.2 })
	for index = 0, math.floor((width - 60) / 90) do
		round(box(back, 20 + index * 90, groundY + 72, 40, 5, WHITE, 0.35, 2))
	end

	-- Cheminées (derrière le toit)
	for _, side in ipairs({ -1, 1 }) do
		local chx = cx + side * (bodyW / 2 - 90) - 18
		part(back, chx, roofTop - 30, 36, 70, Color3.fromRGB(236, 160, 170), { R = 4, Z = 3 })
		part(back, chx - 5, roofTop - 38, 46, 12, Color3.fromRGB(210, 126, 140), { R = 4, Z = 4 })
		part(back, chx + 6, roofTop - 50, 10, 14, Color3.fromRGB(226, 170, 150), { R = 3, Z = 3 })
	end
	smoke(ctx, back, cx + bodyW / 2 - 97, roofTop - 52, 2)

	-- Entrée à droite (cage d'escalier) derrière la façade
	local annexX = bodyX + bodyW - 8
	local annexW = 122
	local annexTop = cellTop + 60
	part(back, annexX, annexTop, annexW, groundY - annexTop, WALL:Lerp(C.Sky, 0.25), { R = 8, Z = 5, Th = 2.5 })
	part(back, annexX - 4, annexTop - 10, annexW + 12, 14, TRIM, { R = 4, Z = 6 })
	-- Garde-corps du toit du porche + plante
	part(back, annexX + 4, annexTop - 34, annexW - 4, 5, WHITE, { R = -1, Z = 5, Th = 1.5, Shade = false })
	for index = 0, 6 do
		box(back, annexX + 6 + index * (annexW - 12) / 6, annexTop - 32, 3, 24, WHITE, 0, 5)
	end
	pottedBall(back, annexX + annexW - 26, annexTop - 10, 0.7, C.Peach, 4)
	-- Fenêtre haute + jardinière
	local winX = annexX + annexW / 2 - 26
	window(ctx, back, winX, annexTop + 30, 52, 80, { Arch = true, Z = 7 })
	part(back, winX - 8, annexTop + 110, 68, 14, C.Pink, { R = 4, Z = 13 })
	for index, color in ipairs({ C.Butter, WHITE, C.Lilac }) do
		flower(back, winX + 6 + (index - 1) * 20, annexTop + 108, 12, color, 11)
	end
	-- Porte d'entrée cintrée, imposte, marquise rayée, marches
	local doorW, doorH = 60, 108
	local doorX = annexX + annexW / 2 - doorW / 2
	local doorTop = cellBottom - doorH
	window(ctx, back, doorX - 6, doorTop - 6, doorW + 12, doorH + 6, { Arch = true, Z = 7, Frame = TRIM, Cross = "none", Sill = false })
	local door = part(back, doorX + 3, doorTop + 32, doorW - 6, doorH - 34, C.PinkDeep:Lerp(C.Pink, 0.5), { R = 4, Z = 12, Th = 2 })
	for _, py in ipairs({ 8, 40 }) do
		part(door, 6, py, doorW - 18, 26, C.Pink, { R = 3, Z = 2, Th = 1.5, Shade = false })
	end
	circle(back, doorX + doorW - 14, doorTop + 76, 7, 7, P.Gold, 0, 13)
	heart(back, doorX + doorW / 2, doorTop + 18, 14, C.Heart, 0, 13)
	-- Marquise rayée
	local awY = doorTop - 40
	local awX = doorX - 24
	local awW = doorW + 48
	part(back, awX, awY, awW, 30, WHITE, { R = 5, Z = 14, Line = C.PinkDeep:Lerp(INK, 0.3) })
	for index = 0, 4 do
		box(back, awX + 5 + index * (awW - 10) / 5, awY + 2, (awW - 10) / 10, 26, C.Pink, 0, 15)
	end
	for index = 0, 4 do
		local sc = circle(back, awX + (index + 0.5) * awW / 5, awY + 30, awW / 5, 18, if index % 2 == 0 then C.Pink else WHITE, 0, 13)
		stroke(sc, C.PinkDeep:Lerp(INK, 0.3), 1.5)
	end
	-- Marches
	for step = 0, 2 do
		part(back, doorX - 14 - step * 10, cellBottom + step * 12, doorW + 28 + step * 20, 13, P.Stone, { R = 3, Z = 16 + step, Line = P.StoneDark:Lerp(INK, 0.3), Shade = 0.15 })
	end
	wallLantern(ctx, back, doorX + doorW + 12, doorTop + 20, 13)
	pottedBall(front, doorX - 40, groundY + 8, 1, C.Lilac, 20)
	pottedBall(front, doorX + doorW + 44, groundY + 8, 1, C.Lilac, 20)

	-- Façade menthe + chaînes d'angle crème
	part(back, bodyX, corniceY + 10, bodyW, groundY - corniceY - 10, WALL, { R = 8, Z = 8, Th = 2.5 })
	for _, x in ipairs({ bodyX + 3, bodyX + bodyW - M + 3 }) do
		local y = corniceY + 40
		local index = 0
		while y < groundY - 30 do
			local w = if index % 2 == 0 then M - 6 else M - 14
			box(back, if x < cx then x else x + (M - 6 - w), y, w, 16, WHITE, 0.35, 9)
			y += 22
			index += 1
		end
	end
	cellBacks(back, cells, P.Interior, 10)

	-- Toit mansardé en ardoises lilas + lucarnes + crête en fer forgé
	local baseW = bodyW + 20
	local topW = bodyW - 80
	trapezoid(back, cx, roofTop, topW, baseW, roofH, P.Slate, P.SlateDark, 20, 22)
	tileRows(back, cx, roofTop, topW, baseW, roofH, 3, 34, P.SlateDark, 0.45, 21)
	for _, side in ipairs({ -1, 1 }) do
		local rake = line(back, cx + side * (topW / 2), roofTop + 2, cx + side * (baseW / 2 - 2), corniceY, 12, P.SlateDark, 0, 22)
		stroke(rake, P.SlateDark:Lerp(INK, 0.35), 2)
	end
	part(back, cx - topW / 2 - 8, roofTop - 8, topW + 16, 12, P.SlateDark, { R = -1, Z = 23, Line = P.SlateDark:Lerp(INK, 0.35) })
	-- Crête : petits poteaux à boules
	local crestCount = math.floor(topW / 56)
	for index = 0, crestCount do
		local px = cx - topW / 2 + index * topW / crestCount
		box(back, px - 1.5, roofTop - 22, 3, 16, INK:Lerp(C.Lilac, 0.3), 0, 22)
		circle(back, px, roofTop - 24, 8, 8, P.Gold, 0, 22)
	end
	heart(back, cx, roofTop - 26, 22, C.Heart, 0, 24)
	-- Lucarnes (une par colonne)
	for column = 1, cols do
		local dx = colX[column] + cellW / 2
		local dw, dh = 70, 84
		local dy = roofTop + 34
		part(back, dx - dw / 2, dy, dw, dh, TRIM, { R = 6, Z = 24, Th = 2 })
		trapezoid(back, dx, dy - 30, 6, dw + 22, 34, C.Pink, C.PinkDeep:Lerp(C.Pink, 0.6), 25, 8)
		local rakeL = line(back, dx - 2, dy - 30, dx - dw / 2 - 12, dy + 4, 8, C.PinkDeep, 0, 26)
		local rakeR = line(back, dx + 2, dy - 30, dx + dw / 2 + 12, dy + 4, 8, C.PinkDeep, 0, 26)
		local _ = rakeL
		local __ = rakeR
		window(ctx, back, dx - 22, dy + 12, 44, 62, { Arch = true, Z = 27 })
	end

	-- Corniche (avant) + modillons
	part(front, bodyX - 14, corniceY, bodyW + 28, 20, TRIM, { R = 6, Z = 2, Th = 2.5 })
	box(front, bodyX - 8, corniceY + 13, bodyW + 16, 3, C.Pink, 0, 3)
	local modCount = math.floor(bodyW / 34)
	for index = 0, modCount do
		part(front, bodyX + 4 + index * (bodyW - 20) / modCount, corniceY + 20, 12, 12, TRIM, { R = 3, Z = 1, Th = 1.5, Shade = false })
	end
	part(front, bodyX + 6, corniceY + 32, bodyW - 12, 12, WALL_DARK, { R = 4, Z = 1, Line = false, Shade = false })

	-- Pilastres crème autour des pièces
	for index = 0, cols do
		local x = if index == 0 then bodyX + M - 15 elseif index == cols then bodyX + bodyW - M - 3 else colX[index] + cellW - 3
		local w = if index == 0 or index == cols then 18 else T + 6
		part(front, x, cellTop - 6, w, gridH + 10, TRIM, { R = 4, Z = 4, Th = 2 })
	end
	-- Dalles + balcons en fer forgé (étages supérieurs)
	for floorIndex = 2, floors do
		local y = floorY[floorIndex] + cellH
		part(front, bodyX + 2, y - 4, bodyW - 4, S + 8, TRIM, { R = 5, Z = 5, Th = 2.5 })
		box(front, bodyX + 8, y + S / 2 - 1, bodyW - 16, 3, C.Pink, 0, 6)
		for column = 1, cols do
			local rx = colX[column] - 4
			local rw = cellW + 8
			part(front, rx, y - 30, rw, 6, WHITE, { R = -1, Z = 8, Line = INK:Lerp(C.Lilac, 0.4), Th = 1.5, Shade = false })
			local bars = math.floor(rw / 18)
			for index = 1, bars - 1 do
				local bx = rx + index * rw / bars
				box(front, bx - 1.5, y - 26, 3, 24, WHITE, 0, 7)
			end
			for _, hx in ipairs({ rx + rw * 0.25, rx + rw * 0.75 }) do
				heart(front, hx, y - 14, 14, C.Pink, 0, 7)
			end
		end
	end
	-- Soubassement
	part(front, bodyX - 2, cellBottom - 5, bodyW + 4, groundY - cellBottom + 6, P.Stone, { R = 6, Z = 5, Line = P.StoneDark:Lerp(INK, 0.3) })
	box(front, bodyX + 6, cellBottom + 14, bodyW - 12, 2, P.StoneDark, 0.3, 6)

	-- Lampadaire + vélo (à gauche, sur le trottoir)
	postLantern(ctx, front, 118, groundY + 30, 250, 10)
	local bikeY = groundY + 38
	local bikeColor = C.Mint:Lerp(C.Sky, 0.3)
	for _, wx in ipairs({ 22, 86 }) do
		local wheel = circle(front, wx, bikeY - 20, 36, 36, WHITE, 1, 20)
		stroke(wheel, INK:Lerp(C.Lilac, 0.2), 4)
		circle(front, wx, bikeY - 20, 6, 6, INK:Lerp(C.Lilac, 0.2), 0, 21)
	end
	line(front, 22, bikeY - 20, 48, bikeY - 46, 5, bikeColor, 0, 22)
	line(front, 48, bikeY - 46, 78, bikeY - 46, 5, bikeColor, 0, 22)
	line(front, 48, bikeY - 20, 78, bikeY - 46, 5, bikeColor, 0, 22)
	line(front, 22, bikeY - 20, 48, bikeY - 20, 5, bikeColor, 0, 22)
	line(front, 86, bikeY - 20, 78, bikeY - 52, 5, bikeColor, 0, 22)
	part(front, 38, bikeY - 58, 20, 7, C.PinkDeep, { R = -1, Z = 23, Th = 1.5 })
	line(front, 70, bikeY - 56, 88, bikeY - 58, 4, INK:Lerp(C.Lilac, 0.2), 0, 23)
	part(front, 80, bikeY - 58, 30, 18, C.Wood, { R = 4, Z = 24, Th = 2 })
	for index, color in ipairs({ C.Pink, C.Butter, WHITE }) do
		flower(front, 84 + (index - 1) * 10, bikeY - 60, 10, color, 23)
	end

	fireflies(ctx, ctx.Fx, 20, groundY - 200, width - 40, 200, 6, 1)
	return { Width = width, Height = height, Cells = cells, Roof = { CX = cx, Top = roofTop, TopW = topW, BaseW = baseW, H = roofH, Z = 21 } }
end

-- ░░ Loft : entrepôt de briques reconverti ░░
STYLES.Loft = function(ctx, size, cellW)
	local back, front = ctx.Back, ctx.Front
	local cellH = HouseExterior.CELL_H
	local ML, MR, T, S = 38, 112, 34, 46
	local left, right = 124, 64
	local cols, floors = size.Columns, size.Floors
	local bodyW = cols * cellW + (cols - 1) * T + ML + MR
	local bodyX = left
	local parapetY = 238
	local cellTop = parapetY + 80
	local gridH = floors * cellH + (floors - 1) * S
	local cellBottom = cellTop + gridH
	local groundY = cellBottom + 30
	local width = left + bodyW + right
	local height = groundY + 80
	local gaps = {}
	for index = 1, cols - 1 do
		gaps[index] = T
	end
	local cells, colX, floorY = makeGrid(size, cellW, bodyX + ML, cellTop, gaps, S)
	local bayX = bodyX + bodyW - MR

	-- Trottoir + bordure
	part(back, 0, groundY - 8, width, 58, P.Pave, { R = 0, Z = 1, Line = false, Shade = 0.08 })
	for index = 0, math.floor(width / 80) do
		box(back, 40 + index * 80, groundY + 4, 3, 40, P.StoneDark, 0.4, 2)
	end
	part(back, 0, groundY + 48, width, height - groundY - 48, P.StoneDark, { R = 0, Z = 2, Line = false, Shade = 0.25 })

	-- ░ Toit-terrasse (derrière le parapet) ░
	-- Château d'eau
	local wtX = bodyX + 170
	local legTop = parapetY - 88
	for _, dx in ipairs({ -40, -14, 14, 40 }) do
		line(back, wtX + dx * 0.8, legTop, wtX + dx * 1.05, parapetY + 4, 5, P.SteelDark, 0, 3)
	end
	line(back, wtX - 38, parapetY - 40, wtX + 38, parapetY - 40, 4, P.SteelDark, 0, 3)
	part(back, wtX - 56, legTop - 84, 112, 90, C.Wood, { R = 10, Z = 4, Th = 2.5, Shade = 0.18 })
	for _, by in ipairs({ 16, 44, 72 }) do
		box(back, wtX - 56, legTop - 84 + by, 112, 4, P.SteelDark, 0.2, 5)
	end
	heart(back, wtX, legTop - 50, 22, C.Pink, 0, 6)
	trapezoid(back, wtX, legTop - 128, 8, 132, 46, P.Slate, P.SlateDark, 5, 12)
	for _, side in ipairs({ -1, 1 }) do
		line(back, wtX + side * 4, legTop - 128, wtX + side * 68, legTop - 82, 8, P.SlateDark, 0, 6)
	end
	circle(back, wtX, legTop - 132, 10, 10, P.Gold, 0, 7)
	-- Guirlande lumineuse entre deux poteaux
	local p1, p2 = bodyX + 420, bodyX + bodyW - 250
	local poleTop = parapetY - 96
	for _, px in ipairs({ p1, p2 }) do
		part(back, px - 3, poleTop, 6, 100, P.SteelDark, { R = 2, Z = 3, Th = 1.5, Shade = false })
		circle(back, px, poleTop - 2, 9, 9, P.Gold, 0, 4)
	end
	local bulbs = {}
	local bulbColors = { C.Pink, C.Butter, C.Mint, C.Sky, C.Lilac }
	local segments = 16
	local prevX, prevY = p1, poleTop + 2
	for index = 1, segments do
		local k = index / segments
		local bx = p1 + (p2 - p1) * k
		local by = poleTop + 2 + math.sin(k * math.pi) * 44
		line(back, prevX, prevY, bx, by, 2, INK, 0.3, 3)
		prevX, prevY = bx, by
		if index < segments then
			local color = bulbColors[index % #bulbColors + 1]
			local bulb = circle(back, bx, by + 6, 10, 13, color, 0, 5)
			stroke(bulb, color:Lerp(INK, 0.5), 1.5)
			ctx.Lit[bulb] = color:Lerp(LIT, 0.35):Lerp(WHITE, 0.3)
			table.insert(bulbs, bulb)
		end
	end
	table.insert(ctx.Anims, function(clock, dark)
		for index, bulb in ipairs(bulbs) do
			local wave = 0.5 + 0.5 * math.sin(clock * 2.2 + index * 1.3)
			bulb.BackgroundTransparency = if dark then wave * 0.2 else 0.05 + wave * 0.15
		end
	end)
	-- Parasol + plantes qui dépassent du parapet
	local umX = bodyX + bodyW - 160
	part(back, umX - 2, parapetY - 78, 4, 80, WHITE, { R = 2, Z = 3, Th = 1.5, Shade = false })
	local canopy = group(back, umX - 58, parapetY - 112, 116, 36, 4, true)
	local dome = circle(canopy, 58, 40, 116, 76, C.Pink, 0, 1)
	stroke(dome, C.PinkDeep:Lerp(INK, 0.3), 2)
	for _, dx in ipairs({ -30, 0, 30 }) do
		box(canopy, 58 + dx - 7, 0, 14, 36, WHITE, 0, 2)
	end
	scallops(back, umX - 58, umX + 58, parapetY - 76, 29, 12, C.Pink, 0, 4)
	for index, bx in ipairs({ bodyX + 60, bodyX + 330, bodyX + 560, bodyX + 700, bodyX + 900 }) do
		bush(back, bx, parapetY + 12, 80 + (index % 2) * 20, 50 + (index % 3) * 8, P.Leaf, 6)
	end
	for index, fx in ipairs({ bodyX + 290, bodyX + 610, bodyX + 820 }) do
		line(back, fx, parapetY + 4, fx + 2, parapetY - 56, 4, P.LeafDark, 0, 5)
		circle(back, fx + 2, parapetY - 60, 30, 30, if index == 2 then C.Pink else C.Butter, 0, 6)
		circle(back, fx + 2, parapetY - 60, 13, 13, Color3.fromRGB(190, 120, 90), 0, 7)
	end

	-- ░ Façade de briques ░
	local wall = part(back, bodyX, parapetY + 6, bodyW, groundY - parapetY - 6, P.Brick, { R = 6, Z = 8, Th = 2.5, Shade = 0.12 })
	local _ = wall
	-- Quelques briques en relief (côtés, dalles, trumeaux)
	local spots = {}
	table.insert(spots, { bodyX + 8, cellTop + 20 })
	table.insert(spots, { bodyX + 6, cellTop + 120 })
	table.insert(spots, { bodyX + 10, cellBottom - 90 })
	for column = 1, cols - 1 do
		local x = colX[column] + cellW + 3
		table.insert(spots, { x, cellTop + 60 + column * 30 })
		table.insert(spots, { x, cellBottom - 60 - column * 20 })
	end
	for floorIndex = 2, floors do
		local y = floorY[floorIndex] + cellH + 12
		for index = 0, cols - 1 do
			table.insert(spots, { colX[index + 1] + 40 + index * 70, y })
			table.insert(spots, { colX[index + 1] + 250 - index * 30, y + 12 })
		end
	end
	for index, spot in ipairs(spots) do
		local bw = if spot[1] < bodyX + 20 or (index % 3 == 0) then 22 else 34
		part(back, spot[1], spot[2], bw, 11, if index % 2 == 0 then P.BrickLight else P.BrickDark, { R = 3, Z = 9, Line = false, Shade = false, T = 0.25 })
	end
	cellBacks(back, cells, Color3.fromRGB(226, 208, 226), 10)

	-- Travée de droite : porte métallique + grande fenêtre d'atelier
	local doorW, doorH = 62, 120
	local doorX = bayX + MR / 2 - doorW / 2 - 2
	local doorTop = cellBottom - doorH + 4
	part(back, doorX - 6, doorTop - 6, doorW + 12, doorH + 6, P.SteelDark, { R = 6, Z = 12, Th = 2 })
	part(back, doorX, doorTop, doorW, doorH - 2, P.Steel:Lerp(C.Mint, 0.35), { R = 4, Z = 13, Th = 2 })
	local doorWin = box(back, doorX + 12, doorTop + 14, doorW - 24, 34, P.Glass, 0, 14)
	round(doorWin, 4)
	lit(ctx, doorWin)
	circle(back, doorX + doorW - 12, doorTop + 70, 7, 7, P.Gold, 0, 14)
	part(back, doorX - 16, doorTop - 22, doorW + 32, 12, P.SteelDark, { R = 3, Z = 15, Th = 2 })
	line(back, doorX - 10, doorTop - 12, doorX + 2, doorTop + 2, 3, P.SteelDark, 0, 14)
	line(back, doorX + doorW + 10, doorTop - 12, doorX + doorW - 2, doorTop + 2, 3, P.SteelDark, 0, 14)
	wallLantern(ctx, back, doorX - 30, doorTop + 30, 14)
	local upperY = floorY[floors]
	local fw, fh = 70, 130
	local fx = bayX + MR / 2 - fw / 2 - 2
	part(back, fx - 5, upperY + 20, fw + 10, fh + 10, P.SteelDark, { R = 5, Z = 12, Th = 2 })
	for row = 0, 2 do
		for column = 0, 1 do
			local pane = box(back, fx + 3 + column * (fw / 2 - 1), upperY + 28 + row * (fh / 3), fw / 2 - 5, fh / 3 - 6, P.Glass, 0, 13)
			round(pane, 2)
			lit(ctx, pane)
		end
	end
	round(box(back, fx + 8, upperY + 34, 8, 20, WHITE, 0.45, 14))

	-- Enseigne néon verticale (à gauche)
	local signX, signY, signW, signH = 26, cellTop + 20, 74, 214
	for _, by in ipairs({ signY + 30, signY + signH - 30 }) do
		part(back, signX + signW - 6, by - 4, bodyX - signX - signW + 16, 8, P.SteelDark, { R = 2, Z = 11, Th = 1.5, Shade = false })
	end
	glow(ctx, back, signX + signW / 2, signY + signH / 2, 200, C.Pink, 12)
	local board = part(back, signX, signY, signW, signH, Color3.fromRGB(86, 64, 120), { R = 16, Z = 15, Line = INK, Th = 3, Shade = false })
	local neonA = Color3.fromRGB(255, 150, 206)
	local neonB = Color3.fromRGB(150, 236, 255)
	local tubes = {}
	local hb = heart(board, signW / 2, 30, 30, neonA, 0, 2)
	table.insert(tubes, hb)
	local letters = {}
	for index, letter in ipairs({ "L", "O", "F", "T" }) do
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.AnchorPoint = Vector2.new(0.5, 0.5)
		label.Position = UDim2.fromOffset(signW / 2, 64 + (index - 1) * 38)
		label.Size = UDim2.fromOffset(signW, 36)
		label.Font = FONT
		label.Text = letter
		label.TextSize = 34
		label.TextColor3 = neonB
		label.ZIndex = 3
		label.Parent = board
		table.insert(letters, label)
	end
	table.insert(ctx.Anims, function(clock, dark)
		local flick = dark and (math.sin(clock * 23) > 0.93 or (clock % 5) < 0.12)
		for index, label in ipairs(letters) do
			local on = if dark then not (flick and index == 3) else true
			label.TextColor3 = if on then (if dark then Color3.fromRGB(190, 250, 255) else neonB) else Color3.fromRGB(110, 100, 150)
		end
		for _, child in ipairs(hb:GetChildren()) do
			if child:IsA("Frame") then
				child.BackgroundColor3 = if dark then Color3.fromRGB(255, 176, 220) else neonA
			end
		end
	end)
	local _ = tubes

	-- ░ Parapet (avant du toit) ░
	part(back, bodyX - 6, parapetY - 6, bodyW + 12, 16, C.Cream, { R = 5, Z = 20, Th = 2.5 })
	for index = 0, math.floor(bodyW / 60) - 1 do
		part(back, bodyX + 16 + index * 60, parapetY + 18, 30, 10, P.BrickDark, { R = 3, Z = 21, Line = false, Shade = false, T = 0.3 })
	end
	box(back, bodyX + 4, parapetY + 36, bodyW - 8, 4, P.BrickDark, 0.35, 21)

	-- ░ Avant : cadres d'usine en acier + impostes vitrées, poutres rivetées ░
	for _, r in pairs(cells) do
		local frame = box(front, r.X - 3, r.Y - 3, r.W + 6, r.H + 6, WHITE, 1, 3)
		round(frame, 5)
		stroke(frame, P.SteelDark, 6)
		-- Imposte : rangée de petits carreaux au-dessus de la pièce (allumés la nuit)
		local sx, sw = r.X + 6, r.W - 12
		local sy, sh = r.Y - 36, 24
		part(front, sx, sy, sw, sh, P.SteelDark, { R = 3, Z = 4, Th = 1.5, Shade = false })
		local n = 6
		local pw = (sw - 4 * (n + 1)) / n
		for index = 0, n - 1 do
			local pane = box(front, sx + 4 + index * (pw + 4), sy + 4, pw, sh - 8, P.Glass, 0, 5)
			round(pane, 2)
			grad(pane, WHITE, Color3.fromRGB(226, 220, 246), 90)
			lit(ctx, pane)
		end
	end
	for floorIndex = 2, floors do
		local y = floorY[floorIndex] + cellH
		part(front, bodyX + 4, y + 1, bodyW - 8, 10, P.SteelDark, { R = 3, Z = 2, Th = 2 })
		for index = 0, math.floor(bodyW / 40) do
			circle(front, bodyX + 16 + index * 40, y + 6, 4, 4, P.Gold, 0, 3)
		end
	end
	-- Seuil en béton
	part(front, bodyX - 4, cellBottom + 2, bodyW + 8, groundY - cellBottom, Color3.fromRGB(226, 216, 232), { R = 4, Z = 2, Line = P.StoneDark:Lerp(INK, 0.3) })

	-- ░ Escalier de secours (devant la travée de droite) ░
	local steel = P.SteelDark
	local landingY = floorY[floors] + cellH
	local fx1, fx2 = bayX - 20, bodyX + bodyW + 40
	part(front, fx1, landingY - 4, fx2 - fx1, 9, steel, { R = 2, Z = 10, Th = 1.5, Shade = false })
	part(front, fx1, landingY - 60, fx2 - fx1, 5, steel, { R = 2, Z = 10, Th = 1.5, Shade = false })
	for index = 0, 6 do
		box(front, fx1 + 2 + index * (fx2 - fx1 - 4) / 6, landingY - 58, 3, 56, steel, 0, 10)
	end
	-- Volée vers le toit
	local sx1, sy1 = fx1 + 18, landingY - 6
	local sx2, sy2 = fx2 - 14, parapetY + 4
	line(front, sx1, sy1, sx2, sy2, 6, steel, 0, 11)
	line(front, sx1, sy1 - 30, sx2, sy2 - 30, 4, steel, 0, 11)
	for k = 1, 3 do
		local t = k / 4
		box(front, sx1 + (sx2 - sx1) * t - 1.5, sy1 + (sy2 - sy1) * t - 30, 3, 30, steel, 0, 11)
	end
	for index = 1, 9 do
		local k = index / 10
		local tx = sx1 + (sx2 - sx1) * k
		local ty = sy1 + (sy2 - sy1) * k
		box(front, tx - 10, ty - 2, 20, 4, steel, 0, 11)
	end
	part(front, fx2 - 44, parapetY - 2, 60, 7, steel, { R = 2, Z = 11, Th = 1.5, Shade = false })
	-- Échelle repliée sous le palier
	local lx = fx2 - 30
	box(front, lx - 12, landingY + 4, 4, 130, steel, 0, 10)
	box(front, lx + 8, landingY + 4, 4, 130, steel, 0, 10)
	for index = 0, 6 do
		box(front, lx - 12, landingY + 14 + index * 18, 24, 3, steel, 0, 10)
	end

	-- ░ Trottoir : caisses fleuries, banc, grandes plantes ░
	for index, crate in ipairs({ { 20, groundY + 26, 54, 40 }, { 66, groundY + 26, 48, 34 }, { 36, groundY - 14, 44, 34 } }) do
		local c = part(front, crate[1], crate[2] - crate[4], crate[3], crate[4], C.Wood, { R = 4, Z = 14 + (if index == 3 then 2 else 0), Th = 2 })
		box(c, 4, crate[4] / 2 - 2, crate[3] - 8, 4, C.WoodDark, 0.4, 2)
	end
	bush(front, 58, groundY - 44, 50, 34, P.Leaf, 17)
	flower(front, 46, groundY - 60, 12, C.Pink, 20)
	flower(front, 70, groundY - 56, 12, C.Butter, 20)
	local benchX = colX[1] + cellW + T / 2 - 60
	part(front, benchX, groundY + 6, 120, 12, C.Pink, { R = 4, Z = 14, Th = 2 })
	part(front, benchX, groundY - 20, 120, 12, C.Pink, { R = 4, Z = 14, Th = 2 })
	for _, lx2 in ipairs({ benchX + 12, benchX + 100 }) do
		box(front, lx2, groundY + 16, 8, 20, P.SteelDark, 0, 13)
	end
	for index, px in ipairs({ colX[2] + cellW + T / 2, bayX - 50 }) do
		pottedBall(front, px, groundY + 38, 1.25, if index == 1 then C.Peach else C.Lilac, 14)
	end

	fireflies(ctx, ctx.Fx, 40, parapetY - 140, width - 80, 150, 7, 1)
	-- (toit-terrasse : le motif du toit décore la cuve du château d'eau)
	return { Width = width, Height = height, Cells = cells, Roof = { CX = wtX, Top = legTop - 80, TopW = 104, BaseW = 104, H = 84, Z = 5 } }
end

-- ░░ Mansion : le grand manoir kawaii ░░
STYLES.Mansion = function(ctx, size, cellW)
	local back, front = ctx.Back, ctx.Front
	local cellH = HouseExterior.CELL_H
	local cols, floors = size.Columns, size.Floors
	local M, T, BAY, S = 34, 24, 100, 36
	local towerW = 200
	local towerOut = 170 -- partie de la tour qui dépasse du corps
	local margin = 64
	local gaps = {}
	for index = 1, cols - 1 do
		gaps[index] = if index == math.floor(cols / 2) then BAY else T
	end
	local gridW = cols * cellW
	for _, g in ipairs(gaps) do
		gridW += g
	end
	local bodyW = gridW + M * 2
	local bodyX = margin + towerOut
	local cx = bodyX + bodyW / 2
	local roofTop = 246
	local roofH = 150
	local corniceY = roofTop + roofH - 6
	local cellTop = corniceY + 48
	local gridH = floors * cellH + (floors - 1) * S
	local cellBottom = cellTop + gridH
	local plinthH = 96
	local groundY = cellBottom + plinthH
	local width = bodyX + bodyW + towerOut + margin
	local height = groundY + 262
	local cells, colX, floorY = makeGrid(size, cellW, bodyX + M, cellTop, gaps, S)
	local bayX = colX[math.floor(cols / 2)] + cellW
	local bayCx = bayX + BAY / 2

	local WALL = LOOK.Wall or Color3.fromRGB(255, 232, 242)
	local WALL_SHADE = if LOOK.Wall then LOOK.Wall:Lerp(INK, 0.1) else Color3.fromRGB(246, 208, 228)
	local TRIM = Color3.fromRGB(255, 250, 244)
	local TOWER = if LOOK.Wall then LOOK.Wall:Lerp(C.Pink, 0.1) else Color3.fromRGB(255, 218, 234)
	local ROOF = P.Slate
	local ROOF_DARK = P.SlateDark

	-- ░ Jardin (fond) : pelouse, allée ░
	part(back, 10, groundY - 20, width - 20, height - groundY + 14, P.Grass, { R = 30, Z = 1, Line = P.GrassDark, Shade = 0.14 })
	for index = 0, 2 do
		round(box(back, 30, groundY + 40 + index * 64, width - 60, 26, WHITE, 0.82, 2), 13)
	end
	local path = group(back, 0, 0, width, height, 3)
	local pathSlices = 6
	for index = 0, pathSlices - 1 do
		local k = index / pathSlices
		local w = 150 + k * 170
		local y = groundY + 2 + index * (height - groundY - 10) / pathSlices
		box(path, bayCx - w / 2, y, w, (height - groundY - 10) / pathSlices + 1, Color3.fromRGB(250, 236, 222), 0, 1)
	end

	-- ░ Toit principal mansardé (ardoises lilas) ░
	local roofBase = bodyW + 30
	local roofTopW = bodyW - 190
	-- Cheminées
	for _, side in ipairs({ -1, 1 }) do
		local chx = cx + side * (roofTopW / 2 - 70) - 20
		part(back, chx, roofTop - 50, 40, 80, Color3.fromRGB(246, 180, 196), { R = 4, Z = 3 })
		part(back, chx - 6, roofTop - 58, 52, 13, Color3.fromRGB(220, 140, 166), { R = 4, Z = 4 })
		if side > 0 then
			smoke(ctx, back, chx + 20, roofTop - 62, 2)
		end
	end
	trapezoid(back, cx, roofTop, roofTopW, roofBase, roofH, ROOF, ROOF_DARK, 5, 16)
	for _, side in ipairs({ -1, 1 }) do
		local rake = line(back, cx + side * (roofTopW / 2 + 2), roofTop, cx + side * (roofBase / 2 - 2), corniceY + 4, 12, ROOF_DARK, 0, 8)
		stroke(rake, ROOF_DARK:Lerp(INK, 0.35), 2)
	end
	-- Tuiles (hors fronton)
	for row = 1, 3 do
		local y = roofH * row / 4
		local w = roofTopW + (roofBase - roofTopW) * (y / roofH) - 30
		local tile = 50
		scallops(back, cx - w / 2, cx - 330, roofTop + y, tile, 20, ROOF_DARK, 0.45, 6, (row % 2) * tile / 2)
		scallops(back, cx + 330, cx + w / 2, roofTop + y, tile, 20, ROOF_DARK, 0.45, 6, (row % 2) * tile / 2)
	end
	part(back, cx - roofTopW / 2 - 10, roofTop - 10, roofTopW + 20, 14, ROOF_DARK, { R = -1, Z = 8, Line = ROOF_DARK:Lerp(INK, 0.35) })
	-- Crête dorée
	local crestCount = math.floor(roofTopW / 110)
	for index = 0, crestCount do
		local px = cx - roofTopW / 2 + index * roofTopW / crestCount
		box(back, px - 1.5, roofTop - 24, 3, 16, P.Gold:Lerp(INK, 0.2), 0, 7)
		circle(back, px, roofTop - 26, 9, 9, P.Gold, 0, 7)
	end
	-- Lucarnes (colonnes extérieures)
	for _, column in ipairs({ 1, cols }) do
		local dx = colX[column] + cellW / 2
		local dw, dh = 84, 96
		local dy = roofTop + 30
		part(back, dx - dw / 2, dy, dw, dh + 20, TRIM, { R = 8, Z = 9, Th = 2.5 })
		trapezoid(back, dx, dy - 38, 8, dw + 26, 42, C.Pink, C.PinkDeep:Lerp(C.Pink, 0.55), 10, 6)
		line(back, dx - 2, dy - 38, dx - dw / 2 - 14, dy + 4, 9, C.PinkDeep, 0, 11)
		line(back, dx + 2, dy - 38, dx + dw / 2 + 14, dy + 4, 9, C.PinkDeep, 0, 11)
		circle(back, dx, dy - 42, 10, 10, P.Gold, 0, 12)
		window(ctx, back, dx - 26, dy + 14, 52, 76, { Arch = true, Z = 12 })
	end
	-- Petits œils-de-bœuf
	for _, column in ipairs({ 2, cols - 1 }) do
		local ox = if column == 2 then colX[column] + 70 else colX[column] + cellW - 70
		window(ctx, back, ox - 20, roofTop + 70, 40, 40, { Round = true, Z = 9, Frame = TRIM })
	end

	-- ░ Fronton central + horloge-cœur ░
	local pedW = 660
	local pedH = 236
	local pedTop = corniceY - pedH + 4
	trapezoid(back, cx, pedTop, 20, pedW, pedH, TRIM, WALL_SHADE, 13, 16)
	trapezoid(back, cx, pedTop + 38, 10, pedW - 120, pedH - 56, WALL, WALL:Lerp(C.Pink, 0.3), 14, 12)
	for _, side in ipairs({ -1, 1 }) do
		line(back, cx + side * 5, pedTop + 38, cx + side * (pedW / 2 - 60), pedTop + pedH - 18, 5, TRIM:Lerp(C.Pink, 0.35), 0, 15)
	end
	for _, side in ipairs({ -1, 1 }) do
		local rake = line(back, cx + side * 6, pedTop + 2, cx + side * (pedW / 2 + 6), corniceY + 2, 18, TRIM, 0, 15)
		stroke(rake, TRIM:Lerp(INK, 0.45), 2.5)
		shade(rake, 0.08)
	end
	heart(back, cx, pedTop - 12, 34, C.Heart, 0, 16)
	-- Horloge : cœur rose, cadran crème, aiguilles qui tournent
	local clockY = pedTop + pedH * 0.62
	heart(back, cx, clockY, 146, C.PinkDeep:Lerp(INK, 0.25), 0, 16)
	heart(back, cx, clockY, 136, C.Pink, 0, 17)
	local face = circle(back, cx, clockY + 3, 82, 82, C.Cream, 0, 18)
	stroke(face, P.Gold, 4)
	lit(ctx, face, LIT_SOFT)
	for index = 0, 3 do
		local a = index * math.pi / 2
		circle(back, cx + math.sin(a) * 31, clockY + 3 - math.cos(a) * 31, 7, 7, C.PinkDeep, 0, 19)
	end
	local hourPivot = group(back, cx, clockY + 3, 0, 0, 20)
	local minutePivot = group(back, cx, clockY + 3, 0, 0, 20)
	round(box(hourPivot, -3, -20, 6, 22, INK, 0, 1))
	round(box(minutePivot, -2, -30, 4, 32, INK, 0, 1))
	circle(back, cx, clockY + 3, 10, 10, P.Gold, 0, 21)
	table.insert(ctx.Anims, function(clock)
		minutePivot.Rotation = (clock * 36) % 360
		hourPivot.Rotation = (clock * 3 + 300) % 360
	end)

	-- ░ Corps du manoir ░
	part(back, bodyX, corniceY + 10, bodyW, groundY - corniceY - 10, WALL, { R = 8, Z = 22, Th = 2.5, Shade = 0.08 })
	cellBacks(back, cells, Color3.fromRGB(236, 210, 232), 23)
	-- Travée centrale : porte d'honneur, fenêtre à balcon, œil-de-bœuf
	local doorW, doorH = 78, 150
	local doorX = bayCx - doorW / 2
	local doorTop = cellBottom - doorH
	window(ctx, back, doorX - 8, doorTop - 8, doorW + 16, doorH + 8, { Arch = true, Z = 26, Frame = TRIM, Cross = "none", Sill = false, Border = 8 })
	for _, side in ipairs({ -1, 1 }) do
		local leaf = part(back, bayCx + (if side < 0 then -doorW / 2 + 2 else 1), doorTop + 40, doorW / 2 - 3, doorH - 40, C.PinkDeep:Lerp(C.Pink, 0.45), { R = 4, Z = 31, Th = 2 })
		part(leaf, 6, 10, doorW / 2 - 15, 40, C.Pink, { R = 4, Z = 2, Th = 1.5, Shade = false })
		part(leaf, 6, 60, doorW / 2 - 15, 40, C.Pink, { R = 4, Z = 2, Th = 1.5, Shade = false })
		circle(back, bayCx + side * 7, doorTop + 96, 7, 7, P.Gold, 0, 32)
	end
	heart(back, bayCx, doorTop + 24, 22, C.Heart, 0, 32)
	if floors >= 2 then
		local wy = floorY[2] + 34
		window(ctx, back, bayCx - 30, wy, 60, 120, { Arch = true, Z = 26, Frame = TRIM })
	end
	if floors >= 3 then
		window(ctx, back, bayCx - 30, floorY[floors] + 50, 60, 60, { Round = true, Z = 26, Frame = TRIM, Border = 7 })
		heart(back, bayCx, floorY[floors] + 136, 24, C.Pink, 0, 26)
	end

	-- ░ Tours rondes (devant les côtés du corps) ░
	local towerTop = roofTop + 100
	local coneH = 240
	for index, side in ipairs({ -1, 1 }) do
		local tx = if side < 0 then bodyX - towerOut else bodyX + bodyW + towerOut - towerW
		local tcx = tx + towerW / 2
		local bodyTop = towerTop
		local tower = part(back, tx, bodyTop, towerW, groundY - bodyTop, TOWER, { R = 14, Z = 40, Th = 2.5, Shade = false })
		-- Volume cylindrique : clair au centre, plus sombre sur les bords
		local g = Instance.new("UIGradient")
		g.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(222, 200, 222)),
			ColorSequenceKeypoint.new(0.4, WHITE),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(214, 190, 216)),
		})
		g.Rotation = 0
		g.Parent = tower
		-- Socle de pierre (même soubassement que le corps)
		part(back, tx - 4, cellBottom - 4, towerW + 8, groundY - cellBottom + 4, P.Stone, { R = 8, Z = 41, Line = P.StoneDark:Lerp(INK, 0.3), Shade = 0.12 })
		-- Bandeaux de pierre aux étages
		for floorIndex = 1, floors do
			local by = floorY[floorIndex] + cellH + S / 2 - 7
			part(back, tx - 6, by, towerW + 12, 14, TRIM, { R = 5, Z = 41, Th = 2 })
		end
		-- Fenêtres cintrées (une par étage) + œil-de-bœuf en haut
		for floorIndex = 1, floors do
			window(ctx, back, tcx - 30, floorY[floorIndex] + 36, 60, 106, { Arch = true, Z = 42, Frame = TRIM, Shine = false })
		end
		window(ctx, back, tcx - 22, bodyTop + 22, 44, 44, { Round = true, Z = 42, Frame = TRIM })
		-- Couronnement : corniche + festons
		part(back, tx - 14, bodyTop - 16, towerW + 28, 22, TRIM, { R = 8, Z = 47, Th = 2.5 })
		scallops(back, tx - 8, tx + towerW + 8, bodyTop + 8, 26, 14, C.Pink, 0, 46)
		-- Toit conique + tuiles + rives + drapeau
		local coneBase = towerW + 44
		trapezoid(back, tcx, bodyTop - 16 - coneH, 6, coneBase, coneH, ROOF, ROOF_DARK, 48, 16)
		tileRows(back, tcx, bodyTop - 16 - coneH, 6, coneBase, coneH, 3, 40, ROOF_DARK, 0.45, 49)
		for _, s2 in ipairs({ -1, 1 }) do
			local rake = line(back, tcx + s2 * 2, bodyTop - 14 - coneH, tcx + s2 * (coneBase / 2 + 2), bodyTop - 12, 12, ROOF_DARK, 0, 50)
			stroke(rake, ROOF_DARK:Lerp(INK, 0.35), 2)
		end
		part(back, tcx - coneBase / 2 - 4, bodyTop - 24, coneBase + 8, 14, ROOF_DARK, { R = -1, Z = 51, Line = ROOF_DARK:Lerp(INK, 0.35) })
		circle(back, tcx, bodyTop - 18 - coneH, 14, 14, P.Gold, 0, 51)
		flag(ctx, back, tcx, bodyTop - 22 - coneH, 62, if index == 1 then C.Pink else C.Lilac, 52, index * 1.7)
	end

	-- ░ Avant : corniche, colonnes, balustrades ░
	part(front, bodyX - 18, corniceY, bodyW + 36, 24, TRIM, { R = 6, Z = 2, Th = 2.5 })
	box(front, bodyX - 10, corniceY + 16, bodyW + 20, 3, P.Gold, 0, 3)
	local modCount = math.floor(bodyW / 90)
	for index = 0, modCount do
		part(front, bodyX + 2 + index * (bodyW - 16) / modCount, corniceY + 24, 12, 13, TRIM, { R = 3, Z = 1, Th = 1.5, Shade = false })
	end
	part(front, bodyX + 6, corniceY + 37, bodyW - 12, 11, WALL_SHADE, { R = 4, Z = 1, Line = false, Shade = false })

	-- Colonnes (murs intérieurs) et pilastres (bords, travée centrale)
	local function column(x: number, w: number, top: number, h: number)
		local shaft = part(front, x + 3, top + 12, w - 6, h - 24, TRIM, { R = 4, Z = 6, Th = 2, Shade = false })
		-- Fût arrondi : plus sombre sur les bords
		local g = Instance.new("UIGradient")
		g.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(236, 222, 236)),
			ColorSequenceKeypoint.new(0.45, WHITE),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(228, 212, 230)),
		})
		g.Parent = shaft
		part(front, x - 2, top, w + 4, 14, TRIM, { R = 4, Z = 7, Th = 2 })
		part(front, x - 2, top + h - 14, w + 4, 14, TRIM, { R = 4, Z = 7, Th = 2 })
	end
	for floorIndex = 1, floors do
		local top = floorY[floorIndex] - 4
		local h = cellH + 8
		column(bodyX + 6, M - 3, top, h)
		column(bodyX + bodyW - M - 3, M - 3, top, h)
		for c = 1, cols - 1 do
			local gx = colX[c] + cellW
			local gw = gaps[c]
			if gw == BAY then
				column(gx - 3, 26, top, h)
				column(gx + gw - 23, 26, top, h)
			else
				column(gx - 3, gw + 6, top, h)
			end
		end
	end
	-- Dalles entre étages : bandeau + balustrade (garde-corps bas)
	for floorIndex = 2, floors do
		local y = floorY[floorIndex] + cellH
		part(front, bodyX - 4, y + S - 16, bodyW + 8, 18, TRIM, { R = 5, Z = 8, Th = 2.5 })
		box(front, bodyX + 4, y + S - 9, bodyW - 8, 3, P.Gold, 0, 9)
		for c = 1, cols do
			local rx = colX[c] - 2
			local rw = cellW + 4
			part(front, rx, y - 14, rw, 8, TRIM, { R = -1, Z = 11, Th = 2 })
			local count = math.floor(rw / 40)
			for index = 1, count - 1 do
				local bx = rx + index * rw / count
				part(front, bx - 4.5, y - 8, 9, S - 6, TRIM, { R = -1, Z = 10, Th = 1.5, Shade = 0.15 })
			end
		end
		-- Petit balcon arrondi de la travée centrale
		part(front, bayCx - BAY / 2 - 6, y - 12, BAY + 12, 10, TRIM, { R = -1, Z = 12, Th = 2 })
	end
	-- Soubassement (bossages) + perron
	part(front, bodyX - 4, cellBottom - 6, bodyW + 8, plinthH + 6, P.Stone, { R = 6, Z = 8, Line = P.StoneDark:Lerp(INK, 0.3) })
	part(front, bodyX - 8, cellBottom - 8, bodyW + 16, 12, TRIM, { R = -1, Z = 9, Th = 2 })
	for row = 0, 1 do
		box(front, bodyX + 4, cellBottom + 22 + row * 26, bodyW - 8, 2, P.StoneDark, 0.2, 9)
	end

	-- ░ Grand escalier double (deux volées qui descendent du perron) ░
	local landW = 196
	local landY = cellBottom
	part(front, bayCx - landW / 2, landY - 4, landW, 18, TRIM, { R = 4, Z = 20, Th = 2.5 })
	box(front, bayCx - landW / 2 + 6, landY + 6, landW - 12, 3, P.Gold, 0, 21)
	local steps = 7
	local run = 34
	local rise = (groundY - landY + 6) / steps
	local flightEnd = landW / 2 + steps * run
	for _, side in ipairs({ -1, 1 }) do
		local startX = bayCx + side * landW / 2
		for step = 1, steps do
			local sy = landY + 12 + (step - 1) * rise
			local w = step * run + 30
			part(front, if side < 0 then startX + 12 - w else startX - 12, sy, w, rise + 5, P.Stone, { R = 4, Z = 18 + step, Line = P.StoneDark:Lerp(INK, 0.3), Shade = 0.22 })
		end
		-- Rampe à balustres
		local x1, y1 = startX, landY - 2
		local x2, y2 = bayCx + side * (flightEnd + 6), groundY + 2
		for k = 1, 5 do
			local t = k / 6
			local bx = x1 + (x2 - x1) * t
			local by = y1 + (y2 - y1) * t
			part(front, bx - 5, by - 28, 10, 26, TRIM, { R = -1, Z = 29, Th = 1.5, Shade = 0.15 })
		end
		local rail = line(front, x1, y1 - 30, x2, y2 - 36, 10, TRIM, 0, 30)
		stroke(rail, TRIM:Lerp(INK, 0.45), 2)
		-- Piliers (haut et bas de la rampe) + lanternes
		part(front, x1 - 11, y1 - 42, 22, 46, TRIM, { R = 5, Z = 31, Th = 2.5 })
		part(front, x2 - 14, y2 - 48, 28, 58, TRIM, { R = 5, Z = 31, Th = 2.5 })
		postLantern(ctx, front, x2, y2 - 46, 16, 32)
		circle(front, x1, y1 - 46, 14, 14, P.Gold, 0, 32)
	end

	-- ░ Jardin : haies, topiaires, parterres, fontaine, grille ░
	local hedgeY = groundY + 8
	for _, side in ipairs({ -1, 1 }) do
		local x1 = if side < 0 then bodyX - towerOut + 14 else bayCx + flightEnd + 40
		local x2 = if side < 0 then bayCx - flightEnd - 40 else bodyX + bodyW + towerOut - 14
		part(front, x1, hedgeY - 38, x2 - x1, 46, P.Leaf, { R = 18, Z = 14, Line = P.LeafDark:Lerp(INK, 0.3), Shade = 0.22 })
		local bumps = math.floor((x2 - x1) / 90)
		for index = 0, bumps - 1 do
			circle(front, x1 + 34 + index * (x2 - x1 - 68) / math.max(1, bumps - 1), hedgeY - 36, 58, 24, P.Leaf, 0, 15)
		end
		for index = 0, 4 do
			local fx = x1 + 30 + index * (x2 - x1 - 60) / 4
			flower(front, fx, hedgeY - 14 + (index % 2) * 10, 13, if index % 2 == 0 then C.Pink else WHITE, 16)
		end
		-- Topiaire à étages (près de la tour)
		local tcx = if side < 0 then bodyX - towerOut / 2 + 10 else bodyX + bodyW + towerOut / 2 - 10
		local tb = groundY + 104
		part(front, tcx - 20, tb - 30, 40, 30, C.Pink, { R = 6, Z = 22, Th = 2 })
		part(front, tcx - 24, tb - 34, 48, 9, C.Pink:Lerp(WHITE, 0.3), { R = 3, Z = 23, Th = 2, Shade = false })
		box(front, tcx - 3, tb - 150, 6, 120, P.Trunk, 0, 17)
		for k = 0, 2 do
			blob(front, tcx, tb - 56 - k * 38, 70 - k * 18, 44 - k * 9, P.Leaf, { Z = 18 + k, Line = P.LeafDark:Lerp(INK, 0.3), Shade = 0.18 })
		end
		heart(front, tcx, tb - 150, 20, C.Heart, 0, 21)
		-- Parterre rond fleuri
		local bx, by = bayCx + side * 360, groundY + 150
		blob(front, bx, by, 190, 58, P.LeafDark:Lerp(P.Leaf, 0.4), { Z = 24, Line = P.LeafDark:Lerp(INK, 0.3), Shade = 0.2 })
		for index = 0, 5 do
			local a = index / 6 * math.pi * 2
			flower(front, bx + math.cos(a) * 62, by + math.sin(a) * 15, 17, ({ C.Pink, C.Butter, WHITE, C.Lilac })[index % 4 + 1], 25)
		end
		flower(front, bx, by - 2, 20, C.Heart, 25)
		-- Petit topiaire boule dans un pot près de l'escalier
		pottedBall(front, bayCx + side * (flightEnd + 70), groundY + 44, 1.2, C.Lilac, 26)
	end
	-- Fontaine à deux vasques (jets d'eau animés)
	local fy = groundY + 138
	blob(front, bayCx, fy, 300, 64, P.Stone, { Z = 34, Line = P.StoneDark:Lerp(INK, 0.3), Shade = 0.25 })
	local water = circle(front, bayCx, fy - 6, 260, 38, P.Water, 0, 35)
	shade(water, 0.2)
	round(box(front, bayCx - 90, fy - 16, 50, 5, WHITE, 0.4, 36))
	part(front, bayCx - 13, fy - 84, 26, 80, TRIM, { R = 5, Z = 36, Th = 2 })
	blob(front, bayCx, fy - 84, 130, 26, TRIM, { Z = 37, Th = 2 })
	circle(front, bayCx, fy - 89, 108, 12, P.Water, 0, 38)
	part(front, bayCx - 7, fy - 126, 14, 40, TRIM, { R = 4, Z = 37, Th = 1.5 })
	blob(front, bayCx, fy - 126, 60, 16, TRIM, { Z = 38, Th = 2 })
	heart(front, bayCx, fy - 140, 22, C.Pink, 0, 39)
	local drops = {}
	for index = 1, 10 do
		local drop = circle(front, bayCx, fy - 100, 7, 9, P.Water:Lerp(WHITE, 0.35), 0.1, 40)
		stroke(drop, P.Water:Lerp(INK, 0.35), 1)
		table.insert(drops, { Frame = drop, Side = if index % 2 == 0 then 1 else -1, Phase = (index - 1) / 10, High = index % 4 < 2 })
	end
	table.insert(ctx.Anims, function(clock)
		for _, drop in ipairs(drops) do
			local t = (clock * 0.6 + drop.Phase) % 1
			local reach = if drop.High then 44 else 90
			local lift = if drop.High then 30 else 16
			local baseY = if drop.High then fy - 128 else fy - 90
			local fall = if drop.High then 38 else 72
			local dx = drop.Side * (10 + t * reach)
			local dy = -math.sin(t * math.pi) * lift + t * t * fall
			drop.Frame.Position = UDim2.fromOffset(bayCx + dx - 3.5, baseY + dy - 4.5)
			drop.Frame.BackgroundTransparency = 0.05 + t * 0.55
		end
	end)
	-- Grille en fer forgé (premier plan) + piliers à lanternes
	local fenceTop = height - 64
	local gateGap = 330
	local iron = INK:Lerp(C.Lilac, 0.25)
	for _, side in ipairs({ -1, 1 }) do
		local x1 = if side < 0 then 24 else bayCx + gateGap / 2 + 18
		local x2 = if side < 0 then bayCx - gateGap / 2 - 18 else width - 24
		part(front, x1, fenceTop + 12, x2 - x1, 5, iron, { R = 2, Z = 40, Line = false, Shade = false })
		part(front, x1, fenceTop + 42, x2 - x1, 5, iron, { R = 2, Z = 40, Line = false, Shade = false })
		local count = math.floor((x2 - x1) / 38)
		for index = 0, count do
			local bx = x1 + index * (x2 - x1) / count
			local bar = box(front, bx - 2, fenceTop - 4, 4, 58, iron, 0, 41)
			round(bar, 2)
			if index % 3 == 1 then
				circle(front, bx, fenceTop + 29, 11, 11, P.Gold, 0, 42)
			end
		end
		-- Pilier du portail + lanterne
		local px = bayCx + side * (gateGap / 2 + 2)
		part(front, px - 18, fenceTop - 24, 36, 84, P.Stone, { R = 5, Z = 43, Line = P.StoneDark:Lerp(INK, 0.3) })
		part(front, px - 22, fenceTop - 30, 44, 11, TRIM, { R = 4, Z = 44, Th = 2 })
		postLantern(ctx, front, px, fenceTop - 30, 12, 45)
		-- Battant ouvert (vu de biais)
		local gx = bayCx + side * (gateGap / 2 - 26)
		local leaf = part(front, gx - 16, fenceTop, 32, 54, WHITE, { R = 8, Z = 42, Line = iron, Th = 3, T = 1, Shade = false })
		box(leaf, 14.5, 4, 3, 46, iron, 0, 1)
		heart(front, gx, fenceTop + 18, 14, P.Gold, 0, 43)
	end

	fireflies(ctx, ctx.Fx, 60, groundY - 30, width - 120, 250, 8, 1)
	return { Width = width, Height = height, Cells = cells, Roof = { CX = cx, Top = roofTop, TopW = roofTopW, BaseW = roofBase, H = roofH, Z = 6, Skip = 330 } }
end

----------------------------------------------------------------------
-- Construction
----------------------------------------------------------------------

local STYLE_BY_SIZE = { Studio = "Cottage", Apartment = "Townhouse", Loft = "Loft", Mansion = "Mansion" }

local function layer(parent: Instance, name: string, z: number): Frame
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.Size = UDim2.fromScale(1, 1)
	frame.ZIndex = z
	frame.Parent = parent
	return frame
end

-- (v9.1) Motif du toit (RoofStyle) posé sur le pan principal du toit :
-- uniquement aux endroits qui sont DANS le trapèze du toit
type RoofRect = { CX: number, Top: number, TopW: number, BaseW: number, H: number, Z: number, Skip: number? }

local function roofHalfWidth(roof: RoofRect, y: number): number
	local k = math.clamp((y - roof.Top) / math.max(1, roof.H), 0, 1)
	return (roof.TopW + (roof.BaseW - roof.TopW) * k) / 2
end

local function insideRoof(roof: RoofRect, x: number, y: number, margin: number): boolean
	if y < roof.Top + margin or y > roof.Top + roof.H - margin then
		return false
	end
	local dx = math.abs(x - roof.CX)
	if roof.Skip and dx < roof.Skip and y > roof.Top + roof.H * 0.3 then
		return false
	end
	return dx <= roofHalfWidth(roof, y) - margin
end

local function roofPattern(ctx: Ctx, roof: RoofRect, pattern: string, roofColor: Color3)
	local parent = ctx.Back
	local z = roof.Z
	local light = roofColor:Lerp(WHITE, 0.55)
	local deep = roofColor:Lerp(INK, 0.3)
	local stepX, stepY = 46, 38
	local function grid(draw: (x: number, y: number, index: number) -> ())
		local row = 0
		local y = roof.Top + stepY * 0.6
		local index = 0
		while y < roof.Top + roof.H - 8 do
			local half = roofHalfWidth(roof, y)
			local x = roof.CX - half + ((row % 2) * stepX / 2) + stepX * 0.4
			while x < roof.CX + half do
				if insideRoof(roof, x, y, 12) then
					index += 1
					draw(x, y, index)
				end
				x += stepX
			end
			y += stepY
			row += 1
		end
	end
	if pattern == "Hearts" then
		grid(function(x, y, index)
			heart(parent, x, y, 18, if index % 3 == 0 then C.Heart else light, 0, z)
		end)
	elseif pattern == "Dots" then
		grid(function(x, y, index)
			circle(parent, x, y, 15, 15, if index % 2 == 0 then WHITE else light, 0.1, z)
		end)
	elseif pattern == "Stars" then
		grid(function(x, y, index)
			sparkle(parent, x, y, if index % 2 == 0 then 22 else 14, if index % 3 == 0 then C.Butter else WHITE, 0, z)
		end)
	elseif pattern == "Flowers" then
		grid(function(x, y, index)
			blob(parent, x + 8, y + 6, 18, 10, P.Leaf, { Z = z, Th = 1.2, Shade = false })
			flower(parent, x, y, 16, if index % 3 == 0 then C.Butter elseif index % 3 == 1 then C.Pink else WHITE, z + 1)
		end)
	elseif pattern == "Stripes" then
		-- bandes verticales : chaque bande commence là où le toit est assez large
		local stripe = 22
		local k = 0
		local x = roof.CX - roof.BaseW / 2 + 12
		while x < roof.CX + roof.BaseW / 2 - 12 do
			if k % 2 == 0 then
				local dx = math.max(math.abs(x - roof.CX), math.abs(x + stripe - roof.CX))
				local widen = math.max(1, roof.BaseW - roof.TopW)
				local enter = roof.Top + roof.H * math.clamp((2 * dx - roof.TopW) / widen, 0, 1)
				local bottom = roof.Top + roof.H - 6
				if bottom - enter > 8 and not (roof.Skip and math.abs(x + stripe / 2 - roof.CX) < roof.Skip) then
					box(parent, x, enter + 4, stripe, bottom - enter - 4, WHITE, 0.25, z)
				end
			end
			x += stripe
			k += 1
		end
	elseif pattern == "Snow" then
		-- neige sur le faîte + congères et gouttes le long du toit
		trapezoid(parent, roof.CX, roof.Top - 4, roof.TopW + 10, roof.TopW + (roof.BaseW - roof.TopW) * 0.22 + 10, roof.H * 0.22, WHITE, Color3.fromRGB(236, 242, 255), z, 8)
		local y = roof.Top + roof.H * 0.22
		local half = roofHalfWidth(roof, y)
		local count = math.floor(half * 2 / 26)
		for index = 0, count do
			local x = roof.CX - half + index * (half * 2) / math.max(1, count)
			circle(parent, x, y, 24, 16 + (index % 3) * 5, WHITE, 0, z)
		end
		local eave = roof.Top + roof.H
		local eaveHalf = roof.BaseW / 2
		for index = 0, math.floor(eaveHalf * 2 / 30) do
			local x = roof.CX - eaveHalf + 10 + index * 30
			local icicle = box(parent, x - 3, eave - 4, 6, 12 + (index % 3) * 6, Color3.fromRGB(226, 240, 255), 0, z + 6)
			round(icicle, 3)
		end
	elseif pattern == "Scales" then
		local tones = { Color3.fromRGB(120, 214, 210), Color3.fromRGB(170, 150, 240), Color3.fromRGB(255, 170, 214) }
		local row = 0
		local y = roof.Top + 16
		while y < roof.Top + roof.H - 6 do
			local half = roofHalfWidth(roof, y)
			local x = roof.CX - half + ((row % 2) * 17) + 16
			while x < roof.CX + half - 12 do
				if insideRoof(roof, x, y, 8) then
					local scale = circle(parent, x, y, 32, 28, tones[row % #tones + 1], 0.15, z)
					circle(scale, 9, 6, 9, 6, WHITE, 0.45, 2)
				end
				x += 34
			end
			y += 18
			row += 1
		end
	elseif pattern == "Checkered" then
		-- (v9.2) damier de course noir et blanc (cases dans le toit seulement)
		local cell = 18
		local row = 0
		local y = roof.Top + 10
		while y < roof.Top + roof.H - cell do
			local half = roofHalfWidth(roof, y)
			local x = roof.CX - half + 10 + (row % 2) * cell
			while x < roof.CX + half - 10 do
				for k = 0, 1 do
					local sx = x + k * cell
					if insideRoof(roof, sx, y, 3) and insideRoof(roof, sx + cell, y, 3) and insideRoof(roof, sx, y + cell, 3) and insideRoof(roof, sx + cell, y + cell, 3) then
						box(parent, sx, y, cell, cell, if k == 0 then Color3.fromRGB(40, 42, 56) else WHITE, if k == 0 then 0.05 else 0.1, z)
					end
				end
				x += cell * 2
			end
			y += cell
			row += 1
		end
	elseif pattern == "Bolts" then
		-- (v9.2) éclairs jaunes en quinconce
		grid(function(x, y, index)
			local s = if index % 2 == 0 then 26 else 20
			local color = if index % 3 == 0 then WHITE else C.Butter
			line(parent, x + s * 0.2, y - s / 2, x - s * 0.2, y + s * 0.02, 5, color, 0, z)
			line(parent, x - s * 0.2, y + s * 0.02, x + s * 0.18, y - s * 0.02, 5, color, 0, z)
			line(parent, x + s * 0.18, y - s * 0.02, x - s * 0.22, y + s / 2, 5, color, 0, z)
		end)
	elseif pattern == "Camo" then
		-- (v9.2) camouflage : taches arrondies en 3 teintes
		local tones = { Color3.fromRGB(96, 120, 76), Color3.fromRGB(60, 76, 50), Color3.fromRGB(150, 160, 110) }
		local row = 0
		local y = roof.Top + 12
		while y < roof.Top + roof.H - 8 do
			local half = roofHalfWidth(roof, y)
			local x = roof.CX - half + 14 + (row % 2) * 16
			local index = 0
			while x < roof.CX + half - 10 do
				if insideRoof(roof, x, y, 12) then
					local n = noise(x, y)
					local spot = circle(parent, x, y, 30 + n * 20, 16 + n * 10, tones[(index + row) % #tones + 1], 0, z)
					spot.Rotation = (n - 0.5) * 90
				end
				x += 30
				index += 1
			end
			y += 16
			row += 1
		end
	elseif pattern == "Flames" then
		-- (v9.2) flammes qui montent depuis le bas du toit (orange + cœur jaune)
		local eave = roof.Top + roof.H
		local half = roof.BaseW / 2
		local count = math.max(3, math.floor(half * 2 / 34))
		for index = 0, count - 1 do
			local cx = roof.CX - half + (index + 0.5) * (half * 2 / count)
			if not (roof.Skip and math.abs(cx - roof.CX) < roof.Skip) then
				local tall = roof.H * (0.38 + 0.3 * noise(index, 3))
				local baseY = eave - 6
				-- la pointe reste dans le toit (plus étroit en haut)
				while tall > 14 and not insideRoof(roof, cx, baseY - tall, 6) do
					tall -= 6
				end
				local tipY = baseY - tall
				if tall > 14 and insideRoof(roof, cx, baseY - 10, 10) then
					circle(parent, cx, baseY - 8, 30, 20, Color3.fromRGB(255, 120, 50), 0, z)
					line(parent, cx - 10, baseY - 10, cx, tipY, 12, Color3.fromRGB(255, 120, 50), 0, z)
					line(parent, cx + 10, baseY - 10, cx + 4, tipY + tall * 0.3, 10, Color3.fromRGB(255, 120, 50), 0, z)
					circle(parent, cx, baseY - 8, 16, 12, C.Butter, 0, z + 1)
					line(parent, cx - 3, baseY - 10, cx, tipY + tall * 0.35, 6, C.Butter, 0, z + 1)
				end
			end
		end
	end
	local _ = deep
end

-- (v9.1) Jardin devant la maison : pelouse + déco choisie (HouseArt,
-- dessins du dossier GardenArt), GardenSlots places fixes
local function gardenStrip(ctx: Ctx, width: number, top: number, garden: { string })
	local front = ctx.Front
	local GARDEN_H = gardenHeight(width)
	local decoSize = GARDEN_H - 6
	local lawn = part(front, 12, top, width - 24, GARDEN_H - 8, P.Grass, { R = 26, Z = 50, Line = P.GrassDark, Shade = 0.14 })
	local _ = lawn
	-- bordure fleurie en haut de la pelouse
	local count = math.floor((width - 60) / 34)
	local colors = { C.Pink, C.Butter, WHITE, C.Lilac, C.Peach }
	for index = 0, count do
		local fx = 30 + index * (width - 60) / math.max(1, count)
		flower(front, fx, top + 10 + (index % 2) * 3, 11, colors[index % #colors + 1], 52)
	end
	local slots = HouseCommon.GardenSlots
	local margin = 70
	local spacing = (width - margin * 2) / math.max(1, slots)
	local byId = ((HouseCommon.LookKinds :: any).Garden or {}).ById or {}
	for index = 1, slots do
		local cx = margin + (index - 0.5) * spacing
		local id = garden[index]
		local entry = id and byId[id]
		if entry then
			local holder = group(front, cx - decoSize / 2, top + GARDEN_H - 4 - decoSize, decoSize, decoSize, 60)
			local body = group(holder, 0, 0, 100, 100, 1)
			body.AnchorPoint = Vector2.new(0.5, 1)
			body.Position = UDim2.fromOffset(decoSize / 2, decoSize)
			local scale = Instance.new("UIScale")
			scale.Scale = decoSize / 100
			scale.Parent = body
			circle(holder, decoSize / 2, decoSize * 0.96, decoSize * 0.76, decoSize * 0.12, BLACK, 0.85, 0)
			local ok, err = pcall(function()
				HouseArt.PaintGarden(body, entry, true)
			end)
			if not ok then
				warn("[HouseExterior] Jardin " .. tostring(id) .. " : " .. tostring(err))
			end
		else
			-- place libre : petite touffe d'herbe
			blob(front, cx, top + GARDEN_H - 30, 26, 12, P.GrassDark, { Z = 53, Line = false, Shade = false, T = 0.3 })
		end
	end
end

type Looks = { Facade: any?, Roof: any?, RoofStyle: any?, Garden: { string }? }

function HouseExterior.Build(parent: Instance, size: SizeDef, looks: Looks?): Exterior
	local root = Instance.new("Frame")
	root.Name = "HouseExterior"
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.Position = UDim2.fromScale(0.5, 0.5)
	-- La façade gère elle-même son mode nuit
	root:SetAttribute("DarkSkinIgnore", true)

	local ctx: Ctx = {
		Back = layer(root, "Back", 1),
		Front = nil :: any,
		Fx = nil :: any,
		Lit = {},
		Glows = {},
		Anims = {},
		NightOnly = {},
		DayOnly = {},
	}
	local cellLayer = layer(root, "Cells", 2)
	ctx.Front = layer(root, "Front", 3)
	ctx.Fx = layer(root, "Fx", 4)

	local styleName = size.Exterior or STYLE_BY_SIZE[size.Id] or "Cottage"
	local painter = STYLES[styleName] or STYLES.Cottage
	local cellW = HouseExterior.CellWidth(size)

	local function clearLayers()
		for _, container in ipairs({ ctx.Back, ctx.Front, ctx.Fx }) do
			for _, child in ipairs(container:GetChildren()) do
				child:Destroy()
			end
		end
		table.clear(ctx.Lit)
		table.clear(ctx.Glows)
		table.clear(ctx.Anims)
		table.clear(ctx.NightOnly)
		table.clear(ctx.DayOnly)
	end

	-- Dessine le bâtiment avec les couleurs choisies (palette remise ensuite)
	local function paint(chosen: Looks?): any
		local wall = chosen and chosen.Facade and chosen.Facade.Color or nil
		local roofColor = chosen and chosen.Roof and chosen.Roof.Color or nil
		local saved = table.clone(P)
		LOOK.Wall = wall
		if roofColor then
			local dark = roofColor:Lerp(INK, 0.28)
			P.RoofPink, P.RoofPinkDark = roofColor, dark
			P.Slate, P.SlateDark = roofColor, dark
		end
		if wall then
			P.Brick = wall:Lerp(BLACK, 0.06)
			P.BrickDark = wall:Lerp(INK, 0.28)
			P.BrickLight = wall:Lerp(WHITE, 0.35)
		end
		local ok, built = pcall(painter, ctx, size, cellW)
		for key, value in pairs(saved) do
			(P :: any)[key] = value
		end
		LOOK.Wall = nil
		if not ok then
			warn("[HouseExterior] " .. tostring(styleName) .. " : " .. tostring(built))
			-- Repli : simple bâtiment arrondi avec la grille
			clearLayers()
			local gap, pad = 16, 30
			local cols, floors = size.Columns, size.Floors
			local w = cols * cellW + (cols - 1) * gap + pad * 2
			local h = floors * HouseExterior.CELL_H + (floors - 1) * gap + pad * 2
			part(ctx.Back, 0, 0, w, h, wall or C.PinkSoft, { R = 18, Th = 3 })
			local gaps = {}
			for index = 1, cols - 1 do
				gaps[index] = gap
			end
			local cells = makeGrid(size, cellW, pad, pad, gaps, gap)
			cellBacks(ctx.Back, cells, P.Interior, 2)
			built = { Width = w, Height = h, Cells = cells }
		end
		-- Motif du toit
		local style = chosen and chosen.RoofStyle
		local roof = (built :: any).Roof
		if roof and style and style.Pattern and style.Pattern ~= "None" then
			local okPattern, err = pcall(roofPattern, ctx, roof, style.Pattern, roofColor or (if styleName == "Cottage" then P.RoofPink else P.Slate))
			if not okPattern then
				warn("[HouseExterior] Motif du toit : " .. tostring(err))
			end
		end
		-- Jardin (toujours là : la taille du bâtiment ne change pas)
		local okGarden, errGarden = pcall(gardenStrip, ctx, built.Width, built.Height - 6, chosen and chosen.Garden or {})
		if not okGarden then
			warn("[HouseExterior] Jardin : " .. tostring(errGarden))
		end
		return built
	end

	local built = paint(looks)
	local fullHeight = built.Height + gardenHeight(built.Width)
	root.Size = UDim2.fromOffset(built.Width, fullHeight)
	root.Parent = parent

	-- Mode nuit : couleurs du jour mémorisées une fois
	type Record = { Object: Instance, Day: Color3 }
	local records: { Record }? = nil
	local function collect(): { Record }
		local list: { Record } = {}
		for _, container in ipairs({ ctx.Back, ctx.Front, ctx.Fx }) do
			for _, d in ipairs(container:GetDescendants()) do
				if d:IsA("Frame") then
					table.insert(list, { Object = d, Day = d.BackgroundColor3 })
				elseif d:IsA("UIStroke") then
					table.insert(list, { Object = d, Day = d.Color })
				end
			end
		end
		return list
	end

	local dark = false
	local clock = 0

	local exterior = {} :: Exterior
	exterior.Frame = root
	exterior.Width = built.Width
	exterior.Height = fullHeight
	exterior.Cells = built.Cells
	exterior.CellLayer = cellLayer

	function exterior.SetDark(value: boolean)
		dark = value == true
		if not records then
			records = collect()
		end
		for _, rec in ipairs(records :: { Record }) do
			local object = rec.Object
			local color = rec.Day
			if dark then
				color = ctx.Lit[object] or color:Lerp(NIGHT_TINT, NIGHT_AMOUNT)
			end
			if object:IsA("UIStroke") then
				object.Color = color
			else
				(object :: Frame).BackgroundColor3 = color
			end
		end
		for _, g in ipairs(ctx.Glows) do
			g.Frame.Visible = dark
			g.Frame.BackgroundTransparency = g.Night
		end
		for _, object in ipairs(ctx.NightOnly) do
			object.Visible = dark
		end
		for _, object in ipairs(ctx.DayOnly) do
			object.Visible = not dark
		end
		for _, anim in ipairs(ctx.Anims) do
			anim(clock, dark)
		end
	end

	-- (v9.1) Nouvelles couleurs / nouveau jardin : on redessine la façade
	-- (mêmes dimensions, les pièces du calque Cells ne bougent pas)
	function exterior.SetLooks(newLooks: Looks?)
		clearLayers()
		paint(newLooks)
		records = nil
		exterior.SetDark(dark)
	end

	function exterior.Update(dt: number)
		clock += dt
		for _, anim in ipairs(ctx.Anims) do
			anim(clock, dark)
		end
	end

	function exterior.Destroy()
		table.clear(ctx.Anims)
		records = nil
		root:Destroy()
	end

	exterior.Update(0)
	return exterior
end

----------------------------------------------------------------------
-- Ciel (facultatif) : remplit `parent`
----------------------------------------------------------------------

local SKY_DAY = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(196, 228, 255)),
	ColorSequenceKeypoint.new(0.6, Color3.fromRGB(255, 226, 240)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 240, 226)),
})
local SKY_NIGHT = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(34, 32, 88)),
	ColorSequenceKeypoint.new(0.65, Color3.fromRGB(86, 64, 150)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 96, 170)),
})

function HouseExterior.BuildBackdrop(parent: Instance, _size: SizeDef?): Backdrop
	local root = Instance.new("Frame")
	root.Name = "HouseBackdrop"
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundColor3 = WHITE
	root.BorderSizePixel = 0
	root.ClipsDescendants = true
	root.ZIndex = 1
	root:SetAttribute("DarkSkinIgnore", true)
	local sky = grad(root, WHITE, WHITE, 90)
	sky.Color = SKY_DAY

	local function scaled(x: number, y: number, w: number, h: number, z: number): Frame
		local frame = Instance.new("Frame")
		frame.BackgroundTransparency = 1
		frame.BorderSizePixel = 0
		frame.AnchorPoint = Vector2.new(0.5, 0.5)
		frame.Position = UDim2.fromScale(x, y)
		frame.Size = UDim2.fromOffset(w, h)
		frame.ZIndex = z
		frame.Parent = root
		return frame
	end

	-- Soleil / lune
	local sun = scaled(0.86, 0.16, 90, 90, 2)
	circle(sun, 45, 45, 90, 90, Color3.fromRGB(255, 240, 180), 0.6, 1)
	circle(sun, 45, 45, 58, 58, Color3.fromRGB(255, 226, 130), 0, 2)
	local moon = scaled(0.86, 0.16, 90, 90, 2)
	circle(moon, 45, 45, 96, 96, Color3.fromRGB(255, 244, 200), 0.86, 1)
	circle(moon, 45, 45, 72, 72, Color3.fromRGB(255, 244, 200), 0.8, 1)
	local disc = circle(moon, 45, 45, 54, 54, Color3.fromRGB(255, 246, 214), 0, 2)
	grad(disc, WHITE, Color3.fromRGB(240, 226, 200), 45)
	circle(moon, 36, 38, 12, 10, Color3.fromRGB(238, 224, 190), 0, 3)
	circle(moon, 54, 54, 9, 8, Color3.fromRGB(238, 224, 190), 0, 3)
	circle(moon, 55, 34, 6, 5, Color3.fromRGB(238, 224, 190), 0, 3)

	-- Collines lointaines
	local hills = {}
	for index, h in ipairs({ { 0.12, 0.34, 0.2 }, { 0.42, 0.5, 0.16 }, { 0.75, 0.42, 0.22 }, { 1.0, 0.3, 0.18 } }) do
		local hill = Instance.new("Frame")
		hill.BorderSizePixel = 0
		hill.AnchorPoint = Vector2.new(0.5, 0)
		hill.Position = UDim2.fromScale(h[1], 1 - h[3])
		hill.Size = UDim2.fromScale(h[2], h[3] * 2)
		hill.BackgroundColor3 = if index % 2 == 0 then Color3.fromRGB(196, 236, 200) else Color3.fromRGB(214, 242, 212)
		hill.ZIndex = 3
		round(hill)
		hill.Parent = root
		table.insert(hills, hill)
	end

	-- Nuages
	type Cloud = { Frame: Frame, X: number, Y: number, Speed: number }
	local clouds: { Cloud } = {}
	for index = 1, 6 do
		local holder = scaled(0, 0, 140, 80, 2)
		local w = 80 + noise(index, 1) * 70
		local base = box(holder, 70 - w / 2, 80 - w * 0.34, w, w * 0.34, WHITE, 0.2, 1)
		round(base)
		circle(holder, 70 - w * 0.14, 80 - w * 0.34, w * 0.5, w * 0.5, WHITE, 0.2, 1)
		circle(holder, 70 + w * 0.2, 80 - w * 0.31, w * 0.36, w * 0.36, WHITE, 0.2, 1)
		table.insert(clouds, { Frame = holder, X = noise(index, 5), Y = 0.1 + noise(index, 4) * 0.5, Speed = 0.005 + noise(index, 3) * 0.008 })
	end

	-- Étoiles / étincelles
	type Star = { Parts: { Instance }, Phase: number }
	local stars: { Star } = {}
	for index = 1, 22 do
		local s = 6 + noise(index, 7) * 8
		local holder = scaled(0.03 + noise(index, 8) * 0.94, 0.03 + noise(index, 9) * 0.62, s, s, 2)
		local shape = sparkle(holder, s / 2, s / 2, s, WHITE, 0.2, 1)
		table.insert(stars, { Parts = shape:GetChildren(), Phase = noise(index, 10) * 6 })
	end

	local dark = false
	local clock = 0
	local backdrop = {} :: Backdrop
	backdrop.Frame = root

	local function paintAll(frame: Instance, color: Color3)
		for _, d in ipairs(frame:GetDescendants()) do
			if d:IsA("Frame") and d.BackgroundTransparency < 1 then
				d.BackgroundColor3 = color
			end
		end
	end

	function backdrop.SetDark(value: boolean)
		dark = value == true
		sky.Color = if dark then SKY_NIGHT else SKY_DAY
		sun.Visible = not dark
		moon.Visible = dark
		for index, hill in ipairs(hills) do
			local day = if index % 2 == 0 then Color3.fromRGB(196, 236, 200) else Color3.fromRGB(214, 242, 212)
			hill.BackgroundColor3 = if dark then day:Lerp(NIGHT_TINT, 0.55) else day
		end
		for _, cloud in ipairs(clouds) do
			paintAll(cloud.Frame, if dark then Color3.fromRGB(120, 110, 180) else WHITE)
		end
		for _, star in ipairs(stars) do
			for _, child in ipairs(star.Parts) do
				(child :: Frame).BackgroundColor3 = if dark then Color3.fromRGB(255, 244, 190) else WHITE
			end
		end
	end

	function backdrop.Update(dt: number)
		clock += dt
		for _, cloud in ipairs(clouds) do
			cloud.X = (cloud.X + cloud.Speed * dt) % 1.3
			cloud.Frame.Position = UDim2.fromScale(cloud.X - 0.15, cloud.Y)
		end
		for _, star in ipairs(stars) do
			local wave = 0.5 + 0.5 * math.sin(clock * 2 + star.Phase)
			local base = if dark then 0.05 else 0.5
			for _, child in ipairs(star.Parts) do
				(child :: Frame).BackgroundTransparency = base + wave * 0.45
			end
		end
	end

	function backdrop.Destroy()
		root:Destroy()
	end

	root.Parent = parent
	backdrop.SetDark(false)
	backdrop.Update(0)
	return backdrop
end

return HouseExterior
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">HouseLookCards</string>
              <string name="Source"><![CDATA[--[[
	HouseLookCards (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > HouseLookCards

	(v9.1) Aperçus dessinés des cartes de personnalisation de la boutique
	(uniquement des Frames, taille fixe W x H de maquette) :
	  Trim      : coin de pièce (papier peint de la pièce, plafond, moulure,
	              plinthe et fenêtre dans la couleur des boiseries)
	  Mood      : petite pièce (mur, sol, lampe, canapé) sous l'ambiance
	              (voile + effet figé, HouseMoods.Static)
	  View      : grande fenêtre avec la vue (HouseViews)
	  Facade    : petite maison, murs de la couleur choisie
	  Roof      : petite maison, toit de la couleur choisie
	  RoofStyle : petite maison avec le motif du toit
	  Garden    : la déco du jardin (HouseArt.PaintGarden) sur un carré de gazon
	L'appelant coupe ce qui déborde (CanvasGroup arrondi).

	API :
	  HouseLookCards.Paint(frame, kind, entry, w, h, context?)
	      context = { Wallpaper = Style?, Floor = Style?, Facade = Color3?, Roof = Color3? }
	      (styles actuels de la pièce / de la maison, pour des aperçus fidèles)
]]

local HousePatterns = require(script.Parent.HousePatterns)
local HouseViews = require(script.Parent.HouseViews)
local HouseMoods = require(script.Parent.HouseMoods)
local HouseArt = require(script.Parent.HouseArt)
local HouseCommon = require(script.Parent.HouseCommon)

local HouseLookCards = {}

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local C = HouseCommon.Colors
local Box = HousePatterns.Box
local Circle = HousePatterns.Circle
local Heart = HousePatterns.Heart
local Sparkle = HousePatterns.Sparkle
local Round = HousePatterns.Round

type Context = { Wallpaper: any?, Floor: any?, Facade: Color3?, Roof: Color3? }

local DEFAULT_WALL = { Pattern = "Stripes", A = Color3.fromRGB(255, 214, 229), B = Color3.fromRGB(255, 186, 211) }
local DEFAULT_FLOOR = { Pattern = "Checker", A = Color3.fromRGB(188, 132, 192), B = Color3.fromRGB(152, 100, 162) }
local HOUSE_WALL = Color3.fromRGB(255, 232, 242)
local HOUSE_ROOF = Color3.fromRGB(190, 170, 240)

local function stroke(frame: GuiObject, color: Color3, thickness: number)
	local line = Instance.new("UIStroke")
	line.Color = color
	line.Thickness = thickness
	line.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	line.Parent = frame
end

-- Mur + sol de la pièce (motifs réduits)
local function roomBack(frame: Frame, w: number, h: number, context: Context?, wallRatio: number)
	local wallH = math.floor(h * wallRatio)
	local wall = Box(frame, 0, 0, w, wallH, WHITE, 0, 1)
	wall.ClipsDescendants = true
	HousePatterns.BuildWall(wall, w, wallH, (context and context.Wallpaper) or DEFAULT_WALL, 0.55)
	local floor = Box(frame, 0, wallH, w, h - wallH, WHITE, 0, 1)
	floor.ClipsDescendants = true
	HousePatterns.BuildFloor(floor, w, h - wallH, (context and context.Floor) or DEFAULT_FLOOR, 0.55)
	return wallH
end

-- Petite maison vue de face : murs, toit (trapèze en tranches), porte, fenêtres
local function miniHouse(frame: Frame, w: number, h: number, wall: Color3, roof: Color3, pattern: string?)
	-- ciel + herbe
	local sky = Box(frame, 0, 0, w, h, WHITE, 0, 1)
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 90
	gradient.Color = ColorSequence.new(Color3.fromRGB(196, 228, 255), Color3.fromRGB(255, 236, 244))
	gradient.Parent = sky
	Box(frame, 0, h - 12, w, 12, Color3.fromRGB(150, 222, 150), 0, 2)
	local cx = w / 2
	local bodyW, bodyH = math.min(w * 0.56, 120), h * 0.42
	local bodyTop = h - 12 - bodyH
	local body = Box(frame, cx - bodyW / 2, bodyTop, bodyW, bodyH + 1, wall, 0, 3)
	stroke(body, wall:Lerp(C.Ink, 0.45), 1.5)
	-- fenêtres + porte
	for _, side in ipairs({ -1, 1 }) do
		local win = Box(frame, cx + side * bodyW * 0.28 - 8, bodyTop + bodyH * 0.2, 16, 14, Color3.fromRGB(200, 232, 255), 0, 4)
		Round(win, UDim.new(0, 4))
		stroke(win, WHITE, 2)
	end
	local door = Box(frame, cx - 8, bodyTop + bodyH - 22, 16, 22, C.Pink, 0, 4)
	Round(door, UDim.new(0, 6))
	-- toit
	local roofH = h * 0.36
	local roofTop = bodyTop - roofH + 2
	local baseW = bodyW + 26
	local topW = 10
	local slices = 12
	for index = 1, slices do
		local k = (index - 0.5) / slices
		local sw = topW + (baseW - topW) * k
		Box(frame, cx - sw / 2, roofTop + (index - 1) * roofH / slices, sw, roofH / slices + 0.7, roof:Lerp(roof:Lerp(C.Ink, 0.25), k), 0, 5)
	end
	local eave = Box(frame, cx - baseW / 2 - 3, roofTop + roofH - 4, baseW + 6, 6, roof:Lerp(C.Ink, 0.3), 0, 6)
	Round(eave, UDim.new(0, 3))
	Heart(frame, cx, roofTop - 4, 10, C.Heart, 0, 7)
	-- motif du toit
	local function inside(x: number, y: number): boolean
		local k = (y - roofTop) / roofH
		return k > 0.15 and k < 0.9 and math.abs(x - cx) < (topW + (baseW - topW) * k) / 2 - 5
	end
	local spots = {}
	for row = 0, 3 do
		local y = roofTop + roofH * (0.3 + row * 0.18)
		for col = -4, 4 do
			local x = cx + col * 13 + (row % 2) * 6
			if inside(x, y) then
				table.insert(spots, Vector2.new(x, y))
			end
		end
	end
	if pattern == "Hearts" then
		for index, p in ipairs(spots) do
			Heart(frame, p.X, p.Y, 8, index % 3 == 0 and C.Heart or roof:Lerp(WHITE, 0.6), 0, 6)
		end
	elseif pattern == "Dots" then
		for _, p in ipairs(spots) do
			Circle(frame, p.X, p.Y, 7, 7, WHITE, 0.1, 6)
		end
	elseif pattern == "Stars" then
		for index, p in ipairs(spots) do
			Sparkle(frame, p.X, p.Y, index % 2 == 0 and 10 or 7, index % 3 == 0 and C.Butter or WHITE, 0, 6)
		end
	elseif pattern == "Flowers" then
		for index, p in ipairs(spots) do
			Circle(frame, p.X, p.Y, 8, 8, index % 3 == 0 and C.Butter or (index % 3 == 1 and C.Pink or WHITE), 0, 6)
			Circle(frame, p.X, p.Y, 3, 3, C.Butter, 0, 7)
		end
	elseif pattern == "Stripes" then
		for col = -4, 4 do
			if col % 2 == 0 then
				local x = cx + col * 8
				local k0 = math.clamp((2 * math.abs(x - cx) + 8 - topW) / (baseW - topW), 0.1, 1)
				local y0 = roofTop + roofH * k0
				if roofTop + roofH - 4 - y0 > 3 then
					Box(frame, x - 4, y0, 8, roofTop + roofH - 4 - y0, WHITE, 0.25, 6)
				end
			end
		end
	elseif pattern == "Snow" then
		for index = 0, 4 do
			Circle(frame, cx - 18 + index * 9, roofTop + roofH * 0.2, 14, 9, WHITE, 0, 6)
		end
		for index = 0, 6 do
			local icicle = Box(frame, cx - baseW / 2 + 6 + index * (baseW - 12) / 6, roofTop + roofH, 3, 6 + (index % 2) * 3, Color3.fromRGB(226, 240, 255), 0, 7)
			Round(icicle, UDim.new(0, 2))
		end
	elseif pattern == "Scales" then
		local tones = { Color3.fromRGB(120, 214, 210), Color3.fromRGB(170, 150, 240), Color3.fromRGB(255, 170, 214) }
		for index, p in ipairs(spots) do
			Circle(frame, p.X, p.Y, 13, 11, tones[index % #tones + 1], 0.1, 6)
		end
	elseif pattern == "Checkered" then
		-- (v9.2) damier de course
		for row = 0, 4 do
			local y = roofTop + roofH * (0.2 + row * 0.14)
			for col = -6, 6 do
				local x = cx + col * 7
				if (row + col) % 2 == 0 and inside(x, y + 3) and inside(x + 7, y + 3) then
					Box(frame, x, y, 7, roofH * 0.14, Color3.fromRGB(40, 42, 56), 0, 6)
				end
			end
		end
	elseif pattern == "Bolts" then
		-- (v9.2) éclairs (zigzags jaunes)
		for index, p in ipairs(spots) do
			if index % 2 == 1 then
				local color = index % 3 == 0 and WHITE or C.Butter
				local a = Box(frame, p.X - 1, p.Y - 7, 3, 8, color, 0, 6)
				a.Rotation = 25
				local b = Box(frame, p.X - 1, p.Y - 1, 3, 8, color, 0, 6)
				b.Rotation = 25
				Box(frame, p.X - 3, p.Y - 1, 6, 2, color, 0, 6)
			end
		end
	elseif pattern == "Camo" then
		-- (v9.2) taches de camouflage
		local tones = { Color3.fromRGB(96, 120, 76), Color3.fromRGB(60, 76, 50), Color3.fromRGB(150, 160, 110) }
		for index, p in ipairs(spots) do
			local spot = Circle(frame, p.X, p.Y, 14, 8, tones[index % #tones + 1], 0, 6)
			spot.Rotation = (index * 37) % 60 - 30
		end
	elseif pattern == "Flames" then
		-- (v9.2) flammes qui montent du bas du toit
		for index = -3, 3 do
			local x = cx + index * 12
			local tall = roofH * (0.55 + (index % 2) * 0.2)
			while tall > 10 and not inside(x, roofTop + roofH - tall) do
				tall -= 3
			end
			if tall > 10 and inside(x, roofTop + roofH - 8) then
				Circle(frame, x, roofTop + roofH - 8, 12, 9, Color3.fromRGB(255, 120, 50), 0, 6)
				local tip = Box(frame, x - 4, roofTop + roofH - tall, 8, tall - 4, Color3.fromRGB(255, 120, 50), 0, 7)
				Round(tip, UDim.new(1, 0))
				Circle(frame, x, roofTop + roofH - 8, 6, 5, C.Butter, 0, 8)
			end
		end
	end
end

-- Coin de pièce avec les boiseries dans la couleur choisie
local function trimPreview(frame: Frame, w: number, h: number, entry: any, context: Context?)
	local trim = entry.Color or C.Cream
	local edge = trim:Lerp(C.Ink, 0.4)
	local wallH = roomBack(frame, w, h, context, 0.72)
	-- plafond (coque) + moulure festonnée dans la couleur des boiseries
	local ceiling = Box(frame, 0, 0, w, 14, trim, 0, 3)
	stroke(ceiling, edge, 1.2)
	Box(frame, 0, 14, w, 6, trim:Lerp(WHITE, 0.25), 0, 3)
	for index = 0, math.floor(w / 14) do
		Circle(frame, 7 + index * 14, 20, 12, 9, trim, 0, 2)
	end
	-- plinthe épaisse
	local base = Box(frame, 0, wallH - 12, w, 12, trim, 0, 3)
	stroke(base, edge, 1)
	Box(frame, 0, wallH - 12, w, 3, WHITE, 0.35, 4)
	-- fenêtre (cadre épais, croisillon, rebord)
	local winX, winY, winW, winH = w * 0.3 - 26, 24, 52, 28
	local outer = Box(frame, winX, winY, winW, winH, trim, 0, 3)
	Round(outer, UDim.new(0, 7))
	stroke(outer, edge, 1.2)
	local glass = Box(frame, winX + 5, winY + 5, winW - 10, winH - 10, WHITE, 0, 4)
	glass.ClipsDescendants = true
	Round(glass, UDim.new(0, 4))
	HouseViews.Paint(glass, winW - 10, winH - 10, HouseCommon.Look("View", nil) :: any, false)
	Box(frame, winX + winW / 2 - 2, winY + 5, 4, winH - 10, trim, 0, 5)
	local sill = Box(frame, winX - 5, winY + winH - 3, winW + 10, 7, trim, 0, 6)
	Round(sill, UDim.new(0, 3))
	stroke(sill, edge, 1)
	-- encadrement de porte
	local doorX = w * 0.58
	local door = Box(frame, doorX, 26, 34, wallH - 38, trim, 0, 3)
	Round(door, UDim.new(0, 12))
	stroke(door, edge, 1.2)
	local inner = Box(frame, doorX + 6, 32, 22, wallH - 44, C.Pink:Lerp(WHITE, 0.3), 0, 4)
	Round(inner, UDim.new(0, 8))
	Circle(frame, doorX + 24, 26 + (wallH - 38) * 0.6, 4, 4, Color3.fromRGB(245, 190, 60), 0, 5)
end

-- Petite pièce meublée sous l'ambiance choisie
local function moodPreview(frame: Frame, w: number, h: number, entry: any, context: Context?)
	local wallH = roomBack(frame, w, h, context, 0.56)
	-- canapé
	local sofaY = wallH + (h - wallH) * 0.2
	local back = Box(frame, w * 0.12, sofaY - 16, 58, 22, C.Pink, 0, 3)
	Round(back, UDim.new(0, 8))
	local seat = Box(frame, w * 0.12 - 4, sofaY, 66, 16, C.Pink:Lerp(WHITE, 0.2), 0, 4)
	Round(seat, UDim.new(0, 6))
	-- lampe (halo)
	local lx = w * 0.78
	Box(frame, lx - 1.5, wallH - 26, 3, h * 0.46, C.WoodDark, 0, 3)
	local shade = Box(frame, lx - 12, wallH - 40, 24, 16, C.Butter, 0, 4)
	Round(shade, UDim.new(0, 5))
	local light = entry.Light or C.Butter
	for index, size in ipairs({ 70, 48, 30 }) do
		Circle(frame, lx, wallH - 30, size, size, light, 0.8 - index * 0.08, 2)
	end
	HouseMoods.Static(frame, w, h, entry, 6)
end

-- Grande fenêtre avec la vue
local function viewPreview(frame: Frame, w: number, h: number, entry: any, context: Context?)
	roomBack(frame, w, h, context, 1)
	local winW, winH = math.min(w - 30, 150), h - 14
	local winX, winY = (w - winW) / 2, 6
	local outer = Box(frame, winX, winY, winW, winH, C.Cream, 0, 3)
	Round(outer, UDim.new(0, 10))
	stroke(outer, C.WoodDark, 1.5)
	local glass = Box(frame, winX + 5, winY + 5, winW - 10, winH - 10, WHITE, 0, 4)
	glass.ClipsDescendants = true
	Round(glass, UDim.new(0, 7))
	HouseViews.Paint(glass, winW - 10, winH - 10, entry, false)
	Box(frame, winX + winW / 2 - 2, winY + 5, 4, winH - 10, C.Cream, 0, 5)
	-- rideaux
	for _, side in ipairs({ -1, 1 }) do
		local x = side < 0 and winX - 8 or winX + winW - 10
		local curtain = Box(frame, x, winY - 2, 18, winH + 4, C.Pink, 0, 6)
		Round(curtain, UDim.new(0, 7))
	end
end

-- Déco du jardin sur un carré de gazon
local function gardenPreview(frame: Frame, w: number, h: number, entry: any)
	local sky = Box(frame, 0, 0, w, h, WHITE, 0, 1)
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 90
	gradient.Color = ColorSequence.new(Color3.fromRGB(206, 234, 255), Color3.fromRGB(255, 240, 248))
	gradient.Parent = sky
	local lawn = Box(frame, -10, h * 0.62, w + 20, h * 0.6, Color3.fromRGB(150, 222, 150), 0, 2)
	Round(lawn, UDim.new(0.5, 0))
	local size = h * 0.96
	local body = Box(frame, 0, 0, 100, 100, WHITE, 1, 3)
	body.AnchorPoint = Vector2.new(0.5, 1)
	body.Position = UDim2.fromOffset(w / 2, h - 2)
	local scale = Instance.new("UIScale")
	scale.Scale = size / 100
	scale.Parent = body
	Circle(frame, w / 2, h - 5, size * 0.7, 8, BLACK, 0.85, 2)
	HouseArt.PaintGarden(body, entry, true)
end

function HouseLookCards.Paint(frame: Frame, kind: string, entry: any, w: number, h: number, context: Context?)
	local ok, err = pcall(function()
		if kind == "Trim" then
			trimPreview(frame, w, h, entry, context)
		elseif kind == "Mood" then
			moodPreview(frame, w, h, entry, context)
		elseif kind == "View" then
			viewPreview(frame, w, h, entry, context)
		elseif kind == "Facade" then
			-- (Color nil = couleurs d'origine : l'aperçu les montre, pas la couleur actuelle)
			miniHouse(frame, w, h, entry.Color or HOUSE_WALL, (context and context.Roof) or HOUSE_ROOF, nil)
		elseif kind == "Roof" then
			miniHouse(frame, w, h, (context and context.Facade) or HOUSE_WALL, entry.Color or HOUSE_ROOF, nil)
		elseif kind == "RoofStyle" then
			miniHouse(frame, w, h, (context and context.Facade) or HOUSE_WALL, (context and context.Roof) or HOUSE_ROOF, entry.Pattern)
		elseif kind == "Garden" then
			gardenPreview(frame, w, h, entry)
		end
	end)
	if not ok then
		warn("[HouseLookCards] " .. tostring(kind) .. " " .. tostring(entry and entry.Id) .. " : " .. tostring(err))
	end
end

return HouseLookCards
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">HouseMiniRoom</string>
              <string name="Source"><![CDATA[--[[
	HouseMiniRoom (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > HouseMiniRoom

	Petite pièce "maison de poupée" dessinée dans une case de l'immeuble
	(vue d'ensemble de la maison) :
	  - papier peint et sol de la pièce (HousePatterns, motif réduit),
	    murs de côté en perspective, plinthe, ombre du plafond ;
	  - les objets de la pièce en petit (dessins statiques de HouseArt),
	    placés d'après leurs X / Y / S : au plus MAX_ITEMS objets (les plus
	    gros d'abord, mais les animaux et ce qui est posé sur les meubles
	    gardés en priorité) pour garder peu de Frames ; même ordre
	    d'affichage que la pièce (HouseSurfaces.Order) ;
	  - la nuit : voile bleu nuit + lumière chaude de plafonnier (la pièce
	    a l'air allumée), halo des lampes.
	Reconstruction partielle : le fond n'est redessiné que si le papier
	peint / le sol / la taille changent, les objets seulement si la
	disposition change.

	API :
	  HouseMiniRoom.new(parent, width, height) -> Mini
	    mini.Frame
	    mini.Set(room, size, placed?)     (placed = disposition en cours)
	    mini.SetDark(dark)
	    mini.Destroy()
]]

local Client = script.Parent.Parent.Parent
local UIUtil = require(Client.UIUtil)
local HouseCommon = require(script.Parent.HouseCommon)
local HousePatterns = require(script.Parent.HousePatterns)
local HouseArt = require(script.Parent.HouseArt)
local HouseTints = require(script.Parent.HouseTints)
local HouseMoods = require(script.Parent.HouseMoods)
local HouseSurfaces = require(script.Parent.HouseSurfaces)
local HousePets = require(script.Parent.HousePets)

type Room = HouseCommon.Room
type SizeDef = HouseCommon.SizeDef
type Placed = HouseCommon.Placed

local HouseMiniRoom = {}

HouseMiniRoom.MAX_ITEMS = 12
local ROOM_BASE_WIDTH = 760 -- (= HouseRoom.BASE_WIDTH, sans dépendre du module)
local ROOM_HEIGHT = 440
local PATTERN_UNIT = 0.8 -- motifs un peu plus fins que dans la pièce

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local C = HouseCommon.Colors
local Box = HousePatterns.Box
local Circle = HousePatterns.Circle

export type Mini = {
	Frame: Frame,
	Set: (room: Room, size: SizeDef, placed: { Placed }?) -> (),
	SetDark: (dark: boolean) -> (),
	Destroy: () -> (),
}

local function placedSignature(list: { Placed }): string
	local parts = table.create(#list)
	for index, entry in ipairs(list) do
		parts[index] = string.format("%s:%.3f:%.3f:%.2f:%d%s%s", entry.I, entry.X, entry.Y, entry.S, math.floor(entry.Z), entry.F and "F" or "", entry.C or "")
	end
	return table.concat(parts, ";")
end

function HouseMiniRoom.new(parent: Instance, width: number, height: number): Mini
	local wallHeight = math.floor(height * HouseCommon.Config.WallRatio + 0.5)
	local dark = false
	local styleKey = ""
	local itemsKey = ""
	local lamps: { Frame } = {}

	local frame = UIUtil.Create("Frame", {
		Name = "MiniRoom",
		Size = UDim2.fromOffset(width, height),
		BackgroundColor3 = C.PinkSoft,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 1,
	})
	frame:SetAttribute("DarkSkinIgnore", true)
	local wall = UIUtil.Create("Frame", {
		Name = "Wall",
		Size = UDim2.fromOffset(width, wallHeight),
		BackgroundColor3 = C.PinkSoft,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 1,
		Parent = frame,
	})
	local floor = UIUtil.Create("Frame", {
		Name = "Floor",
		Position = UDim2.fromOffset(0, wallHeight),
		Size = UDim2.fromOffset(width, height - wallHeight),
		BackgroundColor3 = C.Lilac,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 1,
		Parent = frame,
	})
	local decor = UIUtil.Create("Frame", {
		Name = "Decor",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = frame,
	})
	local items = UIUtil.Create("Frame", {
		Name = "Items",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = frame,
	})
	-- (v9.1) ambiance lumineuse de la pièce (voile + effet figé)
	local moodLayer = UIUtil.Create("Frame", {
		Name = "Mood",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 4,
		Parent = frame,
	})
	local night = UIUtil.Create("Frame", {
		Name = "Night",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(34, 26, 92),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 4,
		Parent = frame,
	})
	-- Lumière chaude du plafonnier (la nuit)
	local lampGlow = UIUtil.Create("Frame", {
		Name = "Lamp",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 5,
		Parent = frame,
	})
	for index, ring in ipairs({ { 1.4, 0.93 }, { 0.8, 0.88 } }) do
		local size = height * ring[1]
		local glow = Circle(lampGlow, width / 2, height * 0.12, size * 1.6, size, Color3.fromRGB(255, 214, 140), ring[2], index)
		glow.Name = "Glow" .. index
	end
	local bulb = Circle(lampGlow, width / 2, 4, 14, 10, Color3.fromRGB(255, 236, 170), 0, 4)
	bulb.Name = "Bulb"
	frame.Parent = parent

	local function paintNight()
		night.BackgroundTransparency = dark and 0.72 or 1
		lampGlow.Visible = dark
		for _, lamp in ipairs(lamps) do
			lamp.BackgroundTransparency = dark and 0.72 or 0.9
		end
	end

	-- Fond : papier peint, sol, murs de côté, plinthe, ombres
	local function buildBackground(room: Room)
		local wallpaper = HouseCommon.GetRoomWallpaper(room)
		local floorStyle = HouseCommon.GetRoomFloor(room)
		HousePatterns.BuildWall(wall, width, wallHeight, wallpaper, PATTERN_UNIT)
		HousePatterns.BuildFloor(floor, width, height - wallHeight, floorStyle, PATTERN_UNIT)
		for _, child in ipairs(decor:GetChildren()) do
			child:Destroy()
		end
		local wallA = wallpaper and wallpaper.A or C.PinkSoft
		local wallB = wallpaper and wallpaper.B or C.Pink
		local floorB = floorStyle and floorStyle.B or C.Lilac
		local side = math.floor(width * 0.06)
		local floorHeight = height - wallHeight
		local slices = 6
		for _, info in ipairs({ { X = 0, Dir = 1, Tone = 0.14 }, { X = width - side, Dir = -1, Tone = 0.06 } }) do
			local color = wallA:Lerp(wallB, 0.35):Lerp(BLACK, info.Tone)
			Box(decor, info.X, 0, side, wallHeight, color, 0, 1)
			for index = 0, slices - 1 do
				local sliceW = side * (1 - index / slices)
				local x = info.Dir > 0 and 0 or width - sliceW
				Box(decor, x, wallHeight + index * floorHeight / slices, sliceW, floorHeight / slices + 0.6, color, 0, 1)
			end
			local edgeX = info.Dir > 0 and side - 1 or width - side - 1
			Box(decor, edgeX, 0, 1.5, wallHeight, wallB:Lerp(BLACK, 0.35), 0.5, 2)
		end
		-- Plinthe, ombre au pied du mur, ombre du plafond, avant plus sombre
		local trim = HouseCommon.Look("Trim", room.Trim)
		local trimColor = (trim and trim.Color) or C.Cream
		Box(decor, side, wallHeight - 5, width - side * 2, 5, trimColor, 0, 2)
		Box(decor, 0, 0, width, 4, trimColor, 0, 3) -- moulure du plafond
		HouseMoods.Static(moodLayer, width, height, HouseCommon.Look("Mood", room.Mood) :: any, 1)
		local ao = Box(decor, 0, wallHeight, width, 12, BLACK, 0.75, 1)
		UIUtil.Create("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(0, 1), Parent = ao })
		local ceiling = Box(decor, 0, 0, width, 14, BLACK, 0.7, 2)
		UIUtil.Create("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(0, 1), Parent = ceiling })
		local front = Box(decor, 0, height - 18, width, 18, BLACK, 0.8, 2)
		UIUtil.Create("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0.3), Parent = front })
		Box(decor, 0, height - 2, width, 2, floorB:Lerp(BLACK, 0.4), 0.4, 2)
	end

	-- Objets : les MAX_ITEMS plus gros, dessinés en statique
	local function buildItems(room: Room, size: SizeDef, placed: { Placed })
		for _, child in ipairs(items:GetChildren()) do
			child:Destroy()
		end
		table.clear(lamps)
		local roomWidth = ROOM_BASE_WIDTH * (tonumber(size.Width) or 1)
		local k = math.min(width / roomWidth, height / ROOM_HEIGHT)
		local chosen = {}
		for _, entry in ipairs(placed) do
			local item = HouseCommon.ItemsById[entry.I]
			if item then
				-- (les animaux se voient même petits : ils comptent plus)
				local area = item.Size * entry.S * (HousePets.Has(item.Id) and 2.2 or 1)
				table.insert(chosen, { Entry = entry, Item = item, Area = area })
			end
		end
		table.sort(chosen, function(a, b)
			return a.Area > b.Area
		end)
		while #chosen > HouseMiniRoom.MAX_ITEMS do
			table.remove(chosen)
		end
		-- Un objet posé sur un meuble absent de la mini-pièce flotterait : on l'enlève
		local kept: { Placed } = {}
		for _, pick in ipairs(chosen) do
			table.insert(kept, pick.Entry)
		end
		local roomHeight = ROOM_HEIGHT
		for index = #chosen, 1, -1 do
			local support = HouseSurfaces.SupportOf(chosen[index].Entry, placed, roomWidth, roomHeight)
			if support and not table.find(kept, support.Entry) then
				table.remove(chosen, index)
			end
		end
		local drawn = {}
		for _, pick in ipairs(chosen) do
			local item, entry = pick.Item, pick.Entry
			local isWall = item.Placement == "Wall"
			local holder = UIUtil.Create("Frame", {
				Name = item.Id,
				Size = UDim2.fromOffset(100, 100),
				AnchorPoint = isWall and Vector2.new(0.5, 0.5) or Vector2.new(0.5, 1),
				Position = UDim2.fromScale(entry.X, entry.Y),
				BackgroundTransparency = 1,
			})
			UIUtil.Create("UIScale", { Scale = item.Size * entry.S / 100 * k, Parent = holder })
			local body = UIUtil.Create("Frame", {
				Name = "Body",
				Size = UDim2.fromOffset(100, 100),
				BackgroundTransparency = 1,
				ZIndex = 2,
				Parent = holder,
			})
			local result = HouseArt.Paint(body, item, true)
			if result ~= nil and entry.C then
				HouseTints.Apply(body, entry.C) -- (v9.1) couleur choisie
			end
			if entry.F == true and result ~= nil then
				-- (objet retourné : chaise tournée vers la table...)
				HouseArt.Mirror(body, {}, 50)
			end
			local flat = result ~= nil and result.Flat == true
			if result == nil or result.ShowEmoji == true then
				UIUtil.Create("TextLabel", {
					Name = "Emoji",
					Size = UDim2.fromScale(1, 1),
					BackgroundTransparency = 1,
					Font = Enum.Font.BuilderSansMedium,
					Text = item.Icon,
					TextColor3 = WHITE,
					TextSize = 80,
					ZIndex = 3,
					Parent = body,
				})
			end
			if not isWall and not flat then
				Circle(holder, 50, 97, 90, 14, BLACK, 0.86, 1)
			end
			local glowColor = result and result.Glow or (item.Category == "Lights" and C.Butter or nil)
			if glowColor then
				local glow = Circle(holder, 50, 50, 150, 150, glowColor, 0.9, 1)
				table.insert(lamps, glow)
			end
			local rank = isWall and 0 or (flat and 1 or 2)
			drawn[entry] = { Holder = holder, Rank = rank }
		end
		local list: { Placed } = {}
		for entry in pairs(drawn) do
			table.insert(list, entry)
		end
		local ordered = HouseSurfaces.Order(list, roomWidth, roomHeight, function(entry: Placed): number
			local info = drawn[entry]
			return info and info.Rank or 2
		end)
		for index, entry in ipairs(ordered) do
			local info = drawn[entry]
			info.Holder.ZIndex = index
			info.Holder.Parent = items
		end
	end

	local mini: Mini
	mini = {
		Frame = frame,
		Set = function(room: Room, size: SizeDef, placed: { Placed }?)
			local list = placed or room.Placed
			local newStyleKey = string.format("%s|%s|%d|%s|%s", room.Wallpaper, room.Floor, width, tostring(room.Trim), tostring(room.Mood))
			if newStyleKey ~= styleKey then
				styleKey = newStyleKey
				buildBackground(room)
			end
			local newItemsKey = tostring(size.Width) .. "#" .. placedSignature(list)
			if newItemsKey ~= itemsKey then
				itemsKey = newItemsKey
				buildItems(room, size, list)
				paintNight()
			end
		end,
		SetDark = function(value: boolean)
			if dark == value then
				return
			end
			dark = value
			paintNight()
		end,
		Destroy = function()
			frame:Destroy()
		end,
	}
	paintNight()
	return mini
end

return HouseMiniRoom
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">HouseMoods</string>
              <string name="Source"><![CDATA[--[[
	HouseMoods (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > HouseMoods

	(v9.1) Ambiance lumineuse d'une pièce (Config.House.Moods, room.Mood) :
	un voile coloré en dégradé (Tint -> Tint2, force Amount) posé sur la
	pièce + un petit effet animé (Effect) :
	  Rays     : rayons de lumière douce qui respirent
	  Sparkles : étincelles qui scintillent
	  Hearts   : petits cœurs qui montent
	  Leaves   : feuilles qui tombent en tourbillonnant
	  Bubbles  : bulles qui montent en ondulant
	  Disco    : taches de couleur qui tournent
	  Aurora   : voiles d'aurore boréale qui ondulent
	  Rainbow  : reflet arc-en-ciel qui balaie la pièce
	  (v9.2) Neon : tubes néon qui grésillent ; Floodlights : projecteurs de
	  stade + flashs ; RGB : LED gamer qui changent de couleur ; Storm :
	  pluie + éclairs ; Embers : braises qui montent
	Peu de Frames (≤ 14 particules), animation à 30 Hz au plus, rien
	n'est créé pendant l'animation.

	API :
	  HouseMoods.new(parent, z) -> Mood
	    mood.Frame
	    mood.Set(entry?, width, height)   (nil / Amount 0 et Effect None = rien)
	    mood.Update(dt)
	    mood.Destroy()
	  HouseMoods.Static(container, width, height, entry, z?) : aperçu fixe
	    (boutique, petites pièces de la vue d'ensemble)
]]

local HousePatterns = require(script.Parent.HousePatterns)

local HouseMoods = {}

local WHITE = Color3.new(1, 1, 1)
local Box = HousePatterns.Box
local Circle = HousePatterns.Circle
local Heart = HousePatterns.Heart
local Sparkle = HousePatterns.Sparkle
local Round = HousePatterns.Round

type Entry = { Tint: Color3?, Tint2: Color3?, Amount: number?, Effect: string?, Id: string? }

type Particle = { Frame: GuiObject, X: number, Y: number, Speed: number, Phase: number, Size: number }

export type Mood = {
	Frame: Frame,
	Set: (entry: Entry?, width: number, height: number) -> (),
	Update: (dt: number) -> (),
	Destroy: () -> (),
}

local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 120, 150)),
	ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 190, 100)),
	ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 236, 120)),
	ColorSequenceKeypoint.new(0.6, Color3.fromRGB(140, 226, 150)),
	ColorSequenceKeypoint.new(0.8, Color3.fromRGB(130, 190, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 150, 255)),
})
local DISCO = {
	Color3.fromRGB(255, 90, 180),
	Color3.fromRGB(90, 200, 255),
	Color3.fromRGB(255, 226, 90),
	Color3.fromRGB(150, 255, 150),
	Color3.fromRGB(200, 120, 255),
	Color3.fromRGB(255, 150, 90),
}

local function noise(a: number, b: number): number
	local value = math.sin(a * 12.9898 + b * 78.233) * 43758.5453
	return value - math.floor(value)
end

-- Voile en dégradé (Tint en haut, Tint2 en bas)
local function veil(parent: Instance, width: number, height: number, entry: Entry, z: number): Frame
	local amount = math.clamp(tonumber(entry.Amount) or 0, 0, 0.9)
	local frame = Box(parent, 0, 0, width, height, WHITE, 1 - amount, z)
	frame.Name = "Veil"
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 90
	gradient.Color = ColorSequence.new(entry.Tint or WHITE, entry.Tint2 or entry.Tint or WHITE)
	gradient.Parent = frame
	return frame
end

-- Particules / formes de l'effet (positions relatives 0..1)
local function buildEffect(parent: Frame, width: number, height: number, entry: Entry, animated: boolean): ({ Particle }, { GuiObject })
	local particles: { Particle } = {}
	local extras: { GuiObject } = {}
	local effect = entry.Effect or "None"
	local tint = entry.Tint2 or entry.Tint or WHITE
	local function add(frame: GuiObject, x: number, y: number, speed: number, phase: number, size: number)
		table.insert(particles, { Frame = frame, X = x, Y = y, Speed = speed, Phase = phase, Size = size })
	end
	if effect == "Rays" then
		for index = 0, 2 do
			local ray = Box(parent, 0, 0, width * 0.16, height * 1.5, entry.Tint or WHITE, 0.8, 2)
			ray.AnchorPoint = Vector2.new(0.5, 0)
			ray.Position = UDim2.fromOffset(width * (0.12 + index * 0.16), -height * 0.2)
			ray.Rotation = -28
			local fade = Instance.new("UIGradient")
			fade.Rotation = 90
			fade.Transparency = NumberSequence.new(0.1, 1)
			fade.Parent = ray
			table.insert(extras, ray)
		end
	elseif effect == "Sparkles" then
		for index = 1, 12 do
			local size = 10 + noise(index, 1) * 14
			local holder = Box(parent, 0, 0, size, size, WHITE, 1, 3)
			Sparkle(holder, size / 2, size / 2, size, index % 3 == 0 and tint or WHITE, 0.1, 1)
			local scale = Instance.new("UIScale")
			scale.Parent = holder
			add(holder, noise(index, 2), noise(3, index) * 0.9, 0, noise(index, 4) * 6, size)
		end
	elseif effect == "Hearts" then
		for index = 1, 9 do
			local size = 12 + noise(index, 1) * 10
			local holder = Box(parent, 0, 0, size, size, WHITE, 1, 3)
			Heart(holder, size / 2, size / 2, size, index % 2 == 0 and Color3.fromRGB(255, 150, 200) or WHITE, 0.2, 1)
			add(holder, noise(index, 2), noise(3, index), 0.05 + noise(index, 5) * 0.05, noise(index, 4) * 6, size)
		end
	elseif effect == "Leaves" then
		for index = 1, 9 do
			local size = 12 + noise(index, 1) * 8
			local leaf = Circle(parent, 0, 0, size, size * 0.55, index % 3 == 0 and Color3.fromRGB(255, 214, 120) or Color3.fromRGB(130, 206, 120), 0.1, 3)
			add(leaf, noise(index, 2), noise(3, index), 0.05 + noise(index, 5) * 0.04, noise(index, 4) * 6, size)
		end
	elseif effect == "Bubbles" then
		for index = 1, 12 do
			local size = 8 + noise(index, 1) * 16
			local bubble = Circle(parent, 0, 0, size, size, WHITE, 0.75, 3)
			local ring = Instance.new("UIStroke")
			ring.Color = WHITE
			ring.Transparency = 0.25
			ring.Thickness = 1.5
			ring.Parent = bubble
			Circle(bubble, size * 0.3, size * 0.3, size * 0.25, size * 0.2, WHITE, 0.2, 2)
			add(bubble, noise(index, 2), noise(3, index), 0.06 + noise(index, 5) * 0.06, noise(index, 4) * 6, size)
		end
	elseif effect == "Disco" then
		for index = 1, 7 do
			local size = width * (0.12 + noise(index, 1) * 0.08)
			local spot = Circle(parent, 0, 0, size, size * 0.8, DISCO[(index - 1) % #DISCO + 1], 0.62, 3)
			add(spot, noise(index, 2), 0.2 + noise(3, index) * 0.7, 0.3 + noise(index, 5) * 0.3, noise(index, 4) * 6, size)
		end
	elseif effect == "Aurora" then
		for index = 0, 2 do
			local band = Box(parent, 0, 0, width * 1.3, height * 0.22, index == 1 and Color3.fromRGB(190, 120, 255) or Color3.fromRGB(90, 240, 180), 0.55, 2)
			band.AnchorPoint = Vector2.new(0.5, 0.5)
			Round(band)
			local fade = Instance.new("UIGradient")
			fade.Rotation = 90
			fade.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.5, 0.2),
				NumberSequenceKeypoint.new(1, 1),
			})
			fade.Parent = band
			add(band, 0.5, 0.12 + index * 0.12, 0.4 + index * 0.15, index * 1.7, 0)
		end
	elseif effect == "Rainbow" then
		local band = Box(parent, 0, 0, width * 0.7, height * 1.6, WHITE, 0.72, 2)
		band.AnchorPoint = Vector2.new(0.5, 0.5)
		band.Rotation = 24
		local gradient = Instance.new("UIGradient")
		gradient.Color = RAINBOW
		gradient.Parent = band
		add(band, 0.5, 0.5, 0.06, 0, 0)
	elseif effect == "Neon" then
		-- (v9.2) deux tubes néon sous le plafond (cyan / magenta) + leur lueur
		for index = 0, 1 do
			local color = index == 0 and Color3.fromRGB(80, 230, 255) or Color3.fromRGB(255, 90, 200)
			local glow = Box(parent, width * (0.08 + index * 0.5), height * 0.03, width * 0.38, height * 0.14, color, 0.7, 2)
			Round(glow)
			local tube = Box(glow, width * 0.02, height * 0.055, width * 0.34, math.max(3, height * 0.018), WHITE, 0, 2)
			Round(tube)
			table.insert(extras, glow)
		end
	elseif effect == "Floodlights" then
		-- (v9.2) projecteurs de stade : faisceaux depuis les coins + flashs
		for index, spec in ipairs({ { 0.02, -34 }, { 0.98, 34 }, { 0.3, -12 }, { 0.7, 12 } }) do
			local beam = Box(parent, 0, 0, width * 0.2, height * 1.4, WHITE, 0.72, 2)
			beam.AnchorPoint = Vector2.new(0.5, 0)
			beam.Position = UDim2.fromOffset(width * spec[1], -height * 0.05)
			beam.Rotation = spec[2]
			local fade = Instance.new("UIGradient")
			fade.Rotation = 90
			fade.Transparency = NumberSequence.new(0, 1)
			fade.Parent = beam
			beam:SetAttribute("BaseRotation", spec[2])
			table.insert(extras, beam)
			Circle(parent, width * spec[1], height * 0.02, 26, 26, WHITE, 0.1, 3)
			local _ = index
		end
		for index = 1, 8 do
			local size = 8 + noise(index, 1) * 10
			local holder = Box(parent, 0, 0, size, size, WHITE, 1, 3)
			Sparkle(holder, size / 2, size / 2, size, WHITE, 0.05, 1)
			local scale = Instance.new("UIScale")
			scale.Parent = holder
			add(holder, noise(index, 2), 0.15 + noise(3, index) * 0.3, 0, noise(index, 4) * 6, size)
		end
	elseif effect == "RGB" then
		-- (v9.2) bandes LED arc-en-ciel en haut et en bas + petites LED
		for index = 0, 1 do
			local band = Box(parent, 0, index == 0 and 0 or height - height * 0.06, width, height * 0.06, WHITE, 0.2, 2)
			local fade = Instance.new("UIGradient")
			fade.Rotation = 90
			fade.Transparency = index == 0 and NumberSequence.new(0.1, 1) or NumberSequence.new(1, 0.1)
			fade.Parent = band
			table.insert(extras, band)
		end
		for index = 1, 10 do
			local led = Circle(parent, 0, 0, 7, 7, WHITE, 0.1, 3)
			add(led, (index - 0.5) / 10, 0.035, 0, index * 0.1, 7)
		end
	elseif effect == "Storm" then
		-- (v9.2) pluie oblique + éclair (flash blanc)
		for index = 1, 14 do
			local drop = Box(parent, 0, 0, 2, 14 + noise(index, 1) * 10, Color3.fromRGB(200, 220, 255), 0.35, 3)
			drop.Rotation = 14
			Round(drop)
			add(drop, noise(index, 2), noise(3, index), 0.7 + noise(index, 5) * 0.5, 0, 0)
		end
		local flash = Box(parent, 0, 0, width, height, WHITE, 1, 4)
		table.insert(extras, flash)
	elseif effect == "Embers" then
		-- (v9.2) braises qui montent + lueur orange au sol
		local glow = Box(parent, 0, height * 0.6, width, height * 0.4, Color3.fromRGB(255, 120, 40), 0.5, 2)
		local fade = Instance.new("UIGradient")
		fade.Rotation = 90
		fade.Transparency = NumberSequence.new(1, 0.3)
		fade.Parent = glow
		table.insert(extras, glow)
		for index = 1, 12 do
			local size = 4 + noise(index, 1) * 6
			local ember = Circle(parent, 0, 0, size, size, index % 3 == 0 and Color3.fromRGB(255, 220, 90) or Color3.fromRGB(255, 130, 50), 0.1, 3)
			add(ember, noise(index, 2), noise(3, index), 0.08 + noise(index, 5) * 0.08, noise(index, 4) * 6, size)
		end
	end
	-- Position de départ (aperçu fixe : la seule position)
	for _, particle in ipairs(particles) do
		particle.Frame.Position = UDim2.fromOffset(particle.X * width, particle.Y * height)
		if particle.Frame.AnchorPoint == Vector2.zero then
			particle.Frame.AnchorPoint = Vector2.new(0.5, 0.5)
		end
	end
	local _ = animated
	return particles, extras
end

function HouseMoods.new(parent: Instance, z: number): Mood
	local frame = Instance.new("Frame")
	frame.Name = "Mood"
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.Size = UDim2.fromScale(1, 1)
	frame.ClipsDescendants = true
	frame.ZIndex = z
	frame.Parent = parent

	local particles: { Particle } = {}
	local extras: { GuiObject } = {}
	local effect = "None"
	local key = ""
	local width, height = 100, 100
	local clock = 0
	local pending = 0

	local mood = {} :: Mood
	mood.Frame = frame

	function mood.Set(entry: Entry?, newWidth: number, newHeight: number)
		local e: Entry = entry or {}
		local newKey = string.format("%s|%d|%d", tostring(e.Id), newWidth, newHeight)
		if newKey == key then
			return
		end
		key = newKey
		width, height = newWidth, newHeight
		for _, child in ipairs(frame:GetChildren()) do
			child:Destroy()
		end
		table.clear(particles)
		table.clear(extras)
		effect = e.Effect or "None"
		local active = (tonumber(e.Amount) or 0) > 0 or effect ~= "None"
		frame.Visible = active
		if not active then
			return
		end
		veil(frame, width, height, e, 1)
		particles, extras = buildEffect(frame, width, height, e, true)
		mood.Update(0)
	end

	function mood.Update(dt: number)
		clock += dt
		pending += dt
		if dt > 0 and pending < 1 / 30 then
			return
		end
		pending = 0
		if not frame.Visible or #particles + #extras == 0 then
			return
		end
		local t = clock
		if effect == "Rays" then
			for index, ray in ipairs(extras) do
				(ray :: Frame).BackgroundTransparency = 0.78 + 0.1 * math.sin(t * 0.8 + index * 1.3)
			end
		elseif effect == "Sparkles" then
			for _, p in ipairs(particles) do
				local wave = 0.5 + 0.5 * math.sin(t * 2.2 + p.Phase)
				local scale = p.Frame:FindFirstChildOfClass("UIScale")
				if scale then
					scale.Scale = 0.4 + wave * 0.8
				end
			end
		elseif effect == "Hearts" or effect == "Bubbles" then
			for _, p in ipairs(particles) do
				local y = (p.Y - t * p.Speed) % 1.1
				local x = p.X + math.sin(t * 1.3 + p.Phase) * 0.02
				p.Frame.Position = UDim2.fromOffset(x * width, (y - 0.05) * height)
			end
		elseif effect == "Leaves" then
			for _, p in ipairs(particles) do
				local y = (p.Y + t * p.Speed) % 1.1
				local x = p.X + math.sin(t * 1.1 + p.Phase) * 0.04
				p.Frame.Position = UDim2.fromOffset(x * width, (y - 0.05) * height)
				p.Frame.Rotation = math.sin(t * 2 + p.Phase) * 50
			end
		elseif effect == "Disco" then
			for index, p in ipairs(particles) do
				local a = t * p.Speed + p.Phase
				p.Frame.Position = UDim2.fromOffset((0.5 + math.cos(a) * 0.38 * (0.6 + p.X * 0.4)) * width, (p.Y + math.sin(a * 1.3) * 0.12) * height)
				local color = DISCO[(index + math.floor(t * 1.5)) % #DISCO + 1];
				(p.Frame :: Frame).BackgroundColor3 = color
			end
		elseif effect == "Aurora" then
			for _, p in ipairs(particles) do
				p.Frame.Position = UDim2.fromOffset((0.5 + math.sin(t * 0.3 + p.Phase) * 0.12) * width, (p.Y + math.sin(t * p.Speed + p.Phase) * 0.04) * height)
				p.Frame.Rotation = math.sin(t * 0.4 + p.Phase) * 6
			end
		elseif effect == "Rainbow" then
			for _, p in ipairs(particles) do
				local x = ((t * p.Speed) % 1.6) - 0.3
				p.Frame.Position = UDim2.fromOffset(x * width, 0.5 * height)
			end
		elseif effect == "Neon" then
			-- (v9.2) les néons respirent et grésillent de temps en temps
			for index, glow in ipairs(extras) do
				local buzz = ((t * 0.7 + index * 0.37) % 5) < 0.12 and 0.25 or 0;
				(glow :: Frame).BackgroundTransparency = 0.66 + 0.1 * math.sin(t * 2 + index) + buzz
			end
		elseif effect == "Floodlights" then
			for _, beam in ipairs(extras) do
				local base = tonumber(beam:GetAttribute("BaseRotation")) or 0
				beam.Rotation = base + math.sin(t * 0.5 + base) * 4
			end
			for _, p in ipairs(particles) do
				-- flashs d'appareils photo : brefs et décalés
				local cycle = (t * 0.6 + p.Phase) % 3
				local scale = p.Frame:FindFirstChildOfClass("UIScale")
				if scale then
					scale.Scale = cycle < 0.25 and (1 - cycle * 4) * 1.2 or 0
				end
			end
		elseif effect == "RGB" then
			for index, band in ipairs(extras) do
				(band :: Frame).BackgroundColor3 = Color3.fromHSV((t * 0.12 + index * 0.5) % 1, 0.75, 1)
			end
			for _, p in ipairs(particles) do
				(p.Frame :: Frame).BackgroundColor3 = Color3.fromHSV((t * 0.2 + p.X) % 1, 0.7, 1)
				p.Frame.Position = UDim2.fromOffset(p.X * width, p.Y * height)
			end
		elseif effect == "Storm" then
			for _, p in ipairs(particles) do
				local y = (p.Y + t * p.Speed) % 1.1
				local x = (p.X - y * 0.25) % 1.05
				p.Frame.Position = UDim2.fromOffset(x * width, (y - 0.05) * height)
			end
			local flash = extras[1]
			if flash then
				-- un double éclair toutes les ~6 s
				local cycle = t % 6.3
				local amount = (cycle < 0.08 or (cycle > 0.2 and cycle < 0.3)) and 0.45 or 1;
				(flash :: Frame).BackgroundTransparency = amount
			end
		elseif effect == "Embers" then
			for _, p in ipairs(particles) do
				local y = (p.Y - t * p.Speed) % 1.1
				local x = p.X + math.sin(t * 1.7 + p.Phase) * 0.025
				p.Frame.Position = UDim2.fromOffset(x * width, (y - 0.05) * height);
				(p.Frame :: Frame).BackgroundTransparency = 0.1 + (1 - y / 1.1) * 0.6
			end
			local glow = extras[1]
			if glow then
				(glow :: Frame).BackgroundTransparency = 0.5 + 0.12 * math.sin(t * 1.3)
			end
		end
	end

	function mood.Destroy()
		table.clear(particles)
		table.clear(extras)
		frame:Destroy()
	end

	return mood
end

-- Aperçu fixe (boutique, mini-pièces) : voile + effet figé
function HouseMoods.Static(container: Instance, width: number, height: number, entry: Entry?, z: number?)
	local old = container:FindFirstChild("MoodStatic")
	if old then
		old:Destroy()
	end
	if not entry or ((tonumber(entry.Amount) or 0) <= 0 and (entry.Effect or "None") == "None") then
		return
	end
	local frame = Instance.new("Frame")
	frame.Name = "MoodStatic"
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.Size = UDim2.fromScale(1, 1)
	frame.ClipsDescendants = true
	frame.ZIndex = z or 1
	veil(frame, width, height, entry, 1)
	buildEffect(frame, width, height, entry, false)
	frame.Parent = container
end

return HouseMoods
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">HouseOverview</string>
              <string name="Source"><![CDATA[--[[
	HouseOverview (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > HouseOverview

	Vue d'ensemble de la maison ("🏠 Ma maison" s'ouvre ici) :
	  - ciel (jour / nuit) avec nuages qui passent, soleil ou lune, étoiles,
	    collines ; l'immeuble (House/HouseExterior, dessiné en coupe comme
	    une maison de poupée) centré et mis à l'échelle ;
	  - dans chaque case : la pièce en petit (House/HouseMiniRoom) + une
	    pastille "🛏️ Chambre ❤️ 24 ✨2" ; survol = contour lumineux, clic =
	    zoom fluide vers la pièce (OnOpenRoom) ;
	  - cases vides : "➕ Nouvelle pièce" en pointillés avec le prix
	    (OnEmptySlot -> choix du type de pièce) ;
	  - MODE RANGEMENT : on glisse une pièce (souris ou doigt) sur une autre
	    case (échange) ou une case vide ; case visée en surbrillance,
	    animations ; toucher une pièce = menu "⋯" (OnRoomMenu).
	HouseExterior est écrit en parallèle : chargé avec pcall, sinon un
	immeuble simple (façade arrondie + grille de cases) le remplace.

	API :
	  HouseOverview.new(parent, handlers) -> Overview
	    .Frame, .SetHouse(house, overrides?), .SetDark(dark),
	    .SetArranging(on), .IsArranging(), .Update(dt), .Refit(),
	    .ZoomIn(roomId, done), .ZoomOut(roomId?), .Pulse(roomId),
	    .CancelMoves(), .CellScreenCenter(slot) -> Vector2?,
	    .BeginDrag(roomId, screenPos), .DragTo(screenPos), .EndDrag(),
	    .IsDragging()
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TextService = game:GetService("TextService")

local Client = script.Parent.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local Interface = require(Client.Interface)
local SoundManager = require(Client.SoundManager)
local Locale = require(ReplicatedStorage.Shared.Locale)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local HouseCommon = require(script.Parent.HouseCommon)
local HousePatterns = require(script.Parent.HousePatterns)
local HouseMiniRoom = require(script.Parent.HouseMiniRoom)

type HouseData = HouseCommon.HouseData
type Room = HouseCommon.Room
type SizeDef = HouseCommon.SizeDef
type Placed = HouseCommon.Placed
type Mini = HouseMiniRoom.Mini

local HouseOverview = {}

local CELL_H = 190
local DRAG_THRESHOLD = 8 -- (px écran)
local DRAG_SMOOTHING = 26
local ZOOM_TIME = 0.38

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local C = HouseCommon.Colors
local Box = HousePatterns.Box
local Circle = HousePatterns.Circle
local Round = HousePatterns.Round

local SKY_DAY = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(176, 220, 255)),
	ColorSequenceKeypoint.new(0.55, Color3.fromRGB(226, 232, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 226, 238)),
})
local SKY_NIGHT = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(26, 24, 74)),
	ColorSequenceKeypoint.new(0.6, Color3.fromRGB(70, 52, 132)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(140, 88, 160)),
})

export type Handlers = {
	OnOpenRoom: (roomId: string) -> (),
	OnEmptySlot: (slot: number) -> (),
	OnMoveRoom: (roomId: string, slot: number) -> (),
	OnRoomMenu: (roomId: string) -> (),
}

export type Overview = {
	Frame: Frame,
	SetHouse: (house: HouseData, overrides: HouseCommon.Overrides?, preview: { [string]: string }?) -> (),
	SetDark: (dark: boolean) -> (),
	SetArranging: (on: boolean) -> (),
	IsArranging: () -> boolean,
	Update: (dt: number) -> (),
	Refit: () -> (),
	ZoomIn: (roomId: string, done: () -> ()) -> (),
	ZoomOut: (roomId: string?) -> (),
	Pulse: (roomId: string) -> (),
	CancelMoves: () -> (),
	CellScreenCenter: (slot: number) -> Vector2?,
	BeginDrag: (roomId: string, screenPos: Vector2) -> (),
	DragTo: (screenPos: Vector2) -> (),
	EndDrag: () -> (),
	IsDragging: () -> boolean,
}

type Rect = { X: number, Y: number, W: number, H: number }

type Exterior = {
	Frame: Frame,
	Width: number,
	Height: number,
	Cells: { [number]: Rect },
	CellLayer: Frame,
	SetDark: (dark: boolean) -> (),
	Update: (dt: number) -> (),
	Destroy: () -> (),
}

type Card = {
	RoomId: string,
	Frame: Frame,
	Scale: UIScale,
	Mini: Mini,
	Hover: Frame,
	HoverStroke: UIStroke,
	Chip: Frame,
	ChipLabel: TextLabel,
	ChipScale: UIScale,
	Menu: TextButton,
	MenuScale: UIScale,
	Shadow: Frame,
	Hit: TextButton,
	Slot: number,
	Hovered: boolean,
	ChipKey: string,
}

type EmptySlot = {
	Slot: number,
	Frame: Frame,
	Content: Frame,
	ContentScale: UIScale,
	Price: TextLabel,
	Plus: Frame,
	Hit: TextButton,
}

type Drag = {
	Card: Card,
	FromSlot: number,
	Offset: Vector2, -- (px de maquette) coin de la carte - pointeur
	Target: Vector2, -- coin visé de la carte
	Current: Vector2,
	Over: number?,
}

type Pending = { RoomId: string, Input: InputObject, Start: Vector2 }

----------------------------------------------------------------------
-- Immeuble de secours (si HouseExterior n'est pas disponible)
----------------------------------------------------------------------

local function buildFallback(parent: Instance, size: SizeDef): Exterior
	local cellW = math.floor(300 * (tonumber(size.Width) or 1))
	local wallT, slab, inner = 22, 20, 14
	local roofH, groundH, margin = 120, 46, 40
	local floors, columns = size.Floors, size.Columns
	local bodyW = columns * cellW + (columns - 1) * inner + wallT * 2
	local bodyH = floors * CELL_H + (floors - 1) * slab + wallT + 26
	local width = bodyW + margin * 2
	local height = roofH + bodyH + groundH

	local frame = UIUtil.Create("Frame", {
		Name = "Exterior",
		Size = UDim2.fromOffset(width, height),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = 1,
	})
	local back = UIUtil.Create("Frame", {
		Name = "Back",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 1,
		Parent = frame,
	})
	local cellLayer = UIUtil.Create("Frame", {
		Name = "CellLayer",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = frame,
	})
	local front = UIUtil.Create("Frame", {
		Name = "Front",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = frame,
	})
	local facadeColor = Color3.fromRGB(255, 236, 244)
	local trim = Color3.fromRGB(236, 150, 190)
	-- Pelouse
	local lawn = Box(back, 0, height - groundH - 6, width, groundH, Color3.fromRGB(150, 222, 150), 0, 1)
	Round(lawn, UDim.new(0, 24))
	UIUtil.Stroke(lawn, Color3.fromRGB(108, 190, 118), 2, 0.2)
	-- Façade
	local facade = Box(back, margin, roofH, bodyW, bodyH, facadeColor, 0, 2)
	Round(facade, UDim.new(0, 18))
	UIUtil.Stroke(facade, trim, 3, 0.1)
	-- Toit (trapèze en tranches) + faîtage
	local slices = 18
	for index = 0, slices - 1 do
		local k = (index + 1) / slices
		local rowW = bodyW * 0.45 + (bodyW + 50 - bodyW * 0.45) * k
		Box(back, width / 2 - rowW / 2, 14 + index * (roofH - 14) / slices, rowW, (roofH - 14) / slices + 0.8,
			Color3.fromRGB(255, 150, 190):Lerp(Color3.fromRGB(226, 104, 156), k * 0.3), 0, 3)
	end
	local ridge = Box(back, width / 2 - bodyW * 0.24, 8, bodyW * 0.48, 12, Color3.fromRGB(226, 104, 156), 0, 4)
	Round(ridge)
	HousePatterns.Heart(back, width / 2, 4, 26, C.Heart, 0, 5)
	local cells: { [number]: Rect } = {}
	for floorIndex = 1, floors do
		for column = 1, columns do
			local slot = (floorIndex - 1) * columns + column
			local x = margin + wallT + (column - 1) * (cellW + inner)
			local y = roofH + wallT + (floors - floorIndex) * (CELL_H + slab)
			cells[slot] = { X = x, Y = y, W = cellW, H = CELL_H }
			-- Fond de case (sous la pièce)
			local hole = Box(back, x - 3, y - 3, cellW + 6, CELL_H + 6, trim:Lerp(BLACK, 0.2), 0.3, 3)
			Round(hole, UDim.new(0, 8))
		end
		-- Dalle de plancher (devant)
		local y = roofH + wallT + (floors - floorIndex) * (CELL_H + slab) + CELL_H
		local slabFrame = Box(front, margin + 8, y, bodyW - 16, 12, C.Cream, 0, 1)
		Round(slabFrame, UDim.new(0, 5))
		UIUtil.Stroke(slabFrame, trim, 1.5, 0.3)
	end
	frame.Parent = parent
	local night = { lawn, facade }
	return {
		Frame = frame,
		Width = width,
		Height = height,
		Cells = cells,
		CellLayer = cellLayer,
		SetDark = function(dark: boolean)
			for _, part in ipairs(night) do
				local day = part:GetAttribute("DayColor")
				if typeof(day) ~= "Color3" then
					day = part.BackgroundColor3
					part:SetAttribute("DayColor", day)
				end
				part.BackgroundColor3 = dark and (day :: Color3):Lerp(Color3.fromRGB(40, 36, 100), 0.4) or day :: Color3
			end
		end,
		Update = function(_dt: number) end,
		Destroy = function()
			frame:Destroy()
		end,
	}
end

-- Immeuble de HouseExterior (Contrat A), sinon celui de secours
local function buildExterior(parent: Instance, size: SizeDef, looks: any): Exterior
	local folder = script.Parent
	local moduleScript = folder:FindFirstChild("HouseExterior")
	if moduleScript and moduleScript:IsA("ModuleScript") then
		local ok, result = pcall(function()
			local module = (require :: any)(moduleScript)
			local built = module.Build(parent, size, looks)
			assert(type(built) == "table" and typeof(built.Frame) == "Instance" and type(built.Cells) == "table", "bad exterior")
			assert(typeof(built.CellLayer) == "Instance", "no cell layer")
			for slot = 1, size.MaxRooms do
				assert(type(built.Cells[slot]) == "table", "missing cell " .. slot)
			end
			return built
		end)
		if ok then
			local built = result :: any
			built.Width = tonumber(built.Width) or built.Frame.Size.X.Offset
			built.Height = tonumber(built.Height) or built.Frame.Size.Y.Offset
			if type(built.SetDark) ~= "function" then
				built.SetDark = function() end
			end
			if type(built.Update) ~= "function" then
				built.Update = function() end
			end
			if type(built.Destroy) ~= "function" then
				built.Destroy = function()
					built.Frame:Destroy()
				end
			end
			return built :: Exterior
		end
		warn("[HouseOverview] HouseExterior : " .. tostring(result))
		-- Nettoyage d'une construction ratée
		for _, child in ipairs(parent:GetChildren()) do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
	end
	return buildFallback(parent, size)
end

----------------------------------------------------------------------
-- Vue d'ensemble
----------------------------------------------------------------------

function HouseOverview.new(parent: Frame, handlers: Handlers): Overview
	local overview: Overview
	local house: HouseData? = nil
	local overridesNow: HouseCommon.Overrides? = nil
	local size: SizeDef? = nil
	local exterior: Exterior? = nil
	local exteriorLooks: any = nil -- (v9.1) façade, toit, jardin
	local gardenFocus = false -- (v9.1) essai d'une déco du jardin en cours
	local looksKey = ""
	local cards: { [string]: Card } = {}
	local empties: { [number]: EmptySlot } = {}
	local localSlots: { [string]: number } = {} -- déplacements pas encore confirmés
	local dark = false
	local arranging = false
	local drag: Drag? = nil
	local pending: Pending? = nil
	local fitScale = 1
	local zoomed = false
	local zoomToken = 0
	local clock = 0

	local root = UIUtil.Create("Frame", {
		Name = "Overview",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 5,
		Parent = parent,
	})
	root:SetAttribute("DarkSkinIgnore", true)
	UIUtil.Corner(root, 20)
	local probe = UIUtil.Create("Frame", {
		Name = "Probe",
		Size = UDim2.fromOffset(100, 100),
		BackgroundTransparency = 1,
		Parent = root,
	})

	------------------------------------------------------------------
	-- Ciel
	------------------------------------------------------------------
	local sky = UIUtil.Create("Frame", {
		Name = "Sky",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 1,
		Parent = root,
	})
	local skyGradient = UIUtil.Gradient(sky, SKY_DAY, 90)
	local sun = UIUtil.Create("Frame", {
		Name = "Sun",
		Size = UDim2.fromOffset(120, 120),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -90, 0, 70),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = sky,
	})
	local sunGlow = Circle(sun, 60, 60, 120, 120, Color3.fromRGB(255, 240, 180), 0.75, 1)
	local sunDisc = Circle(sun, 60, 60, 60, 60, Color3.fromRGB(255, 226, 130), 0, 2)
	local moonBite = Circle(sunDisc, 42, 20, 44, 44, Color3.fromRGB(40, 34, 95), 0, 3)
	moonBite.Visible = false
	local clouds: { { Frame: Frame, X: number, Y: number, Speed: number } } = {}
	for index = 1, 5 do
		local holder = UIUtil.Create("Frame", {
			Name = "Cloud" .. index,
			AnchorPoint = Vector2.new(0.5, 1),
			Size = UDim2.fromOffset(140, 90),
			BackgroundTransparency = 1,
			ZIndex = 2,
			Parent = sky,
		})
		local w = 80 + (index * 37 % 60)
		HousePatterns.Cloud(holder, 70, 90, w, WHITE, 0.12 + (index % 3) * 0.1, 1)
		table.insert(clouds, { Frame = holder, X = (index * 0.23) % 1, Y = 0.1 + (index * 0.17) % 0.45, Speed = 0.006 + (index % 4) * 0.003 })
	end
	local stars: { Frame } = {}
	for index = 1, 26 do
		local s = 5 + (index * 7 % 6)
		local holder = UIUtil.Create("Frame", {
			Name = "Star" .. index,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale((index * 0.618) % 1, 0.03 + ((index * 0.382) % 1) * 0.62),
			Size = UDim2.fromOffset(s, s),
			BackgroundTransparency = 1,
			Visible = false,
			ZIndex = 2,
			Parent = sky,
		})
		HousePatterns.Sparkle(holder, s / 2, s / 2, s, Color3.fromRGB(255, 244, 196), 0.1, 1)
		holder:SetAttribute("Phase", index * 1.7)
		table.insert(stars, holder)
	end
	-- Collines au loin
	local hills: { Frame } = {}
	for index, info in ipairs({ { 0.12, 0.62, Color3.fromRGB(190, 232, 190) }, { 0.5, 0.9, Color3.fromRGB(176, 226, 180) }, { 0.88, 0.66, Color3.fromRGB(196, 236, 196) } }) do
		local hill = UIUtil.Create("Frame", {
			Name = "Hill" .. index,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(info[1], 0, 0.8, 0),
			Size = UDim2.new(info[2], 0, 0.6, 0),
			BackgroundColor3 = info[3],
			BorderSizePixel = 0,
			ZIndex = 3,
			Parent = sky,
		})
		Round(hill)
		hill:SetAttribute("DayColor", info[3])
		table.insert(hills, hill)
	end

	-- Ciel de HouseExterior (Contrat A, facultatif) : remplace le nôtre
	type Backdrop = { Frame: Frame, SetDark: (dark: boolean) -> (), Update: (dt: number) -> (), Destroy: () -> () }
	local backdrop: Backdrop? = nil
	do
		local moduleScript = script.Parent:FindFirstChild("HouseExterior")
		if moduleScript and moduleScript:IsA("ModuleScript") then
			local ok, result = pcall(function()
				local module = (require :: any)(moduleScript)
				if type(module.BuildBackdrop) ~= "function" then
					return nil
				end
				local built = module.BuildBackdrop(root, nil)
				assert(type(built) == "table" and typeof(built.Frame) == "Instance", "bad backdrop")
				return built
			end)
			if ok and result then
				local built = result :: any
				built.Frame.ZIndex = 1
				backdrop = built :: Backdrop
				sky.Visible = false
			elseif not ok then
				warn("[HouseOverview] Ciel de HouseExterior : " .. tostring(result))
			end
		end
	end

	------------------------------------------------------------------
	-- Immeuble (zoom) et calque de glissement
	------------------------------------------------------------------
	local zoom = UIUtil.Create("Frame", {
		Name = "Zoom",
		Size = UDim2.fromOffset(100, 100),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = 4,
		Parent = root,
	})
	local zoomScale = UIUtil.Create("UIScale", { Parent = zoom })
	local dragLayer = UIUtil.Create("Frame", {
		Name = "DragLayer",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = zoom,
	})
	-- Case visée : fond rose sous la carte, contour + étiquette par-dessus
	local dropMark = UIUtil.Create("Frame", {
		Name = "Drop",
		BackgroundColor3 = C.Pink,
		BackgroundTransparency = 0.6,
		Visible = false,
		ZIndex = 1,
		Parent = dragLayer,
	})
	UIUtil.Corner(dropMark, 14)
	local dropOutline = UIUtil.Create("Frame", {
		Name = "DropOutline",
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 10,
		Parent = dragLayer,
	})
	UIUtil.Corner(dropOutline, 14)
	local dropStroke = UIUtil.Stroke(dropOutline, C.PinkDeep, 6, 0)
	local dropChip = UIUtil.Chip({
		Name = "DropChip",
		Text = "",
		Color = C.PinkDeep,
		TextColor3 = WHITE,
		Height = 28,
		TextSize = 16,
		ZIndex = 11,
		Visible = false,
		Parent = dragLayer,
	})
	dropChip.AnchorPoint = Vector2.new(0.5, 0.5)
	UIUtil.Stroke(dropChip, WHITE, 2, 0)
	local dropChipScale = UIUtil.Create("UIScale", { Parent = dropChip })

	-- Astuce en bas
	local hint = UIUtil.Chip({
		Name = "Hint",
		Text = "",
		Color = WHITE,
		TextColor3 = C.Ink,
		Height = 26,
		TextSize = 14,
		ZIndex = 20,
		Parent = root,
	})
	hint.AnchorPoint = Vector2.new(0.5, 1)
	hint.Position = UDim2.new(0.5, 0, 1, -8)

	local function refreshHint()
		local label = hint:FindFirstChild("Label") :: TextLabel?
		if label then
			label.Text = arranging and Locale.T("✋ Drag a room onto another spot  •  tap it for options")
				or Locale.T("👆 Tap a room to decorate it")
		end
		hint.BackgroundColor3 = arranging and C.Butter or WHITE
	end

	------------------------------------------------------------------
	-- Coordonnées
	------------------------------------------------------------------

	-- Position écran -> px de maquette de l'immeuble
	local function screenToBuilding(position: Vector2): Vector2
		local ext = exterior
		if not ext then
			return Vector2.zero
		end
		local absSize = zoom.AbsoluteSize
		if absSize.X <= 0 then
			return Vector2.zero
		end
		local k = absSize.X / ext.Width
		return (position - zoom.AbsolutePosition) / k
	end

	local function slotOf(room: Room): number
		return localSlots[room.Id] or room.Slot
	end

	local function rectOf(slot: number): Rect?
		local ext = exterior
		return ext and ext.Cells[slot] or nil
	end

	-- Taille "constante à l'écran" des pastilles (bornée par la taille des cases)
	local function labelScale(): number
		local wanted = 1 / math.max(0.05, fitScale)
		local limit = Interface.IsPhone() and 2.6 or 2.2
		return math.clamp(wanted * (Interface.IsPhone() and 0.8 or 0.95), 1, limit)
	end

	------------------------------------------------------------------
	-- Cartes (pièces) et cases vides
	------------------------------------------------------------------

	local function roomStats(room: Room): (number, number, number)
		local currentHouse = house :: HouseData
		local placed = (overridesNow and overridesNow[room.Id]) or room.Placed
		local comfort = HouseCommon.RoomComfort(currentHouse, room, placed)
		local favorites = 0
		for _, entry in ipairs(placed) do
			local item = HouseCommon.ItemsById[entry.I]
			if item and HouseCommon.IsFavorite(room, item) then
				favorites += 1
			end
		end
		return comfort, favorites, #placed
	end

	local function textWidth(text: string): number
		local ok, bounds = pcall(function()
			return TextService:GetTextSize(text, 14, Theme.Fonts.Title, Vector2.new(2000, 100))
		end)
		if ok and typeof(bounds) == "Vector2" then
			return bounds.X
		end
		return #text * 8
	end

	-- Texte de la pastille : le plus complet qui tient dans la case
	local function fitChip(card: Card, room: Room)
		local roomType = HouseCommon.GetRoomType(room)
		local comfort, favorites = roomStats(room)
		local comfortText = string.format("❤️ %d", math.floor(comfort + 0.5))
		local name = HouseCommon.Name(roomType)
		local candidates = {}
		if favorites > 0 then
			table.insert(candidates, string.format("%s %s  %s  ✨%d", roomType.Icon, name, comfortText, favorites))
		end
		table.insert(candidates, string.format("%s %s  %s", roomType.Icon, name, comfortText))
		if favorites > 0 then
			table.insert(candidates, string.format("%s %s  ✨%d", roomType.Icon, comfortText, favorites))
		end
		table.insert(candidates, string.format("%s %s", roomType.Icon, comfortText))
		table.insert(candidates, roomType.Icon)
		local rect = rectOf(card.Slot) or rectOf(slotOf(room))
		local s = card.ChipScale.Scale
		-- (rien n'a changé : pas de nouvelles mesures de texte)
		local key = table.concat(candidates, "|") .. string.format("|%.3f|%s|%s|%d", s, tostring(arranging), tostring(card.Hovered), rect and rect.W or 0)
		if key == card.ChipKey then
			return
		end
		card.ChipKey = key
		local maxWidth = (rect and rect.W or 300) - 12 * s - (arranging and 44 * s or 0)
		local chosen = candidates[#candidates]
		-- (survol : le nom complet, même s'il dépasse un peu de la case)
		if card.Hovered then
			chosen = candidates[1]
		end
		for _, text in ipairs(card.Hovered and {} or candidates) do
			if (textWidth(text) + 26) * s <= maxWidth then
				chosen = text
				break
			end
		end
		if card.ChipLabel.Text ~= chosen then
			card.ChipLabel.Text = chosen
		end
	end

	local function fitAllChips()
		local currentHouse = house
		if not currentHouse then
			return
		end
		for _, room in ipairs(currentHouse.Rooms) do
			local card = cards[room.Id]
			if card then
				fitChip(card, room)
			end
		end
	end

	local function paintCard(card: Card)
		local showRing = card.Hovered or arranging or (drag ~= nil and (drag :: Drag).Card == card)
		card.Hover.Visible = showRing
		card.HoverStroke.Color = arranging and C.Lilac or WHITE
		card.Hover.BackgroundTransparency = card.Hovered and not arranging and 0.85 or 1
		card.Menu.Visible = arranging and not (drag ~= nil and (drag :: Drag).Card == card)
	end

	local function placeCard(card: Card, animate: boolean)
		local rect = rectOf(card.Slot)
		if not rect then
			return
		end
		local target = UDim2.fromOffset(rect.X, rect.Y)
		if animate then
			UIUtil.Tween(card.Frame, 0.32, { Position = target }, Enum.EasingStyle.Back)
		else
			card.Frame.Position = target
		end
	end

	local function newCard(room: Room): Card
		local ext = exterior :: Exterior
		local rect = ext.Cells[slotOf(room)] or ext.Cells[1]
		local frame = UIUtil.Create("Frame", {
			Name = "Room_" .. room.Id,
			Size = UDim2.fromOffset(rect.W, rect.H),
			Position = UDim2.fromOffset(rect.X, rect.Y),
			BackgroundTransparency = 1,
			ZIndex = 2,
			Parent = ext.CellLayer,
		})
		local scale = UIUtil.Create("UIScale", { Parent = frame })
		local shadow = Box(frame, 10, 14, rect.W, rect.H, BLACK, 0.7, 0)
		Round(shadow, UDim.new(0, 10))
		shadow.Name = "Shadow"
		shadow.Visible = false
		local mini = HouseMiniRoom.new(frame, rect.W, rect.H)
		mini.Frame.ZIndex = 1
		local hover = UIUtil.Create("Frame", {
			Name = "Hover",
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 1,
			Visible = false,
			ZIndex = 3,
			Parent = frame,
		})
		UIUtil.Corner(hover, 6)
		local hoverStroke = UIUtil.Stroke(hover, WHITE, 5, 0.05)
		local chip = UIUtil.Chip({
			Name = "Label",
			Text = "",
			Color = WHITE,
			TextColor3 = C.Ink,
			Height = 24,
			TextSize = 14,
			ZIndex = 4,
			Parent = frame,
		})
		chip.AnchorPoint = Vector2.new(0, 0)
		chip.Position = UDim2.fromOffset(8, 8)
		chip.BackgroundTransparency = 0.08
		local chipScale = UIUtil.Create("UIScale", { Parent = chip })
		local hit = UIUtil.Create("TextButton", {
			Name = "Hit",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Text = "",
			ZIndex = 5,
			Parent = frame,
		})
		local menu = UIUtil.Create("TextButton", {
			Name = "Menu",
			Size = UDim2.fromOffset(34, 34),
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -8, 0, 8),
			BackgroundColor3 = C.Lilac,
			AutoButtonColor = false,
			Font = Theme.Fonts.Title,
			Text = "⋯",
			TextColor3 = WHITE,
			TextSize = 24,
			Visible = false,
			ZIndex = 6,
			Parent = frame,
		})
		UIUtil.Corner(menu, UDim.new(1, 0))
		UIUtil.Stroke(menu, WHITE, 2, 0)
		local menuScale = UIUtil.Create("UIScale", { Parent = menu })
		local card: Card = {
			RoomId = room.Id,
			Frame = frame,
			Scale = scale,
			Mini = mini,
			Hover = hover,
			HoverStroke = hoverStroke,
			Chip = chip,
			ChipLabel = chip:FindFirstChild("Label") :: TextLabel,
			ChipScale = chipScale,
			Menu = menu,
			MenuScale = menuScale,
			Shadow = shadow,
			Hit = hit,
			Slot = slotOf(room),
			Hovered = false,
			ChipKey = "",
		}
		hit.MouseEnter:Connect(function()
			if drag then
				return
			end
			card.Hovered = true
			frame.ZIndex = 3
			paintCard(card)
			local currentHouse = house
			local roomData = currentHouse and HouseCommon.GetRoom(currentHouse, card.RoomId)
			if roomData then
				fitChip(card, roomData)
			end
			UIUtil.Pop(chip, 1.1, 0.25)
		end)
		hit.MouseLeave:Connect(function()
			card.Hovered = false
			if frame.Parent ~= dragLayer then
				frame.ZIndex = 2
			end
			paintCard(card)
			local currentHouse = house
			local roomData = currentHouse and HouseCommon.GetRoom(currentHouse, card.RoomId)
			if roomData then
				fitChip(card, roomData)
			end
		end)
		hit.InputBegan:Connect(function(input: InputObject)
			local kind = input.UserInputType
			if kind ~= Enum.UserInputType.MouseButton1 and kind ~= Enum.UserInputType.Touch then
				return
			end
			if not arranging or drag or zoomed then
				return
			end
			pending = { RoomId = card.RoomId, Input = input, Start = Vector2.new(input.Position.X, input.Position.Y) }
		end)
		hit.Activated:Connect(function()
			if arranging or drag or zoomed then
				return
			end
			SoundManager.Play("Click", 1.1)
			handlers.OnOpenRoom(card.RoomId)
		end)
		menu.Activated:Connect(function()
			pending = nil
			handlers.OnRoomMenu(card.RoomId)
		end)
		return card
	end

	local function newEmpty(slot: number): EmptySlot
		local ext = exterior :: Exterior
		local rect = ext.Cells[slot]
		local frame = UIUtil.Create("Frame", {
			Name = "Empty_" .. slot,
			Size = UDim2.fromOffset(rect.W, rect.H),
			Position = UDim2.fromOffset(rect.X, rect.Y),
			BackgroundColor3 = Color3.fromRGB(255, 244, 250),
			BackgroundTransparency = 0.15,
			BorderSizePixel = 0,
			ZIndex = 1,
			Parent = ext.CellLayer,
		})
		UIUtil.Gradient(frame, ColorSequence.new(WHITE, Color3.fromRGB(236, 226, 246)), 90)
		-- Pointillés
		local dash, gap, inset = 14, 10, 8
		local color = C.Pink
		local x = inset
		while x < rect.W - inset do
			local w = math.min(dash, rect.W - inset - x)
			Box(frame, x, inset, w, 3, color, 0.1, 2)
			Box(frame, x, rect.H - inset - 3, w, 3, color, 0.1, 2)
			x += dash + gap
		end
		local y = inset + dash + gap
		while y < rect.H - inset - dash do
			Box(frame, inset, y, 3, dash, color, 0.1, 2)
			Box(frame, rect.W - inset - 3, y, 3, dash, color, 0.1, 2)
			y += dash + gap
		end
		local content = UIUtil.Create("Frame", {
			Name = "Content",
			Size = UDim2.fromOffset(160, 96),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			BackgroundTransparency = 1,
			ZIndex = 3,
			Parent = frame,
		})
		local contentScale = UIUtil.Create("UIScale", { Parent = content })
		local plus = Circle(content, 80, 22, 40, 40, C.PinkDeep, 0, 1)
		UIUtil.Stroke(plus, WHITE, 3, 0)
		UIUtil.Create("TextLabel", {
			Name = "Icon",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Font = Theme.Fonts.Title,
			Text = "+",
			TextColor3 = WHITE,
			TextSize = 30,
			ZIndex = 2,
			Parent = plus,
		})
		UIUtil.Create("TextLabel", {
			Name = "Title",
			Size = UDim2.new(1, 0, 0, 22),
			Position = UDim2.fromOffset(0, 46),
			BackgroundTransparency = 1,
			Font = Theme.Fonts.Title,
			Text = Locale.T("New room"),
			TextColor3 = C.Ink,
			TextSize = 17,
			ZIndex = 2,
			Parent = content,
		})
		local price = UIUtil.Create("TextLabel", {
			Name = "Price",
			Size = UDim2.new(1, 0, 0, 20),
			Position = UDim2.fromOffset(0, 70),
			BackgroundTransparency = 1,
			Font = Theme.Fonts.Body,
			Text = "",
			TextColor3 = C.PinkDeep,
			TextSize = 15,
			ZIndex = 2,
			Parent = content,
		})
		local hit = UIUtil.Create("TextButton", {
			Name = "Hit",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Text = "",
			ZIndex = 4,
			Parent = frame,
		})
		local empty: EmptySlot = {
			Slot = slot,
			Frame = frame,
			Content = content,
			ContentScale = contentScale,
			Price = price,
			Plus = plus,
			Hit = hit,
		}
		hit.MouseEnter:Connect(function()
			if not drag then
				UIUtil.Tween(contentScale, 0.15, { Scale = labelScale() * 1.08 }, Enum.EasingStyle.Back)
				frame.BackgroundTransparency = 0
			end
		end)
		hit.MouseLeave:Connect(function()
			UIUtil.Tween(contentScale, 0.15, { Scale = labelScale() })
			frame.BackgroundTransparency = 0.15
		end)
		hit.Activated:Connect(function()
			if drag or zoomed then
				return
			end
			SoundManager.Play("Click", 1.2)
			UIUtil.Pop(plus, 1.25, 0.3)
			handlers.OnEmptySlot(slot)
		end)
		return empty
	end

	local function clearAll()
		for _, card in pairs(cards) do
			card.Mini.Destroy()
			card.Frame:Destroy()
		end
		table.clear(cards)
		for _, empty in pairs(empties) do
			empty.Frame:Destroy()
		end
		table.clear(empties)
		local ext = exterior
		if ext then
			ext.Destroy()
			exterior = nil
		end
		for _, child in ipairs(zoom:GetChildren()) do
			if child ~= dragLayer and child:IsA("GuiObject") then
				child:Destroy()
			end
		end
	end

	local refit: (force: boolean?) -> ()

	local function applyLabelScales()
		local s = labelScale()
		for _, card in pairs(cards) do
			card.ChipScale.Scale = s
			card.MenuScale.Scale = s
			card.Chip.Position = UDim2.fromOffset(6 * s, 6 * s)
			card.Menu.Position = UDim2.new(1, -6 * s, 0, 6 * s)
		end
		for _, empty in pairs(empties) do
			local rect = rectOf(empty.Slot)
			local limit = rect and math.min(rect.W / 170, rect.H / 104) or s
			empty.ContentScale.Scale = math.min(s, limit)
		end
		dropChipScale.Scale = s
	end

	-- Remet chaque pièce / case vide à sa place (sans reconstruire)
	local function layoutCells(animate: boolean)
		local currentHouse = house
		local currentSize = size
		if not currentHouse or not currentSize then
			return
		end
		local used: { [number]: boolean } = {}
		for _, room in ipairs(currentHouse.Rooms) do
			local card = cards[room.Id]
			if card then
				local slot = slotOf(room)
				used[slot] = true
				if card.Slot ~= slot then
					card.Slot = slot
					if not (drag and (drag :: Drag).Card == card) then
						placeCard(card, animate)
					end
				end
			end
		end
		local cost = HouseCommon.RoomCost(currentHouse)
		local affordable = HouseCommon.Dopamine() >= cost
		for slot = 1, currentSize.MaxRooms do
			local isEmpty = not used[slot]
			local empty = empties[slot]
			if isEmpty and not empty and exterior then
				empty = newEmpty(slot)
				empties[slot] = empty
				applyLabelScales()
				empty.Frame.BackgroundColor3 = dark and Color3.fromRGB(186, 174, 226) or Color3.fromRGB(255, 244, 250)
			end
			if empty then
				empty.Frame.Visible = isEmpty
				empty.Price.Text = "💧 " .. NumberFormatter.Format(cost)
				empty.Price.TextColor3 = affordable and Color3.fromRGB(34, 150, 92) or C.PinkDeep
			end
		end
	end

	------------------------------------------------------------------
	-- Glisser-déposer (mode rangement)
	------------------------------------------------------------------

	local function slotAt(point: Vector2): number?
		local ext = exterior
		local currentSize = size
		if not ext or not currentSize then
			return nil
		end
		local best, bestDistance = nil, math.huge
		for slot = 1, currentSize.MaxRooms do
			local rect = ext.Cells[slot]
			if rect then
				local cx = math.clamp(point.X, rect.X, rect.X + rect.W)
				local cy = math.clamp(point.Y, rect.Y, rect.Y + rect.H)
				local distance = (Vector2.new(cx, cy) - point).Magnitude
				if distance < bestDistance then
					best, bestDistance = slot, distance
				end
			end
		end
		if bestDistance > 60 then
			return nil
		end
		return best
	end

	local function roomAt(slot: number): Room?
		local currentHouse = house
		if not currentHouse then
			return nil
		end
		for _, room in ipairs(currentHouse.Rooms) do
			if slotOf(room) == slot then
				return room
			end
		end
		return nil
	end

	local function showDrop(slot: number?)
		local current = drag
		if not slot or not current or slot == current.FromSlot then
			dropMark.Visible = false
			dropOutline.Visible = false
			dropChip.Visible = false
			return
		end
		local rect = rectOf(slot) :: Rect
		dropMark.Position = UDim2.fromOffset(rect.X - 4, rect.Y - 4)
		dropMark.Size = UDim2.fromOffset(rect.W + 8, rect.H + 8)
		dropOutline.Position = dropMark.Position
		dropOutline.Size = dropMark.Size
		dropOutline.Visible = true
		dropStroke.Thickness = 3 * labelScale()
		dropChip.Position = UDim2.fromOffset(rect.X + rect.W / 2, rect.Y + 4)
		dropChip.Visible = true
		local label = dropChip:FindFirstChild("Label") :: TextLabel?
		if label then
			label.Text = roomAt(slot) and Locale.T("🔀 Swap") or Locale.T("📍 Move here")
		end
		if not dropMark.Visible then
			dropMark.Visible = true
			UIUtil.Pop(dropChip, 0.6, 0.25)
		end
	end

	local function beginDrag(roomId: string, screenPos: Vector2)
		local card = cards[roomId]
		if not card or drag or not exterior then
			return
		end
		local rect = rectOf(card.Slot) :: Rect
		local point = screenToBuilding(screenPos)
		local corner = Vector2.new(rect.X, rect.Y)
		drag = {
			Card = card,
			FromSlot = card.Slot,
			Offset = corner - point,
			Target = corner,
			Current = corner,
			Over = nil,
		}
		card.Frame.Parent = dragLayer
		card.Frame.ZIndex = 3
		card.Shadow.Visible = true
		UIUtil.Tween(card.Scale, 0.15, { Scale = 1.06 }, Enum.EasingStyle.Back)
		card.Hovered = false
		paintCard(card)
		SoundManager.Play("Click", 1.3)
		-- Case de départ : contour en pointillés (la case vide réapparaît)
		local empty = empties[card.Slot]
		if not empty and exterior then
			empty = newEmpty(card.Slot)
			empties[card.Slot] = empty
			applyLabelScales()
		end
		if empty then
			empty.Frame.Visible = true
			empty.Content.Visible = false
		end
	end

	local function dragTo(screenPos: Vector2)
		local current = drag
		if not current then
			return
		end
		local point = screenToBuilding(screenPos)
		current.Target = point + current.Offset
		local over = slotAt(point)
		if over ~= current.Over then
			current.Over = over
			showDrop(over)
			if over and over ~= current.FromSlot then
				SoundManager.Play("Click", 1.5)
			end
		end
	end

	local function finishDrag()
		local current = drag
		if not current then
			return
		end
		drag = nil
		dropMark.Visible = false
		dropOutline.Visible = false
		dropChip.Visible = false
		local card = current.Card
		local ext = exterior
		card.Frame.Parent = ext and ext.CellLayer or dragLayer
		card.Frame.ZIndex = 2
		card.Shadow.Visible = false
		UIUtil.Tween(card.Scale, 0.2, { Scale = 1 })
		local empty = empties[current.FromSlot]
		if empty then
			empty.Content.Visible = true
		end
		local target = current.Over
		if target and target ~= current.FromSlot then
			local other = roomAt(target)
			localSlots[card.RoomId] = target
			if other then
				localSlots[other.Id] = current.FromSlot
			end
			card.Slot = -1 -- repositionné par layoutCells (animé)
			layoutCells(true)
			SoundManager.Play("Pop", 1.1)
			handlers.OnMoveRoom(card.RoomId, target)
		else
			placeCard(card, true)
			layoutCells(false)
		end
		paintCard(card)
	end

	UserInputService.InputChanged:Connect(function(input: InputObject)
		local kind = input.UserInputType
		if kind ~= Enum.UserInputType.MouseMovement and kind ~= Enum.UserInputType.Touch then
			return
		end
		local position = Vector2.new(input.Position.X, input.Position.Y)
		local waiting = pending
		if waiting and not drag then
			local matches = (kind == Enum.UserInputType.Touch and input == waiting.Input)
				or (kind == Enum.UserInputType.MouseMovement and waiting.Input.UserInputType == Enum.UserInputType.MouseButton1)
			if matches and (position - waiting.Start).Magnitude >= DRAG_THRESHOLD then
				pending = nil
				beginDrag(waiting.RoomId, waiting.Start)
				dragTo(position)
			end
			return
		end
		if drag then
			dragTo(position)
		end
	end)

	UserInputService.InputEnded:Connect(function(input: InputObject)
		local kind = input.UserInputType
		if kind ~= Enum.UserInputType.MouseButton1 and kind ~= Enum.UserInputType.Touch then
			return
		end
		local waiting = pending
		if waiting then
			pending = nil
			if waiting.Input == input or kind == Enum.UserInputType.MouseButton1 then
				-- Simple toucher en mode rangement : menu de la pièce
				if arranging and not drag then
					handlers.OnRoomMenu(waiting.RoomId)
				end
			end
			return
		end
		if drag then
			finishDrag()
		end
	end)

	------------------------------------------------------------------
	-- Mise à l'échelle et zoom
	------------------------------------------------------------------

	local function available(): Vector2
		local factor = probe.AbsoluteSize.X / 100
		if factor <= 0 then
			return Vector2.new(1000, 560)
		end
		return root.AbsoluteSize / factor
	end

	-- Échelle / position "tout l'immeuble" ; si la place est très plate
	-- (téléphone), on cadre plutôt les pièces (le jardin et le haut du toit
	-- peuvent sortir un peu du cadre)
	local HINT_SPACE = 34
	local function fitTarget(): (number, UDim2)
		local ext = exterior :: Exterior
		local space = available()
		local availW, availH = space.X - 24, space.Y - HINT_SPACE - 16
		local full = math.max(0.05, math.min(availW / ext.Width, availH / ext.Height))
		local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
		for _, rect in pairs(ext.Cells) do
			minX, minY = math.min(minX, rect.X), math.min(minY, rect.Y)
			maxX, maxY = math.max(maxX, rect.X + rect.W), math.max(maxY, rect.Y + rect.H)
		end
		if minX < maxX then
			minX, maxX = math.max(0, minX - 90), math.min(ext.Width, maxX + 90)
			minY, maxY = math.max(0, minY - 150), math.min(ext.Height, maxY + 70)
			-- (v9.1) essai d'une déco du jardin depuis la boutique : le jardin reste à l'écran
			if gardenFocus then
				maxY = ext.Height
			end
			local focus = math.max(0.05, math.min(availW / (maxX - minX), availH / (maxY - minY)))
			-- (PC / tablette : l'immeuble entier tant qu'il reste assez grand)
			if full < focus * (Interface.IsPhone() and 0.85 or 0.5) then
				local cx = (minX + maxX) / 2 - ext.Width / 2
				local cy = (minY + maxY) / 2 - ext.Height / 2
				return focus, UDim2.new(0.5, -cx * focus, 0.5, -cy * focus - HINT_SPACE / 2 + 4)
			end
		end
		return full, UDim2.new(0.5, 0, 0.5, -HINT_SPACE / 2 + 4)
	end

	refit = function(force: boolean?)
		local ext = exterior
		if not ext then
			return
		end
		local newScale, position = fitTarget()
		local changed = math.abs(newScale - fitScale) > 1e-4
		fitScale = newScale
		if not zoomed then
			zoomScale.Scale = newScale
			zoom.Position = position
		end
		if changed or force == true then
			applyLabelScales()
			fitAllChips()
		end
	end

	-- Position / échelle du zoom qui remplit la zone avec la case
	local function zoomTarget(slot: number): (number, UDim2)
		local ext = exterior :: Exterior
		local rect = ext.Cells[slot]
		local space = available()
		local s = math.min(space.X / rect.W, space.Y / rect.H) * 0.92
		local cx = rect.X + rect.W / 2 - ext.Width / 2
		local cy = rect.Y + rect.H / 2 - ext.Height / 2
		return s, UDim2.new(0.5, -cx * s, 0.5, -cy * s)
	end

	local function rebuild()
		local currentSize = size :: SizeDef
		clearAll()
		exterior = buildExterior(zoom, currentSize, exteriorLooks)
		local ext = exterior :: Exterior
		zoom.Size = UDim2.fromOffset(ext.Width, ext.Height)
		ext.Frame.Position = UDim2.fromScale(0.5, 0.5)
		ext.Frame.ZIndex = 1
		ext.SetDark(dark)
		refit(true)
	end

	------------------------------------------------------------------
	-- API
	------------------------------------------------------------------

	overview = {
		Frame = root,
		SetHouse = function(newHouse: HouseData, overrides: HouseCommon.Overrides?, preview: { [string]: string }?)
			house = newHouse
			overridesNow = overrides
			local newSize = HouseCommon.GetSize(newHouse)
			-- (v9.1) façade, toit, motif du toit, jardin (+ essai de la boutique)
			local essay = preview or {}
			local garden = table.clone(newHouse.Garden)
			local extra = essay.Garden
			if extra and not table.find(garden, extra) then
				if #garden >= HouseCommon.GardenSlots then
					table.remove(garden)
				end
				table.insert(garden, extra)
			end
			local looks = {
				Facade = HouseCommon.Look("Facade", essay.Facade or newHouse.Facade),
				Roof = HouseCommon.Look("Roof", essay.Roof or newHouse.Roof),
				RoofStyle = HouseCommon.Look("RoofStyle", essay.RoofStyle or newHouse.RoofStyle),
				Garden = garden,
			}
			local key = table.concat({
				looks.Facade and looks.Facade.Id or "",
				looks.Roof and looks.Roof.Id or "",
				looks.RoofStyle and looks.RoofStyle.Id or "",
				table.concat(garden, ","),
			}, "|")
			local wantFocus = extra ~= nil
			if wantFocus ~= gardenFocus then
				gardenFocus = wantFocus
				task.defer(function()
					refit(true)
				end)
			end
			local looksChanged = key ~= looksKey
			looksKey = key
			exteriorLooks = looks
			local current = exterior :: any
			if looksChanged and current and size and newSize.Id == (size :: SizeDef).Id and type(current.SetLooks) == "function" then
				-- même bâtiment : on repeint seulement la façade (les pièces restent)
				local ok, err = pcall(current.SetLooks, looks)
				if ok then
					looksChanged = false
					current.SetDark(dark)
				else
					warn("[HouseOverview] SetLooks : " .. tostring(err))
				end
			end
			if not size or newSize.Id ~= (size :: SizeDef).Id or not exterior or looksChanged then
				size = newSize
				localSlots = {}
				rebuild()
			end
			-- Déplacements confirmés par le serveur : on oublie la version locale
			for roomId, slot in pairs(localSlots) do
				local room = HouseCommon.GetRoom(newHouse, roomId)
				if not room or room.Slot == slot then
					localSlots[roomId] = nil
				end
			end
			local seen: { [string]: boolean } = {}
			for _, room in ipairs(newHouse.Rooms) do
				seen[room.Id] = true
				if slotOf(room) <= newSize.MaxRooms then
					local card = cards[room.Id]
					if not card then
						card = newCard(room)
						cards[room.Id] = card
						applyLabelScales()
						paintCard(card)
					end
					local placed = (overrides and overrides[room.Id]) or room.Placed
					card.Mini.Set(room, newSize, placed)
					card.Mini.SetDark(dark)
					fitChip(card, room)
				end
			end
			for roomId, card in pairs(cards) do
				if not seen[roomId] then
					card.Mini.Destroy()
					card.Frame:Destroy()
					cards[roomId] = nil
				end
			end
			layoutCells(true)
		end,
		SetDark = function(value: boolean)
			dark = value
			local currentBackdrop = backdrop
			if currentBackdrop then
				pcall(currentBackdrop.SetDark, value)
			end
			skyGradient.Color = value and SKY_NIGHT or SKY_DAY
			sunDisc.BackgroundColor3 = value and Color3.fromRGB(255, 244, 200) or Color3.fromRGB(255, 226, 130)
			sunGlow.BackgroundColor3 = value and Color3.fromRGB(200, 200, 255) or Color3.fromRGB(255, 240, 180)
			sunGlow.BackgroundTransparency = value and 0.86 or 0.75
			moonBite.BackgroundColor3 = Color3.fromRGB(30, 28, 80)
			moonBite.Visible = value
			for _, star in ipairs(stars) do
				star.Visible = value
			end
			for _, cloud in ipairs(clouds) do
				for _, child in ipairs(cloud.Frame:GetDescendants()) do
					if child:IsA("Frame") then
						child.BackgroundColor3 = value and Color3.fromRGB(110, 100, 170) or WHITE
					end
				end
			end
			for _, hill in ipairs(hills) do
				local day = hill:GetAttribute("DayColor")
				if typeof(day) == "Color3" then
					hill.BackgroundColor3 = value and day:Lerp(Color3.fromRGB(40, 36, 100), 0.55) or day
				end
			end
			local ext = exterior
			if ext then
				ext.SetDark(value)
			end
			for _, card in pairs(cards) do
				card.Mini.SetDark(value)
			end
			for _, empty in pairs(empties) do
				empty.Frame.BackgroundColor3 = value and Color3.fromRGB(186, 174, 226) or Color3.fromRGB(255, 244, 250)
			end
		end,
		SetArranging = function(on: boolean)
			if arranging == on then
				return
			end
			arranging = on
			pending = nil
			if not on and drag then
				finishDrag()
			end
			for _, card in pairs(cards) do
				paintCard(card)
			end
			fitAllChips()
			refreshHint()
			UIUtil.Pop(hint, 1.1, 0.3)
		end,
		IsArranging = function(): boolean
			return arranging
		end,
		Update = function(dt: number)
			clock += dt
			local currentBackdrop = backdrop
			if currentBackdrop then
				currentBackdrop.Update(dt)
			end
			for _, cloud in ipairs(currentBackdrop and {} or clouds) do
				cloud.X = (cloud.X + cloud.Speed * dt) % 1.3
				cloud.Frame.Position = UDim2.fromScale(cloud.X - 0.15, cloud.Y)
			end
			if dark and not currentBackdrop then
				for _, star in ipairs(stars) do
					local phase = tonumber(star:GetAttribute("Phase")) or 0
					local wave = 0.5 + 0.5 * math.sin(clock * 2 + phase)
					for _, child in ipairs(star:GetChildren()) do
						if child:IsA("Frame") then
							child.BackgroundTransparency = 0.05 + wave * 0.5
						end
					end
				end
			end
			local ext = exterior
			if ext then
				ext.Update(dt)
			end
			local current = drag
			if current then
				local alpha = 1 - math.exp(-DRAG_SMOOTHING * dt)
				current.Current = current.Current:Lerp(current.Target, alpha)
				current.Card.Frame.Position = UDim2.fromOffset(current.Current.X, current.Current.Y)
			end
			if arranging then
				local wave = 0.5 + 0.5 * math.sin(clock * 4)
				for _, card in pairs(cards) do
					card.HoverStroke.Transparency = 0.05 + wave * 0.45
				end
			end
		end,
		Refit = function()
			refit(true)
		end,
		ZoomIn = function(roomId: string, done: () -> ())
			local card = cards[roomId]
			if not card or not exterior then
				done()
				return
			end
			zoomToken += 1
			local token = zoomToken
			zoomed = true
			local s, position = zoomTarget(card.Slot)
			UIUtil.Tween(zoomScale, ZOOM_TIME, { Scale = s }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			UIUtil.Tween(zoom, ZOOM_TIME, { Position = position }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			SoundManager.Play("Open", 1.2)
			task.delay(ZOOM_TIME, function()
				if token == zoomToken then
					done()
				end
			end)
		end,
		ZoomOut = function(roomId: string?)
			zoomToken += 1
			local card = roomId and cards[roomId :: string]
			if card and exterior then
				local s, position = zoomTarget(card.Slot)
				zoomScale.Scale = s
				zoom.Position = position
			end
			zoomed = false
			local ext = exterior
			if ext then
				local target, position = fitTarget()
				fitScale = target
				UIUtil.Tween(zoomScale, ZOOM_TIME, { Scale = target }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
				UIUtil.Tween(zoom, ZOOM_TIME, { Position = position }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
				applyLabelScales()
				fitAllChips()
			end
		end,
		Pulse = function(roomId: string)
			local card = cards[roomId]
			if card then
				card.Scale.Scale = 0.85
				UIUtil.Tween(card.Scale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
				UIUtil.Pop(card.Chip, 1.3, 0.4)
			end
		end,
		CancelMoves = function()
			localSlots = {}
			layoutCells(true)
		end,
		CellScreenCenter = function(slot: number): Vector2?
			local rect = rectOf(slot)
			local ext = exterior
			if not rect or not ext then
				return nil
			end
			local k = zoom.AbsoluteSize.X / ext.Width
			return zoom.AbsolutePosition + Vector2.new(rect.X + rect.W / 2, rect.Y + rect.H / 2) * k
		end,
		BeginDrag = beginDrag,
		DragTo = dragTo,
		EndDrag = finishDrag,
		IsDragging = function(): boolean
			return drag ~= nil
		end,
	}

	root:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		refit()
	end)
	probe:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		refit()
	end)
	Interface.DeviceChanged:Connect(function()
		refit(true)
		fitAllChips()
	end)
	refreshHint()
	return overview
end

return HouseOverview
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">HousePatterns</string>
              <string name="Source"><![CDATA[--[[
	HousePatterns (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > HousePatterns

	Dessine les motifs des papiers peints et des sols UNIQUEMENT avec des
	Frames (pas d'image à importer) :
	  Murs : Plain (lambris), Stripes, Checker (vichy), Dots, Hearts, Stars
	         (étincelles), Clouds, Bricks, Wood (lambris de bois), Waves
	         (écailles / vaguelettes) ; v9.1 : Plaid (écossais), Flowers,
	         Diamonds (arlequin), Chevron, Moons ; v9.2 : Flag (damier
	         d'arrivée), Bolts (éclairs), Camo, Racing (bandes de course),
	         Carbon, Graffiti, Planets (espace), NeonGrid.
	  Sols : Plain, Checker, Wood, Tiles, Carpet, Marble, Herringbone
	         (parquet) ; v9.1 : Terrazzo, Mosaic, Grass, Clouds, Starry ;
	         v9.2 : Concrete, Court (basket), Turf (foot), TreadPlate (tôle),
	         Road, Lava — en PERSPECTIVE : les rangées grandissent vers
	         l'avant et les colonnes s'écartent depuis le centre (lignes de
	         fuite), sans aucune rotation.
	Le conteneur doit couper son contenu (ClipsDescendants) ; son fond
	prend la couleur A. `unit` agrandit / réduit le motif (1 dans la pièce,
	plus petit dans les aperçus de la boutique).
	Nombre de Frames limité (≈ 60 à 300 selon le motif et la largeur).

	API :
	  HousePatterns.BuildWall(container, largeur, hauteur, style, unit?)
	  HousePatterns.BuildFloor(container, largeur, hauteur, style, unit?)
	  (style = { Pattern, A, B } ; les anciens motifs sont remplacés)
]]

local HousePatterns = {}

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local SQRT2 = math.sqrt(2)

type Style = { Pattern: string, A: Color3, B: Color3 }

----------------------------------------------------------------------
-- Formes de base
----------------------------------------------------------------------

local function box(parent: Instance, x: number, y: number, w: number, h: number, color: Color3, transparency: number?, z: number?): Frame
	local frame = Instance.new("Frame")
	frame.BorderSizePixel = 0
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = transparency or 0
	frame.Position = UDim2.fromOffset(x, y)
	frame.Size = UDim2.fromOffset(w, h)
	frame.ZIndex = z or 1
	frame.Parent = parent
	return frame
end

local function roundify(frame: Frame, radius: UDim?)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = radius or UDim.new(1, 0)
	corner.Parent = frame
end

-- Cercle (ou ovale) centré
local function circle(parent: Instance, cx: number, cy: number, w: number, h: number, color: Color3, transparency: number?, z: number?): Frame
	local frame = box(parent, cx - w / 2, cy - h / 2, w, h, color, transparency, z)
	roundify(frame)
	return frame
end

-- Carré tourné de 45° (losange) centré
local function diamond(parent: Instance, cx: number, cy: number, side: number, color: Color3, transparency: number?, z: number?): Frame
	local frame = box(parent, 0, 0, side, side, color, transparency, z)
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromOffset(cx, cy)
	frame.Rotation = 45
	return frame
end

-- Cœur (2 cercles + un losange) centré, de largeur `width`
local function heart(parent: Instance, cx: number, cy: number, width: number, color: Color3, transparency: number?, z: number?)
	local a = width / (1 + 1 / SQRT2)
	local shift = a * 0.073 -- recentre la forme verticalement
	local centerY = cy + shift
	local offset = a / (2 * SQRT2)
	diamond(parent, cx, centerY, a, color, transparency, z)
	circle(parent, cx - offset, centerY - offset, a, a, color, transparency, z)
	circle(parent, cx + offset, centerY - offset, a, a, color, transparency, z)
end

-- Étincelle à 4 branches (losange + 2 bâtonnets arrondis)
local function sparkle(parent: Instance, cx: number, cy: number, size: number, color: Color3, transparency: number?, z: number?)
	diamond(parent, cx, cy, size * 0.36, color, transparency, z)
	local thin = math.max(1, size * 0.13)
	local vertical = box(parent, cx - thin / 2, cy - size / 2, thin, size, color, transparency, z)
	roundify(vertical)
	local horizontal = box(parent, cx - size / 2, cy - thin / 2, size, thin, color, transparency, z)
	roundify(horizontal)
end

-- Nuage (base arrondie + 2 bosses), `cy` = bas du nuage
local function cloud(parent: Instance, cx: number, cy: number, width: number, color: Color3, transparency: number?, z: number?)
	local baseH = width * 0.34
	local base = box(parent, cx - width / 2, cy - baseH, width, baseH, color, transparency, z)
	roundify(base)
	circle(parent, cx - width * 0.14, cy - baseH, width * 0.5, width * 0.5, color, transparency, z)
	circle(parent, cx + width * 0.2, cy - baseH * 0.9, width * 0.36, width * 0.36, color, transparency, z)
end

-- Pseudo-aléatoire stable (même dessin à chaque reconstruction)
local function noise(a: number, b: number): number
	local value = math.sin(a * 12.9898 + b * 78.233) * 43758.5453
	return value - math.floor(value)
end

local function clear(container: GuiObject): Frame
	local old = container:FindFirstChild("Pattern")
	if old then
		old:Destroy()
	end
	local holder = Instance.new("Frame")
	holder.Name = "Pattern"
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.Size = UDim2.fromScale(1, 1)
	holder.ZIndex = 1
	return holder
end

----------------------------------------------------------------------
-- Murs
----------------------------------------------------------------------

local WALL: { [string]: (holder: Frame, w: number, h: number, a: Color3, b: Color3, u: number) -> () } = {}

-- Uni : lambris en bas (couleur B), moulure claire et petits panneaux
WALL.Plain = function(holder, w, h, a, b, u)
	local bandTop = h * 0.64
	box(holder, 0, bandTop, w, h - bandTop, b)
	box(holder, 0, bandTop - 3 * u, w, 5 * u, a:Lerp(WHITE, 0.6))
	box(holder, 0, bandTop + 2 * u, w, 1.5 * u, b:Lerp(BLACK, 0.12), 0.4)
	local panel = 96 * u
	local x = panel * 0.5
	while x < w do
		local frame = box(holder, x - panel * 0.36, bandTop + 12 * u, panel * 0.72, (h - bandTop) - 22 * u, b:Lerp(WHITE, 0.25), 0.35)
		roundify(frame, UDim.new(0, 4 * u))
		x += panel
	end
	-- Petits motifs discrets sur le haut du mur
	local step = 58 * u
	local row = 0
	local y = 26 * u
	while y < bandTop - 16 * u do
		local offset = (row % 2) * step / 2
		local cx = step / 2 + offset
		while cx < w do
			diamond(holder, cx, y, 5 * u, b, 0.35)
			cx += step
		end
		y += step * 0.7
		row += 1
	end
end

-- Rayures verticales (+ fines rayures au milieu des bandes claires)
WALL.Stripes = function(holder, w, _h, _a, b, u)
	local stripe = 24 * u
	local x = 0
	while x < w do
		local frame = box(holder, x + stripe, 0, stripe, 10000, b)
		frame.Size = UDim2.new(0, stripe, 1, 0)
		local pin = box(holder, x + stripe / 2 - u, 0, 2 * u, 10000, b, 0.45)
		pin.Size = UDim2.new(0, 2 * u, 1, 0)
		x += stripe * 2
	end
end

-- Vichy : bandes semi-transparentes dans les deux sens (carreaux plus foncés aux croisements)
WALL.Checker = function(holder, w, h, _a, b, u)
	local cell = 26 * u
	local x = 0
	while x < w do
		local frame = box(holder, x, 0, cell, h, b, 0.35)
		frame.Size = UDim2.new(0, cell, 1, 0)
		x += cell * 2
	end
	local y = 0
	while y < h do
		local frame = box(holder, 0, y, w, cell, b, 0.35)
		frame.Size = UDim2.new(1, 0, 0, cell)
		y += cell * 2
	end
end

-- Pois en quinconce
WALL.Dots = function(holder, w, h, _a, b, u)
	local step = 60 * u
	local diameter = 16 * u
	local row = 0
	local y = step * 0.4
	while y < h + diameter do
		local cx = (row % 2) * step / 2 + step * 0.3
		while cx < w + diameter do
			circle(holder, cx, y, diameter, diameter, b)
			cx += step
		end
		y += step * 0.72
		row += 1
	end
end

-- Cœurs en quinconce (deux teintes)
WALL.Hearts = function(holder, w, h, _a, b, u)
	local step = 88 * u
	local size = 24 * u
	local light = b:Lerp(WHITE, 0.35)
	local row = 0
	local y = step * 0.45
	while y < h - size * 0.4 do
		local cx = (row % 2) * step / 2 + step * 0.35
		local index = 0
		while cx < w - size * 0.4 do
			local sizeHere = size * (0.8 + 0.4 * noise(cx, y))
			heart(holder, cx, y, sizeHere, (index + row) % 3 == 0 and light or b)
			cx += step
			index += 1
		end
		y += step * 0.62
		row += 1
	end
end

-- Étincelles (tailles variées) + petits points
WALL.Stars = function(holder, w, h, a, b, u)
	local step = 90 * u
	local row = 0
	local y = step * 0.4
	while y < h do
		local cx = (row % 2) * step / 2 + step * 0.3
		local index = 0
		while cx < w do
			local n = noise(cx, y)
			local size = (16 + 20 * n) * u
			sparkle(holder, cx + (n - 0.5) * 16 * u, y + (noise(y, cx) - 0.5) * 12 * u, size, b, n > 0.7 and 0 or 0.15)
			if index % 2 == 0 then
				circle(holder, cx + step * 0.5, y + step * 0.28, 4 * u, 4 * u, b:Lerp(a, 0.2), 0.2)
			end
			cx += step
			index += 1
		end
		y += step * 0.66
		row += 1
	end
end

-- Nuages moelleux
WALL.Clouds = function(holder, w, h, a, b, u)
	local step = 150 * u
	local rows = math.max(1, math.floor(h / (86 * u)))
	for row = 0, rows - 1 do
		local y = (row + 0.72) * (h / rows)
		local cx = (row % 2) * step / 2 + step * 0.35
		while cx < w + step do
			local n = noise(cx, row)
			local width = (60 + 30 * n) * u
			cloud(holder, cx, y, width, b, 0.05 + n * 0.15)
			-- Petite étoile entre deux nuages
			sparkle(holder, cx + step * 0.5, y - 40 * u * (0.5 + n), 9 * u, b:Lerp(a, 0.1), 0.25)
			cx += step
		end
	end
end

-- Briques (joints clairs couleur A, briques couleur B en nuances)
WALL.Bricks = function(holder, w, h, a, b, u)
	local brickW = 70 * u
	local brickH = 28 * u
	local mortar = 4 * u
	local row = 0
	local y = mortar
	while y < h do
		local x = (row % 2 == 0) and -brickW / 2 or 0
		while x < w do
			local n = noise(x + 3, y + 7)
			local tone = b:Lerp(a, n * 0.35)
			local brick = box(holder, x + mortar / 2, y, brickW - mortar, brickH, tone)
			if n > 0.72 then
				-- Petit reflet sur quelques briques
				box(brick, 4 * u, 3 * u, (brickW - mortar) * 0.4, 2 * u, WHITE, 0.55)
			end
			x += brickW
		end
		y += brickH + mortar
		row += 1
	end
end

-- Lambris de bois vertical (planches, joints, nœuds)
WALL.Wood = function(holder, w, h, a, b, u)
	local plank = 46 * u
	local seam = b:Lerp(BLACK, 0.18)
	local index = 0
	local x = 0
	while x < w do
		if index % 2 == 1 then
			local tone = box(holder, x, 0, plank, h, b, 0.55)
			tone.Size = UDim2.new(0, plank, 1, 0)
		end
		local line = box(holder, x, 0, 3 * u, h, seam, 0.15)
		line.Size = UDim2.new(0, 3 * u, 1, 0)
		local n = noise(index, 1)
		if n > 0.45 then
			circle(holder, x + plank * (0.3 + 0.4 * n), h * (0.2 + 0.6 * noise(index, 2)), 11 * u, 6 * u, seam, 0.45)
		end
		-- Veine du bois
		local grain = box(holder, x + plank * (0.25 + 0.5 * noise(index, 3)), 0, 1.5 * u, h, a:Lerp(b, 0.7), 0.5)
		grain.Size = UDim2.new(0, 1.5 * u, 1, 0)
		x += plank
		index += 1
	end
end

-- Écailles / vaguelettes : rangées de cercles qui se chevauchent
WALL.Waves = function(holder, w, h, a, b, u)
	local diameter = 74 * u
	local stepX = 66 * u
	local stepY = 40 * u
	local tones = { b, a:Lerp(b, 0.5), b:Lerp(WHITE, 0.3) }
	local row = 0
	local y = -diameter * 0.3
	while y < h + diameter * 0.2 do
		local offset = (row % 2) * stepX / 2 - stepX / 2
		local x = offset
		local color = tones[row % #tones + 1]
		while x < w + stepX do
			circle(holder, x + stepX / 2, y + diameter / 2, diameter, diameter, color, 0, row + 1)
			x += stepX
		end
		y += stepY
		row += 1
	end
end

-- (v9.1) Écossais : larges bandes croisées (B) + fins filets blancs
WALL.Plaid = function(holder, w, h, a, b, u)
	local cell = 64 * u
	local x = 0
	while x < w do
		local band = box(holder, x, 0, cell * 0.42, h, b, 0.45)
		band.Size = UDim2.new(0, cell * 0.42, 1, 0)
		local thread = box(holder, x + cell * 0.66, 0, 2 * u, h, WHITE, 0.35)
		thread.Size = UDim2.new(0, 2 * u, 1, 0)
		x += cell
	end
	local y = 0
	while y < h do
		local band = box(holder, 0, y, w, cell * 0.42, b, 0.45)
		band.Size = UDim2.new(1, 0, 0, cell * 0.42)
		local thread = box(holder, 0, y + cell * 0.66, w, 2 * u, WHITE, 0.35)
		thread.Size = UDim2.new(1, 0, 0, 2 * u)
		local dark = box(holder, 0, y + cell * 0.18, w, 3 * u, b:Lerp(BLACK, 0.2), 0.55)
		dark.Size = UDim2.new(1, 0, 0, 3 * u)
		y += cell
	end
	local _ = a
end

-- (v9.1) Petites fleurs à 5 pétales (B) au cœur jaune, en quinconce
WALL.Flowers = function(holder, w, h, a, b, u)
	local step = 70 * u
	local petal = 11 * u
	local heartColor = Color3.fromRGB(255, 214, 110)
	local petalColor = b
	if (b.R + b.G + b.B) / 3 > 0.95 then
		-- pétales blancs sur fond clair : un contour pastel pour les voir
		petalColor = a:Lerp(Color3.fromRGB(255, 190, 210), 0.5)
	end
	local row = 0
	local y = step * 0.4
	while y < h + petal do
		local cx = (row % 2) * step / 2 + step * 0.3
		while cx < w + petal do
			local n = noise(cx, y)
			local scale = 0.8 + n * 0.4
			for k = 0, 4 do
				local angle = k / 5 * math.pi * 2 + n
				circle(holder, cx + math.cos(angle) * petal * 0.62 * scale, y + math.sin(angle) * petal * 0.62 * scale,
					petal * scale, petal * scale, petalColor, 0.05)
			end
			circle(holder, cx, y, petal * 0.7 * scale, petal * 0.7 * scale, heartColor, 0)
			if n > 0.55 then
				-- petite feuille
				local leaf = circle(holder, cx + step * 0.3, y + step * 0.18, 12 * u, 6 * u, Color3.fromRGB(150, 210, 140), 0.25)
				leaf.Rotation = -30
			end
			cx += step
		end
		y += step * 0.7
		row += 1
	end
end

-- (v9.1) Arlequin : losanges B (en quinconce) + fins points blancs
WALL.Diamonds = function(holder, w, h, a, b, u)
	local step = 56 * u
	local row = 0
	local y = 0
	while y < h + step do
		local cx = (row % 2) * step / 2
		while cx < w + step do
			diamond(holder, cx, y, step * 0.5, b, 0.1)
			circle(holder, cx + step / 2, y, 4 * u, 4 * u, WHITE, 0.3)
			cx += step
		end
		y += step / 2
		row += 1
	end
	local _ = a
end

-- (v9.1) Chevrons : zigzags horizontaux (segments tournés), 2 teintes
WALL.Chevron = function(holder, w, h, a, b, u)
	local seg = 40 * u
	local thick = 13 * u
	local rowGap = 46 * u
	local tones = { b, b:Lerp(a, 0.45) }
	local row = 0
	local y = rowGap * 0.5
	while y < h + rowGap do
		local x = 0
		local index = 0
		local color = tones[row % 2 + 1]
		while x < w + seg do
			local up = index % 2 == 0
			local frame = box(holder, 0, 0, seg * 1.02 + thick * 0.4, thick, color, 0)
			frame.AnchorPoint = Vector2.new(0.5, 0.5)
			frame.Position = UDim2.fromOffset(x + seg * 0.5, y)
			frame.Rotation = up and -32 or 32
			roundify(frame, UDim.new(0, thick * 0.3))
			x += seg * 0.86
			index += 1
		end
		y += rowGap
		row += 1
	end
end

-- (v9.1) Lunes endormies et étoiles
WALL.Moons = function(holder, w, h, a, b, u)
	local step = 92 * u
	local row = 0
	local y = step * 0.42
	while y < h + 10 * u do
		local cx = (row % 2) * step / 2 + step * 0.32
		while cx < w + 10 * u do
			local n = noise(cx, y)
			local size = (22 + 10 * n) * u
			local moon = circle(holder, cx, y, size, size, b)
			-- croissant : un disque couleur du fond "croque" la lune
			circle(moon, size * 0.72, size * 0.36, size * 0.82, size * 0.82, a, 0)
			sparkle(holder, cx + step * 0.46, y + step * 0.2, (8 + 6 * n) * u, b, 0.15)
			circle(holder, cx - step * 0.28, y + step * 0.3, 4 * u, 4 * u, b, 0.3)
			cx += step
		end
		y += step * 0.66
		row += 1
	end
end

----------------------------------------------------------------------
-- (v9.2) Murs "cool" : damier de course, éclairs, camouflage, bandes de
-- course, fibre de carbone, graffitis, planètes, grille néon
----------------------------------------------------------------------

-- Trait (segment arrondi) entre deux points
local function segment(parent: Instance, x1: number, y1: number, x2: number, y2: number, thick: number, color: Color3, transparency: number?, z: number?): Frame
	local dx, dy = x2 - x1, y2 - y1
	local frame = box(parent, 0, 0, math.sqrt(dx * dx + dy * dy) + thick, thick, color, transparency, z)
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2)
	frame.Rotation = math.deg(math.atan2(dy, dx))
	roundify(frame)
	return frame
end

-- Anneau / ovale vide (contour seulement)
local function ring(parent: Instance, cx: number, cy: number, w: number, h: number, color: Color3, thick: number, transparency: number?, z: number?): Frame
	local frame = circle(parent, cx, cy, w, h, color, 1, z)
	local line = Instance.new("UIStroke")
	line.Color = color
	line.Thickness = thick
	line.Transparency = transparency or 0
	line.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	line.Parent = frame
	return frame
end

-- Éclair (3 segments) de hauteur `size`, centré en (cx, cy)
local function bolt(parent: Instance, cx: number, cy: number, size: number, color: Color3, transparency: number?, z: number?)
	local x, y = cx - size * 0.35, cy - size / 2
	local t = size * 0.17
	segment(parent, x + size * 0.55, y, x + size * 0.16, y + size * 0.52, t, color, transparency, z)
	segment(parent, x + size * 0.16, y + size * 0.52, x + size * 0.54, y + size * 0.48, t, color, transparency, z)
	segment(parent, x + size * 0.54, y + size * 0.48, x + size * 0.14, y + size, t, color, transparency, z)
end

-- Damier de drapeau d'arrivée (grandes cases B) + léger drapé
WALL.Flag = function(holder, w, h, a, b, u)
	local cell = 44 * u
	local row = 0
	local y = 0
	while y < h do
		local col = row % 2
		local x = col * cell
		while x < w do
			box(holder, x, y, cell, cell, b)
			x += cell * 2
		end
		y += cell
		row += 1
	end
	-- plis du drapeau : bandes claires / sombres très douces
	local fold = 180 * u
	local x = 0
	local index = 0
	while x < w do
		local band = box(holder, x, 0, fold * 0.45, h, index % 2 == 0 and WHITE or BLACK, 0.9)
		band.Size = UDim2.new(0, fold * 0.45, 1, 0)
		x += fold * 0.5
		index += 1
	end
	local _ = a
end

-- Éclairs en quinconce (B) + petits points
WALL.Bolts = function(holder, w, h, a, b, u)
	local step = 110 * u
	local row = 0
	local y = step * 0.4
	while y < h + step * 0.2 do
		local cx = (row % 2) * step / 2 + step * 0.3
		while cx < w + step * 0.2 do
			local n = noise(cx, y)
			bolt(holder, cx, y, (30 + 14 * n) * u, b, 0.05)
			circle(holder, cx + step * 0.5, y + step * 0.1, 5 * u, 5 * u, b:Lerp(a, 0.4), 0.2)
			circle(holder, cx + step * 0.28, y - step * 0.22, 3 * u, 3 * u, WHITE, 0.4)
			cx += step
		end
		y += step * 0.62
		row += 1
	end
end

-- Camouflage : taches arrondies en 3 teintes (B, B foncé, A clair)
WALL.Camo = function(holder, w, h, a, b, u)
	local tones = { b, b:Lerp(BLACK, 0.3), a:Lerp(WHITE, 0.25), b:Lerp(a, 0.5) }
	local step = 62 * u
	local row = 0
	local y = 0
	while y < h + step do
		local x = (row % 2) * step / 2 - step * 0.3
		local index = 0
		while x < w + step do
			local n = noise(x + 1, y + 2)
			local m = noise(y + 5, x + 3)
			local blob = circle(holder, x + (n - 0.5) * step * 0.6, y + (m - 0.5) * step * 0.5,
				(46 + 40 * n) * u, (26 + 22 * m) * u, tones[(index + row) % #tones + 1], 0)
			blob.Rotation = (n - 0.5) * 120
			x += step
			index += 1
		end
		y += step * 0.55
		row += 1
	end
end

-- Bandes de course : damier sous le plafond, double bande B, filets blancs
WALL.Racing = function(holder, w, h, a, b, u)
	local cell = 14 * u
	for row = 0, 1 do
		local x = row * cell
		while x < w do
			box(holder, x, 6 * u + row * cell, cell, cell, WHITE, 0.05)
			x += cell * 2
		end
	end
	local mid = h * 0.46
	local big = box(holder, 0, mid, w, 40 * u, b)
	big.Size = UDim2.new(1, 0, 0, 40 * u)
	local small = box(holder, 0, mid + 52 * u, w, 14 * u, b)
	small.Size = UDim2.new(1, 0, 0, 14 * u)
	for _, y in ipairs({ mid - 7 * u, mid + 44 * u, mid + 70 * u }) do
		local pin = box(holder, 0, y, w, 3 * u, WHITE, 0.1)
		pin.Size = UDim2.new(1, 0, 0, 3 * u)
	end
	-- traits de vitesse
	for index = 0, 5 do
		local y = h * 0.2 + noise(index, 4) * h * 0.18
		local x = noise(4, index) * w * 0.85
		local streak = box(holder, x, y, (60 + 60 * noise(index, 9)) * u, 3 * u, WHITE, 0.6)
		roundify(streak)
	end
	local _ = a
end

-- Fibre de carbone : rangées de reflets tissés (dégradés alternés)
local CARBON_WEAVE = (function()
	local points = {}
	for index = 0, 18 do
		table.insert(points, NumberSequenceKeypoint.new(index / 18, index % 2 == 0 and 0.2 or 0.85))
	end
	return NumberSequence.new(points)
end)()
WALL.Carbon = function(holder, w, h, a, b, u)
	local rowH = 12 * u
	local span = 9 * 22 * u -- 9 mailles par cadre
	local row = 0
	local y = 0
	while y < h do
		local x = (row % 2 == 0) and 0 or -11 * u
		while x < w do
			local strip = box(holder, x, y, span, rowH, b, 0)
			local weave = Instance.new("UIGradient")
			weave.Transparency = CARBON_WEAVE
			weave.Parent = strip
			x += span
		end
		-- fine ligne sombre entre deux rangées
		local seam = box(holder, 0, y + rowH - u, w, u, a:Lerp(BLACK, 0.35), 0.4)
		seam.Size = UDim2.new(1, 0, 0, u)
		y += rowH
		row += 1
	end
	-- reflet diagonal (vernis)
	local gloss = box(holder, w * 0.3, -h * 0.2, w * 0.18, h * 1.5, WHITE, 0.9)
	gloss.Rotation = 20
end

-- Graffitis : mur de béton clair (joints), gros tags en bulles, taches,
-- coulures et petites étoiles (couleurs vives, B + cyan + jaune)
local TAGS = { "COOL", "GG", "WOW!", "YO!", "EPIC" }
WALL.Graffiti = function(holder, w, h, a, b, u)
	local seam = a:Lerp(BLACK, 0.12)
	local y = 60 * u
	while y < h do
		local line = box(holder, 0, y, w, 2 * u, seam, 0.3)
		line.Size = UDim2.new(1, 0, 0, 2 * u)
		y += 60 * u
	end
	local colors = { b, Color3.fromRGB(60, 200, 255), Color3.fromRGB(255, 210, 60), Color3.fromRGB(120, 230, 110) }
	local step = 250 * u
	local index = 0
	local x = step * 0.45
	while x < w + step * 0.3 do
		local color = colors[index % #colors + 1]
		local cy = h * (0.34 + 0.22 * noise(index, 3))
		-- tache de peinture + coulures
		local splash = circle(holder, x, cy, 170 * u, 90 * u, color:Lerp(WHITE, 0.55), 0.35)
		splash.Rotation = (noise(index, 5) - 0.5) * 20
		for drip = 0, 2 do
			local dx = x + (drip - 1) * 40 * u + noise(index, drip) * 16 * u
			local length = (24 + 40 * noise(drip, index)) * u
			local d = box(holder, dx, cy + 30 * u, 6 * u, length, color, 0.1)
			roundify(d)
		end
		-- tag en lettres "bulles" (contour sombre)
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.AnchorPoint = Vector2.new(0.5, 0.5)
		label.Position = UDim2.fromOffset(x, cy)
		label.Size = UDim2.fromOffset(220 * u, 80 * u)
		label.Font = Enum.Font.FredokaOne
		label.Text = TAGS[index % #TAGS + 1]
		label.TextSize = math.max(8, math.floor(54 * u))
		label.TextColor3 = color
		label.TextStrokeColor3 = Color3.fromRGB(40, 36, 60)
		label.TextStrokeTransparency = 0
		label.Rotation = (noise(index, 7) - 0.5) * 16
		label.ZIndex = 2
		label.Parent = holder
		-- étoiles et couronne griffonnées
		sparkle(holder, x + 100 * u, cy - 44 * u, 20 * u, colors[(index + 1) % #colors + 1], 0, 2)
		sparkle(holder, x - 96 * u, cy + 50 * u, 14 * u, WHITE, 0.1, 2)
		x += step
		index += 1
	end
end

-- Espace profond : étoiles, planètes (certaines à anneau), étoiles filantes
WALL.Planets = function(holder, w, h, a, b, u)
	for index = 1, math.floor(w * h / (2600 * u * u)) do
		local s = (2 + 3 * noise(index, 1)) * u
		circle(holder, noise(index, 2) * w, noise(3, index) * h, s, s, WHITE, 0.2 + 0.5 * noise(index, 4))
	end
	local palette = { b, Color3.fromRGB(255, 150, 110), Color3.fromRGB(190, 150, 255), Color3.fromRGB(120, 230, 170) }
	local step = 190 * u
	local index = 0
	local x = step * 0.4
	while x < w + step * 0.3 do
		local n = noise(index, 11)
		local cy = h * (0.22 + 0.55 * n)
		local size = (34 + 36 * noise(11, index)) * u
		local color = palette[index % #palette + 1]
		local planet = circle(holder, x, cy, size, size, color, 0, 2)
		-- ombre (croissant sombre) + reflet
		circle(planet, size * 0.62, size * 0.6, size * 0.9, size * 0.9, a, 0.55, 2)
		circle(planet, size * 0.3, size * 0.28, size * 0.22, size * 0.16, WHITE, 0.4, 3)
		if index % 2 == 0 then
			local band = box(holder, 0, 0, size * 1.8, 5 * u, color:Lerp(WHITE, 0.5), 0.15, 3)
			band.AnchorPoint = Vector2.new(0.5, 0.5)
			band.Position = UDim2.fromOffset(x, cy + size * 0.05)
			band.Rotation = -16
			roundify(band)
		end
		sparkle(holder, x + step * 0.45, cy - step * 0.25, 16 * u, WHITE, 0.1, 2)
		-- étoile filante
		if index % 3 == 1 then
			local tail = box(holder, 0, 0, 90 * u, 3 * u, WHITE, 0.2, 2)
			tail.AnchorPoint = Vector2.new(1, 0.5)
			tail.Position = UDim2.fromOffset(x + step * 0.3, cy + step * 0.35)
			tail.Rotation = -24
			local fade = Instance.new("UIGradient")
			fade.Transparency = NumberSequence.new(1, 0)
			fade.Parent = tail
			roundify(tail)
		end
		x += step
		index += 1
	end
end

-- Grille néon : lignes lumineuses (B) + points aux croisements, lueur en bas
WALL.NeonGrid = function(holder, w, h, a, b, u)
	local cell = 46 * u
	local x = cell / 2
	while x < w do
		local line = box(holder, x, 0, 2 * u, h, b, 0.45)
		line.Size = UDim2.new(0, 2 * u, 1, 0)
		x += cell
	end
	local y = cell / 2
	local row = 0
	while y < h do
		local line = box(holder, 0, y, w, 2 * u, b, 0.45)
		line.Size = UDim2.new(1, 0, 0, 2 * u)
		if row % 2 == 1 then
			local cx = cell / 2 + math.floor(noise(row, 3) * (w / cell)) * cell
			circle(holder, cx, y, 10 * u, 10 * u, WHITE, 0.1, 2)
			circle(holder, cx, y, 22 * u, 22 * u, b, 0.6, 2)
		end
		y += cell
		row += 1
	end
	local glowBand = box(holder, 0, h * 0.55, w, h * 0.45, b, 0.4)
	glowBand.Size = UDim2.new(1, 0, 0.45, 0)
	local fade = Instance.new("UIGradient")
	fade.Rotation = 90
	fade.Transparency = NumberSequence.new(1, 0.55)
	fade.Parent = glowBand
	local _ = a
end

----------------------------------------------------------------------
-- Sols (perspective)
----------------------------------------------------------------------

type Row = { Y: number, H: number, K: number }

-- Rangées de plus en plus hautes vers l'avant. K = hauteur / hauteur de la rangée avant.
local function perspectiveRows(h: number, count: number, ratio: number): { Row }
	local rows = {}
	local total = 0
	for index = 0, count - 1 do
		total += ratio ^ index
	end
	local first = h / total
	local y = 0
	local front = first * ratio ^ (count - 1)
	for index = 0, count - 1 do
		local height = first * ratio ^ index
		table.insert(rows, { Y = y, H = height, K = height / front })
		y += height
	end
	return rows
end

-- Largeur des cases d'une rangée : les colonnes s'écartent vers l'avant, mais
-- doucement (une perspective trop forte ferait des "escaliers" sur les côtés)
local function cellWidth(front: number, k: number): number
	return front * (0.62 + 0.38 * k)
end

-- Colonnes d'une rangée (bords gauche) : centrées sur le milieu, largeur `cellW`
local function columns(w: number, cellW: number, phase: number?): (number, number)
	local center = w / 2 + (phase or 0) * cellW
	local first = -math.ceil(center / cellW) - 1
	local last = math.ceil((w - center) / cellW) + 1
	return first, last
end

local FLOOR: { [string]: (holder: Frame, w: number, h: number, a: Color3, b: Color3, u: number) -> () } = {}

-- Uni : quelques reflets doux en perspective
FLOOR.Plain = function(holder, w, h, a, b, u)
	local rows = perspectiveRows(h, 5, 1.3)
	for index, row in ipairs(rows) do
		if index % 2 == 0 then
			box(holder, 0, row.Y, w, row.H, b, 0.55)
		end
	end
	for index = 1, 4 do
		local cx = w * (index / 5)
		circle(holder, cx, h * 0.55, 110 * u, 18 * u, a:Lerp(WHITE, 0.6), 0.55)
	end
end

-- Damier en perspective
FLOOR.Checker = function(holder, w, h, _a, b, u)
	local rows = perspectiveRows(h, 7, 1.17)
	local frontW = rows[#rows].H * 1.6
	for index, row in ipairs(rows) do
		local cellW = cellWidth(frontW, row.K)
		local center = w / 2
		local first, last = columns(w, cellW)
		for j = first, last do
			if (index + j) % 2 == 0 then
				box(holder, center + j * cellW, row.Y, cellW, row.H + 0.5, b)
			end
		end
	end
	-- Léger reflet
	box(holder, 0, 0, w, h * 0.35, WHITE, 0.88)
	local _ = u
end

-- Parquet de planches (joints décalés d'une rangée à l'autre)
FLOOR.Wood = function(holder, w, h, a, b, u)
	local rows = perspectiveRows(h, 6, 1.2)
	local frontL = rows[#rows].H * 4.2
	local seam = b:Lerp(BLACK, 0.2)
	for index, row in ipairs(rows) do
		local length = cellWidth(frontL, row.K)
		local phase = noise(index, 5)
		local first, last = columns(w, length, phase)
		local center = w / 2 + phase * length
		for j = first, last do
			local x = center + j * length
			if (j + index) % 2 == 0 then
				box(holder, x, row.Y, length, row.H, b, 0.5)
			end
			box(holder, x, row.Y, math.max(1, 2 * u * row.K + 0.6), row.H, seam, 0.25)
			if noise(j, index) > 0.6 then
				box(holder, x + length * 0.2, row.Y + row.H * 0.45, length * 0.35, math.max(1, 1.2 * u), a:Lerp(b, 0.8), 0.45)
			end
		end
		box(holder, 0, row.Y, w, math.max(1, 2 * u * row.K + 0.4), seam, 0.3)
	end
end

-- Carrelage (joints couleur B)
FLOOR.Tiles = function(holder, w, h, a, b, u)
	local rows = perspectiveRows(h, 6, 1.2)
	local frontW = rows[#rows].H * 1.5
	for index, row in ipairs(rows) do
		local cellW = cellWidth(frontW, row.K)
		local grout = math.max(1, 3 * u * row.K + 0.5)
		local first, last = columns(w, cellW)
		local center = w / 2
		for j = first, last do
			local x = center + j * cellW
			box(holder, x - grout / 2, row.Y, grout, row.H, b)
			if (index + j) % 3 == 0 then
				-- Reflet dans le coin de quelques carreaux
				box(holder, x + cellW * 0.12, row.Y + row.H * 0.15, cellW * 0.22, math.max(1, row.H * 0.1), WHITE, 0.45)
			end
		end
		box(holder, 0, row.Y, w, grout, b)
	end
	local _ = a
end

-- Moquette : bandes douces + petites touffes
FLOOR.Carpet = function(holder, w, h, a, b, u)
	local rows = perspectiveRows(h, 9, 1.12)
	for index, row in ipairs(rows) do
		if index % 2 == 0 then
			box(holder, 0, row.Y, w, row.H, b, 0.35)
		end
		if index % 2 == 1 then
			local step = 90 * u * row.K + 30 * u
			local x = noise(index, 9) * step
			while x < w do
				local size = (3 + 4 * row.K) * u
				circle(holder, x, row.Y + row.H * 0.5, size * 1.8, size, a:Lerp(WHITE, 0.45), 0.35)
				x += step * (0.8 + noise(x, index) * 0.6)
			end
		end
	end
end

-- Marbre : grandes dalles + veines fines (tournées, loin des bords)
FLOOR.Marble = function(holder, w, h, a, b, u)
	local rows = perspectiveRows(h, 4, 1.3)
	local frontW = rows[#rows].H * 2
	local vein = b:Lerp(BLACK, 0.12)
	for index, row in ipairs(rows) do
		local cellW = cellWidth(frontW, row.K)
		local first, last = columns(w, cellW)
		local center = w / 2
		for j = first, last do
			local x = center + j * cellW
			if (index + j) % 2 == 0 then
				box(holder, x, row.Y, cellW, row.H, b, 0.7)
			end
			box(holder, x, row.Y, math.max(1, 1.5 * u), row.H, vein, 0.45)
			local n = noise(j + 11, index)
			if x > 0 and x + cellW < w then
				local length = cellW * (0.35 + 0.3 * n)
				local veinFrame = box(holder, 0, 0, length, math.max(1, 1.4 * u), vein, 0.35)
				veinFrame.AnchorPoint = Vector2.new(0.5, 0.5)
				veinFrame.Position = UDim2.fromOffset(x + cellW * (0.35 + 0.3 * n), row.Y + row.H * (0.35 + 0.3 * noise(index, j)))
				veinFrame.Rotation = (n - 0.5) * 50 * row.K
			end
		end
		box(holder, 0, row.Y, w, math.max(1, 1.5 * u), vein, 0.45)
	end
	box(holder, 0, 0, w, h * 0.3, a:Lerp(WHITE, 0.8), 0.6)
end

-- Parquet "bâtons rompus" : blocs de 2 lames, alternés horizontal / vertical
FLOOR.Herringbone = function(holder, w, h, a, b, u)
	local rows = perspectiveRows(h, 6, 1.2)
	local frontW = rows[#rows].H * 1.8
	local seam = b:Lerp(BLACK, 0.25)
	local alt = a:Lerp(b, 0.55)
	for index, row in ipairs(rows) do
		local cellW = cellWidth(frontW, row.K)
		local gap = math.max(1, 1.5 * u * row.K + 0.4)
		local first, last = columns(w, cellW)
		local center = w / 2
		for j = first, last do
			local x = center + j * cellW
			local horizontal = (index + j) % 2 == 0
			local cell = box(holder, x + gap / 2, row.Y + gap / 2, cellW - gap, row.H - gap, horizontal and a or alt)
			if horizontal then
				box(cell, 0, (row.H - gap) / 2 - gap / 2, cellW - gap, gap, seam, 0.3)
			else
				box(cell, (cellW - gap) / 2 - gap / 2, 0, gap, row.H - gap, seam, 0.3)
			end
		end
	end
	local _ = u
end

-- (v9.1) Terrazzo : éclats de couleurs (plus gros vers l'avant)
FLOOR.Terrazzo = function(holder, w, h, a, b, u)
	local rows = perspectiveRows(h, 7, 1.16)
	local chips = { b, b:Lerp(WHITE, 0.4), Color3.fromRGB(255, 214, 120), Color3.fromRGB(150, 206, 240), b:Lerp(BLACK, 0.15) }
	for index, row in ipairs(rows) do
		local step = (38 + 30 * row.K) * u
		local x = noise(index, 3) * step
		while x < w do
			local n = noise(x, index)
			local size = (4 + 7 * row.K * (0.5 + n)) * u
			local chip = circle(holder, x, row.Y + row.H * (0.2 + 0.6 * noise(index, x)), size * 1.5, size, chips[math.floor(n * #chips) % #chips + 1], 0.05)
			chip.Rotation = (n - 0.5) * 80
			x += step * (0.6 + n * 0.8)
		end
	end
	box(holder, 0, 0, w, h * 0.3, a:Lerp(WHITE, 0.7), 0.6)
end

-- (v9.1) Mosaïque : petits carreaux en nuances (joints clairs)
FLOOR.Mosaic = function(holder, w, h, a, b, u)
	local rows = perspectiveRows(h, 9, 1.12)
	local frontW = rows[#rows].H * 1.1
	for index, row in ipairs(rows) do
		local cellW = cellWidth(frontW, row.K)
		local gap = math.max(1, 2 * u * row.K)
		local first, last = columns(w, cellW)
		local center = w / 2
		for j = first, last do
			local n = noise(j + 5, index)
			if n > 0.3 then
				local tone = a:Lerp(b, 0.35 + n * 0.65)
				if n > 0.93 then
					tone = WHITE
				end
				box(holder, center + j * cellW + gap / 2, row.Y + gap / 2, cellW - gap, row.H - gap, tone, 0)
			end
		end
	end
end

-- (v9.1) Gazon d'intérieur : bandes tondues + touffes et petites fleurs
FLOOR.Grass = function(holder, w, h, a, b, u)
	local rows = perspectiveRows(h, 8, 1.14)
	for index, row in ipairs(rows) do
		if index % 2 == 0 then
			box(holder, 0, row.Y, w, row.H, b, 0.45)
		end
		local step = (26 + 26 * row.K) * u
		local x = noise(index, 11) * step
		while x < w do
			local n = noise(x, index + 4)
			local tuft = (3 + 5 * row.K) * u
			local blade = box(holder, x, row.Y + row.H * 0.5 - tuft, math.max(1, 2 * u * row.K), tuft * 1.6, b:Lerp(BLACK, 0.18), 0.1)
			blade.Rotation = (n - 0.5) * 40
			if n > 0.86 then
				local petal = (4 + 4 * row.K) * u
				circle(holder, x + 6 * u, row.Y + row.H * 0.4, petal, petal, n > 0.93 and Color3.fromRGB(255, 190, 214) or WHITE, 0)
				circle(holder, x + 6 * u, row.Y + row.H * 0.4, petal * 0.4, petal * 0.4, Color3.fromRGB(255, 214, 110), 0)
			end
			x += step * (0.6 + n * 0.8)
		end
	end
	local _ = a
end

-- (v9.1) Nuages moelleux (sol) : gros nuages blancs en perspective
FLOOR.Clouds = function(holder, w, h, a, b, u)
	local rows = perspectiveRows(h, 4, 1.35)
	for index, row in ipairs(rows) do
		local width = (90 + 80 * row.K) * u
		local x = (index % 2) * width / 2 - width * 0.3
		while x < w + width do
			local n = noise(x, index)
			cloud(holder, x, row.Y + row.H * 0.95, width * (0.8 + n * 0.3), b, 0.1 + n * 0.2)
			x += width * 1.1
		end
	end
	local _ = a
end

-- (v9.1) Moquette étoilée : fond sombre (A) + étoiles et petits points (B)
FLOOR.Starry = function(holder, w, h, a, b, u)
	local rows = perspectiveRows(h, 7, 1.16)
	for index, row in ipairs(rows) do
		if index % 2 == 0 then
			box(holder, 0, row.Y, w, row.H, a:Lerp(WHITE, 0.08), 0.3)
		end
		local step = (50 + 50 * row.K) * u
		local x = noise(index, 2) * step
		while x < w do
			local n = noise(x, index + 9)
			if n > 0.45 then
				sparkle(holder, x, row.Y + row.H * 0.5, (6 + 10 * row.K * n) * u, b, 0.1)
			else
				circle(holder, x, row.Y + row.H * 0.5, (2 + 2 * row.K) * u, (2 + 2 * row.K) * u, b, 0.3)
			end
			x += step * (0.5 + n * 0.8)
		end
	end
end

----------------------------------------------------------------------
-- (v9.2) Sols "cool" : béton de skatepark, terrain de basket, pelouse de
-- foot, tôle à damier, route, roche de lave
----------------------------------------------------------------------

-- Béton : dalles (joints en perspective), mouchetures, traces de roues
FLOOR.Concrete = function(holder, w, h, a, b, u)
	local rows = perspectiveRows(h, 4, 1.3)
	local frontW = rows[#rows].H * 2.2
	for index, row in ipairs(rows) do
		local cellW = cellWidth(frontW, row.K)
		local first, last = columns(w, cellW, 0.5)
		local center = w / 2 + 0.5 * cellW
		for j = first, last do
			box(holder, center + j * cellW, row.Y, math.max(1, 2 * u * row.K), row.H, b, 0.35)
			if noise(j, index) > 0.7 then
				circle(holder, center + (j + 0.5) * cellW, row.Y + row.H * 0.5, cellW * 0.5, row.H * 0.5, b, 0.75)
			end
		end
		box(holder, 0, row.Y, w, math.max(1, 2 * u * row.K), b, 0.35)
		local step = (30 + 30 * row.K) * u
		local x = noise(index, 6) * step
		while x < w do
			local s = (1.5 + 1.5 * row.K) * u
			circle(holder, x, row.Y + row.H * noise(x, index), s, s, b:Lerp(BLACK, 0.2), 0.4)
			x += step * (0.5 + noise(x, 2))
		end
	end
	-- traces de roues de skate
	for index = 0, 1 do
		local trail = box(holder, w * (0.15 + index * 0.4), h * (0.5 + index * 0.2), w * 0.3, 2 * u, b:Lerp(BLACK, 0.3), 0.6)
		trail.Rotation = -6 + index * 10
		roundify(trail)
	end
end

-- Terrain de basket : parquet clair + lignes peintes (B) + raquette colorée
FLOOR.Court = function(holder, w, h, a, b, u)
	local rows = perspectiveRows(h, 7, 1.16)
	local frontL = rows[#rows].H * 5
	local seam = a:Lerp(BLACK, 0.18)
	for index, row in ipairs(rows) do
		local length = cellWidth(frontL, row.K)
		local phase = noise(index, 8)
		local first, last = columns(w, length, phase)
		local center = w / 2 + phase * length
		for j = first, last do
			local x = center + j * length
			if (j + index) % 2 == 0 then
				box(holder, x, row.Y, length, row.H, a:Lerp(WHITE, 0.12), 0.4)
			end
			box(holder, x, row.Y, math.max(1, 1.5 * u * row.K), row.H, seam, 0.4)
		end
		box(holder, 0, row.Y, w, math.max(1, 1.2 * u * row.K), seam, 0.45)
	end
	local thick = math.max(2, 4 * u)
	-- ligne de fond, ligne médiane, rond central, raquette
	local back = box(holder, 0, h * 0.14, w, thick, b, 0.05, 3)
	back.Size = UDim2.new(1, 0, 0, thick)
	box(holder, w / 2 - thick / 2, h * 0.14, thick, h * 0.86, b, 0.05, 3)
	local paint = box(holder, w / 2 - w * 0.13, h * 0.14, w * 0.26, h * 0.34, Color3.fromRGB(230, 90, 70), 0.25, 2)
	local _ = paint
	ring(holder, w / 2, h * 0.48, w * 0.2, h * 0.24, b, thick, 0.05, 3)
	ring(holder, w / 2, h * 0.14, w * 0.7, h * 1.3, b, thick, 0.1, 3)
end

-- Pelouse de foot : bandes tondues (clair / foncé) + lignes blanches
FLOOR.Turf = function(holder, w, h, a, b, u)
	local rows = perspectiveRows(h, 6, 1.2)
	local frontW = rows[#rows].H * 2.4
	for index, row in ipairs(rows) do
		local cellW = cellWidth(frontW, row.K)
		local first, last = columns(w, cellW)
		local center = w / 2
		for j = first, last do
			if j % 2 == 0 then
				box(holder, center + j * cellW, row.Y, cellW, row.H + 0.5, b, 0.2)
			end
		end
		local step = (20 + 24 * row.K) * u
		local x = noise(index, 13) * step
		while x < w do
			local tuft = (2 + 4 * row.K) * u
			local blade = box(holder, x, row.Y + row.H * 0.4, math.max(1, 1.6 * u * row.K), tuft * 1.5, b:Lerp(BLACK, 0.2), 0.3)
			blade.Rotation = (noise(x, index) - 0.5) * 40
			x += step * (0.6 + noise(x, index + 3) * 0.8)
		end
	end
	local thick = math.max(2, 4 * u)
	local line = box(holder, 0, h * 0.2, w, thick, WHITE, 0.05, 3)
	line.Size = UDim2.new(1, 0, 0, thick)
	box(holder, w / 2 - thick / 2, h * 0.2, thick, h * 0.8, WHITE, 0.05, 3)
	ring(holder, w / 2, h * 0.58, w * 0.24, h * 0.44, WHITE, thick, 0.05, 3)
	circle(holder, w / 2, h * 0.58, 8 * u, 5 * u, WHITE, 0, 3)
	local _ = a
end

-- Tôle à damier (métal) : petits reliefs en losange alternés, reflets
FLOOR.TreadPlate = function(holder, w, h, a, b, u)
	local rows = perspectiveRows(h, 9, 1.1)
	local frontW = rows[#rows].H * 1.3
	for index, row in ipairs(rows) do
		local cellW = cellWidth(frontW, row.K)
		local first, last = columns(w, cellW, (index % 2) * 0.5)
		local center = w / 2 + (index % 2) * 0.5 * cellW
		for j = first, last do
			local dash = box(holder, 0, 0, cellW * 0.55, math.max(2, row.H * 0.2), b, 0.1)
			dash.AnchorPoint = Vector2.new(0.5, 0.5)
			dash.Position = UDim2.fromOffset(center + (j + 0.5) * cellW, row.Y + row.H * 0.5)
			dash.Rotation = ((j + index) % 2 == 0) and 28 or -28
			roundify(dash)
		end
	end
	box(holder, 0, 0, w, h * 0.35, WHITE, 0.8)
	local _ = a
	local _u = u
end

-- Route : asphalte moucheté, bords blancs, tirets jaunes (B), passage piéton
FLOOR.Road = function(holder, w, h, a, b, u)
	local rows = perspectiveRows(h, 7, 1.15)
	for index, row in ipairs(rows) do
		local step = (26 + 26 * row.K) * u
		local x = noise(index, 17) * step
		while x < w do
			local s = (1.5 + 2 * row.K) * u
			circle(holder, x, row.Y + row.H * noise(x, index + 1), s, s, index % 2 == 0 and a:Lerp(WHITE, 0.25) or a:Lerp(BLACK, 0.25), 0.3)
			x += step * (0.5 + noise(x, index))
		end
	end
	local thick = math.max(2, 4 * u)
	for _, y in ipairs({ h * 0.1, h * 0.9 }) do
		local edge = box(holder, 0, y, w, thick * (y > h / 2 and 1.6 or 1), WHITE, 0.1, 3)
		edge.Size = UDim2.new(1, 0, 0, thick * (y > h / 2 and 1.6 or 1))
	end
	-- tirets au milieu (plus grands vers l'avant : rangée centrale)
	local dashW = 60 * u
	local x = dashW * 0.3
	while x < w do
		box(holder, x, h * 0.48, dashW, thick * 1.3, b, 0.05, 3)
		x += dashW * 2
	end
	-- passage piéton (bandes verticales qui s'élargissent vers l'avant)
	local cx = w * 0.78
	for index = -3, 3 do
		local top = h * 0.12
		local bar = box(holder, cx + index * 22 * u, top, 12 * u, h * 0.78 - top + h * 0.1, WHITE, 0.2, 2)
		bar.Rotation = index * 2
	end
end

-- Roche de lave : plaques sombres, fissures incandescentes (B) + lueurs
FLOOR.Lava = function(holder, w, h, a, b, u)
	local rows = perspectiveRows(h, 5, 1.25)
	for index, row in ipairs(rows) do
		local cellW = (80 + 90 * row.K) * u
		local x = noise(index, 21) * cellW - cellW
		while x < w + cellW do
			local n = noise(x, index)
			local rock = circle(holder, x + cellW / 2, row.Y + row.H / 2, cellW * 0.92, row.H * 0.9, a:Lerp(WHITE, 0.08 + n * 0.08), 0, 2)
			rock.Rotation = (n - 0.5) * 10
			-- fissure lumineuse entre deux plaques
			local crack = box(holder, x + cellW - 2 * u, row.Y + row.H * 0.1, math.max(2, 3 * u * row.K), row.H * 0.8, b, 0.05, 1)
			crack.Rotation = (n - 0.5) * 30
			if n > 0.6 then
				circle(holder, x + cellW, row.Y + row.H * 0.5, cellW * 0.4, row.H * 0.7, b, 0.7, 1)
			end
			x += cellW
		end
		box(holder, 0, row.Y, w, math.max(2, 2.5 * u * row.K), b, 0.25, 1)
	end
end

----------------------------------------------------------------------
-- API
----------------------------------------------------------------------

local function build(set, container: GuiObject, width: number, height: number, style: Style?, unit: number?)
	local holder = clear(container)
	local u = unit or 1
	if style then
		container.BackgroundColor3 = style.A
		local painter = set[style.Pattern] or set.Plain
		local ok, err = pcall(painter, holder, width, height, style.A, style.B, u)
		if not ok then
			warn("[HousePatterns] Motif " .. tostring(style.Pattern) .. " : " .. tostring(err))
		end
	end
	holder.Parent = container
end

-- Papier peint dans `container` (taille width x height, px de maquette)
function HousePatterns.BuildWall(container: GuiObject, width: number, height: number, style: Style?, unit: number?)
	build(WALL, container, width, height, style, unit)
end

-- Sol en perspective dans `container`
function HousePatterns.BuildFloor(container: GuiObject, width: number, height: number, style: Style?, unit: number?)
	build(FLOOR, container, width, height, style, unit)
end

-- Formes réutilisées par la pièce (détails dessinés à la main)
HousePatterns.Box = box
HousePatterns.Circle = circle
HousePatterns.Heart = heart
HousePatterns.Sparkle = sparkle
HousePatterns.Cloud = cloud
HousePatterns.Diamond = diamond
HousePatterns.Round = roundify

return HousePatterns
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">HousePets</string>
              <string name="Source"><![CDATA[--[[
	HousePets (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > HousePets

	Les animaux posés dans une pièce (catégorie "Pets") VIVENT quand on ne
	décore pas : ils sortent de chez eux (l'endroit où le joueur les a posés
	= leur "maison" : coquille, panier, perchoir...), se promènent sur le
	sol de la pièce, s'arrêtent, s'assoient, font la sieste, jouent, et
	se servent de leurs affaires :
	  - dorment dans le coussin / la niche (ils entrent dedans !) / en haut
	    de l'arbre à chat ou sur un lit, mangent à la gamelle, boivent à la
	    fontaine, jouent avec le panier de jouets, se font les griffes sur
	    le griffoir, se perchent sur la cage (oiseaux) ;
	  - marche qui rebondit, sauts pour monter sur les meubles, vol pour
	    le perroquet et le dragon, regard dans le sens de la marche (dessin
	    retourné, HouseArt.Mirror), petites bulles 💤 ❤️ 🍖 💧 🎾 ✨ 🎵 ;
	  - profondeur : l'animal passe devant / derrière les meubles selon sa
	    position (même ordre que l'éditeur) ;
	  - toucher un animal = câlin (❤️ + petit saut).
	Visuel seulement : rien n'est sauvegardé, aucun appel au serveur.
	Pause quand la pièce n'est pas affichée (l'éditeur n'appelle Update que
	dans la vue pièce) ; en mode édition, chacun rentre chez soi.
	Les dessins (Art/Pets) rangent l'animal dans des groupes "Pet*" : le
	reste du dessin (sa maison) reste en place pendant sa promenade.
]]

local Client = script.Parent.Parent.Parent
local UIUtil = require(Client.UIUtil)
local Effects = require(Client.Effects)
local Interface = require(Client.Interface)
local SoundManager = require(Client.SoundManager)
local HouseCommon = require(script.Parent.HouseCommon)
local HouseArt = require(script.Parent.HouseArt)
local HouseTints = require(script.Parent.HouseTints)
local HouseSurfaces = require(script.Parent.HouseSurfaces)

type Placed = HouseCommon.Placed
type Item = HouseCommon.Item

local HousePets = {}

local MAX_ACTORS = 10 -- animaux vivants au plus par pièce
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local C = HouseCommon.Colors
local random = Random.new()

-- Comportement de chaque animal :
--   Move : "Walk" | "Hop" | "Crawl" | "Fly" ; Speed = px de maquette / s
--   Anchor : ses pieds dans la boîte 100 x 100 du dessin
--   Native : sens où regarde le dessin (1 = droite, -1 = gauche)
--   Likes : envie de chaque activité ; Home : envie de rentrer chez lui
--   Climb : grimpe (arbre à chat, lits) ; Bird : oiseau (cage)
type Species = {
	Move: string,
	Speed: number,
	Anchor: Vector2,
	Native: number,
	Likes: { [string]: number },
	Home: number,
	Climb: boolean?,
	Bird: boolean?,
	Altitude: number?, -- vol : hauteur en px de maquette
	Rest: NumberRange?, -- durée d'une pause à la maison
	Curl: number?, -- pose "roulée en boule" (chat) : décalage vers le bas
}

local SPECIES: { [string]: Species } = {
	Chick = { Move = "Hop", Speed = 34, Anchor = Vector2.new(50, 88), Native = 1, Home = 1.4,
		Likes = { Eat = 2.5, Drink = 1.5, Play = 1.5, Sleep = 1 } },
	SleepyCat = { Move = "Walk", Speed = 40, Anchor = Vector2.new(50, 98), Native = 1, Home = 1.6, Climb = true,
		Rest = NumberRange.new(10, 22), Curl = 24,
		Likes = { Sleep = 3, Scratch = 2.2, Perch = 2, Sit = 1.8, Eat = 1.2, Drink = 1, Play = 1, Enter = 1.2 } },
	Turtle = { Move = "Crawl", Speed = 11, Anchor = Vector2.new(46, 96), Native = 1, Home = 0.8,
		Likes = { Eat = 2.5, Drink = 2, Sleep = 0.6 } },
	Puppy = { Move = "Walk", Speed = 72, Anchor = Vector2.new(50, 98), Native = -1, Home = 0.6,
		Likes = { Enter = 2, Sleep = 1.4, Eat = 2, Drink = 1.5, Play = 3 } },
	Bunny = { Move = "Hop", Speed = 56, Anchor = Vector2.new(50, 98), Native = -1, Home = 0.8,
		Likes = { Eat = 2.5, Drink = 1.5, Sleep = 1.4, Play = 1.5, Enter = 0.8 } },
	Fox = { Move = "Walk", Speed = 60, Anchor = Vector2.new(46, 98), Native = -1, Home = 0.8, Climb = true,
		Likes = { Sleep = 2, Enter = 1.6, Play = 2, Eat = 1.5, Drink = 1, Perch = 0.6 } },
	Parrot = { Move = "Fly", Speed = 90, Anchor = Vector2.new(42, 42), Native = 1, Home = 1.5, Bird = true, Altitude = 44,
		Likes = { Perch = 3, Eat = 0.8, Drink = 0.6, Play = 0.6 } },
	Dragon = { Move = "Fly", Speed = 52, Anchor = Vector2.new(50, 98), Native = -1, Home = 1, Altitude = 22,
		Likes = { Perch = 1.4, Sleep = 1.5, Play = 2, Eat = 1 } },
	-- v9 : chaton (grimpe sur les lits, canapés, chaises...) et hérisson
	Kitten = { Move = "Walk", Speed = 46, Anchor = Vector2.new(52, 98), Native = 1, Home = 1.4, Climb = true,
		Rest = NumberRange.new(8, 18), Curl = 18,
		Likes = { Sleep = 2.6, Play = 2.4, Scratch = 1.6, Perch = 1.6, Sit = 1.6, Eat = 1.2, Drink = 1, Enter = 1 } },
	Hedgehog = { Move = "Walk", Speed = 24, Anchor = Vector2.new(46, 96), Native = -1, Home = 1.2,
		Likes = { Eat = 2.6, Drink = 1.6, Sleep = 1.6, Play = 1, Enter = 0.8 } },
	-- v9.1 : caneton (trottine), manchot (se dandine), chouette (vole, se perche)
	Duckling = { Move = "Hop", Speed = 36, Anchor = Vector2.new(46, 90), Native = -1, Home = 1.2,
		Likes = { Eat = 2.4, Drink = 2.2, Play = 1.4, Sleep = 1.2 } },
	Penguin = { Move = "Walk", Speed = 30, Anchor = Vector2.new(50, 92), Native = 1, Home = 1,
		Likes = { Eat = 2.4, Drink = 2, Play = 1.8, Sleep = 1.2, Sit = 1 } },
	Owl = { Move = "Fly", Speed = 60, Anchor = Vector2.new(50, 84), Native = 1, Home = 1.6, Bird = true, Altitude = 40,
		Rest = NumberRange.new(10, 20), Likes = { Perch = 3, Sleep = 2, Eat = 0.8 } },
}

local EMOTES: { [string]: { string } } = {
	Sleep = { "💤" },
	Enter = { "💤" },
	Eat = { "🍖", "😋" },
	Drink = { "💧" },
	Play = { "🎾", "✨" },
	Scratch = { "✨" },
	Perch = { "🎵", "❤️" },
	Sit = { "❤️" },
	Happy = { "❤️", "💕" },
	Idle = { "❤️", "✨", "🎵" },
}

export type Step = {
	K: string, -- "Walk" | "Jump" | "Fly" | "Act" | "Home"
	X: number?,
	Y: number?,
	Elev: Placed?, -- meuble sur lequel il arrive (en hauteur)
	Base: number?,
	Act: string?,
	Dur: number?,
	Face: number?,
	Z: number?, -- décalage de profondeur par rapport au meuble (-1 derrière, +1 devant)
	Target: Placed?,
	Key: string?,
}

type Actor = {
	Entry: Placed,
	Item: Item,
	Def: Species,
	Sticker: any,
	Parts: { GuiObject }, -- parties "animal" du dessin posé (cachées pendant la promenade)
	HasProps: boolean,
	Holder: Frame?,
	Body: Frame?,
	Shrink: UIScale?,
	Shadow: Frame?,
	Anims: { HouseArt.Anim },
	WalkPose: GuiObject?,
	CurlParts: { GuiObject },
	CanTilt: boolean,
	Mirrored: boolean,
	X: number,
	Y: number,
	Alt: number, -- vol : hauteur actuelle (px de boîte)
	Elev: Placed?,
	Base: number,
	Out: boolean,
	State: string,
	Timer: number,
	Plan: { Step },
	Current: Step?,
	From: Vector2?,
	Progress: number,
	Joy: number, -- saut de joie (câlin), secondes restantes
	Phase: number,
	Facing: number,
	Curled: boolean,
	ZTimer: number,
	Emote: Frame?,
	EmoteLabel: TextLabel?,
	EmoteScale: UIScale?,
	EmoteStroke: UIStroke?,
	EmoteT: number,
	EmoteEvery: number,
	Spot: string?, -- place occupée (clé)
	Hidden: boolean, -- entré dans la niche / la cachette
	HiddenOver: Placed?,
}

export type Pets = {
	Refresh: (layout: { Placed }, stickers: { [Placed]: any }) -> (),
	SetLive: (on: boolean) -> (),
	IsLive: () -> boolean,
	Update: (dt: number) -> (),
	Clear: () -> (),
	Count: () -> number,
	Poke: (entry: Placed) -> boolean,
}

local function isPetPart(object: Instance): boolean
	return object:IsA("GuiObject") and string.sub(object.Name, 1, 3) == "Pet"
end

-- Parties "animal" du dessin d'un autocollant ; (liste, a-t-il une maison ?)
local function stickerParts(sticker: any): ({ GuiObject }, boolean)
	local parts: { GuiObject } = {}
	local props = false
	local body = sticker and sticker.Body
	if not body then
		return parts, false
	end
	for _, child in ipairs(body:GetChildren()) do
		if child:IsA("GuiObject") then
			if isPetPart(child) then
				if child.Name ~= "PetWalk" then
					table.insert(parts, child)
				end
			elseif child.Name ~= "Emoji" and child.Name ~= "Glow" then
				props = true
			end
		end
	end
	return parts, props
end

function HousePets.Has(itemId: string): boolean
	return SPECIES[itemId] ~= nil
end

function HousePets.new(room: any): Pets
	local pets: Pets
	local actors: { [Placed]: Actor } = {}
	local layout: { Placed } = {}
	local stickers: { [Placed]: any } = {}
	local live = false
	local clock = 0
	local occupied: { [string]: Actor } = {}
	-- Profondeur : objets au sol (Y "effectif", ZIndex) et fond (murs, tapis)
	local floorZ: { { Y: number, Z: number } } = {}
	local baseZ = 10

	local function roomW(): number
		return math.max(1, room.Width)
	end
	local function roomH(): number
		return math.max(1, room.Height)
	end

	-- Bornes du sol (pieds)
	local function floorBounds(): (number, number)
		local minY = HouseCommon.ZoneBounds("Floor")
		return minY + 0.05, 0.965
	end

	local function clampFloor(actor: Actor, x: number, y: number): (number, number)
		local minY, maxY = floorBounds()
		local half = actor.Item.Size * actor.Entry.S * 0.3 / roomW()
		return math.clamp(x, math.max(0.07, half), math.min(0.93, 1 - half)), math.clamp(y, minY, maxY)
	end

	local function stickerZ(entry: Placed?): number
		local sticker = entry and stickers[entry]
		if sticker and sticker.Frame then
			return sticker.Frame.ZIndex
		end
		return baseZ
	end

	local function floorDepth(y: number): number
		local z = baseZ
		for _, info in ipairs(floorZ) do
			if info.Y <= y and info.Z + 1 > z then
				z = info.Z + 1
			end
		end
		return z
	end

	----------------------------------------------------------------------
	-- Construction d'un animal vivant
	----------------------------------------------------------------------

	local function showSticker(actor: Actor, visible: boolean)
		for _, part in ipairs(actor.Parts) do
			part.Visible = visible
		end
		local sticker = actor.Sticker
		if sticker and not actor.HasProps and sticker.Shadow then
			sticker.Shadow.Visible = visible
		end
	end

	local function setCurled(actor: Actor, curled: boolean)
		local walk = actor.WalkPose
		if not walk or actor.Curled == curled then
			return
		end
		actor.Curled = curled
		walk.Visible = not curled
		for _, part in ipairs(actor.CurlParts) do
			part.Visible = curled
		end
	end

	local function setFacing(actor: Actor, dir: number)
		if dir == 0 or dir == actor.Facing then
			return
		end
		actor.Facing = dir
		local body = actor.Body
		local want = dir ~= actor.Def.Native
		if body and want ~= actor.Mirrored then
			actor.Mirrored = want
			HouseArt.Mirror(body, actor.Anims, actor.Def.Anchor.X)
		end
	end

	local function emote(actor: Actor, text: string?)
		local frame = actor.Emote
		local label = actor.EmoteLabel
		if not frame or not label or not text then
			return
		end
		label.Text = text
		actor.EmoteT = 0
		frame.Visible = true
	end

	local function emoteFor(actor: Actor, act: string)
		local list = EMOTES[act]
		if list then
			emote(actor, list[random:NextInteger(1, #list)])
		end
	end

	local function build(actor: Actor)
		if actor.Holder then
			return
		end
		local def = actor.Def
		local holder = UIUtil.Create("Frame", {
			Name = "Pet_" .. actor.Item.Id,
			Size = UDim2.fromOffset(100, 100),
			AnchorPoint = Vector2.new(def.Anchor.X / 100, def.Anchor.Y / 100),
			BackgroundTransparency = 1,
			Visible = false,
			ZIndex = baseZ,
		})
		UIUtil.Create("UIScale", { Scale = actor.Item.Size * actor.Entry.S / 100, Parent = holder })
		local shadow = UIUtil.Create("Frame", {
			Name = "Shadow",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(def.Anchor.X, def.Anchor.Y - 2),
			Size = UDim2.fromOffset(62, 12),
			BackgroundColor3 = BLACK,
			BackgroundTransparency = 0.86,
			BorderSizePixel = 0,
			ZIndex = 1,
			Parent = holder,
		})
		UIUtil.Corner(shadow, UDim.new(1, 0))
		local body = UIUtil.Create("Frame", {
			Name = "Body",
			Size = UDim2.fromOffset(100, 100),
			AnchorPoint = Vector2.new(def.Anchor.X / 100, def.Anchor.Y / 100),
			Position = UDim2.fromOffset(def.Anchor.X, def.Anchor.Y),
			BackgroundTransparency = 1,
			ZIndex = 2,
			Parent = holder,
		})
		local _, anims = HouseArt.Paint(body, actor.Item, false)
		-- (v9.1) même couleur que l'autocollant posé
		if actor.Entry.C then
			HouseTints.Apply(body, actor.Entry.C)
		end
		-- (rétrécit vers ses pieds quand il entre dans la niche)
		local shrink = UIUtil.Create("UIScale", { Name = "Shrink", Parent = body })
		-- On ne garde que l'animal (pas sa coquille, son panier, son perchoir...)
		local canTilt = true
		for _, child in ipairs(body:GetChildren()) do
			if not isPetPart(child) then
				child:Destroy()
			end
		end
		local kept: { HouseArt.Anim } = {}
		for _, anim in ipairs(anims) do
			if anim.Object:IsDescendantOf(body) then
				table.insert(kept, anim)
			end
		end
		for _, object in ipairs(body:GetDescendants()) do
			if object:IsA("GuiObject") and object.ClipsDescendants then
				-- (Roblox ne découpe pas dans un cadre tourné : pas d'inclinaison)
				canTilt = false
			end
			if object.Name == "Tail" and object:IsA("GuiObject") then
				object.Visible = false
			end
		end
		local walk = body:FindFirstChild("PetWalk") :: GuiObject?
		local curl: { GuiObject } = {}
		if walk then
			walk.Visible = true
			for _, child in ipairs(body:GetChildren()) do
				if child:IsA("GuiObject") and child ~= walk then
					child.Visible = false
					table.insert(curl, child)
				end
			end
		end
		-- Zone de câlin
		local hit = UIUtil.Create("TextButton", {
			Name = "Hit",
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromOffset(def.Anchor.X, def.Anchor.Y),
			Size = UDim2.fromOffset(74, math.min(90, def.Anchor.Y)),
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Text = "",
			ZIndex = 5,
			Parent = holder,
		})
		-- Bulle d'émotion (calque au-dessus de la pièce, taille fixe)
		local bubble = UIUtil.Create("Frame", {
			Name = "PetEmote",
			AnchorPoint = Vector2.new(0.5, 1),
			Size = UDim2.fromOffset(34, 32),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.05,
			Visible = false,
			ZIndex = 30,
			Parent = room.Overlay,
		})
		UIUtil.Corner(bubble, UDim.new(1, 0))
		local stroke = UIUtil.Stroke(bubble, C.Pink, 2, 0.2)
		local bubbleScale = UIUtil.Create("UIScale", { Parent = bubble })
		local tailDot = UIUtil.Create("Frame", {
			Name = "Tip",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 4, 1, 3),
			Size = UDim2.fromOffset(8, 8),
			BackgroundColor3 = WHITE,
			ZIndex = 30,
			Parent = bubble,
		})
		UIUtil.Corner(tailDot, UDim.new(1, 0))
		local label = UIUtil.Create("TextLabel", {
			Name = "Label",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Font = Enum.Font.BuilderSansMedium,
			Text = "",
			TextSize = 20,
			TextColor3 = WHITE,
			ZIndex = 31,
			Parent = bubble,
		})
		actor.Holder = holder
		actor.Body = body
		actor.Shrink = shrink
		actor.Shadow = shadow
		actor.Anims = kept
		actor.WalkPose = walk
		actor.CurlParts = curl
		actor.Curled = false
		actor.CanTilt = canTilt
		actor.Mirrored = false
		actor.Facing = def.Native
		actor.Emote = bubble
		actor.EmoteLabel = label
		actor.EmoteScale = bubbleScale
		actor.EmoteStroke = stroke
		hit.Activated:Connect(function()
			if not live or not actor.Out or actor.Hidden then
				return
			end
			emoteFor(actor, "Happy")
			SoundManager.Play("Pop", 1.15 + random:NextNumber() * 0.2)
			local layer = Effects.GetLayer()
			if layer then
				local center = Interface.GetCanvasCenter(body)
				Effects.Burst(layer, UDim2.fromOffset(center.X, center.Y), C.Pink, 7)
			end
			-- Petit saut de joie (sans interrompre ce qu'il fait)
			actor.Joy = 0.45
			local current = actor.Current
			if current and current.K == "Act" and current.Act == "Sleep" then
				-- réveillé par un câlin
				actor.Timer = math.min(actor.Timer, 0.6)
			end
		end)
		holder.Parent = room.Items
	end

	local function destroyActor(actor: Actor)
		if actor.Spot then
			occupied[actor.Spot] = nil
			actor.Spot = nil
		end
		if actor.Holder then
			(actor.Holder :: Frame):Destroy()
		end
		if actor.Emote then
			(actor.Emote :: Frame):Destroy()
		end
		actor.Holder = nil
		actor.Body = nil
		actor.Emote = nil
		showSticker(actor, true)
	end

	----------------------------------------------------------------------
	-- Choix de la prochaine activité
	----------------------------------------------------------------------

	local function home(actor: Actor): (number, number, Placed?, number)
		local entry = actor.Entry
		local support = HouseSurfaces.SupportOf(entry, layout, roomW(), roomH())
		if support then
			return entry.X, entry.Y, support.Entry, support.Base
		end
		return entry.X, entry.Y, nil, entry.Y
	end

	-- Étapes pour aller en (x, y) ; elev = meuble en hauteur à l'arrivée
	local function route(actor: Actor, x: number, y: number, elev: Placed?, base: number): { Step }
		local steps: { Step } = {}
		if actor.Def.Move == "Fly" then
			table.insert(steps, { K = "Fly", X = x, Y = y, Elev = elev, Base = base })
			return steps
		end
		if actor.Elev then
			local fx, fy = clampFloor(actor, actor.X + (random:NextNumber() - 0.5) * 0.06, actor.Base + 0.02)
			table.insert(steps, { K = "Jump", X = fx, Y = fy })
		end
		if elev then
			local fx, fy = clampFloor(actor, x, base + 0.02)
			table.insert(steps, { K = "Walk", X = fx, Y = fy })
			table.insert(steps, { K = "Jump", X = x, Y = y, Elev = elev, Base = base })
		else
			table.insert(steps, { K = "Walk", X = x, Y = y })
		end
		return steps
	end

	local function chooseNext(actor: Actor)
		local def = actor.Def
		local options: { { W: number, Plan: { Step } } } = {}
		local function add(weight: number, plan: { Step })
			if weight > 0 then
				table.insert(options, { W = weight, Plan = plan })
			end
		end
		local minY, maxY = floorBounds()
		-- Promenade
		do
			local x = actor.X + (random:NextNumber() - 0.5) * 0.6
			local y = minY + random:NextNumber() * (maxY - minY)
			local fx, fy = clampFloor(actor, x, y)
			local plan = route(actor, fx, fy, nil, fy)
			table.insert(plan, { K = "Act", Act = random:NextNumber() < 0.5 and "Idle" or "Sit", Dur = 1.2 + random:NextNumber() * 2.5 })
			add(def.Move == "Fly" and 2 or 3, plan)
		end
		-- Petite pause sur place
		if not actor.Elev then
			add(1, { { K = "Act", Act = "Idle", Dur = 1.5 + random:NextNumber() * 2 } })
		end
		-- Retour à la maison
		do
			local hx, hy, elev, base = home(actor)
			local plan = route(actor, hx, hy, elev, base)
			table.insert(plan, { K = "Home" })
			add(def.Home, plan)
		end
		-- Affaires des animaux (gamelle, niche, arbre à chat...) et meubles
		for index, entry in ipairs(layout) do
			local item = HouseCommon.ItemsById[entry.I]
			local spots = HouseSurfaces.Spots(entry.I)
			if item and spots then
				for spotIndex, spot in ipairs(spots) do
					local like = def.Likes[spot.Act] or 0
					local key = tostring(index) .. ":" .. entry.I .. ":" .. spotIndex
					local allowed = like > 0 and (occupied[key] == nil or occupied[key] == actor)
					if spot.High and not (def.Climb or def.Move == "Fly") then
						allowed = false
					end
					if spot.Birds and not def.Bird then
						allowed = false
					end
					if spot.Act == "Enter" and def.Move == "Fly" then
						allowed = false
					end
					if allowed then
						local sx, sy = HouseSurfaces.BoxToRoom(entry, item, spot.X, spot.Y, roomW(), roomH())
						local side = actor.X < sx and -1 or 1
						local petW = actor.Item.Size * actor.Entry.S / roomW()
						local furnW = item.Size * entry.S / roomW()
						local x, y, zOffset, elev = sx, sy, 1, nil
						if spot.Place == "Behind" then
							x = sx + side * petW * 0.22
							y = entry.Y - 0.012
							zOffset = -1
						elseif spot.Place == "Beside" then
							x = sx + side * (furnW * 0.3 + petW * 0.3)
							y = entry.Y + 0.008
						elseif spot.High then
							elev = entry
						end
						if not elev then
							x, y = clampFloor(actor, x, y)
						end
						local plan = route(actor, x, y, elev, entry.Y)
						local duration = spot.Act == "Sleep" and (8 + random:NextNumber() * 8)
							or (spot.Act == "Enter" and (7 + random:NextNumber() * 7))
							or (3.5 + random:NextNumber() * 3)
						table.insert(plan, {
							K = "Act",
							Act = spot.Act,
							Dur = duration,
							Face = -side,
							Z = zOffset,
							Target = entry,
							Key = key,
						})
						add(like, plan)
					end
				end
			end
			-- Sieste sur un lit / perchoir sur un meuble
			if item and HouseSurfaces.Has(entry.I) and (def.Climb or def.Move == "Fly") then
				local act = def.Move == "Fly" and "Perch" or (HouseSurfaces.IsBed(entry.I) and "Sleep" or nil)
				local like = act and (def.Likes[act] or 0) * 0.5 or 0
				if act and like > 0 then
					for _, surface in ipairs(HouseSurfaces.Of(entry, roomW(), roomH())) do
						if surface.Y >= HouseSurfaces.MinY() - 0.1 and surface.R - surface.L > 0.03 then
							local x = surface.L + (surface.R - surface.L) * (0.25 + random:NextNumber() * 0.5)
							local plan = route(actor, x, surface.Y, entry, surface.Base)
							table.insert(plan, {
								K = "Act",
								Act = act,
								Dur = act == "Sleep" and (8 + random:NextNumber() * 7) or (3 + random:NextNumber() * 4),
								Z = 1,
								Target = entry,
							})
							add(like, plan)
						end
					end
				end
			end
		end
		-- Tirage pondéré
		local total = 0
		for _, option in ipairs(options) do
			total += option.W
		end
		local pick = random:NextNumber() * total
		for _, option in ipairs(options) do
			pick -= option.W
			if pick <= 0 then
				actor.Plan = option.Plan
				return
			end
		end
		actor.Plan = options[1] and options[1].Plan or {}
	end

	----------------------------------------------------------------------
	-- Sortir / rentrer
	----------------------------------------------------------------------

	local function goHome(actor: Actor, instant: boolean)
		if actor.Spot then
			occupied[actor.Spot] = nil
			actor.Spot = nil
		end
		actor.Out = false
		actor.Hidden = false
		actor.HiddenOver = nil
		actor.Plan = {}
		actor.Current = nil
		actor.State = "Home"
		local rest = actor.Def.Rest
		actor.Timer = instant and (0.6 + random:NextNumber() * 3)
			or (rest and (rest.Min + random:NextNumber() * (rest.Max - rest.Min)) or (4 + random:NextNumber() * 7))
		local x, y, elev, base = home(actor)
		actor.X, actor.Y, actor.Elev, actor.Base = x, y, elev, base
		actor.Alt = 0
		local holder = actor.Holder
		if holder then
			holder.Visible = false
		end
		if actor.Emote then
			(actor.Emote :: Frame).Visible = false
		end
		showSticker(actor, true)
	end

	local function leaveHome(actor: Actor)
		build(actor)
		local x, y, elev, base = home(actor)
		actor.X, actor.Y, actor.Elev, actor.Base = x, y, elev, base
		actor.Alt = 0
		actor.Out = true
		actor.Hidden = false
		setCurled(actor, false)
		showSticker(actor, false)
		local holder = actor.Holder :: Frame
		holder.Visible = true
		actor.State = "Plan"
		actor.Plan = {}
		actor.Current = nil
		chooseNext(actor)
		-- (une petite bulle en sortant, parfois)
		if random:NextNumber() < 0.4 then
			emoteFor(actor, "Idle")
		end
	end

	----------------------------------------------------------------------
	-- Mise à jour
	----------------------------------------------------------------------

	local function startStep(actor: Actor, step: Step)
		actor.Current = step
		actor.From = Vector2.new(actor.X, actor.Y)
		actor.Progress = 0
		actor.Timer = step.Dur or 0
		if step.K == "Act" then
			local act = step.Act or "Idle"
			if step.Face then
				setFacing(actor, step.Face :: number)
			end
			if step.Key then
				occupied[step.Key :: string] = actor
				actor.Spot = step.Key
			end
			if act == "Sleep" and actor.Def.Curl then
				setCurled(actor, true)
			end
			if act == "Enter" then
				actor.HiddenOver = step.Target
			end
			actor.EmoteEvery = 0.4
			if act ~= "Idle" or random:NextNumber() < 0.3 then
				emoteFor(actor, act)
			end
		elseif step.K == "Home" then
			goHome(actor, false)
		else
			local tx = step.X or actor.X
			if math.abs(tx - actor.X) > 0.004 then
				setFacing(actor, tx > actor.X and 1 or -1)
			end
		end
	end

	local function finishStep(actor: Actor)
		local step = actor.Current
		if step and step.K == "Act" then
			if actor.Spot then
				occupied[actor.Spot :: string] = nil
				actor.Spot = nil
			end
			setCurled(actor, false)
			if actor.Hidden then
				actor.Hidden = false
				actor.HiddenOver = nil
			end
		elseif step and (step.K == "Jump" or step.K == "Fly") then
			actor.Elev = step.Elev
			actor.Base = step.Base or (step.Y or actor.Y)
		end
		actor.Current = nil
	end

	local function moveTowards(actor: Actor, tx: number, ty: number, speed: number, dt: number): boolean
		local dx = (tx - actor.X) * roomW()
		local dy = (ty - actor.Y) * roomH()
		local distance = math.sqrt(dx * dx + dy * dy)
		local stepLength = speed * dt
		if distance <= stepLength or distance < 0.5 then
			actor.X, actor.Y = tx, ty
			return true
		end
		actor.X += dx / distance * stepLength / roomW()
		actor.Y += dy / distance * stepLength / roomH()
		return false
	end

	local function updateActor(actor: Actor, dt: number)
		if not actor.Out then
			actor.Timer -= dt
			if actor.Timer <= 0 and live then
				leaveHome(actor)
			end
			return
		end
		local holder = actor.Holder :: Frame
		local body = actor.Body :: Frame
		local shadow = actor.Shadow :: Frame
		local def = actor.Def
		local k = actor.Item.Size * actor.Entry.S / 100 -- px de maquette par unité de boîte
		if not actor.Current then
			if #actor.Plan == 0 then
				chooseNext(actor)
			end
			local nextStep = table.remove(actor.Plan, 1)
			if nextStep then
				startStep(actor, nextStep)
			end
			if not actor.Out then
				return
			end
		end
		local step = actor.Current
		local lift = 0 -- (px de boîte, vers le haut)
		local tilt = 0
		local speed = def.Speed
		local flying = def.Move == "Fly"
		local targetAlt = 0
		if step then
			local kind = step.K
			if kind == "Walk" then
				local tx, ty = step.X or actor.X, step.Y or actor.Y
				if def.Move == "Hop" then
					-- sauts de lapin : on avance pendant le saut, pause entre deux
					local cycle = 0.62
					local before = actor.Phase % cycle
					actor.Phase += dt
					local t = actor.Phase % cycle
					if t < 0.44 then
						local arrived = moveTowards(actor, tx, ty, speed * 1.45, dt)
						lift = math.sin(t / 0.44 * math.pi) * 13
						if arrived then
							finishStep(actor)
						end
					elseif before < 0.44 and moveTowards(actor, tx, ty, 0, dt) then
						finishStep(actor)
					end
				else
					actor.Phase += dt * (def.Move == "Crawl" and 5 or 9)
					lift = math.abs(math.sin(actor.Phase)) * (def.Move == "Crawl" and 1 or 4.5)
					tilt = def.Move == "Crawl" and 0 or math.sin(actor.Phase) * 5
					if moveTowards(actor, tx, ty, speed, dt) then
						finishStep(actor)
					end
				end
			elseif kind == "Fly" then
				local tx, ty = step.X or actor.X, step.Y or actor.Y
				actor.Phase += dt
				local arrived = moveTowards(actor, tx, ty, speed, dt)
				targetAlt = arrived and 0 or (def.Altitude or 30)
				-- (atterrissage en douceur)
				local remaining = math.abs(tx - actor.X) * roomW() + math.abs(ty - actor.Y) * roomH()
				if remaining < 40 then
					targetAlt = (def.Altitude or 30) * remaining / 40
				end
				tilt = math.sin(actor.Phase * 3) * 3
				if arrived and actor.Alt < 2 then
					finishStep(actor)
				end
			elseif kind == "Jump" then
				local from = actor.From or Vector2.new(actor.X, actor.Y)
				local tx, ty = step.X or actor.X, step.Y or actor.Y
				actor.Progress += dt / 0.55
				local t = math.min(1, actor.Progress)
				actor.X = from.X + (tx - from.X) * t
				actor.Y = from.Y + (ty - from.Y) * t
				local climb = math.max(0, (from.Y - ty) * roomH()) / k
				lift = math.sin(t * math.pi) * (18 + climb * 0.25) + (1 - t) * 0
				tilt = -actor.Facing * 8 * math.sin(t * math.pi)
				if t >= 1 then
					finishStep(actor)
				end
			elseif kind == "Act" then
				local act = step.Act or "Idle"
				actor.Timer -= dt
				actor.Phase += dt
				local t = actor.Phase
				if act == "Eat" or act == "Drink" then
					lift = -1.5 + math.abs(math.sin(t * 7)) * 1.5
					tilt = actor.Facing * (7 + math.sin(t * 7) * 3)
				elseif act == "Play" then
					local hop = (t % 0.7) / 0.7
					lift = math.sin(hop * math.pi) * 9
					if hop < dt / 0.7 and random:NextNumber() < 0.5 then
						setFacing(actor, -actor.Facing)
					end
				elseif act == "Scratch" then
					tilt = actor.Facing * 6 + math.sin(t * 22) * 4
					lift = 2 + math.sin(t * 22) * 1
				elseif act == "Sleep" then
					lift = def.Curl and -def.Curl or 0
					lift -= math.sin(t * 1.6) * 0.6
				elseif act == "Sit" or act == "Perch" or act == "Idle" then
					lift = 0
					if flying and not actor.Elev and act == "Idle" then
						targetAlt = (def.Altitude or 30) * 0.8
					end
					-- regarde autour de lui de temps en temps
					if random:NextNumber() < dt * 0.25 then
						setFacing(actor, -actor.Facing)
					end
				elseif act == "Enter" then
					-- disparaît dans la niche / la cachette
					actor.Progress += dt / 0.35
					if not actor.Hidden and actor.Progress >= 1 then
						actor.Hidden = true
					end
				end
				-- bulle répétée (💤...)
				actor.EmoteEvery -= dt
				if actor.EmoteEvery <= 0 then
					actor.EmoteEvery = (act == "Sleep" or act == "Enter") and 2.8 or 3.6
					if act == "Sleep" or act == "Enter" or act == "Eat" or act == "Drink" or act == "Play" then
						emoteFor(actor, act)
					end
				end
				if actor.Timer <= 0 then
					if act == "Enter" and actor.Hidden then
						-- ressort de la niche
						actor.Hidden = false
						actor.HiddenOver = nil
						actor.Progress = 0
						actor.Joy = 0.45
					end
					finishStep(actor)
				end
			end
		end
		-- Câlin : petit saut par-dessus le reste
		if actor.Joy > 0 then
			actor.Joy = math.max(0, actor.Joy - dt)
			lift += math.sin(actor.Joy / 0.45 * math.pi) * 10
		end
		-- Vol : hauteur qui suit la cible
		if flying then
			actor.Alt += (targetAlt - actor.Alt) * math.min(1, dt * 4)
			lift += actor.Alt + (actor.Alt > 3 and math.sin(clock * 4 + actor.X * 20) * 2.5 or 0)
		end
		-- Dessin
		holder.Position = UDim2.fromScale(actor.X, actor.Y)
		local hidden = actor.Hidden
		local current = actor.Current
		local entering = current and current.K == "Act" and current.Act == "Enter" and not hidden
		local shrink = 1
		if entering then
			shrink = math.max(0.05, 1 - math.clamp(actor.Progress, 0, 1) * 0.95)
		end
		if holder.Visible == hidden then
			holder.Visible = not hidden
		end
		body.Position = UDim2.fromOffset(def.Anchor.X, def.Anchor.Y - lift)
		body.Rotation = actor.CanTilt and tilt or 0
		local shrinkScale = actor.Shrink
		if shrinkScale and shrinkScale.Scale ~= shrink then
			shrinkScale.Scale = shrink
		end
		local altitude = math.max(0, lift)
		shadow.Visible = not (current and current.K == "Act" and current.Act == "Sleep" and def.Curl ~= nil)
		shadow.Size = UDim2.fromOffset(62 * math.clamp(1 - altitude / 70, 0.45, 1) * shrink, 12 * math.clamp(1 - altitude / 70, 0.45, 1) * shrink)
		shadow.BackgroundTransparency = 0.86 + math.clamp(altitude / 70, 0, 1) * 0.08
		-- Profondeur (quelques fois par seconde)
		actor.ZTimer -= dt
		if actor.ZTimer <= 0 then
			actor.ZTimer = 0.15
			local z
			local over = actor.Elev
			if current and current.K == "Act" and current.Target and current.Z then
				z = stickerZ(current.Target) + (current.Z :: number)
			elseif over then
				z = stickerZ(over) + 1
			elseif current and current.K == "Jump" and current.Elev then
				z = stickerZ(current.Elev) + 1
			else
				z = floorDepth(actor.Y)
			end
			if flying and actor.Alt > 10 then
				z = math.max(z, floorDepth(actor.Y + 0.02))
			end
			if holder.ZIndex ~= z then
				holder.ZIndex = z
			end
		end
		if #actor.Anims > 0 then
			HouseArt.Step(actor.Anims, clock)
		end
		-- Bulle d'émotion
		local bubble = actor.Emote
		if bubble and bubble.Visible then
			actor.EmoteT += dt
			local t = actor.EmoteT
			local headY = actor.Y * roomH() - (def.Anchor.Y - 6) * k - lift * k
			local anchorX = actor.X * roomW()
			local over = actor.HiddenOver
			if hidden and over then
				local item = HouseCommon.ItemsById[over.I]
				if item then
					headY = over.Y * roomH() - item.Size * over.S * 0.95
					anchorX = over.X * roomW()
				end
			end
			bubble.Position = UDim2.fromOffset(anchorX + 10, headY - math.min(t, 1.6) * 8)
			local scale = actor.EmoteScale :: UIScale
			scale.Scale = t < 0.18 and (0.3 + t / 0.18 * 0.8) or (t < 0.3 and 1.1 - (t - 0.18) / 0.12 * 0.1 or 1)
			local fade = math.clamp((t - 1.3) / 0.4, 0, 1)
			bubble.BackgroundTransparency = 0.05 + fade * 0.95
			local label = actor.EmoteLabel :: TextLabel
			label.TextTransparency = fade
			local stroke = actor.EmoteStroke :: UIStroke
			stroke.Transparency = 0.2 + fade * 0.8
			local tip = bubble:FindFirstChild("Tip") :: Frame?
			if tip then
				tip.BackgroundTransparency = bubble.BackgroundTransparency
			end
			if t >= 1.7 then
				bubble.Visible = false
			end
		end
	end

	----------------------------------------------------------------------
	-- API
	----------------------------------------------------------------------

	local function computeDepths()
		table.clear(floorZ)
		baseZ = 10
		for entry, sticker in pairs(stickers) do
			local item = HouseCommon.ItemsById[entry.I]
			local frame = sticker and sticker.Frame
			if item and frame then
				if item.Placement == "Wall" or sticker.Flat then
					baseZ = math.max(baseZ, frame.ZIndex + 1)
				else
					local support = HouseSurfaces.SupportOf(entry, layout, roomW(), roomH())
					local root = support and support.Base or entry.Y
					table.insert(floorZ, { Y = root, Z = frame.ZIndex })
				end
			end
		end
	end

	pets = {
		Refresh = function(newLayout: { Placed }, newStickers: { [Placed]: any })
			layout = newLayout
			stickers = newStickers
			local present: { [Placed]: boolean } = {}
			local count = 0
			for _, entry in ipairs(layout) do
				present[entry] = true
				local def = SPECIES[entry.I]
				local item = HouseCommon.ItemsById[entry.I]
				if def and item then
					local actor = actors[entry]
					if not actor and count < MAX_ACTORS then
						actor = {
							Entry = entry,
							Item = item,
							Def = def,
							Sticker = nil,
							Parts = {},
							HasProps = false,
							Holder = nil,
							Body = nil,
							Shrink = nil,
							Shadow = nil,
							Anims = {},
							WalkPose = nil,
							CurlParts = {},
							CanTilt = true,
							Mirrored = false,
							X = entry.X,
							Y = entry.Y,
							Alt = 0,
							Elev = nil,
							Base = entry.Y,
							Out = false,
							State = "Home",
							Timer = 0.5 + random:NextNumber() * 3,
							Plan = {},
							Current = nil,
							From = nil,
							Progress = 0,
							Joy = 0,
							Phase = random:NextNumber() * 3,
							Facing = def.Native,
							Curled = false,
							ZTimer = 0,
							Emote = nil,
							EmoteLabel = nil,
							EmoteScale = nil,
							EmoteStroke = nil,
							EmoteT = 0,
							EmoteEvery = 0,
							Spot = nil,
							Hidden = false,
							HiddenOver = nil,
						}
						actors[entry] = actor
					end
					if actor then
						count += 1
						local sticker = stickers[entry]
						if sticker ~= actor.Sticker then
							actor.Sticker = sticker
							actor.Parts, actor.HasProps = stickerParts(sticker)
							showSticker(actor, not actor.Out)
						end
					end
				end
			end
			for entry, actor in pairs(actors) do
				if not present[entry] then
					destroyActor(actor)
					actors[entry] = nil
				end
			end
			computeDepths()
		end,
		SetLive = function(on: boolean)
			if live == on then
				return
			end
			live = on
			for _, actor in pairs(actors) do
				if actor.Out or not on then
					goHome(actor, true)
				end
				if on then
					actor.Timer = 0.4 + random:NextNumber() * 2.5
				end
			end
			computeDepths()
		end,
		IsLive = function(): boolean
			return live
		end,
		Update = function(dt: number)
			if not live then
				return
			end
			clock += dt
			for _, actor in pairs(actors) do
				updateActor(actor, dt)
			end
		end,
		Clear = function()
			for entry, actor in pairs(actors) do
				destroyActor(actor)
				actors[entry] = nil
			end
			table.clear(occupied)
		end,
		-- Toucher un animal resté chez lui : il se réveille et sort (❤️)
		Poke = function(entry: Placed): boolean
			local actor = actors[entry]
			if not live or not actor or actor.Out then
				return false
			end
			leaveHome(actor)
			emoteFor(actor, "Happy")
			actor.Joy = 0.45
			return true
		end,
		Count = function(): number
			local count = 0
			for _ in pairs(actors) do
				count += 1
			end
			return count
		end,
	}
	return pets
end

return HousePets
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">HousePicker</string>
              <string name="Source"><![CDATA[--[[
	HousePicker (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > HousePicker

	Petites fenêtres de choix de la maison (par-dessus la fenêtre "🏠 Ma
	maison", fond assombri, clic à côté = fermer) :
	  - ShowRoomTypes : les 12 types de pièces en cartes (icône, nom,
	    préférés : catégories + vignettes d'objets, "✓ Actuel") -> achat
	    d'une pièce ou changement de type ;
	  - ShowRooms : les pièces de la maison (petite pièce dessinée, nom,
	    place "12/36", ✨ si l'objet y est préféré, "Pleine") -> "Envoyer
	    dans une autre pièce" ;
	  - ShowMenu : quelques gros boutons (menu "⋯" d'une pièce).
	Zones tactiles >= 44 px ; la grille s'adapte au téléphone.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local Interface = require(Client.Interface)
local SoundManager = require(Client.SoundManager)
local Locale = require(ReplicatedStorage.Shared.Locale)
local HouseCommon = require(script.Parent.HouseCommon)
local HouseArt = require(script.Parent.HouseArt)
local HouseMiniRoom = require(script.Parent.HouseMiniRoom)
local HouseButtons = require(script.Parent.HouseButtons)

type HouseData = HouseCommon.HouseData
type Item = HouseCommon.Item

local HousePicker = {}

local C = HouseCommon.Colors
local WHITE = Color3.new(1, 1, 1)

export type MenuButton = { Text: string, Color: Color3, OnClick: () -> () }

export type Picker = {
	Frame: Frame,
	ShowRoomTypes: (options: {
		Title: string,
		Subtitle: string,
		Current: string?,
		OnPick: (typeId: string) -> (),
	}) -> (),
	ShowRooms: (options: {
		Title: string,
		Subtitle: string,
		House: HouseData,
		ExcludeId: string?,
		Item: Item?,
		Counts: { [string]: number }?,
		OnPick: (roomId: string) -> (),
	}) -> (),
	ShowMenu: (options: { Title: string, Subtitle: string, Buttons: { MenuButton } }) -> (),
	Close: () -> (),
	IsOpen: () -> boolean,
}

function HousePicker.new(parent: Frame): Picker
	local picker: Picker
	local closeToken = 0

	local overlay = UIUtil.Create("Frame", {
		Name = "Picker",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 60,
		Parent = parent,
	})
	local dim = UIUtil.Create("TextButton", {
		Name = "Dim",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(40, 20, 50),
		BackgroundTransparency = 0.55,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 60,
		Parent = overlay,
	})
	UIUtil.Corner(dim, 20)
	local card = UIUtil.Create("Frame", {
		Name = "PickerCard",
		Size = UDim2.new(1, -24, 1, -16),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundColor3 = WHITE,
		ZIndex = 61,
		Parent = overlay,
	})
	UIUtil.Corner(card, 22)
	UIUtil.Stroke(card, C.Pink, 2.5, 0.1)
	UIUtil.Gradient(card, ColorSequence.new(WHITE, C.PinkMist), 90)
	-- Clic DANS la carte (zone vide, titre...) : ne ferme pas ; à côté : ferme
	UIUtil.SinkClicks(card)
	local sizeLimit = UIUtil.Create("UISizeConstraint", { MaxSize = Vector2.new(820, 480), Parent = card })
	local cardScale = UIUtil.Create("UIScale", { Parent = card })
	local title = UIUtil.Create("TextLabel", {
		Name = "Title",
		Size = UDim2.new(1, -80, 0, 30),
		Position = UDim2.fromOffset(18, 10),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = "",
		TextColor3 = C.Ink,
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 62,
		Parent = card,
	})
	local subtitle = UIUtil.Create("TextLabel", {
		Name = "Subtitle",
		Size = UDim2.new(1, -80, 0, 20),
		Position = UDim2.fromOffset(18, 40),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		Text = "",
		TextColor3 = Theme.Colors.TextDim,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 62,
		Parent = card,
	})
	-- ✕ commun du jeu (même look que les autres fenêtres), zone tactile agrandie
	local close: () -> ()
	local closeButton = UIUtil.CloseButton({
		Name = "PickerClose",
		Size = 42,
		Hitbox = 54,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 10),
		ZIndex = 63,
		Parent = card,
		OnClose = function()
			close()
		end,
	})
	HouseButtons.Tip(closeButton, function()
		return Locale.T("Close")
	end)
	local list = UIUtil.Create("ScrollingFrame", {
		Name = "List",
		Size = UDim2.new(1, -24, 1, -78),
		Position = UDim2.fromOffset(12, 68),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = C.Pink,
		ZIndex = 62,
		Parent = card,
	})
	UIUtil.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 4),
		PaddingRight = UDim.new(0, 8),
		PaddingTop = UDim.new(0, 4),
		PaddingBottom = UDim.new(0, 6),
		Parent = list,
	})
	local grid = UIUtil.Create("UIGridLayout", {
		CellPadding = UDim2.fromOffset(10, 10),
		CellSize = UDim2.new(0.25, -10, 0, 120),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = list,
	})

	local function clearList()
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
	end

	close = function()
		if not overlay.Visible then
			return
		end
		closeToken += 1
		local token = closeToken
		UIUtil.Tween(cardScale, 0.14, { Scale = 0.9 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(0.14, function()
			if token == closeToken then
				overlay.Visible = false
				clearList()
			end
		end)
	end

	-- rows : nombre de rangées (la fenêtre prend juste la hauteur utile)
	local function open(titleText: string, subtitleText: string, columns: number, cellHeight: number, rows: number, maxWidth: number?)
		closeToken += 1
		local height = 84 + rows * (cellHeight + 10) + 6
		card.Size = UDim2.new(1, -24, 0, height)
		clearList()
		title.Text = titleText
		subtitle.Text = subtitleText
		local phone = Interface.IsPhone()
		sizeLimit.MaxSize = Vector2.new(maxWidth or (phone and 900 or 820), 480)
		-- (plus haute que la place : elle défile, sans dépasser de la fenêtre)
		task.defer(function()
			local factor = Interface.Scale > 0 and Interface.Scale or 1
			local space = overlay.AbsoluteSize.Y / factor
			if space > 0 and height > space - 16 then
				card.Size = UDim2.new(1, -24, 1, -16)
			end
		end)
		grid.CellSize = UDim2.new(1 / columns, -10, 0, cellHeight)
		overlay.Visible = true
		cardScale.Scale = 0.85
		UIUtil.Tween(cardScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
		list.CanvasPosition = Vector2.zero
		SoundManager.Play("Open", 1.4)
	end

	-- Carte cliquable de la grille
	local function cell(order: number, color: Color3, enabled: boolean, onClick: () -> ()): TextButton
		local button = UIUtil.Create("TextButton", {
			Name = "Cell" .. order,
			BackgroundColor3 = color,
			AutoButtonColor = false,
			Text = "",
			LayoutOrder = order,
			ZIndex = 63,
			Parent = list,
		})
		UIUtil.Corner(button, 16)
		UIUtil.Stroke(button, enabled and C.Pink or Color3.fromRGB(200, 190, 200), 2, enabled and 0.25 or 0.4)
		UIUtil.Gradient(button, ColorSequence.new(WHITE, Color3.fromRGB(232, 232, 236)), 90)
		-- Reflet brillant en haut + petite lèvre plus foncée en bas (carte "bonbon")
		local gloss = UIUtil.Create("Frame", {
			Name = "Gloss",
			Position = UDim2.new(0, 6, 0, 3),
			Size = UDim2.new(1, -12, 0, 20),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.45,
			ZIndex = 63,
			Parent = button,
		})
		UIUtil.Corner(gloss, 10)
		UIUtil.Create("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(0.2, 1), Parent = gloss })
		local lip = UIUtil.Create("Frame", {
			Name = "Lip",
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, 0),
			Size = UDim2.new(1, -14, 0, 4),
			BackgroundColor3 = color:Lerp(C.Ink, 0.35),
			BackgroundTransparency = enabled and 0.55 or 0.8,
			ZIndex = 63,
			Parent = button,
		})
		UIUtil.Corner(lip, UDim.new(1, 0))
		if enabled then
			UIUtil.AnimateButton(button, 1.04, 0.95)
		else
			button.BackgroundTransparency = 0.35
		end
		button.Activated:Connect(function()
			if not enabled then
				SoundManager.Play("Error", 0.8)
				UIUtil.Shake(button)
				return
			end
			SoundManager.Play("Click", 1.2)
			close()
			onClick()
		end)
		return button
	end

	local function text(parentObject: Instance, value: string, position: UDim2, size: UDim2, fontSize: number, color: Color3?, bold: boolean?): TextLabel
		return UIUtil.Create("TextLabel", {
			Size = size,
			Position = position,
			BackgroundTransparency = 1,
			Font = bold and Theme.Fonts.Title or Theme.Fonts.Body,
			Text = value,
			TextColor3 = color or C.Ink,
			TextSize = fontSize,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 65,
			Parent = parentObject,
		})
	end

	dim.Activated:Connect(close)

	picker = {
		Frame = overlay,
		ShowRoomTypes = function(options)
			local phone = Interface.IsPhone()
			local columns = phone and 6 or 4
			local cellHeight = phone and 116 or 124
			local types = HouseCommon.Config.RoomTypes
			open(options.Title, options.Subtitle, columns, cellHeight, math.ceil(#types / columns))
			for index, roomType in ipairs(types) do
				local wallpaper = HouseCommon.WallpapersById[roomType.Wallpaper]
				local tint = C.PinkMist
				if wallpaper then
					-- (papiers peints sombres : fond bien éclairci, le texte reste lisible)
					local a = wallpaper.A
					local luminance = 0.3 * a.R + 0.59 * a.G + 0.11 * a.B
					tint = a:Lerp(WHITE, luminance < 0.6 and 0.72 or 0.35)
				end
				local isCurrent = options.Current == roomType.Id
				local button = cell(index, tint, not isCurrent, function()
					options.OnPick(roomType.Id)
				end)
				text(button, roomType.Icon, UDim2.fromOffset(0, 6), UDim2.new(1, 0, 0, 36), 30)
				text(button, HouseCommon.Name(roomType), UDim2.fromOffset(4, 44), UDim2.new(1, -8, 0, 20), phone and 14 or 16, C.Ink, true)
				-- Préférés : icônes des catégories + vignettes de quelques objets
				local row = UIUtil.Create("Frame", {
					Name = "Favorites",
					Size = UDim2.new(1, -8, 0, 34),
					Position = UDim2.new(0, 4, 1, -44),
					BackgroundTransparency = 1,
					ZIndex = 64,
					Parent = button,
				})
				UIUtil.Create("UIListLayout", {
					FillDirection = Enum.FillDirection.Horizontal,
					HorizontalAlignment = Enum.HorizontalAlignment.Center,
					VerticalAlignment = Enum.VerticalAlignment.Center,
					SortOrder = Enum.SortOrder.LayoutOrder,
					Padding = UDim.new(0, 3),
					Parent = row,
				})
				local maxIcons = phone and 3 or 4
				local count = 0
				local function bubble(order: number): Frame
					local holder = UIUtil.Create("Frame", {
						Name = "Fav" .. order,
						Size = UDim2.fromOffset(30, 30),
						BackgroundColor3 = WHITE,
						LayoutOrder = order,
						ZIndex = 65,
						Parent = row,
					})
					UIUtil.Corner(holder, UDim.new(1, 0))
					UIUtil.Stroke(holder, C.Pink, 1, 0.5)
					return holder
				end
				for _, categoryId in ipairs(roomType.Categories) do
					if count >= maxIcons then
						break
					end
					local category = HouseCommon.CategoriesById[categoryId]
					if category then
						count += 1
						local holder = bubble(count)
						holder.BackgroundColor3 = HouseCommon.CategoryTint(categoryId)
						text(holder, category.Icon, UDim2.new(), UDim2.fromScale(1, 1), 18)
					end
				end
				for _, itemId in ipairs(roomType.Items) do
					if count >= maxIcons then
						break
					end
					local item = HouseCommon.ItemsById[itemId]
					if item then
						count += 1
						local holder = bubble(count)
						holder.BackgroundColor3 = HouseCommon.CategoryTint(item.Category)
						HouseArt.Thumbnail(holder, item, 30, 66)
					end
				end
				if isCurrent then
					local badge = UIUtil.Chip({
						Name = "Current",
						Text = Locale.T("✓ Current"),
						Color = Theme.Colors.Green,
						TextColor3 = WHITE,
						Height = 22,
						TextSize = 13,
						ZIndex = 66,
						Parent = button,
					})
					badge.AnchorPoint = Vector2.new(1, 0)
					badge.Position = UDim2.new(1, -6, 0, 6)
				end
			end
		end,
		ShowRooms = function(options)
			local phone = Interface.IsPhone()
			local columns = phone and 4 or 3
			local cellHeight = phone and 128 or 150
			local house = options.House
			open(options.Title, options.Subtitle, columns, cellHeight, math.max(1, math.ceil((#house.Rooms - 1) / columns)))
			local size = HouseCommon.GetSize(house)
			local rooms = table.clone(house.Rooms)
			table.sort(rooms, function(a, b)
				return a.Slot < b.Slot
			end)
			local order = 0
			for _, room in ipairs(rooms) do
				if room.Id ~= options.ExcludeId then
					order += 1
					local roomType = HouseCommon.GetRoomType(room)
					local used = (options.Counts and options.Counts[room.Id]) or #room.Placed
					local full = used >= size.RoomItems
					local button = cell(order, WHITE, not full, function()
						options.OnPick(room.Id)
					end)
					-- Petite pièce dessinée
					local previewW = phone and 150 or 190
					local previewH = math.floor(previewW * 0.5)
					local holder = UIUtil.Create("Frame", {
						Name = "Preview",
						Size = UDim2.fromOffset(previewW, previewH),
						AnchorPoint = Vector2.new(0.5, 0),
						Position = UDim2.new(0.5, 0, 0, 6),
						BackgroundTransparency = 1,
						ZIndex = 64,
						Parent = button,
					})
					local previewScale = UIUtil.Create("UIScale", { Parent = holder })
					local mini = HouseMiniRoom.new(holder, previewW, previewH)
					mini.Set(room, size)
					UIUtil.Corner(mini.Frame, 10)
					-- (la case de la grille peut être plus étroite que l'aperçu)
					local function fitPreview()
						local width = button.AbsoluteSize.X
						local ratio = Interface.Scale > 0 and width / Interface.Scale or width
						previewScale.Scale = math.clamp((ratio - 12) / previewW, 0.4, 1)
					end
					button:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitPreview)
					fitPreview()
					local line = string.format("%s %s", roomType.Icon, HouseCommon.Name(roomType))
					text(button, line, UDim2.new(0, 4, 1, -44), UDim2.new(1, -8, 0, 20), phone and 14 or 16, C.Ink, true)
					local info = full and Locale.T("🚫 Full") or string.format("📦 %d/%d", used, size.RoomItems)
					local item = options.Item
					if not full and item and HouseCommon.IsFavorite(room, item) then
						info ..= "  " .. Locale.T("✨ Favourite")
					end
					text(button, info, UDim2.new(0, 4, 1, -24), UDim2.new(1, -8, 0, 18), 13, full and Theme.Colors.Red or Theme.Colors.TextDim)
				end
			end
		end,
		ShowMenu = function(options)
			local count = #options.Buttons
			local columns = math.max(1, math.min(count, 3))
			local cellHeight = Interface.IsTouch() and 64 or 56
			local rows = math.ceil(count / columns)
			-- (3 boutons : fenêtre plus large, les textes traduits tiennent)
			open(options.Title, options.Subtitle, columns, cellHeight, rows, 120 + columns * 190)
			for index, info in ipairs(options.Buttons) do
				local button = cell(index, info.Color, true, info.OnClick)
				text(button, info.Text, UDim2.fromOffset(8, 0), UDim2.new(1, -16, 1, 0), 17, C.Ink, true)
			end
		end,
		Close = close,
		IsOpen = function(): boolean
			return overlay.Visible
		end,
	}
	return picker
end

return HousePicker
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">HouseRoom</string>
              <string name="Source"><![CDATA[--[[
	HouseRoom (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > HouseRoom

	Dessin de la pièce kawaii "en coupe" (maison de poupée) :
	  - coque arrondie (plafond, côtés, dalle du sol) avec ombre douce et
	    festons sous le plafond ;
	  - mur du fond avec le papier peint (HousePatterns), murs de côté en
	    perspective (plus sombres), arêtes, plinthe et moulure ;
	  - sol en perspective (HousePatterns) avec ombre au pied du mur ;
	  - fenêtre à rideaux + tache de lumière sur le sol, prise électrique
	    rigolote, lumière douce du coin haut-gauche, vignettage ;
	  - mode nuit (mode sombre) : voile bleu nuit, lune et étoiles dans la
	    fenêtre, les lumières (catégorie "Lights") brillent davantage ;
	  - (v9.1) SetLooks : couleur des boiseries (plinthe, moulure, fenêtre,
	    plafond), vue par la fenêtre (HouseViews), ambiance lumineuse
	    (HouseMoods, par-dessus les objets) ; couleur de chaque objet
	    (entry.C, HouseTints ; SetTint la change sans recréer l'objet).
	  - objets = gros emojis "autocollants" (ombre portée, halo pour les
	    lumières, détails dessinés à la main pour certains objets : tapis,
	    guirlande, fenêtres, portes, cheminée, aquarium, frigo...) ; un
	    objet retourné (entry.F) est dessiné en miroir (SetFlip) ;
	  - indices pendant un glissement (éditeur) : zones mur / sol, grille
	    de l'aimant, toutes les places libres sur les meubles (ShowSurfaces),
	    dessus visé qui brille + étiquette "✨ Poser sur : ..." ou "🪑 ..."
	    (SetSurfaceHint), halo autour du meuble visé (SetTargetGlow).

	Coordonnées : la pièce fait (BASE_WIDTH x Width de la taille) x HEIGHT px
	de "maquette" ; un UIScale l'adapte à la place disponible (Stage).
	Un objet posé a X, Y entre 0 et 1 (fraction de la pièce) : objets "Floor"
	ancrés par le bas (leurs pieds), objets "Wall" par le centre.
	La pièce ignore l'habillage sombre automatique (DarkSkinIgnore) : elle
	gère elle-même son mode nuit.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local Signal = require(ReplicatedStorage.Shared.Signal)
local HouseCommon = require(script.Parent.HouseCommon)
local HousePatterns = require(script.Parent.HousePatterns)
local HouseArt = require(script.Parent.HouseArt)
local HouseScenery = require(script.Parent.HouseScenery)
local HouseViews = require(script.Parent.HouseViews)
local HouseMoods = require(script.Parent.HouseMoods)
local HouseTints = require(script.Parent.HouseTints)

type Item = HouseCommon.Item
type Placed = HouseCommon.Placed
type Style = HouseCommon.Style
type SizeDef = HouseCommon.SizeDef
type Look = HouseCommon.Look

local HouseRoom = {}

HouseRoom.BASE_WIDTH = 760 -- largeur de la plus petite maison (px de maquette)
HouseRoom.HEIGHT = 440
local SIDE = 42 -- profondeur apparente des murs de côté
local SHELL = 12 -- épaisseur de la coque (côtés, dalle du sol)
local CEIL = 20 -- épaisseur du plafond
local STICKER_BASE = 100 -- taille de base d'un autocollant (avant UIScale)

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local C = HouseCommon.Colors
local Box = HousePatterns.Box
local Circle = HousePatterns.Circle
local Round = HousePatterns.Round

export type Sticker = {
	Entry: Placed,
	Item: Item,
	Frame: Frame,
	Scale: UIScale,
	Body: Frame,
	Pop: UIScale,
	Shadow: Frame,
	Ring: Frame?, -- contour de sélection (créé à la première sélection)
	RingStroke: UIStroke?,
	Hit: TextButton,
	Glow: Frame?,
	Bulbs: { Frame },
	Anims: { HouseArt.Anim },
	Flat: boolean,
	Flipped: boolean, -- dessin retourné (miroir) : entry.F
	Tint: string?, -- (v9.1) couleur appliquée au dessin : entry.C
}

export type Room = {
	Stage: Frame,
	Frame: Frame,
	Items: Frame,
	Overlay: Frame,
	BackgroundHit: TextButton,
	Width: number,
	Height: number,
	WallHeight: number,
	Scale: number,
	Changed: any, -- Signal () : taille / échelle changée
	SetStyle: (size: SizeDef, wallpaper: Style?, floor: Style?) -> (),
	-- (v9.1) boiseries (couleur), vue par la fenêtre, ambiance lumineuse
	SetLooks: (trim: Look?, view: Look?, mood: Look?) -> (),
	SetTint: (sticker: Sticker, tintId: string?) -> (),
	SetDark: (dark: boolean) -> (),
	IsDark: () -> boolean,
	ScreenToRoom: (position: Vector2) -> Vector2,
	CreateSticker: (item: Item, entry: Placed) -> Sticker,
	ApplySticker: (sticker: Sticker) -> (),
	ShowRing: (sticker: Sticker, visible: boolean) -> (),
	DestroySticker: (sticker: Sticker) -> (),
	SetZoneHint: (placement: string?) -> (),
	SetGrid: (visible: boolean, step: number?) -> (),
	SetSurfaceHint: (surface: { L: number, R: number, Y: number }?, label: string?, color: Color3?) -> (),
	ShowSurfaces: (list: { any }?) -> (),
	SetTargetGlow: (sticker: Sticker?) -> (),
	SetFlip: (sticker: Sticker, flipped: boolean) -> (),
	SetExterior: (exterior: string?) -> (),
	Update: (dt: number) -> (),
	Refit: () -> (),
}

----------------------------------------------------------------------
-- Construction de la pièce
----------------------------------------------------------------------

-- Halo de lumière : 3 cercles concentriques (un UIGradient ne fait que des
-- dégradés linéaires, pas radiaux). Plus visible et plus grand la nuit.
local GLOW_RINGS = {
	{ Size = 1, Day = 0.96, Night = 0.92 },
	{ Size = 0.8, Day = 0.94, Night = 0.88 },
	{ Size = 0.62, Day = 0.91, Night = 0.83 },
	{ Size = 0.46, Day = 0.88, Night = 0.77 },
	{ Size = 0.32, Day = 0.85, Night = 0.7 },
}

local function paintGlow(glow: Frame, dark: boolean)
	glow.Size = dark and UDim2.fromOffset(150, 150) or UDim2.fromOffset(120, 120)
	for index, ring in ipairs(GLOW_RINGS) do
		local circle = glow:FindFirstChild("Ring" .. index) :: Frame?
		if circle then
			circle.BackgroundTransparency = dark and ring.Night or ring.Day
		end
	end
end

local function gradientTransparency(frame: GuiObject, from: number, to: number, rotation: number)
	UIUtil.Create("UIGradient", {
		Rotation = rotation,
		Transparency = NumberSequence.new(from, to),
		Parent = frame,
	})
end

function HouseRoom.new(stage: Frame): Room
	local room: Room
	local width = HouseRoom.BASE_WIDTH
	local height = HouseRoom.HEIGHT
	local wallHeight = math.floor(height * HouseCommon.Config.WallRatio + 0.5)
	local dark = false
	local styleKey = ""
	local lastWallpaper: Style? = nil
	local lastFloor: Style? = nil
	local trimLook: Look? = nil
	local viewLook: Look? = nil
	local moodLook: Look? = nil
	local stickers: { [Sticker]: boolean } = {}
	local clock = 0

	-- Sonde de taille fixe : sert à convertir AbsoluteSize en px de maquette
	local probe = UIUtil.Create("Frame", {
		Name = "Probe",
		Size = UDim2.fromOffset(100, 100),
		BackgroundTransparency = 1,
		Visible = true,
		Parent = stage,
	})

	local frame = UIUtil.Create("Frame", {
		Name = "Room",
		Size = UDim2.fromOffset(width, height),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = 2,
	})
	-- La pièce garde ses couleurs (mode nuit géré ici)
	frame:SetAttribute("DarkSkinIgnore", true)
	local scale = UIUtil.Create("UIScale", { Parent = frame })
	frame.Parent = stage

	-- Coque (derrière tout) : plafond, côtés, dalle du sol
	local shell = UIUtil.Create("Frame", {
		Name = "Shell",
		BackgroundColor3 = WHITE,
		ZIndex = 2,
		Parent = frame,
	})
	Round(shell, UDim.new(0, 18))
	UIUtil.Stroke(shell, C.PinkDeep, 2, 0.45)
	local SHELL_DEFAULT = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 225, 238)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(236, 206, 238)),
	})
	local shellGradient = UIUtil.Gradient(shell, SHELL_DEFAULT, 90)
	UIUtil.Shadow(shell, 8, 0.78, 5)

	local wall = UIUtil.Create("Frame", {
		Name = "Wall",
		BackgroundColor3 = C.PinkSoft,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 3,
		Parent = frame,
	})
	local floor = UIUtil.Create("Frame", {
		Name = "Floor",
		BackgroundColor3 = C.Lilac,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 3,
		Parent = frame,
	})
	local decor = UIUtil.Create("Frame", {
		Name = "Decor",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 4,
		Parent = frame,
	})
	local night = UIUtil.Create("Frame", {
		Name = "Night",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(34, 26, 92),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = frame,
	})
	-- Ciel, toit, pelouse et poussières de lumière (au-dessus du voile de nuit)
	local scenery = HouseScenery.new(stage, frame, SHELL, CEIL, 5)

	-- Clic dans le vide : désélectionne (branché par l'éditeur)
	local backgroundHit = UIUtil.Create("TextButton", {
		Name = "BackgroundHit",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 6,
		Parent = frame,
	})
	local zones = UIUtil.Create("Frame", {
		Name = "Zones",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 7,
		Parent = frame,
	})
	-- Grille de l'aimant (visible pendant un glissement, aimant activé)
	local grid = UIUtil.Create("Frame", {
		Name = "Grid",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 7,
		Parent = frame,
	})
	local gridKey = ""
	local items = UIUtil.Create("Frame", {
		Name = "Items",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 8,
		Parent = frame,
	})
	-- (v9.1) Ambiance lumineuse : voile + effet par-dessus les objets
	local moods = HouseMoods.new(frame, 9)
	local overlay = UIUtil.Create("Frame", {
		Name = "Overlay",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 10,
		Parent = frame,
	})

	-- Zones mises en valeur pendant un glissement
	local wallZone = UIUtil.Create("Frame", {
		Name = "WallZone",
		BackgroundColor3 = C.Pink,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = zones,
	})
	Round(wallZone, UDim.new(0, 10))
	local wallZoneStroke = UIUtil.Stroke(wallZone, WHITE, 3, 1)
	local floorZone = UIUtil.Create("Frame", {
		Name = "FloorZone",
		BackgroundColor3 = C.Pink,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = zones,
	})
	Round(floorZone, UDim.new(0, 10))
	local floorZoneStroke = UIUtil.Stroke(floorZone, WHITE, 3, 1)

	-- Dessus de meuble visé pendant un glissement (petit objet posé SUR un
	-- meuble, chaise rangée à une table) : trait lumineux + étiquette
	local surfaceHint = UIUtil.Create("Frame", {
		Name = "SurfaceHint",
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 3,
		Parent = overlay,
	})
	local surfaceGlow = Box(surfaceHint, 0, 0, 0, 0, C.Butter, 0.45, 1)
	surfaceGlow.Size = UDim2.new(1, 20, 0, 18)
	surfaceGlow.Position = UDim2.new(0, -10, 0.5, -9)
	Round(surfaceGlow)
	local surfaceLine = Box(surfaceHint, 0, 0, 0, 0, WHITE, 0, 2)
	surfaceLine.Size = UDim2.new(1, 0, 0, 6)
	surfaceLine.Position = UDim2.new(0, 0, 0.5, -3)
	Round(surfaceLine)
	local surfaceLineStroke = UIUtil.Stroke(surfaceLine, C.PinkDeep, 2, 0)
	local surfaceSparkle = UIUtil.Create("TextLabel", {
		Name = "Sparkle",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(1, 2, 0.5, -2),
		Size = UDim2.fromOffset(24, 24),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		Text = "✨",
		TextSize = 18,
		ZIndex = 3,
		Parent = surfaceHint,
	})
	-- Étiquette "⬇ Table à manger" (taille constante à l'écran : contre-échelle)
	-- (sous le trait : l'objet qu'on porte reste bien visible au-dessus)
	local surfaceChip = UIUtil.Create("Frame", {
		Name = "HintChip",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.5, 14),
		Size = UDim2.fromOffset(0, 26),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = C.PinkDeep,
		ZIndex = 4,
		Parent = surfaceHint,
	})
	UIUtil.Corner(surfaceChip, UDim.new(1, 0))
	UIUtil.Stroke(surfaceChip, WHITE, 2, 0)
	UIUtil.Gradient(surfaceChip, ColorSequence.new(WHITE, Color3.fromRGB(222, 222, 222)), 90)
	UIUtil.Create("UIPadding", { PaddingLeft = UDim.new(0, 11), PaddingRight = UDim.new(0, 11), Parent = surfaceChip })
	local surfaceChipScale = UIUtil.Create("UIScale", { Parent = surfaceChip })
	local surfaceChipLabel = UIUtil.Create("TextLabel", {
		Name = "Label",
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = "",
		TextColor3 = WHITE,
		TextSize = 14,
		ZIndex = 5,
		Parent = surfaceChip,
	})
	local surfaceKey = ""

	-- Toutes les places libres (dessus de meubles) pendant un glissement
	local surfacesLayer = UIUtil.Create("Frame", {
		Name = "Surfaces",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 1,
		Parent = overlay,
	})
	local surfacePool: { Frame } = {}

	-- Halo autour du meuble visé
	local targetGlow = UIUtil.Create("Frame", {
		Name = "TargetGlow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1.08, 1.06),
		BackgroundColor3 = C.Butter,
		BackgroundTransparency = 0.82,
		Visible = false,
		ZIndex = 3,
	})
	Round(targetGlow, UDim.new(0, 18))
	local targetGlowStroke = UIUtil.Stroke(targetGlow, C.Butter:Lerp(C.Peach, 0.4), 3, 0.05)
	local targetSticker: Sticker? = nil

	-- Éléments de décor qui changent la nuit
	local windowGlass: Frame? = nil
	local dayDecor: { GuiObject } = {}
	local nightDecor: { GuiObject } = {}
	local beamSlices: { Frame } = {}
	local sunLight: Frame? = nil

	-- Lampes plus lumineuses la nuit ou dans une ambiance tamisée
	local function glowNight(): boolean
		local mood = moodLook
		return dark or (mood ~= nil and (tonumber(mood.Brightness) or 1) < 0.8)
	end

	local function applyNight()
		night.BackgroundTransparency = dark and 0.46 or 1
		scenery:SetDark(dark)
		local glass = windowGlass
		if glass then
			-- (v9.1) la vue par la fenêtre, de jour ou de nuit
			HouseViews.Paint(glass, glass.Size.X.Offset, glass.Size.Y.Offset, viewLook :: any, dark)
		end
		for _, object in ipairs(dayDecor) do
			object.Visible = not dark
		end
		for _, object in ipairs(nightDecor) do
			object.Visible = dark
		end
		for index, slice in ipairs(beamSlices) do
			slice.BackgroundColor3 = dark and Color3.fromRGB(170, 190, 255) or Color3.fromRGB(255, 246, 220)
			slice.BackgroundTransparency = (dark and 0.84 or 0.7) + index * 0.025
		end
		local sun = sunLight
		if sun then
			sun.Visible = not dark
		end
		local bright = glowNight()
		for sticker in pairs(stickers) do
			local glow = sticker.Glow
			if glow then
				paintGlow(glow, bright)
			end
		end
	end

	-- Fenêtre fixe à rideaux (au mur, à gauche) + tache de lumière au sol
	local function buildWindow(windowX: number, trim: Color3)
		local top = 36
		local w, h = 104, 92
		local outer = Box(decor, windowX, top, w, h, trim, 0, 3)
		Round(outer, UDim.new(0, 14))
		UIUtil.Stroke(outer, C.WoodDark, 2, 0.4)
		-- Vitre : la vue choisie (HouseViews), repeinte le jour / la nuit
		local glass = Box(decor, windowX + 8, top + 8, w - 16, h - 16, WHITE, 0, 4)
		glass.ClipsDescendants = true
		Round(glass, UDim.new(0, 9))
		windowGlass = glass
		-- Croisillon
		Box(decor, windowX + w / 2 - 2, top + 8, 4, h - 16, trim, 0, 5)
		Box(decor, windowX + 8, top + h / 2 - 2, w - 16, 4, trim, 0, 5)
		local shine = Box(decor, windowX + 14, top + 14, 16, 5, WHITE, 0.45, 5)
		Round(shine)
		-- Rebord + ombre
		local sill = Box(decor, windowX - 8, top + h - 4, w + 16, 10, trim, 0, 6)
		Round(sill, UDim.new(0, 4))
		UIUtil.Stroke(sill, C.WoodDark, 1.5, 0.5)
		local sillShadow = Box(decor, windowX - 4, top + h + 6, w + 8, 10, BLACK, 0.85, 3)
		gradientTransparency(sillShadow, 0.2, 1, 90)
		-- Tringle + rideaux
		local rod = Box(decor, windowX - 18, top - 10, w + 36, 5, C.WoodDark, 0, 7)
		Round(rod)
		Circle(decor, windowX - 18, top - 8, 10, 10, C.PinkDeep, 0, 7)
		Circle(decor, windowX + w + 18, top - 8, 10, 10, C.PinkDeep, 0, 7)
		for _, side in ipairs({ -1, 1 }) do
			local x = side < 0 and windowX - 14 or windowX + w - 16
			local curtain = Box(decor, x, top - 6, 30, h + 10, C.Pink, 0, 6)
			Round(curtain, UDim.new(0, 10))
			UIUtil.Gradient(curtain, ColorSequence.new({
				ColorSequenceKeypoint.new(0, WHITE),
				ColorSequenceKeypoint.new(0.5, Color3.fromRGB(235, 215, 225)),
				ColorSequenceKeypoint.new(1, WHITE),
			}), 0)
			-- Plis
			Box(curtain, 9, 4, 2, h, C.PinkDeep, 0.7, 6)
			Box(curtain, 19, 4, 2, h, C.PinkDeep, 0.7, 6)
			local tie = Box(decor, x - 2, top + h * 0.56, 34, 7, C.PinkDeep, 0, 7)
			Round(tie)
			HousePatterns.Heart(decor, x + 15, top + h * 0.56 + 3, 12, WHITE, 0, 8)
		end
		-- Tache de lumière au sol (tranches de plus en plus larges vers l'avant)
		table.clear(beamSlices)
		local slices = 8
		local floorHeight = height - wallHeight
		for index = 1, slices do
			local t = (index - 1) / slices
			local sliceH = floorHeight * 0.62 / slices
			local sliceW = w * (0.9 + t * 0.9)
			local x = windowX + w / 2 - sliceW / 2 + t * 70
			local slice = Box(decor, x, wallHeight + 6 + (index - 1) * sliceH, sliceW, sliceH + 0.5, WHITE, 0.7, 2)
			table.insert(beamSlices, slice)
		end
	end

	-- Reconstruit la coque, les murs, le sol et le décor fixe
	local function rebuild(wallpaper: Style?, floorStyle: Style?)
		lastWallpaper = wallpaper
		lastFloor = floorStyle
		for _, child in ipairs(decor:GetChildren()) do
			child:Destroy()
		end
		table.clear(dayDecor)
		table.clear(nightDecor)
		table.clear(beamSlices)
		windowGlass = nil
		sunLight = nil
		local trim = (trimLook and trimLook.Color) or C.Cream
		local customTrim = trimLook ~= nil and trimLook.Color ~= nil and trimLook.Order ~= nil and trimLook.Order > 1

		frame.Size = UDim2.fromOffset(width, height)
		shell.Position = UDim2.fromOffset(-SHELL, -CEIL)
		shell.Size = UDim2.fromOffset(width + SHELL * 2, height + CEIL + SHELL)
		wall.Position = UDim2.fromOffset(0, 0)
		wall.Size = UDim2.fromOffset(width, wallHeight)
		floor.Position = UDim2.fromOffset(0, wallHeight)
		floor.Size = UDim2.fromOffset(width, height - wallHeight)
		wallZone.Position = UDim2.fromOffset(SIDE + 4, 4)
		wallZone.Size = UDim2.fromOffset(width - SIDE * 2 - 8, wallHeight - 8)
		floorZone.Position = UDim2.fromOffset(4, wallHeight + 4)
		floorZone.Size = UDim2.fromOffset(width - 8, height - wallHeight - 8)

		scenery:Rebuild(width, height, wallHeight)
		HousePatterns.BuildWall(wall, width, wallHeight, wallpaper, 1)
		HousePatterns.BuildFloor(floor, width, height - wallHeight, floorStyle, 1)

		local wallA = wallpaper and wallpaper.A or C.PinkSoft
		local wallB = wallpaper and wallpaper.B or C.Pink
		local floorB = floorStyle and floorStyle.B or C.Lilac

		-- Ombre au pied du mur + lumière douce du haut-gauche
		local ao = Box(decor, 0, wallHeight, width, 26, BLACK, 0.7, 1)
		gradientTransparency(ao, 0, 1, 90)
		local sun = Box(decor, 0, 0, width, height, WHITE, 0.55, 1)
		UIUtil.Create("UIGradient", {
			Rotation = 35,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.35),
				NumberSequenceKeypoint.new(0.45, 1),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = sun,
		})
		sunLight = sun
		local front = Box(decor, 0, height - 46, width, 46, BLACK, 0.8, 1)
		gradientTransparency(front, 1, 0.2, 90)

		-- Murs de côté en perspective (bande + triangle en tranches)
		local sideLeft = wallA:Lerp(wallB, 0.35):Lerp(BLACK, 0.12)
		local sideRight = wallA:Lerp(wallB, 0.25):Lerp(BLACK, 0.05)
		local floorHeight = height - wallHeight
		local slices = 14
		for _, info in ipairs({ { X = 0, Color = sideLeft, Dir = 1 }, { X = width - SIDE, Color = sideRight, Dir = -1 } }) do
			local strip = Box(decor, info.X, 0, SIDE, wallHeight, info.Color, 0, 3)
			UIUtil.Gradient(strip, ColorSequence.new(
				info.Dir > 0 and Color3.fromRGB(215, 215, 215) or WHITE,
				info.Dir > 0 and WHITE or Color3.fromRGB(225, 225, 225)
			), 0)
			for index = 0, slices - 1 do
				local sliceW = SIDE * (1 - index / slices)
				local x = info.Dir > 0 and 0 or width - sliceW
				Box(decor, x, wallHeight + index * floorHeight / slices, sliceW, floorHeight / slices + 0.6, info.Color, 0, 3)
			end
			-- Arête verticale du coin
			local edgeX = info.Dir > 0 and SIDE - 1 or width - SIDE - 1
			Box(decor, edgeX, 0, 2, wallHeight, wallB:Lerp(BLACK, 0.35), 0.45, 4)
			-- Arête du sol (diagonale)
			local startPoint = Vector2.new(info.Dir > 0 and SIDE or width - SIDE, wallHeight)
			local endPoint = Vector2.new(info.Dir > 0 and 0 or width, height)
			local delta = endPoint - startPoint
			local edge = Box(decor, 0, 0, delta.Magnitude, 2.5, floorB:Lerp(BLACK, 0.4), 0.3, 4)
			edge.AnchorPoint = Vector2.new(0.5, 0.5)
			edge.Position = UDim2.fromOffset((startPoint.X + endPoint.X) / 2, (startPoint.Y + endPoint.Y) / 2)
			edge.Rotation = math.deg(math.atan2(delta.Y, delta.X))
		end

		-- Plinthe (mur du fond) + petite ombre (couleur des boiseries)
		local baseboard = Box(decor, SIDE, wallHeight - 11, width - SIDE * 2, 11, trim, 0, 4)
		Box(baseboard, 0, 0, width - SIDE * 2, 2, WHITE, 0.2, 5)
		Box(baseboard, 0, 9, width - SIDE * 2, 2, wallB:Lerp(BLACK, 0.3), 0.5, 5)
		-- Moulure du plafond + festons
		local crown = Box(decor, 0, 0, width, 7, trim, 0, 5)
		Box(crown, 0, 5, width, 2, wallB:Lerp(BLACK, 0.25), 0.55, 6)
		local scallop = 20
		local x = scallop / 2
		local scallopColor = customTrim and trim:Lerp(wallB, 0.3) or C.Pink:Lerp(wallB, 0.4)
		-- Plafond et côtés de la coque : teintés par les boiseries choisies
		shellGradient.Color = if customTrim
			then ColorSequence.new(trim:Lerp(WHITE, 0.3), trim:Lerp(BLACK, 0.06))
			else SHELL_DEFAULT
		while x < width do
			Circle(decor, x, 7, scallop - 2, 12, scallopColor, 0, 4)
			x += scallop
		end

		-- Fenêtre (à gauche) et prise électrique rigolote (à droite)
		buildWindow(math.floor(SIDE + width * 0.1), trim)
		local outlet = Box(decor, width - SIDE - 70, wallHeight - 44, 22, 26, WHITE, 0, 4)
		Round(outlet, UDim.new(0, 5))
		UIUtil.Stroke(outlet, wallB:Lerp(BLACK, 0.35), 1.5, 0.4)
		Circle(outlet, 7, 9, 3, 5, Color3.fromRGB(90, 70, 90), 0, 5)
		Circle(outlet, 15, 9, 3, 5, Color3.fromRGB(90, 70, 90), 0, 5)
		Circle(outlet, 11, 18, 6, 3, C.Pink, 0, 5)

		applyNight()
	end

	-- Adapte l'échelle à la place disponible
	local function refit(force: boolean?)
		local factor = probe.AbsoluteSize.X / 100
		if factor <= 0 then
			return
		end
		local available = stage.AbsoluteSize / factor
		local fullW = width + SHELL * 2 + 76 -- (pelouse et toit débordent un peu)
		local roofH, groundH = HouseScenery.ROOF + 24, HouseScenery.GROUND
		local fullH = height + CEIL + SHELL + roofH + groundH + 16
		local newScale = math.max(0.2, math.min(available.X / fullW, available.Y / fullH))
		frame.Position = UDim2.new(0.5, 0, 0.5, (CEIL + roofH - SHELL - groundH) / 2 * newScale)
		if force == true or math.abs(newScale - room.Scale) > 1e-4 then
			room.Scale = newScale
			scale.Scale = newScale
			room.Changed:Fire()
		end
	end

	local function applySticker(sticker: Sticker)
		local entry = sticker.Entry
		local item = sticker.Item
		sticker.Frame.Position = UDim2.fromScale(entry.X, entry.Y)
		local stickerScale = item.Size * entry.S / STICKER_BASE
		sticker.Scale.Scale = stickerScale
		-- Contour de sélection : même épaisseur à l'écran quelle que soit la taille
		local stroke = sticker.RingStroke
		if stroke then
			stroke.Thickness = 3 / math.max(0.2, stickerScale)
		end
	end

	local function createSticker(item: Item, entry: Placed): Sticker
		local isWall = item.Placement == "Wall"
		local holder = UIUtil.Create("Frame", {
			Name = item.Id,
			Size = UDim2.fromOffset(STICKER_BASE, STICKER_BASE),
			AnchorPoint = isWall and Vector2.new(0.5, 0.5) or Vector2.new(0.5, 1),
			BackgroundTransparency = 1,
			ZIndex = 1,
		})
		local stickerScale = UIUtil.Create("UIScale", { Parent = holder })
		local shadow = UIUtil.Create("Frame", {
			Name = "Shadow",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			ZIndex = 1,
			Parent = holder,
		})
		local body = UIUtil.Create("Frame", {
			Name = "Body",
			Size = UDim2.fromOffset(STICKER_BASE, STICKER_BASE),
			BackgroundTransparency = 1,
			ZIndex = 2,
			Parent = holder,
		})
		local pop = UIUtil.Create("UIScale", { Name = "Pop", Parent = body })

		-- Dessin kawaii de l'objet (House/Art) ; sinon, l'emoji seul
		local painted, anims = HouseArt.Paint(body, item, false)
		local detail: HouseArt.Result = painted or {}
		-- (v9.1) couleur choisie pour cet objet
		if painted and entry.C then
			HouseTints.Apply(body, entry.C)
		end
		local showEmoji = painted == nil or detail.ShowEmoji == true

		-- Halo des lumières
		local glowColor = detail.Glow or (item.Category == "Lights" and detail.Bulbs == nil and C.Butter or nil)
		local glow: Frame? = nil
		if glowColor then
			local halo = UIUtil.Create("Frame", {
				Name = "Glow",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(150, 150),
				BackgroundTransparency = 1,
				ZIndex = 1,
				Parent = body,
			})
			for index, ring in ipairs(GLOW_RINGS) do
				local circle = UIUtil.Create("Frame", {
					Name = "Ring" .. index,
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromScale(0.5, 0.5),
					Size = UDim2.fromScale(ring.Size, ring.Size),
					BackgroundColor3 = glowColor,
					BackgroundTransparency = ring.Day,
					BorderSizePixel = 0,
					ZIndex = 1,
					Parent = halo,
				})
				Round(circle)
			end
			glow = halo
		end

		-- Emoji "autocollant"
		local emojiScale = detail.EmojiScale or 1
		UIUtil.Create("TextLabel", {
			Name = "Emoji",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, detail.EmojiY or (isWall and 0.5 or 0.54)),
			Size = UDim2.fromOffset(STICKER_BASE * emojiScale, STICKER_BASE * emojiScale),
			BackgroundTransparency = 1,
			Font = Theme.Fonts.Body,
			Text = item.Icon,
			TextColor3 = WHITE,
			TextSize = math.floor(88 * emojiScale),
			TextYAlignment = isWall and Enum.TextYAlignment.Center or Enum.TextYAlignment.Bottom,
			Visible = showEmoji,
			ZIndex = 4,
			Parent = body,
		})

		-- Ombre portée : ovale au sol, ou ombre douce décalée au mur
		local flat = detail.Flat == true
		if isWall then
			local shadowSize = detail.WallShadow or Vector2.new(0.66, 0.66)
			if shadowSize.X > 0 then
				local soft = Box(shadow, 0, 0, 0, 0, BLACK, 0.9, 1)
				soft.AnchorPoint = Vector2.new(0.5, 0.5)
				soft.Position = UDim2.new(0.5, 5, 0.5, 8)
				soft.Size = UDim2.fromScale(shadowSize.X, shadowSize.Y)
				Round(soft, UDim.new(0.2, 0))
			end
		elseif not flat then
			Circle(shadow, 50, 97, 104, 18, BLACK, 0.9, 1)
			Circle(shadow, 50, 97, 70, 11, BLACK, 0.84, 1)
		end

		-- Zone de clic (un peu plus petite que la boîte, sauf les objets à plat)
		local hit = UIUtil.Create("TextButton", {
			Name = "Hit",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = flat and UDim2.fromScale(0.5, 0.8) or UDim2.fromScale(0.5, 0.52),
			Size = flat and UDim2.fromScale(1.4, 0.45) or UDim2.fromScale(0.84, 0.9),
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Text = "",
			ZIndex = 4,
			Parent = holder,
		})

		local sticker: Sticker = {
			Entry = entry,
			Item = item,
			Frame = holder,
			Scale = stickerScale,
			Body = body,
			Pop = pop,
			Shadow = shadow,
			Ring = nil,
			RingStroke = nil,
			Hit = hit,
			Glow = glow,
			Bulbs = detail.Bulbs or {},
			Anims = anims,
			Flat = flat,
			Flipped = false,
			Tint = painted and entry.C or nil,
		}
		-- Objet retourné (chaise tournée vers la table...) : dessin en miroir
		if entry.F == true then
			HouseArt.Mirror(body, anims, STICKER_BASE / 2)
			sticker.Flipped = true
		end
		stickers[sticker] = true
		if glow then
			paintGlow(glow, glowNight())
		end
		applySticker(sticker)
		holder.Parent = items
		return sticker
	end

	room = {
		Stage = stage,
		Frame = frame,
		Items = items,
		Overlay = overlay,
		BackgroundHit = backgroundHit,
		Width = width,
		Height = height,
		WallHeight = wallHeight,
		Scale = 1,
		Changed = Signal.new(),
		SetStyle = function(size: SizeDef, wallpaper: Style?, floorStyle: Style?)
			local newWidth = math.floor(HouseRoom.BASE_WIDTH * (tonumber(size.Width) or 1) + 0.5)
			local key = table.concat({
				tostring(newWidth),
				wallpaper and wallpaper.Id or "",
				floorStyle and floorStyle.Id or "",
			}, "|")
			if key == styleKey then
				return
			end
			local widthChanged = newWidth ~= width
			styleKey = key
			width = newWidth
			room.Width = newWidth
			rebuild(wallpaper, floorStyle)
			-- Nouvelle largeur : échelle recalculée (et signal Changed même si elle ne bouge pas)
			refit(widthChanged)
		end,
		SetLooks = function(trim: Look?, view: Look?, mood: Look?)
			local oldTrim, oldView = trimLook, viewLook
			trimLook, viewLook, moodLook = trim, view, mood
			if (oldTrim and oldTrim.Id) ~= (trim and trim.Id) then
				rebuild(lastWallpaper, lastFloor)
			elseif (oldView and oldView.Id) ~= (view and view.Id) then
				applyNight()
			end
			moods.Set(mood :: any, width, height)
			-- (lampes plus lumineuses dans une ambiance tamisée)
			local bright = glowNight()
			for sticker in pairs(stickers) do
				local glow = sticker.Glow
				if glow then
					paintGlow(glow, bright)
				end
			end
		end,
		-- (v9.1) change la couleur d'un objet déjà posé : on repeint son dessin
		SetTint = function(sticker: Sticker, tintId: string?)
			if sticker.Tint == tintId then
				return
			end
			local body = sticker.Body
			for _, child in ipairs(body:GetChildren()) do
				if child:IsA("GuiObject") and child.Name ~= "Glow" and child.Name ~= "Emoji" then
					child:Destroy()
				end
			end
			local painted, anims = HouseArt.Paint(body, sticker.Item, false)
			if painted and tintId then
				HouseTints.Apply(body, tintId)
			end
			sticker.Anims = anims
			sticker.Bulbs = (painted and painted.Bulbs) or {}
			sticker.Tint = tintId
			if sticker.Flipped then
				HouseArt.Mirror(body, anims, STICKER_BASE / 2)
			end
		end,
		SetDark = function(value: boolean)
			if dark == value then
				return
			end
			dark = value
			applyNight()
		end,
		IsDark = function(): boolean
			return dark
		end,
		ScreenToRoom = function(position: Vector2): Vector2
			local size = frame.AbsoluteSize
			if size.X <= 0 or size.Y <= 0 then
				return Vector2.new(0.5, 0.5)
			end
			return (position - frame.AbsolutePosition) / size
		end,
		CreateSticker = createSticker,
		ApplySticker = applySticker,
		ShowRing = function(sticker: Sticker, visible: boolean)
			local ring = sticker.Ring
			if not ring then
				if not visible then
					return
				end
				local flat = sticker.Flat
				local newRing = UIUtil.Create("Frame", {
					Name = "Ring",
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = flat and UDim2.fromScale(0.5, 0.8) or UDim2.fromScale(0.5, 0.5),
					Size = flat and UDim2.fromScale(1.5, 0.5) or UDim2.fromScale(1.12, 1.12),
					BackgroundColor3 = C.Pink,
					BackgroundTransparency = 0.88,
					ZIndex = 3,
					Parent = sticker.Frame,
				})
				Round(newRing, UDim.new(0, 18))
				sticker.RingStroke = UIUtil.Stroke(newRing, C.PinkDeep, 3, 0)
				sticker.Ring = newRing
				ring = newRing
				applySticker(sticker)
			end
			(ring :: Frame).Visible = visible
		end,
		DestroySticker = function(sticker: Sticker)
			stickers[sticker] = nil
			-- (le halo du meuble visé est réutilisé : on le sort avant de détruire)
			if targetSticker == sticker then
				targetSticker = nil
				targetGlow.Visible = false
				targetGlow.Parent = nil
			end
			sticker.Frame:Destroy()
		end,
		SetGrid = function(visible: boolean, step: number?)
			if visible then
				local gridStep = math.max(8, step or 20)
				local key = string.format("%d|%d|%d", width, height, gridStep)
				if key ~= gridKey then
					gridKey = key
					for _, child in ipairs(grid:GetChildren()) do
						child:Destroy()
					end
					-- Lignes fines (une Frame par ligne : ~60 au total)
					local x = gridStep
					while x < width do
						Box(grid, x - 0.5, 0, 1, height, WHITE, 0.55, 1)
						x += gridStep
					end
					local y = gridStep
					while y < height do
						Box(grid, 0, y - 0.5, width, 1, WHITE, 0.55, 1)
						y += gridStep
					end
				end
			end
			grid.Visible = visible
		end,
		SetSurfaceHint = function(surface: { L: number, R: number, Y: number }?, label: string?, color: Color3?)
			if not surface then
				surfaceKey = ""
				surfaceHint.Visible = false
				return
			end
			local key = string.format("%.3f|%.3f|%.3f|%s", surface.L, surface.R, surface.Y, label or "")
			surfaceChipScale.Scale = 1 / math.max(0.2, room.Scale)
			if key == surfaceKey then
				return
			end
			local appearing = not surfaceHint.Visible
			surfaceKey = key
			local tint = color or C.PinkDeep
			surfaceLineStroke.Color = tint
			surfaceChip.BackgroundColor3 = tint
			surfaceHint.Position = UDim2.fromOffset(surface.L * width, surface.Y * height)
			surfaceHint.Size = UDim2.fromOffset(math.max(8, (surface.R - surface.L) * width), 10)
			surfaceChip.Visible = label ~= nil and label ~= ""
			if label and surfaceChipLabel.Text ~= label then
				surfaceChipLabel.Text = label
			end
			surfaceHint.Visible = true
			if appearing then
				surfaceGlow.BackgroundTransparency = 1
				UIUtil.Tween(surfaceGlow, 0.18, { BackgroundTransparency = 0.45 })
				surfaceSparkle.TextTransparency = 1
				UIUtil.Tween(surfaceSparkle, 0.25, { TextTransparency = 0 })
				UIUtil.Pop(surfaceChip, 0.6, 0.3)
			end
		end,
		ShowSurfaces = function(list: { any }?)
			if not list or #list == 0 then
				surfacesLayer.Visible = false
				return
			end
			-- (une Frame par dessus, réutilisées d'un glissement à l'autre)
			for index, surface in ipairs(list) do
				local line = surfacePool[index]
				if not line then
					line = Box(surfacesLayer, 0, 0, 0, 0, WHITE, 0.25, 1)
					line.AnchorPoint = Vector2.new(0, 0.5)
					Round(line)
					UIUtil.Stroke(line, C.Pink, 1.5, 0.25)
					local dot = Box(line, 0, 0, 7, 7, C.Butter, 0, 2)
					dot.Name = "Dot"
					dot.AnchorPoint = Vector2.new(0.5, 0.5)
					dot.Position = UDim2.fromScale(0.5, 0.5)
					Round(dot)
					surfacePool[index] = line
				end
				line.Position = UDim2.fromOffset(surface.L * width, surface.Y * height)
				line.Size = UDim2.fromOffset(math.max(8, (surface.R - surface.L) * width), 4)
				line.Visible = true
			end
			for index = #list + 1, #surfacePool do
				surfacePool[index].Visible = false
			end
			if not surfacesLayer.Visible then
				surfacesLayer.Visible = true
			end
		end,
		SetTargetGlow = function(sticker: Sticker?)
			if sticker == targetSticker then
				return
			end
			targetSticker = sticker
			if not sticker or not sticker.Frame.Parent then
				targetGlow.Visible = false
				targetGlow.Parent = nil
				return
			end
			local flat = sticker.Flat
			targetGlow.Position = flat and UDim2.fromScale(0.5, 0.8) or UDim2.fromScale(0.5, 0.5)
			targetGlow.Size = flat and UDim2.fromScale(1.5, 0.5) or UDim2.fromScale(1.1, 1.08)
			targetGlowStroke.Thickness = 3 / math.max(0.2, sticker.Scale.Scale)
			targetGlow.Parent = sticker.Frame
			targetGlow.Visible = true
			targetGlow.BackgroundTransparency = 1
			UIUtil.Tween(targetGlow, 0.18, { BackgroundTransparency = 0.8 })
		end,
		SetFlip = function(sticker: Sticker, flipped: boolean)
			if sticker.Flipped == flipped then
				return
			end
			HouseArt.Mirror(sticker.Body, sticker.Anims, STICKER_BASE / 2)
			sticker.Flipped = flipped
		end,
		SetExterior = function(exterior: string?)
			scenery:SetPalette(exterior)
		end,
		SetZoneHint = function(placement: string?)
			local function set(zone: Frame, stroke: UIStroke, state: string)
				local bg = state == "valid" and 0.82 or (state == "invalid" and 0.7 or 1)
				zone.BackgroundColor3 = state == "invalid" and Color3.fromRGB(30, 20, 50) or C.Pink
				UIUtil.Tween(zone, 0.18, { BackgroundTransparency = bg })
				UIUtil.Tween(stroke, 0.18, { Transparency = state == "valid" and 0.2 or 1 })
			end
			if placement == nil then
				set(wallZone, wallZoneStroke, "none")
				set(floorZone, floorZoneStroke, "none")
			elseif placement == "Wall" then
				set(wallZone, wallZoneStroke, "valid")
				set(floorZone, floorZoneStroke, "invalid")
			else
				set(wallZone, wallZoneStroke, "invalid")
				set(floorZone, floorZoneStroke, "valid")
			end
		end,
		Update = function(dt: number)
			clock += dt
			scenery:Update(dt)
			moods.Update(dt)
			-- Petites animations des dessins (animaux, flammes, balanciers...)
			-- et guirlandes qui scintillent (les ampoules et leur halo)
			for sticker in pairs(stickers) do
				if #sticker.Anims > 0 then
					HouseArt.Step(sticker.Anims, clock)
				end
				local bulbs = sticker.Bulbs
				for index = 1, #bulbs, 2 do
					local bulb = bulbs[index]
					local halo = bulbs[index + 1]
					local phase = tonumber(bulb:GetAttribute("Phase")) or 0
					local wave = 0.5 + 0.5 * math.sin(clock * 3 + phase)
					bulb.BackgroundTransparency = 0.05 + wave * 0.3
					if halo then
						halo.BackgroundTransparency = (dark and 0.35 or 0.7) + wave * 0.25
					end
				end
			end
		end,
		Refit = function()
			refit(true)
		end,
	}

	stage:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		refit()
	end)
	probe:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		refit()
	end)
	rebuild(nil, nil)
	return room
end

return HouseRoom
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">HouseScenery</string>
              <string name="Source"><![CDATA[--[[
	HouseScenery (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > HouseScenery

	Tout ce qui entoure la pièce pour lui donner un vrai air de "maison de
	poupée" kawaii (uniquement des Frames) :
	  - fond de scène : ciel pastel en dégradé, nuages qui passent
	    doucement, petites étincelles (la nuit : ciel bleu nuit, étoiles
	    qui scintillent, nuages plus sombres) ;
	  - toit en tuiles arrondies au-dessus de la pièce : rangées de tuiles,
	    bord festonné, faîtage, lucarne ronde (allumée la nuit) et cheminée
	    qui fume ;
	  - pelouse sous la maison avec de petites fleurs ;
	  - poussières de lumière qui flottent dans la pièce (lucioles la nuit).
	Coordonnées en px de "maquette" de la pièce (voir HouseRoom).

	API :
	  HouseScenery.ROOF, HouseScenery.GROUND : place prise au-dessus / en dessous
	  HouseScenery.new(stage, roomFrame, shell, ceil, zMotes) -> Scenery
	    :Rebuild(width, height, wallHeight)
	    :SetDark(dark)
	    :SetPalette(exterior)   (toit assorti : Cottage, Townhouse, Loft, Mansion)
	    :Update(dt)
]]

local Client = script.Parent.Parent.Parent
local UIUtil = require(Client.UIUtil)
local HouseCommon = require(script.Parent.HouseCommon)
local HousePatterns = require(script.Parent.HousePatterns)

local HouseScenery = {}

HouseScenery.ROOF = 66 -- hauteur du toit au-dessus du plafond
HouseScenery.GROUND = 22 -- pelouse sous la dalle

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local C = HouseCommon.Colors
local Box = HousePatterns.Box
local Circle = HousePatterns.Circle
local Round = HousePatterns.Round

-- Couleurs du toit selon le style de l'immeuble (House/HouseExterior)
local ROOF_PALETTES: { [string]: { Color3 } } = {
	Cottage = { Color3.fromRGB(255, 150, 190), Color3.fromRGB(226, 104, 156) },
	Townhouse = { Color3.fromRGB(176, 166, 246), Color3.fromRGB(132, 118, 216) },
	Loft = { Color3.fromRGB(232, 142, 120), Color3.fromRGB(190, 98, 88) },
	Mansion = { Color3.fromRGB(162, 140, 232), Color3.fromRGB(112, 90, 196) },
}
local GRASS = Color3.fromRGB(150, 222, 150)
local GRASS_DARK = Color3.fromRGB(108, 190, 118)

local SKY_DAY = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(196, 228, 255)),
	ColorSequenceKeypoint.new(0.6, Color3.fromRGB(255, 226, 240)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 240, 226)),
})
local SKY_NIGHT = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(34, 32, 88)),
	ColorSequenceKeypoint.new(0.65, Color3.fromRGB(86, 64, 150)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 96, 170)),
})

export type Scenery = {
	Rebuild: (self: Scenery, width: number, height: number, wallHeight: number) -> (),
	SetDark: (self: Scenery, dark: boolean) -> (),
	Update: (self: Scenery, dt: number) -> (),
	SetPalette: (self: Scenery, exterior: string?) -> (),
}

type Cloud = { Frame: Frame, Speed: number, Y: number, X: number }
type Mote = { Frame: Frame, X: number, Y: number, Speed: number, Phase: number }
type Puff = { Frame: Frame, Phase: number }

-- Pseudo-aléatoire stable
local function noise(a: number, b: number): number
	local value = math.sin(a * 12.9898 + b * 78.233) * 43758.5453
	return value - math.floor(value)
end

function HouseScenery.new(stage: Frame, room: Frame, shellSize: number, ceil: number, zMotes: number): Scenery
	local dark = false
	local clock = 0
	local width, height = 760, 440
	local ROOF_COLOR = ROOF_PALETTES.Cottage[1]
	local ROOF_DARK = ROOF_PALETTES.Cottage[2]
	local paletteName = "Cottage"

	------------------------------------------------------------------
	-- Fond de scène (derrière la pièce, dans le Stage)
	------------------------------------------------------------------
	local backdrop = UIUtil.Create("Frame", {
		Name = "Backdrop",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 1,
		Parent = stage,
	})
	UIUtil.Corner(backdrop, 20)
	local sky = UIUtil.Gradient(backdrop, SKY_DAY, 90)

	local clouds: { Cloud } = {}
	for index = 1, 6 do
		local holder = UIUtil.Create("Frame", {
			Name = "Cloud" .. index,
			AnchorPoint = Vector2.new(0.5, 1),
			Size = UDim2.fromOffset(120, 80),
			BackgroundTransparency = 1,
			ZIndex = 2,
			Parent = backdrop,
		})
		local w = 70 + noise(index, 1) * 70
		HousePatterns.Cloud(holder, 60, 80, w, WHITE, 0.15 + noise(index, 2) * 0.25, 1)
		table.insert(clouds, {
			Frame = holder,
			Speed = 0.006 + noise(index, 3) * 0.01,
			Y = 0.12 + noise(index, 4) * 0.7,
			X = noise(index, 5),
		})
	end

	-- Étincelles (jour) / étoiles (nuit)
	local stars: { Frame } = {}
	for index = 1, 22 do
		local size = 5 + noise(index, 7) * 7
		local holder = UIUtil.Create("Frame", {
			Name = "Star" .. index,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.03 + noise(index, 8) * 0.94, 0.04 + noise(index, 9) * 0.9),
			Size = UDim2.fromOffset(size, size),
			BackgroundTransparency = 1,
			ZIndex = 2,
			Parent = backdrop,
		})
		HousePatterns.Sparkle(holder, size / 2, size / 2, size, WHITE, 0.2, 1)
		holder:SetAttribute("Phase", noise(index, 10) * 6)
		table.insert(stars, holder)
	end

	------------------------------------------------------------------
	-- Toit, pelouse (derrière la coque) et poussières (dans la pièce)
	------------------------------------------------------------------
	local roof = UIUtil.Create("Frame", {
		Name = "Roof",
		BackgroundTransparency = 1,
		ZIndex = 1,
		Parent = room,
	})
	local ground = UIUtil.Create("Frame", {
		Name = "Ground",
		BackgroundTransparency = 1,
		ZIndex = 1,
		Parent = room,
	})
	local motesLayer = UIUtil.Create("Frame", {
		Name = "Motes",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = zMotes,
		Parent = room,
	})

	local atticGlass: Frame? = nil
	local atticGlow: Frame? = nil
	local puffs: { Puff } = {}
	local motes: { Mote } = {}

	local function clearChildren(frame: Frame)
		for _, child in ipairs(frame:GetChildren()) do
			child:Destroy()
		end
	end

	local function buildRoof()
		clearChildren(roof)
		table.clear(puffs)
		local roofH = HouseScenery.ROOF
		local baseW = width + shellSize * 2 + 40
		local topW = math.max(200, width * 0.46)
		local bottom = -ceil + 6 -- le bas du toit passe derrière le plafond
		roof.Position = UDim2.fromOffset(width / 2 - baseW / 2, bottom - roofH)
		roof.Size = UDim2.fromOffset(baseW, roofH)

		-- Cheminée (derrière le toit) + fumée
		local chimneyX = baseW * 0.74
		local chimney = Box(roof, chimneyX, -18, 30, 44, Color3.fromRGB(214, 128, 132), 0, 1)
		Round(chimney, UDim.new(0, 4))
		UIUtil.Stroke(chimney, Color3.fromRGB(150, 76, 96), 2, 0.2)
		for row = 0, 2 do
			Box(chimney, 0, 8 + row * 10, 30, 2, Color3.fromRGB(250, 214, 200), 0.3, 2)
		end
		local cap = Box(roof, chimneyX - 4, -24, 38, 9, Color3.fromRGB(190, 108, 118), 0, 2)
		Round(cap, UDim.new(0, 4))
		for index = 1, 3 do
			local puff = Circle(roof, chimneyX + 15, -30, 14 + index * 4, 14 + index * 4, WHITE, 0.3, 1)
			table.insert(puffs, { Frame = puff, Phase = (index - 1) / 3 })
		end

		-- Pan du toit : trapèze lisse (fines tranches) + rangées de tuiles arrondies
		local slices = 28
		for index = 0, slices - 1 do
			local k = (index + 1) / slices
			local rowW = topW + (baseW - topW) * k
			local band = Box(roof, baseW / 2 - rowW / 2, index * roofH / slices, rowW, roofH / slices + 0.8, ROOF_COLOR, 0, 3)
			band.BackgroundColor3 = ROOF_COLOR:Lerp(ROOF_DARK, 0.1 + k * 0.15)
		end
		local rows = 4
		for row = 1, rows do
			local k = row / rows
			local y = roofH * k - 4
			local rowW = topW + (baseW - topW) * (y / roofH)
			local tile = 24
			local count = math.max(1, math.floor(rowW / tile))
			local offset = (rowW - count * tile) / 2 + (row % 2) * tile / 2
			for index = 0, count - 1 - (row % 2) do
				local cx = baseW / 2 - rowW / 2 + offset + index * tile + tile / 2
				local shingle = Circle(roof, cx, y, tile - 3, 12, ROOF_DARK, 0.45, 4)
				shingle.Size = UDim2.fromOffset(tile - 3, 10)
			end
		end
		-- Reflet doux sur le pan
		local gloss = Box(roof, baseW / 2 - topW / 2 + 16, 6, topW * 0.5, 5, WHITE, 0.55, 5)
		Round(gloss)

		-- Bord du toit (gouttière) festonné
		local eave = Box(roof, -6, roofH - 4, baseW + 12, 10, ROOF_DARK, 0, 5)
		Round(eave)
		UIUtil.Stroke(eave, ROOF_DARK:Lerp(BLACK, 0.3), 1.5, 0.3)
		local scallop = 22
		local x = scallop / 2 - 6
		while x < baseW + 6 do
			Circle(roof, x, roofH + 6, scallop - 2, 14, ROOF_DARK, 0, 4)
			x += scallop
		end
		-- Faîtage
		local ridge = Box(roof, baseW / 2 - topW / 2 - 8, -5, topW + 16, 9, ROOF_DARK, 0, 5)
		Round(ridge)
		UIUtil.Stroke(ridge, ROOF_DARK:Lerp(BLACK, 0.3), 1.5, 0.3)
		HousePatterns.Heart(roof, baseW / 2, -12, 20, C.Heart, 0, 6)

		-- Lucarne ronde au milieu (lumière chaude la nuit)
		local cx, cy = baseW / 2, roofH * 0.52
		local glow = Circle(roof, cx, cy, 70, 70, Color3.fromRGB(255, 220, 140), 1, 5)
		atticGlow = glow
		local frame = Circle(roof, cx, cy, 44, 44, C.Cream, 0, 6)
		UIUtil.Stroke(frame, C.WoodDark, 2, 0.3)
		local glass = Circle(roof, cx, cy, 32, 32, Color3.fromRGB(180, 222, 255), 0, 7)
		UIUtil.Gradient(glass, ColorSequence.new(WHITE, Color3.fromRGB(200, 200, 225)), 90)
		atticGlass = glass
		Box(roof, cx - 1.5, cy - 16, 3, 32, C.Cream, 0, 8)
		Box(roof, cx - 16, cy - 1.5, 32, 3, C.Cream, 0, 8)
		local shine = Box(roof, cx - 11, cy - 11, 8, 4, WHITE, 0.3, 9)
		Round(shine)
	end

	local function buildGround()
		clearChildren(ground)
		local groundW = width + shellSize * 2 + 70
		local top = height + shellSize - 6
		ground.Position = UDim2.fromOffset(width / 2 - groundW / 2, top)
		ground.Size = UDim2.fromOffset(groundW, HouseScenery.GROUND + 6)
		local lawn = Box(ground, 0, 6, groundW, HouseScenery.GROUND, GRASS, 0, 1)
		Round(lawn)
		UIUtil.Stroke(lawn, GRASS_DARK, 2, 0.2)
		UIUtil.Gradient(lawn, ColorSequence.new(WHITE, Color3.fromRGB(215, 225, 215)), 90)
		-- Petites touffes et fleurs devant la maison
		local count = math.floor(groundW / 60)
		for index = 0, count do
			local x = 16 + index * (groundW - 32) / count
			Circle(ground, x, 8 + noise(index, 20) * 3, 16, 12, GRASS:Lerp(GRASS_DARK, 0.3), 0, 2)
			if index % 2 == 1 then
				local colors = { C.Pink, C.Butter, WHITE, C.Lilac }
				local petal = colors[index % #colors + 1]
				local fx = x + 12
				for _, d in ipairs({ Vector2.new(-3, 0), Vector2.new(3, 0), Vector2.new(0, -3), Vector2.new(0, 3) }) do
					Circle(ground, fx + d.X, 12 + d.Y, 5, 5, petal, 0, 3)
				end
				Circle(ground, fx, 12, 3.5, 3.5, C.Butter:Lerp(C.Peach, 0.4), 0, 4)
			end
		end
	end

	local function buildMotes()
		clearChildren(motesLayer)
		table.clear(motes)
		for index = 1, 14 do
			local size = 3 + noise(index, 30) * 3
			local mote = Circle(motesLayer, 0, 0, size, size, WHITE, 0.35, 1)
			table.insert(motes, {
				Frame = mote,
				X = 0.08 + noise(index, 31) * 0.84,
				Y = noise(index, 32),
				Speed = 0.015 + noise(index, 33) * 0.025,
				Phase = noise(index, 34) * 6,
			})
		end
	end

	-- La nuit, le toit et la pelouse passent dans le bleu (couleurs du jour gardées en attribut)
	local NIGHT_TINT = Color3.fromRGB(40, 36, 100)
	local function tint(container: Frame)
		for _, child in ipairs(container:GetDescendants()) do
			if child:IsA("Frame") then
				local day = child:GetAttribute("DayColor")
				if typeof(day) ~= "Color3" then
					day = child.BackgroundColor3
					child:SetAttribute("DayColor", day)
				end
				child.BackgroundColor3 = dark and (day :: Color3):Lerp(NIGHT_TINT, 0.42) or day :: Color3
			end
		end
	end

	local function paint()
		sky.Color = dark and SKY_NIGHT or SKY_DAY
		tint(roof)
		tint(ground)
		for _, cloud in ipairs(clouds) do
			for _, child in ipairs(cloud.Frame:GetDescendants()) do
				if child:IsA("Frame") then
					child.BackgroundColor3 = dark and Color3.fromRGB(120, 110, 180) or WHITE
				end
			end
		end
		for _, star in ipairs(stars) do
			for _, child in ipairs(star:GetDescendants()) do
				if child:IsA("Frame") then
					child.BackgroundColor3 = dark and Color3.fromRGB(255, 244, 190) or WHITE
				end
			end
		end
		local glass = atticGlass
		if glass then
			glass.BackgroundColor3 = dark and Color3.fromRGB(255, 214, 120) or Color3.fromRGB(180, 222, 255)
		end
		local glow = atticGlow
		if glow then
			glow.BackgroundTransparency = dark and 0.72 or 1
		end
		for _, mote in ipairs(motes) do
			mote.Frame.BackgroundColor3 = dark and Color3.fromRGB(255, 240, 140) or WHITE
		end
	end

	local scenery = {} :: any

	function scenery:Rebuild(newWidth: number, newHeight: number, _wallHeight: number)
		width, height = newWidth, newHeight
		buildRoof()
		buildGround()
		buildMotes()
		paint()
	end

	-- Toit assorti à l'immeuble (reconstruit seulement si le style change)
	function scenery:SetPalette(exterior: string?)
		local name = exterior and ROOF_PALETTES[exterior :: string] and exterior :: string or "Cottage"
		if name == paletteName then
			return
		end
		paletteName = name
		ROOF_COLOR, ROOF_DARK = ROOF_PALETTES[name][1], ROOF_PALETTES[name][2]
		buildRoof()
		paint()
	end

	function scenery:SetDark(value: boolean)
		dark = value
		paint()
	end

	function scenery:Update(dt: number)
		clock += dt
		-- Nuages qui passent (ils repartent de l'autre côté)
		for _, cloud in ipairs(clouds) do
			cloud.X = (cloud.X + cloud.Speed * dt) % 1.3
			cloud.Frame.Position = UDim2.fromScale(cloud.X - 0.15, cloud.Y)
		end
		-- Étoiles / étincelles qui scintillent
		for _, star in ipairs(stars) do
			local phase = tonumber(star:GetAttribute("Phase")) or 0
			local wave = 0.5 + 0.5 * math.sin(clock * 2 + phase)
			local base = dark and 0.05 or 0.45
			for _, child in ipairs(star:GetChildren()) do
				if child:IsA("Frame") then
					child.BackgroundTransparency = base + wave * 0.45
				end
			end
		end
		-- Fumée de la cheminée : monte, grossit et s'efface
		for _, puff in ipairs(puffs) do
			local t = (clock * 0.35 + puff.Phase) % 1
			local size = 10 + t * 18
			puff.Frame.Size = UDim2.fromOffset(size, size)
			local roofW = width + shellSize * 2 + 40
			puff.Frame.Position = UDim2.fromOffset(roofW * 0.74 + 15 - size / 2 + math.sin(t * 6) * 4, -30 - t * 46 - size / 2)
			puff.Frame.BackgroundTransparency = 0.25 + t * 0.75
		end
		-- Poussières de lumière (lucioles la nuit) : montent doucement en ondulant
		for _, mote in ipairs(motes) do
			mote.Y = (mote.Y - mote.Speed * dt) % 1
			local x = mote.X + math.sin(clock * 0.8 + mote.Phase) * 0.012
			local y = 0.1 + mote.Y * 0.85
			mote.Frame.Position = UDim2.new(x, 0, y, 0)
			local twinkle = 0.5 + 0.5 * math.sin(clock * 2.3 + mote.Phase)
			mote.Frame.BackgroundTransparency = (dark and 0.1 or 0.45) + twinkle * 0.4
		end
	end

	return scenery :: Scenery
end

return HouseScenery
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">HouseShop</string>
              <string name="Source"><![CDATA[--[[
	HouseShop (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > House > HouseShop

	Tiroir "🛍️ Boutique" de la maison (glisse depuis la droite) :
	  - onglets : 🛋️ Objets / 🎨 Style de pièce / 🌷 Dehors / 🚪 Pièces /
	    🏡 Maisons ; l'onglet choisi s'élargit (icône + nom), les autres
	    gardent leur icône : les 5 onglets tiennent même sur téléphone ;
	  - (v9.1) "Style de pièce" : sous-onglets 🧱 Murs, 🟫 Sols, 🎀 Boiseries,
	    💡 Lumière (ambiance), 🪟 Vue (par la fenêtre), par pièce ; "Dehors" :
	    🏠 Peinture de la façade, 🔺 Toit, ✨ Motif du toit, 🌷 Jardin (déco
	    à sortir / ranger, GardenSlots places) ; chaque carte a son aperçu
	    dessiné (House/HouseLookCards) et s'essaie au survol / au toucher
	    (sur la pièce ouverte ou sur la façade) ; pastille "🆕 Nouveautés"
	    dans les objets ;
	  - Objets : pastilles de catégories (+ "préférés" de la pièce ouverte)
	    et grille de cartes (dessin sur vignette pastel, nom, ❤️ confort,
	    exemplaires possédés, "✨ Nouveau" si abordable, prix du prochain
	    exemplaire, "MAX" si MaxOwned) ; badge ✨ sur les objets préférés de
	    la pièce ouverte (bonus d'harmonie) ;
	  - Murs / Sols : PAR PIÈCE. Bandeau en haut : la pièce modifiée (la
	    pièce ouverte) ou, depuis la vue de la maison, un choix de pièce ;
	    ✓ = posé dans CETTE pièce ; survol (ou toucher l'aperçu) = essayer ;
	  - Pièces : les 12 types de pièce (aperçu murs / sol, objets préférés,
	    prix de la prochaine pièce, compteur x/y) : "buyRoom" { Type } ;
	    maison pleine -> l'onglet Maisons ;
	  - Maisons : chaque bâtiment avec sa silhouette dessinée (grille des
	    pièces, pièces du joueur dans la maison actuelle), étages x pièces,
	    objets max par pièce, prix / possédé / habité.
	Visites à l'océan : les objets / styles / maisons chers se débloquent
	avec les renaissances (Formulas.GetHouseRequiredRebirths) : ils restent
	visibles, voilés, avec un cadenas "🔒 Après N visites 🌊" et ne
	s'achètent pas (le serveur refuse aussi).
	Achats : HouseCommon.Invoke (pcall), sons, confettis et bandeaux ;
	message du serveur affiché en cas de refus. Les cartes sont construites
	au premier affichage d'un onglet, les dessins peints par petits paquets.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local Interface = require(Client.Interface)
local Effects = require(Client.Effects)
local ClientState = require(Client.ClientState)
local SoundManager = require(Client.SoundManager)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Locale = require(ReplicatedStorage.Shared.Locale)
local HouseCommon = require(script.Parent.HouseCommon)
local NeedDopamine = require(script.Parent.Parent.NeedDopamine)
local HouseArt = require(script.Parent.HouseArt)
local HousePatterns = require(script.Parent.HousePatterns)
local HouseButtons = require(script.Parent.HouseButtons)
local HouseSurfaces = require(script.Parent.HouseSurfaces)
local HouseLookCards = require(script.Parent.HouseLookCards)

type Item = HouseCommon.Item
type Style = HouseCommon.Style
type SizeDef = HouseCommon.SizeDef
type HouseData = HouseCommon.HouseData
type Room = HouseCommon.Room
type RoomTypeDef = HouseCommon.RoomTypeDef

local HouseShop = {}

local C = HouseCommon.Colors
local WHITE = Color3.new(1, 1, 1)
local BUY_COLOR = Theme.Colors.Green
local LOCKED_COLOR = Color3.fromRGB(150, 128, 196) -- bouton "verrouillé" (visites à l'océan)
local SOFT_STROKE = C.PinkSoft:Lerp(C.Pink, 0.3)
local CARD_HEIGHT = 178
local STYLE_CARD_HEIGHT = 158
local ROOM_CARD_HEIGHT = 128
local SIZE_ROW_HEIGHT = 132
local FAV_TILE = 32 -- vignette d'un objet / d'une catégorie préférée (carte de pièce)
local FAV_GAP = 4
local MAX_FAVS = 10
local TAB_ICON_WIDTH = 44 -- onglet non choisi (icône seule) : cible tactile
local LIST_INSET = 31 -- largeur du tiroir - largeur utile d'une liste (marges)
local LOOK_ART_W = 200 -- (v9.1) largeur de maquette des aperçus de personnalisation
-- Les objets ajoutés à partir de celui-ci forment la pastille "🆕 Nouveautés"
-- (v9.2 : les objets "cool" ; sinon ceux de la v9.1)
local NEW_ITEM = HouseCommon.ItemsById.RGBHeadset or HouseCommon.ItemsById.ToyChest
local NEW_FROM = (NEW_ITEM and NEW_ITEM.Order) or math.huge

export type Handlers = {
	Notify: (text: string, color: Color3?, title: string?) -> (),
	OnItemBought: (itemId: string) -> (),
	OnPlaceRequest: (itemId: string) -> (),
	OnPreview: (kind: string, id: string?) -> (),
	OnHouseChanged: () -> (),
	BeforeHouseChange: () -> (),
	GetAvailable: (itemId: string) -> number,
	-- Pièce dont on modifie murs / sol (nil = vue de la maison : choix dans la boutique)
	GetCurrentRoom: (() -> string?)?,
	-- Après un "buyRoom" réussi, quand la pièce est arrivée dans ClientState.Data
	OnRoomBought: ((roomId: string) -> ())?,
	-- Après "buySize" / "setSize" réussi, quand le nouvel état est arrivé
	OnSizeChanged: (() -> ())?,
}

export type Shop = {
	Frame: Frame,
	Open: (section: string?) -> (),
	Close: () -> (),
	IsOpen: () -> boolean,
	Refresh: () -> (),
	SetWidth: (width: number) -> (),
}

type ItemCard = {
	Item: Item,
	Cell: Frame,
	Card: Frame,
	Button: TextButton,
	Owned: Frame,
	New: Frame,
	Fav: Frame,
	Comfort: TextLabel,
	Stroke: UIStroke,
	Rank: number,
	Tile: GuiObject,
	Emoji: TextLabel,
	Painted: boolean,
	Lock: Frame?,
}

type StyleCard = {
	Kind: string,
	Style: Style,
	Card: Frame,
	Button: TextButton,
	Stroke: UIStroke,
	Check: Frame,
	Preview: GuiObject,
	Lock: Frame?,
}

type FavTile = {
	Frame: Frame,
	Paint: (() -> ())?,
}

type RoomCard = {
	Type: RoomTypeDef,
	Card: Frame,
	Button: TextButton,
	Stroke: UIStroke,
	Count: Frame,
	Favs: { FavTile },
	More: Frame,
}

type MiniCell = { Frame: Frame, Floor: Frame, Label: TextLabel }

type SizeRow = {
	Size: SizeDef,
	Row: Frame,
	Tile: Frame,
	Scale: UIScale,
	Natural: Vector2,
	Texts: { GuiObject },
	Button: TextButton,
	Stroke: UIStroke,
	Status: TextLabel,
	Cells: { [number]: MiniCell },
	CellKey: string,
	Lock: Frame?,
}

-- Onglets : Id, icône (onglet replié), texte (onglet choisi)
-- (v9.1) "🎨 Style de pièce" et "🌷 Dehors" regroupent des sous-onglets
local TAB_DEFS = {
	{ Id = "Items", Icon = "🛋️", Text = "🛋️ Items" },
	{ Id = "Style", Icon = "🎨", Text = "🎨 Room style" },
	{ Id = "Outside", Icon = "🌷", Text = "🌷 Outside" },
	{ Id = "Rooms", Icon = "🚪", Text = "🚪 Rooms" },
	{ Id = "Sizes", Icon = "🏡", Text = "🏡 Houses" },
}
-- Sous-onglets de chaque groupe (dans l'ordre) et leur nom
local GROUPS: { [string]: { string } } = {
	Style = { "Wallpapers", "Floors", "Trim", "Mood", "View" },
	Outside = { "Facade", "Roof", "RoofStyle", "Garden" },
}
local SUB_LABELS: { [string]: string } = {
	Wallpapers = "🧱 Walls",
	Floors = "🟫 Floors",
	Trim = "🎀 Trim",
	Mood = "💡 Light",
	View = "🪟 View",
	Facade = "🏠 Paint",
	Roof = "🔺 Roof",
	RoofStyle = "✨ Tiles",
	Garden = "🌷 Garden",
}
local GROUP_OF: { [string]: string } = {}
for group, list in pairs(GROUPS) do
	for _, id in ipairs(list) do
		GROUP_OF[id] = group
	end
end
-- Genre de personnalisation de chaque section de styles
local KIND_OF: { [string]: string } = {
	Wallpapers = "Wallpaper",
	Floors = "Floor",
	Trim = "Trim",
	Mood = "Mood",
	View = "View",
	Facade = "Facade",
	Roof = "Roof",
	RoofStyle = "RoofStyle",
	Garden = "Garden",
}
-- Sections "par pièce" (bandeau de la pièce en haut)
local ROOM_SECTIONS: { [string]: boolean } = { Wallpapers = true, Floors = true, Trim = true, Mood = true, View = true }
local PREVIEW_KINDS = { "Wallpaper", "Floor", "Trim", "Mood", "View", "Facade", "Roof", "RoofStyle", "Garden" }
local SECTION_ALIASES: { [string]: string } = {
	Houses = "Sizes",
	Walls = "Wallpapers",
	Wallpaper = "Wallpapers",
	Floor = "Floors",
	Room = "Rooms",
	Trims = "Trim",
	Moods = "Mood",
	Lighting = "Mood",
	Views = "View",
	Exterior = "Facade",
	Roofs = "Roof",
}

-- Petite étiquette arrondie dans une carte
local function tag(parent: Instance, text: string, color: Color3, textColor: Color3, props: { [string]: any }): Frame
	local chip = UIUtil.Chip({
		Name = props.Name or "Tag",
		Text = text,
		Color = color,
		TextColor3 = textColor,
		Height = props.Height or 20,
		TextSize = props.TextSize or 12,
		ZIndex = props.ZIndex or 6,
		Parent = parent,
	})
	chip.AnchorPoint = props.AnchorPoint or Vector2.zero
	chip.Position = props.Position or UDim2.new()
	return chip
end

local function setChipText(chip: Frame, text: string)
	local label = chip:FindFirstChild("Label") :: TextLabel?
	if label and label.Text ~= text then
		label.Text = text
	end
end

local function setText(label: TextLabel, text: string, color: Color3?)
	if label.Text ~= text then
		label.Text = text
	end
	if color then
		label.TextColor3 = color
	end
end

-- Texte d'une ligne (étiquette simple)
local function textLine(parent: Instance, name: string, props: { [string]: any }): TextLabel
	return UIUtil.Create("TextLabel", {
		Name = name,
		Position = props.Position,
		Size = props.Size,
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundTransparency = 1,
		Font = props.Font or Theme.Fonts.Body,
		Text = props.Text or "",
		TextColor3 = props.TextColor3 or Theme.Colors.TextDim,
		TextSize = props.TextSize or 13,
		TextWrapped = props.TextWrapped == true,
		TextTruncate = props.TextWrapped and Enum.TextTruncate.None or Enum.TextTruncate.AtEnd,
		TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left,
		TextYAlignment = props.TextYAlignment or Enum.TextYAlignment.Center,
		ZIndex = props.ZIndex or 35,
		Parent = parent,
	})
end

-- Bouton d'achat / d'action d'une carte
local function actionButton(parent: Instance, props: { [string]: any }): TextButton
	local button = UIUtil.NeonButton({
		Name = props.Name or "Action",
		Text = "",
		Size = props.Size,
		AnchorPoint = props.AnchorPoint,
		Position = props.Position,
		Color = BUY_COLOR,
		CornerRadius = props.CornerRadius or 14,
		MaxTextSize = props.MaxTextSize or 15,
		ZIndex = props.ZIndex or 6,
		Parent = parent,
	})
	return button
end

-- Change l'aspect d'un bouton d'action
local function paintButton(button: TextButton, text: string, color: Color3, enabled: boolean, textColor: Color3?)
	if button.Text ~= text then
		button.Text = text
	end
	button:SetAttribute("BaseColor", color)
	UIUtil.SetButtonEnabled(button, enabled)
	button.TextColor3 = textColor or Theme.ContrastText(color)
end

-- Texte "🔒 Après N visites à l'océan" (court, pour les cartes)
local function lockText(required: number): string
	if required == 1 then
		return Locale.T("After 1 ocean visit")
	end
	return Locale.T("After %d ocean visits", required)
end

-- Voile "verrouillé" posé sur une vignette : cadenas + nombre de visites
-- (créé à la demande : seules les entrées verrouillées paient ces Frames)
local function lockOverlay(parent: GuiObject, compact: boolean): Frame
	local veil = UIUtil.Create("Frame", {
		Name = "Lock",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(84, 64, 130),
		BackgroundTransparency = 0.5,
		ZIndex = 45,
		Parent = parent,
	})
	UIUtil.Corner(veil, 12)
	UIUtil.Gradient(veil, ColorSequence.new(Color3.fromRGB(150, 190, 255), Color3.fromRGB(255, 255, 255)), 90)
	local badge = UIUtil.Create("Frame", {
		Name = "Badge",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, compact and -8 or -10),
		Size = UDim2.fromOffset(compact and 30 or 36, compact and 30 or 36),
		BackgroundColor3 = WHITE,
		ZIndex = 46,
		Parent = veil,
	})
	UIUtil.Corner(badge, UDim.new(1, 0))
	UIUtil.Stroke(badge, C.Lilac, 2, 0)
	UIUtil.Create("TextLabel", {
		Name = "Icon",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		Text = "🔒",
		TextSize = compact and 16 or 19,
		ZIndex = 47,
		Parent = badge,
	})
	local wave = UIUtil.Create("TextLabel", {
		Name = "Wave",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -4),
		Size = UDim2.new(1, -8, 0, compact and 16 or 18),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = "",
		TextColor3 = WHITE,
		TextScaled = true,
		TextStrokeTransparency = 0.55,
		TextStrokeColor3 = Color3.fromRGB(60, 44, 92),
		ZIndex = 47,
		Parent = veil,
	})
	UIUtil.Create("UITextSizeConstraint", { MaxTextSize = compact and 12 or 13, Parent = wave })
	return veil
end

local function setLock(overlay: Frame, required: number)
	local wave = overlay:FindFirstChild("Wave") :: TextLabel?
	if wave then
		local text = "🌊 " .. lockText(required)
		if wave.Text ~= text then
			wave.Text = text
		end
	end
end

-- Petit rectangle arrondi (dessins des maisons)
local function box(parent: Instance, x: number, y: number, w: number, h: number, color: Color3, props: { [string]: any }?): Frame
	local options = props or {}
	local frame = UIUtil.Create("Frame", {
		Name = options.Name or "Part",
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, h),
		BackgroundColor3 = color,
		BackgroundTransparency = options.Transparency or 0,
		BorderSizePixel = 0,
		ZIndex = options.ZIndex or 36,
		Parent = parent,
	})
	if options.Radius then
		UIUtil.Corner(frame, options.Radius)
	end
	if options.Stroke then
		UIUtil.Stroke(frame, options.Stroke, options.StrokeThickness or 1.5, 0)
	end
	return frame
end

-- Pièces triées par emplacement (rez-de-chaussée à gauche d'abord)
local function sortedRooms(house: HouseData): { Room }
	local rooms = table.clone(house.Rooms)
	table.sort(rooms, function(a, b)
		return a.Slot < b.Slot
	end)
	return rooms
end

-- Noms affichés des pièces ("🛏️ Chambre", "🛏️ Chambre 2" s'il y en a plusieurs)
local function roomLabels(house: HouseData): { [string]: string }
	local rooms = sortedRooms(house)
	local counts: { [string]: number } = {}
	for _, room in ipairs(rooms) do
		counts[room.Type] = (counts[room.Type] or 0) + 1
	end
	local seen: { [string]: number } = {}
	local labels: { [string]: string } = {}
	for _, room in ipairs(rooms) do
		local roomType = HouseCommon.GetRoomType(room)
		local label = roomType and (roomType.Icon .. " " .. HouseCommon.Name(roomType)) or room.Id
		if (counts[room.Type] or 0) > 1 then
			seen[room.Type] = (seen[room.Type] or 0) + 1
			label ..= " " .. tostring(seen[room.Type])
		end
		labels[room.Id] = label
	end
	return labels
end

-- "50" : bonus d'harmonie en %
local function harmonyPercent(): string
	return HouseCommon.FormatPercent((HouseCommon.Config.HarmonyBonus or 0) * 100)
end

-- "4.5" / "3" : confort lisible
local function formatComfort(value: number): string
	if math.abs(value - math.floor(value)) < 0.05 then
		return tostring(math.floor(value + 0.5))
	end
	return string.format("%.1f", value)
end

function HouseShop.new(parent: Frame, handlers: Handlers): Shop
	local shop: Shop
	local isOpen = false
	local section = "Items"
	local category = "All"
	local busy = false
	local built: { [string]: boolean } = {}
	local itemCards: { ItemCard } = {}
	local styleCards: { StyleCard } = {}
	local roomCards: { RoomCard } = {}
	local sizeRows: { SizeRow } = {}
	local stickyPreview: { Kind: string, Id: string }? = nil
	local hoverPreview: { Kind: string, Id: string }? = nil
	local appliedPreview: { [string]: string } = {} -- essais déjà envoyés (par genre)
	local lastSub: { [string]: string } = { Style = "Wallpapers", Outside = "Facade" }
	local width = 380
	local openToken = 0
	local chosenRoomId: string? = nil -- pièce choisie dans la boutique (vue de la maison)
	local previewRoomId: string? = nil -- pièce visée par l'essai en cours
	local favRoomKey = "" -- type de la pièce ouverte (filtre / badges ✨)
	local refresh: () -> ()
	local layoutSizeRow: (row: SizeRow) -> ()
	local roomsHeader: Frame
	local roomsHarmony: TextLabel

	----------------------------------------------------------------------
	-- Pièce visée
	----------------------------------------------------------------------

	-- Pièce ouverte dans l'interface (nil = vue de la maison)
	local function currentRoom(house: HouseData): Room?
		local getter = handlers.GetCurrentRoom
		if not getter then
			return nil
		end
		local ok, roomId = pcall(getter)
		if ok and type(roomId) == "string" then
			return HouseCommon.GetRoom(house, roomId)
		end
		return nil
	end

	-- Pièce dont on change murs / sol : (pièce, verrouillée ?)
	-- verrouillée = la pièce ouverte ; sinon celle choisie dans la boutique
	-- (par défaut la première : rez-de-chaussée, à gauche)
	local function targetRoom(house: HouseData): (Room?, boolean)
		local current = currentRoom(house)
		if current then
			return current, true
		end
		local chosen = HouseCommon.GetRoom(house, chosenRoomId)
		if chosen then
			return chosen, false
		end
		return sortedRooms(house)[1], false
	end

	----------------------------------------------------------------------
	-- Cadre du tiroir
	----------------------------------------------------------------------

	local drawer = UIUtil.Create("Frame", {
		Name = "ShopDrawer",
		Size = UDim2.new(0, width, 1, 0),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, width + 40, 0, 0),
		BackgroundColor3 = WHITE,
		Active = true,
		Visible = false,
		ZIndex = 30,
		Parent = parent,
	})
	UIUtil.Corner(drawer, 20)
	UIUtil.Stroke(drawer, C.Pink, 2, 0.25)
	UIUtil.Shadow(drawer, 6, 0.8, 4)
	UIUtil.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 12),
		PaddingRight = UDim.new(0, 12),
		PaddingTop = UDim.new(0, 10),
		PaddingBottom = UDim.new(0, 10),
		Parent = drawer,
	})
	-- Clic dans le tiroir (zone vide) : ne traverse pas jusqu'à la pièce / la maison
	HouseButtons.Sink(drawer)

	-- En-tête : titre, porte-monnaie, ✕
	UIUtil.Create("TextLabel", {
		Name = "Title",
		Size = UDim2.new(1, -150, 0, 30),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = Locale.T("🛍️ House shop"),
		TextColor3 = C.Ink,
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 31,
		Parent = drawer,
	})
	local wallet = UIUtil.Chip({
		Name = "Wallet",
		Text = "💧 0",
		Color = C.MintSoft,
		TextColor3 = C.Ink,
		Height = 28,
		TextSize = 15,
		ZIndex = 31,
		Parent = drawer,
	})
	wallet.AnchorPoint = Vector2.new(1, 0)
	wallet.Position = UDim2.new(1, -44, 0, 1)
	-- ✕ commun du jeu (zone tactile agrandie)
	UIUtil.CloseButton({
		Name = "Close",
		Size = 34,
		Hitbox = 44,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, -2),
		ZIndex = 31,
		Parent = drawer,
		OnClose = function()
			shop.Close()
		end,
	})

	-- Onglets : même look que UIUtil.Tabs (fond gris clair, pastille blanche
	-- bordée), mais l'onglet choisi prend la place libre et affiche son nom
	local tabBar = UIUtil.Create("Frame", {
		Name = "Sections",
		Position = UDim2.fromOffset(0, 40),
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundColor3 = Theme.Colors.Surface,
		ZIndex = 31,
		Parent = drawer,
	})
	UIUtil.Corner(tabBar, UDim.new(1, 0))
	UIUtil.Stroke(tabBar, Theme.Colors.Divider, 1)
	-- Onglet choisi : pastille "bonbon" rose brillante (reflet + lèvre)
	local tabIndicator = UIUtil.Create("Frame", {
		Name = "Indicator",
		Position = UDim2.fromOffset(3, 3),
		Size = UDim2.fromOffset(80, 30),
		BackgroundColor3 = C.PinkDeep:Lerp(C.Ink, 0.3),
		ZIndex = 32,
		Parent = tabBar,
	})
	UIUtil.Corner(tabIndicator, UDim.new(1, 0))
	UIUtil.Stroke(tabIndicator, C.PinkDeep:Lerp(C.Ink, 0.45), 1.5, 0.2)
	local indicatorFace = UIUtil.Create("Frame", {
		Name = "Face",
		Size = UDim2.new(1, 0, 1, -3),
		BackgroundColor3 = C.Pink,
		ZIndex = 32,
		Parent = tabIndicator,
	})
	UIUtil.Corner(indicatorFace, UDim.new(1, 0))
	UIUtil.Gradient(indicatorFace, ColorSequence.new(Color3.fromRGB(255, 236, 246), Color3.fromRGB(236, 200, 220)), 90)
	local indicatorGloss = UIUtil.Create("Frame", {
		Name = "Gloss",
		Position = UDim2.new(0, 8, 0, 2),
		Size = UDim2.new(1, -16, 0.42, 0),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.45,
		ZIndex = 32,
		Parent = indicatorFace,
	})
	UIUtil.Corner(indicatorGloss, UDim.new(1, 0))
	UIUtil.Create("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(0.2, 1), Parent = indicatorGloss })
	local tabSelectedColor = WHITE
	local tabButtons: { [string]: TextButton } = {}
	local selectedTab = "Items"

	local function tabGeometry(): { [string]: { X: number, W: number } }
		local inner = math.max(0, width - 24 - 6)
		local iconWidth = math.min(TAB_ICON_WIDTH, math.floor(inner / #TAB_DEFS))
		local selectedWidth = inner - iconWidth * (#TAB_DEFS - 1)
		local geometry = {}
		local x = 3
		for _, def in ipairs(TAB_DEFS) do
			local w = def.Id == selectedTab and selectedWidth or iconWidth
			geometry[def.Id] = { X = x, W = w }
			x += w
		end
		return geometry
	end

	local function layoutTabs(animated: boolean)
		local geometry = tabGeometry()
		for _, def in ipairs(TAB_DEFS) do
			local button = tabButtons[def.Id]
			local spot = geometry[def.Id]
			local selected = def.Id == selectedTab
			local text = selected and Locale.T(def.Text) or def.Icon
			if button.Text ~= text then
				button.Text = text
			end
			button.TextSize = selected and 14 or 17
			button.TextColor3 = selected and tabSelectedColor or Theme.Colors.TextDim
			local position = UDim2.fromOffset(spot.X, -4)
			local size = UDim2.fromOffset(spot.W, 44)
			if animated then
				UIUtil.Tween(button, 0.25, { Position = position, Size = size }, Enum.EasingStyle.Quint)
			else
				button.Position = position
				button.Size = size
			end
			if selected then
				local indicatorPosition = UDim2.fromOffset(spot.X, 3)
				local indicatorSize = UDim2.fromOffset(spot.W, 30)
				if animated then
					UIUtil.Tween(tabIndicator, 0.25, { Position = indicatorPosition, Size = indicatorSize }, Enum.EasingStyle.Quint)
				else
					tabIndicator.Position = indicatorPosition
					tabIndicator.Size = indicatorSize
				end
			end
		end
	end

	for index, def in ipairs(TAB_DEFS) do
		-- Zone cliquable plus haute que la barre (4 px de chaque côté)
		local button = UIUtil.Create("TextButton", {
			Name = def.Id,
			Size = UDim2.fromOffset(TAB_ICON_WIDTH, 44),
			Position = UDim2.fromOffset(3 + (index - 1) * TAB_ICON_WIDTH, -4),
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Font = Theme.Fonts.Title,
			Text = def.Icon,
			TextColor3 = Theme.Colors.TextDim,
			TextSize = 17,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 33,
			Parent = tabBar,
		})
		tabButtons[def.Id] = button
		button.MouseEnter:Connect(function()
			if def.Id ~= selectedTab then
				button.TextColor3 = Theme.Colors.Text
			end
		end)
		button.MouseLeave:Connect(function()
			button.TextColor3 = def.Id == selectedTab and tabSelectedColor or Theme.Colors.TextDim
		end)
		button.Activated:Connect(function()
			if def.Id ~= selectedTab then
				SoundManager.Play("Click", 1.1)
				shop.Open(def.Id)
			end
		end)
	end

	local body = UIUtil.Create("Frame", {
		Name = "Body",
		Size = UDim2.new(1, 0, 1, -84),
		Position = UDim2.fromOffset(0, 84),
		BackgroundTransparency = 1,
		ZIndex = 31,
		Parent = drawer,
	})

	local function scroller(name: string, top: number): ScrollingFrame
		local list = UIUtil.Create("ScrollingFrame", {
			Name = name,
			Size = UDim2.new(1, 6, 1, -top),
			Position = UDim2.fromOffset(0, top),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 5,
			ScrollBarImageColor3 = C.Pink,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			Visible = false,
			ZIndex = 32,
			Parent = body,
		})
		-- (3 px à gauche / en haut : contour épais de la carte choisie jamais coupé)
		UIUtil.Create("UIPadding", {
			PaddingTop = UDim.new(0, 4),
			PaddingLeft = UDim.new(0, 3),
			PaddingRight = UDim.new(0, 10),
			PaddingBottom = UDim.new(0, 12),
			Parent = list,
		})
		return list
	end

	local function setListTop(list: ScrollingFrame, top: number)
		list.Position = UDim2.fromOffset(0, top)
		list.Size = UDim2.new(1, 6, 1, -top)
	end

	-- Section Objets : pastilles de catégories + grille
	local categoryRow = UIUtil.Create("ScrollingFrame", {
		Name = "Categories",
		Size = UDim2.new(1, 0, 0, 38),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollingDirection = Enum.ScrollingDirection.X,
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 0,
		ZIndex = 32,
		Parent = body,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6),
		Parent = categoryRow,
	})
	UIUtil.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 2),
		PaddingRight = UDim.new(0, 40),
		Parent = categoryRow,
	})
	-- La rangée défile : fondu blanc + flèche "›" à droite, pour qu'une
	-- pastille coupée au bord se lise comme "il y en a d'autres" (la flèche
	-- fait défiler ; elle disparaît au bout de la rangée)
	local moreHint = UIUtil.Create("Frame", {
		Name = "MoreCategories",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(56, 38),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 34,
		Parent = body,
	})
	UIUtil.Create("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.45, 0),
			NumberSequenceKeypoint.new(1, 0),
		}),
		Parent = moreHint,
	})
	local moreButton = UIUtil.PillButton({
		Name = "More",
		Text = "›",
		Color = C.Pink,
		TextColor3 = WHITE,
		Height = 28,
		TextSize = 20,
		Round = true,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -3, 0.5, 0),
		ZIndex = 35,
		Parent = moreHint,
	})
	local function refreshMoreHint()
		local window = categoryRow.AbsoluteWindowSize.X
		local canvas = categoryRow.AbsoluteCanvasSize.X
		moreHint.Visible = categoryRow.Visible and canvas > window + categoryRow.CanvasPosition.X + 4
	end
	moreButton.Activated:Connect(function()
		local maxX = math.max(0, categoryRow.AbsoluteCanvasSize.X - categoryRow.AbsoluteWindowSize.X)
		local target = math.min(maxX, categoryRow.CanvasPosition.X + 140)
		UIUtil.Tween(categoryRow, 0.25, { CanvasPosition = Vector2.new(target, 0) })
	end)
	categoryRow:GetPropertyChangedSignal("CanvasPosition"):Connect(refreshMoreHint)
	categoryRow:GetPropertyChangedSignal("AbsoluteCanvasSize"):Connect(refreshMoreHint)
	categoryRow:GetPropertyChangedSignal("AbsoluteWindowSize"):Connect(refreshMoreHint)
	categoryRow:GetPropertyChangedSignal("Visible"):Connect(refreshMoreHint)
	local itemsList = scroller("ItemsList", 44)
	local itemsGrid = UIUtil.Create("UIGridLayout", {
		CellSize = UDim2.new(0.5, -6, 0, CARD_HEIGHT),
		CellPadding = UDim2.fromOffset(8, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = itemsList,
	})


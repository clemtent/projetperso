	local popIndex = 0
	for i = 1, 3 do
		local label = text({
			Name = "Pop" .. i,
			Text = "",
			Font = Enum.Font.LuckiestGuy,
			TextSize = 22,
			TextTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(150, 30),
			ZIndex = 22,
			Parent = video,
		})
		local stroke = UI.Stroke(label, Color3.fromRGB(40, 20, 30), 2.5, 1)
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		UI.Create("UIScale", { Parent = label })
		popLabels[i] = label
	end

	local function popWord(word: string, position: UDim2, color: Color3?)
		popIndex = popIndex % #popLabels + 1
		local label = popLabels[popIndex]
		local stroke = label:FindFirstChildOfClass("UIStroke")
		local scale = label:FindFirstChildOfClass("UIScale")
		label.Text = word
		label.TextColor3 = color or pick(POP_COLORS, random)
		label.Position = position
		label.Rotation = random:NextNumber(-14, 14)
		label.TextTransparency = 0
		if stroke then
			stroke.Transparency = 0
			UI.Tween(stroke, 0.6, { Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end
		if scale then
			scale.Scale = 0.3
			UI.Tween(scale, 0.22, { Scale = 1.15 }, Enum.EasingStyle.Back)
		end
		UI.Tween(label, 0.8, {
			Position = position + UDim2.fromOffset(random:NextInteger(-10, 10), -30),
			TextTransparency = 1,
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end

	local function crumbs()
		if not effectsOn() then
			return
		end
		for _ = 1, 4 do
			local size = random:NextInteger(2, 5)
			local crumb = box({
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0.5, random:NextInteger(-8, 8), 0, MOUTH_Y + 5),
				Size = UDim2.fromOffset(size, size),
				BackgroundColor3 = Color3.fromRGB(230, 170, 90),
				Rotation = random:NextNumber(0, 90),
				ZIndex = 13,
				Parent = video,
			})
			UI.Tween(crumb, 0.55, {
				Position = UDim2.new(0.5, random:NextInteger(-40, 40), 0, PLATE_Y - 5),
				Rotation = random:NextNumber(90, 360),
				BackgroundTransparency = 0.4,
			}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			Debris:AddItem(crumb, 0.6)
		end
	end

	local hearts: { { Label: TextLabel, Start: number, Life: number, X: number, Sway: number } } = {}
	for i = 1, MAX_HEARTS do
		local label = text({
			Name = "Heart" .. i,
			Text = "❤️",
			TextSize = 16,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(20, 20),
			Visible = false,
			ZIndex = 21,
			Parent = video,
		})
		hearts[i] = { Label = label, Start = -math.huge, Life = 1.6, X = 0, Sway = 0 }
	end
	local function spawnHeart(emoji: string?)
		for _, heart in ipairs(hearts) do
			if not heart.Label.Visible then
				heart.Label.Text = emoji or pick(HEARTS, random)
				heart.Start = os.clock()
				heart.Life = random:NextNumber(1.3, 2)
				heart.X = random:NextNumber(-12, 4)
				heart.Sway = random:NextNumber(0, math.pi * 2)
				heart.Label.Visible = true
				return
			end
		end
	end

	-- Likes (compteur qui grimpe)
	local likes = random:NextInteger(120, 400) * (1 + followers())
	local function addLikes(amount: number, bump: boolean)
		likes += amount
		if bump then
			likesScale.Scale = 1.3
			UI.Tween(likesScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		end
	end

	------------------------------------------------------------------
	-- Expressions (pilotées par OnRender)
	------------------------------------------------------------------
	local chewUntil = 0
	local openUntil = 0
	local wowUntil = 0
	local nextBlink = os.clock() + random:NextNumber(1.5, 4)
	local blinkUntil = 0

	local function wow(duration: number?)
		wowUntil = os.clock() + (duration or 0.6)
	end

	------------------------------------------------------------------
	-- Chat (Feature "LiveChat") : titre, message épinglé, liste qui défile
	-- en douceur (fondu en haut)
	------------------------------------------------------------------
	local CHAT_BG = Color3.fromRGB(32, 28, 46)
	local TITLE_H = 20 -- ligne de titre "💬 Chat"
	local PINNED_Y, PINNED_H = TITLE_H + 5, 30 -- message épinglé
	local LIST_Y = PINNED_Y + PINNED_H + 3 -- début de la liste des messages
	local LIST_H = VIDEO_H - LIST_Y - 3
	local chat = box({
		Name = "Chat",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -VIDEO_X, 0, VIDEO_Y),
		Size = UDim2.fromOffset(CHAT_W, VIDEO_H),
		BackgroundColor3 = CHAT_BG,
		ClipsDescendants = true,
		Visible = hasChat(),
		ZIndex = 2,
		Parent = card,
	}, 12)
	UI.Stroke(chat, Color3.fromRGB(70, 60, 100), 1)
	local chatTitle = text({
		Name = "Title",
		Text = "💬 <b>Chat</b>",
		RichText = true,
		TextSize = 13,
		TextColor3 = Color3.fromRGB(220, 212, 245),
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(8, 2),
		Size = UDim2.new(1, -12, 0, TITLE_H - 2),
		ZIndex = 3,
		Parent = chat,
	})
	box({ Position = UDim2.fromOffset(8, TITLE_H + 1), Size = UDim2.new(1, -16, 0, 1), BackgroundColor3 = Color3.fromRGB(80, 70, 110), ZIndex = 3, Parent = chat })

	-- Message épinglé
	local pinned = box({
		Name = "Pinned",
		Position = UDim2.fromOffset(5, PINNED_Y),
		Size = UDim2.new(1, -10, 0, PINNED_H),
		BackgroundColor3 = Color3.fromRGB(64, 50, 100),
		ZIndex = 3,
		Parent = chat,
	}, 6)
	UI.Stroke(pinned, Color3.fromRGB(150, 110, 230), 1, 0.4)
	local pinnedLabel = UI.Label({
		Text = "",
		RichText = true,
		Font = Theme.Fonts.Body,
		TextColor3 = Color3.fromRGB(235, 225, 255),
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(5, 2),
		Size = UDim2.new(1, -8, 1, -4),
		MaxTextSize = 11,
		ZIndex = 4,
		Parent = pinned,
	})

	local chatList = box({
		Name = "Messages",
		Position = UDim2.fromOffset(0, LIST_Y),
		Size = UDim2.new(1, 0, 0, LIST_H),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		ZIndex = 3,
		Parent = chat,
	})
	-- Le "rouleau" est accroché en bas et grandit vers le haut ; quand un
	-- message arrive, on le décale d'autant puis on le ramène en douceur
	local scroller = box({
		Name = "Scroller",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = chatList,
	})
	UI.Create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 3),
		Parent = scroller,
	})
	UI.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 6),
		PaddingRight = UDim.new(0, 5),
		PaddingBottom = UDim.new(0, 3),
		Parent = scroller,
	})
	-- Fondu en haut de la liste
	local fade = box({
		Name = "Fade",
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundColor3 = CHAT_BG,
		ZIndex = 8,
		Parent = chatList,
	})
	local fadeGradient = UI.Gradient(fade, ColorSequence.new(Color3.new(1, 1, 1)), 90)
	fadeGradient.Transparency = NumberSequence.new(0, 1)

	local lastScrollerHeight = 0
	local scrollTween: Tween? = nil
	ctx.Connect(scroller:GetPropertyChangedSignal("AbsoluteSize"), function()
		local height = scroller.AbsoluteSize.Y
		local delta = height - lastScrollerHeight
		lastScrollerHeight = height
		-- (les messages retirés sont en haut, hors champ : rien à animer)
		local ratio = chatList.AbsoluteSize.Y / LIST_H
		if delta <= 0 or ratio <= 0 then
			return
		end
		local offset = math.min(scroller.Position.Y.Offset + delta / ratio, 100)
		if scrollTween then
			scrollTween:Cancel()
		end
		scroller.Position = UDim2.new(0, 0, 1, offset)
		scrollTween = UI.Tween(scroller, 0.28, { Position = UDim2.fromScale(0, 1) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	end)

	-- Dons affichés en haut de la vidéo quand il n'y a pas de chat
	local donationStack = box({
		Name = "Donations",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 16),
		Size = UDim2.new(1, -24, 0, 150),
		BackgroundTransparency = 1,
		ZIndex = 24,
		Parent = video,
	})
	-- (vidéo large sans chat : les cartes gardent une largeur de bannière)
	UI.Create("UISizeConstraint", { MaxSize = Vector2.new(250, 150), Parent = donationStack })
	UI.Create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 4),
		Parent = donationStack,
	})

	-- Entrées du chat (messages + cartes de don épinglées tant qu'elles attendent)
	type ChatEntry = { Instance: GuiObject, Pinned: boolean }
	local chatEntries: { ChatEntry } = {}
	local chatOrder = 0

	-- Retire les plus vieux messages (appelé à part, pas dans la même image
	-- qu'un ajout, pour que le défilement reste fluide)
	local function trimChat()
		local index = 1
		while #chatEntries > MAX_CHAT and index <= #chatEntries do
			local entry = chatEntries[index]
			if entry.Pinned and entry.Instance.Parent then
				index += 1
			else
				table.remove(chatEntries, index)
				if entry.Instance.Parent then
					entry.Instance:Destroy()
				end
			end
		end
	end

	local function nameHash(name: string): number
		local sum = 0
		for i = 1, #name do
			sum += string.byte(name, i) * i
		end
		return sum
	end

	local function nameColor(name: string): string
		return NAME_COLORS[nameHash(name) % #NAME_COLORS + 1]
	end

	-- Rôle stable par pseudo : 🛡️ modo, 👑 VIP, 💎 abonné (ou rien)
	local function roleBadge(name: string): string
		if MODS[name] then
			return "🛡️"
		end
		local roll = nameHash(name) % 10
		if roll <= 1 then
			return "👑"
		elseif roll <= 5 then
			return "💎"
		end
		return ""
	end

	type ChatOptions = { Badge: string?, Highlight: Color3?, Emote: boolean? }

	local function addChatLabel(richText: string, highlight: Color3?)
		chatOrder += 1
		local label = text({
			Name = "Msg",
			Text = richText,
			RichText = true,
			TextSize = 12,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTransparency = 1,
			BackgroundColor3 = highlight or Color3.new(0, 0, 0),
			BackgroundTransparency = highlight and 0.55 or 1,
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.fromScale(1, 0),
			LayoutOrder = chatOrder,
			ZIndex = 4,
			Parent = scroller,
		})
		if highlight then
			UI.Corner(label, 5)
			UI.Create("UIPadding", {
				PaddingLeft = UDim.new(0, 4),
				PaddingRight = UDim.new(0, 3),
				PaddingTop = UDim.new(0, 2),
				PaddingBottom = UDim.new(0, 2),
				Parent = label,
			})
		end
		UI.Tween(label, 0.25, { TextTransparency = 0 })
		table.insert(chatEntries, { Instance = label, Pinned = false })
	end

	local function pushChat(name: string, message: string, options: ChatOptions?)
		if not chat.Visible then
			return
		end
		local badge = (options and options.Badge) or roleBadge(name)
		local prefix = badge ~= "" and (badge .. " ") or ""
		local body = escape(message)
		if options and options.Emote then
			body = '<font size="17">' .. body .. "</font>"
		end
		addChatLabel(prefix .. '<font color="' .. nameColor(name) .. '"><b>' .. escape(name) .. "</b></font> " .. body, options and options.Highlight)
	end

	-- Message système (raid, abonnement...) : sans pseudo, surligné
	local function systemMessage(richText: string, color: Color3)
		if not chat.Visible then
			return
		end
		addChatLabel("<i>" .. richText .. "</i>", color)
	end

	local HOST_OPTIONS: ChatOptions = { Badge = "🎙️", Highlight = Color3.fromRGB(145, 70, 255) }
	local function hostSays(message: string)
		pushChat(HOST, message, HOST_OPTIONS)
	end

	local function randomName(): string
		return pick(NAMES, random)
	end

	-- Réaction du chat limitée (pas plus d'une par `interval` pour une même clé)
	local lastReaction: { [string]: number } = {}
	local function react(key: string, interval: number, list: { string }, extra: number?)
		local now = os.clock()
		if now - (lastReaction[key] or 0) < interval then
			return
		end
		lastReaction[key] = now
		pushChat(randomName(), pick(list, random))
		-- Quelques messages de plus, un peu après (le chat s'emballe)
		for i = 1, extra or 0 do
			task.delay(0.25 * i + random:NextNumber(0, 0.2), function()
				if ctx.IsAlive() then
					pushChat(randomName(), pick(list, random))
				end
			end)
		end
	end

	-- Texte du message épinglé (dépend de l'abonnement et du beurre)
	local function refreshPinned(followed: boolean)
		if not followed then
			pinnedLabel.Text = Locale.T("📌 <b>Follow</b> to unlock donations 💸")
		elseif hasButter() then
			pinnedLabel.Text = Locale.T("📌 Thanks followers 💜 Bite the <b>butter</b>!")
		else
			pinnedLabel.Text = Locale.T("📌 Thanks followers 💜 Be nice!")
		end
	end

	-- Affiche / cache le chat quand la Feature change
	local chatShown = chat.Visible
	local function applyChatVisibility()
		local shown = hasChat()
		if shown == chatShown then
			return
		end
		chatShown = shown
		UI.Tween(video, 0.35, { Size = videoSize(shown) }, Enum.EasingStyle.Back)
		if shown then
			chat.Visible = true
			chat.Position = UDim2.new(1, CHAT_W, 0, VIDEO_Y)
			UI.Tween(chat, 0.35, { Position = UDim2.new(1, -VIDEO_X, 0, VIDEO_Y) }, Enum.EasingStyle.Back)
			hostSays(Locale.T("chat is open!! 🎉"))
		else
			chat.Visible = false
		end
	end

	-- Affiche / cache le beurre
	local butterShown = butterButton.Visible
	local function applyButterVisibility()
		local shown = hasButter()
		if shown == butterShown then
			return
		end
		butterShown = shown
		butterButton.Visible = shown
		if shown then
			butterScale.Scale = 0.2
			UI.Tween(butterScale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
			hostSays(Locale.T("i brought BUTTER 🧈"))
		end
		refreshPinned(isFollowedOnServer())
	end

	ctx.Connect(ctx.State.FeaturesChanged, function()
		applyChatVisibility()
		applyButterVisibility()
	end)

	------------------------------------------------------------------
	-- Spectateurs : grimpent avec le niveau "Abonnés"
	------------------------------------------------------------------
	local followPendingUntil = 0
	local function isFollowed(): boolean
		return isFollowedOnServer() or os.clock() < followPendingUntil
	end

	local function targetViewers(): number
		local base = 40 * (1.9 ^ followers())
		if hasChat() then
			base *= 1.5
		end
		if isFollowed() then
			base *= 1.15
		end
		return base
	end
	local viewers = targetViewers() * random:NextNumber(0.9, 1.1)
	local shownViewers = viewers
	local shownLikes = likes

	local function formatCount(value: number): string
		if value < 1e4 then
			return Format.WithSpaces(value)
		end
		return Format.Format(value, 1)
	end

	------------------------------------------------------------------
	-- Bouton "Suivre" : récompense unique, puis "✔ Abonné" et les dons
	------------------------------------------------------------------
	local shownFollowed: boolean? = nil
	local function refreshFollow(announce: boolean)
		local followed = isFollowed()
		if followed == shownFollowed then
			return
		end
		local wasShown = shownFollowed
		shownFollowed = followed
		refreshPinned(followed)
		if followed then
			followButton.Text = Locale.T("✔ Following")
			followButton.BackgroundColor3 = FOLLOWED_COLOR
			followGradient.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(220, 220, 230))
			followStroke.Color = Color3.fromRGB(120, 110, 150)
			if announce and wasShown == false then
				systemMessage(Locale.T("💜 You're now following <b>%s</b>!", HOST), Color3.fromRGB(120, 60, 200))
				hostSays(Locale.T("thanks for the follow!! donations are open 💸"))
			end
		else
			followButton.Text = Locale.T("💜 Follow")
			followButton.BackgroundColor3 = FOLLOW_COLOR
			followGradient.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(205, 190, 230))
			followStroke.Color = Color3.fromRGB(210, 180, 255)
		end
	end
	refreshFollow(false)
	ctx.Connect(ctx.State.Changed, function()
		refreshFollow(true)
	end)

	ctx.Connect(followButton.Activated, function()
		if isFollowed() then
			-- Déjà abonné : petit cœur pour le plaisir
			spawnHeart("💜")
			addLikes(1, true)
			return
		end
		followPendingUntil = os.clock() + 6 -- en attendant la confirmation du serveur
		ctx.Interact("Follow")
		ctx.Sound.Play("Pop", 1.3)
		for _ = 1, 4 do
			spawnHeart("💜")
		end
		viewers += 1
		addLikes(10, true)
		wow(0.8)
		refreshFollow(true)
		task.delay(0.6, function()
			if ctx.IsAlive() then
				react("follow", 0.5, followReactions, 2)
			end
		end)
	end)

	ctx.OnBonus("Follow", function(payload)
		local amount = tonumber(payload.Amount)
		-- (au centre du bouton Suivre)
		local followX = CARD_W - (PAD + 2) - FOLLOW_W / 2
		if amount then
			ctx.FloatText(card, UDim2.fromOffset(followX, HEADER_MID + 14), "+" .. Format.Format(amount), Theme.Colors.Gold, 24)
		end
		ctx.Effects.Burst(card, UDim2.fromOffset(followX, HEADER_MID), Color3.fromRGB(190, 120, 255), 12)
		ctx.Sound.Play("Bonus", 1.1)
	end)

	------------------------------------------------------------------
	-- Dons (Spawner "Donation") : carte cliquable -> ClaimSpawn
	------------------------------------------------------------------
	type Donation = {
		Card: TextButton,
		Title: TextLabel,
		Sub: TextLabel,
		Name: string,
		Claimed: boolean,
		Done: boolean,
		ExpiresAt: number,
		Entry: ChatEntry?,
	}
	local donations: { [string]: Donation } = {}

	local function removeDonation(id: string, delay: number)
		local donation = donations[id]
		if not donation or donation.Done then
			return
		end
		donation.Done = true
		if donation.Entry then
			donation.Entry.Pinned = false
		end
		task.delay(delay, function()
			local cardFrame = donation.Card
			if cardFrame.Parent then
				-- Se replie en douceur (les messages au-dessus redescendent)
				cardFrame.ClipsDescendants = true
				UI.Tween(cardFrame, 0.3, { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				UI.Tween(donation.Title, 0.2, { TextTransparency = 1 })
				UI.Tween(donation.Sub, 0.2, { TextTransparency = 1 })
				local stroke = cardFrame:FindFirstChildOfClass("UIStroke")
				if stroke then
					UI.Tween(stroke, 0.2, { Transparency = 1 })
				end
				Debris:AddItem(cardFrame, 0.35)
			end
			task.delay(0.4, function()
				if donations[id] == donation then
					donations[id] = nil
				end
			end)
		end)
	end

	local function createDonation(info: any)
		local id = info.Id
		if type(id) ~= "string" or donations[id] then
			return
		end
		local variant = math.floor(tonumber(info.Variant) or random:NextInteger(1, 1000))
		local name = NAMES[(variant - 1) % #NAMES + 1]
		local line = donationLines[(variant - 1) % #donationLines + 1]
		local lifetime = tonumber(info.Lifetime) or 10
		local inChat = chat.Visible
		local height = inChat and 42 or 36

		chatOrder += 1
		local button = UI.Create("TextButton", {
			Name = "Donation",
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, height),
			LayoutOrder = chatOrder,
			ZIndex = 25,
			Parent = inChat and scroller or donationStack,
		})
		UI.Corner(button, 8)
		UI.Gradient(button, ColorSequence.new(Color3.fromRGB(255, 226, 110), Color3.fromRGB(255, 160, 50)), 20)
		UI.Stroke(button, Color3.fromRGB(190, 110, 0), 1.5)
		local ICON = inChat and 22 or 26 -- colonne de l'icône
		local icon = text({
			Text = "💸",
			TextSize = inChat and 16 or 20,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0, 3 + ICON / 2, 0.5, -1),
			Size = UDim2.fromOffset(ICON, ICON),
			ZIndex = 26,
			Parent = button,
		})
		local textX = ICON + 6
		local title = text({
			Text = "<b>" .. escape(name) .. "</b> " .. line,
			RichText = true,
			TextSize = inChat and 11 or 13,
			TextColor3 = Color3.fromRGB(70, 36, 0),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextWrapped = inChat,
			TextTruncate = inChat and Enum.TextTruncate.None or Enum.TextTruncate.AtEnd,
			Position = UDim2.fromOffset(textX, 3),
			Size = UDim2.new(1, -(textX + 4), 0, inChat and 22 or 16),
			ZIndex = 26,
			Parent = button,
		})
		if inChat then
			-- Colonne étroite : 2 lignes max, le texte rétrécit un peu si besoin
			title.TextScaled = true
			UI.Create("UITextSizeConstraint", { MaxTextSize = 11, MinTextSize = 8, Parent = title })
		end
		local sub = text({
			Text = Locale.T("Click to claim ✨"),
			Font = Theme.Fonts.Title,
			TextSize = inChat and 10 or 11,
			TextColor3 = Color3.fromRGB(140, 60, 0),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.new(0, textX, 1, -16),
			Size = UDim2.new(1, -(textX + 4), 0, 12),
			ZIndex = 26,
			Parent = button,
		})
		local timer = box({
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 6, 1, -2),
			Size = UDim2.new(1, -12, 0, 2),
			BackgroundColor3 = Color3.fromRGB(255, 255, 255),
			BackgroundTransparency = 0.2,
			ZIndex = 27,
			Parent = button,
		}, 1)
		TweenService:Create(timer, TweenInfo.new(lifetime, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 2) }):Play()

		-- Pulsation pour attirer l'œil
		-- (nommé "PopScale" : UIUtil.Pop le réutilise au clic, un seul UIScale)
		local pulse = UI.Create("UIScale", { Name = "PopScale", Scale = 0.3, Parent = button })
		UI.Tween(pulse, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
		task.delay(0.36, function()
			local current = donations[id]
			if button.Parent and current and not current.Claimed then
				TweenService:Create(pulse, TweenInfo.new(0.45, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Scale = 1.05 }):Play()
			end
		end)

		local entry: ChatEntry? = nil
		if inChat then
			entry = { Instance = button, Pinned = true }
			table.insert(chatEntries, entry :: ChatEntry)
		end

		local donation: Donation = {
			Card = button,
			Title = title,
			Sub = sub,
			Name = name,
			Claimed = false,
			Done = false,
			ExpiresAt = os.clock() + lifetime,
			Entry = entry,
		}
		donations[id] = donation

		ctx.Sound.Play("Notif", 1.2)
		spawnHeart("💸")
		wow(0.7)

		ctx.Connect(button.Activated, function()
			if donation.Claimed or donation.Done then
				return
			end
			donation.Claimed = true
			ctx.ClaimSpawn(id)
			ctx.Sound.Play("Cash", 1)
			sub.Text = "⏳ ..."
			icon.Text = "🤑"
			UI.Pop(button, 1.15, 0.3)
			-- Sans réponse du serveur (don expiré), la carte s'efface quand même
			removeDonation(id, 2.5)
		end)
	end

	ctx.OnSpawn("Donation", createDonation)

	ctx.OnBonus("Donation", function(payload)
		local amount = tonumber(payload.Amount)
		local donation = type(payload.SpawnId) == "string" and donations[payload.SpawnId] or nil
		local amountText = amount and ("+" .. Format.Format(amount)) or ""
		if donation and donation.Card.Parent then
			donation.Title.Text = Locale.T("✔ Thanks <b>%s</b>!", escape(donation.Name))
			donation.Sub.Text = amountText ~= "" and (amountText .. " Dopamine 💜") or Locale.T("Thanks 💜")
			if amount then
				ctx.FloatText(donation.Card, UDim2.fromScale(0.5, 0.5), amountText, Theme.Colors.Gold, 22)
			end
			ctx.Effects.Burst(donation.Card, UDim2.fromScale(0.5, 0.5), Theme.Colors.Gold, 8)
		elseif amount then
			ctx.FloatText(video, UDim2.new(0.5, 0, 0, 56), amountText, Theme.Colors.Gold, 24)
		end
		for _ = 1, 3 do
			spawnHeart("💸")
		end
		addLikes(random:NextInteger(20, 60), true)
		wow(0.9)
		soundWave(nil)
		popWord(Locale.T("THANKS!!"), UDim2.new(0.5, 0, 0, MOUTH_Y - 28), Color3.fromRGB(255, 214, 40))
		task.delay(0.4, function()
			if ctx.IsAlive() then
				react("donation", 0.8, donationReactions, 2)
			end
		end)
	end)

	------------------------------------------------------------------
	-- Clic sur le beurre : CROUNCH (limité à MaxPerSecond)
	------------------------------------------------------------------
	local butterConfig = ctx.Config.Interactions and ctx.Config.Interactions.Butter
	local butterMaxPerSecond = (butterConfig and tonumber(butterConfig.MaxPerSecond)) or 8
	local butterFraction = (butterConfig and tonumber(butterConfig.ClickFraction)) or 0.75
	local butterInterval = 1 / math.max(1, butterMaxPerSecond)
	local lastButter = -math.huge
	local butterCrunches = 0

	ctx.Connect(butterButton.Activated, function()
		if not hasButter() or regenerating then
			return
		end
		local now = os.clock()
		if now - lastButter < butterInterval then
			-- Trop rapide : petite secousse seulement (pas de rotation : le
			-- bloc découpe ses traces de dents avec ClipsDescendants)
			butterButton.Position = butterHome + UDim2.fromOffset(random:NextInteger(-3, 3), 0)
			UI.Tween(butterButton, 0.12, { Position = butterHome })
			return
		end
		lastButter = now
		butterCrunches += 1

		ctx.Interact("Butter")
		ctx.Sound.Play("Crunch", random:NextNumber(0.9, 1.15))

		-- Écrasement + trace de dents
		butterScale.Scale = 0.82
		UI.Tween(butterScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
		addBite()
		local eaten = #bites / BUTTER_BITES
		block.Size = UDim2.fromOffset(BUTTER_W * (1 - eaten * 0.25), BUTTER_H * (1 - eaten * 0.45))
		if butterHint.Visible then
			butterHint.Visible = false
		end

		local butterTop = UDim2.new(BUTTER_X, 0, 0, BUTTER_Y - 6 - BUTTER_H * 0.6) -- haut du bloc
		butterChunks(butterTop)
		soundWave(butterTop)
		popWord(pick(butterWords, random), UDim2.new(BUTTER_X, -12, 0, BUTTER_Y - BUTTON_H - 4), Color3.fromRGB(255, 226, 96))

		-- "+X" prédit (le serveur donne gain par clic x ClickFraction)
		local data = ctx.State.Data
		local value = (data and tonumber(data.ClickValue) or 0) * butterFraction
		if value > 0 then
			ctx.FloatText(video, UDim2.new(BUTTER_X, 0, 0, BUTTER_Y - BUTTON_H + 12), "+" .. Format.Format(value), Theme.Colors.Gold, 20)
		end

		wow(0.4)
		addLikes(random:NextInteger(1, 4), butterCrunches % 3 == 0)
		react("butter", 1.2, butterReactions)

		if #bites >= BUTTER_BITES then
			regenerateButter()
			task.delay(0.3, function()
				if ctx.IsAlive() then
					hostSays(Locale.T("out of butter... time for a refill! 🧈"))
				end
			end)
		end
	end)

	------------------------------------------------------------------
	-- Animation continue
	------------------------------------------------------------------
	local clock = 0
	local nextHeart = 0.5
	local viewersTimer = 0
	local likesTimer = 0
	local followTimer = 0
	local trimTimer = 1
	local sparkleTimer = 2
	ctx.OnRender(function(dt: number)
		dt = math.min(dt, 0.1)
		clock += dt
		local now = os.clock()

		-- Balancement doux (plus rapide quand elle mâche)
		local chewing = now < chewUntil
		local bob = (chewing and math.abs(math.sin(clock * 9)) * 2 or math.sin(clock * 2) * 1.5) * STREAMER_SCALE
		streamer.Position = UDim2.new(0.5, 0, 0, STREAMER_Y + bob)
		head.Rotation = chewing and math.sin(clock * 7) * 4 or math.sin(clock * 1.3) * 3

		-- Yeux : clignement, fermés (contente) quand elle mâche, grands ouverts si "wow"
		if now >= nextBlink then
			blinkUntil = now + 0.12
			nextBlink = now + random:NextNumber(2, 5)
		end
		local amazed = now < wowUntil
		local eyeHeight = 7
		if amazed then
			eyeHeight = 9
		elseif chewing or now < blinkUntil then
			eyeHeight = 2
		end
		for _, eye in ipairs(eyes) do
			eye.Size = UDim2.fromOffset(amazed and 7 or 6, eyeHeight)
		end
		for i, brow in ipairs(brows) do
			local x = i == 1 and 15 or 29
			brow.Position = UDim2.fromOffset(x, amazed and 13 or 16)
			brow.Rotation = amazed and (i == 1 and -12 or 12) or 0
		end

		-- Bouche
		local mouthW, mouthH = 8, 3
		if amazed then
			mouthW, mouthH = 8, 8
		elseif now < openUntil then
			mouthW, mouthH = 11, 9
		elseif chewing then
			mouthW, mouthH = 9, 3 + math.abs(math.sin(clock * 16)) * 5
		end
		mouth.Size = UDim2.fromOffset(mouthW, mouthH)
		tongue.Visible = mouthH >= 7

		-- Casque qui brille au rythme, badge LIVE, ruban LED, néon
		local glow = 0.5 + 0.5 * math.sin(clock * 3)
		for _, stroke in ipairs(cupStrokes) do
			stroke.Transparency = 0.05 + glow * 0.5
		end
		liveScale.Scale = 1 + math.max(0, math.sin(clock * 4)) * 0.05
		liveDot.BackgroundTransparency = math.sin(clock * 5) > 0 and 0 or 0.6
		micLed.BackgroundTransparency = math.sin(clock * 2.5) > -0.3 and 0 or 0.5
		ledGradient.Offset = Vector2.new((clock * 0.15) % 1 - 0.5, 0)
		ringGradient.Rotation = (clock * 60) % 360
		if strokeGradient then
			strokeGradient.Rotation = (clock * 30) % 360
		end
		ringStroke.Transparency = 0.1 + glow * 0.15
		neonSign.TextTransparency = (math.sin(clock * 23) > 0.94) and 0.6 or 0
		shine.BackgroundTransparency = 0.2 + glow * 0.3

		-- Scintillement du beurre
		if butterButton.Visible then
			sparkleTimer -= dt
			if sparkleTimer <= 0 then
				sparkleTimer = random:NextNumber(1.5, 3.5)
				sparkle.TextTransparency = 0
				sparkle.Position = UDim2.new(0.5, random:NextInteger(-15, 17), 0, random:NextInteger(BUTTON_H - 6 - BUTTER_H + 3, BUTTON_H - 12))
				UI.Tween(sparkle, 0.6, { TextTransparency = 1 })
			end
			if butterHint.Visible then
				butterHint.Position = UDim2.new(0.5, 0, 0, HINT_Y - math.abs(math.sin(clock * 4)) * 3)
			end
		end

		-- Cœurs qui montent à droite
		for _, heart in ipairs(hearts) do
			local label = heart.Label
			if label.Visible then
				local t = (now - heart.Start) / heart.Life
				if t >= 1 then
					label.Visible = false
				else
					label.Position = UDim2.new(1, -18 + heart.X + math.sin(heart.Sway + t * 6) * 6, 0, TABLE_Y - 34 - t * 100)
					label.TextTransparency = t * t
					label.Rotation = math.sin(heart.Sway + t * 4) * 15
				end
			end
		end
		nextHeart -= dt
		if nextHeart <= 0 then
			nextHeart = random:NextNumber(0.6, 1.8) / (1 + followers() * 0.12)
			if effectsOn() or random:NextNumber() < 0.3 then
				spawnHeart()
			end
		end

		-- Spectateurs : marche aléatoire autour de la cible
		viewersTimer -= dt
		if viewersTimer <= 0 then
			viewersTimer = 0.6
			local target = targetViewers()
			viewers += (target - viewers) * 0.25 + target * random:NextNumber(-0.03, 0.03)
			viewers = math.max(1, viewers)
		end
		shownViewers += (viewers - shownViewers) * math.min(1, dt * 4)
		local rising = viewers > shownViewers + 0.5
		viewersLabel.Text = (rising and "▲ " or "👁 ") .. formatCount(math.floor(shownViewers + 0.5))
		viewersLabel.TextColor3 = rising and Color3.fromRGB(120, 255, 150) or Color3.fromRGB(200, 192, 230)

		-- Likes : montent tout seuls avec les spectateurs
		likesTimer -= dt
		if likesTimer <= 0 then
			likesTimer = 0.5
			addLikes(math.max(0, math.floor(viewers * random:NextNumber(0, 0.004) + random:NextNumber(0, 1.2))), false)
		end
		shownLikes += (likes - shownLikes) * math.min(1, dt * 5)
		likesLabel.Text = "❤ " .. formatCount(math.floor(shownLikes + 0.5))

		-- Nettoyage des vieux messages du chat (hors champ)
		trimTimer -= dt
		if trimTimer <= 0 then
			trimTimer = 1.3
			trimChat()
		end

		-- Abonnement : suit l'état serveur (et annule une attente expirée)
		followTimer -= dt
		if followTimer <= 0 then
			followTimer = 0.5
			refreshFollow(true)
		end

		-- Dons non cliqués : disparaissent à la fin de leur durée
		for id, donation in pairs(donations) do
			if not donation.Done and now >= donation.ExpiresAt then
				if not donation.Claimed then
					donation.Sub.Text = Locale.T("Too late 😢")
				end
				removeDonation(id, 0.4)
			end
		end
	end)

	------------------------------------------------------------------
	-- Boucle de repas : un aliment à la fois
	------------------------------------------------------------------
	local function refillPlate()
		for i, food in ipairs(foods) do
			food.Text = pick(FOODS, random)
			food.Rotation = random:NextNumber(-12, 12)
			foodScales[i].Scale = 1
			food.Position = foodHome(i) - UDim2.fromOffset(0, 80)
			food.Visible = true
			task.delay((i - 1) * 0.08, function()
				if ctx.IsAlive() and food.Parent then
					UI.Tween(food, 0.45, { Position = foodHome(i) }, Enum.EasingStyle.Bounce)
				end
			end)
		end
	end

	task.spawn(function()
		task.wait(1)
		while ctx.IsAlive() do
			task.wait(random:NextNumber(1.2, 2) / (1 + math.min(followers(), 15) * 0.02))
			if not ctx.IsAlive() then
				break
			end

			local index = nil
			for i, food in ipairs(foods) do
				if food.Visible then
					index = i
					break
				end
			end

			if not index then
				-- Assiette vide : on ressert !
				wow(0.8)
				popWord(Locale.T("REFILL!"), UDim2.new(0.5, 0, 0, MOUTH_Y - 24), nil)
				task.wait(0.5)
				if not ctx.IsAlive() then
					break
				end
				refillPlate()
				pushChat(randomName(), Locale.T("SHE'S GOING FOR SECONDS 😭🔥"))
				task.wait(0.7)
			else
				local food = foods[index]
				local scale = foodScales[index]
				-- Le bras apporte l'aliment à la bouche grande ouverte
				openUntil = os.clock() + 0.5
				UI.Tween(armRight, 0.3, { Rotation = ARM_EAT }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
				UI.Tween(food, 0.3, { Position = UDim2.new(0.5, 5, 0, MOUTH_Y + 3), Rotation = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
				UI.Tween(scale, 0.3, { Scale = 0.6 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				task.wait(0.32)
				if not ctx.IsAlive() then
					break
				end
				-- CROC !
				food.Visible = false
				openUntil = 0
				chewUntil = os.clock() + 1
				UI.Tween(armRight, 0.4, { Rotation = ARM_REST_R }, Enum.EasingStyle.Back)
				popWord(pick(crunchWords, random), UDim2.new(0.5, random:NextNumber() < 0.5 and -50 or 50, 0, MOUTH_Y - 8), nil)
				crumbs()
				soundWave(nil)
				ctx.Sound.Play("Pop", random:NextNumber(0.55, 0.75))
				addLikes(random:NextInteger(2, 8), true)
				if random:NextNumber() < 0.45 then
					react("eat", 0.5, eatReactions)
				end
			end
		end
	end)

	------------------------------------------------------------------
	-- Gros gains du joueur : le chat s'enflamme
	------------------------------------------------------------------
	local BIG_SOURCES = { Golden = true, Lightning = true, DVD = true, Email = true }
	ctx.Connect(ctx.State.NotifyReceived, function(payload)
		if type(payload) ~= "table" or not chat.Visible then
			return
		end
		local kind = payload.Type
		if kind == "Jackpot" then
			react("big", 1, jackpotReactions, 3)
		elseif kind == "Rush" then
			react("big", 1, rushReactions, 2)
		elseif kind == "Achievement" then
			react("achievement", 2, achievementReactions, 0)
		elseif kind == "Unlock" then
			react("unlock", 2, unlockReactions, 0)
		elseif kind == "Bonus" and BIG_SOURCES[payload.Source] then
			react("big", 1.5, bigGainReactions, 1)
		end
	end)

	------------------------------------------------------------------
	-- Raid : une autre chaîne débarque avec ses spectateurs
	------------------------------------------------------------------
	local raiding = false
	local function startRaid()
		if raiding or not chat.Visible then
			return
		end
		raiding = true
		local raider = randomName()
		local count = math.floor(random:NextInteger(40, 160) * (1 + followers() * 0.5))
		viewers += count
		addLikes(count, true)
		chatTitle.Text = "🚨 <b><font color=\"#FF9F45\">" .. Locale.T("RAID!") .. "</font></b>"
		systemMessage(Locale.T("🚨 RAID from <b>%s</b> with %s viewers!", escape(raider), tostring(count)), Color3.fromRGB(230, 110, 20))
		popWord(Locale.T("RAID!"), UDim2.new(0.5, 0, 0, 40), Color3.fromRGB(255, 159, 69))
		wow(1)
		for _ = 1, 3 do
			spawnHeart("🎉")
		end
		task.spawn(function()
			for _ = 1, random:NextInteger(6, 9) do
				task.wait(random:NextNumber(0.12, 0.3))
				if not ctx.IsAlive() then
					return
				end
				if random:NextNumber() < 0.3 then
					pushChat(randomName(), pick(EMOTE_MESSAGES, random), { Emote = true })
				else
					pushChat(randomName(), pick(raidMessages, random))
				end
			end
			task.wait(0.6)
			if not ctx.IsAlive() then
				return
			end
			hostSays(Locale.T("thanks for the raid %s!! 💜", raider))
			task.wait(2.5)
			chatTitle.Text = "💬 <b>Chat</b>"
			raiding = false
		end)
	end

	------------------------------------------------------------------
	-- Boucle du chat : de plus en plus rapide avec les abonnés
	------------------------------------------------------------------
	task.spawn(function()
		local nextRaid = os.clock() + random:NextNumber(45, 90)
		while ctx.IsAlive() do
			local interval = math.clamp(1.4 / (1 + followers() * 0.15), 0.25, 1.4)
			task.wait(random:NextNumber(0.6, 1.3) * interval)
			if not ctx.IsAlive() then
				break
			end
			if chat.Visible then
				local roll = random:NextNumber()
				if os.clock() >= nextRaid then
					nextRaid = os.clock() + random:NextNumber(70, 140)
					startRaid()
				elseif roll < 0.05 then
					hostSays(pick(hostMessages, random))
				elseif roll < 0.09 then
					local mod = pick({ "Tonton_Jean", "Lulu_ASMR", "Moustache_Pro", "Madeleine_Proust" }, random)
					pushChat(mod, pick(modMessages, random))
				elseif roll < 0.15 and hasButter() then
					pushChat(randomName(), pick(butterNags, random))
				elseif roll < 0.17 and not isFollowed() then
					pushChat(randomName(), pick(followNags, random))
				elseif roll < 0.35 then
					pushChat(randomName(), pick(EMOTE_MESSAGES, random), { Emote = true })
				else
					pushChat(randomName(), pick(messages, random))
				end
			end
		end
	end)
end

function LiveStream.Stop(_ctx)
	-- Tout est dans ctx.Container (détruit par le StimulusManager)
end

return LiveStream
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">Lofi</string>
            <string name="Source"><![CDATA[--[[
	Lofi (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > Lofi

	Petite chambre "lofi" la nuit (slot R3, 384x268), entièrement illustrée
	en code (Frames, UICorner, UIGradient, UIStroke — aucun emoji pour le
	personnage) :
	  - une fenêtre avec ciel étoilé, lune, ville au loin (fenêtres qui
	    s'allument), pluie qui tombe et gouttes sur la vitre, une guirlande
	    lumineuse qui scintille, un chat qui dort (et respire) sur le rebord ;
	  - le personnage : cheveux (frange, mèches, épi), visage aux yeux
	    fermés, joues roses, sweat à capuche, GROS casque rose lumineux
	    (halo qui pulse sur le rythme), la tête qui hoche en rythme, les
	    bras posés sur le bureau : il écrit dans son cahier (le crayon
	    avance, les lignes se remplissent) ;
	  - des notes de musique ♪ ♫ qui s'échappent du casque sur les temps ;
	  - une tasse fumante, des livres, une lampe dont la lueur respire,
	    une horloge (heure réelle) et un post-it ;
	  - en bas, la barre "lecteur" :
	      · un vinyle qui tourne, le morceau en cours (vraie musique de
	        Config.Music, jouée par SoundManager) ou "lofi beats pour
	        réviser", le nombre de personnes qui "révisent" ;
	      · un bouton ⏭ (morceau suivant : SoundManager.NextTrack) ;
	      · un égaliseur piloté par le volume réel du morceau
	        (Sound.PlaybackLoudness), ou animé tout seul sans musique.
	Si la playlist est vide : dans Studio, un rappel "Ajoute une musique
	dans Config.Music" ; en jeu, simplement la petite chambre.
]]

local RunService = game:GetService("RunService")

local Locale = require(game:GetService("ReplicatedStorage").Shared.Locale)

local Lofi = {}
Lofi.Slot = "R3"

-- Dimensions (pixels "design")
local SCENE_X, SCENE_Y = 6, 6
local SCENE_W, SCENE_H = 368, 204
local BAR_Y, BAR_H = 214, 42
local DESK_Y = 148 -- dessus du bureau (plateau vu en perspective)
local DESK_FRONT = 164 -- face avant du bureau
local ITEM_BASE = 158 -- les objets "posés" sur le plateau
local WINDOW_X, WINDOW_Y, WINDOW_W, WINDOW_H = 12, 12, 164, 108
local GLASS_W, GLASS_H = WINDOW_W - 12, WINDOW_H - 12
local SILL_Y = WINDOW_Y + WINDOW_H - 2
local LAMP_X = 338
local PX = 258 -- centre du personnage
local HEAD_Y = 84 -- centre de la tête
local EQ_BARS = 8
local BEAT = 60 / 78 -- une pulsation (78 BPM, tranquille)
local NOTE_POOL = 4
local NOTE_LIFE = 2.4

local WHITE = Color3.new(1, 1, 1)
local RAIN_COLOR = Color3.fromRGB(190, 210, 255)
local EQ_LOW = Color3.fromRGB(255, 120, 190)
local EQ_HIGH = Color3.fromRGB(100, 220, 255)

-- Palette du personnage (original : cheveux indigo, sweat menthe, casque rose)
local SKIN = Color3.fromRGB(255, 222, 200)
local SKIN_SHADE = Color3.fromRGB(242, 186, 166)
local HAIR = Color3.fromRGB(58, 44, 96)
local HAIR_LIGHT = Color3.fromRGB(112, 92, 164)
local HOODIE = Color3.fromRGB(112, 212, 196)
local HOODIE_DARK = Color3.fromRGB(62, 150, 150)
local PHONES = Color3.fromRGB(255, 118, 176)
local PHONES_DARK = Color3.fromRGB(196, 58, 124)
local PHONES_GLOW = Color3.fromRGB(255, 150, 210)
local LINE_INK = Color3.fromRGB(72, 44, 78)
local NOTE_COLORS = { PHONES_GLOW, EQ_HIGH, Color3.fromRGB(255, 226, 120), Color3.fromRGB(196, 170, 255) }

local TRACKS = {
	en = {
		"midnight_rain.mp3",
		"purring_cat.wav",
		"cold_coffee_at_3am.mp3",
		"endless_revision.mp3",
		"clouds_in_pajamas.mp3",
		"the_test_is_tomorrow.mp3",
		"soft_laziness.wav",
		"5_more_minutes.mp3",
	},
	fr = {
		"pluie_de_minuit.mp3",
		"chat_qui_ronronne.wav",
		"cafe_froid_a_3h.mp3",
		"revisions_infinies.mp3",
		"nuages_en_pyjama.mp3",
		"le_controle_c_est_demain.mp3",
		"flemme_douce.wav",
		"encore_5_minutes.mp3",
	},
}

-- Arc "bas de cercle" (yeux fermés, sourire) : on cache la moitié haute
-- du contour avec un dégradé de transparence
local LOWER_ARC = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 1),
	NumberSequenceKeypoint.new(0.5, 1),
	NumberSequenceKeypoint.new(0.56, 0),
	NumberSequenceKeypoint.new(1, 0),
})
-- Arc "haut de cercle" (arceau du casque)
local UPPER_ARC = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0),
	NumberSequenceKeypoint.new(0.5, 0),
	NumberSequenceKeypoint.new(0.54, 1),
	NumberSequenceKeypoint.new(1, 1),
})

-- Séquence de couleurs "à bords nets" : { {position, couleur}, ... }
local function bands(list: { { any } }): ColorSequence
	local keypoints = {}
	for _, entry in ipairs(list) do
		table.insert(keypoints, ColorSequenceKeypoint.new(entry[1], entry[2]))
	end
	return ColorSequence.new(keypoints)
end

function Lofi.Start(ctx)
	local UI = ctx.UIUtil
	local Theme = ctx.Theme
	local Format = ctx.Format
	local random = Random.new()

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	local function frame(props: { [string]: any }): Frame
		props.BorderSizePixel = 0
		return UI.Create("Frame", props)
	end

	local function circle(props: { [string]: any }): Frame
		local f = frame(props)
		UI.Corner(f, UDim.new(1, 0))
		return f
	end

	-- Cadre centré sur (x, y) (pixels du parent)
	local function at(props: { [string]: any }, x: number, y: number, w: number, h: number): { [string]: any }
		props.AnchorPoint = Vector2.new(0.5, 0.5)
		props.Position = UDim2.fromOffset(x, y)
		props.Size = UDim2.fromOffset(w, h)
		return props
	end

	local function gradient(guiObject: Instance, top: Color3, bottom: Color3, rotation: number?): UIGradient
		return UI.Gradient(guiObject, ColorSequence.new(top, bottom), rotation or 90)
	end

	-- Contour circulaire dont on ne garde que le haut ou le bas
	local function arc(props: { [string]: any }, color: Color3, thickness: number, sequence: NumberSequence): (Frame, UIStroke)
		props.BackgroundTransparency = 1
		local f = circle(props)
		local stroke = UI.Stroke(f, color, thickness, 0)
		UI.Create("UIGradient", { Rotation = 90, Transparency = sequence, Parent = stroke })
		return f, stroke
	end

	-- Membre (bras, crayon...) : capsule tournée qui va de (x1, y1) à (x2, y2).
	-- Le haut du cadre est du côté (x1, y1) : un dégradé Rotation 90 va du
	-- début vers la fin du membre.
	local function setLimb(limb: GuiObject, x1: number, y1: number, x2: number, y2: number, thickness: number)
		local dx, dy = x2 - x1, y2 - y1
		local length = math.sqrt(dx * dx + dy * dy)
		limb.Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2)
		limb.Size = UDim2.fromOffset(thickness, length + thickness * 0.6)
		limb.Rotation = math.deg(math.atan2(-dx, dy))
	end

	local function limb(props: { [string]: any }, x1: number, y1: number, x2: number, y2: number, thickness: number): Frame
		props.AnchorPoint = Vector2.new(0.5, 0.5)
		local f = frame(props)
		UI.Corner(f, UDim.new(1, 0))
		setLimb(f, x1, y1, x2, y2, thickness)
		return f
	end

	------------------------------------------------------------------
	-- Carte + scène (mur violet du soir)
	------------------------------------------------------------------
	local card = frame({
		Name = "Card",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -4, 1, -4),
		BackgroundColor3 = Color3.fromRGB(28, 22, 44),
		Parent = ctx.Container,
	})
	UI.Corner(card, 16)
	UI.Stroke(card, Theme.Colors.CardBorder, 2)

	local scene = frame({
		Name = "Scene",
		Position = UDim2.fromOffset(SCENE_X, SCENE_Y),
		Size = UDim2.fromOffset(SCENE_W, SCENE_H),
		BackgroundColor3 = WHITE,
		ClipsDescendants = true,
		Parent = card,
	})
	UI.Corner(scene, 10)
	gradient(scene, Color3.fromRGB(84, 62, 130), Color3.fromRGB(46, 34, 80))

	------------------------------------------------------------------
	-- Lueur de la lampe (derrière tout le reste du mur)
	------------------------------------------------------------------
	local glows: { Frame } = {}
	local GLOW_SIZES = { 200, 120 }
	local GLOW_ALPHA = { 0.88, 0.8 }
	for i, size in ipairs(GLOW_SIZES) do
		glows[i] = circle(at({
			Name = "LampGlow",
			BackgroundColor3 = Color3.fromRGB(255, 196, 120),
			BackgroundTransparency = GLOW_ALPHA[i],
			ZIndex = 1,
			Parent = scene,
		}, LAMP_X - 6, 112, size, size))
	end

	------------------------------------------------------------------
	-- Fenêtre : ciel, lune, étoiles, ville, pluie
	------------------------------------------------------------------
	local WOOD_LIGHT = Color3.fromRGB(236, 214, 182)
	local windowFrame = frame({
		Name = "Window",
		Position = UDim2.fromOffset(WINDOW_X, WINDOW_Y),
		Size = UDim2.fromOffset(WINDOW_W, WINDOW_H),
		BackgroundColor3 = WOOD_LIGHT,
		ZIndex = 2,
		Parent = scene,
	})
	UI.Corner(windowFrame, 6)
	UI.Stroke(windowFrame, Color3.fromRGB(150, 118, 96), 1.5, 0.3)

	local glass = frame({
		Name = "Glass",
		Position = UDim2.fromOffset(6, 6),
		Size = UDim2.fromOffset(GLASS_W, GLASS_H),
		BackgroundColor3 = WHITE,
		ClipsDescendants = true,
		ZIndex = 2,
		Parent = windowFrame,
	})
	gradient(glass, Color3.fromRGB(16, 20, 62), Color3.fromRGB(96, 66, 146))

	-- Lune
	local moonGlow = circle(at({
		Name = "MoonGlow",
		BackgroundColor3 = Color3.fromRGB(255, 244, 200),
		BackgroundTransparency = 0.82,
		ZIndex = 2,
		Parent = glass,
	}, GLASS_W - 30, 24, 46, 46))
	local moon = circle(at({
		Name = "Moon",
		BackgroundColor3 = WHITE,
		ZIndex = 3,
		Parent = glass,
	}, GLASS_W - 30, 24, 24, 24))
	gradient(moon, Color3.fromRGB(255, 250, 222), Color3.fromRGB(236, 224, 180), 45)
	for i, spec in ipairs({ { 8, 9, 6 }, { 15, 15, 4 } }) do
		circle(at({
			Name = "Crater" .. i,
			BackgroundColor3 = Color3.fromRGB(222, 210, 170),
			ZIndex = 3,
			Parent = moon,
		}, spec[1], spec[2], spec[3], spec[3]))
	end

	-- Étoiles qui scintillent
	local stars: { { Frame: Frame, Phase: number, Speed: number } } = {}
	for _ = 1, 5 do
		local size = random:NextInteger(2, 3)
		local star = circle({
			Name = "Star",
			Position = UDim2.fromOffset(random:NextInteger(6, GLASS_W - 60), random:NextInteger(4, 42)),
			Size = UDim2.fromOffset(size, size),
			BackgroundColor3 = Color3.fromRGB(255, 255, 230),
			ZIndex = 2,
			Parent = glass,
		})
		table.insert(stars, { Frame = star, Phase = random:NextNumber(0, math.pi * 2), Speed = random:NextNumber(1.5, 3.5) })
	end

	-- Étoile filante (une seule, réutilisée)
	local shootingStar = frame({
		Name = "ShootingStar",
		AnchorPoint = Vector2.new(1, 0.5),
		Size = UDim2.fromOffset(26, 2),
		BackgroundColor3 = WHITE,
		Rotation = 18,
		Visible = false,
		ZIndex = 2,
		Parent = glass,
	})
	UI.Create("UIGradient", {
		Transparency = NumberSequence.new(1, 0),
		Parent = shootingStar,
	})

	-- Ville au loin (immeubles + quelques fenêtres allumées)
	local litWindows: { Frame } = {}
	local buildingX = 0
	local BUILDINGS = { { 22, 34 }, { 18, 50 }, { 28, 28 }, { 20, 44 }, { 26, 36 }, { 22, 54 }, { 30, 30 } }
	local LIGHT_COLORS = { Color3.fromRGB(255, 214, 110), Color3.fromRGB(255, 170, 210), Color3.fromRGB(150, 230, 255) }
	for _, spec in ipairs(BUILDINGS) do
		local w, h = spec[1], spec[2]
		local building = frame({
			Name = "Building",
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromOffset(buildingX, GLASS_H),
			Size = UDim2.fromOffset(w, h),
			BackgroundColor3 = WHITE,
			ZIndex = 3,
			Parent = glass,
		})
		gradient(building, Color3.fromRGB(44, 38, 84), Color3.fromRGB(22, 18, 46))
		if #litWindows < 7 and h >= 34 then
			for _ = 1, 2 do
				local lit = frame({
					Name = "Lit",
					Position = UDim2.fromOffset(random:NextInteger(3, w - 7), random:NextInteger(5, h - 12)),
					Size = UDim2.fromOffset(3, 4),
					BackgroundColor3 = LIGHT_COLORS[random:NextInteger(1, #LIGHT_COLORS)],
					ZIndex = 3,
					Parent = building,
				})
				table.insert(litWindows, lit)
			end
		end
		buildingX += w + 1
		if buildingX >= GLASS_W then
			break
		end
	end

	-- Pluie : réserve de traits recyclés (aucune création par image)
	local RAIN_ANGLE = math.rad(12)
	local RAIN_SPEED = 230
	local rainCount = effectsOn() and 16 or 8
	local drops: { { Frame: Frame, X: number, Y: number, Speed: number } } = {}
	for _ = 1, rainCount do
		local length = random:NextInteger(8, 14)
		local drop = frame({
			Name = "Rain",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(1.5, length),
			BackgroundColor3 = RAIN_COLOR,
			BackgroundTransparency = random:NextNumber(0.25, 0.55),
			Rotation = 12,
			ZIndex = 4,
			Parent = glass,
		})
		table.insert(drops, {
			Frame = drop,
			X = random:NextNumber(0, GLASS_W + 30),
			Y = random:NextNumber(-20, GLASS_H),
			Speed = RAIN_SPEED * random:NextNumber(0.8, 1.2),
		})
	end

	-- Gouttes qui glissent sur la vitre
	local beads: { { Frame: Frame, X: number, Y: number, Speed: number } } = {}
	for _ = 1, 2 do
		local bead = circle({
			Name = "Bead",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(4, 5),
			BackgroundColor3 = Color3.fromRGB(220, 235, 255),
			BackgroundTransparency = 0.35,
			ZIndex = 5,
			Parent = glass,
		})
		table.insert(beads, {
			Frame = bead,
			X = random:NextNumber(8, GLASS_W - 8),
			Y = random:NextNumber(0, GLASS_H),
			Speed = random:NextNumber(6, 16),
		})
	end

	-- Croisillons de la fenêtre (au-dessus de la vitre)
	frame({
		Name = "MullionV",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.new(0, 5, 1, 0),
		BackgroundColor3 = WOOD_LIGHT,
		ZIndex = 6,
		Parent = windowFrame,
	})
	frame({
		Name = "MullionH",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(1, 0, 0, 5),
		BackgroundColor3 = WOOD_LIGHT,
		ZIndex = 6,
		Parent = windowFrame,
	})

	-- Rebord
	local sill = frame({
		Name = "Sill",
		Position = UDim2.fromOffset(WINDOW_X - 6, SILL_Y),
		Size = UDim2.fromOffset(WINDOW_W + 12, 8),
		BackgroundColor3 = WHITE,
		ZIndex = 7,
		Parent = scene,
	})
	UI.Corner(sill, 3)
	gradient(sill, Color3.fromRGB(226, 198, 160), Color3.fromRGB(176, 144, 110))

	------------------------------------------------------------------
	-- Guirlande lumineuse au-dessus de la fenêtre
	------------------------------------------------------------------
	frame({
		Name = "Wire",
		Position = UDim2.fromOffset(WINDOW_X - 2, WINDOW_Y + 2),
		Size = UDim2.fromOffset(WINDOW_W + 4, 1.5),
		BackgroundColor3 = Color3.fromRGB(40, 30, 50),
		BackgroundTransparency = 0.2,
		ZIndex = 8,
		Parent = scene,
	})
	local FAIRY_COLORS = {
		Color3.fromRGB(255, 220, 110),
		Color3.fromRGB(255, 140, 200),
		Color3.fromRGB(120, 230, 255),
		Color3.fromRGB(255, 170, 90),
		Color3.fromRGB(190, 160, 255),
		Color3.fromRGB(140, 240, 170),
	}
	local fairy: { { Frame: Frame, Glow: UIStroke, Phase: number } } = {}
	for i, color in ipairs(FAIRY_COLORS) do
		local u = (i - 0.5) / #FAIRY_COLORS
		local bulbFrame = circle(at({
			Name = "Fairy" .. i,
			BackgroundColor3 = color,
			ZIndex = 8,
			Parent = scene,
		}, WINDOW_X + u * WINDOW_W, WINDOW_Y + 6 + math.sin(u * math.pi * 3) * 2, 5, 6))
		local glowStroke = UI.Stroke(bulbFrame, color, 2.5, 0.55)
		table.insert(fairy, { Frame = bulbFrame, Glow = glowStroke, Phase = random:NextNumber(0, math.pi * 2) })
	end

	------------------------------------------------------------------
	-- Chat endormi sur le rebord
	------------------------------------------------------------------
	local CAT_COLOR = Color3.fromRGB(248, 182, 104)
	local CAT_DARK = Color3.fromRGB(214, 136, 64)
	local catX, catBottom = WINDOW_X + 16, SILL_Y + 1

	local tail = frame({
		Name = "CatTail",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromOffset(catX + 6, catBottom - 6),
		Size = UDim2.fromOffset(28, 7),
		BackgroundColor3 = CAT_DARK,
		ZIndex = 8,
		Parent = scene,
	})
	UI.Corner(tail, UDim.new(1, 0))

	local body = circle({
		Name = "CatBody",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromOffset(catX + 30, catBottom),
		Size = UDim2.fromOffset(60, 24),
		BackgroundColor3 = WHITE,
		ZIndex = 9,
		Parent = scene,
	})
	gradient(body, Color3.fromRGB(255, 206, 140), CAT_COLOR)
	local bodyScale = UI.Create("UIScale", { Parent = body })
	for i = 1, 2 do
		frame({
			Name = "Stripe",
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromOffset(20 + i * 10, 1),
			Size = UDim2.fromOffset(3, 10),
			Rotation = 12,
			BackgroundColor3 = CAT_DARK,
			ZIndex = 9,
			Parent = body,
		})
	end

	local headX, headY = catX + 58, catBottom - 14
	for side = -1, 1, 2 do
		frame(at({
			Name = "CatEar",
			BackgroundColor3 = CAT_DARK,
			Rotation = 45,
			ZIndex = 9,
			Parent = scene,
		}, headX + side * 7, headY - 9, 9, 9))
	end
	local head = circle(at({
		Name = "CatHead",
		BackgroundColor3 = WHITE,
		ZIndex = 10,
		Parent = scene,
	}, headX, headY, 26, 22))
	gradient(head, Color3.fromRGB(255, 206, 140), CAT_COLOR)
	for side = -1, 1, 2 do
		arc(at({ Name = "Eye", ZIndex = 10, Parent = head }, 13 + side * 5, 9, 5, 5), Color3.fromRGB(70, 40, 30), 1.2, LOWER_ARC)
	end
	frame(at({
		Name = "Nose",
		BackgroundColor3 = Color3.fromRGB(255, 130, 150),
		ZIndex = 10,
		Parent = head,
	}, 13, 15, 4, 3))

	-- "z z z" qui montent de la tête du chat (3 lettres recyclées)
	local zLabels: { TextLabel } = {}
	for i = 1, 3 do
		zLabels[i] = UI.Create("TextLabel", {
			Name = "Z",
			Text = i == 3 and "Z" or "z",
			Font = Theme.Fonts.Title,
			TextSize = 12,
			TextColor3 = WHITE,
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(20, 20),
			ZIndex = 11,
			Parent = scene,
		})
	end

	------------------------------------------------------------------
	-- Mur : horloge + post-it
	------------------------------------------------------------------
	local clockFrame = frame({
		Name = "Clock",
		Position = UDim2.fromOffset(186, 12),
		Size = UDim2.fromOffset(58, 24),
		BackgroundColor3 = Color3.fromRGB(22, 18, 36),
		ZIndex = 3,
		Parent = scene,
	})
	UI.Corner(clockFrame, 6)
	UI.Stroke(clockFrame, Color3.fromRGB(110, 90, 160), 1.5)
	local clockLabel = UI.Label({
		Text = "--:--",
		Font = Theme.Fonts.Mono,
		TextColor3 = Color3.fromRGB(120, 255, 200),
		Size = UDim2.new(1, -8, 1, -6),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		MaxTextSize = 15,
		ZIndex = 3,
		Parent = clockFrame,
	})

	local note = frame({
		Name = "PostIt",
		Position = UDim2.fromOffset(302, 10),
		Size = UDim2.fromOffset(56, 40),
		Rotation = 5,
		BackgroundColor3 = WHITE,
		ZIndex = 4,
		Parent = scene,
	})
	gradient(note, Color3.fromRGB(255, 240, 140), Color3.fromRGB(250, 214, 96))
	UI.Stroke(note, Color3.fromRGB(0, 0, 0), 1, 0.8)
	UI.Label({
		Text = Locale.T("<s>study</s>\nclick ✅"),
		RichText = true,
		TextColor3 = Color3.fromRGB(50, 40, 40),
		TextWrapped = true,
		Size = UDim2.new(1, -6, 1, -6),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		MaxTextSize = 12,
		ZIndex = 4,
		Parent = note,
	})

	------------------------------------------------------------------
	-- Lampe de bureau (le cône de lumière éclaire le plateau)
	------------------------------------------------------------------
	local cone = frame({
		Name = "LightCone",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromOffset(LAMP_X - 4, 106),
		Size = UDim2.fromOffset(78, DESK_FRONT - 106),
		BackgroundColor3 = Color3.fromRGB(255, 214, 140),
		ZIndex = 11,
		Parent = scene,
	})
	UI.Create("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new(0.6, 0.92),
		Parent = cone,
	})
	local lampArm = limb({ Name = "LampArm", BackgroundColor3 = WHITE, ZIndex = 12, Parent = scene }, LAMP_X + 14, ITEM_BASE, LAMP_X + 2, 104, 4)
	gradient(lampArm, Color3.fromRGB(96, 96, 116), Color3.fromRGB(52, 52, 64), 0)
	local lampBase = frame(at({
		Name = "LampBase",
		BackgroundColor3 = WHITE,
		ZIndex = 12,
		Parent = scene,
	}, LAMP_X + 14, ITEM_BASE, 28, 6))
	UI.Corner(lampBase, 3)
	gradient(lampBase, Color3.fromRGB(110, 110, 130), Color3.fromRGB(52, 52, 64))
	local shade = frame(at({
		Name = "LampShade",
		BackgroundColor3 = WHITE,
		Rotation = -14,
		ZIndex = 12,
		Parent = scene,
	}, LAMP_X - 2, 102, 40, 18))
	UI.Corner(shade, UDim.new(0.5, 0))
	gradient(shade, Color3.fromRGB(255, 206, 100), Color3.fromRGB(228, 116, 60))
	local bulb = circle({
		Name = "Bulb",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.fromOffset(12, 8),
		BackgroundColor3 = Color3.fromRGB(255, 250, 210),
		ZIndex = 12,
		Parent = shade,
	})

	------------------------------------------------------------------
	-- Le personnage (corps + tête) derrière le bureau
	------------------------------------------------------------------
	local person = frame({
		Name = "Person",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 7,
		Parent = scene,
	})

	-- Sweat à capuche
	local torso = frame(at({ Name = "Torso", BackgroundColor3 = WHITE, ZIndex = 1, Parent = person }, PX, 140, 80, 64))
	UI.Corner(torso, 28)
	UI.Gradient(torso, ColorSequence.new({
		ColorSequenceKeypoint.new(0, HOODIE:Lerp(WHITE, 0.15)),
		ColorSequenceKeypoint.new(0.6, HOODIE),
		ColorSequenceKeypoint.new(1, HOODIE_DARK),
	}), 90)
	local neck = frame(at({ Name = "Neck", BackgroundColor3 = SKIN_SHADE, ZIndex = 2, Parent = person }, PX, 104, 13, 12))
	UI.Corner(neck, 4)
	local collar = frame(at({ Name = "Hood", BackgroundColor3 = WHITE, ZIndex = 3, Parent = person }, PX, 110, 58, 16))
	UI.Corner(collar, 8)
	gradient(collar, HOODIE_DARK:Lerp(WHITE, 0.1), HOODIE_DARK)
	for side = -1, 1, 2 do
		local cord = frame(at({
			Name = "String",
			BackgroundColor3 = Color3.fromRGB(245, 245, 255),
			BackgroundTransparency = 0.1,
			ZIndex = 3,
			Parent = torso,
		}, 40 + side * 7, 16, 2, 14))
		UI.Corner(cord, 1)
	end

	-- Tête (support qui hoche : tout ce qui est dedans bouge avec)
	local headHolder = frame(at({
		Name = "Head",
		BackgroundTransparency = 1,
		ZIndex = 4,
		Parent = person,
	}, PX, HEAD_Y, 80, 80))

	-- Pièce de la tête, centrée sur (x, y) par rapport au centre de la tête
	local function headPart(props: { [string]: any }, x: number, y: number, w: number, h: number): Frame
		props.AnchorPoint = Vector2.new(0.5, 0.5)
		props.Position = UDim2.new(0.5, x, 0.5, y)
		props.Size = UDim2.fromOffset(w, h)
		props.Parent = headHolder
		return frame(props)
	end

	-- Halo lumineux des écouteurs (derrière tout)
	local phoneGlows: { Frame } = {}
	for side = -1, 1, 2 do
		local glow = headPart({ Name = "PhoneGlow", BackgroundColor3 = PHONES_GLOW, BackgroundTransparency = 0.78, ZIndex = 1 }, side * 33, 6, 40, 40)
		UI.Corner(glow, UDim.new(1, 0))
		table.insert(phoneGlows, glow)
	end

	-- Cheveux (arrière) + mèches sur les côtés
	local backHair = headPart({ Name = "BackHair", BackgroundColor3 = WHITE, ZIndex = 2 }, 0, -2, 58, 56)
	UI.Corner(backHair, UDim.new(1, 0))
	gradient(backHair, HAIR_LIGHT, HAIR)
	for side = -1, 1, 2 do
		local lock = headPart({ Name = "Lock", BackgroundColor3 = HAIR, ZIndex = 4 }, side * 23, 11, 13, 30)
		UI.Corner(lock, 7)
	end

	-- Visage
	local face = headPart({ Name = "Face", BackgroundColor3 = WHITE, ZIndex = 3 }, 0, 5, 46, 43)
	UI.Corner(face, UDim.new(0.48, 0))
	gradient(face, SKIN, SKIN_SHADE)
	for side = -1, 1, 2 do
		-- Yeux fermés (arc) + petit cil
		local eye = headPart({ Name = "Eye", ZIndex = 5 }, side * 10, 4, 10, 10)
		eye.BackgroundTransparency = 1
		UI.Corner(eye, UDim.new(1, 0))
		local eyeStroke = UI.Stroke(eye, LINE_INK, 2, 0)
		UI.Create("UIGradient", { Rotation = 90, Transparency = LOWER_ARC, Parent = eyeStroke })
		local lash = headPart({ Name = "Lash", BackgroundColor3 = LINE_INK, Rotation = side * 30, ZIndex = 5 }, side * 16.5, 5.5, 4, 1.6)
		UI.Corner(lash, 1)
		-- Joues roses
		local blush = headPart({ Name = "Blush", BackgroundColor3 = Color3.fromRGB(255, 136, 160), BackgroundTransparency = 0.45, ZIndex = 5 }, side * 13, 13, 9, 5)
		UI.Corner(blush, UDim.new(1, 0))
	end
	local nose = headPart({ Name = "Nose", BackgroundColor3 = SKIN_SHADE:Lerp(Color3.fromRGB(200, 120, 110), 0.4), ZIndex = 5 }, 0, 11, 2.5, 2)
	UI.Corner(nose, 1)
	local mouth = headPart({ Name = "Mouth", ZIndex = 5 }, 0, 14, 6, 6)
	mouth.BackgroundTransparency = 1
	UI.Corner(mouth, UDim.new(1, 0))
	local mouthStroke = UI.Stroke(mouth, LINE_INK, 1.5, 0.1)
	UI.Create("UIGradient", { Rotation = 90, Transparency = LOWER_ARC, Parent = mouthStroke })

	-- Frange, reflet, épi
	for _, spec in ipairs({ { -11, -13, 28, 17, -20 }, { 12, -13, 28, 17, 22 }, { 0, -16, 30, 14, 0 } }) do
		local bang = headPart({ Name = "Bang", BackgroundColor3 = WHITE, Rotation = spec[5], ZIndex = 6 }, spec[1], spec[2], spec[3], spec[4])
		UI.Corner(bang, UDim.new(1, 0))
		gradient(bang, HAIR_LIGHT:Lerp(HAIR, 0.45), HAIR)
	end
	local shine = headPart({ Name = "HairShine", BackgroundColor3 = HAIR_LIGHT:Lerp(WHITE, 0.3), BackgroundTransparency = 0.25, Rotation = -18, ZIndex = 7 }, -9, -21, 14, 3.5)
	UI.Corner(shine, UDim.new(1, 0))
	local ahoge = headPart({ Name = "Ahoge", BackgroundColor3 = HAIR, Rotation = 30, ZIndex = 6 }, 5, -31, 3.5, 12)
	UI.Corner(ahoge, UDim.new(1, 0))

	-- GROS casque : arceau (haut d'un cercle) + deux écouteurs vernis
	local band = headPart({ Name = "Band", BackgroundTransparency = 1, ZIndex = 7 }, 0, 4, 64, 64)
	UI.Corner(band, UDim.new(1, 0))
	local bandStroke = UI.Stroke(band, WHITE, 6, 0)
	UI.Create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(PHONES:Lerp(WHITE, 0.3), PHONES_DARK),
		Transparency = UPPER_ARC,
		Parent = bandStroke,
	})

	for side = -1, 1, 2 do
		local cushion = headPart({ Name = "Cushion", BackgroundColor3 = Color3.fromRGB(70, 44, 90), ZIndex = 7 }, side * 26, 6, 7, 20)
		UI.Corner(cushion, 3)
		local cup = headPart({ Name = "Cup", BackgroundColor3 = WHITE, ZIndex = 8 }, side * 33, 6, 16, 26)
		UI.Corner(cup, 7)
		UI.Gradient(cup, ColorSequence.new({
			ColorSequenceKeypoint.new(0, PHONES:Lerp(WHITE, 0.35)),
			ColorSequenceKeypoint.new(0.45, PHONES),
			ColorSequenceKeypoint.new(1, PHONES_DARK),
		}), 90)
		UI.Stroke(cup, PHONES_DARK, 1.5, 0.2)
		local cupShine = headPart({ Name = "CupShine", BackgroundColor3 = WHITE, BackgroundTransparency = 0.35, ZIndex = 9 }, side * 33 - 3, -1, 3, 8)
		UI.Corner(cupShine, UDim.new(1, 0))
	end

	------------------------------------------------------------------
	-- Bureau
	------------------------------------------------------------------
	local deskTop = frame({
		Name = "DeskTop",
		Position = UDim2.fromOffset(0, DESK_Y),
		Size = UDim2.new(1, 0, 0, DESK_FRONT - DESK_Y),
		BackgroundColor3 = WHITE,
		ZIndex = 10,
		Parent = scene,
	})
	UI.Gradient(deskTop, ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(150, 104, 76)),
		ColorSequenceKeypoint.new(0.85, Color3.fromRGB(186, 134, 96)),
		ColorSequenceKeypoint.new(0.9, Color3.fromRGB(214, 164, 118)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(214, 164, 118)),
	}), 90)
	local deskFront = frame({
		Name = "DeskFront",
		Position = UDim2.fromOffset(0, DESK_FRONT),
		Size = UDim2.new(1, 0, 0, SCENE_H - DESK_FRONT),
		BackgroundColor3 = WHITE,
		ZIndex = 10,
		Parent = scene,
	})
	gradient(deskFront, Color3.fromRGB(116, 76, 56), Color3.fromRGB(78, 50, 40))

	-- Pile de livres
	for i, spec in ipairs({
		{ 40, 42, 7, Color3.fromRGB(96, 150, 230) },
		{ 42, 36, 6, Color3.fromRGB(240, 110, 120) },
		{ 39, 40, 7, Color3.fromRGB(250, 200, 90) },
	}) do
		local book = frame(at({
			Name = "Book" .. i,
			BackgroundColor3 = WHITE,
			ZIndex = 12,
			Parent = scene,
		}, spec[1], ITEM_BASE - 3 - (i - 1) * 6.5, spec[2], spec[3]))
		UI.Corner(book, 2)
		gradient(book, spec[4]:Lerp(WHITE, 0.2), spec[4]:Lerp(Color3.new(0, 0, 0), 0.2))
		UI.Stroke(book, Color3.fromRGB(40, 24, 30), 1, 0.5)
	end

	-- Tasse fumante
	local mugX = 178
	local mug = frame(at({ Name = "Mug", BackgroundColor3 = WHITE, ZIndex = 12, Parent = scene }, mugX, ITEM_BASE - 9, 16, 18))
	UI.Corner(mug, 4)
	gradient(mug, Color3.fromRGB(255, 250, 240), Color3.fromRGB(214, 206, 196), 0)
	frame(at({ Name = "Stripe", BackgroundColor3 = PHONES, ZIndex = 12, Parent = mug }, 8, 10, 16, 3))
	local handle = circle(at({ Name = "Handle", BackgroundTransparency = 1, ZIndex = 11, Parent = scene }, mugX + 9, ITEM_BASE - 9, 9, 9))
	UI.Stroke(handle, Color3.fromRGB(226, 218, 208), 2.5, 0)
	circle(at({ Name = "Coffee", BackgroundColor3 = Color3.fromRGB(110, 66, 44), ZIndex = 13, Parent = scene }, mugX, ITEM_BASE - 17, 13, 4))
	local steam: { Frame } = {}
	for i = 1, 3 do
		steam[i] = circle({
			Name = "Steam",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(5, 5),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 1,
			ZIndex = 12,
			Parent = scene,
		})
	end

	------------------------------------------------------------------
	-- Mains sur le bureau : cahier, bras, crayon (devant le bureau)
	------------------------------------------------------------------
	local hands = frame({
		Name = "Hands",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 12,
		Parent = scene,
	})

	-- Cahier ouvert (page de gauche déjà écrite, page de droite en cours)
	local NOTE_W, NOTE_H = 66, 13
	local noteLeft, noteTop = PX - NOTE_W / 2, 157 - NOTE_H / 2
	local notebook = frame(at({ Name = "Notebook", BackgroundColor3 = WHITE, ZIndex = 1, Parent = hands }, PX, 157, NOTE_W, NOTE_H))
	UI.Corner(notebook, 2)
	UI.Gradient(notebook, ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(236, 228, 212)),
		ColorSequenceKeypoint.new(0.46, WHITE),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(196, 186, 170)),
		ColorSequenceKeypoint.new(0.54, WHITE),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(236, 228, 212)),
	}), 0)
	UI.Stroke(notebook, Color3.fromRGB(120, 100, 90), 1, 0.4)
	for i = 1, 2 do
		frame({
			Name = "Written" .. i,
			Position = UDim2.fromOffset(5, 3 + (i - 1) * 4.5),
			Size = UDim2.fromOffset(i == 1 and 24 or 17, 1.5),
			BackgroundColor3 = LINE_INK,
			BackgroundTransparency = 0.45,
			ZIndex = 2,
			Parent = notebook,
		})
	end
	local WRITE_X, WRITE_W = 37, 24 -- zone d'écriture (page de droite)
	local writeLines: { Frame } = {}
	for i = 1, 2 do
		writeLines[i] = frame({
			Name = "Writing" .. i,
			Position = UDim2.fromOffset(WRITE_X, 3 + (i - 1) * 4.5),
			Size = UDim2.fromOffset(0, 1.5),
			BackgroundColor3 = LINE_INK,
			BackgroundTransparency = 0.2,
			ZIndex = 2,
			Parent = notebook,
		})
	end

	-- Manches du sweat (dégradé le long du bras, poignet plus foncé)
	local SLEEVE = ColorSequence.new({
		ColorSequenceKeypoint.new(0, HOODIE),
		ColorSequenceKeypoint.new(0.8, HOODIE:Lerp(HOODIE_DARK, 0.3)),
		ColorSequenceKeypoint.new(0.82, HOODIE_DARK),
		ColorSequenceKeypoint.new(1, HOODIE_DARK),
	})
	local UPPER = ColorSequence.new(HOODIE:Lerp(WHITE, 0.12), HOODIE_DARK)

	local L_SHOULDER, L_ELBOW, L_WRIST = Vector2.new(PX - 32, 118), Vector2.new(PX - 48, 150), Vector2.new(PX - 20, 157)
	local R_SHOULDER, R_ELBOW = Vector2.new(PX + 32, 118), Vector2.new(PX + 50, 150)

	local leftUpper = limb({ Name = "LeftUpperArm", BackgroundColor3 = WHITE, ZIndex = 3, Parent = hands }, L_SHOULDER.X, L_SHOULDER.Y, L_ELBOW.X, L_ELBOW.Y, 17)
	UI.Gradient(leftUpper, UPPER, 0)
	local leftFore = limb({ Name = "LeftForearm", BackgroundColor3 = WHITE, ZIndex = 3, Parent = hands }, L_ELBOW.X, L_ELBOW.Y, L_WRIST.X, L_WRIST.Y, 15)
	UI.Gradient(leftFore, SLEEVE, 90)
	local leftHand = circle(at({ Name = "LeftHand", BackgroundColor3 = WHITE, ZIndex = 5, Parent = hands }, L_WRIST.X + 5, L_WRIST.Y, 11, 10))
	gradient(leftHand, SKIN, SKIN_SHADE)

	local rightUpper = limb({ Name = "RightUpperArm", BackgroundColor3 = WHITE, ZIndex = 3, Parent = hands }, R_SHOULDER.X, R_SHOULDER.Y, R_ELBOW.X, R_ELBOW.Y, 17)
	UI.Gradient(rightUpper, UPPER, 180)
	local rightFore = limb({ Name = "RightForearm", BackgroundColor3 = WHITE, ZIndex = 3, Parent = hands }, R_ELBOW.X, R_ELBOW.Y, PX + 20, 152, 15)
	UI.Gradient(rightFore, SLEEVE, 90)
	local pencil = limb({ Name = "Pencil", BackgroundColor3 = WHITE, ZIndex = 4, Parent = hands }, PX + 10, 155, PX + 19, 139, 3.5)
	UI.Gradient(pencil, bands({
		{ 0, Color3.fromRGB(60, 56, 70) },
		{ 0.1, Color3.fromRGB(60, 56, 70) },
		{ 0.11, Color3.fromRGB(242, 206, 158) },
		{ 0.24, Color3.fromRGB(242, 206, 158) },
		{ 0.25, Color3.fromRGB(255, 204, 60) },
		{ 0.83, Color3.fromRGB(255, 190, 40) },
		{ 0.84, Color3.fromRGB(200, 200, 214) },
		{ 0.9, Color3.fromRGB(200, 200, 214) },
		{ 0.91, Color3.fromRGB(255, 140, 164) },
		{ 1, Color3.fromRGB(255, 140, 164) },
	}), 90)
	local rightHand = circle(at({ Name = "RightHand", BackgroundColor3 = WHITE, ZIndex = 5, Parent = hands }, PX + 14, 150, 11, 10))
	gradient(rightHand, SKIN, SKIN_SHADE)

	------------------------------------------------------------------
	-- Notes de musique qui s'échappent du casque (recyclées)
	------------------------------------------------------------------
	local notes: { { Label: TextLabel, Active: boolean, Age: number, X: number, Y: number, Dir: number } } = {}
	for i = 1, NOTE_POOL do
		local label = UI.Create("TextLabel", {
			Name = "Note",
			Text = i % 2 == 1 and "♪" or "♫",
			Font = Theme.Fonts.Title,
			TextSize = 16,
			TextColor3 = NOTE_COLORS[(i - 1) % #NOTE_COLORS + 1],
			TextStrokeColor3 = Color3.fromRGB(40, 20, 60),
			TextStrokeTransparency = 0.5,
			TextTransparency = 1,
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(20, 20),
			Visible = false,
			ZIndex = 14,
			Parent = scene,
		})
		table.insert(notes, { Label = label, Active = false, Age = 0, X = 0, Y = 0, Dir = 1 })
	end
	local nextNoteSide = 1
	local noteColorIndex = 0

	local function spawnNote(centerX: number, headYNow: number)
		for _, n in ipairs(notes) do
			if not n.Active then
				n.Active = true
				n.Age = 0
				n.Dir = nextNoteSide
				n.X = centerX + nextNoteSide * 36
				n.Y = headYNow + 2
				nextNoteSide = -nextNoteSide
				noteColorIndex = noteColorIndex % #NOTE_COLORS + 1
				n.Label.TextColor3 = NOTE_COLORS[noteColorIndex]
				n.Label.Text = random:NextNumber() < 0.5 and "♪" or "♫"
				n.Label.Visible = true
				return
			end
		end
	end

	------------------------------------------------------------------
	-- Barre du bas : lecteur (vinyle, morceau, spectateurs, ⏭, égaliseur)
	------------------------------------------------------------------
	local Sound = ctx.Sound
	local isStudio = RunService:IsStudio()

	local bar = frame({
		Name = "Bar",
		Position = UDim2.fromOffset(SCENE_X, BAR_Y),
		Size = UDim2.fromOffset(SCENE_W, BAR_H),
		BackgroundColor3 = WHITE,
		Parent = card,
	})
	UI.Corner(bar, 10)
	gradient(bar, Color3.fromRGB(40, 32, 70), Color3.fromRGB(18, 14, 32))
	UI.Stroke(bar, Color3.fromRGB(110, 86, 170), 1, 0.45)

	-- Vinyle qui tourne pendant la musique
	local disc = circle({
		Name = "Vinyl",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(22, BAR_H / 2),
		Size = UDim2.fromOffset(30, 30),
		BackgroundColor3 = Color3.fromRGB(28, 26, 34),
		Parent = bar,
	})
	UI.Stroke(disc, Color3.fromRGB(70, 64, 90), 1.5)
	local groove = circle({
		Name = "Groove",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(21, 21),
		BackgroundTransparency = 1,
		Parent = disc,
	})
	UI.Stroke(groove, Color3.fromRGB(64, 60, 82), 1)
	local labelDisc = circle({
		Name = "Label",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(11, 11),
		BackgroundColor3 = WHITE,
		Parent = disc,
	})
	UI.Gradient(labelDisc, ColorSequence.new(EQ_LOW, EQ_HIGH), 0)
	frame({
		Name = "Shine",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0.5, -6),
		Size = UDim2.fromOffset(2, 7),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.55,
		Parent = disc,
	})

	local title = UI.Create("TextLabel", {
		Name = "Title",
		Text = Locale.T("lofi beats 🎧 to study to"),
		Font = Theme.Fonts.Title,
		TextSize = 15,
		TextColor3 = WHITE,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(44, 4),
		Size = UDim2.fromOffset(190, 18),
		Parent = bar,
	})
	local subtitle = UI.Create("TextLabel", {
		Name = "Subtitle",
		Text = "",
		Font = Theme.Fonts.Body,
		TextSize = 12,
		TextColor3 = Color3.fromRGB(200, 186, 240),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(44, 22),
		Size = UDim2.fromOffset(190, 15),
		Parent = bar,
	})

	-- Bouton "morceau suivant"
	local skip = UI.Create("TextButton", {
		Name = "Next",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -7, 0.5, 0),
		Size = UDim2.fromOffset(30, 30),
		BackgroundColor3 = Color3.fromRGB(56, 44, 90),
		AutoButtonColor = false,
		Font = Theme.Fonts.Title,
		Text = "⏭",
		TextColor3 = WHITE,
		TextSize = 15,
		Visible = false,
		Parent = bar,
	})
	UI.Corner(skip, UDim.new(1, 0))
	UI.Stroke(skip, EQ_HIGH, 1.5, 0.4)
	UI.AnimateButton(skip, 1.1, 0.88)

	-- Égaliseur
	local eqWidth = 70
	local eq = frame({
		Name = "Equalizer",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(eqWidth, 28),
		BackgroundTransparency = 1,
		Parent = bar,
	})
	local barWidth = 6
	local barGap = (eqWidth - EQ_BARS * barWidth) / (EQ_BARS - 1)
	local eqBars: { Frame } = {}
	local eqHeights: { number } = {}
	local eqTargets: { number } = {}
	for i = 1, EQ_BARS do
		local t = (i - 1) / (EQ_BARS - 1)
		local eqBar = frame({
			Name = "Bar" .. i,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, (i - 1) * (barWidth + barGap), 1, 0),
			Size = UDim2.fromOffset(barWidth, 4),
			BackgroundColor3 = EQ_LOW:Lerp(EQ_HIGH, t),
			Parent = eq,
		})
		UI.Corner(eqBar, 2)
		eqBars[i] = eqBar
		eqHeights[i] = 0.2
		eqTargets[i] = 0.2
	end

	------------------------------------------------------------------
	-- État du lecteur : vraie musique, musique coupée, ou pas de musique
	------------------------------------------------------------------
	local viewers = random:NextInteger(8000, 14000)
	local tracks = Locale.Pick(TRACKS)
	local trackIndex = random:NextInteger(1, #tracks)
	local showAlt = false -- alterne les deux textes du sous-titre
	local discSpin = 0 -- vitesse de rotation du vinyle (lissée)

	local function hasPlaylist(): boolean
		return type(Sound.HasPlaylist) == "function" and Sound.HasPlaylist()
	end

	-- (nom du morceau, Sound) si de la vraie musique joue, sinon nil
	local function currentMusic(): (string?, Sound?)
		if type(Sound.GetCurrentTrack) ~= "function" or type(Sound.IsMusicPlaying) ~= "function" then
			return nil, nil
		end
		if not Sound.IsMusicPlaying() then
			return nil, nil
		end
		return Sound.GetCurrentTrack()
	end

	local function viewersText(): string
		local text = viewers >= 1e6 and Format.Format(viewers) or Format.WithSpaces(viewers)
		return "🔴 " .. Locale.T("%s people studying (or not)", text)
	end

	local function refreshSubtitle()
		local name = currentMusic()
		local playlist = hasPlaylist()
		skip.Visible = name ~= nil
		eq.Position = name and UDim2.new(1, -44, 0.5, 0) or UDim2.new(1, -10, 0.5, 0)
		-- Textes : toute la place jusqu'à l'égaliseur
		local textWidth = name and 204 or 238
		title.Size = UDim2.fromOffset(textWidth, 18)
		subtitle.Size = UDim2.fromOffset(textWidth, 15)
		subtitle.TextColor3 = Color3.fromRGB(200, 186, 240)

		if name then
			-- Vraie musique
			title.Text = "♫ " .. Locale.T(name)
			subtitle.Text = showAlt and Locale.T("lofi beats 🎧 to study to") or viewersText()
		elseif playlist then
			-- Musique disponible mais coupée (réglage) ou en chargement
			title.Text = Locale.T("lofi beats 🎧 to study to")
			local musicOn = type(Sound.IsMusicEnabled) ~= "function" or Sound.IsMusicEnabled()
			if showAlt then
				subtitle.Text = musicOn and Locale.T("♫ Loading music...") or Locale.T("🔇 Music off (⚙️ Settings)")
			else
				subtitle.Text = viewersText()
			end
		elseif isStudio then
			-- Rappel pour le créateur du jeu (seulement dans Studio)
			title.Text = Locale.T("lofi beats 🎧 to study to")
			subtitle.Text = Locale.T("⚠️ Add some music in Config.Music")
			subtitle.TextColor3 = Color3.fromRGB(255, 200, 90)
		else
			-- Pas de musique : juste l'ambiance
			title.Text = Locale.T("lofi beats 🎧 to study to")
			subtitle.Text = showAlt and ("♫ " .. tracks[trackIndex]) or viewersText()
		end
	end
	refreshSubtitle()

	-- Réagit tout de suite aux changements de morceau / de réglage
	if Sound.TrackChanged then
		ctx.Connect(Sound.TrackChanged, function()
			if not ctx.IsAlive() then
				return
			end
			refreshSubtitle()
			title.TextTransparency = 1
			UI.Tween(title, 0.4, { TextTransparency = 0 })
		end)
	end
	if Sound.MusicStateChanged then
		ctx.Connect(Sound.MusicStateChanged, function()
			if ctx.IsAlive() then
				refreshSubtitle()
			end
		end)
	end

	ctx.Connect(skip.Activated, function()
		if not ctx.IsAlive() then
			return
		end
		if type(Sound.NextTrack) == "function" and Sound.NextTrack() then
			discSpin = 12 -- petit coup de vinyle
		end
	end)

	local function refreshClock()
		-- Roblox : os.date ne gère que "*t" / "!*t" (heure locale du joueur)
		local now = os.date("*t")
		if type(now) == "table" and now.hour and now.min then
			clockLabel.Text = string.format("%02d:%02d", now.hour, now.min)
		end
	end
	refreshClock()

	task.spawn(function()
		local tick = 0
		while ctx.IsAlive() do
			task.wait(1)
			if not ctx.IsAlive() then
				break
			end
			tick += 1
			-- Spectateurs : petite marche aléatoire
			viewers = math.clamp(viewers + random:NextInteger(-40, 55), 3000, 99999)
			if tick % 6 == 0 then
				showAlt = not showAlt
				if showAlt and random:NextNumber() < 0.5 then
					trackIndex = trackIndex % #tracks + 1
				end
				subtitle.TextTransparency = 1
				UI.Tween(subtitle, 0.4, { TextTransparency = 0 })
			end
			refreshSubtitle()
			if tick % 10 == 0 then
				refreshClock()
			end
			-- Une fenêtre de la ville s'allume / s'éteint de temps en temps
			if #litWindows > 0 and random:NextNumber() < 0.25 then
				local lit = litWindows[random:NextInteger(1, #litWindows)]
				lit.BackgroundTransparency = lit.BackgroundTransparency < 0.5 and 1 or 0
			end
		end
	end)

	-- Étoile filante de temps en temps
	task.spawn(function()
		while ctx.IsAlive() do
			task.wait(random:NextNumber(10, 22))
			if not ctx.IsAlive() then
				break
			end
			if effectsOn() then
				local startX = random:NextNumber(10, GLASS_W * 0.5)
				shootingStar.Position = UDim2.fromOffset(startX, random:NextNumber(4, 20))
				shootingStar.BackgroundTransparency = 0
				shootingStar.Visible = true
				local travel = random:NextNumber(60, 90)
				UI.Tween(shootingStar, 0.7, {
					Position = UDim2.fromOffset(startX + travel, 4 + travel * math.tan(math.rad(18))),
					BackgroundTransparency = 1,
				}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				task.wait(0.75)
				shootingStar.Visible = false
			end
		end
	end)

	------------------------------------------------------------------
	-- Animation (une seule boucle de rendu)
	------------------------------------------------------------------
	local clock = 0
	local eqTimer = 0
	local beatCount = 0
	local lastBeat = 0
	local loudPeak = 40 -- pic de volume récent (PlaybackLoudness)
	local lastLevel = 0
	local grooveLevel = 0 -- intensité "musicale" lissée (0..1) : hochement + halo
	local writeTime = 0
	local rainDX = math.tan(RAIN_ANGLE)
	local LINE_TIME, PAUSE_TIME = 2.2, 0.9
	local CYCLE = LINE_TIME * 2 + PAUSE_TIME

	ctx.OnRender(function(dt: number)
		dt = math.min(dt, 0.1)
		clock += dt
		local fx = effectsOn()

		-- Pluie (traits recyclés)
		for _, drop in ipairs(drops) do
			drop.Y += drop.Speed * dt
			drop.X -= drop.Speed * rainDX * dt
			if drop.Y > GLASS_H + 10 or drop.X < -10 then
				drop.Y = random:NextNumber(-24, -6)
				drop.X = random:NextNumber(0, GLASS_W + 30)
			end
			drop.Frame.Position = UDim2.fromOffset(drop.X, drop.Y)
		end

		-- Gouttes sur la vitre (glissent lentement, par à-coups)
		for _, bead in ipairs(beads) do
			local jerk = (math.sin(clock * 2 + bead.X) > 0.6) and 3 or 0.4
			bead.Y += bead.Speed * jerk * dt
			if bead.Y > GLASS_H + 6 then
				bead.Y = -6
				bead.X = random:NextNumber(8, GLASS_W - 8)
			end
			bead.Frame.Position = UDim2.fromOffset(bead.X, bead.Y)
		end

		-- Étoiles, lune, guirlande
		for _, star in ipairs(stars) do
			star.Frame.BackgroundTransparency = 0.2 + 0.7 * (0.5 + 0.5 * math.sin(clock * star.Speed + star.Phase))
		end
		moonGlow.BackgroundTransparency = 0.8 + 0.06 * math.sin(clock * 0.8)
		for _, light in ipairs(fairy) do
			local twinkle = 0.5 + 0.5 * math.sin(clock * 2.2 + light.Phase)
			light.Frame.BackgroundTransparency = 0.05 + (1 - twinkle) * 0.35
			light.Glow.Transparency = 0.45 + (1 - twinkle) * 0.5
		end

		-- Lueur de la lampe qui "respire" (+ petit grésillement rare)
		local breath = 0.5 + 0.5 * math.sin(clock * 1.2)
		local flicker = (math.sin(clock * 37) > 0.985) and 0.06 or 0
		for i, glow in ipairs(glows) do
			glow.BackgroundTransparency = math.min(1, GLOW_ALPHA[i] + (1 - breath) * 0.05 + flicker)
		end
		bulb.BackgroundTransparency = flicker * 4

		-- Chat : respiration, queue qui ondule, "z z z"
		bodyScale.Scale = 1 + 0.04 * (0.5 + 0.5 * math.sin(clock * 1.6))
		tail.Rotation = -18 + math.sin(clock * 0.9) * 10
		for i, z in ipairs(zLabels) do
			local p = ((clock / 3.3) + (i - 1) / 3) % 1
			z.Position = UDim2.fromOffset(headX + 8 + p * 22 + math.sin(p * 6) * 3, headY - 12 - p * 44)
			z.TextSize = 9 + p * 9
			z.TextTransparency = p < 0.12 and (1 - p / 0.12) or (p * p)
		end

		-- Musique : volume réel (si elle joue) → égaliseur + intensité du hochement
		local _, music = currentMusic()
		local playing = music ~= nil and music.Parent ~= nil and music.IsPlaying
		local level = 0
		if playing and music then
			-- Pic adaptatif : l'égaliseur reste expressif quel que soit le volume
			local loudness = music.PlaybackLoudness
			loudPeak = math.max(loudness, loudPeak * (1 - math.min(1, dt * 0.35)), 40)
			level = math.clamp(loudness / loudPeak, 0, 1)
		end
		grooveLevel += ((playing and (0.55 + level * 0.45) or 0.45) - grooveLevel) * math.min(1, dt * 4)

		-- Temps (78 BPM) : pulsation qui retombe après chaque temps
		local beatPhase = (clock % BEAT) / BEAT
		local pulse = math.exp(-beatPhase * 5)
		if playing then
			pulse = math.max(pulse * 0.6, level)
		end
		local beatNow = math.floor(clock / BEAT)
		local onBeat = beatNow ~= lastBeat
		lastBeat = beatNow

		-- Personnage : la tête hoche en rythme et se balance doucement
		local nod = math.sin(beatPhase * math.pi)
		local headOffset = nod * (1.5 + grooveLevel * 2.5)
		local headNowY = HEAD_Y + headOffset
		headHolder.Position = UDim2.fromOffset(PX, headNowY)
		headHolder.Rotation = math.sin(clock * math.pi / BEAT) * (2 + grooveLevel * 2.5)
		local breathe = math.sin(clock * 1.4)
		torso.Position = UDim2.fromOffset(PX, 140 + nod * 0.8 + breathe * 0.4)
		collar.Position = UDim2.fromOffset(PX, 110 + headOffset * 0.5)
		neck.Position = UDim2.fromOffset(PX, 104 + headOffset * 0.5)

		-- Casque lumineux : halo + reflet qui pulsent sur la musique
		for _, glow in ipairs(phoneGlows) do
			glow.BackgroundTransparency = 0.82 - pulse * 0.3
			glow.Size = UDim2.fromOffset(38 + pulse * 8, 38 + pulse * 8)
		end

		-- Écriture : le crayon avance sur la ligne, 2 lignes puis nouvelle page
		writeTime = (writeTime + dt) % CYCLE
		local lineIndex, progress, lifted
		if writeTime < LINE_TIME then
			lineIndex, progress, lifted = 1, writeTime / LINE_TIME, false
		elseif writeTime < LINE_TIME * 2 then
			lineIndex, progress, lifted = 2, (writeTime - LINE_TIME) / LINE_TIME, false
		else
			lineIndex, progress, lifted = 1, 0, true
		end
		if lifted then
			-- Pause : on relit ses notes (lignes pleines), crayon levé
			writeLines[1].Size = UDim2.fromOffset(WRITE_W, 1.5)
			writeLines[2].Size = UDim2.fromOffset(WRITE_W, 1.5)
		else
			writeLines[1].Size = UDim2.fromOffset(lineIndex == 1 and WRITE_W * progress or WRITE_W, 1.5)
			writeLines[2].Size = UDim2.fromOffset(lineIndex == 2 and WRITE_W * progress or 0, 1.5)
		end
		local scribble = lifted and 0 or 1
		local tipX = noteLeft + WRITE_X + (lifted and WRITE_W * 0.5 or WRITE_W * progress) + math.sin(clock * 14) * 0.8 * scribble
		local tipY = noteTop + 3.75 + (lineIndex - 1) * 4.5 + math.sin(clock * 26) * 0.9 * scribble - (lifted and 4 or 0)
		setLimb(pencil, tipX, tipY, tipX + 9, tipY - 16, 3.5)
		local handX, handY = tipX + 4, tipY - 6
		rightHand.Position = UDim2.fromOffset(handX, handY)
		setLimb(rightFore, R_ELBOW.X, R_ELBOW.Y, handX + 3, handY, 15)

		-- Notes de musique : une nouvelle sur certains temps, qui s'envole
		if onBeat and fx and (playing or beatNow % 2 == 0) then
			spawnNote(PX, headNowY)
		end
		for _, n in ipairs(notes) do
			if n.Active then
				n.Age += dt
				local p = n.Age / NOTE_LIFE
				if p >= 1 or not fx then
					n.Active = false
					n.Label.Visible = false
				else
					local label = n.Label
					local x = n.X + n.Dir * p * 30 + math.sin(p * 9) * 4
					local y = n.Y - p * 58
					label.Position = UDim2.fromOffset(x, y)
					label.Rotation = math.sin(p * 8) * 18
					label.TextSize = 12 + math.min(1, p * 5) * 6
					local alpha = p < 0.12 and (1 - p / 0.12) or math.max(0, (p - 0.55) / 0.45)
					label.TextTransparency = alpha
					label.TextStrokeTransparency = 0.5 + alpha * 0.5
				end
			end
		end

		-- Vapeur du café
		for i, puff in ipairs(steam) do
			if fx then
				local p = ((clock / 2.2) + (i - 1) / 3) % 1
				puff.Position = UDim2.fromOffset(mugX + math.sin(p * 7 + i) * 4, ITEM_BASE - 24 - p * 26)
				puff.Size = UDim2.fromOffset(4 + p * 7, 4 + p * 7)
				puff.BackgroundTransparency = 0.45 + p * 0.55
			else
				puff.BackgroundTransparency = 1
			end
		end

		-- Égaliseur : piloté par le volume réel de la musique si elle joue,
		-- sinon animé tout seul (basses sur le temps)
		if playing then
			local rising = level > lastLevel + 0.12
			lastLevel = level
			eqTimer -= dt
			if eqTimer <= 0 or rising then
				eqTimer = 0.07
				for i = 1, EQ_BARS do
					local low = 1 - (i - 1) / (EQ_BARS - 1)
					local base = level * (0.35 + random:NextNumber() * 0.5) + level * low * 0.3
					if rising then
						base += low * 0.25
					end
					eqTargets[i] = math.clamp(base, 0.06, 1)
				end
			end
			discSpin += (4 - discSpin) * math.min(1, dt * 3)
		else
			lastLevel = 0
			eqTimer -= dt
			if eqTimer <= 0 then
				eqTimer = 0.11
				local newBeat = math.floor(clock / BEAT)
				local eqBeat = newBeat ~= beatCount
				beatCount = newBeat
				for i = 1, EQ_BARS do
					local low = 1 - (i - 1) / (EQ_BARS - 1)
					local base = 0.15 + random:NextNumber() * 0.55
					if eqBeat then
						base += low * 0.45
					end
					eqTargets[i] = math.clamp(base, 0.1, 1)
				end
			end
			discSpin += (0.6 - discSpin) * math.min(1, dt * 2)
		end
		local k = math.min(1, dt * 16)
		for i, eqBar in ipairs(eqBars) do
			eqHeights[i] += (eqTargets[i] - eqHeights[i]) * k
			eqBar.Size = UDim2.fromOffset(barWidth, math.floor(3 + eqHeights[i] * 25))
		end

		-- Vinyle
		disc.Rotation = (disc.Rotation + discSpin * 60 * dt) % 360
	end)
end

return Lofi
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">LootBox</string>
            <string name="Source"><![CDATA[--[[
	LootBox (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > LootBox

	Coffre au trésor "premium" (slot CR, 170x170) façon jeu mobile, dessiné
	entièrement en code avec des formes superposées :
	  - carte violette royale avec reflet, halo lumineux qui "respire"
	    derrière le coffre (plus fort et doré quand un coffre est prêt) ;
	  - coffre illustré : planches de bois (dégradé, lignes, veines),
	    renforts dorés avec rivets, rebord doré, couvercle bombé avec
	    reflet, serrure dorée dont le trou de serrure s'illumine, ombre
	    douce au sol qui suit les sauts ;
	  - animations au repos : léger flottement, reflets étincelants sur le
	    métal ; quand un coffre est prêt : petits sauts d'impatience,
	    étincelles autour, bulle "PRÊT !" qui rebondit ;
	  - anneau de charge en arc (segments en dégradé jaune -> orange) +
	    pourcentage en bas ; pastille rouge = coffres en stock (avec "pop").
	Clic -> OpenChest (serveur, protégé par pcall + verrou "opening") :
	le coffre tremble de plus en plus fort, la serrure explose, le couvercle
	bascule, des rayons et des particules de la couleur du rang jaillissent,
	puis une carte récompense monte du coffre (nom du rang, étoiles de
	rareté, gain qui défile). Légendaire = rayons en plus, confettis, flash
	et gros message.
	Bouton "?" : carte des chances (barres colorées + %) calculées depuis
	les poids (Weight) de Config.LootBox.Tiers.

	Tout est construit dans ctx.Container (nettoyé par le StimulusManager) ;
	les particules et reflets sont des réserves recyclées (~150 objets).
]]

local LootBox = {}
LootBox.Slot = "CR"

local Locale = require(game:GetService("ReplicatedStorage").Shared.Locale)

-- Géométrie (pixels "design" de la carte 170x170)
local RING_SEGMENTS = 24 -- segments de l'anneau de charge
local RING_RADIUS = 67
local RING_ARC = 270 -- degrés (ouverture en bas pour le pourcentage)
local CHEST_W = 92
local CHEST_H = 80
local HINGE_Y = 36 -- haut du corps du coffre (charnière du couvercle)
local LID_W = 84
local LID_H = 28
local LID_INNER_H = 22
local REWARD_Y = 50 -- centre final de la carte récompense
local GLINT_POOL = 4 -- reflets recyclés
local SPARK_POOL = 8 -- éclats recyclés
local MIN_SHAKE_TIME = 0.9 -- durée minimale du tremblement avant l'ouverture

-- Couleurs
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local CARD_TOP = Color3.fromRGB(116, 72, 212)
local CARD_BOTTOM = Color3.fromRGB(44, 20, 100)
local IDLE_GLOW = Color3.fromRGB(190, 150, 255)
local WOOD_LIGHT = Color3.fromRGB(206, 134, 68)
local WOOD = Color3.fromRGB(164, 96, 44)
local WOOD_DARK = Color3.fromRGB(106, 56, 22)
local WOOD_OUTLINE = Color3.fromRGB(58, 28, 10)
local WOOD_INSIDE = Color3.fromRGB(64, 30, 10)
local GOLD_LIGHT = Color3.fromRGB(255, 246, 176)
local GOLD = Color3.fromRGB(255, 198, 42)
local GOLD_DARK = Color3.fromRGB(204, 128, 0)
local GOLD_EDGE = Color3.fromRGB(120, 70, 0)
local KEY_DARK = Color3.fromRGB(46, 22, 6)
local KEY_GLOW = Color3.fromRGB(255, 244, 160)
local RING_TRACK = Color3.fromRGB(26, 10, 62)
local RING_START = Color3.fromRGB(255, 232, 80)
local RING_END = Color3.fromRGB(255, 118, 36)

local EFFECT_TEXT_Y = 40 -- hauteur (dans la carte) des textes flottants

function LootBox.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local Create = UIUtil.Create
	local Format = ctx.Format
	local config = ctx.Config.LootBox
	local tiers = config.Tiers
	local container: Frame = ctx.Container
	local random = Random.new()

	local width = container.Size.X.Offset > 0 and container.Size.X.Offset or 170
	local height = container.Size.Y.Offset > 0 and container.Size.Y.Offset or 170
	local cx = width / 2
	local cy = height / 2 - 1 -- centre de l'anneau
	local chestCY = cy + 2 -- centre du coffre

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	local function readChests(): (number, number, number)
		local data = ctx.State.Data
		local chests = data and data.Chests
		if type(chests) ~= "table" then
			return 0, 0, config.MaxStored or 5
		end
		return tonumber(chests.Stored) or 0, tonumber(chests.Progress) or 0, tonumber(chests.Max) or config.MaxStored or 5
	end

	------------------------------------------------------------------
	-- Petits outils de dessin
	------------------------------------------------------------------
	local function box(parent: Instance, props: { [string]: any }): any
		props.BorderSizePixel = 0
		if props.BackgroundColor3 == nil then
			props.BackgroundColor3 = WHITE
		end
		props.Parent = parent
		return Create("Frame", props)
	end

	local function round(object: Instance)
		UIUtil.Corner(object, UDim.new(1, 0))
	end

	local function vGradient(object: Instance, top: Color3, bottom: Color3): UIGradient
		return Create("UIGradient", { Color = ColorSequence.new(top, bottom), Rotation = 90, Parent = object })
	end

	-- Métal doré "bombé" (clair au milieu) ; rotation 0 = bande verticale
	local function metal(object: Instance, rotation: number)
		Create("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, GOLD_DARK),
				ColorSequenceKeypoint.new(0.4, GOLD_LIGHT),
				ColorSequenceKeypoint.new(0.7, GOLD),
				ColorSequenceKeypoint.new(1, GOLD_DARK),
			}),
			Rotation = rotation,
			Parent = object,
		})
	end

	local function fadeEnds(): NumberSequence
		return NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0),
			NumberSequenceKeypoint.new(1, 1),
		})
	end

	-- Rivet doré (petite bille avec reflet en diagonale)
	local function rivet(parent: Instance, position: UDim2, size: number, z: number)
		local dot = box(parent, {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = position,
			Size = UDim2.fromOffset(size, size),
			ZIndex = z,
		})
		round(dot)
		Create("UIGradient", { Color = ColorSequence.new(GOLD_LIGHT, GOLD_EDGE), Rotation = 45, Parent = dot })
	end

	-- Forme au dessus arrondi et au bas carré (couvercle bombé) :
	-- un cadre arrondi + deux "bouche-coins" en bas qui suivent le dégradé
	local function roundedTop(parent: Instance, z: number, top: Color3, bottom: Color3, radius: number, position: UDim2, size: UDim2): any
		local cap = box(parent, { Position = position, Size = size, ZIndex = z })
		UIUtil.Corner(cap, radius)
		vGradient(cap, top, bottom)
		local middle = top:Lerp(bottom, 0.5)
		for _, side in ipairs({ 0, 1 }) do
			local filler = box(cap, {
				AnchorPoint = Vector2.new(side, 1),
				Position = UDim2.fromScale(side, 1),
				Size = UDim2.new(0, radius, 0.5, 0),
				ZIndex = z,
			})
			vGradient(filler, middle, bottom)
		end
		return cap
	end

	------------------------------------------------------------------
	-- Carte (toute la carte est cliquable)
	------------------------------------------------------------------
	local card = Create("TextButton", {
		Name = "Card",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = WHITE,
		AutoButtonColor = false,
		Text = "",
		BorderSizePixel = 0,
		ZIndex = 1,
		Parent = container,
	})
	UIUtil.Corner(card, 20)
	UIUtil.Stroke(card, Theme.Colors.CardBorder, 2)
	vGradient(card, CARD_TOP, CARD_BOTTOM)
	local cardScale = Create("UIScale", { Parent = card })

	-- Reflet en haut de la carte
	local sheen = box(card, {
		Size = UDim2.new(1, 0, 0.55, 0),
		ZIndex = 2,
	})
	UIUtil.Corner(sheen, 20)
	Create("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new(0.84, 1),
		Parent = sheen,
	})

	-- Texte flottant dans le calque Overlay (le slot coupe ce qui dépasse).
	-- `point` = position en pixels "design" dans la carte.
	local function floatText(point: Vector2, text: string, color: Color3?, size: number?)
		local interface = ctx.Interface
		if interface and interface.ScreenToCanvas and ctx.Overlay then
			local ratio = card.AbsoluteSize.X / math.max(1, width)
			local canvas = interface.ScreenToCanvas(card.AbsolutePosition + point * ratio)
			ctx.FloatText(ctx.Overlay, UDim2.fromOffset(canvas.X, canvas.Y), text, color, size)
		else
			ctx.FloatText(card, UDim2.fromOffset(point.X, point.Y), text, color, size)
		end
	end

	------------------------------------------------------------------
	-- Halo + rayons (derrière le coffre)
	------------------------------------------------------------------
	local glowOuter = box(card, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(cx, chestCY + 2),
		Size = UDim2.fromOffset(124, 124),
		BackgroundColor3 = IDLE_GLOW,
		BackgroundTransparency = 0.9,
		ZIndex = 3,
	})
	round(glowOuter)
	local glowInner = box(glowOuter, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.64, 0.64),
		BackgroundColor3 = IDLE_GLOW,
		BackgroundTransparency = 0.85,
		ZIndex = 3,
	})
	round(glowInner)

	local function makeRays(count: number, size: number): (Frame, { Frame })
		local holder = UIUtil.Rays(card, GOLD, count, size, UDim2.fromOffset(cx, chestCY - 6), 4)
		holder.Visible = false
		local bars = {}
		for _, child in ipairs(holder:GetChildren()) do
			if child:IsA("Frame") then
				child.BackgroundTransparency = 1
				table.insert(bars, child)
			end
		end
		return holder, bars
	end
	local rays, rayBars = makeRays(6, 240)
	local bigRays, bigRayBars = makeRays(6, 300)

	------------------------------------------------------------------
	-- Anneau de charge (arc de segments)
	------------------------------------------------------------------
	local segments = {}
	for index = 1, RING_SEGMENTS do
		local t = (index - 0.5) / RING_SEGMENTS
		local angle = math.rad(-RING_ARC / 2 + RING_ARC * t) -- 0 = midi, sens horaire
		local segment = box(card, {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(cx + math.sin(angle) * RING_RADIUS, cy - math.cos(angle) * RING_RADIUS),
			Size = UDim2.fromOffset(11, 5),
			Rotation = math.deg(angle),
			BackgroundColor3 = RING_TRACK,
			BackgroundTransparency = 0.45,
			ZIndex = 5,
		})
		UIUtil.Corner(segment, UDim.new(1, 0))
		segments[index] = {
			Frame = segment,
			Color = RING_START:Lerp(RING_END, (index - 1) / math.max(1, RING_SEGMENTS - 1)),
			Fill = 0,
		}
	end

	local percentPill = UIUtil.Label({
		Text = "0 %",
		Font = Theme.Fonts.Number,
		TextColor3 = WHITE,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(cx, height - 17),
		Size = UDim2.fromOffset(66, 20),
		BackgroundTransparency = 0.25,
		BackgroundColor3 = RING_TRACK,
		MaxTextSize = 13,
		ZIndex = 23,
		Parent = card,
	})
	UIUtil.Corner(percentPill, UDim.new(1, 0))
	UIUtil.Stroke(percentPill, RING_START, 1.5, 0.35)

	------------------------------------------------------------------
	-- Ombre au sol
	------------------------------------------------------------------
	local shadow = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(cx, chestCY + CHEST_H / 2 - 1),

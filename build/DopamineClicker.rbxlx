		add(name, Vector3.new(0.1, 0.03, 0.06), CFrame.new(x + 0.08, 0.285, 0) * CFrame.Angles(0, math.rad(-40), 0), rgb(255, 204, 40), M.SmoothPlastic)
	end
	add("Bite3", Vector3.new(0.15, 0.15, 0.15), CFrame.new(-0.52, 0.2, 0), sausage, M.SmoothPlastic, BALL)
	add("Bite1", Vector3.new(0.15, 0.15, 0.15), CFrame.new(0.72, 0.2, 0), sausage, M.SmoothPlastic, BALL)
	add("Bite2", Vector3.new(0.9, 0.025, 0.035), CFrame.new(0.1, 0.29, 0.04), rgb(200, 30, 30), M.SmoothPlastic)
end

-- Pomme d'amour : bâton de bois, pomme vernie rouge brillante (+ collerette
-- de sucre qui a coulé au pied), feuille
RECIPES.CandyApple = function(add)
	add("Handle", Vector3.new(0.7, 0.09, 0.09), CFrame.new(0, 0, 0) * UPRIGHT, rgb(206, 164, 114), M.Wood, CYL)
	local glaze = rgb(196, 18, 40)
	local b2 = add("Bite2", Vector3.new(0.72, 0.62, 0.72), CFrame.new(0, 0.62, 0), glaze, M.SmoothPlastic, BALL)
	b2.Reflectance = 0.18
	local b1 = add("Bite1", Vector3.new(0.62, 0.52, 0.62), CFrame.new(0, 0.86, 0), rgb(214, 26, 48), M.SmoothPlastic, BALL)
	b1.Reflectance = 0.18
	add("Bite2", Vector3.new(0.08, 0.72, 0.72), CFrame.new(0, 0.36, 0) * UPRIGHT, rgb(170, 12, 30), M.SmoothPlastic, CYL)
	add("Bite1", Vector3.new(0.18, 0.04, 0.1), CFrame.new(0.1, 1.12, 0.02) * CFrame.Angles(0, 0.4, math.rad(25)), rgb(96, 170, 70), M.SmoothPlastic)
	add("Bite1", Vector3.new(0.12, 0.12, 0.03), CFrame.new(-0.12, 0.92, -0.29) * CFrame.Angles(0.3, 0.4, 0), rgb(255, 230, 230), M.SmoothPlastic).Transparency = 0.3
end

-- Beignet (vertical, tenu par le bas) : anneau de pâte (12 boules), glaçage
-- rose côté visage, vermicelles de couleur
RECIPES.Donut = function(add)
	local dough = rgb(214, 150, 84)
	local glaze = rgb(255, 150, 196)
	add("Handle", Vector3.new(0.3, 0.3, 0.3), CFrame.new(0, 0, 0), dough, M.SmoothPlastic, BALL)
	local sprinkle = { rgb(80, 170, 255), rgb(255, 214, 60), rgb(255, 255, 255), rgb(128, 214, 150) }
	for k = 1, 11 do
		local a = k / 12 * math.pi * 2
		local p = CFrame.new(math.sin(a) * 0.34, 0.34 - math.cos(a) * 0.34, 0)
		local bite = if k >= 4 and k <= 8 then 1 else 2 -- le haut part d'abord
		add("Bite" .. bite, Vector3.new(0.3, 0.3, 0.3), p, dough, M.SmoothPlastic, BALL)
		add("Bite" .. bite, Vector3.new(0.26, 0.26, 0.12), p * CFrame.new(0, 0, 0.1), glaze, M.SmoothPlastic, BALL)
		if k % 2 == 0 then
			add("Bite" .. bite, Vector3.new(0.07, 0.02, 0.02), p * CFrame.new(0.03, 0.02, 0.16) * CFrame.Angles(0, 0, k), sprinkle[k % 4 + 1], M.SmoothPlastic)
		end
	end
end

-- Aliment id -> Model (ancré) ; `cf` = repère de la prise ; `scale` (1)
function FoodModels.Build(id: string, cf: CFrame?, scale: number?): Model?
	local recipe = RECIPES[id]
	if not recipe then
		return nil
	end
	local base = cf or CFrame.identity
	local s = scale or 1
	local model = Instance.new("Model")
	model.Name = id
	local handle: BasePart? = nil
	recipe(function(name, size, loc, color, material, shape, className)
		local p = Instance.new((className or "Part") :: any) :: BasePart
		p.Name = name
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Massless = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		if shape and p:IsA("Part") then
			p.Shape = shape
		end
		p.Size = size * s
		p.CFrame = base * CFrame.new(loc.Position * s) * loc.Rotation
		p.Color = color
		p.Material = material or M.SmoothPlastic
		p.Parent = model
		if name == "Handle" and handle == nil then
			handle = p
		end
		return p
	end)
	model.PrimaryPart = handle
	return model
end

function FoodModels.Has(id: string): boolean
	return RECIPES[id] ~= nil
end

return FoodModels
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="257">
        <Properties>
          <string name="Name">FoodRules</string>
          <string name="Source"><![CDATA[--[[
	FoodRules (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > FoodRules

	🍦 Règles PURES de la nourriture de Dopamine Town (v9.8, FAIR98) :
	prix et cumul des boosts. Utilisé par le serveur (FoodService, qui
	décide) et par le client (FairFx : afficher le prix avant d'acheter),
	testé par tests/run_tests.py (sans Roblox).
]]

local Config = require(script.Parent.Config)

local FoodRules = {}

local function finite(v: any, default: number): number
	if type(v) ~= "number" or v ~= v or v == math.huge or v == -math.huge then
		return default
	end
	return v
end

-- Valeur d'un aliment : secondes de production "offertes" par son boost
function FoodRules.BoostSeconds(food: any): number
	return math.max(0, (finite(food.Multiplier, 1) - 1) * finite(food.Duration, 0))
end

-- Arrondi "joli" vers le haut (2 chiffres significatifs)
local function nice(x: number): number
	if x < 100 then
		return math.ceil(x)
	end
	local p = 10 ^ (math.floor(math.log10(x)) - 1)
	return math.ceil(x / p) * p
end

-- Prix en Dopamine. `perSecond` / `clickValue` = production actuelle du
-- joueur (stats du serveur) ; `foodMultiplier` = boost nourriture déjà
-- actif (on l'enlève : manger ne rend pas la suivante plus chère).
function FoodRules.Price(food: any, perSecond: any, clickValue: any, foodMultiplier: any): number
	local F = Config.Food
	local m = math.max(1, finite(foodMultiplier, 1))
	local production = (math.max(0, finite(perSecond, 0)) + math.max(0, finite(clickValue, 0)) * Config.Rewards.EstimatedClicksPerSecond) / m
	local price = F.PriceFactor * FoodRules.BoostSeconds(food) * production
	return nice(math.max(F.MinPrice, price))
end

-- Cumul : boost actuel (multiplicateur, secondes restantes) + aliment ->
-- nouveau (multiplicateur, secondes restantes). La "valeur" déjà gagnée
-- ((m - 1) x secondes) est conservée en changeant de multiplicateur.
function FoodRules.Stack(multiplier: any, remaining: any, food: any): (number, number)
	local F = Config.Food
	local cur = math.max(1, finite(multiplier, 1))
	local left = math.max(0, finite(remaining, 0))
	local m = math.clamp(finite(food.Multiplier, 1), 1, F.MaxMultiplier)
	local d = math.max(0, finite(food.Duration, 0))
	if m <= 1 or d <= 0 then
		return cur, math.min(left, F.MaxSeconds)
	end
	if left <= 0 or cur <= 1 then
		return m, math.min(d, F.MaxSeconds)
	end
	if m > cur then
		local converted = left * (cur - 1) / (m - 1)
		return m, math.min(d + converted, F.MaxSeconds)
	end
	local added = d * (m - 1) / (cur - 1)
	return cur, math.min(left + added, F.MaxSeconds)
end

-- Multiplicateur MOYEN au mieux (en mangeant sans arrêt le meilleur
-- rapport), prix déduit : 1 + (Mmax - 1) x (1 - PriceFactor). Sert aux
-- tests d'économie (il ne doit pas casser le rythme des parties).
function FoodRules.MaxNetMultiplier(): number
	local F = Config.Food
	return 1 + (F.MaxMultiplier - 1) * (1 - F.PriceFactor)
end

return FoodRules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="258">
        <Properties>
          <string name="Name">Formulas</string>
          <string name="Source"><![CDATA[--[[
	Formulas (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > Formulas

	Toutes les formules de calcul du jeu (coûts, gains, combo, rebirth,
	casino...). Partagé entre serveur et client pour que l'affichage
	corresponde exactement aux calculs du serveur. Le serveur reste l'autorité.
]]

local Config = require(script.Parent.Config)

local Formulas = {}

----------------------------------------------------------------------
-- Améliorations
----------------------------------------------------------------------

-- Niveau actuel d'une amélioration
function Formulas.GetLevel(data, upgradeId: string): number
	return data.Upgrades[upgradeId] or 0
end

-- Nombre de visites à l'océan lisible (nil, NaN, négatif -> 0)
local function cleanRebirths(rebirths: any): number
	local value = tonumber(rebirths) or 0
	if value ~= value or value < 0 then
		return 0
	end
	return math.min(math.floor(value), 1000)
end

-- Rebirth ("Aller à l'océan") : prix de la PROCHAINE visite quand on en a
-- déjà fait `rebirths`. BaseCost x CostGrowth^r x (1 + r)^CostPower : la
-- partie polynomiale rend chaque visite nettement plus longue que la
-- précédente (le multiplicateur gagné ne suffit jamais à la rattraper).
function Formulas.GetRebirthCost(rebirths: number): number
	local settings = Config.Rebirth
	local r = cleanRebirths(rebirths)
	return settings.BaseCost * (settings.CostGrowth ^ r) * ((1 + r) ^ (settings.CostPower or 0))
end

-- Multiplicateur permanent des visites : +MultiplierPerRebirth par visite,
-- de moins en moins (x MultiplierDecay à chaque visite suivante)
function Formulas.GetRebirthMultiplier(rebirths: number): number
	local settings = Config.Rebirth
	local r = cleanRebirths(rebirths)
	local decay = settings.MultiplierDecay or 1
	local bonus = 0
	local step = settings.MultiplierPerRebirth
	for _ = 1, r do
		bonus += step
		step *= decay
	end
	return 1 + bonus
end

-- Les améliorations (non permanentes) coûtent PriceGrowth^r x (1 + r)^PricePower
-- fois plus après r visites à l'océan : chaque partie coûte plus cher que la
-- précédente (surtout au début, puis de moins en moins vite)
function Formulas.GetUpgradePriceScale(rebirths: number?): number
	local settings = Config.Rebirth
	local r = cleanRebirths(rebirths)
	return (settings.PriceGrowth or 1) ^ r * (1 + r) ^ (settings.PricePower or 0)
end

-- Prix du PROCHAIN niveau (level = niveau actuel)
function Formulas.GetUpgradeCost(upgrade, level: number, rebirths: number?): number
	if upgrade.Effect == "Detox" then
		return Formulas.GetRebirthCost(rebirths or 0)
	end
	local scale = upgrade.Permanent and 1 or Formulas.GetUpgradePriceScale(rebirths)
	return math.floor(upgrade.Cost * (upgrade.CostGrowth ^ level) * scale + 0.5)
end

function Formulas.IsMaxed(upgrade, level: number): boolean
	return upgrade.MaxLevel ~= nil and level >= upgrade.MaxLevel
end

-- Texte de l'infobulle ("%s" remplacé par la valeur formatée).
-- `translate` (optionnel, ex. Locale.T) traduit la description AVANT de
-- remplacer "%s" : Formulas.DescribeUpgrade(upgrade, NumberFormatter.Format, rebirths, Locale.T)
function Formulas.DescribeUpgrade(
	upgrade,
	format: (number) -> string,
	rebirths: number?,
	translate: ((string) -> string)?
): string
	local text = upgrade.Description or ""
	if translate then
		local ok, translated = pcall(translate, text)
		if ok and type(translated) == "string" then
			text = translated
		end
	end
	if not string.find(text, "%s", 1, true) then
		return text
	end
	local value = upgrade.Value or 0
	if upgrade.Effect == "Detox" then
		value = Formulas.GetRebirthMultiplier((rebirths or 0) + 1)
	elseif upgrade.Effect == "DVD" then
		value = Config.DVD.BaseBounceValue
	end
	return (string.gsub(text, "%%s", format(value), 1))
end

-- Liste des améliorations visibles dans la barre : celles déjà possédées
-- (et pas au maximum) + les Config.UpgradeBar.RevealAhead suivantes.
-- Vrai si l'amélioration peut être achetée : assez de visites à l'océan
-- (RequiresRebirths) et amélioration requise déjà possédée (Requires)
function Formulas.IsUpgradeUnlocked(data, upgrade): boolean
	local rebirths = type(data) == "table" and tonumber(data.Rebirths) or 0
	if (upgrade.RequiresRebirths or 0) > (rebirths or 0) then
		return false
	end
	if upgrade.Requires and Formulas.GetLevel(data, upgrade.Requires) <= 0 then
		return false
	end
	return true
end

-- Prochaine nouveauté verrouillée par les renaissances (pour l'annoncer :
-- "🌊 x nouveautés après ta prochaine visite à l'océan"), nil s'il n'y en a plus
function Formulas.GetNextRebirthUnlocks(data): (number?, number)
	local rebirths = type(data) == "table" and tonumber(data.Rebirths) or 0
	local nextGate: number? = nil
	for _, upgrade in ipairs(Config.Upgrades) do
		local gate = upgrade.RequiresRebirths or 0
		if gate > (rebirths or 0) and (nextGate == nil or gate < nextGate) then
			nextGate = gate
		end
	end
	local count = 0
	if nextGate then
		for _, upgrade in ipairs(Config.Upgrades) do
			if (upgrade.RequiresRebirths or 0) == nextGate then
				count += 1
			end
		end
	end
	return nextGate, count
end

function Formulas.GetVisibleUpgrades(data): { any }
	local list = {}
	local revealed = 0
	for _, upgrade in ipairs(Config.Upgrades) do
		local level = Formulas.GetLevel(data, upgrade.Id)
		if not Formulas.IsMaxed(upgrade, level) and Formulas.IsUpgradeUnlocked(data, upgrade) then
			if level > 0 then
				table.insert(list, upgrade)
			elseif revealed < Config.UpgradeBar.RevealAhead then
				-- (les améliorations verrouillées ne comptent pas : elles ne
				-- bloquent jamais l'océan)
				table.insert(list, upgrade)
				revealed += 1
			end
		end
	end
	return list
end

-- Ensemble des "Features" débloquées : { [Feature] = true }
function Formulas.GetFeatures(data): { [string]: boolean }
	local features = {}
	for _, upgrade in ipairs(Config.Upgrades) do
		if upgrade.Feature and Formulas.GetLevel(data, upgrade.Id) > 0 then
			features[upgrade.Feature] = true
		end
	end
	return features
end

function Formulas.HasFeature(data, feature: string): boolean
	local upgradeId = Config.FeatureToUpgrade[feature]
	return upgradeId ~= nil and Formulas.GetLevel(data, upgradeId) > 0
end

----------------------------------------------------------------------
-- Combo
----------------------------------------------------------------------

-- Jauge 0-100 -> multiplicateur 1 à MaxMultiplier
function Formulas.GetComboMultiplier(meter: number): number
	local ratio = math.clamp(meter / 100, 0, 1)
	return 1 + ratio * (Config.Combo.MaxMultiplier - 1)
end

-- Met à jour la jauge : on retire la perte depuis le dernier clic puis on ajoute un clic
function Formulas.StepCombo(meter: number, elapsed: number): number
	meter = math.max(0, meter - Config.Combo.DecayPerSecond * elapsed)
	return math.min(100, meter + Config.Combo.GainPerClick)
end

----------------------------------------------------------------------
-- Statistiques d'un joueur
----------------------------------------------------------------------

local function countKeys(map, lookup): number
	local count = 0
	for id, value in pairs(map) do
		if value and lookup[id] then
			count += 1
		end
	end
	return count
end

function Formulas.CountAchievements(data): number
	return countKeys(data.Achievements, Config.AchievementsById)
end

function Formulas.CountCosmetics(data): number
	local cosmetics = data.Cosmetics
	if not cosmetics or not cosmetics.Owned then
		return 0
	end
	return countKeys(cosmetics.Owned, Config.CosmeticsById)
end

-- Bonus permanents : +Config.CosmeticBonus par objet cosmétique possédé,
-- +Config.AchievementBonus par succès (linéaires, petits : jamais une boule
-- de neige, même avec tout le catalogue)
function Formulas.GetCosmeticMultiplier(count: number?): number
	return 1 + math.max(0, tonumber(count) or 0) * Config.CosmeticBonus
end

function Formulas.GetAchievementMultiplier(count: number?): number
	return 1 + math.max(0, tonumber(count) or 0) * Config.AchievementBonus
end

-- Verrous des renaissances (visites à l'océan) des cosmétiques et des thèmes
function Formulas.GetRequiredRebirths(entry): number
	return type(entry) == "table" and tonumber(entry.RequiresRebirths) or 0
end

function Formulas.IsCosmeticUnlocked(data, cosmetic): boolean
	local rebirths = type(data) == "table" and tonumber(data.Rebirths) or 0
	return Formulas.GetRequiredRebirths(cosmetic) <= (rebirths or 0)
end

function Formulas.IsThemeUnlocked(data, theme): boolean
	return Formulas.IsCosmeticUnlocked(data, theme)
end

-- `data` = données sauvegardées du joueur, `eventMultiplier` = Rush en cours (ou 1),
-- `bonusMultiplier` = bonus Robux (Game Passes x Boost actif), calculé par le serveur (ou 1)
function Formulas.ComputeStats(data, eventMultiplier: number?, bonusMultiplier: number?)
	local baseClick = 1
	local basePerSecond = 0
	local clickMultiplier = 1
	local bounceMultiplier = 1
	local upgradeMultiplier = 1
	local dvdCount = 0

	for _, upgrade in ipairs(Config.Upgrades) do
		local level = Formulas.GetLevel(data, upgrade.Id)
		if level > 0 then
			local effect = upgrade.Effect
			if effect == "Click" then
				baseClick += upgrade.Value * level
			elseif effect == "PerSecond" then
				basePerSecond += upgrade.Value * level
			elseif effect == "DVD" then
				dvdCount += level
			elseif effect == "BounceMultiplier" then
				bounceMultiplier *= upgrade.Value ^ level
			elseif effect == "ClickMultiplier" then
				clickMultiplier *= upgrade.Value ^ level
			elseif effect == "Multiplier" then
				upgradeMultiplier *= upgrade.Value ^ level
			end
		end
	end

	local rebirthMultiplier = Formulas.GetRebirthMultiplier(data.Rebirths)
	local achievementMultiplier = Formulas.GetAchievementMultiplier(Formulas.CountAchievements(data))
	local cosmeticMultiplier = Formulas.GetCosmeticMultiplier(Formulas.CountCosmetics(data))
	local eventMult = eventMultiplier or 1
	local bonusMult = bonusMultiplier or 1
	local globalMultiplier = upgradeMultiplier * rebirthMultiplier * achievementMultiplier * cosmeticMultiplier * eventMult * bonusMult

	return {
		BaseClick = baseClick,
		BasePerSecond = basePerSecond,
		ClickMultiplier = clickMultiplier,
		BounceMultiplier = bounceMultiplier,
		UpgradeMultiplier = upgradeMultiplier,
		RebirthMultiplier = rebirthMultiplier,
		AchievementMultiplier = achievementMultiplier,
		CosmeticMultiplier = cosmeticMultiplier,
		EventMultiplier = eventMult,
		BonusMultiplier = bonusMult,
		GlobalMultiplier = globalMultiplier,
		ClickValue = baseClick * clickMultiplier * globalMultiplier,
		PerSecond = basePerSecond * globalMultiplier,
		BounceValue = Config.DVD.BaseBounceValue * bounceMultiplier * globalMultiplier,
		DVDCount = dvdCount,
	}
end

-- Récompense qui vaut `seconds` secondes de production (au moins `minimum`)
function Formulas.ScaledReward(stats, seconds: number, minimum: number): number
	local production = stats.PerSecond + stats.ClickValue * Config.Rewards.EstimatedClicksPerSecond
	return math.floor(math.max(minimum, production * seconds))
end

----------------------------------------------------------------------
-- Dopamine hors-ligne
----------------------------------------------------------------------

-- Niveau total des améliorations "Offline" (Mode veille)
function Formulas.GetOfflineLevel(data): number
	local level = 0
	for _, upgrade in ipairs(Config.Upgrades) do
		if upgrade.Effect == "Offline" then
			level += Formulas.GetLevel(data, upgrade.Id)
		end
	end
	return level
end

-- (taux 0..1, durée max en secondes)
function Formulas.GetOfflineSettings(data): (number, number)
	local level = Formulas.GetOfflineLevel(data)
	local rate = Config.Offline.BaseRate + Config.Offline.RatePerLevel * level
	local maxSeconds = (Config.Offline.BaseMaxHours + Config.Offline.HoursPerLevel * level) * 3600
	return rate, maxSeconds
end

-- Gain hors-ligne pour `seconds` d'absence avec la production `perSecond`
function Formulas.GetOfflineReward(data, perSecond: number, seconds: number): number
	if seconds < Config.Offline.MinSeconds or perSecond <= 0 then
		return 0
	end
	local rate, maxSeconds = Formulas.GetOfflineSettings(data)
	return math.floor(perSecond * rate * math.min(seconds, maxSeconds))
end

----------------------------------------------------------------------
-- 🎰 Machine chanceuse (tours GRATUITS : aucune mise)
-- Les gains sont en SECONDES de production (voir Formulas.ScaledReward)
----------------------------------------------------------------------

-- Secondes de production gagnées pour 3 symboles (ids). 0 = rien d'aligné.
-- Paire = 2 symboles identiques, Triple = 3 (on garde la meilleure combinaison)
function Formulas.GetCasinoMultiplier(reels: { string }): number
	local counts = {}
	for _, id in ipairs(reels) do
		counts[id] = (counts[id] or 0) + 1
	end
	local best = 0
	for id, count in pairs(counts) do
		local symbol = Config.CasinoSymbolsById[id]
		if symbol then
			if count >= 3 then
				best = math.max(best, symbol.Triple or 0)
			elseif count == 2 then
				best = math.max(best, symbol.Pair or 0)
			end
		end
	end
	return best
end

-- Secondes réellement données pour ce tirage (lot de consolation si rien ne sort)
function Formulas.GetCasinoRewardSeconds(reels: { string }): number
	local seconds = Formulas.GetCasinoMultiplier(reels)
	if seconds <= 0 then
		return Config.Casino.MissRewardSeconds or 0
	end
	return seconds
end

-- Gain moyen d'un tour, en secondes de production (consolation comprise)
function Formulas.GetCasinoRTP(): number
	local symbols = Config.Casino.Symbols
	local totalWeight = 0
	for _, symbol in ipairs(symbols) do
		totalWeight += symbol.Weight
	end
	if totalWeight <= 0 then
		return 0
	end
	local expected = 0
	for _, a in ipairs(symbols) do
		for _, b in ipairs(symbols) do
			for _, c in ipairs(symbols) do
				local probability = (a.Weight / totalWeight) * (b.Weight / totalWeight) * (c.Weight / totalWeight)
				expected += probability * Formulas.GetCasinoRewardSeconds({ a.Id, b.Id, c.Id })
			end
		end
	end
	return expected
end

----------------------------------------------------------------------
-- 🌻 Jardin de Dopamine
----------------------------------------------------------------------

-- Nombre de parterres (BasePlots + niveau de "Flower Beds")
function Formulas.GetGardenPlotCount(data): number
	local settings = Config.Garden
	local count = settings.BasePlots or 3
	for _, upgrade in ipairs(Config.Upgrades) do
		if upgrade.Feature == "GardenPlots" then
			count += Formulas.GetLevel(data, upgrade.Id)
		end
	end
	return count
end

----------------------------------------------------------------------
-- 🏠 Maison
----------------------------------------------------------------------

-- Prix du PROCHAIN exemplaire d'un objet (ownedCount = exemplaires déjà possédés)
function Formulas.GetHouseItemPrice(item, ownedCount: number?): number
	local owned = tonumber(ownedCount) or 0
	if owned ~= owned or owned < 0 then
		owned = 0
	end
	return math.floor(item.Cost * ((item.CostGrowth or 1) ^ math.floor(owned)))
end

-- Catégories dont les objets ne se posent jamais SUR un meuble (sauf
-- Tabletop = true dans la config : valise, carton...)
local NOT_ON_FURNITURE = { Furniture = true, Doors = true, Windows = true }

-- Vrai si l'objet peut être posé SUR un meuble (table, étagère, lit,
-- canapé...) : petit objet au sol, pas un meuble ni une porte. Même règle
-- côté client (éditeur) et serveur (limites de la disposition).
function Formulas.CanGoOnFurniture(item): boolean
	if type(item) ~= "table" or item.Placement ~= "Floor" then
		return false
	end
	if item.Tabletop == true then
		return true
	elseif item.Tabletop == false or NOT_ON_FURNITURE[item.Category] then
		return false
	end
	local house = Config.House
	return (tonumber(item.Size) or math.huge) <= (tonumber(house.TabletopMaxSize) or 0)
end

-- Plus petit Y (pieds) permis pour un objet au sol : celui des objets posés
-- sur les meubles s'il peut y aller (ou petit objet d'une ancienne
-- sauvegarde), sinon le haut de la zone du sol
function Formulas.GetHouseFloorMinY(item): number
	local house = Config.House
	local legacy = tonumber(house.LegacyTabletopSize) or 0
	if Formulas.CanGoOnFurniture(item) or (type(item) == "table" and (tonumber(item.Size) or math.huge) <= legacy) then
		return tonumber(house.TabletopMinY) or 0.22
	end
	return house.WallRatio * 0.85
end

-- Taille de maison actuelle (config) : la 1re si la sauvegarde est invalide
function Formulas.GetHouseSize(data)
	local house = type(data) == "table" and data.House or nil
	local sizeId = type(house) == "table" and house.Size or nil
	return (type(sizeId) == "string" and Config.HouseSizesById[sizeId]) or Config.House.Sizes[1]
end

-- Type de pièce (config) : le 1er (salon) si l'id est inconnu
function Formulas.GetRoomType(typeId: any)
	return (type(typeId) == "string" and Config.HouseRoomTypesById[typeId]) or Config.House.RoomTypes[1]
end

-- Vrai si l'objet est un "préféré" de ce type de pièce (bonus d'harmonie)
function Formulas.IsRoomFavorite(roomType, item): boolean
	if type(roomType) ~= "table" or type(item) ~= "table" then
		return false
	end
	return roomType.FavoriteItems[item.Id] == true or roomType.FavoriteCategories[item.Category] == true
end

-- Confort d'un objet posé dans une pièce (harmonie comprise)
function Formulas.GetPlacedComfort(roomType, item): number
	local comfort = item.Comfort
	if Formulas.IsRoomFavorite(roomType, item) then
		comfort *= 1 + Config.House.HarmonyBonus
	end
	return comfort
end

-- Pièces de la maison (format sauvegardé). Une ancienne sauvegarde (une seule
-- pièce : house.Placed) est vue comme un salon unique.
function Formulas.GetHouseRooms(house): { any }
	if type(house) ~= "table" then
		return {}
	end
	if type(house.Rooms) == "table" and #house.Rooms > 0 then
		return house.Rooms
	end
	if type(house.Placed) == "table" then
		return { { Id = "R1", Type = "Living", Slot = 1, Placed = house.Placed } }
	end
	return {}
end

-- Visites à l'océan nécessaires pour acheter un objet / un style / une
-- maison / un type de pièce de la maison (0 = disponible tout de suite).
-- RequiresRebirths explicite dans la config, sinon selon le prix
-- (Config.House.RebirthGates : les objets chers arrivent plus tard).
function Formulas.GetHouseRequiredRebirths(entry): number
	if type(entry) ~= "table" then
		return 0
	end
	if type(entry.RequiresRebirths) == "number" then
		return entry.RequiresRebirths
	end
	local cost = tonumber(entry.Cost) or 0
	local required = 0
	for _, gate in ipairs(Config.House.RebirthGates) do
		if cost >= gate.Cost then
			required = math.max(required, gate.Rebirths)
		end
	end
	return required
end

function Formulas.IsHouseEntryUnlocked(data, entry): boolean
	local rebirths = type(data) == "table" and tonumber(data.Rebirths) or 0
	return Formulas.GetHouseRequiredRebirths(entry) <= (rebirths or 0)
end

-- Prix de la PROCHAINE pièce quand on en a déjà `roomCount`
function Formulas.GetRoomCost(roomCount: number?): number
	local count = math.max(1, math.floor(tonumber(roomCount) or 1))
	local house = Config.House
	return math.floor(house.RoomCost * (house.RoomCostGrowth ^ (count - 1)))
end

-- Confort total = somme des Comfort des objets POSÉS dans toutes les pièces
-- (x (1 + HarmonyBonus) pour les objets préférés de leur pièce). On ne compte
-- que les objets connus, jamais plus d'exemplaires que possédés (toutes
-- pièces confondues), au plus RoomItems objets par pièce et MaxRooms pièces :
-- une sauvegarde abîmée ne donne rien de plus.
function Formulas.GetHouseComfort(data): number
	local house = type(data) == "table" and data.House or nil
	if type(house) ~= "table" then
		return 0
	end
	local owned = type(house.Items) == "table" and house.Items or {}
	local size = Formulas.GetHouseSize(data)
	local perRoom = size.RoomItems
	local used = {}
	local total = 0
	for roomIndex, room in ipairs(Formulas.GetHouseRooms(house)) do
		if roomIndex > size.MaxRooms then
			break
		end
		if type(room) == "table" and type(room.Placed) == "table" then
			local roomType = Formulas.GetRoomType(room.Type)
			local count = 0
			for _, entry in ipairs(room.Placed) do
				if count >= perRoom then
					break
				end
				local id = type(entry) == "table" and entry.I or nil
				local item = type(id) == "string" and Config.HouseItemsById[id] or nil
				if item then
					local n = (used[id] or 0) + 1
					local have = tonumber(owned[id]) or 0
					if n <= have then
						used[id] = n
						count += 1
						total += Formulas.GetPlacedComfort(roomType, item)
					end
				end
			end
		end
	end
	return total
end

-- Multiplicateur de gains du confort, à rendements décroissants :
-- 1 + Max x c / (c + Max / ParPoint). Les premiers points valent
-- ComfortBonusPerPoint chacun, puis de moins en moins ; on approche
-- MaxComfortBonus sans jamais l'atteindre (moitié du max à Max / ParPoint
-- points de confort).
function Formulas.GetHouseBonus(comfort: number?): number
	local points = tonumber(comfort) or 0
	if points ~= points or points < 0 then
		points = 0
	end
	points = math.min(points, 1e12)
	local house = Config.House
	local max = house.MaxComfortBonus
	local perPoint = house.ComfortBonusPerPoint
	if max <= 0 or perPoint <= 0 then
		return 1
	end
	local half = max / perPoint
	return 1 + max * points / (points + half)
end

return Formulas
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="259">
        <Properties>
          <string name="Name">FriendMailRules</string>
          <string name="Source"><![CDATA[--[[
	FriendMailRules (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > FriendMailRules

	Règles PURES (sans service Roblox) des mails entre amis Roblox
	(FriendMailService côté serveur, Dopamail côté client) : limites,
	anti-spam, nettoyage du texte, tri et élagage de la boîte de réception
	stockée (DataStore "FriendMail_v1"). Testées par tests/run_tests.py.

	Enregistrement stocké (côté serveur UNIQUEMENT, jamais envoyé tel quel) :
	  { Id = "guid", F = expéditeur (UserId), N = pseudo, D = nom affiché,
	    S = objet BRUT, B = texte BRUT, T = os.time() d'envoi,
	    BS / BB = objet / texte filtrés "pour tout le monde" à l'envoi
	    (GetNonChatStringForBroadcastAsync, le plus strict : secours si le
	    filtre par destinataire échoue à la livraison),
	    R = Id du mail auquel il répond (ou nil), Rd = lu, Rp = déjà répondu }
]]

local FriendMailRules = {}

FriendMailRules.NewInterval = 600 -- 1 nouveau mail toutes les 10 minutes
FriendMailRules.ReplyInterval = 120 -- 1 réponse (à un mail d'ami reçu) toutes les 2 minutes
FriendMailRules.SubjectMax = 60
FriendMailRules.BodyMax = 300
FriendMailRules.InboxMax = 30 -- mails gardés par destinataire
FriendMailRules.MaxAge = 30 * 86400 -- plus vieux que 30 jours : oubliés
FriendMailRules.BlockMax = 200 -- expéditeurs bloqués gardés
FriendMailRules.ClockSkew = 300 -- tolérance d'horloge entre serveurs (secondes)

local function isNumber(value): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

-- Secondes à attendre avant de pouvoir envoyer (0 = tout de suite).
-- `last` abîmé (pas un nombre, négatif) = jamais envoyé ; `last` dans le
-- futur (horloge d'un autre serveur en avance) = compté comme "maintenant".
function FriendMailRules.Remaining(last: any, interval: number, now: number): number
	if not isNumber(last) or last <= 0 then
		return 0
	end
	local from = math.min(last, now)
	return math.max(0, math.ceil(from + interval - now))
end

-- Anti-spam : (autorisé, secondes restantes). `state` = data.FriendMail
function FriendMailRules.Check(state: any, now: number, isReply: boolean): (boolean, number)
	local last = type(state) == "table" and (isReply and state.LastReply or state.LastNew) or 0
	local interval = isReply and FriendMailRules.ReplyInterval or FriendMailRules.NewInterval
	local remaining = FriendMailRules.Remaining(last, interval, now)
	return remaining <= 0, remaining
end

-- "7:32" / "1:02:03" (compte à rebours affiché au joueur)
function FriendMailRules.Countdown(seconds: number): string
	local total = math.max(0, math.ceil(isNumber(seconds) and seconds or 0))
	local hours = math.floor(total / 3600)
	local minutes = math.floor((total % 3600) / 60)
	local secs = total % 60
	if hours > 0 then
		return string.format("%s:%02d:%02d", tostring(hours), minutes, secs)
	end
	return string.format("%s:%02d", tostring(minutes), secs)
end

-- Nettoie un texte tapé : caractères de contrôle -> espace, espaces réduits,
-- coupé à `maxChars` caractères (UTF-8). UTF-8 invalide -> "".
function FriendMailRules.Clean(text: any, maxChars: number): string
	if type(text) ~= "string" then
		return ""
	end
	if #text > maxChars * 8 then
		text = string.sub(text, 1, maxChars * 8)
	end
	text = string.gsub(text, "%c", " ")
	text = string.gsub(text, "%s+", " ")
	text = string.gsub(text, "^%s+", "")
	text = string.gsub(text, "%s+$", "")
	local length = utf8.len(text)
	if length == nil then
		-- (une coupe brute a pu casser un caractère : on retire la fin abîmée)
		for cut = #text, math.max(1, #text - 3), -1 do
			local candidate = string.sub(text, 1, cut - 1)
			if utf8.len(candidate) ~= nil then
				text = candidate
				length = utf8.len(candidate)
				break
			end
		end
		if length == nil then
			return ""
		end
	end
	if (length :: number) > maxChars then
		local cut = utf8.offset(text, maxChars + 1)
		if cut then
			text = string.gsub(string.sub(text, 1, cut - 1), "%s+$", "")
		end
	end
	return text
end

-- UserId valide (entier > 0)
function FriendMailRules.ValidUserId(value: any): boolean
	return isNumber(value) and value > 0 and value == math.floor(value) and value < 2 ^ 53
end

-- Un enregistrement de boîte de réception bien formé ?
function FriendMailRules.ValidRecord(record: any): boolean
	return type(record) == "table"
		and type(record.Id) == "string" and #record.Id > 0 and #record.Id <= 64
		and FriendMailRules.ValidUserId(record.F)
		and type(record.S) == "string" and type(record.B) == "string"
		and isNumber(record.T)
end

-- Texte à montrer au destinataire : filtré POUR lui si possible, sinon la
-- version filtrée "pour tout le monde" faite à l'envoi ; sinon rien (nil =
-- pas montré). JAMAIS le texte brut.
function FriendMailRules.ShownText(forRecipient: any, broadcast: any): string?
	if type(forRecipient) == "string" then
		return forRecipient
	end
	if type(broadcast) == "string" then
		return broadcast
	end
	return nil
end

-- Lecture prudente d'un ami (FriendPages, GetFriendsOnlineAsync) : les noms
-- de champs varient selon l'API -> (UserId, pseudo, nom affiché) ou nil
function FriendMailRules.ReadFriend(item: any): (number?, string, string)
	if type(item) ~= "table" then
		return nil, "", ""
	end
	local id = nil
	for _, key in ipairs({ "VisitorId", "Id", "UserId" }) do
		local value = tonumber(item[key])
		if value and FriendMailRules.ValidUserId(value) then
			id = value
			break
		end
	end
	local name = ""
	for _, key in ipairs({ "Username", "UserName", "Name" }) do
		if type(item[key]) == "string" and item[key] ~= "" then
			name = item[key]
			break
		end
	end
	local display = (type(item.DisplayName) == "string" and item.DisplayName ~= "") and item.DisplayName or name
	if name == "" then
		name = display
	end
	return id, name, display
end

-- Boîte stockée -> liste propre : enregistrements invalides, doublons et
-- mails de plus de 30 jours retirés, du plus récent au plus ancien, 30 max.
function FriendMailRules.TrimInbox(list: any, now: number): { any }
	local kept = {}
	if type(list) ~= "table" then
		return kept
	end
	local seen = {}
	for _, record in ipairs(list) do
		if FriendMailRules.ValidRecord(record) and not seen[record.Id] then
			local age = now - record.T
			if age <= FriendMailRules.MaxAge and age >= -FriendMailRules.ClockSkew then
				seen[record.Id] = true
				table.insert(kept, record)
			end
		end
	end
	table.sort(kept, function(a, b)
		if a.T ~= b.T then
			return a.T > b.T
		end
		return a.Id < b.Id
	end)
	for index = #kept, FriendMailRules.InboxMax + 1, -1 do
		kept[index] = nil
	end
	return kept
end

-- Ajoute un mail (sans doublon) puis élague
function FriendMailRules.Append(list: any, record: any, now: number): { any }
	local merged = {}
	if type(list) == "table" then
		for _, existing in ipairs(list) do
			table.insert(merged, existing)
		end
	end
	table.insert(merged, record)
	return FriendMailRules.TrimInbox(merged, now)
end

-- Applique les changements du destinataire (en attente d'écriture) :
-- ops = { Delete = { [id] = true }, Read = { [id] = true },
--   Replied = { [id] = true }, Blocked = { ["userId"] = true } }
function FriendMailRules.ApplyOps(list: any, ops: any, now: number): { any }
	local result = {}
	local delete = type(ops) == "table" and ops.Delete or {}
	local read = type(ops) == "table" and ops.Read or {}
	local replied = type(ops) == "table" and ops.Replied or {}
	local blocked = type(ops) == "table" and ops.Blocked or {}
	for _, record in ipairs(FriendMailRules.TrimInbox(list, now)) do
		if not delete[record.Id] and not blocked[tostring(record.F)] then
			if read[record.Id] then
				record.Rd = true
			end
			if replied[record.Id] then
				record.Rp = true
			end
			table.insert(result, record)
		end
	end
	return result
end

-- Répare data.FriendMail (sauvegarde abîmée) : horodatages valides et pas
-- dans le futur, liste de blocage = { ["UserId"] = true } (200 max)
function FriendMailRules.SanitizeData(state: any, now: number): { [string]: any }
	local clean = { LastNew = 0, LastReply = 0, Blocked = {} }
	if type(state) ~= "table" then
		return clean
	end
	for _, key in ipairs({ "LastNew", "LastReply" }) do
		local value = state[key]
		if isNumber(value) and value > 0 then
			clean[key] = math.floor(math.min(value, now))
		end
	end
	local count = 0
	if type(state.Blocked) == "table" then
		for key, value in pairs(state.Blocked) do
			local id = tonumber(key)
			if value == true and id and FriendMailRules.ValidUserId(id) and count < FriendMailRules.BlockMax then
				clean.Blocked[tostring(id)] = true
				count += 1
			end
		end
	end
	return clean
end

return FriendMailRules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="260">
        <Properties>
          <string name="Name">GarageLayout</string>
          <string name="Source"><![CDATA[--[[
	GarageLayout (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > GarageLayout

	🏎️ Géométrie du garage du manoir (v9.6, GARAGE96), partagée par le client
	(HouseFacade : l'aile ; CarClient : porte, voitures garées) et le serveur
	(CarService : sortie de la voiture). Fonctions PURES (aucun service).

	Repère LOCAL de la maison (WorldLayout) : x vers la droite du visiteur qui
	arrive de la rue, y vers le haut (0 = sol de la parcelle), d = profondeur
	depuis la façade (d < 0 = jardin de devant, vers la rue).
	Le manoir + ses tours occupent 174,8 des 176 studs de la parcelle et le
	jardin de derrière est le Jardin de Dopamine 3D : le garage est donc une
	AILE DANS LA COUR DE DEVANT, côté droit (vu de la rue), devant la 4e
	colonne de pièces, sans toucher la tour de droite :
	  x 46..76, d -23,5..-6 (3 places côte à côte, portes vers la rue),
	  allée pavée jusqu'au bord de la rue (d -23,5..-30).
]]

local GarageLayout = {}

GarageLayout.X0 = 46
GarageLayout.X1 = 76
GarageLayout.D0 = -23.5 -- façade du garage (portes, côté rue)
GarageLayout.D1 = -6 -- mur du fond (devant la maison)
GarageLayout.WALL = 0.8
GarageLayout.FLOOR = 0.7 -- dessus de la dalle (pelouse de la parcelle ≈ 0,45)
GarageLayout.HEIGHT = 10 -- haut des murs (au-dessus de y = 0)
GarageLayout.DOOR_W = 7.6
GarageLayout.DOOR_H = 7.4
GarageLayout.BAYS = 3
GarageLayout.STREET_D = -30 -- bord de la parcelle côté rue (WorldLayout.GARDEN_D)
GarageLayout.OPEN_RANGE = 26 -- la porte s'ouvre quand SA voiture arrive à moins de...

-- Le style de maison a-t-il un garage ? (seulement le manoir)
function GarageLayout.Supports(size: any): boolean
	if type(size) ~= "table" then
		return false
	end
	return size.Exterior == "Mansion" or size.Id == "Mansion"
end

-- Centre (x) de la place `bay` (1..BAYS, de gauche à droite vu de la rue)
function GarageLayout.BayX(bay: number): number
	local inner0 = GarageLayout.X0 + GarageLayout.WALL
	local inner1 = GarageLayout.X1 - GarageLayout.WALL
	local w = (inner1 - inner0) / GarageLayout.BAYS
	local b = math.clamp(math.floor(tonumber(bay) or 1), 1, GarageLayout.BAYS)
	return inner0 + (b - 0.5) * w
end

-- Milieu (d) d'une voiture garée (entre la porte et le mur du fond)
function GarageLayout.BayD(): number
	return (GarageLayout.D0 + GarageLayout.WALL + GarageLayout.D1 - GarageLayout.WALL) / 2
end

-- Profondeur utile (d) : la plus longue voiture (limousine 15,2) y tient
function GarageLayout.InnerDepth(): number
	return (GarageLayout.D1 - GarageLayout.WALL) - (GarageLayout.D0 + GarageLayout.WALL)
end

-- Pivot (CFrame monde) d'une voiture garée : au sol de la dalle, AVANT vers la rue
function GarageLayout.BayCFrame(houseCF: CFrame, bay: number): CFrame
	local x = GarageLayout.BayX(bay)
	local d = GarageLayout.BayD()
	local p = houseCF * Vector3.new(x, GarageLayout.FLOOR, -d)
	-- (avant de la voiture = -Z du modèle = vers la rue = -LookVector de la maison)
	return CFrame.lookAt(p, p - houseCF.LookVector)
end

-- Porte `bay` : centre du bas de l'ouverture (d = façade)
function GarageLayout.DoorPoint(houseCF: CFrame, bay: number): Vector3
	return houseCF * Vector3.new(GarageLayout.BayX(bay), GarageLayout.FLOOR, -GarageLayout.D0)
end

-- Centre du garage (monde), pour les distances
function GarageLayout.Center(houseCF: CFrame): Vector3
	local x = (GarageLayout.X0 + GarageLayout.X1) / 2
	local d = (GarageLayout.D0 + GarageLayout.D1) / 2
	return houseCF * Vector3.new(x, 3, -d)
end

-- Point local (x, y, d) dans le garage ? (marge en studs)
function GarageLayout.Inside(x: number, y: number, d: number, margin: number?): boolean
	local m = margin or 0
	return x >= GarageLayout.X0 - m and x <= GarageLayout.X1 + m and d >= GarageLayout.D0 - m and d <= GarageLayout.D1 + m and y >= -2 and y <= GarageLayout.HEIGHT + 3
end

-- Place d'une voiture possédée (ordre d'affichage : la voiture choisie au
-- milieu, puis les autres dans l'ordre du catalogue) -> { [carId] = bay }
function GarageLayout.Assign(owned: { string }, selected: string?): { [string]: number }
	local order = { 2, 1, 3 }
	local out: { [string]: number } = {}
	local list: { string } = {}
	if type(selected) == "string" and table.find(owned, selected) then
		table.insert(list, selected)
	end
	for _, id in ipairs(owned) do
		if id ~= selected then
			table.insert(list, id)
		end
	end
	for index, id in ipairs(list) do
		local bay = order[index]
		if not bay then
			break
		end
		out[id] = bay
	end
	return out
end

return GarageLayout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="261">
        <Properties>
          <string name="Name">GardenSnapshot</string>
          <string name="Source"><![CDATA[--[[
	GardenSnapshot (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > GardenSnapshot

	🌻 Résumé du Jardin de Dopamine d'un joueur, pour l'instantané de la
	ville (WorldService -> clients -> GardenBuilder). Fonction PURE :
	  - accepte les données du serveur (data) OU l'état du client
	    (ClientState.Data : mêmes champs Upgrades / Garden / House) ;
	  - ne lève jamais d'erreur (sauvegarde abîmée : valeurs ignorées) ;
	  - sûr pour le JSON et les RemoteEvents : clés texte, tableaux denses,
	    nombres finis, aucune Instance / aucun Color3 ;
	  - PETIT et STABLE : pas d'heure "Now" dedans (sinon la signature JSON de
	    WorldService changerait à chaque vérification) ; le client prend
	    l'heure du serveur avec workspace:GetServerTimeNow().

	GardenSnapshot.From(data) -> {
		Unlocked = bool,         -- Feature "Garden" possédée
		Count = n,               -- parterres possédés (BasePlots + "Flower Beds")
		Max = n,                 -- parterres possibles au maximum
		Windmill = bool,         -- moulin (Feature "Pinwheel") : déco du jardin
		Plots = { { Flower = "Daisy", PlantedAt = t, ReadyAt = t }, ... },
		-- v9.8 (GARDEN98) jardin aménagé librement :
		Level = 0..3,            -- agrandissements (Config.Garden.Expansion)
		Size = "Studio",         -- taille de la maison (zones du jardin)
		Decor = { id, ... },     -- déco du jardin sortie (data.House.Garden)
		Layout = { [clé] = { X, D, R } }, -- places choisies (repère de la maison)
	}
	GardenSnapshot.Sanitize(snapshot) -> même forme, validée (côté client :
	un instantané venu du réseau n'est jamais cru sur parole).
	GardenSnapshot.Progress(plot, now) -> (progress 0..1, prêt ?, secondes restantes)
	GardenSnapshot.Stage(plot, now) -> "Seed" | "Sprout" | "Bud" | "Bloom" | "Ready"

	v9.8 (GARDEN98) — règles PARTAGÉES du jardin libre (client, serveur, tests) :
	  Repère = celui de la maison (WorldLayout) : x vers la droite du visiteur
	  qui regarde la maison depuis la rue, d = profondeur depuis la façade
	  (d < 0 : jardin de devant, d > profondeur de la maison : jardin de
	  derrière). R = rotation en degrés (multiple de 15) ; R = 0 : l'objet
	  regarde la rue.
	  Clés des objets du jardin :
	    "B<i>"          parterre de Dopamine n° i (toujours posé)
	    "D:<id>"        déco du jardin (Config.House.GardenDecor) sortie
	    "P:<id>:<n>"    n-ième exemplaire d'un objet de jardin (Config.Garden.Pieces)
	    "F:<id>"        aménagement fixe : panneau, allées, lanternes, moulin,
	                    buissons, arrosoir, et les bonus des agrandissements
	  GardenSnapshot.Level(data) / LevelInfo(level) / DecorSlots(level) / PieceCap(level)
	  GardenSnapshot.OwnedPieces(data) -> { [id] = n }
	  GardenSnapshot.Footprint(key) -> (largeur, profondeur, plat ?)
	  GardenSnapshot.Zones(level, sizeId) -> { { X0, X1, D0, D1 } } ; Corridors(sizeId)
	  GardenSnapshot.Fits(level, sizeId, key, x, d, r) -> bool
	  GardenSnapshot.CleanLayout(raw, ctx) -> { [clé] = { X, D, R } } (tout vérifié)
	  GardenSnapshot.Fixtures(level, windmill) -> { "F:..." }
	  GardenSnapshot.Arrange(snapshot) -> { { Key, X, D, R, W, Dp, Flat, Moved } }
	      (tout ce qui est affiché, places par défaut comprises : même calcul
	      sur tous les clients -> tout le monde voit le même jardin)
]]

local Config = require(script.Parent.Config)

local GardenSnapshot = {}

GardenSnapshot.MAX_PLOTS = 24 -- même garde-fou que GardenService
GardenSnapshot.STAGES = { "Seed", "Sprout", "Bud", "Bloom", "Ready" }

local settings = Config.Garden or {}
local flowersById: { [string]: any } = {}
for _, flower in ipairs(settings.Flowers or {}) do
	flowersById[flower.Id] = flower
end
GardenSnapshot.FlowersById = flowersById

-- (WorldLayout facultatif : absent dans certains tests -> calcul de secours)
local WorldLayout: any = nil
pcall(function()
	local parent: any = script.Parent
	local module = parent.WorldLayout
	if module ~= nil then
		local loaded = require(module)
		if type(loaded) == "table" and type(loaded.Dims) == "function" then
			WorldLayout = loaded
		end
	end
end)

local function finite(value: any): number?
	if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
		return nil
	end
	return value
end

-- Niveau d'une amélioration (données éventuellement incomplètes)
local function levelOf(data: any, upgradeId: string?): number
	if not upgradeId or type(data) ~= "table" or type(data.Upgrades) ~= "table" then
		return 0
	end
	return math.max(0, math.floor(finite(data.Upgrades[upgradeId]) or 0))
end

-- Amélioration qui porte une Feature (Config.FeatureToUpgrade, sinon on cherche)
local function upgradeFor(feature: string): string?
	local map = Config.FeatureToUpgrade
	if type(map) == "table" and type(map[feature]) == "string" then
		return map[feature]
	end
	for _, upgrade in ipairs(Config.Upgrades or {}) do
		if upgrade.Feature == feature then
			return upgrade.Id
		end
	end
	return nil
end

-- Moulin (Feature "Pinwheel") possédé ?
function GardenSnapshot.HasWindmill(data: any): boolean
	return levelOf(data, upgradeFor("Pinwheel")) > 0
end

-- Nombre maximum de parterres (tous les niveaux de "Flower Beds" achetés)
function GardenSnapshot.MaxPlots(): number
	local count = settings.BasePlots or 3
	for _, upgrade in ipairs(Config.Upgrades or {}) do
		if upgrade.Feature == "GardenPlots" then
			count += math.max(0, math.floor(finite(upgrade.MaxLevel) or 0))
		end
	end
	return math.clamp(count, 1, GardenSnapshot.MAX_PLOTS)
end

-- Nombre de parterres possédés (même règle que Formulas.GetGardenPlotCount)
function GardenSnapshot.PlotCount(data: any): number
	local count = settings.BasePlots or 3
	for _, upgrade in ipairs(Config.Upgrades or {}) do
		if upgrade.Feature == "GardenPlots" then
			count += levelOf(data, upgrade.Id)
		end
	end
	return math.clamp(math.floor(count), 1, GardenSnapshot.MAX_PLOTS)
end

-- Un parterre valide (copie propre) ou nil (parterre vide / abîmé)
local function cleanPlot(plot: any): { Flower: string, PlantedAt: number, ReadyAt: number }?
	if type(plot) ~= "table" or type(plot.Flower) ~= "string" or not flowersById[plot.Flower] then
		return nil
	end
	local plantedAt, readyAt = finite(plot.PlantedAt), finite(plot.ReadyAt)
	if not plantedAt or not readyAt then
		return nil
	end
	plantedAt, readyAt = math.floor(plantedAt), math.floor(readyAt)
	if readyAt < plantedAt then
		readyAt = plantedAt
	end
	return { Flower = plot.Flower, PlantedAt = plantedAt, ReadyAt = readyAt }
end

local function emptyPlot(): any
	-- (JSON : un tableau dense ne peut pas contenir nil -> "vide" = Flower "")
	return { Flower = "", PlantedAt = 0, ReadyAt = 0 }
end

----------------------------------------------------------------------
-- v9.8 (GARDEN98) : agrandissements, objets de jardin
----------------------------------------------------------------------

local EXPANSION: { any } = settings.Expansion or {}
GardenSnapshot.MAX_LEVEL = #EXPANSION
local piecesById: { [string]: any } = {}
for _, piece in ipairs(settings.Pieces or {}) do
	piecesById[piece.Id] = piece
end
GardenSnapshot.PiecesById = piecesById
GardenSnapshot.MAX_ENTRIES = 128 -- garde-fou (taille de la sauvegarde / du réseau)
GardenSnapshot.ROTATION_STEP = 15
GardenSnapshot.GRID = 0.5 -- (studs) aimant de la grille du mode édition

local function baseDecorSlots(): number
	local house: any = Config.House
	return math.max(1, math.floor(finite(house and house.GardenSlots) or 6))
end

-- Niveau du jardin 0..MAX_LEVEL (data.Garden.Level, ou un nombre)
function GardenSnapshot.Level(data: any): number
	local value: any = data
	if type(data) == "table" then
		local garden = data.Garden
		value = type(garden) == "table" and garden.Level or 0
	end
	return math.clamp(math.floor(finite(value) or 0), 0, GardenSnapshot.MAX_LEVEL)
end

-- Entrée de Config.Garden.Expansion pour un niveau (nil au niveau 0)
function GardenSnapshot.LevelInfo(level: number): any?
	return EXPANSION[math.floor(finite(level) or 0)]
end

-- Places de déco du jardin (data.House.Garden) à ce niveau
function GardenSnapshot.DecorSlots(level: number): number
	local info = GardenSnapshot.LevelInfo(level)
	return math.max(baseDecorSlots(), info and math.floor(finite(info.DecorSlots) or 0) or 0)
end

-- Objets de jardin POSÉS au plus à ce niveau
function GardenSnapshot.PieceCap(level: number): number
	local info = GardenSnapshot.LevelInfo(level)
	local base = math.floor(finite(settings.BasePieces) or 8)
	return math.max(base, info and math.floor(finite(info.Pieces) or 0) or 0)
end

-- Prix du prochain exemplaire d'un objet de jardin (+15 % par exemplaire possédé)
function GardenSnapshot.PieceCost(piece: any, owned: number?): number
	local base = type(piece) == "table" and finite(piece.Cost) or nil
	if not base or base < 0 then
		return math.huge
	end
	local n = math.max(0, math.floor(finite(owned) or 0))
	return math.floor(base * 1.15 ^ n + 0.5)
end

-- Objets de jardin possédés (data.Garden.Pieces), nettoyés : entiers 1..Max
function GardenSnapshot.OwnedPieces(data: any): { [string]: number }
	local owned = {}
	local garden = type(data) == "table" and data.Garden
	local source = type(garden) == "table" and garden.Pieces
	if type(source) ~= "table" then
		return owned
	end
	for id, count in pairs(source) do
		local piece = type(id) == "string" and piecesById[id] or nil
		local n = finite(count)
		if piece and n and n >= 1 then
			owned[id] = math.min(math.floor(n), math.floor(finite(piece.Max) or 10))
		end
	end
	return owned
end

-- Empreintes (studs) : déco du jardin (dessins de HouseGarden), aménagements
local DECOR_SIZE: { [string]: { number } } = {
	TulipBed = { 4.6, 2.4 }, GardenGnome = { 1.6, 1.6 }, PinkFlamingo = { 1.8, 1.6 }, Birdbath = { 2.8, 2.8 },
	Beehive = { 2.4, 2.4 }, DuckPond = { 5.6, 5.6 }, PumpkinPatch = { 4.4, 2.4 }, Snowman = { 2.2, 2.2 },
	WishingWell = { 4.6, 3.2 }, Trampoline = { 5.6, 5.6 }, RainbowArch = { 6.4, 2 }, UnicornStatue = { 3.2, 2.4 },
	YardHoop = { 3, 3.6 }, CampTent = { 4.8, 4.2 }, BBQGrill = { 2.2, 2.2 }, YardGoal = { 5.4, 3.8 },
	SkateRamp = { 4.2, 4.8 }, Treehouse = { 5.8, 5.8 }, DinoStatue = { 6.6, 3.2 },
}
local FIXTURE_SIZE: { [string]: { any } } = {
	Sign = { 6.4, 1.6 }, Windmill = { 3.4, 3.4 }, Lantern1 = { 1.2, 1.2 }, Lantern2 = { 1.2, 1.2 },
	Path1 = { 20, 3.6, true }, Path2 = { 20, 3.6, true }, Can = { 1.6, 1.6 }, Bush1 = { 4, 3.2 }, Bush2 = { 4, 3.2 },
	RoseArch = { 5.6, 2.2 }, Greenhouse = { 10.2, 7.2 }, KoiPond = { 9.2, 6.2 },
}
GardenSnapshot.BED_SIZE = { 6.6, 4 }

-- Découpe une clé : ("B", "3") / ("D", id) / ("P", id, n) / ("F", id) ; nil si invalide
function GardenSnapshot.Parse(key: any): (string?, string?, number?)
	if type(key) ~= "string" or #key > 48 then
		return nil, nil, nil
	end
	local bed = string.match(key, "^B(%d+)$")
	if bed then
		return "B", bed, tonumber(bed)
	end
	local kind, rest = string.match(key, "^([DPF]):(.+)$")
	if kind == "P" then
		local id, n = string.match(rest, "^([%w_]+):(%d+)$")
		if id and n then
			return "P", id, tonumber(n)
		end
		return nil, nil, nil
	elseif kind == "D" or kind == "F" then
		if string.match(rest, "^[%w_]+$") then
			return kind, rest, nil
		end
	end
	return nil, nil, nil
end

-- Empreinte (largeur x, profondeur d, plat ?) d'un objet du jardin
function GardenSnapshot.Footprint(key: string): (number, number, boolean)
	local kind, id = GardenSnapshot.Parse(key)
	if kind == "B" then
		return GardenSnapshot.BED_SIZE[1], GardenSnapshot.BED_SIZE[2], false
	elseif kind == "D" then
		local size = DECOR_SIZE[id :: string]
		if size then
			return size[1], size[2], false
		end
		return 4, 4, false
	elseif kind == "P" then
		local piece = piecesById[id :: string]
		if piece then
			return finite(piece.W) or 2, finite(piece.D) or 2, piece.Flat == true
		end
	elseif kind == "F" then
		local size = FIXTURE_SIZE[id :: string]
		if size then
			return size[1], size[2], size[3] == true
		end
	end
	return 2, 2, false
end

-- Aménagements présents (panneau, allées, lanternes... + bonus des niveaux)
function GardenSnapshot.Fixtures(level: number, windmill: boolean?): { string }
	local list = { "F:Sign", "F:Path1", "F:Path2", "F:Lantern1", "F:Lantern2", "F:Can", "F:Bush1", "F:Bush2" }
	if windmill then
		table.insert(list, "F:Windmill")
	end
	for index = 1, math.clamp(math.floor(finite(level) or 0), 0, GardenSnapshot.MAX_LEVEL) do
		local bonus = EXPANSION[index] and EXPANSION[index].Bonus
		if type(bonus) == "string" and FIXTURE_SIZE[bonus] then
			table.insert(list, "F:" .. bonus)
		end
	end
	return list
end

----------------------------------------------------------------------
-- Zones du jardin (repère de la maison)
----------------------------------------------------------------------

local PLOT_HALF = 86.5 -- (studs) bord de la parcelle (176 / 2 - la haie)
local FRONT_STREET = -28.5 -- jardin de devant côté rue
local FRONT_FENCE = -20.2 -- ... côté intérieur de la clôture de devant
local FRONT_HOUSE = -1.2 -- ... devant la façade
local BACK_FENCE = 52 -- fond de la parcelle (clôture à 52,5)
local HOUSE_DEPTH = 26

local function sizeDef(sizeId: any): any
	local byId: any = Config.HouseSizesById
	return type(sizeId) == "string" and byId and byId[sizeId] or (Config.House and Config.House.Sizes and Config.House.Sizes[1]) or nil
end

-- Appel facultatif d'une fonction de WorldLayout (v9.8 : porte de derrière de HOUSE98)
local function layoutNumber(name: string, size: any): number?
	local fn = WorldLayout and WorldLayout[name]
	if type(fn) ~= "function" then
		return nil
	end
	local ok, value = pcall(fn, size)
	return ok and finite(value) or nil
end

-- (demi-largeur de la maison, profondeur, x de la porte, x de la porte de
-- derrière?, d de sa face?, d du pied de ses marches?) ; en cache par taille
local houseGeometryRaw: (sizeId: any) -> (number, number, number, number?, number?, number?)
local geometryCache: { [any]: { any } } = {}
local function houseGeometry(sizeId: any): (number, number, number, number?, number?, number?)
	local cached = geometryCache[sizeId or "?"]
	if cached then
		return cached[1], cached[2], cached[3], cached[4], cached[5], cached[6]
	end
	local a, b, c, d, e, f = houseGeometryRaw(sizeId)
	geometryCache[sizeId or "?"] = { a, b, c, d, e, f }
	return a, b, c, d, e, f
end
GardenSnapshot.HouseGeometry = houseGeometry

function houseGeometryRaw(sizeId: any): (number, number, number, number?, number?, number?)
	local size = sizeDef(sizeId)
	if WorldLayout then
		local ok, dims = pcall(WorldLayout.Dims, size)
		if ok and type(dims) == "table" then
			local backX = layoutNumber("BackDoorX", size)
			local backD = layoutNumber("BackDoorD", size)
			local stepsD = layoutNumber("BackStepsD", size)
			return dims.Width / 2, dims.Depth, layoutNumber("DoorX", size) or 0, backX, backD, stepsD
		end
	end
	-- secours (tests sans WorldLayout) : même formule que WorldLayout.Dims
	local columns = size and finite(size.Columns) or 2
	local widthFactor = size and finite(size.Width) or 1
	local roomW = math.floor(760 * widthFactor + 0.5) * 0.036
	return (12 + columns * (roomW + 2)) / 2, HOUSE_DEPTH, 0, nil, nil, nil
end

-- Rectangles où l'on peut poser (tout l'objet doit tenir dans l'un d'eux)
function GardenSnapshot.Zones(level: number, sizeId: any): { { number } }
	local half, depth = houseGeometry(sizeId)
	local lv = math.clamp(math.floor(finite(level) or 0), 0, GardenSnapshot.MAX_LEVEL)
	local back0 = depth + 2.2
	local zones = {}
	if lv == 0 then
		local w = math.min(PLOT_HALF, half + 3.8)
		table.insert(zones, { -w, w, FRONT_FENCE, FRONT_HOUSE })
		table.insert(zones, { -40, 40, back0, BACK_FENCE })
	elseif lv == 1 then
		table.insert(zones, { -PLOT_HALF, PLOT_HALF, FRONT_STREET, FRONT_HOUSE })
		table.insert(zones, { -62, 62, back0, BACK_FENCE })
	else
		table.insert(zones, { -PLOT_HALF, PLOT_HALF, FRONT_STREET, FRONT_HOUSE })
		table.insert(zones, { -PLOT_HALF, PLOT_HALF, back0, BACK_FENCE })
		-- côtés de la maison (petites maisons)
		local side0 = half + 1.5
		if side0 + 2 < PLOT_HALF then
			table.insert(zones, { side0, PLOT_HALF, FRONT_HOUSE - 0.5, back0 + 0.5 })
			table.insert(zones, { -PLOT_HALF, -side0, FRONT_HOUSE - 0.5, back0 + 0.5 })
		end
	end
	return zones
end

-- Couloirs toujours libres : allée de la porte d'entrée, sortie de derrière
-- (v9.8 HOUSE98 : portes de 6,5 de large ; derrière : DOOR_W / 2 + 1,5 de
-- chaque côté, de la façade arrière au pied des marches + 1,5)
function GardenSnapshot.Corridors(sizeId: any): { { number } }
	local _, depth, doorX, backX, backD, stepsD = houseGeometry(sizeId)
	local doorW = (WorldLayout and finite(WorldLayout.DOOR_W)) or 6.5
	local halfFront = doorW / 2 + 1
	local list = { { doorX - halfFront, doorX + halfFront, -31, 0.5 } }
	if backX then
		local half = doorW / 2 + 1.5
		table.insert(list, { backX - half, backX + half, (backD or depth) - 0.5, (stepsD or (depth + 7)) + 1.5 })
	end
	return list
end

-- Demi-empreinte (x, d) une fois tournée de r degrés
local function halfExtents(w: number, dp: number, r: number): (number, number)
	local a = math.rad(r)
	local c, s = math.abs(math.cos(a)), math.abs(math.sin(a))
	return (w * c + dp * s) / 2, (w * s + dp * c) / 2
end
GardenSnapshot.HalfExtents = halfExtents

-- Rotation valide (degrés, multiple de 15, 0..345)
function GardenSnapshot.Rotation(value: any): number
	local r = finite(value) or 0
	return (math.floor(r / GardenSnapshot.ROTATION_STEP + 0.5) * GardenSnapshot.ROTATION_STEP) % 360
end

-- L'objet `key` tient-il en (x, d, r) ? (zones du niveau, couloirs libres)
function GardenSnapshot.Fits(level: number, sizeId: any, key: string, x: number, d: number, r: number): boolean
	local fx, fd = finite(x), finite(d)
	if not fx or not fd then
		return false
	end
	local w, dp, flat = GardenSnapshot.Footprint(key)
	local hx, hd = halfExtents(w, dp, GardenSnapshot.Rotation(r))
	local inside = false
	for _, zone in ipairs(GardenSnapshot.Zones(level, sizeId)) do
		if fx - hx >= zone[1] - 0.01 and fx + hx <= zone[2] + 0.01 and fd - hd >= zone[3] - 0.01 and fd + hd <= zone[4] + 0.01 then
			inside = true
			break
		end
	end
	if not inside then
		return false
	end
	if not flat then
		for _, lane in ipairs(GardenSnapshot.Corridors(sizeId)) do
			if fx + hx > lane[1] and fx - hx < lane[2] and fd + hd > lane[3] and fd - hd < lane[4] then
				return false
			end
		end
	end
	return true
end

local function round(value: number, step: number): number
	return math.floor(value / step + 0.5) * step
end

-- Disposition reçue (client, sauvegarde, réseau) -> disposition sûre.
-- ctx = { Level, Size, Beds (nombre de parterres affichés), Decor = { [id] = true },
--         Pieces = { [id] = n } (nil : jusqu'au Max de l'objet), Windmill }
function GardenSnapshot.CleanLayout(raw: any, ctx: any): { [string]: any }
	local clean = {}
	if type(raw) ~= "table" or type(ctx) ~= "table" then
		return clean
	end
	local level = GardenSnapshot.Level(ctx.Level)
	local beds = math.clamp(math.floor(finite(ctx.Beds) or 0), 0, GardenSnapshot.MAX_PLOTS)
	local decor = type(ctx.Decor) == "table" and ctx.Decor or {}
	local owned = type(ctx.Pieces) == "table" and ctx.Pieces or nil
	local fixtures = {}
	for _, key in ipairs(GardenSnapshot.Fixtures(level, ctx.Windmill == true)) do
		fixtures[key] = true
	end
	-- (ordre stable : les clés triées -> même résultat partout)
	local keys = {}
	for key in pairs(raw) do
		if type(key) == "string" and #key <= 48 then
			table.insert(keys, key)
		end
		if #keys > GardenSnapshot.MAX_ENTRIES * 2 then
			break
		end
	end
	table.sort(keys)
	local count, pieces = 0, 0
	local cap = GardenSnapshot.PieceCap(level)
	for _, key in ipairs(keys) do
		if count >= GardenSnapshot.MAX_ENTRIES then
			break
		end
		local entry = raw[key]
		local kind, id, n = GardenSnapshot.Parse(key)
		local allowed = false
		if kind == "B" then
			allowed = n ~= nil and n >= 1 and n <= beds and key == "B" .. tostring(n)
		elseif kind == "D" then
			allowed = decor[id :: string] == true
		elseif kind == "P" then
			local piece = piecesById[id :: string]
			local limit = if owned then (owned[id :: string] or 0) else (piece and math.floor(finite(piece.Max) or 10) or 0)
			allowed = piece ~= nil and n ~= nil and n >= 1 and n <= limit and pieces < cap and key == "P:" .. id .. ":" .. tostring(n)
		elseif kind == "F" then
			allowed = fixtures[key] == true
		end
		if allowed and type(entry) == "table" then
			local x, d = finite(entry.X), finite(entry.D)
			local r = GardenSnapshot.Rotation(entry.R)
			if x and d then
				x, d = round(x, 0.05), round(d, 0.05)
				if GardenSnapshot.Fits(level, ctx.Size, key, x, d, r) then
					clean[key] = { X = x, D = d, R = r }
					count += 1
					if kind == "P" then
						pieces += 1
					end
				end
			end
		end
	end
	return clean
end

-- Déco sortie (data.House.Garden) : ids texte, sans doublon, places du niveau
local function decorOf(data: any, level: number): { string }
	local list = {}
	local house = type(data) == "table" and data.House
	local source = type(house) == "table" and house.Garden
	if type(source) ~= "table" then
		return list
	end
	local seen = {}
	local slots = GardenSnapshot.DecorSlots(level)
	for _, id in ipairs(source) do
		if #list >= slots then
			break
		end
		if type(id) == "string" and #id <= 64 and not seen[id] then
			seen[id] = true
			table.insert(list, id)
		end
	end
	return list
end

local function setOf(list: { string }): { [string]: boolean }
	local set = {}
	for _, id in ipairs(list) do
		set[id] = true
	end
	return set
end

-- Nombre de parterres affichés (et donc déplaçables) pour un instantané
local function bedsShown(unlocked: boolean, count: number): number
	if unlocked then
		return count
	end
	return math.max(1, settings.BasePlots or 3)
end

function GardenSnapshot.From(data: any): { [string]: any }
	local count = GardenSnapshot.PlotCount(data)
	local unlocked = levelOf(data, upgradeFor(settings.Feature or "Garden")) > 0
	local plots = {}
	local garden = type(data) == "table" and data.Garden
	local source = type(garden) == "table" and type(garden.Plots) == "table" and garden.Plots or nil
	if unlocked then
		for index = 1, count do
			plots[index] = (source and cleanPlot(source[index])) or emptyPlot()
		end
	end
	local windmill = levelOf(data, upgradeFor("Pinwheel")) > 0
	local level = GardenSnapshot.Level(data)
	local house = type(data) == "table" and data.House
	local sizeId = type(house) == "table" and type(house.Size) == "string" and house.Size or nil
	if sizeId and not sizeDef(sizeId) then
		sizeId = nil
	end
	local decor = decorOf(data, level)
	local layout = GardenSnapshot.CleanLayout(type(garden) == "table" and garden.Layout or nil, {
		Level = level,
		Size = sizeId,
		Beds = bedsShown(unlocked, count),
		Decor = setOf(decor),
		Pieces = GardenSnapshot.OwnedPieces(data),
		Windmill = windmill,
	})
	return {
		Unlocked = unlocked,
		Count = count,
		Max = math.max(count, GardenSnapshot.MaxPlots()),
		Windmill = windmill,
		Plots = plots,
		Level = level,
		Size = sizeId or (Config.House.Sizes[1] and Config.House.Sizes[1].Id) or "Studio",
		Decor = decor,
		Layout = layout,
	}
end

-- Instantané reçu du réseau -> forme garantie (nil / n'importe quoi accepté)
function GardenSnapshot.Sanitize(snapshot: any): { [string]: any }
	local defaultSize = (Config.House.Sizes[1] and Config.House.Sizes[1].Id) or "Studio"
	if type(snapshot) ~= "table" then
		return { Unlocked = false, Count = settings.BasePlots or 3, Max = GardenSnapshot.MaxPlots(), Windmill = false, Plots = {},
			Level = 0, Size = defaultSize, Decor = {}, Layout = {} }
	end
	local count = math.clamp(math.floor(finite(snapshot.Count) or (settings.BasePlots or 3)), 1, GardenSnapshot.MAX_PLOTS)
	local maxPlots = math.clamp(math.floor(finite(snapshot.Max) or count), count, GardenSnapshot.MAX_PLOTS)
	local unlocked = snapshot.Unlocked == true
	local plots = {}
	if unlocked then
		local source = type(snapshot.Plots) == "table" and snapshot.Plots or {}
		for index = 1, count do
			plots[index] = cleanPlot(source[index]) or emptyPlot()
		end
	end
	local level = GardenSnapshot.Level(snapshot.Level)
	local sizeId = type(snapshot.Size) == "string" and sizeDef(snapshot.Size) and snapshot.Size or defaultSize
	local decor = decorOf({ House = { Garden = snapshot.Decor } }, level)
	local windmill = snapshot.Windmill == true
	local layout = GardenSnapshot.CleanLayout(snapshot.Layout, {
		Level = level,
		Size = sizeId,
		Beds = bedsShown(unlocked, count),
		Decor = setOf(decor),
		Pieces = nil,
		Windmill = windmill,
	})
	return { Unlocked = unlocked, Count = count, Max = maxPlots, Windmill = windmill, Plots = plots,
		Level = level, Size = sizeId, Decor = decor, Layout = layout }
end

----------------------------------------------------------------------
-- Places par défaut (tout ce qui n'a pas été déplacé) : même calcul partout
----------------------------------------------------------------------

local BACK_CENTER = (HOUSE_DEPTH + 2.5 + BACK_FENCE + 0.5) / 2 -- 40,5 : milieu du jardin de derrière
GardenSnapshot.BACK_CENTER = BACK_CENTER
local BED_PITCH = 9.8

-- Parterres par défaut : 1 rangée jusqu'à 5, sinon 2 de part et d'autre de
-- l'allée (celle du côté de la maison tournée vers l'allée)
function GardenSnapshot.BedSlots(total: number): ({ { number } }, number, number, number)
	local rows = total <= 5 and 1 or 2
	local perRow = math.max(1, math.ceil(total / rows))
	-- (v9.8 : un stud plus loin que v9.5 -> la sortie de la porte de derrière reste libre)
	local rowD = rows == 1 and { BACK_CENTER + 1.6 } or { BACK_CENTER - 3.4, BACK_CENTER + 5.4 }
	local pathD = rows == 1 and BACK_CENTER - 2.8 or BACK_CENTER + 1
	local slots = {}
	local index = 0
	for row = 1, rows do
		local count = math.min(perRow, total - index)
		for k = 1, count do
			index += 1
			slots[index] = { (k - (count + 1) / 2) * BED_PITCH, rowD[row], (rows == 2 and row == 1) and 180 or 0 }
		end
	end
	local halfLength = perRow * BED_PITCH / 2
	local backD = rows == 1 and (BACK_CENTER + 5) or (BACK_CENTER + 8.2)
	return slots, pathD, halfLength, backD
end

-- Tout ce qui est affiché dans le jardin, avec sa place (choisie ou par défaut)
function GardenSnapshot.Arrange(snapshot: any): { any }
	local state = snapshot
	local list = {}
	local layout = type(state.Layout) == "table" and state.Layout or {}
	local level = GardenSnapshot.Level(state.Level)
	local half, _, doorX = houseGeometry(state.Size)
	local beds = bedsShown(state.Unlocked == true, math.floor(finite(state.Count) or 3))
	local ghost = state.Unlocked == true and (finite(state.Max) or 0) > beds
	local slots, pathD, halfLength, backD = GardenSnapshot.BedSlots(beds + (ghost and 1 or 0))
	local function add(key: string, x: number, d: number, r: number)
		local w, dp, flat = GardenSnapshot.Footprint(key)
		local chosen = layout[key]
		local moved = type(chosen) == "table"
		table.insert(list, {
			Key = key,
			X = moved and chosen.X or x,
			D = moved and chosen.D or d,
			R = moved and chosen.R or r,
			W = w,
			Dp = dp,
			Flat = flat,
			Moved = moved,
		})
	end
	for index = 1, beds do
		local slot = slots[index]
		add("B" .. index, slot[1], slot[2], slot[3])
	end
	if ghost then
		local slot = slots[beds + 1]
		add("G", slot[1], slot[2], slot[3])
	end
	-- aménagements (autour de l'allée des parterres)
	local fixed: { [string]: { number } } = {
		["F:Path1"] = { -10.1, pathD, 0 },
		["F:Path2"] = { 10.1, pathD, 0 },
		["F:Sign"] = { -(halfLength + 3.6), pathD - 3.1, 345 },
		["F:Lantern1"] = { -(halfLength + 1.2), pathD + 2.6, 0 },
		["F:Lantern2"] = { halfLength + 1.2, pathD + 2.6, 0 },
		["F:Can"] = { -(halfLength - 1.5), pathD - 1.6, 30 },
		["F:Bush1"] = { -(halfLength + 2.6), backD, 0 },
		["F:Bush2"] = { halfLength + 2.6, backD, 0 },
		["F:Windmill"] = { halfLength + 6.8, backD - 0.5, 0 },
		["F:RoseArch"] = { halfLength + 13, pathD, 90 },
		["F:Greenhouse"] = { -(halfLength + 18), BACK_CENTER + 2.4, 0 },
		["F:KoiPond"] = { halfLength + 22, BACK_CENTER + 2.4, 0 },
	}
	for _, key in ipairs(GardenSnapshot.Fixtures(level, state.Windmill == true)) do
		local spot = fixed[key]
		if spot then
			add(key, spot[1], spot[2], spot[3])
		end
	end
	-- déco du jardin sortie : devant la maison (6 par rangée, comme la 2D)
	local decor = type(state.Decor) == "table" and state.Decor or {}
	local perRow = baseDecorSlots()
	local x0 = -math.min(PLOT_HALF - 2, half + 4)
	local x1 = math.min(PLOT_HALF - 2, half + 4)
	local mansion = state.Size == "Mansion"
	if mansion then
		x1 = math.min(x1, 43) -- (v9.6 : place de l'aile du garage)
	end
	local margin = (x1 - x0) * 0.07
	local spacing = (x1 - x0 - margin * 2) / math.max(1, perRow)
	for index, id in ipairs(decor) do
		local row = math.floor((index - 1) / perRow)
		local column = (index - 1) % perRow + 1
		local x = x0 + margin + (column - 0.5) * spacing
		local clear = if mansion then 9 else 5
		if math.abs(x - doorX) < clear then
			x = doorX + (if x < doorX then -clear else clear)
		end
		add("D:" .. id, x, row == 0 and -15 or -8.8, 0)
	end
	-- objets de jardin posés (seulement ceux qui ont une place)
	local pieceKeys = {}
	for key in pairs(layout) do
		if string.sub(key, 1, 2) == "P:" then
			table.insert(pieceKeys, key)
		end
	end
	table.sort(pieceKeys)
	for _, key in ipairs(pieceKeys) do
		local entry = layout[key]
		add(key, entry.X, entry.D, entry.R)
	end
	return list
end

----------------------------------------------------------------------
-- Pousse des fleurs
----------------------------------------------------------------------

-- Avancement d'un parterre à l'heure `now` (heure du serveur)
function GardenSnapshot.Progress(plot: any, now: number): (number, boolean, number)
	if type(plot) ~= "table" or not flowersById[plot.Flower] then
		return 0, false, 0
	end
	local plantedAt = finite(plot.PlantedAt) or now
	local readyAt = finite(plot.ReadyAt) or now
	local total = math.max(1, readyAt - plantedAt)
	local remaining = math.max(0, readyAt - now)
	local ready = now >= readyAt
	return ready and 1 or math.clamp(1 - remaining / total, 0, 1), ready, remaining
end

-- Stade visible : graine -> pousse -> bouton -> fleur -> prête (scintille)
function GardenSnapshot.Stage(plot: any, now: number): string
	if type(plot) ~= "table" or not flowersById[plot.Flower] then
		return "Empty"
	end
	local progress, ready = GardenSnapshot.Progress(plot, now)
	if ready then
		return "Ready"
	elseif progress < 0.12 then
		return "Seed"
	elseif progress < 0.45 then
		return "Sprout"
	elseif progress < 0.8 then
		return "Bud"
	end
	return "Bloom"
end

return GardenSnapshot
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="262">
        <Properties>
          <string name="Name">GraphicsQuality</string>
          <string name="Source"><![CDATA[--[[
	GraphicsQuality (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > GraphicsQuality

	v9.8 (REALISM98) 🎨 réglages "Graphismes / Mode réaliste", partagés :
	  - SERVEUR : liste des clés et des valeurs acceptées par SetSetting
	    (GameService) : GraphicsQuality.IsValid(nom, valeur) ;
	  - CLIENT : qualité "résolue" (réglages sauvegardés + appareil) que tout
	    module peut lire : GraphicsQuality.Get() et le signal .Changed.

	Réglages sauvegardés (Data.Settings, chaînes, défaut "Auto") :
	  GfxRealistic   "Auto" | "On" | "Off"          (Auto = On sur ordinateur,
	                                                 Off sur mobile / petite config)
	  GfxReflections "Auto" | "Off" | "Mirrors" | "All"
	  GfxWeather     "Auto" | "On" | "Off"
	  GfxRain        "Auto" | "Low" | "Medium" | "High"
	  GfxShadows     "Auto" | "Low" | "High"
	  GfxEffects     "Auto" | "On" | "Off"          (bloom, rayons, flou lointain)
	  GfxDetail      "Auto" | "Low" | "Medium" | "High"
	  GfxTime        "Auto" | "Day" | "Sunset" | "Night"   (v9.9 REALISM99 : heure du
	                                                 jour en ville, pour CE joueur seulement ;
	                                                 Auto = l'heure de la ville, voir
	                                                 TownAtmosphere ; hors préréglages)
	"Auto" = la valeur du préréglage (Mode réaliste ON ou OFF). Activer /
	couper le Mode réaliste remet les réglages détaillés sur "Auto".

	Qualité résolue (GraphicsQuality.Get(), table en lecture seule) :
	  {
	    Realistic: boolean,
	    Reflections: "Off" | "Mirrors" | "All",
	    Weather: boolean, Rain: "Low" | "Medium" | "High", RainScale: number,
	    Shadows: "Low" | "High", Effects: boolean,
	    Detail: "Low" | "Medium" | "High",
	    DetailScale: number,   -- 0.65 / 1 / 1.35 : multiplie les distances de flux
	    MaxMirrors: number,    -- miroirs "vivants" en même temps (0, 1 ou 2)
	    TimeOfDay: "Auto" | "Day" | "Sunset" | "Night",
	    Phone: boolean, LowEnd: boolean,
	  }

	API :
	  GraphicsQuality.KEYS / .ORDER / .DEFAULT = "Auto"
	  GraphicsQuality.IsKey(nom) -> boolean
	  GraphicsQuality.IsValid(nom, valeur) -> boolean          (serveur + client)
	  GraphicsQuality.Resolve(saved, device) -> Quality          (pur, tests)
	  GraphicsQuality.Get() -> Quality
	  GraphicsQuality.Changed : Signal (Quality)
	  GraphicsQuality.DetailScale() -> number
	  GraphicsQuality.Distance(base) -> number                   (base * DetailScale)
	  GraphicsQuality.GetSaved(nom) -> string
	  GraphicsQuality.SetSaved(settings)      (client : état du serveur, Data.Settings)
	  GraphicsQuality.SetLocal(nom, valeur)   (client : choix du joueur, tout de suite)
	  GraphicsQuality.Device() -> { Phone: boolean, LowEnd: boolean }
	Pur côté serveur (aucun service client lu au chargement du module).
]]

local Signal = require(script.Parent.Signal)

local GraphicsQuality = {}

GraphicsQuality.DEFAULT = "Auto"

-- [clé] = valeurs acceptées (la 1re = "Auto")
GraphicsQuality.KEYS = {
	GfxRealistic = { "Auto", "On", "Off" },
	GfxReflections = { "Auto", "Off", "Mirrors", "All" },
	GfxWeather = { "Auto", "On", "Off" },
	GfxRain = { "Auto", "Low", "Medium", "High" },
	GfxShadows = { "Auto", "Low", "High" },
	GfxEffects = { "Auto", "On", "Off" },
	GfxDetail = { "Auto", "Low", "Medium", "High" },
	GfxTime = { "Auto", "Day", "Sunset", "Night" }, -- (v9.9) heure du jour, choix du joueur
}
GraphicsQuality.ORDER = { "GfxRealistic", "GfxReflections", "GfxWeather", "GfxRain", "GfxShadows", "GfxEffects", "GfxDetail", "GfxTime" }
-- (v9.9) clés qui ne sont PAS des niveaux de qualité : le préréglage
-- "Mode réaliste" ne les remet pas sur "Auto"
GraphicsQuality.NOT_PRESET = { GfxTime = true }

-- Préréglages : "Réaliste" (ordinateur) et "Standard" (= le rendu de la v9.7)
local PRESET_REAL = {
	GfxReflections = "All",
	GfxWeather = "On",
	GfxRain = "High",
	GfxShadows = "High",
	GfxEffects = "On",
	GfxDetail = "High",
}
local PRESET_STANDARD = {
	GfxReflections = "Off",
	GfxWeather = "On",
	GfxRain = "Medium",
	GfxShadows = "High",
	GfxEffects = "On",
	GfxDetail = "Medium",
}
-- (petite configuration : moins de pluie, pas d'effets, ombres simples)
local PRESET_LOW = {
	GfxReflections = "Off",
	GfxWeather = "On",
	GfxRain = "Low",
	GfxShadows = "Low",
	GfxEffects = "Off",
	GfxDetail = "Low",
}
GraphicsQuality.PRESETS = { Real = PRESET_REAL, Standard = PRESET_STANDARD, Low = PRESET_LOW }

local DETAIL_SCALE = { Low = 0.65, Medium = 1, High = 1.35 }
local RAIN_SCALE = { Low = 0.5, Medium = 1, High = 1.5 }
GraphicsQuality.DETAIL_SCALE = DETAIL_SCALE
GraphicsQuality.RAIN_SCALE = RAIN_SCALE

local VALID: { [string]: { [string]: boolean } } = {}
for key, values in pairs(GraphicsQuality.KEYS) do
	local set = {}
	for _, value in ipairs(values) do
		set[value] = true
	end
	VALID[key] = set
end

export type Quality = {
	Realistic: boolean,
	Reflections: string,
	Weather: boolean,
	Rain: string,
	RainScale: number,
	Shadows: string,
	Effects: boolean,
	Detail: string,
	DetailScale: number,
	MaxMirrors: number,
	TimeOfDay: string,
	Phone: boolean,
	LowEnd: boolean,
}
export type Device = { Phone: boolean, LowEnd: boolean }

function GraphicsQuality.IsKey(name: any): boolean
	return type(name) == "string" and VALID[name] ~= nil
end

-- Serveur (SetSetting) et client : la valeur est-elle acceptée pour cette clé ?
function GraphicsQuality.IsValid(name: any, value: any): boolean
	if type(name) ~= "string" or type(value) ~= "string" or #value > 16 then
		return false
	end
	local set = VALID[name]
	return set ~= nil and set[value] == true
end

-- Qualité finale d'après les réglages sauvegardés et l'appareil (fonction pure)
function GraphicsQuality.Resolve(saved: { [string]: any }?, device: Device?): Quality
	local s = type(saved) == "table" and saved or {}
	local dev = device or { Phone = false, LowEnd = false }
	local function read(key: string): string
		local value = s[key]
		if GraphicsQuality.IsValid(key, value) then
			return value
		end
		return GraphicsQuality.DEFAULT
	end
	local mode = read("GfxRealistic")
	local realistic
	if mode == "On" then
		realistic = true
	elseif mode == "Off" then
		realistic = false
	else
		realistic = not dev.Phone and not dev.LowEnd
	end
	local preset = realistic and PRESET_REAL or (dev.LowEnd and PRESET_LOW or PRESET_STANDARD)
	local function pick(key: string): string
		local value = read(key)
		if value == "Auto" then
			return preset[key]
		end
		return value
	end
	local reflections = pick("GfxReflections")
	local detail = pick("GfxDetail")
	local rain = pick("GfxRain")
	local maxMirrors = 0
	if reflections ~= "Off" then
		maxMirrors = (reflections == "All" and detail == "High") and 2 or 1
	end
	return {
		Realistic = realistic,
		Reflections = reflections,
		Weather = pick("GfxWeather") == "On",
		Rain = rain,
		RainScale = RAIN_SCALE[rain] or 1,
		Shadows = pick("GfxShadows"),
		Effects = pick("GfxEffects") == "On",
		Detail = detail,
		DetailScale = DETAIL_SCALE[detail] or 1,
		MaxMirrors = maxMirrors,
		TimeOfDay = read("GfxTime"),
		Phone = dev.Phone == true,
		LowEnd = dev.LowEnd == true,
	}
end

----------------------------------------------------------------------
-- Client : état courant
----------------------------------------------------------------------

GraphicsQuality.Changed = Signal.new() -- (quality)

local saved: { [string]: string } = {}
for _, key in ipairs(GraphicsQuality.ORDER) do
	saved[key] = GraphicsQuality.DEFAULT
end
local localUntil: { [string]: number } = {} -- choix local récent : l'état du serveur est ignoré un moment
local device: Device? = nil
local current: Quality? = nil
local LOCAL_HOLD = 6 -- (s)

-- Appareil (client) : écran tactile sans souris = mobile ; qualité graphique
-- Roblox réglée à la main très bas = petite configuration
function GraphicsQuality.Device(): Device
	local cached = device
	if cached then
		return cached
	end
	local phone, lowEnd = false, false
	pcall(function()
		local UserInputService = game:GetService("UserInputService")
		phone = UserInputService.TouchEnabled == true and UserInputService.MouseEnabled ~= true
	end)
	pcall(function()
		local settings = UserSettings():GetService("UserGameSettings")
		local level = (settings :: any).SavedQualityLevel
		if typeof(level) == "EnumItem" then
			local n = tonumber(string.match(level.Name, "(%d+)$"))
			lowEnd = n ~= nil and n <= 3
		end
	end)
	local result = { Phone = phone, LowEnd = lowEnd }
	device = result
	return result
end

local function same(a: Quality, b: Quality): boolean
	for key, value in pairs(a) do
		if (b :: any)[key] ~= value then
			return false
		end
	end
	return true
end

local function refresh()
	local quality = GraphicsQuality.Resolve(saved, GraphicsQuality.Device())
	local before = current
	current = table.freeze(quality) :: any
	if before == nil or not same(before, quality) then
		GraphicsQuality.Changed:Fire(current)
	end
end

function GraphicsQuality.Get(): Quality
	local q = current
	if q == nil then
		refresh()
		q = current
	end
	return q :: Quality
end

function GraphicsQuality.DetailScale(): number
	return GraphicsQuality.Get().DetailScale
end

-- Distance de flux adaptée au réglage "Détail" (ex. 120 studs -> 78 / 120 / 162)
function GraphicsQuality.Distance(base: number): number
	return base * GraphicsQuality.Get().DetailScale
end

function GraphicsQuality.GetSaved(name: string): string
	return saved[name] or GraphicsQuality.DEFAULT
end

-- État du serveur (Data.Settings) : appliqué sauf pour un choix local récent
function GraphicsQuality.SetSaved(settings: any)
	if type(settings) ~= "table" then
		return
	end
	local now = os.clock()
	local changed = false
	for _, key in ipairs(GraphicsQuality.ORDER) do
		local value = settings[key]
		if not GraphicsQuality.IsValid(key, value) then
			value = GraphicsQuality.DEFAULT
		end
		if (localUntil[key] or 0) < now and saved[key] ~= value then
			saved[key] = value
			changed = true
		end
	end
	if changed or current == nil then
		refresh()
	end
end

-- Choix du joueur : appliqué tout de suite (la sauvegarde est faite par l'appelant)
function GraphicsQuality.SetLocal(name: string, value: string): boolean
	if not GraphicsQuality.IsValid(name, value) then
		return false
	end
	localUntil[name] = os.clock() + LOCAL_HOLD
	if saved[name] ~= value then
		saved[name] = value
		refresh()
	end
	return true
end

-- (tests) oublie l'appareil détecté / impose un appareil
function GraphicsQuality.SetDevice(dev: Device?)
	device = dev
	refresh()
end

return GraphicsQuality
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="263">
        <Properties>
          <string name="Name">Greenery</string>
          <string name="Source"><![CDATA[--[[
	Greenery (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > Greenery

	🌳 Les arbres de Dopamine Town (v9.7, NATURE97), "réalistes stylisés",
	construits en pièces : utilisé par le SERVEUR (TownKit.Tree : les arbres
	de la ville) ET par le CLIENT (TownGreenery : détails "de près").
	Pur : que des Instances, aucun service.

	Chaque arbre = tronc (évasé au pied), 2 à 4 branches, feuillage en
	plusieurs grappes qui se chevauchent (boules / ovales = Part + SpecialMesh
	"Sphere") en 2-3 verts : silhouette irrégulière. Espèces :
	  Oak     : chêne rond, large ;
	  Maple   : érable d'automne (orange, rouge, jaune) ;
	  Cherry  : cerisier en fleurs (roses), en parasol, pétales au sol ;
	  Birch   : bouleau (tronc blanc à marques noires), feuillage clair ;
	  Fir     : sapin (étages de plus en plus petits + pointe) ;
	  Palm    : palmier (tronc courbé en anneaux, palmes, noix de coco) ;
	  Poplar  : peuplier (haut et fin) ;
	  Fruit   : pommier (petit, rond, pommes rouges / oranges) ;
	  Willow  : saule pleureur (dôme + rideaux qui tombent) ;
	  Round   : boule taillée (jardinières de la place).
	La taille, la rotation, les teintes et les grappes varient avec la
	graine (`seed`) : même arbre pour tout le monde, à chaque démarrage.

	NIVEAUX DE DÉTAIL (budget de pièces de la ville) :
	  0 : silhouette (tronc + 2-4 grappes) — ce qu'on voit de loin ;
	  1 : + branches, grappe du sommet, palmes... (arbres "vedettes") ;
	  2 : + évasement du pied, branche et petites grappes en plus, fruits,
	      marques du bouleau, noix de coco, pétales : ajouté par le CLIENT
	      (TownGreenery) seulement pour les arbres proches de l'avatar.
	Les pièces des niveaux 1-2 ne touchent jamais une face plane d'une
	pièce d'un autre niveau (pas de z-fighting) : grappes rondes, tiges
	cylindriques, anneaux aux hauteurs distinctes.

	API :
	  Greenery.SPECIES : { string } (ordre de la galerie)
	  Greenery.Species(kind, seed) -> string
	      kind : nom d'espèce, ou ancien numéro v9.4 (1 feuillu, 2 cerisier,
	      3 sapin, 4 boule taillée)
	  Greenery.Tree(parent, base, height, seed, species, maxTier, minTier?, opts?) -> (Model, number)
	      base = pied du tronc (sol) ; construit les niveaux minTier..maxTier ;
	      opts = { Lawn = bool (pétales / feuilles au sol permis), Name = string? }
	      Renvoie le modèle et son nombre de pièces. Attributs du modèle :
	      TreeSpecies, TreeHeight, TreeSeed, TreeTier (niveau max construit),
	      TreeBase (Vector3), TreeLawn.
	  Greenery.Hash(a, b?) -> 0..1 (même formule que TownKit.Hash)
]]

local Greenery = {}

local M = Enum.Material
local V = Vector3.new
local TAU = math.pi * 2

Greenery.NEAR_TIER = 2

-- Plan du LAC du parc (v9.7), partagé serveur (TownNature) / client
-- (TownGreenery : nénuphars, canards, cygnes, roseaux de près). Repère du
-- lac (attribut "DetailCF" du modèle Lake) : origine = centre au niveau du
-- pré, X = le long de la rive, Z = en s'éloignant de la place ; les
-- valeurs sont des fractions du rayon R (attribut "DetailR").
Greenery.LAKE = {
	BridgeX = -0.22, -- (pont : de z = -(R+5) à z = R+5)
	BridgeHalfW = 3.2,
	Island = { 0.36, 0.14, 0.2 }, -- x, z, rayon
	Jet = { 0.18, -0.42 },
	DockZ = -0.34, -- (ponton : le long de x, depuis la rive +X)
	WaterTop = 0.4, -- (au-dessus du pré)
}

Greenery.SPECIES = { "Oak", "Maple", "Cherry", "Birch", "Fir", "Palm", "Poplar", "Fruit", "Willow", "Round" }

local function hash(a: number, b: number?): number
	local x = math.sin(a * 12.9898 + (b or 0) * 78.233) * 43758.5453
	return x - math.floor(x)
end
Greenery.Hash = hash

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

-- Palettes (2-3 teintes par arbre : ombre, milieu, lumière)
local PAL = {
	Oak = { { rgb(84, 148, 72), rgb(104, 168, 82), rgb(132, 190, 96) }, { rgb(72, 136, 76), rgb(94, 158, 80), rgb(122, 182, 92) }, { rgb(92, 150, 64), rgb(116, 170, 74), rgb(146, 196, 94) } },
	Maple = { { rgb(206, 78, 58), rgb(236, 124, 62), rgb(248, 178, 76) }, { rgb(190, 64, 70), rgb(226, 98, 64), rgb(244, 150, 70) }, { rgb(214, 120, 52), rgb(240, 166, 66), rgb(250, 208, 102) } },
	Cherry = { { rgb(240, 150, 186), rgb(255, 180, 208), rgb(255, 216, 230) }, { rgb(232, 138, 180), rgb(250, 168, 202), rgb(255, 206, 226) } },
	Birch = { { rgb(128, 178, 84), rgb(152, 198, 96), rgb(184, 216, 110) }, { rgb(140, 186, 76), rgb(166, 204, 92), rgb(198, 222, 116) } },
	Fir = { { rgb(40, 96, 72), rgb(52, 114, 82), rgb(70, 134, 92) }, { rgb(46, 104, 80), rgb(60, 124, 88), rgb(82, 146, 98) } },
	Palm = { { rgb(80, 150, 64), rgb(104, 172, 72), rgb(136, 194, 86) } },
	Poplar = { { rgb(84, 144, 64), rgb(108, 166, 74), rgb(136, 186, 86) }, { rgb(96, 152, 70), rgb(120, 172, 80), rgb(154, 196, 92) } },
	Fruit = { { rgb(80, 146, 70), rgb(102, 166, 80), rgb(130, 188, 92) } },
	Willow = { { rgb(116, 170, 88), rgb(140, 190, 100), rgb(170, 208, 112) } },
	Round = { { rgb(78, 146, 78), rgb(98, 164, 86), rgb(124, 184, 96) } },
}
local BARK = rgb(116, 84, 62)
local BARK_DARK = rgb(92, 66, 52)
local BARK_CHERRY = rgb(104, 70, 68)
local BIRCH_BARK = rgb(238, 234, 226)
local BIRCH_MARK = rgb(58, 54, 60)
local PALM_BARK = rgb(168, 130, 92)
local PALM_RING = rgb(140, 104, 74)
local FRUITS = { rgb(222, 52, 62), rgb(236, 72, 58), rgb(246, 150, 52) }

----------------------------------------------------------------------
-- Descriptions de pièces (repère local de l'arbre : pied au sol, 0,0,0)
----------------------------------------------------------------------

type Spec = {
	Tier: number,
	Kind: string, -- "Ball" | "Egg" | "Cyl" | "Block"
	Name: string,
	Size: Vector3,
	CF: CFrame,
	Color: Color3,
	Material: Enum.Material,
	Profile: string, -- "prop" (solide) | "deco" | "decoS" (décor qui garde son ombre)
	Transparency: number?,
}

local function dir(angle: number): Vector3
	return V(math.cos(angle), 0, math.sin(angle))
end

local function add(list: { Spec }, tier: number, kind: string, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material, profile: string)
	table.insert(list, { Tier = tier, Kind = kind, Name = name, Size = size, CF = cf, Color = color, Material = material, Profile = profile })
end

local function ball(list: { Spec }, tier: number, name: string, center: Vector3, d: number, color: Color3, profile: string?)
	add(list, tier, "Ball", name, V(d, d, d), CFrame.new(center), color, M.Grass, profile or "deco")
end

-- (grappes / étages : chaque ovale tourne un peu sur lui-même, d'un angle
-- différent de ses voisins : même un détecteur qui prendrait l'ovale pour
-- sa boîte n'y trouverait aucune face parallèle confondue ; palmes, rideaux
-- et racines gardent leur orientation)
local SPIN = { Crown = true, CrownTop = true, Cluster = true, Tier = true, Tip = true, Bough = true, Petals = true }
local function egg(list: { Spec }, tier: number, name: string, cf: CFrame, size: Vector3, color: Color3, profile: string?, material: Enum.Material?)
	local c = SPIN[name] and cf * CFrame.Angles(0, 0.3 + (#list % 7) * 0.33, 0) or cf
	add(list, tier, "Egg", name, size, c, color, material or M.Grass, profile or "deco")
end

-- cylindre debout (pied `bottom`)
local function column(list: { Spec }, tier: number, name: string, bottom: Vector3, height: number, d: number, color: Color3, material: Enum.Material, profile: string)
	add(list, tier, "Cyl", name, V(height, d, d), CFrame.new(bottom + V(0, height / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2), color, material, profile)
end

-- tige cylindrique de a à b (dépasse de `over` aux deux bouts : joints cachés)
local function rod(list: { Spec }, tier: number, name: string, a: Vector3, b: Vector3, d: number, color: Color3, material: Enum.Material, profile: string?, over: number?)
	local axis = (b - a).Unit
	local e = over or 0
	local a2, b2 = a - axis * e, b + axis * e
	local mid = (a2 + b2) / 2
	local up = math.abs(axis.Y) > 0.98 and V(1, 0, 0) or V(0, 1, 0)
	local cf = CFrame.lookAt(mid, b2, up) * CFrame.Angles(0, math.pi / 2, 0)
	add(list, tier, "Cyl", name, V((b2 - a2).Magnitude, d, d), cf, color, material, profile or "deco")
end

----------------------------------------------------------------------
-- Espèces
----------------------------------------------------------------------

type Ctx = { H: number, Seed: number, A: number, R: (k: number) -> number, P: { Color3 }, Lawn: boolean }

-- pied évasé (de près) : 3 racines = ovales couchés qui partent du tronc
local function roots(list: { Spec }, c: Ctx, d: number, color: Color3, material: Enum.Material?)
	for k = 0, 2 do
		local b = c.A + 0.6 + k * TAU / 3 + c.R(120 + k) * 0.5
		local cf = CFrame.new(dir(b) * d * 0.52 + V(0, 0.04, 0)) * CFrame.Angles(0, -b, 0) * CFrame.Angles(0, 0, math.rad(-14))
		egg(list, 2, "Root", cf, V(d * 1.5, d * 0.62, d * 0.7), color, "deco", material or M.Wood)
	end
end

-- Feuillus ronds : chêne, érable, pommier
local function broadleaf(list: { Spec }, c: Ctx, species: string)
	local H, A, R, P = c.H, c.A, c.R, c.P
	local fruit = species == "Fruit"
	local tH = H * (fruit and 0.34 or 0.42)
	local d = fruit and (0.4 + H * 0.05) or (0.5 + H * 0.06)
	local s = 0.92 + R(9) * 0.16 -- (grappes un peu plus ou moins fournies)
	local bark = fruit and BARK_DARK or BARK
	column(list, 0, "Trunk", V(0, -0.2, 0), tH + H * 0.2 + 0.2, d, bark, M.Wood, "prop")
	-- branches : de la fourche vers le cœur des grappes
	local fork = V(0, tH * 0.86, 0)
	local p1 = dir(A) * H * 0.26 + V(0, H * 0.64, 0)
	local p2 = dir(A + 2.4 + R(3) * 0.4) * H * 0.24 + V(0, H * 0.6, 0)
	local p3 = dir(A + 4.3 + R(4) * 0.3) * H * 0.2 + V(0, H * 0.56, 0)
	rod(list, 1, "Branch", fork, p1, d * 0.5, bark, M.Wood)
	rod(list, 1, "Branch", fork + V(0, H * 0.03, 0), p2, d * 0.46, bark, M.Wood)
	rod(list, 2, "Branch", fork - V(0, H * 0.04, 0), p3, d * 0.4, bark, M.Wood)
	-- évasement du pied (ovale à moitié enterré)
	roots(list, c, d, bark, M.Wood)
	-- grappes
	local mid, dark, light = P[2], P[1], P[3]
	if species == "Maple" then
		-- (érable : grappes de teintes différentes, comme en automne)
		mid, dark, light = P[2], P[1], P[3]
	end
	ball(list, 0, "Crown", V(0, H * 0.72, 0) + dir(A + 1.2) * H * 0.03, H * 0.54 * s, mid, "decoS")
	ball(list, 0, "Crown", p1 + V(0, H * 0.04, 0), H * 0.42 * s, light, "decoS")
	ball(list, 0, "Crown", p2 + V(0, H * 0.03, 0), H * 0.4 * s, dark, "decoS")
	ball(list, 1, "CrownTop", V(0, H * 0.9, 0) + dir(A + 3.4) * H * 0.07, H * 0.34 * s, light:Lerp(mid, 0.3))
	ball(list, 2, "Cluster", p3 + V(0, H * 0.02, 0), H * 0.3 * s, dark:Lerp(mid, 0.4))
	ball(list, 2, "Cluster", dir(A + 1.1) * H * 0.3 + V(0, H * 0.8, 0), H * 0.24 * s, light)
	ball(list, 2, "Cluster", dir(A + 5.2) * H * 0.2 + V(0, H * 0.96, 0), H * 0.2 * s, mid:Lerp(light, 0.5))
	if fruit then
		-- pommes posées à la surface des grappes (sous l'équateur)
		local centers = { { V(0, H * 0.72, 0), H * 0.27 * s }, { p1 + V(0, H * 0.04, 0), H * 0.21 * s }, { p2 + V(0, H * 0.03, 0), H * 0.2 * s } }
		for i = 1, 7 do
			local ctr = centers[i % 3 + 1]
			local ang = A + i * 1.9 + R(20 + i)
			local rr = ctr[2]
			local p = ctr[1] + dir(ang) * rr * 0.88 - V(0, rr * 0.47, 0)
			ball(list, 2, "Apple", p, 0.7 + H * 0.02, FRUITS[i % #FRUITS + 1], "deco")
		end
	end
end

local function cherry(list: { Spec }, c: Ctx)
	local H, A, R, P = c.H, c.A, c.R, c.P
	local tH = H * 0.4
	local d = 0.4 + H * 0.06
	local s = 0.92 + R(9) * 0.16
	column(list, 0, "Trunk", V(0, -0.2, 0), tH + H * 0.12 + 0.2, d, BARK_CHERRY, M.Wood, "prop")
	local fork = V(0, tH * 0.92, 0)
	local tips = {}
	for k = 0, 2 do
		tips[k + 1] = dir(A + k * 2.1 + R(5 + k) * 0.5) * H * (0.28 + R(8 + k) * 0.06) + V(0, H * (0.57 + k * 0.03), 0)
	end
	rod(list, 1, "Branch", fork, tips[1], d * 0.45, BARK_CHERRY, M.Wood)
	rod(list, 1, "Branch", fork + V(0, H * 0.02, 0), tips[2], d * 0.42, BARK_CHERRY, M.Wood)
	rod(list, 2, "Branch", fork - V(0, H * 0.02, 0), tips[3], d * 0.4, BARK_CHERRY, M.Wood)
	roots(list, c, d, BARK_CHERRY, M.Wood)
	local yaw = CFrame.Angles(0, -A, 0)
	egg(list, 0, "Crown", CFrame.new(0, H * 0.71, 0) * yaw, V(H * 0.64, H * 0.36, H * 0.56) * s, P[2], "decoS")
	egg(list, 0, "Crown", CFrame.new(tips[1] + V(0, H * 0.06, 0)) * yaw, V(H * 0.42, H * 0.27, H * 0.38) * s, P[3], "decoS")
	egg(list, 0, "Crown", CFrame.new(tips[2] + V(0, H * 0.085, 0)) * yaw, V(H * 0.4, H * 0.26, H * 0.36) * s, P[1], "decoS")
	egg(list, 1, "CrownTop", CFrame.new(dir(A + 3.6) * H * 0.06 + V(0, H * 0.89, 0)) * yaw, V(H * 0.36, H * 0.22, H * 0.34) * s, P[3])
	egg(list, 2, "Cluster", CFrame.new(tips[3] + V(0, H * 0.05, 0)) * yaw, V(H * 0.3, H * 0.2, H * 0.3) * s, P[2]:Lerp(P[1], 0.5))
	egg(list, 2, "Cluster", CFrame.new(dir(A + 0.9) * H * 0.3 + V(0, H * 0.835, 0)) * yaw, V(H * 0.24, H * 0.16, H * 0.24) * s, P[3])
	if c.Lawn then
		-- pétales tombés : taches roses à plat sur la pelouse
		for k = 0, 2 do
			local p = dir(A + k * 2.3 + R(30 + k)) * H * (0.2 + R(33 + k) * 0.14) + V(0, 0.06, 0)
			egg(list, 2, "Petals", CFrame.new(p) * CFrame.Angles(0, R(36 + k) * TAU, 0), V(H * 0.22, 0.12, H * 0.16), P[3], "deco", M.SmoothPlastic)
		end
	end
end

local function birch(list: { Spec }, c: Ctx)
	local H, A, R, P = c.H, c.A, c.R, c.P
	local d = 0.3 + H * 0.04
	column(list, 0, "Trunk", V(0, -0.2, 0), H * 0.8 + 0.2, d, BIRCH_BARK, M.SmoothPlastic, "prop")
	-- marques noires : petits traits posés sur l'écorce (tangents au tronc)
	for k = 1, 7 do
		local b = A + k * 2.4 + R(40 + k)
		local y = H * (0.06 + k * 0.07) + R(44 + k) * 0.5
		local cf = CFrame.new(dir(b) * (d / 2 - 0.02) + V(0, y, 0)) * CFrame.Angles(0, math.pi / 2 - b, 0)
		add(list, 2, "Block", "BarkMark", V(d * (0.35 + R(48 + k) * 0.3), 0.1 + R(52 + k) * 0.08, 0.1), cf, BIRCH_MARK, M.SmoothPlastic, "deco")
	end
	local b1 = dir(A) * H * 0.18 + V(0, H * 0.7, 0)
	local b2 = dir(A + 2.6 + R(3) * 0.5) * H * 0.17 + V(0, H * 0.64, 0)
	rod(list, 1, "Branch", V(0, H * 0.5, 0), b1, d * 0.45, BIRCH_BARK, M.SmoothPlastic)
	rod(list, 1, "Branch", V(0, H * 0.46, 0), b2, d * 0.42, BIRCH_BARK, M.SmoothPlastic)
	roots(list, c, d, BIRCH_BARK, M.SmoothPlastic)
	local yaw = CFrame.Angles(0, -A, 0)
	egg(list, 0, "Crown", CFrame.new(0, H * 0.74, 0) * yaw, V(H * 0.34, H * 0.46, H * 0.32), P[2], "decoS")
	egg(list, 0, "Crown", CFrame.new(b1 + V(0, H * 0.04, 0)) * yaw, V(H * 0.28, H * 0.34, H * 0.26), P[3], "decoS")
	egg(list, 0, "Crown", CFrame.new(b2 + V(0, H * 0.02, 0)) * yaw, V(H * 0.26, H * 0.32, H * 0.26), P[1], "decoS")
	egg(list, 1, "CrownTop", CFrame.new(dir(A + 4) * H * 0.04 + V(0, H * 0.95, 0)) * yaw, V(H * 0.2, H * 0.26, H * 0.2), P[3])
	egg(list, 2, "Cluster", CFrame.new(dir(A + 1.5) * H * 0.15 + V(0, H * 0.56, 0)) * yaw, V(H * 0.2, H * 0.22, H * 0.2), P[1]:Lerp(P[2], 0.5))
	egg(list, 2, "Cluster", CFrame.new(dir(A + 4.4) * H * 0.16 + V(0, H * 0.84, 0)) * yaw, V(H * 0.18, H * 0.2, H * 0.18), P[2])
end

local function fir(list: { Spec }, c: Ctx)
	local H, A, R, P = c.H, c.A, c.R, c.P
	local d = 0.35 + H * 0.05
	local w = 0.94 + R(9) * 0.12
	column(list, 0, "Trunk", V(0, -0.2, 0), H * 0.62 + 0.2, d, BARK_DARK, M.Wood, "prop")
	roots(list, c, d, BARK_DARK, M.Wood)
	-- étages : ovales aplatis de plus en plus petits (légèrement tournés)
	local tiers = {
		{ 0.24, 0.66, 0.28, P[1] },
		{ 0.39, 0.54, 0.27, P[2] },
		{ 0.53, 0.42, 0.26, P[1]:Lerp(P[2], 0.5) },
		{ 0.66, 0.3, 0.25, P[2]:Lerp(P[3], 0.4) },
	}
	for i, t in ipairs(tiers) do
		local cf = CFrame.new(dir(A + i * 2) * H * 0.012 + V(0, H * t[1], 0)) * CFrame.Angles(0, -A - i * 0.7, 0)
		egg(list, 0, "Tier", cf, V(H * t[2] * w, H * t[3], H * t[2] * w * 0.94), t[4], i == 1 and "decoS" or "deco")
	end
	egg(list, 1, "Tip", CFrame.new(0, H * 0.82, 0), V(H * 0.17, H * 0.34, H * 0.17), P[3])
	-- (de près) bords d'étages irréguliers
	egg(list, 2, "Bough", CFrame.new(dir(A) * H * 0.24 + V(0, H * 0.24, 0)) * CFrame.Angles(0, -A, 0), V(H * 0.22, H * 0.14, H * 0.18), P[2])
	egg(list, 2, "Bough", CFrame.new(dir(A + 3.3) * H * 0.18 + V(0, H * 0.42, 0)) * CFrame.Angles(0, -A - 3.3, 0), V(H * 0.18, H * 0.13, H * 0.16), P[3]:Lerp(P[2], 0.5))
end

local function palm(list: { Spec }, c: Ctx)
	local H, A, R, P = c.H, c.A, c.R, c.P
	local d = 0.55 + H * 0.03
	-- tronc courbé : 3 segments qui penchent de plus en plus
	local pts = {}
	for i = 0, 3 do
		local t = i / 3
		pts[i + 1] = dir(A) * H * 0.16 * t * t + V(0, H * 0.84 * t, 0)
	end
	for i = 1, 3 do
		rod(list, 0, "Trunk", pts[i] - (i == 1 and V(0, 0.3, 0) or V(0, 0, 0)), pts[i + 1], d * (1.08 - i * 0.1), PALM_BARK, M.Wood, "prop", d * 0.2)
	end
	-- anneaux du tronc (de près) : petites boules aux jointures
	for i = 2, 3 do
		ball(list, 2, "Ring", pts[i], d * (1.1 - i * 0.08), PALM_RING, "deco")
	end
	local top = pts[4]
	ball(list, 1, "Heart", top + V(0, 0.1, 0), d * 1.5, P[1], "deco")
	-- palmes : longs ovales plats qui retombent
	local n = 7
	for k = 0, n - 1 do
		local b = A + k * TAU / n + R(50 + k) * 0.3
		local droop = math.rad(18 + R(60 + k) * 22)
		local L = H * (0.46 + R(70 + k) * 0.08)
		local out = dir(b) * math.cos(droop) - V(0, math.sin(droop), 0)
		local center = top + out * L * 0.46 + V(0, 0.3, 0)
		local cf = CFrame.lookAt(center, center + out)
		egg(list, k < 5 and 0 or 1, "Frond", cf, V(H * 0.13, 0.35, L), P[(k % 3) + 1], k == 0 and "decoS" or "deco")
	end
	for k = 0, 2 do
		ball(list, 2, "Coconut", top + dir(A + 0.8 + k * 2.1) * d * 0.55 - V(0, d * 0.55, 0), 0.8 + H * 0.01, rgb(122, 86, 52), "deco")
	end
end

local function poplar(list: { Spec }, c: Ctx)
	local H, A, P = c.H, c.A, c.P
	local d = 0.35 + H * 0.04
	column(list, 0, "Trunk", V(0, -0.2, 0), H * 0.42 + 0.2, d, BARK, M.Wood, "prop")
	roots(list, c, d, BARK, M.Wood)
	egg(list, 0, "Crown", CFrame.new(0, H * 0.55, 0), V(H * 0.28, H * 0.72, H * 0.28), P[2], "decoS")
	egg(list, 0, "Crown", CFrame.new(dir(A) * H * 0.05 + V(0, H * 0.72, 0)), V(H * 0.22, H * 0.5, H * 0.21), P[3], "deco")
	egg(list, 1, "Crown", CFrame.new(dir(A + 3) * H * 0.06 + V(0, H * 0.42, 0)), V(H * 0.22, H * 0.4, H * 0.22), P[1], "deco")
	egg(list, 2, "CrownTop", CFrame.new(dir(A + 1.4) * H * 0.02 + V(0, H * 0.93, 0)), V(H * 0.12, H * 0.2, H * 0.12), P[3])
	egg(list, 2, "Cluster", CFrame.new(dir(A + 4.6) * H * 0.08 + V(0, H * 0.62, 0)), V(H * 0.16, H * 0.28, H * 0.16), P[1]:Lerp(P[2], 0.5))
end

local function willow(list: { Spec }, c: Ctx)
	local H, A, R, P = c.H, c.A, c.R, c.P
	local d = 0.6 + H * 0.06
	column(list, 0, "Trunk", V(0, -0.2, 0), H * 0.56 + 0.2, d, BARK_DARK, M.Wood, "prop")
	roots(list, c, d, BARK_DARK, M.Wood)
	local b1 = dir(A) * H * 0.26 + V(0, H * 0.7, 0)
	local b2 = dir(A + 3.1) * H * 0.24 + V(0, H * 0.68, 0)
	rod(list, 1, "Branch", V(0, H * 0.42, 0), b1, d * 0.46, BARK_DARK, M.Wood)
	rod(list, 1, "Branch", V(0, H * 0.4, 0), b2, d * 0.42, BARK_DARK, M.Wood)
	egg(list, 0, "Crown", CFrame.new(0, H * 0.74, 0) * CFrame.Angles(0, -A, 0), V(H * 0.72, H * 0.36, H * 0.66), P[2], "decoS")
	-- rideaux qui pendent autour du dôme
	local n = 6
	for k = 0, n - 1 do
		local b = A + k * TAU / n + R(80 + k) * 0.25
		local tier = (k % 2 == 0) and 0 or (k == 5 and 2 or 1)
		local cf = CFrame.new(dir(b) * H * 0.3 + V(0, H * (0.5 + R(90 + k) * 0.06), 0)) * CFrame.Angles(0, -b, 0)
		egg(list, tier, "Drape", cf, V(H * 0.16, H * 0.5, H * 0.24), (k % 3 == 0) and P[1] or P[3], "deco")
	end
	egg(list, 2, "CrownTop", CFrame.new(dir(A + 2) * H * 0.08 + V(0, H * 0.9, 0)), V(H * 0.3, H * 0.16, H * 0.3), P[3])
end

local function round(list: { Spec }, c: Ctx)
	local H, P = c.H, c.P
	local d = 0.4 + H * 0.03
	column(list, 0, "Trunk", V(0, -0.2, 0), H * 0.5 + 0.2, d, BARK, M.Wood, "prop")
	ball(list, 0, "Crown", V(0, H * 0.64, 0), H * 0.56, P[2], "decoS")
	ball(list, 1, "Crown", V(0, H * 0.88, 0) + dir(c.A) * H * 0.05, H * 0.26, P[3])
	roots(list, c, d, BARK, M.Wood)
end

local BUILDERS = {
	Oak = function(list, c)
		broadleaf(list, c, "Oak")
	end,
	Maple = function(list, c)
		broadleaf(list, c, "Maple")
	end,
	Fruit = function(list, c)
		broadleaf(list, c, "Fruit")
	end,
	Cherry = cherry,
	Birch = birch,
	Fir = fir,
	Palm = palm,
	Poplar = poplar,
	Willow = willow,
	Round = round,
}

-- Nom d'espèce (accepte les anciens numéros v9.4)
function Greenery.Species(kind: any, seed: number): string
	if type(kind) == "string" and BUILDERS[kind] then
		return kind
	end
	if kind == 2 then
		return "Cherry"
	elseif kind == 3 then
		return "Fir"
	elseif kind == 4 then
		return "Round"
	end
	-- feuillu "au hasard" : surtout des chênes, quelques érables / bouleaux
	local h = hash(seed, 17)
	if h < 0.5 then
		return "Oak"
	elseif h < 0.68 then
		return "Maple"
	elseif h < 0.84 then
		return "Birch"
	end
	return "Fruit"
end

----------------------------------------------------------------------
-- Construction
----------------------------------------------------------------------

local function applyProfile(p: BasePart, profile: string)
	p.CanTouch = false
	if profile == "prop" then
		p.CanQuery = false
		p.CastShadow = true
	else
		p.CanCollide = false
		p.CanQuery = false
		p.CastShadow = profile == "decoS"
	end
end

local function make(parent: Instance, spec: Spec, root: CFrame): BasePart
	local p = Instance.new("Part")
	p.Name = spec.Name
	p.Anchored = true
	p.Size = spec.Size
	p.CFrame = root * spec.CF
	p.Color = spec.Color
	p.Material = spec.Material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if spec.Kind == "Ball" then
		p.Shape = Enum.PartType.Ball
	elseif spec.Kind == "Cyl" then
		p.Shape = Enum.PartType.Cylinder
	elseif spec.Kind == "Egg" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	if spec.Transparency then
		p.Transparency = spec.Transparency
	end
	applyProfile(p, spec.Profile)
	p.Parent = parent
	return p
end

function Greenery.Tree(parent: Instance, base: Vector3, height: number, seed: number, species: string, maxTier: number, minTier: number?, opts: { [string]: any }?): (Model, number)
	local o = opts or {}
	local sp = Greenery.Species(species, seed)
	local pals = PAL[sp] or PAL.Oak
	local R = function(k: number): number
		return hash(seed, k)
	end
	local c: Ctx = {
		H = height,
		Seed = seed,
		A = R(1) * TAU,
		R = R,
		P = pals[1 + math.floor(R(2) * #pals) % #pals],
		Lawn = o.Lawn == true,
	}
	local list: { Spec } = {}
	BUILDERS[sp](list, c)
	local model = Instance.new("Model")
	model.Name = o.Name or "Tree"
	local root = CFrame.new(base) * CFrame.Angles(0, R(6) * TAU, 0)
	local lo = minTier or 0
	local n = 0
	for _, spec in ipairs(list) do
		if spec.Tier >= lo and spec.Tier <= maxTier then
			make(model, spec, root)
			n += 1
		end
	end
	model:SetAttribute("TreeSpecies", sp)
	model:SetAttribute("TreeHeight", height)
	model:SetAttribute("TreeSeed", seed)
	model:SetAttribute("TreeTier", maxTier)
	model:SetAttribute("TreeBase", base)
	model:SetAttribute("TreeLawn", c.Lawn)
	model.Parent = parent
	return model, n
end

return Greenery
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="264">
        <Properties>
          <string name="Name">HouseOptions</string>
          <string name="Source"><![CDATA[--[[
	HouseOptions (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > HouseOptions

	(v10 HOUSE10) 🏡 Personnalisation de l'EXTÉRIEUR de la maison 3D, partagée
	serveur / client (aucun Enum ici : les matières sont des NOMS d'Enum.Material,
	converties côté client ; testable hors Roblox).

	Un "genre" (Kind) = un réglage (couleur de façade, forme du toit, volets...)
	avec une liste de choix. Le 1er choix de chaque genre est GRATUIT et veut dire
	"le look d'origine du style" (Auto) ou "rien" (None) : une maison sans
	personnalisation (anciennes sauvegardes) garde exactement son look.

	Données (HouseService) : data.House.Ext = { [Kind] = IdDuChoix, Num = 0..9999 }
	(Num = numéro affiché sur la maison et la boîte aux lettres, 0 = automatique),
	data.House.OwnedExt = { ["Kind.Id"] = true } (choix achetés, gardés pour
	toujours). Réplication pour la ville : attribut du propriétaire "HouseExt"
	= HouseOptions.Encode(ext) (seulement les choix non par défaut).

	Un choix : { Id, Name (anglais, traduit par Locale), Icon, Cost (Dopamine),
	Rebirths (visites à l'océan requises), Color (Color3)?, Material (nom)?, Value? }

	API :
	  HouseOptions.KINDS (liste ordonnée) ; HouseOptions.ByKind[kind] ;
	  HouseOptions.GROUPS (onglets de l'éditeur)
	  HouseOptions.Choice(kind, id) -> choix (le 1er si inconnu)
	  HouseOptions.Default(kind) -> Id du choix gratuit
	  HouseOptions.Applies(kind, style, floors) -> bool (ex. balcon : 2 étages ou plus)
	  HouseOptions.Sanitize(ext, owned) -> ext propre (choix connus ET possédés)
	  HouseOptions.Quote(design, owned, rebirths) -> (prix total, { choix à acheter }, verrou?)
	  HouseOptions.Encode(ext) -> texte ; HouseOptions.Decode(texte) -> ext
	  HouseOptions.Resolve(ext) -> ext complet (un Id par genre)
	  HouseOptions.OwnedKey(kind, id) -> "Kind.Id"
]]

local HouseOptions = {}

export type Choice = {
	Id: string,
	Name: string,
	Icon: string,
	Cost: number,
	Rebirths: number,
	Color: Color3?,
	Material: string?,
	Value: string?,
	Order: number?,
}

export type Kind = {
	Id: string,
	Name: string,
	Icon: string,
	Group: string,
	Swatch: boolean?, -- choix = pastilles de couleur
	Choices: { Choice },
	ById: { [string]: Choice },
	MinFloors: number?, -- (balcon) seulement pour les maisons à étages
	NotStyles: { [string]: boolean }?, -- styles où le genre ne s'applique pas
}

HouseOptions.MAX_NUMBER = 9999

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local function c(id: string, name: string, icon: string, cost: number, rebirths: number?, extra: { [string]: any }?): Choice
	local choice: any = { Id = id, Name = name, Icon = icon, Cost = cost, Rebirths = rebirths or 0 }
	if extra then
		for k, v in pairs(extra) do
			choice[k] = v
		end
	end
	return choice :: Choice
end

-- Petites aides : choix de couleur
local function col(id: string, name: string, cost: number, color: Color3, rebirths: number?): Choice
	return c(id, name, "🎨", cost, rebirths, { Color = color })
end

----------------------------------------------------------------------
-- Catalogue (ordre = ordre de l'éditeur)
----------------------------------------------------------------------

local KINDS: { any } = {
	-- 🏛️ Architecture : le "style" de la maison, sur la même taille
	{ Id = "Arch", Name = "Architecture", Icon = "🏛️", Group = "Style", Choices = {
		c("Auto", "Original style", "🏠", 0),
		c("Chalet", "Mountain chalet", "🏔️", 2.5e6, 1),
		c("Modern", "Modern villa", "🏙️", 4e7, 2),
	} },

	-- 🧱 Façade
	{ Id = "WallColor", Name = "Facade colour", Icon = "🎨", Group = "Facade", Swatch = true, Choices = {
		c("Auto", "Style colour", "🏠", 0),
		col("Chalk", "Chalk white", 12000, rgb(244, 242, 236)),
		col("Cream", "Warm cream", 12000, rgb(240, 228, 204)),
		col("Sand", "Sandstone", 25000, rgb(222, 200, 162)),
		col("Greige", "Stone grey", 25000, rgb(184, 178, 166)),
		col("Rose", "Old rose", 40000, rgb(224, 168, 164)),
		col("Peach", "Apricot", 40000, rgb(242, 194, 158)),

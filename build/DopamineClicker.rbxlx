local STAGE_W = 330 -- largeur de la scène (centrée sur la streameuse)
local VIDEO_RADIUS = 13 -- coins arrondis de la vidéo
local CAM_ZOOM = 1.45 -- gros plan
local CAM_TOP = 6 -- ligne de la scène au ras du haut de l'image

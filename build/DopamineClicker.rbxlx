	-- Horloge
	local clockBox = frame({ Name = "Clock", AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, CLOCK_W, 1, 0), BackgroundColor3 = white, ZIndex = 4, Parent = container })

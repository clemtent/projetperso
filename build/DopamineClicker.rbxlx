			add(name, Vector3.new(0.4, 0.04, 0.16), CFrame.new(x, 0.25, sz * 0.13), bunTop, M.SmoothPlastic)
		end
		add(name, Vector3.new(0.42, 0.15, 0.15), CFrame.new(x, 0.2, 0), sausage, M.SmoothPlastic, CYL)

			Position = UDim2.fromOffset(x, y),
			Size = UDim2.fromOffset(w, h),
			Rotation = rotation,
			BackgroundColor3 = color,
			ZIndex = 4,
			Parent = scene,
		})
		UI.Label({
			Text = text,
			RichText = true,
			TextColor3 = Color3.fromRGB(50, 40, 40),
			TextWrapped = true,
			Size = UDim2.new(1, -6, 1, -6),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			MaxTextSize = 12,
			ZIndex = 4,
			Parent = note,
		})
	end

R.SmartSpeaker = function(b, _ctx)
	local fabric = b.Map(rgb(96, 100, 112))
	b.Cyl(0, 0, 0, 44, 58, fabric, M.Fabric)
	b.Cyl(0, 58, 0, 44, 6, rgb(40, 42, 52), M.SmoothPlastic)

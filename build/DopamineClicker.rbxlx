-- (v9.7) DESSINS À LA CRAIE (une seule pièce plate chacun, SurfaceGui sur
-- le dessus, pièce invisible) : une marelle 1…8 + "Sky", et un dessin
-- (soleil, cœurs, fleurs, "Smile!"). Dessus à +0,13 au-dessus de la place.
local CHALK_Y = 0.13
local function chalkBoard(folder: Instance, name: string, cf: CFrame, size: Vector2): Frame
	local p = part(folder, name, Vector3.new(size.X, 0.04, size.Y), cf * CFrame.new(0, CHALK_Y - 0.02, 0), C.White, M.SmoothPlastic, "deco")
	p.Transparency = 1
	local _, body = TownKit.Surface(p, Enum.NormalId.Top, 40, nil, 110, 1)
	return body
end

local function chalkText(parent: Instance, text: string, x: number, y: number, w: number, h: number, color: Color3, localize: boolean?)
	local l = TownKit.Label(parent, "Chalk", text, x, y, w, h, color, Enum.Font.FredokaOne, localize)
	l.TextTransparency = 0.12
	return l
end

local function hopscotch(folder: Instance, cf: CFrame)
	local body = chalkBoard(folder, "Hopscotch", cf, Vector2.new(4.2, 11))
	local chalk = { Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 196, 222), Color3.fromRGB(196, 226, 255), Color3.fromRGB(255, 236, 160) }
	-- cases (du bas vers le haut) : 1, 2, 3, 4-5, 6, 7-8, puis "Sky"
	local rows = { { "1" }, { "2" }, { "3" }, { "4", "5" }, { "6" }, { "7", "8" } }
	local rowH = 1 / 7.4
	for r, row in ipairs(rows) do
		for c, label in ipairs(row) do
			local w = #row == 1 and 0.46 or 0.44
			local x = #row == 1 and 0.27 or (c == 1 and 0.05 or 0.51)
			local box = Instance.new("Frame")
			box.Name = "Box"
			box.BackgroundTransparency = 1
			box.Position = UDim2.fromScale(x, 1 - r * rowH - 0.02)
			box.Size = UDim2.fromScale(w, rowH - 0.012)
			box.Parent = body
			TownKit.Stroke(box, chalk[(r + c) % #chalk + 1], 5)
			chalkText(box, label, 0.1, 0.1, 0.8, 0.8, chalk[(r + c + 1) % #chalk + 1])
		end
	end
	chalkText(body, "Sky", 0.12, 0.02, 0.76, 0.1, Color3.fromRGB(196, 226, 255), true)
end

local function chalkArt(folder: Instance, cf: CFrame)
	local body = chalkBoard(folder, "ChalkArt", cf, Vector2.new(9, 7))
	chalkText(body, "☀", 0.02, 0.02, 0.3, 0.42, Color3.fromRGB(255, 226, 120))
	chalkText(body, "♥", 0.66, 0.05, 0.3, 0.36, Color3.fromRGB(255, 150, 190))
	chalkText(body, "✿", 0.34, 0.08, 0.3, 0.3, Color3.fromRGB(214, 180, 255))
	chalkText(body, "Smile!", 0.06, 0.48, 0.88, 0.3, Color3.fromRGB(255, 255, 255), true)
	chalkText(body, "♥ ✿ ♥", 0.2, 0.78, 0.6, 0.18, Color3.fromRGB(170, 236, 206))
end

-- (v9.7) Lampadaire de la place : socle, fût, bague, traverse et DEUX
-- lanternes (verre dépoli TownKit.Glow : Neon la nuit seulement), épi.
-- `light` : une vraie lumière douce (TownKit.Light, la nuit). Le fil des
-- guirlandes (client) part du sommet : PLAZA_LAMP_TOP.
local PLAZA_LAMP_TOP = 11.5
local function plazaLamp(folder: Instance, base: Vector3, along: Vector3, light: boolean)
	local model = TownKit.Model(folder, "Lamp")
	local iron = Color3.fromRGB(56, 52, 70)
	local rot = CFrame.lookAt(base, base + along)
	TownKit.Column(model, "Foot", base, 1, 1.5, iron, M.Metal, "prop")
	TownKit.Column(model, "Pole", base + Vector3.new(0, 1, 0), 10.2, 0.45, iron, M.Metal, "prop")
	TownKit.Ball(model, "Knob", base + Vector3.new(0, 4.2, 0), 0.8, iron, M.Metal, "deco")
	part(model, "Bar", Vector3.new(0.2, 0.22, 4.2), rot * CFrame.new(0, 10.9, 0), iron, M.Metal, "deco")
	TownKit.Ball(model, "Finial", base + Vector3.new(0, PLAZA_LAMP_TOP, 0), 0.6, C.Yellow, M.Metal, "deco")
	local first: BasePart? = nil
	for _, z in ipairs({ -1.9, 1.9 }) do
		local lcf = rot * CFrame.new(0, 10.5, z)
		part(model, "Hood", Vector3.new(0.95, 0.3, 0.95), lcf * CFrame.new(0, 0.35, 0), iron, M.Metal, "deco")
		local glow = TownKit.Glow(part(model, "Glow", Vector3.new(0.7, 0.9, 0.7), lcf * CFrame.new(0, -0.25, 0), C.Glow, M.SmoothPlastic, "deco"))
		first = first or glow
	end
	if light and first then
		TownKit.Light(first, C.Glow, 18, 0.8)
	end
end

----------------------------------------------------------------------
-- Couronne de boutiques
----------------------------------------------------------------------

-- Intervalles d'angles occupés (radians, 0..2π) -> intervalles libres
local function freeArcs(blocked: { { number } }): { { number } }
	local twoPi = math.pi * 2
	local list = {}
	for _, b in ipairs(blocked) do
		local a0, a1 = b[1] % twoPi, b[2] % twoPi
		if a0 <= a1 then
			table.insert(list, { a0, a1 })
		else
			table.insert(list, { a0, twoPi })
			table.insert(list, { 0, a1 })
		end
	end
	table.sort(list, function(x, y)
		return x[1] < y[1]
	end)
	local free = {}
	local cursor = 0
	for _, b in ipairs(list) do
		if b[1] > cursor then
			table.insert(free, { cursor, b[1] })
		end
		cursor = math.max(cursor, b[2])
	end
	if cursor < twoPi then
		table.insert(free, { cursor, twoPi })
	end
	-- (recolle l'arc qui passe par 0)
	if #free >= 2 and free[1][1] == 0 and free[#free][2] == twoPi then
		local last = table.remove(free) :: { number }
		free[1] = { last[1] - twoPi, free[1][2] }
	end
	return free
end

-- (v9.6) Couronne : d'abord les 6 BOUTIQUES OÙ L'ON ENTRE (TownShops,
-- 30 studs de large : elles tiennent toujours, de 4 à 12 parcelles), puis
-- des boutiques de décor (fermées) dans la place qui reste, de part et
-- d'autre. Renvoie (boutiques de décor, boutiques où l'on entre).
local SHOP_MARGIN = 1.2 -- (studs) de chaque côté d'une façade
local function angularWidth(w: number): number
	return 2 * math.atan((w / 2 + SHOP_MARGIN) / FACADE_R)
end

local function shopRing(folder: Instance, geo: TownKit.Geo, shopsFolder: Instance): (number, number)
	local O = geo.Origin
	local blocked = {}
	for _, slot in ipairs(geo.Streets) do
		local a = geo.SlotAngle(slot)
		local half = math.atan((slot == 0 and 23 or 15) / FACADE_R)
		table.insert(blocked, { a - half, a + half })
	end
	-- mairie (au fond, face à l'avenue)
	local hallHalf = math.atan(36 / FACADE_R)
	table.insert(blocked, { math.pi - hallHalf, math.pi + hallHalf })
	local enterQueue = table.clone(TownShops.SPECS)
	-- décor : pas de 2e magasin de jouets / de fleurs (la jardinerie en vend)
	local decor = {}
	for _, spec in ipairs(TownBuildings.SHOPS) do
		if spec.Kind ~= "Toys" and spec.Kind ~= "Flowers" then
			table.insert(decor, spec)
		end
	end
	local used, entered = 0, 0
	local enterWidth = angularWidth(TownShops.W)
	for _, arc in ipairs(freeArcs(blocked)) do
		local span = arc[2] - arc[1]
		local inner, sides = {}, {}
		local total = 0
		while enterQueue[1] and total + enterWidth <= span do
			table.insert(inner, { Enter = table.remove(enterQueue, 1), Width = enterWidth })
			total += enterWidth
		end
		while true do
			local spec = decor[(used + #sides) % #decor + 1]
			local width = angularWidth(spec.W)
			if total + width > span then
				break
			end
			table.insert(sides, { Spec = spec, Width = width })
			total += width
		end
		-- décor réparti des deux côtés des boutiques où l'on entre
		local chosen = {}
		for i = 1, #sides, 2 do
			table.insert(chosen, sides[i])
		end
		for _, item in ipairs(inner) do
			table.insert(chosen, item)
		end
		for i = 2, #sides, 2 do
			table.insert(chosen, sides[i])
		end
		local a = (arc[1] + arc[2]) / 2 - total / 2
		for _, item in ipairs(chosen) do
			local angle = a + item.Width / 2
			local d = Vector3.new(math.sin(angle), 0, math.cos(angle))
			local p = O + d * FACADE_R + Vector3.new(0, WALK_Y, 0)
			-- (façade vers la place : LookVector = vers le centre)
			local cf = CFrame.lookAt(p, Vector3.new(O.X, p.Y, O.Z))
			local w = item.Enter and TownShops.W or item.Spec.W
			-- trottoir devant la boutique (un poil au-dessus du pavage : pas de
			-- faces confondues avec la place)
			part(folder, "ShopApron", Vector3.new(w + 2, 1.3, 6), cf * CFrame.new(0, -0.65 + 0.04, -2.5), C.Walk, M.Pavement, "solid")
			if item.Enter then
				entered += 1
				TownShops.Shop(shopsFolder, cf, item.Enter, entered)
			else
				TownBuildings.Shop(folder, cf, item.Spec, used + 1)
				used += 1
				-- (v9.9, CITY99) terrasse de café devant les boutiques de décor
				-- (client : tables, chaises, parasols ; passants attablés),
				-- jamais contre un lampadaire de la place (décalée s'il le faut)
				for _, dx in ipairs({ 0, -5, 5 }) do
					local tcf = cf * CFrame.new(dx, 0, -7.5)
					local clear = math.abs(dx) + 6 <= w / 2 + 2
					for i = 0, 7 do
						local la = (i + 0.5) / 8 * math.pi * 2
						local lp = O + Vector3.new(math.sin(la), 0, math.cos(la)) * (R - 6)
						if Vector3.new(tcf.Position.X - lp.X, 0, tcf.Position.Z - lp.Z).Magnitude < 8.5 then
							clear = false
						end
					end
					if clear then
						TownKit.LifeSpot("Terrace", tcf, 200 + used)
						break
					end
				end
			end
			a += item.Width
		end
	end
	if enterQueue[1] then
		warn("[TownPlaza] boutiques sans place : " .. #enterQueue)
	end
	return used, entered
end

----------------------------------------------------------------------
-- Construction
----------------------------------------------------------------------

export type PlazaResult = { Screen: TownBuildings.Screen, ShopsUsed: number, Enterable: number }

-- `shopsFolder` : dossier des boutiques où l'on entre (DopamineTown.Shops)
function TownPlaza.Build(folder: Instance, geo: TownKit.Geo, shopsFolder: Instance?): PlazaResult
	local plaza = Instance.new("Folder")
	plaza.Name = "Plaza"
	plaza.Parent = folder
	local O = geo.Origin
	local ground = O + Vector3.new(0, WALK_Y, 0)
	paving(plaza, O)
	fountain(plaza, O)
	-- (v9.7) 6 bancs (TownKit.Bench) autour de la fontaine, face au bassin,
	-- jamais dans l'axe de l'avenue ni de la mairie
	for i = 0, 5 do
		local a = (i + 0.5) / 6 * math.pi * 2
		local p = ground + Vector3.new(math.sin(a) * 19, 0, math.cos(a) * 19)
		TownKit.Bench(plaza, CFrame.lookAt(p, ground))
		TownKit.LifeSpot("SitBench", CFrame.lookAt(p, ground), 70 + i) -- (v9.8, CITY98) passants assis (client)
	end
	-- lampadaires à deux lanternes (anneau) ; 2 vraies lumières douces
	-- (les guirlandes lumineuses et les fanions entre eux : client)
	local lampR = R - 6
	for i = 0, 7 do
		local a = (i + 0.5) / 8 * math.pi * 2
		local d = Vector3.new(math.sin(a), 0, math.cos(a))
		plazaLamp(plaza, ground + d * lampR, Vector3.new(d.Z, 0, -d.X), i == 0 or i == 7)
	end
	-- kiosque (arrière gauche), manège (arrière droit), ballons (avant
	-- droit), glaces (avant gauche), barbe à papa (droite), musicien (gauche)
	local function spot(angle: number, dist: number): Vector3
		return ground + Vector3.new(math.sin(angle) * dist, 0, math.cos(angle) * dist)
	end
	-- (v9.9, CITY99) le kiosque laisse la place à la SCÈNE DE MUSIQUE
	-- (MUSIC99, TownMusic) : empreinte 24 x 16 centrée à 42 studs, à 225°,
	-- LookVector = devant de la scène (vers la fontaine et le public)
	local stageCF = CFrame.lookAt(spot(math.rad(225), 42), ground)
	plaza:SetAttribute("FxStageCF", stageCF)
	if okMusic and type(TownMusic) == "table" and type(TownMusic.Build) == "function" then
		local okStage, errStage = pcall(TownMusic.Build, plaza, stageCF)
		if not okStage then
			warn("[TownPlaza] scène de musique : " .. tostring(errStage))
		end
	end
	local carF = CFrame.lookAt(spot(math.rad(135), 41), ground)
	pad(plaza, carF.Position, 12)
	local carouselCF = carousel(plaza, carF)
	local tie = balloonCart(plaza, CFrame.lookAt(spot(math.rad(38), 34), ground))
	iceCreamStall(plaza, CFrame.lookAt(spot(math.rad(-38), 34), ground))
	candyStall(plaza, CFrame.lookAt(spot(math.rad(104), 31), ground))
	busker(plaza, CFrame.lookAt(spot(math.rad(292), 33), ground))
	local hop = spot(math.rad(16), 27)
	hopscotch(plaza, CFrame.lookAt(hop, hop - (hop - ground).Unit)) -- ("1" côté avenue, "Sky" côté fontaine)
	chalkArt(plaza, CFrame.new(spot(math.rad(170), 28)))
	-- repères pour le client (TownPlazaFx : manège qui tourne, ballons,
	-- guirlandes, fanions, ampoules du kiosque, pigeons)
	plaza:SetAttribute("FxVersion", 1)
	plaza:SetAttribute("FxCenter", ground)
	plaza:SetAttribute("FxCarouselCF", carouselCF)
	plaza:SetAttribute("FxBalloonTie", tie)
	plaza:SetAttribute("FxLamps", Vector3.new(lampR, PLAZA_LAMP_TOP, 8))
	plaza:SetAttribute("FxFlock1", spot(math.rad(8), 23))
	plaza:SetAttribute("FxFlock2", spot(math.rad(292), 27))
	plaza:SetAttribute("FxFlock3", spot(math.rad(-30), 27))
	-- (v9.8, CITY98) fontaine animée (eau, jets, pièces : TownFountainFx) et
	-- pigeons 10x (TownPigeons) : repères pour le client
	plaza:SetAttribute("FxFountainBase", ground + Vector3.new(0, 0.15, 0))
	plaza:SetAttribute("FxFlock4", spot(math.rad(56), 27)) -- (v9.9 : loin de la scène)
	-- parterres fleuris + arbres en bacs
	-- (v9.9 : 200 -> 194 et 250 -> 262 : rien à moins de 13 studs de la scène)
	for i, deg in ipairs({ 58, 110, 160, 194, 262, 302, 322 }) do
		local p = spot(math.rad(deg), 48)
		if i % 2 == 1 then
			TownKit.Column(plaza, "BedRim", p, 1.4, 9, C.Stone, M.Concrete, "prop")
			-- (v9.7 NATURE97) vrai massif : bordure, terre, feuillage, bouquets
			TownKit.FlowerBed(plaza, p + Vector3.new(0, 1, 0), 3.9, i)
		else
			-- (v9.9, CITY99) vrais PLATANES dans une grille d'arbre en fonte
			-- (plus de bac blanc : un arbre de place pousse dans le pavé)
			part(plaza, "TreeGrate", Vector3.new(4.6, 0.3, 4.6), CFrame.new(p + Vector3.new(0, 0.16 - 0.15, 0)) * CFrame.Angles(0, math.rad(deg), 0), Color3.fromRGB(58, 56, 62), M.DiamondPlate, "deco")
			TownKit.Tree(plaza, p, 17 + (i % 3), i * 13, i == 4 and "Maple" or "Oak", { Tier = 1 })
		end
	end
	-- (v9.9, CITY99) zones où le client ne pose pas de joints de pavés
	-- (x, z relatifs au centre, rayon) : massifs, grilles, étals, jeux à la craie
	local keep = {}
	local function keepOut(p: Vector3, r: number)
		table.insert(keep, string.format("%.1f,%.1f,%.1f", p.X - ground.X, p.Z - ground.Z, r))
	end
	for _, deg in ipairs({ 58, 110, 160, 194, 262, 302, 322 }) do
		keepOut(spot(math.rad(deg), 48), 5.2)
	end
	keepOut(spot(math.rad(38), 34), 4.5)
	keepOut(spot(math.rad(-38), 34), 5)
	keepOut(spot(math.rad(104), 31), 4.5)
	keepOut(spot(math.rad(292), 33), 4.5)
	keepOut(spot(math.rad(16), 27), 6.5)
	keepOut(spot(math.rad(170), 28), 5)
	keepOut(spot(math.rad(12), 52), 1.5)
	for i = 0, 7 do
		local a = (i + 0.5) / 8 * math.pi * 2
		keepOut(ground + Vector3.new(math.sin(a), 0, math.cos(a)) * lampR, 1.4)
	end
	plaza:SetAttribute("FxKeepOut", table.concat(keep, ";"))
	-- (v9.9, CITY99) HORLOGE DE PLACE (colonne en fonte, deux cadrans :
	-- vers la place et vers l'avenue ; aiguilles et chiffres : TownDisplays)
	do
		local base = spot(math.rad(12), 52)
		local face = CFrame.lookAt(base, ground) -- (-Z : vers la fontaine)
		local iron = Color3.fromRGB(34, 64, 52)
		TownKit.Column(plaza, "ClockPlinth", base, 1.2, 1.6, Color3.fromRGB(150, 146, 140), M.Granite, "prop")
		TownKit.Column(plaza, "ClockPole", base + Vector3.new(0, 1.2, 0), 8.4, 0.55, iron, M.Metal, "prop")
		part(plaza, "ClockCase", Vector3.new(2.9, 2.9, 1.1), face * CFrame.new(0, 11.1, 0), iron, M.Metal, "deco")
		for _, back in ipairs({ false, true }) do
			local dial = part(plaza, "ClockFace", Vector3.new(2.6, 2.6, 0.12), face * (back and CFrame.Angles(0, math.pi, 0) or CFrame.identity) * CFrame.new(0, 11.1, -0.6), C.Cream, M.SmoothPlastic, "deco")
			dial:SetAttribute("TownClock", "Street")
		end
		TownKit.Ball(plaza, "ClockFinial", base + Vector3.new(0, 13.1, 0), 0.6, C.Yellow, M.Metal, "deco")
	end
	-- (v9.9, CITY99) repère "place" et poteaux indicateurs à chaque sortie
	TownKit.LifeSpot("Dest", CFrame.new(ground), 1)
	for _, slot in ipairs(geo.Streets) do
		local a = geo.SlotAngle(slot)
		local d = Vector3.new(math.sin(a), 0, math.cos(a))
		local side = Vector3.new(-d.Z, 0, d.X)
		local halfW = slot == 0 and 21 or 13
		TownKit.LifeSpot("Direction", CFrame.new(ground + d * (R + 9) - side * (halfW - 3)), 300 + slot)
	end
	TownKit.LifeSpot("Direction", CFrame.new(spot(math.rad(152), 55)), 310)
	-- mairie (au fond) + écran des meilleurs joueurs
	local hallP = ground + Vector3.new(0, 0, -(R + 4))
	local hallCF = CFrame.lookAt(hallP, ground)
	part(plaza, "HallApron", Vector3.new(70, 1.3, 8), hallCF * CFrame.new(0, -0.65 + 0.05, -1.5), C.Walk, M.Pavement, "solid")
	local _, screen = TownBuildings.TownHall(plaza, hallCF)
	local used, entered = shopRing(plaza, geo, shopsFolder or plaza)
	return { Screen = screen, ShopsUsed = used, Enterable = entered }
end

return TownPlaza
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="395">
          <Properties>
            <string name="Name">TownShops</string>
            <string name="Source"><![CDATA[--[[
	TownShops (ModuleScript)
	Emplacement : ServerScriptService > Services > World > TownShops

	🛍️ Les BOUTIQUES OÙ L'ON ENTRE de Dopamine Town (v9.6) : le serveur ne
	construit que la COQUE (collisions justes pour tous les joueurs) ; tout
	l'intérieur (étagères, comptoir, objets 3D à acheter, étiquettes,
	lumières) est construit par chaque client (Client/World/ShopInteriors),
	en flux, car les modèles 3D des objets n'existent que côté client.
	  - 6 boutiques autour de la place (TownPlaza) : 🐾 Animalerie,
	    🍰 Cuisine & Maison, 🛋️ Meubles & Déco, 🖥️ Setup Store,
	    🪴 Jardinerie, 🧸 Jouets. Façade vitrine (deux grandes vitres,
	    VRAIE porte de 6 studs à portes coulissantes vitrées que le client
	    ouvre à l'approche), enseigne traduisible, stores, enseigne en
	    drapeau, étage avec fenêtres, toit ; murs, sol et plafond solides ;
	  - la 🚗 CONCESSION AUTO (v9.8 : hors de la porte, à gauche de la route
	    d'arrivée, WorldLayout.DealershipCFrame) : grand hall vitré 70 x 50,
	    porte de 14 studs pour les voitures, 8 podiums "CarSlot_<n>"
	    (attribut CarCF : sol du podium, LookVector = avant de la voiture),
	    parvis pavé avec le socle du plateau tournant (attributs
	    TurntableCF / TurntableR), totem ; décor : client (DealerShowroom).
	Repère d'une boutique (`cf`) : milieu du pied de la façade au niveau
	des trottoirs (WALK_Y), LookVector vers la rue, volume derrière (+Z).

	Contrat (client ShopInteriors / GARAGE96) : chaque boutique est un Model
	du dossier DopamineTown.Shops avec les attributs
	  ShopId       "Pets" | "Kitchen" | "Furniture" | "Setup" | "Garden" | "Toys" | "Cars"
	  ShopName     clé anglaise de l'enseigne (le client traduit)
	  ShopKind     "Items" | "Cars"
	  InteriorCF   CFrame : centre du SOL intérieur (dessus du plancher),
	               mêmes axes que `cf` (LookVector vers la rue / la porte)
	  InteriorSize Vector3 (largeur, hauteur sous plafond, profondeur)
	  DoorCF       CFrame : seuil de la porte (sol), LookVector vers la rue
	  AllowCars    (concession seulement) les voitures peuvent entrer
	  ShowroomSlots (concession) nombre de plateaux "CarSlot_<n>"
	Les vantaux vitrés s'appellent "DoorPanel" (attribut SlideX : de combien
	de studs le client les fait glisser le long de leur axe X pour ouvrir) ;
	ils ne bloquent jamais (CanCollide false).
	Aucune vraie lumière ici (l'intérieur a ses ≤ 2 lampes côté client).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WorldLayout = require(ReplicatedStorage.Shared.WorldLayout)
local TownKit = require(script.Parent.TownKit)
local TownBuildings = require(script.Parent.TownBuildings)

local TownShops = {}

local M = TownKit.M
local C = TownKit.C
local part = TownKit.Part

-- Gabarit des boutiques de la place (tient 6 fois dans la couronne, quel
-- que soit le nombre de parcelles : voir TownPlaza.shopRing)
TownShops.W = 30
TownShops.D = 24
local FLOOR_TOP = 0.2 -- dessus du plancher (léger seuil depuis le trottoir)
local CEIL = 11.4 -- dessous du plafond
local WALL_TOP = 12.6 -- haut des murs du rez-de-chaussée (dans le corps de l'étage)
local BODY_Y = 12.5 -- bas du corps de l'étage
local UPPER_H = TownBuildings.FLOOR_H -- un étage au-dessus (non visitable)
local DOOR_W = 6
local DOOR_H = 9
local WIN_X0, WIN_X1 = 4.5, 12.6 -- vitrines (de chaque côté de la porte)
local WIN_Y0 = 1.8

export type ShopSpec = {
	Id: string,
	Sign: string,
	Icon: string,
	Wall: Color3,
	Material: Enum.Material,
	Front: Color3, -- devanture (piliers, bandeau)
	Trim: Color3,
	Awning: { Color3 },
	Roof: string, -- "Gable" | "Flat"
	RoofColor: Color3,
	SignColor: Color3,
	Shutters: Color3?,
}

-- Ordre = ordre de placement autour de la place (depuis l'avenue)
TownShops.SPECS = {
	{ Id = "Pets", Sign = "🐾 Pet Shop", Icon = "🐾", Wall = Color3.fromRGB(255, 228, 204), Material = M.Plaster, Front = Color3.fromRGB(86, 164, 146),
		Trim = C.White, Awning = { Color3.fromRGB(112, 200, 172), C.White }, Roof = "Gable", RoofColor = Color3.fromRGB(150, 98, 90),
		SignColor = Color3.fromRGB(226, 110, 60), Shutters = Color3.fromRGB(112, 190, 170) },
	{ Id = "Toys", Sign = "🧸 Toy Shop", Icon = "🧸", Wall = Color3.fromRGB(255, 216, 156), Material = M.Plaster, Front = Color3.fromRGB(236, 104, 140),
		Trim = C.White, Awning = { Color3.fromRGB(255, 150, 96), Color3.fromRGB(255, 238, 130) }, Roof = "Gable", RoofColor = Color3.fromRGB(168, 92, 122),
		SignColor = Color3.fromRGB(236, 72, 140), Shutters = Color3.fromRGB(120, 180, 250) },
	{ Id = "Kitchen", Sign = "🍰 Kitchen & Home", Icon = "🍰", Wall = Color3.fromRGB(255, 238, 236), Material = M.Brick, Front = Color3.fromRGB(206, 84, 104),
		Trim = C.White, Awning = { Color3.fromRGB(236, 112, 132), C.White }, Roof = "Gable", RoofColor = Color3.fromRGB(116, 108, 140),
		SignColor = Color3.fromRGB(206, 70, 96), Shutters = Color3.fromRGB(150, 206, 180) },
	{ Id = "Furniture", Sign = "🛋️ Furniture & Decor", Icon = "🛋️", Wall = Color3.fromRGB(240, 228, 212), Material = M.Plaster, Front = Color3.fromRGB(118, 94, 78),
		Trim = Color3.fromRGB(255, 250, 240), Awning = { Color3.fromRGB(190, 146, 108), C.Cream }, Roof = "Flat", RoofColor = Color3.fromRGB(120, 110, 100),
		SignColor = Color3.fromRGB(118, 84, 60) },
	{ Id = "Setup", Sign = "🖥️ Setup Store", Icon = "🖥️", Wall = Color3.fromRGB(88, 80, 124), Material = M.Brick, Front = Color3.fromRGB(44, 40, 66),
		Trim = Color3.fromRGB(214, 210, 236), Awning = { Color3.fromRGB(78, 68, 136), Color3.fromRGB(120, 214, 250) }, Roof = "Flat", RoofColor = Color3.fromRGB(70, 66, 90),
		SignColor = Color3.fromRGB(90, 70, 200) },
	{ Id = "Garden", Sign = "🪴 Garden Centre", Icon = "🪴", Wall = Color3.fromRGB(218, 238, 208), Material = M.Plaster, Front = Color3.fromRGB(84, 138, 88),
		Trim = C.White, Awning = { Color3.fromRGB(126, 192, 112), C.White }, Roof = "Gable", RoofColor = Color3.fromRGB(104, 128, 92),
		SignColor = Color3.fromRGB(64, 140, 80), Shutters = Color3.fromRGB(236, 150, 170) },
} :: { ShopSpec }

TownShops.DEALER = { Id = "Cars", Sign = "🚗 Car Dealership", Icon = "🚗" }
TownShops.DEALER_W = WorldLayout.DEALER_W -- (v9.8) 44 -> 70
TownShops.DEALER_D = WorldLayout.DEALER_D -- (v9.8) 48 -> 50

local GLASS = Color3.fromRGB(196, 228, 246)

local function glass(parent: Instance, name: string, size: Vector3, cf: CFrame, transparency: number): BasePart
	-- (vitre : bloque les avatars, ne gêne pas les rayons de la caméra)
	local g = part(parent, name, size, cf, GLASS, M.Glass, "prop")
	g.Transparency = transparency
	g.Reflectance = 0.12
	return g
end

-- Boîte entre deux coins (repère `cf`)
local function box(parent: Instance, name: string, cf: CFrame, x0: number, x1: number, y0: number, y1: number, z0: number, z1: number, color: Color3, material: Enum.Material, profile: string?): BasePart
	return part(parent, name, Vector3.new(x1 - x0, y1 - y0, z1 - z0), cf * CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2), color, material, profile)
end

-- Vantail vitré coulissant (le client le fait glisser de `slide` studs sur X)
local function doorPanel(parent: Instance, cf: CFrame, w: number, h: number, slide: number): BasePart
	local panel = part(parent, "DoorPanel", Vector3.new(w, h, 0.15), cf, GLASS, M.Glass, "deco")
	panel.Transparency = 0.45
	panel.Reflectance = 0.15
	panel:SetAttribute("SlideX", slide)
	return panel
end

-- Petit panneau texte (SurfaceGui) traduisible
local function plaque(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, text: string, textColor: Color3, pps: number, maxDistance: number): BasePart
	local board = part(parent, name, size, cf, color, M.SmoothPlastic, "deco")
	local _, body = TownKit.Surface(board, Enum.NormalId.Front, pps, nil, maxDistance, 0.3)
	TownKit.Label(body, "Text", text, 0.06, 0.1, 0.88, 0.8, textColor, Enum.Font.FredokaOne, true)
	return board
end

-- Store rayé au-dessus d'une vitrine (lames inclinées + lambrequin)
local function awning(parent: Instance, cf: CFrame, x0: number, x1: number, top: number, colors: { Color3 })
	local width = x1 - x0
	local n = math.max(2, math.floor(width / 2.6 + 0.5))
	local sw = width / n
	local tilt = CFrame.Angles(math.rad(22), 0, 0)
	for i = 1, n do
		local x = x0 + (i - 0.5) * sw
		part(parent, "Awning", Vector3.new(sw, 0.2, 3.2), cf * CFrame.new(x, top - 0.6, -1.58) * tilt, colors[i % 2 + 1], M.Fabric, i == 1 and "decoS" or "deco")
	end
	part(parent, "Valance", Vector3.new(width, 0.6, 0.12), cf * CFrame.new((x0 + x1) / 2, top - 1.5, -3.06), colors[1], M.Fabric, "deco")
end

local function attributes(model: Model, spec: { Id: string, Sign: string, Icon: string }, kind: string, interiorCF: CFrame, size: Vector3, doorCF: CFrame)
	model:SetAttribute("ShopId", spec.Id)
	model:SetAttribute("ShopName", spec.Sign)
	model:SetAttribute("ShopIcon", spec.Icon)
	model:SetAttribute("ShopKind", kind)
	model:SetAttribute("InteriorCF", interiorCF)
	model:SetAttribute("InteriorSize", size)
	model:SetAttribute("DoorCF", doorCF)
end

----------------------------------------------------------------------
-- Boutique de la place (coque visitable, ≈ 75 pièces)
----------------------------------------------------------------------

function TownShops.Shop(parent: Instance, cf: CFrame, spec: ShopSpec, seed: number): Model
	local model = TownKit.Model(parent, "Shop_" .. spec.Id)
	local W, D = TownShops.W, TownShops.D
	local hw = W / 2
	local wall, mat, front, trim = spec.Wall, spec.Material, spec.Front, spec.Trim
	local height = BODY_Y + UPPER_H
	-- plancher (léger retrait : aucune face collée à la façade)
	box(model, "Floor", cf, -hw + 0.1, hw - 0.1, FLOOR_TOP - 1.2, FLOOR_TOP, 0.1, D - 0.1, C.StoneDark, M.Concrete, "solid")
	box(model, "Threshold", cf, -DOOR_W / 2 - 0.1, DOOR_W / 2 + 0.1, FLOOR_TOP - 0.5, FLOOR_TOP - 0.02, -0.4, 0.3, C.MetalLight, M.Metal, "solid")
	-- murs de côté (pilastres de la façade) et du fond
	for _, sx in ipairs({ -1, 1 }) do
		box(model, "SideWall", cf, sx < 0 and -hw or hw - 1, sx < 0 and -hw + 1 or hw, 0, WALL_TOP, 0, D, wall, mat, "solid")
	end
	box(model, "BackWall", cf, -hw + 1, hw - 1, 0, WALL_TOP, D - 1, D, wall, mat, "solid")
	-- plafond (déborde dans les murs : pas de face collée)
	box(model, "Ceiling", cf, -hw + 0.9, hw - 0.9, CEIL, BODY_Y + 0.2, 0.9, D - 0.9, wall, mat, "solid")
	-- devanture : piliers, allèges, bandeau au-dessus des vitrines et de la porte
	local doorTop = FLOOR_TOP + DOOR_H
	for _, sx in ipairs({ -1, 1 }) do
		local function sbox(name: string, a: number, b: number, y0: number, y1: number)
			local x0, x1 = sx * a, sx * b
			box(model, name, cf, math.min(x0, x1), math.max(x0, x1), y0, y1, -0.1, 1, front, M.WoodPlanks, "solid")
		end
		sbox("Pier", WIN_X1, hw - 1.04, 0, WALL_TOP) -- (fente de 0,04 : aucune face collée au mur)
		sbox("Sill", WIN_X0, WIN_X1, 0, WIN_Y0)
		sbox("DoorPier", DOOR_W / 2, WIN_X0, 0, doorTop)
		-- vitrine : grande vitre (solide), meneau, traverse, appui extérieur
		local cx = sx * (WIN_X0 + WIN_X1) / 2
		local ww = WIN_X1 - WIN_X0
		glass(model, "ShopWindow", Vector3.new(ww - 0.1, doorTop - WIN_Y0 - 0.1, 0.2), cf * CFrame.new(cx, (WIN_Y0 + doorTop) / 2, 0.45), 0.62)
		part(model, "Mullion", Vector3.new(0.25, doorTop - WIN_Y0 - 0.04, 0.5), cf * CFrame.new(cx, (WIN_Y0 + doorTop) / 2, 0.45), front, M.Wood, "deco")
		part(model, "Transom", Vector3.new(ww - 0.1, 0.25, 0.5), cf * CFrame.new(cx, doorTop - 1.7, 0.45), front, M.Wood, "deco")
		box(model, "WindowSill", cf, cx - ww / 2 - 0.3, cx + ww / 2 + 0.3, WIN_Y0 - 0.3, WIN_Y0 - 0.02, -0.55, -0.12, trim, M.Concrete, "deco")
		-- store rayé au-dessus de la vitrine
		awning(model, cf, cx - ww / 2 - 0.2, cx + ww / 2 + 0.2, doorTop + 0.6, spec.Awning)
		-- plante en pot de chaque côté de la porte
		local pot = (cf * CFrame.new(sx * (DOOR_W / 2 + 0.9), 0, -1.1)).Position
		TownKit.Column(model, "Pot", pot, 1.3, 1.3, Color3.fromRGB(214, 130, 96), M.Concrete, "prop")
		TownKit.Ball(model, "Shrub", pot + Vector3.new(0, 2.1, 0), 1.9, C.GrassDark, M.Grass, "deco")
	end
	box(model, "Header", cf, -WIN_X1, WIN_X1, doorTop, WALL_TOP, -0.1, 1, front, M.WoodPlanks, "solid")
	-- porte : encadrement, deux vantaux vitrés coulissants, auvent, plaque "Entrez"
	box(model, "DoorFrame", cf, -DOOR_W / 2 - 0.4, DOOR_W / 2 + 0.4, doorTop, doorTop + 0.3, -0.35, -0.15, trim, M.Metal, "deco")
	for _, sx in ipairs({ -1, 1 }) do
		doorPanel(model, cf * CFrame.new(sx * DOOR_W / 4, FLOOR_TOP + (DOOR_H - 0.1) / 2, 0.3), DOOR_W / 2 - 0.05, DOOR_H - 0.1, sx * (DOOR_W / 2 - 0.2))
	end
	part(model, "DoorCanopy", Vector3.new(DOOR_W + 1.4, 0.3, 2.4), cf * CFrame.new(0, doorTop + 0.5, -1.25), spec.Awning[1], M.Metal, "deco")
	plaque(model, "OpenSign", Vector3.new(1.3, 1.5, 0.1), cf * CFrame.new(DOOR_W / 2 + 0.75, FLOOR_TOP + 5.4, -0.2), C.White, "Come in!", spec.SignColor, 60, 60)
	-- enseigne (texte traduit côté client : attribut LocText)
	local signW = W * 0.64
	box(model, "SignFrame", cf, -signW / 2 - 0.4, signW / 2 + 0.4, doorTop + 0.85, WALL_TOP - 0.05, -0.35, -0.15, trim, M.Wood, "deco")
	local board = part(model, "SignBoard", Vector3.new(signW, WALL_TOP - doorTop - 1.4, 0.2), cf * CFrame.new(0, (doorTop + 0.85 + WALL_TOP - 0.05) / 2, -0.42), C.Cream, M.SmoothPlastic, "deco")
	local _, body = TownKit.Surface(board, Enum.NormalId.Front, 30, nil, 360, 0.2)
	local label = TownKit.Label(body, "Title", spec.Sign, 0.03, 0.06, 0.94, 0.88, spec.SignColor, Enum.Font.FredokaOne, true)
	local stroke = Instance.new("UIStroke")
	stroke.Color = C.White
	stroke.Thickness = 2
	stroke.Parent = label
	-- étage (non visitable) : corps plein, bandeau, fenêtres, enseigne en drapeau
	part(model, "Body", Vector3.new(W, height - BODY_Y, D), cf * CFrame.new(0, (BODY_Y + height) / 2, D / 2), wall, mat, "solid")
	part(model, "Band", Vector3.new(W + 0.6, 0.6, 0.7), cf * CFrame.new(0, BODY_Y + 0.35, -0.05), trim, M.Concrete, "deco")
	for i = 1, 3 do
		local x = -hw + (i - 0.5) * W / 3
		TownBuildings.Window(model, cf * CFrame.new(x, BODY_Y + UPPER_H / 2 + 0.6, 0), 3.2, 4.4, trim, spec.Shutters, (i + seed) % 2 == 0, seed + i)
	end
	local blade = cf * CFrame.new(hw - 2.2, BODY_Y + 2.8, -2.2)
	part(model, "BladeBracket", Vector3.new(0.25, 0.25, 3.2), cf * CFrame.new(hw - 2.2, BODY_Y + 4.3, -1.6), C.Metal, M.Metal, "deco")
	local flag = part(model, "BladeSign", Vector3.new(0.3, 2.6, 2.6), blade, C.Cream, M.Wood, "deco")
	for _, face in ipairs({ Enum.NormalId.Left, Enum.NormalId.Right }) do
		local _, fb = TownKit.Surface(flag, face, 40, spec.Awning[1], 200, 0.3)
		TownKit.Corner(fb, 20)
		TownKit.Label(fb, "Icon", spec.Icon, 0.12, 0.12, 0.76, 0.76, C.White, Enum.Font.FredokaOne, false)
	end
	-- corniche + toit
	part(model, "Cornice", Vector3.new(W + 1.2, 1, D + 1.2), cf * CFrame.new(0, height + 0.5, D / 2), trim, M.Concrete, "decoS")
	local top = cf * CFrame.new(0, height + 1, 0)
	if spec.Roof == "Gable" then
		TownBuildings.GableRoof(model, top, W, D, math.min(9, D * 0.4), spec.RoofColor)
		part(model, "Chimney", Vector3.new(2, 5, 2), top * CFrame.new(-W * 0.3, 4.5, D * 0.7), Color3.fromRGB(176, 110, 96), M.Brick, "deco")
	else
		part(model, "Parapet", Vector3.new(W + 1.2, 1.4, 0.6), top * CFrame.new(0, 0.7, -0.3), trim, M.Concrete, "deco")
		part(model, "RoofUnit", Vector3.new(4, 2.4, 3), top * CFrame.new(W * 0.25, 1.2, D * 0.6), C.MetalLight, M.DiamondPlate, "deco")
	end
	part(model, "Drainpipe", Vector3.new(0.4, height, 0.4), cf * CFrame.new(-hw + 0.5, height / 2, -0.3), C.MetalLight, M.Metal, "deco")
	attributes(model, spec, "Items", cf * CFrame.new(0, FLOOR_TOP, D / 2), Vector3.new(W - 2, CEIL - FLOOR_TOP, D - 2), cf * CFrame.new(0, FLOOR_TOP, 0))
	return model
end

----------------------------------------------------------------------
-- 🚗 Concession auto (v9.8, CARS98) : GRAND hall vitré 70 x 50, hors de la
-- porte, à gauche de la route d'arrivée (WorldLayout.DealershipCFrame) ;
-- coque seulement (≈ 65 pièces) : tout le décor (plateau tournant animé,
-- couronnes lumineuses, podiums, pupitres, bureau de vente + vendeur·se,
-- salon, drapeaux, voitures) est construit par le client
-- (Client/World/DealerShowroom, via ShopInteriors).
----------------------------------------------------------------------

local DEALER_H = 16 -- hauteur du hall
local CAR_DOOR = 14 -- largeur de la porte (voitures)
local CAR_DOOR_H = 11
local APRON_Y = WorldLayout.ROAD_Y + 0.05 - WorldLayout.WALK_Y -- dessus du parvis (repère de la façade)
TownShops.DEALER_H = DEALER_H
TownShops.DEALER_SLOTS = 8
TownShops.TURNTABLE = Vector3.new(-14, 0.35, -18) -- plateau tournant (repère de la façade)
TownShops.TURNTABLE_R = 8

-- Places des 8 voitures (repère du hall : x, z du centre, lacet en degrés)
-- 2 rangées de 4 de part et d'autre d'une large allée centrale (porte ->
-- bureau de vente) ; podiums de 13 studs, voitures tournées vers l'allée
local SLOT_X = { -24, -10, 10, 24 }
local SLOT_Z = { 15, 33 }

function TownShops.SlotFrames(cf: CFrame): { CFrame }
	local list = {}
	for row, z in ipairs(SLOT_Z) do
		for i, x in ipairs(SLOT_X) do
			local yaw = (i <= 2 and -1 or 1) * (row == 1 and 22 or 16)
			table.insert(list, cf * CFrame.new(x, FLOOR_TOP + 0.35, z) * CFrame.Angles(0, math.rad(yaw), 0))
		end
	end
	return list
end

function TownShops.Dealership(parent: Instance, cf: CFrame): Model
	local spec = TownShops.DEALER
	local model = TownKit.Model(parent, "Shop_Cars")
	local W, D, H = TownShops.DEALER_W, TownShops.DEALER_D, DEALER_H
	local hw = W / 2
	local white = Color3.fromRGB(246, 246, 250)
	local frame = Color3.fromRGB(58, 62, 78)
	local accent = Color3.fromRGB(236, 72, 120)
	-- plancher (sur un socle : le pré est plus bas), murs pleins (côté opposé
	-- à la porte de la ville + fond), toit, plafond
	box(model, "Floor", cf, -hw + 0.1, hw - 0.1, FLOOR_TOP - 1.4, FLOOR_TOP, 0.1, D - 0.1, C.StoneDark, M.Concrete, "solid")
	box(model, "BackWall", cf, -hw, hw, 0, H + 0.8, D - 1, D, white, M.SmoothPlastic, "solid")
	box(model, "SideWall", cf, hw - 1, hw, 0, H + 0.8, 1, D - 1, white, M.SmoothPlastic, "solid")
	box(model, "Roof", cf, -hw - 0.6, hw + 0.6, H + 0.5, H + 1.6, -0.8, D + 0.6, white, M.SmoothPlastic, "decoS")
	box(model, "Ceiling", cf, -hw + 0.9, hw - 0.9, H - 0.6, H + 0.55, 0.9, D - 0.9, white, M.SmoothPlastic, "solid")
	for _, sx in ipairs({ -1, 1 }) do
		box(model, "Parapet", cf, sx < 0 and -hw - 0.55 or hw - 0.2, sx < 0 and -hw - 0.2 or hw + 0.55, H + 1.5, H + 2.4, -0.1, D + 0.55, accent, M.SmoothPlastic, "deco")
	end
	box(model, "ParapetBack", cf, -hw - 0.2, hw + 0.2, H + 1.5, H + 2.4, D + 0.2, D + 0.55, accent, M.SmoothPlastic, "deco")
	for k = 0, 2 do
		glass(model, "Skylight", Vector3.new(W * 0.55, 0.5, 6), cf * CFrame.new(-4, H + 1.9, 10 + k * 14), 0.35).CanCollide = false
	end
	box(model, "RoofUnit", cf, 20, 27, H + 1.5, H + 3.6, D - 14, D - 7, C.MetalLight, M.DiamondPlate, "deco")
	-- façade vitrée (côté route) : poteaux, soubassement, vitres, grande porte
	local doorTop = FLOOR_TOP + CAR_DOOR_H
	local glassY0, glassY1 = 1, H - 1.4
	box(model, "Beam", cf, -hw, hw, glassY1, H + 0.6, -0.2, 1, frame, M.Metal, "solid")
	for _, sx in ipairs({ -1, 1 }) do
		box(model, "Post", cf, sx < 0 and -hw or hw - 1, sx < 0 and -hw + 1 or hw, 0, glassY1, -0.2, 1, frame, M.Metal, "solid")
		local x0, x1 = CAR_DOOR / 2 + 0.6, hw - 1
		local a, b = sx * x0, sx * x1
		box(model, "Kick", cf, math.min(a, b), math.max(a, b), 0, glassY0, -0.2, 1, frame, M.Metal, "solid")
		box(model, "DoorPost", cf, sx < 0 and -CAR_DOOR / 2 - 0.6 or CAR_DOOR / 2, sx < 0 and -CAR_DOOR / 2 or CAR_DOOR / 2 + 0.6, 0, glassY1, -0.2, 1, frame, M.Metal, "solid")
		glass(model, "Showcase", Vector3.new(x1 - x0 - 0.1, glassY1 - glassY0, 0.3), cf * CFrame.new(sx * (x0 + x1) / 2, (glassY0 + glassY1) / 2, 0.4), 0.72)
		for k = 1, 3 do
			local mx = sx * (x0 + (x1 - x0) * k / 4)
			part(model, "Mullion", Vector3.new(0.3, glassY1 - glassY0, 0.55), cf * CFrame.new(mx, (glassY0 + glassY1) / 2, 0.4), frame, M.Metal, "deco")
		end
		doorPanel(model, cf * CFrame.new(sx * CAR_DOOR / 4, FLOOR_TOP + (CAR_DOOR_H - 0.1) / 2, 0.35), CAR_DOOR / 2 - 0.05, CAR_DOOR_H - 0.1, sx * (CAR_DOOR / 2 - 0.5))
	end
	box(model, "DoorHeader", cf, -CAR_DOOR / 2, CAR_DOOR / 2, doorTop, doorTop + 0.4, -0.2, 1, frame, M.Metal, "solid")
	glass(model, "Transom", Vector3.new(CAR_DOOR - 0.1, glassY1 - doorTop - 0.4, 0.3), cf * CFrame.new(0, (doorTop + 0.4 + glassY1) / 2, 0.4), 0.72)
	-- auvent d'entrée (dalle en porte-à-faux + 2 colonnes fines)
	box(model, "Canopy", cf, -11, 11, doorTop + 0.9, doorTop + 1.6, -7.5, -0.2, white, M.SmoothPlastic, "decoS")
	box(model, "CanopyEdge", cf, -11.05, 11.05, doorTop + 0.7, doorTop + 0.95, -7.55, -7.3, accent, M.SmoothPlastic, "deco")
	for _, sx in ipairs({ -1, 1 }) do
		TownKit.Column(model, "CanopyPost", (cf * CFrame.new(sx * 10.2, APRON_Y, -6.6)).Position, doorTop + 0.9 - APRON_Y, 0.45, frame, M.Metal, "prop")
	end
	-- côté porte de la ville (x < 0) : mur-rideau vitré
	local side = cf * CFrame.new(-hw + 0.5, 0, 0)
	box(model, "SideKick", side, -0.5, 0.5, 0, glassY0, 1, D - 6, frame, M.Metal, "solid")
	box(model, "SideBeam", side, -0.5, 0.5, glassY1, H + 0.6, 1, D - 6, frame, M.Metal, "solid")
	box(model, "SideBack", side, -0.5, 0.5, 0, H + 0.6, D - 6, D, white, M.SmoothPlastic, "solid")
	glass(model, "SideGlass", Vector3.new(0.3, glassY1 - glassY0, D - 7.1), side * CFrame.new(0, (glassY0 + glassY1) / 2, (1 + D - 6) / 2), 0.72)
	for k = 1, 5 do
		local z = 1 + (D - 7) * k / 6
		part(model, "SideMullion", Vector3.new(0.55, glassY1 - glassY0, 0.3), side * CFrame.new(0, (glassY0 + glassY1) / 2, z), frame, M.Metal, "deco")
	end
	-- enseigne (façade + côté porte de la ville) et bande d'accent
	local sign = part(model, "SignBand", Vector3.new(W * 0.62, 4.2, 0.6), cf * CFrame.new(0, H + 3.7, -0.5), white, M.SmoothPlastic, "decoS")
	local _, sb = TownKit.Surface(sign, Enum.NormalId.Front, 20, nil, 600, 0.2)
	local title = TownKit.Label(sb, "Title", spec.Sign, 0.06, 0.1, 0.88, 0.8, accent, Enum.Font.FredokaOne, true)
	local stroke = Instance.new("UIStroke")
	stroke.Color = C.White
	stroke.Thickness = 2
	stroke.Parent = title
	part(model, "SignStripe", Vector3.new(W + 1.3, 0.5, 0.7), cf * CFrame.new(0, H + 1.85, -0.5), accent, M.SmoothPlastic, "deco")
	local sideSign = part(model, "SideSign", Vector3.new(0.6, 4.2, D * 0.6), cf * CFrame.new(-hw - 0.75, H + 3.7, D * 0.4), white, M.SmoothPlastic, "deco")
	local _, ss = TownKit.Surface(sideSign, Enum.NormalId.Left, 20, nil, 600, 0.2)
	TownKit.Label(ss, "Title", spec.Sign, 0.06, 0.1, 0.88, 0.8, accent, Enum.Font.FredokaOne, true)
	-- podiums des voitures (le client y pose les voitures et les couronnes)
	for index, slotCF in ipairs(TownShops.SlotFrames(cf)) do
		local disc = part(model, "CarSlot_" .. index, Vector3.new(0.35, 13, 13), slotCF * CFrame.new(0, -0.175, 0) * CFrame.Angles(0, 0, math.rad(90)), white, M.Marble, "deco")
		;(disc :: Part).Shape = Enum.PartType.Cylinder
		disc:SetAttribute("CarCF", slotCF)
		disc:SetAttribute("Slot", index)
	end
	model:SetAttribute("ShowroomSlots", TownShops.DEALER_SLOTS)
	model:SetAttribute("AllowCars", true)
	model:SetAttribute("DealerW", W)
	model:SetAttribute("DealerD", D)
	attributes(model, spec, "Cars", cf * CFrame.new(0, FLOOR_TOP, D / 2), Vector3.new(W - 2, H - 0.6 - FLOOR_TOP, D - 2), cf * CFrame.new(0, FLOOR_TOP, 0))
	return model
end

-- Place la concession hors de la porte, à gauche de la route d'arrivée
-- (WorldLayout.DealershipCFrame) : parvis pavé, rampe, allée jusqu'à la
-- route, SOCLE du plateau tournant (le plateau et la voiture qui tourne :
-- client), totem. Réserve la zone (pas d'arbres de TownNature dessus).
function TownShops.BuildDealership(folder: Instance, geo: TownKit.Geo): Model
	local W = TownShops.DEALER_W
	local cf = WorldLayout.DealershipCFrame(geo.Count)
	local model = TownShops.Dealership(folder, cf)
	local hw = W / 2
	local depth = WorldLayout.DEALER_X - 24 -- parvis : de la façade à 24 studs de l'axe de la route
	-- parvis (sans toucher le petit parking d'arrivée, côté porte de la ville)
	local apron = box(model, "Forecourt", cf, -24, hw, APRON_Y - 0.7, APRON_Y, -depth, -0.05, C.Walk, M.Pavement, "solid")
	apron.CastShadow = false
	box(model, "ForecourtSide", cf, -hw, -24, APRON_Y - 0.7, APRON_Y, -12, -0.05, C.Walk, M.Pavement, "solid").CastShadow = false
	-- rampe douce jusqu'au plancher du hall (voitures et avatars)
	TownKit.Wedge(model, "Ramp", Vector3.new(CAR_DOOR, FLOOR_TOP - APRON_Y, 2.6), cf * CFrame.new(0, (FLOOR_TOP + APRON_Y) / 2, -1.35), C.MetalLight, M.Concrete, "solid")
	-- allée jusqu'à la route (asphalte)
	box(model, "Driveway", cf, -12, -2, APRON_Y - 0.7, APRON_Y - 0.02, -(WorldLayout.DEALER_X - 8), -depth, C.Asphalt, M.Asphalt, "solid")
	-- socle du plateau tournant (on marche dessus ; le plateau tourne côté client)
	local t = TownShops.TURNTABLE
	local base = part(model, "TurntableBase", Vector3.new(t.Y - APRON_Y, TownShops.TURNTABLE_R * 2, TownShops.TURNTABLE_R * 2),
		cf * CFrame.new(t.X, (t.Y + APRON_Y) / 2, t.Z) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(58, 62, 78), M.Metal, "solid")
	;(base :: Part).Shape = Enum.PartType.Cylinder
	model:SetAttribute("TurntableCF", cf * CFrame.new(t.X, t.Y, t.Z))
	model:SetAttribute("TurntableR", TownShops.TURNTABLE_R)
	model:SetAttribute("ApronY", APRON_Y)
	-- totem au bord de l'allée
	local totem = cf * CFrame.new(-16, APRON_Y, -(depth - 3)) * CFrame.Angles(0, math.rad(-35), 0)
	part(model, "TotemBase", Vector3.new(3, 1, 1.6), totem * CFrame.new(0, 0.5, 0), C.StoneDark, M.Granite, "prop")
	plaque(model, "Totem", Vector3.new(2.6, 9, 0.9), totem * CFrame.new(0, 5.5, 0), Color3.fromRGB(58, 62, 78), "🚗", C.White, 30, 300)
	-- zones réservées (hall + parvis) : TownNature n'y plante rien
	geo.Reserve(cf * Vector3.new(0, 0, WorldLayout.DEALER_D / 2), math.sqrt(hw ^ 2 + (WorldLayout.DEALER_D / 2) ^ 2) + 4)
	geo.Reserve(cf * Vector3.new(0, 0, -depth / 2), math.max(hw, depth / 2) + 2)
	return model
end

-- Retire les arbres (modèles "Tree*") posés par d'autres modules sur le hall
-- ou le parvis (à appeler APRÈS la nature, comme TownMarket.ClearSite)
function TownShops.ClearDealerSite(decor: Instance, count: number): number
	local cf = WorldLayout.DealershipCFrame(count)
	local hw = TownShops.DEALER_W / 2 + 4
	local depth = WorldLayout.DEALER_X - 24 + 3
	local removed = 0
	for _, d in ipairs(decor:GetDescendants()) do
		if d:IsA("Model") and string.sub(d.Name, 1, 4) == "Tree" and d.Parent and not d:FindFirstAncestor("Shop_Cars") then
			local first = d:FindFirstChildWhichIsA("BasePart", true)
			local p = cf:PointToObjectSpace(first and first.Position or d:GetPivot().Position)
			if math.abs(p.X) <= hw and p.Z >= -depth and p.Z <= WorldLayout.DEALER_D + 4 then
				for _, x in ipairs(d:GetDescendants()) do
					if x:IsA("BasePart") then
						removed += 1
					end
				end
				d:Destroy()
			end
		end
	end
	TownKit.Stats.Parts -= removed
	return removed
end

return TownShops
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="396">
          <Properties>
            <string name="Name">TownStreets</string>
            <string name="Source"><![CDATA[--[[
	TownStreets (ModuleScript)
	Emplacement : ServerScriptService > Services > World > TownStreets

	🛣️ Les rues de Dopamine Town (v9.4) :
	  - BOULEVARD polygonal : un côté droit devant chaque parcelle (et devant
	    l'entrée), chaussée en asphalte 2 voies, ligne médiane en pointillés,
	    lignes de rive, trottoirs surélevés avec bordures, coins en onglet
	    (pas de trou entre deux côtés) ;
	  - AVENUE principale (entrée -> place) façon "rambla" : promenade
	    centrale pavée bordée d'arbres et de lampadaires doubles, une voie de
	    chaque côté, trottoirs ; passage piéton vers la place d'accueil ;
	  - deux RUES latérales (T avec le boulevard) : chaussée, pointillés,
	    trottoirs, passage piéton, ligne d'arrêt, panneau "stop" ;
	  - zones piétonnes (bornes) à l'arrivée sur la place ;
	  - mobilier : arbres d'alignement, lampadaires (quelques vraies
	    lumières), bancs, poubelles, bouches d'incendie, voitures garées.
	Construit une fois par TownMap.Build.
	v9.8 (CITY98) : les rues PLEINES DE VIE. Le serveur note seulement les
	emplacements (TownKit.LifeSpot, 0 pièce) du mobilier que le client
	construit en flux (TownStreetLife : poubelles, bacs de tri, bancs,
	abribus, kiosque, cabines, distributeurs, feux tricolores, passages
	piétons, pistes cyclables, oriflammes, plaques de rue...) et les
	chemins des passants (TownKit.LifePath -> TownPeople).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WorldLayout = require(ReplicatedStorage.Shared.WorldLayout)
local TownKit = require(script.Parent.TownKit)
local TownBuildings = require(script.Parent.TownBuildings)
local TownVehicles = require(script.Parent.TownVehicles) -- (v9.7, VEHICLES97) places de stationnement, 2-roues

local TownStreets = {}

local M = TownKit.M
local C = TownKit.C
local part = TownKit.Part
local hash = TownKit.Hash

local ROAD_Y = WorldLayout.ROAD_Y
local WALK_Y = WorldLayout.WALK_Y
local ROAD_W = WorldLayout.ROAD_W
local WALK_W = WorldLayout.WALK_W

-- Avenue principale (x latéral depuis l'axe)
local PROM = 7 -- demi-largeur de la promenade centrale
local LANE_OUT = 15 -- bord extérieur des voies
local AVE_OUT = LANE_OUT + WALK_W -- bord extérieur des trottoirs (21)
-- Rues latérales
local ST_HALF = WorldLayout.AVENUE_W / 2 -- 8
local ST_WALK = 5
local ST_OUT = ST_HALF + ST_WALK -- 13

-- (v9.7, VEHICLES97 : teintes des voitures garées -> TownVehicles.PARKED_COLORS)

----------------------------------------------------------------------
-- Bandes droites avec trous (croisements)
----------------------------------------------------------------------

-- Pièces le long de x (repère `cf`) de x0 à x1, sans les intervalles `gaps`
-- (v9.6 : `grow` allonge chaque morceau aux deux bouts : une bordure dépasse
-- ainsi du trottoir au lieu d'avoir ses faces d'extrémité confondues)
local function strip(parent: Instance, name: string, cf: CFrame, x0: number, x1: number, z0: number, z1: number, top: number, thick: number, color: Color3, material: Enum.Material, profile: string?, gaps: { { number } }?, grow: number?)
	local ranges = { { x0, x1 } }
	for _, gap in ipairs(gaps or {}) do
		local nextRanges = {}
		for _, r in ipairs(ranges) do
			if gap[2] <= r[1] or gap[1] >= r[2] then
				table.insert(nextRanges, r)
			else
				if gap[1] > r[1] then
					table.insert(nextRanges, { r[1], gap[1] })
				end
				if gap[2] < r[2] then
					table.insert(nextRanges, { gap[2], r[2] })
				end
			end
		end
		ranges = nextRanges
	end
	local g = grow or 0
	for _, r in ipairs(ranges) do
		local len = r[2] - r[1]
		if len > 0.2 then
			local size = Vector3.new(len + 2 * g, thick, math.abs(z1 - z0))
			local pcf = cf * CFrame.new((r[1] + r[2]) / 2, top - thick / 2, (z0 + z1) / 2)
			if profile == "paint" then
				-- (v9.8, CITY98) peinture au sol : construite côté client (TownStreetLife)
				TownKit.LifeSpot("Paint", pcf, 0, size)
			else
				part(parent, name, size, pcf, color, material, profile)
			end
		end
	end
end

-- (v9.8, CITY98) marquage au sol construit côté CLIENT (0 pièce serveur)
local function paint(size: Vector3, cf: CFrame)
	TownKit.LifeSpot("Paint", cf, 0, size)
end

----------------------------------------------------------------------
-- Boulevard
----------------------------------------------------------------------

local function isStreet(geo: TownKit.Geo, slot: number): boolean
	return table.find(geo.Streets, slot) ~= nil
end

local function buildBoulevard(folder: Instance, geo: TownKit.Geo)
	local m = geo.Slots
	local A = geo.Road
	local tanH = math.tan(geo.HalfAngle)
	local hw = ROAD_W / 2
	for k = 0, m - 1 do
		local side = TownKit.Model(folder, "Boulevard_" .. k)
		local F = geo.SideFrame(k, A)
		local junction = isStreet(geo, k)
		local jw = k == 0 and LANE_OUT or ST_HALF
		local innerGaps = junction and { { -jw, jw } } or nil
		-- (v10 LAYOUT10) chaussée, trottoirs et carrefours du boulevard : ceux
		-- du réseau de la grande ville (TownNetwork, WorldLayout.RoadGraph :
		-- les avenues, rues de quartier et la ceinture partent de ses côtés
		-- et de ses coins) ; ici : marquages (client) et mobilier
		-- lignes de rive
		local edgeZ = hw - 1.1
		strip(side, "EdgeLine", F, -(A + edgeZ) * tanH, (A + edgeZ) * tanH, edgeZ - 0.18, edgeZ + 0.18, ROAD_Y + 0.05, 0.1, C.Line, M.SmoothPlastic, "paint")
		strip(side, "EdgeLine", F, -(A - edgeZ) * tanH, (A - edgeZ) * tanH, -edgeZ - 0.18, -edgeZ + 0.18, ROAD_Y + 0.05, 0.1, C.Line, M.SmoothPlastic, "paint", innerGaps)
		-- ligne médiane en pointillés (arrêtée avant les coins et les croisements)
		local limit = A * tanH - 10
		local x = -limit
		while x + 5 <= limit do
			local cx = x + 2.5
			if not (junction and math.abs(cx) < jw + 5) then
				paint(Vector3.new(6, 0.1, 0.4), F * CFrame.new(cx, ROAD_Y + 0.05, 0))
			end
			x += 18
		end
		if junction then
			if k == 0 then
				-- passage piéton : de la place d'accueil à la promenade de l'avenue
				for i = 0, 7 do
					local z = -hw + 1.6 + i * (ROAD_W - 3.2) / 7
					paint(Vector3.new(12, 0.1, 1.1), F * CFrame.new(0, ROAD_Y + 0.05, z))
				end
			else
				-- flèches de tourne-à-gauche / droite : simple ligne "cédez" pointillée
				for i = -3, 3 do
					paint(Vector3.new(1.6, 0.1, 0.4), F * CFrame.new(i * 2.4, ROAD_Y + 0.05, -hw + 3))
				end
			end
		end
		-- mobilier : lampadaires sur le trottoir extérieur, arbres côté intérieur,
		-- une voiture garée le long du trottoir intérieur (un côté sur deux ou presque)
		local half = A * tanH
		for _, lx in ipairs({ -half * 0.5, half * 0.5 }) do
			if not (junction and math.abs(lx) < jw + 8) then
				local base = (F * CFrame.new(lx, WALK_Y, hw + WALK_W - 1.2)).Position
				-- (bras au-dessus de la chaussée ; vraies lumières : devant l'entrée)
				TownKit.Lamp(side, base, TownKit.Facing(F.LookVector), k == 0)
			end
		end
		local treeHalf = (A - hw - WALK_W - 4) * tanH - 8
		local n = math.max(1, math.floor(2 * treeHalf / 34))
		for i = 0, n do
			local tx = -treeHalf + i * (2 * treeHalf) / math.max(1, n)
			if not (junction and math.abs(tx) < jw + 7) then
				local base = (F * CFrame.new(tx, WorldLayout.GROUND_Y, -hw - WALK_W - 4)).Position
				-- (v9.7 NATURE97) boulevard : chênes, érables, peupliers, cerisiers (silhouette ; détails de près côté client)
				TownKit.Tree(side, base, 12 + hash(k, i) * 5, k * 17 + i, ({ "Oak", "Poplar", "Maple", "Oak", "Cherry" })[(i + k) % 5 + 1], { Lawn = true })
			end
		end
		if not (k == 0) then
			-- (v9.7, VEHICLES97) 3 places marquées le long du trottoir intérieur
			-- (voitures alignées, roues sur la chaussée, conduite à droite) ;
			-- budget du serveur : 1 voiture serveur sur un côté sur quatre, les
			-- autres places occupées sont remplies côté client (TownTraffic, en flux)
			local rowHalf = 1.5 * TownVehicles.BAY_LENGTH
			local cx = (hash(k, 5) - 0.5) * half * 0.9
			if junction and math.abs(cx) < jw + 12 + rowHalf then
				cx = (if cx < 0 then -1 else 1) * (jw + 12 + rowHalf)
			end
			if math.abs(cx) + rowHalf < (A - hw) * tanH - 8 then
				TownVehicles.ParkingRow(side, F * CFrame.new(cx, ROAD_Y, -hw + 0.05) * CFrame.Angles(0, math.pi, 0), 3, k * 13 + 5, if k % 4 == 1 then 1 else 0)
			end
		end
		-- bouche d'incendie + poubelle sur le trottoir intérieur
		local hx = half * 0.25
		if k % 2 == 1 and not (junction and math.abs(hx) < jw + 6) then
			TownKit.Hydrant(side, (F * CFrame.new(hx, WALK_Y, -hw - 1.6)).Position)
			TownKit.Bin(side, (F * CFrame.new(hx + 3, WALK_Y, -hw - 1.6)).Position, k % 2 == 0 and Color3.fromRGB(96, 150, 110) or Color3.fromRGB(110, 140, 200))
		end
	end
end

----------------------------------------------------------------------
-- Avenue principale (rambla) et rues latérales
----------------------------------------------------------------------

-- Repère radial : origine au centre, -Z = vers l'extérieur le long de l'emplacement
local function radialFrame(geo: TownKit.Geo, slot: number): CFrame
	local d = geo.Dir(geo.SlotAngle(slot))
	return CFrame.lookAt(geo.Origin, geo.Origin + d)
end

-- Segment radial (s0 -> s1, x0 -> x1) dans le repère radial
local function radialBox(parent: Instance, name: string, R: CFrame, s0: number, s1: number, x0: number, x1: number, top: number, thick: number, color: Color3, material: Enum.Material, profile: string?)
	local size = Vector3.new(math.abs(x1 - x0), thick, math.abs(s1 - s0))
	local cf = R * CFrame.new((x0 + x1) / 2, top - thick / 2, -(s0 + s1) / 2)
	if profile == "paint" then
		-- (v9.8, CITY98) peinture au sol : construite côté client (TownStreetLife)
		TownKit.LifeSpot("Paint", cf, 0, size)
	else
		part(parent, name, size, cf, color, material, profile)
	end
end

local function buildAvenue(folder: Instance, geo: TownKit.Geo)
	local ave = TownKit.Model(folder, "Avenue")
	local R = radialFrame(geo, 0)
	local plazaR = WorldLayout.PLAZA_R
	local s0 = geo.StreetStart
	local roadEdge = geo.Road - ROAD_W / 2
	-- zone piétonne entre la place et le début des voies
	-- (v9.8 z-fighting : 0,03 sous le pavage de la place qu'elle chevauche)
	radialBox(ave, "PedestrianZone", R, plazaR - 2, s0, -AVE_OUT, AVE_OUT, WALK_Y - 0.03, 1.3, C.Paving, M.Cobblestone, "solid")
	-- promenade centrale (pavés roses bordés de pierre)
	radialBox(ave, "Promenade", R, s0, roadEdge, -PROM, PROM, WALK_Y, 1.3, C.Paving, M.Cobblestone, "solid")
	-- (v9.6 z-fighting : bande raccourcie de 0.05 aux bouts, bordures qui
	-- dépassent de 0.05 : plus aucune face confondue avec la promenade)
	radialBox(ave, "PromenadeBand", R, s0 + 0.05, roadEdge - 0.05, -2, 2, WALK_Y + 0.03, 0.2, C.PavingRose, M.Cobblestone, "deco")
	for _, sx in ipairs({ -1, 1 }) do
		radialBox(ave, "PromenadeCurb", R, s0 - 0.05, roadEdge + 0.05, sx * (PROM - 0.8), sx * (PROM + 0.05), WALK_Y + 0.03, 0.4, C.Curb, M.Concrete, "deco")
		-- voie (sens unique) + ligne de rive
		-- (v10 : s'arrêtent au bord du carrefour du boulevard, TownNetwork)
		radialBox(ave, "Lane", R, s0, roadEdge, sx * PROM, sx * LANE_OUT, ROAD_Y, 0.7, C.Asphalt, M.Asphalt, "solid")
		-- trottoir extérieur + bordure
		radialBox(ave, "Sidewalk", R, s0, geo.Inner, sx * LANE_OUT, sx * AVE_OUT, WALK_Y, 1.3, C.Walk, M.Pavement, "solid")
		radialBox(ave, "Curb", R, s0 - 0.05, geo.Inner + 0.05, sx * (LANE_OUT - 0.05), sx * (LANE_OUT + 0.8), WALK_Y + 0.03, 0.4, C.Curb, M.Concrete, "deco")
		-- ligne d'arrêt au bout de la voie + flèche
		radialBox(ave, "StopLine", R, roadEdge - 2.4, roadEdge - 1.8, sx * (PROM + 0.4), sx * (LANE_OUT - 0.4), ROAD_Y + 0.05, 0.1, C.Line, M.SmoothPlastic, "paint")
		-- bornes à l'entrée de la zone piétonne
		for i = 0, 3 do
			local x = sx * (PROM + 1.2 + i * 2.2)
			TownKit.Bollard(ave, (R * CFrame.new(x, WALK_Y, -s0 + 0.8)).Position)
		end
	end
	-- arbres (double rangée) sur la promenade ; entre deux arbres : un
	-- lampadaire ou un banc tourné vers l'axe (le milieu reste libre pour marcher)
	local length = roadEdge - 6 - (s0 + 6)
	-- (pas de 14 studs, 10 intervalles au plus : budget de pièces des grandes villes)
	local n = math.clamp(math.floor(length / 14), 2, 8)
	local lamps = 0
	for i = 0, n do
		local s = s0 + 6 + i * length / n
		for _, sx in ipairs({ -1, 1 }) do
			local base = (R * CFrame.new(sx * (PROM - 2.2), WALK_Y, -s)).Position
			part(ave, "TreeGrate", Vector3.new(3, 0.1, 3), CFrame.new(base + Vector3.new(0, 0.05, 0)), C.Metal, M.DiamondPlate, "deco")
			-- (v9.7 NATURE97) avenue : allée de cerisiers, d'érables et de chênes (détails de près côté client)
			TownKit.Tree(ave, base, 13 + hash(i, sx) * 3, i * 7 + sx, (i % 3 == 1) and "Cherry" or (i % 3 == 2 and "Maple" or "Oak"))
		end
		if i < n then
			local sm = s + length / n / 2
			for _, sx in ipairs({ -1, 1 }) do
				if (i + (sx > 0 and 1 or 0)) % 2 == 0 then
					lamps += 1
					local base = (R * CFrame.new(sx * (PROM - 1.6), WALK_Y, -sm)).Position
					-- (vraies lumières : une sur trois, 4 au plus)
					TownKit.Lamp(ave, base, TownKit.Facing(R.RightVector * -sx), lamps % 3 == 1 and lamps <= 10)
				else
					local benchCF = R * CFrame.new(sx * (PROM - 1.8), WALK_Y, -sm) * CFrame.Angles(0, math.rad(sx * 90), 0)
					TownKit.Bench(ave, benchCF)
					TownKit.LifeSpot("SitBench", benchCF, i * 2 + (sx > 0 and 1 or 0)) -- (v9.8, CITY98) un passant peut s'y asseoir
				end
			end
		end
	end
	-- poubelles / vélos / panneau sur les trottoirs
	TownKit.Bin(ave, (R * CFrame.new(LANE_OUT + 1.6, WALK_Y, -(s0 + 20))).Position)
	TownKit.Bin(ave, (R * CFrame.new(-LANE_OUT - 1.6, WALK_Y, -(s0 + 34))).Position, Color3.fromRGB(110, 140, 200))
	TownKit.Hydrant(ave, (R * CFrame.new(-LANE_OUT - 1.6, WALK_Y, -(s0 + 12))).Position)
	TownKit.RoadSign(ave, (R * CFrame.new(LANE_OUT + 1.2, WALK_Y, -(roadEdge - 8))).Position, 0, Color3.fromRGB(60, 120, 220), "Rect")
	TownKit.RoadSign(ave, (R * CFrame.new(-LANE_OUT - 1.2, WALK_Y, -(s0 + 4))).Position, math.pi, Color3.fromRGB(220, 60, 70))
end

local function buildSideStreet(folder: Instance, geo: TownKit.Geo, slot: number)
	local st = TownKit.Model(folder, "Street_" .. slot)
	local R = radialFrame(geo, slot)
	local plazaR = WorldLayout.PLAZA_R
	local s0 = geo.StreetStart
	local roadEdge = geo.Road - ROAD_W / 2
	radialBox(st, "PedestrianZone", R, plazaR - 2, s0, -ST_OUT, ST_OUT, WALK_Y - 0.03, 1.3, C.Paving, M.Cobblestone, "solid") -- (v9.8 : 0,03 sous la place)
	-- (v10 : jusqu'au bord du carrefour du boulevard, TownNetwork)
	radialBox(st, "Asphalt", R, s0, roadEdge, -ST_HALF, ST_HALF, ROAD_Y, 0.7, C.Asphalt, M.Asphalt, "solid")
	for _, sx in ipairs({ -1, 1 }) do
		radialBox(st, "Sidewalk", R, s0, geo.Inner, sx * ST_HALF, sx * ST_OUT, WALK_Y, 1.3, C.Walk, M.Pavement, "solid")
		radialBox(st, "Curb", R, s0 - 0.05, geo.Inner + 0.05, sx * (ST_HALF - 0.05), sx * (ST_HALF + 0.8), WALK_Y + 0.03, 0.4, C.Curb, M.Concrete, "deco")
		for i = 0, 2 do
			TownKit.Bollard(st, (R * CFrame.new(sx * (1.5 + i * 2.6), WALK_Y, -s0 + 0.8)).Position)
		end
	end
	-- pointillés, passage piéton, ligne d'arrêt
	local s = s0 + 4
	while s + 5 < geo.Inner - 10 do
		radialBox(st, "Dash", R, s, s + 5, -0.2, 0.2, ROAD_Y + 0.05, 0.1, C.Line, M.SmoothPlastic, "paint")
		s += 18
	end
	local zs = geo.Inner - 6
	for i = 0, 5 do
		local x = -ST_HALF + 1.4 + i * (2 * ST_HALF - 2.8) / 5
		radialBox(st, "Zebra", R, zs - 2.5, zs + 2.5, x - 0.55, x + 0.55, ROAD_Y + 0.05, 0.1, C.Line, M.SmoothPlastic, "paint")
	end
	radialBox(st, "StopLine", R, zs - 4.2, zs - 3.6, 0.2, ST_HALF - 0.4, ROAD_Y + 0.05, 0.1, C.Line, M.SmoothPlastic, "paint")
	TownKit.RoadSign(st, (R * CFrame.new(ST_HALF + 1.4, WALK_Y, -(zs - 5))).Position, geo.SlotAngle(slot), Color3.fromRGB(220, 60, 70), "Diamond")
	-- arbres d'alignement + lampadaires
	local length = geo.Inner - 8 - (s0 + 6)
	local n = math.clamp(math.floor(length / 20), 1, 7)
	for i = 0, n do
		local si = s0 + 6 + i * length / n
		for _, sx in ipairs({ -1, 1 }) do
			local base = (R * CFrame.new(sx * (ST_OUT - 1.8), WALK_Y, -si)).Position
			if (i + (sx > 0 and 1 or 0)) % 2 == 0 then
				part(st, "TreeGrate", Vector3.new(2.6, 0.1, 2.6), CFrame.new(base + Vector3.new(0, 0.05, 0)), C.Metal, M.DiamondPlate, "deco")
				TownKit.Tree(st, base, 11 + hash(slot, i) * 4, slot * 31 + i + sx, (i % 2 == 0) and "Birch" or "Oak") -- (v9.7 NATURE97)
			else
				TownKit.Lamp(st, base, TownKit.Facing(R.RightVector * -sx), false)
			end
		end
	end
	-- (v9.7, VEHICLES97) stationnement marqué des deux côtés (conduite à
	-- droite : côté +x vers l'extérieur, côté -x vers la place) ; 1 voiture
	-- serveur, les autres côté client ; camion de livraison devant les
	-- boutiques d'une des deux rues ; trottinettes / scooter sur le trottoir
	TownVehicles.ParkingRow(st, R * CFrame.new(ST_HALF - 0.05, ROAD_Y, -(s0 + length * 0.55)) * CFrame.Angles(0, math.pi / 2, 0), 3, slot * 7 + 1, 1)
	TownVehicles.ParkingRow(st, R * CFrame.new(-ST_HALF + 0.05, ROAD_Y, -(s0 + length * 0.3)) * CFrame.Angles(0, -math.pi / 2, 0), 2, slot * 7 + 2, 0)
	if slot == geo.SideR then
		TownVehicles.DeliveryVan(st, R * CFrame.new(-(ST_HALF - TownVehicles.CURB_GAP - 3.3), ROAD_Y, -(s0 + length * 0.78)) * CFrame.Angles(0, math.pi, 0))
	end
	TownVehicles.TwoWheelers(st, R * CFrame.new(ST_HALF + 1.8, WALK_Y, -(s0 + 15)) * CFrame.Angles(0, math.pi / 2, 0), 3, slot)
end

-- Immeubles des deux côtés d'une rue (façades alignées sur le trottoir)
local function frontage(folder: Instance, geo: TownKit.Geo, slot: number, edge: number, maxPerSide: number)
	local model = TownKit.Model(folder, "Frontage_" .. slot)
	local R = radialFrame(geo, slot)
	local s1 = geo.Inner - 12
	local seed = slot * 37 + 3
	for _, sx in ipairs({ -1, 1 }) do
		local s = geo.StreetStart + 5
		for _ = 1, maxPerSide do
			seed += 1
			local w = 22 + math.floor(hash(seed, 1) * 4) * 2
			if s + w > s1 then
				break
			end
			local d = 16 + math.floor(hash(seed, 2) * 3) * 2
			local floors = hash(seed, 3) < 0.45 and 3 or 2
			local p = (R * CFrame.new(sx * edge, WALK_Y, -(s + w / 2))).Position
			local out = R.RightVector * sx
			TownBuildings.RowHouse(model, CFrame.lookAt(p, p - out), w, d, floors, seed)
			geo.Reserve(p + out * (d / 2), math.sqrt((w / 2) ^ 2 + (d / 2) ^ 2) + 1)
			s += w + 2.5
		end
	end
end

----------------------------------------------------------------------
-- (v9.8, CITY98) VIE DE LA RUE : emplacements du mobilier construit côté
-- CLIENT (TownStreetLife, en flux) et chemins des passants (TownPeople).
-- 0 pièce serveur : TownKit.LifeSpot / LifePath (voir TownKit).
-- Conventions : `cf` au sol (dessus du trottoir ou de la chaussée), avant
-- du mobilier = -Z local (le côté où l'on passe / lit / s'assoit).
----------------------------------------------------------------------

-- Mobilier du trottoir intérieur du boulevard (poids) ; zone "curb" = le
-- long de la bordure (petits objets), "back" = côté pelouse (tourné vers
-- la rue)
local BOULEVARD_MIX = {
	{ "Bin", 20, "curb" },
	{ "Bench", 15, "back" },
	{ "Planter", 11, "back" },
	{ "Recycle", 8, "back" },
	{ "Mailbox", 6, "curb" },
	{ "NewsBox", 6, "curb" },
	{ "Bollards", 5, "curb" },
	{ "PhoneBooth", 3, "back" },
	{ "Vending", 4, "back" },
	{ "SpeedSign", 4, "curb" },
	{ "DogStation", 3, "back" },
	{ "", 15, "" },
}
local MIX_TOTAL = 0
for _, row in ipairs(BOULEVARD_MIX) do
	MIX_TOTAL += row[2] :: number
end

local function pickMix(h: number): (string, string)
	local x = h * MIX_TOTAL
	for _, row in ipairs(BOULEVARD_MIX) do
		x -= row[2] :: number
		if x < 0 then
			return row[1] :: string, row[3] :: string
		end
	end
	return "", ""
end

-- Ligne de l'anneau des passants (trottoir intérieur, à 3,2 de la bordure)
local RING_IN = 3.2

local function lifeBoulevard(geo: TownKit.Geo)
	local m = geo.Slots
	local A = geo.Road
	local tanH = math.tan(geo.HalfAngle)
	local hw = ROAD_W / 2
	local spot = TownKit.LifeSpot
	local rowHalf = 1.5 * TownVehicles.BAY_LENGTH
	for k = 0, m - 1 do
		local F = geo.SideFrame(k, A)
		local junction = isStreet(geo, k)
		local jw = k == 0 and LANE_OUT or ST_HALF
		local half = A * tanH
		local innerHalf = (A - hw) * tanH
		local usable = innerHalf - 10
		local hx = half * 0.25
		-- même rangée de stationnement que buildBoulevard
		local rowX: number? = nil
		if k ~= 0 then
			local cx = (hash(k, 5) - 0.5) * half * 0.9
			if junction and math.abs(cx) < jw + 12 + rowHalf then
				cx = (if cx < 0 then -1 else 1) * (jw + 12 + rowHalf)
			end
			if math.abs(cx) + rowHalf < (A - hw) * tanH - 8 then
				rowX = cx
			end
		end
		-- passage piéton au milieu du côté (face à l'allée de la parcelle, ou
		-- décalé si une rangée de stationnement est là)
		local zebraX: number? = nil
		if not junction then
			-- (côtés impairs : pas à +30, la bouche d'incendie y est)
			for _, zx in ipairs(k % 2 == 1 and { 0, -30 } or { 0, -30, 30 }) do
				if rowX == nil or math.abs(zx - (rowX :: number)) > rowHalf + 10 then
					zebraX = zx
					break
				end
			end
		end
		local zebra = zebraX ~= nil
		local zx = zebraX or 0
		if zebraX then
			spot("Zebra", F * CFrame.new(zx, ROAD_Y, 0), ROAD_W * 10)
			spot("Beacon", F * CFrame.new(zx - 7.2, WALK_Y, -hw - 1.1), k)
			spot("Beacon", F * CFrame.new(zx + 7.2, WALK_Y, hw + 1.1) * CFrame.Angles(0, math.pi, 0), k + 1)
		end
		if rowX then
			spot("ParkMeter", F * CFrame.new(rowX - rowHalf - 1.4, WALK_Y, -hw - 1.1), k)
		end
		-- trottoir intérieur : un emplacement tous les 10,5 studs
		local j = 0
		local x = -usable
		while x <= usable do
			j += 1
			local free = true
			if junction and math.abs(x) < jw + 9 then
				free = false
			elseif k % 2 == 1 and math.abs(x - (hx + 1.5)) < 5 then
				free = false
			elseif zebra and math.abs(x - zx) < 9.5 then
				free = false
			elseif rowX and math.abs(x - (rowX - rowHalf - 1.4)) < 3 then
				free = false
			end
			if free then
				local kind, zone = pickMix(hash(k * 31 + j, 7))
				if kind ~= "" then
					if zone == "curb" then
						spot(kind, F * CFrame.new(x, WALK_Y, -hw - 1.2), k * 100 + j)
					else
						spot(kind, F * CFrame.new(x, WALK_Y, -hw - WALK_W + 1.3) * CFrame.Angles(0, math.pi, 0), k * 100 + j)
					end
				end
			end
			x += 10.5
		end
		-- plaques d'égout (milieu des voies) + avaloirs le long des bordures
		for i = 1, 2 do
			local mx = (hash(k, 40 + i) - 0.5) * half * 1.2
			if not (junction and math.abs(mx) < jw + 6) and not (zebra and math.abs(mx - zx) < 8) then
				spot("Manhole", F * CFrame.new(mx, ROAD_Y, 4.8), k * 10 + i)
			end
			local dx = (i == 1 and -1 or 1) * half * (0.35 + hash(k, 44 + i) * 0.3)
			spot("Drain", F * CFrame.new(dx, ROAD_Y, hw - 0.55) * CFrame.Angles(0, math.pi, 0), k * 10 + i)
		end
		-- trottoir extérieur (côté parcelles) : abribus / colonne d'affiches
		if not junction then
			if k % 3 == 2 then
				spot("BusShelter", F * CFrame.new(-half * 0.5 - 14, WALK_Y, hw + 3.4), k)
				spot("Bin", F * CFrame.new(-half * 0.5 - 22.5, WALK_Y, hw + 1.2) * CFrame.Angles(0, math.pi, 0), k)
			elseif k % 3 == 1 then
				spot("Morris", F * CFrame.new(half * 0.5 + 12, WALK_Y, hw + 3), k)
			end
			-- panneau publicitaire sur la pelouse, derrière les arbres (1 côté sur 2)
			if k % 2 == 0 then
				local bx = (hash(k, 77) - 0.5) * half * 0.8
				local bcf = F * CFrame.new(bx, WorldLayout.GROUND_Y, -hw - WALK_W - 12) * CFrame.Angles(0, math.pi, 0)
				spot("Billboard", bcf, k)
				geo.Reserve(bcf.Position, 9)
			end
		end
	end
	-- chemin des passants : l'anneau du trottoir intérieur (polygone)
	local ring = {}
	local r = (A - hw - RING_IN) / math.cos(geo.HalfAngle)
	for k = 0, m - 1 do
		local a = geo.SlotAngle(k) + geo.HalfAngle
		table.insert(ring, geo.Origin + Vector3.new(math.sin(a) * r, WALK_Y, math.cos(a) * r))
	end
	TownKit.LifePath("Ring", ring, true)
end

-- Repère d'un objet posé côté `sx` d'une rue radiale, face à la chaussée
-- (avant -Z vers l'axe de la rue)
local function faceAxis(R: CFrame, x: number, y: number, s: number): CFrame
	local sx = if x < 0 then -1 else 1
	return R * CFrame.new(x, y, -s) * CFrame.Angles(0, sx * math.pi / 2, 0)
end

local function lifeAvenue(geo: TownKit.Geo)
	local spot = TownKit.LifeSpot
	local R = radialFrame(geo, 0)
	local s0 = geo.StreetStart
	local roadEdge = geo.Road - ROAD_W / 2
	local ringS = geo.Road - ROAD_W / 2 - RING_IN -- (l'anneau traverse l'avenue ici)
	-- pistes cyclables peintes (bord extérieur des voies) + pictogrammes
	local b0, b1 = s0 + 3, ringS - 3.5
	for _, sx in ipairs({ -1, 1 }) do
		spot("BikeLane", R * CFrame.new(sx * (LANE_OUT - 1.3), ROAD_Y, -(b0 + b1) / 2), math.floor(b1 - b0))
		-- passages piétons de l'anneau sur chaque voie
		spot("Zebra", R * CFrame.new(sx * (PROM + LANE_OUT) / 2, ROAD_Y, -ringS) * CFrame.Angles(0, math.pi / 2, 0), math.floor((LANE_OUT - PROM) * 10))
		-- feux tricolores (sur la promenade, avant la ligne d'arrêt)
		spot("TrafficLight", R * CFrame.new(sx * (PROM - 0.8), WALK_Y, -(roadEdge - 1.1)) * CFrame.Angles(0, math.pi, 0), sx > 0 and 1 or 2)
	end
	-- zone piétonne (entre la place et le début des voies) : kiosque à
	-- journaux, distributeurs, terrasse de café, cabine, gens qui discutent
	local plazaR = WorldLayout.PLAZA_R
	local pz = (plazaR + s0) / 2
	spot("Kiosk", faceAxis(R, -(AVE_OUT - 4.5), WALK_Y, pz), 1)
	spot("Vending", faceAxis(R, -(AVE_OUT - 1.5), WALK_Y, pz + 8), 3)
	spot("Terrace", faceAxis(R, AVE_OUT - 5, WALK_Y, pz - 1), 1)
	spot("PhoneBooth", faceAxis(R, AVE_OUT - 1.5, WALK_Y, pz + 9), 2)
	spot("Bin", R * CFrame.new(-(AVE_OUT - 9), WALK_Y, -(pz - 8)), 4)
	spot("Bin", R * CFrame.new(AVE_OUT - 9, WALK_Y, -(pz + 9)), 5)
	spot("Chat", R * CFrame.new(-8, WALK_Y, -(pz - 5)) * CFrame.Angles(0, 0.6, 0), 5)
	spot("Chat", R * CFrame.new(8.5, WALK_Y, -(pz + 7)) * CFrame.Angles(0, -2.2, 0), 6)
	-- trottoirs de l'avenue : petit mobilier près de la bordure (les
	-- passants marchent entre lui et les façades)
	for _, sx in ipairs({ -1, 1 }) do
		local n = 0
		local s = s0 + 9
		while s < ringS - 8 do
			n += 1
			local kinds = { "Bin", "Bollards", "Mailbox", "NewsBox", "Bin", "Planter" }
			local kind = kinds[(n + (sx > 0 and 2 or 0)) % #kinds + 1]
			if kind == "Planter" then
				spot("PlanterSmall", R * CFrame.new(sx * (LANE_OUT + 1.35), WALK_Y, -s), n)
			else
				spot(kind, faceAxis(R, sx * (LANE_OUT + 1.25), WALK_Y, s) * CFrame.Angles(0, math.pi, 0), n)
			end
			s += 19
		end
	end
	-- oriflammes sur les lampadaires de la promenade (mêmes positions que buildAvenue)
	local length = roadEdge - 6 - (s0 + 6)
	local nL = math.clamp(math.floor(length / 14), 2, 8)
	for i = 0, nL - 1 do
		local sm = s0 + 6 + i * length / nL + length / nL / 2
		for _, sx in ipairs({ -1, 1 }) do
			if (i + (sx > 0 and 1 or 0)) % 2 == 0 then
				spot("Banner", R * CFrame.new(sx * (PROM - 1.6), WALK_Y, -sm) * CFrame.Angles(0, sx * math.pi / 2, 0), i)
			end
		end
	end
	-- panneaux des noms de rue au croisement avec le boulevard
	spot("StreetName", R * CFrame.new(LANE_OUT + 4.4, WALK_Y, -(geo.Inner - 1.6)), 1)
	-- (v9.9, CITY99) poteau indicateur au carrefour (vers tous les lieux)
	spot("Direction", R * CFrame.new(-(LANE_OUT + 3.2), WALK_Y, -(geo.Inner - 5)), 330)
	-- chemins : la promenade (de la porte à la place) et la boucle des trottoirs
	local function at(x: number, s: number): Vector3
		return (R * CFrame.new(x, WALK_Y, -s)).Position
	end
	local gateS = geo.Gate - 18 -- (distance depuis le centre, sur l'axe)
	TownKit.LifePath("Promenade", { at(-2.8, gateS), at(-2.8, s0 + 2), at(2.8, s0 + 2), at(2.8, gateS) }, true)
	local walk = AVE_OUT - 3.1
	TownKit.LifePath("AvenueLoop", { at(walk, ringS - 3), at(walk, s0 - 4), at(-walk, s0 - 4), at(-walk, ringS - 3), at(-walk, ringS), at(walk, ringS) }, true)
end

local function lifeSideStreet(geo: TownKit.Geo, slot: number, name: number)
	local spot = TownKit.LifeSpot
	local R = radialFrame(geo, slot)
	local s0 = geo.StreetStart
	local ringS = geo.Road - ROAD_W / 2 - RING_IN
	local zs = geo.Inner - 6
	local length = geo.Inner - 8 - (s0 + 6)
	-- feux tricolores au passage piéton (un par sens) + passage de l'anneau
	spot("TrafficLight", R * CFrame.new(ST_HALF + 1.1, WALK_Y, -(zs - 3.9)) * CFrame.Angles(0, math.pi, 0), 3)
	spot("TrafficLight", R * CFrame.new(-ST_HALF - 1.1, WALK_Y, -(zs + 3.9)), 4)
	spot("Zebra", R * CFrame.new(0, ROAD_Y, -ringS) * CFrame.Angles(0, math.pi / 2, 0), math.floor(2 * ST_HALF * 10))
	spot("StreetName", R * CFrame.new(-(ST_OUT - 0.9), WALK_Y, -(geo.Inner - 1.6)), name)
	spot("Direction", R * CFrame.new(ST_OUT - 1.6, WALK_Y, -(geo.Inner - 5)), 330 + slot) -- (v9.9, CITY99)
	-- mobilier entre les arbres (côté immeubles) : poubelles, bornes, boîte aux lettres
	local n = math.clamp(math.floor(length / 20), 1, 7)
	for i = 0, n - 1 do
		local si = s0 + 6 + (i + 0.5) * length / n
		for _, sx in ipairs({ -1, 1 }) do
			local kinds = { "Bin", "Mailbox", "Bollards", "NewsBox", "Planter" }
			local kind = kinds[(i * 2 + (sx > 0 and 1 or 0) + slot) % #kinds + 1]
			if not (sx > 0 and math.abs(si - (s0 + 15)) < 6) then
				if kind == "Planter" then
					spot("PlanterSmall", R * CFrame.new(sx * (ST_OUT - 0.9), WALK_Y, -si), i)
				else
					spot(kind, faceAxis(R, sx * (ST_OUT - 0.8), WALK_Y, si), slot * 10 + i)
				end
			end
		end
	end
	-- horodateurs au bout des rangées de stationnement (mêmes rangées que buildSideStreet)
	spot("ParkMeter", faceAxis(R, ST_HALF + 1.1, WALK_Y, s0 + length * 0.55 - 1.5 * TownVehicles.BAY_LENGTH - 1.5), slot)
	spot("ParkMeter", faceAxis(R, -ST_HALF - 1.1, WALK_Y, s0 + length * 0.3 + TownVehicles.BAY_LENGTH + 1.5), slot + 1)
	-- plaques d'égout
	for i = 1, 3 do
		spot("Manhole", R * CFrame.new(0, ROAD_Y, -(s0 + 10 + i * length / 3.4)), slot * 10 + i)
	end
	-- étal (fleuriste / bouquiniste) dans la zone piétonne
	local pz = (WorldLayout.PLAZA_R + s0) / 2
	spot(name == 2 and "FlowerStall" or "BookStall", faceAxis(R, -(ST_OUT - 2.4), WALK_Y, pz + 3), slot)
	spot("Chat", R * CFrame.new(4, WALK_Y, -(pz - 4)) * CFrame.Angles(0, 1.2 + slot, 0), slot + 20)
	-- chemin des passants : boucle des deux trottoirs (détour autour des 2-roues)
	local function at(x: number, s: number): Vector3
		return (R * CFrame.new(x, WALK_Y, -s)).Position
	end
	local w = ST_HALF + 1.6
	TownKit.LifePath("Side" .. name, {
		at(w, s0 - 3),
		at(w, s0 + 9),
		at(ST_OUT - 1, s0 + 12),
		at(ST_OUT - 1, s0 + 18),
		at(w, s0 + 21),
		at(w, ringS),
		at(-w, ringS),
		at(-w, s0 - 3),
	}, true)
end

----------------------------------------------------------------------
-- (v9.9, CITY99) ROUTES "100x" : emplacements pour le client (TownRoads,
-- via TownStreetLife ; 0 pièce serveur), par tronçons de 40 studs au plus :
--   RoadSurface (ornières, rustines, fissures), CurbLine (caniveau + nez
--   de bordure arrondi), Pavers (dalles des trottoirs), Arrow / RoadWord /
--   GiveWay (marquages aux carrefours), Direction (poteaux indicateurs).
----------------------------------------------------------------------

local CHUNK = 40

-- Intervalles [x0, x1] privés des trous `gaps`
local function cut(x0: number, x1: number, gaps: { { number } }?): { { number } }
	local ranges = { { x0, x1 } }
	for _, gap in ipairs(gaps or {}) do
		local nextRanges = {}
		for _, r in ipairs(ranges) do
			if gap[2] <= r[1] or gap[1] >= r[2] then
				table.insert(nextRanges, r)
			else
				if gap[1] > r[1] then
					table.insert(nextRanges, { r[1], gap[1] })
				end
				if gap[2] < r[2] then
					table.insert(nextRanges, { gap[2], r[2] })
				end
			end
		end
		ranges = nextRanges
	end
	return ranges
end

-- Bande le long de x (repère `F`), découpée en tronçons : un emplacement
-- `kind` par tronçon, au point (xc, y, z), taille (longueur, sy, sz) ;
-- `turn` : repère retourné (180°) pour les bordures côté intérieur
local function chunks(kind: string, F: CFrame, x0: number, x1: number, y: number, z: number, sy: number, sz: number, seed: number, gaps: { { number } }?, turn: boolean?)
	for _, r in ipairs(cut(x0, x1, gaps)) do
		local len = r[2] - r[1]
		if len > 1 then
			local n = math.max(1, math.ceil(len / CHUNK))
			for i = 0, n - 1 do
				local a = r[1] + i * len / n
				local cf = F * CFrame.new(a + len / n / 2, y, z)
				if turn then
					cf = cf * CFrame.Angles(0, math.pi, 0)
				end
				TownKit.LifeSpot(kind, cf, seed + i * 7, Vector3.new(len / n, sy, sz))
			end
		end
	end
end

local CURB_H = WALK_Y + 0.03 - ROAD_Y -- (hauteur de la bordure au-dessus de l'asphalte)

local function roadsAvenue(geo: TownKit.Geo)
	local R = radialFrame(geo, 0)
	local s0 = geo.StreetStart
	local roadEdge = geo.Road - ROAD_W / 2
	-- repère "le long de l'avenue" : X = vers l'extérieur, Z = R.X
	local function along(x: number, s: number, y: number): CFrame
		return R * CFrame.new(x, y, -s) * CFrame.Angles(0, math.pi / 2, 0)
	end
	local L = roadEdge - s0
	local F0 = along(0, s0 + L / 2, 0)
	for _, sx in ipairs({ -1, 1 }) do
		local laneC = sx * (PROM + LANE_OUT) / 2
		chunks("RoadSurface", along(laneC, s0, 0), 1, L - 1, ROAD_Y, 0, 1, LANE_OUT - PROM, sx * 11 + 5000)
		-- bordures : promenade (chaussée vers +sx) et trottoir (chaussée vers -sx)
		-- (repère "along" : Z = R.X ; la bordure regarde la chaussée par son -Z
		-- local : on retourne le repère quand la chaussée est du côté +R.X)
		chunks("CurbLine", along(sx * (PROM + 0.05), s0, 0), 0.5, L, ROAD_Y, 0, CURB_H, 0, 5100 + sx, nil, sx > 0)
		chunks("CurbLine", along(sx * (LANE_OUT - 0.05), s0, 0), 0.5, geo.Inner - s0, ROAD_Y, 0, CURB_H, 0, 5200 + sx, nil, sx < 0)
		-- (0,3 de marge côté façades : les socles des immeubles avancent un peu)
		local wS = WALK_W - 0.85 - 0.3
		chunks("Pavers", along(sx * (LANE_OUT + 0.85 + wS / 2), s0, 0), 0.5, geo.Inner - s0 - 0.5, WALK_Y, 0, 0, wS, 5300 + sx)
	end
	local _ = F0
	-- flèches : voie montante (+x, vers la porte) : gauche / droite avant la
	-- ligne d'arrêt ; voie descendante (-x, vers la place) : tout droit
	TownKit.LifeSpot("Arrow", R * CFrame.new((PROM + LANE_OUT) / 2 - 1, ROAD_Y, -(roadEdge - 10)), 6)
	TownKit.LifeSpot("Arrow", R * CFrame.new(-(PROM + LANE_OUT) / 2 + 1, ROAD_Y, -(roadEdge - 42)) * CFrame.Angles(0, math.pi, 0), 1)
	TownKit.LifeSpot("RoadWord", R * CFrame.new(-(PROM + LANE_OUT) / 2 + 1, ROAD_Y, -(s0 + 14)) * CFrame.Angles(0, math.pi, 0), 3)
end

local function roadsSideStreet(geo: TownKit.Geo, slot: number)
	local R = radialFrame(geo, slot)
	local s0 = geo.StreetStart
	local roadEdge = geo.Road - ROAD_W / 2
	local function along(x: number, s: number): CFrame
		return R * CFrame.new(x, 0, -s) * CFrame.Angles(0, math.pi / 2, 0)
	end
	local L = roadEdge - s0
	chunks("RoadSurface", along(0, s0), 1, L - 1, ROAD_Y, 0, 2, 2 * ST_HALF, slot * 1000 + 6000)
	for _, sx in ipairs({ -1, 1 }) do
		chunks("CurbLine", along(sx * (ST_HALF - 0.05), s0), 0.5, geo.Inner - s0, ROAD_Y, 0, CURB_H, 0, slot * 1000 + 6100 + sx, nil, sx < 0)
		local wS = ST_WALK - 0.85 - 0.3
		chunks("Pavers", along(sx * (ST_HALF + 0.85 + wS / 2), s0), 0.5, geo.Inner - s0 - 0.5, WALK_Y, 0, 0, wS, slot * 1000 + 6200 + sx)
	end
	-- carrefour avec le boulevard : STOP + flèches gauche / droite (voie
	-- sortante, +x), ZONE 30 à l'entrée de la zone piétonne (voie entrante)
	local zs = geo.Inner - 6
	TownKit.LifeSpot("RoadWord", R * CFrame.new(ST_HALF / 2, ROAD_Y, -(zs - 7)), 1)
	TownKit.LifeSpot("Arrow", R * CFrame.new(ST_HALF / 2, ROAD_Y, -(zs - 14)), 6)
	TownKit.LifeSpot("RoadWord", R * CFrame.new(-ST_HALF / 2, ROAD_Y, -(s0 + 12)) * CFrame.Angles(0, math.pi, 0), 3)
	TownKit.LifeSpot("Arrow", R * CFrame.new(-ST_HALF / 2, ROAD_Y, -(s0 + 22)) * CFrame.Angles(0, math.pi, 0), 1)
end

-- (v9.9, CITY99) pour TownEntrance / TownNature : même découpage en tronçons
TownStreets.Chunks = chunks

function TownStreets.Build(folder: Instance, geo: TownKit.Geo)
	local streets = Instance.new("Folder")
	streets.Name = "Streets"
	streets.Parent = folder
	buildBoulevard(streets, geo)
	buildAvenue(streets, geo)
	buildSideStreet(streets, geo, geo.SideR)
	buildSideStreet(streets, geo, geo.SideL)
	frontage(streets, geo, 0, AVE_OUT + 0.2, 4)
	frontage(streets, geo, geo.SideR, ST_OUT + 0.2, 3)
	frontage(streets, geo, geo.SideL, ST_OUT + 0.2, 3)
	-- (v9.8, CITY98) mobilier de rue + passants : emplacements pour le client
	lifeBoulevard(geo)
	lifeAvenue(geo)
	lifeSideStreet(geo, geo.SideR, 2)
	lifeSideStreet(geo, geo.SideL, 3)
	-- (v9.9, CITY99) routes réalistes (client) ; (v10) le boulevard : TownNetwork
	roadsAvenue(geo)
	roadsSideStreet(geo, geo.SideR)
	roadsSideStreet(geo, geo.SideL)
end

return TownStreets
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="397">
          <Properties>
            <string name="Name">TownVehicles</string>
            <string name="Source"><![CDATA[--[[
	TownVehicles (ModuleScript)
	Emplacement : ServerScriptService > Services > World > TownVehicles

	🚌 Véhicules du décor de Dopamine Town (v9.7, VEHICLES97), appelés aux
	endroits "véhicules" de TownEntrance / TownStreets / TownNature.
	Budget de pièces du serveur serré (ville ≤ ~5000) : le serveur ne pose
	que ce qui doit exister pour tout le monde et coûte peu ;
	le lourd (bus complet avec sièges, vélos à rayons, trottinettes, camion
	de livraison, voitures garées en plus) est construit CÔTÉ CLIENT et en
	flux par TownTraffic à partir de "places" (TownKit.VehicleSpot : 0 pièce),
	avec, pour les gros véhicules, une boîte invisible solide côté serveur.
	  - Bus(parent, cf)            : bus de ville garé (client) + boîte solide ;
	  - FoodTruck(parent, cf)      : food truck "🌮 Taco Party" (serveur,
	                                 version légère ~50 pièces) ;
	  - DeliveryVan(parent, cf)    : camion "📦 Dopa Express" (client) + boîte ;
	  - ParkingRow(parent, rowCF, bays, seed, serverCars)
	                               : places marquées le long d'un trottoir
	                                 (lignes au sol, serveur) + voitures
	                                 alignées, roues sur la chaussée, modèles
	                                 et couleurs variés ; `serverCars`
	                                 voitures construites par le serveur,
	                                 les autres par le client ;
	  - TwoWheelers(parent, cf, n, seed) : trottinettes / scooter garés (client).
	rowCF : au niveau de la chaussée, sur l'arête du trottoir ; LookVector =
	du trottoir vers la chaussée ; les places s'alignent le long de
	RightVector (voitures tournées vers +RightVector : leur côté droit est
	contre le trottoir, conduite à droite).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CarModels = require(ReplicatedStorage.Shared.CarModels)
local VehicleModels = require(ReplicatedStorage.Shared.VehicleModels)
local TownKit = require(script.Parent.TownKit)

local TownVehicles = {}

local M = TownKit.M
local C = TownKit.C
local part = TownKit.Part
local hash = TownKit.Hash

TownVehicles.BAY_LENGTH = 13
TownVehicles.BAY_DEPTH = 6.2
TownVehicles.CURB_GAP = 0.5

-- Modèles garés (≤ 13 studs : tiennent dans une place) et teintes réalistes
TownVehicles.PARKED_KINDS = { "CityCar", "Hatchback", "SUV", "BubbleCar", "CityCar", "Hatchback", "Pickup", "SportsCar", "Van" }
TownVehicles.PARKED_COLORS = {
	Color3.fromRGB(246, 244, 240), -- blanc nacré
	Color3.fromRGB(176, 182, 192), -- gris argent
	Color3.fromRGB(38, 38, 48), -- noir
	Color3.fromRGB(56, 90, 170), -- bleu jean
	Color3.fromRGB(220, 44, 64), -- rouge cerise
	Color3.fromRGB(255, 150, 196), -- rose bonbon
	Color3.fromRGB(130, 200, 255), -- bleu ciel
	Color3.fromRGB(128, 222, 190), -- menthe
	Color3.fromRGB(255, 212, 80), -- jaune
	Color3.fromRGB(186, 156, 246), -- lilas
	Color3.fromRGB(34, 110, 76), -- vert anglais
}

-- Choix stable (même ville à chaque démarrage) d'une voiture garée
function TownVehicles.PickCar(seed: number, index: number): (string, Color3, { [string]: any })
	local kinds, colors = TownVehicles.PARKED_KINDS, TownVehicles.PARKED_COLORS
	-- (graines bien mélangées : deux voitures voisines n'ont presque jamais la même teinte)
	local kind = kinds[math.floor(hash(seed * 1.618 + index * 7.31, 31) * #kinds) % #kinds + 1]
	local color = colors[(math.floor(hash(seed * 2.414 + 3.3, 57) * #colors) + index * 4) % #colors + 1]
	local opts: { [string]: any } = { Detail = "Parked" }
	local roll = hash(seed * 0.707 + index * 5.9, 83)
	if roll < 0.18 then
		opts.Stripe = true
	elseif roll < 0.3 and (kind == "CityCar" or kind == "Hatchback" or kind == "SUV") then
		opts.RoofColor = if color.R + color.G + color.B > 1.8 then Color3.fromRGB(38, 38, 48) else Color3.fromRGB(246, 244, 240)
	end
	return kind, color, opts
end

----------------------------------------------------------------------
-- Places de stationnement marquées + voitures garées
----------------------------------------------------------------------

function TownVehicles.ParkingRow(parent: Instance, rowCF: CFrame, bays: number, seed: number, serverCars: number): Model
	local model = TownKit.Model(parent, "Parking")
	local L, depth = TownVehicles.BAY_LENGTH, TownVehicles.BAY_DEPTH
	local x0 = -bays * L / 2
	-- séparateurs (même blanc / matière que les autres lignes : jamais de z-fighting)
	for i = 0, bays do
		-- (v9.9) ligne fine, dessus à +0,16 : au-dessus des rustines d'enrobé et
		-- des marquages de la chaussée (TownRoads ; TownStreetLife : dessus à +0,12)
		part(model, "BayLine", Vector3.new(0.3, 0.06, depth), rowCF * CFrame.new(x0 + i * L, 0.13, -depth / 2 - 0.05), C.Line, M.SmoothPlastic, "deco")
	end
	-- une place libre (réaliste), les autres occupées
	local empty = math.floor(hash(seed, 7) * bays) % bays
	local placed = 0
	for i = 0, bays - 1 do
		if i ~= empty then
			local kind, color, opts = TownVehicles.PickCar(seed, i)
			local width = CarModels.Dimensions(kind).X
			local cf = rowCF * CFrame.new(x0 + (i + 0.5) * L, 0, -(TownVehicles.CURB_GAP + width / 2)) * CFrame.Angles(0, -math.pi / 2, 0)
			if placed < serverCars then
				TownKit.Car(model, cf, color, kind, opts)
			else
				TownKit.VehicleSpot(model, "Car", cf, { CarId = kind, Color = color, Stripe = opts.Stripe == true, RoofColor = opts.RoofColor })
			end
			placed += 1
		end
	end
	model:SetAttribute("Bays", bays)
	return model
end

----------------------------------------------------------------------
-- Gros véhicules
----------------------------------------------------------------------

-- 🚌 bus de ville garé (portes côté +X) : construit par le client, boîte solide ici
function TownVehicles.Bus(parent: Instance, cf: CFrame): Instance
	local B = VehicleModels.BUS
	local size = Vector3.new(B.W, 8.1, B.L)
	return TownKit.VehicleSpot(parent, "Bus", cf, { Variant = "Full" }, { Size = size, CF = cf * CFrame.new(0, 0.7 + size.Y / 2, 0) })
end

-- 📦 camion de livraison garé : construit par le client, boîte solide ici
function TownVehicles.DeliveryVan(parent: Instance, cf: CFrame): Instance
	local size = Vector3.new(6.6, 7.4, 17)
	return TownKit.VehicleSpot(parent, "DeliveryVan", cf, {}, { Size = size, CF = cf * CFrame.new(0, 0.8 + size.Y / 2, 0) })
end

-- 🌮 food truck (serveur, version légère : visible par tous, solide)
function TownVehicles.FoodTruck(parent: Instance, cf: CFrame, color: Color3?): Model
	local model = VehicleModels.FoodTruck({ Detail = "Light", Color = color, Solid = true })
	model:PivotTo(cf)
	model.Parent = parent
	TownKit.Stats.Parts += tonumber(model:GetAttribute("PartCount")) or 0
	return model
end

-- 🛴 trottinettes / 🛵 scooter garés en épi (client), le long de X de `cf`
function TownVehicles.TwoWheelers(parent: Instance, cf: CFrame, count: number, seed: number)
	local colors = { Color3.fromRGB(64, 200, 170), Color3.fromRGB(255, 132, 184), Color3.fromRGB(126, 196, 255), Color3.fromRGB(255, 208, 72) }
	for i = 0, count - 1 do
		local scooter = hash(seed, 11 + i) < 0.3
		local kind = if scooter then "Scooter" else "KickScooter"
		local spot = cf * CFrame.new(i * (if scooter then 2.4 else 1.6), 0, 0) * CFrame.Angles(0, math.rad((hash(seed, 13 + i) - 0.5) * 16), 0)
		TownKit.VehicleSpot(parent, kind, spot, { Color = colors[(seed + i) % #colors + 1] })
	end
end

return TownVehicles
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="398">
        <Properties>
          <string name="Name">WorldService</string>
          <string name="Source"><![CDATA[--[[
	WorldService (ModuleScript)
	Emplacement : ServerScriptService > Services > WorldService

	🚶 Dopamine Town : mode "on se promène en 3D avec son avatar".
	  - au démarrage : la ville (TownMap) avec une parcelle par joueur
	    possible (WorldLayout.PlotCount(Players.MaxPlayers), 4..50) ;
	    (v10, LAYOUT10) la parcelle est dans le QUARTIER du style de la maison
	    (WorldLayout.PickPlot : chaumières, maisons de ville, lofts, manoirs ;
	    sinon le quartier le plus proche qui a une place) ; après un
	    changement de style, le joueur déménage au bon quartier à sa prochaine
	    entrée en ville s'il y a une place libre ;
	  - chaque joueur reçoit une parcelle à son arrivée (libérée à son
	    départ : panneau remis à "✨ Free plot") ;
	  - les MAISONS sont construites par les clients (HouseBuilder) à partir
	    d'un petit "instantané" de data.House envoyé par ce service (le
	    serveur ne porte pas des dizaines de milliers de Parts) ; il est
	    renvoyé aux joueurs EN VILLE seulement quand il change (signature
	    JSON vérifiée toutes les 1,5 s) ;
	  - entrer en ville : le serveur charge le personnage (LoadCharacter,
	    Players.CharacterAutoLoads reste false) et le pose devant sa porte ;
	    sortir : le personnage est détruit (retour au clicker). Les gains
	    passifs continuent (GameService n'est pas concerné) ;
	  - visites (porte d'un autre joueur), réglage d'ouverture de sa maison
	    (Everyone / Friends / Nobody, défaut Everyone) respecté par le client
	    (porte verrouillée) ET par le serveur (ronde 1 fois / s : un intrus
	    est reposé devant la porte) ;
	  - ❤️ "j'aime" : 1 par maison et par jour, 10 par jour et par visiteur ;
	    le propriétaire gagne 60 s de sa production (30 fois / jour), le
	    visiteur 20 s de la sienne ; compteur sur le panneau de la parcelle ;
	  - s'asseoir sur un meuble (les meubles sont côté client) : le client
	    envoie la position du siège, le serveur la vérifie (pièce de la maison
	    visée, accès autorisé, à portée du personnage) et crée un vrai Seat
	    invisible (CanTouch = false) puis Seat:Sit(humanoid) : la pose assise
	    est répliquée à tout le monde comme un siège normal ; le Seat est
	    détruit dès que le joueur se lève ("stand" : le client demande de le
	    détruire tout de suite, bouton "Se lever") ;
	  - v9.4 : on ARRIVE en ville par la porte d'entrée (TownMap.SpawnCFrame /
	    attribut "EntranceCF" de Workspace.DopamineTown, posé ici s'il manque) ;
	    une visite ou une pièce demandée pose toujours devant la bonne porte.
	Tout est dans des pcall, chaque action a sa limite de fréquence.

	Données : data.Town = { Open, Likes, Visits, LikeDay, Liked = { [UserId] = true },
	LikesGiven, LikedRewards, RewardDay } (WorldLayout.SanitizeTown).

	RemoteFunction World (action, argument) -> (succès, résultat | message) :
	  "enter" { Visit = UserId?, Slot = number? } -> { Plot, Owner, Arrival = "Entrance" | "Door" }
	  "leave" | "home" | "stand" (détruit son siège)
	  "visit" UserId | "room" { Owner = UserId, Slot } | "setOpen" "Everyone" | "Friends" | "Nobody"
	  "like" UserId | "sit" { Owner = UserId, Slot, CFrame, Kind? } | "houses" (-> liste des instantanés)
	RemoteEvent WorldEvent (S -> C) :
	  ("Houses", { instantané, ... }) | ("House", instantané) | ("Gone", UserId)
	  ("Liked", { Owner, By, Likes }) | ("Toast", texte) | ("Spawned", { Slot?, Owner })
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local WorldLayout = require(ReplicatedStorage.Shared.WorldLayout)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local RateLimiter = require(script.Parent.RateLimiter)
local TownMap = require(script.Parent:WaitForChild("World"):WaitForChild("TownMap"))
-- 🌻 jardin de Dopamine 3D (GARDEN3D95) : module facultatif, jamais bloquant
local GardenSnapshot: any = nil
do
	local ok, result = pcall(function()
		return require(ReplicatedStorage.Shared:FindFirstChild("GardenSnapshot") :: ModuleScript)
	end)
	if ok and type(result) == "table" and type(result.From) == "function" then
		GardenSnapshot = result
	end
end

local WorldService = {}

local services

local SNAPSHOT_INTERVAL = 1.5
local PATROL_INTERVAL = 1
local RESPAWN_DELAY = 3
local WALK_SPEED = 22
local SIT_RANGE = 14 -- (studs) distance max personnage -> siège
local SEAT_LIFETIME = 900 -- (s) un siège oublié disparaît
local MAX_ITEMS = 60 -- objets par pièce dans un instantané (garde-fou)

type State = {
	InTown: boolean,
	Plot: number?,
	Seat: Seat?,
	Friends: { [number]: boolean },
	FriendPending: { [number]: boolean },
	Visited: { [number]: boolean },
	Signature: string,
	Loading: boolean,
	Generation: number,
}

local town: TownMap.Town? = nil
local plotOwners: { [number]: Player } = {}
local states: { [Player]: State } = {}

----------------------------------------------------------------------
-- Utilitaires
----------------------------------------------------------------------

local function T(player: Player, text: string, ...): string
	local ok, result = pcall(function(...)
		return services.GameService:T(player, text, ...)
	end, ...)
	if ok and type(result) == "string" then
		return result
	end
	return string.format(text, ...)
end

local function stateOf(player: Player): State
	local state = states[player]
	if not state then
		state = {
			InTown = false,
			Plot = nil,
			Seat = nil,
			Friends = {},
			FriendPending = {},
			Visited = {},
			Signature = "",
			Loading = false,
			Generation = 0,
		}
		states[player] = state
	end
	return state
end

local function dataOf(player: Player): any
	local ok, data = pcall(function()
		return services.DataService:GetData(player)
	end)
	return ok and data or nil
end

local function townOf(player: Player): WorldLayout.TownData?
	local data = dataOf(player)
	if not data then
		return nil
	end
	if type(data.Town) ~= "table" or data.Town.LikeDay ~= WorldLayout.DayNumber(os.time()) then
		data.Town = WorldLayout.SanitizeTown(data.Town, os.time())
	end
	return data.Town
end

local function sizeDefOf(data: any): any
	local house = type(data) == "table" and data.House or nil
	local id = type(house) == "table" and house.Size or nil
	return Config.HouseSizesById[id] or Config.House.Sizes[1]
end

-- (v10, LAYOUT10) parcelle libre dans le quartier du style de la maison
local function pickPlotFor(player: Player): number?
	local current = town
	if not current then
		return nil
	end
	local style = WorldLayout.StyleOf(sizeDefOf(dataOf(player)))
	return WorldLayout.PickPlot(#current.Plots, style, function(index: number): boolean
		return current.Plots[index] ~= nil and plotOwners[index] == nil
	end)
end

local function playerById(userId: any): Player?
	if type(userId) ~= "number" or userId ~= userId then
		return nil
	end
	local ok, player = pcall(Players.GetPlayerByUserId, Players, userId)
	if ok and player and states[player] then
		return player
	end
	return nil
end

local function plotInfo(player: Player): TownMap.PlotInfo?
	local state = states[player]
	local current = town
	if not state or not state.Plot or not current then
		return nil
	end
	return current.Plots[state.Plot]
end

local function characterParts(player: Player): (Model?, Humanoid?, BasePart?)
	local character = player.Character
	if not character or not character.Parent then
		return nil, nil, nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and not root:IsA("BasePart") then
		root = nil
	end
	return character, humanoid, root :: BasePart?
end

local function toast(player: Player, text: string)
	pcall(function()
		Net.Event("WorldEvent"):FireClient(player, "Toast", text)
	end)
end

-- Amitié Roblox (mise en cache ; `wait` = on peut attendre la réponse)
local function isFriend(player: Player, ownerId: number, wait: boolean): boolean
	local state = stateOf(player)
	local cached = state.Friends[ownerId]
	if cached ~= nil then
		return cached
	end
	local function fetch()
		local ok, result = pcall(function()
			return player:IsFriendsWithAsync(ownerId)
		end)
		state.Friends[ownerId] = ok and result == true
		state.FriendPending[ownerId] = nil
	end
	if wait then
		fetch()
		return state.Friends[ownerId] == true
	end
	if not state.FriendPending[ownerId] then
		state.FriendPending[ownerId] = true
		task.spawn(fetch)
	end
	return false
end

local function canEnter(visitor: Player, owner: Player, wait: boolean): boolean
	if visitor == owner then
		return true
	end
	local ownerTown = townOf(owner)
	local mode = ownerTown and ownerTown.Open or WorldLayout.DEFAULT_OPEN
	if mode == "Friends" then
		return WorldLayout.CanEnter(mode, false, isFriend(visitor, owner.UserId, wait))
	end
	return WorldLayout.CanEnter(mode, false, false)
end

----------------------------------------------------------------------
-- Panneaux des parcelles
----------------------------------------------------------------------

local OPEN_ICONS = { Everyone = "🔓", Friends = "👥", Nobody = "🔒" }

local function refreshSign(index: number)
	local current = town
	if not current then
		return
	end
	local plot = current.Plots[index]
	if not plot then
		return
	end
	local owner = plotOwners[index]
	local data = owner and dataOf(owner)
	if not owner or not data then
		pcall(TownMap.SetPlotSign, plot, "✨ Free plot", "", "")
		-- (le client traduit le panneau d'après la clé "LocText")
		pcall(function()
			plot.Title:SetAttribute("LocText", "✨ Free plot")
		end)
		plot.Model:SetAttribute("OwnerId", 0)
		plot.Model:SetAttribute("OwnerName", "")
		plot.Model:SetAttribute("Likes", 0)
		return
	end
	local ownerTown = townOf(owner)
	local size = sizeDefOf(data)
	local likes = ownerTown and ownerTown.Likes or 0
	local visits = ownerTown and ownerTown.Visits or 0
	local open = ownerTown and ownerTown.Open or WorldLayout.DEFAULT_OPEN
	-- 👑 maison la plus aimée du serveur
	local best, bestLikes = nil, 0
	for _, other in pairs(plotOwners) do
		local otherTown = townOf(other)
		if otherTown and otherTown.Likes > bestLikes then
			best, bestLikes = other, otherTown.Likes
		end
	end
	local crown = best == owner and "👑 " or "🏠 "
	pcall(function()
		plot.Title:SetAttribute("LocText", nil)
	end)
	-- (noms Roblox : pas de filtre nécessaire ; titre en anglais neutre + emoji)
	pcall(TownMap.SetPlotSign, plot, crown .. owner.DisplayName,
		string.format("%s %s · 🌊 %s", tostring(size.Icon or "🏠"), tostring(size.Name or ""), tostring(tonumber(data.Rebirths) or 0)),
		string.format("❤️ %s   👀 %s   %s", NumberFormatter.Format(likes), NumberFormatter.Format(visits), OPEN_ICONS[open] or "🔓"))
	plot.Model:SetAttribute("OwnerId", owner.UserId)
	plot.Model:SetAttribute("OwnerName", owner.DisplayName)
	plot.Model:SetAttribute("Likes", likes)
end

----------------------------------------------------------------------
-- Instantanés des maisons
----------------------------------------------------------------------

local function copyPlaced(list: any): { any }
	local placed = {}
	if type(list) ~= "table" then
		return placed
	end
	for _, entry in ipairs(list) do
		if #placed >= MAX_ITEMS then
			break
		end
		if type(entry) == "table" and type(entry.I) == "string" then
			table.insert(placed, {
				I = entry.I,
				X = tonumber(entry.X) or 0.5,
				Y = tonumber(entry.Y) or 0.8,
				S = tonumber(entry.S) or 1,
				Z = tonumber(entry.Z) or 0,
				F = entry.F == true or nil,
				C = type(entry.C) == "string" and entry.C or nil,
				R = WorldLayout.NormalizeRotation(entry.R),
			})
		end
	end
	return placed
end

-- 🌻 jardin de Dopamine (GardenSnapshot.From : petit, stable, sans heure)
local function gardenSnapshotOf(data: any): any?
	local module = GardenSnapshot
	if not module then
		return nil
	end
	local ok, result = pcall(module.From, data)
	return ok and result or nil
end

local function snapshotOf(player: Player): any?
	local data = dataOf(player)
	local state = states[player]
	if not data or not state or type(data.House) ~= "table" then
		return nil
	end
	local house = data.House
	local rooms = {}
	if type(house.Rooms) == "table" then
		for _, room in ipairs(house.Rooms) do
			if type(room) == "table" then
				table.insert(rooms, {
					Id = tostring(room.Id),
					Type = room.Type,
					Slot = tonumber(room.Slot) or 1,
					Wallpaper = room.Wallpaper,
					Floor = room.Floor,
					Trim = room.Trim,
					Mood = room.Mood,
					View = room.View,
					Placed = copyPlaced(room.Placed),
				})
			end
		end
	end
	local garden = {}
	if type(house.Garden) == "table" then
		for _, id in ipairs(house.Garden) do
			if type(id) == "string" then
				table.insert(garden, id)
			end
		end
	end
	local ownerTown = townOf(player)
	return {
		UserId = player.UserId,
		Name = player.Name,
		DisplayName = player.DisplayName,
		Rebirths = tonumber(data.Rebirths) or 0,
		Plot = state.Plot,
		InTown = state.InTown,
		Open = ownerTown and ownerTown.Open or WorldLayout.DEFAULT_OPEN,
		Likes = ownerTown and ownerTown.Likes or 0,
		Visits = ownerTown and ownerTown.Visits or 0,
		Size = house.Size,
		Facade = house.Facade,
		Roof = house.Roof,
		RoofStyle = house.RoofStyle,
		Garden = garden,
		DopamineGarden = gardenSnapshotOf(data),
		Garage = services.CarService ~= nil and services.CarService:GarageSnapshot(player) or false, -- v9.6 🏎️ (GARAGE96)
		Rooms = rooms,
	}
end

local function townPlayers(): { Player }
	local list = {}
	for player, state in pairs(states) do
		if state.InTown and player.Parent then
			table.insert(list, player)
		end
	end
	return list
end

local function fireTown(kind: string, payload: any, except: Player?)
	local remote = Net.Event("WorldEvent")
	for _, player in ipairs(townPlayers()) do
		if player ~= except then
			pcall(remote.FireClient, remote, player, kind, payload)
		end
	end
end

local function allSnapshots(): { any }
	local list = {}
	for player in pairs(states) do
		local ok, snap = pcall(snapshotOf, player)
		if ok and snap then
			table.insert(list, snap)
		end
	end
	return list
end

-- Renvoie l'instantané d'un joueur à la ville s'il a changé
local function pushIfChanged(player: Player, force: boolean?)
	local state = states[player]
	if not state then
		return
	end
	local ok, snap = pcall(snapshotOf, player)
	if not ok or not snap then
		return
	end
	local okJson, signature = pcall(HttpService.JSONEncode, HttpService, snap)
	if not okJson or type(signature) ~= "string" then
		signature = tostring(os.clock())
	end
	if force or signature ~= state.Signature then
		state.Signature = signature
		fireTown("House", snap)
	end
end

----------------------------------------------------------------------
-- Personnage
----------------------------------------------------------------------

local function destroySeat(state: State)
	local seat = state.Seat
	state.Seat = nil
	if seat then
		pcall(seat.Destroy, seat)
	end
end

local function removeCharacter(player: Player)
	local character = player.Character
	if character then
		pcall(function()
			player.Character = nil
		end)
		pcall(character.Destroy, character)
	end
end

-- Porte d'entrée de la ville (TOWN94 : TownMap.SpawnCFrame / "EntranceCF")
local function entranceCFrame(): CFrame
	local current = town
	local spawnFn = (TownMap :: any).SpawnCFrame
	if type(spawnFn) == "function" then
		local ok, cf = pcall(spawnFn)
		if ok and typeof(cf) == "CFrame" then
			return cf
		end
	end
	local folder = current and current.Folder or workspace:FindFirstChild(TownMap.FOLDER_NAME)
	local attribute = folder and folder:GetAttribute("EntranceCF")
	if typeof(attribute) == "CFrame" then
		return attribute
	end
	return current and current.PlazaCFrame or CFrame.new(WorldLayout.Origin() + Vector3.new(0, 4, 0))
end

local function spawnPoint(player: Player, target: Player?): CFrame
	local current = town
	local owner = target or player
	local ownerState = states[owner]
	local data = dataOf(owner)
	if current and ownerState and ownerState.Plot and data then
		local plot = current.Plots[ownerState.Plot]
		return WorldLayout.DoorSpawn(plot.HouseCFrame, sizeDefOf(data))
	end
	return current and current.PlazaCFrame or CFrame.new(WorldLayout.Origin() + Vector3.new(0, 4, 0))
end

local function teleport(player: Player, cf: CFrame)
	local character = player.Character
	if character and character.Parent then
		pcall(function()
			character:PivotTo(cf)
		end)
	end
end

local function spawnCharacter(player: Player, target: CFrame)
	local state = stateOf(player)
	if state.Loading then
		return
	end
	state.Loading = true
	state.Generation += 1
	local generation = state.Generation
	task.spawn(function()
		local current = town
		if current then
			pcall(function()
				player.RespawnLocation = current.Spawn
			end)
		end
		local ok, err = pcall(function()
			player:LoadCharacterAsync()
		end)
		if not ok then
			-- (ancienne API, au cas où)
			ok, err = pcall(function()
				(player :: any):LoadCharacter()
			end)
		end
		state.Loading = false
		if not ok then
			warn("[WorldService] LoadCharacter : " .. tostring(err))
			return
		end
		if not state.InTown or state.Generation ~= generation or not player.Parent then
			removeCharacter(player)
			return
		end
		local character, humanoid = characterParts(player)
		if not character then
			return
		end
		if humanoid then
			pcall(function()
				humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
				humanoid.WalkSpeed = WALK_SPEED
				humanoid.NameDisplayDistance = 0
			end)
			humanoid.Died:Connect(function()
				destroySeat(state)
				task.delay(RESPAWN_DELAY, function()
					if state.InTown and player.Parent and player.Character == character then
						spawnCharacter(player, spawnPoint(player))
					end
				end)
			end)
		end
		teleport(player, target)
	end)
end

----------------------------------------------------------------------
-- Actions
----------------------------------------------------------------------

local function enter(player: Player, argument: any): (boolean, any)
	local state = stateOf(player)
	if not RateLimiter.Check(player, "WorldEnter", 2) then
		return false, T(player, "Slow down!")
	end
	-- (v10, LAYOUT10) style de maison changé : déménagement vers le bon
	-- quartier (seulement à l'entrée en ville, s'il y a une place libre)
	local current = town
	if current and state.Plot and not state.InTown then
		local count = #current.Plots
		local style = WorldLayout.StyleOf(sizeDefOf(dataOf(player)))
		local want = WorldLayout.DistrictForStyle(style)
		local here = WorldLayout.PlotPlaceData(state.Plot, count)
		if here and here.District ~= want then
			local index = pickPlotFor(player)
			local there = index and WorldLayout.PlotPlaceData(index, count)
			if index and there and there.District == want then
				local old = state.Plot :: number
				plotOwners[old] = nil
				plotOwners[index] = player
				state.Plot = index
				refreshSign(old)
				refreshSign(index)
			end
		end
	end
	state.InTown = true
	local target: Player? = nil
	if type(argument) == "table" and argument.Visit ~= nil then
		target = playerById(argument.Visit)
	end
	-- arrivée : par la porte de la ville ; visite / pièce : devant la bonne porte
	local slot = type(argument) == "table" and tonumber(argument.Slot) or nil
	local arrival = (target == nil and slot == nil) and "Entrance" or "Door"
	local spawnAt = arrival == "Entrance" and entranceCFrame() or spawnPoint(player, target)
	spawnCharacter(player, spawnAt)
	-- le nouvel arrivant reçoit toutes les maisons ; les autres apprennent qu'il est là
	pcall(function()
		Net.Event("WorldEvent"):FireClient(player, "Houses", allSnapshots())
	end)
	pushIfChanged(player, true)
	return true, { Plot = state.Plot, Owner = target and target.UserId or player.UserId, Arrival = arrival }
end

local function leave(player: Player): (boolean, any)
	local state = stateOf(player)
	state.InTown = false
	state.Generation += 1
	destroySeat(state)
	removeCharacter(player)
	pushIfChanged(player, true)
	return true, nil
end

local function visit(player: Player, argument: any): (boolean, any)
	local state = stateOf(player)
	if not state.InTown then
		return false, T(player, "Invalid request")
	end
	local owner = playerById(argument)
	if not owner or not states[owner].Plot then
		return false, T(player, "This player has no house here")
	end
	destroySeat(state)
	teleport(player, spawnPoint(player, owner))
	local allowed = canEnter(player, owner, true)
	if owner ~= player and not state.Visited[owner.UserId] then
		state.Visited[owner.UserId] = true
		local ownerTown = townOf(owner)
		if ownerTown then
			ownerTown.Visits += 1
		end
		if states[owner] and states[owner].Plot then
			refreshSign(states[owner].Plot :: number)
		end
		toast(owner, T(owner, "👋 %s is visiting your house!", player.DisplayName))
	end
	return true, { Owner = owner.UserId, Locked = not allowed }
end

local function goRoom(player: Player, argument: any): (boolean, any)
	local state = stateOf(player)
	if not state.InTown or type(argument) ~= "table" then
		return false, T(player, "Invalid request")
	end
	local owner = playerById(argument.Owner)
	local slot = tonumber(argument.Slot)
	if not owner or not states[owner].Plot or not slot or slot ~= slot then
		return false, T(player, "Invalid request")
	end
	if not canEnter(player, owner, true) then
		return false, T(player, "🔒 This house is closed to visitors")
	end
	local data = dataOf(owner)
	local current = town
	if not data or not current then
		return false, T(player, "Loading...")
	end
	local size = sizeDefOf(data)
	slot = math.clamp(math.floor(slot), 1, (tonumber(size.Floors) or 1) * (tonumber(size.Columns) or 1))
	destroySeat(state)
	teleport(player, WorldLayout.RoomSpawn(current.Plots[states[owner].Plot :: number].HouseCFrame, size, slot))
	return true, { Owner = owner.UserId, Slot = slot }
end

local function setOpen(player: Player, argument: any): (boolean, any)
	if type(argument) ~= "string" or not table.find(WorldLayout.OPEN_MODES, argument) then
		return false, T(player, "Invalid request")
	end
	local ownerTown = townOf(player)
	if not ownerTown then
		return false, T(player, "Loading...")
	end
	ownerTown.Open = argument
	local state = stateOf(player)
	if state.Plot then
		refreshSign(state.Plot)
	end
	pushIfChanged(player)
	local texts = {
		Everyone = "🔓 Your house is open to everyone",
		Friends = "👥 Your house is open to your friends only",
		Nobody = "🔒 Your house is closed to visitors",
	}
	return true, T(player, texts[argument])
end

local function like(player: Player, argument: any): (boolean, any)
	local state = stateOf(player)
	local owner = playerById(argument)
	if not state.InTown or not owner or not states[owner].Plot then
		return false, T(player, "Invalid request")
	end
	local likerTown, ownerTown = townOf(player), townOf(owner)
	if not likerTown or not ownerTown then
		return false, T(player, "Loading...")
	end
	-- il faut être venu près de la maison (sur la parcelle ou dedans)
	local _, _, root = characterParts(player)
	local plot = plotInfo(owner)
	if not root or not plot or (root.Position - plot.CFrame.Position).Magnitude > WorldLayout.PLOT_W * 0.75 then
		return false, T(player, "Walk to the house to like it")
	end
	local ok, reason = WorldLayout.CanLike(likerTown, player.UserId, owner.UserId)
	if not ok then
		if reason == "Self" then
			return false, T(player, "That's your own house!")
		elseif reason == "Already" then
			return false, T(player, "❤️ You already liked this house today")
		end
		return false, T(player, "❤️ No likes left today (max %s), come back tomorrow!", tostring(WorldLayout.LIKES_PER_DAY))
	end
	local rewarded = WorldLayout.ApplyLike(likerTown, ownerTown, owner.UserId)
	-- petites récompenses (secondes de production de chacun)
	local okStats, stats = pcall(function()
		return services.GameService:GetStats(player)
	end)
	local gift = okStats and WorldLayout.RewardAmount(stats and stats.PerSecond, WorldLayout.LIKE_REWARD_SECONDS) or 0
	if gift > 0 then
		pcall(function()
			services.GameService:AddDopamine(player, gift, false)
		end)
	end
	if rewarded then
		local okOwner, ownerStats = pcall(function()
			return services.GameService:GetStats(owner)
		end)
		local bonus = okOwner and WorldLayout.RewardAmount(ownerStats and ownerStats.PerSecond, WorldLayout.LIKED_REWARD_SECONDS) or 0
		if bonus > 0 then
			pcall(function()
				services.GameService:AddDopamine(owner, bonus, false)
			end)
		end
		local text = T(owner, "❤️ %s liked your house! (+%s Dopamine)", player.DisplayName, NumberFormatter.Format(bonus))
		if states[owner].InTown then
			toast(owner, text)
		else
			pcall(function()
				services.GameService:Notify(owner, { Type = "Info", Text = text })
			end)
		end
	end
	-- (la couronne 👑 peut changer de maison : tous les panneaux)
	for index in pairs(plotOwners) do
		refreshSign(index)
	end
	pushIfChanged(owner)
	fireTown("Liked", { Owner = owner.UserId, By = player.DisplayName, Likes = ownerTown.Likes })
	local left = WorldLayout.LIKES_PER_DAY - likerTown.LikesGiven
	return true, T(player, "❤️ Liked! +%s Dopamine · %s likes left today", NumberFormatter.Format(gift), tostring(left))
end

local function sit(player: Player, argument: any): (boolean, any)
	local state = stateOf(player)
	if not state.InTown or type(argument) ~= "table" or typeof(argument.CFrame) ~= "CFrame" then
		return false, T(player, "Invalid request")
	end
	local owner = playerById(argument.Owner)
	local slot = tonumber(argument.Slot)
	local current = town
	local gardenSeat = argument.Garden == true -- v9.9 🌷 (PARK99) siège du jardin (construit côté client)
	if not owner or not states[owner].Plot or (not slot and not gardenSeat) or not current then
		return false, T(player, "Invalid request")
	end
	if not canEnter(player, owner, false) then
		return false, T(player, "🔒 This house is closed to visitors")
	end
	local _, humanoid, root = characterParts(player)
	if not humanoid or not root or humanoid.Health <= 0 then
		return false, T(player, "Invalid request")
	end
	local cf = argument.CFrame :: CFrame
	local position = cf.Position
	if position.X ~= position.X or position.Y ~= position.Y or position.Z ~= position.Z then
		return false, T(player, "Invalid request")
	end
	-- le siège est bien dans cette pièce de cette maison (ou, v9.9 PARK99, dans le
	-- jardin de la parcelle du propriétaire, au ras de la pelouse), et à portée
	if gardenSeat then
		local plotCF = current.Plots[states[owner].Plot :: number].CFrame
		local lp = plotCF:PointToObjectSpace(position)
		if math.abs(lp.X) > WorldLayout.PLOT_W / 2 + 1 or math.abs(lp.Z) > WorldLayout.PLOT_D / 2 + 1 or lp.Y < -1 or lp.Y > 6 then
			return false, T(player, "Invalid request")
		end
	else
		local size = sizeDefOf(dataOf(owner))
		local houseCF = current.Plots[states[owner].Plot :: number].HouseCFrame
		local x, y, d = WorldLayout.ToLocal(houseCF, position)
		local xMin, xMax, yFloor, dMin, dMax = WorldLayout.RoomInterior(size, math.floor(slot :: number))
		if x < xMin - 0.5 or x > xMax + 0.5 or d < dMin - 0.5 or d > dMax + 0.5 or y < yFloor - 0.5 or y > yFloor + 7 then
			return false, T(player, "Invalid request")
		end
	end
	if (root.Position - position).Magnitude > SIT_RANGE then
		return false, T(player, "Get closer to sit down")
	end
	destroySeat(state)
	-- orientation : seulement la rotation autour de la verticale
	local look = cf.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.01 then
		flat = Vector3.new(0, 0, -1)
	end
	local seat = Instance.new("Seat")
	seat.Name = "TownSeat_" .. player.UserId
	seat.Size = Vector3.new(2, 0.2, 2)
	seat.Transparency = 1
	seat.CanCollide = false
	seat.CanTouch = false -- personne ne s'assoit dessus par accident
	seat.Anchored = true
	seat.CFrame = CFrame.lookAt(position, position + flat.Unit)
	-- v9.8 🪑 (SEAT98) nature du siège + heure de l'assise : chaque client anime
	-- les joueurs assis avec le même tirage (SitAnimator), sans nouveau remote
	local kind = type(argument.Kind) == "string" and argument.Kind or "seat"
	local kinds = { chair = true, desk = true, stool = true, sofa = true, bed = true, bench = true, seat = true }
	seat:SetAttribute("SitKind", kinds[kind] and kind or "seat")
	seat:SetAttribute("SitAt", workspace:GetServerTimeNow())
	seat:SetAttribute("SitUser", player.UserId)
	seat.Parent = current.Seats
	state.Seat = seat
	local okSit = pcall(seat.Sit, seat, humanoid)
	if not okSit then
		destroySeat(state)
		return false, T(player, "Invalid request")
	end
	seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		if seat.Occupant == nil then
			task.delay(0.3, function()
				if state.Seat == seat and seat.Occupant == nil then
					destroySeat(state)
				elseif state.Seat ~= seat then
					pcall(seat.Destroy, seat)
				end
			end)
		end
	end)
	task.delay(SEAT_LIFETIME, function()
		if state.Seat == seat then
			destroySeat(state)
		end
	end)
	return true, nil
end

local ACTION_INTERVALS = { like = 1, sit = 0.4, stand = 0.3, visit = 1, room = 0.5, setOpen = 0.5, houses = 2, home = 1, leave = 1 }

local function onWorld(player: Player, action: any, argument: any): (boolean, any)
	if type(action) ~= "string" or #action > 16 then
		return false, T(player, "Invalid request")
	end
	local data = dataOf(player)
	if not data or not services.GameService:IsReady(player) or not states[player] then
		return false, T(player, "Loading...")
	end
	if action == "enter" then
		return enter(player, argument)
	end
	local interval = ACTION_INTERVALS[action]
	if not interval then
		return false, T(player, "Invalid request")
	end
	if not RateLimiter.Check(player, "World_" .. action, interval) then
		return false, T(player, "Slow down!")
	end
	if action == "leave" then
		return leave(player)
	elseif action == "home" then
		if not stateOf(player).InTown then
			return false, T(player, "Invalid request")
		end
		destroySeat(stateOf(player))
		teleport(player, spawnPoint(player))
		return true, nil
	elseif action == "visit" then
		return visit(player, argument)
	elseif action == "room" then
		return goRoom(player, argument)
	elseif action == "setOpen" then
		return setOpen(player, argument)
	elseif action == "like" then
		return like(player, argument)
	elseif action == "sit" then
		return sit(player, argument)
	elseif action == "stand" then
		destroySeat(stateOf(player))
		return true, nil
	elseif action == "houses" then
		return true, allSnapshots()
	end
	return false, T(player, "Invalid request")
end

----------------------------------------------------------------------
-- Ronde : intrus, chutes
----------------------------------------------------------------------

local function patrol()
	local current = town
	if not current then
		return
	end
	local originY = WorldLayout.Origin().Y
	for player, state in pairs(states) do
		if state.InTown and not state.Loading then
			local _, humanoid, root = characterParts(player)
			if root and humanoid and humanoid.Health > 0 then
				local position = root.Position
				if position.Y < originY - 40 then
					teleport(player, entranceCFrame())
				else
					for index, owner in pairs(plotOwners) do
						if owner ~= player then
							local plot = current.Plots[index]
							local data = dataOf(owner)
							if plot and data then
								local size = sizeDefOf(data)
								local x, y, d = WorldLayout.ToLocal(plot.HouseCFrame, position)
								-- (maison "Amis" : on attend la réponse de Roblox avant de juger)
								local ownerTown = townOf(owner)
								local pending = ownerTown ~= nil and ownerTown.Open == "Friends" and stateOf(player).Friends[owner.UserId] == nil
								if WorldLayout.InsideHouse(size, x, y, d, -0.8) and not pending and not canEnter(player, owner, false) then
									destroySeat(state)
									teleport(player, WorldLayout.DoorSpawn(plot.HouseCFrame, size))
									toast(player, T(player, "🔒 This house is closed to visitors"))
								end
							end
						end
					end
				end
			end
		end
	end
end

----------------------------------------------------------------------
-- Cycle de vie
----------------------------------------------------------------------

function WorldService:Init(allServices)
	services = allServices
end

function WorldService:Start()
	local okBuild, result = pcall(TownMap.Build, WorldLayout.PlotCount(Players.MaxPlayers))
	if okBuild then
		town = result
	else
		warn("[WorldService] Construction de la ville : " .. tostring(result))
	end
	-- panneaux "✨ Free plot" : tous marqués pour la traduction côté client
	local built = town
	if built then
		for index = 1, #built.Plots do
			if not plotOwners[index] then
				pcall(refreshSign, index)
			end
		end
	end
	-- (le client lit l'entrée pour le survol d'arrivée : posée si TownMap ne l'a pas fait)
	pcall(function()
		local current = town
		if current and typeof(current.Folder:GetAttribute("EntranceCF")) ~= "CFrame" then
			current.Folder:SetAttribute("EntranceCF", entranceCFrame())
		end
	end)
	-- Bulles de chat au-dessus des avatars (réplique aux clients)
	pcall(function()
		local bubbles = TextChatService:FindFirstChildOfClass("BubbleChatConfiguration")
		if bubbles then
			bubbles.Enabled = true
		end
	end)

	Net.Function("World").OnServerInvoke = function(player: Player, action: any, argument: any)
		local ok, success, value = pcall(onWorld, player, action, argument)
		if not ok then
			warn("[WorldService] Erreur pour " .. player.Name .. " :", success)
			return false, T(player, "Invalid request")
		end
		return success, value
	end

	local snapshotClock, patrolClock = 0, 0
	RunService.Heartbeat:Connect(function(dt: number)
		snapshotClock += dt
		patrolClock += dt
		if patrolClock >= PATROL_INTERVAL then
			patrolClock = 0
			local ok, err = pcall(patrol)
			if not ok then
				warn("[WorldService] Ronde : " .. tostring(err))
			end
		end
		if snapshotClock >= SNAPSHOT_INTERVAL then
			snapshotClock = 0
			if #townPlayers() > 0 then
				for player in pairs(states) do
					pushIfChanged(player)
				end
			end
		end
	end)
end

function WorldService:PlayerReady(player: Player, data)
	data.Town = WorldLayout.SanitizeTown(data.Town, os.time())
	local state = stateOf(player)
	local current = town
	if current and not state.Plot then
		local index = pickPlotFor(player)
		if index then
			plotOwners[index] = player
			state.Plot = index
		end
	end
	if state.Plot then
		refreshSign(state.Plot)
	end
	pushIfChanged(player, true)
end

function WorldService:PlayerRemoving(player: Player)
	local state = states[player]
	if not state then
		return
	end
	state.InTown = false
	state.Generation += 1
	destroySeat(state)
	if state.Plot and plotOwners[state.Plot] == player then
		plotOwners[state.Plot] = nil
		refreshSign(state.Plot)
	end
	states[player] = nil
	fireTown("Gone", player.UserId)
end

-- (tests / autres services) le joueur est-il en ville ?
function WorldService:IsInTown(player: Player): boolean
	local state = states[player]
	return state ~= nil and state.InTown
end

return WorldService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="399">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="400">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="401">
        <Properties>
          <string name="Name">ClientMain</string>
          <string name="Source"><![CDATA[--[[
	ClientMain (LocalScript)
	Emplacement : StarterPlayer > StarterPlayerScripts > ClientMain

	Point d'entrée du client : construit toute l'interface en code, lance
	le gestionnaire de stimuli et branche les RemoteEvents. Aucune logique
	de gain ici : le client affiche et envoie des DEMANDES, le serveur décide.
	Un écran de chargement (LoadingScreen) couvre tout jusqu'au premier état.
	v4 : fenêtre "Bon retour !" (gain hors-ligne), panneau "🛠️ Test" et
	commandes de chat de test (/give, /unlockall...) UNIQUEMENT dans Studio.
	v5 : langue (anglais par défaut, français automatique) choisie AVANT de
	construire l'interface : on attend le premier état (3 s au plus) pour
	lire le réglage "Language", sinon langue Roblox du joueur. Mode sombre
	(DarkSkin) appliqué à la colonne centrale, aux fenêtres et aux bandeaux.
	Maison : fenêtre "🏠 Ma maison" (Panels > House), ouverte par le bouton
	🏠 à droite de "Click me" (chargée sans bloquer le reste en cas d'erreur).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local GuiService = game:GetService("GuiService")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")

local Client = ReplicatedStorage:WaitForChild("Client")
local Components = Client:WaitForChild("Components")
local Panels = Components:WaitForChild("Panels")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Net = require(Shared:WaitForChild("Net"))
local Locale = require(Shared:WaitForChild("Locale"))
local Interface = require(Client:WaitForChild("Interface"))
local ClientState = require(Client:WaitForChild("ClientState"))
local SoundManager = require(Client:WaitForChild("SoundManager"))
local DarkSkin = require(Client:WaitForChild("DarkSkin"))
local LoadingScreen = require(Components:WaitForChild("LoadingScreen"))

local FIRST_STATE_WAIT = 3 -- (s) attente max du premier état avant de choisir la langue

-- Le sac à dos (outils) ne sert à rien ici. La liste des joueurs (leaderstats)
-- et la fenêtre de chat recouvriraient les emplacements R1 / L1 et captureraient
-- les clics : le jeu a déjà son propre classement.
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
end)
-- (Dans Studio on garde le chat : il sert à taper les commandes de test /give, /rush...)
if not RunService:IsStudio() then
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, false)
	end)
	pcall(function()
		TextChatService.ChatWindowConfiguration.Enabled = false
	end)
end
-- Pas de joystick / bouton de saut tactiles : ils prendraient les appuis
-- destinés aux emplacements du bas (Runner, Lofi...)
pcall(function()
	GuiService.TouchControlsEnabled = false
end)

-- 1. Services de base
SoundManager.Init()
ClientState.Init()

-- 2. Écran et calques (+ écran de chargement par-dessus, jusqu'au premier état)
Interface.Build()
LoadingScreen.Show()

-- Mode sombre de l'interface (réglage ⚙️, thème sombre ou mode néon)
ClientState.DarkModeChanged:Connect(DarkSkin.SetEnabled)
DarkSkin.SetEnabled(ClientState.DarkMode)

-- 3. Langue : réglage sauvegardé (premier état) sinon langue Roblox du joueur,
-- choisie AVANT de construire l'interface (pas de reconstruction ensuite)
if not ClientState.IsLoaded then
	local received = false
	local connection = ClientState.Loaded:Connect(function()
		received = true
	end)
	local started = os.clock()
	while not received and os.clock() - started < FIRST_STATE_WAIT do
		task.wait(0.05)
	end
	connection:Disconnect()
end
Locale.SetLanguage(ClientState.ResolveLanguage())

-- Modules d'interface (chargés après le choix de la langue)
local Effects = require(Client:WaitForChild("Effects"))
local Slots = require(Client:WaitForChild("Slots"))
local StimulusManager = require(Client:WaitForChild("StimulusManager"))
local Background = require(Components:WaitForChild("Background"))
local Notifications = require(Components:WaitForChild("Notifications"))
local PanelManager = require(Components:WaitForChild("PanelManager"))
local CenterColumn = require(Components:WaitForChild("CenterColumn"))
local OfflinePopup = require(Components:WaitForChild("OfflinePopup"))
local AchievementPopup = require(Components:WaitForChild("AchievementPopup"))
local NeedDopamine = require(Components:WaitForChild("NeedDopamine"))
local DebugTools = require(Components:WaitForChild("DebugTools"))

local layers = Interface.Layers
Effects.Init(layers.Effects)
Background.Build(layers.Background)
DarkSkin.Register(layers.Main)
DarkSkin.Register(layers.Panels)
DarkSkin.Register(layers.Toasts)

-- 4. Toasts et fenêtres
Notifications.Build(layers.Toasts)
OfflinePopup.Build(layers.Toasts)
AchievementPopup.Build(layers.Toasts)
NeedDopamine.Build(layers.Toasts)
require(Components:WaitForChild("OfferPopup")).Build(layers.Toasts) -- 💎 offres Robux discrètes (Config.Monetization.Offers)
PanelManager.Build(layers.Panels)
PanelManager.Register("ScreenTime", require(Panels:WaitForChild("ScreenTime")))
PanelManager.Register("ItemShop", require(Panels:WaitForChild("ItemShop")))
PanelManager.Register("Achievements", require(Panels:WaitForChild("Achievements")))
PanelManager.Register("Quests", require(Panels:WaitForChild("Quests")))
PanelManager.Register("Leaderboard", require(Panels:WaitForChild("Leaderboard")))
PanelManager.Register("Daily", require(Panels:WaitForChild("Daily")))
PanelManager.Register("Settings", require(Panels:WaitForChild("Settings")))
PanelManager.Register("RobuxShop", require(Panels:WaitForChild("RobuxShop")))

-- 🏠 Ma maison : une erreur de chargement ne doit pas bloquer le reste de l'interface
do
	local ok, module = pcall(require, Panels:WaitForChild("House"))
	if ok and type(module) == "table" then
		PanelManager.Register("House", module)
	else
		warn("[ClientMain] Erreur au chargement du panneau House : " .. tostring(module))
	end
end

-- 🕹️ Arcade (mini-jeux, duels) : chargée sans bloquer le reste en cas d'erreur
do
	local arcadeModule = Panels:FindFirstChild("Arcade")
	if arcadeModule and arcadeModule:IsA("ModuleScript") then
		local ok, module = pcall(require, arcadeModule)
		if ok and type(module) == "table" then
			PanelManager.Register("Arcade", module)
		else
			warn("[ClientMain] Erreur au chargement du panneau Arcade : " .. tostring(module))
		end
	end
end

-- 🚶 Dopamine Town (promenade 3D avec son avatar, visites) : chargée sans bloquer le reste
do
	local ok, err = pcall(function()
		require(Client:WaitForChild("World"):WaitForChild("TownClient")).Init()
	end)
	if not ok then
		warn("[ClientMain] Erreur au chargement de Dopamine Town : " .. tostring(err))
	end
end

-- Outils de test : UNIQUEMENT dans Studio (panneau "🛠️ Test" + commandes de chat)
if DebugTools.Enabled then
	local debugModule = Panels:FindFirstChild("Debug")
	if debugModule and debugModule:IsA("ModuleScript") then
		local ok, module = pcall(require, debugModule)
		if ok and type(module) == "table" then
			PanelManager.Register("Debug", module)
		else
			warn("[ClientMain] Erreur au chargement du panneau Debug : " .. tostring(module))
		end
	end
	DebugTools.OpenPanel = function()
		if PanelManager.IsRegistered("Debug") then
			PanelManager.Open("Debug")
		end
	end
	DebugTools.RegisterChatCommands()
end

-- Panneau des thèmes : chargé à part (sans bloquer le reste de l'interface)
task.spawn(function()
	local moduleScript = Panels:WaitForChild("Themes", 15)
	if not moduleScript or not moduleScript:IsA("ModuleScript") then
		warn("[ClientMain] Panneau Themes introuvable")
		return
	end
	local ok, module = pcall(require, moduleScript)
	if ok and type(module) == "table" then
		PanelManager.Register("Themes", module)
	else
		warn("[ClientMain] Erreur au chargement du panneau Themes : " .. tostring(module))
	end
end)

-- 5. Colonne centrale (bouton, compteur, menus, améliorations).
-- (les emplacements des stimuli s'adaptent d'abord à l'écran : la colonne
-- en a besoin sur téléphone)
-- L'infobulle des améliorations va dans le calque Panels (au-dessus des stimuli).
Slots.Bind(Interface)
CenterColumn.Build(layers.Main, layers.Panels, layers.Effects)

-- 6. Stimuli (tout ce qui apparaît à l'écran avec les améliorations)
StimulusManager.Init()

-- 7. Notifications du serveur : toasts + stimuli (bonus, océan)
ClientState.SetNotifyHandler(function(payload)
	Notifications.Handle(payload)
	StimulusManager.HandleNotify(payload)
end)
ClientState.RushChanged:Connect(function(rush)
	Background.SetRush(rush.Active == true)
end)

-- 8. Musique : seulement avec "Lofi Beats" (le réglage Musique est géré par le panneau Paramètres)
ClientState.FeaturesChanged:Connect(function()
	SoundManager.SetMusicAllowed(ClientState.HasFeature("Lofi"))
end)

-- 9. Au premier état reçu : on ouvre le cadeau du jour s'il est disponible
-- (après l'écran de chargement, et après la fenêtre "Bon retour !" si elle est là)
local firstState
firstState = ClientState.Changed:Connect(function(data)
	firstState:Disconnect()
	if ClientState.HasFeature("Daily") and data.Daily and data.Daily.Available then
		task.delay(2.6, function()
			if OfflinePopup.IsVisible() then
				while OfflinePopup.IsVisible() do
					task.wait(0.25)
				end
				task.wait(0.4)
			end
			if not PanelManager.IsOpen() then
				PanelManager.Open("Daily")
			end
		end)
	end
end)

-- 10. On prévient le serveur que l'interface est prête
Net.Event("ClientReady"):FireServer()

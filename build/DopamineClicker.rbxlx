local function currentPrice(food: any): number
	local data = ClientState.Data
	if type(data) ~= "table" then
		return FoodRules.Price(food, 0, 0, 1)
	end
	local boost = data.FoodBoost
	local m = type(boost) == "table" and (tonumber(boost.Multiplier) or 1) or 1
	return FoodRules.Price(food, data.PerSecond, data.ClickValue, m)
end

local function refreshMenu(s: any)
	local gui = s.Gui
	local menu = s.Menu
	if not gui or not menu then
		return
	end
	local have = tonumber(ClientState.Data and ClientState.Data.Dopamine) or 0
	for id, card in pairs(gui.Cards) do
		local food = Config.FoodById[id]
		if food then
			local price = currentPrice(food)
			local label = card:FindFirstChild("Price") :: TextLabel?
			if label then
				label.Text = "🧠 " .. NumberFormatter.Format(price)
				label.TextColor3 = if have >= price then Color3.fromRGB(120, 90, 160) else Color3.fromRGB(226, 80, 90)
			end
		end
	end
end

function FairFx.OpenMenu(stallId: string, foods: { string }, anchor: Vector3?)
	local s = state
	if not s then
		return
	end
	local gui = ensureGui(s)
	if not gui then
		return
	end
	layoutGui(gui)
	for _, card in pairs(gui.Cards) do
		card:Destroy()
	end
	table.clear(gui.Cards)
	local icons = {}
	for i, id in ipairs(foods) do
		local food = Config.FoodById[id]
		if food then
			gui.Cards[id] = foodCard(gui, food, i, stallId)
			table.insert(icons, food.Icon)
		end
	end
	local n = 0
	for _ in pairs(gui.Cards) do
		n += 1
	end
	gui.Holder.Size = UDim2.fromOffset(math.max(400, n * 172 + 40), 344)
	gui.Title.Text = table.concat(icons, " ") .. "  " .. Locale.T("Snacks")
	gui.Sub.Text = Locale.T("Eat it for a Dopamine boost! One boost at a time, it stacks up to 5 min.")
	gui.Status.Text = ""
	gui.Dim.Visible = true
	gui.Card.Visible = true
	UIUtil.Pop(gui.Card, 0.85, 0.2)
	s.Menu = { Stall = stallId, Anchor = anchor }
	refreshMenu(s)
end

function FairFx.CloseMenu()
	local s = state
	if not s or not s.Gui then
		return
	end
	s.Menu = nil
	s.Gui.Dim.Visible = false
	s.Gui.Card.Visible = false
end

function FairFx.Buy(foodId: string, stallId: string): boolean
	local s = state
	if not s or s.Busy then
		return false
	end
	local food = Config.FoodById[foodId]
	if not food then
		return false
	end
	s.Busy = true
	local ok, success, message, missing = pcall(function()
		return Net.Function("Food"):InvokeServer("buy", foodId, stallId)
	end)
	s.Busy = false
	local gui = s.Gui
	if not ok then
		if gui then
			gui.Status.Text = Locale.T("Network error, try again.")
		end
		return false
	end
	if success then
		FairFx.CloseMenu()
		toast(tostring(message or (food.Icon .. " " .. Locale.T(food.Name))), Color3.fromRGB(70, 190, 120))
		return true
	end
	if gui then
		if type(missing) == "number" and missing > 0 then
			gui.Status.Text = Locale.T("You need %s more Dopamine", NumberFormatter.Format(math.max(1, missing))) .. "  " .. Locale.T("👆 Click to earn more!")
		else
			gui.Status.Text = tostring(message or "")
		end
		gui.Status.TextColor3 = Color3.fromRGB(226, 80, 90)
	end
	return false
end

function FairFx.Bite()
	local s = state
	if not s then
		return
	end
	task.spawn(function()
		pcall(function()
			Net.Function("Food"):InvokeServer("bite")
		end)
	end)
end

----------------------------------------------------------------------
-- Manger : bras qui porte l'aliment à la bouche + miettes (tous les
-- mangeurs visibles, d'après l'attribut "BiteAt" de l'outil)
----------------------------------------------------------------------

-- (v9.9) geste plus lent et naturel : monter 0,32 s, croquer 0,3 s (petit
-- mouvement de mastication), redescendre 0,38 s ; IK R15 / R6 : FairEat
local BITE_UP, BITE_HOLD, BITE_DOWN = 0.32, 0.3, 0.38

local function crumbs(tool: Tool, food: any)
	local handle = tool:FindFirstChild("Handle")
	if not handle or not handle:IsA("BasePart") then
		return
	end
	local emitter = handle:FindFirstChild("FairCrumbs") :: ParticleEmitter?
	if not emitter then
		local e = Instance.new("ParticleEmitter")
		e.Name = "FairCrumbs"
		e.Rate = 0
		e.Lifetime = NumberRange.new(0.4, 0.8)
		e.Speed = NumberRange.new(3, 6)
		e.SpreadAngle = Vector2.new(70, 70)
		e.Acceleration = Vector3.new(0, -32, 0)
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.14), NumberSequenceKeypoint.new(1, 0.05) })
		e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0.4) })
		e.Color = ColorSequence.new(food and food.Crumb or Color3.fromRGB(236, 196, 120))
		e.LightEmission = 0
		e.EmissionDirection = Enum.NormalId.Top
		e.Parent = handle
		emitter = e
	end
	if emitter then
		emitter:Emit(10)
	end
end

local function watchTool(s: any, character: Model, tool: Tool)
	if s.Tools[tool] then
		return
	end
	local entry = { Character = character, Tool = tool, Food = Config.FoodById[tool:GetAttribute("FoodId") or ""], Last = tool:GetAttribute("BiteAt") }
	s.Tools[tool] = entry
	-- (signal + relevé à 10 Hz dans scanEaters : jamais de bouchée manquée)
	entry.Check = function()
		local at = tool:GetAttribute("BiteAt")
		if type(at) ~= "number" or at == entry.Last then
			return
		end
		entry.Last = at
		crumbs(tool, entry.Food)
		local anim = s.Arms[character]
		if not anim then
			local rig = FairEat.Rig(character)
			if rig then
				anim = { Rig = rig, T = 0, Tool = tool }
				s.Arms[character] = anim
			end
		end
		if anim then
			anim.T = 0
			anim.Tool = tool
		end
		-- dernière bouchée (le mien) : petite fête
		if character == (LocalPlayer and LocalPlayer.Character) and (tool:GetAttribute("BitesLeft") or 1) <= 0 and entry.Food then
			local food = entry.Food
			toast("⚡ " .. Locale.T("Dopamine boost %s for %s!", fmtMult(food.Multiplier), fmtClock(food.Duration)), HOT)
		end
	end
	entry.Conn = tool:GetAttributeChangedSignal("BiteAt"):Connect(entry.Check)
end

local function stepArms(s: any, dt: number)
	for character, anim in pairs(s.Arms) do
		anim.T += dt
		local t = anim.T
		local k
		if t < BITE_UP then
			k = t / BITE_UP
		elseif t < BITE_UP + BITE_HOLD then
			-- (mastication : la main recule à peine, 2 fois)
			k = 1 - 0.06 * math.abs(math.sin((t - BITE_UP) / BITE_HOLD * math.pi * 2))
		elseif t < BITE_UP + BITE_HOLD + BITE_DOWN then
			k = 1 - (t - BITE_UP - BITE_HOLD) / BITE_DOWN
		else
			k = 0
		end
		local rig = anim.Rig
		if not character.Parent or not rig.Shoulder.Parent then
			s.Arms[character] = nil
		elseif k <= 0 and t > BITE_UP then
			FairEat.Restore(rig)
			s.Arms[character] = nil
		else
			local tool = anim.Tool
			FairEat.Apply(rig, k, if tool and tool.Parent == character then tool else nil)
		end
	end
end

local function restoreArms(s: any)
	for _, anim in pairs(s.Arms) do
		pcall(FairEat.Restore, anim.Rig)
	end
	table.clear(s.Arms)
end

-- 10 fois / s : outils "DopamineFood" tenus par les avatars proches
local function scanEaters(s: any)
	for tool, entry in pairs(s.Tools) do
		if not tool.Parent or tool.Parent ~= entry.Character then
			if entry.Conn then
				entry.Conn:Disconnect()
			end
			s.Tools[tool] = nil
		end
	end
	local mine: Tool? = nil
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		if character then
			local tool = character:FindFirstChild("DopamineFood")
			if tool and tool:IsA("Tool") then
				watchTool(s, character, tool)
				local entry = s.Tools[tool]
				if entry and entry.Check then
					entry.Check()
				end
				if player == LocalPlayer then
					mine = tool
				end
			end
		end
	end
	-- bouton "Croquer" (le mien)
	local gui = s.Gui
	if mine or (gui and gui.Bite.Visible) then
		gui = ensureGui(s)
		if gui then
			layoutGui(gui)
			if mine then
				local food = Config.FoodById[mine:GetAttribute("FoodId") or ""]
				local left = tonumber(mine:GetAttribute("BitesLeft")) or 0
				gui.Bite.Text = "🍴 " .. Locale.T("Take a bite") .. " " .. (food and food.Icon or "") .. " (" .. tostring(math.max(0, math.floor(left))) .. ")"
				gui.Bite.Visible = left > 0
			else
				gui.Bite.Visible = false
			end
		end
	end
end

----------------------------------------------------------------------
-- Badge du boost (lu dans l'état du clicker : FoodBoost)
----------------------------------------------------------------------

local function onState(s: any)
	local data = ClientState.Data
	local boost = type(data) == "table" and data.FoodBoost or nil
	local remaining = type(boost) == "table" and tonumber(boost.Remaining) or 0
	local m = type(boost) == "table" and tonumber(boost.Multiplier) or 1
	if remaining and remaining > 0 and m and m > 1 then
		local newEnd = os.clock() + remaining
		if math.abs(newEnd - (s.BoostEnd or 0)) > 1 then
			s.BoostEnd = newEnd
		end
		s.BoostMult = m
		local food = Config.FoodById[boost.Food or ""]
		s.BoostIcon = food and food.Icon or "🍦"
	else
		s.BoostEnd = 0
	end
	if s.Menu then
		refreshMenu(s)
	end
end

local function stepBadge(s: any)
	local left = (s.BoostEnd or 0) - os.clock()
	local gui = s.Gui
	if left > 0 then
		gui = ensureGui(s)
		if not gui then
			return
		end
		layoutGui(gui)
		gui.Badge.Visible = true
		gui.BadgeText.Text = (s.BoostIcon or "🍦") .. " " .. Locale.T("Boost") .. " " .. fmtMult(s.BoostMult or 1) .. " · " .. fmtClock(left)
	elseif gui then
		gui.Badge.Visible = false
	end
end

----------------------------------------------------------------------
-- Autos tamponneuses : conduite (client du conducteur)
----------------------------------------------------------------------

local BUMP_MAX, BUMP_REVERSE, BUMP_ACCEL, BUMP_TURN = 14, 7, 20, 2.3

local function driveBumper(s: any, seat: VehicleSeat, dt: number)
	local body = seat.Parent
	if not body or not body:IsA("BasePart") then
		return
	end
	local velocity = body:FindFirstChild("BumperVelocity") :: LinearVelocity?
	local align = body:FindFirstChild("BumperAlign") :: AlignOrientation?
	if not velocity or not align then
		return
	end
	local d = s.Drive
	if not d or d.Seat ~= seat then
		local look = body.CFrame.LookVector
		d = { Seat = seat, Heading = math.atan2(-look.X, -look.Z), Speed = 0 }
		s.Drive = d
	end
	local def = FairRides.ById.Bumper
	local phase = FairRides.Phase(def, workspace:GetServerTimeNow())
	local throttle = math.clamp(tonumber(seat.ThrottleFloat) or 0, -1, 1)
	local steer = math.clamp(tonumber(seat.SteerFloat) or 0, -1, 1)
	if phase ~= "run" then
		throttle = 0
	end
	local look = Vector3.new(-math.sin(d.Heading), 0, -math.cos(d.Heading))
	local current = body.AssemblyLinearVelocity
	local actual = if typeof(current) == "Vector3" then current:Dot(look) else d.Speed
	local target = if throttle > 0.05 then throttle * BUMP_MAX elseif throttle < -0.05 then throttle * BUMP_REVERSE else 0
	local base = if math.abs(actual - d.Speed) > 5 then actual else d.Speed
	local speed = base + math.clamp(target - base, -BUMP_ACCEL * dt, BUMP_ACCEL * dt)
	if phase ~= "run" then
		speed = base + math.clamp(-base, -BUMP_ACCEL * 1.5 * dt, BUMP_ACCEL * 1.5 * dt)
	end
	d.Speed = speed
	-- les autos tamponneuses tournent même à l'arrêt (un peu)
	local factor = 0.45 + 0.55 * math.clamp(math.abs(speed) / BUMP_MAX, 0, 1)
	if phase == "run" then
		d.Heading -= steer * BUMP_TURN * factor * (if speed < -0.5 then -1 else 1) * dt
	end
	look = Vector3.new(-math.sin(d.Heading), 0, -math.cos(d.Heading))
	local v = look * speed
	velocity.PlaneVelocity = Vector2.new(v.X, v.Z)
	align.CFrame = CFrame.Angles(0, d.Heading, 0)
end

----------------------------------------------------------------------
-- Boucle
----------------------------------------------------------------------

local function findSources(): (Instance?, Instance?, Instance?)
	local town = workspace:FindFirstChild("DopamineTown")
	local decor = town and town:FindFirstChild("Decor")
	if not decor then
		return nil, nil, nil
	end
	local fair = decor:FindFirstChild("Fair")
	local corner = decor:FindFirstChild("FoodCorner")
	return town, (fair and fair:GetAttribute("FxVersion") ~= nil) and fair or nil, (corner and corner:GetAttribute("FxVersion") ~= nil) and corner or nil
end

local function focusPoint(): Vector3?
	local character = LocalPlayer and LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root.Position
	end
	local camera = workspace.CurrentCamera
	return camera and camera.CFrame.Position or nil
end

local function mySeat(): BasePart?
	local character = LocalPlayer and LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return humanoid and humanoid.SeatPart or nil
end

-- (v9.9, FAIR99) ANTI-SACCADES. Causes trouvées (v9.8) :
--  1) les manèges où l'on n'est PAS assis bougeaient 30 fois / s (15 au-delà
--     de 90 studs) dans Heartbeat -> à 60 i/s, une image sur deux figée ;
--  2) le serveur déplaçait les sièges occupés 10 fois / s : ces valeurs
--     répliquées (en retard de la latence) s'affichaient sur les images où le
--     client ne réécrivait pas le siège -> les AUTRES passagers reculaient
--     puis sautaient en avant (jusqu'à ~1,8 stud sur les chaises volantes) ;
--  3) le manège où l'on est assis bougeait dans un RenderStepped:Connect,
--     sans ordre garanti avec la caméra -> caméra en retard d'une image
--     selon les images ;
--  4) workspace:GetServerTimeNow() est recalé par petits sauts.
-- Correctif : UNE fonction liée au rendu AVANT la caméra
-- (BindToRenderStep, priorité Camera - 1) qui, à CHAQUE image, pose les
-- manèges proches (décor + sièges) et TOUS les sièges occupés de la fête
-- (quel que soit l'éloignement), avec une horloge lissée (FairKit.Now) ;
-- les manèges lointains (décor seul) : une image sur 2 ou 3.
local NEAR_R = 170 -- (studs, bord du manège -> caméra) décor posé à chaque image
local MID_R = 300 -- ... une image sur 2 ; au-delà, une sur 3 (jusqu'à ANIM_R + marge)
local RENDER_NAME = "DopamineFairRides"

local function occupied(r: RideFx): boolean
	for _, seat in ipairs(r.Seats) do
		if (seat :: any).Occupant ~= nil then
			return true
		end
	end
	return false
end

local function frameStep(dt: number)
	local s = state
	if not s then
		return
	end
	local ok, err = pcall(function()
		local t = FairKit.Now()
		s.RenderFrame = (s.RenderFrame or 0) + 1
		local frame = s.RenderFrame
		local camera = workspace.CurrentCamera
		local camPos = if camera then camera.CFrame.Position else Vector3.zero
		local camLook = if camera then camera.CFrame.LookVector else Vector3.new(0, 0, -1)
		local fx = s.Fair
		local riding = mySeat()
		s.RidingId = nil
		local moved = 0
		if fx then
			for _, r in ipairs(fx.Rides) do
				local toRide = r.Base.Position - camPos
				local edge = toRide.Magnitude - r.Radius
				-- (derrière la caméra : décor inutile, sauf tout près)
				local visible = edge < 25 or toRide.Unit:Dot(camLook) > -0.35
				local busy = occupied(r)
				if busy and riding and table.find(r.Seats, riding) then
					s.RidingId = r.Def.Id
				end
				local decor
				if not visible then
					decor = false
				elseif edge < NEAR_R then
					decor = true
				elseif edge < MID_R then
					decor = frame % 2 == 0
				else
					decor = frame % 3 == 0
				end
				if decor or busy then
					FairKit.StepRide(r, t, decor)
					if decor then
						moved += #r.Parts
					end
				end
			end
			if fx.Ducks and (fx.Ducks.Center.Position - camPos).Magnitude < 90 then
				fx.Ducks.Step(t)
			end
			-- 🤸 rebonds sur les trampolines (avatar local)
			local tr = fx.Trampolines
			if tr then
				local character = LocalPlayer and LocalPlayer.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				if root and root:IsA("BasePart") and (root.Position - tr.Base.Position).Magnitude < 16 then
					FairAnnexFx.StepTrampolines(tr, humanoid ~= nil and humanoid.Jump)
				end
			end
		end
		s.Moved = moved
		-- autos tamponneuses (conduite) + bras des mangeurs
		local seat = riding
		if seat and seat:IsA("VehicleSeat") and seat.Name == "BumperSeat" then
			driveBumper(s, seat, math.min(dt, 0.1))
		elseif s.Drive then
			s.Drive = nil
		end
		if next(s.Arms) ~= nil then
			stepArms(s, math.min(dt, 0.1))
		end
	end)
	if not ok and not s.RenderWarned then
		s.RenderWarned = true
		warn("[FairFx] " .. tostring(err))
	end
end

local function dressCars(fx: any)
	local rides = fx.Source:FindFirstChild("Rides")
	local folder = rides and rides:FindFirstChild("Bumper")
	if not folder then
		return
	end
	fx.Dressed = fx.Dressed or {}
	for _, body in ipairs(folder:GetChildren()) do
		if body:IsA("BasePart") and body.Name == "BumperBody" and not fx.Dressed[body] then
			fx.Dressed[body] = dressBumper(body)
		end
	end
end

local function undressCars(fx: any)
	if fx and fx.Dressed then
		for _, model in pairs(fx.Dressed) do
			model:Destroy()
		end
		fx.Dressed = nil
	end
end

local function stepBuild(queueOwner: any): boolean
	local q = queueOwner.Queue
	if #q == 0 then
		queueOwner.Built = true
		return false
	end
	local job = table.remove(q, 1)
	local ok, err = pcall(job)
	if not ok then
		warn("[FairFx] " .. tostring(err))
	end
	return true
end

local function stepVendors(list: { any }, focus: Vector3, t: number)
	local N = npcModels()
	if not N or type(N.Animate) ~= "function" then
		return
	end
	for _, v in ipairs(list) do
		local model = v.Model
		if model.Parent and (model:GetPivot().Position - focus).Magnitude < NPC_R then
			pcall(N.Animate, model, v.Anim, t + v.Seed)
		end
	end
end

function FairFx.Start(options: any?)
	if state then
		return
	end
	state = {
		Acc = 0,
		Frame = 0,
		Time = 0,
		Slow = 0,
		Fair = nil,
		Corner = nil,
		Tools = {},
		Arms = {},
		PromptCache = {},
		PromptAge = 0,
		Busy = false,
		Menu = nil,
		Gui = nil,
		Toast = options and options.Toast or nil,
		BoostEnd = 0,
		Conns = {},
	}
	local s = state
	-- (v9.9) à chaque image, AVANT la caméra (voir frameStep)
	pcall(function()
		RunService:UnbindFromRenderStep(RENDER_NAME)
	end)
	RunService:BindToRenderStep(RENDER_NAME, Enum.RenderPriority.Camera.Value - 1, frameStep)
	table.insert(s.Conns, ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		if player ~= LocalPlayer then
			return
		end
		-- (v9.9) grand huit / train fantôme / bateau en marche : on attend la gare
		local rideId = prompt:GetAttribute("RideId")
		local rdef = type(rideId) == "string" and FairRides.ById[rideId] or nil
		if rdef and (rdef.Kind == "Coaster" or rdef.Kind == "Ghost" or rdef.Kind == "Pirate") then
			local phase, left = FairRides.Phase(rdef, workspace:GetServerTimeNow())
			if phase ~= "load" or left < 0.8 then
				local wait = if phase == "load" then left + FairRides.Period(rdef.Cycle) - rdef.Cycle.Load else left
				toast("⏳ " .. Locale.T("Next departure in %s s", tostring(math.max(1, math.ceil(wait)))), SKY)
			end
		end
		local stall = prompt:GetAttribute("FoodStall")
		local foods = prompt:GetAttribute("Foods")
		if type(stall) == "string" and type(foods) == "string" then
			local list = {}
			for id in string.gmatch(foods, "[^,]+") do
				table.insert(list, id)
			end
			local host = prompt.Parent
			FairFx.OpenMenu(stall, list, if host and host:IsA("BasePart") then host.Position else nil)
		end
	end))
	table.insert(s.Conns, ClientState.Changed:Connect(function()
		pcall(onState, s)
	end))
	table.insert(s.Conns, UserInputService.InputBegan:Connect(function(input, processed)
		if input.KeyCode == Enum.KeyCode.Escape and s.Menu then
			FairFx.CloseMenu()
		end
		local _ = processed
	end))
	pcall(onState, s)
end

function FairFx.Step(dt: number)
	local s = state
	if not s then
		return
	end
	s.Acc += dt
	if s.Acc < STEP then
		return
	end
	local elapsed = math.min(s.Acc, 0.25)
	s.Acc = 0
	s.Time += elapsed
	s.Slow += elapsed
	local town, fair, corner = findSources()
	local focus = focusPoint()
	if not town or not focus then
		return
	end
	-- (ville reconstruite : nos pièces sont parties)
	if s.Fair and (s.Fair.Source.Parent == nil or s.Fair.Folder.Parent == nil and s.Fair.Built) then
		undressCars(s.Fair)
		destroyFair(s)
	end
	if s.Corner and (s.Corner.Source.Parent == nil) then
		destroyCorner(s)
	end
	local t = workspace:GetServerTimeNow()
	-- 🎡 fête : construire / détruire selon la distance
	if fair then
		local F = fair:GetAttribute("FairCF")
		local dist = typeof(F) == "CFrame" and (Vector3.new(focus.X, 0, focus.Z) - Vector3.new(F.Position.X, 0, F.Position.Z)).Magnitude or math.huge
		if not s.Fair and dist < BUILD_R then
			if queueFair(s, fair) then
				s.Fair.Folder.Parent = town
			end
		elseif s.Fair and dist > DROP_R then
			undressCars(s.Fair)
			destroyFair(s)
		end
		local fx = s.Fair
		if fx then
			if not fx.Built then
				stepBuild(fx)
			end
			-- (manèges, canards : frameStep, à chaque image ; ici les vendeurs)
			if dist < ANIM_R then
				stepVendors(fx.Vendors, focus, t)
			end
		end
	end
	-- 🍦 coin gourmand
	if corner then
		local C = corner:GetAttribute("CornerCF")
		local dist = typeof(C) == "CFrame" and (focus - C.Position).Magnitude or math.huge
		if not s.Corner and dist < CORNER_BUILD_R then
			if queueCorner(s, corner) then
				s.Corner.Folder.Parent = town
			end
		elseif s.Corner and dist > CORNER_DROP_R then
			destroyCorner(s)
		end
		local cx = s.Corner
		if cx then
			if not cx.Built then
				stepBuild(cx)
			end
			stepVendors(cx.Vendors, focus, t)
		end
	end
	-- 10 fois / s : sièges répliqués, panneaux, invites, mangeurs, menu, badge
	if s.Slow >= 0.1 then
		s.Slow = 0
		s.PromptAge += 1
		local fx = s.Fair
		if fx then
			for _, r in ipairs(fx.Rides) do
				r.SeatCheck -= 0.1
				if #r.Seats == 0 and r.SeatCheck <= 0 and r.Def.Kind ~= "Bumper" then
					r.SeatCheck = 1
					findSeats(r, fx.Source)
				end
				local board = fx.Boards[r.Def.Id]
				if board then
					local phase, left = FairRides.Phase(r.Def, t)
					local text = if phase == "load" then "⏳ " .. Locale.T("Departure in %s s", tostring(math.max(1, math.ceil(left)))) else "▶ " .. Locale.T("Running")
					if board.Text ~= text then
						board.Text = text
					end
				end
			end
			dressCars(fx)
		end
		pcall(refreshPrompts, s)
		pcall(scanEaters, s)
		stepBadge(s)
		-- menu : on s'éloigne du stand -> fermé
		local menu = s.Menu
		if menu and menu.Anchor and (focus - menu.Anchor).Magnitude > MENU_RANGE then
			FairFx.CloseMenu()
		end
	end
end

function FairFx.Stop()
	local s = state
	state = nil
	if not s then
		return
	end
	pcall(function()
		RunService:UnbindFromRenderStep(RENDER_NAME)
	end)
	for _, c in ipairs(s.Conns) do
		c:Disconnect()
	end
	for _, entry in pairs(s.Tools) do
		if entry.Conn then
			entry.Conn:Disconnect()
		end
	end
	restoreArms(s)
	undressCars(s.Fair)
	destroyFair(s)
	destroyCorner(s)
	if s.Gui then
		for _, c in ipairs(s.Gui.Conns) do
			c:Disconnect()
		end
		s.Gui.Screen:Destroy()
	end
end

function FairFx.Debug(): any
	return { State = state, StepRide = FairKit.StepRide, FrameStep = frameStep }
end

return FairFx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="193">
          <Properties>
            <string name="Name">FairKit</string>
            <string name="Source"><![CDATA[--[[
	FairKit (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > FairKit

	🎡 Boîte à outils du DÉCOR de la fête (v9.9, FAIR99), partagée par
	FairFx (fête, manèges d'origine), FairAnnexFx (grand huit, bateau
	pirate, train fantôme, trampolines, palais des glaces) et FairCircus
	(chapiteau + spectacle). Pièces LOCALES, ancrées, sans collision par
	défaut (Solid = on marche dessus), sans ombre pour les petites pièces,
	lueurs "NightGlow" (TownAtmosphere : Neon la nuit seulement), aucun son.

	Manèges : un "RideFx" range les pièces MOBILES par groupe
	(FairRides.Pose) ; FairKit.StepRide recalcule la pose à l'heure donnée et
	déplace tout (décor + sièges du serveur) en UN BulkMoveTo par liste.
]]

local FairRides = require(game:GetService("ReplicatedStorage").Shared.FairRides)

local FairKit = {}

local M = Enum.Material
FairKit.M = M
FairKit.UP = Vector3.new(0, 1, 0)
FairKit.VERTICAL = CFrame.Angles(0, 0, math.rad(90)) -- cylindre debout (axe X -> Y)
FairKit.BALL = Enum.PartType.Ball
FairKit.CYL = Enum.PartType.Cylinder
FairKit.TAU = math.pi * 2

-- Palette (douce, "mignon-réaliste")
FairKit.C = {
	Pink = Color3.fromRGB(255, 132, 180),
	Hot = Color3.fromRGB(236, 72, 140),
	Cream = Color3.fromRGB(255, 244, 226),
	Gold = Color3.fromRGB(226, 184, 92),
	White = Color3.fromRGB(250, 250, 252),
	Mint = Color3.fromRGB(128, 222, 190),
	Sky = Color3.fromRGB(126, 196, 255),
	Lilac = Color3.fromRGB(186, 150, 246),
	Lemon = Color3.fromRGB(255, 222, 110),
	Steel = Color3.fromRGB(96, 100, 120),
	SteelLight = Color3.fromRGB(196, 200, 214),
	Wood = Color3.fromRGB(186, 134, 90),
	WoodDark = Color3.fromRGB(122, 84, 56),
	Ink = Color3.fromRGB(92, 58, 96),
	Bulb = Color3.fromRGB(255, 232, 180),
	Red = Color3.fromRGB(214, 44, 56),
	Navy = Color3.fromRGB(40, 52, 96),
	Rubber = Color3.fromRGB(40, 40, 46),
}
FairKit.PALETTE = { FairKit.C.Pink, FairKit.C.Sky, FairKit.C.Lemon, FairKit.C.Mint, FairKit.C.Lilac, Color3.fromRGB(255, 170, 120) }

----------------------------------------------------------------------
-- Pièces
----------------------------------------------------------------------

function FairKit.Part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?, className: string?): BasePart
	local p = Instance.new((className or "Part") :: any) :: BasePart
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		(p :: Part).Shape = shape
	end
	p.Parent = parent
	return p
end

-- Pièce sur laquelle on marche / contre laquelle on bute (localement)
function FairKit.Solid(p: BasePart): BasePart
	p.CanCollide = true
	p.CastShadow = true
	return p
end

-- Ampoule : mate le jour, Neon la nuit (TownAtmosphere, attribut NightGlow)
function FairKit.Glow(p: BasePart): BasePart
	p:SetAttribute("NightGlow", true)
	return p
end

function FairKit.RodCF(a: Vector3, b: Vector3): CFrame
	return CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, math.rad(90), 0)
end

-- Tube (cylindre) de a à b
function FairKit.Rod(parent: Instance, name: string, a: Vector3, b: Vector3, d: number, color: Color3, material: Enum.Material?): BasePart
	return FairKit.Part(parent, name, Vector3.new((b - a).Magnitude, d, d), FairKit.RodCF(a, b), color, material or M.Metal, FairKit.CYL)
end

function FairKit.BeamCF(a: Vector3, b: Vector3): CFrame
	local dir = b - a
	if math.abs(dir.Unit.Y) > 0.98 then
		return CFrame.new((a + b) / 2) * CFrame.Angles(math.rad(90), 0, 0)
	end
	return CFrame.lookAt((a + b) / 2, b)
end

-- Poutre (bloc) de a à b, section w x h
function FairKit.Beam(parent: Instance, name: string, a: Vector3, b: Vector3, w: number, h: number, color: Color3, material: Enum.Material?): BasePart
	return FairKit.Part(parent, name, Vector3.new(w, h, (b - a).Magnitude), FairKit.BeamCF(a, b), color, material or M.Metal)
end

-- Triangle rectangle (WedgePart) : angle droit en p0, côtés le long de u (l1) et v (l2)
function FairKit.Tri(p0: Vector3, u: Vector3, v: Vector3, l1: number, l2: number, t: number): (Vector3, CFrame)
	local Z = -v
	local X = u:Cross(Z)
	return Vector3.new(t, l1, l2), CFrame.fromMatrix(p0 + u * (l1 / 2) + v * (l2 / 2), X, u, Z)
end

-- Treillis métallique entre deux points (2 membrures + croisillons en zigzag)
-- `side` = direction de la largeur (perpendiculaire à a->b)
function FairKit.Truss(parent: Instance, name: string, a: Vector3, b: Vector3, side: Vector3, width: number, d: number, color: Color3, bays: number?)
	local half = side.Unit * (width / 2)
	local a1, a2, b1, b2 = a + half, a - half, b + half, b - half
	FairKit.Rod(parent, name, a1, b1, d, color)
	FairKit.Rod(parent, name, a2, b2, d, color)
	local n = bays or math.max(2, math.floor((b - a).Magnitude / (width * 1.3) + 0.5))
	for i = 0, n - 1 do
		local p = a1:Lerp(b1, i / n)
		local q = a2:Lerp(b2, (i + 1) / n)
		local r = a1:Lerp(b1, (i + 1) / n)
		FairKit.Rod(parent, name .. "Lace", p, q, d * 0.6, color)
		FairKit.Rod(parent, name .. "Lace", q, r, d * 0.6, color)
	end
end

-- Panneau (SurfaceGui sur la face avant d'une pièce) avec un texte
function FairKit.Sign(p: BasePart, text: string, textColor: Color3, bg: Color3?, font: Enum.Font?, face: Enum.NormalId?): TextLabel
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Sign"
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0.5
	gui.MaxDistance = 260
	gui.Parent = p
	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = bg or FairKit.C.White
	frame.BackgroundTransparency = bg and 0 or 1
	frame.BorderSizePixel = 0
	frame.Parent = gui
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromScale(0.04, 0.1)
	label.Size = UDim2.fromScale(0.92, 0.8)
	label.Font = font or Enum.Font.FredokaOne
	label.Text = text
	label.TextColor3 = textColor
	label.TextScaled = true
	label.Parent = frame
	return label
end

-- Rangée d'ampoules de a à b (n ampoules, couleurs alternées)
function FairKit.Bulbs(parent: Instance, a: Vector3, b: Vector3, n: number, size: number?, colors: { Color3 }?)
	local list = colors or { FairKit.C.Bulb }
	for i = 0, n - 1 do
		local p = if n == 1 then (a + b) / 2 else a:Lerp(b, i / (n - 1))
		FairKit.Glow(FairKit.Part(parent, "Bulb", Vector3.one * (size or 0.3), CFrame.new(p), list[i % #list + 1], M.SmoothPlastic, FairKit.BALL))
	end
end

----------------------------------------------------------------------
-- Manèges : pièces MOBILES rangées par groupe
----------------------------------------------------------------------

export type RideFx = {
	Def: any,
	Base: CFrame,
	Model: Model,
	Parts: { BasePart },
	Locals: { CFrame },
	Group: { number },
	Frames: { CFrame },
	Groups: { CFrame },
	Seats: { BasePart },
	SeatIndex: { number },
	SeatFrames: { CFrame },
	SeatCheck: number,
	Radius: number,
	Extra: any,
}

function FairKit.NewRide(folder: Instance, def: any, base: CFrame, t: number): RideFx
	local model = Instance.new("Model")
	model.Name = def.Id
	model.Parent = folder
	local r: RideFx = {
		Def = def,
		Base = base,
		Model = model,
		Parts = {},
		Locals = {},
		Group = {},
		Frames = {},
		Groups = {},
		Seats = {},
		SeatIndex = {},
		SeatFrames = {},
		SeatCheck = 0,
		Radius = 30,
		Extra = nil,
	}
	FairRides.Pose(def, t, r.Groups)
	return r
end

-- Pièce fixe du manège (repère de la Base)
function FairKit.Fixed(r: RideFx, name: string, size: Vector3, loc: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?, className: string?): BasePart
	return FairKit.Part(r.Model, name, size, r.Base * loc, color, material, shape, className)
end

-- Pièce qui suit le groupe `g` (loc = repère du groupe)
function FairKit.Moving(r: RideFx, g: number, name: string, size: Vector3, loc: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?, className: string?): BasePart
	local world = r.Base * (r.Groups[g] or CFrame.identity) * loc
	local p = FairKit.Part(r.Model, name, size, world, color, material, shape, className)
	table.insert(r.Parts, p)
	table.insert(r.Locals, loc)
	table.insert(r.Group, g)
	table.insert(r.Frames, world)
	return p
end

-- Sièges du serveur (Fair > Rides > <Id> > RideSeat)
function FairKit.FindSeats(r: RideFx, fairFolder: Instance)
	table.clear(r.Seats)
	table.clear(r.SeatIndex)
	table.clear(r.SeatFrames)
	local rides = fairFolder:FindFirstChild("Rides")
	local folder = rides and rides:FindFirstChild(r.Def.Id)
	if not folder then
		return
	end
	for _, d in ipairs(folder:GetChildren()) do
		local index = d:GetAttribute("SeatIndex")
		if d:IsA("Seat") and type(index) == "number" then
			table.insert(r.Seats, d)
			table.insert(r.SeatIndex, index)
		end
	end
end

-- Pose à l'heure t : décor (si `decor`) + sièges du serveur, en 2 BulkMoveTo
function FairKit.StepRide(r: RideFx, t: number, decor: boolean)
	local kind = r.Def.Kind
	if kind == "Bumper" or kind == "Circus" or kind == "Trampolines" or kind == "Mirrors" then
		if decor and r.Extra and r.Extra.Step then
			r.Extra.Step(t)
		end
		return
	end
	local groups = r.Groups
	FairRides.Pose(r.Def, t, groups)
	if decor then
		local frames, locals, group, base = r.Frames, r.Locals, r.Group, r.Base
		for i = 1, #frames do
			frames[i] = base * groups[group[i]] * locals[i]
		end
		if #frames > 0 then
			workspace:BulkMoveTo(r.Parts, frames, Enum.BulkMoveMode.FireCFrameChanged)
		end
		if r.Extra and r.Extra.Step then
			r.Extra.Step(t)
		end
	end
	local seats = r.Seats
	if #seats > 0 then
		local seatFrames, idx, base = r.SeatFrames, r.SeatIndex, r.Base
		for i = 1, #seats do
			seatFrames[i] = base * FairRides.SeatLocal(kind, idx[i], groups)
		end
		workspace:BulkMoveTo(seats, seatFrames, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

----------------------------------------------------------------------
-- Horloge LISSE du serveur : workspace:GetServerTimeNow() est recalée par
-- petits sauts quand la synchro réseau s'affine ; ici l'écart avec
-- os.clock() glisse doucement (≤ 5 % du temps écoulé) -> une pose qui
-- avance sans à-coup d'une image à l'autre, identique sur tous les écrans
-- (à quelques ms près).
----------------------------------------------------------------------

local clockOffset: number? = nil
local lastClock = 0
function FairKit.Now(): number
	local c = os.clock()
	local target = workspace:GetServerTimeNow() - c
	local off = clockOffset
	if off == nil or math.abs(target - off) > 1 then
		off = target -- (premier appel, ou gros écart : on se recale d'un coup)
	else
		local dt = math.clamp(c - lastClock, 0, 0.25)
		local maxStep = dt * 0.05
		off += math.clamp(target - off, -maxStep, maxStep)
	end
	clockOffset = off
	lastClock = c
	return c + (off :: number)
end

return FairKit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="194">
          <Properties>
            <string name="Name">FurnitureEdit</string>
            <string name="Source"><![CDATA[--[[
	FurnitureEdit (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > FurnitureEdit

	🚶 Dopamine Town : déplacer ses meubles avec son avatar, DANS SA maison.
	  - mode édition (bouton ✏️ du HUD) : un clic / un appui sur un meuble le
	    prend en main (surligné) ; il suit la souris (PC) ou le doigt (on le
	    fait glisser) sur le sol de sa pièce, ou sur le mur du fond pour les
	    objets muraux ; aimant de grille (1 stud) activable ;
	  - R (ou 🔄) tourne de 45° (champ R de l'objet posé), Maj+R dans l'autre
	    sens ; clic (PC) ou ✅ pose ; Échap / ❌ annule ; Suppr / 📦 range
	    (retour à l'inventaire) ;
	  - (v9.6) un petit objet (Formulas.CanGoOnFurniture) lâché au-dessus d'un
	    meuble qui a un dessus (HouseSurfaces) se pose DESSUS, sur le NIVEAU visé
	    (rayons d'une bibliothèque, étagères murales, lit superposé...),
	    n'importe où le long du rayon, à côté des objets déjà posés (sans
	    chevauchement) ; le rayon visé s'allume ; ce qui est posé sur un
	    meuble et les chaises rangées à une table suivent le meuble ;
	  - (v9.6) ZONE VALIDE partagée avec l'éditeur 2D et le serveur
	    (WorldLayout.PlacementArea) : le fantôme 3D est TOUJOURS l'image 2D -> 3D
	    de la position qui sera sauvée (WorldLayout.FloorClamp / WallClamp,
	    dessus : même calcul que House3DLayout) -> ce qu'on voit en 3D est
	    exactement ce qui est permis, et la 2D ne déborde plus jamais ;
	  - (v9.6) 📦 INVENTAIRE en 3D : un plateau liste les objets possédés mais
	    pas posés (icône, nombre, filtre par catégorie) ; on en choisit un -> un
	    fantôme suit la souris / le doigt dans la pièce où l'on est (sol, mur
	    ou dessus d'un meuble selon l'objet) -> clic / ✅ pour le poser ;
	    "🛍️ Acheter" ouvre le catalogue de la ville (ShopUI de SHOPS96, sinon
	    une petite liste d'achat ici) et l'objet acheté arrive directement
	    dans le fantôme ;
	  - à la pose : la pièce est reconstruite tout de suite (même rendu qu'après
	    un rechargement) et la disposition part au serveur par l'action
	    existante "saveLayout" (tout y est vérifié : objets possédés, zones,
	    rotation) ; refus -> retour en arrière.
	La maison 2D et la maison 3D restent donc toujours la même maison.
	Entrées : ContextActionService (priorité haute) pendant l'édition : le
	doigt qui déplace un meuble ne fait pas tourner la caméra.
	Interface : ScreenGui "TownInventoryGui" (créé désactivé à new(), à garder
	par TownClient : KEEP_GUIS).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local RunService = game:GetService("RunService")

local WorldLayout = require(ReplicatedStorage.Shared.WorldLayout)
local Locale = require(ReplicatedStorage.Shared.Locale)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)

local Client = script.Parent.Parent
local UIUtil = require(Client.UIUtil)
local Theme = require(Client.Theme)
local ClientState = require(Client.ClientState)

local HouseFolder = Client.Components.House
local HouseCommon = require(HouseFolder.HouseCommon)

local FurnitureEdit = {}
FurnitureEdit.__index = FurnitureEdit

local ACTION = "DopamineTownEdit"
local RENDER = "DopamineTownEditFollow"
local GUI_NAME = "TownInventoryGui"
local GRID = 1 -- (studs) aimant
local ROTATE_STEP = 45
local TURN = CFrame.Angles(0, math.pi, 0) -- modèle (devant -Z) <-> repère des recettes (devant +Z)
local LEVEL_REACH = 0.35 -- (studs) on vise un rayon un peu au-dessus de sa planche
local GHOST_ALPHA = 0.35 -- transparence du fantôme d'un objet de l'inventaire

local PINK_DEEP = Color3.fromRGB(236, 72, 140)
local LILAC = Color3.fromRGB(170, 140, 245)
local MINT = Color3.fromRGB(80, 200, 160)
local SKY = Color3.fromRGB(96, 170, 245)
local INK = Color3.fromRGB(92, 58, 96)
local CARD = Color3.fromRGB(255, 250, 253)
local WHITE = Color3.new(1, 1, 1)

export type Context = {
	GetHouse: () -> any?, -- maison du joueur (HouseBuilder) ou nil
	Hud: any,
	Toast: (text: string, color: Color3?) -> (),
	Save: (slot: number, roomId: string, placed: { any }, onResult: (ok: boolean, message: string?) -> ()) -> (),
}

type Held = {
	House: any,
	Slot: number,
	Index: number, -- index dans room.Placed (objet neuf : #Placed + 1)
	Model: Model,
	Start: CFrame,
	Entry: any,
	Item: any,
	Wall: boolean,
	AgainstWall: boolean,
	FW: number,
	FD: number,
	H: number,
	R: number?,
	Frame: CFrame, -- repère de la pièce
	X: number, -- position 3D montrée (repère de la pièce)
	Y: number,
	Z: number,
	TX: number?, -- (v9.6) position 2D qui sera sauvée (X, Y, couche Z)
	TY: number?,
	TZ: number?,
	Support: Model?,
	Level: number?, -- n° du dessus visé (meuble à plusieurs niveaux)
	Followers: { { Model: Model, Offset: CFrame, Start: CFrame, Index: number } },
	Moved: boolean,
	New: boolean, -- (v9.6) objet sorti de l'inventaire (fantôme)
}

local surfacesModule: any = nil
local function surfaces(): any
	if surfacesModule == nil then
		local ok, result = pcall(require, HouseFolder:FindFirstChild("HouseSurfaces") :: ModuleScript)
		surfacesModule = ok and result or false
	end
	return surfacesModule or nil
end

local recipesModule: any = nil
local function recipes(): any
	if recipesModule == nil then
		local module = HouseFolder:FindFirstChild("House3DRecipes")
		local ok, result = false, nil
		if module then
			ok, result = pcall(require, module :: ModuleScript)
		end
		recipesModule = ok and result or false
	end
	return recipesModule or nil
end

-- Catalogue de la ville (SHOPS96) : facultatif
local shopModule: any = nil
local function shopUI(): any
	if shopModule == nil then
		local module = script.Parent:FindFirstChild("ShopUI")
		local ok, result = false, nil
		if module then
			ok, result = pcall(require, module :: ModuleScript)
		end
		shopModule = (ok and type(result) == "table") and result or false
	end
	return shopModule or nil
end

local function footprint(model: Model): (number, number, number)
	local value = model:GetAttribute("Footprint")
	if typeof(value) == "Vector3" then
		return math.max(0.2, value.X), math.max(0.2, value.Y), math.max(0.2, value.Z)
	end
	return 2, 2, 2
end

-- Modèle d'objet (attribut EntryIndex) qui contient une pièce touchée
local function itemModelOf(part: Instance?): Model?
	local node = part
	while node and node ~= workspace do
		if node:IsA("Model") and node:GetAttribute("EntryIndex") ~= nil then
			return node
		end
		node = node.Parent
	end
	return nil
end

-- Rayon (monde) -> point d'un plan du repère `frame` (axe "y" = sol, "z" = mur du fond)
local function hitPlane(frame: CFrame, origin: Vector3, direction: Vector3, axis: string): Vector3?
	local o = frame:PointToObjectSpace(origin)
	local d = frame:VectorToObjectSpace(direction)
	local component = axis == "y" and d.Y or d.Z
	if math.abs(component) < 1e-4 then
		return nil
	end
	local t = -(axis == "y" and o.Y or o.Z) / component
	if t < 0 then
		return nil
	end
	return o + d * t
end

-- Dimensions 2D <-> 3D d'une pièce de la maison
local function dimsOf(house: any): WorldLayout.RoomDims
	return WorldLayout.RoomDims(house.Size, HouseCommon.Config.WallRatio)
end

-- Taille d'un objet posé (px de maquette -> studs par unité de sa boîte)
local function unitK(item: any, scale: number): number
	return (tonumber(item.Size) or 80) * scale * WorldLayout.PX / 100
end

-- (v9.6) Dessus n° `index` d'un meuble 3D, dans le repère de son modèle
-- (attribut "Top<i>" de House3DRecipes.BuildModel ; sinon les nombres 2D de
-- HouseSurfaces, comme le fait House3DRecipes quand la recette n'en a pas)
local function topLocal(model: Model, index: number, supportEntry: any, supportItem: any): Vector3?
	local value = model:GetAttribute("Top" .. tostring(index))
	if typeof(value) == "Vector3" then
		return value
	end
	if index == 1 then
		local center = model:GetAttribute("TopCenter")
		if typeof(center) == "Vector3" then
			return center
		end
	end
	local S = surfaces()
	local raw = S and S.Raw(supportEntry.I)
	local s = raw and raw[index]
	if not s then
		return nil
	end
	local k = unitK(supportItem, tonumber(supportEntry.S) or 1)
	local x = ((tonumber(s[1]) or 10) + (tonumber(s[2]) or 90)) / 2 - 50
	if supportEntry.F == true then
		x = -x
	end
	local _, _, fd = footprint(model)
	return Vector3.new(-x * k, (100 - (tonumber(s[3]) or 50)) * k, -(tonumber(s[4]) or 0) * fd)
end

function FurnitureEdit.new(ctx: Context)
	local self = setmetatable({
		Ctx = ctx,
		Enabled = false,
		Held = nil :: Held?,
		Snap = true,
		Pointer = nil :: Vector2?,
		Highlight = nil :: Highlight?,
		TargetHighlight = nil :: Highlight?,
		Plate = nil :: BasePart?,
		Hover = nil :: Model?,
		Dragging = false,
		PressAt = nil :: Vector2?,
		Connections = {} :: { any },
		Saving = false,
		Buying = false,
		-- (v9.6) plateau d'inventaire
		Tray = nil :: any,
		TrayOpen = true,
		TrayView = "Inventory", -- "Inventory" | "Buy"
		Filter = nil :: string?, -- catégorie (nil = tout)
		TraySignature = "",
		AwaitBuy = false, -- le catalogue a été ouvert depuis le plateau
		ShopConnection = nil :: any,
	}, FurnitureEdit)
	pcall(function()
		self:BuildTray()
	end)
	return self
end

----------------------------------------------------------------------
-- Surbrillance
----------------------------------------------------------------------

local function newHighlight(name: string): Highlight
	local h = Instance.new("Highlight")
	h.Name = name
	h.DepthMode = Enum.HighlightDepthMode.Occluded
	h.FillTransparency = 0.7
	h.OutlineTransparency = 0
	h.Enabled = false
	h.Parent = workspace
	return h
end

function FurnitureEdit.SetHighlight(self: any, model: Model?, holding: boolean)
	local highlight: Highlight? = self.Highlight
	if not model then
		if highlight then
			highlight.Adornee = nil
			highlight.Enabled = false
		end
		return
	end
	if not highlight then
		highlight = newHighlight("TownEditHighlight")
		self.Highlight = highlight
	end
	local h = highlight :: Highlight
	h.Adornee = model
	h.Enabled = true
	h.FillColor = holding and Color3.fromRGB(110, 230, 170) or Color3.fromRGB(255, 180, 220)
	h.OutlineColor = holding and Color3.fromRGB(40, 170, 110) or Color3.fromRGB(236, 72, 140)
end

-- (v9.6) Meuble visé (contour rose) + plaque lumineuse sur le rayon visé
function FurnitureEdit.SetTarget(self: any, model: Model?, plateCF: CFrame?, plateSize: Vector2?)
	local h: Highlight? = self.TargetHighlight
	if model and not h then
		h = newHighlight("TownEditTarget")
		self.TargetHighlight = h
	end
	if h then
		h.Adornee = model
		h.Enabled = model ~= nil
		h.FillColor = Color3.fromRGB(255, 200, 230)
		h.FillTransparency = 0.85
		h.OutlineColor = PINK_DEEP
	end
	local plate: BasePart? = self.Plate
	if plateCF and plateSize then
		if not plate then
			local p = Instance.new("Part")
			p.Name = "TownEditSurface"
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.CastShadow = false
			p.Material = Enum.Material.SmoothPlastic
			p.Color = Color3.fromRGB(120, 240, 190)
			p.Transparency = 0.45
			p.Parent = workspace
			plate = p
			self.Plate = p
		end
		local part = plate :: BasePart
		part.Size = Vector3.new(math.max(0.2, plateSize.X), 0.05, math.max(0.2, plateSize.Y))
		part.CFrame = plateCF * CFrame.new(0, 0.03, 0)
		part.Transparency = 0.45
	elseif plate then
		plate.Transparency = 1
	end
end

----------------------------------------------------------------------
-- Activer / désactiver
----------------------------------------------------------------------

function FurnitureEdit.IsEnabled(self: any): boolean
	return self.Enabled
end

function FurnitureEdit.SetEnabled(self: any, enabled: boolean)
	if enabled == self.Enabled then
		return
	end
	if not enabled and self.Held then
		self:Cancel()
	end
	self.Enabled = enabled
	local house = self.Ctx.GetHouse()
	self:SetPrompts(house, not enabled)
	if enabled then
		pcall(function()
			ContextActionService:BindActionAtPriority(ACTION, function(_name: string, state: Enum.UserInputState, input: InputObject)
				return self:OnAction(state, input)
			end, false, 3000, Enum.UserInputType.MouseButton1, Enum.UserInputType.Touch, Enum.KeyCode.R, Enum.KeyCode.Delete, Enum.KeyCode.Escape)
		end)
		table.insert(self.Connections, UserInputService.InputChanged:Connect(function(input: InputObject)
			if input.UserInputType == Enum.UserInputType.MouseMovement then
				self.Pointer = Vector2.new(input.Position.X, input.Position.Y)
			end
		end))
		-- (v9.6) inventaire à jour (achat, pose, rangement)
		table.insert(self.Connections, ClientState.Changed:Connect(function()
			self:RefreshTray(false)
		end))
		pcall(function()
			RunService:BindToRenderStep(RENDER, Enum.RenderPriority.Input.Value + 1, function()
				self:Follow()
			end)
		end)
		self.Ctx.Toast(Locale.T("✏️ Edit mode: pick a piece of furniture"), Color3.fromRGB(96, 170, 245))
	else
		pcall(function()
			ContextActionService:UnbindAction(ACTION)
		end)
		pcall(function()
			RunService:UnbindFromRenderStep(RENDER)
		end)
		for _, connection in ipairs(self.Connections) do
			connection:Disconnect()
		end
		table.clear(self.Connections)
		self:SetHighlight(nil, false)
		self:SetTarget(nil)
		self.AwaitBuy = false
	end
	self.Ctx.Hud:SetEditing(enabled, false)
	self:ShowTray(enabled)
end

-- Invites "S'asseoir" coupées pendant l'édition
function FurnitureEdit.SetPrompts(_self: any, house: any, enabled: boolean)
	if not house then
		return
	end
	for _, room in pairs(house.Rooms) do
		for _, prompt in ipairs(room.Prompts) do
			prompt.Enabled = enabled
		end
		-- (v9.8 HOUSE98) 🪟 rideaux / 💡 interrupteur : coupés aussi pendant l'édition
		local toggles = room.Toggles
		if toggles then
			for _, prompt in ipairs(toggles.CurtainPrompts or {}) do
				prompt.Enabled = enabled
			end
			if toggles.SwitchPrompt then
				toggles.SwitchPrompt.Enabled = enabled
			end
		end
	end
end

----------------------------------------------------------------------
-- Entrées
----------------------------------------------------------------------

-- Objet réellement affiché : visible, ainsi que tous ses parents, dans une
-- ScreenGui activée
local function shownOnScreen(object: GuiObject): boolean
	local node: Instance? = object
	while node and not node:IsA("LayerCollector") do
		if node:IsA("GuiObject") and not node.Visible then
			return false
		end
		node = node.Parent
	end
	return node ~= nil and (node :: LayerCollector).Enabled
end

local function overHud(position: Vector2): boolean
	local playerGui = Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not playerGui then
		return false
	end
	local ok, objects = pcall(function()
		return playerGui:GetGuiObjectsAtPosition(position.X, position.Y)
	end)
	if not ok or type(objects) ~= "table" then
		return false
	end
	for _, object in ipairs(objects) do
		-- (v9.6.1) seules les VRAIES surfaces d'interface bloquent le clic :
		-- un bouton, ou un cadre non transparent, dans une ScreenGui active et
		-- visible jusqu'en haut. Avant, le cadre "Root" transparent du plateau
		-- d'inventaire (toute la largeur de l'écran) avalait TOUS les clics :
		-- impossible de prendre un meuble déjà posé.
		if object:IsA("GuiObject") and shownOnScreen(object) then
			local solid = object:IsA("GuiButton") or object.BackgroundTransparency < 0.95
			if solid and (object:FindFirstAncestor(GUI_NAME) or object:FindFirstAncestor("TownShopGui")) then
				return true
			end
			if object:IsA("GuiButton") and object:FindFirstAncestor("TownHud") then
				return true
			end
		end
	end
	return false
end

function FurnitureEdit.OnAction(self: any, state: Enum.UserInputState, input: InputObject): Enum.ContextActionResult
	local pass = Enum.ContextActionResult.Pass
	local sink = Enum.ContextActionResult.Sink
	if not self.Enabled then
		return pass
	end
	if input.UserInputType == Enum.UserInputType.Keyboard then
		if state ~= Enum.UserInputState.Begin or not self.Held then
			return pass
		end
		if input.KeyCode == Enum.KeyCode.R then
			local shift = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
			self:Rotate(shift and -ROTATE_STEP or ROTATE_STEP)
		elseif input.KeyCode == Enum.KeyCode.Delete then
			self:PutAway()
		elseif input.KeyCode == Enum.KeyCode.Escape then
			self:Cancel()
		end
		return sink
	end
	local position = Vector2.new(input.Position.X, input.Position.Y)
	if overHud(position) then
		return pass
	end
	local touch = input.UserInputType == Enum.UserInputType.Touch
	if state == Enum.UserInputState.Begin then
		self.PressAt = position
		if not self.Held then
			if self:Pick(position) then
				self.Dragging = touch
				return sink
			end
			return pass
		end
		self.Pointer = position
		self.Dragging = true
		return sink
	elseif state == Enum.UserInputState.Change then
		if self.Held and self.Dragging then
			self.Pointer = position
			return sink
		end
		return pass
	elseif state == Enum.UserInputState.End then
		local wasDragging = self.Dragging
		self.Dragging = false
		if self.Held and not touch and wasDragging then
			-- PC : 2e clic = poser ici
			self.Pointer = position
			self:Follow()
			self:Drop()
			return sink
		end
		return self.Held and sink or pass
	end
	return pass
end

----------------------------------------------------------------------
-- Prendre / suivre
----------------------------------------------------------------------

function FurnitureEdit.Raycast(self: any, position: Vector2): (RaycastResult?, any)
	local house = self.Ctx.GetHouse()
	local camera = workspace.CurrentCamera
	if not house or not camera then
		return nil, nil
	end
	local ray = camera:ViewportPointToRay(position.X, position.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	local include: { Instance } = {}
	for _, room in pairs(house.Rooms) do
		if room.Shell then
			local items = room.Shell:FindFirstChild("Items")
			if items then
				table.insert(include, items)
			end
		end
	end
	params.FilterDescendantsInstances = include
	local result = workspace:Raycast(ray.Origin, ray.Direction * 250, params)
	return result, house
end

function FurnitureEdit.Pick(self: any, position: Vector2): boolean
	local result, house = self:Raycast(position)
	local model = result and itemModelOf(result.Instance)
	if not model or not house then
		return false
	end
	self.Pointer = position
	return self:Hold(house, model)
end

-- Prend en main le modèle d'objet `model` de la maison `house`
function FurnitureEdit.Hold(self: any, house: any, model: Model): boolean
	-- pièce : la coque qui contient le modèle (coque > Items > modèle)
	local shell = model.Parent and model.Parent.Parent
	local slot = shell and tonumber(shell:GetAttribute("Slot")) or nil
	local room = slot and house.Rooms[slot]
	local index = tonumber(model:GetAttribute("EntryIndex"))
	if not slot or not room or not room.Data or not index or not room.Data.Placed[index] then
		return false
	end
	local entry = room.Data.Placed[index]
	local item = HouseCommon.ItemsById[entry.I]
	if not item then
		return false
	end
	local fw, h, fd = footprint(model)
	local frame = WorldLayout.RoomFrame(house.HouseCF, house.Size, slot)
	local rel = frame:ToObjectSpace(model:GetPivot())
	local held: Held = {
		House = house,
		Slot = slot,
		Index = index,
		Model = model,
		Start = model:GetPivot(),
		Entry = entry,
		Item = item,
		Wall = item.Placement == "Wall",
		AgainstWall = model:GetAttribute("AgainstWall") == true,
		FW = fw,
		FD = fd,
		H = h,
		R = WorldLayout.NormalizeRotation(entry.R),
		Frame = frame,
		X = rel.X,
		Y = rel.Y,
		Z = rel.Z,
		TX = nil,
		TY = nil,
		TZ = nil,
		Support = nil,
		Level = nil,
		Followers = {},
		Moved = false,
		New = false,
	}
	-- ce qui suit le meuble (posé dessus, chaises à table)
	local S = surfaces()
	if S and type(S.Dependents) == "function" then
		local dims = dimsOf(house)
		local ok, deps = pcall(S.Dependents, entry, room.Data.Placed, dims.RoomWpx, dims.RoomHpx)
		if ok and type(deps) == "table" then
			local wanted: { [any]: boolean } = {}
			for _, dep in ipairs(deps) do
				wanted[dep] = true
			end
			for _, other in ipairs(room.Items) do
				local otherIndex = tonumber(other:GetAttribute("EntryIndex"))
				local otherEntry = otherIndex and room.Data.Placed[otherIndex]
				if otherIndex and otherEntry and wanted[otherEntry] and other.Parent then
					table.insert(held.Followers, { Model = other, Offset = model:GetPivot():ToObjectSpace(other:GetPivot()), Start = other:GetPivot(), Index = otherIndex })
				end
			end
		end
	end
	self.Held = held
	self:SetHighlight(model, true)
	self.Ctx.Hud:SetEditing(true, true, Locale.T(item.Name))
	return true
end

-- (v9.6) Pièce de sa maison où se trouve son avatar (nil = cage d'escalier / dehors)
function FurnitureEdit.CurrentSlot(_self: any, house: any): number?
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") or type(house.RoomAt) ~= "function" then
		return nil
	end
	local ok, slot = pcall(house.RoomAt, house, root.Position)
	if ok and type(slot) == "number" and house.Rooms[slot] and house.Rooms[slot].Data then
		return slot
	end
	return nil
end

-- (v9.6) Sort un objet de l'inventaire : un fantôme à poser dans la pièce où l'on est
function FurnitureEdit.HoldNew(self: any, itemId: string, fromPurchase: boolean?): boolean
	local item = HouseCommon.ItemsById[itemId]
	local house = self.Ctx.GetHouse()
	if not item or not house or not self.Enabled or self.Saving then
		return false
	end
	if self.Held then
		self:Cancel()
	end
	local slot = self:CurrentSlot(house)
	local room = slot and house.Rooms[slot]
	if not slot or not room or not room.Data then
		self.Ctx.Toast(Locale.T("Go inside one of your rooms to place it"), Color3.fromRGB(255, 170, 90))
		return false
	end
	local data = HouseCommon.GetHouse(ClientState.Data)
	if not fromPurchase and HouseCommon.Available(data, itemId) <= 0 then
		self.Ctx.Toast(Locale.T("Buy one in the shop first!"), Color3.fromRGB(255, 170, 90))
		return false
	end
	local maxItems = tonumber(house.Size and house.Size.RoomItems) or 30
	if #room.Data.Placed >= maxItems then
		self.Ctx.Toast(Locale.T("This room is full (%d items)! Decorate another room 🏡", maxItems), Color3.fromRGB(255, 170, 90))
		return false
	end
	local R = recipes()
	local entry = { I = itemId, X = 0.5, Y = 0.8, S = 1, Z = HouseCommon.DEFAULT_Z }
	local model: Model? = nil
	if R and type(R.BuildItem) == "function" then
		model = R.BuildItem(itemId, entry, { Scale = WorldLayout.PX, Collide = false, Query = false, Shadows = false })
	end
	if not model then
		return false
	end
	local ghost = model :: Model
	ghost.Name = "TownEditGhost"
	for _, part in ipairs(ghost:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			if part.Transparency < 1 then
				part.Transparency = math.max(part.Transparency, GHOST_ALPHA)
			end
		end
	end
	local fw, h, fd = footprint(ghost)
	local frame = WorldLayout.RoomFrame(house.HouseCF, house.Size, slot)
	ghost:PivotTo(frame * CFrame.new(0, 0, WorldLayout.DEPTH / 2) * TURN)
	ghost.Parent = workspace
	self.Held = {
		House = house,
		Slot = slot,
		Index = #room.Data.Placed + 1,
		Model = ghost,
		Start = ghost:GetPivot(),
		Entry = entry,
		Item = item,
		Wall = item.Placement == "Wall",
		AgainstWall = ghost:GetAttribute("AgainstWall") == true,
		FW = fw,
		FD = fd,
		H = h,
		R = nil,
		Frame = frame,
		X = 0,
		Y = 0,
		Z = WorldLayout.DEPTH / 2,
		TX = nil,
		TY = nil,
		TZ = nil,
		Support = nil,
		Level = nil,
		Followers = {},
		Moved = true,
		New = true,
	} :: Held
	-- point de départ : la souris (PC) ou le milieu de l'écran (doigt)
	local camera = workspace.CurrentCamera
	if UserInputService.TouchEnabled and not UserInputService.MouseEnabled and camera then
		self.Pointer = camera.ViewportSize / 2
	elseif not self.Pointer then
		local ok, mouse = pcall(function()
			return UserInputService:GetMouseLocation()
		end)
		self.Pointer = ok and typeof(mouse) == "Vector2" and mouse or (camera and camera.ViewportSize / 2) or Vector2.new(400, 300)
	end
	self:SetHighlight(ghost, true)
	self.Ctx.Hud:SetEditing(true, true, item.Icon .. " " .. Locale.T(item.Name))
	self:Follow()
	return true
end

-- (v9.6) Dessus visé : le meuble `model` touché au point `hit` (monde).
-- Choisit le NIVEAU (la planche juste sous le point visé), la position le
-- long du rayon (libre, sans chevaucher les voisins) ; renvoie la position
-- 3D montrée (repère de la pièce, = House3DLayout) et la 2D à sauvegarder.
function FurnitureEdit.SurfaceTarget(self: any, held: Held, model: Model, hit: Vector3): any?
	local S = surfaces()
	local room = held.House.Rooms[held.Slot]
	local supportIndex = tonumber(model:GetAttribute("EntryIndex"))
	local list = room and room.Data and room.Data.Placed
	local supportEntry = list and supportIndex and list[supportIndex]
	local supportItem = supportEntry and HouseCommon.ItemsById[supportEntry.I]
	if not S or not supportEntry or not supportItem or supportEntry == held.Entry then
		return nil
	end
	local dims = dimsOf(held.House)
	local item = held.Item
	local scale = tonumber(held.Entry.S) or 1
	local height = item.Size * scale / math.max(1, dims.RoomHpx)
	local ok, levels = pcall(S.Of, supportEntry, dims.RoomWpx, dims.RoomHpx)
	if not ok or type(levels) ~= "table" then
		return nil
	end
	local pivot = model:GetPivot()
	local localHit = pivot:PointToObjectSpace(hit)
	local minY = S.MinY()
	local best, bestTop = nil, nil
	local lowest, lowestTop = nil, nil
	for _, level in ipairs(levels) do
		local top = topLocal(model, level.Index, supportEntry, supportItem)
		local _, clampedY = HouseCommon.ClampPosition(item, (level.L + level.R) / 2, level.Y, scale, dims.RoomWpx, dims.RoomHpx, true)
		if top and level.Y >= minY and S.Fits(level, height) and level.R - level.L > 0.005 and math.abs(clampedY - level.Y) < 0.004 then
			if top.Y <= localHit.Y + LEVEL_REACH and (not bestTop or top.Y > bestTop.Y) then
				best, bestTop = level, top
			end
			if not lowestTop or top.Y < lowestTop.Y then
				lowest, lowestTop = level, top
			end
		end
	end
	if not best then
		best, bestTop = lowest, lowestTop
	end
	if not best or not bestTop then
		return nil
	end
	local level = best
	local top = bestTop :: Vector3
	-- le long du rayon : axe "droite de la pièce" = -X du modèle (devant -Z)
	local roomW = math.max(0.1, dims.W)
	local centerX = (level.L + level.R) / 2
	local X = centerX + (-(localHit.X - top.X)) / roomW
	if self.Snap then
		X = centerX + WorldLayout.Snap((X - centerX) * roomW, GRID / 2) / roomW
	end
	X = math.clamp(X, level.L, level.R)
	local skip: { [any]: boolean } = { [held.Entry] = true }
	for _, follower in ipairs(held.Followers) do
		local other = list[follower.Index]
		if other then
			skip[other] = true
		end
	end
	X = S.FreeX(level, list, item, scale, X, dims.RoomWpx, dims.RoomHpx, skip)
	local Y
	X, Y = HouseCommon.ClampPosition(item, X, level.Y, scale, dims.RoomWpx, dims.RoomHpx, true)
	X, Y = WorldLayout.Round4(X), WorldLayout.Round4(Y)
	-- 3D : même calcul que House3DLayout (dessus du meuble + décalage le long du rayon)
	local half = (level.R - level.L) / 2 * roomW
	local dx = math.clamp((X - centerX) * roomW, -half, half)
	local world = (pivot * CFrame.new(top)).Position + (-pivot.RightVector) * dx
	local rel = held.Frame:PointToObjectSpace(world)
	local plateCF = pivot * CFrame.new(top)
	return {
		X = rel.X,
		Y = rel.Y,
		Z = rel.Z,
		TX = X,
		TY = Y,
		TZ = math.min(HouseCommon.MAX_Z, (tonumber(supportEntry.Z) or 100) + 1),
		Level = level.Index,
		Plate = plateCF,
		PlateSize = Vector2.new(half * 2, math.min(3, math.max(0.4, held.FD * 1.2))),
	}
end

-- (v9.6) Le rayon passe juste au-dessus d'un dessus (plan horizontal de
-- chaque dessus, avec une petite marge) : (meuble, point sur le dessus)
local TOP_MARGIN = 0.35
function FurnitureEdit.NearTop(_self: any, held: Held, ray: Ray, models: { Instance }): (Model?, Vector3?)
	local room = held.House.Rooms[held.Slot]
	local list = room and room.Data and room.Data.Placed
	local S = surfaces()
	if not list or not S then
		return nil, nil
	end
	local bestModel, bestPoint, bestT = nil, nil, math.huge
	for _, instance in ipairs(models) do
		local model = instance :: Model
		local index = tonumber(model:GetAttribute("EntryIndex"))
		local entry = index and list[index]
		local item = entry and HouseCommon.ItemsById[entry.I]
		local raw = entry and S.Raw(entry.I)
		if entry and item and raw and entry ~= held.Entry then
			local pivot = model:GetPivot()
			local _, _, fd = footprint(model)
			local k = unitK(item, tonumber(entry.S) or 1)
			for level = 1, #raw do
				local top = topLocal(model, level, entry, item)
				if top then
					local world = pivot * top
					local dy = ray.Direction.Y
					if math.abs(dy) > 1e-4 then
						local t = (world.Y - ray.Origin.Y) / dy
						if t > 0 and t < bestT then
							local p = ray.Origin + ray.Direction * t
							local rel = pivot:PointToObjectSpace(p)
							local s = raw[level]
							local halfW = ((tonumber(s[2]) or 90) - (tonumber(s[1]) or 10)) * k / 2
							if math.abs(rel.X - top.X) <= halfW + TOP_MARGIN and math.abs(rel.Z - top.Z) <= fd * 0.5 + TOP_MARGIN then
								bestModel, bestPoint, bestT = model, p + Vector3.new(0, 0.01, 0), t
							end
						end
					end
				end
			end
		end
	end
	return bestModel, bestPoint
end

-- Chaque image (seulement en main) : le meuble suit le pointeur
function FurnitureEdit.Follow(self: any)
	local held: Held? = self.Held
	if not held then
		-- survol (PC) : on montre ce qu'on peut prendre
		local pointer = self.Pointer
		if pointer and not (UserInputService.TouchEnabled and not UserInputService.MouseEnabled) then
			local result = self:Raycast(pointer)
			local model = result and itemModelOf(result.Instance)
			if model ~= self.Hover then
				self.Hover = model
				self:SetHighlight(model, false)
			end
		end
		return
	end
	local pointer = self.Pointer
	local camera = workspace.CurrentCamera
	if not pointer or not camera then
		return
	end
	local ray = camera:ViewportPointToRay(pointer.X, pointer.Y)
	local house = held.House
	local dims = dimsOf(house)
	local frame = held.Frame
	local item = held.Item
	local scale = tonumber(held.Entry.S) or 1
	if held.Wall then
		local p = hitPlane(frame, ray.Origin, ray.Direction, "z")
		if not p then
			return
		end
		local x, y = p.X, p.Y - held.H / 2
		if self.Snap then
			x = WorldLayout.Snap(x, GRID)
			y = WorldLayout.Snap(y, GRID / 2)
		end
		-- (v9.6) borné à la zone murale de la 2D (le fantôme = ce qui sera sauvé)
		local x0, x1, y0, y1 = HouseCommon.PlacementArea(item, scale, dims.RoomWpx, dims.RoomHpx)
		local X, Y
		x, y, X, Y = WorldLayout.WallClamp(dims, x, y, held.FW, unitK(item, scale), x0, x1, y0, y1)
		held.X, held.Y, held.Z = x, y, 0.02
		held.TX, held.TY, held.TZ = X, Y, tonumber(held.Entry.Z) or HouseCommon.DEFAULT_Z
		held.Support, held.Level = nil, nil
		self:SetTarget(nil)
	else
		-- au-dessus d'un meuble avec un dessus ? (petits objets seulement)
		local target: any = nil
		local supportModel: Model? = nil
		local S = surfaces()
		if HouseCommon.CanGoOnFurniture(item) and S then
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Include
			local room = house.Rooms[held.Slot]
			local include: { Instance } = {}
			-- (v9.6) seulement les meubles qui ont un dessus : le rayon traverse
			-- les petits objets déjà posés et trouve le rayon / la table dessous
			for _, other in ipairs(room and room.Items or {}) do
				if other ~= held.Model and other.Parent and S.Has(tostring(other:GetAttribute("ItemId"))) then
					local isFollower = false
					for _, f in ipairs(held.Followers) do
						if f.Model == other then
							isFollower = true
						end
					end
					if not isFollower then
						table.insert(include, other)
					end
				end
			end
			params.FilterDescendantsInstances = include
			local hit = workspace:Raycast(ray.Origin, ray.Direction * 250, params)
			local model = hit and itemModelOf(hit.Instance)
			if model and hit and S.Has(tostring(model:GetAttribute("ItemId"))) then
				target = self:SurfaceTarget(held, model, hit.Position)
				supportModel = target and model or nil
			end
			-- (v9.6) pointeur juste AU-DESSUS d'un dessus (table basse vue de
			-- face, le rayon passe au-dessus) : on le "voit" quand même
			if not target then
				local near, point = self:NearTop(held, ray, include)
				if near and point then
					target = self:SurfaceTarget(held, near, point)
					supportModel = target and near or nil
				end
			end
		end
		if target then
			held.X, held.Y, held.Z = target.X, target.Y, target.Z
			held.TX, held.TY, held.TZ = target.TX, target.TY, target.TZ
			held.Support, held.Level = supportModel, target.Level
			self:SetTarget(supportModel, target.Plate, target.PlateSize)
		else
			local p = hitPlane(frame, ray.Origin, ray.Direction, "y")
			if not p then
				return
			end
			local x, z = p.X, p.Z
			if self.Snap then
				x = WorldLayout.Snap(x, GRID)
				z = WorldLayout.Snap(z, GRID)
			end
			-- (v9.6) borné à ce qui retombe DANS la bande du sol de la 2D
			local x0, x1, y0, y1 = HouseCommon.PlacementArea(item, scale, dims.RoomWpx, dims.RoomHpx, false)
			local X, Y
			x, z, X, Y = WorldLayout.FloorClamp(dims, x, z, held.FW, held.FD, x0, x1, y0, y1, held.AgainstWall)
			held.X, held.Y, held.Z = x, 0, z
			held.TX, held.TY, held.TZ = X, Y, tonumber(held.Entry.Z) or HouseCommon.DEFAULT_Z
			held.Support, held.Level = nil, nil
			self:SetTarget(nil)
		end
	end
	held.Moved = true
	self:Place()
end

-- Pose le modèle tenu (et ses suiveurs) à sa position actuelle
function FurnitureEdit.Place(self: any)
	local held: Held? = self.Held
	if not held then
		return
	end
	local yaw = held.Wall and 0 or math.rad(held.R or 0)
	local pivot = held.Frame * CFrame.new(held.X, held.Y, held.Z) * CFrame.Angles(0, yaw, 0) * TURN
	held.Model:PivotTo(pivot)
	for _, follower in ipairs(held.Followers) do
		if follower.Model.Parent then
			follower.Model:PivotTo(pivot * follower.Offset)
		end
	end
end

----------------------------------------------------------------------
-- Actions
----------------------------------------------------------------------

function FurnitureEdit.Rotate(self: any, delta: number?)
	local held: Held? = self.Held
	if not held or held.Wall then
		return
	end
	held.R = WorldLayout.Rotate(held.R, delta or ROTATE_STEP)
	-- les suiveurs tournent avec le meuble
	self:Place()
end

function FurnitureEdit.ToggleSnap(self: any)
	self.Snap = not self.Snap
	self.Ctx.Hud:SetSnap(self.Snap)
end

-- Lâche le modèle tenu (le fantôme d'un objet neuf disparaît)
function FurnitureEdit.Release(self: any, held: Held)
	self.Held = nil
	if held.New and held.Model.Parent then
		held.Model:Destroy()
	end
	self:SetHighlight(nil, false)
	self:SetTarget(nil)
	self.Ctx.Hud:SetEditing(self.Enabled, false)
end

function FurnitureEdit.Cancel(self: any)
	local held: Held? = self.Held
	if not held then
		return
	end
	if not held.New then
		if held.Model.Parent then
			held.Model:PivotTo(held.Start)
		end
		for _, follower in ipairs(held.Followers) do
			if follower.Model.Parent then
				follower.Model:PivotTo(follower.Start)
			end
		end
	end
	self:Release(held)
end

-- Copie d'une liste d'objets posés (format du serveur, avec R)
local function copyList(list: { any }): { any }
	local result = {}
	for index, e in ipairs(list) do
		result[index] = { I = e.I, X = e.X, Y = e.Y, S = e.S, Z = e.Z, F = e.F, C = e.C, R = e.R }
	end
	return result
end

-- Nouvelle position 2D (X, Y, Z) de l'objet tenu : celle calculée en le
-- suivant (déjà dans la zone valide) ; sinon sa position actuelle
function FurnitureEdit.Compute2D(_self: any, held: Held, list: { any }): (number, number, number)
	local entry = list[held.Index] or held.Entry
	if held.TX and held.TY then
		return held.TX, held.TY, held.TZ or tonumber(entry.Z) or HouseCommon.DEFAULT_Z
	end
	return tonumber(entry.X) or 0.5, tonumber(entry.Y) or 0.8, tonumber(entry.Z) or HouseCommon.DEFAULT_Z
end

function FurnitureEdit.Commit(self: any, held: Held, list: { any }, message: string)
	local house = held.House
	local room = house.Rooms[held.Slot]
	if not room or not room.Data then
		return
	end
	local previous = copyList(room.Data.Placed)
	-- la pièce est reconstruite tout de suite (même rendu qu'après un rechargement)
	house:SetRoomPlaced(held.Slot, list)
	self.Saving = true
	self.Ctx.Save(held.Slot, tostring(room.Data.Id), list, function(ok: boolean, reply: string?)
		self.Saving = false
		if ok then
			self.Ctx.Toast(message, Color3.fromRGB(80, 200, 160))
		else
			self.Ctx.Toast(reply or Locale.T("Network error, try again."), Color3.fromRGB(226, 80, 90))
			if house.Alive then
				house:SetRoomPlaced(held.Slot, previous)
			end
		end
		self:RefreshTray(true)
	end)
end

function FurnitureEdit.Drop(self: any)
	local held: Held? = self.Held
	if not held then
		return
	end
	local room = held.House.Rooms[held.Slot]
	if not room or not room.Data or self.Saving then
		self:Cancel()
		return
	end
	local list = copyList(room.Data.Placed)
	if held.New then
		-- (v9.6) objet de l'inventaire : une nouvelle entrée dans la pièce
		if not held.TX then
			self:Follow()
		end
		local X, Y, Z = self:Compute2D(held, list)
		table.insert(list, { I = held.Item.Id, X = WorldLayout.Round4(X), Y = WorldLayout.Round4(Y), S = 1, Z = Z, R = not held.Wall and held.R or nil })
		self:Release(held)
		self:Commit(held, list, Locale.T("✨ %s placed!", held.Item.Icon .. " " .. Locale.T(held.Item.Name)))
		return
	end
	local entry = list[held.Index]
	if not entry then
		self:Cancel()
		return
	end
	local oldX, oldY = tonumber(entry.X) or 0.5, tonumber(entry.Y) or 0.8
	local X, Y, Z = self:Compute2D(held, list)
	entry.X = WorldLayout.Round4(X)
	entry.Y = WorldLayout.Round4(Y)
	entry.Z = Z
	entry.R = not held.Wall and held.R or entry.R
	-- ce qui suit (posé dessus, chaises) : même décalage en 2D, dans sa zone
	local dx, dy = entry.X - oldX, entry.Y - oldY
	local dims = dimsOf(held.House)
	for _, follower in ipairs(held.Followers) do
		local other = list[follower.Index]
		local otherItem = other and HouseCommon.ItemsById[other.I]
		if other and otherItem then
			local x, y = (tonumber(other.X) or 0.5) + dx, (tonumber(other.Y) or 0.8) + dy
			x, y = HouseCommon.ClampPosition(otherItem, x, y, tonumber(other.S) or 1, dims.RoomWpx, dims.RoomHpx, HouseCommon.CanGoOnFurniture(otherItem))
			other.X = WorldLayout.Round4(x)
			other.Y = WorldLayout.Round4(y)
		end
	end
	local moved = held.Moved
	self:Release(held)
	if not moved and held.R == WorldLayout.NormalizeRotation(room.Data.Placed[held.Index].R) then
		return
	end
	self:Commit(held, list, Locale.T("🏠 Layout saved"))
end

function FurnitureEdit.PutAway(self: any)
	local held: Held? = self.Held
	if not held then
		return
	end
	if held.New then
		-- (fantôme : il retourne simplement dans l'inventaire)
		self:Release(held)
		return
	end
	local room = held.House.Rooms[held.Slot]
	if not room or not room.Data or self.Saving then
		self:Cancel()
		return
	end
	local list = copyList(room.Data.Placed)
	-- ce qui est posé DESSUS part aussi dans l'inventaire (les chaises restent)
	local remove: { [number]: boolean } = { [held.Index] = true }
	local S = surfaces()
	if S then
		local dims = dimsOf(held.House)
		for _, follower in ipairs(held.Followers) do
			local other = room.Data.Placed[follower.Index]
			local ok, support = pcall(S.SupportOf, other, room.Data.Placed, dims.RoomWpx, dims.RoomHpx)
			if ok and support then
				remove[follower.Index] = true
			end
		end
	end
	local kept = {}
	for index, e in ipairs(list) do
		if not remove[index] then
			table.insert(kept, e)
		end
	end
	self:Release(held)
	self:Commit(held, kept, Locale.T("📦 Put back in your inventory"))
end

function FurnitureEdit.IsHolding(self: any): boolean
	return self.Held ~= nil
end

----------------------------------------------------------------------
-- (v9.6) 📦 Plateau d'inventaire (objets possédés mais pas posés) + achat
----------------------------------------------------------------------

type Tray = {
	Gui: ScreenGui,
	Root: Frame,
	Scale: UIScale,
	Panel: Frame,
	Title: TextLabel,
	Toggle: TextButton,
	BuyButton: TextButton,
	BackButton: TextButton,
	Chips: ScrollingFrame,
	Grid: ScrollingFrame,
	Empty: TextLabel,
	Tiles: { Instance },
	ChipButtons: { Instance },
}

-- Objets rangés (possédés - posés dans toutes les pièces), triés par catégorie
local function inventory(): { { Item: any, Count: number } }
	local house = HouseCommon.GetHouse(ClientState.Data)
	local result = {}
	for _, item in ipairs(HouseCommon.Config.Items) do
		local count = HouseCommon.Available(house, item.Id)
		if count > 0 then
			table.insert(result, { Item = item, Count = count })
		end
	end
	return result
end

local function categoryOrder(id: string): number
	for index, category in ipairs(HouseCommon.Config.Categories) do
		if category.Id == id then
			return index
		end
	end
	return 999
end

function FurnitureEdit.BuildTray(self: any)
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local old = playerGui:FindFirstChild(GUI_NAME)
	if old then
		old:Destroy()
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = GUI_NAME
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 21
	gui.Enabled = false
	gui.Parent = playerGui
	-- (comme TownHud : une toile "Root" à l'échelle de l'écran)
	local root = UIUtil.Create("Frame", {
		Name = "Root",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(1100, 620),
		Parent = gui,
	})
	local scale = UIUtil.Create("UIScale", { Parent = root })

	local panel = UIUtil.Create("Frame", {
		Name = "InventoryTray",
		Position = UDim2.fromOffset(10, 66),
		Size = UDim2.fromOffset(300, 420),
		BackgroundColor3 = CARD,
		Parent = root,
	})
	UIUtil.Corner(panel, 20)
	UIUtil.Stroke(panel, LILAC, 2, 0.1)
	UIUtil.Shadow(panel, 3, 0.8)
	UIUtil.SinkClicks(panel)
	UIUtil.Gradient(panel, ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(246, 238, 255)), 90)

	local title = UIUtil.Create("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		TextColor3 = INK,
		TextSize = 19,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = "",
		Position = UDim2.fromOffset(14, 8),
		Size = UDim2.new(1, -60, 0, 34),
		ZIndex = 2,
		Parent = panel,
	})
	local toggle = UIUtil.PillButton({ Name = "TrayToggle", Text = "▾", Color = WHITE, TextColor3 = INK, Height = 30, Round = true, TextSize = 18, Parent = panel })
	toggle.AnchorPoint = Vector2.new(1, 0)
	toggle.Position = UDim2.new(1, -10, 0, 10)
	toggle.ZIndex = 3
	-- (en bas, toute la largeur : "🛍️ Acheter" / retour à l'inventaire)
	local buy = UIUtil.PillButton({ Name = "TrayBuy", Text = Locale.T("🛍️ Buy"), Color = PINK_DEEP, Height = 40, TextSize = 18, Parent = panel })
	buy.AutomaticSize = Enum.AutomaticSize.None
	buy.AnchorPoint = Vector2.new(0.5, 1)
	buy.Position = UDim2.new(0.5, 0, 1, -10)
	buy.Size = UDim2.new(1, -24, 0, 40)
	buy.ZIndex = 3
	local back = UIUtil.PillButton({ Name = "TrayBack", Text = Locale.T("📦 Inventory"), Color = SKY, Height = 40, TextSize = 18, Parent = panel })
	back.AutomaticSize = Enum.AutomaticSize.None
	back.AnchorPoint = Vector2.new(0.5, 1)
	back.Position = UDim2.new(0.5, 0, 1, -10)
	back.Size = UDim2.new(1, -24, 0, 40)
	back.ZIndex = 3
	back.Visible = false

	local chips = UIUtil.Create("ScrollingFrame", {
		Name = "Chips",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(10, 46),
		Size = UDim2.new(1, -20, 0, 34),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		ScrollingDirection = Enum.ScrollingDirection.X,
		ScrollBarThickness = 0,
		ZIndex = 2,
		Parent = panel,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = chips,
	})
	UIUtil.Create("UIPadding", { PaddingLeft = UDim.new(0, 3), PaddingRight = UDim.new(0, 3), Parent = chips })

	local grid = UIUtil.Create("ScrollingFrame", {
		Name = "Grid",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(8, 86),
		Size = UDim2.new(1, -16, 1, -144),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = LILAC,
		ZIndex = 2,
		Parent = panel,
	})
	UIUtil.Create("UIGridLayout", {
		CellSize = UDim2.fromOffset(84, 92),
		CellPadding = UDim2.fromOffset(6, 6),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})
	UIUtil.Create("UIPadding", { PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 6), Parent = grid })
	local empty = UIUtil.Create("TextLabel", {
		Name = "Empty",
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		TextColor3 = INK,
		TextSize = 16,
		TextWrapped = true,
		Text = "",
		Position = UDim2.fromOffset(20, 110),
		Size = UDim2.new(1, -40, 0, 80),
		Visible = false,
		ZIndex = 3,
		Parent = panel,
	})

	local tray: Tray = {
		Gui = gui,
		Root = root,
		Scale = scale,
		Panel = panel,
		Title = title,
		Toggle = toggle,
		BuyButton = buy,
		BackButton = back,
		Chips = chips,
		Grid = grid,
		Empty = empty,
		Tiles = {},
		ChipButtons = {},
	}
	self.Tray = tray
	toggle.Activated:Connect(function()
		self.TrayOpen = not self.TrayOpen
		self:LayoutTray()
	end)
	buy.Activated:Connect(function()
		self:OpenBuy()
	end)
	back.Activated:Connect(function()
		self.TrayView = "Inventory"
		self:RefreshTray(true)
	end)
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:LayoutTray()
	end)
	self:LayoutTray()
end

-- Taille / place du plateau (PC : à gauche ; téléphone : compact, au-dessus du joystick)
function FurnitureEdit.LayoutTray(self: any)
	local tray: Tray? = self.Tray
	if not tray then
		return
	end
	local size = tray.Gui.AbsoluteSize
	if size.X < 10 or size.Y < 10 then
		-- (pas encore mesuré : la taille de l'écran)
		local camera = workspace.CurrentCamera
		size = camera and camera.ViewportSize or Vector2.new(1280, 720)
	end
	local touch = UserInputService.TouchEnabled and not UserInputService.MouseEnabled
	local phone = touch and math.min(size.X, size.Y) < 500
	local designW, designH = phone and 820 or 1100, phone and 430 or 620
	local scale = math.clamp(math.min(size.X / designW, size.Y / designH), 0.45, 1.35)
	tray.Scale.Scale = scale
	tray.Root.Size = UDim2.fromOffset(size.X / scale, size.Y / scale)
	local h = size.Y / scale
	-- (bas : la barre d'édition du HUD au PC, le joystick au téléphone)
	local top = phone and 62 or 66
	local bottom = phone and 150 or 96
	local width = phone and 250 or 300
	local height = self.TrayOpen and math.max(170, math.min(480, h - top - bottom)) or 50
	tray.Panel.Position = UDim2.fromOffset(phone and 8 or 10, top)
	tray.Panel.Size = UDim2.fromOffset(width, height)
	tray.Toggle.Text = self.TrayOpen and "▾" or "▸"
	tray.Chips.Visible = self.TrayOpen
	tray.Grid.Visible = self.TrayOpen
	tray.Empty.Visible = self.TrayOpen and tray.Empty.Text ~= ""
	local buying = self.TrayView == "Buy"
	tray.BuyButton.Visible = self.TrayOpen and not buying
	tray.BackButton.Visible = self.TrayOpen and buying
	local grid = tray.Grid:FindFirstChildOfClass("UIGridLayout")
	if grid then
		local cell = phone and 70 or 84
		grid.CellSize = UDim2.fromOffset(cell, cell + 8)
	end
end

function FurnitureEdit.ShowTray(self: any, visible: boolean)
	local tray: Tray? = self.Tray
	if not tray then
		return
	end
	tray.Gui.Enabled = visible
	if visible then
		self.TrayView = "Inventory"
		self:LayoutTray()
		self:RefreshTray(true)
	end
end

local function clearList(list: { Instance })
	for _, child in ipairs(list) do
		child:Destroy()
	end
	table.clear(list)
end

-- Une case (icône, nom, nombre en pastille ou prix sous l'icône)
local function makeTile(parent: Instance, item: any, badge: string, badgeColor: Color3, order: number, dim: boolean, price: boolean?): TextButton
	local tile = UIUtil.Create("TextButton", {
		Name = "Tile_" .. item.Id,
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = dim and Color3.fromRGB(238, 234, 244) or WHITE,
		LayoutOrder = order,
		ZIndex = 3,
		Parent = parent,
	})
	UIUtil.Corner(tile, 14)
	UIUtil.Stroke(tile, HouseCommon.CategoryTint(item.Category), 2, dim and 0.6 or 0.15)
	UIUtil.Create("TextLabel", {
		Name = "Icon",
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = item.Icon,
		TextSize = price and 28 or 34,
		TextTransparency = dim and 0.45 or 0,
		Position = UDim2.fromOffset(0, price and 2 or 6),
		Size = UDim2.new(1, 0, 0, price and 36 or 42),
		ZIndex = 4,
		Parent = tile,
	})
	UIUtil.Create("TextLabel", {
		Name = "Name",
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		Text = Locale.T(item.Name),
		TextColor3 = INK,
		TextSize = 12,
		TextTruncate = Enum.TextTruncate.AtEnd,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -4),
		Size = UDim2.new(1, -8, 0, 16),
		ZIndex = 4,
		Parent = tile,
	})
	local pill = UIUtil.Create("TextLabel", {
		Name = "Badge",
		BackgroundColor3 = badgeColor,
		Font = Theme.Fonts.Number,
		Text = badge,
		TextColor3 = WHITE,
		TextSize = 12,
		AutomaticSize = Enum.AutomaticSize.X,
		AnchorPoint = price and Vector2.new(0.5, 0) or Vector2.new(1, 0),
		Position = price and UDim2.new(0.5, 0, 0, 40) or UDim2.new(1, -4, 0, 4),
		Size = UDim2.fromOffset(0, 18),
		ZIndex = 5,
		Parent = tile,
	})
	UIUtil.Corner(pill, UDim.new(1, 0))
	UIUtil.Create("UIPadding", { PaddingLeft = UDim.new(0, 5), PaddingRight = UDim.new(0, 5), Parent = pill })
	UIUtil.AnimateButton(tile, 1.05, 0.93)
	return tile
end

-- Rafraîchit le plateau (force = même si rien n'a changé)
function FurnitureEdit.RefreshTray(self: any, force: boolean?)
	local tray: Tray? = self.Tray
	if not tray or not tray.Gui.Enabled then
		return
	end
	local buying = self.TrayView == "Buy"
	local items = inventory()
	local total = 0
	local signature = { self.TrayView, tostring(self.Filter) }
	for _, entry in ipairs(items) do
		total += entry.Count
		table.insert(signature, entry.Item.Id .. "=" .. entry.Count)
	end
	if buying then
		table.insert(signature, tostring(math.floor(HouseCommon.Dopamine())))
	end
	local key = table.concat(signature, ",")
	if not force and key == self.TraySignature then
		return
	end
	self.TraySignature = key
	tray.Title.Text = buying and Locale.T("🛍️ Buy") or Locale.T("📦 Inventory (%d)", total)
	-- catégories présentes
	clearList(tray.ChipButtons)
	local present: { [string]: boolean } = {}
	local source: { any } = {}
	if buying then
		local data = ClientState.Data
		local house = HouseCommon.GetHouse(data)
		for _, item in ipairs(HouseCommon.Config.Items) do
			local owned = HouseCommon.Owned(house, item.Id)
			if HouseCommon.IsUnlocked(data, item) and not HouseCommon.IsMaxed(item, owned) then
				table.insert(source, { Item = item, Price = HouseCommon.Price(item, owned) })
			end
		end
	else
		source = items
	end
	for _, entry in ipairs(source) do
		present[entry.Item.Category] = true
	end
	if self.Filter and not present[self.Filter] then
		self.Filter = nil
	end
	local chipSpecs = { { Id = nil, Text = Locale.T("All") } }
	for _, category in ipairs(HouseCommon.Config.Categories) do
		if present[category.Id] then
			table.insert(chipSpecs, { Id = category.Id, Text = category.Icon })
		end
	end
	for order, spec in ipairs(chipSpecs) do
		local selected = spec.Id == self.Filter
		local chip = UIUtil.PillButton({ Name = "Chip_" .. tostring(spec.Id or "All"), Text = spec.Text, Color = selected and LILAC or WHITE,
			TextColor3 = selected and WHITE or INK, Height = 28, TextSize = 15, LayoutOrder = order, Shadow = false, Parent = tray.Chips })
		chip.ZIndex = 3
		chip.Activated:Connect(function()
			self.Filter = spec.Id
			self:RefreshTray(true)
		end)
		table.insert(tray.ChipButtons, chip)
	end
	-- cases
	clearList(tray.Tiles)
	local shown = {}
	for _, entry in ipairs(source) do
		if self.Filter == nil or entry.Item.Category == self.Filter then
			table.insert(shown, entry)
		end
	end
	table.sort(shown, function(a, b)
		if buying and a.Price ~= b.Price then
			return a.Price < b.Price
		end
		local ca, cb = categoryOrder(a.Item.Category), categoryOrder(b.Item.Category)
		if ca ~= cb then
			return ca < cb
		end
		return (a.Item.Order or 0) < (b.Item.Order or 0)
	end)
	local dopamine = HouseCommon.Dopamine()
	for order, entry in ipairs(shown) do
		if order > 120 then
			break
		end
		local item = entry.Item
		local tile
		if buying then
			local affordable = dopamine >= entry.Price
			tile = makeTile(tray.Grid, item, "🧠 " .. NumberFormatter.Format(entry.Price), affordable and MINT or Color3.fromRGB(190, 180, 200), order, not affordable, true)
			tile.Activated:Connect(function()
				self:Buy(item.Id, entry.Price)
			end)
		else
			tile = makeTile(tray.Grid, item, "x" .. tostring(entry.Count), PINK_DEEP, order, false)
			tile.Activated:Connect(function()
				self:HoldNew(item.Id)
			end)
		end
		table.insert(tray.Tiles, tile)
	end
	if #shown == 0 then
		tray.Empty.Text = buying and Locale.T("Nothing to buy here for now") or Locale.T("Everything is placed! 🛍️ Buy something new")
	else
		tray.Empty.Text = ""
	end
	self:LayoutTray()
end

-- "🛍️ Acheter" : le catalogue de la ville (sinon la petite liste d'ici)
function FurnitureEdit.OpenBuy(self: any)
	local shop = shopUI()
	if shop and type(shop.OpenCategory) == "function" then
		-- catégorie : le filtre du plateau, sinon la préférée du type de la pièce
		local category = self.Filter
		if not category then
			local house = self.Ctx.GetHouse()
			local slot = house and self:CurrentSlot(house)
			local room = slot and house.Rooms[slot]
			local roomType = room and room.Data and HouseCommon.RoomTypesById[tostring(room.Data.Type)]
			category = roomType and roomType.Categories[1] or nil
		end
		self.AwaitBuy = true
		if not self.ShopConnection and shop.Bought and type(shop.Bought.Connect) == "function" then
			self.ShopConnection = shop.Bought:Connect(function(itemId: any, kind: any)
				if self.AwaitBuy and self.Enabled and kind == "Item" and type(itemId) == "string" then
					self.AwaitBuy = false
					pcall(function()
						shop.Close()
					end)
					self:HoldNew(itemId, true)
				end
			end)
		end
		local ok = pcall(shop.OpenCategory, category)
		if ok then
			return
		end
		self.AwaitBuy = false
	end
	self.TrayView = "Buy"
	self.TrayOpen = true
	self:RefreshTray(true)
end

-- Achat direct (liste de secours) : action existante "buyItem", puis fantôme
function FurnitureEdit.Buy(self: any, itemId: string, price: number)
	local item = HouseCommon.ItemsById[itemId]
	if not item or self.Buying then
		return
	end
	if HouseCommon.Dopamine() < price then
		self.Ctx.Toast(Locale.T("Not enough Dopamine"), Color3.fromRGB(255, 170, 90))
		return
	end
	self.Buying = true
	task.spawn(function()
		local ok, message = HouseCommon.Invoke("buyItem", itemId)
		self.Buying = false
		if ok then
			self.Ctx.Toast(message or Locale.T("%s is yours!", item.Icon .. " " .. Locale.T(item.Name)), Color3.fromRGB(80, 200, 160))
			self.TrayView = "Inventory"
			self:RefreshTray(true)
			self:HoldNew(itemId, true)
		else
			self.Ctx.Toast(message or Locale.T("Network error, try again."), Color3.fromRGB(226, 80, 90))
		end
	end)
end

function FurnitureEdit.Destroy(self: any)
	self:SetEnabled(false)
	for _, name in ipairs({ "Highlight", "TargetHighlight", "Plate" }) do
		local instance = self[name]
		if instance then
			instance:Destroy()
			self[name] = nil
		end
	end
	if self.ShopConnection then
		pcall(function()
			self.ShopConnection:Disconnect()
		end)
		self.ShopConnection = nil
	end
	local tray: Tray? = self.Tray
	if tray then
		tray.Gui:Destroy()
		self.Tray = nil
	end
end

return FurnitureEdit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="195">
          <Properties>
            <string name="Name">GardenBuilder</string>
            <string name="Source"><![CDATA[--[[
	GardenBuilder (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > GardenBuilder

	🌻 Dopamine Town : le JARDIN DE DOPAMINE d'un joueur en VRAIE 3D, dans le
	jardin de derrière de sa maison (côté client, comme HouseBuilder).
	  - un parterre surélevé par parterre du jeu (Config.Garden.BasePlots +
	    niveaux de "Flower Beds") : planches de bois, poteaux d'angle, terre,
	    touffes d'herbe, étiquette à la couleur de la fleur ; + un parterre
	    "fantôme" 🔒 quand on peut encore en acheter ;
	  - de VRAIES fleurs 3D (Marguerite, Tulipe, Rose, Tournesol, Lotus doré)
	    qui poussent par stades d'après l'heure du serveur :
	    graine -> pousse -> bouton -> fleur -> prête (scintille, se balance) ;
	  - au-dessus de chaque parterre, une étiquette (BillboardGui) : fleur,
	    minuteur + jauge, "✨ PRÊT !" ;
	  - PROPRIÉTAIRE seulement : invite (ProximityPrompt) + clic
	    (ClickDetector) pour cueillir une fleur prête, planter un parterre
	    vide ; invite "🧺 Tout cueillir" sur le panneau dès 2 fleurs prêtes.
	    Tout passe par la RemoteFunction EXISTANTE "Garden" (GardenService) :
	      ("harvest", index) / ("harvestAll") ; un parterre vide est planté
	      par ("harvest", index) : le serveur répare (sanitize) le jardin et
	      replante AVANT de répondre "ça pousse encore" ;
	  - cueillette : éclat de pétales + étincelles dorées + anneau lumineux
	    + "+X 🧠" qui monte (BillboardGui) ;
	  - VISITEURS : tout est visible (fleurs, minuteurs), rien n'est
	    cliquable (aucune invite, aucun ClickDetector) ;
	  - déco : allée de gravier et pas japonais, panneau en bois (SurfaceGui),
	    deux lanternes (vraie lumière la nuit), arrosoir, buissons, papillons,
	    moulin à vent (si le joueur a le moulin "Pinwheel") dont les pales
	    tournent.
	  - v9.8 (GARDEN98) 🌷 JARDIN LIBRE : TOUT ce qui est dans le jardin (les
	    parterres, la déco du jardin choisie dans la maison 2D — avant dessinée
	    avec la façade —, les objets de jardin achetés : pots, massifs,
	    lanterne, banc, kiosque..., et les aménagements : panneau, allées,
	    lanternes, arrosoir, buissons, moulin, bonus des agrandissements :
	    arche de roses, serre, bassin aux carpes qui nagent) est posé où le
	    joueur l'a mis, devant OU derrière la maison (GardenSnapshot.Arrange :
	    places choisies, sinon places par défaut ; repère de la maison).
	    Chaque objet est un Model (attribut GardenKey) reconstruit seulement
	    si sa place change ; tout est retiré loin de la parcelle (> 280
	    studs) et reconstruit en s'approchant (8 objets par pas).
	    Mode édition (GardenEdit) : SetEditing / Preview / MakeGhost /
	    ApplyLocal / KeyOf / PlaceCF / ToLocal.
	  - v9.9 (PARK99) 🪑 ON S'ASSOIT pour de vrai sur le banc, la table de
	    pique-nique, la balancelle et les bancs du kiosque : invite
	    "S'asseoir" (E, tout le monde) -> SitAnimator (s'avancer, s'asseoir,
	    attentes du banc) -> action "sit" du serveur (WorldService, Garden =
	    true : point dans la parcelle). La balancelle se balance (pendule
	    doux, même tirage pour tous : heure d'assise du siège).
	Performance : pièces ancrées, sans collision sauf les bords des bacs ;
	fleurs reconstruites seulement quand leur stade change (au plus 2
	parterres par image) ; animations à 20 Hz, en pause au-delà de ~110
	studs (les fleurs sont même retirées au-delà de ~150 studs) ; aucune
	allocation d'Instance par image ; AUCUN son.

	API :
	  GardenBuilder.new(parent, originCF, areaSize, isOwner, options?) -> Garden
	      originCF : centre du jardin de derrière au niveau de la pelouse,
	                 LookVector = vers la maison (= plotCF.LookVector) ;
	      areaSize : Vector2 (largeur X, profondeur Z) disponible ;
	      options  : { OwnerName: string?, OnHarvest: ((result) -> ())? }
	  garden:Update(gardenState)   (instantané GardenSnapshot, ou nil)
	  garden:SetFocus(position?)   (facultatif : sinon la caméra sert de repère)
	  garden:Destroy()             (aussi automatique si `parent` est détruit)
	  GardenBuilder.BackyardArea(plotCF) -> (originCF, areaSize)
	  GardenBuilder.BackyardCFrame(plotCF) -> originCF ; GardenBuilder.BACKYARD_SIZE (Vector2)
	  GardenBuilder.BuildFlower(flowerId, stage, scale?) -> Model
	      stage = "Seed" | "Sprout" | "Bud" | "Bloom" | "Ready" (ou 0..4) ;
	      modèle tourné vers -Z, pivot = bas centre (posé sur la terre),
	      PrimaryPart "Root", attributs FlowerId / Stage / TopHeight.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")

local Config = require(ReplicatedStorage.Shared.Config)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Net = require(ReplicatedStorage.Shared.Net)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local WorldLayout = require(ReplicatedStorage.Shared.WorldLayout)
local GardenSnapshot = require(ReplicatedStorage.Shared.GardenSnapshot)
local HouseKit = require(script.Parent.HouseKit)
local HouseGarden = require(script.Parent.HouseGarden)

local GardenBuilder = {}
GardenBuilder.__index = GardenBuilder

local M = Enum.Material
local rad = math.rad
local TAU = math.pi * 2

-- Dimensions (studs)
local LAWN_TOP = 0.45 -- dessus de la pelouse de la parcelle (TownMap v9.4)
local BED_W, BED_D, BED_H = 6.2, 3.6, 1.4
local PLANK = 0.4
local _BED_GAP = 3.6 -- (v9.8 : pas des parterres par défaut dans GardenSnapshot.BedSlots)
local PATH_W = 3.4
local SOIL_TOP = BED_H - 0.12

-- Distances (studs) de la caméra au bord du jardin
local ANIM_RANGE = 110 -- animations
local HIDE_RANGE = 175 -- fleurs retirées
local STEP = 1 / 20 -- 20 Hz
local BUILDS_PER_STEP = 2

-- Couleurs
local SOIL = Color3.fromRGB(96, 60, 38)
local SOIL_DARK = Color3.fromRGB(70, 42, 26)
local WOOD = Color3.fromRGB(184, 126, 78)
local WOOD_LIGHT = Color3.fromRGB(214, 160, 106)
local WOOD_DARK = Color3.fromRGB(128, 82, 48)
local STEM = Color3.fromRGB(78, 160, 72)
local LEAF = Color3.fromRGB(98, 186, 86)
local LEAF_DARK = Color3.fromRGB(62, 136, 62)
local GRAVEL = Color3.fromRGB(222, 208, 186)
local STONE = Color3.fromRGB(170, 166, 160)
local GOLD = Color3.fromRGB(255, 204, 64)
local WHITE = Color3.new(1, 1, 1)
local INK = Color3.fromRGB(86, 52, 40)

-- Pétales (même teintes que le jardin 2D) + détails de chaque fleur
local FLOWER_STYLE: { [string]: any } = {
	Daisy = { H = 1.7, Stem = 0.12, Tilt = 35, Petal = Color3.fromRGB(255, 252, 244), Center = Color3.fromRGB(255, 196, 40) },
	Tulip = { H = 2.0, Stem = 0.14, Tilt = 8, Petal = Color3.fromRGB(255, 96, 150), Inner = Color3.fromRGB(255, 160, 196) },
	Rose = { H = 2.1, Stem = 0.13, Tilt = 18, Petal = Color3.fromRGB(214, 28, 62), Inner = Color3.fromRGB(150, 14, 40) },
	Sunflower = { H = 3.9, Stem = 0.26, Tilt = 26, Petal = Color3.fromRGB(255, 196, 32), Inner = Color3.fromRGB(240, 160, 20), Center = Color3.fromRGB(104, 62, 26) },
	Lotus = { H = 0.55, Stem = 0.16, Tilt = 0, Petal = Color3.fromRGB(255, 204, 84), Inner = Color3.fromRGB(255, 234, 168), Center = Color3.fromRGB(255, 222, 120) },
}
local DEFAULT_STYLE = FLOWER_STYLE.Daisy
local STAGE_INDEX = { Seed = 0, Sprout = 1, Bud = 2, Bloom = 3, Ready = 4 }
local STAGE_NAMES = { [0] = "Seed", [1] = "Sprout", [2] = "Bud", [3] = "Bloom", [4] = "Ready" }

local flowersById: { [string]: any } = {}
for _, flower in ipairs(Config.Garden and Config.Garden.Flowers or {}) do
	flowersById[flower.Id] = flower
end

----------------------------------------------------------------------
-- Pièces
----------------------------------------------------------------------

local function newPart(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, solid: boolean?): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.CanCollide = solid == true
	part.CanQuery = solid == true
	part.CanTouch = false
	part.CastShadow = solid == true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Size = Vector3.new(math.max(0.05, size.X), math.max(0.05, size.Y), math.max(0.05, size.Z))
	part.CFrame = cf
	part.Color = color
	part.Material = material or M.SmoothPlastic
	part.Parent = parent
	return part
end

-- Ovale : Part + SpecialMesh "Sphere" (une Ball de Roblox reste ronde)
local function egg(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local part = newPart(parent, name, size, cf, color, material)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = part
	return part
end

local function ball(parent: Instance, name: string, diameter: number, position: Vector3, color: Color3, material: Enum.Material?): Part
	local part = newPart(parent, name, Vector3.new(diameter, diameter, diameter), CFrame.new(position), color, material)
	part.Shape = Enum.PartType.Ball
	return part
end

-- Disque (cylindre) dont l'axe suit le UpVector de `cf`
local function disc(parent: Instance, name: string, diameter: number, thickness: number, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local part = newPart(parent, name, Vector3.new(thickness, diameter, diameter), cf * CFrame.Angles(0, 0, math.pi / 2), color, material)
	part.Shape = Enum.PartType.Cylinder
	return part
end

-- Tube d'un point à un autre (tiges)
local function tube(parent: Instance, name: string, a: Vector3, b: Vector3, diameter: number, color: Color3, material: Enum.Material?): Part
	local delta = b - a
	local length = math.max(0.05, delta.Magnitude)
	local direction = delta.Magnitude > 0.01 and delta.Unit or Vector3.new(0, 1, 0)
	local up = math.abs(direction.Y) > 0.95 and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0)
	local cf = CFrame.lookAt((a + b) / 2, (a + b) / 2 + direction, up) * CFrame.Angles(0, math.pi / 2, 0)
	local part = newPart(parent, name, Vector3.new(length, diameter, diameter), cf, color, material)
	part.Shape = Enum.PartType.Cylinder
	return part
end

local function lerp(a: Color3, b: Color3, t: number): Color3
	return a:Lerp(b, t)
end

----------------------------------------------------------------------
-- Fleurs 3D
----------------------------------------------------------------------

-- Feuille ovale accrochée à la tige à la hauteur y, vers `yaw`, relevée de `lift`°
local function leaf(model: Instance, y: number, yaw: number, length: number, width: number, lift: number, color: Color3)
	local cf = CFrame.new(0, y, 0) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(0, 0, rad(lift)) * CFrame.new(length * 0.46, 0, 0)
	egg(model, "Leaf", Vector3.new(length, 0.06, width), cf, color, M.SmoothPlastic)
end

-- Feuille en lame (tulipe) qui part du pied
local function blade(model: Instance, yaw: number, length: number, width: number, lean: number, color: Color3)
	local cf = CFrame.Angles(0, yaw, 0) * CFrame.Angles(0, 0, rad(lean)) * CFrame.new(0, length * 0.48, 0)
	egg(model, "Leaf", Vector3.new(width, length, 0.07), cf, color, M.SmoothPlastic)
end

-- Tête : repère dont le UpVector est la face de la fleur (penchée vers -Z)
local function headFrame(height: number, tilt: number): CFrame
	return CFrame.new(0, height, 0) * CFrame.Angles(-rad(tilt), 0, 0)
end

-- Couronne de pétales : `count` pétales à `radius` du centre, relevés de `lift`°
local function petalRing(model: Instance, head: CFrame, count: number, radius: number, size: Vector3, lift: number, color: Color3, offset: number?, y: number?)
	for i = 1, count do
		local a = (i - 1) / count * TAU + (offset or 0)
		local cf = head * CFrame.Angles(0, a, 0) * CFrame.new(0, y or 0, 0) * CFrame.Angles(0, 0, rad(lift)) * CFrame.new(radius, 0, 0)
		egg(model, "Petal", size, cf, color, M.SmoothPlastic)
	end
end

-- Pétales dressés en coupe (tulipe, rose, lotus) : `tilt`° vers l'extérieur
local function cupRing(model: Instance, head: CFrame, count: number, radius: number, size: Vector3, tilt: number, color: Color3, offset: number?, y: number?)
	for i = 1, count do
		local a = (i - 1) / count * TAU + (offset or 0)
		local cf = head * CFrame.Angles(0, a, 0) * CFrame.new(0, y or 0, -radius) * CFrame.Angles(-rad(tilt), 0, 0) * CFrame.new(0, size.Y * 0.45, 0)
		egg(model, "Petal", size, cf, color, M.SmoothPlastic)
	end
end

local function sparkles(parent: Part, color: Color3, rate: number)
	local attachment = Instance.new("Attachment")
	attachment.Name = "Sparkle"
	attachment.Parent = parent
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "Sparkles"
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(WHITE, color)
	emitter.LightEmission = 0.4 -- (v9.6 : 1 -> 0.4)
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.05), NumberSequenceKeypoint.new(0.4, 0.32), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	emitter.Lifetime = NumberRange.new(0.8, 1.4)
	emitter.Speed = NumberRange.new(0.4, 1.2)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Acceleration = Vector3.new(0, 0.8, 0)
	emitter.Rate = rate
	emitter.Parent = attachment
end

export type FlowerOptions = { Scale: number?, Detail: boolean?, Fx: boolean?, Hero: boolean? }

-- Construit la plante dans le repère du modèle (pied = origine), renvoie la hauteur
local function buildPlant(model: Model, flowerId: string, stage: number, opts: FlowerOptions): number
	local style = FLOWER_STYLE[flowerId] or DEFAULT_STYLE
	local detail = opts.Detail ~= false
	local hero = opts.Hero ~= false
	local s = 1 -- (mise à l'échelle faite à la fin par le modèle)

	-- Lotus : petite mare + nénuphars (pas de tige visible)
	if flowerId == "Lotus" then
		if hero then
			local water = disc(model, "Water", 2.5, 0.06, CFrame.new(0, 0.06, 0), Color3.fromRGB(104, 178, 224), M.Glass)
			water.Transparency = 0.25
			-- (v9.8 z-fighting : dessus du bord à 0.05 (au-dessus des sillons du bac), de l'eau à 0.09)
			disc(model, "WaterRim", 2.75, 0.1, CFrame.new(0, 0, 0), Color3.fromRGB(120, 104, 90), M.Slate)
		end
		local padCount = stage == 0 and 1 or (stage == 1 and 2 or 3)
		if not hero then
			padCount = math.min(padCount, 2) -- (v9.8 : le 3e frôlait le rebord du bac)
		end
		for i = 1, padCount do
			local a = i * 2.1 + 0.4
			local r = stage == 0 and 0.3 or 0.62
			local d = (stage == 0 and 0.55 or (stage == 1 and 0.8 or 1.0)) * (hero and 1 or 0.8)
			-- (v9.6 z-fighting : nénuphars étagés de 0.03, plus 0.004)
			disc(model, "Pad", d, 0.05, CFrame.new(math.cos(a) * r, 0.09 + i * 0.03, math.sin(a) * r), i % 2 == 0 and LEAF_DARK or LEAF, M.SmoothPlastic)
		end
		if stage == 0 then
			return 0.2
		end
		if stage == 1 then
			-- feuille enroulée qui sort de l'eau
			egg(model, "Curl", Vector3.new(0.16, 0.5, 0.16), CFrame.new(0.1, 0.3, -0.1) * CFrame.Angles(0, 0, rad(12)), LEAF, M.SmoothPlastic)
			return 0.55
		end
		local base = CFrame.new(0, 0.14, -0.05)
		tube(model, "Stem", Vector3.new(0, 0.06, -0.05), Vector3.new(0, 0.18 + (stage >= 3 and style.H or 0.35), -0.05), style.Stem, STEM)
		if stage == 2 then
			local bud = base * CFrame.new(0, 0.55, 0)
			egg(model, "Bud", Vector3.new(0.34, 0.7, 0.34), bud, lerp(style.Petal, Color3.fromRGB(255, 170, 150), 0.25), M.SmoothPlastic)
			egg(model, "BudTip", Vector3.new(0.18, 0.34, 0.18), bud * CFrame.new(0, 0.3, 0), style.Inner, M.SmoothPlastic)
			return 1.2
		end
		local head = base * CFrame.new(0, style.H, 0)
		cupRing(model, head, detail and 9 or 7, 0.16, Vector3.new(0.3, 0.72, 0.1), 62, lerp(style.Petal, WHITE, 0.1), 0, -0.05)
		cupRing(model, head, detail and 8 or 6, 0.1, Vector3.new(0.28, 0.66, 0.1), 36, style.Petal, math.pi / 8, 0)
		cupRing(model, head, detail and 6 or 4, 0.05, Vector3.new(0.22, 0.52, 0.09), 14, style.Inner, 0.3, 0.02)
		local core = egg(model, "Core", Vector3.new(0.3, 0.18, 0.3), head * CFrame.new(0, 0.16, 0), style.Center, stage == 4 and M.Neon or M.SmoothPlastic)
		if stage == 4 and opts.Fx then
			sparkles(core, GOLD, 5)
			local light = Instance.new("PointLight")
			light.Color = Color3.fromRGB(255, 214, 120)
			light.Range = 6 -- (v9.6 : 7 / 1.2 -> 6 / 0.6)
			light.Brightness = 0.6
			light.Shadows = false
			light.Parent = core
		end
		return style.H + 0.9
	end

	-- Graine : petite butte + graines
	if stage == 0 then
		egg(model, "Mound", Vector3.new(0.95, 0.34, 0.95), CFrame.new(0, 0.04, 0), SOIL_DARK, M.Ground)
		egg(model, "Seed", Vector3.new(0.16, 0.1, 0.22), CFrame.new(0.12, 0.17, -0.05) * CFrame.Angles(0, 0.6, 0), Color3.fromRGB(226, 196, 140), M.SmoothPlastic)
		if flowerId == "Sunflower" then
			egg(model, "Seed", Vector3.new(0.12, 0.08, 0.24), CFrame.new(-0.14, 0.16, 0.08) * CFrame.Angles(0, -0.4, 0), Color3.fromRGB(60, 46, 36), M.SmoothPlastic)
		end
		egg(model, "Nub", Vector3.new(0.1, 0.18, 0.1), CFrame.new(-0.04, 0.24, 0), LEAF, M.SmoothPlastic)
		return 0.35
	end

	local fullH = style.H * s
	local stemH = stage == 1 and math.max(0.45, fullH * 0.28) or (stage == 2 and fullH * 0.78 or fullH)
	local tilt = stage >= 3 and style.Tilt or style.Tilt * 0.4
	local head = headFrame(stemH, tilt)
	-- tige légèrement courbée : 2 tubes
	local bend = Vector3.new(0, stemH * 0.55, 0.04)
	local top = head.Position
	tube(model, "Stem", Vector3.new(0, 0, 0), bend, style.Stem, STEM)
	tube(model, "Stem", bend, top, style.Stem * 0.9, STEM)
	egg(model, "Base", Vector3.new(0.5, 0.14, 0.5), CFrame.new(0, 0.02, 0), SOIL_DARK, M.Ground)

	if stage == 1 then
		-- pousse : deux cotylédons
		local size = flowerId == "Sunflower" and 0.62 or 0.44
		leaf(model, stemH, 0.3, size, size * 0.5, 20, LEAF)
		leaf(model, stemH, 0.3 + math.pi, size, size * 0.5, 20, LEAF)
		egg(model, "Tip", Vector3.new(0.12, 0.16, 0.12), CFrame.new(0, stemH + 0.05, 0), lerp(LEAF, WHITE, 0.2), M.SmoothPlastic)
		return stemH + 0.2
	end

	-- feuilles
	if flowerId == "Tulip" then
		blade(model, 0.4, fullH * 0.62, 0.3, 14, LEAF)
		blade(model, 0.4 + math.pi, fullH * 0.55, 0.28, 18, LEAF_DARK)
		if detail then
			blade(model, 1.9, fullH * 0.45, 0.26, 22, LEAF)
		end
	elseif flowerId == "Sunflower" then
		local count = detail and 3 or 2
		for i = 1, count do
			local y = stemH * (0.22 + (i - 1) * 0.22)
			local yaw = i * 2.3
			leaf(model, y, yaw, 1.0, 0.78, 12, i % 2 == 0 and LEAF_DARK or LEAF)
			if detail then
				leaf(model, y + 0.1, yaw + math.pi, 0.9, 0.7, 14, LEAF)
			end
		end
	else
		local length = flowerId == "Rose" and 0.5 or 0.42
		leaf(model, stemH * 0.32, 0.5, length, length * 0.55, 24, LEAF)
		leaf(model, stemH * 0.5, 0.5 + math.pi, length, length * 0.55, 24, LEAF_DARK)
		if detail and stage >= 3 then
			leaf(model, stemH * 0.66, 2.2, length * 0.85, length * 0.5, 28, LEAF)
		end
	end

	-- bouton fermé
	if stage == 2 then
		local tipColor = lerp(style.Petal, LEAF, flowerId == "Daisy" and 0.15 or 0.35)
		if flowerId == "Sunflower" then
			disc(model, "BudDisc", 0.7, 0.2, head, LEAF_DARK, M.SmoothPlastic)
			petalRing(model, head, 8, 0.36, Vector3.new(0.3, 0.06, 0.14), 45, LEAF, 0, 0.02)
			egg(model, "BudTip", Vector3.new(0.4, 0.12, 0.4), head * CFrame.new(0, 0.1, 0), lerp(style.Petal, LEAF, 0.6), M.SmoothPlastic)
			return stemH + 0.5
		end
		egg(model, "Sepal", Vector3.new(0.3, 0.3, 0.3), head * CFrame.new(0, 0.08, 0), LEAF_DARK, M.SmoothPlastic)
		egg(model, "Bud", Vector3.new(0.26, 0.44, 0.26), head * CFrame.new(0, 0.3, 0), tipColor, M.SmoothPlastic)
		return stemH + 0.55
	end

	-- fleur ouverte
	if flowerId == "Daisy" then
		egg(model, "Center", Vector3.new(0.42, 0.2, 0.42), head * CFrame.new(0, 0.05, 0), style.Center, M.SmoothPlastic)
		petalRing(model, head, detail and 14 or 9, 0.4, Vector3.new(0.58, 0.06, 0.17), 8, style.Petal)
		if detail then
			petalRing(model, head, 7, 0.34, Vector3.new(0.5, 0.05, 0.15), 14, lerp(style.Petal, style.Center, 0.12), math.pi / 7, -0.02)
		end
		return stemH + 0.5
	elseif flowerId == "Tulip" then
		egg(model, "Sepal", Vector3.new(0.3, 0.18, 0.3), head, LEAF_DARK, M.SmoothPlastic)
		cupRing(model, head, 3, 0.1, Vector3.new(0.38, 0.8, 0.14), 16, style.Petal, 0, 0.02)
		cupRing(model, head, 3, 0.05, Vector3.new(0.34, 0.74, 0.13), 6, style.Inner, math.pi / 3, 0.04)
		egg(model, "Heart", Vector3.new(0.14, 0.26, 0.14), head * CFrame.new(0, 0.3, 0), Color3.fromRGB(255, 226, 120), M.SmoothPlastic)
		return stemH + 0.95
	elseif flowerId == "Rose" then
		petalRing(model, head, 5, 0.18, Vector3.new(0.3, 0.05, 0.1), -30, LEAF_DARK, 0.2, -0.04)
		cupRing(model, head, detail and 7 or 5, 0.2, Vector3.new(0.42, 0.36, 0.12), 58, lerp(style.Petal, WHITE, 0.08), 0, 0.02)
		cupRing(model, head, 5, 0.13, Vector3.new(0.34, 0.38, 0.11), 32, style.Petal, math.pi / 5, 0.06)
		cupRing(model, head, 4, 0.07, Vector3.new(0.26, 0.36, 0.1), 12, lerp(style.Petal, style.Inner, 0.5), 0.5, 0.1)
		egg(model, "Core", Vector3.new(0.2, 0.26, 0.2), head * CFrame.new(0, 0.26, 0), style.Inner, M.SmoothPlastic)
		return stemH + 0.7
	elseif flowerId == "Sunflower" then
		disc(model, "Back", 1.3, 0.16, head, LEAF_DARK, M.SmoothPlastic)
		petalRing(model, head, detail and 16 or 10, 0.82, Vector3.new(0.74, 0.06, 0.28), 6, style.Petal, 0, 0.09)
		if detail then
			petalRing(model, head, 12, 0.74, Vector3.new(0.66, 0.05, 0.26), 12, style.Inner, math.pi / 12, 0.05)
		end
		disc(model, "Disc", 1.06, 0.14, head * CFrame.new(0, 0.12, 0), style.Center, M.SmoothPlastic)
		egg(model, "Seeds", Vector3.new(0.78, 0.16, 0.78), head * CFrame.new(0, 0.19, 0), Color3.fromRGB(62, 36, 16), M.Fabric)
		return stemH + 0.9
	end
	return stemH + 0.5
end

local function stageNumber(stage: any): number
	if type(stage) == "number" then
		return math.clamp(math.floor(stage), 0, 4)
	end
	return STAGE_INDEX[tostring(stage)] or 3
end

-- Modèle d'une fleur (API publique : SETUP3D95 s'en sert pour les pots)
local function makeFlower(flowerId: string, stage: any, opts: FlowerOptions): Model
	local id = FLOWER_STYLE[flowerId] and flowerId or "Daisy"
	local stageN = stageNumber(stage)
	local model = Instance.new("Model")
	model.Name = "Flower_" .. id
	local root = newPart(model, "Root", Vector3.new(0.2, 0.2, 0.2), CFrame.new(0, 0.1, 0), WHITE, M.SmoothPlastic)
	root.Transparency = 1
	-- (v9.8 : pivot = bas du modèle, comme annoncé ; avant, PivotTo enfonçait
	-- la fleur de 0,1 stud : nénuphars au ras de la terre -> scintillement)
	root.PivotOffset = CFrame.new(0, -0.1, 0)
	model.PrimaryPart = root
	local height = buildPlant(model, id, stageN, opts)
	-- balance des fleurs prêtes : plus grandes, étincelles (option Fx)
	local scale = (opts.Scale or 1) * (stageN == 4 and 1.08 or 1)
	if stageN == 4 and opts.Fx and id ~= "Lotus" then
		local head: Part? = nil
		for _, child in ipairs(model:GetChildren()) do
			if child:IsA("BasePart") and (child.Name == "Center" or child.Name == "Heart" or child.Name == "Core" or child.Name == "Seeds") then
				head = child
			end
		end
		if head then
			sparkles(head, GOLD, 4)
		end
	end
	if math.abs(scale - 1) > 0.001 then
		-- mise à l'échelle autour du pied (pas de ScaleTo : ça marche partout)
		for _, child in ipairs(model:GetChildren()) do
			if child:IsA("BasePart") and child ~= root then
				local cf = child.CFrame
				child.Size *= scale
				child.CFrame = CFrame.new(cf.Position * scale) * cf.Rotation
			end
		end
	end
	model.WorldPivot = CFrame.identity
	model:SetAttribute("FlowerId", id)
	model:SetAttribute("Stage", STAGE_NAMES[stageN])
	model:SetAttribute("TopHeight", height * scale)
	return model
end

function GardenBuilder.BuildFlower(flowerId: string, stage: any, scale: number?): Model
	return makeFlower(flowerId, stage, { Scale = scale or 1, Detail = true, Fx = true, Hero = true })
end

----------------------------------------------------------------------
-- Jardin de derrière : où, quelle taille
----------------------------------------------------------------------

function GardenBuilder.BackyardArea(plotCF: CFrame): (CFrame, Vector2)
	-- (repère de la parcelle : LookVector = vers la place ; +Z = vers le fond)
	local front = WorldLayout.HouseFrontOffset()
	local depth = (WorldLayout.DEPTH or 20) + 2 * (WorldLayout.WALL_T or 1)
	local okDims, dims = pcall(WorldLayout.Dims, nil)
	if okDims and type(dims) == "table" and type(dims.Depth) == "number" then
		depth = dims.Depth
	end
	local back = -front + depth + 2.5 -- dos de la maison + un passage
	local edge = WorldLayout.PLOT_D / 2 - 1.5 -- clôture du fond
	if edge - back < 14 then
		back = edge - 14
	end
	local center = (back + edge) / 2
	return plotCF * CFrame.new(0, LAWN_TOP, center), Vector2.new(WorldLayout.PLOT_W - 8, edge - back)
end

-- (noms utilisés par TownClient : même calcul)
function GardenBuilder.BackyardCFrame(plotCF: CFrame): CFrame
	local cf = GardenBuilder.BackyardArea(plotCF)
	return cf
end
local backyardOrigin, backyardSize = GardenBuilder.BackyardArea(CFrame.identity)
GardenBuilder.BACKYARD_SIZE = backyardSize
local BACKYARD_Z = backyardOrigin.Position.Z -- (repère de la parcelle)

----------------------------------------------------------------------
-- Heure du serveur, textes
----------------------------------------------------------------------

local function rawServerNow(): number
	local ok, value = pcall(function()
		return workspace:GetServerTimeNow()
	end)
	if ok and type(value) == "number" and value == value then
		return value
	end
	return os.time()
end

local function clockText(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	if seconds >= 3600 then
		return string.format("%dh%02d", math.floor(seconds / 3600), math.floor(seconds % 3600 / 60))
	end
	return string.format("%d:%02d", math.floor(seconds / 60), math.floor(seconds % 60))
end

local function flowerLabel(flowerId: string): string
	local flower = flowersById[flowerId]
	if not flower then
		return ""
	end
	return tostring(flower.Icon or "🌸") .. " " .. Locale.T(flower.Name)
end

local function plotsUpgradeName(): string
	for _, upgrade in ipairs(Config.Upgrades or {}) do
		if upgrade.Feature == "GardenPlots" then
			return Locale.T(upgrade.Name)
		end
	end
	return Locale.T("Flower Beds")
end

----------------------------------------------------------------------
-- Objet jardin
----------------------------------------------------------------------

export type Bed = {
	Index: number,
	Kind: string, -- "Plot" | "Ghost" | "Locked"
	CF: CFrame, -- base du bac (pelouse), monde
	Model: Model,
	Plants: Model?,
	Hero: Model?,
	HeroCF: CFrame,
	Tag: BasePart?,
	Hitbox: Part,
	Billboard: BillboardGui,
	Title: TextLabel,
	Timer: TextLabel,
	Bar: Frame,
	Fill: Frame,
	Prompt: ProximityPrompt?,
	Click: ClickDetector?,
	Flower: string,
	Key: string,
	Stage: string,
	Dirty: boolean,
	Pending: boolean,
	TopHeight: number,
	Phase: number,
}

-- (v9.8) un objet du jardin construit (parterre, déco, objet, aménagement)
export type Item = {
	Key: string,
	Sig: string,
	Model: Model,
	Arr: any, -- entrée de GardenSnapshot.Arrange
	CF: CFrame, -- repère posé (devant vers la rue)
	Bed: any?,
	Lights: { PointLight },
	Glows: { BasePart },
	Kois: { BasePart },
	EditBox: BasePart?,
}

export type Garden = typeof(setmetatable({} :: {
	Model: Model,
	Origin: CFrame,
	HouseCF: CFrame,
	Center: Vector3,
	Area: Vector2,
	IsOwner: boolean,
	Options: any,
	State: any,
	Arranged: { any },
	Items: { [string]: Item },
	Pending: { any },
	Beds: { Bed },
	Layout: Folder?,
	Blades: Model?,
	BladesCF: CFrame,
	Butterflies: { any },
	SignPrompt: ProximityPrompt?,
	SignSub: TextLabel?,
	Connections: { RBXScriptConnection },
	Focus: Vector3?,
	FocusUntil: number,
	Near: boolean,
	Animate: boolean,
	Editing: boolean,
	Night: boolean?,
	Clock: number,
	Tick: number,
	Slow: number,
	ClockOffset: number,
	HarvestingAll: boolean,
	Destroyed: boolean,
	EditLayout: any?,
	FlowersNear: boolean?,
	Swings: { [any]: any }?, -- (v9.9 PARK99) balancelles construites
}, GardenBuilder))

-- Distances (studs) de la caméra au centre de la parcelle
local SHOW_ITEMS = 230 -- objets du jardin construits
local HIDE_ITEMS = 280 -- ... retirés
local ITEMS_PER_STEP = 8 -- constructions par pas (20 Hz)
local TURN = CFrame.Angles(0, math.pi, 0) -- repère "devant vers la rue" <-> modèles natifs (devant -Z)

function GardenBuilder.new(parent: Instance, originCF: CFrame, areaSize: Vector2, isOwner: boolean, options: any?): Garden
	local self = setmetatable({}, GardenBuilder) :: any
	self.Origin = originCF
	local plotCF = originCF * CFrame.new(0, -LAWN_TOP, -BACKYARD_Z)
	self.HouseCF = WorldLayout.HouseCFrame(plotCF)
	self.Center = plotCF.Position
	self.Area = areaSize
	self.IsOwner = isOwner == true
	self.Options = type(options) == "table" and options or {}
	self.State = GardenSnapshot.Sanitize(nil)
	self.Arranged = {}
	self.Items = {}
	self.Pending = {}
	self.Beds = {}
	self.Butterflies = {}
	self.Connections = {}
	self.BladesCF = CFrame.identity
	self.FocusUntil = 0
	self.Near = true
	self.Animate = true
	self.Editing = false
	self.Clock = 0
	self.Tick = 0
	self.Slow = 0
	self.ClockOffset = 0
	self.HarvestingAll = false
	self.Destroyed = false

	local model = Instance.new("Model")
	model.Name = "DopamineGarden"
	model:SetAttribute("IsOwner", self.IsOwner)
	self.Model = model

	self:_sync()
	model.Parent = parent

	table.insert(self.Connections, RunService.Heartbeat:Connect(function(dt)
		self:_heartbeat(dt)
	end))
	-- la maison (parent) détruite sans nous : on se nettoie
	table.insert(self.Connections, model.Destroying:Connect(function()
		self:Destroy()
	end))
	return self
end

function GardenBuilder._now(self: Garden): number
	return rawServerNow() + self.ClockOffset
end

-- Repère posé d'un objet du jardin : (x, d) du repère de la maison, R degrés ;
-- R = 0 : le devant de l'objet regarde la rue
function GardenBuilder.PlaceCF(self: Garden, x: number, d: number, r: number?): CFrame
	return self.HouseCF * CFrame.new(x, LAWN_TOP, -d) * CFrame.Angles(0, math.rad(r or 0), 0)
end

-- Point du monde -> (x, d) du repère de la maison
function GardenBuilder.ToLocal(self: Garden, point: Vector3): (number, number)
	local p = self.HouseCF:PointToObjectSpace(point)
	return p.X, -p.Z
end

-- Instantané (GardenSnapshot) -> reconstruit ce qui a changé
function GardenBuilder.Update(self: Garden, gardenState: any)
	if self.Destroyed then
		return
	end
	local state = GardenSnapshot.Sanitize(gardenState)
	-- (mode édition : la disposition affichée est celle en cours d'édition)
	if self.Editing and self.EditLayout then
		state.Layout = self.EditLayout.Layout
		state.Decor = self.EditLayout.Decor
	end
	self.State = state
	self:_sync()
	for _, bed in ipairs(self.Beds) do
		self:_bedPlot(bed, true)
	end
	self:_refreshStages(true)
end

-- (v9.8, mode édition) disposition locale en attendant le serveur
function GardenBuilder.ApplyLocal(self: Garden, layout: { [string]: any }, decor: { string })
	if self.Destroyed then
		return
	end
	self.State.Layout = layout
	self.State.Decor = decor
	if self.Editing then
		self.EditLayout = { Layout = layout, Decor = decor }
	end
	self:_sync()
	self:_buildPending(#self.Pending)
end

function GardenBuilder.SetFocus(self: Garden, position: Vector3?)
	self.Focus = position
	self.FocusUntil = os.clock() + 2
end

----------------------------------------------------------------------
-- Construction du jardin (objets placés)
----------------------------------------------------------------------

local function billboardFor(bed: any, parent: Part)
	local gui = Instance.new("BillboardGui")
	gui.Name = "BedLabel"
	gui.Size = UDim2.fromScale(5, 1.5)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 4, 0)
	gui.MaxDistance = 60
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.ResetOnSpawn = false
	gui.Adornee = parent
	local card = Instance.new("Frame")
	card.Name = "Card"
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	card.Position = UDim2.fromScale(0.5, 0.5)
	card.Size = UDim2.fromScale(0.98, 0.94)
	card.BackgroundColor3 = Color3.fromRGB(255, 251, 244)
	card.BackgroundTransparency = 0.08
	card.BorderSizePixel = 0
	card.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.3, 0)
	corner.Parent = card
	local stroke = Instance.new("UIStroke")
	stroke.Color = WOOD
	stroke.Thickness = 2
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = card
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromScale(0.06, 0.06)
	title.Size = UDim2.fromScale(0.88, 0.46)
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.TextColor3 = INK
	title.Text = ""
	title.Parent = card
	local bar = Instance.new("Frame")
	bar.Name = "Bar"
	bar.Position = UDim2.fromScale(0.08, 0.58)
	bar.Size = UDim2.fromScale(0.84, 0.3)
	bar.BackgroundColor3 = Color3.fromRGB(234, 222, 206)
	bar.BorderSizePixel = 0
	bar.Parent = card
	local barCorner = Instance.new("UICorner")
	barCorner.CornerRadius = UDim.new(1, 0)
	barCorner.Parent = bar
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = Color3.fromRGB(120, 204, 96)
	fill.BorderSizePixel = 0
	fill.Parent = bar
	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = fill
	local timer = Instance.new("TextLabel")
	timer.Name = "Timer"
	timer.BackgroundTransparency = 1
	timer.Position = UDim2.fromScale(0.08, 0.54)
	timer.Size = UDim2.fromScale(0.84, 0.38)
	timer.Font = Enum.Font.GothamBold
	timer.TextScaled = true
	timer.TextColor3 = INK
	timer.TextStrokeColor3 = WHITE
	timer.TextStrokeTransparency = 0.4
	timer.Text = ""
	timer.ZIndex = 2
	timer.Parent = card
	gui.Parent = parent
	bed.Billboard = gui
	bed.Title = title
	bed.Timer = timer
	bed.Bar = bar
	bed.Fill = fill
end

-- Un bac surélevé (planches, poteaux, terre, herbe, étiquette) ; `cf` = repère
-- du bac dans le monde (devant -Z : l'étiquette et les fleurs regardent par là)
function GardenBuilder._buildBed(self: Garden, folder: Instance, index: number, kind: string, cf: CFrame): any
	local model = Instance.new("Model")
	model.Name = kind == "Plot" and ("Bed_" .. index) or ("Bed_" .. kind)
	local ghost = kind == "Ghost"
	local wood = ghost and Color3.fromRGB(226, 206, 180) or WOOD
	local woodLight = ghost and Color3.fromRGB(236, 222, 200) or WOOD_LIGHT
	local w, d, h = BED_W, BED_D, BED_H
	-- planches (2 rangées par côté : on voit les lattes)
	for row = 1, 2 do
		local y = (row - 0.5) * h / 2
		local shade = row == 1 and wood or lerp(wood, woodLight, 0.35)
		for _, side in ipairs({ -1, 1 }) do
			newPart(model, "Plank", Vector3.new(w, h / 2 - 0.05, PLANK), cf * CFrame.new(0, y, side * (d / 2 - PLANK / 2)), shade, M.WoodPlanks, true)
			newPart(model, "Plank", Vector3.new(PLANK, h / 2 - 0.05, d - 2 * PLANK), cf * CFrame.new(side * (w / 2 - PLANK / 2), y, 0), shade, M.WoodPlanks, true)
		end
	end
	-- rebord (chapeau) et poteaux d'angle
	for _, side in ipairs({ -1, 1 }) do
		newPart(model, "Cap", Vector3.new(w + 0.2, 0.14, 0.6), cf * CFrame.new(0, h + 0.07, side * (d / 2 - 0.2)), woodLight, M.Wood)
		newPart(model, "Cap", Vector3.new(0.6, 0.14, d - 0.8), cf * CFrame.new(side * (w / 2 - 0.2), h + 0.07, 0), woodLight, M.Wood)
	end
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			-- (v9.6 : 0.72 et plus 0.62 : les faces du poteau dépassent nettement du
			-- rebord au lieu d'être à 0,01 stud des siennes -> plus de scintillement)
			newPart(model, "Post", Vector3.new(0.72, h + 0.36, 0.72), cf * CFrame.new(sx * (w / 2 - 0.2), (h + 0.36) / 2, sz * (d / 2 - 0.2)), WOOD_DARK, M.Wood)
		end
	end
	-- terre
	if not ghost then
		local soil = newPart(model, "Soil", Vector3.new(w - 2 * PLANK, SOIL_TOP, d - 2 * PLANK), cf * CFrame.new(0, SOIL_TOP / 2, 0), SOIL, M.Ground, true)
		soil.CastShadow = false
		-- sillons
		for k = -1, 1 do
			newPart(model, "Furrow", Vector3.new(w - 2 * PLANK - 0.4, 0.06, 0.18), cf * CFrame.new(0, SOIL_TOP + 0.005, k * 0.95), SOIL_DARK, M.Ground)
		end
		-- touffes d'herbe aux coins du fond
		for _, sx in ipairs({ -1, 1 }) do
			egg(model, "Tuft", Vector3.new(0.9, 0.55, 0.7), cf * CFrame.new(sx * (w / 2 - 0.85), SOIL_TOP + 0.12, d / 2 - 0.75), LEAF_DARK, M.Grass)
		end
	else
		local soil = newPart(model, "Soil", Vector3.new(w - 2 * PLANK, 0.3, d - 2 * PLANK), cf * CFrame.new(0, 0.15, 0), Color3.fromRGB(150, 128, 104), M.Ground)
		soil.Transparency = 0.2
	end
	-- étiquette plantée (couleur de la fleur)
	local tag: BasePart? = nil
	if kind == "Plot" then
		local stake = cf * CFrame.new(w / 2 - 0.9, SOIL_TOP, -(d / 2 - 0.75))
		newPart(model, "Stake", Vector3.new(0.12, 1.0, 0.12), stake * CFrame.new(0, 0.3, 0), WOOD_LIGHT, M.Wood)
		tag = newPart(model, "Tag", Vector3.new(0.6, 0.4, 0.08), stake * CFrame.new(0, 0.86, 0) * CFrame.Angles(rad(-15), 0, 0), WOOD_LIGHT, M.SmoothPlastic)
	end
	-- boîte invisible : clic + invite + étiquette flottante
	local hitbox = newPart(model, "Hitbox", Vector3.new(w, h + 3, d), cf * CFrame.new(0, (h + 3) / 2, 0), WHITE, M.SmoothPlastic)
	hitbox.Transparency = 1
	hitbox.CanQuery = self.IsOwner
	model.Parent = folder

	local bed: any = {
		Index = index,
		Kind = kind,
		CF = cf,
		Model = model,
		HeroCF = cf * CFrame.new(0, SOIL_TOP, 0.15),
		Tag = tag,
		Hitbox = hitbox,
		Flower = "",
		Key = "",
		Stage = "",
		Dirty = kind == "Plot",
		Pending = false,
		TopHeight = 0,
		Phase = index * 1.37,
	}
	billboardFor(bed, hitbox)
	if kind == "Ghost" then
		bed.Title.Text = "🔒 +1 🪴"
		bed.Bar.Visible = false
		bed.Timer.Text = plotsUpgradeName()
		bed.Billboard.StudsOffsetWorldSpace = Vector3.new(0, 2.6, 0)
	elseif kind == "Locked" then
		bed.Title.Text = "🔒 " .. Locale.T("Dopamine Garden")
		bed.Bar.Visible = false
		bed.Timer.Text = Locale.T("The garden isn't unlocked yet")
		bed.Billboard.Enabled = index == 2
		bed.Billboard.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
	end

	-- propriétaire : invite + clic
	if self.IsOwner and kind == "Plot" then
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "GardenPrompt"
		prompt.ActionText = Locale.T("Harvest")
		prompt.ObjectText = ""
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 11
		prompt.RequiresLineOfSight = false
		prompt.Enabled = false
		prompt.Parent = hitbox
		table.insert(self.Connections, prompt.Triggered:Connect(function()
			self:_activate(index)
		end))
		bed.Prompt = prompt
		local click = Instance.new("ClickDetector")
		click.MaxActivationDistance = self.Editing and 0 or 26
		click.Parent = hitbox
		table.insert(self.Connections, click.MouseClick:Connect(function()
			self:_activate(index)
		end))
		bed.Click = click
	end
	return bed
end

-- Allée de gravier (20 studs le long de x) + bordures + pas japonais
local function buildPath(folder: Instance, cf: CFrame)
	local length = 20
	newPart(folder, "Path", Vector3.new(length, 0.12, PATH_W), cf * CFrame.new(0, 0.06, 0), GRAVEL, M.Pebble)
	for _, side in ipairs({ -1, 1 }) do
		newPart(folder, "PathEdge", Vector3.new(length, 0.2, 0.22), cf * CFrame.new(0, 0.14, side * (PATH_W / 2 + 0.1)), Color3.fromRGB(196, 184, 170), M.Slate)
	end
	local stones = 6
	for k = 1, stones do
		local x = -length / 2 + (k - 0.5) * (length / stones)
		local stone = disc(folder, "Stone", 1.7 + (k % 3) * 0.2, 0.12, cf * CFrame.new(x, 0.16, ((k % 2) - 0.5) * 0.5), STONE, M.Slate)
		stone.CastShadow = false
	end
end

-- Panneau en bois "Jardin de Dopamine" (devant -Z du repère `signCF`)
function GardenBuilder._buildSign(self: Garden, folder: Instance, signCF: CFrame)
	for _, sx in ipairs({ -1, 1 }) do
		newPart(folder, "SignPost", Vector3.new(0.35, 4.2, 0.35), signCF * CFrame.new(sx * 2.4, 2.1, 0), WOOD_DARK, M.Wood, true)
	end
	local board = newPart(folder, "SignBoard", Vector3.new(5.6, 2.4, 0.3), signCF * CFrame.new(0, 3.1, 0), WOOD_LIGHT, M.WoodPlanks, true)
	newPart(folder, "SignRoof", Vector3.new(6.2, 0.22, 0.8), signCF * CFrame.new(0, 4.4, 0), WOOD_DARK, M.Wood)
	for k = 1, 3 do
		egg(folder, "SignFlower", Vector3.new(0.5, 0.5, 0.5), signCF * CFrame.new(-2 + k * 1.0, 4.62, -0.15), ({ Color3.fromRGB(255, 110, 160), GOLD, WHITE })[k], M.SmoothPlastic)
	end
	local gui = Instance.new("SurfaceGui")
	gui.Name = "GardenSign"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0.4
	gui.MaxDistance = 120
	gui.ResetOnSpawn = false
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromScale(0.05, 0.08)
	title.Size = UDim2.fromScale(0.9, 0.5)
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.TextColor3 = Color3.fromRGB(92, 50, 30)
	title.Text = "🌻 " .. Locale.T("Dopamine Garden")
	title.Parent = gui
	local sub = Instance.new("TextLabel")
	sub.Name = "Subtitle"
	sub.BackgroundTransparency = 1
	sub.Position = UDim2.fromScale(0.08, 0.6)
	sub.Size = UDim2.fromScale(0.84, 0.3)
	sub.Font = Enum.Font.GothamBold
	sub.TextScaled = true
	sub.TextColor3 = Color3.fromRGB(128, 76, 48)
	sub.Text = ""
	sub.Parent = gui
	gui.Parent = board
	self.SignSub = sub
	self:_signText()
	if self.IsOwner then
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "HarvestAll"
		prompt.ActionText = Locale.T("🧺 Harvest all (%d)", 2)
		prompt.ObjectText = Locale.T("Dopamine Garden")
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 12
		prompt.RequiresLineOfSight = false
		prompt.Enabled = false
		prompt.Parent = board
		table.insert(self.Connections, prompt.Triggered:Connect(function()
			self:_harvestAll()
		end))
		self.SignPrompt = prompt
	end
end

function GardenBuilder._signText(self: Garden)
	local sub = self.SignSub
	if not sub then
		return
	end
	local name = self.Options.OwnerName
	if not self.State.Unlocked then
		sub.Text = Locale.T("🔒 Unlock the Dopamine Garden")
	elseif type(name) == "string" and name ~= "" then
		sub.Text = Locale.T("%s's garden", name)
	else
		sub.Text = "🌷 " .. Locale.T("Dopamine Garden")
	end
end

-- Lanterne sur poteau (vraie lumière douce la nuit)
local function buildLantern(folder: Instance, cf: CFrame, item: any)
	newPart(folder, "LanternPost", Vector3.new(0.3, 3.6, 0.3), cf * CFrame.new(0, 1.8, 0), Color3.fromRGB(70, 64, 70), M.Metal, true)
	newPart(folder, "LanternTop", Vector3.new(0.9, 0.18, 0.9), cf * CFrame.new(0, 4.25, 0), Color3.fromRGB(70, 64, 70), M.Metal)
	local lamp = newPart(folder, "Lamp", Vector3.new(0.62, 0.7, 0.62), cf * CFrame.new(0, 3.8, 0), Color3.fromRGB(255, 226, 160), M.SmoothPlastic)
	lamp:SetAttribute("NightGlow", true)
	table.insert(item.Glows, lamp)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 214, 150)
	light.Range = 12 -- (v9.6 : 14 / 1.4 -> 12 / 0.8)
	light.Brightness = 0.8
	light.Shadows = false
	light.Enabled = false
	light.Parent = lamp
	table.insert(item.Lights, light)
end

-- Buisson rond à baies
local function buildBush(folder: Instance, base: CFrame, side: number)
	ball(folder, "Bush", 2.6, (base * CFrame.new(0, 1.1, 0)).Position, LEAF_DARK, M.Grass)
	ball(folder, "Bush", 1.9, (base * CFrame.new(side * 1.1, 0.8, -0.8)).Position, LEAF, M.Grass)
	for k = 1, 3 do
		ball(folder, "Berry", 0.36, (base * CFrame.new(math.cos(k * 2.1) * 1.05, 1.5 + (k % 2) * 0.4, -0.95 + math.sin(k) * 0.3)).Position, Color3.fromRGB(255, 120, 170), M.SmoothPlastic)
	end
end

-- Arrosoir
local function buildCan(folder: Instance, canCF: CFrame)
	local can = Color3.fromRGB(96, 190, 220)
	local body = newPart(folder, "CanBody", Vector3.new(0.9, 0.9, 0.9), canCF * CFrame.new(0, 0.53, 0) * CFrame.Angles(0, 0, math.pi / 2), can, M.Metal)
	body.Shape = Enum.PartType.Cylinder
	tube(folder, "CanSpout", (canCF * CFrame.new(0.3, 0.35, 0)).Position, (canCF * CFrame.new(1.1, 0.95, 0)).Position, 0.14, can, M.Metal)
	disc(folder, "CanRose", 0.3, 0.08, canCF * CFrame.new(1.15, 1.0, 0) * CFrame.Angles(0, 0, rad(-50)), lerp(can, WHITE, 0.3), M.Metal)
	tube(folder, "CanHandle", (canCF * CFrame.new(-0.3, 0.9, 0)).Position, (canCF * CFrame.new(0.15, 1.05, 0)).Position, 0.1, lerp(can, Color3.new(0, 0, 0), 0.2), M.Metal)
end

-- Moulin à vent (le moulin "Pinwheel" du clicker) ; pales tournées vers -Z
function GardenBuilder._buildWindmill(self: Garden, folder: Instance, mill: CFrame)
	newPart(folder, "MillBase", Vector3.new(3.2, 0.5, 3.2), mill * CFrame.new(0, 0.25, 0), STONE, M.Slate, true)
	newPart(folder, "MillTower", Vector3.new(2.6, 2.6, 2.6), mill * CFrame.new(0, 1.8, 0), Color3.fromRGB(255, 246, 236), M.WoodPlanks, true)
	newPart(folder, "MillTower", Vector3.new(2.1, 2.2, 2.1), mill * CFrame.new(0, 4.2, 0), Color3.fromRGB(255, 236, 226), M.WoodPlanks, true)
	newPart(folder, "MillTower", Vector3.new(1.7, 1.8, 1.7), mill * CFrame.new(0, 6.2, 0), Color3.fromRGB(255, 226, 214), M.WoodPlanks, true)
	for _, s in ipairs({ -1, 1 }) do
		local roof = Instance.new("WedgePart")
		roof.Name = "MillRoof"
		roof.Anchored = true
		roof.CanCollide = false
		roof.CanQuery = false
		roof.CanTouch = false
		roof.Size = Vector3.new(2.2, 1.4, 1.1)
		roof.CFrame = mill * CFrame.new(0, 7.8, s * 0.55) * (s > 0 and CFrame.Angles(0, math.pi, 0) or CFrame.identity)
		roof.Color = Color3.fromRGB(236, 104, 140)
		roof.Material = M.SmoothPlastic
		roof.Parent = folder
	end
	newPart(folder, "MillDoor", Vector3.new(0.9, 1.5, 0.1), mill * CFrame.new(0, 1.3, -1.32), WOOD_DARK, M.Wood)
	newPart(folder, "MillWindow", Vector3.new(0.6, 0.6, 0.1), mill * CFrame.new(0, 4.3, -1.07), Color3.fromRGB(170, 216, 255), M.Glass)
	-- pales : un modèle qui tourne autour de son axe Z
	local hubCF = mill * CFrame.new(0, 6.4, -1.2)
	local blades = Instance.new("Model")
	blades.Name = "Blades"
	local hub = newPart(blades, "Hub", Vector3.new(0.5, 0.5, 0.5), hubCF, WOOD_DARK, M.Wood)
	hub.Shape = Enum.PartType.Ball
	for k = 0, 3 do
		local arm = hubCF * CFrame.Angles(0, 0, k * math.pi / 2)
		newPart(blades, "Arm", Vector3.new(0.2, 3.2, 0.12), arm * CFrame.new(0, 1.7, 0), WOOD_DARK, M.Wood)
		newPart(blades, "Sail", Vector3.new(0.9, 2.5, 0.06), arm * CFrame.new(0.52, 1.95, 0.1), k % 2 == 0 and Color3.fromRGB(255, 250, 244) or Color3.fromRGB(255, 196, 214), M.Fabric)
	end
	blades.PrimaryPart = hub
	blades.Parent = folder
	self.Blades = blades
	self.BladesCF = hubCF
end

-- Signature : un objet n'est reconstruit que si elle change
function GardenBuilder._sigOf(self: Garden, entry: any): string
	local extra = ""
	local kind = GardenSnapshot.Parse(entry.Key)
	if kind == "B" then
		extra = self.State.Unlocked and "Plot" or "Locked"
	elseif entry.Key == "F:Sign" then
		extra = tostring(self.State.Unlocked)
	end
	return string.format("%s|%.2f|%.2f|%d|%s", entry.Key, entry.X, entry.D, entry.R, extra)
end

-- Disposition voulue (GardenSnapshot.Arrange) -> ce qui doit être construit / retiré
function GardenBuilder._sync(self: Garden)
	if self.Destroyed then
		return
	end
	local arranged = GardenSnapshot.Arrange(self.State)
	self.Arranged = arranged
	table.clear(self.Pending)
	if not self.Near then
		return
	end
	if not self.Layout then
		local folder = Instance.new("Folder")
		folder.Name = "Layout"
		folder.Parent = self.Model
		self.Layout = folder
		self:_buildButterflies(folder)
	end
	local seen = {}
	for _, entry in ipairs(arranged) do
		seen[entry.Key] = true
		local sig = self:_sigOf(entry)
		local item = self.Items[entry.Key]
		if item and item.Sig ~= sig then
			self:_destroyItem(entry.Key)
			item = nil
		end
		if item then
			item.Arr = entry
		else
			table.insert(self.Pending, entry)
		end
	end
	for key in pairs(self.Items) do
		if not seen[key] then
			self:_destroyItem(key)
		end
	end
	-- parterres d'abord, puis aménagements, puis le reste
	local order = { B = 1, G = 1, F = 2 }
	table.sort(self.Pending, function(a, b)
		local ka = order[string.sub(a.Key, 1, 1)] or 3
		local kb = order[string.sub(b.Key, 1, 1)] or 3
		if ka ~= kb then
			return ka < kb
		end
		return a.Key < b.Key
	end)
	-- (les parterres tout de suite : les invites et les étiquettes en dépendent)
	local beds = 0
	for _, entry in ipairs(self.Pending) do
		local first = string.sub(entry.Key, 1, 1)
		if first == "B" or first == "G" then
			beds += 1
		end
	end
	self:_buildPending(math.max(beds, 1))
	self:_signText()
end

function GardenBuilder._destroyItem(self: Garden, key: string)
	local item = self.Items[key]
	if not item then
		return
	end
	self.Items[key] = nil
	if item.Bed then
		local index = table.find(self.Beds, item.Bed)
		if index then
			table.remove(self.Beds, index)
		end
	end
	if key == "F:Windmill" then
		self.Blades = nil
	elseif key == "F:Sign" then
		self.SignPrompt = nil
		self.SignSub = nil
	end
	item.Model:Destroy()
end

----------------------------------------------------------------------
-- 🪑 v9.9 (PARK99) : s'asseoir dans le jardin
----------------------------------------------------------------------
-- Places assises des objets de jardin (repère du kit : x, dessus de
-- l'assise y, d ; (fx, fd) = direction du regard). Hauteurs SCALE99 : 1,45.
local SEAT_SPOTS: { [string]: { { number } } } = {
	GardenBench = { { -1.2, 1.45, -0.12, 0, -1 }, { 1.2, 1.45, -0.12, 0, -1 } },
	PicnicTable = { { -1.3, 1.45, -2.04, 0, 1 }, { 1.3, 1.45, -2.04, 0, 1 }, { -1.3, 1.45, 2.04, 0, -1 }, { 1.3, 1.45, 2.04, 0, -1 } },
	GardenSwing = { { -0.75, 1.5, 0, 0, -1 }, { 0.75, 1.5, 0, 0, -1 } },
}
do
	-- kiosque : 3 bancs sur l'arc du fond, face au centre (voir HouseGarden)
	local spots = {}
	for k = 1, 3 do
		local a = (k + 1) / 8 * math.pi * 2
		local x, dd = math.cos(a) * 3.6, math.sin(a) * 3.6
		table.insert(spots, { x, 0.68 + 1.45, dd, -math.cos(a), -math.sin(a) })
	end
	SEAT_SPOTS.Gazebo = spots
end
local SWING_PIVOT_Y = 5.3 -- (balancelle : axe des cordes, repère du kit)
local SWING_OMEGA = math.sqrt(9.81 * 3.06 / (5.3 - 1.5)) -- pendule de ~3,8 studs
local SWING_AMP = math.rad(8)

local sitAnimatorModule: any = nil
local function sitAnimator(): any
	if sitAnimatorModule == nil then
		local ok, result = pcall(function()
			return require(script.Parent:FindFirstChild("SitAnimator") :: any)
		end)
		sitAnimatorModule = (ok and type(result) == "table") and result or false
	end
	return sitAnimatorModule or nil
end

-- Propriétaire du jardin (attribut de la maison qui nous contient)
function GardenBuilder._ownerId(self: Garden): number?
	local node: Instance? = self.Model.Parent
	for _ = 1, 4 do
		if not node then
			return nil
		end
		local id = node:GetAttribute("OwnerId")
		if type(id) == "number" then
			return id
		end
		node = node.Parent
	end
	return nil
end

function GardenBuilder._sit(self: Garden, model: Model, seatPart: BasePart)
	if self.Editing or self.Destroyed then
		return
	end
	local owner = self:_ownerId()
	if not owner then
		return
	end
	local function sit(cf: CFrame, kind: string?)
		task.spawn(function()
			pcall(function()
				Net.Function("World"):InvokeServer("sit", { Owner = owner, Garden = true, CFrame = cf, Kind = kind or "bench" })
			end)
		end)
	end
	local anim = sitAnimator()
	if anim and type(anim.Approach) == "function" then
		if pcall(anim.Approach, model, seatPart, sit) then
			return
		end
	end
	sit(seatPart.CFrame * CFrame.new(0, seatPart.Size.Y / 2, 0), "bench")
end

-- Places assises (invisibles) + invites "S'asseoir" d'un objet de jardin
function GardenBuilder._addSeats(self: Garden, item: any, id: string, cf: CFrame)
	local spots = SEAT_SPOTS[id]
	if not spots then
		return
	end
	item.SeatPrompts = {}
	item.SeatParts = {}
	local name = id
	for _, piece in ipairs(Config.Garden and Config.Garden.Pieces or {}) do
		if piece.Id == id then
			name = piece.Name
		end
	end
	for i, spot in ipairs(spots) do
		local top = cf * Vector3.new(spot[1], spot[2], -spot[3])
		local look = cf:VectorToWorldSpace(Vector3.new(spot[4], 0, -spot[5]))
		local seatPart = newPart(item.Model, "GardenSeat", Vector3.new(1.6, 0.2, 1.3), CFrame.lookAt(top - Vector3.new(0, 0.1, 0), top - Vector3.new(0, 0.1, 0) + look), WHITE, M.SmoothPlastic)
		seatPart.Transparency = 1
		seatPart.CastShadow = false
		seatPart:SetAttribute("SitKind", "bench")
		seatPart:SetAttribute("SeatIndex", i)
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "GardenSeatPrompt"
		prompt.ActionText = Locale.T("Sit")
		prompt.ObjectText = Locale.T(name)
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 7
		prompt.RequiresLineOfSight = false
		prompt.Enabled = not self.Editing
		prompt.Parent = seatPart
		table.insert(self.Connections, prompt.Triggered:Connect(function()
			self:_sit(item.Model, seatPart)
		end))
		table.insert(item.SeatPrompts, prompt)
		table.insert(item.SeatParts, seatPart)
	end
	if id == "GardenSwing" then
		-- pièces qui se balancent : assise, coussins, dossier, cordes
		local swing = { Item = item, Pivot = cf * CFrame.new(0, SWING_PIVOT_Y, 0), Parts = {}, Rest = {}, Frames = {}, Amp = 0, Phase = 0, Seats = {} }
		for _, d in ipairs(item.Model:GetDescendants()) do
			if d:IsA("BasePart") and string.sub(d.Name, 1, 5) == "Swing" and d.Name ~= "SwingLeg" and d.Name ~= "SwingBrace" and d.Name ~= "SwingBeam" then
				table.insert(swing.Parts, d)
				table.insert(swing.Rest, d.CFrame)
				table.insert(swing.Frames, d.CFrame)
			end
		end
		for _, seatPart in ipairs(item.SeatParts) do
			table.insert(swing.Parts, seatPart)
			table.insert(swing.Rest, seatPart.CFrame)
			table.insert(swing.Frames, seatPart.CFrame)
		end
		local swings = self.Swings or {}
		swings[item] = swing
		self.Swings = swings
	end
end

-- Balancelle : quelqu'un est assis dessus (siège du serveur tout près d'une
-- place) -> elle se balance doucement ; le siège du serveur suit (localement)
function GardenBuilder._stepSwings(self: Garden, dt: number)
	local t = rawServerNow()
	local camera = workspace.CurrentCamera
	local swings = self.Swings
	if not swings then
		return
	end
	for item, swing in pairs(swings) do
		if not item.Model.Parent or self.Items[item.Key] ~= item then
			swings[item] = nil
		elseif not camera or (camera.CFrame.Position - swing.Pivot.Position).Magnitude < 140 then
			-- sièges du serveur sur nos places
			local riders = {}
			local sitAt: number? = nil
			for _, player in ipairs(Players:GetPlayers()) do
				local character = player.Character
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				local seat = humanoid and humanoid.SeatPart
				if seat and string.sub(seat.Name, 1, 9) == "TownSeat_" then
					local rest = swing.Seats[seat] or seat.CFrame
					for _, seatPart in ipairs(item.SeatParts) do
						if (rest.Position - (seatPart.CFrame * CFrame.new(0, 0.1, 0)).Position).Magnitude < 1.6 or swing.Seats[seat] then
							swing.Seats[seat] = rest
							riders[seat] = true
							local at = tonumber(seat:GetAttribute("SitAt"))
							if at and (not sitAt or at < sitAt) then
								sitAt = at
							end
							break
						end
					end
				end
			end
			for seat in pairs(swing.Seats) do
				if not riders[seat] then
					swing.Seats[seat] = nil
				end
			end
			local angle
			if sitAt then
				local since = math.max(0, t - sitAt)
				swing.Amp = SWING_AMP * (1 - math.exp(-since / 1.6))
				swing.Phase = SWING_OMEGA * since
				angle = swing.Amp * math.sin(swing.Phase)
			else
				swing.Amp *= math.exp(-dt / 1.4)
				swing.Phase += SWING_OMEGA * dt
				angle = swing.Amp * math.sin(swing.Phase)
			end
			if math.abs(angle) > 1e-4 or swing.Moved then
				swing.Moved = math.abs(angle) > 1e-4
				local turn = swing.Pivot * CFrame.Angles(angle, 0, 0) * swing.Pivot:Inverse()
				for i, rest in ipairs(swing.Rest) do
					swing.Frames[i] = turn * rest
				end
				workspace:BulkMoveTo(swing.Parts, swing.Frames, Enum.BulkMoveMode.FireCFrameChanged)
				for seat, rest in pairs(swing.Seats) do
					if seat.Parent then
						seat.CFrame = turn * rest
					end
				end
			end
		end
	end
end

-- Construit jusqu'à `budget` objets en attente
function GardenBuilder._buildPending(self: Garden, budget: number)
	local built = 0
	while built < budget and #self.Pending > 0 and self.Layout do
		local entry = table.remove(self.Pending, 1)
		if not self.Items[entry.Key] then
			local ok, err = pcall(self._buildItem, self, entry)
			if not ok then
				warn("[Jardin] " .. tostring(entry.Key) .. " : " .. tostring(err))
			end
			built += 1
		end
	end
	if built > 0 then
		table.sort(self.Beds, function(a, b)
			if (a.Kind == "Ghost") ~= (b.Kind == "Ghost") then
				return b.Kind == "Ghost"
			end
			return a.Index < b.Index
		end)
	end
end

function GardenBuilder._buildItem(self: Garden, entry: any)
	local key = entry.Key
	local cf = self:PlaceCF(entry.X, entry.D, entry.R)
	local model = Instance.new("Model")
	model.Name = key
	model:SetAttribute("GardenKey", key)
	local item: any = { Key = key, Sig = self:_sigOf(entry), Model = model, Arr = entry, CF = cf, Lights = {}, Glows = {}, Kois = {} }
	local kind, id, n = GardenSnapshot.Parse(key)
	if key == "G" or kind == "B" then
		local bedKind = key == "G" and "Ghost" or (self.State.Unlocked and "Plot" or "Locked")
		local index = key == "G" and (self.State.Count + 1) or (n :: number)
		local bed = self:_buildBed(model, index, bedKind, cf * TURN)
		item.Bed = bed
		table.insert(self.Beds, bed)
		if bedKind == "Plot" then
			self:_bedPlot(bed, false)
		end
	elseif kind == "D" then
		local kit = HouseKit.new(cf, model, 0)
		HouseGarden.BuildDecor(kit, id :: string)
	elseif kind == "P" then
		local kit = HouseKit.new(cf, model, 0)
		HouseGarden.BuildPiece(kit, id :: string, n)
		self:_addSeats(item, id :: string, cf)
	elseif kind == "F" then
		if id == "Sign" then
			self:_buildSign(model, cf * TURN)
		elseif id == "Path1" or id == "Path2" then
			buildPath(model, cf)
		elseif id == "Lantern1" or id == "Lantern2" then
			buildLantern(model, cf, item)
		elseif id == "Bush1" or id == "Bush2" then
			buildBush(model, cf * TURN, id == "Bush1" and 1 or -1)
		elseif id == "Can" then
			buildCan(model, cf * TURN)
		elseif id == "Windmill" then
			self:_buildWindmill(model, cf * TURN)
		else
			local kit = HouseKit.new(cf, model, 0)
			HouseGarden.BuildPiece(kit, id :: string, 1)
		end
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			if d:GetAttribute("NightGlow") and not table.find(item.Glows, d) then
				table.insert(item.Glows, d)
			elseif d:GetAttribute("KoiIndex") then
				table.insert(item.Kois, d)
			end
		end
	end
	model.WorldPivot = cf
	model.Parent = self.Layout
	self.Items[key] = item
	if self.Editing then
		self:_editBox(item)
	end
	-- nuit : les lanternes déjà allumées
	if self.Night ~= nil then
		for _, glow in ipairs(item.Glows) do
			glow.Material = self.Night and M.Neon or M.SmoothPlastic
		end
		for _, light in ipairs(item.Lights) do
			light.Enabled = self.Night and self.Near
		end
	end
end

-- Papillons (visibles quand une fleur est ouverte)
function GardenBuilder._buildButterflies(self: Garden, folder: Instance)
	table.clear(self.Butterflies)
	local O = self.Origin
	for k = 1, 2 do
		local fly = Instance.new("Model")
		fly.Name = "Butterfly"
		local color = k == 1 and Color3.fromRGB(255, 150, 200) or Color3.fromRGB(160, 200, 255)
		local bodyPart = egg(fly, "Body", Vector3.new(0.1, 0.1, 0.42), O, Color3.fromRGB(60, 40, 50), M.SmoothPlastic)
		local left = egg(fly, "Wing", Vector3.new(0.5, 0.04, 0.44), O, color, M.SmoothPlastic)
		local right = egg(fly, "Wing", Vector3.new(0.5, 0.04, 0.44), O, color, M.SmoothPlastic)
		bodyPart.Transparency, left.Transparency, right.Transparency = 1, 1, 1
		fly.Parent = folder
		table.insert(self.Butterflies, { Body = bodyPart, Left = left, Right = right, Phase = k * 2.4, Bed = 0 })
	end
end

-- Le parterre suit l'instantané (fleur plantée / cueillie)
function GardenBuilder._bedPlot(self: Garden, bed: any, allowPop: boolean)
	if bed.Kind ~= "Plot" then
		return
	end
	local plot = self.State.Plots[bed.Index]
	local flower = plot and plot.Flower or ""
	local plotKey = flower .. "|" .. tostring(plot and plot.PlantedAt or 0)
	if plotKey == bed.Key then
		return
	end
	-- une fleur prête remplacée par une graine = cueillie (par le
	-- propriétaire, vu ici par un visiteur) : même éclat, sans "+X"
	if allowPop and bed.Hero and bed.Stage == "Ready" and bed.Flower ~= "" and flower ~= "" then
		self:_pop(bed, bed.Flower, nil)
	end
	bed.Key = plotKey
	bed.Flower = flower
	bed.Stage = ""
	bed.Dirty = true
	if bed.Tag then
		local style = FLOWER_STYLE[flower]
		bed.Tag.Color = style and style.Petal or WOOD_LIGHT
	end
end

----------------------------------------------------------------------
-- v9.8 : mode édition du jardin (GardenEdit)
----------------------------------------------------------------------

-- Boîte invisible cliquable de la taille de l'empreinte (mode édition)
function GardenBuilder._editBox(self: Garden, item: any)
	if item.EditBox or not self.IsOwner or item.Key == "G" then
		return
	end
	local arr = item.Arr
	local box = Instance.new("Part")
	box.Name = "GardenEditBox"
	box.Anchored = true
	box.CanCollide = false
	box.CanTouch = false
	box.CanQuery = true
	box.CastShadow = false
	box.Transparency = 1
	box.Size = Vector3.new(math.max(1, arr.W), 3, math.max(1, arr.Dp))
	box.CFrame = item.CF * CFrame.new(0, 1.5, 0)
	box:SetAttribute("GardenKey", item.Key)
	box.Parent = item.Model
	item.EditBox = box
end

function GardenBuilder.SetEditing(self: Garden, on: boolean)
	if self.Destroyed then
		return
	end
	self.Editing = on == true
	if not self.Editing then
		self.EditLayout = nil
	end
	for _, item in pairs(self.Items) do
		if self.Editing then
			self:_editBox(item)
		elseif item.EditBox then
			item.EditBox:Destroy()
			item.EditBox = nil
		end
	end
	for _, bed in ipairs(self.Beds) do
		if bed.Click then
			bed.Click.MaxActivationDistance = self.Editing and 0 or 26
		end
	end
	-- (v9.9 PARK99) pas d'invite "S'asseoir" pendant l'édition
	for _, item in pairs(self.Items) do
		for _, prompt in ipairs(item.SeatPrompts or {}) do
			prompt.Enabled = not self.Editing
		end
	end
	self:_refreshStages(false)
end

-- Déplace (aperçu) un objet construit ; renvoie son modèle
function GardenBuilder.Preview(self: Garden, key: string, x: number, d: number, r: number): Model?
	local item = self.Items[key]
	if not item then
		return nil
	end
	item.Model:PivotTo(self:PlaceCF(x, d, r))
	return item.Model
end

-- Remet un objet à sa place (aperçu annulé)
function GardenBuilder.ResetPreview(self: Garden, key: string)
	local item = self.Items[key]
	if item then
		item.Model:PivotTo(item.CF)
	end
end

-- Nouveau modèle (fantôme) d'un objet pas encore posé : déco / objet de jardin
function GardenBuilder.MakeGhost(self: Garden, key: string): Model?
	local kind, id, n = GardenSnapshot.Parse(key)
	if kind ~= "D" and kind ~= "P" then
		return nil
	end
	local cf = self:PlaceCF(0, 0, 0)
	local model = Instance.new("Model")
	model.Name = "GardenGhost"
	local kit = HouseKit.new(cf, model, 0)
	local ok = pcall(function()
		if kind == "D" then
			HouseGarden.BuildDecor(kit, id :: string)
		else
			HouseGarden.BuildPiece(kit, id :: string, n)
		end
	end)
	if not ok then
		model:Destroy()
		return nil
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
		elseif d:IsA("ParticleEmitter") then
			d.Enabled = false
		end
	end
	model.WorldPivot = cf
	return model
end

-- Objet du jardin sous un point (partie touchée) -> clé
function GardenBuilder.KeyOf(_self: Garden, part: Instance?): string?
	local node = part
	while node and node:IsA("Instance") do
		local key = node:GetAttribute("GardenKey")
		if type(key) == "string" then
			return key
		end
		if node:IsA("Model") and node.Name == "DopamineGarden" then
			return nil
		end
		node = node.Parent
	end
	return nil
end

----------------------------------------------------------------------
-- Stades, étiquettes, fleurs
----------------------------------------------------------------------

function GardenBuilder._buildPlants(self: Garden, bed: any)
	if bed.Plants then
		bed.Plants:Destroy()
		bed.Plants = nil
		bed.Hero = nil
	end
	if bed.Flower == "" or not self.Near then
		return
	end
	local stage = bed.Stage
	local plants = Instance.new("Model")
	plants.Name = "Plants"
	local lotus = bed.Flower == "Lotus"
	local hero = makeFlower(bed.Flower, stage, { Scale = lotus and 1.3 or 1.4, Detail = true, Fx = true, Hero = true })
	hero.Name = "Hero"
	hero:PivotTo(bed.HeroCF)
	hero.Parent = plants
	bed.Hero = hero
	bed.TopHeight = tonumber(hero:GetAttribute("TopHeight")) or 1
	-- deux compagnes plus petites (tournées un peu différemment)
	for _, side in ipairs({ -1, 1 }) do
		local mate = makeFlower(bed.Flower, stage, { Scale = lotus and 0.75 or 1.0, Detail = false, Fx = false, Hero = not lotus })
		mate.Name = "Mate"
		mate:PivotTo(bed.CF * CFrame.new(side * BED_W * 0.31, SOIL_TOP, lotus and 0.3 or -0.3) * CFrame.Angles(0, side * rad(22), 0))
		mate.Parent = plants
	end
	-- feuillage bas entre les plantes (la terre ne paraît pas vide)
	if not lotus and stage ~= "Seed" then
		for k, spot in ipairs({ Vector3.new(-0.17, 0, 0.55), Vector3.new(0.17, 0, 0.6), Vector3.new(0, 0, -0.75) }) do
			local size = Vector3.new(1.3, 0.55, 0.85) * (stage == "Sprout" and 0.6 or 1)
			egg(plants, "Foliage", size, bed.CF * CFrame.new(spot.X * BED_W, SOIL_TOP + 0.1, spot.Z * BED_D * 0.5) * CFrame.Angles(0, k * 0.9, 0), k == 2 and LEAF or LEAF_DARK, M.Grass)
		end
	end
	plants.Parent = bed.Model
	bed.Plants = plants
end

-- Met à jour les étiquettes et (si besoin) les stades ; `force` = tout de suite
function GardenBuilder._refreshStages(self: Garden, force: boolean?)
	local now = self:_now()
	local readyCount = 0
	for _, bed in ipairs(self.Beds) do
		if bed.Kind == "Plot" then
			local plot = self.State.Plots[bed.Index]
			local stage = GardenSnapshot.Stage(plot, now)
			if stage ~= bed.Stage then
				bed.Stage = stage
				bed.Dirty = true
			end
			local progress, ready, remaining = GardenSnapshot.Progress(plot, now)
			if ready then
				readyCount += 1
			end
			local label = flowerLabel(bed.Flower)
			if bed.Flower == "" then
				bed.Title.Text = Locale.T("🌱 Empty bed")
				bed.Bar.Visible = false
				bed.Timer.Text = self.IsOwner and Locale.T("Plant") or ""
			elseif ready then
				bed.Title.Text = label
				bed.Bar.Visible = false
				bed.Timer.Text = "✨ " .. Locale.T("READY!")
				bed.Timer.TextColor3 = Color3.fromRGB(214, 140, 0)
			else
				bed.Title.Text = label
				bed.Bar.Visible = true
				bed.Fill.Size = UDim2.fromScale(math.max(0.04, progress), 1)
				bed.Timer.Text = "⏱️ " .. clockText(remaining)
				bed.Timer.TextColor3 = INK
			end
			bed.Billboard.StudsOffsetWorldSpace = Vector3.new(0, SOIL_TOP + math.max(1.2, bed.TopHeight) + 1.3, 0)
			local prompt = bed.Prompt
			if prompt then
				local canAct = (bed.Flower == "" or ready) and not bed.Pending and not self.Editing
				prompt.Enabled = canAct
				if bed.Flower == "" then
					prompt.ActionText = Locale.T("Plant")
					prompt.ObjectText = Locale.T("🌱 Empty bed")
				else
					prompt.ActionText = Locale.T("Harvest")
					prompt.ObjectText = label
				end
			end
		end
	end
	if self.SignPrompt then
		self.SignPrompt.Enabled = readyCount >= 2 and not self.HarvestingAll and not self.Editing
		self.SignPrompt.ActionText = Locale.T("🧺 Harvest all (%d)", readyCount)
	end
	-- lanternes : la nuit seulement (et quand on est près)
	local clock = Lighting.ClockTime
	local night = clock < 6.3 or clock > 17.7
	local changed = night ~= self.Night
	self.Night = night
	for _, item in pairs(self.Items) do
		for _, light in ipairs(item.Lights) do
			light.Enabled = night and self.Near
		end
		if changed then
			for _, glow in ipairs(item.Glows) do
				glow.Material = night and M.Neon or M.SmoothPlastic
			end
		end
	end
	if force then
		self:_buildDirty(#self.Beds)
	end
end

function GardenBuilder._buildDirty(self: Garden, budget: number)
	local built = 0
	for _, bed in ipairs(self.Beds) do
		if built >= budget then
			return
		end
		if bed.Dirty and bed.Kind == "Plot" then
			bed.Dirty = false
			if bed.Stage == "" then
				bed.Stage = GardenSnapshot.Stage(self.State.Plots[bed.Index], self:_now())
			end
			self:_buildPlants(bed)
			built += 1
		end
	end
end

----------------------------------------------------------------------
-- Boucle (20 Hz) : distance, animations
----------------------------------------------------------------------

function GardenBuilder._focus(self: Garden): Vector3?
	if self.Focus and os.clock() < self.FocusUntil then
		return self.Focus
	end
	local camera = workspace.CurrentCamera
	return camera and camera.CFrame.Position or nil
end

-- Loin : tout le contenu est retiré (il revient en s'approchant)
function GardenBuilder._unload(self: Garden)
	for key in pairs(self.Items) do
		self:_destroyItem(key)
	end
	table.clear(self.Beds)
	table.clear(self.Pending)
	table.clear(self.Butterflies)
	self.Blades = nil
	self.SignPrompt = nil
	self.SignSub = nil
	if self.Layout then
		self.Layout:Destroy()
		self.Layout = nil
	end
end

function GardenBuilder._heartbeat(self: Garden, dt: number)
	if self.Destroyed then
		return
	end
	if self.Swings and next(self.Swings) then
		self:_stepSwings(dt)
	end
	self.Clock += dt
	if self.Clock < STEP then
		return
	end
	local elapsed = self.Clock
	self.Clock = 0
	self.Tick += elapsed
	self.Slow += elapsed

	-- distance (2 fois / s) : contenu retiré de loin, animations en pause
	if self.Slow >= 0.5 then
		self.Slow = 0
		local focus = self:_focus()
		if focus then
			local distance = (focus - self.Center).Magnitude
			self.Animate = distance < ANIM_RANGE + 40 and not self.Editing
			if self.Near and distance > HIDE_ITEMS and not self.Editing then
				self.Near = false
				self:_unload()
			elseif not self.Near and distance < SHOW_ITEMS then
				self.Near = true
				self:_sync()
			end
			-- fleurs : seulement de près (comme v9.5)
			local flowersNear = distance < HIDE_RANGE + 40
			for _, bed in ipairs(self.Beds) do
				if not flowersNear and bed.Plants then
					bed.Plants:Destroy()
					bed.Plants = nil
					bed.Hero = nil
					bed.Dirty = bed.Kind == "Plot"
				end
			end
			self.FlowersNear = flowersNear
		end
		if self.Near then
			self:_refreshStages(false)
		end
	end
	if not self.Near then
		return
	end
	self:_buildPending(ITEMS_PER_STEP)
	if self.FlowersNear ~= false then
		self:_buildDirty(BUILDS_PER_STEP)
	end
	if not self.Animate then
		return
	end
	local t = self.Tick
	-- fleurs prêtes : elles se balancent
	local bloomBed: any = nil
	for _, bed in ipairs(self.Beds) do
		local hero = bed.Hero
		if hero and (bed.Stage == "Ready" or bed.Stage == "Bloom") then
			bloomBed = bloomBed or bed
			if bed.Stage == "Ready" then
				bloomBed = bed
				local p = bed.Phase
				hero:PivotTo(bed.HeroCF * CFrame.Angles(math.sin(t * 1.9 + p) * 0.07, math.sin(t * 0.7 + p) * 0.1, math.sin(t * 1.4 + p * 0.7) * 0.06))
			end
		end
	end
	-- moulin
	local blades = self.Blades
	if blades then
		blades:PivotTo(self.BladesCF * CFrame.Angles(0, 0, -t * 1.6))
	end
	-- carpes du bassin : elles tournent lentement, en ondulant
	for _, item in pairs(self.Items) do
		for _, fish in ipairs(item.Kois) do
			local k = tonumber(fish:GetAttribute("KoiIndex")) or 1
			local a = t * (0.35 + k * 0.06) + k * 2.1
			local rx, rz = 2.5 - k * 0.3, 1.35 - k * 0.12
			local pos = item.CF * Vector3.new(math.cos(a) * rx, 0.24, math.sin(a) * rz)
			local ahead = item.CF * Vector3.new(math.cos(a + 0.1) * rx, 0.24, math.sin(a + 0.1) * rz)
			fish.CFrame = CFrame.lookAt(pos, ahead) * CFrame.Angles(0, math.sin(t * 6 + k) * 0.18, 0)
		end
	end
	-- papillons autour d'une fleur ouverte
	for k, fly in ipairs(self.Butterflies) do
		if bloomBed then
			local center = bloomBed.HeroCF.Position + Vector3.new(0, bloomBed.TopHeight + 0.4, 0)
			local a = t * 0.9 + fly.Phase
			local pos = center + Vector3.new(math.cos(a) * (1.4 + k * 0.4), math.sin(t * 2.3 + k) * 0.35 + k * 0.3, math.sin(a) * (1.1 + k * 0.3))
			local heading = Vector3.new(-math.sin(a), 0, math.cos(a))
			local body = CFrame.lookAt(pos, pos + heading)
			local flap = math.sin(t * 16 + fly.Phase) * 0.9
			fly.Body.CFrame = body
			fly.Left.CFrame = body * CFrame.Angles(0, 0, flap) * CFrame.new(-0.26, 0, 0)
			fly.Right.CFrame = body * CFrame.Angles(0, 0, -flap) * CFrame.new(0.26, 0, 0)
			fly.Body.Transparency = 0
			fly.Left.Transparency = 0
			fly.Right.Transparency = 0
		elseif fly.Body.Transparency < 1 then
			fly.Body.Transparency = 1
			fly.Left.Transparency = 1
			fly.Right.Transparency = 1
		end
	end
end

----------------------------------------------------------------------
-- Actions du propriétaire (RemoteFunction "Garden" existante)
----------------------------------------------------------------------

-- Texte flottant (BillboardGui) qui monte et s'efface
function GardenBuilder._float(self: Garden, position: Vector3, text: string, color: Color3, big: boolean?)
	if self.Destroyed or not self.Layout then
		return
	end
	local anchor = newPart(self.Layout, "FloatText", Vector3.new(0.2, 0.2, 0.2), CFrame.new(position), WHITE, M.SmoothPlastic)
	anchor.Transparency = 1
	local gui = Instance.new("BillboardGui")
	gui.Name = "Float"
	gui.Size = UDim2.fromOffset(big and 220 or 200, big and 56 or 40)
	gui.StudsOffset = Vector3.new(0, 0.5, 0)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 80
	gui.ResetOnSpawn = false
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeColor3 = Color3.fromRGB(80, 40, 20)
	label.TextStrokeTransparency = 0.2
	label.Parent = gui
	gui.Parent = anchor
	TweenService:Create(gui, TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { StudsOffset = Vector3.new(0, 4, 0) }):Play()
	TweenService:Create(label, TweenInfo.new(0.6, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 0.8), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	task.delay(1.6, function()
		anchor:Destroy()
	end)
end

-- (v9.8) petit texte flottant au-dessus d'un point (GardenEdit : achat, agrandissement)
function GardenBuilder.Float(self: Garden, position: Vector3, text: string, color: Color3?)
	self:_float(position, text, color or GOLD, true)
end

-- Éclat de la cueillette : pétales + étincelles + anneau + "+X 🧠"
function GardenBuilder._pop(self: Garden, bed: any, flowerId: string, reward: number?)
	if self.Destroyed or not self.Layout then
		return
	end
	local style = FLOWER_STYLE[flowerId] or DEFAULT_STYLE
	local head = bed.HeroCF.Position + Vector3.new(0, math.max(0.8, bed.TopHeight * 0.85), 0)
	local anchor = newPart(self.Layout, "HarvestPop", Vector3.new(0.4, 0.4, 0.4), CFrame.new(head), WHITE, M.SmoothPlastic)
	anchor.Transparency = 1
	local petals = Instance.new("ParticleEmitter")
	petals.Name = "Petals"
	petals.Color = ColorSequence.new(style.Petal, style.Inner or style.Petal)
	petals.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.34), NumberSequenceKeypoint.new(1, 0.12) })
	petals.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.7, 0.1), NumberSequenceKeypoint.new(1, 1) })
	petals.Lifetime = NumberRange.new(0.8, 1.3)
	petals.Speed = NumberRange.new(6, 11)
	petals.SpreadAngle = Vector2.new(75, 75)
	petals.Acceleration = Vector3.new(0, -14, 0)
	petals.Drag = 2
	petals.Rotation = NumberRange.new(0, 360)
	petals.RotSpeed = NumberRange.new(-240, 240)
	petals.Rate = 0
	petals.Parent = anchor
	local stars = Instance.new("ParticleEmitter")
	stars.Name = "Stars"
	stars.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	stars.Color = ColorSequence.new(WHITE, GOLD)
	stars.LightEmission = 0.4 -- (v9.6 : 1 -> 0.4)
	stars.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
	stars.Transparency = NumberSequence.new(0, 1)
	stars.Lifetime = NumberRange.new(0.5, 0.9)
	stars.Speed = NumberRange.new(4, 8)
	stars.SpreadAngle = Vector2.new(180, 180)
	stars.Rate = 0
	stars.Parent = anchor
	pcall(function()
		petals:Emit(26)
		stars:Emit(14)
	end)
	-- anneau lumineux qui s'élargit sur la terre
	local ring = disc(self.Layout, "PopRing", 1.2, 0.08, CFrame.new(bed.HeroCF.Position + Vector3.new(0, 0.08, 0)), GOLD, M.Neon)
	ring.Transparency = 0.2
	TweenService:Create(ring, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(0.08, 6.5, 6.5), Transparency = 1 }):Play()
	task.delay(2.2, function()
		anchor:Destroy()
		ring:Destroy()
	end)
	-- la fleur cueillie disparaît dans l'éclat (la nouvelle graine suit)
	if bed.Plants then
		bed.Plants:Destroy()
		bed.Plants = nil
		bed.Hero = nil
	end
	if reward then
		self:_float(head + Vector3.new(0, 0.6, 0), "+" .. NumberFormatter.Format(reward) .. " 🧠", GOLD, style == FLOWER_STYLE.Sunflower or flowerId == "Lotus")
	end
end

-- Heure du serveur (réponse de GardenService) : corrige un décalage net
function GardenBuilder._syncClock(self: Garden, serverNow: any)
	if type(serverNow) == "number" and serverNow == serverNow then
		local offset = serverNow - rawServerNow()
		if math.abs(offset) > 3 then
			self.ClockOffset = offset
		end
	end
end

function GardenBuilder._applyPlots(self: Garden, plots: any)
	if type(plots) ~= "table" or self.Destroyed then
		return
	end
	local state = self.State
	self:Update({
		Unlocked = true,
		Count = math.max(#plots, 1),
		Max = math.max(state.Max, #plots),
		Windmill = state.Windmill,
		Plots = plots,
		Level = state.Level,
		Size = state.Size,
		Decor = state.Decor,
		Layout = state.Layout,
	})
end

local function invokeGarden(action: string, arg: any): (boolean, any, any)
	return pcall(function()
		return Net.Function("Garden"):InvokeServer(action, arg)
	end)
end

local function bedAt(self: Garden, index: number): any?
	for _, bed in ipairs(self.Beds) do
		if bed.Index == index and bed.Kind == "Plot" then
			return bed
		end
	end
	return nil
end

function GardenBuilder._activate(self: Garden, index: number)
	if self.Destroyed or not self.IsOwner or self.Editing then
		return
	end
	local bed = bedAt(self, index)
	if not bed or bed.Pending then
		return
	end
	local plot = self.State.Plots[index]
	local now = self:_now()
	local above = bed.HeroCF.Position + Vector3.new(0, math.max(1.2, bed.TopHeight) + 0.8, 0)
	-- parterre vide : ("harvest", index) -> le serveur replante (sanitize) avant de répondre
	if bed.Flower == "" then
		bed.Pending = true
		task.spawn(function()
			local callOk, success, result = invokeGarden("harvest", index)
			bed.Pending = false
			if self.Destroyed then
				return
			end
			if callOk and success == true and type(result) == "table" then
				self:_syncClock(result.Now)
				self:_applyPlots(result.Plots)
			end
			self:_float(above, Locale.T("🌱 Planted!"), Color3.fromRGB(120, 210, 100))
		end)
		return
	end
	local _, ready, remaining = GardenSnapshot.Progress(plot, now)
	if not ready then
		self:_float(above, Locale.T("%s · ready in %s", flowerLabel(bed.Flower), clockText(remaining)), WHITE)
		return
	end
	bed.Pending = true
	if bed.Prompt then
		bed.Prompt.Enabled = false
	end
	task.spawn(function()
		local callOk, success, result = invokeGarden("harvest", index)
		bed.Pending = false
		if self.Destroyed then
			return
		end
		if callOk and success == true and type(result) == "table" then
			self:_syncClock(result.Now)
			self:_pop(bed, tostring(result.Flower or bed.Flower), tonumber(result.Reward) or 0)
			local callback = self.Options.OnHarvest
			if type(callback) == "function" then
				task.spawn(callback, result)
			end
			task.delay(0.35, function()
				self:_applyPlots(result.Plots)
			end)
		else
			local message = (callOk and type(result) == "string") and result or Locale.T("The garden is resting 🌙")
			self:_float(above, message, Color3.fromRGB(255, 130, 130))
			self:_refreshStages(false)
		end
	end)
end

function GardenBuilder._harvestAll(self: Garden)
	if self.Destroyed or not self.IsOwner or self.HarvestingAll or self.Editing then
		return
	end
	self.HarvestingAll = true
	if self.SignPrompt then
		self.SignPrompt.Enabled = false
	end
	task.spawn(function()
		local callOk, success, result = invokeGarden("harvestAll", nil)
		self.HarvestingAll = false
		if self.Destroyed then
			return
		end
		if callOk and success == true and type(result) == "table" and type(result.Harvested) == "table" then
			self:_syncClock(result.Now)
			for order, entry in ipairs(result.Harvested) do
				local bed = type(entry) == "table" and bedAt(self, tonumber(entry.Plot) or 0)
				if bed then
					task.delay((order - 1) * 0.09, function()
						self:_pop(bed, tostring(entry.Flower or bed.Flower), tonumber(entry.Reward) or 0)
					end)
				end
			end
			local callback = self.Options.OnHarvest
			if type(callback) == "function" then
				task.spawn(callback, result)
			end
			task.delay(0.35 + #result.Harvested * 0.09, function()
				self:_applyPlots(result.Plots)
			end)
		else
			local message = (callOk and type(result) == "string") and result or Locale.T("The garden is resting 🌙")
			self:_float(self.Origin.Position + Vector3.new(0, 5, 0), message, Color3.fromRGB(255, 130, 130))
		end
	end)
end

function GardenBuilder.Destroy(self: Garden)
	if self.Destroyed then
		return
	end
	self.Destroyed = true
	for _, connection in ipairs(self.Connections) do
		connection:Disconnect()
	end
	table.clear(self.Connections)
	table.clear(self.Beds)
	table.clear(self.Butterflies)
	table.clear(self.Items)
	table.clear(self.Pending)
	self.Layout = nil
	self.Blades = nil
	pcall(function()
		self.Model:Destroy()
	end)
end

-- (pour les tests / l'émulateur)
GardenBuilder.STAGES = STAGE_NAMES
GardenBuilder.FLOWERS = { "Daisy", "Tulip", "Rose", "Sunflower", "Lotus" }

return GardenBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="196">
          <Properties>
            <string name="Name">GardenEdit</string>
            <string name="Source"><![CDATA[--[[
	GardenEdit (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > GardenEdit

	🌷 Dopamine Town (v9.8, GARDEN98) : le MODE ÉDITION DU JARDIN, comme
	FurnitureEdit pour les meubles, mais dehors, dans SON jardin (devant et
	derrière la maison) :
	  - bouton "🌷 Jardin" (à gauche) quand on est sur sa parcelle ;
	  - un clic / un appui sur un objet du jardin le prend (parterres de
	    Dopamine, déco du jardin, pots, massifs, banc, kiosque..., panneau,
	    allées, lanternes, moulin, bonus des agrandissements) ; il suit la
	    souris (PC) ou le doigt sur la pelouse, aimant de grille 0,5 stud ;
	    R (ou 🔄) tourne de 15° (Maj+R dans l'autre sens) ; clic / ✅ pose ;
	    Échap / ❌ annule ; Suppr / 📦 range (déco et objets de jardin) ;
	  - l'empreinte au sol est verte (place libre) ou rouge (hors du jardin,
	    sur l'allée d'une porte, sur un autre objet, dans un mur) ; les zones
	    du jardin (celles du niveau) sont dessinées en vert pâle sur la
	    pelouse pendant l'édition, les allées des portes en rouge ;
	  - plateau du bas : 📦 Rangés (objets possédés pas posés, déco du jardin
	    rangée) -> un fantôme à poser ; 🛍️ Acheter (Config.Garden.Pieces :
	    prix, verrou des visites, nombre possédé) -> l'objet acheté arrive
	    directement dans le fantôme ; 🌳 Agrandir (niveau suivant du jardin :
	    prix, verrou, ce qu'il apporte ; les zones du niveau suivant sont
	    dessinées en doré) ;
	  - chaque pose : affichage tout de suite (GardenBuilder:ApplyLocal), puis
	    sauvegarde au serveur (RemoteFunction "Garden", "saveLayout" ; tout
	    y est revérifié) ; la réponse du serveur fait foi.
	Règles de place : Shared/GardenSnapshot (Fits, Footprint, Zones...),
	les mêmes que le serveur.

	API (branchée par TownClient) :
	  GardenEdit.Start(ctx)   ctx = { Toast = (text, color?) -> (), GetGarden = () -> garden?,
	                                  IsBusy = (() -> boolean)? }
	  GardenEdit.Step(dt)     (bouton visible / caché, ~4 fois par seconde suffit)
	  GardenEdit.Stop()
	  GardenEdit.IsActive() -> boolean ; GardenEdit.SetEnabled(on)
	Interface : ScreenGui "GardenEditGui" (à garder par TownClient : KEEP_GUIS).
	AUCUN son.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Net = require(ReplicatedStorage.Shared.Net)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local GardenSnapshot = require(ReplicatedStorage.Shared.GardenSnapshot)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)

local GardenEdit = {}

local LocalPlayer = Players.LocalPlayer
local GUI_NAME = "GardenEditGui"
local RENDER = "DopamineGardenEdit"
local LAWN_TOP = 0.45
local GRID = GardenSnapshot.GRID
local STEP = GardenSnapshot.ROTATION_STEP
local SAVE_DELAY = 0.6

local PINK = Color3.fromRGB(236, 72, 140)
local GREEN = Color3.fromRGB(86, 176, 96)
local GREEN_DARK = Color3.fromRGB(52, 120, 64)
local GOLD = Color3.fromRGB(240, 180, 60)
local INK = Color3.fromRGB(70, 52, 60)
local CARD = Color3.fromRGB(255, 252, 246)
local WHITE = Color3.new(1, 1, 1)
local RED = Color3.fromRGB(226, 80, 90)

type State = {
	Ctx: any,
	Gui: ScreenGui?,
	Toggle: TextButton?,
	Panel: Frame?,
	Top: Frame?,
	TopTitle: TextLabel?,
	Actions: Frame?,
	List: ScrollingFrame?,
	Tab: string,
	Tabs: { [string]: TextButton },
	Active: boolean,
	Garden: any,
	Holding: any?, -- { Key, X, D, R, New = bool, Ghost = Model?, Model = Model? }
	Plate: Part?,
	Zones: { Part },
	Layout: { [string]: any },
	Decor: { string },
	SaveAt: number?,
	Saving: boolean,
	Connections: { RBXScriptConnection },
	Started: boolean,
	Pointer: Vector2?,
	Clock: number,
}

local state: State = {
	Ctx = {},
	Tab = "Stored",
	Tabs = {},
	Active = false,
	Garden = nil,
	Zones = {},
	Layout = {},
	Decor = {},
	Saving = false,
	Connections = {},
	Started = false,
	Clock = 0,
}

----------------------------------------------------------------------
-- Utilitaires
----------------------------------------------------------------------

local function toast(text: string, color: Color3?)
	local fn = state.Ctx.Toast
	if type(fn) == "function" then
		pcall(fn, text, color)
	end
end

local function garden(): any?
	local fn = state.Ctx.GetGarden
	if type(fn) ~= "function" then
		return nil
	end
	local ok, result = pcall(fn)
	if ok and type(result) == "table" and not result.Destroyed then
		return result
	end
	return nil
end

local function data(): any
	return ClientState.Data or {}
end

local function level(): number
	local g = state.Garden
	if g and g.State then
		return GardenSnapshot.Level(g.State.Level)
	end
	return GardenSnapshot.Level(data())
end

local function ownedPieces(): { [string]: number }
	return GardenSnapshot.OwnedPieces(data())
end

local function ownedDecor(): { [string]: boolean }
	local house = data().House
	return type(house) == "table" and type(house.OwnedGarden) == "table" and house.OwnedGarden or {}
end

local function nameOf(key: string): (string, string)
	local kind, id = GardenSnapshot.Parse(key)
	if kind == "B" then
		return "🪴", Locale.T("Flower bed")
	elseif kind == "D" then
		local entry = Config.HouseLooksById and Config.HouseLooksById.Garden and Config.HouseLooksById.Garden[id :: string]
		return entry and tostring(entry.Icon) or "🌷", entry and Locale.T(entry.Name) or tostring(id)
	elseif kind == "P" then
		local piece = GardenSnapshot.PiecesById[id :: string]
		return piece and tostring(piece.Icon) or "🪴", piece and Locale.T(piece.Name) or tostring(id)
	end
	return "🌳", Locale.T("Garden decor")
end

local function newInstance(className: string, props: { [string]: any }, parent: Instance?): any
	local inst = Instance.new(className)
	for key, value in pairs(props) do
		(inst :: any)[key] = value
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function corner(parent: Instance, radius: number)
	newInstance("UICorner", { CornerRadius = UDim.new(0, radius) }, parent)
end

local function button(parent: Instance, name: string, text: string, color: Color3, size: UDim2, position: UDim2?, anchor: Vector2?): TextButton
	local b = newInstance("TextButton", {
		Name = name,
		Text = text,
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		TextColor3 = WHITE,
		BackgroundColor3 = color,
		AutoButtonColor = true,
		Size = size,
		Position = position or UDim2.new(),
		AnchorPoint = anchor or Vector2.zero,
		BorderSizePixel = 0,
	}, parent)
	corner(b, 12)
	newInstance("UIStroke", { Color = color:Lerp(Color3.new(0, 0, 0), 0.25), Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, b)
	newInstance("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4) }, b)
	return b
end

----------------------------------------------------------------------
-- Disposition courante (instantané + ce qui a déjà été bougé ici)
----------------------------------------------------------------------

-- Tout ce qui est affiché (Arrange) -> disposition complète { [clé] = { X, D, R } }
local function fullLayout(g: any): { [string]: any }
	local layout = {}
	for _, entry in ipairs(g.Arranged or {}) do
		if entry.Key ~= "G" then
			layout[entry.Key] = { X = entry.X, D = entry.D, R = entry.R }
		end
	end
	return layout
end

local function countPlacedPieces(layout: { [string]: any }): number
	local n = 0
	for key in pairs(layout) do
		if string.sub(key, 1, 2) == "P:" then
			n += 1
		end
	end
	return n
end

----------------------------------------------------------------------
-- Validité d'une place (mêmes règles que le serveur + objets voisins + murs)
----------------------------------------------------------------------

local function overlapsOthers(g: any, key: string, x: number, d: number, r: number): boolean
	local w, dp, flat = GardenSnapshot.Footprint(key)
	if flat then
		return false
	end
	local hx, hd = GardenSnapshot.HalfExtents(w, dp, r)
	for otherKey, entry in pairs(state.Layout) do
		if otherKey ~= key then
			local ow, odp, oflat = GardenSnapshot.Footprint(otherKey)
			if not oflat then
				local ox, od = GardenSnapshot.HalfExtents(ow, odp, entry.R or 0)
				if math.abs(entry.X - x) < hx + ox - 0.1 and math.abs(entry.D - d) < hd + od - 0.1 then
					return true
				end
			end
		end
	end
	-- murs / clôtures / fontaine de la façade (pièces solides de la maison)
	local house = g.Model and g.Model.Parent
	if house then
		local ok, hit = pcall(function()
			local params = OverlapParams.new()
			params.FilterType = Enum.RaycastFilterType.Include
			local exterior = house:FindFirstChild("Exterior")
			params.FilterDescendantsInstances = { exterior or house }
			local cf = g:PlaceCF(x, d, r) * CFrame.new(0, 1.6, 0)
			for _, part in ipairs(workspace:GetPartBoundsInBox(cf, Vector3.new(math.max(0.4, w - 0.3), 2.6, math.max(0.4, dp - 0.3)), params)) do
				if part.CanCollide and part.Transparency < 1 and not part:IsDescendantOf(g.Model) then
					return true
				end
			end
			return false
		end)
		if ok and hit then
			return true
		end
	end
	return false
end

local function isValid(g: any, key: string, x: number, d: number, r: number): boolean
	local st = g.State
	if not GardenSnapshot.Fits(level(), st.Size, key, x, d, r) then
		return false
	end
	return not overlapsOthers(g, key, x, d, r)
end

----------------------------------------------------------------------
-- Dessins au sol : zones, empreinte
----------------------------------------------------------------------

local function clearZones()
	for _, part in ipairs(state.Zones) do
		part:Destroy()
	end
	table.clear(state.Zones)
end

local function plate(g: any, x0: number, x1: number, d0: number, d1: number, color: Color3, y: number, transparency: number): Part
	local part = newInstance("Part", {
		Name = "GardenZone",
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
		Material = Enum.Material.SmoothPlastic,
		Color = color,
		Transparency = transparency,
		Size = Vector3.new(math.max(0.2, x1 - x0), 0.04, math.max(0.2, d1 - d0)),
		CFrame = g.HouseCF * CFrame.new((x0 + x1) / 2, LAWN_TOP + y, -(d0 + d1) / 2),
	}, workspace)
	table.insert(state.Zones, part)
	return part
end

local function drawZones(showNext: boolean?)
	clearZones()
	local g = state.Garden
	if not g then
		return
	end
	local lv = level()
	-- (hauteurs différentes : jamais deux plaques dans le même plan)
	for index, zone in ipairs(GardenSnapshot.Zones(lv, g.State.Size)) do
		plate(g, zone[1], zone[2], zone[3], zone[4], GREEN, 0.03 + index * 0.004, 0.82)
	end
	for index, lane in ipairs(GardenSnapshot.Corridors(g.State.Size)) do
		plate(g, lane[1], lane[2], math.max(lane[3], -29), lane[4], RED, 0.06 + index * 0.004, 0.72)
	end
	if showNext and lv < GardenSnapshot.MAX_LEVEL then
		for index, zone in ipairs(GardenSnapshot.Zones(lv + 1, g.State.Size)) do
			plate(g, zone[1], zone[2], zone[3], zone[4], GOLD, 0.015 + index * 0.004, 0.78)
		end
	end
end

local function updatePlate(g: any, hold: any, valid: boolean)
	local w, dp = GardenSnapshot.Footprint(hold.Key)
	local p = state.Plate
	if not p then
		p = newInstance("Part", {
			Name = "GardenFootprint",
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
			Material = Enum.Material.Neon,
			Transparency = 0.55,
		}, workspace)
		state.Plate = p
	end
	local plateP = p :: Part
	plateP.Size = Vector3.new(w, 0.05, dp)
	plateP.CFrame = g:PlaceCF(hold.X, hold.D, hold.R) * CFrame.new(0, 0.1, 0)
	plateP.Color = valid and Color3.fromRGB(120, 230, 130) or Color3.fromRGB(255, 90, 90)
end

----------------------------------------------------------------------
-- Tenir / poser / ranger
----------------------------------------------------------------------

local function refreshActions()
	local top = state.Top
	local help = top and top:FindFirstChild("Help") :: TextLabel?
	if help then
		if state.Holding then
			local icon, name = nameOf(state.Holding.Key)
			help.Text = "✋ " .. icon .. " " .. name .. "  ·  " .. Locale.T("R: rotate · click: place · Del: put away · Esc: cancel")
		else
			help.Text = Locale.T("Click something to move it · R: rotate · Del: put away · Esc: cancel")
		end
	end
	local actions = state.Actions
	if actions then
		actions.Visible = state.Holding ~= nil
		local putAway = actions:FindFirstChild("PutAway") :: TextButton?
		if putAway and state.Holding then
			local kind = GardenSnapshot.Parse(state.Holding.Key)
			putAway.Visible = kind == "D" or kind == "P"
		end
	end
end

local function releaseHold(restore: boolean)
	local hold = state.Holding
	state.Holding = nil
	if hold then
		if hold.Ghost then
			hold.Ghost:Destroy()
		elseif restore and state.Garden then
			state.Garden:ResetPreview(hold.Key)
		end
	end
	if state.Plate then
		state.Plate:Destroy()
		state.Plate = nil
	end
	refreshActions()
end

local function ghostify(model: Model)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Transparency = math.max(d.Transparency, 0.35)
			d.CastShadow = false
		end
	end
end

local function hold(key: string, isNew: boolean)
	local g = state.Garden
	if not g then
		return
	end
	releaseHold(true)
	local entry = state.Layout[key]
	local x, d, r = 0, GardenSnapshot.BACK_CENTER, 0
	if entry then
		x, d, r = entry.X, entry.D, entry.R or 0
	else
		-- nouvel objet : devant l'avatar
		local character = LocalPlayer.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			local lx, ld = g:ToLocal((root.CFrame * CFrame.new(0, 0, -6)).Position)
			x, d = lx, ld
		end
	end
	local h: any = { Key = key, X = x, D = d, R = r, New = isNew, X0 = x, D0 = d, R0 = r }
	if isNew then
		local ghost = g:MakeGhost(key)
		if not ghost then
			toast(Locale.T("This can't go in the garden"), RED)
			return
		end
		ghostify(ghost)
		ghost.Parent = workspace
		h.Ghost = ghost
	end
	state.Holding = h
	refreshActions()
end

local function scheduleSave()
	state.SaveAt = os.clock() + SAVE_DELAY
end

local function applyLocal()
	local g = state.Garden
	if g then
		g:ApplyLocal(table.clone(state.Layout), table.clone(state.Decor))
	end
end

local function drop()
	local g = state.Garden
	local h = state.Holding
	if not g or not h then
		return
	end
	if not isValid(g, h.Key, h.X, h.D, h.R) then
		toast(Locale.T("🚫 Not here: pick a free green spot"), RED)
		return
	end
	local kind, id = GardenSnapshot.Parse(h.Key)
	if h.New then
		if kind == "P" and countPlacedPieces(state.Layout) >= GardenSnapshot.PieceCap(level()) then
			toast(Locale.T("Your garden is full (max %d): put something away first", GardenSnapshot.PieceCap(level())), RED)
			return
		end
		if kind == "D" then
			if #state.Decor >= GardenSnapshot.DecorSlots(level()) then
				toast(Locale.T("Your garden is full (max %d): put something away first", GardenSnapshot.DecorSlots(level())), RED)
				return
			end
			table.insert(state.Decor, id :: string)
		end
	end
	state.Layout[h.Key] = { X = h.X, D = h.D, R = h.R }
	local ghost = h.Ghost
	state.Holding = nil
	if ghost then
		ghost:Destroy()
	end
	if state.Plate then
		state.Plate:Destroy()
		state.Plate = nil
	end
	applyLocal()
	scheduleSave()
	refreshActions()
end

local function putAway()
	local h = state.Holding
	if not h then
		return
	end
	local kind, id = GardenSnapshot.Parse(h.Key)
	if kind ~= "D" and kind ~= "P" then
		toast(Locale.T("This stays in the garden (move it instead)"))
		return
	end
	local wasNew = h.New
	releaseHold(false)
	if not wasNew then
		state.Layout[h.Key] = nil
		if kind == "D" then
			local index = table.find(state.Decor, id :: string)
			if index then
				table.remove(state.Decor, index)
			end
		end
		applyLocal()
		scheduleSave()
	end
	toast("📦 " .. Locale.T("Put away"))
	GardenEdit._refreshList()
end

local function rotate(delta: number)
	local h = state.Holding
	if h then
		h.R = GardenSnapshot.Rotation(h.R + delta)
	end
end

----------------------------------------------------------------------
-- Serveur
----------------------------------------------------------------------

local function invoke(action: string, arg: any): (boolean, any)
	local ok, success, result = pcall(function()
		return Net.Function("Garden"):InvokeServer(action, arg)
	end)
	if not ok then
		return false, Locale.T("Network error, try again.")
	end
	return success == true, result
end

-- La réponse du serveur fait foi (disposition, déco sortie, objets, niveau)
local function adopt(result: any)
	if type(result) ~= "table" then
		return
	end
	local d = ClientState.Data
	if type(d) == "table" then
		d.Garden = type(d.Garden) == "table" and d.Garden or {}
		if type(result.Pieces) == "table" then
			d.Garden.Pieces = result.Pieces
		end
		if result.Level ~= nil then
			d.Garden.Level = result.Level
		end
		if type(result.Layout) == "table" then
			d.Garden.Layout = result.Layout
		end
		if type(d.House) == "table" and type(result.Decor) == "table" then
			d.House.Garden = result.Decor
		end
	end
	local g = state.Garden
	if g and type(result.Layout) == "table" then
		g.State.Level = GardenSnapshot.Level(result.Level)
		state.Layout = table.clone(result.Layout)
		state.Decor = type(result.Decor) == "table" and table.clone(result.Decor) or state.Decor
		-- (garder la place de ce qui n'a pas été renvoyé : places par défaut)
		g:ApplyLocal(table.clone(state.Layout), table.clone(state.Decor))
		state.Layout = fullLayout(g)
	end
end

local function saveNow()
	if state.Saving or not state.Garden then
		return
	end
	state.Saving = true
	state.SaveAt = nil
	local layout = table.clone(state.Layout)
	local decor = table.clone(state.Decor)
	task.spawn(function()
		local ok, result = invoke("saveLayout", { Layout = layout, Decor = decor })
		state.Saving = false
		if ok then
			if type(result) == "table" and (tonumber(result.Dropped) or 0) > 0 then
				toast(Locale.T("Some things didn't fit and went back to storage"), RED)
			end
			adopt(result)
			GardenEdit._refreshList()
		else
			toast(tostring(result or Locale.T("The garden is resting 🌙")), RED)
			if state.Garden and type(result) == "string" and string.find(result, "Slow", 1, true) then
				scheduleSave()
			end
		end
	end)
end

local function buyPiece(id: string)
	task.spawn(function()
		local ok, result = invoke("buyPiece", id)
		if ok and type(result) == "table" then
			toast(tostring(result.Message or "🪴"), GREEN)
			adopt({ Pieces = result.Pieces, Level = result.Level })
			GardenEdit._refreshList()
			-- l'objet acheté arrive dans le fantôme
			local n = tonumber(result.Count) or 1
			local key = "P:" .. id .. ":" .. tostring(n)
			if state.Active and not state.Layout[key] then
				hold(key, true)
			end
		else
			toast(tostring(result), RED)
		end
	end)
end

local function expand()
	task.spawn(function()
		local ok, result = invoke("expand", nil)
		if ok and type(result) == "table" then
			toast(tostring(result.Message or "🌳"), GREEN)
			adopt(result)
			local g = state.Garden
			if g then
				g:Float(g.HouseCF * Vector3.new(0, 8, -GardenSnapshot.BACK_CENTER), "🌳 " .. Locale.T("Bigger garden!"), GOLD)
			end
			drawZones(state.Tab == "Expand")
			GardenEdit._refreshList()
		else
			toast(tostring(result), RED)
		end
	end)
end

----------------------------------------------------------------------
-- Interface
----------------------------------------------------------------------

local function card(parent: Instance, order: number, icon: string, title: string, sub: string, actionText: string?, actionColor: Color3?, onAction: (() -> ())?)
	local frame = newInstance("Frame", {
		Name = "Card",
		LayoutOrder = order,
		BackgroundColor3 = CARD,
		Size = UDim2.new(0, 150, 1, -8),
		BorderSizePixel = 0,
	}, parent)
	corner(frame, 12)
	newInstance("UIStroke", { Color = Color3.fromRGB(220, 200, 190), Thickness = 1.5 }, frame)
	newInstance("TextLabel", {
		Name = "Icon", BackgroundTransparency = 1, Text = icon, TextScaled = true, Font = Enum.Font.GothamBold,
		Size = UDim2.new(1, 0, 0.36, 0), Position = UDim2.fromScale(0, 0.03), TextColor3 = INK,
	}, frame)
	newInstance("TextLabel", {
		Name = "Title", BackgroundTransparency = 1, Text = title, TextScaled = true, Font = Enum.Font.FredokaOne,
		Size = UDim2.new(1, -10, 0.18, 0), Position = UDim2.new(0, 5, 0.4, 0), TextColor3 = INK,
	}, frame)
	newInstance("TextLabel", {
		Name = "Sub", BackgroundTransparency = 1, Text = sub, TextScaled = true, Font = Enum.Font.GothamBold,
		Size = UDim2.new(1, -10, 0.14, 0), Position = UDim2.new(0, 5, 0.58, 0), TextColor3 = Color3.fromRGB(140, 110, 110),
	}, frame)
	if actionText then
		local b = button(frame, "Action", actionText, actionColor or PINK, UDim2.new(1, -14, 0.22, 0), UDim2.new(0, 7, 0.75, 0))
		if onAction then
			b.Activated:Connect(onAction)
		end
	end
	return frame
end

function GardenEdit._refreshList()
	local list = state.List
	local g = state.Garden
	if not list or not g then
		return
	end
	for _, child in ipairs(list:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	local order = 0
	local lv = level()
	local d = data()
	local rebirths = tonumber(d.Rebirths) or 0
	if state.Tab == "Stored" then
		-- objets de jardin possédés pas posés
		local owned = ownedPieces()
		for _, piece in ipairs(Config.Garden.Pieces or {}) do
			local n = owned[piece.Id] or 0
			local free: number? = nil
			local placed = 0
			for k = 1, n do
				if state.Layout["P:" .. piece.Id .. ":" .. k] then
					placed += 1
				elseif not free then
					free = k
				end
			end
			if free then
				order += 1
				local key = "P:" .. piece.Id .. ":" .. tostring(free)
				card(list, order, tostring(piece.Icon), Locale.T(piece.Name), string.format("📦 %d", n - placed), Locale.T("Place"), GREEN, function()
					hold(key, true)
				end)
			end
		end
		-- déco du jardin rangée
		local decorOwned = ownedDecor()
		for _, entry in ipairs(Config.House.GardenDecor or {}) do
			if decorOwned[entry.Id] and not table.find(state.Decor, entry.Id) then
				order += 1
				card(list, order, tostring(entry.Icon), Locale.T(entry.Name), "🌷", Locale.T("Place"), GREEN, function()
					hold("D:" .. entry.Id, true)
				end)
			end
		end
		if order == 0 then
			order += 1
			card(list, order, "🛍️", Locale.T("Nothing stored"), Locale.T("Buy pots and more!"), Locale.T("🛍️ Buy"), PINK, function()
				GardenEdit._setTab("Shop")
			end)
		end
	elseif state.Tab == "Shop" then
		local owned = ownedPieces()
		for _, piece in ipairs(Config.Garden.Pieces or {}) do
			order += 1
			local n = owned[piece.Id] or 0
			local needed = tonumber(piece.RequiresRebirths) or 0
			local maxN = tonumber(piece.Max) or 10
			if rebirths < needed then
				card(list, order, tostring(piece.Icon), Locale.T(piece.Name), Locale.T("🔒 %d visits to the ocean", needed), nil)
			elseif n >= maxN then
				card(list, order, tostring(piece.Icon), Locale.T(piece.Name), string.format("✅ %d/%d", n, maxN), nil)
			else
				local cost = GardenSnapshot.PieceCost(piece, n)
				card(list, order, tostring(piece.Icon), Locale.T(piece.Name), string.format("%d/%d", n, maxN), "💧 " .. NumberFormatter.Format(cost), PINK, function()
					buyPiece(piece.Id)
				end)
			end
		end
	else
		-- Agrandir
		local info = GardenSnapshot.LevelInfo(lv + 1)
		order += 1
		local current = GardenSnapshot.LevelInfo(lv)
		card(list, order, current and tostring(current.Icon) or "🌱", current and Locale.T(current.Name) or Locale.T("Small garden"),
			Locale.T("Level %d/%d", lv, GardenSnapshot.MAX_LEVEL), nil)
		if info then
			order += 1
			local needed = tonumber(info.RequiresRebirths) or 0
			local sub = Locale.T("🌷 %d decor · 🪴 %d items", GardenSnapshot.DecorSlots(lv + 1), GardenSnapshot.PieceCap(lv + 1))
			if rebirths < needed then
				card(list, order, tostring(info.Icon), Locale.T(info.Name), Locale.T("🔒 %d visits to the ocean", needed), nil)
			else
				card(list, order, tostring(info.Icon), Locale.T(info.Name), sub, "💧 " .. NumberFormatter.Format(tonumber(info.Cost) or 0), GOLD, expand)
			end
			if type(info.Bonus) == "string" then
				order += 1
				local bonusNames = { RoseArch = { "🌸", "Rose arch" }, Greenhouse = { "🏡", "Greenhouse" }, KoiPond = { "🐟", "Koi pond" } }
				local b = bonusNames[info.Bonus] or { "🎁", info.Bonus }
				card(list, order, b[1], Locale.T(b[2]), Locale.T("🎁 Free with this level"), nil)
			end
		else
			order += 1
			card(list, order, "🏆", Locale.T("Your garden is already at its biggest!"), "", nil)
		end
	end
	if state.TopTitle then
		local current = GardenSnapshot.LevelInfo(lv)
		state.TopTitle.Text = Locale.T("🌷 My garden") .. "  ·  " .. (current and (tostring(current.Icon) .. " " .. Locale.T(current.Name)) or Locale.T("Small garden"))
			.. string.format("  ·  🪴 %d/%d", countPlacedPieces(state.Layout), GardenSnapshot.PieceCap(lv))
	end
end

function GardenEdit._setTab(tab: string)
	state.Tab = tab
	for name, b in pairs(state.Tabs) do
		b.BackgroundColor3 = name == tab and PINK or Color3.fromRGB(190, 160, 170)
	end
	if state.Active then
		drawZones(tab == "Expand")
	end
	GardenEdit._refreshList()
end

local function buildGui()
	local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not playerGui then
		return
	end
	local old = playerGui:FindFirstChild(GUI_NAME)
	if old then
		old:Destroy()
	end
	local gui = newInstance("ScreenGui", { Name = GUI_NAME, ResetOnSpawn = false, IgnoreGuiInset = false, DisplayOrder = 6, Enabled = true }, playerGui)
	state.Gui = gui
	-- bouton 🌷 Jardin (à gauche)
	-- (à gauche, sous le bouton "Retour" : la colonne des voitures du HUD est plus bas)
	local toggle = button(gui, "GardenToggle", "🌷 " .. Locale.T("Garden"), GREEN, UDim2.fromOffset(128, 46), UDim2.new(0, 12, 0.3, 0), Vector2.new(0, 0.5))
	toggle.Visible = false
	toggle.Activated:Connect(function()
		GardenEdit.SetEnabled(not state.Active)
	end)
	state.Toggle = toggle
	-- barre du haut (mode édition)
	local top = newInstance("Frame", {
		Name = "Top", BackgroundColor3 = CARD, BackgroundTransparency = 0.05, BorderSizePixel = 0, Visible = false,
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 178), Size = UDim2.new(0.92, 0, 0, 58), -- (sous le compteur et la plaque de la maison du HUD)
	}, gui)
	newInstance("UISizeConstraint", { MaxSize = Vector2.new(760, 58) }, top)
	corner(top, 14)
	state.TopTitle = newInstance("TextLabel", {
		Name = "Title", BackgroundTransparency = 1, Text = "", TextScaled = true, Font = Enum.Font.FredokaOne, TextColor3 = INK,
		Position = UDim2.new(0, 12, 0, 4), Size = UDim2.new(1, -150, 0, 28), TextXAlignment = Enum.TextXAlignment.Left,
	}, top)
	newInstance("TextLabel", {
		Name = "Help", BackgroundTransparency = 1, TextScaled = true, Font = Enum.Font.GothamBold, TextColor3 = Color3.fromRGB(140, 110, 110),
		Text = Locale.T("Click something to move it · R: rotate · Del: put away · Esc: cancel"),
		Position = UDim2.new(0, 12, 0, 32), Size = UDim2.new(1, -150, 0, 20), TextXAlignment = Enum.TextXAlignment.Left,
	}, top)
	local done = button(top, "Done", "✅ " .. Locale.T("Done"), GREEN_DARK, UDim2.fromOffset(124, 44), UDim2.new(1, -8, 0.5, 0), Vector2.new(1, 0.5))
	done.Activated:Connect(function()
		GardenEdit.SetEnabled(false)
	end)
	state.Top = top
	-- boutons quand on tient un objet
	local actions = newInstance("Frame", {
		Name = "Actions", BackgroundTransparency = 1, Visible = false,
		AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -236), Size = UDim2.fromOffset(4 * 130 + 3 * 8, 46),
	}, gui)
	-- (rangée au-dessus du plateau : les boutons du HUD à droite restent libres)
	newInstance("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, actions)
	local specs = {
		{ "Drop", "✅ " .. Locale.T("Place"), GREEN_DARK, drop },
		{ "Rotate", "🔄 " .. Locale.T("Rotate"), Color3.fromRGB(96, 150, 230), function() rotate(STEP) end },
		{ "PutAway", "📦 " .. Locale.T("Put away"), Color3.fromRGB(170, 130, 90), putAway },
		{ "Cancel", "❌ " .. Locale.T("Cancel"), RED, function() releaseHold(true) end },
	}
	for index, spec in ipairs(specs) do
		local b = button(actions, spec[1], spec[2], spec[3], UDim2.fromOffset(130, 46))
		b.LayoutOrder = index
		b.Activated:Connect(spec[4])
	end
	state.Actions = actions
	-- plateau du bas
	local panel = newInstance("Frame", {
		Name = "Panel", BackgroundColor3 = Color3.fromRGB(255, 244, 236), BackgroundTransparency = 0.04, BorderSizePixel = 0, Visible = false,
		AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Size = UDim2.new(0.96, 0, 0, 216),
	}, gui)
	newInstance("UISizeConstraint", { MaxSize = Vector2.new(980, 216) }, panel)
	corner(panel, 16)
	local tabs = newInstance("Frame", { Name = "Tabs", BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 8), Size = UDim2.new(1, -20, 0, 36) }, panel)
	newInstance("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, tabs)
	for index, spec in ipairs({ { "Stored", "📦 " .. Locale.T("Stored") }, { "Shop", "🛍️ " .. Locale.T("Buy") }, { "Expand", "🌳 " .. Locale.T("Enlarge") } }) do
		local b = button(tabs, spec[1], spec[2], Color3.fromRGB(190, 160, 170), UDim2.fromOffset(150, 36))
		b.LayoutOrder = index
		b.Activated:Connect(function()
			GardenEdit._setTab(spec[1])
		end)
		state.Tabs[spec[1]] = b
	end
	local list = newInstance("ScrollingFrame", {
		Name = "List", BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(10, 50), Size = UDim2.new(1, -20, 1, -58),
		ScrollingDirection = Enum.ScrollingDirection.X, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.X, ScrollBarThickness = 6,
	}, panel)
	newInstance("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, list)
	state.List = list
	state.Panel = panel
end

----------------------------------------------------------------------
-- Pointeur -> pelouse
----------------------------------------------------------------------

local function pointerToLawn(g: any, screen: Vector2): (number?, number?)
	local camera = workspace.CurrentCamera
	if not camera then
		return nil, nil
	end
	local ray = camera:ViewportPointToRay(screen.X, screen.Y)
	local planeY = (g.HouseCF * CFrame.new(0, LAWN_TOP, 0)).Position.Y
	local dir = ray.Direction
	if math.abs(dir.Y) < 1e-4 then
		return nil, nil
	end
	local t = (planeY - ray.Origin.Y) / dir.Y
	if t <= 0 or t > 400 then
		return nil, nil
	end
	local hit = ray.Origin + dir * t
	local x, d = g:ToLocal(hit)
	return math.floor(x / GRID + 0.5) * GRID, math.floor(d / GRID + 0.5) * GRID
end

local function pick(g: any, screen: Vector2): string?
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end
	local ray = camera:ViewportPointToRay(screen.X, screen.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { g.Model }
	local result = workspace:Raycast(ray.Origin, ray.Direction * 300, params)
	if result and result.Instance then
		return g:KeyOf(result.Instance)
	end
	return nil
end

local function follow()
	local g = state.Garden
	local h = state.Holding
	if not g or not h then
		return
	end
	local x, d = nil, nil
	if state.Pointer then
		x, d = pointerToLawn(g, state.Pointer :: Vector2)
	end
	if x and d then
		-- (on garde l'écart entre le point cliqué et le centre de l'objet)
		h.X = math.floor((x + (h.OffX or 0)) / GRID + 0.5) * GRID
		h.D = math.floor((d + (h.OffD or 0)) / GRID + 0.5) * GRID
	end
	local cf = g:PlaceCF(h.X, h.D, h.R)
	if h.Ghost then
		h.Ghost:PivotTo(cf)
	else
		g:Preview(h.Key, h.X, h.D, h.R)
	end
	updatePlate(g, h, isValid(g, h.Key, h.X, h.D, h.R))
end

local function onPress(screen: Vector2)
	local g = state.Garden
	if not g then
		return
	end
	state.Pointer = screen
	if state.Holding then
		follow()
		drop()
		return
	end
	local key = pick(g, screen)
	if key and key ~= "G" then
		hold(key, false)
		local h = state.Holding
		local x, d = pointerToLawn(g, screen)
		if h and x and d then
			h.OffX, h.OffD = h.X - x, h.D - d
		end
		follow()
	end
end

----------------------------------------------------------------------
-- Activer / quitter
----------------------------------------------------------------------

local function connectInputs()
	table.insert(state.Connections, UserInputService.InputBegan:Connect(function(input, processed)
		if not state.Active then
			return
		end
		if input.UserInputType == Enum.UserInputType.Keyboard then
			if processed then
				return
			end
			if input.KeyCode == Enum.KeyCode.R then
				local shift = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
				rotate(shift and -STEP or STEP)
			elseif input.KeyCode == Enum.KeyCode.Delete or input.KeyCode == Enum.KeyCode.Backspace then
				putAway()
			elseif input.KeyCode == Enum.KeyCode.Escape then
				if state.Holding then
					releaseHold(true)
				else
					GardenEdit.SetEnabled(false)
				end
			end
			return
		end
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			onPress(Vector2.new(input.Position.X, input.Position.Y))
		end
	end))
	table.insert(state.Connections, UserInputService.InputChanged:Connect(function(input, processed)
		if not state.Active or processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			state.Pointer = Vector2.new(input.Position.X, input.Position.Y)
		end
	end))
end

function GardenEdit.IsActive(): boolean
	return state.Active
end

function GardenEdit.SetEnabled(on: boolean)
	if on == state.Active then
		return
	end
	if on then
		local g = garden()
		if not g then
			toast(Locale.T("Go to your garden first"))
			return
		end
		local busy = state.Ctx.IsBusy
		if type(busy) == "function" then
			local okBusy, isBusy = pcall(busy)
			if okBusy and isBusy then
				return
			end
		end
		state.Active = true
		state.Garden = g
		g:SetEditing(true)
		state.Layout = fullLayout(g)
		state.Decor = table.clone(g.State.Decor or {})
		if not state.Gui or not state.Gui.Parent then
			buildGui()
		end
		if state.Gui then
			state.Gui.Enabled = true
		end
		if state.Top then
			state.Top.Visible = true
		end
		if state.Panel then
			state.Panel.Visible = true
		end
		if state.Toggle then
			state.Toggle.Visible = false -- (le bouton ✅ Terminé est dans la barre du haut)
		end
		connectInputs()
		pcall(function()
			RunService:BindToRenderStep(RENDER, Enum.RenderPriority.Input.Value + 1, function()
				follow()
			end)
		end)
		GardenEdit._setTab(state.Tab)
		drawZones(state.Tab == "Expand")
		toast(Locale.T("🌷 Garden edit: click something to move it"))
	else
		state.Active = false
		releaseHold(true)
		pcall(function()
			RunService:UnbindFromRenderStep(RENDER)
		end)
		for _, connection in ipairs(state.Connections) do
			connection:Disconnect()
		end
		table.clear(state.Connections)
		clearZones()
		if state.SaveAt then
			saveNow()
		end
		local g = state.Garden
		if g and not g.Destroyed then
			g:SetEditing(false)
		end
		state.Garden = nil
		if state.Top then
			state.Top.Visible = false
		end
		if state.Panel then
			state.Panel.Visible = false
		end
		if state.Actions then
			state.Actions.Visible = false
		end
		if state.Toggle then
			state.Toggle.Text = "🌷 " .. Locale.T("Garden")
		end
	end
end

-- Sur sa parcelle (dehors ou dedans) ?
local function onOwnPlot(g: any): boolean
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return false
	end
	local x, d = g:ToLocal(root.Position)
	return math.abs(x) < 90 and d > -32 and d < 56
end

function GardenEdit.Start(ctx: any?)
	state.Ctx = type(ctx) == "table" and ctx or {}
	state.Started = true
	buildGui()
end

function GardenEdit.Step(dt: number?)
	if not state.Started then
		return
	end
	state.Clock += dt or 0
	-- sauvegarde différée (plusieurs poses de suite = un seul envoi)
	if state.SaveAt and os.clock() >= state.SaveAt then
		saveNow()
	end
	local g = garden()
	if state.Active then
		if not g or g ~= state.Garden then
			GardenEdit.SetEnabled(false)
		end
		return
	end
	if state.Toggle then
		local show = g ~= nil and onOwnPlot(g)
		state.Toggle.Visible = show
		if show and state.Gui and not state.Gui.Enabled then
			state.Gui.Enabled = true
		end
	end
end

function GardenEdit.Stop()
	if state.Active then
		GardenEdit.SetEnabled(false)
	end
	state.Started = false
	if state.Gui then
		state.Gui:Destroy()
	end
	state.Gui = nil
	state.Toggle = nil
	state.Top = nil
	state.Panel = nil
	state.List = nil
	state.Actions = nil
	state.TopTitle = nil
	table.clear(state.Tabs)
end

-- (tests) état interne + actions directes
function GardenEdit.Debug(): any
	return {
		State = state,
		Hold = hold,
		Drop = drop,
		PutAway = putAway,
		Rotate = rotate,
		Follow = follow,
		SaveNow = saveNow,
		IsValid = isValid,
		Pick = pick,
		SetPointer = function(v: Vector2)
			state.Pointer = v
		end,
		SetTab = GardenEdit._setTab,
		Buy = buyPiece,
		Expand = expand,
	}
end

return GardenEdit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="197">
          <Properties>
            <string name="Name">HouseBuildAnim</string>
            <string name="Source"><![CDATA[--[[
	HouseBuildAnim (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > HouseBuildAnim

	🏗️ v10 (CONSTRUCT10) : la maison d'un joueur SE CONSTRUIT sous nos yeux
	(~11,5 s, passable), avec les VRAIES pièces de la maison (HouseBuilder) :
	pas de maquette à part, donc la fin tombe EXACTEMENT sur la maison
	normale (aucune double géométrie, aucun z-fight).
	  0,0 s  chantier dégagé (nuage de poussière) ;
	  1,0 s  fondations coulées (elles montent du sol, en onde depuis le centre) ;
	  2,7 s  murs étage par étage : les petites pièces s'empilent comme des
	         briques (bas -> haut, gauche -> droite), les grands panneaux
	         glissent en place ; l'échafaudage monte avec chaque étage ;
	  6,5 s  le toit : chaque pièce arrive du ciel en arc, en tournoyant,
	         depuis la grue, et se pose avec un petit rebond ;
	  8,3 s  fenêtres, portes, volets : ils "poppent" avec des étincelles ;
	         l'intérieur apparaît en fondu ;
	  9,3 s  l'échafaudage redescend, la grue s'en va ;
	  9,6 s  le jardin POUSSE (clôtures, arbres, fleurs grandissent du sol) ;
	 11,4 s  confettis, la maison est prête.
	Tout est interpolé (Out-Back / Out-Cubic / arcs), jamais de saut.

	Comment (sûr) :
	  - masquer = LocalTransparencyModifier (jamais Transparency : HouseBuilder
	    garde la main sur les vitres, lueurs, remplissages) ; Decal / Texture
	    aussi ; SurfaceGui / BillboardGui / lumières / particules / invites
	    coupées puis RENDUES quand leur pièce se pose (seulement si personne
	    ne les a changées entre-temps) ;
	  - bouger = workspace:BulkMoveTo, puis CFrame final EXACT ;
	  - une pièce déplacée par quelqu'un d'autre pendant l'animation (porte qui
	    s'ouvre…) est lâchée : on ne la touche plus ;
	  - CanCollide coupé pendant le vol, rendu à l'atterrissage ;
	  - une pièce ajoutée pendant l'animation (pièce en flux, jardin) est
	    masquée puis apparaît à sa phase ;
	  - phase d'une pièce : attribut "BuildPhase" (HOUSE10) sur la pièce ou un
	    parent (Foundation / Walls / Roof / Openings / Garden / Interior),
	    sinon déduite de la géométrie et du nom ;
	  - attribut "Constructing" = true sur le modèle pendant l'animation ;
	    house:HoldFull(true / false) s'il existe (LOD complet pendant ce temps).

	API :
	  HouseBuildAnim.new(house, opts) -> Anim
	    opts : { Parent: Instance?, Crane: rig?, OnDone: (skipped) -> ()?, Seed: number? }
	  anim:Prepare()    (masque tout de suite : idempotent)
	  anim:Play()       (démarre la frise)
	  anim:Step(dt)     (à chaque image)
	  anim:Finish(skipped?)  (état final immédiat, tout rendu)
	  anim:Progress() -> 0..1 ; anim:PhaseName() -> clé ; anim.Done
	  HouseBuildAnim.DURATION ; HouseBuildAnim.Classify(house, part) (tests)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WorldLayout = require(ReplicatedStorage.Shared.WorldLayout)
local Kit = require(script.Parent.ConstructionKit)

local HouseBuildAnim = {}
HouseBuildAnim.__index = HouseBuildAnim

HouseBuildAnim.DURATION = 11.6

-- Fenêtres de la frise (secondes depuis Play)
local W = {
	Clear = { 0, 1.2 },
	Foundation = { 1.0, 2.9 },
	Walls = { 2.7, 6.9 },
	Roof = { 6.5, 8.7 },
	Openings = { 8.3, 9.7 },
	Interior = { 8.6, 9.8 },
	ScaffoldDown = { 9.3, 10.4 },
	Garden = { 9.6, 11.3 },
	Finale = 11.4,
}
HouseBuildAnim.Windows = W

local DUR = { Foundation = 0.6, Walls = 0.5, Roof = 0.8, Openings = 0.45, Interior = 0.6, Garden = 0.75 }

-- Clés de nom -> phase (repli si l'attribut BuildPhase manque)
local NAME_RULES = {
	{ "Interior", { "Hall", "Console", "Coat", "Foyer", "Chandelier", "Landing", "Stair", "Tread", "Riser", "Newel", "Nosing", "Runner", "Skirting", "Closet", "Picture", "KeyBowl", "Shoe", "Hat", "Mirror", "Shelf", "Scarf", "Ceiling", "UnderStair", "Fountain" } },
	{ "Roof", { "Roof", "Ridge", "Hip", "Gutter", "Downpipe", "Chimney", "Dormer", "Eave", "Tile", "Slate", "Shingle", "Fascia", "Crest", "Parapet", "Coping", "TowerTop", "TowerCrown", "TowerScallop", "Smoke", "WaterTank", "Tank", "Pediment", "Gable", "Soffit", "Finial", "Spire", "Weathervane" } },
	{ "Openings", { "Window", "Win", "Glass", "Pane", "Mullion", "Sill", "Shutter", "Door", "Knob", "Jamb", "Transom", "Curtain", "Lantern", "Lamp", "Bulb", "Plaque", "NamePlate", "NamePanel", "Sign", "Canopy", "Hood", "Mat", "Glow", "Fill", "Keystone", "FlowerBox", "Awning", "Handle", "Letter", "Number" } },
	{ "Garden", { "Fence", "Picket", "Gate", "Path", "Bush", "Shrub", "Tree", "Trunk", "Leaves", "Bloom", "Flower", "Planter", "Plant", "Hedge", "Lawn", "Driveway", "Mailbox", "MailBox", "Urn", "Garden", "Flamingo", "Gnome", "Bird", "Pond", "Stalk", "Fruit", "Trampoline", "Umbrella", "Parasol", "Bike", "LightPole", "LampPost", "Grass", "Rock", "Stone", "Bench", "Pool" } },
	{ "Foundation", { "Foundation", "Plinth", "Porch", "Step", "Stoop", "Terrace", "Footing", "Base" } },
}

local function namePhase(name: string): string?
	for _, rule in ipairs(NAME_RULES) do
		for _, key in ipairs(rule[2]) do
			if string.find(name, key, 1, true) then
				return rule[1]
			end
		end
	end
	return nil
end

local VALID = { Foundation = true, Walls = true, Roof = true, Openings = true, Garden = true, Interior = true }

local function attrPhase(part: Instance, stop: Instance): string?
	local node: Instance? = part
	while node and node ~= stop do
		local value = node:GetAttribute("BuildPhase")
		if type(value) == "string" and VALID[value] then
			return value
		end
		node = node.Parent
	end
	return nil
end

-- Géométrie de la maison (repère local x, y, d ; d = profondeur vers l'intérieur)
local function geometry(house: any): any
	local size = house.Size
	local dims = WorldLayout.Dims(size)
	return {
		CF = house.HouseCF,
		Left = dims.Left,
		Right = dims.Left + dims.Width,
		Depth = dims.Depth,
		Height = dims.Height,
		Floors = dims.Floors,
		Ground = WorldLayout.GROUND_Y + 0.05,
	}
end

-- Boîte (repère maison) d'une pièce : centre local + demi-étendues
local function localBox(g: any, part: BasePart): (Vector3, Vector3)
	local rel = g.CF:ToObjectSpace(part.CFrame)
	local s = part.Size / 2
	local r = rel.Rotation
	local rx, ry, rz = r.RightVector, r.UpVector, r.LookVector
	local ex = math.abs(rx.X) * s.X + math.abs(ry.X) * s.Y + math.abs(rz.X) * s.Z
	local ey = math.abs(rx.Y) * s.X + math.abs(ry.Y) * s.Y + math.abs(rz.Y) * s.Z
	local ez = math.abs(rx.Z) * s.X + math.abs(ry.Z) * s.Y + math.abs(rz.Z) * s.Z
	-- (d = -z local)
	return Vector3.new(rel.Position.X, rel.Position.Y, -rel.Position.Z), Vector3.new(ex, ey, ez)
end

local function classify(house: any, g: any, part: BasePart): string
	local model = house.Model
	local tagged = attrPhase(part, model)
	if tagged then
		return tagged
	end
	local interiors = house.Interiors
	if interiors and part:IsDescendantOf(interiors) then
		return "Interior"
	end
	local c, e = localBox(g, part)
	local x, y, d = c.X, c.Y, c.Z
	local top, bottom = y + e.Y, y - e.Y
	local inside = x > g.Left - 0.8 and x < g.Right + 0.8 and d > -0.8 and d < g.Depth + 0.8
	local byName = namePhase(part.Name)
	if not inside then
		-- dehors : perron / marches bas près de la façade, jardin plus loin
		local near = x > g.Left - 8 and x < g.Right + 8 and d > -9 and d < g.Depth + 6
		if byName == "Garden" or byName == "Openings" or byName == "Roof" then
			if byName == "Roof" and bottom > WorldLayout.PLINTH + 3 then
				return "Roof"
			end
			if byName == "Openings" and near then
				return "Openings"
			end
			return "Garden"
		end
		if near and top <= WorldLayout.PLINTH + 1.4 then
			return "Foundation"
		end
		if near then
			return "Walls" -- colonnes du porche, garage, balcons
		end
		return "Garden"
	end
	if byName == "Interior" then
		return "Interior"
	end
	if top <= WorldLayout.FloorY(1) + 0.15 then
		return "Foundation"
	end
	if byName == "Roof" or bottom >= g.Height - 0.4 then
		return "Roof"
	end
	if byName == "Openings" then
		return "Openings"
	end
	-- à l'intérieur de l'enveloppe (loin des murs extérieurs) : intérieur
	local envelope = d < 1.8 or d > g.Depth - 1.8 or x < g.Left + 1.8 or x > g.Right - 1.8
	if not envelope and math.max(e.X, e.Z) < 6 then
		return "Interior"
	end
	return "Walls"
end

function HouseBuildAnim.Classify(house: any, part: BasePart): string
	return classify(house, geometry(house), part)
end

----------------------------------------------------------------------
-- Suivi des pièces
----------------------------------------------------------------------

type Track = {
	Part: BasePart,
	Phase: string,
	Final: CFrame,
	Size: Vector3,
	Collide: boolean,
	Start: number,
	Dur: number,
	Motion: string,
	From: CFrame?,
	Arc: number,
	Spin: CFrame?,
	Last: CFrame?,
	State: string, -- "Wait" | "Fly" | "Done" | "Drop"
	Grow: boolean,
	GroundY: number,
	Effects: { { Instance: Instance, Prop: string, Value: any, Set: any } },
	Order: number,
	Late: boolean,
}

local EFFECT_PROPS = {
	SurfaceGui = "Enabled",
	BillboardGui = "Enabled",
	PointLight = "Enabled",
	SpotLight = "Enabled",
	SurfaceLight = "Enabled",
	ParticleEmitter = "Enabled",
	Beam = "Enabled",
	Fire = "Enabled",
	Smoke = "Enabled",
	Sparkles = "Enabled",
	ProximityPrompt = "Enabled",
}

local function easeOutBack(x: number): number
	local c1 = 1.4
	local c3 = c1 + 1
	local u = x - 1
	return 1 + c3 * u * u * u + c1 * u * u
end

local function easeOutCubic(x: number): number
	local u = 1 - x
	return 1 - u * u * u
end

local function hash(a: number, b: number): number
	local x = math.sin(a * 12.9898 + b * 78.233) * 43758.5453
	return x - math.floor(x)
end

export type Anim = typeof(setmetatable({} :: { [string]: any }, HouseBuildAnim))

function HouseBuildAnim.new(house: any, opts: any?): Anim
	local o = opts or {}
	local self = setmetatable({
		House = house,
		Geo = geometry(house),
		Parent = o.Parent or workspace,
		Crane = o.Crane,
		OnDone = o.OnDone,
		Seed = tonumber(o.Seed) or 1,
		Tracks = {} :: { Track },
		LateQueue = {} :: { Track },
		Label = o.Label,
		ByPart = {} :: { [BasePart]: Track },
		Loose = {} :: { { Instance: Instance, Prop: string, Value: any, Set: any } },
		Prepared = false,
		Playing = false,
		Done = false,
		Clock = 0,
		Next = 1,
		Active = {} :: { Track },
		Fx = nil,
		Scaffold = nil,
		Conn = nil,
		Bursts = {},
		PhaseKey = "Clear",
	}, HouseBuildAnim)
	return self
end

-- Coupe un effet (garde la valeur pour la rendre)
local function muteEffect(list: { any }, inst: Instance)
	local prop = EFFECT_PROPS[inst.ClassName]
	if prop then
		local value = (inst :: any)[prop]
		if value == true then
			(inst :: any)[prop] = false
			table.insert(list, { Instance = inst, Prop = prop, Value = value, Set = false })
		end
	elseif inst:IsA("Decal") then
		(inst :: any).LocalTransparencyModifier = 1
		table.insert(list, { Instance = inst, Prop = "LocalTransparencyModifier", Value = 0, Set = 1 })
	end
end

local function restoreEffects(list: { any })
	for _, e in ipairs(list) do
		local inst = e.Instance
		if inst.Parent then
			-- (seulement si personne ne l'a changé entre-temps)
			local ok, current = pcall(function()
				return (inst :: any)[e.Prop]
			end)
			if ok and current == e.Set then
				pcall(function()
					(inst :: any)[e.Prop] = e.Value
				end)
			end
		end
	end
	table.clear(list)
end

function HouseBuildAnim.Track(self: Anim, part: BasePart, late: boolean)
	if self.ByPart[part] then
		return
	end
	local phase = classify(self.House, self.Geo, part)
	local t: Track = {
		Part = part,
		Phase = phase,
		Final = part.CFrame,
		Size = part.Size,
		Collide = part.CanCollide,
		Start = 0,
		Dur = DUR[phase] or 0.5,
		Motion = "Fade",
		From = nil,
		Arc = 0,
		Spin = nil,
		Last = nil,
		State = "Wait",
		Grow = false,
		GroundY = self.Geo.CF.Position.Y + self.Geo.Ground,
		Effects = {},
		Order = 0,
		Late = late,
	}
	part.LocalTransparencyModifier = 1
	part.CanCollide = false
	for _, child in ipairs(part:GetChildren()) do
		muteEffect(t.Effects, child)
		for _, sub in ipairs(child:GetChildren()) do
			muteEffect(t.Effects, sub)
		end
	end
	self.ByPart[part] = t
	if self.Playing then
		-- (pendant la frise : file à part, jamais de tri de toute la liste)
		self:Schedule(t, true)
		table.insert(self.LateQueue, t)
	else
		table.insert(self.Tracks, t)
	end
end

-- Masque tout de suite (la maison est "à construire")
function HouseBuildAnim.Prepare(self: Anim)
	if self.Prepared or self.Done then
		return
	end
	self.Prepared = true
	local house = self.House
	local model: Model = house.Model
	model:SetAttribute("Constructing", true)
	if type(house.HoldFull) == "function" then
		pcall(house.HoldFull, house, true)
	end
	self.Geo = geometry(house)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			self:Track(d, false)
		elseif not d.Parent or not d.Parent:IsA("BasePart") then
			muteEffect(self.Loose, d)
		end
	end
	self.Conn = model.DescendantAdded:Connect(function(d)
		if self.Done then
			return
		end
		if d:IsA("BasePart") then
			self:Track(d, true)
		else
			task.defer(function()
				if self.Done or not d.Parent then
					return
				end
				local parent = d.Parent
				local track = parent and parent:IsA("BasePart") and self.ByPart[parent :: BasePart]
				if track and track.State ~= "Done" and track.State ~= "Drop" then
					muteEffect(track.Effects, d)
				end
			end)
		end
	end)
end

-- Horaire d'une pièce selon sa phase
function HouseBuildAnim.Schedule(self: Anim, t: Track, late: boolean?)
	local g = self.Geo
	local c, e = localBox(g, t.Part)
	local x, y, d = c.X, c.Y, c.Z
	local width = math.max(1, g.Right - g.Left)
	local nx = (x - g.Left) / width
	local jitter = hash(x + self.Seed, y + d)
	local phase = t.Phase
	local w0, w1
	if phase == "Foundation" then
		w0, w1 = W.Foundation[1], W.Foundation[2]
		local cx, cd = (g.Left + g.Right) / 2, g.Depth / 2
		local dist = math.sqrt((x - cx) ^ 2 + (d - cd) ^ 2) / math.max(1, width * 0.7)
		t.Order = math.clamp(dist, 0, 1) * 0.85 + jitter * 0.15
		t.Motion = "Rise"
	elseif phase == "Walls" then
		local floors = math.max(1, g.Floors)
		local bottom = y - e.Y
		local band = math.clamp(math.floor((bottom - WorldLayout.PLINTH) / WorldLayout.STORY), 0, floors - 1)
		local span = (W.Walls[2] - W.Walls[1]) / floors
		w0 = W.Walls[1] + band * span
		w1 = w0 + span + 0.3
		local inBand = math.clamp((bottom - (WorldLayout.PLINTH + band * WorldLayout.STORY)) / WorldLayout.STORY, 0, 1)
		t.Order = inBand * 0.7 + nx * 0.25 + jitter * 0.05
		local long = math.max(t.Size.X, t.Size.Z)
		local thin = math.min(t.Size.X, t.Size.Y, t.Size.Z)
		if long > 9 and thin < 2.5 then
			t.Motion = "Slide"
		else
			t.Motion = "Rise"
		end
	elseif phase == "Roof" then
		w0, w1 = W.Roof[1], W.Roof[2]
		local rel = math.clamp((y - g.Height) / 14, 0, 1)
		t.Order = rel * 0.75 + jitter * 0.25
		t.Motion = "Fly"
	elseif phase == "Openings" then
		w0, w1 = W.Openings[1], W.Openings[2]
		local floor = math.clamp((y - WorldLayout.PLINTH) / math.max(1, g.Height - WorldLayout.PLINTH), 0, 1)
		t.Order = floor * 0.5 + nx * 0.4 + jitter * 0.1
		t.Motion = "Pop"
	elseif phase == "Garden" then
		w0, w1 = W.Garden[1], W.Garden[2]
		local door = Vector3.new((g.Left + g.Right) / 2, 0, -2)
		local dist = (Vector3.new(x, 0, d) - door).Magnitude / 60
		t.Order = math.clamp(dist, 0, 1) * 0.85 + jitter * 0.15
		t.Motion = "Grow"
		local part = t.Part
		t.Grow = (part.ClassName == "Part" or part.ClassName == "WedgePart") and part:FindFirstChildWhichIsA("SurfaceGui") == nil
			and part:FindFirstChildWhichIsA("Decal") == nil and part.Size.Magnitude < 40
	else
		w0, w1 = W.Interior[1], W.Interior[2]
		t.Order = jitter
		t.Motion = "Fade"
	end
	local dur = DUR[phase] or 0.5
	t.Dur = dur
	t.Start = w0 + t.Order * math.max(0, (w1 - w0) - dur)
	if late then
		-- pièce arrivée en cours de route : à sa phase, ou tout de suite si elle est passée
		t.Start = math.max(t.Start, self.Clock + 0.05)
	end
	-- départ du vol
	local final = t.Final
	local extent = e.Y * 2
	if t.Motion == "Rise" then
		t.From = final - Vector3.new(0, extent + 0.8, 0)
	elseif t.Motion == "Slide" then
		-- le long du grand axe horizontal, vers l'extérieur de la maison
		local axis = if t.Size.X >= t.Size.Z then final.RightVector else final.LookVector
		axis = Vector3.new(axis.X, 0, axis.Z)
		if axis.Magnitude < 1e-3 then
			axis = g.CF.RightVector
		end
		axis = axis.Unit
		local outward = final.Position - g.CF * Vector3.new((g.Left + g.Right) / 2, final.Position.Y - g.CF.Position.Y, -g.Depth / 2)
		if axis:Dot(outward) < 0 then
			axis = -axis
		end
		t.From = final + axis * 9 + Vector3.new(0, 1.5, 0)
	elseif t.Motion == "Fly" then
		-- (livrées d'en haut, un peu de côté, en tournant doucement : lisible, pas de pluie d'éclats)
		local lateral = g.CF.RightVector * ((hash(x, d + 3) - 0.5) * 6) + g.CF.LookVector * (2 + hash(d, x) * 4)
		t.From = final + Vector3.new(0, 16 + hash(y, x) * 6, 0) + lateral
		t.Spin = CFrame.Angles((hash(x, 1) - 0.5) * 0.35, (hash(d, 2) - 0.5) * 0.7, (hash(y, 3) - 0.5) * 0.35)
		t.Arc = 3 + hash(x, y) * 3
		if math.max(t.Size.X, t.Size.Y, t.Size.Z) > 16 then
			-- grands pans de toit : descendus bien droit (posés par la grue)
			t.From = final + Vector3.new(0, 9 + hash(y, x) * 3, 0)
			t.Spin = CFrame.identity
			t.Arc = 0
		end
	elseif t.Motion == "Pop" then
		local outward = final.Position - g.CF * Vector3.new(x, y, -g.Depth / 2)
		outward = Vector3.new(outward.X, 0, outward.Z)
		outward = if outward.Magnitude > 1e-3 then outward.Unit else -g.CF.LookVector
		t.From = final + outward * 1.6
	elseif t.Motion == "Grow" and not t.Grow then
		t.From = final - Vector3.new(0, math.min(extent, 6) + 0.3, 0)
	end
end

----------------------------------------------------------------------
-- Échafaudage + effets
----------------------------------------------------------------------

local function emitter(parent: Instance, name: string, size: Vector3, cf: CFrame, kind: string): (BasePart, ParticleEmitter)
	local anchor = Instance.new("Part")
	anchor.Name = name
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = size
	anchor.CFrame = cf
	anchor.Parent = parent
	local em = Instance.new("ParticleEmitter")
	em.Rate = 0
	em.LightEmission = 0
	if kind == "Dust" then
		em.Texture = "rbxasset://textures/particles/smoke_main.dds"
		em.Color = ColorSequence.new(Color3.fromRGB(196, 176, 150), Color3.fromRGB(226, 214, 196))
		em.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, 9) })
		em.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(1, 1) })
		em.Lifetime = NumberRange.new(1.2, 2.2)
		em.Speed = NumberRange.new(3, 7)
		em.SpreadAngle = Vector2.new(80, 20)
		em.Acceleration = Vector3.new(0, 1.5, 0)
		em.Drag = 1.5
	elseif kind == "Sparkle" then
		em.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		em.Color = ColorSequence.new(Color3.fromRGB(255, 250, 200), Color3.fromRGB(255, 200, 240))
		em.LightEmission = 0.6
		em.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 0) })
		em.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0.6) })
		em.Lifetime = NumberRange.new(0.5, 0.9)
		em.Speed = NumberRange.new(2, 5)
		em.SpreadAngle = Vector2.new(180, 180)
	else -- Confetti
		em.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 90, 160)),
			ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 214, 60)),
			ColorSequenceKeypoint.new(0.66, Color3.fromRGB(90, 210, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 110, 255)),
		})
		em.Size = NumberSequence.new(0.5)
		em.Lifetime = NumberRange.new(2.2, 3.2)
		em.Speed = NumberRange.new(22, 36)
		em.SpreadAngle = Vector2.new(55, 55)
		em.Acceleration = Vector3.new(0, -26, 0)
		em.Drag = 1.2
		em.Rotation = NumberRange.new(0, 360)
		em.RotSpeed = NumberRange.new(-260, 260)
		em.EmissionDirection = Enum.NormalId.Top
	end
	em.Parent = anchor
	return anchor, em
end

local function burst(em: ParticleEmitter?, n: number)
	if em then
		pcall(function()
			em:Emit(n)
		end)
	end
end

function HouseBuildAnim.BuildFx(self: Anim)
	local g = self.Geo
	local fx = Instance.new("Folder")
	fx.Name = "BuildFx_" .. tostring(self.House.UserId or 0)
	fx.Parent = self.Parent
	self.Fx = fx
	local cf = g.CF
	local width = g.Right - g.Left
	local center = cf * CFrame.new((g.Left + g.Right) / 2, g.Ground + 1, -g.Depth / 2)
	local _, dust = emitter(fx, "Dust", Vector3.new(width + 6, 2, g.Depth + 10), center, "Dust")
	self.Dust = dust
	local sparkAnchor, spark = emitter(fx, "Sparkle", Vector3.new(4, 4, 1), center, "Sparkle")
	self.SparkAnchor, self.Spark = sparkAnchor, spark
	local _, confetti = emitter(fx, "Confetti", Vector3.new(width * 0.7, 1, g.Depth * 0.7), cf * CFrame.new((g.Left + g.Right) / 2, g.Height + 4, -g.Depth / 2), "Confetti")
	self.Confetti = confetti
	-- (les autres joueurs) "🏗️ La maison de X se construit !"
	if type(self.Label) == "string" and confetti.Parent then
		local bb = Instance.new("BillboardGui")
		bb.Name = "BuildLabel"
		bb.Size = UDim2.fromScale(26, 4)
		bb.StudsOffset = Vector3.new(0, 6, 0)
		bb.MaxDistance = 320
		bb.LightInfluence = 0
		local label = Instance.new("TextLabel")
		label.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		label.BackgroundTransparency = 0.15
		label.Size = UDim2.fromScale(1, 1)
		label.TextScaled = true
		label.Font = Enum.Font.FredokaOne
		label.TextColor3 = Color3.fromRGB(236, 72, 140)
		label.Text = self.Label
		label.Parent = bb
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.4, 0)
		corner.Parent = label
		bb.Parent = confetti.Parent
	end
	-- échafaudage : façade + 2 côtés, un plancher par étage
	local lifts = math.max(1, g.Floors)
	local liftH = WorldLayout.STORY
	local base = g.Ground
	local faces = {
		{ cf * CFrame.new(g.Right + 1, base, 0.3) * CFrame.Angles(0, math.pi, 0), width + 2 },
		{ cf * CFrame.new(g.Left - 0.3, base, 1) * CFrame.Angles(0, math.pi / 2, 0), g.Depth - 2 },
		{ cf * CFrame.new(g.Right + 0.3, base, -g.Depth + 1) * CFrame.Angles(0, -math.pi / 2, 0), g.Depth - 2 },
	}
	local scaffold = Instance.new("Model")
	scaffold.Name = "Scaffold"
	scaffold.Parent = fx
	local byLift: { { BasePart } } = {}
	for i, face in ipairs(faces) do
		local lists = Kit.Scaffold(scaffold, face[1], face[2], { Lifts = lifts, LiftH = liftH, Bay = 8, Net = false, Ladder = i == 1 })
		for lift, list in ipairs(lists) do
			byLift[lift] = byLift[lift] or {}
			for _, p in ipairs(list) do
				table.insert(byLift[lift], p)
			end
		end
	end
	local sc = { Lifts = {} }
	for lift, list in ipairs(byLift) do
		local finals = {}
		for i, p in ipairs(list) do
			finals[i] = p.CFrame
			p.LocalTransparencyModifier = 1
		end
		local span = (W.Walls[2] - W.Walls[1]) / lifts
		sc.Lifts[lift] = { Parts = list, Finals = finals, Up = W.Walls[1] + (lift - 1) * span - 0.3, Down = W.ScaffoldDown[1] + (lifts - lift) * 0.3 }
	end
	self.Scaffold = sc
	-- grue : celle du chantier, sinon une neuve derrière la maison
	if not self.Crane then
		local x = math.clamp(g.Right - 10, g.Left + 10, g.Right)
		local baseCF = cf * CFrame.new(x, base, -(g.Depth + 10))
		self.Crane = Kit.Crane(fx, baseCF, { Height = math.max(48, g.Height + 22), Jib = 42 })
		self.CraneFresh = true
		for _, d in ipairs(self.Crane.Model:GetDescendants()) do
			if d:IsA("BasePart") then
				d.LocalTransparencyModifier = 1
			end
		end
	else
		self.Crane.Model.Parent = fx
	end
	local crane = self.Crane
	if crane then
		local craneParts, craneFinals = {}, {}
		for _, d in ipairs(crane.Model:GetDescendants()) do
			if d:IsA("BasePart") then
				table.insert(craneParts, d)
			end
		end
		self.CraneParts = craneParts
		self.CraneFinals = craneFinals
		-- cycle : palette au pied du mât -> sommet de la maison
		local craneBase = crane.Top * CFrame.new(0, -crane.Height, 0)
		local function key(p: Vector3, bottomY: number): { number }
			local rel = craneBase:PointToObjectSpace(p)
			local trolleyY = crane.Height + (crane.JibY or 3.2) - 0.45
			return { math.atan2(-rel.X, -rel.Z), math.sqrt(rel.X * rel.X + rel.Z * rel.Z) - 1.2, trolleyY - 0.6 - (bottomY + 4.8) }
		end
		local pick = (craneBase * CFrame.new(-6, 0, 6)).Position
		local drop = (cf * CFrame.new((g.Left + g.Right) / 2, g.Height + 2, -g.Depth / 2)).Position
		self.CraneKeys = {
			A = key(pick, craneBase:PointToObjectSpace(pick).Y + 0.2),
			B = key(drop, craneBase:PointToObjectSpace(drop).Y),
			High = 7,
		}
	end
end

local function setScaffold(self: Anim, now: number)
	local sc = self.Scaffold
	if not sc then
		return
	end
	for _, lift in ipairs(sc.Lifts) do
		local kUp = math.clamp((now - lift.Up) / 0.5, 0, 1)
		local kDown = math.clamp((now - lift.Down) / 0.5, 0, 1)
		local state = if kDown > 0 then "Down" elseif kUp >= 1 then "Up" elseif kUp > 0 then "Rise" else "Hidden"
		if state ~= lift.State or state == "Rise" or state == "Down" then
			lift.State = state
			local alpha, offset
			if state == "Hidden" then
				alpha, offset = 1, -1.5
			elseif state == "Rise" then
				alpha, offset = 1 - kUp, -1.5 * (1 - easeOutCubic(kUp))
			elseif state == "Up" then
				alpha, offset = 0, 0
			else
				alpha, offset = kDown, -3 * kDown * kDown
			end
			local frames = {}
			for i, p in ipairs(lift.Parts) do
				p.LocalTransparencyModifier = alpha
				frames[i] = lift.Finals[i] + Vector3.new(0, offset, 0)
			end
			workspace:BulkMoveTo(lift.Parts, frames, Enum.BulkMoveMode.FireCFrameChanged)
		end
	end
end

local function stepCrane(self: Anim, now: number)
	local crane = self.Crane
	if not crane then
		return
	end
	local keys = self.CraneKeys
	-- apparition (grue neuve) / départ
	local leave = W.ScaffoldDown[1] + 0.2
	if now < leave and keys then
		local angle, radius, drop, loaded = Kit.CraneCycle(now * 3.4 + 4, keys.A, keys.B, keys.High)
		crane:Pose(angle, radius, drop, loaded)
		if self.CraneFresh and not self.CraneShown then
			local k = math.clamp(now / 0.8, 0, 1)
			for _, p in ipairs(self.CraneParts or {}) do
				if p.Name ~= "LoadPallet" and p.Name ~= "LoadBricks" and p.Name ~= "Sling" then
					p.LocalTransparencyModifier = 1 - k
				end
			end
			if k >= 1 then
				self.CraneShown = true
			end
		end
	elseif not self.CraneGone then
		if not self.CraneLeaving then
			self.CraneLeaving = true
			self.CraneFinals = {}
			for i, p in ipairs(self.CraneParts or {}) do
				self.CraneFinals[i] = p.CFrame
			end
		end
		local k = math.clamp((now - leave) / 1.1, 0, 1)
		local frames = {}
		for i, p in ipairs(self.CraneParts or {}) do
			frames[i] = self.CraneFinals[i] - Vector3.new(0, 10 * k * k, 0)
			p.LocalTransparencyModifier = math.max(p.LocalTransparencyModifier, k)
		end
		workspace:BulkMoveTo(self.CraneParts or {}, frames, Enum.BulkMoveMode.FireCFrameChanged)
		if k >= 1 then
			self.CraneGone = true
			crane.Model:Destroy()
		end
	end
end

----------------------------------------------------------------------
-- Frise
----------------------------------------------------------------------

function HouseBuildAnim.Play(self: Anim)
	if self.Playing or self.Done then
		return
	end
	self:Prepare()
	self.Playing = true
	self.Clock = 0
	for _, t in ipairs(self.Tracks) do
		self:Schedule(t, false)
	end
	table.sort(self.Tracks, function(a, b)
		return a.Start < b.Start
	end)
	self.Next = 1
	local ok, err = pcall(self.BuildFx, self)
	if not ok then
		warn("[HouseBuildAnim] effets : " .. tostring(err))
	end
	burst(self.Dust, 36)
end

local PHASE_ORDER = { "Clear", "Foundation", "Walls", "Roof", "Openings", "Garden", "Finale" }

function HouseBuildAnim.PhaseName(self: Anim): string
	local now = self.Clock
	if now >= W.Finale then
		return "Finale"
	elseif now >= W.Garden[1] then
		return "Garden"
	elseif now >= W.Openings[1] then
		return "Openings"
	elseif now >= W.Roof[1] then
		return "Roof"
	elseif now >= W.Walls[1] then
		return "Walls"
	elseif now >= W.Foundation[1] then
		return "Foundation"
	end
	return "Clear"
end
HouseBuildAnim.PhaseOrder = PHASE_ORDER

function HouseBuildAnim.Progress(self: Anim): number
	if self.Done then
		return 1
	end
	return math.clamp(self.Clock / W.Finale, 0, 1)
end

-- Pose d'une pièce en vol (k = 0..1)
local function flyFrame(t: Track, k: number): (CFrame, number)
	local final = t.Final
	local from = t.From
	local alpha = 0
	if t.Motion == "Rise" then
		local e = easeOutBack(k)
		alpha = 1 - math.clamp(k * 3, 0, 1)
		return (from :: CFrame):Lerp(final, e), alpha
	elseif t.Motion == "Slide" then
		local e = easeOutCubic(k)
		alpha = 1 - math.clamp(k * 2.5, 0, 1)
		return (from :: CFrame):Lerp(final, e), alpha
	elseif t.Motion == "Fly" then
		-- arc (parabole) + rotation qui se défait, petit rebond à la pose
		local e = if k < 0.85 then Kit.Smooth(k / 0.85) else 1
		local cf = (from :: CFrame):Lerp(final, e)
		local lift = 4 * e * (1 - e) * t.Arc
		local bounce = if k >= 0.85 then math.sin((k - 0.85) / 0.15 * math.pi) * 0.35 else 0
		local spin = (t.Spin :: CFrame):Lerp(CFrame.identity, e)
		alpha = 1 - math.clamp(k * 4, 0, 1)
		return CFrame.new(cf.Position + Vector3.new(0, lift + bounce, 0)) * final.Rotation * spin, alpha
	elseif t.Motion == "Pop" then
		local e = easeOutBack(k)
		alpha = 1 - math.clamp(k * 3.5, 0, 1)
		return (from :: CFrame):Lerp(final, e), alpha
	elseif t.Motion == "Grow" then
		if from then
			local e = easeOutBack(k)
			alpha = 1 - math.clamp(k * 3, 0, 1)
			return from:Lerp(final, e), alpha
		end
		alpha = 1 - math.clamp(k * 4, 0, 1)
		return final, alpha
	end
	-- Fade
	return final, 1 - k
end

local function landed(self: Anim, t: Track)
	local part = t.Part
	if part.Parent then
		if t.State ~= "Drop" then
			part.CFrame = t.Final
		end
		if t.Grow then
			part.Size = t.Size
			if t.State ~= "Drop" then
				part.CFrame = t.Final
			end
		end
		part.LocalTransparencyModifier = 0
		if part.CanCollide == false then
			part.CanCollide = t.Collide
		end
	end
	restoreEffects(t.Effects)
	t.State = if t.State == "Drop" then "Drop" else "Done"
end

-- Une pièce décolle
function HouseBuildAnim.Activate(self: Anim, t: Track)
	if t.State ~= "Wait" then
		return
	end
	if not t.Part.Parent then
		t.State = "Done"
		restoreEffects(t.Effects)
	elseif (t.Part.CFrame.Position - t.Final.Position).Magnitude > 1e-3 then
		-- déplacée par quelqu'un d'autre (porte…) : simple fondu, sans la bouger
		t.Final = t.Part.CFrame
		t.Motion = "Fade"
		t.Grow = false
		t.State = "Fly"
		table.insert(self.Active, t)
	else
		-- (taille lue au décollage : une pièce arrivée en cours de route a pu
		-- être retaillée après son ajout)
		t.Size = t.Part.Size
		t.State = "Fly"
		table.insert(self.Active, t)
		-- étincelles (une par paquet de fenêtres)
		if t.Phase == "Openings" and self.Spark and self.SparkAnchor then
			local p = t.Final.Position
			local key = math.floor(p.X / 7) .. ":" .. math.floor(p.Y / 7) .. ":" .. math.floor(p.Z / 7)
			if not self.Bursts[key] then
				self.Bursts[key] = true
				self.SparkAnchor.CFrame = t.Final
				burst(self.Spark, 8)
			end
		end
	end
end

function HouseBuildAnim.Step(self: Anim, dt: number)
	if self.Done or not self.Playing then
		return
	end
	local house = self.House
	if house.Alive == false or not house.Model.Parent then
		self:Finish(true)
		return
	end
	self.Clock += math.min(dt, 0.1)
	local now = self.Clock
	self.PhaseKey = self:PhaseName()
	-- nouvelles pièces qui décollent
	local tracks = self.Tracks
	while self.Next <= #tracks and tracks[self.Next].Start <= now do
		local t = tracks[self.Next]
		self.Next += 1
		self:Activate(t)
	end
	if #self.LateQueue > 0 then
		local waiting = {}
		for _, t in ipairs(self.LateQueue) do
			if t.Start <= now then
				self:Activate(t)
			else
				table.insert(waiting, t)
			end
		end
		self.LateQueue = waiting
	end
	-- vols en cours
	local moving, frames = {}, {}
	local keep = {}
	for _, t in ipairs(self.Active) do
		local part = t.Part
		if not part.Parent then
			t.State = "Done"
		elseif t.Last and (part.CFrame.Position - t.Last.Position).Magnitude > 1e-3 then
			-- lâchée (bougée ailleurs) : visible, plus jamais touchée
			t.State = "Drop"
			landed(self, t)
		else
			local k = math.clamp((now - t.Start) / t.Dur, 0, 1)
			if k >= 1 then
				landed(self, t)
			else
				local cf, alpha = flyFrame(t, k)
				part.LocalTransparencyModifier = alpha
				if t.Grow then
					local s = math.max(0.05, easeOutBack(k))
					part.Size = t.Size * s
					local p = t.Final.Position
					cf = CFrame.new(p.X, t.GroundY + (p.Y - t.GroundY) * s, p.Z) * t.Final.Rotation
				end
				if t.Motion ~= "Fade" then
					table.insert(moving, part)
					table.insert(frames, cf)
					t.Last = cf
				end
				table.insert(keep, t)
			end
		end
	end
	self.Active = keep
	if #moving > 0 then
		workspace:BulkMoveTo(moving, frames, Enum.BulkMoveMode.FireCFrameChanged)
	end
	pcall(setScaffold, self, now)
	pcall(stepCrane, self, now)
	if now >= W.Foundation[1] and not self.DustTwo then
		self.DustTwo = true
		burst(self.Dust, 30)
	end
	if now >= W.Finale then
		burst(self.Confetti, 140)
		self:Finish(false)
	end
end

-- État final immédiat (fin normale ou "Passer") : tout est rendu exactement
function HouseBuildAnim.Finish(self: Anim, skipped: boolean?)
	if self.Done then
		return
	end
	self.Done = true
	if self.Conn then
		self.Conn:Disconnect()
		self.Conn = nil
	end
	for _, t in ipairs(self.LateQueue) do
		table.insert(self.Tracks, t)
	end
	self.LateQueue = {}
	for _, t in ipairs(self.Tracks) do
		if t.State ~= "Done" and t.State ~= "Drop" then
			if t.State == "Wait" and t.Part.Parent and (t.Part.CFrame.Position - t.Final.Position).Magnitude > 1e-3 then
				t.State = "Drop" -- (bougée par quelqu'un d'autre : on la laisse où elle est)
			end
			landed(self, t)
		end
	end
	restoreEffects(self.Loose)
	local house = self.House
	pcall(function()
		house.Model:SetAttribute("Constructing", nil)
	end)
	if type(house.HoldFull) == "function" then
		pcall(house.HoldFull, house, false)
	end
	local fx = self.Fx
	if fx then
		if skipped then
			fx:Destroy()
		else
			-- (laisse retomber les confettis puis nettoie)
			if self.Crane and not self.CraneGone and self.Crane.Model then
				self.Crane.Model:Destroy()
			end
			local sc = self.Scaffold
			if sc then
				for _, lift in ipairs(sc.Lifts) do
					for _, p in ipairs(lift.Parts) do
						p:Destroy()
					end
				end
			end
			task.delay(3.5, function()
				fx:Destroy()
			end)
		end
		self.Fx = nil
	elseif self.Crane and self.Crane.Model then
		self.Crane.Model:Destroy()
	end
	self.Playing = false
	local onDone = self.OnDone
	if onDone then
		task.spawn(onDone, skipped == true)
	end
end

return HouseBuildAnim
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="198">
          <Properties>
            <string name="Name">HouseBuilder</string>
            <string name="Source"><![CDATA[--[[
	HouseBuilder (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > HouseBuilder

	🚶 Dopamine Town : construit côté CLIENT la maison 3D d'un joueur sur sa
	parcelle, d'après l'instantané envoyé par WorldService (mêmes données que
	la maison 2D : taille, pièces, façade / toit / motif du toit / jardin).
	  - EXTÉRIEUR (v9.4, HouseFacade) : dessiné COMME la maison 2D
	    (HouseExterior : chaumière, maison de ville, loft, manoir), en vraies
	    matières ; une vraie fenêtre par pièce, porte d'entrée battante
	    (s'ouvre quand on approche, reste fermée et 🔒 si le propriétaire
	    n'accueille pas ce joueur), perron à marches, jardin de devant avec la
	    déco choisie dans la 2D, plaque au nom du propriétaire ;
	  - CAGE D'ESCALIER (v9.4, HouseStairs) : là où la 2D dessine l'entrée ;
	    une volée droite par étage avec une rampe de collision lisse et
	    invisible (on monte / descend sans jamais accrocher) ;
	  - INTÉRIEURS en flux (Stream) : seulement les pièces proches du joueur
	    (House3DScene.BuildRoomShell + House3DScene.PlaceItems : coque avec
	    papier peint, moulures, fenêtre du fond, passages vers les pièces
	    voisines / la cage ; vrais meubles 3D) + mur avant intérieur (papier
	    peint autour de la vraie fenêtre de la façade, rideaux) + plafonnier
	    qui éclaire vraiment ; une pièce à la fois ; détruites de loin ;
	  - emplacements vides de la grille : pièce vide ("à acheter") ;
	  - sièges : les modèles avec une "SeatPart" reçoivent une invite
	    ProximityPrompt "S'asseoir" (voir TownClient : le serveur crée le Seat).
	INVARIANTS (v9.4, anti-"empilement") vérifiés et RÉPARÉS à chaque
	construction : une seule maison par propriétaire dans le dossier, une
	seule coque par emplacement, exactement UN modèle par objet posé
	(EntryIndex) ; compteurs en attributs du modèle (StrayHouses,
	StrayShells, DuplicateItems, Chimneys) ; house:Audit() pour les tests.
	Repère : WorldLayout (maison, pièces, conversions 2D <-> 3D).

	API :
	  HouseBuilder.new(snapshot, plotCF, parent) -> House
	  house:Update(snapshot)            (reconstruit ce qui a changé)
	  house:NextToBuild(focus) -> slot?, distance ; house:BuildRoom(slot) ;
	  house:DestroyRoom(slot)
	  house:StepDoor(near, locked)      (porte d'entrée)
	  house:DoorPosition() -> Vector3 ; house:RoomAt(worldPoint) -> slot?
	  house:SetRoomPlaced(slot, placed) (après un déplacement de meuble)
	  house:Audit() -> Audit ; house:Destroy()
	  HouseBuilder.OnItemAttach / OnItemDetach (facultatifs, v9.5) :
	    function(house, slot, model, entry, itemId) appelées pour CHAQUE
	    modèle d'objet construit / retiré (voir attachItems / detachItems)
	(v9.8 HOUSE98) :
	  - porte d'entrée DOUBLE (6,5 x 9,5) et porte de DERRIÈRE vers le jardin
	    (s'ouvre toute seule quand quelqu'un approche, fermée si 🔒) ;
	  - VRAIES fenêtres des deux côtés (le mur du fond de chaque pièce est
	    percé : on voit le jardin) ;
	  - 🪟 rideaux animés sur chaque fenêtre (devant + fond) et 💡 un
	    interrupteur mural par pièce (près du passage vers la cage) : le
	    propriétaire clique (invites "Fermer les rideaux" / "Éteindre") ->
	    animation tout de suite + sauvegarde (House "setRoomState") ; tout le
	    monde voit l'état (attributs du propriétaire "HouseLightsOff" /
	    "HouseCurtainsClosed", HouseService) ; l'interrupteur commande le
	    plafonnier ET les lampes posées dans la pièce ;
	  house:ToggleRoom(slot, "Lights" | "Curtains") ; house:BackDoorPosition()
	(v9.9 HOUSE99) :
	  - HALL / ESCALIER refaits (HouseStairs) : l'escalier longe le mur de
	    droite, couloir d'entrée libre et meublé ; la COQUE du hall (sols,
	    murs) est construite avec l'extérieur, l'INTÉRIEUR du hall (escalier,
	    meubles, lampes) en flux comme une pièce : NextToBuild renvoie 0 pour
	    le hall, BuildRoom(0) / DestroyRoom(0) (aucun changement pour TownClient) ;
	  - manoir : le passage de la cage vers les pièces de DROITE est au fond
	    (WorldLayout.PassageSpan) : la coque de la pièce est percée là ;
	  - 💡 fenêtres qui BRILLENT la nuit, vues de dehors, quand la lumière de
	    la pièce est allumée (état du propriétaire : pareil pour tout le
	    monde), même si la pièce n'est pas construite ; teinte des rideaux
	    s'ils sont fermés ; les fenêtres du hall brillent toute la nuit ;
	  - rideaux réalistes jusqu'au sol (HouseToggles) ; touches : E pour les
	    rideaux ET pour l'interrupteur (plus de G / Q).
	(v10 HOUSE10) :
	  - 🏡 extérieur PERSONNALISÉ (Shared/HouseOptions) : instantané .Ext ou
	    attribut répliqué "HouseExt" du propriétaire (changé en direct :
	    l'extérieur est reconstruit, les pièces aussi car leurs fenêtres
	    suivent la façade : HouseFacade.WindowRects) ;
	  - NIVEAUX DE DÉTAIL (50 maisons) choisis ici, dans StepDoor (appelé
	    par TownClient pour chaque maison) : "Full" (extérieur complet, à
	    moins de LOD_FULL x GraphicsQuality.DetailScale() de la caméra),
	    "Mid" (HouseLod, jusqu'à LOD_MID x ...), "Far" (imposteur) ; marge
	    anti-battement ; au plus UNE construction complète toutes les
	    FULL_GAP secondes ; pièces / hall seulement en "Full" (BuildRoom
	    repasse en "Full" tout de suite si besoin) ;
	    house:HoldFull(true) (CONSTRUCT10 : animation de construction) force
	    le complet tout de suite et bloque le LOD ; house:SetLod(niveau) ;
	    house.Lod ; attribut "Lod" du modèle.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")

local Config = require(ReplicatedStorage.Shared.Config)
local WorldLayout = require(ReplicatedStorage.Shared.WorldLayout)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Net = require(ReplicatedStorage.Shared.Net)
local HouseKit = require(script.Parent.HouseKit)
local HouseFacade = require(script.Parent.HouseFacade)
local HouseStairs = require(script.Parent.HouseStairs)
local HouseToggles = require(script.Parent.HouseToggles)
local HouseOptions = require(ReplicatedStorage.Shared.HouseOptions) -- (v10 HOUSE10) 🏡 extérieur personnalisé
local GraphicsQuality = require(ReplicatedStorage.Shared.GraphicsQuality)
local HouseLod = require(script.Parent.HouseLod) -- (v10 HOUSE10) maisons lointaines

local HouseFolder = script.Parent.Parent.Components.House

local HouseBuilder = {}
HouseBuilder.__index = HouseBuilder

-- (v9.5) crochets facultatifs : un modèle d'objet vient d'être construit /
-- va disparaître (house, slot, model, entry, itemId)
HouseBuilder.OnItemAttach = nil :: ((house: any, slot: number, model: Model, entry: any, itemId: string) -> ())?
HouseBuilder.OnItemDetach = nil :: ((house: any, slot: number, model: Model, entry: any, itemId: string) -> ())?

-- (v10) Niveaux de détail : distances de base (x GraphicsQuality.DetailScale())
HouseBuilder.LOD_FULL = 250
HouseBuilder.LOD_MID = 600
local LOD_MARGIN = 25 -- (studs) marge anti-battement
local LOD_INTERVAL = 0.3 -- (s) contrôle du LOD d'une maison
local FULL_GAP = 0.2 -- (s) entre deux constructions complètes (toutes maisons)
local lastFullBuild = -math.huge

local NEAR = 62 -- (studs) une pièce plus proche que ça est meublée
local FAR = 90 -- plus loin : on la vide
local BACK_RANGE = 8.5 -- (v9.8, studs) la porte de derrière s'ouvre quand un avatar est plus près
local DOOR_SWING = math.rad(100)
local M = Enum.Material
local WHITE = Color3.new(1, 1, 1)
local CREAM = Color3.fromRGB(255, 247, 236)

-- Modules 3D de la maison (HOUSE3D93) : chargés une fois, jamais bloquants
local Scene: any = nil
local HouseCommon: any = nil
local loadedModules = false
local function modules()
	if loadedModules then
		return
	end
	loadedModules = true
	local okCommon, common = pcall(require, HouseFolder:WaitForChild("HouseCommon", 5) :: ModuleScript)
	if okCommon then
		HouseCommon = common
	end
	local sceneModule = HouseFolder:FindFirstChild("House3DScene")
	if sceneModule and sceneModule:IsA("ModuleScript") then
		local ok, result = pcall(require, sceneModule)
		if ok and type(result) == "table" then
			Scene = result
		else
			warn("[World] House3DScene : " .. tostring(result))
		end
	end
end

export type RoomState = {
	Slot: number,
	Data: any?, -- pièce de l'instantané (nil = emplacement vide)
	Shell: Model?,
	Items: { Model },
	State: string, -- "None" | "Building" | "Built"
	Signature: string,
	Fill: BasePart?, -- lueur de la pièce derrière la fenêtre (quand elle est vide)
	BackFill: BasePart?, -- (v9.8) idem, fenêtre du fond (côté jardin)
	Prompts: { ProximityPrompt },
	Token: number,
	Toggles: RoomToggles?, -- (v9.8) rideaux / interrupteur / lumières de la pièce construite
}

-- (v9.8 HOUSE98) ce qui s'allume / s'ouvre dans une pièce construite
export type RoomToggles = {
	Curtains: { any },
	Switch: any?,
	Lights: any,
	CurtainsOpen: boolean,
	LightsOn: boolean,
	CurtainPrompts: { ProximityPrompt },
	SwitchPrompt: ProximityPrompt?,
}

-- (v9.9 HOUSE99) intérieur du hall (escalier, meubles, lampes), en flux
export type HallState = { State: string, Model: Model?, Ramps: { BasePart }, Parts: number }

export type Audit = {
	OK: boolean,
	Shells: number, -- coques dans Interiors
	ExtraShells: number, -- coques en trop (même emplacement / orphelines)
	Items: number, -- modèles d'objets dans les coques
	Duplicates: number, -- modèles en trop pour un même objet posé
	Missing: number, -- objets posés sans modèle (pièces construites)
	Houses: number, -- maisons de ce propriétaire dans le dossier parent
	Chimneys: number,
	ChimneysExpected: number,
	Parts: number, -- pièces de l'extérieur (budget)
	Lights: number,
}

export type House = typeof(setmetatable({} :: {
	UserId: number,
	Snapshot: any,
	Size: any,
	PlotCF: CFrame,
	HouseCF: CFrame,
	Model: Model,
	Exterior: Folder,
	Interiors: Folder,
	Rooms: { [number]: RoomState },
	ExteriorKey: string,
	Door: BasePart?,
	DoorHinge: CFrame?,
	DoorOpen: boolean,
	DoorLock: TextLabel?,
	Leaves: { any }, -- (v9.8) battants de la porte d'entrée (HouseFacade.Leaf)
	BackLeaves: { any }, -- (v9.8) battants de la porte de derrière
	BackDoorOpen: boolean,
	FlagKey: string, -- (v9.8) attributs 💡 / 🪟 du propriétaire déjà appliqués
	Ramps: { BasePart },
	Hall: HallState, -- (v9.9) intérieur du hall en flux
	Glows: { [number]: { any } }, -- (v9.9) lueurs de nuit des fenêtres (HouseFacade.Glow ; 0 = cage)
	GlowKey: string,
	Style: string,
	Chimneys: number,
	ChimneysExpected: number?, -- (v10) cheminées voulues (option "Chimney")
	Lod: string, -- (v10) "Full" | "Mid" | "Far"
	Hold: boolean, -- (v10) HoldFull : pas de changement de LOD
	LodAt: number,
	ExtText: string, -- (v10) options d'extérieur appliquées (HouseOptions.Encode)
	Spec: any?, -- (v10) look résolu de l'extérieur (HouseFacade.Resolve)
	ExteriorParts: number,
	ExteriorLights: number,
	OnSeat: ((house: any, slot: number, model: Model, seatPart: BasePart) -> ())?,
	OnRoomBuilt: ((house: any, slot: number) -> ())?,
	Night: boolean,
	Alive: boolean,
}, HouseBuilder))

----------------------------------------------------------------------
-- Outils
----------------------------------------------------------------------

local function sizeDefOf(snapshot: any): any
	local id = type(snapshot) == "table" and snapshot.Size or nil
	return Config.HouseSizesById[id] or Config.House.Sizes[1]
end

local function lookEntry(kind: string, id: any): any
	local byId = Config.HouseLooksById and Config.HouseLooksById[kind]
	return byId and type(id) == "string" and byId[id] or nil
end

local function lookColor(kind: string, id: any): Color3?
	local entry = lookEntry(kind, id)
	local color = entry and entry.Color
	return typeof(color) == "Color3" and color or nil
end

local function wallpaperOf(room: any): any
	return room and Config.HouseWallpapersById[room.Wallpaper]
end

local function wallpaperColor(room: any): Color3
	local style = wallpaperOf(room)
	local color = style and style.A
	return typeof(color) == "Color3" and color or Color3.fromRGB(255, 222, 236)
end

-- Signature d'une pièce (reconstruire seulement ce qui a changé)
local function roomSignature(room: any): string
	if type(room) ~= "table" then
		return "empty"
	end
	local parts = { tostring(room.Id), tostring(room.Type), tostring(room.Wallpaper), tostring(room.Floor), tostring(room.Trim), tostring(room.Mood), tostring(room.View) }
	if type(room.Placed) == "table" then
		for _, e in ipairs(room.Placed) do
			if type(e) == "table" then
				table.insert(parts, string.format("%s/%s/%s/%s/%s/%s/%s/%s", tostring(e.I), tostring(e.X), tostring(e.Y), tostring(e.S), tostring(e.Z),
					tostring(e.F), tostring(e.C), tostring(e.R)))
			end
		end
	end
	return table.concat(parts, "|")
end

-- (v10 HOUSE10) Options d'extérieur : instantané (Ext) sinon attribut
-- répliqué du propriétaire "HouseExt" (HouseService) ; (table, texte)
local function extOf(snapshot: any): ({ [string]: any }, string)
	if type(snapshot) == "table" and type(snapshot.Ext) == "table" then
		local text = HouseOptions.Encode(snapshot.Ext)
		return HouseOptions.Decode(text), text
	end
	local owner = type(snapshot) == "table" and Players:GetPlayerByUserId(tonumber(snapshot.UserId) or 0) or nil
	local text = owner and owner:GetAttribute("HouseExt")
	if type(text) ~= "string" then
		text = ""
	end
	return HouseOptions.Decode(text), text :: string
end

local function exteriorKey(snapshot: any): string
	local _, extText = extOf(snapshot)
	local parts = { extText, tostring(snapshot.Size), tostring(snapshot.Facade), tostring(snapshot.Roof), tostring(snapshot.RoofStyle), tostring(snapshot.Plot),
		tostring(snapshot.DisplayName), tostring(snapshot.Garage) }
	if type(snapshot.Garden) == "table" then
		table.insert(parts, table.concat(snapshot.Garden, ","))
	end
	if type(snapshot.Rooms) == "table" then
		for _, room in ipairs(snapshot.Rooms) do
			if type(room) == "table" then
				table.insert(parts, tostring(room.Slot) .. ":" .. tostring(room.Wallpaper))
			end
		end
	end
	return table.concat(parts, "|")
end

local function roomsBySlot(snapshot: any): { [number]: any }
	local bySlot: { [number]: any } = {}
	if type(snapshot.Rooms) == "table" then
		for _, room in ipairs(snapshot.Rooms) do
			if type(room) == "table" and tonumber(room.Slot) then
				bySlot[tonumber(room.Slot) :: number] = room
			end
		end
	end
	return bySlot
end

local function newPart(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, collide: boolean?): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = Vector3.new(math.max(0.05, size.X), math.max(0.05, size.Y), math.max(0.05, size.Z))
	p.CFrame = cf
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = collide == true
	p.CanTouch = false
	p.CanQuery = collide == true
	p.CastShadow = collide == true
	p.Parent = parent
	return p
end

-- (v9.8) Battants d'une porte double (HouseFacade.Leaf) : ouverts / fermés,
-- en tournant autour de leurs gonds (Sign = sens de rotation)
local function swingLeaves(leaves: { any }, open: boolean)
	for _, leaf in ipairs(leaves) do
		local part: BasePart = leaf.Part
		if part.Parent then
			local offset = CFrame.new(leaf.Sign * leaf.Width / 2, leaf.Height / 2, 0)
			local target = if open then leaf.Hinge * CFrame.Angles(0, leaf.Sign * DOOR_SWING, 0) * offset else leaf.Hinge * offset
			part.CanCollide = not open
			local ok = pcall(function()
				TweenService:Create(part, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = target }):Play()
			end)
			if not ok then
				part.CFrame = target
			end
		end
	end
end

----------------------------------------------------------------------
-- Construction de l'extérieur
----------------------------------------------------------------------

function HouseBuilder.new(snapshot: any, plotCF: CFrame, parent: Instance): House
	modules()
	local userId = tonumber(snapshot.UserId) or 0
	-- INVARIANT : une seule maison par propriétaire dans ce dossier (une copie
	-- oubliée par un appelant se superposerait exactement à celle-ci)
	local strays = 0
	for _, child in ipairs(parent:GetChildren()) do
		if child:IsA("Model") and child:GetAttribute("OwnerId") == userId then
			strays += 1
			child:Destroy()
		end
	end
	if strays > 0 then
		warn("[World] Maison " .. tostring(userId) .. " : " .. strays .. " copie(s) en trop retirée(s)")
	end
	local model = Instance.new("Model")
	model.Name = "House_" .. tostring(snapshot.UserId)
	local exterior = Instance.new("Folder")
	exterior.Name = "Exterior"
	exterior.Parent = model
	local interiors = Instance.new("Folder")
	interiors.Name = "Interiors"
	interiors.Parent = model
	local self = setmetatable({
		UserId = userId,
		Snapshot = snapshot,
		Size = sizeDefOf(snapshot),
		PlotCF = plotCF,
		HouseCF = WorldLayout.HouseCFrame(plotCF),
		Model = model,
		Exterior = exterior,
		Interiors = interiors,
		Rooms = {},
		ExteriorKey = "",
		Door = nil,
		DoorHinge = nil,
		DoorOpen = false,
		DoorLock = nil,
		Leaves = {},
		BackLeaves = {},
		BackDoorOpen = false,
		FlagKey = "",
		Ramps = {},
		Hall = { State = "None", Model = nil, Ramps = {}, Parts = 0 },
		Glows = {},
		GlowKey = "",
		Style = "Cottage",
		Chimneys = 0,
		ChimneysExpected = nil,
		Spec = nil,
		Lod = "Full",
		Hold = false,
		LodAt = -math.huge,
		ExtText = "",
		ExteriorParts = 0,
		ExteriorLights = 0,
		OnSeat = nil,
		OnRoomBuilt = nil,
		Night = false,
		Alive = true,
	}, HouseBuilder)
	model:SetAttribute("OwnerId", self.UserId)
	model:SetAttribute("StrayHouses", strays)
	model:SetAttribute("StrayShells", 0)
	model:SetAttribute("DuplicateItems", 0)
	-- (v10) niveau de détail de départ (sa propre maison : toujours complète)
	local level = if userId == (Players.LocalPlayer and Players.LocalPlayer.UserId) then "Full" else self:WantedLod()
	if level == "Full" then
		self:BuildExterior()
	else
		self:BuildLite(level)
	end
	model.Parent = parent
	return self
end

-- Apparence de l'instantané (couleurs 2D, jardin, nom, options d'extérieur)
local function looksOf(snapshot: any): HouseFacade.Looks
	local style = lookEntry("RoofStyle", snapshot.RoofStyle)
	return {
		Wall = lookColor("Facade", snapshot.Facade),
		Roof = lookColor("Roof", snapshot.Roof),
		Pattern = style and tostring(style.Pattern) or "None",
		Garden = type(snapshot.Garden) == "table" and snapshot.Garden or {},
		Rooms = roomsBySlot(snapshot),
		Name = tostring(snapshot.DisplayName or snapshot.Name or ""),
		Garage = if type(snapshot.Garage) == "boolean" then snapshot.Garage else nil, -- v9.6 🏎️ garage du manoir (CarService)
		Ext = (extOf(snapshot)), -- (v10 HOUSE10) 🏡 options d'extérieur
		Plot = tonumber(snapshot.Plot),
	}
end

function HouseBuilder.BuildExterior(self: House)
	local snapshot = self.Snapshot
	local size = self.Size
	local dims = WorldLayout.Dims(size)
	local folder = self.Exterior
	folder:ClearAllChildren()
	self.ExteriorKey = exteriorKey(snapshot)
	self.ExtText = select(2, extOf(snapshot))
	self.Lod = "Full"
	self.Model:SetAttribute("Lod", "Full")
	lastFullBuild = os.clock()
	self.Door = nil
	self.DoorHinge = nil
	self.DoorLock = nil
	self.DoorOpen = false
	local bySlot = roomsBySlot(snapshot)
	local kit = HouseKit.new(self.HouseCF, folder, 6)
	local looks = looksOf(snapshot)
	looks.Rooms = bySlot
	local oldKey = self.Spec and self.Spec.Key
	local okFacade, built = pcall(HouseFacade.Build, kit, size, looks)
	if not okFacade then
		warn("[World] Façade : " .. tostring(built))
		built = { Fills = {}, Chimneys = 0, Style = WorldLayout.StyleOf(size) }
	end
	-- (v10) 📫 boîte aux lettres de SA maison : "Personnaliser" (E) ouvre l'éditeur 3D
	local me = Players.LocalPlayer
	if me and me.UserId == self.UserId then
		local box = folder:FindFirstChild("MailBox", true)
		if box and box:IsA("BasePart") then
			local p = Instance.new("ProximityPrompt")
			p.Name = "CustomisePrompt"
			p.ActionText = Locale.T("Customise")
			p.ObjectText = Locale.T("🏡 My house")
			p.KeyboardKeyCode = Enum.KeyCode.E
			p.MaxActivationDistance = 9
			p.RequiresLineOfSight = false
			p.HoldDuration = 0
			p.Parent = box
			p.Triggered:Connect(function()
				local module = HouseFolder:FindFirstChild("HouseFacadeEditor")
				if module and module:IsA("ModuleScript") then
					local okEditor, editor = pcall(require, module)
					if okEditor and type(editor) == "table" then
						pcall(editor.Open, { Plot = tonumber(self.Snapshot.Plot) })
					end
				end
			end)
		end
	end
	-- (v10) le look a changé (fenêtres de la façade) : les pièces construites sont refaites
	if oldKey and built.Spec and built.Spec.Key ~= oldKey then
		for slot in pairs(self.Rooms) do
			self:DestroyRoom(slot)
		end
	end
	-- (v9.9) coque du hall (sols, trémies, murs) ; son intérieur est en flux
	kit.Stats.Phase = "Walls"
	local okStairs, stairs = pcall(HouseStairs.BuildShell, kit, size)
	kit.Stats.Phase = nil
	if not okStairs then
		warn("[World] Hall : " .. tostring(stairs))
	end
	self:DestroyHall()
	self.Ramps = {}
	self.Glows = built.Glows or {}
	self.GlowKey = ""
	self.Door = built.Door
	self.DoorHinge = built.Hinge
	self.DoorLock = built.Lock
	self.Leaves = built.Leaves or {}
	self.BackLeaves = built.BackLeaves or {}
	self.BackDoorOpen = false
	self.Style = built.Style
	self.Chimneys = built.Chimneys
	self.ChimneysExpected = built.ChimneysExpected or built.Chimneys
	self.Spec = built.Spec
	self.ExteriorParts = kit.Stats.Count
	self.ExteriorLights = kit.Stats.Lights
	self.Model:SetAttribute("Style", built.Style)
	self.Model:SetAttribute("Chimneys", built.Chimneys)
	self.Model:SetAttribute("ExteriorParts", kit.Stats.Count)
	-- états des pièces (tous les emplacements de la grille)
	for slot = 1, dims.Floors * dims.Columns do
		local room = bySlot[slot]
		local state = self.Rooms[slot]
		if not state then
			state = { Slot = slot, Data = room, Shell = nil, Items = {}, State = "None", Signature = roomSignature(room), Fill = nil, BackFill = nil, Prompts = {}, Token = 0,
				Toggles = nil }
			self.Rooms[slot] = state
		end
		state.Data = room
		local fill = built.Fills[slot]
		state.Fill = fill
		if fill and state.State ~= "None" then
			fill.Transparency = 1
		end
		local backFill = built.BackFills and built.BackFills[slot]
		state.BackFill = backFill
		if backFill and state.State ~= "None" then
			backFill.Transparency = 1
		end
	end
end

----------------------------------------------------------------------
-- (v10 HOUSE10) Niveaux de détail
----------------------------------------------------------------------

-- Extérieur SIMPLIFIÉ ("Mid" / "Far") : pas de pièces, pas de hall, pas de porte
function HouseBuilder.BuildLite(self: House, level: string)
	local snapshot = self.Snapshot
	for slot in pairs(self.Rooms) do
		self:DestroyRoom(slot)
	end
	self:DestroyHall()
	local folder = self.Exterior
	folder:ClearAllChildren()
	self.ExteriorKey = exteriorKey(snapshot)
	self.ExtText = select(2, extOf(snapshot))
	self.Lod = level
	self.Model:SetAttribute("Lod", level)
	self.Door = nil
	self.DoorHinge = nil
	self.DoorLock = nil
	self.DoorOpen = false
	self.Leaves = {}
	self.BackLeaves = {}
	self.BackDoorOpen = false
	self.Ramps = {}
	local kit = HouseKit.new(self.HouseCF, folder, 0)
	local looks = looksOf(snapshot)
	looks.Rooms = roomsBySlot(snapshot)
	local okSpec, spec = pcall(HouseFacade.Resolve, self.Size, looks)
	if okSpec then
		self.Spec = spec
	end
	local ok, result = pcall(HouseLod.Build, kit, self.Size, looks, level)
	if not ok then
		warn("[World] LOD : " .. tostring(result))
		result = { Glows = {}, Style = WorldLayout.StyleOf(self.Size), Arch = "Classic" }
	end
	self.Glows = result.Glows
	self.GlowKey = ""
	self.ExteriorParts = kit.Stats.Count
	self.ExteriorLights = 0
	self.Model:SetAttribute("ExteriorParts", kit.Stats.Count)
	local dims = WorldLayout.Dims(self.Size)
	local bySlot = roomsBySlot(snapshot)
	for slot = 1, dims.Floors * dims.Columns do
		local state = self.Rooms[slot]
		if not state then
			state = { Slot = slot, Data = bySlot[slot], Shell = nil, Items = {}, State = "None", Signature = roomSignature(bySlot[slot]), Fill = nil, BackFill = nil, Prompts = {},
				Token = 0, Toggles = nil }
			self.Rooms[slot] = state
		end
		state.Data = bySlot[slot]
		state.Fill = nil
		state.BackFill = nil
	end
end

-- Distance (plan horizontal) du centre de la maison à la caméra OU au
-- personnage local (le plus proche des deux : les pièces suivent le perso)
local function cameraDistance(self: House): number
	local dims = WorldLayout.Dims(self.Size)
	local center = WorldLayout.ToWorld(self.HouseCF, 0, 10, dims.Depth / 2)
	local best = math.huge
	local camera = workspace.CurrentCamera
	if camera then
		local offset = camera.CFrame.Position - center
		best = Vector3.new(offset.X, 0, offset.Z).Magnitude
	end
	local me = Players.LocalPlayer
	local character = me and me.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		local offset = root.Position - center
		best = math.min(best, Vector3.new(offset.X, 0, offset.Z).Magnitude)
	end
	return if best == math.huge then 0 else best
end

-- Niveau voulu (avec la marge anti-battement autour du niveau actuel)
function HouseBuilder.WantedLod(self: House): string
	if self.Hold then
		return "Full"
	end
	local scale = 1
	local okScale, value = pcall(GraphicsQuality.DetailScale)
	if okScale and type(value) == "number" and value > 0 then
		scale = value
	end
	local distance = cameraDistance(self)
	local full, mid = HouseBuilder.LOD_FULL * scale, HouseBuilder.LOD_MID * scale
	local current = self.Lod
	-- (on garde le niveau le plus détaillé tant qu'on n'est pas franchement au-delà)
	if distance < full - (if current == "Full" then -LOD_MARGIN else LOD_MARGIN) then
		return "Full"
	end
	if distance < mid - (if current ~= "Far" then -LOD_MARGIN else LOD_MARGIN) then
		return "Mid"
	end
	return "Far"
end

function HouseBuilder.SetLod(self: House, level: string)
	if not self.Alive or level == self.Lod then
		return
	end
	if level == "Full" then
		self:BuildExterior()
	else
		self:BuildLite(level)
	end
end

-- Contrôle du LOD (StepDoor) ; force = sans attendre ni respecter FULL_GAP
function HouseBuilder.StepLod(self: House, force: boolean?)
	local now = os.clock()
	if not force and now - self.LodAt < LOD_INTERVAL then
		return
	end
	self.LodAt = now
	local wanted = self:WantedLod()
	if wanted == self.Lod then
		return
	end
	if wanted == "Full" and not force and now - lastFullBuild < FULL_GAP then
		return
	end
	self:SetLod(wanted)
end

-- (CONSTRUCT10) extérieur complet tout de suite et LOD bloqué tant que `on`
function HouseBuilder.HoldFull(self: House, on: boolean)
	self.Hold = on == true
	if self.Hold and self.Lod ~= "Full" then
		self:SetLod("Full")
	end
end

----------------------------------------------------------------------
-- Intérieurs (en flux)
----------------------------------------------------------------------

-- Coque de secours (si House3DScene n'est pas disponible) : sol, murs, plafond
local function fallbackShell(room: any, size: any, column: number): Model
	local model = Instance.new("Model")
	model.Name = "RoomShell"
	local W, D, WH, T = WorldLayout.RoomWidth(size), WorldLayout.DEPTH, WorldLayout.WALL_H, WorldLayout.WALL_T
	local wall = wallpaperColor(room)
	local floorStyle = room and Config.HouseFloorsById[room.Floor]
	local floorColor = floorStyle and typeof(floorStyle.A) == "Color3" and floorStyle.A or Color3.fromRGB(220, 200, 240)
	local floorPart = newPart(model, "Floor", Vector3.new(W + 2 * T, 1, D + 2 * T), CFrame.new(0, -0.5, 0), floorColor, nil, true)
	model.PrimaryPart = floorPart
	newPart(model, "WallBack", Vector3.new(W + 2 * T, WH, T), CFrame.new(0, WH / 2, -D / 2 - T / 2), wall, nil, true)
	local passH = WorldLayout.PASS_H
	local doors = WorldLayout.RoomDoors(size, column)
	local mid = WorldLayout.WALL_T + D / 2
	for _, side in ipairs({ "Left", "Right" }) do
		local x = (if side == "Left" then -1 else 1) * (W / 2 + T / 2)
		if table.find(doors, side) then
			-- (v9.9) passage placé comme la cage l'attend (WorldLayout.PassageSpan) ; z = mid - d
			local d0, d1 = WorldLayout.PassageSpan(size, column, side)
			local z0, z1 = mid - d1, mid - d0
			newPart(model, "WallSide", Vector3.new(T, WH, z0 + D / 2), CFrame.new(x, WH / 2, (-D / 2 + z0) / 2), wall, nil, true)
			newPart(model, "WallSide", Vector3.new(T, WH, D / 2 - z1), CFrame.new(x, WH / 2, (z1 + D / 2) / 2), wall, nil, true)
			newPart(model, "WallSide", Vector3.new(T, WH - passH, z1 - z0), CFrame.new(x, passH + (WH - passH) / 2, (z0 + z1) / 2), wall, nil, true)
		else
			newPart(model, "WallSide", Vector3.new(T, WH, D), CFrame.new(x, WH / 2, 0), wall, nil, true)
		end
	end
	newPart(model, "Ceiling", Vector3.new(W + 2 * T, 0.6, D + 2 * T), CFrame.new(0, WH + 0.3, 0), CREAM, nil, true)
	model.WorldPivot = CFrame.new()
	return model
end

-- (v9.9 HOUSE99) Perce un passage dans le mur de côté PLEIN d'une coque
-- House3DScene (repère de la coque : pivot au centre du dessus du sol, +Z
-- vers l'avant) entre z0 et z1 : le mur, la plinthe et la corniche sont
-- recoupés (copies : mêmes matières / couleurs), chambranle ajouté
local function cutPassage(shell: Model, size: any, side: string, z0: number, z1: number)
	local W, D = WorldLayout.RoomWidth(size), WorldLayout.DEPTH
	local T = WorldLayout.WALL_T
	local sx = if side == "Left" then -1 else 1
	local pivot = shell:GetPivot()
	local passH = WorldLayout.PASS_H
	local trimColor = CREAM
	local function relative(part: BasePart): CFrame
		return pivot:ToObjectSpace(part.CFrame)
	end
	local function clonePiece(part: BasePart, zA: number, zB: number, yA: number?, yB: number?)
		if zB - zA < 0.05 then
			return
		end
		local rel = relative(part)
		local y0 = yA or (rel.Y - part.Size.Y / 2)
		local y1 = yB or (rel.Y + part.Size.Y / 2)
		local copy = part:Clone()
		copy.Size = Vector3.new(part.Size.X, y1 - y0, zB - zA)
		copy.CFrame = pivot * CFrame.new(rel.X, (y0 + y1) / 2, (zA + zB) / 2)
		copy.Parent = part.Parent
	end
	for _, child in ipairs(shell:GetChildren()) do
		if child:IsA("BasePart") then
			local rel = relative(child)
			local alongZ = child.Size.Z > D * 0.9
			if alongZ and child.Name == ("Wall" .. side) and math.abs(rel.X - sx * (W / 2 + T / 2)) < 0.1 then
				clonePiece(child, -D / 2, z0)
				clonePiece(child, z1, D / 2)
				clonePiece(child, z0, z1, passH, rel.Y + child.Size.Y / 2)
				child:Destroy()
			elseif alongZ and (child.Name == "Skirting" or child.Name == "Crown") and math.abs(rel.X - sx * (W / 2 - 0.1)) < 0.12 then
				trimColor = child.Color
				if child.Name == "Skirting" then
					clonePiece(child, -D / 2, z0)
					clonePiece(child, z1, D / 2)
					child:Destroy()
				end
			end
		end
	end
	-- chambranle (comme House3DScene : 0,5 de large, 0,3 d'épaisseur, côté pièce)
	local fx = sx * (W / 2 - 0.1)
	for _, z in ipairs({ z0 - 0.25, z1 + 0.25 }) do
		newPart(shell, "DoorFrame", Vector3.new(0.3, passH + 0.5, 0.5), pivot * CFrame.new(fx, (passH + 0.5) / 2, z), trimColor, M.Wood, false)
	end
	newPart(shell, "DoorFrame", Vector3.new(0.3, 0.5, z1 - z0 + 1), pivot * CFrame.new(fx, passH + 0.25, (z0 + z1) / 2), trimColor, M.Wood, false)
end

-- Mur avant INTÉRIEUR d'une pièce (la façade vue de dedans) : papier peint
-- autour de la vraie fenêtre, plinthe, corniche, appui, rideaux ; plafonnier
local function roomFront(self: House, shell: Model, room: any, slot: number)
	local size = self.Size
	local floor, column = WorldLayout.SlotCell(size, slot)
	local xMin, xMax, yFloor = WorldLayout.RoomInterior(size, slot)
	local T = WorldLayout.WALL_T
	local kit = HouseKit.new(self.HouseCF, shell, 1)
	-- (v10) 2 fenêtres par pièce (ou une baie) : mêmes trous que la façade
	local rects = HouseFacade.WindowRects(size, column, floor, self.Spec)
	local paper = wallpaperColor(room)
	local trimEntry = Config.HouseTrimsById and Config.HouseTrimsById[tostring(room and room.Trim or "Cream")]
	local trim = trimEntry and typeof(trimEntry.Color) == "Color3" and trimEntry.Color or CREAM
	local top = yFloor + WorldLayout.WALL_H
	kit:WallX("FrontWall", xMin, xMax, yFloor, top, T, T + 0.12, rects, paper, M.SmoothPlastic, { Solid = false, Shadow = false })
	kit:Box("FrontSkirting", xMin, xMax, yFloor, yFloor + 0.7, T + 0.12, T + 0.32, trim, M.SmoothPlastic, { Shadow = false })
	kit:Box("FrontCrown", xMin, xMax, top - 0.5, top, T + 0.12, T + 0.32, trim, M.SmoothPlastic, { Shadow = false })
	-- (v9.6 anti-scintillement : dessus 0,04 au-dessus du bas de la fenêtre du mur)
	for _, rect in ipairs(rects) do
		kit:Box("InnerSill", rect[1] - 0.5, rect[2] + 0.5, rect[3] - 0.3, rect[3] + 0.04, T, T + 0.7, trim, M.Wood, { Shadow = false })
	end
	-- (v9.8) les rideaux (animés) sont posés par roomToggles
	-- plafonnier : vraie lumière chaude
	local cx = (xMin + xMax) / 2
	local cd = T + WorldLayout.DEPTH * 0.5
	kit:Box("LampCord", cx - 0.06, cx + 0.06, top - 2, top, cd - 0.06, cd + 0.06, Color3.fromRGB(92, 58, 96), M.SmoothPlastic, { Shadow = false })
	kit:CylY("LampShade", cx, top - 2.8, cd, 2.2, 1, trim:Lerp(WHITE, 0.4), M.Fabric, { Shadow = false })
	local bulb = kit:Ball("LampBulb", cx, top - 2.9, cd, 0.8, Color3.fromRGB(255, 236, 190), M.Neon, { Shadow = false })
	-- (v9.6 "flash bang" : portée 30 -> 16, la lumière ne traverse plus 3 pièces ; 0.9 -> 0.75)
	local light = kit:Light(bulb, Color3.fromRGB(255, 226, 184), 16, 0.75)
	return bulb, light
end

----------------------------------------------------------------------
-- (v9.8 HOUSE98) 🪟 rideaux + 💡 interrupteur + lumières d'une pièce
----------------------------------------------------------------------

local function localIsOwner(self: House): boolean
	local me = Players.LocalPlayer
	return me ~= nil and me.UserId == self.UserId
end

-- Id des pièces listés dans un attribut du propriétaire ("R1,R4")
local function flagSet(text: any): { [string]: boolean }
	local set: { [string]: boolean } = {}
	if type(text) == "string" then
		for id in string.gmatch(text, "[^,]+") do
			set[id] = true
		end
	end
	return set
end

-- Attributs 💡 / 🪟 du propriétaire (HouseService) : (lumières éteintes, rideaux fermés, clé)
local function ownerFlags(self: House): ({ [string]: boolean }, { [string]: boolean }, string)
	local owner = Players:GetPlayerByUserId(self.UserId)
	local off = owner and owner:GetAttribute("HouseLightsOff")
	local closed = owner and owner:GetAttribute("HouseCurtainsClosed")
	return flagSet(off), flagSet(closed), tostring(off) .. "|" .. tostring(closed)
end

local function roomWanted(self: House, room: any): (boolean, boolean)
	local off, closed = ownerFlags(self)
	local id = room and tostring(room.Id) or ""
	return not off[id], not closed[id]
end

local function prompt(parent: Instance, action: string, object: string, key: Enum.KeyCode, enabled: boolean): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.Name = "TogglePrompt"
	p.ActionText = action
	p.ObjectText = object
	p.MaxActivationDistance = 9
	p.RequiresLineOfSight = false
	p.HoldDuration = 0
	p.KeyboardKeyCode = key
	p.Enabled = enabled
	p.Parent = parent
	return p
end

local function curtainTexts(open: boolean): string
	return if open then Locale.T("Close the curtains") else Locale.T("Open the curtains")
end

local function switchTexts(on: boolean): string
	return if on then Locale.T("Turn off") else Locale.T("Turn on")
end

-- Côté (Left / Right) du passage vers la cage d'escalier : l'interrupteur y va
local function switchSide(size: any, column: number): string
	local doors = WorldLayout.RoomDoors(size, column)
	local towardHall = if column <= WorldLayout.HallAfter(size) then "Right" else "Left"
	if table.find(doors, towardHall) then
		return towardHall
	end
	return doors[1] or "Right"
end

-- Est-ce une lampe (commandée par l'interrupteur) ?
local function isLamp(itemId: string): boolean
	local item = Config.HouseItemsById and Config.HouseItemsById[itemId]
	if type(item) == "table" and item.Category == "Lights" then
		return true
	end
	return string.find(itemId, "Lamp", 1, true) ~= nil or string.find(itemId, "Chandelier", 1, true) ~= nil or string.find(itemId, "Candle", 1, true) ~= nil
end

local function roomToggles(self: House, shell: Model, room: any, slot: number, bulb: BasePart?, lamp: Light?): RoomToggles
	local size = self.Size
	local floor, column = WorldLayout.SlotCell(size, slot)
	local owner = localIsOwner(self)
	local lightsOn, curtainsOpen = roomWanted(self, room)
	local style = wallpaperOf(room)
	local fabric = style and typeof(style.B) == "Color3" and style.B or Color3.fromRGB(255, 190, 214)
	local brass = Color3.fromRGB(214, 170, 96)
	local toggles: RoomToggles = {
		Curtains = {},
		Switch = nil,
		Lights = HouseToggles.Lights(),
		CurtainsOpen = curtainsOpen,
		LightsOn = lightsOn,
		CurtainPrompts = {},
		SwitchPrompt = nil,
	}
	-- 🪟 fenêtres de devant (sur la façade vue de dedans) ; (v10) une paire
	-- de rideaux par fenêtre
	local T = WorldLayout.WALL_T
	-- (v9.9 : rideaux jusqu'au sol : ourlet 0,15 au-dessus du plancher)
	local yFloor = WorldLayout.FloorY(floor)
	for _, rect in ipairs(HouseFacade.WindowRects(size, column, floor, self.Spec)) do
		local front = self.HouseCF * CFrame.new((rect[1] + rect[2]) / 2, (rect[3] + rect[4]) / 2, -(T + 0.12)) * CFrame.Angles(0, math.pi, 0)
		table.insert(toggles.Curtains, HouseToggles.Curtains(shell, front, rect[2] - rect[1], rect[4] - rect[3], fabric, brass, curtainsOpen,
			{ Drop = (rect[3] + rect[4]) / 2 - yFloor - 0.15 }))
	end
	-- 🪟 fenêtre du fond (côté jardin)
	local b0, b1, b2, b3 = WorldLayout.BackWindowRect(size, Config.House.WallRatio)
	local back = shell:GetPivot() * CFrame.new((b0 + b1) / 2, (b2 + b3) / 2, -WorldLayout.DEPTH / 2 + 0.06)
	-- (fenêtre du fond : rideaux jusque sous l'appui, pas au sol : les meubles de la 2D sont contre ce mur)
	table.insert(toggles.Curtains, HouseToggles.Curtains(shell, back, b1 - b0, b3 - b2, fabric, brass, curtainsOpen))
	for _, curtain in ipairs(toggles.Curtains) do
		local p = prompt(curtain.Anchor, curtainTexts(curtainsOpen), Locale.T("🪟 Curtains"), Enum.KeyCode.E, owner)
		p.Triggered:Connect(function()
			self:ToggleRoom(slot, "Curtains")
		end)
		table.insert(toggles.CurtainPrompts, p)
	end
	-- 💡 interrupteur, à côté du passage vers la cage (face intérieure du mur de côté)
	local W = WorldLayout.RoomWidth(size)
	local side = switchSide(size, column)
	local sx = if side == "Right" then 1 else -1
	-- (v9.9 : à côté du passage, du côté de la façade, où qu'il soit : PassageSpan ; z = milieu - d)
	local pd0 = WorldLayout.PassageSpan(size, column, side)
	local z = WorldLayout.WALL_T + WorldLayout.DEPTH / 2 - pd0 + 1.05
	local switchCF = shell:GetPivot() * CFrame.new(sx * W / 2, 4.3, z) * CFrame.Angles(0, -sx * math.pi / 2, 0)
	local switch = HouseToggles.Switch(shell, switchCF, lightsOn)
	toggles.Switch = switch
	local sp = prompt(switch.Plate, switchTexts(lightsOn), Locale.T("💡 Lights"), Enum.KeyCode.E, owner)
	sp.MaxActivationDistance = 8
	sp.Triggered:Connect(function()
		self:ToggleRoom(slot, "Lights")
	end)
	toggles.SwitchPrompt = sp
	-- 💡 lumières commandées : plafonnier + lampes posées
	local lights = toggles.Lights
	if lamp then
		lights:Add(lamp)
	end
	if bulb then
		lights:AddGlow(bulb)
	end
	local items = shell:FindFirstChild("Items")
	for _, model in ipairs(items and items:GetChildren() or {}) do
		if isLamp(tostring(model:GetAttribute("ItemId"))) then
			lights:Collect(model, true)
		end
	end
	lights:Set(lightsOn, false)
	shell:SetAttribute("LightsOn", lightsOn)
	shell:SetAttribute("CurtainsOpen", curtainsOpen)
	return toggles
end

-- Applique un état (animé) à une pièce construite
local function applyToggles(state: RoomState, lightsOn: boolean, curtainsOpen: boolean, animate: boolean)
	local t = state.Toggles
	if not t then
		return
	end
	if t.CurtainsOpen ~= curtainsOpen then
		t.CurtainsOpen = curtainsOpen
		for _, curtain in ipairs(t.Curtains) do
			curtain:Set(curtainsOpen, animate)
		end
		for _, p in ipairs(t.CurtainPrompts) do
			p.ActionText = curtainTexts(curtainsOpen)
		end
	end
	if t.LightsOn ~= lightsOn then
		t.LightsOn = lightsOn
		if t.Switch then
			t.Switch:Set(lightsOn, animate)
		end
		t.Lights:Set(lightsOn, animate)
		if t.SwitchPrompt then
			t.SwitchPrompt.ActionText = switchTexts(lightsOn)
		end
	end
	local shell = state.Shell
	if shell then
		shell:SetAttribute("LightsOn", lightsOn)
		shell:SetAttribute("CurtainsOpen", curtainsOpen)
	end
end

-- (v9.5) crochets : chaque modèle d'objet construit / retiré
local function attachItems(self: House, slot: number, state: RoomState)
	local hook = HouseBuilder.OnItemAttach
	if not hook or not state.Data then
		return
	end
	for _, model in ipairs(state.Items) do
		local index = tonumber(model:GetAttribute("EntryIndex"))
		local entry = index and state.Data.Placed and state.Data.Placed[index]
		if entry then
			local ok, err = pcall(hook, self, slot, model, entry, tostring(model:GetAttribute("ItemId")))
			if not ok then
				warn("[World] OnItemAttach : " .. tostring(err))
			end
		end
	end
end

local function detachItems(self: House, slot: number, state: RoomState)
	local hook = HouseBuilder.OnItemDetach
	if not hook then
		return
	end
	for _, model in ipairs(state.Items) do
		local index = tonumber(model:GetAttribute("EntryIndex"))
		local entry = index and state.Data and state.Data.Placed and state.Data.Placed[index]
		pcall(hook, self, slot, model, entry, tostring(model:GetAttribute("ItemId")))
	end
end

----------------------------------------------------------------------
-- (v9.9 HOUSE99) Intérieur du hall en flux (escalier, meubles, lampes)
----------------------------------------------------------------------

function HouseBuilder.DestroyHall(self: House)
	local hall = self.Hall
	if hall.Model then
		hall.Model:Destroy()
	end
	hall.Model = nil
	hall.State = "None"
	hall.Ramps = {}
	self.Ramps = {}
end

function HouseBuilder.BuildHall(self: House)
	if not self.Alive then
		return
	end
	self:DestroyHall()
	local model = Instance.new("Model")
	model.Name = "Hall"
	local kit = HouseKit.new(self.HouseCF, model, 2)
	local ok, result = pcall(HouseStairs.BuildInterior, kit, self.Size)
	local hall = self.Hall
	if ok then
		hall.Ramps = result.Ramps
		self.Ramps = result.Ramps
	else
		warn("[World] Escalier : " .. tostring(result))
	end
	hall.Parts = kit.Stats.Count
	model:SetAttribute("Parts", kit.Stats.Count)
	model.Parent = self.Model
	hall.Model = model
	hall.State = "Built"
end

-- Distance de `focus` au hall (boîte de la cage, tous les étages)
local function hallDistance(self: House, focus: Vector3): number
	local x, y, d = WorldLayout.ToLocal(self.HouseCF, focus)
	local h0, h1 = WorldLayout.HallSpan(self.Size)
	local dims = WorldLayout.Dims(self.Size)
	local cx = math.clamp(x, h0, h1)
	local cy = math.clamp(y, 0, dims.Height)
	local cd = math.clamp(d, 0, dims.Depth)
	return Vector3.new(x - cx, y - cy, d - cd).Magnitude
end

function HouseBuilder.DestroyRoom(self: House, slot: number)
	if slot == 0 then
		self:DestroyHall()
		return
	end
	local state = self.Rooms[slot]
	if not state then
		return
	end
	state.Token += 1
	detachItems(self, slot, state)
	if state.Shell then
		state.Shell:Destroy()
		state.Shell = nil
	end
	for _, prompt in ipairs(state.Prompts) do
		prompt:Destroy()
	end
	table.clear(state.Prompts)
	state.Items = {}
	state.State = "None"
	state.Toggles = nil
	if state.Fill then
		state.Fill.Transparency = 0
	end
	if state.BackFill then
		state.BackFill.Transparency = 0
	end
end

-- INVARIANT (après chaque construction) : une seule coque pour cet
-- emplacement dans Interiors, et UN modèle par objet posé ; tout le reste
-- est détruit et compté (attributs StrayShells / DuplicateItems)
function HouseBuilder.EnforceRoom(self: House, slot: number)
	local state = self.Rooms[slot]
	if not state then
		return
	end
	local strays = 0
	for _, child in ipairs(self.Interiors:GetChildren()) do
		if child:GetAttribute("Slot") == slot and child ~= state.Shell then
			strays += 1
			child:Destroy()
		end
	end
	local duplicates = 0
	local shell = state.Shell
	local items = shell and shell:FindFirstChild("Items")
	if items then
		local seen: { [number]: Model } = {}
		local kept: { Model } = {}
		for _, model in ipairs(items:GetChildren()) do
			local index = tonumber(model:GetAttribute("EntryIndex"))
			if model:IsA("Model") and index then
				if seen[index] then
					duplicates += 1
					model:Destroy()
				else
					seen[index] = model :: Model
					table.insert(kept, model :: Model)
				end
			end
		end
		state.Items = kept
	end
	if strays > 0 or duplicates > 0 then
		warn(string.format("[World] Pièce %s : %s coque(s) et %s objet(s) en double retirés", tostring(slot), tostring(strays), tostring(duplicates)))
		self.Model:SetAttribute("StrayShells", (tonumber(self.Model:GetAttribute("StrayShells")) or 0) + strays)
		self.Model:SetAttribute("DuplicateItems", (tonumber(self.Model:GetAttribute("DuplicateItems")) or 0) + duplicates)
	end
end

-- Construit la pièce (coque + objets) ; peut céder la main (appel dans une tâche)
function HouseBuilder.BuildRoom(self: House, slot: number)
	-- (v10) les pièces n'existent qu'avec l'extérieur complet
	if self.Lod ~= "Full" and self.Alive then
		self:SetLod("Full")
	end
	if slot == 0 then
		self:BuildHall()
		return
	end
	local state = self.Rooms[slot]
	if not state or not self.Alive then
		return
	end
	self:DestroyRoom(slot)
	state.State = "Building"
	state.Token += 1
	local token = state.Token
	local room = state.Data
	local size = self.Size
	local _, column = WorldLayout.SlotCell(size, slot)
	local roomData = room or { Id = "", Slot = slot, Placed = {} }
	local shell: Model? = nil
	-- (v9.9) passages hors du milieu (manoir : cage -> pièces de droite, au
	-- fond) : la coque les construit pleins, on les perce ensuite
	local shellDoors, moved = {}, {}
	local mid = WorldLayout.WALL_T + WorldLayout.DEPTH / 2
	for _, side in ipairs(WorldLayout.RoomDoors(size, column)) do
		local d0, d1 = WorldLayout.PassageSpan(size, column, side)
		if math.abs((d0 + d1) / 2 - mid) > 0.05 or math.abs((d1 - d0) - WorldLayout.PASS_W) > 0.05 then
			table.insert(moved, { side, mid - d1, mid - d0 })
		else
			table.insert(shellDoors, side)
		end
	end
	if Scene and type(Scene.BuildRoomShell) == "function" then
		local ok, result = pcall(Scene.BuildRoomShell, roomData, size, {
			Scale = WorldLayout.PX,
			Depth = WorldLayout.DEPTH,
			WallHeight = WorldLayout.WALL_H,
			Doors = shellDoors,
			DoorWidth = WorldLayout.PASS_W,
			DoorHeight = WorldLayout.PASS_H,
			Front = false,
			Ceiling = true,
			Patterns = true,
			-- (v9.8) vraie fenêtre côté jardin (même trou que la façade : HouseFacade.BackWindowRect)
			BackWindow = { WorldLayout.BackWindowRect(size, Config.House.WallRatio) },
		})
		if ok and typeof(result) == "Instance" and result:IsA("Model") then
			shell = result
			for _, m in ipairs(moved) do
				local okCut, err = pcall(cutPassage, result, size, m[1], m[2], m[3])
				if not okCut then
					warn("[World] Passage : " .. tostring(err))
				end
			end
		elseif not ok then
			warn("[World] BuildRoomShell : " .. tostring(result))
		end
	end
	if not shell then
		shell = fallbackShell(room, size, column)
	end
	local s = shell :: Model
	s.Name = "Room_" .. slot
	s:SetAttribute("Slot", slot)
	s:PivotTo(WorldLayout.ShellPivot(self.HouseCF, size, slot))
	local okFront, bulbOrErr, lamp = pcall(roomFront, self, s, room, slot)
	if not okFront then
		warn("[World] Mur avant : " .. tostring(bulbOrErr))
	end
	s.Parent = self.Interiors
	state.Shell = s
	if state.Fill then
		state.Fill.Transparency = 1
	end
	if state.BackFill then
		state.BackFill.Transparency = 1
	end
	-- pièce vide : panneau "à acheter"
	if not room then
		local sign = newPart(s, "EmptySign", Vector3.new(8, 3, 0.3), WorldLayout.ShellPivot(self.HouseCF, size, slot) * CFrame.new(0, 5, -WorldLayout.DEPTH / 2 + 0.4), WHITE,
			M.SmoothPlastic, false)
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Back
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 40
		gui.LightInfluence = 0.2
		gui.Parent = sign
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(0.92, 0.8)
		label.Position = UDim2.fromScale(0.04, 0.1)
		label.Font = Enum.Font.GothamBold
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(160, 110, 180)
		label.Text = Locale.T("🚪 Empty room · buy it in 🏠 My house")
		label.Parent = gui
		state.State = "Built"
		self:EnforceRoom(slot)
		return
	end
	-- objets (vrais modèles 3D, placés comme la vue 3D)
	if Scene and type(Scene.PlaceItems) == "function" then
		local ok, models = pcall(Scene.PlaceItems, s, room, { Collide = true, Query = true, Yield = true, Night = self.Night })
		-- (construction dépassée pendant la pause : la coque a déjà été détruite
		-- par DestroyRoom ; on s'assure qu'elle n'est plus nulle part)
		if state.Token ~= token or not self.Alive then
			if state.Shell ~= s then
				s:Destroy()
			end
			return
		end
		if ok and type(models) == "table" then
			state.Items = models
		elseif not ok then
			warn("[World] PlaceItems : " .. tostring(models))
		end
	end
	self:EnforceRoom(slot)
	-- sièges : une invite "S'asseoir" par place assise
	for _, itemModel in ipairs(state.Items) do
		local seatPart = itemModel:FindFirstChild("SeatPart")
		if seatPart and seatPart:IsA("BasePart") then
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "SitPrompt"
			-- (v9.8 : sur un lit / un hamac -> "S'allonger" ; SEAT98 y joue la sieste)
			local sitId = tostring(itemModel:GetAttribute("ItemId"))
			local lying = false
			if sitId == "Hammock" then
				lying = true
			elseif sitId ~= "PetBed" then
				lying = string.find(sitId, "Bed", 1, true) ~= nil
			end
			prompt.ActionText = if lying then Locale.T("Lie down") else Locale.T("Sit")
			local item = HouseCommon and HouseCommon.ItemsById[tostring(itemModel:GetAttribute("ItemId"))]
			prompt.ObjectText = item and Locale.T(item.Name) or ""
			prompt.MaxActivationDistance = 8
			prompt.RequiresLineOfSight = false
			prompt.HoldDuration = 0
			prompt.KeyboardKeyCode = Enum.KeyCode.E
			prompt.Parent = seatPart
			prompt.Triggered:Connect(function()
				local callback = self.OnSeat
				if callback then
					callback(self, slot, itemModel, seatPart :: BasePart)
				end
			end)
			table.insert(state.Prompts, prompt)
		end
	end
	-- (v9.8) 🪟 rideaux + 💡 interrupteur + lumières (après les objets : les lampes posées suivent l'interrupteur)
	local okToggles, toggles = pcall(roomToggles, self, s, room, slot, if okFront and typeof(bulbOrErr) == "Instance" then bulbOrErr :: BasePart else nil,
		if okFront and typeof(lamp) == "Instance" then lamp :: Light else nil)
	if okToggles then
		state.Toggles = toggles
	else
		warn("[World] Rideaux / interrupteur : " .. tostring(toggles))
	end
	state.State = "Built"
	attachItems(self, slot, state)
	local built = self.OnRoomBuilt
	if built then
		task.spawn(built, self, slot)
	end
end

-- Pièces à meubler / vider selon la distance à `focus` ; renvoie l'emplacement
-- à construire en priorité (ou nil)
function HouseBuilder.NextToBuild(self: House, focus: Vector3): (number?, number)
	if self.Lod ~= "Full" then
		-- (v10) on s'approche assez pour meubler : extérieur complet tout de suite
		if self.Alive and hallDistance(self, focus) < NEAR then
			self:SetLod("Full")
		else
			return nil, math.huge
		end
	end
	local best: number? = nil
	local bestDistance = math.huge
	-- (v9.9) le hall d'abord (on y entre par la porte) : "emplacement" 0
	local hallD = hallDistance(self, focus)
	if self.Hall.State == "None" and hallD < NEAR - 20 then
		best = 0
		bestDistance = hallD
	elseif self.Hall.State ~= "None" and hallD > FAR - 20 then
		self:DestroyHall()
	end
	for slot, state in pairs(self.Rooms) do
		local x, y, d = WorldLayout.RoomCenter(self.Size, slot)
		local distance = (WorldLayout.ToWorld(self.HouseCF, x, y + 4, d) - focus).Magnitude
		if state.State == "None" and distance < NEAR and distance < bestDistance then
			best = slot
			bestDistance = distance
		elseif state.State ~= "None" and distance > FAR then
			self:DestroyRoom(slot)
		end
	end
	return best, bestDistance
end

-- Pièce (emplacement) qui contient un point du monde
function HouseBuilder.RoomAt(self: House, point: Vector3): number?
	local x, y, d = WorldLayout.ToLocal(self.HouseCF, point)
	return WorldLayout.SlotAt(self.Size, x, y, d)
end

-- Porte d'entrée : ouverte si quelqu'un d'autorisé est proche
function HouseBuilder.StepDoor(self: House, open: boolean, locked: boolean)
	-- (v10) niveau de détail + options d'extérieur changées par le propriétaire
	self:StepLod()
	local _, extText = extOf(self.Snapshot)
	if extText ~= self.ExtText and self.Alive then
		if self.Lod == "Full" then
			self:BuildExterior()
		else
			self:BuildLite(self.Lod)
		end
	end
	if self.Lod ~= "Full" then
		local night = HouseBuilder.IsNight()
		local _, _, key = ownerFlags(self)
		local glowKey = tostring(night) .. "|" .. key
		if glowKey ~= self.GlowKey then
			self.GlowKey = glowKey
			self:ApplyGlows(night)
		end
		return
	end
	local leaf = self.Door
	local hinge = self.DoorHinge
	if not leaf or not hinge then
		return
	end
	local lock = self.DoorLock
	if lock then
		lock.Text = locked and "🔒" or ""
	end
	-- (v9.8) porte de derrière : ouverte si quelqu'un (n'importe quel avatar) en est proche
	if #self.BackLeaves > 0 then
		local backDoor = self:BackDoorPosition()
		local near = false
		for _, player in ipairs(Players:GetPlayers()) do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") and (root.Position - backDoor).Magnitude < BACK_RANGE then
				near = true
				break
			end
		end
		local wantBack = near and not locked
		if wantBack ~= self.BackDoorOpen then
			self.BackDoorOpen = wantBack
			swingLeaves(self.BackLeaves, wantBack)
		end
	end
	-- (v9.8) 💡 / 🪟 changés par le propriétaire (ou refus du serveur) : appliqués ici (5 fois / s)
	local _, _, key = ownerFlags(self)
	if key ~= self.FlagKey then
		self.FlagKey = key
		self:ApplyRoomFlags(true)
	end
	-- (v9.9) fenêtres qui brillent la nuit (vues de dehors)
	local night = HouseBuilder.IsNight()
	local glowKey = tostring(night) .. "|" .. key
	if glowKey ~= self.GlowKey then
		self.GlowKey = glowKey
		self:ApplyGlows(night)
	end
	local want = open and not locked
	if want == self.DoorOpen then
		return
	end
	self.DoorOpen = want
	if #self.Leaves > 0 then
		swingLeaves(self.Leaves, want)
		return
	end
	local closedCF = hinge * CFrame.new(WorldLayout.DOOR_W / 2 - 0.05, (WorldLayout.DOOR_H - 0.05) / 2, 0)
	local target = want and hinge * CFrame.Angles(0, math.rad(100), 0) * CFrame.new(WorldLayout.DOOR_W / 2 - 0.05, (WorldLayout.DOOR_H - 0.05) / 2, 0) or closedCF
	leaf.CanCollide = not want
	local ok = pcall(function()
		TweenService:Create(leaf, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = target }):Play()
	end)
	if not ok then
		leaf.CFrame = target
	end
end

-- (v9.9 HOUSE99) Nuit (même règle que les lanternes du jardin ; suit aussi
-- le réglage "Heure du jour" : Lighting.ClockTime du client)
function HouseBuilder.IsNight(): boolean
	local clock = Lighting.ClockTime
	return clock < 6.4 or clock > 17.6
end

local GLOW_WARM = Color3.fromRGB(255, 206, 140)

-- (v9.9) Allume / éteint la lueur de nuit de chaque fenêtre : pièce qui
-- existe + lumière allumée (attribut du propriétaire) ; rideaux fermés =
-- lueur teintée par le tissu, un peu plus douce ; hall : toujours la nuit
function HouseBuilder.ApplyGlows(self: House, night: boolean)
	local off, closed = ownerFlags(self)
	local bySlot = roomsBySlot(self.Snapshot)
	for slot, list in pairs(self.Glows) do
		local on, color, alpha = false, GLOW_WARM, 0.3
		if slot == 0 then
			on = night
			alpha = 0.4
		else
			local room = bySlot[slot]
			if room then
				local id = tostring(room.Id)
				on = night and not off[id]
				if closed[id] then
					local style = wallpaperOf(room)
					local fabric = style and typeof(style.B) == "Color3" and style.B or Color3.fromRGB(255, 190, 214)
					color = GLOW_WARM:Lerp(fabric, 0.55)
					alpha = 0.42
				end
			end
		end
		for _, glow in ipairs(list) do
			if glow.Gui and glow.Fill then
				glow.Gui.Enabled = on
				glow.Fill.BackgroundColor3 = color
				glow.Fill.BackgroundTransparency = alpha
			elseif glow.Part then
				-- (v10 LOD) vitre simplifiée : teinte chaude douce (Neon sombre) la nuit
				local part: BasePart = glow.Part
				if on then
					part.Color = color:Lerp(Color3.new(0, 0, 0), 0.25)
					part.Material = M.Neon
				else
					part.Color = glow.Day or part.Color
					part.Material = glow.DayMat or M.SmoothPlastic
				end
			end
		end
	end
end

-- (v9.8) Milieu de la porte de derrière (monde), côté jardin
function HouseBuilder.BackDoorPosition(self: House): Vector3
	return WorldLayout.ToWorld(self.HouseCF, WorldLayout.BackDoorX(self.Size), WorldLayout.FloorY(1) + 2, WorldLayout.BackDoorD(self.Size) - 0.4)
end

-- (v9.8) Applique les attributs 💡 / 🪟 du propriétaire à toutes les pièces construites
function HouseBuilder.ApplyRoomFlags(self: House, animate: boolean)
	local off, closed, key = ownerFlags(self)
	self.FlagKey = key
	for _, state in pairs(self.Rooms) do
		if state.Toggles and state.Data then
			local id = tostring(state.Data.Id)
			applyToggles(state, not off[id], not closed[id], animate)
		end
	end
end

-- (v9.8) Le propriétaire bascule les rideaux ou les lumières d'une pièce :
-- animation tout de suite, puis sauvegarde (en cas de refus : retour à
-- l'état du serveur)
function HouseBuilder.ToggleRoom(self: House, slot: number, what: string): boolean
	local state = self.Rooms[slot]
	local t = state and state.Toggles
	if not state or not t or not state.Data or not localIsOwner(self) then
		return false
	end
	local lightsOn, curtainsOpen = t.LightsOn, t.CurtainsOpen
	local argument: { [string]: any } = { Room = tostring(state.Data.Id) }
	if what == "Lights" then
		lightsOn = not lightsOn
		argument.LightsOn = lightsOn
	elseif what == "Curtains" then
		curtainsOpen = not curtainsOpen
		argument.CurtainsOpen = curtainsOpen
	else
		return false
	end
	applyToggles(state, lightsOn, curtainsOpen, true)
	task.spawn(function()
		local ok, success = pcall(function()
			return Net.Function("House"):InvokeServer("setRoomState", argument)
		end)
		if not (ok and success == true) and self.Alive then
			self:ApplyRoomFlags(true)
		end
	end)
	return true
end

-- Position de la porte (monde) : pour savoir si quelqu'un approche
function HouseBuilder.DoorPosition(self: House): Vector3
	return WorldLayout.ToWorld(self.HouseCF, WorldLayout.DoorX(self.Size), WorldLayout.FloorY(1) + 2, 0)
end

-- Nouvel instantané : extérieur reconstruit si besoin, pièces changées vidées
function HouseBuilder.Update(self: House, snapshot: any)
	self.Snapshot = snapshot
	local newSize = sizeDefOf(snapshot)
	local sizeChanged = newSize ~= self.Size
	self.Size = newSize
	local bySlot = roomsBySlot(snapshot)
	if sizeChanged then
		for slot in pairs(self.Rooms) do
			self:DestroyRoom(slot)
		end
		table.clear(self.Rooms)
	end
	for slot, state in pairs(self.Rooms) do
		local room = bySlot[slot]
		local signature = roomSignature(room)
		if signature ~= state.Signature then
			state.Signature = signature
			state.Data = room
			if state.State ~= "None" then
				self:DestroyRoom(slot)
			end
		end
	end
	if sizeChanged or exteriorKey(snapshot) ~= self.ExteriorKey then
		if self.Lod == "Full" then
			self:BuildExterior()
		else
			self:BuildLite(self.Lod)
		end
	end
end

-- Remplace la liste d'objets d'une pièce (déplacement local, avant la réponse
-- du serveur) et la reconstruit tout de suite
function HouseBuilder.SetRoomPlaced(self: House, slot: number, placed: { any })
	local state = self.Rooms[slot]
	if not state or not state.Data then
		return
	end
	state.Data.Placed = placed
	state.Signature = roomSignature(state.Data)
	task.spawn(function()
		self:BuildRoom(slot)
	end)
end

function HouseBuilder.Signature(room: any): string
	return roomSignature(room)
end

-- État des invariants (tests / diagnostic) : ne répare rien
function HouseBuilder.Audit(self: House): Audit
	local shells: { [number]: number } = {}
	local extraShells = 0
	local count = 0
	for _, child in ipairs(self.Interiors:GetChildren()) do
		local slot = tonumber(child:GetAttribute("Slot"))
		count += 1
		if not slot or not self.Rooms[slot] or self.Rooms[slot].Shell ~= child then
			extraShells += 1
		end
		if slot then
			shells[slot] = (shells[slot] or 0) + 1
		end
	end
	local items, duplicates, missing = 0, 0, 0
	for _, state in pairs(self.Rooms) do
		local shell = state.Shell
		local folder = shell and shell:FindFirstChild("Items")
		if folder then
			local seen: { [number]: boolean } = {}
			for _, model in ipairs(folder:GetChildren()) do
				local index = tonumber(model:GetAttribute("EntryIndex"))
				if index then
					items += 1
					if seen[index] then
						duplicates += 1
					end
					seen[index] = true
				end
			end
			if state.State == "Built" and state.Data and type(state.Data.Placed) == "table" and HouseCommon then
				for index, entry in ipairs(state.Data.Placed) do
					if type(entry) == "table" and HouseCommon.ItemsById[entry.I] and not seen[index] then
						missing += 1
					end
				end
			end
		end
	end
	local houses = 0
	local parent = self.Model.Parent
	if parent then
		for _, child in ipairs(parent:GetChildren()) do
			if child:IsA("Model") and child:GetAttribute("OwnerId") == self.UserId then
				houses += 1
			end
		end
	end
	local expected = self.ChimneysExpected or HouseFacade.Chimneys[self.Style] or 0
	return {
		OK = extraShells == 0 and duplicates == 0 and missing == 0 and houses == 1 and self.Chimneys == expected,
		Shells = count,
		ExtraShells = extraShells,
		Items = items,
		Duplicates = duplicates,
		Missing = missing,
		Houses = houses,
		Chimneys = self.Chimneys,
		ChimneysExpected = expected,
		Parts = self.ExteriorParts,
		Lights = self.ExteriorLights,
	}
end

function HouseBuilder.Destroy(self: House)
	self.Alive = false
	self:DestroyHall()
	for slot in pairs(self.Rooms) do
		self:DestroyRoom(slot)
	end
	self.Model:Destroy()
end

return HouseBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="199">
          <Properties>
            <string name="Name">HouseConstruction</string>
            <string name="Source"><![CDATA[--[[
	HouseConstruction (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > HouseConstruction

	🏗️ v10 (CONSTRUCT10) : chantiers et maisons qui se construisent, côté
	client (lancé par TownClient : Start / Observe / Step / ArrivalDone / Stop).
	  - PARCELLE SANS PROPRIÉTAIRE = CHANTIER (ConstructionSite), aussi sur
	    les places vides des quartiers (WorldLayout.FillerLots) : en flux,
	    3 niveaux de détail selon la distance de la caméra et le réglage
	    "Détail" (GraphicsQuality) ; grues en silhouette jusqu'à ~1300 studs ;
	  - UN JOUEUR ARRIVE (nouvelle maison pendant qu'on est en ville), change
	    de style de maison, ou déménage de quartier : sa maison SE CONSTRUIT
	    sous les yeux de tous ceux qui sont près (HouseBuildAnim, ~11,5 s) ;
	    le chantier fait place nette et sa grue sert à la construction ;
	  - LE PROPRIÉTAIRE, à sa 1re entrée en ville de la session : sa maison
	    reste un chantier, puis (après le survol d'arrivée) moment caméra :
	    bandes de cinéma, la caméra rejoint sa parcelle (fondu si c'est loin),
	    tourne doucement pendant la construction, "🏠 Ta maison est prête !",
	    confettis, retour derrière l'avatar. Bouton "⏭ Passer" à tout moment ;
	  - petites animations : les portillons (attribut Micro = "Swing" posé par
	    HOUSE10 : HingeCF, OpenAngle, Range) s'ouvrent quand on approche ; le
	    drapeau des boîtes aux lettres (pièces "MailFlag") se lève quand
	    quelqu'un passe devant.
	Sûreté : quitter la ville, être DANS une maison en construction, ou une
	maison détruite -> l'animation se termine tout de suite (état exact).

	Crochets TownClient (voir le rapport CONSTRUCT10) :
	  HouseConstruction.Start({ Folder, Toast?, GetSnapshots, GetHouses })
	  HouseConstruction.Observe(userId, house, snapshot)  (après new / Update)
	  HouseConstruction.Step(dt)                            (chaque image)
	  HouseConstruction.ArrivalDone()                       (après le survol)
	  HouseConstruction.Stop()
	  HouseConstruction.Stats() -> { Sites, Full, Lite, Parts, Anims }
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local WorldLayout = require(ReplicatedStorage.Shared.WorldLayout)
local Locale = require(ReplicatedStorage.Shared.Locale)
local ConstructionSite = require(script.Parent.ConstructionSite)
local HouseBuildAnim = require(script.Parent.HouseBuildAnim)
local Kit = require(script.Parent.ConstructionKit)

local HouseConstruction = {}

local LocalPlayer = Players.LocalPlayer

local FULL_IN = 220 -- (studs, x DetailScale) chantier complet plus près que ça
local FULL_OUT = 255
local LITE_IN = 1300 -- silhouette (grue) plus près que ça
local LITE_OUT = 1400
local SYNC_EVERY = 0.5
local ANIM_RANGE = 340 -- (studs) une maison plus loin que ça apparaît sans animation
local OWNER_FALLBACK = 16 -- (s) sans ArrivalDone : moment du propriétaire au plus tard
local MICRO_RANGE = 140
local LOAD_WINDOW = 12 -- (s) sans ArrivalDone : fin du chargement au plus tard

local GUI_NAME = "ConstructionGui"

local function T(text: string, ...: any): string
	local ok, value = pcall(Locale.T, text, ...)
	return if ok and type(value) == "string" then value else text
end

-- GraphicsQuality (facultatif)
local gfxModule: any = nil
local gfxTried = false
local function detailScale(): number
	if not gfxTried then
		gfxTried = true
		local module = ReplicatedStorage.Shared:FindFirstChild("GraphicsQuality")
		if module and module:IsA("ModuleScript") then
			local ok, result = pcall(require, module)
			if ok then
				gfxModule = result
			end
		end
	end
	if gfxModule and type(gfxModule.DetailScale) == "function" then
		local ok, value = pcall(gfxModule.DetailScale)
		if ok and type(value) == "number" and value > 0 then
			return value
		end
	end
	return 1
end

----------------------------------------------------------------------
-- État
----------------------------------------------------------------------

type Record = { House: any, Size: any, Plot: number? }

local S: any = {
	Active = false,
	Opts = nil,
	Folder = nil,
	Known = {} :: { [number]: boolean },
	Records = {} :: { [number]: Record },
	Sites = {} :: { [string]: any },
	Anims = {} :: { [number]: any },
	Clearing = {} :: { any }, -- chantiers en cours de retrait animé
	SyncClock = 0,
	StartedAt = 0,
	Owner = nil, -- { State, Anim, House, Plot, Since, ... }
	Micro = {} :: { any },
	MicroConns = {} :: { RBXScriptConnection },
	MicroParts = {} :: { [BasePart]: boolean },
	Gui = nil,
	DS = 1,
}
local ownerSeen = false -- (1re entrée de la session : le moment du propriétaire)
local ownerPlot: number? = nil -- (parcelle et taille de sa maison au dernier moment : un
local ownerSize: any = nil -- déménagement / nouveau style relance le moment)

local function camera(): Camera?
	return workspace.CurrentCamera
end

local function camPos(): Vector3
	local cam = camera()
	return if cam then cam.CFrame.Position else WorldLayout.Origin()
end

local function plotCount(): number
	local folder = workspace:FindFirstChild("DopamineTown")
	local count = folder and folder:GetAttribute("PlotCount")
	return if type(count) == "number" then count else WorldLayout.PlotCount(Players.MaxPlayers)
end

local function localRoot(): BasePart?
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

----------------------------------------------------------------------
-- Chantiers : quelles places ?
----------------------------------------------------------------------

type Spot = { Key: string, CF: CFrame, Style: string, W: number, D: number, Seed: number, Plot: number? }

local STYLES = { "Cottage", "Townhouse", "Loft", "Mansion" }

local function spotStyle(style: any, seed: number): string
	if type(style) == "string" and table.find(STYLES, style) then
		return style
	end
	return STYLES[(seed % 3) + 1]
end

local function allSpots(count: number): { Spot }
	local spots: { Spot } = {}
	for i = 1, count do
		local ok, cf = pcall(WorldLayout.PlotCFrame, i, count)
		if ok and typeof(cf) == "CFrame" then
			local style = nil
			pcall(function()
				local district = (WorldLayout :: any).PlotDistrict(i, count)
				style = district and district.Style
			end)
			local w, d = WorldLayout.PLOT_W, WorldLayout.PLOT_D
			pcall(function()
				local pw, pd = (WorldLayout :: any).PlotSize(i, count)
				if type(pw) == "number" and type(pd) == "number" then
					w, d = pw, pd
				end
			end)
			table.insert(spots, { Key = "P" .. i, CF = cf, Style = spotStyle(style, i), W = w, D = d, Seed = i, Plot = i })
		end
	end
	-- places vides des quartiers : chantiers permanents
	pcall(function()
		local lots = (WorldLayout :: any).FillerLots(count)
		for k, lot in ipairs(lots or {}) do
			local cf = (WorldLayout :: any).LotCFrame(lot)
			local style = nil
			pcall(function()
				local district = (WorldLayout :: any).District(count, lot.District)
				style = district and district.Style
			end)
			table.insert(spots, { Key = "L" .. k, CF = cf, Style = spotStyle(style, 100 + k), W = tonumber(lot.W) or WorldLayout.PLOT_W, D = tonumber(lot.D) or WorldLayout.PLOT_D, Seed = 100 + k, Plot = nil })
		end
	end)
	return spots
end

-- Parcelles occupées (d'après les instantanés : immédiat, côté client)
local function occupied(): { [number]: number }
	local map = {}
	local opts = S.Opts
	local snapshots = opts and opts.GetSnapshots and opts.GetSnapshots()
	if type(snapshots) == "table" then
		for userId, snapshot in pairs(snapshots) do
			local plot = type(snapshot) == "table" and tonumber(snapshot.Plot)
			if plot then
				map[plot] = tonumber(userId) or 0
			end
		end
	else
		-- secours : attributs des parcelles du serveur
		local town = workspace:FindFirstChild("DopamineTown")
		local plots = town and town:FindFirstChild("Plots")
		if plots then
			for _, model in ipairs(plots:GetChildren()) do
				local index, owner = model:GetAttribute("Index"), model:GetAttribute("OwnerId")
				if type(index) == "number" and type(owner) == "number" and owner ~= 0 then
					map[index] = owner
				end
			end
		end
	end
	return map
end

local spotCache: { Count: number, Spots: { Spot } }? = nil

local function syncSites()
	local count = plotCount()
	if not spotCache or spotCache.Count ~= count then
		spotCache = { Count = count, Spots = allSpots(count) }
	end
	local owners = occupied()
	local owner = S.Owner
	-- parcelles où une maison est DÉJÀ construite ici (jamais de chantier dessous)
	local built: { [number]: boolean } = {}
	for _, rec in pairs(S.Records) do
		if rec.Plot and rec.House and rec.House.Alive ~= false then
			built[rec.Plot] = true
		end
	end
	local wanted: { [string]: Spot } = {}
	for _, spot in ipairs((spotCache :: any).Spots) do
		local keep = true
		if spot.Plot and built[spot.Plot] then
			keep = false
		elseif spot.Plot then
			local userId = owners[spot.Plot]
			if userId then
				local rec = S.Records[userId]
				-- occupée : chantier gardé tant que la maison n'est pas là, ou
				-- pour le moment du propriétaire (pas encore joué)
				keep = rec == nil or rec.Plot ~= spot.Plot
			end
		end
		-- sa maison pas encore construite (moment du propriétaire) : chantier gardé
		if spot.Plot and owner and owner.Plot == spot.Plot and (owner.State == "Pending" or owner.State == "Moving") then
			keep = true
		end
		if keep then
			wanted[spot.Key] = spot
		end
	end
	for key, site in pairs(S.Sites) do
		if site.Done then
			S.Sites[key] = nil
		elseif not wanted[key] then
			site:Destroy()
			S.Sites[key] = nil
		end
	end
	local loaded = os.clock() - S.StartedAt > 4
	for key, spot in pairs(wanted) do
		if not S.Sites[key] then
			S.Sites[key] = ConstructionSite.new(spot.CF, {
				Parent = S.Folder,
				Seed = spot.Seed,
				Style = spot.Style,
				PlotW = spot.W,
				PlotD = spot.D,
				Name = "Site_" .. key,
				Appear = loaded, -- (une parcelle qui se libère : fondu)
			})
			S.Sites[key].Key = key
			S.Sites[key].Plot = spot.Plot
		end
	end
end

-- Niveaux de détail (au plus un chantier complet construit par image)
local function stepLevels()
	local pos = camPos()
	local ds = S.DS
	local owner = S.Owner
	local builtFull = false
	local builtLite = 0
	for _, site in pairs(S.Sites) do
		if not site.Done and not site.Clearing then
			local distance = (site.Ground.Position - pos).Magnitude
			local level = site.Level
			local want = level
			local forced = owner and (owner.State == "Pending" or owner.State == "Moving") and owner.Plot ~= nil and site.Plot == owner.Plot
			if forced or distance < FULL_IN * ds then
				want = 2
			elseif level == 2 and distance < FULL_OUT * ds then
				want = 2
			elseif distance < LITE_IN then
				want = 1
			elseif level >= 1 and distance < LITE_OUT then
				want = 1
			else
				want = 0
			end
			if want ~= level then
				if want == 2 then
					if not builtFull then
						builtFull = true
						site.DetailScale = ds
						site:SetLevel(2)
					end
				elseif want == 1 then
					if builtLite < 4 then
						builtLite += 1
						site:SetLevel(1)
					end
				else
					site:SetLevel(0)
				end
			end
		end
	end
end

----------------------------------------------------------------------
-- Interface (moment du propriétaire)
----------------------------------------------------------------------

local function destroyGui()
	if S.Gui then
		S.Gui.Screen:Destroy()
		S.Gui = nil
	end
end

local function makeGui(): any
	if S.Gui then
		return S.Gui
	end
	local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not playerGui then
		return nil
	end
	local screen = Instance.new("ScreenGui")
	screen.Name = GUI_NAME
	screen.ResetOnSpawn = false
	screen.IgnoreGuiInset = true
	screen.DisplayOrder = 60
	screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	local function frame(name: string, props: { [string]: any }): Frame
		local f = Instance.new("Frame")
		f.Name = name
		f.BorderSizePixel = 0
		for k, v in pairs(props) do
			(f :: any)[k] = v
		end
		f.Parent = props.Parent or screen
		return f
	end
	local fade = frame("Fade", { BackgroundColor3 = Color3.fromRGB(255, 236, 246), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 50 })
	local top = frame("BarTop", { BackgroundColor3 = Color3.new(0, 0, 0), Size = UDim2.new(1, 0, 0.085, 0), Position = UDim2.new(0, 0, -0.1, 0), ZIndex = 10 })
	local bottom = frame("BarBottom", { BackgroundColor3 = Color3.new(0, 0, 0), Size = UDim2.new(1, 0, 0.085, 0), Position = UDim2.new(0, 0, 1.02, 0), ZIndex = 10 })
	-- légende + barre de progression (au-dessus de la bande du bas)
	local caption = frame("Caption", { BackgroundColor3 = Color3.fromRGB(255, 255, 255), BackgroundTransparency = 0.12, AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0.9, -6), Size = UDim2.new(0.62, 0, 0.16, 0), ZIndex = 20, Visible = false })
	local limit = Instance.new("UISizeConstraint")
	limit.MaxSize = Vector2.new(560, 90)
	limit.MinSize = Vector2.new(220, 50)
	limit.Parent = caption
	local corner = Instance.new("UICorner")

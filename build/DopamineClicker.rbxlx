		["🔒 Your house is closed to visitors"] = "🔒 Ta maison est fermée aux visiteurs",
		["🚪 Empty room · buy it in 🏠 My house"] = "🚪 Pièce vide · achète-la dans 🏠 Ma maison",
		["Get closer to sit down"] = "Approche-toi pour t'asseoir",
		-- ❤️
		["Walk to the house to like it"] = "Va jusqu'à la maison pour l'aimer",
		["That's your own house!"] = "C'est ta propre maison !",
		["❤️ You already liked this house today"] = "❤️ Tu as déjà aimé cette maison aujourd'hui",
		["❤️ No likes left today (max %s), come back tomorrow!"] = "❤️ Plus de j'aime aujourd'hui (max %s), reviens demain !",
		["❤️ Liked! +%s Dopamine · %s likes left today"] = "❤️ Aimée ! +%s Dopamine · encore %s j'aime aujourd'hui",
		["❤️ %s liked your house! (+%s Dopamine)"] = "❤️ %s aime ta maison ! (+%s Dopamine)",

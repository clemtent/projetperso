		["🔓 Open to everyone"] = "🔓 Ouverte à tous",
		["👥 Friends only"] = "👥 Amis seulement",
		["🔒 Closed"] = "🔒 Fermée",
		-- émotes
		["Wave"] = "Salut",
		["Dance"] = "Danse",
		["Cheer"] = "Youpi",
		["Sit"] = "S'asseoir",
		["Point"] = "Montrer",
		["This emote isn't available for your avatar"] = "Cette émote n'existe pas pour ton avatar",
		-- visites
		["👥 Visit a house"] = "👥 Visiter une maison",
		["Walk to their door, sit on their sofa and leave a ❤️"] = "Va jusqu'à sa porte, assieds-toi sur son canapé et laisse un ❤️",
		["%s (you)"] = "%s (toi)",
		["🚶 in town"] = "🚶 en ville",
		["💤 clicking"] = "💤 clique",
		["🏠 Home"] = "🏠 Chez moi",
		["🚶 Visit"] = "🚶 Visiter",
		["Nobody else is here yet… invite a friend!"] = "Personne d'autre pour l'instant… invite un ami !",
		["🚶 Welcome to %s's house!"] = "🚶 Bienvenue chez %s !",
		["This player has no house here"] = "Ce joueur n'a pas de maison ici",

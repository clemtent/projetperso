	local quit = button({ Name = "Quit", Parent = root, Text = "🏳️", TextSize = 22, Color = rgb(120, 100, 140), Size = UDim2.fromOffset(52, 48),
		AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -104, 1, -172), Visible = false, ZIndex = 6 })

		{ Id = "Legendary", Name = "LÉGENDAIRE", Weight = 3, RewardSeconds = 200, Color = Color3.fromRGB(255, 180, 0) },
	},
}

----------------------------------------------------------------------
-- Boutique d'objets (cosmétiques du bouton, conservés pour toujours)
--   Slot "Hat"  : emoji posé au-dessus du bouton
--   Slot "Skin" : couleurs du bouton (dégradé Top -> Bottom)
----------------------------------------------------------------------
Config.Cosmetics = {
	{ Id = "Cap", Name = "Casquette rouge", Icon = "🧢", Slot = "Hat", Cost = 20000},
	{ Id = "PartyHat", Name = "Chapeau de fête", Icon = "🥳", Slot = "Hat", Cost = 80000},
	{ Id = "TopHat", Name = "Haut-de-forme", Icon = "🎩", Slot = "Hat", Cost = 300000},
	{ Id = "Headphones", Name = "Casque audio", Icon = "🎧", Slot = "Hat", Cost = 600000},
	{ Id = "Graduation", Name = "Toque de diplômé", Icon = "🎓", Slot = "Hat", Cost = 2.5e6},
	{ Id = "Crown", Name = "Couronne", Icon = "👑", Slot = "Hat", Cost = 6e6},
	{ Id = "Halo", Name = "Auréole", Icon = "😇", Slot = "Hat", Cost = 3e7},
	{ Id = "Unicorn", Name = "Corne de licorne", Icon = "🦄", Slot = "Hat", Cost = 2e8},
	{ Id = "SkinMint", Name = "Bouton menthe", Icon = "🟩", Slot = "Skin", Cost = 40000,
		Top = Color3.fromRGB(210, 255, 225), Bottom = Color3.fromRGB(120, 220, 160) },
	{ Id = "SkinSky", Name = "Bouton ciel", Icon = "🟦", Slot = "Skin", Cost = 150000,
		Top = Color3.fromRGB(215, 240, 255), Bottom = Color3.fromRGB(110, 180, 255) },
	{ Id = "SkinCandy", Name = "Bouton bonbon", Icon = "🍬", Slot = "Skin", Cost = 1.2e6,
		Top = Color3.fromRGB(255, 220, 240), Bottom = Color3.fromRGB(255, 110, 180) },
	{ Id = "SkinGold", Name = "Bouton en or", Icon = "🟨", Slot = "Skin", Cost = 1.2e7,
		Top = Color3.fromRGB(255, 240, 160), Bottom = Color3.fromRGB(230, 160, 0) },
	{ Id = "SkinVoid", Name = "Bouton du néant", Icon = "⬛", Slot = "Skin", Cost = 8e7,
		Top = Color3.fromRGB(70, 60, 90), Bottom = Color3.fromRGB(5, 5, 10) },
}

----------------------------------------------------------------------
-- Temps d'écran
----------------------------------------------------------------------
Config.ScreenTime = {
	DaysKept = 7,
}

----------------------------------------------------------------------
-- Classement global
----------------------------------------------------------------------
Config.Leaderboard = {
	StoreName = "DopamineLeaderboard_v2",
	UpdateInterval = 60,
	Size = 10,
}

----------------------------------------------------------------------
-- Sauvegarde
----------------------------------------------------------------------
Config.DataStore = {
	Name = "DopamineClickerData_v2", -- change le nom pour repartir de zéro
	AutoSaveInterval = 120,
	MaxRetries = 4,
}

----------------------------------------------------------------------
-- Sons : remplace par tes propres IDs ("rbxassetid://123456789").
-- Laisse "" pour désactiver un son.
-- Les "rbxasset://sounds/..." sont des sons intégrés à Roblox (toujours dispo).
----------------------------------------------------------------------
Config.Sounds = {
	Click = { Id = "rbxasset://sounds/clickfast.wav", Volume = 0.5 },
	Buy = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.6 },
	Error = { Id = "rbxasset://sounds/clickfast.wav", Volume = 0.3 },
	Bounce = { Id = "rbxasset://sounds/clickfast.wav", Volume = 0.2 },
	Bonus = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.6 },
	Achievement = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.8 },
	Jackpot = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 1 },
	Golden = { Id = "rbxasset://sounds/swoosh.wav", Volume = 0.6 },
	Rush = { Id = "rbxasset://sounds/swoosh.wav", Volume = 0.8 },
	Detox = { Id = "rbxasset://sounds/swoosh.wav", Volume = 1 },
	Open = { Id = "rbxasset://sounds/swoosh.wav", Volume = 0.3 },
	Pop = { Id = "rbxasset://sounds/clickfast.wav", Volume = 0.5 },
	Crush = { Id = "rbxasset://sounds/swoosh.wav", Volume = 0.5 },
	Thunder = { Id = "rbxasset://sounds/swoosh.wav", Volume = 0.7 },
	Notif = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.4 },
	Mail = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.4 },
	SlotSpin = { Id = "rbxasset://sounds/clickfast.wav", Volume = 0.3 },
	SlotWin = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.9 },
	Chest = { Id = "rbxasset://sounds/swoosh.wav", Volume = 0.7 },
	Cash = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.5 },
	Megaphone = { Id = "rbxasset://sounds/swoosh.wav", Volume = 0.4 },
	Music = { Id = "", Volume = 0.3 }, -- musique lofi en boucle (mets ton ID)
}

----------------------------------------------------------------------
-- Index calculés automatiquement (ne pas modifier)
----------------------------------------------------------------------
Config.UpgradesById = {}
Config.FeatureToUpgrade = {} -- [Feature] = Id de l'amélioration qui la débloque
for index, upgrade in ipairs(Config.Upgrades) do
	upgrade.Order = index
	upgrade.CostGrowth = upgrade.CostGrowth or 1
	Config.UpgradesById[upgrade.Id] = upgrade
	if upgrade.Feature then
		Config.FeatureToUpgrade[upgrade.Feature] = upgrade.Id
	end
end

Config.AchievementsById = {}
for _, achievement in ipairs(Config.Achievements) do
	Config.AchievementsById[achievement.Id] = achievement
end

Config.CosmeticsById = {}
for index, cosmetic in ipairs(Config.Cosmetics) do
	cosmetic.Order = index
	Config.CosmeticsById[cosmetic.Id] = cosmetic
end

Config.CasinoSymbolsById = {}
for _, symbol in ipairs(Config.Casino.Symbols) do
	Config.CasinoSymbolsById[symbol.Id] = symbol
end

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="48">
        <Properties>
          <string name="Name">DVDMath</string>
          <string name="Source"><![CDATA[--[[
	DVDMath (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > DVDMath

	Mathématiques du logo DVD, partagées entre serveur et client.

	Le mouvement est DÉTERMINISTE : à partir de quelques paramètres
	(position de départ, vitesse, heure de départ), on peut calculer la
	position exacte à n'importe quel instant. Avantages :
	  - mouvement parfaitement fluide, quel que soit le nombre d'images/s ;
	  - le serveur peut vérifier qu'un "coin touché" est réel (anti-triche).

	Coordonnées normalisées : 0 = bord gauche/haut, 1 = bord droit/bas.
	Le coin haut-gauche du logo se déplace dans [0, 1 - largeurLogo].
]]

local DVDMath = {}

export type Params = {
	X0: number, -- position de départ (normalisée)
	Y0: number,
	VX: number, -- vitesse (fraction d'écran par seconde, signe = direction)
	VY: number,
	T0: number, -- heure serveur de départ (workspace:GetServerTimeNow())
	W: number, -- taille du logo (fraction de l'écran)
	H: number,
}

-- "Onde triangle" : fait rebondir une valeur qui avance tout droit entre 0 et range
function DVDMath.Triangle(u: number, range: number): number
	if range <= 0 then
		return 0
	end
	local m = u % (2 * range) -- toujours positif en Luau
	if m <= range then
		return m
	end
	return 2 * range - m
end

function DVDMath.Ranges(params: Params): (number, number)
	return math.max(0.001, 1 - params.W), math.max(0.001, 1 - params.H)
end

-- Distance "dépliée" parcourue (sans rebond) sur chaque axe au temps t
function DVDMath.Unfolded(params: Params, t: number): (number, number)
	local dt = t - params.T0
	return params.X0 + params.VX * dt, params.Y0 + params.VY * dt
end

-- Position réelle (avec rebonds) au temps t
function DVDMath.Position(params: Params, t: number): (number, number)
	local rangeX, rangeY = DVDMath.Ranges(params)
	local u, v = DVDMath.Unfolded(params, t)
	return DVDMath.Triangle(u, rangeX), DVDMath.Triangle(v, rangeY)
end

-- Numéro du "segment" entre deux rebonds sur chaque axe.
-- Quand ce numéro change, le logo vient de rebondir.
function DVDMath.BounceIndex(params: Params, t: number): (number, number)
	local rangeX, rangeY = DVDMath.Ranges(params)
	local u, v = DVDMath.Unfolded(params, t)
	return math.floor(u / rangeX), math.floor(v / rangeY)
end

-- Heure exacte du rebond horizontal numéro k (quand u = k * rangeX)
function DVDMath.BounceTimeX(params: Params, k: number): number
	local rangeX = DVDMath.Ranges(params)
	return params.T0 + (k * rangeX - params.X0) / params.VX
end

-- Au moment du rebond horizontal k, le logo est-il aussi contre un bord
-- vertical ? Si oui : COIN !
function DVDMath.IsCornerAtBounceX(params: Params, k: number, tolerance: number): boolean
	local _, rangeY = DVDMath.Ranges(params)
	local t = DVDMath.BounceTimeX(params, k)
	local _, y = DVDMath.Position(params, t)
	return y <= tolerance or y >= rangeY - tolerance
end

-- Direction actuelle (+1 / -1) sur chaque axe, utile pour garder la
-- continuité quand l'écran change de taille
function DVDMath.Directions(params: Params, t: number): (number, number)
	local rangeX, rangeY = DVDMath.Ranges(params)
	local u, v = DVDMath.Unfolded(params, t)
	local dirX = (u % (2 * rangeX) <= rangeX) and 1 or -1
	local dirY = (v % (2 * rangeY) <= rangeY) and 1 or -1
	return dirX * math.sign(params.VX), dirY * math.sign(params.VY)
end

return DVDMath
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">Formulas</string>
          <string name="Source"><![CDATA[--[[
	Formulas (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > Formulas

	Toutes les formules de calcul du jeu (coûts, gains, combo, rebirth,
	casino...). Partagé entre serveur et client pour que l'affichage
	corresponde exactement aux calculs du serveur. Le serveur reste l'autorité.
]]

local Config = require(script.Parent.Config)

local Formulas = {}

----------------------------------------------------------------------
-- Améliorations
----------------------------------------------------------------------

-- Niveau actuel d'une amélioration
function Formulas.GetLevel(data, upgradeId: string): number
	return data.Upgrades[upgradeId] or 0
end

-- Rebirth ("Aller à l'océan")
function Formulas.GetRebirthCost(rebirths: number): number
	return Config.Rebirth.BaseCost * (Config.Rebirth.CostGrowth ^ rebirths)
end

function Formulas.GetRebirthMultiplier(rebirths: number): number
	return 1 + rebirths * Config.Rebirth.MultiplierPerRebirth
end

-- Prix du PROCHAIN niveau (level = niveau actuel)
function Formulas.GetUpgradeCost(upgrade, level: number, rebirths: number?): number
	if upgrade.Effect == "Detox" then
		return Formulas.GetRebirthCost(rebirths or 0)
	end
	return math.floor(upgrade.Cost * (upgrade.CostGrowth ^ level) + 0.5)
end

function Formulas.IsMaxed(upgrade, level: number): boolean
	return upgrade.MaxLevel ~= nil and level >= upgrade.MaxLevel
end

-- Texte de l'infobulle ("%s" remplacé par la valeur formatée)
function Formulas.DescribeUpgrade(upgrade, format: (number) -> string, rebirths: number?): string
	local text = upgrade.Description or ""
	if not string.find(text, "%s", 1, true) then
		return text
	end
	local value = upgrade.Value or 0
	if upgrade.Effect == "Detox" then
		value = Formulas.GetRebirthMultiplier((rebirths or 0) + 1)
	elseif upgrade.Effect == "DVD" then
		value = Config.DVD.BaseBounceValue
	end
	return (string.gsub(text, "%%s", format(value), 1))
end

-- Liste des améliorations visibles dans la barre : celles déjà possédées
-- (et pas au maximum) + les Config.UpgradeBar.RevealAhead suivantes.
function Formulas.GetVisibleUpgrades(data): { any }
	local list = {}
	local revealed = 0
	for _, upgrade in ipairs(Config.Upgrades) do
		local level = Formulas.GetLevel(data, upgrade.Id)
		if not Formulas.IsMaxed(upgrade, level) then
			if level > 0 then
				table.insert(list, upgrade)
			elseif revealed < Config.UpgradeBar.RevealAhead then
				table.insert(list, upgrade)
				revealed += 1
			end
		end
	end
	return list
end

-- Ensemble des "Features" débloquées : { [Feature] = true }
function Formulas.GetFeatures(data): { [string]: boolean }
	local features = {}
	for _, upgrade in ipairs(Config.Upgrades) do
		if upgrade.Feature and Formulas.GetLevel(data, upgrade.Id) > 0 then
			features[upgrade.Feature] = true
		end
	end
	return features
end

function Formulas.HasFeature(data, feature: string): boolean
	local upgradeId = Config.FeatureToUpgrade[feature]
	return upgradeId ~= nil and Formulas.GetLevel(data, upgradeId) > 0
end

----------------------------------------------------------------------
-- Combo
----------------------------------------------------------------------

-- Jauge 0-100 -> multiplicateur 1 à MaxMultiplier
function Formulas.GetComboMultiplier(meter: number): number
	local ratio = math.clamp(meter / 100, 0, 1)
	return 1 + ratio * (Config.Combo.MaxMultiplier - 1)
end

-- Met à jour la jauge : on retire la perte depuis le dernier clic puis on ajoute un clic
function Formulas.StepCombo(meter: number, elapsed: number): number
	meter = math.max(0, meter - Config.Combo.DecayPerSecond * elapsed)
	return math.min(100, meter + Config.Combo.GainPerClick)
end

----------------------------------------------------------------------
-- Statistiques d'un joueur
----------------------------------------------------------------------

local function countKeys(map, lookup): number
	local count = 0
	for id, value in pairs(map) do
		if value and lookup[id] then
			count += 1
		end
	end
	return count
end

function Formulas.CountAchievements(data): number
	return countKeys(data.Achievements, Config.AchievementsById)
end

function Formulas.CountCosmetics(data): number
	local cosmetics = data.Cosmetics
	if not cosmetics or not cosmetics.Owned then
		return 0
	end
	return countKeys(cosmetics.Owned, Config.CosmeticsById)
end

-- `data` = données sauvegardées du joueur, `eventMultiplier` = Rush en cours (ou 1)
function Formulas.ComputeStats(data, eventMultiplier: number?)
	local baseClick = 1
	local basePerSecond = 0
	local clickMultiplier = 1
	local bounceMultiplier = 1
	local upgradeMultiplier = 1
	local dvdCount = 0

	for _, upgrade in ipairs(Config.Upgrades) do
		local level = Formulas.GetLevel(data, upgrade.Id)
		if level > 0 then
			local effect = upgrade.Effect
			if effect == "Click" then
				baseClick += upgrade.Value * level
			elseif effect == "PerSecond" then
				basePerSecond += upgrade.Value * level
			elseif effect == "DVD" then
				dvdCount += level
			elseif effect == "BounceMultiplier" then
				bounceMultiplier *= upgrade.Value ^ level
			elseif effect == "ClickMultiplier" then
				clickMultiplier *= upgrade.Value ^ level
			elseif effect == "Multiplier" then
				upgradeMultiplier *= upgrade.Value ^ level
			end
		end
	end

	local rebirthMultiplier = Formulas.GetRebirthMultiplier(data.Rebirths)
	local achievementMultiplier = 1 + Formulas.CountAchievements(data) * Config.AchievementBonus
	local cosmeticMultiplier = 1 + Formulas.CountCosmetics(data) * Config.CosmeticBonus
	local eventMult = eventMultiplier or 1
	local globalMultiplier = upgradeMultiplier * rebirthMultiplier * achievementMultiplier * cosmeticMultiplier * eventMult

	return {
		BaseClick = baseClick,
		BasePerSecond = basePerSecond,
		ClickMultiplier = clickMultiplier,
		BounceMultiplier = bounceMultiplier,
		UpgradeMultiplier = upgradeMultiplier,
		RebirthMultiplier = rebirthMultiplier,
		AchievementMultiplier = achievementMultiplier,
		CosmeticMultiplier = cosmeticMultiplier,
		EventMultiplier = eventMult,
		GlobalMultiplier = globalMultiplier,
		ClickValue = baseClick * clickMultiplier * globalMultiplier,
		PerSecond = basePerSecond * globalMultiplier,
		BounceValue = Config.DVD.BaseBounceValue * bounceMultiplier * globalMultiplier,
		DVDCount = dvdCount,
	}
end

-- Récompense qui vaut `seconds` secondes de production (au moins `minimum`)
function Formulas.ScaledReward(stats, seconds: number, minimum: number): number
	local production = stats.PerSecond + stats.ClickValue * Config.Rewards.EstimatedClicksPerSecond
	return math.floor(math.max(minimum, production * seconds))
end

----------------------------------------------------------------------
-- Casino
----------------------------------------------------------------------

-- Multiplicateur de gain pour 3 symboles (ids). 0 = perdu.
function Formulas.GetCasinoMultiplier(reels: { string }): number
	local counts = {}
	for _, id in ipairs(reels) do
		counts[id] = (counts[id] or 0) + 1
	end
	local best = 0
	for id, count in pairs(counts) do
		local symbol = Config.CasinoSymbolsById[id]
		if symbol then
			if count == 3 then
				best = math.max(best, symbol.Triple)
			elseif count == 2 then
				best = math.max(best, symbol.Pair)
			end
		end
	end
	return best
end

-- Taux de retour théorique (ex. 0.93 = on récupère 93 % des mises en moyenne)
function Formulas.GetCasinoRTP(): number
	local symbols = Config.Casino.Symbols
	local totalWeight = 0
	for _, symbol in ipairs(symbols) do
		totalWeight += symbol.Weight
	end
	local expected = 0
	for _, a in ipairs(symbols) do
		for _, b in ipairs(symbols) do
			for _, c in ipairs(symbols) do
				local probability = (a.Weight / totalWeight) * (b.Weight / totalWeight) * (c.Weight / totalWeight)
				expected += probability * Formulas.GetCasinoMultiplier({ a.Id, b.Id, c.Id })
			end
		end
	end
	return expected
end

----------------------------------------------------------------------
-- Bourse
----------------------------------------------------------------------

function Formulas.GetStockValue(stock, price: number): number
	return (stock and stock.Shares or 0) * price
end

return Formulas
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--[[
	Net (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > Net

	Centralise les RemoteEvents / RemoteFunctions.
	- Le SERVEUR appelle Net.Setup() au démarrage : il crée automatiquement le
	  dossier ReplicatedStorage > Remotes et tous les remotes listés ci-dessous.
	  => Tu n'as RIEN à créer à la main.
	- Le CLIENT utilise Net.Event("Nom") / Net.Function("Nom") qui attendent
	  que le remote existe.

	Sens de communication :
	  C -> S : le client DEMANDE, le serveur valide TOUT.
	  S -> C : le serveur informe le client.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

Net.Events = {
	"ClientReady", -- C -> S () : l'interface est prête, envoie-moi tout
	"Click", -- C -> S () : un clic sur le bouton
	"StateUpdate", -- S -> C (state) : état complet du joueur
	"Notify", -- S -> C (payload) : succès, quêtes, bonus, jackpot, détox...
	"DVDSetup", -- S -> C ({ Logos = { params... } }) : trajectoires des logos DVD
	"DVDResize", -- C -> S (w, h) : taille d'un logo à l'écran (fraction de l'écran)
	"DVDClick", -- C -> S (index) : clic sur le logo numéro `index`
	"DVDCorner", -- C -> S (index, k) : le logo `index` a touché un coin au rebond k
	"Spawn", -- S -> C (info) : un objet à cliquer apparaît (étoile, éclair, notif, mail)
	"SpawnClick", -- C -> S (id) : le joueur a cliqué cet objet
	"Interact", -- C -> S (kind, arg) : papier bulle, moulin, titre du fil d'actu, presse
	"EventUpdate", -- S -> C (rush) : début / fin d'un Dopamine Rush
	"LeaderboardUpdate", -- S -> C (top) : top du classement
	"StockUpdate", -- S -> C ({ Symbol, Price, History }) : cours de la bourse
}

Net.Functions = {
	"BuyUpgrade", -- C -> S (upgradeId) -> (succès, message)
	"ClaimDaily", -- C -> S () -> (succès, message)
	"SetSetting", -- C -> S (nom, valeur) -> succès
	"StockTrade", -- C -> S ("buy" | "sell", fraction) -> (succès, message)
	"CasinoSpin", -- C -> S (fraction) -> (succès, résultat | message)
	"OpenChest", -- C -> S () -> (succès, résultat | message)
	"ItemShop", -- C -> S ("buy" | "equip" | "unequip", cosmeticId) -> (succès, message)
}

local FOLDER_NAME = "Remotes"

-- Serveur uniquement : crée tous les remotes
function Net.Setup()
	assert(RunService:IsServer(), "Net.Setup() doit être appelé par le serveur")

	local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = FOLDER_NAME
		folder.Parent = ReplicatedStorage
	end

	for _, name in ipairs(Net.Events) do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end

	for _, name in ipairs(Net.Functions) do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = folder
		end
	end
end

local function getFolder(): Instance
	return ReplicatedStorage:WaitForChild(FOLDER_NAME)
end

function Net.Event(name: string): RemoteEvent
	return getFolder():WaitForChild(name) :: RemoteEvent
end

function Net.Function(name: string): RemoteFunction
	return getFolder():WaitForChild(name) :: RemoteFunction
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="51">
        <Properties>
          <string name="Name">NumberFormatter</string>
          <string name="Source"><![CDATA[--[[
	NumberFormatter (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > NumberFormatter

	Formate les grands nombres : 1 234 -> "1.23K", 5 600 000 -> "5.6M", etc.
]]

local NumberFormatter = {}

-- Suffixes : K = mille, M = million, B = milliard, T = billion, puis notation anglaise courte
local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc", "UDc", "DDc", "TDc", "QaDc", "QiDc", "SxDc", "SpDc", "OcDc", "NoDc", "Vg" }

-- Retire les zéros inutiles : "1.50" -> "1.5", "2.00" -> "2"
local function trimZeros(text: string): string
	if string.find(text, "%.") then
		text = string.gsub(text, "0+$", "")
		text = string.gsub(text, "%.$", "")
	end
	return text
end

-- Format court avec suffixe (ex. 1.23M)
function NumberFormatter.Format(value: number, decimals: number?): string
	decimals = decimals or 2
	if value ~= value then
		return "0" -- NaN
	end
	if value == math.huge then
		return "∞"
	end

	local sign = value < 0 and "-" or ""
	value = math.abs(value)

	if value < 1000 then
		-- Petits nombres : entier, ou une décimale si < 10 (ex. 2.5)
		if value < 10 and value % 1 ~= 0 then
			return sign .. trimZeros(string.format("%.1f", math.floor(value * 10) / 10))
		end
		return sign .. tostring(math.floor(value))
	end

	local tier = math.floor(math.log10(value) / 3)
	-- Corrige les petites erreurs d'arrondi de log10 (ex. 999.999...)
	if value / (10 ^ (tier * 3)) >= 1000 then
		tier += 1
	elseif value / (10 ^ (tier * 3)) < 1 then
		tier -= 1
	end
	if tier >= #SUFFIXES then
		-- Au-delà des suffixes connus : notation scientifique
		return sign .. string.format("%.2e", value)
	end

	local scaled = value / (10 ^ (tier * 3))
	-- On tronque (au lieu d'arrondir) pour ne jamais afficher plus que ce qu'on a
	local factor = 10 ^ (decimals :: number)
	-- (petite marge : 1e29 / 1e27 donne 99.9999999 en virgule flottante)
	scaled = math.floor(scaled * factor + 1e-6) / factor
	return sign .. trimZeros(string.format("%." .. tostring(decimals) .. "f", scaled)) .. SUFFIXES[tier + 1]
end

-- Format avec séparateurs de milliers (ex. 1 234 567), pour les petits nombres
function NumberFormatter.WithSpaces(value: number): string
	local text = tostring(math.floor(value))
	local result = string.reverse(text)
	result = string.gsub(result, "(%d%d%d)", "%1 ")
	result = string.reverse(result)
	return (string.gsub(result, "^%s+", ""))
end

-- Durée en secondes -> "1h 05m", "4m 12s", "9s"
function NumberFormatter.Time(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then
		return string.format("%dh %02dm", h, m)
	elseif m > 0 then
		return string.format("%dm %02ds", m, s)
	end
	return string.format("%ds", s)
end

-- Multiplicateur lisible : 2 -> "x2", 1.5 -> "x1.5"
function NumberFormatter.Multiplier(value: number): string
	if value >= 1000 then
		return "x" .. NumberFormatter.Format(value)
	end
	return "x" .. trimZeros(string.format("%.2f", value))
end

return NumberFormatter
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="52">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[--[[
	Signal (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > Signal

	Petit système d'événements (comme un BindableEvent, mais sans copier les
	tables passées en argument). Utilisé côté client pour prévenir l'interface
	qu'un nouvel état est arrivé.
]]

local Signal = {}
Signal.__index = Signal

export type Connection = { Disconnect: (self: Connection) -> () }

function Signal.new()
	return setmetatable({ _listeners = {} }, Signal)
end

-- Ajoute une fonction appelée à chaque :Fire(...)
function Signal:Connect(callback: (...any) -> ())
	local listeners = self._listeners
	local entry = { Callback = callback }
	table.insert(listeners, entry)

	return {
		Disconnect = function()
			local index = table.find(listeners, entry)
			if index then
				table.remove(listeners, index)
			end
		end,
	}
end

-- Appelle toutes les fonctions connectées (chacune dans son propre thread)
function Signal:Fire(...)
	for _, entry in ipairs(table.clone(self._listeners)) do
		task.spawn(entry.Callback, ...)
	end
end

return Signal
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="53">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="54">
      <Properties>
        <string name="Name">Main</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	Main (Script)
	Emplacement : ServerScriptService > Main

	Point d'entrée du serveur :
	  1. crée les RemoteEvents / RemoteFunctions (Net.Setup) ;
	  2. initialise puis démarre tous les services ;
	  3. gère l'arrivée et le départ des joueurs.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
Net.Setup() -- AVANT tout le reste : les clients attendent ces remotes

local ServicesFolder = script.Parent:WaitForChild("Services")

-- Ordre important : les données d'abord, puis le jeu, puis le reste
-- (PlayerReady est appelé dans cet ordre : QuestService a besoin des stats,
-- DVDService crée les logos avant la synchro complète)
local ORDER = {
	"DataService",
	"GameService",
	"EventService",
	"DVDService",
	"InteractService",
	"StockService",
	"CasinoService",
	"LootService",
	"CosmeticService",
	"QuestService",
	"AchievementService",
	"DailyRewardService",
	"LeaderboardService",
	"DebugService",
}

local services = {}
for _, name in ipairs(ORDER) do
	services[name] = require(ServicesFolder:WaitForChild(name))
end

-- Init : chaque service reçoit la liste des autres (évite les require circulaires)
for _, name in ipairs(ORDER) do
	local service = services[name]
	if service.Init then
		service:Init(services)
	end
end

for _, name in ipairs(ORDER) do
	local service = services[name]
	if service.Start then
		service:Start()
	end
end

----------------------------------------------------------------------
-- Joueurs
----------------------------------------------------------------------

local function onPlayerAdded(player: Player)
	local data = services.DataService:LoadAsync(player)
	if not data or not player.Parent then
		return
	end

	for _, name in ipairs(ORDER) do
		local service = services[name]
		if service.PlayerReady then
			local ok, err = pcall(service.PlayerReady, service, player, data)
			if not ok then
				warn("[Main] Erreur PlayerReady dans " .. name .. " :", err)
			end
		end
	end

	services.GameService:SendFullSync(player)
end

local function onPlayerRemoving(player: Player)
	for _, name in ipairs(ORDER) do
		local service = services[name]
		if service.PlayerRemoving then
			local ok, err = pcall(service.PlayerRemoving, service, player)
			if not ok then
				warn("[Main] Erreur PlayerRemoving dans " .. name .. " :", err)
			end
		end
	end
	services.DataService:ReleaseAsync(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)

-- Joueurs déjà présents (arrive parfois dans Studio)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="55">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="ModuleScript" referent="56">
        <Properties>
          <string name="Name">AchievementService</string>
          <string name="Source"><![CDATA[--[[
	AchievementService (ModuleScript)
	Emplacement : ServerScriptService > Services > AchievementService

	Vérifie les succès (définis dans Config.Achievements) et donne les
	récompenses. Appelé automatiquement par GameService quand l'état change.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)

local AchievementService = {}

local services

function AchievementService:Init(allServices)
	services = allServices
end

-- Valeur actuelle d'une statistique (dans data.Stats, ou à la racine comme Rebirths)
function AchievementService:GetStatValue(data, statName: string): number
	local value = data.Stats[statName]
	if value == nil then
		value = data[statName]
	end
	return (type(value) == "number") and value or 0
end

function AchievementService:Check(player: Player)
	local data = services.DataService:GetData(player)
	if not data then
		return
	end

	for _, achievement in ipairs(Config.Achievements) do
		if not data.Achievements[achievement.Id] then
			local value = self:GetStatValue(data, achievement.Stat)
			if value >= achievement.Goal then
				data.Achievements[achievement.Id] = true
				services.GameService:AddDopamine(player, achievement.Reward, false)
				services.GameService:Notify(player, {
					Type = "Achievement",
					Icon = achievement.Icon,
					Title = "SUCCÈS DÉBLOQUÉ !",
					Text = achievement.Icon .. " " .. achievement.Name .. "  (+" .. NumberFormatter.Format(achievement.Reward) .. ")",
				})
			end
		end
	end
end

return AchievementService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="57">
        <Properties>
          <string name="Name">CasinoService</string>
          <string name="Source"><![CDATA[--[[
	CasinoService (ModuleScript)
	Emplacement : ServerScriptService > Services > CasinoService

	Machine à sous (débloquée par l'amélioration "Machine à sous").
	UNIQUEMENT avec la Dopamine du jeu (jamais de Robux).
	Le SERVEUR tire les 3 symboles (selon leur poids dans Config.Casino) et
	calcule le gain avec Formulas.GetCasinoMultiplier : le client ne fait
	qu'afficher l'animation puis le résultat reçu.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Net = require(ReplicatedStorage.Shared.Net)
local RateLimiter = require(script.Parent.RateLimiter)

local CasinoService = {}

local services
local random = Random.new()
local settings = Config.Casino

local BIG_WIN_MULTIPLIER = 25 -- à partir de ce multiplicateur, tout le serveur est prévenu

function CasinoService:Init(allServices)
	services = allServices
end

-- Tire un symbole au hasard selon son poids
local function pickSymbol(): string
	local total = 0
	for _, symbol in ipairs(settings.Symbols) do
		total += symbol.Weight
	end
	local roll = random:NextNumber(0, total)
	for _, symbol in ipairs(settings.Symbols) do
		roll -= symbol.Weight
		if roll <= 0 then
			return symbol.Id
		end
	end
	return settings.Symbols[#settings.Symbols].Id
end

local function isAllowedFraction(fraction: any): boolean
	if type(fraction) ~= "number" or fraction ~= fraction then
		return false
	end
	for _, allowed in ipairs(settings.BetFractions) do
		if math.abs(allowed - fraction) < 1e-9 then
			return true
		end
	end
	return false
end

local function onSpin(player: Player, fraction: any)
	local data = services.DataService:GetData(player)
	if not data or not services.GameService:IsReady(player) then
		return false, "Chargement en cours..."
	end
	if not settings.Enabled then
		return false, "Le casino est fermé"
	end
	if not Formulas.HasFeature(data, settings.Feature) then
		return false, "La machine à sous n'est pas encore débloquée"
	end
	if not isAllowedFraction(fraction) then
		return false, "Mise invalide"
	end
	-- Petite marge pour la latence réseau
	if not RateLimiter.Check(player, "CasinoSpin", math.max(0, settings.Cooldown - 0.1)) then
		return false, "La machine tourne encore..."
	end

	local bet = math.max(settings.MinBet, math.floor(data.Dopamine * fraction))
	if bet > data.Dopamine then
		return false, "Il faut au moins " .. NumberFormatter.Format(settings.MinBet) .. " " .. Config.Game.CurrencyName
	end

	local reels = { pickSymbol(), pickSymbol(), pickSymbol() }
	local multiplier = Formulas.GetCasinoMultiplier(reels)
	local payout = math.floor(bet * multiplier)

	local maxValue = Config.Game.MaxDopamine
	data.Dopamine = math.min(maxValue, data.Dopamine - bet + payout)
	data.Stats.SlotSpins += 1
	if payout > bet then
		data.Stats.SlotWins += 1
		data.Stats.LifetimeDopamine = math.min(maxValue, data.Stats.LifetimeDopamine + (payout - bet))
	end
	services.QuestService:Progress(player, "Casino", 1)
	services.GameService:SendState(player)

	if multiplier >= BIG_WIN_MULTIPLIER then
		services.GameService:NotifyAll({
			Type = "Info",
			Text = "🎰 " .. player.DisplayName .. " a gagné x" .. multiplier .. " à la machine à sous !",
		}, player)
	end

	return true, {
		Reels = reels,
		Bet = bet,
		Payout = payout,
		Multiplier = multiplier,
	}
end

function CasinoService:Start()
	Net.Function("CasinoSpin").OnServerInvoke = onSpin
end

return CasinoService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="58">
        <Properties>
          <string name="Name">CosmeticService</string>
          <string name="Source"><![CDATA[--[[
	CosmeticService (ModuleScript)
	Emplacement : ServerScriptService > Services > CosmeticService

	Boutique d'objets (débloquée par l'amélioration "Boutique d'objets") :
	chapeaux (emoji posé sur le bouton) et skins (couleurs du bouton).
	Les objets achetés sont gardés pour toujours et donnent chacun un petit
	bonus de gains permanent (Config.CosmeticBonus).
	RemoteFunction ItemShop ("buy" | "equip" | "unequip", cosmeticId).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Net = require(ReplicatedStorage.Shared.Net)
local RateLimiter = require(script.Parent.RateLimiter)

local CosmeticService = {}

local services

function CosmeticService:Init(allServices)
	services = allServices
end

local function onItemShop(player: Player, action: any, cosmeticId: any)
	if not RateLimiter.Check(player, "ItemShop", 0.2) then
		return false, "Doucement !"
	end
	local data = services.DataService:GetData(player)
	if not data or not services.GameService:IsReady(player) then
		return false, "Chargement en cours..."
	end
	if not Formulas.HasFeature(data, "ItemShop") then
		return false, "La boutique n'est pas encore débloquée"
	end
	if type(action) ~= "string" or type(cosmeticId) ~= "string" or #cosmeticId > 64 then
		return false, "Requête invalide"
	end
	local cosmetic = Config.CosmeticsById[cosmeticId]
	if not cosmetic then
		return false, "Objet inconnu"
	end

	local cosmetics = data.Cosmetics
	local slot = cosmetic.Slot
	if slot ~= "Hat" and slot ~= "Skin" then
		return false, "Objet invalide"
	end

	if action == "buy" then
		if cosmetics.Owned[cosmeticId] then
			return false, "Tu as déjà cet objet"
		end
		if data.Dopamine < cosmetic.Cost then
			return false, "Pas assez de " .. Config.Game.CurrencyName
		end
		data.Dopamine -= cosmetic.Cost
		cosmetics.Owned[cosmeticId] = true
		cosmetics.Equipped[slot] = cosmeticId -- équipé tout de suite
		data.Stats.CosmeticsBought += 1
		services.GameService:SendState(player)
		return true, string.format("%s %s acheté ! (%s)", cosmetic.Icon, cosmetic.Name, NumberFormatter.Format(cosmetic.Cost))
	elseif action == "equip" then
		if not cosmetics.Owned[cosmeticId] then
			return false, "Tu ne possèdes pas cet objet"
		end
		cosmetics.Equipped[slot] = cosmeticId
		services.GameService:SendState(player)
		return true, cosmetic.Icon .. " " .. cosmetic.Name .. " équipé"
	elseif action == "unequip" then
		cosmetics.Equipped[slot] = ""
		services.GameService:SendState(player)
		return true, cosmetic.Icon .. " " .. cosmetic.Name .. " retiré"
	end
	return false, "Requête invalide"
end

function CosmeticService:Start()
	Net.Function("ItemShop").OnServerInvoke = onItemShop
end

return CosmeticService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="59">
        <Properties>
          <string name="Name">DVDService</string>
          <string name="Source"><![CDATA[--[[
	DVDService (ModuleScript)
	Emplacement : ServerScriptService > Services > DVDService

	Logos DVD rebondissants (un par niveau de l'amélioration "Logo DVD").
	Le SERVEUR choisit la trajectoire de chaque logo (position, vitesse, heure
	de départ) et l'envoie au client, qui ne fait que l'afficher. Comme les
	trajectoires sont déterministes (voir DVDMath), le serveur peut :
	  - compter lui-même les rebonds (gain passif à chaque rebond) ;
	  - vérifier si un coin a vraiment été touché : un tricheur ne peut pas
	    inventer de jackpot.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DVDMath = require(ReplicatedStorage.Shared.DVDMath)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Net = require(ReplicatedStorage.Shared.Net)
local RateLimiter = require(script.Parent.RateLimiter)

local DVDService = {}

local services
local random = Random.new()

-- Taille par défaut d'un logo (fraction de l'écran), corrigée dès que le
-- client envoie la vraie taille (DVDResize)
local DEFAULT_W = Config.DVD.LogoSize.X / 1280
local DEFAULT_H = Config.DVD.LogoSize.Y / 720

--[[
	[Player] = {
		Logos = { { Params, ClaimedCorners = { [k] = true }, LastBX, LastBY } },
		W, H = taille commune des logos,
		Carry = rebonds pas encore comptés (avant un changement de trajectoire),
		LastClick = os.clock() du dernier clic récompensé (recharge commune),
	}
]]
local states = {}

function DVDService:Init(allServices)
	services = allServices
end

local function now(): number
	return workspace:GetServerTimeNow()
end

-- Nouvelle trajectoire aléatoire (angle entre 25° et 65° pour éviter les
-- trajectoires trop horizontales ou verticales)
local function randomParams(w: number, h: number): DVDMath.Params
	local angle = math.rad(random:NextNumber(25, 65))
	local variation = Config.DVD.SpeedVariation or 0
	local speed = Config.DVD.Speed * (1 + random:NextNumber(-variation, variation))
	local signX = random:NextNumber() < 0.5 and -1 or 1
	local signY = random:NextNumber() < 0.5 and -1 or 1
	return {
		X0 = random:NextNumber(0, math.max(0, 1 - w)),
		Y0 = random:NextNumber(0, math.max(0, 1 - h)),
		VX = math.cos(angle) * speed * signX,
		VY = math.sin(angle) * speed * signY,
		T0 = now(),
		W = w,
		H = h,
	}
end

-- (Re)définit la trajectoire d'un logo en repartant les compteurs de rebonds
local function setParams(logo, params: DVDMath.Params)
	logo.Params = params
	logo.ClaimedCorners = {} -- nouvelle trajectoire = nouveaux numéros de rebond
	logo.LastBX, logo.LastBY = DVDMath.BounceIndex(params, now())
end

local function newLogo(w: number, h: number)
	local logo = {}
	setParams(logo, randomParams(w, h))
	return logo
end

-- Rebonds d'un logo depuis le dernier comptage (plafonnés)
local function countBounces(logo, t: number): number
	local bx, by = DVDMath.BounceIndex(logo.Params, t)
	local count = math.abs(bx - logo.LastBX) + math.abs(by - logo.LastBY)
	logo.LastBX, logo.LastBY = bx, by
	if count ~= count then
		return 0
	end
	return math.min(count, Config.DVD.MaxBouncesPerTick)
end

-- Avant de changer une trajectoire : on met de côté les rebonds pas encore comptés
local function flushBounces(state)
	local t = now()
	for _, logo in ipairs(state.Logos) do
		state.Carry += countBounces(logo, t)
	end
	state.Carry = math.min(state.Carry, Config.DVD.MaxBouncesPerTick * math.max(1, #state.Logos))
end

-- Nombre de logos que le joueur doit avoir (niveau de "Logo DVD")
local function desiredCount(player: Player): number
	local data = services.DataService:GetData(player)
	if not data then
		return 0
	end
	return Formulas.ComputeStats(data).DVDCount
end

local function isValidIndex(state, index: any): boolean
	return type(index) == "number" and index == math.floor(index) and index >= 1 and index <= #state.Logos
end

----------------------------------------------------------------------
-- API
----------------------------------------------------------------------

function DVDService:SendSetup(player: Player)
	local state = states[player]
	if not state then
		return
	end
	local list = {}
	for _, logo in ipairs(state.Logos) do
		local p = logo.Params
		table.insert(list, { X0 = p.X0, Y0 = p.Y0, VX = p.VX, VY = p.VY, T0 = p.T0, W = p.W, H = p.H })
	end
	Net.Event("DVDSetup"):FireClient(player, { Logos = list })
end

-- Ajoute / retire des logos pour correspondre au niveau de l'amélioration.
-- Les logos existants gardent leur trajectoire. Renvoie true si ça a changé.
function DVDService:SyncLogos(player: Player): boolean
	local state = states[player]
	if not state then
		return false
	end
	local wanted = desiredCount(player)
	local logos = state.Logos
	if #logos == wanted then
		return false
	end
	flushBounces(state)
	while #logos < wanted do
		table.insert(logos, newLogo(state.W, state.H))
	end
	while #logos > wanted do
		table.remove(logos)
	end
	self:SendSetup(player)
	return true
end

-- Détox / reset : tous les logos disparaissent (puis on recrée ceux encore dus)
function DVDService:Reset(player: Player)
	local state = states[player]
	if not state then
		return
	end
	state.Logos = {}
	state.Carry = 0
	state.LastClick = 0
	if not self:SyncLogos(player) then
		self:SendSetup(player) -- toujours prévenir le client (liste vide)
	end
end

-- Appelé par le tick passif de GameService : nombre total de rebonds
-- (tous les logos, horizontaux + verticaux) depuis le dernier appel
function DVDService:CollectBounces(player: Player, t: number): number
	local state = states[player]
	if not state then
		return 0
	end
	local total = state.Carry
	state.Carry = 0
	for _, logo in ipairs(state.Logos) do
		total += countBounces(logo, t)
	end
	return total
end

function DVDService:PlayerReady(player: Player)
	states[player] = {
		Logos = {},
		W = DEFAULT_W,
		H = DEFAULT_H,
		Carry = 0,
		LastClick = 0,
		PendingResize = nil, -- taille reçue trop tôt, appliquée plus tard
		ResizeScheduled = false,
	}
	-- Crée les logos déjà achetés (le client recevra DVDSetup avec la synchro complète)
	local wanted = desiredCount(player)
	for _ = 1, wanted do
		table.insert(states[player].Logos, newLogo(DEFAULT_W, DEFAULT_H))
	end
end

function DVDService:PlayerRemoving(player: Player)
	states[player] = nil
end

----------------------------------------------------------------------
-- Remotes
----------------------------------------------------------------------

-- Applique une nouvelle taille à tous les logos en gardant la position et
-- la direction actuelles de chacun (pour qu'aucun logo ne "saute")
local function applyResize(player: Player, state, w: number, h: number)
	if math.abs(w - state.W) < 1e-4 and math.abs(h - state.H) < 1e-4 then
		return -- rien ne change
	end
	flushBounces(state)
	state.W, state.H = w, h
	local t = now()
	for _, logo in ipairs(state.Logos) do
		local params = logo.Params
		local x, y = DVDMath.Position(params, t)
		local dirX, dirY = DVDMath.Directions(params, t)
		setParams(logo, {
			X0 = math.clamp(x, 0, math.max(0, 1 - w)),
			Y0 = math.clamp(y, 0, math.max(0, 1 - h)),
			VX = math.abs(params.VX) * dirX,
			VY = math.abs(params.VY) * dirY,
			T0 = t,
			W = w,
			H = h,
		})
	end
	DVDService:SendSetup(player)
end

-- Le client indique la taille d'un logo à l'écran (en fraction de l'écran).
-- Trop rapproché (< 0.5 s) : la dernière taille reçue est appliquée un peu plus tard.
local function onResize(player: Player, w: any, h: any)
	local state = states[player]
	if not state then
		return
	end
	if type(w) ~= "number" or type(h) ~= "number" or w ~= w or h ~= h then
		return
	end
	w = math.clamp(w, 0.03, 0.5)
	h = math.clamp(h, 0.03, 0.5)

	if RateLimiter.Check(player, "DVDResize", 0.5) then
		state.PendingResize = nil
		applyResize(player, state, w, h)
		return
	end
	state.PendingResize = { W = w, H = h }
	if state.ResizeScheduled then
		return
	end
	state.ResizeScheduled = true
	task.delay(0.55, function()
		state.ResizeScheduled = false
		local pending = state.PendingResize
		state.PendingResize = nil
		-- Le joueur a pu partir (ou tout a été réinitialisé) entre-temps
		if pending and states[player] == state then
			applyResize(player, state, pending.W, pending.H)
		end
	end)
end

-- Clic sur un logo : petit bonus, avec un temps de recharge commun à tous les logos
local function onClick(player: Player, index: any)
	local state = states[player]
	local data = services.DataService:GetData(player)
	if not state or not data or not isValidIndex(state, index) then
		return
	end
	local clock = os.clock()
	-- 0.3 s de tolérance pour la latence
	if clock - state.LastClick < Config.DVD.ClickCooldown - 0.3 then
		return
	end
	state.LastClick = clock

	local reward = Formulas.ScaledReward(
		services.GameService:GetStats(player),
		Config.DVD.ClickRewardSeconds,
		Config.DVD.ClickMinReward
	)
	data.Stats.DVDClicks += 1
	services.GameService:AddDopamine(player, reward, true)
	services.GameService:Notify(player, {
		Type = "Bonus",
		Source = "DVD",
		Amount = reward,
		Index = index,
	})
end

-- Le client signale un coin du logo `index` au rebond horizontal numéro k : on VÉRIFIE
local function onCorner(player: Player, index: any, k: any)
	local state = states[player]
	local data = services.DataService:GetData(player)
	if not state or not data or not isValidIndex(state, index) then
		return
	end
	if type(k) ~= "number" or k ~= math.floor(k) or math.abs(k) > 1e9 then
		return
	end
	if not RateLimiter.Check(player, "DVDCorner" .. index, 0.3) then
		return
	end
	local logo = state.Logos[index]
	if logo.ClaimedCorners[k] then
		return -- déjà récompensé
	end

	local params = logo.Params
	local bounceTime = DVDMath.BounceTimeX(params, k)
	local t = now()
	-- Le rebond doit avoir eu lieu récemment (et après le début de la trajectoire)
	if bounceTime ~= bounceTime or bounceTime < params.T0 or bounceTime > t + 0.5 or bounceTime < t - 5 then
		return
	end
	if not DVDMath.IsCornerAtBounceX(params, k, Config.DVD.CornerTolerance) then
		return -- pas un vrai coin : tentative de triche ou erreur d'arrondi
	end

	logo.ClaimedCorners[k] = true
	local reward = Formulas.ScaledReward(
		services.GameService:GetStats(player),
		Config.DVD.JackpotRewardSeconds,
		Config.DVD.JackpotMinReward
	)
	data.Stats.DVDCorners += 1
	services.GameService:AddDopamine(player, reward, true)
	services.GameService:Notify(player, {
		Type = "Jackpot",
		Amount = reward,
		Index = index,
		Text = "📀 COIN PARFAIT ! +" .. NumberFormatter.Format(reward),
	})
	services.GameService:NotifyAll({
		Type = "Info",
		Text = "📀 " .. player.DisplayName .. " a touché le COIN PARFAIT !",
	}, player)
end

-- TEST (Studio) : place le 1er logo pour qu'il touche un coin dans ~2 secondes
function DVDService:DebugCorner(player: Player): boolean
	local state = states[player]
	if not state or #state.Logos == 0 then
		return false
	end
	flushBounces(state)
	local logo = state.Logos[1]
	local params = logo.Params
	local rangeX, rangeY = DVDMath.Ranges(params)
	local speedX, speedY = math.abs(params.VX), math.abs(params.VY)
	local delay = math.min(2, rangeX * 0.9 / speedX, rangeY * 0.9 / speedY)
	setParams(logo, {
		X0 = rangeX - speedX * delay,
		Y0 = rangeY - speedY * delay,
		VX = speedX,
		VY = speedY,
		T0 = now(),
		W = params.W,
		H = params.H,
	})
	self:SendSetup(player)
	return true
end

function DVDService:Start()
	Net.Event("DVDResize").OnServerEvent:Connect(onResize)
	Net.Event("DVDClick").OnServerEvent:Connect(onClick)
	Net.Event("DVDCorner").OnServerEvent:Connect(onCorner)
end

return DVDService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="60">
        <Properties>
          <string name="Name">DailyRewardService</string>
          <string name="Source"><![CDATA[--[[
	DailyRewardService (ModuleScript)
	Emplacement : ServerScriptService > Services > DailyRewardService

	Récompense quotidienne : 1 fois par jour (jour UTC). Revenir le jour
	suivant augmente la série (streak) et donc la récompense.
	L'heure utilisée est celle du SERVEUR (impossible à tricher en changeant
	l'heure de son PC). Nécessite la Feature "Daily" (amélioration "Calendrier").
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Net = require(ReplicatedStorage.Shared.Net)
local RateLimiter = require(script.Parent.RateLimiter)

local DailyRewardService = {}

local services
local SECONDS_PER_DAY = 86400

function DailyRewardService:Init(allServices)
	services = allServices
end

local function today(): number
	return math.floor(os.time() / SECONDS_PER_DAY)
end

-- Série qu'aurait le joueur s'il réclamait maintenant
local function nextStreak(data): number
	if data.Daily.LastDay == today() - 1 then
		return data.Daily.Streak + 1
	end
	return 1
end

local function computeReward(stats, streak: number): number
	local bonusDays = math.min(streak, Config.Daily.MaxStreakBonus) - 1
	local seconds = Config.Daily.BaseRewardSeconds + bonusDays * Config.Daily.StreakBonusSeconds
	return Formulas.ScaledReward(stats, seconds, Config.Daily.MinReward * math.min(streak, Config.Daily.MaxStreakBonus))
end

-- Infos affichées par le client
function DailyRewardService:GetInfo(player: Player, stats)
	local data = services.DataService:GetData(player)
	local available = data.Daily.LastDay < today()
	local streak = available and nextStreak(data) or data.Daily.Streak
	return {
		Available = available,
		Streak = streak,
		Reward = computeReward(stats, streak),
		-- secondes avant le prochain jour UTC
		NextIn = (today() + 1) * SECONDS_PER_DAY - os.time(),
	}
end

local function onClaim(player: Player)
	if not RateLimiter.Check(player, "Daily", 1) then
		return false, "Doucement !"
	end
	local data = services.DataService:GetData(player)
	if not data or not services.GameService:IsReady(player) then
		return false, "Chargement en cours..."
	end
	if not Formulas.HasFeature(data, "Daily") then
		return false, "Le calendrier n'est pas encore débloqué"
	end
	if data.Daily.LastDay >= today() then
		return false, "Déjà récupéré aujourd'hui, reviens demain !"
	end

	local streak = nextStreak(data)
	local reward = computeReward(services.GameService:GetStats(player), streak)

	data.Daily.LastDay = today()
	data.Daily.Streak = streak
	data.Stats.DailyClaims += 1
	services.GameService:AddDopamine(player, reward, false)
	services.GameService:SendState(player)

	return true, string.format("Jour %d : +%s %s !", streak, NumberFormatter.Format(reward), Config.Game.CurrencyName)
end

function DailyRewardService:Start()
	Net.Function("ClaimDaily").OnServerInvoke = onClaim
end

return DailyRewardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="61">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--[[
	DataService (ModuleScript)
	Emplacement : ServerScriptService > Services > DataService

	Chargement / sauvegarde des données des joueurs avec DataStoreService
	(format "version 2", magasin Config.DataStore.Name) :
	  - pcall + plusieurs tentatives (retry) avec attente croissante ;
	  - sauvegarde à la sortie du joueur, toutes les X secondes, et à la
	    fermeture du serveur (BindToClose) ;
	  - si le chargement échoue, on NE sauvegarde PAS (pour ne jamais écraser
	    une vraie sauvegarde avec des données vides).
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local DataService = {}

-- Profils chargés : [Player] = { Data = table, CanSave = bool, Saving = bool }
local profiles = {}

-- Données d'un nouveau joueur (version 2). Toute nouvelle clé ajoutée ici
-- sera automatiquement ajoutée aux anciennes sauvegardes (voir reconcile).
local TEMPLATE = {
	Version = 2,
	Dopamine = 0,
	Rebirths = 0,
	Upgrades = {}, -- [upgradeId] = niveau
	Achievements = {}, -- [achievementId] = true
	Quests = {}, -- liste des quêtes actives
	Daily = { LastDay = 0, Streak = 0 },
	Settings = { Sound = true, Music = true, Effects = true },
	Cosmetics = {
		Owned = {}, -- [cosmeticId] = true
		Equipped = { Hat = "", Skin = "" }, -- "" = rien d'équipé
	},
	Stock = { Shares = 0, CostBasis = 0 }, -- actions de la bourse
	Chests = { Stored = 0, Progress = 0 }, -- coffres mystère
	ScreenTime = {}, -- ["numéro du jour UTC"] = secondes jouées ce jour-là
	Stats = {
		TotalClicks = 0,
		LifetimeDopamine = 0, -- Dopamine gagnée depuis toujours (classement)
		UpgradesBought = 0,
		CombosMaxed = 0,
		DVDClicks = 0,
		DVDCorners = 0,
		Bounces = 0,
		GoldenClicks = 0,
		LightningClicks = 0,
		NotifsOpened = 0,
		EmailsRead = 0,
		BubblesPopped = 0,
		Spins = 0,
		HeadlinesClicked = 0,
		PressCrushes = 0,
		SlotSpins = 0,
		SlotWins = 0,
		StockTrades = 0,
		ChestsOpened = 0,
		CosmeticsBought = 0,
		QuestsCompleted = 0,
		DailyClaims = 0,
		PlaySeconds = 0,
	},
}

local services -- rempli par Init

local dataStore: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStore.Name)
	end)
	if ok then
		dataStore = result
	else
		warn("[DataService] DataStore indisponible (place non publiée ?) :", result)
	end
end

----------------------------------------------------------------------
-- Utilitaires
----------------------------------------------------------------------

local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for key, inner in pairs(value) do
		copy[key] = deepCopy(inner)
	end
	return copy
end

-- Ajoute les clés manquantes (nouvelle version du jeu) sans toucher aux
-- existantes. Une valeur du mauvais type (sauvegarde corrompue) est remplacée.
local function reconcile(data, template)
	for key, value in pairs(template) do
		local current = data[key]
		if current == nil or type(current) ~= type(value) or (type(value) == "number" and current ~= current) then
			data[key] = deepCopy(value)
		elseif type(value) == "table" and next(value) ~= nil then
			reconcile(current, value)
		end
	end
	return data
end

-- Erreurs pour lesquelles réessayer ne sert à rien (ex. Studio sans accès aux API)
local function isFatalError(message: string): boolean
	return string.find(message, "StudioAccessToApisNotAllowed", 1, true) ~= nil
		or string.find(message, "publish", 1, true) ~= nil
		or string.find(message, "403", 1, true) ~= nil
end

-- Exécute `callback` avec pcall et réessaie en cas d'échec
local function retry(description: string, callback: () -> any): (boolean, any)
	local lastError
	for attempt = 1, Config.DataStore.MaxRetries do
		local ok, result = pcall(callback)
		if ok then
			return true, result
		end
		lastError = result
		warn(string.format("[DataService] %s : échec (tentative %d) : %s", description, attempt, tostring(result)))
		if isFatalError(tostring(result)) then
			warn("[DataService] Active 'Enable Studio Access to API Services' (Game Settings > Security) et publie le jeu.")
			break
		end
		if attempt < Config.DataStore.MaxRetries then
			task.wait(2 ^ attempt) -- 2s, 4s, 8s...
		end
	end
	return false, lastError
end

local function keyFor(player: Player): string
	return "Player_" .. player.UserId
end

----------------------------------------------------------------------
-- API
----------------------------------------------------------------------

function DataService:Init(allServices)
	services = allServices
end

-- Charge les données d'un joueur (bloquant). Renvoie la table de données.
function DataService:LoadAsync(player: Player)
	local canSave = dataStore ~= nil
	local data

	if dataStore then
		local store = dataStore :: DataStore
		local ok, result = retry("Chargement de " .. player.Name, function()
			return store:GetAsync(keyFor(player))
		end)
		if ok then
			data = (type(result) == "table") and result or nil
		else
			-- Échec total : on joue avec des données vides mais sans sauvegarder
			canSave = false
		end
	end

	data = reconcile(data or deepCopy(TEMPLATE), TEMPLATE)
	data.Version = TEMPLATE.Version

	-- Le joueur a pu partir pendant le chargement
	if not player.Parent then
		return nil
	end

	profiles[player] = { Data = data, CanSave = canSave, Saving = false }

	if not canSave then
		task.defer(function()
			services.GameService:Notify(player, {
				Type = "Error",
				Text = "⚠️ Sauvegarde indisponible : ta progression ne sera pas enregistrée.",
			})
		end)
	end

	return data
end

function DataService:GetData(player: Player)
	local profile = profiles[player]
	return profile and profile.Data
end

function DataService:GetLoadedPlayers(): { Player }
	local list = {}
	for player in pairs(profiles) do
		table.insert(list, player)
	end
	return list
end

-- Remet les données d'un joueur à zéro (commande de test /reset), SAUF les
-- réglages. La table est vidée "sur place" : les autres services qui ont
-- gardé une référence vers elle restent valides.
function DataService:ResetData(player: Player): boolean
	local profile = profiles[player]
	if not profile then
		return false
	end
	local data = profile.Data
	local settings = deepCopy(data.Settings)
	for key in pairs(data) do
		data[key] = nil
	end
	for key, value in pairs(TEMPLATE) do
		data[key] = deepCopy(value)
	end
	if type(settings) == "table" then
		data.Settings = reconcile(settings, TEMPLATE.Settings)
	end
	return true
end

-- Sauvegarde les données d'un joueur (bloquant)
function DataService:SaveAsync(player: Player): boolean
	local profile = profiles[player]
	if not profile or not profile.CanSave or not dataStore then
		return false
	end
	if profile.Saving then
		return false -- une sauvegarde est déjà en cours
	end

	profile.Saving = true
	local data = profile.Data
	local store = dataStore :: DataStore
	local ok = retry("Sauvegarde de " .. player.Name, function()
		store:UpdateAsync(keyFor(player), function()
			return data
		end)
	end)
	profile.Saving = false
	return ok
end

-- Sauvegarde puis oublie le joueur (à la sortie)
function DataService:ReleaseAsync(player: Player)
	local profile = profiles[player]
	if not profile then
		return
	end
	-- Si une sauvegarde automatique est en cours, on attend qu'elle finisse
	local waited = 0
	while profile.Saving and waited < 10 do
		waited += task.wait(0.1)
	end
	self:SaveAsync(player)
	profiles[player] = nil
end

function DataService:Start()
	-- Sauvegarde périodique
	task.spawn(function()
		while true do
			task.wait(Config.DataStore.AutoSaveInterval)
			for player in pairs(profiles) do
				task.spawn(function()
					self:SaveAsync(player)
				end)
			end
		end
	end)

	-- Fermeture du serveur : on sauvegarde tout le monde en parallèle
	game:BindToClose(function()
		local pending = 0
		for _, player in ipairs(Players:GetPlayers()) do
			if profiles[player] then
				pending += 1
				task.spawn(function()
					self:ReleaseAsync(player)
					pending -= 1
				end)
			end
		end
		local start = os.clock()
		while pending > 0 and os.clock() - start < 25 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="62">
        <Properties>
          <string name="Name">DebugService</string>
          <string name="Source"><![CDATA[--[[
	DebugService (ModuleScript)
	Emplacement : ServerScriptService > Services > DebugService

	Commandes de TEST, actives UNIQUEMENT dans Roblox Studio (jamais dans le
	jeu publié). Tape-les dans le chat pendant un test "Play" :
	  /give 1e6       -> donne de la Dopamine (ici 1 million)
	  /rush           -> lance un Dopamine Rush
	  /daily          -> rend la récompense quotidienne à nouveau disponible
	  /save           -> force une sauvegarde
	  /corner         -> le 1er logo DVD touchera un coin dans ~2 secondes
	  /unlockall      -> toutes les améliorations au max (sauf l'océan)
	  /spawn golden   -> fait apparaître un objet (golden, lightning, notif, email)
	  /golden         -> raccourci de /spawn golden
	  /detox          -> va à l'océan gratuitement
	  /chest 3        -> ajoute des coffres mystère
	  /reset          -> remet toutes les données à zéro (sauf les réglages)
	  /help           -> liste des commandes
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)

local DebugService = {}

local services

-- "golden" -> "Golden" (le chat est mis en minuscules)
local spawnKinds = {}
for kind in pairs(Config.Spawners) do
	spawnKinds[string.lower(kind)] = kind
end

local HELP = "/give /rush /daily /save /corner /unlockall /spawn <golden|lightning|notif|email> /detox /chest /reset"

function DebugService:Init(allServices)
	services = allServices
end

local function info(player: Player, text: string)
	services.GameService:Notify(player, { Type = "Info", Text = "🛠️ " .. text })
end

local function runCommand(player: Player, command: string, argument: string)
	local gameService = services.GameService
	local data = services.DataService:GetData(player)
	if not data then
		return
	end

	if command == "give" then
		local amount = tonumber(argument) or 1e6
		if amount ~= amount or amount <= 0 or amount == math.huge then
			info(player, "Montant invalide")
			return
		end
		gameService:AddDopamine(player, amount, false)
		info(player, "Dopamine ajoutée")
	elseif command == "rush" then
		services.EventService:StartRush()
	elseif command == "daily" then
		data.Daily.LastDay = 0
		gameService:MarkDirty(player)
		info(player, "Cadeau quotidien disponible")
	elseif command == "save" then
		local ok = services.DataService:SaveAsync(player)
		info(player, ok and "💾 Sauvegardé !" or "💾 Sauvegarde impossible (voir la sortie)")
	elseif command == "corner" then
		if services.DVDService:DebugCorner(player) then
			info(player, "Coin dans ~2 secondes...")
		else
			info(player, "Il faut au moins un logo DVD")
		end
	elseif command == "unlockall" then
		for _, upgrade in ipairs(Config.Upgrades) do
			if upgrade.Effect ~= "Detox" then
				local level = data.Upgrades[upgrade.Id] or 0
				data.Upgrades[upgrade.Id] = upgrade.MaxLevel or math.max(level, 1)
			end
		end
		services.QuestService:Regenerate(player)
		gameService:RefreshAfterUpgradeChange(player)
		info(player, "Tout est débloqué !")
	elseif command == "spawn" or command == "golden" then
		local kind = (command == "golden") and "Golden" or spawnKinds[argument]
		if not kind then
			info(player, "Type inconnu : golden, lightning, notif ou email")
			return
		end
		if not services.EventService:Spawn(player, kind) then
			info(player, "Trop d'objets " .. kind .. " à l'écran")
		end
	elseif command == "detox" then
		gameService:Detox(player)
	elseif command == "chest" then
		local count = math.floor(tonumber(argument) or 1)
		if count ~= count or count < 1 then
			count = 1
		end
		services.LootService:AddChests(player, count)
		info(player, "Coffres ajoutés")
	elseif command == "reset" then
		services.DataService:ResetData(player)
		gameService:ResetCombo(player)
		services.EventService:ClearSpawns(player)
		services.DVDService:Reset(player)
		services.QuestService:PlayerReady(player, data)
		gameService:SendFullSync(player)
		info(player, "Données remises à zéro")
	elseif command == "help" then
		info(player, HELP)
	end
end

function DebugService:PlayerReady(player: Player)
	if not RunService:IsStudio() then
		return
	end

	player.Chatted:Connect(function(message: string)
		local command, argument = string.match(string.lower(message), "^/(%a+)%s*(%S*)")
		if not command then
			return
		end
		local ok, err = pcall(runCommand, player, command, argument or "")
		if not ok then
			warn("[DebugService] Erreur de la commande /" .. command .. " :", err)
		end
	end)
end

return DebugService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="63">
        <Properties>
          <string name="Name">EventService</string>
          <string name="Source"><![CDATA[--[[
	EventService (ModuleScript)
	Emplacement : ServerScriptService > Services > EventService

	Événements aléatoires :
	  - "Dopamine Rush" : x2 sur tous les gains pendant 30 s, pour TOUT le serveur ;
	  - objets à cliquer vite (Config.Spawners) : étoile dorée, éclair,
	    notification de téléphone, e-mail. Chaque type apparaît chez un joueur
	    seulement s'il possède la Feature correspondante.
	Le serveur décide quand ils arrivent et valide les clics.
]]

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Net = require(ReplicatedStorage.Shared.Net)
local RateLimiter = require(script.Parent.RateLimiter)

local EventService = {}

local services
local random = Random.new()

-- Dans Studio, les événements arrivent plus vite pour pouvoir les tester
local speedup = RunService:IsStudio() and Config.Events.StudioSpeedup or 1

local SPAWN_GRACE = 0.5 -- marge (s) pour la latence réseau
local SCHEDULER_STEP = 0.25 -- intervalle (s) de la boucle des apparitions

local rush = {
	Active = false,
	EndsAt = 0, -- heure serveur (workspace:GetServerTimeNow())
}

--[[
	Apparitions par joueur :
	[Player] = {
		Pending = { [id] = { Kind, ExpiresAt } }, -- objets affichés, pas encore cliqués
		NextAt = { [kind] = os.clock() de la prochaine apparition (nil = Feature absente) },
	}
]]
local spawnStates = {}

function EventService:Init(allServices)
	services = allServices
end

----------------------------------------------------------------------
-- Dopamine Rush (global)
----------------------------------------------------------------------

function EventService:GetMultiplier(): number
	return rush.Active and Config.Events.Rush.Multiplier or 1
end

local function rushPayload()
	return {
		Active = rush.Active,
		EndsAt = rush.EndsAt,
		Name = Config.Events.Rush.Name,
		Multiplier = Config.Events.Rush.Multiplier,
	}
end

function EventService:SendState(player: Player)
	Net.Event("EventUpdate"):FireClient(player, rushPayload())
end

-- Lance un Dopamine Rush (aussi utilisé par la commande de test /rush)
function EventService:StartRush()
	if rush.Active then
		return
	end
	local settings = Config.Events.Rush
	rush.Active = true
	rush.EndsAt = workspace:GetServerTimeNow() + settings.Duration
	Net.Event("EventUpdate"):FireAllClients(rushPayload())
	services.GameService:MarkAllDirty()
	services.GameService:NotifyAll({
		Type = "Rush",
		Text = "⚡ " .. settings.Name .. " : x" .. settings.Multiplier .. " pendant " .. settings.Duration .. " s !",
	})

	task.delay(settings.Duration, function()
		rush.Active = false
		Net.Event("EventUpdate"):FireAllClients(rushPayload())
		services.GameService:MarkAllDirty()
	end)
end

----------------------------------------------------------------------
-- Objets à cliquer (Config.Spawners)
----------------------------------------------------------------------

-- Retire les objets expirés et renvoie le nombre d'objets encore en attente pour ce type
local function cleanPending(state, kind: string): number
	local clock = os.clock()
	local count = 0
	for id, spawn in pairs(state.Pending) do
		if clock > spawn.ExpiresAt + SPAWN_GRACE then
			state.Pending[id] = nil
		elseif spawn.Kind == kind then
			count += 1
		end
	end
	return count
end

-- Fait apparaître un objet chez un joueur (ignore la Feature : utilisé aussi par /spawn).
-- Renvoie false si trop d'objets de ce type sont déjà affichés.
function EventService:Spawn(player: Player, kind: string): boolean
	local state = spawnStates[player]
	local settings = Config.Spawners[kind]
	if not state or not settings then
		return false
	end
	if cleanPending(state, kind) >= Config.MaxPendingSpawnsPerKind then
		return false
	end

	local id = HttpService:GenerateGUID(false)
	state.Pending[id] = {
		Kind = kind,
		ExpiresAt = os.clock() + settings.Lifetime,
	}
	Net.Event("Spawn"):FireClient(player, {
		Kind = kind,
		Id = id,
		X = random:NextNumber(0.08, 0.72),
		Y = random:NextNumber(0.15, 0.85),
		Lifetime = settings.Lifetime,
		Variant = random:NextInteger(1, 1000),
	})
	return true
end

-- Ancien nom (v1), gardé pour compatibilité
function EventService:SpawnGolden(player: Player)
	return self:Spawn(player, "Golden")
end

-- Oublie tous les objets en attente (détox, reset)
function EventService:ClearSpawns(player: Player)
	local state = spawnStates[player]
	if state then
		state.Pending = {}
		state.NextAt = {}
	end
end

local function randomDelay(settings): number
	return random:NextNumber(settings.MinInterval, settings.MaxInterval) / speedup
end

-- Boucle unique qui planifie les apparitions de chaque type pour chaque joueur
-- (équivaut à une boucle par joueur et par type, sans créer de threads)
local function schedulerStep()
	local clock = os.clock()
	for player, state in pairs(spawnStates) do
		local data = services.DataService:GetData(player)
		if data and services.GameService:IsReady(player) then
			for kind, settings in pairs(Config.Spawners) do
				if not Formulas.HasFeature(data, settings.Feature) then
					state.NextAt[kind] = nil -- pas débloqué : rien ne se prépare
				elseif state.NextAt[kind] == nil then
					-- Tout juste débloqué (ou arrivée du joueur) : le premier arrive plus vite
					state.NextAt[kind] = clock + randomDelay(settings) * 0.5
				elseif clock >= state.NextAt[kind] then
					state.NextAt[kind] = clock + randomDelay(settings)
					EventService:Spawn(player, kind)
				end
			end
		end
	end
end

local function onSpawnClick(player: Player, id: any)
	if not RateLimiter.Check(player, "SpawnClick", 0.1) then
		return
	end
	local state = spawnStates[player]
	if not state or type(id) ~= "string" or #id > 64 then
		return
	end
	local spawn = state.Pending[id]
	if not spawn then
		return
	end
	state.Pending[id] = nil
	if os.clock() > spawn.ExpiresAt + SPAWN_GRACE then
		return -- trop tard
	end

	local data = services.DataService:GetData(player)
	local settings = Config.Spawners[spawn.Kind]
	if not data or not settings then
		return
	end
	local reward = Formulas.ScaledReward(services.GameService:GetStats(player), settings.RewardSeconds, settings.MinReward)
	if settings.Stat then
		data.Stats[settings.Stat] = (data.Stats[settings.Stat] or 0) + 1
	end
	services.GameService:AddDopamine(player, reward, true)
	services.QuestService:Progress(player, "Spawns", 1)
	services.GameService:Notify(player, {
		Type = "Bonus",
		Source = spawn.Kind,
		Amount = reward,
		SpawnId = id,
	})
end

----------------------------------------------------------------------
-- Cycle de vie
----------------------------------------------------------------------

function EventService:PlayerReady(player: Player)
	spawnStates[player] = { Pending = {}, NextAt = {} }
end

function EventService:PlayerRemoving(player: Player)
	spawnStates[player] = nil
end

function EventService:Start()
	Net.Event("SpawnClick").OnServerEvent:Connect(onSpawnClick)

	-- Boucle des apparitions (par joueur et par type)
	task.spawn(function()
		while true do
			task.wait(SCHEDULER_STEP)
			local ok, err = pcall(schedulerStep)
			if not ok then
				warn("[EventService] Erreur des apparitions :", err)
			end
		end
	end)

	-- Boucle des Dopamine Rush (globaux)
	task.spawn(function()
		local settings = Config.Events.Rush
		while true do
			task.wait(random:NextNumber(settings.MinInterval, settings.MaxInterval) / speedup)
			self:StartRush()
			task.wait(settings.Duration)
		end
	end)
end

return EventService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="64">
        <Properties>
          <string name="Name">GameService</string>
          <string name="Source"><![CDATA[--[[
	GameService (ModuleScript)
	Emplacement : ServerScriptService > Services > GameService

	Cœur du jeu, 100 % côté serveur :
	  - clics (limite de clics/seconde, combo calculé par le serveur si la
	    Feature "Combo" est débloquée) ;
	  - achats d'améliorations (le serveur vérifie le prix et l'argent) et
	    "Aller à l'océan" (détox = rebirth) ;
	  - gains passifs (voir le pipeline ci-dessous) ;
	  - temps d'écran (par session, par jour UTC, total) ;
	  - envoi régulier de l'état au client (StateUpdate) ;
	  - leaderstats (liste des joueurs en haut à droite).

	Pipeline du tick passif (toutes les Config.Game.PassiveTickRate secondes,
	pour chaque joueur chargé) :
	  1. Dopamine/s : PerSecond x temps écoulé -> AddDopamine ;
	  2. Rebonds DVD : DVDService:CollectBounces renvoie le nombre de rebonds
	     depuis le dernier tick (tous les logos, 2 axes, plafonné) ;
	     gain = rebonds x BounceValue, Stats.Bounces, quête "Bounces" ;
	  3. Temps de jeu : Stats.PlaySeconds, temps de la session et
	     ScreenTime["jour UTC"] (on ne garde que Config.ScreenTime.DaysKept jours) ;
	  4. Coffres : LootService:Charge remplit la jauge du coffre mystère.
	Les stats (Rush compris) sont recalculées une seule fois par joueur et par tick.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Formulas = require(Shared.Formulas)
local NumberFormatter = require(Shared.NumberFormatter)
local Net = require(Shared.Net)
local RateLimiter = require(script.Parent.RateLimiter)

local GameService = {}

local services -- toutes les autres services (rempli par Init)

-- Données "de session" (non sauvegardées) : [Player] = session
local sessions = {}

local VALID_SETTINGS = { Sound = true, Music = true, Effects = true }
local SECONDS_PER_DAY = 86400

----------------------------------------------------------------------
-- Utilitaires
----------------------------------------------------------------------

local function isValidNumber(value): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function currentDay(): number
	return math.floor(os.time() / SECONDS_PER_DAY)
end

local function createLeaderstats(player: Player)
	if player:FindFirstChild("leaderstats") then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"

	-- StringValue pour afficher "1.5M" au lieu d'un nombre illisible
	local dopamine = Instance.new("StringValue")
	dopamine.Name = Config.Game.CurrencyName
	dopamine.Value = "0"
	dopamine.Parent = folder

	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Value = 0
	rebirths.Parent = folder

	folder.Parent = player
end

local function updateLeaderstats(player: Player, data)
	local folder = player:FindFirstChild("leaderstats")
	if not folder then
		return
	end
	local dopamine = folder:FindFirstChild(Config.Game.CurrencyName) :: StringValue?
	local rebirths = folder:FindFirstChild("Rebirths") :: IntValue?
	if dopamine then
		local text = NumberFormatter.Format(data.Dopamine)
		if dopamine.Value ~= text then
			dopamine.Value = text
		end
	end
	if rebirths and rebirths.Value ~= data.Rebirths then
		rebirths.Value = data.Rebirths
	end
end

-- Temps d'écran : supprime les jours trop anciens (et les clés invalides)
local function pruneScreenTime(data)
	local screenTime = data.ScreenTime
	local oldest = currentDay() - Config.ScreenTime.DaysKept + 1
	for key, value in pairs(screenTime) do
		local day = tonumber(key)
		if type(key) ~= "string" or not day or day < oldest or not isValidNumber(value) then
			screenTime[key] = nil
		end
	end
end

-- Corrige une sauvegarde abîmée ou devenue incohérente avec la config
-- (niveau max baissé, objet cosmétique supprimé...)
local function sanitizeData(data)
	for upgradeId, level in pairs(data.Upgrades) do
		local upgrade = Config.UpgradesById[upgradeId]
		if not upgrade or not isValidNumber(level) or level <= 0 or upgrade.Effect == "Detox" then
			data.Upgrades[upgradeId] = nil
		elseif upgrade.MaxLevel and level > upgrade.MaxLevel then
			data.Upgrades[upgradeId] = upgrade.MaxLevel
		else
			data.Upgrades[upgradeId] = math.floor(level)
		end
	end

	local cosmetics = data.Cosmetics
	for _, slot in ipairs({ "Hat", "Skin" }) do
		local id = cosmetics.Equipped[slot]
		local cosmetic = type(id) == "string" and Config.CosmeticsById[id]
		if not cosmetic or cosmetic.Slot ~= slot or not cosmetics.Owned[id] then
			cosmetics.Equipped[slot] = ""
		end
	end

	local chests = data.Chests
	chests.Stored = math.clamp(math.floor(chests.Stored), 0, Config.LootBox.MaxStored)
	chests.Progress = math.clamp(chests.Progress, 0, 1)

	if not isValidNumber(data.Dopamine) or data.Dopamine < 0 then
		data.Dopamine = 0
	end
	if not isValidNumber(data.Stock.Shares) or data.Stock.Shares < 0 then
		data.Stock.Shares = 0
		data.Stock.CostBasis = 0
	end

	pruneScreenTime(data)
end

----------------------------------------------------------------------
-- API utilisée par les autres services
----------------------------------------------------------------------

function GameService:Init(allServices)
	services = allServices
end

function GameService:IsReady(player: Player): boolean
	return sessions[player] ~= nil
end

function GameService:GetSession(player: Player)
	return sessions[player]
end

-- Le joueur possède-t-il cette Feature (débloquée par une amélioration) ?
function GameService:HasFeature(player: Player, feature: string): boolean
	local data = services.DataService:GetData(player)
	return data ~= nil and Formulas.HasFeature(data, feature)
end

-- Calcule les statistiques actuelles du joueur (gain/clic, gain/s...)
function GameService:GetStats(player: Player)
	local data = services.DataService:GetData(player)
	return Formulas.ComputeStats(data, services.EventService:GetMultiplier())
end

-- Ajoute de la Dopamine (façon normale de gagner de l'argent dans le jeu)
-- countForQuests = false pour ne pas faire avancer les quêtes "Gagne X"
function GameService:AddDopamine(player: Player, amount: number, countForQuests: boolean?)
	local data = services.DataService:GetData(player)
	if not data or not isValidNumber(amount) or amount <= 0 then
		return
	end
	local maxValue = Config.Game.MaxDopamine
	data.Dopamine = math.min(maxValue, data.Dopamine + amount)
	data.Stats.LifetimeDopamine = math.min(maxValue, data.Stats.LifetimeDopamine + amount)
	if countForQuests ~= false then
		services.QuestService:Progress(player, "Earn", amount)
	end
	self:MarkDirty(player)
end

function GameService:MarkDirty(player: Player)
	local session = sessions[player]
	if session then
		session.Dirty = true
	end
end

function GameService:MarkAllDirty()
	for _, session in pairs(sessions) do
		session.Dirty = true
	end
end

-- Envoie une notification à un joueur
-- payload = { Type = "Info" | "Error" | "Achievement" | "Quest" | "Bonus" | "Jackpot" | "Rush" | "Unlock" | "Detox", ... }
function GameService:Notify(player: Player, payload)
	Net.Event("Notify"):FireClient(player, payload)
end

-- Notifie tous les joueurs (sauf `except`, optionnel)
function GameService:NotifyAll(payload, except: Player?)
	local remote = Net.Event("Notify")
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= except then
			remote:FireClient(other, payload)
		end
	end
end

-- Temps d'écran envoyé au client
function GameService:GetScreenTime(player: Player)
	local data = services.DataService:GetData(player)
	local session = sessions[player]
	local today = currentDay()
	local days = {}
	for offset = Config.ScreenTime.DaysKept - 1, 0, -1 do
		table.insert(days, data.ScreenTime[tostring(today - offset)] or 0)
	end
	return {
		Session = session and session.SessionSeconds or 0,
		Today = data.ScreenTime[tostring(today)] or 0,
		Total = data.Stats.PlaySeconds,
		Days = days, -- du plus ancien à aujourd'hui
	}
end

-- Construit l'état envoyé au client (tout ce que l'interface doit afficher)
function GameService:BuildState(player: Player)
	local data = services.DataService:GetData(player)
	local session = sessions[player]
	local stats = self:GetStats(player)

	return {
		Dopamine = data.Dopamine,
		Rebirths = data.Rebirths,
		Upgrades = data.Upgrades,
		Features = Formulas.GetFeatures(data),
		Achievements = data.Achievements,
		Quests = data.Quests,
		Stats = data.Stats,
		Settings = data.Settings,

		ClickValue = stats.ClickValue,
		PerSecond = stats.PerSecond,
		BounceValue = stats.BounceValue,
		DVDCount = stats.DVDCount,
		GlobalMultiplier = stats.GlobalMultiplier,
		ClickMultiplier = stats.ClickMultiplier,
		UpgradeMultiplier = stats.UpgradeMultiplier,
		RebirthMultiplier = stats.RebirthMultiplier,
		AchievementMultiplier = stats.AchievementMultiplier,
		CosmeticMultiplier = stats.CosmeticMultiplier,
		EventMultiplier = stats.EventMultiplier,
		ComboEnabled = Formulas.HasFeature(data, "Combo"),

		RebirthCost = Formulas.GetRebirthCost(data.Rebirths),
		NextRebirthMultiplier = Formulas.GetRebirthMultiplier(data.Rebirths + 1),

		Daily = services.DailyRewardService:GetInfo(player, stats),
		Stock = { Shares = data.Stock.Shares, CostBasis = data.Stock.CostBasis },
		Chests = {
			Stored = data.Chests.Stored,
			Progress = data.Chests.Progress,
			Max = Config.LootBox.MaxStored,
		},
		Cosmetics = data.Cosmetics,
		ScreenTime = self:GetScreenTime(player),

		-- Nombre de clics reçus par le serveur (sert au client pour sa prédiction)
		ClickSeq = session and session.ClickSeq or 0,
	}
end

function GameService:SendState(player: Player)
	local session = sessions[player]
	local data = services.DataService:GetData(player)
	if not session or not data then
		return
	end
	session.Dirty = false
	Net.Event("StateUpdate"):FireClient(player, self:BuildState(player))
	updateLeaderstats(player, data)
end

-- Envoie tout ce dont le client a besoin (état, logos DVD, Rush, classement, bourse)
function GameService:SendFullSync(player: Player)
	if not sessions[player] then
		return
	end
	self:SendState(player)
	services.DVDService:SendSetup(player)
	services.EventService:SendState(player)
	services.LeaderboardService:SendTo(player)
	services.StockService:SendTo(player)
end

-- Remet le combo à zéro (détox, reset...)
function GameService:ResetCombo(player: Player)
	local session = sessions[player]
	if session then
		session.Combo = 0
		session.ComboMaxed = false
	end
end

-- "Aller à l'océan" : remet la progression à zéro contre un multiplicateur
-- permanent. On garde : succès, stats, cosmétiques, cadeau, réglages,
-- coffres, temps d'écran, quêtes et les améliorations "Permanent".
function GameService:Detox(player: Player)
	local data = services.DataService:GetData(player)
	if not data or not sessions[player] then
		return
	end

	local kept = {}
	for upgradeId, level in pairs(data.Upgrades) do
		local upgrade = Config.UpgradesById[upgradeId]
		if upgrade and upgrade.Permanent then
			kept[upgradeId] = level
		end
	end

	data.Dopamine = 0
	data.Upgrades = kept
	data.Stock.Shares = 0
	data.Stock.CostBasis = 0
	data.Rebirths += 1
	self:ResetCombo(player)

	services.DVDService:Reset(player)
	services.EventService:ClearSpawns(player)
	-- Nouvelles quêtes adaptées à la production (redevenue petite) après la détox
	services.QuestService:Regenerate(player)

	local multiplier = Formulas.GetRebirthMultiplier(data.Rebirths)
	self:Notify(player, {
		Type = "Detox",
		Rebirths = data.Rebirths,
		Multiplier = multiplier,
	})
	self:NotifyAll({
		Type = "Info",
		Text = "🌊 " .. player.DisplayName .. " est allé(e) à l'océan (x" .. data.Rebirths .. ")",
	}, player)
	self:SendState(player)
end

-- Appelé après un changement d'améliorations fait "à la main" (commandes de test)
function GameService:RefreshAfterUpgradeChange(player: Player)
	services.DVDService:SyncLogos(player)
	self:SendState(player)
end

----------------------------------------------------------------------
-- Cycle de vie du joueur (appelé par Main)
----------------------------------------------------------------------

function GameService:PlayerReady(player: Player, data)
	local now = os.clock()
	sessions[player] = {
		ClickSeq = 0,
		Combo = 0, -- jauge de combo (0-100)
		ComboMaxed = false, -- déjà compté comme "combo max" ?
		LastClick = now,
		Tokens = Config.Game.MaxClicksPerSecond, -- anti-autoclick (seau de jetons)
		LastRefill = now,
		SessionSeconds = 0, -- temps de jeu de cette session
		Dirty = true,
	}
	sanitizeData(data)
	createLeaderstats(player)
end

function GameService:PlayerRemoving(player: Player)
	sessions[player] = nil
end

----------------------------------------------------------------------
-- Actions des joueurs (toujours validées ici)
----------------------------------------------------------------------

local function onClick(player: Player)
	local session = sessions[player]
	local data = services.DataService:GetData(player)
	if not session or not data then
		return
	end

	-- Compté même si refusé : le client s'en sert pour corriger sa prédiction
	session.ClickSeq += 1
	session.Dirty = true

	-- Seau de jetons : on regagne MaxClicksPerSecond jetons par seconde
	local now = os.clock()
	local maxClicks = Config.Game.MaxClicksPerSecond
	session.Tokens = math.min(maxClicks, session.Tokens + (now - session.LastRefill) * maxClicks)
	session.LastRefill = now
	if session.Tokens < 1 then
		return -- trop de clics : ignoré (autoclicker / exploit)
	end
	session.Tokens -= 1

	data.Stats.TotalClicks += 1

	-- Combo calculé par le serveur (le client ne fait que l'afficher),
	-- seulement si l'amélioration "Combo" est achetée
	local comboMultiplier = 1
	if Formulas.HasFeature(data, "Combo") then
		session.Combo = Formulas.StepCombo(session.Combo, now - session.LastClick)
		if session.Combo >= 100 and not session.ComboMaxed then
			session.ComboMaxed = true
			data.Stats.CombosMaxed += 1
			services.QuestService:Progress(player, "Combo", 1)
		elseif session.Combo < 50 then
			session.ComboMaxed = false
		end
		comboMultiplier = Formulas.GetComboMultiplier(session.Combo)
	else
		session.Combo = 0
		session.ComboMaxed = false
	end
	session.LastClick = now

	local stats = GameService:GetStats(player)
	GameService:AddDopamine(player, stats.ClickValue * comboMultiplier, true)
	services.QuestService:Progress(player, "Clicks", 1)
end

local function onBuyUpgrade(player: Player, upgradeId: any)
	if not RateLimiter.Check(player, "Buy", 0.05) then
		return false, "Doucement !"
	end
	local data = services.DataService:GetData(player)
	if not data or not sessions[player] then
		return false, "Chargement en cours..."
	end
	if type(upgradeId) ~= "string" or #upgradeId > 64 then
		return false, "Requête invalide"
	end
	local upgrade = Config.UpgradesById[upgradeId]
	if not upgrade then
		return false, "Amélioration inconnue"
	end

	local level = data.Upgrades[upgradeId] or 0
	if Formulas.IsMaxed(upgrade, level) then
		return false, "Niveau maximum atteint"
	end
	local cost = Formulas.GetUpgradeCost(upgrade, level, data.Rebirths)
	if not isValidNumber(cost) or data.Dopamine < cost then
		return false, "Pas assez de " .. Config.Game.CurrencyName
	end

	-- "Aller à l'océan" : la détox
	if upgrade.Effect == "Detox" then
		if not RateLimiter.Check(player, "Detox", 2) then
			return false, "Doucement !"
		end
		GameService:Detox(player)
		local multiplier = NumberFormatter.Multiplier(Formulas.GetRebirthMultiplier(data.Rebirths))
		return true, "🌊 Respire... Gains permanents " .. multiplier
	end

	data.Dopamine -= cost
	data.Upgrades[upgradeId] = level + 1
	data.Stats.UpgradesBought += 1
	services.QuestService:Progress(player, "Buy", 1)

	if upgrade.Feature and level == 0 then
		GameService:Notify(player, {
			Type = "Unlock",
			Feature = upgrade.Feature,
			UpgradeId = upgrade.Id,
			Text = "✨ Nouveau : " .. upgrade.Icon .. " " .. upgrade.Name .. " !",
		})
		if upgrade.Feature == "Quests" then
			-- Les quêtes deviennent visibles : on en propose des toutes neuves, à l'échelle
			services.QuestService:Regenerate(player)
		end
	end

	services.DVDService:SyncLogos(player)
	GameService:SendState(player)
	return true, string.format("%s %s niveau %d", upgrade.Icon, upgrade.Name, level + 1)
end

local function onSetSetting(player: Player, name: any, value: any)
	if not RateLimiter.Check(player, "Setting", 0.2) then
		return false
	end
	local data = services.DataService:GetData(player)
	if not data or type(name) ~= "string" or not VALID_SETTINGS[name] or type(value) ~= "boolean" then
		return false
	end
	data.Settings[name] = value
	GameService:MarkDirty(player)
	return true
end

----------------------------------------------------------------------
-- Tick passif (voir le pipeline en haut du fichier)
----------------------------------------------------------------------

local function passiveTick(player: Player, session, elapsed: number)
	local data = services.DataService:GetData(player)
	if not data then
		return
	end
	local stats = GameService:GetStats(player)

	-- 1. Dopamine par seconde
	if stats.PerSecond > 0 then
		GameService:AddDopamine(player, stats.PerSecond * elapsed, true)
	end

	-- 2. Rebonds des logos DVD
	local bounces = services.DVDService:CollectBounces(player, workspace:GetServerTimeNow())
	if bounces > 0 then
		data.Stats.Bounces += bounces
		GameService:AddDopamine(player, stats.BounceValue * bounces, true)
		services.QuestService:Progress(player, "Bounces", bounces)
	end

	-- 3. Temps de jeu / temps d'écran
	local before = math.floor(session.SessionSeconds)
	session.SessionSeconds += elapsed
	data.Stats.PlaySeconds += elapsed
	local key = tostring(currentDay())
	local screenTime = data.ScreenTime
	if screenTime[key] == nil then
		screenTime[key] = 0
		pruneScreenTime(data) -- nouveau jour : on oublie le plus ancien
	end
	screenTime[key] += elapsed
	if math.floor(session.SessionSeconds) ~= before then
		session.Dirty = true -- au moins 1 envoi par seconde pour le temps d'écran
	end

	-- 4. Coffre mystère
	services.LootService:Charge(player, data, elapsed)
end

----------------------------------------------------------------------
-- Démarrage : branchements des remotes + boucles
----------------------------------------------------------------------

function GameService:Start()
	Net.Event("Click").OnServerEvent:Connect(onClick)
	Net.Event("ClientReady").OnServerEvent:Connect(function(player)
		if RateLimiter.Check(player, "ClientReady", 2) then
			self:SendFullSync(player)
		end
	end)
	Net.Function("BuyUpgrade").OnServerInvoke = onBuyUpgrade
	Net.Function("SetSetting").OnServerInvoke = onSetSetting

	-- Gains passifs
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(Config.Game.PassiveTickRate)
			local now = os.clock()
			-- plafond : évite un énorme rattrapage après un gel du serveur
			local elapsed = math.min(now - last, 5)
			last = now
			for player, session in pairs(sessions) do
				local ok, err = pcall(passiveTick, player, session, elapsed)
				if not ok then
					warn("[GameService] Erreur du tick passif pour " .. player.Name .. " :", err)
				end
			end
		end
	end)

	-- Synchronisation vers les clients (seulement si quelque chose a changé)
	task.spawn(function()
		while true do
			task.wait(Config.Game.SyncRate)
			for player, session in pairs(sessions) do
				if session.Dirty then
					local ok, err = pcall(function()
						services.AchievementService:Check(player)
						self:SendState(player)
					end)
					if not ok then
						session.Dirty = false
						warn("[GameService] Erreur d'envoi de l'état pour " .. player.Name .. " :", err)
					end
				end
			end
		end
	end)

	-- Petit rappel dans la console du serveur
	print(string.format("[Dopamine Clicker] Serveur prêt (%d joueur(s))", #Players:GetPlayers()))
end

return GameService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="65">
        <Properties>
          <string name="Name">InteractService</string>
          <string name="Source"><![CDATA[--[[
	InteractService (ModuleScript)
	Emplacement : ServerScriptService > Services > InteractService

	Interactions "satisfaisantes" avec les éléments de l'écran
	(RemoteEvent Interact, réglages dans Config.Interactions) :
	  - "Bubble"   : papier bulle. Seau de jetons (MaxPerSecond), gain =
	                 gain par clic x ClickFraction, SANS notification (le
	                 client affiche lui-même le "+X") ;
	  - "Spin", "Headline", "Press" : temps de recharge, gain = X secondes de
	                 production, notification "Bonus".
	Chaque interaction exige la Feature correspondante.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Net = require(ReplicatedStorage.Shared.Net)

local InteractService = {}

local services
local COOLDOWN_TOLERANCE = 0.2 -- marge (s) pour la latence réseau

-- [Player] = { Tokens = { [kind] = n }, LastRefill = { [kind] = clock }, LastUse = { [kind] = clock } }
local states = {}

function InteractService:Init(allServices)
	services = allServices
end

-- Seau de jetons : true si l'action est autorisée
local function takeToken(state, kind: string, perSecond: number): boolean
	local clock = os.clock()
	local tokens = state.Tokens[kind] or perSecond
	local last = state.LastRefill[kind] or clock
	tokens = math.min(perSecond, tokens + (clock - last) * perSecond)
	state.LastRefill[kind] = clock
	if tokens < 1 then
		state.Tokens[kind] = tokens
		return false
	end
	state.Tokens[kind] = tokens - 1
	return true
end

local function onInteract(player: Player, kind: any, _arg: any)
	local state = states[player]
	if not state or type(kind) ~= "string" then
		return
	end
	local settings = Config.Interactions[kind]
	if not settings then
		return
	end
	local data = services.DataService:GetData(player)
	if not data or not Formulas.HasFeature(data, settings.Feature) then
		return
	end

	local stats = services.GameService:GetStats(player)

	if settings.MaxPerSecond then
		-- Papier bulle : beaucoup de petits gains, pas de notification
		if not takeToken(state, kind, settings.MaxPerSecond) then
			return
		end
		if settings.Stat then
			data.Stats[settings.Stat] = (data.Stats[settings.Stat] or 0) + 1
		end
		services.GameService:AddDopamine(player, stats.ClickValue * (settings.ClickFraction or 1), true)
		if kind == "Bubble" then
			services.QuestService:Progress(player, "Bubbles", 1)
		end
		return
	end

	-- Autres interactions : temps de recharge + notification
	local clock = os.clock()
	local last = state.LastUse[kind]
	if last and clock - last < (settings.Cooldown or 1) - COOLDOWN_TOLERANCE then
		return
	end
	state.LastUse[kind] = clock

	local reward = Formulas.ScaledReward(stats, settings.RewardSeconds or 1, settings.MinReward or 1)
	if settings.Stat then
		data.Stats[settings.Stat] = (data.Stats[settings.Stat] or 0) + 1
	end
	services.GameService:AddDopamine(player, reward, true)
	services.GameService:Notify(player, {
		Type = "Bonus",
		Source = kind,
		Amount = reward,
	})
end

function InteractService:PlayerReady(player: Player)
	states[player] = { Tokens = {}, LastRefill = {}, LastUse = {} }
end

function InteractService:PlayerRemoving(player: Player)
	states[player] = nil
end

function InteractService:Start()
	Net.Event("Interact").OnServerEvent:Connect(onInteract)
end

return InteractService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="66">
        <Properties>
          <string name="Name">LeaderboardService</string>
          <string name="Source"><![CDATA[--[[
	LeaderboardService (ModuleScript)
	Emplacement : ServerScriptService > Services > LeaderboardService

	Classement global (tous serveurs confondus) sur la Dopamine totale gagnée,
	avec un OrderedDataStore.

	Astuce : un OrderedDataStore n'accepte que des entiers (max ~9.2e18),
	alors que la Dopamine peut dépasser 1e30. On stocke donc
	log10(valeur) * 1 000 000 (un entier), puis on refait l'inverse à la lecture.
	L'ordre du classement reste exactement le même.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)

local LeaderboardService = {}

local services
local orderedStore: OrderedDataStore? = nil
local cachedTop = {} -- dernier classement connu
local nameCache = {} -- [userId] = nom

do
	local ok, result = pcall(function()
		return DataStoreService:GetOrderedDataStore(Config.Leaderboard.StoreName)
	end)
	if ok then
		orderedStore = result
	else
		warn("[LeaderboardService] Classement indisponible :", result)
	end
end

local function encode(value: number): number
	return math.floor(math.log10(math.max(0, value) + 1) * 1e6)
end

local function decode(stored: number): number
	return 10 ^ (stored / 1e6) - 1
end

local function getName(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		nameCache[userId] = player.DisplayName
		return player.DisplayName
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	if ok and name then
		nameCache[userId] = name
		return name
	end
	return "Joueur " .. userId
end

function LeaderboardService:Init(allServices)
	services = allServices
end

function LeaderboardService:SendTo(player: Player)
	Net.Event("LeaderboardUpdate"):FireClient(player, cachedTop)
end

-- Écrit le score d'un joueur dans le classement
function LeaderboardService:SubmitAsync(player: Player)
	local data = services.DataService:GetData(player)
	if not orderedStore or not data then
		return
	end
	local store = orderedStore :: OrderedDataStore
	local ok, err = pcall(function()
		store:SetAsync("P_" .. player.UserId, encode(data.Stats.LifetimeDopamine))
	end)
	if not ok then
		warn("[LeaderboardService] Échec d'envoi du score :", err)
	end
end

-- Lit le top et l'envoie à tout le monde
function LeaderboardService:RefreshAsync()
	if not orderedStore then
		return
	end
	local store = orderedStore :: OrderedDataStore
	local ok, pages = pcall(function()
		return store:GetSortedAsync(false, Config.Leaderboard.Size)
	end)
	if not ok then
		warn("[LeaderboardService] Échec de lecture du classement :", pages)
		return
	end

	local top = {}
	for rank, entry in ipairs(pages:GetCurrentPage()) do
		local userId = tonumber(string.sub(entry.key, 3))
		if userId then
			table.insert(top, {
				Rank = rank,
				UserId = userId,
				Name = getName(userId),
				Value = decode(entry.value),
			})
		end
	end
	cachedTop = top
	Net.Event("LeaderboardUpdate"):FireAllClients(cachedTop)
end

function LeaderboardService:PlayerRemoving(player: Player)
	task.spawn(function()
		self:SubmitAsync(player)
	end)
end

function LeaderboardService:Start()
	task.spawn(function()
		task.wait(5) -- laisse le temps aux premiers joueurs de charger
		while true do
			for _, player in ipairs(services.DataService:GetLoadedPlayers()) do
				self:SubmitAsync(player)
			end
			self:RefreshAsync()
			task.wait(Config.Leaderboard.UpdateInterval)
		end
	end)
end

return LeaderboardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="67">
        <Properties>
          <string name="Name">LootService</string>
          <string name="Source"><![CDATA[--[[
	LootService (ModuleScript)
	Emplacement : ServerScriptService > Services > LootService

	Coffre mystère (débloqué par l'amélioration "Coffre mystère") :
	  - se remplit avec le temps de jeu (Charge, appelé par le tick passif
	    de GameService) : 1 coffre toutes les ChargeInterval secondes, au
	    maximum MaxStored coffres en réserve ;
	  - le joueur l'ouvre avec la RemoteFunction OpenChest : le serveur tire
	    la rareté (poids de Config.LootBox.Tiers) et donne la récompense.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Net = require(ReplicatedStorage.Shared.Net)
local RateLimiter = require(script.Parent.RateLimiter)

local LootService = {}

local services
local random = Random.new()
local settings = Config.LootBox

function LootService:Init(allServices)
	services = allServices
end

-- Remplit la jauge du coffre (appelé à chaque tick passif)
function LootService:Charge(player: Player, data, elapsed: number)
	if not Formulas.HasFeature(data, settings.Feature) then
		return
	end
	local chests = data.Chests
	if chests.Stored >= settings.MaxStored then
		chests.Progress = 0
		return
	end
	chests.Progress += elapsed / settings.ChargeInterval
	while chests.Progress >= 1 and chests.Stored < settings.MaxStored do
		chests.Progress -= 1
		chests.Stored += 1
	end
	if chests.Stored >= settings.MaxStored then
		chests.Progress = 0
	end
	services.GameService:MarkDirty(player)
end

-- Ajoute des coffres (commande de test /chest)
function LootService:AddChests(player: Player, count: number)
	local data = services.DataService:GetData(player)
	if not data then
		return
	end
	data.Chests.Stored = math.clamp(data.Chests.Stored + count, 0, settings.MaxStored)
	services.GameService:MarkDirty(player)
end

-- Tire une rareté selon les poids
local function pickTier()
	local total = 0
	for _, tier in ipairs(settings.Tiers) do
		total += tier.Weight
	end
	local roll = random:NextNumber(0, total)
	for _, tier in ipairs(settings.Tiers) do
		roll -= tier.Weight
		if roll <= 0 then
			return tier
		end
	end
	return settings.Tiers[1]
end

local function onOpen(player: Player)
	local data = services.DataService:GetData(player)
	if not data or not services.GameService:IsReady(player) then
		return false, "Chargement en cours..."
	end
	if not Formulas.HasFeature(data, settings.Feature) then
		return false, "Le coffre mystère n'est pas encore débloqué"
	end
	if data.Chests.Stored < 1 then
		return false, "Aucun coffre à ouvrir, patience..."
	end
	if not RateLimiter.Check(player, "OpenChest", settings.OpenCooldown) then
		return false, "Doucement !"
	end

	local tier = pickTier()
	local amount = Formulas.ScaledReward(services.GameService:GetStats(player), tier.RewardSeconds, 100)

	data.Chests.Stored -= 1
	data.Stats.ChestsOpened += 1
	services.GameService:AddDopamine(player, amount, true)
	services.QuestService:Progress(player, "Chests", 1)
	services.GameService:SendState(player)

	if tier.Id == "Legendary" then
		services.GameService:NotifyAll({
			Type = "Info",
			Text = "📦 " .. player.DisplayName .. " a ouvert un coffre " .. tier.Name .. " (+" .. NumberFormatter.Format(amount) .. ") !",
		}, player)
	end

	return true, { Tier = tier.Id, Amount = amount }
end

function LootService:Start()
	Net.Function("OpenChest").OnServerInvoke = onOpen
end

return LootService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="68">
        <Properties>
          <string name="Name">QuestService</string>
          <string name="Source"><![CDATA[--[[
	QuestService (ModuleScript)
	Emplacement : ServerScriptService > Services > QuestService

	Quêtes simples (ex. "Fais 50 clics"). Le joueur a toujours
	Config.Quests.ActiveCount quêtes actives. Une quête terminée donne sa
	récompense automatiquement et est remplacée par une nouvelle.
	  - Un modèle avec une Feature n'est proposé que si le joueur la possède.
	  - Les quêtes n'avancent qu'une fois le menu "Quêtes" débloqué.
	  - Types : Clicks, Earn, Buy, Bounces, Bubbles, Spawns, Combo, Casino, Chests.
	  - Les quêtes sont gardées après une détox.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)

local QuestService = {}

local services
local random = Random.new()

local QUESTS_FEATURE = "Quests"

-- Types de quêtes existants (d'après la config)
local validTypes = {}
for _, template in ipairs(Config.Quests.Pool) do
	validTypes[template.Type] = true
end

function QuestService:Init(allServices)
	services = allServices
end

local function isTemplateAvailable(data, template): boolean
	return template.Feature == nil or Formulas.HasFeature(data, template.Feature)
end

-- Crée une nouvelle quête en évitant les types déjà actifs
local function generateQuest(player: Player, data, activeQuests)
	local usedTypes = {}
	for _, quest in ipairs(activeQuests) do
		usedTypes[quest.Type] = true
	end

	local available = {}
	local candidates = {}
	for _, template in ipairs(Config.Quests.Pool) do
		if isTemplateAvailable(data, template) then
			table.insert(available, template)
			if not usedTypes[template.Type] then
				table.insert(candidates, template)
			end
		end
	end
	if #candidates == 0 then
		candidates = (#available > 0) and available or Config.Quests.Pool
	end

	local template = candidates[random:NextInteger(1, #candidates)]
	local stats = services.GameService:GetStats(player)

	local goal
	if template.GoalSeconds then
		-- Objectif "à l'échelle" : X secondes de production
		local seconds = template.GoalSeconds[random:NextInteger(1, #template.GoalSeconds)]
		goal = Formulas.ScaledReward(stats, seconds, template.MinGoal or 100)
	else
		goal = template.Goals[random:NextInteger(1, #template.Goals)]
	end

	return {
		Type = template.Type,
		Goal = goal,
		Progress = 0,
		Text = string.format(template.Text, NumberFormatter.Format(goal)),
		Reward = Formulas.ScaledReward(stats, template.RewardSeconds, template.MinReward),
	}
end

local function isValidQuest(quest): boolean
	return type(quest) == "table"
		and type(quest.Type) == "string"
		and validTypes[quest.Type] == true
		and type(quest.Goal) == "number"
		and type(quest.Progress) == "number"
		and type(quest.Text) == "string"
		and type(quest.Reward) == "number"
end

-- Complète la liste des quêtes si nécessaire (nouveau joueur, config modifiée...)
function QuestService:PlayerReady(player: Player, data)
	-- Nettoie les quêtes invalides ou dont le type n'existe plus dans la config
	local cleaned = {}
	for _, quest in ipairs(data.Quests) do
		if isValidQuest(quest) and #cleaned < Config.Quests.ActiveCount then
			table.insert(cleaned, quest)
		end
	end
	data.Quests = cleaned

	while #data.Quests < Config.Quests.ActiveCount do
		table.insert(data.Quests, generateQuest(player, data, data.Quests))
	end
end

-- Remplace toutes les quêtes par des nouvelles (à l'échelle de la production actuelle)
function QuestService:Regenerate(player: Player)
	local data = services.DataService:GetData(player)
	if not data then
		return
	end
	data.Quests = {}
	while #data.Quests < Config.Quests.ActiveCount do
		table.insert(data.Quests, generateQuest(player, data, data.Quests))
	end
	services.GameService:MarkDirty(player)
end

-- Fait avancer les quêtes d'un type donné
function QuestService:Progress(player: Player, questType: string, amount: number)
	local data = services.DataService:GetData(player)
	if not data or type(amount) ~= "number" or amount ~= amount or amount <= 0 then
		return
	end
	if not Formulas.HasFeature(data, QUESTS_FEATURE) then
		return -- menu des quêtes pas encore débloqué
	end

	local completed = {}
	for index, quest in ipairs(data.Quests) do
		if quest.Type == questType and quest.Progress < quest.Goal then
			quest.Progress = math.min(quest.Goal, quest.Progress + amount)
			if quest.Progress >= quest.Goal then
				table.insert(completed, index)
			end
		end
	end

	if #completed == 0 then
		return
	end

	-- D'abord on remplace les quêtes terminées, ENSUITE on donne les récompenses
	-- (évite de modifier la liste pendant qu'on la parcourt)
	local rewards = {}
	for _, index in ipairs(completed) do
		local quest = data.Quests[index]
		table.insert(rewards, quest)
		data.Stats.QuestsCompleted += 1
		local others = table.clone(data.Quests)
		table.remove(others, index)
		data.Quests[index] = generateQuest(player, data, others)
	end

	for _, quest in ipairs(rewards) do
		services.GameService:AddDopamine(player, quest.Reward, false)
		services.GameService:Notify(player, {
			Type = "Quest",
			Title = "QUÊTE TERMINÉE !",
			Text = "📜 " .. quest.Text .. "  (+" .. NumberFormatter.Format(quest.Reward) .. ")",
		})
	end
	services.GameService:MarkDirty(player)
end

return QuestService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="69">
        <Properties>
          <string name="Name">RateLimiter</string>
          <string name="Source"><![CDATA[--[[
	RateLimiter (ModuleScript)
	Emplacement : ServerScriptService > Services > RateLimiter

	Anti-spam simple : empêche un joueur d'appeler une action plus souvent
	que l'intervalle donné (protection contre les exploits qui spamment
	les RemoteEvents).
]]

local Players = game:GetService("Players")

local RateLimiter = {}

-- [Player] = { [clé] = dernière heure d'appel }
local lastCalls = {}

-- Renvoie true si l'action est autorisée, false si le joueur va trop vite
function RateLimiter.Check(player: Player, key: string, interval: number): boolean
	local now = os.clock()
	local playerCalls = lastCalls[player]
	if not playerCalls then
		playerCalls = {}
		lastCalls[player] = playerCalls
	end

	local last = playerCalls[key]
	if last and now - last < interval then
		return false
	end
	playerCalls[key] = now
	return true
end

Players.PlayerRemoving:Connect(function(player)
	lastCalls[player] = nil
end)

return RateLimiter
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="70">
        <Properties>
          <string name="Name">StockService</string>
          <string name="Source"><![CDATA[--[[
	StockService (ModuleScript)
	Emplacement : ServerScriptService > Services > StockService

	Bourse (débloquée par l'amélioration "Bourse") :
	  - un cours COMMUN à tout le serveur, qui suit une marche aléatoire :
	      prix *= exp(N(0, Volatility)) ; prix += (StartPrice - prix) * MeanReversion
	    puis borné entre MinPrice et MaxPrice ;
	  - envoyé à tous les joueurs toutes les UpdateInterval secondes (StockUpdate) ;
	  - achat / vente validés par le serveur (RemoteFunction StockTrade).
	Uniquement avec la Dopamine du jeu.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Net = require(ReplicatedStorage.Shared.Net)
local RateLimiter = require(script.Parent.RateLimiter)

local StockService = {}

local services
local random = Random.new()
local settings = Config.Stocks

local price = settings.StartPrice
local history = { price } -- du plus ancien au plus récent

function StockService:Init(allServices)
	services = allServices
end

function StockService:GetPrice(): number
	return price
end

local function payload()
	return {
		Symbol = settings.Symbol,
		Price = price,
		History = table.clone(history),
	}
end

function StockService:SendTo(player: Player)
	Net.Event("StockUpdate"):FireClient(player, payload())
end

-- Tirage selon une loi normale N(0, 1) (méthode de Box-Muller)
local function gaussian(): number
	local u1 = math.max(random:NextNumber(), 1e-12)
	local u2 = random:NextNumber()
	return math.sqrt(-2 * math.log(u1)) * math.cos(2 * math.pi * u2)
end

local function step()
	price *= math.exp(gaussian() * settings.Volatility)
	price += (settings.StartPrice - price) * settings.MeanReversion
	if price ~= price then
		price = settings.StartPrice
	end
	price = math.clamp(price, settings.MinPrice, settings.MaxPrice)

	table.insert(history, price)
	while #history > settings.HistoryLength do
		table.remove(history, 1)
	end
end

local function isAllowedFraction(fraction: any): boolean
	if type(fraction) ~= "number" or fraction ~= fraction then
		return false
	end
	for _, allowed in ipairs(settings.Fractions) do
		if math.abs(allowed - fraction) < 1e-9 then
			return true
		end
	end
	return false
end

local function onTrade(player: Player, action: any, fraction: any)
	if not RateLimiter.Check(player, "StockTrade", settings.TradeCooldown) then
		return false, "Doucement !"
	end
	local data = services.DataService:GetData(player)
	if not data or not services.GameService:IsReady(player) then
		return false, "Chargement en cours..."
	end
	if not Formulas.HasFeature(data, settings.Feature) then
		return false, "La bourse n'est pas encore débloquée"
	end
	if (action ~= "buy" and action ~= "sell") or not isAllowedFraction(fraction) then
		return false, "Requête invalide"
	end

	local stock = data.Stock
	local maxValue = Config.Game.MaxDopamine

	if action == "buy" then
		local spend = data.Dopamine * fraction
		if not (spend >= 1) then
			return false, "Pas assez de " .. Config.Game.CurrencyName
		end
		local shares = spend / price
		data.Dopamine -= spend
		stock.Shares += shares
		stock.CostBasis += spend
		data.Stats.StockTrades += 1
		services.GameService:SendState(player)
		return true, string.format("📈 %s action(s) %s achetée(s)", NumberFormatter.Format(shares), settings.Symbol)
	end

	-- Vente
	if not (stock.Shares > 0) then
		return false, "Tu n'as aucune action"
	end
	local shares = stock.Shares * fraction
	local costPart = stock.CostBasis * fraction
	if fraction >= 1 then
		shares = stock.Shares
		costPart = stock.CostBasis
	end
	local proceeds = shares * price
	local profit = proceeds - costPart

	stock.Shares = math.max(0, stock.Shares - shares)
	stock.CostBasis = math.max(0, stock.CostBasis - costPart)
	if stock.Shares < 1e-9 then
		stock.Shares = 0
		stock.CostBasis = 0
	end
	data.Dopamine = math.min(maxValue, data.Dopamine + proceeds)
	if profit > 0 then
		data.Stats.LifetimeDopamine = math.min(maxValue, data.Stats.LifetimeDopamine + profit)
	end
	data.Stats.StockTrades += 1
	services.GameService:SendState(player)

	local result = profit >= 0 and ("bénéfice +" .. NumberFormatter.Format(profit))
		or ("perte -" .. NumberFormatter.Format(-profit))
	return true, string.format("💰 Vendu pour %s (%s)", NumberFormatter.Format(proceeds), result)
end

function StockService:Start()
	Net.Function("StockTrade").OnServerInvoke = onTrade

	task.spawn(function()
		while true do
			task.wait(settings.UpdateInterval)
			step()
			if #Players:GetPlayers() > 0 then
				Net.Event("StockUpdate"):FireAllClients(payload())
			end
		end
	end)
end

return StockService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="71">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="72">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="73">
        <Properties>
          <string name="Name">ClientMain</string>
          <string name="Source"><![CDATA[--[[
	ClientMain (LocalScript)
	Emplacement : StarterPlayer > StarterPlayerScripts > ClientMain

	Point d'entrée du client : construit toute l'interface en code, lance
	le gestionnaire de stimuli et branche les RemoteEvents. Aucune logique
	de gain ici : le client affiche et envoie des DEMANDES, le serveur décide.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local Client = ReplicatedStorage:WaitForChild("Client")
local Components = Client:WaitForChild("Components")
local Panels = Components:WaitForChild("Panels")

local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))
local Interface = require(Client:WaitForChild("Interface"))
local ClientState = require(Client:WaitForChild("ClientState"))
local SoundManager = require(Client:WaitForChild("SoundManager"))
local Effects = require(Client:WaitForChild("Effects"))
local StimulusManager = require(Client:WaitForChild("StimulusManager"))

local Background = require(Components:WaitForChild("Background"))
local Notifications = require(Components:WaitForChild("Notifications"))
local PanelManager = require(Components:WaitForChild("PanelManager"))
local CenterColumn = require(Components:WaitForChild("CenterColumn"))

-- Le sac à dos (outils) ne sert à rien ici
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

-- 1. Services de base
SoundManager.Init()
ClientState.Init()

-- 2. Écran et calques
Interface.Build()
local layers = Interface.Layers
Effects.Init(layers.Effects)
Background.Build(layers.Background)

-- 3. Toasts et fenêtres
Notifications.Build(layers.Toasts)
PanelManager.Build(layers.Panels)
PanelManager.Register("ScreenTime", require(Panels:WaitForChild("ScreenTime")))
PanelManager.Register("ItemShop", require(Panels:WaitForChild("ItemShop")))
PanelManager.Register("Achievements", require(Panels:WaitForChild("Achievements")))
PanelManager.Register("Quests", require(Panels:WaitForChild("Quests")))
PanelManager.Register("Leaderboard", require(Panels:WaitForChild("Leaderboard")))
PanelManager.Register("Daily", require(Panels:WaitForChild("Daily")))
PanelManager.Register("Settings", require(Panels:WaitForChild("Settings")))

-- 4. Colonne centrale (bouton, compteur, menus, améliorations).
-- L'infobulle des améliorations va dans le calque Panels (au-dessus des stimuli).
CenterColumn.Build(layers.Main, layers.Panels, layers.Effects)

-- 5. Stimuli (tout ce qui apparaît à l'écran avec les améliorations)
StimulusManager.Init()

-- 6. Notifications du serveur : toasts + stimuli (bonus, océan)
ClientState.SetNotifyHandler(function(payload)
	Notifications.Handle(payload)
	StimulusManager.HandleNotify(payload)
end)
ClientState.RushChanged:Connect(function(rush)
	Background.SetRush(rush.Active == true)
end)

-- 7. Musique : seulement avec "Lofi Beats" (le réglage Musique est géré par le panneau Paramètres)
ClientState.FeaturesChanged:Connect(function()
	SoundManager.SetMusicAllowed(ClientState.HasFeature("Lofi"))
end)

-- 8. Au premier état reçu : on ouvre le cadeau du jour s'il est disponible
local firstState
firstState = ClientState.Changed:Connect(function(data)
	firstState:Disconnect()
	if ClientState.HasFeature("Daily") and data.Daily and data.Daily.Available then
		task.delay(1.5, function()
			if not PanelManager.IsOpen() then
				PanelManager.Open("Daily")
			end
		end)
	end
end)

-- 9. On prévient le serveur que l'interface est prête
Net.Event("ClientReady"):FireServer()
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>

----------------------------------------------------------------------
-- Utilitaires
----------------------------------------------------------------------

local function invoke(action: string, argument: any): (boolean, any)
	local ok, success, value = pcall(function()
		return Net.Function("World"):InvokeServer(action, argument)
	end)
	if not ok then
		return false, Locale.T("Network error, try again.")
	end
	return success == true, value
end

local function toast(text: string, color: Color3?)
	if hud then
		hud:Toast(text, color)
	end
end

local function rootPart(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function plotCount(): number
	local folder = workspace:FindFirstChild("DopamineTown")
	local count = folder and folder:GetAttribute("PlotCount")
	return type(count) == "number" and count or WorldLayout.PlotCount(Players.MaxPlayers)
end

-- Ami Roblox ? (cache ; la 1re fois la réponse arrive un peu plus tard)
local function isFriend(userId: number): boolean
	local cached = friendCache[userId]
	if cached ~= nil then
		return cached
	end
	if not friendPending[userId] then
		friendPending[userId] = true
		task.spawn(function()
			local ok, result = pcall(function()
				return LocalPlayer:IsFriendsWithAsync(userId)
			end)
			friendCache[userId] = ok and result == true
			friendPending[userId] = nil
		end)
	end
	return false
end

-- Le joueur local peut-il entrer dans cette maison ?
local function canEnter(snapshot: any): boolean
	local userId = tonumber(snapshot.UserId) or 0
	if userId == LocalPlayer.UserId then
		return true
	end
	local mode = WorldLayout.NormalizeOpen(snapshot.Open)
	return WorldLayout.CanEnter(mode, false, mode == "Friends" and isFriend(userId))
end

----------------------------------------------------------------------
-- Modules v9.5 (autres agents) : chargés PARESSEUSEMENT, en pcall ; absents
-- ou en erreur -> ignorés sans bruit (la ville marche sans eux)
----------------------------------------------------------------------

local optionalCache: { [string]: any } = {}
local function optionalModule(name: string): any
	local cached = optionalCache[name]
	if cached ~= nil then
		return cached or nil
	end
	local module = script.Parent:FindFirstChild(name)
	local ok, result = false, nil
	if module and module:IsA("ModuleScript") then
		ok, result = pcall(require, module)
	end
	optionalCache[name] = (ok and type(result) == "table") and result or false
	return optionalCache[name] or nil
end

-- 🖥️ Bureau (DeskMode, SETUP3D95) : l'avatar est assis à son setup ?
local function deskActive(): boolean
	local desk = optionalModule("DeskMode")
	if not desk or type(desk.IsActive) ~= "function" then
		return false
	end
	local ok, result = pcall(desk.IsActive)
	return ok and result == true
end

local function deskCall(method: string)
	local desk = optionalModule("DeskMode")
	local fn = desk and desk[method]
	if type(fn) == "function" then
		local ok, err = pcall(fn)
		if not ok then
			warn("[Town] DeskMode." .. method .. " : " .. tostring(err))
		end
	end
end

----------------------------------------------------------------------
-- 🌻 Jardins de Dopamine 3D (GardenBuilder, GARDEN3D95)
----------------------------------------------------------------------

local function destroyGarden(userId: number)
	local garden = gardens[userId]
	gardens[userId] = nil
	if garden then
		pcall(garden.Destroy, garden)
	end
end

local function createGarden(userId: number, house: any, snapshot: any, plot: number, count: number)
	local GardenBuilder = optionalModule("GardenBuilder")
	if not GardenBuilder or gardens[userId] then
		return
	end
	local ok, result = pcall(function()
		local plotCF = WorldLayout.PlotCFrame(plot, count)
		local origin, size
		if type(GardenBuilder.BackyardArea) == "function" then
			origin, size = GardenBuilder.BackyardArea(plotCF)
		else
			origin, size = GardenBuilder.BackyardCFrame(plotCF), GardenBuilder.BACKYARD_SIZE
		end
		local garden = GardenBuilder.new(house.Model, origin, size, userId == LocalPlayer.UserId, { OwnerName = snapshot.DisplayName })
		garden:Update(snapshot.DopamineGarden)
		return garden
	end)
	if ok and result then
		gardens[userId] = result
	else
		warn("[Town] Jardin " .. tostring(userId) .. " : " .. tostring(result))
	end
end

----------------------------------------------------------------------
-- Maisons
----------------------------------------------------------------------

local function onSeat(house: any, slot: number, model: Model, seatPart: BasePart)
	if edit and edit:IsEnabled() then
		return
	end
	if emotes then
		emotes:Stop("sit")
	end
	local function sit(cf: CFrame, kind: string?)
		task.spawn(function()
			local ok, message = invoke("sit", { Owner = house.UserId, Slot = slot, CFrame = cf, Kind = kind })
			if not ok and type(message) == "string" then
				toast(message, Color3.fromRGB(226, 80, 90))
			end
		end)
	end
	-- v9.8 🪑 (SEAT98) : tirer la chaise, s'avancer, puis s'asseoir (SitAnimator)
	local sitAnimator = optionalModule("SitAnimator")
	if sitAnimator and type(sitAnimator.Approach) == "function" then
		if pcall(sitAnimator.Approach, model, seatPart, sit) then
			return
		end
	end
	sit(seatPart.CFrame * CFrame.new(0, seatPart.Size.Y / 2, 0), nil)
end

local function syncHouses()
	local folder = housesFolder
	if not inTown or not folder then
		return
	end
	local count = plotCount()
	for userId, house in pairs(houses) do
		local snapshot = snapshots[userId]
		if not snapshot or not snapshot.Plot or tonumber(house.Model:GetAttribute("Plot")) ~= snapshot.Plot then
			destroyGarden(userId)
			house:Destroy()
			houses[userId] = nil
		end
	end
	local missing = false
	for userId, snapshot in pairs(snapshots) do
		local plot = tonumber(snapshot.Plot)
		if plot then
			local house = houses[userId]
			if house then
				local ok, err = pcall(house.Update, house, snapshot)
				if not ok then
					warn("[Town] Maison " .. tostring(userId) .. " : " .. tostring(err))
				end
				-- v10 🏗️ nouveau style -> la maison se reconstruit sous nos yeux (CONSTRUCT10)
				local construction = optionalModule("HouseConstruction")
				if construction and type(construction.Observe) == "function" then
					pcall(construction.Observe, userId, house, snapshot)
				end
				local garden = gardens[userId]
				if garden then
					pcall(garden.Update, garden, snapshot.DopamineGarden)
				end
			else
				missing = true
			end
		end
	end
	-- nouvelles maisons : une par image (jamais des milliers de pièces d'un coup)
	if missing and not creating then
		creating = true
		task.spawn(function()
			while inTown and housesFolder == folder do
				local nextId: number? = nil
				local nextPlot = 0
				-- (la sienne d'abord, puis les autres)
				for userId, snapshot in pairs(snapshots) do
					if not houses[userId] and tonumber(snapshot.Plot) and (nextId == nil or userId == LocalPlayer.UserId) then
						nextId, nextPlot = userId, tonumber(snapshot.Plot) :: number
					end
				end
				if not nextId then
					break
				end
				local snapshot = snapshots[nextId :: number]
				local ok, result = pcall(HouseBuilder.new, snapshot, WorldLayout.PlotCFrame(nextPlot, count), folder)
				if ok then
					result.Model:SetAttribute("Plot", nextPlot)
					result.OnSeat = onSeat
					houses[nextId :: number] = result
					createGarden(nextId :: number, result, snapshot, nextPlot, count)
					-- v10 🏗️ joueur qui arrive : sa maison se construit (chantier -> maison) (CONSTRUCT10)
					local construction = optionalModule("HouseConstruction")
					if construction and type(construction.Observe) == "function" then
						pcall(construction.Observe, nextId, result, snapshot)
					end
				else
					warn("[Town] Maison " .. tostring(nextId) .. " : " .. tostring(result))
					snapshots[nextId :: number] = nil
				end
				task.wait()
			end
			creating = false
		end)
	end
end

local function myHouse(): any
	return houses[LocalPlayer.UserId]
end

----------------------------------------------------------------------
-- Événements du serveur
----------------------------------------------------------------------

local function heartsAt(position: Vector3)
	local folder = housesFolder
	if not folder then
		return
	end
	local anchor = Instance.new("Part")
	anchor.Name = "Hearts"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(1, 1, 1)
	anchor.CFrame = CFrame.new(position)
	anchor.Parent = folder
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(Color3.fromRGB(255, 90, 150), Color3.fromRGB(255, 180, 210))
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 1.6) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
	emitter.Lifetime = NumberRange.new(1, 1.6)
	emitter.Speed = NumberRange.new(6, 10)
	emitter.SpreadAngle = Vector2.new(40, 40)
	emitter.Acceleration = Vector3.new(0, 4, 0)
	emitter.Rate = 0
	emitter.Parent = anchor
	pcall(function()
		emitter:Emit(24)
	end)
	task.delay(2.5, function()
		anchor:Destroy()
	end)
end

local function onEvent(kind: any, payload: any)
	if kind == "Houses" and type(payload) == "table" then
		table.clear(snapshots)
		for _, snapshot in ipairs(payload) do
			if type(snapshot) == "table" and tonumber(snapshot.UserId) then
				snapshots[tonumber(snapshot.UserId) :: number] = snapshot
			end
		end
		syncHouses()
	elseif kind == "House" and type(payload) == "table" and tonumber(payload.UserId) then
		snapshots[tonumber(payload.UserId) :: number] = payload
		syncHouses()
		contextKey = ""
	elseif kind == "Gone" and tonumber(payload) then
		snapshots[tonumber(payload) :: number] = nil
		syncHouses()
	elseif kind == "Liked" and type(payload) == "table" then
		local house = houses[tonumber(payload.Owner) or 0]
		if house then
			heartsAt(house:DoorPosition() + Vector3.new(0, 6, 0))
		end
	elseif kind == "Toast" and type(payload) == "string" then
		toast(payload)
	end
end

----------------------------------------------------------------------
-- Ambiance (éclairage, interfaces, contrôles) : sauvegarde / remise
----------------------------------------------------------------------

-- Interfaces de Roblox (manette tactile, invites, chat...) : jamais masquées
local KEEP_GUIS: { [string]: boolean } = {
	TownHud = true,
	TownOverlay = true,
	TouchGui = true,
	ProximityPrompts = true,
	BubbleChat = true,
	Chat = true,
	Freecam = true,
	DeskModeGui = true, -- v9.5 🖥️ barre "Se lever" du bureau (DeskMode)
	MusicStageGui = true, -- v9.9 🎵 panneau de jeu des instruments, choix des morceaux (MusicStage, MUSIC99)
	HouseFacadeEditor = true, -- v10 🏠 éditeur 3D de l'extérieur de la maison (HOUSE10)
	RaceGui = true, -- v10 🏁 courses de rue : menu, HUD de course, résultats (RaceHud, RACE10)
	FairGui = true, -- v9.8 🍦 menu des stands, badge du boost, bouton Croquer (FairFx, FAIR98)
	GardenEditGui = true, -- v9.8 🌷 mode édition du jardin (GardenEdit, GARDEN98)
	TownGraphicsGui = true, -- v9.8 🎨 fenêtre Graphismes en ville (TownGraphics, REALISM98)
	TownInventoryGui = true, -- v9.6 plateau inventaire 3D (FurnitureEdit, PLACE96)
	TownShopGui = true, -- v9.6 catalogue des magasins (ShopUI, SHOPS96)
	CarGui = true, -- v9.6 conduite (CarClient, GARAGE96)
	ConstructionGui = true, -- v10 🏗️ "Ta maison se construit…", ⏭ Passer, "Ta maison est prête !" (HouseConstruction, CONSTRUCT10)
}
local function keepGui(name: string): boolean
	return KEEP_GUIS[name] == true or string.find(name, "Touch", 1, true) ~= nil or string.find(name, "Prompt", 1, true) ~= nil
		or string.find(name, "Chat", 1, true) ~= nil
end

local function hideGui(s: Saved, gui: Instance)
	if gui:IsA("ScreenGui") and not keepGui(gui.Name) and gui.Enabled then
		table.insert(s.Guis, gui)
		gui.Enabled = false
	end
end

local function applyControls(s: Saved)
	local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if playerGui then
		for _, gui in ipairs(playerGui:GetChildren()) do
			hideGui(s, gui)
		end
		-- une interface qui apparaît pendant la promenade est masquée aussi
		table.insert(connections, playerGui.ChildAdded:Connect(function(child)
			if inTown and saved then
				task.defer(function()
					if inTown and saved and child.Parent then
						hideGui(saved, child)
					end
				end)
			end
		end))
	end
	pcall(function()
		s.Touch = GuiService.TouchControlsEnabled
		GuiService.TouchControlsEnabled = true
	end)
	pcall(function()
		s.ChatWindow = TextChatService.ChatWindowConfiguration.Enabled
		TextChatService.ChatWindowConfiguration.Enabled = true
	end)
	pcall(function()
		s.ChatInput = TextChatService.ChatInputBarConfiguration.Enabled
		TextChatService.ChatInputBarConfiguration.Enabled = true
	end)
	pcall(function()
		local bubbles = TextChatService:FindFirstChildOfClass("BubbleChatConfiguration")
		if bubbles then
			bubbles.Enabled = true
		end
	end)
	pcall(function()
		s.CoreChat = StarterGui:GetCoreGuiEnabled(Enum.CoreGuiType.Chat)
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, true)
	end)
	pcall(function()
		s.MaxZoom = LocalPlayer.CameraMaxZoomDistance
		s.MinZoom = LocalPlayer.CameraMinZoomDistance
		LocalPlayer.CameraMaxZoomDistance = MAX_ZOOM
		LocalPlayer.CameraMinZoomDistance = MIN_ZOOM
	end)
end

local function restoreControls(s: Saved)
	for _, gui in ipairs(s.Guis) do
		if gui.Parent then
			gui.Enabled = true
		end
	end
	table.clear(s.Guis)
	pcall(function()
		if s.Touch ~= nil then
			GuiService.TouchControlsEnabled = s.Touch
		end
	end)
	pcall(function()
		if s.ChatWindow ~= nil then
			TextChatService.ChatWindowConfiguration.Enabled = s.ChatWindow
		end
	end)
	pcall(function()
		if s.ChatInput ~= nil then
			TextChatService.ChatInputBarConfiguration.Enabled = s.ChatInput
		end
	end)
	pcall(function()
		if s.CoreChat ~= nil then
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, s.CoreChat)
		end
	end)
	pcall(function()
		if s.MaxZoom then
			LocalPlayer.CameraMaxZoomDistance = s.MaxZoom
		end
		if s.MinZoom then
			LocalPlayer.CameraMinZoomDistance = s.MinZoom
		end
	end)
end

----------------------------------------------------------------------
-- Avatars : étiquettes, émotes
----------------------------------------------------------------------

local function refreshTags()
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local head = character and character:FindFirstChild("Head")
		local snapshot = snapshots[player.UserId]
		if head and head:IsA("BasePart") then
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			end
			local tag = head:FindFirstChild("TownTag")
			if not tag then
				local billboard = Instance.new("BillboardGui")
				billboard.Name = "TownTag"
				-- (taille en studs : l'étiquette rapetisse avec la distance, comme le monde)
				billboard.Size = UDim2.new(7, 0, 1.9, 0)
				billboard.StudsOffset = Vector3.new(0, 2.4, 0)
				billboard.MaxDistance = 90
				billboard.LightInfluence = 0
				billboard.AlwaysOnTop = false
				billboard.Adornee = head
				local name = Instance.new("TextLabel")
				name.Name = "Name"
				name.BackgroundTransparency = 1
				name.Size = UDim2.fromScale(1, 0.56)
				name.Font = Enum.Font.FredokaOne
				name.TextScaled = true
				name.TextColor3 = Color3.new(1, 1, 1)
				name.TextStrokeColor3 = Color3.fromRGB(150, 60, 120)
				name.TextStrokeTransparency = 0.2
				name.Parent = billboard
				local info = Instance.new("TextLabel")
				info.Name = "Info"
				info.BackgroundColor3 = Color3.fromRGB(255, 120, 180)
				info.BackgroundTransparency = 0.15
				info.AnchorPoint = Vector2.new(0.5, 0)
				info.Position = UDim2.fromScale(0.5, 0.58)
				info.Size = UDim2.fromScale(0.62, 0.4)
				info.Font = Enum.Font.GothamBold
				info.TextScaled = true
				info.TextColor3 = Color3.new(1, 1, 1)
				info.Parent = billboard
				local corner = Instance.new("UICorner")
				corner.CornerRadius = UDim.new(1, 0)
				corner.Parent = info
				local padding = Instance.new("UIPadding")
				padding.PaddingLeft = UDim.new(0, 6)
				padding.PaddingRight = UDim.new(0, 6)
				padding.PaddingTop = UDim.new(0, 2)
				padding.PaddingBottom = UDim.new(0, 2)
				padding.Parent = info
				billboard.Parent = head
				tag = billboard
			end
			local nameLabel = tag:FindFirstChild("Name") :: TextLabel?
			local infoLabel = tag:FindFirstChild("Info") :: TextLabel?
			if nameLabel then
				nameLabel.Text = player.DisplayName
			end
			if infoLabel then
				local rebirths = snapshot and tonumber(snapshot.Rebirths) or 0
				local likes = snapshot and tonumber(snapshot.Likes) or 0
				infoLabel.Text = string.format("🌊 %s   ❤️ %s", NumberFormatter.Format(rebirths), NumberFormatter.Format(likes))
			end
		end
	end
end

-- Émotes : TownEmotes garde la piste et l'arrête (bouger, sauter, bouton…)
local function playEmote(name: string)
	if not emotes then
		return
	end
	if edit and edit:IsEnabled() and name ~= "sit" then
		edit:SetEnabled(false)
	end
	emotes:Play(name)
end

----------------------------------------------------------------------
-- Contexte : dans quelle maison (ou devant laquelle) est le joueur
----------------------------------------------------------------------

local function computeContext(): any
	local root = rootPart(LocalPlayer)
	if not root then
		return nil
	end
	local position = root.Position
	local best: any = nil
	for userId, house in pairs(houses) do
		local snapshot = snapshots[userId]
		if snapshot then
			local x, y, d = WorldLayout.ToLocal(house.HouseCF, position)
			local inside = WorldLayout.InsideHouse(house.Size, x, y, d, 0)
			local onPlot = false
			if not inside then
				local rel = house.PlotCF:PointToObjectSpace(position)
				onPlot = math.abs(rel.X) <= WorldLayout.PLOT_W / 2 and math.abs(rel.Z) <= WorldLayout.PLOT_D / 2 + 10
			end
			if inside or onPlot then
				best = {
					Snapshot = snapshot,
					IsOwner = userId == LocalPlayer.UserId,
					Locked = not canEnter(snapshot),
					InHouse = inside,
					House = house,
				}
				if inside then
					break
				end
			end
		end
	end
	return best
end

local function refreshContext()
	local context = computeContext()
	currentContext = context
	local snapshot = context and context.Snapshot
	local key = context and table.concat({ tostring(snapshot.UserId), tostring(context.InHouse), tostring(context.Locked), tostring(snapshot.Likes),
		tostring(snapshot.Visits), tostring(snapshot.Open) }, "|") or ""
	if key ~= contextKey then
		contextKey = key
		if hud then
			hud:SetContext(context)
		end
	end
	if edit and edit:IsEnabled() and not (context and context.IsOwner and context.InHouse) and not edit:IsHolding() then
		edit:SetEnabled(false)
	end
end

----------------------------------------------------------------------
-- Boucle
----------------------------------------------------------------------

local function stepDoors()
	local positions: { Vector3 } = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local root = rootPart(player)
		if root then
			table.insert(positions, root.Position)
		end
	end
	for userId, house in pairs(houses) do
		local snapshot = snapshots[userId]
		if snapshot then
			local door = house:DoorPosition()
			local near = false
			for _, p in ipairs(positions) do
				if (p - door).Magnitude < DOOR_RANGE then
					near = true
					break
				end
			end
			house:StepDoor(near, not canEnter(snapshot))
		end
	end
end

local function stepStream()
	if roomBuilding then
		return
	end
	local root = rootPart(LocalPlayer)
	local camera = workspace.CurrentCamera
	local focus = root and root.Position or (camera and camera.Focus.Position)
	if not focus then
		return
	end
	local bestHouse, bestSlot, bestDistance = nil, nil, math.huge
	for _, house in pairs(houses) do
		local slot, distance = house:NextToBuild(focus)
		if slot and distance < bestDistance then
			bestHouse, bestSlot, bestDistance = house, slot, distance
		end
	end
	if bestHouse and bestSlot then
		roomBuilding = true
		task.spawn(function()
			local ok, err = pcall(bestHouse.BuildRoom, bestHouse, bestSlot)
			if not ok then
				warn("[Town] Pièce : " .. tostring(err))
			end
			roomBuilding = false
		end)
	end
end

----------------------------------------------------------------------
-- 🌐 Panneaux de la ville (construits en anglais par le serveur) : chaque
-- TextLabel qui porte l'attribut "LocText" (clé anglaise) est traduit ici ;
-- panneaux reconstruits : DescendantAdded + petite minuterie (2 s)
----------------------------------------------------------------------

local function localizeLabel(label: Instance)
	local key = label:GetAttribute("LocText")
	if type(key) == "string" and key ~= "" then
		local text = Locale.T(key)
		if (label :: any).Text ~= text then
			(label :: any).Text = text
		end
	end
end

local function trackLabel(object: Instance)
	if object:IsA("TextLabel") then
		table.insert(locLabels, object)
		localizeLabel(object)
	end
end

local function localizeTown()
	for index = #locLabels, 1, -1 do
		local label = locLabels[index]
		if label.Parent == nil then
			table.remove(locLabels, index)
		else
			localizeLabel(label)
		end
	end
end

local function watchTownLabels()
	table.clear(locLabels)
	local folder = workspace:FindFirstChild("DopamineTown")
	if not folder then
		return
	end
	for _, object in ipairs(folder:GetDescendants()) do
		trackLabel(object)
	end
	table.insert(connections, folder.DescendantAdded:Connect(function(object)
		if object:IsA("TextLabel") then
			-- (l'attribut / le texte arrivent parfois juste après)
			task.defer(function()
				if inTown and object.Parent then
					trackLabel(object)
				end
			end)
		end
	end))
end

----------------------------------------------------------------------
-- Arrivée : guide vers sa maison, boussole
----------------------------------------------------------------------

-- Porte de ENTRÉE de la ville (TownMap via l'attribut "EntranceCF")
local function townCFrame(attribute: string): CFrame?
	local folder = workspace:FindFirstChild("DopamineTown")
	local value = folder and folder:GetAttribute(attribute)
	if typeof(value) == "CFrame" then
		return value
	end
	return nil
end

local function plazaCenter(): Vector3
	local plaza = townCFrame("PlazaCF")
	return plaza and plaza.Position or WorldLayout.Origin()
end

local function startGuide()
	local house = myHouse()
	if not house or not housesFolder then
		guidePending = true
		return
	end
	guidePending = false
	if not guide then
		guide = TownArrival.Guide(housesFolder)
	end
	local ok, err = pcall(function()
		guide:Start(LocalPlayer.Character, house:DoorPosition())
	end)
	if not ok then
		warn("[Town] Guide : " .. tostring(err))
	end
end

local function stepGuide()
	local house = myHouse()
	local root = rootPart(LocalPlayer)
	if guidePending and house then
		startGuide()
	end
	local context = currentContext
	local home = context ~= nil and context.IsOwner
	if guide and guide:IsActive() then
		local distance = guide:Update(root and root.Position)
		if home or distance < GUIDE_DONE then
			guide:Stop()
			toast(Locale.T("🏠 Here's your house! Walk in, it's all yours"), Color3.fromRGB(236, 72, 140))
		end
	end
	-- boussole : visible dès qu'on n'est pas chez soi (et pas pendant le survol)
	local camera = workspace.CurrentCamera
	local showing = house ~= nil and root ~= nil and camera ~= nil and not home and not (intro and intro:IsRunning())
	if showing and house and root and camera then
		local door = house:DoorPosition()
		hud:SetCompass(true, TownArrival.Bearing(camera, root.Position, door), (Vector3.new(door.X, 0, door.Z) - Vector3.new(root.Position.X, 0, root.Position.Z)).Magnitude)
	else
		hud:SetCompass(false)
	end
end

local function step(dt: number)
	if not inTown then
		return
	end
	clocks.Counter += dt
	clocks.Door += dt
	clocks.Stream += dt
	clocks.Tag += dt
	clocks.Guide += dt
	clocks.Loc += dt
	TownAtmosphere.Step(dt)
	-- v9.8 🐾 animaux (pause pendant l'édition des meubles) + 🌷 bouton / sauvegarde du jardin (GARDEN98)
	local petRoam = optionalModule("PetRoam")
	if petRoam and type(petRoam.Step) == "function" then
		pcall(petRoam.SetPaused, edit ~= nil and edit:IsEnabled())
		pcall(petRoam.Step, dt)
	end
	local gardenEdit = optionalModule("GardenEdit")
	if gardenEdit and type(gardenEdit.Step) == "function" then
		pcall(gardenEdit.Step, dt)
	end
	-- v9.7 🎠 place centrale (TownPlazaFx : 30 Hz au plus, en pause au loin)
	local plazaFx = optionalModule("TownPlazaFx")
	if plazaFx and type(plazaFx.Step) == "function" then
		local okFx, errFx = pcall(plazaFx.Step, dt)
		if not okFx and not plazaFxWarned then
			plazaFxWarned = true
			warn("[Town] TownPlazaFx.Step : " .. tostring(errFx))
		end
	end
	-- v9.8 🎡 fête foraine (FairFx : 30 Hz au plus ; le manège où l'on est assis : à chaque image)
	local fairFx = optionalModule("FairFx")
	if fairFx and type(fairFx.Step) == "function" then
		local okFair, errFair = pcall(fairFx.Step, dt)
		if not okFair and not fairFxWarned then
			fairFxWarned = true
			warn("[Town] FairFx.Step : " .. tostring(errFair))
		end
	end
	-- v9.9 🎵 scène musicale (MusicStage : notes, morceaux, décor en flux)
	local musicStage = optionalModule("MusicStage")
	if musicStage and type(musicStage.Step) == "function" then
		local okMusic, errMusic = pcall(musicStage.Step, dt)
		if not okMusic and not musicStageWarned then
			musicStageWarned = true
			warn("[Town] MusicStage.Step : " .. tostring(errMusic))
		end
	end
	-- v10 🏁 courses de rue (RaceClient : IA lissées, feux synchronisés, HUD)
	local raceClient = optionalModule("RaceClient")
	if raceClient and type(raceClient.Step) == "function" then
		local okRace, errRace = pcall(raceClient.Step, dt)
		if not okRace and not raceClientWarned then
			raceClientWarned = true
			warn("[Town] RaceClient.Step : " .. tostring(errRace))
		end
	end
	-- v10 🏗️ chantiers des parcelles libres + maisons qui se construisent (HouseConstruction, CONSTRUCT10)
	local construction = optionalModule("HouseConstruction")
	if construction and type(construction.Step) == "function" then
		local okC, errC = pcall(construction.Step, dt)
		if not okC and not constructionWarned then
			constructionWarned = true
			warn("[Town] HouseConstruction.Step : " .. tostring(errC))
		end
	end
	if clocks.Loc >= LOC_EVERY then
		clocks.Loc = 0
		pcall(localizeTown)
	end
	if clocks.Counter >= COUNTER_EVERY then
		clocks.Counter = 0
		if hud then
			hud:UpdateCounter()
		end
		if emotes then
			local ok, err = pcall(emotes.Step, emotes)
			if not ok then
				warn("[Town] Émotes : " .. tostring(err))
			end
		end
	end
	if clocks.Guide >= GUIDE_EVERY then
		clocks.Guide = 0
		local ok, err = pcall(stepGuide)
		if not ok then
			warn("[Town] Guide : " .. tostring(err))
		end
	end
	if clocks.Door >= DOOR_EVERY then
		clocks.Door = 0
		local ok, err = pcall(function()
			stepDoors()
			refreshContext()
		end)
		if not ok then
			warn("[Town] " .. tostring(err))
		end
	end
	if clocks.Stream >= STREAM_EVERY then
		clocks.Stream = 0
		local ok, err = pcall(stepStream)
		if not ok then
			warn("[Town] Flux : " .. tostring(err))
		end
		-- 📺 accessoires "live" (LiveProps, SETUP3D95) autour de l'avatar
		local live = optionalModule("LiveProps")
		local root = rootPart(LocalPlayer)
		if live and root and type(live.SetFocus) == "function" then
			pcall(live.SetFocus, root.Position)
		end
		local shops = optionalModule("ShopInteriors")
		if shops and root and type(shops.Step) == "function" then
			pcall(shops.Step, root.Position)
		end
		local traffic = optionalModule("TownTraffic")
		if traffic and root and type(traffic.Step) == "function" then
			pcall(traffic.Step, root.Position)
		end
		local facades = optionalModule("TownFacades")
		if facades and root and type(facades.Step) == "function" then
			pcall(facades.Step, root.Position)
		end
		local marketMod = optionalModule("MarketInterior")
		if marketMod and root and type(marketMod.Step) == "function" then
			pcall(marketMod.Step, root.Position)
		end
		-- v9.7 🌳 nature : détails de près autour de l'avatar (TownGreenery, NATURE97)
		local greenery = optionalModule("TownGreenery")
		if greenery and root and type(greenery.Step) == "function" then
			pcall(greenery.Step, root.Position)
		end
		-- v9.8 🏙️ vie de la rue (CITY98)
		for _, name in ipairs({ "TownStreetLife", "TownPeople" }) do
			local lifeMod = optionalModule(name)
			if lifeMod and root and type(lifeMod.Step) == "function" then
				pcall(lifeMod.Step, root.Position)
			end
		end
	end
	if clocks.Tag >= TAG_EVERY then
		clocks.Tag = 0
		pcall(refreshTags)
	end
end

----------------------------------------------------------------------
-- Entrer / sortir
----------------------------------------------------------------------

local function closeClickerWindows()
	pcall(function()
		local PanelManager = require(Components:WaitForChild("PanelManager")) :: any
		if PanelManager.IsOpen() then
			PanelManager.Close()
		end
	end)
	pcall(function()
		local module = Components:FindFirstChild("House") and Components.House:FindFirstChild("House3D")
		if module then
			local House3D = require(module) :: any
			if House3D.IsOpen() then
				House3D.Close()
			end
		end
	end)
end

local function waitCharacter(timeout: number): Model?
	local started = os.clock()
	while os.clock() - started < timeout do
		local character = LocalPlayer.Character
		if character and character:FindFirstChild("HumanoidRootPart") then
			return character
		end
		task.wait(0.1)
	end
	return nil
end

local leave: () -> ()

-- Aller dans une pièce (sa maison ou celle d'un autre) : on la construit d'abord
local function goRoom(ownerId: number, slot: number)
	local house = houses[ownerId]
	if house and house.Rooms[slot] and house.Rooms[slot].State ~= "Built" then
		roomBuilding = true
		pcall(house.BuildRoom, house, slot)
		roomBuilding = false
	end
	local ok, message = invoke("room", { Owner = ownerId, Slot = slot })
	if not ok and type(message) == "string" then
		toast(message, Color3.fromRGB(226, 80, 90))
	end
end

-- Caméra de Roblox qui suit l'avatar
local function followCamera(character: Model?)
	-- (au bureau, DeskMode tient la caméra : on n'y touche pas)
	if deskActive() then
		return
	end
	local camera = workspace.CurrentCamera
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if camera and humanoid then
		camera.CameraType = Enum.CameraType.Custom
		camera.CameraSubject = humanoid
	end
end

-- 🖥️ DeskMode.Changed (une fois par session) : au bureau, plus d'émote ni
-- de mode édition, boutons 😀 / ✏️ cachés (DeskMode a son "Se lever")
local function wireDesk()
	if deskWired then
		return
	end
	local desk = optionalModule("DeskMode")
	local changed = desk and desk.Changed
	if not changed then
		return
	end
	deskWired = true
	local ok, err = pcall(function()
		changed:Connect(function(active: boolean)
			if not inTown then
				return
			end
			if active then
				if emotes then
					emotes:Stop("desk")
				end
				if edit and edit:IsEnabled() then
					edit:SetEnabled(false)
				end
			end
			hud:SetDeskMode(active == true)
			if emotes then
				emotes:Notify()
			end
		end)
	end)
	if not ok then
		warn("[Town] DeskMode.Changed : " .. tostring(err))
	end
end

-- Survol de la ville (1re arrivée de la session), puis le guide
local function playIntro(character: Model)
	local camera = workspace.CurrentCamera
	local entrance = townCFrame("EntranceCF")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not entrance and root and root:IsA("BasePart") then
		entrance = root.CFrame
	end
	if not camera or not entrance then
		followCamera(character)
		startGuide()
		return
	end
	-- (l'avatar arrive exactement là où le survol se termine)
	if root and root:IsA("BasePart") then
		entrance = CFrame.new(root.Position) * entrance.Rotation
	end
	introSeen = true
	local path = TownArrival.MakePath(entrance :: CFrame, plazaCenter())
	hud:SetCinematic(true, Locale.T("Welcome, %s!", LocalPlayer.DisplayName))
	intro = TownArrival.Intro({
		Camera = camera,
		Path = path,
		OnProgress = function(t: number)
			hud:SetIntroProgress(t)
		end,
		OnDone = function(_skipped: boolean)
			intro = nil
			hud:SetCinematic(false)
			if inTown then
				followCamera(LocalPlayer.Character)
				startGuide()
				toast(Locale.T("🚶 Welcome to Dopamine Town!"), Color3.fromRGB(236, 72, 140))
				toast(Locale.T("Your house: follow the 🧭 compass, or tap 🏠 Go home"))
				-- v10 🏗️ moment "ta maison se construit" (CONSTRUCT10)
				local construction = optionalModule("HouseConstruction")
				if construction and type(construction.ArrivalDone) == "function" then
					pcall(construction.ArrivalDone)
				end
			end
		end,
	})
end

local function onCharacter(character: Model)
	if not inTown then
		return
	end
	character:WaitForChild("Humanoid", 5)
	if not inTown or LocalPlayer.Character ~= character then
		return
	end
	if not (intro and intro:IsRunning()) then
		followCamera(character)
	end
	if emotes then
		emotes:Attach(character)
	end
	if guide and guide:IsActive() then
		guide:Attach(character)
	end
end

local function enter(options: any)
	if busy then
		return
	end
	if inTown then
		if type(options) == "table" and tonumber(options.Slot) then
			task.spawn(goRoom, LocalPlayer.UserId, tonumber(options.Slot) :: number)
		end
		return
	end
	busy = true
	closeClickerWindows()
	-- v9.5 🖥️ objets "Dopamine Setup" vivants : LiveProps s'accroche aux
	-- objets construits par HouseBuilder (idempotent, chaîne les crochets existants)
	local live = optionalModule("LiveProps")
	if live and type(live.BindHouseBuilder) == "function" then
		pcall(live.BindHouseBuilder, HouseBuilder)
	end
	local s: Saved = { Guis = {}, Lighting = {}, Effects = {}, Moved = {} }
	saved = s
	hud:SetVisible(true)
	hud:ShowLoading(true, Locale.T("Building the town…"), 0.08)
	applyControls(s)
	local camera = workspace.CurrentCamera
	s.CameraType = camera and camera.CameraType or nil
	local visit = type(options) == "table" and options.Visit or nil
	local slot = type(options) == "table" and tonumber(options.Slot) or nil
	task.spawn(function()
		local ok, result = invoke("enter", { Visit = visit, Slot = slot })
		if not ok then
			restoreControls(s)
			saved = nil
			hud:ShowLoading(false)
			hud:SetVisible(false)
			busy = false
			warn("[Town] " .. tostring(result))
			pcall(function()
				local Notifications = require(Components:WaitForChild("Notifications")) :: any
				Notifications.Show({ Text = tostring(result or Locale.T("Network error, try again.")), Icon = "🚶", Duration = 4 })
			end)
			return
		end
		inTown = true
		-- v9.6 🚗 voitures (CarClient, GARAGE96) : bouton, conduite, garages des manoirs
		local car = optionalModule("CarClient")
		if car and type(car.Start) == "function" then
			local okCar, errCar = pcall(car.Start, { Toast = toast })
			if not okCar then
				warn("[Town] CarClient.Start : " .. tostring(errCar))
			end
		end
		TownAtmosphere.SetNight(ClientState.IsUserDarkMode())
		TownAtmosphere.Apply(s)
		-- v9.8 🌦️ pas de pluie dans une pièce (Weather3D, REALISM98)
		local weather = optionalModule("Weather3D")
		if weather and type(weather.SetIndoorProbe) == "function" then
			weather.SetIndoorProbe(function(p: Vector3): boolean
				for _, house in pairs(houses) do
					if house:RoomAt(p) ~= nil then
						return true
					end
				end
				return false
			end)
		end
		-- v9.6 🛍️ boutiques où l'on entre : intérieurs en flux (SHOPS96)
		local shops = optionalModule("ShopInteriors")
		if shops and type(shops.Start) == "function" then
			local okShops, errShops = pcall(shops.Start, { Toast = toast })
			if not okShops then
				warn("[Town] ShopInteriors.Start : " .. tostring(errShops))
			end
		end
		-- v9.8 🌷 jardin libre (GardenEdit) + 🐾 animaux qui se promènent (PetRoam) (GARDEN98)
		local gardenEdit = optionalModule("GardenEdit")
		if gardenEdit and type(gardenEdit.Start) == "function" then
			local okGE, errGE = pcall(gardenEdit.Start, {
				Toast = toast,
				GetGarden = function()
					return gardens[LocalPlayer.UserId]
				end,
				IsBusy = function()
					return (edit ~= nil and edit:IsEnabled()) or deskActive()
				end,
			})
			if not okGE then
				warn("[Town] GardenEdit.Start : " .. tostring(errGE))
			end
		end
		local petRoam = optionalModule("PetRoam")
		if petRoam and type(petRoam.Start) == "function" then
			local okPR, errPR = pcall(petRoam.Start, {
				GetHouses = function()
					return houses
				end,
			})
			if not okPR then
				warn("[Town] PetRoam.Start : " .. tostring(errPR))
			end
		end
		-- v9.7 🚦 circulation d'ambiance + véhicules du décor en flux (TownTraffic, VEHICLES97)
		local traffic = optionalModule("TownTraffic")
		if traffic and type(traffic.Start) == "function" then
			local okTraffic, errTraffic = pcall(traffic.Start, { Toast = toast })
			if not okTraffic then
				warn("[Town] TownTraffic.Start : " .. tostring(errTraffic))
			end
		end
		-- v9.7 🏘️ détail des immeubles de rue + 🛒 supermarché MégaDopa (BUILDINGS97)
		local facades = optionalModule("TownFacades")
		if facades and type(facades.Start) == "function" then
			local okF, errF = pcall(facades.Start)
			if not okF then
				warn("[Town] TownFacades.Start : " .. tostring(errF))
			end
		end
		local marketMod = optionalModule("MarketInterior")
		if marketMod and type(marketMod.Start) == "function" then
			local okM, errM = pcall(marketMod.Start, { Toast = toast })
			if not okM then
				warn("[Town] MarketInterior.Start : " .. tostring(errM))
			end
		end
		-- v9.9 🏛️ écran « Meilleurs joueurs du serveur » + horloges de la ville (SHOPS99)
		local displays = optionalModule("TownDisplays")
		if displays and type(displays.Start) == "function" then
			local okD, errD = pcall(displays.Start)
			if not okD then
				warn("[Town] TownDisplays.Start : " .. tostring(errD))
			end
		end
		-- v9.7 🎠 place centrale animée (TownPlazaFx, PLAZA97) : manège, ballons, pigeons…
		local plazaFx = optionalModule("TownPlazaFx")
		if plazaFx and type(plazaFx.Start) == "function" then
			local okFx, errFx = pcall(plazaFx.Start)
			if not okFx then
				warn("[Town] TownPlazaFx.Start : " .. tostring(errFx))
			end
		end
		-- v9.8 🎡 fête foraine + 🍦 nourriture (FairFx, FAIR98)
		local fairFx = optionalModule("FairFx")
		if fairFx and type(fairFx.Start) == "function" then
			local okFair, errFair = pcall(fairFx.Start, { Toast = toast })
			if not okFair then
				warn("[Town] FairFx.Start : " .. tostring(errFair))
			end
		end
		-- v9.9 🎵 scène musicale de la place (MusicStage, MUSIC99)
		local musicStage = optionalModule("MusicStage")
		if musicStage and type(musicStage.Start) == "function" then
			local okMusic, errMusic = pcall(musicStage.Start, { Toast = toast })
			if not okMusic then
				warn("[Town] MusicStage.Start : " .. tostring(errMusic))
			end
		end
		-- v10 🏁 courses de rue (RaceClient, RACE10) : QG, portiques, pilotes IA, HUD
		local raceClient = optionalModule("RaceClient")
		if raceClient and type(raceClient.Start) == "function" then
			local okRace, errRace = pcall(raceClient.Start, { Toast = toast })
			if not okRace then
				warn("[Town] RaceClient.Start : " .. tostring(errRace))
			end
		end
		-- v9.7 🌳 nature : détails de près (arbres, lac, aire de jeux) côté client (NATURE97)
		local greenery = optionalModule("TownGreenery")
		if greenery and type(greenery.Start) == "function" then
			local okGreen, errGreen = pcall(greenery.Start)
			if not okGreen then
				warn("[Town] TownGreenery.Start : " .. tostring(errGreen))
			end
		end
		-- v9.8 🏙️ vie de la rue : mobilier en flux + passants (CITY98)
		for _, name in ipairs({ "TownStreetLife", "TownPeople" }) do
			local lifeMod = optionalModule(name)
			if lifeMod and type(lifeMod.Start) == "function" then
				local okL, errL = pcall(lifeMod.Start)
				if not okL then
					warn("[Town] " .. name .. ".Start : " .. tostring(errL))
				end
			end
		end
		-- v9.8 🪑 s'asseoir pour de vrai : chaise tirée, transitions, animations d'attente (SEAT98)
		local sitAnimator = optionalModule("SitAnimator")
		if sitAnimator and type(sitAnimator.Start) == "function" then
			local okSit, errSit = pcall(sitAnimator.Start)
			if not okSit then
				warn("[Town] SitAnimator.Start : " .. tostring(errSit))
			end
		end
		-- v10 💥 se faire renverser, étoiles, se relever, sortir de voiture par la portière (PHYS10)
		local knockdown = optionalModule("Knockdown")
		if knockdown and type(knockdown.Start) == "function" then
			local okKd, errKd = pcall(knockdown.Start, { Toast = toast })
			if not okKd then
				warn("[Town] Knockdown.Start : " .. tostring(errKd))
			end
		end
		local folder = Instance.new("Folder")
		folder.Name = HOUSES_FOLDER
		folder.Parent = workspace
		housesFolder = folder
		-- v10 🏗️ chantiers + maisons qui se construisent (HouseConstruction, CONSTRUCT10)
		local construction = optionalModule("HouseConstruction")
		if construction and type(construction.Start) == "function" then
			local okC, errC = pcall(construction.Start, {
				Folder = folder,
				Toast = toast,
				Hud = hud,
				GetSnapshots = function()
					return snapshots
				end,
				GetHouses = function()
					return houses
				end,
			})
			if not okC then
				warn("[Town] HouseConstruction.Start : " .. tostring(errC))
			end
		end
		-- (les instantanés arrivent par l'événement "Houses" ; secours si besoin)
		if next(snapshots) == nil then
			local okList, list = invoke("houses", nil)
			if okList and type(list) == "table" then
				onEvent("Houses", list)
			end
		end
		syncHouses()
		table.insert(connections, RunService.Heartbeat:Connect(step))
		pcall(watchTownLabels)
		table.insert(connections, LocalPlayer.CharacterAdded:Connect(onCharacter))
		table.insert(connections, LocalPlayer.CharacterRemoving:Connect(function()
			if emotes then
				emotes:Detach()
			end
		end))
		-- nuit en ville = réglage ⚙️ "Mode sombre" du joueur (source "User")
		local function syncNight()
			TownAtmosphere.SetNight(ClientState.IsUserDarkMode())
		end
		table.insert(connections, ClientState.DarkModeChanged:Connect(syncNight))
		table.insert(connections, ClientState.DarkSourcesChanged:Connect(syncNight))
		-- chargement : personnage + maisons (barre de progression)
		local started = os.clock()
		local character: Model? = nil
		while inTown and os.clock() - started < 10 do
			local current = LocalPlayer.Character
			if current and current:FindFirstChild("HumanoidRootPart") then
				character = current
			end
			local total, built = 0, 0
			for userId, snapshot in pairs(snapshots) do
				if snapshot.Plot then
					total += 1
					if houses[userId] then
						built += 1
					end
				end
			end
			local ratio = total > 0 and built / total or 1
			hud:SetLoadingProgress(0.15 + 0.6 * ratio + (character and 0.25 or 0))
			if total > 0 and built < total then
				hud:ShowLoading(true, Locale.T("Building the houses… %s/%s", tostring(built), tostring(total)))
			end
			if character and ratio >= 1 and os.clock() - started > 0.5 then
				break
			end
			task.wait(0.1)
		end
		if not inTown then
			return
		end
		hud:ShowLoading(true, Locale.T("Here we go!"), 1)
		task.wait(0.25)
		character = character or waitCharacter(4)
		if not inTown then
			return
		end
		if character then
			if emotes then
				emotes:Attach(character)
			end
		end
		-- 🖥️ bureau (SETUP3D95) : s'il existe
		wireDesk()
		deskCall("Start")
		local arrival = type(result) == "table" and result.Arrival == "Entrance"
		hud:ShowLoading(false)
		busy = false
		if arrival and character and not introSeen then
			playIntro(character)
		else
			followCamera(character)
			-- v10 🏗️ moment "ta maison se construit" (CONSTRUCT10)
			local construction = optionalModule("HouseConstruction")
			if construction and type(construction.ArrivalDone) == "function" then
				pcall(construction.ArrivalDone)
			end
			if arrival then
				startGuide()
				toast(Locale.T("🚶 Welcome to Dopamine Town!"), Color3.fromRGB(236, 72, 140))
				toast(Locale.T("Your house: follow the 🧭 compass, or tap 🏠 Go home"))
			else
				toast(Locale.T("🚶 Welcome to Dopamine Town!"), Color3.fromRGB(236, 72, 140))
			end
		end
		if slot and inTown then
			goRoom(LocalPlayer.UserId, slot)
		end
	end)
end

-- Remise à l'état du clicker (après le fondu)
local function teardown()
	inTown = false
	if intro then
		intro:Cancel()
		intro = nil
	end
	if emotes then
		emotes:Stop("leave")
		emotes:Detach()
	end
	if guide then
		guide:Destroy()
		guide = nil
	end
	guidePending = false
	if edit then
		edit:SetEnabled(false)
	end
	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	table.clear(connections)
	-- v9.8 (GARDEN98) : jardin (sauvegarde en attente, interface) + animaux (originaux rendus)
	do
		local gardenEdit = optionalModule("GardenEdit")
		if gardenEdit and type(gardenEdit.Stop) == "function" then
			pcall(gardenEdit.Stop)
		end
		local petRoam = optionalModule("PetRoam")
		if petRoam and type(petRoam.Stop) == "function" then
			pcall(petRoam.Stop)
		end
		-- v10 🏗️ chantiers / constructions : tout rendu tout de suite, caméra comprise (CONSTRUCT10)
		local construction = optionalModule("HouseConstruction")
		if construction and type(construction.Stop) == "function" then
			pcall(construction.Stop)
		end
	end
	for userId in pairs(gardens) do
		destroyGarden(userId)
	end
	table.clear(gardens)
	for _, house in pairs(houses) do
		pcall(house.Destroy, house)
	end
	table.clear(houses)
	table.clear(locLabels)
	if housesFolder then
		housesFolder:Destroy()
		housesFolder = nil
	end
	roomBuilding = false
	contextKey = ""
	currentContext = nil
	-- (DeskMode rend sa caméra AVANT qu'on remette la nôtre)
	deskCall("Stop")
	-- v10 🏁 courses : on quitte la salle / la course, décor et HUD retirés
	local raceClient = optionalModule("RaceClient")
	if raceClient and type(raceClient.Stop) == "function" then
		pcall(raceClient.Stop)
	end
	-- v9.6 🚗 on descend de voiture, HUD retiré (avant de rendre la caméra)
	local car = optionalModule("CarClient")
	if car and type(car.Stop) == "function" then
		pcall(car.Stop)
	end
	-- (v9.6) boutiques : intérieurs détruits, catalogue fermé, portes remises
	local shops = optionalModule("ShopInteriors")
	if shops and type(shops.Stop) == "function" then
		pcall(shops.Stop)
	end
	-- (v9.7) circulation + décor véhicules retirés
	local traffic = optionalModule("TownTraffic")
	if traffic and type(traffic.Stop) == "function" then
		pcall(traffic.Stop)
	end
	local facades = optionalModule("TownFacades")
	if facades and type(facades.Stop) == "function" then
		pcall(facades.Stop)
	end
	local marketMod = optionalModule("MarketInterior")
	if marketMod and type(marketMod.Stop) == "function" then
		pcall(marketMod.Stop)
	end
	local displays = optionalModule("TownDisplays")
	if displays and type(displays.Stop) == "function" then
		pcall(displays.Stop)
	end
	-- (v9.7) place centrale : pièces locales (manège, ballons, pigeons…) détruites
	local plazaFx = optionalModule("TownPlazaFx")
	if plazaFx and type(plazaFx.Stop) == "function" then
		pcall(plazaFx.Stop)
	end
	-- v9.8 🎡 fête foraine : pièces locales détruites (FairFx)
	local fairFx = optionalModule("FairFx")
	if fairFx and type(fairFx.Stop) == "function" then
		pcall(fairFx.Stop)
	end
	-- v9.9 🎵 scène musicale : décor, sons, interface détruits ; déplacements rendus
	local musicStage = optionalModule("MusicStage")
	if musicStage and type(musicStage.Stop) == "function" then
		pcall(musicStage.Stop)
	end
	-- v9.7 🌳 nature : détails de près détruits (NATURE97)
	local greenery = optionalModule("TownGreenery")
	if greenery and type(greenery.Stop) == "function" then
		pcall(greenery.Stop)
	end
	-- v9.8 🏙️ vie de la rue : mobilier + passants détruits (CITY98)
	for _, name in ipairs({ "TownStreetLife", "TownPeople" }) do
		local lifeMod = optionalModule(name)
		if lifeMod and type(lifeMod.Stop) == "function" then
			pcall(lifeMod.Stop)
		end
	end
	-- v9.8 🎨 fenêtre Graphismes fermée (REALISM98)
	local gfx = optionalModule("TownGraphics")
	if gfx and type(gfx.Close) == "function" then
		pcall(gfx.Close)
	end
	-- v9.8 🪑 poses rendues aux animations de Roblox, chaises remises (SEAT98)
	local sitAnimator = optionalModule("SitAnimator")
	if sitAnimator and type(sitAnimator.Stop) == "function" then
		pcall(sitAnimator.Stop)
	end
	local knockdown = optionalModule("Knockdown")
	if knockdown and type(knockdown.Stop) == "function" then
		pcall(knockdown.Stop)
	end
	hud:SetDeskMode(false)
	local s = saved
	if s then
		TownAtmosphere.Restore(s)
		restoreControls(s)
		local camera = workspace.CurrentCamera
		if camera and s.CameraType then
			pcall(function()
				camera.CameraType = s.CameraType :: Enum.CameraType
			end)
		end
	end
	saved = nil
	hud:SetVisible(false)
	task.spawn(invoke, "leave", nil)
end

leave = function()
	if not inTown or busy then
		return
	end
	busy = true
	-- l'émote s'arrête tout de suite ; fondu, remise, puis le clicker réapparaît
	if emotes then
		emotes:Stop("leave")
	end
	hud:Fade(0, 0.3, FADE_COLOR)
	task.delay(0.32, function()
		local ok, err = pcall(teardown)
		if not ok then
			warn("[Town] Sortie : " .. tostring(err))
			inTown = false
		end
		hud:Fade(1, 0.45)
		busy = false
	end)
end

----------------------------------------------------------------------
-- Actions du HUD
----------------------------------------------------------------------

local OPEN_NEXT = { Everyone = "Friends", Friends = "Nobody", Nobody = "Everyone" }

local function openVisit()
	local rows = {}
	for userId, snapshot in pairs(snapshots) do
		if snapshot.Plot then
			table.insert(rows, { Snapshot = snapshot, IsSelf = userId == LocalPlayer.UserId, Locked = not canEnter(snapshot) })
		end
	end
	table.sort(rows, function(a, b)
		if a.IsSelf ~= b.IsSelf then
			return a.IsSelf
		end
		if (a.Snapshot.InTown == true) ~= (b.Snapshot.InTown == true) then
			return a.Snapshot.InTown == true
		end
		return (tonumber(a.Snapshot.Likes) or 0) > (tonumber(b.Snapshot.Likes) or 0)
	end)
	hud:OpenVisit(rows)
end

local function callbacks(): any
	return {
		Back = function()
			leave()
		end,
		Home = function()
			task.spawn(function()
				local ok, message = invoke("home", nil)
				if not ok and type(message) == "string" then
					toast(message)
				end
			end)
		end,
		OpenVisit = openVisit,
		Visit = function(userId: number)
			task.spawn(function()
				local ok, result = invoke("visit", userId)
				if not ok then
					toast(tostring(result), Color3.fromRGB(226, 80, 90))
				elseif type(result) == "table" and result.Locked then
					toast(Locale.T("🔒 This house is closed to visitors"))
				else
					local snapshot = snapshots[userId]
					toast(Locale.T("🚶 Welcome to %s's house!", tostring(snapshot and snapshot.DisplayName or "?")))
				end
			end)
		end,
		Emote = playEmote,
		ToggleEdit = function()
			local gardenEdit = optionalModule("GardenEdit")
			if gardenEdit and type(gardenEdit.IsActive) == "function" and gardenEdit.IsActive() then
				pcall(gardenEdit.SetEnabled, false)
			end
			if not edit then
				return
			end
			local context = currentContext
			if not edit:IsEnabled() and not (context and context.IsOwner and context.InHouse) then
				toast(Locale.T("Go inside your house to move your furniture"))
				return
			end
			if not edit:IsEnabled() and deskActive() then
				return
			end
			if not edit:IsEnabled() and emotes then
				-- (mode édition : l'émote s'arrête)
				emotes:Stop("edit")
			end
			edit:SetEnabled(not edit:IsEnabled())
		end,
		Rotate = function()
			edit:Rotate(45)
		end,
		Snap = function()
			edit:ToggleSnap()
		end,
		PutAway = function()
			edit:PutAway()
		end,
		Drop = function()
			edit:Drop()
		end,
		Cancel = function()
			edit:Cancel()
		end,
		Like = function()
			local context = currentContext
			if not context or context.IsOwner then
				return
			end
			task.spawn(function()
				local ok, message = invoke("like", tonumber(context.Snapshot.UserId))
				toast(tostring(message or ""), ok and Color3.fromRGB(255, 90, 140) or Color3.fromRGB(150, 110, 170))
			end)
		end,
		Click = function(): number?
			local ok, gain = pcall(ClientState.Click)
			return ok and gain or nil
		end,
		StopEmote = function()
			if emotes then
				emotes:Stop("button")
			end
		end,
		GetUp = function()
			if not emotes then
				return
			end
			local humanoid = emotes.Humanoid
			local seat = humanoid and humanoid.SeatPart
			emotes:StandUp()
			-- (siège créé par le serveur : il le détruit, on est sûr d'être debout)
			if seat and string.sub(seat.Name, 1, 9) == "TownSeat_" then
				task.spawn(invoke, "stand", nil)
			end
		end,
		SkipIntro = function()
			if intro then
				intro:Skip()
			end
		end,
		CycleOpen = function()
			local mine = snapshots[LocalPlayer.UserId]
			local nextMode = OPEN_NEXT[WorldLayout.NormalizeOpen(mine and mine.Open)]
			task.spawn(function()
				local ok, message = invoke("setOpen", nextMode)
				if ok and mine then
					mine.Open = nextMode
					contextKey = ""
				end
				toast(tostring(message or ""))
			end)
		end,
	}
end

----------------------------------------------------------------------

function TownClient.IsInTown(): boolean
	return inTown
end

function TownClient.Enter(options: any?)
	enter(options or {})
end

function TownClient.Leave()
	leave()
end

-- (tests) état interne
function TownClient.Debug(): any
	return { Houses = houses, Snapshots = snapshots, Hud = hud, Edit = edit, Emotes = emotes, Atmosphere = TownAtmosphere, Context = function()
		return currentContext
	end, Guide = function()
		return guide
	end, Intro = function()
		return intro
	end, Gardens = gardens, LocLabels = locLabels, UseModule = function(name: string, module: any)
		-- (tests) remplace un module facultatif (DeskMode, LiveProps, GardenBuilder…)
		optionalCache[name] = module or false
		if name == "DeskMode" then
			deskWired = false
			if inTown then
				wireDesk()
			end
		end
	end, Step = step, Event = onEvent }
end

function TownClient.Init()
	hud = TownHud.new(callbacks())
	emotes = TownEmotes.new({
		OnChanged = function(state: string?)
			hud:SetAction(state)
		end,
		Blocked = deskActive,
		Toast = function(text: string)
			toast(Locale.T(text))
		end,
	})
	edit = FurnitureEdit.new({
		GetHouse = myHouse,
		Hud = hud,
		Toast = toast,
		Save = function(_slot: number, roomId: string, placed: { any }, onResult: (boolean, string?) -> ())
			task.spawn(function()
				local ok, success, message = pcall(function()
					return Net.Function("House"):InvokeServer("saveLayout", { Room = roomId, Placed = placed })
				end)
				if not ok then
					onResult(false, Locale.T("Network error, try again."))
				else
					onResult(success == true, message ~= nil and tostring(message) or nil)
				end
			end)
		end,
	})
	Net.Event("WorldEvent").OnClientEvent:Connect(onEvent)
	-- langue changée (⚙️) pendant la promenade : panneaux retraduits
	Locale.OnChanged(function()
		if inTown then
			pcall(localizeTown)
		end
	end)
	WorldLink.SetHandler(TownClient.Enter, TownClient.IsInTown)
end

return TownClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="230">
          <Properties>
            <string name="Name">TownDisplays</string>
            <string name="Source"><![CDATA[--[[
	TownDisplays (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > TownDisplays

	🏛️ Dopamine Town (v9.9, SHOPS99) : les écrans et horloges de la ville,
	côté client (les pièces du serveur restent ; on les habille localement) :
	  - MAIRIE, GRAND ÉCRAN « 🏆 Meilleurs joueurs du serveur » : écran de
	    régie télé (BoardKit) qui alterne deux pages toutes les 12 s :
	      1. les joueurs du serveur, classés par Dopamine EN DIRECT (ta
	         ligne suit tes compteurs), le N°1 en vedette « ⭐ Meilleur
	         joueur du serveur » avec couronne et vraie photo ;
	      2. « ❤️ Maisons les plus aimées » (j'aime des parcelles) ;
	    la SurfaceGui du serveur est masquée LOCALEMENT (jamais modifiée
	    côté serveur) ; un liseré chromé et une plaque « DOPA TV » finissent
	    le cadre ;
	  - HORLOGE de la tour de la mairie : vrai cadran (chiffres romains,
	    minutes, aiguilles 3D, trotteuse) à l'heure réelle (ClockKit) ; les
	    deux aiguilles fixes du serveur sont masquées localement ;
	  - toute pièce de DopamineTown portant l'attribut "TownClock" (true ou
	    un style "Tower" | "Wall" | "Station") reçoit un vrai cadran sur sa
	    face avant (-Z), diamètre = min(largeur, hauteur) : c'est ainsi que
	    la place (CITY99) ou d'autres bâtiments ajoutent une horloge.
	Mise à jour : aiguilles à 30 i/s de près (≤ 120 studs), 4 i/s plus loin,
	rien au-delà de 400 ; écran animé à 30 i/s de près (≤ 160 studs).
	Aucune lumière, aucun son.

	API (TownClient, via optionalModule) :
	  TownDisplays.Start()   à l'entrée en ville
	  TownDisplays.Stop()    à la sortie (tout est détruit / restauré)
	  TownDisplays.Debug() -> table
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local Locale = require(game:GetService("ReplicatedStorage").Shared.Locale)
local NumberFormatter = require(game:GetService("ReplicatedStorage").Shared.NumberFormatter)
local BoardKit = require(script.Parent.BoardKit)
local ClockKit = require(script.Parent.ClockKit)

local TownDisplays = {}

local FOLDER_NAME = "TownDisplaysClient"
local PAGE_TIME = 12
local CLOCK_NEAR, CLOCK_FAR = 120, 400
local BOARD_NEAR, BOARD_FAR = 160, 420

type Hidden = { Instance: Instance, Property: string, Value: any }

local started = false
local folder: Folder? = nil
local conns: { RBXScriptConnection } = {}
local clocks: { any } = {}
local board: any = nil
local boardPos: Vector3? = nil
local hidden: { Hidden } = {}
local hallDone = false
local seen: { [Instance]: boolean } = {}
local clockTimer, boardTimer, dataTimer, discoverTimer = 0, 0, 0, 0
local stats = { Clocks = 0, Board = false, Page = "", Refreshes = 0 }

local function hide(instance: Instance, property: string, value: any)
	local ok, old = pcall(function()
		return (instance :: any)[property]
	end)
	if ok then
		table.insert(hidden, { Instance = instance, Property = property, Value = old })
		pcall(function()
			(instance :: any)[property] = value
		end)
	end
end

----------------------------------------------------------------------
-- Données de l'écran de la mairie
----------------------------------------------------------------------

local function num(value: any, default: number): number
	local n = tonumber(value)
	if n == nil or n ~= n or n == math.huge or n == -math.huge then
		return default
	end
	return n
end

local function formatValue(value: number): string
	if value < 1e6 then
		return NumberFormatter.WithSpaces(math.floor(value))
	end
	return NumberFormatter.Format(value)
end

local function ordinal(rank: number): string
	if Locale.IsFrench() then
		return rank == 1 and "1er" or (tostring(rank) .. "e")
	end
	local lastTwo = rank % 100
	local suffix = "th"
	if lastTwo < 11 or lastTwo > 13 then
		local last = rank % 10
		suffix = last == 1 and "st" or (last == 2 and "nd" or (last == 3 and "rd" or "th"))
	end
	return tostring(rank) .. suffix
end

-- Page 1 : joueurs du serveur par Dopamine (ta ligne en direct)
local function playerRows(): { BoardKit.Row }
	local me = Players.LocalPlayer
	local rows: { BoardKit.Row } = {}
	local data = ClientState.Data
	local myDopamine = type(data) == "table" and num(data.Dopamine, 0) or 0
	local found = false
	for _, raw in ipairs(type(ClientState.ServerLeaderboard) == "table" and ClientState.ServerLeaderboard or {}) do
		if type(raw) == "table" then
			local userId = math.floor(num(raw.UserId, 0))
			local value = num(raw.Dopamine, num(raw.Value, 0))
			if userId == me.UserId and type(data) == "table" then
				found = true
				value = myDopamine
			end
			table.insert(rows, { UserId = userId, Name = tostring(raw.Name or "?"), Value = value, ValueText = "", Rank = 0, Mine = userId == me.UserId })
		end
	end
	if not found and type(data) == "table" then
		table.insert(rows, { UserId = me.UserId, Name = me.DisplayName, Value = myDopamine, ValueText = "", Rank = 0, Mine = true })
	end
	table.sort(rows, function(a, b)
		if a.Value ~= b.Value then
			return a.Value > b.Value
		end
		return a.UserId < b.UserId
	end)
	for i, r in ipairs(rows) do
		r.Rank = i
		r.ValueText = formatValue(r.Value) .. " 💧"
	end
	return rows
end

-- Page 2 : maisons les plus aimées (attributs des parcelles)
local function houseRows(): { BoardKit.Row }
	local rows: { BoardKit.Row } = {}
	local town = workspace:FindFirstChild("DopamineTown")
	local plots = town and town:FindFirstChild("Plots")
	local me = Players.LocalPlayer.UserId
	if plots then
		for _, plot in ipairs(plots:GetChildren()) do
			local ownerId = plot:GetAttribute("OwnerId")
			local name = plot:GetAttribute("OwnerName")
			if type(ownerId) == "number" and ownerId ~= 0 and type(name) == "string" and name ~= "" then
				local likes = plot:GetAttribute("Likes")
				table.insert(rows, { UserId = ownerId, Name = name, Value = type(likes) == "number" and likes or 0, ValueText = "", Rank = 0, Mine = ownerId == me })
			end
		end
	end
	table.sort(rows, function(a, b)
		if a.Value ~= b.Value then
			return a.Value > b.Value
		end
		return a.Name < b.Name
	end)
	for i, r in ipairs(rows) do
		r.Rank = i
		r.ValueText = "❤️ " .. formatValue(r.Value)
	end
	return rows
end

local function refreshBoard(now: number)
	local b = board
	if not b then
		return
	end
	local page = math.floor(now / PAGE_TIME) % 2
	local rows = page == 0 and playerRows() or houseRows()
	if page == 1 and #rows == 0 then
		page = 0
		rows = playerRows()
	end
	stats.Page = page == 0 and "Players" or "Houses"
	stats.Refreshes += 1
	local mine: BoardKit.Row? = nil
	for _, r in ipairs(rows) do
		if r.Mine then
			mine = r
		end
	end
	local footer
	if mine then
		footer = Locale.T("You: %s · %s", ordinal(mine.Rank), mine.ValueText)
	elseif page == 1 then
		footer = Locale.T("❤️ Like houses to climb the board!")
	else
		footer = Locale.T("You: not in the top yet · %s", "—")
	end
	BoardKit.SetData(b, {
		Rows = rows,
		Title = page == 0 and Locale.T("🏆 Top players of the server") or Locale.T("❤️ Most-loved houses"),
		Scope = "🏠 " .. Locale.T("This server"),
		HeroCaption = page == 0 and Locale.T("⭐ Best player on the server") or Locale.T("🏡 Most-loved house"),
		Footer = footer,
	})
end

----------------------------------------------------------------------
-- Mairie : écran + horloge
----------------------------------------------------------------------

local function dressHall(hall: Instance, parent: Instance)
	-- GRAND ÉCRAN
	local screen = hall:FindFirstChild("Screen")
	if screen and screen:IsA("BasePart") then
		for _, gui in ipairs(screen:GetChildren()) do
			if gui:IsA("SurfaceGui") then
				hide(gui, "Enabled", false)
			end
		end
		board = BoardKit.Build(screen, {
			Face = Enum.NormalId.Front,
			PPS = 26,
			MaxDistance = 420,
			Title = "🏆 Top players of the server",
			Theme = "Hall",
			Rows = 6,
			HeroCaption = "⭐ Best player on the server",
			Ticker = {
				"🏆 Best players of this server, live",
				"❤️ Like houses in town to climb the board",
				"♻️ Rebirth to multiply your Dopamine",
				"🛒 MegaDopa: everything for your home",
			},
		})
		boardPos = screen.Position
		-- liseré chromé autour de l'écran + plaque « DOPA TV » (devant le cadre du serveur)
		BoardKit.Frame(parent, screen, { Lip = 0.22, PlateH = 0.35 })
		refreshBoard(os.clock())
	end
	-- HORLOGE de la tour
	local dial = hall:FindFirstChild("Clock")
	if dial and dial:IsA("BasePart") then
		local tower = hall:FindFirstChild("Tower")
		local axis = dial.CFrame.RightVector
		local away = tower and tower:IsA("BasePart") and (dial.Position - tower.Position) or axis
		if axis:Dot(away) < 0 then
			axis = -axis
		end
		local center = dial.Position + axis * (dial.Size.X / 2)
		local diameter = math.min(dial.Size.Y, dial.Size.Z)
		for _, name in ipairs({ "HandHour", "HandMinute" }) do
			local handPart = hall:FindFirstChild(name)
			if handPart and handPart:IsA("BasePart") then
				hide(handPart, "Transparency", 1)
			end
		end
		local frame = CFrame.lookAt(center, center + axis)
		local clock = ClockKit.Build(parent, frame, diameter, { Style = "Tower", Numerals = "Roman", Brand = "Dopamine Town", Name = "HallClock", MaxDistance = 500 })
		table.insert(clocks, clock)
	end
end

----------------------------------------------------------------------
-- Horloges marquées "TownClock"
----------------------------------------------------------------------

local function dressTagged(p: Instance, parent: Instance)
	if seen[p] or not p:IsA("BasePart") then
		return
	end
	local tag = p:GetAttribute("TownClock")
	if tag == nil or tag == false then
		return
	end
	seen[p] = true
	local style = type(tag) == "string" and tag or "Tower"
	local diameter = math.min(p.Size.X, p.Size.Y)
	local frame = p.CFrame * CFrame.new(0, 0, -p.Size.Z / 2)
	local ok, clock = pcall(ClockKit.Build, parent, frame, diameter, { Style = style, Numerals = p:GetAttribute("Numerals") == "Arabic" and "Arabic" or "Roman", Name = "TaggedClock", MaxDistance = 400 })
	if ok then
		table.insert(clocks, clock)
	end
end

local function discover()
	local town = workspace:FindFirstChild("DopamineTown")
	local f = folder
	if not town or not f then
		return
	end
	if not hallDone then
		local hall = town:FindFirstChild("TownHall", true)
		if hall then
			hallDone = true
			local ok, err = pcall(dressHall, hall, f)
			if not ok then
				warn("[TownDisplays] mairie : " .. tostring(err))
			end
		end
	end
	for _, d in ipairs(town:GetDescendants()) do
		if d:IsA("BasePart") and d:GetAttribute("TownClock") ~= nil then
			dressTagged(d, f)
		end
	end
end

----------------------------------------------------------------------
-- Boucle
----------------------------------------------------------------------

local function viewPosition(): Vector3?
	local camera = workspace.CurrentCamera
	if camera then
		return camera.CFrame.Position
	end
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return root and (root :: BasePart).Position or nil
end

local function heartbeat(dt: number)
	if not started then
		return
	end
	local position = viewPosition()
	if not position then
		return
	end
	local now = os.clock()
	discoverTimer += dt
	if discoverTimer >= 5 and not hallDone then
		discoverTimer = 0
		discover()
	end
	-- aiguilles
	clockTimer += dt
	local nearest = math.huge
	for _, c in ipairs(clocks) do
		nearest = math.min(nearest, (c.Pos - position).Magnitude)
	end
	local every = nearest <= CLOCK_NEAR and 1 / 30 or 0.25
	if clockTimer >= every and nearest <= CLOCK_FAR then
		clockTimer = 0
		for _, c in ipairs(clocks) do
			local d = (c.Pos - position).Magnitude
			if d <= CLOCK_FAR then
				ClockKit.Update(c)
			end
		end
	end
	-- écran de la mairie
	local b = board
	local bp = boardPos
	if b and bp then
		local d = (bp - position).Magnitude
		if d <= BOARD_FAR then
			boardTimer += dt
			dataTimer += dt
			if dataTimer >= 1.5 then
				dataTimer = 0
				pcall(refreshBoard, now)
			end
			local stepEvery = d <= BOARD_NEAR and 1 / 30 or 0.5
			if boardTimer >= stepEvery then
				boardTimer = 0
				BoardKit.SetProgress(b, (now % PAGE_TIME) / PAGE_TIME)
				BoardKit.Step(b, now)
			end
		end
	end
end

function TownDisplays.Start()
	if started then
		return
	end
	started = true
	local f = Instance.new("Folder")
	f.Name = FOLDER_NAME
	f.Parent = workspace
	folder = f
	discover()
	table.insert(conns, RunService.Heartbeat:Connect(function(dt)
		local ok, err = pcall(heartbeat, dt)
		if not ok then
			warn("[TownDisplays] " .. tostring(err))
		end
	end))
	table.insert(conns, ClientState.LeaderboardChanged:Connect(function()
		dataTimer = 99
	end))
	local town = workspace:FindFirstChild("DopamineTown")
	if town then
		table.insert(conns, town.DescendantAdded:Connect(function(d)
			if d:IsA("BasePart") and d:GetAttribute("TownClock") ~= nil and folder then
				task.defer(dressTagged, d, folder)
			end
		end))
	end
	stats.Clocks = #clocks
	stats.Board = board ~= nil
end

function TownDisplays.Stop()
	if not started then
		return
	end
	started = false
	for _, c in ipairs(conns) do
		c:Disconnect()
	end
	conns = {}
	if board then
		pcall(BoardKit.Destroy, board)
	end
	board = nil
	boardPos = nil
	for i = #hidden, 1, -1 do
		local h = hidden[i]
		pcall(function()
			(h.Instance :: any)[h.Property] = h.Value
		end)
	end
	hidden = {}
	clocks = {}
	seen = {}
	hallDone = false
	if folder then
		folder:Destroy()
	end
	folder = nil
end

function TownDisplays.Debug(): any
	stats.Clocks = #clocks
	stats.Board = board ~= nil
	return {
		Stats = stats,
		Board = board,
		Clocks = clocks,
		Folder = folder,
		Refresh = function(now: number?)
			refreshBoard(now or os.clock())
		end,
		Step = function(dt: number)
			heartbeat(dt)
		end,
	}
end

return TownDisplays
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="231">
          <Properties>
            <string name="Name">TownDistricts</string>
            <string name="Source"><![CDATA[--[[
	TownDistricts (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > TownDistricts

	🏙️ Dopamine Town (v9.9, CITY99) : "plus de zone morte". Les nouveaux
	lieux posés par le serveur dans les coins les plus vides de l'anneau
	(TownNature : emplacements "SkatePark", "CommunityGarden",
	"SportsCorner" + une allée pavée qui les relie au réseau + un poteau
	indicateur), construits ICI côté client, en flux (TownStreetLife) :
	  - 🛹 SKATEPARK : dalle de béton à joints, 2 quarter-pipes à courbe
	    circulaire (vraies pentes où l'on peut courir), funbox avec
	    plans inclinés, rail de glisse, module "ledge" à arête d'acier,
	    grillage, mur de graffitis, lampadaires ; 2 SKATEURS (NPCModels)
	    qui roulent pour de vrai : aller-retour d'une rampe à l'autre (la
	    planche suit la courbe), tour de la funbox avec des ollies ;
	  - 🥕 JARDINS PARTAGÉS : haie basse et portail en arche, 6 carrés
	    potagers surélevés (salades, carottes, tomates tuteurées, citrouilles,
	    fraises, tournesols), serre vitrée, cabane à outils, composteurs,
	    récupérateur d'eau, brouette, arrosoir, épouvantail ; 2 jardiniers ;
	  - 🏓 COIN SPORT : 2 tables de ping-pong en béton (une partie EN COURS :
	    la balle fait l'aller-retour, rebond sur la table), terrain de
	    pétanque (boules, cochonnet) et ses joueurs, agrès de fitness (barre
	    fixe, barres parallèles, banc à abdos) sur sol souple.
	Tout est ancré ; rampes, dalles et gros modules sont solides (collision
	locale : on y court, on y saute) ; le reste est décor. Aucune lumière
	(verres "NightGlow" : Neon la nuit via TownAtmosphere), aucun son.
	Animation des personnages : à chaque image, seulement près de la caméra
	(< 110 studs), sans création d'instance.

	API (TownStreetLife) :
	  TownDistricts.BUILDERS : { [kind]: (m, F, seed) -> any }
	  TownDistricts.BIG      : types vus de loin
	  TownDistricts.Step(dt) : à chaque image (personnages proches)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Locale = require(ReplicatedStorage.Shared.Locale)
local NPCModels = require(ReplicatedStorage.Shared.NPCModels)

local TownDistricts = {}

local M = Enum.Material
local rgb = Color3.fromRGB
local UPRIGHT = CFrame.Angles(0, 0, math.rad(90))
local ANIM_R = 110

local CONCRETE = rgb(196, 196, 192)
local CONCRETE_D = rgb(170, 170, 166)
local STEEL = rgb(176, 180, 188)
local GRAPHITE = rgb(52, 54, 60)
local WOOD = rgb(176, 124, 84)
local WOOD_D = rgb(128, 88, 58)
local SOIL = rgb(96, 70, 52)
local LEAF = rgb(84, 150, 76)
local LEAF_D = rgb(60, 118, 58)
local WHITE = rgb(250, 250, 248)
local GLASS = rgb(200, 226, 236)

local function hash(a: number, b: number): number
	local x = math.sin(a * 12.9898 + b * 78.233) * 43758.5453
	return x - math.floor(x)
end

local function newPart(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: string?, solid: boolean?): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = solid == true
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = solid == true or size.Magnitude > 3
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape == "Ball" then
		p.Shape = Enum.PartType.Ball
	elseif shape == "Cyl" then
		p.Shape = Enum.PartType.Cylinder
	elseif shape == "Egg" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	p.Parent = parent
	return p
end

local function wedge(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, solid: boolean?): BasePart
	local p = Instance.new("WedgePart")
	p.Name = name
	p.Anchored = true
	p.CanCollide = solid == true
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.Parent = parent
	return p
end

-- boîte par ses bornes (repère F)
local function box(parent: Instance, name: string, F: CFrame, x0: number, x1: number, y0: number, y1: number, z0: number, z1: number, color: Color3, material: Enum.Material?, solid: boolean?): BasePart
	return newPart(parent, name, Vector3.new(x1 - x0, y1 - y0, z1 - z0), F * CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2), color, material, nil, solid)
end

local function column(parent: Instance, name: string, F: CFrame, x: number, z: number, y0: number, y1: number, d: number, color: Color3, material: Enum.Material?, solid: boolean?): BasePart
	return newPart(parent, name, Vector3.new(y1 - y0, d, d), F * CFrame.new(x, (y0 + y1) / 2, z) * UPRIGHT, color, material, "Cyl", solid)
end

local function rod(parent: Instance, name: string, a: Vector3, b: Vector3, d: number, color: Color3, material: Enum.Material?, solid: boolean?): BasePart
	local axis = b - a
	local up = math.abs(axis.Unit.Y) > 0.98 and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0)
	return newPart(parent, name, Vector3.new(axis.Magnitude, d, d), CFrame.lookAt((a + b) / 2, b, up) * CFrame.Angles(0, math.pi / 2, 0), color, material, "Cyl", solid)
end

local function egg(parent: Instance, name: string, cf: CFrame, size: Vector3, color: Color3, material: Enum.Material?): BasePart
	return newPart(parent, name, size, cf, color, material, "Egg")
end

local function glow(p: BasePart): BasePart
	p.Material = M.SmoothPlastic
	p:SetAttribute("NightGlow", true)
	return p
end

local function surfaceText(host: BasePart, face: Enum.NormalId, text: string, color: Color3, bg: Color3?, font: Enum.Font?, maxDistance: number?): TextLabel
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Text"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0.7
	gui.MaxDistance = maxDistance or 110
	gui.Parent = host
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = bg and 0 or 1
	label.BackgroundColor3 = bg or WHITE
	label.BorderSizePixel = 0
	label.TextScaled = true
	label.Font = font or Enum.Font.GothamBold
	label.TextColor3 = color
	label.Text = text
	label.Parent = gui
	return label
end

local function lampPost(m: Model, F: CFrame, x: number, z: number, facing: number)
	local iron = rgb(56, 52, 70)
	local L = F * CFrame.new(x, 0, z) * CFrame.Angles(0, facing, 0)
	column(m, "LampFoot", L, 0, 0, -0.05, 0.9, 1.1, iron, M.Metal, true)
	column(m, "LampPole", L, 0, 0, 0.85, 12.2, 0.36, iron, M.Metal, true)
	box(m, "LampArm", L, -0.08, 0.08, 12.0, 12.2, -2.2, 0, iron, M.Metal)
	box(m, "LampHood", L, -0.7, 0.7, 11.9, 12.25, -2.8, -1.4, iron, M.Metal)
	glow(box(m, "LampGlass", L, -0.4, 0.4, 11.3, 11.9, -2.5, -1.7, rgb(255, 232, 180), M.SmoothPlastic))
end

-- Personnage (NPCModels) : décor si pas d'animation ; `solid` = capsule
local function npc(m: Model, style: string, seed: number, cf: CFrame, prop: string?, solid: boolean?): Model?
	local ok, model = pcall(function()
		return NPCModels.Build(style, { Seed = seed, Prop = prop or "none", Solid = solid ~= false })
	end)
	if not ok or not model then
		return nil
	end
	model.Parent = m
	model:PivotTo(cf)
	return model
end

----------------------------------------------------------------------
-- Acteurs animés (à chaque image, près de la caméra)
----------------------------------------------------------------------

type Actor = { Model: Model, Kind: string, Data: any, Phase: number }
local actors: { Actor } = {}

local function addActor(model: Model?, kind: string, data: any, phase: number)
	if model then
		table.insert(actors, { Model = model, Kind = kind, Data = data, Phase = phase })
	end
end

----------------------------------------------------------------------
-- 🛹 Skatepark
----------------------------------------------------------------------

local PAD_TOP = 0.3 -- dessus de la dalle au-dessus du sol
local QP_R = 4.6 -- rayon de courbure des quarter-pipes
local QP_MAX = math.rad(75) -- angle au sommet (lèvre)
local QP_CX = 7.2 -- |x| du bas de la courbe (le plat entre les deux rampes : -7,2..7,2)
local QP_W = 8 -- largeur des rampes (z)

-- Hauteur (au-dessus de la dalle) et pente du sol du skatepark à l'abscisse x
local function skateGround(x: number): (number, number)
	local ax = math.abs(x)
	if ax <= QP_CX then
		return 0, 0
	end
	local s = math.clamp((ax - QP_CX) / QP_R, 0, math.sin(QP_MAX))
	local a = math.asin(s)
	return QP_R * (1 - math.cos(a)), (x > 0 and 1 or -1) * a
end

-- Planche de skate (plateau à kicktails, 2 trucks, 4 roues) : `cf` =
-- dessous des roues, planche le long de X
local function skateboard(m: Model, name: string, color: Color3, at: CFrame): { BasePart }
	local parts = {}
	local function add(p: BasePart)
		table.insert(parts, p)
	end
	local deck = newPart(m, name .. "Deck", Vector3.new(2.3, 0.07, 0.72), CFrame.identity, color, M.Wood)
	add(deck)
	add(newPart(m, name .. "Grip", Vector3.new(2.28, 0.02, 0.7), CFrame.identity, rgb(34, 34, 38), M.Sand))
	for _, sx in ipairs({ -1, 1 }) do
		add(newPart(m, name .. "Tail", Vector3.new(0.4, 0.07, 0.66), CFrame.identity, color, M.Wood))
		add(newPart(m, name .. "Truck", Vector3.new(0.16, 0.12, 0.62), CFrame.identity, STEEL, M.Metal))
		for _, sz in ipairs({ -1, 1 }) do
			add(newPart(m, name .. "Wheel", Vector3.new(0.14, 0.2, 0.2), CFrame.identity, rgb(246, 240, 226), M.SmoothPlastic, "Cyl"))
		end
	end
	return parts
end

-- Repères (relatifs au dessous des roues) des pièces de la planche, même ordre
local BOARD_LOCAL: { CFrame } = (function()
	local list = { CFrame.new(0, 0.3, 0), CFrame.new(0, 0.345, 0) }
	for _, sx in ipairs({ -1, 1 }) do
		table.insert(list, CFrame.new(sx * 1.3, 0.34, 0) * CFrame.Angles(0, 0, sx * math.rad(16)))
		table.insert(list, CFrame.new(sx * 0.78, 0.2, 0))
		for _, sz in ipairs({ -1, 1 }) do
			table.insert(list, CFrame.new(sx * 0.78, 0.1, sz * 0.36) * CFrame.Angles(0, math.rad(90), 0))
		end
	end
	return list
end)()

local function buildSkatePark(m: Model, F: CFrame, seed: number)
	local W, D = 30, 20
	local P = F * CFrame.new(0, PAD_TOP, 0) -- dessus de la dalle
	box(m, "SkatePad", F, -W / 2, W / 2, -0.6, PAD_TOP, -D / 2, D / 2, CONCRETE, M.Concrete, true)
	-- joints de dilatation (quadrillage 5 x 5)
	for x = -W / 2 + 5, W / 2 - 5, 5 do
		box(m, "PadJoint", P, x - 0.05, x + 0.05, -0.3, 0.035, -D / 2 + 0.2, D / 2 - 0.2, CONCRETE_D, M.Concrete)
	end
	for z = -D / 2 + 5, D / 2 - 5, 5 do
		box(m, "PadJoint", P, -W / 2 + 0.2, W / 2 - 0.2, -0.33, 0.07, z - 0.05, z + 0.05, CONCRETE_D, M.Concrete)
	end
	-- 2 quarter-pipes (courbe circulaire en 7 dalles tangentes, lèvre en acier, plateforme, dos)
	for _, sx in ipairs({ -1, 1 }) do
		local n = 7
		local prev = Vector3.new(QP_CX, 0, 0)
		for i = 1, n do
			local a = QP_MAX * i / n
			local pt = Vector3.new(QP_CX + QP_R * math.sin(a), QP_R * (1 - math.cos(a)), 0)
			local mid = (prev + pt) / 2
			local len = (pt - prev).Magnitude
			local slope = math.atan2(pt.Y - prev.Y, pt.X - prev.X)
			-- dalle : dessus sur la corde, épaisseur 0,5 vers l'intérieur de la courbe
			local cf = P * CFrame.new(sx * mid.X, mid.Y, 0) * CFrame.Angles(0, 0, sx * slope) * CFrame.new(0, -0.25, 0)
			newPart(m, "RampSlab", Vector3.new(len + 0.12, 0.5, QP_W), cf, CONCRETE, M.Concrete, nil, true)
			-- massif en béton sous la dalle (marches cachées sous la courbe)
			local under = prev.Y - 0.45
			if under > 0.05 then
				local x0, x1 = prev.X, pt.X
				box(m, "RampFill", P, sx > 0 and x0 or -x1, sx > 0 and x1 or -x0, -0.3, under, -QP_W / 2 + 0.05, QP_W / 2 - 0.05, CONCRETE_D, M.Concrete)
			end
			prev = pt
		end
		local lipX = QP_CX + QP_R * math.sin(QP_MAX)
		local lipY = QP_R * (1 - math.cos(QP_MAX))
		-- plateforme + coping + dos + montants
		box(m, "Deck", P, sx > 0 and lipX + 0.05 or -lipX - 2.4, sx > 0 and lipX + 2.4 or -lipX - 0.05, lipY - 0.4, lipY, -QP_W / 2 - 0.05, QP_W / 2 + 0.05, CONCRETE_D, M.Concrete, true)
		rod(m, "Coping", (P * CFrame.new(sx * lipX, lipY - 0.05, -QP_W / 2)).Position, (P * CFrame.new(sx * lipX, lipY - 0.05, QP_W / 2)).Position, 0.3, STEEL, M.Metal)
		box(m, "RampBack", P, sx > 0 and lipX + 2.4 or -lipX - 2.6, sx > 0 and lipX + 2.6 or -lipX - 2.4, -0.3, lipY, -QP_W / 2, QP_W / 2, rgb(150, 150, 150), M.Concrete, true)
		-- garde-corps sur la plateforme
		for _, z in ipairs({ -QP_W / 2 + 0.2, QP_W / 2 - 0.2 }) do
			column(m, "RailPost", P, sx * (lipX + 2.3), z, lipY, lipY + 3.2, 0.18, GRAPHITE, M.Metal)
		end
		rod(m, "GuardRail", (P * CFrame.new(sx * (lipX + 2.3), lipY + 3.2, -QP_W / 2 + 0.2)).Position, (P * CFrame.new(sx * (lipX + 2.3), lipY + 3.2, QP_W / 2 - 0.2)).Position, 0.16, GRAPHITE, M.Metal)
	end
	-- funbox (plateau + 2 plans inclinés) au milieu, un peu décalée
	local FB = P * CFrame.new(0, 0, -5.4)
	box(m, "Funbox", FB, -2.2, 2.2, -0.3, 1.4, -1.8, 1.8, CONCRETE_D, M.Concrete, true)
	for _, sx in ipairs({ -1, 1 }) do
		wedge(m, "FunRamp", Vector3.new(3.6, 1.7, 3.4), FB * CFrame.new(sx * (2.2 + 1.7), 0.55, 0) * CFrame.Angles(0, sx > 0 and math.rad(-90) or math.rad(90), 0), CONCRETE, M.Concrete, true)
	end
	rod(m, "FunCoping", (FB * CFrame.new(-2.2, 1.4, -1.8)).Position, (FB * CFrame.new(2.2, 1.4, -1.8)).Position, 0.22, STEEL, M.Metal)
	-- rail de glisse
	local rail = P * CFrame.new(0, 0, 5.6)
	for _, x in ipairs({ -3.4, 0, 3.4 }) do
		column(m, "RailLeg", rail, x, 0, -0.1, 1.2, 0.2, GRAPHITE, M.Metal)
	end
	rod(m, "GrindRail", (rail * CFrame.new(-4.2, 1.25, 0)).Position, (rail * CFrame.new(4.2, 1.25, 0)).Position, 0.26, STEEL, M.Metal, true)
	-- ledge en béton à arête d'acier (côté fond)
	local ledge = P * CFrame.new(0, 0, 8.3)
	box(m, "Ledge", ledge, -5, 5, -0.3, 1.1, -0.8, 0.8, CONCRETE_D, M.Concrete, true)
	box(m, "LedgeEdge", ledge, -5.04, 5.04, 1.0, 1.15, -0.86, -0.7, STEEL, M.Metal)
	-- grillage sur les deux longs côtés (entrée au milieu du côté -Z)
	for _, sz in ipairs({ -1, 1 }) do
		for _, seg in ipairs(sz < 0 and { { -W / 2, -3 }, { 3, W / 2 } } or { { -W / 2, W / 2 } }) do
			local x0, x1 = seg[1], seg[2]
			local mesh = box(m, "FenceMesh", F, x0 + 0.1, x1 - 0.1, 0.4, 4.2, sz * (D / 2 + 0.6) - 0.04, sz * (D / 2 + 0.6) + 0.04, rgb(150, 156, 164), M.DiamondPlate, true)
			mesh.Transparency = 0.62
			box(m, "FenceTop", F, x0, x1, 4.2, 4.34, sz * (D / 2 + 0.6) - 0.08, sz * (D / 2 + 0.6) + 0.08, GRAPHITE, M.Metal)
			for x = x0, x1 + 0.01, (x1 - x0) / math.max(1, math.floor((x1 - x0) / 6)) do
				column(m, "FencePost", F, x, sz * (D / 2 + 0.6), -0.1, 4.4, 0.2, GRAPHITE, M.Metal)
			end
		end
	end
	-- mur de graffitis derrière le ledge (+Z), côté skatepark
	local wall = F * CFrame.new(0, 0, D / 2 + 2.4)
	local wallPart = box(m, "GraffitiWall", wall, -9, 9, 0, 5.2, -0.4, 0.4, rgb(210, 206, 200), M.Concrete, true)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Graffiti"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 20
	gui.LightInfluence = 0.8
	gui.MaxDistance = 160
	gui.Parent = wallPart
	local tags = {
		{ "SKATE", 0.02, 0.05, 0.42, 0.55, rgb(255, 90, 160), Enum.Font.FredokaOne, -6 },
		{ "🧠DOPA", 0.44, 0.1, 0.34, 0.45, rgb(90, 200, 255), Enum.Font.LuckiestGuy, 4 },
		{ "★ CREW ★", 0.76, 0.2, 0.22, 0.3, rgb(255, 214, 60), Enum.Font.Bangers, -3 },
		{ "ollie!", 0.1, 0.62, 0.3, 0.3, rgb(140, 255, 140), Enum.Font.PermanentMarker, 3 },
		{ "♥ 2026", 0.5, 0.6, 0.3, 0.32, rgb(255, 130, 60), Enum.Font.Creepster, -5 },
	}
	for _, t in ipairs(tags) do
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Position = UDim2.fromScale(t[2] :: number, t[3] :: number)
		l.Size = UDim2.fromScale(t[4] :: number, t[5] :: number)
		l.Text = t[1] :: string
		l.TextScaled = true
		l.TextColor3 = t[6] :: Color3
		l.Font = t[7] :: Enum.Font
		l.Rotation = t[8] :: number
		l.TextStrokeTransparency = 0.2
		l.TextStrokeColor3 = rgb(30, 30, 40)
		l.Parent = gui
	end
	-- panneau d'entrée + lampadaires
	local sign = box(m, "SkateSign", F, -3.2, 3.2, 4.6, 5.8, -(D / 2 + 0.8), -(D / 2 + 0.6), rgb(30, 30, 40), M.Metal)
	surfaceText(sign, Enum.NormalId.Front, "🛹 " .. Locale.T("Skate park"), rgb(255, 214, 60), rgb(30, 30, 40), Enum.Font.FredokaOne, 120)
	lampPost(m, F, -W / 2 - 1.2, -D / 2 - 1.6, math.rad(-135))
	lampPost(m, F, W / 2 + 1.2, D / 2 + 1.6, math.rad(45))
	-- 2 skateurs : aller-retour entre les rampes, tour de la funbox
	local colors = { rgb(236, 72, 100), rgb(60, 140, 220) }
	for i = 1, 2 do
		local style = i == 1 and "kid" or "pedestrian"
		local rider = npc(m, style, seed * 13 + i, P, "none", false)
		local board = skateboard(m, "Board" .. i, colors[i], P * CFrame.new(0, 0, i * 3 - 4.5))
		for k, part in ipairs(board) do
			part.CFrame = P * CFrame.new(0, 0, i * 3 - 4.5) * BOARD_LOCAL[k]
		end
		addActor(rider, "Skater", { P = P, Board = board, Mode = i }, hash(seed, i) * 10)
	end
end

----------------------------------------------------------------------
-- 🥕 Jardins partagés
----------------------------------------------------------------------

local function raisedBed(m: Model, F: CFrame, kind: number, seed: number)
	local L, Wd, H = 6, 2.4, 0.9
	-- cadre en planches (4 côtés) + terre
	for _, sz in ipairs({ -1, 1 }) do
		box(m, "BedBoard", F, -L / 2, L / 2, 0, H, sz * Wd / 2 - 0.12, sz * Wd / 2 + 0.12, WOOD, M.WoodPlanks, true)
	end
	for _, sx in ipairs({ -1, 1 }) do
		box(m, "BedBoard", F, sx * L / 2 - 0.12, sx * L / 2 + 0.12, 0, H, -Wd / 2 + 0.12, Wd / 2 - 0.12, WOOD_D, M.WoodPlanks, true)
	end
	box(m, "BedSoil", F, -L / 2 + 0.12, L / 2 - 0.12, 0, H - 0.1, -Wd / 2 + 0.12, Wd / 2 - 0.12, SOIL, M.Ground)
	local top = H - 0.1
	if kind == 1 then
		-- salades : rangées de boules vert tendre
		for i = 0, 5 do
			for _, z in ipairs({ -0.55, 0.55 }) do
				egg(m, "Lettuce", F * CFrame.new(-2.4 + i * 0.96, top + 0.22, z), Vector3.new(0.72, 0.5, 0.72), (i % 2 == 0) and rgb(150, 206, 96) or rgb(120, 180, 80), M.Grass)
			end
		end
	elseif kind == 2 then
		-- carottes : fanes plumeuses + collet orange
		for i = 0, 7 do
			for _, z in ipairs({ -0.5, 0.5 }) do
				local x = -2.5 + i * 0.72
				egg(m, "CarrotTop", F * CFrame.new(x, top + 0.4, z), Vector3.new(0.34, 0.8, 0.34), LEAF, M.Grass)
				newPart(m, "CarrotNeck", Vector3.new(0.1, 0.18, 0.18), F * CFrame.new(x, top + 0.03, z) * UPRIGHT, rgb(246, 140, 40), M.SmoothPlastic, "Cyl")
			end
		end
	elseif kind == 3 then
		-- tomates tuteurées
		for i = 0, 3 do
			local x = -2.1 + i * 1.4
			column(m, "Stake", F, x, 0, top, top + 2.8, 0.1, rgb(190, 160, 110), M.Wood)
			egg(m, "TomatoPlant", F * CFrame.new(x, top + 1.3, 0), Vector3.new(1.1, 2.2, 1.1), LEAF_D, M.Grass)
			for k = 0, 2 do
				local a = k * 2.1 + i
				newPart(m, "Tomato", Vector3.new(0.3, 0.3, 0.3), F * CFrame.new(x + math.cos(a) * 0.45, top + 0.9 + k * 0.45, math.sin(a) * 0.45), (k == 2 and hash(seed, i) < 0.5) and rgb(250, 170, 60) or rgb(220, 40, 40), M.SmoothPlastic, "Ball")
			end
		end
	elseif kind == 4 then
		-- citrouilles (côtes) + grandes feuilles
		for i = 0, 2 do
			local x = -1.9 + i * 1.9
			egg(m, "Pumpkin", F * CFrame.new(x, top + 0.35, 0), Vector3.new(1.1, 0.75, 1.0), rgb(236, 128, 36), M.SmoothPlastic)
			newPart(m, "PumpkinStem", Vector3.new(0.3, 0.12, 0.12), F * CFrame.new(x, top + 0.8, 0) * UPRIGHT, rgb(110, 120, 60), M.Wood, "Cyl")
			egg(m, "PumpkinLeaf", F * CFrame.new(x + 0.6, top + 0.2, 0.6), Vector3.new(1.1, 0.2, 0.9), LEAF, M.Grass)
		end
	elseif kind == 5 then
		-- fraises : touffes + fruits rouges
		for i = 0, 5 do
			for _, z in ipairs({ -0.55, 0.55 }) do
				local x = -2.4 + i * 0.96
				egg(m, "StrawLeaves", F * CFrame.new(x, top + 0.18, z), Vector3.new(0.7, 0.34, 0.7), LEAF, M.Grass)
				egg(m, "Strawberry", F * CFrame.new(x + 0.28, top + 0.12, z + 0.2), Vector3.new(0.16, 0.2, 0.16), rgb(230, 30, 60), M.SmoothPlastic)
			end
		end
	else
		-- tournesols
		for i = 0, 3 do
			local x = -2.1 + i * 1.4
			local h = 3.2 + hash(seed, i) * 1.2
			column(m, "SunStem", F, x, 0, top, top + h, 0.16, LEAF_D, M.Grass)
			egg(m, "SunLeaf", F * CFrame.new(x + 0.35, top + h * 0.45, 0), Vector3.new(0.8, 0.12, 0.5), LEAF, M.Grass)
			local headCF = F * CFrame.new(x, top + h + 0.1, -0.15) * CFrame.Angles(math.rad(-20), 0, 0)
			newPart(m, "SunPetals", Vector3.new(0.12, 1.3, 1.3), headCF * CFrame.Angles(0, math.rad(90), 0), rgb(255, 204, 30), M.SmoothPlastic, "Cyl")
			newPart(m, "SunCenter", Vector3.new(0.16, 0.66, 0.66), headCF * CFrame.new(0, 0, -0.04) * CFrame.Angles(0, math.rad(90), 0), rgb(96, 60, 30), M.Grass, "Cyl")
		end
	end
end

local function buildCommunityGarden(m: Model, F: CFrame, seed: number)
	local W, D = 26, 20
	-- allées en gravier (en croix)
	box(m, "GardenPath", F, -1.2, 1.2, -0.3, 0.1, -D / 2, D / 2, rgb(214, 204, 184), M.Pebble)
	box(m, "GardenPath", F, -W / 2 + 1, W / 2 - 1, -0.32, 0.08, -1.1, 1.1, rgb(214, 204, 184), M.Pebble)
	-- haie basse (entrée au milieu du côté -Z) + portail en arche
	local hedge = rgb(70, 132, 66)
	for _, seg in ipairs({ { -W / 2, -2.2, -D / 2 }, { 2.2, W / 2, -D / 2 }, { -W / 2, W / 2, D / 2 } }) do
		local x0, x1, z = seg[1], seg[2], seg[3]
		egg(m, "Hedge", F * CFrame.new((x0 + x1) / 2, 0.8, z), Vector3.new(x1 - x0, 1.9, 1.3), hedge, M.Grass)
	end
	for _, sx in ipairs({ -1, 1 }) do
		egg(m, "Hedge", F * CFrame.new(sx * W / 2, 0.8, 0), Vector3.new(1.3, 1.9, D), hedge, M.Grass)
	end
	for _, sx in ipairs({ -1, 1 }) do
		column(m, "ArchPost", F, sx * 2.1, -D / 2, -0.1, 7, 0.4, WHITE, M.Wood, true)
	end
	for k = 0, 6 do
		local a = math.rad(180 * k / 6)
		local a2 = math.rad(180 * (k + 1) / 6)
		rod(m, "Arch", (F * CFrame.new(math.cos(a) * 2.1, 7 + math.sin(a) * 1.2, -D / 2)).Position, (F * CFrame.new(math.cos(a2) * 2.1, 7 + math.sin(a2) * 1.2, -D / 2)).Position, 0.3, WHITE, M.Wood)
	end
	local sign = box(m, "GardenSign", F, -1.9, 1.9, 5.6, 6.6, -D / 2 - 0.1, -D / 2 + 0.05, rgb(92, 140, 70), M.Wood)
	surfaceText(sign, Enum.NormalId.Front, "🥕 " .. Locale.T("Community gardens"), WHITE, rgb(92, 140, 70), Enum.Font.FredokaOne, 100)
	-- rosier grimpant sur l'arche
	for k = 0, 4 do
		egg(m, "Roses", F * CFrame.new(-1.8 + k * 0.9, 7.6 + math.sin(k) * 0.4, -D / 2), Vector3.new(0.9, 0.7, 0.7), k % 2 == 0 and rgb(236, 80, 120) or LEAF, M.Grass)
	end
	-- 6 carrés potagers (3 x 2 de part et d'autre de l'allée)
	local kind = 0
	for _, sz in ipairs({ -1, 1 }) do
		for i = 0, 2 do
			kind += 1
			local x = -8 + i * 8
			if not (sz > 0 and i == 2) then
				raisedBed(m, F * CFrame.new(x, 0, sz * 5.2), kind, seed * 7 + kind)
			end
		end
	end
	-- serre vitrée (coin arrière droit)
	local G = F * CFrame.new(8.6, 0, 6)
	box(m, "GreenBase", G, -3, 3, -0.2, 0.4, -2.4, 2.4, rgb(190, 184, 176), M.Brick, true)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			column(m, "GreenFrame", G, sx * 2.95, sz * 2.35, 0.4, 4.2, 0.12, WHITE, M.Metal)
		end
		local side = box(m, "GreenGlass", G, sx * 2.95 - 0.04, sx * 2.95 + 0.04, 0.4, 4.2, -2.3, 2.3, GLASS, M.Glass, true)
		side.Transparency = 0.6
		local roof = newPart(m, "GreenRoof", Vector3.new(3.4, 0.08, 4.9), G * CFrame.new(sx * 1.45, 4.95, 0) * CFrame.Angles(0, 0, sx * math.rad(-28)), GLASS, M.Glass)
		roof.Transparency = 0.55
	end
	local back = box(m, "GreenGlass", G, -2.9, 2.9, 0.4, 4.2, 2.31, 2.39, GLASS, M.Glass, true)
	back.Transparency = 0.6
	box(m, "GreenRidge", G, -0.1, 0.1, 5.7, 5.85, -2.45, 2.45, WHITE, M.Metal)
	for i = 0, 2 do
		egg(m, "Seedlings", G * CFrame.new(-1.6 + i * 1.6, 1.3, 1.2), Vector3.new(1.2, 0.7, 1.2), LEAF, M.Grass)
	end
	box(m, "PotBench", G, -2.6, 2.6, 0.4, 0.95, 0.6, 1.8, WOOD, M.Wood)
	-- cabane à outils (coin arrière gauche)
	local S = F * CFrame.new(-10.2, 0, 7) * CFrame.Angles(0, math.rad(90), 0)
	box(m, "Shed", S, -2, 2, -0.1, 4.4, -1.6, 1.6, rgb(120, 150, 110), M.WoodPlanks, true)
	for _, sz in ipairs({ -1, 1 }) do
		newPart(m, "ShedRoof", Vector3.new(4.6, 0.2, 2.1), S * CFrame.new(0, 4.9, sz * 0.9) * CFrame.Angles(sz * math.rad(-26), 0, 0), rgb(110, 70, 60), M.Slate)
	end
	box(m, "ShedDoor", S, -0.8, 0.8, 0, 3.4, -1.66, -1.6, rgb(90, 118, 84), M.Wood)
	-- outils appuyés contre la cabane : râteau, pelle
	rod(m, "RakeHandle", (S * CFrame.new(1.4, 0.1, -1.9)).Position, (S * CFrame.new(1.6, 3.6, -1.7)).Position, 0.12, rgb(170, 130, 90), M.Wood)
	box(m, "RakeHead", S, 1.0, 1.9, 0.05, 0.25, -2.0, -1.85, GRAPHITE, M.Metal)
	rod(m, "ShovelHandle", (S * CFrame.new(-1.4, 0.8, -1.9)).Position, (S * CFrame.new(-1.6, 3.8, -1.7)).Position, 0.12, rgb(170, 130, 90), M.Wood)
	box(m, "ShovelBlade", S, -1.6, -1.1, 0.05, 0.9, -2.0, -1.9, STEEL, M.Metal)
	-- composteurs, récupérateur d'eau, brouette, arrosoir
	for i = 0, 1 do
		local C = F * CFrame.new(-11 + i * 2.4, 0, -6.5)
		box(m, "Compost", C, -1, 1, 0, 1.6, -1, 1, WOOD_D, M.WoodPlanks, true)
		box(m, "CompostTop", C, -0.92, 0.92, 0.05, 1.66, -0.92, 0.92, SOIL, M.Ground)
	end
	column(m, "RainBarrel", F, 5.6, 8.6, 0, 2.6, 1.8, rgb(40, 90, 150), M.Plastic, true)
	column(m, "BarrelTap", F, 5.6, 7.6, 0.6, 0.8, 0.2, STEEL, M.Metal)
	local wb = F * CFrame.new(3.4, 0, -3.2) * CFrame.Angles(0, math.rad(30), 0)
	box(m, "Barrow", wb, -0.8, 0.8, 0.8, 1.5, -1.2, 1.0, rgb(46, 120, 80), M.Metal)
	newPart(m, "BarrowWheel", Vector3.new(0.3, 0.9, 0.9), wb * CFrame.new(0, 0.45, -1.4), GRAPHITE, M.Rubber, "Cyl")
	for _, sx in ipairs({ -1, 1 }) do
		rod(m, "BarrowHandle", (wb * CFrame.new(sx * 0.6, 1.2, 0.8)).Position, (wb * CFrame.new(sx * 0.7, 1.0, 2.4)).Position, 0.12, rgb(170, 130, 90), M.Wood)
	end
	egg(m, "BarrowSoil", wb * CFrame.new(0, 1.45, -0.1), Vector3.new(1.4, 0.5, 2.0), SOIL, M.Ground)
	column(m, "WateringCan", F, -3.4, 2.4, 0.1, 0.9, 0.8, rgb(60, 150, 110), M.Metal)
	rod(m, "CanSpout", (F * CFrame.new(-3.0, 0.6, 2.4)).Position, (F * CFrame.new(-2.4, 1.0, 2.4)).Position, 0.1, rgb(60, 150, 110), M.Metal)
	-- épouvantail
	local E = F * CFrame.new(0, 0, 3.4)
	column(m, "ScarePost", E, 0, 0, -0.1, 5.4, 0.2, WOOD_D, M.Wood)
	box(m, "ScareArms", E, -1.8, 1.8, 3.9, 4.1, -0.1, 0.1, WOOD_D, M.Wood)
	box(m, "ScareShirt", E, -0.8, 0.8, 2.8, 4.3, -0.35, 0.35, rgb(200, 70, 60), M.Fabric)
	newPart(m, "ScareHead", Vector3.new(0.9, 0.9, 0.9), E * CFrame.new(0, 4.85, 0), rgb(226, 204, 150), M.Fabric, "Ball")
	newPart(m, "ScareHatBrim", Vector3.new(0.08, 1.8, 1.8), E * CFrame.new(0, 5.25, 0) * UPRIGHT, rgb(210, 180, 100), M.Fabric, "Cyl")
	newPart(m, "ScareHatTop", Vector3.new(0.6, 0.9, 0.9), E * CFrame.new(0, 5.55, 0) * UPRIGHT, rgb(210, 180, 100), M.Fabric, "Cyl")
	-- 2 jardiniers
	local g1 = npc(m, "elder", seed * 5 + 1, F * CFrame.new(-4.2, 0, -2.6) * CFrame.Angles(0, math.rad(200), 0), "none")
	addActor(g1, "Idle", { Anim = "talk" }, hash(seed, 3) * 10)
	local g2 = npc(m, "worker", seed * 5 + 2, F * CFrame.new(5, 0, 2.3) * CFrame.Angles(0, math.rad(20), 0), "none")
	addActor(g2, "Idle", { Anim = "idle" }, hash(seed, 4) * 10)
end

----------------------------------------------------------------------
-- 🏓 Coin sport : ping-pong, pétanque, fitness
----------------------------------------------------------------------

local TABLE_TOP = 2.3 -- plateau d'une table de ping-pong (76 cm à l'échelle de l'avatar)

local function pingPong(m: Model, T: CFrame, playing: boolean, seed: number)
	-- pied en béton + plateau (2,74 x 1,525 m -> 8,3 x 4,6 studs) + lignes + filet
	box(m, "PPBase", T, -2.6, 2.6, -0.1, TABLE_TOP - 0.3, -0.4, 0.4, CONCRETE_D, M.Concrete, true)
	box(m, "PPTop", T, -4.15, 4.15, TABLE_TOP - 0.3, TABLE_TOP, -2.3, 2.3, rgb(40, 110, 90), M.Concrete, true)
	-- lignes blanches (dessus 0,03 au-dessus du plateau, en retrait des bords)
	box(m, "PPEdge", T, -4.1, 4.1, TABLE_TOP - 0.02, TABLE_TOP + 0.03, -2.26, -2.16, WHITE, M.SmoothPlastic)
	box(m, "PPEdge", T, -4.1, 4.1, TABLE_TOP - 0.02, TABLE_TOP + 0.03, 2.16, 2.26, WHITE, M.SmoothPlastic)
	box(m, "PPCenter", T, -4.1, 4.1, TABLE_TOP - 0.02, TABLE_TOP + 0.03, -0.04, 0.04, WHITE, M.SmoothPlastic)
	for _, sx in ipairs({ -1, 1 }) do
		box(m, "PPEnd", T, sx * 4.07 - 0.05, sx * 4.07 + 0.05, TABLE_TOP - 0.02, TABLE_TOP + 0.06, -2.16, 2.16, WHITE, M.SmoothPlastic)
	end
	box(m, "PPNet", T, -0.04, 0.04, TABLE_TOP, TABLE_TOP + 0.5, -2.45, 2.45, STEEL, M.DiamondPlate)
	box(m, "PPNetTop", T, -0.07, 0.07, TABLE_TOP + 0.48, TABLE_TOP + 0.56, -2.5, 2.5, WHITE, M.SmoothPlastic)
	if playing then
		local ball = newPart(m, "PPBall", Vector3.new(0.14, 0.14, 0.14), T * CFrame.new(0, TABLE_TOP + 1, 0), rgb(255, 250, 240), M.SmoothPlastic, "Ball")
		local players = {}
		for i, sx in ipairs({ -1, 1 }) do
			local p = npc(m, i == 1 and "kid" or "pedestrian", seed * 3 + i, T * CFrame.new(sx * 6.2, 0, 0) * CFrame.Angles(0, sx > 0 and math.rad(90) or math.rad(-90), 0), "none")
			players[i] = p
		end
		addActor(players[1], "PingPong", { T = T, Ball = ball, Players = players, Lead = true }, hash(seed, 7) * 5)
		addActor(players[2], "PingPong", { T = T, Players = players, Lead = false }, hash(seed, 7) * 5)
	end
end

local function buildSportsCorner(m: Model, F: CFrame, seed: number)
	local W, D = 24, 18
	-- sol : dalle claire (ping-pong), sable (pétanque), sol souple (fitness)
	box(m, "SportPad", F, -W / 2, 0, -0.5, 0.2, -D / 2, D / 2, rgb(208, 204, 196), M.Concrete, true)
	-- ping-pong : 2 tables (une partie en cours)
	pingPong(m, F * CFrame.new(-6, 0.2, -4.2), true, seed)
	pingPong(m, F * CFrame.new(-6, 0.2, 4.6), false, seed + 1)
	-- pétanque : terrain en sable stabilisé + bordure bois + boules
	local B = F * CFrame.new(6.2, 0, -4)
	box(m, "BoulePitch", B, -5.6, 5.6, -0.4, 0.12, -2.4, 2.4, rgb(222, 200, 160), M.Sand)
	for _, sz in ipairs({ -1, 1 }) do
		box(m, "BouleEdge", B, -5.8, 5.8, -0.2, 0.34, sz * 2.5 - 0.12, sz * 2.5 + 0.12, WOOD_D, M.Wood, true)
	end
	for _, sx in ipairs({ -1, 1 }) do
		box(m, "BouleEdge", B, sx * 5.7 - 0.12, sx * 5.7 + 0.12, -0.2, 0.34, -2.38, 2.38, WOOD_D, M.Wood, true)
	end
	newPart(m, "Jack", Vector3.new(0.2, 0.2, 0.2), B * CFrame.new(3.6, 0.22, 0.4), rgb(240, 200, 40), M.Wood, "Ball")
	for i = 0, 5 do
		local a = i * 1.3 + seed
		newPart(m, "Boule", Vector3.new(0.4, 0.4, 0.4), B * CFrame.new(3.2 + math.cos(a) * (0.6 + i * 0.25), 0.32, 0.4 + math.sin(a) * 0.7), STEEL, M.Metal, "Ball")
	end
	local p1 = npc(m, "elder", seed * 11 + 1, B * CFrame.new(-4, 0.12, 0.6) * CFrame.Angles(0, math.rad(-90), 0), "none")
	addActor(p1, "Idle", { Anim = "cheer" }, hash(seed, 21) * 10)
	-- fitness : sol souple + barre fixe, barres parallèles, banc à abdos
	local Fi = F * CFrame.new(6.2, 0, 4.6)
	box(m, "FitFloor", Fi, -5.6, 5.6, -0.4, 0.16, -3, 3, rgb(60, 110, 150), M.Rubber, true)
	for _, x in ipairs({ -4.6, -1.8 }) do
		column(m, "PullPost", Fi, x, 0, 0, 7.2, 0.3, rgb(40, 150, 90), M.Metal, true)
	end
	rod(m, "PullBar", (Fi * CFrame.new(-4.6, 7, 0)).Position, (Fi * CFrame.new(-1.8, 7, 0)).Position, 0.2, STEEL, M.Metal, true)
	for _, z in ipairs({ -0.9, 0.9 }) do
		for _, x in ipairs({ 0.6, 3.4 }) do
			column(m, "DipPost", Fi, x, z, 0, 3.6, 0.24, rgb(40, 150, 90), M.Metal, true)
		end
		rod(m, "DipBar", (Fi * CFrame.new(0.6, 3.6, z)).Position, (Fi * CFrame.new(3.4, 3.6, z)).Position, 0.2, STEEL, M.Metal, true)
	end
	local bench = Fi * CFrame.new(3.6, 0, -1.9) * CFrame.Angles(0, math.rad(90), 0)
	newPart(m, "SitUpBench", Vector3.new(3.2, 0.25, 1), bench * CFrame.new(0, 1.2, 0) * CFrame.Angles(0, 0, math.rad(12)), rgb(30, 30, 34), M.Fabric, nil, true)
	for _, x in ipairs({ -1.2, 1.2 }) do
		column(m, "SitUpLeg", bench, x, 0, 0, x < 0 and 0.95 or 1.45, 0.2, STEEL, M.Metal)
	end
	local sign = box(m, "SportSign", F, -2.4, 2.4, 3.2, 4.2, -D / 2 - 0.1, -D / 2 + 0.05, rgb(40, 110, 170), M.Metal)
	surfaceText(sign, Enum.NormalId.Front, "🏓 " .. Locale.T("Sports corner"), WHITE, rgb(40, 110, 170), Enum.Font.FredokaOne, 100)
	column(m, "SignPost", F, -1.9, -D / 2, -0.1, 3.3, 0.16, GRAPHITE, M.Metal)
	column(m, "SignPost", F, 1.9, -D / 2, -0.1, 3.3, 0.16, GRAPHITE, M.Metal)
	lampPost(m, F, 0, D / 2 + 1.4, 0)
end

TownDistricts.BUILDERS = {
	SkatePark = buildSkatePark,
	CommunityGarden = buildCommunityGarden,
	SportsCorner = buildSportsCorner,
}
TownDistricts.BIG = { SkatePark = true, CommunityGarden = true, SportsCorner = true }

----------------------------------------------------------------------
-- Animation (à chaque image, près de la caméra)
----------------------------------------------------------------------

local function stepSkater(a: Actor, t: number)
	local d = a.Data
	local P: CFrame = d.P
	local pos, yaw, pitch, lift
	if d.Mode == 1 then
		-- aller-retour d'une rampe à l'autre : x(t) = A sin(ωt), la planche
		-- suit la courbe (vitesse nulle en haut : demi-tour naturel)
		-- (demi-tour à ~55° dans la courbe : le skateur ne se couche pas)
		local A = QP_CX + QP_R * math.sin(math.rad(55))
		local w = math.pi * 2 / 6.4
		local x = A * math.sin(w * t)
		local vx = A * w * math.cos(w * t)
		local h, slope = skateGround(x)
		pos = Vector3.new(x, h, 0.6)
		yaw = vx >= 0 and 0 or math.pi
		-- (la planche est le long de X ; dans la montée elle se cabre)
		pitch = slope * (vx >= 0 and 1 or -1)
		lift = 0
	else
		-- tour de la funbox (ellipse) avec un ollie à chaque passage devant
		local w = math.pi * 2 / 7.5
		local ang = w * t
		local x = math.cos(ang) * 6.2
		local z = -5.4 + math.sin(ang) * 3.4
		local vx, vz = -math.sin(ang) * 6.2, math.cos(ang) * 3.4
		pos = Vector3.new(x, 0, z)
		yaw = math.atan2(-vz, vx) -- (X local de la planche le long de la vitesse)
		local u = (ang / (math.pi * 2)) % 1
		lift = (u > 0.42 and u < 0.58) and math.sin((u - 0.42) / 0.16 * math.pi) * 1.1 or 0
		pitch = (u > 0.42 and u < 0.47) and 0.35 or 0
	end
	local boardCF = P * CFrame.new(pos + Vector3.new(0, lift, 0)) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(0, 0, pitch)
	local frames = {}
	for i, part in ipairs(d.Board) do
		frames[i] = boardCF * BOARD_LOCAL[i]
	end
	workspace:BulkMoveTo(d.Board, frames, Enum.BulkMoveMode.FireCFrameChanged)
	-- le skateur : de profil sur la planche (regarde vers +Z de la planche),
	-- pieds sur le plateau, un peu fléchi
	local riderCF = boardCF * CFrame.new(0, 0.37, 0)
	NPCModels.Place(a.Model, riderCF)
	NPCModels.Animate(a.Model, "idle", t)
end

local function stepPingPong(a: Actor, t: number)
	local d = a.Data
	local T: CFrame = d.T
	-- un échange : la balle va de -X à +X en 0,9 s (rebond sur la table), et revient
	local period = 1.8
	local u = (t % period) / period
	local dir = u < 0.5 and 1 or -1
	local k = (u % 0.5) / 0.5
	local x0, x1 = -5.4 * dir, 5.4 * dir
	local x = x0 + (x1 - x0) * k
	-- rebond à 70 % du trajet (sur le demi-terrain d'en face)
	local y
	if k < 0.7 then
		local s = k / 0.7
		y = TABLE_TOP + 0.15 + 1.1 * 4 * s * (1 - s) + (1 - s) * 0.9
	else
		local s = (k - 0.7) / 0.3
		y = TABLE_TOP + 0.15 + 1.0 * 4 * s * (1 - s) * 0.9 + s * 0.9
	end
	if d.Lead and d.Ball then
		d.Ball.CFrame = T * CFrame.new(x, y, math.sin(t * 1.7) * 0.8)
	end
	-- le joueur frappe quand la balle arrive de son côté
	local mine = d.Lead and -1 or 1
	local hit = (dir == mine and k < 0.2) or (dir ~= mine and k > 0.85)
	NPCModels.Animate(a.Model, hit and "wave" or "idle", t)
end

function TownDistricts.Step(dt: number)
	if #actors == 0 then
		return
	end
	local camera = workspace.CurrentCamera
	local eye = camera and camera.CFrame.Position
	local now = os.clock()
	for i = #actors, 1, -1 do
		local a = actors[i]
		if not a.Model.Parent then
			table.remove(actors, i)
		else
			local pivot = a.Model:GetPivot().Position
			if not eye or (pivot - eye).Magnitude < ANIM_R then
				local t = now + a.Phase
				local ok = pcall(function()
					if a.Kind == "Skater" then
						stepSkater(a, t)
					elseif a.Kind == "PingPong" then
						stepPingPong(a, t)
					else
						NPCModels.Animate(a.Model, a.Data.Anim or "idle", t)
					end
				end)
				if not ok then
					table.remove(actors, i)
				end
			end
		end
	end
	local _ = dt
end

-- (tests) nombre d'acteurs animés
function TownDistricts.Count(): number
	return #actors
end

return TownDistricts
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="232">
          <Properties>
            <string name="Name">TownEmotes</string>
            <string name="Source"><![CDATA[--[[
	TownEmotes (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > TownEmotes

	💃 Dopamine Town : les émotes de l'avatar, qui s'ARRÊTENT toujours.

	Cause du bug v9.3 ("je danse et je ne peux plus m'arrêter") : l'ancien
	playEmote chargeait l'animation "dance" du script Animate (en boucle)
	sur l'Animator, la jouait… et ne gardait AUCUNE référence : personne ne
	pouvait l'arrêter (le script Animate ne la connaît pas, marcher ou sauter
	ne la coupait pas). Humanoid:PlayEmote ne marche que pour les émotes
	équipées de l'avatar : en Studio c'était presque toujours ce chemin-là.

	Maintenant :
	  - la piste de l'émote en cours est GARDÉE (Tracks) ; nos propres pistes
	    (priorité Action) viennent du script Animate de l'avatar (R15 ET R6 :
	    wave, dance, cheer, point…) ; "dance" boucle, les autres (salut,
	    youpi, montrer) s'arrêtent toutes seules ;
	  - repli : Humanoid:PlayEmote (avatar sans script Animate) -> on repère
	    les pistes qu'il vient de lancer pour pouvoir les arrêter aussi ;
	  - ARRÊT (fondu 0,2 s) : bouger (MoveDirection ou manette > 0,1),
	    sauter (JumpRequest / Jumping / StateChanged), nouvelle émote,
	    s'asseoir, mode édition, bouton ⏹, sortie de la ville, mort ou
	    retrait du personnage (TownClient appelle Stop / Detach) ;
	  - "s'asseoir" (par terre) : bouger ou sauter relève l'avatar
	    (Humanoid.Sit = false) ; bouton "Se lever" pendant qu'on est assis
	    (sur un siège aussi : TownClient demande en plus au serveur de
	    détruire le Seat).
	État lu par le HUD : State() -> "Emote" | "Sit" | nil (OnChanged).
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local TownEmotes = {}
TownEmotes.__index = TownEmotes

local FADE = 0.2
local MOVE_THRESHOLD = 0.1
-- émotes qui bouclent jusqu'à l'arrêt ; les autres se jouent une fois
local LOOPED: { [string]: boolean } = { dance = true, dance2 = true, dance3 = true }
-- (sécurité) une émote "une fois" dont la durée est inconnue s'arrête au bout de…
local ONE_SHOT_MAX = 6

export type Hooks = {
	OnChanged: ((state: string?, name: string?) -> ())?,
	-- vrai = un autre mode tient l'avatar (bureau DeskMode) : les émotes se taisent
	Blocked: (() -> boolean)?,
	Toast: ((text: string) -> ())?,
}

-- Manette de Roblox (PlayerModule) : vecteur de déplacement même assis
local function controlsOf(): any
	local player = Players.LocalPlayer
	local scripts = player and player:FindFirstChild("PlayerScripts")
	local module = scripts and scripts:FindFirstChild("PlayerModule")
	if not module or not module:IsA("ModuleScript") then
		return nil
	end
	local ok, controls = pcall(function()
		return (require(module) :: any):GetControls()
	end)
	return ok and controls or nil
end

function TownEmotes.new(hooks: Hooks?)
	local self = setmetatable({
		Hooks = hooks or {},
		Character = nil :: Model?,
		Humanoid = nil :: Humanoid?,
		Tracks = {} :: { AnimationTrack },
		Name = nil :: string?,
		Looped = false,
		Own = false, -- pistes chargées par nous (détruites après l'arrêt)
		Started = 0,
		Length = 0,
		Sitting = false,
		Connections = {} :: { RBXScriptConnection },
		TrackConnections = {} :: { RBXScriptConnection },
		Controls = nil :: any,
		ControlsTried = false,
		LastState = nil :: string?,
		Stops = {} :: { [string]: number }, -- (tests) arrêts par raison
	}, TownEmotes)
	return self
end

----------------------------------------------------------------------
-- État
----------------------------------------------------------------------

function TownEmotes.IsBlocked(self: any): boolean
	local blocked = self.Hooks.Blocked
	if not blocked then
		return false
	end
	local ok, result = pcall(blocked)
	return ok and result == true
end

function TownEmotes.State(self: any): string?
	-- (au bureau : DeskMode montre son propre "Se lever")
	if self:IsBlocked() then
		return nil
	end
	if self.Name then
		return "Emote"
	end
	if self.Sitting then
		return "Sit"
	end
	return nil
end

function TownEmotes.IsPlaying(self: any): boolean
	return self.Name ~= nil
end

function TownEmotes.Notify(self: any)
	local state = self:State()
	local key = tostring(state) .. "|" .. tostring(self.Name)
	if key == self.LastState then
		return
	end
	self.LastState = key
	local hook = self.Hooks.OnChanged
	if hook then
		local ok, err = pcall(hook, state, self.Name)
		if not ok then
			warn("[TownEmotes] " .. tostring(err))
		end
	end
end

local function disconnectAll(list: { RBXScriptConnection })
	for _, connection in ipairs(list) do
		connection:Disconnect()
	end
	table.clear(list)
end

----------------------------------------------------------------------
-- Arrêt
----------------------------------------------------------------------

-- Arrête l'émote en cours (fondu 0,2 s). `reason` : "move", "jump", "new",
-- "sit", "edit", "button", "leave", "removed", "ended"…
function TownEmotes.Stop(self: any, reason: string?)
	local tracks = self.Tracks
	local had = self.Name ~= nil
	local own = self.Own
	local humanoid = self.Humanoid
	if had and #tracks == 0 and not own and humanoid then
		-- (émote équipée dont on n'a pas vu la piste : on coupe les pistes
		-- "Action" en cours, jamais la marche / l'attente du script Animate)
		local animator = humanoid:FindFirstChildOfClass("Animator")
		if animator then
			pcall(function()
				for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
					if track.Priority.Value >= Enum.AnimationPriority.Action.Value then
						table.insert(tracks, track)
					end
				end
			end)
		end
	end
	self.Tracks = {}
	self.Own = false
	self.Name = nil
	self.Looped = false
	disconnectAll(self.TrackConnections)
	for _, track in ipairs(tracks) do
		pcall(function()
			track:Stop(FADE)
		end)
	end
	if own and #tracks > 0 then
		-- (pistes chargées par nous : libérées après le fondu)
		task.delay(FADE + 0.1, function()
			for _, track in ipairs(tracks) do
				pcall(function()
					if not track.IsPlaying then
						track:Destroy()
					end
				end)
			end
		end)
	end
	if had then
		local key = reason or "?"
		self.Stops[key] = (self.Stops[key] or 0) + 1
	end
	self:Notify()
end

-- Relève l'avatar (assis par terre ou sur un siège)
function TownEmotes.StandUp(self: any)
	local humanoid = self.Humanoid
	if not humanoid then
		return
	end
	local seated = humanoid.SeatPart ~= nil
	pcall(function()
		humanoid.Sit = false
	end)
	if seated then
		-- (comme la touche "sauter" : Roblox détache le siège)
		pcall(function()
			humanoid.Jump = true
		end)
	end
	self.Sitting = false
	self:Notify()
end

----------------------------------------------------------------------
-- Personnage
----------------------------------------------------------------------

function TownEmotes.RefreshSit(self: any)
	local humanoid = self.Humanoid
	local sitting = humanoid ~= nil and (humanoid.Sit == true or humanoid.SeatPart ~= nil)
	if sitting ~= self.Sitting then
		self.Sitting = sitting
		if sitting and self.Name then
			self:Stop("sit")
		end
		self:Notify()
	end
end

-- Mouvement demandé (manette, clavier, joystick tactile) ?
function TownEmotes.MoveMagnitude(self: any): number
	local humanoid = self.Humanoid
	local direction = humanoid and humanoid.MoveDirection
	local magnitude = typeof(direction) == "Vector3" and direction.Magnitude or 0
	if not self.ControlsTried then
		self.ControlsTried = true
		self.Controls = controlsOf()
	end
	local controls = self.Controls
	if controls then
		local ok, vector = pcall(function()
			return controls:GetMoveVector()
		end)
		if ok and typeof(vector) == "Vector3" then
			magnitude = math.max(magnitude, vector.Magnitude)
		end
	end
	return magnitude
end

-- Bouger : arrête l'émote ; relève l'avatar assis PAR TERRE (pas un siège :
-- on ne se lève pas d'un canapé en touchant le joystick par erreur)
function TownEmotes.OnMove(self: any)
	if self:IsBlocked() or self:MoveMagnitude() <= MOVE_THRESHOLD then
		return
	end
	if self.Name then
		self:Stop("move")
	end
	local humanoid = self.Humanoid
	if humanoid and humanoid.Sit == true and humanoid.SeatPart == nil then
		self:StandUp()
	end
end

-- Sauter : arrête l'émote et relève l'avatar (par terre ou siège)
function TownEmotes.OnJump(self: any)
	if self:IsBlocked() then
		return
	end
	if self.Name then
		self:Stop("jump")
	end
	local humanoid = self.Humanoid
	if humanoid and (humanoid.Sit == true or humanoid.SeatPart ~= nil) then
		self:StandUp()
	end
end

function TownEmotes.Attach(self: any, character: Model?)
	self:Detach()
	if not character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	self.Character = character
	self.Humanoid = humanoid
	local list = self.Connections
	-- (chaque signal est facultatif : un Humanoid / émulateur incomplet ne casse rien)
	local function watch(getSignal: () -> any, fn: (...any) -> ())
		local ok, connection = pcall(function()
			local signal = getSignal()
			return signal and signal:Connect(fn) or nil
		end)
		if ok and connection then
			table.insert(list, connection)
		end
	end
	watch(function()
		return humanoid:GetPropertyChangedSignal("MoveDirection")
	end, function()
		self:OnMove()
	end)
	watch(function()
		return humanoid:GetPropertyChangedSignal("Sit")
	end, function()
		self:RefreshSit()
	end)
	watch(function()
		return humanoid.Seated
	end, function()
		self:RefreshSit()
	end)
	watch(function()
		return humanoid.Jumping
	end, function(active: boolean)
		if active and self.Name then
			self:Stop("jump")
		end
	end)
	watch(function()
		return humanoid.StateChanged
	end, function(_old: Enum.HumanoidStateType, new: Enum.HumanoidStateType)
		if new == Enum.HumanoidStateType.Jumping or new == Enum.HumanoidStateType.Freefall then
			if self.Name then
				self:Stop("jump")
			end
		elseif new == Enum.HumanoidStateType.Seated then
			self:RefreshSit()
		elseif new == Enum.HumanoidStateType.Dead then
			self:Stop("removed")
		end
	end)
	watch(function()
		return humanoid.Died
	end, function()
		self:Stop("removed")
		self.Sitting = false
		self:Notify()
	end)
	watch(function()
		return character.AncestryChanged
	end, function(_, parent)
		if parent == nil and self.Character == character then
			self:Detach()
		end
	end)
	-- (touche "sauter" même assis : Humanoid.Jumping ne vient pas toujours)
	watch(function()
		return UserInputService.JumpRequest
	end, function()
		self:OnJump()
	end)
	self.Sitting = false
	self:RefreshSit()
	self:Notify()
end

-- Personnage retiré / sortie : tout s'arrête, plus aucune connexion
function TownEmotes.Detach(self: any)
	if self.Name then
		self:Stop("removed")
	end
	disconnectAll(self.Connections)
	disconnectAll(self.TrackConnections)
	self.Character = nil
	self.Humanoid = nil
	self.Sitting = false
	self:Notify()
end

----------------------------------------------------------------------
-- Jouer
----------------------------------------------------------------------

-- Animation du script Animate de l'avatar (R15 / R6) : Animate > nom > Animation
local function findAnimation(character: Model, name: string): Animation?
	local animate = character:FindFirstChild("Animate")
	local holder = animate and animate:FindFirstChild(name)
	if not holder then
		return nil
	end
	if holder:IsA("Animation") then
		return holder
	end
	local choices: { Animation } = {}
	for _, child in ipairs(holder:GetChildren()) do
		if child:IsA("Animation") then
			table.insert(choices, child)
		end
	end
	if #choices == 0 then
		return nil
	end
	return choices[math.random(1, #choices)]
end

function TownEmotes.Track(self: any, tracks: { AnimationTrack }, name: string, looped: boolean, own: boolean)
	self.Tracks = tracks
	self.Own = own
	self.Name = name
	self.Looped = looped
	self.Started = os.clock()
	self.Length = 0
	for _, track in ipairs(tracks) do
		local ok, length = pcall(function()
			return track.Length
		end)
		if ok and type(length) == "number" then
			self.Length = math.max(self.Length, length)
		end
		-- (émote "une fois" : finie -> état remis ; une piste coupée par
		-- Roblox ou par le script Animate aussi)
		table.insert(self.TrackConnections, track.Stopped:Connect(function()
			if self.Name == name and table.find(self.Tracks, track) then
				local playing = false
				for _, other in ipairs(self.Tracks) do
					if other ~= track and other.IsPlaying then
						playing = true
					end
				end
				if not playing then
					self:Stop("ended")
				end
			end
		end))
	end
	self:Notify()
end

-- Joue une émote ; renvoie true si quelque chose se joue
function TownEmotes.Play(self: any, name: string): boolean
	local humanoid = self.Humanoid
	local character = self.Character
	if not humanoid or not character or humanoid.Health <= 0 or self:IsBlocked() then
		return false
	end
	-- une nouvelle émote remplace toujours l'ancienne
	self:Stop("new")
	if name == "sit" then
		pcall(function()
			humanoid.Sit = true
		end)
		self.Sitting = true
		self:Notify()
		return true
	end
	if humanoid.Sit == true or humanoid.SeatPart ~= nil then
		self:StandUp()
	end
	local looped = LOOPED[name] == true
	local animator = humanoid:FindFirstChildOfClass("Animator")
	-- 1) animation du script Animate (R15 ou R6), piste à nous
	local animation = findAnimation(character, name)
	if animation and animator then
		local ok, track = pcall(function()
			local t = animator:LoadAnimation(animation)
			t.Priority = Enum.AnimationPriority.Action
			t.Looped = looped
			t:Play(FADE)
			return t
		end)
		if ok and track then
			self:Track({ track }, name, looped, true)
			return true
		end
	end
	-- 2) émote équipée de l'avatar (Humanoid:PlayEmote) : on repère ses pistes
	local before: { [AnimationTrack]: boolean } = {}
	if animator then
		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
			before[track] = true
		end
	end
	local ok, played = pcall(humanoid.PlayEmote, humanoid, name)
	if ok and played then
		local started: { AnimationTrack } = {}
		if animator then
			for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
				if not before[track] then
					table.insert(started, track)
				end
			end
		end
		self:Track(started, name, looped, false)
		return true
	end
	local toast = self.Hooks.Toast
	if toast then
		pcall(toast, "This emote isn't available for your avatar")
	end
	return false
end

-- ~10 fois / s (TownClient) : filet de sécurité si un signal manque
function TownEmotes.Step(self: any)
	local humanoid = self.Humanoid
	if not humanoid then
		return
	end
	if humanoid.Parent == nil or humanoid.Health <= 0 then
		if self.Name then
			self:Stop("removed")
		end
		return
	end
	if self:IsBlocked() then
		if self.Name then
			self:Stop("desk")
		end
		return
	end
	self:RefreshSit()
	if self.Name then
		self:OnMove()
	elseif humanoid.Sit == true and humanoid.SeatPart == nil then
		self:OnMove()
	end
	if self.Name and not self.Looped then
		local limit = (self.Length > 0 and self.Length + 0.4) or ONE_SHOT_MAX
		local anyPlaying = #self.Tracks == 0
		for _, track in ipairs(self.Tracks) do
			if track.IsPlaying then
				anyPlaying = true
			end
		end
		if not anyPlaying or os.clock() - self.Started > math.min(limit, ONE_SHOT_MAX) then
			self:Stop("ended")
		end
	end
end

return TownEmotes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="233">
          <Properties>
            <string name="Name">TownFacades</string>
            <string name="Source"><![CDATA[--[[
	TownFacades (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > TownFacades

	🏘️ Dopamine Town (v9.7, BUILDINGS97) : le DÉTAIL des immeubles de rue où
	l'on n'entre pas, construit côté client et en flux autour de l'avatar.
	Le serveur (TownBuildings.RowHouse) ne pose que la coque (volume, socle,
	corniche, toit, cheminées) et des bandeaux vitrés "FarLOD" pour la vue de
	loin ; ici, près de l'avatar (≤ 200 studs, gardé jusqu'à 260) :
	  - FAÇADE sur rue, selon le style (attribut FacadeStyle) :
	      Haussmann : pierre, bandeaux, hautes fenêtres à balconnets en fer,
	                  grand balcon filant, lucarnes dans le toit en zinc ;
	      Brick     : briques, linteaux et appuis blancs, fenêtres à
	                  guillotine, gouttières ;
	      Pastel    : enduit pastel, volets ouverts, jardinières fleuries,
	                  petit balcon sous le pignon, œil-de-bœuf ;
	      Modern    : mur-rideau vitré, ailettes, dalles blanches,
	                  garde-corps en verre ;
	      Timber    : colombages (poteaux, sablières, croix de Saint-André) ;
	  - REZ-DE-CHAUSSÉE : soit une BOUTIQUE FERMÉE (devanture en bois peint,
	    enseigne, vitrine sombre aux stores à demi baissés, petite vitrine
	    d'objets, store banne ROULÉ, porte vitrée avec pancarte "Fermé pour
	    le moment", marche), soit une ENTRÉE d'immeuble (porte à imposte,
	    encadrement, perron, lanterne éteinte) ; jamais de lumière allumée ;
	  - ARRIÈRE fini (côté parc) : fenêtres encadrées, porte de service et
	    son perron, petit balcon, bac de fleurs, climatiseur, descente d'eau ;
	  - CÔTÉS EXPOSÉS (bout de rangée, vus depuis le boulevard ou la place) :
	    fenêtres, réclame peinte sur le mur, œil-de-bœuf dans le pignon.
	Les bandeaux "FarLOD" du serveur sont masqués LOCALEMENT
	(LocalTransparencyModifier) tant que le détail est construit.
	Aucune face confondue avec la coque (décalages ≥ 0,03 stud) ; tout est
	ancré, sans collision (sauf marches), sans ombre pour les petites pièces.

	API (TownClient, via optionalModule) :
	  TownFacades.Start()            à l'entrée en ville
	  TownFacades.Step(position)     position de l'avatar (facultatif)
	  TownFacades.Stop()             à la sortie (tout est détruit)
	  TownFacades.Debug() -> table   (tests / rendus)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Locale = require(ReplicatedStorage.Shared.Locale)

local TownFacades = {}

local M = Enum.Material
local rgb = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)

local FOLDER_NAME = "TownFacadeDetail"
local BUILD_RANGE, DROP_RANGE = 200, 260
-- v9.8 🎨 Graphismes > Détail (REALISM98) : distances de flux ×0,65 / ×1 / ×1,35
local okGQ, GraphicsQuality = pcall(require, game:GetService("ReplicatedStorage").Shared.GraphicsQuality)
local function detailScale(): number
	return okGQ and type(GraphicsQuality) == "table" and GraphicsQuality.DetailScale and GraphicsQuality.DetailScale() or 1
end
local STEP_EVERY = 0.5
local STEP_BUDGET = 0.003 -- (s) de construction par image
local SIGN_DISTANCE = 90
local PLAQUE_DISTANCE = 30

local GLASS = rgb(74, 96, 124)
local GLASS_SHOP = rgb(96, 110, 128)
local INTERIOR = rgb(150, 128, 118) -- (boutique éteinte, mais on voit le fond : pas un trou noir)
local IRON = rgb(40, 42, 52)

----------------------------------------------------------------------
-- Pièces
----------------------------------------------------------------------

local count = 0

local function newPart(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, solid: boolean?): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = solid == true
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Parent = parent
	count += 1
	return p
end

-- Boîte entre deux coins dans le repère F
local function box(parent: Instance, name: string, F: CFrame, x0: number, x1: number, y0: number, y1: number, z0: number, z1: number, color: Color3, material: Enum.Material?, solid: boolean?): BasePart
	return newPart(parent, name, Vector3.new(math.abs(x1 - x0), math.abs(y1 - y0), math.abs(z1 - z0)), F * CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2), color, material, solid)
end

-- Cylindre d'axe X (F) entre x0 et x1
local function rodX(parent: Instance, name: string, F: CFrame, x0: number, x1: number, y: number, z: number, diameter: number, color: Color3, material: Enum.Material?): BasePart
	local p = newPart(parent, name, Vector3.new(math.abs(x1 - x0), diameter, diameter), F * CFrame.new((x0 + x1) / 2, y, z), color, material)
	;(p :: Part).Shape = Enum.PartType.Cylinder
	return p
end

-- Cylindre vertical (F)
local function rodY(parent: Instance, name: string, F: CFrame, x: number, y0: number, y1: number, z: number, diameter: number, color: Color3, material: Enum.Material?): BasePart
	local p = newPart(parent, name, Vector3.new(math.abs(y1 - y0), diameter, diameter), F * CFrame.new(x, (y0 + y1) / 2, z) * CFrame.Angles(0, 0, math.rad(90)), color, material)
	;(p :: Part).Shape = Enum.PartType.Cylinder
	return p
end

local function ball(parent: Instance, name: string, F: CFrame, x: number, y: number, z: number, diameter: number, color: Color3, material: Enum.Material?): BasePart
	local p = newPart(parent, name, Vector3.new(diameter, diameter, diameter), F * CFrame.new(x, y, z), color, material)
	;(p :: Part).Shape = Enum.PartType.Ball
	return p
end

-- Panneau texte (SurfaceGui sur la face avant = -Z du panneau)
local function signText(board: BasePart, text: string, color: Color3, pps: number, maxDistance: number, font: Enum.Font?)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Sign"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pps
	gui.LightInfluence = 0.6
	gui.MaxDistance = maxDistance
	gui.Parent = board
	local l = Instance.new("TextLabel")
	l.Name = "Text"
	l.BackgroundTransparency = 1
	l.Position = UDim2.fromScale(0.05, 0.1)
	l.Size = UDim2.fromScale(0.9, 0.8)
	l.Font = font or Enum.Font.FredokaOne
	l.TextScaled = true
	l.Text = text
	l.TextColor3 = color
	l.Parent = gui
end

local function hash(a: number, b: number?): number
	local x = math.sin(a * 12.9898 + (b or 0) * 78.233) * 43758.5453
	return x - math.floor(x)
end

----------------------------------------------------------------------
-- Données
----------------------------------------------------------------------

-- Enseignes des boutiques fermées (clés anglaises, traduites)
local SHOP_NAMES = {
	"💐 Florist", "📖 Bookshop", "🥖 Bakery", "💊 Pharmacy", "✂️ Hair Salon", "🍫 Chocolatier", "🧀 Cheese Shop", "✏️ Stationery",
	"👓 Optician", "🚲 Bike Repair", "🍵 Tea Room", "🧺 Laundromat", "🎩 Hat Shop", "🍯 Fine Grocery", "🧶 Haberdashery", "🕰️ Watchmaker",
}
-- Réclames peintes sur les pignons
local MURALS = { "🥤 Dopamine Soda", "🍬 Candy Pop since 1998", "🧠 Think happy!", "☕ Mochi Café, 2nd street" }
local FLOWERS = { rgb(255, 110, 160), rgb(255, 214, 96), rgb(186, 140, 255), rgb(255, 150, 110), rgb(255, 255, 255) }

type Building = {
	Model: Model,
	Style: string,
	CF: CFrame, -- pied de la façade (milieu), LookVector vers la rue
	W: number,
	D: number,
	Floors: number,
	Height: number,
	Seed: number,
	GroundH: number,
	FloorH: number,
	Wall: Color3,
	Trim: Color3,
	Accent: Color3,
	Detail: Color3,
	Left: boolean, -- côté gauche (x < 0) exposé
	Right: boolean,
	LeftAbove: number, -- (côté masqué par un voisin) hauteur au-dessus de laquelle il est à nu
	RightAbove: number,
	Center: Vector3,
	Far: { BasePart },
	Detail_: Model?,
	Jobs: { () -> () }?,
	JobIndex: number,
	Built: boolean,
	Parts: number,
}

local started = false
local buildings: { Building } = {}
local folder: Folder? = nil
local conns: { RBXScriptConnection } = {}
local clock = 0
local focus: Vector3? = nil
local stats = { Built = 0, Destroyed = 0, Parts = 0 }

----------------------------------------------------------------------
-- Fenêtres (repère F : face de la coque à z = 0, dehors vers -Z)
----------------------------------------------------------------------

-- Couches (z) : verre [-0.12, -0.04] ; stores [-0.2, -0.13] ; meneaux
-- [-0.24, -0.16] ; traverse [-0.28, -0.2] ; parement [-SKIN, 0] ; appuis, linteaux,
-- volets, balcons : devant le parement
local SKIN = 0.45

type WinOpts = { Sill: boolean?, Hood: boolean?, Mullion: boolean?, Transom: boolean?, Shutters: Color3?, Box: boolean?, Curtain: boolean?, Seed: number }

local function windowTrim(parent: Instance, F: CFrame, x: number, y0: number, y1: number, ww: number, trim: Color3, opts: WinOpts)
	local hw = ww / 2
	local front = -SKIN
	if opts.Mullion then
		box(parent, "Mullion", F, x - 0.09, x + 0.09, y0, y1, -0.24, -0.16, trim, M.SmoothPlastic)
	end
	if opts.Transom then
		local ty = y0 + (y1 - y0) * 0.66
		box(parent, "Transom", F, x - hw, x + hw, ty - 0.09, ty + 0.09, -0.28, -0.2, trim, M.SmoothPlastic)
	end
	local r = hash(opts.Seed, 7)
	if opts.Curtain and r < 0.45 then
		-- store intérieur à demi baissé (pas de lumière derrière)
		local c = r < 0.2 and rgb(246, 236, 220) or rgb(236, 206, 214)
		box(parent, "Blind", F, x - hw + 0.05, x + hw - 0.05, y1 - (y1 - y0) * (0.3 + r), y1, -0.2, -0.13, c, M.Fabric)
	end
	if opts.Sill ~= false then
		box(parent, "Sill", F, x - hw - 0.35, x + hw + 0.35, y0 - 0.32, y0 + 0.03, front - 0.42, front, trim, M.Concrete)
	end
	if opts.Hood then
		box(parent, "Lintel", F, x - hw - 0.3, x + hw + 0.3, y1 + 0.05, y1 + 0.5, front - 0.3, front, trim, M.Concrete)
	end
	if opts.Shutters then
		for _, sx in ipairs({ -1, 1 }) do
			local x0 = x + sx * (hw + 0.08)
			local x1 = x + sx * (hw + 0.08 + hw * 0.92)
			box(parent, "Shutter", F, math.min(x0, x1), math.max(x0, x1), y0 + 0.05, y1 - 0.05, front - 0.16, front - 0.03, opts.Shutters, M.WoodPlanks)
		end
	end
	if opts.Box then
		box(parent, "FlowerBox", F, x - hw - 0.1, x + hw + 0.1, y0 - 0.95, y0 - 0.3, front - 0.95, front - 0.03, rgb(176, 124, 84), M.WoodPlanks)
		local color = FLOWERS[math.floor(hash(opts.Seed, 9) * #FLOWERS) + 1]
		for k = -1, 1 do
			ball(parent, "Blooms", F, x + k * hw * 0.62, y0 - 0.12, front - 0.5, 0.9, k == 0 and rgb(104, 172, 96) or color, M.Grass)
		end
	end
end

-- Un étage de fenêtres percées dans un parement (piédroits + allège + linteau)
-- `openings` : liste de { X, W } ; `yb` : bas de l'étage ; `y0`/`y1` : baie
local function skinFloor(parent: Instance, F: CFrame, w: number, yb: number, yt: number, y0: number, y1: number, openings: { { number } }, color: Color3, material: Enum.Material, glassBand: boolean)
	local hw = w / 2
	box(parent, "Spandrel", F, -hw, hw, yb, y0, -SKIN, 0, color, material)
	box(parent, "Header", F, -hw, hw, y1, yt, -SKIN, 0, color, material)
	local x = -hw
	for _, o in ipairs(openings) do
		local a = o[1] - o[2] / 2
		if a - x > 0.05 then
			box(parent, "Pier", F, x, a, y0, y1, -SKIN, 0, color, material)
		end
		x = o[1] + o[2] / 2
	end
	if hw - x > 0.05 then
		box(parent, "Pier", F, x, hw, y0, y1, -SKIN, 0, color, material)
	end
	if glassBand then
		local g = box(parent, "Glass", F, -hw + 0.3, hw - 0.3, y0, y1, -0.12, -0.04, GLASS, M.Glass)
		g.Reflectance = 0.18
	end
end

local function windowXs(w: number, n: number): { number }
	local xs = {}
	for i = 1, n do
		xs[i] = -w / 2 + (i - 0.5) * w / n
	end
	return xs
end

----------------------------------------------------------------------
-- Rez-de-chaussée
----------------------------------------------------------------------

-- Boutique fermée : devanture en bois peint, vitrine sombre, store roulé,
-- porte vitrée et pancarte "Fermé"
local function shopFront(b: Building, parent: Instance, F: CFrame)
	local w, G = b.W, b.GroundH
	local hw = w / 2
	local accent = b.Accent
	local dark = accent:Lerp(Color3.new(0, 0, 0), 0.35)
	local seed = b.Seed
	local doorRight = hash(seed, 21) < 0.5
	local dx = (doorRight and 1 or -1) * (hw - 3.6)
	local dw = 2.8
	local base = 0 -- (pied des piliers : sur le trottoir, devant le socle)
	local top = G - 2.6 -- haut de la vitrine (bas du bandeau)
	-- piliers + bandeau d'enseigne
	for _, sx in ipairs({ -1, 1 }) do
		box(parent, "Pilaster", F, sx < 0 and -hw or hw - 1.1, sx < 0 and -hw + 1.1 or hw, base, G - 0.3, -1.0, 0, accent, M.Wood)
		box(parent, "PilasterCap", F, sx < 0 and -hw - 0.05 or hw - 1.25, sx < 0 and -hw + 1.25 or hw + 0.05, G - 3.05, G - 2.75, -1.12, -1.0, dark, M.Wood)
	end
	local fascia = box(parent, "Fascia", F, -hw + 0.15, hw - 0.15, G - 2.6, G - 0.35, -1.25, 0, accent, M.Wood)
	local name = SHOP_NAMES[math.floor(hash(seed, 23) * #SHOP_NAMES) + 1]
	-- enseigne : planche claire posée sur le bandeau
	local board = box(parent, "SignBoard", F, -hw + 2.2, hw - 2.2, G - 2.35, G - 0.6, -1.33, -1.25, rgb(252, 246, 232), M.Wood)
	signText(board, Locale.T(name), dark, 28, SIGN_DISTANCE)
	local _ = fascia
	-- allège + vitrine (sombre : boutique éteinte) + fond
	local gx0, gx1 = -hw + 1.1, hw - 1.1
	local dx0, dx1 = dx - dw / 2 - 0.25, dx + dw / 2 + 0.25
	box(parent, "Stallriser", F, gx0, dx0, base, 2.4, -0.85, 0, dark, M.Wood)
	box(parent, "Stallriser", F, dx1, gx1, base, 2.4, -0.85, 0, dark, M.Wood)
	box(parent, "ShopInside", F, gx0, gx1, 2.4, top, -0.09, -0.03, INTERIOR, M.SmoothPlastic)
	for _, seg in ipairs({ { gx0, dx0 }, { dx1, gx1 } }) do
		local a, c = seg[1], seg[2]
		if c - a > 0.8 then
			local g = box(parent, "ShopGlass", F, a, c, 2.4, top, -0.72, -0.64, GLASS_SHOP, M.Glass)
			g.Transparency = 0.55
			g.Reflectance = 0.2
			-- stores intérieurs à demi baissés (fermé)
			box(parent, "ShopBlind", F, a + 0.1, c - 0.1, top - (top - 2.4) * (0.35 + hash(seed, 25 + a) * 0.2), top, -0.6, -0.54, rgb(238, 226, 210), M.Fabric)
			-- tablette de vitrine + 3 petits objets
			box(parent, "DisplayShelf", F, a + 0.1, c - 0.1, 2.4, 2.65, -0.52, -0.12, rgb(236, 226, 214), M.Wood)
			local n = math.max(1, math.floor((c - a) / 2.4))
			for k = 1, math.min(3, n) do
				local x = a + (k - 0.5) * (c - a) / math.min(3, n)
				local color = FLOWERS[(math.floor(hash(seed + k, 27) * #FLOWERS) + k) % #FLOWERS + 1]
				if k % 2 == 1 then
					box(parent, "GiftBox", F, x - 0.45, x + 0.45, 2.65, 3.45, -0.46, -0.16, color, M.SmoothPlastic)
				else
					local jar = newPart(parent, "Jar", Vector3.new(1.1, 0.5, 0.5), F * CFrame.new(x, 3.2, -0.31) * CFrame.Angles(0, 0, math.rad(90)), color:Lerp(WHITE, 0.3), M.Glass)
					;(jar :: Part).Shape = Enum.PartType.Cylinder
				end
			end
		end
	end
	-- montants de la porte, porte vitrée, imposte, poignée, pancarte
	for _, x in ipairs({ dx0, dx1 }) do
		box(parent, "DoorPost", F, x - 0.25, x + 0.25, base, top, -0.9, 0, dark, M.Wood)
	end
	box(parent, "DoorLeaf", F, dx - dw / 2, dx + dw / 2, 1.2, 6.3, -0.32, -0.12, accent, M.Wood)
	local dg = box(parent, "DoorGlass", F, dx - dw / 2 + 0.4, dx + dw / 2 - 0.4, 3.4, 5.9, -0.38, -0.33, GLASS_SHOP, M.Glass)
	dg.Reflectance = 0.2
	box(parent, "DoorHead", F, dx0 + 0.25, dx1 - 0.25, 6.3, 6.6, -0.6, -0.1, dark, M.Wood)
	local tg = box(parent, "Transom", F, dx - dw / 2, dx + dw / 2, 6.6, top, -0.4, -0.3, GLASS_SHOP, M.Glass)
	tg.Transparency = 0.3
	box(parent, "Handle", F, dx + (doorRight and -1 or 1) * (dw / 2 - 0.4) - 0.07, dx + (doorRight and -1 or 1) * (dw / 2 - 0.4) + 0.07, 3.2, 4.2, -0.5, -0.38, rgb(214, 180, 90), M.Metal)
	local plaque = box(parent, "ClosedSign", F, dx - 0.8, dx + 0.8, 4.5, 5.4, -0.44, -0.39, WHITE, M.SmoothPlastic)
	signText(plaque, Locale.T("Closed for now 😴"), rgb(200, 70, 100), 60, PLAQUE_DISTANCE, Enum.Font.GothamBold)
	-- store banne ROULÉ sous l'enseigne (boutique fermée)
	rodX(parent, "RolledAwning", F, -hw + 1.3, hw - 1.3, G - 2.95, -1.55, 0.7, hash(seed, 29) < 0.5 and accent:Lerp(WHITE, 0.35) or rgb(246, 240, 230), M.Fabric)
	-- marche devant la porte (sur le trottoir, devant le socle)
	box(parent, "Step", F, dx - dw / 2 - 0.4, dx + dw / 2 + 0.4, 0, 0.6, -1.6, -0.62, rgb(206, 200, 194), M.Concrete, true)
end

-- Entrée d'immeuble : porte à imposte, encadrement, perron, lanterne
local function homeFront(b: Building, parent: Instance, F: CFrame, color: Color3, material: Enum.Material, n: number)
	local w, G = b.W, b.GroundH
	local xs = windowXs(w, n)
	local door = (b.Seed % n) + 1
	local ww = b.Style == "Modern" and 3.4 or 2.6
	local dw = 2.8
	local openings = {}
	for i, x in ipairs(xs) do
		table.insert(openings, { x, i == door and dw or ww })
	end
	local y0, y1 = 3.4, 8
	-- parement du rez-de-chaussée (le bas de la porte est dégagé)
	local hw = w / 2
	local dxDoor = xs[door]
	box(parent, "Header", F, -hw, hw, y1, G, -SKIN, 0, color, material)
	local x = -hw
	for i, o in ipairs(openings) do
		local a = o[1] - o[2] / 2
		if a - x > 0.05 then
			box(parent, "Pier", F, x, a, 1.2, y1, -SKIN, 0, color, material)
		end
		if o[1] ~= dxDoor then
			box(parent, "Spandrel", F, a, o[1] + o[2] / 2, 1.2, y0, -SKIN, 0, color, material)
			local g = box(parent, "Glass", F, a, o[1] + o[2] / 2, y0, y1, -0.12, -0.04, GLASS, M.Glass)
			g.Reflectance = 0.18
			windowTrim(parent, F, o[1], y0, y1, o[2], b.Trim, { Sill = true, Hood = b.Style ~= "Modern", Mullion = b.Style ~= "Modern", Curtain = true, Seed = b.Seed + i })
		end
		x = o[1] + o[2] / 2
	end
	if hw - x > 0.05 then
		box(parent, "Pier", F, x, hw, 1.2, y1, -SKIN, 0, color, material)
	end
	-- porte (bois laqué), imposte vitrée, encadrement en saillie, heurtoir
	local dx = dxDoor
	local leaf = b.Style == "Modern" and rgb(70, 74, 88) or b.Accent
	box(parent, "DoorLeaf", F, dx - dw / 2, dx + dw / 2, 1.2, 6.9, -0.28, -0.08, leaf, M.Wood)
	box(parent, "DoorPanel", F, dx - dw / 2 + 0.35, dx + dw / 2 - 0.35, 2, 4.2, -0.34, -0.29, leaf:Lerp(Color3.new(0, 0, 0), 0.15), M.Wood)
	local fan = box(parent, "Fanlight", F, dx - dw / 2, dx + dw / 2, 6.9, y1, -0.16, -0.08, GLASS, M.Glass)
	fan.Reflectance = 0.2
	box(parent, "Knob", F, dx + dw / 2 - 0.55, dx + dw / 2 - 0.3, 3.9, 4.15, -0.42, -0.29, rgb(214, 180, 90), M.Metal)
	for _, sx in ipairs({ -1, 1 }) do
		box(parent, "DoorCase", F, dx + sx * (dw / 2) + (sx < 0 and -0.45 or 0), dx + sx * (dw / 2) + (sx < 0 and 0 or 0.45), 1.2, y1 + 0.1, -SKIN - 0.25, -SKIN, b.Trim, M.Concrete)
	end
	box(parent, "DoorHood", F, dx - dw / 2 - 0.8, dx + dw / 2 + 0.8, y1 + 0.1, y1 + 0.55, -SKIN - 0.9, -SKIN, b.Trim, M.Concrete)
	-- perron (2 marches) sur le trottoir
	box(parent, "Stoop", F, dx - dw / 2 - 0.5, dx + dw / 2 + 0.5, 0, 0.6, -2.4, -0.62, rgb(206, 200, 194), M.Concrete, true)
	box(parent, "Stoop", F, dx - dw / 2 - 0.5, dx + dw / 2 + 0.5, 0.6, 1.17, -1.5, -0.62, rgb(214, 208, 202), M.Concrete, true)
	-- lanterne éteinte + numéro
	local lx = dx + (dw / 2 + 1.1) * (door == n and -1 or 1)
	box(parent, "LanternArm", F, lx - 0.08, lx + 0.08, 6.6, 6.76, -1.05, -SKIN, IRON, M.Metal)
	box(parent, "Lantern", F, lx - 0.3, lx + 0.3, 5.7, 6.6, -1.2, -0.7, rgb(250, 236, 200), M.Glass)
	-- paillasson
	box(parent, "Doormat", F, dx - 0.9, dx + 0.9, 1.17, 1.21, -1.3, -0.8, rgb(150, 110, 80), M.Fabric)
end

-- Hall vitré (moderne)
local function lobbyFront(b: Building, parent: Instance, F: CFrame)
	local w, G = b.W, b.GroundH
	local hw = w / 2
	local frame = b.Trim
	local deep = 1.5
	box(parent, "LobbyHeader", F, -hw, hw, G - 1.2, G, -deep, 0, b.Wall, M.Concrete)
	box(parent, "LobbyFloor", F, -hw + 1, hw - 1, 0, 1.2, -deep, -0.6, rgb(214, 214, 220), M.Concrete, true)
	for _, sx in ipairs({ -1, 1 }) do
		box(parent, "LobbyPier", F, sx < 0 and -hw or hw - 1, sx < 0 and -hw + 1 or hw, 0, G - 1.2, -deep, 0, b.Wall, M.Concrete)
	end
	box(parent, "LobbyInside", F, -hw + 1, hw - 1, 1.2, G - 1.2, -0.09, -0.03, rgb(206, 204, 200), M.SmoothPlastic)
	local g = box(parent, "LobbyGlass", F, -hw + 1, hw - 1, 1.2, G - 1.2, -deep + 0.1, -deep + 0.18, GLASS_SHOP, M.Glass)
	g.Transparency = 0.45
	g.Reflectance = 0.25
	local nf = math.max(3, math.floor((w - 2) / 3.2))
	for i = 1, nf - 1 do
		local x = -hw + 1 + i * (w - 2) / nf
		box(parent, "LobbyFin", F, x - 0.08, x + 0.08, 1.2, G - 1.2, -deep - 0.12, -deep + 0.1, frame, M.Metal)
	end
	-- plantes dans le hall
	for _, x in ipairs({ -hw + 3, hw - 3 }) do
		box(parent, "Planter", F, x - 0.5, x + 0.5, 1.2, 2.4, -1.15, -0.25, rgb(236, 236, 240), M.SmoothPlastic)
		ball(parent, "Plant", F, x, 3, -0.7, 0.85, rgb(96, 170, 100), M.Grass)
	end
	box(parent, "Canopy", F, -hw + 3, hw - 3, G - 1.6, G - 1.3, -3.4, -deep, frame, M.Metal)
	box(parent, "Step", F, -2, 2, 0, 0.6, -2.5, -deep, rgb(214, 214, 220), M.Concrete, true)
	local plate = box(parent, "HouseNumber", F, hw - 3.2, hw - 1.4, G - 3.3, G - 2.3, -deep - 0.08, -deep, frame, M.Metal)
	signText(plate, tostring(10 + b.Seed % 90), b.Wall, 40, PLAQUE_DISTANCE)
end

----------------------------------------------------------------------
-- Étages (façade sur rue)
----------------------------------------------------------------------

local function upperFloors(b: Building, parent: Instance, F: CFrame, n: number)
	local style = b.Style
	local w = b.W
	local hw = w / 2
	local xs = windowXs(w, n)
	local nf = b.Floors - 1
	for f = 1, nf do
		local yb = b.GroundH + (f - 1) * b.FloorH
		local yt = yb + b.FloorH
		local y0, y1 = yb + 1.6, yb + 6.4
		local seedF = b.Seed * 7 + f
		if style == "Modern" then
			-- mur-rideau : dalle blanche, vitrage toute hauteur, ailettes, garde-corps
			box(parent, "SlabEdge", F, -hw, hw, yb, yb + 0.8, -0.7, 0, b.Trim, M.Concrete)
			local g = box(parent, "CurtainGlass", F, -hw + 0.8, hw - 0.8, yb + 0.8, yt, -0.2, -0.1, GLASS, M.Glass)
			g.Reflectance = 0.28
			for _, sx in ipairs({ -1, 1 }) do
				box(parent, "EndFrame", F, sx < 0 and -hw or hw - 0.8, sx < 0 and -hw + 0.8 or hw, yb + 0.8, yt, -0.7, 0, b.Wall, M.Concrete)
			end
			local fins = math.max(3, math.floor((w - 1.6) / 3.4))
			for i = 1, fins - 1 do
				local x = -hw + 0.8 + i * (w - 1.6) / fins
				box(parent, "Fin", F, x - 0.1, x + 0.1, yb + 0.8, yt, -0.9, -0.2, rgb(176, 184, 196), M.Metal)
			end
			if f % 2 == 1 then
				local rail = box(parent, "GlassRail", F, -hw + 0.8, hw - 0.8, yb + 0.8, yb + 3.2, -1.02, -0.94, rgb(200, 226, 240), M.Glass)
				rail.Transparency = 0.55
				box(parent, "RailTop", F, -hw + 0.8, hw - 0.8, yb + 3.2, yb + 3.36, -1.06, -0.9, rgb(176, 184, 196), M.Metal)
			end
			-- stores intérieurs (quelques-uns à demi baissés)
			for i, x in ipairs(xs) do
				if hash(seedF, i) < 0.5 then
					box(parent, "Blind", F, x - w / n / 2 + 0.3, x + w / n / 2 - 0.3, yt - 2.6 - hash(seedF, i + 5) * 2, yt - 0.1, -0.09, -0.04, rgb(238, 238, 236), M.Fabric)
				end
			end
		elseif style == "Timber" then
			-- colombages : sablières, poteaux, croix, allèges enduites
			local beam = b.Detail
			box(parent, "Sill", F, -hw, hw, yb, yb + 0.55, -0.4, 0, beam, M.Wood)
			box(parent, "Rail", F, -hw, hw, y0 - 0.35, y0, -0.35, 0, beam, M.Wood)
			box(parent, "Rail", F, -hw, hw, y1, y1 + 0.35, -0.35, 0, beam, M.Wood)
			local posts = { -hw + 0.3, hw - 0.3 }
			for _, x in ipairs(xs) do
				table.insert(posts, x - 1.7)
				table.insert(posts, x + 1.7)
			end
			for _, x in ipairs(posts) do
				box(parent, "Post", F, x - 0.3, x + 0.3, yb + 0.55, yt, -0.35, 0, beam, M.Wood)
			end
			for i, x in ipairs(xs) do
				local g = box(parent, "Glass", F, x - 1.4, x + 1.4, y0, y1, -0.12, -0.04, GLASS, M.Glass)
				g.Reflectance = 0.18
				box(parent, "Mullion", F, x - 0.08, x + 0.08, y0, y1, -0.24, -0.16, WHITE, M.Wood)
				box(parent, "Transom", F, x - 1.4, x + 1.4, y0 + 3.1, y0 + 3.26, -0.28, -0.2, WHITE, M.Wood)
				-- croix de Saint-André dans l'allège, entre deux fenêtres
				if i < #xs then
					local mid = (x + xs[i + 1]) / 2
					local span = xs[i + 1] - x - 3.4 - 0.6
					if span > 1.2 then
						local len = math.sqrt(span * span + (y1 - y0) ^ 2)
						local ang = math.atan2(y1 - y0, span)
						local cy = (y0 + y1) / 2
						for _, sgn in ipairs({ -1, 1 }) do
							newPart(parent, "Brace", Vector3.new(len, 0.4, 0.3), F * CFrame.new(mid, cy, -0.17 - (sgn > 0 and 0.03 or 0)) * CFrame.Angles(0, 0, sgn * ang), beam, M.Wood)
						end
					end
				end
				box(parent, "FlowerBox", F, x - 1.4, x + 1.4, y0 - 0.95, y0 - 0.35, -1.2, -0.38, rgb(150, 100, 70), M.WoodPlanks)
				ball(parent, "Blooms", F, x, y0 - 0.2, -0.8, 1, FLOWERS[(i + f) % #FLOWERS + 1], M.Grass)
			end
		else
			local stone = style == "Haussmann"
			local ww = stone and 2.6 or 2.8
			local openings = {}
			for _, x in ipairs(xs) do
				table.insert(openings, { x, ww })
			end
			local skinColor = b.Wall
			local skinMat = style == "Brick" and M.Brick or (stone and M.Limestone or M.Plaster)
			skinFloor(parent, F, w, yb, yt, y0, y1, openings, skinColor, skinMat, true)
			-- bandeau d'étage (pierre / enduit clair)
			if style ~= "Brick" then
				box(parent, "Course", F, -hw - 0.1, hw + 0.1, yb - 0.05, yb + 0.35, -SKIN - 0.25, -SKIN + 0.01, b.Trim, M.Concrete)
			end
			local shutterColor = style == "Pastel" and b.Accent or nil
			local balcony = stone and (f == 1 or (f == nf and nf >= 3))
			for i, x in ipairs(xs) do
				windowTrim(parent, F, x, y0, y1, ww, b.Trim, {
					Sill = not balcony,
					Hood = stone or style == "Brick",
					Mullion = true,
					Transom = style == "Brick",
					Shutters = shutterColor,
					Box = style == "Pastel" and (i + f) % 2 == 0 and not (f == nf and #xs >= 3 and i == math.ceil(#xs / 2)),
					Curtain = true,
					Seed = seedF * 3 + i,
				})
				if stone and not balcony then
					-- balconnet en fer forgé devant la porte-fenêtre
					box(parent, "BalconetSlab", F, x - ww / 2 - 0.3, x + ww / 2 + 0.3, y0 - 0.25, y0, -SKIN - 0.9, -SKIN, b.Trim, M.Limestone)
					local rail = box(parent, "Balconet", F, x - ww / 2 - 0.2, x + ww / 2 + 0.2, y0, y0 + 1.5, -SKIN - 0.85, -SKIN - 0.77, IRON, M.Metal)
					rail.Transparency = 0.3
				end
			end
			if balcony then
				-- grand balcon filant (dalle + garde-corps ajouré + main courante)
				box(parent, "Balcony", F, -hw + 0.4, hw - 0.4, y0 - 0.3, y0, -SKIN - 1.3, -SKIN, b.Trim, M.Limestone)
				local rail = box(parent, "BalconyRail", F, -hw + 0.5, hw - 0.5, y0, y0 + 1.6, -SKIN - 1.22, -SKIN - 1.14, IRON, M.Metal)
				rail.Transparency = 0.35
				box(parent, "HandRail", F, -hw + 0.45, hw - 0.45, y0 + 1.6, y0 + 1.74, -SKIN - 1.28, -SKIN - 1.08, IRON, M.Metal)
			end
			-- petit balcon pastel sous le pignon (dernier étage, fenêtre du milieu)
			if style == "Pastel" and f == nf and #xs >= 3 then
				local x = xs[math.ceil(#xs / 2)]
				box(parent, "Balcony", F, x - 2.4, x + 2.4, y0 - 0.3, y0 - 0.02, -SKIN - 1.3, -SKIN, b.Trim, M.Concrete)
				local rail = box(parent, "BalconyRail", F, x - 2.3, x + 2.3, y0, y0 + 1.4, -SKIN - 1.22, -SKIN - 1.14, WHITE, M.SmoothPlastic)
				rail.Transparency = 0.4
			end
		end
	end
end

----------------------------------------------------------------------
-- Toit (lucarnes, gouttières, œil-de-bœuf, panneaux)
----------------------------------------------------------------------

local function roofExtras(b: Building, parent: Instance, F: CFrame)
	local w, d, h = b.W, b.D, b.Height
	local hw = w / 2
	local style = b.Style
	if style == "Haussmann" then
		-- lucarnes sur le brisis (côté rue)
		local n = math.max(2, math.floor(w / 8))
		local base = h + 0.9
		local md, mh = 2, 5.2
		for i = 1, n do
			local x = -hw + (i - 0.5) * w / n
			-- (boîte posée devant la pente du brisis)
			box(parent, "Dormer", F, x - 1.3, x + 1.3, base + 0.1, base + 3.8, md * 0.25 - 0.5, md + 0.4, b.Wall, M.Limestone)
			local g = box(parent, "DormerGlass", F, x - 0.8, x + 0.8, base + 1, base + 3.2, md * 0.25 - 0.56, md * 0.25 - 0.5 - 0.01, GLASS, M.Glass)
			g.Reflectance = 0.2
			local cap = newPart(parent, "DormerRoof", Vector3.new(3.1, 0.3, 2.9), F * CFrame.new(x, base + 4, md * 0.25 + 0.7) * CFrame.Angles(math.rad(12), 0, 0), rgb(104, 112, 132), M.Metal)
			cap.CastShadow = true
		end
		-- pots des souches de cheminée
		for _, sx in ipairs({ -1, 1 }) do
			for k = -1, 1, 2 do
				rodY(parent, "ChimneyPot", F, sx * (hw - 1.2), base + mh + 3.4, base + mh + 4.3, d * 0.55 + k * 0.8, 0.6, rgb(196, 120, 96), M.Brick)
			end
		end
	elseif style == "Brick" or style == "Timber" then
		-- gouttières (avant, arrière) + descente
		local y = h + 0.9 - 0.25
		rodX(parent, "Gutter", F, -hw - 0.4, hw + 0.4, y, -1.25, 0.4, rgb(90, 92, 104), M.Metal)
		rodX(parent, "Gutter", F, -hw - 0.4, hw + 0.4, y, d + 1.25, 0.4, rgb(90, 92, 104), M.Metal)
		-- lucarne à capucine (côté rue) pour une maison sur deux
		if hash(b.Seed, 41) < 0.6 then
			local roofH = math.min(8, d * 0.42)
			local zc = d * 0.18
			local yc = h + 0.9 + roofH * (zc / (d / 2))
			box(parent, "Dormer", F, -1.5, 1.5, yc - 0.6, yc + 2.4, zc - 0.9, zc + 1.6, b.Wall, style == "Brick" and M.Brick or M.Plaster)
			local g = box(parent, "DormerGlass", F, -0.9, 0.9, yc - 0.2, yc + 1.9, zc - 0.97, zc - 0.91, GLASS, M.Glass)
			g.Reflectance = 0.2
			newPart(parent, "DormerRoof", Vector3.new(3.6, 0.3, 3.2), F * CFrame.new(0, yc + 2.6, zc + 0.3) * CFrame.Angles(math.rad(14), 0, 0), rgb(92, 84, 96), M.Slate)
		end
		rodY(parent, "ChimneyPot", F, hw * 0.6 * (b.Seed % 2 == 0 and 1 or -1), h + 0.9 + math.min(8, d * 0.42) * 0.6 + 3.8, h + 0.9 + math.min(8, d * 0.42) * 0.6 + 4.7, d * 0.66, 0.7, rgb(196, 120, 96), M.Brick)
	elseif style == "Pastel" then
		-- pignon sur rue : œil-de-bœuf + gouttières sur les côtés + épi de faîtage
		local roofH = math.min(9, w * 0.4)
		local cy = h + 0.6 + roofH * 0.4
		local ring = newPart(parent, "Oculus", Vector3.new(0.3, 2.4, 2.4), F * CFrame.new(0, cy, -0.18) * CFrame.Angles(0, math.rad(90), 0), b.Trim, M.SmoothPlastic)
		;(ring :: Part).Shape = Enum.PartType.Cylinder
		local glass = newPart(parent, "OculusGlass", Vector3.new(0.3, 1.7, 1.7), F * CFrame.new(0, cy, -0.24) * CFrame.Angles(0, math.rad(90), 0), GLASS, M.Glass)
		;(glass :: Part).Shape = Enum.PartType.Cylinder
		for _, sx in ipairs({ -1, 1 }) do
			local gutter = newPart(parent, "Gutter", Vector3.new(d + 0.6, 0.4, 0.4), F * CFrame.new(sx * (hw + 0.85), h + 0.35, d / 2) * CFrame.Angles(0, math.rad(90), 0), rgb(236, 236, 240), M.Metal)
			;(gutter :: Part).Shape = Enum.PartType.Cylinder
		end
		rodY(parent, "Finial", F, 0, h + 0.6 + roofH + 0.4, h + 0.6 + roofH + 1.6, -0.2, 0.25, rgb(214, 180, 90), M.Metal)
	else
		-- toit-terrasse : garde-corps, panneaux solaires, antenne
		box(parent, "RoofRail", F, -hw + 0.4, hw - 0.4, h + 1.4, h + 2.4, 0.2, 0.3, rgb(176, 184, 196), M.Metal)
		for i = 0, 1 do
			local x = hw * 0.35 + (i - 0.5) * 3.4
			newPart(parent, "Solar", Vector3.new(3, 0.2, 2), F * CFrame.new(x, h + 2.1, d * 0.4) * CFrame.Angles(math.rad(-25), 0, 0), rgb(40, 52, 90), M.Glass)
		end
		rodY(parent, "Antenna", F, -hw * 0.18, h + 4.4, h + 8.4, d * 0.62, 0.2, rgb(150, 150, 164), M.Metal)
	end
	-- descente d'eau (coin avant droit)
	rodY(parent, "Downpipe", F, hw - 0.35, 1.2, h + 0.6, -0.72, 0.35, rgb(120, 122, 134), M.Metal)
end

----------------------------------------------------------------------
-- Arrière (côté parc) et côtés exposés
----------------------------------------------------------------------

-- Fenêtre "posée" sur une face : encadrement + vitre + appui (repère R :
-- face du mur à z = 0, dehors vers -Z)
local function flatWindow(parent: Instance, R: CFrame, x: number, y0: number, y1: number, ww: number, trim: Color3, seed: number)
	box(parent, "Frame", R, x - ww / 2 - 0.3, x + ww / 2 + 0.3, y0 - 0.3, y1 + 0.3, -0.16, 0, trim, M.SmoothPlastic)
	local g = box(parent, "Glass", R, x - ww / 2, x + ww / 2, y0, y1, -0.22, -0.16, GLASS, M.Glass)
	g.Reflectance = 0.18
	box(parent, "Sill", R, x - ww / 2 - 0.45, x + ww / 2 + 0.45, y0 - 0.62, y0 - 0.3, -0.62, -0.03, trim, M.Concrete)
	if hash(seed, 3) < 0.4 then
		box(parent, "Blind", R, x - ww / 2 + 0.05, x + ww / 2 - 0.05, y1 - (y1 - y0) * 0.45, y1, -0.28, -0.23, rgb(240, 230, 214), M.Fabric)
	end
end

local function backSide(b: Building, parent: Instance)
	local w, d = b.W, b.D
	local hw = w / 2
	-- repère de la face arrière : origine au pied du mur arrière, -Z vers le parc
	local R = b.CF * CFrame.new(0, 0, d) * CFrame.Angles(0, math.pi, 0)
	local trim = b.Style == "Brick" and b.Trim or b.Trim:Lerp(b.Wall, 0.25)
	local nf = b.Floors - 1
	local xs = { -w * 0.25, w * 0.25 }
	for f = 1, nf do
		local yb = b.GroundH + (f - 1) * b.FloorH
		for i, x in ipairs(xs) do
			flatWindow(parent, R, x, yb + 1.8, yb + 6, 2.6, trim, b.Seed * 5 + f * 3 + i)
		end
		-- petit balcon arrière (un étage sur deux, une maison sur deux)
		if f == 1 and hash(b.Seed, 51) < 0.5 then
			local x = xs[2]
			box(parent, "BackBalcony", R, x - 2.4, x + 2.4, yb + 1.1, yb + 1.4, -1.8, -0.62, trim, M.Concrete)
			local rail = box(parent, "BackRail", R, x - 2.3, x + 2.3, yb + 1.4, yb + 2.9, -1.74, -1.66, IRON, M.Metal)
			rail.Transparency = 0.35
		end
	end
	-- porte de service + perron + applique éteinte
	local dx = -w * 0.25
	box(parent, "BackDoorFrame", R, dx - 1.7, dx + 1.7, 1.2, 8.3, -0.16, 0, trim, M.SmoothPlastic)
	box(parent, "BackDoor", R, dx - 1.3, dx + 1.3, 1.2, 7.9, -0.3, -0.16, b.Accent:Lerp(WHITE, 0.15), M.Wood)
	box(parent, "BackStep", R, dx - 1.8, dx + 1.8, -0.6, 1.17, -1.9, -0.62, rgb(206, 200, 194), M.Concrete, true)
	box(parent, "BackLamp", R, dx + 2, dx + 2.5, 6.6, 7.4, -0.5, -0.03, rgb(250, 236, 200), M.Glass)
	flatWindow(parent, R, w * 0.25, 3.6, 7.4, 3.2, trim, b.Seed + 77)
	-- jardinet : bac de fleurs + buissons le long du mur (dans l'emprise du socle)
	box(parent, "Planter", R, w * 0.25 - 2.4, w * 0.25 + 2.4, -0.6, 1.9, -0.9, -0.1, rgb(176, 124, 84), M.WoodPlanks)
	for k = -1, 1 do
		ball(parent, "Shrub", R, w * 0.25 + k * 1.5, 2.2, -0.5, 1.3, k == 0 and FLOWERS[(b.Seed % #FLOWERS) + 1] or rgb(104, 172, 96), M.Grass)
	end
	-- climatiseur + descente d'eau
	box(parent, "AirCon", R, hw - 2.6, hw - 0.8, b.GroundH + 1, b.GroundH + 2.4, -1.2, -0.03, rgb(226, 228, 232), M.Metal)
	rodY(parent, "Downpipe", R, -hw + 0.4, 1.2, b.Height + 0.6, -0.3, 0.35, rgb(120, 122, 134), M.Metal)
end

-- Côté exposé (sx = -1 : gauche, +1 : droite vus de la rue) ; `above` > 0 :
-- seuls les étages au-dessus de cette hauteur sont visibles (voisin plus bas)
local function exposedSide(b: Building, parent: Instance, sx: number, above: number)
	local w, d = b.W, b.D
	-- repère de la face latérale : origine au pied du mur, milieu en profondeur
	local R = b.CF * CFrame.new(sx * w / 2, 0, d / 2) * CFrame.Angles(0, sx * -math.pi / 2, 0)
	local trim = b.Trim:Lerp(b.Wall, 0.2)
	local nf = b.Floors - 1
	for f = 1, nf do
		local yb = b.GroundH + (f - 1) * b.FloorH
		if yb + 1.5 >= above then
			local xs = d >= 18 and { -d * 0.22, d * 0.22 } or { 0 }
			for i, x in ipairs(xs) do
				flatWindow(parent, R, x, yb + 2, yb + 6, 2.2, trim, b.Seed * 11 + f * 2 + i)
			end
		end
	end
	-- œil-de-bœuf dans le pignon (toits à deux pans parallèles à la rue)
	if (b.Style == "Brick" or b.Style == "Timber") and above < b.Height + 1 then
		local roofH = math.min(8, d * 0.42)
		local cy = b.Height + 0.9 + roofH * 0.38
		local ring = newPart(parent, "Oculus", Vector3.new(0.3, 2, 2), R * CFrame.new(0, cy, -0.18) * CFrame.Angles(0, math.rad(90), 0), b.Trim, M.SmoothPlastic)
		;(ring :: Part).Shape = Enum.PartType.Cylinder
		local glass = newPart(parent, "OculusGlass", Vector3.new(0.3, 1.4, 1.4), R * CFrame.new(0, cy, -0.24) * CFrame.Angles(0, math.rad(90), 0), GLASS, M.Glass)
		;(glass :: Part).Shape = Enum.PartType.Cylinder
	end
	if above > 0 then
		return
	end
	-- rez-de-chaussée : réclame peinte (une maison sur deux) ou fenêtre
	if hash(b.Seed + sx, 61) < 0.55 then
		local mural = box(parent, "Mural", R, -d * 0.36, d * 0.36, 2.2, b.GroundH - 1.2, -0.08, -0.03, b.Accent:Lerp(WHITE, 0.2), M.SmoothPlastic)
		signText(mural, Locale.T(MURALS[math.floor(hash(b.Seed, 63) * #MURALS) + 1]), WHITE, 18, SIGN_DISTANCE)
	else
		flatWindow(parent, R, 0, 3.6, 7.4, 3, trim, b.Seed + 91)
	end
end

----------------------------------------------------------------------
-- Mairie (arrière + côtés) et boutiques de décor de la place (arrière,
-- côtés, pancarte "Fermé") : leur façade est construite par le serveur
----------------------------------------------------------------------

local function hallExtras(b: Building, parent: Instance)
	local w, d = b.W, b.D
	local trim = b.Trim
	-- arrière : 2 rangées de hautes fenêtres + porte à deux battants
	local R = b.CF * CFrame.new(0, 0, d) * CFrame.Angles(0, math.pi, 0)
	local n = 8
	for f = 0, 1 do
		local y0 = 3.8 + f * 14
		for i = 1, n do
			local x = -w / 2 + (i - 0.5) * w / n
			if not (f == 0 and (i == n / 2 or i == n / 2 + 1)) then
				flatWindow(parent, R, x, y0, y0 + 6.4, 3.2, trim, b.Seed * 13 + f * 9 + i)
			end
		end
		box(parent, "Course", R, -w / 2, w / 2, y0 + 7.4, y0 + 8, -0.4, 0, trim, M.Marble)
	end
	-- (le socle de la mairie monte à 1,55 et déborde de 0,4 : porte au-dessus)
	box(parent, "BackPortal", R, -3.6, 3.6, 1.55, 10.6, -0.55, 0, trim, M.Marble)
	for _, sx in ipairs({ -1, 1 }) do
		box(parent, "BackDoor", R, sx < 0 and -3 or 0.05, sx < 0 and -0.05 or 3, 1.6, 9.6, -0.7, -0.55, rgb(120, 80, 70), M.Wood)
		box(parent, "DoorKnob", R, sx * 0.45 - 0.12, sx * 0.45 + 0.12, 5.2, 5.5, -0.83, -0.7, rgb(214, 180, 90), M.Metal)
	end
	box(parent, "BackSteps", R, -4.4, 4.4, -0.6, 0.8, -2.6, -0.41, rgb(214, 208, 202), M.Marble, true)
	box(parent, "BackSteps", R, -4.4, 4.4, 0.8, 1.52, -1.5, -0.41, rgb(222, 216, 210), M.Marble, true)
	for _, sx in ipairs({ -1, 1 }) do
		box(parent, "Planter", R, sx * 8 - 1.6, sx * 8 + 1.6, -0.6, 1.4, -1.8, -0.2, trim, M.Marble)
		ball(parent, "Shrub", R, sx * 8, 2.1, -1, 2, rgb(96, 164, 96), M.Grass)
	end
	-- côtés : 2 rangées de 2 fenêtres
	for _, sx in ipairs({ -1, 1 }) do
		local S = b.CF * CFrame.new(sx * w / 2, 0, d / 2) * CFrame.Angles(0, sx * -math.pi / 2, 0)
		for f = 0, 1 do
			for _, x in ipairs({ -d * 0.25, d * 0.25 }) do
				flatWindow(parent, S, x, 3.8 + f * 14, 10.2 + f * 14, 3.2, trim, b.Seed + f * 3 + math.floor(x))
			end
		end
	end
end

local function decorShopExtras(b: Building, parent: Instance)
	backSide(b, parent)
	for _, sx in ipairs({ -1, 1 }) do
		local exposed = (sx < 0 and b.Left) or (sx > 0 and b.Right)
		if exposed then
			local R = b.CF * CFrame.new(sx * b.W / 2, 0, b.D / 2) * CFrame.Angles(0, sx * -math.pi / 2, 0)
			for f = 1, b.Floors - 1 do
				local yb = b.GroundH + (f - 1) * b.FloorH
				flatWindow(parent, R, 0, yb + 2, yb + 6, 2.2, b.Trim, b.Seed * 3 + f + sx)
			end
		end
	end
	-- pancarte "Fermé" sur la porte vitrée (porte au milieu de la devanture)
	local plaque = box(parent, "ClosedSign", b.CF, -0.8, 0.8, 5, 5.8, -0.73, -0.67, WHITE, M.SmoothPlastic)
	signText(plaque, Locale.T("Closed for now 😴"), rgb(200, 70, 100), 60, PLAQUE_DISTANCE, Enum.Font.GothamBold)
end

----------------------------------------------------------------------
-- Un immeuble : travaux découpés (façade, étages, arrière, côtés, toit)
----------------------------------------------------------------------

local function jobsFor(b: Building, parent: Model): { () -> () }
	local jobs: { () -> () } = {}
	local F = b.CF
	if b.Style == "Hall" then
		table.insert(jobs, function()
			hallExtras(b, parent)
		end)
		return jobs
	elseif b.Style == "DecorShop" then
		table.insert(jobs, function()
			decorShopExtras(b, parent)
		end)
		return jobs
	end
	local n = math.clamp(math.floor((b.W - 2) / 6.5), 2, 4)
	table.insert(jobs, function()
		local style = b.Style
		local r = hash(b.Seed, 91)
		if style == "Modern" and r < 0.5 then
			lobbyFront(b, parent, F)
		elseif r < 0.68 then
			shopFront(b, parent, F)
		else
			local mat = style == "Brick" and M.Brick or (style == "Haussmann" and M.Limestone or (style == "Modern" and M.Concrete or M.Plaster))
			homeFront(b, parent, F, b.Wall, mat, n)
		end
	end)
	table.insert(jobs, function()
		upperFloors(b, parent, F, n)
	end)
	table.insert(jobs, function()
		backSide(b, parent)
	end)
	table.insert(jobs, function()
		if b.Left or b.LeftAbove < b.Height - 2 then
			exposedSide(b, parent, -1, b.Left and 0 or b.LeftAbove)
		end
		if b.Right or b.RightAbove < b.Height - 2 then
			exposedSide(b, parent, 1, b.Right and 0 or b.RightAbove)
		end
		roofExtras(b, parent, F)
	end)
	return jobs
end

local function setFar(b: Building, hidden: boolean)
	for _, p in ipairs(b.Far) do
		if p.Parent then
			p.LocalTransparencyModifier = hidden and 1 or 0
		end
	end
end

local function destroyDetail(b: Building)
	if b.Detail_ then
		b.Detail_:Destroy()
		b.Detail_ = nil
		stats.Destroyed += 1
	end
	b.Jobs = nil
	b.Built = false
	setFar(b, false)
end

----------------------------------------------------------------------
-- Boucle
----------------------------------------------------------------------

local function localPosition(): Vector3?
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root.Position
	end
	return focus
end

local function flat(a: Vector3, b: Vector3): number
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

local function decide(position: Vector3)
	local k = detailScale()
	for _, b in ipairs(buildings) do
		local dist = flat(position, b.Center)
		if (b.Built or b.Jobs) and dist > DROP_RANGE * k then
			destroyDetail(b)
		end
	end
	-- un chantier à la fois : l'immeuble le plus proche qui en a besoin
	for _, b in ipairs(buildings) do
		if b.Jobs then
			return
		end
	end
	local best: Building? = nil
	local bestD = math.huge
	for _, b in ipairs(buildings) do
		local dist = flat(position, b.Center)
		if not b.Built and dist <= BUILD_RANGE * k and dist < bestD then
			best, bestD = b, dist
		end
	end
	if best and folder then
		local model = Instance.new("Model")
		model.Name = "Facade_" .. best.Style
		model.Parent = folder
		best.Detail_ = model
		best.Jobs = jobsFor(best, model)
		best.JobIndex = 1
		best.Parts = count
	end
end

local function runJobs()
	local t0 = os.clock()
	for _, b in ipairs(buildings) do
		local jobs = b.Jobs
		if jobs then
			repeat
				local job = jobs[b.JobIndex]
				if job then
					local ok, err = pcall(job)
					if not ok then
						warn("[TownFacades] " .. b.Style .. " : " .. tostring(err))
					end
				end
				b.JobIndex += 1
			until b.JobIndex > #jobs or os.clock() - t0 > STEP_BUDGET
			if b.JobIndex > #jobs then
				b.Jobs = nil
				b.Built = true
				b.Parts = count - b.Parts
				stats.Built += 1
				stats.Parts = count
				setFar(b, true)
			end
			return
		end
	end
end

local function heartbeat(dt: number)
	if not started then
		return
	end
	runJobs()
	clock += dt
	if clock < STEP_EVERY then
		return
	end
	clock = 0
	local position = localPosition()
	if position then
		decide(position)
	end
end

function TownFacades.Step(position: Vector3?)
	if typeof(position) == "Vector3" then
		focus = position
	end
end

----------------------------------------------------------------------
-- Démarrer / arrêter
----------------------------------------------------------------------

local function discover(): { Building }
	local list: { Building } = {}
	local town = workspace:FindFirstChild("DopamineTown")
	if not town then
		return list
	end
	for _, model in ipairs(town:GetDescendants()) do
		if model:IsA("Model") then
			local style = model:GetAttribute("FacadeStyle")
			local cf = model:GetAttribute("FacadeCF")
			local w, d = model:GetAttribute("W"), model:GetAttribute("D")
			if type(style) == "string" and typeof(cf) == "CFrame" and type(w) == "number" and type(d) == "number" then
				local function color(key: string, default: Color3): Color3
					local v = model:GetAttribute(key)
					return typeof(v) == "Color3" and v or default
				end
				local function num(key: string, default: number): number
					local v = model:GetAttribute(key)
					return type(v) == "number" and v or default
				end
				local far = {}
				for _, p in ipairs(model:GetChildren()) do
					if p:IsA("BasePart") and p:GetAttribute("FarLOD") == true then
						table.insert(far, p)
					end
				end
				table.insert(list, {
					Model = model,
					Style = style,
					CF = cf,
					W = w,
					D = d,
					Floors = math.max(1, math.floor(num("Floors", 2))),
					Height = num("Height", 18.5),
					Seed = math.floor(num("Seed", 1)),
					GroundH = num("GroundH", 10),
					FloorH = num("FloorH", 8.5),
					Wall = color("Wall", rgb(240, 232, 222)),
					Trim = color("Trim", WHITE),
					Accent = color("Accent", rgb(48, 62, 104)),
					Detail = color("Detail", rgb(60, 60, 70)),
					Left = true,
					Right = true,
					LeftAbove = 0,
					RightAbove = 0,
					Center = (cf * CFrame.new(0, 0, d / 2)).Position,
					Far = far,
					Detail_ = nil,
					Jobs = nil,
					JobIndex = 1,
					Built = false,
					Parts = 0,
				})
			end
		end
	end
	-- côtés exposés : pas de voisin aligné tout contre
	for _, b in ipairs(list) do
		for _, o in ipairs(list) do
			if o ~= b and b.CF.LookVector:Dot(o.CF.LookVector) > 0.98 then
				local rel = b.CF:PointToObjectSpace(o.CF.Position)
				local gap = math.abs(rel.X) - (b.W + o.W) / 2
				if math.abs(rel.Z) < 4 and gap < 6 then
					-- voisin collé : ce côté n'est à nu qu'au-dessus de lui
					local above = o.Height + 1
					if rel.X < 0 then
						b.Left = false
						b.LeftAbove = math.max(b.LeftAbove, above)
					else
						b.Right = false
						b.RightAbove = math.max(b.RightAbove, above)
					end
				end
			end
		end
	end
	return list
end

function TownFacades.Start()
	if started then
		return
	end
	started = true
	local old = workspace:FindFirstChild(FOLDER_NAME)
	if old then
		old:Destroy()
	end
	local f = Instance.new("Folder")
	f.Name = FOLDER_NAME
	f.Parent = workspace
	folder = f
	buildings = discover()
	clock = STEP_EVERY
	table.insert(conns, RunService.Heartbeat:Connect(heartbeat))
end

function TownFacades.Stop()
	if not started then
		return
	end
	started = false
	for _, c in ipairs(conns) do
		c:Disconnect()
	end
	table.clear(conns)
	for _, b in ipairs(buildings) do
		destroyDetail(b)
	end
	table.clear(buildings)
	if folder then
		folder:Destroy()
		folder = nil
	end
	focus = nil
end

function TownFacades.Debug(): any
	return {
		Buildings = buildings,
		Stats = stats,
		Folder = folder,
		Decide = decide,
		RunAll = function()
			for _ = 1, 400 do
				local pending = false
				for _, b in ipairs(buildings) do
					if b.Jobs then
						pending = true
					end
				end
				if not pending then
					break
				end
				runJobs()
			end
		end,
		-- tout construire (rendus : vue d'ensemble)
		BuildAll = function()
			for _ = 1, #buildings do
				local target: Building? = nil
				for _, b in ipairs(buildings) do
					if not b.Built and not b.Jobs then
						target = b
						break
					end
				end
				if not target or not folder then
					break
				end
				local model = Instance.new("Model")
				model.Name = "Facade_" .. target.Style
				model.Parent = folder
				target.Detail_ = model
				target.Jobs = jobsFor(target, model)
				target.JobIndex = 1
				target.Parts = count
				for _ = 1, 50 do
					if not target.Jobs then
						break
					end
					runJobs()
				end
			end
		end,
	}
end

return TownFacades
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="234">
          <Properties>
            <string name="Name">TownFountainFx</string>
            <string name="Source"><![CDATA[--[[
	TownFountainFx (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > TownFountainFx

	⛲ La fontaine de la place, "en mieux" (v9.8, CITY98), côté CLIENT
	(appelé par TownPlazaFx, près de la place seulement). Le serveur
	(TownPlaza) garde la fontaine elle-même (bassin, vasques, cerveau,
	particules) et publie son repère (attribut "FxFountainBase" du dossier
	Plaza). Ici :
	  - EAU VIVANTE : voile scintillant sur le bassin et les vasques
	    (transparence qui respire), ronds dans l'eau qui s'élargissent là où
	    tombent les jets ;
	  - 8 JETS EN ARC (gouttes qui filent le long d'une parabole, de la
	    bouche des poissons de bronze jusqu'au bassin) + le jet du cerveau
	    (gerbe qui monte et retombe dans la vasque haute) ;
	  - RIDEAUX D'EAU qui tombent des deux vasques (filets qui descendent) ;
	  - DÉTAILS SCULPTÉS : 12 médaillons au cerveau sur la margelle,
	    cannelures du pied, feuilles d'acanthe, têtes de poisson en bronze
	    aux buses ;
	  - des PIÈCES au fond du bassin (vœux !).
	~240 pièces, ancrées, sans collision ; animation par CFrame / propriétés
	(30 Hz au plus, rien de créé par image). Aucune lumière, aucun son.

	API (TownPlazaFx) :
	  TownFountainFx.Build(folder, base: Vector3) -> état
	  TownFountainFx.Step(état, t: number)
]]

local TownFountainFx = {}

local M = Enum.Material
local rgb = Color3.fromRGB
local UPRIGHT = CFrame.Angles(0, 0, math.rad(90))

-- Hauteurs de la fontaine serveur (au-dessus du parvis `base`, voir TownPlaza)
local BASIN_R = 13.6
local WATER_Y = 2.5
local FLOOR_Y = 0.8
local BOWL_R, BOWL_Y, BOWL_WATER_Y = 6.2, 7.0, 7.1
local UPPER_R, UPPER_WATER_Y = 3.3, 11.0
local JET_R, JET_Y = 12.3, 2.62
local NOZZLE_Y = 12.05 + 2.625 + 2.1

local WATER = rgb(170, 222, 250)
local FOAM = rgb(236, 248, 255)
local BRONZE = rgb(196, 150, 92)
local MARBLE = rgb(250, 244, 240)
local ROSE = rgb(232, 178, 188)

local JETS = 8
local DROPS = 11
local CURTAIN_LOW, CURTAIN_HIGH = 22, 12

local function newPart(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: string?): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or M.SmoothPlastic
	if shape == "Ball" then
		p.Shape = Enum.PartType.Ball
	elseif shape == "Cyl" then
		p.Shape = Enum.PartType.Cylinder
	elseif shape == "Egg" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	p.Parent = parent
	return p
end

-- disque horizontal : dessus à `top`
local function disc(parent: Instance, name: string, center: Vector3, top: number, radius: number, t: number, color: Color3, material: Enum.Material?): BasePart
	return newPart(parent, name, Vector3.new(t, radius * 2, radius * 2), CFrame.new(center.X, top - t / 2, center.Z) * UPRIGHT, color, material, "Cyl")
end

local function hash(a: number, b: number): number
	local x = math.sin(a * 12.9898 + b * 78.233) * 43758.5453
	return x - math.floor(x)
end

-- point d'une parabole de `a` à `b` (sommet à +h au-dessus du segment)
local function arc(a: Vector3, b: Vector3, h: number, u: number): Vector3
	return a:Lerp(b, u) + Vector3.new(0, 4 * h * u * (1 - u), 0)
end

function TownFountainFx.Build(folder: Instance, base: Vector3): any
	local model = Instance.new("Model")
	model.Name = "FountainFx"
	model.Parent = folder
	local F = { Base = base, Model = model, Movers = {}, MoverFrames = {}, Jets = {}, Ripples = {}, Veils = {}, Curtains = {} }
	local function y(h: number): Vector3
		return base + Vector3.new(0, h, 0)
	end
	-- voiles scintillants (au-dessus de l'eau du serveur et de ses ronds)
	local veil = disc(model, "WaterVeil", base, base.Y + WATER_Y + 0.11, BASIN_R - 0.75, 0.04, FOAM, M.Glass)
	veil.Transparency = 0.78
	local veil2 = disc(model, "BowlVeil", base, base.Y + BOWL_WATER_Y + 0.07, BOWL_R - 0.6, 0.03, FOAM, M.Glass)
	veil2.Transparency = 0.78
	local veil3 = disc(model, "UpperVeil", base, base.Y + UPPER_WATER_Y + 0.07, UPPER_R - 0.5, 0.03, FOAM, M.Glass)
	veil3.Transparency = 0.78
	F.Veils = { veil, veil2, veil3 }
	-- pièces au fond du bassin (vœux)
	local coins = { rgb(236, 196, 90), rgb(214, 140, 80), rgb(200, 204, 212) }
	for i = 1, 36 do
		local a = hash(i, 1) * math.pi * 2
		local r = 3.2 + math.sqrt(hash(i, 2)) * 9.2
		local p = base + Vector3.new(math.sin(a) * r, 0, math.cos(a) * r)
		-- (hauteur par couleur : deux pièces qui se chevauchent ne scintillent jamais)
		local lift = (i % 3) * 0.025
		disc(model, "Coin", p, base.Y + FLOOR_Y + 0.03 + lift, 0.16 + hash(i, 3) * 0.05, 0.06 + lift, coins[i % 3 + 1], M.Metal)
	end
	-- médaillons sur la margelle (face extérieure des 12 pans) + petit cerveau en relief
	for i = 0, 11 do
		local a = (i + 0.5) / 12 * math.pi * 2
		local d = Vector3.new(math.sin(a), 0, math.cos(a))
		local p = y(1.65) + d * (BASIN_R + 0.7)
		newPart(model, "Medallion", Vector3.new(0.16, 1.3, 1.3), CFrame.lookAt(p, p + d) * CFrame.Angles(0, math.rad(90), 0), ROSE, M.Marble, "Cyl")
		for _, sx in ipairs({ -1, 1 }) do
			local side = Vector3.new(0, 1, 0):Cross(d).Unit
			newPart(model, "MedallionBrain", Vector3.new(0.34, 0.34, 0.34), CFrame.new(p + d * 0.1 + side * sx * 0.16 + Vector3.new(0, 0.05, 0)), rgb(255, 152, 198), M.SmoothPlastic, "Ball")
		end
	end
	-- cannelures du pied + feuilles d'acanthe sous l'anneau rose
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2
		local d = Vector3.new(math.sin(a), 0, math.cos(a))
		local p = y(3.65) + d * 1.72
		newPart(model, "Flute", Vector3.new(0.22, 3.7, 0.22), CFrame.lookAt(p, p + d), MARBLE:Lerp(ROSE, 0.15), M.Marble)
	end
	for i = 0, 7 do
		local a = (i + 0.5) / 8 * math.pi * 2
		local d = Vector3.new(math.sin(a), 0, math.cos(a))
		local p = y(5.35) + d * 2.05
		newPart(model, "Acanthus", Vector3.new(0.9, 1.3, 0.3), CFrame.lookAt(p, p + d) * CFrame.Angles(math.rad(-18), 0, 0), rgb(236, 226, 214), M.Marble, "Egg")
	end
	-- têtes de poisson en bronze aux 8 buses + jets en arc (gouttes)
	for j = 0, JETS - 1 do
		local a = j / JETS * math.pi * 2
		local d = Vector3.new(math.sin(a), 0, math.cos(a))
		local mouth = y(JET_Y + 0.2) + d * (JET_R - 0.35)
		local head = CFrame.lookAt(mouth + d * 0.45, mouth)
		newPart(model, "FishHead", Vector3.new(0.75, 0.62, 1.0), head * CFrame.Angles(math.rad(-20), 0, 0), BRONZE, M.Metal, "Egg")
		for _, sx in ipairs({ -1, 1 }) do
			newPart(model, "FishEye", Vector3.new(0.14, 0.14, 0.14), head * CFrame.new(sx * 0.3, 0.14, -0.15), rgb(60, 44, 30), M.Metal, "Ball")
		end
		newPart(model, "FishFin", Vector3.new(0.08, 0.5, 0.5), head * CFrame.new(0, 0.36, 0.2) * CFrame.Angles(math.rad(45), 0, 0), BRONZE, M.Metal)
		local landing = y(WATER_Y + 0.05) + d * (JET_R - 5.2)
		local jet = { From = mouth - d * 0.25, To = landing, H = 2.4, Parts = {}, Phase = j * 0.13 }
		for _ = 1, DROPS do
			local drop = newPart(model, "JetDrop", Vector3.new(0.34, 0.34, 0.34), CFrame.new(mouth), WATER, M.Glass, "Ball")
			drop.Transparency = 0.3
			table.insert(jet.Parts, drop)
			table.insert(F.Movers, drop)
			table.insert(F.MoverFrames, drop.CFrame)
		end
		table.insert(F.Jets, jet)
		-- 2 ronds par point de chute (déphasés)
		for k = 0, 1 do
			-- (2e rond 0,03 plus haut : jamais deux faces confondues)
			local top = base.Y + WATER_Y + 0.17 + k * 0.03
			local ring = disc(model, "Ripple", landing, top, 0.4, 0.03, FOAM, M.Glass)
			ring.Transparency = 0.5
			table.insert(F.Ripples, { Part = ring, Center = landing, Top = top, Phase = j * 0.37 + k * 0.6 })
		end
	end
	-- gerbe du cerveau : monte puis retombe dans la vasque haute
	local top = { Parts = {}, From = y(NOZZLE_Y), Phase = 0 }
	for _ = 1, 12 do
		local drop = newPart(model, "TopDrop", Vector3.new(0.3, 0.3, 0.3), CFrame.new(top.From), WATER, M.Glass, "Ball")
		drop.Transparency = 0.35
		table.insert(top.Parts, drop)
		table.insert(F.Movers, drop)
		table.insert(F.MoverFrames, drop.CFrame)
	end
	F.Top = top
	-- rideaux d'eau : filets qui tombent du bord des vasques
	local function curtain(n: number, r: number, y0: number, y1: number, name: string)
		for k = 0, n - 1 do
			local a = (k + 0.5) / n * math.pi * 2
			local d = Vector3.new(math.sin(a), 0, math.cos(a))
			local streak = newPart(model, name, Vector3.new(0.16, 1.5, 0.16), CFrame.new(base + d * r + Vector3.new(0, y0, 0)), WATER, M.Glass)
			streak.Transparency = 0.45
			table.insert(F.Curtains, { Part = streak, Dir = d, R = r, Y0 = y0, Y1 = y1, Phase = hash(k, n) })
			table.insert(F.Movers, streak)
			table.insert(F.MoverFrames, streak.CFrame)
		end
	end
	curtain(CURTAIN_LOW, BOWL_R + 0.25, BOWL_Y - 0.1, WATER_Y + 0.4, "CurtainLow")
	curtain(CURTAIN_HIGH, UPPER_R + 0.2, UPPER_WATER_Y - 0.2, BOWL_WATER_Y + 0.3, "CurtainHigh")
	return F
end

function TownFountainFx.Step(F: any, t: number)
	if not F then
		return
	end
	local frames = F.MoverFrames
	local i = 0
	-- jets en arc : gouttes qui glissent le long de la parabole
	for _, jet in ipairs(F.Jets) do
		for k, _ in ipairs(jet.Parts) do
			i += 1
			local u = ((k - 1) / DROPS + t * 0.85 + jet.Phase) % 1
			frames[i] = CFrame.new(arc(jet.From, jet.To, jet.H, u))
		end
	end
	-- gerbe du cerveau : montée (vitesse qui baisse) puis chute dans la vasque
	local top = F.Top
	for k, _ in ipairs(top.Parts) do
		i += 1
		local u = ((k - 1) / #top.Parts + t * 0.7) % 1
		local ang = k * 2.39996
		local spread = 3.0 * math.sqrt(u)
		local h = 3.0 * math.sin(u * math.pi) - u * u * (NOZZLE_Y - UPPER_WATER_Y)
		frames[i] = CFrame.new(top.From + Vector3.new(math.cos(ang) * spread, h, math.sin(ang) * spread))
	end
	-- rideaux : chaque filet descend et recommence
	for _, c in ipairs(F.Curtains) do
		i += 1
		local u = (t * 0.9 + c.Phase) % 1
		local yy = c.Y0 + (c.Y1 - c.Y0) * (u * u * 0.6 + u * 0.4)
		frames[i] = CFrame.new(F.Base + c.Dir * (c.R + u * 0.25) + Vector3.new(0, yy, 0))
	end
	workspace:BulkMoveTo(F.Movers, frames, Enum.BulkMoveMode.FireCFrameChanged)
	-- ronds dans l'eau : s'élargissent et s'effacent
	for _, r in ipairs(F.Ripples) do
		local u = (t * 0.8 + r.Phase) % 1
		local size = 0.6 + u * 3.4
		r.Part.Size = Vector3.new(0.03, size, size)
		r.Part.Transparency = 0.45 + u * 0.55
	end
	-- voiles : la lumière "respire" sur l'eau
	for k, v in ipairs(F.Veils) do
		v.Transparency = 0.74 + math.sin(t * 1.3 + k) * 0.06
	end
end

return TownFountainFx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="235">
          <Properties>
            <string name="Name">TownGraphics</string>
            <string name="Source"><![CDATA[--[[
	TownGraphics (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > TownGraphics

	v9.8 (REALISM98) 🎨 fenêtre "Graphismes / Mode réaliste" ouverte EN
	VILLE (bouton ⚙️ du HUD de la ville) : les fenêtres du clicker sont
	masquées dans Dopamine Town, celle-ci a sa propre ScreenGui
	"TownGraphicsGui" (à garder visible : KEEP_GUIS de TownClient).
	Mêmes réglages que ⚙️ Paramètres > Graphismes (Components/GraphicsControls),
	appliqués tout de suite (météo, miroirs, effets, ombres, détail).
	Fermer : ✕, clic en dehors, Échap / bouton B, ou en sortant de la ville.

	API : TownGraphics.Open() / Close() / Toggle() / IsOpen()
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Client = script.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local Locale = require(game:GetService("ReplicatedStorage").Shared.Locale)

local TownGraphics = {}

local GUI_NAME = "TownGraphicsGui"
local ACCENT = Theme.Colors.Cyan:Lerp(Theme.Colors.Blue, 0.35)
local WHITE = Color3.new(1, 1, 1)

local gui: ScreenGui? = nil
local card: Frame? = nil
local controls: any = nil
local toastLabel: TextLabel? = nil
local inputConn: RBXScriptConnection? = nil

local function toast(text: string, color: Color3?)
	local label = toastLabel
	if not label then
		return
	end
	label.Text = text
	label.TextColor3 = color or Theme.Colors.Text
	label.Visible = true
	task.delay(3, function()
		if toastLabel == label and label.Text == text then
			label.Visible = false
		end
	end)
end

local function build(): ScreenGui
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local screen = UIUtil.Create("ScreenGui", {
		Name = GUI_NAME,
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 60,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Enabled = false,
		Parent = playerGui,
	})
	-- voile : un clic en dehors ferme
	local shade = UIUtil.Create("TextButton", {
		Name = "Shade",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.55,
		AutoButtonColor = false,
		Text = "",
		Parent = screen,
	})
	shade.Activated:Connect(function()
		TownGraphics.Close()
	end)
	local box = UIUtil.Create("Frame", {
		Name = "Card",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0.94, 0, 0.88, 0),
		BackgroundColor3 = WHITE,
		ZIndex = 2,
		Parent = screen,
	})
	UIUtil.Create("UISizeConstraint", { MaxSize = Vector2.new(620, 640), Parent = box })
	UIUtil.Corner(box, Theme.Radius.L)
	UIUtil.Stroke(box, ACCENT:Lerp(Color3.new(0, 0, 0), 0.2), 2, 0.2)
	UIUtil.Shadow(box, 4, 0.75)
	UIUtil.SinkClicks(box)
	UIUtil.Create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, ACCENT:Lerp(WHITE, 0.86)),
			ColorSequenceKeypoint.new(0.18, WHITE),
			ColorSequenceKeypoint.new(1, WHITE),
		}),
		Parent = box,
	})
	-- en-tête
	UIUtil.Label({
		Name = "Title",
		Text = Locale.T("🎨 Graphics / Realistic mode"),
		Font = Theme.Fonts.Title,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -80, 0, 28),
		Position = UDim2.fromOffset(18, 14),
		MaxTextSize = 24,
		ZIndex = 3,
		Parent = box,
	})
	UIUtil.Label({
		Name = "Subtitle",
		Text = Locale.T("Mirrors, weather, reflections and detail"),
		TextColor3 = Theme.Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -80, 0, 18),
		Position = UDim2.fromOffset(18, 44),
		MaxTextSize = 15,
		ZIndex = 3,
		Parent = box,
	})
	local close = UIUtil.CloseButton({
		Name = "CloseGraphics",
		Size = 40,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 12),
		ZIndex = 4,
	})
	close.Parent = box
	close.Activated:Connect(function()
		TownGraphics.Close()
	end)
	local scroll = UIUtil.Create("ScrollingFrame", {
		Name = "Scroll",
		Position = UDim2.fromOffset(10, 72),
		Size = UDim2.new(1, -20, 1, -84),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = ACCENT,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ZIndex = 3,
		Parent = box,
	})
	local list = UIUtil.Create("Frame", {
		Name = "List",
		Size = UDim2.new(1, -8, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = scroll,
	})
	UIUtil.Create("UIListLayout", {
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = list,
	})
	toastLabel = UIUtil.Create("TextLabel", {
		Name = "Toast",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Size = UDim2.new(1, -40, 0, 22),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = "",
		TextSize = 15,
		Visible = false,
		ZIndex = 5,
		Parent = box,
	})
	local GraphicsControls = require(Client.Components.GraphicsControls) :: any
	controls = GraphicsControls.Build(list, { Order = 1, Accent = ACCENT, Toast = toast })
	card = box
	return screen
end

function TownGraphics.IsOpen(): boolean
	local g = gui
	return g ~= nil and g.Enabled
end

function TownGraphics.Open()
	local g = gui
	if not g or g.Parent == nil then
		g = build()
		gui = g
	end
	local screen = g :: ScreenGui
	screen.Enabled = true
	if controls then
		pcall(controls.Refresh)
	end
	local box = card
	if box then
		UIUtil.Pop(box, 0.92, 0.18)
	end
	if not inputConn then
		inputConn = UserInputService.InputBegan:Connect(function(input: InputObject)
			if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
				TownGraphics.Close()
			end
		end)
	end
end

function TownGraphics.Close()
	local g = gui
	if g then
		g.Enabled = false
	end
	if inputConn then
		inputConn:Disconnect()
		inputConn = nil
	end
end

function TownGraphics.Toggle()
	if TownGraphics.IsOpen() then
		TownGraphics.Close()
	else
		TownGraphics.Open()
	end
end

return TownGraphics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="236">
          <Properties>
            <string name="Name">TownGreenery</string>
            <string name="Source"><![CDATA[--[[
	TownGreenery (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > TownGreenery

	🌳 Dopamine Town (v9.7, NATURE97) : les détails "de près" de la nature,
	construits côté CLIENT autour de l'avatar seulement (budget de pièces du
	serveur) :
	  - ARBRES : le serveur construit la silhouette (niveau 0) ou l'arbre
	    "vedette" (niveau 1) avec Shared/Greenery ; ici on ajoute le niveau 2
	    (racines, branche et grappes en plus, fruits, marques du bouleau,
	    noix de coco, pétales tombés) aux arbres à moins de ~150 studs. Même
	    graine -> même arbre pour tout le monde, les pièces ajoutées
	    s'emboîtent sans face confondue (voir Greenery) ;
	  - LAC ("NearDetail" = "Lake") : nénuphars (quelques-uns fleuris),
	    canards et cygnes qui glissent doucement sur l'eau, roseaux et
	    touffes d'herbe en plus sur la rive ;
	  - AIRE DE JEUX ("NearDetail" = "Playground") : v9.9 (PARK99) toute
	    l'aire de jeux réaliste et animée (ParkPlay).
	Tout est ancré, sans collision ni requête, sans ombre pour les petites
	pièces. Construction étalée (quelques arbres par pas), destruction au-delà
	d'une marge (hystérésis) ; seuls les oiseaux bougent (≤ 15 Hz, CFrame),
	et seulement quand le lac est construit.

	API (TownClient, via optionalModule) :
	  TownGreenery.Start()                   à l'entrée en ville
	  TownGreenery.Step(position: Vector3)   flux (4 fois / s)
	  TownGreenery.Stop()                    à la sortie
	  TownGreenery.Debug() -> table          (tests / rendus)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Greenery = require(ReplicatedStorage.Shared.Greenery)

local TownGreenery = {}

local M = Enum.Material
local rgb = Color3.fromRGB
local hash = Greenery.Hash
local LAKE = Greenery.LAKE

local FOLDER_NAME = "TownGreenery"
local TREE_IN, TREE_OUT = 150, 190 -- (studs) construire / détruire
local DETAIL_IN, DETAIL_OUT = 220, 270
-- v9.8 🎨 Graphismes > Détail (REALISM98) : distances de flux ×0,65 / ×1 / ×1,35
local okGQ, GraphicsQuality = pcall(require, game:GetService("ReplicatedStorage").Shared.GraphicsQuality)
local function detailScale(): number
	return okGQ and type(GraphicsQuality) == "table" and GraphicsQuality.DetailScale and GraphicsQuality.DetailScale() or 1
end
local BUILDS_PER_STEP = 5
local BIRD_HZ = 15

type Tree = { Model: Model, Base: Vector3, Near: Model? }
type Detail = { Model: Model, Kind: string, CF: CFrame, R: number, Near: Model?, Birds: { any }? }

local started = false
local folder: Folder? = nil
local trees: { Tree } = {}
local details: { Detail } = {}
local conns: { RBXScriptConnection } = {}
local rescan = 0
local birdClock = 0
local clock = 0

----------------------------------------------------------------------
-- Petites fabriques (tout en décor : pas de collision, pas de requête)
----------------------------------------------------------------------

local function newPart(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function egg(parent: Instance, name: string, cf: CFrame, size: Vector3, color: Color3, material: Enum.Material?): Part
	local p = newPart(parent, name, size, cf, color, material)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

local function ball(parent: Instance, name: string, center: Vector3, d: number, color: Color3, material: Enum.Material?): Part
	local p = newPart(parent, name, Vector3.new(d, d, d), CFrame.new(center), color, material)
	p.Shape = Enum.PartType.Ball
	return p
end

-- disque à plat (axe vertical), dessus à `top`
local function disc(parent: Instance, name: string, cf: CFrame, top: number, radius: number, thickness: number, color: Color3, material: Enum.Material?): Part
	local p = newPart(parent, name, Vector3.new(thickness, radius * 2, radius * 2), cf * CFrame.new(0, top - thickness / 2, 0) * CFrame.Angles(0, 0, math.pi / 2), color, material)
	p.Shape = Enum.PartType.Cylinder
	return p
end

local function rod(parent: Instance, name: string, a: Vector3, b: Vector3, d: number, color: Color3, material: Enum.Material?): Part
	local axis = (b - a).Unit
	local up = math.abs(axis.Y) > 0.98 and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0)
	local p = newPart(parent, name, Vector3.new((b - a).Magnitude, d, d), CFrame.lookAt((a + b) / 2, b, up) * CFrame.Angles(0, math.pi / 2, 0), color, material)
	p.Shape = Enum.PartType.Cylinder
	return p
end

----------------------------------------------------------------------
-- Oiseaux du lac (un Model par oiseau, pièces placées depuis des décalages figés)
----------------------------------------------------------------------

local function duck(parent: Instance, kind: number): Model
	local m = Instance.new("Model")
	m.Name = "Duck"
	local body = kind == 1 and rgb(150, 126, 104) or (kind == 2 and rgb(255, 255, 255) or rgb(255, 226, 110))
	local head = kind == 1 and rgb(40, 120, 76) or body
	local root = egg(m, "DuckBody", CFrame.new(0, 0.35, 0), Vector3.new(1.1, 0.8, 1.7), body)
	ball(m, "DuckHead", Vector3.new(0, 0.95, -0.62), 0.7, head)
	egg(m, "DuckBeak", CFrame.new(0, 0.9, -1.05), Vector3.new(0.34, 0.16, 0.42), rgb(255, 160, 60))
	egg(m, "DuckTail", CFrame.new(0, 0.62, 0.78) * CFrame.Angles(math.rad(-30), 0, 0), Vector3.new(0.5, 0.3, 0.6), body)
	m.PrimaryPart = root
	m.Parent = parent
	return m
end

local function swan(parent: Instance): Model
	local m = Instance.new("Model")
	m.Name = "Swan"
	local white = rgb(252, 252, 255)
	local root = egg(m, "SwanBody", CFrame.new(0, 0.5, 0), Vector3.new(1.7, 1.1, 2.9), white)
	egg(m, "SwanWing", CFrame.new(0, 0.85, 0.35), Vector3.new(1.5, 0.7, 1.9), rgb(240, 242, 248))
	rod(m, "SwanNeck", Vector3.new(0, 0.8, -1.05), Vector3.new(0, 2.3, -1.3), 0.34, white)
	ball(m, "SwanHead", Vector3.new(0, 2.4, -1.42), 0.62, white)
	egg(m, "SwanBeak", CFrame.new(0, 2.32, -1.86), Vector3.new(0.22, 0.2, 0.5), rgb(255, 140, 60))
	m.PrimaryPart = root
	m.Parent = parent
	return m
end

----------------------------------------------------------------------
-- Détails du lac et de l'aire de jeux
----------------------------------------------------------------------

local function buildLake(d: Detail, parent: Model)
	local L, R = d.CF, d.R
	local bx = LAKE.BridgeX * R
	local ix, iz, ir = LAKE.Island[1] * R, LAKE.Island[2] * R, math.max(4.5, LAKE.Island[3] * R)
	local jx, jz = LAKE.Jet[1] * R, LAKE.Jet[2] * R
	local function freeWater(x: number, z: number, margin: number): boolean
		if x * x + z * z > (R - 3 - margin) ^ 2 then
			return false
		end
		if math.abs(x - bx) < LAKE.BridgeHalfW + 2 + margin then
			return false
		end
		if (x - ix) ^ 2 + (z - iz) ^ 2 < (ir + 2 + margin) ^ 2 or (x - jx) ^ 2 + (z - jz) ^ 2 < (3 + margin) ^ 2 then
			return false
		end
		-- (ponton et bateaux : bande le long de +X)
		if x > R * 0.45 and math.abs(z - LAKE.DockZ * R) < 7 + margin then
			return false
		end
		return true
	end
	-- nénuphars (feuilles à plat sur l'eau), quelques-uns fleuris
	local pads = 0
	for k = 1, 30 do
		if pads >= 9 then
			break
		end
		local a = hash(k, 201) * math.pi * 2
		local r = R * (0.3 + hash(k, 202) * 0.62)
		local x, z = math.sin(a) * r, math.cos(a) * r
		if freeWater(x, z, 1.5) then
			pads += 1
			local size = 1.1 + hash(k, 203) * 0.7
			local cf = L * CFrame.new(x, 0, z) * CFrame.Angles(0, hash(k, 204) * 6, 0)
			disc(parent, "LilyPad", cf, LAKE.WaterTop + 0.08 + (pads % 3) * 0.02, size, 0.06, rgb(96, 176, 96):Lerp(rgb(140, 200, 110), hash(k, 205)), M.Grass)
			if pads % 3 == 1 then
				local top = (cf * CFrame.new(0.2, LAKE.WaterTop + 0.34, 0)).Position
				egg(parent, "LilyFlower", CFrame.new(top), Vector3.new(0.8, 0.5, 0.8), rgb(255, 178, 214))
				ball(parent, "LilyHeart", top + Vector3.new(0, 0.2, 0), 0.3, rgb(255, 226, 110))
			end
		end
	end
	-- roseaux + touffes en plus sur la rive
	for k = 0, 7 do
		local a = 0.3 + k * 0.79 + hash(k, 206) * 0.3
		local x, z = math.sin(a) * (R + 0.4), math.cos(a) * (R + 0.4)
		if not (math.abs(x - bx) < 8 and math.abs(z) > R * 0.6) and not (x > R * 0.45 and math.abs(z - LAKE.DockZ * R) < 8) then
			local base = L * CFrame.new(x, 0, z) * CFrame.Angles(0, a, 0)
			egg(parent, "Reeds", base * CFrame.new(0, 1.3, 0) * CFrame.Angles(0, 0, math.rad(-8)), Vector3.new(1, 3.2 + hash(k, 207), 0.8), rgb(110, 164, 86), M.Grass)
			egg(parent, "Reeds", base * CFrame.new(0.8, 1.1, 0.4) * CFrame.Angles(0, 0, math.rad(10)), Vector3.new(0.9, 2.6, 0.7), rgb(128, 176, 92), M.Grass)
			egg(parent, "Tuft", base * CFrame.new(-0.4, 0.4, 1.8), Vector3.new(1.6, 0.9, 1.2), rgb(104, 170, 84), M.Grass)
		end
	end
	-- canards et cygnes : chacun tourne doucement autour de son point
	local birds = {}
	local spots = 0
	for k = 1, 40 do
		if spots >= 6 then
			break
		end
		local a = hash(k, 210) * math.pi * 2
		local r = R * (0.25 + hash(k, 211) * 0.5)
		local x, z = math.sin(a) * r, math.cos(a) * r
		local orbit = 2.5 + hash(k, 212) * 3
		if freeWater(x, z, orbit + 1.5) then
			spots += 1
			local m = spots <= 2 and swan(parent) or duck(parent, spots % 3)
			-- décalages figés par rapport au corps : chaque image repart de ces valeurs exactes
			-- (PivotTo répété accumule des erreurs d'arrondi → dérive puis NaN)
			local offsets = {}
			local rootCF = (m.PrimaryPart :: BasePart).CFrame
			for _, part in ipairs(m:GetDescendants()) do
				if part:IsA("BasePart") then
					table.insert(offsets, { Part = part, Off = rootCF:ToObjectSpace(part.CFrame) })
				end
			end
			table.insert(birds, {
				Model = m,
				Offsets = offsets,
				Center = Vector3.new(x, 0, z),
				Orbit = orbit,
				Speed = (0.08 + hash(k, 213) * 0.06) * (hash(k, 214) < 0.5 and -1 or 1),
				Phase = hash(k, 215) * math.pi * 2,
				Y = LAKE.WaterTop - 0.15,
			})
		end
	end
	d.Birds = birds
end

-- (v9.9, PARK99) toute l'aire de jeux réaliste QUI MARCHE : ParkPlay
-- (décor, balançoires / tape-cul / tourniquet / jeux à ressort animés,
-- toboggan, barres de singe, bac à sable). Sans ParkPlay : les jouets du
-- bac à sable d'avant (v9.7).
local okPark, ParkPlay = pcall(require, script.Parent:FindFirstChild("ParkPlay") :: any)

local function buildPlayground(d: Detail, parent: Model)
	if okPark and type(ParkPlay) == "table" and type(ParkPlay.Build) == "function" then
		local ok, err = pcall(ParkPlay.Build, d.CF, parent, d.Model)
		if ok then
			return
		end
		warn("[TownGreenery] ParkPlay : " .. tostring(err))
	end
	local g = d.CF
	-- bac à sable (centré en (-8, -7.5), sable dessus à 0,55)
	local box = g * CFrame.new(-8, 0.55, -7.5)
	local bucket = box * CFrame.new(1.4, 0, 1)
	local b = newPart(parent, "Bucket", Vector3.new(0.9, 0.9, 0.9), bucket * CFrame.new(0, 0.45, 0) * CFrame.Angles(0, 0, math.pi / 2), rgb(236, 72, 90))
	b.Shape = Enum.PartType.Cylinder
	rod(parent, "BucketHandle", (bucket * CFrame.new(-0.42, 0.95, 0)).Position, (bucket * CFrame.new(0.42, 0.95, 0)).Position, 0.08, rgb(60, 60, 70))
	rod(parent, "Spade", (box * CFrame.new(-1.2, 0.05, 1.6)).Position, (box * CFrame.new(-0.2, 0.9, 1.1)).Position, 0.14, rgb(80, 150, 230))
	newPart(parent, "SpadeBlade", Vector3.new(0.5, 0.06, 0.6), box * CFrame.new(-1.45, 0.06, 1.75), rgb(80, 150, 230))
	local castle = box * CFrame.new(-1, 0, -1.2)
	local keep = newPart(parent, "Castle", Vector3.new(1.3, 1.6, 1.6), castle * CFrame.new(0, 0.65, 0) * CFrame.Angles(0, 0, math.pi / 2), rgb(236, 214, 170), M.Sand)
	keep.Shape = Enum.PartType.Cylinder
	for k = 0, 3 do
		local a = k * math.pi / 2
		local t = newPart(parent, "Turret", Vector3.new(0.9, 0.5, 0.5), castle * CFrame.new(math.cos(a) * 0.95, 0.45, math.sin(a) * 0.95) * CFrame.Angles(0, 0, math.pi / 2), rgb(230, 206, 160), M.Sand)
		t.Shape = Enum.PartType.Cylinder
	end
	ball(parent, "Ball", (g * CFrame.new(4, 0.95, -2)).Position, 1.4, rgb(255, 120, 150))
end

----------------------------------------------------------------------
-- Flux
----------------------------------------------------------------------

local function discover()
	table.clear(trees)
	table.clear(details)
	local town = workspace:FindFirstChild("DopamineTown")
	if not town then
		return
	end
	for _, d in ipairs(town:GetDescendants()) do
		if d:IsA("Model") then
			local base = d:GetAttribute("TreeBase")
			if typeof(base) == "Vector3" and type(d:GetAttribute("TreeSpecies")) == "string" then
				table.insert(trees, { Model = d, Base = base })
			else
				local kind = d:GetAttribute("NearDetail")
				local cf = d:GetAttribute("DetailCF")
				if type(kind) == "string" and typeof(cf) == "CFrame" then
					table.insert(details, { Model = d, Kind = kind, CF = cf, R = tonumber(d:GetAttribute("DetailR")) or 20 })
				end
			end
		end
	end
end

local function buildTree(t: Tree)
	local m = t.Model
	local tier = tonumber(m:GetAttribute("TreeTier")) or 0
	if tier >= Greenery.NEAR_TIER or not folder then
		return
	end
	local near = Greenery.Tree(folder, t.Base, tonumber(m:GetAttribute("TreeHeight")) or 12, tonumber(m:GetAttribute("TreeSeed")) or 1, m:GetAttribute("TreeSpecies") :: any, Greenery.NEAR_TIER, tier + 1, {
		Lawn = m:GetAttribute("TreeLawn") == true,
		Name = "TreeNear",
	})
	-- (tout en décor côté client)
	for _, p in ipairs(near:GetChildren()) do
		if p:IsA("BasePart") then
			p.CanCollide = false
			p.CastShadow = false
		end
	end
	t.Near = near
end

local function buildDetail(d: Detail)
	if not folder then
		return
	end
	local m = Instance.new("Model")
	m.Name = "Near" .. d.Kind
	if d.Kind == "Lake" then
		buildLake(d, m)
	elseif d.Kind == "Playground" then
		buildPlayground(d, m)
	end
	m.Parent = folder
	d.Near = m
end

local function moveBirds(dt: number)
	for _, d in ipairs(details) do
		if d.Near and d.Birds then
			for _, b in ipairs(d.Birds) do
				b.Phase += b.Speed * dt * 2
				local x = b.Center.X + math.cos(b.Phase) * b.Orbit
				local z = b.Center.Z + math.sin(b.Phase) * b.Orbit
				-- (le bec regarde dans le sens de la marche : tangente au cercle)
				local tx, tz = -math.sin(b.Phase) * b.Speed, math.cos(b.Phase) * b.Speed
				local pos = d.CF * Vector3.new(x, b.Y + math.sin(b.Phase * 7) * 0.04, z)
				local ahead = d.CF * Vector3.new(x + tx, b.Y, z + tz)
				if b.Model.Parent and (ahead - pos).Magnitude > 1e-4 then
					local cf = CFrame.lookAt(pos, Vector3.new(ahead.X, pos.Y, ahead.Z))
					for _, o in ipairs(b.Offsets) do
						o.Part.CFrame = cf * o.Off
					end
				end
			end
		end
	end
end

local function heartbeat(dt: number)
	birdClock += dt
	if birdClock >= 1 / BIRD_HZ then
		moveBirds(birdClock)
		birdClock = 0
	end
end

function TownGreenery.Step(position: Vector3?)
	if not started or typeof(position) ~= "Vector3" then
		return
	end
	local pos = position :: Vector3
	clock += 1
	if #trees == 0 and #details == 0 then
		rescan += 1
		if rescan % 8 == 1 then
			discover()
		end
	end
	local k = detailScale()
	local function dist(p: Vector3): number
		return Vector3.new(p.X - pos.X, 0, p.Z - pos.Z).Magnitude
	end
	-- détruire au-delà de la marge, repérer les plus proches à construire
	local want = {}
	for _, t in ipairs(trees) do
		if not t.Model.Parent then
			if t.Near then
				t.Near:Destroy()
				t.Near = nil
			end
		else
			local dd = dist(t.Base)
			if t.Near and dd > TREE_OUT * k then
				t.Near:Destroy()
				t.Near = nil
			elseif not t.Near and dd < TREE_IN * k then
				table.insert(want, { t, dd })
			end
		end
	end
	for _, d in ipairs(details) do
		local dd = dist(d.CF.Position)
		if d.Near and dd > DETAIL_OUT * k then
			d.Near:Destroy()
			d.Near = nil
			d.Birds = nil
		elseif not d.Near and dd < DETAIL_IN * k and d.Model.Parent then
			buildDetail(d)
		end
	end
	table.sort(want, function(a, b)
		return a[2] < b[2]
	end)
	for i = 1, math.min(#want, BUILDS_PER_STEP) do
		buildTree(want[i][1])
	end
end

function TownGreenery.Start()
	if started then
		return
	end
	started = true
	local old = workspace:FindFirstChild(FOLDER_NAME)
	if old then
		old:Destroy()
	end
	local f = Instance.new("Folder")
	f.Name = FOLDER_NAME
	f.Parent = workspace
	folder = f
	rescan = 0
	discover()
	table.insert(conns, RunService.Heartbeat:Connect(heartbeat))
end

function TownGreenery.Stop()
	if not started then
		return
	end
	started = false
	for _, c in ipairs(conns) do
		c:Disconnect()
	end
	table.clear(conns)
	for _, t in ipairs(trees) do
		t.Near = nil
	end
	for _, d in ipairs(details) do
		d.Near = nil
		d.Birds = nil
	end
	table.clear(trees)
	table.clear(details)
	if folder then
		folder:Destroy()
		folder = nil
	end
end

function TownGreenery.Debug()
	local builtTrees, parts = 0, 0
	for _, t in ipairs(trees) do
		if t.Near then
			builtTrees += 1
		end
	end
	if folder then
		for _, d in ipairs(folder:GetDescendants()) do
			if d:IsA("BasePart") then
				parts += 1
			end
		end
	end
	local birds = 0
	for _, d in ipairs(details) do
		birds += d.Birds and #d.Birds or 0
	end
	return { Trees = #trees, NearTrees = builtTrees, Details = #details, Parts = parts, Birds = birds, Steps = clock }
end

return TownGreenery
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="237">
          <Properties>
            <string name="Name">TownHighway</string>
            <string name="Source"><![CDATA[--[[
	TownHighway (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > TownHighway

	🛣️ Dopamine Town (v10, CITY10) : l'AUTOROUTE (2 x 2 voies) habillée côté
	CLIENT, en flux (TownStreetLife). Les tronçons sont calculés par
	CityPlan à partir du tracé de LAYOUT10 (WorldLayout.HighwayPath) ; ici
	on construit, pour chaque emplacement :
	  - "HwySeg"   : un tronçon (≤ 40 studs) : chaussée (si le tracé n'a pas
	    de dalle serveur), lignes de rive continues, lignes de voies en
	    tirets, bande d'arrêt d'urgence, terre-plein central avec séparateur
	    en béton (profil "New Jersey") et écran anti-éblouissement, glissières
	    de sécurité (lisse à double onde sur poteaux), balises de bord ;
	    EN HAUTEUR (pont, viaduc) : corniche, parapets en béton et pile
	    (semelle, fûts ronds, chevêtre) ;
	  - "HwyRamp"  : tronçon de bretelle (1 voie, sens unique) ;
	  - "HwyLamp"  : grand candélabre à double crosse sur le terre-plein ;
	  - "HwyGantry": portique de signalisation (treillis, panneaux bleus
	    avec les noms des quartiers et des flèches) ;
	  - "HwyWall"  : mur antibruit (poteaux en H, panneaux absorbants et
	    bandes vitrées) le long des quartiers d'habitation ;
	  - "HwyExit"  : divergent de sortie (zébras, atténuateur de choc
	    jaune et noir, panneau "SORTIE") ;
	  - "HwySign"  : panneau de bord (sortie à 500 m, nom du quartier,
	    limitation 110) ;
	  - "HwyRest"  : aire de repos (bâtiment sanitaires, tables de
	    pique-nique, arbres, places tracées, distributeur).
	Loin (au-delà du rayon "gros objets") : IMPOSTEURS de quelques pièces
	(bande de chaussée, parapets, piles) jusqu'à ~900 studs.
	Tout est ancré ; chaussée, séparateurs, glissières, parapets et piles
	sont SOLIDES (collision locale : la voiture du joueur roule et se cogne),
	le reste est décor. Aucune lumière réelle (verres "NightGlow"), aucun
	son. Pas de face confondue : peinture 0,12 au-dessus du bitume, tronçons
	voisins décalés de 0,03 en hauteur (joints en biais).

	Données d'un emplacement (spot.Data, voir CityPlan) :
	  { Lanes, Lane, Median, ShL, ShR, Deck, Elev, Ground, Par, Oneway,
	    Signs = { {Text, Arrow} }, Exit, Name }
	API (TownStreetLife) : TownHighway.BUILDERS, .BIG, .IMPOSTORS
	  TownHighway.Width(d) -> largeur totale d'un tronçon
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Locale = require(ReplicatedStorage.Shared.Locale)
local CityKit = require(script.Parent.CityKit)

local TownHighway = {}

local M = CityKit.M
local rgb = CityKit.rgb
local Box, Part, Column, Wedge, Glow, Text = CityKit.Box, CityKit.Part, CityKit.Column, CityKit.Wedge, CityKit.Glow, CityKit.Text
local hash = CityKit.Hash

local ASPHALT = rgb(70, 72, 82)
local ASPHALT_OLD = rgb(84, 86, 96)
local PAINT = rgb(250, 250, 246)
local YELLOW = rgb(250, 204, 40)
local CONCRETE = rgb(196, 194, 188)
local CONCRETE_D = rgb(164, 162, 156)
local GALVA = rgb(178, 184, 190)
local GALVA_D = rgb(140, 146, 152)
local SIGN_BLUE = rgb(24, 70, 160)
local SIGN_GREEN = rgb(24, 120, 70)
local WHITE = rgb(250, 250, 248)
local GRAPHITE = rgb(52, 54, 60)
local GLARE = rgb(52, 110, 70)
local LAMP = rgb(255, 226, 170)

local H_PAINT = 0.12 -- dessus de la peinture au-dessus du bitume
local T_PAINT = 0.05

----------------------------------------------------------------------
-- Profil en travers
----------------------------------------------------------------------

type Prof = { Lanes: number, Lane: number, Median: number, ShL: number, ShR: number, Oneway: boolean }

local function prof(d: any): Prof
	d = d or {}
	return {
		Lanes = d.Lanes or 2,
		Lane = d.Lane or 11,
		Median = d.Oneway and 0 or (d.Median or 5),
		ShL = d.ShL or 1.5,
		ShR = d.ShR or 5,
		Oneway = d.Oneway == true,
	}
end

-- Largeur d'une chaussée (un sens) et largeur totale
local function sideW(p: Prof): number
	return p.ShL + p.Lanes * p.Lane + p.ShR
end

function TownHighway.Width(d: any): number
	local p = prof(d)
	if p.Oneway then
		return sideW(p)
	end
	return p.Median + 2 * sideW(p)
end

-- Bandes de chaque sens : { x0 (bord gauche = côté terre-plein), dir (+1 à droite) }
local function carriageways(p: Prof): { { number } }
	if p.Oneway then
		return { { -sideW(p) / 2, 1 } }
	end
	return { { p.Median / 2, 1 }, { -p.Median / 2, -1 } }
end

----------------------------------------------------------------------
-- Tronçon
----------------------------------------------------------------------

-- ligne peinte le long de z (repère F : dessus du bitume à y = top)
local function line(m: Model, F: CFrame, x: number, z0: number, z1: number, w: number, top: number, color: Color3?)
	Box(m, "Paint", F, x - w / 2, x + w / 2, top + H_PAINT - T_PAINT, top + H_PAINT, z0, z1, color or PAINT, M.SmoothPlastic)
end

-- tirets le long de z, en phase avec la distance le long du tracé (s0)
local function dashes(m: Model, F: CFrame, x: number, L: number, s0: number, top: number)
	local DASH, GAP = 9, 15
	local period = DASH + GAP
	local s = s0 - (s0 % period) -- début d'une période
	while s < s0 + L do
		local a, b = math.max(s, s0), math.min(s + DASH, s0 + L)
		if b - a > 0.4 then
			-- z local : le tronçon va de +L/2 (début) à -L/2 (fin)
			line(m, F, x, L / 2 - (b - s0), L / 2 - (a - s0), 0.5, top)
		end
		s += period
	end
end

-- glissière de sécurité (lisse à double onde sur poteaux) côté `side`
local function guardrail(m: Model, F: CFrame, x: number, L: number, side: number, top: number, s0: number, extra: number?)
	local post = 6
	local first = post - (s0 % post)
	local s = first
	while s < L - 0.3 do
		local z = L / 2 - s
		Box(m, "RailPost", F, x - 0.18, x + 0.18, top, top + 2.3, z - 0.18, z + 0.18, GALVA_D, M.Metal, true)
		Box(m, "RailSpacer", F, x + side * 0.18, x + side * 0.02 + side * 0.3, top + 1.6, top + 2.2, z - 0.15, z + 0.15, GALVA_D, M.Metal)
		s += post
	end
	-- lisse : deux ondes (bandes) + creux
	local xr = x - side * 0.5
	local R = L / 2 + (extra or 0)
	Box(m, "RailWave", F, xr - 0.12, xr + 0.12, top + 1.95, top + 2.35, -R, R, GALVA, M.DiamondPlate, true)
	Box(m, "RailWave", F, xr - 0.12, xr + 0.12, top + 1.45, top + 1.85, -R, R, GALVA, M.DiamondPlate, true)
	Box(m, "RailTrough", F, xr + side * 0.05 - 0.04, xr + side * 0.05 + 0.04, top + 1.8, top + 2.0, -R, R, GALVA_D, M.Metal)
end

-- séparateur en béton "New Jersey" au milieu (x = 0) + écran anti-éblouissement
local function jersey(m: Model, F: CFrame, L: number, top: number, glare: boolean)
	Box(m, "JerseyFoot", F, -1.3, 1.3, top - 0.3, top + 0.9, -L / 2, L / 2, CONCRETE, M.Concrete, true)
	-- (coin : face verticale du coin côté intérieur, pente vers l'extérieur)
	Wedge(m, "JerseySlope", Vector3.new(L, 1.1, 0.8), F * CFrame.new(-0.9, top + 1.45, 0) * CFrame.Angles(0, math.pi / 2, 0), CONCRETE, M.Concrete, true)
	Wedge(m, "JerseySlope", Vector3.new(L, 1.1, 0.8), F * CFrame.new(0.9, top + 1.45, 0) * CFrame.Angles(0, -math.pi / 2, 0), CONCRETE, M.Concrete, true)
	Box(m, "JerseyTop", F, -0.5, 0.5, top + 0.9, top + 2.8, -L / 2, L / 2, CONCRETE, M.Concrete, true)
	if glare then
		-- lamelles vertes (anti-éblouissement), une tous les 1,2 studs
		Box(m, "GlareRail", F, -0.12, 0.12, top + 4.0, top + 4.14, -L / 2, L / 2, GALVA_D, M.Metal)
		local n = math.floor(L / 1.2)
		for i = 0, n - 1 do
			local z = -L / 2 + (i + 0.5) * L / n
			Box(m, "GlareBlade", F, -0.05, 0.05, top + 2.8, top + 4.0, z - 0.3, z + 0.3, GLARE, M.SmoothPlastic)
		end
	end
end

-- balises de bord (poteaux blancs à bande noire et catadioptre)
local function delineators(m: Model, F: CFrame, x: number, L: number, top: number, s0: number, side: number)
	local every = 20
	local s = every - (s0 % every)
	while s < L - 0.3 do
		local z = L / 2 - s
		Box(m, "Delineator", F, x - 0.25, x + 0.25, top, top + 3.4, z - 0.15, z + 0.15, WHITE, M.SmoothPlastic)
		Box(m, "DelineatorBand", F, x - 0.3, x + 0.3, top + 2.4, top + 2.9, z - 0.2, z + 0.2, GRAPHITE, M.SmoothPlastic)
		Glow(Box(m, "Reflector", F, x - 0.1, x + 0.1, top + 2.5, top + 2.8, z + side * 0.2, z + side * 0.24, rgb(255, 140, 40), M.SmoothPlastic))
		s += every
	end
end

-- pile de pont (semelle, 2 fûts ronds, chevêtre) sous la dalle à z
local function pier(m: Model, F: CFrame, z: number, half: number, deckBottom: number, groundDy: number)
	local cap = 2.2
	local capTop = deckBottom
	Box(m, "PierCap", F, -half * 0.9, half * 0.9, capTop - cap, capTop, z - 2, z + 2, CONCRETE_D, M.Concrete, true)
	local foot = groundDy
	for _, x in ipairs({ -half * 0.45, half * 0.45 }) do
		Column(m, "PierShaft", F, x, z, foot, capTop - cap, 3.4, CONCRETE, M.Concrete, true)
		Box(m, "PierFooting", F, x - 2.6, x + 2.6, foot - 0.2, foot + 0.5, z - 2.6, z + 2.6, CONCRETE_D, M.Concrete, true)
	end
end

local function buildSeg(m: Model, F: CFrame, seed: number, spot: any)
	local d = spot and spot.Data or {}
	local p = prof(d)
	local L = spot and spot.Size and spot.Size.Z or 40
	local top = ((d.Par == 1) and 0.03 or 0) + (d.PaintY or 0) -- tronçons voisins décalés (joints en biais)
	local s0 = d.S or 0 -- abscisse du début du tronçon le long du tracé
	local W = TownHighway.Width(d)
	local elev = (d.Elev or 0) > 3
	local extra = d.Overlap or 0 -- allongement aux joints en biais
	local Lx = L + 2 * extra
	-- chaussée (si pas de dalle serveur)
	if d.Deck ~= false then
		local tint = hash(seed, 1) < 0.25 and ASPHALT_OLD or ASPHALT
		Box(m, "HwyAsphalt", F, -W / 2, W / 2, top - (elev and 2.2 or 0.6), top, -Lx / 2, Lx / 2, tint, M.Asphalt, true)
	end
	for _, cw in ipairs(carriageways(p)) do
		local x0, dir = cw[1], cw[2]
		local inner = x0 + dir * p.ShL -- bord intérieur de la voie de gauche
		local outer = inner + dir * p.Lanes * p.Lane
		line(m, F, inner + dir * 0.35, -Lx / 2, Lx / 2, 0.5, top)
		line(m, F, outer - dir * 0.35, -Lx / 2, Lx / 2, 0.7, top)
		for k = 1, p.Lanes - 1 do
			dashes(m, F, inner + dir * k * p.Lane, L, s0, top)
		end
		local edge = outer + dir * p.ShR -- bord extérieur de la bande d'arrêt
		if elev then
			-- parapet en béton + corniche
			Box(m, "Parapet", F, edge - dir * 1.2 - 0.001, edge, top, top + 3.2, -Lx / 2, Lx / 2, CONCRETE, M.Concrete, true)
			Box(m, "ParapetCap", F, edge - dir * 1.35, edge + dir * 0.15, top + 3.2, top + 3.5, -Lx / 2, Lx / 2, CONCRETE_D, M.Concrete)
			Box(m, "Cornice", F, edge, edge + dir * 0.6, top - 2.2, top + 0.4, -Lx / 2, Lx / 2, CONCRETE_D, M.Concrete)
		elseif not d.NoRail then
			guardrail(m, F, edge - dir * 1.0, L, dir, top, s0, extra)
			delineators(m, F, edge - dir * 0.2, L, top, s0, dir)
		end
	end
	if not p.Oneway then
		-- terre-plein : séparateur + écran (en hauteur : pas d'écran)
		jersey(m, F, Lx, top, not elev and hash(seed, 5) < 0.7)
	end
	-- pile au milieu du tronçon (en hauteur seulement)
	if elev and d.Pier ~= false then
		local groundDy = (d.Ground or (F.Position.Y - (d.Elev or 0))) - F.Position.Y
		pier(m, F, 0, W / 2, top - 2.2, groundDy)
	end
end

-- bretelle : même profil, 1 voie, sens unique
local function buildRamp(m: Model, F: CFrame, seed: number, spot: any)
	local d = table.clone(spot and spot.Data or {})
	d.Oneway = true
	d.Lanes = d.Lanes or 1
	d.ShL = d.ShL or 1.5
	d.ShR = d.ShR or 3
	buildSeg(m, F, seed, { Size = spot and spot.Size, Data = d })
end

----------------------------------------------------------------------
-- Équipements
----------------------------------------------------------------------

-- grand candélabre à double crosse (terre-plein) : F au pied, sur le séparateur
local function buildLamp(m: Model, F: CFrame, _seed: number, spot: any)
	local d = spot and spot.Data or {}
	local H = 22
	local reach = d.Reach or 9
	local base = 2.8 -- sur le séparateur
	Column(m, "HwyLampPole", F, 0, 0, base, H, 0.7, GALVA, M.Metal, true)
	Column(m, "HwyLampCollar", F, 0, 0, base, base + 1.2, 0.95, GALVA_D, M.Metal)
	local sides = d.Single and { 1 } or { -1, 1 }
	for _, sx in ipairs(sides) do
		local a = (F * CFrame.new(0, H - 0.3, 0)).Position
		local b = (F * CFrame.new(sx * reach, H + 0.9, 0)).Position
		CityKit.Rod(m, "HwyLampArm", a, b, 0.32, GALVA, M.Metal)
		local head = F * CFrame.new(sx * (reach + 0.9), H + 0.9, 0)
		Box(m, "HwyLampHead", head, -1.3, 1.3, -0.25, 0.3, -0.7, 0.7, GALVA_D, M.Metal)
		Glow(Box(m, "HwyLampGlass", head, -1.1, 1.1, -0.4, -0.25, -0.55, 0.55, LAMP, M.Glass))
	end
end

-- flèche en texte selon la direction du panneau
local ARROWS = { Up = "↑", Right = "↗", Left = "↖", Down = "↓", Exit = "↘" }

-- portique : F au milieu de la chaussée, au niveau du bitume ; spot.Data.W = portée
local function buildGantry(m: Model, F: CFrame, seed: number, spot: any)
	local d = spot and spot.Data or {}
	local W = d.W or 60
	local H = 17 -- sous-face des panneaux ~ 17 studs (≈ 5,5 m)
	for _, sx in ipairs({ -1, 1 }) do
		local x = sx * (W / 2 + 1.5)
		Box(m, "GantryFooting", F, x - 1.6, x + 1.6, -0.3, 1.2, -1.6, 1.6, CONCRETE_D, M.Concrete, true)
		for _, dz in ipairs({ -0.8, 0.8 }) do
			Column(m, "GantryLeg", F, x, dz, 1.2, H + 3.6, 0.5, GALVA, M.Metal, true)
		end
		for k = 0, 4 do
			local y = 2 + k * 3.6
			CityKit.Rod(m, "GantryBrace", (F * CFrame.new(x, y, -0.8)).Position, (F * CFrame.new(x, y + 3.6, 0.8)).Position, 0.14, GALVA_D, M.Metal)
		end
	end
	-- poutre en treillis : 4 membrures + diagonales
	local span = W + 3
	for _, yy in ipairs({ H + 0.2, H + 3.4 }) do
		for _, zz in ipairs({ -0.8, 0.8 }) do
			Box(m, "GantryChord", F, -span / 2, span / 2, yy - 0.18, yy + 0.18, zz - 0.18, zz + 0.18, GALVA, M.Metal)
		end
	end
	local n = math.floor(span / 3.2)
	for i = 0, n - 1 do
		local x0 = -span / 2 + i * span / n
		local x1 = x0 + span / n
		local up = i % 2 == 0
		CityKit.Rod(m, "GantryDiag", (F * CFrame.new(x0, up and H + 0.2 or H + 3.4, -0.8)).Position, (F * CFrame.new(x1, up and H + 3.4 or H + 0.2, -0.8)).Position, 0.12, GALVA_D, M.Metal)
	end
	-- panneaux (face vers les conducteurs qui arrivent : +Z local)
	local signs = d.Signs or { { Text = Locale.T("City centre"), Arrow = "Up" } }
	local count = math.min(#signs, 3)
	-- zone des panneaux : au-dessus de la chaussée du sens concerné
	local x0, x1 = -W / 2 + 2, W / 2 - 2
	if d.Side == "Right" then
		x0, x1 = 1.5, W / 2 - 1
	elseif d.Side == "Left" then
		x0, x1 = -W / 2 + 1, -1.5
	end
	local slot = (x1 - x0) / math.max(1, count)
	for i = 1, count do
		local s = signs[i]
		local cx = x1 - (i - 0.5) * slot -- de droite à gauche
		local sw = math.min(slot - 1.2, 24)
		local color = s.Green and SIGN_GREEN or SIGN_BLUE
		local panel = Box(m, "GantrySign", F, cx - sw / 2, cx + sw / 2, H - 0.2, H + 5.2, 0.95, 1.25, color, M.SmoothPlastic)
		Box(m, "GantrySignRim", F, cx - sw / 2 - 0.15, cx + sw / 2 + 0.15, H - 0.35, H + 5.35, 0.85, 0.95, WHITE, M.SmoothPlastic)
		Text(panel, Enum.NormalId.Back, (ARROWS[s.Arrow or "Up"] or "↑") .. "  " .. tostring(s.Text), WHITE, nil, Enum.Font.GothamBold, 420, 14)
		Glow(Box(m, "GantrySignLamp", F, cx - sw / 2 + 0.5, cx + sw / 2 - 0.5, H + 5.35, H + 5.6, 1.6, 2.1, rgb(220, 226, 236), M.Metal))
	end
	local _ = seed
end

-- mur antibruit le long de x (repère F : pied du mur, face route vers +Z)
local function buildWall(m: Model, F: CFrame, seed: number, spot: any)
	local L = spot and spot.Size and spot.Size.X or 40
	local H = 11
	local post = 8
	local n = math.max(1, math.floor(L / post + 0.5))
	local step = L / n
	local palette = { rgb(92, 128, 108), rgb(124, 110, 92), rgb(96, 112, 134) }
	local panel = palette[1 + math.floor(hash(seed, 2) * #palette) % #palette]
	Box(m, "WallPlinth", F, -L / 2, L / 2, -0.4, 1.6, -0.6, 0.6, CONCRETE, M.Concrete, true)
	for i = 0, n do
		local x = -L / 2 + i * step
		Box(m, "WallPostH", F, x - 0.35, x + 0.35, 1.6, H + 0.5, -0.45, 0.45, GALVA_D, M.Metal, true)
		if i < n then
			local xa, xb = x + 0.35, x + step - 0.35
			Box(m, "WallPanel", F, xa, xb, 1.6, H - 3.2, -0.3, 0.3, panel, M.Fabric, true)
			-- rainures horizontales des cassettes absorbantes
			for k = 1, 3 do
				local y = 1.6 + k * (H - 4.8) / 4
				Box(m, "WallGroove", F, xa, xb, y - 0.08, y + 0.08, 0.3, 0.36, panel:Lerp(Color3.new(0, 0, 0), 0.25), M.SmoothPlastic)
			end
			-- bande vitrée en haut (lumière, silhouettes d'oiseaux)
			local glass = Part(m, "WallGlass", Vector3.new(xb - xa, 3.2, 0.2), F * CFrame.new((xa + xb) / 2, H - 1.6, 0), rgb(190, 214, 226), M.Glass, nil, true)
			glass.Transparency = 0.45
			if hash(seed, i) < 0.3 then
				Box(m, "BirdSticker", F, (xa + xb) / 2 - 0.4, (xa + xb) / 2 + 0.4, H - 1.4, H - 0.9, 0.1, 0.14, GRAPHITE, M.SmoothPlastic)
			end
		end
	end
	Box(m, "WallCap", F, -L / 2, L / 2, H, H + 0.3, -0.4, 0.4, GALVA_D, M.Metal)
end

-- divergent de sortie : F au nez du divergent (entre autoroute et bretelle),
-- -Z = sens de circulation
local function buildExit(m: Model, F: CFrame, seed: number, spot: any)
	local d = spot and spot.Data or {}
	-- zébras (chevrons peints) sur le musoir
	for i = 0, 5 do
		local z = 4 + i * 4
		local w = math.max(0.8, 5 - i * 0.7)
		-- (au-dessus des lignes des tronçons et des bretelles : 0,24 / 0,27)
		Part(m, "GoreChevron", Vector3.new(w, T_PAINT, 0.7), F * CFrame.new(-w * 0.38, 0.24 - T_PAINT / 2, z + w * 0.32) * CFrame.Angles(0, math.rad(40), 0), PAINT, M.SmoothPlastic)
		Part(m, "GoreChevron", Vector3.new(w, T_PAINT, 0.7), F * CFrame.new(w * 0.38, 0.27 - T_PAINT / 2, z + w * 0.32) * CFrame.Angles(0, math.rad(-40), 0), PAINT, M.SmoothPlastic)
	end
	-- atténuateur de choc (bandes jaunes et noires)
	local A = F * CFrame.new(0, 0, -1)
	Box(m, "CushionBase", A, -1.2, 1.2, 0, 0.3, -4, 1.5, GRAPHITE, M.Metal, true)
	for k = 0, 3 do
		local z = -3.5 + k * 1.3
		Box(m, "Cushion", A, -1.05, 1.05, 0.3, 2.8, z, z + 1.1, k % 2 == 0 and YELLOW or GRAPHITE, M.SmoothPlastic, true)
	end
	Box(m, "CushionNose", A, -1.1, 1.1, 0.3, 2.9, 1.4, 1.62, YELLOW, M.SmoothPlastic)
	for i = 0, 2 do
		Box(m, "CushionStripe", A, -0.9 + i * 0.7, -0.6 + i * 0.7, 0.6, 2.6, 1.62, 1.66, GRAPHITE, M.SmoothPlastic)
	end
	-- panneau "SORTIE" sur le musoir, face aux conducteurs (+Z)
	local P = F * CFrame.new(0, 0, -6)
	Column(m, "ExitPost", P, -1.4, 0, 0, 7, 0.3, GALVA, M.Metal, true)
	Column(m, "ExitPost", P, 1.4, 0, 0, 7, 0.3, GALVA, M.Metal, true)
	local sign = Box(m, "ExitSign", P, -2.4, 2.4, 5, 7.6, 0.2, 0.4, SIGN_BLUE, M.SmoothPlastic)
	Text(sign, Enum.NormalId.Back, "↗ " .. Locale.T("EXIT") .. (d.Number and (" " .. tostring(d.Number)) or ""), WHITE, nil, Enum.Font.GothamBlack, 300, 20)
	local _ = seed
end

-- panneau de bord : F au pied, face aux conducteurs (+Z) ; Data.Text / Kind
local function buildSign(m: Model, F: CFrame, seed: number, spot: any)
	local d = spot and spot.Data or {}
	local kind = d.Kind or "Exit"
	if kind == "Speed" then
		Column(m, "SpeedPost", F, 0, 0, 0, 7.2, 0.3, GALVA, M.Metal, true)
		-- disque rouge (cylindre couché selon Z) + fond blanc devant
		Part(m, "SpeedDisc", Vector3.new(0.2, 3.4, 3.4), F * CFrame.new(0, 7.6, 0) * CFrame.Angles(0, math.pi / 2, 0), rgb(220, 30, 40), M.SmoothPlastic, "Cyl")
		Part(m, "SpeedFace", Vector3.new(0.2, 2.7, 2.7), F * CFrame.new(0, 7.6, 0.08) * CFrame.Angles(0, math.pi / 2, 0), WHITE, M.SmoothPlastic, "Cyl")
		local plate = Box(m, "SpeedText", F, -1, 1, 6.9, 8.3, 0.22, 0.24, WHITE, M.SmoothPlastic)
		plate.Transparency = 1
		Text(plate, Enum.NormalId.Back, tostring(d.Limit or 110), rgb(20, 20, 24), nil, Enum.Font.GothamBlack, 160, 40)
		return
	end
	local w = d.W or 12
	local color = kind == "Name" and rgb(250, 250, 250) or SIGN_BLUE
	local ink = kind == "Name" and rgb(20, 20, 24) or WHITE
	for _, x in ipairs({ -w / 2 + 1, w / 2 - 1 }) do
		Column(m, "SignPost", F, x, 0, 0, 9.6, 0.36, GALVA, M.Metal, true)
	end
	local panel = Box(m, "RoadSign", F, -w / 2, w / 2, 6.2, 9.8, -0.1, 0.1, color, M.SmoothPlastic)
	Box(m, "RoadSignRim", F, -w / 2 - 0.12, w / 2 + 0.12, 6.08, 9.92, -0.16, -0.1, kind == "Name" and rgb(200, 30, 40) or WHITE, M.SmoothPlastic)
	Text(panel, Enum.NormalId.Back, tostring(d.Text or ""), ink, nil, Enum.Font.GothamBold, 260, 16)
	local _ = seed
end

-- aire de repos : F au centre, -Z vers l'autoroute ; ~46 x 30
local function buildRest(m: Model, F: CFrame, seed: number, _spot: any)
	local W, D = 46, 30
	-- place de parking en bitume + places tracées
	Box(m, "RestLot", F, -W / 2, W / 2, 0.05, 0.25, -D / 2, 0, ASPHALT, M.Asphalt, true)
	for i = 0, 7 do
		local x = -W / 2 + 4 + i * 5.2
		Box(m, "RestBay", F, x - 0.2, x + 0.2, 0.25 + 0.07, 0.25 + 0.12, -9, -2, PAINT, M.SmoothPlastic)
	end
	-- bâtiment des sanitaires (toit monopente, bardage bois)
	local B = F * CFrame.new(-W / 2 + 10, 0.25, D / 2 - 7)
	Box(m, "RestHut", B, -7, 7, 0, 9, -4.5, 4.5, rgb(186, 150, 110), M.WoodPlanks, true)
	Wedge(m, "RestRoof", Vector3.new(16, 1.6, 11), B * CFrame.new(0, 9.8, 0) * CFrame.Angles(0, math.pi / 2, 0), rgb(70, 74, 84), M.Metal)
	for i, lbl in ipairs({ "WC", "♿", "🚿" }) do
		local x = -4.5 + (i - 1) * 4.5
		Box(m, "RestDoor", B, x - 1.2, x + 1.2, 0, 7.2, -4.62, -4.5, rgb(40, 90, 140), M.SmoothPlastic)
		local plate = Box(m, "RestPlate", B, x - 0.6, x + 0.6, 7.5, 8.5, -4.68, -4.62, WHITE, M.SmoothPlastic)
		Text(plate, Enum.NormalId.Front, lbl, rgb(40, 90, 140), nil, Enum.Font.GothamBlack, 80, 40)
	end
	-- distributeur, poubelles de tri, tables de pique-nique
	local V = F * CFrame.new(0, 0.25, D / 2 - 4)
	Box(m, "Vending", V, -1.6, 1.6, 0, 6.2, -1.1, 1.1, rgb(200, 40, 60), M.SmoothPlastic, true)
	Glow(Box(m, "VendingGlass", V, -1.2, 0.5, 1.6, 5.6, -1.16, -1.1, rgb(220, 236, 246), M.Glass))
	for i = 0, 2 do
		local T = F * CFrame.new(6 + i * 7, 0.25, 8 + (i % 2) * 3) * CFrame.Angles(0, hash(seed, i) * 0.6 - 0.3, 0)
		local wood = rgb(160, 112, 70)
		Box(m, "PicnicTop", T, -3, 3, 2.2, 2.5, -1.2, 1.2, wood, M.WoodPlanks, true)
		for _, z in ipairs({ -2.1, 2.1 }) do
			Box(m, "PicnicSeat", T, -3, 3, 1.3, 1.55, z - 0.5, z + 0.5, wood, M.WoodPlanks, true)
		end
		for _, x in ipairs({ -2.3, 2.3 }) do
			Box(m, "PicnicLeg", T, x - 0.18, x + 0.18, 0, 2.2, -2.4, 2.4, wood:Lerp(Color3.new(0, 0, 0), 0.2), M.Wood)
		end
	end
	for i = 0, 2 do
		CityKit.Bin(m, F * CFrame.new(-4 + i * 1.8, 0.25, 4), ({ rgb(240, 200, 40), rgb(40, 120, 70), rgb(40, 90, 160) })[i + 1])
	end
	-- arbres
	local okG, Greenery = pcall(require, ReplicatedStorage.Shared.Greenery)
	if okG then
		for i = 0, 3 do
			local p = (F * CFrame.new(-W / 2 + 4 + i * 13, 0.25, D / 2 + 3)).Position
			pcall(Greenery.Tree, m, p, 14 + hash(seed, i) * 5, seed + i * 17, i % 2 == 0 and "Oak" or "Poplar", 1)
		end
	end
	-- panneau "Aire de ..."
	local S = F * CFrame.new(W / 2 - 4, 0.25, -2)
	Column(m, "RestSignPost", S, 0, 0, 0, 8, 0.4, GALVA, M.Metal, true)
	local sign = Box(m, "RestSign", S, -3, 3, 6, 9.4, -0.12, 0.12, SIGN_BLUE, M.SmoothPlastic)
	Text(sign, Enum.NormalId.Front, "🅿️ " .. Locale.T("Rest area"), WHITE, nil, Enum.Font.GothamBold, 220, 20)
end

----------------------------------------------------------------------
-- 🌉 Ponts (habillage du tablier du serveur) et marquages des rues
----------------------------------------------------------------------

-- tronçon de tablier (F au dessus du tablier, au milieu ; -Z le long) :
-- le serveur pose la dalle (1,2 d'épaisseur, 26 de large), les parapets
-- (0,8 x 2,6) et les appuis ; ici : corniche en béton clair sous le bord,
-- garde-corps anti-jets (poteaux + grillage) sur les parapets, gouttes
-- d'eau, candélabres, et piles sous les rampes d'approche
local function buildBridge(m: Model, F: CFrame, seed: number, spot: any)
	local d = spot and spot.Data or {}
	local L = spot and spot.Size and spot.Size.Z or 20
	local half = (spot and spot.Size and spot.Size.X or 26) / 2
	local off = (d.Par == 1) and 0.02 or 0
	for _, sx in ipairs({ -1, 1 }) do
		-- corniche : bande claire à l'extérieur du tablier, plus bas que le dessus
		Box(m, "Fascia", F, sx * (half + 0.04), sx * (half + 0.64), -1.9 - off, 0.5 + off, -L / 2, L / 2, rgb(214, 210, 200), M.Concrete)
		Box(m, "FasciaDrip", F, sx * (half + 0.64), sx * (half + 0.8), -2.1 - off, -1.5 - off, -L / 2, L / 2, CONCRETE_D, M.Concrete)
		-- garde-corps anti-jets au-dessus du parapet (2,6)
		if (d.Elev or 0) > 3 then
			local n = math.max(1, math.floor(L / 4))
			for i = 0, n do
				local z = -L / 2 + i * L / n
				Box(m, "ScreenPost", F, sx * (half - 0.5) - 0.1, sx * (half - 0.5) + 0.1, 2.6, 6.2, z - 0.1, z + 0.1, GALVA_D, M.Metal)
			end
			local mesh = Box(m, "ScreenMesh", F, sx * (half - 0.5) - 0.03, sx * (half - 0.5) + 0.03, 2.7, 6.1, -L / 2, L / 2, GALVA, M.DiamondPlate, true)
			mesh.Transparency = 0.6
			Box(m, "ScreenTop", F, sx * (half - 0.5) - 0.08, sx * (half - 0.5) + 0.08, 6.1, 6.3, -L / 2, L / 2, GALVA_D, M.Metal)
		end
		if d.Lamp then
			local P = F * CFrame.new(sx * (half - 1.6), 0, 0) * CFrame.Angles(0, sx > 0 and math.pi / 2 or -math.pi / 2, 0)
			CityKit.StreetLamp(m, P, 12, GALVA_D)
		end
	end
	-- pile sous une rampe d'approche (le sol est d.Ground, monde)
	if d.Pier then
		local groundDy = (d.Ground or (F.Position.Y - (d.Elev or 0))) - F.Position.Y
		local capTop = -1.25
		Box(m, "PierCap", F, -half + 2, half - 2, capTop - 1.6, capTop, -1.4, 1.4, CONCRETE_D, M.Concrete, true)
		for _, x in ipairs({ -half * 0.5, half * 0.5 }) do
			if capTop - 1.6 - groundDy > 0.5 then
				Column(m, "PierShaft", F, x, 0, groundDy, capTop - 1.6, 2.4, CONCRETE, M.Concrete, true)
				Box(m, "PierFooting", F, x - 2, x + 2, groundDy - 0.3, groundDy + 0.4, -2, 2, CONCRETE_D, M.Concrete, true)
			end
		end
	end
	local _ = seed
end

-- marquages d'un tronçon de rue (F au milieu, sur la chaussée ; -Z = sens
-- +s de l'arête) : ligne médiane en tirets (double sens), lignes de rive,
-- lignes d'arrêt avant les carrefours ; rien dans les carrefours
local function buildRoadMarks(m: Model, F: CFrame, _seed: number, spot: any)
	local d = spot and spot.Data or {}
	local L = spot and spot.Size and spot.Size.Z or 40
	local W = d.Width or 20
	local S = d.S or 0 -- abscisse du début du tronçon
	local a, b = d.ClearA or 0, (d.Len or L) - (d.ClearB or 0)
	local s0, s1 = math.max(S, a), math.min(S + L, b)
	local top = d.Top or 0
	local function z(s: number): number
		return L / 2 - (s - S)
	end
	if s1 - s0 > 0.5 then
		-- lignes de rive (continues)
		for _, sx in ipairs({ -1, 1 }) do
			line(m, F, sx * (W / 2 - 0.9), z(s1), z(s0), 0.45, top)
		end
		if not d.OneWay then
			local dash, gap = d.Dash or 6, d.Gap or 8
			local period = dash + gap
			local s = s0 - ((s0 - a) % period)
			while s < s1 do
				local p0, p1 = math.max(s, s0), math.min(s + dash, s1)
				if p1 - p0 > 0.3 then
					line(m, F, 0, z(p1), z(p0), 0.45, top)
				end
				s += period
			end
		end
	end
	-- lignes d'arrêt (sens +s : moitié droite, +X ; sens -s : moitié gauche)
	-- (de x = 0,45 à W/2 - 1,25 : ne touche ni la médiane ni la rive)
	local sw = W / 2 - 1.7
	local sc = 0.45 + sw / 2
	if d.StopB and b >= S and b <= S + L then
		line(m, F, sc, z(b) + 0.5, z(b) + 1.3, sw, top)
	end
	if d.StopA and not d.OneWay and a >= S and a <= S + L then
		line(m, F, -sc, z(a) - 1.3, z(a) - 0.5, sw, top)
	end
end

----------------------------------------------------------------------
-- Imposteurs (loin) : quelques pièces
----------------------------------------------------------------------

local function impSeg(m: Model, F: CFrame, _seed: number, spot: any)
	local d = spot and spot.Data or {}
	local L = spot and spot.Size and spot.Size.Z or 40
	local W = TownHighway.Width(d)
	local top = (d.Par == 1) and 0.03 or 0
	local elev = (d.Elev or 0) > 3
	local extra = d.Overlap or 0
	if d.Deck ~= false then
		Box(m, "ImpAsphalt", F, -W / 2, W / 2, top - (elev and 2.2 or 0.6), top, -L / 2 - extra, L / 2 + extra, ASPHALT, M.Asphalt, true)
	end
	if not d.Oneway then
		Box(m, "ImpJersey", F, -0.9, 0.9, top, top + 2.8, -L / 2 - extra, L / 2 + extra, CONCRETE, M.Concrete, true)
	end
	if elev then
		for _, sx in ipairs({ -1, 1 }) do
			Box(m, "ImpParapet", F, sx * W / 2 - 1.2, sx * W / 2, top, top + 3.2, -L / 2, L / 2, CONCRETE, M.Concrete, true)
		end
		if d.Pier ~= false then
			local groundDy = (d.Ground or (F.Position.Y - (d.Elev or 0))) - F.Position.Y
			Box(m, "ImpPier", F, -W * 0.3, W * 0.3, groundDy, top - 2.2, -1.7, 1.7, CONCRETE_D, M.Concrete, true)
		end
	end
end

local function impWall(m: Model, F: CFrame, seed: number, spot: any)
	local L = spot and spot.Size and spot.Size.X or 40
	local palette = { rgb(92, 128, 108), rgb(124, 110, 92), rgb(96, 112, 134) }
	Box(m, "ImpWall", F, -L / 2, L / 2, -0.4, 11.3, -0.4, 0.4, palette[1 + math.floor(hash(seed, 2) * #palette) % #palette], M.Fabric, true)
end

TownHighway.BUILDERS = {
	HwySeg = buildSeg,
	HwyRamp = buildRamp,
	HwyLamp = buildLamp,
	HwyGantry = buildGantry,
	HwyWall = buildWall,
	HwyExit = buildExit,
	HwySign = buildSign,
	HwyRest = buildRest,
	BridgeSeg = buildBridge,
	RoadMarks = buildRoadMarks,
}
TownHighway.BIG = { HwySeg = true, HwyRamp = true, HwyGantry = true, HwyWall = true, HwyLamp = true, HwyRest = true, BridgeSeg = true }
TownHighway.IMPOSTORS = {
	HwySeg = impSeg,
	HwyRamp = function(m: Model, F: CFrame, seed: number, spot: any)
		local d = table.clone(spot and spot.Data or {})
		d.Oneway = true
		d.Lanes = d.Lanes or 1
		d.ShR = d.ShR or 3
		impSeg(m, F, seed, { Size = spot and spot.Size, Data = d })
	end,
	HwyWall = impWall,
}

return TownHighway
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="238">
          <Properties>
            <string name="Name">TownHud</string>
            <string name="Source"><![CDATA[--[[
	TownHud (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > TownHud

	🚶 Dopamine Town : l'interface compacte pendant la promenade (le clicker
	est masqué). ScreenGui "TownHud" dans la zone sûre (CoreUISafeInsets :
	jamais sous les boutons Roblox ni l'encoche), mise à l'échelle comme le
	jeu (PC / tablette / téléphone ; boutons tactiles >= 44 px) :
	  - en haut à gauche : "⬅ Clicker" (retour au jeu) ;
	  - en haut au milieu : compteur de Dopamine (+ par seconde), bandeau de
	    la maison où l'on est (propriétaire, ❤️, 👀, accès : le propriétaire
	    le change d'un appui : Tout le monde -> Amis -> Personne) ;
	  - en haut à droite : "🏠 Ma maison", "👥 Visiter" ;
	  - colonne à droite (au-dessus du bouton "sauter" des mobiles) : 👆 clic
	    (gagne comme le gros bouton), 😀 émotes (roue : salut, danse, youpi,
	    assis, montrer), ✏️ déplacer les meubles (dans SA maison), ❤️ j'aime
	    (maison d'un autre) ;
	  - barre d'édition (en bas) : 🔄 tourner (R), 🧲 grille, 📦 ranger,
	    ✅ poser, ❌ annuler ;
	  - fenêtre "👥 Visiter" : joueurs du serveur, leur maison, ❤️, accès ;
	  - petits messages (toasts) et écran de chargement de la ville.
	v9.4 (ENTRY94) :
	  - "🏠 Rentrer" (téléportation devant sa porte) + 🧭 boussole sous
	    "Retour" (flèche vers sa maison + distance, un appui = Rentrer) ;
	  - pastille d'action en bas au milieu (entre le joystick et "sauter"
	    sur mobile) : "■ Arrêter" pendant une émote, "Se lever" assis ;
	  - voile plein écran à part (ScreenGui "TownOverlay", sous les
	    encoches aussi, reste actif quand le HUD est masqué) : écran de
	    chargement (ciel, silhouette de la ville, barre, astuces), bandes
	    cinéma + titre + "Passer" du survol d'arrivée, fondus d'entrée /
	    de sortie ;
	  - liste des visites plus claire (anneau vert = en ville, pastilles).
	Aucune logique de jeu ici : tout passe par les rappels (callbacks).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Client = script.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local ClientState = require(Client.ClientState)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Config = require(ReplicatedStorage.Shared.Config)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local WorldLayout = require(ReplicatedStorage.Shared.WorldLayout)

local TownHud = {}
TownHud.__index = TownHud

local PINK = Color3.fromRGB(255, 110, 170)
local PINK_DEEP = Color3.fromRGB(236, 72, 140)
local LILAC = Color3.fromRGB(170, 140, 245)
local MINT = Color3.fromRGB(80, 200, 160)
local SKY = Color3.fromRGB(96, 170, 245)
local INK = Color3.fromRGB(92, 58, 96)
local CARD = Color3.fromRGB(255, 250, 253)
local WHITE = Color3.new(1, 1, 1)

export type Callbacks = {
	Back: () -> (),
	Home: () -> (),
	OpenVisit: () -> (),
	Visit: (userId: number) -> (),
	Emote: (name: string) -> (),
	ToggleEdit: () -> (),
	Rotate: () -> (),
	Snap: () -> (),
	PutAway: () -> (),
	Drop: () -> (),
	Cancel: () -> (),
	Like: () -> (),
	Click: () -> number?,
	CycleOpen: () -> (),
	StopEmote: () -> (),
	GetUp: () -> (),
	SkipIntro: () -> (),
}

export type Context = {
	Snapshot: any?, -- maison où l'on est (ou devant laquelle on est)
	IsOwner: boolean,
	Locked: boolean,
	InHouse: boolean,
}

local EMOTES = {
	{ Id = "wave", Icon = "👋", Text = "Wave" },
	{ Id = "dance", Icon = "💃", Text = "Dance" },
	{ Id = "cheer", Icon = "🎉", Text = "Cheer" },
	{ Id = "sit", Icon = "🪑", Text = "Sit" },
	{ Id = "point", Icon = "👉", Text = "Point" },
}

local OPEN_TEXT = {
	Everyone = "🔓 Open to everyone",
	Friends = "👥 Friends only",
	Nobody = "🔒 Closed",
}

----------------------------------------------------------------------
-- Petits constructeurs
----------------------------------------------------------------------

local TextService = game:GetService("TextService")

-- Largeur d'un texte (px) : les tailles sont calculées, pas "automatiques"
local function textWidth(text: string, size: number, font: Enum.Font?): number
	local ok, bounds = pcall(function()
		return TextService:GetTextSize(text, size, font or Theme.Fonts.Title, Vector2.new(4000, 200))
	end)
	if ok and typeof(bounds) == "Vector2" then
		return bounds.X
	end
	local length = utf8.len(text) or #text
	return length * size * 0.55
end

local function label(props: { [string]: any }): TextLabel
	local l = UIUtil.Create("TextLabel", {
		BackgroundTransparency = 1,
		Font = props.Font or Theme.Fonts.Title,
		TextColor3 = props.Color or INK,
		TextSize = props.TextSize or 18,
		TextXAlignment = props.XAlign or Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
		Text = props.Text or "",
		Size = props.Size or UDim2.fromScale(1, 1),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		AutomaticSize = props.AutomaticSize or Enum.AutomaticSize.None,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = props.ZIndex or 2,
		Name = props.Name or "Label",
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	})
	return l
end

local function roundButton(parent: Instance, name: string, icon: string, color: Color3, diameter: number, order: number): TextButton
	local button = UIUtil.PillButton({
		Name = name,
		Text = icon,
		Color = color,
		Height = diameter,
		Round = true,
		TextSize = math.floor(diameter * 0.46),
		LayoutOrder = order,
		Parent = parent,
	})
	return button
end

----------------------------------------------------------------------

function TownHud.new(callbacks: Callbacks)
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local old = playerGui:FindFirstChild("TownHud")
	if old then
		old:Destroy()
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "TownHud"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 20
	gui.Enabled = false
	gui.Parent = playerGui

	local root = UIUtil.Create("Frame", {
		Name = "Root",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(1100, 620),
		Parent = gui,
	})
	local scale = UIUtil.Create("UIScale", { Parent = root })

	local self = setmetatable({
		Gui = gui,
		Root = root,
		Scale = scale,
		Callbacks = callbacks,
		Phone = false,
		Toasts = {} :: { Frame },
		ToastCount = 0,
		Context = nil :: Context?,
		Editing = false,
		Holding = false,
		Snap = true,
		EmoteOpen = false,
		Parts = {} :: { [string]: any },
	}, TownHud)
	self:Build()
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:Layout()
	end)
	self:Layout()
	return self
end

function TownHud.Build(self: any)
	local root: Frame = self.Root
	local cb: Callbacks = self.Callbacks
	local parts = self.Parts

	-- ⬅ retour au clicker (flèche dessinée à gauche, texte à droite)
	local back = UIUtil.PillButton({
		Name = "BackToClicker",
		Text = Locale.T("Back to clicker"),
		Color = WHITE,
		TextColor3 = INK,
		Height = 46,
		TextSize = 19,
		Parent = root,
	})
	back.AutomaticSize = Enum.AutomaticSize.None
	back.TextXAlignment = Enum.TextXAlignment.Right
	back.Position = UDim2.fromOffset(10, 8)
	local backPad = back:FindFirstChildOfClass("UIPadding")
	if backPad then
		backPad.PaddingLeft = UDim.new(0, 44)
		backPad.PaddingRight = UDim.new(0, 16)
	end
	UIUtil.Icon("ArrowLeft", { Size = 20, Thickness = 3, Color = PINK_DEEP, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, -22, 0.5, 0), ZIndex = 4, Parent = back })
	back.Activated:Connect(function()
		cb.Back()
	end)
	parts.Back = back

	-- Compteur de Dopamine
	local counter = UIUtil.Create("Frame", {
		Name = "Counter",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(260, 58),
		BackgroundColor3 = CARD,
		Parent = root,
	})
	UIUtil.Corner(counter, 18)
	UIUtil.Stroke(counter, PINK, 2, 0.2)
	UIUtil.Shadow(counter, 3, 0.8)
	UIUtil.Gradient(counter, ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 226, 240)), 90)
	parts.Amount = label({ Name = "Amount", Text = "0", Color = PINK_DEEP, TextSize = 30, Font = Theme.Fonts.Number, Size = UDim2.new(1, -20, 0, 34),
		Position = UDim2.fromOffset(10, 3), Parent = counter })
	parts.Rate = label({ Name = "Rate", Text = "", Color = INK, TextSize = 15, Font = Theme.Fonts.Body, Size = UDim2.new(1, -20, 0, 18),
		Position = UDim2.fromOffset(10, 36), Parent = counter })
	parts.Counter = counter

	-- Bandeau de la maison
	local banner = UIUtil.Create("Frame", {
		Name = "HouseBanner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 72),
		Size = UDim2.fromOffset(300, 34),
		BackgroundColor3 = Color3.fromRGB(92, 58, 120),
		BackgroundTransparency = 0.12,
		Visible = false,
		Parent = root,
	})
	UIUtil.Corner(banner, UDim.new(1, 0))
	UIUtil.Create("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 6), Parent = banner })
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = banner,
	})
	parts.BannerText = label({ Name = "Text", Text = "", Color = WHITE, TextSize = 17, Size = UDim2.fromOffset(200, 34), LayoutOrder = 1, Parent = banner })
	local openButton = UIUtil.PillButton({ Name = "OpenMode", Text = "", Color = MINT, Height = 26, TextSize = 14, LayoutOrder = 2, Parent = banner })
	openButton.AutomaticSize = Enum.AutomaticSize.None
	openButton.Activated:Connect(function()
		cb.CycleOpen()
	end)
	parts.OpenButton = openButton
	parts.Banner = banner

	-- En haut à droite : ma maison, visiter
	local topRight = UIUtil.Create("Frame", {
		Name = "TopRight",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 8),
		Size = UDim2.fromOffset(0, 50),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		Parent = root,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Top,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = topRight,
	})
	local home = UIUtil.PillButton({ Name = "MyHouse", Text = Locale.T("🏠 Go home"), Color = PINK, Height = 46, TextSize = 19, LayoutOrder = 1, Parent = topRight })
	home.Activated:Connect(function()
		cb.Home()
	end)
	local visit = UIUtil.PillButton({ Name = "VisitButton", Text = Locale.T("👥 Visit…"), Color = LILAC, Height = 46, TextSize = 19, LayoutOrder = 2, Parent = topRight })
	visit.Activated:Connect(function()
		cb.OpenVisit()
	end)
	-- v9.8 🎨 Graphismes / mode réaliste (REALISM98) : fenêtre en ville
	local gfxButton = roundButton(topRight, "GraphicsButton", "⚙️", WHITE, 46, 3)
	gfxButton.Activated:Connect(function()
		local module = script.Parent:FindFirstChild("TownGraphics")
		if module then
			local ok, TownGraphics = pcall(require, module)
			if ok and type(TownGraphics) == "table" and type(TownGraphics.Toggle) == "function" then
				TownGraphics.Toggle()
			end
		end
	end)
	parts.GraphicsButton = gfxButton
	parts.Home = home
	parts.VisitButton = visit
	parts.TopRight = topRight

	-- Colonne de droite
	local column = UIUtil.Create("Frame", {
		Name = "Actions",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.46, 0),
		Size = UDim2.fromOffset(76, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = root,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 24),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = column,
	})
	local click = roundButton(column, "TownClick", "👆", PINK_DEEP, 70, 1)
	click.Activated:Connect(function()
		local gain = cb.Click()
		if gain and gain > 0 then
			self:Pop(click, "+" .. NumberFormatter.Format(gain))
		end
	end)
	local emote = roundButton(column, "Emotes", "😀", Color3.fromRGB(255, 196, 70), 56, 2)
	emote.Activated:Connect(function()
		self:SetEmoteWheel(not self.EmoteOpen)
	end)
	local edit = roundButton(column, "EditFurniture", "✏️", SKY, 56, 3)
	edit.Visible = false
	edit.Activated:Connect(function()
		cb.ToggleEdit()
	end)
	local like = roundButton(column, "LikeHouse", "❤️", Color3.fromRGB(255, 90, 120), 56, 4)
	like.Visible = false
	like.Activated:Connect(function()
		cb.Like()
	end)
	parts.Column = column
	parts.Click = click
	parts.Emote = emote
	parts.Edit = edit
	parts.Like = like
	-- petites étiquettes sous les boutons (PC / tablette)
	for _, spec in ipairs({ { click, "Click" }, { emote, "Emotes" }, { edit, "Move furniture" }, { like, "Like" } }) do
		local tag = label({ Name = "Tag", Text = Locale.T(spec[2]), Color = WHITE, TextSize = 13, Size = UDim2.fromOffset(110, 16),
			AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 1, 1), ZIndex = 5, Parent = spec[1] })
		UIUtil.Create("UIStroke", { Color = INK, Thickness = 1.5, Transparency = 0.2, Parent = tag })
	end

	-- Roue des émotes (à gauche du bouton)
	local wheel = UIUtil.Create("Frame", {
		Name = "EmoteWheel",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(0, -10, 0.5, 0),
		Size = UDim2.fromOffset(#EMOTES * 54 + 10, 60),
		BackgroundColor3 = CARD,
		Visible = false,
		ZIndex = 6,
		Parent = emote,
	})
	UIUtil.Corner(wheel, UDim.new(1, 0))
	UIUtil.Stroke(wheel, Color3.fromRGB(255, 196, 70), 2, 0.1)
	-- (le "puits à clics" reste HORS de la rangée : une UIListLayout le placerait comme un bouton)
	UIUtil.SinkClicks(wheel)
	local wheelRow = UIUtil.Create("Frame", { Name = "Row", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 6, Parent = wheel })
	UIUtil.Create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = wheelRow })
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = wheelRow,
	})
	for index, spec in ipairs(EMOTES) do
		local b = UIUtil.PillButton({ Name = "Emote_" .. spec.Id, Text = spec.Icon, Color = Color3.fromRGB(255, 240, 200), Height = 48, Round = true,
			TextSize = 24, LayoutOrder = index, ZIndex = 7, Parent = wheelRow })
		local tag = label({ Name = "Tag", Text = Locale.T(spec.Text), Color = INK, TextSize = 11, Size = UDim2.fromOffset(60, 12),
			AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 2), ZIndex = 9, Parent = b })
		tag.Font = Theme.Fonts.Title
		b.Activated:Connect(function()
			self:SetEmoteWheel(false)
			cb.Emote(spec.Id)
		end)
	end
	parts.Wheel = wheel

	-- Barre d'édition des meubles
	local editBar = UIUtil.Create("Frame", {
		Name = "EditBar",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Size = UDim2.fromOffset(600, 64),
		BackgroundColor3 = CARD,
		Visible = false,
		Parent = root,
	})
	UIUtil.Corner(editBar, 22)
	UIUtil.Stroke(editBar, SKY, 2, 0.1)
	UIUtil.Shadow(editBar, 3, 0.8)
	UIUtil.SinkClicks(editBar)
	local editRow = UIUtil.Create("Frame", { Name = "Row", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = editBar })
	UIUtil.Create("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), Parent = editRow })
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = editRow,
	})
	parts.EditHint = label({ Name = "Hint", Text = "", Color = INK, TextSize = 17, Size = UDim2.fromOffset(240, 60), LayoutOrder = 0, Parent = editRow })
	parts.EditHint.TextWrapped = true
	parts.EditHint.TextTruncate = Enum.TextTruncate.None
	local function editButton(name: string, text: string, color: Color3, order: number, fn: () -> ()): TextButton
		local b = UIUtil.PillButton({ Name = name, Text = text, Color = color, Height = 44, TextSize = 17, LayoutOrder = order, Parent = editRow })
		b.AutomaticSize = Enum.AutomaticSize.None
		b.Size = UDim2.fromOffset(textWidth(text, 17) + 36, 44)
		b.Activated:Connect(fn)
		return b
	end
	parts.Rotate = editButton("Rotate", Locale.T("🔄 Rotate"), LILAC, 1, cb.Rotate)
	parts.SnapButton = editButton("Snap", "", Color3.fromRGB(255, 200, 90), 2, cb.Snap)
	parts.PutAway = editButton("PutAway", Locale.T("📦 Put away"), Color3.fromRGB(255, 150, 120), 3, cb.PutAway)
	parts.Drop = editButton("Drop", Locale.T("✅ Drop"), MINT, 4, cb.Drop)
	parts.CancelMove = editButton("CancelMove", Locale.T("❌ Cancel"), Color3.fromRGB(236, 236, 244), 5, cb.Cancel)
	parts.Done = editButton("DoneEditing", Locale.T("✅ Done"), MINT, 6, cb.ToggleEdit)
	parts.EditBar = editBar

	-- Toasts
	local toasts = UIUtil.Create("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 114),
		Size = UDim2.fromOffset(660, 140),
		BackgroundTransparency = 1,
		Parent = root,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = toasts,
	})
	parts.ToastHolder = toasts

	-- Fenêtre "Visiter"
	local dimmer = UIUtil.Create("TextButton", {
		Name = "VisitDimmer",
		Size = UDim2.new(1, 400, 1, 400),
		Position = UDim2.fromOffset(-200, -200),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		AutoButtonColor = false,
		Text = "",
		Visible = false,
		ZIndex = 20,
		Parent = root,
	})
	dimmer.Activated:Connect(function()
		self:CloseVisit()
	end)
	local card = UIUtil.Create("Frame", {
		Name = "VisitCard",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(520, 440),
		BackgroundColor3 = CARD,
		ZIndex = 21,
		Visible = false,
		Parent = root,
	})
	UIUtil.Corner(card, 24)
	UIUtil.Stroke(card, LILAC, 2.5, 0)
	UIUtil.SinkClicks(card)
	UIUtil.Gradient(card, ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(246, 236, 255)), 90)
	label({ Name = "Title", Text = Locale.T("👥 Visit a house"), Color = PINK_DEEP, TextSize = 26, Size = UDim2.new(1, -80, 0, 40),
		Position = UDim2.fromOffset(20, 12), XAlign = Enum.TextXAlignment.Left, ZIndex = 22, Parent = card })
	local count = label({ Name = "Count", Text = "", Color = WHITE, TextSize = 14, Size = UDim2.fromOffset(80, 24), AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -62, 0, 20), ZIndex = 22, Parent = card })
	count.BackgroundColor3 = LILAC
	count.BackgroundTransparency = 0
	UIUtil.Corner(count, UDim.new(1, 0))
	parts.VisitCount = count
	parts.VisitSub = label({ Name = "Subtitle", Text = Locale.T("Walk to their door, sit on their sofa and leave a ❤️"), Color = INK, TextSize = 15,
		Font = Theme.Fonts.Body, Size = UDim2.new(1, -80, 0, 20), Position = UDim2.fromOffset(20, 50), XAlign = Enum.TextXAlignment.Left, ZIndex = 22, Parent = card })
	local close = UIUtil.CloseButton({ Name = "CloseVisit", Size = 40, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 12), ZIndex = 23 })
	close.Parent = card
	close.Activated:Connect(function()
		self:CloseVisit()
	end)
	local list = UIUtil.Create("ScrollingFrame", {
		Name = "List",
		Position = UDim2.fromOffset(14, 80),
		Size = UDim2.new(1, -28, 1, -94),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = LILAC,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ZIndex = 22,
		Parent = card,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = list,
	})
	UIUtil.Create("UIPadding", { PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 2), Parent = list })
	parts.VisitDimmer = dimmer
	parts.VisitCard = card
	parts.VisitList = list

	-- 🧭 Boussole vers sa maison (sous "Retour") : flèche qui tourne + distance ;
	-- un appui = "Rentrer" (téléportation devant sa porte). v9.6 : PETITE et
	-- discrète (plus aucune ligne / arc dans le monde vers la maison)
	local compass = UIUtil.Create("TextButton", {
		Name = "HomeCompass",
		Position = UDim2.fromOffset(10, 62),
		Size = UDim2.fromOffset(96, 32),
		BackgroundColor3 = Color3.fromRGB(92, 58, 120),
		BackgroundTransparency = 0.4,
		AutoButtonColor = false,
		Text = "",
		Visible = false,
		Parent = root,
	})
	UIUtil.Corner(compass, UDim.new(1, 0))
	UIUtil.Stroke(compass, WHITE, 1, 0.6)
	local dial = UIUtil.Create("Frame", {
		Name = "Dial",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 4, 0.5, 0),
		Size = UDim2.fromOffset(24, 24),
		BackgroundColor3 = WHITE,
		Parent = compass,
	})
	UIUtil.Corner(dial, UDim.new(1, 0))
	UIUtil.Stroke(dial, PINK, 1, 0)
	-- (flèche en traits : pas de ClipsDescendants, elle peut tourner)
	local needle = UIUtil.Create("Frame", { Name = "Needle", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 1, ZIndex = 3, Parent = dial })
	local function bar(x1: number, y1: number, x2: number, y2: number)
		local dx, dy = x2 - x1, y2 - y1
		local b = UIUtil.Create("Frame", {
			Name = "Bar",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2),
			Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy) + 3, 3),
			Rotation = math.deg(math.atan2(dy, dx)),
			BackgroundColor3 = PINK_DEEP,
			BorderSizePixel = 0,
			ZIndex = 3,
			Parent = needle,
		})
		UIUtil.Corner(b, UDim.new(1, 0))
	end
	bar(10, 3, 10, 17)
	bar(10, 3, 5, 8)
	bar(10, 3, 15, 8)
	parts.CompassText = label({ Name = "Text", Text = "", Color = WHITE, TextSize = 14, Size = UDim2.new(1, -38, 1, 0), Position = UDim2.fromOffset(32, 0),
		XAlign = Enum.TextXAlignment.Left, Parent = compass })
	compass.Activated:Connect(function()
		cb.Home()
	end)
	parts.Compass = compass
	parts.Needle = needle

	-- Pastille d'action en bas au milieu (entre joystick et "sauter" sur
	-- mobile) : "■ Arrêter" pendant une émote, "Se lever" quand on est assis
	local action = UIUtil.PillButton({ Name = "StopEmote", Text = "", Color = Color3.fromRGB(255, 92, 120), Height = 50, TextSize = 20, Parent = root })
	action.AutomaticSize = Enum.AutomaticSize.None
	action.AnchorPoint = Vector2.new(0.5, 1)
	action.Position = UDim2.new(0.5, 0, 1, -18)
	action.Visible = false
	action.TextXAlignment = Enum.TextXAlignment.Right
	local actionPad = action:FindFirstChildOfClass("UIPadding")
	if actionPad then
		actionPad.PaddingLeft = UDim.new(0, 50)
		actionPad.PaddingRight = UDim.new(0, 20)
	end
	-- icône : carré "stop" ou flèche "se lever"
	local stopIcon = UIUtil.Create("Frame", { Name = "StopIcon", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, -26, 0.5, 0),
		Size = UDim2.fromOffset(16, 16), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 4, Parent = action })
	UIUtil.Corner(stopIcon, 3)
	local upIcon = UIUtil.Icon("Up", { Size = 20, Color = WHITE, Position = UDim2.new(0, -26, 0.5, 0), ZIndex = 4, Parent = action })
	upIcon.Name = "UpIcon"
	action.Activated:Connect(function()
		if self.ActionState == "Sit" then
			cb.GetUp()
		else
			cb.StopEmote()
		end
	end)
	parts.Action = action
	parts.StopIcon = stopIcon
	parts.UpIcon = upIcon
	self.ActionState = nil

	-- Écran de chargement (plein écran, sous les encoches aussi)
	self:BuildOverlay()

	self:SetSnap(true)
	self:SetEditing(false, false)
end

----------------------------------------------------------------------
-- Mise en page (échelle, téléphone)
----------------------------------------------------------------------

function TownHud.Layout(self: any)
	local size = self.Gui.AbsoluteSize
	if size.X < 10 or size.Y < 10 then
		return
	end
	local touch = UserInputService.TouchEnabled and not UserInputService.MouseEnabled
	local phone = touch and math.min(size.X, size.Y) < 500
	self.Phone = phone
	-- (téléphone : toile de 820 x 430 -> tout est plus gros ; PC : 1100 x 620)
	local designW, designH = phone and 820 or 1100, phone and 430 or 620
	local scale = math.clamp(math.min(size.X / designW, size.Y / designH), 0.45, 1.35)
	self.Scale.Scale = scale
	self.Root.Size = UDim2.fromOffset(size.X / scale, size.Y / scale)
	local parts = self.Parts
	local backText = phone and Locale.T("Clicker") or Locale.T("Back to clicker")
	parts.Back.Text = backText
	parts.Back.Size = UDim2.fromOffset(textWidth(backText, 19) + 64, 46)
	for _, spec in ipairs({ { parts.Home, phone and "🏠" or Locale.T("🏠 Go home") }, { parts.VisitButton, phone and "👥" or Locale.T("👥 Visit…") } }) do
		local button, text = spec[1], spec[2]
		button.Text = text
		button.AutomaticSize = Enum.AutomaticSize.None
		local padding = button:FindFirstChildOfClass("UIPadding")
		local pad = phone and 12 or 18
		if padding then
			padding.PaddingLeft = UDim.new(0, pad)
			padding.PaddingRight = UDim.new(0, pad)
		end
		button.Size = UDim2.fromOffset(phone and 52 or textWidth(text, 19) + pad * 2 + 6, phone and 52 or 46)
	end
	-- v9.8 🎨 bouton Graphismes (REALISM98) : toujours visible, même taille que ses voisins
	local gfx = parts.GraphicsButton
	if gfx then
		local d = phone and 52 or 46
		gfx.AutomaticSize = Enum.AutomaticSize.None
		gfx.Size = UDim2.fromOffset(d, d)
		gfx.TextSize = math.floor(d * 0.46)
		gfx.Visible = true
	end
	parts.Counter.Size = UDim2.fromOffset(phone and 220 or 260, 58)
	-- téléphone : colonne compacte sous les boutons du haut (le bouton
	-- "sauter" de Roblox est en bas à droite, plus à gauche que la colonne)
	if phone then
		parts.Column.AnchorPoint = Vector2.new(1, 0)
		parts.Column.Position = UDim2.new(1, -8, 0, 66)
	else
		parts.Column.AnchorPoint = Vector2.new(1, 0.5)
		parts.Column.Position = UDim2.new(1, -12, 0.46, 0)
	end
	local layout = parts.Column:FindFirstChildOfClass("UIListLayout")
	if layout then
		layout.Padding = UDim.new(0, phone and 16 or 24)
	end
	for _, spec in ipairs({ { parts.Click, 70, 58 }, { parts.Emote, 56, 46 }, { parts.Edit, 56, 46 }, { parts.Like, 56, 46 } }) do
		local d = phone and spec[3] or spec[2]
		spec[1].Size = UDim2.fromOffset(d, d)
		spec[1].TextSize = math.floor(d * 0.46)
		local tag = spec[1]:FindFirstChild("Tag")
		if tag then
			tag.Visible = not phone
		end
	end
	-- voile plein écran (chargement, survol) : même échelle que le reste
	local overlay = self.Overlay
	local full = overlay and overlay.AbsoluteSize or size
	if full.X < 10 or full.Y < 10 then
		full = size
	end
	local overlayScale = math.clamp(math.min(full.X / 860, full.Y / 520), 0.45, 1.3)
	parts.LoadingScale.Scale = overlayScale
	parts.CinemaScale.Scale = overlayScale
	-- bandes cinéma : 11 % de l'écran, jamais moins de 56 px (bouton "Passer" dedans)
	local barH = math.max(math.floor(full.Y * 0.11), 56)
	parts.TopBar.Size = UDim2.new(1, 0, 0, barH)
	parts.BottomBar.Size = UDim2.new(1, 0, 0, barH)
	parts.Skip.Position = UDim2.new(1, phone and -64 or -40, 0, barH / 2)
	parts.SkipScale.Scale = math.clamp(overlayScale, 0.8, 1.2)
	local card = parts.VisitCard
	local rootSize = Vector2.new(size.X / scale, size.Y / scale)
	card.Size = UDim2.fromOffset(math.min(520, rootSize.X - 30), math.min(440, rootSize.Y - 30))
end

----------------------------------------------------------------------
-- Mises à jour
----------------------------------------------------------------------

function TownHud.SetVisible(self: any, visible: boolean)
	self.Gui.Enabled = visible
	if not visible then
		self:CloseVisit()
		self:SetEmoteWheel(false)
		self:SetCinematic(false)
		self:SetAction(nil)
		self:SetCompass(false)
	end
end

-- Compteur (appelé ~10 fois par seconde)
function TownHud.UpdateCounter(self: any)
	local data = ClientState.Data
	local value = ClientState.GetDisplayDopamine()
	if value <= 0 then
		value = ClientState.GetTargetDopamine()
	end
	self.Parts.Amount.Text = "🧠 " .. NumberFormatter.Format(value)
	local rate = data and tonumber(data.PerSecond) or 0
	self.Parts.Rate.Text = Locale.T("+%s / sec", NumberFormatter.Format(rate))
end

function TownHud.SetContext(self: any, context: Context?)
	self.Context = context
	local parts = self.Parts
	local snapshot = context and context.Snapshot
	parts.Banner.Visible = snapshot ~= nil and not self.DeskActive
	parts.Edit.Visible = context ~= nil and context.IsOwner and context.InHouse and not self.DeskActive
	parts.Like.Visible = snapshot ~= nil and not (context and context.IsOwner)
	if not snapshot or not context then
		return
	end
	local size = Config.HouseSizesById[snapshot.Size] or Config.House.Sizes[1]
	local name = tostring(snapshot.DisplayName or snapshot.Name or "?")
	local title = context.IsOwner and Locale.T("🏠 Your %s", Locale.T(size.Name)) or Locale.T("🏠 %s's %s", name, Locale.T(size.Name))
	local text = string.format("%s   ❤️ %s   👀 %s%s", title, NumberFormatter.Format(tonumber(snapshot.Likes) or 0),
		NumberFormatter.Format(tonumber(snapshot.Visits) or 0), context.Locked and ("   " .. Locale.T("🔒 Closed to you")) or "")
	parts.BannerText.Text = text
	local textW = math.min(textWidth(text, 17), self.Phone and 360 or 560)
	parts.BannerText.Size = UDim2.fromOffset(textW + 4, 34)
	local open = WorldLayout.NormalizeOpen(snapshot.Open)
	local openText = Locale.T(OPEN_TEXT[open])
	parts.OpenButton.Visible = context.IsOwner
	parts.OpenButton.Text = openText
	local openW = textWidth(openText, 14) + 28
	parts.OpenButton.Size = UDim2.fromOffset(openW, 26)
	parts.Banner.Size = UDim2.fromOffset(textW + 4 + 20 + (context.IsOwner and openW + 10 or 0), 34)
end

function TownHud.SetSnap(self: any, on: boolean)
	self.Snap = on
	local text = on and Locale.T("🧲 Grid: on") or Locale.T("🧲 Grid: off")
	local button = self.Parts.SnapButton
	button.Text = text
	button.Size = UDim2.fromOffset(textWidth(text, 17) + 36, 44)
end

-- Mode édition (barre du bas) : `holding` = un meuble est en main
function TownHud.SetEditing(self: any, editing: boolean, holding: boolean, itemName: string?)
	self.Editing = editing
	self.Holding = holding
	local parts = self.Parts
	parts.EditBar.Visible = editing
	parts.Edit.Text = editing and "✅" or "✏️"
	local touch = UserInputService.TouchEnabled and not UserInputService.MouseEnabled
	if holding then
		parts.EditHint.Text = (itemName and (itemName .. " · ") or "") .. (touch and Locale.T("drag to move") or Locale.T("move the mouse · R to rotate"))
	else
		parts.EditHint.Text = touch and Locale.T("✏️ Tap a piece of furniture to pick it up") or Locale.T("✏️ Click a piece of furniture to pick it up")
	end
	local width = 24 + (self.Phone and 0 or 248)
	parts.EditHint.Visible = not self.Phone
	for _, name in ipairs({ "Rotate", "SnapButton", "PutAway", "Drop", "CancelMove" }) do
		parts[name].Visible = holding
		if holding then
			width += parts[name].Size.X.Offset + 8
		end
	end
	parts.Done.Visible = not holding
	if not holding then
		width += parts.Done.Size.X.Offset + 8
		if self.Phone then
			-- (téléphone : l'indice passe dans la barre à la place des boutons)
			parts.EditHint.Visible = true
			width += 248
		end
	end
	parts.EditBar.Size = UDim2.fromOffset(width, 64)
	if parts.Action then
		self:PlaceAction()
	end
end

-- "+123" qui s'envole au-dessus d'un bouton
function TownHud.Pop(self: any, anchor: GuiObject, text: string)
	local pop = label({ Name = "Pop", Text = text, Color = PINK_DEEP, TextSize = 22, Size = UDim2.fromOffset(160, 26), AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, -40, 0, 0), ZIndex = 30, Parent = anchor })
	UIUtil.Create("UIStroke", { Color = WHITE, Thickness = 2, Parent = pop })
	local ok = pcall(function()
		TweenService:Create(pop, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = UDim2.new(0.5, -40, 0, -46),
			TextTransparency = 1,
		}):Play()
	end)
	task.delay(ok and 0.75 or 0.4, function()
		pop:Destroy()
	end)
end

function TownHud.Toast(self: any, text: string, color: Color3?)
	local parts = self.Parts
	local holder: Frame = parts.ToastHolder
	self.ToastCount += 1
	local width = math.min(textWidth(text, 18) + 40, 640)
	local toast = UIUtil.Create("Frame", {
		Name = "Toast",
		Size = UDim2.fromOffset(width, 40),
		BackgroundColor3 = color or Color3.fromRGB(92, 58, 120),
		BackgroundTransparency = 0.08,
		LayoutOrder = self.ToastCount,
		Parent = holder,
	})
	UIUtil.Corner(toast, UDim.new(1, 0))
	label({ Name = "Text", Text = text, Color = WHITE, TextSize = 18, Size = UDim2.new(1, -24, 1, 0), Position = UDim2.fromOffset(12, 0), Parent = toast })
	table.insert(self.Toasts, toast)
	while #self.Toasts > 3 do
		local oldest = table.remove(self.Toasts, 1)
		if oldest then
			oldest:Destroy()
		end
	end
	task.delay(3.6, function()
		local index = table.find(self.Toasts, toast)
		if index then
			table.remove(self.Toasts, index)
		end
		toast:Destroy()
	end)
end

function TownHud.SetEmoteWheel(self: any, open: boolean)
	self.EmoteOpen = open
	self.Parts.Wheel.Visible = open
end

----------------------------------------------------------------------
-- Voile plein écran : chargement, fondus, survol (ScreenGui à part,
-- sous les encoches aussi ; reste actif quand le HUD est masqué)
----------------------------------------------------------------------

local LOADING_TIPS = {
	"Tip: tap 🏠 Go home to jump to your front door",
	"Tip: tap 😀 to dance, wave or sit — walk or jump to stop",
	"Tip: leave a ❤️ at a friend's house: you both earn Dopamine",
	"Tip: sit on any sofa, chair or bench",
	"Tip: ✏️ moves your furniture inside your house",
	"Tip: your Dopamine keeps growing while you walk around",
}

local SKYLINE = { -- (x en échelle, largeur px, hauteur px, couleur)
	{ 0.03, 70, 90, 1 }, { 0.1, 56, 130, 2 }, { 0.17, 84, 70, 1 }, { 0.26, 60, 110, 2 }, { 0.33, 90, 84, 1 },
	{ 0.62, 80, 96, 1 }, { 0.7, 58, 140, 2 }, { 0.78, 92, 76, 1 }, { 0.87, 64, 118, 2 }, { 0.95, 78, 88, 1 },
}

function TownHud.BuildOverlay(self: any)
	local playerGui = self.Gui.Parent
	local old = playerGui and playerGui:FindFirstChild("TownOverlay")
	if old then
		old:Destroy()
	end
	local overlay = Instance.new("ScreenGui")
	overlay.Name = "TownOverlay"
	overlay.ResetOnSpawn = false
	overlay.IgnoreGuiInset = true
	overlay.ScreenInsets = Enum.ScreenInsets.None
	overlay.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	overlay.DisplayOrder = 45
	overlay.Enabled = true
	overlay.Parent = playerGui
	self.Overlay = overlay
	local parts = self.Parts

	-- Chargement : ciel rose -> lilas, soleil, silhouette de la ville
	local loading = UIUtil.Create("Frame", {
		Name = "Loading",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 40,
		Parent = overlay,
	})
	UIUtil.Gradient(loading, ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(176, 160, 255)),
		ColorSequenceKeypoint.new(0.55, Color3.fromRGB(255, 176, 214)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 222, 196)),
	}), 90)
	local sun = UIUtil.Create("Frame", { Name = "Sun", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.62),
		Size = UDim2.fromOffset(300, 300), BackgroundColor3 = Color3.fromRGB(255, 244, 214), BackgroundTransparency = 0.35, ZIndex = 41, Parent = loading })
	UIUtil.Corner(sun, UDim.new(1, 0))
	local halo = UIUtil.Create("Frame", { Name = "Halo", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1.5, 1.5), BackgroundColor3 = WHITE, BackgroundTransparency = 0.82, ZIndex = 41, Parent = sun })
	UIUtil.Corner(halo, UDim.new(1, 0))
	-- silhouette : maisons (corps + toit en carré tourné) sur une colline
	UIUtil.Create("Frame", { Name = "Ground", AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0.16, 0), BackgroundColor3 = Color3.fromRGB(150, 118, 196), BorderSizePixel = 0, ZIndex = 43, Parent = loading })
	local tones = { Color3.fromRGB(170, 136, 214), Color3.fromRGB(196, 160, 236) }
	for _, spec in ipairs(SKYLINE) do
		local color = tones[spec[4]]
		local body = UIUtil.Create("Frame", { Name = "House", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(spec[1], 0, 0.84, 1),
			Size = UDim2.fromOffset(spec[2], spec[3]), BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = 42, Parent = loading })
		local roofSide = spec[2] / math.sqrt(2)
		UIUtil.Create("Frame", { Name = "Roof", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0), Rotation = 45,
			Size = UDim2.fromOffset(roofSide, roofSide), BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = 42, Parent = body })
		for w = 0, 1 do
			local window = UIUtil.Create("Frame", { Name = "Window", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.3 + w * 0.4, 0, 0, spec[3] * 0.3),
				Size = UDim2.fromOffset(12, 14), BackgroundColor3 = Color3.fromRGB(255, 236, 170), BorderSizePixel = 0, ZIndex = 42, Parent = body })
			UIUtil.Corner(window, 3)
		end
	end
	-- centre : titre, état, barre, astuce (mis à l'échelle dans Layout)
	local center = UIUtil.Create("Frame", { Name = "Center", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.4),
		Size = UDim2.fromOffset(760, 260), BackgroundTransparency = 1, ZIndex = 44, Parent = loading })
	parts.LoadingScale = UIUtil.Create("UIScale", { Parent = center })
	label({ Name = "Welcome", Text = Locale.T("Welcome to"), Color = WHITE, TextSize = 26, Size = UDim2.new(1, 0, 0, 34), ZIndex = 45, Parent = center })
	local title = label({ Name = "Title", Text = "DOPAMINE TOWN", Color = WHITE, TextSize = 78, Size = UDim2.new(1, 0, 0, 90),
		Position = UDim2.fromOffset(0, 30), ZIndex = 45, Parent = center })
	UIUtil.Create("UIStroke", { Color = PINK_DEEP, Thickness = 5, Parent = title })
	parts.LoadingText = label({ Name = "Text", Text = "", Color = INK, TextSize = 22, Font = Theme.Fonts.Title, Size = UDim2.new(1, 0, 0, 30),
		Position = UDim2.fromOffset(0, 136), ZIndex = 45, Parent = center })
	local track = UIUtil.Create("Frame", { Name = "Progress", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 176),
		Size = UDim2.fromOffset(420, 18), BackgroundColor3 = WHITE, BackgroundTransparency = 0.25, ZIndex = 45, Parent = center })
	UIUtil.Corner(track, UDim.new(1, 0))
	UIUtil.Stroke(track, WHITE, 2, 0)
	local fill = UIUtil.Create("Frame", { Name = "Fill", Size = UDim2.fromScale(0.05, 1), BackgroundColor3 = PINK, ZIndex = 46, Parent = track })
	UIUtil.Corner(fill, UDim.new(1, 0))
	UIUtil.Gradient(fill, ColorSequence.new(Color3.fromRGB(255, 120, 190), Color3.fromRGB(255, 190, 110)), 0)
	parts.LoadingFill = fill
	parts.LoadingTip = label({ Name = "Tip", Text = "", Color = INK, TextSize = 18, Font = Theme.Fonts.Body, Size = UDim2.new(1, 0, 0, 26),
		Position = UDim2.fromOffset(0, 208), ZIndex = 45, Parent = center })
	parts.Loading = loading

	-- Survol : bandes cinéma, titre, "Passer"
	local cinema = UIUtil.Create("Frame", { Name = "Cinematic", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, ZIndex = 30, Parent = overlay })
	for _, spec in ipairs({ { "TopBar", 0 }, { "BottomBar", 1 } }) do
		parts[spec[1]] = UIUtil.Create("Frame", { Name = spec[1], AnchorPoint = Vector2.new(0, spec[2]), Position = UDim2.fromScale(0, spec[2]), Size = UDim2.fromScale(1, 0.11),
			BackgroundColor3 = Color3.fromRGB(12, 8, 20), BorderSizePixel = 0, ZIndex = 31, Parent = cinema })
	end
	local cinemaCenter = UIUtil.Create("Frame", { Name = "Titles", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, 0.86),
		Size = UDim2.fromOffset(760, 130), BackgroundTransparency = 1, ZIndex = 32, Parent = cinema })
	parts.CinemaScale = UIUtil.Create("UIScale", { Parent = cinemaCenter })
	local cTitle = label({ Name = "Title", Text = "DOPAMINE TOWN", Color = WHITE, TextSize = 64, Size = UDim2.new(1, 0, 0, 74), ZIndex = 33, Parent = cinemaCenter })
	local cStroke = UIUtil.Create("UIStroke", { Color = PINK_DEEP, Thickness = 4, Parent = cTitle })
	local cSub = label({ Name = "Subtitle", Text = "", Color = WHITE, TextSize = 24, Size = UDim2.new(1, 0, 0, 32), Position = UDim2.fromOffset(0, 78), ZIndex = 33, Parent = cinemaCenter })
	local cSubStroke = UIUtil.Create("UIStroke", { Color = INK, Thickness = 2, Transparency = 0.2, Parent = cSub })
	parts.CinemaTitle, parts.CinemaSub, parts.CinemaStroke, parts.CinemaSubStroke = cTitle, cSub, cStroke, cSubStroke
	local skip = UIUtil.PillButton({ Name = "SkipIntro", Text = Locale.T("Skip"), Color = WHITE, TextColor3 = INK, Height = 40, TextSize = 18, ZIndex = 34, Parent = cinema })
	skip.AutomaticSize = Enum.AutomaticSize.None
	skip.TextXAlignment = Enum.TextXAlignment.Left
	skip.AnchorPoint = Vector2.new(1, 0.5)
	skip.Position = UDim2.new(1, -40, 0.055, 0)
	skip.Size = UDim2.fromOffset(textWidth(Locale.T("Skip"), 18) + 62, 40)
	local skipPad = skip:FindFirstChildOfClass("UIPadding")
	if skipPad then
		skipPad.PaddingLeft = UDim.new(0, 18)
		skipPad.PaddingRight = UDim.new(0, 40)
	end
	UIUtil.Icon("Next", { Size = 18, Color = PINK_DEEP, Position = UDim2.new(1, 20, 0.5, 0), ZIndex = 35, Parent = skip })
	parts.SkipScale = UIUtil.Create("UIScale", { Parent = skip })
	skip.Activated:Connect(function()
		self.Callbacks.SkipIntro()
	end)
	parts.Cinema = cinema
	parts.Skip = skip

	-- Fondu (sortie, fin du chargement)
	parts.Fade = UIUtil.Create("Frame", { Name = "Fade", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(255, 190, 220),
		BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false, ZIndex = 60, Parent = overlay })
end

-- Écran de chargement ; `progress` 0..1 (barre)
function TownHud.ShowLoading(self: any, visible: boolean, text: string?, progress: number?)
	local parts = self.Parts
	local wasVisible = parts.Loading.Visible
	parts.Loading.Visible = visible
	if text then
		parts.LoadingText.Text = text
	end
	if progress then
		self:SetLoadingProgress(progress)
	end
	if visible and not wasVisible then
		-- astuces qui défilent tant que l'écran est là
		self.TipToken = (self.TipToken or 0) + 1
		local token = self.TipToken
		local index = math.random(1, #LOADING_TIPS)
		parts.LoadingTip.Text = Locale.T(LOADING_TIPS[index])
		task.spawn(function()
			while self.TipToken == token and parts.Loading.Visible do
				task.wait(2.6)
				if self.TipToken ~= token or not parts.Loading.Visible then
					break
				end
				index = index % #LOADING_TIPS + 1
				parts.LoadingTip.Text = Locale.T(LOADING_TIPS[index])
			end
		end)
	elseif not visible and wasVisible then
		self.TipToken = (self.TipToken or 0) + 1
		-- (le chargement s'efface en douceur : voile de la même couleur)
		self:Fade(0, 0, Color3.fromRGB(255, 186, 214))
		self:Fade(1, 0.6)
	end
end

function TownHud.SetLoadingProgress(self: any, progress: number)
	local p = math.clamp(progress, 0.03, 1)
	self.Parts.LoadingFill.Size = UDim2.fromScale(p, 1)
end

-- Voile plein écran : `alpha` 0 = couvert, 1 = transparent
function TownHud.Fade(self: any, alpha: number, duration: number, color: Color3?)
	local fade: Frame = self.Parts.Fade
	if color then
		fade.BackgroundColor3 = color
	end
	if self.FadeTween then
		pcall(function()
			self.FadeTween:Cancel()
		end)
		self.FadeTween = nil
	end
	fade.Visible = true
	if duration <= 0 then
		fade.BackgroundTransparency = alpha
		fade.Visible = alpha < 1
		return
	end
	local ok, tween = pcall(function()
		return TweenService:Create(fade, TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = alpha })
	end)
	if ok and tween then
		self.FadeTween = tween
		tween.Completed:Connect(function()
			if self.FadeTween == tween then
				self.FadeTween = nil
				fade.Visible = fade.BackgroundTransparency < 0.999
			end
		end)
		tween:Play()
	else
		fade.BackgroundTransparency = alpha
		fade.Visible = alpha < 1
	end
end

-- Survol : bandes + titre ; le HUD normal est caché pendant ce temps
function TownHud.SetCinematic(self: any, on: boolean, subtitle: string?)
	local parts = self.Parts
	parts.Cinema.Visible = on
	self.Root.Visible = not on
	if subtitle then
		parts.CinemaSub.Text = subtitle
	end
	if on then
		self:SetIntroProgress(0)
	end
end

-- Titre du survol : apparaît puis s'efface (t = 0..1)
function TownHud.SetIntroProgress(self: any, t: number)
	local parts = self.Parts
	local alpha
	if t < 0.12 then
		alpha = 1 - t / 0.12
	elseif t < 0.7 then
		alpha = 0
	else
		alpha = math.clamp((t - 0.7) / 0.2, 0, 1)
	end
	parts.CinemaTitle.TextTransparency = alpha
	parts.CinemaSub.TextTransparency = alpha
	parts.CinemaStroke.Transparency = alpha
	parts.CinemaSubStroke.Transparency = 0.2 + 0.8 * alpha
end

-- 🖥️ Au bureau (DeskMode) : pas d'émotes ni de meubles, pas de pastille
-- (DeskMode montre son propre "Se lever")
function TownHud.SetDeskMode(self: any, active: boolean)
	self.DeskActive = active
	local parts = self.Parts
	parts.Emote.Visible = not active
	-- (au bureau, la bannière de la maison cacherait les écrans du haut)
	parts.Banner.Visible = not active and self.Context ~= nil and self.Context.Snapshot ~= nil
	if active then
		self:SetEmoteWheel(false)
		parts.Edit.Visible = false
		self:SetAction(nil)
	else
		local context = self.Context
		parts.Edit.Visible = context ~= nil and context.IsOwner and context.InHouse
	end
end

-- Pastille d'action : "Emote" -> ■ Arrêter, "Sit" -> Se lever, nil -> cachée
function TownHud.SetAction(self: any, state: string?)
	if self.DeskActive then
		state = nil
	end
	self.ActionState = state
	local parts = self.Parts
	local action: TextButton = parts.Action
	action.Visible = state ~= nil
	if not state then
		return
	end
	local text = state == "Sit" and Locale.T("Get up") or Locale.T("Stop")
	action.Text = text
	action.BackgroundColor3 = state == "Sit" and MINT or Color3.fromRGB(255, 92, 120)
	action:SetAttribute("BaseColor", action.BackgroundColor3)
	action.Size = UDim2.fromOffset(textWidth(text, 20) + 76, 50)
	parts.StopIcon.Visible = state ~= "Sit"
	parts.UpIcon.Visible = state == "Sit"
	self:PlaceAction()
end

-- (au-dessus de la barre d'édition si elle est ouverte)
function TownHud.PlaceAction(self: any)
	local parts = self.Parts
	local lift = parts.EditBar.Visible and 86 or 18
	parts.Action.Position = UDim2.new(0.5, 0, 1, -lift)
end

-- Boussole : `bearing` en degrés (0 = devant), `distance` en studs
function TownHud.SetCompass(self: any, visible: boolean, bearing: number?, distance: number?)
	local parts = self.Parts
	parts.Compass.Visible = visible
	if not visible then
		return
	end
	parts.Needle.Rotation = math.floor((bearing or 0) + 0.5)
	-- (1 stud = 0,28 m)
	local meters = math.floor((distance or 0) * 0.28 + 0.5)
	local text = Locale.T("🏠 %s m", tostring(meters))
	if parts.CompassText.Text ~= text then
		parts.CompassText.Text = text
		parts.Compass.Size = UDim2.fromOffset(math.max(84, textWidth(text, 14) + 44), 32)
	end
end

----------------------------------------------------------------------
-- Fenêtre "Visiter"
----------------------------------------------------------------------

export type VisitRow = { Snapshot: any, IsSelf: boolean, Locked: boolean }

function TownHud.OpenVisit(self: any, rows: { VisitRow })
	local parts = self.Parts
	local list: ScrollingFrame = parts.VisitList
	for _, child in ipairs(list:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	if #rows == 0 then
		label({ Name = "Empty", Text = Locale.T("Nobody else is here yet… invite a friend!"), Color = INK, TextSize = 17, Size = UDim2.new(1, 0, 0, 60),
			ZIndex = 23, Parent = list })
	end
	-- petite pastille (taille, ❤️, 👀, 🔒…)
	local function chip(parent: Instance, text: string, color: Color3, textColor: Color3, order: number)
		local width = textWidth(text, 13, Theme.Fonts.Title) + 16
		local c = UIUtil.Create("Frame", { Name = "Chip", Size = UDim2.fromOffset(width, 22), BackgroundColor3 = color, LayoutOrder = order, ZIndex = 24, Parent = parent })
		UIUtil.Corner(c, UDim.new(1, 0))
		label({ Name = "Text", Text = text, Color = textColor, TextSize = 13, Size = UDim2.fromScale(1, 1), ZIndex = 25, Parent = c })
	end
	for index, row in ipairs(rows) do
		local snapshot = row.Snapshot
		local inTown = snapshot.InTown == true
		local item = UIUtil.Create("Frame", {
			Name = "Row_" .. tostring(snapshot.UserId),
			Size = UDim2.new(1, 0, 0, 78),
			BackgroundColor3 = WHITE,
			LayoutOrder = index,
			ZIndex = 23,
			Parent = list,
		})
		UIUtil.Corner(item, 18)
		UIUtil.Stroke(item, row.IsSelf and PINK or Color3.fromRGB(226, 212, 250), row.IsSelf and 2 or 1.5, 0)
		UIUtil.Gradient(item, ColorSequence.new(row.IsSelf and Color3.fromRGB(255, 236, 246) or Color3.fromRGB(250, 246, 255), WHITE), 0)
		-- avatar dans un anneau (vert : en ville)
		local ring = UIUtil.Create("Frame", { Name = "Ring", Size = UDim2.fromOffset(60, 60), Position = UDim2.fromOffset(9, 9),
			BackgroundColor3 = inTown and MINT or Color3.fromRGB(214, 200, 240), ZIndex = 24, Parent = item })
		UIUtil.Corner(ring, UDim.new(1, 0))
		local head = UIUtil.Create("ImageLabel", {
			Name = "Head",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(52, 52),
			BackgroundColor3 = Color3.fromRGB(255, 226, 240),
			Image = UIUtil.HeadshotUrl(tonumber(snapshot.UserId) or 1, 60),
			ZIndex = 25,
			Parent = ring,
		})
		UIUtil.Corner(head, UDim.new(1, 0))
		local dot = UIUtil.Create("Frame", { Name = "Status", AnchorPoint = Vector2.new(1, 1), Position = UDim2.fromScale(1, 1), Size = UDim2.fromOffset(16, 16),
			BackgroundColor3 = inTown and Color3.fromRGB(60, 210, 130) or Color3.fromRGB(190, 180, 200), ZIndex = 26, Parent = ring })
		UIUtil.Corner(dot, UDim.new(1, 0))
		UIUtil.Stroke(dot, WHITE, 2, 0)
		local size = Config.HouseSizesById[snapshot.Size] or Config.House.Sizes[1]
		local name = tostring(snapshot.DisplayName or snapshot.Name or "?")
		-- nom, puis l'état (en ville / clique, 🔒) juste après
		local nameText = row.IsSelf and Locale.T("%s (you)", name) or name
		local nameW = math.min(textWidth(nameText, 19) + 10, 190)
		label({ Name = "Name", Text = nameText, Color = INK, TextSize = 19, Size = UDim2.fromOffset(nameW + 4, 24),
			Position = UDim2.fromOffset(80, 10), XAlign = Enum.TextXAlignment.Left, ZIndex = 24, Parent = item })
		local status = (inTown and Locale.T("🚶 in town") or Locale.T("💤 clicking")) .. (row.Locked and "  🔒" or "")
		label({ Name = "Status", Text = status, Color = inTown and Color3.fromRGB(40, 160, 100) or Color3.fromRGB(150, 130, 170), TextSize = 13, Font = Theme.Fonts.Body,
			Size = UDim2.fromOffset(textWidth(status, 13, Theme.Fonts.Body) + 6, 24), Position = UDim2.fromOffset(80 + nameW + 10, 10), XAlign = Enum.TextXAlignment.Left,
			ZIndex = 24, Parent = item })
		local chips = UIUtil.Create("Frame", { Name = "Chips", BackgroundTransparency = 1, Position = UDim2.fromOffset(80, 42), Size = UDim2.new(1, -240, 0, 22),
			ClipsDescendants = true, ZIndex = 24, Parent = item })
		UIUtil.Create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder, Parent = chips })
		chip(chips, string.format("%s %s", tostring(size.Icon or "🏠"), Locale.T(size.Name)), Color3.fromRGB(240, 232, 255), INK, 1)
		chip(chips, string.format("❤️ %s  👀 %s", NumberFormatter.Format(tonumber(snapshot.Likes) or 0), NumberFormatter.Format(tonumber(snapshot.Visits) or 0)),
			Color3.fromRGB(255, 228, 238), PINK_DEEP, 2)
		local go = UIUtil.PillButton({ Name = "Go", Text = row.IsSelf and Locale.T("🏠 Home") or Locale.T("🚶 Visit"), Color = row.IsSelf and PINK or LILAC,
			Height = 44, TextSize = 17, ZIndex = 24, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Parent = item })
		go.AutomaticSize = Enum.AutomaticSize.None
		go.Size = UDim2.fromOffset(textWidth(go.Text, 17) + 44, 44)
		go.Activated:Connect(function()
			self:CloseVisit()
			if row.IsSelf then
				self.Callbacks.Home()
			else
				self.Callbacks.Visit(tonumber(snapshot.UserId) or 0)
			end
		end)
	end
	parts.VisitCount.Text = Locale.T("%s houses", tostring(#rows))
	parts.VisitCount.Size = UDim2.fromOffset(textWidth(parts.VisitCount.Text, 14) + 20, 24)
	parts.VisitDimmer.Visible = true
	parts.VisitCard.Visible = true
	UIUtil.Pop(parts.VisitCard, 0.9, 0.2)
end

function TownHud.CloseVisit(self: any)
	self.Parts.VisitDimmer.Visible = false
	self.Parts.VisitCard.Visible = false
end

function TownHud.IsVisitOpen(self: any): boolean
	return self.Parts.VisitCard.Visible
end

function TownHud.Destroy(self: any)
	self.Gui:Destroy()
	if self.Overlay then
		self.Overlay:Destroy()
	end
end

return TownHud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="239">
          <Properties>
            <string name="Name">TownPeople</string>
            <string name="Source"><![CDATA[--[[
	TownPeople (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > TownPeople

	🚶 Dopamine Town (v9.8, CITY98) : des PASSANTS dans les rues, côté CLIENT.
	  - des marcheurs sur les chemins publiés par le serveur (DopamineTown >
	    StreetLife, Configuration "Path" : l'anneau du trottoir intérieur du
	    boulevard, le tour de la place, la promenade de l'avenue jusqu'à la
	    porte, les trottoirs de l'avenue et des rues) : ils tiennent leur
	    droite, certains marchent à deux en discutant, d'autres promènent
	    leur CHIEN (laisse), joggent, regardent leur téléphone, portent un
	    café ou un sac de courses ;
	  - des gens ASSIS sur les bancs (place, avenue, arrivée, abribus), aux
	    terrasses de café, aux tables d'échecs ; des gens qui DISCUTENT à
	    deux ; quelqu'un qui attend le bus ; les marchands du petit marché,
	    du kiosque et des étals (emplacements de TownStreetLife).
	DÉTERMINISTE : la position de chacun ne dépend que de l'heure du serveur
	(workspace:GetServerTimeNow) et de sa graine -> tous les joueurs voient
	les mêmes passants aux mêmes endroits. Les personnages (NPCModels) ne
	sont construits que près de l'avatar : 18 au plus (les plus proches, à
	moins de 150 studs), 2 constructions par passe ; ancrés, animés par
	CFrame (BulkMoveTo) : 30 Hz près de l'avatar, 10 Hz plus loin. Aucune
	lumière, aucun son.

	v9.9 (NPC99) — plus personne ne passe à travers personne :
	  - chacun tient VRAIMENT sa droite (v9.8 : les deux sens de marche
	    partageaient la même file et se traversaient de face) ;
	  - évitement local : un passant qui voit quelqu'un devant lui (autre
	    passant, personne arrêtée, joueur) s'écarte doucement sur le côté ;
	    si la place manque (joueur planté au milieu), il S'ARRÊTE, attend en
	    regardant le joueur, puis repart et rattrape son retard en marchant
	    un peu plus vite (tous les joueurs comptent : chaque client voit à
	    peu près la même chose) ;
	  - chaque PNJ a une capsule de collision (NPCModels.SetSolid) : le
	    joueur ne peut plus le traverser ;
	  - bancs : les places des passants assis viennent de NPCSeats (même
	    calcul que le serveur, NPCSeatGuard, qui assoit le joueur à côté) ;
	    hauteur exacte du siège (StreetLife > NpcBenches, sinon détectée) ;
	  - la tête se tourne vers le joueur proche (NPCModels.Animate).

	API (TownClient, via optionalModule) :
	  TownPeople.Start()                  à l'entrée en ville
	  TownPeople.Step(position: Vector3)  flux (4 fois / s)
	  TownPeople.Stop()                   à la sortie
	  TownPeople.Positions() -> { Vector3 } passants construits (TownTraffic :
	                                      les voitures s'arrêtent devant eux)
	  TownPeople.Debug() -> table
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local NPCModels = require(ReplicatedStorage.Shared.NPCModels)
local NPCSeats = require(ReplicatedStorage.Shared.NPCSeats)
local Players = game:GetService("Players")
-- (v9.8, REALISM98) réglage "Graphismes > Détail" : distance x 0,65 / 1 / 1,35 ;
-- "Low" : moitié moins de passants construits
local okGQ, GraphicsQuality = pcall(require, ReplicatedStorage.Shared.GraphicsQuality)
local function quality(): (number, boolean)
	if okGQ and type(GraphicsQuality) == "table" and GraphicsQuality.Get then
		local ok, q = pcall(GraphicsQuality.Get)
		if ok and type(q) == "table" then
			return tonumber(q.DetailScale) or 1, q.Detail == "Low"
		end
	end
	return 1, false
end

local TownPeople = {}

TownPeople.FOLDER_NAME = "TownPeople"
TownPeople.MAX_BUILT = 18
local NEAR_IN, NEAR_OUT = 150, 175
local BUILDS_PER_STEP = 2
local FAST_RANGE = 90 -- (studs) animés à 30 Hz en deçà, 10 Hz au-delà
local FAST_STEP, SLOW_STEP = 1 / 30, 1 / 10

local rgb = Color3.fromRGB

type Path = { Name: string, Points: { Vector3 }, Cum: { number }, Length: number, Loop: boolean }
type Agent = {
	Id: number,
	Kind: string, -- "walk" | "static"
	Style: string,
	Seed: number,
	Prop: string?,
	Path: Path?,
	Speed: number,
	Dir: number,
	Offset: number,
	Lateral: number,
	Along: number, -- (compagnon / chien : décalage le long du chemin)
	Anim: string,
	CF: CFrame?, -- (statiques)
	Phase: number,
	Dog: boolean,
	Model: Model?,
	DogModel: Model?,
	Leash: BasePart?,
	Pos: Vector3,
	Clock: number,
	SitTop: number?, -- (assis) dessus du siège au-dessus du pivot
	Avoid: number, -- (marcheurs) écart latéral d'évitement (lissé)
	Delay: number, -- (s) retard accumulé en attendant
	Waiting: boolean,
	LastNow: number,
	Heading: Vector3?,
	Mate: any?, -- (compagnon de marche)
}

local state: any = nil

----------------------------------------------------------------------
-- Outils
----------------------------------------------------------------------

local function hash(a: number, b: number): number
	local x = math.sin(a * 12.9898 + b * 78.233) * 43758.5453
	return x - math.floor(x)
end

local function serverNow(): number
	local ok, t = pcall(function()
		return workspace:GetServerTimeNow()
	end)
	return ok and type(t) == "number" and t or os.clock()
end

local function parsePoints(text: string): { Vector3 }
	local pts = {}
	for _, chunk in ipairs(string.split(text, ";")) do
		local c = string.split(chunk, ",")
		local x, y, z = tonumber(c[1]), tonumber(c[2]), tonumber(c[3])
		if x and y and z then
			table.insert(pts, Vector3.new(x, y, z))
		end
	end
	return pts
end

local function makePath(name: string, pts: { Vector3 }, loop: boolean): Path?
	if #pts < 2 then
		return nil
	end
	local list = table.clone(pts)
	if loop then
		table.insert(list, pts[1])
	end
	local cum = { 0 }
	for i = 2, #list do
		cum[i] = cum[i - 1] + (list[i] - list[i - 1]).Magnitude
	end
	return { Name = name, Points = list, Cum = cum, Length = cum[#cum], Loop = loop }
end

-- Point du chemin à l'abscisse `s` (bouclé) : position + direction lissée
local function sample(path: Path, s: number): Vector3
	local L = path.Length
	s = s % L
	local cum, pts = path.Cum, path.Points
	local lo, hi = 1, #cum
	while hi - lo > 1 do
		local mid = (lo + hi) // 2
		if cum[mid] <= s then
			lo = mid
		else
			hi = mid
		end
	end
	local seg = cum[hi] - cum[lo]
	local t = seg > 0 and (s - cum[lo]) / seg or 0
	return pts[lo]:Lerp(pts[hi], t)
end

local UP = Vector3.new(0, 1, 0)

-- Repère d'un marcheur au temps `now` (pieds au sol, regard dans le sens de la marche)
-- Point du chemin + avant / droite (sol) d'un marcheur au temps `now`
-- (v9.9 : moins son retard d'attente `Delay`)
local function walkerFrame(a: Agent, now: number): (Vector3, Vector3, Vector3)
	local path = a.Path :: Path
	local s = a.Offset + a.Dir * a.Speed * (now - (a.Delay or 0)) + a.Along
	local p = sample(path, s)
	local ahead = sample(path, s + a.Dir * 1.2)
	local behind = sample(path, s - a.Dir * 1.2)
	local fwd = ahead - behind
	fwd = Vector3.new(fwd.X, 0, fwd.Z)
	if fwd.Magnitude < 0.01 then
		fwd = Vector3.new(0, 0, -1)
	end
	fwd = fwd.Unit
	return p, fwd, fwd:Cross(UP)
end

local function walkerCF(a: Agent, now: number): CFrame
	local p, fwd, right = walkerFrame(a, now)
	local pos = p + right * (a.Lateral + (a.Avoid or 0))
	local heading = a.Heading or fwd
	return CFrame.lookAt(pos, pos + heading)
end

----------------------------------------------------------------------
-- (v9.9) Évitement : s'écarter, attendre, rattraper
----------------------------------------------------------------------

type Obstacle = { Pos: Vector3, Agent: Agent?, Player: boolean }

local MAX_SIDE = 2.4 -- (studs) écart maximal au milieu du chemin
local CLEAR_NPC = 1.8 -- (studs) distance latérale pour croiser un passant
local CLEAR_PLAYER = 2.3 -- … un joueur
local LOOK_AHEAD = 5.5
local CATCH_UP = 0.2 -- (x vitesse) en plus pour rattraper le retard

local function steer(a: Agent, now: number, dt: number, obstacles: { Obstacle })
	local p, fwd, right = walkerFrame(a, now)
	local lat = a.Lateral + a.Avoid
	local pos = p + right * lat
	local lo, hi = -MAX_SIDE - a.Lateral, MAX_SIDE - a.Lateral
	local want = 0
	local nearest = math.huge
	local blocked = false
	for _, o in ipairs(obstacles) do
		if o.Agent ~= a and (o.Agent == nil or o.Agent ~= a.Mate) then
			local rel = o.Pos - pos
			rel = Vector3.new(rel.X, 0, rel.Z)
			local fd = rel:Dot(fwd)
			local ld = rel:Dot(right)
			local clear = o.Player and CLEAR_PLAYER or CLEAR_NPC
			-- (aussi un peu derrière : on ne se rabat pas en le dépassant)
			if fd > -1.6 and fd < LOOK_AHEAD and math.abs(ld) < clear + 0.5 then
				local total = a.Avoid
				if math.abs(ld) < clear then
					local toRight = ld + clear -- (on passe à sa gauche… il finit à notre gauche)
					local toLeft = ld - clear
					local first, second = toRight, toLeft
					-- (le plus court ; à égalité on garde sa droite)
					if math.abs(toLeft) + 0.3 < math.abs(toRight) then
						first, second = toLeft, toRight
					end
					total = a.Avoid + first
					if total < lo or total > hi then
						total = a.Avoid + second
						if total < lo or total > hi then
							total = math.clamp(a.Avoid + first, lo, hi)
							-- plus de place : on s'arrête devant lui
							if fd > 0 and fd < (o.Player and 2.8 or 2.1) then
								blocked = true
							end
						end
					end
				end
				if math.abs(fd) < nearest then
					nearest = math.abs(fd)
					want = total
				end
			end
		end
	end
	local k = math.min(1, dt * 2.2)
	local before = a.Avoid
	a.Avoid += (want - a.Avoid) * k
	local mate = a.Mate
	if mate and mate.Model and mate.Waiting then
		blocked = true
	end
	a.Waiting = blocked
	if blocked then
		a.Delay += dt
	elseif a.Delay > 0 then
		a.Delay = math.max(0, a.Delay - dt * CATCH_UP)
	end
	if mate and mate.Model then
		local d = math.max(a.Delay, mate.Delay)
		a.Delay, mate.Delay = d, d
	end
	-- direction du regard : vers où l'on va vraiment (écart latéral compris)
	local side = dt > 0 and (a.Avoid - before) / dt or 0
	local speed = blocked and 0.01 or a.Speed
	local dir = fwd * speed + right * math.clamp(side, -2, 2)
	if dir.Magnitude > 0.05 then
		local h = a.Heading or fwd
		local target = dir.Unit
		local blend = h:Lerp(target, math.min(1, dt * 5))
		a.Heading = blend.Magnitude > 0.01 and blend.Unit or target
	end
end

----------------------------------------------------------------------
-- Chien (13 pièces, ancré) : trot, queue qui remue
----------------------------------------------------------------------

local DOG_COLORS = { rgb(214, 170, 110), rgb(60, 50, 46), rgb(240, 236, 228), rgb(160, 100, 60), rgb(120, 110, 104) }

local function dogPart(m: Model, name: string, size: Vector3, cf: CFrame, color: Color3, shape: string?): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	if shape == "Egg" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	elseif shape == "Ball" then
		p.Shape = Enum.PartType.Ball
	end
	p.Parent = m
	return p
end

type Dog = { Model: Model, Parts: { BasePart }, Locals: { CFrame }, Kinds: { number }, Frames: { CFrame } }

local function buildDog(seed: number): Dog
	local m = Instance.new("Model")
	m.Name = "Dog"
	local fur = DOG_COLORS[seed % #DOG_COLORS + 1]
	local dark = fur:Lerp(Color3.new(0, 0, 0), 0.35)
	local d: Dog = { Model = m, Parts = {}, Locals = {}, Kinds = {}, Frames = {} }
	-- kinds : 0 corps, 1 tête, 2 queue, 3..6 pattes (AvG, AvD, ArG, ArD)
	local function add(name: string, size: Vector3, loc: CFrame, color: Color3, kind: number, shape: string?)
		local p = dogPart(m, name, size, loc, color, shape)
		table.insert(d.Parts, p)
		table.insert(d.Locals, loc)
		table.insert(d.Kinds, kind)
		table.insert(d.Frames, loc)
	end
	add("DogBody", Vector3.new(0.9, 0.85, 1.9), CFrame.new(0, 1.35, 0), fur, 0, "Egg")
	add("DogChest", Vector3.new(0.8, 0.8, 0.8), CFrame.new(0, 1.45, -0.7), fur:Lerp(Color3.new(1, 1, 1), 0.2), 0, "Egg")
	add("DogCollar", Vector3.new(0.62, 0.16, 0.5), CFrame.new(0, 1.75, -0.92), rgb(220, 50, 70), 0)
	add("DogHead", Vector3.new(0.7, 0.72, 0.8), CFrame.new(0, 2.05, -1.2), fur, 1, "Egg")
	add("DogSnout", Vector3.new(0.4, 0.34, 0.5), CFrame.new(0, 1.92, -1.62), fur:Lerp(Color3.new(1, 1, 1), 0.15), 1, "Egg")
	add("DogNose", Vector3.new(0.16, 0.14, 0.12), CFrame.new(0, 2.0, -1.88), rgb(30, 26, 28), 1, "Egg")
	for _, sx in ipairs({ -1, 1 }) do
		add("DogEar", Vector3.new(0.14, 0.45, 0.3), CFrame.new(sx * 0.3, 2.25, -1.08) * CFrame.Angles(0, 0, sx * 0.35), dark, 1, "Egg")
		add("DogEye", Vector3.new(0.1, 0.1, 0.06), CFrame.new(sx * 0.17, 2.18, -1.55), rgb(30, 26, 28), 1, "Egg")
	end
	add("DogTail", Vector3.new(0.14, 0.14, 0.8), CFrame.new(0, 1.75, 1.15) * CFrame.Angles(math.rad(35), 0, 0), fur, 2)
	local legs = { { -0.26, -0.6 }, { 0.26, -0.6 }, { -0.26, 0.6 }, { 0.26, 0.6 } }
	for i, l in ipairs(legs) do
		add("DogLeg", Vector3.new(0.22, 1.05, 0.24), CFrame.new(l[1], 0.55, l[2]), i <= 2 and fur or dark, 2 + i)
	end
	return d
end

local DOG_HIP_Y = 1.05
local NECK = CFrame.new(0, 1.75, -0.95)
local NECK_INV = NECK:Inverse()
local TAIL = CFrame.new(0, 1.6, 0.8)
local TAIL_INV = TAIL:Inverse()

local function animateDog(d: Dog, cf: CFrame, t: number, moving: boolean)
	local w = t * math.pi * 2 * 2.1
	local bob = moving and math.abs(math.sin(w)) * 0.06 or 0
	local root = cf * CFrame.new(0, bob, 0)
	local head = root * NECK * CFrame.Angles(math.sin(t * 1.3) * 0.08, math.sin(t * 0.7) * 0.3, 0) * NECK_INV
	local tail = root * TAIL * CFrame.Angles(0, math.sin(t * 9) * 0.5, 0) * TAIL_INV
	for i = 1, #d.Parts do
		local k = d.Kinds[i]
		local loc = d.Locals[i]
		if k == 1 then
			d.Frames[i] = head * loc
		elseif k == 2 then
			d.Frames[i] = tail * loc
		elseif k >= 3 then
			-- trot : diagonales en phase (AvG + ArD, AvD + ArG)
			local phase = (k == 3 or k == 6) and 0 or math.pi
			local a = moving and math.sin(w + phase) * 0.55 or 0
			local hip = CFrame.new(loc.X, DOG_HIP_Y, loc.Z)
			d.Frames[i] = root * hip * CFrame.Angles(a, 0, 0) * hip:Inverse() * loc
		else
			d.Frames[i] = root * loc
		end
	end
	workspace:BulkMoveTo(d.Parts, d.Frames, Enum.BulkMoveMode.FireCFrameChanged)
end

----------------------------------------------------------------------
-- Population
----------------------------------------------------------------------

-- Nombre de marcheurs par chemin (selon sa longueur) + styles tirés au sort
local WALK_STYLES = { "pedestrian", "pedestrian", "shopper", "pedestrian", "elder", "kid", "jogger", "worker", "shopper", "pedestrian" }
local PROPS = { "none", "phone", "coffee", "none", "bag", "none" }

-- (v9.9) dessus des sièges du mobilier client (TownStreetLife.SEAT_TOPS s'il
-- existe ; sinon les valeurs v9.8 : chaise de terrasse 1,7, tabouret 1,9)
local function seatTops(): { Terrace: number, Chess: number }
	local tops = { Terrace = 1.7, Chess = 1.9 }
	local module = script.Parent:FindFirstChild("TownStreetLife")
	if module and module:IsA("ModuleScript") then
		local ok, tsl = pcall(require, module)
		local t = if ok and type(tsl) == "table" then (tsl :: any).SEAT_TOPS else nil
		if type(t) == "table" then
			tops.Terrace = tonumber(t.Terrace) or tops.Terrace
			tops.Chess = tonumber(t.Chess) or tops.Chess
		end
	end
	return tops
end

-- Dessus du banc à `pos` (publié par le serveur : NpcBenches) ; nil = détecté
local function benchTop(s: any, pos: Vector3): number?
	for _, b in ipairs(s.Benches or {}) do
		if (b.Pos - pos).Magnitude < 0.6 then
			return b.Top
		end
	end
	return nil
end

local function addAgent(s: any, a: any)
	a.Id = #s.Agents + 1
	a.Pos = Vector3.zero
	a.Clock = 0
	a.Avoid = 0
	a.Delay = 0
	a.Waiting = false
	a.LastNow = 0
	a.Phase = a.Phase or hash(a.Seed, 5) * 10
	table.insert(s.Agents, a)
end

local function populate(s: any)
	local seedBase = 0
	-- marcheurs
	for _, path: Path in ipairs(s.Paths) do
		local n = math.clamp(math.floor(path.Length / 120 + 0.5), 1, 12)
		if path.Name == "PlazaRing" then
			n = 4
		end
		for i = 1, n do
			seedBase += 1
			local seed = seedBase * 13 + 7
			local style = WALK_STYLES[math.floor(hash(seed, 1) * #WALK_STYLES) + 1]
			local dir = hash(seed, 2) < 0.5 and 1 or -1
			local speed = style == "jogger" and 8.5 or (style == "elder" and 2.8 or (3.6 + hash(seed, 3) * 1.0))
			local prop = style == "shopper" and "bag" or PROPS[math.floor(hash(seed, 4) * #PROPS) + 1]
			if style == "jogger" or style == "worker" or style == "kid" then
				prop = "none"
			end
			local offset = (i - 1 + hash(seed, 6) * 0.6) / n * path.Length
			-- (v9.9) tenir SA droite : `right` suit déjà le sens de marche
			local lateral = 0.55 + hash(seed, 7) * 0.35
			local dog = (style == "pedestrian" or style == "elder") and hash(seed, 8) < 0.22
			addAgent(s, {
				Kind = "walk",
				Style = style,
				Seed = seed,
				Prop = dog and "none" or prop,
				Path = path,
				Speed = speed,
				Dir = dir,
				Offset = offset,
				Lateral = lateral,
				Along = 0,
				Anim = "walk",
				Dog = dog,
			})
			-- (parfois un compagnon qui marche à côté : on discute en marchant)
			if not dog and style ~= "jogger" and hash(seed, 9) < 0.25 then
				addAgent(s, {
					Kind = "walk",
					Style = hash(seed, 10) < 0.3 and "kid" or "pedestrian",
					Seed = seed + 1000,
					Prop = "none",
					Path = path,
					Speed = speed,
					Dir = dir,
					Offset = offset,
					Lateral = lateral + 1.35,
					Along = -0.3 * dir,
					Anim = "walk",
					Dog = false,
				})
				-- (v9.9) les deux compagnons ne s'évitent pas et s'attendent
				local mate = s.Agents[#s.Agents]
				local lead = s.Agents[#s.Agents - 1]
				mate.Mate, lead.Mate = lead, mate
			end
		end
	end
	-- assis sur les bancs : places de NPCSeats (le serveur assoit le joueur
	-- sur une place LIBRE, à côté)
	for _, spot in ipairs(s.Anchors.SitBench or {}) do
		local plan = NPCSeats.BenchPlan(spot.Seed)
		for _, n in ipairs(plan.Npcs) do
			addAgent(s, {
				Kind = "static",
				Style = n.Style,
				Seed = n.Seed,
				Prop = n.Prop,
				CF = spot.CF * CFrame.new(NPCSeats.BENCH_SLOTS[n.Slot], 0, NPCSeats.SLOT_Z),
				Anim = "sit",
				SitTop = benchTop(s, spot.CF.Position),
			})
		end
	end
	-- terrasses : 3 clients assis (hauteur des chaises : TownStreetLife)
	local tops = seatTops()
	for _, spot in ipairs(s.Anchors.Terrace or {}) do
		for k, c in ipairs({ { -3.2, -1 }, { 0, 1 }, { 3.2, -1 }, { 3.2, 1 } }) do
			if k <= 3 or hash(spot.Seed, 30) < 0.5 then
				local chair = spot.CF * CFrame.new(c[1], 0, c[2] * 1.25) * CFrame.Angles(0, c[2] < 0 and math.pi or 0, 0)
				addAgent(s, {
					Kind = "static",
					Style = k % 2 == 0 and "shopper" or "pedestrian",
					Seed = spot.Seed * 11 + k,
					Prop = k == 2 and "coffee" or "none",
					CF = chair * CFrame.new(0, 0, 0.15),
					Anim = "sit",
					SitTop = tops.Terrace,
				})
			end
		end
	end
	-- échecs : 2 joueurs face à face à la première table
	for _, spot in ipairs(s.Anchors.ChessTables or {}) do
		for _, sz in ipairs({ -1, 1 }) do
			local stool = spot.CF * CFrame.new(-3, 0, sz * 2.3) * CFrame.Angles(0, sz < 0 and math.pi or 0, 0)
			addAgent(s, { Kind = "static", Style = "elder", Seed = spot.Seed * 5 + sz, Prop = "none", CF = stool * CFrame.new(0, 0, 0.1), Anim = "sit", SitTop = tops.Chess })
		end
	end
	-- discussions à deux
	for _, spot in ipairs(s.Anchors.Chat or {}) do
		for _, sx in ipairs({ -1, 1 }) do
			local p = spot.CF * CFrame.new(sx * 1.15, 0, 0)
			addAgent(s, {
				Kind = "static",
				Style = hash(spot.Seed, 40 + sx) < 0.4 and "shopper" or "pedestrian",
				Seed = spot.Seed * 17 + sx,
				Prop = hash(spot.Seed, 42 + sx) < 0.3 and "coffee" or "none",
				CF = CFrame.lookAt(p.Position, (spot.CF * CFrame.new(-sx * 1.15, 0, 0)).Position),
				Anim = sx < 0 and "talk" or "idle",
			})
		end
	end
	-- on attend le bus
	for _, spot in ipairs(s.Anchors.Wait or {}) do
		addAgent(s, { Kind = "static", Style = "pedestrian", Seed = spot.Seed * 3 + 1, Prop = "phone", CF = spot.CF, Anim = "idle" })
	end
	-- marchands : kiosque, étals, petit marché
	for _, spot in ipairs(s.Anchors.Kiosk or {}) do
		addAgent(s, { Kind = "static", Style = "pedestrian", Seed = spot.Seed * 19, Prop = "none", CF = spot.CF * CFrame.new(0, 0, 0.2), Anim = "talk" })
	end
	for _, kind in ipairs({ "FlowerStall", "BookStall" }) do
		for _, spot in ipairs(s.Anchors[kind] or {}) do
			addAgent(s, { Kind = "static", Style = kind == "FlowerStall" and "shopper" or "elder", Seed = spot.Seed * 23, Prop = "none", CF = spot.CF * CFrame.new(0.6, 0, 2.0), Anim = "talk" })
		end
	end
	for _, spot in ipairs(s.Anchors.MarketSquare or {}) do
		local stalls = { { -7, -4, 0 }, { 7, -4, 0 }, { -7, 5, math.pi }, { 7, 5, math.pi } }
		for i, st in ipairs(stalls) do
			local S = spot.CF * CFrame.new(st[1], 0.12, st[2]) * CFrame.Angles(0, st[3], 0)
			addAgent(s, { Kind = "static", Style = i % 2 == 0 and "baker" or "worker", Seed = spot.Seed * 29 + i, Prop = "none", CF = S * CFrame.new(0, 0, 2.0), Anim = i % 2 == 0 and "talk" or "scan" })
			if i <= 2 then
				-- un client devant l'étal
				addAgent(s, { Kind = "static", Style = "shopper", Seed = spot.Seed * 31 + i, Prop = "bag", CF = S * CFrame.new(0.8, 0, -2.6) * CFrame.Angles(0, math.pi, 0), Anim = "idle" })
			end
		end
	end
end

----------------------------------------------------------------------
-- Construction / animation
----------------------------------------------------------------------

local function agentCF(a: Agent, now: number): CFrame
	if a.Kind == "walk" then
		return walkerCF(a, now)
	end
	return a.CF :: CFrame
end

local function buildAgent(s: any, a: Agent)
	local style = a.Style
	-- (les marchands en tablier : NPCModels "baker" = tablier + toque ; au marché on garde la toque)
	local m = NPCModels.Build(style, { Seed = a.Seed, Prop = a.Prop or "none", SitHeight = a.SitTop })
	m.Name = "Person"
	NPCModels.Place(m, agentCF(a, s.Now))
	m.Parent = s.Folder
	a.Model = m
	if a.Dog then
		local d = buildDog(a.Seed)
		d.Model.Parent = s.Folder
		a.DogModel = d.Model
		;(a :: any).DogRig = d
		local leash = Instance.new("Part")
		leash.Name = "Leash"
		leash.Anchored = true
		leash.CanCollide = false
		leash.CanQuery = false
		leash.CanTouch = false
		leash.CastShadow = false
		leash.Shape = Enum.PartType.Cylinder
		leash.Size = Vector3.new(1, 0.08, 0.08)
		leash.Color = rgb(220, 50, 70)
		leash.Material = Enum.Material.SmoothPlastic
		leash.Parent = s.Folder
		a.Leash = leash
	end
end

local function destroyAgent(a: Agent)
	if a.Model then
		a.Model:Destroy()
	end
	if a.DogModel then
		a.DogModel:Destroy()
	end
	if a.Leash then
		a.Leash:Destroy()
	end
	a.Model, a.DogModel, a.Leash = nil, nil, nil
	;(a :: any).DogRig = nil
end

local function animateAgent(a: Agent, now: number, obstacles: { Obstacle }?)
	local m = a.Model
	if not m then
		return
	end
	if a.Kind == "walk" then
		local dt = a.LastNow > 0 and math.clamp(now - a.LastNow, 0, 0.25) or 0
		a.LastNow = now
		if obstacles then
			steer(a, now, dt, obstacles)
		end
	end
	local cf = agentCF(a, now)
	a.Pos = cf.Position
	-- (NPCModels.Place : seule la racine bouge, Animate repose le reste ;
	-- jamais de PivotTo répété -> pas d'erreurs d'arrondi accumulées)
	NPCModels.Place(m, cf)
	local t = now + a.Phase
	if a.Kind == "walk" then
		-- (cadence proportionnelle à la vitesse : ~4 studs / s = pas normal ;
		-- plus rapide quand on rattrape son retard ; arrêté = au repos)
		local sc = tonumber(m:GetAttribute("NpcScale")) or 1
		local rate = a.Speed / (4 * sc) * (a.Delay > 0 and not a.Waiting and (1 + CATCH_UP) or 1)
		if a.Waiting then
			NPCModels.Animate(m, "idle", t)
		else
			NPCModels.Animate(m, "walk", (now - a.Delay) * rate + a.Phase)
		end
		local rig = (a :: any).DogRig
		if rig then
			-- le chien trotte un peu devant, côté bordure
			local dogCF = walkerCF({
				Path = a.Path,
				Offset = a.Offset,
				Dir = a.Dir,
				Speed = a.Speed,
				Along = a.Dir * 2.4,
				Lateral = a.Lateral + a.Avoid - 1.0, -- (à gauche : la laisse est dans la main gauche)
				Delay = a.Delay,
			} :: any, now)
			animateDog(rig, dogCF, t, not a.Waiting)
			local leash = a.Leash
			if leash then
				local hand = (cf * CFrame.new(-0.8, 2.25, -0.2)).Position
				local collar = (dogCF * CFrame.new(0, 1.78, -0.92)).Position
				local mid = (hand + collar) / 2
				local len = (collar - hand).Magnitude
				leash.Size = Vector3.new(len, 0.08, 0.08)
				leash.CFrame = CFrame.lookAt(mid, collar) * CFrame.Angles(0, math.pi / 2, 0)
			end
		end
	else
		NPCModels.Animate(m, a.Anim, t)
	end
end

----------------------------------------------------------------------
-- Chargement
----------------------------------------------------------------------

-- (v9.9) obstacles : les personnes construites + les avatars de TOUS les joueurs
local function obstaclesOf(s: any): { Obstacle }
	local obstacles: { Obstacle } = {}
	for _, a: Agent in ipairs(s.Built or {}) do
		table.insert(obstacles, { Pos = a.Pos, Agent = a, Player = false })
	end
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			table.insert(obstacles, { Pos = root.Position, Agent = nil, Player = true })
		end
	end
	s.Obstacles = obstacles
	return obstacles
end

local ANCHOR_KINDS = { "SitBench", "Terrace", "ChessTables", "Chat", "Wait", "Kiosk", "FlowerStall", "BookStall", "MarketSquare" }

local function load(s: any): boolean
	local town = workspace:FindFirstChild("DopamineTown")
	local data = town and town:FindFirstChild("StreetLife")
	if not town or not data then
		return false
	end
	local paths: { Path } = {}
	local anchors: { [string]: { { CF: CFrame, Seed: number } } } = {}
	for _, kind in ipairs(ANCHOR_KINDS) do
		anchors[kind] = {}
	end
	local benches = {}
	for _, child in ipairs(data:GetChildren()) do
		if child.Name == "NpcBenches" then
			local text = child:GetAttribute("Data")
			if type(text) == "string" then
				for _, line in ipairs(string.split(text, "\n")) do
					local f = string.split(line, ";")
					local x, y, z, top = tonumber(f[1]), tonumber(f[2]), tonumber(f[3]), tonumber(f[4])
					if x and y and z and top then
						table.insert(benches, { Pos = Vector3.new(x, y, z), Top = top })
					end
				end
			end
		elseif child.Name == "Path" then
			local pts = child:GetAttribute("Points")
			local name = child:GetAttribute("Name")
			if type(pts) == "string" and type(name) == "string" then
				local path = makePath(name, parsePoints(pts), child:GetAttribute("Loop") == true)
				if path then
					table.insert(paths, path)
				end
			end
		else
			local text = child:GetAttribute("Data")
			if type(text) == "string" then
				for _, line in ipairs(string.split(text, "\n")) do
					local f = string.split(line, ";")
					local list = anchors[f[1]]
					local x, y, z, yaw = tonumber(f[2]), tonumber(f[3]), tonumber(f[4]), tonumber(f[5])
					if list and x and y and z and yaw then
						table.insert(list, { CF = CFrame.new(x, y, z) * CFrame.Angles(0, yaw, 0), Seed = tonumber(f[6]) or 0 })
					end
				end
			end
		end
	end
	-- (ordre stable : même population sur tous les clients)
	table.sort(paths, function(a, b)
		return a.Name < b.Name
	end)
	for _, list in pairs(anchors) do
		table.sort(list, function(a, b)
			local pa, pb = a.CF.Position, b.CF.Position
			if pa.X ~= pb.X then
				return pa.X < pb.X
			end
			return pa.Z < pb.Z
		end)
	end
	-- le petit tour de la place (autour de la fontaine)
	local plaza = town:GetAttribute("PlazaCF")
	if typeof(plaza) == "CFrame" then
		local ring = {}
		for i = 0, 23 do
			local ang = i / 24 * math.pi * 2
			table.insert(ring, plaza.Position + Vector3.new(math.sin(ang) * 26, 0.08, math.cos(ang) * 26))
		end
		local path = makePath("PlazaRing", ring, true)
		if path then
			table.insert(paths, path)
		end
	end
	s.Paths = paths
	s.Anchors = anchors
	s.Benches = benches
	s.Agents = {}
	populate(s)
	local folder = Instance.new("Folder")
	folder.Name = TownPeople.FOLDER_NAME
	folder.Parent = workspace
	s.Folder = folder
	s.Loaded = true
	return true
end

----------------------------------------------------------------------
-- API
----------------------------------------------------------------------

function TownPeople.Start()
	if state then
		return
	end
	state = { Agents = {}, Paths = {}, Anchors = {}, Loaded = false, Retry = 0, Now = serverNow(), AccFast = 0, AccSlow = 0, Focus = nil }
	pcall(load, state)
	state.Conn = RunService.Heartbeat:Connect(function(dt: number)
		local s = state
		if not s or not s.Loaded then
			return
		end
		s.AccFast += dt
		s.AccSlow += dt
		local fast = s.AccFast >= FAST_STEP
		local slow = s.AccSlow >= SLOW_STEP
		if not fast then
			return
		end
		s.AccFast = 0
		if slow then
			s.AccSlow = 0
		end
		local now = serverNow()
		s.Now = now
		local focus = s.Focus
		local ok, err = pcall(function()
			local obstacles = obstaclesOf(s)
			for _, a: Agent in ipairs(s.Built) do
				local near = focus == nil or (a.Pos - focus).Magnitude < FAST_RANGE
				if near or slow then
					animateAgent(a, now, obstacles)
				end
			end
		end)
		if not ok and not s.Warned then
			s.Warned = true
			warn("[TownPeople] " .. tostring(err))
		end
	end)
	state.Built = {}
end

function TownPeople.Step(position: Vector3)
	local s = state
	if not s then
		return
	end
	if not s.Loaded then
		s.Retry -= 1
		if s.Retry <= 0 then
			s.Retry = 4
			pcall(load, s)
		end
		return
	end
	s.Focus = position
	local now = serverNow()
	s.Now = now
	local scale, low = quality()
	local nearIn, nearOut = NEAR_IN * scale, NEAR_OUT * scale
	local maxBuilt = low and math.floor(TownPeople.MAX_BUILT / 2) or TownPeople.MAX_BUILT
	-- distances (tous les passants "existent" ; on ne construit que les plus proches)
	local cands = {}
	for _, a: Agent in ipairs(s.Agents) do
		local p = agentCF(a, now).Position
		a.Pos = p
		local d = (Vector3.new(p.X - position.X, 0, p.Z - position.Z)).Magnitude
		if d < nearOut then
			table.insert(cands, { A = a, D = d })
		end
	end
	table.sort(cands, function(x, y)
		return x.D < y.D
	end)
	local wanted: { [Agent]: boolean } = {}
	for i, c in ipairs(cands) do
		if i > maxBuilt then
			break
		end
		-- (hystérésis : un passant déjà construit reste jusqu'à NEAR_OUT)
		if c.D < nearIn or c.A.Model then
			wanted[c.A] = true
		end
	end
	local built = {}
	for _, a: Agent in ipairs(s.Built) do
		if wanted[a] then
			table.insert(built, a)
		else
			destroyAgent(a)
		end
	end
	local builds = 0
	for _, c in ipairs(cands) do
		local a = c.A
		if wanted[a] and not a.Model and builds < BUILDS_PER_STEP then
			builds += 1
			local ok, err = pcall(buildAgent, s, a)
			if ok then
				table.insert(built, a)
				animateAgent(a, now)
			else
				warn("[TownPeople] " .. tostring(err))
				destroyAgent(a)
			end
		end
	end
	s.Built = built
end

-- (rendus / tests) une image d'animation tout de suite ; `at` : heure imposée
function TownPeople.Frame(_dt: number?, position: Vector3?, at: number?)
	local s = state
	if not s or not s.Loaded then
		return
	end
	if position then
		s.Focus = position
	end
	local now = at or serverNow()
	local obstacles = obstaclesOf(s)
	for _, a: Agent in ipairs(s.Built) do
		animateAgent(a, now, obstacles)
	end
end

function TownPeople.Positions(): { Vector3 }
	local out = {}
	local s = state
	if s and s.Built then
		for _, a: Agent in ipairs(s.Built) do
			if a.Kind == "walk" then
				table.insert(out, a.Pos)
			end
		end
	end
	return out
end

function TownPeople.Stop()
	local s = state
	state = nil
	if not s then
		return
	end
	if s.Conn then
		s.Conn:Disconnect()
	end
	for _, a in ipairs(s.Agents) do
		destroyAgent(a)
	end
	if s.Folder then
		s.Folder:Destroy()
	end
end

-- (tests / rendus) les personnes construites : position, état d'attente
function TownPeople.Agents(): { any }
	local out = {}
	local s = state
	for _, a: Agent in ipairs(s and s.Built or {}) do
		table.insert(out, { Id = a.Id, Kind = a.Kind, Pos = a.Pos, Waiting = a.Waiting, Delay = a.Delay, Avoid = a.Avoid, Lateral = a.Lateral, Model = a.Model, Anim = a.Anim, Style = a.Style, Seed = a.Seed })
	end
	return out
end

function TownPeople.Debug(): any
	local s = state
	if not s then
		return { Started = false }
	end
	local walkers, statics, parts = 0, 0, 0
	for _, a: Agent in ipairs(s.Agents) do
		if a.Kind == "walk" then
			walkers += 1
		else
			statics += 1
		end
	end
	for _, a: Agent in ipairs(s.Built or {}) do
		if a.Model then
			parts += NPCModels.PartCount(a.Model)
		end
	end
	local names = {}
	for _, p: Path in ipairs(s.Paths) do
		table.insert(names, p.Name .. "=" .. math.floor(p.Length))
	end
	return { Agents = #s.Agents, Walkers = walkers, Statics = statics, Built = s.Built and #s.Built or 0, Parts = parts, Paths = table.concat(names, " ") }
end

return TownPeople
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="240">
          <Properties>
            <string name="Name">TownPigeons</string>
            <string name="Source"><![CDATA[--[[
	TownPigeons (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > TownPigeons

	🐦 Les pigeons de la place centrale, côté CLIENT (appelé par
	TownPlazaFx : construit avec la place, animé à chaque image de près, à
	30 Hz plus loin, en pause au loin).
	v9.9 (CITY99) : "100x plus réalistes" (v9.8 : "c'est dég") :
	  - ANATOMIE d'un vrai pigeon biset à l'échelle de l'avatar (~32 cm =
	    1 stud de long, ~0,8 stud debout) : corps fuselé en ellipsoïdes qui
	    se fondent (dos, ventre, poitrail rosé, croupion clair, sous-caudales),
	    cou IRISÉ vert + violet (reflets), tête ronde qui prolonge le cou,
	    bec fin avec sa CIRE blanche, yeux orange à pupille noire ;
	  - PLUMAGE en couches : ailes repliées le long du dos avec leurs deux
	    BARRES noires posées sur la couverture (plus de blocs qui dépassent),
	    rémiges sombres qui se croisent sur la queue, queue en deux moitiés
	    qui s'ÉVENTAIL à l'atterrissage, bande terminale sombre ;
	  - pattes fines corail, 3 doigts (2 devant, 1 derrière) ;
	  - 6 plumages : biset, écaillé, argenté, rouge cendré, sombre, pie ;
	  - MARCHE : un pas = un hochement de tête ; la tête reste IMMOBILE dans
	    l'espace pendant que le corps avance, puis se projette en avant (le
	    vrai mouvement du pigeon), pattes alternées, léger roulis ;
	    virages progressifs (plus de rotation instantanée) ;
	  - picore (le corps bascule, 2 à 3 coups de bec), tourne la tête par
	    à-coups, fait sa toilette, roucoule (courbettes, queue étalée qui
	    traîne, petit tour sur lui-même), s'ébroue ;
	  - ENVOL en groupe (quelqu'un arrive trop près, ou de temps en temps) :
	    accroupi, bond, battements rapides, montée, un TOUR de la place en
	    formation (ailes en V, inclinés dans le virage, battements par
	    rafales), puis descente en plané et ATTERRISSAGE freiné (ailes hautes,
	    queue en éventail, pattes en avant) et ailes repliées ; trajectoires
	    en courbes d'Hermite : position et vitesse continues, sans à-coup ;
	  - quelqu'un approche doucement : on s'écarte en marchant ;
	  - JAMAIS deux pigeons l'un dans l'autre : places d'atterrissage
	    choisies libres, pas bloqué par un voisin, séparation au sol
	    (distance mini 2 x BIRD_R), formation de vol décalée, un pigeon par
	    perchoir (lanternes, margelle de la fontaine).
	Tout est ancré, sans collision, animé par CFrame (BulkMoveTo). Aucune
	création d'instance par image. Aucun son.

	API (TownPlazaFx) :
	  TownPigeons.Build(folder, plaza) -> état   (plaza : dossier Plaza, attributs Fx…)
	  TownPigeons.Step(état, dt, avatar: Vector3?)
	  TownPigeons.Count(état) -> number
	  TownPigeons.Near(état, point, radius) -> boolean  (animer à chaque image ?)
	  TownPigeons.Debug(état) -> table  (écart mini au sol, modes…)
]]

local TownPigeons = {}

local M = Enum.Material
local rgb = Color3.fromRGB

local capsuleGap: (a: any, b: any) -> (number, Vector3, Vector3)
local bodyClear: (P: any, me: any, pos: Vector3, yaw: number) -> number

local PER_FLOCK = 5
local BIRD_R = 0.46 -- (studs) demi-distance mini entre deux pigeons au sol
local BODY_HALF = 0.21 -- demi-largeur d'un corps (vu du dessus)
local CAPSULE_MARGIN = 0.06 -- espace gardé entre deux corps
local LAND_GAP = 1.7 -- place d'atterrissage : libre quel que soit le cap (bec 0,5 + queue 0,72 + 2 demi-largeurs + marge)
local WALK_SPEED = 1.05
local STEP_T = 0.3 -- (s) un pas (= un hochement de tête)
local SCARE_R = 3.6 -- quelqu'un plus près : le groupe s'envole
local WARY_R = 6.5 -- plus près : on s'écarte en marchant
local HOME_R = 4 -- rayon où picore un groupe
local FLY_SPEED = 13
local PERCH_MIN, PERCH_MAX = 8, 18
local RELOCATE_MIN, RELOCATE_MAX = 50, 120 -- (s) un groupe fait un tour de temps en temps

-- Groupes de pièces (chacun a son pivot)
local G_BODY, G_HEAD, G_WING_L, G_WING_R, G_LEG_L, G_LEG_R, G_TAIL_L, G_TAIL_R = 0, 1, 2, 3, 4, 5, 6, 7

-- Pivots (repère du pigeon : pieds au sol, bec vers -Z, +X à droite)
local NECK_P = CFrame.new(0, 0.5, -0.24)
local NECK_INV = NECK_P:Inverse()
local SHOULDER = { CFrame.new(-0.15, 0.5, -0.1), CFrame.new(0.15, 0.5, -0.1) }
local SHOULDER_INV = { SHOULDER[1]:Inverse(), SHOULDER[2]:Inverse() }
local WRIST = { CFrame.new(-0.62, 0.5, -0.06), CFrame.new(0.62, 0.5, -0.06) }
local WRIST_INV = { WRIST[1]:Inverse(), WRIST[2]:Inverse() }
local HIP = { CFrame.new(-0.065, 0.22, 0.02), CFrame.new(0.065, 0.22, 0.02) }
local HIP_INV = { HIP[1]:Inverse(), HIP[2]:Inverse() }
local TAIL_P = CFrame.new(0, 0.4, 0.3)
local TAIL_INV = TAIL_P:Inverse()

-- Aile dépliée : le X de la pièce (épaisseur) -> vers le haut, son Y
-- (largeur) -> la corde (vers l'arrière), son Z (longueur) -> l'envergure
local function openAt(x: number, y: number, z: number, sweep: number?): CFrame
	local base = CFrame.fromMatrix(Vector3.new(x, y, z), Vector3.new(0, 1, 0), Vector3.new(0, 0, 1))
	if sweep then
		return CFrame.new(x, y, z) * CFrame.Angles(0, sweep, 0) * (CFrame.new(x, y, z):Inverse() * base)
	end
	return base
end

-- Barre d'aile dépliée : X de la pièce -> haut, Y (longueur) -> envergure, Z -> corde
local function openBar(x: number, y: number, z: number): CFrame
	return CFrame.fromMatrix(Vector3.new(x, y, z), Vector3.new(0, 1, 0), Vector3.new(1, 0, 0))
end

type Spec = {
	Name: string,
	Size: Vector3,
	Shape: string,
	Color: string,
	Group: number,
	Fold: CFrame,
	Open: CFrame?,
	Hand: boolean?, -- rémiges : pliées au poignet en plus
	Shine: number?,
}

-- Pièces d'un pigeon (36) : construites une fois pour toutes
local SPECS: { Spec } = {}
local function spec(name: string, size: Vector3, shape: string, color: string, group: number, fold: CFrame, open: CFrame?, hand: boolean?, shine: number?)
	table.insert(SPECS, { Name = name, Size = size, Shape = shape, Color = color, Group = group, Fold = fold, Open = open, Hand = hand, Shine = shine })
end
do
	local rx = function(d: number): CFrame
		return CFrame.Angles(math.rad(d), 0, 0)
	end
	-- corps : dos (un peu relevé devant), ventre, poitrail, croupion, sous-caudales
	spec("Body", Vector3.new(0.4, 0.37, 0.78), "Egg", "Body", G_BODY, CFrame.new(0, 0.37, 0.04) * rx(8))
	spec("Belly", Vector3.new(0.35, 0.25, 0.5), "Egg", "Belly", G_BODY, CFrame.new(0, 0.29, 0.03))
	spec("Breast", Vector3.new(0.37, 0.4, 0.4), "Egg", "Breast", G_BODY, CFrame.new(0, 0.43, -0.19))
	spec("Rump", Vector3.new(0.28, 0.2, 0.34), "Egg", "Rump", G_BODY, CFrame.new(0, 0.44, 0.29) * rx(-6))
	spec("UnderTail", Vector3.new(0.19, 0.1, 0.3), "Egg", "Belly", G_BODY, CFrame.new(0, 0.33, 0.42) * rx(-12))
	-- tête + cou (pivot : base du cou)
	-- (le cou est gris-bleu devant ; le VERT irisé sur les côtés du haut du
	-- cou, le VIOLET en bas : deux plaques par côté, un peu brillantes)
	spec("Neck", Vector3.new(0.25, 0.36, 0.26), "Egg", "Head", G_HEAD, CFrame.new(0, 0.58, -0.27) * rx(-18))
	spec("NeckSheen", Vector3.new(0.27, 0.2, 0.25), "Egg", "Sheen", G_HEAD, CFrame.new(0, 0.51, -0.25) * rx(-10), nil, nil, 0.16)
	for _, sx in ipairs({ -1, 1 }) do
		spec("NeckGreen", Vector3.new(0.12, 0.24, 0.2), "Egg", "Neck", G_HEAD, CFrame.new(sx * 0.07, 0.6, -0.26) * rx(-18), nil, nil, 0.2)
	end
	spec("Head", Vector3.new(0.22, 0.22, 0.27), "Egg", "Head", G_HEAD, CFrame.new(0, 0.76, -0.37) * rx(-6))
	spec("Beak", Vector3.new(0.045, 0.045, 0.15), "Egg", "Beak", G_HEAD, CFrame.new(0, 0.735, -0.525) * rx(-12))
	spec("Cere", Vector3.new(0.058, 0.04, 0.065), "Egg", "Cere", G_HEAD, CFrame.new(0, 0.766, -0.482))
	for _, sx in ipairs({ -1, 1 }) do
		-- œil à fleur de tête (lentille aplatie), pupille au centre
		spec("Eye", Vector3.new(0.03, 0.062, 0.062), "Egg", "Eye", G_HEAD, CFrame.new(sx * 0.094, 0.787, -0.425))
		spec("Pupil", Vector3.new(0.014, 0.03, 0.03), "Egg", "Pupil", G_HEAD, CFrame.new(sx * 0.106, 0.788, -0.427))
	end
	-- ailes : couverture (+ 2 barres) et rémiges ; pliées le long du dos /
	-- dépliées (envergure totale ~2,2 studs = ~70 cm, comme un vrai)
	for i, sx in ipairs({ -1, 1 }) do
		local g = i == 1 and G_WING_L or G_WING_R
		local s = SHOULDER[i].Position
		spec("Wing", Vector3.new(0.11, 0.28, 0.66), "Egg", "Wing", g, CFrame.new(sx * 0.172, 0.43, 0.1) * rx(6) * CFrame.Angles(0, 0, sx * math.rad(-6)), openAt(s.X + sx * 0.33, s.Y, s.Z + 0.05))
		-- 2 barres noires : bandes obliques sur l'arrière de l'aile repliée,
		-- bandes le long de l'envergure sur l'aile ouverte
		spec("WingBar", Vector3.new(0.03, 0.2, 0.06), "Egg", "Bar", g, CFrame.new(sx * 0.214, 0.43, 0.14) * rx(28), openBar(s.X + sx * 0.36, s.Y + 0.046, s.Z + 0.1))
		spec("WingBar", Vector3.new(0.03, 0.19, 0.06), "Egg", "Bar", g, CFrame.new(sx * 0.206, 0.42, 0.27) * rx(28), openBar(s.X + sx * 0.3, s.Y + 0.046, s.Z + 0.17))
		spec("Primaries", Vector3.new(0.07, 0.16, 0.48), "Egg", "Prim", g, CFrame.new(sx * 0.105, 0.44, 0.46) * rx(-5) * CFrame.Angles(0, sx * math.rad(4), 0), openAt(s.X + sx * 0.84, s.Y, s.Z + 0.12, sx * math.rad(-14)), true)
	end
	-- queue en deux moitiés (éventail) + bande terminale sombre
	for i, sx in ipairs({ -1, 1 }) do
		local g = i == 1 and G_TAIL_L or G_TAIL_R
		local t = TAIL_P * rx(-9)
		spec("Tail", Vector3.new(0.15, 0.045, 0.44), "Egg", "Tail", g, t * CFrame.new(sx * 0.036, 0, 0.24))
		spec("TailBand", Vector3.new(0.158, 0.052, 0.12), "Egg", "Band", g, t * CFrame.new(sx * 0.036, -0.002, 0.4))
	end
	-- pattes (cachées en haut sous le ventre) + 3 doigts
	for i, sx in ipairs({ -1, 1 }) do
		local g = i == 1 and G_LEG_L or G_LEG_R
		local x = sx * 0.065
		spec("Leg", Vector3.new(0.045, 0.21, 0.05), "Egg", "Leg", g, CFrame.new(x, 0.12, 0.02))
		spec("Toe", Vector3.new(0.028, 0.024, 0.13), "Egg", "Leg", g, CFrame.new(x - 0.018, 0.013, -0.035) * CFrame.Angles(0, math.rad(22), 0))
		spec("Toe", Vector3.new(0.028, 0.024, 0.13), "Egg", "Leg", g, CFrame.new(x + 0.018, 0.013, -0.035) * CFrame.Angles(0, math.rad(-22), 0))
		spec("Toe", Vector3.new(0.026, 0.022, 0.08), "Egg", "Leg", g, CFrame.new(x, 0.012, 0.055))
	end
end

-- Plumages (tons réels du pigeon biset et de ses variantes de ville)
local PLUMES = {
	-- biset "barré" classique
	{ Body = rgb(148, 156, 174), Belly = rgb(140, 148, 166), Breast = rgb(152, 140, 160), Rump = rgb(176, 182, 196), Head = rgb(116, 122, 144), Neck = rgb(70, 132, 108), Sheen = rgb(128, 80, 146), Wing = rgb(172, 178, 192), Bar = rgb(34, 34, 42), Prim = rgb(70, 74, 88), Tail = rgb(136, 142, 160), Band = rgb(40, 40, 48) },
	-- écaillé (ailes mouchetées plus sombres)
	{ Body = rgb(118, 122, 138), Belly = rgb(112, 116, 132), Breast = rgb(126, 108, 126), Rump = rgb(140, 144, 158), Head = rgb(92, 96, 116), Neck = rgb(62, 120, 100), Sheen = rgb(112, 70, 132), Wing = rgb(106, 110, 124), Bar = rgb(46, 46, 56), Prim = rgb(56, 58, 70), Tail = rgb(110, 114, 130), Band = rgb(36, 36, 44) },
	-- argenté (clair)
	{ Body = rgb(196, 198, 206), Belly = rgb(188, 190, 198), Breast = rgb(198, 184, 194), Rump = rgb(214, 214, 220), Head = rgb(160, 162, 178), Neck = rgb(104, 158, 134), Sheen = rgb(158, 110, 170), Wing = rgb(212, 212, 218), Bar = rgb(92, 92, 104), Prim = rgb(124, 124, 136), Tail = rgb(186, 188, 196), Band = rgb(96, 96, 106) },
	-- rouge cendré (brun rosé, barres brunes)
	{ Body = rgb(178, 152, 142), Belly = rgb(170, 146, 138), Breast = rgb(184, 140, 136), Rump = rgb(196, 178, 170), Head = rgb(142, 114, 110), Neck = rgb(120, 136, 96), Sheen = rgb(150, 90, 120), Wing = rgb(198, 176, 162), Bar = rgb(120, 70, 64), Prim = rgb(122, 98, 92), Tail = rgb(170, 148, 140), Band = rgb(112, 76, 70) },
	-- sombre (mélanique)
	{ Body = rgb(74, 76, 88), Belly = rgb(70, 72, 84), Breast = rgb(84, 74, 88), Rump = rgb(86, 88, 100), Head = rgb(62, 64, 76), Neck = rgb(52, 108, 90), Sheen = rgb(96, 60, 116), Wing = rgb(84, 86, 98), Bar = rgb(28, 28, 34), Prim = rgb(46, 48, 58), Tail = rgb(70, 72, 84), Band = rgb(30, 30, 36) },
	-- pie (blanc taché de gris)
	{ Body = rgb(234, 232, 230), Belly = rgb(240, 238, 236), Breast = rgb(226, 214, 218), Rump = rgb(244, 242, 240), Head = rgb(150, 154, 170), Neck = rgb(98, 150, 126), Sheen = rgb(150, 104, 164), Wing = rgb(236, 234, 232), Bar = rgb(150, 152, 162), Prim = rgb(120, 122, 134), Tail = rgb(220, 220, 222), Band = rgb(120, 122, 132) },
}
local FIXED = { Beak = rgb(58, 50, 54), Cere = rgb(234, 230, 224), Eye = rgb(232, 112, 36), Pupil = rgb(16, 14, 16), Leg = rgb(212, 92, 102) }

----------------------------------------------------------------------
-- Construction
----------------------------------------------------------------------

local function newPart(parent: Instance, s: Spec, color: Color3): BasePart
	local p = Instance.new("Part")
	p.Name = s.Name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = s.Size
	p.Color = color
	p.Material = M.SmoothPlastic
	p.Reflectance = s.Shine or 0
	if s.Shape == "Ball" then
		p.Shape = Enum.PartType.Ball
	else
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	p.Parent = parent
	return p
end

local function plumeFor(seed: number): { [string]: Color3 }
	if seed % 11 == 0 then
		return PLUMES[6]
	elseif seed % 7 == 0 then
		return PLUMES[4]
	elseif seed % 5 == 0 then
		return PLUMES[5]
	elseif seed % 4 == 0 then
		return PLUMES[3]
	elseif seed % 3 == 0 then
		return PLUMES[2]
	end
	return PLUMES[1]
end

local function vec3Attr(folder: Instance, name: string): Vector3?
	local v = folder:GetAttribute(name)
	return typeof(v) == "Vector3" and v or nil
end

-- Perchoirs : dessus des lanternes des lampadaires de la place, margelle de
-- la fontaine (milieu de chaque pan)
local function perches(plaza: Instance): { Vector3 }
	local list = {}
	local center = vec3Attr(plaza, "FxCenter")
	local lamps = vec3Attr(plaza, "FxLamps")
	if center and lamps then
		local r, top, n = lamps.X, lamps.Y, math.floor(lamps.Z)
		for i = 0, n - 1 do
			local a = (i + 0.5) / n * math.pi * 2
			local d = Vector3.new(math.sin(a), 0, math.cos(a))
			local along = Vector3.new(d.Z, 0, -d.X)
			for _, z in ipairs({ -1.9, 1.9 }) do
				-- (dessus du chapeau de la lanterne : 10,5 + 0,35 + 0,15 = sommet - 0,5)
				table.insert(list, center + d * r + along * z + Vector3.new(0, top - 0.5, 0))
			end
		end
	end
	local base = vec3Attr(plaza, "FxFountainBase")
	if base then
		for i = 0, 11 do
			local a = (i + 0.5) / 12 * math.pi * 2
			table.insert(list, base + Vector3.new(math.sin(a) * 13.5, 3.2, math.cos(a) * 13.5))
		end
	end
	return list
end

function TownPigeons.Build(folder: Instance, plaza: Instance): any
	local model = Instance.new("Model")
	model.Name = "Pigeons"
	model.Parent = folder
	local P = {
		List = {},
		Flocks = {},
		Parts = {},
		Frames = {},
		Homes = {},
		Perches = perches(plaza),
		Taken = {},
		Time = 0,
		Center = vec3Attr(plaza, "FxCenter") or Vector3.new(0, 0, 0),
	}
	for i = 1, 4 do
		local home = vec3Attr(plaza, "FxFlock" .. i)
		if home then
			table.insert(P.Homes, home + Vector3.new(0, 0.12, 0))
		end
	end
	for h, home in ipairs(P.Homes) do
		local flock = { Id = h, Home = home, Air = false, Timer = 20 + h * 17, Birds = {} }
		table.insert(P.Flocks, flock)
		for j = 1, PER_FLOCK do
			local seed = h * 10 + j
			local rng = Random.new(h * 31 + j * 7)
			-- place de départ libre (LAND_GAP de tout autre pigeon, quel que soit le cap)
			local pos = home
			for try = 1, 40 do
				local a = rng:NextNumber(0, math.pi * 2)
				local r = math.sqrt(rng:NextNumber()) * (HOME_R + math.floor(try / 12))
				local p = home + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
				local ok = true
				for _, other in ipairs(P.List) do
					if Vector3.new(other.Pos.X - p.X, 0, other.Pos.Z - p.Z).Magnitude < LAND_GAP then
						ok = false
						break
					end
				end
				if ok then
					pos = p
					break
				end
			end
			local yaw = rng:NextNumber(0, math.pi * 2)
			local bird = {
				Id = #P.List + 1,
				Pos = pos,
				Ground = home.Y,
				Yaw = yaw,
				YawTarget = yaw,
				Flock = flock,
				Slot = j,
				Rng = rng,
				Mode = "idle",
				Timer = rng:NextNumber(0.2, 1.5),
				Clock = 0,
				Target = nil,
				Walked = 0,
				StepPhase = 0,
				HeadYaw = 0,
				HeadYawTarget = 0,
				HeadTimer = rng:NextNumber(0.3, 1.2),
				Spread = 0,
				TailSpread = 0,
				Flap = 0,
				FlapPhase = rng:NextNumber(),
				Burst = 0,
				Pitch = 0,
				Bank = 0,
				Fly = nil,
				Perched = false,
				PerchIndex = nil,
				First = #P.Parts + 1,
			}
			local plume = plumeFor(seed)
			for _, s in ipairs(SPECS) do
				local color = plume[s.Color] or FIXED[s.Color] or rgb(128, 128, 128)
				local p = newPart(model, s, color)
				p.CFrame = CFrame.new(pos) * s.Fold
				table.insert(P.Parts, p)
				table.insert(P.Frames, p.CFrame)
			end
			table.insert(P.List, bird)
			table.insert(flock.Birds, bird)
		end
	end
	return P
end

function TownPigeons.Count(P: any): number
	return P and #P.List or 0
end

-- Un pigeon est-il assez près de `point` pour être animé à chaque image ?
function TownPigeons.Near(P: any, point: Vector3, radius: number): boolean
	if not P then
		return false
	end
	for _, flock in ipairs(P.Flocks) do
		if flock.Air or (flock.Home - point).Magnitude < radius then
			return true
		end
	end
	return false
end

----------------------------------------------------------------------
-- Trajectoires de vol : courbes d'Hermite (position ET vitesse continues)
----------------------------------------------------------------------

local function hermite(seg: any, t: number): (Vector3, Vector3)
	local d = seg.Dur
	local u = math.clamp(t / d, 0, 1)
	local u2, u3 = u * u, u * u * u
	local h00 = 2 * u3 - 3 * u2 + 1
	local h10 = u3 - 2 * u2 + u
	local h01 = -2 * u3 + 3 * u2
	local h11 = u3 - u2
	local m0, m1 = seg.V0 * d, seg.V1 * d
	local pos = seg.P0 * h00 + m0 * h10 + seg.P1 * h01 + m1 * h11
	local d00 = 6 * u2 - 6 * u
	local d10 = 3 * u2 - 4 * u + 1
	local d01 = -6 * u2 + 6 * u
	local d11 = 3 * u2 - 2 * u
	local vel = (seg.P0 * d00 + m0 * d10 + seg.P1 * d01 + m1 * d11) / d
	return pos, vel
end

local function seg(kind: string, p0: Vector3, v0: Vector3, p1: Vector3, v1: Vector3, dur: number): any
	return { Kind = kind, P0 = p0, V0 = v0, P1 = p1, V1 = v1, Dur = math.max(0.2, dur) }
end

local function horizontal(v: Vector3): Vector3
	local h = Vector3.new(v.X, 0, v.Z)
	if h.Magnitude < 1e-3 then
		return Vector3.new(0, 0, -1)
	end
	return h.Unit
end

-- Vol court (vers un perchoir, ou pour redescendre) : bond, montée, arrivée freinée
local function hopPlan(from: Vector3, to: Vector3, delay: number): any
	local dir = horizontal(to - from)
	local dist = (to - from).Magnitude
	local dur = math.clamp(dist / 8, 1.1, 3.6)
	local climb = math.max(0, to.Y - from.Y)
	local v0 = dir * 2.5 + Vector3.new(0, 6 + climb * 0.8, 0)
	local v1 = dir * 1.6 + Vector3.new(0, -1.2, 0)
	return { Segs = { seg("land", from, v0, to, v1, dur) }, I = 1, T = -delay, From = from }
end

-- Tour de la place en formation puis atterrissage à `to`
local function tourPlan(P: any, bird: any, to: Vector3, delay: number): any
	local C = P.Center
	local from = bird.Pos
	local slot = bird.Slot
	-- décalages de formation (chaque pigeon a son couloir : jamais l'un dans l'autre)
	local lateral = ((slot - 1) % 3 - 1) * 1.7
	local vertical = math.floor((slot - 1) / 3) * 1.3 - 0.6 + (bird.Flock.Id % 2) * 0.7
	local R = 23 + lateral + bird.Flock.Id * 0.9
	local H = C.Y + 10.5 + vertical
	local function orbitPoint(a: number): (Vector3, Vector3)
		local p = Vector3.new(C.X + math.sin(a) * R, H, C.Z + math.cos(a) * R)
		-- (sens horaire vu du dessus : a décroît)
		local t = Vector3.new(-math.cos(a), 0, math.sin(a))
		return p, t * FLY_SPEED
	end
	local rel = from - C
	local a0 = math.atan2(rel.X, rel.Z) - 0.5
	local segs = {}
	local p1, v1 = orbitPoint(a0)
	local out = horizontal(rel)
	table.insert(segs, seg("up", from, out * 2 + Vector3.new(0, 7, 0), p1, v1, 1.5))
	-- 1 tour et quart, par quarts de cercle (tangentes = vitesse de croisière)
	local relTo = to - C
	local aTo = math.atan2(relTo.X, relTo.Z)
	local turns = 4 + math.floor(((a0 - aTo) % (math.pi * 2)) / (math.pi / 2))
	local a = a0
	local quarter = math.pi / 2
	local qDur = R * quarter / FLY_SPEED
	for _ = 1, turns do
		local pa, va = orbitPoint(a)
		local pb, vb = orbitPoint(a - quarter)
		-- (tangentes d'Hermite d'un quart de cercle : R·π/2 ≈ bonne approximation)
		table.insert(segs, seg("cruise", pa, va, pb, vb, qDur))
		a -= quarter
	end
	local pe, ve = orbitPoint(a)
	local dist = (to - pe).Magnitude
	local dir = horizontal(to - pe)
	table.insert(segs, seg("land", pe, ve, to, dir * 1.8 + Vector3.new(0, -1.3, 0), math.clamp(dist / (FLY_SPEED * 0.55), 1.6, 4.2)))
	return { Segs = segs, I = 1, T = -delay, From = from }
end

----------------------------------------------------------------------
-- Places libres (atterrissage, marche)
----------------------------------------------------------------------

-- Distance horizontale de `p` à la place la plus proche prise par un autre
-- pigeon : où il se tient (au sol, ou accroupi avant l'envol), où il va se
-- poser, où il marche
local function nearestTaken(P: any, me: any, p: Vector3): number
	local best = math.huge
	local function consider(q: Vector3?, margin: number?)
		if q and math.abs(q.Y - p.Y) < 1.5 then
			local d = Vector3.new(q.X - p.X, 0, q.Z - p.Z).Magnitude - (margin or 0)
			if d < best then
				best = d
			end
		end
	end
	for _, other in ipairs(P.List) do
		if other ~= me then
			if other.Fly then
				-- (place d'atterrissage : cap inconnu -> on la garde plus large)
				consider(other.Dest, LAND_GAP - 2 * BIRD_R)
				if other.Fly.T < 0 then
					consider(other.Pos)
				end
			else
				consider(other.Pos)
			end
			consider(other.Target)
		end
	end
	return best
end

local function clearOf(P: any, me: any, p: Vector3, gap: number): boolean
	return nearestTaken(P, me, p) >= gap
end

local function freeSpot(P: any, me: any, center: Vector3, radius: number, rng: Random, gap: number?): Vector3?
	for _ = 1, 14 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = math.sqrt(rng:NextNumber()) * radius
		local p = center + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		if clearOf(P, me, p, gap or (2 * BIRD_R + 0.15)) then
			return p
		end
	end
	return nil
end

local function freePerch(P: any, near: Vector3, rng: Random): (Vector3?, number?)
	local best, bestI, bestD = nil, nil, math.huge
	for i, p in ipairs(P.Perches) do
		if not P.Taken[i] then
			local d = (p - near).Magnitude + rng:NextNumber(0, 14)
			if d < bestD then
				best, bestI, bestD = p, i, d
			end
		end
	end
	return best, bestI
end

local function releasePerch(P: any, bird: any)
	if bird.PerchIndex then
		P.Taken[bird.PerchIndex] = nil
		bird.PerchIndex = nil
	end
end

local function startFly(bird: any, plan: any, dest: Vector3, perched: boolean)
	bird.Fly = plan
	bird.Dest = dest
	bird.Mode = "fly"
	bird.Target = nil
	bird.Perched = false
	bird.WillPerch = perched
	bird.Clock = 0
	bird.Burst = 1
end

-- Tout le groupe s'envole (loin de `threat` si donné) et fait le tour de la place
local function flockTakeOff(P: any, flock: any, threat: Vector3?)
	if flock.Air then
		return
	end
	-- nouveau coin de la place : le plus loin de la menace (ou un autre au hasard)
	local best, bestScore = flock.Home, -math.huge
	for _, home in ipairs(P.Homes) do
		local score = threat and (home - threat).Magnitude or (home ~= flock.Home and 10 + (home - flock.Home).Magnitude * 0.01 or 0)
		score += (home ~= flock.Home) and 5 or 0
		if score > bestScore then
			best, bestScore = home, score
		end
	end
	flock.Home = best
	flock.Air = true
	flock.Timer = flock.Birds[1] and flock.Birds[1].Rng:NextNumber(RELOCATE_MIN, RELOCATE_MAX) or 60
	for k, bird in ipairs(flock.Birds) do
		if bird.Mode ~= "fly" and not bird.Perched then
			local rng = bird.Rng
			releasePerch(P, bird)
			local dest: Vector3? = nil
			local perched = false
			if rng:NextNumber() < 0.25 then
				local perch, index = freePerch(P, best, rng)
				if perch and index then
					P.Taken[index] = true
					bird.PerchIndex = index
					dest, perched = perch, true
				end
			end
			if not dest then
				dest = freeSpot(P, bird, best, HOME_R - 0.5, rng, LAND_GAP) or (best + Vector3.new(rng:NextNumber(-3, 3), 0, rng:NextNumber(-3, 3)))
			end
			-- (réaction décalée : ils ne partent pas tous à la même image)
			startFly(bird, tourPlan(P, bird, dest :: Vector3, (k - 1) * 0.16 + rng:NextNumber(0, 0.12)), dest :: Vector3, perched)
		end
	end
end

----------------------------------------------------------------------
-- Comportement
----------------------------------------------------------------------

local function yawTo(from: Vector3, to: Vector3, fallback: number): number
	local d = Vector3.new(to.X - from.X, 0, to.Z - from.Z)
	if d.Magnitude < 0.05 then
		return fallback
	end
	return math.atan2(-d.X, -d.Z)
end

local function angleDiff(a: number, b: number): number
	return (a - b + math.pi) % (math.pi * 2) - math.pi
end

local function approach(value: number, target: number, rate: number, dt: number): number
	local k = 1 - math.exp(-rate * dt)
	return value + (target - value) * k
end

local function peopleNear(): { Vector3 }
	local folder = script.Parent
	local mod = folder and folder:FindFirstChild("TownPeople")
	if not mod then
		return {}
	end
	local ok, TownPeople = pcall(require, mod)
	if ok and type(TownPeople) == "table" and type(TownPeople.Positions) == "function" then
		local ok2, list = pcall(TownPeople.Positions)
		if ok2 and type(list) == "table" then
			return list
		end
	end
	return {}
end

-- Nouveau comportement au sol
local function chooseGround(P: any, bird: any)
	local rng = bird.Rng
	local r = rng:NextNumber()
	bird.Clock = 0
	bird.Target = nil
	if r < 0.3 then
		bird.Mode, bird.Timer = "peck", rng:NextNumber(0.9, 1.8)
	elseif r < 0.62 then
		local spot = freeSpot(P, bird, bird.Flock.Home, HOME_R, rng)
		if spot and (spot - bird.Pos).Magnitude > 0.6 then
			bird.Mode, bird.Timer = "walk", 6
			bird.Target = spot
		else
			bird.Mode, bird.Timer = "idle", rng:NextNumber(0.6, 1.4)
		end
	elseif r < 0.74 then
		bird.Mode, bird.Timer = "idle", rng:NextNumber(0.8, 2)
	elseif r < 0.82 then
		bird.Mode, bird.Timer = "coo", rng:NextNumber(1.6, 2.6)
	elseif r < 0.89 then
		bird.Mode, bird.Timer = "preen", rng:NextNumber(1, 2)
	elseif r < 0.93 then
		bird.Mode, bird.Timer = "shake", 0.5
	elseif r < 0.96 then
		-- (parfois un pigeon va se percher tout seul)
		local perch, index = freePerch(P, bird.Pos, rng)
		if perch and index then
			P.Taken[index] = true
			bird.PerchIndex = index
			startFly(bird, hopPlan(bird.Pos, perch, 0.25), perch, true)
		else
			bird.Mode, bird.Timer = "idle", 1
		end
	else
		bird.Mode, bird.Timer = "idle", rng:NextNumber(0.5, 1.5)
	end
end

-- Fin d'un vol : posé
local function land(P: any, bird: any)
	bird.Pos = bird.Dest or bird.Pos
	bird.Fly = nil
	bird.Dest = nil
	bird.Perched = bird.WillPerch == true
	bird.WillPerch = nil
	bird.Ground = bird.Pos.Y
	bird.Mode = bird.Perched and "perch" or "settle"
	bird.Timer = bird.Perched and bird.Rng:NextNumber(PERCH_MIN, PERCH_MAX) or 0.45
	bird.Clock = 0
	if bird.Perched then
		bird.YawTarget = yawTo(bird.Pos, P.Center, bird.Yaw) + math.pi
	end
	-- le groupe est posé quand tous ses pigeons le sont
	local flock = bird.Flock
	if flock.Air then
		local all = true
		for _, b in ipairs(flock.Birds) do
			if b.Fly then
				all = false
				break
			end
		end
		if all then
			flock.Air = false
		end
	end
end

-- Poses : tout est dans le repère du pigeon (pieds au sol, bec vers -Z)
local function pose(P: any, bird: any, dt: number)
	local mode = bird.Mode
	local rng = bird.Rng
	local lift, pitch, roll = 0, 0, 0
	local headFwd, headPitch, headLift = 0, 0, 0
	local legA, legLift = { 0, 0 }, { 0, 0 }
	local tailPitch, tailSpreadTarget = 0, 0
	local spreadTarget = 0
	local flapTarget, flapFreq, flapMean = 0, 0, 0
	local center = false -- (bascule autour du centre du corps : en vol)

	-- tête : petites rotations par à-coups (comme un vrai pigeon)
	bird.HeadTimer -= dt
	if bird.HeadTimer <= 0 then
		bird.HeadTimer = rng:NextNumber(0.35, 1.4)
		bird.HeadYawTarget = (mode == "walk" or mode == "fly") and rng:NextNumber(-0.15, 0.15) or rng:NextNumber(-0.7, 0.7)
	end
	bird.HeadYaw = approach(bird.HeadYaw, bird.HeadYawTarget, 22, dt)

	if mode == "fly" then
		local plan = bird.Fly
		plan.T += dt
		if plan.T < 0 then
			-- accroupi, prêt à bondir
			local k = math.clamp(1 + plan.T / 0.2, 0, 1)
			lift = -0.05 * k
			pitch = -0.12 * k
			spreadTarget = 0.2 * k
			bird.Pos = plan.From
			-- (se tourne déjà vers là où il va s'envoler)
			local first = plan.Segs[1]
			if first then
				local h = Vector3.new(first.V0.X, 0, first.V0.Z)
				if h.Magnitude > 0.1 then
					local d = angleDiff(math.atan2(-h.X, -h.Z), bird.Yaw)
					bird.Yaw += math.clamp(d, -9 * dt, 9 * dt)
				end
			end
		else
			local s = plan.Segs[plan.I]
			while s and plan.T > s.Dur do
				plan.T -= s.Dur
				plan.I += 1
				s = plan.Segs[plan.I]
				-- début de la descente : la place visée est-elle toujours libre ?
				-- (sinon une autre, tout près : jamais posé sur un voisin)
				if s and s.Kind == "land" and not bird.WillPerch and plan.T < 0.05 and not clearOf(P, bird, s.P1, LAND_GAP) then
					local spot = freeSpot(P, bird, s.P1, 2.5, bird.Rng, LAND_GAP)
					if spot then
						s.P1 = spot
						bird.Dest = spot
					end
				end
			end
			if not s then
				land(P, bird)
				pose(P, bird, 0)
				return
			end
			-- pendant la descente, la place visée est surveillée : prise entre-temps
			-- (un voisin s'y est poussé) -> nouvelle trajectoire vers une place
			-- libre, qui part de la position ET de la vitesse actuelles (sans saut)
			if s.Kind == "land" and not bird.WillPerch and plan.T < s.Dur * 0.8 then
				bird.Watch = (bird.Watch or 0) - dt
				if bird.Watch <= 0 then
					bird.Watch = 0.15
					if not clearOf(P, bird, s.P1, LAND_GAP - 0.1) then
						local spot = freeSpot(P, bird, s.P1, 2.5, bird.Rng, LAND_GAP) or freeSpot(P, bird, bird.Flock.Home, HOME_R + 1.5, bird.Rng, LAND_GAP)
						if spot then
							local p0, v0 = hermite(s, plan.T)
							local ns = seg("land", p0, v0, spot, s.V1, math.max(0.9, s.Dur - plan.T))
							plan.Segs[plan.I] = ns
							plan.T = 0
							s = ns
							bird.Dest = spot
						end
					end
				end
			end
			local pos, vel = hermite(s, plan.T)
			bird.Pos = pos
			local speed = vel.Magnitude
			if Vector3.new(vel.X, 0, vel.Z).Magnitude > 0.4 then
				-- cap = direction du vol, tourné progressivement (9 rad/s au plus)
				local newYaw = math.atan2(-vel.X, -vel.Z)
				local turn = math.clamp(angleDiff(newYaw, bird.Yaw), -9 * dt, 9 * dt)
				bird.Yaw += turn
				bird.YawTarget = bird.Yaw
				bird.Bank = approach(bird.Bank, math.clamp(-turn / math.max(dt, 1 / 120) * 0.12, -0.55, 0.55), 5, dt)
			end
			local climbPitch = speed > 0.1 and math.asin(math.clamp(vel.Y / speed, -1, 1)) or 0
			spreadTarget = 1
			center = true
			local u = plan.T / s.Dur
			if s.Kind == "up" then
				pitch = math.clamp(climbPitch, -0.3, 0.9) * 0.8
				flapTarget, flapFreq, flapMean = 0.95, 7, 0.15
				legA = { 1.2, 1.2 }
				tailSpreadTarget = 0.6
			elseif s.Kind == "cruise" then
				pitch = climbPitch * 0.6
				-- rafales de battements, puis plané ailes en V
				bird.Burst -= dt
				if bird.Burst < -1.3 then
					bird.Burst = rng:NextNumber(0.6, 1.1)
				end
				if bird.Burst > 0 then
					flapTarget, flapFreq, flapMean = 0.65, 6, 0.1
				else
					flapTarget, flapFreq, flapMean = 0.04, 2, 0.32
				end
				legA = { 1.3, 1.3 }
			else -- "land"
				if u < 0.55 then
					-- descente en plané
					pitch = climbPitch * 0.5
					flapTarget, flapFreq, flapMean = 0.05, 2, 0.3
					legA = { 1.3, 1.3 }
				else
					-- freinage : corps redressé, ailes hautes qui battent, queue en éventail, pattes en avant
					local k = (u - 0.55) / 0.45
					pitch = 0.2 + 0.45 * k
					flapTarget, flapFreq, flapMean = 0.75, 5.5, 0.35
					legA = { 1.3 - 1.8 * k, 1.3 - 1.8 * k }
					tailSpreadTarget = 1
					tailPitch = 0.35 * k
				end
			end
			roll = bird.Bank
		end
	elseif mode == "walk" then
		local target = bird.Target
		if not target then
			bird.Mode, bird.Timer = "idle", 0.5
		else
			local want = yawTo(bird.Pos, target, bird.Yaw)
			bird.YawTarget = want
			local facing = math.abs(angleDiff(want, bird.Yaw)) < 0.6
			local speed = (bird.Hurry and bird.Hurry > 0) and WALK_SPEED * 1.6 or WALK_SPEED
			if facing then
				local step = Vector3.new(-math.sin(bird.Yaw), 0, -math.cos(bird.Yaw)) * (speed * dt)
				local nextPos = bird.Pos + step
				-- (un voisin devant : on attend / on change de but, jamais l'un dans l'autre)
				local dNext = nearestTaken(P, bird, nextPos)
				local blocked = dNext < 2 * BIRD_R + 0.05 and dNext < nearestTaken(P, bird, bird.Pos)
				if not blocked then
					-- (le corps entier : bec et queue compris)
					local cNext = bodyClear(P, bird, nextPos, bird.Yaw)
					blocked = cNext < CAPSULE_MARGIN and cNext < bodyClear(P, bird, bird.Pos, bird.Yaw)
				end
				if blocked then
					bird.Target = freeSpot(P, bird, bird.Flock.Home, HOME_R, rng)
					if not bird.Target then
						bird.Mode, bird.Timer = "idle", 0.6
					end
				else
					bird.Pos = nextPos
					bird.StepPhase += dt / STEP_T
				end
				if (Vector3.new(target.X - bird.Pos.X, 0, target.Z - bird.Pos.Z)).Magnitude < 0.12 then
					bird.Target = nil
					bird.Mode, bird.Timer = "idle", rng:NextNumber(0.2, 0.8)
				end
			else
				-- on tourne sur place à petits pas
				bird.StepPhase += dt / STEP_T * 0.8
			end
			-- un pas = un hochement : la tête AVANCE vite (35 %), puis reste
			-- immobile dans l'espace pendant que le corps la rattrape (65 %)
			local u = bird.StepPhase % 1
			local amp = speed * STEP_T * 0.65 / 2
			if u < 0.35 then
				headFwd = -amp + (u / 0.35) * 2 * amp
			else
				headFwd = amp - ((u - 0.35) / 0.65) * 2 * amp
			end
			local foot = math.floor(bird.StepPhase) % 2 + 1
			local swing = math.sin(u * math.pi)
			legA[foot] = -0.45 * swing + 0.2
			legLift[foot] = 0.045 * swing
			legA[3 - foot] = 0.15 * (1 - u)
			roll = (foot == 1 and 1 or -1) * 0.05 * swing
			lift = 0.012 * swing
			pitch = -0.04
		end
	elseif mode == "peck" then
		-- 2 à 3 coups de bec : le corps bascule, la tête plonge
		local c = bird.Clock
		local k = math.clamp(c / 0.2, 0, 1)
		pitch = -0.32 * k
		local beat = math.max(0, math.sin(c * 11))
		headPitch = (0.75 + 0.55 * beat) * k
		headFwd = 0.04 * k
		tailPitch = -0.2 * k
	elseif mode == "coo" then
		-- roucoulade : courbettes, queue étalée qui traîne, petit tour sur lui-même
		local c = bird.Clock
		local bow = math.max(0, math.sin(c * 5.5))
		headPitch = -0.3 + 0.65 * bow
		pitch = -0.1 * bow
		tailSpreadTarget = 1
		tailPitch = -0.35
		lift = 0.02 * bow
		bird.YawTarget = bird.Yaw + 1.2
		local foot = math.floor(c * 5) % 2 + 1
		legA[foot] = -0.2
		legLift[foot] = 0.03
	elseif mode == "preen" then
		-- toilette : la tête plonge vers l'aile
		headPitch = 0.9
		bird.HeadYawTarget = 1.9 * (bird.Id % 2 == 0 and 1 or -1)
		spreadTarget = 0.12 + 0.06 * math.sin(bird.Clock * 14)
	elseif mode == "shake" then
		-- s'ébroue : petit frisson des ailes et de la queue
		spreadTarget = 0.25
		roll = math.sin(bird.Clock * 40) * 0.06
		tailSpreadTarget = 0.6
	elseif mode == "settle" then
		-- juste posé : on replie les ailes
		spreadTarget = 0
		tailSpreadTarget = 0.3
	elseif mode == "perch" then
		headPitch = math.sin(bird.Clock * 0.9) * 0.15
	end

	-- lissage des ailes / queue / battements (sans à-coup)
	bird.Spread = approach(bird.Spread, spreadTarget, spreadTarget > bird.Spread and 12 or 7, dt)
	bird.TailSpread = approach(bird.TailSpread, tailSpreadTarget, 8, dt)
	bird.Flap = approach(bird.Flap, flapTarget, 10, dt)
	bird.FlapMean = approach(bird.FlapMean or 0, flapMean, 6, dt)
	bird.FlapPhase = (bird.FlapPhase + dt * math.max(flapFreq, 1)) % 1
	if mode ~= "fly" then
		-- virage progressif vers le cap voulu (3,5 rad/s au plus)
		local d = angleDiff(bird.YawTarget, bird.Yaw)
		local newYaw = bird.Yaw + math.clamp(d, -3.5 * dt, 3.5 * dt)
		-- (on ne tourne pas sa queue dans un voisin)
		if newYaw ~= bird.Yaw and not bird.Perched then
			local cNew = bodyClear(P, bird, bird.Pos, newYaw)
			if cNew >= CAPSULE_MARGIN or cNew >= bodyClear(P, bird, bird.Pos, bird.Yaw) then
				bird.Yaw = newYaw
			end
		else
			bird.Yaw = newYaw
		end
		bird.Bank = approach(bird.Bank, 0, 6, dt)
	end
	bird.Pitch = approach(bird.Pitch, pitch, center and 6 or 14, dt)
	-- toute la pose est LISSÉE (constante de temps ~50 ms) : on passe d'un
	-- geste à l'autre (picorer -> marcher, vol -> sol) sans aucun saut
	local S = bird.Pose
	if not S then
		S = { Lift = 0, Roll = 0, HeadFwd = 0, HeadPitch = 0, HeadLift = 0, LegA = { 0, 0 }, LegLift = { 0, 0 }, TailPitch = 0, PivotY = 0 }
		bird.Pose = S
	end
	local k = 1 - math.exp(-20 * dt)
	local kf = 1 - math.exp(-35 * dt) -- (hochement de tête : plus vif)
	S.Lift += (lift - S.Lift) * k
	S.Roll += (roll - S.Roll) * k
	S.HeadFwd += (headFwd - S.HeadFwd) * kf
	S.HeadPitch += (headPitch - S.HeadPitch) * k
	S.HeadLift += (headLift - S.HeadLift) * k
	for i = 1, 2 do
		S.LegA[i] += (legA[i] - S.LegA[i]) * k
		S.LegLift[i] += (legLift[i] - S.LegLift[i]) * k
	end
	S.TailPitch += (tailPitch - S.TailPitch) * k
	-- pivot de la bascule : pieds au sol, centre du corps en vol (glissé)
	S.PivotY += ((center and 0.37 or 0) - S.PivotY) * (1 - math.exp(-6 * dt))
end

-- Écrit les CFrames des pièces d'un pigeon dans `frames`
local function write(bird: any, frames: { CFrame })
	local ps = bird.Pose
	local pivot = CFrame.new(0, ps.PivotY, 0)
	local root = CFrame.new(bird.Pos + Vector3.new(0, ps.Lift, 0)) * CFrame.Angles(0, bird.Yaw, 0) * pivot * CFrame.Angles(bird.Pitch, 0, ps.Roll) * pivot:Inverse()
	local head = root * CFrame.new(0, ps.HeadLift, -ps.HeadFwd) * NECK_P * CFrame.Angles(0, bird.HeadYaw, 0) * CFrame.Angles(-ps.HeadPitch, 0, 0) * NECK_INV
	local theta = bird.FlapMean + bird.Flap * math.sin(bird.FlapPhase * math.pi * 2)
	local theta2 = bird.Flap * 0.45 * math.sin((bird.FlapPhase - 0.1) * math.pi * 2)
	local spread = bird.Spread
	local wings = {}
	local wrists = {}
	for i, sx in ipairs({ -1, 1 }) do
		wings[i] = root * SHOULDER[i] * CFrame.Angles(0, 0, sx * theta * spread) * SHOULDER_INV[i]
		wrists[i] = WRIST[i] * CFrame.Angles(0, 0, sx * theta2 * spread) * WRIST_INV[i]
	end
	local tails = {}
	for i, sx in ipairs({ -1, 1 }) do
		tails[i] = root * TAIL_P * CFrame.Angles(ps.TailPitch, sx * 0.3 * bird.TailSpread, 0) * TAIL_INV
	end
	local legs = {}
	for i = 1, 2 do
		legs[i] = root * CFrame.new(0, ps.LegLift[i], 0) * HIP[i] * CFrame.Angles(ps.LegA[i], 0, 0) * HIP_INV[i]
	end
	local base = bird.First - 1
	for k, s in ipairs(SPECS) do
		local g = s.Group
		local cf
		if g == G_BODY then
			cf = root * s.Fold
		elseif g == G_HEAD then
			cf = head * s.Fold
		elseif g == G_WING_L or g == G_WING_R then
			local w = g == G_WING_L and 1 or 2
			local open = s.Open :: CFrame
			if s.Hand then
				open = wrists[w] * open
			end
			cf = wings[w] * (spread < 0.01 and s.Fold or (spread > 0.99 and open or s.Fold:Lerp(open, spread)))
		elseif g == G_TAIL_L then
			cf = tails[1] * s.Fold
		elseif g == G_TAIL_R then
			cf = tails[2] * s.Fold
		elseif g == G_LEG_L then
			cf = legs[1] * s.Fold
		else
			cf = legs[2] * s.Fold
		end
		frames[base + k] = cf
	end
end

-- Corps d'un pigeon vu du dessus : segment bec (0,5 devant) -> queue (0,72
-- derrière), demi-largeur 0,21. Renvoie l'espace libre entre deux corps
-- (négatif = ils se touchent) et les deux points les plus proches.
local function segment(pos: Vector3, yaw: number): (Vector3, Vector3)
	local f = Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))
	local p = Vector3.new(pos.X, 0, pos.Z)
	return p + f * 0.5, p - f * 0.72
end
local function closestOn(a0: Vector3, a1: Vector3, p: Vector3): Vector3
	local d = a1 - a0
	local t = math.clamp((p - a0):Dot(d) / math.max(d:Dot(d), 1e-6), 0, 1)
	return a0 + d * t
end
local function cross2(o: Vector3, p: Vector3, q: Vector3): number
	return (p.X - o.X) * (q.Z - o.Z) - (p.Z - o.Z) * (q.X - o.X)
end
local function gapAt(apos: Vector3, ayaw: number, bpos: Vector3, byaw: number): (number, Vector3, Vector3)
	local a0, a1 = segment(apos, ayaw)
	local b0, b1 = segment(bpos, byaw)
	-- (corps qui se croisent en X : distance nulle)
	local d1, d2 = cross2(a0, a1, b0), cross2(a0, a1, b1)
	local d3, d4 = cross2(b0, b1, a0), cross2(b0, b1, a1)
	if d1 * d2 < 0 and d3 * d4 < 0 then
		return -2 * BODY_HALF, Vector3.new(apos.X, 0, apos.Z), Vector3.new(bpos.X, 0, bpos.Z)
	end
	-- (distance segment-segment en 2D : minimum des 4 projections d'extrémités)
	local best, pa, pb = math.huge, a0, b0
	for _, c in ipairs({
		{ a0, closestOn(b0, b1, a0) },
		{ a1, closestOn(b0, b1, a1) },
		{ closestOn(a0, a1, b0), b0 },
		{ closestOn(a0, a1, b1), b1 },
	}) do
		local d = (c[1] - c[2]).Magnitude
		if d < best then
			best, pa, pb = d, c[1], c[2]
		end
	end
	return best - 2 * BODY_HALF, pa, pb
end
capsuleGap = function(a: any, b: any): (number, Vector3, Vector3)
	return gapAt(a.Pos, a.Yaw, b.Pos, b.Yaw)
end

-- Espace libre mini entre le corps de `me` (placé en pos, yaw) et les
-- pigeons posés au même niveau (ou accroupis avant l'envol)
bodyClear = function(P: any, me: any, pos: Vector3, yaw: number): number
	local best = math.huge
	for _, other in ipairs(P.List) do
		if other ~= me and not other.Perched and (not other.Fly or other.Fly.T < 0) and math.abs(other.Pos.Y - pos.Y) < 1 then
			local g = gapAt(pos, yaw, other.Pos, other.Yaw)
			if g < best then
				best = g
			end
		end
	end
	return best
end

function TownPigeons.Step(P: any, dt: number, avatar: Vector3?)
	if not P then
		return
	end
	dt = math.clamp(dt, 0, 0.1)
	P.Time += dt
	-- menaces : l'avatar + les passants proches (relus 4 fois / s)
	P.PeopleClock = (P.PeopleClock or 0) - dt
	if P.PeopleClock <= 0 then
		P.PeopleClock = 0.25
		P.People = peopleNear()
	end
	local threats = {}
	if avatar then
		table.insert(threats, { Pos = avatar, Scale = 1 })
	end
	for _, q in ipairs(P.People or {}) do
		table.insert(threats, { Pos = q, Scale = 0.7 })
	end
	-- groupes : envol si quelqu'un arrive trop près, ou de temps en temps
	for _, flock in ipairs(P.Flocks) do
		if not flock.Air then
			flock.Timer -= dt
			local threat: Vector3? = nil
			for _, bird in ipairs(flock.Birds) do
				if not bird.Fly and not bird.Perched then
					for _, t in ipairs(threats) do
						local d = Vector3.new(bird.Pos.X - t.Pos.X, 0, bird.Pos.Z - t.Pos.Z).Magnitude
						if d < SCARE_R * t.Scale and math.abs(t.Pos.Y - bird.Pos.Y) < 8 then
							threat = t.Pos
							break
						elseif d < WARY_R * t.Scale and math.abs(t.Pos.Y - bird.Pos.Y) < 8 and bird.Mode ~= "walk" then
							-- on s'écarte en marchant (vite)
							local away = horizontal(bird.Pos - t.Pos)
							local spot = bird.Pos + away * 1.6
							if clearOf(P, bird, spot, 2 * BIRD_R + 0.1) then
								bird.Mode, bird.Timer, bird.Clock = "walk", 2, 0
								bird.Target = spot
								bird.Hurry = 1.5
							end
						end
					end
				end
				if threat then
					break
				end
			end
			if threat then
				flockTakeOff(P, flock, threat)
			elseif flock.Timer <= 0 then
				flockTakeOff(P, flock, nil)
			end
		end
	end
	-- chaque pigeon
	for _, bird in ipairs(P.List) do
		bird.Timer -= dt
		bird.Clock += dt
		if bird.Hurry then
			bird.Hurry -= dt
			if bird.Hurry <= 0 then
				bird.Hurry = nil
			end
		end
		if bird.Mode == "perch" and bird.Timer <= 0 then
			-- on redescend picorer près de son groupe
			releasePerch(P, bird)
			local spot = freeSpot(P, bird, bird.Flock.Home, HOME_R, bird.Rng, LAND_GAP) or bird.Flock.Home
			startFly(bird, hopPlan(bird.Pos, spot, 0.2), spot, false)
		elseif bird.Mode ~= "fly" and bird.Mode ~= "perch" and bird.Timer <= 0 then
			chooseGround(P, bird)
		end
		pose(P, bird, dt)
	end
	-- séparation au sol : deux pigeons ne se chevauchent JAMAIS
	local list = P.List
	for i = 1, #list do
		local a = list[i]
		if not a.Fly and not a.Perched then
			for j = i + 1, #list do
				local b = list[j]
				if not b.Fly and not b.Perched and math.abs(a.Pos.Y - b.Pos.Y) < 1 then
					local d = Vector3.new(b.Pos.X - a.Pos.X, 0, b.Pos.Z - a.Pos.Z)
					local m = d.Magnitude
					local need = 2 * BIRD_R
					if m < need then
						-- (poussée douce : 3 studs/s au plus, pas de saut visible)
						local n = m > 1e-3 and d / m or Vector3.new(1, 0, 0)
						local push = math.min((need - m) / 2 + 0.002, 3 * dt)
						a.Pos -= n * push
						b.Pos += n * push
					end
					-- corps réels (bec -> bout de la queue, orientés) : jamais sécants
					local clear, pa, pb = capsuleGap(a, b)
					if clear < CAPSULE_MARGIN then
						local sep = Vector3.new(pb.X - pa.X, 0, pb.Z - pa.Z)
						local n = sep.Magnitude > 1e-3 and sep.Unit or Vector3.new(1, 0, 0)
						local push = math.min((CAPSULE_MARGIN - clear) / 2 + 0.002, 4 * dt)
						a.Pos -= n * push
						b.Pos += n * push
					end
				end
			end
		end
	end
	local frames = P.Frames
	for _, bird in ipairs(list) do
		write(bird, frames)
	end
	workspace:BulkMoveTo(P.Parts, frames, Enum.BulkMoveMode.FireCFrameChanged)
end

-- Mesures (émulateur / tests) : écart mini entre deux pigeons au sol (centres
-- et corps réels : MinClear < 0 = deux corps qui se touchent), modes
function TownPigeons.Debug(P: any): any
	if not P then
		return {}
	end
	local minGap = math.huge
	local minClear = math.huge
	local clearInfo = ""
	local info = ""
	local modes = {}
	for i, a in ipairs(P.List) do
		modes[a.Mode] = (modes[a.Mode] or 0) + 1
		for j = i + 1, #P.List do
			local b = P.List[j]
			if not a.Fly and not b.Fly and not a.Perched and not b.Perched and math.abs(a.Pos.Y - b.Pos.Y) < 1 then
				local g = Vector3.new(a.Pos.X - b.Pos.X, 0, a.Pos.Z - b.Pos.Z).Magnitude
				local cg = capsuleGap(a, b)
				if cg < minClear then
					minClear = cg
					clearInfo = a.Mode .. "/" .. b.Mode .. " " .. a.Id .. "," .. b.Id .. string.format(" d=%.2f", g)
				end
				if g < minGap then
					minGap = g
					info = a.Mode .. "/" .. b.Mode .. " " .. a.Id .. "," .. b.Id
				end
			end
		end
	end
	return { Birds = #P.List, Parts = #P.Parts, MinGap = minGap, MinClear = minClear, ClearPair = clearInfo, MinPair = info, Modes = modes }
end

return TownPigeons
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="241">
          <Properties>
            <string name="Name">TownPlazaFx</string>
            <string name="Source"><![CDATA[--[[
	TownPlazaFx (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > TownPlazaFx

	🎠 La place centrale de Dopamine Town, côté CLIENT (v9.7, PLAZA97) :
	ce qui BOUGE (et le petit décor en plus) est construit ici, en local,
	à partir des repères que le serveur (TownPlaza) pose en attributs sur
	le dossier DopamineTown > Decor > Plaza ("FxCarouselCF", "FxBalloonTie",
	"FxBandstandCF", "FxLamps", "FxFlock1..3"…) :
	  - le MANÈGE : plateau en bois, jupe à panneaux, fût central à 8
	    miroirs encadrés d'or, 10 chevaux (corps, poitrail, croupe, encolure
	    + crinière, tête + museau + oreilles + yeux + bride + plumet, selle
	    + tapis, queue, 4 jambes au galop + sabots dorés) sur leurs barres
	    de laiton, 2 carrosses, plafond à rayons dorés, bandeau festonné à
	    32 ampoules, auvent rayé rose / crème (pyramide à 16 pans) et
	    couronne à fanion. Le plateau TOURNE (un tour en 16 s, synchronisé
	    sur l'heure du serveur : tout le monde voit la même chose) et les
	    chevaux MONTENT et DESCENDENT (déphasés) ;
	  - 9 BALLONS attachés au mât du chariot, qui se balancent ;
	  - guirlandes lumineuses entre les lampadaires, FANIONS colorés sur 4
	    travées, ampoules sous la frise du kiosque (verre mat le jour, Neon
	    la nuit : attribut "NightGlow", géré par TownAtmosphere) ;
	  - (v9.8, CITY98) 20 PIGEONS réalistes en 4 groupes (module
	    TownPigeons : picorent, marchent en hochant la tête, roucoulent,
	    s'envolent devant l'avatar ou les passants, se perchent sur les
	    lanternes et la margelle) et l'EAU animée de la fontaine (module
	    TownFountainFx : jets en arc, rideaux, ronds, pièces, sculptures).
	Tout est ancré, sans collision (sauf le plateau et le fût du manège,
	localement), sans ombre pour les petites pièces, SANS son. Animation
	par CFrame (workspace:BulkMoveTo), 30 fois par seconde au plus, et en
	PAUSE quand l'avatar (ou la caméra) est loin : manège > 170 studs,
	ballons / pigeons > 110 studs, toute la place > 260 studs.
	Aucune création / destruction d'instance par image.

	API (TownClient, via optionalModule) :
	  TownPlazaFx.Start()        à l'entrée en ville (construit ; si la
	                             place n'est pas encore là, Step réessaie)
	  TownPlazaFx.Step(dt)       à chaque image (limité à 30 Hz ici)
	  TownPlazaFx.Stop()         à la sortie (tout est détruit)
	  TownPlazaFx.Debug() -> table
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- (v9.8, FAIR98) pose du manège partagée avec le serveur (sièges où l'on monte)
local FairRides = require(ReplicatedStorage.Shared.FairRides)
local TownPigeons = require(script.Parent.TownPigeons) -- (v9.8, CITY98) pigeons 10x
local TownFountainFx = require(script.Parent.TownFountainFx) -- (v9.8, CITY98) eau de la fontaine

local TownPlazaFx = {}

local LocalPlayer = Players.LocalPlayer

local STEP = 1 / 30
local RETRY = 1 -- (s) place pas encore répliquée : on réessaie
local FAR_PLAZA = 260
local FAR_CAROUSEL = 170
local FAR_SMALL = 110
local PIGEONS_LIVE = 60 -- (v9.9) pigeons animés à chaque image à moins de 60 studs
-- (v9.8) vitesse du manège et des chevaux : FairRides (PLAZA_SPIN, CAROUSEL_BOB_*)

local M = Enum.Material
local UP = Vector3.new(0, 1, 0)
local VERTICAL = CFrame.Angles(0, 0, math.rad(90)) -- cylindre debout (axe X -> Y)

type Mover = { Parts: { BasePart }, Locals: { CFrame }, Group: { number }, Frames: { CFrame } }

local state: any = nil

----------------------------------------------------------------------
-- Fabrique de pièces (locales)
----------------------------------------------------------------------

local function newPart(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?, className: string?): BasePart
	local p = Instance.new((className or "Part") :: any) :: BasePart
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		(p :: Part).Shape = shape
	end
	p.Parent = parent
	return p
end

-- Ampoule : mate le jour, Neon la nuit (TownAtmosphere, attribut NightGlow)
local function glow(p: BasePart): BasePart
	p.Material = M.SmoothPlastic
	p:SetAttribute("NightGlow", true)
	return p
end

-- Triangle rectangle (WedgePart) : angle droit en p0, côtés le long de u
-- (l1) et de v (l2) ; renvoie taille + CFrame (dans le repère de p0/u/v)
local function triCF(p0: Vector3, u: Vector3, v: Vector3, l1: number, l2: number, t: number): (Vector3, CFrame)
	local Z = -v
	local X = u:Cross(Z)
	return Vector3.new(t, l1, l2), CFrame.fromMatrix(p0 + u * (l1 / 2) + v * (l2 / 2), X, u, Z)
end

-- Tige (cylindre) entre deux points
local function rodCF(a: Vector3, b: Vector3): CFrame
	return CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, math.rad(90), 0)
end

local function vec3Attr(folder: Instance, name: string): Vector3?
	local v = folder:GetAttribute(name)
	return typeof(v) == "Vector3" and v or nil
end

local function cfAttr(folder: Instance, name: string): CFrame?
	local v = folder:GetAttribute(name)
	return typeof(v) == "CFrame" and v or nil
end

----------------------------------------------------------------------
-- Le manège (tout ce qui tourne)
----------------------------------------------------------------------

local HORSE_COLORS = {
	{ Body = Color3.fromRGB(252, 250, 246), Mane = Color3.fromRGB(255, 150, 196), Saddle = Color3.fromRGB(214, 60, 96) },
	{ Body = Color3.fromRGB(200, 176, 240), Mane = Color3.fromRGB(255, 236, 170), Saddle = Color3.fromRGB(96, 70, 170) },
	{ Body = Color3.fromRGB(255, 206, 222), Mane = Color3.fromRGB(252, 250, 246), Saddle = Color3.fromRGB(236, 72, 140) },
	{ Body = Color3.fromRGB(170, 230, 206), Mane = Color3.fromRGB(255, 176, 120), Saddle = Color3.fromRGB(40, 140, 120) },
	{ Body = Color3.fromRGB(176, 214, 255), Mane = Color3.fromRGB(255, 255, 255), Saddle = Color3.fromRGB(56, 96, 196) },
	{ Body = Color3.fromRGB(96, 80, 90), Mane = Color3.fromRGB(255, 214, 96), Saddle = Color3.fromRGB(214, 60, 96) },
	{ Body = Color3.fromRGB(255, 226, 190), Mane = Color3.fromRGB(196, 120, 80), Saddle = Color3.fromRGB(150, 70, 170) },
	{ Body = Color3.fromRGB(226, 226, 232), Mane = Color3.fromRGB(120, 120, 140), Saddle = Color3.fromRGB(40, 140, 196) },
	{ Body = Color3.fromRGB(255, 240, 150), Mane = Color3.fromRGB(255, 130, 170), Saddle = Color3.fromRGB(214, 90, 60) },
	{ Body = Color3.fromRGB(236, 180, 255), Mane = Color3.fromRGB(150, 220, 255), Saddle = Color3.fromRGB(120, 60, 180) },
}
local GOLD = Color3.fromRGB(236, 196, 96)
local PINK = Color3.fromRGB(255, 150, 190)
local CREAM = Color3.fromRGB(255, 244, 226)

-- Un cheval de manège (repère : centre du corps, avant = -Z) ; `add`
-- enregistre chaque pièce avec son CFrame LOCAL (relatif au cheval)
local function horse(add: (string, Vector3, CFrame, Color3, Enum.Material?, Enum.PartType?, string?) -> (), colors: any, seed: number)
	local body, mane, saddle = colors.Body, colors.Mane, colors.Saddle
	add("Body", Vector3.new(2.5, 1.25, 1.25), CFrame.Angles(0, math.rad(90), 0), body, M.SmoothPlastic, Enum.PartType.Cylinder)
	add("Chest", Vector3.new(1.35, 1.35, 1.35), CFrame.new(0, 0.08, -1.15), body, M.SmoothPlastic, Enum.PartType.Ball)
	add("Rump", Vector3.new(1.4, 1.4, 1.4), CFrame.new(0, 0.05, 1.1), body, M.SmoothPlastic, Enum.PartType.Ball)
	local neck = CFrame.new(0, 0.95, -1.55) * CFrame.Angles(math.rad(-28), 0, 0)
	add("Neck", Vector3.new(0.62, 1.7, 0.8), neck, body, M.SmoothPlastic)
	add("Mane", Vector3.new(0.22, 1.75, 0.3), neck * CFrame.new(0, 0.12, 0.42), mane, M.SmoothPlastic)
	local head = CFrame.new(0, 1.85, -2.2) * CFrame.Angles(math.rad(-18), 0, 0)
	add("Head", Vector3.new(0.6, 0.62, 1.3), head, body, M.SmoothPlastic)
	add("Muzzle", Vector3.new(0.55, 0.55, 0.55), head * CFrame.new(0, -0.08, -0.6), body, M.SmoothPlastic, Enum.PartType.Ball)
	add("Bridle", Vector3.new(0.66, 0.68, 0.1), head * CFrame.new(0, 0, -0.3), GOLD, M.Metal)
	add("Plume", Vector3.new(0.42, 0.42, 0.42), head * CFrame.new(0, 0.45, 0.12), mane, M.SmoothPlastic, Enum.PartType.Ball)
	for _, sx in ipairs({ -1, 1 }) do
		add("Ear", Vector3.new(0.14, 0.34, 0.16), head * CFrame.new(sx * 0.18, 0.42, 0.42), body, M.SmoothPlastic)
		add("Eye", Vector3.new(0.15, 0.15, 0.15), head * CFrame.new(sx * 0.3, 0.12, -0.22), Color3.fromRGB(40, 30, 44), M.SmoothPlastic, Enum.PartType.Ball)
	end
	add("Blanket", Vector3.new(1.36, 0.08, 1.3), CFrame.new(0, 0.62, -0.05), GOLD, M.Fabric)
	add("Saddle", Vector3.new(1, 0.25, 1.1), CFrame.new(0, 0.75, -0.05), saddle, M.Leather)
	add("Tail", Vector3.new(0.3, 1.3, 0.34), CFrame.new(0, -0.12, 1.85) * CFrame.Angles(math.rad(-25), 0, 0), mane, M.SmoothPlastic)
	-- jambes au galop (un peu différentes d'un cheval à l'autre)
	local lift = (seed % 3) * 8
	local legs = {
		{ -0.33, -1.1, 70 - lift },
		{ 0.33, -1.1, 42 + lift },
		{ -0.33, 1.1, -34 },
		{ 0.33, 1.1, -22 - lift / 2 },
	}
	for _, l in ipairs(legs) do
		local pivot = CFrame.new(l[1], -0.4, l[2]) * CFrame.Angles(math.rad(l[3]), 0, 0)
		add("Leg", Vector3.new(0.28, 1.4, 0.28), pivot * CFrame.new(0, -0.7, 0), body, M.SmoothPlastic)
		add("Hoof", Vector3.new(0.34, 0.24, 0.4), pivot * CFrame.new(0, -1.45, 0), GOLD, M.Metal)
	end
end

-- Un carrosse (repère au plancher du manège, avant = -Z)
local function carriage(add: (string, Vector3, CFrame, Color3, Enum.Material?, Enum.PartType?, string?) -> (), tint: Color3)
	add("CarriageFloor", Vector3.new(2.3, 0.3, 3.4), CFrame.new(0, 0.45, 0), GOLD, M.Metal)
	for _, sx in ipairs({ -1, 1 }) do
		add("CarriageSide", Vector3.new(0.25, 1.4, 3.3), CFrame.new(sx * 1.08, 1.3, 0), tint, M.SmoothPlastic)
		add("CarriageKnob", Vector3.new(0.5, 0.5, 0.5), CFrame.new(sx * 1.08, 2.55, 1.5), GOLD, M.Metal, Enum.PartType.Ball)
	end
	add("CarriageBack", Vector3.new(2.1, 1.9, 0.3), CFrame.new(0, 1.55, 1.5), tint, M.SmoothPlastic)
	add("CarriageSeat", Vector3.new(1.9, 0.45, 1), CFrame.new(0, 0.825, 0.85), CREAM, M.Fabric)
	add("CarriageFront", Vector3.new(2.1, 1.2, 0.3), CFrame.new(0, 1.2, -1.5), tint, M.SmoothPlastic)
	add("CarriageSwan", Vector3.new(0.9, 0.9, 0.9), CFrame.new(0, 2.1, -1.55), GOLD, M.Metal, Enum.PartType.Ball)
end

local function buildCarousel(folder: Instance, R0: CFrame)
	local model = Instance.new("Model")
	model.Name = "Carousel"
	model.Parent = folder
	local c = { Base = R0, Parts = {}, Locals = {}, Group = {}, Frames = {}, HorseBase = {}, HorsePhase = {}, HorseCF = {},
		Groups = {}, Seats = {}, SeatIndex = {}, SeatFrames = {}, SeatCheck = 0 }
	-- pièce FIXE (symétrique autour de l'axe : inutile de la tourner)
	local function fixed(name: string, size: Vector3, loc: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?, solid: boolean?): BasePart
		local p = newPart(model, name, size, R0 * loc, color, material, shape)
		if solid then
			p.CanCollide = true
			p.CanQuery = true
		end
		return p
	end
	-- pièce qui TOURNE (groupe 0) ou qui monte et descend (groupe = cheval)
	local function moving(group: number, name: string, size: Vector3, loc: CFrame, world: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?, className: string?): BasePart
		local p = newPart(model, name, size, world, color, material, shape, className)
		table.insert(c.Parts, p)
		table.insert(c.Locals, loc)
		table.insert(c.Group, group)
		table.insert(c.Frames, world)
		return p
	end
	local function rotor(name: string, size: Vector3, loc: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?, className: string?): BasePart
		return moving(0, name, size, loc, R0 * loc, color, material, shape, className)
	end
	local function ring(n: number, i: number, r: number, y: number): CFrame
		local a = (i + 0.5) / n * math.pi * 2
		local p = Vector3.new(math.sin(a) * r, y, math.cos(a) * r)
		return CFrame.lookAt(p, p + Vector3.new(p.X, 0, p.Z)) -- (-Z local = vers l'extérieur)
	end
	-- plateau (bois), fût central, bagues dorées, plafond : fixes
	fixed("Deck", Vector3.new(0.3, 16.8, 16.8), CFrame.new(0, 0.15, 0) * VERTICAL, Color3.fromRGB(214, 164, 116), M.WoodPlanks, Enum.PartType.Cylinder, true)
	fixed("Drum", Vector3.new(7.8, 3.8, 3.8), CFrame.new(0, 4.1, 0) * VERTICAL, CREAM, M.SmoothPlastic, Enum.PartType.Cylinder, true)
	fixed("DrumBand", Vector3.new(0.4, 4.2, 4.2), CFrame.new(0, 0.5, 0) * VERTICAL, GOLD, M.Metal, Enum.PartType.Cylinder)
	fixed("DrumBand", Vector3.new(0.4, 4.2, 4.2), CFrame.new(0, 7.4, 0) * VERTICAL, GOLD, M.Metal, Enum.PartType.Cylinder)
	fixed("Ceiling", Vector3.new(0.25, 17.7, 17.7), CFrame.new(0, 8.025, 0) * VERTICAL, CREAM, M.SmoothPlastic, Enum.PartType.Cylinder)
	-- jupe du plateau : 16 panneaux or / rose
	for i = 0, 15 do
		rotor("Skirt", Vector3.new(3.38, 0.6, 0.12), ring(16, i, 8.45, 0.12), i % 2 == 0 and GOLD or PINK, i % 2 == 0 and M.Metal or M.SmoothPlastic)
	end
	-- fût : 8 miroirs encadrés + 8 pilastres dorés
	for i = 0, 7 do
		rotor("MirrorFrame", Vector3.new(1.5, 2.9, 0.12), ring(8, i, 1.98, 4.3), GOLD, M.Metal)
		local mirror = rotor("Mirror", Vector3.new(1.2, 2.6, 0.08), ring(8, i, 2.07, 4.3), Color3.fromRGB(224, 236, 248), M.SmoothPlastic)
		mirror.Reflectance = 0.5
		rotor("Pilaster", Vector3.new(0.28, 6.5, 0.28), ring(8, i + 0.5, 2, 3.95), GOLD, M.Metal)
	end
	-- plafond : 8 rayons dorés (ils tournent)
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		local d = Vector3.new(math.sin(a), 0, math.cos(a))
		local mid = d * 5.4 + Vector3.new(0, 7.875, 0)
		rotor("Ray", Vector3.new(0.35, 0.05, 6.6), CFrame.lookAt(mid, mid + d), GOLD, M.Metal)
	end
	-- bandeau (16 panneaux crème / rose), 32 ampoules, 32 festons
	for i = 0, 15 do
		local board = ring(16, i, 9.05, 7.6)
		rotor("Board", Vector3.new(3.62, 1.1, 0.3), board, i % 2 == 0 and CREAM or PINK, M.SmoothPlastic)
		for _, x in ipairs({ -0.9, 0.9 }) do
			local bulb = rotor("Bulb", Vector3.new(0.32, 0.32, 0.32), board * CFrame.new(x, 0, -0.25), Color3.fromRGB(255, 232, 180), M.SmoothPlastic, Enum.PartType.Ball)
			glow(bulb)
			rotor("Scallop", Vector3.new(0.12, 1.2, 1.2), board * CFrame.new(x, -0.55, 0) * CFrame.Angles(0, math.rad(90), 0), x < 0 and PINK or CREAM, M.Fabric, Enum.PartType.Cylinder)
		end
	end
	-- auvent : pyramide à 16 pans rayés rose / crème
	local e, y0, y1 = 9.35, 8.15, 11.6
	local apex = Vector3.new(0, y1, 0)
	local half = e * math.tan(math.pi / 16)
	for k = 0, 15 do
		local a = k / 16 * math.pi * 2
		local nrm = Vector3.new(math.sin(a), 0, math.cos(a))
		local side = UP:Cross(nrm).Unit
		local mid = nrm * e + Vector3.new(0, y0, 0)
		local w = apex - mid
		for _, sv in ipairs({ side, -side }) do
			local size, loc = triCF(mid, w.Unit, sv, w.Magnitude, half, 0.2)
			rotor("Canopy", size, loc, k % 2 == 0 and Color3.fromRGB(255, 132, 180) or CREAM, M.Fabric, nil, "WedgePart")
		end
	end
	-- couronne : tambour doré, boule rose, mât et fanion
	rotor("Crown", Vector3.new(0.8, 1.7, 1.7), CFrame.new(0, 11.6, 0) * VERTICAL, GOLD, M.Metal, Enum.PartType.Cylinder)
	rotor("CrownBall", Vector3.new(1.2, 1.2, 1.2), CFrame.new(0, 12.4, 0), PINK, M.SmoothPlastic, Enum.PartType.Ball)
	rotor("FlagPole", Vector3.new(2.2, 0.12, 0.12), rodCF(Vector3.new(0, 12.9, 0), Vector3.new(0, 15.1, 0)), GOLD, M.Metal, Enum.PartType.Cylinder)
	local fSize, fLoc = triCF(Vector3.new(0, 15, 0), Vector3.new(1, 0, 0), Vector3.new(0, -1, 0), 1.6, 0.9, 0.06)
	rotor("Flag", fSize, fLoc, Color3.fromRGB(236, 72, 140), M.Fabric, nil, "WedgePart")
	-- 10 chevaux (6 au bord, 4 à l'intérieur) + 2 carrosses, barres de laiton
	-- (v9.8 : emplacements et pose partagés avec le serveur : FairRides)
	local horseIndex = 0
	for _, s in ipairs(FairRides.CarouselSpots()) do
		local pos = s.Pos
		local base = s.Base
		if s.Carriage then
			carriage(function(name, size, loc, color, material, shape, className)
				rotor(name, size, base * loc, color, material, shape, className)
			end, horseIndex % 2 == 0 and PINK or Color3.fromRGB(190, 160, 240))
		else
			horseIndex += 1
			local k = horseIndex
			local hb = base * CFrame.new(0, FairRides.HORSE_Y, 0)
			c.HorseBase[k] = hb
			c.HorsePhase[k] = s.Phase
			c.HorseCF[k] = R0 * hb
			rotor("Pole", Vector3.new(7.6, 0.24, 0.24), CFrame.new(pos.X, 4.1, pos.Z) * VERTICAL, GOLD, M.Metal, Enum.PartType.Cylinder)
			horse(function(name, size, loc, color, material, shape, className)
				moving(k, name, size, loc, R0 * hb * loc, color, material, shape, className)
			end, HORSE_COLORS[(k - 1) % #HORSE_COLORS + 1], k)
		end
	end
	return c
end

-- (v9.8) sièges du serveur (TownFair) sur les chevaux : on les déplace
-- aussi localement, à la même pose -> l'avatar assis suit en douceur
local PLAZA_RIDE = { Kind = "PlazaCarousel" }
local function stepCarousel(c: any, now: number)
	local groups = c.Groups
	FairRides.Pose(PLAZA_RIDE :: any, now, groups)
	local rot = c.Base * groups[1]
	local horseCF = c.HorseCF
	for k = 1, #c.HorseBase do
		horseCF[k] = c.Base * groups[1 + k]
	end
	local frames, locals, group = c.Frames, c.Locals, c.Group
	for i = 1, #frames do
		local g = group[i]
		frames[i] = (g == 0 and rot or horseCF[g]) * locals[i]
	end
	workspace:BulkMoveTo(c.Parts, frames, Enum.BulkMoveMode.FireCFrameChanged)
	local seats, seatFrames, seatIndex = c.Seats, c.SeatFrames, c.SeatIndex
	if #seats > 0 then
		for i = 1, #seats do
			seatFrames[i] = c.Base * FairRides.SeatLocal("PlazaCarousel", seatIndex[i], groups)
		end
		workspace:BulkMoveTo(seats, seatFrames, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

-- (v9.8) sièges du manège de la place (répliqués par le serveur, peut-être
-- plus tard que la place) : Plaza > Carousel > RideSeats > RideSeat
local function findCarouselSeats(c: any, plaza: Instance)
	table.clear(c.Seats)
	table.clear(c.SeatIndex)
	table.clear(c.SeatFrames)
	local model = plaza:FindFirstChild("Carousel")
	local folder = model and model:FindFirstChild("RideSeats")
	if not folder then
		return
	end
	for _, d in ipairs(folder:GetChildren()) do
		local index = d:GetAttribute("SeatIndex")
		if d:IsA("Seat") and type(index) == "number" then
			table.insert(c.Seats, d)
			table.insert(c.SeatIndex, index)
		end
	end
end

----------------------------------------------------------------------
-- Ballons du chariot
----------------------------------------------------------------------

local BALLOON_COLORS = {
	Color3.fromRGB(255, 120, 170),
	Color3.fromRGB(126, 196, 255),
	Color3.fromRGB(255, 222, 110),
	Color3.fromRGB(128, 222, 190),
	Color3.fromRGB(186, 150, 246),
	Color3.fromRGB(255, 110, 110),
	Color3.fromRGB(255, 186, 140),
	Color3.fromRGB(255, 255, 255),
	Color3.fromRGB(236, 72, 140),
}

local function buildBalloons(folder: Instance, tie: Vector3)
	local model = Instance.new("Model")
	model.Name = "Balloons"
	model.Parent = folder
	local b = { Tie = tie, Items = {}, Parts = {}, Frames = {} }
	for i, color in ipairs(BALLOON_COLORS) do
		local a = i / #BALLOON_COLORS * math.pi * 2 + (i % 2) * 0.3
		local spread = 0.28 + (i % 3) * 0.08
		local rest = Vector3.new(math.cos(a) * spread, 1, math.sin(a) * spread).Unit
		local len = 4.2 + (i % 3) * 0.9
		local item = {
			Rest = rest,
			Len = len,
			Phase = i * 1.7,
			String = newPart(model, "String", Vector3.new(0.05, 0.05, len), CFrame.new(tie), Color3.fromRGB(250, 250, 250)),
			Knot = newPart(model, "Knot", Vector3.new(0.28, 0.28, 0.28), CFrame.new(tie), color, M.SmoothPlastic, Enum.PartType.Ball),
			Ball = newPart(model, "Balloon", Vector3.new(1.55, 1.55, 1.55), CFrame.new(tie), color, M.SmoothPlastic, Enum.PartType.Ball),
		}
		item.Ball.Reflectance = 0.12
		table.insert(b.Items, item)
		table.insert(b.Parts, item.String)
		table.insert(b.Parts, item.Knot)
		table.insert(b.Parts, item.Ball)
		table.insert(b.Frames, CFrame.new(tie))
		table.insert(b.Frames, CFrame.new(tie))
		table.insert(b.Frames, CFrame.new(tie))
	end
	return b
end

local function stepBalloons(b: any, t: number)
	local tie = b.Tie
	local frames = b.Frames
	for i, item in ipairs(b.Items) do
		local ph = item.Phase
		local dir = (item.Rest + Vector3.new(math.sin(t * 0.9 + ph) * 0.1, 0, math.cos(t * 0.7 + ph * 2) * 0.1)).Unit
		local tip = tie + dir * item.Len
		frames[i * 3 - 2] = CFrame.lookAt((tie + tip) / 2, tip)
		frames[i * 3 - 1] = CFrame.new(tip + dir * 0.1)
		frames[i * 3] = CFrame.new(tip + dir * 0.86)
	end
	workspace:BulkMoveTo(b.Parts, frames, Enum.BulkMoveMode.FireCFrameChanged)
end

----------------------------------------------------------------------
-- Guirlandes, fanions, ampoules du kiosque (fixes)
----------------------------------------------------------------------

local LIGHT_COLORS = {
	Color3.fromRGB(255, 232, 180),
	Color3.fromRGB(255, 176, 206),
	Color3.fromRGB(176, 214, 255),
	Color3.fromRGB(255, 236, 150),
	Color3.fromRGB(176, 236, 206),
}
local FLAG_COLORS = {
	Color3.fromRGB(255, 132, 184),
	Color3.fromRGB(126, 196, 255),
	Color3.fromRGB(255, 222, 110),
	Color3.fromRGB(128, 222, 190),
	Color3.fromRGB(186, 150, 246),
	Color3.fromRGB(255, 170, 130),
}

-- point d'une chaînette (parabole) entre a et b, flèche `sag`
local function sagAt(a: Vector3, b: Vector3, sag: number, t: number): Vector3
	return a:Lerp(b, t) - Vector3.new(0, sag * (1 - (2 * t - 1) ^ 2), 0)
end

local function wire(model: Instance, a: Vector3, b: Vector3, sag: number, color: Color3)
	local steps = 4
	for i = 0, steps - 1 do
		local p, q = sagAt(a, b, sag, i / steps), sagAt(a, b, sag, (i + 1) / steps)
		newPart(model, "Wire", Vector3.new((q - p).Magnitude, 0.08, 0.08), rodCF(p, q), color, M.SmoothPlastic, Enum.PartType.Cylinder)
	end
end

local function buildGarlands(folder: Instance, center: Vector3, lamps: Vector3, stage: CFrame?)
	local model = Instance.new("Model")
	model.Name = "Garlands"
	model.Parent = folder
	local r, top, n = lamps.X, lamps.Y, math.floor(lamps.Z + 0.5)
	local tops, lows = {}, {}
	for i = 0, n - 1 do
		local a = (i + 0.5) / n * math.pi * 2
		local d = Vector3.new(math.sin(a), 0, math.cos(a))
		tops[i + 1] = center + d * r + Vector3.new(0, top, 0)
		lows[i + 1] = center + d * (r - 0.3) + Vector3.new(0, 8.6, 0)
	end
	local ink = Color3.fromRGB(60, 56, 72)
	for i = 1, n do
		local a, b = tops[i], tops[i % n + 1]
		-- (v9.9, CITY99) pas de guirlande au-dessus / derrière la scène de musique
		if stage and (Vector3.new((a.X + b.X) / 2, stage.Position.Y, (a.Z + b.Z) / 2) - stage.Position).Magnitude < 17 then
			continue
		end
		-- guirlande lumineuse : fil qui pend + 7 ampoules
		wire(model, a, b, 2.2, ink)
		for k = 1, 7 do
			local p = sagAt(a, b, 2.2, k / 8) - Vector3.new(0, 0.3, 0)
			glow(newPart(model, "Bulb", Vector3.new(0.42, 0.42, 0.42), CFrame.new(p), LIGHT_COLORS[(i + k) % #LIGHT_COLORS + 1], M.SmoothPlastic, Enum.PartType.Ball))
		end
		-- fanions (une travée sur deux, plus bas)
		if i % 2 == 0 then
			local la, lb = lows[i], lows[i % n + 1]
			wire(model, la, lb, 1.8, Color3.fromRGB(250, 250, 250))
			local flags = 12
			for k = 1, flags do
				local t = k / (flags + 1)
				local p = sagAt(la, lb, 1.8, t)
				local along = (sagAt(la, lb, 1.8, t + 0.01) - sagAt(la, lb, 1.8, t - 0.01)).Unit
				local color = FLAG_COLORS[(k + i) % #FLAG_COLORS + 1]
				for _, sv in ipairs({ along, -along }) do
					local size, cf = triCF(p, -UP, sv, 1.1, 0.42, 0.05)
					newPart(model, "Pennant", size, cf, color, M.Fabric, nil, "WedgePart")
				end
			end
		end
	end
end

local function buildBandstandLights(folder: Instance, F: CFrame, fascia: Vector2)
	local model = Instance.new("Model")
	model.Name = "BandstandLights"
	model.Parent = folder
	local e, y = fascia.X + 0.12, fascia.Y - 0.12
	local half = e * math.tan(math.pi / 8)
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		local nrm = F:VectorToWorldSpace(Vector3.new(math.sin(a), 0, -math.cos(a)))
		local side = UP:Cross(nrm).Unit
		local mid = F.Position + nrm * e + Vector3.new(0, y, 0)
		for q = -1, 1 do
			local p = mid + side * (q * half * 0.62) - Vector3.new(0, q == 0 and 0.35 or 0.15, 0)
			glow(newPart(model, "Bulb", Vector3.new(0.36, 0.36, 0.36), CFrame.new(p), LIGHT_COLORS[(k + q + 2) % #LIGHT_COLORS + 1], M.SmoothPlastic, Enum.PartType.Ball))
		end
	end
end

----------------------------------------------------------------------
-- Pigeons (v9.8, CITY98) : module TownPigeons ; fontaine : TownFountainFx
----------------------------------------------------------------------

----------------------------------------------------------------------
-- Construction / boucle
----------------------------------------------------------------------

-- (v9.9, CITY99) PAVAGE réaliste de la place : joints de pavés en anneaux
-- concentriques (tous les 6 studs, de r = 24 à 60) et 16 bandes de granit
-- rayonnantes entre les pointes de la rose des vents ; jamais sous la scène,
-- le manège, les massifs, étals, lampadaires (liste "FxKeepOut" du serveur).
-- Dessus : bandes +0,105, joints +0,135 au-dessus du pavé (rose des vents
-- +0,09, anneaux +0,06) : aucune face confondue.
local function buildPaving(folder: Instance, center: Vector3, stage: CFrame?, carousel: CFrame?, keepText: any)
	local model = Instance.new("Model")
	model.Name = "Paving"
	model.Parent = folder
	local keep = {}
	if type(keepText) == "string" then
		for _, item in ipairs(string.split(keepText, ";")) do
			local f = string.split(item, ",")
			local x, z, r = tonumber(f[1]), tonumber(f[2]), tonumber(f[3])
			if x and z and r then
				table.insert(keep, { center.X + x, center.Z + z, r })
			end
		end
	end
	local function blocked(p: Vector3, pad: number): boolean
		local rel = Vector3.new(p.X - center.X, 0, p.Z - center.Z)
		if rel.Magnitude < 23 then
			return true
		end
		if stage then
			local lp = stage:PointToObjectSpace(Vector3.new(p.X, stage.Position.Y, p.Z))
			if math.abs(lp.X) < 13.5 + pad and math.abs(lp.Z) < 9.5 + pad then
				return true
			end
		end
		if carousel and Vector3.new(p.X - carousel.Position.X, 0, p.Z - carousel.Position.Z).Magnitude < 13 + pad then
			return true
		end
		for _, k in ipairs(keep) do
			if Vector3.new(p.X - k[1], 0, p.Z - k[2]).Magnitude < k[3] + pad then
				return true
			end
		end
		return false
	end
	local jointColor = Color3.fromRGB(176, 162, 160)
	local y0 = center.Y
	-- anneaux de joints (cordes de 5 studs au plus)
	for r = 24, 60, 6 do
		local n = math.ceil(2 * math.pi * r / 5)
		for i = 0, n - 1 do
			local a0 = i / n * math.pi * 2
			local a1 = (i + 1) / n * math.pi * 2
			local p0 = center + Vector3.new(math.sin(a0) * r, 0, math.cos(a0) * r)
			local p1 = center + Vector3.new(math.sin(a1) * r, 0, math.cos(a1) * r)
			local mid = (p0 + p1) / 2
			if not blocked(mid, 0.6) and not blocked(p0, 0.2) and not blocked(p1, 0.2) then
				local len = (p1 - p0).Magnitude + 0.1
				local cf = CFrame.lookAt(Vector3.new(mid.X, y0 + 0.135 - 0.15, mid.Z), Vector3.new(p1.X, y0 + 0.135 - 0.15, p1.Z))
				newPart(model, "PavingJoint", Vector3.new(0.12, 0.3, len), cf, jointColor, M.Concrete)
			end
		end
	end
	-- bandes de granit rayonnantes (entre les pointes de la rose des vents)
	local granite = Color3.fromRGB(196, 190, 196)
	for k = 0, 15 do
		local a = (k + 0.5) / 16 * math.pi * 2
		local d = Vector3.new(math.sin(a), 0, math.cos(a))
		-- morceaux de 6 studs (on saute ceux qui passent sous un obstacle)
		for r = 23, 57, 6 do
			local p0 = center + d * r
			local p1 = center + d * (r + 6)
			local mid = (p0 + p1) / 2
			if not blocked(mid, 1) and not blocked(p0, 0.6) and not blocked(p1, 0.6) then
				local cf = CFrame.lookAt(Vector3.new(mid.X, y0 + 0.105 - 0.15, mid.Z), Vector3.new(p1.X, y0 + 0.105 - 0.15, p1.Z))
				newPart(model, "GraniteBand", Vector3.new(0.9, 0.3, 6.02), cf, granite, M.Granite)
			end
		end
	end
end

local function findPlaza(): (Instance?, Instance?)
	local town = workspace:FindFirstChild("DopamineTown")
	local decor = town and town:FindFirstChild("Decor")
	local plaza = decor and decor:FindFirstChild("Plaza")
	if plaza and plaza:GetAttribute("FxVersion") ~= nil then
		return town, plaza
	end
	return nil, nil
end

local function serverNow(): number
	local ok, t = pcall(function()
		return workspace:GetServerTimeNow()
	end)
	return ok and type(t) == "number" and t or os.clock()
end

local function build(): boolean
	local town, plaza = findPlaza()
	if not town or not plaza then
		return false
	end
	local folder = Instance.new("Folder")
	folder.Name = "TownPlazaFx"
	local s = state
	s.Folder = folder
	s.Center = vec3Attr(plaza, "FxCenter") or Vector3.new(0, 0, 0)
	local carCF = cfAttr(plaza, "FxCarouselCF")
	if carCF then
		s.Carousel = buildCarousel(folder, carCF)
		findCarouselSeats(s.Carousel, plaza)
		s.Plaza = plaza
	end
	local tie = vec3Attr(plaza, "FxBalloonTie")
	if tie then
		s.Balloons = buildBalloons(folder, tie)
	end
	local lamps = vec3Attr(plaza, "FxLamps")
	local stageCF = cfAttr(plaza, "FxStageCF")
	if lamps then
		buildGarlands(folder, s.Center, lamps, stageCF)
	end
	-- (v9.9, CITY99) pavage de la place : joints en cercles + bandes de granit
	pcall(buildPaving, folder, s.Center, stageCF, carCF, plaza:GetAttribute("FxKeepOut"))
	local bandCF = cfAttr(plaza, "FxBandstandCF")
	local fascia = plaza:GetAttribute("FxBandstandFascia")
	if bandCF and typeof(fascia) == "Vector2" then
		buildBandstandLights(folder, bandCF, fascia)
	end
	-- (v9.8, CITY98) pigeons 10x (TownPigeons) + fontaine animée (TownFountainFx)
	s.Pigeons = TownPigeons.Build(folder, plaza)
	local fountainBase = vec3Attr(plaza, "FxFountainBase")
	if fountainBase then
		s.Fountain = TownFountainFx.Build(folder, fountainBase)
	end
	-- (sous DopamineTown : TownAtmosphere suit les ampoules "NightGlow")
	folder.Parent = town
	s.Built = true
	return true
end

local function focusPoint(): Vector3?
	local character = LocalPlayer and LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root.Position
	end
	local camera = workspace.CurrentCamera
	return camera and camera.CFrame.Position or nil
end

function TownPlazaFx.Start()
	if state then
		return
	end
	state = { Built = false, Acc = 0, Retry = 0, Time = 0, Fails = 0 }
	local ok, err = pcall(build)
	if not ok then
		state.Fails += 1
		warn("[TownPlazaFx] " .. tostring(err))
	end
end

-- (v9.8) l'avatar local est-il assis sur le manège de la place ?
local function ridingCarousel(c: any): boolean
	local character = LocalPlayer and LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local seat = humanoid and humanoid.SeatPart
	return seat ~= nil and table.find(c.Seats, seat) ~= nil
end

function TownPlazaFx.Step(dt: number)
	local s = state
	if not s then
		return
	end
	-- (v9.8) sur le manège : plateau, chevaux et sièges à CHAQUE image
	-- (fluide sous la caméra) ; sinon 30 fois / s au plus comme avant
	local riding = false
	local rc = s.Built and s.Carousel
	if rc then
		rc.SeatCheck -= dt
		if #rc.Seats == 0 and rc.SeatCheck <= 0 and s.Plaza then
			rc.SeatCheck = 1
			findCarouselSeats(rc, s.Plaza)
		end
		riding = ridingCarousel(rc)
		-- (v9.9, FAIR99) à CHAQUE image aussi pour ceux qui regardent (avant :
		-- 30 fois / s -> manège et passagers saccadés vus du sol)
		local focus0 = focusPoint()
		if riding or (focus0 and (focus0 - rc.Base.Position).Magnitude < FAR_CAROUSEL) then
			stepCarousel(rc, serverNow())
		end
	end
	-- (v9.9, CITY99) pigeons à CHAQUE image quand ils sont près de l'avatar /
	-- de la caméra (marche + hochement de tête sans saccade) ; sinon 30 Hz
	local pigeonsLive = false
	if s.Built and s.Pigeons then
		local camera = workspace.CurrentCamera
		local eye = camera and camera.CFrame.Position
		local near = focusPoint()
		pigeonsLive = (eye ~= nil and TownPigeons.Near(s.Pigeons, eye, PIGEONS_LIVE)) or (near ~= nil and TownPigeons.Near(s.Pigeons, near, PIGEONS_LIVE))
		if pigeonsLive then
			local character = LocalPlayer and LocalPlayer.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			TownPigeons.Step(s.Pigeons, dt, root and (root :: BasePart).Position or nil)
		end
	end
	s.Acc += dt
	if s.Acc < STEP then
		return
	end
	local elapsed = math.min(s.Acc, 0.25)
	s.Acc = 0
	s.Time += elapsed
	-- (la ville a été reconstruite : nos pièces sont parties avec elle)
	if s.Built and (s.Folder == nil or s.Folder.Parent == nil) then
		s.Built = false
		s.Carousel, s.Balloons, s.Pigeons, s.Fountain = nil, nil, nil, nil
	end
	if not s.Built then
		-- (3 échecs de construction : on abandonne, sans bruit ni coût)
		s.Retry -= elapsed
		if s.Retry <= 0 and s.Fails < 3 then
			s.Retry = RETRY
			local ok, err = pcall(build)
			if not ok then
				s.Fails += 1
				warn("[TownPlazaFx] " .. tostring(err))
				if s.Folder then
					s.Folder:Destroy()
					s.Folder = nil
				end
			end
		end
		return
	end
	local focus = focusPoint()
	if not focus then
		return
	end
	local fromCenter = Vector3.new(focus.X - s.Center.X, 0, focus.Z - s.Center.Z).Magnitude
	if fromCenter > FAR_PLAZA then
		return
	end
	local b = s.Balloons
	if b and (focus - b.Tie).Magnitude < FAR_SMALL then
		stepBalloons(b, s.Time)
	end
	local p = s.Pigeons
	if p and not pigeonsLive and fromCenter < FAR_SMALL + 40 then
		local character = LocalPlayer and LocalPlayer.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		TownPigeons.Step(p, elapsed, root and (root :: BasePart).Position or nil)
	end
	if s.Fountain and fromCenter < FAR_SMALL + 30 then
		TownFountainFx.Step(s.Fountain, serverNow())
	end
end

function TownPlazaFx.Stop()
	local s = state
	state = nil
	if s and s.Folder then
		s.Folder:Destroy()
	end
end

function TownPlazaFx.Debug(): any
	return { State = state }
end

return TownPlazaFx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="242">
          <Properties>
            <string name="Name">TownRoads</string>
            <string name="Source"><![CDATA[--[[
	TownRoads (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > TownRoads

	🛣️ Dopamine Town (v9.9, CITY99) : les ROUTES "100x plus réalistes",
	construites côté CLIENT, en flux autour de l'avatar (0 pièce serveur).
	Le serveur (TownStreets / TownEntrance, TownKit.LifeSpot) publie des
	emplacements par tronçons de 40 studs au plus ; TownStreetLife les
	construit avec ces fabriques (TownRoads.BUILDERS) :
	  - "RoadSurface" : l'asphalte vit : ornières plus sombres dans les
	    traces des roues, rustines de réparation (neuves plus foncées,
	    anciennes plus grises), fissures colmatées au goudron ;
	  - "CurbLine"    : caniveau en béton le long de chaque bordure +
	    bordure à nez ARRONDI (chanfrein) ;
	  - "Pavers"      : trottoirs en dalles avec leurs JOINTS et quelques
	    dalles d'une autre teinte ;
	  - "Arrow"       : flèches directionnelles peintes (tout droit, gauche,
	    droite, tout droit + droite / gauche) ;
	  - "GiveWay"     : dents de requin "cédez le passage" ;
	  - "RoadWord"    : mots peints ("STOP", "BUS", "ZONE 30", "LENT") ;
	  - "Roundabout"  : rond-point détaillé (anneau franchissable pavé,
	    bordure, balises de chevrons, lignes de cédez-le-passage, panneaux) ;
	  - "Direction"   : poteaux indicateurs à lames (flèches vraiment
	    orientées vers chaque lieu : place, fête foraine, lac, MégaDopa,
	    concession, coin gourmand, skatepark, jardins, tram...) ; les lieux
	    sont les repères "Dest" publiés par le serveur ;
	  - "Walkway"     : allée piétonne pavée (bordures, dalles, joints)
	    qui relie un lieu au réseau (pas de pelouse à traverser).
	Hauteurs au-dessus de l'asphalte (jamais deux faces à moins de 0,02) :
	ornières / caniveau 0,02 ; rustines 0,04 ; fissures 0,055 ; peinture
	(TownStreetLife, relevée en v9.9) 0,08 ; passages piétons 0,09.
	Tout est ancré, sans collision (sauf poteaux), CanQuery / CanTouch false,
	aucune lumière, aucun son.

	API (TownStreetLife) :
	  TownRoads.BUILDERS : { [kind]: (m, F, seed, spot) -> any }
	  TownRoads.BIG      : types vus de loin (rayon "gros objets")
	  TownRoads.SetDestinations(spots)   repères "Dest" (poteaux indicateurs)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Locale = require(ReplicatedStorage.Shared.Locale)

local TownRoads = {}

local M = Enum.Material
local rgb = Color3.fromRGB
local UPRIGHT = CFrame.Angles(0, 0, math.rad(90)) -- cylindre debout (axe X -> Y)

-- Palette (mêmes tons que TownKit : asphalte 78,80,92)
local ASPHALT = rgb(78, 80, 92)
local WORN = rgb(66, 68, 78) -- traces des roues (plus sombres, lustrées)
local PATCH_NEW = rgb(56, 58, 66)
local PATCH_OLD = rgb(98, 100, 108)
local TAR = rgb(30, 30, 34)
local GUTTER = rgb(190, 188, 184)
local CURB = rgb(238, 236, 232)
local JOINT = rgb(168, 162, 156)
local WALK = rgb(216, 210, 204)
local PAINT = rgb(250, 250, 246) -- (= TownKit.C.Line : mêmes lignes que les places de stationnement)
local STEEL = rgb(170, 174, 182)
local GRAPHITE = rgb(52, 54, 60)
local WHITE = rgb(250, 250, 248)

-- Hauteurs des dessus au-dessus de l'asphalte / du trottoir : 0,03 au moins
-- entre deux niveaux qui peuvent se recouvrir (détecteur : < 0,02 = conflit)
local H_WEAR = 0.03 -- ornières, caniveau
local H_PATCH = 0.06 -- rustines
local H_CRACK = 0.09 -- fissures, joints de rustine
local H_PAINT = 0.12 -- peinture (= TownStreetLife.PAINT_TOP)
local H_SLAB = 0.03 -- dalles d'une autre teinte (trottoir)
local H_JOINT = 0.075 -- joints des dalles (trottoir)
TownRoads.H_PAINT = H_PAINT

local function hash(a: number, b: number): number
	local x = math.sin(a * 12.9898 + b * 78.233) * 43758.5453
	return x - math.floor(x)
end

local function newPart(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: string?, solid: boolean?): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = solid == true
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = solid == true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape == "Cyl" then
		p.Shape = Enum.PartType.Cylinder
	elseif shape == "Ball" then
		p.Shape = Enum.PartType.Ball
	end
	p.Parent = parent
	return p
end

local function wedge(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): BasePart
	local p = Instance.new("WedgePart")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.Parent = parent
	return p
end

-- Plaque peinte / posée : dessus à `top` au-dessus du repère, 0,2 d'épaisseur
-- (le dessous est caché dans la chaussée : jamais de face presque confondue)
-- (épaisseur 0,3 + 3 x `top` : les dessous, cachés dans la chaussée, sont
-- eux aussi tous à des hauteurs différentes)
local function flat(parent: Instance, name: string, F: CFrame, x: number, z: number, lx: number, lz: number, top: number, color: Color3, material: Enum.Material?, yaw: number?): BasePart
	local thick = 0.3 + 3 * top
	local cf = F * CFrame.new(x, top - thick / 2, z)
	if yaw then
		cf = cf * CFrame.Angles(0, yaw, 0)
	end
	return newPart(parent, name, Vector3.new(lx, thick, lz), cf, color, material)
end

-- Triangle rectangle à plat (WedgePart) : angle droit en `p0`, un côté le
-- long de `u` (longueur l1), l'autre le long de `v` (l2) ; u, v horizontaux ;
-- épaisseur `t` centrée sur le plan de p0
local function tri(parent: Instance, name: string, p0: Vector3, u: Vector3, v: Vector3, l1: number, l2: number, t: number, color: Color3): BasePart
	local Y = u
	local Z = -v
	local X = Y:Cross(Z)
	local center = p0 + u * (l1 / 2) + v * (l2 / 2)
	return wedge(parent, name, Vector3.new(t, l1, l2), CFrame.fromMatrix(center, X, Y, Z), color)
end

local function surfaceText(host: BasePart, face: Enum.NormalId, text: string, color: Color3, bg: Color3?, font: Enum.Font?, maxDistance: number?): TextLabel
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Text"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 36
	gui.LightInfluence = 0.7
	gui.MaxDistance = maxDistance or 90
	gui.Parent = host
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = bg and 0 or 1
	label.BackgroundColor3 = bg or WHITE
	label.BorderSizePixel = 0
	label.TextScaled = true
	label.Font = font or Enum.Font.GothamBold
	label.TextColor3 = color
	label.Text = text
	label.Parent = gui
	return label
end

----------------------------------------------------------------------
-- Asphalte : ornières, rustines, fissures
----------------------------------------------------------------------

-- `F` au dessus de la chaussée, X le long ; size = (longueur, voies, largeur)
local function buildRoadSurface(m: Model, F: CFrame, seed: number, spot: any)
	local size = spot and spot.Size or Vector3.new(30, 2, 16)
	local len, lanes, width = size.X, math.max(1, math.floor(size.Y + 0.5)), size.Z
	local laneW = width / lanes
	-- (zone sans rustine ni fissure le long des bordures : stationnement, caniveau)
	local keep = math.max(0.5, width / 2 - 3.5)
	-- traces des roues : deux bandes sombres par voie
	for i = 1, lanes do
		local zc = -width / 2 + laneW * (i - 0.5)
		for _, dz in ipairs({ -2.1, 2.1 }) do
			local z = zc + dz
			if math.abs(z) + 0.65 < width / 2 - 1 then
				flat(m, "Wear", F, 0, z, len, 1.3, H_WEAR, WORN, M.Asphalt)
			end
		end
	end
	-- rustines (1 tous les ~20 studs) : rectangles alignés sur la route
	local nPatch = math.floor(len / 20 + hash(seed, 1))
	local placed = {}
	for i = 1, nPatch do
		local lx = 3 + hash(seed, 10 + i) * 5
		local lz = 1.8 + hash(seed, 20 + i) * 1.8
		local x = (hash(seed, 30 + i) - 0.5) * math.max(0, len - lx - 1)
		local zr = math.max(0, keep - lz / 2)
		local z = (hash(seed, 40 + i) - 0.5) * 2 * zr
		local fresh = hash(seed, 50 + i) < 0.5
		-- (jamais deux rustines l'une sur l'autre)
		local over = false
		for _, q in ipairs(placed) do
			if math.abs(q[1] - x) < (q[3] + lx) / 2 + 0.3 and math.abs(q[2] - z) < (q[4] + lz) / 2 + 0.3 then
				over = true
			end
		end
		if over then
			continue
		end
		table.insert(placed, { x, z, lx, lz })
		flat(m, "Patch", F, x, z, lx, lz, H_PATCH, fresh and PATCH_NEW or PATCH_OLD, M.Asphalt)
		-- joint de la rustine (liseré de goudron sur deux côtés)
		if hash(seed, 55 + i) < 0.6 then
			flat(m, "PatchSeal", F, x, z - lz / 2, lx + 0.1, 0.12, H_CRACK, TAR, M.SmoothPlastic)
		end
	end
	-- fissures colmatées (lignes brisées de goudron)
	local nCrack = math.floor(len / 13 + hash(seed, 2))
	for i = 1, nCrack do
		local x = (hash(seed, 60 + i) - 0.5) * (len - 4)
		local z = (hash(seed, 70 + i) - 0.5) * 2 * math.max(0, keep - 1)
		local yaw = (hash(seed, 80 + i) - 0.5) * 1.4
		local segs = 2 + math.floor(hash(seed, 90 + i) * 2)
		for k = 1, segs do
			local l = 1.2 + hash(seed * 3 + k, 100 + i) * 2
			local dir = Vector3.new(math.cos(yaw), 0, -math.sin(yaw))
			local mid = Vector3.new(x, 0, z) + dir * (l / 2)
			if math.abs(mid.Z) < keep and math.abs(mid.X) < len / 2 - 1 then
				flat(m, "Crack", F, mid.X, mid.Z, l, 0.1, H_CRACK, TAR, M.SmoothPlastic, yaw)
			end
			x, z = x + dir.X * l, z + dir.Z * l
			yaw += (hash(seed * 7 + k, 110 + i) - 0.5) * 1.6
		end
	end
end

----------------------------------------------------------------------
-- Bordure (nez arrondi) + caniveau
----------------------------------------------------------------------

-- `F` : pied de la face de bordure, au niveau de l'asphalte ; X le long,
-- -Z vers la chaussée ; size = (longueur, hauteur de la bordure, 0)
local function buildCurbLine(m: Model, F: CFrame, _seed: number, spot: any)
	local size = spot and spot.Size or Vector3.new(30, 0.53, 0)
	local len, h = size.X, size.Y
	-- caniveau : bande de béton devant la bordure
	flat(m, "Gutter", F, 0, -0.45, len, 0.9, H_WEAR, GUTTER, M.Concrete)
	-- nez arrondi de la bordure (cylindre couché, à moitié dans la bordure)
	local nose = newPart(m, "CurbNose", Vector3.new(len, 0.26, 0.26), F * CFrame.new(0, h - 0.11, 0.03), CURB, M.Concrete, "Cyl")
	nose.CastShadow = false
end

----------------------------------------------------------------------
-- Trottoirs en dalles
----------------------------------------------------------------------

-- (défini plus bas, avec la liste du mobilier : pas de joints dessous)
local underObstacle: (p: Vector3, pad: number) -> boolean

-- `F` : dessus du trottoir, X le long ; size = (longueur, 0, largeur)
local function buildPavers(m: Model, F: CFrame, seed: number, spot: any)
	local size = spot and spot.Size or Vector3.new(30, 0, 5)
	local len, width = size.X, size.Z
	local step = 4.5
	local n = math.floor(len / step)
	local x0 = -len / 2 + (len - n * step) / 2
	for i = 0, n do
		local x = x0 + i * step
		if not underObstacle((F * CFrame.new(x, 0, 0)).Position, width / 2) then
			flat(m, "Joint", F, x, 0, 0.09, width, H_JOINT, JOINT, M.Concrete)
		end
	end
	-- joint longitudinal (dalles de 1,5 m sur 2 rangées), par morceaux libres
	if width > 4 then
		for i = 0, n - 1 do
			local x = x0 + (i + 0.5) * step
			if not underObstacle((F * CFrame.new(x, 0, 0)).Position, step / 2) then
				flat(m, "Joint", F, x, 0, step - 0.12, 0.09, H_JOINT, JOINT, M.Concrete)
			end
		end
	end
	-- quelques dalles d'une autre teinte (remplacées, plus neuves, tachées)
	for i = 0, n - 1 do
		local h = hash(seed, i)
		if h < 0.2 and not underObstacle((F * CFrame.new(x0 + (i + 0.5) * step, 0, 0)).Position, step / 2 + width / 2) then
			local tone = h < 0.1 and WALK:Lerp(WHITE, 0.35) or WALK:Lerp(GRAPHITE, 0.12)
			local half = width > 4 and (hash(seed, i + 50) < 0.5 and -1 or 1) or 0
			local lz = width > 4 and width / 2 - 0.1 or width - 0.1
			flat(m, "Slab", F, x0 + (i + 0.5) * step, half * width / 4, step - 0.1, lz, H_SLAB, tone, M.Pavement)
		end
	end
end

----------------------------------------------------------------------
-- Marquages : flèches, cédez-le-passage, mots peints
----------------------------------------------------------------------

-- Flèche peinte : `F` sur la chaussée, la flèche pointe vers -Z (sens de
-- circulation). seed : 1 tout droit, 2 gauche, 3 droite, 4 tout droit +
-- droite, 5 tout droit + gauche, 6 gauche + droite
local ARROW_TOP = H_PAINT
local PAINT_T = 0.3 -- (dessous à -0,07 : dans la chaussée)
-- pointe de flèche : triangle isocèle, base au point (x, z), pointe vers
-- la direction `yaw` (0 = -Z du repère)
local function head(m: Model, F: CFrame, x: number, z: number, yaw: number)
	local R = F * CFrame.Angles(0, 0, 0)
	local base = (R * CFrame.new(x, ARROW_TOP - PAINT_T / 2, z)).Position
	local dir = (F * CFrame.Angles(0, yaw, 0)).LookVector
	dir = Vector3.new(dir.X, 0, dir.Z).Unit
	local side = Vector3.new(-dir.Z, 0, dir.X)
	-- (côtés dans cet ordre : l'épaisseur du coin pointe vers le bas, comme
	-- la rose des vents de la place)
	tri(m, "ArrowHead", base, side, dir, 0.75, 1.5, PAINT_T, PAINT)
	tri(m, "ArrowHead", base, -side, dir, 0.75, 1.5, PAINT_T, PAINT)
end
local function buildArrow(m: Model, F: CFrame, seed: number)
	local kind = seed % 10
	local straight = kind == 1 or kind == 4 or kind == 5
	-- fût (de +3 à -0,2), puis tout droit jusqu'à la pointe
	flat(m, "ArrowShaft", F, 0, 1.4, 0.4, 3.2, ARROW_TOP, PAINT)
	if straight then
		flat(m, "ArrowShaft", F, 0, -1.1, 0.4, 1.8, ARROW_TOP, PAINT)
		head(m, F, 0, -2.0, 0)
	end
	for _, side in ipairs({ -1, 1 }) do
		local turn = (side < 0 and (kind == 2 or kind == 5 or kind == 6)) or (side > 0 and (kind == 3 or kind == 4 or kind == 6))
		if turn then
			-- branche à 45° qui part du haut du fût, pointe dans son axe
			local bd = Vector3.new(side * 0.7071, 0, -0.7071)
			local b0 = Vector3.new(0, 0, -0.1)
			local mid = b0 + bd * 0.75
			local b1 = b0 + bd * 1.5
			local yaw = -side * math.rad(45)
			flat(m, "ArrowBranch", F, mid.X, mid.Z, 0.4, 1.7, ARROW_TOP, PAINT, nil, yaw)
			head(m, F, b1.X, b1.Z, yaw)
		end
	end
end

-- Dents de requin : `F` au milieu de la voie, les pointes vers +Z (vers
-- les voitures qui arrivent) ; seed = nombre de dents
local function buildGiveWay(m: Model, F: CFrame, seed: number)
	local n = math.max(2, seed)
	local pitch = 1.3
	local dir = F:VectorToWorldSpace(Vector3.new(0, 0, 1))
	local side = F:VectorToWorldSpace(Vector3.new(1, 0, 0))
	for i = 0, n - 1 do
		local x = (i - (n - 1) / 2) * pitch
		local base = (F * CFrame.new(x, ARROW_TOP - PAINT_T / 2, -0.45)).Position
		tri(m, "Tooth", base, side, dir, 0.5, 0.9, PAINT_T, PAINT)
		tri(m, "Tooth", base, -side, dir, 0.5, 0.9, PAINT_T, PAINT)
	end
end

-- Mot peint (lu par le conducteur qui arrive de +Z) : 1 STOP, 2 BUS, 3 ZONE 30, 4 LENT
local WORDS = { "STOP", "BUS", "ZONE 30", "SLOW" }
local function buildRoadWord(m: Model, F: CFrame, seed: number)
	local word = WORDS[seed] or WORDS[1]
	-- (face Top : le haut du texte est vers +Z du support, donc vers le
	-- conducteur qui arrive de +Z ... qui le lit à l'endroit en avançant)
	local host = newPart(m, "RoadWord", Vector3.new(4.6, 0.05, 2.4), F * CFrame.new(0, ARROW_TOP + 0.005, 0), PAINT, M.SmoothPlastic)
	host.Transparency = 1
	local label = surfaceText(host, Enum.NormalId.Top, Locale.T(word), PAINT, nil, Enum.Font.GothamBlack, 120)
	label.TextStrokeTransparency = 1
end

----------------------------------------------------------------------
-- Rond-point
----------------------------------------------------------------------

-- `F` au centre, au niveau de l'asphalte de l'anneau ; size.X = rayon de
-- l'îlot (bordure comprise), size.Z = rayon extérieur de la chaussée ;
-- les branches entrent par +Z et -Z (route d'arrivée) : lignes de cédez
local function buildRoundabout(m: Model, F: CFrame, seed: number, spot: any)
	local size = spot and spot.Size or Vector3.new(8, 0, 20)
	local island, outer = size.X, size.Z
	-- anneau franchissable pavé (pour les camions / bus) autour de l'îlot
	local apron = island + 2.2
	local n = 24
	for i = 0, n - 1 do
		local a = (i + 0.5) / n * math.pi * 2
		local d = Vector3.new(math.sin(a), 0, math.cos(a))
		local mid = d * ((island + apron) / 2)
		local chord = 2 * apron * math.sin(math.pi / n) + 0.05
		local cf = F * CFrame.new(mid) * CFrame.Angles(0, a, 0)
		-- (un pavé sur deux 0,03 plus haut : les recouvrements ne scintillent pas)
		newPart(m, "Apron", Vector3.new(chord, 0.3, apron - island), cf * CFrame.new(0, 0.12 + (i % 2) * 0.03, 0), i % 2 == 0 and rgb(176, 150, 136) or rgb(160, 136, 124), M.Cobblestone)
	end
	-- balises de chevrons sur l'îlot, face aux entrées
	for _, a in ipairs({ 0, math.pi, math.pi / 2, -math.pi / 2 }) do
		local d = Vector3.new(math.sin(a), 0, math.cos(a))
		local base = F * CFrame.new(d * (island - 1.4) + Vector3.new(0, 0.44, 0)) * CFrame.Angles(0, a + math.pi, 0)
		newPart(m, "ChevronPost", Vector3.new(2.2, 0.2, 0.2), base * CFrame.new(0, 1.1, 0) * UPRIGHT, GRAPHITE, M.Metal, "Cyl", true)
		local board = newPart(m, "Chevron", Vector3.new(2.4, 1.2, 0.12), base * CFrame.new(0, 2.6, -0.16), rgb(30, 60, 140), M.SmoothPlastic)
		surfaceText(board, Enum.NormalId.Back, "❯❯❯", WHITE, rgb(30, 60, 140), Enum.Font.GothamBlack, 120)
	end
	-- ligne de cédez-le-passage (pointillés) + dents de requin à l'entrée
	-- (la route d'arrivée entre par -Z)
	for i = -3, 3 do
		flat(m, "YieldDash", F, i * 1.2, -(outer - 0.6), 0.7, 0.35, ARROW_TOP, PAINT)
	end
	-- panneau "sens giratoire" à l'entrée (disque bleu), à droite en arrivant
	for _, sz in ipairs({ -1 }) do
		local base = F * CFrame.new(-9.5, -0.16, sz * (outer + 2.2)) * CFrame.Angles(0, math.pi, 0) -- (pied sur le pré)
		newPart(m, "SignPole", Vector3.new(6.6, 0.24, 0.24), base * CFrame.new(0, 3.3, 0) * UPRIGHT, STEEL, M.Metal, "Cyl", true)
		local disc = newPart(m, "SignDisc", Vector3.new(0.12, 1.9, 1.9), base * CFrame.new(0, 6.2, 0.16) * CFrame.Angles(0, math.rad(90), 0), rgb(34, 90, 190), M.SmoothPlastic, "Cyl")
		surfaceText(disc, Enum.NormalId.Right, "⟳", WHITE, nil, Enum.Font.GothamBlack, 90)
		surfaceText(disc, Enum.NormalId.Left, "⟳", WHITE, nil, Enum.Font.GothamBlack, 90)
	end
	local _ = seed
end

----------------------------------------------------------------------
-- Poteaux indicateurs vers les lieux de la ville
----------------------------------------------------------------------

type Dest = { Id: number, Pos: Vector3 }
local destinations: { Dest } = {}
-- (dalles : pas de joints sous le mobilier ni sur les bandes podotactiles des passages piétons)
local obstacles: { { any } } = {}
local OBSTACLE_R = {
	Zebra = -1, -- (rayon : demi-largeur de la route + 3)
	BusShelter = 5.5,
	Kiosk = 5,
	Terrace = 7,
	Morris = 2.4,
	PhoneBooth = 2.4,
	Vending = 2,
	Bench = 3.4,
	Planter = 3.4,
	Recycle = 2.4,
	TrafficLight = 1.6,
	Beacon = 1.2,
	StreetName = 1.2,
	Direction = 1.2,
	Bin = 1.3,
	Mailbox = 1.2,
	NewsBox = 1.2,
	Bollards = 2.2,
	ParkMeter = 1,
	SpeedSign = 1,
	DogStation = 1.2,
	DrinkFountain = 1.4,
	Lamppost = 1.2,
	PlanterSmall = 1.4,
	FlowerStall = 4,
	BookStall = 4,
}

-- Lieux (seed du repère "Dest") : emoji + nom anglais (Locale -> français)
TownRoads.PLACES = {
	[1] = { "⛲", "Main square" },
	[2] = { "🎡", "Fun fair" },
	[3] = { "🎪", "Circus" },
	[4] = { "🦆", "Lake" },
	[5] = { "🛝", "Playground" },
	[6] = { "🛒", "MégaDopa" },
	[7] = { "🚗", "Car dealer" },
	[8] = { "🍦", "Food corner" },
	[9] = { "🛹", "Skate park" },
	[10] = { "🥕", "Community gardens" },
	[11] = { "🚋", "Tram" },
	[12] = { "⚽", "Sports ground" },
	[13] = { "🏠", "Houses" },
	[14] = { "🌷", "Flower garden" },
	[15] = { "🏰", "Town gate" },
	[16] = { "🧺", "Market" },
	[17] = { "🏓", "Sports corner" },
}

function TownRoads.SetDestinations(spots: { any })
	table.clear(destinations)
	table.clear(obstacles)
	for _, s in ipairs(spots) do
		if s.Kind == "Dest" then
			table.insert(destinations, { Id = s.Seed, Pos = s.Pos })
		end
		local r = OBSTACLE_R[s.Kind]
		if r then
			if r < 0 then
				r = (s.Seed or 100) / 20 + 3
			end
			table.insert(obstacles, { s.Pos, r })
		end
	end
end

underObstacle = function(p: Vector3, pad: number): boolean
	for _, o in ipairs(obstacles) do
		local q: Vector3 = o[1]
		if Vector3.new(p.X - q.X, 0, p.Z - q.Z).Magnitude < o[2] + pad then
			return true
		end
	end
	return false
end

-- `F` au pied (dessus du sol), seed = sel du choix ; jusqu'à 4 lames vers
-- les lieux les plus proches (au-delà de 25 studs), un par type de lieu
local function buildDirection(m: Model, F: CFrame, seed: number)
	local here = F.Position
	local cand = {}
	local seen = {}
	for _, d in ipairs(destinations) do
		local dist = Vector3.new(d.Pos.X - here.X, 0, d.Pos.Z - here.Z).Magnitude
		if dist > 25 and TownRoads.PLACES[d.Id] then
			local prev = seen[d.Id]
			if not prev or prev.Dist > dist then
				seen[d.Id] = { Dest = d, Dist = dist }
			end
		end
	end
	for _, v in pairs(seen) do
		table.insert(cand, v)
	end
	table.sort(cand, function(a, b)
		-- (les grands lieux d'abord, puis les plus proches)
		local pa = (a.Dest.Id <= 8) and 0 or 1
		local pb = (b.Dest.Id <= 8) and 0 or 1
		if pa ~= pb then
			return pa < pb
		end
		return a.Dist < b.Dist
	end)
	local pole = rgb(40, 44, 52)
	newPart(m, "DirPole", Vector3.new(10.6, 0.36, 0.36), F * CFrame.new(0, 5.25, 0) * UPRIGHT, pole, M.Metal, "Cyl", true)
	newPart(m, "DirCap", Vector3.new(0.5, 0.5, 0.5), F * CFrame.new(0, 10.6, 0), pole, M.Metal, "Ball")
	newPart(m, "DirFoot", Vector3.new(0.5, 0.8, 0.8), F * CFrame.new(0, 0.2, 0) * UPRIGHT, pole, M.Metal, "Cyl")
	local colors = { rgb(30, 78, 150), rgb(30, 110, 80), rgb(150, 50, 80), rgb(120, 70, 150) }
	for i = 1, math.min(4, #cand) do
		local c = cand[i]
		local rel = c.Dest.Pos - here
		local yaw = math.atan2(-rel.X, -rel.Z) -- (lame vers -Z du repère tourné)
		local y = 9.6 - (i - 1) * 1.05
		local R = CFrame.new(here) * CFrame.Angles(0, yaw, 0)
		-- la lame part du poteau vers le lieu : X local = à travers, -Z = vers le lieu
		local blade = newPart(m, "DirBlade", Vector3.new(0.12, 0.8, 4.6), R * CFrame.new(0, y, -2.6), colors[(i + seed) % #colors + 1], M.Metal)
		wedge(m, "DirTip", Vector3.new(0.12, 0.4, 0.5), R * CFrame.new(0, y + 0.2, -5.15) * CFrame.Angles(0, math.pi, 0), blade.Color, M.Metal)
		wedge(m, "DirTip", Vector3.new(0.12, 0.4, 0.5), R * CFrame.new(0, y - 0.2, -5.15) * CFrame.Angles(math.pi, 0, 0), blade.Color, M.Metal)
		local place = TownRoads.PLACES[c.Dest.Id]
		local meters = math.floor(c.Dist * 0.33 / 10 + 0.5) * 10
		local text = place[1] .. " " .. Locale.T(place[2]) .. "  " .. meters .. " m"
		surfaceText(blade, Enum.NormalId.Left, text, WHITE, blade.Color, Enum.Font.GothamBold, 70)
		surfaceText(blade, Enum.NormalId.Right, text, WHITE, blade.Color, Enum.Font.GothamBold, 70)
	end
end

----------------------------------------------------------------------
-- Allée piétonne pavée
----------------------------------------------------------------------

-- `F` au milieu de l'allée, sur le sol (dessus du pré) ; X le long ;
-- size = (longueur, style, largeur) ; style 1 = dalles grises, 2 = pavés
-- ocre (parc), 3 = caillebotis bois, 4 = bitume (accès de parking)
local function buildWalkway(m: Model, F: CFrame, seed: number, spot: any)
	local size = spot and spot.Size or Vector3.new(20, 1, 5)
	local len, style, width = size.X, math.floor(size.Y + 0.5), size.Z
	local top = 0.14
	local body = style == 2 and rgb(222, 204, 176) or (style == 3 and rgb(170, 124, 84) or (style == 4 and ASPHALT or rgb(206, 202, 196)))
	local mat = style == 2 and M.Cobblestone or (style == 3 and M.WoodPlanks or (style == 4 and M.Asphalt or M.Pavement))
	newPart(m, "WalkBed", Vector3.new(len, 0.4, width), F * CFrame.new(0, top - 0.2, 0), body, mat)
	-- bordures (0,06 plus hautes)
	for _, sz in ipairs({ -1, 1 }) do
		-- (bordure un peu plus courte que le lit et qui dépasse de 0,05 sur le
		-- côté : aucune face confondue avec lui)
		newPart(m, "WalkEdge", Vector3.new(len - 0.1, 0.4, 0.3), F * CFrame.new(0, top + 0.06 - 0.2, sz * (width / 2 - 0.1)), style == 3 and rgb(120, 86, 58) or rgb(150, 146, 140), style == 3 and M.Wood or M.Concrete)
	end
	if style ~= 3 and style ~= 4 then
		-- joints tous les 3 studs
		local n = math.floor(len / 3)
		for i = 1, n - 1 do
			flat(m, "WalkJoint", F, -len / 2 + i * len / n, 0, 0.08, width - 0.62, top + 0.025, rgb(150, 144, 136), M.Concrete)
		end
	end
	local _ = seed
end

TownRoads.BUILDERS = {
	RoadSurface = buildRoadSurface,
	CurbLine = buildCurbLine,
	Pavers = buildPavers,
	Arrow = buildArrow,
	GiveWay = buildGiveWay,
	RoadWord = buildRoadWord,
	Roundabout = buildRoundabout,
	Direction = buildDirection,
	Walkway = buildWalkway,
}

-- (vus de plus loin : grandes surfaces, poteaux indicateurs)
TownRoads.BIG = { RoadSurface = true, Walkway = true, Roundabout = true, Direction = true }

return TownRoads
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="243">
          <Properties>
            <string name="Name">TownStreetLife</string>
            <string name="Source"><![CDATA[--[[
	TownStreetLife (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > TownStreetLife

	🏙️ Dopamine Town (v9.8, CITY98) : les rues PLEINES DE VIE, construites
	côté CLIENT, en flux autour de l'avatar (0 pièce serveur). Le serveur
	(TownStreets / TownEntrance / TownNature / TownPlaza, via
	TownKit.LifeSpot) publie les emplacements dans DopamineTown > StreetLife
	(une Configuration par case de 64 studs, attribut "Data" : lignes
	"kind;x;y;z;yaw;seed"). Ici on construit, près de l'avatar :
	  - poubelles, bacs de tri, bancs, jardinières, pots, bornes, boîtes aux
	    lettres jaunes, distributeurs de journaux, cabines téléphoniques,
	    distributeurs de boissons, panneaux "30", distributeurs de sacs pour
	    chiens, horodateurs, fontaine à boire ;
	  - abribus vitrés (banc, affiche, poteau d'arrêt), colonnes Morris,
	    kiosque à journaux, étals de fleuriste / bouquiniste, terrasse de
	    café (tables, chaises, parasols) ;
	  - passages piétons (bandes + dalles podotactiles), balises clignotantes,
	    FEUX TRICOLORES animés (voitures + piétons, synchronisés sur l'heure
	    du serveur), plaques d'égout, avaloirs, pistes cyclables peintes,
	    oriflammes, plaques de noms de rue, poteau indicateur, lampadaires ;
	  - grands panneaux publicitaires (affiches drôles), statues en bronze
	    (personnages NPCModels), tables d'échecs, petit MARCHÉ (étals de
	    fruits et légumes sous auvents rayés), COLLINE AU MOULIN À VENT (les
	    ailes tournent), ÉOLIENNES sur les collines lointaines.
	Tout est ancré ; CanQuery / CanTouch false ; seuls les gros objets
	gênent le passage (collision locale). Aucune lumière (les verres de
	lanterne sont "NightGlow" : Neon la nuit, via TownAtmosphere), aucun son.
	Flux : construit à < 190 studs (gros objets : 320, éoliennes : toujours),
	détruit au-delà de +50 ; 6 constructions par passe au plus. Animation
	(feux, balises, moulin, éoliennes, oriflammes) à 20 Hz au plus, et
	seulement pour ce qui est construit.

	API (TownClient, via optionalModule) :
	  TownStreetLife.Start()                 à l'entrée en ville
	  TownStreetLife.Step(position: Vector3) flux (4 fois / s)
	  TownStreetLife.Stop()                  à la sortie
	  TownStreetLife.Spots(kind) -> { {CF, Seed} } (TownPeople : bancs, terrasses…)
	  TownStreetLife.Debug() -> table
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Locale = require(ReplicatedStorage.Shared.Locale)
local NPCModels = require(ReplicatedStorage.Shared.NPCModels)
local Greenery = require(ReplicatedStorage.Shared.Greenery) -- (v9.9, CITY99) arbres construits côté client
local TownRoads = require(script.Parent.TownRoads) -- (v9.9, CITY99) routes, trottoirs, allées, poteaux indicateurs
local TownDistricts = require(script.Parent.TownDistricts) -- (v9.9, CITY99) skatepark, jardins partagés, coin sport
-- (v10, CITY10) la grande ville : quartiers, autoroute, parcs, marquages
-- (plan calculé côté client depuis WorldLayout : CityPlan ; kits CityKit /
-- TownHighway / District*) ; imposteurs de loin
local okCity, CityPlan = pcall(require, script.Parent.CityPlan)
local okKit, CityKit = pcall(require, script.Parent.CityKit)
-- (v9.8, REALISM98) réglage "Graphismes > Détail" : distances de flux x 0,65 / 1 / 1,35
local okGQ, GraphicsQuality = pcall(require, ReplicatedStorage.Shared.GraphicsQuality)
local function detailScale(): number
	if okGQ and type(GraphicsQuality) == "table" and GraphicsQuality.DetailScale then
		local ok, v = pcall(GraphicsQuality.DetailScale)
		if ok and type(v) == "number" then
			return v
		end
	end
	return 1
end

local TownStreetLife = {}

TownStreetLife.FOLDER_NAME = "TownStreetLife"
-- (v9.9, CITY99 -> NPC99) dessus des sièges du mobilier (TownPeople y pose
-- les passants assis) : chaises de terrasse, tabourets des tables d'échecs
TownStreetLife.SEAT_TOPS = { Terrace = 1.25, Chess = 1.45 }
local BUILD_IN, BUILD_OUT = 190, 240
local BIG_IN, BIG_OUT = 320, 380
local IMP_IN, IMP_OUT = 640, 720 -- (v10) imposteurs (silhouettes) des gros lieux
local FAR_IN, FAR_OUT = 2400, 2600
local BUILDS_PER_STEP = 12 -- (v9.9 : 6 -> 12, les tronçons de route sont petits)
local ANIM_STEP = 1 / 20
local ANIM_RANGE = 260

local M = Enum.Material
local rgb = Color3.fromRGB
local UPRIGHT = CFrame.Angles(0, 0, math.rad(90)) -- cylindre debout (axe X -> Y)
local FLAT_X = CFrame.Angles(0, math.rad(90), 0) -- cylindre couché le long de Z

-- Palette "mobilier urbain" réaliste
local GREEN = rgb(38, 78, 62) -- vert municipal
local GRAPHITE = rgb(52, 54, 60)
local STEEL = rgb(170, 174, 182)
local CONCRETE = rgb(206, 202, 196)
local WOOD = rgb(176, 124, 84)
local WHITE = rgb(250, 250, 248)
local YELLOW = rgb(255, 204, 40)
local GLASS = rgb(190, 222, 236)
local INK = rgb(40, 36, 44)
local FLOWERS = {
	rgb(255, 120, 170),
	rgb(255, 200, 70),
	rgb(190, 140, 255),
	rgb(255, 150, 100),
	rgb(250, 250, 250),
	rgb(255, 90, 110),
	rgb(120, 170, 255),
}

-- Types d'objets "gros" (vus de plus loin) et "lointains"
local BIG = { Paint = true, Billboard = true, WindmillHill = true, MarketSquare = true, Statue = true, Kiosk = true, BikeLane = true, BusShelter = true }
local FAR = { Turbine = true }
-- Emplacements qui ne sont PAS du mobilier (ancres des passants : TownPeople)
local ANCHORS = { SitBench = true, Chat = true, Wait = true, Dest = true }

type Spot = {
	Kind: string,
	CF: CFrame,
	Seed: number,
	Pos: Vector3,
	Size: Vector3?,
	Model: Model?,
	Anim: any?,
	Data: any?, -- (v10, CITY10) paramètres du plan (CityPlan)
	Snap: boolean?, -- (v10) recaler au sol (rayon) à la construction
	Imp: Model?, -- (v10) imposteur construit
}

local state: any = nil

----------------------------------------------------------------------
-- Hasard déterministe + fabrique de pièces
----------------------------------------------------------------------

local function hash(a: number, b: number): number
	local x = math.sin(a * 12.9898 + b * 78.233) * 43758.5453
	return x - math.floor(x)
end

local partCount = 0

-- `solid` : l'avatar s'y cogne (collision locale)
local function newPart(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: string?, solid: boolean?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = solid == true
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = solid == true and size.Y > 2
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape == "Ball" then
		p.Shape = Enum.PartType.Ball
	elseif shape == "Cyl" then
		p.Shape = Enum.PartType.Cylinder
	elseif shape == "Egg" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	p.Parent = parent
	partCount += 1
	return p
end

local function wedge(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): WedgePart
	local p = Instance.new("WedgePart")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.Parent = parent
	partCount += 1
	return p
end

-- boîte par ses bornes (repère `F`)
local function box(parent: Instance, name: string, F: CFrame, x0: number, x1: number, y0: number, y1: number, z0: number, z1: number, color: Color3, material: Enum.Material?, solid: boolean?): Part
	return newPart(parent, name, Vector3.new(x1 - x0, y1 - y0, z1 - z0), F * CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2), color, material, nil, solid)
end

-- cylindre debout : bas à y0, haut à y1
local function column(parent: Instance, name: string, F: CFrame, x: number, z: number, y0: number, y1: number, d: number, color: Color3, material: Enum.Material?, solid: boolean?): Part
	return newPart(parent, name, Vector3.new(y1 - y0, d, d), F * CFrame.new(x, (y0 + y1) / 2, z) * UPRIGHT, color, material, "Cyl", solid)
end

local function ball(parent: Instance, name: string, F: CFrame, x: number, y: number, z: number, d: number, color: Color3, material: Enum.Material?): Part
	return newPart(parent, name, Vector3.new(d, d, d), F * CFrame.new(x, y, z), color, material, "Ball")
end

local function egg(parent: Instance, name: string, cf: CFrame, size: Vector3, color: Color3, material: Enum.Material?): Part
	return newPart(parent, name, size, cf, color, material, "Egg")
end

-- tige entre deux points (cylindre)
local function rod(parent: Instance, name: string, a: Vector3, b: Vector3, d: number, color: Color3, material: Enum.Material?): Part
	local axis = (b - a)
	local up = math.abs(axis.Unit.Y) > 0.98 and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0)
	return newPart(parent, name, Vector3.new(axis.Magnitude, d, d), CFrame.lookAt((a + b) / 2, b, up) * CFrame.Angles(0, math.pi / 2, 0), color, material, "Cyl")
end

-- Texte sur une face (SurfaceGui ; LightInfluence douce, pas d'éblouissement)
local function surfaceText(host: BasePart, face: Enum.NormalId, text: string, color: Color3, bg: Color3?, font: Enum.Font?, maxDistance: number?): TextLabel
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Text"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0.6
	gui.Brightness = 1
	gui.MaxDistance = maxDistance or 90
	gui.Parent = host
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = bg and 0 or 1
	label.BackgroundColor3 = bg or WHITE
	label.BorderSizePixel = 0
	label.TextScaled = true
	label.Font = font or Enum.Font.GothamBold
	label.TextColor3 = color
	label.Text = text
	label.Parent = gui
	return label
end

-- Verre de lanterne : mat le jour, Neon la nuit (TownAtmosphere, sous DopamineTown)
local function glow(p: BasePart): BasePart
	p.Material = M.SmoothPlastic
	p:SetAttribute("NightGlow", true)
	return p
end

----------------------------------------------------------------------
-- Petit mobilier
----------------------------------------------------------------------

-- Poubelle municipale (corps vert, anneau, couvercle, fente, socle)
local function buildBin(m: Model, F: CFrame, seed: number)
	local body = hash(seed, 1) < 0.7 and GREEN or rgb(70, 90, 130)
	column(m, "BinFoot", F, 0, 0, -0.05, 0.25, 1.15, GRAPHITE, M.Metal, true)
	column(m, "BinBody", F, 0, 0, 0.2, 2.3, 1.05, body, M.Metal, true)
	column(m, "BinBand", F, 0, 0, 1.55, 1.75, 1.12, body:Lerp(WHITE, 0.3), M.Metal)
	column(m, "BinLid", F, 0, 0, 2.25, 2.6, 1.14, GRAPHITE, M.Metal)
	box(m, "BinSlot", F, -0.3, 0.3, 2.0, 2.2, -0.62, -0.5, INK, M.SmoothPlastic)
end

-- Bacs de tri (verre / papier / emballages)
local function buildRecycle(m: Model, F: CFrame, _seed: number)
	local colors = { rgb(60, 140, 80), rgb(236, 196, 40), rgb(60, 110, 200) }
	for i, c in ipairs(colors) do
		local x = (i - 2) * 1.35
		box(m, "RecycleBody", F, x - 0.6, x + 0.6, -0.05, 2.4, -0.55, 0.55, GRAPHITE, M.Metal, true)
		box(m, "RecycleLid", F, x - 0.65, x + 0.65, 2.35, 2.6, -0.6, 0.6, c, M.SmoothPlastic)
		box(m, "RecycleTag", F, x - 0.4, x + 0.4, 1.3, 1.9, -0.6, -0.5, c, M.SmoothPlastic)
		column(m, "RecycleHole", F, x, -0.1, 2.58, 2.66, 0.5, INK, M.SmoothPlastic)
	end
end

-- Banc de rue (lattes bois, flasques en fonte) ; avant = -Z
local function buildBench(m: Model, F: CFrame, _seed: number)
	local iron = rgb(58, 54, 66)
	for _, sx in ipairs({ -1, 1 }) do
		local x = sx * 2.58
		-- (v9.9 CITY99, échelle SCALE99 : assise à 1,45 = ~45 cm, comme TownKit.BENCH)
		box(m, "BenchLeg", F, x - 0.1, x + 0.1, -0.05, 1.35, -0.75, -0.55, iron, M.Metal)
		box(m, "BenchLeg", F, x - 0.1, x + 0.1, -0.05, 2.75, 0.55, 0.75, iron, M.Metal)
		box(m, "BenchArm", F, x - 0.14, x + 0.14, 2.05, 2.19, -0.85, 0.7, iron, M.Metal)
		box(m, "BenchArmPost", F, x - 0.1, x + 0.1, 1.35, 2.05, -0.75, -0.55, iron, M.Metal)
	end
	box(m, "BenchSeat", F, -2.45, 2.45, 1.27, 1.45, -0.8, -0.05, WOOD, M.Wood, true)
	box(m, "BenchSeat", F, -2.45, 2.45, 1.27, 1.45, 0.05, 0.62, WOOD, M.Wood, true)
	box(m, "BenchBack", F, -2.45, 2.45, 1.8, 2.2, 0.62, 0.78, WOOD, M.Wood)
	box(m, "BenchBack", F, -2.45, 2.45, 2.35, 2.7, 0.66, 0.82, WOOD, M.Wood)
end

-- Jardinière longue (bac béton, arbustes, fleurs)
local function buildPlanter(m: Model, F: CFrame, seed: number)
	box(m, "PlanterBox", F, -2.6, 2.6, -0.05, 1.5, -0.8, 0.8, CONCRETE, M.Concrete, true)
	box(m, "PlanterSoil", F, -2.35, 2.35, 1.3, 1.55, -0.55, 0.55, rgb(96, 70, 52), M.Ground)
	for i = 0, 1 do
		egg(m, "Shrub", F * CFrame.new(-1.3 + i * 2.6, 2.0, 0), Vector3.new(2.3, 1.3, 1.2), rgb(84, 150, 84):Lerp(rgb(110, 176, 96), i), M.Grass)
	end
	for i = 0, 2 do
		local dz = ({ -0.12, 0.1, 0 })[(seed + i) % 3 + 1]
		egg(m, "Flowers", F * CFrame.new(-1.8 + i * 1.8, 2.55, dz), Vector3.new(1.1, 0.55, 0.8), FLOWERS[(seed + i) % #FLOWERS + 1], M.SmoothPlastic)
	end
end

-- Grand pot rond + boule taillée
local function buildPlanterSmall(m: Model, F: CFrame, seed: number)
	column(m, "PotBody", F, 0, 0, -0.05, 1.4, 1.6, rgb(190, 120, 90), M.Slate, true)
	column(m, "PotRim", F, 0, 0, 1.3, 1.55, 1.8, rgb(170, 106, 80), M.Slate)
	ball(m, "Topiary", F, 0, 2.5, 0, 2.0, rgb(84, 150, 84), M.Grass)
	ball(m, "TopiaryFlower", F, 0.55, 3.2, -0.55, 0.5, FLOWERS[seed % #FLOWERS + 1], M.SmoothPlastic)
end

-- Boîte aux lettres jaune (pied, caisson, dessus arrondi, fente, plaque)
local function buildMailbox(m: Model, F: CFrame, _seed: number)
	box(m, "MailFoot", F, -0.25, 0.25, -0.05, 1.8, -0.2, 0.3, GRAPHITE, M.Metal)
	box(m, "MailBody", F, -0.55, 0.55, 1.75, 3.2, -0.45, 0.45, YELLOW, M.Metal, true)
	newPart(m, "MailTop", Vector3.new(1.1, 0.9, 0.9), F * CFrame.new(0, 3.2, 0), YELLOW, M.Metal, "Cyl")
	box(m, "MailSlot", F, -0.3, 0.3, 2.9, 3.0, -0.5, -0.43, INK, M.SmoothPlastic)
	box(m, "MailPlate", F, -0.35, 0.35, 2.05, 2.55, -0.5, -0.43, rgb(40, 70, 150), M.SmoothPlastic)
end

-- Distributeur de journaux (caisse bleue, vitre avec le journal du jour)
local function buildNewsBox(m: Model, F: CFrame, seed: number)
	local c = hash(seed, 3) < 0.5 and rgb(60, 110, 200) or rgb(200, 60, 70)
	box(m, "NewsLegs", F, -0.45, 0.45, -0.05, 0.9, -0.3, 0.3, GRAPHITE, M.Metal)
	box(m, "NewsBody", F, -0.6, 0.6, 0.85, 2.5, -0.5, 0.5, c, M.Metal, true)
	box(m, "NewsWindow", F, -0.45, 0.45, 1.5, 2.3, -0.54, -0.46, GLASS, M.Glass).Transparency = 0.3
	box(m, "NewsPaper", F, -0.35, 0.35, 1.55, 2.2, -0.47, -0.43, rgb(236, 232, 222), M.SmoothPlastic)
	box(m, "NewsTop", F, -0.65, 0.65, 2.45, 2.62, -0.55, 0.55, c:Lerp(INK, 0.3), M.Metal)
end

-- 3 potelets (bande réfléchissante)
local function buildBollards(m: Model, F: CFrame, _seed: number)
	for i = -1, 1 do
		column(m, "Bollard", F, i * 1.3, 0, -0.05, 2.0, 0.42, GRAPHITE, M.Metal, true)
		column(m, "BollardBand", F, i * 1.3, 0, 1.55, 1.75, 0.46, WHITE, M.SmoothPlastic)
		ball(m, "BollardCap", F, i * 1.3, 2.0, 0, 0.42, GRAPHITE, M.Metal)
	end
end

-- Cabine téléphonique vitrée
local function buildPhoneBooth(m: Model, F: CFrame, _seed: number)
	local frame = rgb(60, 70, 90)
	box(m, "BoothBase", F, -1.25, 1.25, -0.05, 0.2, -1.25, 1.25, GRAPHITE, M.Concrete)
	for _, x in ipairs({ -1.2, 1.2 }) do
		for _, z in ipairs({ -1.2, 1.2 }) do
			box(m, "BoothPost", F, x - 0.1, x + 0.1, 0.15, 7.25, z - 0.1, z + 0.1, frame, M.Metal, true)
		end
	end
	box(m, "BoothRoof", F, -1.4, 1.4, 7.2, 7.6, -1.4, 1.4, frame, M.Metal)
	local sign = box(m, "BoothSign", F, -1.05, 1.05, 6.6, 7.0, -1.36, -1.26, WHITE, M.SmoothPlastic)
	surfaceText(sign, Enum.NormalId.Front, "📞 " .. Locale.T("Phone"), rgb(40, 70, 150), WHITE, nil, 60)
	for _, sx in ipairs({ -1, 1 }) do
		local g = box(m, "BoothGlass", F, sx * 1.2 - 0.05, sx * 1.2 + 0.05, 0.9, 6.5, -1.05, 1.05, GLASS, M.Glass, true)
		g.Transparency = 0.55
	end
	local back = box(m, "BoothGlass", F, -1.05, 1.05, 0.9, 6.5, 1.15, 1.25, GLASS, M.Glass, true)
	back.Transparency = 0.55
	box(m, "Phone", F, -0.45, 0.45, 3.4, 4.8, 0.85, 1.12, GRAPHITE, M.Metal)
	box(m, "PhoneHandset", F, -0.4, -0.15, 3.9, 4.6, 0.75, 0.85, INK, M.SmoothPlastic)
end

-- Distributeur de boissons (vitrine à canettes)
local function buildVending(m: Model, F: CFrame, seed: number)
	local brand = ({ rgb(210, 40, 60), rgb(40, 110, 210), rgb(236, 72, 140) })[seed % 3 + 1]
	-- caisson (creux derrière la vitrine : on voit les canettes)
	box(m, "VendBody", F, -1.1, 1.1, -0.05, 5.6, -0.3, 0.8, brand, M.SmoothPlastic, true)
	box(m, "VendFrame", F, -1.1, -0.95, -0.05, 5.6, -0.8, -0.3, brand, M.SmoothPlastic, true)
	box(m, "VendFrame", F, 0.35, 1.1, -0.05, 5.6, -0.8, -0.3, brand, M.SmoothPlastic, true)
	box(m, "VendFrame", F, -0.95, 0.35, -0.05, 1.6, -0.8, -0.3, brand, M.SmoothPlastic, true)
	box(m, "VendFrame", F, -0.95, 0.35, 5.2, 5.6, -0.8, -0.3, brand, M.SmoothPlastic, true)
	box(m, "VendTop", F, -1.15, 1.15, 5.55, 5.9, -0.85, 0.85, brand:Lerp(INK, 0.35), M.SmoothPlastic)
	local glass = box(m, "VendGlass", F, -0.95, 0.35, 1.6, 5.2, -0.86, -0.78, GLASS, M.Glass)
	glass.Transparency = 0.5
	local cans = { rgb(220, 50, 60), rgb(60, 160, 230), rgb(255, 200, 60), rgb(120, 200, 90) }
	for row = 0, 3 do
		local y = 1.9 + row * 0.85
		box(m, "Cans", F, -0.85, 0.25, y, y + 0.55, -0.7, -0.4, cans[(row + seed) % #cans + 1], M.Metal)
		box(m, "VendShelf", F, -0.9, 0.3, y - 0.08, y + 0.02, -0.76, -0.32, STEEL, M.Metal)
	end
	box(m, "VendPanel", F, 0.5, 0.95, 2.6, 4.2, -0.86, -0.78, INK, M.SmoothPlastic)
	box(m, "VendButtons", F, 0.58, 0.87, 3.0, 3.9, -0.9, -0.84, STEEL, M.Metal)
	box(m, "VendTray", F, -0.7, 0.2, 0.6, 1.1, -0.86, -0.78, INK, M.SmoothPlastic)
	local logo = box(m, "VendLogo", F, -0.95, 0.95, 5.25, 5.55, -0.87, -0.79, WHITE, M.SmoothPlastic)
	surfaceText(logo, Enum.NormalId.Front, "🧠 Dopa Cola", brand, WHITE, Enum.Font.FredokaOne, 50)
end

-- Panneau "30" (zone 30)
local function buildSpeedSign(m: Model, F: CFrame, _seed: number)
	column(m, "SignPole", F, 0, 0.1, -0.05, 6.6, 0.22, STEEL, M.Metal)
	newPart(m, "SignPlate", Vector3.new(0.1, 1.9, 1.9), F * CFrame.new(0, 6.2, -0.02) * FLAT_X, rgb(210, 40, 50), M.Metal, "Cyl")
	newPart(m, "SignInner", Vector3.new(0.16, 1.45, 1.45), F * CFrame.new(0, 6.2, -0.02) * FLAT_X, WHITE, M.SmoothPlastic, "Cyl")
	local face = box(m, "SignFace", F, -0.5, 0.5, 5.8, 6.6, -0.15, -0.13, WHITE, M.SmoothPlastic)
	face.Transparency = 1
	surfaceText(face, Enum.NormalId.Front, "30", INK, nil, Enum.Font.GothamBlack, 60)
end

-- Distributeur de sacs pour chiens + petite poubelle
local function buildDogStation(m: Model, F: CFrame, _seed: number)
	column(m, "DogPole", F, 0, 0, -0.05, 4.2, 0.24, GREEN, M.Metal)
	box(m, "DogBox", F, -0.45, 0.45, 3.0, 4.0, -0.35, 0.05, GREEN, M.Metal)
	local icon = box(m, "DogIcon", F, -0.3, 0.3, 3.3, 3.8, -0.39, -0.33, WHITE, M.SmoothPlastic)
	surfaceText(icon, Enum.NormalId.Front, "🐕", GREEN, WHITE, nil, 40)
	box(m, "DogBin", F, -0.4, 0.4, 1.0, 2.0, -0.35, 0.3, GREEN, M.Metal)
end

-- Horodateur (borne de paiement)
local function buildParkMeter(m: Model, F: CFrame, _seed: number)
	box(m, "MeterFoot", F, -0.3, 0.3, -0.05, 1.2, -0.25, 0.25, GRAPHITE, M.Metal)
	box(m, "MeterBody", F, -0.45, 0.45, 1.15, 4.2, -0.35, 0.35, rgb(40, 90, 160), M.Metal, true)
	box(m, "MeterScreen", F, -0.3, 0.3, 3.3, 3.8, -0.39, -0.33, rgb(150, 210, 190), M.Glass)

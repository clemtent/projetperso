		["No walls: go through the edges"] = "Sans murs : passe par les bords",
		["Walls hurt!"] = "Les murs font mal !",
		["⭐ %d snacks · ⭐⭐ %d · ⭐⭐⭐ %d"] = "⭐ %d friandises · ⭐⭐ %d · ⭐⭐⭐ %d",
		["%s snacks"] = "%s friandises",
		["Eat %d snacks for your first ⭐!"] = "Mange %d friandises pour ta première ⭐ !",
		["Ouch!"] = "Aïe !",
		["Swipe on the board or use the arrows to steer"] = "Glisse sur le plateau ou utilise les flèches pour diriger",
		["Arrow keys / WASD to steer · Eat snacks, avoid your tail"] = "Flèches / ZQSD pour diriger · Mange, évite ta queue",
		["Bonk! Watch your tail."] = "Boing ! Attention à ta queue.",

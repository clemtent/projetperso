		["Harder levels and more ⭐ give bigger rewards!"] = "Plus c'est dur et plus il y a de ⭐, plus tu gagnes !",

		-- Serveur (SoloGames)
		["This game is over. Start a new one!"] = "Cette partie est terminée. Lances-en une nouvelle !",
		["Too fast! This run can't be rewarded."] = "Trop rapide ! Cette partie ne peut pas être récompensée.",
		["Arcade unavailable, try again later"] = "Arcade indisponible, réessaie plus tard",

		-- 💣 Démineur
		["Mines left"] = "Mines restantes",
		["⭐⭐⭐ under %s"] = "⭐⭐⭐ en moins de %s",
		["⭐⭐ under %s"] = "⭐⭐ en moins de %s",
		["Boom! A mine woke up 💥"] = "Boum ! Une mine s'est réveillée 💥",
		["Tip: numbers tell how many mines touch the cell."] = "Astuce : les chiffres disent combien de mines touchent la case.",
		["Tap to dig · Hold or use 🚩 to flag"] = "Touche pour creuser · Appui long ou 🚩 pour un drapeau",
		["Click to dig · Right-click to flag · F = flag mode"] = "Clic pour creuser · Clic droit pour un drapeau · F = mode drapeau",
		["Dig mode"] = "Mode pelle",
		["Flag mode"] = "Mode drapeau",
		["Dig mode: taps open cells."] = "Mode pelle : tes clics ouvrent les cases.",
		["Flag mode: taps place flags."] = "Mode drapeau : tes clics posent des drapeaux.",
		["Hold a cell to flag it"] = "Appui long sur une case pour la marquer",
		["Right-click a cell to flag it"] = "Clic droit sur une case pour la marquer",
		["The first cell is always safe. Good luck!"] = "La première case est toujours sans mine. Bonne chance !",
		["Wow, a big opening!"] = "Waouh, une grosse ouverture !",
		["Boom! Numbers show how many mines touch a cell."] = "Boum ! Les chiffres montrent combien de mines touchent une case.",
		["All clear! The mines turned into flowers."] = "Tout est déminé ! Les mines sont devenues des fleurs.",

		-- 🃏 Memory
		["Moves"] = "Coups",
		["Pairs"] = "Paires",
		["%d pairs"] = "%d paires",
		["⭐⭐⭐ in %d moves max"] = "⭐⭐⭐ en %d coups max",
		["⭐⭐ in %d moves max"] = "⭐⭐ en %d coups max",
		["%s moves"] = "%s coups",
		["Flip two cards: same picture = a pair. Fewer moves, more ⭐!"] = "Retourne deux cartes : même image = une paire. Moins de coups, plus de ⭐ !",
		["Find all the pairs. Fewer moves = more ⭐!"] = "Trouve toutes les paires. Moins de coups = plus de ⭐ !",
		["Flip two cards to find a pair."] = "Retourne deux cartes pour trouver une paire.",
		["All pairs found!"] = "Toutes les paires trouvées !",
		["Combo x%d!"] = "Combo x%d !",
		["A pair! Keep going."] = "Une paire ! Continue comme ça.",
		["Not a pair... remember them!"] = "Pas une paire... retiens-les !",

		-- 🎵 Simon
		["Round"] = "Manche",
		["Speed"] = "Vitesse",
		["%d pads · a note every %ss"] = "%d pastilles · une note toutes les %ss",
		["⭐ %d rounds · ⭐⭐ %d · ⭐⭐⭐ %d"] = "⭐ %d manches · ⭐⭐ %d · ⭐⭐⭐ %d",
		["%s rounds"] = "%s manches",
		["Reach round %d for your first ⭐!"] = "Atteins la manche %d pour ta première ⭐ !",
		["Oops!"] = "Oups !",
		["Watch the pads light up, then tap them in the same order"] = "Regarde les pastilles s'allumer, puis touche-les dans le même ordre",
		["Watch the pads light up, then click them in the same order (keys 1-6)"] = "Regarde les pastilles s'allumer, puis clique-les dans le même ordre (touches 1-6)",
		["Watch closely!"] = "Regarde bien !",
		["Remember the order..."] = "Retiens l'ordre...",
		["Your turn! %d notes"] = "À toi ! %d notes",
		["Your turn! Tap the pads in order."] = "À toi ! Touche les pastilles dans l'ordre.",
		["Oops! Wrong pad"] = "Oups ! Mauvaise pastille",
		["So close! Try again?"] = "Presque ! On réessaie ?",
		["Maximum reached!"] = "Maximum atteint !",
		["Incredible memory!"] = "Quelle mémoire incroyable !",
		["Great!"] = "Bravo !",
		["Get ready..."] = "Prépare-toi...",
		["Watch, then repeat!"] = "Regarde, puis répète !",
		["Simon says..."] = "Jacques a dit...",

		-- 🔨 Tape-taupe
		["Time left"] = "Temps restant",
		["Chill moles"] = "Taupes tranquilles",
		["Quick moles"] = "Taupes rapides",
		["Turbo moles"] = "Taupes turbo",
		["%ds"] = "%d s",
		["⭐⭐⭐ = %d%% of the moles"] = "⭐⭐⭐ = %d%% des taupes",
		["%s pts"] = "%s pts",
		["Golden moles are worth 3 points!"] = "Les taupes dorées valent 3 points !",
		["Bonk the moles before they hide · Golden = +3 · Avoid the bombs!"] = "Tape les taupes avant qu'elles se cachent · Dorée = +3 · Évite les bombes !",
		["Bonk the moles! Golden = +3, avoid bombs."] = "Tape les taupes ! Dorée = +3, évite les bombes.",
		["Ouch, a bomb! Avoid them."] = "Aïe, une bombe ! Évite-les.",
		["Golden mole! +3"] = "Taupe dorée ! +3",
		["Go go go!"] = "Vas-y vas-y !",
		["Hurry up!"] = "Dépêche-toi !",

		-- 🐍 Snake

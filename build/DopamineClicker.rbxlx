	------------------------------------------------------------------
	-- Boutons
	------------------------------------------------------------------
	local function hasFraction(value: number): boolean
		for _, fraction in ipairs(stockConfig.Fractions or {}) do
			if math.abs(fraction - value) < 1e-6 then
				return true
			end
		end
		return false
	end

	-- Fractions d'achat affichées : 10 %, 50 %, 100 % (si le serveur les accepte)
	local buyFractions = {}
	for _, fraction in ipairs({ 0.1, 0.5, 1 }) do
		if hasFraction(fraction) then
			table.insert(buyFractions, fraction)
		end
	end
	if #buyFractions == 0 then
		for i, fraction in ipairs(stockConfig.Fractions or {}) do
			if i > 3 then
				break
			end
			table.insert(buyFractions, fraction)
		end
	end

	local buttonRow = frame({
		Name = "Buttons",
		Position = UDim2.fromOffset(8, 140),
		Size = UDim2.fromOffset(CHART_W, 26),
		Parent = card,
	})
	UI.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 4),
		Parent = buttonRow,
	})

	local sellWidth = 74
	local buyWidth = math.floor((CHART_W - sellWidth - 4 * #buyFractions) / math.max(1, #buyFractions))
	local DISABLED_COLOR = Color3.fromRGB(62, 70, 92)

	local function makeButton(text: string, color: Color3, width: number, order: number): TextButton
		-- Support transparent placé par le UIListLayout : le bouton, lui, reste
		-- libre de bouger (sinon UI.Shake, qui change Position, ne fait rien)
		local holder = frame({
			Name = "TradeHolder",
			Size = UDim2.fromOffset(width, 26),
			LayoutOrder = order,
			Parent = buttonRow,
		})
		local button = UI.Create("TextButton", {
			Name = "Trade",
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = color,
			AutoButtonColor = false,
			Font = Theme.Fonts.Title,
			Text = text,
			TextColor3 = WHITE,
			TextSize = 13,
			Parent = holder,
		})
		UI.Corner(button, 8)
		UI.Gradient(button, ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(175, 175, 175)), 90)
		local stroke = UI.Stroke(button, color:Lerp(WHITE, 0.35), 1, 0.3)
		local textStroke = UI.Stroke(button, Color3.new(0, 0, 0), 1, 0.7)
		textStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		-- Reflet en haut
		local shine = frame({
			Position = UDim2.fromOffset(3, 2),
			Size = UDim2.new(1, -6, 0.42, 0),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.8,
			ZIndex = 2,
			Parent = button,
		})
		UI.Corner(shine, 6)
		button:SetAttribute("BaseColor", color)
		button:SetAttribute("Enabled", true)
		UI.AnimateButton(button, 1.06, 0.92)

		-- Survol : un peu plus lumineux
		ctx.Connect(button.MouseEnter, function()
			if button:GetAttribute("Enabled") ~= false then
				UI.Tween(button, 0.15, { BackgroundColor3 = color:Lerp(WHITE, 0.2) })
				UI.Tween(stroke, 0.15, { Transparency = 0 })
			end
		end)
		ctx.Connect(button.MouseLeave, function()
			if button:GetAttribute("Enabled") ~= false then
				UI.Tween(button, 0.15, { BackgroundColor3 = color })
			end
			UI.Tween(stroke, 0.15, { Transparency = 0.3 })
		end)
		return button
	end

	local function setEnabled(button: TextButton, value: boolean)
		if button:GetAttribute("Enabled") == value then
			return
		end
		button:SetAttribute("Enabled", value)
		local base = button:GetAttribute("BaseColor")
		button.BackgroundColor3 = value and (typeof(base) == "Color3" and base or FLAT_COLOR) or DISABLED_COLOR
		button.TextTransparency = value and 0 or 0.45
	end

	local buyButtons: { TextButton } = {}
	for i, fraction in ipairs(buyFractions) do
		local text = "▲ " .. tostring(math.floor(fraction * 100 + 0.5)) .. "%"
		local button = makeButton(text, Color3.fromRGB(22, 170, 96), buyWidth, i)
		button:SetAttribute("Fraction", fraction)
		table.insert(buyButtons, button)
	end
	local sellButton = makeButton(Locale.T("▼ Sell"), Color3.fromRGB(220, 50, 70), sellWidth, 10)

	------------------------------------------------------------------
	-- Bandeau de fausses actus (défile en bas de la carte)
	------------------------------------------------------------------
	local tape = frame({
		Name = "Tape",
		Position = UDim2.fromOffset(8, 170),
		Size = UDim2.fromOffset(CHART_W, 12),
		BackgroundColor3 = Color3.fromRGB(6, 9, 16),
		BackgroundTransparency = 0.2,
		ClipsDescendants = true,
		Parent = card,
	})
	UI.Corner(tape, 4)
	local tapeItems = {}
	local newsDeck: { string } = {}
	local function nextNews(): string
		if #newsDeck == 0 then
			for _, text in ipairs(Locale.Pick(TAPE_NEWS)) do
				table.insert(newsDeck, text)
			end
			for i = #newsDeck, 2, -1 do
				local j = random:NextInteger(1, i)
				newsDeck[i], newsDeck[j] = newsDeck[j], newsDeck[i]
			end
		end
		local text = table.remove(newsDeck) or Locale.Pick(TAPE_NEWS)[1]
		return "📰 " .. string.format(text, symbolName) .. "   •"
	end
	local function measure(text: string): number
		local ok, size = pcall(function()
			return TextService:GetTextSize(text, 10, Enum.Font.BuilderSansMedium, Vector2.new(4000, 12))
		end)
		if ok and size then
			return size.X + 14
		end
		return #text * 5
	end
	for i = 1, 2 do
		local label = UI.Create("TextLabel", {
			Name = "News",
			BackgroundTransparency = 1,
			Font = Theme.Fonts.Body,
			Text = "",
			TextColor3 = Color3.fromRGB(255, 205, 110),
			TextSize = 10,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.fromOffset(10, 12),
			ZIndex = 2,
			Parent = tape,
		})
		tapeItems[i] = { Label = label, X = 0, Width = 10 }
	end
	local function loadTape(item, x: number)
		local text = nextNews()
		item.Label.Text = text
		item.Width = measure(text)
		item.Label.Size = UDim2.fromOffset(item.Width, 12)
		item.X = x
	end
	loadTape(tapeItems[1], CHART_W * 0.3)
	loadTape(tapeItems[2], tapeItems[1].X + tapeItems[1].Width)

	------------------------------------------------------------------
	-- Données et rendu
	------------------------------------------------------------------
	local values: { number } = {}
	local prevLast = 0 -- dernier prix AVANT la mise à jour (pour animer la fin de courbe)
	local slideStart = -math.huge
	local rangeMin, rangeMax = 0, 1
	local targetMin, targetMax = 0, 1
	local lineColor = FLAT_COLOR
	local displayPrice = 0
	local targetPrice = 0
	local dirty = true
	local tagY = -1

	local function getHoldings(): (number, number)
		local data = ctx.State.Data
		local stock = data and data.Stock
		if type(stock) ~= "table" then
			return 0, 0
		end
		return tonumber(stock.Shares) or 0, tonumber(stock.CostBasis) or 0
	end

	-- Recalcule la plage verticale visée (avec une petite marge)
	local function computeRange()
		local lo, hi = math.huge, -math.huge
		for _, value in ipairs(values) do
			lo = math.min(lo, value)
			hi = math.max(hi, value)
		end
		if lo == math.huge then
			lo, hi = 0, 1
		end
		local span = hi - lo
		local minSpan = math.max(hi * 0.02, 0.5)
		if span < minSpan then
			local mid = (hi + lo) / 2
			lo, hi = mid - minSpan / 2, mid + minSpan / 2
			span = minSpan
		end
		targetMin = lo - span * 0.12
		targetMax = hi + span * 0.12
	end

	local function redraw(alpha: number)
		local count = #values
		if count < 2 then
			for _, segment in ipairs(segments) do
				segment.Visible = false
			end
			for _, slice in ipairs(slices) do
				slice.Visible = false
			end
			dot.Visible = false
			dotRing.Visible = false
			avgLine.Visible = false
			priceLine.Visible = false
			priceTag.Visible = false
			loadingLabel.Visible = true
			return
		end
		loadingLabel.Visible = false

		local spacing = PLOT_W / (maxPoints - 1)
		local span = math.max(rangeMax - rangeMin, 1e-6)
		local offset = (1 - alpha) * spacing
		local bottom = PLOT_TOP + PLOT_H
		local prevX, prevY = 0, 0
		for i = 1, count do
			local value = values[i]
			if i == count then
				value = prevLast + (value - prevLast) * alpha
			end
			local x = PLOT_LEFT + PLOT_W - (count - i) * spacing + offset
			local y = PLOT_TOP + PLOT_H * (1 - (value - rangeMin) / span)
			if i > 1 then
				local segment = getSegment(i - 1)
				local dx, dy = x - prevX, y - prevY
				local length = math.sqrt(dx * dx + dy * dy)
				segment.Position = UDim2.fromOffset((x + prevX) / 2, (y + prevY) / 2)
				segment.Size = UDim2.fromOffset(length + LINE_THICKNESS * 0.6, LINE_THICKNESS)
				segment.Rotation = math.deg(math.atan2(dy, dx))
				segment.BackgroundColor3 = lineColor
				segment.Visible = true

				-- Tranche d'aire sous le segment (dégradé vers le bas)
				local slice = getSlice(i - 1)
				local top = math.min(y, prevY) + math.abs(dy) * 0.5
				slice.Position = UDim2.fromOffset(prevX, top)
				slice.Size = UDim2.fromOffset(dx + 1, math.max(0, bottom - top))
				slice.BackgroundColor3 = lineColor
				slice.Visible = true
			end
			prevX, prevY = x, y
		end
		for j = count, #segments do
			segments[j].Visible = false
		end
		for j = count, #slices do
			slices[j].Visible = false
		end

		dot.Position = UDim2.fromOffset(prevX, prevY)
		dot.BackgroundColor3 = lineColor
		dot.Visible = true
		dotRing.Position = dot.Position
		dotRing.BackgroundColor3 = lineColor
		dotRing.Visible = true

		-- Étiquette de prix : suit la fin de courbe (lissée dans OnRender)
		local clampedY = math.clamp(prevY, 7, CHART_H - 7)
		if tagY < 0 then
			tagY = clampedY
		end
		priceLine.Position = UDim2.fromOffset(PLOT_LEFT, prevY)
		priceLine.BackgroundColor3 = lineColor
		priceLine.Visible = true
		priceTag.BackgroundColor3 = lineColor
		priceTag.Visible = true

		-- Prix moyen d'achat (seulement s'il est dans le cadre)
		local shares, costBasis = getHoldings()
		if shares > 1e-9 and costBasis > 0 then
			local average = costBasis / shares
			local y = PLOT_TOP + PLOT_H * (1 - (average - rangeMin) / span)
			avgLine.Position = UDim2.fromOffset(PLOT_LEFT, math.floor(y))
			avgLine.Visible = y >= 2 and y <= CHART_H - 2
		else
			avgLine.Visible = false
		end

		maxLabel.Text = formatPrice(rangeMax)
		minLabel.Text = formatPrice(math.max(0, rangeMin))
	end

	-- Portefeuille (valeur + plus/moins-value + frais)
	local FEE = math.clamp(tonumber(stockConfig.Fee) or 0, 0, 1)
	local feeText = tostring(math.floor(FEE * 100 + 0.5)) .. " %"
	local function refreshHoldings()
		local shares, costBasis = getHoldings()
		local price = targetPrice
		if shares <= 1e-9 then
			valueLabel.Text = Locale.T('💼 <font color="#8C98B4">No shares · %s fee</font>', feeText)
			profitLabel.Text = Locale.T("Buy low, sell high 😏")
			profitLabel.TextColor3 = TEXT_DIM
			profitPill.BackgroundColor3 = FLAT_COLOR
		else
			-- Valeur NETTE des frais de vente : c'est ce que "Vendre" rapporte vraiment
			local value = shares * price * (1 - FEE)
			local sharesText = shares < 100 and string.format("%.2f", shares) or Format.Format(shares)
			valueLabel.Text = Locale.T('💼 <b>%s</b> <font color="#8C98B4">· %s shares</font>', formatAmount(value), sharesText)
			local profit = value - costBasis
			local ratio = costBasis > 0 and profit / costBasis or 0
			local sign = profit >= 0 and "+" or "-"
			profitLabel.Text = (profit >= 0 and "▲ " or "▼ ") .. formatPercent(ratio) .. " (" .. sign .. formatAmount(math.abs(profit)) .. ")"
			local color = profit >= 0 and UP_COLOR or DOWN_COLOR
			profitLabel.TextColor3 = color
			profitPill.BackgroundColor3 = color
		end

		-- Boutons : grisés si impossible
		local data = ctx.State.Data
		local dopamine = data and tonumber(data.Dopamine) or 0
		for _, button in ipairs(buyButtons) do
			setEnabled(button, dopamine >= 1)
		end
		setEnabled(sellButton, shares > 1e-9)
	end

	local function applyStock(stock)
		if type(stock) ~= "table" then
			return
		end
		local history = type(stock.History) == "table" and stock.History or {}
		local previousLast = values[#values]
		local newValues = {}
		local first = math.max(1, #history - maxPoints + 1)
		for i = first, #history do
			local value = tonumber(history[i])
			if value then
				table.insert(newValues, value)
			end
		end
		local price = tonumber(stock.Price)
		if #newValues == 0 and price then
			newValues = { price }
		end
		values = newValues

		local last = values[#values] or price or 0
		prevLast = previousLast or last
		targetPrice = price or last
		if displayPrice == 0 then
			displayPrice = targetPrice
		end

		-- Animation : la courbe glisse d'un cran vers la gauche
		if previousLast ~= nil then
			slideStart = os.clock()
		else
			slideStart = -math.huge
		end

		-- Variation sur la fenêtre affichée
		local firstValue = values[1] or last
		local change = firstValue > 0 and (last - firstValue) / firstValue or 0
		if change > 0.0005 then
			lineColor = UP_COLOR
		elseif change < -0.0005 then
			lineColor = DOWN_COLOR
		else
			lineColor = FLAT_COLOR
		end
		changePill.BackgroundColor3 = lineColor
		changeLabel.Text = (change > 0.0005 and "▲ " or (change < -0.0005 and "▼ " or "")) .. formatPercent(change)
		if #values >= 2 then
			local mood = getMood(change)
			if moodLabel.Text ~= mood then
				moodLabel.Text = mood
				moodLabel.Rotation = random:NextNumber(-6, 6)
				UI.Tween(moodLabel, 0.4, { Rotation = 0 }, Enum.EasingStyle.Back)
			end
		end

		-- Petit "flash" du prix
		if previousLast ~= nil and last ~= previousLast then
			priceLabel.TextColor3 = last > previousLast and UP_COLOR or DOWN_COLOR
			UI.Tween(priceLabel, 0.7, { TextColor3 = TEXT })
			priceScale.Scale = 1.1
			UI.Tween(priceScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		end

		computeRange()
		if previousLast == nil then
			rangeMin, rangeMax = targetMin, targetMax
		end
		dirty = true
		refreshHoldings()
	end

	applyStock(ctx.State.Stock)
	ctx.Connect(ctx.State.StockChanged, applyStock)
	ctx.Connect(ctx.State.Changed, function()
		refreshHoldings()
		dirty = true
	end)
	refreshHoldings()

	-- Rendu : glissement, plage lissée, prix qui "compte", halo, bandeau
	local clock = 0
	ctx.OnRender(function(dt: number)
		dt = math.min(dt, 0.1)
		clock += dt
		local elapsed = os.clock() - slideStart
		local alpha = 1
		if elapsed < SLIDE_TIME then
			local t = math.clamp(elapsed / SLIDE_TIME, 0, 1)
			alpha = 1 - (1 - t) * (1 - t) -- ease out
			dirty = true
		end

		local k = math.min(1, dt * 6)
		if math.abs(rangeMin - targetMin) > 1e-4 or math.abs(rangeMax - targetMax) > 1e-4 then
			rangeMin += (targetMin - rangeMin) * k
			rangeMax += (targetMax - rangeMax) * k
			dirty = true
		end

		if dirty then
			dirty = false
			redraw(alpha)
		end

		-- Étiquette de prix : glisse vers la fin de courbe
		if priceTag.Visible then
			local wanted = math.clamp(dot.Position.Y.Offset, 7, CHART_H - 7)
			tagY += (wanted - tagY) * math.min(1, dt * 10)
			priceTag.Position = UDim2.fromOffset(PLOT_LEFT + PLOT_W + 1, tagY)
		end

		if math.abs(displayPrice - targetPrice) > 0.004 then
			displayPrice += (targetPrice - displayPrice) * math.min(1, dt * 8)
			if math.abs(displayPrice - targetPrice) <= 0.004 then
				displayPrice = targetPrice
			end
			priceLabel.Text = formatPrice(displayPrice)
			priceTagLabel.Text = formatPrice(displayPrice)
		elseif priceLabel.Text == "--" and targetPrice > 0 then
			priceLabel.Text = formatPrice(targetPrice)
			priceTagLabel.Text = formatPrice(targetPrice)
		end

		local pulse = (clock % 1.2) / 1.2
		dotRingScale.Scale = 1 + pulse * 1.6
		dotRing.BackgroundTransparency = 0.45 + pulse * 0.55
		liveDot.BackgroundTransparency = (math.floor(clock * 1.6) % 2 == 0) and 0 or 0.7

		-- Bandeau d'actus : défilement continu, le texte sorti repasse derrière
		for _, item in ipairs(tapeItems) do
			item.X -= TAPE_SPEED * dt
		end
		for index, item in ipairs(tapeItems) do
			if item.X + item.Width < 0 then
				local other = tapeItems[3 - index]
				loadTape(item, math.max(CHART_W, other.X + other.Width))
			end
			item.Label.Position = UDim2.fromOffset(math.floor(item.X), 0)
		end
	end)

	------------------------------------------------------------------
	-- Transactions
	------------------------------------------------------------------
	local busy = false
	local lastTrade = 0
	local cooldown = tonumber(stockConfig.TradeCooldown) or 0.5

	-- Texte flottant + pièces au-dessus du bouton cliqué
	local function feedback(button: TextButton, text: string, color: Color3)
		-- Conversion pixels écran -> pixels "design" de la carte (UIScale)
		local scale = card.AbsoluteSize.X / CARD_W
		local x = CARD_W / 2
		if scale > 0 then
			x = (button.AbsolutePosition.X + button.AbsoluteSize.X / 2 - card.AbsolutePosition.X) / scale
		end
		x = math.clamp(x, 60, CARD_W - 60)
		ctx.FloatText(card, UDim2.fromOffset(x, 126), text, color, 22)
		if effectsOn() then
			ctx.Effects.Burst(card, UDim2.fromOffset(x, 150), Theme.Colors.Gold, 8)
		end
	end

	local function trade(action: string, fraction: number, button: TextButton)
		if busy or os.clock() - lastTrade < cooldown then
			UI.Shake(button)
			return
		end
		if button:GetAttribute("Enabled") == false then
			ctx.Sound.Play("Error")
			UI.Shake(button)
			if action == "sell" then
				ctx.Notify(Locale.T("You don't have any shares to sell 🤷"), Theme.Colors.Red)
			else
				ctx.Notify(Locale.T("Not enough Dopamine to invest 😅"), Theme.Colors.Red)
			end
			return
		end
		busy = true
		lastTrade = os.clock()
		task.spawn(function()
			local ok, success, message = pcall(function()
				return ctx.Net.Function("StockTrade"):InvokeServer(action, fraction)
			end)
			busy = false
			if not ctx.IsAlive() then
				return
			end
			if ok and success then
				ctx.Sound.Play("Cash", action == "sell" and 1.15 or 1)
				local jokes = Locale.Pick(action == "sell" and SELL_JOKES or BUY_JOKES)
				local text = jokes[random:NextInteger(1, #jokes)]
				feedback(button, text, action == "sell" and Theme.Colors.Gold or UP_COLOR)
				ctx.Notify(type(message) == "string" and message or text, action == "sell" and Theme.Colors.Gold or UP_COLOR)
			else
				ctx.Sound.Play("Error")
				UI.Shake(button)
				local text = ok and type(message) == "string" and message or Locale.T("The market isn't responding... 😵")
				ctx.Notify(text, Theme.Colors.Red)
			end
		end)
	end

	for _, button in ipairs(buyButtons) do
		local fraction = button:GetAttribute("Fraction") :: number
		ctx.Connect(button.Activated, function()
			trade("buy", fraction, button)
		end)
	end
	ctx.Connect(sellButton.Activated, function()
		trade("sell", 1, sellButton)
	end)
end

return Stocks
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">Weather</string>
            <string name="Source"><![CDATA[--[[
	Weather (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > Weather

	Orage "illustré" :
	  - ambiance (calque Background, sous les cartes des slots) : de gros
	    nuages duveteux faits de nombreuses bouffées rondes superposées
	    (chacune ombrée du haut clair vers le bas plus sombre, reflets
	    blancs, ombre portée), plus de petits nuages lointains, plus pâles,
	    qui dérivent moins vite (parallaxe, qui suit aussi un peu la
	    souris) ; pluie en traits dégradés qui s'écrasent en éclaboussures ;
	  - quand le SERVEUR envoie un Spawn "Lightning" : un nuage d'orage
	    sombre (lueurs internes qui clignotent) apparaît en (X, Y), un éclair
	    ramifié (halo, cœur lumineux, branches plus fines, colonne de
	    lumière) se dessine de haut en bas avec un stroboscope, flash de
	    l'écran et tonnerre ; le nuage d'ambiance le plus proche s'assombrit
	    et s'illumine de l'intérieur.
	Il faut cliquer sur l'éclair avant qu'il ne disparaisse (Lifetime) :
	ClaimSpawn, et le "+X" confirmé (OnBonus "Lightning") s'affiche à
	l'impact.
]]

local Debris = game:GetService("Debris")
local UserInputService = game:GetService("UserInputService")

local Weather = {}
Weather.Slot = "Overlay"

local Locale = require(game:GetService("ReplicatedStorage").Shared.Locale)

local MAX_BOLTS = 2
local DROPS_PER_CLOUD = 10
local DROPS_LOW_EFFECTS = 4
local SPLASHES_PER_CLOUD = 4
local RAIN_FALL = 74 -- distance de chute des gouttes sous le nuage (pixels "design")

local BOLT_W = 160
local BOLT_H = 244
local BOLT_TOP = 50 -- départ de l'éclair (sous le nuage d'orage)
local BOLT_IMPACT = 206 -- point d'impact dans le cadre de l'éclair
local BOLT_ANCHOR_Y = BOLT_IMPACT / BOLT_H
local STROBE_TIME = 0.45

-- Formes des nuages : bouffées { x, y, diamètre } de l'arrière vers l'avant,
-- base arrondie { x, y, largeur, hauteur }, reflets { x, y, diamètre }
local SHAPES = {
	Big = {
		W = 156,
		H = 78,
		Puffs = {
			{ 58, 0, 60 },
			{ 26, 16, 46 },
			{ 98, 12, 48 },
			{ 4, 36, 36 },
			{ 124, 32, 32 },
			{ 40, 34, 38 },
			{ 80, 32, 40 },
		},
		Base = { 8, 46, 142, 30 },
		Highlights = { { 70, 6, 26 }, { 36, 22, 16 }, { 106, 18, 16 } },
	},
	Small = {
		W = 96,
		H = 46,
		Puffs = {
			{ 32, 0, 38 },
			{ 12, 12, 28 },
			{ 58, 8, 30 },
			{ 0, 24, 22 },
			{ 72, 22, 22 },
		},
		Base = { 4, 28, 88, 18 },
		Highlights = {},
	},
	Storm = {
		W = 150,
		H = 70,
		Puffs = {
			{ 52, 0, 54 },
			{ 22, 14, 42 },
			{ 90, 10, 46 },
			{ 2, 32, 34 },
			{ 116, 30, 32 },
			{ 40, 28, 40 },
			{ 76, 28, 40 },
		},
		Base = { 6, 42, 138, 28 },
		Highlights = { { 62, 6, 20 }, { 98, 16, 14 } },
	},
}

local TAGS = {
	en = { "⚡ catch it!", "⚡ quick!", "⚡ zap?", "⚡ click!", "⚡ here!" },
	fr = { "⚡ attrape !", "⚡ vite !", "⚡ zap ?", "⚡ clique !", "⚡ ici !" },
}
local CHEERS = {
	en = { "ELECTRIFYING!", "ZAP!", "WHAT REFLEXES!", "SHOCKING!", "JOLT!", "100,000 VOLTS!" },
	fr = { "ÉLECTRISANT !", "ZAP !", "QUEL RÉFLEXE !", "FOUDROYANT !", "CHOC !", "100 000 VOLTS !" },
}

-- Tire une phrase au hasard dans la liste de la langue du joueur
local function pickLine(variants, random: Random): string
	local list = Locale.Pick(variants)
	return list[random:NextInteger(1, #list)]
end

function Weather.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local container: Frame = ctx.Container
	local random = Random.new()

	local white = Color3.new(1, 1, 1)
	local yellow = Theme.Colors.Yellow
	local boltCore = Color3.fromRGB(255, 253, 230)
	local boltEdge = Color3.fromRGB(255, 205, 50)
	local boltGlow = Color3.fromRGB(255, 232, 120)
	local cloudColor = Color3.fromRGB(236, 240, 248)
	local cloudStorm = Color3.fromRGB(128, 136, 158)
	local farColor = Color3.fromRGB(214, 222, 236)
	local stormColor = Color3.fromRGB(84, 90, 114)
	local rainColor = Color3.fromRGB(120, 175, 235)
	local innerLight = Color3.fromRGB(255, 246, 205)

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	local function circle(parent: Instance, x: number, y: number, diameter: number, color: Color3, zIndex: number, transparency: number?): Frame
		local frame = UIUtil.Create("Frame", {
			Size = UDim2.fromOffset(diameter, diameter),
			Position = UDim2.fromOffset(x, y),
			BackgroundColor3 = color,
			BackgroundTransparency = transparency or 0,
			BorderSizePixel = 0,
			ZIndex = zIndex,
			Parent = parent,
		})
		UIUtil.Corner(frame, UDim.new(1, 0))
		return frame
	end

	-- Segment de droite (cadre tourné) entre deux points
	local function line(parent: Instance, a: Vector2, b: Vector2, thickness: number, color: Color3, zIndex: number, transparency: number?): Frame
		local delta = b - a
		local middle = (a + b) / 2
		local frame = UIUtil.Create("Frame", {
			Size = UDim2.fromOffset(delta.Magnitude + thickness * 0.8, thickness),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(middle.X, middle.Y),
			Rotation = math.deg(math.atan2(delta.Y, delta.X)),
			BackgroundColor3 = color,
			BackgroundTransparency = transparency or 0,
			BorderSizePixel = 0,
			ZIndex = zIndex,
			Parent = parent,
		})
		UIUtil.Corner(frame, UDim.new(1, 0))
		return frame
	end

	-- Dégradé vertical "multiplicatif" : haut = couleur de fond, bas plus sombre
	local function shade(parent: Instance, bottom: Color3)
		UIUtil.Create("UIGradient", {
			Rotation = 90,
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, white),
				ColorSequenceKeypoint.new(0.55, white:Lerp(bottom, 0.4)),
				ColorSequenceKeypoint.new(1, bottom),
			}),
			Parent = parent,
		})
	end

	------------------------------------------------------------------
	-- Nuage duveteux
	------------------------------------------------------------------
	local function makeCloud(parent: Instance, shapeName: string, color: Color3, zIndex: number, options: { [string]: any }?)
		local shape = SHAPES[shapeName]
		local opts = options or {}
		local transparency = opts.Transparency or 0
		local bottomTint = opts.Bottom or Color3.fromRGB(176, 184, 204)
		local root = UIUtil.Create("Frame", {
			Name = "Cloud",
			Size = UDim2.fromOffset(shape.W, shape.H),
			BackgroundTransparency = 1,
			ZIndex = zIndex,
			Parent = parent,
		})

		-- Ombre portée (ellipse sombre sous le nuage)
		local shadow: Frame? = nil
		if opts.Shadow then
			local base = shape.Base
			shadow = circle(root, base[1] + 6, base[2] + 10, base[3] - 12, Color3.fromRGB(40, 50, 80), zIndex - 1, 0.82)
			local s = shadow :: Frame
			s.Size = UDim2.fromOffset(base[3] - 12, base[4])
		end

		local puffs: { Frame } = {}
		for _, puff in ipairs(shape.Puffs) do
			local frame = circle(root, puff[1], puff[2], puff[3], color, zIndex, transparency)
			shade(frame, bottomTint)
			table.insert(puffs, frame)
		end
		local base = shape.Base
		local baseFrame = UIUtil.Create("Frame", {
			Size = UDim2.fromOffset(base[3], base[4]),
			Position = UDim2.fromOffset(base[1], base[2]),
			BackgroundColor3 = color,
			BackgroundTransparency = transparency,
			BorderSizePixel = 0,
			ZIndex = zIndex,
			Parent = root,
		})
		UIUtil.Corner(baseFrame, UDim.new(1, 0))
		UIUtil.Create("UIGradient", {
			Rotation = 90,
			Color = ColorSequence.new(white:Lerp(bottomTint, 0.45), bottomTint),
			Parent = baseFrame,
		})
		table.insert(puffs, baseFrame)

		-- Reflets (bords éclairés par le dessus)
		for _, highlight in ipairs(shape.Highlights) do
			local frame = circle(root, highlight[1], highlight[2], highlight[3], white, zIndex + 1, opts.HighlightTransparency or 0.45)
			UIUtil.Create("UIGradient", {
				Rotation = 90,
				Transparency = NumberSequence.new(0, 1),
				Parent = frame,
			})
		end

		-- Lueur interne (orage) : invisible au repos
		local glow: Frame? = nil
		if opts.Glow then
			glow = circle(root, shape.W * 0.22, shape.H * 0.1, shape.W * 0.56, innerLight, zIndex + 2, 1)
			UIUtil.Create("UIGradient", {
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1),
					NumberSequenceKeypoint.new(0.5, 0.1),
					NumberSequenceKeypoint.new(1, 1),
				}),
				Parent = glow,
			})
		end

		return {
			Root = root,
			Shape = shape,
			Puffs = puffs,
			Glow = glow,
			Shadow = shadow,
			Color = color,
			Flash = 0, -- intensité de la lueur interne (0..1)
		}
	end

	local function setCloudColor(cloud, color: Color3)
		if cloud.Color == color then
			return
		end
		cloud.Color = color
		for _, puff in ipairs(cloud.Puffs) do
			puff.BackgroundColor3 = color
		end
	end

	------------------------------------------------------------------
	-- Ambiance : dans le calque Background (sous les cartes des slots) :
	-- les nuages et leur pluie ne cachent jamais la bourse (R1) ni le live
	-- (L1). Les éclairs, cliquables, restent dans ctx.Container (Overlay).
	------------------------------------------------------------------
	local ambientHolder = UIUtil.Create("Frame", {
		Name = "WeatherAmbient",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Active = false,
		ZIndex = 1000, -- au-dessus du fond NeonMode / du thème
		Parent = ctx.Interface.Layers.Background or container,
	})
	-- Détruit avec le conteneur (arrêt du stimulus, détox)
	container.Destroying:Connect(function()
		ambientHolder:Destroy()
	end)

	-- Nuages lointains (petits, pâles, lents)
	local farClouds = {}
	local farRanges = {
		{ Min = 0.1, Max = 0.24, Anchor = 0, Y = 64 },
		{ Min = 0.76, Max = 0.9, Anchor = 1, Y = 56 },
	}
	for index, range in ipairs(farRanges) do
		local cloud = makeCloud(ambientHolder, "Small", farColor, 2, { Transparency = 0.35, Bottom = Color3.fromRGB(190, 198, 216) })
		cloud.Root.AnchorPoint = Vector2.new(range.Anchor, 0)
		cloud.Range = range
		cloud.Phase = random:NextNumber(0, math.pi * 2) + index * 2
		table.insert(farClouds, cloud)
	end

	-- Gros nuages de pluie (à gauche et à droite de la colonne centrale)
	local ambient = {}
	local ranges = {
		{ Min = 0.012, Max = 0.16, Anchor = 0 },
		{ Min = 0.84, Max = 0.988, Anchor = 1 },
	}
	local dropCount = effectsOn() and DROPS_PER_CLOUD or DROPS_LOW_EFFECTS
	for index, range in ipairs(ranges) do
		local cloud = makeCloud(ambientHolder, "Big", cloudColor, 6, { Shadow = true, Glow = true })
		local shape = cloud.Shape
		cloud.Root.AnchorPoint = Vector2.new(range.Anchor, 0)
		cloud.Range = range
		cloud.Phase = random:NextNumber(0, math.pi * 2) + index
		cloud.StormUntil = 0
		cloud.Drops = {}
		cloud.Splashes = {}
		cloud.NextSplash = 1
		for _ = 1, dropCount do
			local drop = UIUtil.Create("Frame", {
				Size = UDim2.fromOffset(2, 13),
				AnchorPoint = Vector2.new(0.5, 1),
				Rotation = 14,
				BackgroundColor3 = rainColor,
				BorderSizePixel = 0,
				ZIndex = 4,
				Parent = cloud.Root,
			})
			UIUtil.Corner(drop, UDim.new(1, 0))
			UIUtil.Create("UIGradient", {
				Rotation = 90,
				Transparency = NumberSequence.new(1, 0.1),
				Parent = drop,
			})
			table.insert(cloud.Drops, {
				Frame = drop,
				X = random:NextNumber(16, shape.W - 16),
				Y = random:NextNumber(0, RAIN_FALL),
				Speed = random:NextNumber(110, 160),
			})
		end
		for _ = 1, SPLASHES_PER_CLOUD do
			local splash = UIUtil.Create("Frame", {
				Size = UDim2.fromOffset(8, 3),
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundTransparency = 1,
				Visible = false,
				ZIndex = 4,
				Parent = cloud.Root,
			})
			UIUtil.Corner(splash, UDim.new(1, 0))
			local stroke = UIUtil.Stroke(splash, rainColor, 1.2, 0.2)
			table.insert(cloud.Splashes, { Frame = splash, Stroke = stroke, Age = 1, Active = false })
		end
		table.insert(ambient, cloud)
	end

	local function splashAt(cloud, x: number)
		local splash = cloud.Splashes[cloud.NextSplash]
		cloud.NextSplash = cloud.NextSplash % #cloud.Splashes + 1
		if not splash then
			return
		end
		splash.Active = true
		splash.Age = 0
		splash.Frame.Position = UDim2.fromOffset(x, cloud.Shape.H - 6 + RAIN_FALL)
		splash.Frame.Visible = true
	end

	------------------------------------------------------------------
	-- Éclairs
	------------------------------------------------------------------
	local bolts: { [string]: any } = {}
	local boltCount = 0
	local positions: { [string]: UDim2 } = {}
	local lastPosition = UDim2.fromScale(0.5, 0.5)

	local function fadeAll(root: Instance, duration: number)
		for _, item in ipairs(root:GetDescendants()) do
			if item:IsA("TextLabel") then
				UIUtil.Tween(item, duration, { TextTransparency = 1, BackgroundTransparency = 1 })
			elseif item:IsA("Frame") then
				UIUtil.Tween(item, duration, { BackgroundTransparency = 1 })
			elseif item:IsA("UIStroke") then
				UIUtil.Tween(item, duration, { Transparency = 1 })
			end
		end
	end

	local function removeBolt(bolt, claimed: boolean)
		if bolt.Done then
			return
		end
		bolt.Done = true
		bolts[bolt.Id] = nil
		boltCount -= 1
		if claimed then
			UIUtil.Tween(bolt.Scale, 0.3, { Scale = 1.3 }, Enum.EasingStyle.Quad)
		else
			UIUtil.Tween(bolt.Scale, 0.35, { Scale = 0.85 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end
		fadeAll(bolt.Root, 0.3)
		Debris:AddItem(bolt.Root, 0.4)
	end

	-- Le nuage d'ambiance le plus proche devient orageux et s'illumine
	local function stormNearestCloud(x: number)
		local best, bestDistance = nil, math.huge
		for _, cloud in ipairs(ambient) do
			local center = (cloud.Range.Min + cloud.Range.Max) / 2
			local distance = math.abs(center - x)
			if distance < bestDistance then
				best, bestDistance = cloud, distance
			end
		end
		if best then
			best.StormUntil = os.clock() + 1.6
			best.Flash = 1
		end
	end

	local function spawnBolt(info)
		if not ctx.IsAlive() or type(info) ~= "table" or type(info.Id) ~= "string" then
			return
		end
		if bolts[info.Id] or boltCount >= MAX_BOLTS then
			return
		end
		local x = math.clamp(tonumber(info.X) or 0.5, 0.06, 0.94)
		local y = math.clamp(tonumber(info.Y) or 0.5, 0.1, 0.92)
		local lifetime = math.max(1, tonumber(info.Lifetime) or 2.5)
		local variant = math.floor(tonumber(info.Variant) or 1)
		local shape = Random.new(variant) -- forme déterministe selon la variante

		-- Décalage pour que le nuage ne sorte pas par le haut
		local extra = math.max(0, BOLT_IMPACT + 34 - y * 720)
		local position = UDim2.new(x, 0, y, extra)

		local root = UIUtil.Create("TextButton", {
			Name = "Lightning",
			Size = UDim2.fromOffset(BOLT_W, BOLT_H),
			AnchorPoint = Vector2.new(0.5, BOLT_ANCHOR_Y),
			Position = position,
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Text = "",
			ZIndex = 30,
			Parent = container,
		})
		local scale = UIUtil.Create("UIScale", { Scale = 0.7, Parent = root })
		UIUtil.Tween(scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)

		-- Colonne de lumière derrière l'éclair
		local shaft = UIUtil.Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromOffset(BOLT_W / 2, BOLT_TOP - 10),
			Size = UDim2.fromOffset(70, BOLT_IMPACT - BOLT_TOP + 30),
			BackgroundColor3 = boltGlow,
			BackgroundTransparency = 0.8,
			BorderSizePixel = 0,
			ZIndex = 30,
			Parent = root,
		})
		UIUtil.Create("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.5, 0.3),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = shaft,
		})

		-- Points du zigzag principal
		local points = {}
		local steps = 8
		local side = (variant % 2 == 0) and 1 or -1
		for i = 0, steps do
			local py = BOLT_TOP + (BOLT_IMPACT - BOLT_TOP) * i / steps + (i > 0 and i < steps and shape:NextNumber(-4, 4) or 0)
			local px = BOLT_W / 2
			if i > 0 and i < steps then
				side = -side
				px += side * shape:NextNumber(6, 22)
			elseif i == steps then
				px += shape:NextNumber(-6, 6)
			end
			table.insert(points, Vector2.new(math.clamp(px, 20, BOLT_W - 20), py))
		end

		-- Segments : halo large + cœur lumineux (contour doré), révélés par groupe
		local groups: { { Frame } } = {}
		local cores: { Frame } = {}
		local glows: { Frame } = {}
		local function addSegment(group: { Frame }, a: Vector2, b: Vector2, width: number)
			local glow = line(root, a, b, width + 12, boltGlow, 31, 0.78)
			local core = line(root, a, b, width, boltCore, 33)
			UIUtil.Stroke(core, boltEdge, width >= 4 and 1.5 or 1, 0)
			glow.Visible, core.Visible = false, false
			table.insert(group, glow)
			table.insert(group, core)
			table.insert(cores, core)
			table.insert(glows, glow)
		end
		for i = 1, #points - 1 do
			local group = {}
			local width = 6 - (i / #points) * 2 -- plus fin vers le bas
			addSegment(group, points[i], points[i + 1], width)
			table.insert(groups, group)
		end
		-- Deux branches plus fines
		local branchFrom = { 2 + shape:NextInteger(0, 1), 4 + shape:NextInteger(0, 1) }
		for _, index in ipairs(branchFrom) do
			local from = points[index]
			local group = groups[index] or groups[#groups]
			local dir = (from.X >= BOLT_W / 2) and 1 or -1
			local mid = from + Vector2.new(dir * shape:NextNumber(18, 30), shape:NextNumber(14, 24))
			local tip = mid + Vector2.new(dir * shape:NextNumber(6, 16), shape:NextNumber(12, 20))
			addSegment(group, from, mid, 3)
			addSegment(group, mid, tip, 2)
		end

		-- Nuage d'orage sombre au sommet (lueurs internes)
		local storm = makeCloud(root, "Storm", stormColor, 36, {
			Glow = true,
			Bottom = Color3.fromRGB(120, 124, 140),
			HighlightTransparency = 0.8,
		})
		storm.Root.Position = UDim2.fromOffset((BOLT_W - storm.Shape.W) / 2, 0)

		-- Impact : halo + anneau qui pulse + trace au sol
		local impact = points[#points]
		local scorch = circle(root, impact.X - 20, impact.Y - 4, 40, Color3.fromRGB(60, 40, 10), 30, 0.7)
		scorch.Size = UDim2.fromOffset(40, 9)
		local impactGlow = circle(root, impact.X - 26, impact.Y - 26, 52, boltGlow, 32, 0.5)
		UIUtil.Create("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.5, 0),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = impactGlow,
		})
		local ring = UIUtil.Create("Frame", {
			Size = UDim2.fromOffset(64, 64),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(impact.X, impact.Y),
			BackgroundTransparency = 1,
			ZIndex = 32,
			Parent = root,
		})
		UIUtil.Corner(ring, UDim.new(1, 0))
		local ringStroke = UIUtil.Stroke(ring, yellow, 3, 0.1)
		local ringScale = UIUtil.Create("UIScale", { Parent = ring })

		-- Étiquette
		local tag = UIUtil.Label({
			Text = pickLine(TAGS, random),
			Font = Theme.Fonts.Title,
			TextColor3 = Theme.Colors.TextDark,
			BackgroundColor3 = yellow,
			BackgroundTransparency = 0,
			Size = UDim2.fromOffset(92, 22),
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromOffset(BOLT_W / 2, BOLT_IMPACT + 12),
			MaxTextSize = 15,
			ZIndex = 38,
			Parent = root,
		})
		UIUtil.Corner(tag, UDim.new(1, 0))
		UIUtil.Stroke(tag, Theme.Colors.Border, 1.5, 0.1)

		local bolt = {
			Id = info.Id,
			Root = root,
			Scale = scale,
			Cores = cores,
			Glows = glows,
			Shaft = shaft,
			ImpactGlow = impactGlow,
			RingScale = ringScale,
			RingStroke = ringStroke,
			Storm = storm,
			Base = position,
			Born = os.clock(),
			Lifetime = lifetime,
			Done = false,
		}
		bolts[info.Id] = bolt
		boltCount += 1

		-- Frappe : le zigzag se dessine de haut en bas (très vite)
		task.spawn(function()
			for _, group in ipairs(groups) do
				if bolt.Done or not root.Parent then
					return
				end
				for _, frame in ipairs(group) do
					frame.Visible = true
				end
				task.wait(0.015)
			end
		end)

		ctx.Sound.Play("Thunder", 0.8 + random:NextNumber() * 0.2)
		if effectsOn() then
			ctx.Effects.Flash(Color3.fromRGB(255, 250, 225), 0.32)
			task.delay(0.14, function()
				if ctx.IsAlive() then
					ctx.Effects.Flash(Color3.fromRGB(230, 240, 255), 0.18)
				end
			end)
		end
		storm.Flash = 1
		stormNearestCloud(x)

		-- Clic : on attrape l'éclair
		ctx.Connect(root.Activated, function()
			if bolt.Done or not ctx.IsAlive() then
				return
			end
			local impactPosition = UDim2.new(x, 0, y, extra)
			positions[bolt.Id] = impactPosition
			lastPosition = impactPosition
			ctx.ClaimSpawn(bolt.Id)
			ctx.Sound.Play("Thunder", 1.5)
			if effectsOn() then
				ctx.Effects.Burst(container, impactPosition, yellow, 18)
				ctx.Effects.Burst(container, impactPosition, nil, 8)
			end
			removeBolt(bolt, true)
			local id = bolt.Id
			task.delay(6, function()
				positions[id] = nil
			end)
		end)
	end

	------------------------------------------------------------------
	-- Animation (une seule connexion)
	------------------------------------------------------------------
	local camera = workspace.CurrentCamera
	local parallax = Vector2.zero

	-- Lueur interne d'un nuage : éclairs aléatoires qui retombent
	local function updateGlow(cloud, dt: number, chance: number)
		if cloud.Glow == nil then
			return
		end
		if chance > 0 and random:NextNumber() < chance * dt then
			cloud.Flash = random:NextNumber(0.5, 1)
		end
		cloud.Flash = math.max(0, cloud.Flash - dt * 4)
		cloud.Glow.BackgroundTransparency = 1 - cloud.Flash * 0.85
	end

	ctx.OnRender(function(dt: number)
		dt = math.min(dt, 0.1)
		local now = os.clock()

		-- Parallaxe : suit un peu la souris (lissée)
		if camera and camera.ViewportSize.X > 0 then
			local mouse = UserInputService:GetMouseLocation()
			local target = Vector2.new(
				math.clamp(mouse.X / camera.ViewportSize.X * 2 - 1, -1, 1),
				math.clamp(mouse.Y / camera.ViewportSize.Y * 2 - 1, -1, 1)
			)
			parallax = parallax:Lerp(target, math.min(1, dt * 3))
		end

		-- Nuages lointains : lents, peu de parallaxe
		for _, cloud in ipairs(farClouds) do
			local range = cloud.Range
			local drift = 0.5 + 0.5 * math.sin(now * 0.05 + cloud.Phase)
			local sx = range.Min + (range.Max - range.Min) * drift
			cloud.Root.Position = UDim2.new(sx, -parallax.X * 3, 0, range.Y + math.sin(now * 0.6 + cloud.Phase) * 2 - parallax.Y * 2)
		end

		-- Gros nuages de pluie
		for _, cloud in ipairs(ambient) do
			local range = cloud.Range
			local drift = 0.5 + 0.5 * math.sin(now * 0.08 + cloud.Phase)
			local sx = range.Min + (range.Max - range.Min) * drift
			local bob = math.sin(now * 0.9 + cloud.Phase) * 3
			local stormy = now < cloud.StormUntil
			local rumble = stormy and math.sin(now * 55) * 1.5 or 0
			cloud.Root.Position = UDim2.new(sx, rumble - parallax.X * 8, 0, 34 + bob - parallax.Y * 4)
			setCloudColor(cloud, stormy and cloudStorm or cloudColor)
			updateGlow(cloud, dt, stormy and 7 or 0)

			-- Pluie + éclaboussures
			local shapeH = cloud.Shape.H
			for _, drop in ipairs(cloud.Drops) do
				drop.Y += drop.Speed * dt * (stormy and 1.4 or 1)
				if drop.Y > RAIN_FALL then
					splashAt(cloud, drop.X - RAIN_FALL * 0.25)
					drop.Y = 0
					drop.X = random:NextNumber(16, cloud.Shape.W - 16)
				end
				drop.Frame.Position = UDim2.fromOffset(drop.X - drop.Y * 0.25, shapeH - 8 + drop.Y)
			end
			for _, splash in ipairs(cloud.Splashes) do
				if splash.Active then
					splash.Age += dt * 3
					if splash.Age >= 1 then
						splash.Active = false
						splash.Frame.Visible = false
					else
						splash.Frame.Size = UDim2.fromOffset(6 + splash.Age * 12, 2 + splash.Age * 3)
						splash.Stroke.Transparency = 0.2 + splash.Age * 0.8
					end
				end
			end
		end

		-- Éclairs
		for _, bolt in pairs(bolts) do
			local age = now - bolt.Born
			local left = bolt.Lifetime - age
			if left <= 0 then
				removeBolt(bolt, false)
			else
				-- Stroboscope au début, puis léger scintillement
				local coreAlpha
				if age < STROBE_TIME then
					coreAlpha = (math.floor(age * 28) % 3 == 1) and 0.85 or 0
				else
					coreAlpha = random:NextNumber(0, 0.18)
				end
				for _, core in ipairs(bolt.Cores) do
					core.BackgroundTransparency = coreAlpha
				end
				local glowAlpha = 0.74 + math.sin(now * 22) * 0.08 + coreAlpha * 0.2
				for _, glow in ipairs(bolt.Glows) do
					glow.BackgroundTransparency = glowAlpha
				end
				bolt.Shaft.BackgroundTransparency = 0.78 + math.sin(now * 9) * 0.06 + coreAlpha * 0.2
				bolt.ImpactGlow.BackgroundTransparency = 0.35 + math.sin(now * 12) * 0.15
				-- Anneau qui s'agrandit en boucle
				local cycle = (age * 1.6) % 1
				bolt.RingScale.Scale = 0.6 + cycle * 0.9
				bolt.RingStroke.Transparency = cycle
				-- Nuage d'orage : grondement + lueurs internes
				local storm = bolt.Storm
				storm.Root.Position = UDim2.fromOffset((BOLT_W - storm.Shape.W) / 2 + math.sin(now * 50) * 1.2, 0)
				updateGlow(storm, dt, 5)
				-- Presque fini : tremble
				if left < 0.6 then
					bolt.Root.Position = bolt.Base + UDim2.fromOffset(math.sin(now * 40) * 2, 0)
				end
			end
		end
	end)

	ctx.OnSpawn("Lightning", spawnBolt)

	-- Bonus confirmé : "+X ⚡" à l'impact
	ctx.OnBonus("Lightning", function(payload)
		if not ctx.IsAlive() then
			return
		end
		local position = (payload.SpawnId and positions[payload.SpawnId]) or lastPosition
		ctx.FloatText(container, position, "+" .. ctx.Format.Format(tonumber(payload.Amount) or 0) .. " ⚡", Theme.Colors.Gold, 44)
		ctx.FloatText(container, position + UDim2.fromOffset(0, 44), pickLine(CHEERS, random), Theme.Colors.Orange, 24)
	end)
end

function Weather.Stop(_ctx)
	-- Éclairs dans ctx.Container (détruit par le StimulusManager) ; nuages
	-- d'ambiance dans le calque Background, détruits avec ce conteneur
end

return Weather
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="58">
        <Properties>
          <string name="Name">StimulusManager</string>
          <string name="Source"><![CDATA[--[[
	StimulusManager (ModuleScript)
	Emplacement : ReplicatedStorage > Client > StimulusManager

	Fait apparaître / disparaître les "stimuli" (Client > Stimuli > <Feature>)
	selon les Features débloquées par le joueur :
	  - Feature possédée + module présent + pas encore lancé : crée le cadre
	    (selon Module.Slot, voir Slots), construit le "ctx", lance
	    Module.Start(ctx) dans son propre thread (protégé par pcall) et fait
	    "pop" le cadre ;
	  - Feature perdue (après l'océan) : ctx mort, connexions coupées,
	    Module.Stop(ctx) (si présent), cadre détruit ;
	  - Notify "Detox" : joue la cinématique Stimuli > Ocean (Ocean.Play(ctx)) ;
	  - Notify "Bonus" : transmis aux abonnés ctx.OnBonus(Source, ...).

	Contrat d'un module stimulus :
		local Module = {}
		Module.Slot = "L3"                -- ou "Overlay" / "Background"
		function Module.Start(ctx) end    -- construit l'UI dans ctx.Container
		function Module.Stop(ctx) end     -- optionnel
		return Module

	Champs du ctx : Feature, Container, Overlay, State, Config, Formulas,
	Format, Net, Theme, UIUtil, Effects, Sound, DVDMath, Notify, FloatText,
	GetLevel, HasFeature, ClaimSpawn, Interact, OnSpawn, OnBonus, Connect,
	OnRender, IsAlive, SetDarkMode (+ bonus : Slot, Interface, Random,
	EffectsEnabled, GetSlotScale, et pour l'océan : Payload, Rebirths, Multiplier).
	v5 : sur téléphone / tablette, le cadre d'un slot porte un UIScale
	"SlotScale" (voir Slots) ; l'animation "pop" l'utilise directement.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Locale = require(Shared.Locale)
local Config = require(Shared.Config)
local Formulas = require(Shared.Formulas)
local Net = require(Shared.Net)
local NumberFormatter = require(Shared.NumberFormatter)
local DVDMath = require(Shared.DVDMath)

local Client = script.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local Interface = require(Client.Interface)
local ClientState = require(Client.ClientState)
local Effects = require(Client.Effects)
local SoundManager = require(Client.SoundManager)
local Slots = require(Client.Slots)
local Notifications = require(Client.Components.Notifications)

local StimulusManager = {}

type Record = {
	Feature: string,
	Module: any,
	Ctx: any,
	Container: Frame,
	Slot: string,
	Alive: boolean,
	Dark: boolean,
	Connections: { any },
}

local modules: { [string]: any } = {} -- [nom] = module chargé, ou false si erreur
local running: { [string]: Record } = {}
local bonusSubscribers: { [string]: { { Record: Record, Callback: (any) -> () } } } = {}
local oceanPlaying = false
local initialized = false

----------------------------------------------------------------------
-- Chargement des modules
----------------------------------------------------------------------

local function getStimuliFolder(): Instance?
	return Client:FindFirstChild("Stimuli")
end

local function loadModule(name: string): any?
	local cached = modules[name]
	if cached ~= nil then
		return cached or nil
	end
	local folder = getStimuliFolder()
	local moduleScript = folder and folder:FindFirstChild(name)
	if not moduleScript or not moduleScript:IsA("ModuleScript") then
		return nil -- pas (encore) de module : on ignore silencieusement
	end
	local ok, result = pcall(require, moduleScript)
	if not ok or type(result) ~= "table" then
		warn("[StimulusManager] Impossible de charger Stimuli." .. name .. " : " .. tostring(result))
		modules[name] = false
		return nil
	end
	modules[name] = result
	return result
end

----------------------------------------------------------------------
-- Mode sombre : la source "Stimuli" est active si au moins un stimulus
-- vivant le demande (le thème équipé a sa propre source, voir ClientState)
----------------------------------------------------------------------

local function refreshDarkMode()
	local dark = false
	for _, record in pairs(running) do
		if record.Dark then
			dark = true
			break
		end
	end
	-- Source séparée du thème : un thème sombre reste sombre quand le néon s'arrête
	ClientState.SetDarkSource("Stimuli", dark)
end

----------------------------------------------------------------------
-- Construction du ctx
----------------------------------------------------------------------

local DEAD_CONNECTION = {
	Connected = false,
	Disconnect = function() end,
}

local function newContext(feature: string, container: Frame, slot: string): (any, Record)
	local record: Record = {
		Feature = feature,
		Module = nil,
		Ctx = nil,
		Container = container,
		Slot = slot,
		Alive = true,
		Dark = false,
		Connections = {},
	}

	local ctx = {}
	record.Ctx = ctx

	ctx.Feature = feature
	ctx.Slot = slot
	ctx.Container = container
	ctx.Overlay = Interface.Layers.Overlay
	ctx.Interface = Interface
	ctx.State = ClientState
	ctx.Config = Config
	ctx.Formulas = Formulas
	ctx.Format = NumberFormatter
	ctx.Net = Net
	ctx.Theme = Theme
	ctx.UIUtil = UIUtil
	ctx.Effects = Effects
	ctx.Sound = SoundManager
	ctx.DVDMath = DVDMath
	ctx.Random = Random.new()

	function ctx.IsAlive(): boolean
		return record.Alive
	end

	-- Échelle du slot (1 sur PC, plus petite sur téléphone / tablette).
	-- Le cadre garde sa taille "design" : rien à faire pour s'y adapter.
	function ctx.GetSlotScale(): number
		return Slots.GetScale(slot)
	end

	-- Petit bandeau en bas de l'écran
	function ctx.Notify(text: string, color: Color3?)
		Notifications.Toast(text, color)
	end

	-- Texte "+X" flottant
	function ctx.FloatText(parent: GuiObject, position: UDim2, text: string, color: Color3?, size: number?)
		Effects.FloatingText(parent, position, text, color, size)
	end

	function ctx.GetLevel(upgradeId: string): number
		return ClientState.GetLevel(upgradeId)
	end

	function ctx.HasFeature(name: string): boolean
		return ClientState.HasFeature(name)
	end

	-- Vrai si le joueur n'a pas coupé les effets (particules)
	function ctx.EffectsEnabled(): boolean
		local data = ClientState.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	function ctx.ClaimSpawn(id: string)
		if type(id) ~= "string" then
			return
		end
		Net.Event("SpawnClick"):FireServer(id)
	end

	function ctx.Interact(kind: string, arg: any?)
		Net.Event("Interact"):FireServer(kind, arg)
	end

	-- Connexion suivie (fonctionne avec RBXScriptSignal ET Shared/Signal)
	function ctx.Connect(signal: any, callback: (...any) -> ()): any
		if not record.Alive or signal == nil then
			return DEAD_CONNECTION
		end
		local connection = signal:Connect(function(...)
			if record.Alive then
				callback(...)
			end
		end)
		table.insert(record.Connections, connection)
		return connection
	end

	-- Appelé à chaque image (RenderStepped) ; une erreur coupe la connexion (un seul avertissement)
	function ctx.OnRender(callback: (dt: number) -> ()): any
		local connection
		connection = ctx.Connect(RunService.RenderStepped, function(dt: number)
			local ok, err = pcall(callback, dt)
			if not ok then
				warn("[Stimuli." .. feature .. "] Erreur dans OnRender (boucle arrêtée) : " .. tostring(err))
				if connection then
					connection:Disconnect()
				end
			end
		end)
		return connection
	end

	-- Objets qui apparaissent (étoile, éclair, notif, mail) d'un type donné
	function ctx.OnSpawn(kind: string, callback: (info: any) -> ()): any
		return ctx.Connect(ClientState.SpawnReceived, function(info)
			if info.Kind == kind then
				callback(info)
			end
		end)
	end

	-- Récompenses "Bonus" envoyées par le serveur pour une source donnée
	function ctx.OnBonus(source: string, callback: (payload: any) -> ()): any
		if not record.Alive then
			return DEAD_CONNECTION
		end
		local list = bonusSubscribers[source]
		if not list then
			list = {}
			bonusSubscribers[source] = list
		end
		local entry = { Record = record, Callback = callback }
		table.insert(list, entry)
		local connection = {
			Connected = true,
			Disconnect = function(self)
				local current = bonusSubscribers[source]
				if current then
					local index = table.find(current, entry)
					if index then
						table.remove(current, index)
					end
				end
				if type(self) == "table" then
					self.Connected = false
				end
			end,
		}
		table.insert(record.Connections, connection)
		return connection
	end

	-- Mode sombre (utilisé par le mode néon). Toujours accepté (même dans Stop).
	function ctx.SetDarkMode(enabled: boolean)
		record.Dark = enabled == true and record.Alive
		refreshDarkMode()
	end

	return ctx, record
end

-- Tue un ctx : plus vivant, toutes ses connexions coupées
local function killRecord(record: Record)
	record.Alive = false
	for _, connection in ipairs(record.Connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	table.clear(record.Connections)
end

----------------------------------------------------------------------
-- Démarrage / arrêt d'un stimulus
----------------------------------------------------------------------

local function startFeature(feature: string, module: any)
	local slot = module.Slot
	if type(slot) ~= "string" or not Slots.IsValid(slot) then
		warn("[StimulusManager] Stimuli." .. feature .. " : Slot invalide (" .. tostring(slot) .. "), Overlay utilisé")
		slot = "Overlay"
	end
	local layer = Interface.Layers[Slots.GetLayerName(slot)]
	if not layer then
		return
	end

	local container = Slots.Create(slot, nil)
	container.Name = feature
	local upgradeId = Config.FeatureToUpgrade[feature]
	local upgrade = upgradeId and Config.UpgradesById[upgradeId]
	container.ZIndex = upgrade and upgrade.Order or 1 -- ordre d'empilement stable
	local fullCanvas = slot == "Overlay" or slot == "Background"
	-- "Pop" : on anime l'UIScale du slot (SlotScale, échelle du slot sur
	-- téléphone) ou, à défaut, un UIScale temporaire (un seul UIScale par cadre)
	local slotScale = container:FindFirstChild("SlotScale") :: UIScale?
	local popScale: UIScale? = nil
	local targetScale = 1
	if not fullCanvas then
		if slotScale then
			popScale = slotScale
			targetScale = Slots.GetScale(slot)
			container:SetAttribute("SlotAnimating", true)
			slotScale.Scale = 0.3 * targetScale
		else
			popScale = UIUtil.Create("UIScale", { Name = "PopScale", Scale = 0.3, Parent = container })
		end
	end
	container.Parent = layer

	local ctx, record = newContext(feature, container, slot)
	record.Module = module
	running[feature] = record

	task.spawn(function()
		local ok, err = pcall(module.Start, ctx)
		if not ok then
			warn("[StimulusManager] Erreur dans Stimuli." .. feature .. ".Start : " .. tostring(err))
		end
	end)

	-- Apparition "pop"
	local scale = popScale
	if scale then
		UIUtil.Tween(scale, 0.45, { Scale = targetScale }, Enum.EasingStyle.Back)
		task.delay(0.5, function()
			if scale == slotScale then
				-- Fin de l'animation : échelle actuelle du slot (l'écran a pu changer)
				container:SetAttribute("SlotAnimating", nil)
				if scale.Parent and record.Alive then
					scale.Scale = Slots.GetScale(slot)
				end
			elseif scale.Parent then
				scale:Destroy()
			end
		end)
	end
end

local function stopFeature(feature: string)
	local record = running[feature]
	if not record then
		return
	end
	running[feature] = nil
	killRecord(record)

	local module = record.Module
	if module and type(module.Stop) == "function" then
		local ok, err = pcall(module.Stop, record.Ctx)
		if not ok then
			warn("[StimulusManager] Erreur dans Stimuli." .. feature .. ".Stop : " .. tostring(err))
		end
	end
	record.Dark = false
	refreshDarkMode()

	-- Disparition (petit rétrécissement pour les slots, immédiate sinon)
	local container = record.Container
	if record.Slot == "Overlay" or record.Slot == "Background" then
		container:Destroy()
	else
		local scale = (container:FindFirstChild("SlotScale") or container:FindFirstChild("PopScale")) :: UIScale?
		if not scale then
			scale = UIUtil.Create("UIScale", { Name = "PopScale", Parent = container })
		end
		container:SetAttribute("SlotAnimating", true)
		UIUtil.Tween(scale :: UIScale, 0.25, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		task.delay(0.3, function()
			container:Destroy()
		end)
	end
end

-- Compare les Features possédées avec les stimuli lancés
local function applyFeatures()
	if not ClientState.Data then
		return
	end
	-- Arrêt de ce qui n'est plus possédé
	local toStop = {}
	for feature in pairs(running) do
		if not ClientState.HasFeature(feature) then
			table.insert(toStop, feature)
		end
	end
	for _, feature in ipairs(toStop) do
		stopFeature(feature)
	end
	-- Démarrage dans l'ordre des améliorations (empilement stable)
	for _, upgrade in ipairs(Config.Upgrades) do
		local feature = upgrade.Feature
		if feature and not running[feature] and ClientState.HasFeature(feature) then
			local module = loadModule(feature)
			if module and type(module.Start) == "function" then
				startFeature(feature, module)
			end
		end
	end
end

----------------------------------------------------------------------
-- Cinématique de l'océan
----------------------------------------------------------------------

local function fallbackOcean(container: Frame, payload)
	-- Version minimale si Stimuli > Ocean n'existe pas
	local sea = UIUtil.Create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(0, 140, 200),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = container,
	})
	UIUtil.Gradient(sea, ColorSequence.new(Color3.fromRGB(170, 225, 255), Color3.fromRGB(0, 90, 160)), 90)
	local label = UIUtil.Label({
		Text = Locale.T("Breathe..."),
		Font = Theme.Fonts.Title,
		TextColor3 = Color3.new(1, 1, 1),
		TextTransparency = 1,
		Size = UDim2.new(0.8, 0, 0, 80),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		ZIndex = 3,
		MaxTextSize = 64,
		Parent = sea,
	})
	SoundManager.Play("Detox", 1)
	UIUtil.Tween(sea, 1, { BackgroundTransparency = 0 })
	task.wait(1)
	UIUtil.Tween(label, 0.8, { TextTransparency = 0 })
	task.wait(2)
	label.Text = Locale.T("Rebirth %s", NumberFormatter.Multiplier(tonumber(payload.Multiplier) or 1))
	task.wait(1.5)
	UIUtil.Tween(label, 0.8, { TextTransparency = 1 })
	UIUtil.Tween(sea, 1, { BackgroundTransparency = 1 })
	task.wait(1)
end

local function playOcean(payload)
	if oceanPlaying then
		return
	end
	local layer = Interface.Layers.Cinematic
	if not layer then
		return
	end
	oceanPlaying = true

	local container = UIUtil.Create("Frame", {
		Name = "Ocean",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Active = true,
		Parent = layer,
	})
	-- Bloque les clics pendant la cinématique
	UIUtil.Create("TextButton", {
		Name = "InputBlocker",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 0,
		Parent = container,
	})

	local ctx, record = newContext("Ocean", container, "Cinematic")
	ctx.Payload = payload
	ctx.Rebirths = tonumber(payload.Rebirths) or 0
	ctx.Multiplier = tonumber(payload.Multiplier) or 1
	local module = loadModule("Ocean")
	record.Module = module

	local finished = false
	local function finish()
		if finished then
			return
		end
		finished = true
		oceanPlaying = false
		killRecord(record)
		container:Destroy()
	end

	task.spawn(function()
		local ok, err
		if module and type(module.Play) == "function" then
			ok, err = pcall(module.Play, ctx)
		else
			ok, err = pcall(fallbackOcean, container, payload)
		end
		if not ok then
			warn("[StimulusManager] Erreur dans la cinématique de l'océan : " .. tostring(err))
		end
		finish()
	end)
	task.delay(10, finish)
end

----------------------------------------------------------------------
-- API
----------------------------------------------------------------------

-- Traitement des notifications qui concernent les stimuli (Bonus, Detox)
function StimulusManager.HandleNotify(payload)
	local kind = payload.Type
	if kind == "Bonus" then
		SoundManager.Play("Bonus", 1.2 + math.random() * 0.2)
		local list = payload.Source and bonusSubscribers[payload.Source]
		local delivered = false
		if list then
			for _, entry in ipairs(table.clone(list)) do
				if entry.Record.Alive then
					delivered = true
					task.spawn(function()
						local ok, err = pcall(entry.Callback, payload)
						if not ok then
							warn("[Stimuli." .. entry.Record.Feature .. "] Erreur dans OnBonus : " .. tostring(err))
						end
					end)
				end
			end
		end
		-- Personne n'écoute : petit texte au centre (ou toast du serveur)
		if not delivered then
			local amount = tonumber(payload.Amount)
			local layer = Effects.GetLayer()
			if amount and layer then
				Effects.FloatingText(layer, UDim2.new(0.5, 0, 0, 200), "+" .. NumberFormatter.Format(amount), Theme.Colors.Gold, 40)
			elseif payload.Text then
				Notifications.Toast(payload.Text, Theme.Colors.Gold)
			end
		end
	elseif kind == "Detox" then
		playOcean(payload)
	end
end

-- Liste des stimuli lancés (debug)
function StimulusManager.GetRunning(): { string }
	local list = {}
	for feature in pairs(running) do
		table.insert(list, feature)
	end
	table.sort(list)
	return list
end

-- Relance l'évaluation (ex. après ajout d'un module)
function StimulusManager.Refresh()
	applyFeatures()
end

function StimulusManager.Init()
	if initialized then
		return
	end
	initialized = true

	-- Échelle / position des slots selon l'appareil (téléphone, tablette, PC)
	Slots.Bind(Interface)

	ClientState.FeaturesChanged:Connect(applyFeatures)

	-- Le dossier Stimuli (ou certains modules) peut arriver après nous
	local function watchFolder(folder: Instance)
		folder.ChildAdded:Connect(function()
			task.defer(applyFeatures)
		end)
	end
	local folder = getStimuliFolder()
	if folder then
		watchFolder(folder)
	else
		local connection
		connection = Client.ChildAdded:Connect(function(child)
			if child.Name == "Stimuli" then
				connection:Disconnect()
				watchFolder(child)
				task.defer(applyFeatures)
			end
		end)
	end

	applyFeatures()
end

return StimulusManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="59">
        <Properties>
          <string name="Name">Theme</string>
          <string name="Source"><![CDATA[--[[
	Theme (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Theme

	Direction artistique : "basique" et clair (fond blanc → gris clair,
	bouton gris, texte noir, cartes blanches à bord noir, pastilles rouges).
	L'écran se remplit ensuite de "stimuli" colorés, et le mode néon passe
	l'interface en sombre (voir Theme.DarkColors).
	Change les couleurs et polices ici pour modifier TOUTE l'interface.
]]

local Theme = {}

local function hex(value: string): Color3
	return Color3.fromHex(value)
end

Theme.Colors = {
	-- Fond
	Background = hex("#FFFFFF"),
	BackgroundBottom = hex("#E2E2E2"),

	-- Texte
	Text = hex("#111111"),
	TextDim = hex("#5A5A5A"),
	TextLight = hex("#FFFFFF"),
	TextDark = hex("#111111"),

	-- Contours, boutons, cartes
	Border = hex("#1E1E1E"),
	Button = hex("#F4F4F4"),
	ButtonBottom = hex("#D5D5D5"),
	Card = hex("#FFFFFF"),
	CardBorder = hex("#1A1A1A"),
	Disabled = hex("#B8B8B8"),
	Shadow = hex("#000000"),
	Panel = hex("#FFFFFF"),
	PanelLight = hex("#F2F2F2"),

	-- Couleurs vives
	Red = hex("#E3262B"),
	Green = hex("#3DDC3D"),
	Purple = hex("#8B32E0"),
	Blue = hex("#1E88E5"),
	Orange = hex("#FF8A1A"),
	Yellow = hex("#FFD21F"),
	Pink = hex("#FF3E8A"),
	Cyan = hex("#00C2E0"),
	Gold = hex("#FFC21A"),
	Dark = hex("#2A2A2A"),
}

-- Ajouts v3 (boutique Robux, VIP, boost, ombres)
Theme.Colors.Robux = hex("#00A86B") -- vert "achat"
Theme.Colors.RobuxDark = hex("#007A4D")
Theme.Colors.Premium = hex("#FFB800") -- VIP / Premium
Theme.Colors.Boost = hex("#FF6A00")
Theme.Colors.Divider = hex("#E6E6E6")
Theme.Colors.Surface = hex("#F7F7F8") -- fond des sections dans les fenêtres

-- Anciennes clés (v1) gardées pour compatibilité
Theme.Colors.BackgroundTop = Theme.Colors.Background
Theme.Colors.BackgroundMid = Theme.Colors.PanelLight

-- Couleurs utilisées quand le mode sombre (néon) est actif
Theme.DarkColors = {
	Text = hex("#FFFFFF"),
	TextDim = hex("#C9C3E6"),
	Card = hex("#16121F"),
	CardTransparency = 0.25,
	CardBorder = hex("#FFFFFF"),
	Background = hex("#0B0912"),
}

Theme.Fonts = {
	Title = Enum.Font.BuilderSansBold, -- titres
	Body = Enum.Font.BuilderSansMedium, -- textes
	Number = Enum.Font.BuilderSansBold, -- compteurs
	Mono = Enum.Font.RobotoMono, -- chiffres alignés (bourse...)
}

-- Hiérarchie typographique (tailles en pixels "design")
Theme.TextSize = {
	Display = 44, -- compteur principal
	Title = 26, -- titres de fenêtres
	Heading = 19, -- titres de sections / cartes
	Body = 16, -- textes courants
	Caption = 13, -- petites mentions
}

-- Espacements réguliers (multiples de 4)
Theme.Spacing = {
	XS = 4,
	S = 8,
	M = 12,
	L = 16,
	XL = 24,
}

-- Rayons des coins
Theme.Radius = {
	S = 8,
	M = 12,
	L = 18,
	XL = 22,
}

-- Ombres douces (voir UIUtil.Shadow)
Theme.ShadowStyle = {
	Offset = 4, -- décalage vers le bas
	Transparency = 0.86, -- couche la plus sombre
	Layers = 3, -- nombre de couches (plus = plus doux)
	Spread = 3, -- élargissement par couche
}

-- Palette du mode sombre choisi par le joueur (⚙️ "Mode sombre") : appliquée
-- automatiquement à toute l'interface par DarkSkin (fenêtres, bandeaux,
-- colonne centrale, écran de chargement). Les couleurs vives ne changent pas.
Theme.DarkUI = {
	Background = hex("#121218"), -- fond du jeu (thème Classique)
	BackgroundBottom = hex("#1C1C27"),
	Card = hex("#1E1E28"), -- fenêtres, cartes (ancien blanc)
	Raised = hex("#464656"), -- gris clairs -> surfaces un peu plus claires
	Text = hex("#EDEDF2"),
	TextDim = hex("#A6A6B8"),
	Border = hex("#4A4A5E"), -- contours plus doux que le noir
	Divider = hex("#34343F"),
	Scroll = hex("#6A6A80"),
	TintedDark = 0.32, -- luminosité des fonds pastel une fois assombris
}

-- Résolution de référence : toute l'interface est pensée en 1280x720,
-- puis mise à l'échelle automatiquement (UIScale) selon l'écran.
Theme.DesignResolution = Vector2.new(1280, 720)
Theme.MinScale = 0.45
Theme.MaxScale = 1.6

-- Toile "design" selon l'appareil (voir Interface.Device) : plus petite sur
-- téléphone / tablette, donc tout y est affiché plus gros et lisible.
Theme.DeviceResolutions = {
	Phone = Vector2.new(960, 540),
	Tablet = Vector2.new(1120, 630),
	Desktop = Vector2.new(1280, 720),
}
-- Taille minimale (pixels "design") des zones tactiles sur téléphone / tablette
Theme.TouchTarget = 44

-- Dégradé néon (rose -> violet -> cyan), utilisé par le mode néon
Theme.NeonGradient = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 46, 136)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(157, 78, 221)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 240, 255)),
})

-- Luminosité perçue (0 = noir, 1 = blanc) : sert à choisir un texte lisible
function Theme.Luminance(color: Color3): number
	return 0.299 * color.R + 0.587 * color.G + 0.114 * color.B
end

-- Texte lisible (noir ou blanc) sur un fond de couleur `color`
function Theme.ContrastText(color: Color3): Color3
	return Theme.Luminance(color) > 0.62 and Theme.Colors.TextDark or Theme.Colors.TextLight
end

return Theme
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="60">
        <Properties>
          <string name="Name">UIUtil</string>
          <string name="Source"><![CDATA[--[[
	UIUtil (ModuleScript)
	Emplacement : ReplicatedStorage > Client > UIUtil

	Fonctions utilitaires pour créer l'interface en code : création
	d'instances, coins arrondis, contours, dégradés, boutons animés,
	pastilles ("pills"), badges rouges, ombres...
]]

local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)

local UIUtil = {}

-- Crée une instance avec ses propriétés et ses enfants.
-- Le Parent est appliqué en dernier (meilleures performances).
function UIUtil.Create(className: string, props: { [string]: any }?, children: { Instance }?): any
	local instance = Instance.new(className)
	local parent = nil
	if props then
		for key, value in pairs(props) do
			if key == "Parent" then
				parent = value
			else
				(instance :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function UIUtil.Corner(parent: Instance, radius: (number | UDim)?): UICorner
	local value = radius or 12
	return UIUtil.Create("UICorner", {
		CornerRadius = (typeof(value) == "UDim") and value or UDim.new(0, value :: number),
		Parent = parent,
	})
end

function UIUtil.Stroke(parent: Instance, color: Color3?, thickness: number?, transparency: number?): UIStroke
	return UIUtil.Create("UIStroke", {
		Color = color or Theme.Colors.Border,
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

function UIUtil.Gradient(parent: Instance, color: ColorSequence?, rotation: number?): UIGradient
	return UIUtil.Create("UIGradient", {
		Color = color or Theme.NeonGradient,
		Rotation = rotation or 0,
		Parent = parent,
	})
end

function UIUtil.Padding(parent: Instance, pixels: number): UIPadding
	local padding = UDim.new(0, pixels)
	return UIUtil.Create("UIPadding", {
		PaddingTop = padding,
		PaddingBottom = padding,
		PaddingLeft = padding,
		PaddingRight = padding,
		Parent = parent,
	})
end

-- Lance une animation (Tween) et la renvoie
function UIUtil.Tween(
	instance: Instance,
	duration: number,
	props: { [string]: any },
	style: Enum.EasingStyle?,
	direction: Enum.EasingDirection?
): Tween
	local tween = TweenService:Create(
		instance,
		TweenInfo.new(duration, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
		props
	)
	tween:Play()
	return tween
end

-- Texte simple, transparent, avec la police du thème.
-- MaxTextSize limite la taille du texte (TextScaled) pour éviter les textes géants.
function UIUtil.Label(props: { [string]: any }): TextLabel
	local maxTextSize = props.MaxTextSize or 48
	local finalProps = {
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		TextColor3 = Theme.Colors.Text,
		TextScaled = true,
		Text = "",
	}
	for key, value in pairs(props) do
		if key ~= "MaxTextSize" then
			finalProps[key] = value
		end
	end
	local label = UIUtil.Create("TextLabel", finalProps)
	UIUtil.Create("UITextSizeConstraint", { MaxTextSize = maxTextSize, MinTextSize = 6, Parent = label })
	return label
end

-- Ajoute les animations de survol / appui à n'importe quel bouton
function UIUtil.AnimateButton(button: GuiButton, hoverScale: number?, pressScale: number?)
	local uiScale = button:FindFirstChild("AnimScale") :: UIScale?
	if not uiScale then
		uiScale = UIUtil.Create("UIScale", { Name = "AnimScale", Parent = button })
	end
	local scale = uiScale :: UIScale
	local hover = hoverScale or 1.06
	local press = pressScale or 0.92
	local hovering = false

	button.MouseEnter:Connect(function()
		hovering = true
		UIUtil.Tween(scale, 0.15, { Scale = hover }, Enum.EasingStyle.Back)
	end)
	button.MouseLeave:Connect(function()
		hovering = false
		UIUtil.Tween(scale, 0.15, { Scale = 1 })
	end)
	button.MouseButton1Down:Connect(function()
		UIUtil.Tween(scale, 0.08, { Scale = press })
	end)
	button.MouseButton1Up:Connect(function()
		UIUtil.Tween(scale, 0.25, { Scale = hovering and hover or 1 }, Enum.EasingStyle.Back)
	end)
end

-- Bouton standard (fond coloré, léger contour, animé).
-- Garde son nom v1 "NeonButton" : le style suit simplement le thème.
function UIUtil.NeonButton(props: { [string]: any }): TextButton
	local color = props.Color or Theme.Colors.Pink
	local button = UIUtil.Create("TextButton", {
		Name = props.Name or "NeonButton",
		Size = props.Size or UDim2.fromOffset(160, 48),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = color,
		AutoButtonColor = false,
		Font = props.Font or Theme.Fonts.Title,
		Text = props.Text or "",
		TextColor3 = props.TextColor3 or Theme.ContrastText(color),
		TextScaled = true,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	})
	UIUtil.Corner(button, props.CornerRadius or 12)
	UIUtil.Stroke(button, props.StrokeColor or Theme.Colors.Border, props.StrokeThickness or 2, props.StrokeTransparency or 0.1)
	UIUtil.Create("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize or 26, Parent = button })
	UIUtil.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
		PaddingTop = UDim.new(0, 4),
		PaddingBottom = UDim.new(0, 4),
		Parent = button,
	})
	-- Léger dégradé pour un effet "bouton"
	UIUtil.Gradient(button, ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(215, 215, 215)), 90)
	button:SetAttribute("BaseColor", color)
	button:SetAttribute("Enabled", true)
	UIUtil.AnimateButton(button)
	return button
end

-- Active / grise un bouton (garde sa couleur d'origine en attribut).
-- Le bouton reste cliquable : l'appelant joue un son "erreur" + secousse
-- s'il est désactivé (meilleur retour pour le joueur).
function UIUtil.SetButtonEnabled(button: GuiButton, enabled: boolean)
	local baseColor = button:GetAttribute("BaseColor") or Theme.Colors.Pink
	button.BackgroundColor3 = enabled and baseColor or Theme.Colors.Disabled
	if button:IsA("TextButton") then
		button.TextTransparency = enabled and 0 or 0.35
	end
	button:SetAttribute("Enabled", enabled)
end

-- Petite animation "non !" (secousse) sur un élément
function UIUtil.Shake(guiObject: GuiObject)
	if guiObject:GetAttribute("Shaking") then
		return -- déjà en train de trembler : on ne décale pas la position d'origine
	end
	guiObject:SetAttribute("Shaking", true)
	-- Placé par un UIListLayout / UIGridLayout : Position est ignorée,
	-- on fait trembler la rotation à la place
	local parent = guiObject.Parent
	if parent and parent:FindFirstChildWhichIsA("UIGridStyleLayout") then
		local originRotation = guiObject.Rotation
		task.spawn(function()
			for i = 1, 6 do
				if not guiObject.Parent then
					break
				end
				guiObject.Rotation = originRotation + ((i % 2 == 0) and 4 or -4)
				task.wait(0.03)
			end
			guiObject.Rotation = originRotation
			guiObject:SetAttribute("Shaking", nil)
		end)
		return
	end
	local origin = guiObject.Position
	task.spawn(function()
		for i = 1, 6 do
			if not guiObject.Parent then
				break
			end
			local offset = (i % 2 == 0) and 6 or -6
			guiObject.Position = origin + UDim2.fromOffset(offset, 0)
			task.wait(0.03)
		end
		guiObject.Position = origin
		guiObject:SetAttribute("Shaking", nil)
	end)
end

----------------------------------------------------------------------
-- Ajouts v2
----------------------------------------------------------------------

-- Produit des UIScale des ancêtres de `instance` (sert à convertir une
-- AbsoluteSize en pixels "design" de la toile)
local function ancestorScale(instance: Instance?): number
	local scale = 1
	local node = instance
	while node do
		local uiScale = node:FindFirstChildOfClass("UIScale")
		if uiScale then
			scale *= uiScale.Scale
		end
		node = node.Parent
	end
	return scale
end

local SHADOW_PROPS = {
	Position = true,
	Size = true,
	AnchorPoint = true,
	Rotation = true,
	Visible = true,
	ZIndex = true,
	AbsoluteSize = true,
}

-- Ombre douce sous un cadre : plusieurs couches noires très transparentes,
-- de plus en plus larges, placées DERRIÈRE le cadre (même parent, ZIndex - 1).
-- L'ombre suit automatiquement la position, la taille, la visibilité, la
-- rotation et l'UIScale du cadre, et disparaît avec lui.
-- Renvoie nil si le parent est géré par un UIListLayout / UIGridLayout
-- (l'ombre y prendrait une place) : dans ce cas, mets le cadre dans un
-- support transparent et appelle Shadow dessus.
function UIUtil.Shadow(frame: GuiObject, offset: number?, transparency: number?, spread: number?): Frame?
	local parent = frame.Parent
	if not parent or parent:FindFirstChildWhichIsA("UIGridStyleLayout") then
		return nil
	end
	local style = Theme.ShadowStyle
	local shift = offset or style.Offset
	local base = math.clamp(transparency or style.Transparency, 0, 1)
	local layers = math.max(1, style.Layers)
	local step = spread or style.Spread
	-- Transparence par couche pour qu'au centre (toutes couches empilées)
	-- l'ombre ait la transparence `base`
	local layerTransparency = base ^ (1 / layers)

	local holder = UIUtil.Create("Frame", {
		Name = frame.Name .. "Shadow",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		ZIndex = frame.ZIndex - 1,
		LayoutOrder = frame.LayoutOrder,
		Parent = parent,
	})

	local corner = frame:FindFirstChildOfClass("UICorner")
	local radius = corner and corner.CornerRadius or UDim.new(0, 0)
	for index = 1, layers do
		local grow = (index - 1) * step
		local layer = UIUtil.Create("Frame", {
			Name = "Layer" .. index,
			Size = UDim2.new(1, grow * 2, 1, grow * 2),
			Position = UDim2.fromOffset(-grow, -grow),
			BackgroundColor3 = Theme.Colors.Shadow,
			BackgroundTransparency = layerTransparency,
			BorderSizePixel = 0,
			Active = false,
			ZIndex = frame.ZIndex - 1,
			Parent = holder,
		})
		local layerRadius = radius.Scale > 0 and radius or UDim.new(0, radius.Offset + grow)
		UIUtil.Corner(layer, layerRadius)
	end

	-- UIScale du cadre (animations "pop") recopié sur l'ombre
	local holderScale: UIScale? = nil
	local function bindScale(uiScale: UIScale)
		local mirror = holderScale
		if not mirror then
			mirror = UIUtil.Create("UIScale", { Parent = holder })
			holderScale = mirror
		end
		local target = mirror :: UIScale
		target.Scale = uiScale.Scale
		uiScale:GetPropertyChangedSignal("Scale"):Connect(function()
			if holder.Parent then
				target.Scale = uiScale.Scale
			end
		end)
	end

	local function sync()
		if not holder.Parent and not frame.Parent then
			return
		end
		holder.AnchorPoint = frame.AnchorPoint
		holder.Position = frame.Position + UDim2.fromOffset(0, shift)
		holder.Rotation = frame.Rotation
		holder.Visible = frame.Visible
		if holder.ZIndex ~= frame.ZIndex - 1 then
			holder.ZIndex = frame.ZIndex - 1
			for _, child in ipairs(holder:GetChildren()) do
				if child:IsA("GuiObject") then
					child.ZIndex = frame.ZIndex - 1
				end
			end
		end
		if frame.AutomaticSize ~= Enum.AutomaticSize.None then
			-- Taille automatique : on lit la taille réelle (sans l'UIScale du cadre)
			local ownScale = frame:FindFirstChildOfClass("UIScale")
			local factor = ancestorScale(frame.Parent) * (ownScale and ownScale.Scale or 1)
			if factor > 0 then
				local size = frame.AbsoluteSize / factor
				holder.Size = UDim2.fromOffset(size.X, size.Y)
			end
		else
			holder.Size = frame.Size
		end
	end

	frame.Changed:Connect(function(property: string)
		if SHADOW_PROPS[property] then
			sync()
		end
	end)
	frame.AncestryChanged:Connect(function()
		if frame.Parent ~= holder.Parent then
			holder.Parent = frame.Parent
		end
	end)
	frame.Destroying:Connect(function()
		holder:Destroy()
	end)
	local existing = frame:FindFirstChildOfClass("UIScale")
	if existing then
		bindScale(existing)
	end
	frame.ChildAdded:Connect(function(child)
		if child:IsA("UIScale") and not holderScale then
			bindScale(child)
		end
	end)
	sync()
	return holder
end

-- Badge rouge rond (compteur) accroché en haut à droite d'un élément
function UIUtil.Badge(parent: GuiObject, size: number?): TextLabel
	local diameter = size or 24
	local badge = UIUtil.Create("TextLabel", {
		Name = "Badge",
		Size = UDim2.fromOffset(diameter, diameter),
		AutomaticSize = Enum.AutomaticSize.X,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -4, 0, 4),
		BackgroundColor3 = Theme.Colors.Red,
		Font = Theme.Fonts.Number,
		Text = "",
		TextColor3 = Theme.Colors.TextLight,
		TextSize = math.floor(diameter * 0.62),
		ZIndex = parent.ZIndex + 5,
		Visible = false,
		Parent = parent,
	})
	UIUtil.Corner(badge, UDim.new(1, 0))
	UIUtil.Stroke(badge, Theme.Colors.TextLight, 2)
	UIUtil.Create("UIPadding", {
		PaddingLeft = UDim.new(0, math.floor(diameter * 0.25)),
		PaddingRight = UDim.new(0, math.floor(diameter * 0.25)),
		Parent = badge,
	})
	return badge
end

-- Met à jour un badge : caché si 0, sinon affiche le nombre (ou un texte)
-- (petit "pop" animé quand la valeur change)
function UIUtil.SetBadge(badge: TextLabel, value: number | string)
	local wasVisible = badge.Visible
	local oldText = badge.Text
	if type(value) == "number" then
		badge.Visible = value > 0
		badge.Text = value > 99 and "99+" or tostring(math.floor(value))
	else
		badge.Visible = value ~= ""
		badge.Text = value
	end
	if badge.Visible and (not wasVisible or badge.Text ~= oldText) then
		UIUtil.Pop(badge, wasVisible and 1.35 or 0.2, 0.4)
	end
end

-- Pastille arrondie ("pill") à largeur automatique, comme
-- "🛒 Boutique" ou "⚙️". props : Text, Color, TextColor3, Height, TextSize,
-- LayoutOrder, Name, Parent, Round (true = cercle).
function UIUtil.PillButton(props: { [string]: any }): TextButton
	local color = props.Color or Theme.Colors.Dark
	local height = props.Height or 36
	local round = props.Round == true
	local button = UIUtil.Create("TextButton", {
		Name = props.Name or "Pill",
		Size = UDim2.fromOffset(round and height or 0, height),
		AutomaticSize = round and Enum.AutomaticSize.None or Enum.AutomaticSize.X,
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = color,
		AutoButtonColor = false,
		Font = props.Font or Theme.Fonts.Title,
		Text = props.Text or "",
		TextColor3 = props.TextColor3 or Theme.ContrastText(color),
		TextSize = props.TextSize or math.floor(height * 0.5),
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	})
	UIUtil.Corner(button, UDim.new(1, 0))
	UIUtil.Stroke(button, props.StrokeColor or Theme.Colors.Border, props.StrokeThickness or 1.5, props.StrokeTransparency or 0.2)
	if not round then
		UIUtil.Create("UIPadding", {
			PaddingLeft = UDim.new(0, math.floor(height * 0.45)),
			PaddingRight = UDim.new(0, math.floor(height * 0.45)),
			Parent = button,
		})
	end
	UIUtil.Gradient(button, ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(222, 222, 222)), 90)
	button:SetAttribute("BaseColor", color)
	button:SetAttribute("Enabled", true)
	UIUtil.AnimateButton(button, 1.05, 0.93)
	return button
end

-- Bouton "basique" gris clair à contour fin (style du bouton "Clique-moi")
function UIUtil.BasicButton(props: { [string]: any }): TextButton
	local button = UIUtil.Create("TextButton", {
		Name = props.Name or "BasicButton",
		Size = props.Size or UDim2.fromOffset(160, 48),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = Color3.new(1, 1, 1),
		AutoButtonColor = false,
		Font = props.Font or Theme.Fonts.Body,
		Text = props.Text or "",
		TextColor3 = props.TextColor3 or Theme.Colors.Text,
		TextSize = props.TextSize or 22,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	})
	UIUtil.Corner(button, props.CornerRadius or 10)
	UIUtil.Stroke(button, Theme.Colors.Border, props.StrokeThickness or 1.5, 0)
	UIUtil.Gradient(button, ColorSequence.new(Theme.Colors.Button, Theme.Colors.ButtonBottom), 90)
	button:SetAttribute("BaseColor", Color3.new(1, 1, 1))
	button:SetAttribute("Enabled", true)
	UIUtil.AnimateButton(button, 1.04, 0.94)
	return button
end

----------------------------------------------------------------------
-- Ajouts v3 (finitions "pro")
----------------------------------------------------------------------

-- Petite animation "pop" (UIScale nommé PopScale, créé si besoin)
function UIUtil.Pop(guiObject: GuiObject, fromScale: number?, duration: number?)
	local scale = guiObject:FindFirstChild("PopScale") :: UIScale?
	if not scale then
		scale = UIUtil.Create("UIScale", { Name = "PopScale", Parent = guiObject })
	end
	local target = scale :: UIScale
	target.Scale = fromScale or 1.2
	UIUtil.Tween(target, duration or 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
end

-- Durée en secondes -> "12:34" (ou "1:02:03" au-delà d'une heure)
function UIUtil.FormatClock(seconds: number): string
	local total = math.max(0, math.floor(seconds + 0.5))
	local h = math.floor(total / 3600)
	local m = math.floor((total % 3600) / 60)
	local s = total % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

-- Étiquette arrondie non cliquable ("chip") à largeur automatique :
-- ex. "👑 VIP", "⏱️ x2 • 12:34". props : Text, Color, TextColor3, Height,
-- TextSize, LayoutOrder, Name, Parent, ZIndex, StrokeColor.
-- Renvoie le cadre ; le texte est l'enfant "Label".
function UIUtil.Chip(props: { [string]: any }): Frame
	local color = props.Color or Theme.Colors.Dark
	local height = props.Height or 24
	local chip = UIUtil.Create("Frame", {
		Name = props.Name or "Chip",
		Size = UDim2.fromOffset(0, height),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = color,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Visible = props.Visible ~= false,
		Parent = props.Parent,
	})
	UIUtil.Corner(chip, UDim.new(1, 0))
	UIUtil.Stroke(chip, props.StrokeColor or Theme.Colors.Border, 1, 0.55)
	UIUtil.Create("UIPadding", {
		PaddingLeft = UDim.new(0, math.floor(height * 0.45)),
		PaddingRight = UDim.new(0, math.floor(height * 0.45)),
		Parent = chip,
	})
	UIUtil.Create("TextLabel", {
		Name = "Label",
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		Font = props.Font or Theme.Fonts.Title,
		Text = props.Text or "",
		TextColor3 = props.TextColor3 or Theme.ContrastText(color),
		TextSize = props.TextSize or math.floor(height * 0.6),
		ZIndex = (props.ZIndex or 1) + 1,
		Parent = chip,
	})
	return chip
end

-- Titre de section (texte gras aligné à gauche + fine ligne) pour les fenêtres
function UIUtil.SectionHeader(parent: Instance, text: string, order: number?, color: Color3?): Frame
	local frame = UIUtil.Create("Frame", {
		Name = "Section",
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundTransparency = 1,
		LayoutOrder = order or 0,
		Parent = parent,
	})
	local accent = UIUtil.Create("Frame", {
		Name = "Accent",
		Size = UDim2.fromOffset(4, 18),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		BackgroundColor3 = color or Theme.Colors.Dark,
		BorderSizePixel = 0,
		Parent = frame,
	})
	UIUtil.Corner(accent, 2)
	UIUtil.Create("TextLabel", {
		Name = "Label",
		Size = UDim2.new(1, -12, 1, 0),
		Position = UDim2.fromOffset(12, 0),
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		Text = text,
		TextColor3 = Theme.Colors.Text,
		TextSize = Theme.TextSize.Heading,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})
	return frame
end

-- Déconnecte toutes les connexions d'une liste (RBXScriptConnection ou Signal) puis la vide
function UIUtil.DisconnectAll(connections: { any })
	for _, connection in ipairs(connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	table.clear(connections)
end

----------------------------------------------------------------------
-- Ajouts v4 (boutiques, classement)
----------------------------------------------------------------------

export type Tabs = {
	Frame: Frame,
	Select: (id: string, silent: boolean?) -> (),
	GetSelected: () -> string,
	SetText: (id: string, text: string) -> (),
}

-- Onglets (contrôle segmenté) : fond gris clair arrondi et curseur blanc qui
-- glisse sous l'onglet choisi. props : Parent, Tabs = { { Id, Text } },
-- Color (accent), Size, Position, AnchorPoint, LayoutOrder, ZIndex,
-- TextSize, Selected (Id de départ), OnSelect(id).
function UIUtil.Tabs(props: { [string]: any }): Tabs
	local list = props.Tabs or {}
	local count = math.max(1, #list)
	local accent: Color3 = props.Color or Theme.Colors.Blue
	local selectedColor = accent:Lerp(Color3.new(0, 0, 0), 0.25)
	local zIndex = props.ZIndex or 1
	local frame = UIUtil.Create("Frame", {
		Name = props.Name or "Tabs",
		Size = props.Size or UDim2.new(1, 0, 0, 38),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = Theme.Colors.Surface,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = zIndex,
		Parent = props.Parent,
	})
	UIUtil.Corner(frame, UDim.new(1, 0))
	UIUtil.Stroke(frame, Theme.Colors.Divider, 1)

	local indicator = UIUtil.Create("Frame", {
		Name = "Indicator",
		Size = UDim2.new(1 / count, -6, 1, -6),
		Position = UDim2.new(0, 3, 0, 3),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = zIndex + 1,
		Parent = frame,
	})
	UIUtil.Corner(indicator, UDim.new(1, 0))
	UIUtil.Stroke(indicator, accent, 1.5, 0.35)

	local buttons: { [string]: TextButton } = {}
	local indexOf: { [string]: number } = {}
	local selected = ""
	local tabs: Tabs

	local function paint()
		for id, button in pairs(buttons) do
			button.TextColor3 = id == selected and selectedColor or Theme.Colors.TextDim
		end
	end

	for index, tab in ipairs(list) do
		-- Zone cliquable un peu plus haute que l'onglet (4 px de chaque côté) :
		-- plus facile à toucher au doigt, le texte reste centré
		local button = UIUtil.Create("TextButton", {
			Name = tostring(tab.Id),
			Size = UDim2.new(1 / count, 0, 1, 8),
			Position = UDim2.new((index - 1) / count, 0, 0, -4),
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Font = Theme.Fonts.Title,
			Text = tostring(tab.Text or tab.Id),
			TextColor3 = Theme.Colors.TextDim,
			TextSize = props.TextSize or 16,
			ZIndex = zIndex + 2,
			Parent = frame,
		})
		buttons[tab.Id] = button
		indexOf[tab.Id] = index
		button.MouseEnter:Connect(function()
			if tab.Id ~= selected then
				button.TextColor3 = Theme.Colors.Text
			end
		end)
		button.MouseLeave:Connect(paint)
		button.Activated:Connect(function()
			tabs.Select(tab.Id)
		end)
	end

	tabs = {
		Frame = frame,
		Select = function(id: string, silent: boolean?)
			local index = indexOf[id]
			if not index then
				return
			end
			local changed = id ~= selected
			selected = id
			UIUtil.Tween(indicator, 0.25, {
				Position = UDim2.new((index - 1) / count, 3, 0, 3),
			}, Enum.EasingStyle.Quint)
			paint()
			if changed and not silent and props.OnSelect then
				props.OnSelect(id)
			end
		end,
		GetSelected = function(): string
			return selected
		end,
		SetText = function(id: string, text: string)
			local button = buttons[id]
			if button then
				button.Text = text
			end
		end,
	}

	local first = props.Selected or (list[1] and list[1].Id)
	if first then
		local index = indexOf[first] or 1
		selected = first
		indicator.Position = UDim2.new((index - 1) / count, 3, 0, 3)
		paint()
	end
	return tabs
end

-- Rayons de lumière en étoile (fines bandes qui s'estompent vers
-- l'extérieur), à placer derrière une icône. Renvoie le cadre (carré,
-- centré sur `position`) : fais-le tourner pour un effet "vitrine".
function UIUtil.Rays(parent: Instance, color: Color3, count: number?, size: number?, position: UDim2?, zIndex: number?): Frame
	local total = count or 6
	local diameter = size or 160
	local z = zIndex or 1
	local holder = UIUtil.Create("Frame", {
		Name = "Rays",
		Size = UDim2.fromOffset(diameter, diameter),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = position or UDim2.fromScale(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = z,
		Parent = parent,
	})
	for index = 1, total do
		local bar = UIUtil.Create("Frame", {
			Name = "Ray" .. index,
			Size = UDim2.new(0, math.max(6, math.floor(diameter * 0.09)), 1, 0),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Rotation = (index - 1) * 180 / total,
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			ZIndex = z,
			Parent = holder,
		})
		UIUtil.Create("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.5, 0.45),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = bar,
		})
	end
	return holder
end

-- Dégradé vertical clair -> foncé d'une couleur (fonds de cartes "premium")
function UIUtil.SoftGradient(parent: Instance, color: Color3, rotation: number?): UIGradient
	return UIUtil.Gradient(parent, ColorSequence.new({
		ColorSequenceKeypoint.new(0, color:Lerp(Color3.new(1, 1, 1), 0.55)),
		ColorSequenceKeypoint.new(1, color:Lerp(Color3.new(1, 1, 1), 0.08)),
	}), rotation or 90)
end

-- Avatar (tête) d'un joueur sans requête bloquante (URL rbxthumb://)
function UIUtil.HeadshotUrl(userId: number, size: number?): string
	return string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=%d&h=%d", math.floor(userId), size or 48, size or 48)
end

return UIUtil
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="61">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="62">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	Config (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > Config

	TOUTE la configuration du jeu est ici : améliorations (et ce qu'elles
	débloquent à l'écran), succès, quêtes, événements, bourse, casino,
	coffres, objets cosmétiques, sons... Modifie les valeurs librement.

	Principe du jeu (style "Stimulation Clicker") : l'écran commence tout
	simple (un bouton, un compteur). Chaque amélioration achetée ajoute
	quelque chose à l'écran (logo DVD, fil d'actu, coureur, presse...),
	jusqu'à la surcharge totale. Puis on peut "Aller à l'océan" (rebirth).

	Ce module est lu par le serveur ET par le client. Le serveur reste la
	seule source de vérité : modifier ce fichier côté client ne change rien.

	Langue : tous les textes affichés (Name, Description, Text...) sont en
	ANGLAIS ici. Leur traduction française est dans Shared > Lang > FR_Config
	(clé = texte anglais exact). Si tu changes un texte ici, change aussi sa
	clé dans FR_Config. Le client les affiche avec Locale.T(upgrade.Name).
]]

local Config = {}

----------------------------------------------------------------------
-- Réglages généraux
----------------------------------------------------------------------
Config.Game = {
	CurrencyName = "Dopamine",
	MaxClicksPerSecond = 20, -- anti-triche : au-delà, les clics sont ignorés
	PassiveTickRate = 0.25, -- intervalle (s) entre deux ajouts de gains passifs
	SyncRate = 0.2, -- intervalle (s) entre deux envois de l'état au client
	MaxDopamine = 1e300, -- plafond de sécurité (évite l'infini)
}

----------------------------------------------------------------------
-- Combo (débloqué par l'amélioration "Combo") : cliquer vite remplit une
-- jauge 0-100 qui multiplie les clics.
----------------------------------------------------------------------
Config.Combo = {
	GainPerClick = 5, -- points de jauge gagnés par clic
	DecayPerSecond = 15, -- points perdus par seconde (il faut > 3 clics/s pour monter)
	MaxMultiplier = 3, -- multiplicateur quand la jauge est pleine
}

----------------------------------------------------------------------
-- Barre d'améliorations (sous le compteur)
----------------------------------------------------------------------
Config.UpgradeBar = {
	RevealAhead = 5, -- nombre d'améliorations PAS ENCORE achetées visibles en avance
}

----------------------------------------------------------------------
-- Améliorations
--
--   Id          : identifiant unique (ne pas changer après publication)
--   Name, Icon  : nom et emoji affichés sur la carte
--   Description : texte de l'infobulle ; "%s" est remplacé par Value formatée
--   Cost        : prix du niveau 1 ; CostGrowth : prix x CostGrowth à chaque niveau
--   MaxLevel    : niveau maximum (1 = achat unique ; nil = infini)
--   Effect      : "Click"            +Value Dopamine par clic (par niveau)
--                 "PerSecond"        +Value Dopamine par seconde (par niveau)
--                 "DVD"              +1 logo DVD rebondissant (par niveau)
--                 "BounceMultiplier" gain par rebond x Value (par niveau)
--                 "ClickMultiplier"  gain par clic x Value (par niveau)
--                 "Multiplier"       TOUS les gains x Value (par niveau)
--                 "Feature"          aucun effet économique, débloque juste Feature
--                 "Detox"            "Aller à l'océan" = rebirth (prix : Config.Rebirth)
--                 "Offline"          améliore la Dopamine hors-ligne (voir Config.Offline)
--   Feature     : ce que l'amélioration fait apparaître à l'écran / débloque
--                 (nom d'un module client dans Client > Stimuli, ou d'un menu)
--   Permanent   : true = conservée après "Aller à l'océan" (menus utiles)
--   Color       : couleur de la carte en mode "Icônes HD"
--
-- Équilibrage (simulé : 5 clics/s, ~50 % des bonus attrapés, on achète
-- toujours l'amélioration abordable la moins chère) : une nouveauté à
-- l'écran toutes les 1 à 3 min, jamais plus de ~3 min sans achat, 1re
-- visite à l'océan après ~70 min ; la 2e partie est ~2x plus rapide.
----------------------------------------------------------------------

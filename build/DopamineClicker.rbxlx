<roblox version="4">
  <Item class="ReplicatedStorage" referent="0">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="1">
      <Properties>
        <string name="Name">Client</string>
      </Properties>
      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">ClientState</string>
          <string name="Source"><![CDATA[--[[
	ClientState (ModuleScript)
	Emplacement : ReplicatedStorage > Client > ClientState

	Mémorise le dernier état envoyé par le serveur et prévient l'interface
	(signaux). Gère aussi la "prédiction" des clics : on affiche le gain
	tout de suite, sans attendre le serveur, pour une sensation instantanée.
	Le serveur reste l'autorité : dès que sa réponse arrive, l'affichage se
	recale sur la vraie valeur.

	Garde aussi en mémoire : les "Features" débloquées, la bourse, les
	trajectoires des logos DVD, le mode sombre (néon), et relaie les
	événements "Spawn" et "Notify" aux modules qui les écoutent.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Net = require(ReplicatedStorage.Shared.Net)
local Signal = require(ReplicatedStorage.Shared.Signal)

local ClientState = {}

ClientState.Data = nil :: any -- dernier état serveur (nil tant que pas chargé)
ClientState.Changed = Signal.new() -- (data)
ClientState.Rush = { Active = false, EndsAt = 0, Name = "", Multiplier = 1 }
ClientState.RushChanged = Signal.new() -- (rush)
ClientState.Leaderboard = {}
ClientState.LeaderboardChanged = Signal.new() -- (top)

-- Ajouts v2
ClientState.FeaturesChanged = Signal.new() -- (features) : l'ensemble des Features a changé
ClientState.SpawnReceived = Signal.new() -- (info) : chaque événement "Spawn"
ClientState.Stock = { Symbol = Config.Stocks.Symbol, Price = Config.Stocks.StartPrice, History = {} }
ClientState.StockChanged = Signal.new() -- (stock)
ClientState.DVDSetup = { Logos = {} }
ClientState.DVDSetupChanged = Signal.new() -- (setup)
ClientState.DarkMode = false
ClientState.DarkModeChanged = Signal.new() -- (enabled)
ClientState.NotifyReceived = Signal.new() -- (payload) : chaque "Notify" (après le traitement intégré)

-- Prédiction des clics
local clickSeq = 0
local pending = {} -- { { Seq = number, Amount = number } }
local lastUpdateClock = os.clock()
local displayDopamine = 0

-- Combo local (même formule que le serveur, juste pour l'affichage)
local comboMeter = 0
local lastComboClick = 0
local lastLocalClick = 0

-- Features connues (pour détecter les changements)
local knownFeatures: { [string]: boolean }? = nil

-- Traitement "intégré" des Notify (branché par ClientMain)
local notifyHandler: ((payload: any) -> ())? = nil

local function sameSet(a: { [string]: boolean }, b: { [string]: boolean }): boolean
	for key, value in pairs(a) do
		if value and not b[key] then
			return false
		end
	end
	for key, value in pairs(b) do
		if value and not a[key] then
			return false
		end
	end
	return true
end

local function onState(data)
	if type(data) ~= "table" then
		return
	end
	-- Valeurs par défaut (au cas où le serveur n'envoie pas encore un champ)
	data.Features = data.Features or {}
	data.Upgrades = data.Upgrades or {}
	data.Settings = data.Settings or { Sound = true, Music = true, Effects = true }
	data.Stats = data.Stats or {}
	data.Achievements = data.Achievements or {}
	data.Quests = data.Quests or {}
	data.ClickSeq = data.ClickSeq or 0

	ClientState.Data = data
	lastUpdateClock = os.clock()
	-- On oublie les prédictions que le serveur a déjà traitées
	while pending[1] and pending[1].Seq <= data.ClickSeq do
		table.remove(pending, 1)
	end
	if not data.ComboEnabled then
		comboMeter = 0
	end

	local features = data.Features
	local changed = knownFeatures == nil or not sameSet(knownFeatures :: { [string]: boolean }, features)
	knownFeatures = table.clone(features)

	ClientState.Changed:Fire(data)
	if changed then
		ClientState.FeaturesChanged:Fire(features)
	end
end

function ClientState.Init()
	Net.Event("StateUpdate").OnClientEvent:Connect(onState)

	Net.Event("EventUpdate").OnClientEvent:Connect(function(rush)
		ClientState.Rush = rush
		ClientState.RushChanged:Fire(rush)
	end)

	Net.Event("LeaderboardUpdate").OnClientEvent:Connect(function(top)
		ClientState.Leaderboard = top or {}
		ClientState.LeaderboardChanged:Fire(ClientState.Leaderboard)
	end)

	Net.Event("StockUpdate").OnClientEvent:Connect(function(stock)
		if type(stock) ~= "table" then
			return
		end
		stock.History = stock.History or {}
		ClientState.Stock = stock
		ClientState.StockChanged:Fire(stock)
	end)

	Net.Event("DVDSetup").OnClientEvent:Connect(function(setup)
		if type(setup) ~= "table" then
			return
		end
		setup.Logos = setup.Logos or {}
		ClientState.DVDSetup = setup
		ClientState.DVDSetupChanged:Fire(setup)
	end)

	Net.Event("Spawn").OnClientEvent:Connect(function(info)
		if type(info) == "table" then
			ClientState.SpawnReceived:Fire(info)
		end
	end)

	Net.Event("Notify").OnClientEvent:Connect(function(payload)
		if type(payload) ~= "table" then
			return
		end
		local handler = notifyHandler
		if handler then
			local ok, err = pcall(handler, payload)
			if not ok then
				warn("[ClientState] Erreur dans le traitement d'une notification :", err)
			end
		end
		ClientState.NotifyReceived:Fire(payload)
	end)
end

-- Branche le traitement "intégré" des notifications (toasts, stimuli...)
function ClientState.SetNotifyHandler(handler: (payload: any) -> ())
	notifyHandler = handler
end

-- Vrai si la Feature est débloquée (faux avant le premier état)
function ClientState.HasFeature(name: string): boolean
	local data = ClientState.Data
	return data ~= nil and data.Features ~= nil and data.Features[name] == true
end

-- Niveau d'une amélioration (0 avant le premier état)
function ClientState.GetLevel(upgradeId: string): number
	local data = ClientState.Data
	if not data or not data.Upgrades then
		return 0
	end
	return data.Upgrades[upgradeId] or 0
end

-- Mode sombre (activé par le mode néon)
function ClientState.SetDarkMode(enabled: boolean)
	enabled = enabled == true
	if ClientState.DarkMode == enabled then
		return
	end
	ClientState.DarkMode = enabled
	ClientState.DarkModeChanged:Fire(enabled)
end

-- Jauge de combo actuelle (avec la perte depuis le dernier clic)
function ClientState.GetComboMeter(): number
	local data = ClientState.Data
	if not data or not data.ComboEnabled then
		return 0
	end
	local elapsed = os.clock() - lastComboClick
	return math.max(0, comboMeter - Config.Combo.DecayPerSecond * elapsed)
end

function ClientState.GetComboMultiplier(): number
	return Formulas.GetComboMultiplier(ClientState.GetComboMeter())
end

-- Appelé à chaque clic sur le gros bouton. Renvoie le gain prédit (ou nil si
-- le clic est trop rapide, comme le serveur le refuserait).
function ClientState.Click(): number?
	local data = ClientState.Data
	if not data then
		return nil
	end
	local now = os.clock()
	-- Même limite que le serveur : inutile d'envoyer des clics qui seront refusés
	if now - lastLocalClick < 1 / Config.Game.MaxClicksPerSecond then
		return nil
	end
	lastLocalClick = now

	local gain = data.ClickValue or 0
	if data.ComboEnabled then
		comboMeter = Formulas.StepCombo(comboMeter, now - lastComboClick)
		lastComboClick = now
		gain *= Formulas.GetComboMultiplier(comboMeter)
	else
		comboMeter = 0
	end

	clickSeq += 1
	table.insert(pending, { Seq = clickSeq, Amount = gain })
	Net.Event("Click"):FireServer()
	return gain
end

-- Valeur "cible" : état serveur + clics prédits + gains passifs depuis la dernière mise à jour
function ClientState.GetTargetDopamine(): number
	local data = ClientState.Data
	if not data then
		return 0
	end
	local total = data.Dopamine or 0
	for _, prediction in ipairs(pending) do
		total += prediction.Amount
	end
	local elapsed = math.min(os.clock() - lastUpdateClock, 0.5)
	return total + (data.PerSecond or 0) * elapsed
end

-- Valeur affichée, lissée à chaque image (appelé UNE fois par image par la colonne centrale)
function ClientState.UpdateDisplay(dt: number): number
	local target = ClientState.GetTargetDopamine()
	if target < displayDopamine then
		displayDopamine = target -- achat : on descend immédiatement
	else
		displayDopamine += (target - displayDopamine) * (1 - math.exp(-14 * dt))
		if target - displayDopamine < 0.01 then
			displayDopamine = target
		end
	end
	return displayDopamine
end

function ClientState.GetDisplayDopamine(): number
	return displayDopamine
end

return ClientState
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="3">
        <Properties>
          <string name="Name">Components</string>
        </Properties>
        <Item class="ModuleScript" referent="4">
          <Properties>
            <string name="Name">Background</string>
            <string name="Source"><![CDATA[--[[
	Background (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > Background

	Fond "basique" : dégradé vertical blanc -> gris clair, comme au tout
	début d'un jeu qui ne paie pas de mine.
	- Mode sombre (néon) : le fond passe au noir (le stimulus NeonMode
	  dessine son propre fond animé par-dessus, dans le calque Background).
	- Dopamine Rush : une lueur jaune pulse doucement en bas de l'écran.
]]

local RunService = game:GetService("RunService")

local Client = script.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local ClientState = require(Client.ClientState)

local Background = {}

local frame: Frame? = nil
local glow: Frame? = nil
local rushActive = false

local LIGHT = ColorSequence.new(Theme.Colors.Background, Theme.Colors.BackgroundBottom)

local function applyDarkMode(dark: boolean)
	local target = frame
	if not target then
		return
	end
	-- Le fond clair s'estompe au profit d'un fond presque noir
	UIUtil.Tween(target, 0.6, {
		BackgroundColor3 = dark and Theme.DarkColors.Background or Color3.new(1, 1, 1),
	})
	local gradient = target:FindFirstChild("Gradient") :: UIGradient?
	if gradient then
		gradient.Enabled = not dark
	end
end

-- `parent` = calque Background de l'Interface (ou la ScreenGui en secours)
function Background.Build(parent: Instance)
	local bg = UIUtil.Create("Frame", {
		Name = "LightBackground",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1), -- blanc : le dégradé donne les couleurs
		BorderSizePixel = 0,
		ZIndex = 0, -- sous les fonds des stimuli (ZIndex >= 1)
		Parent = parent,
	})
	local gradient = UIUtil.Gradient(bg, LIGHT, 90)
	gradient.Name = "Gradient"
	frame = bg

	-- Lueur du Rush (invisible par défaut)
	local rushGlow = UIUtil.Create("Frame", {
		Name = "RushGlow",
		Size = UDim2.new(1, 0, 0.45, 0),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.Colors.Yellow,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 1,
		Parent = bg,
	})
	UIUtil.Create("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(1, 0.3),
		}),
		Parent = rushGlow,
	})
	glow = rushGlow

	RunService.Heartbeat:Connect(function()
		local g = glow
		if not g then
			return
		end
		if rushActive then
			g.BackgroundTransparency = 0.55 + math.sin(os.clock() * 3) * 0.2
		elseif g.BackgroundTransparency < 1 then
			g.BackgroundTransparency = math.min(1, g.BackgroundTransparency + 0.02)
		end
	end)

	ClientState.DarkModeChanged:Connect(applyDarkMode)
	applyDarkMode(ClientState.DarkMode)
	return bg
end

function Background.SetRush(active: boolean)
	rushActive = active
end

return Background
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">CenterColumn</string>
            <string name="Source"><![CDATA[--[[
	CenterColumn (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > CenterColumn

	La colonne centrale, volontairement toute simple (comme au début d'un
	certain "clicker de stimulation") :
	  - le chapeau équipé (emoji) posé sur le bouton ;
	  - le bouton gris "Clique-moi" (couleurs selon le cosmétique "Skin") ;
	  - "12 345 Dopamine" puis "123 Dopamine par seconde" ;
	  - la bannière du Dopamine Rush (quand il est actif) ;
	  - les pastilles des menus (Temps d'écran, Boutique, Succès, Quêtes,
	    Classement, Cadeau, ⚙️) avec badges rouges ;
	  - la jauge de combo (si la Feature "Combo" est débloquée) ;
	  - la barre d'améliorations (UpgradeBar).
	Occupe x ∈ [centre-330, centre+330], y ∈ [28, ~430] de la toile.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Client = script.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local Interface = require(Client.Interface)
local ClientState = require(Client.ClientState)
local Effects = require(Client.Effects)
local SoundManager = require(Client.SoundManager)
local PanelManager = require(script.Parent.PanelManager)
local UpgradeBar = require(script.Parent.UpgradeBar)
local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)

local CenterColumn = {}

-- Pastilles des menus (Feature = nil : toujours visible)
local PILLS = {
	{ Id = "ScreenTime", Text = "⏱️ Temps d'écran", Color = Theme.Colors.Dark, Feature = "ScreenTime", Panel = "ScreenTime" },
	{ Id = "ItemShop", Text = "🛒 Boutique", Color = Theme.Colors.Green, Feature = "ItemShop", Panel = "ItemShop" },
	{ Id = "Achievements", Text = "🏆 Succès", Color = Theme.Colors.Purple, Feature = "Achievements", Panel = "Achievements" },
	{ Id = "Quests", Text = "📜 Quêtes", Color = Theme.Colors.Orange, Feature = "Quests", Panel = "Quests" },
	{ Id = "Leaderboard", Text = "🥇 Classement", Color = Theme.Colors.Blue, Feature = "Leaderboard", Panel = "Leaderboard" },
	{ Id = "Daily", Text = "🎁 Cadeau", Color = Theme.Colors.Pink, Feature = "Daily", Panel = "Daily" },
	{ Id = "Settings", Text = "⚙️", Color = Theme.Colors.ButtonBottom, Feature = nil, Panel = "Settings", Round = true },
}

local BUTTON_SIZE = Vector2.new(184, 62)
local PILL_HEIGHT = 36

local random = Random.new()
local effectsLayer: Frame

local buttonHolder: Frame
local clickButton: TextButton
local clickLabel: TextLabel
local buttonGradient: UIGradient
local hatLabel: TextLabel
local counterLabel: TextLabel
local counterScale: UIScale
local perSecondLabel: TextLabel
local rushBanner: Frame
local rushLabel: TextLabel
local comboBar: Frame
local comboFill: Frame
local comboLabel: TextLabel
local pills = {} -- [Id] = { Button, Holder, Badge, Def }

local seenAchievements: number? = nil -- succès déjà vus (badge "Succès")
local currentSkin = ""
local currentHat = ""

----------------------------------------------------------------------
-- Utilitaires
----------------------------------------------------------------------

-- "12 345" sous le million, "1.23M" au-delà, "2.5" pour les petites décimales
local function formatAmount(value: number): string
	if value >= 1e6 then
		return NumberFormatter.Format(value)
	elseif value < 10 and value % 1 ~= 0 then
		return NumberFormatter.Format(value)
	end
	return NumberFormatter.WithSpaces(value)
end

local function countTrue(map): number
	local count = 0
	if type(map) == "table" then
		for _, value in pairs(map) do
			if value then
				count += 1
			end
		end
	end
	return count
end

----------------------------------------------------------------------
-- Cosmétiques (chapeau + couleur du bouton)
----------------------------------------------------------------------

local function applySkin(skinId: string)
	if skinId == currentSkin then
		return
	end
	currentSkin = skinId
	local skin = Config.CosmeticsById[skinId]
	if skin and skin.Top and skin.Bottom then
		buttonGradient.Color = ColorSequence.new(skin.Top, skin.Bottom)
		clickLabel.TextColor3 = Theme.ContrastText(skin.Top:Lerp(skin.Bottom, 0.5))
	else
		buttonGradient.Color = ColorSequence.new(Theme.Colors.Button, Theme.Colors.ButtonBottom)
		clickLabel.TextColor3 = Theme.Colors.Text
	end
end

local function applyHat(hatId: string)
	if hatId == currentHat then
		return
	end
	currentHat = hatId
	local hat = Config.CosmeticsById[hatId]
	if hat then
		hatLabel.Text = hat.Icon
		hatLabel.Visible = true
		local scale = hatLabel:FindFirstChildOfClass("UIScale")
		if scale then
			scale.Scale = 0.2
			UIUtil.Tween(scale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
		end
	else
		hatLabel.Visible = false
	end
end

----------------------------------------------------------------------
-- Clic sur le gros bouton
----------------------------------------------------------------------

local function onClick()
	local gain = ClientState.Click()
	if not gain then
		return
	end
	UpgradeBar.HideTooltip()

	-- Squish : on écrase le bouton puis il rebondit
	clickButton.Size = UDim2.fromScale(1.08, 0.84)
	UIUtil.Tween(clickButton, 0.4, { Size = UDim2.fromScale(1, 1) }, Enum.EasingStyle.Elastic)

	-- Le chapeau saute un peu
	if hatLabel.Visible then
		hatLabel.Position = UDim2.new(0.5, 0, 0, 6)
		UIUtil.Tween(hatLabel, 0.35, { Position = UDim2.new(0.5, 0, 0, 18) }, Enum.EasingStyle.Bounce)
	end

	-- "+X" qui s'envole près du bouton (couleur selon le combo)
	local ratio = ClientState.GetComboMeter() / 100
	local color = ClientState.DarkMode and Theme.Colors.TextLight or Theme.Colors.Text
	if ratio > 0.75 then
		color = Theme.Colors.Red
	elseif ratio > 0.35 then
		color = Theme.Colors.Orange
	end
	local center = Interface.GetCanvasCenter(clickButton)
	local position = UDim2.fromOffset(center.X + random:NextNumber(-80, 80), center.Y - 30 + random:NextNumber(-14, 8))
	Effects.FloatingText(effectsLayer, position, "+" .. formatAmount(gain), color, 28 + ratio * 12)
	Effects.Burst(effectsLayer, UDim2.fromOffset(center.X + random:NextNumber(-40, 40), center.Y), nil, 4)

	-- Le son monte dans les aigus avec le combo
	SoundManager.Play("Click", 0.95 + ratio * 0.6 + random:NextNumber(0, 0.08))

	counterScale.Scale = 1.08
	UIUtil.Tween(counterScale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)
end

----------------------------------------------------------------------
-- Construction
----------------------------------------------------------------------

local function buildButton(column: Frame)
	buttonHolder = UIUtil.Create("Frame", {
		Name = "ClickerHolder",
		Size = UDim2.fromOffset(BUTTON_SIZE.X, BUTTON_SIZE.Y),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 40),
		BackgroundTransparency = 1,
		Parent = column,
	})

	clickButton = UIUtil.Create("TextButton", {
		Name = "ClickButton",
		Size = UDim2.fromScale(1, 1),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1), -- couleurs données par le dégradé
		AutoButtonColor = false,
		Text = "",
		ZIndex = 2,
		Parent = buttonHolder,
	})
	UIUtil.Corner(clickButton, 12)
	UIUtil.Stroke(clickButton, Theme.Colors.Border, 1.5)
	buttonGradient = UIUtil.Gradient(clickButton, ColorSequence.new(Theme.Colors.Button, Theme.Colors.ButtonBottom), 90)

	clickLabel = UIUtil.Label({
		Text = "Clique-moi",
		Font = Theme.Fonts.Body,
		Size = UDim2.new(1, -20, 1, -16),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		ZIndex = 3,
		MaxTextSize = 28,
		Parent = clickButton,
	})

	-- Chapeau posé sur le bouton
	hatLabel = UIUtil.Label({
		Name = "Hat",
		Text = "",
		Size = UDim2.fromOffset(60, 60),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0, 18),
		Rotation = -8,
		ZIndex = 4,
		MaxTextSize = 56,
		Visible = false,
		Parent = buttonHolder,
	})
	UIUtil.Create("UIScale", { Parent = hatLabel })

	-- Souris ET tactile (multi-touch compris)
	clickButton.InputBegan:Connect(function(input: InputObject)
		local inputType = input.UserInputType
		if inputType == Enum.UserInputType.MouseButton1 or inputType == Enum.UserInputType.Touch then
			onClick()
		end
	end)
	-- Survol : léger grossissement
	local hoverScale = UIUtil.Create("UIScale", { Parent = buttonHolder })
	clickButton.MouseEnter:Connect(function()
		UIUtil.Tween(hoverScale, 0.15, { Scale = 1.04 }, Enum.EasingStyle.Back)
	end)
	clickButton.MouseLeave:Connect(function()
		UIUtil.Tween(hoverScale, 0.15, { Scale = 1 })
	end)
end

local function buildPills(parent: Frame, order: number)
	local row = UIUtil.Create("Frame", {
		Name = "Pills",
		Size = UDim2.fromOffset(640, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Wraps = true,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = row,
	})

	for index, def in ipairs(PILLS) do
		-- Support (6 px de marge verticale entre deux lignes de pastilles)
		local holder = UIUtil.Create("Frame", {
			Name = def.Id,
			Size = UDim2.fromOffset(def.Round and PILL_HEIGHT or 0, PILL_HEIGHT + 6),
			AutomaticSize = def.Round and Enum.AutomaticSize.None or Enum.AutomaticSize.X,
			BackgroundTransparency = 1,
			LayoutOrder = index,
			Visible = def.Feature == nil,
			Parent = row,
		})
		local button = UIUtil.PillButton({
			Name = "Button",
			Text = def.Text,
			Color = def.Color,
			TextColor3 = def.Round and Theme.Colors.Text or Theme.Colors.TextLight,
			Height = PILL_HEIGHT,
			TextSize = def.Round and 20 or 17,
			Round = def.Round,
			Position = UDim2.fromOffset(0, 3),
			Parent = holder,
		})
		if not def.Round then
			-- Contour du texte pour rester lisible sur les couleurs claires
			local stroke = UIUtil.Create("UIStroke", {
				Color = Theme.Colors.TextDark,
				Thickness = 1,
				Transparency = 0.55,
				ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
				Parent = button,
			})
			stroke.Name = "TextStroke"
		end
		local badge = UIUtil.Badge(button, 22)
		badge.Position = UDim2.new(1, -2, 0, 2)
		UIUtil.Create("UIScale", { Name = "PopScale", Parent = holder })

		button.Activated:Connect(function()
			PanelManager.Toggle(def.Panel)
		end)
		pills[def.Id] = { Button = button, Holder = holder, Badge = badge, Def = def }
	end
	return row
end

local function buildRush(parent: Frame, order: number)
	rushBanner = UIUtil.Create("Frame", {
		Name = "RushBanner",
		Size = UDim2.fromOffset(330, 28),
		BackgroundColor3 = Theme.Colors.Yellow,
		LayoutOrder = order,
		Visible = false,
		Parent = parent,
	})
	UIUtil.Corner(rushBanner, UDim.new(1, 0))
	UIUtil.Stroke(rushBanner, Theme.Colors.Border, 1.5)
	rushLabel = UIUtil.Label({
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.TextDark,
		Size = UDim2.new(1, -16, 1, -6),
		Position = UDim2.fromOffset(8, 3),
		MaxTextSize = 18,
		Parent = rushBanner,
	})
end

local function buildCombo(parent: Frame, order: number)
	comboBar = UIUtil.Create("Frame", {
		Name = "ComboBar",
		Size = UDim2.fromOffset(300, 20),
		BackgroundColor3 = Theme.Colors.PanelLight,
		LayoutOrder = order,
		ClipsDescendants = true,
		Visible = false,
		Parent = parent,
	})
	UIUtil.Corner(comboBar, UDim.new(1, 0))
	UIUtil.Stroke(comboBar, Theme.Colors.Border, 1.5)
	comboFill = UIUtil.Create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = comboBar,
	})
	UIUtil.Corner(comboFill, UDim.new(1, 0))
	UIUtil.Gradient(comboFill, ColorSequence.new({
		ColorSequenceKeypoint.new(0, Theme.Colors.Yellow),
		ColorSequenceKeypoint.new(0.5, Theme.Colors.Orange),
		ColorSequenceKeypoint.new(1, Theme.Colors.Red),
	}), 0)
	comboLabel = UIUtil.Label({
		Text = "COMBO x1",
		Font = Theme.Fonts.Title,
		Size = UDim2.new(1, -10, 1, -4),
		Position = UDim2.fromOffset(5, 2),
		ZIndex = 2,
		MaxTextSize = 14,
		Parent = comboBar,
	})
end

----------------------------------------------------------------------
-- Mises à jour
----------------------------------------------------------------------

local function applyDarkMode(dark: boolean)
	local textColor = dark and Theme.DarkColors.Text or Theme.Colors.Text
	local dimColor = dark and Theme.DarkColors.TextDim or Theme.Colors.TextDim
	counterLabel.TextColor3 = textColor
	perSecondLabel.TextColor3 = dimColor
	local counterStroke = counterLabel:FindFirstChild("DarkStroke") :: UIStroke?
	if counterStroke then
		counterStroke.Enabled = dark
	end
	local perSecondStroke = perSecondLabel:FindFirstChild("DarkStroke") :: UIStroke?
	if perSecondStroke then
		perSecondStroke.Enabled = dark
	end
end

local function refreshPills()
	for _, pill in pairs(pills) do
		local feature = pill.Def.Feature
		local shouldShow = feature == nil or ClientState.HasFeature(feature)
		if shouldShow and not pill.Holder.Visible then
			pill.Holder.Visible = true
			local scale = pill.Holder:FindFirstChild("PopScale") :: UIScale?
			if scale then
				scale.Scale = 0.2
				UIUtil.Tween(scale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
			end
		elseif not shouldShow and pill.Holder.Visible then
			pill.Holder.Visible = false
			if PanelManager.IsOpen(pill.Def.Panel) then
				PanelManager.Close()
			end
		end
	end
end

local function refreshBadges()
	local data = ClientState.Data
	if not data then
		return
	end

	-- Boutique : objets pas encore possédés qu'on peut se payer
	local shop = pills.ItemShop
	if shop then
		local owned = (data.Cosmetics and data.Cosmetics.Owned) or {}
		local dopamine = ClientState.GetTargetDopamine()
		local affordable = 0
		for _, cosmetic in ipairs(Config.Cosmetics) do
			if not owned[cosmetic.Id] and dopamine >= cosmetic.Cost then
				affordable += 1
			end
		end
		UIUtil.SetBadge(shop.Badge, affordable)
	end

	-- Succès : débloqués depuis la dernière ouverture du menu
	local achievements = pills.Achievements
	if achievements then
		local count = countTrue(data.Achievements)
		if seenAchievements == nil or PanelManager.IsOpen("Achievements") then
			seenAchievements = count
		end
		UIUtil.SetBadge(achievements.Badge, math.max(0, count - (seenAchievements or count)))
	end

	-- Cadeau : disponible ?
	local daily = pills.Daily
	if daily then
		UIUtil.SetBadge(daily.Badge, (data.Daily and data.Daily.Available) and "!" or "")
	end
end

local function onState(data)
	perSecondLabel.Text = formatAmount(data.PerSecond or 0) .. " Dopamine par seconde"
	comboBar.Visible = data.ComboEnabled == true
	local equipped = data.Cosmetics and data.Cosmetics.Equipped
	applySkin((equipped and equipped.Skin) or "")
	applyHat((equipped and equipped.Hat) or "")
	refreshBadges()
end

----------------------------------------------------------------------
-- API
----------------------------------------------------------------------

-- `parent` = calque Main ; `floatingLayer` = calque au-dessus des stimuli
-- (infobulle) ; `fxLayer` = calque des effets
function CenterColumn.Build(parent: Frame, floatingLayer: Frame, fxLayer: Frame)
	effectsLayer = fxLayer

	local column = UIUtil.Create("Frame", {
		Name = "CenterColumn",
		Size = UDim2.fromOffset(700, 410),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 24),
		BackgroundTransparency = 1,
		Parent = parent,
	})

	buildButton(column)

	-- Pile verticale sous le bouton (les éléments cachés ne prennent pas de place)
	local stack = UIUtil.Create("Frame", {
		Name = "Stack",
		Size = UDim2.new(1, 0, 1, -(40 + BUTTON_SIZE.Y + 4)),
		Position = UDim2.fromOffset(0, 40 + BUTTON_SIZE.Y + 4),
		BackgroundTransparency = 1,
		Parent = column,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 4),
		Parent = stack,
	})

	counterLabel = UIUtil.Label({
		Name = "Counter",
		Text = "0 Dopamine",
		Font = Theme.Fonts.Number,
		Size = UDim2.fromOffset(320, 44),
		LayoutOrder = 1,
		MaxTextSize = 40,
		Parent = stack,
	})
	counterScale = UIUtil.Create("UIScale", { Parent = counterLabel })
	local counterStroke = UIUtil.Stroke(counterLabel, Theme.Colors.TextDark, 2, 0.3)
	counterStroke.Name = "DarkStroke"
	counterStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	counterStroke.Enabled = false

	perSecondLabel = UIUtil.Label({
		Name = "PerSecond",
		Text = "0 Dopamine par seconde",
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.fromOffset(320, 22),
		LayoutOrder = 2,
		MaxTextSize = 21,
		Parent = stack,
	})
	local perSecondStroke = UIUtil.Stroke(perSecondLabel, Theme.Colors.TextDark, 1.5, 0.4)
	perSecondStroke.Name = "DarkStroke"
	perSecondStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	perSecondStroke.Enabled = false

	buildRush(stack, 3)
	UIUtil.Create("Frame", { Name = "Spacer", Size = UDim2.fromOffset(1, 2), BackgroundTransparency = 1, LayoutOrder = 4, Parent = stack })
	buildPills(stack, 5)
	buildCombo(stack, 6)
	local upgradeBar = UpgradeBar.Build(stack, floatingLayer)
	upgradeBar.LayoutOrder = 7

	-- Signaux
	ClientState.Changed:Connect(onState)
	ClientState.FeaturesChanged:Connect(refreshPills)
	ClientState.DarkModeChanged:Connect(applyDarkMode)
	applyDarkMode(ClientState.DarkMode)
	PanelManager.Opened:Connect(function(name: string)
		if name == "Achievements" and ClientState.Data then
			seenAchievements = countTrue(ClientState.Data.Achievements)
			local pill = pills.Achievements
			if pill then
				UIUtil.SetBadge(pill.Badge, 0)
			end
		end
	end)

	-- Compteur lissé, jauge de combo, Rush : à chaque image
	local badgeClock = 0
	RunService.RenderStepped:Connect(function(dt: number)
		counterLabel.Text = formatAmount(ClientState.UpdateDisplay(dt)) .. " Dopamine"

		if comboBar.Visible then
			local meter = ClientState.GetComboMeter()
			comboFill.Size = UDim2.fromScale(meter / 100, 1)
			comboLabel.Text = "COMBO " .. NumberFormatter.Multiplier(Formulas.GetComboMultiplier(meter))
			comboBar.Rotation = meter >= 99.5 and math.sin(os.clock() * 30) * 1.5 or 0
		end

		local rush = ClientState.Rush
		local remaining = (rush.EndsAt or 0) - workspace:GetServerTimeNow()
		local active = rush.Active == true and remaining > 0
		if rushBanner.Visible ~= active then
			rushBanner.Visible = active
		end
		if active then
			rushLabel.Text = string.format("⚡ %s x%s — %ds", tostring(rush.Name or "RUSH"), tostring(rush.Multiplier or 2), math.ceil(remaining))
			rushBanner.Rotation = math.sin(os.clock() * 8) * 1.5
		end

		-- Badges (4 fois par seconde : la Dopamine monte en continu)
		badgeClock += dt
		if badgeClock >= 0.25 then
			badgeClock = 0
			refreshBadges()
		end
	end)

	-- Petit rappel tant que le joueur n'a jamais cliqué
	task.spawn(function()
		while buttonHolder.Parent do
			local data = ClientState.Data
			if data and data.Stats and (data.Stats.TotalClicks or 0) == 0 then
				UIUtil.Tween(buttonHolder, 0.25, { Rotation = 5 }, Enum.EasingStyle.Sine)
				task.wait(0.25)
				UIUtil.Tween(buttonHolder, 0.25, { Rotation = -5 }, Enum.EasingStyle.Sine)
				task.wait(0.25)
				UIUtil.Tween(buttonHolder, 0.25, { Rotation = 0 }, Enum.EasingStyle.Sine)
			end
			task.wait(2)
		end
	end)

	if ClientState.Data then
		onState(ClientState.Data)
		refreshPills()
	end
	return column
end

return CenterColumn
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">Notifications</string>
            <string name="Source"><![CDATA[--[[
	Notifications (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > Notifications

	Petits bandeaux ("toasts") blancs en bas de l'écran, avec une barre de
	couleur à gauche, + réaction aux notifications du serveur
	(Info, Error, Achievement, Quest, Rush, Jackpot, Unlock, Detox).
	Les notifications "Bonus" sont envoyées aux stimuli par StimulusManager.
]]

local Client = script.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local Effects = require(Client.Effects)
local SoundManager = require(Client.SoundManager)
local ClientState = require(Client.ClientState)

local Notifications = {}

local container: Frame? = nil
local MAX_TOASTS = 4
local order = 0

function Notifications.Build(parent: Frame)
	local frame = UIUtil.Create("Frame", {
		Name = "Toasts",
		Size = UDim2.fromOffset(460, 300),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	UIUtil.Create("UIListLayout", {
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6),
		Parent = frame,
	})
	container = frame
end

-- Affiche un bandeau temporaire
function Notifications.Toast(text: string, color: Color3?, duration: number?, title: string?)
	local target = container
	if not target or not text or text == "" then
		return
	end

	-- Supprime les plus anciens s'il y en a trop
	local existing = {}
	for _, child in ipairs(target:GetChildren()) do
		if child:IsA("Frame") then
			table.insert(existing, child)
		end
	end
	table.sort(existing, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	while #existing >= MAX_TOASTS do
		local oldest = table.remove(existing, 1)
		if oldest then
			oldest:Destroy()
		end
	end

	order += 1
	local accent = color or Theme.Colors.Blue
	local height = title and 62 or 44
	local toast = UIUtil.Create("Frame", {
		Name = "Toast",
		Size = UDim2.fromOffset(440, height),
		BackgroundColor3 = Theme.Colors.Card,
		LayoutOrder = order,
		ClipsDescendants = true,
		Parent = target,
	})
	UIUtil.Corner(toast, 12)
	UIUtil.Stroke(toast, Theme.Colors.CardBorder, 1.5, 0.15)

	-- Barre de couleur à gauche
	UIUtil.Create("Frame", {
		Name = "Accent",
		Size = UDim2.new(0, 8, 1, 0),
		BackgroundColor3 = accent,
		BorderSizePixel = 0,
		Parent = toast,
	})

	if title then
		UIUtil.Label({
			Text = title,
			Font = Theme.Fonts.Title,
			TextColor3 = Theme.Colors.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, -34, 0, 22),
			Position = UDim2.fromOffset(20, 6),
			MaxTextSize = 18,
			Parent = toast,
		})
	end
	UIUtil.Label({
		Text = text,
		TextColor3 = title and Theme.Colors.TextDim or Theme.Colors.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -34, 0, 26),
		Position = UDim2.fromOffset(20, title and 30 or 9),
		MaxTextSize = 18,
		Parent = toast,
	})

	-- Apparition avec rebond
	local scale = UIUtil.Create("UIScale", { Scale = 0.3, Parent = toast })
	UIUtil.Tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)

	task.delay(duration or 3.5, function()
		if toast.Parent then
			UIUtil.Tween(scale, 0.25, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			task.wait(0.3)
			toast:Destroy()
		end
	end)
end

-- Petite explosion au centre (vers le bouton) pour les déblocages
local function centerBurst(color: Color3?)
	local layer = Effects.GetLayer()
	if layer then
		Effects.Burst(layer, UDim2.new(0.5, 0, 0, 140), color, 16)
	end
end

-- Réagit à une notification envoyée par le serveur (sauf "Bonus")
function Notifications.Handle(payload)
	local kind = payload.Type
	local text = payload.Text

	if kind == "Achievement" then
		-- Les succès ne se montrent qu'une fois le menu "Succès" débloqué
		if not ClientState.HasFeature("Achievements") then
			return
		end
		SoundManager.Play("Achievement", 1.1)
		Effects.Confetti(40)
		Notifications.Toast(text or "", Theme.Colors.Purple, 4.5, payload.Title or "🏆 SUCCÈS DÉBLOQUÉ !")
	elseif kind == "Quest" then
		SoundManager.Play("Bonus", 1.2)
		Effects.Flash(Theme.Colors.Orange, 0.15)
		Notifications.Toast(text or "", Theme.Colors.Orange, 4, payload.Title or "📜 QUÊTE TERMINÉE !")
	elseif kind == "Jackpot" then
		SoundManager.Play("Jackpot", 0.8)
		task.delay(0.15, SoundManager.Play, "Jackpot", 1.2)
		task.delay(0.3, SoundManager.Play, "Jackpot", 1.6)
		Effects.Flash(Color3.new(1, 1, 1), 0.9)
		Effects.Confetti(150)
		Effects.BigMessage("JACKPOT !!!\nCOIN PARFAIT", Theme.Colors.Yellow, 3.5)
		Notifications.Toast(text or "", Theme.Colors.Gold, 6, "📀 LE LOGO A TOUCHÉ LE COIN !")
	elseif kind == "Rush" then
		SoundManager.Play("Rush", 1)
		Effects.Flash(Theme.Colors.Yellow, 0.4)
		Effects.BigMessage("⚡ DOPAMINE RUSH ⚡", Theme.Colors.Yellow, 2)
		Notifications.Toast(text or "", Theme.Colors.Yellow, 5)
	elseif kind == "Unlock" then
		SoundManager.Play("Achievement", 1.3)
		centerBurst(nil)
		Notifications.Toast(text or "✨ Nouveau !", Theme.Colors.Green, 4)
	elseif kind == "Detox" then
		-- La cinématique de l'océan (et son son) est jouée par StimulusManager ; le message arrive après
		local multiplier = tonumber(payload.Multiplier) or 1
		task.delay(6.5, function()
			Notifications.Toast(
				string.format("Tes gains sont maintenant multipliés par %s pour toujours.", tostring(math.floor(multiplier * 100 + 0.5) / 100)),
				Theme.Colors.Cyan,
				6,
				"🌊 Bienvenue de retour (visite n°" .. tostring(payload.Rebirths or 1) .. ")"
			)
		end)
	elseif kind == "Error" then
		SoundManager.Play("Error", 0.7)
		Notifications.Toast(text or "Erreur", Theme.Colors.Red, 5)
	elseif kind == "Bonus" then
		-- Géré par StimulusManager (texte flottant sur le stimulus concerné)
		return
	else
		Notifications.Toast(text or "", Theme.Colors.Blue)
	end
end

return Notifications
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">PanelManager</string>
            <string name="Source"><![CDATA[--[[
	PanelManager (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > PanelManager

	Fenêtres "pop-up" (boutique, succès, quêtes, classement...). Une seule
	ouverte à la fois, avec animation d'ouverture et fond assombri (clic
	dehors = fermer). Style clair : fenêtre blanche, contour noir fin.
	Chaque panneau est un module dans Components > Panels avec :
	  Title, Color, Build(content), Update(data) (optionnel),
	  OnOpen() (optionnel), Size (Vector2, optionnel : taille de la fenêtre)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local ClientState = require(Client.ClientState)
local SoundManager = require(Client.SoundManager)
local Signal = require(ReplicatedStorage.Shared.Signal)

local PanelManager = {}

PanelManager.Opened = Signal.new() -- (name)
PanelManager.Closed = Signal.new() -- (name)

local DEFAULT_SIZE = Vector2.new(640, 500)

local overlay: Frame
local window: Frame
local windowScale: UIScale
local titleLabel: TextLabel
local titleBar: Frame
local panels = {} -- [nom] = { Module, Content }
local openName: string? = nil

local function callOnClose(name: string)
	local panel = panels[name]
	if panel and panel.Module.OnClose then
		pcall(panel.Module.OnClose)
	end
end

function PanelManager.Build(layer: Frame)
	overlay = UIUtil.Create("Frame", {
		Name = "PanelOverlay",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 10,
		Parent = layer,
	})

	-- Fond sombre plein écran (bouton : un clic dehors ferme la fenêtre)
	local dimmer = UIUtil.Create("TextButton", {
		Name = "Dimmer",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.5,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 1,
		Parent = overlay,
	})
	dimmer.Activated:Connect(function()
		PanelManager.Close()
	end)

	window = UIUtil.Create("Frame", {
		Name = "Window",
		Size = UDim2.fromOffset(DEFAULT_SIZE.X, DEFAULT_SIZE.Y),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundColor3 = Theme.Colors.Panel,
		Active = true, -- bloque les clics pour qu'ils n'atteignent pas le fond sombre
		ZIndex = 2,
		Parent = overlay,
	})
	UIUtil.Corner(window, 20)
	UIUtil.Stroke(window, Theme.Colors.CardBorder, 2)
	windowScale = UIUtil.Create("UIScale", { Parent = window })

	-- Bandeau de titre (petite barre de couleur à gauche du titre)
	titleBar = UIUtil.Create("Frame", {
		Name = "TitleAccent",
		Size = UDim2.fromOffset(8, 30),
		Position = UDim2.fromOffset(22, 21),
		BackgroundColor3 = Theme.Colors.Blue,
		BorderSizePixel = 0,
		Parent = window,
	})
	UIUtil.Corner(titleBar, 4)

	titleLabel = UIUtil.Label({
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.Text,
		Size = UDim2.new(1, -130, 0, 36),
		Position = UDim2.fromOffset(40, 18),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 28,
		Parent = window,
	})

	local closeButton = UIUtil.BasicButton({
		Name = "Close",
		Text = "✕",
		Font = Theme.Fonts.Title,
		TextSize = 22,
		Size = UDim2.fromOffset(44, 44),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 14),
		CornerRadius = 22,
		Parent = window,
	})
	closeButton.Activated:Connect(function()
		PanelManager.Close()
	end)

	-- Séparateur
	UIUtil.Create("Frame", {
		Size = UDim2.new(1, -40, 0, 1),
		Position = UDim2.fromOffset(20, 64),
		BackgroundColor3 = Theme.Colors.Disabled,
		BorderSizePixel = 0,
		Parent = window,
	})

	ClientState.Changed:Connect(function(data)
		for name, panel in pairs(panels) do
			if panel.Module.Update then
				local ok, err = pcall(panel.Module.Update, data)
				if not ok then
					warn("[PanelManager] Erreur dans " .. name .. ".Update : " .. tostring(err))
				end
			end
		end
	end)
end

function PanelManager.Register(name: string, module)
	local content = UIUtil.Create("Frame", {
		Name = name,
		Size = UDim2.new(1, -40, 1, -88),
		Position = UDim2.fromOffset(20, 74),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = window,
	})
	local ok, err = pcall(module.Build, content)
	if not ok then
		warn("[PanelManager] Erreur dans " .. name .. ".Build : " .. tostring(err))
	end
	panels[name] = { Module = module, Content = content }
end

function PanelManager.IsOpen(name: string?): boolean
	if name then
		return openName == name
	end
	return openName ~= nil
end

function PanelManager.Open(name: string)
	local panel = panels[name]
	if not panel then
		return
	end
	local previous = openName
	for otherName, other in pairs(panels) do
		other.Content.Visible = otherName == name
	end
	openName = name
	titleLabel.Text = panel.Module.Title or name
	titleBar.BackgroundColor3 = panel.Module.Color or Theme.Colors.Blue
	local size = panel.Module.Size or DEFAULT_SIZE
	window.Size = UDim2.fromOffset(size.X, size.Y)

	if panel.Module.Update and ClientState.Data then
		pcall(panel.Module.Update, ClientState.Data)
	end
	if panel.Module.OnOpen then
		pcall(panel.Module.OnOpen)
	end

	overlay.Visible = true
	windowScale.Scale = 0.6
	UIUtil.Tween(windowScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	SoundManager.Play("Open", 1)
	if previous and previous ~= name then
		callOnClose(previous)
		PanelManager.Closed:Fire(previous)
	end
	PanelManager.Opened:Fire(name)
end

function PanelManager.Close()
	local name = openName
	if not name then
		return
	end
	openName = nil
	callOnClose(name)
	UIUtil.Tween(windowScale, 0.15, { Scale = 0.7 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(0.15, function()
		if not openName then
			overlay.Visible = false
		end
	end)
	PanelManager.Closed:Fire(name)
end

function PanelManager.Toggle(name: string)
	if openName == name then
		PanelManager.Close()
	else
		PanelManager.Open(name)
	end
end

return PanelManager
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="8">
          <Properties>
            <string name="Name">Panels</string>
          </Properties>
          <Item class="ModuleScript" referent="9">
            <Properties>
              <string name="Name">Achievements</string>
              <string name="Source"><![CDATA[--[[
	Achievements (ModuleScript) — panneau des succès
	Emplacement : ReplicatedStorage > Client > Components > Panels > Achievements

	Grille de tous les succès (débloqués en couleur, les autres grisés avec
	leur progression). Chaque succès donne un bonus permanent.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local Config = require(ReplicatedStorage.Shared.Config)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)

local Achievements = {
	Title = "🏆 Succès",
	Color = Theme.Colors.Purple,
}

local header: TextLabel
local items = {}

local function statValue(data, statName: string): number
	local value = data.Stats and data.Stats[statName]
	if value == nil then
		value = data[statName]
	end
	return (type(value) == "number") and value or 0
end

function Achievements.Build(content: Frame)
	header = UIUtil.Label({
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, 0, 0, 24),
		MaxTextSize = 17,
		Parent = content,
	})

	local list = UIUtil.Create("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -32),
		Position = UDim2.fromOffset(0, 32),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Colors.Purple,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = content,
	})
	UIUtil.Create("UIPadding", {
		PaddingTop = UDim.new(0, 2),
		PaddingLeft = UDim.new(0, 2),
		PaddingRight = UDim.new(0, 10),
		PaddingBottom = UDim.new(0, 4),
		Parent = list,
	})
	UIUtil.Create("UIGridLayout", {
		CellSize = UDim2.new(0.5, -6, 0, 72),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = list,
	})

	for index, achievement in ipairs(Config.Achievements) do
		local card = UIUtil.Create("Frame", {
			BackgroundColor3 = Theme.Colors.PanelLight,
			LayoutOrder = index,
			Parent = list,
		})
		UIUtil.Corner(card, 12)
		local stroke = UIUtil.Stroke(card, Theme.Colors.Disabled, 1.5)

		local icon = UIUtil.Label({
			Text = achievement.Icon,
			Size = UDim2.fromOffset(48, 48),
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 8, 0.5, 0),
			MaxTextSize = 34,
			Parent = card,
		})
		local name = UIUtil.Label({
			Text = achievement.Name,
			Font = Theme.Fonts.Title,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, -70, 0, 22),
			Position = UDim2.fromOffset(62, 7),
			MaxTextSize = 17,
			Parent = card,
		})
		local progress = UIUtil.Label({
			TextColor3 = Theme.Colors.TextDim,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, -70, 0, 18),
			Position = UDim2.fromOffset(62, 29),
			MaxTextSize = 14,
			Parent = card,
		})
		UIUtil.Label({
			Text = "🎁 +" .. NumberFormatter.Format(achievement.Reward),
			TextColor3 = Theme.Colors.TextDim,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, -70, 0, 16),
			Position = UDim2.fromOffset(62, 49),
			MaxTextSize = 13,
			Parent = card,
		})

		items[achievement.Id] = { Card = card, Stroke = stroke, Icon = icon, Name = name, Progress = progress, Achievement = achievement }
	end
end

function Achievements.Update(data)
	local unlocked = 0
	for id, ui in pairs(items) do
		local achievement = ui.Achievement
		local done = data.Achievements and data.Achievements[id] == true
		if done then
			unlocked += 1
			ui.Card.BackgroundColor3 = Color3.fromRGB(245, 235, 255)
			ui.Stroke.Color = Theme.Colors.Purple
			ui.Stroke.Thickness = 2
			ui.Icon.TextTransparency = 0
			ui.Name.TextColor3 = Theme.Colors.Purple
			ui.Progress.Text = "✔ Débloqué"
		else
			ui.Card.BackgroundColor3 = Theme.Colors.PanelLight
			ui.Stroke.Color = Theme.Colors.Disabled
			ui.Stroke.Thickness = 1.5
			ui.Icon.TextTransparency = 0.6
			ui.Name.TextColor3 = Theme.Colors.TextDim
			local value = math.min(statValue(data, achievement.Stat), achievement.Goal)
			ui.Progress.Text = NumberFormatter.Format(value) .. " / " .. NumberFormatter.Format(achievement.Goal)
		end
	end
	header.Text = string.format(
		"%d / %d débloqués  •  bonus permanent +%d %%",
		unlocked,
		#Config.Achievements,
		math.floor(unlocked * Config.AchievementBonus * 100 + 0.5)
	)
end

return Achievements
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="10">
            <Properties>
              <string name="Name">Daily</string>
              <string name="Source"><![CDATA[--[[
	Daily (ModuleScript) — cadeau du jour
	Emplacement : ReplicatedStorage > Client > Components > Panels > Daily

	Débloqué par l'amélioration "Calendrier" (Feature "Daily").
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local ClientState = require(Client.ClientState)
local Effects = require(Client.Effects)
local SoundManager = require(Client.SoundManager)
local Notifications = require(script.Parent.Parent.Notifications)
local Config = require(ReplicatedStorage.Shared.Config)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Net = require(ReplicatedStorage.Shared.Net)

local Daily = {
	Title = "🎁 Cadeau du jour",
	Color = Theme.Colors.Pink,
}

local days = {}
local rewardLabel: TextLabel
local timerLabel: TextLabel
local button: TextButton
local lastInfoClock = 0
local claiming = false

function Daily.Build(content: Frame)
	UIUtil.Label({
		Text = "Reviens chaque jour pour augmenter ta série et tes récompenses !",
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, 0, 0, 30),
		MaxTextSize = 17,
		Parent = content,
	})

	-- Les jours de la série
	local row = UIUtil.Create("Frame", {
		Size = UDim2.new(1, 0, 0, 90),
		Position = UDim2.fromOffset(0, 44),
		BackgroundTransparency = 1,
		Parent = content,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 8),
		Parent = row,
	})
	for day = 1, Config.Daily.MaxStreakBonus do
		local box = UIUtil.Create("Frame", {
			Size = UDim2.fromOffset(72, 90),
			BackgroundColor3 = Theme.Colors.PanelLight,
			LayoutOrder = day,
			Parent = row,
		})
		UIUtil.Corner(box, 14)
		local stroke = UIUtil.Stroke(box, Theme.Colors.Disabled, 1.5)
		UIUtil.Label({
			Text = "Jour " .. day,
			Font = Theme.Fonts.Title,
			Size = UDim2.new(1, 0, 0, 22),
			Position = UDim2.fromOffset(0, 6),
			MaxTextSize = 15,
			Parent = box,
		})
		UIUtil.Label({
			Text = day == Config.Daily.MaxStreakBonus and "💎" or "🎁",
			Size = UDim2.new(1, 0, 0, 44),
			Position = UDim2.fromOffset(0, 34),
			MaxTextSize = 36,
			Parent = box,
		})
		days[day] = { Box = box, Stroke = stroke }
	end

	rewardLabel = UIUtil.Label({
		Font = Theme.Fonts.Number,
		Size = UDim2.new(1, 0, 0, 44),
		Position = UDim2.fromOffset(0, 150),
		MaxTextSize = 34,
		Parent = content,
	})
	timerLabel = UIUtil.Label({
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, 0, 0, 24),
		Position = UDim2.fromOffset(0, 198),
		MaxTextSize = 17,
		Parent = content,
	})

	button = UIUtil.NeonButton({
		Text = "RÉCUPÉRER",
		Size = UDim2.fromOffset(300, 64),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 240),
		Color = Theme.Colors.Pink,
		TextColor3 = Theme.Colors.TextLight,
		CornerRadius = 32,
		MaxTextSize = 26,
		Parent = content,
	})
	button.Activated:Connect(function()
		if claiming then
			return
		end
		if not button:GetAttribute("Enabled") then
			SoundManager.Play("Error", 0.7)
			UIUtil.Shake(button)
			return
		end
		claiming = true
		local ok, success, message = pcall(function()
			return Net.Function("ClaimDaily"):InvokeServer()
		end)
		claiming = false
		if ok and success then
			SoundManager.Play("Achievement", 1)
			Effects.Confetti(80)
			Effects.Flash(Theme.Colors.Pink, 0.3)
			Notifications.Toast(tostring(message or ""), Theme.Colors.Pink, 5, "🎁 Cadeau récupéré !")
		else
			SoundManager.Play("Error", 0.7)
			Notifications.Toast(ok and tostring(message or "Impossible pour le moment.") or "Erreur réseau, réessaie.", Theme.Colors.Red)
		end
	end)

	-- Compte à rebours
	task.spawn(function()
		while content.Parent do
			local data = ClientState.Data
			local info = data and data.Daily
			if info and not info.Available and info.NextIn then
				local remaining = info.NextIn - (os.clock() - lastInfoClock)
				timerLabel.Text = "Prochain cadeau dans " .. NumberFormatter.Time(remaining)
			end
			task.wait(1)
		end
	end)
end

function Daily.Update(data)
	local info = data.Daily
	if not info then
		return
	end
	lastInfoClock = os.clock()
	local streak = math.min(info.Streak or 0, Config.Daily.MaxStreakBonus)
	for day, ui in pairs(days) do
		local reached = day <= streak
		ui.Stroke.Color = reached and Theme.Colors.Pink or Theme.Colors.Disabled
		ui.Stroke.Thickness = reached and 2 or 1.5
		ui.Box.BackgroundColor3 = (day == streak and info.Available) and Color3.fromRGB(255, 225, 238) or Theme.Colors.PanelLight
	end

	if info.Available then
		rewardLabel.Text = "Jour " .. tostring(info.Streak or 1) .. " : +" .. NumberFormatter.Format(info.Reward or 0) .. " 💧"
		timerLabel.Text = "Ton cadeau t'attend !"
		button.Text = "RÉCUPÉRER"
		UIUtil.SetButtonEnabled(button, true)
	else
		rewardLabel.Text = "Série actuelle : " .. tostring(info.Streak or 0) .. " jour(s) 🔥"
		button.Text = "DÉJÀ RÉCUPÉRÉ"
		UIUtil.SetButtonEnabled(button, false)
	end
end

return Daily
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="11">
            <Properties>
              <string name="Name">ItemShop</string>
              <string name="Source"><![CDATA[--[[
	ItemShop (ModuleScript) — boutique d'objets cosmétiques
	Emplacement : ReplicatedStorage > Client > Components > Panels > ItemShop

	Chapeaux (posés sur le bouton "Clique-moi") et couleurs du bouton.
	Achat / équipement / retrait via la RemoteFunction "ItemShop".
	Chaque objet possédé donne un petit bonus permanent (Config.CosmeticBonus).
	Débloqué par l'amélioration "Boutique d'objets" (Feature "ItemShop").
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local ClientState = require(Client.ClientState)
local Effects = require(Client.Effects)
local SoundManager = require(Client.SoundManager)
local Notifications = require(script.Parent.Parent.Notifications)
local Config = require(ReplicatedStorage.Shared.Config)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Net = require(ReplicatedStorage.Shared.Net)

local ItemShop = {
	Title = "🛒 Boutique",
	Color = Theme.Colors.Green,
	Size = Vector2.new(720, 520),
}

local SLOT_NAMES = { Hat = "Chapeau", Skin = "Couleur du bouton" }

local header: TextLabel
local cards = {} -- [id] = { Card, Stroke, Button, Status, Cosmetic }
local busy = false

local function getCosmetics(data)
	local cosmetics = data and data.Cosmetics
	local owned = (cosmetics and cosmetics.Owned) or {}
	local equipped = (cosmetics and cosmetics.Equipped) or {}
	return owned, equipped
end

-- Envoie une action au serveur ("buy" | "equip" | "unequip")
local function request(action: string, cosmetic)
	if busy then
		return
	end
	busy = true
	local ok, success, message = pcall(function()
		return Net.Function("ItemShop"):InvokeServer(action, cosmetic.Id)
	end)
	busy = false

	local ui = cards[cosmetic.Id]
	if ok and success then
		if action == "buy" then
			SoundManager.Play("Buy", 1.1)
			Effects.Confetti(40)
			Notifications.Toast(
				cosmetic.Icon .. " " .. cosmetic.Name .. " : à toi ! (+" .. math.floor(Config.CosmeticBonus * 100 + 0.5) .. " % de gains)",
				Theme.Colors.Green,
				4
			)
		else
			SoundManager.Play("Open", action == "equip" and 1.2 or 0.9)
		end
		if ui then
			local scale = ui.Card:FindFirstChild("PopScale") :: UIScale?
			if scale then
				scale.Scale = 1.08
				UIUtil.Tween(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
			end
		end
	else
		SoundManager.Play("Error", 0.7)
		if ui then
			UIUtil.Shake(ui.Button)
		end
		local text = ok and tostring(message or "Impossible pour le moment.") or "Erreur réseau, réessaie."
		Notifications.Toast(text, Theme.Colors.Red)
	end
end

local function buildCard(list: ScrollingFrame, cosmetic)
	local card = UIUtil.Create("Frame", {
		Name = cosmetic.Id,
		BackgroundColor3 = Theme.Colors.Card,
		LayoutOrder = cosmetic.Order or 0,
		Parent = list,
	})
	UIUtil.Corner(card, 14)
	local stroke = UIUtil.Stroke(card, Theme.Colors.CardBorder, 1.5)
	UIUtil.Create("UIScale", { Name = "PopScale", Parent = card })

	-- Aperçu : emoji du chapeau, ou pastille aux couleurs du bouton
	local preview = UIUtil.Create("Frame", {
		Size = UDim2.fromOffset(64, 56),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		BackgroundTransparency = 1,
		Parent = card,
	})
	if cosmetic.Slot == "Skin" and cosmetic.Top and cosmetic.Bottom then
		local swatch = UIUtil.Create("Frame", {
			Size = UDim2.fromOffset(70, 34),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.55),
			BackgroundColor3 = Color3.new(1, 1, 1),
			Parent = preview,
		})
		UIUtil.Corner(swatch, 8)
		UIUtil.Stroke(swatch, Theme.Colors.Border, 1.5)
		UIUtil.Gradient(swatch, ColorSequence.new(cosmetic.Top, cosmetic.Bottom), 90)
		UIUtil.Label({
			Text = "Clique-moi",
			TextColor3 = Theme.ContrastText(cosmetic.Bottom),
			Size = UDim2.new(1, -6, 1, -6),
			Position = UDim2.fromOffset(3, 3),
			MaxTextSize = 13,
			Parent = swatch,
		})
	else
		UIUtil.Label({
			Text = cosmetic.Icon,
			Size = UDim2.fromScale(1, 1),
			MaxTextSize = 44,
			Parent = preview,
		})
	end

	UIUtil.Label({
		Text = cosmetic.Name,
		Font = Theme.Fonts.Title,
		Size = UDim2.new(1, -12, 0, 20),
		Position = UDim2.fromOffset(6, 66),
		MaxTextSize = 16,
		Parent = card,
	})
	local status = UIUtil.Label({
		Text = SLOT_NAMES[cosmetic.Slot] or "",
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, -12, 0, 16),
		Position = UDim2.fromOffset(6, 86),
		MaxTextSize = 13,
		Parent = card,
	})

	local button = UIUtil.NeonButton({
		Text = "",
		Size = UDim2.new(1, -20, 0, 34),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -8),
		Color = Theme.Colors.Green,
		CornerRadius = 17,
		MaxTextSize = 17,
		Parent = card,
	})
	button.Activated:Connect(function()
		local data = ClientState.Data
		if not data then
			return
		end
		local owned, equipped = getCosmetics(data)
		if not owned[cosmetic.Id] then
			if not button:GetAttribute("Enabled") then
				SoundManager.Play("Error", 0.7)
				UIUtil.Shake(button)
				return
			end
			task.spawn(request, "buy", cosmetic)
		elseif equipped[cosmetic.Slot] == cosmetic.Id then
			task.spawn(request, "unequip", cosmetic)
		else
			task.spawn(request, "equip", cosmetic)
		end
	end)

	cards[cosmetic.Id] = { Card = card, Stroke = stroke, Button = button, Status = status, Cosmetic = cosmetic }
end

function ItemShop.Build(content: Frame)
	header = UIUtil.Label({
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, 0, 0, 24),
		MaxTextSize = 16,
		Parent = content,
	})

	local list = UIUtil.Create("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -32),
		Position = UDim2.fromOffset(0, 32),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Colors.Green,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = content,
	})
	UIUtil.Create("UIPadding", {
		PaddingTop = UDim.new(0, 4),
		PaddingLeft = UDim.new(0, 4),
		PaddingRight = UDim.new(0, 12),
		PaddingBottom = UDim.new(0, 6),
		Parent = list,
	})
	UIUtil.Create("UIGridLayout", {
		CellSize = UDim2.new(0.25, -9, 0, 156),
		CellPadding = UDim2.fromOffset(9, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = list,
	})

	for _, cosmetic in ipairs(Config.Cosmetics) do
		buildCard(list, cosmetic)
	end
end

function ItemShop.Update(data)
	local owned, equipped = getCosmetics(data)
	local dopamine = data.Dopamine or 0
	local ownedCount = 0

	for id, ui in pairs(cards) do
		local cosmetic = ui.Cosmetic
		local isOwned = owned[id] == true
		local isEquipped = isOwned and equipped[cosmetic.Slot] == id
		if isOwned then
			ownedCount += 1
		end

		if isEquipped then
			ui.Button.Text = "Retirer"
			ui.Button:SetAttribute("BaseColor", Theme.Colors.ButtonBottom)
			UIUtil.SetButtonEnabled(ui.Button, true)
			ui.Button.TextColor3 = Theme.Colors.Text
			ui.Status.Text = "✔ Équipé"
			ui.Status.TextColor3 = Theme.Colors.Green
			ui.Stroke.Color = Theme.Colors.Green
			ui.Stroke.Thickness = 3
		elseif isOwned then
			ui.Button.Text = "Équiper"
			ui.Button:SetAttribute("BaseColor", Theme.Colors.Blue)
			UIUtil.SetButtonEnabled(ui.Button, true)
			ui.Button.TextColor3 = Theme.Colors.TextLight
			ui.Status.Text = "Possédé"
			ui.Status.TextColor3 = Theme.Colors.TextDim
			ui.Stroke.Color = Theme.Colors.CardBorder
			ui.Stroke.Thickness = 1.5
		else
			local affordable = dopamine >= cosmetic.Cost
			ui.Button.Text = "💧 " .. NumberFormatter.Format(cosmetic.Cost)
			ui.Button:SetAttribute("BaseColor", Theme.Colors.Green)
			UIUtil.SetButtonEnabled(ui.Button, affordable)
			ui.Button.TextColor3 = Theme.Colors.TextDark
			ui.Status.Text = SLOT_NAMES[cosmetic.Slot] or ""
			ui.Status.TextColor3 = affordable and Theme.Colors.TextDim or Theme.Colors.Red
			ui.Stroke.Color = Theme.Colors.CardBorder
			ui.Stroke.Thickness = 1.5
		end
	end

	header.Text = string.format(
		"%d / %d objets  •  +%d %% par objet (bonus actuel +%d %%)",
		ownedCount,
		#Config.Cosmetics,
		math.floor(Config.CosmeticBonus * 100 + 0.5),
		math.floor(ownedCount * Config.CosmeticBonus * 100 + 0.5)
	)
end

return ItemShop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="12">
            <Properties>
              <string name="Name">Leaderboard</string>
              <string name="Source"><![CDATA[--[[
	Leaderboard (ModuleScript) — classement global
	Emplacement : ReplicatedStorage > Client > Components > Panels > Leaderboard
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local ClientState = require(Client.ClientState)
local Config = require(ReplicatedStorage.Shared.Config)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)

local Leaderboard = {
	Title = "🥇 Classement mondial",
	Color = Theme.Colors.Blue,
}

local MEDALS = { "🥇", "🥈", "🥉" }
local rows = {}
local emptyLabel: TextLabel

local function refresh(top)
	top = top or {}
	local localId = Players.LocalPlayer.UserId
	for index, row in ipairs(rows) do
		local entry = top[index]
		row.Frame.Visible = entry ~= nil
		if entry then
			local rank = entry.Rank or index
			row.Rank.Text = MEDALS[rank] or ("#" .. tostring(rank))
			row.Name.Text = tostring(entry.Name or "?")
			row.Value.Text = NumberFormatter.Format(entry.Value or 0) .. " 💧"
			local isMe = entry.UserId == localId
			row.Frame.BackgroundColor3 = isMe and Color3.fromRGB(225, 240, 255) or Theme.Colors.PanelLight
			row.Stroke.Color = isMe and Theme.Colors.Blue or Theme.Colors.Disabled
			row.Name.TextColor3 = isMe and Theme.Colors.Blue or Theme.Colors.Text
		end
	end
	emptyLabel.Visible = #top == 0
end

function Leaderboard.Build(content: Frame)
	UIUtil.Label({
		Text = "Dopamine totale gagnée depuis toujours (mis à jour chaque minute)",
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, 0, 0, 24),
		MaxTextSize = 16,
		Parent = content,
	})

	local list = UIUtil.Create("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -32),
		Position = UDim2.fromOffset(0, 32),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Colors.Blue,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = content,
	})
	UIUtil.Create("UIPadding", {
		PaddingTop = UDim.new(0, 2),
		PaddingLeft = UDim.new(0, 2),
		Parent = list,
	})
	UIUtil.Create("UIListLayout", {
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = list,
	})

	for index = 1, Config.Leaderboard.Size do
		local frame = UIUtil.Create("Frame", {
			Size = UDim2.new(1, -12, 0, 38),
			BackgroundColor3 = Theme.Colors.PanelLight,
			LayoutOrder = index,
			Visible = false,
			Parent = list,
		})
		UIUtil.Corner(frame, 10)
		local stroke = UIUtil.Stroke(frame, Theme.Colors.Disabled, 1.5)
		local rank = UIUtil.Label({
			Font = Theme.Fonts.Title,
			Size = UDim2.new(0, 60, 1, -6),
			Position = UDim2.fromOffset(6, 3),
			MaxTextSize = 20,
			Parent = frame,
		})
		local name = UIUtil.Label({
			Font = Theme.Fonts.Title,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(0.55, -70, 1, -8),
			Position = UDim2.fromOffset(70, 4),
			MaxTextSize = 18,
			Parent = frame,
		})
		local value = UIUtil.Label({
			Font = Theme.Fonts.Number,
			TextXAlignment = Enum.TextXAlignment.Right,
			Size = UDim2.new(0.45, -14, 1, -8),
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -10, 0, 4),
			MaxTextSize = 18,
			Parent = frame,
		})
		rows[index] = { Frame = frame, Stroke = stroke, Rank = rank, Name = name, Value = value }
	end

	emptyLabel = UIUtil.Label({
		Text = "Classement en cours de chargement...\n(Il ne fonctionne que dans un jeu publié avec l'accès aux API activé.)",
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, 0, 0, 60),
		Position = UDim2.fromOffset(0, 60),
		MaxTextSize = 17,
		Parent = content,
	})

	refresh(ClientState.Leaderboard)
	ClientState.LeaderboardChanged:Connect(refresh)
end

return Leaderboard
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="13">
            <Properties>
              <string name="Name">Quests</string>
              <string name="Source"><![CDATA[--[[
	Quests (ModuleScript) — panneau des quêtes
	Emplacement : ReplicatedStorage > Client > Components > Panels > Quests

	Les quêtes actives (une quête finie est remplacée tout de suite).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Config = require(ReplicatedStorage.Shared.Config)

local Quests = {
	Title = "📜 Quêtes",
	Color = Theme.Colors.Orange,
}

local cards = {}
local emptyLabel: TextLabel

function Quests.Build(content: Frame)
	UIUtil.Create("UIListLayout", {
		Padding = UDim.new(0, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = content,
	})

	UIUtil.Label({
		Text = "Termine des quêtes pour gagner des bonus ! Une nouvelle quête remplace chaque quête finie.",
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, 0, 0, 36),
		LayoutOrder = 0,
		MaxTextSize = 16,
		Parent = content,
	})

	for index = 1, Config.Quests.ActiveCount do
		local card = UIUtil.Create("Frame", {
			Size = UDim2.new(1, 0, 0, 100),
			BackgroundColor3 = Theme.Colors.Card,
			LayoutOrder = index,
			Parent = content,
		})
		UIUtil.Corner(card, 14)
		UIUtil.Stroke(card, Theme.Colors.CardBorder, 1.5)

		local text = UIUtil.Label({
			Font = Theme.Fonts.Title,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, -30, 0, 28),
			Position = UDim2.fromOffset(15, 10),
			MaxTextSize = 20,
			Parent = card,
		})
		local reward = UIUtil.Label({
			TextColor3 = Theme.Colors.TextDim,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, -30, 0, 20),
			Position = UDim2.fromOffset(15, 40),
			MaxTextSize = 16,
			Parent = card,
		})

		local bar = UIUtil.Create("Frame", {
			Size = UDim2.new(1, -30, 0, 22),
			Position = UDim2.fromOffset(15, 66),
			BackgroundColor3 = Theme.Colors.PanelLight,
			ClipsDescendants = true,
			Parent = card,
		})
		UIUtil.Corner(bar, 11)
		UIUtil.Stroke(bar, Theme.Colors.CardBorder, 1, 0.5)
		local fill = UIUtil.Create("Frame", {
			Size = UDim2.fromScale(0, 1),
			BackgroundColor3 = Color3.new(1, 1, 1),
			Parent = bar,
		})
		UIUtil.Corner(fill, 11)
		UIUtil.Gradient(fill, ColorSequence.new(Theme.Colors.Yellow, Theme.Colors.Orange), 0)
		local progress = UIUtil.Label({
			Font = Theme.Fonts.Title,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 2,
			MaxTextSize = 15,
			Parent = bar,
		})

		cards[index] = { Card = card, Text = text, Reward = reward, Fill = fill, Progress = progress }
	end

	emptyLabel = UIUtil.Label({
		Text = "Aucune quête pour l'instant...",
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, 0, 0, 30),
		LayoutOrder = 99,
		Visible = false,
		MaxTextSize = 18,
		Parent = content,
	})
end

function Quests.Update(data)
	local quests = data.Quests or {}
	for index, ui in ipairs(cards) do
		local quest = quests[index]
		ui.Card.Visible = quest ~= nil
		if quest then
			ui.Text.Text = quest.Text or ""
			ui.Reward.Text = "🎁 Récompense : +" .. NumberFormatter.Format(quest.Reward or 0) .. " Dopamine"
			local goal = math.max(1, quest.Goal or 1)
			local ratio = math.clamp((quest.Progress or 0) / goal, 0, 1)
			UIUtil.Tween(ui.Fill, 0.25, { Size = UDim2.fromScale(ratio, 1) })
			ui.Progress.Text = NumberFormatter.Format(quest.Progress or 0) .. " / " .. NumberFormatter.Format(goal)
		end
	end
	emptyLabel.Visible = #quests == 0
end

return Quests
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="14">
            <Properties>
              <string name="Name">ScreenTime</string>
              <string name="Source"><![CDATA[--[[
	ScreenTime (ModuleScript) — "Temps d'écran"
	Emplacement : ReplicatedStorage > Client > Components > Panels > ScreenTime

	Combien de temps le joueur a passé ici : session, aujourd'hui, total,
	+ graphique des derniers jours et un petit commentaire (pas très tendre).
	Débloqué par l'amélioration "Temps d'écran" (Feature "ScreenTime").
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local ClientState = require(Client.ClientState)
local Config = require(ReplicatedStorage.Shared.Config)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)

local ScreenTime = {
	Title = "⏱️ Temps d'écran",
	Color = Theme.Colors.Dark,
	Size = Vector2.new(660, 520),
}

local DAY_NAMES = { "Dim", "Lun", "Mar", "Mer", "Jeu", "Ven", "Sam" } -- index = wday (1 = dimanche)
local MAX_EXTRAPOLATION = 30 -- secondes ajoutées localement entre deux mises à jour

-- Commentaires selon le temps passé aujourd'hui (secondes)
local COMMENTS = {
	{ Limit = 10 * 60, Text = "C'est raisonnable. 🙂", Color = Theme.Colors.Green },
	{ Limit = 30 * 60, Text = "Ça commence à faire beaucoup... 🤔", Color = Theme.Colors.Orange },
	{ Limit = 60 * 60, Text = "Il faudrait peut-être sortir... 🌳", Color = Theme.Colors.Orange },
	{ Limit = 3 * 3600, Text = "Tes yeux ne te remercient pas. 👀", Color = Theme.Colors.Red },
	{ Limit = math.huge, Text = "Tu as un problème. 🚨", Color = Theme.Colors.Red },
}

local valueLabels: { [string]: TextLabel } = {} -- Session / Today / Total
local commentLabel: TextLabel
local bars = {}
local base = { Session = 0, Today = 0, Total = 0 }
local lastUpdateClock = os.clock()
local visible = false

local function statBox(parent: Frame, order: number, title: string): TextLabel
	local box = UIUtil.Create("Frame", {
		Size = UDim2.new(1 / 3, -8, 1, 0),
		BackgroundColor3 = Theme.Colors.PanelLight,
		LayoutOrder = order,
		Parent = parent,
	})
	UIUtil.Corner(box, 12)
	UIUtil.Stroke(box, Theme.Colors.Disabled, 1.5)
	UIUtil.Label({
		Text = title,
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, -12, 0, 20),
		Position = UDim2.fromOffset(6, 8),
		MaxTextSize = 15,
		Parent = box,
	})
	return UIUtil.Label({
		Text = "0s",
		Font = Theme.Fonts.Number,
		Size = UDim2.new(1, -12, 0, 34),
		Position = UDim2.fromOffset(6, 30),
		MaxTextSize = 30,
		Parent = box,
	})
end

local function commentFor(today: number)
	for _, comment in ipairs(COMMENTS) do
		if today < comment.Limit then
			return comment
		end
	end
	return COMMENTS[#COMMENTS]
end

local function refreshTimes()
	local extra = math.min(os.clock() - lastUpdateClock, MAX_EXTRAPOLATION)
	valueLabels.Session.Text = NumberFormatter.Time(base.Session + extra)
	valueLabels.Today.Text = NumberFormatter.Time(base.Today + extra)
	valueLabels.Total.Text = NumberFormatter.Time(base.Total + extra)
	local comment = commentFor(base.Today + extra)
	commentLabel.Text = comment.Text
	commentLabel.TextColor3 = comment.Color
end

function ScreenTime.Build(content: Frame)
	local row = UIUtil.Create("Frame", {
		Size = UDim2.new(1, 0, 0, 72),
		BackgroundTransparency = 1,
		Parent = content,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = row,
	})
	valueLabels.Session = statBox(row, 1, "Cette session")
	valueLabels.Today = statBox(row, 2, "Aujourd'hui")
	valueLabels.Total = statBox(row, 3, "Depuis toujours")

	commentLabel = UIUtil.Label({
		Font = Theme.Fonts.Title,
		Size = UDim2.new(1, 0, 0, 30),
		Position = UDim2.fromOffset(0, 82),
		MaxTextSize = 24,
		Parent = content,
	})

	-- Graphique en barres des derniers jours
	local chart = UIUtil.Create("Frame", {
		Size = UDim2.new(1, 0, 0, 270),
		Position = UDim2.fromOffset(0, 122),
		BackgroundColor3 = Theme.Colors.PanelLight,
		Parent = content,
	})
	UIUtil.Corner(chart, 14)
	UIUtil.Stroke(chart, Theme.Colors.Disabled, 1.5)
	UIUtil.Label({
		Text = "Les " .. Config.ScreenTime.DaysKept .. " derniers jours",
		TextColor3 = Theme.Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -24, 0, 20),
		Position = UDim2.fromOffset(12, 8),
		MaxTextSize = 15,
		Parent = chart,
	})

	local plot = UIUtil.Create("Frame", {
		Size = UDim2.new(1, -24, 1, -40),
		Position = UDim2.fromOffset(12, 32),
		BackgroundTransparency = 1,
		Parent = chart,
	})
	UIUtil.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		Padding = UDim.new(0, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = plot,
	})

	local count = Config.ScreenTime.DaysKept
	for index = 1, count do
		local column = UIUtil.Create("Frame", {
			Size = UDim2.new(1 / count, -10, 1, 0),
			BackgroundTransparency = 1,
			LayoutOrder = index,
			Parent = plot,
		})
		local value = UIUtil.Label({
			Text = "",
			TextColor3 = Theme.Colors.TextDim,
			Size = UDim2.new(1, 0, 0, 16),
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 0, 1, -24),
			MaxTextSize = 12,
			Parent = column,
		})
		local bar = UIUtil.Create("Frame", {
			Size = UDim2.new(0.7, 0, 0, 2),
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -24),
			BackgroundColor3 = index == count and Theme.Colors.Red or Theme.Colors.Dark,
			Parent = column,
		})
		UIUtil.Corner(bar, 6)
		local day = UIUtil.Label({
			Text = "",
			Font = Theme.Fonts.Title,
			Size = UDim2.new(1, 0, 0, 20),
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			MaxTextSize = 14,
			Parent = column,
		})
		bars[index] = { Bar = bar, Value = value, Day = day }
	end

	-- Le temps défile pendant que la fenêtre est ouverte
	task.spawn(function()
		while content.Parent do
			if visible and content.Visible then
				refreshTimes()
			end
			task.wait(1)
		end
	end)
end

function ScreenTime.OnOpen()
	visible = true
end

function ScreenTime.Update(data)
	local info = data.ScreenTime
	if type(info) ~= "table" then
		return
	end
	base.Session = info.Session or 0
	base.Today = info.Today or 0
	base.Total = info.Total or 0
	lastUpdateClock = os.clock()
	refreshTimes()

	-- Barres (plus ancien -> aujourd'hui)
	local days = info.Days or {}
	local count = #bars
	local maxValue = 60
	for i = 1, count do
		local value = days[#days - count + i] or 0
		maxValue = math.max(maxValue, value)
	end
	local todayWday = (os.date("!*t") :: any).wday or 1
	for i, ui in ipairs(bars) do
		local value = days[#days - count + i] or 0
		if i == count then
			value = math.max(value, base.Today)
		end
		local ratio = math.clamp(value / maxValue, 0, 1)
		ui.Bar.Size = UDim2.new(0.7, 0, math.max(0.01, ratio * 0.78), 0)
		ui.Value.Position = UDim2.new(0, 0, 1 - math.max(0.01, ratio * 0.78), -26)
		ui.Value.Text = value > 0 and NumberFormatter.Time(value) or ""
		local offset = count - i -- jours avant aujourd'hui
		local wday = ((todayWday - 1 - offset) % 7) + 1
		ui.Day.Text = offset == 0 and "Auj." or DAY_NAMES[wday]
	end
end

-- Appelé par PanelManager quand la fenêtre se ferme (pour ne plus rafraîchir)
function ScreenTime.OnClose()
	visible = false
end

-- Accès direct (debug)
function ScreenTime.GetToday(): number
	local data = ClientState.Data
	local info = data and data.ScreenTime
	return (info and info.Today) or 0
end

return ScreenTime
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="15">
            <Properties>
              <string name="Name">Settings</string>
              <string name="Source"><![CDATA[--[[
	Settings (ModuleScript) — paramètres (son, musique, effets)
	Emplacement : ReplicatedStorage > Client > Components > Panels > Settings

	Les réglages sont sauvegardés côté serveur avec la progression.
	La musique ne joue que si le réglage est actif ET que "Lofi Beats" est
	débloqué (voir SoundManager.SetMusicAllowed).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local SoundManager = require(Client.SoundManager)
local Effects = require(Client.Effects)
local Net = require(ReplicatedStorage.Shared.Net)

local Settings = {
	Title = "⚙️ Paramètres",
	Color = Theme.Colors.Dark,
}

local OPTIONS = {
	{ Key = "Sound", Label = "🔊 Effets sonores" },
	{ Key = "Music", Label = "🎵 Musique (avec Lofi Beats)" },
	{ Key = "Effects", Label = "✨ Particules et confettis" },
}

local toggles = {} -- [clé] = { Button, Knob }
local current = { Sound = true, Music = true, Effects = true }

-- Applique un réglage localement (son / musique / effets)
function Settings.Apply(key: string, value: boolean)
	current[key] = value
	if key == "Sound" then
		SoundManager.SetSoundEnabled(value)
	elseif key == "Music" then
		SoundManager.SetMusicEnabled(value)
	elseif key == "Effects" then
		Effects.SetEnabled(value)
	end

	local ui = toggles[key]
	if ui then
		UIUtil.Tween(ui.Knob, 0.2, {
			Position = value and UDim2.new(1, -4, 0.5, 0) or UDim2.new(0, 4, 0.5, 0),
			AnchorPoint = value and Vector2.new(1, 0.5) or Vector2.new(0, 0.5),
		}, Enum.EasingStyle.Back)
		UIUtil.Tween(ui.Button, 0.2, { BackgroundColor3 = value and Theme.Colors.Green or Theme.Colors.Disabled })
	end
end

function Settings.Get(key: string): boolean
	return current[key] ~= false
end

function Settings.Build(content: Frame)
	UIUtil.Create("UIListLayout", {
		Padding = UDim.new(0, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = content,
	})

	for index, option in ipairs(OPTIONS) do
		local row = UIUtil.Create("Frame", {
			Size = UDim2.new(1, 0, 0, 62),
			BackgroundColor3 = Theme.Colors.PanelLight,
			LayoutOrder = index,
			Parent = content,
		})
		UIUtil.Corner(row, 14)
		UIUtil.Stroke(row, Theme.Colors.Disabled, 1.5)
		UIUtil.Label({
			Text = option.Label,
			Font = Theme.Fonts.Title,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, -140, 1, -18),
			Position = UDim2.fromOffset(16, 9),
			MaxTextSize = 21,
			Parent = row,
		})

		-- Interrupteur ON/OFF
		local button = UIUtil.Create("TextButton", {
			Size = UDim2.fromOffset(84, 40),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -16, 0.5, 0),
			BackgroundColor3 = Theme.Colors.Green,
			AutoButtonColor = false,
			Text = "",
			Parent = row,
		})
		UIUtil.Corner(button, UDim.new(1, 0))
		UIUtil.Stroke(button, Theme.Colors.Border, 1.5)
		local knob = UIUtil.Create("Frame", {
			Size = UDim2.fromOffset(32, 32),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -4, 0.5, 0),
			BackgroundColor3 = Color3.new(1, 1, 1),
			Parent = button,
		})
		UIUtil.Corner(knob, UDim.new(1, 0))
		UIUtil.Stroke(knob, Theme.Colors.Border, 1.5)
		UIUtil.AnimateButton(button)
		toggles[option.Key] = { Button = button, Knob = knob }

		button.Activated:Connect(function()
			local newValue = not current[option.Key]
			Settings.Apply(option.Key, newValue)
			SoundManager.Play("Open", newValue and 1.3 or 0.8)
			-- On prévient le serveur pour sauvegarder le choix
			task.spawn(function()
				pcall(function()
					Net.Function("SetSetting"):InvokeServer(option.Key, newValue)
				end)
			end)
		end)
	end

	UIUtil.Label({
		Text = "Astuce : chaque amélioration ajoute quelque chose à l'écran. Jusqu'où iras-tu ?",
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, 0, 0, 40),
		LayoutOrder = 10,
		MaxTextSize = 16,
		Parent = content,
	})
end

-- Au chargement, on applique les réglages sauvegardés (une seule fois)
local applied = false
function Settings.Update(data)
	if applied or not data.Settings then
		return
	end
	applied = true
	for _, option in ipairs(OPTIONS) do
		Settings.Apply(option.Key, data.Settings[option.Key] ~= false)
	end
end

return Settings
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">UpgradeBar</string>
            <string name="Source"><![CDATA[--[[
	UpgradeBar (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Components > UpgradeBar

	La rangée de cartes carrées sous le compteur (Formulas.GetVisibleUpgrades) :
	  - carte blanche à bord noir, gros emoji, pastille rouge = niveau
	    (améliorations à plusieurs niveaux) ;
	  - carte "fanée" si on ne peut pas se la payer ;
	  - infobulle : nom, description, coût (rouge si trop cher) ;
	  - PC : survol = infobulle, clic = achat ;
	  - tactile : 1er appui = infobulle avec un bouton "Acheter", 2e appui
	    (ou "Acheter") = achat ;
	  - "Aller à l'océan" demande toujours une confirmation ;
	  - style "Icônes HD" (Feature HDIcons) : cartes brillantes colorées ;
	  - mode sombre : cartes sombres translucides, texte blanc.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Client = script.Parent.Parent
local Theme = require(Client.Theme)
local UIUtil = require(Client.UIUtil)
local Interface = require(Client.Interface)
local ClientState = require(Client.ClientState)
local Effects = require(Client.Effects)
local SoundManager = require(Client.SoundManager)
local Notifications = require(script.Parent.Notifications)
local PanelManager = require(script.Parent.PanelManager)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local Net = require(ReplicatedStorage.Shared.Net)

local UpgradeBar = {}

local MAX_WIDTH = 660 -- largeur max de la rangée (au-delà : défilement horizontal)
local GAP = 14
local CARD_SIZE = 100
local MIN_CARD_SIZE = 78
local PAD_TOP = 10 -- place pour les pastilles qui dépassent
local PAD_SIDE = 10
UpgradeBar.Height = CARD_SIZE + PAD_TOP + 6

type Card = {
	Upgrade: any,
	Holder: Frame,
	Button: TextButton,
	Stroke: UIStroke,
	Gradient: UIGradient,
	Icon: TextLabel,
	Badge: TextLabel,
	PopScale: UIScale,
	HD: Frame,
	Level: number,
	Removing: boolean,
}

local bar: Frame
local scroll: ScrollingFrame
local cards: { [string]: Card } = {}
local random = Random.new()

-- Infobulle
local tooltip: Frame
local tipName: TextLabel
local tipDesc: TextLabel
local tipLevel: TextLabel
local tipCost: TextLabel
local tipButton: TextButton
local tipUpgradeId: string? = nil
local tipPinned = false -- vrai si ouverte par appui (tactile) ou confirmation

-- Entrées
local lastInputTouch = UserInputService.TouchEnabled and not UserInputService.MouseEnabled
local lastUiTapClock = 0
local hdEnabled = false
local darkMode = false

----------------------------------------------------------------------
-- Utilitaires
----------------------------------------------------------------------

local function formatAmount(value: number): string
	if value >= 1e6 then
		return NumberFormatter.Format(value)
	elseif value < 10 and value % 1 ~= 0 then
		return NumberFormatter.Format(value)
	end
	return NumberFormatter.WithSpaces(value)
end

local function getRebirths(): number
	local data = ClientState.Data
	return (data and data.Rebirths) or 0
end

local function getCost(upgrade): number
	return Formulas.GetUpgradeCost(upgrade, ClientState.GetLevel(upgrade.Id), getRebirths())
end

local function canAfford(upgrade): boolean
	return ClientState.GetTargetDopamine() >= getCost(upgrade) - 1e-6
end

local function isRepeatable(upgrade): boolean
	return upgrade.MaxLevel ~= 1
end

----------------------------------------------------------------------
-- Infobulle
----------------------------------------------------------------------

local function hideTooltip()
	tipUpgradeId = nil
	tipPinned = false
	if tooltip then
		tooltip.Visible = false
	end
end

local function refreshTooltip()
	local id = tipUpgradeId
	if not id then
		return
	end
	local card = cards[id]
	if not card or card.Removing or not card.Holder.Parent then
		hideTooltip()
		return
	end
	local upgrade = card.Upgrade
	local level = ClientState.GetLevel(upgrade.Id)
	local cost = getCost(upgrade)
	local affordable = canAfford(upgrade)

	tipName.Text = upgrade.Icon .. "  " .. upgrade.Name
	tipDesc.Text = Formulas.DescribeUpgrade(upgrade, NumberFormatter.Format, getRebirths())
	if upgrade.Effect == "Detox" then
		local rebirths = getRebirths()
		tipLevel.Visible = rebirths > 0
		tipLevel.Text = "Visites à l'océan : " .. tostring(rebirths)
	elseif isRepeatable(upgrade) then
		tipLevel.Visible = true
		tipLevel.Text = upgrade.MaxLevel and string.format("Niveau %d / %d", level, upgrade.MaxLevel) or ("Niveau " .. level)
	else
		tipLevel.Visible = false
	end
	tipCost.Text = "Coût : " .. formatAmount(cost) .. " Dopamine"
	tipCost.TextColor3 = affordable and Theme.Colors.Text or Theme.Colors.Red

	local needsButton = tipPinned
	tipButton.Visible = needsButton
	if needsButton then
		tipButton.Text = upgrade.Effect == "Detox" and "🌊 J'y vais" or "Acheter"
		UIUtil.SetButtonEnabled(tipButton, affordable)
	end

	-- Placement sous la carte (en coordonnées de la toile)
	local topLeft = Interface.ScreenToCanvas(card.Button.AbsolutePosition)
	local size = card.Button.AbsoluteSize / Interface.Scale
	local canvas = Interface.CanvasSize
	local halfWidth = tooltip.AbsoluteSize.X / Interface.Scale / 2
	if halfWidth <= 0 then
		halfWidth = 140
	end
	local x = math.clamp(topLeft.X + size.X / 2, halfWidth + 8, canvas.X - halfWidth - 8)
	tooltip.Position = UDim2.fromOffset(x, topLeft.Y + size.Y + 10)
end

local function showTooltip(upgradeId: string, pinned: boolean)
	local changed = tipUpgradeId ~= upgradeId
	tipUpgradeId = upgradeId
	tipPinned = pinned
	tooltip.Visible = true
	refreshTooltip()
	if changed then
		local scale = tooltip:FindFirstChildOfClass("UIScale")
		if scale then
			scale.Scale = 0.85
			UIUtil.Tween(scale, 0.15, { Scale = 1 }, Enum.EasingStyle.Back)
		end
	end
end

local function buildTooltip(layer: Frame)
	tooltip = UIUtil.Create("Frame", {
		Name = "UpgradeTooltip",
		Size = UDim2.fromOffset(280, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Theme.Colors.Card,
		Visible = false,
		ZIndex = 5,
		Parent = layer,
	})
	UIUtil.Corner(tooltip, 14)
	UIUtil.Stroke(tooltip, Theme.Colors.CardBorder, 2)
	UIUtil.Create("UIScale", { Parent = tooltip })
	UIUtil.Create("UIPadding", {
		PaddingTop = UDim.new(0, 10),
		PaddingBottom = UDim.new(0, 12),
		PaddingLeft = UDim.new(0, 14),
		PaddingRight = UDim.new(0, 14),
		Parent = tooltip,
	})
	UIUtil.Create("UIListLayout", {
		Padding = UDim.new(0, 4),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = tooltip,
	})

	local function textLine(order: number, font: Enum.Font, textSize: number, color: Color3): TextLabel
		return UIUtil.Create("TextLabel", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			Font = font,
			TextSize = textSize,
			TextColor3 = color,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Text = "",
			LayoutOrder = order,
			ZIndex = 6,
			Parent = tooltip,
		})
	end

	tipName = textLine(1, Theme.Fonts.Title, 21, Theme.Colors.Text)
	tipDesc = textLine(2, Theme.Fonts.Body, 16, Theme.Colors.TextDim)
	tipLevel = textLine(3, Theme.Fonts.Body, 15, Theme.Colors.TextDim)
	tipCost = textLine(4, Theme.Fonts.Title, 17, Theme.Colors.Text)

	tipButton = UIUtil.PillButton({
		Name = "Buy",
		Text = "Acheter",
		Color = Theme.Colors.Green,
		TextColor3 = Theme.Colors.TextDark,
		Height = 38,
		TextSize = 18,
		LayoutOrder = 5,
		ZIndex = 6,
		Parent = tooltip,
	})
	tipButton.Visible = false
end

----------------------------------------------------------------------
-- Achat
----------------------------------------------------------------------

local function burstAt(card: Card, color: Color3?)
	local layer = Effects.GetLayer()
	if layer and card.Button.Parent then
		Effects.Burst(layer, Interface.CanvasPosition(card.Button), color, 12)
	end
end

local function failFeedback(card: Card?)
	SoundManager.Play("Error", 0.7)
	if card then
		UIUtil.Shake(card.Button)
	end
end

local function buy(upgradeId: string)
	lastUiTapClock = os.clock()
	local card = cards[upgradeId]
	if not card or card.Removing then
		return
	end
	local upgrade = card.Upgrade
	if not canAfford(upgrade) then
		failFeedback(card)
		return
	end
	task.spawn(function()
		local ok, success, message = pcall(function()
			return Net.Function("BuyUpgrade"):InvokeServer(upgradeId)
		end)
		if ok and success then
			SoundManager.Play("Buy", 0.95 + random:NextNumber(0, 0.15))
			burstAt(card, upgrade.Color)
			if upgrade.Effect == "Detox" then
				hideTooltip()
			end
		else
			failFeedback(card)
			if not ok then
				Notifications.Toast("Erreur réseau, réessaie.", Theme.Colors.Red)
			elseif type(message) == "string" and message ~= "" then
				local layer = Effects.GetLayer()
				if layer and card.Button.Parent then
					Effects.FloatingText(layer, Interface.CanvasPosition(card.Button, Vector2.new(0, -40)), message, Theme.Colors.Red, 20)
				end
			end
		end
	end)
end

----------------------------------------------------------------------
-- Style des cartes
----------------------------------------------------------------------

local function styleCard(card: Card)
	local upgrade = card.Upgrade
	local affordable = canAfford(upgrade)
	local button = card.Button

	if hdEnabled then
		local color: Color3 = upgrade.Color or Theme.Colors.Blue
		button.BackgroundColor3 = Color3.new(1, 1, 1)
		button.BackgroundTransparency = darkMode and 0.1 or 0
		card.Gradient.Enabled = true
		card.Gradient.Color = ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.45), color)
		card.HD.Visible = true
	else
		card.Gradient.Enabled = false
		card.HD.Visible = false
		if darkMode then
			button.BackgroundColor3 = Theme.DarkColors.Card
			button.BackgroundTransparency = Theme.DarkColors.CardTransparency
		else
			button.BackgroundColor3 = Theme.Colors.Card
			button.BackgroundTransparency = 0
		end
	end
	card.Stroke.Color = darkMode and Theme.DarkColors.CardBorder or Theme.Colors.CardBorder
	card.Stroke.Transparency = affordable and 0 or 0.45
	card.Icon.TextTransparency = affordable and 0 or 0.5
end

local function styleAll()
	for _, card in pairs(cards) do
		if not card.Removing then
			styleCard(card)
		end
	end
end

----------------------------------------------------------------------
-- Création / suppression des cartes
----------------------------------------------------------------------

local function createCard(upgrade): Card
	local holder = UIUtil.Create("Frame", {
		Name = upgrade.Id,
		Size = UDim2.fromOffset(CARD_SIZE, CARD_SIZE),
		BackgroundTransparency = 1,
		Parent = scroll,
	})

	local button = UIUtil.Create("TextButton", {
		Name = "Card",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Colors.Card,
		AutoButtonColor = false,
		Text = "",
		ClipsDescendants = false,
		Parent = holder,
	})
	UIUtil.Corner(button, 18)
	local stroke = UIUtil.Stroke(button, Theme.Colors.CardBorder, 2)
	local gradient = UIUtil.Gradient(button, ColorSequence.new(Color3.new(1, 1, 1)), 90)
	gradient.Enabled = false
	local popScale = UIUtil.Create("UIScale", { Name = "PopScale", Parent = button })

	-- Décor "Icônes HD" : rayons qui tournent, anneau blanc, reflet brillant
	local hd = UIUtil.Create("Frame", {
		Name = "HD",
		Size = UDim2.new(1, -8, 1, -8),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Visible = false,
		ZIndex = 1,
		Parent = button,
	})
	UIUtil.Corner(hd, 14)
	local rays = UIUtil.Create("Frame", {
		Name = "Rays",
		Size = UDim2.fromScale(1.6, 1.6),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = 1,
		Parent = hd,
	})
	for i = 0, 5 do
		UIUtil.Create("Frame", {
			Size = UDim2.new(0, 12, 1, 0),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Rotation = i * 30,
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.72,
			BorderSizePixel = 0,
			ZIndex = 1,
			Parent = rays,
		})
	end
	local ring = UIUtil.Create("Frame", {
		Name = "Ring",
		Size = UDim2.fromScale(0.7, 0.7),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.65,
		ZIndex = 2,
		Parent = hd,
	})
	UIUtil.Corner(ring, UDim.new(1, 0))
	UIUtil.Stroke(ring, Color3.new(1, 1, 1), 3)
	local gloss = UIUtil.Create("Frame", {
		Name = "Gloss",
		Size = UDim2.new(1, 0, 0.45, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		ZIndex = 4,
		Parent = hd,
	})
	UIUtil.Create("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = gloss,
	})

	local icon = UIUtil.Label({
		Name = "Icon",
		Text = upgrade.Icon,
		Size = UDim2.fromScale(0.62, 0.62),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		ZIndex = 3,
		MaxTextSize = 60,
		Parent = button,
	})

	local badge = UIUtil.Badge(holder, 26)
	badge.Position = UDim2.new(1, -6, 0, 4)

	local card: Card = {
		Upgrade = upgrade,
		Holder = holder,
		Button = button,
		Stroke = stroke,
		Gradient = gradient,
		Icon = icon,
		Badge = badge,
		PopScale = popScale,
		HD = hd,
		Level = ClientState.GetLevel(upgrade.Id),
		Removing = false,
	}

	-- Survol (PC)
	button.MouseEnter:Connect(function()
		if lastInputTouch or tipPinned then
			return
		end
		showTooltip(upgrade.Id, false)
		UIUtil.Tween(popScale, 0.12, { Scale = 1.06 }, Enum.EasingStyle.Back)
	end)
	button.MouseLeave:Connect(function()
		UIUtil.Tween(popScale, 0.12, { Scale = 1 })
		if tipUpgradeId == upgrade.Id and not tipPinned then
			hideTooltip()
		end
	end)

	-- Clic / appui
	button.Activated:Connect(function()
		lastUiTapClock = os.clock()
		local needsConfirm = upgrade.Effect == "Detox"
		if lastInputTouch or needsConfirm then
			if tipUpgradeId == upgrade.Id and tipPinned and not needsConfirm then
				buy(upgrade.Id)
			else
				showTooltip(upgrade.Id, true)
				SoundManager.Play("Click", 1.3)
			end
		else
			buy(upgrade.Id)
		end
	end)

	styleCard(card)
	return card
end

local function removeCard(id: string)
	local card = cards[id]
	if not card or card.Removing then
		return
	end
	card.Removing = true
	cards[id] = nil
	if tipUpgradeId == id then
		hideTooltip()
	end
	UIUtil.Tween(card.PopScale, 0.25, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	task.delay(0.3, function()
		card.Holder:Destroy()
	end)
end

-- Place les cartes (centrées ; défilement si trop large).
-- Les cartes de `created` arrivent en glissant depuis le bas.
local function layout(order: { any }, created: { [string]: boolean })
	local count = #order
	local size = CARD_SIZE
	if count > 0 then
		size = math.clamp(math.floor((MAX_WIDTH - GAP * (count - 1)) / count), MIN_CARD_SIZE, CARD_SIZE)
	end
	local contentWidth = count * size + math.max(0, count - 1) * GAP + PAD_SIDE * 2
	local viewWidth = math.min(contentWidth, MAX_WIDTH + PAD_SIDE * 2)
	scroll.Size = UDim2.new(0, viewWidth, 1, 0)
	scroll.CanvasSize = UDim2.fromOffset(contentWidth, 0)
	scroll.ScrollBarThickness = contentWidth > viewWidth + 1 and 4 or 0

	for index, upgrade in ipairs(order) do
		local card = cards[upgrade.Id]
		if card then
			local x = PAD_SIDE + (index - 1) * (size + GAP)
			local y = PAD_TOP + (CARD_SIZE - size)
			local target = UDim2.fromOffset(x, y)
			local targetSize = UDim2.fromOffset(size, size)
			if created[upgrade.Id] then
				card.Holder.Size = targetSize
				card.Holder.Position = target + UDim2.fromOffset(0, 40)
				card.PopScale.Scale = 0.2
				UIUtil.Tween(card.Holder, 0.4, { Position = target }, Enum.EasingStyle.Back)
				UIUtil.Tween(card.PopScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
			elseif card.Holder.Position ~= target or card.Holder.Size ~= targetSize then
				UIUtil.Tween(card.Holder, 0.3, { Position = target, Size = targetSize })
			end
		end
	end
end

local function refresh(data)
	local visible = Formulas.GetVisibleUpgrades(data)
	local wanted = {}
	for _, upgrade in ipairs(visible) do
		wanted[upgrade.Id] = true
	end

	-- Cartes qui disparaissent (achat unique terminé, niveau max, océan...)
	local toRemove = {}
	for id in pairs(cards) do
		if not wanted[id] then
			table.insert(toRemove, id)
		end
	end
	for _, id in ipairs(toRemove) do
		removeCard(id)
	end

	-- Nouvelles cartes
	local created = {}
	for _, upgrade in ipairs(visible) do
		if not cards[upgrade.Id] then
			cards[upgrade.Id] = createCard(upgrade)
			created[upgrade.Id] = true
		end
	end

	layout(visible, created)

	for _, upgrade in ipairs(visible) do
		local card = cards[upgrade.Id]
		if card then
			-- Pastille : niveau (améliorations à plusieurs niveaux) ou nombre de visites à l'océan
			local level = Formulas.GetLevel(data, upgrade.Id)
			if upgrade.Effect == "Detox" then
				UIUtil.SetBadge(card.Badge, data.Rebirths or 0)
			elseif isRepeatable(upgrade) then
				UIUtil.SetBadge(card.Badge, level)
			else
				UIUtil.SetBadge(card.Badge, 0)
			end

			-- "Pop" quand le niveau augmente
			if level > card.Level and not created[upgrade.Id] then
				card.PopScale.Scale = 1.25
				UIUtil.Tween(card.PopScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
				card.Badge.Size = UDim2.fromOffset(34, 34)
				UIUtil.Tween(card.Badge, 0.3, { Size = UDim2.fromOffset(26, 26) }, Enum.EasingStyle.Back)
			end
			card.Level = level
			styleCard(card)
		end
	end

	if tipUpgradeId then
		refreshTooltip()
	end
end

----------------------------------------------------------------------
-- Construction
----------------------------------------------------------------------

-- `parent` : cadre de la colonne centrale ; `tooltipLayer` : calque plein écran
-- au-dessus des stimuli (pour l'infobulle)
function UpgradeBar.Build(parent: GuiObject, tooltipLayer: Frame): Frame
	bar = UIUtil.Create("Frame", {
		Name = "UpgradeBar",
		Size = UDim2.new(1, 0, 0, UpgradeBar.Height),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	scroll = UIUtil.Create("ScrollingFrame", {
		Name = "Cards",
		Size = UDim2.new(0, MAX_WIDTH, 1, 0),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollingDirection = Enum.ScrollingDirection.X,
		ScrollBarThickness = 0,
		ScrollBarImageColor3 = Theme.Colors.Dark,
		CanvasSize = UDim2.fromOffset(0, 0),
		ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
		Parent = bar,
	})

	buildTooltip(tooltipLayer)
	tipButton.Activated:Connect(function()
		lastUiTapClock = os.clock()
		local id = tipUpgradeId
		if not id then
			return
		end
		local card = cards[id]
		if not tipButton:GetAttribute("Enabled") then
			failFeedback(card)
			return
		end
		buy(id)
	end)

	-- Type d'entrée (tactile ou souris)
	UserInputService.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.Touch then
			lastInputTouch = true
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
			lastInputTouch = false
		end
	end)
	UserInputService.InputChanged:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseMovement and not UserInputService.TouchEnabled then
			lastInputTouch = false
		end
	end)
	-- Appui ailleurs : on ferme l'infobulle "épinglée"
	UserInputService.InputEnded:Connect(function(input: InputObject)
		local inputType = input.UserInputType
		if inputType ~= Enum.UserInputType.Touch and inputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		local stamp = os.clock()
		task.delay(0.15, function()
			if tipPinned and lastUiTapClock < stamp - 0.25 then
				hideTooltip()
			end
		end)
	end)

	PanelManager.Opened:Connect(hideTooltip)

	-- Mises à jour
	ClientState.Changed:Connect(refresh)
	ClientState.FeaturesChanged:Connect(function()
		hdEnabled = ClientState.HasFeature("HDIcons")
		styleAll()
	end)
	ClientState.DarkModeChanged:Connect(function(dark: boolean)
		darkMode = dark
		styleAll()
	end)
	darkMode = ClientState.DarkMode

	-- Affordabilité (10 fois par seconde) + rotation des rayons HD
	local accumulator = 0
	RunService.RenderStepped:Connect(function(dt: number)
		if hdEnabled then
			local rotation = (os.clock() * 25) % 360
			for _, card in pairs(cards) do
				local rays = card.HD:FindFirstChild("Rays") :: Frame?
				if rays then
					rays.Rotation = rotation
				end
			end
		end
		accumulator += dt
		if accumulator < 0.1 then
			return
		end
		accumulator = 0
		for _, card in pairs(cards) do
			if not card.Removing then
				local affordable = canAfford(card.Upgrade)
				card.Icon.TextTransparency = affordable and 0 or 0.5
				card.Stroke.Transparency = affordable and 0 or 0.45
			end
		end
		if tipUpgradeId then
			refreshTooltip()
		end
	end)

	if ClientState.Data then
		refresh(ClientState.Data)
	end
	return bar
end

-- Masque l'infobulle (ex. clic sur le gros bouton)
function UpgradeBar.HideTooltip()
	if not tipPinned then
		hideTooltip()
	end
end

return UpgradeBar
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Effects</string>
          <string name="Source"><![CDATA[--[[
	Effects (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Effects

	Effets visuels 2D : textes flottants "+X", particules, confettis,
	flash d'écran, gros messages. (Les ParticleEmitter ne fonctionnent pas
	dans les interfaces, on anime donc de petits Frames.)
	Le réglage "Effets" (SetEnabled) coupe particules et confettis.
]]

local Debris = game:GetService("Debris")

local Theme = require(script.Parent.Theme)
local UIUtil = require(script.Parent.UIUtil)

local Effects = {}

local layer: Frame? = nil -- calque plein écran pour les effets
local enabled = true -- paramètre "Effets" (particules / confettis)
local random = Random.new()
local activeParticles = 0
local activeTexts = 0
local MAX_PARTICLES = 160 -- limite pour les petits appareils
local MAX_TEXTS = 60

local CONFETTI_COLORS = {
	Theme.Colors.Pink,
	Theme.Colors.Cyan,
	Theme.Colors.Purple,
	Theme.Colors.Yellow,
	Theme.Colors.Green,
	Theme.Colors.Orange,
	Theme.Colors.Red,
	Theme.Colors.Blue,
}

function Effects.Init(effectsLayer: Frame)
	layer = effectsLayer
end

function Effects.SetEnabled(value: boolean)
	enabled = value
end

function Effects.IsEnabled(): boolean
	return enabled
end

-- Calque plein écran des effets (nil avant Init)
function Effects.GetLayer(): Frame?
	return layer
end

-- Texte "+X" qui monte et disparaît
function Effects.FloatingText(parent: GuiObject, position: UDim2, text: string, color: Color3?, size: number?)
	if activeTexts >= MAX_TEXTS or not parent or not parent.Parent then
		return
	end
	activeTexts += 1
	local height = size or 34
	local textColor = color or Theme.Colors.Text
	local label = UIUtil.Label({
		Text = text,
		Font = Theme.Fonts.Number,
		TextColor3 = textColor,
		Size = UDim2.fromOffset(height * 6, height),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = position,
		Rotation = random:NextNumber(-10, 10),
		ZIndex = 50,
		MaxTextSize = height,
		Parent = parent,
	})
	-- Contour contrasté : blanc autour d'un texte foncé, noir autour d'un texte clair
	local strokeColor = Theme.Luminance(textColor) > 0.5 and Theme.Colors.TextDark or Theme.Colors.TextLight
	local stroke = UIUtil.Stroke(label, strokeColor, 2)
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual

	local scale = UIUtil.Create("UIScale", { Scale = 0.4, Parent = label })
	UIUtil.Tween(scale, 0.18, { Scale = 1.1 }, Enum.EasingStyle.Back)
	UIUtil.Tween(label, 0.9, {
		Position = position + UDim2.fromOffset(random:NextNumber(-30, 30), -100),
		TextTransparency = 1,
	}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	UIUtil.Tween(stroke, 0.9, { Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(1, function()
		activeTexts -= 1
		label:Destroy()
	end)
end

-- Explosion de petites particules rondes autour d'un point
function Effects.Burst(parent: GuiObject, position: UDim2, color: Color3?, count: number?)
	if not enabled or not parent or not parent.Parent then
		return
	end
	for _ = 1, count or 8 do
		if activeParticles >= MAX_PARTICLES then
			return
		end
		activeParticles += 1
		local size = random:NextInteger(6, 14)
		local particle = UIUtil.Create("Frame", {
			Size = UDim2.fromOffset(size, size),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = position,
			BackgroundColor3 = color or CONFETTI_COLORS[random:NextInteger(1, #CONFETTI_COLORS)],
			BorderSizePixel = 0,
			ZIndex = 40,
			Parent = parent,
		})
		UIUtil.Corner(particle, UDim.new(1, 0))

		local angle = random:NextNumber(0, math.pi * 2)
		local distance = random:NextNumber(50, 140)
		local duration = random:NextNumber(0.4, 0.7)
		UIUtil.Tween(particle, duration, {
			Position = position + UDim2.fromOffset(math.cos(angle) * distance, math.sin(angle) * distance),
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(2, 2),
		}, Enum.EasingStyle.Quart)
		task.delay(duration, function()
			activeParticles -= 1
			particle:Destroy()
		end)
	end
end

-- Pluie de confettis sur tout l'écran
function Effects.Confetti(count: number?)
	local target = layer
	if not enabled or not target then
		return
	end
	for _ = 1, count or 80 do
		if activeParticles >= MAX_PARTICLES then
			return
		end
		activeParticles += 1
		local piece = UIUtil.Create("Frame", {
			Size = UDim2.fromOffset(random:NextInteger(8, 16), random:NextInteger(14, 24)),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(random:NextNumber(0, 1), 0, 0, random:NextInteger(-200, -20)),
			Rotation = random:NextNumber(0, 360),
			BackgroundColor3 = CONFETTI_COLORS[random:NextInteger(1, #CONFETTI_COLORS)],
			BorderSizePixel = 0,
			ZIndex = 90,
			Parent = target,
		})
		local duration = random:NextNumber(1.6, 3)
		local start = piece.Position
		UIUtil.Tween(piece, duration, {
			Position = UDim2.new(start.X.Scale + random:NextNumber(-0.15, 0.15), 0, 1.1, 0),
			Rotation = piece.Rotation + random:NextNumber(-720, 720),
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(duration, function()
			activeParticles -= 1
			piece:Destroy()
		end)
	end
end

-- Flash coloré de tout l'écran
function Effects.Flash(color: Color3?, strength: number?)
	local target = layer
	if not target then
		return
	end
	local flash = UIUtil.Create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = color or Color3.new(1, 1, 1),
		BackgroundTransparency = 1 - (strength or 0.6),
		BorderSizePixel = 0,
		ZIndex = 95,
		Parent = target,
	})
	UIUtil.Tween(flash, 0.6, { BackgroundTransparency = 1 })
	Debris:AddItem(flash, 0.7)
end

-- Gros message au centre de l'écran (jackpot, rush...)
function Effects.BigMessage(text: string, color: Color3?, duration: number?)
	local target = layer
	if not target then
		return
	end
	local label = UIUtil.Label({
		Text = text,
		Font = Theme.Fonts.Title,
		TextColor3 = color or Theme.Colors.Yellow,
		Size = UDim2.new(0.9, 0, 0, 110),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		ZIndex = 100,
		MaxTextSize = 90,
		Parent = target,
	})
	local stroke = UIUtil.Stroke(label, Theme.Colors.TextDark, 4)
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual

	local scale = UIUtil.Create("UIScale", { Scale = 0.1, Parent = label })
	UIUtil.Tween(scale, 0.5, { Scale = 1 }, Enum.EasingStyle.Elastic)

	-- Petit clignotement de couleur
	task.spawn(function()
		local colors = { color or Theme.Colors.Yellow, Theme.Colors.Cyan, Theme.Colors.Pink, Theme.Colors.Green }
		local index = 0
		local finish = os.clock() + (duration or 2.5)
		while label.Parent and os.clock() < finish do
			index = index % #colors + 1
			label.TextColor3 = colors[index]
			task.wait(0.12)
		end
		if not label.Parent then
			return
		end
		UIUtil.Tween(label, 0.4, { TextTransparency = 1 })
		UIUtil.Tween(stroke, 0.4, { Transparency = 1 })
		task.wait(0.4)
		label:Destroy()
	end)
end

return Effects
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Interface</string>
          <string name="Source"><![CDATA[--[[
	Interface (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Interface

	Crée la ScreenGui et la "toile virtuelle" responsive :
	  - toute l'interface est pensée pour un écran de 1280x720 ;
	  - un UIScale agrandit / réduit l'ensemble selon l'écran réel
	    (PC, mobile, tablette) ;
	  - le cadre "Root" s'étire pour toujours couvrir tout l'écran
	    (sa taille en pixels "design" est donc >= 1280x720 dans un sens).

	Calques (du plus bas au plus haut), tous plein écran, transparents et
	non "Active" (les clics passent à travers) :
	  Background < Slots < Main < Overlay < Panels < Toasts < Effects < Cinematic
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Theme = require(script.Parent.Theme)
local UIUtil = require(script.Parent.UIUtil)
local Signal = require(ReplicatedStorage.Shared.Signal)

local Interface = {}

Interface.ScreenGui = nil :: ScreenGui?
Interface.Root = nil :: Frame?
Interface.Layers = {} :: { [string]: Frame }
Interface.Scale = 1
Interface.CanvasSize = Theme.DesignResolution -- taille de la toile en pixels "design"
Interface.ScaleChanged = Signal.new() -- (scale, canvasSize)

Interface.LayerOrder = { "Background", "Slots", "Main", "Overlay", "Panels", "Toasts", "Effects", "Cinematic" }

function Interface.Build(): ScreenGui
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui
	-- Le jeu se joue en paysage sur mobile
	playerGui.ScreenOrientation = Enum.ScreenOrientation.LandscapeSensor

	local old = playerGui:FindFirstChild("DopamineGui")
	if old then
		old:Destroy()
	end

	local screenGui = UIUtil.Create("ScreenGui", {
		Name = "DopamineGui",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	})

	-- Toile virtuelle mise à l'échelle
	local root = UIUtil.Create("Frame", {
		Name = "Root",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(Theme.DesignResolution.X, Theme.DesignResolution.Y),
		ZIndex = 2,
		Parent = screenGui,
	})
	local uiScale = UIUtil.Create("UIScale", { Parent = root })

	for index, name in ipairs(Interface.LayerOrder) do
		Interface.Layers[name] = UIUtil.Create("Frame", {
			Name = name,
			BackgroundTransparency = 1,
			Active = false,
			Size = UDim2.fromScale(1, 1),
			ZIndex = index,
			Parent = root,
		})
	end

	-- Recalcule l'échelle quand la taille de l'écran change
	local function updateScale()
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local viewport = camera.ViewportSize
		if viewport.X < 1 or viewport.Y < 1 then
			return
		end
		local design = Theme.DesignResolution
		local scale = math.clamp(math.min(viewport.X / design.X, viewport.Y / design.Y), Theme.MinScale, Theme.MaxScale)
		local canvas = Vector2.new(viewport.X / scale, viewport.Y / scale)
		Interface.Scale = scale
		Interface.CanvasSize = canvas
		uiScale.Scale = scale
		-- Root fait (écran / échelle) pour couvrir exactement l'écran une fois agrandi
		root.Size = UDim2.fromOffset(canvas.X, canvas.Y)
		Interface.ScaleChanged:Fire(scale, canvas)
	end

	local cameraConnection: RBXScriptConnection? = nil
	local function watchCamera()
		if cameraConnection then
			cameraConnection:Disconnect()
			cameraConnection = nil
		end
		local camera = workspace.CurrentCamera
		if camera then
			cameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
		end
		updateScale()
	end
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
	watchCamera()

	Interface.ScreenGui = screenGui
	Interface.Root = root
	return screenGui
end

-- Convertit une position écran (pixels réels, ex. AbsolutePosition) en
-- position sur la toile (pixels "design").
function Interface.ScreenToCanvas(point: Vector2): Vector2
	local root = Interface.Root
	if not root then
		return point
	end
	return (point - root.AbsolutePosition) / Interface.Scale
end

-- Centre d'un élément, en coordonnées de la toile (pour placer des effets
-- dans un calque plein écran, ex. Effects.Burst(layer, UDim2.fromOffset(...)))
function Interface.GetCanvasCenter(guiObject: GuiObject): Vector2
	return Interface.ScreenToCanvas(guiObject.AbsolutePosition + guiObject.AbsoluteSize / 2)
end

-- Même chose, mais sous forme de UDim2 prête à l'emploi
function Interface.CanvasPosition(guiObject: GuiObject, offset: Vector2?): UDim2
	local center = Interface.GetCanvasCenter(guiObject) + (offset or Vector2.zero)
	return UDim2.fromOffset(center.X, center.Y)
end

return Interface
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Slots</string>
          <string name="Source"><![CDATA[--[[
	Slots (ModuleScript)
	Emplacement : ReplicatedStorage > Client > Slots

	Emplacements nommés de l'écran (toile de 1280x720 pixels "design") où
	les stimuli (Client > Stimuli) viennent se placer.

	Ancrage horizontal :
	  "L" = décalage depuis le bord gauche, "R" = depuis le bord droit,
	  "C" = centré (X = décalage du CENTRE du slot par rapport au centre),
	  "T" = toute la largeur.
	Verticalement, les slots de la moitié haute sont accrochés en haut et
	ceux de la moitié basse en bas : sur un écran plus haut que 16:9
	(tablette), l'espace libre se retrouve au milieu.

	Spéciaux : "Overlay" (plein écran, calque Overlay) et "Background"
	(plein écran, calque Background, sous tout le reste).

	La colonne centrale (bouton, compteur, améliorations) occupe
	x ∈ [centre-300, centre+300], y ∈ [30, 425] : elle doit rester lisible.
]]

local Slots = {}

Slots.DesignHeight = 720

-- { Anchor, X, Y, W, H } (H = 0 et Anchor "T" : toute la largeur)
Slots.Definitions = {
	Ticker = { Anchor = "T", X = 0, Y = 0, W = 0, H = 30 },
	L1 = { Anchor = "L", X = 16, Y = 40, W = 288, H = 190 },
	R1 = { Anchor = "R", X = 16, Y = 40, W = 288, H = 190 },
	L2 = { Anchor = "L", X = 16, Y = 240, W = 288, H = 180 },
	R2 = { Anchor = "R", X = 16, Y = 240, W = 288, H = 180 },
	CL = { Anchor = "C", X = -250, Y = 40, W = 170, H = 170 },
	CR = { Anchor = "C", X = 250, Y = 40, W = 170, H = 170 },
	L3 = { Anchor = "L", X = 16, Y = 436, W = 384, H = 268 },
	C3 = { Anchor = "C", X = 0, Y = 436, W = 384, H = 268 },
	R3 = { Anchor = "R", X = 16, Y = 436, W = 384, H = 268 },
}

-- Vrai si `name` est un emplacement connu (y compris Overlay / Background)
function Slots.IsValid(name: string): boolean
	return Slots.Definitions[name] ~= nil or name == "Overlay" or name == "Background"
end

-- Nom du calque de l'Interface où doit aller ce slot
function Slots.GetLayerName(name: string): string
	if name == "Overlay" then
		return "Overlay"
	elseif name == "Background" then
		return "Background"
	end
	return "Slots"
end

-- Position (centre, AnchorPoint 0.5/0.5) et taille d'un slot
function Slots.GetPlacement(name: string): (UDim2, UDim2)
	local def = Slots.Definitions[name]
	if not def then
		return UDim2.fromScale(0.5, 0.5), UDim2.fromScale(1, 1)
	end

	local centerY = def.Y + def.H / 2
	local yUDim
	if centerY > Slots.DesignHeight / 2 then
		yUDim = UDim.new(1, -(Slots.DesignHeight - centerY)) -- accroché en bas
	else
		yUDim = UDim.new(0, centerY) -- accroché en haut
	end

	local xUDim
	local size
	if def.Anchor == "T" then
		xUDim = UDim.new(0.5, 0)
		size = UDim2.new(1, 0, 0, def.H)
	elseif def.Anchor == "L" then
		xUDim = UDim.new(0, def.X + def.W / 2)
		size = UDim2.fromOffset(def.W, def.H)
	elseif def.Anchor == "R" then
		xUDim = UDim.new(1, -(def.X + def.W / 2))
		size = UDim2.fromOffset(def.W, def.H)
	else -- "C"
		xUDim = UDim.new(0.5, def.X)
		size = UDim2.fromOffset(def.W, def.H)
	end
	return UDim2.new(xUDim, yUDim), size
end

-- Crée le cadre (transparent) d'un slot dans `parent`.
-- Slots réels : ClipsDescendants = true. Overlay / Background : plein écran.
function Slots.Create(name: string, parent: Instance?): Frame
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.Active = false
	frame.AnchorPoint = Vector2.new(0.5, 0.5)

	if name == "Overlay" or name == "Background" or not Slots.Definitions[name] then
		if not Slots.IsValid(name) then
			warn("[Slots] Emplacement inconnu : " .. tostring(name) .. " (plein écran utilisé)")
		end
		frame.Position = UDim2.fromScale(0.5, 0.5)
		frame.Size = UDim2.fromScale(1, 1)
		frame.ClipsDescendants = false
	else
		local position, size = Slots.GetPlacement(name)
		frame.Position = position
		frame.Size = size
		frame.ClipsDescendants = true
	end

	frame.Parent = parent
	return frame
end

return Slots
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">SoundManager</string>
          <string name="Source"><![CDATA[--[[
	SoundManager (ModuleScript)
	Emplacement : ReplicatedStorage > Client > SoundManager

	Joue les sons et la musique (côté client uniquement).
	Les IDs se changent dans Config.Sounds.

	Musique : elle ne joue que si le réglage "Musique" est activé
	(SetMusicEnabled) ET qu'elle est autorisée (SetMusicAllowed : ClientMain
	l'autorise quand le joueur possède la Feature "Lofi").
]]

local ContentProvider = game:GetService("ContentProvider")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage.Shared.Config)

local SoundManager = {}

local soundEnabled = true
local musicEnabled = true -- réglage du joueur
local musicAllowed = false -- Feature "Lofi" possédée
local templates: { [string]: Sound } = {}
local music: Sound? = nil
local lastPlayed: { [string]: number } = {}
local MIN_INTERVAL = 0.035 -- évite d'empiler 20 fois le même son dans la même image

local function refreshMusic()
	local track = music
	if not track then
		return
	end
	local shouldPlay = musicEnabled and musicAllowed
	if shouldPlay and not track.IsPlaying then
		track:Play()
	elseif not shouldPlay and track.IsPlaying then
		track:Stop()
	end
end

-- Crée un "modèle" de son pour chaque entrée de Config.Sounds
function SoundManager.Init()
	local folder = SoundService:FindFirstChild("DopamineSounds")
	if folder then
		folder:Destroy()
	end
	folder = Instance.new("Folder")
	folder.Name = "DopamineSounds"
	folder.Parent = SoundService

	local toPreload = {}
	for name, info in pairs(Config.Sounds) do
		if info.Id ~= "" then
			local sound = Instance.new("Sound")
			sound.Name = name
			sound.SoundId = info.Id
			sound.Volume = info.Volume
			sound.Parent = folder
			templates[name] = sound
			table.insert(toPreload, sound)
		end
	end

	-- Musique de fond
	local musicTemplate = templates.Music
	if musicTemplate then
		musicTemplate.Looped = true
		music = musicTemplate
	end

	-- Préchargement en arrière-plan (évite un petit délai au premier clic)
	task.spawn(function()
		pcall(function()
			ContentProvider:PreloadAsync(toPreload)
		end)
	end)
end

-- Joue un son. `pitch` change la hauteur (1 = normal).
function SoundManager.Play(name: string, pitch: number?)
	if not soundEnabled or name == "Music" then
		return
	end
	local template = templates[name]
	if not template then
		return
	end
	local now = os.clock()
	if now - (lastPlayed[name] or 0) < MIN_INTERVAL then
		return
	end
	lastPlayed[name] = now
	local sound = template:Clone()
	sound.PlaybackSpeed = pitch or 1
	sound.Parent = SoundService
	sound:Play()
	Debris:AddItem(sound, math.max(2, sound.TimeLength / math.max(0.1, sound.PlaybackSpeed) + 0.5))
end

function SoundManager.SetSoundEnabled(enabled: boolean)
	soundEnabled = enabled
end

-- Réglage "Musique" du joueur
function SoundManager.SetMusicEnabled(enabled: boolean)
	musicEnabled = enabled
	refreshMusic()
end

-- Autorisation de la musique (Feature "Lofi")
function SoundManager.SetMusicAllowed(allowed: boolean)
	musicAllowed = allowed
	refreshMusic()
end

function SoundManager.IsSoundEnabled(): boolean
	return soundEnabled
end

return SoundManager
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="21">
        <Properties>
          <string name="Name">Stimuli</string>
        </Properties>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">BubbleWrap</string>
            <string name="Source"><![CDATA[--[[
	BubbleWrap (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > BubbleWrap

	Une feuille de papier bulle (8 x 5 bulles, en quinconce) :
	  - clic / toucher sur une bulle = POP (son à hauteur aléatoire, bulle
	    qui gonfle puis s'aplatit, onde, gouttelettes, "+X") ;
	  - sur PC, on peut aussi maintenir le clic et "glisser" sur les bulles ;
	  - chaque bulle éclatée envoie Interact("Bubble"). Le serveur ne renvoie
	    pas de notification : le "+X" affiché est prédit côté client
	    (gain par clic x Config.Interactions.Bubble.ClickFraction) ;
	  - limite côté client (seau de jetons) pour ne jamais dépasser
	    MaxPerSecond : au-delà, la bulle résiste (petit tremblement) ;
	  - quand tout est éclaté, la feuille part et une neuve arrive en glissant.
	Les 40 bulles sont créées une seule fois puis réutilisées.
]]

local Debris = game:GetService("Debris")
local UserInputService = game:GetService("UserInputService")

local BubbleWrap = {}
BubbleWrap.Slot = "L2"

local COLUMNS = 8
local ROWS = 5
local PITCH_X = 32
local PITCH_Y = 28
local DIAMETER = 26

local CAPTIONS = {
	"Encore ! 🔁",
	"Nouvelle feuille 📦",
	"Livraison de bulles !",
	"Tu en veux encore ?",
	"Pop pop pop !",
	"La feuille était innocente.",
	"Zéro bulle survivante.",
	"C'est thérapeutique.",
}

function BubbleWrap.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local Create = UIUtil.Create
	local container: Frame = ctx.Container
	local random = Random.new()
	local bubbleConfig = ctx.Config.Interactions.Bubble or {}
	local maxPerSecond = bubbleConfig.MaxPerSecond or 12
	local clickFraction = bubbleConfig.ClickFraction or 0.5

	-- Seau de jetons (un peu sous la limite serveur, pour ne jamais être refusé)
	local capacity = math.max(1, math.floor(maxPerSecond * 0.75))
	local refillRate = maxPerSecond * 0.9
	local tokens = capacity
	local lastRefill = os.clock()

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	------------------------------------------------------------------
	-- Carte + en-tête
	------------------------------------------------------------------
	local card = Create("Frame", {
		Name = "Card",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Colors.Card,
		BorderSizePixel = 0,
		Parent = container,
	})
	UIUtil.Corner(card, 18)
	UIUtil.Stroke(card, Theme.Colors.CardBorder, 2)

	UIUtil.Label({
		Text = "🔘 PAPIER BULLE",
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.TextDark,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(12, 5),
		Size = UDim2.fromOffset(160, 20),
		MaxTextSize = 15,
		ZIndex = 5,
		Parent = card,
	})
	local counterLabel = UIUtil.Label({
		Text = "💥 0",
		Font = Theme.Fonts.Number,
		TextColor3 = Theme.Colors.TextDark,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 5),
		Size = UDim2.fromOffset(90, 20),
		MaxTextSize = 15,
		ZIndex = 5,
		Parent = card,
	})
	local counterScale = Create("UIScale", { Parent = counterLabel })

	-- Fenêtre (découpe la feuille quand elle glisse)
	local window = Create("Frame", {
		Name = "Window",
		Position = UDim2.fromOffset(8, 28),
		Size = UDim2.new(1, -16, 1, -34),
		BackgroundColor3 = Color3.fromRGB(236, 240, 246),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 2,
		Parent = card,
	})

	local sheet = Create("Frame", {
		Name = "Sheet",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(222, 240, 255),
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = window,
	})
	UIUtil.Gradient(sheet, ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(210, 226, 240)), 60)

	-- Message de fin de feuille
	local caption = UIUtil.Label({
		Text = "",
		Font = Enum.Font.LuckiestGuy,
		TextColor3 = Theme.Colors.Blue,
		TextTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -20, 0, 34),
		MaxTextSize = 28,
		ZIndex = 1,
		Parent = window,
	})
	local captionStroke = UIUtil.Stroke(caption, Color3.new(1, 1, 1), 2.5, 1)
	captionStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual

	------------------------------------------------------------------
	-- Bulles (créées une fois, réutilisées pour chaque feuille)
	------------------------------------------------------------------
	local bubbleFill = Color3.fromRGB(242, 250, 255)
	local bubbleStroke = Color3.fromRGB(140, 190, 228)
	local bubbles = {}
	local poppedCount = 0
	local sessionPops = 0
	local regenerating = false

	local function bubblePosition(row: number, column: number): (number, number)
		local x = 16 + column * PITCH_X + ((row % 2 == 1) and PITCH_X / 2 or 0)
		local y = 16 + row * PITCH_Y
		return x, y
	end

	local function resetBubble(bubble)
		bubble.Popped = false
		local button = bubble.Button
		button.BackgroundTransparency = 0.05
		bubble.Scale.Scale = 1
		bubble.Stroke.Color = bubbleStroke
		bubble.Stroke.Transparency = 0
		local shine = bubble.Shine
		shine.Position = UDim2.fromScale(0.34, 0.3)
		shine.Size = UDim2.fromScale(0.36, 0.22)
		shine.Rotation = -30
		shine.BackgroundColor3 = Color3.new(1, 1, 1)
		shine.BackgroundTransparency = 0.05
	end

	local function setPoppedLook(bubble)
		local button = bubble.Button
		button.BackgroundTransparency = 0.6
		bubble.Stroke.Color = Color3.fromRGB(120, 158, 196)
		bubble.Stroke.Transparency = 0.35
		-- Le reflet devient un pli
		local shine = bubble.Shine
		shine.Position = UDim2.fromScale(0.5, 0.5)
		shine.Size = UDim2.fromScale(0.62, 0.08)
		shine.Rotation = random:NextNumber(20, 60)
		shine.BackgroundColor3 = Color3.fromRGB(130, 170, 206)
		shine.BackgroundTransparency = 0.25
	end

	-- Vrai si un jeton est disponible (et le consomme)
	local function takeToken(): boolean
		local now = os.clock()
		tokens = math.min(capacity, tokens + (now - lastRefill) * refillRate)
		lastRefill = now
		if tokens >= 1 then
			tokens -= 1
			return true
		end
		return false
	end

	local function popEffects(x: number, y: number)
		-- Onde
		local ring = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(x, y),
			Size = UDim2.fromOffset(DIAMETER, DIAMETER),
			BackgroundTransparency = 1,
			ZIndex = 6,
			Parent = sheet,
		})
		UIUtil.Corner(ring, UDim.new(1, 0))
		local ringStroke = UIUtil.Stroke(ring, Color3.fromRGB(110, 180, 240), 2, 0.1)
		UIUtil.Tween(ring, 0.25, { Size = UDim2.fromOffset(DIAMETER * 1.8, DIAMETER * 1.8) })
		UIUtil.Tween(ringStroke, 0.25, { Transparency = 1 })
		Debris:AddItem(ring, 0.3)

		-- Gouttelettes d'air (si effets actifs)
		if effectsOn() then
			for _ = 1, 3 do
				local angle = random:NextNumber(0, math.pi * 2)
				local distance = random:NextNumber(12, 22)
				local drop = Create("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromOffset(x, y),
					Size = UDim2.fromOffset(4, 4),
					BackgroundColor3 = Color3.new(1, 1, 1),
					BorderSizePixel = 0,
					ZIndex = 7,
					Parent = sheet,
				})
				UIUtil.Corner(drop, UDim.new(1, 0))
				UIUtil.Stroke(drop, Color3.fromRGB(120, 180, 230), 1)
				UIUtil.Tween(drop, 0.3, {
					Position = UDim2.fromOffset(x + math.cos(angle) * distance, y + math.sin(angle) * distance),
					BackgroundTransparency = 1,
				})
				Debris:AddItem(drop, 0.35)
			end
		end
	end

	local regenerate -- (déclarée plus bas)

	local function pop(bubble)
		if bubble.Popped or regenerating or not ctx.IsAlive() then
			return
		end
		if not takeToken() then
			-- Trop vite : la bulle résiste
			bubble.Scale.Scale = 0.9
			UIUtil.Tween(bubble.Scale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)
			return
		end
		bubble.Popped = true
		poppedCount += 1
		sessionPops += 1

		ctx.Interact("Bubble")
		ctx.Sound.Play("Pop", random:NextNumber(0.9, 1.35))

		-- Gonfle puis s'aplatit
		bubble.Scale.Scale = 1.22
		UIUtil.Tween(bubble.Scale, 0.22, { Scale = 0.84 }, Enum.EasingStyle.Back)
		setPoppedLook(bubble)
		popEffects(bubble.X, bubble.Y)

		-- "+X" prédit
		local data = ctx.State.Data
		local value = (data and tonumber(data.ClickValue) or 0) * clickFraction
		if value > 0 then
			local sheetOffset = sheet.Position.X.Offset
			ctx.FloatText(
				container,
				UDim2.fromOffset(8 + sheetOffset + bubble.X, 28 + bubble.Y - 10),
				"+" .. ctx.Format.Format(value),
				Theme.Colors.Blue,
				18
			)
		end

		counterLabel.Text = "💥 " .. sessionPops
		counterScale.Scale = 1.15
		UIUtil.Tween(counterScale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)

		if poppedCount >= #bubbles then
			regenerate()
		end
	end

	for row = 0, ROWS - 1 do
		for column = 0, COLUMNS - 1 do
			local x, y = bubblePosition(row, column)
			local button = Create("TextButton", {
				Name = "Bubble",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(x, y),
				Size = UDim2.fromOffset(DIAMETER, DIAMETER),
				BackgroundColor3 = bubbleFill,
				BackgroundTransparency = 0.05,
				AutoButtonColor = false,
				Text = "",
				ZIndex = 4,
				Parent = sheet,
			})
			UIUtil.Corner(button, UDim.new(1, 0))
			UIUtil.Gradient(button, ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(186, 218, 244)), 90)
			local stroke = UIUtil.Stroke(button, bubbleStroke, 1.5)
			local scale = Create("UIScale", { Parent = button })
			local shine = Create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				BorderSizePixel = 0,
				ZIndex = 5,
				Parent = button,
			})
			UIUtil.Corner(shine, UDim.new(1, 0))
			local bubble = { Button = button, Stroke = stroke, Scale = scale, Shine = shine, X = x, Y = y, Popped = false }
			resetBubble(bubble)
			table.insert(bubbles, bubble)

			ctx.Connect(button.MouseButton1Down, function()
				pop(bubble)
			end)
			-- Glisser en maintenant le clic (souris)
			ctx.Connect(button.MouseEnter, function()
				if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
					pop(bubble)
				end
			end)
		end
	end

	------------------------------------------------------------------
	-- Nouvelle feuille
	------------------------------------------------------------------
	regenerate = function()
		if regenerating then
			return
		end
		regenerating = true
		task.spawn(function()
			task.wait(0.35)
			if not ctx.IsAlive() then
				return
			end
			-- Message au milieu, visible pendant que la feuille glisse
			caption.Text = CAPTIONS[random:NextInteger(1, #CAPTIONS)]
			caption.TextTransparency = 0
			captionStroke.Transparency = 0
			local width = (container.Size.X.Offset > 0 and container.Size.X.Offset or 288) - 16
			UIUtil.Tween(sheet, 0.35, { Position = UDim2.fromOffset(-(width + 10), 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			ctx.Sound.Play("Open", 0.9)
			task.wait(0.75)
			if not ctx.IsAlive() then
				return
			end
			for _, bubble in ipairs(bubbles) do
				resetBubble(bubble)
			end
			poppedCount = 0
			sheet.Position = UDim2.fromOffset(width + 10, 0)
			UIUtil.Tween(sheet, 0.45, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Back)
			UIUtil.Tween(caption, 0.3, { TextTransparency = 1 })
			UIUtil.Tween(captionStroke, 0.3, { Transparency = 1 })
			task.wait(0.45)
			regenerating = false
		end)
	end

	-- Petite vague de "respiration" des bulles intactes (pour donner envie)
	task.spawn(function()
		while ctx.IsAlive() do
			task.wait(random:NextNumber(4, 7))
			if not ctx.IsAlive() then
				break
			end
			if not regenerating then
				for index, bubble in ipairs(bubbles) do
					if not bubble.Popped then
						task.delay((index % COLUMNS) * 0.04, function()
							if ctx.IsAlive() and not bubble.Popped then
								bubble.Scale.Scale = 1.08
								UIUtil.Tween(bubble.Scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Sine)
							end
						end)
					end
				end
			end
		end
	end)
end

function BubbleWrap.Stop(_ctx)
	-- Tout est dans ctx.Container (détruit par le StimulusManager)
end

return BubbleWrap
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Casino</string>
            <string name="Source"><![CDATA[--[[
	Casino (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > Casino

	Machine à sous (UNIQUEMENT avec la Dopamine du jeu) dans le slot R2 :
	  - 3 rouleaux qui défilent (colonnes de symboles de Config.Casino),
	    ombrés en haut / en bas, avec une ligne de gain rouge ;
	  - jetons de mise (Config.Casino.BetFractions affichés en %) ;
	  - bouton "JOUER" + levier cliquable qui s'abaisse ;
	  - ampoules du fronton qui clignotent (en folie quand on gagne).
	Le résultat vient TOUJOURS du serveur (CasinoSpin) : les rouleaux se
	lancent tout de suite puis s'arrêtent un par un sur les symboles reçus
	(avec un petit suspense si les deux premiers sont identiques).
]]

local Casino = {}
Casino.Slot = "R2"

local REEL_W = 64
local REEL_H = 72
local CELL_H = 40 -- hauteur d'un symbole sur le rouleau
local STRIP_LENGTH = 24 -- symboles par bande (recyclés en boucle)
local MAX_SPEED = 20 -- symboles / seconde
local MIN_SPIN_TIME = 0.8

local CHIP_COLORS = {
	Color3.fromRGB(245, 245, 245),
	Color3.fromRGB(230, 50, 60),
	Color3.fromRGB(40, 120, 230),
	Color3.fromRGB(35, 35, 40),
}

local LOSS_TEXTS = {
	"Presque ! (non)",
	"La maison gagne toujours 🏠",
	"Retente, ça va passer… peut-être",
	"Ta Dopamine est partie en vacances 🏖️",
	"Aïe. On dira que c'était un test.",
	"Le cerveau a dit non 🧠❌",
	"C'était pour du beurre… ah non.",
	"Les rouleaux ont le trac aujourd'hui",
}

local WIN_TEXTS = {
	"GAGNÉ ! 🎉",
	"Ça tourne bien ! 💸",
	"La chance te sourit 😎",
	"Dopamine en cascade ! 🤑",
}

local ATTRACT_TEXTS = {
	"Tente ta chance ! 🍀",
	"Paire = remboursé (ou presque)",
	"Aucun Robux ici, promis 🤞",
}

-- Recul "Back" plus doux que la version standard (petit rebond à l'arrêt)
local function easeOutSoftBack(t: number): number
	local c1 = 0.9
	local c3 = c1 + 1
	local u = t - 1
	return 1 + c3 * u * u * u + c1 * u * u
end

function Casino.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local Create = UIUtil.Create
	local Format = ctx.Format
	local config = ctx.Config.Casino
	local symbols = config.Symbols
	local symbolsById = ctx.Config.CasinoSymbolsById
	local container: Frame = ctx.Container
	local random = Random.new()

	local width = container.Size.X.Offset > 0 and container.Size.X.Offset or 288
	local height = container.Size.Y.Offset > 0 and container.Size.Y.Offset or 180

	local gold = Theme.Colors.Gold
	local white = Color3.new(1, 1, 1)

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	local function getDopamine(): number
		local data = ctx.State.Data
		return (data and tonumber(data.Dopamine)) or 0
	end

	------------------------------------------------------------------
	-- Carrosserie de la machine
	------------------------------------------------------------------
	local card = Create("Frame", {
		Name = "Machine",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = white,
		BorderSizePixel = 0,
		ZIndex = 1,
		Parent = container,
	})
	UIUtil.Corner(card, 18)
	UIUtil.Stroke(card, Theme.Colors.CardBorder, 2)
	UIUtil.Gradient(card, ColorSequence.new(Color3.fromRGB(205, 36, 64), Color3.fromRGB(112, 12, 36)), 90)

	-- Liseré doré intérieur
	local trim = Create("Frame", {
		Size = UDim2.new(1, -8, 1, -8),
		Position = UDim2.fromOffset(4, 4),
		BackgroundTransparency = 1,
		ZIndex = 1,
		Parent = card,
	})
	UIUtil.Corner(trim, 15)
	UIUtil.Stroke(trim, gold, 1.5, 0.35)

	------------------------------------------------------------------
	-- Fronton : titre + ampoules
	------------------------------------------------------------------
	local bulbs = {}
	local bulbXs = { 18, 32, 46, 60, width - 60, width - 46, width - 32, width - 18 }
	for index, x in ipairs(bulbXs) do
		local bulb = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(x, 17),
			Size = UDim2.fromOffset(9, 9),
			BackgroundColor3 = gold,
			BorderSizePixel = 0,
			ZIndex = 3,
			Parent = card,
		})
		UIUtil.Corner(bulb, UDim.new(1, 0))
		UIUtil.Stroke(bulb, Color3.fromRGB(90, 20, 10), 1, 0.3)
		bulbs[index] = bulb
	end

	local titlePill = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(width / 2, 17),
		Size = UDim2.fromOffset(150, 20),
		BackgroundColor3 = Color3.fromRGB(45, 4, 16),
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = card,
	})
	UIUtil.Corner(titlePill, UDim.new(1, 0))
	UIUtil.Stroke(titlePill, gold, 1.5)
	UIUtil.Label({
		Text = "🎰 MACHINE À SOUS",
		Font = Theme.Fonts.Title,
		TextColor3 = gold,
		Size = UDim2.new(1, -10, 1, -4),
		Position = UDim2.fromOffset(5, 2),
		MaxTextSize = 14,
		ZIndex = 4,
		Parent = titlePill,
	})

	------------------------------------------------------------------
	-- Fenêtre des rouleaux
	------------------------------------------------------------------
	local windowX, windowY = 10, 31
	local windowW = REEL_W * 3 + 6 * 2 + 8
	local window = Create("Frame", {
		Name = "Window",
		Position = UDim2.fromOffset(windowX, windowY),
		Size = UDim2.fromOffset(windowW, REEL_H + 8),
		BackgroundColor3 = Color3.fromRGB(28, 8, 16),
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = card,
	})
	UIUtil.Corner(window, 10)
	local windowStroke = UIUtil.Stroke(window, gold, 2)

	local reels = {}
	local function wrap(index: number): number
		return ((index - 1) % STRIP_LENGTH) + 1
	end

	for r = 1, 3 do
		local reelFrame = Create("Frame", {
			Name = "Reel" .. r,
			Position = UDim2.fromOffset(4 + (r - 1) * (REEL_W + 6), 4),
			Size = UDim2.fromOffset(REEL_W, REEL_H),
			BackgroundColor3 = white,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			ZIndex = 3,
			Parent = window,
		})
		UIUtil.Corner(reelFrame, 6)
		UIUtil.Gradient(reelFrame, ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(215, 205, 195)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 252, 244)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(215, 205, 195)),
		}), 90)

		-- Halo de victoire derrière le symbole du milieu
		local glow = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(REEL_W / 2, REEL_H / 2),
			Size = UDim2.fromOffset(REEL_W - 6, CELL_H),
			BackgroundColor3 = gold,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 3,
			Parent = reelFrame,
		})
		UIUtil.Corner(glow, 8)

		-- Bande de symboles (mélangés)
		local strip = {}
		for i = 1, STRIP_LENGTH do
			strip[i] = symbols[((i - 1) % #symbols) + 1].Id
		end
		for i = STRIP_LENGTH, 2, -1 do
			local j = random:NextInteger(1, i)
			strip[i], strip[j] = strip[j], strip[i]
		end

		local labels = {}
		for k = 1, 4 do
			local label = UIUtil.Label({
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(REEL_W, CELL_H),
				Position = UDim2.fromOffset(REEL_W / 2, REEL_H / 2),
				Font = Theme.Fonts.Title,
				MaxTextSize = 32,
				ZIndex = 4,
				Parent = reelFrame,
			})
			labels[k] = { Label = label, Shown = "" }
		end

		-- Ombre haut / bas pour l'effet "cylindre"
		local shade = Create("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
			ZIndex = 5,
			Parent = reelFrame,
		})
		Create("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.3),
				NumberSequenceKeypoint.new(0.3, 1),
				NumberSequenceKeypoint.new(0.7, 1),
				NumberSequenceKeypoint.new(1, 0.3),
			}),
			Parent = shade,
		})

		reels[r] = {
			Frame = reelFrame,
			Glow = glow,
			Strip = strip,
			Labels = labels,
			Pos = random:NextInteger(1, STRIP_LENGTH),
			Speed = 0,
			Mode = "idle", -- "idle" | "spin" | "stop"
			StopFrom = 0,
			StopTo = 0,
			StopT = 0,
			StopDur = 1,
			Scale = Create("UIScale", { Parent = reelFrame }),
		}
	end

	-- Ligne de gain
	local payline = Create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 2, 0.5, 0),
		Size = UDim2.new(1, -4, 0, 2),
		BackgroundColor3 = Theme.Colors.Red,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		ZIndex = 6,
		Parent = window,
	})

	-- Affiche la bande d'un rouleau selon sa position (symbole `Pos` au centre)
	local function renderReel(reel)
		local base = math.floor(reel.Pos)
		local blur = reel.Speed > 8
		for k = 1, 4 do
			local index = base - 1 + (k - 1)
			local entry = reel.Labels[k]
			local label = entry.Label
			local id = reel.Strip[wrap(index)]
			if entry.Shown ~= id then
				entry.Shown = id
				local symbol = symbolsById[id]
				label.Text = symbol and symbol.Icon or "?"
			end
			-- Les indices plus grands sont au-dessus : la bande descend
			label.Position = UDim2.fromOffset(REEL_W / 2, REEL_H / 2 - (index - reel.Pos) * CELL_H)
			label.TextTransparency = blur and 0.35 or 0
		end
	end

	for _, reel in ipairs(reels) do
		renderReel(reel)
	end

	------------------------------------------------------------------
	-- Levier
	------------------------------------------------------------------
	local leverX = windowX + windowW + (width - (windowX + windowW)) / 2 - 2
	local leverBottom = 104
	local knobTop = 42
	local track = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromOffset(leverX, 38),
		Size = UDim2.fromOffset(10, leverBottom - 38 + 4),
		BackgroundColor3 = Color3.fromRGB(40, 8, 18),
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = card,
	})
	UIUtil.Corner(track, UDim.new(1, 0))
	local stick = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromOffset(leverX, leverBottom),
		Size = UDim2.fromOffset(5, leverBottom - knobTop),
		BackgroundColor3 = Color3.fromRGB(210, 210, 220),
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = card,
	})
	UIUtil.Gradient(stick, ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(140, 140, 150)), 0)
	local knob = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(leverX, knobTop),
		Size = UDim2.fromOffset(22, 22),
		BackgroundColor3 = Theme.Colors.Red,
		BorderSizePixel = 0,
		ZIndex = 4,
		Parent = card,
	})
	UIUtil.Corner(knob, UDim.new(1, 0))
	UIUtil.Stroke(knob, Color3.fromRGB(80, 0, 10), 1.5)
	UIUtil.Gradient(knob, ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(150, 150, 150)), 60)
	local shine = Create("Frame", {
		Position = UDim2.fromOffset(5, 4),
		Size = UDim2.fromOffset(7, 5),
		BackgroundColor3 = white,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = knob,
	})
	UIUtil.Corner(shine, UDim.new(1, 0))
	local leverCap = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(leverX, leverBottom + 2),
		Size = UDim2.fromOffset(24, 12),
		BackgroundColor3 = gold,
		BorderSizePixel = 0,
		ZIndex = 4,
		Parent = card,
	})
	UIUtil.Corner(leverCap, 4)
	UIUtil.Stroke(leverCap, Color3.fromRGB(90, 50, 0), 1)
	local leverButton = Create("TextButton", {
		Name = "Lever",
		Position = UDim2.fromOffset(leverX - 20, 28),
		Size = UDim2.fromOffset(40, leverBottom - 28 + 12),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 8,
		Parent = card,
	})

	local function pullLever()
		UIUtil.Tween(knob, 0.14, { Position = UDim2.fromOffset(leverX, leverBottom - 10) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		UIUtil.Tween(stick, 0.14, { Size = UDim2.fromOffset(5, 10) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(0.16, function()
			if knob.Parent and stick.Parent then
				UIUtil.Tween(knob, 0.7, { Position = UDim2.fromOffset(leverX, knobTop) }, Enum.EasingStyle.Elastic)
				UIUtil.Tween(stick, 0.7, { Size = UDim2.fromOffset(5, leverBottom - knobTop) }, Enum.EasingStyle.Elastic)
			end
		end)
	end

	------------------------------------------------------------------
	-- Ligne d'info (mise, résultat, blagues)
	------------------------------------------------------------------
	local info = UIUtil.Label({
		Name = "Info",
		Text = "",
		Font = Theme.Fonts.Title,
		TextColor3 = white,
		Position = UDim2.fromOffset(10, 114),
		Size = UDim2.new(1, -20, 0, 18),
		MaxTextSize = 14,
		ZIndex = 3,
		Parent = card,
	})
	local infoStroke = UIUtil.Stroke(info, Color3.fromRGB(60, 0, 15), 1.5)
	infoStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	local infoLockUntil = 0

	local function setInfo(text: string, color: Color3?, lockSeconds: number?)
		info.Text = text
		info.TextColor3 = color or white
		if lockSeconds then
			infoLockUntil = os.clock() + lockSeconds
		end
	end

	------------------------------------------------------------------
	-- Jetons de mise + bouton JOUER
	------------------------------------------------------------------
	local fractions = config.BetFractions or { 0.01 }
	local selected = math.min(1, #fractions)
	local chips = {}
	local rowY = height - 40
	local chipW = 40
	local chipGap = 5

	local function percentText(fraction: number): string
		local percent = fraction * 100
		local rounded = math.floor(percent + 0.5)
		if math.abs(percent - rounded) < 1e-6 then
			return tostring(rounded) .. "%"
		end
		return string.format("%.1f%%", percent)
	end

	local function currentBet(): number
		local fraction = fractions[selected] or 0.01
		return math.max(config.MinBet or 1, math.floor(getDopamine() * fraction))
	end

	local function refreshChips()
		for index, chip in ipairs(chips) do
			local isSelected = index == selected
			chip.Stroke.Color = isSelected and gold or Color3.fromRGB(30, 30, 30)
			chip.Stroke.Thickness = isSelected and 3 or 1.5
			UIUtil.Tween(chip.Scale, 0.2, { Scale = isSelected and 1.1 or 0.94 }, Enum.EasingStyle.Back)
		end
	end

	for index, fraction in ipairs(fractions) do
		if index > 4 then
			break -- pas la place pour plus de 4 jetons
		end
		local color = CHIP_COLORS[index] or CHIP_COLORS[1]
		local chip = Create("TextButton", {
			Name = "Chip" .. index,
			Position = UDim2.fromOffset(9 + (index - 1) * (chipW + chipGap), rowY),
			Size = UDim2.fromOffset(chipW, 30),
			BackgroundColor3 = color,
			AutoButtonColor = false,
			Font = Theme.Fonts.Number,
			Text = percentText(fraction),
			TextColor3 = Theme.ContrastText(color),
			TextSize = 14,
			ZIndex = 4,
			Parent = card,
		})
		UIUtil.Corner(chip, UDim.new(1, 0))
		local stroke = UIUtil.Stroke(chip, Color3.fromRGB(30, 30, 30), 1.5)
		-- Petit pointillé de jeton de poker (bordure intérieure en tirets)
		local ring = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(1, -8, 1, -8),
			BackgroundTransparency = 1,
			ZIndex = 4,
			Parent = chip,
		})
		UIUtil.Corner(ring, UDim.new(1, 0))
		UIUtil.Stroke(ring, Theme.ContrastText(color), 1, 0.6)
		local scale = Create("UIScale", { Scale = 0.94, Parent = chip })
		chips[index] = { Button = chip, Stroke = stroke, Scale = scale }

		ctx.Connect(chip.Activated, function()
			if selected == index then
				return
			end
			selected = index
			refreshChips()
			ctx.Sound.Play("Click", 1.3 + index * 0.08)
			setInfo("Mise : " .. Format.Format(currentBet()) .. " Dopamine", gold, 1.5)
		end)
	end
	refreshChips()

	local playButton = UIUtil.NeonButton({
		Name = "Play",
		Text = "JOUER",
		Color = gold,
		Size = UDim2.fromOffset(width - (9 + 4 * (chipW + chipGap)) - 9, 32),
		Position = UDim2.fromOffset(9 + 4 * (chipW + chipGap), rowY - 1),
		MaxTextSize = 18,
		ZIndex = 4,
		Parent = card,
	})

	-- Fermé (Config.Casino.Enabled = false)
	local enabled = config.Enabled ~= false
	if not enabled then
		UIUtil.SetButtonEnabled(playButton, false)
		local closed = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(windowX + windowW / 2, windowY + (REEL_H + 8) / 2),
			Size = UDim2.fromOffset(windowW + 10, 30),
			Rotation = -8,
			BackgroundColor3 = Theme.Colors.Yellow,
			BorderSizePixel = 0,
			ZIndex = 9,
			Parent = card,
		})
		UIUtil.Stroke(closed, Theme.Colors.Border, 2)
		UIUtil.Label({
			Text = "🚧 FERMÉ POUR TRAVAUX 🚧",
			Font = Theme.Fonts.Title,
			TextColor3 = Theme.Colors.TextDark,
			Size = UDim2.new(1, -8, 1, -6),
			Position = UDim2.fromOffset(4, 3),
			MaxTextSize = 16,
			ZIndex = 10,
			Parent = closed,
		})
		setInfo("Revenez plus tard (ou jamais) 😴", white)
	end

	------------------------------------------------------------------
	-- Animation (rouleaux, ampoules)
	------------------------------------------------------------------
	local partyUntil = 0
	local bulbClock = 0
	local bulbStep = 0
	local elapsed = 0
	local partyColors = { Theme.Colors.Yellow, Theme.Colors.Cyan, Theme.Colors.Pink, Theme.Colors.Green, white }

	ctx.OnRender(function(dt: number)
		elapsed += dt
		for _, reel in ipairs(reels) do
			if reel.Mode == "spin" then
				reel.Speed = math.min(MAX_SPEED, reel.Speed + dt * 70)
				reel.Pos += reel.Speed * dt
				renderReel(reel)
			elseif reel.Mode == "stop" then
				reel.StopT += dt
				local t = math.min(1, reel.StopT / reel.StopDur)
				reel.Pos = reel.StopFrom + (reel.StopTo - reel.StopFrom) * easeOutSoftBack(t)
				reel.Speed = MAX_SPEED * (1 - t)
				if t >= 1 then
					reel.Pos = reel.StopTo
					reel.Speed = 0
					reel.Mode = "idle"
					ctx.Sound.Play("SlotSpin", 0.9 + random:NextNumber(0, 0.3))
					reel.Scale.Scale = 1.06
					UIUtil.Tween(reel.Scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
				end
				renderReel(reel)
			end
		end

		-- Ampoules : chenillard calme, ou arc-en-ciel rapide en cas de gain
		local party = os.clock() < partyUntil
		bulbClock += dt
		local interval = party and 0.07 or 0.35
		if bulbClock >= interval then
			bulbClock = 0
			bulbStep += 1
			for index, bulb in ipairs(bulbs) do
				if party then
					bulb.BackgroundColor3 = partyColors[((index + bulbStep) % #partyColors) + 1]
					bulb.BackgroundTransparency = 0
				else
					local on = (index + bulbStep) % 2 == 0
					bulb.BackgroundColor3 = gold
					bulb.BackgroundTransparency = on and 0 or 0.65
				end
			end
		end

		-- Lueur de la ligne de gain
		payline.BackgroundTransparency = 0.35 + math.sin(elapsed * 3) * 0.15
	end)

	------------------------------------------------------------------
	-- Partie
	------------------------------------------------------------------
	local spinning = false

	local function stopReel(reel, id: string, extraDelay: number?)
		local base = math.floor(reel.Pos)
		local target = base + 5 + (extraDelay and 3 or 0)
		reel.Strip[wrap(target)] = id
		reel.StopFrom = reel.Pos
		reel.StopTo = target
		reel.StopT = 0
		local distance = target - reel.Pos
		reel.StopDur = math.clamp(3.9 * distance / math.max(reel.Speed, 1), 0.5, extraDelay and 2 or 1.3)
		reel.Mode = "stop"
	end

	local function allStopped(): boolean
		for _, reel in ipairs(reels) do
			if reel.Mode ~= "idle" then
				return false
			end
		end
		return true
	end

	-- Attend `seconds` ; renvoie false si le stimulus a été arrêté entre-temps
	local function waitAlive(seconds: number): boolean
		local finish = os.clock() + seconds
		while os.clock() < finish do
			if not ctx.IsAlive() then
				return false
			end
			task.wait()
		end
		return ctx.IsAlive()
	end

	local function randomLosingIds(): { string }
		-- Trois symboles différents (si possible) pour ne pas mentir au joueur
		local pool = {}
		for _, symbol in ipairs(symbols) do
			table.insert(pool, symbol.Id)
		end
		for i = #pool, 2, -1 do
			local j = random:NextInteger(1, i)
			pool[i], pool[j] = pool[j], pool[i]
		end
		return { pool[1], pool[2] or pool[1], pool[3] or pool[1] }
	end

	local function highlightWinners(ids: { string })
		local counts = {}
		for _, id in ipairs(ids) do
			counts[id] = (counts[id] or 0) + 1
		end
		for index, reel in ipairs(reels) do
			if (counts[ids[index]] or 0) >= 2 then
				local glow = reel.Glow
				task.spawn(function()
					for _ = 1, 4 do
						if not glow.Parent then
							return
						end
						UIUtil.Tween(glow, 0.18, { BackgroundTransparency = 0.25 })
						task.wait(0.2)
						if not glow.Parent then
							return
						end
						UIUtil.Tween(glow, 0.18, { BackgroundTransparency = 0.8 })
						task.wait(0.2)
					end
					if glow.Parent then
						UIUtil.Tween(glow, 0.3, { BackgroundTransparency = 1 })
					end
				end)
			end
		end
	end

	local function showResult(result)
		local bet = tonumber(result.Bet) or 0
		local payout = tonumber(result.Payout) or 0
		local multiplier = tonumber(result.Multiplier) or 0
		local center = UDim2.fromOffset(windowX + windowW / 2, windowY + REEL_H / 2)

		if payout > bet then
			highlightWinners(result.Reels)
			partyUntil = os.clock() + (multiplier >= 25 and 3.5 or 1.8)
			ctx.Sound.Play("SlotWin", multiplier >= 25 and 1.1 or 1)
			local text = "+" .. Format.Format(payout)
			ctx.FloatText(card, center, text, gold, multiplier >= 10 and 34 or 26)
			setInfo(WIN_TEXTS[random:NextInteger(1, #WIN_TEXTS)] .. " " .. Format.Multiplier(multiplier), gold, 3)
			UIUtil.Tween(windowStroke, 0.1, { Color = white, Thickness = 4 })
			task.delay(0.6, function()
				if windowStroke.Parent then
					UIUtil.Tween(windowStroke, 0.4, { Color = gold, Thickness = 2 })
				end
			end)
			if effectsOn() then
				ctx.Effects.Burst(card, center, gold, multiplier >= 10 and 18 or 10)
			end
			if multiplier >= 25 then
				ctx.Sound.Play("Jackpot", 1)
				ctx.Effects.Flash(gold, 0.45)
				ctx.Effects.BigMessage("🎰 JACKPOT ! " .. text, gold, 2.5)
				if effectsOn() then
					ctx.Effects.Confetti(70)
				end
			elseif multiplier >= 6 and effectsOn() then
				ctx.Effects.Confetti(25)
			end
		elseif payout > 0 then
			highlightWinners(result.Reels)
			ctx.Sound.Play("Cash", 0.8)
			ctx.FloatText(card, center, "+" .. Format.Format(payout), white, 22)
			setInfo("Remboursé en partie (" .. Format.Multiplier(multiplier) .. ") 🙃", Color3.fromRGB(255, 225, 160), 2.5)
		else
			ctx.Sound.Play("Error", 0.75)
			UIUtil.Shake(window)
			setInfo(LOSS_TEXTS[random:NextInteger(1, #LOSS_TEXTS)], Color3.fromRGB(255, 205, 205), 2.5)
		end
	end

	local function play()
		if spinning or not ctx.IsAlive() then
			return
		end
		if not enabled then
			ctx.Sound.Play("Error", 1)
			UIUtil.Shake(playButton)
			return
		end
		local minBet = config.MinBet or 1
		if getDopamine() < minBet then
			ctx.Sound.Play("Error", 1)
			UIUtil.Shake(playButton)
			setInfo("Il faut au moins " .. Format.Format(minBet) .. " Dopamine 😬", Color3.fromRGB(255, 205, 205), 2)
			return
		end

		spinning = true
		UIUtil.SetButtonEnabled(playButton, false)
		pullLever()
		ctx.Sound.Play("SlotSpin", 1)
		for _, reel in ipairs(reels) do
			reel.Mode = "spin"
			reel.Glow.BackgroundTransparency = 1
		end
		setInfo("Ça tourne… 🎲", white)

		local fraction = fractions[selected] or fractions[1]
		task.spawn(function()
			local started = os.clock()
			local callOk, success, result = pcall(function()
				return ctx.Net.Function("CasinoSpin"):InvokeServer(fraction)
			end)
			if not waitAlive(math.max(0, MIN_SPIN_TIME - (os.clock() - started))) then
				return
			end

			local valid = callOk and success == true and type(result) == "table" and type(result.Reels) == "table"
			local ids = {}
			if valid then
				for index = 1, 3 do
					local id = result.Reels[index]
					if type(id) ~= "string" or not symbolsById[id] then
						id = symbols[1].Id
					end
					ids[index] = id
				end
			else
				ids = randomLosingIds()
			end

			-- Arrêts successifs (suspense si les deux premiers sont identiques)
			for index = 1, 3 do
				local suspense = valid and index == 3 and ids[1] == ids[2]
				if suspense then
					setInfo("🤞 Allez… allez…", Theme.Colors.Yellow)
					partyUntil = os.clock() + 1
				end
				stopReel(reels[index], ids[index], suspense and 1 or nil)
				if not waitAlive(0.32) then
					return
				end
			end
			while not allStopped() do
				if not ctx.IsAlive() then
					return
				end
				task.wait()
			end

			if valid then
				showResult(result)
			else
				local message = (callOk and type(result) == "string") and result or "La machine fait grève 🔧"
				ctx.Sound.Play("Error", 1)
				UIUtil.Shake(window)
				setInfo(message, Color3.fromRGB(255, 205, 205), 2.5)
			end

			spinning = false
			UIUtil.SetButtonEnabled(playButton, true)
		end)
	end

	ctx.Connect(playButton.Activated, play)
	ctx.Connect(leverButton.Activated, play)

	------------------------------------------------------------------
	-- Ligne d'info au repos : mise actuelle / petites annonces
	------------------------------------------------------------------
	local bestSymbol = symbols[1]
	for _, symbol in ipairs(symbols) do
		if (symbol.Triple or 0) > (bestSymbol.Triple or 0) then
			bestSymbol = symbol
		end
	end
	local attract = table.clone(ATTRACT_TEXTS)
	if bestSymbol then
		table.insert(attract, "Triple " .. bestSymbol.Icon .. " = " .. Format.Multiplier(bestSymbol.Triple or 0) .. " !")
	end

	task.spawn(function()
		local tick = 0
		while ctx.IsAlive() do
			if enabled and not spinning and os.clock() >= infoLockUntil then
				tick += 1
				if tick % 8 == 0 then
					setInfo(attract[random:NextInteger(1, #attract)], Color3.fromRGB(255, 230, 170), 2)
				else
					setInfo("Mise : " .. Format.Format(currentBet()) .. " Dopamine", white)
				end
			end
			task.wait(0.5)
		end
	end)
end

return Casino
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">CursorTrail</string>
            <string name="Source"><![CDATA[--[[
	CursorTrail (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > CursorTrail

	Traînée magique : des étincelles arc-en-ciel suivent la souris (et le
	doigt sur mobile / tablette), tournoient, tombent un peu et s'éteignent.
	Chaque clic / toucher fait une petite gerbe d'étoiles.
	Purement visuel, non cliquable. 40 étincelles maximum, recyclées.
]]

local UserInputService = game:GetService("UserInputService")

local CursorTrail = {}
CursorTrail.Slot = "Overlay"

local MAX_SPARKLES = 40
local EMIT_SPACING = 14 -- distance (pixels "design") entre deux étincelles
local MAX_PER_FRAME = 3
local EMOJI_CHANCE = 0.18 -- parfois un ✨ / ⭐ au lieu d'un losange
local EMOJIS = { "✨", "⭐", "💫" }

function CursorTrail.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local container: Frame = ctx.Container
	local random = Random.new()

	local pool = {}
	local nextSlot = 1
	local hue = random:NextNumber()

	local pointer: Vector2? = nil -- dernière position connue (pixels écran réels)
	local lastEmit: Vector2? = nil
	local burstQueue = {} -- positions des clics à traiter

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	-- Crée toutes les étincelles une seule fois (recyclage circulaire)
	for i = 1, MAX_SPARKLES do
		local label = UIUtil.Create("TextLabel", {
			Name = "Sparkle",
			Size = UDim2.fromOffset(10, 10),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Font = Theme.Fonts.Body,
			Text = "",
			TextSize = 18,
			Active = false,
			Selectable = false,
			Visible = false,
			ZIndex = 60,
			Parent = container,
		})
		UIUtil.Corner(label, 3)
		local stroke = UIUtil.Stroke(label, Theme.Colors.Border, 1, 0.55)
		pool[i] = {
			Label = label,
			Stroke = stroke,
			Alive = false,
			Life = 0,
			MaxLife = 1,
			Pos = Vector2.zero,
			Vel = Vector2.zero,
			Size = 10,
			Spin = 0,
			Emoji = false,
		}
	end

	-- Émet une étincelle à `position` (pixels écran réels)
	local function emit(position: Vector2, velocity: Vector2, big: boolean?)
		local sparkle = pool[nextSlot]
		nextSlot = nextSlot % MAX_SPARKLES + 1

		hue = (hue + 0.035) % 1
		local color = Color3.fromHSV(hue, 0.8, 1)
		local isEmoji = random:NextNumber() < EMOJI_CHANCE
		local size = big and random:NextNumber(12, 18) or random:NextNumber(7, 13)

		sparkle.Alive = true
		sparkle.Emoji = isEmoji
		sparkle.Pos = position
		sparkle.Vel = velocity
		sparkle.Life = 0
		sparkle.MaxLife = random:NextNumber(0.45, 0.8)
		sparkle.Size = isEmoji and size * 1.8 or size
		sparkle.Spin = random:NextNumber(-360, 360)

		local label: TextLabel = sparkle.Label
		label.Rotation = 45
		if isEmoji then
			label.Text = EMOJIS[random:NextInteger(1, #EMOJIS)]
			label.TextSize = math.floor(sparkle.Size)
			label.TextTransparency = 0
			label.BackgroundTransparency = 1
			sparkle.Stroke.Enabled = false
		else
			label.Text = ""
			label.BackgroundColor3 = color
			label.BackgroundTransparency = 0
			sparkle.Stroke.Enabled = true
			sparkle.Stroke.Transparency = 0.55
		end
		label.Visible = true
	end

	-- Position du pointeur (même repère que AbsolutePosition)
	ctx.Connect(UserInputService.InputChanged, function(input: InputObject)
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseMovement or kind == Enum.UserInputType.Touch then
			pointer = Vector2.new(input.Position.X, input.Position.Y)
		end
	end)
	ctx.Connect(UserInputService.InputBegan, function(input: InputObject)
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch then
			local position = Vector2.new(input.Position.X, input.Position.Y)
			if kind == Enum.UserInputType.Touch then
				-- Nouveau doigt : pas de trait depuis l'ancienne position
				pointer = position
				lastEmit = position
			end
			if #burstQueue < 4 then
				table.insert(burstQueue, position)
			end
		end
	end)
	ctx.Connect(UserInputService.InputEnded, function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.Touch then
			pointer = nil
			lastEmit = nil
		end
	end)

	ctx.OnRender(function(dt: number)
		dt = math.min(dt, 0.1)
		local origin = container.AbsolutePosition
		local area = container.AbsoluteSize
		if area.X < 1 or area.Y < 1 then
			return
		end
		-- Pixels réels par pixel "design" (échelle de l'interface)
		local k = area.Y / 720
		local effects = effectsOn()

		-- Traînée : étincelles espacées le long du déplacement
		local current = pointer
		if current then
			if not lastEmit then
				lastEmit = current
			else
				local from = lastEmit :: Vector2
				local delta = current - from
				local distance = delta.Magnitude
				local spacing = EMIT_SPACING * k * (effects and 1 or 2.5)
				if distance >= spacing then
					local steps = math.min(MAX_PER_FRAME, math.floor(distance / spacing))
					for i = 1, steps do
						local point = from + delta * (i / steps)
						local drift = Vector2.new(random:NextNumber(-30, 30), random:NextNumber(-40, 10)) * k
						emit(point, drift - delta.Unit * 25 * k)
					end
					lastEmit = current
				end
			end
		end

		-- Gerbes de clic
		if #burstQueue > 0 then
			for _, position in ipairs(burstQueue) do
				local count = effects and 8 or 3
				local offset = random:NextNumber(0, math.pi * 2)
				for i = 1, count do
					local angle = offset + (i / count) * math.pi * 2
					local speed = random:NextNumber(110, 170) * k
					emit(position, Vector2.new(math.cos(angle), math.sin(angle)) * speed, true)
				end
			end
			table.clear(burstQueue)
		end

		-- Animation des étincelles vivantes
		local gravity = 160 * k
		for _, sparkle in ipairs(pool) do
			if sparkle.Alive then
				sparkle.Life += dt
				local ratio = sparkle.Life / sparkle.MaxLife
				local label: TextLabel = sparkle.Label
				if ratio >= 1 then
					sparkle.Alive = false
					label.Visible = false
				else
					sparkle.Vel = sparkle.Vel * (1 - math.min(1, 2.5 * dt)) + Vector2.new(0, gravity * dt)
					sparkle.Pos += sparkle.Vel * dt
					local relative = (sparkle.Pos - origin) / area
					label.Position = UDim2.fromScale(relative.X, relative.Y)
					label.Rotation += sparkle.Spin * dt
					-- Grossit vite puis rétrécit en s'éteignant
					local grow = ratio < 0.15 and (ratio / 0.15) or (1 - (ratio - 0.15) / 0.85)
					local size = math.max(1, sparkle.Size * (0.3 + 0.7 * grow))
					if sparkle.Emoji then
						label.TextSize = math.floor(size)
						label.Size = UDim2.fromOffset(size, size)
						label.TextTransparency = ratio * ratio
					else
						label.Size = UDim2.fromOffset(size, size)
						label.BackgroundTransparency = ratio * ratio
						sparkle.Stroke.Transparency = 0.55 + 0.45 * ratio
					end
				end
			end
		end
	end)
end

function CursorTrail.Stop(_ctx)
	-- Les étincelles sont dans ctx.Container (détruit par le StimulusManager)
end

return CursorTrail
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">DVD</string>
            <string name="Source"><![CDATA[--[[
	DVD (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > DVD

	Les logos "DOPA" qui rebondissent partout sur l'écran, façon vieil
	écran de veille (logo 100 % original dessiné en code : un disque
	brillant qui tourne + "DOPA" + une pastille "DISQUE").
	  - Trajectoires données par le SERVEUR (ClientState.DVDSetup) et
	    calculées avec DVDMath depuis l'heure serveur : fluide et identique
	    quel que soit le nombre d'images par seconde.
	  - À chaque rebond : nouvelle couleur, petit écrasement, "+X" flottant
	    (purement visuel, le serveur compte les rebonds lui-même) et son
	    "Bounce" si l'amélioration "DVDSound" est possédée.
	  - Coin touché : on prévient le serveur (DVDCorner), qui VÉRIFIE.
	  - Clic sur un logo : bonus (DVDClick), temps de recharge commun à
	    tous les logos (ils pâlissent pendant la recharge).
	  - Envoie la taille réelle du logo au serveur (DVDResize).
]]

local DVD = {}
DVD.Slot = "Overlay"

local RESIZE_INTERVAL = 0.6 -- temps minimum entre deux envois DVDResize
local COOLDOWN_FADE = 0.55 -- transparence des logos pendant la recharge
local MIN_SOUND_GAP = 0.07 -- évite la cacophonie avec 10 logos

-- Petites phrases quand un logo frôle un coin sans le toucher
local NEAR_MISS = { "presque... 😩", "à un pixel !", "noooon 😭", "si près...", "la prochaine ?", "argh !" }
local CORNER_TEXTS = { "COIN !!! 📀", "DANS LE COIN !!!", "PILE DANS LE COIN !" }

function DVD.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Theme = ctx.Theme
	local Config = ctx.Config
	local DVDMath = ctx.DVDMath
	local settings = Config.DVD
	local colors = settings.Colors
	local container: Frame = ctx.Container
	local random = Random.new()

	local logoSize: Vector2 = settings.LogoSize
	local useImage = settings.LogoImage ~= nil and settings.LogoImage ~= ""

	local logos = {} -- [index] = objet logo (voir createLogo)
	local cooldownUntil = 0
	local cooling = false
	local lastSoundTime = 0

	local function getData()
		return ctx.State.Data
	end

	local function effectsOn(): boolean
		local data = getData()
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	-- Sonde invisible de la taille d'un logo (sert à mesurer la taille réelle,
	-- sans être faussée par les animations d'écrasement)
	local probe = UIUtil.Create("Frame", {
		Name = "SizeProbe",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(logoSize.X, logoSize.Y),
		Visible = false,
		Parent = container,
	})

	-- Taille du logo en fraction de l'écran
	local function measure(): (number?, number?)
		local parentSize = container.AbsoluteSize
		local size = probe.AbsoluteSize
		if parentSize.X < 1 or parentSize.Y < 1 or size.X < 1 or size.Y < 1 then
			return nil, nil
		end
		return size.X / parentSize.X, size.Y / parentSize.Y
	end

	------------------------------------------------------------------
	-- Construction d'un logo
	------------------------------------------------------------------
	local function createLogo(index: number)
		local logo = {
			Index = index,
			Params = nil :: any,
			LastX = nil :: number?,
			LastY = nil :: number?,
			ColorIndex = ((index - 1) % #colors) + 1,
			Fades = {} :: { { any } }, -- { instance, propriété, valeur normale }
		}
		local color = colors[logo.ColorIndex]

		local button = UIUtil.Create("TextButton", {
			Name = "DVDLogo" .. index,
			Size = UDim2.fromOffset(logoSize.X, logoSize.Y),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			Visible = false,
			ZIndex = 5,
			Parent = container,
		})

		-- Corps visuel (le bouton garde sa taille, seul le corps s'écrase)
		local body = UIUtil.Create("Frame", {
			Name = "Body",
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			ZIndex = 5,
			Parent = button,
		})
		local bodyScale = UIUtil.Create("UIScale", { Scale = 0, Parent = body })
		logo.Button = button
		logo.Body = body
		logo.Scale = bodyScale

		if useImage then
			-- Image personnalisée (blanche, recolorée)
			local image = UIUtil.Create("ImageLabel", {
				BackgroundTransparency = 1,
				Size = UDim2.fromScale(1, 1),
				Image = settings.LogoImage,
				ImageColor3 = color,
				ScaleType = Enum.ScaleType.Fit,
				ZIndex = 6,
				Parent = body,
			})
			logo.Image = image
			table.insert(logo.Fades, { image, "ImageTransparency", 0 })
		else
			-- Disque brillant (à gauche)
			local discSize = math.floor(logoSize.Y * 0.78)
			local disc = UIUtil.Create("Frame", {
				Name = "Disc",
				Size = UDim2.fromOffset(discSize, discSize),
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 2, 0.5, 0),
				BackgroundColor3 = color,
				ZIndex = 6,
				Parent = body,
			})
			UIUtil.Corner(disc, UDim.new(1, 0))
			local discStroke = UIUtil.Stroke(disc, Theme.Colors.Border, 2, 0.15)
			-- Reflet arc-en-ciel qui tourne (effet "disque")
			local shine = UIUtil.Gradient(disc, ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
				ColorSequenceKeypoint.new(0.35, Color3.fromRGB(190, 190, 190)),
				ColorSequenceKeypoint.new(0.5, Color3.new(1, 1, 1)),
				ColorSequenceKeypoint.new(0.65, Color3.fromRGB(200, 200, 200)),
				ColorSequenceKeypoint.new(1, Color3.new(1, 1, 1)),
			}), 0)
			-- Sillon du disque
			local groove = UIUtil.Create("Frame", {
				Size = UDim2.fromScale(0.62, 0.62),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				BackgroundTransparency = 1,
				ZIndex = 7,
				Parent = disc,
			})
			UIUtil.Corner(groove, UDim.new(1, 0))
			local grooveStroke = UIUtil.Stroke(groove, Color3.new(1, 1, 1), 2, 0.45)
			-- Trou central
			local hole = UIUtil.Create("Frame", {
				Size = UDim2.fromScale(0.24, 0.24),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				BackgroundColor3 = Color3.new(1, 1, 1),
				ZIndex = 8,
				Parent = disc,
			})
			UIUtil.Corner(hole, UDim.new(1, 0))
			local holeStroke = UIUtil.Stroke(hole, Theme.Colors.Border, 1.5, 0.2)

			-- "DOPA" en gros
			local textLeft = discSize + 6
			local title = UIUtil.Label({
				Name = "Title",
				Text = "DOPA",
				Font = Theme.Fonts.Title,
				TextColor3 = color,
				Size = UDim2.new(1, -textLeft, 0.6, 0),
				Position = UDim2.new(0, textLeft, 0.02, 0),
				MaxTextSize = 44,
				ZIndex = 6,
				Parent = body,
			})
			local titleStroke = UIUtil.Stroke(title, Theme.Colors.Border, 2, 0.1)
			titleStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual

			-- Pastille "DISQUE"
			local pill = UIUtil.Create("Frame", {
				Name = "Pill",
				Size = UDim2.new(1, -textLeft - 2, 0.3, 0),
				Position = UDim2.new(0, textLeft, 0.64, 0),
				BackgroundColor3 = color,
				ZIndex = 6,
				Parent = body,
			})
			UIUtil.Corner(pill, UDim.new(1, 0))
			local pillStroke = UIUtil.Stroke(pill, Theme.Colors.Border, 1.5, 0.15)
			local pillText = UIUtil.Label({
				Text = "DISQUE",
				Font = Theme.Fonts.Title,
				TextColor3 = Theme.ContrastText(color),
				Size = UDim2.fromScale(0.9, 0.85),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				MaxTextSize = 16,
				ZIndex = 7,
				Parent = pill,
			})

			logo.Disc = disc
			logo.Shine = shine
			logo.Title = title
			logo.Pill = pill
			logo.PillText = pillText
			table.insert(logo.Fades, { disc, "BackgroundTransparency", 0 })
			table.insert(logo.Fades, { discStroke, "Transparency", 0.15 })
			table.insert(logo.Fades, { grooveStroke, "Transparency", 0.45 })
			table.insert(logo.Fades, { hole, "BackgroundTransparency", 0 })
			table.insert(logo.Fades, { holeStroke, "Transparency", 0.2 })
			table.insert(logo.Fades, { title, "TextTransparency", 0 })
			table.insert(logo.Fades, { titleStroke, "Transparency", 0.1 })
			table.insert(logo.Fades, { pill, "BackgroundTransparency", 0 })
			table.insert(logo.Fades, { pillStroke, "Transparency", 0.15 })
			table.insert(logo.Fades, { pillText, "TextTransparency", 0 })
		end

		-- Survol : le logo gonfle un peu (PC)
		ctx.Connect(button.MouseEnter, function()
			if not cooling then
				UIUtil.Tween(bodyScale, 0.15, { Scale = 1.08 }, Enum.EasingStyle.Back)
			end
		end)
		ctx.Connect(button.MouseLeave, function()
			UIUtil.Tween(bodyScale, 0.15, { Scale = 1 })
		end)

		-- Clic : bonus avec temps de recharge commun
		ctx.Connect(button.Activated, function()
			if not ctx.IsAlive() then
				return
			end
			local center = UDim2.new(button.Position.X.Scale, logoSize.X / 2, button.Position.Y.Scale, logoSize.Y / 2)
			if os.clock() < cooldownUntil then
				-- Encore en recharge : petit "non" et le temps restant
				UIUtil.Shake(body)
				ctx.FloatText(container, center, "⏳ " .. math.ceil(cooldownUntil - os.clock()) .. " s", Theme.Colors.TextDim, 20)
				return
			end
			cooldownUntil = os.clock() + settings.ClickCooldown
			ctx.Net.Event("DVDClick"):FireServer(logo.Index)
			ctx.Sound.Play("Click", 1.3)
			bodyScale.Scale = 0.8
			UIUtil.Tween(bodyScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
			if effectsOn() then
				ctx.Effects.Burst(container, center, colors[logo.ColorIndex], 14)
			end
		end)

		return logo
	end

	-- Applique une couleur à tout le logo (petite transition)
	local function applyColor(logo, color: Color3)
		if logo.Image then
			UIUtil.Tween(logo.Image, 0.15, { ImageColor3 = color })
			return
		end
		UIUtil.Tween(logo.Disc, 0.15, { BackgroundColor3 = color })
		UIUtil.Tween(logo.Title, 0.15, { TextColor3 = color })
		UIUtil.Tween(logo.Pill, 0.15, { BackgroundColor3 = color })
		logo.PillText.TextColor3 = Theme.ContrastText(color)
	end

	local function nextColor(logo)
		-- Jamais deux fois la même couleur de suite
		local newIndex = random:NextInteger(1, #colors)
		if newIndex == logo.ColorIndex then
			newIndex = newIndex % #colors + 1
		end
		logo.ColorIndex = newIndex
		applyColor(logo, colors[newIndex])
	end

	local function setFaded(faded: boolean)
		for _, logo in ipairs(logos) do
			for _, entry in ipairs(logo.Fades) do
				local target = faded and math.max(entry[3], COOLDOWN_FADE) or entry[3]
				UIUtil.Tween(entry[1], 0.25, { [entry[2]] = target })
			end
		end
	end

	------------------------------------------------------------------
	-- Envoi de la taille au serveur (limité à 1 envoi / 0,6 s)
	------------------------------------------------------------------
	local lastSentW, lastSentH = 0, 0
	local lastSendTime = -math.huge
	local pendingSend = false
	local pendingForce = false

	local function sendSize(force: boolean)
		if not ctx.IsAlive() or #logos == 0 then
			return
		end
		local w, h = measure()
		if not w or not h then
			return
		end
		if not force and math.abs(w - lastSentW) < 0.002 and math.abs(h - lastSentH) < 0.002 then
			return
		end
		lastSentW, lastSentH = w, h
		lastSendTime = os.clock()
		ctx.Net.Event("DVDResize"):FireServer(w, h)
	end

	local function requestSend(force: boolean)
		pendingForce = pendingForce or force
		if pendingSend then
			return
		end
		local wait = RESIZE_INTERVAL - (os.clock() - lastSendTime)
		pendingSend = true
		-- Toujours un petit délai : laisse le temps aux tailles de se stabiliser
		task.delay(math.max(0.1, wait), function()
			pendingSend = false
			local f = pendingForce
			pendingForce = false
			sendSize(f)
		end)
	end

	------------------------------------------------------------------
	-- Synchronisation avec DVDSetup
	------------------------------------------------------------------
	local function applySetup(setup)
		if not ctx.IsAlive() then
			return
		end
		local list = (setup and setup.Logos) or {}
		local previousCount = #logos

		-- Crée les logos manquants
		for index = #logos + 1, #list do
			local logo = createLogo(index)
			logos[index] = logo
			UIUtil.Tween(logo.Scale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
			if cooling then
				for _, entry in ipairs(logo.Fades) do
					(entry[1] :: any)[entry[2]] = math.max(entry[3], COOLDOWN_FADE)
				end
			end
		end
		-- Retire les logos en trop
		for index = #logos, #list + 1, -1 do
			local logo = logos[index]
			logos[index] = nil
			local button = logo.Button
			UIUtil.Tween(logo.Scale, 0.25, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			task.delay(0.3, function()
				button:Destroy()
			end)
		end
		-- Nouveaux paramètres de trajectoire
		for index, params in ipairs(list) do
			local logo = logos[index]
			logo.Params = params
			logo.LastX, logo.LastY = nil, nil
			logo.Button.Visible = true
		end

		if #list > 0 then
			-- Premier logo (ou retour après la détox) : on envoie la vraie taille
			-- si le serveur utilise une taille différente
			local w, h = measure()
			local first = list[1]
			local mismatch = w ~= nil
				and h ~= nil
				and type(first.W) == "number"
				and type(first.H) == "number"
				and (math.abs(first.W - w) > 0.003 or math.abs(first.H - h) > 0.003)
			requestSend(previousCount == 0 and mismatch)
		end
	end

	ctx.Connect(ctx.State.DVDSetupChanged, applySetup)
	ctx.Connect(container:GetPropertyChangedSignal("AbsoluteSize"), function()
		requestSend(false)
	end)
	applySetup(ctx.State.DVDSetup)

	------------------------------------------------------------------
	-- Rebonds (visuels)
	------------------------------------------------------------------
	local function onBounce(logo, x: number, y: number, w: number, h: number, bouncedX: boolean, bouncedY: boolean)
		nextColor(logo)

		-- Écrasement contre le mur
		local scale = logo.Scale
		scale.Scale = bouncedX and 0.88 or 0.92
		UIUtil.Tween(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)

		-- Point de contact (au milieu du bord touché)
		local contactX = x + w / 2
		local contactY = y + h / 2
		if bouncedX then
			contactX = (x < 0.5 - w / 2) and x or (x + w)
		end
		if bouncedY and not bouncedX then
			contactY = (y < 0.5 - h / 2) and y or (y + h)
		end

		local data = getData()
		local value = data and data.BounceValue or 0
		if value > 0 then
			ctx.FloatText(
				container,
				UDim2.fromScale(x + w / 2, y + h / 2),
				"+" .. ctx.Format.Format(value),
				colors[logo.ColorIndex],
				24
			)
		end
		if effectsOn() then
			ctx.Effects.Burst(container, UDim2.fromScale(contactX, contactY), colors[logo.ColorIndex], 4)
		end

		if ctx.HasFeature("DVDSound") then
			local now = os.clock()
			if now - lastSoundTime >= MIN_SOUND_GAP then
				lastSoundTime = now
				ctx.Sound.Play("Bounce", random:NextNumber(1.25, 1.75))
			end
		end
	end

	local function onCorner(logo, x: number, y: number, w: number, h: number)
		local center = UDim2.fromScale(x + w / 2, y + h / 2)
		ctx.FloatText(container, center, CORNER_TEXTS[random:NextInteger(1, #CORNER_TEXTS)], Theme.Colors.Gold, 44)
		if effectsOn() then
			ctx.Effects.Burst(container, center, Theme.Colors.Gold, 30)
			ctx.Effects.Burst(container, center, nil, 20)
		end
		local scale = logo.Scale
		scale.Scale = 1.5
		UIUtil.Tween(scale, 0.6, { Scale = 1 }, Enum.EasingStyle.Elastic)
	end

	------------------------------------------------------------------
	-- Boucle d'affichage
	------------------------------------------------------------------
	local tolerance = settings.CornerTolerance
	ctx.OnRender(function()
		if #logos == 0 then
			return
		end
		local t = workspace:GetServerTimeNow()
		local w, h = measure()
		w = w or (logoSize.X / 1280)
		h = h or (logoSize.Y / 720)

		-- Fin de la recharge : les logos reprennent leurs couleurs
		local isCooling = os.clock() < cooldownUntil
		if isCooling ~= cooling then
			cooling = isCooling
			setFaded(isCooling)
			if not isCooling then
				for _, logo in ipairs(logos) do
					logo.Scale.Scale = 1.15
					UIUtil.Tween(logo.Scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
				end
			end
		end

		for index, logo in ipairs(logos) do
			local params = logo.Params
			if params then
				local x, y = DVDMath.Position(params, t)
				logo.Button.Position = UDim2.fromScale(x, y)
				if logo.Shine then
					logo.Shine.Rotation = (t * 140 + index * 50) % 360
				end

				local indexX, indexY = DVDMath.BounceIndex(params, t)
				local lastX, lastY = logo.LastX, logo.LastY
				local bouncedX = lastX ~= nil and indexX ~= lastX
				local bouncedY = lastY ~= nil and indexY ~= lastY

				if bouncedX or bouncedY then
					onBounce(logo, x, y, w, h, bouncedX, bouncedY)
				end

				if bouncedX and lastX then
					-- Numéro du bord touché = le plus grand des deux segments
					local k = math.max(indexX, lastX)
					if DVDMath.IsCornerAtBounceX(params, k, tolerance) then
						ctx.Net.Event("DVDCorner"):FireServer(index, k)
						onCorner(logo, x, y, w, h)
					else
						-- Frôlé ? (à moins de 3 % d'un coin)
						local _, rangeY = DVDMath.Ranges(params)
						if math.min(y, rangeY - y) < 0.03 then
							ctx.FloatText(
								container,
								UDim2.fromScale(x + w / 2, y + h / 2 + 0.06),
								NEAR_MISS[random:NextInteger(1, #NEAR_MISS)],
								Theme.Colors.TextDim,
								22
							)
						end
					end
				end

				logo.LastX, logo.LastY = indexX, indexY
			end
		end
	end)

	------------------------------------------------------------------
	-- Bonus confirmé par le serveur : "+X" au niveau du logo cliqué
	------------------------------------------------------------------
	ctx.OnBonus("DVD", function(payload)
		if not ctx.IsAlive() then
			return
		end
		local logo = logos[tonumber(payload.Index) or 1] or logos[1]
		local position = UDim2.fromScale(0.5, 0.4)
		if logo then
			local button = logo.Button
			position = UDim2.new(button.Position.X.Scale, logoSize.X / 2, button.Position.Y.Scale, 0)
		end
		-- (le son "Bonus" est déjà joué par StimulusManager)
		ctx.FloatText(container, position, "+" .. ctx.Format.Format(tonumber(payload.Amount) or 0), Theme.Colors.Gold, 40)
	end)
end

function DVD.Stop(_ctx)
	-- Tout est dans ctx.Container (détruit par le StimulusManager)
end

return DVD
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Disco</string>
            <string name="Source"><![CDATA[--[[
	Disco (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > Disco

	Boule disco (calque Overlay) suspendue en haut, à droite de la colonne
	centrale (x = centre + 360) : une mosaïque de petites facettes qui
	"tournent" et scintillent, avec des reflets colorés.
	Elle projette des faisceaux de lumière translucides qui balayent tout
	l'écran en changeant de couleur, et quelques taches de lumière qui se
	promènent. Rien n'est cliquable : les clics passent à travers.
]]

local Debris = game:GetService("Debris")

local Disco = {}
Disco.Slot = "Overlay"

local BALL_X = 360 -- décalage depuis le centre de l'écran
local BALL_Y = 74
local BALL_SIZE = 58
local TILE = 8 -- taille d'une facette (avec 1 px d'écart)
local GRID = 7 -- facettes par ligne / colonne
local PATTERN_W = 14 -- largeur du motif qui "tourne"
local BEAM_LENGTH = 1500
local MAX_SPARKLES = 5

function Disco.Start(ctx)
	local UIUtil = ctx.UIUtil
	local Create = UIUtil.Create
	local container: Frame = ctx.Container
	local random = Random.new()

	local function effectsOn(): boolean
		local data = ctx.State.Data
		return not (data and data.Settings and data.Settings.Effects == false)
	end

	local root = Create("Frame", {
		Name = "Disco",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Active = false,
		ZIndex = 1,
		Parent = container,
	})

	------------------------------------------------------------------
	-- Taches de lumière (derrière les faisceaux)
	------------------------------------------------------------------
	local spots = {}
	if effectsOn() then
		for index = 1, 4 do
			local size = random:NextInteger(140, 220)
			local spot = Create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(size, size),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BackgroundTransparency = 0.88,
				BorderSizePixel = 0,
				ZIndex = 1,
				Parent = root,
			})
			UIUtil.Corner(spot, UDim.new(1, 0))
			table.insert(spots, {
				Frame = spot,
				A = random:NextNumber(0.15, 0.35),
				B = random:NextNumber(0.12, 0.3),
				P = random:NextNumber(0, math.pi * 2),
				Q = random:NextNumber(0, math.pi * 2),
				Hue = index / 4,
			})
		end
	end

	------------------------------------------------------------------
	-- Faisceaux
	------------------------------------------------------------------
	local beams = {}
	local beamCount = effectsOn() and 6 or 3
	for index = 1, beamCount do
		local beam = Create("Frame", {
			Name = "Beam",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(BEAM_LENGTH, random:NextInteger(40, 70)),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			ZIndex = 2,
			Parent = root,
		})
		-- Lumineux près de la boule, s'efface au loin
		Create("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.62),
				NumberSequenceKeypoint.new(0.4, 0.84),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = beam,
		})
		table.insert(beams, {
			Frame = beam,
			-- La boule est à droite : les faisceaux partent surtout vers le bas / la gauche
			Base = 60 + (index - 1) * (110 / math.max(1, beamCount - 1)),
			Amp = random:NextNumber(18, 38),
			Freq = random:NextNumber(0.35, 0.8) * (random:NextNumber() < 0.5 and -1 or 1),
			Phase = random:NextNumber(0, math.pi * 2),
			Hue = (index - 1) / beamCount,
		})
	end

	------------------------------------------------------------------
	-- La boule
	------------------------------------------------------------------
	local ballPosition = UDim2.new(0.5, BALL_X, 0, BALL_Y)

	-- Fil (depuis le bas du bandeau d'actu)
	Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, BALL_X, 0, 28),
		Size = UDim2.fromOffset(2, BALL_Y - 28 - BALL_SIZE / 2 + 2),
		BackgroundColor3 = Color3.fromRGB(70, 70, 80),
		BorderSizePixel = 0,
		ZIndex = 4,
		Parent = root,
	})

	-- Halo coloré autour de la boule
	local halo = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = ballPosition,
		Size = UDim2.fromOffset(BALL_SIZE + 34, BALL_SIZE + 34),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.8,
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = root,
	})
	UIUtil.Corner(halo, UDim.new(1, 0))

	local ball = Create("Frame", {
		Name = "Ball",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = ballPosition,
		Size = UDim2.fromOffset(BALL_SIZE, BALL_SIZE),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = root,
	})
	UIUtil.Corner(ball, UDim.new(1, 0))
	UIUtil.Stroke(ball, Color3.fromRGB(40, 40, 50), 1.5, 0.2)
	UIUtil.Gradient(ball, ColorSequence.new(Color3.fromRGB(235, 235, 245), Color3.fromRGB(95, 95, 115)), 45)

	-- Facettes (seulement celles qui tiennent dans le cercle)
	local tiles = {}
	local radius = BALL_SIZE / 2
	local gridOrigin = (BALL_SIZE - GRID * TILE) / 2
	for i = 0, GRID - 1 do
		for j = 0, GRID - 1 do
			local cx = gridOrigin + i * TILE + TILE / 2 - radius
			local cy = gridOrigin + j * TILE + TILE / 2 - radius
			local far = math.sqrt((math.abs(cx) + TILE / 2) ^ 2 + (math.abs(cy) + TILE / 2) ^ 2)
			if far <= radius + 2 then
				local distance = math.sqrt(cx * cx + cy * cy)
				local tile = Create("Frame", {
					Position = UDim2.fromOffset(gridOrigin + i * TILE, gridOrigin + j * TILE),
					Size = UDim2.fromOffset(TILE - 1, TILE - 1),
					BackgroundColor3 = Color3.fromRGB(200, 200, 210),
					BackgroundTransparency = 0.1,
					BorderSizePixel = 0,
					ZIndex = 6,
					Parent = ball,
				})
				-- Plus sombre sur les bords (effet de sphère), plus clair en haut à gauche
				local shade = 1 - (distance / radius) * 0.4 - (cx + cy) / BALL_SIZE * 0.2
				table.insert(tiles, { Frame = tile, I = i, J = j, Shade = math.clamp(shade, 0.35, 1.1) })
			end
		end
	end

	-- Reflet
	local highlight = Create("Frame", {
		Position = UDim2.fromOffset(12, 10),
		Size = UDim2.fromOffset(12, 9),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
		ZIndex = 8,
		Parent = ball,
	})
	UIUtil.Corner(highlight, UDim.new(1, 0))

	-- Motif de luminosité qui défile (donne l'illusion de rotation)
	local pattern = {}
	for x = 1, PATTERN_W do
		pattern[x] = {}
		for y = 1, GRID do
			pattern[x][y] = random:NextNumber(0.55, 1)
		end
	end

	------------------------------------------------------------------
	-- Étincelles autour de la boule
	------------------------------------------------------------------
	local sparkles = 0
	local function spawnSparkle()
		if sparkles >= MAX_SPARKLES then
			return
		end
		sparkles += 1
		local angle = random:NextNumber(0, math.pi * 2)
		local distance = random:NextNumber(radius + 4, radius + 26)
		local star = UIUtil.Label({
			Text = random:NextNumber() < 0.6 and "✦" or "✨",
			TextColor3 = Color3.new(1, 1, 1),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = ballPosition + UDim2.fromOffset(math.cos(angle) * distance, math.sin(angle) * distance),
			Size = UDim2.fromOffset(16, 16),
			MaxTextSize = 16,
			ZIndex = 9,
			Parent = root,
		})
		local stroke = UIUtil.Stroke(star, Color3.fromRGB(90, 60, 140), 1, 0.3)
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		local scale = Create("UIScale", { Scale = 0.1, Parent = star })
		UIUtil.Tween(scale, 0.25, { Scale = 1.1 }, Enum.EasingStyle.Back)
		UIUtil.Tween(star, 0.7, { TextTransparency = 1, Rotation = random:NextNumber(-90, 90) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		UIUtil.Tween(stroke, 0.7, { Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Debris:AddItem(star, 0.75)
		task.delay(0.75, function()
			sparkles -= 1
		end)
	end

	------------------------------------------------------------------
	-- Animation
	------------------------------------------------------------------
	local time = 0
	local tileClock = 0
	local sparkleClock = 0
	local rotationStep = 0

	ctx.OnRender(function(dt: number)
		time += dt

		-- Faisceaux qui balayent (pivot = la boule)
		for _, beam in ipairs(beams) do
			local angle = beam.Base + math.sin(time * beam.Freq + beam.Phase) * beam.Amp
			local radians = math.rad(angle)
			local half = BEAM_LENGTH / 2
			beam.Frame.Position = UDim2.new(0.5, BALL_X + math.cos(radians) * half, 0, BALL_Y + math.sin(radians) * half)
			beam.Frame.Rotation = angle
			beam.Frame.BackgroundColor3 = Color3.fromHSV((time * 0.08 + beam.Hue) % 1, 0.7, 1)
			beam.Frame.BackgroundTransparency = 0.15 + (math.sin(time * 2.3 + beam.Phase) + 1) * 0.15
		end

		-- Taches de lumière (courbes de Lissajous)
		for _, spot in ipairs(spots) do
			spot.Frame.Position = UDim2.fromScale(
				0.5 + math.sin(time * spot.A + spot.P) * 0.45,
				0.55 + math.sin(time * spot.B + spot.Q) * 0.38
			)
			spot.Frame.BackgroundColor3 = Color3.fromHSV((time * 0.05 + spot.Hue) % 1, 0.6, 1)
		end

		local hueColor = Color3.fromHSV((time * 0.08) % 1, 0.8, 1)
		halo.BackgroundColor3 = hueColor
		halo.BackgroundTransparency = 0.78 + math.sin(time * 3) * 0.06

		-- Facettes (10 fois par seconde suffit)
		tileClock += dt
		if tileClock >= 0.1 then
			tileClock = 0
			rotationStep += 1
			local flash = random:NextInteger(1, math.max(1, #tiles))
			for index, tile in ipairs(tiles) do
				local column = ((tile.I + rotationStep) % PATTERN_W) + 1
				local value = pattern[column][tile.J + 1] * tile.Shade
				local grey = Color3.new(math.min(1, value), math.min(1, value), math.min(1, value * 1.04))
				if index == flash then
					tile.Frame.BackgroundColor3 = Color3.new(1, 1, 1)
				else
					-- Reflets colorés des faisceaux
					tile.Frame.BackgroundColor3 = grey:Lerp(hueColor, (column % 4 == 0) and 0.45 or 0.12)
				end
			end
		end

		-- Étincelles
		if effectsOn() then
			sparkleClock += dt
			if sparkleClock >= 0.35 then
				sparkleClock = 0
				spawnSparkle()
			end
		end
	end)
end

return Disco
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Email</string>
            <string name="Source"><![CDATA[--[[
	Email (ModuleScript - stimulus)
	Emplacement : ReplicatedStorage > Client > Stimuli > Email

	Mails qui arrivent en volant (décidés par le SERVEUR via l'événement
	Spawn "Email") : une enveloppe dessinée en code (rabat, cachet, pastille
	rouge "non lu") entre par la droite, se pose en (X, Y) et se dandine.
	Un clic l'ouvre : petite fenêtre de mail (expéditeur, objet, texte
	absurde choisi par info.Variant) + ClaimSpawn (le serveur valide) ;
	le "+X" confirmé (OnBonus "Email") s'affiche à côté.
	Si on l'ignore trop longtemps, elle repart... et s'ajoute au compteur
	"📬 non lus" (en haut à droite), qui ne fait que grossir.
]]

local Debris = game:GetService("Debris")

local Email = {}
Email.Slot = "Overlay"

local MAX_ENVELOPES = 4
local ENVELOPE_W = 92
local ENVELOPE_H = 62
local POPUP_W = 316
local POPUP_H = 192
local POPUP_AUTO_CLOSE = 9
local HURRY_TIME = 3 -- dernières secondes : l'enveloppe s'agite

-- Avatar, expéditeur, objet, texte
local EMAILS = {
	{ Avatar = "🤴", Sender = "Prince de Pixelie", Subject = "URGENT : héritage de 1 000 000 Dopamine",
		Body = "Cher ami, je suis coincé dans un menu. Envoie-moi 3 clics et je te rends le double. Promis juré." },
	{ Avatar = "🧊", Sender = "Ton frigo", Subject = "Il reste un yaourt",
		Body = "Je voulais juste te le dire. Il est périmé depuis mardi. Je t'aime quand même." },

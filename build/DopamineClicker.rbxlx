        <Item class="ModuleScript" referent="301">
          <Properties>
            <string name="Name">FR_V94_Town</string>
            <string name="Source"><![CDATA[--[[
	FR_V94_Town (ModuleScript)
	Emplacement : ReplicatedStorage > Shared > Lang > FR_V94_Town

	Traductions françaises des panneaux de Dopamine Town (TOWN94) : grand
	écran de la mairie, porte d'entrée, panneau de bienvenue, plan de la
	ville, fontaine, abribus. (Construits par le serveur : chaque TextLabel
	porte sa clé anglaise dans l'attribut "LocText", que le client traduit.)
]]

return {
	fr = {
		-- grand écran (mairie)
		["🏆 Top players of the server"] = "🏆 Meilleurs joueurs du serveur",
		["❤️ Like houses to climb the board!"] = "❤️ Aime des maisons pour grimper au classement !",

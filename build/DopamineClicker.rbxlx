	local shine = box({ Position = UDim2.fromOffset(5, 10), Size = UDim2.fromOffset(15, 4), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.25, ZIndex = 17, Parent = block }, 2)
	local sparkle = text({

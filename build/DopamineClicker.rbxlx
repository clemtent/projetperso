		Offset = i * 5.3,
		Flash = -10,
		Cashier = nil,
		Customers = {},
		Last = {},
	})
end

-- 🤖 caisses automatiques : écran tactile (achats qui défilent, total,
-- paiement), scanner, lecteur de carte, balance d'ensachage + potence à
-- sac, lampe d'état. Repère K : client à -X (regarde +X)
local KIOSK_T = 16
function MarketCheckout.SelfCheckout(m: any, parent: Instance)
	local white = rgb(240, 240, 244)
	local inox = rgb(196, 200, 210)
	local graphite = rgb(52, 54, 64)
	for i = 0, 3 do
		local K = m.F * CFrame.new(48.4, 0, 3 + i * 3.5)
		box(parent, "KioskBody", K, -0.9, 1.0, FLOOR_TOP, 2.55, -0.75, 0.75, white, M.SmoothPlastic, true)
		box(parent, "KioskKick", K, -0.94, -0.86, FLOOR_TOP, 0.4, -0.7, 0.7, graphite, M.Metal)
		box(parent, "KioskBand", K, -0.95, -0.88, 1.1, 1.6, -0.7, 0.7, BRAND2, M.SmoothPlastic)
		local top = box(parent, "KioskTop", K, -1.0, 1.05, 2.52, 2.6, -0.8, 0.8, inox, M.Metal)
		top.Reflectance = 0.08
		box(parent, "KioskScale", K, -0.75, 0.05, 2.56, 2.64, -0.5, 0.5, rgb(170, 174, 186), M.Metal)
		local glass = box(parent, "KioskGlass", K, -0.6, -0.1, 2.6, 2.67, -0.3, 0.3, rgb(40, 14, 20), M.Glass)
		local laser = newPart(parent, "ScanLaser", Vector3.new(0.45, 0.01, 0.025), K * CFrame.new(-0.35, 2.685, 0), rgb(255, 60, 60), M.Neon)
		laser.Transparency = 0.4
		box(parent, "KioskPost", K, 0.6, 0.78, 2.6, 4.2, -0.09, 0.09, graphite, M.Metal)
		local S = K * CFrame.new(0.52, 4.6, 0) * CFrame.Angles(0, 0, math.rad(-15))
		local screen = box(parent, "KioskScreen", S, -0.06, 0.06, -0.58, 0.58, -0.78, 0.78, rgb(28, 28, 34), M.SmoothPlastic)
		local gui = Instance.new("SurfaceGui")
		gui.Name = "Screen"
		gui.Face = Enum.NormalId.Left
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 110
		gui.LightInfluence = 0.1
		gui.MaxDistance = 45
		gui.Parent = screen
		local back = Instance.new("Frame")
		back.Size = UDim2.fromScale(1, 1)
		back.BackgroundColor3 = rgb(246, 246, 252)
		back.BorderSizePixel = 0
		back.Parent = gui
		local head = Instance.new("Frame")
		head.Size = UDim2.fromScale(1, 0.18)
		head.BackgroundColor3 = BRAND
		head.BorderSizePixel = 0
		head.Parent = back
		text(head, "Brand", "🧠 MegaDopa", 0.04, 0.12, 0.6, 0.76, WHITE, Enum.Font.FredokaOne, Enum.TextXAlignment.Left)
		local list = text(back, "List", "", 0.05, 0.22, 0.9, 0.46, rgb(50, 50, 70), Enum.Font.Code, Enum.TextXAlignment.Left)
		list.TextYAlignment = Enum.TextYAlignment.Top
		local total = text(back, "Total", "", 0.05, 0.68, 0.9, 0.12, rgb(40, 40, 60), Enum.Font.GothamBlack, Enum.TextXAlignment.Right)
		local button = Instance.new("Frame")
		button.Position = UDim2.fromScale(0.1, 0.82)
		button.Size = UDim2.fromScale(0.8, 0.14)
		button.BackgroundColor3 = rgb(80, 190, 110)
		button.BorderSizePixel = 0
		button.Parent = back
		corner(button, 0.3)
		local btn = text(button, "Label", Locale.T("👋 Touch to start"), 0.05, 0.1, 0.9, 0.8, WHITE, Enum.Font.GothamBold)
		-- lecteur de carte, balance d'ensachage et potence à sac
		box(parent, "CardReader", K, 0.1, 0.46, 2.58, 2.84, 0.5, 0.74, rgb(40, 40, 48), M.SmoothPlastic)
		box(parent, "BagStand", K, -0.9, 0.9, FLOOR_TOP, 2.2, 0.85, 1.55, inox, M.Metal, true)
		box(parent, "BagScale", K, -0.8, 0.8, 2.16, 2.26, 0.9, 1.5, rgb(170, 174, 186), M.Metal)
		for _, u in ipairs({ -0.76, 0.76 }) do
			cyl(parent, "BagRod", K, u, 2.24, 1.48, 1.2, 0.06, graphite, M.Metal)
		end
		box(parent, "BagBar", K, -0.8, 0.8, 3.4, 3.48, 1.44, 1.52, graphite, M.Metal)
		local bag = box(parent, "CarrierBag", K, -0.55, 0.55, 2.24, 3.36, 0.98, 1.4, rgb(250, 250, 252), M.SmoothPlastic)
		bag.Transparency = 0.18
		-- lampe d'état sur la potence de l'écran
		cyl(parent, "StatusPole", K, 0.69, 4.9, 0, 1.35, 0.07, graphite, M.Metal)
		local light = cyl(parent, "StatusLight", K, 0.69, 6.2, 0, 0.36, 0.34, rgb(90, 255, 140), M.Neon)
		checkoutPrompt(m, parent, K * CFrame.new(-1.8, 3.6, 0))
		table.insert((m :: any).Kiosks, {
			Owner = "full",
			K = K,
			List = list,
			Total = total,
			Button = btn,
			ButtonFrame = button,
			Light = light,
			Glass = glass,
			Busy = i % 2 == 0,
			Offset = i * 4.1,
			Pos = K.Position,
			Last = "",
		})
	end
	hangingSign(m, parent, 47, 8.4, 9, Locale.T("🤖 Self-checkout"), BRAND2, true)
end


-- Personnages des caisses (v9.9) : caissier·ère + file de clients avec
-- panier ; clients aux caisses automatiques
local LANE_CROWD = { 3, 2, 2, 2 }
function MarketCheckout.Zone(m: any, parent: Instance, jobs: { () -> () })
	for i = 1, OPEN_LANES do
		table.insert(jobs, function()
			local belt: any? = nil
			for _, b in ipairs(m.Belts) do
				if b.Index == i then
					belt = b
				end
			end
			if not belt then
				return
			end
			local L = belt.F
			local a = actor(m, parent, "Checkout", "cashier", 10 + i * 7, L * CFrame.new(-1.85, FLOOR_TOP, 6) * FACE_PX, "idle")
			if a then
				a.Custom = true
				belt.Cashier = a
			end
			for slot = 1, LANE_CROWD[i] or 2 do
				local q = QUEUE[slot]
				local c = actor(m, parent, "Checkout", "shopper", 200 + i * 13 + slot * 5, L * CFrame.new(q[1], FLOOR_TOP, q[2]), "idle", { Prop = "none" })
				if c then
					c.Custom = true
					local parts = {}
					for _, d in ipairs(c.Model:GetDescendants()) do
						if d:IsA("BasePart") then
							table.insert(parts, d)
						end
					end
					local b = basket(parent, i * 5 + slot)
					C.AddParts(#b.Parts)
					table.insert(belt.Customers, { Actor = c, Slot = slot, Basket = b, Parts = parts, Alpha = 1, Owner = "Checkout" })
				end
			end
		end)
	end
	table.insert(jobs, function()
		for index, k in ipairs((m :: any).Kiosks) do
			if k.Busy then
				local c = actor(m, parent, "Checkout", "shopper", 300 + index * 17, k.K * CFrame.new(-1.75, FLOOR_TOP, 0) * FACE_PX, "scan", { Prop = "none" })
				if c then
					c.Custom = true
					k.Customer = c
				end
			end
		end
	end)
end


-- 🛒 Caisses (v9.9) : temps du cycle d'une caisse et numéro du cycle
local function laneClock(belt: any, now: number): (number, number)
	local t = now + belt.Offset
	return t % LANE_T, math.floor(t / LANE_T)
end

local function itemPrice(belt: any, cycle: number, k: number): number
	return (ITEM_SPECS[k][7] :: number) + math.floor(hash(cycle * 7 + belt.Index, k) * 6) * 0.1
end

-- Marche de A vers B (lissée au départ et à l'arrivée), regard dans le sens de la marche
local function walkCF(a: Vector3, b: Vector3, s: number): CFrame
	local p = a:Lerp(b, smooth(s))
	local d = b - a
	d = Vector3.new(d.X, 0, d.Z)
	if d.Magnitude < 1e-3 then
		return CFrame.new(p)
	end
	return CFrame.lookAt(p, p + d.Unit)
end

local function laneSpot(L: CFrame, q: { number }): Vector3
	return (L * CFrame.new(q[1], FLOOR_TOP, q[2])).Position
end

-- Pose d'un client de la file : (repère au sol, anim, visibilité 0..1, panier à la main)
local function customerPose(belt: any, slot: number, count: number, tau: number, cycle: number): (CFrame, string, number, boolean)
	local L = belt.F
	local role = (slot - 1 - cycle) % count -- 0 : paie ; count-1 : le dernier arrivé
	local faceCounter = CFrame.Angles(0, math.pi / 2, 0) -- regard vers -X (le comptoir)
	local function standing(q: { number }, toCounter: boolean): CFrame
		return CFrame.new(laneSpot(L, q)) * (toCounter and (L - L.Position) * faceCounter or (L - L.Position))
	end
	if role == 0 then
		if tau < 2 then
			return walkCF(laneSpot(L, QUEUE[2]), laneSpot(L, QUEUE[1]), tau / 2), "walk", 1, true
		elseif tau < 14.6 then
			return standing(QUEUE[1], true), (tau >= 11.9 and "type" or (tau >= 5 and tau < 6.5 and "talk" or "idle")), 1, false
		elseif tau < 18.2 then
			-- départ vers la sortie (avec ses sacs), fondu à la fin
			local a, b, c = laneSpot(L, QUEUE[1]), laneSpot(L, EXIT[1]), laneSpot(L, EXIT[2])
			local l1, l2 = (b - a).Magnitude, (c - b).Magnitude
			local s = smooth((tau - 14.6) / 3.6) * (l1 + l2)
			local cf = s < l1 and walkCF(a, b, 0) or walkCF(b, c, 0)
			local p = s < l1 and a:Lerp(b, s / l1) or b:Lerp(c, (s - l1) / l2)
			cf = CFrame.new(p) * (cf - cf.Position)
			return cf, "walk", 1 - math.clamp((tau - 17.4) / 0.8, 0, 1), true
		end
		return standing(QUEUE[1], true), "idle", 0, true
	end
	local place = role + 1
	local unloading = place == 2
	if role == count - 1 then
		if tau < 1 then
			return standing(SPAWN, false), "idle", 0, true
		elseif tau < 3 then
			return walkCF(laneSpot(L, SPAWN), laneSpot(L, QUEUE[place]), (tau - 1) / 2), "walk", math.clamp((tau - 1) / 0.6, 0, 1), true
		end
	elseif tau < 2 then
		return walkCF(laneSpot(L, QUEUE[place + 1]), laneSpot(L, QUEUE[place]), tau / 2), "walk", 1, true
	end
	if unloading then
		return standing(QUEUE[2], true), (tau >= 3.1 and tau < 7.4) and "scan" or "idle", 1, false
	end
	return standing(QUEUE[place], false), "idle", 1, false
end

-- Repère d'un article (k = 1..5, 6 = barre « client suivant ») ; nil = caché
local function itemFrame(belt: any, k: number, tau: number): (CFrame?, boolean)
	local L = belt.F
	if tau < placeAt(k) then
		return nil, false
	end
	local ju = (hash(belt.Index, k) - 0.5) * 0.3
	local yaw = CFrame.Angles(0, (hash(k, belt.Index) - 0.5) * 0.6, 0)
	local done = 0
	for j = 1, math.min(k - 1, 5) do
		done += smooth((tau - (scanAt(j) + 0.3)) / 0.6)
	end
	local zq = FRONT_Z + (k - 1 - done) * 0.8
	local zc = 10.6 - 1.4 * (tau - placeAt(k))
	if k == 6 then
		-- la barre est rangée sur son support une fois les articles passés
		if tau < 12 then
			return L * CFrame.new(0, BELT_Y, math.max(zq, zc)), false
		elseif tau < 12.6 then
			local a = L * CFrame.new(0, BELT_Y, FRONT_Z)
			local target = belt.Rest * CFrame.new(0, -0.11, 0)
			return a:Lerp(target, smooth((tau - 12) / 0.6)) * CFrame.new(0, math.sin((tau - 12) / 0.6 * math.pi) * 0.25, 0), false
		end
		return nil, false
	end
	local t0 = scanAt(k)
	if tau < t0 then
		return L * CFrame.new(ju, BELT_Y + 0.005, math.max(zq, zc)) * yaw, false
	elseif tau < t0 + 0.8 then
		-- dans la main : au-dessus de la vitre (BIP), puis dans le sac
		local s = (tau - t0) / 0.8
		local p0 = L * Vector3.new(ju, BELT_Y + 0.005, FRONT_Z)
		local p1 = L * Vector3.new(-0.05, 2.8, SCAN_Z)
		local p2 = L * Vector3.new(0, 2.95, BAG_Z + BAG_R)
		local p
		if s < 0.5 then
			local q = smooth(s / 0.5)
			p = p0:Lerp(p1, q) + Vector3.new(0, math.sin(q * math.pi) * 0.12, 0)
		else
			p = p1:Lerp(p2, smooth((s - 0.5) / 0.5))
		end
		return CFrame.new(p) * (L - L.Position) * yaw * CFrame.Angles(0, s * math.pi * 0.6, 0), s >= 0.38 and s <= 0.62
	end
	return nil, false
end

local function setText(belt: any, key: string, label: TextLabel?, value: string)
	if label and belt.Last[key] ~= value then
		belt.Last[key] = value
		label.Text = value
	end
end

function MarketCheckout.AnimateLane(belt: any, now: number)
	local N = NPC()
	local tau, cycle = laneClock(belt, now)
	local L = belt.F
	-- nervures du tapis (distance cumulée : jamais de saut entre deux cycles)
	local run = 1.4 * (math.clamp(tau, 3.2, 9.6) - 3.2)
	for j = 1, 6 do
		run += 0.8 * smooth((tau - (scanAt(j) + 0.3)) / 0.6)
	end
	local dist = cycle * BELT_RUN + run
	local span = BELT_Z1 - BELT_Z0 - 0.4
	local ribFrames = table.create(#belt.Slats)
	for k = 1, #belt.Slats do
		local z = BELT_Z1 - 0.2 - ((dist + (k - 1) * span / #belt.Slats) % span)
		ribFrames[k] = L * CFrame.new(0, 2.695, z)
	end
	workspace:BulkMoveTo(belt.Slats, ribFrames, Enum.BulkMoveMode.FireCFrameChanged)
	-- articles
	local flashing = false
	for k, item in ipairs(belt.Items) do
		local cf, flash = itemFrame(belt, k, tau)
		if cf then
			showGroup(item, true)
			moveGroup(item, cf)
		else
			showGroup(item, false)
		end
		flashing = flashing or flash
	end
	if flashing then
		belt.Flash = now
	end
	local on = now - belt.Flash < 0.3
	belt.Scanner.Color = on and rgb(255, 60, 70) or rgb(40, 14, 20)
	for _, laser in ipairs(belt.Lasers) do
		laser.Transparency = on and 0.1 or 1
	end
	belt.Beep.Enabled = on
	-- carrousel à sacs : un tiers de tour après le 2e, le 4e article et au paiement
	local turns = smooth((tau - 7.6) / 0.8) + smooth((tau - 10.4) / 0.8) + smooth((tau - 13) / 0.8)
	moveGroup(belt.Carousel, belt.CarouselCF * CFrame.Angles(0, turns * math.pi * 2 / 3, 0))
	local bagsOn = not (tau >= 14.8 and tau < 19.4)
	if belt.Last.Bags ~= bagsOn then
		belt.Last.Bags = bagsOn
		for _, bag in ipairs(belt.Bags) do
			bag.LocalTransparencyModifier = bagsOn and 0 or 1
		end
	end
	-- écrans : afficheur client, écran caisse, TPE ; ticket qui sort
	local count, total = 0, 0
	local lines = {}
	for k = 1, 5 do
		if tau >= scanAt(k) + 0.4 then
			count += 1
			local price = itemPrice(belt, cycle, k)
			total += price
			table.insert(lines, string.format("%-13s %s", Locale.T(ITEM_SPECS[k][6] :: string), money(price)))
		end
	end
	local pole
	if tau >= 13.2 then
		pole = Locale.T("Thank you! 😊")
	elseif count == 0 then
		pole = Locale.T("Hello! 👋")
	else
		pole = Locale.T("TOTAL %s", money(total))
	end
	setText(belt, "Pole", belt.Pole, pole)
	while #lines > 4 do
		table.remove(lines, 1)
	end
	table.insert(lines, "")
	table.insert(lines, string.format("%-13s %s", Locale.T("TOTAL"), money(total)))
	setText(belt, "Screen", belt.Screen, count == 0 and ("🧠 MegaDopa  ·  " .. Locale.T("Lane %d", belt.Index)) or table.concat(lines, "\n"))
	local tpe
	if tau >= 11.9 and tau < 13.2 then
		tpe = Locale.T("💳 Tap your card") .. "\n" .. money(total)
	elseif tau >= 13.2 and tau < 14.8 then
		tpe = Locale.T("✅ Payment accepted")
	else
		tpe = "🧠 MegaDopa"
	end
	setText(belt, "TPE", belt.Terminal, tpe)
	local paper = belt.Paper
	if paper and belt.PaperCF then
		local len = (tau >= 13.2 and tau < 14.6) and smooth((tau - 13.2) / 1) * 0.55 or 0
		if len > 0.01 then
			paper.LocalTransparencyModifier = 0
			paper.Size = Vector3.new(0.26, len, 0.01)
			paper.CFrame = belt.PaperCF * CFrame.Angles(math.rad(-12), 0, 0) * CFrame.new(0, len / 2, 0)
		elseif paper.LocalTransparencyModifier < 1 then
			paper.LocalTransparencyModifier = 1
		end
	end
	-- caissier·ère : scanne, encaisse, dit au revoir
	local cashier = belt.Cashier
	if cashier and N then
		local anim = "idle"
		if tau >= scanAt(1) - 0.6 and tau < 11.9 then
			anim = "scan"
		elseif tau >= 11.9 and tau < 14.3 then
			anim = "type"
		elseif tau >= 14.3 and tau < 16.5 then
			anim = "talk"
		end
		pcall(N.Animate, cashier.Model, anim, now + cashier.Offset)
	end
	-- file de clients
	local n = #belt.Customers
	for _, c in ipairs(belt.Customers) do
		local cf, anim, alpha, carry = customerPose(belt, c.Slot, n, tau, cycle)
		if math.abs(alpha - c.Alpha) > 0.04 or (alpha == 0) ~= (c.Alpha == 0) or (alpha == 1 and c.Alpha ~= 1) then
			if N and type(N.SetSolid) == "function" and (alpha > 0.5) ~= (c.Alpha > 0.5) then
				-- (capsule de collision NPC99 : jamais de client invisible qui bloque)
				pcall(N.SetSolid, c.Actor.Model, alpha > 0.5)
			end
			c.Alpha = alpha
			local t = 1 - alpha
			for _, p in ipairs(c.Parts) do
				p.LocalTransparencyModifier = t
			end
			for _, p in ipairs(c.Basket.Parts) do
				p.LocalTransparencyModifier = t
			end
		end
		if alpha > 0 and N then
			local model = c.Actor.Model
			if type(N.Place) == "function" then
				pcall(N.Place, model, cf)
			elseif model.PrimaryPart then
				model.PrimaryPart.CFrame = cf
			else
				model:PivotTo(cf)
			end
			pcall(N.Animate, model, anim, now + c.Actor.Offset)
			c.Actor.Pos = cf.Position
			moveGroup(c.Basket, cf * (carry and CFrame.new(0.95, 1.55, 0) or CFrame.new(0.9, 0.03, 0.2)))
		end
	end
end

-- 🤖 caisses automatiques : écran qui défile, lampe, client
function MarketCheckout.AnimateKiosk(k: any, now: number)
	local N = NPC()
	if not k.Busy then
		if k.Last ~= "idle" then
			k.Last = "idle"
			k.List.Text = Locale.T("Scan your first item\nor touch the screen")
			k.Total.Text = ""
			k.Button.Text = Locale.T("👋 Touch to start")
			k.Light.Color = rgb(236, 236, 240)
		end
		return
	end
	local tau = (now + k.Offset) % KIOSK_T
	local n = math.min(5, math.floor(tau / 1.8) + 1)
	local state = tau < 9 and ("scan" .. n) or (tau < 12 and "pay" or (tau < 14 and "thanks" or "idle"))
	k.Glass.Color = (tau < 9 and tau % 1.8 < 0.25) and rgb(255, 60, 70) or rgb(40, 14, 20)
	if k.Last ~= state then
		k.Last = state
		local lines, total = {}, 0
		local count = state == "idle" and 0 or (state == "pay" or state == "thanks") and 5 or n
		for j = 1, count do
			local price = (ITEM_SPECS[j][7] :: number) + (j % 3) * 0.2
			total += price
			table.insert(lines, string.format("%-12s %s", Locale.T(ITEM_SPECS[j][6] :: string), money(price)))
		end
		k.List.Text = state == "thanks" and Locale.T("Thank you, see you soon! 🧠") or (count == 0 and Locale.T("Scan your first item\nor touch the screen") or table.concat(lines, "\n"))
		k.Total.Text = count > 0 and Locale.T("TOTAL %s", money(total)) or ""
		k.Button.Text = state == "pay" and Locale.T("💳 Paying…") or (state == "thanks" and Locale.T("✅ Paid") or (count > 0 and Locale.T("💳 Pay") or Locale.T("👋 Touch to start")))
		k.ButtonFrame.BackgroundColor3 = state == "pay" and rgb(80, 150, 230) or rgb(80, 190, 110)
		k.Light.Color = count > 0 and rgb(90, 255, 140) or rgb(236, 236, 240)
	end
	local c = k.Customer
	if c and N then
		pcall(N.Animate, c.Model, tau < 9 and "scan" or (tau < 12 and "type" or "idle"), now + c.Offset)
	end
end


return MarketCheckout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="211">
          <Properties>
            <string name="Name">MarketInterior</string>
            <string name="Source"><![CDATA[--[[
	MarketInterior (ModuleScript)
	Emplacement : ReplicatedStorage > Client > World > MarketInterior

	🛒 Dopamine Town : l'INTÉRIEUR du supermarché « MégaDopa » (et la vie de
	son parking), construit côté client, en flux. Le serveur (TownMarket) a
	posé la coque dans DopamineTown.Market ("Supermarket" : attributs
	MarketCF, InteriorCF, InteriorSize, DoorCF… ; vantaux "DoorPanel" +
	SlideX ; écrans "LeaderScreen" + Board).

	v9.7 (BUILDINGS97) : premier supermarché (70 x 48).
	v9.8 (MARKET98) : 10x mieux et plus grand (104 x 68) :
	  - ENTRÉE : deux grands ÉCRANS DE CLASSEMENT sur la façade (🏆 top
	    Dopamine / ♻️ top Renaissances : podium avec photos, rangs 4 à 10,
	    ta place, « ● EN DIRECT », alternance 🌍 Monde / 🏠 Ce serveur),
	    mis à jour en direct (ClientState.LeaderboardChanged) ; dedans, un
	    écran suspendu « En direct sur le serveur » ; portiques, chariots,
	    hôte·sse d'accueil qui salue ;
	  - 💎 BOUTIQUE ROBUX : les vrais Game Passes sur des socles vitrés
	    (emblème qui tourne), les produits Robux en « cartes cadeaux » sur un
	    présentoir, le coin « 🔜 Bientôt », un·e vendeur·se ; chaque offre a
	    son invite « Acheter — R$ prix » qui ouvre la fenêtre d'achat Roblox
	    EXACTEMENT comme le panneau 💎 Boutique Robux
	    (MarketplaceService:PromptGamePassPurchase / PromptProductPurchase ;
	    le serveur MonetizationService donne l'achat : aucun reçu en double) ;
	  - ☕ CAFÉ + 🍕 AIRE DE RESTAURATION : comptoirs, machine à expresso,
	    four à pizza, menus, tables et chaises, clients attablés ;
	  - ÉPICERIE : 4 gondoles (8 faces) de vrais « produits » : boîtes à
	    étiquettes imprimées (SurfaceGui, plafonnées, visibles de près),
	    bouteilles à goulot, canettes, bocaux de bonbons, sachets… ;
	    fruits & légumes, boulangerie, frigos vitrés, bacs de surgelés ;
	  - MAISON : 3 gondoles (6 faces) et 3 espaces avec les VRAIS objets de
	    la maison (House3DRecipes.BuildItem) : cuisine, déco, luminaires,
	    animaux, jeux vidéo, sport ; 🧸 jouets sur tables à gradins,
	    📺 électronique devant un mur de télés animées, 🛋️ SALONS D'EXPO
	    (deux pièces meublées en taille réelle), 🪴 jardinerie ;
	    étiquettes (BillboardGui, ancre INVISIBLE, AlwaysOnTop, les 5 plus
	    proches, seulement dans le magasin) et invite « Acheter — 🧠 prix » ;
	  - CAISSES : 6 caisses dont 4 ouvertes (TAPIS ROULANT ANIMÉ, articles
	    qui avancent, passage au scanner avec éclair rouge et « BIP ! »
	    visuel — aucun son —, caissier·ère qui scanne), 4 caisses
	    automatiques ; l'invite
	    « 🛒 Passer en caisse » ouvre le catalogue complet (ShopUI "Market") ;
	  - PERSONNAGES (NPCModels, CITY98) : caissier·ères, boulanger·ère,
	    barista, pizzaïolo, vendeur·se Robux, hôte·sse, clients attablés et
	    clients qui POUSSENT LEUR CHARIOT dans les allées ;
	  - lumières : 3 PointLights douces + 8 SurfaceLights, allumées
	    SEULEMENT quand on est dedans (luminosité ≤ 1), aucun Neon.
	Flux (budget de temps par image, jamais de création / destruction par
	image ensuite) :
	  1. "Dehors" (≤ 260 studs du bâtiment) : marquages et voitures du
	     parking, abris à chariots, camion au quai, affiches, écrans ;
	  2. "Complet" (≤ 45 studs du bâtiment, gardé jusqu'à 75) : structure
	     de tout le magasin, rayons en « bandes » de produits vues de loin,
	     clients aux chariots ;
	  3. "Détail" par ZONE (dedans, ≤ 34 studs de la zone, gardé jusqu'à
	     50) : produits un par un, vrais objets + étiquettes + invites,
	     personnages de la zone, présentoirs Robux.
	Animations (≤ 30 Hz, seulement à ≤ 70 studs) : personnages, tapis,
	scanners, emblèmes Robux, télés, écrans de classement.

	API (TownClient, via optionalModule) :
	  MarketInterior.Start({ Toast = fn(text, color?) }?)   à l'entrée en ville
	  MarketInterior.Step(position: Vector3)                 flux (facultatif)
	  MarketInterior.Stop()                                  à la sortie
	  MarketInterior.Debug() -> table                        (tests / rendus)
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local Config = require(ReplicatedStorage.Shared.Config)
local Locale = require(ReplicatedStorage.Shared.Locale)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local WorldLayout = require(ReplicatedStorage.Shared.WorldLayout)
local HouseCommon = require(Client.Components.House.HouseCommon)
local ShopUI = require(script.Parent.ShopUI)
local BoardKit = require(script.Parent.BoardKit)
local ClockKit = require(script.Parent.ClockKit)

local MarketInterior = {}

local M = Enum.Material
local rgb = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)
local INK = rgb(92, 58, 96)
local BRAND = rgb(236, 72, 140)
local BRAND2 = rgb(120, 90, 200)
local YELLOW = rgb(255, 208, 72)
local GOLD = rgb(236, 190, 90)
local STEEL = rgb(176, 180, 190)
local DARKSTEEL = rgb(90, 92, 104)
local ROBUX = rgb(110, 60, 200)
local ROBUX_DARK = rgb(52, 30, 96)
local SOONPINK = rgb(255, 60, 140)

local FOLDER_NAME = "TownMarketInterior"
local OUT_RANGE, OUT_DROP = 260, 320 -- (distance au bâtiment)
local FULL_RANGE, FULL_DROP = 45, 75
local ZONE_RANGE, ZONE_DROP = 34, 50
local ANIM_RANGE = 70
local ANIM_EVERY = 1 / 30
local STEP_BUDGET = 0.004
local STEP_EVERY = 0.25
local DOOR_RANGE = 12
local TAG_DISTANCE = 16
local PROMPT_DISTANCE = 5.5
local MAX_TAGS = 5
local PX = WorldLayout.PX
local GAP = 0.05
local FLOOR_TOP = 0.07 -- dessus du revêtement de sol (repère F)
local INLAY_TOP = 0.1 -- dessus des tapis / parquets (au-dessus du revêtement)
local MAX_ITEM_PARTS = 40 -- (budget) un objet exposé plus lourd laisse sa place au suivant
local MAX_SHOWROOM_PARTS = 80
local MAX_LABELS = 240 -- étiquettes imprimées (SurfaceGui) des produits
local LABEL_DISTANCE = 30
local PROMPT_COOLDOWN = 1 -- (comme le panneau 💎 Boutique Robux)
local PAGE_TIME = 10 -- (s) alternance 🌍 Monde / 🏠 Ce serveur des écrans

----------------------------------------------------------------------
-- Pièces
----------------------------------------------------------------------

local partCount = 0
local labelCount = 0

local function newPart(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, solid: boolean?): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = solid == true
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Parent = parent
	partCount += 1
	return p
end

local function box(parent: Instance, name: string, F: CFrame, x0: number, x1: number, y0: number, y1: number, z0: number, z1: number, color: Color3, material: Enum.Material?, solid: boolean?): BasePart
	return newPart(parent, name, Vector3.new(math.abs(x1 - x0), math.abs(y1 - y0), math.abs(z1 - z0)), F * CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2), color, material, solid)
end

-- Cylindre debout (repère F)
local function cyl(parent: Instance, name: string, F: CFrame, x: number, y0: number, z: number, height: number, diameter: number, color: Color3, material: Enum.Material?, solid: boolean?): BasePart
	local p = newPart(parent, name, Vector3.new(height, diameter, diameter), F * CFrame.new(x, y0 + height / 2, z) * CFrame.Angles(0, 0, math.rad(90)), color, material, solid)
	;(p :: Part).Shape = Enum.PartType.Cylinder
	return p
end

-- Cylindre couché d'axe X (repère F)
local function cylX(parent: Instance, name: string, F: CFrame, x0: number, x1: number, y: number, z: number, diameter: number, color: Color3, material: Enum.Material?): BasePart
	local p = newPart(parent, name, Vector3.new(math.abs(x1 - x0), diameter, diameter), F * CFrame.new((x0 + x1) / 2, y, z), color, material)
	;(p :: Part).Shape = Enum.PartType.Cylinder
	return p
end

-- Cylindre couché d'axe Z (repère F)
local function cylZ(parent: Instance, name: string, F: CFrame, x: number, y: number, z0: number, z1: number, diameter: number, color: Color3, material: Enum.Material?): BasePart
	local p = newPart(parent, name, Vector3.new(math.abs(z1 - z0), diameter, diameter), F * CFrame.new(x, y, (z0 + z1) / 2) * CFrame.Angles(0, math.rad(90), 0), color, material)
	;(p :: Part).Shape = Enum.PartType.Cylinder
	return p
end

local function ball(parent: Instance, name: string, F: CFrame, x: number, y: number, z: number, diameter: number, color: Color3, material: Enum.Material?): BasePart
	local p = newPart(parent, name, Vector3.new(diameter, diameter, diameter), F * CFrame.new(x, y, z), color, material)
	;(p :: Part).Shape = Enum.PartType.Ball
	return p
end

-- Texte sur une face d'une pièce (SurfaceGui)
local function label(board: BasePart, face: Enum.NormalId, text: string, textColor: Color3, background: Color3?, pps: number, maxDistance: number, font: Enum.Font?): SurfaceGui
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Sign"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pps
	gui.LightInfluence = 0.4
	gui.Brightness = 1
	gui.MaxDistance = maxDistance
	gui.Parent = board
	if background then
		local bg = Instance.new("Frame")
		bg.Name = "Back"
		bg.BackgroundColor3 = background
		bg.BorderSizePixel = 0
		bg.Size = UDim2.fromScale(1, 1)
		bg.Parent = gui
	end
	local l = Instance.new("TextLabel")
	l.Name = "Text"
	l.BackgroundTransparency = 1
	l.Size = UDim2.fromScale(0.92, 0.8)
	l.Position = UDim2.fromScale(0.04, 0.1)
	l.Font = font or Enum.Font.FredokaOne
	l.TextScaled = true
	l.Text = text
	l.TextColor3 = textColor
	l.Parent = gui
	return gui
end

-- Petit texte libre dans un conteneur (écrans, étiquettes)
local function text(parent: Instance, name: string, value: string, x: number, y: number, w: number, h: number, color: Color3, font: Enum.Font?, align: Enum.TextXAlignment?): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundTransparency = 1
	l.Position = UDim2.fromScale(x, y)
	l.Size = UDim2.fromScale(w, h)
	l.Font = font or Enum.Font.GothamBold
	l.TextScaled = true
	l.Text = value
	l.TextColor3 = color
	l.TextXAlignment = align or Enum.TextXAlignment.Center
	l.Parent = parent
	return l
end

local function corner(parent: Instance, radius: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(radius, 0)
	c.Parent = parent
end

local function hash(a: number, b: number?): number
	local x = math.sin(a * 12.9898 + (b or 0) * 78.233) * 43758.5453
	return x - math.floor(x)
end

local function pick<T>(list: { T }, seed: number, salt: number): T
	return list[math.floor(hash(seed, salt) * #list) + 1]
end

local function countParts(root: Instance): number
	local n = 0
	for _, x in ipairs(root:GetDescendants()) do
		if x:IsA("BasePart") then
			n += 1
		end
	end
	return n
end

----------------------------------------------------------------------
-- Modules paresseux (l'intérieur marche sans eux)
----------------------------------------------------------------------

local recipes: any = nil
local function Recipes(): any
	if recipes == nil then
		local module = Client.Components.House:FindFirstChild("House3DRecipes")
		local ok, result = false, nil
		if module then
			ok, result = pcall(require, module)
		end
		recipes = ok and result or false
	end
	return recipes or nil
end

local function sharedModule(name: string): any?
	local module = ReplicatedStorage.Shared:FindFirstChild(name)
	if not module then
		return nil
	end
	local ok, result = pcall(require, module)
	return ok and type(result) == "table" and result or nil
end

local npcCache: any = nil
local function NPC(): any?
	if npcCache == nil then
		npcCache = sharedModule("NPCModels") or false
	end
	return npcCache or nil
end

local arcadeFeature: string? = nil
local function ticketsLocked(def: any): boolean
	if def.Kind ~= "Tickets" then
		return false
	end
	if arcadeFeature == nil then
		local arcade = sharedModule("ArcadeConfig")
		arcadeFeature = arcade and tostring(arcade.Feature) or "Minigames"
	end
	return not ClientState.HasFeature(arcadeFeature :: string)
end

----------------------------------------------------------------------
-- État
----------------------------------------------------------------------

type Slot = { CF: CFrame, MaxW: number, MaxH: number, MaxD: number, Tag: CFrame, WallZ: number?, Flank: number?, Tint: Color3?, Heavy: boolean? }

type Display = {
	Entry: ShopUI.Entry,
	Model: Model?,
	Tag: BasePart?,
	Billboard: BillboardGui?,
	Prompt: ProximityPrompt?,
	Labels: { [string]: TextLabel },
	Owner: string,
}

type Door = { Part: BasePart, Closed: CFrame, Open: CFrame, IsOpen: boolean }

-- Personnage animé (fixe ou sur un parcours)
type Actor = {
	Model: Model,
	Anim: string,
	Offset: number,
	Owner: string,
	Base: CFrame?,
	Path: { Vector3 }?,
	Length: number?,
	Speed: number?,
	Cart: Model?,
	CartParts: { BasePart }?,
	CartOffsets: { CFrame }?,
	Pos: Vector3,
	Custom: boolean?, -- (v9.9) animé par sa caisse, pas par la boucle générale
}

-- Groupe de pièces déplacées d'un bloc (articles, carrousel, panier)
type Group = { Parts: { BasePart }, Offsets: { CFrame }, Shown: boolean }

-- Client de la file d'une caisse (v9.9)
type Customer = { Actor: Actor, Slot: number, Basket: Group, Parts: { BasePart }, Alpha: number, Owner: string }

-- Caisse animée (v9.9) : tapis, articles, scanner, carrousel, écrans, personnages
type Belt = {
	Owner: string,
	F: CFrame, -- repère de la caisse (x = centre du tapis, axes du magasin)
	Index: number,
	Slats: { BasePart },
	Items: { Group },
	Rest: CFrame,
	Scanner: BasePart,
	Lasers: { BasePart },
	Beep: BillboardGui,
	Carousel: Group,
	CarouselCF: CFrame,
	Bags: { BasePart },
	Pole: TextLabel?,
	Screen: TextLabel?,
	Terminal: TextLabel?,
	Paper: BasePart?,
	PaperCF: CFrame?,
	Pos: Vector3,
	Offset: number,
	Flash: number,
	Cashier: Actor?,
	Customers: { Customer },
	Last: { [string]: any },
}

type Spinner = { Part: BasePart, Base: CFrame, Owner: string, Offset: number, Pos: Vector3 }

type RobuxOffer = { Key: string, Def: any, IsPass: boolean, Id: number, Soon: boolean }

type RobuxDisplay = {
	Offer: RobuxOffer,
	Prompt: ProximityPrompt?,
	Price: TextLabel?,
	Owner: string,
}

-- Écran de classement (v9.9 : dessiné par BoardKit, façon régie télé)
type Board = {
	Kind: string, -- "Dopamine" | "Rebirths" | "Server"
	Kit: any, -- BoardKit.Board
	Gui: SurfaceGui,
	Owner: string,
	Pos: Vector3,
	LastScope: string?,
	LastRefresh: number,
}

type Builder = { Name: string, Folder: Folder?, Jobs: { () -> () }?, Index: number, Built: boolean }

type Zone = {
	Name: string,
	X: number,
	Z: number,
	Build: (m: any, parent: Instance, jobs: { () -> () }) -> (),
	B: Builder,
	Hide: { BasePart }, -- bandes "vues de loin" masquées quand le détail est là
}

type Market = {
	Model: Model,
	MCF: CFrame, -- pied de la façade (milieu), LookVector vers le parking
	F: CFrame, -- sol intérieur, milieu de la face intérieure de la façade, +Z vers le fond
	Size: Vector3,
	InteriorCF: CFrame,
	DoorCF: CFrame,
	Level: number,
	Outside: Builder,
	Full: Builder,
	Zones: { Zone },
	Displays: { Display },
	Lights: { Light },
	LightsOn: boolean,
	Doors: { Door },
	Checkouts: { Vector3 },
	Actors: { Actor },
	Belts: { Belt },
	Spinners: { Spinner },
	Kiosks: { any }, -- (v9.9) caisses automatiques animées
	Clocks: { any }, -- (v9.9) horloges { Clock, Owner }
	Dates: { any }, -- (v9.9) médaillons de date { Refresh, Owner }
	Robux: { RobuxDisplay },
	Boards: { Board },
	TVs: { UIGradient },
	Bands: { [string]: { BasePart } },
}

local started = false
local market: Market? = nil
local folder: Folder? = nil
local conns: { RBXScriptConnection } = {}
local clock = 0
local animClock = 0
local boardClock = 0
local dirty = false
local boardsDirty = true
local focus: Vector3? = nil
local lastPrompt = 0
local toastFn: ((string, Color3?) -> ())? = nil
local priceCache: { [string]: number } = {}
local priceFetching: { [string]: boolean } = {}
local stats = { Built = 0, Destroyed = 0, Items = 0, Purchases = 0, Parts = 0, Products = 0, Labels = 0, Actors = 0, RobuxPrompts = 0, ZonesBuilt = 0, Animated = 0 }

local function toast(message: string, color: Color3?)
	local fn = toastFn
	if fn then
		pcall(fn, message, color)
	end
end

